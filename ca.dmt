Application Component Report
============================

	Name:            CheckIsoComplete

/*
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckIsoComplete
**
**  Date:     Version  Description
** --------------------------------------------------
**  11/21/96    pw     Created to check iso complete on 4kv Cards
**  11/18/02    ysp    Merge: removed passed-in Card and Jobs.
**  02/28/03    pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                     that span divisions.
**  03/21/03    em     i=0 to 1=1 error fix
**  11/29/12    pkw    Look for links to 4kv cards with closed SD-VIS switches.  
**  12/12/12    pkw    Modify select to get 4kv cards so that only get cards with closed device. 
**  02/13/13    pkw    Change variable to i on first select.
**  08/10/16    ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
**  01/26/17    pkw    Fix problem with Red Warning not showing up when calling CheckIsolationComplete.
*/
PROCEDURE CheckIsoComplete 
(
    JIP = JobInProgress;			  /* parameter - Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
)= 
DECLARE
    
    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
    TempJobs = ARRAY of JobInProgress; 
ENDDECLARE
BEGIN 
   IF Card <> 0 THEN   
       /*
       **  If Card is passed in, this prompt is being called from 
       **  another ISO Precheck and we just want to run this check for
       **  that particular card.
       */
       k = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[k].Card = C.Card,
              :CommonFeederCard[k].Feeder = C.Feeder,
              :CommonFeederCard[k].FeederName = C.FeederName,
              :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,   
              :CommonFeederCard[k].StepDownJob = 0   
       FROM    SOA_ActiveCard AC,
               FMS_Card C
       Where   AC.Card = :Card AND
               AC.Card = C.Card
       BEGIN
           k = k + 1;
       END;

       IF k = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ELSE
       /*
       **    Find all feeders which this piece of equipment is common.
       **    If we couldn't find a feeder then nothing more to do
       */
       k = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[k].Card = C.Card,
              :CommonFeederCard[k].Feeder = C.Feeder,
              :CommonFeederCard[k].FeederName = C.FeederName,
              :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,   
              :CommonFeederCard[k].StepDownJob = 0   
       FROM    SOA_JobControl JC,
               SOA_ActiveCard AC,
               FMS_Card C
       Where   JC.Job = :JIP.Job AND
               JC.Card = AC.Card AND
               JC.Card = C.Card
       BEGIN
           k = k + 1;
       END;

       IF k = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ENDIF;
/*
**    check to see if all iso moves have been completed.  If there are still outstanding
**    iso moves give them warning.
*/
    RetCode = NULL;

    FOR k = 1 TO CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[k].GetGeneralCardName();
      
       /*
       **  If card was passed in or StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF Card = 0 AND CommonFeederCard[k].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[k].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;
          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[k].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Move issued from 4KV card and will do additional check on 
                **  13kv card which should use ISOLATION check so call 
                **  checkisolationcomplete and checkisolationcompleteallcards. 
                **  4KV card is only connected to one 13KV card so
                **  we can just use link table to find any 13 KV cards.
                */
                i = 1;
                StepDownCard.Clear();
                SELECT DISTINCT
                   :StepDownCard[i].Card = C.Card
                FROM FMS_StepDownLink L,
                     SOA_ActiveCard AC,
                     FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[k].Card AND
                      L.Card = C.Card AND
                      L.Card = AC.Card
                BEGIN
                   i = i + 1;
                END;
                FOR i = 1 TO StepDownCard.LastRow DO
                   WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[i].Card);
                   IF WarningStatus = PU_CANCEL THEN
                       RETURN(PU_CANCEL);
                   ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                       RetCode = Warning$Overridden;
                   ENDIF;
                   WarningStatus = CALLPROC CheckIsolationCompleteAllCards(Card = :StepDownCard[i].Card);
                   IF (WarningStatus = PU_CANCEL) THEN
                       RETURN(PU_CANCEL);
                   ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                       RetCode = Warning$Overridden;
                   ENDIF;
                ENDFOR;
             ELSE
                /*
                **  Move issued from 13KV card and will do additional check on 
                **  4kv card which should use ISO check so just add to the 
                **  current array.
                */
                i = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[i].Card = C.Card,
                   :CommonFeederCard[i].CardClass = C.CardClass,
                   :CommonFeederCard[i].FeederName = C.FeederName,
                   :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[i].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[k].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   i = i + 1;
                END;
             ENDIF;
          ENDIF;
       ENDIF;  

        i = 1;
        TempJobs.Clear();

        REPEATED
        SELECT :TempJobs[i].PrintId = JC.PrintId,
               :TempJobs[i].EquipName = J.EquipName,
               :TempJobs[i].EquipClassName = J.EquipClassName,
               :TempJobs[i].ToMove = J.ToMove,
               :TempJobs[i].Job = J.Job
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[k].Card AND
               JC.StepPair = :StepHeading$Iso AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               J.TOComplete IS NULL AND
               J.Status = ''
        BEGIN
           i = i + 1;
        END;

/*
**    If we get down here,  check did not pass.
*/
       IF TempJobs.LastRow() > 0 THEN
            WarningStatus = CALLFRAME Warning
                    ( Card = CommonFeederCard[k].Card,
                      Job = JIP.Job,
                      SwitchingItem = JIP.SwitchingItem,
                      Jobs = TempJobs, 
                      Text = 'Not all Isolation moves have been completed ' +
                             'on feeder:   ' + FeederName + '. ' +
                             'Please confirm each move if you wish to continue.'
                    ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
        ENDIF;
    ENDFOR;

    RETURN (RetCode);
END; 

Application Component Report
============================

	Name:            CheckIsolationComplete

/*
**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckIsolationComplete
**
**  Date:           Version  Description
** --------------------------------------------------
**  04/24/00  pkw    Created from CheckDeloadComplete.  If a move has a movetype 
**                   of DLD or NONE, it will not cause a deload warning. All other 
**                   move types will.
**  11/19/02  ysp    Merge: removed passed-in C and Jobs
**  01/13/03  pkw    Fix joins between SOA_JobControl and SOA_Job.
**  02/06/03  pkw    Fix Reference to Job in last select.
**  02/28/03  pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                   that span divisions.
**  03/05/03  em     Corrected k index errors.
**  05/06/03  em     Add support for CIOA card type
**  02/03/05  pkw    Include filtered moves on check.
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/16/10  em     Support for 3G
**  11/19/10  em     Extend for 3g to check for Cam-Disc visible break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status table for VisBreak check.
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings. 
**  12/12/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  01/26/17  pkw    Fix problem with Red Warning not showing up when calling CheckIsoComplete. Also,
**                   change call from checkISOcomplete to call checkISOLATIONcomplete.  This change
**                   was made because when an openauto was created for a 13kv card no cutout move
**                   is issued (which uses SDClearCheck to warn if deload/iso not complete on 4kv).  
**                   Instead when apply protective grounds is issued, DO only gets warning for 
**                   isolation move not complete.  Mike Sannito said this should warning if deload or
**                   isolation are not complete so we changed this check to call itself instead of 
**                   checkisocomplete.
**  07/27/17  em     Before presenting warning, check if Job Equipment is part of an ATS and the ATS
**                   Grouper has an outstanding isolation move that has been issued.  Don't count it if it
**                   ahs been issued.
**  03/06/18  pkw    Ignore check if MTAOpen = TRUE
**  02/01/19  pkw    If MicroGridOpen = TRUE and equip is downstreamfrom MicroGrid Line switch don't 
**                   display warning.
**  06/23/21  em     Integrating 33kV logic to prevent warning related to moves on equipment Fed By
**                   another feeder.
*/
PROCEDURE CHECKISOLATIONCOMPLETE 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;              /* index */ 
    m = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    DynamicFeederList = VARCHAR(120) NOT NULL WITH DEFAULT;   
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;   
    FedByExists = INTEGER NOT NULL; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederObjects = ARRAY OF INTEGEROBJECT;                
    NetworkFeederSource = INTEGER NOT NULL WITH DEFAULT;  
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  If MicroGridOpen = TRUE and equip is downstreamfrom MicroGrid Line switch don't 
**  display warning.
*/
   IF MicroGridOpen = TRUE THEN
      i = FALSE;
      SELECT :i = :TRUE 
      FROM   Udb_Grouping G,
             Udb_Grouping G2,
             Udb_ExtendedType ET
      WHERE  G.Member = :JIP.Equip AND
             G.Relationship = :Interaction$DownstreamFrom AND
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MicroGridFor AND
             G2.GroupingType = ET.Type AND
             ET.SuperType = :Type$Feeder;
      IF i = TRUE THEN
         RETURN(PU_OK);
      ENDIF;
   ENDIF;

   IF Card <> 0 THEN   
       /*
       **  If Card is passed in, this prompt is being called from 
       **  another ISO Precheck and we just want to run this check for
       **  that particular card.
       */
       i = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[i].Card = C.Card,
              :CommonFeederCard[i].CardClass = C.CardClass,
              :CommonFeederCard[i].FeederName = C.FeederName,
              :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
              :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
              :CommonFeederCard[i].StepDownJob = 0     
       FROM    SOA_ActiveCard AC,
               FMS_Card C
       Where   AC.Card = :Card AND
               AC.Card = C.Card
       BEGIN
           i = i + 1;
       END;

       IF i = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ELSE
       /*
       **    Find all feeder cards which this job is common to.
       **    If we couldn't find a feeder then nothing more to do. 
       */
       i = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[i].Card = C.Card,
              :CommonFeederCard[i].CardClass = C.CardClass,
              :CommonFeederCard[i].FeederName = C.FeederName,
              :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
              :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
              :CommonFeederCard[i].StepDownJob = 0  
       FROM    SOA_JobControl JC,
               SOA_ActiveCard AC,
               FMS_Card C
       WHERE   JC.Job = :JIP.Job AND
               JC.Card = C.Card AND
               JC.Card = AC.Card
       BEGIN
          i = i + 1;
       END;

       IF i = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ENDIF;
/*
**  Do check unless (Open Auto OR OOE1 card type) AND equip is the 
**  source breaker or source position.
*/
   RetCode = NULL;
   
   FOR i = 1 TO CommonFeederCard.LastRow() DO
      /*
      **  If card was passed in or StepDownJob is set, no need to 
      **  check for Step Down because check has already been performed.
      */
      IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
         /*
         **  Check to see if current feeder has an SD-VIS equipment type
         **  that is closed.  If yes, then look for other linked cards
         **  and confirm Isolation is complete for all cards.
         */
         SDCloseCheck = 0;
         SELECT :SDCloseCheck = COUNT(*)
         FROM    Udb_Switch S,
                 Udb_Grouping G,
                 TFMS_CardToObject CTO
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$SDVIS AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0;
         IF SDCloseCheck <> 0 THEN
            /*
            **  Found a closed SD-VIS device on Feeder.  Now look to see
            **  if there is a link established.
            */
            IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
               /*
               **  Move issued from 4KV card and will do additional check on 
               **  13kv card which should use ISOLATION check so just add to the 
               **  current array.  4KV card is only connected to one 13KV card so
               **  we can just use link table to find any 13 KV cards.
               */
               k = CommonFeederCard.LastRow + 1;
               SELECT DISTINCT
                  :CommonFeederCard[k].Card = C.Card,
                  :CommonFeederCard[k].CardClass = C.CardClass,
                  :CommonFeederCard[k].FeederName = C.FeederName,
                  :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                  :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                  :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                  :CommonFeederCard[k].StepDownJob = 1    
               FROM FMS_StepDownLink L,
                    SOA_ActiveCard AC,
                    FMS_Card C
               WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                     L.Card = C.Card AND
                     L.Card = AC.Card
               BEGIN
                  k = k + 1;
               END;
            ELSE
               /*
               **  Move issued from 13KV card and will do additional check on 
               **  4kv card which should use ISO check so call checkisocomplete.
               **  13KV card may be linked to multiple 4KV step down cards so
               **  we need make sure each device is closed before checking for
               **  isolation on that card.
               */
               k = 1;
               StepDownCard.Clear();
               SELECT DISTINCT
                  :StepDownCard[k].Card = CTO.Card
               FROM FMS_StepDownLink L,
                    Udb_Switch S,
                    Udb_Grouping G,
                    TFMS_CardToObject CTO
               WHERE L.Card = :CommonFeederCard[i].Card AND
                     L.StepDownCard = CTO.Card AND
                     CTO.Object = G.Grouping AND
                     G.GroupingType = :Type$Feeder AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.MemberType = :Type$SDVIS AND
                     G.Member = S.Object AND
                     S.CurrentlyOpen = 0
               BEGIN
                  k = k + 1;
               END;
               FOR k = 1 TO StepDownCard.LastRow DO
                  WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[k].Card);
                  IF (WarningStatus = PU_CANCEL) THEN
                      RETURN(PU_CANCEL);
                  ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                      RetCode = Warning$Overridden;
                  ENDIF;
               ENDFOR;
            ENDIF;
         ENDIF;
      ENDIF;  
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
      IF CommonFeederCard[i].NetworkFeeder = TRUE THEN
         k = 1;
         Open3GSwitch.Clear();
         REPEATED
         SELECT  :Open3GSwitch[k].Object = G.Member,
                 :Open3GSwitch[k].Name = O.Name
         FROM    Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 Udb_Switch S,
                 Udb_Object O
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 1 AND
                 G.Member = O.Object
         BEGIN
            k = k + 1;
         END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
         REPEATED
         SELECT
         DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                   :Open3GSwitch[k].Name = O2.Name
         FROM    Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 Udb_Switch S,
                 Udb_Object O,
                 Udb_Terminal T1,
                 Udb_Switch S2,
                 Udb_Object O2,
                 Udb_Terminal T2
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0 AND
                 G.Member = O.Object AND
                 G.Member = T1.Object AND
                 T1.Node = T2.Node AND
                 T2.Object = O2.Object AND
                 O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 O2.Object = S2.Object AND
                 S2.CurrentlyOpen = 1 AND
                 T1.Node > 20000 AND
                 T2.Node > 20000 AND
                 T1.Object <> T2.Object
         BEGIN
            k = k + 1;
         END;
/*
** Now look for Vis Break on Cam
*/            
         FOR k = 1 TO Open3GSwitch.LastRow() DO
            CamDiscFound = 0;
            REPEATED
            SELECT :CamDiscFound = OS.Object
            FROM  Udb_Grouping G,
                  FMS_ObjectStatus OS
            WHERE G.Grouping = :Open3GSwitch[k].Object AND
                  G.Relationship = :Interaction$VisibleBreakFor AND
                  G.Member = OS.Object AND
                  OS.Status = :Status$VisibleBreak AND
                  OS.StatusCount >= 1;

            IF CamDiscFound = 0 THEN

               IF JIP.Status = Job$Restore THEN
                  Operator = JIP.RSOperator;
               ELSE
                  Operator = JIP.TOOperator;
               ENDIF;
  
               REPEATED
               SELECT
               DISTINCT  :CamDiscFound = PS.Object
               FROM      FMS_PendingStatus PS,
                         Udb_Grouping G 
               WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                         G.Relationship = :Interaction$VisibleBreakFor AND
                         G.Member = PS.Object AND
                         PS.PendingStatus = :Status$VisibleBreak AND
                         PS.StatusCount > 0 AND
                         PS.IssuedOperator = :Operator;

               IF CamDiscFound = 0 THEN
  
                 WarningStatus = CALLFRAME Warning
                 (Card = JIP.Card, 
                  Job = JIP.Job, 
                  SwitchingItem = JIP.SwitchingItem,
                  Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                         Open3GSwitch[k].Name + '.'
                 ); 
                IF (WarningStatus = PU_CANCEL) THEN
                   RETURN(PU_CANCEL);
                ELSE
                   RetCode = Warning$Overridden;
                ENDIF;
              ENDIF;
            ENDIF;
         ENDFOR;
      ENDIF;
/*
** Selecting Network Source info here, will use it later in two spots, 
** second spot is specfic to 33kV handling.
*/
        NetworkFeederSource = 0;
        IF CommonFeederCard[i].NetworkFeeder <> 0 THEN
              REPEATED
              SELECT :NetworkFeederSource = COUNT(*)
              FROM   Udb_Grouping G,
                     TFMS_CardToObject CTO
              WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                     CTO.Object = G.Grouping AND
                     G.Member = :JIP.Equip AND
                    (G.Relationship = :Interaction$SourceBreaker OR
                     G.Relationship = :Interaction$SourcePosition);  
        ENDIF;         
/*
**  Do check unless (Open Auto OR OOE1 card type) AND equip is the 
**  source breaker or source position.
*/
      IF CommonFeederCard[i].CardClass = Type$OOE1 OR 
         CommonFeederCard[i].CardClass = Type$Auto OR 
         CommonFeederCard[i].CardClass = Type$CIOA THEN 

         k = 0;
         REPEATED 
         SELECT :k = COUNT(*)
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Member = :JIP.Equip AND
               (G.Relationship = :Interaction$SourceBreaker OR
                G.Relationship = :Interaction$SourcePosition);

         IF k > 0 THEN
            CONTINUE;
         ENDIF;
      ENDIF;
/*
**  If we have a 33kV card we want to look at only the feeder segments 
**  that are associated to the card. 
**  If we are calling this check from a
**  source substation equipment, then we can build equipment list from
**  segments associated to the card including segments fed by the main 
**  feeder while excluding segments fed by another feeder.  
**  If we are opening an interrupter switch
**  then we perform a trace to see if we will be isolating a portion and then 
**  only use the segments being isolated. 
*/  
      FedByExists = FALSE;
      FeederObjects.Clear();
      IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
          IF NetworkFeederSource > 0 THEN  /* Indicates source equip */
             j = 1;
             SELECT :FeederObjects[j].Value = CTO.Object
             FROM   TFMS_CardToObject CTO,
                    Udb_ExtendedType ET
             WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                    CTO.Type = ET.Type AND
                    ET.SuperType = :Type$Feeder
             BEGIN
/*
** If this feeder segment is fed by another feeder then remove it
*/
                k = 0;
                SELECT :k = Grouping
                FROM   Udb_Grouping
                WHERE  Relationship = :Interaction$FedBy AND
                       Member = :FeederObjects[j].Value;
                IF k > 0 THEN
                   FeederObjects.RemoveRow (rownumber = j);
                ELSE  
                   k = j;     
                   j = j + 1;
/*
** If this feeder feeds another segment, then include that segment
*/
                   SELECT :FeederObjects[j].Value = Member
                   FROM   Udb_Grouping
                   WHERE  Relationship = :Interaction$FedBy AND
                          Grouping = :FeederObjects[k].Value
                   BEGIN
                      FedByExists = TRUE;
                      j = j + 1;
                   END;
                ENDIF;
             END; 

          ELSE     /* Indicates non-source equip, interruptor switch */
/*
** If equipment being opened is already on a portion card, 
** it is already isolated and we aren't
** isolating anything new requiring a Deload Complete check.
*/
             k = 0;
             REPEATED
             SELECT :k = AC.Card
             FROM   Udb_Grouping G,
                    TFMS_CardToObject CTO,
                    SOA_ActiveCard AC
             WHERE  G.Member = :JIP.Equip AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.Grouping = CTO.Object AND
                    CTO.Card = AC.Card AND
                    AC.TypeOfCard = :TypeOfCard$Portion;
/*
** Call trace to return feeder segments that will be isolated.  If none returned, then we aren't isolating
** and don't need to do deload complete check.
*/
             IF k = 0 THEN
                RetCode = CALLPROC DeloadTrace33kV (
                               StartEquip = :JIP.Equip,
                               FeederSegments = FeederObjects);
                IF RetCode = PU_CANCEL THEN
                   CONTINUE;
                ENDIF;
             ENDIF;                  
          ENDIF;
/*
** If FeederObjects array is empty on a 33kV card, that means we are not isolating anything 
*/
          IF FeederObjects.LastRow() = 0 THEN
             CONTINUE;
          ENDIF;
      ENDIF;
/*
**  For each card, check for Deload moves complete and that no restore 
**  moves are complete.
**  33kV deload complete check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicFeederList = '';
         DynamicWhereClause = '';
         FOR k = 1 TO FeederObjects.LastRow() DO
            IF k = 1 THEN
               DynamicFeederList = ' (' + VARCHAR(FeederObjects[k].Value);
            ELSE
               DynamicFeederList = DynamicFeederList + ',' + VARCHAR(FeederObjects[k].Value);
            ENDIF;  
         ENDFOR;
         DynamicFeederList = DynamicFeederList + ') ';
       
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

         k = 0;
         SELECT :k = COUNT(*)
         FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
         WHERE  :DynamicWhereClause;

         m = 0;
         IF k > 0 THEN      
/*
** Don't count issued moves on an associated ATS Grouper
** Looking to ignore Place in Manual move that is issued in the same set of moves.
*/ 
            DynamicWhereClause = 
               'G.Member = ' + VARCHAR(JIP.Equip) + ' AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.GroupingType = ET.Type AND ' +
               'ET.SuperType = ' + VARCHAR(Type$ATSGrouper) + ' AND ' +
               'G.Grouping = J.Equip AND ' + 
               'J.Equip = G2.Member AND ' +
               'G2.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G2.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOIssued IS NOT NULL AND ' +
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 
               
         REPEATED 
         SELECT :m = COUNT(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                Udb_Grouping G,
                Udb_ExtendedType ET,
                Udb_Grouping G2,
                SOA_ActiveObject AO
         WHERE  :DynamicWhereClause;

         ENDIF;
      ELSE     /*Normal IsolationComplete*/
      
      k = 0;
      REPEATED
      SELECT :k = COUNT(*)
      FROM SOA_Job J,
           SOA_JobControl JC
      WHERE  JC.Card = :CommonFeederCard[i].Card AND
        (JC.StepPair = :StepHeading$Deload OR
         JC.StepPair = :StepHeading$Iso) AND
         JC.Job = J.Job AND
         J.JobClass <> 0 AND 
         J.TOComplete IS NULL AND
         J.Status = '' AND
         J.MoveType <> 'DLD' AND
         J.MoveType <> 'NONE';
      
      m = 0;
      IF k > 0 THEN      
/*
** Don't count issued moves on an associated ATS Grouper
** Looking to ignore Place in Manual move that is issued in the same set of moves.
*/ 
         REPEATED 
         SELECT :m = COUNT(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                Udb_Grouping G,
                Udb_ExtendedType ET
         WHERE  G.Member = :JIP.Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = ET.Type AND
                ET.SuperType = :Type$ATSGrouper AND
                G.Grouping = J.Equip AND 
         JC.Card = :CommonFeederCard[i].Card AND
        (JC.StepPair = :StepHeading$Deload OR
         JC.StepPair = :StepHeading$Iso) AND
         JC.Job = J.Job AND
         J.JobClass <> 0 AND 
         J.TOIssued IS NOT NULL AND
         J.TOComplete IS NULL AND
         J.Status = '' AND
         J.MoveType <> 'DLD' AND
         J.MoveType <> 'NONE';
      ENDIF;
      
      ENDIF;
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
      IF FedByExists = TRUE THEN
         FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
      ELSE
         FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
      ENDIF;

      IF k > 0 THEN
         IF k - m > 0 THEN 
             WarningStatus = CALLFRAME Warning
                      ( Card = CommonFeederCard[i].Card, 
                        Job = JIP.Job,
                        SwitchingItem = JIP.SwitchingItem, 
                        Text = 'Not all Isolation moves have been completed ' +
                                FeederName + '.'
                      ); 
             IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
             ELSE
                RetCode = Warning$Overridden;
             ENDIF;
          ENDIF;
      ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  has, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
**  33kV deload move check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               '(J.RSComplete IS NOT NULL AND J.RSComplete <> ' + '''' + '''' + ') AND ' + 
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = 1;
        TempJobs.Clear();
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause
        BEGIN
           k = k + 1;
        END;

      ELSE  /*Normal IsolationComplete*/

      k = 1;
      TempJobs.Clear();
      REPEATED
      SELECT :TempJobs[k].Job = J.Job,
             :TempJobs[k].JobClass = J.JobClass,
             :TempJobs[k].Equip = J.Equip
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :CommonFeederCard[i].Card AND 
            (JC.StepPair = :StepHeading$Deload OR
             JC.StepPair = :StepHeading$Iso) AND
             JC.Job = J.Job AND
             J.JobClass <> 0 AND 
             (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
             J.Status = '' AND
             J.MoveType <> 'DLD' AND
             J.MoveType <> 'NONE'
      BEGIN
         k = k + 1;
      END;
      
      ENDIF;

      IF TempJobs.LastRow() > 0 THEN
         IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */

            DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NOT NULL AND ' +
               'J.RSComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''';  

            k = 1;
            AllISOJobs.Clear();
            SELECT :AllISOJobs[k].Job = J.Job,
                   :AllISOJobs[k].JobClass = J.JobClass,
                   :AllISOJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_Grouping G,
                   SOA_ActiveObject AO
            WHERE  :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;

         ELSE  /*Normal IsolationComplete*/

         k = 1;
         REPEATED
         SELECT :AllISOJobs[k].Job = J.Job,
                :AllISOJobs[k].JobClass = J.JobClass,
                :AllISOJobs[k].Equip = Equip
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND 
               (JC.StepPair = :StepHeading$Deload OR
                JC.StepPair = :StepHeading$Iso) AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
                J.TOComplete IS NOT NULL AND 
                J.RSComplete IS NULL AND
                J.Status = ''
         BEGIN
           k = k + 1;
         END;
         
         ENDIF;

        k = 1;
        WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
           IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
              ALLISOJobs[k].Job <> TempJobs[1].Job AND
              ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
              TempJobs.RemoveRow (Rownumber = 1);
              k = 0; 
           ENDIF;
           k = k + 1;
        ENDWHILE;

        IF TempJobs.LastRow() > 0 THEN
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
              IF FedByExists = TRUE THEN
                 FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
              ELSE
                 FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
              ENDIF;
              
            WarningStatus = CALLFRAME Warning
                 (Card = CommonFeederCard[i].Card, 
                  Job = JIP.Job, 
                  SwitchingItem = JIP.SwitchingItem,
                  Text = 'A Isolation move has been Restored ' + FeederName + '.  You must ' +
                         'confirm that the necessary Isolation moves ' +
                         'have been Taken Out.'
                 ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;

   ENDFOR;
        
   RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckIsolationComplete_33kVTemp

/*

WITH DELOAD COMPLETE LOGIC for 33KV - NOT SURE IF APPROPRIATE

*.
/*
**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckIsolationComplete
**
**  Date:           Version  Description
** --------------------------------------------------
**  04/24/00  pkw    Created from CheckDeloadComplete.  If a move has a movetype 
**                   of DLD or NONE, it will not cause a deload warning. All other 
**                   move types will.
**  11/19/02  ysp    Merge: removed passed-in C and Jobs
**  01/13/03  pkw    Fix joins between SOA_JobControl and SOA_Job.
**  02/06/03  pkw    Fix Reference to Job in last select.
**  02/28/03  pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                   that span divisions.
**  03/05/03  em     Corrected k index errors.
**  05/06/03  em     Add support for CIOA card type
**  02/03/05  pkw    Include filtered moves on check.
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/16/10  em     Support for 3G
**  11/19/10  em     Extend for 3g to check for Cam-Disc visible break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status table for VisBreak check.
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings. 
**  12/12/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  05/6/16   em     Extend 33kV CheckDeloadComplete change here to look at specific feeder 
**                   segments only.

** 
*/
PROCEDURE CHECKISOLATIONCOMPLETE_33kvtemp
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL; 
    k = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    DynamicFeederList = VARCHAR(120) NOT NULL WITH DEFAULT;   
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;   
    FedByExists = INTEGER NOT NULL; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederObjects = ARRAY OF INTEGEROBJECT;                
    NetworkFeederSource = INTEGER NOT NULL WITH DEFAULT;  
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
IF Card <> 0 THEN   
    /*
    **  If Card is passed in, this prompt is being called from 
    **  another ISO Precheck and we just want to run this check for
    **  that particular card.
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0     
    FROM    SOA_ActiveCard AC,
            FMS_Card C
    Where   AC.Card = :Card AND
            AC.Card = C.Card
    BEGIN
        i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ELSE
    /*
    **    Find all feeder cards which this job is common to.
    **    If we couldn't find a feeder then nothing more to do. 
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0  
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ENDIF;

    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
       /*
       **  If card was passed in or StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;

          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Move issued from 4KV card and will do additional check on 
                **  13kv card which should use ISOLATION check so just add to the 
                **  current array.  4KV card is only connected to one 13KV card so
                **  we can just use link table to find any 13 KV cards.
                */
                k = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[k].Card = C.Card,
                   :CommonFeederCard[k].CardClass = C.CardClass,
                   :CommonFeederCard[k].FeederName = C.FeederName,
                   :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[k].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     SOA_ActiveCard AC,
                     FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                      L.Card = C.Card AND
                      L.Card = AC.Card
                BEGIN
                   k = k + 1;
                END;
             ELSE
                /*
                **  Move issued from 13KV card and will do additional check on 
                **  4kv card which should use ISO check so call checkisocomplete.
                **  13KV card may be linked to multiple 4KV step down cards so
                **  we need make sure each device is closed before checking for
                **  isolation on that card.
                */
                k = 1;
                StepDownCard.Clear();
                SELECT DISTINCT
                   :StepDownCard[k].Card = CTO.Card
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[i].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   k = k + 1;
                END;
                FOR k = 1 TO StepDownCard.LastRow DO
                   CALLPROC CheckIsoComplete(Card = :StepDownCard[k].Card);
                   /* Don't return because there are more feeders to look at...
                   RetCode = CALLPROC CheckIsoComplete(Card = :StepDownCard[k].Card);
                   IF RetCode IS NULL THEN
                      RETURN(NULL);  
                   ENDIF;
                   */
                ENDFOR;
             ENDIF;
          ENDIF;
       ENDIF;  
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
        IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$3G THEN
           k = 1;
           Open3GSwitch.Clear();
           REPEATED
           SELECT  :Open3GSwitch[k].Object = G.Member,
                   :Open3GSwitch[k].Name = O.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 1 AND
                   G.Member = O.Object
           BEGIN
              k = k + 1;
           END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
           REPEATED
           SELECT
           DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                     :Open3GSwitch[k].Name = O2.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O,
                   Udb_Terminal T1,
                   Udb_Switch S2,
                   Udb_Object O2,
                   Udb_Terminal T2
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 0 AND
                   G.Member = O.Object AND
                   G.Member = T1.Object AND
                   T1.Node = T2.Node AND
                   T2.Object = O2.Object AND
                   O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   O2.Object = S2.Object AND
                   S2.CurrentlyOpen = 1 AND
                   T1.Node > 20000 AND
                   T2.Node > 20000 AND
                   T1.Object <> T2.Object
           BEGIN
              k = k + 1;
           END;
/*
** Now look for Vis Break on Cam
*/            
           FOR k = 1 TO Open3GSwitch.LastRow() DO
              CamDiscFound = 0;
              REPEATED
              SELECT :CamDiscFound = OS.Object
              FROM  Udb_Grouping G,
                    FMS_ObjectStatus OS
              WHERE G.Grouping = :Open3GSwitch[k].Object AND
                    G.Relationship = :Interaction$VisibleBreakFor AND
                    G.Member = OS.Object AND
                    OS.Status = :Status$VisibleBreak AND
                    OS.StatusCount >= 1;

              IF CamDiscFound = 0 THEN

                 IF JIP.Status = Job$Restore THEN
                    Operator = JIP.RSOperator;
                 ELSE
                    Operator = JIP.TOOperator;
                 ENDIF;
  
                 REPEATED
                 SELECT
                 DISTINCT  :CamDiscFound = PS.Object
                 FROM      FMS_PendingStatus PS,
                           Udb_Grouping G 
                 WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                           G.Relationship = :Interaction$VisibleBreakFor AND
                           G.Member = PS.Object AND
                           PS.PendingStatus = :Status$VisibleBreak AND
                           PS.StatusCount > 0 AND
                           PS.IssuedOperator = :Operator;

                 IF CamDiscFound = 0 THEN
  
                   WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                           Open3GSwitch[k].Name + '.'
                   ); 
                  IF (WarningStatus = PU_CANCEL) THEN
                     RETURN(PU_CANCEL);
                  ELSE
                     RetCode = Warning$Overridden;
                  ENDIF;
                ENDIF;
              ENDIF;
           ENDFOR;
        ENDIF;
/*
** Selecting Network Source info here, will use it later in two spots, 
** second spot is specfic to 33kV handling.
*/
        NetworkFeederSource = 0;
        IF CommonFeederCard[i].NetworkFeeder <> 0 THEN
              REPEATED
              SELECT :NetworkFeederSource = COUNT(*)
              FROM   Udb_Grouping G,
                     TFMS_CardToObject CTO
              WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                     CTO.Object = G.Grouping AND
                     G.Member = :JIP.Equip AND
                    (G.Relationship = :Interaction$SourceBreaker OR
                     G.Relationship = :Interaction$SourcePosition);  
        ENDIF;         
/*
**  Do check unless (Open Auto OR OOE1 card type) AND equip is the 
**  source breaker or source position.
*/
       IF CommonFeederCard[i].CardClass = Type$OOE1 OR 
          CommonFeederCard[i].CardClass = Type$Auto OR 
          CommonFeederCard[i].CardClass = Type$CIOA THEN 

           k = 0;
           IF CommonFeederCard[i].NetworkFeeder <> 0 THEN
              k = NetworkFeederSource;
           ELSE
              SELECT :k = COUNT(*)
              FROM   Udb_Grouping
              WHERE  Grouping = :CommonFeederCard[i].Feeder AND
                     Member = :JIP.Equip AND
                    (Relationship = :Interaction$SourceBreaker OR
                     Relationship = :Interaction$SourcePosition);
           ENDIF;

          IF k > 0 THEN
             CONTINUE;
          ENDIF;
       ENDIF;
/*
**  If we have a 33kV card we want to look at only the feeder segments 
**  that are associated to the card. 
**  If we are calling this check from a
**  source substation equipment, then we can build equipment list from
**  segments associated to the card including segments fed by the main 
**  feeder while excluding segments fed by another feeder.  
**  If we are opening an interrupter switch
**  then we perform a trace to see if we will be isolating a portion and then 
**  only use the segments being isolated. 
*/  
      FedByExists = FALSE;
      FeederObjects.Clear();
      IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
          IF NetworkFeederSource > 0 THEN  /* Indicates source equip */
             j = 1;
             SELECT :FeederObjects[j].Value = CTO.Object
             FROM   TFMS_CardToObject CTO,
                    Udb_ExtendedType ET
             WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                    CTO.Type = ET.Type AND
                    ET.SuperType = :Type$Feeder
             BEGIN
/*
** If this feeder segment is fed by another feeder then remove it
*/
                k = 0;
                SELECT :k = Grouping
                FROM   Udb_Grouping
                WHERE  Relationship = :Interaction$FedBy AND
                       Member = :FeederObjects[j].Value;
                IF k > 0 THEN
                   FeederObjects.RemoveRow (rownumber = j);
                ELSE  
                   k = j;     
                   j = j + 1;
/*
** If this feeder feeds another segment, then include that segment
*/
                   SELECT :FeederObjects[j].Value = Member
                   FROM   Udb_Grouping
                   WHERE  Relationship = :Interaction$FedBy AND
                          Grouping = :FeederObjects[k].Value
                   BEGIN
                      FedByExists = TRUE;
                      j = j + 1;
                   END;
                ENDIF;
             END; 

          ELSE     /* Indicates non-source equip, interruptor switch */
/*
** If equipment being opened is already on a portion card, 
** it is already isolated and we aren't
** isolating anything new requiring a Deload Complete check.
*/
             k = 0;
             REPEATED
             SELECT :k = AC.Card
             FROM   Udb_Grouping G,
                    TFMS_CardToObject CTO,
                    SOA_ActiveCard AC
             WHERE  G.Member = :JIP.Equip AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.Grouping = CTO.Object AND
                    CTO.Card = AC.Card AND
                    AC.TypeOfCard = :TypeOfCard$Portion;
/*
** Call trace to return feeder segments that will be isolated.  If none returned, then we aren't isolating
** and don't need to do deload complete check.
*/
             IF k = 0 THEN
                RetCode = CALLPROC DeloadTrace33kV (
                               StartEquip = :JIP.Equip,
                               FeederSegments = FeederObjects);
                IF RetCode = PU_CANCEL THEN
                   RETURN (PU_CANCEL);
                ENDIF;
             ENDIF;                  
          ENDIF;
/*
** If FeederObjects array is empty on a 33kV card, that means we are not isolating anything 
*/
          IF FeederObjects.LastRow() = 0 THEN
             CONTINUE;
          ENDIF;
      ENDIF;
/*
**  For each card, check for Deload moves complete and that no restore 
**  moves are complete.
**  33kV deload complete check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicFeederList = '';
         DynamicWhereClause = '';
         FOR k = 1 TO FeederObjects.LastRow() DO
            IF k = 1 THEN
               DynamicFeederList = ' (' + VARCHAR(FeederObjects[k].Value);
            ELSE
               DynamicFeederList = DynamicFeederList + ',' + VARCHAR(FeederObjects[k].Value);
            ENDIF;  
         ENDFOR;
         DynamicFeederList = DynamicFeederList + ') ';
       
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = k;
        SELECT :k = COUNT(*)
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause;

      ELSE     /*Normal IsolationComplete*/
        k = 0;
        REPEATED
        SELECT :k = COUNT(*)
        FROM SOA_Job J,
             SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
          (JC.StepPair = :StepHeading$Deload OR
           JC.StepPair = :StepHeading$Iso) AND
           JC.Job = J.Job AND
           J.JobClass <> 0 AND 
           J.TOComplete IS NULL AND
           J.Status = '' AND
           J.MoveType <> 'DLD' AND
           J.MoveType <> 'NONE';
      ENDIF;
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
      IF FedByExists = TRUE THEN
         FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
      ELSE
         FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
      ENDIF;

        IF k > 0 THEN
            WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'Not all Isolation moves have been completed ' + FeederName + '.'
                        ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
        ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  has, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
**  33kV deload move check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               '(J.RSComplete IS NOT NULL AND J.RSComplete <> ' + '''' + '''' + ') AND ' + 
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = 1;
        TempJobs.Clear();
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause
        BEGIN
           k = k + 1;
        END;

      ELSE  /*Normal IsolationComplete*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND 
              (JC.StepPair = :StepHeading$Deload OR
               JC.StepPair = :StepHeading$Iso) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
               J.Status = '' AND
               J.MoveType <> 'DLD' AND
               J.MoveType <> 'NONE'
        BEGIN
           k = k + 1;
        END;
      ENDIF;

        IF TempJobs.LastRow() > 0 THEN
         IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */

            DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NOT NULL AND ' +
               'J.RSComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''';  

            k = 1;
            AllISOJobs.Clear();
            SELECT :AllISOJobs[k].Job = J.Job,
                   :AllISOJobs[k].JobClass = J.JobClass,
                   :AllISOJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_Grouping G,
                   SOA_ActiveObject AO
            WHERE  :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;

         ELSE  /*Normal IsolationComplete*/
           k = 1;
           REPEATED
           SELECT :AllISOJobs[k].Job = J.Job,
                  :AllISOJobs[k].JobClass = J.JobClass,
                  :AllISOJobs[k].Equip = Equip
           FROM   SOA_Job J,
                  SOA_JobControl JC
           WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                 (JC.StepPair = :StepHeading$Deload OR
                  JC.StepPair = :StepHeading$Iso) AND
                  JC.Job = J.Job AND
                  J.JobClass <> 0 AND 
                  J.TOComplete IS NOT NULL AND 
                  J.RSComplete IS NULL AND
                  J.Status = ''
           BEGIN
             k = k + 1;
           END;
         ENDIF;

          k = 1;
          WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
             IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
                ALLISOJobs[k].Job <> TempJobs[1].Job AND
                ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
                TempJobs.RemoveRow (Rownumber = 1);
                k = 0; 
             ENDIF;
             k = k + 1;
          ENDWHILE;

          IF TempJobs.LastRow() > 0 THEN
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
              IF FedByExists = TRUE THEN
                 FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
              ELSE
                 FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
              ENDIF;

              WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'An Isolation move has been Restored ' + FeederName + '.  You must ' +
                           'confirm that the necessary Isolation moves ' +
                           'have been Taken Out.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
           ENDIF;
        ENDIF;

    ENDFOR;
        
    RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckIsolationCompleteAllCards

/*

WITH DELOAD COMPLETE LOGIC for 33KV - NOT SURE IF APPROPRIATE

*/
/*
**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckIsolationCompleteAllCards
**
**  Date:           Version  Description
** --------------------------------------------------
**  05/26/04  ysp    Created from CheckIsolationComplete. Check all cards
**                   regardless of their card types. 
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/19/10  em     Extend for 3g to check for Cam-Disc visbile break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status when looking for VisBreak
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings.  
**  12/13/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  05/06/16  em     Copied change made to CheckIsolationComplete for 33kV
**  01/26/17  pkw    Fix problem with Red Warning not showing up when calling CheckIsoComplete. Also,
**                   change call from checkISOcomplete to call checkISOLATIONcomplete.  This change
**                   was made because when an openauto was created for a 13kv card no cutout move
**                   is issued (which uses SDClearCheck to warn if deload/iso not complete on 4kv).  
**                   Instead when apply protective grounds is issued, DO only gets warning for 
**                   isolation move not complete.  Mike Sannito said this should warning if deload or
**                   isolation are not complete so we changed this check to call itself instead of 
**                   checkisocomplete.
**  03/06/18  pkw    Ignore check if MTAOpen = TRUE
**  09/13/18  em     Re-enabling this check and bringing up-to-date with changes since 2016
*/
PROCEDURE CheckIsolationCompleteAllCards
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL; 
    k = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    DynamicFeederList = VARCHAR(120) NOT NULL WITH DEFAULT;   
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;   
    FedByExists = INTEGER NOT NULL; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederObjects = ARRAY OF INTEGEROBJECT;                
    NetworkFeederSource = INTEGER NOT NULL WITH DEFAULT;  
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;

IF Card <> 0 THEN   
    /*
    **  If Card is passed in, this prompt is being called from 
    **  another ISO Precheck and we just want to run this check for
    **  that particular card.
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0     
    FROM    SOA_ActiveCard AC,
            FMS_Card C
    Where   AC.Card = :Card AND
            AC.Card = C.Card
    BEGIN
        i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ELSE
    /*
    **    Find all feeder cards which this piece of equipment is common too.
    **    If we couldn't find a feeder then nothing more to do. 
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,  /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0  
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ENDIF;
/*
**  For each card, check any incomplete deload moves
*/
    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
       /*
       **  If card was passed in or StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;
          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Move issued from 4KV card and will do additional check on 
                **  13kv card which should use ISOLATION check so just add to the 
                **  current array. 4KV card is only connected to one 13KV card so
                **  we can just use link table to find any 13 KV cards.
                */
                k = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[k].Card = C.Card,
                   :CommonFeederCard[k].CardClass = C.CardClass,
                   :CommonFeederCard[k].FeederName = C.FeederName,
                   :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[k].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     SOA_ActiveCard AC,
                     FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                      L.Card = C.Card AND
                      L.Card = AC.Card
                BEGIN
                   k = k + 1;
                END;
             ELSE
                /*
                **  Move issued from 13KV card and will do additional check on 
                **  4kv card which should use ISO check so call checkisocomplete.
                **  13KV card may be linked to multiple 4KV step down cards so
                **  we need make sure each device is closed before checking for
                **  isolation on that card.
                */
                k = 1;
                StepDownCard.Clear();
                SELECT DISTINCT
                   :StepDownCard[k].Card = CTO.Card
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[i].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   k = k + 1;
                END;
                FOR k = 1 TO StepDownCard.LastRow DO
                   WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[k].Card);
                   IF WarningStatus = PU_CANCEL THEN
                       RETURN(PU_CANCEL);
                   ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                       RetCode = Warning$Overridden;
                   ENDIF;
                ENDFOR;
             ENDIF;
          ENDIF;
       ENDIF;  
/*
**  If we have a 33kV card we want to look at only the feeder segments 
**  that are associated to the card. 
**  If we are calling this check from a
**  source substation equipment, then we can build equipment list from
**  segments associated to the card including segments fed by the main 
**  feeder while excluding segments fed by another feeder.  
**  If we are opening an interrupter switch
**  then we perform a trace to see if we will be isolating a portion and then 
**  only use the segments being isolated. 
*/  
       NetworkFeederSource = 0;
       FedByExists = FALSE;
       FeederObjects.Clear();
       IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
              REPEATED
              SELECT :NetworkFeederSource = COUNT(*)
              FROM   Udb_Grouping G,
                     TFMS_CardToObject CTO
              WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                     CTO.Object = G.Grouping AND
                     G.Member = :JIP.Equip AND
                    (G.Relationship = :Interaction$SourceBreaker OR
                     G.Relationship = :Interaction$SourcePosition);  

          IF NetworkFeederSource > 0 THEN  /* Indicates source equip */
             j = 1;
             SELECT :FeederObjects[j].Value = CTO.Object
             FROM   TFMS_CardToObject CTO,
                    Udb_ExtendedType ET
             WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                    CTO.Type = ET.Type AND
                    ET.SuperType = :Type$Feeder
             BEGIN
/*
** If this feeder segment is fed by another feeder then remove it
*/
                k = 0;
                SELECT :k = Grouping
                FROM   Udb_Grouping
                WHERE  Relationship = :Interaction$FedBy AND
                       Member = :FeederObjects[j].Value;
                IF k > 0 THEN
                   FeederObjects.RemoveRow (rownumber = j);
                ELSE  
                   k = j;     
                   j = j + 1;
/*
** If this feeder feeds another segment, then include that segment
*/
                   SELECT :FeederObjects[j].Value = Member
                   FROM   Udb_Grouping
                   WHERE  Relationship = :Interaction$FedBy AND
                          Grouping = :FeederObjects[k].Value
                   BEGIN
                      FedByExists = TRUE;
                      j = j + 1;
                   END;
                ENDIF;
             END; 

          ELSE     /* Indicates non-source equip, interruptor switch */
/*
** If equipment being opened is already on a portion card, 
** it is already isolated and we aren't
** isolating anything new requiring a Deload Complete check.
*/
             k = 0;
             REPEATED
             SELECT :k = AC.Card
             FROM   Udb_Grouping G,
                    TFMS_CardToObject CTO,
                    SOA_ActiveCard AC
             WHERE  G.Member = :JIP.Equip AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.Grouping = CTO.Object AND
                    CTO.Card = AC.Card AND
                    AC.TypeOfCard = :TypeOfCard$Portion;
/*
** Call trace to return feeder segments that will be isolated.  If none returned, then we aren't isolating
** and don't need to do deload complete check.
*/
             IF k = 0 THEN
                RetCode = CALLPROC DeloadTrace33kV (
                               StartEquip = :JIP.Equip,
                               FeederSegments = FeederObjects);
                IF RetCode = PU_CANCEL THEN
                   RETURN (PU_CANCEL);
                ENDIF;
             ENDIF;                  
          ENDIF;
/*
** If FeederObjects array is empty on a 33kV card, that means we are not isolating anything 
*/
          IF FeederObjects.LastRow() = 0 THEN
             CONTINUE;
          ENDIF;
      ENDIF;
/*
**  For each card, check for Deload moves complete and that no restore 
**  moves are complete.
**  33kV deload complete check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicFeederList = '';
         DynamicWhereClause = '';
         FOR k = 1 TO FeederObjects.LastRow() DO
            IF k = 1 THEN
               DynamicFeederList = ' (' + VARCHAR(FeederObjects[k].Value);
            ELSE
               DynamicFeederList = DynamicFeederList + ',' + VARCHAR(FeederObjects[k].Value);
            ENDIF;  
         ENDFOR;
         DynamicFeederList = DynamicFeederList + ') ';
       
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = k;
        SELECT :k = COUNT(*)
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause;

      ELSE     /*Normal IsolationComplete*/

        k = 0;
        REPEATED
        SELECT :k = COUNT(*)
        FROM SOA_Job J,
             SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
          (JC.StepPair = :StepHeading$Deload OR
           JC.StepPair = :StepHeading$Iso) AND
           JC.Job = J.Job AND
           J.JobClass <> 0 AND 
           J.TOComplete IS NULL AND
           J.Status = '' AND
           J.MoveType <> 'DLD' AND
           J.MoveType <> 'NONE';
       ENDIF;  
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
      IF FedByExists = TRUE THEN
         FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
      ELSE
         FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
      ENDIF;

        IF k > 0 THEN
            WarningStatus = CALLFRAME Warning
                        ( Card = CommonFeederCard[i].Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'Not all Isolation moves have been completed ' + FeederName + '.'
                        ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
        ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  have, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
**  33kV deload move check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               '(J.RSComplete IS NOT NULL AND J.RSComplete <> ' + '''' + '''' + ') AND ' + 
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = 1;
        TempJobs.Clear();
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause
        BEGIN
           k = k + 1;
        END;

      ELSE  /*Normal IsolationComplete*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND 
              (JC.StepPair = :StepHeading$Deload OR
               JC.StepPair = :StepHeading$Iso) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
               J.Status = '' AND
               J.MoveType <> 'DLD' AND
               J.MoveType <> 'NONE'
        BEGIN
           k = k + 1;
        END;
      ENDIF;

        IF TempJobs.LastRow() > 0 THEN
         IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */

            DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NOT NULL AND ' +
               'J.RSComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''';  

            k = 1;
            AllISOJobs.Clear();
            SELECT :AllISOJobs[k].Job = J.Job,
                   :AllISOJobs[k].JobClass = J.JobClass,
                   :AllISOJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_Grouping G,
                   SOA_ActiveObject AO
            WHERE  :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;

         ELSE  /*Normal IsolationComplete*/
           k = 1;
           REPEATED
           SELECT :AllISOJobs[k].Job = J.Job,
                  :AllISOJobs[k].JobClass = J.JobClass,
                  :AllISOJobs[k].Equip = Equip
           FROM   SOA_Job J,
                  SOA_JobControl JC
           WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                 (JC.StepPair = :StepHeading$Deload OR
                  JC.StepPair = :StepHeading$Iso) AND
                  JC.Job = J.Job AND
                  J.JobClass <> 0 AND 
                  J.TOComplete IS NOT NULL AND 
                  J.RSComplete IS NULL AND
                  J.Status = '' 
           BEGIN
             k = k + 1;
           END;
         ENDIF;

          k = 1;
          WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
             IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
                ALLISOJobs[k].Job <> TempJobs[1].Job AND
                ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
                TempJobs.RemoveRow (Rownumber = 1);
                k = 0; 
             ENDIF;
             k = k + 1;
          ENDWHILE;
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
              IF FedByExists = TRUE THEN
                 FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
              ELSE
                 FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
              ENDIF;

          IF TempJobs.LastRow() > 0 THEN
              WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'An Isolation move has been Restored ' + FeederName + '.  You must ' +
                           'confirm that the necessary Isolation moves ' +
                           'have been Taken Out.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
           ENDIF;
        ENDIF;
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
        IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$3G THEN
           k = 1;
           Open3GSwitch.Clear();
           REPEATED
           SELECT  :Open3GSwitch[k].Object = G.Member,
                   :Open3GSwitch[k].Name = O.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 1 AND
                   G.Member = O.Object
           BEGIN
              k = k + 1;
           END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
           REPEATED
           SELECT
           DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                   :Open3GSwitch[k].Name = O2.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O,
                   Udb_Terminal T1,
                   Udb_Switch S2,
                   Udb_Object O2,
                   Udb_Terminal T2
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 0 AND
                   G.Member = O.Object AND
                   G.Member = T1.Object AND
                   T1.Node = T2.Node AND
                   T2.Object = O2.Object AND
                   O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   O2.Object = S2.Object AND
                   S2.CurrentlyOpen = 1 AND
                   T1.Node > 20000 AND
                   T2.Node > 20000 AND
                   T1.Object <> T2.Object
           BEGIN
              k = k + 1;
           END;
/*
** Now look for Vis Break on Cam
*/           
           FOR k = 1 TO Open3GSwitch.LastRow() DO
              CamDiscFound = 0;
              REPEATED
              SELECT :CamDiscFound = OS.Object
              FROM  Udb_Grouping G,
                    FMS_ObjectStatus OS
              WHERE G.Grouping = :Open3GSwitch[k].Object AND
                    G.Relationship = :Interaction$VisibleBreakFor AND
                    G.Member = OS.Object AND
                    OS.Status = :Status$VisibleBreak AND
                    OS.StatusCount >= 1;

              IF CamDiscFound = 0 THEN

                 IF JIP.Status = Job$Restore THEN
                    Operator = JIP.RSOperator;
                 ELSE
                    Operator = JIP.TOOperator;
                 ENDIF;
  
                 REPEATED
                 SELECT
                 DISTINCT  :CamDiscFound = PS.Object
                 FROM      FMS_PendingStatus PS,
                           Udb_Grouping G 
                 WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                           G.Relationship = :Interaction$VisibleBreakFor AND
                           G.Member = PS.Object AND
                           PS.PendingStatus = :Status$VisibleBreak AND
                           PS.StatusCount > 0 AND
                           PS.IssuedOperator = :Operator;

                 IF CamDiscFound = 0 THEN
                   WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                           Open3GSwitch[k].Name + '.'
                   ); 
                   IF (WarningStatus = PU_CANCEL) THEN
                      RETURN(PU_CANCEL);
                   ELSE
                      RetCode = Warning$Overridden;
                   ENDIF;
                 ENDIF;
              ENDIF;
           ENDFOR;
        ENDIF;
    ENDFOR;
        
    RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckIsolationCompleteAllCards33

/*

WITH DELOAD COMPLETE LOGIC for 33KV - NOT SURE IF APPROPRIATE

*/
/*
**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckIsolationCompleteAllCards
**
**  Date:           Version  Description
** --------------------------------------------------
**  05/26/04  ysp    Created from CheckIsolationComplete. Check all cards
**                   regardless of their card types. 
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/19/10  em     Extend for 3g to check for Cam-Disc visbile break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status when looking for VisBreak
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings.  
**  12/13/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  05/06/16  em     Copied change made to CheckIsolationComplete for 33kV
**  01/26/17  pkw    Fix problem with Red Warning not showing up when calling CheckIsoComplete. Also,
**                   change call from checkISOcomplete to call checkISOLATIONcomplete.  This change
**                   was made because when an openauto was created for a 13kv card no cutout move
**                   is issued (which uses SDClearCheck to warn if deload/iso not complete on 4kv).  
**                   Instead when apply protective grounds is issued, DO only gets warning for 
**                   isolation move not complete.  Mike Sannito said this should warning if deload or
**                   isolation are not complete so we changed this check to call itself instead of 
**                   checkisocomplete.
**  03/06/18  pkw    Ignore check if MTAOpen = TRUE
**  09/13/18  em     Re-enabling this check and bringing up-to-date with changes since 2016
*/
PROCEDURE CheckIsolationCompleteAllCards33
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL; 
    k = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    DynamicFeederList = VARCHAR(120) NOT NULL WITH DEFAULT;   
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;   
    FedByExists = INTEGER NOT NULL; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederObjects = ARRAY OF INTEGEROBJECT;                
    NetworkFeederSource = INTEGER NOT NULL WITH DEFAULT;  
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;

IF Card <> 0 THEN   
    /*
    **  If Card is passed in, this prompt is being called from 
    **  another ISO Precheck and we just want to run this check for
    **  that particular card.
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0     
    FROM    SOA_ActiveCard AC,
            FMS_Card C
    Where   AC.Card = :Card AND
            AC.Card = C.Card
    BEGIN
        i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ELSE
    /*
    **    Find all feeder cards which this piece of equipment is common too.
    **    If we couldn't find a feeder then nothing more to do. 
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,  /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0  
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ENDIF;
/*
**  For each card, check any incomplete deload moves
*/
    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
       /*
       **  If card was passed in or StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;
          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Move issued from 4KV card and will do additional check on 
                **  13kv card which should use ISOLATION check so just add to the 
                **  current array. 4KV card is only connected to one 13KV card so
                **  we can just use link table to find any 13 KV cards.
                */
                k = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[k].Card = C.Card,
                   :CommonFeederCard[k].CardClass = C.CardClass,
                   :CommonFeederCard[k].FeederName = C.FeederName,
                   :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[k].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     SOA_ActiveCard AC,
                     FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                      L.Card = C.Card AND
                      L.Card = AC.Card
                BEGIN
                   k = k + 1;
                END;
             ELSE
                /*
                **  Move issued from 13KV card and will do additional check on 
                **  4kv card which should use ISO check so call checkisocomplete.
                **  13KV card may be linked to multiple 4KV step down cards so
                **  we need make sure each device is closed before checking for
                **  isolation on that card.
                */
                k = 1;
                StepDownCard.Clear();
                SELECT DISTINCT
                   :StepDownCard[k].Card = CTO.Card
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[i].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   k = k + 1;
                END;
                FOR k = 1 TO StepDownCard.LastRow DO
                   WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[k].Card);
                   IF WarningStatus = PU_CANCEL THEN
                       RETURN(PU_CANCEL);
                   ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                       RetCode = Warning$Overridden;
                   ENDIF;
                ENDFOR;
             ENDIF;
          ENDIF;
       ENDIF;  
/*
**  If we have a 33kV card we want to look at only the feeder segments 
**  that are associated to the card. 
**  If we are calling this check from a
**  source substation equipment, then we can build equipment list from
**  segments associated to the card including segments fed by the main 
**  feeder while excluding segments fed by another feeder.  
**  If we are opening an interrupter switch
**  then we perform a trace to see if we will be isolating a portion and then 
**  only use the segments being isolated. 
*/  
       NetworkFeederSource = 0;
       FedByExists = FALSE;
       FeederObjects.Clear();
       IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
              REPEATED
              SELECT :NetworkFeederSource = COUNT(*)
              FROM   Udb_Grouping G,
                     TFMS_CardToObject CTO
              WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                     CTO.Object = G.Grouping AND
                     G.Member = :JIP.Equip AND
                    (G.Relationship = :Interaction$SourceBreaker OR
                     G.Relationship = :Interaction$SourcePosition);  

          IF NetworkFeederSource > 0 THEN  /* Indicates source equip */
             j = 1;
             SELECT :FeederObjects[j].Value = CTO.Object
             FROM   TFMS_CardToObject CTO,
                    Udb_ExtendedType ET
             WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                    CTO.Type = ET.Type AND
                    ET.SuperType = :Type$Feeder
             BEGIN
/*
** If this feeder segment is fed by another feeder then remove it
*/
                k = 0;
                SELECT :k = Grouping
                FROM   Udb_Grouping
                WHERE  Relationship = :Interaction$FedBy AND
                       Member = :FeederObjects[j].Value;
                IF k > 0 THEN
                   FeederObjects.RemoveRow (rownumber = j);
                ELSE  
                   k = j;     
                   j = j + 1;
/*
** If this feeder feeds another segment, then include that segment
*/
                   SELECT :FeederObjects[j].Value = Member
                   FROM   Udb_Grouping
                   WHERE  Relationship = :Interaction$FedBy AND
                          Grouping = :FeederObjects[k].Value
                   BEGIN
                      FedByExists = TRUE;
                      j = j + 1;
                   END;
                ENDIF;
             END; 

          ELSE     /* Indicates non-source equip, interruptor switch */
/*
** If equipment being opened is already on a portion card, 
** it is already isolated and we aren't
** isolating anything new requiring a Deload Complete check.
*/
             k = 0;
             REPEATED
             SELECT :k = AC.Card
             FROM   Udb_Grouping G,
                    TFMS_CardToObject CTO,
                    SOA_ActiveCard AC
             WHERE  G.Member = :JIP.Equip AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.Grouping = CTO.Object AND
                    CTO.Card = AC.Card AND
                    AC.TypeOfCard = :TypeOfCard$Portion;
/*
** Call trace to return feeder segments that will be isolated.  If none returned, then we aren't isolating
** and don't need to do deload complete check.
*/
             IF k = 0 THEN
                RetCode = CALLPROC DeloadTrace33kV (
                               StartEquip = :JIP.Equip,
                               FeederSegments = FeederObjects);
                IF RetCode = PU_CANCEL THEN
                   RETURN (PU_CANCEL);
                ENDIF;
             ENDIF;                  
          ENDIF;
/*
** If FeederObjects array is empty on a 33kV card, that means we are not isolating anything 
*/
          IF FeederObjects.LastRow() = 0 THEN
             CONTINUE;
          ENDIF;
      ENDIF;
/*
**  For each card, check for Deload moves complete and that no restore 
**  moves are complete.
**  33kV deload complete check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicFeederList = '';
         DynamicWhereClause = '';
         FOR k = 1 TO FeederObjects.LastRow() DO
            IF k = 1 THEN
               DynamicFeederList = ' (' + VARCHAR(FeederObjects[k].Value);
            ELSE
               DynamicFeederList = DynamicFeederList + ',' + VARCHAR(FeederObjects[k].Value);
            ENDIF;  
         ENDFOR;
         DynamicFeederList = DynamicFeederList + ') ';
       
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = k;
        SELECT :k = COUNT(*)
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause;

      ELSE     /*Normal IsolationComplete*/

        k = 0;
        REPEATED
        SELECT :k = COUNT(*)
        FROM SOA_Job J,
             SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
          (JC.StepPair = :StepHeading$Deload OR
           JC.StepPair = :StepHeading$Iso) AND
           JC.Job = J.Job AND
           J.JobClass <> 0 AND 
           J.TOComplete IS NULL AND
           J.Status = '' AND
           J.MoveType <> 'DLD' AND
           J.MoveType <> 'NONE';
       ENDIF;  
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
      IF FedByExists = TRUE THEN
         FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
      ELSE
         FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
      ENDIF;

        IF k > 0 THEN
            WarningStatus = CALLFRAME Warning
                        ( Card = CommonFeederCard[i].Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'Not all Isolation moves have been completed ' + FeederName + '.'
                        ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
        ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  have, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
**  33kV deload move check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               '(J.RSComplete IS NOT NULL AND J.RSComplete <> ' + '''' + '''' + ') AND ' + 
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'DLD' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

        k = 1;
        TempJobs.Clear();
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J, 
               SOA_JobControl JC,
               Udb_Grouping G,
               SOA_ActiveObject AO
        WHERE  :DynamicWhereClause
        BEGIN
           k = k + 1;
        END;

      ELSE  /*Normal IsolationComplete*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND 
              (JC.StepPair = :StepHeading$Deload OR
               JC.StepPair = :StepHeading$Iso) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
               J.Status = '' AND
               J.MoveType <> 'DLD' AND
               J.MoveType <> 'NONE'
        BEGIN
           k = k + 1;
        END;
      ENDIF;

        IF TempJobs.LastRow() > 0 THEN
         IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */

            DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               '(JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' OR ' +
               'JC.StepPair = ' + VARCHAR(StepHeading$Iso) + ') AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NOT NULL AND ' +
               'J.RSComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''';  

            k = 1;
            AllISOJobs.Clear();
            SELECT :AllISOJobs[k].Job = J.Job,
                   :AllISOJobs[k].JobClass = J.JobClass,
                   :AllISOJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_Grouping G,
                   SOA_ActiveObject AO
            WHERE  :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;

         ELSE  /*Normal IsolationComplete*/
           k = 1;
           REPEATED
           SELECT :AllISOJobs[k].Job = J.Job,
                  :AllISOJobs[k].JobClass = J.JobClass,
                  :AllISOJobs[k].Equip = Equip
           FROM   SOA_Job J,
                  SOA_JobControl JC
           WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                 (JC.StepPair = :StepHeading$Deload OR
                  JC.StepPair = :StepHeading$Iso) AND
                  JC.Job = J.Job AND
                  J.JobClass <> 0 AND 
                  J.TOComplete IS NOT NULL AND 
                  J.RSComplete IS NULL AND
                  J.Status = '' 
           BEGIN
             k = k + 1;
           END;
         ENDIF;

          k = 1;
          WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
             IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
                ALLISOJobs[k].Job <> TempJobs[1].Job AND
                ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
                TempJobs.RemoveRow (Rownumber = 1);
                k = 0; 
             ENDIF;
             k = k + 1;
          ENDWHILE;
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
              IF FedByExists = TRUE THEN
                 FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
              ELSE
                 FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
              ENDIF;

          IF TempJobs.LastRow() > 0 THEN
              WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'An Isolation move has been Restored ' + FeederName + '.  You must ' +
                           'confirm that the necessary Isolation moves ' +
                           'have been Taken Out.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
           ENDIF;
        ENDIF;
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
        IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$3G THEN
           k = 1;
           Open3GSwitch.Clear();
           REPEATED
           SELECT  :Open3GSwitch[k].Object = G.Member,
                   :Open3GSwitch[k].Name = O.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 1 AND
                   G.Member = O.Object
           BEGIN
              k = k + 1;
           END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
           REPEATED
           SELECT
           DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                   :Open3GSwitch[k].Name = O2.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O,
                   Udb_Terminal T1,
                   Udb_Switch S2,
                   Udb_Object O2,
                   Udb_Terminal T2
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 0 AND
                   G.Member = O.Object AND
                   G.Member = T1.Object AND
                   T1.Node = T2.Node AND
                   T2.Object = O2.Object AND
                   O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   O2.Object = S2.Object AND
                   S2.CurrentlyOpen = 1 AND
                   T1.Node > 20000 AND
                   T2.Node > 20000 AND
                   T1.Object <> T2.Object
           BEGIN
              k = k + 1;
           END;
/*
** Now look for Vis Break on Cam
*/           
           FOR k = 1 TO Open3GSwitch.LastRow() DO
              CamDiscFound = 0;
              REPEATED
              SELECT :CamDiscFound = OS.Object
              FROM  Udb_Grouping G,
                    FMS_ObjectStatus OS
              WHERE G.Grouping = :Open3GSwitch[k].Object AND
                    G.Relationship = :Interaction$VisibleBreakFor AND
                    G.Member = OS.Object AND
                    OS.Status = :Status$VisibleBreak AND
                    OS.StatusCount >= 1;

              IF CamDiscFound = 0 THEN

                 IF JIP.Status = Job$Restore THEN
                    Operator = JIP.RSOperator;
                 ELSE
                    Operator = JIP.TOOperator;
                 ENDIF;
  
                 REPEATED
                 SELECT
                 DISTINCT  :CamDiscFound = PS.Object
                 FROM      FMS_PendingStatus PS,
                           Udb_Grouping G 
                 WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                           G.Relationship = :Interaction$VisibleBreakFor AND
                           G.Member = PS.Object AND
                           PS.PendingStatus = :Status$VisibleBreak AND
                           PS.StatusCount > 0 AND
                           PS.IssuedOperator = :Operator;

                 IF CamDiscFound = 0 THEN
                   WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                           Open3GSwitch[k].Name + '.'
                   ); 
                   IF (WarningStatus = PU_CANCEL) THEN
                      RETURN(PU_CANCEL);
                   ELSE
                      RetCode = Warning$Overridden;
                   ENDIF;
                 ENDIF;
              ENDIF;
           ENDFOR;
        ENDIF;
    ENDFOR;
        
    RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckIsolationCompleteAllCardsBU



/*


BACKUP VERSION OF CheckIsolationCompleteAllCards WHILE TESTING
33kV VERSION during delivery on Sep 13, 2018


*/



/*
**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckIsolationCompleteAllCards
**
**  Date:           Version  Description
** --------------------------------------------------
**  05/26/04  ysp    Created from CheckIsolationComplete. Check all cards
**                   regardless of their card types. 
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/19/10  em     Extend for 3g to check for Cam-Disc visbile break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status when looking for VisBreak
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings.  
**  12/13/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  01/26/17  pkw    Fix problem with Red Warning not showing up when calling CheckIsoComplete. Also,
**                   change call from checkISOcomplete to call checkISOLATIONcomplete.  This change
**                   was made because when an openauto was created for a 13kv card no cutout move
**                   is issued (which uses SDClearCheck to warn if deload/iso not complete on 4kv).  
**                   Instead when apply protective grounds is issued, DO only gets warning for 
**                   isolation move not complete.  Mike Sannito said this should warning if deload or
**                   isolation are not complete so we changed this check to call itself instead of 
**                   checkisocomplete.
**  03/06/18  pkw    Ignore check if MTAOpen = TRUE
*/
PROCEDURE CheckIsolationCompleteAllCardsBU
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;

IF Card <> 0 THEN   
    /*
    **  If Card is passed in, this prompt is being called from 
    **  another ISO Precheck and we just want to run this check for
    **  that particular card.
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0     
    FROM    SOA_ActiveCard AC,
            FMS_Card C
    Where   AC.Card = :Card AND
            AC.Card = C.Card
    BEGIN
        i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ELSE
    /*
    **    Find all feeder cards which this piece of equipment is common too.
    **    If we couldn't find a feeder then nothing more to do. 
    */
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,  /*3G OK*/
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].StepDownJob = 0  
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
ENDIF;
/*
**  For each card, check any incomplete deload moves
*/
    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
       /*
       **  If card was passed in or StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;
          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Move issued from 4KV card and will do additional check on 
                **  13kv card which should use ISOLATION check so just add to the 
                **  current array. 4KV card is only connected to one 13KV card so
                **  we can just use link table to find any 13 KV cards.
                */
                k = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[k].Card = C.Card,
                   :CommonFeederCard[k].CardClass = C.CardClass,
                   :CommonFeederCard[k].FeederName = C.FeederName,
                   :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[k].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     SOA_ActiveCard AC,
                     FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                      L.Card = C.Card AND
                      L.Card = AC.Card
                BEGIN
                   k = k + 1;
                END;
             ELSE
                /*
                **  Move issued from 13KV card and will do additional check on 
                **  4kv card which should use ISO check so call checkisocomplete.
                **  13KV card may be linked to multiple 4KV step down cards so
                **  we need make sure each device is closed before checking for
                **  isolation on that card.
                */
                k = 1;
                StepDownCard.Clear();
                SELECT DISTINCT
                   :StepDownCard[k].Card = CTO.Card
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[i].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   k = k + 1;
                END;
                FOR k = 1 TO StepDownCard.LastRow DO
                   WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[k].Card);
                   IF WarningStatus = PU_CANCEL THEN
                       RETURN(PU_CANCEL);
                   ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                       RetCode = Warning$Overridden;
                   ENDIF;
                ENDFOR;
             ENDIF;
          ENDIF;
       ENDIF;  

        k = 0;
        REPEATED
        SELECT :k = COUNT(*)
        FROM SOA_Job J,
             SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
          (JC.StepPair = :StepHeading$Deload OR
           JC.StepPair = :StepHeading$Iso) AND
           JC.Job = J.Job AND
           J.JobClass <> 0 AND 
           J.TOComplete IS NULL AND
           J.Status = '' AND
           J.MoveType <> 'DLD' AND
           J.MoveType <> 'NONE';

        IF k > 0 THEN
            WarningStatus = CALLFRAME Warning
                        ( Card = CommonFeederCard[i].Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'Not all Isolation moves have been completed on feeder: ' +
                                  CommonFeederCard[i].FeederName + '.'
                        ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
        ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  has, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND 
              (JC.StepPair = :StepHeading$Deload OR
               JC.StepPair = :StepHeading$Iso) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
               J.Status = '' AND
               J.MoveType <> 'DLD' AND
               J.MoveType <> 'NONE'
        BEGIN
           k = k + 1;
        END;

        IF TempJobs.LastRow() > 0 THEN
           k = 1;
           REPEATED
           SELECT :AllISOJobs[k].Job = J.Job,
                  :AllISOJobs[k].JobClass = J.JobClass,
                  :AllISOJobs[k].Equip = Equip
           FROM   SOA_Job J,
                  SOA_JobControl JC
           WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                 (JC.StepPair = :StepHeading$Deload OR
                  JC.StepPair = :StepHeading$Iso) AND
                  JC.Job = J.Job AND
                  J.JobClass <> 0 AND 
                  J.TOComplete IS NOT NULL AND 
                  J.RSComplete IS NULL AND
                  J.Status = '' 
           BEGIN
             k = k + 1;
           END;

          k = 1;
          WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
             IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
                ALLISOJobs[k].Job <> TempJobs[1].Job AND
                ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
                TempJobs.RemoveRow (Rownumber = 1);
                k = 0; 
             ENDIF;
             k = k + 1;
          ENDWHILE;

          IF TempJobs.LastRow() > 0 THEN
              WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'A Isolation move has been Restored on feeder: ' + 
                           CommonFeederCard[i].FeederName + '.  You must ' +
                           'confirm that the necessary Isolation moves ' +
                           'have been Taken Out.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
           ENDIF;
        ENDIF;
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
        IF CommonFeederCard[i].NetworkFeeder = TRUE THEN
           k = 1;
           Open3GSwitch.Clear();
           REPEATED
           SELECT  :Open3GSwitch[k].Object = G.Member,
                   :Open3GSwitch[k].Name = O.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 1 AND
                   G.Member = O.Object
           BEGIN
              k = k + 1;
           END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
           REPEATED
           SELECT
           DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                   :Open3GSwitch[k].Name = O2.Name
           FROM    Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_Switch S,
                   Udb_Object O,
                   Udb_Terminal T1,
                   Udb_Switch S2,
                   Udb_Object O2,
                   Udb_Terminal T2
           WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 0 AND
                   G.Member = O.Object AND
                   G.Member = T1.Object AND
                   T1.Node = T2.Node AND
                   T2.Object = O2.Object AND
                   O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$3GSwitch) AND
                   O2.Object = S2.Object AND
                   S2.CurrentlyOpen = 1 AND
                   T1.Node > 20000 AND
                   T2.Node > 20000 AND
                   T1.Object <> T2.Object
           BEGIN
              k = k + 1;
           END;
/*
** Now look for Vis Break on Cam
*/           
           FOR k = 1 TO Open3GSwitch.LastRow() DO
              CamDiscFound = 0;
              REPEATED
              SELECT :CamDiscFound = OS.Object
              FROM  Udb_Grouping G,
                    FMS_ObjectStatus OS
              WHERE G.Grouping = :Open3GSwitch[k].Object AND
                    G.Relationship = :Interaction$VisibleBreakFor AND
                    G.Member = OS.Object AND
                    OS.Status = :Status$VisibleBreak AND
                    OS.StatusCount >= 1;

              IF CamDiscFound = 0 THEN

                 IF JIP.Status = Job$Restore THEN
                    Operator = JIP.RSOperator;
                 ELSE
                    Operator = JIP.TOOperator;
                 ENDIF;
  
                 REPEATED
                 SELECT
                 DISTINCT  :CamDiscFound = PS.Object
                 FROM      FMS_PendingStatus PS,
                           Udb_Grouping G 
                 WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                           G.Relationship = :Interaction$VisibleBreakFor AND
                           G.Member = PS.Object AND
                           PS.PendingStatus = :Status$VisibleBreak AND
                           PS.StatusCount > 0 AND
                           PS.IssuedOperator = :Operator;

                 IF CamDiscFound = 0 THEN
                   WarningStatus = CALLFRAME Warning
                   (Card = CommonFeederCard[i].Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                           Open3GSwitch[k].Name + '.'
                   ); 
                   IF (WarningStatus = PU_CANCEL) THEN
                      RETURN(PU_CANCEL);
                   ELSE
                      RetCode = Warning$Overridden;
                   ENDIF;
                 ENDIF;
              ENDIF;
           ENDFOR;
        ENDIF;
    ENDFOR;
        
    RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckIsolationCompleteBU

/*
06/23/21
BACK UP VERSION OF CHECKISOLATIONCOMPLETE BEFORE 33kV Fed By Logic is introduced.


**      Copyright c 2000 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckIsolationComplete
**
**  Date:           Version  Description
** --------------------------------------------------
**  04/24/00  pkw    Created from CheckDeloadComplete.  If a move has a movetype 
**                   of DLD or NONE, it will not cause a deload warning. All other 
**                   move types will.
**  11/19/02  ysp    Merge: removed passed-in C and Jobs
**  01/13/03  pkw    Fix joins between SOA_JobControl and SOA_Job.
**  02/06/03  pkw    Fix Reference to Job in last select.
**  02/28/03  pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                   that span divisions.
**  03/05/03  em     Corrected k index errors.
**  05/06/03  em     Add support for CIOA card type
**  02/03/05  pkw    Include filtered moves on check.
**  04/10/07  ysp    ITC203: Remove Move$Filtered as a job status.
**  11/16/10  em     Support for 3G
**  11/19/10  em     Extend for 3g to check for Cam-Disc visible break
**  03/28/11  em     For three-way 3G switch, use connectivity to look through closed SF6 for open 3G
**                   and visible break
**  03/31/11  em     When looking at Cam-Disc for VisBreak, it does not have to be on current card.
**  05/17/11  em     Include Pending Status table for VisBreak check.
**  11/29/12  pkw    Look for links to 4kv cards with closed SD-VIS switches.  Also change select
**                   to look at both StepHeading$ISO and StepHeading$Deload.  13kv cards don't have
**                   a isolation step so it doesn't hurt.  On 4kv, ISOlation is checked by looking at
**                   both stepheadings. 
**  12/12/12  pkw    Added Stepheading$ISO to another select and modify select to get 4kv
**                   cards so that only get cards with closed device. 
**  02/13/13  pkw    Change variable to i on first select.
**  01/26/17  pkw    Fix problem with Red Warning not showing up when calling CheckIsoComplete. Also,
**                   change call from checkISOcomplete to call checkISOLATIONcomplete.  This change
**                   was made because when an openauto was created for a 13kv card no cutout move
**                   is issued (which uses SDClearCheck to warn if deload/iso not complete on 4kv).  
**                   Instead when apply protective grounds is issued, DO only gets warning for 
**                   isolation move not complete.  Mike Sannito said this should warning if deload or
**                   isolation are not complete so we changed this check to call itself instead of 
**                   checkisocomplete.
**  07/27/17  em     Before presenting warning, check if Job Equipment is part of an ATS and the ATS
**                   Grouper has an outstanding isolation move that has been issued.  Don't count it if it
**                   ahs been issued.
**  03/06/18  pkw    Ignore check if MTAOpen = TRUE
**  02/01/19  pkw    If MicroGridOpen = TRUE and equip is downstreamfrom MicroGrid Line switch don't 
**                   display warning.
*/
PROCEDURE CHECKISOLATIONCOMPLETEBU 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    Card = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;              /* index */ 
    m = INTEGER NOT NULL;              /* index */ 
    CommonFeederCard = ARRAY OF FMS_Card;
    AllISOJobs = ARRAY of JobInProgress; 
    Open3GSwitch = ARRAY OF ObjectSummaryClass;
    CamDiscFound = INTEGER NOT NULL WITH DEFAULT;
    Operator = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    StepDownCard = ARRAY OF FMS_Card;
)= 
BEGIN 
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  If MicroGridOpen = TRUE and equip is downstreamfrom MicroGrid Line switch don't 
**  display warning.
*/
   IF MicroGridOpen = TRUE THEN
      i = FALSE;
      SELECT :i = :TRUE 
      FROM   Udb_Grouping G,
             Udb_Grouping G2,
             Udb_ExtendedType ET
      WHERE  G.Member = :JIP.Equip AND
             G.Relationship = :Interaction$DownstreamFrom AND
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MicroGridFor AND
             G2.GroupingType = ET.Type AND
             ET.SuperType = :Type$Feeder;
      IF i = TRUE THEN
         RETURN(PU_OK);
      ENDIF;
   ENDIF;

   IF Card <> 0 THEN   
       /*
       **  If Card is passed in, this prompt is being called from 
       **  another ISO Precheck and we just want to run this check for
       **  that particular card.
       */
       i = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[i].Card = C.Card,
              :CommonFeederCard[i].CardClass = C.CardClass,
              :CommonFeederCard[i].FeederName = C.FeederName,
              :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
              :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
              :CommonFeederCard[i].StepDownJob = 0     
       FROM    SOA_ActiveCard AC,
               FMS_Card C
       Where   AC.Card = :Card AND
               AC.Card = C.Card
       BEGIN
           i = i + 1;
       END;

       IF i = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ELSE
       /*
       **    Find all feeder cards which this job is common to.
       **    If we couldn't find a feeder then nothing more to do. 
       */
       i = 1;
       REPEATED
       SELECT DISTINCT
              :CommonFeederCard[i].Card = C.Card,
              :CommonFeederCard[i].CardClass = C.CardClass,
              :CommonFeederCard[i].FeederName = C.FeederName,
              :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
              :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
              :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
              :CommonFeederCard[i].StepDownJob = 0  
       FROM    SOA_JobControl JC,
               SOA_ActiveCard AC,
               FMS_Card C
       WHERE   JC.Job = :JIP.Job AND
               JC.Card = C.Card AND
               JC.Card = AC.Card
       BEGIN
          i = i + 1;
       END;

       IF i = 1 THEN
          RETURN(NULL); 
       ENDIF;
   ENDIF;
/*
**  Do check unless (Open Auto OR OOE1 card type) AND equip is the 
**  source breaker or source position.
*/
   RetCode = NULL;
   
   FOR i = 1 TO CommonFeederCard.LastRow() DO
      /*
      **  If card was passed in or StepDownJob is set, no need to 
      **  check for Step Down because check has already been performed.
      */
      IF Card = 0 AND CommonFeederCard[i].StepDownJob = 0 THEN
         /*
         **  Check to see if current feeder has an SD-VIS equipment type
         **  that is closed.  If yes, then look for other linked cards
         **  and confirm Isolation is complete for all cards.
         */
         SDCloseCheck = 0;
         SELECT :SDCloseCheck = COUNT(*)
         FROM    Udb_Switch S,
                 Udb_Grouping G,
                 TFMS_CardToObject CTO
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$SDVIS AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0;
                 
         IF SDCloseCheck <> 0 THEN
            /*
            **  Found a closed SD-VIS device on Feeder.  Now look to see
            **  if there is a link established.
            */
            IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
               /*
               **  Move issued from 4KV card and will do additional check on 
               **  13kv card which should use ISOLATION check so just add to the 
               **  current array.  4KV card is only connected to one 13KV card so
               **  we can just use link table to find any 13 KV cards.
               */
               k = CommonFeederCard.LastRow + 1;
               SELECT DISTINCT
                  :CommonFeederCard[k].Card = C.Card,
                  :CommonFeederCard[k].CardClass = C.CardClass,
                  :CommonFeederCard[k].FeederName = C.FeederName,
                  :CommonFeederCard[k].Feeder = C.Feeder,   /*3G OK*/
                  :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
                  :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,
                  :CommonFeederCard[k].StepDownJob = 1    
               FROM FMS_StepDownLink L,
                    SOA_ActiveCard AC,
                    FMS_Card C
               WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                     L.Card = C.Card AND
                     L.Card = AC.Card
               BEGIN
                  k = k + 1;
               END;
            ELSE
               /*
               **  Move issued from 13KV card and will do additional check on 
               **  4kv card which should use ISO check so call checkisocomplete.
               **  13KV card may be linked to multiple 4KV step down cards so
               **  we need make sure each device is closed before checking for
               **  isolation on that card.
               */
               k = 1;
               StepDownCard.Clear();
               SELECT DISTINCT
                  :StepDownCard[k].Card = CTO.Card
               FROM FMS_StepDownLink L,
                    Udb_Switch S,
                    Udb_Grouping G,
                    TFMS_CardToObject CTO
               WHERE L.Card = :CommonFeederCard[i].Card AND
                     L.StepDownCard = CTO.Card AND
                     CTO.Object = G.Grouping AND
                     G.GroupingType = :Type$Feeder AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.MemberType = :Type$SDVIS AND
                     G.Member = S.Object AND
                     S.CurrentlyOpen = 0
               BEGIN
                  k = k + 1;
               END;
               FOR k = 1 TO StepDownCard.LastRow DO
                  WarningStatus = CALLPROC CheckIsolationComplete(Card = :StepDownCard[k].Card);
                  IF (WarningStatus = PU_CANCEL) THEN
                      RETURN(PU_CANCEL);
                  ELSEIF WarningStatus IS NOT NULL THEN  /* if null just ignore */
                      RetCode = Warning$Overridden;
                  ENDIF;
               ENDFOR;
            ENDIF;
         ENDIF;
      ENDIF;  
/*
** Additional isolation for 3G cards to make sure CamDisc has visible break for open 3G switches on card.
*/
      IF CommonFeederCard[i].NetworkFeeder = TRUE THEN
         k = 1;
         Open3GSwitch.Clear();
         REPEATED
         SELECT  :Open3GSwitch[k].Object = G.Member,
                 :Open3GSwitch[k].Name = O.Name
         FROM    Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 Udb_Switch S,
                 Udb_Object O
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 1 AND
                 G.Member = O.Object
         BEGIN
            k = k + 1;
         END;
/*
** For closed 3GSwitch, look for open next door neighbor
*/
         REPEATED
         SELECT
         DISTINCT  :Open3GSwitch[k].Object = O2.Object,
                   :Open3GSwitch[k].Name = O2.Name
         FROM    Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 Udb_Switch S,
                 Udb_Object O,
                 Udb_Terminal T1,
                 Udb_Switch S2,
                 Udb_Object O2,
                 Udb_Terminal T2
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0 AND
                 G.Member = O.Object AND
                 G.Member = T1.Object AND
                 T1.Node = T2.Node AND
                 T2.Object = O2.Object AND
                 O2.Type IN (SELECT Type FROM Udb_ExtendedType
                                  WHERE  SuperType = :Type$3GSwitch) AND
                 O2.Object = S2.Object AND
                 S2.CurrentlyOpen = 1 AND
                 T1.Node > 20000 AND
                 T2.Node > 20000 AND
                 T1.Object <> T2.Object
         BEGIN
            k = k + 1;
         END;
/*
** Now look for Vis Break on Cam
*/            
         FOR k = 1 TO Open3GSwitch.LastRow() DO
            CamDiscFound = 0;
            REPEATED
            SELECT :CamDiscFound = OS.Object
            FROM  Udb_Grouping G,
                  FMS_ObjectStatus OS
            WHERE G.Grouping = :Open3GSwitch[k].Object AND
                  G.Relationship = :Interaction$VisibleBreakFor AND
                  G.Member = OS.Object AND
                  OS.Status = :Status$VisibleBreak AND
                  OS.StatusCount >= 1;

            IF CamDiscFound = 0 THEN

               IF JIP.Status = Job$Restore THEN
                  Operator = JIP.RSOperator;
               ELSE
                  Operator = JIP.TOOperator;
               ENDIF;
  
               REPEATED
               SELECT
               DISTINCT  :CamDiscFound = PS.Object
               FROM      FMS_PendingStatus PS,
                         Udb_Grouping G 
               WHERE     G.Grouping = :Open3GSwitch[k].Object AND
                         G.Relationship = :Interaction$VisibleBreakFor AND
                         G.Member = PS.Object AND
                         PS.PendingStatus = :Status$VisibleBreak AND
                         PS.StatusCount > 0 AND
                         PS.IssuedOperator = :Operator;

               IF CamDiscFound = 0 THEN
  
                 WarningStatus = CALLFRAME Warning
                 (Card = JIP.Card, 
                  Job = JIP.Job, 
                  SwitchingItem = JIP.SwitchingItem,
                  Text = 'No Visible Break found for the Cam-Disc associated to open 3G Switch ' + 
                         Open3GSwitch[k].Name + '.'
                 ); 
                IF (WarningStatus = PU_CANCEL) THEN
                   RETURN(PU_CANCEL);
                ELSE
                   RetCode = Warning$Overridden;
                ENDIF;
              ENDIF;
            ENDIF;
         ENDFOR;
      ENDIF;

      IF CommonFeederCard[i].CardClass = Type$OOE1 OR 
         CommonFeederCard[i].CardClass = Type$Auto OR 
         CommonFeederCard[i].CardClass = Type$CIOA THEN 

         k = 0;
         REPEATED 
         SELECT :k = COUNT(*)
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Member = :JIP.Equip AND
               (G.Relationship = :Interaction$SourceBreaker OR
                G.Relationship = :Interaction$SourcePosition);

         IF k > 0 THEN
            CONTINUE;
         ENDIF;
      ENDIF;

      k = 0;
      REPEATED
      SELECT :k = COUNT(*)
      FROM SOA_Job J,
           SOA_JobControl JC
      WHERE  JC.Card = :CommonFeederCard[i].Card AND
        (JC.StepPair = :StepHeading$Deload OR
         JC.StepPair = :StepHeading$Iso) AND
         JC.Job = J.Job AND
         J.JobClass <> 0 AND 
         J.TOComplete IS NULL AND
         J.Status = '' AND
         J.MoveType <> 'DLD' AND
         J.MoveType <> 'NONE';

      IF k > 0 THEN
/*
** Don't count issued moves on an associated ATS Grouper
** Looking to ignore Place in Manual move that is issued in the same set of moves.
*/ 
         REPEATED 
         SELECT :m = COUNT(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                Udb_Grouping G,
                Udb_ExtendedType ET
         WHERE  G.Member = :JIP.Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = ET.Type AND
                ET.SuperType = :Type$ATSGrouper AND
                G.Grouping = J.Equip AND 
         JC.Card = :CommonFeederCard[i].Card AND
        (JC.StepPair = :StepHeading$Deload OR
         JC.StepPair = :StepHeading$Iso) AND
         JC.Job = J.Job AND
         J.JobClass <> 0 AND 
         J.TOIssued IS NOT NULL AND
         J.TOComplete IS NULL AND
         J.Status = '' AND
         J.MoveType <> 'DLD' AND
         J.MoveType <> 'NONE';

         IF k - m > 0 THEN 
             WarningStatus = CALLFRAME Warning
                      ( Card = CommonFeederCard[i].Card, 
                        Job = JIP.Job,
                        SwitchingItem = JIP.SwitchingItem, 
                        Text = 'Not all Isolation moves have been completed on card: ' +
                                CommonFeederCard[i].FeederName + '.'
                      ); 
             IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
             ELSE
                RetCode = Warning$Overridden;
             ENDIF;
          ENDIF;
      ENDIF;
/*
**  See if there are any moves that have been restored.  If there
**  has, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
*/
      k = 1;
      TempJobs.Clear();
      REPEATED
      SELECT :TempJobs[k].Job = J.Job,
             :TempJobs[k].JobClass = J.JobClass,
             :TempJobs[k].Equip = J.Equip
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :CommonFeederCard[i].Card AND 
            (JC.StepPair = :StepHeading$Deload OR
             JC.StepPair = :StepHeading$Iso) AND
             JC.Job = J.Job AND
             J.JobClass <> 0 AND 
             (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
             J.Status = '' AND
             J.MoveType <> 'DLD' AND
             J.MoveType <> 'NONE'
      BEGIN
         k = k + 1;
      END;

      IF TempJobs.LastRow() > 0 THEN
         k = 1;
         REPEATED
         SELECT :AllISOJobs[k].Job = J.Job,
                :AllISOJobs[k].JobClass = J.JobClass,
                :AllISOJobs[k].Equip = Equip
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND 
               (JC.StepPair = :StepHeading$Deload OR
                JC.StepPair = :StepHeading$Iso) AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
                J.TOComplete IS NOT NULL AND 
                J.RSComplete IS NULL AND
                J.Status = ''
         BEGIN
           k = k + 1;
         END;

        k = 1;
        WHILE k <= ALLISOJobs.LastRow() AND TempJobs.LastRow() > 0 DO
           IF ALLISOJobs[k].JobClass = TempJobs[1].JobClass AND
              ALLISOJobs[k].Job <> TempJobs[1].Job AND
              ALLISOJobs[k].Equip = TempJobs[1].Equip THEN
 
              TempJobs.RemoveRow (Rownumber = 1);
              k = 0; 
           ENDIF;
           k = k + 1;
        ENDWHILE;

        IF TempJobs.LastRow() > 0 THEN
            WarningStatus = CALLFRAME Warning
                 (Card = CommonFeederCard[i].Card, 
                  Job = JIP.Job, 
                  SwitchingItem = JIP.SwitchingItem,
                  Text = 'A Isolation move has been Restored on card: ' + 
                         CommonFeederCard[i].FeederName + '.  You must ' +
                         'confirm that the necessary Isolation moves ' +
                         'have been Taken Out.'
                 ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;

   ENDFOR;
        
   RETURN(RetCode); 
END; 

Application Component Report
============================

	Name:            CheckISONETAssocFdr

/*
** Copyright c 1997 ESCA Corporation. All Rights Reserved.
** 
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          CheckISONETAssocFdr
**
**  Modifications:
**  10/15/97  jfl   Created 
**  11/19/02  ysp   Merge: removed passed-in C and Jobs
**  03/30/11  em    Establish CardDetails if necessary before call to LoadAssociatedFeeders
**  08/24/16 ysp    Add FedBy variable used in ConfirmCardDetails
*/
PROCEDURE  CheckISONETAssocFdr
(
    JIP = JobInProgress;				/* Job being processed */
    ISOEquip = GrouperInfo;
    RED_ISO  = ARRAY OF GrouperInfo;
    RED_HTV  = ARRAY OF GrouperInfo;
    RED_Loop = ARRAY OF GrouperInfo;
    RED_ATS  = ARRAY OF GrouperInfo;
    REDString = VARCHAR(400) NOT NULL;
    ISO_Color= Integer NOT NULL;
    HTV_Color= Integer NOT NULL;
    Loop_Color= Integer NOT NULL;
    ATS_Color  = Integer NOT NULL;
    AssFeeders = Array of IntegerObject;
    PreCheck = INTEGER NOT NULL;
    i = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    OverRide = INTEGER NOT NULL;
    FedBy = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    OverRide = FALSE; 
    WarningStatus = PU_OK;
    IF JIP.Equip <> 0 THEN
        /*
        ** identify ISONET
        */
        ISOEquip.GrouperId = 0;
        REPEATED
        SELECT 
            :ISOEquip.GrouperId = O.Object,
            :ISOEquip.GrouperName = O.Name
        FROM Udb_Grouping G,
             Udb_Object O
        WHERE G.Member = :JIP.Equip
          AND G.RelationShip = :Interaction$MemberOf
          AND G.GroupingType = :Type$ISOGrouper
          AND O.Object = G.Grouping;
        CALLPROC DDB_ROLLBACK;
/*
** Determine the current button colors
** and the projected button colors if
** cutout move is performed
*/
        IF (ISOEquip.GrouperId <> 0 ) THEN

#   INCLUDE ConfirmCardDetails

            CALLPROC LoadAssociatedFeeders( AssFeeders = byref(AssFeeders),
                                    HTV_Color  = Byref(HTV_Color),
                                    ISO_Color  = Byref(ISO_Color),
                                    Loop_Color = Byref(Loop_Color),
                                    ATS_Color  = Byref(ATS_Color),

                                    RED_HTV    = Byref(RED_HTV),
                                    RED_ISO    = Byref(RED_ISO),
                                    RED_Loop   = Byref(RED_Loop),
                                    RED_ATS    = Byref(RED_ATS),
                                    PreCheck   = TRUE
                                    );
/*
** If the projection is to get a RED condition for the ISONET grouper this
** switch belongs, we must issue a Warning
*/
            i = 1;
            WHILE i <= RED_ISO.LastRow() DO
                IF RED_ISO[i].GrouperId = ISOEquip.GrouperId THEN
                    WarningStatus = CALLFRAME Warning 
                                        (Card = JIP.Card, 
                                         Job = JIP.Job,
                                         SwitchingItem = JIP.SwitchingItem,
                                         Text = ' Open HTV switch will cause loss of customers ' + 
                                                ' fed from ISONET: ' + ISOEquip.GrouperName);
                    IF WarningStatus = PU_CANCEL THEN
                        RETURN(PU_CANCEL);
                    ELSE
                        OverRide = TRUE;
                    ENDIF;
                ENDIF;
                i = i + 1;
            ENDWHILE;
        ENDIF;
    ENDIF;
/*
**  Check to see if they overrode a warning 
*/
    IF OverRide = FALSE THEN
       RETURN(NULL); 
    ELSE
       RETURN(Warning$Overridden);
    ENDIF;
END;

Application Component Report
============================

	Name:            CheckIsoRestore

/*
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckIsoRestore
**
**  Date:     Version  Description
** --------------------------------------------------
**  08/16/95    pw    Created to check iso complete on 4kv Cards
**  11/18/02    ysp   Merge: removed C and Jobs as passed-ins.
**  01/30/03    ysp   added switchingitem to the warning frame
**  02/28/03    pkw   Use DISTINCT against SOA_ActiveCard for feeder
**                    that span divisions.
**  03/21/03    em    Fixed i=0 to i=1 error
**  12/14/12    pkw   Look for links to 4kv cards with closed SD-VIS switches. 
**  08/10/16    ysp   For 33kv portion card, prepend main feeder name to the portion name in messages 
*/
PROCEDURE CheckIsoRestore 
(
    JIP = JobInProgress;			  /* parameter - Job being processed */
)= 
DECLARE
    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_CARD; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
    SDCloseCheck = INTEGER NOT NULL WITH DEFAULT;
    TempJobs = ARRAY of JobInProgress; 
ENDDECLARE
BEGIN 
    /*
    **    Find all feeders which this piece of equipment is common too.
    **    If we couldn't find a feeder then nothing more to do
    */
    k = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[k].Card = C.Card,
           :CommonFeederCard[k].Feeder = C.Feeder,
           :CommonFeederCard[k].FeederName = C.FeederName,
           :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[k].TypeOfCard = C.TypeOfCard,   
           :CommonFeederCard[k].StepDownJob = 0   
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    Where   JC.Job = :JIP.Job AND
            JC.Card = AC.Card AND
            JC.Card = C.Card
    BEGIN
        k = k + 1;
    END;

    IF k = 1 THEN
       RETURN(NULL); 
    ENDIF;
/*
**    check to see if all iso moves have been completed.  If there are still outstanding
**    iso moves give them warning.
*/
    RetCode = NULL;

    FOR k = 1 TO CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[k].GetGeneralCardName();
    
       /*
       **  If StepDownJob is set, no need to 
       **  check for Step Down because check has already been performed.
       */
       IF CommonFeederCard[k].StepDownJob = 0 THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          SDCloseCheck = 0;
          SELECT :SDCloseCheck = COUNT(*)
          FROM    Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :CommonFeederCard[k].Card AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0;
          IF SDCloseCheck <> 0 THEN
             /*
             **  Found a closed SD-VIS device on Feeder.  Now look to see
             **  if there is a link established.
             */
             IF CommonFeederCard[k].TypeOfCard <> TypeOfCard$4KV THEN
                /*
                **  Don't need to do anything if move was issued from 4kV card
                **  because 13kV cards don't have Isolation steps Heading.  
                **  
                **  If move issued from 13KV card will do additional check on 
                **  4kv card which should use ISO Restore check so just add to the 
                **  current array.
                */
                i = CommonFeederCard.LastRow + 1;
                SELECT DISTINCT
                   :CommonFeederCard[i].Card = C.Card,
                   :CommonFeederCard[i].Feeder = C.Feeder,   /*3G OK*/
                   :CommonFeederCard[i].FeederName = C.FeederName,
                   :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
                   :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
                   :CommonFeederCard[i].StepDownJob = 1    
                FROM FMS_StepDownLink L,
                     Udb_Switch S,
                     Udb_Grouping G,
                     TFMS_CardToObject CTO
                WHERE L.Card = :CommonFeederCard[k].Card AND
                      L.StepDownCard = CTO.Card AND
                      CTO.Object = G.Grouping AND
                      G.GroupingType = :Type$Feeder AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.MemberType = :Type$SDVIS AND
                      G.Member = S.Object AND
                      S.CurrentlyOpen = 0
                BEGIN
                   i = i + 1;
                END;
             ENDIF;
          ENDIF;
       ENDIF;  

        i = 1;
        TempJobs.Clear();

        REPEATED
        SELECT :TempJobs[i].PrintId = JC.PrintId,
               :TempJobs[i].EquipName = J.EquipName,
               :TempJobs[i].EquipClassName = J.EquipClassName,
               :TempJobs[i].ToMove = J.ToMove,
               :TempJobs[i].Job = J.Job
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[k].Card AND
               JC.StepPair = :StepHeading$Iso AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               J.RSComplete IS NULL AND
               J.Status = ''
        BEGIN
           i = i + 1;
        END;
/*
**    If we get down here,  check did not pass.  If NoWarning = TRUE then
**    just return pu_cancel w/out giving warning.
*/
       IF TempJobs.LastRow() > 0 THEN
          WarningStatus = CALLFRAME Warning
                    ( Card = CommonFeederCard[k].Card, 
                      Job = JIP.Job, 
                      Jobs = TempJobs,
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Not all Isolation moves have been completed ' +
                             'on feeder: ' + FeederName + '. ' +
                             'Please confirm each move if you wish to continue.'
                    ); 
          IF (WarningStatus = PU_CANCEL) THEN
              RETURN(PU_CANCEL);
          ELSE
            RetCode = Warning$Overridden;
          ENDIF;
       ENDIF;
    ENDFOR;

    RETURN (RetCode);
END;

Application Component Report
============================

	Name:            CheckKSOpenAndGround

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckKSOpenAndGround  
**
**  Modifications:
**  06/11/93 em	    Created 
**  11/19/02 ysp    Merge: removed passed-in C and Jobs
**  09/01/06 em     Adding check for Pending Status
*/
PROCEDURE  CheckKSOpenAndGround 
(
    JIP = JobInProgress;				/* Job being processed */

    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    Operator = INTEGER;          /* Operator to use for pending check*/
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    KSF = ARRAY OF ObjectSummaryClass;  
    CommonSourceBreaker = ObjectSummaryClass;
    KSB = ObjectSummaryClass;
    RowsFound = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Using connectivity in Database, make sure the Knife Switch Feeder-Side
**  is open and grounded and the Knife Switch Bus-Side is open.
**  First get Common Source.  Intended to be used by Install Barrier which 
**  must be performed on a KSF (the equipment object id being passed to
**  this procedure).
**  Find common source breaker.
*/ 
  CommonSourceBreaker.Object = 0;       
  SELECT :CommonSourceBreaker.Object = O.Object,
         :CommonSourceBreaker.Name = O.Name
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O 
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 1 AND      /* Terminal 1 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND      /* Terminal 2 */
         T2.Object = O.Object;

  IF CommonSourceBreaker.Object = 0 THEN 
    WarningStatus = CALLFRAME Warning (
                       Card = JIP.Card, 
                       Job = JIP.Job,
                       SwitchingItem = JIP.SwitchingItem,
                       Text = 'Connectivity Problem. Unable to find common source ' +
                              'breaker.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
  ENDIF;
/*
** Determine Operator for Pending
*/
  IF JIP.Status = Job$Restore THEN
     Operator = JIP.RSOperator;
  ELSE
     Operator = JIP.TOOperator;
  ENDIF;
/*
**  Find Knife Switches on Feeder Side (will also find the one we started
**  with - no biggy
*/
  i = 1;
  SELECT :KSF[i].Object = O.Object,
         :KSF[i].Name = O.Name
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O 
  WHERE  T1.Object = :CommonSourceBreaker.Object AND
         T1.Terminal = 2 AND      /* Terminal 2 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 1 AND      /* Terminal 1 */
         T2.Object = O.Object
  BEGIN
     i = i + 1;
  END;

  WarningStatus = PU_OK;
  
  IF i < 3 THEN
    
    WarningStatus = CALLFRAME Warning 
                       (Card = JIP.Card, 
                        Job = JIP.Job,
                        SwitchingItem = JIP.SwitchingItem,
                        Text = 'Connectivity Problem. Not enough Knife Switches ' +
                               'connected to common source breaker.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
 
  ELSE

    i = 1;
    WHILE i <= KSF.LastRow() DO
/*
**  Need to find two statuses, ground and open, for things to be okay.
*/
        RowsFound = 0;
        SELECT  :RowsFound = COUNT(*)
        FROM    FMS_ObjectStatus
        WHERE   Object = :KSF[i].Object AND
                StatusCount > 0 AND
                Status = :Status$Open;
/* 
**  Look for Open or Pending Open First.
*/
        IF RowsFound = 0 THEN 

           SELECT  :RowsFound = COUNT(*)
           FROM    FMS_PendingStatus
           WHERE   Object = :KSF[i].Object AND
                   IssuedOperator = :Operator AND
                   StatusCount > 0 AND
                   PendingStatus = :Status$Open;
        ENDIF;

        IF RowsFound > 0 THEN /* Open Status Found, check for Ground */

           RowsFound = 0;
           SELECT  :RowsFound = COUNT(*)
           FROM    FMS_ObjectStatus
           WHERE   Object = :KSF[i].Object AND
                   StatusCount > 0 AND
                   Status = :Status$Ground;

           IF RowsFound = 0 THEN 
   
              SELECT  :RowsFound = COUNT(*)
              FROM    FMS_PendingStatus
              WHERE   Object = :KSF[i].Object AND
                      IssuedOperator = :Operator AND
                      StatusCount > 0 AND
                      PendingStatus = :Status$Ground;
           ENDIF;
        ENDIF;
/*
**  If RowsFound = 0, either did not find Ground or Open Status.
*/
        IF RowsFound = 0 THEN 

           WarningStatus = CALLFRAME Warning 
                               (Card = JIP.Card, 
                                Job = JIP.Job,
                                SwitchingItem = JIP.SwitchingItem,
                                Text = 'Cannot confirm that KnifeSwitch ' + 
                                        varchar(:KSF[i].Name) + ' is open AND grounded.');

           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;

        ENDIF;
        i = i + 1;

    ENDWHILE;

  ENDIF;
/*
**  Find Knife Switch on Bus Side 
*/
  KSB.Object = 0;
  SELECT :KSB.Object = O.Object,
         :KSB.Name = O.Name
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O 
  WHERE  T1.Object = :CommonSourceBreaker.Object AND
         T1.Terminal = 1 AND      /* Terminal 1 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND      /* Terminal 2 */
         T2.Object = O.Object;

  IF KSB.Object = 0 THEN 
    WarningStatus = CALLFRAME Warning 
                               (Card = JIP.Card, 
                                Job = JIP.Job,
                                SwitchingItem = JIP.SwitchingItem,
                                Text = 'Connectivity Problem. Unable to find the Knife Switch ' +
                                       'on the Bus side.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
  ENDIF;

  RowsFound = 0;
  SELECT  :RowsFound = COUNT(*)
  FROM    FMS_ObjectStatus
  WHERE   Object = :KSB.Object AND
          StatusCount > 0 AND
          Status =  :Status$Open;

  IF RowsFound = 0 THEN 
/*
**  Check for pending also.
*/
     SELECT  :RowsFound = COUNT(*)
     FROM    FMS_PendingStatus
     WHERE   Object = :KSB.Object AND
             IssuedOperator = :Operator AND 
     	     StatusCount > 0 AND
             PendingStatus =  :Status$Open;
  ENDIF;

  IF RowsFound = 0 THEN 

           WarningStatus = CALLFRAME Warning
                               (Card = JIP.Card, 
                                Job = JIP.Job,
                                SwitchingItem = JIP.SwitchingItem,
                                Text = 'Cannot confirm that KnifeSwitch Bus Side' + 
                                       varchar(:KSF[i].Name) + ' is open.');

           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;
  ENDIF;

  RETURN(NULL); 

END;

Application Component Report
============================

	Name:            CheckLastBreakerToOpen

/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckLastBreakerToOpen
**
**  Modifications:
**  07/11/06 ysp    Created. If the Open Breaker move is being issued from an SLC
**                  switching item, check whether the breaker is on a line. If so,
**                  and all the other breakers are open or pending open, present a
**                  warning. 
**  09/01/06 em     PendingStatusCount must be > 0
**  09/27/06 ysp    Finalize this check. Apply this check only to equipment under Bkr super type
**  10/30/06 ysp    If all breakers are currently open, no need to check their pending status.
*/

PROCEDURE CheckLastBreakerToOpen
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    x1 = INTEGER NOT NULL WITH DEFAULT;
    x2 = INTEGER NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    BreakerType = INTEGER NOT NULL;
    MacroSubstation = INTEGER NOT NULL;
    Line = INTEGER NOT NULL;
    BreakerArray = ARRAY OF INTEGEROBJECT;
    BreakerList = VARCHAR(1500) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
) =
BEGIN
   RetCode = NULL;
   IF CurrentApplication <> Application$SLC THEN
      RETURN (RetCode);
   ENDIF;

/* 
** If this breaker is on the line
*/
   BreakerType = Type$Bkr;

   i = 0;
   SELECT :i = 1
   FROM   Udb_ExtendedType ET
   WHERE  ET.SuperType = :BreakerType AND
          ET.Type = :JIP.EquipClass;

   IF i = 0 THEN
      RETURN (RetCode);
   ENDIF;

   Line = 0;
   SELECT :Line = G.Grouping
   FROM   Udb_Grouping G          
   WHERE  G.GroupingType = :Type$Line AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = :JIP.Equip;           

   IF Line = 0 THEN
      RETURN (RetCode);
   ENDIF;
/*
** determine if there is a macro substation
*/
   MacroSubstation = 0;

   REPEATED
   SELECT :MacroSubstation = G.Grouping
   FROM   Udb_Grouping G
   WHERE  G.Member = :JIP.Substation AND
          G.MemberType = :Type$Substation AND
          G.GroupingType = :Type$MacroSubstation AND
          G.Relationship = :Interaction$MemberOf;
/*
** get a list of breakers in the same substation (including other substations in the macro)
** and on the same transmission line.
*/

   BreakerArray.Clear(); 
   i = 1;   

   IF MacroSubstation = 0 THEN

      REPEATED
      SELECT :BreakerArray[i].Value = G1.Member
      FROM   Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_ExtendedType ET
       WHERE G1.Grouping = :JIP.Substation AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.MemberType = ET.Type AND
             ET.SuperType = :BreakerType AND
             G1.Member <> :JIP.Equip AND
             G1.Member = G2.Member AND
             G2.Grouping = :Line AND
             G2.Relationship = :Interaction$MemberOf
      BEGIN
         i = i + 1;
      END;

   ELSE

      REPEATED
      SELECT :BreakerArray[i].Value = G1.Member
      FROM   Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Grouping G3,
             Udb_ExtendedType ET
      WHERE  G3.Grouping = :MacroSubstation AND
             G3.Relationship = :Interaction$MemberOf AND
             G3.MemberType = :Type$Substation AND
             G3.Member = G1.Grouping AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.MemberType = ET.Type AND
             ET.SuperType = :BreakerType AND
             G1.Member <> :JIP.Equip AND
             G1.Member = G2.Member AND
             G2.Grouping = :Line AND
             G2.Relationship = :Interaction$MemberOf 
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
  
/*
** Determine if all other breakers are open or pending open
*/
   x2 = BreakerArray.LastRow;
   IF BreakerArray.LastRow > 0 THEN
      /* Currently open status */
      BreakerList = '';
      FOR i = 1 TO BreakerArray.LastRow() DO
         IF BreakerList <> '' THEN
            BreakerList = BreakerList + ',';
         ENDIF;

         BreakerList = BreakerList + VARCHAR(BreakerArray[i].Value); 
      ENDFOR;

      DynamicWhereClause = ' Object IN (' + BreakerList + ') AND ' + 
                             ' CurrentlyOpen = 1';
      x1 = 0;
      SELECT :x1 = Object
      FROM   Udb_Switch
      WHERE  :DynamicWhereClause
      BEGIN
         FOR i = 1 TO BreakerArray.LastRow() DO
             IF x1 = BreakerArray[i].Value THEN
                BreakerArray.RemoveRow(RowNumber = i);
                ENDLOOP;
             ENDIF;
         ENDFOR;
      END;

      IF BreakerArray.LastRow = 0 THEN
         /* All other breaks are currently open */
         x2 = 0;
      ELSE
         /* pending open status */
         IF x2 > BreakerArray.LastRow THEN
            BreakerList = '';
            FOR i = 1 TO BreakerArray.LastRow() DO
               IF BreakerList <> '' THEN
                  BreakerList = BreakerList + ',';
               ENDIF;

               BreakerList = BreakerList + VARCHAR(BreakerArray[i].Value); 
            ENDFOR;
         ENDIF;
         DynamicWhereClause = ' Object IN (' + BreakerList + ') AND ' + 
                             ' StatusCount > 0 AND ' +
                             ' PendingStatus = ' + VARCHAR(Status$Open);
         x1 = 0;
         SELECT :x1 = count(*)
         FROM   FMS_PendingStatus
         WHERE  :DynamicWhereClause;

         /* breakers that are not open or pending open */
         x2 = BreakerArray.LastRow - x1;     
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;        
  
/*
** show the warning message if all other breakers are open or pending open
*/
    IF x2 = 0 THEN  
       WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'All other breakers on the same transmission line as ' + 
                                          JIP.EquipClassName + ' ' + JIP.EquipName + 
                                          ' are either Open or Pending Open. You should issue this move ' + 
                                          ' from a TFMS card to provide line visibility.');           
        IF WarningStatus = PU_CANCEL THEN
           RETURN(PU_CANCEL);
        ELSE
           RetCode = Warning$Overridden;
        ENDIF;
    ENDIF;

    RETURN(RetCode)
END; 

Application Component Report
============================

	Name:            CheckListReview

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          CheckCheckListReview
**  OverView:       Check that all fields in checklist are set prior
**                  to restore the first breaker. Display a warning
**                  message if this is not true.
**                   
**  Modifications:
**	01/26/96    jfl     Created 
**      08/10/99    em      Modified for SOA
**      06/08/00    em      Give warning for checklist items on any card.
**      02/14/01    em      Making this a JobAction PreCheck instead of calling
**                          explicitly from JobChecks. Make work generically
**                          even if called from SLC by passing from card.
**      11/21/14    em      Fixed warning message for other desk name
*/
PROCEDURE CheckListReview
(
    Job = JobInProgress;                    /*Passed Job*/
    Card = INTEGER NOT NULL;                /*Passed Card*/            

    i = INTEGER NOT NULL;
    RetCode = INTEGER;                      /* Code Returned by Warning frame */ 
    CountBreakerClosed = INTEGER NOT NULL;  /* 0 if none of the breakers has been yet restored */
    CheckList = CardCheckList;    /* Used to store checklists for desks */
    OtherDeskName = VARCHAR(10) NOT NULL WITH DEFAULT;

) =
BEGIN
/*
**  Check that it is a breaker move
*/
    i = 0;
    SELECT :i = Count(*)
    FROM   UDB_ExtendedType ET
    WHERE  ET.SuperType = :Type$LoadBreaking 
      AND  ET.Type = :Job.EquipClass;

    IF i = 0 THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  Determine if any breaker has already been restored in which case
**  it is not necessary to warn the operator that checklist was not ready. 
*/
    CountBreakerClosed = 0;
    SELECT :CountBreakerClosed = COUNT(*)
    FROM  SOA_Job J,
          SOA_JobControl JC, 
          Udb_ExtendedType ET
    WHERE JC.Card = :Card AND
          JC.StepPair = :StepHeading$TFMSDeEnergize AND
          JC.Job = J.Job AND
          ET.Supertype = :Type$LoadBreaking AND
          ET.Type = J.EquipClass AND
          J.RSissued IS NOT NULL;
/* 
**  For Checklist related to this desk, check all items are set 
*/
    IF CountBreakerClosed  = 0 THEN
        SELECT :CheckList.Desk = CL.Desk,
               :CheckList.PermitsReturned = CL.PermitsReturned,
               :CheckList.GroundsRemoved = CL.GroundsRemoved,
               :CheckList.DisconnectsClosed = CL.DisconnectsClosed,
               :CheckList.HsgsReset = CL.HsgsReset,
               :CheckList.RelaySysNormal = CL.RelaySysNormal,
               :CheckList.OilPresNormal = CL.OilPresNormal,
               :CheckList.EquipCanBeEnerg = CL.EquipCanBeEnerg,
               :CheckList.EquipPrepForServ = CL.EquipPrepForServ,
               :CheckList.CheckedStnLogCrd = CL.CheckedStnLogCrd,
               :CheckList.AmmeterClearPerf = CL.AmmeterClearPerf,
               :CheckList.AcceptanceLetter = CL.AcceptanceLetter 
        FROM    TFMS_CheckList CL,
                Udb_Object O
        WHERE   CL.Card = :Card AND
                CL.Desk = O.Object AND
                O.Name = :Job.DeskName;
/*
**  Any NULL item in any of the checklists will call up a WARNING frame
*/
        IF (CheckList.PermitsReturned IS NULL OR
                CheckList.GroundsRemoved IS NULL OR
                CheckList.DisconnectsClosed IS NULL OR
                CheckList.HsgsReset IS NULL OR
                CheckList.RelaySysNormal IS NULL OR
                CheckList.OilPresNormal IS NULL OR
                CheckList.EquipCanBeEnerg IS NULL OR
                CheckList.EquipPrepForServ IS NULL OR
                CheckList.CheckedStnLogCrd IS NULL OR
                CheckList.AmmeterClearPerf IS NULL OR
                CheckList.AcceptanceLetter IS NULL ) THEN
/*
**  Issue the warning
*/
           RetCode  = CALLFRAME Warning (
                       Card = Card, 
                       Job = Job.Job,
                       SwitchingItem = Job.SwitchingItem,
                       Text = 'Not all checklist items have been cleared ' +
                              'for desk ' + Job.DeskName + ' for TFMS card ' +
                              VARCHAR(Card));
           IF RetCode = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;
        ENDIF;
/*
**  Now check for NULL items on any desk
*/   
        OtherDeskName = '';
        SELECT :OtherDeskName = O.Name
        FROM    TFMS_CheckList CheckList,
                Udb_Object O
        WHERE   CheckList.Card = :Card AND
                CheckList.Desk = O.Object AND
              ( CheckList.PermitsReturned IS NULL OR
                CheckList.GroundsRemoved IS NULL OR
                CheckList.DisconnectsClosed IS NULL OR
                CheckList.HsgsReset IS NULL OR
                CheckList.RelaySysNormal IS NULL OR
                CheckList.OilPresNormal IS NULL OR
                CheckList.EquipCanBeEnerg IS NULL OR
                CheckList.EquipPrepForServ IS NULL OR
                CheckList.CheckedStnLogCrd IS NULL OR
                CheckList.AmmeterClearPerf IS NULL OR
                CheckList.AcceptanceLetter IS NULL );

        IF OtherDeskName <> '' THEN
           RetCode  = CALLFRAME Warning (
                       Card = Card, 
                       Job = Job.Job,
                       SwitchingItem = Job.SwitchingItem,
                       Text = 'Not all checklist items have been cleared ' +
                              'for desk ' + OtherDeskName + ' for TFMS card ' +
                              VARCHAR(Card));
            IF RetCode = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;
        ENDIF;
    ENDIF;
    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckLiveLineARSOff

/*
**
**	Copyright c 2012 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckLiveLineARSOff
**
**  Modifications:
**  06/11/12    em  Created
**  06/27/12    em  Added DISTINCT
*/

PROCEDURE CheckLiveLineARSOff
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    StatusExists = INTEGER NOT NULL WITH DEFAULT;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    Breakers = ARRAY OF OBJECTSUMMARYCLASS;
    WarningText = VARCHAR(1000) NOT NULL WITH DEFAULT;
) =
BEGIN
   RetCode = NULL;
/* 
** If this breaker is on the line
*/
   Breakers.Clear();
   i = 1;
   REPEATED 
   SELECT DISTINCT
	    :Breakers[i].Object = O.Object
          , :Breakers[i].PrimaryGroupingName = O.PrimaryGroupingName
          , :Breakers[i].TypeName = O.TypeName
          , :Breakers[i].Name = O.Name
   FROM     Udb_Object O
          , Udb_Grouping G
          , TFMS_CardToObject C
          , Udb_ExtendedType ET
   WHERE    C.Card = :JIP.Card AND
            C.Type = :Type$Line AND
            C.Object = G.Grouping AND
            G.Relationship = :Interaction$MemberOf AND
            G.MemberType = ET.Type AND
            ET.SuperType IN (:Type$BkrARS, :Type$BkrROARS) AND
            G.Member = O.Object
   BEGIN 
      i = i + 1;
   END;

   WarningText = '';
   FOR i = 1 TO Breakers.LastRow() DO

      StatusExists = 0;
      SELECT :StatusExists = Object
      FROM   FMS_ObjectStatus 
      WHERE  Object = :Breakers[i].Object AND
             Status = :Status$ARSOff AND
             StatusCount > 0;

      IF StatusExists = 0 THEN
         IF WarningText <> '' THEN
            WarningText = WarningText + ', ' + HC_NEWLINE ;
         ENDIF;
         WarningText = WarningText + Breakers[i].PrimaryGroupingName + ' ' +
                                     Breakers[i].TypeName + ' ' +
                                     Breakers[i].Name;
      ENDIF;
   ENDFOR;        
/*
** show the warning message when necessary
*/
    IF WarningText <> ' ' THEN  
       WarningText = 'The following breakers do not have status ARS_OFF: ' +
                     HC_NEWLINE + WarningText;
       WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = WarningText);
           
        IF WarningStatus = PU_CANCEL THEN
           RETURN(PU_CANCEL);
        ELSE
           RetCode = Warning$Overridden;
        ENDIF;
    ENDIF;

    RETURN(RetCode)
END; 

Application Component Report
============================

	Name:            CheckLocalBlockOpen

/* 
**      Copyright c 2016 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC.
*/
/*
**  Application:    CAC
**  Frame:          CheckLocalBlockOpen
**
**  Date:    Author   Description
** ----------------------------------
**  04/26/00	 em       Created from CheckVisibleBreaks to support TFMS 30.
**  05/03/00    em       In order for ACLineSegment to be target type, it
**                       must be in one substation and not a member of two
**                       stations. 
**  05/16/00    em       From Target Type trace, don't look for closed outbound.
**                       It is okay to reach the end of the station when no
**                       target type is found.
**  05/30/00    em       Change logic pertaining to ACLineSegment to look for
**                       explicit UnderGround Cable type instead.  No longer
**                       looking for ACLineSegment in one station.
**  11/15/00    em       Check fails if we encounter a Load Breaking device that
**                       is not blocked open.
**  02/12/01    em       When doing second trace from Transformer or what not,
**                       pass through the original start device since it is
**                       likely that we are closing this device as part of this
**                       move.  That way we can ignore if it has a visible break
**  02/14/01    em       We limit our VisibleBreak and PendingBreak object lists
**                       to just those objects within the scope of the current
**                       Job's substation.  Then when we go to the neighboring
**                       substation, we don't care about Visible Break or
**                       Block Open any longer (thanks to a Procedure change 
**                       at Con Ed or a misunderstanding), we simply look to
**                       see whether the device is currently open.  We do
**                       this with a select, less efficient than what we had
**                       before, but hey it is a requirement change.
**  02/18/02    em       Set BreakerTypeFound back to FALSE in second trace
**                       if breaker in neighbor substation is open.
**  11/26/02    pkw      Change Job to JIP for Merge.
**  10/21/03    em       Updated error message to include target device
**  02/13/04    em       Convert Messages for TraceError calls
**  02/21/05    em       Extended scope of second trace to all substations associated
**                       with the job.  Added numeric to warning to more easily identify
**                       which warning is being displayed for problem resolution purposes.
**                       Changed depth to 15 in neighboring station.
**  02/24/05    em       Change valid BreakerTypes list from Load Breaking to BREAKER supertype
**  01/11/06    em       Change Second trace initial scope from card scope to station/MacroStation,
**                       hence neighboring station may be on card, just not within same station/Macro
**                       as the target device
**  01/12/06    em       Visible Break/Pending Break lists needs to be reselected for Macro Station in
**                       the second trace.
**  01/13/06    em       Target Device: Changed UnderGround Cable to AC Line Segment
**                       BreakerType for local substation: Move up hierarchy from BREAKER to LoadBreaking
**                       Second Trace in neighboring substations, LoadBreaking is sufficient.
**  01/17/06    em       Error message should indicate whether trace was looking for block open or currently open.
**  01/18/06    em       Final adjustment to error messages
**  01/20/06	em 	 Include Distribution Feeder Source Breaker Types in Load-Breaking
**                       type list.  Equipment R/O and B/O Status satisfies visible break.
**                       Extend trace to Feeder Load.
**  02/16/06    em       Feeder Load is treated as a Visible Break if the related feeder has 
**                       DBF Status. 
**  09/01/06    em       PendingStatusCount must be > 0
**  12/14/09    em       Changes to second trace after target type found.
**                       On second trace, do not extend to neighbor station, stay in current station / Macro station
**                       only.  If Load Breaking device found, must be blocked open.  If it is a CktBkrReac type device,
**                       then it only has to be open. 
**                       If last load-breaking device on path whne leaving station is a CktSwer,
**                       then allow trace to continue into neighbor station using old logic. 
**  12/15/09    em       Add ExtendSubstation to support BlockOpenPlus relationship for former
**                       Macro child stations that were removed from the Macro 
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  09/09/15    em       In first pass, when finding a Breaker, determine whether a Con Ed station.  If not Con Edison
**                       then end trace on that path assuming an open device and do not present warning.
**                       Do same thing in second pass when going into neighbor substation, determine whether a Con Ed station.  
**  11/09/15    em       If FloatEquip is not in Con Ed station, then ignore trace in that direction. 
**  06/21/16    ysp      Converted for QGIS connectivity trace
**  03/16/18    em       Add additional condition to review for TraceStatus$VisibleBreak before display
**                       no visible break on all paths warning.
**  05/06/19    em       Edit one message text to indicated blocked open instead of just open.
**  03/04/20    ysp      Remove "Connectivity trace" from warnings to reduce text lengths.
*/
PROCEDURE CheckLocalBlockOpen (
   JIP = JobInProgress;   /*Passed Job*/		
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   Trace1 = Trace_LocalBlockOpen1;
   Trace2 = Trace_LocalBlockOpen2;
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   
   CardStations = ARRAY OF INTEGEROBJECT;
   ExtendSubstation = INTEGER NOT NULL WITH DEFAULT;
   MacroSubstation = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
   
ENDDECLARE
BEGIN
/*
**  If Job has no equipment, substation field blank, then present an error
**  and exit.
*/
   IF JIP.Equip = 0 THEN
     CALLPROC TraceError (UserMessage = 
              'JobClass Maintenance Setup Error: ' +
              'Local Block Open Check is being performed incorrectly ' +
              'on a move that has no equipment.  ' + 
              'Contact your Adminstrative DO.',
                          TraceMessage =
              'CheckLocalBlockOpen:  JobClass Maint problem. ' +
              'Check is being performed incorrectly ' +
              'on a move that has no equipment.  JobClass = ' +
              VARCHAR(JIP.JobClass) + '.' 
              );
      RETURN(PU_OK);
   ENDIF;
   
   IF JIP.Substation = 0 THEN
     CALLPROC TraceError (UserMessage = 
              'JobClass Maintenance Setup Error: ' +
              'Local Block Open Check is being performed incorrectly ' +
              'on a move where equipment is not in a substation.  ' + 
              'Contact your Adminstrative DO.',
                          TraceMessage =
              'CheckLocalBlockOpen:  JobClass Maint problem. ' +
              'Check is being performed incorrectly ' +
              'on a move where equipment is not in a substation.  Job = ' + 
              VARCHAR(JIP.Job) + '.' 
              );
      RETURN(PU_OK);
   ENDIF;
/*
** start search with this piece of equipment and then branch out in all
** directions. If all paths have visible breaks, return OK status.
** However, if all equipment have been checked , and any path is closed or 
** some floating equipment are found, the focused equipment can be alive. Give warning
** in this case.  
*/
   
   Trace1.JCEquip.Object = JIP.Equip;
   Trace1.JCEquip.TypeName = JIP.EquipClassName;
   Trace1.JCEquip.Name = JIP.EquipName;
   Trace1.JCEquip.Substation = JIP.Substation;
   
   Trace1.UsePendingStatus = TRUE;
   IF JIP.Status = Job$Restore THEN
      Trace1.IssuedOperator = JIP.RSOperator;
   ELSE
      Trace1.IssuedOperator = JIP.TOOperator;
   ENDIF;
   
   TraceStatus = Trace1.StartTargetTrace();
   
   IF Trace1.ReturnCode <> 0 THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Block Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                       'Target trace discovered ' +
                       'a connectivity problem: ' + Trace1.ErrorMessage);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace1.FloatEquip IS NOT NULL THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Block Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                       'Target trace discovered ' +
                       'a connectivity problem at: ' + 
                        Trace1.FloatEquip.StructureName + '  ' +
                        Trace1.FloatEquip.TypeName + '  ' + Trace1.FloatEquip.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace1.BreakerTypeDevice IS NOT NULL THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE + 
                      'Connectivity trace reached ' +
                      'breaker that is not blocked open: ' + 
                       Trace1.BreakerTypeDevice.StructureName + '  ' +
                       Trace1.BreakerTypeDevice.TypeName + '  ' + 
                       Trace1.BreakerTypeDevice.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceStatus <> TraceStatus$VisibleBreak AND Trace1.TargetTypeDevice IS NULL  THEN

      CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
              'CheckLocalBlockOpen DEBUG:  First Trace TargetTypeDevice is NULL and ' +
              'Trace Status = ' + VARCHAR(TraceStatus) +
              '. Yellow Warning will be displayed. Job = ' + 
              VARCHAR(JIP.Job) + '.' 
              );
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +
                      'Target trace could not determine that ' +
                      'all paths are open with a visible break.');
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;

/*
**  If no target type found and no other problems, we can return here okay.
*/
   IF Trace1.TargetTypeDevice IS NULL THEN
      RETURN(PU_OK);
   ENDIF;
   
/*
**  We reach here if Target Type is found and we do not have a Float Equip
**  connectivity problem.  Now starting from the Target Type Equipment,
**  perform connectivity trace looking for Visible Break or Block Open on all
**  paths, including all stations associated to card and fifteen deep into 
**  neighboring substation.
*/
    i = 1;
    CardStations.Clear();
/*
**  Card Scope is changed to include only Job Station and any other within same Macro.
**  Is Job Station in a Macro?  If yes, include all Macro Stations, if no, then card
**  scope is just the station.  Scope may also include BlockOpenPlus station. 
*/
   MacroSubstation = 0;
   SELECT  :MacroSubstation = Grouping
   FROM    Udb_Grouping
   WHERE   Member = :JIP.Substation AND
           Relationship = :Interaction$MemberOf AND
           GroupingType = :Type$MacroSubstation;

   ExtendSubstation = 0;
   SELECT  :ExtendSubstation =  Grouping
   FROM    Udb_Grouping
   WHERE   Member = :JIP.Substation AND
           Relationship = :Interaction$BlockOpenPlus;
   CALLPROC DDB_ROLLBACK;
   
   IF MacroSubstation = 0 AND ExtendSubstation = 0 THEN
      CardStations[1].Value = JIP.Substation;

   ELSEIF MacroSubstation = 0 AND ExtendSubstation <> 0 THEN
      CardStations[1].Value = JIP.Substation;
      CardStations[2].Value = ExtendSubstation;

   ELSEIF MacroSubstation <> 0 THEN
      i = 1;
      SELECT 
      DISTINCT :CardStations[i].Value = Member
      FROM     Udb_Grouping
      WHERE    Grouping = :MacroSubstation AND
               Relationship = :Interaction$MemberOf AND
               MemberType IN (SELECT Type FROM Udb_ExtendedType
                              WHERE  SuperType = :Type$Substation)
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      
      IF ExtendSubstation <> 0 THEN
         k = CardStations.LastRow() + 1;
         CardStations.InsertRow (RowNumber = k);
         CardStations[k].Value = ExtendSubstation;
      ENDIF;
   ENDIF;
   CardStations.Sort(Value = AS_ASC);
   
   /*
   ** start the 2nd trace for visible break in all paths.
   */
   Trace2.JCEquip = Trace1.JCEquip.Duplicate();
   Trace2.TargetTypeDevice = Trace1.TargetTypeDevice.Duplicate();
   Trace2.IssuedOperator = Trace1.IssuedOperator;   
   Trace2.UsePendingStatus = TRUE;
   Trace2.CardStationList = CardStations.Duplicate();
   
   TraceStatus = Trace2.StartVisibleBreakTrace();
   
   /* Give warning if visible break check failed */
   IF Trace2.ReturnCode <> 0 THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Block Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Discovered a connectivity problem: ' + Trace2.ErrorMessage);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace2.FloatEquip IS NOT NULL THEN
      /*
      ** Float Equip may indicated unconnected two terminal error or Fdr Load.
      */
      IF Trace2.FloatEquip.Type = Type$FdrLoad THEN

         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Did not find visible break ' +
                      'on distribution feeder ' + Trace2.FeederLoadFeeder.Name);
      ELSE
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Discovered a connectivity problem at: ' + 
                       Trace2.FloatEquip.StructureName + '  ' +
                       Trace2.FloatEquip.TypeName + '  ' + Trace2.FloatEquip.Name);  
      ENDIF;     

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace2.BreakerTypeDevice IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + 
                      '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Reached a breaker that is not ' + Trace2.BreakerDeviceReason +  
                       Trace2.BreakerTypeDevice.StructureName + '  ' +
                       Trace2.BreakerTypeDevice.TypeName + '  ' + 
                       Trace2.BreakerTypeDevice.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace2.ClosedOutBound IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Could not find a blocked open device in the direction of: ' +
                       Trace2.ClosedOutBound.StructureName + '  ' +
                       Trace2.ClosedOutBound.TypeName + '  ' + Trace2.ClosedOutBound.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF TraceStatus <> TraceStatus$VisibleBreak THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Block Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                       'Could not determine that ' +
                       'all paths are open with a visible break.');
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
   
   RETURN(PU_OK);
    
END;


Application Component Report
============================

	Name:            CheckLocalOpen

/* 
**      Copyright c 2004 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software LLC proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          CheckLocalOpen
**
**  Date:       Author   Description
** ----------------------------------
**  03/19/04	em       Created from CheckLocalBlockOpen to support isolation
**                       based on Open Devices.
**                       Parameter names are not being changed - old terminology
**                       looked for "Breaks".  We continue using the term Visible 
**                       Break, but load the device lists only with Open equipment 
**  02/21/05    em       Extended scope of second trace to all substations associated
**                       with the job.  Added numeric to warning to more easily identify
**                       which warning is being displayed for problem resolution purposes.
**  02/24/05    em       Change BreakerType list from LoadBreaking to BREAKER supertype
**  01/11/06    em       Change Second trace initial scope from card scope to station/MacroStation,
**                       hence neighboring station may be on card, just not within same station/Macro
**                       as the target device
**  01/12/06    em       Visible Break/Pending Break lists needs to be reselected for Macro Station in
**                       the second trace.
**  01/13/06    em       Target Device: Changed UnderGround Cable to AC Line Segment
**                       BreakerType: Move up hierarchy from BREAKER to LoadBreaking
**                       Second Trace in neighboring substations, LoadBreaking is sufficient.
**  01/17/06    em       Modified warning message text
**  01/18/06    em       Final adjustment to error messages
**  01/20/06	em 	 Include Distribution Feeder Source Breaker Types in Load-Breaking
**                       type list.  Equipment R/O and B/O Status satisfies visible break.
**                       Extend trace to Feeder Load.
**  02/15/06    em       Feeder Load is treated as a Visible Break if the related feeder has 
**                       DBF Status.  B/O status will not be considered a visible break.
**  09/01/06    em       PendingStatusCount must be > 0
**  12/29/09    em       Updated per 12/14-15 CheckLocalBlockOpen changes made at Con Edison.
**                       CheckLocalOpen is not currently in use for any Job Checks.
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  06/21/16    ysp      Converted for QGIS connectivity trace
**  03/16/18    em       Applied same change made in CheckLocalBlockOpen
**
*/
PROCEDURE CheckLocalOpen
(
    JIP = JobInProgress;   /*Passed Job*/				         
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   Trace1 = Trace_LocalOpen1;
   Trace2 = Trace_LocalOpen2;
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   
   CardStations = ARRAY OF INTEGEROBJECT;
   ExtendSubstation = INTEGER NOT NULL WITH DEFAULT;
   MacroSubstation = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE   
BEGIN
/*
**  If Job has no equipment, substation field blank, then present an error
**  and exit.
*/
   IF JIP.Equip = 0 THEN
     CALLPROC TraceError (UserMessage = 
              'JobClass Maintenance Setup Error: ' +
              'Local Open Check is being performed incorrectly ' +
              'on a move that has no equipment.  ' + 
              'Contact your Adminstrative DO.',
                          TraceMessage =
              'CheckLocalOpen:  JobClass Maint problem. ' +
              'Check is being performed incorrectly ' +
              'on a move that has no equipment.  JobClass = ' +
              VARCHAR(JIP.JobClass) + '.' 
              );
      RETURN(PU_OK);
   ENDIF;

   IF JIP.Substation = 0 THEN
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Local Open Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckLocalOpen:  JobClass Maint problem. ' +
               'Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  Job = ' + 
               VARCHAR(JIP.Job) + '.' 
               );
      RETURN(PU_OK);
   ENDIF;
/*
** start search with this piece of equipment and then branch out in all
** directions. If all paths are open, return OK status.
** However, if all equipment have been checked, and any path is closed or 
** some floating equipment are found, the focused equipment can be alive. Give warning
** in this case.  
*/
   
   Trace1.JCEquip.Object = JIP.Equip;
   Trace1.JCEquip.TypeName = JIP.EquipClassName;
   Trace1.JCEquip.Name = JIP.EquipName;
   Trace1.JCEquip.Substation = JIP.Substation;
   
   Trace1.UsePendingStatus = TRUE;
   IF JIP.Status = Job$Restore THEN
      Trace1.IssuedOperator = JIP.RSOperator;
   ELSE
      Trace1.IssuedOperator = JIP.TOOperator;
   ENDIF;
   
   TraceStatus = Trace1.StartTargetTrace();
   
   IF Trace1.ReturnCode <> 0 THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                       'Target trace discovered a connectivity problem: ' + Trace1.ErrorMessage);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace1.FloatEquip IS NOT NULL THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                       'Target trace discovered ' +
                       'a connectivity problem at: ' + 
                        Trace1.FloatEquip.StructureName + '  ' +
                        Trace1.FloatEquip.TypeName + '  ' + Trace1.FloatEquip.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace1.BreakerTypeDevice IS NOT NULL THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE + 
                      'Target trace reached ' +
                      'breaker that is not open: ' + 
                       Trace1.BreakerTypeDevice.StructureName + '  ' +
                       Trace1.BreakerTypeDevice.TypeName + '  ' + 
                       Trace1.BreakerTypeDevice.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceStatus <> TraceStatus$Open AND Trace1.TargetTypeDevice IS NULL  THEN

      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +
                      'Connectivity trace could not determine that ' +
                      'all paths are open.');
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;

/*
**  If no target type found and no other problems, we can return here okay.
*/
   IF Trace1.TargetTypeDevice IS NULL THEN
      RETURN(PU_OK);
   ENDIF;
   
/*
**  We reach here if Target Type is found and we do not have a Float Equip
**  connectivity problem.  Now starting from the Target Type Equipment,
**  perform connectivity trace looking for Open on all
**  paths, including all stations associated to card and fifteen deep into 
**  neighboring substation.
*/
    i = 1;
    CardStations.Clear();
/*
**  Card Scope is changed to include only Job Station and any other within same Macro.
**  Is Job Station in a Macro?  If yes, include all Macro Stations, if no, then card
**  scope is just the station.  Scope may also include BlockOpenPlus station. 
*/
   MacroSubstation = 0;
   SELECT  :MacroSubstation = Grouping
   FROM    Udb_Grouping
   WHERE   Member = :JIP.Substation AND
           Relationship = :Interaction$MemberOf AND
           GroupingType = :Type$MacroSubstation;

   ExtendSubstation = 0;
   SELECT  :ExtendSubstation =  Grouping
   FROM    Udb_Grouping
   WHERE   Member = :JIP.Substation AND
           Relationship = :Interaction$BlockOpenPlus;
   CALLPROC DDB_ROLLBACK;
   
   IF MacroSubstation = 0 AND ExtendSubstation = 0 THEN
      CardStations[1].Value = JIP.Substation;

   ELSEIF MacroSubstation = 0 AND ExtendSubstation <> 0 THEN
      CardStations[1].Value = JIP.Substation;
      CardStations[2].Value = ExtendSubstation;

   ELSEIF MacroSubstation <> 0 THEN
      i = 1;
      SELECT 
      DISTINCT :CardStations[i].Value = Member
      FROM     Udb_Grouping
      WHERE    Grouping = :MacroSubstation AND
               Relationship = :Interaction$MemberOf AND
               MemberType IN (SELECT Type FROM Udb_ExtendedType
                              WHERE  SuperType = :Type$Substation)
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      
      IF ExtendSubstation <> 0 THEN
         k = CardStations.LastRow() + 1;
         CardStations.InsertRow (RowNumber = k);
         CardStations[k].Value = ExtendSubstation;
      ENDIF;
   ENDIF;
   CardStations.Sort(Value = AS_ASC);
   
   /*
   ** start the 2nd trace for open in all paths.
   ** start search with target equipment and then branch out in all
   ** directions. If all paths have open devices, return OK status.
   ** However, if all equipment have been checked , and no all paths 
   ** are open or some floating equipment are found, the focused equipment 
   ** can be alive. Give warning in the this case.
   */
   Trace2.JCEquip = Trace1.JCEquip.Duplicate();
   Trace2.TargetTypeDevice = Trace1.TargetTypeDevice.Duplicate();
   Trace2.IssuedOperator = Trace1.IssuedOperator;   
   Trace2.UsePendingStatus = TRUE;
   Trace2.CardStationList = CardStations.Duplicate();
   
   TraceStatus = Trace2.StartOpenTrace();
   
   /* Give warning if Open check failed 
   */
   IF Trace2.ReturnCode <> 0 THEN
      RetCode = CALLFRAME Warning (
                  Card = JIP.Card, 
                  Job = JIP.Job,
                  SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Local Open check failed for disconnect ' + 
                       JIP.EquipName + '. ' + HC_NEWLINE + 
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Connectivity trace discovered a connectivity problem: ' + Trace2.ErrorMessage);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace2.FloatEquip IS NOT NULL THEN
      /*
      ** Float Equip may indicated unconnected two terminal error or Fdr Load.
      */
      IF Trace2.FloatEquip.Type = Type$FdrLoad THEN

         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Connectivity trace did not find open break ' +
                      'on distribution feeder ' + Trace2.FeederLoadFeeder.Name);
      ELSE
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Connectivity trace discovered ' +
                      'a connectivity problem at: ' + 
                       Trace2.FloatEquip.StructureName + '  ' +
                       Trace2.FloatEquip.TypeName + '  ' + Trace2.FloatEquip.Name);  
      ENDIF;     

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace2.BreakerTypeDevice IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + 
                      '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Connectivity trace reached a breaker that is not open:' +  
                       Trace2.BreakerTypeDevice.StructureName + '  ' +
                       Trace2.BreakerTypeDevice.TypeName + '  ' + 
                       Trace2.BreakerTypeDevice.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace2.ClosedOutBound IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                      'Connectivity trace could not find an open device in the direction of: ' +
                       Trace2.ClosedOutBound.StructureName + '  ' +
                       Trace2.ClosedOutBound.TypeName + ' ' + Trace2.ClosedOutBound.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF TraceStatus <> TraceStatus$Open  THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Local Open check failed for disconnect ' + 
                      JIP.EquipName + '. ' + HC_NEWLINE +                        
                      'You may be energizing/de-energizing: ' +
                       Trace2.TargetTypeDevice.StructureName + ' ' + 
                       Trace2.TargetTypeDevice.Name + '.' + HC_NEWLINE +
                       'Connectivity trace could not determine that ' +
                       'all paths are open.');
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
   
   RETURN(PU_OK);
    
END;

Application Component Report
============================

	Name:            CheckLoopAssocFdr

/*
** Copyright c 1997 ESCA Corporation. All Rights Reserved.
** 
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          CheckLoopAssocFdr
**
**  Modifications:
**  10/15/97  jfl   Created 
**  11/19/02  ysp   Merge: removed passed-in C and Jobs
**  01/30/03  ysp   added switchingitem to the warning frame
**  03/30/11  em    Establish CardDetails if necessary before call to LoadAssociatedFeeders
**  08/24/16  ysp   Add FedBy variable used in ConfirmCardDetails
*/
PROCEDURE  CheckLoopAssocFdr
(
    JIP = JobInProgress;				/* Job being processed */
    LoopEquip = GrouperInfo;
    RED_ISO  = ARRAY OF GrouperInfo;
    RED_HTV  = ARRAY OF GrouperInfo;
    RED_Loop = ARRAY OF GrouperInfo;
    RED_ATS  = ARRAY OF GrouperInfo;
    REDString = VARCHAR(400) NOT NULL;
    ISO_Color= Integer NOT NULL;
    HTV_Color= Integer NOT NULL;
    Loop_Color= Integer NOT NULL;
    ATS_Color  = Integer NOT NULL;
    AssFeeders = Array of IntegerObject;
    PreCheck = INTEGER NOT NULL;
    i = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    OverRide = INTEGER NOT NULL;
    FedBy = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    OverRide = FALSE; 
    WarningStatus = PU_OK;
    IF JIP.Equip <> 0 THEN
        /*
        ** identify LOOP
        */
        LoopEquip.GrouperId = 0;
        REPEATED
        SELECT 
            :LoopEquip.GrouperId = O.Object,
            :LoopEquip.GrouperName = O.Name
        FROM Udb_Grouping G,
             Udb_Object O
        WHERE G.Member = :JIP.Equip
          AND G.RelationShip = :Interaction$MemberOf
          AND G.GroupingType = :Type$Loop
          AND O.Object = G.Grouping;
        CALLPROC DDB_ROLLBACK;
/*
** Determine the current button colors
** and the projected button colors if
** cutout move is performed
*/
        IF (LoopEquip.GrouperId <> 0 ) THEN

#    INCLUDE ConfirmCardDetails

            CALLPROC LoadAssociatedFeeders( AssFeeders = byref(AssFeeders),
                                    HTV_Color  = Byref(HTV_Color),
                                    ISO_Color  = Byref(ISO_Color),
                                    Loop_Color = Byref(Loop_Color),
                                    ATS_Color  = Byref(ATS_Color),
                                    RED_HTV    = Byref(RED_HTV),
                                    RED_ISO    = Byref(RED_ISO),
                                    RED_Loop   = Byref(RED_Loop),
                                    RED_ATS    = Byref(RED_ATS),
                                    PreCheck   = TRUE
                                    );
/*
** If the projection is to get a RED condition for the Loop grouper this
** switch belongs, we must issue a Warning
*/
            i = 1;
            WHILE i <= RED_Loop.LastRow() DO
                IF RED_Loop[i].GrouperId = LoopEquip.GrouperId THEN
                    WarningStatus = CALLFRAME Warning (
                                     Card = JIP.Card, 
                                     Job = JIP.Job,
                                     SwitchingItem = JIP.SwitchingItem,
                                     Text = ' Open Loop switch will cause loss of customers ' + 
                                            ' fed from Loop: ' + LoopEquip.GrouperName);
                    IF WarningStatus = PU_CANCEL THEN
                        RETURN(PU_CANCEL);
                    ELSE
                        OverRide = TRUE;
                    ENDIF;
                ENDIF;
                i = i + 1;
            ENDWHILE;
        ENDIF;
    ENDIF;
/*
**  Check to see if they overrode a warning 
*/
    IF OverRide = FALSE THEN
       RETURN(NULL); 
    ELSE
       RETURN(Warning$Overridden);
    ENDIF;
END;

Application Component Report
============================

	Name:            CheckMaxTransformers

/* 
**      Copyright c 2003 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software LLC proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          CheckMaxTransformers
**
**  Date:       Author   Description
** ----------------------------------
**  06/18/03    em       Created to check that closing a breaker is a substation
**                       will not exceed the number of Cut-In transformers
**                       that are appropriate for the station.
**  02/13/04    em       Convert Message to TraceError call
**  06/24/04    em       1) Use Groupings to check substation membership
**                       2) If substation has no max transformer count and it is 
**                          part of Macro, use Max transformer count for other substations
**                          and include other stations in Macro in trace scope. 
**  12/01/05    em       Stray "G." reference corrected. 
**  01/09/06    em       Add list of found Transformers to the Warning message.
**  01/18/06    em       If we are in a Macro Station, found Transformers must be 
**                       followed by a closed "Load-Breaking" device.  We use the 
**                       OutboundBreaker breaker found construct developed for the
**                       ScenarioTrace to keep track that we are looking for a 
**                       LoadBreaking device.
**  02/15/06    em       Ignore Phase Shifter; Use Type$PowerTransformer instead of
**                       Type$Transformer
**  02/17/06    em       Testing change to try avoid counting Transformer twice.
**  03/13/06    em       Always check for Macro Station; previously was only lookng for Macro 
**                       if substation did not have transformer count.
**                       Added Transformer array to keep track of ones counted since message
**                       counted some twice when transformer connected to multiple devices.
**                       In a Macro substation, only treat as a Macro if voltage ratings of 
**                       included substations are not the same.  If all the same, then work 
**                       just with the substation directly.
**  03/14/06    em       Because trace can split after finding transformer and we want to
**                       each path to stop, we move our second duplicate check into breaker 
**                       found logic. 
**                       If we are in a Split Bus Station and the Bus Tie is open, check if current
**                       move is closing that bus tie.  If it is, then use the higher count. 
**  04/18/06    em       VERY SPECIFIC Problem Resolution.  If starting trace in Granite Hill substation 
**                       which is in Dunwoodie Macro, only look for Transformers in Granite Hill. 
**                       Granite Hill Substation Object = 20040.
**  04/19/06    em       VERY SPECIFIC Problem Resolution #2.  If in Corona Macro Substation, don't stop 
**                       at closed breaker on opposite side.  Must be be prepared for possible Corona Wrap.
**  04/20/06    em       VERY SPECIFIC Problem Resolution #3.  Added special Spare Bank check with its
**                       own warning.
**  09/01/06    em       PendingStatusCount must be > 0
**  11/13/07    em       Don't use Granite Hill transformer count when elsewhere in the Macro. 
**  06/15/09    em       Custom warning for any Corona Station warning
**  06/16/09    em       Look for Outbound Breaker (like Macro) in Water Street Station
**  06/17/09    em       Lovely, in Water Street, we have a special case for a single device, basically
**                       if operating this device, do trace normally.  Anywhere else in Water Street we
**                       do the OutBoud Breaker trace.
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  12/30/16    ysp      converted to use QGIS connectivity trace  
**
*/
PROCEDURE CheckMaxTransformers
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER;
    k = INTEGER;
    m = INTEGER NOT NULL WITH DEFAULT;
    n = INTEGER NOT NULL WITH DEFAULT;
    x = INTEGER;

    RetCode         = INTEGER;

    Operator         = INTEGER;  /*Operator to use for pending status check*/

    BusTie           = INTEGER NOT NULL WITH DEFAULT;
    BusTieStatus     = INTEGER NOT NULL WITH DEFAULT;
    MacroSubstation  =  INTEGER NOT NULL WITH DEFAULT;
    MacroRatings = INTEGER NOT NULL WITH DEFAULT;
    MaxTransformers = INTEGER NOT NULL WITH DEFAULT;
    MaxSplitTransformers = INTEGER NOT NULL WITH DEFAULT;
    SubstationScope   = ARRAY OF INTEGEROBJECT; /*Load breaking device types*/
    Trace = Trace_MaxTransformers;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
    
    Substation$GraniteHill = INTEGER NOT NULL;
    Substation$CoronaMacro = INTEGER NOT NULL;
    Substation$WaterStreet = INTEGER NOT NULL;
    WaterStreet$CS4 = INTEGER NOT NULL; /* Circuit Switcher CS4 */
    CoronaSharedSpareBank = INTEGER NOT NULL WITH DEFAULT;
    Corona$BkrTR5 = INTEGER NOT NULL;
    Corona$BkrTR10 = INTEGER NOT NULL;
    CoronaBkrClosed = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** Hard Code specific substation IDs
*/
   Substation$GraniteHill = 20040;
   Substation$CoronaMacro = 150095;
   CoronaSharedSpareBank = FALSE;
   Corona$BkrTR5 = 131523;
   Corona$BkrTR10 = 131586;
   Substation$WaterStreet = 37541;
   WaterStreet$CS4 = 194377; 

   
   IF JIP.Substation = 0 THEN
      CALLPROC TraceError (UserMessage = 
              'Database Setup Error: ' +
              'Move is not defined to a substation.  Cannot limit scope ' +
              'to substation for Max Transformer Check.',
                          TraceMessage =
              'CheckMaxTransformers:  Database setup problem. ' +
              'Move is not defined to a substation.  Cannot limit scope ' +
              'to substation for Max Transformer Check.'
              );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                   ( Card = JIP.Card, 
                     Job = JIP.Job, 
                     SwitchingItem = JIP.SwitchingItem,
                     Text = 'Move is not defined to a substation.  ' +
                            'Cannot limit scope ' +
                            'to substation for Max Transformer Check. ' +
                            'Tech Support should review Automation Monitor ' +
                            'trace log for specific error.'
                   ); 
         RETURN(PU_CANCEL);
      ELSE
         RETURN(PU_OK);
      ENDIF;
   ENDIF;
/*
** Need to know if we are in a Macro Station. 
** Note: Granite Hill substation is part of the Dunwoodie Macro. But do not extend trace 
** outside of the Granite Hill station.
*/
   MacroSubstation = 0;
   IF JIP.Substation <> Substation$GraniteHill THEN
      SELECT :MacroSubstation = Grouping
      FROM   Udb_Grouping 
      WHERE  Member = :JIP.Substation AND
             Relationship = :Interaction$MemberOf AND
             GroupingType = :Type$MacroSubstation;
   ENDIF;
/* 
**  If we are in a Macro, check for number of ratings of member stations.  If ratings are all the
**  same, then we don't use the Macro.
*/
   IF MacroSubstation <> 0 THEN
      MacroRatings = 0;
      SELECT :MacroRatings = COUNT(DISTINCT(G2.Grouping))
      FROM   Udb_Grouping G1,
             Udb_Grouping G2
      WHERE  G1.Grouping = :MacroSubstation AND
             G1.Relationship = :Interaction$MemberOf AND 
             G1.MemberType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE  SuperType = :Type$Substation)  AND
             G1.Member = G2.Member AND
             G2.Relationship = :Interaction$RatedAs;
   
      IF MacroRatings <= 1 THEN
         MacroSubstation = 0;
      ENDIF;
   ENDIF;          
/*
** See if station is defined with Max transformer count.  If not, then we
** ignore this check
*/
   MaxTransformers = 0;
   MaxSplitTransformers = 0;
   SELECT  :MaxTransformers = MaxTransformers,
           :MaxSplitTransformers = MaxSplitTransformers
   FROM    SOA_SubstationTransformer
   WHERE   Substation = :JIP.Substation;
   
   IF MaxTransformers = 0 THEN
/*
**  If we are in a Macro, we look for another Max Transformer count 
**  within the Macro substations.  Don't include Granite Hill in the 
**  Macro search
*/             
      IF MacroSubstation <> 0 THEN       
         SELECT :MaxTransformers = IFNULL(Max(S.MaxTransformers),0),
                :MaxSplitTransformers = IFNULL(Max(S.MaxSplitTransformers),0)
         FROM    SOA_SubstationTransformer S,
                 Udb_Grouping G
         WHERE   G.Grouping = :MacroSubstation AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = S.Substation AND 
                 S.Substation <> :Substation$GraniteHill;          
      ENDIF;
   ENDIF;

   IF MaxTransformers = 0 THEN
      RETURN (PU_OK);
   ENDIF;
/*
**  If in Macro Corona and operating Bkr TR5 or TR10 (we are only in this check
**  because the move is closing the device), then look at the other Bkr TR10 or TR5.
**  If other breaker is closed, then act as if BT is open and use the lower
**  Transformer count for the station.  And we have special warning text for this case.
*/
   CoronaSharedSpareBank = FALSE;
   IF MacroSubstation = Substation$CoronaMacro AND 
      (JIP.Equip = Corona$BkrTR5 OR JIP.Equip = Corona$BkrTR10) THEN
      CoronaBkrClosed = 1;
      IF JIP.Equip = Corona$BkrTR5 THEN
         SELECT :CoronaBkrClosed = CurrentlyOpen
         FROM   Udb_Switch
         WHERE  Object = :Corona$BkrTR10;
      ELSE
         SELECT :CoronaBkrClosed  = CurrentlyOpen
         FROM   Udb_Switch
         WHERE  Object = :Corona$BkrTR5;
      ENDIF;
      IF CoronaBkrClosed = 0 THEN
         CoronaSharedSpareBank = TRUE;
         MaxSplitTransformers = 0; /*Forces use of lower transformer number*/
      ENDIF;
   ENDIF; 
/*
**  If a Split Bus Configuration, then check open/closed status of BusTie
**  Breaker.  Logic works for single station with two Bus Ties since they are in
**  series and would be operated together.
*/
   IF MaxSplitTransformers > 0 THEN
      BusTie = 0;
      BusTieStatus = 0;  /*Default Closed*/
      REPEATED
      SELECT  :BusTieStatus = S.CurrentlyOpen,
              :BusTie = S.Object
      FROM    Udb_Switch S,
              Udb_Grouping G
      WHERE   S.Object = G.Member AND
              G.MemberType IN (SELECT Type FROM Udb_ExtendedType 
                               WHERE  SuperType = :Type$BusTie) AND
              G.Relationship = :Interaction$MemberOf AND
              G.Grouping = :JIP.Substation;
/*
**  If Bus Tie Open, check if this move is closing it. If Bus Tie is open
**  we use the current (lower) Max Transformer Count.
*/       
      IF BusTieStatus = 1 THEN
         IF JIP.Equip = BusTie THEN
            REPEATED
            SELECT :BusTieStatus = 0
            FROM    FMS_JobAction JA,
                    SOA_JobControl JC,
                    SOA_ActiveCard AC
            WHERE   JA.JobClass = :JIP.JobClass AND
                    JA.EquipClass = :JIP.MoveEquipClass AND
                    JA.StepPair = :JIP.StepPair AND
                    JA.TypeOfCard = AC.TypeOfCard AND
                    AC.Card = JC.Card AND
                    JC.Job = :JIP.Job AND
                    JA.TORS = :JIP.TORS AND
                    JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                    JA.Action = :JobAction$Prompt AND
                    JA.Status = :Prompt$ClearCurrentlyOpen;
   
            IF BusTieStatus = 0 THEN /*We are closing it*/
               MaxTransformers = MaxSplitTransformers;
            ENDIF;
         ENDIF;
      ELSE   /*Device is closed*/
         MaxTransformers = MaxSplitTransformers; 
      ENDIF;
   ENDIF;
   
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all open breaks and grounds
** into sorted lists which then can be searched using our bisection search.
*/
   SubstationScope.Clear();
   
/*
**  Get list of Open Breakers within selected substation; Select is different depending on 
**  whether we are looking through Macro Station or not. 
*/
   IF MacroSubstation = 0 THEN
      SubstationScope[1].Value = JIP.Substation;
     

   ELSE
      i = 1;
      SELECT :SubstationScope[i].Value = G.Member
      FROM   Udb_Grouping G
      WHERE  G.Grouping = :MacroSubstation AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType IN (SELECT Type
                              FROM   UDB_ExtendedType
                              WHERE  SuperType = :Type$Substation)
      BEGIN
         i = i + 1;
      END;
   ENDIF;

/*
**  Build first part of where clause, second part depends if current equip
**  grounded.
*/
   
   Trace.Substation$CoronaMacro = Substation$CoronaMacro;
   Trace.Substation$WaterStreet = Substation$WaterStreet;
   Trace.WaterStreet$CS4 = WaterStreet$CS4; 

   Trace.JCEquip.Object = JIP.Equip;
   Trace.JCEquip.TypeName = JIP.EquipClassName;
   Trace.JCEquip.Name = JIP.EquipName;
   Trace.JCEquip.Substation = JIP.Substation;
   
   Trace.UsePendingStatus = TRUE;
   IF JIP.Status = Job$Restore THEN
      Trace.IssuedOperator = JIP.RSOperator;
   ELSE
      Trace.IssuedOperator = JIP.TOOperator;
   ENDIF;
   
   Trace.MaxTransformers = MaxTransformers;
   Trace.MacroSubstation = MacroSubstation;
   Trace.SubstationScope = SubstationScope;
   
   TraceStatus = Trace.StartTargetTrace();
   
   IF TraceStatus = TraceStatus$Isolated THEN
      RETURN (PU_OK);
     
   ELSEIF Trace.ReturnCode <> 0 THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Max Transformers check incomplete from equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + HC_NEWLINE + 
                      'Connectivity trace discovered a connectivity problem: ' + Trace.ErrorMessage);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
/*
** Warnings for connectivity errors
*/
   ELSEIF Trace.FloatEquip IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Max Transformers check incomplete from equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + 
                      '. ' + HC_NEWLINE + 'Connectivity trace discovered ' +
                      'a connectivity problem at: ' + 
                       Trace.FloatEquip.StructureName + '  ' +
                       Trace.FloatEquip.TypeName + '  ' + Trace.FloatEquip.Name +
                       ' (' + VARCHAR(Trace.FloatEquip.Object) + ')');       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace.CountedXferList.LastRow > MaxTransformers THEN
/*
** Custom Warnings for Corona
*/
      IF CoronaSharedSpareBank = TRUE THEN
         IF JIP.Equip = Corona$BkrTR5 THEN
            RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Spare Bank already in service via Bkr TR10. You may be exceeding maximum ' +
                      'Transformers allowed in Corona 27kV #1.');                  
         ELSE
            RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Spare Bank already in service via Bkr TR5. You may be exceeding maximum ' +
                      'Transformers allowed in Corona 27kV #2.');                  
         ENDIF;

      ELSEIF MacroSubstation = Substation$CoronaMacro THEN 
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Exceeding maximum allowable CutIn ' +
                      'Transformers for Corona Substation.');    

      ELSE
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Exceeding maximum allowable CutIn ' +
                      'Transformers (' + VARCHAR(MaxTransformers) + 
                      ') for this Substation.' + HC_NEWLINE + 'Transformers found: ' + Trace.XFMRListText);    
      ENDIF;   

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ENDIF;
   RETURN(PU_OK);
END;





























Application Component Report
============================

	Name:            CheckNCHTVOpen

/*
**
**	Copyright c 2017 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckNCHTVOpen 
**
**  Modifications:
**  04/27/17 em	    Created 
**  05/02/17 em     Look at Job Card only when looking for Auto/OOE1
**                  Modification to warning message  
*/
PROCEDURE CheckNCHTVOpen 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    HTVGrouper = INTEGER NOT NULL WITH DEFAULT;
    AutoCard = INTEGER NOT NULL WITH DEFAULT;
    SelectCount = INTEGER NOT NULL WITH DEFAULT;
    HTVGrouperName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
ENDDECLARE    
BEGIN
/*
**  Don't do anything unless this move is on an Auto/OOE1 card
*/
   AutoCard = 0;
   SELECT :AutoCard = C.Card
   FROM   FMS_Card C
   WHERE  C.Card = :JIP.Card AND
          C.CardClass IN (:Type$Auto, :Type$OOE1);
   IF AutoCard = 0 THEN
      RETURN(PU_OK);
   ENDIF;
/*
** Equipment must be a normally open HTV BT equipment
*/ 
   HTVGrouper = 0;
   REPEATED
   SELECT :HTVGrouper = G.Grouping,
          :HTVGrouperName = O.Name
   FROM   Udb_Grouping G,
          Udb_Switch S,
          Udb_ExtendedType ET,
          Udb_Object O
   WHERE  G.Member = :JIP.Equip AND
          G.Member = S.Object AND
          S.NormalOpen = 1 AND
          G.MemberType = ET.Type AND
          ET.SuperType = :Type$HTVBT AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$AbstractHTV AND
          G.Grouping = O.Object;
   IF HTVGrouper = 0 THEN
      RETURN(PU_OK);
   ENDIF;

   SelectCount = 0;
   SELECT :SelectCount = StatusCount
   FROM   FMS_ObjectStatus
   WHERE  Object = :HTVGrouper AND
          Status = :Status$NCHTVOpen;

   RetCode = PU_OK;
   IF SelectCount = 0 THEN

          WarningStatus = CALLFRAME Warning (
                              Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'Normally closed Breaker/Knife Switch at ' +
                                     HTVGrouperName + ' must be open before performing this action ' +
                                     'on an AUTO or OOE1 card.');
          IF WarningStatus = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RetCode = Warning$Overridden; 
          ENDIF;
   ENDIF;

   RETURN(RetCode); 
END;

Application Component Report
============================

	Name:            CheckNetworkFeederTC

/*
**
**	Copyright c 2002 Pateric Software LLC  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckNetworkFeederTC
**
**  Modifications:
**  03/27/02 em	    Created; check if another feeder in the Network has
**                  TC Status.
**  11/19/02 ysp    Merge: removed passed-in C and Jobs 
**  09/05/06 em     Look at Pending TC Status also.
**  03/24/11 em     Merge 3G updates
*/
PROCEDURE CheckNetworkFeederTC  
(
    JIP = JobInProgress;				/* Job being processed */

    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;

    i = INTEGER NOT NULL WITH DEFAULT;    
    k = INTEGER NOT NULL WITH DEFAULT;    
    CommonFeederCard = ARRAY OF FMS_Card;
    Network = INTEGER NOT NULL WITH DEFAULT;    /* Feeder's Network */
    NetworkName = VARCHAR(40) NOT NULL WITH DEFAULT; /* Feeder Network Name */
    Operator = INTEGER;          /* Operator to use for pending check*/
    TCFeeders = ARRAY OF ObjectSummaryClass;    /* Network TC Feeders */
    TCPending = INTEGER NOT NULL WITH DEFAULT;  /* BOOLEAN*/   
    WarningMessage = VARCHAR(256) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**    Find all feeder cards which this job is common with.
**    If we couldn't find a feeder then nothing more to do
*/
    k = 1;
    REPEATED
    SELECT  :CommonFeederCard[k].Card = C.Card,
            :CommonFeederCard[k].FeederName = C.FeederName
    FROM    SOA_JobControl JC,
            FMS_Card C
    Where   JC.Job = :JIP.Job AND
            JC.Card = C.Card
    BEGIN
        k = k + 1;
    END;
/*
** Determine Operator for Pending
*/
    IF JIP.Status = Job$Restore THEN
       Operator = JIP.RSOperator;
    ELSE
       Operator = JIP.TOOperator;
    ENDIF;

    RetCode = NULL;
    FOR k = 1 TO CommonFeederCard.LastRow() DO
/*
**  Get the Network, then a list of Feeder's in that Network that have
**  TC to build a descriptive warning message.
*/
       NetWork = 0;
       REPEATED
       SELECT :Network = G.Grouping,
              :NetworkName = O.Name 
       FROM   Udb_Grouping G,
              Udb_Object O, 
              SOA_ActiveObject AO
       WHERE  AO.Card = :CommonFeederCard[k].Card AND
              AO.ObjectToCardLink = 1 AND
              AO.Object = G.Member AND
              G.Relationship = :Interaction$MemberOf AND
              G.Grouping = O.Object AND
              O.Type = :Type$Network;

       IF Network = 0 THEN
          CONTINUE;
       ENDIF;

       TCFeeders.Clear();
       i = 1;
       REPEATED
       SELECT :TCFeeders[i].Object = G.Member,
              :TCFeeders[i].Name = O.Name  
       FROM   Udb_Grouping G,
              FMS_ObjectStatus OS,
              Udb_Object O
       WHERE  OS.Status = :Status$TC AND
          OS.StatusCount > 0 AND
          OS.Object = G.Member AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = :Network AND
          G.Member = O.Object AND
          O.Type = :Type$Feeder AND
          G.Member NOT IN (SELECT Object FROM SOA_ActiveObject
                           WHERE  Card = :CommonFeederCard[k].Card) 
       BEGIN
          i = i + 1;
       END;

       i = TCFeeders.LastRow();
       WHILE i > 0 DO
          TCPending = 0;
          SELECT  :TCPending = COUNT(*)
          FROM    FMS_PendingStatus 
          WHERE   Object = :TCFeeders[i].Object AND
                  IssuedOperator = :Operator AND
                  StatusCount = 0 AND
                  PendingStatus = :Status$TC;

          IF TCPending > 0 THEN
             TCFeeders.RemoveRow (RowNumber = i);
          ENDIF;
          i = i - 1;
       ENDWHILE;
      
       IF TCFeeders.LastRow() > 0 THEN
           WarningMessage = 'Feeder: ';
     
           FOR i = 1 TO TCFeeders.LastRow() DO
              IF i = 1 THEN
                 WarningMessage = WarningMessage + TCFeeders[i].Name;
              ELSE
                 WarningMessage = WarningMessage + ', ' + TCFeeders[i].Name;
              ENDIF;
           ENDFOR;

           WarningMessage = WarningMessage + ' in Network: ' + NetworkName +
                           ' has TC applied.';  

           WarningStatus = CALLFRAME Warning 
                                (Card = JIP.Card, 
                                 Job = JIP.Job,
                                 SwitchingItem = JIP.SwitchingItem,
                                 Text = WarningMessage);   
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;
       ENDIF;
    ENDFOR;

    RETURN(RetCode)
END; 

Application Component Report
============================

	Name:            CheckNoDeadMoveInProgres

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckNoDeadMoveInProgres 
**
**  Modifications:
**	 11/03/92  em	   Created 
**  02/05/93  em     Removed call to check StationOut
**  11/19/02  ysp    Merge: removed passed-in C and Jobs
**  08/10/16  ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
*/
PROCEDURE CheckNoDeadMoveInProgres 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE 
    i = INTEGER NOT NULL;    
    k = INTEGER NOT NULL;    
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
ENDDECLARE
BEGIN 
    WarningStatus = PU_OK;

    k = 1;
    REPEATED
    SELECT :CommonFeederCard[k].Card = C.Card,
           :CommonFeederCard[k].Feeder = C.Feeder,
           :CommonFeederCard[k].FeederName = C.FeederName,
           :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[k].TypeOfCard = C.TypeOfCard
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    Where   JC.Job = :JIP.Job AND
            JC.Card = AC.Card AND
            JC.Card = C.Card
    BEGIN
        k = k + 1;
    END;

    RetCode = NULL;

    FOR k = 1 TO CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[k].GetGeneralCardName();
       
       i = 0;
       REPEATED 
       SELECT :i = Count(*)
       FROM   SOA_Job J,
              SOA_JobControl JC  
       WHERE  JC.Card = :CommonFeederCard[k].Card AND
              JC.Job = J.Job AND
              J.MoveType = 'Dead' AND
              ((J.TOIssued IS NOT NULL AND
                J.TOComplete IS NULL) OR
               (J.RSIssued IS NOT NULL AND
                J.RSComplete IS NULL));

       IF i > 0 THEN    
          WarningStatus = CALLFRAME Warning 
                           (Card = JIP.Card, 
                            Job = JIP.Job,
                            SwitchingItem = JIP.SwitchingItem,
                            Text = 'There are dead moves in progress on feeder ' +
                                   FeederName + '.');       

          IF WarningStatus = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RetCode = Warning$Overridden;
          ENDIF;
       ENDIF;
    ENDFOR;

   RETURN(NULL); 
END;

Application Component Report
============================

	Name:            CheckNoFieldGrounds

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckNoFieldGrounds  
**
**  Modifications:
**  02/09/11  em   Created using CheckStationGroundOnly as the source
**  04/22/11  em   On a Network Feeder card, Source Position may not be in the Station
**  06/29/16  em   Extend to 33kV
**  08/10/16  ysp  For 33kv portion card, prepend main feeder name to the portion name in messages 
*/
PROCEDURE  CheckNoFieldGrounds 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    SourceGrounds = INTEGER NOT NULL WITH DEFAULT;
    StationPosition = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER;
ENDDECLARE
BEGIN
   i = 1;
   REPEATED
   SELECT
   DISTINCT
          :CommonFeederCard[i].Card = C.Card,
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].Feeder = C.Feeder,
          :CommonFeederCard[i].StationGround = C.StationGround,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
          :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
          :CommonFeederCard[i].GroundsOn = C.GroundsOn
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card
   BEGIN
      i = i + 1;
   END;

   RetCode = NULL;

   FOR i = 1 TO CommonFeederCard.LastRow() DO
      FeederName = CommonFeederCard[i].GetGeneralCardName();
/*
** Does card have source position in station?
*/
      StationPosition = 0;
      SELECT :StationPosition = G.Member
      FROM   Udb_Grouping G,
             TFMS_CardToObject CTO,
             Udb_Grouping G2
      WHERE  CTO.Card = :CommonFeederCard[i].Card AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$SourcePosition AND
             G.Member = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                 WHERE  SuperType = :Type$Substation);

      SourceGrounds = 0;
      IF StationPosition <> 0 THEN
/*
**  get source equipment ground count; using sum allows for
**  potential multiple source positions; Source ground must be in Station
*/ 
         SELECT :SourceGrounds = IFNULL(Sum(S.StatusCount),0)
         FROM   FMS_ObjectStatus S,
                Udb_Grouping G,
                TFMS_CardToObject CTO,
                Udb_Grouping G2
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$SourcePosition AND
                G.Member = S.Object AND
                S.Status = :Status$Ground AND
                G.Member = G2.Member AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$Substation);

/*
** IF not, confirm 3G Feeder
*/
      ELSEIF CommonFeederCard[i].NetworkFeeder > 0 THEN

         SELECT :SourceGrounds = IFNULL(Sum(S.StatusCount),0)
         FROM   FMS_ObjectStatus S,
                Udb_Grouping G,
                TFMS_CardToObject CTO 
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$SourcePosition AND
                G.Member = S.Object AND
                S.Status = :Status$Ground;

      ENDIF;

      WarningStatus = PU_OK;
      IF CommonFeederCard[i].GroundsOn > SourceGrounds THEN

         WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'Grounds still exist on feeder: ' + FeederName + '.');  
         IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
         ELSE
            RetCode = Warning$Overridden;
         ENDIF;
 
      ENDIF;
   ENDFOR;

   RETURN(RetCode); 
END;

Application Component Report
============================

	Name:            CheckNotEnergizingGround

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    CAC
**  Frame:          CheckNotEnergizingGround
**
**  Date:       Author   Description
** ----------------------------------
**  11/08/11    em       converted to Check Visible Breaks and looking for all grounds
**                       in front of breaks
**  10/27/14    em       Exclude grounds on BPD and CCPD devices.
**  04/19/17    em       Converting to QGIS model
**  05/01/17    em       For closed outbound, don't show substation name, might be too far out
**                       of scope to make sense.
**  05/04/17    em       When return status is visiblebreak don't need warning.
**                       Fix building of PerformMoves Break arrays. 
**  05/05/17    em       Must load all BPD grounds for exclusion so we don't hit ones outside scope of station. 
**  05/09/17    em       BPD Ground removal is not working since the ones we are finding are out of scope of card.
**                       Can only remove statuses within scope of the perform moves array.  When finding grounds
**                       must exclude BPD Type of equipment.  Move this logic to CAC_Trace_Engine.
**  10/07/17    em       Correct row out of range trace log error.
*/
PROCEDURE CheckNotEnergizingGround
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER;
    g = INTEGER NOT NULL WITH DEFAULT; /*Ground Equip index */
    p = INTEGER NOT NULL WITH DEFAULT; /*Perform Moves Array index */
    x = INTEGER;

    RetCode         = INTEGER;
    VisibleBreak    = INTEGER NOT NULL;


    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadObject  = INTEGER NOT NULL WITH DEFAULT;
    StatusDBF      = INTEGER NOT NULL WITH DEFAULT;

    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

    OutBoundType   = INTEGER NOT NULL;    /*Look at OutBoundTypes*/    
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    TwoPosition    = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    TwoPositionClause = VARCHAR(100) NOT NULL WITH DEFAULT;
    GroundFoundEquip = VARCHAR(300) NOT NULL WITH DEFAULT;

    TargetTypes = ARRAY OF IntegerObject;
    TraceAdj = Trace_AdjacentEquipment;
    TraceNEG = Trace_NotEnergizingGround;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   TraceNEG = Trace_NotEnergizingGround.Create();

   TraceNEG.JCEquip.Object = JIP.Equip;
   TraceNEG.JCEquip.TypeName = JIP.EquipClassName;
   TraceNEG.JCEquip.Name = JIP.EquipName;
   TraceNEG.JCEquip.PrimaryGrouping = JIP.Substation;
   TraceNEG.JCEquip.PrimaryGroupingName = JIP.SubstationName;

   i = 1;
   REPEATED
   SELECT 
   DISTINCT 
            :TraceNEG.CardObjects[i].Value = AO.Object
   FROM    SOA_ActiveObject AO,
           SOA_JobControl JC
   WHERE   JC.Job = :JIP.Job AND   
           JC.Card = AO.Card
   BEGIN
       i = i + 1;
   END;

   TraceNEG.CardLineObjects.Clear();
   IF CurrentApplication = Application$TFMS THEN
      i = 1;
      REPEATED
      SELECT 
      DISTINCT 
            :TraceNEG.CardLineObjects[i].Value = G.Member
      FROM   SOA_ActiveObject AO,
             Udb_Grouping G
      WHERE   AO.Card = :JIP.Card AND   
              AO.Object = G.Grouping AND
              G.GroupingType = :Type$Line AND
              G.Relationship = :Interaction$MemberOf
      BEGIN
         i = i + 1;
      END;
   ENDIF;

   TraceNEG.UsePendingStatus = TRUE;
   IF JIP.Status = Job$Restore THEN
      TraceNEG.IssuedOperator = JIP.RSOperator;
   ELSE
      TraceNEG.IssuedOperator = JIP.TOOperator;
   ENDIF;
/* 
** If a Two Position Switch Start toward breaker.
*/
   IF JIP.EquipClass = Type$DiscGrdBkr THEN
      TargetTypes[1].Value = Type$Bkr;
      TargetTypes[2].Value = Type$BkrSpare;
      TargetTypes[3].Value = Type$BkrRO;
      TargetTypes[4].Value = Type$BkrROSpare;
      TraceAdj = Trace_AdjacentEquipment.Create();
      TraceStatus = TraceAdj.FindAdjacentEquipment(JobEquip = JIP.Equip,
                                                   TargetTypes = TargetTypes);
      IF TraceStatus = TraceStatus$TargetFound THEN
         FOR i = 1 TO TraceAdj.PathResultList.LastRow DO
            IF TraceAdj.PathResultList[i].Status = TraceStatus$TargetFound THEN
               TraceNEG.FromEquip = TraceAdj.PathResultList[i].FirstEquip.Duplicate();
            ENDIF;
         ENDFOR;
      ENDIF;
/*
** If we are operating on a Two Position Switch, extend the Pending Breaks based on the 
** PerformMovesArray.  We are expecting both two position switches for the breaker to be
** operated in the same order.
*/   
      FOR p = 1 TO PerformMovesArray.LastRow() DO
   
         TwoPosition = FALSE;
         REPEATED
         SELECT :TwoPosition = 1
         FROM    FMS_JobAction JA,
                 SOA_JobControl JC,
                 SOA_ActiveCard AC
         WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                 JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                 JA.StepPair = :PerformMovesArray[p].StepPair AND
                 JA.TypeOfCard = AC.TypeOfCard AND
                 AC.Card = JC.Card AND
                 JC.Job = :PerformMovesArray[p].Job AND
                 JA.TORS = :PerformMovesArray[p].TORS AND
                 JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                 JA.Action = :JobAction$Set AND
                 JA.Status IN (:Status$VisibleBreak,:Status$RO);
   
         IF TwoPosition = 1 THEN
/*
** Insert new entry in PendingBreaks in appropriate numerical slot.
*/ 
            i = 1;
            WHILE i <= TraceNEG.TwoPositionPendingBreaks.LastRow() DO
               IF TraceNEG.TwoPositionPendingBreaks[i].VALUE = PerformMovesArray[p].Equip THEN
                  /* Already Exists in Array */
                  i = 0;
                  ENDLOOP;
               ENDIF;
               IF i = 1 THEN
                  IF PerformMovesArray[p].Equip < TraceNEG.TwoPositionPendingBreaks[i].VALUE THEN
                     ENDLOOP;
                  ENDIF;
               ELSEIF PerformMovesArray[p].Equip < TraceNEG.TwoPositionPendingBreaks[i].VALUE AND
                      PerformMovesArray[p].Equip > TraceNEG.TwoPositionPendingBreaks[i-1].VALUE THEN
                  ENDLOOP;
               ENDIF;
               i = i + 1;
            ENDWHILE;
            
            IF i <> 0 THEN
               TraceNEG.TwoPositionPendingBreaks.InsertRow (rownumber = i);
               TraceNEG.TwoPositionPendingBreaks[i].Value = PerformMovesArray[p].Equip;
            ENDIF;
         ENDIF;
      ENDFOR;        
   ENDIF;
/*
**  Ignore the visible breaks that are being removed in the set of moves being issued.
*/
   FOR p = 1 TO PerformMovesArray.LastRow() DO
      IF PerformMovesArray[p].Job = JIP.Job AND 
           PerformMovesArray[p].TORS = JIP.TORS THEN
         CONTINUE;
      ELSE
         TwoPosition = FALSE;
         REPEATED
         SELECT :TwoPosition = 1
         FROM    FMS_JobAction JA,
                 SOA_JobControl JC,
                 SOA_ActiveCard AC
         WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                 JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                 JA.StepPair = :PerformMovesArray[p].StepPair AND
                 JA.TypeOfCard = AC.TypeOfCard AND
                 AC.Card = JC.Card AND
                 JC.Job = :PerformMovesArray[p].Job AND
                 JA.TORS = :PerformMovesArray[p].TORS AND
                 JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                 JA.Action = :JobAction$Clear AND
                 JA.Status IN (:Status$VisibleBreak,:Status$RO);

         IF TwoPosition = 1 THEN
/*
** We appear to be removing the visible break in the block of moves being issued at
** the same time, let's put in PendingBreaks array for removal from existing break list in class.
*/ 
             i = 1;
             WHILE i <= TraceNEG.RemoveBreaks.LastRow() DO
                IF TraceNEG.RemoveBreaks[i].VALUE = PerformMovesArray[p].Equip THEN
                   /* Already Exists in Array */
                   i = 0;
                   ENDLOOP;
                ENDIF;
                IF i = 1 THEN
                   IF PerformMovesArray[p].Equip < TraceNEG.RemoveBreaks[i].VALUE THEN
                      ENDLOOP;
                   ENDIF;
                ELSEIF PerformMovesArray[p].Equip < TraceNEG.RemoveBreaks[i].VALUE AND
                       PerformMovesArray[p].Equip > TraceNEG.RemoveBreaks[i-1].VALUE THEN
                   ENDLOOP;
                ENDIF;
                i = i + 1;
             ENDWHILE;
             IF i <> 0 THEN
                TraceNEG.RemoveBreaks.InsertRow (rownumber = i);
                TraceNEG.RemoveBreaks[i].Value = PerformMovesArray[p].Equip;
             ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;     
/*
**  Ignore BPD and CCPD grounds. 
**  This logic removed because the objects loaded initially will not include the out of scope 
**  ones that can be excluded.
* 
   i = 1;    
   REPEATED    
   SELECT DISTINCT
           :TraceNEG.RemoveBPDGrounds[i].Value = OS.Object
   FROM    FMS_ObjectStatus OS,
           Udb_Grouping G,
           Udb_Object O
   WHERE   OS.Status = :Status$Ground AND
           OS.StatusCount > 0 AND
           OS.Object = G.Member AND
           OS.Object = O.Object AND
           O.Type IN     (SELECT Type FROM Udb_ExtendedType 
                          WHERE  SuperType IN (:Type$BPD,:Type$CCPD) ) AND
           G.Relationship = :Interaction$MemberOf 
   BEGIN
      i = i + 1;
   END;
/*
** Remove also Two Position Grounds and Pending Remove Grounds
*/ 
   FOR p = 1 TO PerformMovesArray.LastRow() DO
      TwoPosition = FALSE;
      REPEATED
      SELECT :TwoPosition = 1
      FROM    FMS_JobAction JA,
              SOA_JobControl JC,
              SOA_ActiveCard AC
      WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
              JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
              JA.StepPair = :PerformMovesArray[p].StepPair AND
              JA.TypeOfCard = AC.TypeOfCard AND
              AC.Card = JC.Card AND
              JC.Job = :PerformMovesArray[p].Job AND
              JA.TORS = :PerformMovesArray[p].TORS AND
              JA.IssueCompl = 1 AND            /*At Move Completion Time*/
              JA.Action = :JobAction$Prompt AND
              JA.Status = :Prompt$RemoveGroundBkrSide;

      IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's remove this ground.
*/ 
         i = TraceNEG.RemoveBPDGrounds.LastRow + 1;
         TraceNEG.RemoveBPDGrounds.InsertRow (rownumber = i);
         TraceNEG.RemoveBPDGrounds[i].Value = PerformMovesArray[p].Equip;
      ENDIF;
   ENDFOR;    
/*
** This might already be handled via PerformMovesArray
   TwoPosition = FALSE;
   REPEATED
   SELECT :TwoPosition = 1
   FROM    FMS_JobAction JA,
           SOA_JobControl JC,
           SOA_ActiveCard AC
   WHERE   JA.JobClass = :JIP.JobClass AND
           JA.EquipClass = :JIP.MoveEquipClass AND
           JA.StepPair = :JIP.StepPair AND
           JA.TypeOfCard = AC.TypeOfCard AND
           AC.Card = JC.Card AND
           JC.Job = :JIP.Job AND
           JA.TORS = :JIP.TORS AND
           JA.IssueCompl = 1 AND            
           JA.Action = :JobAction$Prompt AND
           JA.Status = :Prompt$RemoveGroundBkrSide;
   
   IF TwoPosition = 1 THEN
      TraceNEG.RemoveBPDGrounds[i].Value = JIP.Equip;
      i = i + 1;
   ENDIF;
*/
/*
** And also Check for Pending Ground Removal on this device.
*/
   k = 0;
   SELECT  :k = Object
   FROM    FMS_PendingStatus 
   WHERE   Object = :JIP.Equip AND
           PendingStatus = :Status$Ground AND
           StatusCount = 0 AND
           IssuedOperator = :TraceNEG.IssuedOperator;

   IF k = JIP.Equip THEN
      i = TraceNEG.RemoveBPDGrounds.LastRow + 1;
      TraceNEG.RemoveBPDGrounds.InsertRow (rownumber = i);
      TraceNEG.RemoveBPDGrounds[i].Value = JIP.Equip;
   ENDIF;    
   
   TraceStatus = TraceNEG.StartVisibleBreakTrace();
   
/*
** If no Ground found then we exit.
*/
   IF TraceNEG.GroundEquip.LastRow() = 0 THEN
      RETURN(PU_OK);
   ELSE
      FOR p = 1 TO TraceNEG.GroundEquip.LastRow() DO
         IF p > 1 THEN
            GroundFoundEquip = GroundFoundEquip + ',';
         ENDIF;
         GroundFoundEquip = GroundFoundEquip + 
                            TraceNEG.GroundEquip[p].PrimaryGroupingName + ' ' +
                            TraceNEG.GroundEquip[p].TypeName + ' ' +
                            TraceNEG.GroundEquip[p].Name;
      ENDFOR;
   ENDIF;

   IF TraceNEG.FloatEquip IS NOT NULL THEN
/*
** Float Equip may indicated unconnected two terminal error or Fdr Load.
*/
      IF TraceNEG.FloatEquip.Type = Type$FdrLoad THEN

         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                      'You are attempting to remove a visible break that is necessary ' +
                      'to support this ground.');
      ELSE
         IF TraceNEG.FloatEquip.Name = '' THEN
            SELECT :TraceNEG.FloatEquip.Name = Name 
            FROM   Udb_Object
            WHERE Object = :TraceNEG.FloatEquip.Object;
         ENDIF;
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                      'You may be energizing into this ground, protective ' +
                      'connectivity trace could not be completed due to ' +
                      'incorrectly connected device: ' +
                       TraceNEG.FloatEquip.PrimaryGroupingName + '  ' +
                       TraceNEG.FloatEquip.TypeName + '  ' +
                       TraceNEG.FloatEquip.Name); 
      ENDIF;
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceNEG.ClosedOutBound IS NOT NULL THEN

      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                      'You may be energizing into this ground because ' +
                      'connectivity trace could not determine that ' +
                      'all paths have visible breaks.');

/*
                      'You may be energizing into this ground because ' +
                      'no visible break was found in direction of substation: ' +
                      TraceNEG.ClosedOutBound.PrimaryGroupingName);       
*/
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceStatus = TraceStatus$Floating OR 
           TraceStatus = TraceStatus$OutofScope THEN

      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                      'You may be energizing into this ground because ' +
                      'connectivity trace could not determine that ' +
                      'all paths have visible breaks.');

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceStatus <> TraceStatus$VisibleBreak THEN 

      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                      'You may be energizing into this ground because ' +
                      'connectivity trace could not determine that ' +
                      'all paths have visible breaks.');

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;

   RETURN(PU_OK);
END;



Application Component Report
============================

	Name:            CheckNotEnergizingGround_new

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    CAC
**  Frame:          CheckNotEnergizingGround
**
**  Date:       Author   Description
** ----------------------------------
**  11/08/11    em       converted to Check Visible Breaks and looking for all grounds
**                       in front of breaks
*/
PROCEDURE CheckNotEnergizingGround_new
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER;
    k = INTEGER;
    g = INTEGER NOT NULL WITH DEFAULT; /*Ground Equip index */
    p = INTEGER NOT NULL WITH DEFAULT; /*Perform Moves Array index */
    x = INTEGER;

    RetCode         = INTEGER;
    VisibleBreak    = INTEGER NOT NULL;

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    CloseLoop      = ConnectedEquipClass;
    GroundEquip    = ARRAY OF ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadObject  = INTEGER NOT NULL WITH DEFAULT;
    StatusDBF      = INTEGER NOT NULL WITH DEFAULT;

    ExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Objects with Breaks*/
    ExistingGrounds = ARRAY OF INTEGEROBJECT; /*List of Objects with Grounds*/
    PendingBreaks  = ARRAY OF INTEGEROBJECT; /*Objects with Pending Breaks*/
    BreakerTypes    = ARRAY OF INTEGEROBJECT; /*BREAKER/LoadBreaking device types*/
    BreakerTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    EquipGrounded = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    DisconnectTypes    = ARRAY OF INTEGEROBJECT; /*Disconnect device types*/
    DisconnectTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    LoadBreakingTypes = ARRAY OF INTEGEROBJECT; /*Load breaking device types*/
    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

    OutBoundType   = INTEGER NOT NULL;    /*Look at OutBoundTypes*/    
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    TwoPosition    = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    TwoPositionNode = INTEGER NOT NULL WITH DEFAULT; 
    TwoPositionClause = VARCHAR(100) NOT NULL WITH DEFAULT;
    GroundFoundEquip = VARCHAR(300) NOT NULL WITH DEFAULT;
) =
BEGIN
    FloatEquip = NULL;
    ClosedOutBnd = NULL;
    CloseLoop = NULL;
    GroundEquip.Clear();
    g = 0;

    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].TypeName = O.TypeName,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :JIP.Equip AND
           O.Object = T.Object AND
           T.Node > 0;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN (PU_OK);
    ENDIF;

    BreakerTypes.Clear();
    DisconnectTypes.Clear();

    i = 1;
    SELECT DISTINCT  
           :DisconnectTypes[i].Value = Type
    FROM   Udb_ExtendedType 
    WHERE  SuperType = :Type$Disconnect
    BEGIN
       i = i + 1;
    END;

    IF JIP.Status = Job$Restore THEN
       Operator = JIP.RSOperator;
    ELSE
       Operator = JIP.TOOperator;
    ENDIF;

    IF CurrentApplication = Application$TFMS THEN
       i = 1;
       SELECT DISTINCT  
              :BreakerTypes[i].Value = Type
       FROM   Udb_ExtendedType 
       WHERE  SuperType = :Type$BREAKER 
       BEGIN
          i = i + 1;
       END;
    ELSE
       i = 1;
       SELECT DISTINCT  
              :BreakerTypes[i].Value = Type
       FROM   Udb_ExtendedType 
       WHERE  SuperType IN (:Type$LoadBreaking,
                          :Type$Source,
                          :Type$SOURCE_SBFKS,
                          :Type$SOURCE_Bifur,
                          :Type$SOURCE_VISY) 
       BEGIN
          i = i + 1;
       END;
    ENDIF;
    ConnectedEquip[1].Used = FALSE;

    i = 1;
    CardObjects.Clear();
    REPEATED
    SELECT 
    DISTINCT 
            :CardObjects[i].Value = AO.Object
    FROM    SOA_ActiveObject AO,
            SOA_JobControl JC
    WHERE   JC.Job = :JIP.Job AND   
            JC.Card = AO.Card
    BEGIN
       i = i + 1;
    END;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all visible breaks and pending visible breaks
** into sorted lists which then can be searched using our bisection search.
*/
    ExistingBreaks.Clear();
    ExistingGrounds.Clear();
    PendingBreaks.Clear();
    LoadBreakingTypes.Clear();

    i = 1;        
    SELECT  DISTINCT
            :ExistingBreaks[i].Value = Object
    FROM    FMS_ObjectStatus 
    WHERE   Status IN (:Status$VisibleBreak,:Status$RO)
    BEGIN
/*
**  Ignore the visible breaks that are being removed in the set of moves being issued.
*/
       FOR p = 1 TO PerformMovesArray.LastRow() DO
          IF PerformMovesArray[p].Job = JIP.Job AND 
               PerformMovesArray[p].TORS = JIP.TORS THEN
             CONTINUE;
          ELSEIF PerformMovesArray[p].Equip = ExistingBreaks[i].Value THEN
             TwoPosition = FALSE;
             REPEATED
             SELECT :TwoPosition = 1
             FROM    FMS_JobAction JA,
                     SOA_JobControl JC,
                     SOA_ActiveCard AC
             WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                     JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                     JA.StepPair = :PerformMovesArray[p].StepPair AND
                     JA.TypeOfCard = AC.TypeOfCard AND
                     AC.Card = JC.Card AND
                     JC.Job = :PerformMovesArray[p].Job AND
                     JA.TORS = :PerformMovesArray[p].TORS AND
                     JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                     JA.Action = :JobAction$Clear AND
                     JA.Status IN (:Status$VisibleBreak,:Status$RO);

             IF TwoPosition = 1 THEN
/*
** We appear to be removing the visible break in the block of moves being issued at
** the same time, let's ignore it.
*/ 
                ExistingBreaks.RemoveRow (rownumber = i);
                i = i - 1;  /* set it back so it can be incremented and reused*/
                ENDLOOP;
             ENDIF;
          ENDIF;
       ENDFOR;          
       i = i + 1;
    END;

    i = 1;    
    REPEATED    
    SELECT DISTINCT
            :ExistingGrounds[i].Value = OS.Object
    FROM    FMS_ObjectStatus OS,
            SOA_ActiveObject AO,
            Udb_Grouping G,
            SOA_JobControl JC
    WHERE   OS.Status = :Status$Ground AND
            OS.StatusCount > 0 AND
            OS.Object = G.Member AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = AO.Object AND
            AO.Card = JC.Card AND
            JC.Job = :JIP.Job
    BEGIN
/*
**  If current device has ground, look for two-position prompt that
**  removes the ground, then ignore ground if prompt exists.
*/
       IF JIP.Equip = ExistingGrounds[i].Value THEN
          TwoPosition = FALSE;
          REPEATED
          SELECT :TwoPosition = 1
          FROM    FMS_JobAction JA,
                  SOA_JobControl JC,
                  SOA_ActiveCard AC
          WHERE   JA.JobClass = :JIP.JobClass AND
                  JA.EquipClass = :JIP.MoveEquipClass AND
                  JA.StepPair = :JIP.StepPair AND
                  JA.TypeOfCard = AC.TypeOfCard AND
                  AC.Card = JC.Card AND
                  JC.Job = :JIP.Job AND
                  JA.TORS = :JIP.TORS AND
                  JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                  JA.Action = :JobAction$Prompt AND
                  JA.Status = :Prompt$RemoveGroundBkrSide;
          
          IF TwoPosition = 1 THEN
             ExistingGrounds.RemoveRow (rownumber = i);
             i = i - 1;  /* set it back so it can be incremented and reused*/
          ELSE
/*
** And also Check for Pending Ground Removal on this device.
*/
             k = 0;
             SELECT  :k = Object
             FROM    FMS_PendingStatus 
             WHERE   Object = :JIP.Equip AND
                     PendingStatus = :Status$Ground AND
                     StatusCount = 0 AND
                     IssuedOperator = :Operator;

             IF k = JIP.Equip THEN
                ExistingGrounds.RemoveRow (rownumber = i);
                i = i - 1;  /* set it back so it can be incremented and reused*/
             ENDIF;
          ENDIF;
       ENDIF;
       i = i + 1;
    END;

/*
**  Make sure current equipment is not in grounded list.  
**  
*/
    EquipGrounded = FALSE;
    EquipGrounded = CALLPROC ArraySearch(
                             SearchArray = ExistingGrounds,
                             TargetObject = JIP.Equip);

    IF EquipGrounded = TRUE THEN
       g = g + 1;
       GroundEquip.InsertRow (RowNumber = g, RowObject = ConnectedEquip[1]);
    ENDIF; 

    i = 1;
    SELECT  DISTINCT
            :PendingBreaks[i].Value = Object
    FROM    FMS_PendingStatus 
    WHERE   PendingStatus IN (:Status$VisibleBreak, :Status$RO) AND
            StatusCount > 0 AND
            IssuedOperator = :Operator
    BEGIN
       i = i + 1;
    END;

/*
** If we are operating on a Two Position Switch, extend the Pending Breaks based on the 
** PerformMovesArray.  We are expecting both two position switches for the breaker to be
** operated in the same order.
*/
    TwoPositionNode = 0;
    TwoPositionClause = '';
    IF JIP.EquipClass = Type$DiscGrdBkr THEN

       FOR p = 1 TO PerformMovesArray.LastRow() DO

             TwoPosition = FALSE;
             REPEATED
             SELECT :TwoPosition = 1
             FROM    FMS_JobAction JA,
                     SOA_JobControl JC,
                     SOA_ActiveCard AC
             WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                     JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                     JA.StepPair = :PerformMovesArray[p].StepPair AND
                     JA.TypeOfCard = AC.TypeOfCard AND
                     AC.Card = JC.Card AND
                     JC.Job = :PerformMovesArray[p].Job AND
                     JA.TORS = :PerformMovesArray[p].TORS AND
                     JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                     JA.Action = :JobAction$Set AND
                     JA.Status IN (:Status$VisibleBreak,:Status$RO);

             IF TwoPosition = 1 THEN
/*
** Insert new entry in PendingBreaks in appropriate numerical slot.
*/ 
                i = 1;
                WHILE i <= PendingBreaks.LastRow() DO
                   IF PendingBreaks[i].VALUE = PerformMovesArray[p].Equip THEN
                      /* Already Exists in Array */
                      i = 0;
                      ENDLOOP;
                   ENDIF;
                   IF i = 1 THEN
                      IF PerformMovesArray[p].Equip < PendingBreaks[i].VALUE THEN
                         ENDLOOP;
                      ENDIF;
                   ELSEIF PerformMovesArray[p].Equip < PendingBreaks[i].VALUE AND
                          PerformMovesArray[p].Equip > PendingBreaks[i-1].VALUE THEN
                      ENDLOOP;
                   ENDIF;
                   i = i + 1;
                ENDWHILE;
                
                IF i <> 0 THEN
                   PendingBreaks.InsertRow (rownumber = i);
                   PendingBreaks[i].Value = PerformMovesArray[p].Equip;
                ENDIF;
             ENDIF;
       ENDFOR;        
/*
**  Now we need to also start trace on Bkr side of Two Position Switch.
*/ 
       SELECT :TwoPositionNode = T1.Node
       FROM   Udb_Terminal T1,
              Udb_Terminal T2,
              Udb_Object O
       WHERE  T1.Object = :JIP.Equip AND
              T1.Node > 20000 AND
              T1.Node = T2.Node AND
              T2.Node > 20000 AND
              T2.Object = O.Object AND
              O.Type IN (SELECT Type FROM Udb_ExtendedType
                         WHERE  SuperType = :Type$Bkr);
              
       IF TwoPositionNode > 20000 THEN
          TwoPositionClause = 'T1.Node = ' + VARCHAR(TwoPositionNode) + ' AND ';
       ENDIF;
    ENDIF;        

    i = 1;
    SELECT  DISTINCT
            :LoadBreakingTypes[i].Value = Type
    FROM    Udb_ExtendedType 
    WHERE   SuperType IN (:Type$LoadBreaking,
                          :Type$Source,
                          :Type$SOURCE_SBFKS,
                          :Type$SOURCE_Bifur,
                          :Type$SOURCE_VISY) 
    BEGIN
       i = i + 1;
    END;

    i = 1;
    SELECT  DISTINCT
            :DisconnectTypes[i].Value = Type
    FROM    Udb_ExtendedType 
    WHERE   SuperType = :Type$Disconnect 
    BEGIN
       i = i + 1;
    END;

    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';

    DynamicWhereClause = StaticWhereClause + TwoPositionClause +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
/*
** start search with this piece of equipment and then branch out in all
** directions. For every set of connected equipment, we count the number of
** paths with visible breaks and the number of closed paths. If all paths 
** have visible breaks, return OK status.
** However, if all equipment have been checked , and either the number of
** closed paths is less than the previous closed paths or some floating
** equipment are found, the focused equipment can be alive. Give warning
** in the this case.  
*/
    FloatEquip = NULL;
    ClosedOutBnd = NULL;
    CloseLoop  = NULL;

    i = 1;
    MoreObjects = TRUE;
    ClosedPaths = 0;

    WHILE MoreObjects = TRUE DO

      PrevClosedPaths = ClosedPaths;
      ClosedPaths = 0;
      OpenedPaths = 0;

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            
      CALLPROC DDB_ROLLBACK;

      MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO

        IF ConnectedEquip[x].Used = FALSE THEN
           FloatFound = TRUE;
           k = 1;
           WHILE k <= TempEquip.LastRow() DO
             IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                FloatFound = FALSE;
                ENDLOOP;
             ENDIF;
             k = k + 1;
           ENDWHILE;

           IF FloatFound = TRUE THEN  /* OK if single terminal device */

              IF ConnectedEquip[x].Terminals = 1 THEN    
/*
** If we have reached FdrLoad check for DBF, re-use FloatEquip to track FdrLoad
*/
                 IF ConnectedEquip[x].Type = Type$FdrLoad THEN

                    SELECT :FdrLoadFeeder = O.Name,
                           :FdrLoadObject = O.Object
                    FROM   Udb_Object O,
                           Udb_Grouping G
                    WHERE  G.Member = :ConnectedEquip[x].Object AND
                           G.Relationship = :Interaction$MemberOf AND
                           G.Grouping = O.Object AND
                           O.Type IN (SELECT Type FROM Udb_ExtendedType
                                      WHERE  SuperType = :Type$Feeder);

                    StatusDBF = 0;
                    SELECT :StatusDBF = Status
                    FROM   FMS_ObjectStatus
                    WHERE  Object = :FdrLoadObject AND
                           Status = :Status$DBF AND
                           StatusCount > 0;
 
                    IF StatusDBF = 0 THEN
/*
** No DBF, Check for CutOut Feeder, If CutOut then present warning.
*/
                       SELECT :StatusDBF = Status
                       FROM   FMS_ObjectStatus
                       WHERE  Object = :FdrLoadObject AND
                              Status = :Status$CO AND
                              StatusCount > 0;
             
                       IF StatusDBF = 0 THEN  /* No DBF, No CutOut, consider path open */
                          OpenedPaths = OpenedPaths + 1;
                       ELSE  /* No DBF, but CutOut with No Visible Break, then give warning */
                          FloatEquip = ConnectedEquip[x].Duplicate();    
                       ENDIF;
                    ELSE
                       OpenedPaths = OpenedPaths + 1;
                    ENDIF;
                          
                 ELSE                              
                    OpenedPaths = OpenedPaths + 1;
                 ENDIF;
              ELSE 
                 FloatEquip = ConnectedEquip[x].Duplicate();     
              ENDIF;
           ENDIF;
        ENDIF;

        ConnectedEquip[x].Used = TRUE;
        x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      /* check for visible break. */
      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;

         VisibleBreak = FALSE;
         VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = ExistingBreaks,
                                    TargetObject = TempEquip[x].Object);

         IF VisibleBreak = FALSE THEN

               VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = PendingBreaks,
                                    TargetObject = TempEquip[x].Object);
         ENDIF;

         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */

            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN

               IF VisibleBreak = FALSE THEN
/*  IGNORE Closed Loop
                  CloseLoop = ConnectedEquip[k].Duplicate();
*/
               /* if this equip is in the next objectclause, remove it */
                  CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
               ENDIF;
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  

         ELSE                     /* new equip */

            IF VisibleBreak = TRUE THEN      
/*
** If Visible Break found, we still need to look at the connected terminal
** to see if a ground was placed there.  If so, we hit the ground first and 
** can proceed as if we hit that ground and ignore the visible break.  If the 
** ground is on the object - Terminal 0 - we will recognize the visible break 
** first and ignore the ground.
*/             
               EquipGrounded = FALSE;
               SELECT :EquipGrounded = :TRUE
               FROM   FMS_ObjectStatus
               WHERE  Object = :TempEquip[x].Object AND
                      Terminal = :TempEquip[x].Terminal AND
                      Status = :Status$Ground AND
                      StatusCount > 0;

               IF EquipGrounded = TRUE THEN
/*
**  If we find a ground we then look for a appropriate move in the new
**  PerformMovesArray Global to see if we might be removing that ground.
*/
                    FOR p = 1 TO PerformMovesArray.LastRow() DO
                       IF PerformMovesArray[p].Equip = TempEquip[x].Object THEN
                          TwoPosition = FALSE;
                          REPEATED
                          SELECT :TwoPosition = 1
                          FROM    FMS_JobAction JA,
                                  SOA_JobControl JC,
                                  SOA_ActiveCard AC
                          WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                                  JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                                  JA.StepPair = :PerformMovesArray[p].StepPair AND
                                  JA.TypeOfCard = AC.TypeOfCard AND
                                  AC.Card = JC.Card AND
                                  JC.Job = :PerformMovesArray[p].Job AND
                                  JA.TORS = :PerformMovesArray[p].TORS AND
                                  JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                                  JA.Action = :JobAction$Prompt AND
                                  JA.Status = :Prompt$RemoveGroundBkrSide;

                          IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's ignore this ground.
*/ 
                             EquipGrounded = FALSE;
                          ENDIF;
                       ENDIF;
                    ENDFOR;    
               ENDIF;      
            ELSE

               EquipGrounded = CALLPROC ArraySearch(
                                    SearchArray = ExistingGrounds,
                                    TargetObject = TempEquip[x].Object);
/*
**  If we find a ground we then look for a appropriate move in the new
**  PerformMovesArray Global to see if we might be removing that ground.
*/
               IF EquipGrounded = TRUE THEN
                  FOR p = 1 TO PerformMovesArray.LastRow() DO
                    IF PerformMovesArray[p].Equip = TempEquip[x].Object THEN
                      TwoPosition = FALSE;
                      REPEATED
                      SELECT :TwoPosition = 1
                      FROM    FMS_JobAction JA,
                              SOA_JobControl JC,
                              SOA_ActiveCard AC
                      WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                              JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                              JA.StepPair = :PerformMovesArray[p].StepPair AND
                              JA.TypeOfCard = AC.TypeOfCard AND
                              AC.Card = JC.Card AND
                              JC.Job = :PerformMovesArray[p].Job AND
                              JA.TORS = :PerformMovesArray[p].TORS AND
                              JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                              JA.Action = :JobAction$Prompt AND
                              JA.Status = :Prompt$RemoveGroundBkrSide;

                      IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's ignore this ground.
*/ 
                         EquipGrounded = FALSE;
                      ENDIF;
                    ENDIF;
                  ENDFOR;          
               ENDIF;
            ENDIF;
/*
**  Count Ground if Grounded
*/
            IF EquipGrounded = TRUE THEN
               g = g + 1;
               GroundEquip.InsertRow (RowNumber = g, RowObject = TempEquip[x]);
            ENDIF; 
/*
**  If Visible Break found, go ahead and stop search on this leg.
*/
            
            IF VisibleBreak = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;
                  OpenedPaths = OpenedPaths + 1;
            ELSE
                  i = i + 1;
                  ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());

                  ClosedPaths = ClosedPaths + 1;
                  ConnectedScope = TRUE;
                  ConnectedScope = CALLPROC ArraySearch(
                             SearchArray = CardObjects,
                             TargetObject = ConnectedEquip[i].PrimaryGrouping);

                  IF ConnectedScope = FALSE THEN
/*
** Need to extend search to first outbound disconnect in neighboring substation,
** which is the first disconnect after the first breaker.  Will go no further 
** than a depth of ten.  Need to find previous object to determine where
** we are.
*/
                     ConnectedEquip[i].OutBound = TRUE;
                     o = 1;  
                     WHILE o < i DO
                        IF ConnectedEquip[o].Object = 
                               ConnectedEquip[i].PrevObject THEN

                           ConnectedEquip[i].OutBoundDepth =
                               ConnectedEquip[o].OutBoundDepth + 1;

                           IF ConnectedEquip[o].OutBoundBreakerFound = TRUE THEN
                              ConnectedEquip[i].OutBoundBreakerFound = TRUE;                                                    
/*
**  Is it a disconnect?
*/
                              DisconnectTypeFound = FALSE;
                              DisconnectTypeFound = CALLPROC ArraySearch(
                                    SearchArray = DisconnectTypes,
                                    TargetObject = ConnectedEquip[i].Type);
/*
**  If this is the OutBound disconnect or we have gone further than ten deep,
**  we have gone far enough - consider OutBound closed.
*/
                              IF DisconnectTypeFound = TRUE OR
                                 ConnectedEquip[i].OutBoundDepth > 10 THEN 

                                 ConnectedEquip[i].Used = TRUE;
                                 ClosedOutBnd = ConnectedEquip[i].Duplicate();

                              ELSE
                                 ConnectedEquip[i].Used = FALSE;
                              ENDIF;
                           ELSE

                              ConnectedEquip[i].Used = FALSE;
                              BreakerTypeFound = FALSE;
/*
**  Is it a breaker type?
*/
                              BreakerTypeFound = CALLPROC ArraySearch(
                                    SearchArray = LoadBreakingTypes,
                                    TargetObject = ConnectedEquip[i].Type);

                              IF BreakerTypeFound = TRUE THEN
                                 ConnectedEquip[i].OutBoundBreakerFound = TRUE;
                              ENDIF;
                           ENDIF;
                           ENDLOOP;                                                      
                        ENDIF;
                        o = o + 1;
                     ENDWHILE;                   

                     IF o = i THEN  /*Problem finding previous object */
                        ConnectedEquip[i].Used = TRUE;
                        ClosedOutBnd = ConnectedEquip[i].Duplicate();
                     ENDIF;     
                  ENDIF;
            ENDIF;

            IF ConnectedEquip[i].Used = FALSE THEN
                CALLPROC InsertValue (ValueList = IncludedObjects, 
                                    Value = ConnectedEquip[i].Object);
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipment */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

      IF FloatEquip IS NOT NULL OR
         ClosedOutBnd IS NOT NULL OR
         CloseLoop  IS NOT NULL THEN
         MoreObjects = FALSE;
      ENDIF;   
    ENDWHILE;
/*
** If no Ground found then we exit.
*/
    IF GroundEquip.LastRow() = 0 THEN
       RETURN(PU_OK);
    ELSE
       FOR p = 1 TO GroundEquip.LastRow() DO
          IF p > 1 THEN
             GroundFoundEquip = GroundFoundEquip + ',';
          ENDIF;
          GroundFoundEquip = GroundFoundEquip + 
                             GroundEquip[p].PrimaryGroupingName + ' ' +
                             GroundEquip[p].TypeName + ' ' +
                             GroundEquip[p].Name;
       ENDFOR;
    ENDIF;

    IF FloatEquip IS NOT NULL THEN
/*
** Float Equip may indicated unconnected two terminal error or Fdr Load.
*/
       IF FloatEquip.Type = Type$FdrLoad THEN

          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                       'You are attempting to remove a visible break that is necessary ' +
                       'to support this ground.');
       ELSE
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                       'You may be energizing into this ground, protective ' +
                       'connectivity trace could not be completed due to ' +
                       'incorrectly connected device: ' +
                        FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' +
                        FloatEquip.Name); 
       ENDIF;
    
       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF ClosedOutBnd IS NOT NULL THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                       'You may be energizing into this ground because ' +
                       'no visible break was found in direction of substation: ' +
                       ClosedOutBnd.PrimaryGroupingName);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF CloseLoop  IS NOT NULL OR
           PrevClosedPaths > OpenedPaths  THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + GroundFoundEquip + HC_NEWLINE +
                       'You may be energizing into this ground because ' +
                       'connectivity trace could not determine that ' +
                       'all paths have visible breaks.');

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;

    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckNotEnergizingGround_old

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    SOA
**  Frame:          CheckNotEnergizingGround
**
**  Date:       Author   Description
** ----------------------------------
**  03/10/99    em       Created
**  03/19/99    em       Modify retracement code to start at original equipment,
**                       with the assumption that nothing between the device
**                       being closed and the ground is energized.  Trace the
**                       reverse direction from the original equipment.
**  05/06/99    em       Extended search to look as far as outbound disconnect
**                       or depth of five in neighboring substation.
**  07/08/99    em       Commented out Confirm at the end - now they don't want
**                       it.
**  09/15/99    em       Stop trace on single terminal device instead of
**                       Gnd-Sw.
**  11/17/99    em       Add PrimaryGrouping Name to Warning
**  05/31/00    em       When finding open device, look for ground on
**                       connecting terminal (since that terminal is still
**                       involved in connectivity).
**  10/25/00    em       Reverse trace from Ground to find first exclude node
**                       needs to stay on a direct path, going back through 
**                       all connected equip includes the other path.  If other
**                       path is chosen (50% possibility) in this erroneous 
**                       state, the second trace will immediately come back to
**                       the ground and not present warning.
**  11/28/00    em       Add Substation Name (Primary Grouping) to all warning
**                       messages.  
**  11/26/02    pkw      Change Job to JIP for Merge.
**  01/24/03    em       Use scope of Job on all cards to select Active Objects
**                       instead of limiting scope to current job's card.  Check
**                       reacts differently if performed from SLC vs. TFMS when
**                       limiting to current card.
**  02/27/03    em       Don't limit scope of neighboring substation to five
**                       devices.  Go until OutBoard Disconnect.  Use logic
**                       from outboard disconnect search in the Scenario Trace
**                       to determine how far to go.  Breaker type to stop on
**                       depends on type of card.
**  03/07/03    em       Include other cards in selection of ExistingGrounds.
**                       Before issuing warning at bottom, check equipment type
**                       using new frame call, if it is a BPD or CCPD Ground
**                       and the DO chooses to leave it, we repeat the trace 
**                       after setting a visible break status to ignore the
**                       BPD/CCPD. 
**  02/16/04    em       Ignore BPD/CCPD prompt during automatic execution. 
**                       Warning will occur unless visible breaks are created
**                       prior to this check. 
**  07/22/05    em       If the current equip is grounded, check if the current
**                       move is also removing the ground using the Two-Position
**                       Switch Remove Ground Prompt.  If so, ignore the ground. 
**  09/02/05    em       Additional customization for the two position switch
**                       need to look at all moves on the Perform Moves screen
**                       to see if any found ground is being removed using
**                       the special PromptRemoveGrdBkrSide.  Ignore any ground
**                       that is being removed in the same set of moves.
**  09/07/05    em       Add further check when finding Visible Break, use same
**                       PerformMoves array to see if visible break is being 
**                       as part of the set of moves.
**  11/16/05    em       Limited Visible Break Warning to display just the 
**                       directional substation, neighbor depth to ten.
**  12/16/05    em       When looking through the PerformMovesArray for Visible Break,
**                       ignore current move.
**  02/15/06    em       Feeder Load is not treated as a Visible Break.  B/O status will not be considered a visible break.
**  02/01/07    em       When looking for grounds, consider pending status of current
**                       equipment.  Needed to prevent warning when issuing FMS Connected
**                       Source moves.
**  05/29/07    ysp      Fixed array index error by ending the loop after removing the 
**                       visible break in the block.
**  11/13/07    em       Changed warning message when hitting Fdr Load.
**  07/16/08    em       Removed certain ORDER BY on selects that had distinct
**                       just in case these case the periodic SQL 'order' run time
**                       error.
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**
*/
PROCEDURE CheckNotEnergizingGround_old
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER;
    k = INTEGER;
    x = INTEGER;
    p = INTEGER NOT NULL WITH DEFAULT;  /*PerformMovesArray index*/

    RetCode         = INTEGER;
    ReturnStatus    = INTEGER NOT NULL WITH DEFAULT;
    VisibleBreak    = INTEGER NOT NULL;

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    CloseLoop      = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    GroundEquip    = ConnectedEquipClass;
    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
              
    ExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Objects with Breaks*/
    ExistingGrounds = ARRAY OF INTEGEROBJECT; /*List of Objects with Grounds*/
    BreakerTypes    = ARRAY OF INTEGEROBJECT; /*BREAKER/LoadBreaking device types*/
    BreakerTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    DisconnectTypes    = ARRAY OF INTEGEROBJECT; /*Disconnect device types*/
    DisconnectTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    EquipGrounded  = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    GroundedTerminal = INTEGER NOT NULL WITH DEFAULT; /*Which side?*/
    GroundedNode   = INTEGER NOT NULL WITH DEFAULT; /*Trace away to other side*/

    o              = INTEGER NOT NULL;    /*OutBound counter*/

    PrevObject 	   = INTEGER NOT NULL;    /*Backward Trace Object*/
    ConnectingNode = INTEGER NOT NULL;    /*Backward Trace Connecting Node*/
    TwoPosition    = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
) =
BEGIN
    FloatEquip = NULL;
    ClosedOutBnd = NULL;
    CloseLoop = NULL;
    GroundEquip = NULL;

    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :JIP.Equip AND
           O.Object = T.Object AND
           T.Node > 0;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN (PU_OK);
    ENDIF;

    BreakerTypes.Clear();
    DisconnectTypes.Clear();

    i = 1;
    SELECT DISTINCT  
           :DisconnectTypes[i].Value = Type
    FROM   Udb_ExtendedType 
    WHERE  SuperType = :Type$Disconnect
    BEGIN
       i = i + 1;
    END;

    IF JIP.Status = Job$Restore THEN
       Operator = JIP.RSOperator;
    ELSE
       Operator = JIP.TOOperator;
    ENDIF;

    IF CurrentApplication = Application$TFMS THEN
       i = 1;
       SELECT DISTINCT  
              :BreakerTypes[i].Value = Type
       FROM   Udb_ExtendedType 
       WHERE  SuperType = :Type$BREAKER 
       BEGIN
          i = i + 1;
       END;
    ELSE
       i = 1;
       SELECT DISTINCT  
              :BreakerTypes[i].Value = Type
       FROM   Udb_ExtendedType 
       WHERE  SuperType IN (:Type$LoadBreaking,
                          :Type$Source,
                          :Type$SOURCE_SBFKS,
                          :Type$SOURCE_Bifur,
                          :Type$SOURCE_VISY) 
       BEGIN
          i = i + 1;
       END;
    ENDIF;
    ConnectedEquip[1].Used = FALSE;

    i = 1;
    CardObjects.Clear();
    REPEATED
    SELECT 
    DISTINCT 
            :CardObjects[i].Value = AO.Object
    FROM    SOA_ActiveObject AO,
            SOA_JobControl JC
    WHERE   JC.Job = :JIP.Job AND   
            JC.Card = AO.Card
    BEGIN
       i = i + 1;
    END;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all visible breaks and grounds
** into sorted lists which then can be searched using our bisection search.
*/
    ExistingBreaks.Clear();
    ExistingGrounds.Clear();

    i = 1;        
    SELECT  DISTINCT
            :ExistingBreaks[i].Value = Object
    FROM    FMS_ObjectStatus 
    WHERE   Status IN (:Status$VisibleBreak,:Status$RO)
    BEGIN
/*
**  Ignore the visible breaks that are being removed in the set of moves being issued.
*/
       FOR p = 1 TO PerformMovesArray.LastRow() DO
          IF PerformMovesArray[p].Job = JIP.Job AND 
               PerformMovesArray[p].TORS = JIP.TORS THEN
             CONTINUE;
          ELSEIF PerformMovesArray[p].Equip = ExistingBreaks[i].Value THEN
             TwoPosition = FALSE;
             REPEATED
             SELECT :TwoPosition = 1
             FROM    FMS_JobAction JA,
                     SOA_JobControl JC,
                     SOA_ActiveCard AC
             WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                     JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                     JA.StepPair = :PerformMovesArray[p].StepPair AND
                     JA.TypeOfCard = AC.TypeOfCard AND
                     AC.Card = JC.Card AND
                     JC.Job = :PerformMovesArray[p].Job AND
                     JA.TORS = :PerformMovesArray[p].TORS AND
                     JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                     JA.Action = :JobAction$Clear AND
                     JA.Status IN (:Status$VisibleBreak,:Status$RO);

             IF TwoPosition = 1 THEN
/*
** We appear to be removing the visible break in the block of moves being issued at
** the same time, let's ignore it.
*/ 
                ExistingBreaks.RemoveRow (rownumber = i);
                i = i - 1;  /* set it back so it can be incremented and reused*/
                ENDLOOP;
             ENDIF;
          ENDIF;
       ENDFOR;          
       i = i + 1;
    END;

    i = 1;    
    REPEATED    
    SELECT DISTINCT
            :ExistingGrounds[i].Value = OS.Object
    FROM    FMS_ObjectStatus OS,
            SOA_ActiveObject AO,
            Udb_Grouping G,
            SOA_JobControl JC
    WHERE   OS.Status = :Status$Ground AND
            OS.StatusCount > 0 AND
            OS.Object = G.Member AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = AO.Object AND
            AO.Card = JC.Card AND
            JC.Job = :JIP.Job
    BEGIN
/*
**  If current device has ground, look for two-position prompt that
**  removes the ground, then ignore ground if prompt exists.
*/
       IF JIP.Equip = ExistingGrounds[i].Value THEN
          TwoPosition = FALSE;
          REPEATED
          SELECT :TwoPosition = 1
          FROM    FMS_JobAction JA,
                  SOA_JobControl JC,
                  SOA_ActiveCard AC
          WHERE   JA.JobClass = :JIP.JobClass AND
                  JA.EquipClass = :JIP.MoveEquipClass AND
                  JA.StepPair = :JIP.StepPair AND
                  JA.TypeOfCard = AC.TypeOfCard AND
                  AC.Card = JC.Card AND
                  JC.Job = :JIP.Job AND
                  JA.TORS = :JIP.TORS AND
                  JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                  JA.Action = :JobAction$Prompt AND
                  JA.Status = :Prompt$RemoveGroundBkrSide;
          
          IF TwoPosition = 1 THEN
             ExistingGrounds.RemoveRow (rownumber = i);
             i = i - 1;  /* set it back so it can be incremented and reused*/
          ELSE
/*
** And also Check for Pending Ground Removal on this device.
*/
             k = 0;
             SELECT  :k = Object
             FROM    FMS_PendingStatus 
             WHERE   Object = :JIP.Equip AND
                     PendingStatus = :Status$Ground AND
                     StatusCount = 0 AND
                     IssuedOperator = :Operator;

             IF k = JIP.Equip THEN
                ExistingGrounds.RemoveRow (rownumber = i);
                i = i - 1;  /* set it back so it can be incremented and reused*/
             ENDIF;
          ENDIF;
       ENDIF;
       i = i + 1;
    END;
/*
**  Build first part of where clause, second part depends if current equip
**  grounded.
*/
    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';
/*
**  Make sure current equipment is not in grounded list.  If so, direct trace in **  opposite direction of grounded terminal.  If ground on terminal 0, produce **  error, don't know what to do in that situation.
*/
    EquipGrounded = FALSE;
    EquipGrounded = CALLPROC ArraySearch(
                             SearchArray = ExistingGrounds,
                             TargetObject = JIP.Equip);

    IF EquipGrounded = TRUE THEN
       SELECT GroundedTerminal = COUNT(*) 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND
              Terminal = 0;
       IF GroundedTerminal > 0 THEN
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                       Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem, 
                 Text = 'Equipment you are closing has a terminal ' +
                        'indeterminant ground on it.  Cannot perform ' +
                        'adequate connectivity trace to determine if line ' +
                        'is energized.');

          IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RETURN(Warning$Overridden);
          ENDIF;
       ENDIF;
/*
**  Just for fun, check if both terminals are grounded.  If so, okay to close,
**  otherwise point direction of search in the opposite direction.
*/
       k = 0;
       SELECT :k = COUNT(*)                                 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND
              StatusCount > 0 AND
              Terminal = 1;
       x = 0;
       SELECT :x = COUNT(*)                                 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND
              StatusCount > 0 AND
              Terminal = 2;
       IF x > 0 AND k > 0 THEN
          RETURN(PU_OK);
       ELSEIF k > 0 THEN
          GroundedTerminal = 1; 
       ELSEIF x > 0 THEN 
          GroundedTerminal = 2;
       ELSE
          GroundedTerminal = 0;  /*Terminals number not 1 or 2*/
       ENDIF;

       SELECT :GroundedNode = Node
       FROM   Udb_Terminal
       WHERE  Object = :JIP.Equip AND
              Terminal = :GroundedTerminal;

       MoreObjects = FALSE;  /* Already found ground do second search only*/
       DynamicWhereClause = StaticWhereClause + 
                         'T1.Node <> ' + VARCHAR(GroundedNode) + ' AND ' +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
       GroundEquip = ConnectedEquip[1].Duplicate();

    ELSE  /* Job Equipment not grounded. */

       MoreObjects = TRUE;
       DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
    ENDIF;
/*
** start search with this piece of equipment and then branch out in all
** directions. For every piece of connected equipment, we check for a ground.
** If a ground is found, we turn around and reverse search looking for closed
** paths (indicating energization).  If we hit nothing but visible breaks or
** grounded devices, are okay.
*/
    i = 1;
    WHILE MoreObjects = TRUE DO

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          TempEquip[x].OutBound = FALSE;
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            

      MoreObjects = FALSE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      /* check for ground or visible break */
      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
               /* if this equip is in the next objectclause, remove it */
               CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  
         ELSE                                    /* new equip */
           
            VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = ExistingBreaks,
                                    TargetObject = TempEquip[x].Object);

/*
** If Visible Break found, we still need to look at the connected terminal
** to see if a ground was placed there.  If so, we hit the ground first and 
** can proceed as if we hit that ground and ignore the visible break.  If the 
** ground is on the object - Terminal 0 - we will recognize the visible break 
** first and ignore the ground.
*/ 
            IF VisibleBreak = TRUE THEN
 
               EquipGrounded = FALSE;
               SELECT :EquipGrounded = :TRUE
               FROM   FMS_ObjectStatus
               WHERE  Object = :TempEquip[x].Object AND
                      Terminal = :TempEquip[x].Terminal AND
                      Status = :Status$Ground AND
                      StatusCount > 0;

               IF EquipGrounded = TRUE THEN
                  VisibleBreak = FALSE;
/*
**  If we find a ground we then look for a appropriate move in the new
**  PerformMovesArray Global to see if we might be removing that ground.
*/
                  IF EquipGrounded = TRUE THEN
                    FOR p = 1 TO PerformMovesArray.LastRow() DO
                       IF PerformMovesArray[p].Equip = TempEquip[x].Object THEN
                          TwoPosition = FALSE;
                          REPEATED
                          SELECT :TwoPosition = 1
                          FROM    FMS_JobAction JA,
                                  SOA_JobControl JC,
                                  SOA_ActiveCard AC
                          WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                                  JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                                  JA.StepPair = :PerformMovesArray[p].StepPair AND
                                  JA.TypeOfCard = AC.TypeOfCard AND
                                  AC.Card = JC.Card AND
                                  JC.Job = :PerformMovesArray[p].Job AND
                                  JA.TORS = :PerformMovesArray[p].TORS AND
                                  JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                                  JA.Action = :JobAction$Prompt AND
                                  JA.Status = :Prompt$RemoveGroundBkrSide;

                          IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's ignore this ground.
*/ 
                             EquipGrounded = FALSE;
                          ENDIF;
                       ENDIF;
                    ENDFOR;          
                  ENDIF;
               ENDIF;

            ELSE

               EquipGrounded = CALLPROC ArraySearch(
                                    SearchArray = ExistingGrounds,
                                    TargetObject = TempEquip[x].Object);
/*
**  If we find a ground we then look for a appropriate move in the new
**  PerformMovesArray Global to see if we might be removing that ground.
*/
               IF EquipGrounded = TRUE THEN
                  FOR p = 1 TO PerformMovesArray.LastRow() DO
                    IF PerformMovesArray[p].Equip = TempEquip[x].Object THEN
                      TwoPosition = FALSE;
                      REPEATED
                      SELECT :TwoPosition = 1
                      FROM    FMS_JobAction JA,
                              SOA_JobControl JC,
                              SOA_ActiveCard AC
                      WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                              JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                              JA.StepPair = :PerformMovesArray[p].StepPair AND
                              JA.TypeOfCard = AC.TypeOfCard AND
                              AC.Card = JC.Card AND
                              JC.Job = :PerformMovesArray[p].Job AND
                              JA.TORS = :PerformMovesArray[p].TORS AND
                              JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                              JA.Action = :JobAction$Prompt AND
                              JA.Status = :Prompt$RemoveGroundBkrSide;

                      IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's ignore this ground.
*/ 
                         EquipGrounded = FALSE;
                      ENDIF;
                    ENDIF;
                  ENDFOR;          
               ENDIF;
            ENDIF;
/*
**  If Visible Break found, go ahead and stop search on this leg.
*/
            IF VisibleBreak = FALSE THEN

               IF EquipGrounded = TRUE THEN
/*  
**  Reverse Search; go back through connected equip to first one, then trace the
**  other direction, away from the node between the first equip and this 
**  direction. 
*/
                  MoreObjects = FALSE;
                  IncludedObjects.Clear();
                  ExcludedNodes.Clear();
                  GroundEquip = TempEquip[x].Duplicate();

                  k = ConnectedEquip.LastRow();
                  IF k = 1 THEN
                     CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                           Value = TempEquip[x].Node);
                  ELSE      
/*
** Trace back to previous object until beginning, starting from current object.
*/                     
                     PrevObject = TempEquip[x].PrevObject; 
                     ConnectingNode = TempEquip[x].Node;                   
                     WHILE k >= 1 DO
                        IF PrevObject = ConnectedEquip[k].Object THEN
                           IF k = 1 THEN
                              CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                              Value = ConnectingNode);
                           ELSE
                              PrevObject = ConnectedEquip[k].PrevObject;
                              ConnectingNode = ConnectedEquip[k].Node;
                           ENDIF;
                        ENDIF;
                        k = k - 1;
                     ENDWHILE;

                     IF ExcludedNodes.LastRow() = 0 THEN
                        RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                                    Text = 'Ground Found at: ' + 
                                GroundEquip.PrimaryGroupingName + ' ' + 
                                GroundEquip.TypeName + ' ' + 
                                GroundEquip.Name + '.' + HC_NEWLINE +
                               'Backward trace looking for energization has ' +
                               'failed.  This is possibly due to a database ' +
                          'connectivity validation error.  You must manually ' +
                               'confirm that you are not ' +
                               'energizing into a ground.');
 
                        IF RetCode = PU_CANCEL THEN
                           RETURN(PU_CANCEL);
                        ELSE
                           RETURN(Warning$Overridden);
                        ENDIF;
                     ENDIF;
                  ENDIF;

                  DynamicWhereClause = StaticWhereClause + ' T1.Node <> ' +
                            VARCHAR(ExcludedNodes[1].Value) + 
                            ' AND T1.Object = ' +  
                            VARCHAR(ConnectedEquip[1].Object); 

                  ExcludedNodes.Clear();
                  ConnectedEquip.Clear();
                  ENDLOOP;

               ELSE
                  MoreObjects = TRUE;
                  i = i + 1;
                  ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());

                  ConnectedScope = TRUE;
                  ConnectedScope = CALLPROC ArraySearch(
                                    SearchArray = CardObjects,
                             TargetObject = ConnectedEquip[i].PrimaryGrouping);
                  IF ConnectedScope = TRUE THEN

                        ConnectedEquip[i].Used = TRUE;
                        CALLPROC InsertValue (ValueList = IncludedObjects, 
                                    Value = ConnectedEquip[i].Object);
                  ELSE
/* 
**  Continue Search until Outbound disconnect or depth of ten in neighboring
**  station.
*/
                     ConnectedEquip[i].OutBound = TRUE;
                     o = 1;  
                     WHILE o < i DO
                        IF ConnectedEquip[o].Object = 
                               ConnectedEquip[i].PrevObject THEN

                           ConnectedEquip[i].OutBoundDepth =
                               ConnectedEquip[o].OutBoundDepth + 1;

                           IF ConnectedEquip[o].OutBoundBreakerFound = TRUE THEN
                              ConnectedEquip[i].OutBoundBreakerFound = TRUE;                           
                           
                              DisconnectTypeFound = FALSE;
                              DisconnectTypeFound = CALLPROC ArraySearch(
                                    SearchArray = DisconnectTypes,
                                    TargetObject = ConnectedEquip[i].Type);
/*
**  If this is the OutBound disconnect or we have gone further than ten deep,
**  we have gone far enough - consider OutBound closed.
*/
                              IF DisconnectTypeFound = TRUE OR
                                 ConnectedEquip[i].OutBoundDepth > 10 THEN 

                                 ConnectedEquip[i].Used = TRUE;
                              ELSE
                                 ConnectedEquip[i].Used = TRUE;
                                 CALLPROC InsertValue (ValueList =
                                            IncludedObjects, 
                                    Value = ConnectedEquip[i].Object);
                              ENDIF;

                           ELSE

                              ConnectedEquip[i].Used = FALSE;
                              BreakerTypeFound = FALSE;
                              BreakerTypeFound = CALLPROC ArraySearch(
                                    SearchArray = BreakerTypes,
                                    TargetObject = ConnectedEquip[i].Type);

                              IF BreakerTypeFound = TRUE THEN
                                 ConnectedEquip[i].OutBoundBreakerFound = TRUE;
                              ENDIF;
                           ENDIF;  
                           ENDLOOP;                         
                        ELSE
                           o = o + 1;
                        ENDIF;
                     ENDWHILE;                   

                     IF o = i THEN  /*Problem finding previous object */
                        ConnectedEquip[i].Used = TRUE;
                     ENDIF;                           
                  ENDIF;
               ENDIF;
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

    ENDWHILE;

    IF EquipGrounded = FALSE THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  Continue with reverse search only if equipment grounded.
**  Produce warning if no visible breaks found in all directions.
*/
    MoreObjects = TRUE;
    i = 0;
    WHILE MoreObjects = TRUE DO

      PrevClosedPaths = ClosedPaths;
      ClosedPaths = 0;
      OpenedPaths = 0;

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          TempEquip[x].OutBound = FALSE;
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            
      CALLPROC DDB_ROLLBACK;

      MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO

        IF ConnectedEquip[x].Used = FALSE THEN
           FloatFound = TRUE;
           k = 1;
           WHILE k <= TempEquip.LastRow() DO
             IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                FloatFound = FALSE;
                ENDLOOP;
             ENDIF;
             k = k + 1;
           ENDWHILE;

           IF FloatFound = TRUE THEN  /* OK if a single terminal device */
              IF ConnectedEquip[x].Terminals = 1 THEN                 
/*
** If we have reached FdrLoad, re-use FloatEquip to track FdrLoad
*/
                 IF ConnectedEquip[x].Type = Type$FdrLoad THEN

                    SELECT :FdrLoadFeeder = O.Name
                    FROM   Udb_Object O,
                           Udb_Grouping G
                    WHERE  G.Member = :ConnectedEquip[x].Object AND
                           G.Relationship = :Interaction$MemberOf AND
                           G.Grouping = O.Object AND
                           O.Type IN (SELECT Type FROM Udb_ExtendedType
                                      WHERE  SuperType = :Type$Feeder);

                    FloatEquip = ConnectedEquip[x].Duplicate();    
                          
                 ELSE                              
                    OpenedPaths = OpenedPaths + 1;
                 ENDIF;

              ELSE 
                 FloatEquip = ConnectedEquip[x].Duplicate();     
             ENDIF;
           ENDIF;
        ENDIF;

        ConnectedEquip[x].Used = TRUE;
        x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      /* check for visible break. */
      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
/*  test - IGNORE CLOSED LOOPS
               CloseLoop = ConnectedEquip[k].Duplicate();
*/
               /* if this equip is in the next objectclause, remove it */
               CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  
         ELSE                                    /* new equip */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());
            
            VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = ExistingBreaks,
                                    TargetObject = TempEquip[x].Object);

            IF VisibleBreak = FALSE THEN

               EquipGrounded = CALLPROC ArraySearch(
                                    SearchArray = ExistingGrounds,
                                    TargetObject = TempEquip[x].Object);
/*
**  If we find a ground we then look for a appropriate move in the new
**  PerformMovesArray Global to see if we might be removing that ground.
*/
               IF EquipGrounded = TRUE THEN
                  FOR p = 1 TO PerformMovesArray.LastRow() DO
                    IF PerformMovesArray[p].Equip = TempEquip[x].Object THEN
                      TwoPosition = FALSE;
                      REPEATED
                      SELECT :TwoPosition = 1
                      FROM    FMS_JobAction JA,
                              SOA_JobControl JC,
                              SOA_ActiveCard AC
                      WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                              JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                              JA.StepPair = :PerformMovesArray[p].StepPair AND
                              JA.TypeOfCard = AC.TypeOfCard AND
                              AC.Card = JC.Card AND
                              JC.Job = :PerformMovesArray[p].Job AND
                              JA.TORS = :PerformMovesArray[p].TORS AND
                              JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                              JA.Action = :JobAction$Prompt AND
                              JA.Status = :Prompt$RemoveGroundBkrSide;

                      IF TwoPosition = 1 THEN
/*
** We appear to be removing the ground in the block of moves being issued at
** the same time, let's ignore this ground.
*/ 
                         EquipGrounded = FALSE;
                      ENDIF;
                    ENDIF;
                  ENDFOR;          
               ENDIF;
            ENDIF;

            IF VisibleBreak = TRUE OR EquipGrounded = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;
                  OpenedPaths = OpenedPaths + 1;
            ELSE
                  ClosedPaths = ClosedPaths + 1;
                     ConnectedScope = TRUE;
                     ConnectedScope = CALLPROC ArraySearch(
                                    SearchArray = CardObjects,
                             TargetObject = ConnectedEquip[i].PrimaryGrouping);
                     IF ConnectedScope = FALSE THEN
/*
** Need to extend search to first outbound disconnect in neighboring substation,
** which is the first disconnect after the first breaker.  
** Need to find previous object to determine where we are.
*/
                     ConnectedEquip[i].OutBound = TRUE;
                     o = 1;  
                     WHILE o < i DO
                        IF ConnectedEquip[o].Object = 
                               ConnectedEquip[i].PrevObject THEN

                           ConnectedEquip[i].OutBoundDepth =
                               ConnectedEquip[o].OutBoundDepth + 1;

                           IF ConnectedEquip[o].OutBoundBreakerFound = TRUE THEN
                              ConnectedEquip[i].OutBoundBreakerFound = TRUE;                           
                           
                              DisconnectTypeFound = FALSE;
                              DisconnectTypeFound = CALLPROC ArraySearch(
                                    SearchArray = DisconnectTypes,
                                    TargetObject = ConnectedEquip[i].Type);
/*
**  If this is the OutBound disconnect or we have gone further than ten deep,
**  we have gone far enough - consider OutBound closed.
*/
                              IF DisconnectTypeFound = TRUE THEN 

                                 ConnectedEquip[i].Used = TRUE;
                                 ClosedOutBnd = ConnectedEquip[i].Duplicate();

                              ELSE
                                 ConnectedEquip[i].Used = FALSE;
                              ENDIF;
                           ELSE

                              ConnectedEquip[i].Used = FALSE;
                              BreakerTypeFound = FALSE;
                              BreakerTypeFound = CALLPROC ArraySearch(
                                    SearchArray = BreakerTypes,
                                    TargetObject = ConnectedEquip[i].Type);

                              IF BreakerTypeFound = TRUE THEN
                                 ConnectedEquip[i].OutBoundBreakerFound = TRUE;
                              ENDIF;
                           ENDIF;                           
                           ENDLOOP;
                        ENDIF;
                        o = o + 1;
                     ENDWHILE;                   

                     IF o = i THEN  /*Problem finding previous object */
                        ConnectedEquip[i].Used = TRUE;
                        ClosedOutBnd = ConnectedEquip[i].Duplicate();
                     ENDIF;     

                     ENDIF;
           ENDIF;

           IF ConnectedEquip[i].Used = FALSE THEN
              CALLPROC InsertValue (ValueList = IncludedObjects, 
                                    Value = ConnectedEquip[i].Object);
           ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

      IF FloatEquip IS NOT NULL OR
         ClosedOutBnd IS NOT NULL OR
         CloseLoop  IS NOT NULL THEN
         MoreObjects = FALSE;
      ENDIF;   
    ENDWHILE;
/*
** If condition exists that would result in a warning, then
** make sure the GroundEquip is not a BPD or CCPD device.  If
** it is, the DO can choose to ignore it which would set the
** the visible break status and repeat the 
** trace.  If he accepts it we present the necessary warning.
*/
    IF (FloatEquip IS NOT NULL OR
         ClosedOutBnd IS NOT NULL OR
         (CloseLoop  IS NOT NULL OR
          PrevClosedPaths > OpenedPaths)) AND 
         AutomaticExecution = FALSE THEN
   
       ReturnStatus = CALLFRAME CCPDGroundEnergization (
                         GroundEquip = GroundEquip);
       IF ReturnStatus = PU_OK THEN
          ReturnStatus = CALLPROC CheckNotEnergizingGround (JIP = JIP);
          RETURN (ReturnStatus);
       ENDIF;
    ENDIF; 
/* 
** Give warning if Ground not isolated 
*/
    IF FloatEquip IS NOT NULL THEN
/*
** Float Equip may indicated unconnected two terminal error or Fdr Load.
*/
       IF FloatEquip.Type = Type$FdrLoad THEN

          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + 
                       GroundEquip.PrimaryGroupingName + ' ' + 
                       GroundEquip.TypeName + ' ' + 
                       GroundEquip.Name + '.' + HC_NEWLINE +
                       'You are attempting to remove a visible break necessary ' +
                       'for ' + GroundEquip.Name + ' to remain grounded.');

       ELSE

          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + 
                       GroundEquip.PrimaryGroupingName + ' ' + 
                       GroundEquip.TypeName + ' ' + 
                       GroundEquip.Name + '.' + HC_NEWLINE +
                       'You may be energizing into this ground because ' +
                       'connectivity trace could not be completed due to ' +
                       'incorrectly connected device: ' +
                        FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' +
                        FloatEquip.Name); 
       ENDIF;      

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF ClosedOutBnd IS NOT NULL THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + 
                       GroundEquip.PrimaryGroupingName + ' ' + 
                       GroundEquip.TypeName + ' ' + 
                       GroundEquip.Name + '.' + HC_NEWLINE +
                       'You may be energizing into this ground because ' +
                       'no visible break found in direction of substation: ' +
                       ClosedOutBnd.PrimaryGroupingName);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF CloseLoop  IS NOT NULL OR
           PrevClosedPaths > OpenedPaths  THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Ground Found at: ' + 
                       GroundEquip.PrimaryGroupingName + ' ' + 
                       GroundEquip.TypeName + ' ' + 
                       GroundEquip.Name + '.' + HC_NEWLINE +
                       'You may be energizing into this ground because ' +
                       'connectivity trace could not determine that ' +
                       'all paths are open.');

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;

    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckNotifications

/*
**      Copyright c 1996 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Procedure:      CheckNotifications
**
**  Modifications:
**  10/03/96  jfl   Created 
**  03/10/97  jfl   Update comments
**  11/19/02 ysp    Merge: removed passed-in C and Jobs
*/
PROCEDURE CheckNotifications
(
    JIP = JobInProgress;				/* Job being processed */
    RetCode = INTEGER NOT NULL;
) =
BEGIN

/*
** Call the PromptNotifications frame to suggest the
** operator to issue one or more notifications
** Precise it is a precheck.
*/ 
    RetCode = CALLFRAME PromptNotifications (JIP = JIP,
                        PrePost = JobCheck$Precheck);

    RETURN RetCode;
END;

Application Component Report
============================

	Name:            CheckOpenforHiPot

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    SOA
**  Frame:          CheckOpenforHiPot
**
**  Date:       Author   Description
** ----------------------------------
**  04/20/00    py       Created
**  05/31/00    em       After finding open device, check connected terminal for
**                       a ground.  If a ground is found on this terminal, it is 
**                       reached first, ahead of the open device, and thus takes
**                       precedence.
**  06/08/00    py       High Pot Check on a transformer, need a ground on all
**                       connected sides, not just one side.
**  11/26/02    pkw      Change Job to JIP for Merge.
**  03/07/03    em       Testing problems: attempting to fix problem 
**                       looking for ground.  Moved GroundCount = 0 warning
**                       after connectivity warnings because we may find a
**                       connectivity issue before finding Grounds.
**  02/13/04    em       Converted Messages to TraceError call.
**  09/01/06    em       PendingStatusCount must be > 0
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  09/01/16    em       Changed to support QGIS Diagram Editor ACLineSegment rules where line segment
**                       grouped to only one station
**  02/22/17    ysp      Converted to use QGis-base trace class Trace_OpenForHighPot
**  05/03/17    ysp      Requirement change: the only one ground found within the JIP substation to be removed
**                       as a part of the hi pot order. DO will issue a removing ground, testing hi pot and
**                       applying ground together in a single order. 
**  07/28/17    ysp      For Hi Pot on an ac line segment, one trace goes into the Hi Pot substation and the 2nd
**                       trace goes into other substations from the other end. No need to trace from each segment
**                       as old codes prior to the QGis conversion.  
**
*/
PROCEDURE CheckOpenforHiPot
(
    JIP = JobInProgress;   /*Passed Job*/				         
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   ACLLine = INTEGER NOT NULL WITH DEFAULT;
   CardObjectList   = ARRAY OF INTEGEROBJECT;
   DeviceType = INTEGER NOT NULL;
   GroundCount = INTEGER NOT NULL WITH DEFAULT; /*Number of Grounds found*/
   GroundTerminals = ARRAY OF INTEGEROBJECT;
   LineSegments = ARRAY OF EQUIPMENT;
   LineSegStations = INTEGER NOT NULL WITH DEFAULT; /*Number of stations for a line */
   OpenBreak = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER;
   Operator = INTEGER;  /*Operator to use for pending status check*/
   Terminals = INTEGER NOT NULL WITH DEFAULT;
               
   Trace = Trace_CheckOpenForHighPot DEFAULT NULL;
   TraceFromEquip = INTEGER NOT NULL WITH DEFAULT;
   TraceStartEquip = INTEGER NOT NULL WITH DEFAULT;
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   GroundCount = 0;
   
   IF JIP.Substation = 0 THEN
/*
** Unable to limit scope of the trace to the substation.
*/
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Open For HiPot Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckOpenForHiPot:  JobClass Maint problem. ' +
               'Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  Job = ' + 
               VARCHAR(JIP.Job) + '.' 
               );
      RETURN (PU_OK);
   ENDIF;
   
   IF JIP.Status = Job$Restore THEN
      Operator = JIP.RSOperator;
   ELSE
      Operator = JIP.TOOperator;
   ENDIF;
/*
**  Check if current equipment is grounded.  If so, direct trace in 
**  opposite direction of grounded terminal.  If ground on terminal 0, produce 
**  error, don't know what to do in that situation.
**
**  We leave this code here copied from CheckNotEnergizingGround.  Likely to be
**  only useful for "other" equipment types (not transformer or ACLineSegment)
**  to determine search direction away from the Ground.  Most likely case is
**  that our start equip should never be grounded.
*/
   Terminals = 0;
   GroundTerminals.Clear();
   i = 1;    
   REPEATED    
   SELECT DISTINCT
          :Terminals = O.Terminals,
          :GroundTerminals[i].Value = OS.Terminal
   FROM  FMS_ObjectStatus OS,
         UDB_Object O
   WHERE O.Object = :JIP.Equip AND
         OS.Object = O.Object AND
         OS.StatusCount > 0 AND
         OS.Status = :Status$Ground 
   ORDER BY 1 ASC			// ground on terminal = 0 will be the first element
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF GroundTerminals.LastRow > 0 THEN
      IF GroundTerminals[1].Value = 0 THEN
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                      Job = JIP.Job,
                                      SwitchingItem = JIP.SwitchingItem, 
                     Text = 'Equipment you are Hi Pot testing has a terminal ' +
                            'indeterminant ground on it.  Cannot perform ' +
                            'adequate connectivity trace.');
   
         IF RetCode = PU_CANCEL THEN
            RETURN(PU_CANCEL);
         ELSE
            RETURN(Warning$Overridden);
         ENDIF;
      ENDIF;
/*
**  Check if all terminals are grounded.  If so, okay to close,
**  otherwise point direction of search in the opposite direction.
*/            
      IF GroundTerminals.LastRow = Terminals  THEN 
         RETURN(PU_OK);
      ENDIF;

      GroundCount = 1;
      
      // set trace starting point and direction (in opposite direction of grounded terminal)
      TraceFromEquip = GroundTerminals[1].Value; 
      TraceStartEquip = JIP.Equip;
   
   ELSE  /* Job Equipment not grounded. */
      /*
      ** Determine direction of search for ACLineSegments, Transformers and open devices.
      ** Case statement:
      **   ACLineSegment between stations - use job substation.
      **   ACLineSegment same station - go both ways 
      **   Transformer - Look in all directions searching for one ground.  May have three terminals!! 
      **   "Other" Open device - prompt user to select direction
      **   "Other" Not Open device - go both ways 
      */
      DeviceType = 0;
      SELECT :DeviceType = :Type$ACLineSegment
      FROM   Udb_ExtendedType
      WHERE  Type = :JIP.EquipClass AND
             SuperType = :Type$ACLineSegment;       
      
      IF DeviceType = Type$ACLineSegment THEN
         /*
         ** Get the line for the AC Line Segment
         */ 
         REPEATED
         SELECT  :ACLLine = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G 
         WHERE   G.Member = :JIP.Equip AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Grouping = O.Object AND
                 O.Type = :Type$Line;
         /*
         ** get all sibling segments for the line
         */
         LineSegStations = 0;
         i = 1;
         SELECT DISTINCT
               :LineSegments[i].Substation = G2.Grouping,
               :LineSegments[i].Equip = G2.Member
         FROM  Udb_Grouping G, 
               Udb_Grouping G2,
               Udb_ExtendedType ET, 
               Udb_ExtendedType ET2 
         WHERE G.Grouping = :ACLLine AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = ET.Type AND
              ET.SuperType = :Type$ACLineSegment AND
              G.Member = G2.Member AND 
              G2.Relationship = :Interaction$MemberOf AND
              G2.GroupingType = ET2.Type AND
              ET2.SuperType = :Type$Substation
         BEGIN
            /* get the number of unique substations. In the case of a line between 3 substations;
            ** there may be more than 4 segments
            */
            IF i = 1 THEN
               LineSegStations = 1;
            ELSE
               RetCode = LineSegments.Find(AttributeName = 'Substation',
                                        Value = LineSegments[i].Substation,
                                        EndRow = (i-1));
               IF RetCode = ER_ROWNOTFOUND THEN
                  LineSegStations = LineSegStations + 1;
               ENDIF;
            ENDIF;
            i = i + 1;
         END;
         
         IF LineSegStations = 0 THEN
            CALLPROC TraceError (UserMessage = 
              'Database Maintenance Error: ' +
              'Open For HiPot Check is being performed ' +
              'where the AClineSegment is not in a ' + 
              'substation. Contact your Adminstrative DO.',
                          TraceMessage =
              'CheckOpenForHiPot:  Database Maintenance problem. ' +
              'Check is being performed incorrectly ' +
              'where the AClineSegment is not in a ' + 
              'substation.  Device = ' + VARCHAR(JIP.Equip) + '.' 
              );
            RETURN (PU_OK);

         ELSEIF LineSegStations = 1 THEN
            /*
            **  In the same substation
            */
            // set trace starting point and direction
            TraceFromEquip = 0;
            TraceStartEquip = JIP.Equip;
         ELSE          
            /*
            **  Between two or three substations
            */
            // set trace starting point and direction (into the move's substation)
            TraceFromEquip = JIP.Equip;
            TraceStartEquip = 0;          // connected object will be determined below
            
            SELECT :TraceStartEquip = C.ToObj
            FROM   DSO_Connection C,
                   DSO_Object O                       // don't use udb_object. AclineSegment may connect to a node
            WHERE  C.FromObj = :JIP.Equip AND
                   C.ToObj = O.Object AND
                   O.StructureObj = :JIP.Substation;
                   
            IF TraceStartEquip = 0 THEN
               SELECT :TraceStartEquip = C.FromObj
               FROM   DSO_Connection C,
                      DSO_Object O
               WHERE  C.ToObj = :JIP.Equip AND
                      C.FromObj = O.Object AND
                      O.StructureObj = :JIP.Substation;
            ENDIF;
            
            IF TraceStartEquip = 0 THEN
               CALLPROC TraceError (UserMessage = 
                    'Database Maintenance Error: ' +
                    'Open For HiPot Check is being performed ' +
                    'where the AClineSegment is not connected to another device ' + 
                    'in the substation. Contact your Adminstrative DO.',
                          TraceMessage =
                    'CheckOpenForHiPot:  Database problem. ' +
                    'Check is being performed incorrectly ' +
                    'where the AClineSegment is not connected to another device ' + 
                    'in the substation. Device = ' +
                    VARCHAR(JIP.Equip) + '.' 
                  );
               RETURN (PU_OK);
            ENDIF;         
         ENDIF;                
      ELSE
         SELECT :DeviceType = :Type$Transformer
         FROM   Udb_ExtendedType
         WHERE  Type = :JIP.EquipClass AND
                SuperType = :Type$Transformer;       

         IF DeviceType = Type$Transformer THEN
            /*
            ** We are going to do the Ground Search elsewhere.
            */
            TraceStatus = CALLPROC TransformerGroundSearch(JIP = JIP);
        
            RETURN(TraceStatus); 
         
         ELSE       
            DeviceType = Type$Switch;  /* "Other" */
         ENDIF;
      ENDIF;

      IF DeviceType = Type$Switch THEN   /*Other equipment */
         OpenBreak = 0;

         SELECT :OpenBreak = 1
         FROM   Udb_Switch S
         WHERE  S.Object = :JIP.Equip AND
                S.CurrentlyOpen = 1;
    
         IF OpenBreak = 0 THEN
            SELECT :OpenBreak = 1
            FROM   FMS_PendingStatus PS
            WHERE  PS.Object = :JIP.Equip AND
                   PS.IssuedOperator = :Operator AND
                   PS.StatusCount > 0 AND
                   PS.PendingStatus = :Status$Open;
         ENDIF;  
      
         IF OpenBreak = 1 THEN
            /*
            **  Prompt User to select terminal for open device
            **  RetCode will contain the Node
            **  Cannot do prompt during automatic execution.
            */
            IF AutomaticExecution = TRUE THEN
               CALLPROC TraceError (UserMessage = '',
                          TraceMessage =
                     'CheckOpenForHiPot:  ' +
                     'Transformer Node selection cannot be made during ' +
                     'auto execution of Job = ' + VARCHAR(JIP.Job) + '.'
                     );
               CALLFRAME Warning
                   ( Card = JIP.Card, 
                     Job = JIP.Job, 
                     SwitchingItem = JIP.SwitchingItem,
                     Text = 'Transformer Node selection cannot be made ' +
                            'during auto execution.  ' +
                            'Tech Support should review Automation Monitor ' +
                            'trace log for specific error.'
                   ); 
               RETURN (PU_CANCEL);
            ELSE
               RetCode = CALLFRAME SelectHighPotNode 
                            (SelectedEquip = JIP.Equip,
                             SelectedEquipName = JIP.EquipName,
                             SelectedEquipClassName = JIP.EquipClassName);
                
               IF RetCode = PU_Cancel THEN
                  CALLPROC TraceError (UserMessage = 
                     'WARNING: Node was not selected so High Pot Check ' +
                     'cannot be performed.',
                          TraceMessage =
                     'CheckOpenForHiPot:  ' +
                     'Node was not selected so High Pot Check ' +
                     'cannot be performed for Job = ' + VARCHAR(JIP.Job) + '.'
                     );
                  RETURN (PU_CANCEL);
               ENDIF;
         
               // set trace starting point and direction
               TraceFromEquip = JIP.Equip;
               TraceStartEquip = IFNULL(RetCode, 0);          // DO's selection of a connected object
            ENDIF;
         ELSE
            // set trace starting point and direction
            TraceFromEquip = 0;
            TraceStartEquip = JIP.Equip;
         ENDIF;
      ENDIF;
   ENDIF;

/*
** get card scope 
*/
   i = 1;
   SELECT  :CardObjectList[i].Value = Object
   FROM    SOA_ActiveObject
   WHERE   Card = :JIP.Card
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
** start search from the starting equipment and then branch out. For every piece 
** of connected equipment, we check for a ground. 
** Issue the warning :
** if no single ground is found in the selected substation,
** if more than one grounf is found in the selected substation and
** If a single ground is found, we look for Open devices on all paths other than 
** where the single ground is found. Issue the waring, if no open device is
** found. If Open devices are found, okey.
*/
   Trace = Trace_CheckOpenForHighPot.Create();
   Trace.MaxGrounds = 1;

   Trace.CardObjectList = CardObjectList;  
   Trace.GroundCount = GroundCount;
   
   Trace.TraceFromEquip = TraceFromEquip;
   Trace.TraceStartEquip = TraceStartEquip;
   
   Trace.UsePendingStatus = TRUE;
   Trace.IssuedOperator = Operator;
      
   TraceStatus = Trace.StartIsolationTrace();
   
   /* 
   ** if equipment is not connected, then no need to do a connectivity check 
   */
   IF TraceStatus = TraceStatus$Isolated THEN
      RETURN (PU_OK);
      
   ELSEIF TraceStatus = TraceStatus$Error THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                                   Text = Trace.ErrorMessage);
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;   
   ENDIF;   
/* 
** Give warning if more than one grounds found
*/
   IF Trace.GroundCount > 1 THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                  Text = 'More than one ground found in the isolated area: ' + 
                         Trace.GroundEquip.TypeName + ' ' + Trace.GroundEquip.Name +   
                         ' Is the second ground. ' + HC_NEWLINE +
                         'Hi Pot Test should not be Carried Out on: ' +
                         JIP.EquipClassName + ' ' + JIP.Equipname);         
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
/*
** Warnings for connectivity errors
*/
   IF Trace.FloatEquip IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'High Pot check not confirmed for equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + 
                      '. ' + HC_NEWLINE + 'Connectivity trace discovered ' +
                      'a connectivity problem at: ' + 
                       Trace.FloatEquip.StructureName + '  ' +
                       Trace.FloatEquip.TypeName + '  ' + Trace.FloatEquip.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF Trace.ClosedOutBound IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot check not confirmed for equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + 
                      '. ' + HC_NEWLINE +  
                      'Connectivity trace ' +
                      'could not find a Currently Open device ' +
                      'in the direction of: ' +
                       Trace.ClosedOutBound.PrimaryGroupingName + '  ' +
                       Trace.ClosedOutBound.TypeName + '  ' + Trace.ClosedOutBound.Name);       
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   
   ELSEIF TraceStatus <> TraceStatus$Open THEN   
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot Check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + '. ' + HC_NEWLINE +
                       'Connectivity trace could not determine that ' +
                       'all paths are Currently Open.');
 
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;

   IF Trace.GroundCount = 0 THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                  Text = 'No Ground Found in isolated section at ' +
                        'Substation:  ' + VARCHAR(JIP.SubstationName) + HC_NEWLINE +
                        'Hi Pot Test should not be Carried Out on: ' +
                        JIP.EquipClassName + ' ' + JIP.Equipname);         
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSE
      /* at this point, we found only one ground
      */
      IF GroundCount = 1 THEN
         /* The ground is at the JIP equipment. Make sure this ground is to be removed as part of the job order
         */ 
         SELECT :GroundCount = StatusCount
         FROM   FMS_PendingStatus
         WHERE  Object = :JIP.Equip AND
                IssuedOperator = :Operator AND
                PendingStatus = :Status$Ground;

         IF GroundCount <> 0 THEN
            RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                      Job = JIP.Job,
                        Text = 'Ground found at job equipment: ' + 
                               JIP.EquipClassName + ' ' + JIP.EquipName + HC_NEWLINE +
                               'Hi Pot Test should not be Carried Out on: ' +
                                JIP.EquipClassName + ' ' + JIP.Equipname);         
            IF RetCode = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RETURN(Warning$Overridden);
            ENDIF;
         ENDIF;
      
      ELSEIF Trace.GroundEquip.Structure <> JIP.Substation THEN
         /* make sure the ground is in the same substation as the job equipment
         */
         RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                      Job = JIP.Job,
                        Text = 'Ground found in the other substation at: ' + 
                               Trace.GroundEquip.TypeName + ' ' + 
                               Trace.GroundEquip.Name +   
                               '. There should not be a ground in that substation. ' + HC_NEWLINE +
                               'Hi Pot Test should not be Carried Out on: ' +
                                JIP.EquipClassName + ' ' + JIP.Equipname);         
         IF RetCode = PU_CANCEL THEN
            RETURN(PU_CANCEL);
         ELSE
            RETURN(Warning$Overridden);
         ENDIF;
      ELSE
         /* Make sure this ground is to be removed as part of the job order
         */
         GroundCount = Trace.GroundCount;
         
         SELECT :GroundCount = StatusCount
         FROM   FMS_PendingStatus
         WHERE  Object = :Trace.GroundEquip.Object AND
                IssuedOperator = :Operator AND
                PendingStatus = :Status$Ground;

         IF GroundCount <> 0 THEN
            RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                      Job = JIP.Job,
                        Text = 'Ground found at equipment: ' + 
                               Trace.GroundEquip.TypeName + ' ' + Trace.GroundEquip.Name + HC_NEWLINE +
                               'Hi Pot Test should not be Carried Out on: ' +
                                JIP.EquipClassName + ' ' + JIP.Equipname);         
            IF RetCode = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RETURN(Warning$Overridden);
            ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;

/*
**  If we have a line segment that spans two stations, we need to go into
**  the other stations and look for breaks without finding another ground.
**  If not a Line segment, we are done.
*/
   IF DeviceType <> Type$ACLineSegment OR LineSegStations < 2 THEN
      RETURN (PU_OK);
   ENDIF;   
/*
** start search from the line segment into other substations. For every piece 
** of connected equipment, we check for a ground. Issue a warning if a ground is found.
*/

/* search on the other end of the ac line segment
*/
   TraceFromEquip = JIP.Equip;
   TraceStartEquip = 0;          // connected ac line segment on the other end
         
   SELECT :TraceStartEquip = C.ToObj
   FROM   DSO_Connection C,
          DSO_Object O 
   WHERE  C.FromObj = :JIP.Equip AND
          C.ToObj = O.Object AND
          O.StructureObj <> :JIP.Substation;
                   
   IF TraceStartEquip = 0 THEN
      SELECT :TraceStartEquip = C.FromObj
      FROM   DSO_Connection C,
             DSO_Object O
      WHERE  C.ToObj = :JIP.Equip AND
             C.FromObj = O.Object AND
             O.StructureObj <> :JIP.Substation;
   ENDIF;

   IF TraceStartEquip = 0 THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                Job = JIP.Job,
                                SwitchingItem = JIP.SwitchingItem, 
             Text = JIP.EquipClassName + ' ' + JIP.EquipName + 
                   ' is not properly connected on the other end. Could not complete High Pot Check');           
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
         
   // start the trace
   Trace = Trace_CheckOpenForHighPot.Create();
   Trace.MaxGrounds = 0;
   Trace.CardObjectList = CardObjectList;    
   Trace.GroundCount = 0;
   
   Trace.TraceFromEquip = TraceFromEquip;
   Trace.TraceStartEquip = TraceStartEquip;
   
   Trace.UsePendingStatus = TRUE;
   Trace.IssuedOperator = Operator;
      
   TraceStatus = Trace.StartIsolationTrace();
   /* 
   ** Give warning if a ground found in other substation
   */
   IF Trace.GroundCount > 0 THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                  Text = 'Ground found in the other substation at: ' + 
                         Trace.GroundEquip.TypeName + ' ' + 
                         Trace.GroundEquip.Name +   
                         '. There should not be a ground in that substation. ' + HC_NEWLINE +
                         'Hi Pot Test should not be Carried Out on: ' +
                          JIP.EquipClassName + ' ' + JIP.Equipname);         
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
   /*
   ** Warnings for connectivity errors
   */
   IF Trace.FloatEquip IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'High Pot check not confirmed for equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + 
                      '. ' + HC_NEWLINE + 'Connectivity trace discovered ' +
                      'a connectivity problem at: ' + 
                       Trace.FloatEquip.StructureName + '  ' +
                       Trace.FloatEquip.TypeName + '  ' + Trace.FloatEquip.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF Trace.ClosedOutBound IS NOT NULL THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot check not confirmed for equip: ' + 
                      JIP.EquipClassName + ' ' + JIP.EquipName + 
                      '. ' + HC_NEWLINE + 'Connectivity trace ' +
                      'could not find a Currently Open device in the direction of: ' +
                       Trace.ClosedOutBound.StructureName + '  ' +
                       Trace.ClosedOutBound.TypeName + '  ' + Trace.ClosedOutBound.Name);       

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;

   ELSEIF TraceStatus <> TraceStatus$Open THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot Check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + '. ' + HC_NEWLINE +
                       'Connectivity trace could not determine that ' +
                       'all paths are Currently Open.');
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
   RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckOpenforHiPot_b4qgis

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    SOA
**  Frame:          CheckOpenforHiPot
**
**  Date:       Author   Description
** ----------------------------------
**  04/20/00    py       Created
**  05/31/00    em       After finding open device, check connected terminal for
**                       a ground.  If a ground is found on this terminal, it is 
**                       reached first, ahead of the open device, and thus takes
**                       precedence.
**  06/08/00    py       High Pot Check on a transformer, need a ground on all
**                       connected sides, not just one side.
**  11/26/02    pkw      Change Job to JIP for Merge.
**  03/07/03    em       Testing problems: attempting to fix problem 
**                       looking for ground.  Moved GroundsCount = 0 warning
**                       after connectivity warnings because we may find a
**                       connectivity issue before finding Grounds.
**  02/13/04    em       Converted Messages to TraceError call.
**  09/01/06    em       PendingStatusCount must be > 0
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  09/01/16    em       Changed to support QGIS Diagram Editor ACLineSegment rules where line segment
**                       grouped to only one station
**  03/20/17    em       Correction in final trace from ACLineSegment to make sure trace goes into
**                       other substation. 
**
*/
PROCEDURE CheckOpenforHiPot_b4qgis
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER;
    k = INTEGER;
    m = INTEGER;
    x = INTEGER;

    RetCode         = INTEGER;
    OpenBreak       = INTEGER NOT NULL;
    PendingBreak    = INTEGER NOT NULL;
    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    CloseLoop      = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    GroundEquip    = ConnectedEquipClass;
              
    OpenBreaks = ARRAY OF INTEGEROBJECT; /*List of Objects with Breaks*/
    PendingBreaks  = ARRAY OF INTEGEROBJECT; /*Objects with Pending Breaks*/
    ExistingGrounds = ARRAY OF INTEGEROBJECT; /*List of Objects with Grounds*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    EquipGrounded  = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    GroundsCount   = INTEGER NOT NULL WITH DEFAULT; /*Number of Grounds found*/
    GroundedTerminal = INTEGER NOT NULL WITH DEFAULT; /*Which side?*/
    GroundedNode   = INTEGER NOT NULL WITH DEFAULT; /*Trace away to other side*/
    LineSegStations = INTEGER NOT NULL WITH DEFAULT; /*Number of stations for a line seg*/

    OutBoundType   = INTEGER NOT NULL;    /*Look at OutBoundTypes*/    
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    DeviceType     = INTEGER NOT NULL;
    DeviceSubstations = INTEGER NOT NULL;
    StartNode      = INTEGER NOT NULL;
    TargetNode     = INTEGER NOT NULL;
    SelectedTerm   = INTEGER NOT NULL;
    OtherSubstation = INTEGER NOT NULL;

    TransformerRetCode = INTEGER NOT NULL WITH DEFAULT;
    ACLLine           = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    GroundsCount = 0;
    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :JIP.Equip AND
           O.Object = T.Object AND
           T.Node > 0;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN (PU_OK);
    ENDIF;

    IF JIP.Substation = 0 THEN
/*
** Unable to limit scope of the trace to the substation.
*/
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Open For HiPot Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckOpenForHiPot:  JobClass Maint problem. ' +
               'Check is being performed incorrectly ' +
               'on a move where equipment is not in a substation.  Job = ' + 
               VARCHAR(JIP.Job) + '.' 
               );
       RETURN (PU_OK);
    ENDIF;
    ConnectedEquip[1].Used = FALSE;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all open breaks and grounds
** into sorted lists which then can be searched using our bisection search.
*/
    OpenBreaks.Clear();
    PendingBreaks.Clear();
    ExistingGrounds.Clear();
/*
**  Get list of Open Breakers within selected substation 
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
            :OpenBreaks[i].Value = S.Object
    FROM Udb_Switch S,
         Udb_Grouping G
    WHERE G.Grouping = :JIP.Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = S.Object AND
          S.CurrentlyOpen = :TRUE
    ORDER BY 1
    BEGIN
       i = i + 1;
    END; 
/*
**  Get list of Pending Open Breakers within selected substation 
*/
    IF JIP.Status = Job$Restore THEN
       Operator = :JIP.RSOperator;
    ELSE
       Operator = :JIP.TOOperator;
    ENDIF;

    i = 1;
    REPEATED
    SELECT DISTINCT
            :PendingBreaks[i].Value = G.Member
    FROM   Udb_Grouping G,
           FMS_PendingStatus PS
    WHERE  G.Grouping = :JIP.Substation AND
           G.Relationship = :Interaction$MemberOf AND
           G.Member = PS.Object AND
           PS.IssuedOperator = :Operator AND
           PS.StatusCount > 0 AND
           PS.PendingStatus = :Status$Open
    ORDER BY 1
    BEGIN
       i = i + 1;
    END; 
/*
**  Get list of grounds in the selected substation
*/
    i = 1;    
    REPEATED    
    SELECT DISTINCT
            :ExistingGrounds[i].Value = OS.Object
    FROM  FMS_ObjectStatus OS,
          Udb_Grouping G
    WHERE G.Grouping = :JIP.Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = OS.Object AND
          OS.StatusCount > 0 AND
          OS.Status = :Status$Ground 
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;
/*
**  Build first part of where clause, second part depends if current equip
**  grounded.
*/
    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND '; 

/*
**  Make sure current equipment is not in grounded list.  If so, direct trace in **  opposite direction of grounded terminal.  If ground on terminal 0, produce **  error, don't know what to do in that situation.
**
**  We leave this code here copied from CheckNotEnergizingGround.  Likely to be
**  only useful for "other" equipment types (not transformer or ACLineSegment)
**  to determine search direction away from the Ground.  Most likely case is
**  that our start equip should never be grounded.
*/
    EquipGrounded = FALSE;
    EquipGrounded = CALLPROC ArraySearch(
                             SearchArray = ExistingGrounds,
                             TargetObject = JIP.Equip);

    IF EquipGrounded = TRUE THEN
       SELECT GroundedTerminal = COUNT(*) 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND
              Terminal = 0;
       IF GroundedTerminal > 0 THEN
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                       Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem, 
                 Text = 'Equipment you are Hi Pot testing has a terminal ' +
                        'indeterminant ground on it.  Cannot perform ' +
                        'adequate connectivity trace.');

          IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RETURN(Warning$Overridden);
          ENDIF;
       ENDIF;
/*
**  Just for fun, check if both terminals are grounded.  If so, okay to close,
**  otherwise point direction of search in the opposite direction.
*/
       k = 0;
       SELECT :k = COUNT(*)                                 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND              
              Terminal = 1;
       x = 0;
       SELECT :x = COUNT(*)                                 
       FROM   FMS_ObjectStatus 
       WHERE  Object = :JIP.Equip AND
              Status = :Status$Ground AND
              Terminal = 2;
       IF x > 0 AND k > 0 THEN
          RETURN(PU_OK);
       ELSEIF k > 0 THEN
          GroundedTerminal = 1; 
       ELSEIF x > 0 THEN 
          GroundedTerminal = 2;
       ELSE
          GroundedTerminal = 0;  /*Terminals number not 1 or 2*/
       ENDIF;

       SELECT :GroundedNode = Node
       FROM   Udb_Terminal
       WHERE  Object = :JIP.Equip AND
              Terminal = :GroundedTerminal;

       DynamicWhereClause = StaticWhereClause + 
                         'T1.Node <> ' + VARCHAR(GroundedNode) + ' AND ' +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
       GroundEquip = ConnectedEquip[1].Duplicate();
       GroundsCount = 1;

    ELSE  /* Job Equipment not grounded. */
/*
** Determine direction of search right here for ACLineSegments, Transformers,
** and open devices.
** Case statement:
**     ACLineSegment between stations - use job substation.
**     ACLineSegment same station - go both ways 
**     Transformer between stations - use job station
**     Transformer same station - prompt user to select direction
** 06/12/00  Transformer Change.  Look in all directions searching for one 
** ground.  May have three terminals!! 
**     "Other" Open device - prompt user to select direction
**     "Other" Not Open device - go both ways 
*/
       DeviceType = 0;
       SELECT :DeviceType = :Type$ACLineSegment
       FROM   Udb_ExtendedType
       WHERE  Type = :JIP.EquipClass AND
              SuperType = :Type$ACLineSegment;       

       IF DeviceType = Type$ACLineSegment THEN
/*
** Get the line for ACLine Segment
*/ 
          REPEATED
          SELECT  :ACLLine = O.Object
          FROM    Udb_Object O,
                  Udb_Grouping G 
          WHERE   G.Member = :JIP.Equip AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Grouping = O.Object AND
                  O.Type = :Type$Line;
/*
**  Make sure line segment spans two substations, otherwise treat it like 
**  "other" device.
*
          LineSegStations = 0;
          SELECT :LineSegStations = COUNT(*) 
          FROM   Udb_Grouping 
          WHERE  Member = :JIP.Equip AND      
                 Relationship = :Interaction$MemberOf AND
                 GroupingType IN ( SELECT Type
                                  FROM   Udb_ExtendedType
                                  WHERE  SuperType = :Type$Substation);
*/
          LineSegStations = 0;
          SELECT :LineSegStations = COUNT(*) 
          FROM    Udb_Object O,
               Udb_Grouping G, 
               Udb_Grouping G2,
               Udb_ExtendedType ET, 
               Udb_ExtendedType ET2 
          WHERE   G.Grouping = :ACLLine AND
               G.Relationship = :Interaction$MemberOf AND
               G.MemberType = ET.Type AND
               ET.SuperType = :Type$ACLineSegment AND
               G.Member = G2.Member AND 
               G2.Relationship = :Interaction$MemberOf AND
               G2.Grouping = O.Object AND
               O.Type = ET2.Type AND
               ET2.SuperType = :Type$Substation;

          IF LineSegStations = 1 THEN
             DeviceType = Type$Switch;
          ENDIF;
       ENDIF;
 
       IF DeviceType = 0 THEN
          SELECT :DeviceType = :Type$Transformer
          FROM   Udb_ExtendedType
          WHERE  Type = :JIP.EquipClass AND
                 SuperType = :Type$Transformer;       
       ENDIF;

       IF DeviceType = Type$Transformer THEN
/*
** We are going to do the Ground Search elsewhere.
*/
          TransformerRetCode = CALLPROC TransformerGroundSearch (
               JIP = JIP);

          RETURN(TransformerRetCode); 

       ELSEIF DeviceType = 0 THEN
 
          DeviceType = Type$Switch;  /* "Other" */
       ENDIF;
/*
**  How many stations for Transformer/ACLineSeg?
*/
       IF DeviceType = Type$ACLineSegment OR DeviceType = Type$Transformer THEN  
         IF DeviceType = Type$ACLineSegment THEN
          DeviceSubstations = LineSegStations;
         ELSE
          SELECT :DeviceSubstations = COUNT(*) 
          FROM   Udb_Grouping G,
                 Udb_ExtendedType ET
          WHERE  ET.SuperType = :Type$Substation AND
                 ET.Type = G.GroupingType AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = :JIP.Equip;
         ENDIF;

          IF DeviceSubstations = 0 THEN

             CALLPROC TraceError (UserMessage = 
               'Database Maintenance Error: ' +
               'Open For HiPot Check is being performed ' +
               'where the Transformer or AClineSegment is not in a ' +                          'substation. Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckOpenForHiPot:  Database Maint problem. ' +
               'Check is being performed incorrectly ' +
               'where the Transformer or AClineSegment is not in a ' +                          'substation.  Device = ' +
               VARCHAR(JIP.Equip) + '.' 
               );
             RETURN (PU_OK);
/*
**  In the same substation
*/
          ELSEIF DeviceSubstations = 1 THEN

             IF DeviceType = Type$ACLineSegment THEN
                DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
             ELSE
/*
**  Prompt User to select terminal for transformer
**  RetCode will contain the Node
**  Cannot do prompt during automatic execution.
*/
                IF AutomaticExecution = TRUE THEN
                   CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
                      'CheckOpenForHiPot:  ' +
                      'Transformer Node selection cannot be made during ' +
                      'auto execution of Job = ' + VARCHAR(JIP.Job) + '.'
                      );
                   CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Transformer Node selection cannot be made ' +
                             'during auto execution.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
                   RETURN (PU_CANCEL);
                ELSE

                   RetCode = CALLFRAME SelectHighPotNode 
                          (SelectedEquip = JIP.Equip,
                           SelectedEquipName = JIP.EquipName,
                           SelectedEquipClassName = JIP.EquipClassName);
                 
                   IF RetCode = PU_Cancel THEN
                      CALLPROC TraceError (UserMessage = 
                        'WARNING: Node was not selected so High Pot Check ' +
                       'cannot be performed.',
                           TraceMessage =
                       'CheckOpenForHiPot:  ' +
                       'Node was not selected so High Pot Check ' +
                       'cannot be performed for Job = ' + VARCHAR(JIP.Job) + '.'
                       );
                      RETURN (PU_CANCEL);
                   ENDIF;

                   StartNode = RetCode;
                ENDIF;

             ENDIF;
/*
**  Between two substation
*/
          ELSE 

             TargetNode = 0;
             SELECT :TargetNode = T1.Node
             FROM   Udb_Terminal T1,
                    Udb_Object O,
                    Udb_Terminal T2
             WHERE  O.PrimaryGrouping = :JIP.Substation AND
                    O.Object = T2.Object AND
                    T2.Node = T1.Node AND
                    T1.Object = :JIP.Equip;           
             IF TargetNode = 0 THEN
                CALLPROC TraceError (UserMessage = 
               'Database Maintenance Error: ' +
               'Open For HiPot Check is being performed ' +
               'where the equipment is not connected to another device ' + 
               'in the substation. Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckOpenForHiPot:  Database Maint problem. ' +
               'Check is being performed incorrectly ' +
               'where the equipment is not connected to another device ' + 
               'in the substation. Device = ' +
               VARCHAR(JIP.Equip) + '.' 
               );
                RETURN (PU_OK);
             ENDIF;

             DynamicWhereClause = StaticWhereClause + 
                         'T1.Node = ' + VARCHAR(TargetNode) + ' AND ' +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
          ENDIF;         

       ELSE   /*Other equipment */

          OpenBreak = CALLPROC ArraySearch(
                                    SearchArray = OpenBreaks,
                                    TargetObject = JIP.Equip);
          IF OpenBreak = FALSE THEN
             OpenBreak = CALLPROC ArraySearch(
                                       SearchArray = PendingBreaks,
                                       TargetObject = JIP.Equip);
          ENDIF;  

          IF OpenBreak = TRUE THEN
/*
**  Prompt User to select terminal for open device
**  RetCode will contain the Node
**  Cannot do prompt during automatic execution.
*/
             IF AutomaticExecution = TRUE THEN
                CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
                      'CheckOpenForHiPot:  ' +
                      'Transformer Node selection cannot be made during ' +
                      'auto execution of Job = ' + VARCHAR(JIP.Job) + '.'
                      );
                CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Transformer Node selection cannot be made ' +
                             'during auto execution.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
                RETURN (PU_CANCEL);
             ELSE

                RetCode = CALLFRAME SelectHighPotNode 
                          (SelectedEquip = JIP.Equip,
                           SelectedEquipName = JIP.EquipName,
                           SelectedEquipClassName = JIP.EquipClassName);
                 
                IF RetCode = PU_Cancel THEN
                   CALLPROC TraceError (UserMessage = 
                      'WARNING: Node was not selected so High Pot Check ' +
                      'cannot be performed.',
                           TraceMessage =
                      'CheckOpenForHiPot:  ' +
                      'Node was not selected so High Pot Check ' +
                      'cannot be performed for Job = ' + VARCHAR(JIP.Job) + '.'
                      );
                   RETURN (PU_CANCEL);
                ENDIF;

                StartNode = RetCode;
                DynamicWhereClause = StaticWhereClause + 
                         'T1.Node = ' + VARCHAR(StartNode) + ' AND ' +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
             ENDIF;
          ELSE
             DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
          ENDIF;
       ENDIF;
    ENDIF;
/*
** start search with this piece of equipment and then branch out in all
** directions. For every piece of connected equipment, we check for a ground. 
** Issue the warning :
** if no single ground is found in the selected substation,
** if more than one grounf is found in the selected substation and
** If a single ground is found, we look for Open devices on all paths other than 
** where the single ground is found. Issue the waring, if no open device is
** found. If Open devices are found, okey.
*/
    FloatEquip = NULL;
    ClosedOutBnd = NULL;
    CloseLoop  = NULL;

    i = 1;
    MoreObjects = TRUE;
    ClosedPaths = 0;

    WHILE MoreObjects = TRUE DO

      PrevClosedPaths = ClosedPaths;
      ClosedPaths = 0;
      OpenedPaths = 0;
 
     /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            

      MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO

        IF ConnectedEquip[x].Used = FALSE THEN
           FloatFound = TRUE;
           k = 1;
           WHILE k <= TempEquip.LastRow() DO
             IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                FloatFound = FALSE;
                ENDLOOP;
             ENDIF;
             k = k + 1;
           ENDWHILE;

           IF FloatFound = TRUE THEN  /* OK if single terminal device */
              IF ConnectedEquip[x].Terminals = 1 THEN                 
                 OpenedPaths = OpenedPaths + 1;
              ELSE 
                 FloatEquip = ConnectedEquip[x].Duplicate();     
             ENDIF;
           ENDIF;
        ENDIF;

        ConnectedEquip[x].Used = TRUE;
        x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      /* check for ground or open break */
      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
               /* if this equip is in the next objectclause, remove it */
               CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  
         ELSE                                    /* new equip */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());
           
            OpenBreak = FALSE;
            OpenBreak    = CALLPROC ArraySearch(
                                    SearchArray = OpenBreaks,
                                    TargetObject = TempEquip[x].Object);

            IF OpenBreak = FALSE THEN
               OpenBreak = CALLPROC ArraySearch(
                                    SearchArray = PendingBreaks,
                                    TargetObject = TempEquip[x].Object);
            ENDIF;
/*
** If Open Break found, we still need to look at the connected terminal
** to see if a ground was placed there.  If so, we hit the ground first and 
** can proceed as if we hit that ground and ignore the open break.  If the 
** ground is on the object - Terminal 0 - we will recognize the open break 
** first and ignore the ground.
*/ 
            EquipGrounded = FALSE;
            IF OpenBreak = TRUE THEN

               ConnectedEquip[i].Used = TRUE;
               OpenedPaths = OpenedPaths + 1;
               SELECT :EquipGrounded = :TRUE
               FROM   FMS_ObjectStatus
               WHERE  Object = :TempEquip[x].Object AND
                      Terminal = :TempEquip[x].Terminal AND
                      Status = :Status$Ground AND
                      StatusCount > 0;

               IF EquipGrounded = TRUE THEN
                  GroundEquip = TempEquip[x].Duplicate();
                  GroundsCount = GroundsCount + 1;
               ENDIF;            
            ENDIF;

            IF OpenBreak = FALSE AND EquipGrounded = FALSE THEN
               EquipGrounded = CALLPROC ArraySearch(
                                    SearchArray = ExistingGrounds,
                                    TargetObject = TempEquip[x].Object);

               IF EquipGrounded = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;
                  OpenedPaths = OpenedPaths + 1;
                  GroundEquip = TempEquip[x].Duplicate();
                  GroundsCount = GroundsCount + 1;

               ELSE
                  ClosedPaths = ClosedPaths + 1;

                  IF JIP.Substation <> ConnectedEquip[i].PrimaryGrouping THEN
/*
**  The scope of the initial search remains within the same substation.
*/
                     ConnectedEquip[i].Used = TRUE;
                     ClosedOutBnd = ConnectedEquip[i].Duplicate();
                  ENDIF;

               ENDIF;
            ENDIF;

            IF ConnectedEquip[i].Used = FALSE THEN
               CALLPROC InsertValue (ValueList = IncludedObjects, 
                                     Value = ConnectedEquip[i].Object);
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

      IF FloatEquip IS NOT NULL OR
           ClosedOutBnd IS NOT NULL OR
           GroundsCount > 1 THEN
         MoreObjects = FALSE;
      ENDIF;   

    ENDWHILE;
/* 
** Give warning if more than one grounds found
*/
    IF GroundsCount > 1 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                   Text = 'More than one ground found in our isolated area: ' + 
                          GroundEquip.TypeName + ' ' + 
                          GroundEquip.Name +   
                          ' Is the second ground. ' + HC_NEWLINE +
                          'Hi Pot Test Should not be Carried Out on: ' +
                           JIP.EquipClassName + ' ' + JIP.Equipname);         

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;
/*
** Warnings for connectivity errors
*/
    IF FloatEquip IS NOT NULL THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                       '. ' + HC_NEWLINE + 'Connectivity trace discovered ' +
                       'a connectivity problem at: ' + 
                        FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' + FloatEquip.Name);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF ClosedOutBnd IS NOT NULL THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'High Pot check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                       '. ' + HC_NEWLINE +  
                       'Connectivity trace ' +
                       'could not find a Currently Open device ' +
                       'in the direction of: ' +
                        ClosedOutBnd.PrimaryGroupingName + '  ' +
                        ClosedOutBnd.TypeName + '  ' + ClosedOutBnd.Name);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF (CloseLoop  IS NOT NULL OR
           PrevClosedPaths > OpenedPaths) THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'High Pot Check not confirmed for equip: ' + 
                        JIP.EquipClassName + ' ' + JIP.EquipName + 
                        '. ' + HC_NEWLINE +
                        'Connectivity trace could not determine that ' +
                        'all paths are Currently Open.');
/*
Closed Loop: ' + CloseLoop.TypeName + '  ' +
                        CloseLoop.Name + ' was found.');
*/
       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;

    IF GroundsCount = 0 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                   Text = 'No Ground Found in isolated section at ' +
                       'Substation:  ' + 
                       VARCHAR(JIP.SubstationName) +
                           HC_NEWLINE +
                          'Hi Pot Test Should not be Carried Out on: ' +
                           JIP.EquipClassName + ' ' + JIP.Equipname);         

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;
/*
**  If we have a line segment that spans two stations, we need to go into
**  the second station and look for breaks without finding another ground.
**  If not a LineSeg, we are done.
*/
    IF DeviceType <> Type$ACLineSegment THEN
       RETURN (PU_OK);
    ENDIF;
/*
**  Get the other substation, the start node, and other related break/ground 
**  info that we will need for second connectivity trace.
*/
    OtherSubstation = 0;
    TargetNode = 0;
    REPEATED
    SELECT :OtherSubstation = O1.PrimaryGrouping,
           :TargetNode = T1.Node 
    FROM   Udb_Object O1,
           Udb_Object O2,
           Udb_Terminal T1,
           Udb_Terminal T2 
    WHERE  T1.Object = :JIP.Equip AND
           T1.Node >= 20000 AND
           T1.Node = T2.Node AND
           T2.Node >= 20000 AND
           T2.Object <> T1.Object AND
           T2.Object = O1.Object AND
           O1.PrimaryGrouping <> :JIP.Substation AND
           O1.PrimaryGrouping = O2.Object AND
           O2.Type IN ( SELECT Type FROM Udb_ExtendedType
                             WHERE SuperType = :Type$Substation);  

    IF OtherSubstation = 0 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = JIP.EquipClassName + ' ' + JIP.EquipName + 
                       ' is not properly grouped to two substations. ' +  
                       'Could not complete our High Pot Check');        

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF; 

    IF TargetNode = 0 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = JIP.EquipClassName + ' ' + JIP.EquipName + 
                       ' is not properly connected to two substations. ' +  
                       'Could not complete our High Pot Check');        

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;

    DynamicWhereClause = StaticWhereClause + 
                         'T1.Node = ' + VARCHAR(TargetNode) + ' AND ' +
                         'T1.Object IN (' + VARCHAR(JIP.Equip) + ')';
/*
** Look for grounds on the other substation where ACLinesegment connects with.
** Issue warning if any grounds are found in the other substation
*/
    OpenBreaks.Clear();
    PendingBreaks.Clear();
    ExistingGrounds.Clear();
/*
**  Get list of Open Breakers within other substation 
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
            :OpenBreaks[i].Value = S.Object
    FROM Udb_Switch S,
         Udb_Grouping G
    WHERE G.Grouping = :OtherSubstation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = S.Object AND
          S.CurrentlyOpen = :TRUE
    ORDER BY 1
    BEGIN
       i = i + 1;
    END; 
/*
**  Get list of Pending Open Breakers within other substation 
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
            :PendingBreaks[i].Value = G.Member
    FROM   Udb_Grouping G,
           FMS_PendingStatus PS
    WHERE  G.Grouping = :OtherSubstation AND
           G.Relationship = :Interaction$MemberOf AND
           G.Member = PS.Object AND
           PS.IssuedOperator = :Operator AND
           PS.StatusCount > 0 AND
           PS.PendingStatus = :Status$Open
    ORDER BY 1
    BEGIN
       i = i + 1;
    END; 
/*
**  Get list of grounds in other substation
*/
    i = 1;    
    REPEATED    
    SELECT DISTINCT
            :ExistingGrounds[i].Value = OS.Object
    FROM  FMS_ObjectStatus OS,
          Udb_Grouping G
    WHERE G.Grouping = :OtherSubstation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = OS.Object AND
          OS.Status = :Status$Ground 
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;
/*
** start search with this piece of equipment and then branch out in all
** directions. For every piece of connected equipment, we check for a ground. 
** Issue the warning if a ground is found in the other substation,
*/
    GroundsCount = 0;
    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :JIP.Equip AND
           O.Object = T.Object AND
           T.Node > 0;
    ConnectedEquip[1].Used = FALSE;

    FloatEquip = NULL;
    ClosedOutBnd = NULL;
    CloseLoop  = NULL;

    i = 1;
    MoreObjects = TRUE;
    ClosedPaths = 0;

    WHILE MoreObjects = TRUE DO

      PrevClosedPaths = ClosedPaths;
      ClosedPaths = 0;
      OpenedPaths = 0;
 
     /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            

      MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO

        IF ConnectedEquip[x].Used = FALSE THEN
           FloatFound = TRUE;
           k = 1;
           WHILE k <= TempEquip.LastRow() DO
             IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                FloatFound = FALSE;
                ENDLOOP;
             ENDIF;
             k = k + 1;
           ENDWHILE;

           IF FloatFound = TRUE THEN  /* OK if single terminal device */
              IF ConnectedEquip[x].Terminals = 1 THEN                 
                 OpenedPaths = OpenedPaths + 1;
              ELSE 
                 FloatEquip = ConnectedEquip[x].Duplicate();     
             ENDIF;
           ENDIF;
        ENDIF;

        ConnectedEquip[x].Used = TRUE;
        x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      /* check for ground or open break */
      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
               /* if this equip is in the next objectclause, remove it */
               CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  
         ELSE                                    /* new equip */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());
           
            OpenBreak    = CALLPROC ArraySearch(
                                    SearchArray = OpenBreaks,
                                    TargetObject = TempEquip[x].Object);

            IF OpenBreak = FALSE THEN
               OpenBreak = CALLPROC ArraySearch(
                                    SearchArray = PendingBreaks,
                                    TargetObject = TempEquip[x].Object);
            ENDIF;

            IF OpenBreak = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;
                  OpenedPaths = OpenedPaths + 1;
            ELSE
               EquipGrounded = CALLPROC ArraySearch(
                                    SearchArray = ExistingGrounds,
                                    TargetObject = TempEquip[x].Object);

               IF EquipGrounded = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;
                  OpenedPaths = OpenedPaths + 1;
                  GroundEquip = TempEquip[x].Duplicate();
                  GroundsCount = GroundsCount + 1;

               ELSE
                  ClosedPaths = ClosedPaths + 1;

                  IF OtherSubstation <> ConnectedEquip[i].PrimaryGrouping THEN
/*
**  The scope of the initial search remains within the same substation.
*/
                     ConnectedEquip[i].Used = TRUE;
                     ClosedOutBnd = ConnectedEquip[i].Duplicate();
                  ENDIF;

               ENDIF;
            ENDIF;

            IF ConnectedEquip[i].Used = FALSE THEN
               CALLPROC InsertValue (ValueList = IncludedObjects, 
                                     Value = ConnectedEquip[i].Object);
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

      IF FloatEquip IS NOT NULL OR
           ClosedOutBnd IS NOT NULL OR
           GroundsCount > 0 THEN
         MoreObjects = FALSE;
      ENDIF;   

    ENDWHILE;
/* 
** Give warning if a ground found in other substation
*/
    IF GroundsCount > 0 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                   Text = 'Ground found in the other substation at: ' + 
                          GroundEquip.TypeName + ' ' + 
                          GroundEquip.Name +   
                          ' Should not have a ground here. ' + HC_NEWLINE +
                          'Hi Pot Test Should not be Carried Out on: ' +
                           JIP.EquipClassName + ' ' + JIP.Equipname);         

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;
/*
** Warnings for connectivity errors
*/
    IF FloatEquip IS NOT NULL THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'High Pot check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                       '. ' + HC_NEWLINE + 'Connectivity trace discovered ' +
                       'a connectivity problem at: ' + 
                        FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' + FloatEquip.Name);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF ClosedOutBnd IS NOT NULL THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'High Pot check not confirmed for equip: ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                       '. ' + HC_NEWLINE + 'Connectivity trace ' +
                       'could not find a Currently Open device in the direction of: ' +
                        ClosedOutBnd.PrimaryGroupingName + '  ' +
                        ClosedOutBnd.TypeName + '  ' + ClosedOutBnd.Name);       

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF (CloseLoop  IS NOT NULL OR
           PrevClosedPaths > OpenedPaths) THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'High Pot Check not confirmed for equip: ' + 
                        JIP.EquipClassName + ' ' + JIP.EquipName + 
                        '. ' + HC_NEWLINE +
                        'Connectivity trace could not determine that ' +
                        'all paths are Currently Open.');
/*
Closed Loop: ' + CloseLoop.TypeName + '  ' +
                        CloseLoop.Name + ' was found.');
*/
       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;


    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckOpposite4kVNotOut

/*
**      Copyright c 1993 Pateric Software  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckOpposite4kvNotOut
**
**  Date:     Version  Description
** --------------------------------------------------
**  07/31/04  em       Prior to Cutout, evaluates equipment common
**                     to another 4kV feeder to make sure common equip
**                     is not Open and to check that other feeder is
**                     in Service. 
*/
PROCEDURE CheckOpposite4kVNotOut 
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              
    k = INTEGER NOT NULL;    
    CommonEquipment = ARRAY OF Equipment;   
    FeederOut = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;        
    Rated4kV = INTEGER NOT NULL;    /*4kV Rating Object*/
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
   RetCode = NULL;
/*
** Get 4kV Rating Object 
*/
   Rated4kV = 0;
   SELECT  :Rated4kV = Object
   FROM    Udb_Rating
   WHERE   Normal = 4.0;     /*4kV*/

   IF Rated4kV = 0 THEN
      CALLPROC TraceError (UserMessage = 
               'Unable to find 4kV Rating Object.  Must correct in ECC DBM. ' +
               'Contact ECC Database Administrator.',
                           TraceMessage =
               'CheckOpposite4kVNotOpen: Unable to find 4kV Rating Object.  ' +
               'Must correct in ECC DBM. ' +
               'Contact ECC Database Administrator.' 
               );
      RETURN(PU_OK);
   ENDIF;
/*
** Using current equip, get a list of common equipment on the
** same feeder and the common feeders.  
*/
   CommonEquipment.Clear(); 
   i = 1;
   REPEATED
   SELECT DISTINCT
           :CommonEquipment[i].Equip = O.Object,
           :CommonEquipment[i].EquipName = O.Name,
           :CommonEquipment[i].EquipClassName = O.TypeName,
           :CommonEquipment[i].CurrentlyOpen = S.CurrentlyOpen,
           :CommonEquipment[i].PrimaryGrouping = G3.Grouping /*Common Feeder*/
    FROM   Udb_Grouping G1,
           Udb_Grouping G2,
           Udb_Grouping G3,
           Udb_Grouping G4,
           Udb_Object O,
           Udb_Switch S 
    WHERE  G1.Member = :JIP.Equip AND
           G1.Relationship = :Interaction$MemberOf AND
           G1.GroupingType = :Type$Feeder AND
           G1.Grouping = G2.Grouping AND
           G2.Relationship = :Interaction$MemberOf AND
           G2.Member <> :JIP.Equip AND
           G2.Member = S.Object AND
           G2.Member = O.Object AND
           G2.Member = G3.Member AND  
           G3.Relationship = :Interaction$MemberOf AND
           G3.GroupingType = :Type$Feeder AND
           G3.Grouping <> G2.Grouping AND
           G3.Grouping = G4.Member AND
           G4.Relationship = :Interaction$RatedAs AND
           G4.Grouping = :Rated4kV   
    BEGIN
        i = i + 1;
    END;
/*
** Scroll thru looking for Currently Open Device
*/   
    FOR i = 1 TO CommonEquipment.LastRow() DO
       IF CommonEquipment[i].CurrentlyOpen = 1 THEN  /* Open */
           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Device ' + CommonEquipment[i].EquipClassName + '  ' +
                             CommonEquipment[i].EquipName + ' is OPEN. '  + 
                             'Opening this device will cause an Outage on the 4kV ' +
                             'feeder'
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
               RETURN(PU_CANCEL);
           ELSE
               RetCode = Warning$Overridden;
           ENDIF;
       ENDIF;
/*
** Look for CutOut status on Opposite Feeder
*/
       FeederOut = 0;
       SELECT  :FeederOut = Status
       FROM    FMS_ObjectStatus 
       WHERE   Object = :CommonEquipment[i].PrimaryGrouping AND
               Status = :Status$CO;

       IF FeederOut <> 0 THEN
           SELECT  :FeederName = Name
           FROM    Udb_Object 
           WHERE   Object = :CommonEquipment[i].PrimaryGrouping;

           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Common Feeder ' + FeederName + ' is currently ' +
                             'CutOut.' +
                             'Opening this device will cause an Outage on both 4kV ' +
                             'feeders'
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
               RETURN(PU_CANCEL);
           ELSE
               RetCode = Warning$Overridden;
           ENDIF;
       ENDIF;
    
    ENDFOR;
    RETURN (Retcode);
END; 

Application Component Report
============================

	Name:            CheckOpStepCount

/* 
**      Copyright c 1993 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  4GL Procedure:  CheckOpStepCount
** 
**  Modification log: 
** 
**  Date:  	Version		Description 
** -------------------------------------------------- 
** 03/17/03     pkw    Checks to make sure generic operating step
**                     is at correct value.  If it is not, we will
**                     adjust.
** 04/16/03     pkw    Add OTWCount. OTW moves need to be done separately. 
** 02/13/04     em     Use TraceError   
** 05/07/04     pkw    If GenericOpStep does not exist, insert it.
*/ 
PROCEDURE CheckOpStepCount 
(
   Card         = INTEGER NOT NULL WITH DEFAULT;
   i            = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   OpStepCount  = INTEGER NOT NULL WITH DEFAULT;
   TOCount      = INTEGER NOT NULL WITH DEFAULT;
   RSCount      = INTEGER NOT NULL WITH DEFAULT;
   OTWCount     = INTEGER NOT NULL WITH DEFAULT;
   OpStepIncrement = INTEGER NOT NULL WITH DEFAULT;
   MoveCount    = INTEGER NOT NULL WITH DEFAULT;
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
    
   OpStepCount = -1;
   SELECT  :OpStepCount = StepCount
   FROM    FMS_OperatingStepStatus
   WHERE   Card = :Card AND
           OperatingStep = :Type$OperatingStepCount AND
           EndTime = '';
   CALLPROC DDB_ROLLBACK;
   IF OpStepCount = -1 THEN
      /*
      **  It doesn't appear the GenericOpStepCount exists. Let's see if the card is
      **  out of service.  If it is, we will insert the GenericOpStep Count.
      */
      IF SimpleStep IS NULL THEN
         SimpleStep = OperatingStep_ASE.Create();
      ENDIF;    

      SimpleStep.SO.Object = 0;

      SELECT :SimpleStep.SO.BaseType = CardClass,
             :SimpleStep.SO.Object   = Card,
             :SimpleStep.SO.Name     = CardClassName,
             :SimpleStep.SO.Type     = Feeder,
             :SimpleStep.SO.TypeName = FeederName
      FROM    FMS_Card
      WHERE   Card = :Card AND
              Cutout IS NOT NULL AND
              CutIn IS NULL;
      IF SimpleStep.SO.Object = 0 THEN
         SimpleStep = NULL;        
         RETURN;
      ENDIF;

      SimpleStep.OpStep      = Type$OperatingStepCount;

      SimpleStep.SetOpStep();
   
      IF SimpleStep.ReturnCode <> 0 THEN
         CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
            TraceMessage =
             'Procedure:CheckOpStepCount; ' +
             'Error setting an Operating Step. ' +
             'Card=' + VARCHAR(SimpleStep.SO.Object) +
             ';Status=' + VARCHAR(SimpleStep.OpStep) + '.'
             );
             SimpleStep = NULL;
             RETURN;
      ENDIF; 
      SimpleStep = NULL;     
      /*
      **  Now get the count of OpStepCount
      */
      SELECT  :OpStepCount = StepCount
      FROM    FMS_OperatingStepStatus
      WHERE   Card = :Card AND
              OperatingStep = :Type$OperatingStepCount AND
              EndTime = '';
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   IF OpStepCount <> -1 THEN  
/*
**  OperatingStepCount exists.  Now we will see how many
**  outstanding moves there are on the card.
*/
      TOCount = 0;
      REPEATED 
      SELECT :TOCount = Count(*) 
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card  = :Card AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('',:JobStatus$NIS) AND
             J.TOIssued IS NOT NULL AND
             J.TOIssued <> '' AND
             J.TOComplete IS NULL;
      CALLPROC DDB_ROLLBACK;
 
      RSCount = 0;
      REPEATED 
      SELECT :RSCount = Count(*) 
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card  = :Card AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('',:JobStatus$NIS) AND
             J.RSIssued IS NOT NULL AND
             J.RSIssued <> '' AND
             J.RSComplete IS NULL;
      CALLPROC DDB_ROLLBACK;
      
      OTWCount = 0;
      REPEATED 
      SELECT :OTWCount = Count(*) 
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card  = :Card AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('',:JobStatus$NIS) AND
             J.TOIssued IS NOT NULL AND
             J.TOComplete = '' AND
             J.RSIssued = ''AND
             J.RSComplete IS NULL;
      CALLPROC DDB_ROLLBACK;
        
      MoveCount = TOCount + RSCount + OTWCount;

      IF OpStepCount > MoveCount THEN
/*
**  We need to decrement Operating Step Count
*/    
         OpStepIncrement = -1;

        
      ELSEIF OpStepCount < MoveCount THEN
/*
**  We need to increment Operating Step Count.
*/
         OpStepIncrement = 1;
      ENDIF;       

      WHILE OpStepCount <> MoveCount DO
/*
**  Avoid getting into an infinate loop.  We should never
**  get into one, but you never know.  
*/
         IF (OpStepCount <= 0 AND OpStepIncrement < 0) OR
            OpStepCount > 20 THEN
            RETURN;
         ENDIF;
         RetCode = CALLPROC FMS_StepCountUpd(
                      Card = Card,
                      OperatingStep = Type$OperatingStepCount,  
                      Increment = OpStepIncrement);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
                 'CheckOpStepCount encountered a problem ' +
                 'trying to correct Pending Delay accounting mechanism ' +
                 'from ' + varchar(OpStepCount) + ' to ' + 
                  VARCHAR(MoveCount)
                      );
            RETURN;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;  
            
         OpStepCount = OpStepCount + OpStepIncrement;
      ENDWHILE;
   ENDIF;

   RETURN;
END;

Application Component Report
============================

	Name:            CheckOutstandingEquip

/*
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckOutstandingEquip
**
**  Modifications:
**  07/07/06  ysp   Created
**  04/12/10  em    Include JobStatus$NIS when looking at job status
**  12/01/13  pkw   Confirm that all job are confirmed closed on FOD 
**                  orders.
*/
PROCEDURE CheckOutstandingEquip(
   Equip = INTEGER NOT NULL;                        /* passed in */
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
ENDDECLARE
BEGIN
/*
**  Check if equip has a move that was downloaded to an Operating Order
*/
    i = 0;
    REPEATED
    SELECT  :i = COUNT(*)
    FROM    SOA_Job J,
            IR_OpOrderJobs JTS,
            IR_OperatingOrder OO
    WHERE   J.Equip = :Equip AND
 
            (J.TOComplete IS NULL OR
             J.RSComplete IS NULL) AND
            J.Status IN ('',:JobStatus$NIS) AND
            J.MoveCategory = :MoveCategory$Normal AND
            J.Job = JTS.Job AND
            JTS.OrderNumber = OO.OrderNumber AND
            OO.OrderStatus < :Order$ConfirmClosed;
    IF i > 0 THEN
       RETURN PU_CANCEL;
    ENDIF;
 
/*
**  Check if equip has a move that was downloaded to an FOD Order that 
**  still is outstanding or has other moves that are outstanding.
*/
    i = 0;
    REPEATED
    SELECT  :i = COUNT(*)
    FROM    SOA_Job J,
            SOA_Job J2,
            IR_FODOrderJobs FJ1,
            IR_FODOrderJobs FJ2
    WHERE   J.Equip = :Equip AND
            J.Job = FJ1.Job AND
            FJ1.OrderNumber = FJ2.OrderNumber AND
            FJ2.Job = J2.Job AND
            (J2.TOComplete IS NULL OR
             J2.RSComplete IS NULL) AND
            J2.Status IN ('',:JobStatus$NIS) AND
            J2.MoveCategory = :MoveCategory$Normal AND
            FJ2.JobStatus < :Order$ConfirmClosed;
    IF i > 0 THEN
       RETURN PU_CANCEL;
    ENDIF;

   RETURN PU_OK;         
END;

Application Component Report
============================

	Name:            CheckOutstandingInterfaces

/*
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckOutstandingInterfaces
**
**  Modifications:
**  05/01/06  ysp   Created
**  07/07/06  ysp   Modified for ITC 184
**  09/27/06  ysp   Orders in automation setup mode are not considered as outstanding 
**  06/22/09  ysp   Add Work Group(email) request interface
**  08/21/09  ysp   Orders may be set up in Operating Orders before they are issued. 
**                  Check order status BETWEEN Order$Opened AND Order$Closed.
**  09/01/09  ysp   check permits linked to Out-of-Service Work Requests.
**  07/10/13  ysp   Add CardName as an input parameter.
**  10/21/14  em    Add parameter that will skip the incoming message check when triggered by XA21
**                  open auto.
**  02/26/15  pkw   Allow D.O. to override if order is closed.
**  
*/
PROCEDURE CheckOutstandingInterfaces(
   Card = INTEGER NOT NULL;                        /* passed in */
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;  /* passed in */
   MsgOnly = INTEGER NOT NULL WITH DEFAULT;        /* optional: 1 = check msg only; 0 = check all */
   SkipMsg = INTEGER NOT NULL WITH DEFAULT;        /* optional: 1 = skip msg check; 0 = check all */
   SkipFOD = INTEGER NOT NULL WITH DEFAULT;        /* optional: 1 = skip checking FOD order, 0 = check FOD */
   CardName = VARCHAR(40) NOT NULL WITH DEFAULT;   /* optional: blank - current card; otherwise a card name */
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
   ControlText = VARCHAR(200) NOT NULL WITH DEFAULT;
   TORS = INTEGER NOT NULL WITH DEFAULT;
   OrderJob = INTEGER NOT NULL WITH DEFAULT;
   Status = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CardName = '' THEN
      CardName = 'this card';
   ENDIF;
/*
** check if there is an incoming message for this card. 
*/
   IF SkipMsg = FALSE THEN
      i = 0;
      SELECT :i = count(*)
      FROM   MSG_Message M
      WHERE  M.Card = :Card AND
             M.Ack <> :Ack$Delete AND
             M.ToApp = :CurrentApplication;
      CALLPROC DDB_ROLLBACK;
 
      IF i > 0 THEN
         MESSAGE 'There is an incoming message for ' + CardName + '. ' + 
                 'Please process the message first.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;  /*end skip msg*/

   IF MsgOnly = 1 THEN
      RETURN PU_OK;
   ENDIF;
/*
** check if there is an outstanding operating order or a permit that
** is linked to a out-of-service request on this card. 
*/
   IF CurrentApplication = Application$FMS OR
      CurrentApplication = Application$TFMS OR
      CurrentApplication = Application$SLC THEN
      /*
      ** outstanding operating order
      */
      i = 0;
      SELECT :i = OrderNumber,
             :Status = OrderStatus
      FROM   IR_OperatingOrder 
      WHERE  Card = :Card AND
             SwitchingItem = :SwitchingItem AND
             OrderStatus BETWEEN :Order$Opened AND :Order$Closed
      BEGIN
         IF Status >= Order$Closed THEN
  
            RetCode = CALLFRAME ConfirmThreeChoice(pTitle = 'Outstanding Interface Check'
                                ,pConfirmText = 'There is an outstanding operating order on ' + CardName + '.' + HC_NEWLINE +
                                    '     (Order #: ' + VARCHAR(i) + ')' + HC_NEWLINE + HC_NEWLINE +
                                    'Please first attempt to confirm completion of the order.' + HC_NEWLINE + HC_NEWLINE +
                                    'If you continue to receive this warning, report problem to' + HC_NEWLINE +
                                    'technical support and override the warning.' + HC_NEWLINE
                                ,pbtn1text = 'Attempt to Confirm' + HC_NEWLINE +
                                             'Order Closed'
                                ,pbtn2text = 'Override Warning and' + HC_NEWLINE +
                                             'Continue Close Card'
                                ,pbtn3text = 'Cancel'
                                ,pline = 8
                                );
            IF RetCode = 1 THEN
               ControlText = UserName + ';' + VARCHAR(i) + ';';
               CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnOrders', 
                                           DBEventText = ControlText); 
               CALLPROC DDB_COMMIT;
               RETURN PU_CANCEL;

            ELSEIF RetCode = 2 THEN
               IF Status = Order$Rejected THEN
                  Status = Order$ConfirmRejected;
               ELSEIF Status = Order$Rescinded THEN
                  Status = Order$ConfirmRescinded;
               ELSEIF Status = Order$Closed THEN
                  Status = Order$ConfirmClosed;
               ELSE
                  Status = Order$ConfirmClosed;
               ENDIF;

               RetCode = CALLPROC IR_OrderStatusUpd
                        (OrderNumber = i,
                         OrderStatus = Status);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurProcedure.Trace (Text = VARCHAR(DATE('now')) + 
                                 ': WARNING - Order Status ' + 
                                 'not updated to: ' + varchar(Status) + 
                                 ' for order: ' + varchar(i));
                  Message 'Unable to update Operating Order status. ' + 
                          'Please report problem to ' +
                          'technical support.' + HC_NEWLINE + 'Order Status ' + 
                          'not updated to: ' + varchar(Status) + 
                          ' for order: ' + varchar(i);
                  RETURN PU_CANCEL;
               ENDIF;
               CALLPROC DDB_COMMIT; 

            ELSE
               RETURN PU_CANCEL;
            ENDIF;
   
         ELSE
            CALLPROC TraceError (UserMessage = 'There is an outstanding operating order(' + VARCHAR(i) + ') on ' + CardName,
                     TraceMessage = 'CheckOutstandingInterfaces::Outstanding Operating order(' + VARCHAR(i) + ') on ' + CardName);
            RETURN PU_CANCEL;
         ENDIF;
      END;
      CALLPROC DDB_ROLLBACK;

   ENDIF;

   IF CurrentApplication = Application$FMS AND SkipFOD = 0 THEN
      i = 0;
      SELECT :i = FO.OrderNumber,
             :Status = FOJ.JobStatus,
             :OrderJob = FOJ.Job,
             :TORS = FOJ.TORS
      FROM   IR_FODOrder FO,
             IR_FODOrderJobs FOJ
      WHERE  FO.Card = :Card AND
             FO.OrderStatus > :Order$Setup AND
             FO.OrderNumber = FOJ.OrderNumber AND
             FOJ.JobStatus < :Order$ConfirmClosed
      BEGIN
         IF Status >= Order$Closed THEN
  
            RetCode = CALLFRAME ConfirmThreeChoice(pTitle = 'Outstanding Interface Check'
                                ,pConfirmText = 'There is an outstanding FOD order on ' + CardName + '.' + HC_NEWLINE +
                                    '     (Order: ' + VARCHAR(i) + ' Job: ' + VARCHAR(OrderJob) + ')' + HC_NEWLINE + HC_NEWLINE +
                                    'Please first attempt to confirm completion of the order.' + HC_NEWLINE + HC_NEWLINE +
                                    'If you continue to receive this warning, report problem to' + HC_NEWLINE +
                                    'technical support and override the warning.' + HC_NEWLINE
                                ,pbtn1text = 'Attempt to Confirm' + HC_NEWLINE +
                                             'Order Closed'
                                ,pbtn2text = 'Override Warning and' + HC_NEWLINE +
                                             'Continue Close Card'
                                ,pbtn3text = 'Cancel'
                                ,pline = 8
                                );
            IF RetCode = 1 THEN
               ControlText = UserName + ';' + VARCHAR(i) + ';';
               CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnFODOrders', 
                                           DBEventText = ControlText); 
               CALLPROC DDB_COMMIT;
               RETURN PU_CANCEL;

            ELSEIF RetCode = 2 THEN
               IF Status = Order$Rejected THEN
                  Status = Order$ConfirmRejected;
               ELSEIF Status = Order$Rescinded THEN
                  Status = Order$ConfirmRescinded;
               ELSEIF Status = Order$Closed THEN
                  Status = Order$ConfirmClosed;
               ELSE
                  Status = Order$ConfirmClosed;
               ENDIF;

               RetCode = CALLPROC IR_FODJobStatusUpd
                        (OrderNumber = i,
                         Job = OrderJob,
                         TORS = TORS,
                         JobStatus = Status,
                         Pending = 0);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurProcedure.Trace (Text = VARCHAR(DATE('now')) + 
                                 ': WARNING - Order Status ' + 
                                 'not updated to: ' + varchar(Status) + 
                                 ' for order: ' + varchar(i));
                  Message 'Unable to update Operating Order status. ' + 
                          'Please report problem to ' +
                          'technical support.' + HC_NEWLINE + 'Order Status ' + 
                          'not updated to: ' + varchar(Status) + 
                          ' for order: ' + varchar(i);
                  RETURN PU_CANCEL;
               ENDIF;
               CALLPROC DDB_COMMIT; 

            ELSE
               RETURN PU_CANCEL;
            ENDIF;
         ELSE
            CALLPROC TraceError (UserMessage = 'There is an outstanding FOD order(' + VARCHAR(i) + ') on ' + CardName,
                     TraceMessage = 'CheckOutstandingInterfaces::Outstanding FOD order(' + VARCHAR(i) + ') on ' + CardName);
            RETURN PU_CANCEL;
         ENDIF;         
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   IF CurrentApplication = Application$TLS THEN
      /*
      **  Find all outstanding substation orders
      */   
      i = 0;
      SELECT :i = OrderNumber,
             :Status = OrderStatus
      FROM   IR_TelephoneOrder
      WHERE  Card = :Card  AND
             OrderStatus BETWEEN :Order$Opened AND :Order$Closed
      BEGIN
         IF Status >= Order$Closed THEN
  
            RetCode = CALLFRAME ConfirmThreeChoice(pTitle = 'Outstanding Interface Check'
                                ,pConfirmText = 'There is an outstanding Substation Operating order on ' + CardName + '.' + HC_NEWLINE +
                                    '     (Order: ' + VARCHAR(i) + ')' + HC_NEWLINE + HC_NEWLINE +
                                    'Please first attempt to confirm completion of the order.' + HC_NEWLINE + HC_NEWLINE +
                                    'If you continue to receive this warning, report problem' + HC_NEWLINE +
                                    'technical support and override the warning.' + HC_NEWLINE
                                ,pbtn1text = 'Attempt to Confirm' + HC_NEWLINE +
                                             'Order Closed'
                                ,pbtn2text = 'Override Warning and' + HC_NEWLINE +
                                             'Continue Close Card'
                                ,pbtn3text = 'Cancel'
                                ,pline = 8
                                );
            IF RetCode = 1 THEN
               ControlText = UserName + ';' + VARCHAR(i) + ';';
               CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnTLSSSOOrders', 
                                           DBEventText = ControlText); 
               CALLPROC DDB_COMMIT;
               RETURN PU_CANCEL;

            ELSEIF RetCode = 2 THEN
               IF Status = Order$Rejected THEN
                  Status = Order$ConfirmRejected;
               ELSEIF Status = Order$Rescinded THEN
                  Status = Order$ConfirmRescinded;
               ELSEIF Status = Order$Closed THEN
                  Status = Order$ConfirmClosed;
               ELSE
                  Status = Order$ConfirmClosed;
               ENDIF;

               RetCode = CALLPROC IR_TLSOrderStatusUpd
                         (OrderNumber = i,
                          OrderStatus = Status);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurProcedure.Trace (Text = VARCHAR(DATE('now')) + 
                                 ': WARNING - Order Status ' + 
                                 'not updated to: ' + varchar(Status) + 
                                 ' for order: ' + varchar(i));
                  Message 'Unable to update Operating Order status. ' + 
                          'Please report problem to ' +
                          'technical support.' + HC_NEWLINE + 'Order Status ' + 
                          'not updated to: ' + varchar(Status) + 
                          ' for order: ' + varchar(i);
                  RETURN PU_CANCEL;
               ENDIF;
               CALLPROC DDB_COMMIT; 

            ELSE
               RETURN PU_CANCEL;
            ENDIF;
         ELSE
            CALLPROC TraceError (UserMessage = 'There is an outstanding Substation Operating order(' + VARCHAR(i) + ') on ' + CardName,
                     TraceMessage = 'CheckOutstandingInterfaces::Outstanding Substation Operating order(' + VARCHAR(i) + ') on ' + CardName);
            RETURN PU_CANCEL;
         ENDIF;         
      END;
      CALLPROC DDB_ROLLBACK;
            
      /*
      **  Find if there is an outstanding ticket
      */   
      i = 0;
      SELECT :i = COUNT(*)
      FROM   TC_TroubleReportOrder
      WHERE  Card = :TC_CardGlobal AND
             OrderStatus <= :Order$Closed;
      CALLPROC DDB_ROLLBACK;
    
      IF i > 0 THEN
         MESSAGE 'There is an outstanding Verizon ticket on ' + CardName;
         RETURN PU_CANCEL;
      ENDIF;
      /*
      **  Find if there is an outstanding work group request
      */   
      i = 0;
      SELECT :i = COUNT(*)
      FROM   TC_WorkGroupRequest
      WHERE  Card = :TC_CardGlobal AND
             Status <= :Order$Closed;
      CALLPROC DDB_ROLLBACK;
   
      IF i > 0 THEN
         MESSAGE 'There is an outstanding email request on ' + CardName;
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;

   RETURN PU_OK;         
END;

