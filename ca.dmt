               :CurObject.BFOList[i].VFFOD = B.VFFOD,
               :CurObject.BFOList[i].VFFDescription = B.VFFDescription,
               :CurObject.BFOList[i].VFFLastUpd = B.VFFLastUpd,
               :CurObject.BFOList[i].ImportStatus = B.ImportStatus,
               :CurObject.BFOList[i].Action = B.CorrelationAction
         FROM  SOA_NetworkBus N,
               SOA_BusFaultOutage B,
               Udb_Object O1,
               Udb_Object O2,
               SOA_Job J
         WHERE N.Network = :CurObject.FilterObject AND
               N.BusSection = B.BusSection AND
               B.SwitchingItem = J.Job AND
               J.SWItemStatus = :Card$Active AND
               B.Substation = O1.Object AND
               B.BusSection = O2.Object
         ORDER BY CreationTime
         BEGIN
            i = i + 1;
         END;
      ELSE
         CurObject.ReturnCode = -1;   
         CurObject.ErrorMessage = 'Wrong Filter Type to load bus fault outages.';
      ENDIF;               
   ELSE
      REPEATED
      SELECT :CurObject.BFOList[i].Substation = B.Substation,
             :CurObject.BFOList[i].SubstationName = O1.Description,
             :CurObject.BFOList[i].SwitchingItem = B.SwitchingItem,
             :CurObject.BFOList[i].CreationTime = B.CreationTime,
             :CurObject.BFOList[i].BusSection = B.BusSection,
             :CurObject.BFOList[i].BusSectionName = O2.Name,
             :CurObject.BFOList[i].BDPhaseA = B.BDPhaseA,
             :CurObject.BFOList[i].BDPhaseB = B.BDPhaseB,
             :CurObject.BFOList[i].BDPhaseC = B.BDPhaseC,
             :CurObject.BFOList[i].BDRelayName = B.BDRelayName,
             :CurObject.BFOList[i].BDLastUpd = B.BDLastUpd,
             :CurObject.BFOList[i].BOCPhaseA = B.BOCPhaseA,
             :CurObject.BFOList[i].BOCPhaseB = B.BOCPhaseB,
             :CurObject.BFOList[i].BOCPhaseC = B.BOCPhaseC,
             :CurObject.BFOList[i].BOCPhaseN = B.BOCPhaseN,
             :CurObject.BFOList[i].BOCRelayName = B.BOCRelayName,
             :CurObject.BFOList[i].BOCLastUpd = B.BOCLastUpd,
/*
             :CurObject.BFOList[i].BUTOperated = B.BUTOperated,
             :CurObject.BFOList[i].BUTRelayName = B.BUTRelayName,
             :CurObject.BFOList[i].BUTLastUpd = B.BUTLastUpd,
*/
             :CurObject.BFOList[i].BUTOperated = B.FBMPR,
             :CurObject.BFOList[i].BUTRelayName = B.FBMPRValue,
             :CurObject.BFOList[i].BUTLastUpd = B.FBMPRTime,

             :CurObject.BFOList[i].ClFdrBkr = B.ClFdrBkr,
             :CurObject.BFOList[i].ClFdrBkrs = B.ClFdrBkrs,
             :CurObject.BFOList[i].ClFdrBkrLastUpd = B.ClFdrBkrLastUpd,
             :CurObject.BFOList[i].FTFeeder = B.FTFeeder,
             :CurObject.BFOList[i].FTPhaseA = B.FTPhaseA,
             :CurObject.BFOList[i].FTPhaseB = B.FTPhaseB,
             :CurObject.BFOList[i].FTPhaseC = B.FTPhaseC,
             :CurObject.BFOList[i].FTPhaseN = B.FTPhaseN,
             :CurObject.BFOList[i].FTRelayName = B.FTRelayName,
             :CurObject.BFOList[i].FTLastUpd = B.FTLastUpd,
             :CurObject.BFOList[i].PQFound = B.PQFound,
             :CurObject.BFOList[i].PQValue = B.PQValue,
             :CurObject.BFOList[i].PQTime = B.PQTime,
             :CurObject.BFOList[i].VBFault = B.VBFault,
             :CurObject.BFOList[i].VBFDescription = B.VBFDescription,
             :CurObject.BFOList[i].VBFLastUpd = B.VBFLastUpd,

             :CurObject.BFOList[i].FBMPR = B.FBMPR,
             :CurObject.BFOList[i].FBMPRValue = B.FBMPRValue,
             :CurObject.BFOList[i].FBMPRTime = B.FBMPRTime,
             :CurObject.BFOList[i].FBLOR = B.FBLOR,
             :CurObject.BFOList[i].FBLORValue = B.FBLORValue,
             :CurObject.BFOList[i].FBLORTime = B.FBLORTime,
             :CurObject.BFOList[i].BBMPR = B.BBMPR,
             :CurObject.BFOList[i].BBMPRValue = B.BBMPRValue,
             :CurObject.BFOList[i].BBMPRTime = B.BBMPRTime,
             :CurObject.BFOList[i].BBLOR = B.BBLOR,
             :CurObject.BFOList[i].BBLORValue = B.BBLORValue,
             :CurObject.BFOList[i].BBLORTime = B.BBLORTime,
             :CurObject.BFOList[i].PQRMSFound = B.PQRMSFound,
             :CurObject.BFOList[i].PQRMSValue = B.PQRMSValue,
             :CurObject.BFOList[i].PQRMSTime = B.PQRMSTime,
             :CurObject.BFOList[i].MHEvent = B.MHEvent,
             :CurObject.BFOList[i].MHDescription = B.MHDescription,
             :CurObject.BFOList[i].MHLastUpd = B.MHLastUpd,                   
             :CurObject.BFOList[i].VFFOD = B.VFFOD,
             :CurObject.BFOList[i].VFFDescription = B.VFFDescription,
             :CurObject.BFOList[i].VFFLastUpd = B.VFFLastUpd,
             :CurObject.BFOList[i].ImportStatus = B.ImportStatus,
             :CurObject.BFOList[i].Action = B.CorrelationAction
      FROM   SOA_BusFaultOutage B,
             Udb_Object O1,
             Udb_Object O2,
             SOA_ArchiveJob J
      WHERE  B.Substation = :CurObject.Substation AND
             B.SwitchingItem = J.Job AND
             B.Substation = O1.Object AND
             B.BusSection = O2.Object AND
             B.CreationTime >= :StartDate AND
             B.CreationTime <= :EndDate
      ORDER BY CreationTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   FOR i = 1 TO CurObject.BFOList.LastRow DO
      SELECT :CurObject.BFOList[i].FTFeederName = O.Name
      FROM   UDB_Object O
      WHERE  O.Object = :CurObject.BFOList[i].FTFeeder;

      CurObject.BFOList[i].EvaluateCondition();
 
      IF ActiveOutage = TRUE THEN
         CurObject.GetRecommendation(BFCCond = ByRef(CurObject.BFOList[i]));
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

/* 
** This method is called from BFC Web Service.
*/
METHOD GetAllOutages(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';

   CurObject.BFOList.Clear();
   i = 1;
   REPEATED
   SELECT :CurObject.BFOList[i].Substation = B.Substation,
          :CurObject.BFOList[i].SubstationName = O1.Description,
          :CurObject.BFOList[i].BusSection = B.BusSection,
          :CurObject.BFOList[i].BusSectionName = O2.Name
   FROM   SOA_BusFaultOutage B,
          Udb_Object O1,
          Udb_Object O2,
          SOA_Job J
   WHERE  B.SwitchingItem = J.Job AND
          J.SWItemStatus = :Card$Active AND
          B.Substation = O1.Object AND
          B.BusSection = O2.Object
   ORDER BY Substation
   BEGIN
      k = 1;
      SELECT :CurObject.BFOList[i].NWList[k].Object = N.Network,
             :CurObject.BFOList[i].NWList[k].Name = O.Description
      FROM   SOA_NetworkBus N,
             UDB_Object O
      WHERE  N.BusSection = :CurObject.BFOList[i].BusSection AND
             N.Network = O.Object
      BEGIN
         k = k + 1;
      END;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

/* 
** This method is called from BFC Web Service.
*/
METHOD GetBFCRequest(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   DateInGMT = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';

   CurObject.LoadBFCMatrices();
   CurObject.LoadOutageList(ActiveOutage = TRUE);

   FOR i = 1 TO CurObject.BFOList.LastRow DO
      // CreateTimeChar
      CurObject.BFOList[i].CreateTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].CreationTime));
      DateInGMT = DATE(CurObject.BFOList[i].CreateTimeChar);

      CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].CreateTimeChar));
      
      // BDLastUpdChar 
      IF CurObject.BFOList[i].BDLastUpd = '' THEN
         CurObject.BFOList[i].BDLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].BDLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].BDLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].BDLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].BDLastUpdChar));
      ENDIF;

      // BOCLastUpdChar 
      IF CurObject.BFOList[i].BOCLastUpd = '' THEN
         CurObject.BFOList[i].BOCLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].BOCLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].BOCLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].BOCLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].BOCLastUpdChar));
      ENDIF;

      // BUTLastUpdChar
      IF CurObject.BFOList[i].BUTLastUpd = '' THEN
         CurObject.BFOList[i].BUTLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].BUTLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].BUTLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].BUTLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].BUTLastUpdChar));
      ENDIF;

      // FTLastUpdChar
      IF CurObject.BFOList[i].FTLastUpd = '' THEN
         CurObject.BFOList[i].FTLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].FTLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].FTLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].FTLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].FTLastUpdChar));
      ENDIF;

      // ClFdrBkrLastUpdChar
      IF CurObject.BFOList[i].ClFdrBkrLastUpd = '' THEN
         CurObject.BFOList[i].ClFdrBkrLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].ClFdrBkrLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].ClFdrBkrLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].ClFdrBkrLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].ClFdrBkrLastUpdChar));
      ENDIF;

      // VBFLastUpdChar
      IF CurObject.BFOList[i].VBFLastUpd = '' THEN
         CurObject.BFOList[i].VBFLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].VBFLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].VBFLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].VBFLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].VBFLastUpdChar));
      ENDIF;

      // PQTimeChar
      IF CurObject.BFOList[i].PQTime = '' THEN
         CurObject.BFOList[i].PQTimeChar = '';
      ELSE
         CurObject.BFOList[i].PQTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].PQTime));
         DateInGMT = DATE(CurObject.BFOList[i].PQTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].PQTimeChar));
      ENDIF;

      // PQRMSTimeChar
      IF CurObject.BFOList[i].PQRMSTime = '' THEN
         CurObject.BFOList[i].PQRMSTimeChar = '';
      ELSE
         CurObject.BFOList[i].PQRMSTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].PQRMSTime));
         DateInGMT = DATE(CurObject.BFOList[i].PQRMSTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].PQRMSTimeChar));
      ENDIF;

      // FBMPRTimeChar
      IF CurObject.BFOList[i].FBMPRTime = '' THEN
         CurObject.BFOList[i].FBMPRTimeChar = '';
      ELSE
         CurObject.BFOList[i].FBMPRTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].FBMPRTime));
         DateInGMT = DATE(CurObject.BFOList[i].FBMPRTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].FBMPRTimeChar));
      ENDIF;
      
      // FBLORTimeChar
      IF CurObject.BFOList[i].FBLORTime = '' THEN
         CurObject.BFOList[i].FBLORTimeChar = '';
      ELSE
         CurObject.BFOList[i].FBLORTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].FBLORTime));
         DateInGMT = DATE(CurObject.BFOList[i].FBLORTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].FBLORTimeChar));
      ENDIF;

      // BBMPRTimeChar
      IF CurObject.BFOList[i].BBMPRTime = '' THEN
         CurObject.BFOList[i].BBMPRTimeChar = '';
      ELSE
         CurObject.BFOList[i].BBMPRTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].BBMPRTime));
         DateInGMT = DATE(CurObject.BFOList[i].BBMPRTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].BBMPRTimeChar));
      ENDIF;
      
      // BBLORTimeChar
      IF CurObject.BFOList[i].BBLORTime = '' THEN
         CurObject.BFOList[i].BBLORTimeChar = '';
      ELSE
         CurObject.BFOList[i].BBLORTimeChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].BBLORTime));
         DateInGMT = DATE(CurObject.BFOList[i].BBLORTimeChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].BBLORTimeChar));
      ENDIF;

      // MHLastUpdChar
      IF CurObject.BFOList[i].MHLastUpd = '' THEN
         CurObject.BFOList[i].MHLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].MHLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].MHLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].MHLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].MHLastUpdChar));
      ENDIF;

      // VFFLastUpdChar
      IF CurObject.BFOList[i].VFFLastUpd = '' THEN
         CurObject.BFOList[i].VFFLastUpdChar = '';
      ELSE
         CurObject.BFOList[i].VFFLastUpdChar = VARCHAR(DATE_GMT(CurObject.BFOList[i].VFFLastUpd));
         DateInGMT = DATE(CurObject.BFOList[i].VFFLastUpdChar);

         CALLPROC ConvertDate (Rawdate = DATE_GMT(DateInGMT), 
                            OutPutDate = BYREF(CurObject.BFOList[i].VFFLastUpdChar));
      ENDIF;
      
   ENDFOR;

   RETURN;
END;

