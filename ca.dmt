**  Application:    FMS_BusinessLogic
**  Class:          ItemCategory_ASE
**
**  Date:       Version Description
** ----------------------------------
**  07/15/03    pkw     Created; 
*/ 
METHOD LoadEquip (
)=
DECLARE
   i 	        = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   PrevEquip    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Select Equipment On the card that is linked to a active information
** items on an slc card.  Use ItemCategory class and put Equipment into the
** Category column.  Parse out highest severity level.
*/ 
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   PrevEquip = 0;
   i = 1;
   REPEATED 
   SELECT   :CurObject.EquipList[i].Category = E.Equip,
            :CurObject.EquipList[i].Severity = I.Severity
   FROM     SLC_InformationItemEquip E,
            SLC_InformationItem I,
            SOA_Job J,
            SOA_JobControl JC,
            SOA_Job J2
   WHERE    JC.Card = :CurObject.Card AND
            JC.Job = J.Job AND
            J.Equip = E.Equip AND
            E.Job = I.Job AND
            I.Job = J2.Job AND
            J2.MoveCategory = :MoveCategory$InformationItem AND
            J2.SwItemStatus = :Card$Active 
   ORDER BY 1,2
   BEGIN
      IF CurObject.EquipList[i].Category <> PrevEquip THEN
         PrevEquip = CurObject.EquipList[i].Category;
         i = i + 1;
      ENDIF;
   END;
   RETURN;
END;

