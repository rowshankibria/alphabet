	Name:            FaultCorrelationClass


���p8���Component Method Scripts
���p8���--------------------------
/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:CurObject.    CAC
**  Frame:CurObject.          FaultCorrelationClass
**
**  Date:CurObject.       Version Description
** ----------------------------------
**  07/30/08  ysp   Created
**  06/23/09  ysp   Add fault description field.
**  10/10/18  ysp   Add Second Fault information
**  02/29/24  ysp   Change IR_FaultCorrelation event from FCR to FSS
*/
METHOD GetFaultCorrelation (
)=
DECLARE
   i = INTEGER NOT NULL;
   CurDBTime = DATE NOT NULL WITH DEFAULT;
   PhaseA = CHAR(3) NOT NULL WITH DEFAULT;
   PhaseB = CHAR(3) NOT NULL WITH DEFAULT;
   PhaseC = CHAR(3) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT  :CurObject.LastUpdate = TimeStamp,
           :CurObject.inrushfound = inrushfound ,
           :CurObject.inrushvalue = inrushvalue ,
           :CurObject.inrushtime  = inrushtime  ,
           :CurObject.rtffound    = rtffound    ,
           :CurObject.rtfvalue    = rtfvalue    ,
           :CurObject.rtftime     = rtftime     ,
           :CurObject.rtfound     = rtfound     ,
           :CurObject.rtvalue     = rtvalue     ,
           :CurObject.rttime      = rttime      ,
           :CurObject.damagefound = damagefound ,
           :CurObject.damagevalue = damagevalue ,
           :CurObject.damagetime  = damagetime  ,
           :CurObject.secondfaultfound = secondfaultfound,
           :CurObject.secondfaultvalue = secondfaultvalue,
           :CurObject.secondfaulttime  = secondfaulttime ,
           :CurObject.visiblefaultfound = visiblefaultfound,
           :CurObject.visiblefaultvalue = visiblefaultvalue,
           :CurObject.visiblefaulttime  = visiblefaulttime ,
           :CurObject.RecommendAction   = RecommendAction  ,
           :CurObject.RecommendTime     = RecommendTime
    FROM   FMS_FaultCorrelation
    WHERE  Card = :CurObject.Card;
    CALLPROC DDB_ROLLBACK;

    /*
    ** If Visible Fault value is "ACTUAL", get fault phases.
    */
    CurObject.VisibleFaultPhases = '';

    IF UPPERCASE(CurObject.VisibleFaultValue) LIKE '%TENTATIVE%' THEN
       SELECT :CurObject.FaultDescription = FaultDescription
       FROM   FMS_Fault
       WHERE  Card = :CurObject.Card AND
              FODTentativeOrActual = 'TENTATIVE';

    ELSEIF UPPERCASE(CurObject.VisibleFaultValue) LIKE '%ACTUAL%' THEN
       SELECT :PhaseA = FODPhaseA,
              :PhaseB = FODPhaseB,
              :PhaseC = FODPhaseC,
              :CurObject.FaultDescription = FaultDescription
       FROM   FMS_Fault
       WHERE  Card = :CurObject.Card AND
              FODTentativeOrActual = 'ACTUAL';

       IF PhaseA = 'YES' OR PhaseB = 'YES' OR PhaseC = 'YES' THEN
          CurObject.VisibleFaultPhases = CurObject.VisibleFaultPhases + ' PH: ';
          IF PhaseA = 'YES' THEN
             CurObject.VisibleFaultPhases = CurObject.VisibleFaultPhases + 'A';
          ENDIF;
          IF PhaseB = 'YES' THEN
             CurObject.VisibleFaultPhases = CurObject.VisibleFaultPhases + 'B';
          ENDIF;
          IF PhaseC = 'YES' THEN
             CurObject.VisibleFaultPhases = CurObject.VisibleFaultPhases + 'C';
          ENDIF;
       ENDIF;
    ENDIF;

/*
** if the fault correlation has not been updated in the last five minutes, check 
** if the card has passed the RGTC step. If it doesn't, request an update.
*/
   CurObject.DataRefreshed = 0;

   SELECT :CurDBTime = DATE('NOW');
   IF DATE(CurObject.LastUpdate + '5 minutes') < CurDBTime THEN
      i = 0;
      SELECT :i = 1
      FROM   FMS_OperatingStepStatus
      WHERE  Card = :CurObject.Card AND
             OperatingStep = :Type$RGTC;
      CALLPROC DDB_ROLLBACK;

      IF i = 0 THEN
         SELECT :i =1
         FROM   FMS_DBEventQueue
         WHERE  ToApp = 'FSS' AND
                Name = 'IR_FaultCorrelation' AND
                Text = VARCHAR(:CurObject.Card);
         IF i = 0 THEN
            CALLPROC InsertDBEventQueue(EventName = 'IR_FaultCorrelation',
                               EventText = VARCHAR(CurObject.Card),
                               ToApp = 'FSS');
            CurObject.DataRefreshed = 1;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN;
END;

Application Component Report
============================

	Name:            FCR_ReturnOptions

/*
**
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation.
**
**  Application:    FeederCard
**  Frame:          FCR_ReturnOptions
**
**  Date:           Version  Description
** --------------------------------------------------
**  09/03/02   pkw  Create for ISO release.
**  12/16/02   ysp  Merge: convert to FMS_Job table.      
**  03/11/03   pkw  Load jobs array for card being passed in.
**  12/14/05   ysp  Increase the size of tomove to 160 chars
**  06/02/06   ysp  FCR Enhancement: provide the list of equipment to drop/pickup 
**                  returned from FGO or returned work permit.
**  08/01/06   ysp  Select downloaded equip from ir_downloadequip table.
**  09/05/06   ysp  Add logic to transfer equipment to an existing ISO card.
**  09/12/06   ysp  Check if the equipment is a member of the current feeder after
**                  the DO processes the drop/pickup before removing the equipment 
**                  from the screen.
**  11/02/06   ysp  Add FGO rejection
**  04/16/07   ysp  ITC210: Insert IR interface event in DB event queue
**  04/21/09   em   For KPS drop equipment, enable Create KPS ISO.
**  04/22/09   em   Initiate close check after drop/pickup
**  04/23/09   em   Revise remove equip logic for KPS device since it remains
**                  common to main feeder 
**  03/28/11   pkw  Convert to 3G
**  12/01/14   pkw  When selecting step down transformer also select SD-VIS.
**  12/16/16   em   Add ForceComplete option to drive Pick/Drop for force completed
**                  FCR Permit.
**  02/13/17   em   Make permit trim invisible for ForceComplete
**  09/10/19   em   Add Change Source option
**  07/19/21   em   Increase DynamicWhereClause, possible culprit for trace log error.
**  01/24/22   em   Use Source attribute to control Change Source option.
**  01/08/24   em   Add check for OpenKPS before initiating Known Point Splice creation.
*/
INITIALIZE   
(   C = FMS_Card;	       /* parameter - current card */ 
    LocalDivisions = ARRAY OF ObjectSummaryClass;  /* List of Local divisions */
    ControlMsg = INTEGER;      /* parameter */
    ControlPermit = INTEGER;   /* parameter */
    ForceComplete = INTEGER NOT NULL WITH DEFAULT; /*parameter*/

    i = integer not null;      /* Temporary counter */ 
    j = integer not null;      /* Temporary counter */ 
    m = integer not null;      /* Temporary counter */ 
    ChosenEquip = ARRAY OF FMS_Equip;
    DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
    DestFeeder = integer NOT NULL;
    EquipListString = VARCHAR(400) NOT NULL WITH DEFAULT;
    EventText = VARCHAR(120) NOT NULL WITH DEFAULT;
    FeederCheck = VARCHAR(40) NOT NULL;
    FromFeeder = integer NOT NULL;
    grnd_cnt = integer not null;  /* Temporary counter */ 
    ISOFeederList = ARRAY OF ObjectSummaryClass; /* List of available ISO feeders */
    ISONumber = VARCHAR(20) NOT NULL;
    ISOCheck = ARRAY OF TYPECLASS;
    ISDropSource = INTEGER NOT NULL WITH DEFAULT;
    ISPickSource = INTEGER NOT NULL WITH DEFAULT;
    ISPickOnISO = INTEGER NOT NULL WITH DEFAULT;
    DropSourceName = VARCHAR(40) NOT NULL WITH DEFAULT;
    PickSourceName = VARCHAR(40) NOT NULL WITH DEFAULT;    
    Jobs = ARRAY OF Job;     
    KPS_ISO = INTEGER NOT NULL WITH DEFAULT;  
    next_cnt = integer not null;  /* Temporary counter */ 
    PickDrop = VARCHAR(40) NOT NULL;
    RetCode = INTEGER;
    SimpleJob = Job_ASE DEFAULT NULL; /* Enables use of class methods */
    SourceKPS = FMS_Equip;
) =
DECLARE
   FindEquipLocation = PROCEDURE;
   RemoveSelectedEquip = PROCEDURE;
   SD_Link = PROCEDURE;
   ComparePickDropSource = PROCEDURE RETURNING INTEGER;
ENDDECLARE
/*
**  Load the data for the equipment selection from the database 
**  into the 4GL environment and set up the display: 
*/
BEGIN
/*
**  Read in the jobs
*/
   IF SimpleJob IS NULL THEN
      SimpleJob = Job_ASE.Create();
   ENDIF;
     
   SimpleJob.Card = C.Card;    
   SimpleJob.ArchiveCard = FALSE;
   SimpleJob.Application = CurrentApplication;
   SimpleJob.LoadJobs();
   
   IF SimpleJob.ReturnCode <> 0 THEN
      Message SimpleJob.ErrorMessage;
      RETURN;
   ENDIF;

   Jobs.Clear();
   Jobs = SimpleJob.J.Duplicate();
   SimpleJob = NULL;
   
   IF ControlMsg <> 0 THEN         /* process returned FGO.   */
      FIELD(Reject_Btn).CurBias = FB_LANDABLE;

      /*
      ** list outstanding work permits on the card
      */
      i = 1;
      EquipListString = '';
      TF.Clear();

      REPEATED
      SELECT  :TF[i].Job = J.Job,
              :TF[i].ToMove = J.ToMove,
              :TF[i].ReturnRemark = WP.Description
      FROM    SOA_JobControl JC,
              SOA_Job J,
              FMS_JobAction JA,
              FMS_WorkPermit WP
      WHERE   JC.Card = :C.Card AND
              JC.StepPair = :StepHeading$OTW AND
              JC.Job = J.Job AND
              J.TOIssued IS NOT NULL AND
              J.RSComplete IS NULL AND
              J.JobClass = JA.JobClass AND
              JA.TypeOfCard = :C.TypeOfCard AND
              JA.EquipClass = 0 AND                /*All FCR permits are equip none*/
              JA.Status = :Prompt$FromWorkFCR AND
              J.Job = WP.PermitJobId
      BEGIN
         IF EquipListString <> '' THEN
            EquipListString = EquipListString + ',';
         ENDIF;
         EquipListString = EquipListString + VARCHAR(TF[i].Job);

         i = i + 1;
      END;
      
      IF TF.LastRow() > 4 THEN
         FIELD(TF).NumVisibleRows = 4;
      ELSE
         FIELD(TF).NumVisibleRows = TF.LastRow();
      ENDIF;

      /*
      ** Show all the equipment that were downloaded with work permits
      ** on the current card.
      */
      DynamicWhereClause = 'E.WorkPermit IN (' + EquipListString + ') AND ' +
              'E.Equip = O.Object';

      i = 1;
      REPEATED
      SELECT  :DOEquip[i].Equip = O.Object,  
              :DOEquip[i].EquipName = O.Name, 
              :DOEquip[i].EquipClass  = O.Type, 
              :DOEquip[i].EquipClassName  = O.TypeName, 
              :DOEquip[i].Description = O.Description,
              :DOEquip[i].G = E.Type  
      FROM    Udb_Object O,
              IR_DownloadEquip E
      WHERE   :DynamicWhereClause 
      ORDER BY 6 DESC
      BEGIN
         IF DOEquip[i].G = 0 THEN
            DOEquip[i].Comment = 'Drop';
         ELSE
            DOEquip[i].Comment = 'Pickup';
         ENDIF;
         i = i + 1;
      END;

      /*
      ** Get the picked-up equipment returned from FCR
      */
      DynamicWhereClause = 'E.WorkPermit IN (' + EquipListString + ') AND ' +
                           'E.Type = 1 AND ' + 
                           'E.ReturnFGO = ' + VARCHAR(ControlMsg) + ' AND ' +
                           'E.Equip = O.Object';
      i = 1;
      REPEATED
      SELECT  :PF.PickEquip[i].Equip = O.Object,  
              :PF.PickEquip[i].EquipName = O.Name, 
              :PF.PickEquip[i].EquipClass  = O.Type, 
              :PF.PickEquip[i].EquipClassName  = O.TypeName, 
              :PF.PickEquip[i].Origin = O.OwnerNumber, 
              :PF.PickEquip[i].Inservice = O.Inservice, 
              :PF.PickEquip[i].Outservice = O.Outservice, 
              :PF.PickEquip[i].Description = O.Description,
              :PF.PickEquip[i].Source = E.Source 
      FROM    Udb_Object O,
              IR_DownloadEquip E  
      WHERE   :DynamicWhereClause 
      ORDER BY EquipName 
      BEGIN
         i = i + 1;
      END;
      
      /*
      ** Get the dropped equipment returned from FCR
      */
      DynamicWhereClause = 'E.WorkPermit IN (' + EquipListString + ') AND ' +
                           'E.Type = 0 AND ' + 
                           'E.ReturnFGO = ' + VARCHAR(ControlMsg) + ' AND ' +
                           'E.Equip = O.Object';
      i = 1;
      KPS_ISO = FALSE;
      REPEATED
      SELECT  :DF.DropEquip[i].Equip = O.Object,  
              :DF.DropEquip[i].EquipName = O.Name, 
              :DF.DropEquip[i].EquipClass  = O.Type, 
              :DF.DropEquip[i].EquipClassName  = O.TypeName, 
              :DF.DropEquip[i].Origin = O.OwnerNumber, 
              :DF.DropEquip[i].Inservice = O.Inservice, 
              :DF.DropEquip[i].Outservice = O.Outservice, 
              :DF.DropEquip[i].Description = O.Description,
              :DF.DropEquip[i].Source = E.Source  
      FROM    Udb_Object O,
              IR_DownloadEquip E  
      WHERE   :DynamicWhereClause  
      ORDER BY EquipName 
      BEGIN
         SELECT :KPS_ISO = 1
         FROM   Udb_ExtendedType 
         WHERE  Type = :DF.DropEquip[i].EquipClass AND
                SuperType = :Type$KPS; 
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

   ELSEIF ControlPermit <> 0 THEN 
      FIELD(Reject_Btn).CurBias = FB_INVISIBLE;

      TF.Clear();
      REPEATED
      SELECT  :TF[1].ToMove = J.ToMove,
              :TF[1].ReturnRemark = WP.Description
      FROM    SOA_Job J,
              FMS_WorkPermit WP
      WHERE   J.Job = :ControlPermit AND
              J.Job = WP.PermitJobId;
      CALLPROC DDB_ROLLBACK;
      
      FIELD(TF).NumVisibleRows = 1;

      /*
      ** Show all the equipment that were downloaded with the work permit
      ** on the current card.
      */
      i = 1;
      REPEATED
      SELECT  :DOEquip[i].Equip = O.Object,  
              :DOEquip[i].EquipName = O.Name, 
              :DOEquip[i].EquipClass  = O.Type, 
              :DOEquip[i].EquipClassName  = O.TypeName, 
              :DOEquip[i].Description = O.Description,
              :DOEquip[i].G = E.Type   
      FROM    Udb_Object O,
              IR_DownloadEquip E
      WHERE   E.WorkPermit = :ControlPermit AND
              E.Equip = O.Object 
      ORDER BY 6 DESC
      BEGIN
         IF DOEquip[i].G = 0 THEN
            DOEquip[i].Comment = 'Drop';
            IF ForceComplete = TRUE THEN 
               FIELD(df.DropEquip).Title = 'Select Equipment to Drop';
               FIELD(permit_trim).CurBias = FB_INVISIBLE;
               j = df.DropEquip.LastRow;
               df.DropEquip.InsertRow (RowNumber = j+1, RowObject = DOEquip[i].Duplicate() );
            ENDIF;
         ELSE
            DOEquip[i].Comment = 'Pickup';
            IF ForceComplete = TRUE THEN 
               FIELD(pf.PickEquip).Title = 'Select Equipment to Pickup';
               FIELD(permit_trim).CurBias = FB_INVISIBLE;
               j = pf.PickEquip.LastRow;
               pf.PickEquip.InsertRow (RowNumber = j+1, RowObject = DOEquip[i].Duplicate() );
            ENDIF;
         ENDIF;
         i = i + 1;
      END;

      /*
      ** Get the picked-up equipment returned from FCR
      */
      i = 1;
      REPEATED
      SELECT  :PF.PickEquip[i].Equip = O.Object,  
              :PF.PickEquip[i].EquipName = O.Name, 
              :PF.PickEquip[i].EquipClass  = O.Type, 
              :PF.PickEquip[i].EquipClassName  = O.TypeName, 
              :PF.PickEquip[i].Origin = O.OwnerNumber, 
              :PF.PickEquip[i].Inservice = O.Inservice, 
              :PF.PickEquip[i].Outservice = O.Outservice, 
              :PF.PickEquip[i].Description = O.Description,
              :PF.PickEquip[i].Source = E.Source 
      FROM    Udb_Object O,
              IR_DownloadEquip E  
      WHERE   E.WorkPermit = :ControlPermit AND
              E.Type = 1 AND
              E.ReturnPermit = :ControlPermit AND
              E.Equip = O.Object 
      ORDER BY EquipName 
      BEGIN
         i = i + 1;
      END;
      
      /*
      ** Get the dropped equipment returned from FCR
      */
      i = 1;
      KPS_ISO = FALSE;
      REPEATED
      SELECT  :DF.DropEquip[i].Equip = O.Object,  
              :DF.DropEquip[i].EquipName = O.Name, 
              :DF.DropEquip[i].EquipClass  = O.Type, 
              :DF.DropEquip[i].EquipClassName  = O.TypeName, 
              :DF.DropEquip[i].Origin = O.OwnerNumber, 
              :DF.DropEquip[i].Inservice = O.Inservice, 
              :DF.DropEquip[i].Outservice = O.Outservice, 
              :DF.DropEquip[i].Description = O.Description,
              :DF.DropEquip[i].Source = E.Source  
      FROM    Udb_Object O,
              IR_DownloadEquip E  
      WHERE   E.WorkPermit = :ControlPermit AND
              E.Type = 0 AND
              E.ReturnPermit = :ControlPermit AND
              E.Equip = O.Object 
      ORDER BY EquipName 
      BEGIN
         SELECT :KPS_ISO = 1
         FROM   Udb_ExtendedType 
         WHERE  Type = :DF.DropEquip[i].EquipClass AND
                SuperType = :Type$KPS; 
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
/*
**  Load the create iso option list
*/
      i = 1;
      ISOCheck.Clear();
      REPEATED
      SELECT DISTINCT
             :ISOCheck[i].Name = XferTOISO
      FROM    IR_WorkLocation
      WHERE   WorkPermit = :ControlPermit AND
              LocationStatus = 'XFER TO ISO'
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK; 
   ELSE
      RETURN;
   ENDIF;
   
   IF FIELD(TF).NumVisibleRows = 1 THEN
      FIELD(TF).ActiveRow = 1;
   ENDIF;
  
   Field(PF.transferto_btn).TextLabel = 'Transfer to ' + C.FeederName;
   Field(DF.transferfrom_btn).TextLabel = 'Transfer from ' + C.FeederName;

   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems.Clear();
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[1].EnumText = '';
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[2].EnumValue = 1;
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[2].EnumText = 'Xfer to ISO';
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[3].EnumValue = 2;
   FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[3].EnumText = 'Create ISO';
   J = 4;
   IF KPS_ISO <> FALSE THEN
      j = 5;
      FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[4].EnumValue = 3;
      FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[4].EnumText = 'Create Known Pt ISO';
   ENDIF;
   
   IF ISOCheck.LastRow() <> 0 THEN
      FOR i = 1 TO ISOCheck.LastRow() DO
         FeederCheck = C.FeederName + '-' + ISOCheck[i].Name;
         FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[j].EnumValue = j;
         FIELD(DF.CreateIso_opt).ValueList.ChoiceItems[j].EnumText = 'Create ' + FeederCheck;     
         j = j + 1;
      ENDFOR;
   ENDIF;
   FIELD(DF.CreateIso_opt).UpdChoiceList();

   IF PF.PickEquip.LastRow() = 0 THEN
         FIELD(PF).CurBias = FB_INVISIBLE;
   ELSE
      CALLPROC FindEquipLocation(EquipList = ByRef(PF.PickEquip));
      FOR i = 1 TO PF.PickEquip.LastRow DO
         PF.PickEquip[i].Comment = PF.PickEquip[i].FeederName;
         FOR j = 1 TO CardDetails.Object.LastRow DO 
            IF PF.PickEquip[i].Feeder = CardDetails.Object[j].Object THEN
               PF.PickEquip[i].Comment = PF.PickEquip[i].FeederName + ' (Already Picked Up)';
               ENDLOOP;
            ENDIF;
         ENDFOR;
      ENDFOR;
   ENDIF;  

   IF DF.DropEquip.LastRow() = 0 THEN
         FIELD(DF).CurBias = FB_INVISIBLE;
   ELSE
      CALLPROC FindEquipLocation(EquipList = ByRef(DF.DropEquip));
      FOR i = 1 TO DF.DropEquip.LastRow() DO
         DF.DropEquip[i].Comment = DF.DropEquip[i].FeederName;
         FOR j = 1 TO CardDetails.Object.LastRow DO 
            IF DF.DropEquip[i].Feeder = CardDetails.Object[j].Object THEN
               ENDLOOP;
            ENDIF;            
         ENDFOR;
         IF j > CardDetails.Object.LastRow THEN
            DF.DropEquip[i].Comment = DF.DropEquip[i].FeederName + ' (Already Dropped)';         
         ENDIF;
      ENDFOR;
   ENDIF;

   IF PF.PickEquip.LastRow() = 0 AND DF.DropEquip.LastRow() = 0 THEN
      FIELD(NoEquipReturnedText).CurBias = FB_VISIBLE;
   ELSE
      FIELD(NoEquipReturnedText).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** Evaluate for Change Source condition by checking for proper setup 
*/
   RetCode = CALLPROC ComparePickDropSource();

   IF RetCode = PU_OK THEN
            FIELD(PF.changesource_btn).TextLabel = 'Change Source' + HC_NEWLINE +
                                                   'From ' + DropSourceName +
                                                   ' To ' + PickSourceName;
            FIELD(PF.changesource_btn).CurBias = FB_LANDABLE;
            FIELD(PF.PickEquip).CurBias = FB_VISIBLE;
            FIELD(DF.DropEquip).CurBias = FB_VISIBLE;
   ENDIF;
/*
** Evaluate for Change Source condition.  All must be true.
**  - One equipment to Pickup
**  - One equipment to Drop
**  - Each equipment is a Source type
**  - The equipment to Pickup is on an ISO associated to the current feeder
*
   IF PF.PickEquip.Lastrow = 1 AND DF.DropEquip.LastRow = 1 THEN
      IsPickSource = 0;
      SELECT :IsPickSource = Type
      FROM   Udb_ExtendedType
      WHERE  Type = :PF.PickEquip[1].EquipClass AND
             SuperType = :Type$Source;
      IsDropSource = 0;
      SELECT :IsDropSource = Type
      FROM   Udb_ExtendedType
      WHERE  Type = :DF.DropEquip[1].EquipClass AND
             SuperType = :Type$Source;
             
      IF IsPickSource > 0 AND IsDropSource > 0 THEN
         ISPickOnISO = 0;
         SELECT :ISPickOnISO = G2.Grouping
         FROM   Udb_Grouping G1,
                Udb_Grouping G2
         WHERE  G1.Grouping = :C.Feeder AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.MemberType = :Type$ISOFeeder AND
                G1.Member = G2.Grouping AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.Member = :PF.PickEquip[1].Equip;
                
         IF ISPickOnISO > 0 THEN
            FIELD(PF.changesource_btn).TextLabel = 'Change Source' + HC_NEWLINE +
                                                   'From ' + DF.DropEquip[1].EquipName +
                                                   ' To ' + PF.PickEquip[1].EquipName;
            FIELD(PF.changesource_btn).CurBias = FB_LANDABLE;
            FIELD(PF.PickEquip).CurBias = FB_VISIBLE;
            FIELD(DF.DropEquip).CurBias = FB_VISIBLE;
         ENDIF;
      ENDIF;
   ENDIF;
*/   
   CurFrame.Flush();
   CurFrame.WindowHeight = Field(Close_btn).ParentField.ParentField.OuterHeight;
END;

ON CHILDENTRY tf =
BEGIN
   PermitDescription = tf[].ReturnRemark;
END;

ON CHILDENTRY PF.PickEquip = 
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   i = FIELD(PF.PickEquip).CurRow;
   
   IF PF.PickEquip[i].Source LIKE 'S%' AND FIELD(PF.changesource_btn).CurBias = FB_LANDABLE THEN
      MESSAGE 'This equipment established for Change Source function, cannot be selected.';
      RESUME;
   ENDIF;

   IF FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE THEN
      FIELD(PF.PickEquip[i].EquipClassName).IsReverse = FALSE;
      FIELD(PF.PickEquip[i].EquipName).IsReverse = FALSE;
      FIELD(PF.PickEquip[i].Description).IsReverse = FALSE;
      FIELD(PF.PickEquip[i].Comment).IsReverse = FALSE;
      
      CALLPROC SD_Link(Object = PF.PickEquip[i].Equip,
                       IsReverse = FALSE,
                       Type = PF.PickEquip[i].EquipClass,
                       List = 'PF');
      /*
      ** check to see if there are any highlighted rows 
      */
      FOR j = 1 TO PF.PickEquip.LastRow() DO
         IF FIELD(PF.PickEquip[j].EquipName).IsReverse = TRUE THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
 
      IF j > PF.PickEquip.LastRow() THEN
         FIELD(PF.Pickup_Btn).CurBias = FB_DIMMED;
         FIELD(PF.TransferTo_Btn).CurBias = FB_DIMMED;
      ENDIF;
   ELSE
      IF FIELD(PF.Pickup_Btn).CurBias = FB_LANDABLE THEN
         IF PF.PickEquip[i].Feeder > 0 THEN
            MESSAGE 'This equipment is on a feeder. You can not pick it up with equipment in the New/Drop bank. ' +  
                    'They have to be in separate pickups.';
            RESUME;
         ENDIF;
      ELSEIF FIELD(PF.TransferTo_Btn).CurBias = FB_LANDABLE THEN
         IF PF.PickEquip[i].Feeder = 0 THEN
            MESSAGE 'This equipment is in the New/Drop bank. You can not mix it with equipment you have already selected. ' +  
                    'They have to be in separate pickups.';
            RESUME;
         ENDIF;
         
         FOR j = 1 TO CardDetails.Object.LastRow DO
            IF PF.PickEquip[i].Feeder = CardDetails.Object[j].Object THEN
               MESSAGE 'This equipment is already on the current feeder.';
               RESUME;          
            ENDIF; 
         ENDFOR;

         /*
          ** check to see if this equipment is on the same feeder as other highlighted equipment 
          */
          FOR j = 1 TO PF.PickEquip.LastRow() DO
             IF FIELD(PF.PickEquip[j].EquipName).IsReverse = TRUE AND 
                PF.PickEquip[j].Feeder <> PF.PickEquip[i].Feeder THEN
                MESSAGE 'This equipment is on a different feeder. ' +  
                    'They have to be in separate transfers.';
                RESUME;
             ENDIF;
         ENDFOR;
      ELSE
         FOR j = 1 TO CardDetails.Object.LastRow DO
            IF PF.PickEquip[i].Feeder = CardDetails.Object[j].Object THEN
               MESSAGE 'This equipment is already on the current feeder.';
               RESUME;
            ENDIF;
         ENDFOR;          
      ENDIF;

      FIELD(PF.PickEquip[i].EquipClassName).IsReverse = TRUE;
      FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE;
      FIELD(PF.PickEquip[i].Description).IsReverse = TRUE;
      FIELD(PF.PickEquip[i].Comment).IsReverse = TRUE;

      CALLPROC SD_Link(Object = PF.PickEquip[i].Equip,
                       IsReverse = TRUE,
                       Type = PF.PickEquip[i].EquipClass,
                       List = 'PF');

      IF PF.PickEquip[i].Feeder > 0 THEN
         FIELD(PF.TransferTo_Btn).CurBias = FB_LANDABLE;
      ELSE
         FIELD(PF.Pickup_Btn).CurBias = FB_LANDABLE;
      ENDIF;
   ENDIF;
END;


ON CHILDENTRY DF.DropEquip = 
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   i = FIELD(DF.DropEquip).CurRow;

   IF DF.DropEquip[i].Source LIKE 'S%' AND FIELD(PF.changesource_btn).CurBias = FB_LANDABLE THEN
      MESSAGE 'This equipment established for Change Source function, cannot be selected.';
      RESUME;
   ENDIF;
   
   FOR j = 1 TO CardDetails.Object.LastRow DO
      IF DF.DropEquip[i].Feeder = CardDetails.Object[j].Object THEN
         ENDLOOP;
      ENDIF;
   ENDFOR;

   IF j > CardDetails.Object.LastRow THEN
      MESSAGE 'This equipment is not on the current feeder. You can not drop it from here.';
      RESUME;
   ENDIF;

   IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN
      FIELD(DF.DropEquip[i].EquipClassName).IsReverse = FALSE;
      FIELD(DF.DropEquip[i].EquipName).IsReverse = FALSE;
      FIELD(DF.DropEquip[i].Description).IsReverse = FALSE;
      FIELD(DF.DropEquip[i].Comment).IsReverse = FALSE;

      CALLPROC SD_Link(Object = DF.DropEquip[i].Equip,
                       IsReverse = FALSE,
                       Type = DF.DropEquip[i].EquipClass,
                       List = 'DF');
      /*
      ** check to see if there are any highlighted rows 
      */
      FOR j = 1 TO DF.DropEquip.LastRow() DO
         IF FIELD(DF.DropEquip[j].EquipName).IsReverse = TRUE THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF j > DF.DropEquip.LastRow() THEN
         FIELD(DF.Drop_Btn).CurBias = FB_DIMMED;
         FIELD(DF.TransferFrom_Btn).CurBias = FB_DIMMED;
         FIELD(DF.CreateIso_opt).CurBias = FB_DIMMED;
      ENDIF;

   ELSE
      FIELD(DF.DropEquip[i].EquipClassName).IsReverse = TRUE;
      FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE;
      FIELD(DF.DropEquip[i].Description).IsReverse = TRUE;
      FIELD(DF.DropEquip[i].Comment).IsReverse = TRUE;
      
      CALLPROC SD_Link(Object = DF.DropEquip[i].Equip,
                       IsReverse = TRUE,
                       Type = DF.DropEquip[i].EquipClass,
                       List = 'DF');

      FIELD(DF.Drop_Btn).CurBias = FB_LANDABLE;
      FIELD(DF.TransferFrom_Btn).CurBias = FB_LANDABLE;
      FIELD(DF.CreateIso_opt).CurBias = FB_CHANGEABLE;
   ENDIF;
END;


ON CLICK PF.changesource_btn = 
DECLARE
   OldS = INTEGER NOT NULL;
   OldSP = INTEGER NOT NULL;
   OldSName = VARCHAR(40) NOT NULL;
   OldSPName = VARCHAR(40) NOT NULL;
   NewS = INTEGER NOT NULL;
   NewSP = INTEGER NOT NULL;
   NewSName = VARCHAR(40) NOT NULL;
   
BEGIN
   IF CurFrame.ConfirmPopUp (messagetext = 'Confirm Change Feeder Source?') = PU_CANCEL THEN
      RESUME;
   ENDIF;
/*
** Replace with updated logic
*/
   i = 1; 
   WHILE i <= PF.PickEquip.LastRow DO
      IF PF.PickEquip[i].Source = 'S' THEN
         FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE; 
         NewS = PF.PickEquip[i].Equip;
         NewSP = PF.PickEquip[i].Equip;
         NewSName = PF.PickEquip[i].EquipName;
         ENDLOOP;
      ELSEIF PF.PickEquip[i].Source = 'SB' THEN
         FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE; 
         NewS = PF.PickEquip[i].Equip;
         NewSName = PF.PickEquip[i].EquipName;
      ELSEIF PF.PickEquip[i].Source = 'SP' THEN
         FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE; 
         NewSP = PF.PickEquip[i].Equip;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   i = 1; 
   WHILE i <= DF.DropEquip.LastRow DO
      IF DF.DropEquip[i].Source = 'S' THEN
         FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE; 
         OldS = DF.DropEquip[i].Equip;
         OldSName = DF.DropEquip[i].EquipName;
         OldSP = DF.DropEquip[i].Equip;
         OldSPName = DF.DropEquip[i].EquipName;
         ENDLOOP;
      ELSEIF DF.DropEquip[i].Source = 'SB' THEN
         FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE; 
         OldS = DF.DropEquip[i].Equip;
         OldSName = DF.DropEquip[i].EquipName;
      ELSEIF DF.DropEquip[i].Source = 'SP' THEN
         FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE; 
         OldSP = DF.DropEquip[i].Equip;
         OldSPName = DF.DropEquip[i].EquipName;
      ENDIF;
      i = i + 1;
   ENDWHILE;
           
   RetCode = CALLPROC ChangeSourceFCRPermit (C = C,
                           OldS = OldS, NewS = NewS,
                           OldSP = OldSP, NewSP = NewSP, NewSName = NewSName,
                           OldSName = OldSName, OldSPName = OldSPName);
                                                     
   IF RetCode = PU_OK THEN
         CALLPROC RemoveSelectedEquip(Type = 1);
         CALLPROC RemoveSelectedEquip(Type = 0);
         FIELD(PF.changesource_btn).CurBias = FB_DIMMED;
         CurFrame.SendUserEvent (EventName = 'CheckClose');
   ENDIF;
END;


ON CLICK PF.Pickup_btn =
BEGIN
/*   CALLFRAME PickupEquipment (C=C, EffectiveDivisions = LocalDivisions);
*/
   ChosenEquip.Clear();
   j = 1;
   FOR i = 1 TO PF.PickEquip.LastRow() DO
       IF FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE THEN
          ChosenEquip[j] = PF.PickEquip[i].Duplicate();
          j = j + 1;
       ENDIF;
   ENDFOR;
   RetCode = CALLFRAME ConfirmPickupEquip(C = C, 
                                ChosenEquip = ChosenEquip); 
   CALLPROC DDB_COMMIT; 

   IF RetCode = PU_OK THEN
      CALLPROC RemoveSelectedEquip(Type = 1);
      FIELD(PF.Pickup_Btn).CurBias = FB_DIMMED;
      FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'CheckClose');      
   ENDIF;
END;

ON CLICK PF.TransferTo_btn =
BEGIN
/*
   FromFeeder = CALLFRAME SelectFeederForTransfer
                   (Action = 'From'); 
   IF FromFeeder = PU_CANCEL THEN 
      RESUME;
   ENDIF;
*/
   ChosenEquip.Clear();
   j = 1;
   FOR i = 1 TO PF.PickEquip.LastRow() DO
       IF FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE THEN
          ChosenEquip[j] = PF.PickEquip[i].Duplicate();
          j = j + 1;
       ENDIF;
   ENDFOR;
  
   RetCode = CALLFRAME TransferFrom(C = C,
                          SourceFeeder = ChosenEquip[1].Feeder,
                          SelectEquip = ChosenEquip);

   IF RetCode = PU_OK THEN
      CALLPROC RemoveSelectedEquip(Type = 1);
      FIELD(PF.TransferTo_btn).CurBias = FB_DIMMED;
      FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'CheckClose');
   ENDIF;
END;

ON CLICK DF.Drop_btn =
BEGIN
   ChosenEquip.Clear();
   j = 1;
   FOR i = 1 TO DF.DropEquip.LastRow() DO
       IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN
          ChosenEquip[j] = DF.DropEquip[i].Duplicate();
          j = j + 1;
       ENDIF;
   ENDFOR;

   RetCode = CALLFRAME DropEquipment(C=C,Jobs=Jobs, SelectEquip = ChosenEquip);

   IF RetCode = PU_OK THEN
      CALLPROC RemoveSelectedEquip(Type = 0);
      FIELD(DF.Drop_Btn).CurBias = FB_DIMMED;
      FIELD(DF.TransferFrom_Btn).CurBias = FB_DIMMED;
      FIELD(DF.CreateIso_opt).CurBias = FB_DIMMED;

      FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'CheckClose');
   ENDIF;
END;

ON UserEvent 'TransferToISO',
ON CLICK DF.TransferFrom_btn =
BEGIN
   IF CURFRAME.ReasonCode = RC_MOUSECLICK THEN
      DestFeeder = CALLFRAME SelectFeederForTransfer 
                  (Action = 'To'); 
   ELSE
      DestFeeder = Curframe.MessageInteger;
   ENDIF;

   IF DestFeeder = PU_CANCEL THEN 
      RESUME;
   ENDIF;

   ChosenEquip.Clear();
   j = 1;
   FOR i = 1 TO DF.DropEquip.LastRow() DO
       IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN
          ChosenEquip[j] = DF.DropEquip[i].Duplicate();
          j = j + 1;
       ENDIF;
   ENDFOR;

   RetCode = CALLFRAME TransferTo (C=C,
                        DestinationFeeder=DestFeeder,
                        Jobs=Jobs,
                        SelectEquip = ChosenEquip);

   IF RetCode = PU_OK THEN
      CALLPROC RemoveSelectedEquip(Type = 0);
      FIELD(DF.Drop_Btn).CurBias = FB_DIMMED;
      FIELD(DF.TransferFrom_Btn).CurBias = FB_DIMMED;
      FIELD(DF.CreateIso_opt).CurBias = FB_DIMMED;

      FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'CheckClose');
   ENDIF;
END;

ON SetValue DF.CreateIso_opt =
BEGIN
   IF DF.CreateIso_opt = 1 THEN
      /* Get the ISO cards on this feeder */
      ISOFeederList.Clear();
      i = 1;
      SELECT :ISOFeederList[i].Object = C.Feeder,   /*OK for 3G, this is an ISO*/
             :ISOFeederList[i].Name = C.FeederName
      FROM   Udb_Grouping G,
             FMS_Card C,
             TFMS_CardToObject CTO
      WHERE  CTO.Card = :C.Card AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$ISOFeeder AND
             G.Member = C.Feeder AND
             C.Status < :Card$Closed
      BEGIN
           i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      IF ISOFeederList.LastRow() = 0 THEN
         MESSAGE 'No ISO cards exist on this feeder.';
      ELSE
         DestFeeder = CALLFRAME SelectFeeder 
                                     (SelectFeeder = ISOFeederList); 
         IF DestFeeder > 0 THEN
            CurFrame.SendUserEvent (EventName = 'TransferToISO',
                              MessageInteger = DestFeeder);
         ENDIF;
      ENDIF;

   ELSEIF DF.CreateIso_opt > 3 THEN
/*
**  Check to make sure Iso Feeder does not already exist.
*/
      ISONumber = '';
      ISONumber = Shift(FIELD(DF.CreateIso_opt).CurEnumText,(-1*Locate(FIELD(DF.CreateIso_opt).CurEnumText,'-')));
      CurFrame.SendUserEvent (EventName = 'CreateISO');
      
   ELSEIF DF.CreateIso_opt = 2 THEN
      ISONumber = '';
      CurFrame.SendUserEvent (EventName = 'CreateISO');
   ELSEIF DF.CreateIso_opt = 3 THEN
      CurFrame.SendUserEvent (EventName = 'CreateKPSISO');
   ENDIF;
   DF.CreateIso_opt = 0;
END;


ON USEREVENT 'CreateKPSISO' =
DECLARE
   OpenKPS = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   ChosenEquip.Clear();
   j = 1;
   SourceKPS = NULL;
   KPS_ISO = FALSE;
   FOR i = 1 TO DF.DropEquip.LastRow() DO
       IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN

          ChosenEquip[j] = DF.DropEquip[i].Duplicate();
          SELECT :KPS_ISO = 1
          FROM   Udb_ExtendedType  
          WHERE  Type = :DF.DropEquip[i].EquipClass AND
                 SuperType = :Type$KPS; 
          IF KPS_ISO = 1 AND SourceKPS IS NULL THEN
             OpenKPS = FALSE;
             SELECT :OpenKPS = 1
             FROM   Udb_Switch
             WHERE  Object = :DF.DropEquip[i].Equip AND
                    CurrentlyOpen = 1;
             IF OpenKPS = 1 THEN
                SourceKPS = FMS_Equip.Create();
                SourceKPS = DF.DropEquip[i].Duplicate();
             ENDIF;
          ENDIF;

          j = j + 1;
       ENDIF;
   ENDFOR;

   IF SourceKPS IS NULL THEN
      MESSAGE 'Must select an Open KPS device to transfer to Known Pt ISO.';
      RESUME;
   ENDIF; 

      CALLFRAME CreateKnownPointSplice (
             C = C,
             Jobs = Jobs,
             SelectedSB = SourceKPS,
             ISOEquip = ChosenEquip);

      /*
      ** check if equipment has been transferred from the current feeder.
      */
      j = 0;
      FOR i = 1 TO ChosenEquip.LastRow() DO
         IF SourceKPS.Equip <> ChosenEquip[i].Equip THEN 
            SELECT :j = 1
            FROM   Udb_Grouping G,
                   TFMS_CardToObject CTO
            WHERE  CTO.Card = :C.Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$Memberof AND
                   G.Member = :ChosenEquip[i].Equip;
            IF j = 1 THEN
               ENDLOOP;
            ENDIF; 
         ENDIF;
      ENDFOR;
      
      IF j = 0 THEN
         CALLPROC RemoveSelectedEquip(Type = 0);  
         FIELD(DF.Drop_Btn).CurBias = FB_DIMMED;
         FIELD(DF.TransferFrom_Btn).CurBias = FB_DIMMED;
         FIELD(DF.CreateIso_opt).CurBias = FB_DIMMED;

         FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
         CurFrame.SendUserEvent (EventName = 'CheckClose');
      ENDIF;      
      FCFrame.PurgeUserEvent (EventName = 'UpdateISOButton');
      FCFrame.SendUserEvent (EventName = 'UpdateISOButton');    
END;


ON USEREVENT 'CreateIso' =
BEGIN
   ChosenEquip.Clear();
   j = 1;
   FOR i = 1 TO DF.DropEquip.LastRow() DO
       IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN
          ChosenEquip[j] = DF.DropEquip[i].Duplicate();
          j = j + 1;
       ENDIF;
   ENDFOR;

   FeederCheck = C.FeederName + '-' + ISONumber;

   m = 0;
   REPEATED 
   SELECT :m = COUNT(*) 
   FROM    Udb_Object
   WHERE   Name = :FeederCheck AND
           Type = :Type$ISOFeeder;
   CALLPROC DDB_ROLLBACK;

   IF m = 0 THEN
      CALLFRAME CreateISO (
             ISOCard = C,
             Jobs = Jobs,
             ControlISO = ISONumber,
             SelectEquip = ChosenEquip);

      /*
      ** check if equipment has been transferred from the current feeder.
      */
      j = 0;
      FOR i = 1 TO ChosenEquip.LastRow() DO
         SELECT :j = 1
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :C.Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$Memberof AND
                G.Member = :ChosenEquip[i].Equip;
         IF j = 1 THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      
      IF j = 0 THEN
         CALLPROC RemoveSelectedEquip(Type = 0);  
         FIELD(DF.Drop_Btn).CurBias = FB_DIMMED;
         FIELD(DF.TransferFrom_Btn).CurBias = FB_DIMMED;
         FIELD(DF.CreateIso_opt).CurBias = FB_DIMMED;

         FIELD(Reject_Btn).CurBias = FB_INVISIBLE;
         CurFrame.SendUserEvent (EventName = 'CheckClose');
      ENDIF;      
      FCFrame.PurgeUserEvent (EventName = 'UpdateISOButton');
      FCFrame.SendUserEvent (EventName = 'UpdateISOButton');    
   ELSE
      MESSAGE FeederCheck + ' already exists.  Please try again.';
      RESUME;
   ENDIF;
END;

ON CLICK Close_btn,
ON USEREVENT 'CheckClose' = 
BEGIN
   /*
   ** make sure all equipment has been dropped or picked up  
   */
   m = FALSE;
   FOR i = 1 TO PF.PickEquip.LastRow DO
      FOR j = 1 TO CardDetails.Object.LastRow DO
         IF PF.PickEquip[i].Feeder = CardDetails.Object[j].Object THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF j > CardDetails.Object.LastRow THEN
         IF ForceComplete = TRUE THEN
            IF m = TRUE THEN
               CONTINUE;
            ENDIF;
            IF CurFrame.ConfirmPopup (MessageText = 
                        'There is still equipment to pick up. ' +
                        'Click OK to exit without picking up.') = PU_CANCEL THEN
               RESUME;
            ELSE
                  m = TRUE;  /*Don't repeat message*/
            ENDIF;
         ELSE
            MESSAGE 'There is still equipment to pick up.';
            RESUME;
         ENDIF;       
      ENDIF;
   ENDFOR;

   m = FALSE;
   FOR i = 1 TO DF.DropEquip.LastRow() DO
      FOR j = 1 TO CardDetails.Object.LastRow DO
         IF DF.DropEquip[i].Feeder = CardDetails.Object[j].Object THEN
            IF ForceComplete = TRUE THEN
               IF m = TRUE THEN
                  CONTINUE;
               ENDIF;  
               IF CurFrame.ConfirmPopup (MessageText = 
                        'There is still equipment to drop. ' +
                        'Click OK to exit without dropping.') = PU_CANCEL THEN
                  RESUME;
               ELSE
                  m = TRUE;  /*Don't repeat message*/
               ENDIF;
            ELSE
               MESSAGE 'There is still equipment to drop.';
               RESUME;
            ENDIF;       
         ENDIF;
      ENDFOR;
   ENDFOR;

   IF ControlMsg <> 0 THEN
/*
** Insert the FGO Status
*/
      m = 0;
      SELECT :m = COUNT(*) 
      FROM   FMS_ObjectStatus OS,
             TFMS_CardToObject CTO
      WHERE  CTO.Card = :C.Card AND
             CTO.Object = OS.Object AND
             OS.Status = :Status$FGO AND
             OS.StatusCount > 0;

      IF m = 0 THEN
         FOR j = 1 TO CardDetails.Object.LastRow DO
            RetCode = CALLPROC FMS_ObjStatIns (
                  Object = CardDetails.Object[j].Object,
                  Status = Status$FGO,
                  StatusCount = 1,
                  TimeSet = 'now');
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Error setting Feeder status to FGO. Feeder could ' +
                       'not be successfully returned FGO. Contact Tech Support.';
               RESUME;
            ENDIF;
         ENDFOR; 
      ENDIF;
      CALLPROC DDB_COMMIT;  
/*
** update all the outstanding Work Permit Moves' Response column
*/
       FOR i = 1 TO TF.LastRow() DO
           TF[i].Response = 'Field grds only';
           TF[i].ResponseUpd();
       ENDFOR;
       CALLPROC DDB_COMMIT;
/*
** Update the log
*/
       CALLPROC SOA_LogIns (
                  Card = C.Card,
                  Job = NULL,
                  Item = 'FGO',
                  Old = 'FCR returned feeder FGO',
                  New = '',
                  Time = Date('now'),
                  UserName = DOp.Description);
       CALLPROC DDB_COMMIT;
/*
** Send acknowledgement back to FCR.
*/
       EventText = VARCHAR(C.Card) + ';' + 
                   VARCHAR(ControlMsg) + ';ACK;' + 
                   VARCHAR(DATE('now')) + ';' + 
                   DOp.Description + ';';
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_AcknowledgeFGO', 
                     EventText = EventText);  
   ENDIF;

   RETURN;
END;

ON CLICK Reject_btn =
BEGIN
   RetCode = CALLFRAME RejectFGO (Card = C.Card,
                                  ControlMsg = IFNULL(ControlMsg, 0));
   
   IF RetCode = PU_OK THEN
      RETURN;
   ENDIF;
END;

/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Procedure RemoveSelectedEquip(
   Type = INTEGER NOT NULL;
)= 
DECLARE
   i = integer not null;      /* Temporary counter */ 
   KPSEquip = INTEGER NOT NULL WITH DEFAULT;
   OnTheFeeder = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Type = 0 THEN
      KPSEquip = 0;
      IF SourceKPS IS NOT NULL THEN
         KPSEquip = SourceKPS.Equip;
      ENDIF;
      i = DF.DropEquip.LastRow();
      WHILE i > 0 DO
         IF FIELD(DF.DropEquip[i].EquipName).IsReverse = TRUE THEN
            /*
            ** Check to see if it is still a member of the current feeder
            ** SourceKPS must be a member of another feeder. 
            */
            IF DF.DropEquip[i].Equip = KPSEquip THEN

               OnTheFeeder = 0;
               SELECT :OnTheFeeder  = 1
               FROM   UDB_Grouping G
               WHERE  G.Member = :DF.DropEquip[i].Equip AND
                      G.Relationship = :Interaction$Memberof AND
                      G.GroupingType = :Type$SubFeeder;
               IF OnTheFeeder = 1 THEN
                  DF.DropEquip.RemoveRow(RowNumber = i);
               ENDIF;

            ELSE

               OnTheFeeder = 0;
               SELECT :OnTheFeeder  = 1
               FROM   UDB_Grouping G,
                      TFMS_CardToObject CTO
               WHERE  CTO.Card = :C.Card AND
                      CTO.Object = G.Grouping AND
                      G.Member = :DF.DropEquip[i].Equip AND
                      G.Relationship = :Interaction$Memberof;
               IF OnTheFeeder = 0 THEN
                  DF.DropEquip.RemoveRow(RowNumber = i);
               ENDIF;

            ENDIF;
         ENDIF;
         i = i - 1;
      ENDWHILE;
   ELSE
      i = PF.PickEquip.LastRow();
      WHILE i > 0 DO
         IF FIELD(PF.PickEquip[i].EquipName).IsReverse = TRUE THEN
            /*
            ** Check to see if it is a member of the current feeder
            */
            OnTheFeeder = 0;
            SELECT :OnTheFeeder  = 1
            FROM   UDB_Grouping G,
                   TFMS_CardToObject CTO
            WHERE  CTO.Card = :C.Card AND
                   CTO.Object = G.Grouping AND
                   G.Member = :PF.PickEquip[i].Equip AND
                   G.Relationship = :Interaction$Memberof;

            IF OnTheFeeder = 1 THEN
               PF.PickEquip.RemoveRow(RowNumber = i);
            ENDIF;
         ENDIF;
         i = i - 1;
      ENDWHILE;
   ENDIF;
END;


Procedure FindEquipLocation(
   EquipList = ARRAY OF FMS_Equip;
)
= 
DECLARE
   i = integer not null;      /* Temporary counter */ 
ENDDECLARE
BEGIN
/*
** Find the feeders, New/Drop banks the equipment belongs to.
** Use OwnerNumber attribute to indicate the type of grouping.
*/
   FOR i = 1 TO EquipList.LastRow() DO
       /* 
       ** see if the equipment is a member of a feeder
       */
       REPEATED
       SELECT :EquipList[i].FeederName = O.Name,
              :EquipList[i].Feeder = O.Object
       FROM   Udb_Object O, 
              Udb_Grouping G 
       WHERE  G.Member = :EquipList[i].Equip AND
              G.Relationship = :Interaction$Memberof AND
              G.GroupingType IN (SELECT  Type 
                                    FROM    Udb_ExtendedType
                                    WHERE   SuperType = :Type$Feeder) AND 
              G.Grouping = O.Object AND
              O.Name != VARCHAR(O.Object);

       IF EquipList[i].FeederName = '' THEN
          /*
          ** in NEW or DROP Bank
          */
          IF EquipList[i].OutService IS NOT NULL  AND EquipList[i].OutService <> '' THEN 
             EquipList[i].FeederName = 'Drop Bank';
             EquipList[i].Feeder = 0;
          ELSE
             EquipList[i].FeederName = 'New Bank';
             EquipList[i].Feeder = 0;
          ENDIF;
       ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
END;
 
PROCEDURE SD_Link (
   Object    = INTEGER NOT NULL WITH DEFAULT;
   IsReverse = INTEGER NOT NULL WITH DEFAULT;
   Type      = INTEGER NOT NULL WITH DEFAULT;
   List      = VARCHAR(2) NOT NULL WITH DEFAULT;
) =
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   SDObject  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   /*
   **  Check to see if this is a type we are interested in.
   */
   SDObject = 0;
   IF Type = Type$StepDown THEN  /* SD-TRANSF */
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Member
      FROM    Udb_Grouping G
      WHERE   G.Grouping = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.MemberType = :Type$SDVIS;
   ELSEIF Type = Type$SDVIS THEN
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Grouping
      FROM    Udb_Grouping G
      WHERE   G.Member = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.GroupingType = :Type$StepDown;
   ENDIF;
   
   IF SDObject <> 0 THEN 
      IF List = 'PF' THEN
         FOR i = 1 TO PF.PickEquip.LastRow DO
            IF PF.PickEquip[i].Equip = SDObject THEN
               FIELD(PF.PickEquip[i].EquipClassName).IsReverse = IsReverse;
               FIELD(PF.PickEquip[i].EquipName).IsReverse = IsReverse;
               FIELD(PF.PickEquip[i].Description).IsReverse = IsReverse;
               FIELD(PF.PickEquip[i].Comment).IsReverse = IsReverse;
                
               RETURN;
            ENDIF;
         ENDFOR;
      ELSEIF List = 'DF' THEN
         FOR i = 1 TO DF.DropEquip.LastRow DO
            IF DF.DropEquip[i].Equip = SDObject THEN
               FIELD(DF.DropEquip[i].EquipClassName).IsReverse = IsReverse;
               FIELD(DF.DropEquip[i].EquipName).IsReverse = IsReverse;
               FIELD(DF.DropEquip[i].Description).IsReverse = IsReverse;
               FIELD(DF.DropEquip[i].Comment).IsReverse = IsReverse;
               
               RETURN;
            ENDIF;
         ENDFOR;
      ENDIF;
   ENDIF;
          
   RETURN;
END; 
/*
** Compare Pick/Drop lists to match Source equipment types.
** This code is copied fromt he WP SetUp just to make sure nothing
** has changed, to properly set up the Change Source function.
*/
PROCEDURE ComparePickDropSource (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DropS = INTEGER NOT NULL WITH DEFAULT;
   DropSB = INTEGER NOT NULL WITH DEFAULT;
   DropSP = INTEGER NOT NULL WITH DEFAULT;
   PickS = INTEGER NOT NULL WITH DEFAULT;
   PickSB = INTEGER NOT NULL WITH DEFAULT;
   PickSP = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/* Make sure only one source exists in Pick list */
   FOR i = 1 TO PF.PickEquip.LastRow DO 
      IF PF.PickEquip[i].Source = 'S' THEN
         IF PickS = 1 THEN
            MESSAGE 'Error: Two Source equipment in the Pick List.';
            RETURN PU_CANCEL;
         ELSE
            PickS = 1;
            PickSourceName = PF.PickEquip[i].EquipName;
         ENDIF;
      ENDIF;
      IF PF.PickEquip[i].Source = 'SB' THEN
         IF PickSB = 1 THEN
            MESSAGE 'Error: Two Source B equipment in the Pick List. ';
            RETURN PU_CANCEL;
         ELSE
            PickSB = 1;
            PickSourceName = PF.PickEquip[i].EquipName;
         ENDIF;
      ENDIF;
      IF PF.PickEquip[i].Source = 'SP' THEN
         IF PickSP = 1 THEN
            MESSAGE 'Error: Two Source P equipment in the Pick List. ';
            RETURN PU_CANCEL;
         ELSE
            PickSP = 1;
         ENDIF;
      ENDIF;
   ENDFOR;
/* If there is Pick Source then we return immediately to indicate no Change Source */
   IF PickS = 0 AND PickSB = 0 THEN   
      RETURN PU_CANCEL;   
   ENDIF;
/* Make only one type of Source exists in Pick List */   
   IF PickS = 1 AND (PickSB = 1 OR PickSP = 1) THEN
      MESSAGE 'Error: Two Source types in the Pick List. ';
      RETURN PU_CANCEL;
   ENDIF;
   IF PickSB <> PickSP THEN
      MESSAGE 'Error: Source SB not consistent with Source SP. ';
      RETURN PU_CANCEL;   
   ENDIF;
/* Make sure only one source exists in Drop list */
   FOR i = 1 TO DF.DropEquip.LastRow DO 
      IF DF.DropEquip[i].Source = 'S' THEN
         IF DropS = 1 THEN
            MESSAGE 'Error: Two Source equipment in the Drop List. ';
            RETURN PU_CANCEL;
         ELSE
            DropS = 1;
            DropSourceName = DF.DropEquip[i].EquipName;
         ENDIF;
      ENDIF;
      IF DF.DropEquip[i].Source = 'SB' THEN
         IF DropSB = 1 THEN
            MESSAGE 'Error: Two Source B equipment in the Drop List. ';
            RETURN PU_CANCEL;
         ELSE
            DropSB = 1;
            DropSourceName = DF.DropEquip[i].EquipName;
         ENDIF;
      ENDIF;
      IF DF.DropEquip[i].Source = 'SP' THEN
         IF DropSP = 1 THEN
            MESSAGE 'Error: Two Source P equipment in the Drop List.';
            RETURN PU_CANCEL;
         ELSE
            DropSP = 1;
         ENDIF;
      ENDIF;
   ENDFOR;
/* Make only one type of Source exists in Drop List */   
   IF DropS = 1 AND (DropSB = 1 OR DropSP = 1) THEN
      MESSAGE 'Error: Two Source types in the Drop List. ';
      RETURN PU_CANCEL;
   ENDIF;
   IF DropSB <> DropSP THEN
      MESSAGE 'Error: Source SB not consistent with Source SP. ';
      RETURN PU_CANCEL;   
   ENDIF;
/* Make sure Pick and Drop Source match */      
   IF (PickS <> DropS) OR (PickSB <> DropSB) OR (PickSP <> DropSP) THEN
      MESSAGE 'Error: Source Drop and Source Pick are inconsistent. ';
      RETURN PU_CANCEL;   
   ENDIF;
   RETURN PU_OK;
END;    
