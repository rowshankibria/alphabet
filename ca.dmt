                                        varchar(0) + ' ' +      /* Switching Item */
                                        VARCHAR(Relay_View) +
                                        ' "Relays for ' + C.FeederName + ' in ' + C.SubstationName + '" ' + '""'; 
    CurFrame.Trace (PDFCommand);
    CALL System PDFCommand;   
END;

