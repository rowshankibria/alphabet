ON CLICK PDF_Btn =
BEGIN
   CALLPROC GeneratePDFFile(ShowFlag = 1);
END;

ON CLICK EMAIL_Btn =
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurSession.ProcessWindow = FALSE;
   CurSession.ProcessWait = TRUE;
   
   RetCode = CALLPROC GeneratePDFFile(ShowFlag = 0);
   CurSession.ProcessWait = FALSE;

   IF RetCode <> TRUE THEN
      Message 'Unable to generate relay report to email to Transmission Operator';
      RESUME;
   ENDIF;
/*
** Send email to TO
*/
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 15;
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'TO';
   EmailClass.Subject = 'Relay Targets for ' + C.SubstationName;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                         'App=SLC;;' + 
                         'CardID=' + VARCHAR(C.Card) + ';;' + 
                         'Equipment=' + C.SubstationName + ' ' + SWMoveText + ';;';
   EmailClass.Message2 = 'Title=' + PDFTitle + ';;';
   EmailClass.Template = 'RelaySummaryToTO.html';
   
   EmailClass.Attachments[1].FileName = 'relay_' + VARCHAR(C.Card) + '.pdf';
   EmailClass.Attachments[1].Location = PDFLocation;
   
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      Message 'Unable to send relay information to Transmission Operator by email';
   ELSE
      Message 'Relay targets sent sucessfully';
   ENDIF;
END;

