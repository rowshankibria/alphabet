Application Component Report
============================

	Name:            PadInteger

/*
**
**      Copyright c 2000 ALSTOM ESCA Corporation.  All rights reserved.
**
**      ALSTOM ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA Corporation.
**
*/
/*
**  Application:    SOO_HandHeldInterface
**  Frame:          PadInteger
**
**  Date:       Version Description
** ----------------------------------
**  08/17/00    em      Utility which receives Integer and Desired Length,
**                      then pads left side of integer with 0 (zero) characters
**                      to achieve character field of desired length.
**                      Max length is 24, significantly greater than the current
**                      highest allowed integer.
*/
PROCEDURE PadInteger (
    RawInteger 		= INTEGER NOT NULL   	/*Input Parameter*/
  , DesiredLength 	= INTEGER NOT NULL   	/*Input Parameter*/

  , OutputChar          = VARCHAR(24) NOT NULL	/*Output Parameter*/

  , i			= INTEGER NOT NULL	/*Counter*/
  , IntegerLength	= INTEGER NOT NULL      /*Length of Raw Integer*/
) =
BEGIN
    OutputChar = VARCHAR(RawInteger);
    IntegerLength = LENGTH(OutputChar);
    IF IntegerLength = DesiredLength THEN
       RETURN;
    ENDIF;

    IntegerLength = IntegerLength + 1;
    FOR i = IntegerLength TO DesiredLength DO
        OutputChar = '0' + OutputChar;
    ENDFOR;
    RETURN;
END;

Application Component Report
