	Name:            BuildInfItemPhrase

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          BuildInfItemPhrase
**
**  Date:       Author   Description
** ----------------------------------
**  10/21/98	EM       Created
**  12/13/05    ysp      Increase Title and PassedTitle to varchar(160)
**
*/
INITIALIZE 
(
#  include StandardDeclarations
   Space	= CHAR(1) NOT NULL;
   PassedDescription = VARCHAR(1500) NOT NULL WITH DEFAULT;
   PassedTitle 	= VARCHAR(160) NOT NULL WITH DEFAULT;   

) =
BEGIN
   Title = PassedTitle;
   Description = PassedDescription;

   i = 1;
   REPEATED
   SELECT  :Phrase[i].Name = T.Name
   FROM    Udb_Type T,
           Udb_ExtendedType ET
   WHERE   ET.SuperType = :Type$InfItemPhrase1 AND
           ET.Type = T.Type AND
           T.Type <> :Type$InfItemPhrase1
   ORDER BY Name
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;


ON CHILDENTRY Phrase =
BEGIN
/*
** Append Phrase to current title and description
*/
   i = FIELD(Phrase).CurRow;

   IF Title <> '' THEN
      Space = ' ';
   ELSE
      Space = '';
   ENDIF;
   
   Title = SQUEEZE(Title + Space + Phrase[i].Name);
   Description = SQUEEZE(Description + Space + Phrase[i].Name); 
END;


ON CHILDENTRY LinkedEquip =
BEGIN
/*
** Append Equipment to current title and description
*/
   i = FIELD(LinkedEquip).CurRow;

   IF Title <> '' THEN
      Space = ' ';
   ELSE
      Space = '';
   ENDIF;
   
   Title = SQUEEZE(Title + Space + LinkedEquip[i].TypeName + ' ' +
                           LinkedEquip[i].Name);
   Description = SQUEEZE(Description + Space + LinkedEquip[i].TypeName + ' ' +
                           LinkedEquip[i].Name); 
END;


ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
/*
** Save or Select/Return Operation.
*/
   PassedTitle = Title;
   PassedDescription = Description;
   RETURN;
END;


ON CLICK Cancel_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

