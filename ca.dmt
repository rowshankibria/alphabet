      END;


CurMethod.Trace(Text = 'i = ' + varchar(i) + ' after select 9 ' + varchar(date('now')));
      SELECT 
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = J.RSIssued,
            :CurObject.SSO[i].OrderType = 'REGULAR',
            :CurObject.SSO[i].Division = G.Grouping,
