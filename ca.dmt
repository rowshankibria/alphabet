/*
**  Application:    FeederCard
**  Frame:          ConfirmWPCompletion
**
**  Modifications:
**  03/30/98  em    Created.
**  04/07/98  pkw   allow select operator screen to come up
**  01/06/03  ysp   ITC 114: Use DoLogin to select a DO.
**  06/12/09  pkw   Remove call to dologin screen.
*/

INITIALIZE
(
#  include StandardDeclarations
    Card = INTEGER NOT NULL;            /* Passed Card */ 
    Job = INTEGER NOT NULL;             /* Passed Job */ 
    SwitchingItem = INTEGER NOT NULL;   /* Passed SwitchingItem */ 
    Status = INTEGER NOT NULL;
) =
BEGIN
    Initials = DOp.Description;
END;

ON CLICK ok_btn =
BEGIN
   IF Initials = '' THEN
      MESSAGE 'You must enter your initials.';
      RESUME;
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (
              Card           = Card
            , Job            = Job
            , SwitchingItem  = SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'Confirm WP Completion'
            , Old            = ''
            , New            = Initials
            );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to Log confirmation.  Please contact technical support.' + 
           HC_NEWLINE +
           'Card: ' + HC_TAB + varchar(Card) + HC_NEWLINE + 
           'Job: '  + HC_TAB + varchar(Job) + HC_NEWLINE +
           'Item: ' + HC_TAB + 'Confirm WP Completion' + HC_NEWLINE + 
           'Old: '  + HC_TAB + '' + HC_NEWLINE + 
           'New: '  + HC_TAB + Initials;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RETURN PU_OK;
END;
  
ON CLICK cancel_btn =
BEGIN
  RETURN PU_CANCEL; 
END;


ON WINDOWCLOSE =
   BEGIN
	RESUME;
   END;

