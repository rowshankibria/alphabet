/*
**  Application:    CAC
**  Frame:          CheckPQNode
**
**  Modifications:
**  06/28/07 em	  Created 
**  11/16/10 em     Add 3G Support
**  08/25/16 ysp    Add 33kv support
*/
PROCEDURE CheckPQNode
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    Feeder = INTEGER NOT NULL;
    NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
    SegmentList = ARRAY OF INTEGEROBJECT;
    WhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
    
    GetRelatedSegments = PROCEDURE RETURNING ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   RetCode = NULL;
/*
** Is this a CIOA card?
*/
   i = 0;
   SELECT  :i = Card,
           :Feeder = Feeder,
           :NetworkFeeder = NetworkFeeder
   FROM    FMS_Card
   WHERE   Card = :JIP.Card AND
           CardClass = :Type$CIOA;
 
   IF i = 0 THEN
      RETURN(RetCode);
   ENDIF;
/*
** Check if PQNode move has been completed.
*/
   i = 0;
   SELECT  :i = J.Job
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :JIP.Card AND
           JC.Job = J.Job AND
           J.JobClass = :JobClass$PQNode AND
           J.TOComplete IS NOT NULL;
 
   IF i = 0 THEN   /* PQNode Move has not been completed */
      RetCode = CALLFRAME Warning ( Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
              Text = 'FOD has not returned InRush Current information.');
          
      IF RetCode = PU_CANCEL THEN
           RETURN(PU_CANCEL);
      ELSE
          RETURN(Warning$Overridden);            
      ENDIF;   
   ENDIF;
/*
** Check for feeder Inrush status, if it exists, no need for HiPot.
*/
   IF NetworkFeeder = NetworkFeeder$33KV THEN
      /*
      ** When checking InRush feeder object status, include other feeder segments
      ** fed by this feeder and exclude feeder segments fed by another.
      */
      SegmentList = CALLPROC GetRelatedSegments(Card = JIP.Card);
      WhereClause = '';
      FOR k = 1 TO SegmentList.LastRow DO
         IF WhereClause <> '' THEN
            WhereClause = WhereClause + ',';
         ELSE
            WhereClause = WhereClause + VARCHAR(SegmentList[k].Value);
         ENDIF;
      ENDFOR;
      WhereClause = 'OS.Object IN (' + WhereClause + ') AND ' + 
                    'OS.Status = ' + VARCHAR(Status$InRush) + ' AND ' +
                    'OS.StatusCount > 0'; 
      i = 0;
      SELECT :i = MAX(OS.StatusCount)
      FROM   FMS_ObjectStatus OS
      WHERE  :WhereClause;      
   ELSE
      i = 0;
      SELECT :i = OS.StatusCount
      FROM   FMS_ObjectStatus OS,
             TFMS_CardToObject CTO
      WHERE  CTO.Card = :JIP.Card AND
             CTO.Object = OS.Object AND
             OS.Status = :Status$InRush AND
             OS.StatusCount > 0;
   ENDIF;
   
   IF i > 0 THEN 
      RetCode = CALLFRAME Warning ( Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
              Text = 'Feeder has a Status of InRush Current.');
          
      IF RetCode = PU_CANCEL THEN
           RETURN(PU_CANCEL);
      ELSE
          RETURN(Warning$Overridden);            
      ENDIF;   
  ENDIF;

  RETURN(RetCode);
END;

PROCEDURE GetRelatedSegments(
   Card = INTEGER NOT NULL
)=
DECLARE
   k = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   SegmentList = ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   SegmentList.Clear();
   k = 1;
   SELECT :SegmentList[k].Value = CTO.Object
   FROM   TFMS_CardToObject CTO
   WHERE  CTO.Card = :JIP.Card 
   BEGIN
      FedBy = 0;   // need to declare this variable
      SELECT :FedBy = Grouping
      FROM   Udb_Grouping
      WHERE  Member = :SegmentList[k].Value AND
             Relationship = :Interaction$FedBy;
      IF FedBy > 0 THEN
         SegmentList.RemoveRow (rownumber = k);
      ELSE
         k = k + 1;
         REPEATED 
         SELECT DISTINCT
                :SegmentList[k].Value = G.Member
         FROM   Udb_Grouping G
         WHERE  G.Grouping = :SegmentList[k-1].Value AND
                G.Relationship = :Interaction$FedBy
         BEGIN
            k = k + 1;
         END;
      ENDIF;          
   END;
   RETURN SegmentList;
END;

