	Name:            PromptInterUtilityGuarantee

/*
**
**	Copyright c 1991 Unified Information, Inc. All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptInterUtilityGuarantee
**
**  Modifications:
**  09/25/09  pkw   Created
*/
INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    C = FMS_Card;				/* Card details */
    BackFeedCheckResult = VARCHAR(3) not null;/* IR_DOWNLOADMOVE table column */
    PT = Varchar(20);			/* Prompt text */
    i = INTEGER NOT NULL;
    StepCount = integer not null;
    RetCode = Integer not null;
    OldTOMove = VARCHAR(160) NOT NULL WITH DEFAULT;
    TempChar = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** Select the Neighboring Utilities from the database.
*/
   i = 1;
   FIELD(Utility).ValueList.ChoiceItems.Clear();
   SELECT :TempChar = O.Name
   FROM    Udb_Object O
   WHERE   O.Type = :Type$NeighborUtility
   BEGIN 
      FIELD(Utility).ValueList.ChoiceItems[i].EnumValue = i;
      FIELD(Utility).ValueList.ChoiceItems[i].EnumText = TempChar;
      i = i + 1;
   END;
   
   IF FIELD(Utility).ValueList.ChoiceItems.LastRow <= 10 THEN
      FIELD(Utility).VisibleRows = FIELD(Utility).ValueList.ChoiceItems.LastRow;
   ELSE
      FIELD(Utility).VisibleRows = 10;
   ENDIF;
   FIELD(Utility).UpdChoiceList();
   

END;

ON Click OKButton =
BEGIN
   IF FIELD(Utility).CurEnumText = '' THEN
      message 'Please select a Utility';
      RESUME;
   ENDIF;
   
   OldTOMove = JIP.TOMove;   
   JIP.TOMove = JIP.TOMove + ' ' + varchar(JIP.Job) + ' to ' + 
                   FIELD(Utility).CurEnumText;
   IF JIP.RSMove <> '' THEN
      JIP.RSMove = JIP.RSMove + ' ' + varchar(JIP.Job) + ' to ' + 
                   FIELD(Utility).CurEnumText;   
   ENDIF;
   
   RetCode = CallProc SOA_JobMoveTextUpd(
			TOMove = JIP.TOMove,
			RSMove = JIP.RSMove,
			Job    = JIP.Job);
   
   IF Retcode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
  
      CALLPROC TraceError (UserMessage = 
               'Move text was not successfully updated.',
                           TraceMessage =
               'Frame:PromptInterUtilityGuarantee; ' +
               'Move text was not successfully updated for job ' +
               varchar(JIP.Job)
               );
   ELSE
      CallProc DDB_COMMIT;
   
      CALLPROC SOA_LogIns (
              Card = JIP.Card,
              Job  = JIP.Job, 
              Item = 'TOMove Upd',
              Old  = OldTOMove,
              New  = JIP.ToMove,
              Time = Date('now'),
              UserName = UserName);                                 
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
				 *Default Item


Application Component Report
============================

	Name:            PromptMeasureFlow

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptMeasureFlow
**
**  06/12/14  ysp  Created
**  07/01/15  em   Added attributes
**  09/09/21  em   Remove Flow Rate attribute by making it invisible.
**  10/28/21  em   Incorporate SSO return
**  06/30/22  em   AutoComplete if Reading is loaded from RR
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   StructureType = VARCHAR(40) NOT NULL WITH DEFAULT;
   TotalFlow = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :StructureType = StructureTypeName,
          :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;
   
   SELECT :TotalFlow = MeasureFlowResult
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF TotalFlow > 0 THEN
      Total_Flow = TotalFlow;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(Total_Flow).CurBias = FB_VISIBLE;
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName='AutoComplete');
   ENDIF;
   
   FIELD(Heading).TextValue = 'Reading from ' + SQUEEZE(StructureType + ' ' +Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName);
END;

ON USEREVENT 'AutoComplete',
ON Click OKButton =
DECLARE
   Reading = VARCHAR(80) NOT NULL WITH DEFAULT
BEGIN
   Reading = /* 'Flow Rate: ' + Flow_Rate + ', */ 'Total Flow: ' + VARCHAR(Total_Flow);
   
   RetCode = CALLPROC DSO_ReadingIns(
      Card = JIP.Card,
      Time = DATE('NOW'),
      Job = JIP.Job,
      Structure = JIP.Substation,
      Equip = JIP.Equip,
      ReadingType = 'Flow Meter',
      Reading = Reading);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record flow measurement reading.',
                           TraceMessage =
                  'PromptMeasureFlow: Unable to record flow measurement reading for ' +
                  'card=' + VARCHAR(JIP.Card));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;

   IF JIP.Response <> '' THEN
      JIP.Response = Squeeze(Reading + ' ' + JIP.Response);
   ELSE
      JIP.Response = Reading;
   ENDIF;
   JIP.ResponseUpd();

   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

