   REPEATED 
   SELECT CurObject.clist[i].Card = C.Card,
          CurObject.clist[i].Type = :Type$TCDelay,
          CurObject.clist[i].Description = T.Description,
          CurObject.clist[i].Division = O.PrimaryGrouping,
          CurObject.clist[i].Feeder = C.Circuit,
          CurObject.clist[i].FeederName = C.LineNumber,
          CurObject.clist[i].CardClass = C.CircuitStatus,
          CurObject.clist[i].CardClassName = C.CircuitStatusName,
          CurObject.clist[i].Object = 0,
          CurObject.clist[i].Status = OSS.OperatingStep,
          CurObject.clist[i].StartTime = OSS.StartTime
   FROM   TC_Card C,
          TC_OperatingStepStatus OSS,
          Udb_SuperType ST,
          Udb_Type T,
          Udb_Object O,
          Udb_Grouping G
   WHERE  C.Status < :TC_Card$Closed AND
          C.Card = OSS.Card AND
          OSS.EndTime = '' AND
          OSS.OperatingStep = ST.Type AND
          ST.SuperType = :Type$TCDelay AND
          ST.Type = T.Type AND
          C.Circuit = G.Member AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$Substation AND
          G.Reference = (SELECT MAX(Reference)
                         FROM   Udb_Grouping G2
                         WHERE  G2.Member = C.Circuit AND
                                G2.Relationship = :Interaction$MemberOf AND
                                G2.GroupingType = :Type$Substation) AND
          G.Grouping = O.Object 
   ORDER BY Card, Status
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status  AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

