/**             Start of FCR Permits                         **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with FCR Permit data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :Operator$FCR
   ORDER BY Card, Object
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   REPEATED 
   SELECT CurObject.clist[i].Card = C.Card,
          CurObject.clist[i].Type = :Operator$FCR,
          CurObject.clist[i].Description = J.TOMove,
          CurObject.clist[i].Division = OO.PrimaryGrouping,
          CurObject.clist[i].Feeder = C.Feeder,
          CurObject.clist[i].FeederName = C.FeederName,
          CurObject.clist[i].CardClass = C.CardClass,
          CurObject.clist[i].CardClassName = C.CardClassName,
          CurObject.clist[i].Object = J.Job,
          CurObject.clist[i].Status = W.PermitStatus,
          CurObject.clist[i].IssueTime = IFNULL(J.TOIssued,''),
          CurObject.clist[i].RevisedTime = W.RevisionDate,
          CurObject.clist[i].ReturnTime = IFNULL(J.RSComplete,'')         
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          SOA_Job J,
          SOA_JobControl JC,
          IR_WorkPermit W,
          Udb_Object O,
          Udb_Object OO,
          Udb_ExtendedType ET
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey <= 0 AND /* -1 means no fault info entered by cutin */
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = JC.Card AND
          JC.Job = J.Job AND
          JC.StepPair = :StepHeading$OTW AND
          J.ToOperator = :Operator$FCR AND
          J.Job = W.WorkPermit AND
          W.PermitStatus < :Permit$ReturnConfirmed AND
          C.Card = CTO.Card AND
          CTO.Object = O.Object AND
          O.PrimaryGrouping = OO.Object AND
          OO.Type = ET.Type AND
          ET.SuperType = :Type$Substation 
   UNION  /* Get 3G feeders which have primary Grouping = Division instead of Substation */
   SELECT C.Card,
          :Operator$FCR,
          J.TOMove,
          OO.Object,
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          J.Job,
          W.PermitStatus,
          IFNULL(J.TOIssued,''),
          W.RevisionDate,
          IFNULL(J.RSComplete,'')         
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          SOA_Job J,
          SOA_JobControl JC,
          IR_WorkPermit W,
          Udb_Object O,
          Udb_Object OO
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey <= 0 AND /* -1 means no fault info entered by cutin */
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = JC.Card AND
          JC.Job = J.Job AND
          JC.StepPair = :StepHeading$OTW AND
          J.ToOperator = :Operator$FCR AND
          J.Job = W.WorkPermit AND
          W.PermitStatus < :Permit$ReturnConfirmed AND
          C.Card = CTO.Card AND
          CTO.Object = OO.Object AND
          OO.PrimaryGrouping = O.Object AND
          O.Type = :Type$Division
   ORDER BY Card, Object
   BEGIN
      IF CurObject.clist[i].Status = Permit$Acknowledged OR
         CurObject.clist[i].Status = Permit$DownLoaded OR
         CurObject.clist[i].Status = Permit$Rejected OR
         CurObject.clist[i].Status = Permit$Issued THEN
         IF CurObject.clist[i].ReturnTime IS NOT NULL THEN
            CurObject.clist.RemoveRow (RowNumber = i);
         ELSE
            CurObject.clist[i].StartTime = CurObject.clist[i].IssueTime;
            i = i + 1;
         ENDIF;
      ELSEIF CurObject.clist[i].Status = Permit$Returned THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].ReturnTime;
         i = i + 1;
      ELSEIF CurObject.clist[i].Status = Permit$Initialized THEN
         IF CurObject.clist[i].ReturnTime IS NOT NULL THEN
            CurObject.clist.RemoveRow (RowNumber = i);
         ELSE
            CurObject.clist[i].StartTime = CurObject.clist[i].RevisedTime;
            i = i + 1;
         ENDIF;
      ENDIF;
   END; 
   CALLPROC DDB_ROLLBACK;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status  AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

