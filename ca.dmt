Application Component Report
============================

	Name:            PromptMTAAlleviation

/*
**
**	Copyright c 2020 Pateric Software LLC. All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptMTAAlleviation
**
**  Modifications:
**  06/22/21   em   Created
**  01/18/24   em   Display title changes directed by Dave ONeill
*/
INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER NOT NULL WITH DEFAULT;
    FeederCount = INTEGER NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL;
    MTAC = ARRAY OF MTAContingency;
    MTAMsg = MTAContingency_ASE;
    RetCode = Integer not null;
    SelectedRow = INTEGER NOT NULL WITH DEFAULT;
    TempObj = INTEGER NOT NULL;
    TempChar = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
/* Load outstanding contingencies */
   MTAMsg.Card = JIP.Card;
   MTAMsg.CIGMessage = '';
   MTAMsg.LoadCIGAlleviation();

   IF MTAMsg.Contingency.LastRow = 0 THEN
      RETURN PU_OK;
   ENDIF;
   
   Contingency = MTAMSg.Contingency.Duplicate();
END;


ON Click OKButton =
DECLARE
   FdrName = Varchar(80) NOT NULL;     
   MsgTxt = Varchar(2000) NOT NULL;     /* CIG text */
   Changes = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** Review for DO comment on Condition Not Alleviated
*/
   FOR i = 1 TO Contingency.LastRow DO
      IF Contingency[i].AlleviationStatus = 2 THEN 
         IF Contingency[i].NotAlleviatedComment = '' THEN
            MESSAGE 'Must enter a reason when condition not alleviated.';
            RESUME;
         ENDIF;
      ELSE
         Contingency[i].NotAlleviatedComment = '';
      ENDIF;
   ENDFOR;
/*
** Save data to database
*/
   Changes = FALSE;
   FOR i = 1 TO Contingency.LastRow DO
         IF Contingency[i].AlleviationStatus > 0 THEN
            Changes = TRUE;
            RetCode = CALLPROC FMS_MTAContingencyAlleviation (
                          Card = Contingency[i].Card,
                          Line = Contingency[i].Line,
                          AlleviationStatus = Contingency[i].AlleviationStatus,
                          NotAlleviatedComment = Contingency[i].NotAlleviatedComment);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'ERROR: Unable to save MTA Contingency Alleviation.';
               RESUME;
            ENDIF;
         ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   IF Changes = FALSE THEN
      RETURN (PU_OK);
   ENDIF;
/*
** Send CIG Message if there are Changes
*/ 
   SELECT :FdrName = FeederName
   FROM   FMS_Card 
   WHERE  Card = :JIP.Card; 
          
   MTAMsg.Card = JIP.Card;
   MTAMsg.CIGMessage = '';
   MTAmSG.LoadCIGAlleviation();
   IF MTAMsg.CIGMessage <> '' THEN
         MsgTxt = 'MTA Contingency Alleviation Status for Feeder ' + FdrName + '. ' + HC_NEWLINE +
                     MTAMsg.CIGMessage;
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                 ,MessageText = MsgTxt
                 ,Time = date('now')
                 ,Priority = 1
                 ,MessageType = 0
                 ,Card = JIP.Card);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Could not send automated ' +
                  'message to CIG.  Please contact CIG verbally to let ' +
                  'them know feeder ' + FdrName + ' MTA Alleviation status.',
                     TraceMessage = 'Could not send automated message to CIG for ' +
                  'MTA Alleiviation.' 
                  );
         ENDIF;
         CALLPROC DDB_COMMIT;
   ENDIF;
   
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;


