METHOD LoadOrders (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   ObjDesc = VARCHAR(40) NOT NULL WITH DEFAULT;
   ObjComment = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all orders for a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.OList.Clear();
   IF CurObject.Application = Application$FMS THEN
      i = 1;
      REPEATED
      SELECT 
            :CurObject.OList[i].InterFace = 'FOD',
            :CurObject.OList[i].IssueTime = FO.IssueTime,
            :CurObject.OList[i].OrderNumber = FO.OrderNumber,
            :CurObject.OList[i].Priority = FO.Priority,
            :CurObject.OList[i].IssuedByDO = FO.IssuedByDO,
            :CurObject.OList[i].Comment = FO.OrderComment,
            :CurObject.OList[i].Status = 0,         
            :CurObject.OList[i].StatusName = 'See job(s)'
      FROM   IR_FODOrder FO
      WHERE  FO.Card = :CurObject.Card
      union all
      SELECT 'SSO',
             IssueTime,
             OrderNumber,
             VARCHAR(Priority),
             IssuedByDO,
             '',
             OrderStatus,
             ''
      FROM   IR_OperatingOrder
      WHERE  Card = :CurObject.Card
      ORDER BY IssueTime DESC 
      BEGIN
         IF CurObject.OList[i].InterFace = 'FOD' THEN
            IF CurObject.OList[i].Priority = '' THEN
               CurObject.OList[i].Priority = 'Normal';
            ENDIF;
         ENDIF;
         i = i + 1;
      END;        
      
   ELSEIF CurObject.Application = Application$SLC THEN
      IF CurObject.StatusFilter = 0 THEN     // Outstanding Orders
         i = 1;
         REPEATED 
         SELECT DISTINCT
		:CurObject.OList[i].InterFace = 'SSO',
                :CurObject.OList[i].SubstationName = O.Name,
                :CurObject.OList[i].IssueTime = OO.IssueTime,
                :CurObject.OList[i].OrderNumber = OO.OrderNumber,
                :CurObject.OList[i].Priority = VARCHAR(OO.Priority),
                :CurObject.OList[i].IssuedByDO = OO.IssuedByDO,
                :CurObject.OList[i].Comment = '',
                :CurObject.OList[i].Status = OO.OrderStatus,         
                :CurObject.OList[i].StatusName = ''
         FROM   SOA_JobControl JC,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
         WHERE  JC.Card = :CurObject.Card AND
                JC.Job = JTS.Job AND
                JTS.OrderNumber = OO.OrderNumber AND
                OO.OrderStatus <= :Order$Closed AND
                OO.Substation = O.Object
         ORDER BY IssueTime DESC
         BEGIN
            i = i + 1;
         END;      
      ELSE
         i = 1;
         REPEATED
         SELECT :CurObject.OList[i].InterFace = 'SSO',
                :CurObject.OList[i].SubstationName = O.Name,
                :CurObject.OList[i].IssueTime = OO.IssueTime,
                :CurObject.OList[i].OrderNumber = OO.OrderNumber,
                :CurObject.OList[i].Priority = VARCHAR(OO.Priority),
                :CurObject.OList[i].IssuedByDO = OO.IssuedByDO,
                :CurObject.OList[i].Comment = '',
                :CurObject.OList[i].Status = OO.OrderStatus,         
                :CurObject.OList[i].StatusName = ''
         FROM   IR_OperatingOrder OO,
                Udb_Object O,
                SOA_ActiveObject AO
         WHERE  AO.Card = :CurObject.Card AND
              AO.Object = OO.Substation AND
              OO.OrderStatus > :Order$Closed AND
              OO.OrderStatus <> :Order$Cancelled AND
              OO.IssueTime BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
              OO.Substation = O.Object
         ORDER BY IssueTime DESC
         BEGIN
            i = i + 1;
         END;
      ENDIF;
      
   ELSEIF CurObject.Application = Application$TFMS THEN
      IF CurObject.StatusFilter = 0 THEN     // all Orders on this card
         i = 1;
         REPEATED 
         SELECT DISTINCT
                :CurObject.OList[i].InterFace = 'SSO',
                :CurObject.OList[i].SubstationName = O.Name,
                :CurObject.OList[i].IssueTime = OO.IssueTime,
                :CurObject.OList[i].OrderNumber = OO.OrderNumber,
                :CurObject.OList[i].Priority = VARCHAR(OO.Priority),
                :CurObject.OList[i].IssuedByDO = OO.IssuedByDO,
                :CurObject.OList[i].Comment = '',
                :CurObject.OList[i].Status = OO.OrderStatus,         
                :CurObject.OList[i].StatusName = ''
         FROM   SOA_JobControl JC,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
         WHERE  JC.Card = :CurObject.Card AND
                JC.Job = JTS.Job AND
                JTS.OrderNumber = OO.OrderNumber AND
                OO.Substation = O.Object
         ORDER BY 2 ASC, 3 DESC 
         BEGIN
            i = i + 1;
         END;      
      ELSE
         i = 1;
         REPEATED
         SELECT :CurObject.OList[i].InterFace = 'SSO',
                :CurObject.OList[i].SubstationName = O.Name,
                :CurObject.OList[i].IssueTime = OO.IssueTime,
                :CurObject.OList[i].OrderNumber = OO.OrderNumber,
                :CurObject.OList[i].Priority = VARCHAR(OO.Priority),
                :CurObject.OList[i].IssuedByDO = OO.IssuedByDO,
                :CurObject.OList[i].Comment = '',
                :CurObject.OList[i].Status = OO.OrderStatus,         
                :CurObject.OList[i].StatusName = ''
         FROM   IR_OperatingOrder OO,
                Udb_Object O,
                TFMS_CardToObject  AO
         WHERE  AO.Card = :CurObject.Card AND
              AO.Object = OO.Substation AND
              OO.OrderStatus > :Order$Closed AND
              OO.OrderStatus <> :Order$Cancelled AND
              OO.IssueTime BETWEEN :CurObject.StartDate AND :CurObject.EndDate and
              OO.Substation = O.Object
         UNION
         SELECT 'SSO',
                O.Name,
                OO.IssueTime,
                OO.OrderNumber,
                VARCHAR(OO.Priority),
                OO.IssuedByDO,
                '',
                OO.OrderStatus,         
                ''
         FROM  IR_OperatingOrder OO,
               Udb_Object O,
               TFMS_CardToObject AO,
               Udb_Grouping G
         WHERE  AO.Card = :CurObject.Card AND
                AO.Object = G.Member AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$MacroSubstation AND
                G.Grouping = OO.Substation AND
                OO.OrderStatus > :Order$Closed AND
                OO.OrderStatus <> :Order$Cancelled AND
                OO.IssueTime BETWEEN :CurObject.StartDate AND :CurObject.EndDate and                
                O.Object = OO.Substation
         ORDER BY 2 ASC, 3 DESC
         BEGIN
            i = i + 1;
         END;
      ENDIF; 
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   FOR i = 1 TO CurObject.OList.LastRow DO
      IF CurObject.OList[i].InterFace = 'SSO' THEN
         IF CurObject.OList[i].Priority = '' THEN
            CurObject.OList[i].Priority = 'Normal';
         ENDIF;

         IF CurObject.OList[i].Status = Order$Opened THEN
            CurObject.OList[i].StatusName = 'Opened';
         ELSEIF CurObject.OList[i].Status = Order$Downloaded THEN
            CurObject.OList[i].StatusName = 'Downloaded';
         ELSEIF CurObject.OList[i].Status = Order$Acknowledged THEN
            CurObject.OList[i].StatusName = 'Acknowledged';
         ELSEIF CurObject.OList[i].Status = Order$Closed THEN
            CurObject.OList[i].StatusName = 'Closed';
         ELSEIF CurObject.OList[i].Status = Order$ConfirmClosed THEN
            CurObject.OList[i].StatusName = 'Closed';
         ELSEIF CurObject.OList[i].Status = Order$Rejected THEN
            CurObject.OList[i].StatusName = 'Rejected';
         ELSEIF CurObject.OList[i].Status = Order$ConfirmRejected THEN
            CurObject.OList[i].StatusName = 'Rejected';
         ELSEIF CurObject.OList[i].Status = Order$Rescinded THEN
            CurObject.OList[i].StatusName = 'Rescinded';
         ELSEIF CurObject.OList[i].Status = Order$ConfirmRescinded THEN
            CurObject.OList[i].StatusName = 'Rescinded';
         ELSEIF CurObject.OList[i].Status = Order$Cancelled THEN
            CurObject.OList[i].StatusName = 'Cancelled';
         ELSE
            CurObject.OList[i].StatusName = 'Unknown';
         ENDIF; 

         SELECT :ObjDesc = Description,
                :ObjComment = Comment
         FROM   IR_OpOrderObjectives
         WHERE  OrderNumber = :CurObject.OList[i].OrderNumber
         BEGIN
            IF ObjDesc <> '' THEN
               CurObject.OList[i].Comment = CurObject.OList[i].Comment + ObjDesc + '; ';
            ELSE
               CurObject.OList[i].Comment = CurObject.OList[i].Comment + ObjComment + '; ';
            ENDIF;
         END;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;


METHOD LoadFODDetails (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the details of a FOD order.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Select the operating order header information.
*/
   SELECT  :CurObject.OD.OrderSequence = F.SequenceType,
           :CurObject.OD.FODEmployeeName = O.Description
   FROM    IR_FODOrder F,
           Udb_Object O
   WHERE   F.OrderNumber = :CurObject.OrderNumber AND
           F.FODEmployeeObject = O.Object;
   CALLPROC DDB_ROLLBACK;
   
/*
**  Get the Work Tasks from the SOA_Job table.  This is a UNION of the
**  TakeOut(TO) and the Restore(RS) moves from active and archive tables.
*/
   i = 1;
   CurObject.Jobs.Clear();
   SELECT  :CurObject.Jobs[i].Printid = JC.printid,
           :CurObject.Jobs[i].Job = J.Job,
           :CurObject.Jobs[i].EquipClassName = J.EquipClassName,
           :CurObject.Jobs[i].EquipName = J.EquipName,
           :CurObject.Jobs[i].TOMove = J.TOMove,
           :CurObject.Jobs[i].TOOperator = J.TOOperator,
           :CurObject.Jobs[i].RSOperator = J.RSOperator,
           :CurObject.Jobs[i].Seq = JTS.Seq,
           :CurObject.Jobs[i].TOIssued = J.TOIssued,
           :CurObject.Jobs[i].TOComplete = J.TOComplete,
           :CurObject.Jobs[i].TORS = JTS.TORS,
           :CurObject.Jobs[i].JobStatusInt = JTS.JobStatus,
           :CurObject.Jobs[i].RescindType = JTS.RescindType
   FROM    SOA_Job J,
           SOA_JobControl JC,
           IR_FODOrder OO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   OO.OrderNumber = :CurObject.OrderNumber AND
           OO.Card = JC.Card AND
           JC.Job = J.Job AND
           JTS.OrderNumber = :CurObject.OrderNumber AND
           JTS.TORS = :Job$TakeOutInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   UNION 
   SELECT  JC.Printid,
           J.Job,
           J.EquipClassName,
           J.EquipName,
           J.RSMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           J.RSIssued,
           J.RSComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    SOA_Job J,
           SOA_JobControl JC,
           IR_FODOrder OO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   OO.OrderNumber = :CurObject.OrderNumber AND
           OO.Card = JC.Card AND
           JC.Job = J.Job AND
           JTS.OrderNumber = :CurObject.OrderNumber AND
           JTS.TORS = :Job$RestoreInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   UNION
   SELECT  
           J.printid,
           J.Job,
           J.EquipClassName,
           J.EquipName,
           J.TOMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           J.TOIssued,
           J.TOComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    FMS_ArchiveJob J,
           IR_FODOrder FO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
           JTS.TORS = :Job$TakeOutInt AND
           JTS.Job = J.Job AND
           FO.OrderNumber = JTS.OrderNumber AND
           FO.Card = J.Card AND
           J.Equip = O.Object
   UNION 
   SELECT  J.Printid,
           J.Job,
           J.EquipClassName,
           J.EquipName,
           J.RSMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           J.RSIssued,
           J.RSComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    FMS_ArchiveJob J,
           IR_FODOrder FO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
           JTS.TORS = :Job$RestoreInt AND
           JTS.Job = J.Job AND
           FO.OrderNumber = JTS.OrderNumber AND
           FO.Card = J.Card AND
           J.Equip = O.Object
   ORDER BY Seq
   BEGIN
      IF CurObject.Jobs[i].JobStatusInt = Order$Opened THEN
         CurObject.Jobs[i].JobStatus = 'Issued'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$Rejected THEN
         CurObject.Jobs[i].JobStatus = 'Rejected';
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$Downloaded THEN
         CurObject.Jobs[i].JobStatus = 'Downloaded'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$Acknowledged THEN
         CurObject.Jobs[i].JobStatus = 'Acknowledged'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$Closed THEN
         CurObject.Jobs[i].JobStatus = 'Closed'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$Rescinded THEN
         CurObject.Jobs[i].JobStatus = 'Rescinded';
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$ConfirmClosed THEN
         CurObject.Jobs[i].JobStatus = 'Closed'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$ConfirmRejected THEN
         CurObject.Jobs[i].JobStatus = 'Rejected'; 
      ELSEIF CurObject.Jobs[i].JobStatusInt = Order$ConfirmRescinded THEN
         CurObject.Jobs[i].JobStatus = 'Rescinded'; 
      ELSE
         CurObject.Jobs[i].JobStatus = 'Unknown';         
      ENDIF;
/*
**  Select Job Details 
*/
      REPEATED 
      SELECT  :CurObject.Jobs[i].OD.ContactInfo = F.ContactInfo,
              :CurObject.Jobs[i].OD.ReturnRemark = F.ReturnRemark,
              :CurObject.Jobs[i].OD.AckRejectTime = F.AckRejectTime,
              :CurObject.Jobs[i].OD.AckRejectComment = F.AckRejectedComment,
              :CurObject.Jobs[i].OD.RescindTime = F.RescindTime,
              :CurObject.Jobs[i].OD.RescindType = F.RescindType,
              :CurObject.Jobs[i].OD.RescindDo = F.RescindDO,
              :CurObject.Jobs[i].OD.RescindReasonTypeName =
                                                       F.RescindReasonTypeName,
              :CurObject.Jobs[i].OD.RescindComment = F.RescindComment
      FROM     IR_FODOrderJobs F
      WHERE    F.Job = :CurObject.Jobs[i].Job AND
               F.OrderNumber = :CurObject.OrderNumber AND
               F.TORS = :CurObject.Jobs[i].TORS;

      IF CurObject.Jobs[i].TORS = Job$TakeOutInt THEN
         REPEATED 
         SELECT  :CurObject.Jobs[i].OD.FODEmployeeName = O.Description
         FROM    Udb_Object O
         WHERE   O.Object = :CurObject.Jobs[i].TOOperator;
      ELSE
         REPEATED 
         SELECT  :CurObject.Jobs[i].OD.FODEmployeeName = O.Description
         FROM    Udb_Object O
         WHERE   O.Object = :CurObject.Jobs[i].RSOperator;
      ENDIF;
      CALLPROC DDB_ROLLBACK;
      
      i = i + 1;
   END;

   CALLPROC DDB_ROLLBACK;
   RETURN;
END;

METHOD LoadSSODetails (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load details of a SSO order.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Select the operating order header information.
*/
   SELECT :CurObject.OD.AcknowledgedBy = O.AckRejectBySSO,
          :CurObject.OD.AckRejectTime = O.AckRejectTime,
          :CurObject.OD.AckRejectComment = O.AckRejectComment,
          :CurObject.OD.ByDesk = O.ByDesk,
          :CurObject.OD.ReturnTime = O.ReturnTime,
          :CurObject.OD.ReturnBy = O.ReturnBySSO,
          :CurObject.OD.ReturnRemark = O.ReturnComment,
          :CurObject.OD.RescindTime = O.RescindTime,
          :CurObject.OD.RescindType = O.RescindType,
          :CurObject.OD.RescindDo = O.RescindDO,
          :CurObject.OD.RescindReasonTypeName = O.RescindReasonTypeName,
          :CurObject.OD.RescindComment = O.RescindComment,
          :CurObject.OD.BusConfiguration = O.BusConfiguration,
          :CurObject.OD.BusConfigurationName = ''
   FROM   IR_OperatingOrder O
   WHERE  O.OrderNumber = :CurObject.OrderNumber;

   IF CurObject.OD.BusConfiguration > 0 THEN
      SELECT :CurObject.OD.BusConfigurationName = Name
      FROM   UDB_Type
      WHERE  Type = :CurObject.OD.BusConfiguration;
   ENDIF;

   i = 1;
   CurObject.OD.Steps.Clear();
   SELECT :CurObject.OD.Steps[i].Type = Type,
          :CurObject.OD.Steps[i].OperatingStepName = OperatingStepName,
          :CurObject.OD.Steps[i].StartTime = StartTime
   FROM   IR_OpOrderSteps
   WHERE  OrderNumber = :CurObject.OrderNumber
   ORDER BY Type
   BEGIN
      i = i + 1;
   END;   
   
   i = 1;
   CurObject.OD.InConnectionWith.Clear();
   SELECT :CurObject.OD.InConnectionWith[i].TypeName = TypeName,
          :CurObject.OD.InConnectionWith[i].Name = Name
   FROM   IR_OpOrderFeeders 
   WHERE  OrderNumber = :CurObject.OrderNumber 
   BEGIN
       i = i + 1;  
   END;

   /*
   **  Get the Work Tasks from the job tables.  This is a UNION of the
   **  TakeOut(TO) and the Restore(RS) moves from active and archive tables.
   */
   IF CurObject.Application = Application$FMS THEN
      i = 1;
      CurObject.Jobs.Clear();
      REPEATED
      SELECT :CurObject.Jobs[i].Printid = JC.printid,
             :CurObject.Jobs[i].Job = J.Job,
             :CurObject.Jobs[i].EquipClassName = J.EquipClassName,
             :CurObject.Jobs[i].EquipName = J.EquipName,
             :CurObject.Jobs[i].TOMove = J.TOMove,
             :CurObject.Jobs[i].TOOperator = J.TOOperator,
             :CurObject.Jobs[i].RSOperator = J.RSOperator,
             :CurObject.Jobs[i].Seq = JTS.Seq,
             :CurObject.Jobs[i].TOIssued = J.TOIssued,
             :CurObject.Jobs[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark)
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   AC.Application = :Application$FMS AND
              AC.Card = JC.Card AND
              JC.Job = J.Job AND
              JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$TakeOutInt AND
              JTS.Job = J.Job
      UNION 
      SELECT  JC.Printid,
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.RSMove,
              J.TOOperator,
              J.RSOperator,
              JTS.Seq,
              J.RSIssued,
              SQUEEZE(JTS.ReturnRemark)
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   AC.Application = :Application$FMS AND
              AC.Card = JC.Card AND
              JC.Job = J.Job AND
              JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$RestoreInt AND
              JTS.Job = J.Job
      UNION
      SELECT  
              J.printid,
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.TOMove,
              J.TOOperator,
              J.RSOperator,
              JTS.Seq,
              J.TOIssued,
              SQUEEZE(JTS.ReturnRemark)
      FROM    FMS_ArchiveJob J,
              IR_OperatingOrder OO,
              IR_OpOrderJobs JTS
      WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$TakeOutInt AND
              OO.OrderNumber = JTS.OrderNumber AND
              OO.Card = J.Card AND
              JTS.Job = J.Job
      UNION 
      SELECT  J.Printid,
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.RSMove,
              J.TOOperator,
              J.RSOperator,           
              JTS.Seq,
              J.RSIssued,
              SQUEEZE(JTS.ReturnRemark)
      FROM    FMS_ArchiveJob J,
              IR_OperatingOrder OO,
              IR_OpOrderJobs JTS
      WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$RestoreInt AND
              OO.OrderNumber = JTS.OrderNumber AND
              OO.Card = J.Card AND
              JTS.Job = J.Job 
      ORDER BY Seq
      BEGIN
         i = i + 1;    
      END;
   ELSE // TOMS
      i = 1;
      CurObject.Jobs.Clear();
      REPEATED
      SELECT :CurObject.Jobs[i].Printid = JC.printid,
             :CurObject.Jobs[i].Job = J.Job,
             :CurObject.Jobs[i].EquipClassName = J.EquipClassName,
             :CurObject.Jobs[i].EquipName = J.EquipName,
             :CurObject.Jobs[i].TOMove = J.TOMove,
             :CurObject.Jobs[i].TOOperator = J.TOOperator,
             :CurObject.Jobs[i].RSOperator = J.RSOperator,
             :CurObject.Jobs[i].Seq = JTS.Seq,
             :CurObject.Jobs[i].TOIssued = J.TOIssued,
             :CurObject.Jobs[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark),
             :CurObject.Jobs[i].ParentJob = JTS.ParentJob
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   AC.Card = JC.Card AND
              JC.Job = J.Job AND
              JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$TakeOutInt AND
              JTS.Job = J.Job AND
              J.ControlCard = AC.Card
      UNION 
      SELECT  JC.Printid,
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.RSMove,
              J.TOOperator,
              J.RSOperator,
              JTS.Seq,
              J.RSIssued,
              SQUEEZE(JTS.ReturnRemark),
              JTS.ParentJob
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   AC.Card = JC.Card AND
              JC.Job = J.Job AND
              JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$RestoreInt AND
              JTS.Job = J.Job AND
              J.ControlCard = AC.Card
      UNION
      SELECT  '',
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.TOMove,
              J.TOOperator,
              J.RSOperator,
              JTS.Seq,
              J.TOIssued,
              SQUEEZE(JTS.ReturnRemark),
              JTS.ParentJob
      FROM    SOA_Job J,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$TakeOutInt AND
              JTS.ParentJob <> 0 AND   /* This gets submoves */
              JTS.Job = J.Job AND
              J.ControlCard = AC.Card
      UNION 
      SELECT  '',
              J.Job,
              J.EquipClassName,
              J.EquipName,
              J.RSMove,
              J.TOOperator,
              J.RSOperator,
              JTS.Seq,
              J.RSIssued,
              SQUEEZE(JTS.ReturnRemark),
              JTS.ParentJob
      FROM    SOA_Job J,
              SOA_ActiveCard AC,
              IR_OpOrderJobs JTS
      WHERE   JTS.OrderNumber = :CurObject.OrderNumber AND
              JTS.TORS = :Job$RestoreInt AND
              JTS.ParentJob <> 0 AND  /* This gets submoves */
              JTS.Job = J.Job AND
              J.ControlCard = AC.Card
      ORDER BY Seq
      BEGIN
           i = i + 1;    
      END;

      /* 
      ** Query was too complex, had to separate Archive portion.  
      ** If previous select returned nothing, then we try to find
      ** order details in the archive tables.
      */  
      IF CurObject.Jobs.LastRow() = 0 THEN
         REPEATED
         SELECT :CurObject.Jobs[i].Printid = J.printid,
                :CurObject.Jobs[i].Job = J.Job,
                :CurObject.Jobs[i].EquipClassName = J.EquipClassName,
                :CurObject.Jobs[i].EquipName = J.EquipName,
                :CurObject.Jobs[i].TOMove = J.TOMove,
                :CurObject.Jobs[i].TOOperator = J.TOOperator,
                :CurObject.Jobs[i].RSOperator = J.RSOperator,
                :CurObject.Jobs[i].Seq = JTS.Seq,
                :CurObject.Jobs[i].TOIssued = J.TOIssued,
                :CurObject.Jobs[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark),
                :CurObject.Jobs[i].ParentJob = JTS.ParentJob
         FROM   FMS_ArchiveJob J,
                IR_OperatingOrder OO,
                IR_OpOrderJobs JTS
         WHERE  JTS.OrderNumber = :CurObject.OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                OO.OrderNumber = JTS.OrderNumber AND
                OO.Card = J.Card AND
                JTS.Job = J.Job 
         UNION 
         SELECT J.Printid,
                J.Job,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.RSIssued,
                SQUEEZE(JTS.ReturnRemark),
                JTS.ParentJob
         FROM   FMS_ArchiveJob J,
                IR_OperatingOrder OO,
                IR_OpOrderJobs JTS
         WHERE  JTS.OrderNumber = :CurObject.OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                OO.OrderNumber = JTS.OrderNumber AND
                OO.Card = J.Card AND
                JTS.Job = J.Job 
         UNION
         SELECT J.Printid,
                J.Job,
                J.EquipClassName,
                J.EquipName,
                J.TOMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.TOIssued,
                SQUEEZE(JTS.ReturnRemark),
                JTS.ParentJob
         FROM   SOA_ArchiveJob J,
                IR_OpOrderJobs JTS
         WHERE  JTS.OrderNumber = :CurObject.OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job 
         UNION 
         SELECT J.Printid,
                J.Job,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.RSIssued,
                SQUEEZE(JTS.ReturnRemark),
                JTS.ParentJob
         FROM   SOA_ArchiveJob J,
                IR_OpOrderJobs JTS
         WHERE  JTS.OrderNumber = :CurObject.OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job   
         ORDER BY Seq
         BEGIN
            i = i + 1;    
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;


