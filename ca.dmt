	Name:            TestCompleteStatus

/*
**
**  Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          TestCompleteStatus
**
**  Modifications:
**  11/11/98    pkw    modified slc version
*/

INITIALIZE
(
    J = JobInProgress;                /* Job being processed */
    i = INTEGER;                /* Scratch integer */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    Job[1] = J.Duplicate();
END;

ON Click OK_Btn =
BEGIN
/*
**  Place the test results into the response column of the move
*/  
    J.Response = Result;
    RetCode = CALLPROC SOA_JobResponseUpd(Job = J.Job,
                                          NewResponse = J.Response);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while trying to update test results.' + HC_NEWLINE +
                '  Results have not been saved.';
    ENDIF;
    RETURN;
END;


ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

Application Component Report
============================

	Name:            TFMS_CardCreationTrace

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**
**  Modifications:
**  08/16/94   bh     To support connectivity
**  01/16/96   ysp    
**  03/18/96   jfl    Stop path research when an opened switching 
**                    equipment is found.
**  03/19/96   jfl    Bypass outofservice equipments (InService = NULL)
**                    Don't go through outofservice End_Cap equipments
**  12/13/96   jfl    Fix bug: abusive endloop removed.
**  08/28/97   jfl    insertrow must be more cautious with OpenRoad
**  05/20/98   pkw    If cardtype is <> AUTO or OOE1 prompt user if they
**                    want to continue trace when an open piece of 
**                    equipment is found
**  02/16/99   em     Don't bother using Inservice/Outservice fields.  In PV
**                    environment, if things are connected, then we consider
**                    them to be in service.  PlaceInService/RemoveFromService
**                    logic will make connectivity calls.

**  11/01/99   em     As part of new card creation process, don't ask to go
**                    through open devices, just do it if card is not
**                    Auto or OOE1.  
**  11/02/99   em     As part of new TFMS card creation process, return
**                    de-energizing breaker list and line segment list to
**                    simplify subsequent card creation processing.
**                    This Connectivity Trace is specific to TFMS card
**                    creation.
**  11/17/99   em     Question remains, Is De-Energizing Breaker
**                    Type$LoadBreaking or Type$BREAKER.  Will be going with
**                    Type$BREAKER.  CONFIRMED same day.
**  05/30/00   em     Use ExtendedType to get ACLineSegments
**  11/15/00   em     OK, we change again, trace to Load-Breaking instead of
**                    BREAKER
**  12/12/00   em     Flip Flop, presto change-o.  Scope of trace to be bound
**                    by Type$BREAKER.  On Open Auto card, include 
**                    Type$LoadBreaking in the connected breaker list so that
**                    CktSwer shows up on the Trip/Not Trip list.
**  03/05/03   em     Include four FMS Source Type hierarchies in BREAKER list.
**  09/30/13   em     Moved procedure from SOA application. Include Currently_Open attribute in 
**                    returned breaker list.
**  04/13/16   em     Modify select to load primary grouping line fields from object table
**                    rather than from ACLineSegment because of modeling change where
**                    ACLineSegment to be primary grouped to substation instead of line.
**  05/23/16   em     Add Other Preload equipment types for return
**  08/31/16   em     Starting LineSegment must be connected in Udb_Terminal, modify initial select
**  02/23/17   em     bug joining Object to Terminal in initial Select
**  02/28/17   em     Conversion to QGIS Connected Model
**  
*/
PROCEDURE TFMS_CardCreationTrace
(
    retcode = INTEGER NOT NULL; /* return variable */
    AC = INTEGER NOT NULL WITH DEFAULT;  /*ACLineSeg Index*/
    BKR = INTEGER NOT NULL WITH DEFAULT; /*Breaker Index*/
    OTH = INTEGER NOT NULL WITH DEFAULT; /*Other Index*/
    i = INTEGER NOT NULL WITH DEFAULT;                            
    j = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER;                            
    m = INTEGER;          
    BreakerFlag = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/                  
    StartFeeder = INTEGER NOT NULL WITH DEFAULT;                            
    MoreObjects = INTEGER NOT NULL WITH DEFAULT;                            
    FirstObject = INTEGER NOT NULL WITH DEFAULT;                            
    StartEquip = ConnectedEquipClass;
    TempEquip = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    ConnectedBreakers = ARRAY OF ConnectedEquipClass;
    ConnectedLineSegs = ARRAY OF ConnectedEquipClass;
    ConnectedOthers = ARRAY OF ConnectedEquipClass;
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;
    StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
    ExcludedNodes   = Array of IntegerObject;
    Currentlyopen = INTEGER;
    CardType = INTEGER NOT NULL WITH DEFAULT;
    BreakerTypes = ARRAY OF INTEGEROBJECT;
    LoadBreakerTypes = ARRAY OF INTEGEROBJECT;
    LoadOtherTypes = ARRAY OF INTEGEROBJECT;
    BreakerFound = INTEGER NOT NULL WITH DEFAULT;
    LineSegTypes = ARRAY OF INTEGEROBJECT;
    LineSegFound = INTEGER NOT NULL WITH DEFAULT;
    Trace = Trace_TFMSCardCreation;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    ConnectedBreakers.Clear();
    ConnectedLineSegs.Clear();
    ConnectedOthers.Clear();
/*
** In QGIS model, ACLineSegment is Primary Grouped to a Substation and each line is represented with
** paired ACLineSegments, one in each station.
*/
    REPEATED
    SELECT 
            :StartEquip.Object = O.Object
,           :StartEquip.Type = O.Type
,           :StartEquip.Name = O.Name
,           :StartEquip.PrimaryGrouping = O.PrimaryGrouping
,           :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
    FROM    Udb_Object O,
            Udb_Grouping G,
            Udb_ExtendedType ET
    WHERE   G.Grouping = :StartFeeder AND
            G.Relationship = :Interaction$MemberOf AND
            G.MemberType = ET.Type AND
            ET.SuperType = :Type$ACLineSegment AND
            G.Member = O.Object;
            
    IF iirowcount <= 0 THEN
        IF DDB_Global.InhibitMessages = FALSE THEN
           Message 'Did not find ACLineSegment connectivity trace startpoint.';
        ENDIF;
        CurProcedure.Trace (Text = 'TFMS_CardCreationTrace Error: ' +
                            'Did not find ACLineSegment connectivity trace startpoint for Line ' +
                            VARCHAR(StartFeeder));
        RETURN -1;
    ENDIF;

    AC = 1;
    ConnectedLineSegs.InsertRow(RowNumber = AC,
                                RowObject = StartEquip.Duplicate());
    BKR = 0;
    OTH = 0;
/*
** Prepare the trace loop
*/
   Trace.CardClass = CardType;
   Trace.UsePendingStatus = FALSE;
   Trace.SaveAllInResult = TRUE;
   
   TraceStatus = Trace.StartCreationTrace(StartEquipObject = StartEquip.Object,
                                  StartEquipSubstation = StartEquip.PrimaryGrouping);

    i = 1;
    BreakerTypes.Clear();
    SELECT :BreakerTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType IN (:Type$BREAKER, 
                         :Type$Source, 
                         :Type$SOURCE_SBFKS,
                         :Type$SOURCE_BiFur,
                         :Type$SOURCE_VISY)
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;

    i = 1;
    LoadBreakerTypes.Clear();
    SELECT :LoadBreakerTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType = :Type$LoadBreaking
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;

    i = 1;
    LoadOtherTypes.Clear();
    SELECT :LoadOtherTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType = :Type$TFMSOtherPreloads
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;

    i = 1;
    LineSegTypes.Clear();
    SELECT :LineSegTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType = :Type$ACLineSegment
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;

    FOR i = 1 TO Trace.PathResultList.LastRow DO
       FOR j = 1 TO Trace.PathResultList[i].TargetEquipList.LastRow DO
/*
**  If an Auto card, do preselect of LoadBreaking to determine if
**  equipment should be inserted into breaker list.
*/
          IF CardType = Type$TFMSAuto THEN
             BreakerFound = LoadBreakerTypes.Find (AttributeName = 'value',
                                           Value = Trace.PathResultList[i].TargetEquipList[j].Type);
          ELSE
             BreakerFound = BreakerTypes.Find (AttributeName = 'value',
                                           Value = Trace.PathResultList[i].TargetEquipList[j].Type);
          ENDIF;

          IF BreakerFound = ER_OK THEN
/*
**  Make sure it is not a duplicate, if not insert it.
*/
                  m = 1;
                  WHILE m <= ConnectedBreakers.LastRow() DO
                   IF Trace.PathResultList[i].TargetEquipList[j].Object = ConnectedBreakers[m].Object THEN
                      ENDLOOP;
                   ELSE
                      m = m + 1;
                   ENDIF;
                  ENDWHILE; 

                  IF m > ConnectedBreakers.LastRow() THEN              
                     BKR = BKR + 1;
                     ConnectedBreakers.InsertRow(RowNumber = BKR);
                     ConnectedBreakers[BKR].Object = Trace.PathResultList[i].TargetEquipList[j].Object; 
                     ConnectedBreakers[BKR].Type = Trace.PathResultList[i].TargetEquipList[j].Type; 
                     ConnectedBreakers[BKR].Name = Trace.PathResultList[i].TargetEquipList[j].Name; 
                     ConnectedBreakers[BKR].PrimaryGrouping = Trace.PathResultList[i].TargetEquipList[j].PrimaryGrouping; 
                     ConnectedBreakers[BKR].PrimaryGroupingName = Trace.PathResultList[i].TargetEquipList[j].PrimaryGroupingName; 
                  ENDIF;
            CONTINUE;
         ENDIF;
/*
** Now get ACLineSegs
*/
         LineSegFound = LineSegTypes.Find (AttributeName = 'value',                                          
                             Value = Trace.PathResultList[i].TargetEquipList[j].Type);

         IF LineSegFound = ER_OK THEN
/*
**  Make sure it is not a duplicate, if not insert it.
*/
                  m = 1;
                  WHILE m <= ConnectedLineSegs.LastRow() DO
                   IF Trace.PathResultList[i].TargetEquipList[j].Object = ConnectedLineSegs[m].Object THEN
                      ENDLOOP;
                   ELSE
                      m = m + 1;
                   ENDIF;
                  ENDWHILE; 

                  IF m > ConnectedLineSegs.LastRow() THEN              
                     AC = AC + 1;
                     ConnectedLineSegs.InsertRow(RowNumber = AC);
                     ConnectedLineSegs[AC].Object = Trace.PathResultList[i].TargetEquipList[j].Object; 
                     ConnectedLineSegs[AC].Type = Trace.PathResultList[i].TargetEquipList[j].Type; 
                     ConnectedLineSegs[AC].Name = Trace.PathResultList[i].TargetEquipList[j].Name; 
                     ConnectedLineSegs[AC].PrimaryGrouping = Trace.PathResultList[i].TargetEquipList[j].PrimaryGrouping; 
                     ConnectedLineSegs[AC].PrimaryGroupingName = Trace.PathResultList[i].TargetEquipList[j].PrimaryGroupingName; 
                  ENDIF;
            CONTINUE;
         ENDIF;    
/*
** Now get Others
*/
         LineSegFound = LoadOtherTypes.Find (AttributeName = 'value',                                          
                             Value = Trace.PathResultList[i].TargetEquipList[j].Type);

         IF LineSegFound = ER_OK THEN
/*
**  Make sure it is not a duplicate, if not insert it.
*/
                  m = 1;
                  WHILE m <= ConnectedOthers.LastRow() DO
                   IF Trace.PathResultList[i].TargetEquipList[j].Object = ConnectedOthers[m].Object THEN
                      ENDLOOP;
                   ELSE
                      m = m + 1;
                   ENDIF;
                  ENDWHILE; 

                  IF m > ConnectedOthers.LastRow() THEN              
                     OTH = OTH + 1;
                     ConnectedOthers.InsertRow(RowNumber = OTH);
                     ConnectedOthers[OTH].Object = Trace.PathResultList[i].TargetEquipList[j].Object; 
                     ConnectedOthers[OTH].Type = Trace.PathResultList[i].TargetEquipList[j].Type; 
                     ConnectedOthers[OTH].Name = Trace.PathResultList[i].TargetEquipList[j].Name; 
                     ConnectedOthers[OTH].PrimaryGrouping = Trace.PathResultList[i].TargetEquipList[j].PrimaryGrouping; 
                     ConnectedOthers[OTH].PrimaryGroupingName = Trace.PathResultList[i].TargetEquipList[j].PrimaryGroupingName; 
                  ENDIF;
            CONTINUE;
         ENDIF;    
       ENDFOR;
    ENDFOR;

    RETURN(PU_OK);
END;


