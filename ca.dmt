ON CHILDSETVALUE PermitList[*].BaseKey =
DECLARE
   ORNumber = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Remove Location to Permit link as long as Permit has not been issued.
*/
   i = FIELD(PermitList).ActiveRow;
   IF i = 0 THEN
      MESSAGE 'You have not selected a Work Permit.';
   ENDIF;

   IF PermitList[i].BaseKey = FALSE THEN
      WorkItem.UnlinkWorkPermit(PermitJobID = PermitList[i].Job);
      IF WorkItem.ReturnCode <> 0 THEN
         MESSAGE WorkItem.ErrorMessage;
         RESUME;
      ENDIF;   
      WorkItem.PermitList.RemoveRow(RowNumber = SelectWPRow);
     
      // if there is not any work permit linked to the SWP, change the SWP's status
      // back to IMPORTED
      j = 0;
      SELECT :j = Count(*)
      FROM   SOA_OutageRequestPermit
      WHERE  ORNumber = :SWP.ORNumber;
      
      IF j = 0 THEN
         SWP.Status = Order$Opened;
         SWP.UpdateStatus();
         IF SWP.ReturnCode <> 0 THEN
            MESSAGE SWP.ErrorMessage;
         ENDIF;
      ENDIF;
      CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
      
   ELSE
      j = 0;
      SELECT :j = 1,
             :ORNumber = ORNumber
      FROM   SOA_OutageRequestPermit
      WHERE  PermitJobID = :PermitList[i].Job;
      IF j = 1 THEN
         MESSAGE 'The permit has already been linked to Outage Request ' + ORNumber + '.';
         PermitList[i].BaseKey = FALSE;
      ELSE
        WorkItem.LinkWorkPermit(SWPPermit = PermitList[i]);
        FIELD(WorkItem.PermitList).UpdField(); 
        CALLPROC UpdateSWPStatus();
        CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);  
      ENDIF; 
   ENDIF;
END;

