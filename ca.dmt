	Name:            ReviewRFPTags

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          ReviewRFPTags
**
**  Modifications:
**  12/09/02	em  created. 
*/

INITIALIZE
(   Card = INTEGER NOT NULL; /* Parameter */
    RFP = INTEGER NOT NULL;  /* Parameter */               

    i = INTEGER NOT NULL WITH DEFAULT;  /* Counter */
    RetCode = INTEGER NOT NULL WITH DEFAULT;  /*Return Code*/
    LastRFP = INTEGER NOT NULL WITH DEFAULT;  /* Used to remove revisions */
    LastRevision = INTEGER NOT NULL WITH DEFAULT;/* Used to remove revisions */
) =
BEGIN
/*
** Find any tags that are on RFP Locations
*/
    LastRFP = 0;
    LastRevision = 0;
    WLTag.Clear();
    i = 1;
    SELECT  :WLTAG[i].Street = L.Locationstreet
           ,:WLTAG[i].Structure = L.Locationstructure
           ,:WLTAG[i].tagtype = T.Tagtype
           ,:WLTAG[i].tagnumber = T.tagnumber
           ,:WLTAG[i].tagnotes = T.tagnotes
           ,:WLTAG[i].tagsentby = T.tagsentby
           ,:WLTAG[i].tagsentdate = T.tagsentdate
           ,:WLTAG[i].brasstag = 2           /* Default REMOVE */ 
           ,:WLTAG[i].plastictag = L.RFPLocation /* remove dupes */            
           ,:WLTAG[i].phases = L.RevisionNumber /* remove dupes */            
           ,:WLTAG[i].targetequip = O.TypeName + ' ' + O.Name
    FROM  IR_RFPLocation L,
          IR_RFPLocationTag T,
          Udb_Object O
    WHERE L.RFP = :RFP AND
          L.RFP = T.RFP AND
          L.RFPLocation = T.RFPLocation AND
          T.TagType IN ('CERTIFIED', 'DIRECTIONAL') AND
          O.Object = T.directionalequip
    ORDER BY PlasticTag, Phases DESC
    BEGIN
/*
** Sort in descinding order by Revision Number, that way most recent revision
** is retrieved first.  Remove subsequent copies.
*/
       IF LastRFP = WLTAG[i].plastictag AND WLTAG[i].phases < LastRevision THEN
          WLTag.RemoveRow (RowNumber = i);
       ELSE          
          LastRFP = WLTAG[i].plastictag;
          LastRevision = WLTAG[i].phases;
          i = i + 1;
       ENDIF;
    END;
    CALLPROC DDB_ROLLBACK;

    IF i = 1 THEN  
       RETURN;   /*No Tags to Review*/
    ENDIF;
END;
 

ON CLICK ok_btn =
BEGIN
/*
** Remove tags as indicated.  Log all tag retention or removal.
*/
   FOR i = 1 TO WLTag.LastRow() DO

      IF WLTAG[i].brasstag = 2 THEN
         RetCode = CALLPROC IR_RFPLocationTagDel (
            RFP = RFP
          , RFPLocation = WLTag[i].PlasticTag
          , TagType = WLTag[i].TagType
          , TagNumber = WLTag[i].TagNumber
         );

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Error while trying to remove Tag: ' +
                    WLTag[i].TagType + ' ' + WLTag[i].TagNumber;
            RESUME;
         ELSE
            CALLPROC DDB_COMMIT;
            CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = NULL, 
                 Item = 'Tag Removed',
                 Old  = 'Pool RFP',
                 New  = WLTag[i].TagType + ' Tag ' +
                        WLTag[i].TagNumber + ' Removed',
                 Time = Date('now'),
                 UserName = UserName);
            CALLPROC DDB_COMMIT;
         ENDIF;

      ELSE 
            CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = NULL, 
                 Item = 'Tag Kept',
                 Old  = 'Pool RFP',
                 New  = WLTag[i].TagType + ' Tag ' +
                        WLTag[i].TagNumber + ' Kept',
                 Time = Date('now'),
                 UserName = UserName);
            CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;
   RETURN;
END;


ON WindowClose =
BEGIN
   RESUME;
END;

