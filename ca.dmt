METHOD GetLastImport(
) = 
DECLARE

ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :CurObject.LastImport = MAX(Received)
   FROM   FMS_GreenSheet;
   
   IF CurObject.LastImport IS NULL THEN
      CurObject.LastImport = date('now') - '1 day';
   ENDIF;
   
   IF iierrornumber <> 0 Then
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Error accessing Green Sheet database table';      
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadRequests(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   

   DynamicWhereClause = 'GSF.RequestID = GS.RequestID AND ' + 
                'GSF.Feeder = G.Member AND ' + 
                'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                'G.GroupingType = ' + VARCHAR(Type$Division) + ' AND ' +
                'G.Grouping IN ( ';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow DO
      IF i = EffectiveDivisions.LastRow THEN
          DynamicWhereClause = DynamicWhereClause + 
                VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
          DynamicWhereClause = DynamicWhereClause + 
                VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;

   i = 1;
   CurObject.gslist.Clear();
   SELECT DISTINCT
           :CurObject.gslist[i].RequestID = GS.RequestID,
           :CurObject.gslist[i].Received = GS.Received,
           :CurObject.gslist[i].RequestBy = GS.RequestBy,
           :CurObject.gslist[i].StartDate = GS.StartDate,
           :CurObject.gslist[i].Processed = GS.Processed,
           :CurObject.gslist[i].ByDO = GS.ByDO,
           :CurObject.gslist[i].LastNotified = GS.LastNotified,
           :CurObject.gslist[i].LinkedPermit = GS.LinkedPermit
   FROM    FMS_GreenSheetFeeder GSF,
           Udb_Grouping G,
           FMS_GreenSheet GS
   WHERE   :DynamicWhereClause
   ORDER BY StartDate
   BEGIN
      k = 1;
      SELECT :CurObject.gslist[i].FeederList[k].Name  = FeederName,
             :CurObject.gslist[i].FeederList[k].Object = Feeder,
             :CurObject.gslist[i].FeederList[k].LocationComment = EquipNames
      FROM   FMS_GreenSheetFeeder
      WHERE RequestID = :CurObject.gslist[i].RequestID
      BEGIN
         k = k + 1;
      END;
      
      IF CurObject.gslist[i].Processed = -1 THEN
         CurObject.gslist[i].StatusName = 'Rejected by ' + CurObject.gslist[i].ByDO;
      ELSEIF CurObject.gslist[i].Processed = 0 THEN
         CurObject.gslist[i].StatusName = 'Not Linked';
      ELSEIF CurObject.gslist[i].Processed = 1 THEN
         CurObject.gslist[i].StatusName = 'Linked';
      ELSEIF CurObject.gslist[i].Processed = 2 THEN
         CurObject.gslist[i].StatusName = 'Linked and Started';
      ELSEIF CurObject.gslist[i].Processed = 3 THEN
         IF CurObject.gslist[i].LinkedPermit = 0 THEN
            CurObject.gslist[i].StatusName = 'Not Linked and start message sent at ' + HC_NEWLINE + VARCHAR(CurObject.gslist[i].LastNotified);
         ELSE
            CurObject.gslist[i].StatusName = 'Linked and start message sent at ' + HC_NEWLINE + VARCHAR(CurObject.gslist[i].LastNotified);
         ENDIF;
      ENDIF;
      i = i + 1;
   END;       
END;

METHOD ProcessRequests (
)=
DECLARE
   msgMessage = VARCHAR(400) NOT NULL;
   RequestCheck = INTEGER NOT NULL WITH DEFAULT;
   DateCheck = DATE NOT NULL WITH DEFAULT;
   TimeNow = DATE NOT NULL WITH DEFAULT;
   GreenCard = INTEGER NOT NULL;
   GreenCardFeeder = INTEGER NOT NULL;
   FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to look through green sheet request and send appropriate messages.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   TimeNow   = Date('now');
   DateCheck = Date('now') + '24 hours';

   i = 1;
   CurObject.gslist.Clear();
   SELECT :CurObject.gslist[i].RequestID = G.RequestID,
          :CurObject.gslist[i].Received  = G.Received,
          :CurObject.gslist[i].RequestBy = G.RequestBy,
          :CurObject.gslist[i].StartDate = G.StartDate,
          :CurObject.gslist[i].Processed = G.Processed,
          :CurObject.gslist[i].ByDO = G.ByDO,
          :CurObject.gslist[i].LastNotified  = G.LastNotified,
          :CurObject.gslist[i].LinkedPermit  = G.LinkedPermit
   FROM    FMS_GreenSheet G
   WHERE   G.Processed IN (0,1) AND  /* 0=not linked, 1=linked but no protection moves issued */
           G.StartDate >= :TimeNow AND
           G.StartDate < :DateCheck
   BEGIN    
      j = 1;
      SELECT :CurObject.gslist[i].FeederList[j].Name  = FeederName,
             :CurObject.gslist[i].FeederList[j].Object = Feeder,
             :CurObject.gslist[i].FeederList[j].LocationComment = EquipNames
      FROM   FMS_GreenSheetFeeder
      WHERE RequestID = :CurObject.gslist[i].RequestID
      BEGIN
         j = j + 1;
      END;

      IF CurObject.gslist[i].LastNotified = '' THEN
         i = i + 1;
      ELSE
         IF INT4(interval('minute', TimeNow - CurObject.gslist[i].LastNotified)) >= 540 THEN  /* 9 hours */
            i = i + 1;
         ELSE
            CurObject.gslist.RemoveRow (rownumber = i);
         ENDIF;   
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;
   
   FOR i = 1 TO CurObject.gslist.LastRow() DO
      IF CurObject.gslist[i].Processed = 0 THEN /* Not linked */
         CurObject.IsLinked(Request = CurObject.gslist[i]);
         IF CurObject.ReturnCode <> 0 THEN
            RETURN;
         ENDIF;
      ENDIF;
          
      IF CurObject.gslist[i].Processed = 1 THEN /* Linked but no protection issued */
         CurObject.IsProtectionIssued(Request = CurObject.gslist[i]);
         IF CurObject.ReturnCode <> 0 THEN
            RETURN;
         ENDIF;
      ENDIF; 
      
      IF CurObject.gslist[i].Processed = 2 THEN    /* linked and protection moves issued */
         continue;
      ENDIF;
      /*
      **  Find card
      */
      GreenCard = 0;
      GreenCardFeeder = 0;
      SELECT :GreenCard = C.Card,
             :GreenCardFeeder = C.Feeder
      FROM   FMS_GreenSheet G,
             SOA_JobControl JC,
             FMS_Card C
      WHERE  G.RequestID = :CurObject.gslist[i].RequestID AND
             G.LinkedPermit = JC.Job AND
             JC.Card = C.Card AND
             C.Status < :Card$Closed;

      FeederNames = '';
      FOR k = 1 TO CurObject.gslist[i].FeederList.LastRow DO
         IF k = 1 THEN
            FeederNames = CurObject.gslist[i].FeederList[k].Name
         ELSE
            FeederNames = FeederNames + ', ' + CurObject.gslist[i].FeederList[k].Name
         ENDIF;
      ENDFOR;

      /*
      **  Send appropriate incoming messages. 
      */
      IF INT4(interval('minute', CurObject.gslist[i].StartDate - DATE('NOW'))) <= 480 THEN  /* 480 minutes = 8 hours */

         /*
         ** send start message
         */
         msgMessage = 'GREEN SHEET START' + HC_NEWLINE +
                      'Greensheet work on feeder ' + FeederNames + 
                      ' has been requested to start in 8 hours' + HC_NEWLINE +
                      'Please start process now.  This is the last message you will receive for this requested work.';
         RetCode = CALLPROC MSG_SendMsg (Card = GreenCard,
                                  Action = 0,
                                  OrderNumber = CurObject.gslist[i].RequestID,
                                  Substation = CurObject.gslist[i].FeederList[1].Object,  
                                  SubstationName = FeederNames,
                                  Msg = msgMessage,
                                  FromOpName = CurObject.gslist[i].RequestBy,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FMS',
                                  FromApp = 'TASK',
                                  Priority = 1
                                  );

         IF RetCode < 0 THEN
	        CALLPROC DDB_ROLLBACK;
	        CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Message for Greensheet request '+ 
	                   VARCHAR(CurObject.gslist[i].RequestID) + 
	                   ' could not be sent to the DO.  Please check MSG_LASTKEY in each database.');
	        CurObject.ReturnCode = -1;
	        CurObject.ErrorMessage = 'Greensheet request ' + 
	                     VARCHAR(CurObject.gslist[i].RequestID) +
	                    ' message was not sent to DO.';
    
           RETURN;
         ENDIF;  
         CALLPROC DDB_COMMIT;
       
         RetCode = CALLPROC FMS_GreenSheetUpd(RequestID = CurObject.gslist[i].RequestID,
                                              Processed = 3,  /* Start message sent */
                                              LastNotified = TimeNow
                                             );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::Greensheet_ASE - ' +
                                     'Not able to update processed flag to 3 for feeder ' + FeederNames;
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;

      ELSE
         IF CurObject.gslist[i].Processed = 1 THEN  /* linked */
            continue;
         ENDIF;
         RequestCheck = 0;
         SELECT :RequestCheck = COUNT(*)
         FROM   MSG_Message M
         WHERE  M.OrderNumber = :CurObject.gslist[i].RequestID AND
                M.DelByOpName = '';
         IF RequestCheck = 0 THEN
            /*
            ** send start process message
            */
            msgMessage = 'GREEN SHEET PREPARE PERMIT' + HC_NEWLINE +
                      'Greensheet work on feeder(s) ' + FeederNames + 
                      ' has been requested to start at ' + VARCHAR(CurObject.gslist[i].StartDate) + HC_NEWLINE +
                      'You will receive a reminder to prepare the permit again in 9 hours.';            

            RetCode = CALLPROC MSG_SendMsg (Card = GreenCard,
                                  Action = 0,
                                  OrderNumber = CurObject.gslist[i].RequestID,
                                  Substation = CurObject.gslist[i].FeederList[1].Object,
                                  SubstationName = FeederNames,
                                  Msg = msgMessage,
                                  FromOpName = CurObject.gslist[i].RequestBy,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FMS',
                                  FromApp = 'TASK',
                                  Priority = 1
                                  );

            IF RetCode < 0 THEN
	           CALLPROC DDB_ROLLBACK;
	           CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Message for Greensheet request '+ 
	                    VARCHAR(CurObject.gslist[i].RequestID) + 
	                    ' could not be sent to the DO.  Please check MSG_LASTKEY in each database.');
	           CurObject.ReturnCode = -1;
	           CurObject.ErrorMessage = 'Greensheet request ' + 
	                      VARCHAR(CurObject.gslist[i].RequestID) +
	                     ' message was not sent to DO.';
    
              RETURN;
            ENDIF;  
            CALLPROC DDB_COMMIT;
         ENDIF;
                
         RetCode = CALLPROC FMS_GreenSheetUpd(RequestID = CurObject.gslist[i].RequestID,
                                              LastNotified = TimeNow
                                             );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::Greensheet_ASE - ' +
                                     'Not able to update LastNotified time for feeder ' + Feedernames;
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;      
      ENDIF;
   ENDFOR;
   
   RETURN;
END;

METHOD IsLinked(
   Request = GreenSheet;
) = 
DECLARE
   PermitCheck = INTEGER NOT NULL;
   SavePermit = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   SavePermit = Request.LinkedPermit;
   
   IF Request.LinkedPermit <> 0 THEN
      PermitCheck = 0;
      SELECT :PermitCheck = COUNT(*)
      FROM    SOA_Job J
      WHERE   J.Job = :Request.LinkedPermit;
      IF Permitcheck = 0 THEN
         Request.LinkedPermit = 0;
      ENDIF;
   ENDIF;
   
   IF Request.LinkedPermit = 0 THEN
      SELECT :Request.LinkedPermit = J.Job
      FROM   SOA_ActiveCard C,
             SOA_JobControl JC,
             SOA_Job J,
             FMS_GreenSheetFeeder GS,
             TFMS_CardToObject CTO
      WHERE  GS.RequestID = :Request.RequestID AND
             GS.Feeder = CTO.Object AND
             CTO.Card = C.Card AND
             C.Card = JC.Card AND
             JC.Job = J.Job AND
             J.Status = '' AND
             lowercase(J.ToMove) like '%to cpm%' AND
             J.TOIssued IS NULL AND
             J.Job NOT IN (SELECT LinkedPermit
                           FROM   FMS_GreenSheet)
      UNION
      SELECT J.Job
      FROM   FMS_Card C,
             SOA_JobControl JC,
             SOA_Job J,
             FMS_GreenSheetFeeder GS,
             Udb_Grouping G
      WHERE  GS.RequestID = :Request.RequestID AND
             GS.Feeder = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType IN (:Type$ISOFeeder,:Type$KPSFeeder,:Type$SectionalFeeder) AND
             G.Member = C.Feeder AND
             C.Card = JC.Card AND
             JC.Job = J.Job AND
             J.Status = '' AND
             lowercase(J.ToMove) like '%to cpm%' AND
             J.TOIssued IS NULL AND
             J.Job NOT IN (SELECT LinkedPermit
                           FROM   FMS_GreenSheet);
   ENDIF;
   
   IF SavePermit <> Request.LinkedPermit AND
      Request.LinkedPermit > 0 THEN
      Request.Processed = 1;
      RetCode = CALLPROC FMS_GreenSheetUpd(RequestID = Request.RequestID,
                                           Processed = Request.Processed,
                                           LinkedPermit = Request.LinkedPermit
                                          );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::Greensheet_ASE - ' +
                                  'Not able to update linked permit for feeder ' + Request.FeederList[1].Name;
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   RETURN;   
END;

METHOD IsProtectionIssued(
   Request = GreenSheet;
) = 
DECLARE
   PermitCheck = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /* 
   **  This method is used to change status to 2 if protection moves have been issued 
   **  against the linked permit
   */
   PermitCheck = 0;
   SELECT :PermitCheck = COUNT(*) 
   FROM   SOA_Job J,
          FMS_WorkPermitProtection W
   WHERE  W.Permitjobid = :Request.LinkedPermit AND
          W.ProtectionJobId = J.Job AND 
          J.ToIssued IS NOT NULL;
   /*
   **  Check to see if linked permit has been issued.
   */
   IF PermitCheck = 0 THEN
      SELECT :PermitCheck = COUNT(*) 
      FROM   SOA_Job J
      WHERE  J.Job = :Request.LinkedPermit AND
             J.ToIssued IS NOT NULL;
   ENDIF;
   IF PermitCheck <> 0 THEN
      Request.Processed = 2;
      RetCode = CALLPROC FMS_GreenSheetUpd(RequestID = Request.RequestID,
                                           Processed = Request.Processed
                                          );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::Greensheet_ASE - ' +
                                  'Not able to update proccessed flag to 2 for feeder ' + Request.FeederList[1].Name;
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   RETURN;   
END;

