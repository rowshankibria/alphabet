	Name:            SelectFMSObject

/****************************************************************************

          Copyright � 1993 by Unified Information, Inc.
          All Rights Reserved.  Unpublished rights reserved under the
          copyright laws of the United States.

          The software contained on this media is proprietary to and
          embodies the confidential technology of Unified Information, Inc.
          Possession, use, duplication or dissemination of the software 
          and media is authorized only pursuant to a valid written license 
          from Unified Information, Inc.

          RESTRICTED RIGHTS LEGEND  Use, duplication, or disclosure by the
          U.S. Government is subject to restrictions as set forth in
          Subparagraph (c) (1) (ii) of DFARS 252.227-7013, or in FAR
          52.227-19, as applicable.

 ****************************************************************************/

/*
 *      Application:    CAC
 *      Frame:          SelectFMSObject
 *
*/
/*
**  07/13/94  bgh  Initial Version.
**  07/21/04  em   Moved into CAC
**  05/24/07  ysp  Add equipment from New or Drop bank
*/

INITIALIZE
(
    i = INTEGER NOT NULL;                   /* Scratch integer */
    GetFeederOnly = INTEGER NOT NULL;
    match = varchar(40);        
    ObjectID = INTEGER NOT NULL WITH DEFAULT;
    ObjectName = VARCHAR(40) NOT NULL WITH DEFAULT;
)=
BEGIN
    IF GetFeederOnly = TRUE THEN
        FIELD(Bank).CurBias = FB_Invisible;
        STACKFIELD(FIELD(SelectEquip).ParentField).CurBias = FB_Invisible;
        FIELD(Loc).CurBias = FB_Invisible;
        FIELD(SelectFeeder).Title = 'Select Feeder';
    ELSE
       /*
       ** Initialize Division field
       */
       FIELD(Bank.division).ValueList.ChoiceItems[1].EnumValue = 0;	
       FIELD(Bank.division).ValueList.ChoiceItems[1].EnumText = '';	

       i = 2;
       SELECT DISTINCT 
             :ObjectID = O.Object,	
             :ObjectName = O.Name
       FROM  Udb_Object O,
             Udb_Object D,
             Udb_Grouping G 
       WHERE  D.Type = :Type$OperatorDesk AND 
           D.Object = G.Grouping AND 
           G.Relationship = :Interaction$MemberOf AND 
           G.MemberType = :Type$Division AND
           G.Member = O.Object 
       BEGIN
          FIELD(Bank.division).ValueList.ChoiceItems[i].EnumValue = ObjectID;
          FIELD(Bank.division).ValueList.ChoiceItems[i].EnumText = ObjectName;
          i = i + 1;
       END;
       FIELD(Bank.division).UpdChoiceList();
    ENDIF;
        
    SelectFeeder.Clear();
    i = 1;
    REPEATED
    SELECT  :SelectFeeder[i].Object = O.Object,
            :SelectFeeder[i].Name = O.Name
    FROM    Udb_Object O
    WHERE   O.Type IN (
                       SELECT  Type 
                       FROM    Udb_ExtendedType
                       WHERE   SuperType = :Type$Feeder) AND
            O.Name != VARCHAR(O.Object)
    ORDER BY Name
    BEGIN
        i = i + 1;
    END; 

    CALLPROC DDB_ROLLBACK;
    CurFrame.SendUserEvent (eventname = 'load_data');
END;

/*
**	 set up the display
*/                       
ON UserEvent 'load_data' =
BEGIN
   Selected.Object = 0;
   Selected.Name = '';
END;

/*
**	 set up the display
*/                       
ON UserEvent 'load_equip' =
BEGIN
/* Clear out storage */ 
    SelectEquip.Clear();
    i = 1; 
    REPEATED
    SELECT	
        :SelectEquip[i].Object = O.Object,  
	    :SelectEquip[i].Name = O.Name, 
	    :SelectEquip[i].Type  = O.Type, 
	    :SelectEquip[i].TypeName  = O.TypeName, 
	    :SelectEquip[i].Reference = G.Reference
    FROM	Udb_Object O, 
            Udb_Grouping G  
    WHERE	G.Grouping = :Selected.Object AND
            G.Member = O.Object AND 
            G.Relationship = :Interaction$MemberOf AND
            G.MemberType IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  SuperType = :Type$Switch) 
    ORDER BY Reference, Name 
    BEGIN 
	    i = i + 1; 
    END; 
    CALLPROC DDB_ROLLBACK;
END;

/*
**	 set up the display
*/                       
ON UserEvent 'load_location' =

BEGIN
    Loc.Address1 = '';
    Loc.Address2 = '';
    Loc.Address3 = '';
    Loc.Address4 = '';
    Loc.LocationComment = '';
    REPEATED
    SELECT 
        Loc.Address1 = L.L1,
        Loc.Address2 = L.L2,
        Loc.Address3 = L.L3,
        Loc.Address4 = L.L4,
        Loc.LocationComment = L.Comment
   FROM   Udb_Grouping G,
          Udb_Location L
   WHERE  :SelectedEquip.Object = G.Member AND
          G.Relationship = :Interaction$LocatedWith AND
          G.Grouping = L.Object;
   CALLPROC DDB_ROLLBACK;
END;

/*
**	Handle a feeder selection from the list
*/
ON ChildEntry SelectEquip =

BEGIN
    IF CurFrame.ReasonCode != RC_MOUSECLICK THEN
        RESUME;
    ENDIF;
    SelectedEquip.Object = SelectEquip[].Object;  
    SelectedEquip.Name = SelectEquip[].Name;
    SelectedEquip.Type  = SelectEquip[].Type;
    SelectedEquip.TypeName  = SelectEquip[].TypeName;
    SelectedEquip.Reference = SelectEquip[].Reference; 

    Loc.EqName = SelectEquip[].Name;
    Curframe.SendUserEvent(EventName = 'load_location');
END;

/*
**	Handle a feeder selection from the list
*/
ON ChildEntry SelectFeeder =

BEGIN
    IF CurFrame.ReasonCode != RC_MOUSECLICK THEN
        RESUME;
    ENDIF;
    Selected.Object = SelectFeeder[].Object;
    Selected.Name = SelectFeeder[].Name;
    Loc.FdrName = SelectFeeder[].Name;
    IF GetFeederOnly = FALSE THEN
       Bank.Division = 0;
       Curframe.SendUserEvent(EventName = 'load_equip');
    ENDIF;
END;

ON CLICK FindButton =
BEGIN
    i = 1;
    WHILE i <= SelectFeeder.LastRow() Do
        match = uppercase(Selected.Name) + '%';
        IF Uppercase(SelectFeeder[i].Name) like match THEN
            Endloop;
        Endif;

        i = i + 1;
    ENDWHILE;

    IF i <= SelectFeeder.LastRow() Then
        Field(SelectFeeder).CurRow = i;
        Selected.Object = SelectFeeder[].Object;
        Selected.Name = SelectFeeder[].Name;
        Loc.FdrName = SelectFeeder[].Name;
        IF GetFeederOnly = FALSE THEN
            Curframe.SendUserEvent(EventName = 'load_equip');
        ENDIF;
    ELSE
	MESSAGE 'Feeder does not exist or is not available to you.';
		Selected.Name = '';
        Selected.Object = 0;
	RESUME;
    ENDIF;
END;

ON SetValue Bank.EquipType =
BEGIN
    Bank.Division = 0;
END;

ON SetValue Bank.Division =
BEGIN
    IF (Bank.division = 0) THEN
        message 'You must select a division.';
    ENDIF;
    Loc.FdrName = '';

    i = 1;
    SelectEquip.Clear();

    IF Bank.EquipType = 1 THEN    /* new equipment */
       REPEATED 
       SELECT
            :SelectEquip[i].Object = O.Object,  
	    :SelectEquip[i].Name = O.Name, 
	    :SelectEquip[i].Type  = O.Type, 
	    :SelectEquip[i].TypeName  = O.TypeName, 
	    :SelectEquip[i].Reference = G.Reference
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  G.Grouping = :Bank.Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType = :Type$Grouper))
       AND    O.OutService IS NULL
       AND    O.InService IS NULL
       ORDER BY Reference, Name 
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;

    ELSEIF Bank.EquipType = 2 THEN  /* dropped equipment */
       REPEATED 
       SELECT
            :SelectEquip[i].Object = O.Object,  
	    :SelectEquip[i].Name = O.Name, 
	    :SelectEquip[i].Type  = O.Type, 
	    :SelectEquip[i].TypeName  = O.TypeName, 
	    :SelectEquip[i].Reference = G.Reference
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  G.Grouping = :Bank.Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType = :Type$Grouper))
       AND    O.Outservice IS NOT NULL
       ORDER BY Reference, Name 
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;
    ENDIF;

    IF i = 1 THEN
       MESSAGE 'No equipment in the selected division.';
       RESUME;
    ENDIF;    
END;

ON Click Apply_Button =
/*
 *      Done for now
 */
    BEGIN
        IF GetFeederOnly = TRUE THEN
            RETURN Selected;
        ELSE
            RETURN SelectedEquip;
        ENDIF;
    END;

ON Click Cancel_Button =
/*
 *      Done for now
 */
    BEGIN
        RETURN NULL;
    END;
								 *Default Item

									 *Default Item


