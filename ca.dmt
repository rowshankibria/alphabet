	Name:            CheckProtGroundsApplied

 /*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckProtGroundsApplied
**
**  Modifications:
**	 11/03/92   em	    Created 
**  11/12/92   em     Add RapidRestore Check, Don't care about grounds if 
**                    RapidRestore Set.
**  02/05/93   em     removed call to check stationout.
**  02/14/93   em     decrement by number of grounds on equipment, not just 1.
**  02/23/93   em     if confirm okay, return null instead of warningoverride
**  05/13/01   em     Bigger Confirm message per Con Ed
**  06/08/01   my     A new confirm screen will be displayed.
**  09/06/01   em     Only display new protection confirmation screen if 
**                    move is in Work Permit step.
**  11/19/02   ysp    Merge: removed passed-in C and Jobs
**  01/13/02   pkw    Fix formatting of displayed message.
**  02/24/03   em     Removed EffectiveDivisions parm
**  02/14/04   em     If in automatic execution, can't call Confirm or 
**                    ProtectionCheck Confirm
**  07/18/05   em     Removed call to ProtectionCheckConfirm, moved to Job Checks
**                    for all Work Permits Step moves.
**  08/10/16   ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
**  06/04/19   pkw    Remove code related to rapidrestore flag.
*/
PROCEDURE CheckProtGroundsApplied 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
ENDDECLARE
BEGIN
/*
**    Find all feeders which this piece of equipment is common.
**    If we couldn't find a feeder then nothing more to do
*/
    k = 1;
    REPEATED
    SELECT
    DISTINCT
           :CommonFeederCard[k].Card = C.Card,
           :CommonFeederCard[k].Feeder = C.Feeder,
           :CommonFeederCard[k].FeederName = C.FeederName,
           :CommonFeederCard[k].GroundsOn = C.GroundsOn,
           :CommonFeederCard[k].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[k].TypeOfCard = C.TypeOfCard
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    Where   JC.Job = :JIP.Job AND
            JC.Card = AC.Card AND
            JC.Card = C.Card
    BEGIN
        k = k + 1;
    END;

    RetCode = NULL;

    FOR k = 1 TO CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[k].GetGeneralCardName();

       WarningStatus = PU_OK;
       i = CommonFeederCard[k].GroundsOn;

       IF JIP.Grounds IS NOT NULL AND JIP.Grounds > 0 THEN
           i = i - JIP.Grounds;   /* Don't count grounds on this piece of equipment */ 
       ENDIF;

       IF i = 0 THEN 
           WarningStatus = CALLFRAME Warning 
                              (Card = JIP.Card, 
                               Job = JIP.Job,
                               SwitchingItem = JIP.SwitchingItem,
                               Text = 'There are no protective grounds applied on feeder ' + 
                                      FeederName + '.');
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;

       ELSEIF i = 1 THEN
           WarningStatus = CALLFRAME Warning 
                              (Card = JIP.Card, 
                               Job = JIP.Job,
                               SwitchingItem = JIP.SwitchingItem,
                               Text = 'There is only one protective ground applied on feeder ' + 
                                      FeederName + '.');
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;

       ELSE 
           IF AutomaticExecution = FALSE THEN
/*
** If work permit, call new protection confirmation screen, else call old
** Confirm.  (Some Dead Moves use this Precheck.)
*/
              IF JIP.StepPair = StepHeading$OTW THEN
/*
                ConfirmStatus = CALLFRAME ProtectionCheckConfirm (
                                      Card = JIP.Card, Job = JIP.Job);
    
                IF ConfirmStatus = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   CONTINUE;
                ENDIF;
*/
              ELSE
                 ConfirmStatus = CALLFRAME Confirm (Card = JIP.Card, Job = JIP.Job,
                                          Text = 'All protective grounds are applied on feeder ' + 
                                                  FeederName + '.');

                 IF ConfirmStatus = PU_CANCEL THEN
                    RETURN(PU_CANCEL);
                 ELSE
                    CONTINUE;
                 ENDIF;
              ENDIF;
           ENDIF;
       ENDIF;
    ENDFOR;

    RETURN(RetCode); 
END;

