	Name:            ActivateFMSCard


/*
**      Copyright c 2006 Pateric Software LLC. All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written 
**      permission from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Frame:          ActivateFMSCard 
** 
**  Date:     Version  Description 
** ------------------------------------------------- 
**  03/28/06   ysp  Created
**  08/11/06   ysp  Add Process Indicator.
**  02/16/07   ysp  Add CutOutSent. If an Open Auto move has been successfully completed,
**                  don't explicitly call NotificationCutOut again.
**  04/23/07   ysp  ITC210: Insert IR interface event in DB event queue
**  05/18/07   em   Include OOE1 with SX Activation
**  07/08/08   pkw  Add check for ATS load feeders.
**  05/12/09   em   Add Breaker Did Not Trip parameter to set Card Cut Out but not issue Open
**                  Auto move for cards created on Bus Section Outage where there is a Closed Feeder
**                  Breaker. 
**  11/25/09  em    Check if feeder in service, if not put it in service at activation and send email.
**  12/22/09  ysp   Fix Feeder In Service email for 4 KV feeders
**  01/05/10  em    Don't send inservice email for ATS Load feeders
**  01/27/10  ysp   add email subject and template to class
**  04/28/10  em    Propagate shared 3G moves
**  10/21/10  em    Support Feeder Status insertion for all 3G Feeders
**  02/03/11  em    Just pass first card object to NotificationCutout
**  11/12/12  pkw   Activate any linked StepDown feeders to card.
**  12/17/12  pkw   Transfer link to existing card if 4kV is out of service.
**  12/21/12  pkw   If Activating an 4kv StepDown OpenAuto as part of a 13kV
**                  OpenAuto, don't issue the cutout move on the 4kv.  Just cutit out.
**  03/26/13  pkw   Check for Active Linked StepDown card before trying to activate
**                  a 4kv Card make sure open
**  09/04/13  pkw   Ensure activate process works for 3G cards and StepDown 4kV.
**  09/07/15  em    Remove OOE1 from automatic Cutout so XA21 can be used
**  02/22/16  em    OOE1 activation was sending CIG message, disabled unless sent from XA21.
**                  Add SXOpenAuto flag to support from XA21.
**  10/18/16  ysp   Merge from em: For 33kV feeder, only set NetworkProtection feeder status for 
**                  segments that have S-T equipment
**  11/08/18  pkw   Display message to issue FOD order if Micro Grid Generator exists on feeder 
*/
INITIALIZE
(
   Card = INTEGER NOT NULL WITH DEFAULT;  /* Parm */
   OldCardStatus = INTEGER NOT NULL;      /* Parm */
   BreakerDidNotTrip = INTEGER NOT NULL WITH DEFAULT;  /* optional for Bus Section Open Auto */
   Jobs = ARRAY OF Job;                   /* optional - list of jobs */
   SXOpenAuto = INTEGER NOT NULL WITH DEFAULT;  /* Parm */
   CutOut = DATE DEFAULT NULL;            /* optional - open auto time */

   i = INTEGER NOT NULL WITH DEFAULT; 
   k = INTEGER NOT NULL WITH DEFAULT; 
   n = INTEGER NOT NULL WITH DEFAULT; 

   ATSLoadFeeder = INTEGER NOT NULL WITH DEFAULT; 
   CardObject = FMS_Card DEFAULT NULL;     /* Enables use of class methods */
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   EmailClass = EmailNotificationClass DEFAULT NULL;
   Equip = INTEGER NOT NULL;
   EquipList = VARCHAR(800) NOT NULL WITH DEFAULT; /*Common Equipment*/
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FeederInService = DATE;
   FeederRating = FLOAT;
   FMSCardASE = FMS_Card_ASE DEFAULT NULL; /* Enables use of class methods */
   HasSTEquip = INTEGER NOT NULL WITH DEFAULT;   
   Idx = ARRAY of IntegerObject;   /* Used to indicate new job order */
   ImpactedCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
   ISOCount = INTEGER NOT NULL WITH DEFAULT;     /*Count of isolation moves*/
   NetworkProtectorJob = INTEGER NOT NULL;          /*Job ID*/
   CutOutSent = INTEGER NOT NULL WITH DEFAULT;
   ProcessCount = INTEGER NOT NULL;
   ProcessWindow = FrameExec;            
   RetCode = INTEGER;
   SimpleJob = Job DEFAULT NULL;        /*Enables use of class methods*/
   SimpleJobAse = Job_ASE DEFAULT NULL; /* Enables use of class methods */
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   SItem = ARRAY OF Job;                     /*Propagate moves*/
   STAMove = INTEGER NOT NULL WITH DEFAULT;    /*Outstanding STA Move existence*/
   SubstationCard = INTEGER NOT NULL WITH DEFAULT;
   ATS = ATSLoad; 
   NoStepDown = INTEGER NOT NULL WITH DEFAULT;
   StepDownCard = ARRAY OF FMS_Card;
   SDCardCheck = FMS_Card;
   StepDownOAJob = Job;
   d  = Date;          /* Temporary date */
)=
BEGIN
/*
**  Open process window indicator.  Since there is no while loop for this
**  procedure,  we will hardcode the max steps to 9.  If this procedure in the
**  future gets more steps this number will have to get increased and the frame
**  updated where the extra procedure is called.
*/
    ProcessCount = 1;
    IF NoStepDown = TRUE THEN
       ProcessWindow = OPENFRAME ProcessIndicator 
                                 (ParentFrame = CurFrame,
                                  Pct_Title = 'Activate 4kV Step Down Card',
                                  MaxValue = 10);
    ELSE
       ProcessWindow = OPENFRAME ProcessIndicator 
                                 (ParentFrame = CurFrame,
                                  Pct_Title = 'Activate FMS Card',
                                  MaxValue = 10);
    ENDIF;
    CurFrame.WaitFor (EventName = 'Received');

/*  
** Read in the card data
*/  
   FMSCardASE = FMS_Card_ASE.Create();		    
   FMSCardASE.Card = Card;    
   FMSCardASE.ArchiveCard = FALSE;		    
   FMSCardASE.LoadCard();
		   
   IF FMSCardASE.ReturnCode <> 0 THEN
       CALLPROC TraceError(UserMessage = FMSCardASE.ErrorMessage, 
                TraceMessage = 'Error - ActivateFMSCard failed to load FMS card ' + 
                VARCHAR(Card));
       RETURN PU_CANCEL;
   ENDIF;
		
   CardObject = FMSCardASE.C.Duplicate();
   FMSCardASE = NULL;

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');
/*
** Read in the Job data
*/
   IF Jobs.LastRow = 0 THEN
      SimpleJobAse = Job_ASE.Create();
      		     
      SimpleJobAse.Card = Card;    
      SimpleJobAse.ArchiveCard = FALSE;
      SimpleJobAse.Application = Application$FMS;
      SimpleJobAse.LoadJobs();
      		   
      IF SimpleJobAse.ReturnCode <> 0 THEN
         CALLPROC TraceError(UserMessage = SimpleJobAse.ErrorMessage, 
                TraceMessage = 'Error - ActivateFMSCard failed to load FMS jobs for card ' + 
                VARCHAR(Card));
         RETURN PU_CANCEL;
      ENDIF;
      		
      Jobs = SimpleJobAse.J.Duplicate();
      SimpleJobAse = NULL;
   ENDIF; 

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');
/*
** Activate
*/
   RetCode = CALLPROC FMS_ActivateCard (
      Card = Card,
      Activated = DATE('now'),
      Status = Card$Active);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError(UserMessage = 'Problem setting active card status. Activation cancelled.', 
                TraceMessage = 'Error - ActivateFMSCard failed to set active status for card ' + 
                VARCHAR(Card));
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   CALLPROC SOA_LogIns (
           Card = Card,
           Job  = NULL,
           SwitchingItem = 0,
           Time = DATE('Now'), 
           UserName = UserName,
           Item = 'Activation',
           Old  = '',
           New  = 'Card Activated');
   CALLPROC DDB_COMMIT;
/*
** Load Outstanding Moves for common equipment.
*/
   IF SimpleJob IS NULL THEN
      SimpleJob = Job.Create();
   ENDIF;
            
   RetCode = SimpleJob.LoadOutstandingMoves(Application = Application$FMS, 
                                            Jobs = Jobs, 
                                            Card = Card,
                                            Feeder = CardObject.Feeder,
                                            TypeOfCard = CardObject.TypeOfCard,
                                            SingleFeederOnly = TRUE);
   IF RetCode = PU_CANCEL THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError(UserMessage = 'Unable to Load Outstanding FMS Moves due to Errors.', 
                TraceMessage = 'Error - ActivateFMSCard failed to load outstanding move for fms card ' + 
                VARCHAR(Card));

      CALLPROC FMS_CardStatusUpd
           (NewStatus = Card$Open,
            Card = Card);
      CALLPROC DDB_COMMIT;
      RETURN PU_CANCEL;
   ENDIF;

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');
/*
** Delete any jobs out of FMS_DroppedEquipJobs that are related to equipment
** on this feeder.  LoadOutstandingMoves places these moves on the card.  
*/
   FOR n = 1 TO CardObject.Object.LastRow() DO
      CALLPROC FMS_DroppedEquipFdrDel (Feeder = CardObject.Object[n].Object);
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** Set equipment control for existing jobs.
*/
   RetCode = SOA_ActivationControl (
        Card = Card,
        SwitchingItem = 0);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError(UserMessage = 'Problem setting Control Card move values.', 
                TraceMessage = 'Error - ActivateFMSCard failed to set Card Control for fms card ' + 
                VARCHAR(Card));
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');
/*
**  Get a list of common equipment which appears on other active/otw cards
*/          
   Equip = 0;         
   k = 0;
   EquipList = '';

   REPEATED 
   SELECT DISTINCT  
	   :Equip = G1.Member
   FROM      Udb_Grouping G1,
             Udb_Grouping G2,
             SOA_ActiveObject AO,  
             TFMS_CardToObject CTO
   WHERE     CTO.Card = :Card AND
             CTO.Object = G1.Grouping AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Member = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = AO.Object AND
             AO.ObjectToCardLink = 1 AND
             AO.Card <> :Card
   BEGIN
      IF k = 0 THEN
         EquipList = '(' + varchar(Equip);
         k = 1;
      ELSE
         EquipList = EquipList + ',' + varchar(Equip);
      ENDIF;
   END;

/*
** Now look for moves on that equipment that should be shared elsewhere.
*/
   IF EquipList <> '' THEN /* There are jobs to be loaded elsewhere */
      EquipList = EquipList + ')';

      DynamicWhereClause = '';
      DynamicWhereClause = 'J.Equip IN ' + EquipList + ' AND ' +
         'J.MoveCategory = ' + VARCHAR(MoveCategory$Normal) + ' AND ' +
         'J.Status IN (' + '''' + '''' + ',' + '''' + 
         VARCHAR(JobStatus$NIS) + '''' + ') AND ' +
         'JC.Card = ' + varchar(Card) + ' AND ' +
         'JC.Job = J.Job';

      i = 1;
      SItem.Clear();
      SELECT :SItem[i].Job         = J.Job,
             :SItem[i].Equip       = J.Equip,
             :SItem[i].EquipClass  = J.EquipClass,
             :SItem[i].JobClass    = J.JobClass,
             :SItem[i].TOIssued    = J.TOIssued,
             :SItem[i].TOComplete  = J.TOComplete,
             :SItem[i].RSIssued    = J.RSIssued,
             :SItem[i].RSComplete  = J.RSComplete,
             :SItem[i].Substation  = J.Substation,
             :SItem[i].MoveEquipClass = JC.MoveEquipClass,
             :SItem[i].PrintID        = JC.PrintID,
             :SItem[i].StepLevel      = JC.StepLevel,
             :SItem[i].StepPair       = JC.StepPair
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  :DynamicWhereClause
      BEGIN
         i = i + 1;
      END;
/*
**  Populate other active cards with preloaded moves from this card.
*/
      ImpactedCardList.Clear();
      i = 1;
      WHILE i <= SItem.LastRow() DO
         Idx.Clear();
         Idx = CALLPROC CascadeMoves (Move = SItem[i],
                                      Card = Card,
                                      NotShadowItem = TRUE);
#        include ManageImpactedCards

         i = i + 1;
      ENDWHILE;

#     include NotifyImpactedCards
   ENDIF;

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

/*
** In the case where an FMS card is being activated into a CutOut move on an
** active switching item, we should reload the SLC card following FMS card 
** activation because of actions taken during PromptCutOut that propagate moves
** before the above Propagate Moves code has a chance.
*/
   i = 0;
   SELECT i = 1
   FROM   FMS_Card
   WHERE  Card = :Card AND
          CutOut IS NOT NULL AND
          CutIn IS NULL;

   IF i = 1 THEN
      /*
      ** Look for the shadowcard         
      */          
      SubstationCard = 0;

      REPEATED
      SELECT  :SubstationCard = AO2.Card
      FROM    SOA_ActiveObject AO1,
              SOA_ActiveObject AO2
      WHERE   AO1.Card = :Card AND
              AO1.ObjectToCardLink = 0 AND
              AO1.Object = AO2.Object AND
              AO2.ObjectToCardLink = 1 AND
              AO2.Card <> AO1.Card;
         
      EventText = VARCHAR(SubstationCard) + ';' + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_NewJobOnCard', 
                                  DBEventText = EventText); 
      CALLPROC DDB_COMMIT;
   ENDIF;  
/*
**  If this feeder is an ATSLoad check to see if it should be cutout.
**  3G feeder would be = -1, that is okay since ATSLoad is not a 3G card.
*/
   ATSLoadFeeder = 0;
   SELECT  :ATSLoadFeeder = COUNT(*)
   FROM    Udb_Object O
   WHERE   O.Object = :CardObject.Feeder AND
           O.PrimaryGrouping IN (:Object$ATSLoad13kv
                                ,:Object$ATSLoad33kv
                                ,:Object$ATSLoadBronx);
   IF ATSLoadFeeder <> 0 THEN
      ATS.CheckATSLoad(Object = CardObject.Feeder,
                       IsFeeder = TRUE);  
   ENDIF;
/*
** Insert data into IR_FOTCount.
** For 3G, undetermined yet if Card FOT Count Feeder value = -1 will cause a problem.
*/
   IF CardObject.CardClass = Type$FOT THEN                
      CALLPROC IR_InsertingFOTCount(VCard = Card, 
                                    Vfeeder = CardObject.Feeder,
                                    VFOTCount = 1,
                                    VFOTTestType = 'O',
                                    FTestDate = '',
                                    VPreviousCard = 0);                                      
      CALLPROC DDB_COMMIT; 
   ENDIF;

   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

   /*
   **  Check for StepDown 4kv.  Check is located before issuing openauto
   **  move because issuing openauto move cuts out the 13kv feeder which
   **  in turn will attempt to cut out the 4kv feeder if necessary.  If 
   **  we wait to activate the 4kv card until after issueing the OA move
   **  the 4kv card will not get cut out because the card isn't active.  
   **  At ConEd request we are not issuing the OpenAuto move.
   **  No need to go to CardToObject for StepDown Card check.
   */
   /*************************************************
       THIS CODE ALSO APPEARS IN Configure3GFeeders
   *************************************************/
   IF NoStepDown = FALSE THEN
      /*
      **  See if card has a link set up for it.
      */
      i = 1;
      StepDownCard.Clear();
      SELECT :StepDownCard[i].Card   = C.Card,        /* StepDown Card */
             :StepDownCard[i].CardClass = C.CardClass,  
             :StepDownCard[i].Feeder = C.Feeder,      /* StepDown Feeder */
             :StepDownCard[i].FeederName = C.FeederName,  
             :StepDownCard[i].Status = C.Status
      FROM   FMS_Card C,
             FMS_StepDownLink SD
      WHERE  SD.Card = :Card AND
             SD.StepDownCard = C.Card AND
             C.Status = :Card$Open
      BEGIN
         i = i + 1;
      END;

      FOR i = 1 TO StepDownCard.LastRow DO
         /*
         **  For each Card check to make sure there are no active cards.
         */
         SDCardCheck = NULL;
         SDCardCheck = FMS_Card.Create();

         SELECT  :SDCardCheck.Card = C.Card,
                 :SDCardCheck.Cutout = C.Cutout,
                 :SDCardCheck.Cutin = C.Cutin
         FROM    SOA_ActiveObject AO,
                 FMS_Card C
         WHERE   AO.Object = :StepDownCard[i].Feeder AND
                 AO.ObjectToCardLink = 1 AND
                 AO.Card <> :StepDownCard[i].Card AND
                 AO.Card = C.Card;
         
         IF SDCardCheck.Card = 0 THEN
            /*
            **  No active cards so activate the card linked to 27kv card
            */
            d = NULL;
            RetCode = CALLFRAME ActivateFMSCard(Card = StepDownCard[i].Card,
                                         OldCardStatus = StepDownCard[i].Status,
                                         Cutout = d,
                                         NoStepDown = TRUE);
            IF RetCode = PU_CANCEL THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Problem activating card for linked 4KV feeder ' +
                    StepDownCard[i].FeederName +
                    '.  Please manually activate card for 4KV feeder.';
               RETURN PU_OK;
            ENDIF;
         ELSE
            IF SDCardCheck.Cutout IS NOT NULL AND
               SDCardCheck.CutIn IS NULL THEN
               /*
               **  Swap link to out of service card to allow easy callup of
               **  connected 4kV cards.
               **  Link is used to prompt to close 4kv card when closing 27kv card.
               */
               CALLPROC FMS_StepDownLinkUpd
                    (OldCard = Card,
                     Card = 0,                   /* Triggers update of StepDownCard */
                     OldStepDownCard = StepDownCard[i].Card,
                     StepDownCard = SDCardCheck.Card);
               CALLPROC DDB_COMMIT;
            ELSE
               /*
               **  Create a transfer card for active card.
               */
               RetCode = CALLFRAME CreateXferCard
                           (OldCardID    = SDCardCheck.Card, 
                            XferCardClass = StepDownCard[i].CardClass,
                            XferOpenCard = StepDownCard[i].Card);
                
               IF RetCode = PU_OK THEN 
                  CALLPROC DDB_COMMIT;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to transfer 4KV Card' + StepDownCard[i].FeederName;
               ENDIF; 
            ENDIF;
         ENDIF;   
      ENDFOR;
   ENDIF;
/*
**  Special case, initialize feeder status when making card
**  active for the first time.  Performed here because changing
**  feeder status requires card to be active - previous update stmt does this.
*/
   IF OldCardStatus = card$open THEN
/*
** Select the card CutOut time from the database. The cutout may have been
** set by copying outstanding moves and performing job actions from other cards. 
*/
      SELECT :CardObject.CutOut = CutOut       
      FROM  FMS_Card
      WHERE Card = :Card;

      IF (CardObject.CardClass = Type$Auto OR 
          (CardObject.CardClass = Type$OOE1 AND SXOpenAuto = TRUE) OR  
          CardObject.CardClass = Type$CIOA) THEN 
/*
** Set the CutOut time for the card and force the status to CutOut
*/
         i = 0;
         IF CutOut IS NOT NULL AND CUTOUT <> '' THEN
            CardObject.CutOut = CutOut;
         ELSEIF CardObject.CutOut IS NULL THEN
            CardObject.CutOut = 'now';
         ELSE 
            i = 1;
         ENDIF;
         /*
         ** The CutOut time has been set by CutOut move by other card. Don't insert open auto 
         ** move here.  Otherwise, automatically issue/complete OpenAuto moves, whose actions 
         ** set card cutout time.  If BreakerDidNotTrip, then only set card cutout, don't issue move
         */
         IF i = 0 AND BreakerDidNotTrip = FALSE THEN
            IF NoStepDown <> TRUE THEN
               CutOutSent = CALLPROC OpenAutoMoves (
                     CutOut = CardObject.CutOut,
                     Card = Card,
                     CardType = CardObject.CardClass);
            ELSE
               /*
               **  Remove openauto move if it exists on StepDown 4kV card.
               */
               StepDownOAJob = NULL;
               StepDownOAJob = Job.Create();
               IF CardObject.CardClass = Type$OOE1 THEN
                  SELECT :StepDownOAJob.Job = J.Job,
                         :StepDownOAJob.Card = :Card,
                         :StepDownOAJob.MoveType = J.MoveType,
                         :StepDownOAJob.TOMove = J.TOMove,
                         :StepDownOAJob.RSMove = J.RSMove,
                         :StepDownOAJob.SwitchingItem = 0
                  FROM   SOA_JobControl SJ,
                         SOA_Job J,
                         FMS_JobAction JA
                  WHERE  SJ.Card = :Card AND 
                         SJ.Job = J.Job AND
                         J.TOIssued IS NULL AND
                         J.TOComplete IS NULL AND
                         J.JobClass = JA.JobClass AND
                         JA.EquipClass = SJ.MoveEquipClass AND
                         JA.StepPair = SJ.StepPair AND
                         J.Status <> 'Del' AND
                         JA.TORS = :Job$TakeoutInt AND
                         JA.Action = :JobAction$Prompt AND
                         JA.Status =  :JobAction$CutOut;
               ELSE
                  SELECT :StepDownOAJob.Job = J.Job,
                         :StepDownOAJob.Card = :Card,
                         :StepDownOAJob.MoveType = J.MoveType,
                         :StepDownOAJob.TOMove = J.TOMove,
                         :StepDownOAJob.RSMove = J.RSMove,
                         :StepDownOAJob.SwitchingItem = 0
                  FROM   SOA_JobControl SJ,
                         SOA_Job J
                  WHERE  SJ.Card = :Card AND
                         SJ.Job = J.Job AND
                         J.JobClass = :JobClass$OpenAuto AND
                         J.Status <> 'Del'; 
               ENDIF;
               /*
               **  Delete OpenAuto move on 4kv card.
               */
               IF StepDownOAJob.Job <> 0 THEN
                  StepDownOAJob.DeleteJob();
               ENDIF;
            ENDIF;
         ELSEIF i = 0 AND BreakerDidNotTrip = TRUE THEN
            RetCode = CALLPROC FMS_CardCut (
                CutIn  = NULL,
                CutOut = CardObject.CutOut,
                Card = Card );
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 'Error trying to set Card CutOut Timestamp.',
                         TraceMessage = 'Error - ActivateFMSCard ' +                         
                         'failed to set card cut out timestamp for card ' + VARCHAR(Card));                         
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
 
         ENDIF;

         ProcessCount = ProcessCount + 1;
         ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
         CurFrame.WaitFor (EventName = 'Received');

         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    
         SimpleStep.CutOut      = CardObject.CutOut;
         SimpleStep.CutIn       = NULL;
         SimpleStep.SO.Object   = CardObject.Card;
         SimpleStep.SO.Type     = CardObject.Feeder;
         SimpleStep.SO.TypeName = CardObject.FeederName;
         SimpleStep.SO.Name     = CardObject.CardClassName;
         SimpleStep.Job         = 0;
/*
** Is STA move outstanding?
*/
         SimpleStep.ReturnCount = 0;
         STAMove = 0;
         SimpleStep.CheckOutstandingSTA();
         STAMove = SimpleStep.ReturnCount;
/*
** Are the any outstanding Isolation moves?
*/
         SimpleStep.ReturnCount = 0;
         ISOCount = 0;
         SimpleStep.CountIsolationMoves();
         ISOCount = SimpleStep.ReturnCount;
/*
** Set proper operating step if one can be set.
*/
         SimpleStep.ReturnCode = 0;
         IF STAMove <> 0 AND ISOCount > 0 THEN
            SimpleStep.OpStep = Type$ISTA;
            SimpleStep.SetOpStep();
         ELSEIF STAMove <> 0 AND ISOCount = 0 THEN
            SimpleStep.OpStep = Type$STA;
            SimpleStep.SetOpStep();
         ELSEIF STAMove = 0 AND ISOCount > 0 THEN
            SimpleStep.OpStep = Type$ISOStep;
            SimpleStep.SetOpStep();
         ENDIF;

         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                         TraceMessage = 'Error - ActivateFMSCard ' +                         
                        'failed to set OperatingStep at Card Cutout. ' +
                        'Card=' + VARCHAR(Card) +
                        ';Status=' + VARCHAR(SimpleStep.OpStep) + '.');
         ENDIF; 
         SimpleStep = NULL;
/*
** A DBEvent gets raised, and sends the data on to the COM Object.
*/    
         EventText = VARCHAR(card);
         CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_TroubleCard',
                     EventText = EventText);
/*
**  Send cutout notifications
*/        
         IF CutOutSent <> PU_OK THEN 
            CALLPROC NotificationCutout (
                               pCard = Card,
                               pCardClass = CardObject.CardClass,
                               pCardClassName = CardObject.CardClassName,
                               pCutout = CardObject.CutOut,
                               pFeeder = CardObject.Object[1].Object,
                               pFeederName = CardObject.FeederName);
         ENDIF;

         IF CardObject.CardClass = Type$OOE1 THEN

           FOR n = 1 TO CardObject.Object.LastRow() DO
               RetCode = CALLPROC ForceStatus (Feeder = CardObject.Object[n].Object,
                               NewStatus = Status$ISM);
               IF RetCode = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 'Error trying to set ISM Feeder Status.',
                         TraceMessage = 'Error - ActivateFMSCard ' +                         
                         'failed to set ISM feeder status for card ' + VARCHAR(Card));    
               ENDIF;
            ENDFOR;                     
            CALLPROC DDB_COMMIT;
         ENDIF;
      ELSE 
          FOR n = 1 TO CardObject.Object.LastRow() DO
             RetCode = CALLPROC ForceStatus (Feeder = CardObject.Object[n].Object,
                               NewStatus = Status$DL);
             IF RetCode = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage = 'Error trying to set DL Feeder Status.',
                         TraceMessage = 'Error - ActivateFMSCard ' +                         
                        'failed to set DL feeder status for card ' + VARCHAR(Card) );
             ENDIF;
          ENDFOR;                     
          CALLPROC DDB_COMMIT;
      ENDIF;

      ProcessCount = ProcessCount + 1;
      ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
      CurFrame.WaitFor (EventName = 'Received');
/*
**  Check if Network Protection Check move exists on card.  If so,
**  set feeder status for Network Protection.
*/
      NetworkProtectorJob = 0;
      SELECT :NetworkProtectorJob = J.Job
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :Card AND
             JC.Job = J.Job AND
             J.Status = '' AND
             J.JobClass = :Move$NetworkProtectionCheck;
      
      IF NetworkProtectorJob > 0 THEN
         FOR n = 1 TO CardObject.Object.LastRow() DO
/*
** On 33kV Feeder make sure segment has S-T equipment.
*/
            IF CardObject.NetworkFeeder = NetworkFeeder$33kV THEN
               HasSTEquip = FALSE;
               SELECT :HasSTEquip = G.Member
               FROM   Udb_Grouping G,
                      Udb_ExtendedType ET
               WHERE  G.Grouping = :CardObject.Object[n].Object AND
                      G.Relationship = :Interaction$MemberOf AND  
                      G.MemberType = ET.Type AND 
                      ET.SuperType = :TypeName$ST;
            
               IF HasSTEquip = FALSE THEN
                  CONTINUE;
               ENDIF; 
            ENDIF;
            
            RetCode = CALLPROC ForceStatus (Feeder = CardObject.Object[n].Object,
                              NewStatus = Status$NetWProt);
            IF RetCode = PU_CANCEL THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 'Network Protector Check status did not get set for ' +
                       'Feeder ' + CardObject.FeederName + '.' + 
                       'Warnings related to network protector check move will ' +
                       'not be presented because of this error.',
                       TraceMessage = 'Error - ActivateFMSCard ' +                         
                       'failed to set Network Protector Check status for card ' + VARCHAR(Card) );
            ENDIF;
         ENDFOR;                     
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
**  Display message to DO to send order to FOD
*/            
   IF CardObject.CardClass = Type$Auto OR 
      CardObject.CardClass = Type$OOE1 THEN
      IF SimpleJob IS NULL THEN
         SimpleJob = Job.Create();
      ENDIF;

      SimpleJob.EquipName = '';
      SELECT :SimpleJob.EquipName = O.Name,
             :SimpleJob.EquipClassName = O.TypeName
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Grouping = :CardObject.Feeder AND
              G.Relationship = :Interaction$MicroGridGenFor AND
              G.Member = O.Object;
      IF SimpleJob.EquipName <> '' THEN
         EquipList = 'Feeder ' + CardObject.FeederName + ' has a MicroGrid generator.  ' +
                     'The generator breaker does not have transfer trip capability.  ' +
                     'You must send FOD an order to cut out ' + SimpleJob.EquipClassName + ' ' +
                     SimpleJob.EquipName + ' immediately.  Call FOD and confirm order.'; 
         CALLFRAME DDB_Message(MessageText = EquipList,
                               Application = 'WARNING',
                               Color = CC_YELLOW,
                               Timeout = 300);
         
         CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = 0,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Micro Grid',
            Old  = SimpleJob.EquipClassName + ' ' + SimpleJob.EquipName,
            New  = 'Generator found on feeder. Prompted DO to issue cut out order to FOD.');
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;                                                    
/*
**  Send message to CSD 
*/            
   IF CardObject.CardClass = Type$Auto OR 
      (CardObject.CardClass = Type$OOE1 AND SXOpenAuto = TRUE) OR  
      CardObject.CardClass = Type$CIOA  THEN

      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                    ,MessageText = 'Feeder ' + CardObject.FeederName + 
                   ' O/A - Verify SSO available, prepare to Ground Feeder'
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = Card);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         message 'Could not send automated message to CSD. You may ' +
                 'want to tell him to prepare to ground feeder ' + 
                 CardObject.FeederName + '.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;                                                    
/*
** For this last step, we scroll through card feeder objects (if 3G)
*/
   FOR n = 1 TO CardObject.Object.LastRow() DO
/*
** Update Feeder In Service Timestamp and send New Feeder email if this is a 13kV New Feeder activation.
*/
      FeederInService = NULL;
      FeederRating = 0;
      REPEATED
      SELECT :FeederInService = O.InService,
             :FeederRating = R.Normal
      FROM   Udb_Object O,
             Udb_Grouping G,
             Udb_Rating R
      WHERE  O.Object = :CardObject.Object[n].Object AND
             O.Object = G.Member AND
             G.Relationship = :Interaction$RatedAs AND
             G.Grouping = R.Object;

      IF FeederInService IS NULL THEN
         CALLPROC FMS_FeederInService (
             Object = CardObject.Object[n].Object,
             InService = DATE('now') );
         CALLPROC DDB_COMMIT;
/*
** Don't send email for 4kV or ATS feeders
*/
         IF FeederRating > 4 AND ATSLoadFeeder = 0 THEN
/*
** Email to New Feeder Position distribution list.
** CardObject class has SubstationName, FeederName, and Source Breaker Name (called Position)
*/
            IF EmailClass IS NULL THEN
               EmailClass = EmailNotificationClass.Create();
            ENDIF;

            EmailClass.EmailType = 5;           // New feeder position email to a distribution list
            EmailClass.Sender = DOp.Description;
            EmailClass.Recipient = 'NewFdrPosDL';
            EmailClass.Subject = 'New Feeder ' + CardObject.Object[n].Name + ' InService Notification';
            EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                                          'FeederName=' + CardObject.Object[n].Name + ';;' + 
                                          'SubstationName=' + CardObject.SubstationName + ';;' + 
                                          'DeviceName=' + CardObject.Position + ';;';
            EmailClass.Message2 = '';
            EmailClass.Template = 'NewFeederToXALink.html';
            EmailClass.InsertRequest();

            IF EmailClass.ReturnCode <> 0 THEN 
               Message 'Unable to notify New Feeder Position distribution list of this source breaker by email.';
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;
   
   ProcessWindow.Terminate();
   RETURN PU_OK;
END; 

