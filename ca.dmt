**  Class:          TLSJob_ASE
**
**  Date:       Version Description
** ----------------------------------
**  08/14/06  ysp  Created; 
**  04/10/07  ysp  ITC203: Remove Move$Filtered as a job status.
**  05/16/07  ysp  Don't set the move color to gray if a returned move has not
**                 been confirmed by DO.
**  12/11/08  em   Added Job to order by to try to ensure that step headings 
**                 are loaded in the proper order (ahead of moves) on the card.
**  06/22/09  ysp  Added setting move colors for Work Group Request moves
**  07/10/13  ysp  Filter archive complete/incomplete iswp from active cards.
*/
METHOD LoadJobs (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.J.Clear();

    IF CurObject.ArchiveCard = FALSE THEN
       i = 1;
       REPEATED
       SELECT  :CurObject.J[i].job = job,
               :CurObject.J[i].card = card,
               :CurObject.J[i].status = status,
               :CurObject.J[i].seq = seq,
               :CurObject.J[i].jobclass = jobclass,
               :CurObject.J[i].jobclassseq = jobclassseq,
               :CurObject.J[i].circuit = circuit,
               :CurObject.J[i].linenumber = linenumber,
               :CurObject.J[i].circuitclass = circuitclass,
               :CurObject.J[i].circuitclassname = circuitclassname,
               :CurObject.J[i].steppair = steppair,
               :CurObject.J[i].movetype = Movetype,
               :CurObject.J[i].TOMoveRules = TOMoveRules,
               :CurObject.J[i].TOOperator = TOOperator,
               :CurObject.J[i].TOOperatorName = TOOperatorName,
               :CurObject.J[i].TOIssued = TOIssued,
               :CurObject.J[i].tocomplete = tocomplete,
               :CurObject.J[i].tomove = TOMove,
               :CurObject.J[i].tostep = TOStep,
               :CurObject.J[i].results = results,
               :CurObject.J[i].ResultsCode = ResultsCode,
               :CurObject.J[i].ResultsCodeName = ResultsCodeName,
               :CurObject.J[i].substation = substation,
               :CurObject.J[i].substationname = substationname,
               :CurObject.J[i].organization = organization,
               :CurObject.J[i].organizationname = organizationname,
               :CurObject.J[i].RSMoveRules = RSMoveRules,
               :CurObject.J[i].RSOperator = RSOperator,
               :CurObject.J[i].RSOperatorName = RSOperatorName,
               :CurObject.J[i].rsissued = rsissued,
               :CurObject.J[i].rscomplete = rscomplete,
               :CurObject.J[i].rsmove = RSMove,
               :CurObject.J[i].rsstep = RSStep,
               :CurObject.J[i].initialswitchpos = initialswitchpos,
               :CurObject.J[i].finalswitchpos = finalswitchpos,
               :CurObject.J[i].inservice = inservice,
               :CurObject.J[i].outservice = outservice
       FROM    TC_Job
       WHERE   Card = :CurObject.Card
       AND     Status <> 'Del'
       AND     Status <> 'Hid'
       ORDER BY steppair, seq, job
       BEGIN
       /*
       **  Put a T in the status column if this is a transfer move
       */
           IF (CurObject.J[i].status = 'Xfr') THEN
               CurObject.J[i].Status = 'T';
           ELSE
               CurObject.J[i].Status = '';
           ENDIF;
       /*
       ** set job's category 
       */ 
           CurObject.J[i].GetMoveCategory();

           i = i + 1;
       END;
    ELSE 
       i = 1;
       REPEATED
       SELECT  :CurObject.J[i].job = job,
               :CurObject.J[i].card = card,
               :CurObject.J[i].status = status,
               :CurObject.J[i].seq = seq,
               :CurObject.J[i].jobclass = jobclass,
               :CurObject.J[i].jobclassseq = jobclassseq,
               :CurObject.J[i].circuit = circuit,
               :CurObject.J[i].linenumber = linenumber,
               :CurObject.J[i].circuitclass = circuitclass,
               :CurObject.J[i].circuitclassname = circuitclassname,
               :CurObject.J[i].steppair = steppair,
               :CurObject.J[i].movetype = Movetype,
               :CurObject.J[i].TOMoveRules = TOMoveRules,
               :CurObject.J[i].TOOperator = TOOperator,
               :CurObject.J[i].TOOperatorName = TOOperatorName,
               :CurObject.J[i].TOIssued = TOIssued,
               :CurObject.J[i].tocomplete = tocomplete,
               :CurObject.J[i].tomove = TOMove,
               :CurObject.J[i].tostep = TOStep,
               :CurObject.J[i].results = results,
               :CurObject.J[i].ResultsCode = ResultsCode,
               :CurObject.J[i].ResultsCodeName = ResultsCodeName,
               :CurObject.J[i].substation = substation,
               :CurObject.J[i].substationname = substationname,
               :CurObject.J[i].organization = organization,
               :CurObject.J[i].organizationname = organizationname,
               :CurObject.J[i].RSMoveRules = RSMoveRules,
               :CurObject.J[i].RSOperator = RSOperator,
               :CurObject.J[i].RSOperatorName = RSOperatorName,
               :CurObject.J[i].rsissued = rsissued,
               :CurObject.J[i].rscomplete = rscomplete,
               :CurObject.J[i].rsmove = RSMove,
               :CurObject.J[i].rsstep = RSStep,
               :CurObject.J[i].initialswitchpos = initialswitchpos,
               :CurObject.J[i].finalswitchpos = finalswitchpos,
               :CurObject.J[i].inservice = inservice,
               :CurObject.J[i].outservice = outservice
       FROM    TC_ArchiveJob
       WHERE   Card = :CurObject.Card
       AND     Status <> 'Del'
       ORDER BY steppair, seq, job
       BEGIN
      /*
       **  Put a T in the status column if this is a transfer move
       */
           IF (CurObject.J[i].status = 'Xfr') THEN
               CurObject.J[i].Status = 'T';
           ELSE
               CurObject.J[i].Status = '';
           ENDIF;
         	i = i + 1;
       END;
    ENDIF;
    CALLPROC DDB_ROLLBACK;
/*
**  Make sure something was found.  
*/   
   IF CurObject.J.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No CurObject.J found for card.';
   ENDIF;
   RETURN;
END;

METHOD SetMoveColors(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;

   CardStatus = INTEGER NOT NULL WITH DEFAULT;
   PendingConfirmation = INTEGER NOT NULL WITH DEFAULT;
   s1 = VARCHAR(100) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set TC job colors.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
** Get card status
*/
   IF CurObject.ArchiveCard = FALSE THEN
      SELECT :CardStatus = Status
      FROM   TC_Card
      WHERE  Card = :CurObject.Card;
   ELSE
      SELECT :CardStatus = Status
      FROM   TC_ArchiveCard
      WHERE  Card = :CurObject.Card;
   ENDIF;

   i = 1;
   WHILE (i <= CurObject.J.LastRow()) DO
      CurObject.J[i].MoveFGColor = CC_BLACK;

      PendingConfirmation = FALSE;
      /*
      ** If the Verizon trouble report is pending confirmation.
      */
      IF CurObject.J[i].TOOperator = Operator$VerizonTA THEN
         m = 0;
         SELECT :m = 1
         FROM   TC_TroubleReportOrder
         WHERE  WorkPermit = :CurObject.J[i].Job AND
                OrderStatus IN (:Order$Opened, :Order$Downloaded, :Order$Closed);
         IF m = 1 THEN
            IF CurObject.J[i].RSComplete IS NULL THEN
               CurObject.J[i].TOIssuedFG = CC_LIGHT_GRAY;
            ELSEIF CurObject.J[i].RSComplete IS NOT NULL THEN
               CurObject.J[i].RSCompleteFG = CC_LIGHT_GRAY;
               PendingConfirmation = TRUE;
            ENDIF;
         ENDIF;
      ELSEIF CurObject.J[i].TOOperator = Operator$Email THEN
         /*
         ** If a work group request.
         */
         m = 0;
         SELECT :m = 1
         FROM   TC_WorkGroupRequest
         WHERE  Job = :CurObject.J[i].Job AND
                Status IN (:Order$Opened, :Order$Closed);
         IF m = 1 THEN
            IF CurObject.J[i].TOComplete IS NULL THEN
               CurObject.J[i].TOIssuedFG = CC_LIGHT_GRAY;
            ELSEIF CurObject.J[i].TOComplete IS NOT NULL THEN
               CurObject.J[i].TOCompleteFG = CC_LIGHT_GRAY;
               PendingConfirmation = TRUE;
            ENDIF;
         ENDIF;         
      ELSE
         /*
         ** if this job is downloaded to SSO and pending SSO acknowledgement
         ** we have to use two separate queries here because the takeout and
         ** restore of the same move can be in the same order.
         */     
         m = 0;
         s1 = '';
         REPEATED
         SELECT :m = O.OrderStatus,
                :s1 = O.OrderType
         FROM   IR_TelephoneOrder O,
                IR_TLSOrderJob J
         WHERE  J.Job = :CurObject.J[i].Job AND
                J.OrderNumber = O.OrderNumber AND
                J.TORS = :Job$TakeoutInt AND
                O.OrderStatus IN (:Order$Opened, :Order$Downloaded, :Order$Closed);
                 
         IF m = Order$Closed THEN
            IF s1 = 'REGULAR' THEN
               CurObject.J[i].TOCompleteFG = CC_LIGHT_GRAY;
            ELSE
               CurObject.J[i].RSCompleteFG = CC_LIGHT_GRAY;
            ENDIF;
            PendingConfirmation = TRUE;
         ELSEIF m = Order$Opened OR m = Order$Downloaded THEN
            CurObject.J[i].TOIssuedFG = CC_LIGHT_GRAY;
         ENDIF;                    

         m = 0;
         s1 = '';
         REPEATED
         SELECT :m = O.OrderStatus,
                :s1 = O.OrderType
         FROM   IR_TelephoneOrder O,
                IR_TLSOrderJob J
         WHERE  J.Job = :CurObject.J[i].Job AND
                J.OrderNumber = O.OrderNumber AND
                J.TORS = :Job$RestoreInt AND
                O.OrderStatus IN (:Order$Opened, :Order$Downloaded, :Order$Closed);

         IF m = Order$Closed THEN
            CurObject.J[i].RSCompleteFG = CC_LIGHT_GRAY;
            PendingConfirmation = TRUE;
         ELSEIF m = Order$Opened OR m = Order$Downloaded THEN
            CurObject.J[i].RSIssuedFG = CC_LIGHT_GRAY;
         ENDIF;
      ENDIF;
/*
** If the move has been completed, dim the text colors so that the card
** is easier to read and so that outstanding moves are more readily 
** identifiable.
*/
      IF (PendingConfirmation = FALSE AND
          CurObject.J[i].TOComplete IS NOT NULL AND
          CurObject.J[i].RSComplete IS NOT NULL) THEN
         CurObject.J[i].ToIssuedFG = CC_LIGHT_GRAY;
         CurObject.J[i].RSIssuedFG = CC_LIGHT_GRAY;
         CurObject.J[i].ToCompleteFG = CC_LIGHT_GRAY;
         CurObject.J[i].RSCompleteFG = CC_LIGHT_GRAY;
         CurObject.J[i].MoveFgColor = CC_LIGHT_GRAY;
      ENDIF;       

      /* Make step headings blue */
      IF (CurObject.J[i].JobClass = 0) AND (CurObject.J[i].CircuitClass = -99) THEN
         CurObject.J[i].MoveFGColor = CC_BLUE;
      ENDIF;

      /* Gray out move performance if not available */
      IF (CurObject.J[i].TOIssued = '') THEN
         CurObject.J[i].TOIssuedBG = CC_PALE_GRAY;
      ENDIF;
                                                           
      IF (CurObject.J[i].TOComplete = '') THEN
         CurObject.J[i].TOCompleteBG = CC_PALE_GRAY;
      ENDIF;

      IF (CurObject.J[i].RSIssued = '') THEN
         CurObject.J[i].RSIssuedBG = CC_PALE_GRAY;
      ENDIF;

      IF (CurObject.J[i].RSComplete = '') THEN
         CurObject.J[i].RSCompleteBG = CC_PALE_GRAY;
      ENDIF;
      /*
      **  Handle Transferred moves for closed cards
      */
      IF (CurObject.J[i].Status = 'T') AND (CardStatus = Card$Closed) THEN

          /* Gray out move performance if not available 
          */
          IF (CurObject.J[i].TOIssued IS NULL) THEN
              CurObject.J[i].TOIssuedBG = CC_PALE_GRAY;
          ENDIF;

          IF (CurObject.J[i].TOComplete IS NULL) THEN
              CurObject.J[i].TOCompleteBG = CC_PALE_GRAY;
          ENDIF;

          IF (CurObject.J[i].RSIssued IS NULL) THEN
              CurObject.J[i].RSIssuedBG = CC_PALE_GRAY;
          ENDIF;

          IF (CurObject.J[i].RSComplete IS NULL) THEN
             CurObject.J[i].RSCompleteBG = CC_PALE_GRAY;
          ENDIF;
      ENDIF;

      /*
      ** Highlight move if Co-Op test is PENDING ticketnumber
      */
      m = 0;
      IF CurObject.J[i].MoveType = MoveType$COOP THEN
         SELECT :m = 1
         FROM   TC_WorkPermit
         WHERE  PermitJobID = :CurObject.J[i].Job AND
                VendorTicketNumber = :Pending$TicketNumber;
         IF m = 1 THEN
            CurObject.J[i].MoveBGColor = CC_PALE_RED;
         ENDIF;
      ENDIF; 

      i = i + 1;
   ENDWHILE;
END;


