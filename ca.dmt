END;

PROCEDURE Validate_BusSectionRelays(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ContinueCheck = INTEGER NOT NULL WITH DEFAULT;
   FCRPermit = INTEGER NOT NULL WITH DEFAULT;
   p = INTEGER NOT NULL WITH DEFAULT;
   WG = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF bs.BDHasDataChanged = TRUE THEN
      IF bs.BDRelayName <> '' AND
        (bs.BDPhaseA = 0 AND
         bs.BDPhaseB = 0 AND
         bs.BDPhaseC = 0) THEN
         MESSAGE 'Bus Differential Relay Name ''' + bs.BDRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.BOCHasDataChanged = TRUE THEN
      IF bs.BOCRelayName <> '' AND
        (bs.BOCPhaseA = 0 AND
         bs.BOCPhaseB = 0 AND
         bs.BOCPhaseC = 0 AND
         bs.BOCPhaseN = 0) THEN
         MESSAGE 'Bus Over Current Relay Name ''' + bs.BOCRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FBMPRHasDataChanged = TRUE THEN
      /*
      IF bs.BUTRelayName <> '' AND
         bs.BUTOperated = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.BUTRelayName + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
      */
      IF bs.FBMPRValue <> '' AND
         bs.FBMPR = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.FBMPRValue + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FTHasDataChanged = TRUE THEN
      IF bs.FTRelayName <> '' AND
        (bs.FTPhaseA = 0 AND
         bs.FTPhaseB = 0 AND
         bs.FTPhaseC = 0 AND
         bs.FTPhaseN = 0 AND
         bs.FTFeeder = 0) THEN
         MESSAGE 'Feeder Target Relay Name ''' + bs.FTRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
       
      IF (bs.FTPhaseA = 0 AND
          bs.FTPhaseB = 0 AND
          bs.FTPhaseC = 0 AND
          bs.FTPhaseN = 0) AND
          bs.FTFeeder <> 0 THEN

         MESSAGE 'A Feeder was chosen but no Feeder Relay Targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

      IF (bs.FTPhaseA <> 0 OR
          bs.FTPhaseB <> 0 OR
          bs.FTPhaseC <> 0 OR
          bs.FTPhaseN <> 0) AND
          bs.FTFeeder = 0 THEN

         MESSAGE 'Feeder Relay Targets were selected but no Feeder was chosen.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

   ENDIF;
   RETURN(0);
END;

PROCEDURE LoadStationEquipList(
) = 
BEGIN   
   Equip_SF.StationEquipList.Clear();
  
   /*
   **  select equipment that are Breakers, Feeders (ACLineSegments), 
   **  Distribution Feeders if applicable, Power Transformers, Phase Shifters and Capacitors
   **
   **  Because the equipment is associated with substations and
   **  not the card, we must check to see if the card has more than
   **  one substation.  If the card does have more than one substation
   **  the equipment must be selected from all substations associated with
   **  this card.
   */
   Equip_SF.StationEquipList[1] = CAC_Relay.Create();
   i = 2;
   IF ( C.MultipleKVFlag = TRUE ) THEN
      REPEATED
      SELECT  :Equip_SF.StationEquipList[i].Equip = O.Object, 
              :Equip_SF.StationEquipList[i].EquipName = O.Name,
              :Equip_SF.StationEquipList[i].EquipClass  = O.Type,
              :Equip_SF.StationEquipList[i].EquipClassName  = O.TypeName,
              :Equip_SF.StationEquipList[i].Description = O.Description  
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_Grouping GG,
              Udb_ExtendedType E
      WHERE   GG.Grouping = :C.Substation AND
              GG.Relationship = :Interaction$MemberOf AND
              G.Grouping = GG.Member AND 
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              G.MemberType = E.Type AND
              E.SuperType IN (:Type$Breaker,
                              :Type$ACLineSegment,
                              :Type$Feeder,
                              :Type$Transformer,
                              :Type$Capacitor,
                              :TypeName$BusSect)  
      ORDER BY EquipClassName, EquipName 
     
      BEGIN
         i = i + 1;
      END;
   ELSE
      /*
      **  The card only has one substation associated with it 
      */
      REPEATED
      SELECT  :Equip_SF.StationEquipList[i].Equip = O.Object, 
              :Equip_SF.StationEquipList[i].EquipName = O.Name,
              :Equip_SF.StationEquipList[i].EquipClass  = O.Type,
              :Equip_SF.StationEquipList[i].EquipClassName  = O.TypeName,
              :Equip_SF.StationEquipList[i].Description = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_ExtendedType E
      WHERE   G.Grouping = :C.SubStation AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              G.MemberType = E.Type AND
              E.SuperType IN (:Type$Breaker,     /* = :Type$Conducting */
                              :Type$ACLineSegment,
                              :Type$Feeder,
                              :Type$Transformer,
                              :Type$Capacitor,
                              :TypeName$BusSect)
      ORDER BY EquipClassName, EquipName 
      BEGIN
         i = i + 1;
      END;
   ENDIF;  
   CALLPROC DDB_ROLLBACK;
END;

PROCEDURE GeneratePDFFile(
   ShowFlag = INTEGER NOT NULL
) = 
DECLARE
   PDFDir = Varchar(100) NOT NULL WITH DEFAULT;  
   PDFCommand = Varchar(300);
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   PDFDir = CurSession.GetEnv(Name = 'FMS_Misc');
/*
** 09/09/22: replaced by powershell script that displays reports from FMS_ReportService web site.
**  
   PDFCommand = 'wscript ' + PDFDir + '\relay_report.vbs "SLC" ' + 
                                       varchar(ArchiveCard) + ' ' +
                                       varchar(C.Card) + ' ' +
                                       varchar(SwitchingItem) + ' ' + 
                                       '1 ' +                  /* Always call in update from SLC *
                                       '"' + PDFTitle + '" '; 
*/
   PDFCommand = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + 
                                       PDFDir + '\PrintReport.ps1" RELAY SLC ' +
                                       varchar(ArchiveCard) + ' ' +
                                       varchar(C.Card) + ' ' +
                                       varchar(SwitchingItem) + ' ' +      /* Switching Item */
                                       '1 ' +                  /* Always call in update from SLC */
                                       '"' + PDFTitle + '" '; 

   IF Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_1%' escape '\' OR
      Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_2%' escape '\' THEN
      PDFCommand = PDFCommand + DDB_Global.Session.Cur.Database;
   ELSE
      PDFCommand = PDFCommand + '""';
   ENDIF;
   
   PDFCommand = PDFCommand + ' ' + VARCHAR(ShowFlag);
   PDFCommand = PDFCommand + ' 0' ;    // not by desk
      
   CurFrame.Trace (PDFCommand);
   CALL System PDFCommand; 

   IF ShowFlag = 0 THEN
      // check if the pdf file is generated
      PDFLocation = PDFDir + '\report\relay_' + VARCHAR(C.Card) + '.pdf';
      RetCode = CurSession.FileExists(FileName = PDFLocation);
      RETURN RetCode;
   ELSE
      RETURN FALSE;        // pdf was deleted
   ENDIF;   
END;
