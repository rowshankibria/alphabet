**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    FMS_BusinessLogic
**  Class:          ListedCard
**
**  Date:       Version Description
** ----------------------------------
**  06/15/03    pkw     Created; 
**  09/23/03    ysp     Add support of querying cards by card name and
**                      status.  Add CardStatus and CardClassName to the
**                      active card result list.
**  10/02/07    em      Add Steam NSA type of card.
**  03/25/08    ysp     add support of Match Type for LoadActiveList method
**  02/12/13    em      add Tunnel Sole Auth to steam active list
**  07/29/13    ysp     add onlinesearch attribute to support search on fms online
**  09/11/14    em      Include ScopeOfWork for DSO cards
*/ 
METHOD LoadActiveList (
)=
DECLARE
   DynamicWhereClause 	= VARCHAR(2000) NOT NULL WITH DEFAULT;
   i 			= INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   LastRow              = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
ENDDECLARE
BEGIN
/*
**  LoadActiveList Method builds a dynamic where based on the Active List Filter 
**  Criteria as selected on the SOA_Main screen.  The Active List is loaded 
**  from the database using the DynamicWhereClause.
*/  
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   DynamicWhereClause = '';

   IF CurObject.StatusAll = FALSE THEN
      IF CurObject.StatusFilter = 0 THEN
         /* TOMS Online will always pass in StatusFilter.  This line
         ** is added for being backward compatible with TOMS.
         */
         DynamicWhereClause = 'CardStatus = ' + VARCHAR(:Card$Active) + HC_NEWLINE;
      ELSE
         DynamicWhereClause = 'CardStatus = ' + VARCHAR(CurObject.StatusFilter) + HC_NEWLINE;
      ENDIF;
   ELSE
      DynamicWhereClause = 'CardStatus IN(' + VARCHAR(Card$Active) + ',' +
                                              VARCHAR(Card$Idle) + ',' +
                                              VARCHAR(Card$OutToWork) + ')' + HC_NEWLINE;
   ENDIF;

/*
** Add TypeOfCard to where clause, skip it if TypeOfCardFilter = ALL. 
** Check for FMS typeofcard.  If so, default to Portion, 4kV, and 13.2kV,
** ignoring ISO.
*/

   IF CurObject.TypeOfCardFilter <> TypeOfCard$ALL THEN

      IF CurObject.TypeOfCardFilter = TypeOfCard$FMS THEN 
         IF CurObject.OnlineSearch = 0 THEN
            DynamicWhereClause = DynamicWhereClause + 
               ' AND TypeOfCard IN (' + VARCHAR(TypeOfCard$13kV) + ',' +
               VARCHAR(TypeOfCard$4kV) + ',' + VARCHAR(TypeOfCard$Portion) + 
               ')' + HC_NEWLINE;
         ENDIF;
      ELSEIF CurObject.TypeOfCardFilter = TypeOfCard$Steam THEN
         DynamicWhereClause = DynamicWhereClause + 
            ' AND TypeOfCard IN (' + VARCHAR(TypeOfCard$Steam) + ',' +
            VARCHAR(TypeOfCard$SteamNSA) + ',' +
            VARCHAR(TypeOfCard$TunnelSA) + 
            ')' + HC_NEWLINE;
      ELSE
         DynamicWhereClause = DynamicWhereClause +
            ' AND TypeOfCard = ' + VARCHAR(CurObject.TypeOfCardFilter) +
            HC_NEWLINE;
      ENDIF;
   ENDIF;

/* 
** Add Division to where clause, skip it if Jurisdication = ALL 
*/

   IF CurObject.JurisdictionAll = FALSE THEN
      DynamicWhereClause = DynamicWhereClause + 
         ' AND Division IN (';
      LastRow = CurObject.JurisdictionFilter.LastRow();

      IF LastRow = 0 THEN   /*  Role = Manager */
            DynamicWhereClause = DynamicWhereClause + '-1)';
      ENDIF;

      FOR i = 1 TO LastRow DO
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(CurObject.JurisdictionFilter[i].Value);
         IF i = LastRow THEN
            DynamicWhereClause = DynamicWhereClause + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + ',';
         ENDIF;
      ENDFOR;
   ENDIF;

/*
** add Card Name filter to where clause, this is for TOMS Online to search
** for cards by names.
*/
   IF CurObject.NameFilter <> '' THEN
      IF CurObject.MatchType = 0 THEN     // contains the searc string
          DynamicWhereClause = DynamicWhereClause +
              ' AND UPPERCASE(CardName) like ''%' + UPPERCASE(CurObject.NameFilter) + '%''';
      ELSEIF CurObject.MatchType = 1 THEN // exact match
          DynamicWhereClause = DynamicWhereClause +
              ' AND UPPERCASE(CardName) = ''' + UPPERCASE(CurObject.NameFilter) + '''';
      ENDIF;
   ENDIF;
/*
** Perform SELECT, Build Active List.
*/

   i = 1;
   CurObject.al.Clear();
   SELECT DISTINCT
             :CurObject.al[i].CardName = CardName
    ,        :CurObject.al[i].Card = Card
    ,        :CurObject.al[i].CardStatus = CardStatus
    ,        :CurObject.al[i].CardClassName = CardClassName
    ,        :CurObject.al[i].Application = Application
    ,        :CurObject.al[i].CardNumber = CardNumber
    ,        :CurObject.al[i].FeederStatusName = FeederStatusName
   FROM      SOA_ActiveCard 
   WHERE     :DynamicWhereClause
   ORDER BY   1 
   BEGIN
      IF CurObject.al[i].Application = Application$DSO THEN
         SELECT :CurObject.al[i].ScopeOfWork = ScopeOfWork
         FROM   DSO_Card
         WHERE  Card = :CurObject.al[i].Card;
      ENDIF;
      i = i + 1;
   END;
   RETURN;
END;

METHOD SortOA (
)=
DECLARE
   i 			= INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   LastRow              = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
ENDDECLARE
BEGIN
/* 
**  Send Active List to SOA_Main after sorting O/A status
**  to the top.  
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   LastRow = CurObject.al.LastRow();
   FOR i = LastRow DOWNTO 1 DO
      IF CurObject.al[i].CardNumber = Status$OA THEN  
         CurObject.al.InsertRow (RowNumber = 1, RowObject = CurObject.al[i].Duplicate());
         CurObject.al.RemoveRow (RowNumber = i+1); /* Use i+1 because of insert */
      ENDIF;
   ENDFOR;

   RETURN;
END;

METHOD CommonCard (
)=
DECLARE
   i 			= INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   LastRow              = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
ENDDECLARE
BEGIN
/* 
**  Send Active List to SOA_Main after sorting O/A status
**  to the top.  
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   CurObject.AL.Clear();

   SELECT  
   DISTINCT   :CurObject.AL[i].Application = AC.Application
             ,:CurObject.AL[i].Card = AC.Card
             ,:CurObject.AL[i].CardClassName = AC.CardClassName
             ,:CurObject.AL[i].CardName = AC.CardName
             ,:CurObject.AL[i].CardNumber = AC.CardNumber
             ,:CurObject.AL[i].CardStatus = AC.CardStatus
             ,:CurObject.AL[i].Division = 0
             ,:CurObject.AL[i].FeederStatusName = AC.FeederStatusName
             ,:CurObject.AL[i].TypeOfCard = AC.TypeOfCard
   FROM      SOA_ActiveCard AC,
             SOA_JobControl JC,
             SOA_Job J
   WHERE     JC.Job = :CurObject.Job AND
             JC.Card = AC.Card AND
             JC.Job = J.Job AND
            (JC.SwitchingItem = 0 OR
             J.SwItemStatus = :Card$Active) 
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK; 

   RETURN;
END;

