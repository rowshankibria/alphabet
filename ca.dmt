============================

	Name:            ConnectedObject


Application Component Report
============================

	Name:            ConnectedSourceCutOutTrace

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ConnectedSourceCutOutTrace          
**
**  Modifications:
**  02/22/06   em   Created
**  03/16/06   em   Feeder Load is no longer a Target device to determine if feeder is
**                  Cut In.  The original intent was if reaching another Fdr-Load on another
**                  Feeder, not on the same feeder.  It is not possible to reach a Fdr-Load
**                  on another feeder since the scope of trace ends when leaving current feeder.
**  06/04/08   em   Extend trace to non-CAP BREAKER in substation.
**  06/23/08   em   When loading Feedercard list from SOA_ActiveObject,
**                  include all cards in station since equip might be outside
**                  feeder scope.
**  07/23/08   em   LogIns SwitchingItem should be =0.
**  05/14/09   em   Looking for TargetType with Type instead of Object (after
**                  extending trace to substation BREAKERs).  Moving
**                  selection of substation objects outside of feeder loop
**                  for better efficiency.
**  05/15/09   em   Clear FdrLoad array before selecting to prevent second Fdr-Load impacting
**                  wrong feeder. 
**  03/16/11   em   Feeder array load must use object instead of c.feeder for 3G
**  03/30/11   em   Removed ObjectToCardLink=1 requirement to allow feedercards to be
**                  included via substation breaker status updates.  Get feeder from
**                  card to object.
**  11/27/12   em   An alternate source feeder like 6W67 will have Fdr Loads in different
**                  substations.  It is necessary to reload the substation target arrays
**                  to support each end of the feeder.  Developed internal Reload Targets
**                  procedure to handle possibility of multiple substations.
**  01/20/17   ysp  Use QGis-based trace class Trace_ConnectedSourceCutOut 
*/
PROCEDURE ConnectedSourceCutOutTrace
(
   JIP          = JobInProgress;     /*PassThru Parameter*/
   CloseOrOpen  = INTEGER NOT NULL WITH DEFAULT; /*0=Open, 1=Close*/
) =
DECLARE
   ExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Open Objects */
   Feeders      = ARRAY OF FMS_Card;
   FdrLoad	= ARRAY OF INTEGEROBJECT;
   FeederEquip	= ARRAY OF INTEGEROBJECT;    /*List of Equip on Feeder*/
   FeederIsCutIn = INTEGER NOT NULL WITH DEFAULT;
   f		= INTEGER NOT NULL WITH DEFAULT;
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   Substation	= INTEGER NOT NULL WITH DEFAULT;
   LastRow      = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   TraceEnabled = INTEGER NOT NULL WITH DEFAULT;

   AlternateSub = INTEGER NOT NULL WITH DEFAULT; /*Alternate Source Substation*/
   FdrLoadSub	= ARRAY OF INTEGEROBJECT;
   ReloadTargets = PROCEDURE;
   SubFeederEquip	= ARRAY OF INTEGEROBJECT;    /*List of Equip on Feeder*/
   SubTargetTypes    = ARRAY OF INTEGEROBJECT; /*Types we don't want to see*/
   SubExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Open Objects */
   TargetTypes = ARRAY OF INTEGEROBJECT; /*List of non-Cap BREAKER  */
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   Trace = Trace_ConnectedSourceCutOut DEFAULT NULL;
ENDDECLARE
BEGIN
/* 
** Determine whether a trace is necessary.
**  1) Is device in a substation and on a feeder with an active card?
**     It may be related to more than one feeder.
**  2) Is the active card already CutIn or CutOut?  Don't need to duplicate the
**     status.
**  3) Is the feeder set up in DBM for a Connected Source trace?
*/
   Substation = 0;  
   SELECT  :Substation = Grouping                      /* we will use this station later*/
   FROM    Udb_Grouping
   WHERE   Member = :JIP.Equip AND
           Relationship = :Interaction$MemberOf AND
           GroupingType IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$Substation);

   IF Substation = 0 THEN
      RETURN;   /* Bail immediately if device not in a substation */
   ENDIF;
/*
** Now get a list of active cards.
** This Select statement is purposely broad because the move being completed may impact 
** multiple feeders.  We find this statement invoked also from StepDown feeder equipment.
*/
   Feeders.Clear();
   i = 1;
   REPEATED
   SELECT
   DISTINCT :Feeders[i].Card = AO.Card,
            :Feeders[i].Feeder = CTO.Object,
            :Feeders[i].FeederName = C.FeederName,
            :Feeders[i].CutIn = C.CutIn,
            :Feeders[i].CutOut = C.CutOut
   FROM    Udb_Grouping G,
           SOA_ActiveObject AO,
           FMS_Card C,
           TFMS_CardToObject CTO   /*Added to ensure feeder selection*/
   WHERE   G.Member = :JIP.Equip AND
           G.Relationship = :Interaction$MemberOf AND
           G.Grouping = AO.Object AND
           AO.Card = C.Card AND
           C.Card = CTO.Card
   BEGIN
      i = i + 1;
   END;
/*
** Look at each card; Feeders array ultimately contains the feeders to evaluate
*/
   LastRow = Feeders.LastRow();
   FOR i = LastRow DOWNTO 1 DO
      IF CloseOrOpen = 1 THEN  /*Device is closing; is feeder already CutIn?*/
         IF Feeders[i].CutIn IS NOT NULL  OR
              (Feeders[i].CutOut IS NULL AND Feeders[i].CutIn IS NULL) THEN 
            Feeders.RemoveRow (rownumber = i);
            CONTINUE;
         ENDIF;
      ELSE  /*Device is opening; is feeder already CutOut? */
         IF Feeders[i].CutIn IS NULL AND Feeders[i].CutOut IS NOT NULL THEN 
            Feeders.RemoveRow (rownumber = i);
            CONTINUE;
         ENDIF;
      ENDIF;

      TraceEnabled = 0;
      SELECT :TraceEnabled = Feeder
      FROM   FMS_ConnectedSource
      WHERE  Feeder = :Feeders[i].Feeder;

      IF TraceEnabled = 0 THEN  /* Trace is not enabled */
         Feeders.RemoveRow (rownumber = i);
      ENDIF;
   ENDFOR;
/*
** At this point we are left with a list of Feeders that are to be traced
** for CutOut/CutIn.  IF the list is empty, we ultimately just return.
*/
   LastRow = Feeders.LastRow();
   
/* 01/20/17: Not need to call ReloadTargets.  we will pass the FdrLoadSub to the trace class.    
   IF LastRow > 0 THEN
      FdrLoadSub.Clear();
      FdrLoadSub.InsertRow (RowNumber = 1);
      FdrLoadSub[1].Value = Substation;
      /*
      ** Load Substation Targets for a single Substation
      *
      CALLPROC ReloadTargets (Substations = FdrLoadSub);
      /*
      ** Save Targets for re-use 
      *
      SubTargetTypes = TargetTypes.Duplicate();
      SubExistingBreaks = ExistingBreaks.Duplicate();
      SubFeederEquip = FeederEquip.Duplicate();
   ENDIF;
*/

   FOR f = 1 TO LastRow DO   
/*
** Find each FdrLoad device on the Feeder
** Might have L&M leg in same substation, might have legs in one substation and
** alternate source in another.  Might be called courtesy of a StepDown SD-VIS move
** that finds 27kV feedercard via the broad ActiveObject select statement.
*/
      AlternateSub = FALSE;
      i = 1;
      FdrLoad.Clear();
      FdrLoadSub.Clear();
      FdrLoadSub.InsertRow (RowNumber = 1);
      FdrLoadSub[1].Value = Substation;

      SELECT  :FdrLoad[i].Value = Member
      FROM    Udb_Grouping
      WHERE   Grouping = :Feeders[f].Feeder AND
              Relationship = :Interaction$MemberOf AND
              MemberType = :Type$FdrLoad 
      BEGIN 
         SELECT :AlternateSub = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :FdrLoad[i].Value AND
                Relationship = :Interaction$MemberOf AND
                GroupingType = :Type$Substation;

         IF AlternateSub <> Substation THEN
            FdrLoadSub.InsertRow (RowNumber = 1);
            FdrLoadSub[1].Value = AlternateSub;
            AlternateSub = TRUE;
         ENDIF;

         i = i + 1;
      END;
      
/* 01/20/17: Not need to call ReloadTargets, we will pass the FdrLoadSub to the trace class.
** Set Target arrays, we only have to reload targets when have an alternate source station.
** Very small number of times.
**
      IF AlternateSub = TRUE THEN
         CALLPROC ReloadTargets (Substations = FdrLoadSub);
      ELSE      
         TargetTypes = SubTargetTypes.Duplicate();
         ExistingBreaks = SubExistingBreaks.Duplicate();
         FeederEquip = SubFeederEquip.Duplicate();
      ENDIF;
*/
/*
** Now we trace starting from the FdrLoad devices on this card.
** Our default condition is an Out of Service (CutOut) feeder.
** If any trace reaches a BusSection device or another FdrLoad,
** then the feeder is In Service (CutIn).
*/
      FeederIsCutIn = FALSE;
      
      FOR j = 1 TO FdrLoad.LastRow() DO
         /*
         ** start search with this piece of equipment and then branch out in all
         ** directions.  When a trace dies or reaches an Open device we discontinue
         ** the trace in that direction.  If a Bus Section or Fdr Load type device is 
         ** encountered, then the feeder is In Service (CutIn).
         */
         Trace = Trace_ConnectedSourceCutOut.Create();   // safer to create a trace object before each trace
         
         Trace.JCEquip.Object = FdrLoad[j].Value;
         Trace.SubstationScope = FdrLoadSub;
         
         TraceStatus = Trace.StartTargetTrace();
         
         IF Trace.ReturnCode <> 0 THEN
            CALLPROC TraceError (
                     UserMessage = 'ERROR: The Connectivity trace from ' + Feeders[f].FeederName +
                        ' Feeder Load discovered a connectivity problem: ' + Trace.ErrorMessage,
                     TraceMessage = 'ConnectedSourceCutOutTrace: ' +
                       'The Connectivity trace from ' + Feeders[f].FeederName +
                        ' Feeder Load ' + VARCHAR(FdrLoad[j].Value) + ' discovered a connectivity problem: ' + Trace.ErrorMessage);
            RETURN;
         ENDIF;
         
         IF Trace.FeederIsCutIn = TRUE THEN
            FeederIsCutIn = TRUE;
         ENDIF;
      ENDFOR;
/*
** Now we check the FeederIsCutIn flag that we may have "set" during our trace.  
** If the Feeder is considered CutIn and we are closing a device, we call PromptCutIn.
** If the Feeder is considered CutOut and we are opening a device, we call PromptCutOut.
*/
      IF FeederIsCutIn = TRUE AND CloseOrOpen = 1 THEN  
         RetCode = CALLFRAME PromptCutIn (JIP = JIP, Feeder = Feeders[f].Feeder);
         IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (
                     UserMessage = 'ERROR: The Connectivity based trace determined that ' +
                       'feeder ' + Feeders[f].FeederName + ' should be Cut In, but an ' +
                       'error has prevented that from happening.',
                     TraceMessage = 
                       'ConnectedSourceCutOutTrace: ' +
                       'Feeder ' + Feeders[f].FeederName + ' should be Cut Out.'
                     );
         ENDIF;

         RetCode = CALLPROC SOA_LogIns (
          Card            = Feeders[f].Card
        , Job             = NULL
        , SwitchingItem   = 0
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'CutIn'
        , New             = 'Cut In via Connectivity in Station'
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to insert log entry for FMS card cutin.',
                           TraceMessage =
             'ConnectedSourceCutOutTrace; ' +
             'Unable to insert log' +
             ' entry indicating FMS card is cutin.'
             );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

      IF FeederIsCutIN = FALSE AND CloseOrOpen = 0 THEN
         RetCode = CALLFRAME PromptCutOut (JIP = JIP, Feeder = Feeders[f].Feeder);
         IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (
                     UserMessage = 'ERROR: The Connectivity based trace determined that ' +
                       'feeder ' + Feeders[f].FeederName + ' should be Cut Out, but an ' +
                       'error has prevented that from happening.',
                     TraceMessage = 
                       'ConnectedSourceCutOutTrace: ' +
                       'Feeder ' + Feeders[f].FeederName + ' should be Cut Out.'
                     );
         ENDIF;

         RetCode = CALLPROC SOA_LogIns (
          Card            = Feeders[f].Card
        , Job             = NULL
        , SwitchingItem   = 0
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'CutOut'
        , New             = 'Cut Out via Connectivity in Station'
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to insert log entry for FMS card cutout.',
                           TraceMessage =
             'ConnectedSourceCutOutTrace; ' +
             'Unable to insert log' +
             ' entry indicating FMS card is cutout.'
             );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;

   RETURN;
END;

PROCEDURE ReloadTargets (
   Substations = ARRAY OF INTEGEROBJECT
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   StaticWhereClause = 'G.Grouping IN (';
   FOR i = 1 TO Substations.LastRow() DO
      IF i = 1 THEN
         StaticWhereClause = StaticWhereClause + VARCHAR(Substations[i].Value);
      ELSE
         StaticWhereClause = StaticWhereClause + ',' + VARCHAR(Substations[i].Value);
      ENDIF;
   ENDFOR;

   StaticWhereClause = StaticWhereClause + ') AND G.Relationship = ' + VARCHAR(Interaction$MemberOf);
/*
** Will limit scope to Substation equipment, looking for non-Cap BREAKER in station.
*/
   DynamicWhereClause = StaticWhereClause + ' AND G.Member = O.Object AND O.Type = ET.Type AND ' +
                        'ET.SuperType = ' + VARCHAR(Type$BREAKER) + ' AND O.Name NOT LIKE ' + '''' +
                        '%C%' + '''';
 
   i = 1;
   TargetTypes.Clear();
   SELECT
   DISTINCT  :TargetTypes[i].Value = O.Object
   FROM      Udb_Grouping G,
             Udb_Object O,
             Udb_ExtendedType ET
   WHERE     :DynamicWhereClause
   BEGIN
      i = i + 1;
   END;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all currently open devices in the station
** into a sorted list that then can be searched using our bisection search.
*/
   DynamicWhereClause = StaticWhereClause + ' AND G.Member = S.Object AND S.CurrentlyOpen = 1';

   ExistingBreaks.Clear();
   i = 1;        
   SELECT  :ExistingBreaks[i].Value = S.Object
   FROM    Udb_Switch S,
           Udb_Grouping G 
   WHERE   :DynamicWhereClause
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
/*
** Scope trace must stay on substation equipment (formerly feeder equip, hence the name of the field). 
*/ 
   DynamicWhereClause = StaticWhereClause + ' AND G.MemberType IN (' +
                        'SELECT Type FROM Udb_ExtendedType WHERE SuperType = ' + 
                         VARCHAR(Type$Conducting) + ')';
                        

   FeederEquip.Clear();   
   i = 1;
   SELECT  :FeederEquip[i].VALUE = G.Member
   FROM    Udb_Grouping G
   WHERE   :DynamicWhereClause
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
END;




