	Name:            ActivityLog

/*
**
**      Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          ActivityLog
**
**  Modification:
**	07/15/92 em	Master List #69. Log is not displaying data when
**			Job information not present.  Modified Select stmt
**			to behave like an Outer Join.
**      10/21/92   em     Modified per integer/udb. 
**      12/06/92   gc     UPDATE ROLLBCK/COMMIT for DDB 
**      12/20/92   gjc    added window close logic to fix bug 6.
**      01/11/93   mts    converted ddb_commit to ddb_rollback for select transactions.
**      05/19/93   gjc    Added call to frame ShowJobLog.
**      07/18/93   em     removed repeated selects
**      08/02/93   em     add equipclassname to select
**      01/17/94   em     look at archives for closed cards
**      04/18/94   em     add closed card log report access
**      10/10/94   pw     Extraction by equipment button added
**      01/06/94   pw     fix extraction from archive table
**      01/30/97   em     allow extraction of blank equipment.
**      02/29/00   em     Added takeover control
**      06/22/02   pkw    Webify screen.
**      06/29/03   pkw    Merge with SOA version and change name to ActivityLog
**      03/08/05   ysp    ITC 148: Add Filter By Item button.
**      12/20/05   ysp    increase the size of tomove to 160 characters    
**      12/04/07   pkw    Use current array when filter by item to avoid problem with archive data.
**      04/08/10   ysp    use WhichRow method to figure out the row number in ChildProperties event
**      03/23/11   em     Increase width of equip fields during 3G merge
**      06/06/11   em     Corrected run-time row out of range error
**      05/01/15   em     Removed Report button which has no underlying code
**      05/18/15   ysp    Support multiple equipment and item filtering.
*/

INITIALIZE
(
    Card = Integer NOT NULL;              /* Passed card */
    SwitchingItem = Integer NOT NULL;     /* Passed SwitchingItem */

#   include StandardDeclarations

    m = integer not null;               /* Temporary counter */
    j = integer not null;               /* Temporary counter */
    SimpleCard = FMS_Card_ASE DEFAULT NULL;
    AL_Orig = ARRAY OF CardLog;
) =
BEGIN
    Field(FullLog_Btn).CurBias = FB_Invisible;
    CurFrame.SendUserEvent (eventname = 'load_data');
END;
/*
**      Load the data for the log from the database into
**      the 4GL environment and set up the display
*/
ON UserEvent 'load_data' =
BEGIN
/*
** Load transaction log data.
*/
   IF SimpleCard IS NULL THEN
      SimpleCard = FMS_Card_ASE.Create();
   ENDIF;
   
   SimpleCard.Card = Card;    
   SimpleCard.SwitchingItem = SwitchingItem;
   SimpleCard.ArchiveCard = ArchiveCard;

   SimpleCard.LoadTxLog();
   
   AL.Clear();
   AL = SimpleCard.FCLog.Duplicate();
   AL_Orig = SimpleCard.FCLog.Duplicate();

   SimpleCard = NULL;
END;
/*
**      Handle a Dismiss click
*/
ON Click Dismiss =
BEGIN
    RETURN;
END;

ON ChildProperties AL =
BEGIN
   i = FIELD(AL).WhichRow (cellfield = CurFrame.TriggerField);

   IF i = 0 THEN
      RESUME;
   ENDIF;
/*
** Load transaction log data.
*/
   IF SimpleCard IS NULL THEN
      SimpleCard = FMS_Card_ASE.Create();
   ENDIF;
   
   SimpleCard.FCLog[1].TOOperator = AL[i].TOOperator;
   SimpleCard.FCLog[1].RSOperator = AL[i].RSOperator;

   SimpleCard.LoadTxLogDetails();

   AL[i].TOOperatorName = SimpleCard.FCLog[1].TOOperatorName;
   AL[i].RSOperatorName = SimpleCard.FCLog[1].RSOperatorName;

   SimpleCard = NULL;

   CALLFRAME ActivityLogDetails(JobDetail = AL[i]);

END;

ON Click FullLog_Btn = 
BEGIN
   CurFrame.SendUserEvent (eventname = 'load_data');
   Field(FullLog_Btn).CurBias = FB_Invisible;
END;

ON Click Filter_Btn = 
DECLARE
   ExtractEquip = ARRAY of Equipment; 
   SelectedEquip = ARRAY of Equipment; 
   SelectedItems = ARRAY of CardLog; 
   TempLogs = ARRAY OF CardLog;
ENDDECLARE
BEGIN
/*
** Load transaction log data.
*/
   IF SimpleCard IS NULL THEN
      SimpleCard = FMS_Card_ASE.Create();
   ENDIF;
   
   SimpleCard.Card = Card;    
   SimpleCard.SwitchingItem = SwitchingItem;
   SimpleCard.ArchiveCard = ArchiveCard;

   SimpleCard.LoadTxLogEquip();
/*
**  Use a FOR LOOP to build extractequip array.  This allows us 
**  to reuse cardlog class in FMS_Card_ASE.  We can't make 
**  ExtractEquip an array of cardlog because it is passed into
**  ChangePrimarySource which uses FMS_Equip.
*/ 
   ExtractEquip.Clear();
   FOR i = 1 TO SimpleCard.FCLog.LastRow() DO
      ExtractEquip[i].PrintId = SimpleCard.FCLog[i].PrintId;
      ExtractEquip[i].Equip = SimpleCard.FCLog[i].Equip;
      ExtractEquip[i].EquipName = SimpleCard.FCLog[i].EquipName;
      ExtractEquip[i].EquipClassName = SimpleCard.FCLog[i].EquipClassName;
   ENDFOR;

   SimpleCard.FCLog.Clear();
   SimpleCard.LoadTxLogItem();  

   RetCode = CALLFRAME SelectTxLogFilters
               (SelectEquip = ExtractEquip.Duplicate(),
                SelectItem = SimpleCard.FCLog.Duplicate(),
                SelectedEquip = BYREF(SelectedEquip),
                SelectedItems = BYREF(SelectedItems));         
   IF RetCode = PU_OK THEN
      /*
      ** Load transaction log data.
      */
      j = 1;      
      
      FOR i =1 TO AL_Orig.LastRow DO
         IF SelectedItems.LastRow > 0 THEN
            RetCode = SelectedItems.Find(AttributeName = 'item', Value = AL_Orig[i].Item);
            IF RetCode = ER_ROWNOTFOUND THEN
               CONTINUE;
            ENDIF;
         ENDIF;
         
         IF SelectedEquip.LastRow > 0 THEN
            RetCode = SelectedEquip.Find(AttributeName = 'equip', Value = AL_Orig[i].Equip);
            IF RetCode = ER_ROWNOTFOUND THEN
               CONTINUE;
            ENDIF;
         ENDIF;
         TempLogs.InsertRow(RowNumber = j, RowObject = AL_Orig[i].Duplicate());
         j = j + 1;
      ENDFOR;

      AL = TempLogs; 
      Field(FullLog_Btn).CurBias = FB_Landable;
   ENDIF;

   SimpleCard = NULL;   
END;

/*
**      another desk wants control of the card.  parse dbevent text,
**      present message, and file card.
*/
ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'fms_card_control_taken' =
BEGIN
#  include Card_Control
   RETURN;
END;

ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

