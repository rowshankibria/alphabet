/*
** handle child entry on work item
*/
ON ChildEntry = 
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TblName = VARCHAR(40) NOT NULL WITH DEFAULT;
   TempOR = SWPOutageClass;
   TempStack = STACKFIELD;
   WITBL = TableField;
ENDDECLARE
BEGIN 
   WITBL = curframe.TriggerField.whichtablefield();
   IF WITBL IS NOT NULL THEN
      IF WITBL.FullName LIKE '%wilist' THEN 
         TblName = WITBL.FullName;
         TblName = SHIFT(WITBL.FullName, -5);   // remove "ORSF_"
         i = LOCATE(TblName, '.');
         ORIdx = INT4(LEFT(TblName, i-1));
         WIIdx = WITBL.WhichRow (CellField = Curframe.TriggerField);  
         
         RetCode = CALLPROC ValidateSubstation (Substation = ORList[ORIdx].WIList[WIIdx].Substation);
         IF RetCode = PU_OK THEN
            CALLPROC ShowWorkItem();
         ELSE
            ORIdx = 0;
            WIIdx = 0;
            MESSAGE 'Not in your Jurisdiction.';
         ENDIF;
         CALLPROC HighlightWorkItem();
      ENDIF;
   ENDIF;
END;

