Application Component Report
============================

	Name:            DropConnectivity

/* 
**      Copyright c 1993 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  Frame:          DropConnectivity 
** 
**  Modification log: 
** 
**  Date:    Version  Description 
** --------------------------------------------------------------------------------- 
**  01/11/95  pw      Created
**  09/13/13  ysp     Add IsLMEquipment  
*/ 
INITIALIZE   
(
    DroppedEquip = FMS_Equip;                   /* passed in */
    Feeder = INTEGER NOT NULL WITH DEFAULT;     /* passed in */
    EquipList1 = ARRAY OF CONNECTCLASS;		/* passed in */
    EquipList2 = ARRAY OF CONNECTCLASS;		/* passed in */

    i = integer;		    /* Temporary counters */ 
    j = integer;		
    k = integer;		
    status = integer;   	/* return status variable */ 
    RetCode = INTEGER;                            
) = 
DECLARE
   IsLMEquipment = PROCEDURE RETURNING INTEGER;
ENDDECLARE
BEGIN 
    Field(Text).TextValue = 'Equipment  ' + DroppedEquip.EquipClassName + '  ' + 
         DroppedEquip.EquipName + '  is connected between:';
   
    IF EquipList1.LastRow() <= 3 THEN
       Field(EquipName1).Lines = EquipList1.LastRow();
    ELSE
       Field(EquipName1).Lines = 3;
       Field(EquipName1).HasScrollBar = TRUE;
    ENDIF;
    
    i = 1;
    EquipName1 = '';
    WHILE i <= EquipList1.LastRow() DO
       EquipName1 = EquipName1 + EquipList1[i].TypeName + ' ' + 
                                 EquipList1[i].Name + HC_NewLine;
       i = i + 1;
    ENDWHILE;

    IF EquipList2.LastRow() <= 3 THEN
       Field(EquipName2).Lines = EquipList2.LastRow();
    ELSE
       Field(EquipName2).Lines = 3;
       Field(EquipName2).HasScrollBar = TRUE;
    ENDIF;
    
    i = 1;
    EquipName2 = '';
    WHILE i <= EquipList2.LastRow() DO
       EquipName2 = EquipName2 + EquipList2[i].TypeName + ' ' + 
                                 EquipList2[i].Name + HC_NewLine;
       i = i + 1;
    ENDWHILE;

    /* 
    ** This frame is modified to determine whether or not the dropped equipment 
    ** should be disconnected from the connectivity. 
    ** 1. If the equipment is dropped from an L&M feeder (equipment is a member of both a feeder
    **    and a substation), disconnect it. 
    ** 2. DO hardly drops an ATS member 
    ** 3. DM switchees on a 3G feeder are not members of substations
    */
    IF Feeder > 0 THEN
       RetCode = CALLPROC IsLMEquipment();
       IF RetCode = TRUE THEN
          RETURN (Terminal$EndCap);
       ELSE
          RETURN (PU_CANCEL);
       ENDIF;
    ENDIF;
END; 

ON Click EndCap_Btn = 
BEGIN 
   RETURN (Terminal$EndCap);
END;
   
ON Click Connect_Btn = 
BEGIN 
   RETURN (Terminal$ConnectAround);
END;

/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

PROCEDURE IsLMEquipment(
) = 
DECLARE
    
ENDDECLARE
BEGIN
/*
** a meber of a feeder
** this piece of equipment is just dropped from the feeder. This grouping is just removed
** from the database. Don't check this now.
    i = 0;
    SELECT  :i = 1
    FROM    Udb_Grouping G
    WHERE   G.Grouping = :Feeder AND
            G.Member = :DroppedEquip.Equip AND
            G.RelationShip = :Interaction$MemberOf;
*/
   /* A member of a substation 
   */
   i = 0;
   SELECT  :i = 1
   FROM    Udb_Grouping G
   WHERE   G.GroupingType = :Type$Substation AND
           G.Member = :DroppedEquip.Equip AND
           G.RelationShip = :Interaction$MemberOf;
   CALLPROC DDB_ROLLBACK;

   IF i = 1 THEN
      RETURN TRUE;
   ELSE    
      RETURN FALSE;
   ENDIF;
END;

