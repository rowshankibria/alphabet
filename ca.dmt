/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OperatorSkillClass
**
**  Date:       Version Description
** ----------------------------------
**  07/01/08    YSP  Created.
**  09/11/08    ysp  Add Submit Request to audit trail
**  09/19/08    ysp  if the request includes operator with no skill required, 
**                   only insert it into the udb object table.
**  11/23/09    ysp  Add FMS_SkillRequest db event queue to send emails.
*/ 
METHOD GetRequest (
) = 
DECLARE
   i       = INTEGER NOT NULL;     /*Counter*/
   j       = INTEGER NOT NULL;     /*Counter*/
   CurPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   NewPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   DynamicWhereClause = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT   	 
         :CurObject.RequestTime = R.RequestTime,      
         :CurObject.Department = R.Department,
         :CurObject.ManagerTitle = R.ManagerTitle,
         :CurObject.ManagerName = R.ManagerName,
         :CurObject.ManagerEmail = R.ManagerEmail,
         :CurObject.CrewName = R.CrewName,
         :CurObject.CrewEMPNumber = R.CrewEMPNumber,
         :CurObject.CrewObject = R.CrewObject,
         :CurObject.RequestRemark = R.RequestRemark,
         :CurObject.Status = R.Status,
         :CurObject.ReviewedBy= R.ReviewedBy,
         :CurObject.ReviewTime = R.ReviewTime,
         :CurObject.ReviewRemark = R.ReviewRemark,
         :CurPermList = R.CurPermission,     
         :NewPermList = R.NewPermission
   FROM FMS_AccessRequest R
   WHERE R.RequestID = :CurObject.RequestID;
   CALLPROC DDB_ROLLBACK;

   /*
   ** check if it is already in the object table
   */
   IF CurObject.CrewObject = 0 THEN
      SELECT :CurObject.CrewObject = O.Object
      FROM   UDB_Object O
      WHERE  O.Name = :CurObject.CrewEMPNumber AND
             O.Type IN (SELECT  Type
                     FROM    Udb_ExtendedType
                     WHERE   SuperType = :Type$Person);
   ENDIF;
   
   CurObject.CurPermList.Clear();
   IF CurObject.CrewObject > 0 THEN
      i = 1;
      SELECT :CurObject.CurPermList[i].Name = T.Name,
             :CurObject.CurPermList[i].Type = S.Skill
      FROM   FMS_PersonToSkill S,
             UDB_Type T
      WHERE  S.Operator = :CurObject.CrewObject AND
             S.Skill = T.Type
      BEGIN
         i = i + 1;
      END;
   ENDIF;

   DynamicWhereClause = 'T.Type IN (' + NewPermList + ')';
   CurObject.NewPermList.Clear();
   i = 1;
   SELECT :CurObject.NewPermList[i].Name = T.Name,
          :CurObject.NewPermList[i].Type = T.Type
   FROM   UDB_Type T
   WHERE  :DynamicWhereClause 
   BEGIN
      i = i + 1;
   END;

   RETURN;
END;

METHOD SubmitRequest (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;     /*Counter*/
   ToAddNew = INTEGER NOT NULL WITH DEFAULT; 
   CurPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   CurSkillList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   NewPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   NewSkillList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   GroupingType = INTEGER NOT NULL WITH DEFAULT;
   RequestID = INTEGER NOT NULL WITH DEFAULT; 
   RetCode = INTEGER NOT NULL; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurSkillList = '';
   NewSkillList = '';

   /*
   ** check if it is already in the object table
   */
   SELECT :CurObject.CrewObject = O.Object
   FROM   UDB_Object O
   WHERE  O.Name = :CurObject.CrewEmpNumber AND
          O.Type IN (SELECT  Type
                     FROM    Udb_ExtendedType
                     WHERE   SuperType = :Type$Person);
/*
** Check if the crew has already the requested skills.
*/
   IF CurObject.CrewObject > 0 THEN
      CurObject.CurPermList[1].Name = 'Operator';
      CurObject.CurPermList[1].Type = Type$Person;

      CurSkillList = 'Operator';	// Not skill required
      /* 
      ** get current skill sets
      */
      i = 2;
      SELECT :CurObject.CurPermList[i].Name = T.Name,
             :CurObject.CurPermList[i].Type = S.Skill
      FROM   FMS_PersonToSkill S,
             UDB_Type T
      WHERE  S.Operator = :CurObject.CrewObject AND
             S.Skill = T.Type
      BEGIN
         IF CurSkillList <> '' THEN
            CurSkillList = CurSkillList + ',';
         ENDIF;
         CurSkillList = CurSkillList + CurObject.CurPermList[i].Name;
   
         i = i + 1;
      END;
   ENDIF;   

   FOR i = 1 TO CurObject.NewPermList.LastRow DO
      IF NewSkillList <> '' THEN
         NewSkillList = NewSkillList + ',';
      ENDIF;
      NewSkillList = NewSkillList + CurObject.NewPermList[i].Name;
   ENDFOR;

   IF CurSkillList = '' THEN
      CurSkillList = 'no skills';
   ELSE
      CurSkillList = 'skill -' + CurSkillList;
   ENDIF;

   RetCode = CALLPROC FMS_AuditTrailIns (
                Entity = 'FMS_PersonToSkill'
               ,Handle = CurObject.CrewObject                               
               ,LogTime = DATE('Now')
               ,Operator = 0
               ,Item = 'Operator Skill' 
               ,Old =  CurObject.CrewName + ' has ' + CurSkillList + ' at this time'
               ,New = CurObject.ManagerName + ' requested new skill -' + NewSkillList + '- for ' + CurObject.CrewName);   
   IF RetCode <> 0 THEN 
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.SubmitRequest; Failed to log audit for request = ' + varchar(CurObject.RequestID));
   ELSE 
      CALLPROC DDB_COMMIT;
   ENDIF;

   /*
   ** Check if the crew already has the requested skills. If he does, no need to ask CDO to review.
   ** The request will be closed.
   */
   ToAddNew = FALSE;
   FOR i = 1 TO CurObject.NewPermList.LastRow DO
      RetCode = CurObject.CurPermList.Find(
                                 AttributeName = 'type',
                                 Value = CurObject.NewPermList[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         ToAddNew = TRUE;
         ENDLOOP;     
      ENDIF;
   ENDFOR;

   IF ToAddNew = TRUE THEN
      CurObject.Status = Request$Opened;
   ELSE
      /* the crew already has the requested skills */
      CurObject.Status = Request$Approved;
   ENDIF;
/*
** save the request
*/
   CurPermList = '';
   FOR i = 1 TO CurObject.CurPermList.LastRow DO
      IF CurPermList <> '' THEN
         CurPermList = CurPermList + ',';
      ENDIF;
      CurPermList = CurPermList + VARCHAR(CurObject.CurPermList[i].Type);
   ENDFOR;

   NewPermList = '';
   FOR i = 1 TO CurObject.NewPermList.LastRow DO
      IF NewPermList <> '' THEN
         NewPermList = NewPermList + ',';
      ENDIF;
      NewPermList = NewPermList + VARCHAR(CurObject.NewPermList[i].Type);
   ENDFOR;

   SELECT :CurObject.RequestID = IFNULL(MAX(RequestID),0)
   FROM   FMS_AccessRequest;
   CurObject.RequestID = CurObject.RequestID + 1;

   RetCode = CALLPROC FMS_AccessRequestIns (
                      RequestID = CurObject.RequestID
                     ,AccessType = CurObject.AccessType
                     ,RequestTime = DATE('NOW')     
                     ,Department = CurObject.Department           
                     ,ManagerTitle = CurObject.ManagerTitle 
                     ,ManagerName = CurObject.ManagerName           
                     ,ManagerEmail = CurObject.ManagerEmail 
                     ,CrewName = CurObject.CrewName
                     ,CrewEMPNumber = CurObject.CrewEMPNumber
                     ,CrewObject = CurObject.CrewObject            
                     ,CurPermission = CurPermList    
                     ,NewPermission = NewPermList   
                     ,RequestRemark = CurObject.RequestRemark
                     ,Status = CurObject.Status);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;  

      CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'FMS_SkillRequest',
                     EventText = VARCHAR(CurObject.RequestID));
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.RequestUserSkill; Failed to insert request for ' + CurObject.CrewName);

      IF CurObject.Status = Request$Opened THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Failed to insert request for' + CurObject.CrewName;
      ENDIF;
   ENDIF;

   IF CurObject.Status = Request$Approved THEN
      RetCode = CALLPROC FMS_AccessRequestReview (
 	              RequestID = CurObject.RequestID,
                      ReviewedBy = 'FMS System',
                      ReviewTime = DATE('NOW'),
                      ReviewRemark = 'Crew already set up in the database',
                      Status = Request$Approved,
                      CrewObject = CurObject.CrewObject);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.RequestUserSkill; Failed to update review for request ' + VARCHAR(CurObject.RequestID));
      ELSE
         CALLPROC DDB_COMMIT; 
      ENDIF;
   ENDIF;

   RETURN;
END;

METHOD ApproveRequest (
)=
DECLARE
   i  = INTEGER NOT NULL;     /*Counter*/
   j  = INTEGER NOT NULL;     /*Counter*/
   AlreadyExist = INTEGER NOT NULL WITH DEFAULT;
   TypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   PrimaryGroupingName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   CurPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   NewPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   DynamicWhereClause = VARCHAR(500) NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT   	 
         :CurObject.RequestTime = R.RequestTime,      
         :CurObject.Department = R.Department,
         :CurObject.ManagerTitle = R.ManagerTitle,
         :CurObject.ManagerName = R.ManagerName,
         :CurObject.ManagerEmail = R.ManagerEmail,
         :CurObject.CrewName = R.CrewName,
         :CurObject.CrewEMPNumber = R.CrewEMPNumber,
         :CurObject.CrewObject = R.CrewObject,
         :CurObject.RequestRemark = R.RequestRemark,
         :CurObject.Status = R.Status,
         :CurPermList = R.CurPermission,     
         :NewPermList = R.NewPermission
   FROM FMS_AccessRequest R
   WHERE R.RequestID = :CurObject.RequestID;

   DynamicWhereClause = 'T.Type IN (' + NewPermList + ')';
   CurObject.NewPermList.Clear();
   i = 1;
   SELECT :CurObject.NewPermList[i].Name = T.Name,
          :CurObject.NewPermList[i].Type = T.Type
   FROM   UDB_Type T
   WHERE  :DynamicWhereClause 
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.CrewObject = 0 THEN
      /* Double check */
      SELECT :CurObject.CrewObject = O.Object
      FROM   UDB_Object O
      WHERE  O.Name = :CurObject.CrewEmpNumber AND
             O.Type IN (SELECT  Type
                     FROM    Udb_ExtendedType
                     WHERE   SuperType = :Type$Person);

   ENDIF;

   IF CurObject.CrewObject = 0 THEN
      SELECT :TypeName = Name
      FROM   UDB_Type
      WHERE  Type = :Type$Person;
      CALLPROC DDB_ROLLBACK;
/*
** Insert the user into the udb_object table
*/      
       RetCode = CALLPROC Udb_ObjectIns (
                 Object = -1
                ,Name = CurObject.CrewEMPNumber
                ,Type = Type$Person
                ,TypeName = TypeName
                ,PrimaryGrouping = 0
                ,PrimaryGroupingName = ''
                ,Terminals = 0
                );

        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.ApproveRequest; Failed to add ' + CurObject.CrewName + ' to database');
            CurObject.ReturnCode = -2;
            CurObject.ErrorMessage = 'Failed to add ' + CurObject.CrewName + ' to database';
            RETURN;
        ENDIF;

        SELECT  :CurObject.CrewObject = K.Value
        FROM    Udb_LastKey K
        WHERE   K.LastKey = 'Object';

        RetCode = CALLPROC Udb_ObjectUpdAll (
                  Object = CurObject.CrewObject
                 ,Type = Type$Person
                 ,TypeName = TypeName
                 ,PrimaryGrouping = 0
                 ,PrimaryGroupingName = ''
                 ,Name = CurObject.CrewEMPNumber
                 ,Description = CurObject.CrewName
                 ,Comment = ''
                 ,InService = NULL
                 ,OutService = NULL
                 ,LockNumber = ''
                 ,Combination = ''
                 ,PositionX = NULL
                 ,PositionY = NULL
                 ,OwnerNumber = ''
                 ,SerialNumber = ''
                 ,SpecNumber = ''
                 ,Validated = NULL
                 ,ValidatedBy = ''
                 ,LastChanged = Date ('now')
                 ,LastChangedBy = 'Online'
                 );
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.ApproveRequest; Failed to update ' + CurObject.CrewName + ' in database');
            CurObject.ReturnCode = -2;
            CurObject.ErrorMessage = 'Failed to update ' + CurObject.CrewName + ' in database';
            RETURN;
        ENDIF;
        CALLPROC DDB_COMMIT;  
   ENDIF;

   FOR i = 1 TO CurObject.NewPermList.LastRow DO
      IF Type$Person = CurObject.NewPermList[i].type THEN
         CONTINUE;
      ENDIF;

      AlreadyExist = 0;
      SELECT :AlreadyExist = 1
      FROM   FMS_PersonToSkill S
      WHERE  S.Operator = :CurObject.CrewObject AND
             S.Skill = :CurObject.NewPermList[i].type;

      IF AlreadyExist = 1 THEN
         CONTINUE;
      ENDIF;

      RetCode = CALLPROC FMS_PersonToSkillInsert(Operator = CurObject.CrewObject,
                                                 Skill = CurObject.NewPermList[i].type);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.ApproveRequest; Failed to add skill ' + CurObject.NewPermList[i].Name + ' for crew ' + CurObject.CrewName);
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Failed to add skill ' + CurObject.NewPermList[i].Name + ' for crew ' + CurObject.CrewName;
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT; 
 
         RetCode = CALLPROC FMS_AuditTrailIns (
                Entity = 'FMS_PersonToSkill'
               ,Handle = CurObject.CrewObject                               
               ,LogTime = DATE('Now')
               ,Operator = 0
               ,Item = 'Operator Skill' 
               ,Old =  CurObject.ReviewedBy + ' added skill -' +  CurObject.NewPermList[i].Name + '- To ' + CurObject.CrewName
               ,New = 'Requested by ' + CurObject.ManagerName);   
        IF RetCode <> 0 THEN 
           CALLPROC DDB_ROLLBACK;
           CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.ApproveRequest; Failed to log audit for request = ' + varchar(CurObject.RequestID));
        ELSE 
           CALLPROC DDB_COMMIT;
        ENDIF;
     ENDIF;
   ENDFOR;
 
   CurObject.ReviewTime = Date('Now');	
   RetCode = CALLPROC FMS_AccessRequestReview (
 	              RequestID = CurObject.RequestID,
                      ReviewedBy = CurObject.ReviewedBy,
                      ReviewTime = CurObject.ReviewTime,
                      ReviewRemark = CurObject.ReviewRemark,
                      Status = Request$Approved,
                      CrewObject = CurObject.CrewObject);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.ApproveRequest; Failed to update request to Closed for request ' + VARCHAR(CurObject.RequestID));
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Skills added successfully. But failed to close the request';
   ELSE
      CALLPROC DDB_COMMIT; 
      CurObject.Status = Request$Approved;

      CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'FMS_SkillRequest',
                     EventText = VARCHAR(CurObject.RequestID));
   ENDIF;

   RETURN;
END;

METHOD DenyRequest (
)=
DECLARE
   i  = INTEGER NOT NULL;     /*Counter*/
   j  = INTEGER NOT NULL;     /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.ManagerName = R.ManagerName,
          :CurObject.CrewName = R.CrewName
   FROM FMS_AccessRequest R
   WHERE R.RequestID = :CurObject.RequestID;
   CALLPROC DDB_ROLLBACK;

   CurObject.ReviewTime = Date('Now');	
   RetCode = CALLPROC FMS_AccessRequestReview (
 	              RequestID = CurObject.RequestID,
                      ReviewedBy = CurObject.ReviewedBy,
                      ReviewTime = CurObject.ReviewTime,
                      ReviewRemark = CurObject.ReviewRemark,
                      Status = Request$Denied,
                      CrewObject = 0);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.DenyRequest; Failed to set status to DENIED for request ' + VARCHAR(CurObject.RequestID));
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Failed to set the request status to DENIED';
   ELSE
      CALLPROC DDB_COMMIT;

      CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'FMS_SkillRequest',
                     EventText = VARCHAR(CurObject.RequestID));
 
      CurObject.Status = Request$Denied;

      RetCode = CALLPROC FMS_AuditTrailIns (
                Entity = 'FMS_AccessRequest'
               ,Handle = CurObject.RequestID                              
               ,LogTime = DATE('Now')
               ,Operator = 0
               ,Item = 'Operator Skill' 
               ,Old =  CurObject.ReviewedBy + ' DENIED operator skill authorization' 
               ,New = 'Requested by ' +  + CurObject.ManagerName + ' for ' + CurObject.CrewName);     
      IF RetCode <> 0 THEN 
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.DenyRequest; Failed to log audit for request = ' + varchar(CurObject.RequestID));
      ELSE 
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF; 

   RETURN;
END;

METHOD UpdateStatus (
)=
DECLARE
   i  = INTEGER NOT NULL;     /*Counter*/
   j  = INTEGER NOT NULL;     /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_AccessRequestStatus (
 	              RequestID = CurObject.RequestID,
                      Status = CurObject.Status);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': OperatorClass_ASE.UpdateStatus; ' + 
                      'Failed to update status to ' + VARCHAR(CurObject.Status) + ' for request ' + VARCHAR(CurObject.RequestID));
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Failed to set the request status to ' + VARCHAR(CurObject.Status) + ' for request ' + VARCHAR(CurObject.RequestID);
   ELSE
      CALLPROC DDB_COMMIT; 
   ENDIF; 

   RETURN;
END;

