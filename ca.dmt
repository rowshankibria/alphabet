	Name:            PromptSendCloseToSSL

/*
**
**	Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSendCloseToSSL
**
**  Modifications:
**  12/03/09  ysp Initial
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */

    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL; 
    DBTime  = DATE NOT NULL WITH DEFAULT;
    StatusChange = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;

      /*
      **  Select times from database in case user is using manual entry mode.
      */
      DBTime = '';
      IF JIP.Status = Job$TakeOut THEN
         SELECT :DBTIME = IFNULL(J.TOComplete,'')
         FROM    SOA_Job J
         WHERE   J.Job = :JIP.Job;
      ELSEIF JIP.Status = Job$Restore THEN
         SELECT :DBTIME = IFNULL(J.RSComplete,'')
         FROM    SOA_Job J
         WHERE   J.Job = :JIP.Job;        
      ENDIF;
      IF DBTime = '' THEN
         SELECT :DBTime = DATE('NOW');
      ENDIF;

      RetCode = CALLPROC FMS_ObjectStatusAuditIns (
            Time = DBTime,
            Object = JIP.Equip,
            Status = 0,
            Job = JIP.Job,
            TORS = JIP.ToRs,
            Card = JIP.Card,
            SwitchingItem = JIP.SwitchingItem,
            FromApp = CurrentApplication,
            DOName = DOp.Description,
            RowTime = DATE('NOW'),
            StatusUpdate = 0);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                        TraceMessage =
            'PromptSendCloseToSSL: Unable to insert row into the ' +
            'FMS_ObjectStatusAudit table for Equip = ' + Varchar(JIP.Equip));
      ELSE 
         CALLPROC DDB_COMMIT;
         CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ObjectStatusAudit');
         CALLPROC DDB_COMMIT;
      ENDIF;

   RETURN (PU_OK);
END;


