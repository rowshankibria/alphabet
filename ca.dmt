Application Component Report
============================

	Name:            CreateFMSCardSetUp

/*
**      Copyright c 2011 Pateric Software LLC. All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written 
**      permission from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Frame:          CreateFMSCardSetUp 
** 
**  Date:     Version  Description 
** ------------------------------------------------- 
**  03/03/11   em      Created
**  03/30/11   pkw     Added ValidatedBy as TypeName
**
*/
/* 
** Handle creation utilizing network feeder logic.
** Pass back card number if successful, negative return if not.
*/
PROCEDURE CreateFMSCardSetUp (
    Feeder = INTEGER NOT NULL,
    CardClass = INTEGER NOT NULL
) =
DECLARE
    Card = INTEGER NOT NULL WITH DEFAULT;
    CardStatus = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL WITH DEFAULT;
    NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
    NetworkFeederList = ARRAY OF ConnectedEquipClass;
    Position3G = VARCHAR(20) NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    SubstationName3G = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    Card = -1;  
/*
**  If this feeder participates in connectivity, then we have a 3G feeder and
**  we use connectivity to find the list of feeders to include on the card.
*/
    NetworkFeeder = FALSE;
    SELECT :NetworkFeeder = 1
    FROM   Udb_Terminal
    WHERE  Object = :Feeder AND
           Node > 20000;

    IF NetworkFeeder = FALSE THEN
/*
**  Put solo feeder in NetworkFeederList
*/
       SELECT :NetworkFeederList[1].Object = Object,
       	      :NetworkFeederList[1].Type = Type,
       	      :NetworkFeederList[1].Name = Name,
              :NetworkFeederList[1].TypeName = ValidatedBy
       FROM   Udb_Object
       WHERE  Object = :Feeder;
    ELSE 
       RetCode = CALLPROC NetworkFeederTrace (
                           StartFeeder = Feeder,
                           NetworkFeederList = NetworkFeederList);
       IF RetCode = PU_CANCEL THEN
          MESSAGE '3G Network Feeder Card creation failed.';
          RETURN(Card);
       ENDIF;
/*
** Due to complexity of 3G if there is already an active card with this feeder on it, will force to use it.
*/
       FOR i = 1 TO NetworkFeederList.LastRow() DO    
          SELECT  :Card = Card
          FROM    SOA_ActiveObject 
          WHERE   Object = :NetworkFeederList[i].Object AND
                  ObjectToCardLink = 1;

          IF (Card > 0 ) THEN 
             RETURN(Card);
          ENDIF;
       ENDFOR;

       RetCode = CALLFRAME Determine3GSource (
                 NetworkFeederList = NetworkFeederList,
                 SubstationName3G = BYREF(SubstationName3G),
                 Position3G = BYREF(Position3G) );

       IF RetCode = PU_CANCEL THEN
          RETURN(-1);
       ENDIF;

    ENDIF;

    Card = CALLPROC CreateFMSOpenCard(
                              NewCardFeeder = Feeder,
                              NewCardClass = CardClass,
                              NetworkFeeder = NetworkFeeder,
                              NetworkFeederList = NetworkFeederList,
                              SubstationName3G = SubstationName3G,
                              Position3G = Position3G);
   IF Card = 0 THEN
      Card = -1;
   ENDIF;
    
   RETURN(Card)
END;

Application Component Report
============================

	Name:            CreateFMSOpenCard


/*
**      Copyright c 2006 Pateric Software LLC. All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written 
**      permission from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Frame:          CreateFMSOpenCard 
** 
**  Date:     Version  Description 
** ------------------------------------------------- 
**  03/27/06   ysp     Created
**  09/08/06   ysp     Change the call to PreloadMoves to CALLFRAME. 
**  04/16/07   ysp     ITC210: Insert IR interface event in DB event queue
**  04/14/10   em      New parameter NetworkFeederList to support
**                     multiple feeder 3G networwork feeder card.
**  06/07/10   em      Add Pass Through optional parm StepHeadingsOnly
**  02/10/11   em      Load NetworkFeederList for Solo feeder if empty
**  03/30/11   pkw     Added ValidatedBy field to TypeName
**  11/15/12   pkw     Update to create StepDown 4kv cards.
**  09/02/13   pkw     Handle creating StepDown Card from 3G card.
**  09/30/13   pkw     Always pass in Network Feeder = FALSE when creating 4kv Card
**  02/19/16   pkw     Update to create 33kv card
*/

PROCEDURE CreateFMSOpenCard
(
    NewCardFeeder = INTEGER NOT NULL;
    NewCardClass = INTEGER NOT NULL; 
    NetworkFeeder = INTEGER NOT NULL; 
    NetworkFeederList = ARRAY OF ConnectedEquipClass;
    SubstationName3G = VARCHAR(40) NOT NULL WITH DEFAULT;
    Position3G = VARCHAR(20) NOT NULL WITH DEFAULT;
    StepHeadingsOnly = INTEGER NOT NULL WITH DEFAULT;
    NoStepDown = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
    FMSCardASE = FMS_Card DEFAULT NULL;         /*Class to create new card*/
    i = INTEGER NOT NULL WITH DEFAULT; 
    NewCard = INTEGER NOT NULL WITH DEFAULT; 
    RetCode = INTEGER;
    StepDownCard = ARRAY OF FMS_Card;
ENDDECLARE
BEGIN
/* create an FMS and SOA card 
*/
    FMSCardASE = NULL;
    FMSCardASE = FMS_Card.Create();
    FMSCardASE.Feeder = NewCardFeeder;
    FMSCardASE.CardClass = NewCardClass;    		
    FMSCardASE.NetworkFeeder = NetworkFeeder;
    IF NetworkFeeder = NetworkFeeder$3G THEN
       FMSCardASE.SubstationName = SubstationName3G;
       FMSCardASE.Position = Position3G;
    ELSEIF NetworkFeederList.LastRow() = 0 THEN
/*
**  Put solo feeder in NetworkFeederList
*/
       SELECT :NetworkFeederList[1].Object = Object,
       	      :NetworkFeederList[1].Type = Type,
       	      :NetworkFeederList[1].Name = Name,
              :NetworkFeederList[1].TypeName = ValidatedBy
       FROM   Udb_Object
       WHERE  Object = :NewCardFeeder;
       /*
       **  33kv Add Portions to NetworkFeederList for Staten Island Feeders
       */
       i = 2;
       SELECT :NetworkFeederList[i].Object = O.Object,
       	      :NetworkFeederList[i].Type = O.Type,
       	      :NetworkFeederList[i].Name = O.Name,
              :NetworkFeederList[i].TypeName = O.ValidatedBy,
              :NetworkFeeder = :NetworkFeeder$33kV
       FROM   Udb_Object O,
              Udb_Grouping G,
              Udb_SuperType ST
       WHERE  G.Grouping = :NewCardFeeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = ST.Type AND
              ST.SuperType = :Type$33kVPortion AND
              G.Member = O.Object
       BEGIN
          i = i + 1;
       END;
    ENDIF;

    FOR i = 1 TO NetworkFeederList.LastRow() DO
        FMSCardASE.Object[i].Object = NetworkFeederList[i].Object;
        FMSCardASE.Object[i].Type = NetworkFeederList[i].Type;
        FMSCardASE.Object[i].Name = NetworkFeederList[i].Name;
        FMSCardASE.Object[i].TypeName = NetworkFeederList[i].ValidatedBy;
        IF i = 1 THEN
           FMSCardASE.FeederName = NetworkFeederList[i].Name;
        ELSE
           FMSCardASE.FeederName = FMSCardASE.FeederName + ',' + NetworkFeederList[i].Name;
        ENDIF;
    ENDFOR;
    FMSCardASE = FMSCardASE.InsertCard();
    
    NewCard = FMSCardASE.Card; 
/*
** Preload the Moves onto the New Card.
*/
    RetCode = CALLFRAME PreloadMoves (
                    Card = NewCard,
                    TypeofCard = FMSCardASE.TypeofCard,        
                    Feeder = NewCardFeeder,    
                    CardClass  = NewCardClass,
                    StepHeadingsOnly = StepHeadingsOnly);

    IF RetCode = PU_CANCEL THEN  
       CALLPROC DDB_ROLLBACK;

       /*
       ** Close card, cannot use CloseCard procedure because it removes statuses
       ** for a feeder.  can't do this when we close an open card because the
       ** feeder might have statuses that an active card is using.
       ** Just Delete the card....
       */
       CALLPROC FMS_CardStatusUpd
                    (NewStatus = Card$Purge,
                     Card = NewCard);

       CALLPROC DDB_COMMIT;

       CALLPROC TraceError(UserMessage ='Error trying to preload moves for new FMS card. ' +
                    'Card closed to prevent further processing.',
                    TraceMessage = 'CreateFMSOpenCard - PreloadMoves failed for card = ' + 
                    VARCHAR(NewCard));
          
       RETURN 0;
    ENDIF;

    IF NewCard > 0 THEN
       /*
       ** Send new scheduled card creation to Rapid Restore.
       */
       IF NewCardClass <> Type$FOT AND NewCardClass <> Type$Auto AND
          NewCardClass <> Type$CIOA AND
          NewCardClass <> Type$OOE1 AND NewCardClass <> Type$CardClassTest THEN
    		 
          CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_CreateCard',
                     EventText = VARCHAR(NewCard));  
       ENDIF;
    ENDIF;
   /*
   **  Check for StepDown 4kv 
   */
   IF FMSCardASE.TypeofCard <> TypeOfCard$4KV AND NoStepDown = FALSE THEN
      /*
      **  Check to see if Feeder has a step down feeder associated with it
      **  using SD-VIS as the common piece of equipment that is a source
      **  breaker for a 4KV feeder.
      **  If no SDVis equipment found, then nothing more to do. 
      */
      i = 1;
      StepDownCard.Clear();
      SELECT :StepDownCard[i].Feeder = G2.Grouping       /* StepDown Feeder */
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_Grouping G2,
             Udb_Grouping G3,
             Udb_Rating R
      WHERE  C.Card = :NewCard AND
             CTO.Card = C.Card AND
             CTO.Object = G.Grouping AND 
             G.Relationship = :Interaction$MemberOf AND 
             G.MemberType = :Type$SDVIS AND 
             G.Member = G2.Member AND   /* SDVis Object on feeder */
             G2.Relationship = :Interaction$SourceBreaker AND 
             G2.Grouping = G3.Member AND
             G3.Relationship = :Interaction$RatedAs AND 
             G3.Grouping = R.Object AND
             R.Normal = :Rating$4KV
      BEGIN
         i = i + 1;
      END;
      
      FOR i = 1 TO StepDownCard.LastRow DO
         StepDownCard[i].Card = CALLPROC CreateFMSOpenCard(
                             NewCardFeeder = StepDownCard[i].Feeder,
                             NewCardClass = NewCardClass,
                             NetworkFeeder = FALSE,
                             SubstationName3G = SubstationName3G,
                             Position3G = Position3G,
                             NoStepDown = TRUE);
         /*
         **  Add link for newly created card.
         */
         IF StepDownCard[i].Card <> 0 THEN
            CALLPROC FMS_StepDownLinkIns
                    (Card = NewCard,
                     StepDownCard = StepDownCard[i].Card);
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDFOR;
   ENDIF;

   RETURN NewCard;
END;

Application Component Report
============================

	Name:            CreateISO

/*
**
**  Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CreateISO
**
**  Modifications:
**      02/04/93 em     created.
**      02/11/93 em     change naming algorithm to avoid having xxx-xx-xx
**                      which is happening if an iso is created on an iso.
**      02/11/93 em     check for equipment on this iso when coming back from transfer
**      02/14/93 em     if no equip on ISO, then close it
**      03/08/93 em     allow changes to be made to original card heading
**      01/27/94 em     update card status following card close
**      02/16/94 em     creating open iso card caused numerous problems, will
**                      create OTW card instead, then change status to active
**                      when finished with all work.  also modified iso failure
**                      when no equip transferred.
**      09/13/94 pw     created isofeeder pool that isofeeders are now created from,
**                      when isofeeders are closed they are put back into pool
**      09/30/94 hlf    make sure original frame information gets saved
**      05/16/95 pw     Don't create card using FMS_NewCardGlobal,  can cause 
**                      wrong jobs to get loaded for card.
**      06/16/96 pw     add openswitchiso parameter if call to this was trigger
**                      from connectivity_transfer screen.
**      02/10/97 pw     add check to make sure iso from pool has no active cards for it
**      08/07/02 pkw    modify for iso project.
**      08/08/02 pkw    UNCHECK 'POPUP' FEATURE FOR THIS FRAME. IF POPUP IS ENABLED, ORIGINALCARD
**                      FRAME IS HIDDEN BEHIND FEEDERCARD FRAME SINCE IT IS AN OPEN FRAME
**                      FROM THIS FRAME.
**      08/08/02 ysp    Send ISO card creation to Rapid Restore
**      09/10/02 pkw    Allow DO to enter FCR ISO from this screen also.
**      09/13/02 ysp    Merge: use common Job class.
**      01/10/03 em     Changed ISO card creation per merge design
**      01/11/03 em     InsertAltCard FMS_Card method implemented.
**      01/21/03 em     Don't log insertion of step headings in ISO card.
**      02/27/03 ysp    Group the new ISO feeder to divisions.
**      04/18/06 em     Remove call to "OriginalCard" at the request of Mike Sannito
**      05/15/06 ysp    allow the calling environment to pass in a list of equipment that
**                      is to be transferred to the ISO.
**      04/16/07 ysp    ITC210: Insert IR interface event in DB event queue
**      08/14/08 em     Call Preload Moves to get To FOD:Common Location move on card.
**      08/23/10 em     3G feeder selection
**      12/12/12 em     Group ISO with same networks as feeder, per Jon Brengel request
**      09/22/14 pkw    Also transfer non-network member of relationships
**      09/07/15 em     If main freeder has DBF status, give ISO feeder dbf status
**      08/17/16 ysp    33kv ISO cards must be linked to their main feeders. Use main feeder
**                      cards as reference if ISO are created from portion cards (equipment 
**                      will be transferred from portion feeders).
**      09/30/16 em     Modification to link ISO to main feeder always, no more ISO linked to another ISO.
**      05/11/17 em     Create ISO for 3G card not working, initial card load needs changes.
*/

INITIALIZE (
   ISOCard = FMS_Card;                             /* Card*/
   Jobs = ARRAY OF Job;                            /* Jobs*/
   ControlISO = VARCHAR(20) NOT NULL WITH DEFAULT;  /*  ISO number - optional */
   SelectEquip = ARRAY OF FMS_Equip;                /* equipment to transfer - optional */
   OpenSwitchISO = INTEGER NOT NULL WITH DEFAULT;     /*Equip on ISO*/
) =
DECLARE
   FeederObj = INTEGER NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; 
   ISONum = INTEGER NOT NULL WITH DEFAULT;                 /*New ISO Number */
   ISOCheck = INTEGER NOT NULL;            
   CheckAgain = INTEGER NOT NULL;            
   RetCode = INTEGER NOT NULL WITH DEFAULT;   /*Return Code*/
   Parse1 = INTEGER NOT NULL WITH DEFAULT;     /*Used for name parsing*/
   EquipCount = INTEGER NOT NULL WITH DEFAULT;     /*Equip on ISO*/
   i = INTEGER NOT NULL;
   OrigCard = FrameExec;
   DynamicWhereClause = VARCHAR(200) NOT NULL WITH DEFAULT;
   FeederCheck = VARCHAR(40) NOT NULL WITH DEFAULT;
   NewFMSCard = FMS_Card DEFAULT NULL;         /*Used to call FMS_Card method*/
   ControlEntry = NewMoveCard;
   SP = ARRAY OF Job;                   /*StepHeadings*/
   Divisions = ARRAY OF IntegerObject;
   RelationshipType = ARRAY OF IntegerObject;
   SimpleCard = FMS_Card_ASE DEFAULT NULL;
ENDDECLARE
BEGIN
/*
   OrigCard = OpenFrame OriginalCard (C = ISOCard);
*/
   IF ISOCard.NetworkFeeder = NetworkFeeder$33KV  AND
      ISOCard.TypeOfCard = TypeOfCard$Portion THEN
      /* 
      ** 33KV ISO Cards must be linked to main feeders not portion feeder.
      ** So, if the current card is a portion card, instantiate an FMS card object
      ** for the main feeder card and use it to create an ISO.
      */
      SELECT :IC.Card = C.Card
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :ISOCard.Card AND
             L.Card = C.Card;
      
      IF SimpleCard IS NULL THEN
         SimpleCard = FMS_Card_ASE.Create();
      ENDIF;
      
      SimpleCard.Card = IC.Card;    
      SimpleCard.ArchiveCard = FALSE;      
      SimpleCard.LoadCard();
      
      IF SimpleCard.ReturnCode <> 0 THEN
         Message 'Failed to create ISO.'  + HC_NEWLINE +
                 SimpleCard.ErrorMessage;
         RETURN;
      ENDIF;       

      IC = SimpleCard.C.Duplicate();
      SimpleCard = NULL;
      FeederObj = IC.Feeder;
      FeederName = IC.FeederName;
      
   ELSEIF ISOCard.NetworkFeeder = NetworkFeeder$3G THEN
      IC = ISOCard.Duplicate();
      FeederObj = IC.Object[1].Object;
      FeederName = IC.Object[1].Name;

      IF IC.Object.LastRow() > 1 THEN
         FIELD(NetworkFeeder).ValueList.ChoiceItems.Clear();
         FOR i = 1 TO IC.Object.LastRow() DO
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumValue = IC.Object[i].Object;
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumText = IC.Object[i].Name;
         ENDFOR;
         FIELD(NetworkFeeder).CurBias = FB_CHANGEABLE;
         /* OR5.1 FIELD(NetworkFeeder).ColumnWidthCompressed = TRUE; */
         FIELD(NetworkFeeder).UpdChoiceList();
      ENDIF;
      IC.Feeder = FeederObj;
      IC.FeederName = FeederName;   

   ELSE
      IC = ISOCard.Duplicate();
      IF ISOCard.CardClass = Type$ISO THEN
/*
** Get main feeder from ISO Feeder, could be starting from KP ISO 
*/
         SELECT :IC.Feeder = O.Object,
                :IC.FeederName = O.Name
         FROM   Udb_Object O,
                Udb_Grouping G
         WHERE  G.Member = :ISOCard.Feeder AND 
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Feeder AND
                G.Grouping = O.Object;  
      ENDIF;
      FeederObj = IC.Feeder;
      FeederName = IC.FeederName;
   ENDIF;
    
   IF ControlISO <> '' THEN
      CurFrame.SendUserEvent (EventName = 'CreateISO');
   ELSE
      CurFrame.SendUserEvent (EventName = 'PopupISOEntry');
   ENDIF;
END;

ON UserEvent 'PopupISOEntry' =
BEGIN
   FIELD(ISO_sf).AbsXLeft = FIELD(IC.FeederName).AbsXLeft;
   FIELD(ISO_sf).AbsYTop = FIELD(IC.FeederName).AbsYTop;
   FIELD(ISO_sf).CurBias = FB_CHANGEABLE;
   FIELD(OK_btn).ParentField.ParentField.CurBias = FB_VISIBLE;
END;

ON SETVALUE NetWorkFeeder =
BEGIN
   FeederObj = FIELD(NetworkFeeder).CurEnumValue;
   FeederName = FIELD(NetworkFeeder).CurEnumText;
   IC.FeederName = FIELD(NetworkFeeder).CurEnumText;
   IC.Feeder = FeederObj;
   CurFrame.SendUserEvent (EventName = 'UpdateISOName');
END;


ON CLICK ISO_sf.Continue_btn,
ON USEREVENT 'UpdateISOName' =
BEGIN
   /*
   **  Check to make sure manually entered isofeedername is not duplicated
   */
   FeederCheck = FeederName + '-' + ISO_sf.IsoNumber;
   SELECT :i = Count(*) 
   FROM   Udb_Object O 
   WHERE  O.Type = :Type$ISOfeeder AND
          O.Name = :FeederCheck;
   IF i > 0 THEN
      Message 'There is already an iso feeder by that name.';
      RESUME;
   ENDIF;

   FIELD(ISO_sf).CurBias = FB_INVISIBLE;
   FIELD(OK_btn).ParentField.ParentField.CurBias = FB_CHANGEABLE;

   ControlISO = ISO_sf.IsoNumber;
   CurFrame.SendUserEvent (EventName = 'CreateISO');      
END;

ON CLICK ISO_sf.Cancel_btn =
BEGIN
/*
**  Set IC.Feeder to zero so that connectivity_Xfer knows that cancel was pushed.
*/
   IC.Feeder = 0;
   RETURN;
END;

ON UserEvent 'CreateISO' =
BEGIN
   IF ControlISO <> '' THEN
      FIELD(IC.ISONumber).CurBias = FB_VISIBLE;
   ELSE
/*  
**  Create new ISO Name
*/
      ISONum = CALLPROC Udb_NextKey (
                   KeyName = 'ISO');
      IF ISONum < 0 THEN
/*
**  We returned an error from the nextkey proc; ignore and use
**  a default of 0.
*/
          ISONum = 0;
          CALLPROC DDB_ROLLBACK;
      ELSE
          CALLPROC DDB_COMMIT;
      ENDIF;
/*
**  IF ISO Number is 1000, set to 1; we want to recirculate numbers
**  between 1 and 999.
*/
      IF ISONum > 999 THEN
         ISONum = 1;
         CALLPROC FMS_ResetISO;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   Parse1 = locate(IC.FeederName, '-');
   IF Parse1 = (size(IC.FeederName) + 1) THEN  /* '-' not found */
      IC.FeederName = IC.FeederName + '-';
   ELSE                                        /* already an ISO */
      IC.FeederName = left(IC.FeederName, Parse1);
   ENDIF;

   IF ControlISO <> '' THEN
      IC.ISONumber = ControlISO;
   ELSE
      IC.ISONumber = varchar(:ISONum);
      IC.FeederName = IC.FeederName + 'D';
   ENDIF;

   FIELD(IC.FeederName).TextValue = IC.FeederName;
   IC.Feeder = 0;
END;

ON Click Cancel_Btn,
ON Click OK_Btn =
BEGIN
/*
**  Check to see whether or not the original card data needs to be saved.
*/
    
    IF (Curframe.TriggerField = FIELD(OK_Btn)) THEN
        OrigCard.SendUserEvent (EventName = 'UpdateCard');
        Curframe.SendUserEvent (EventName = 'ContinueOK_Btn');
    ELSE
        OrigCard.SendUserEvent (EventName = 'ExitFrame');
        Curframe.SendUserEvent (EventName = 'ContinueCancel_Btn');
    ENDIF;
END;

/*
**  Save this ISO and Open New Card.
**  Will Create ISO Feeder Object, Group with parent Feeder,  Feeder's
**  Division, and carry forth Controlled By Desk.  Open New Card and 
**  call Transfer Program.
*/

ON UserEvent 'ContinueOK_Btn' = 
BEGIN
   IF IC.ISONumber = '' THEN
      Message 'You have not entered an ISOfeeder name';
      Resume;
   ENDIF;
   
   IC.FeederName = IC.FeederName + IC.ISONumber;
   /*
   **  Check to make sure manually entered isofeedername is not duplicated
   */
   SELECT :i = Count(*) 
   FROM   Udb_Object O 
   WHERE  O.Type = :Type$ISOfeeder AND
          O.Name = :IC.FeederName;
   IF i > 0 THEN
      Message 'There is already an isofeeder by that name.';
      RESUME;
   ENDIF;

   IF IC.Feeder = 0 THEN    /* Only get one Object number */
/* 
** Add check to see if there is an active card for IsoNum that was selected.
** If there was get the next highest one until we find one that is not active.
** We will log this event for a card called -9999.
*/
      ISONum = 0;
      CheckAgain = TRUE;
      WHILE CheckAgain = TRUE DO
         CheckAgain = FALSE;
         DynamicWhereClause = 'D.Type = ' + varchar(:Type$IsoFeeder) + ' AND ' +
                              'varchar(D.Object) = D.Name AND ' +
                              'D.Object > ' + varchar(:ISONum);
         SELECT :ISONum = IFNULL(Object,0)
         FROM   UDB_OBJECT O
         WHERE  O.Object = (SELECT  MIN(Object)
                            FROM    UDB_OBJECT D
                            WHERE  :DynamicWhereClause
                            );
         IF ISONum = 0 THEN
            Message 'Can not create ISOFeeder.  The ISOFeeder pool is full,  a isofeeder' +
                    ' must be removed before you can create another.  Please contact ' +
                    'technical support.';
            RESUME;
         ENDIF;
      
         ISOCheck = 0;
         SELECT :ISOCheck = C.Card
         FROM   FMS_Card C,
                SOA_ActiveCard AC
         WHERE  C.Feeder = :ISONum AND
                C.Card = AC.Card;
         CALLPROC DDB_ROLLBACK;

         IF ISOCheck <> 0 THEN
            CALLPROC SOA_LogIns (Card = -9999,
                                 Job  = NULL,
                                 SwitchingItem = 0,
                                 Time = DATE('Now'), 
                                 UserName = UserName,
                                 Item = 'Duplicate ISO',
                                 Old  = 'Old Card number: ' + varchar(ISOCheck),
                                 New  = 'New Feedername: ' + IC.FeederName + ' Feeder: ' +
                                        varchar(ISONum));
            CALLPROC DDB_COMMIT;
     
            CheckAgain = TRUE;
         ENDIF;
      ENDWHILE;

      IC.Feeder = ISONum;
/*
**  Update object table now so that if someone else is creating a isofeeder
**    at this time they will not get same object from isofeeder pool.
*/
      RetCode = CALLPROC Udb_ObjectUpd (
                  Object  = IC.Feeder,
                  Name    = IC.FeederName,
                  Type    = Type$ISOFeeder,
                  PrimaryGrouping = Unused$ISOFeeder);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to Create ISO Feeder.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT; 
   ENDIF;
/*
** group the ISO feeder to divisions here before creating the iso card
** so that the iso card is inserted into soa_activecard table. This is
** necessary for the job actions to work properly.
*/
   i = 1;
   Divisions.Clear();
   SELECT :Divisions[i].Value = Grouping
   FROM   Udb_Grouping 
   WHERE  Member = :FeederObj AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$Division
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Divisions.LastRow() DO  
      RetCode = CALLPROC Udb_GroupingIns (
                             SystemVersion = 0,
                             Grouping = Divisions[i].Value,
                             GroupingType = Type$Division,
                             Member = IC.Feeder, 
                             MemberType = Type$ISOFeeder,
                             Relationship = Interaction$MemberOf);
      IF RetCode < 0 THEN 
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to group the ISO feeder to the division.';
         RESUME;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;                     
/*
** group the ISO feeder to networks here reusing Divisions field.
*/
   i = 1;
   Divisions.Clear();
   RelationshipType.Clear();
   SELECT :Divisions[i].Value = Grouping,
          :RelationshipType[i].Value = Relationship
   FROM   Udb_Grouping 
   WHERE  Member = :FeederObj AND
          Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) AND
          GroupingType = :Type$Network
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Divisions.LastRow() DO  
      RetCode = CALLPROC Udb_GroupingIns (
                             SystemVersion = 0,
                             Grouping = Divisions[i].Value,
                             GroupingType = Type$Network,
                             Member = IC.Feeder, 
                             MemberType = Type$ISOFeeder,
                             Relationship = RelationshipType[i].Value);
      IF RetCode < 0 THEN 
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to group the ISO feeder to the network.';
         RESUME;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;                     
   /*
   **   Build new card 
   */
   NewFMSCard = NULL;
   NewFMSCard = FMS_Card.Create();
   NewFMSCard.Card = 0;
   NewFMSCard.Application = Application$FMS;
   NewFMSCard.CardClass = Type$ISO;
   NewFMSCard.Status = Card$OutToWork;
   NewFMSCard.TypeOfCard = Type$ISOCard;
   NewFMSCard.Validated = IC.Validated;
   NewFMSCard.Feeder = IC.Feeder;
   NewFMSCard.FeederName = IC.FeederName;
   NewFMSCard.SubstationName = 'ISOLATED HOLDOFF';
   NewFMSCard.Position = IC.Position;
   NewFMSCard.Loop1 = IC.Loop1;
   NewFMSCard.Loop2 = IC.Loop2;
   NewFMSCard.Loop3 = IC.Loop3;
   NewFMSCard.Loop4 = IC.Loop4;
   NewFMSCard.Assoc = IC.Assoc;

   NewFMSCard.InsertAltCard();
 
   IF NewFMSCard.Card = 0 THEN
      RetCode = CALLPROC Udb_ObjectUpd (
                  Object  = IC.Feeder,
                  Name    = varchar(IC.Feeder),
                  Type    = Type$ISOFeeder,
                  PrimaryGrouping = Unused$ISOFeeder);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to put ISOFeeder back into pool - ' +
                 'please contact technical support.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT; 
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Preload step headings and any generic moves.
*/
   RetCode = CALLFRAME PreloadMoves (
                    Card = NewFMSCard.Card,
                    TypeofCard = Type$ISOCard,        
                    Feeder = IC.Feeder,    
                    CardClass  = Type$ISO);

   IF RetCode = PU_CANCEL THEN  
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Preload of additional moves failed.  Moves will have to be manually added.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;         
/*
**  If we were creating an openswitchiso then we will return here
**  so that the equipment will be transferred properly.  Open switches
**  need to become common.
*/
   IF OpenSwitchISO = TRUE THEN
      RETURN;
   ENDIF;

   IF SelectEquip.LastRow > 0 THEN
      CALLFRAME TransferTo (
              C = ISOCard,
              ISOFeeder = FeederObj,
              ISOFeederName = FeederName,
              DestinationFeeder = IC.Feeder,
              Jobs = Jobs,
              SelectEquip = SelectEquip);
   ELSE
      CALLFRAME TransferTo (
              C = ISOCard,
              ISOFeeder = FeederObj,
              ISOFeederName = FeederName,
              DestinationFeeder = IC.Feeder,
              Jobs = Jobs);
   ENDIF;
/*
** If no equipment transferred to this iso, then we should close it
** and forget about it.
*/
   SELECT :EquipCount = COUNT(*)
   FROM   Udb_Grouping
   WHERE  Grouping = :IC.Feeder AND
          Relationship = :Interaction$MemberOf AND
          MemberType IN (SELECT Type
                         FROM   Udb_ExtendedType
                         WHERE  SuperType = :Type$Switch);

   IF EquipCount = 0 THEN
      RetCode = CALLPROC Udb_GroupingMemberDel(Member = IC.Feeder);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove ISO feeder from division grouping -' +
                 'please contact technical support.';
      ENDIF;
      CALLPROC DDB_COMMIT; 

      RetCode = CALLPROC Udb_ObjectUpd (
                  Object  = IC.Feeder,
                  Name    = varchar(IC.Feeder),
                  Type    = Type$ISOFeeder,
                  PrimaryGrouping = Unused$ISOFeeder);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to put ISOFeeder back into pool - ' +
                 'please contact technical support.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT; 

      CALLPROC FMS_CardStatusUpd (
           NewStatus = Card$Purge,
           Card      = NewFMSCard.Card);
      CALLPROC DDB_COMMIT;
      Message 'No Equipment transferred to ISO Card.  Create ISO Card cancelled.';

   ELSE

      RetCode = CALLPROC FMS_CreateIsofeeder 
             (NewFeederName = IC.FeederName,
              NewFeederType = Type$ISOFeeder,
              NewFeeder = IC.Feeder,
              PoolHeader = Unused$Isofeeder,
              Feeder = FeederObj,
              Division = Type$Division,
              MemberOf = Interaction$MemberOf,
              ControlledBy = Interaction$ControlledBy,
              DeskType = Type$OperatorDesk
              );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to create Isofeeder,  please try again.';

         RetCode = CALLPROC Udb_ObjectUpd (
                     Object  = IC.Feeder,
                     Name    = varchar(IC.Feeder),
                     Type    = Type$ISOFeeder,
                     PrimaryGrouping = Unused$ISOFeeder);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to put ISOFeeder back into pool - ' +
                    'please contact technical support.';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT; 
         /*
         **   set status of temporary card to Card$Purge 
         */
         RetCode = CALLPROC FMS_CardStatusUpd
                            (NewStatus = Card$Purge,
                             Card = NewFMSCard.Card);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to remove temporary isofeeder Card.';
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;  
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RetCode = CALLPROC FMS_ActivateCard 
          (Status = Card$Active,
           Activated = DATE('now'),
           Card      = NewFMSCard.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Activate ISO card.  Look in the Open Card list.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

      CALLPROC SOA_LogIns (Card = NewFMSCard.Card,
                           Job  = NULL,
                           SwitchingItem = 0,
                           Time = DATE('Now'), 
                           UserName = UserName,
                           Item = 'ISO',
                           Old  = '',
                           New  = 'Card Created/Activated');
      CALLPROC DDB_COMMIT;
     
      RetCode = CALLPROC ForceStatus (Feeder = IC.Feeder,
                                      NewStatus = Status$CO);     
      IF RetCode = PU_CANCEL THEN
          CALLPROC DDB_ROLLBACK;
          Message 'Error trying to set Cut Out Feeder Status.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      
      i = 0;
      SELECT :i = Status 
      FROM   FMS_ObjectStatus
      WHERE  Object = :FeederObj AND
             Status = :Status$DBF AND
             StatusCount > 0;
      IF i = Status$DBF THEN
         RetCode = CALLPROC ForceStatus (Feeder = IC.Feeder,
                                         NewStatus = Status$DBF);     
         IF RetCode = PU_CANCEL THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error trying to set DBFFeeder Status.';
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_CreateCard',
                     EventText = VARCHAR(NewFMSCard.Card));  
   ENDIF;

   CALLPROC DDB_COMMIT;
   RETURN;
END;


ON UserEvent 'ContinueCancel_Btn' =
BEGIN
/*
**  Set IC.Feeder to zero so that connectivity_Xfer knows that cancel was pushed.
*/
   IC.Feeder = 0;
   RETURN;
END;
				 *Default Item


Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            CreateKnownPointSplice

/*
**
**	Copyright c 2009 Pateric Software LLC  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CreateKnownPointSplice
**
**  Modifications:
**      03/23/09 em     Created by modifying CreateSubFeeder.
**      04/21/09 em     Changes based on Mike's review; add SelectEquip
**                      parm to enable use from FCR_ReturnOptions in CAC 
**      05/21/09 em     Corrected misbehavior to to mistyped SB title
**      08/13/09 em     For SB, include only DMSF6-Switch devices in the list
**      08/31/09 em     Do not CutOut any KPS card here, all CutOut moved to CutIn
**                      of main feeder. 
**      09/11/09 em     Trigger CreateCard DBevent upon card activation.
**      05/11/11 em     Include Vacuum Switch in SB list and CamDisc in SP list
**      06/20/12 em     Re-enable CutOut but only for scheduled card types.
**      11/28/12 em     Include DM-VAC Source in Scheduled card cutout list
**      08/13/13 em     Modify to also support Sectionalized Feeder creation
**      10/10/13 pkw    When creating sectionalized feeder carry over feeder status
**                      to new card.
**      09/22/14 pkw    Copy network and non-network relationships when creating 
**                      known point slice.
**      11/12/14 pkw    Don't carry over Station Grounds and grounds when creating 
**                      new sectionalized card.
**      12/01/14 pkw    Don't copy over c/o status because it gets created as part
**                      of the creation of the card.
**      04/27/15 pkw    Transfer RFP and workpermit if necessary.
**      05/03/15 pkw    Change select in rfp_xferlink procedure.
**      09/07/15 em     If main feeder has DBF status, give KPS feeder dbf status
**      10/06/16 pkw    If main feeder has caution status, insert caution move on KPS Card.
**      12/30/19 em		Include DMEaton in DMSF6 type list
**      01/08/23 em     Remove FastSw type and limit Source Breaker list to currently open devices. 
*/
INITIALIZE (
   C = FMS_Card;                        /*Passed Card*/
   Jobs = ARRAY OF Job;                   /*Passed Jobs*/
   ISOEquip = ARRAY OF FMS_Equip;         /*Pass Thru array of ISO Equip */ 
   SectionalFeeder = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parameter*/

#  include StandardDeclarations
   j = INTEGER NOT NULL;
   DBEventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   DMSF6Type = INTEGER NOT NULL WITH DEFAULT;
   SubCardClass = INTEGER NOT NULL;
   Subfeeder = INTEGER NOT NULL;
   SubfeederType = INTEGER NOT NULL;
   SubfeederName = VARCHAR(40) NOT NULL;
   SourcePosEquip = FMS_Equip;
   SourceBkrEquip = FMS_Equip;
   Substation = INTEGER NOT NULL;
   Desk = INTEGER NOT NULL;
   EquipCount = INTEGER NOT NULL;
   FeederType = INTEGER NOT NULL;
   Division = ARRAY OF IntegerObject;
   Alphabet = VARCHAR(26) NOT NULL;
   TemporarySubstation = INTEGER NOT NULL WITH DEFAULT;
   Parse = INTEGER NOT NULL;
   OrigCard = FrameExec;
   NewFMSCard = FMS_Card DEFAULT NULL;         /*Used to call FMS_Card method*/
   ControlEntry = NewMoveCard;
   SP = ARRAY OF Job;                   /*StepHeadings*/
   Divisions = ARRAY OF IntegerObject;
   RelationshipType = ARRAY OF IntegerObject;
   OpenSF6 = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   MessageText  = VARCHAR(256) NOT NULL WITH DEFAULT;
   FdrStatus = ARRAY OF FeederStatus;
   SelectCount = INTEGER NOT NULL;
   ProcessCount = INTEGER NOT NULL;
   ProcessWindow = FrameExec;            
) =
DECLARE
   RFP_XferLink = PROCEDURE;
   InsertCaution = PROCEDURE;
ENDDECLARE
BEGIN
   FIELD(SBTitle).TextValue = 'Step 1: Select the Source Breaker';
   IF SectionalFeeder = TRUE THEN 
      FIELD(HeaderTrim).TextValue = 'Create Sectionalized Feeder Card';
      CurFrame.WindowTitle = 'Create Sectionalized Feeder';
      SubFeederType = Type$SectionalFeeder;
      SubCardClass = C.CardClass;
      MessageText = 'Sectional Feeder ';
   ELSE
      SubFeederType = Type$KPSFeeder;
      SubCardClass = Type$ISO;
      MessageText = 'KPS Feeder ';
   ENDIF;
/*
** IF SelectedSB received as a parm then we are passing through from 
** FCR_ReturnOptions with a KPS.
*/
   IF SelectedSB.Equip <> 0 THEN
      SelectedSP = SelectedSB;
      SubFeederType = Type$KPSFeeder;
      MessageText = 'KPS Feeder ';
      CurFrame.SendUserEvent (EventName = 'KPSContinue');
   ELSE   

      SelectEquip.Clear();	/* Clear out storage */ 
      i = 1; 
      REPEATED
      SELECT  :SelectEquip[i].Equip = O.Object,  
           :SelectEquip[i].EquipName = O.Name, 
           :SelectEquip[i].EquipClass  = O.Type, 
           :SelectEquip[i].EquipClassName  = O.TypeName, 
           :SelectEquip[i].PrintID = G.Reference, 
           :SelectEquip[i].Origin = O.Ownernumber 
      FROM   Udb_Object O,  
             Udb_Grouping G,
             Udb_Switch S  
      WHERE  G.Grouping = :C.Feeder AND
             G.Member = O.Object AND 
             O.Object = S.Object AND
             S.CurrentlyOpen = 1 AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType IN (SELECT Type
                            FROM  Udb_ExtendedType
                            WHERE  SuperType IN (:Type$DMSF6Switch,
                                                 :Type$DMEaton,
                                                 :Type$KPS,
                                                 :Type$DMVac))
      ORDER BY PrintID, EquipName 
      BEGIN 
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;

      IF i = 1 THEN
         MESSAGE 'Feeder ' + C.FeederName + ' does not have any Open' +
                 'DMSF6 type source equipment.';
         RETURN;
      ENDIF;
   ENDIF;
END;


ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
/*
** IF DM-SF6 or DMVac chosen, prompt to select Source Position otherwise use same.
*/
   IF FIELD(SBTitle).TextValue = 'Step 1: Select the Source Breaker' THEN
      SelectedSB = SelectEquip[];
      
      DMSF6Type = 0;
      SELECT :DMSF6Type = Type
      FROM   Udb_ExtendedType
      WHERE  Type = :SelectedSB.EquipClass AND
             SuperType IN (:Type$DMSF6, :Type$DMEaton, :Type$DMVac);

      IF DMSF6Type <> 0 THEN
         FIELD(SBTitle).TextValue = 'Step 2: Select the Source Position';
         FIELD(SBTitle).BgColor = CC_PALE_GREEN;

         SelectEquip.Clear();	/* Clear out storage */ 
         i = 1; 
         REPEATED
         SELECT  :SelectEquip[i].Equip = O.Object,  
           :SelectEquip[i].EquipName = O.Name, 
           :SelectEquip[i].EquipClass  = O.Type, 
           :SelectEquip[i].EquipClassName  = O.TypeName, 
           :SelectEquip[i].PrintID = G.Reference, 
           :SelectEquip[i].Origin = O.Ownernumber 
         FROM    Udb_Object O,  
                 Udb_Grouping G  
         WHERE   G.Grouping = :C.Feeder AND
           G.Member = O.Object AND 
           G.Relationship = :Interaction$MemberOf AND
           G.MemberType IN (SELECT Type
                            FROM  Udb_ExtendedType
                            WHERE  SuperType IN (:Type$DMSF6,
                                                 :Type$DMEaton,
                                                 :Type$KPS,
                                                 :Type$DMVac,
                                                 :Type$CamDisc))
         ORDER BY PrintID, EquipName 
         BEGIN 
            i = i + 1; 
         END; 
      ELSE
         SelectedSP = SelectedSB;
         CurFrame.SendUserEvent (EventName = 'KPSContinue');
      ENDIF;
   ELSE
      SelectedSP = SelectEquip[];
      FIELD(SBTitle).TextValue = 'Step 1: Select the Source Breaker';
      FIELD(SBTitle).BgColor = CC_PALE_PURPLE;

         SelectEquip.Clear();	/* Clear out storage */ 
         i = 1; 
         REPEATED
         SELECT  :SelectEquip[i].Equip = O.Object,  
           :SelectEquip[i].EquipName = O.Name, 
           :SelectEquip[i].EquipClass  = O.Type, 
           :SelectEquip[i].EquipClassName  = O.TypeName, 
           :SelectEquip[i].PrintID = G.Reference, 
           :SelectEquip[i].Origin = O.Ownernumber 
         FROM    Udb_Object O,  
                 Udb_Grouping G,
             Udb_Switch S  
         WHERE  G.Grouping = :C.Feeder AND
             G.Member = O.Object AND 
             O.Object = S.Object AND
             S.CurrentlyOpen = 1 AND  
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType IN (SELECT Type
                            FROM  Udb_ExtendedType
                            WHERE  SuperType IN (:Type$DMSF6Switch,
                                                 :Type$DMEaton,
                                                 :Type$KPS,
                                                 :Type$DMVac))
         ORDER BY PrintID, EquipName 
         BEGIN 
            i = i + 1; 
         END; 

      CurFrame.SendUserEvent (EventName = 'KPSContinue');
   ENDIF;
END; 


ON USEREVENT 'KPSContinue' =
BEGIN
   OrigCard = OpenFrame OriginalCard (C = C);

   Alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
   SubC = C.Duplicate();
   /*  
   **    Create new Subfeeder Name
   */
   Parse = locate(SUBC.FeederName, '-');
   IF Parse < (size(SUBC.FeederName) + 1) THEN  /* '-' found */
      SUBC.FeederName = left(SUBC.FeederName,(Parse - 1));
   ENDIF;

   IF SubFeederType = Type$KPSFeeder THEN
/*
** Squeeze first '-' out of equip name
** Extract second '-' out of equip name with all that follows
*/
      i = LOCATE(SelectedSB.EquipName,'-');
      IF i < (SIZE(SelectedSB.EquipName) + 1) THEN
         SubFeederName = LEFT(SelectedSB.EquipName, (i-1)) + SHIFT(SelectedSB.EquipName, (i*-1));
         j = LOCATE(SubFeederName,'-');
         IF j < (SIZE(SubFeederName) + 1) THEN
            SubFeederName = SubC.FeederName + '-' + LEFT(SubFeederName,(j-1));
         ELSE
            SubFeederName = SubC.FeederName + '-' + SubFeederName;
         ENDIF;
      ELSE
         SubFeederName = SubC.FeederName + '-' + SelectedSB.EquipName;
      ENDIF;
   ELSE
      SubfeederName = SubC.FeederName + '-' + charextract(Alphabet,1);
   ENDIF;

   i = 1;
   j = 1;
   WHILE i > 0 DO
      SELECT :i = Count(*) 
      FROM   Udb_Object O, 
             Udb_ExtendedType ET 
      WHERE  ET.SuperType = :Type$Subfeeder AND
             ET.Type = O.Type AND
             O.Name = :SubfeederName;
      CALLPROC DDB_ROLLBACK;
      IF i = 0 THEN
         ENDLOOP;
      ELSE
         j = j + 1;
         IF SubFeederType = Type$KPSFeeder THEN
            SubfeederName = SubC.FeederName + '-' + 
                            SelectedSB.EquipName + '-' + charextract(Alphabet,j);
         ELSE
            SubfeederName = SubC.FeederName + '-' + charextract(Alphabet,j);
         ENDIF;
      ENDIF;
   ENDWHILE; 
   SubC.FeederName = SubfeederName;
   SubC.Comment = 'This feeder is split at: ' + SelectedSB.EquipName;
END;

ON Click Cancel_Btn,
ON Click OK_Btn =
BEGIN
/*
**  Check to see whether or not the original card data needs to be saved.
*/
    IF (Curframe.TriggerField = FIELD(OK_Btn)) THEN
        IF SelectedSB.Equip = 0 OR SelectedSP.Equip = 0 THEN
           MESSAGE 'Please select the Source Breaker and Source Position.';
           RESUME;
        ENDIF;
        OrigCard.SendUserEvent (EventName = 'UpdateCard');
        Curframe.SendUserEvent (EventName = 'ContinueOK_Btn');
    ELSE
        OrigCard.SendUserEvent (EventName = 'ExitFrame');
        Curframe.SendUserEvent (EventName = 'ContinueCancel_Btn');
    ENDIF;
END;
/*
**  OK click means save this Subfeeder and Open New Card.
**  Will Update SubFeeder Object, Group with parent Feeder,  Feeder's
**  Division, and carry forth Controlled By Desk.  Open New Card and 
**  call Transfer Program.
*/
ON UserEvent 'ContinueOK_Btn' =
BEGIN

   IF SubC.Feedername = '' THEN
      Message 'You have not entered a subfeeder name';
      Resume;
   ENDIF;
   /*
   **  Check to make sure manually entered subfeedername is not duplicated
   */
   SELECT :i = Count(*) 
   FROM   Udb_Object O, 
          Udb_ExtendedType ET 
   WHERE  ET.SuperType = :Type$Subfeeder AND
          ET.Type = O.Type AND
          O.Name = :SubC.FeederName;
   IF i > 0 THEN
      Message 'There is already a subfeeder by that name.';
      RESUME;
   ENDIF;

   SubFeeder = 0;
   SELECT SubFeeder = IFNULL(Object,0)
   FROM   UDB_OBJECT O
   WHERE  O.Object = (SELECT  MIN(Object)
                      FROM    UDB_OBJECT D
                      WHERE   D.Type = :Type$SubFeeder and
                              varchar(D.Object) = D.Name);
   CALLPROC DDB_ROLLBACK;

   IF SubFeeder = 0 THEN
      Message 'Can not create subfeeder.  The subfeeder pool is full,  a subfeeder' +
              ' must be removed before you can create another.  Please contact ' +
              'technical support.';
      RESUME;
   ENDIF;

   /*
   **  Update object table now so that if someone else is creating a subfeeder
   **    at this time they will not get same object from subfeeder pool.
   */
   RetCode = CALLPROC FMS_ReturnObject
                       (Object = SubFeeder,
                        Description = SubC.Assoc,
                        Primarygrouping = Type$SubfeederPool,
                        Type = SubFeederType,
                        Name = SubFeederName);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to Create SubFeeder.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT; 
/*
** group the subfeeder to divisions here before creating the new card
** so that the new card is inserted into soa_activecard table. This is
** necessary for the job actions to work properly.
*/
   i = 1;
   Divisions.Clear();
   SELECT :Divisions[i].Value = Grouping
   FROM   Udb_Grouping 
   WHERE  Member = :C.Feeder AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$Division
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Divisions.LastRow() DO  
      RetCode = CALLPROC Udb_GroupingIns (
                             SystemVersion = 0,
                             Grouping = Divisions[i].Value,
                             GroupingType = Type$Division,
                             Member = SubFeeder,
                             MemberType = SubfeederType,
                             Relationship = Interaction$MemberOf);
      IF RetCode < 0 THEN 
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to group the subfeeder to the divisions.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;                     
   ENDFOR;
/*
** group the Sub feeder to networks here reusing Divisions field.
*/
   i = 1;
   Divisions.Clear();
   RelationshipType.Clear();
   SELECT :Divisions[i].Value = Grouping,
          :RelationshipType[i].Value = Relationship
   FROM   Udb_Grouping 
   WHERE  Member = :C.Feeder AND
          Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) AND
          GroupingType = :Type$Network
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Divisions.LastRow() DO  
      RetCode = CALLPROC Udb_GroupingIns (
                             SystemVersion = 0,
                             Grouping = Divisions[i].Value,
                             GroupingType = Type$Network,
                             Member = SubFeeder, 
                             MemberType = SubFeederType,
                             Relationship = RelationshipType[i].Value);
      IF RetCode < 0 THEN 
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to group the subfeeder to the network.';
         RESUME;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;                     

   /*
   **   Build new card 
   */
   NewFMSCard = NULL;
   NewFMSCard = FMS_Card.Create();
   NewFMSCard.Card = 0;
   NewFMSCard.Application = Application$FMS;
   NewFMSCard.CardClass = SubCardClass;
   NewFMSCard.Status = Card$OutToWork;
   NewFMSCard.TypeOfCard = SubC.TypeOfCard;
   NewFMSCard.Validated = SubC.Validated;
   NewFMSCard.Feeder = SubFeeder;
   NewFMSCard.FeederName = SubC.FeederName;
   NewFMSCard.SubstationName = SubC.SubstationName;
   NewFMSCard.Position = SubC.Position;
   NewFMSCard.Loop1 = SubC.Loop1;
   NewFMSCard.Loop2 = SubC.Loop2;
   NewFMSCard.Loop3 = SubC.Loop3;
   NewFMSCard.Loop4 = SubC.Loop4;
   NewFMSCard.Assoc = SubC.Assoc;

   NewFMSCard.InsertAltCard();

   FMS_NewCardGlobal = NewFMSCard.Card;
 
   IF FMS_NewCardGlobal = 0 THEN
      CALLPROC DDB_ROLLBACK;
      RetCode = CALLPROC FMS_ReturnObject
                          (Object = SubFeeder,
                           Description = '',
                           Primarygrouping = Type$SubfeederPool,
                           Type = Type$Subfeeder,
                           Name = varchar(SubFeeder));
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to put SubFeeder back into pool - ' + 
                 'please contact technical support.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT; 

      Message 'Unable to Create Subfeeder Card.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;  
   /*
   **   Create Step Headings for new card
   */
   i = 1;
   SP.Clear();
   REPEATED 
   SELECT  :SP[i].StepPair = StepPair,
           :SP[i].TOMove = Name
   FROM    FMS_StepPair
   WHERE   TypeOfCard = :Type$13kVCard 
   BEGIN
      SP[i].Job = -1;
      SP[i].MoveCategory = MoveCategory$StepHeading;
      SP[i].JobClass = 0;
      SP[i].Substation = 0;
      SP[i].Equip = 0;
      SP[i].EquipClass = 0;
      i = i + 1;
   END;
/*
** Insert Step Headings
*/   
   FOR i = 1 TO SP.LastRow() DO

      SP[i].Job = SP[i].InsertJob (Card = FMS_NewCardGlobal);

      IF SP[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error: CreateSubFeeder - ' +
                 'Failure inserting step headings into SubFeeder Card.';
         ENDLOOP;
      ENDIF;

      ControlEntry.Card = FMS_NewCardGlobal;
      ControlEntry.Seq = 0;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$FMS;
      ControlEntry.StepHeading = SP[i].StepPair;
      ControlEntry.TypeOfCard = Type$13kVCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = SP[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = FMS_NewCardGlobal);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error: CreateSubFeeder - ' +
                 'Failure inserting step headings into SubFeeder Card.';
         ENDLOOP;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

   SourcePosEquip = SelectedSP;
   SourceBkrEquip = SelectedSB;
   IF ISOEquip.LastRow() > 0 THEN   
      CALLFRAME TransferTo (
              C = C,
              DestinationFeeder = SubFeeder,
              Jobs = Jobs,
              CreateSubFeederFLG = TRUE,
              EquipSubstation = byref(SourcePosEquip),
              BreakerEquip = byref(SourceBkrEquip),
              TempSubstation = byref(TemporarySubstation),
              KPS_SB = SelectedSB,
              KPS_SP = SelectedSP,
              SubFeederType = SubFeederType,
              SelectEquip = ISOEquip);
   ELSE
      CALLFRAME TransferTo (
              C = C,
              DestinationFeeder = SubFeeder,
              Jobs = Jobs,
              CreateSubFeederFLG = TRUE,
              EquipSubstation = byref(SourcePosEquip),
              BreakerEquip = byref(SourceBkrEquip),
              TempSubstation = byref(TemporarySubstation),
              KPS_SB = SelectedSB,
              KPS_SP = SelectedSP,
              SubFeederType = SubFeederType);
   ENDIF;
   /*
   ** If no equipment transferred to subfeeder, then we should close it
   ** and forget about it.
   */
   SELECT :EquipCount = COUNT(*)
   FROM   Udb_Grouping
   WHERE  Grouping = :SubFeeder AND
          Relationship = :Interaction$MemberOf AND
          MemberType IN (SELECT Type
                         FROM   Udb_ExtendedType
                         WHERE  SuperType = :Type$Switch);

   IF EquipCount = 0 THEN
      Message 'No Equipment transferred to Subfeeder.  Create Subfeeder cancelled.';

      RetCode = CALLPROC Udb_GroupingMemberDel(Member = SubFeeder);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove subfeeder from division grouping -' +
                 'please contact technical support.';
      ENDIF;
      CALLPROC DDB_COMMIT; 

      RetCode = CALLPROC FMS_ReturnObject
                          (Object = SubFeeder,
                           Description = '',
                           Primarygrouping = Type$SubfeederPool,
                           Type = Type$Subfeeder,
                           Name = varchar(SubFeeder));
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to put SubFeeder back into pool - ' + 
                 'please contact technical support.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT; 

      IF TemporarySubstation <> 0 THEN
         RetCode = CALLPROC FMS_ReturnObject (
                     Object  = TemporarySubstation,
                     Description = '',
                     Name    = varchar(TemporarySubstation), 
                     Type    = Type$TempSubstation, 
                     PrimaryGrouping = Unused$TempSubstation);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to put temporary substation back into pool - ' + 
                    'please contact technical support.';
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT; 
      ENDIF;

      /*
      **   set status of temporary card to Card$Purge so that next time a subfeeder is 
      **   created there won't be an active card for it.
      */
      RetCode = CALLPROC FMS_CardStatusUpd
                         (NewStatus = Card$Purge,
                          Card = FMS_NewCardGlobal);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove temporary Subfeeder Card.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;  
      FMS_NewCardGlobal = C.Card;
      RETURN;
   ENDIF;

   RetCode = CALLPROC FMS_CreateSubfeeder 
          (NewFeederName = SubFeederName,
           NewFeederType = SubfeederType,
           NewFeeder = SubFeeder,
           Comment = SubC.Comment,
           PoolHeader = Type$SubfeederPool,
           Feeder = C.Feeder,
           FeederType = Type$Feeder,
           SubStation = SourceBkrEquip.Substation,
           Division = Type$Division,
           MemberOf = Interaction$MemberOf,
           LocatedWith = Interaction$LocatedWith,
           ControlledBy = Interaction$ControlledBy,
           DeskType = Type$OperatorDesk,
           SourcePosition = Interaction$SourcePosition,
           SourceBreaker = Interaction$SourceBreaker,
           SourcePosEquip = SourcePosEquip.Equip,
           SourceBkrEquip = SourceBkrEquip.Equip,
           SourcePosEquipType = SourcePosEquip.EquipClass
           );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to create Subfeeder,  please try again.';
      RetCode = CALLPROC FMS_ReturnObject
                          (Object = SubFeeder,
                           Description = '',
                           Primarygrouping = Type$SubfeederPool,
                           Type = Type$Subfeeder,
                           Name = varchar(SubFeeder));
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to put SubFeeder back into pool - ' + 
                 'please contact technical support.';
      ENDIF;
      CALLPROC DDB_COMMIT; 

      IF TemporarySubstation <> 0 THEN
         RetCode = CALLPROC FMS_ReturnObject (
                     Object  = TemporarySubstation,
                     Description = '',
                     Name    = varchar(TemporarySubstation), 
                     Type    = Type$TempSubstation, 
                     PrimaryGrouping = Unused$TempSubstation);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to put temporary substation back into pool - ' + 
                    'please contact technical support.';
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT; 
      ENDIF;

      /*
      **   set status of temporary card to Card$Purge so that next time a subfeeder is 
      **   created there won't be an active card for it.
      */
      RetCode = CALLPROC FMS_CardStatusUpd
                         (NewStatus = Card$Purge,
                          Card = FMS_NewCardGlobal);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove temporary Subfeeder Card.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;  
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Update location address in location table 
   */          
   RetCode = CALLPROC Udb_LocationUpd
                      (Object = Subfeeder,
                       L_Object = SubFeeder,
                       Combination = '',
                       Phone = '',
                       Contact = '',
                       L1 = SubC.Loop1,
                       L2 = SubC.Loop2,
                       L3 = SubC.Loop3,
                       L4 = SubC.Loop4);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to save location for subfeeder.';
   ENDIF;
   CALLPROC DDB_COMMIT;

   /*
   **  Update top of card
   */          
   RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'substationname',
                                     NewValue = SourceBkrEquip.Description,
                                     MatchCard = FMS_NewCardGlobal);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to update substation name at top of card.';
      RESUME;
   ELSE
            CALLPROC SOA_LogIns (
                 Card = FMS_NewCardGlobal,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'SubstationName',
                 Old  = C.SubstationName,
                 New  = SourceBkrEquip.Description);
            CALLPROC DDB_COMMIT;
   ENDIF;
   CALLPROC DDB_COMMIT;
  
   RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'position', 
                                         NewValue = SourceBkrEquip.EquipName,
                                         MatchCard = FMS_NewCardGlobal); 
   IF RetCode < 0 THEN 
      CALLPROC DDB_ROLLBACK; 
      Message 'Unable to update source position at top of card.'; 
      RESUME; 
   ELSE
            CALLPROC SOA_LogIns (
                 Card = FMS_NewCardGlobal,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Position',
                 Old  = C.Position,
                 New  = SourceBkrEquip.EquipName);
            CALLPROC DDB_COMMIT;
   ENDIF; 
   CALLPROC DDB_COMMIT; 
   /* 
   **   set status of card to Card$Active 
   */ 
   RetCode = CALLPROC FMS_ActivateCard (Status = Card$Active,
                                        Activated = DATE('now'), 
                                        Card = FMS_NewCardGlobal); 
   IF RetCode < 0 THEN 
      CALLPROC DDB_ROLLBACK; 
      Message 'Unable to make Subfeeder Card active.'; 
      RESUME; 
   ENDIF;
   CALLPROC DDB_COMMIT;  

   CALLPROC SOA_LogIns (
                 Card = FMS_NewCardGlobal,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = MessageText,
                 Old  = SubFeederName,
                 New  = MessageText + ' Card Created/Activated');
   CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = MessageText,
                 Old  = SubFeederName,
                 New  = MessageText + ' Card Created/Activated');
   CALLPROC DDB_COMMIT;
   /*
   **  Copy over all statuses except grounds and Station Grounds and cutout
   */
   i = 1;
   FdrStatus.Clear();
   SELECT :FdrStatus[i].Status = O.Status,
          :FdrStatus[i].StatusCount = O.StatusCount,
          :FdrStatus[i].TimeSet = O.TimeSet
   FROM    FMS_ObjectStatus O
   WHERE   O.Object = :C.Feeder AND
           O.Status NOT IN (:Status$Ground,
                            :Status$StationGround,
                            :Status$FeederGround,
                            :Status$CO,
                            :Status$ISM,  /* Gets set later based on card type */
                            :Status$DL)
   BEGIN 
      i = i + 1;
   END;

   FOR i = 1 TO FdrStatus.LastRow DO
      SelectCount = 0;      /* Prevent duplicate key error */
      SELECT :SelectCount = Count(*)
      FROM   FMS_ObjectStatus 
      WHERE  Object = :SubFeeder AND
             Status = :FdrStatus[i].Status; 
    
      IF SelectCount = 0 THEN
         RetCode = CALLPROC FMS_ObjStatIns(
                   Object = SubFeeder,
                   Status = FdrStatus[i].Status,
                   StatusCount = FdrStatus[i].StatusCount,
                   Terminal = 0,
                   TimeSet = FdrStatus[i].TimeSet);
                      
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                   'Error setting an Object Status.  Tech Support should be ' +
                   'contacted to review your machine trace log',
                                TraceMessage =
                   'Frame:CreateKnownPointSplice; ' +
                   'Error setting an Object Status. ' +
                   'Object=' + VARCHAR(FdrStatus[i].Object) +
                   ';Status=' + VARCHAR(FdrStatus[i].Status) + '.'
                   );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF; 
   ENDFOR;

   IF SubC.CardClass = Type$Auto  OR
      SubC.CardClass = Type$CIOA  OR
      SubC.CardClass = Type$OOE1  THEN

      RetCode = CALLPROC ForceStatus (Feeder = SubFeeder,
                                      NewStatus = Status$ISM);
      IF RetCode = PU_CANCEL THEN
          CALLPROC DDB_ROLLBACK;
          Message 'Error trying to set ISM Feeder Status.';
      ENDIF;
      CALLPROC DDB_COMMIT;
   ELSE 
      RetCode = CALLPROC ForceStatus (Feeder = SubFeeder,
                            NewStatus = Status$DL);
      IF RetCode = PU_CANCEL THEN
          CALLPROC DDB_ROLLBACK;
          Message 'Error trying to set DL Feeder Status.';
      ENDIF;
      CALLPROC DDB_COMMIT; 
   ENDIF;

   j = 0;
   SELECT :j = Status 
   FROM   FMS_ObjectStatus
   WHERE  Object = :C.Feeder AND
          Status = :Status$DBF AND
          StatusCount > 0;
   IF j = Status$DBF THEN
      RetCode = CALLPROC ForceStatus (Feeder = SubFeeder,
                                      NewStatus = Status$DBF);     
      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Error trying to set DBFFeeder Status.';
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Insert Caution Move if neccesary.
*/
   CALLPROC InsertCaution(NewCard = FMS_NewCardGlobal
                         ,OldCard = C.Card
                         ,NewC = C
                         ,NewFeeder = SubFeeder);
/*
**  Update the validated field
*/
    IF (SubC.Validated <> '') THEN

        CALLPROC FMS_ValidateFeederEquip 
            (ValidatedBy = SubC.Validated,
             Validated = 'now',
             Feeder = SubFeeder);       
        CALLPROC DDB_COMMIT;
    ENDIF;

      RetCode = CALLPROC FMS_DeadMoveCount (Card = C.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Dead Move Count on Old Card may not be correct due to an ' +
                 'error';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** For scheduled card,
** Check for Open SF6 device, if open, must mark CutOut for new card.
*/
   OpenSF6 = 0;
   IF (C.CardClass <> Type$CIOA AND 
       C.CardClass <> Type$Auto AND
       C.CardClass <> Type$OOE1) AND SubFeederType = Type$KPSFeeder THEN

      SELECT :OpenSF6 = S.CurrentlyOpen
      FROM   Udb_Object O,
             Udb_Switch S
      WHERE  O.Object = :SourceBkrEquip.Equip AND
             O.Type IN (SELECT Type FROM Udb_ExtendedType 
                        WHERE  SuperType IN (:Type$DMSF6, :Type$DMEaton, :Type$KPS, :Type$DMVac)) AND
             O.Object = S.Object AND
             S.CurrentlyOpen = 1;
 
      IF OpenSF6 <> 0 THEN
         CALLFRAME PromptCutOut (JIP = NULL,
            Feeder = SubFeeder,
            KPSFeeder = TRUE);
      ENDIF;
   ENDIF;

   DBEventText = VARCHAR(FMS_NewCardGlobal);
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_CreateCard',
                     EventText = DBEventText); 
   CALLPROC DDB_COMMIT; 
/*
**  Transfer RFP and workpermits if necessary.  Must be done
**  after IR_CreateCard has been sent down for new card.
*/
   IF SubFeederType = Type$KPSFeeder THEN
      CALLPROC RFP_XferLink(NewCard = FMS_NewCardGlobal
                           ,OldCard = C.Card);
   ENDIF;
/*
** Force Cutout of Sectional Feeder card
*/
   IF SubFeederType = Type$SectionalFeeder AND 
         (C.CutOut IS NOT NULL AND C.CutOut <> '') THEN

      CALLFRAME PromptCutOut (JIP = NULL,
            Feeder = SubFeeder,
            Feeder3GCutOut = C.CutOut, /*Re-use for Sectional*/
            KPSFeeder = TRUE);
   ENDIF;

   FCFrame.SendUserEvent (EventName = 'Load_Card');
   FCFrame.SendUserEvent (EventName = 'Load_Jobs');
   RETURN;
END;

ON UserEvent 'ContinueCancel_Btn' =
BEGIN
   RETURN;
END;

PROCEDURE InsertCaution (
   NewC      = FMS_Card;              
   OldCard   = INTEGER NOT NULL WITH DEFAULT;
   NewCard   = INTEGER NOT NULL WITH DEFAULT;
   NewFeeder = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   j        = INTEGER NOT NULL WITH DEFAULT;
   SelectedEquip = FMS_Equip;          /* Selected equipment */
   NewJob = Job;                   /* New job template */
   ImpactedCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
   CautionJob = INTEGER;   
   OldTOIssued = DATE;
   OldTOComplete = DATE;
   OldTOOperator = INTEGER;
ENDDECLARE
BEGIN
   j = 0;
   SELECT :j = Status 
   FROM   FMS_ObjectStatus
   WHERE  Object = :NewFeeder AND
          Status = :Status$Caution AND
          StatusCount > 0;
   IF j <> Status$Caution THEN
      RETURN;
   ENDIF;
   /*
   ** Get Source Breaker for Caution move
   */ 
   SelectedEquip.Equip = 0;
   REPEATED
   SELECT  :SelectedEquip.Equip = O.Object,
           :SelectedEquip.EquipName = O.Name,
           :SelectedEquip.EquipClass = O.Type,
           :SelectedEquip.EquipClassName = O.TypeName,
           :SelectedEquip.Description = O.Description,
           :SelectedEquip.PrintID = GG.Reference
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG,
           TFMS_CardToObject CTO
   WHERE   CTO.Card = :NewCard AND
           CTO.Object = G.Grouping AND
           G.RelationShip = :Interaction$SourcePosition AND
           G.Member = O.Object AND 
           G.Member = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.Grouping = CTO.Object;
   CALLPROC DDB_ROLLBACK;

   IF SelectedEquip.Equip = 0 THEN
      MESSAGE 'Unable to find Source Breaker for Feeder.  Caution ' +
              'move cannot be inserted.';
      RETURN;
   ENDIF;

   NewJob.JobClass = 0;
   SELECT  :NewJob.JobClass = J.JobClass,
           :NewJob.TOMove = J.TOMove,
           :NewJob.MoveType = J.MoveType,
           :NewJob.RSMove = J.RSMove,
           :NewJob.TOMoveRules = J.TOMoveRules,
           :NewJob.RSMoveRules = J.RSMoveRules, 
           :NewJob.StepPair = JC.StepPair,
           :NewJob.MoveEquipClass = JC.EquipClass 
   FROM    FMS_JobClass J, 
           FMS_JobClassControl JC 
   WHERE   JC.JobClass = :Type$Caution
   AND     JC.TypeofCard = :Type$13kVCard
   AND     J.JobClass = JC.JobClass; 
   CALLPROC DDB_ROLLBACK;

   IF NewJob.JobClass = 0 THEN
      MESSAGE 'Unable to find Caution move for this type of card.  Caution ' +
              'move cannot be inserted.';
      RETURN;
   ENDIF;
   /*
   ** Get the Substation if one exists.
   */
   SELECT  :NewJob.Substation = O.Object,
           :NewJob.SubstationName = O.Name
   FROM    Udb_Object O,
           Udb_Grouping G
   WHERE   O.Object = G.Grouping AND
           G.Relationship = :Interaction$MemberOf AND
           G.Member = :SelectedEquip.Equip AND
           O.Type IN (SELECT Type FROM Udb_ExtendedType
                      WHERE  SuperType = :Type$Substation);

   NewJob.PrintID = SelectedEquip.PrintID;
   NewJob.Equip = SelectedEquip.Equip;
   NewJob.EquipName = SelectedEquip.EquipName;
   NewJob.EquipClass = SelectedEquip.EquipClass;
   NewJob.EquipClassName = SelectedEquip.EquipClassName;
   NewJob.TOMove = SQUEEZE(SelectedEquip.Description + ' ' + NewJob.TOMove);

   NewJob.MoveFGColor = CC_BLACK;
   NewJob.Card = FMS_NewCardGlobal;
   NewJob.TOIssued = NULL;
   NewJob.TOOperator = NULL;
   NewJob.TOComplete = NULL;
   NewJob.RSIssued = NULL;
   NewJob.RSOperator = NULL;
   NewJob.RSComplete = NULL;
   NewJob.GroundOn = NULL;
   /*
   **  Get issue/compl time and move text from existing job
   */
   SELECT  :NewJob.TOMove = J.TOMove,
           :NewJob.RSMove = J.RSMove,
           :OldTOIssued = J.TOIssued,
           :OldTOComplete = J.TOComplete,
           :OldTOOperator = J.TOOperator
   FROM     SOA_Job J,
            SOA_JobControl JC
   WHERE    JC.Card = :OldCard AND
            JC.Job = J.Job AND
            J.JobClass = :Type$Caution AND
            J.TOIssued IS NOT NULL AND 
            J.RSIssued IS NULL;
 
   ImpactedCardList.Clear();
   NewC.Card = NewCard;
   CautionJob = CALLPROC InsertJobsRow 
                      (C = NewC, 
                       NewJob = NewJob,
                       ImpactedCardList = BYREF(ImpactedCardList),
                       NotShadowItem = FALSE);

   IF CautionJob IS NULL THEN
      CALLPROC DDB_ROLLBACK;
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_IssueMove(Job = ifnull(CautionJob,0),
                                    Issued = OldTOIssued,
                                    Operator = OldTOOperator,
                                    Status = Job$TakeOut
                                   );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error: Unable to issue Caution move.',
                           TraceMessage =
               'Frame:CreateKnownPointSplice; Unable to complete Job ' + VARCHAR(CautionJob) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;   

   RetCode = CALLPROC SOA_CompleteMove(Job = ifnull(CautionJob,0),
                                    Complete = OldTOComplete,
                                    Status = Job$TakeOut
                                    );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error: Unable to complete Caution move.',
                           TraceMessage =
               'Frame:CreateKnownPointSplice; Unable to complete Caution Job ' + VARCHAR(CautionJob) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;   
END;

PROCEDURE RFP_XferLink (
   OldCard   = INTEGER NOT NULL WITH DEFAULT;
   NewCard   = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   i        = INTEGER NOT NULL WITH DEFAULT;
   k        = INTEGER NOT NULL WITH DEFAULT;
   j        = INTEGER NOT NULL WITH DEFAULT;
   OldRFP   = INTEGER NOT NULL WITH DEFAULT;
   RFPList  = ARRAY OF IR_WorkLocation;
   WP_Xfer  = ARRAY OF IR_WorkLocation;
   RFP_Xfer = ARRAY OF IR_WorkLocation;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   status   = INTEGER;        	 /* return status variable */ 
   UserMessage = VARCHAR(1000) NOT NULL WITH DEFAULT; /*Optional*/
ENDDECLARE
BEGIN
   i =1;
   RFPList.Clear();
   SELECT DISTINCT
          RFPList[i].RFP = R.RFP,
          RFPList[i].RequestForPermit = R.RequestForPermit,
          RFPList[i].WorkPermit = WL.WorkPermit,
          RFPList[i].WPLocation = WL.WPLocation
   FROM   Udb_Grouping G,
          SOA_JobControl JC,
          SOA_Job J,
          SOA_Job J2,
          FMS_WorkPermitProtection WPP,
          IR_WorkLocation WL,
          IR_RequestForPermit R
   WHERE  G.Grouping = :SubFeeder AND
          G.Relationship = :Interaction$MemberOf AND
          G.MemberType IN (SELECT Type
                           FROM   Udb_ExtendedType
                           WHERE  SuperType = :Type$Switch) AND
          G.Member = J.Equip AND
          J.Status = '' AND
          J.Job = JC.Job AND
          JC.Card = :NewCard AND
          J.Job  = WPP.ProtectionJobID AND
          WPP.PermitJobId = WL.WorkPermit AND
          WPP.PermitJobID = J2.Job AND
          J2.TOIssued IS NULL AND
          WL.RFP = R.RFP AND
          R.Card = :OldCard AND
          R.LinkedByDO = :TRUE
   ORDER BY RFP, WorkPermit
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
      
   IF RFPList.LastRow = 0 THEN
      RETURN;
   ENDIF;
   
   /*
   **  Create Separate RFP and WP list for convenience. 
   */ 
   RFP_Xfer.Clear();
   WP_Xfer.Clear();
   FOR i = 1 TO RFPList.LastRow DO
      FOR k = 1 TO RFP_Xfer.LastRow DO
         IF RFP_Xfer[k].RFP = RFPList[i].RFP THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF k > RFP_Xfer.LastRow THEN
         RFP_Xfer[k] = RFPList[i].Duplicate();
      ENDIF;

      FOR k = 1 TO WP_Xfer.LastRow DO
         IF WP_Xfer[k].WorkPermit = RFPList[i].WorkPermit THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF k > WP_Xfer.LastRow THEN
         WP_Xfer[k] = RFPList[i].Duplicate();
      ENDIF;
   ENDFOR;
   /*
   **  Unlink RFP from Old Card and return it to the pool.
   */
   FOR i = 1 TO RFP_Xfer.LastRow DO
      RetCode = CALLPROC IR_LinkRFPCard (
                 RFP = RFP_Xfer[i].RFP,
                 Card = 0,
                 LinkedByDO = 0);

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;

         ControlText = VARCHAR(RFP_Xfer[i].RFP) + ';' +
                       VARCHAR(OldCard) + ';' +
                       VARCHAR(RFP_Xfer[i].RequestForPermit) + ';' + 
                       DOp.Description + ';';
         CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_UnLinkRFPCard',
                     EventText = ControlText);  
      ELSE
         CALLPROC DDB_ROLLBACK;
         RFP_Xfer.RemoveRow(RowNumber = i);
         i = i - 1;
         MESSAGE 'Error: UnLinking the RFP from the card was unsuccessful.';
      ENDIF;      
   ENDFOR; 
   /*
   **  Transfer WorkPermits to New Card
   */
   FOR i = 1 TO WP_Xfer.LastRow DO
      /*
      ** transfer jobs from the current card to the destination card
      */
      j = 1; 
      WHILE j <= Jobs.LastRow()  DO 

         IF Jobs[j].Job = WP_Xfer[i].WorkPermit THEN

            IF Jobs[j].TOIssued IS NULL OR   
               Jobs[j].TOComplete IS NULL OR   
               Jobs[j].RSIssued   IS NULL OR   
               Jobs[j].RSComplete IS NULL THEN  

               /* Blank out any NULL times: */
               IF Jobs[j].TOIssued IS NULL THEN 
                  Jobs[j].ToIssued = ' '; 
               ENDIF; 
               IF Jobs[j].TOComplete IS NULL THEN 
                  Jobs[j].TOComplete = ' '; 
               ENDIF; 
               IF Jobs[j].RSIssued IS NULL THEN 
                  Jobs[j].RSIssued = ' '; 
               ENDIF; 
               IF Jobs[j].RSComplete IS NULL THEN  
                  Jobs[j].RSComplete = ' '; 
               ENDIF; 

               Jobs[j].Response = 'Xfer to ' + SubFeederName; 
               Jobs[j].Status = Job$Xfer; 
               Jobs[j].GroundOn = NULL;
               Jobs[j].MoveFGColor = CC_BLACK;

               /* Update the job on current card: make a copy of the job for 
               the source card and tranfer the original job to the destination
               card. */ 
               status = CALLPROC SOA_TransferEquipJob
                            (Card       = OldCard,
                             Job        = Jobs[j].Job, 
                             Response   = Jobs[j].Response, 
                             Status     = Jobs[j].Status, 
                             TOIssued   = Jobs[j].TOIssued, 
                             TOComplete = Jobs[j].TOComplete, 
                             RSIssued   = Jobs[j].RSIssued, 
                             RSComplete = Jobs[j].RSComplete,
                             GroundOn   = Jobs[j].GroundOn,
                             MoveFGColor= Jobs[j].MoveFGColor
                             ); 
               IF status <> 0 THEN 
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to transfer Work Permit Protection moves. ' + 
                      'Please check protection moves on ' + SubFeederName;
               ENDIF;
               /*      
               **  Establish control entry for destination card linking to the original move
               */       
               ControlEntry.Card = NewCard;
               ControlEntry.Seq = 0;
               ControlEntry.SwitchingItem = 0;
               ControlEntry.Application = Application$FMS;
               ControlEntry.MoveEquipClass = Jobs[j].MoveEquipClass;
               ControlEntry.PrintID = Jobs[j].PrintID;
               ControlEntry.StepHeading = Jobs[j].StepPair;
               ControlEntry.StepLevel = 0;
               ControlEntry.TypeOfCard = SubC.TypeOfCard; 

               Status = Jobs[j].InsertControl (
                               ControlEntry = ControlEntry
                              ,InitiatingCard = NewCard
                              ,TransferFlag = TRUE
                              ,SingleFeederOnly = TRUE
                              );

               IF Status = PU_CANCEL THEN
                  MESSAGE 'Procedure:CreateKnownPointSplice; Unable to establish ' +
                          'insert move control for the destination card.';
                  ENDLOOP;
               ENDIF; 

               /* set the ActivityIdentifier to 'T' unless already shared or KPOS SB Equip */
               IF Jobs[j].ActivityIdentifier <> 'S' THEN
                  CALLPROC SOA_JobActivityIDUpd (Job = Jobs[j].Job,
                                                 ActivityIdentifier = 'T');
               ENDIF;
               /*
               ** Change Control Card for move if controlled by the previous card,
               ** except for KPS_SB moves
               */
               IF Jobs[j].ControlCard = OldCard THEN
                  status = CALLPROC SOA_JobControlCardUpd (
                                         Job = Jobs[j].Job,
                                         Card = NewCard);
                  IF status <> 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to change control card for move ' + 
                             VARCHAR(Jobs[j].Job) + ' to the destination card. ' + 
                             'Move might not be accessible - contact Tech Support.';
                  ENDIF;
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF; 
         ENDIF; 
         j = j + 1; 
      ENDWHILE;
   ENDFOR;
   /*
   **  Open process window indicator.  Since there is no while loop for this
   **  procedure,  we will hardcode the max steps to 9.  If this procedure in the
   **  future gets more steps this number will have to get increased and the frame
   **  updated where the extra procedure is called.
   */
   ProcessCount = 1;
   ProcessWindow = OPENFRAME ProcessIndicator 
                                (ParentFrame = CurFrame,
                                 Pct_Title = 'Transfer Work Locations',
                                 MaxValue = 10);
   CurFrame.WaitFor (EventName = 'Received');
   /*
   **  Link RFP to New Card
   */
   FOR i = 1 TO RFP_Xfer.LastRow DO
      RetCode = CALLPROC IR_LinkRFPCard (
                 RFP = RFP_Xfer[i].RFP,
                 Card = NewCard,
                 LinkedByDO = 1);
   
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
   
         ControlText = VARCHAR(RFP_Xfer[i].RFP) + ';' +
                    VARCHAR(NewCard) + ';' +
                    DOp.Description + ';';

         CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_LinkRFPCard',
                     EventText = ControlText);  
         /*
         **  Wait and see if requestforpermit has been updated for rfp that was just linked.
         **  This is done in the IR_FCRMonitor.
         */
         Status = 0;
         FOR k = 1 to 10 DO
            ProcessWindow.SendUserEvent (EventName = 'Update_Delayed',
                                         MessageInteger = 2);
            CurFrame.WaitFor (EventName = 'Received');

            SELECT :Status = RequestForPermit
            FROM   IR_RequestForPermit
            WHERE  RFP = :RFP_Xfer[i].RFP;
            IF Status <> 0 THEN
               ENDLOOP;
            ENDIF;
         ENDFOR;
         IF k > 10 THEN
            MESSAGE 'Unable to link work locations to KPI Card.  Please manually link work locations to card.';
         ENDIF;
         IF Status <> 0 THEN
            /*
            ** Update IR_Worklocation with updated requestforpermit value
            */
            RetCode = CALLPROC IR_WorkLocationXfer (
                   WorkPermit = RFP_Xfer[i].WorkPermit
                  ,WPLocation = RFP_Xfer[i].WPLocation
                  ,RequestForPermit = IFNULL(Status,0)
                  );

            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Unable to transfer Work Location links to KPI card.  Call tech support.';
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
      ELSE
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error: Linking the RFP to the card was unsuccessful.';
      ENDIF;
   ENDFOR;
   ProcessWindow.Terminate();

   RETURN;
END;

