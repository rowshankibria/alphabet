**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    TFMS_BusinessLogic
**  Class:          TFMS_MgtReports_ASE
**
**  Date:       Version Description
** ----------------------------------
**  01/24/06    pkw     Create Load_MilestoneData method.
**  01/03/08    pkw     Fix problem with closed cards.
**  01/16/17    ysp     Add Load_XA21Outage
**  06/07/17    ysp     add RequestCFGEReport
*/ 
METHOD Load_MilestoneHistory (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1000);
   ArchiveWhereClause = VARCHAR(1000);
   OutageWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardFilterWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   SimpleOSS = TFMS_MgtReports_ASE DEFAULT NULL;
   OS = ARRAY OF TFMS_OpStepStatus;
   MaxMinutes = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Milestone History
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ExceptionFlag = FALSE;

   MaxMinutes = CurObject.MaxHours * 60;
   
/*
**  Based on whether they selected Taken out of service or Out of Service, we 
**  will build a select clause.  
*/  
   IF CurObject.Outage = 1 THEN        /* Taken out of Service */
      OutageWhereClause = ' (C.Cutout BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) ';
   ELSEIF CurObject.Outage = 2 THEN    /* Out of Service */   
      OutageWhereClause = ' C.CutOut IS NOT NULL AND ' +
         'C.CutOut <= ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' AND ' +
         '(C.CutIn >= ' + '''' + VARCHAR(:CurObject.StartDate) + '''' + ' OR ' +
         '(C.Closed >= ' + '''' + VARCHAR(:CurObject.StartDate) + '''' + ' AND ' +
         'C.CutIn IS NULL) OR ' + 
         '(C.Cutin IS NULL AND ' +
         'C.Closed IS NULL)) ';
   ELSEIF CurObject.Outage = 3 THEN        /* Restored to Service */
      OutageWhereClause = ' (C.CutIn BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) ';
   ELSEIF CurObject.Outage = 4 THEN        /* Closed */
      OutageWhereClause = ' (C.Closed BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' + 
          'C.CutOut IS NOT NULL ';
   ENDIF;
    
   CardFilterWhereClause = 'C.Status < ' + VARCHAR(:Card$PurgeActive);

   IF CurObject.Line <> 0 THEN

      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'C.Card = CTO.Card AND ' + 
         'CTO.Type = ' + VARCHAR(:Type$Line) + ' AND ' +
         'CTO.Object = ' + VARCHAR(:CurObject.Line) + ' AND ' +
         'CTO.Object = G.Member AND ' +
         'G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
         'G.Grouping IN ( ';

   ELSEIF CurObject.Substation <> 0 THEN

      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'C.Card = CTO.Card AND ' +
         'CTO.Type = ' + VARCHAR(:Type$Substation) + ' AND ' +
         'CTO.Object = ' + VARCHAR(:CurObject.Substation) + ' AND ' +
         'CTO.Object = G.Member AND ' +
         'G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
         'G.Grouping IN ( ';

   ELSE

      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'C.Card = CTO.Card AND ' +
         'CTO.Type = ' + VARCHAR(:Type$Line) + ' AND ' +
         'CTO.Object = G.Member AND ' +
         'G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
         'G.Grouping IN ( ';
   ENDIF;
   
   EffectiveDivisions.Clear();
   IF lowercase(CurObject.DivisionName) like 'all%' THEN
      /*
      **  Load Division table
      */
      IF SimpleDivision IS NULL THEN
         SimpleDivision = Division_ASE.Create();
      ENDIF;
         
      SimpleDivision.LoadDivisions();
      
      IF SimpleDivision.ReturnCode = 0 THEN
         i = 1;
         WHILE i <= SimpleDivision.Dlist.LastRow() DO
            EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
         SimpleDivision = NULL;
         RETURN;
      ENDIF;
      SimpleDivision = NULL;
         
   ELSE
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;            
   ENDIF;

   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;

   DynamicWhereClause = DynamicWhereClause + ' AND C.CardClass IN ( ';

   If lowercase(CurObject.CardTypeName) like 'all%' THEN
      /*
      **  Load Report Card types table
      */
      IF SimpleOSS IS NULL THEN
         SimpleOSS = TFMS_MgtReports_ASE.Create();
      ENDIF;
      
      SimpleOSS.Load_ReportCardTypes();
        
      IF SimpleOSS.ReturnCode = 0 THEN
         i = 1;
         WHILE i <= SimpleOSS.OSS.LastRow() DO
            IF i = SimpleOSS.OSS.LastRow() THEN
               DynamicWhereClause = DynamicWhereClause + 
                  VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';
            ELSE
               DynamicWhereClause = DynamicWhereClause + 
                  VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';
            ENDIF;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleOSS.ErrorMessage;
         RETURN;
      ENDIF;
      SimpleOSS = NULL;
         
   ELSE
      IF CurObject.CardType <> 0 THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(CurObject.CardType) + ')';
      ELSE
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': DEBUGGING MESSAGE: TFMS_MgtReports_ASE ' +
                    'had no card type parameter supplied with it.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No card type parameter supplied.';
         RETURN;
      ENDIF;  
   ENDIF;
   /*
   **  Build whereclause for Archive tables
   */
   ArchiveWhereClause = DynamicWhereClause;
   DynamicWhereClause = DynamicWhereClause + ' AND C.Card = TC.Card'; 

   CurObject.OSS.Clear();
   i = 1;
   SELECT  :CurObject.OSS[i].Card = C.Card,
           :CurObject.OSS[i].CardName = TC.FeederNames,
           :CurObject.OSS[i].Cutout = IFNULL(C.Cutout,''),
           :CurObject.OSS[i].Cutin = IFNULL(C.Cutin,''),
           :CurObject.OSS[i].Closed = IFNULL(C.Closed,''),
           :CurObject.OSS[i].CardClass = C.CardClass,
           :CurObject.OSS[i].CardClassName = C.CardClassName
   FROM    SOA_Card C,
           TFMS_Card TC,
           TFMS_CardToObject CTO,
           Udb_Grouping G
   WHERE   :DynamicWhereClause
   UNION
   SELECT  C.Card,
           C.FeederNames,
           IFNULL(C.Cutout,''),
           IFNULL(C.Cutin,''),
           IFNULL(C.Closed,''),
           C.CardClass,
           C.CardClassName
   FROM    TFMS_ArchiveCard C,
           TFMS_ArchiveCardToObject CTO,
           Udb_Grouping G
   WHERE   :ArchiveWhereClause
   ORDER BY CardName
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   j = 1;
   WHILE j <= CurObject.OSS.LastRow() DO
      i = 1;
      OS.Clear();
      SELECT :OS[i].OperatingStep = OS.OperatingStep,
             :OS[i].OperatingStepName = OS.OperatingStepName,
             :OS[i].StartTime = OS.StartTime,
             :OS[i].EndTime = OS.EndTime,
             :OS[i].DurationMins = OS.DurationMins
      FROM   TFMS_OperatingStep OS
      WHERE  OS.Card = :CurObject.OSS[j].Card
      BEGIN
         IF OS[i].EndTime = '' THEN
            OS[i].DurationMins = INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)))
         ENDIF;
         /*
         **  If an endtime is greater than the cutin time tag this row as an exception.
         **  If starttime is less than the cutout time, tag row also.
         */
         IF OS[i].DurationMins > MaxMinutes OR
            OS[i].DurationMins < 0 OR
           (OS[i].OperatingStep <> OpSt$RS AND
            OS[i].EndTime > date(CurObject.OSS[j].CutIn + '5 minutes')) OR
            OS[i].StartTime < date(CurObject.OSS[j].CutOut - '5 minutes') THEN  
            CurObject.OSS[j].TagForDelete = TRUE;
            CurObject.ExceptionFlag = TRUE; /* There are exception values */
         ENDIF;             

         IF OS[i].OperatingStep = OpSt$CO THEN
            CurObject.OSS[j].IntCO = CurObject.OSS[j].IntCO + OS[i].DurationMins;
            CurObject.OSS[j].CO = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntCO);
             
         ELSEIF OS[i].OperatingStep = OpSt$INVS THEN
            CurObject.OSS[j].IntINVS = CurObject.OSS[j].IntINVS + OS[i].DurationMins;
            CurObject.OSS[j].INVS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntINVS);
           
         ELSEIF OS[i].OperatingStep = OpSt$ISL THEN
            CurObject.OSS[j].IntISL = CurObject.OSS[j].IntISL + OS[i].DurationMins;
            CurObject.OSS[j].ISL = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntISL);

         ELSEIF OS[i].OperatingStep = OpSt$GRND THEN
            CurObject.OSS[j].IntGRND = CurObject.OSS[j].IntGRND + OS[i].DurationMins;
            CurObject.OSS[j].GRND = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntGRND);

         ELSEIF OS[i].OperatingStep = OpSt$LOC THEN
            CurObject.OSS[j].IntLOC = CurObject.OSS[j].IntLOC + OS[i].DurationMins;
            CurObject.OSS[j].LOC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntLOC);

         ELSEIF OS[i].OperatingStep = OpSt$ID THEN
            CurObject.OSS[j].IntID = CurObject.OSS[j].IntID + OS[i].DurationMins;
            CurObject.OSS[j].ID = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntID);

         ELSEIF OS[i].OperatingStep = OpSt$TC THEN
            CurObject.OSS[j].IntTC = CurObject.OSS[j].IntTC + OS[i].DurationMins;
            CurObject.OSS[j].TC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTC);

         ELSEIF OS[i].OperatingStep = OpSt$CONT THEN
            CurObject.OSS[j].IntCONT = CurObject.OSS[j].IntCONT + OS[i].DurationMins;
            CurObject.OSS[j].CONT = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntCONT);

         ELSEIF OS[i].OperatingStep = OpSt$HP THEN
            CurObject.OSS[j].IntHP = CurObject.OSS[j].IntHP + OS[i].DurationMins;
            CurObject.OSS[j].HP = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntHP);

         ELSEIF OS[i].OperatingStep = OpSt$AC THEN
            CurObject.OSS[j].IntAC = CurObject.OSS[j].IntAC + OS[i].DurationMins;
            CurObject.OSS[j].AC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntAC);

         ELSEIF OS[i].OperatingStep = OpSt$OTWR THEN
            CurObject.OSS[j].IntOTWR = CurObject.OSS[j].IntOTWR + OS[i].DurationMins;
            CurObject.OSS[j].OTWR = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWR);

         ELSEIF OS[i].OperatingStep = OpSt$OTWS THEN
            CurObject.OSS[j].IntOTWS = CurObject.OSS[j].IntOTWS + OS[i].DurationMins;
            CurObject.OSS[j].OTWS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWS);

         ELSEIF OS[i].OperatingStep = OpSt$PFS THEN
            CurObject.OSS[j].IntPFS = CurObject.OSS[j].IntPFS + OS[i].DurationMins;
            CurObject.OSS[j].PFS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFS);

         ELSEIF OS[i].OperatingStep = OpSt$RS THEN
            CurObject.OSS[j].IntRS = CurObject.OSS[j].IntRS + OS[i].DurationMins;
            CurObject.OSS[j].RS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntRS);

         ELSEIF OS[i].OperatingStep = OpSt$PDNX THEN
            CurObject.OSS[j].IntPDNX = CurObject.OSS[j].IntPDNX + OS[i].DurationMins;
            CurObject.OSS[j].PDNX = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPDNX);
         ENDIF;

         i = i + 1;
      END; 
      /*
      ** Combine ISL + GRND into PROT
      */   
      CurObject.OSS[j].IntPROT = CurObject.OSS[j].IntISL +
                                 CurObject.OSS[j].IntGRND;
      IF CurObject.OSS[j].IntPROT > 0 THEN
         CurObject.OSS[j].PROT = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPROT);
      ENDIF;
      /*
      ** Combine LOC + ID + TC + CONT + HP + AC into TEST
      */   
      CurObject.OSS[j].IntTEST = CurObject.OSS[j].IntLOC +
                                 CurObject.OSS[j].IntID +
                                 CurObject.OSS[j].IntTC +
                                 CurObject.OSS[j].IntCONT +
                                 CurObject.OSS[j].IntHP +
                                 CurObject.OSS[j].IntAC;
      IF CurObject.OSS[j].IntTEST > 0 THEN
         CurObject.OSS[j].TEST = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTEST);
      ENDIF;
      /*
      ** Combine OTWR + OTWS into OTW
      */   
      CurObject.OSS[j].IntOTW = CurObject.OSS[j].IntOTWR +
                                 CurObject.OSS[j].IntOTWS;
      IF CurObject.OSS[j].IntOTW > 0 THEN
         CurObject.OSS[j].OTW = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTW);
      ENDIF;

      IF CurObject.OSS[j].Cutin <> '' THEN
         CurObject.OSS[j].IntOutage = INT4(interval('minute',DATE(CurObject.OSS[j].CutIn) - DATE(CurObject.OSS[j].Cutout)));
      ELSEIF CurObject.OSS[j].Closed <> '' THEN
         CurObject.OSS[j].IntOutage = INT4(interval('minute',DATE(CurObject.OSS[j].Closed) - DATE(CurObject.OSS[j].Cutout)));
      ELSE         
         CurObject.OSS[j].IntOutage = INT4(interval('minute',DATE('NOW') - DATE(CurObject.OSS[j].Cutout)));
      ENDIF;
      CurObject.OSS[j].Outage = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOutage);

      j = j + 1;
   ENDWHILE;

   RETURN;
END;

METHOD Calc_MilestoneHistory (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   m = INTEGER NOT NULL;     /*Counter*/
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   List_CO   = ARRAY OF IntegerObject; 
   List_INVS = ARRAY OF IntegerObject; 
   List_PROT = ARRAY OF IntegerObject; 
   List_ISL  = ARRAY OF IntegerObject; 
   List_GRND = ARRAY OF IntegerObject; 
   List_TEST = ARRAY OF IntegerObject; 
   List_LOC  = ARRAY OF IntegerObject; 
   List_ID   = ARRAY OF IntegerObject; 
   List_TC   = ARRAY OF IntegerObject; 
   List_CONT = ARRAY OF IntegerObject; 
   List_HP   = ARRAY OF IntegerObject; 
   List_AC   = ARRAY OF IntegerObject; 
   List_OTW  = ARRAY OF IntegerObject; 
   List_OTWR = ARRAY OF IntegerObject; 
   List_OTWS = ARRAY OF IntegerObject; 
   List_PFS  = ARRAY OF IntegerObject; 
   List_RS   = ARRAY OF IntegerObject; 
   List_PDNX = ARRAY OF IntegerObject; 

   List_Outage = ARRAY OF IntegerObject; 
 
ENDDECLARE
BEGIN
/*
**  Clear arrays to calculate average and Standard Deviation
*/
   List_CO.Clear(); 
   List_INVS.Clear(); 
   List_PROT.Clear(); 
   List_ISL.Clear(); 
   List_GRND.Clear(); 
   List_TEST.Clear(); 
   List_LOC.Clear(); 
   List_ID.Clear(); 
   List_TC.Clear(); 
   List_CONT.Clear(); 
   List_HP.Clear(); 
   List_AC.Clear(); 
   List_OTW.Clear(); 
   List_OTWR.Clear(); 
   List_OTWS.Clear(); 
   List_PFS.Clear(); 
   List_RS.Clear(); 
   List_PDNX.Clear(); 

   List_Outage.Clear(); 
/*
** Remove all unwanted rows
*/
/*
**  get all feeders selected.
*/
   CurObject.AllCards = CurObject.OSS.LastRow();
   i = 1;
   WHILE i <= CurObject.OSS.LastRow() DO
      IF (CurObject.OSS[i].TagForDelete = TRUE AND
          CurObject.ExceptionFlag = FALSE) OR        /* text says 'show valid list' */
         (CurObject.OSS[i].TagForDelete = FALSE AND
          CurObject.ExceptionFlag = TRUE) THEN       /* text says 'show exception list' */

         CurObject.OSS.RemoveRow (RowNumber = i);         
      ELSE
         IF CurObject.OSS[i].IntCO <> 0 THEN
            m = List_CO.LastRow + 1;
            List_CO[m].Value = CurObject.OSS[i].IntCO;
         ENDIF;               
         IF CurObject.OSS[i].IntINVS <> 0 THEN
            m = List_INVS.LastRow + 1;
            List_INVS[m].Value = CurObject.OSS[i].IntINVS;
         ENDIF;
         IF CurObject.OSS[i].IntPROT <> 0 THEN
            m = List_PROT.LastRow + 1;
            List_PROT[m].Value = CurObject.OSS[i].IntPROT;
         ENDIF;
         IF CurObject.OSS[i].IntISL <> 0 THEN
            m = List_ISL.LastRow + 1;
            List_ISL[m].Value = CurObject.OSS[i].IntISL;
         ENDIF;
         IF CurObject.OSS[i].IntGRND <> 0 THEN
            m = List_GRND.LastRow + 1;
            List_GRND[m].Value = CurObject.OSS[i].IntGRND;
         ENDIF;
         IF CurObject.OSS[i].IntTEST <> 0 THEN
            m = List_TEST.LastRow + 1;
            List_TEST[m].Value = CurObject.OSS[i].IntTEST;
         ENDIF;
         IF CurObject.OSS[i].IntLOC <> 0 THEN
            m = List_LOC.LastRow + 1;
            List_LOC[m].Value = CurObject.OSS[i].IntLOC;
         ENDIF;
         IF CurObject.OSS[i].IntID <> 0 THEN
            m = List_ID.LastRow + 1;
            List_ID[m].Value = CurObject.OSS[i].IntID;
         ENDIF;
         IF CurObject.OSS[i].IntTC <> 0 THEN
            m = List_TC.LastRow + 1;
            List_TC[m].Value = CurObject.OSS[i].IntTC;
         ENDIF;
         IF CurObject.OSS[i].IntCONT <> 0 THEN
            m = List_CONT.LastRow + 1;
            List_CONT[m].Value = CurObject.OSS[i].IntCONT;
         ENDIF;
         IF CurObject.OSS[i].IntHP <> 0 THEN
            m = List_HP.LastRow + 1;
            List_HP[m].Value = CurObject.OSS[i].IntHP;
         ENDIF;
         IF CurObject.OSS[i].IntAC <> 0 THEN
            m = List_AC.LastRow + 1;
            List_AC[m].Value = CurObject.OSS[i].IntAC;
         ENDIF;
         IF CurObject.OSS[i].IntOTW <> 0 THEN
            m = List_OTW.LastRow + 1;
            List_OTW[m].Value = CurObject.OSS[i].IntOTW;
         ENDIF;
         IF CurObject.OSS[i].IntOTWR <> 0 THEN
            m = List_OTWR.LastRow + 1;
            List_OTWR[m].Value = CurObject.OSS[i].IntOTWR;
         ENDIF;
         IF CurObject.OSS[i].IntOTWS <> 0 THEN
            m = List_OTWS.LastRow + 1;
            List_OTWS[m].Value = CurObject.OSS[i].IntOTWS;
         ENDIF;
         IF CurObject.OSS[i].IntPFS <> 0 THEN
            m = List_PFS.LastRow + 1;
            List_PFS[m].Value = CurObject.OSS[i].IntPFS;
         ENDIF;
         IF CurObject.OSS[i].IntRS <> 0 THEN
            m = List_RS.LastRow + 1;
            List_RS[m].Value = CurObject.OSS[i].IntRS;
         ENDIF;
         IF CurObject.OSS[i].IntPDNX <> 0 THEN
            m = List_PDNX.LastRow + 1;
            List_PDNX[m].Value = CurObject.OSS[i].IntPDNX;
         ENDIF;
         IF CurObject.OSS[i].IntOutage <> 0 THEN
            m = List_Outage.LastRow() + 1;
            List_Outage[m].Value = CurObject.OSS[i].IntOutage;
         ENDIF;              
         i = i + 1;
      ENDIF;
   ENDWHILE;
/*
**  get all feeders shown.
*/
   CurObject.ShowCards = CurObject.OSS.LastRow();

   CurObject.Total.IntCO = CALLPROC CalculateTotal(CT = List_CO);
   CurObject.Total.CO  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntCO);
   IF List_CO.LastRow() <> 0 THEN
      CurObject.Average.IntCO = CurObject.Total.IntCO/List_CO.LastRow();
      CurObject.Average.CO = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntCO);
   ENDIF;
   CurObject.Total.IntINVS = CALLPROC CalculateTotal(CT = List_INVS);
   CurObject.Total.INVS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntINVS);
   IF List_INVS.LastRow() <> 0 THEN
      CurObject.Average.IntINVS = CurObject.Total.IntINVS/List_INVS.LastRow();
      CurObject.Average.INVS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntINVS);
   ENDIF;
   CurObject.Total.IntPROT = CALLPROC CalculateTotal(CT = List_PROT);
   CurObject.Total.PROT  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPROT);
   IF List_PROT.LastRow() <> 0 THEN
      CurObject.Average.IntPROT = CurObject.Total.IntPROT/List_PROT.LastRow();
      CurObject.Average.PROT = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPROT);
   ENDIF;
   CurObject.Total.IntISL = CALLPROC CalculateTotal(CT = List_ISL);
   CurObject.Total.ISL  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntISL);
   IF List_ISL.LastRow() <> 0 THEN
      CurObject.Average.IntISL = CurObject.Total.IntISL/List_ISL.LastRow();
      CurObject.Average.ISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntISL);
   ENDIF;
   CurObject.Total.IntGRND = CALLPROC CalculateTotal(CT = List_GRND);
   CurObject.Total.GRND  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntGRND);
   IF List_GRND.LastRow() <> 0 THEN
      CurObject.Average.IntGRND = CurObject.Total.IntGRND/List_GRND.LastRow();
      CurObject.Average.GRND = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntGRND);
   ENDIF;
   CurObject.Total.IntTEST = CALLPROC CalculateTotal(CT = List_TEST);
   CurObject.Total.TEST  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTEST);
   IF List_TEST.LastRow() <> 0 THEN
      CurObject.Average.IntTEST = CurObject.Total.IntTEST/List_TEST.LastRow();
      CurObject.Average.TEST = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTEST);
   ENDIF;
   CurObject.Total.IntLOC = CALLPROC CalculateTotal(CT = List_LOC);
   CurObject.Total.LOC  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntLOC);
   IF List_LOC.LastRow() <> 0 THEN
      CurObject.Average.IntLOC = CurObject.Total.IntLOC/List_LOC.LastRow();
      CurObject.Average.LOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntLOC);
   ENDIF;
   CurObject.Total.IntID = CALLPROC CalculateTotal(CT = List_ID);
   CurObject.Total.ID  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntID);
   IF List_ID.LastRow() <> 0 THEN
      CurObject.Average.IntID = CurObject.Total.IntID/List_ID.LastRow();
      CurObject.Average.ID = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntID);
   ENDIF;
   CurObject.Total.IntTC = CALLPROC CalculateTotal(CT = List_TC);
   CurObject.Total.TC  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTC);
   IF List_TC.LastRow() <> 0 THEN
      CurObject.Average.IntTC = CurObject.Total.IntTC/List_TC.LastRow();
      CurObject.Average.TC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTC);
   ENDIF;
   CurObject.Total.IntCONT = CALLPROC CalculateTotal(CT = List_CONT);
   CurObject.Total.CONT  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntCONT);
   IF List_CONT.LastRow() <> 0 THEN
      CurObject.Average.IntCONT = CurObject.Total.IntCONT/List_CONT.LastRow();
      CurObject.Average.CONT = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntCONT);
   ENDIF;
   CurObject.Total.IntHP = CALLPROC CalculateTotal(CT = List_HP);
   CurObject.Total.HP  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntHP);
   IF List_HP.LastRow() <> 0 THEN
      CurObject.Average.IntHP = CurObject.Total.IntHP/List_HP.LastRow();
      CurObject.Average.HP = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntHP);
   ENDIF;
   CurObject.Total.IntAC = CALLPROC CalculateTotal(CT = List_AC);
   CurObject.Total.AC  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntAC);
   IF List_AC.LastRow() <> 0 THEN
      CurObject.Average.IntAC = CurObject.Total.IntAC/List_AC.LastRow();
      CurObject.Average.AC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntAC);
   ENDIF;
   CurObject.Total.IntOTW = CALLPROC CalculateTotal(CT = List_OTW);
   CurObject.Total.OTW  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntOTW);
   IF List_OTW.LastRow() <> 0 THEN
      CurObject.Average.IntOTW = CurObject.Total.IntOTW/List_OTW.LastRow();
      CurObject.Average.OTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntOTW);
   ENDIF;
   CurObject.Total.IntOTWR = CALLPROC CalculateTotal(CT = List_OTWR);
   CurObject.Total.OTWR  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntOTWR);
   IF List_OTWR.LastRow() <> 0 THEN
      CurObject.Average.IntOTWR = CurObject.Total.IntOTWR/List_OTWR.LastRow();
      CurObject.Average.OTWR = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntOTWR);
   ENDIF;
   CurObject.Total.IntOTWS = CALLPROC CalculateTotal(CT = List_OTWS);
   CurObject.Total.OTWS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntOTWS);
   IF List_OTWS.LastRow() <> 0 THEN
      CurObject.Average.IntOTWS = CurObject.Total.IntOTWS/List_OTWS.LastRow();
      CurObject.Average.OTWS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntOTWS);
   ENDIF;
   CurObject.Total.IntPFS = CALLPROC CalculateTotal(CT = List_PFS);
   CurObject.Total.PFS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPFS);
   IF List_PFS.LastRow() <> 0 THEN
      CurObject.Average.IntPFS = CurObject.Total.IntPFS/List_PFS.LastRow();
      CurObject.Average.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS);
   ENDIF;
   CurObject.Total.IntRS = CALLPROC CalculateTotal(CT = List_RS);
   CurObject.Total.RS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntRS);
   IF List_RS.LastRow() <> 0 THEN
      CurObject.Average.IntRS = CurObject.Total.IntRS/List_RS.LastRow();
      CurObject.Average.RS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntRS);
   ENDIF;
   CurObject.Total.IntPDNX = CALLPROC CalculateTotal(CT = List_PDNX);
   CurObject.Total.PDNX  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPDNX);
   IF List_PDNX.LastRow() <> 0 THEN
      CurObject.Average.IntPDNX = CurObject.Total.IntPDNX/List_PDNX.LastRow();
      CurObject.Average.PDNX = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPDNX);
   ENDIF;
   CurObject.Total.IntOutage = CALLPROC CalculateTotal(CT = List_Outage);
   CurObject.Total.Outage  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntOutage);
   IF List_Outage.LastRow() <> 0 THEN
      CurObject.Average.IntOutage = CurObject.Total.IntOutage/List_Outage.LastRow();
      CurObject.Average.Outage = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntOutage);
   ENDIF;

   RETURN;
END;

METHOD Load_MilestoneData (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1000);
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   Tot_Min = INTEGER NOT NULL;
   TempDuration = INTEGER NOT NULL;
   TotalDelayCnt = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   OS = ARRAY OF TFMS_OpStepStatus;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder Milestone Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Filter = 1 THEN  /* Active Out of Service */
      DynamicWhereClause = 
           'C.CutOut IS NOT NULL AND ' + 
           'C.Cutout <> '' '' AND ' +
           'C.Cutin IS NULL AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = AC.Card AND ' +
           'AC.TypeOfCard = ' + VARCHAR(:TypeOfCard$TFMS) + ' AND ' +
           'AC.Division IN ( ';
   
   ELSEIF CurObject.Filter = 2 THEN  /* Active InService */
      DynamicWhereClause = 
           'C.CutIn IS NOT NULL AND ' + 
           'C.CutIn <> '' '' AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = AC.Card AND ' +
           'AC.TypeOfCard = ' + VARCHAR(:TypeOfCard$TFMS) + ' AND ' +
           'AC.Division IN ( ';
   
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'VALIDATION ERROR: Filter attribute must be ' +
          'equal to 1) Active Out of Service or 2) Active InService. ' + 
          'Please report error to Technical Support.';
   ENDIF;

   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
            
      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
           
      ENDIF;
   ENDIF;

   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;

   CurObject.OSS.Clear();
   i = 1;
   SELECT DISTINCT
           :CurObject.OSS[i].Card = C.Card,
           :CurObject.OSS[i].CardName = AC.CardName,
           :CurObject.OSS[i].Cutout = IFNULL(C.Cutout,''),
           :CurObject.OSS[i].Cutin = IFNULL(C.Cutin,''),
           :CurObject.OSS[i].CardClass = C.CardClass,
           :CurObject.OSS[i].CardClassName = C.CardClassName
   FROM    SOA_ActiveCard AC,
           SOA_Card C
   WHERE   :DynamicWhereClause
   ORDER BY CardName
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   j = 1;
   WHILE j <= CurObject.OSS.LastRow() DO
      i = 1;
      OS.Clear();
      REPEATED
      SELECT :OS[i].OperatingStep = OS.OperatingStep,
             :OS[i].OperatingStepName = OS.OperatingStepName,
             :OS[i].StartTime = OS.StartTime,
             :OS[i].EndTime = OS.EndTime,
             :OS[i].DurationMins = OS.DurationMins
      FROM   TFMS_OperatingStep OS
      WHERE  OS.Card = :CurObject.OSS[j].Card 
      BEGIN
         IF OS[i].OperatingStep = OpSt$CO THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntCO <> 0 THEN
                  CurObject.OSS[j].COColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].COColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntCO = CurObject.OSS[j].IntCO + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntCO <> 0 THEN
                  CurObject.OSS[j].COColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].COColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntCO = CurObject.OSS[j].IntCO + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].CO = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntCO);
            
         ELSEIF OS[i].OperatingStep = OpSt$INVS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntINVS <> 0 THEN
                  CurObject.OSS[j].INVSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].INVSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntINVS = CurObject.OSS[j].IntINVS + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntINVS <> 0 THEN
                  CurObject.OSS[j].INVSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].INVSColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntINVS = CurObject.OSS[j].IntINVS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].INVS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntINVS);

         ELSEIF OS[i].OperatingStep = OpSt$ISL THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntISL <> 0 THEN
                  CurObject.OSS[j].ISLColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ISLColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntISL = CurObject.OSS[j].IntISL + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntISL <> 0 THEN
                  CurObject.OSS[j].ISLColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ISLColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntISL = CurObject.OSS[j].IntISL + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ISL = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntISL);

         ELSEIF OS[i].OperatingStep = OpSt$GRND THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntGRND <> 0 THEN
                  CurObject.OSS[j].GRNDColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].GRNDColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntGRND = CurObject.OSS[j].IntGRND + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntGRND <> 0 THEN
                  CurObject.OSS[j].GRNDColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].GRNDColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntGRND = CurObject.OSS[j].IntGRND + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].GRND = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntGRND);

         ELSEIF OS[i].OperatingStep = OpSt$LOC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntLOC <> 0 THEN
                  CurObject.OSS[j].LOCColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].LOCColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntLOC = CurObject.OSS[j].IntLOC + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntLOC <> 0 THEN
                  CurObject.OSS[j].LOCColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].LOCColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntLOC = CurObject.OSS[j].IntLOC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].LOC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntLOC);

         ELSEIF OS[i].OperatingStep = OpSt$ID THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntID <> 0 THEN
                  CurObject.OSS[j].IDColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].IDColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntID = CurObject.OSS[j].IntID + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntID <> 0 THEN
                  CurObject.OSS[j].IDColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].IDColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntID = CurObject.OSS[j].IntID + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ID = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntID);

         ELSEIF OS[i].OperatingStep = OpSt$TC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntTC <> 0 THEN
                  CurObject.OSS[j].TCColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].TCColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntTC = CurObject.OSS[j].IntTC + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntTC <> 0 THEN
                  CurObject.OSS[j].TCColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].TCColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntTC = CurObject.OSS[j].IntTC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].TC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTC);

         ELSEIF OS[i].OperatingStep = OpSt$CONT THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntCONT <> 0 THEN
                  CurObject.OSS[j].CONTColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].CONTColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntCONT = CurObject.OSS[j].IntCONT + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntCONT <> 0 THEN
                  CurObject.OSS[j].CONTColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].CONTColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntCONT = CurObject.OSS[j].IntCONT + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].CONT = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntCONT);

         ELSEIF OS[i].OperatingStep = OpSt$HP THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntHP <> 0 THEN
                  CurObject.OSS[j].HPColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].HPColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntHP = CurObject.OSS[j].IntHP + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntHP <> 0 THEN
                  CurObject.OSS[j].HPColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].HPColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntHP = CurObject.OSS[j].IntHP + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].HP = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntHP);

         ELSEIF OS[i].OperatingStep = OpSt$AC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntAC <> 0 THEN
                  CurObject.OSS[j].ACColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ACColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntAC = CurObject.OSS[j].IntAC + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntAC <> 0 THEN
                  CurObject.OSS[j].ACColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ACColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntAC = CurObject.OSS[j].IntAC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].AC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntAC);

         ELSEIF OS[i].OperatingStep = OpSt$OTWR THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTWR <> 0 THEN
                  CurObject.OSS[j].OTWRColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWRColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTWR = CurObject.OSS[j].IntOTWR + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTWR <> 0 THEN
                  CurObject.OSS[j].OTWRColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWRColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntOTWR = CurObject.OSS[j].IntOTWR + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTWR = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWR);

         ELSEIF OS[i].OperatingStep = OpSt$OTWS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTWS <> 0 THEN
                  CurObject.OSS[j].OTWSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTWS = CurObject.OSS[j].IntOTWS + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTWS <> 0 THEN
                  CurObject.OSS[j].OTWSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWSColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntOTWS = CurObject.OSS[j].IntOTWS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTWS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWS);

         ELSEIF OS[i].OperatingStep = OpSt$PFS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPFS <> 0 THEN
                  CurObject.OSS[j].PFSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PFSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPFS = CurObject.OSS[j].IntPFS + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPFS <> 0 THEN
                  CurObject.OSS[j].PFSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PFSColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntPFS = CurObject.OSS[j].IntPFS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PFS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFS);

         ELSEIF OS[i].OperatingStep = OpSt$RS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntRS <> 0 THEN
                  CurObject.OSS[j].RSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].RSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntRS = CurObject.OSS[j].IntRS + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntRS <> 0 THEN
                  CurObject.OSS[j].RSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].RSColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntRS = CurObject.OSS[j].IntRS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].RS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntRS);

         ELSEIF OS[i].OperatingStep = OpSt$PDNX THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPDNX <> 0 THEN
                  CurObject.OSS[j].PDNXColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PDNXColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPDNX = CurObject.OSS[j].IntPDNX + 
                    INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPDNX <> 0 THEN
                  CurObject.OSS[j].PDNXColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PDNXColor = CC_FOREGROUND;                 
               ENDIF;
                
               CurObject.OSS[j].IntPDNX = CurObject.OSS[j].IntPDNX + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PDNX = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPDNX);

         ELSE 
            CALLPROC TraceError (UserMessage = 'Class:TFMS_MgtReports_ASE;Method:LoadMilestoneData; ' + HC_NEWLINE +
                  'Unknown OperatingStep was selected from TFMS_OperatingStep. ' + HC_NEWLINE +
                  'Card: ' + VARCHAR(CurObject.OSS[j].Card) + ' OperatingStep: ' + VARCHAR(OS[i].OperatingStep),
                                 TraceMessage = 'Class:TFMS_MgtReports_ASE;Method:LoadMilestoneData; ' +
                  'Unknown OperatingStep was selected from TFMS_OperatingStep. ' + HC_NEWLINE +
                  'Card: ' + VARCHAR(CurObject.OSS[j].Card) + ' OperatingStep: ' + VARCHAR(OS[i].OperatingStep));
         ENDIF;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
/*
** Combine ISL + GRND into PROT
*/   
      CurObject.OSS[j].IntPROT = CurObject.OSS[j].IntISL +
                                 CurObject.OSS[j].IntGRND;
      IF CurObject.OSS[j].IntPROT > 0 THEN
         CurObject.OSS[j].PROT = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPROT);

         IF CurObject.OSS[j].ISLColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].GRNDColor = CC_LIGHT_BLUE THEN
            CurObject.OSS[j].PROTColor = CC_LIGHT_BLUE;

         ELSEIF CurObject.OSS[j].ISLColor = CC_BLUE OR
            CurObject.OSS[j].GRNDColor = CC_BLUE THEN
            CurObject.OSS[j].PROTColor = CC_BLUE;

         ELSEIF CurObject.OSS[j].ISLColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].GRNDColor = CC_LIGHT_GRAY THEN
            CurObject.OSS[j].PROTColor = CC_LIGHT_GRAY;

         ELSE
           CurObject.OSS[j].PROTColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** Combine LOC + ID + TC + CONT + HP + AC into TEST
*/   
      CurObject.OSS[j].IntTEST = CurObject.OSS[j].IntLOC +
                                 CurObject.OSS[j].IntID +
                                 CurObject.OSS[j].IntTC +
                                 CurObject.OSS[j].IntCONT +
                                 CurObject.OSS[j].IntHP +
                                 CurObject.OSS[j].IntAC;
      IF CurObject.OSS[j].IntTEST > 0 THEN
         CurObject.OSS[j].TEST = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTEST);

         IF CurObject.OSS[j].LOCColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].IDColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].TCColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].CONTColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].HPColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].ACColor = CC_LIGHT_BLUE THEN

            CurObject.OSS[j].TESTColor = CC_LIGHT_BLUE;

         ELSEIF CurObject.OSS[j].LOCColor = CC_BLUE OR
            CurObject.OSS[j].IDColor = CC_BLUE OR
            CurObject.OSS[j].TCColor = CC_BLUE OR
            CurObject.OSS[j].CONTColor = CC_BLUE OR
            CurObject.OSS[j].HPColor = CC_BLUE OR
            CurObject.OSS[j].ACColor = CC_BLUE THEN

            CurObject.OSS[j].TESTColor = CC_BLUE;

         ELSEIF CurObject.OSS[j].LOCColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].IDColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].TCColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].CONTColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].HPColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].ACColor = CC_LIGHT_GRAY THEN

            CurObject.OSS[j].TESTColor = CC_LIGHT_GRAY;

         ELSE
           CurObject.OSS[j].TESTColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** Combine OTWR + OTWS into OTW
*/   
      CurObject.OSS[j].IntOTW = CurObject.OSS[j].IntOTWR +
                                 CurObject.OSS[j].IntOTWS;
      IF CurObject.OSS[j].IntOTW > 0 THEN
         CurObject.OSS[j].OTW = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTW);

         IF CurObject.OSS[j].OTWRColor = CC_LIGHT_BLUE OR
            CurObject.OSS[j].OTWSColor = CC_LIGHT_BLUE THEN
            CurObject.OSS[j].OTWColor = CC_LIGHT_BLUE;

         ELSEIF CurObject.OSS[j].OTWRColor = CC_BLUE OR
            CurObject.OSS[j].OTWSColor = CC_BLUE THEN
            CurObject.OSS[j].OTWColor = CC_BLUE;

         ELSEIF CurObject.OSS[j].OTWRColor = CC_LIGHT_GRAY OR
            CurObject.OSS[j].OTWSColor = CC_LIGHT_GRAY THEN
            CurObject.OSS[j].OTWColor = CC_LIGHT_GRAY;

         ELSE
           CurObject.OSS[j].OTWColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
**  Set Out of Service time.
*/      
      IF CurObject.OSS[j].CutOut = '' THEN
         CurObject.OSS[j].Outage = '';
      ELSE
         IF CurObject.OSS[j].CutIn = '' THEN
            CurObject.OSS[j].IntOutage = INT4(interval('minute',DATE('now') - DATE(CurObject.OSS[j].CutOut)));
            CurObject.OSS[j].Outage = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOutage);
            CurObject.OSS[j].OutageColor = CC_BLUE;
         ELSE
            CurObject.OSS[j].IntOutage = INT4(interval('minute',DATE(CurObject.OSS[j].CutIn) - DATE(CurObject.OSS[j].CutOut)));
            CurObject.OSS[j].Outage = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOutage);
            CurObject.OSS[j].OutageColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
       
      j = j + 1;       
   ENDWHILE;
   RETURN;
END;

METHOD Load_Legend (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load BogeyTimes for OperatingSteps.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.OSS.Clear();
   i = 1;
   SELECT :CurObject.OSS[i].OperatingStepName = T.Name,
          :CurObject.OSS[i].Description = T.Description
   FROM    Udb_Type T,
           Udb_SuperType ST
   WHERE   ST.SuperType = :CurObject.Filter AND
           ST.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Operating Step data found.';
      RETURN;
   ENDIF;
   
   RETURN;
END;

METHOD Load_OSDetails (
)=
DECLARE
   TimeNow = DATE NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Details for and operating step or delay.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK;
   
   i = 1;
   CurObject.OSS.Clear();
   SELECT :CurObject.OSS[i].OperatingStepName = OS.OperatingStepName,
          :CurObject.OSS[i].StartTime    = OS.StartTime,
          :CurObject.OSS[i].EndTime      = OS.EndTime,
          :CurObject.OSS[i].DurationMins = OS.DurationMins,
          :CurObject.OSS[i].Description  = T.Description,
          :CurObject.OSS[i].CardName     = OS.CardName
   FROM   TFMS_OperatingStep OS,
          Udb_ExtendedType ST,
          Udb_Type T
   WHERE  OS.Card = :CurObject.Card AND
          OS.OperatingStep = T.Type AND
          ST.SuperType = :CurObject.Filter AND
          ST.Type = T.Type
   ORDER BY StartTime
   BEGIN
      IF CurObject.OSS[i].EndTime = '' THEN
         CurObject.OSS[i].DurationMins = INT4(interval('minute',TimeNow - 
                                      DATE(CurObject.OSS[i].StartTime)));
      ENDIF;
      CurObject.OSS[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = 
                                      CurObject.OSS[i].DurationMins);           
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Details found.';
      RETURN;
   ENDIF;
   
   RETURN;
END;

METHOD Load_ReportCardTypes (
)=
DECLARE
   i   = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load card types to view on 
** management reports.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Load CardTypes
*/
   CurObject.OSS.Clear();
   i = 1;
   SELECT CurObject.OSS[i].CardClassName = Name,
          CurObject.OSS[i].CardClass     = Type
   FROM   Udb_Type
   WHERE  Type IN (SELECT Type
                   FROM   Udb_ExtendedType
                   WHERE  SuperType = :Type$TFMSCardClass AND
                          Type <> :Type$TFMSCardClass)
   ORDER BY CardClassName
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No card types found in database.';
   ENDIF;
   RETURN;
END;

METHOD Load_CardDetails (
)=
DECLARE
   TimeNow = DATE NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Operating Step  
** history associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK;

   i = 1;
   CurObject.OSS.Clear();
   REPEATED
   SELECT :CurObject.OSS[i].OperatingStepName = OS.OperatingStepName,
          :CurObject.OSS[i].StartTime = OS.StartTime,
          :CurObject.OSS[i].EndTime = OS.EndTime,
          :CurObject.OSS[i].DurationMins = OS.DurationMins
   FROM   TFMS_OperatingStep OS
   WHERE  OS.Card = :CurObject.Card 
   ORDER BY StartTime
   BEGIN
      IF CurObject.OSS[i].EndTime = '' THEN
         CurObject.OSS[i].DurationMins = INT4(interval('minute',TimeNow - DATE(CurObject.OSS[i].StartTime)));
      ENDIF;
      CurObject.OSS[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[i].DurationMins);        
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No operating step data found for card.';
      RETURN;
   ENDIF;
      
   RETURN;
END;


METHOD Load_Lines (
)=
DECLARE
   DivCheck = INTEGER NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load lines associated with a division.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   DivCheck = 0;
   SELECT :DivCheck = COUNT(*) 
   FROM    Udb_Object 
   WHERE   Object = :CurObject.Division AND
           Type = :Type$Division;

   IF DivCheck = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please select a valid division.';
      RETURN;
   ENDIF;
   
   CurObject.Olist.Clear();
   i = 1;
   REPEATED
   SELECT  :CurObject.Olist[i].Object = O.Object,
           :CurObject.Olist[i].Name = O.Name
   FROM    Udb_Object O,
           Udb_Grouping G 
   WHERE   G.MemberType = :Type$Line AND
           G.Relationship = :Interaction$MemberOf AND 
           G.Grouping = :CurObject.Division AND
           G.Member = O.Object
   ORDER BY Name
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

METHOD Load_XA21Outage(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DivisionList = VARCHAR(60) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1000);
ENDDECLARE
BEGIN

   DynamicWhereClause = 'X.OutageRecorded BETWEEN ''' + VARCHAR(CurObject.StartDate) + 
                        ''' AND ''' + VARCHAR(CurObject.EndDate) + ''' AND ' +
               'X.Substation = S.Object AND ' +
               'X.OutageObject = A.Object AND ' +
               'X.Equip = E.Object ';
   
   IF NOT lowercase(CurObject.DivisionName) LIKE 'all%' THEN
      i = 1;
      WHILE LENGTH(CurObject.DivisionName) > 0 DO
         CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   

         IF DivisionList = '' THEN
            DivisionList = VARCHAR(CurObject.Division);
         ELSE
            DivisionList = DivisionList +  + ',' + VARCHAR(CurObject.Division);
         ENDIF;
 
         i = i + 1;
         CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
      ENDWHILE;
      
      DynamicWhereClause = DynamicWhereClause + ' AND S.PrimaryGrouping IN (' + DivisionList + ')';
   ENDIF;
   
   i = 1;
   SELECT :CurObject.XL[i].Division = S.PrimaryGrouping,
          :CurObject.XL[i].DivisionName = S.PrimaryGroupingName,
          :CurObject.XL[i].Recorded = X.OutageRecorded,
          :CurObject.XL[i].OutageType = X.OutageType,
          :CurObject.XL[i].OutageObject = A.Object,
          :CurObject.XL[i].OutageObjectName = A.Name,
          :CurObject.XL[i].OutageObjectTypeName = A.TypeName,
          :CurObject.XL[i].Substation = S.Object,
          :CurObject.XL[i].SubstationName = S.Description,
          :CurObject.XL[i].Equip = E.Object,
          :CurObject.XL[i].EquipName = E.Name,
          :CurObject.XL[i].EquipClassName = E.TypeName,
          :CurObject.XL[i].DeviceTime = X.DeviceTime
   FROM   XA21_OutageReport X,
          Udb_Object S,
          Udb_Object A,
          Udb_Object E
   WHERE  :DynamicWhereClause
   ORDER BY Division, Recorded, DeviceTime
   BEGIN
      i = i + 1;
   END;   
   CALLPROC DDB_ROLLBACK;
END;

METHOD RequestCFGEReport(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
      
   CurrentApplication = 'FMS Online';
   RetCode = CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'TFMS_CFGEReport',
                     EventText = CurObject.Email);

   IF RetCode = PU_CANCEL THEN 
      CurMethod.Trace(Text = varchar(date('now')) + ':TFMS_MgtReports_ASE.RequestCFGEReport. ERROR: ' + 
             'Unable to request CFGE report.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Unable to request CFGE report. Try again';
   ENDIF;
END;

