METHOD SaveRequest (
) = 
DECLARE
   ByEmpID = VARCHAR(8) NOT NULL WITH DEFAULT;
   ByName = VARCHAR(40) NOT NULL WITH DEFAULT;
   ConfirmExists = INTEGER NOT NULL WITH DEFAULT;
   ReturnCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Database Procedure will insert or update; confirm existence to determine mode
*/
   ConfirmExists = 0;
   IF CurObject.RequestID > 0 THEN
      SELECT :ConfirmExists = RequestID
      FROM   OSS_Request
      WHERE  RequestID = :CurObject.RequestID;
   ENDIF;
   
   IF ConfirmExists = CurObject.RequestID THEN  
      ByEmpID = CurObject.ModByEmpID;
      ByName = CurObject.ModByName;
   ELSE
      CurObject.RequestID = -1;
      ByEmpID = CurObject.EnterByEmpID;
      ByName = CurObject.EnterByName;
   ENDIF; 

   ReturnCode = CALLPROC OSS_RequestIns (
                             RequestID = CurObject.RequestID,
                             UpdateTime = DATE('now'),
                             ByEmpID = ByEmpID,
                             ByName = ByName,
                             Substation = CurObject.Substation,
                             Title = CurObject.Title,
                             Description = CurOBject.Description,
                             WorkGroup = CurObject.WorkGroup,
                             ContinuousDaily = CurObject.ContinuousDaily,
                             HoursPerDay = CurObject.HoursPerDay,
                             DaysPerWeek = CurObject.DaysPerWeek,
                             OutageDateTime = CurOBject.OutageDateTime,
                             StartDateTime = CurOBject.StartDateTime,
                             ReturnDateTime = CurObject.ReturnDateTime,
                             RecallTime = CurObject.RecallTime,
                             RecallTerm = CurObject.RecallTerm,
                             HTChange = CurObject.HTChange,
                             EquipOutTwice = CurObject.EquipOutTwice);

   IF ReturnCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'OSS_RequestClass.SaveRequest; Error saving OSS Request';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SaveRequest; ' + 
                'Error saving OSS Request');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
      /*
      ** return request id back to the client
      */
      CurObject.RequestID = ReturnCode;

      SELECT :CurObject.CurrentStatus = CurrentStatus
      FROM   OSS_Request
      WHERE  RequestID = :CurObject.RequestID;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;


METHOD RescindOrDenyRequest ( 
) =
DECLARE
ENDDECLARE
BEGIN 
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Status <> 8 AND CurObject.Status <> 9 THEN  /* Status must be Rescind or Deny */
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'OSS_RequestClass.RescindOrDenyRequest; Improper Rescind or Deny Status';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.RescindOrDenyRequest; ' + 
                'Improper Rescind or Deny Status');
      RETURN;
   ENDIF; 

   CurObject.ReturnCode = CALLPROC OSS_ReqRescindDeny (
                             RequestID = CurObject.RequestID,
                             Status = CurObject.Status,
                             RescindDenyTime = DATE('now'),
                             RescindDenyByEmpID = CurObject.RescindDenyByEmpID,
                             RescindDenyByName = CurObject.RescindDenyByName,
                             RescindDenyReason = CurObject.RescindDenyReason);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_RequestClass.RescindOrDenyRequest; Error Rescinding or Denying Request';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.RescindOrDenyRequest; ' + 
                'Error Rescinding or Denying Request');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;

      SELECT :CurObject.CurrentStatus = CurrentStatus
      FROM   OSS_Request
      WHERE  RequestID = :CurObject.RequestID;
      CALLPROC DDB_ROLLBACK;
   ENDIF;                           
END;


METHOD DeleteRequest ( 
) =
DECLARE
ENDDECLARE
BEGIN 
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC OSS_RequestDel (
                             RequestID = CurObject.RequestID);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_RequestClass.DeleteRequest; Error Deleting Request';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.DeleteRequest; ' + 
                'Error Deleting Request');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;                           
END;


METHOD SubmitRequest ( 
) =
DECLARE
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Get Current Status and call appropriate DB Proc
*/
   CurObject.Status = 0;
   SELECT :CurObject.Status = Status
   FROM   OSS_Request
   WHERE  RequestID = :CurObject.RequestID;

   IF CurObject.Status = 0 OR CurObject.Status >=8 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Request does not exist or has been closed';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Request does not exist or has been closed');
      RETURN;
   ENDIF; 
/*
** For certain approval levels, need to send Notification message
*/
   IF CurObject.Status = 1 THEN

      CurObject.ReturnCode = CALLPROC OSS_ReqSubmitForApproval (
                               RequestID = CurObject.RequestID,
                               ModTime = DATE('now'),
                               ModByEmpID = CurObject.ModByEmpID,
                               ModByName = CurObject.ModByName);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Unable to approve request';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Error Approving Request');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;                           

      MsgText = '<a target="fms" href="<%type=oss&id=' + VARCHAR(CurObject.RequestID) + '%>">Outage Request</a> ' +
                   'submitted for Level 1 Approval';

      CALLPROC CSD_MessageIns(DeskType = 'to'
                       ,MessageText = MsgText 
                       ,MessageType = 0
                       ,Card = 0
                       ,Priority = 0
                       ,Time = date('now'));
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.Status = 2 THEN
   
      CurObject.ReturnCode = CALLPROC OSS_ReqLevel1Approval (
                               RequestID = CurObject.RequestID,
                               Level1Time = DATE('now'),
                               Level1ByEmpID = CurObject.ModByEmpID,
                               Level1ByName = CurObject.ModByName);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Unable to approve request';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Error Approving Request');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;                           

      MsgText = '<a target="fms" href="<%type=oss&id=' + VARCHAR(CurObject.RequestID) + '%>">Outage Request</a> ' +
                   'submitted for Level 2 Approval';

      CALLPROC CSD_MessageIns(DeskType = 'to'
                       ,MessageText = MsgText 
                       ,MessageType = 0
                       ,Card = 0
                       ,Priority = 0
                       ,Time = date('now'));
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.Status = 3 THEN
   
      CurObject.ReturnCode = CALLPROC OSS_ReqLevel2Approval (
                               RequestID = CurObject.RequestID,
                               Level2Time = DATE('now'),
                               Level2ByEmpID = CurObject.ModByEmpID,
                               Level2ByName = CurObject.ModByName);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Unable to approve request';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Error Approving Request');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;                           

      MsgText = '<a target="fms" href="<%type=oss&id=' + VARCHAR(CurObject.RequestID) + '%>">Outage Request</a> ' +
                   'submitted for Level 3 Approval';

      CALLPROC CSD_MessageIns(DeskType = 'to'
                       ,MessageText = MsgText 
                       ,MessageType = 0
                       ,Card = 0
                       ,Priority = 0
                       ,Time = date('now'));
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.Status = 4 THEN
   
      CurObject.ReturnCode = CALLPROC OSS_ReqLevel3Approval (
                               RequestID = CurObject.RequestID,
                               Level3Time = DATE('now'),
                               Level3ByEmpID = CurObject.ModByEmpID,
                               Level3ByName = CurObject.ModByName);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Unable to approve request';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Error Approving Request');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;                           

      MsgText = '<a target="fms" href="<%type=oss&id=' + VARCHAR(CurObject.RequestID) + '%>">Outage Request</a> ' +
                   'submitted for SWP Approval';

      CALLPROC CSD_MessageIns(DeskType = 'to'
                       ,MessageText = MsgText 
                       ,MessageType = 0
                       ,Card = 0
                       ,Priority = 0
                       ,Time = date('now'));
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.Status = 5 THEN
   
      CurObject.ReturnCode = CALLPROC OSS_ReqSWPAssignment (
                               RequestID = CurObject.RequestID,
                               SWPTime = DATE('now'),
                               SWPByEmpID = CurObject.ModByEmpID,
                               SWPByName = CurObject.ModByName,
                               SWP = CurObject.SWP);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_RequestClass.SubmitRequest; Unable to approve request';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_RequestClass.SubmitRequest; ' + 
                'Error Approving Request');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;                           

   ENDIF;

   SELECT :CurObject.Status = Status,			      
          :CurObject.CurrentStatus = CurrentStatus			      
   FROM   OSS_Request 
   WHERE  RequestID = :CurObject.RequestID;
END;

METHOD LoadDetail(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;
   m  = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeMapping = TypeClass_ASE;
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.RequestID = P.RequestID,
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.EnterTime = P.EnterTime,		    
          :CurObject.EnterByEmpID = P.EnterByEmpID,		      
          :CurObject.EnterByName = P.EnterByName,		      
          :CurObject.ModTime = P.ModTime,		    
          :CurObject.ModByEmpID = P.ModByEmpID,		      
          :CurObject.ModByName = P.ModByName,		      
          :CurObject.Level1Time = P.Level1Time,		    
          :CurObject.Level1ByEmpID = P.Level1ByEmpID,		      
          :CurObject.Level1ByName = P.Level1ByName,		      
          :CurObject.Level2Time = P.Level2Time,		    
          :CurObject.Level2ByEmpID = P.Level2ByEmpID,		      
          :CurObject.Level2ByName = P.Level2ByName,		      
          :CurObject.Level3Time = P.Level3Time,		    
          :CurObject.Level3ByEmpID = P.Level3ByEmpID,		      
          :CurObject.Level3ByName = P.Level3ByName,		      
          :CurObject.SWPTime = P.SWPTime,		    
          :CurObject.SWPByEmpID = P.SWPByEmpID,		      
          :CurObject.SWPByName = P.SWPByName,		      
          :CurObject.Status = P.Status,			      
          :CurObject.CurrentStatus = P.CurrentStatus,			      
          :CurObject.WorkGroup = P.WorkGroup,        
          :CurObject.WorkGroupName = T.Name,        
          :CurObject.Title = P.Title,			    
          :CurObject.Description = P.Description,
          :CurObject.ContinuousDaily = P.ContinuousDaily,
          :CurObject.HoursPerDay = P.HoursPerDay,
          :CurObject.DaysPerWeek = P.DaysPerWeek,
          :CurObject.SWP = P.SWP,
          :CurObject.OutageDateTime = P.OutageDateTime,
          :CurObject.StartDateTime = P.StartDateTime,
          :CurObject.ReturnDateTime = P.ReturnDateTime,
          :CurObject.RecallTime = P.RecallTime,
          :CurObject.RecallTerm = P.RecallTerm,
          :CurObject.HTChange = P.HTChange,
          :CurObject.EquipOutTwice = P.EquipOutTwice,
          :CurObject.RescindDenyByEmpID = P.RescindDenyByEmpID,
          :CurObject.RescindDenyTime = P.RescindDenyTime,
          :CurObject.RescindDenyByName = P.RescindDenyByName,
          :CurObject.RescindDenyReason = P.RescindDenyReason
   FROM   OSS_Request P,
          Udb_Object O, 
          Udb_Type T 
   WHERE  P.RequestID = :CurObject.RequestID AND
          P.Substation = O.Object AND
          P.WorkGroup = T.Type;
   CALLPROC DDB_ROLLBACK;

/*
** Convert Type to RR Types
*/
   TypeMapping.GetEquipTypeMapping();

   j = 1;
   SELECT :CurObject.WorkItem[j].RequestID = WI.RequestID,
          :CurObject.WorkItem[j].WorkItem = WI.WorkItem,
          :CurObject.WorkItem[j].PrimaryEquip = WI.PrimaryEquip,
          :CurObject.WorkItem[j].PrimaryEquipName = O.Name,
          :CurObject.WorkItem[j].PrimaryEquipType = O.Type,
          :CurObject.WorkItem[j].PrimaryEquipTypeName = O.TypeName
   FROM   OSS_WorkItem WI,
          Udb_Object O
   WHERE  WI.RequestID = :CurObject.RequestID AND
          WI.PrimaryEquip = O.Object
   ORDER BY 2
   BEGIN 
      IF TypeMapping.CList.LastRow > 0 THEN
         RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                         Value = CurObject.WorkItem[j].PrimaryEquipType,
                                         RowNumber = ByRef(m));
         IF RetCode = ER_OK THEN
            CurObject.WorkItem[j].PrimaryEquipTypeName = TypeMapping.CList[m].Description;
         ENDIF;
      ENDIF;
      k = 1;
      SELECT :CurObject.WorkItem[j].ImpactedEquip[k].RequestID = IE.RequestID,
             :CurObject.WorkItem[j].ImpactedEquip[k].WorkItem = IE.WorkItem,
             :CurObject.WorkItem[j].ImpactedEquip[k].Equip = IE.Equip,
             :CurObject.WorkItem[j].ImpactedEquip[k].EquipName = O.Name,
             :CurObject.WorkItem[j].ImpactedEquip[k].EquipType = O.Type,
             :CurObject.WorkItem[j].ImpactedEquip[k].EquipTypeName = O.TypeName
      FROM   OSS_ImpactedEquip IE,
             Udb_Object O
      WHERE  IE.RequestID = :CurObject.WorkItem[j].RequestID AND
             IE.WorkItem = :CurObject.WorkItem[j].WorkItem AND
             IE.Equip = O.Object
      BEGIN 
         IF TypeMapping.CList.LastRow > 0 THEN
            RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                         Value = CurObject.WorkItem[j].ImpactedEquip[k].EquipType,
                                         RowNumber = ByRef(m));
            IF RetCode = ER_OK THEN
               CurObject.WorkItem[j].ImpactedEquip[k].EquipTypeName = TypeMapping.CList[m].Description;
            ENDIF;
         ENDIF;
         k = k + 1;
      END;
      j = j + 1;
   END;
END;

Application Component Report
============================

	Name:            OSS_ScenarioTrace

/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OSS_WorkItem
**
**  Date:       Version Description
** ----------------------------------
**  09/04/08    em      Revised Scenario Builder for OSS.
*/

PROCEDURE OSS_ScenarioTrace
(
    StartPoint = INTEGER NOT NULL;     /* Passed Trace StartPoint */
/*
** Possible StopPoint values and their meanings are:
**    DeEnBreaker  - we are just looking for de-energizing breakers, do not
**                   collect equip traversed list, just the breakers.
**    VisibleBreak - stop trace at first visible break, collect equipment.
**    OutboardDisc - stop trace at outboard disconnect, collect equipment, but
**                   exclude inboard disconnect from equipment list.
*/
    BreakerTypes = ARRAY OF INTEGEROBJECT;  /*Valid de-en brkr types*/
    BusSectionStation   = INTEGER NOT NULL; /* Scope of Bus Section trace*/
    CardScope   = INTEGER NOT NULL;         /* Equip w/i scope of card */
    CE = INTEGER NOT NULL WITH DEFAULT;     /*CollectedEquipment Index*/
    CollectedEquip = ARRAY OF ConnectedEquipClass;  /*Return Equip List*/
    ConnectedEquip = ARRAY OF ConnectedEquipClass;  /*Trace equip loop*/
    Currentlyopen = INTEGER;
    DeEnBreakerType = INTEGER NOT NULL;     /*Based on type of card*/
    DeviceOpen = INTEGER NOT NULL;          /*BOOLEAN*/ 
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;
    ExcludedNodes   = Array of IntegerObject;
    i = INTEGER;                            
    j = INTEGER;
    k = INTEGER;                            
    m = INTEGER;          
    n = INTEGER NOT NULL;
    FdrObject = ConnectedEquipClass;
    SubType = INTEGER NOT NULL;
    ScenarioType = INTEGER NOT NULL;
    StopPoint  = VARCHAR(24) NOT NULL; /* Passed Trace Stop Point */
    SpareBreakers = ARRAY OF ConnectedEquipClass;  /* Selected Spare Breakers */          
    MoreObjects = INTEGER NOT NULL WITH DEFAULT;    /*Loop control*/                            
    OpenDevices = ARRAY OF INTEGEROBJECT;           /*Electrical Verification*/
    RetCode = INTEGER NOT NULL;                     /*return variable */
    StartEquip = ConnectedEquipClass;               /*Start Object*/
    StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
    SourceBkrStation   = INTEGER NOT NULL; /* Scope of Group Disconnect trace for Source Breakers */
    SourceBreakTypes = ARRAY OF INTEGEROBJECT; /* Source breaker types*/
    TempEquip = ARRAY OF ConnectedEquipClass;       /*Next connected object*/
    TypeFound = INTEGER NOT NULL WITH DEFAULT;      /*BOOLEAN*/
    VisBreakTypes = ARRAY OF INTEGEROBJECT; /*Valid visible break types*/
) =
BEGIN
    CollectedEquip.Clear();
    ExcludedNodes.Clear();

    SELECT  :StartEquip.Object = O.Object
,           :StartEquip.Type = O.Type
,           :StartEquip.Name = O.Name
,           :StartEquip.PrimaryGrouping = O.PrimaryGrouping
,           :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
    FROM    Udb_Object O
    WHERE   O.Object = :StartPoint;
    BusSectionStation = StartEquip.PrimaryGrouping;
    SourceBkrStation =  StartEquip.PrimaryGrouping;
    CollectedEquip[1] = StartEquip.Duplicate();

    IF iirowcount <= 0 THEN
       Message 'Did not find Start Point Object.';
       RETURN PU_CANCEL;
    ENDIF;
/*
** Determine Equipment type to control trace.
*/
    DeEnBreakerType = Type$LoadBreaking;
    ScenarioType = 0;
    SELECT :ScenarioType = ET.SuperType
    FROM   Udb_ExtendedType ET
    WHERE  ET.Type = :StartEquip.Type AND
           ET.SuperType IN (:Type$Transformer,:TypeName$BusSect,:Type$BREAKER, :Type$Source,
                            :Type$PowerTransformer,:Type$PhaseShifter,:Type$Reactor,:Type$ManDiscBus,:Type$ACLineSegment);

    IF ScenarioType = 0 THEN
       RETURN PU_OK;
    ENDIF;

    IF ScenarioType = Type$PowerTransformer OR
           ScenarioType = Type$PhaseShifter OR
           ScenarioType = Type$Reactor THEN     
       StopPoint = 'DeEnBreaker';

    ELSEIF ScenarioType = Type$ManDiscBus THEN
       StopPoint = 'SourceBreaker';

    ELSEIF ScenarioType = TypeName$BusSect OR 
            ScenarioType = Type$Transformer OR
            ScenarioType = Type$ACLineSegment THEN
       StopPoint = 'OutboardDisc';

    ELSEIF ScenarioType = Type$BREAKER OR 
           ScenarioType = Type$Source THEN
       StopPoint = 'VisibleBreak';
    ENDIF;
/*
** Load our search arrays.
*/
    i = 1;
    BreakerTypes.Clear();
    REPEATED
    SELECT :BreakerTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType IN (:Type$BREAKER, :Type$Source)
    ORDER BY 1
    BEGIN
       i = i + 1;
    END;

    i = 1;
    VisBreakTypes.Clear();
    REPEATED
    SELECT
    DISTINCT :VisBreakTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType IN 
            (:Type$Disconnect,:Type$CktSwer,:Type$BkrRO,:Type$BkrROspare,:Type$BusTie)  
    BEGIN
       i = i + 1;
    END;

    i = 1;
    SourceBreakTypes.Clear();
    REPEATED
    SELECT
    DISTINCT :SourceBreakTypes[i].Value = Type
    FROM   Udb_ExtendedType
    WHERE  SuperType IN (:Type$Source, :Type$BREAKER)  
    BEGIN
       i = i + 1;
    END;
/*
** For Group Disconnect trace, get the node where the group disconnect is connected 
** to the bus section. We will trace away from the bus section to find source breakers.
*/
    IF ScenarioType = Type$ManDiscBus THEN
       SELECT :ExcludedNodes[1].Value = T1.Node
       FROM   udb_terminal t1,
              udb_terminal t2,
              udb_object o2
       WHERE  T1.object = :StartEquip.Object and
              T1.Node > 20000 AND
              T1.node = T2.node and
              T2.object = O2.object and
              O2.type = :TypeName$BusSect;      // 22240 
    ENDIF;
/*
** Prepare the trace loop
*/
    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ' +
                        'T1.Object IN (';

    ConnectedEquip.Clear();
    ConnectedEquip.InsertRow(Rownumber = 1, 
                             RowObject = StartEquip.Duplicate());
    DynamicWhereClause = VARCHAR(StartEquip.Object) + ')';

    i = 1;
    MoreObjects = TRUE;
    WHILE MoreObjects = TRUE DO
      MoreObjects = FALSE;

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */
      IF ExcludedNodes.LastRow > 0 THEN 
         DynamicWhereClause = DynamicWhereClause + ' AND T1.Node NOT IN (';
         k = 1;
         WHILE k <= ExcludedNodes.LastRow() DO
           IF K = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[k].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause +  
                                   ',' + VARCHAR(ExcludedNodes[k].Value);
           ENDIF;

           k = k + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';

         ExcludedNodes.Clear();
      ENDIF;

      DynamicWhereClause = StaticWhereClause + DynamicWhereClause; 

      TempEquip.Clear();
      j = 1;
      SELECT :TempEquip[j].Object = T2.Object
,            :TempEquip[j].Terminal = T2.Terminal
,            :TempEquip[j].Node  = T2.Node
,            :TempEquip[j].Used = 0 
,            :TempEquip[j].OutboundBreakerFound = :FALSE
,            :TempEquip[j].Type = O.Type
,            :TempEquip[j].Name = O.Name
,            :TempEquip[j].TypeName = O.TypeName
,            :TempEquip[j].Description = O.Description
,            :TempEquip[j].PrimaryGrouping = O.PrimaryGrouping
,            :TempEquip[j].PrimaryGroupingName = O.PrimaryGroupingName
,            :TempEquip[j].PrevObject = T1.Object
      FROM  Udb_Terminal T1,
            Udb_Terminal T2,
            Udb_Object O
      WHERE :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          ExcludedNodes.InsertRow (RowNumber = j); 
          ExcludedNodes[j].Value = TempEquip[j].Node;
          j = j + 1;
      END;            

      /* 
      **  Algorithm (see documentation):  
      **     1) Check for card scope
      **     1B) Bus Section Trace scope check
      **     2) Collecting Equip?
      **     3) De-En Breaker? Include equipment up to De-En Breaker for Deluge Test
      **     4) Visible Break?
      **     5) Add to collection if appropriate
      **     6) Check for stop point
      */
      k = 1;
      WHILE k <= TempEquip.LastRow() DO
/*
** Check if equip within the scope of the card
*/
         CardScope = 1;
         IF ScenarioType = TypeName$BusSect THEN

            CardScope = 1; 
            IF TempEquip[k].PrimaryGrouping <> BusSectionStation THEN
               TempEquip[k].Used = 1;
               CardScope = 0;
            ENDIF;
 
         ELSEIF ScenarioType = Type$ManDiscBus THEN  
            CardScope = 1; 
            IF TempEquip[k].PrimaryGrouping <> SourceBkrStation OR
               TempEquip[k].Type = TypeName$BusSect THEN
               /* Just stop trace in this direction */
               TempEquip[k].Used = 1;
               CardScope = 0;
             ENDIF;

         ENDIF;

         IF CardScope = 1 THEN 
/*
** Check if we are just looking for the De-Energizing Breaker.
*/
            IF StopPoint = 'DeEnBreaker' THEN
/*
** Is the device a de-energizing Breaker?
*/
               TypeFound = FALSE;
               TypeFound = CALLPROC ArraySearch (
                 SearchArray = BreakerTypes,
                 TargetObject = TempEquip[k].Type);

               IF TypeFound = TRUE THEN
                  TempEquip[k].Used = 1;
               ENDIF;

            ELSEIF ScenarioType = Type$ManDiscBus THEN  
               RetCode = SourceBreakTypes.Find(AttributeName = 'value',
                                               Value = TempEquip[k].Type);
               IF RetCode = ER_OK THEN
                  TempEquip[k].Used = 1;
               ENDIF;

            ELSE
/*
** Set the OutBound Breaker Flag =  the previous equipment.
*/
               FOR n = 1 TO ConnectedEquip.LastRow() DO
                  IF TempEquip[k].PrevObject = ConnectedEquip[n].Object THEN
                      TempEquip[k].OutBoundBreakerFound = 
                               ConnectedEquip[n].OutBoundBreakerFound;
                      ENDLOOP;
                  ENDIF;
               ENDFOR;
/*
** Check if we are looking for an outboard disconnect.
*/
                IF StopPoint = 'OutboardDisc' THEN 
/*
** Is the device a de-energizing Breaker?
*/
                  TypeFound = FALSE;
                  TypeFound = CALLPROC ArraySearch (
                     SearchArray = BreakerTypes,
                     TargetObject = TempEquip[k].Type);
 
                  IF TypeFound = TRUE THEN
                     TempEquip[k].OutBoundBreakerFound = TRUE;
                  ENDIF;
               ENDIF;
/*
** Is the device a Visible Break?
*/
               TypeFound = FALSE;
               TypeFound = CALLPROC ArraySearch (
                 SearchArray = VisBreakTypes,
                 TargetObject = TempEquip[k].Type);

               IF TypeFound = TRUE THEN
/*
** Stop trace on this path if this is an Outbound Disconnect, otherwise
** check if we need to stop at the first Visible Break.  IF this is and
** Inboard Disconnect, we can exclude from equipment list.
*/
                  IF TempEquip[k].OutBoundBreakerFound = TRUE THEN
                     TempEquip[k].Used = 1;

                  ELSEIF StopPoint = 'VisibleBreak'  THEN                 
                     TempEquip[k].Used = 1;

                  ELSEIF TempEquip[k].Type = Type$DiscGrdBkr THEN
                     /* Want to look for outbound disconnect on this path */
                        TempEquip[k].OutBoundBreakerFound = TRUE;
                      ENDIF;
 
                  ENDIF;
                    
               ENDIF;
            ENDIF;
 /*
** Add equipment to collection list if we are collecting it.
*/
/*
**  Make sure it is not a duplicate, if not insert it.
*/
            RetCode = CollectedEquip.Find(AttributeName = 'object',
                                       Value = TempEquip[k].Object);

            IF RetCode = ER_ROWNOTFOUND THEN              
               CE = CE + 1;
               CollectedEquip.InsertRow(RowNumber = CE,
                              RowObject = TempEquip[k].Duplicate());
/*
** If member of a line/feeder, add line/feeder also
*/
               FdrObject.Object = 0;
               REPEATED
               SELECT  :FdrObject.Object = O.Object,
                       :FdrObject.Type = O.Type,
                       :FdrObject.TypeName = O.TypeName,
                       :FdrObject.Name = O.Name
               FROM    Udb_Object O,
                       Udb_Grouping G
               WHERE   G.Member = :TempEquip[k].Object AND
                       G.Relationship = :Interaction$MemberOf AND
                       G.Grouping = O.Object AND
                       O.Type IN (:Type$Feeder, :Type$Line);

               IF FdrObject.Object <> 0 THEN 

                  RetCode = CollectedEquip.Find(AttributeName = 'object',
                                       Value = FdrObject.Object);

                  IF RetCode = ER_ROWNOTFOUND THEN              
                     CE = CE + 1;
                     CollectedEquip.InsertRow(RowNumber = CE,
                              RowObject = FdrObject.Duplicate());
                  ENDIF;                  

               ENDIF;
            ENDIF;
            
         k = k + 1
      ENDWHILE;

      DynamicWhereClause = '';

      j = 1;
      WHILE j <= TempEquip.LastRow() DO
         RetCode = ConnectedEquip.Find(AttributeName = 'object',
                                       Value = TempEquip[j].Object);

         IF RetCode = ER_ROWNOTFOUND THEN   /* new equipment found */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                           RowObject = TempEquip[j].Duplicate());
/*
** If Used = 1, then we are at a Stop Point and we don't continue trace
** on this path.
*/
            IF ConnectedEquip[i].Used = 0 THEN
               MoreObjects = TRUE;
               IF DynamicWhereClause = '' THEN
                  DynamicWhereClause = VARCHAR(ConnectedEquip[i].Object);
               ELSE
                  DynamicWhereClause = DynamicWhereClause + 
                           ',' + VARCHAR(ConnectedEquip[i].Object);
               ENDIF;
            ENDIF;
         ENDIF;
         j = j + 1;
      ENDWHILE;
      IF MoreObjects = TRUE THEN
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;
    ENDWHILE;

                        
    RETURN(PU_OK);
END;  

