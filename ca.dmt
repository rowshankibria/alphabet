	Name:            ForceStatus

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
*/
/*
**  Application:    FeederCard
**  Frame:          ForceStatus 
**
**  Modifications:
**  11/09/92  em    Created 
**  11/25/92  em    added mutual exclusive checks for BT on back from work.
**                  used two deletes rather than an OR to make DDB conversion 
**                  easier. 
**  11/27/92  em    added mutual exclusivity for C/O and RS.  Also bumped
**                  count in addition to time update for duplicates. 
**  11/27/92  em    added mutual exclusivity for DL and ISM. 
**  12/06/92  mts   Updated db calls to use dbprocs for dual database
**  01/11/93  mts   Added DDB_COMMIT After database changes         
**  02/04/93  em    don't delete OTW status when forcing work statuses.
**                  must be performed via jobactions on OTW moves.
**  02/25/93  em    remove FGO when coming back from work, look for status
**                  of blank or BT.
**  03/15/93  em    removed commit;  revised otw status logic again
**  07/07/94  em    added return code checking
**  01/14/11  em    When setting RS feeder status, clear all other feeder statuses.
**  03/14/18  pkw   When setting RS feeder status, don't clear MTAOpen status.
*/
PROCEDURE ForceStatus 
(
    Feeder = INTEGER NOT NULL;          /*PassedFeeder*/
    NewStatus = INTEGER NOT NULL;       /*PassedStatus*/ 
    SelectCount = INTEGER;              /*SelectionResult*/
    RetCode = INTEGER NOT NULL WITH DEFAULT; /*Return Code */
    MTACheck = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Program called from within code, most statuses are set via the JobAction
**  methods - this program provides an exception. 
**  Forces the Feeder status to be set.  Several statuses are mutually
**  exclusive - these are noted below.
*/
    IF NewStatus = Status$DBF THEN  /* Mutually exclusive with ABF */ 

      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$ABF);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;

    ELSEIF NewStatus = Status$ABF THEN  /* Mutually exclusive with DBF */ 

      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$DBF);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;

    ELSEIF NewStatus = Status$CO  THEN  /* Mutually exclusive with RS  */ 

      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$RS);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;

    ELSEIF NewStatus = Status$RS  THEN  /* Mutually exclusive with CO  */ 
      /*
      ** Check if MTAOpen exists.  If it does reinsert it later.
      */
      MTACheck = 0;
      SELECT :MTACheck = COUNT(*)
      FROM    FMS_ObjectStatus
      WHERE   Object = :Feeder AND
              Status = :Status$MTAOpen; 

      RetCode = CALLPROC FMS_AllObjStatusDel 
                        (Object = Feeder);

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
/*
      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$CO);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$ISM);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$DL);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$Blank);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
*/
    ELSEIF NewStatus = Status$DL  THEN  /* Mutually exclusive with ISM */ 

      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$ISM);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;

    ELSEIF NewStatus = Status$ISM THEN  /* Mutually exclusive with DL  */ 

      RetCode = CALLPROC FMS_ObjStatDel(Object = Feeder, Status = Status$DL);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;

    ENDIF;
/* 
**  Check to make sure not already set.  If it is, Update the time and Bump count. 
*/
    SelectCount = 0;
    REPEATED
    SELECT :SelectCount = Count(*) 
    FROM   FMS_ObjectStatus
    WHERE  Object = :Feeder AND
           Status = :NewStatus; 

    IF SelectCount = 0 THEN 

      RetCode = CALLPROC FMS_ObjStatIns( 
				Object = Feeder, 
				Status = NewStatus, 
				StatusCount = 1, 
				TimeSet = date('now')
			      );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
           
    ELSEIF SelectCount > 0 THEN

       RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
			Object = Feeder, 
			Status = NewStatus, 
            increment = 1,
            TimeSet = date('now'));
       IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          RETURN (PU_CANCEL);
       ENDIF;

    ENDIF;
    
    IF MTACheck <> 0 THEN
       RetCode = CALLPROC FMS_ObjStatIns( 
				Object = Feeder, 
				Status = Status$MTAOpen, 
				StatusCount = 1, 
				TimeSet = date('now')
			      );
       IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          RETURN (PU_CANCEL);
       ENDIF;  
    ENDIF;

    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            FormatDate

/*
**
**      Copyright c 2000 ALSTOM ESCA Corporation.  All rights reserved.
**
**      ALSTOM ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA Corporation.
**
*/
/*
**  Application:    CAC
**  Frame:          FormatDate
**
**  Date:       Version Description
** ----------------------------------
**  06/11/09  ysp Created From ConvertDate.
**  01/05/18  ysp Add format for DATE_ONLY
*/
PROCEDURE FormatDate (
    RawDate		= DATE NOT NULL		/*Input Parameter*/
  , Format     = VARCHAR(10) NOT NULL WITH DEFAULT /*Input: DATE_ONLY, SHORT, DEFAULT, FULL */   

  , OutputDate		= CHAR(19) NOT NULL	/*Output*/
  , DY			= INTEGER NOT NULL      /*Date Year*/		
  , DM			= INTEGER NOT NULL      /*Date Month*/		
  , DD			= INTEGER NOT NULL      /*Date Day*/		
  , DH			= INTEGER NOT NULL      /*Date Hour*/		
  , DMi			= INTEGER NOT NULL      /*Date Minute*/		
  , DS			= INTEGER NOT NULL      /*Date Second*/		
  , Char2  = CHAR(2) NOT NULL      /*Two Characters*/
  , SpaceAnd2		= CHAR(3) NOT NULL      /*Need Space in front of Char2*/
) = 
BEGIN
   DY = date_part('year',RawDate);
   DM = date_part('month',RawDate);
   DD = date_part('day',RawDate);
   DH = date_part('hour',RawDate);
   DMi = date_part('minute',RawDate);
   DS = date_part('second',RawDate);
/*
** Build fields to be two characters.  Year by default will be four.
*/
   CALLPROC PadInteger (RawInteger = DM, 
                        DesiredLength = 2,
                        OutputChar = BYREF(Char2));
   OutputDate = Char2 + '/';

   CALLPROC PadInteger (RawInteger = DD, 
                        DesiredLength = 2,
                        OutputChar = BYREF(Char2));
   OutputDate = VARCHAR(OutputDate) + Char2;

   IF Format <> 'SHORT' THEN
      OutputDate = VARCHAR(OutputDate) + '/';
      OutputDate = VARCHAR(OutputDate) + VARCHAR(DY);
   ENDIF;
   
   IF Format = 'DATE_ONLY' THEN
      RETURN OutputDate;
   ENDIF;

   // Add Hour/Minute
   CALLPROC PadInteger (RawInteger = DH, 
                        DesiredLength = 2,
                        OutputChar = BYREF(Char2));
   SpaceAnd2 = ' ' + Char2;
   OutputDate = VARCHAR(OutputDate) + SpaceAnd2;
   OutputDate = VARCHAR(OutputDate) + ':';

   CALLPROC PadInteger (RawInteger = DMi, 
                        DesiredLength = 2,
                        OutputChar = BYREF(Char2));
   OutputDate = VARCHAR(OutputDate) + Char2;

   IF FORMAT = 'FULL' THEN
      OutputDate = VARCHAR(OutputDate) + ':';
      CALLPROC PadInteger (RawInteger = DS, 
                        DesiredLength = 2,
                        OutputChar = BYREF(Char2));
      OutputDate = VARCHAR(OutputDate) + Char2;
   ENDIF;

   RETURN OutputDate;
END;

Application Component Report
============================

	Name:            GenerateFODOrder

/*
**
**      Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    FMS
**  Frame:          GenerateFODOrder
**
**  Date:       Version Description
** ----------------------------------
**  04/09/01    my     created
**  05/01/02    pkw    when selecting equipment only put equipment name
**                     in comment field.
**  05/14/02    em     Removed "DO" from the front of the DO Name.  Takes
**                     up too much space on the wireless unit. 
**  11/22/02    pkw    MERGE work.
**  01/06/03    ysp    ITC 114: Use DoLogin to select a DO.
**  01/24/03    pkw    Change MoveFlag to Status.  MoveFlag is obsolete.
**  02/28/03    ysp    FOD2: Save movetype and priority into the order tables.
**  03/12/03    ysp    Check each move to make sure that no move is in 
**                     an oustanding order.
**  03/14/03    ysp    Check for "AC" in the move text for AC high pot move type
**  03/18/03    ysp    fix previous oustanding order validation.
**  03/27/03    ysp    Commented out check for Fault move type.
**  01/14/03    em     Set up and save FOD Order but don't submit it to FOD
**                     in Process Auto SetUp mode.
**  03/17/04    em     Parse text string with Stepheading to build Auto Block Title 
**  10/25/04    em     When setting up order for process automation, give it
**                     an initial order status of Order$Setup
**  11/30/04    pkw    Add logic for #9 operator.
**  10/20/05    em     Updated Outgoing Message
**  11/22/05    pkw    Make sure card is inservice before requiring a phase check.
**  12/14/05    ysp    Increase the size of tomove to 160 chars
**  12/16/05    em     Load CutIn/CutOut at top since CardDetails may not be current
**  07/18/06    ysp    Use ACHighPot prompt to determine for AC high pot move type
**  04/16/07    ysp    ITC210: Insert IR interface event in DB event queue
**  06/28/07    em     Set Target Relays in case Record Faulted Phases is downloaded manually.
**  04/02/08    em     Remove Record Faulted Phases case.
**  06/12/09    pkw    Remove ability to change logged in DO.
**  12/08/09    ysp    add support for AC Modified High Pot type (4)
**  03/22/11    ysp    FMS 397: add COMMON_LOCATION move type.
**  04/06/11    em     Changed method of determining CommonLocation move type
**  03/30/16    ysp    Show the substation HTOD number if the order is to a unit substation
**  10/13/16    ysp    Merge: Apply 33kv portion orders to the main feeder.
**  04/07/22    em     Update in support of 3G to save a non -1 feeder.
*/ 
INITIALIZE
(
    IssuedMoves = ARRAY OF JobInProgress;  /*Passed list of Moves*/
    Card = FMS_Card;                 /*Passed Card class*/
    FODEmployee = INTEGER NOT NULL;  /*Passed FOD*/
) =
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;

    ControlText = VARCHAR(256) NOT NULL;    /* For DBEvent   */
    MessageField = VARCHAR(800) NOT NULL;     /*Completion Message*/
    MsgKey = INTEGER NOT NULL;                /*Return MsgID*/
    OrderNumber = INTEGER NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    TORS = INTEGER NOT NULL;    /* Takeout or Restore */
    OrderCheck = INTEGER NOT NULL;
    OrderStatus = INTEGER NOT NULL;           /*Initial Order Status*/
    OrderTypeName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SequenceType = VARCHAR(20) NOT NULL WITH DEFAULT;
    PhaseCheckReq = INTEGER NOT NULL WITH DEFAULT;
    FODMoveType = VARCHAR(20) NOT NULL WITH DEFAULT;
    Priority = VARCHAR(20) NOT NULL WITH DEFAULT;
    StepHeading = VARCHAR(100) NOT NULL WITH DEFAULT;
    UnitStationOrder = INTEGER NOT NULL WITH DEFAULT;

   UpdateMapNumbers = PROCEDURE;
ENDDECLARE
BEGIN
/*
** Setup moves takeout/restore side for display only.
*/
   UnitStationOrder = FALSE;

   FOR i = 1 TO IssuedMoves.LastRow() DO
      Jobs[i] = IssuedMoves[i].Duplicate();
      IF IssuedMoves[i].Status = Job$Restore THEN
         Jobs[i].TOIssued = Jobs[i].RSIssued;
         Jobs[i].TOMove = Jobs[i].RSMove;
      ENDIF;

      Jobs[i].ReturnRemark = '';			// HTOD 
      SELECT :UnitStationOrder = :TRUE,
             :Jobs[i].Substation = O.Object,
             :Jobs[i].SubstationName = O.Description,
             :Jobs[i].ReturnRemark = O.SpecNumber
      FROM   Udb_Grouping G,
             UDB_Object O
      WHERE  G.Member = :Jobs[i].Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$UnitSubstation AND
             G.Grouping = O.Object;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   IF UnitStationOrder = FALSE THEN
      FIELD(Jobs[*].ReturnRemark).CurBias = FB_INVISIBLE;
   ENDIF;

   Equip.Clear(); 

   Equip[1].PrintID = '';
   Equip[1].Equip = :Object$Null; 
   Equip[1].EquipName = '';
   Equip[1].EquipClassName  = 'MH';

   Equip[2].PrintID = '';
   Equip[2].Equip = :Object$Null; 
   Equip[2].EquipName = '';
   Equip[2].EquipClassName  = 'P';

   i = 3;
   REPEATED
   SELECT
         :Equip[i].PrintID = G.Reference,
         :Equip[i].Equip = O.Object, 
         :Equip[i].EquipName = O.Name,
         :Equip[i].EquipClassName  = O.TypeName
   FROM  Udb_Object O,
         Udb_Grouping G,
         Udb_ExtendedType ET,
         Udb_ExtendedType ET2,
         TFMS_CardToObject CTO
   WHERE CTO.Card = :Card.Card AND
         CTO.Type = ET2.Type AND
         ET2.SuperType = :Type$Feeder AND
         G.Grouping = CTO.Object AND
         G.Relationship = :Interaction$MemberOf AND
         G.Member = O.Object AND
         O.Type = ET.Type AND
         O.Type NOT IN (:Type$AbstractHTV,
                        :Type$ISOGrouper,
                        :Type$Loop) AND 
         ET.SuperType = :Type$Switch
   ORDER BY PrintID, EquipClassName, EquipName
   BEGIN
	   i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   PhraseList.Clear();
   i = 1;
   SELECT :PhraseList[i].PhraseText = T.Name
   FROM   Udb_Type T,
          Udb_Supertype S
   WHERE  S.Supertype = :Type$FODPhrase and
          S.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   DistrictOperator = DOp.Description;
   DOComment = '';
/*
**  Set up Order type field
*/
   IF FODEmployee = Operator$NO9 THEN
      OrderTypeName = '#9';
   ELSE
      OrderTypeName = 'FOD';
   ENDIF;
/*    
** Load Card Details for current CutIn/CutOut
*/
   SELECT :CardDetails.CutOut = CutOut,
          :CardDetails.CutIn = CutIn
   FROM   FMS_Card
   WHERE  Card = :CardDetails.Card; 
/*
**  Modify freetrim shown throughout the screen
*/
   FIELD(Generate_trim).TextValue = 'Generate ' + OrderTypeName + ' Order';
   FIELD(DOComment_trim).TextValue = 'Optional DO Comment for the ' + OrderTypeName + ':';
END;

ON CHILDENTRY PhraseList =
BEGIN
/*
** Build Comment
*/
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = FIELD(PhraseList).CurRow;
      IF LENGTH(DOComment) <> 0 THEN
         DOComment = DOComment + ' ';
      ENDIF;
      DOComment = DOComment + PhraseList[i].PhraseText;
   ENDIF;
END;


ON CHILDENTRY Equip =
BEGIN
/*
** Build Comment
*/
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = FIELD(Equip).CurRow;
      IF LENGTH(DOComment) <> 0 THEN
         DOComment = DOComment + ' on ';
      ENDIF;
      DOComment = DOComment + Equip[i].EquipName;
   ENDIF;
END;

ON CLICK Add_Btn =
DECLARE
   MainFeeder = INTEGER NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Create Operating Order and link moves to the order.
*/
   IF DistrictOperator = '' THEN
      MESSAGE 'Please identify the District Operator issuing the ' + 
               OrderTypeName + ' Order';
      RESUME;
   ENDIF;

   IF FIELD(SubDetails).CurBias <> FB_INVISIBLE THEN
      MESSAGE 'Please close the substation map number screen.';
      RESUME;
   ENDIF;
/*
** If the order is issued from a 33k portion card, set the order feeder to be the main feeder
*/
   MainFeeder = 0;
   IF Card.NetworkFeeder = NetworkFeeder$33KV AND Card.TypeOfCard = TypeOfCard$Portion THEN
      SELECT :MainFeeder = C.Feeder,
             :FeederName = C.FeederName
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :Card.Card AND
             L.Card = C.Card;
      CALLPROC DDB_ROLLBACK;
      
      FeederName = FeederName + ' ' + SQUEEZE(Card.FeederName);
   ELSEIF Card.NetworkFeeder = NetworkFeeder$3G THEN
      REPEATED
      SELECT :MainFeeder = O.Object,
             :FeederName = O.Name
      FROM   Udb_Object O,
             TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  CTO.Card = :Card.Card AND
             CTO.Type = ET.Type AND
             ET.SuperType = :Type$Feeder AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$SourceBreaker AND
             G.Grouping = O.Object;
   ELSE
      MainFeeder = Card.Feeder;
      FeederName = Card.FeederName;
   ENDIF;   
   
   IF MainFeeder = 0 THEN
         MESSAGE 'Error identifying main feeder from the NetworkFeeder.  Unable to build FOD order without it.';
         RETURN PU_CANCEL;
   ENDIF;
/*
**  Make sure none of the moves is in an Opened/Download/Acknowledged status.
*/
   For i = 1 to Jobs.LastRow() DO
      IF Jobs[i].Status = Job$Restore THEN
         TORS = 1;
      ELSEIF Jobs[i].Status = Job$TakeOut THEN
         TORS = 0;
      ENDIF;

      OrderCheck = 0;
      SELECT :OrderCheck = J.Job 
      FROM   IR_FODOrderJobs J
      WHERE  J.Job = :Jobs[i].Job AND
             J.ToRs = :ToRS AND
             J.JobStatus IN (:Order$Opened,:Order$Downloaded,:Order$Acknowledged);
      CALLPROC DDB_ROLLBACK;
   
      IF OrderCheck <> 0 THEN
         MESSAGE 'Job: ' + Jobs[i].TOMove + ' is already in an outstanding ' + 
               OrderTypeName + ' order.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDFOR;

   IF MoveSequence = 0 THEN
      SequenceType = 'UNSEQUENCED';
   ELSE
      SequenceType = 'SEQUENCED';
   ENDIF;
      
   IF PriorityType = 0 THEN
      Priority = '';
   ELSE
      Priority = 'HIGH';
   ENDIF;

   OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
   IF (OrderNumber < 0) THEN
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Error: Could not generate an Order Number.  Try again. ' +
               'Udb_Lastkey table may not be synchronous between servers. ';
       RESUME;
   ELSE
       CALLPROC DDB_COMMIT;
   ENDIF;

   IF ProcessAutoMode = TRUE THEN
      OrderStatus = Order$SetUp;
   ELSE
      OrderStatus = Order$Opened;
   ENDIF;

   RetCode = CALLPROC IR_FODOrderIns (
                                        OrderNumber = OrderNumber,
                                        Feeder = MainFeeder,
                                        Card = Card.Card,
                                        OrderStatus = OrderStatus,
                                        SequenceType = SequenceType,
                                        IssuedByDO = DistrictOperator,
                                        FODEmployeeObject = FODEmployee,
                                        OrderComment = DOComment,
                                        OrderTarget = OrderTypeName,
                                        IssueTime = 'now',
                                        Priority = Priority);
                                       
   IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to generate new ' + 
               OrderTypeName + ' Order due to an error.';
        RETURN PU_CANCEL;
   ENDIF;

   FOR i = 1 TO Jobs.LastRow() DO 
      IF Jobs[i].Status = Job$Restore THEN
         TORS = 1;
      ELSEIF Jobs[i].Status = Job$TakeOut THEN
         TORS = 0;
      ENDIF;

      PhaseCheckReq =0;
      IF Jobs[i].Status = Job$Restore AND 
        (CardDetails.Cutout IS NULL OR 
         CardDetails.CutIn IS NOT NULL) AND 
        (Jobs[i].StepPair = StepHeading$Deload OR
         Jobs[i].StepPair = StepHeading$ISO) THEN

         SELECT :PhaseCheckReq = 1 
         FROM   FMS_PhaseCheck
         WHERE  Card = :Card.Card AND
                SatisfyEquip = :Jobs[i].Equip AND
                CompletionTime IS NULL;

      ENDIF;

      /*
      ** determine the move type and set the parameter values
      */
      j = 0;
      SELECT :j = Status
      FROM    FMS_JobAction
      WHERE   JobClass = :Jobs[i].JobClass AND
              EquipClass = :Jobs[i].MoveEquipClass AND
              StepPair = :Jobs[i].StepPair AND
              TypeOfCard = :Card.TypeOfCard AND
              TORS = :TORS AND
              IssueCompl = 1 AND                                     /* look for prompts at move completion time */
              Action = :JobAction$Prompt AND
              Status IN(:Prompt$CheckDBF,
                        :Prompt$HighPotDist,:Prompt$ModHighPotDist,:Prompt$ACHighPotDist,:Prompt$ACModHighPotDist,
                        :Prompt$AmmeterClearDist,
                        :Prompt$Phases,
                        :Prompt$Relay,
                        :Prompt$CommonLocation);

/* commented out for phase 1: 
                        :Prompt$EnterFault
*/

      IF j = Prompt$CheckDBF THEN                   /* Dead Back Feed */
         FODMoveType = 'DEAD_ON_BACKFEED';

      ELSEIF j = Prompt$HighPotDist THEN            /* High Pot */
         FODMoveType = 'HIGHPOT';

      ELSEIF j = Prompt$ModHighPotDist THEN         /* Mod High Pot */
         FODMoveType = 'MODHIGHPOT';

      ELSEIF j = Prompt$ACHighPotDist OR j = Prompt$ACModHighPotDist THEN          /* AC or Modified High Pot */
         FODMoveType = 'ACHIGHPOT';

      ELSEIF j = Prompt$AmmeterClearDist THEN       /* ammeter clear */ 
         FODMoveType = 'AMMETER_CLEAR';

      ELSEIF j = Prompt$Phases THEN                 /* CATC Phases */
         FODMoveType = 'CATC_PHASES';

      ELSEIF j = Prompt$Relay  THEN                  /* Target Relays */
         FODMoveType = 'TARGET_RELAY';

      ELSEIF j = Prompt$EnterFault THEN             /* Fault */
         FODMoveType = 'FAULT';

      ELSEIF j = Prompt$CommonLocation THEN             /* Common Location */
         FODMoveType = 'COMMON_LOCATION';

      ELSE
         FODMoveType = 'GENERAL'; 
      ENDIF;

      RetCode = CALLPROC IR_FODOrderJobsIns (
                                        OrderNumber = OrderNumber,
                                        Seq = i,
                                        TORS = TORS,
                                        JobStatus = Order$Opened,
                                        PhaseCheckReq = PhaseCheckReq,
                                        Job = Jobs[i].Job,
                                        MoveType = FODMoveType);
      IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to link jobs to new ' + 
               OrderTypeName + ' Order due to an error.';
        RETURN PU_CANCEL;
      ENDIF;

   ENDFOR;
   CALLPROC DDB_COMMIT;
 
   IF ProcessAutoMode = TRUE THEN
      RetCode = CALLPROC SOA_LogIns (Card = Card.Card,
                                  SwitchingItem = 0,
                                  Job  = Jobs[1].Job,
                                  Time = DATE('now'),
                                  UserName = UserName,
                                  Item     = OrderTypeName + ' Order',
                                  Old      = 'For FOD Automation',
                                  New      = 'Order Number: ' +
                                              Varchar(OrderNumber));

   ELSE
      MessageField = OrderTypeName + ' Order ' + varchar(ordernumber) + 
                  ' has been issued to ' + FODName; 

      RetCode = CALLPROC SOA_LogIns (Card = Card.Card,
                                  SwitchingItem = 0,
                                  Job  = Jobs[1].Job,
                                  Time = DATE('now'),
                                  UserName = UserName,
                                  Item            = OrderTypeName + ' Order',
                                  Old             = 'For ' + OrderTypeName + ' ' + FODName,
                                  New             = 'Order Number: ' +
                                                 Varchar(OrderNumber));
   ENDIF;
  
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to log generation of ' + 
               OrderTypeName + ' Order due to an error.';
   ELSE   
      CALLPROC DDB_COMMIT;
   ENDIF; 

   IF ProcessAutoMode = FALSE THEN
/*
** Now insert message for tracking purposes.
*/
      MsgKey = CALLPROC MSG_SendMsg (Card = Card.Card,
                                  Action = 0,
                                  OrderNumber = IFNULL(OrderNumber,0), 
                                  Substation = MainFeeder,
                                  SubstationName = FeederName,
                                  Msg = 'New ' + OrderTypeName + ' Order for ' +
                                        'Feeder ' + FeederName + '.  ' +
                                        HC_NEWLINE + 
                                        'First Move: ' + Jobs[1].TOMove, 
                                 
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = OrderTypeName,
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message.' + 
              '  You might want to contact the ' + 
               OrderTypeName + ' to ' +
              'confirm that he has received the order.';
         MESSAGE :MessageField;
      ELSE
         CALLPROC DDB_COMMIT;
         RetCode = CALLPROC IR_FODOrderMsgKeyUpd (MsgKey = MsgKey,
                                        OrderNumber = OrderNumber);
         IF Retcode = 0 THEN
           CALLPROC DDB_COMMIT;
         ELSE
           CALLPROC DDB_ROLLBACK;
           MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message id.' + 
              '  You might want to contact the ' + 
               OrderTypeName + ' to ' +
              'confirm that he has received the wireless order.';
           MESSAGE :MessageField;
         ENDIF;
      ENDIF;

      ControlText = varchar(ordernumber); 
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_NewFODOrder', 
                     EventText = ControlText);  
   ELSE
/* 
** Build Block Title and Using Step Heading and words after the description
/* Save order for Process Automation Execution.
*/    
      SELECT :StepHeading = SQUEEZE(Name) + ' ' 
      FROM   FMS_StepPair
      WHERE  TypeOfCard = :Type$13kVCard AND
             StepPair = :Jobs[1].StepPair;

      IF Jobs[1].Status = Job$TakeOut THEN
         StepHeading = SQUEEZE(LEFT(StepHeading,LOCATE(StepHeading,' '))) + ': ';
        
         i = 0;
         i = LOCATE(Jobs[1].TOMove, '-');
         IF i = (SIZE(Jobs[1].TOMove) + 1) THEN
            StepHeading = StepHeading + Jobs[1].TOMove;
         ELSE
            StepHeading = SQUEEZE(StepHeading + SHIFT(Jobs[1].TOMove, -1 * i));
         ENDIF;
      ELSE
         i = 0;
         i = LOCATE(SHIFT(StepHeading, -1 * (LOCATE(StepHeading,' '))),'-');
         IF i <> (SIZE(StepHeading) + 1) THEN
             StepHeading = SQUEEZE(SHIFT(StepHeading, -1 * (i+1)));
         ENDIF;
         StepHeading = StepHeading + ': ';

         i = 0;
         i = LOCATE(Jobs[1].RSMove, '-');
         IF i = (SIZE(Jobs[1].RSMove) + 1) THEN
            StepHeading = StepHeading + Jobs[1].RSMove;
         ELSE
            StepHeading = SQUEEZE(StepHeading + SHIFT(Jobs[1].RSMove, -1 * i));
         ENDIF;

      ENDIF;
      
      CALLFRAME DefineAutoBlock (
                  Card = Card.Card,
                  Block = OrderNumber,
                  SendTo = OrderTypeName,
                  Title = StepHeading);
   ENDIF;

   RETURN PU_OK;
END;

ON CLICK cancel_btn = 
BEGIN
   IF CurFrame.ConfirmPopup (messagetext = 
          'Exit without creating and sending the wireless ' + 
               OrderTypeName + ' Order?') = 
           PU_OK THEN
      RETURN PU_CANCEL;
   ENDIF;
END;

ON CHILDENTRY Jobs[*].ReturnRemark = 
BEGIN
   IF FIELD(Jobs[].ReturnRemark).BgColor = CC_PALE_BLUE THEN
      RESUME;
   ENDIF;
   SubDetails.SubObject.Substation = Jobs[].Substation;
   SubDetails.SubObject.SubstationName = Jobs[].SubstationName;

   SubDetails.SubstnNumber = Jobs[].ReturnRemark;

   FIELD(SubDetails).CurBias = FB_CHANGEABLE;
   Field(SubDetails).AbsXLeft = FormField(CurFrame.TriggerField).AbsXRight;
   Field(SubDetails).AbsYTop = FormField(CurFrame.TriggerField).AbsYTop;

   /** Handle case where popup would go to low on the screen */
   IF Field(SubDetails).AbsYBottom > field(Jobs).AbsYBottom THEN
      Field(SubDetails).AbsYBottom = field(Jobs).AbsYBottom;
   ENDIF;
   CurFrame.InputFocusField = FIELD(SubDetails.Cancel_btn);
   CurFrame.Flush();
END;

ON CLICK SubDetails.Update_btn =
BEGIN         
   SubDetails.SubObject.UpdateMapNumber(MapNumber = SubDetails.SubstnNumber);
   IF SubDetails.SubObject.ReturnCode <> 0 THEN
      MESSAGE SubDetails.SubObject.ErrorMessage;
      FIELD(SubDetails).CurBias = FB_INVISIBLE;
      RESUME;
   ELSE
      CALLPROC SOA_LogIns (Card = Jobs[1].Card,
                        Job = NULL,
                        SwitchingItem = Jobs[1].SwitchingItem,
                        UserName = UserName,
                        Time = DATE('now'),
                        Item = 'Substn Map Number Updated',
                        Old = '',
                        New = SubDetails.SubstnNumber);
      CALLPROC DDB_COMMIT;
   ENDIF;

   CALLPROC UpdateMapNumbers(
                        UpdatedSubstn = SubDetails.SubObject.Substation,
                        NewMapNumber = SubDetails.SubstnNumber,
                        SubstationName = SubDetails.SubObject.SubstationName);
   FIELD(SubDetails).CurBias = FB_INVISIBLE;
END;

ON CLICK SubDetails.Cancel_btn =
BEGIN        
   FIELD(SubDetails).CurBias = FB_INVISIBLE;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

PROCEDURE UpdateMapNumbers(
   UpdatedSubstn = INTEGER NOT NULL;
   NewMapNumber = VARCHAR(20) NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   FOR i = 1 TO Jobs.LastRow() DO
       IF Jobs[i].SubStation = UpdatedSubstn THEN
          Jobs[i].ReturnRemark = NewMapNumber;
          Jobs[i].SubstationName = SubstationName;
       ENDIF;  
   ENDFOR;
END;

Application Component Report
============================

	Name:            GenerateOperatingOrder

/*
