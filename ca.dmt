	Name:            PromptDropCheckCompletion

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptDropCheckResults
**
**  10/10/21  pkw  Created
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   InvalidEntry = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   LowPressure = INTEGER NOT NULL WITH DEFAULT;
   HighPressure = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   InvalidEntry = FALSE;
   Interval1 = -1;
   SELECT :LowPressure = I.LowPressure,
          :HighPressure = I.HighPressure,
          :Interval1 = I.Stage1Interval,
          :Duration1 = I.Stage1Duration,
          :Interval2 = I.Stage2Interval,
          :Duration2 = I.Stage2Duration
   FROM   DSO_DropCheckIssue I
   WHERE  I.Job = :JIP.Job;
   
   CurFrame.SendUserEvent(EventName = 'LoadTables');

END;

ON UserEvent 'LoadTables' =
DECLARE
   j = INTEGER NOT NULL WITH DEFAULT;
   numofint = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = 1;
   tf.Clear();
   SELECT :tf[i].Interval = R.Interval,
          :tf[i].Value    = R.Value
   FROM DSO_DropCheckResults R
   WHERE  R.Job = :JIP.Job
   ORDER BY Interval
   BEGIN
      FIELD(tf[i].Value).BGCOLOR = CC_PALE_PURPLE;
      i = i + 1;
   END;
   
   IF tf.LastRow <> 0 THEN
      FIELD(cancelbutton).CurBias = FB_INVISIBLE;
      FIELD(tf[*].Value).CurBias = FB_VISIBLE;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
   ELSE
      /*
      **  Set Stage1 table
      */
      numofint = INT4(Duration1/Interval1);
      tf.Clear();
      FOR i = 1 TO NumOfInt DO
         tf[i].Interval = INT4(Interval1 * i);
         tf[i].Value = NULL;
      ENDFOR;
      /*
      **  Set Stage2 table
      */
      i = tf.LastRow + 1;
      j = 1;
      numofint = INT4(Duration2/Interval2);
      WHILE j <= NumOfInt DO
         IF INT4(Interval2 * j) > Duration1 THEN
            tf[i].Interval = INT4(Interval2 * j);
            tf[i].Value = NULL;
            i = i + 1;
         ENDIF;
         j = j + 1;
      ENDWHILE;
   ENDIF;
   
   IF tf.LastRow <= 15 THEN
      FIELD(tf).NumVisibleRows = tf.LastRow;
      FIELD(tf).HasScrollBar = FALSE;
   ELSE
      FIELD(tf).NumVisibleRows = 15;
      FIELD(tf).HasScrollBar = TRUE;
   ENDIF;
 

   FIELD(LowValue).TextValue = 'Low Pressure: ' + VARCHAR(LowPressure) + ' PSI';
   FIELD(HighValue).TextValue = 'High Pressure: ' + VARCHAR(HighPressure) + ' PSI';
   
   CurFrame.IsAutosized = TRUE;
   CurFrame.Flush();   
END;

ON ChildSetValue tf[*].Value =
BEGIN
   IF tf[].Value > HighPressure OR
      tf[].Value < LowPressure THEN
      
      IF (CurFrame.ConfirmPopup(messagetext= 
	      'The PSI value entered is outside the low and high pressure limits and will stop further data entry.  Is this correct?') = PU_OK) THEN 

         InvalidEntry = TRUE;
         CurFrame.SendUserEvent(EventName = 'ProcessReturn');
         RESUME NEXT;
      ELSE 
         tf[].Value = NULL;
         CurFrame.InputFocusField = NULL;
         RESUME;
      ENDIF; 

   ENDIF;
END;

ON UserEvent 'ProcessReturn',
ON Click OKButton =
DECLARE
   Reading = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF FIELD(SSO_Result).CurBias <> FB_VISIBLE THEN

      IF InvalidEntry = FALSE THEN
         /*
         **  Confirm all values entered
         */
         FOR i = 1 TO tf.LastRow DO
            IF tf[i].Value IS NULL THEN
               IF (CurFrame.ConfirmPopup(messagetext= 
	              'Not all values have been entered.  Is this correct?') = PU_CANCEL) THEN 
               
                  RESUME;
               ELSE
                  ENDLOOP;
               ENDIF;  
            ENDIF;
         ENDFOR;
      ENDIF;
   ENDIF;
    
   Reading = '';
   FOR i = 1 TO tf.LastRow DO
      IF tf[i].Value IS NOT NULL THEN
         Reading = Reading + VARCHAR(ifnull(tf[i].Interval,'')) + ':' + VARCHAR(ifnull(tf[i].Value,'')) + ','; 

         IF FIELD(SSO_Result).CurBias <> FB_VISIBLE THEN

            RetCode = CALLPROC DSO_DropCheckResultsIns(
               Job = JIP.Job,
               Interval = ifnull(tf[i].Interval,''),
               Value = ifnull(tf[i].Value,''));
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record Drop Check Results.',
                           TraceMessage =
                  'PromptDropCheckCompletion: Unable to record results for job=' +
                   VARCHAR(JIP.Job));
               RETURN (PU_Cancel);
            ENDIF;        
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDFOR;
   
      
   
   RetCode = CALLPROC DSO_ReadingIns(
      Card = JIP.Card,
      Time = DATE('NOW'),
      Job = JIP.Job,
      Structure = JIP.Substation,
      Equip = JIP.Equip,
      ReadingType = 'Drop Check',
      Reading = Reading);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record Drop Check Results.',
                           TraceMessage =
                  'PromptDropCheckResults: Unable to record drop check results for ' +
                  'job=' + VARCHAR(JIP.job));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;

   JIP.Response = Squeeze(Reading + ' ' + JIP.Response);
   JIP.ResponseUpd();
                 
   RETURN (PU_OK);
END;

ON Click CancelButton =
BEGIN
   RETURN (PU_Cancel);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

