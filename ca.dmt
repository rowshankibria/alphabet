Application Component Report
============================

	Name:            ConnectedLines

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ConnectedLines          
**
**  Modifications:
**  03/09/06   em   Created; Objective is to return a list of Line Objects
**                  that can be reached from the start equipment.
**  09/18/15   em   Attempting to fix indexing run-time error
**  01/17/17   ysp  Converted to use QGis trace
*/
PROCEDURE ConnectedLines
(
   Equip         = INTEGER NOT NULL;     /*Start Parameter*/
   Job           = INTEGER NOT NULL;     /*Scope Parameter*/
   SearchObjects = ARRAY OF ObjectSummaryClass; /*Return Parameter*/
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   so		= INTEGER NOT NULL WITH DEFAULT;
   LineScope    = ARRAY OF ObjectSummaryClass;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
    
    Trace = Trace_ConnectedLines;
ENDDECLARE
BEGIN
/*
**  Scope of trace limited to lines on card.
**  Get list of equipment to limit scope and put associated line in PrimaryGrouping field.
*/
   LineScope.Clear();
   SearchObjects.Clear();
   
   so = 0;
   i = 1;
   REPEATED 
   SELECT DISTINCT
          :LineScope[i].Object = G.Member,            /*Equip*/
          :LineScope[i].PrimaryGrouping = O.Object,   /*Line*/
          :LineScope[i].PrimaryGroupingName = O.Name
   FROM   SOA_ActiveObject AO,
          Udb_Object O,
          SOA_JobControl JC,
          Udb_Grouping G
   WHERE  JC.Job = :Job AND
          JC.Card = AO.Card AND
          AO.ObjectToCardLink = 1 AND
          AO.Object = O.Object AND
          O.Type IN (   SELECT Type
                        FROM   Udb_ExtendedType
                        WHERE  SuperType = :Type$Line) AND
          O.Object = G.Grouping AND
          G.Relationship = :Interaction$MemberOf AND
          G.MemberType IN (  SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  SuperType = :Type$Conducting)
   BEGIN
      IF LineScope[i].Object = Equip THEN
         so = so + 1;
         SearchObjects[so].Object = LineScope[i].PrimaryGrouping;
         SearchObjects[so].Name = LineScope[i].PrimaryGroupingName;
      ENDIF;
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
/*
** start search with this piece of equipment and then branch out in all
** directions.  When a trace dies or reaches an Open device we discontinue
** the trace in that direction.  Scope of trace is limited to lines on card.
*/
   Trace.JCEquip.Object = Equip;

   Trace.LineScope = LineScope;
   Trace.SearchObjects = SearchObjects;
   Trace.StartTargetTrace();
   
   RETURN;
END;


