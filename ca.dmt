	Name:            PromptClearACFeedRemoved

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptClearACFeedRemoved
**
**  Modifications:
**  06/24/14   em   Created
**  07/29/14   em   Changed procedure call
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
) =
BEGIN
  
      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'acfeedremoved',
                FieldValue = 0
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to clear Valve AC Feed Removed.',
                           TraceMessage =
               'PromptClearACFeedRemoved: Unable to clear ACFeedRemoved ' +
               'device status for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;

END;

Application Component Report
============================

	Name:            PromptClearATSManualFromMacro

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    cac
**  Frame:          PromptClearATSManualFromMacro         
**
**  Modifications:
**  03/05/08   pkw  Created to handle ATS moves impacting both 101 and 102 
**                  performed against the ATS Macro device (the ATS 
**                  Superstructure). The move will appear as a common
**                  equipment move on all cards where the ATS Macro is a
**                  common equipment.  
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    ATS = ObjectSummaryClass;
    ATS102 = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device.
**  Then find its related ATS102 device.
*/ 
   ATS.Object = 0;
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'PromptSetATSFromMacro:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );
      RETURN (PU_CANCEL);
   ENDIF;

   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptSetATSManualFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;

   ATS102.Object = 0;
   REPEATED
   SELECT :ATS102.Object = O.Object,
          :ATS102.TypeName = O.TypeName,
          :ATS102.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS102);

   IF ATS102.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptSetATSManualFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;
/*
** ATS 101 and 102 device is found, now clear ATSManual status.
*/
   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS101.Object,
                                     Status = Status$ATSManual);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;

   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS102.Object,
                                     Status = Status$ATSManual);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;

   CALLPROC DDB_COMMIT;

   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptClearCurrentlyOpen

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptClearCurrentlyOpen
**
**  Modifications:
**  10/19/94   mts  Initial
**  05/13/96   em   Add call to FeederCardHeader Manager
**  06/18/96   pw   set xferflag in card table    
**  03/22/99   em   incorporated into SOA.  Commented out FMS specifics. 
**  07/01/02   ysp  Merge: Check for being FMS job, process FMS specifics.
**  11/01/02   em   Job to JIP.  Remove Xfer Flag update since that feature 
**                  is disabled.
**  12/18/03   em   Exit if in Process Auto Setup Mode
**  02/20/04   em   Convert Message to TraceError call
**  03/25/04   em   On Steam card, look to see if ISO Valve is
**                  being Closed. If so, we can update top of card.
**                  Removed commented xfer button code.
**  03/23/06   em   Add call to ConnectedSourceCutOutTrace for 
**                  potential connectivity based FMS Card CutIn 
**                  processing.
**  08/08/07   em   Include Valve when call procedure to update status
**  09/27/07   pkw  Make call to TOMS outage monitor.
**  10/20/07   pkw  Add SwitchingItem to fms_objectstatusins call.
**  10/24/07   pkw  Use database time for FMS_ObjectStatusQueue Insert.
**  12/31/07   em   Call promptcloseisovalve if Steam
**  01/17/08   pkw  Select time from soa_job table for FMS_ObjectStatusQueue insert.
**  01/24/08   pkw  Check that Switching Item <> 0 when issued from SLC
**  09/15/09   ysp  Substation Audit Log: add TORS and DOName to object status queue
**                  Also remove the restriction that excludes FMS application.
**  09/24/09   em   Confirm equip status change before inserting into Status Queue.
**  04/21/10   ysp  modified for DSO demo.
**  06/21/10   em   Add local procedure to CutIn3GFeeder
**  09/23/10   em   Revised 3G Cut In procedure.
**  02/08/11   em   CutInFeeder Proc must handle the possibility that more than 
**                  one feeder is returned.
**  03/05/11   pkw  Modify for role$dso.
**  08/29/13   em   Add procedure for sectional CutIn
**  10/02/13   pkw  Add procedure for KPS also
**  06/24/14   em   Remove NormalOpen for DSO valve due to DB proc change
**  07/29/14   em   Change procedure call  for DSO
**  03/01/17   em   Prepare DB Event Queue record when HTV-Fdr equipment status changes; remove
**                  SWP Outage logic by commenting it out.
**  03/20/17   em   HTV Breaker status for Manhattan only
**  09/05/17   em   Renable outage logic for new Outage Monitor
**  10/30/17   em   Add Outage Request InsService call.
**  02/20/17   em   Only go Inservice if TFMS Card CutOut is NULL.  If Card is CutOut, Inservice will
**                  be handled in PromptCheckCutIn
*/
INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */

    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL; 
    CutOutTimeStamp = DATE WITH NULL;
    ISOValveCard = INTEGER NOT NULL WITH DEFAULT;  
    ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
    DBTime  = DATE NOT NULL WITH DEFAULT;
    HTV = INTEGER NOT NULL WITH DEFAULT;
    StatusChange = INTEGER NOT NULL WITH DEFAULT;
    SingleSWP = OutageReport DEFAULT NULL;
) =
DECLARE
   CutIn3GFeeder = PROCEDURE;
   CheckForSectional = PROCEDURE;
BEGIN
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;

   IF CurrentApplication =  Application$DSO THEN

      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'currentlyopen',
                FieldValue = 0
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to clear Currently Open device status.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to clear Currently Open ' +
               'device status for switch object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ENDIF;

      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'cracked',
                FieldValue = 0
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to clear Cracked device status.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to clear Cracked ' +
               'device status for switch object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ENDIF;

      CALLPROC DDB_COMMIT;
      RETURN (PU_OK);

   ELSE
      StatusChange = FALSE;
      SELECT  :StatusChange = 1    /*TRUE*/
      FROM    Udb_Switch
      WHERE   Object = :JIP.Equip AND
              CurrentlyOpen = 1;

      RetCode = CALLPROC Udb_SwitchCurrentUpd(
                      Object = JIP.Equip,
                      CurrentlyOpen = 0);

      IF (RetCode <> 0) THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
               'ERROR: Unable to clear Currently Open device status.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to clear Currently Open ' +
               'device status for switch object=' + VARCHAR(JIP.Equip) + '.'
                           );
         RETURN (PU_CANCEL);
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF CurrentApplication = Application$SDS THEN
      ISOValveCard = 0;
      REPEATED
      SELECT  :ISOValveCard = C.Card
      FROM    SOA_ActiveObject C,
              Udb_Grouping G
      WHERE   G.Member = :JIP.Equip AND
              G.Relationship = :Interaction$SourcePosition AND
              G.Grouping = C.Object AND
              C.ObjectToCardLink = 1;

      IF ISOValveCard <> 0 THEN
         RetCode = CALLPROC SDS_ISOValveUpd (
                         Card = ISOValveCard,
                         ISOValve = JIP.Equip,
                         Status = 0);
         IF (RetCode <> 0) THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
               'ERROR: Unable to Update ISO Valve Status at top of card.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to Update ISO Valve Status ' +
               'for Card=' + VARCHAR(ISOValveCard) + '.'
                           );
         ELSE
            CALLPROC DDB_COMMIT;         
         ENDIF;
      ENDIF;
      CALLFRAME PromptCloseISOValve (JIP = JIP);

   ELSE
      CALLPROC FMS_ManageCardHeader (Equip = JIP.Equip);
      CALLPROC ConnectedSourceCutOutTrace (JIP = JIP, CloseOrOpen = 1);
      CALLPROC CutIn3GFeeder();
      CALLPROC CheckForSectional(Equip = JIP.Equip);
   ENDIF;
   
  IF StatusChange = TRUE THEN
   /*
   **  Select times from database in case user is using manual entry mode.
   */
   DBTime = '';
   IF JIP.Status = Job$TakeOut THEN
      SELECT :DBTIME = IFNULL(J.TOComplete,'')
      FROM    SOA_Job J
      WHERE   J.Job = :JIP.Job;
   ELSEIF JIP.Status = Job$Restore THEN
      SELECT :DBTIME = IFNULL(J.RSComplete,'')
      FROM    SOA_Job J
      WHERE   J.Job = :JIP.Job;        
   ENDIF;
   IF DBTime = '' THEN
      SELECT :DBTime = DATE('NOW');
   ENDIF;
/*
** Determine if Job Equip is an HTV-Fdr to initiate HTV Breaker Status change email.
*/
      HTV = 0;
      REPEATED
      SELECT :HTV = ET.Type
      FROM   Udb_ExtendedType ET,
             Udb_Object O,
             Udb_Grouping G1, 
             Udb_Grouping G2
      WHERE  ET.SuperType = :Type$HTVFdr AND
             ET.Type = O.Type AND 
             O.Object = :JIP.Equip AND
             O.Object = G1.Member AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = :Division$Manhattan;

      IF HTV > 0 THEN
         ControlText = VARCHAR(JIP.Equip) + ';CLOSED;' + VARCHAR(DBTime) + ';';
         CALLPROC InsertDBEventQueue(
                    ToApp = 'CSD',
                    EventName = 'FMS_HTVEmail',
                    EventText = ControlText);  
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** Record closed device for Outage Monitor handling
*/
       RetCode = CALLPROC FMS_ObjectStatusQueueIns (
         Time = DBTime,
         Object = JIP.Equip,
         Status = 0,
         Job = JIP.Job,
         TORS = JIP.ToRs,
         Card = JIP.Card,
         SwitchingItem = JIP.SwitchingItem,
         FromApp = CurrentApplication,
         DOName = DOp.Description);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                     TraceMessage =
         'PromptClearCurrentlyOpen: Unable to insert row into the ' +
         'FMS_ObjectStatusQueue table for Equip = ' + Varchar(JIP.Equip));
      ELSE 
         CALLPROC DDB_COMMIT;
         CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ObjectStatusQueue');
         CALLPROC DDB_COMMIT;
      ENDIF;
   /*
   ** Is this move associated to card with a CutOut timestamp? If it is, then
   ** we aren't looking to put an Outage Request InService by closing this device.
   ** Move might be performed on an SLC card associated with a transmission feeder outage.
   */
      CutOutTimeStamp = NULL;
      SELECT :CutOutTimeStamp = C.CutOut
      FROM   SOA_Card C,
             SOA_JobControl JC
      WHERE  JC.Job = :JIP.Job AND
             JC.Card = C.Card AND
             C.CutOut IS NOT NULL;
          
      IF CutOutTimeStamp IS NULL THEN
      /*
      ** this breaker may be on a card where a scheduled outage is being managed.  
      **/
         SingleSWP = OutageReport.Create();
         SingleSWP.SetActualInServiceDate(JIP = JIP);
      ENDIF;
  ENDIF;

   RETURN (PU_OK);
END;


PROCEDURE CutIn3GFeeder (
) =
DECLARE
   CutOutFeeder = ARRAY OF INTEGEROBJECT;
   FeederList = ARRAY OF ConnectedEquipClass;   
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   StationFeeder = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Is the current equipment a 3G Network Switch on a CutOut feedercard?
*/
   IF JIP.EquipClass <> Type$3GSwitch THEN
      RETURN;
   ENDIF;
   
   CutOutFeeder.Clear();
   i = 1;
   SELECT   :CutOutFeeder[i].Value = G.Grouping
   FROM     FMS_Card C,
            SOA_ActiveObject AO,
            Udb_Grouping G
   WHERE    G.Member = :JIP.Equip AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = AO.Object AND
            AO.Card = C.Card AND
            C.NetworkFeeder = 1 AND
            C.CutOut IS NOT NULL AND
            C.CutIn IS NULL
   BEGIN
      i = i + 1;
   END; 

   IF CutOutFeeder.LastRow() = 0 THEN
      RETURN;
   ENDIF;
/*
** Determine if this feeder connects to Cut In station
*/
   FOR i = 1 TO CutOutFeeder.LastRow() DO
      RetCode = CALLPROC Confirm3GOutofService (
                   Feeder = CutOutFeeder[i].Value);  

      IF RetCode <> PU_OK THEN  /*Now in service*/
         RetCode = CALLFRAME PromptCutIn (JIP = JIP, Feeder = CutOutFeeder[i].Value);
         IF RetCode = PU_CANCEL THEN
               CALLPROC TraceError (
                     UserMessage = 'ERROR: The 3G Network based trace determined that ' +
                       'feeder ' + VARCHAR(CutOutFeeder[i].Value) + ' should be Cut In, but an ' +
                       'error has prevented that from happening.',
                     TraceMessage = 
                       'PromptClearCurrentlyOpen: ' +
                       'Feeder ' + VARCHAR(CutOutFeeder[i].Value) + ' should be Cut In.'
                     );
         ENDIF;
      ENDIF;         
   ENDFOR;
END;


PROCEDURE CheckForSectional (
   Equip = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   Feeders      = ARRAY OF FMS_Card;
   FeederList = ARRAY OF ConnectedEquipClass;   
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   StationFeeder = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Feeders.Clear();
   i = 1;
   REPEATED
   SELECT  :Feeders[i].Card =  AO.Card,
           :Feeders[i].Feeder = AO.Object
   FROM    SOA_ActiveObject AO,
           Udb_Grouping G,
           Udb_ExtendedType ET
   WHERE   G.Member = :JIP.Equip AND
           G.Relationship = :Interaction$SourceBreaker AND
           G.GroupingType = ET.Type AND
           ET.SuperType = :Type$SubFeeder AND
           G.Grouping = AO.Object 
   BEGIN 
      i = i + 1;
   END;

   FOR i = 1 TO Feeders.LastRow() DO
         RetCode = CALLFRAME PromptCutIn (JIP = JIP, Feeder = Feeders[i].Feeder);
         IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (
                     UserMessage = 'ERROR: ' +
                       'Sectional Feeder ' + VARCHAR(Feeders[i].Feeder) + ' should be Cut In, but an ' +
                       'error has prevented that from happening.',
                     TraceMessage = 
                       'PromptClearCurrentlyOpen: ' +
                       'Sectional Feeder ' + VARCHAR(Feeders[i].Feeder) + ' should be Cut In.'
                     );
         ENDIF;

         RetCode = CALLPROC SOA_LogIns (
          Card            = Feeders[i].Card
        , Job             = NULL
        , SwitchingItem   = 0
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'CutIn'
        , New             = 'SubFeeder CutIn'
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to insert log entry for FMS card cutin.',
                           TraceMessage =
                      'PromptClearCurrentlyOpen: ' +
            'Unable to insert log' +
             ' entry indicating FMS card is cutin.'
             );
         ENDIF;
         CALLPROC DDB_COMMIT;
   ENDFOR;
END;


