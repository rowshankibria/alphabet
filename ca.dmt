	Name:            ACLSubselection

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ACLSubSelection
**
**  Date:       Author   Description
** ----------------------------------
**  04/17/00    py       Select Substation for ACLineSegment     
**  11/03/00    em       Changed visual appearance   
**  12/18/00    em       Displayed Line Segment is incorrectly coming from the
**                       screen, not from the New Move.  Changed wording.
**  12/15/05    ysp      increase the size of the move to 160 characters
**  08/31/16	em	 For new connectivity model, AClineSegment will appear
**                       in only one station paired with another in a separate
**                       station but only one will be connected.  During transition 
**                       period will find and show other substation here for selection. 
**  10/18/16    em       For transition, don't show all stations associated to the line
**                       three-way lines may show a station that is not directly
**                       connected to the chosen ACLineSegment.  Look at connectivity,
**                       which stations are connected to the chosen ACLineSeg. A
**                       connected subsation is needed so that the connectivity trace
**                       can move in an appropriate direction.
**  05/04/17    em       Reimplement to allow FIELD option for ACLineSegment move. 
*/
INITIALIZE 
(
/*
** Passed variables
*/
   CardObject        = INTEGER NOT NULL;
   CardObjectName    = VarChar(40) NOT NULL;
   i                 = INTEGER NOT NULL;
   TempObject        = INTEGER NOT NULL;
   TempName          = VarChar(40) NOT NULL;
   ACLLine           = INTEGER NOT NULL WITH DEFAULT;
   ACLSubstation     = INTEGER NOT NULL WITH DEFAULT;
   ACLSubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
   FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumValue = ACLSubstation;
   FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumText = ACLSubstationName;                
   FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumValue = 0;
   FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumText = 'FIELD';                
END;


ON CLICK OK_btn =
BEGIN
   IF FIELD(Object_Ref).CurEnumText = '' THEN
      MESSAGE 'No substation selected.';
      RESUME;
   ENDIF;
   ACLSubStation = FIELD(Object_Ref).CurEnumValue;
   IF FIELD(Object_Ref).CurEnumText = 'FIELD' THEN
      ACLSubStationName = '';
   ELSE
      ACLSubStationName = FIELD(Object_Ref).CurEnumText;
   ENDIF;
   RETURN (PU_OK);
END;


ON CLICK Cancel_btn =
BEGIN
   RETURN (PU_Cancel);
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;
						 *Default Item


