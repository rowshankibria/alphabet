            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  Session.StationEquip SE,   
            Udb_Grouping G,
            Udb_Object S,
            FMS_ArchiveJob J 
      WHERE  :V_Archive_FMS_Regular_TO_WC        // from archive fms
      BEGIN      
