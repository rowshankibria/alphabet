/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

PROCEDURE RemoveBlankFeeders (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = InConnectionWith.LastRow();
   WHILE i > 0 DO
       IF TRIM(InConnectionWith[i].Name) = '' THEN
          InConnectionWith.RemoveRow(RowNumber = i);
       ENDIF;
       i = i - 1; 
   ENDWHILE;
END;

PROCEDURE UpdateMapNumbers(
   UpdatedSubstn = INTEGER NOT NULL;
   NewMapNumber = VARCHAR(20) NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Substation = UpdatedSubstn THEN 
      Sub2Field.SubstnNumber = NewMapNumber;
   ENDIF;

   FOR i = 1 TO Jobs.LastRow() DO
       IF Jobs[i].SubStation = UpdatedSubstn THEN
          Jobs[i].ReturnRemark = NewMapNumber;
          IF CurrentApplication = Application$FMS THEN
             Jobs[i].SubstationName = SubstationName;
          ENDIF;
       ENDIF;  
   ENDFOR;
END;

PROCEDURE InsertOrderJobs(
   OrderNumber = INTEGER NOT NULL;
   Seq = INTEGER NOT NULL;
   Move = JobInProgress;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CardTypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   EquipDescription = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
   TORS = INTEGER NOT NULL WITH DEFAULT;
   SingleSub = JobInProgress;
   SubMoves = ARRAY OF JobInProgress;
ENDDECLARE
BEGIN
   IF Move.Status = Job$Restore THEN
      TORS = 1;
   ELSEIF Move.Status = Job$TakeOut THEN
      TORS = 0;
   ENDIF;

   RetCode = CALLPROC IR_InsertOpOrderJobs (
                           OrderNumber = OrderNumber,
                           Seq = Seq,
                           TORS = TORS,
                           Job = Move.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to link jobs to new Operating Order due to an error.';
      RETURN 0;
   ENDIF;
   CALLPROC DDB_COMMIT;

   Seq = Seq + 1;

   CardTypeOfCard = 0;

   IF CurrentApplication = Application$TFMS THEN
      CardTypeOfCard = TypeOfCard$TFMS;
   ELSEIF CurrentApplication = Application$SLC THEN
      CardTypeOfCard = TypeOfCard$SLC;
   ENDIF;

   IF CardTypeOfCard = 0 THEN
      RETURN Seq;
   ENDIF;

   EquipDescription = '';
   SELECT :EquipDescription = SQUEEZE(Description)
   FROM   Udb_Object
   WHERE  Object = :Move.Equip;

   IF EquipDescription <> '' THEN
      EquipDescription = EquipDescription + ' ';
   ENDIF;

   /*
   ** If this move has expanded moves, the expanded moves will be saved in the 
   ** soa_job table and linked to the order by putting them in the order job table.
   ** There will be no entry for the sub-moves in the soa_jobcontrol table.
   */
   SubMoves.Clear();
   SingleSub = Move.Duplicate();
   SingleSub.Status = '';

   i  = 1;
   SELECT DISTINCT
          :SingleSub.JobClass = JCL.LinkJobClass,
          :SingleSub.MoveType = J.MoveType,
          :SingleSub.TOMove = :EquipDescription + SQUEEZE(J.TOMove) + ' - ' + :Move.EquipName,
          :SingleSub.RSMove = :EquipDescription + SQUEEZE(J.RSMove) + ' - ' + :Move.EquipName,
          :SingleSub.TOMoveRules = J.TOMoveRules,
          :SingleSub.RSMoveRules = J.RSMoveRules,
          :SingleSub.Seq = JCL.Seq
   FROM   FMS_JobClassLink JCL,
          FMS_JobClass J   
   WHERE  JCL.SourceJobClass = :Move.JobClass AND
          JCL.SourceTypeOfCard = :CardTypeOfCard AND
          JCL.SourceStepPair = :Move.StepPair AND
          JCL.SourceEquipClass IN (SELECT SuperType 
                                  FROM UDB_ExtendedType 
                                  WHERE Type = :Move.EquipClass) AND
          JCL.SourceTORS = :TORS AND
          JCL.LinkJobClass = J.JobClass    
   ORDER BY Seq
   BEGIN
      SubMoves[i] = SingleSub.Duplicate();
      i = i + 1;
   END;

   FOR i = 1 TO SubMoves.LastRow() DO
      /*
      ** insert into the soa_job table.
      */
      SubMoves[i].Job = SubMoves[i].InsertJob (Card = SubMoves[i].Card);
      IF SubMoves[i].Job < 0 THEN  
         CALLPROC TraceError (
             UserMessage = 'ERROR: Expanded Job Insertion failed.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertOrderJobs; ' + 
                           'Expanded Job Insertion failed.');    
         RETURN 0;
      ENDIF;
      /*
      ** Expanded moves will have issued timestamp inserted.  Copy from main move.
      */
      SELECT :Move.TOIssued = TOIssued,
             :Move.TOComplete = TOComplete,
             :Move.TOOperator = TOOperator,
             :Move.RSIssued = RSIssued,
             :Move.RSComplete = RSComplete,
             :Move.RSOperator = RSOperator
      FROM   SOA_Job
      WHERE  Job = :Move.Job;
      
      IF TORS = 0 THEN
         RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Issued = Move.TOIssued,
                       Operator = Move.TOOperator);

      ELSE
/*
** Gray out TO/Issue Complete timestamp
*/
         RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Issued = '',
                       Operator = NULL);
 
         IF RetCode = 0 THEN
            RetCode = CALLPROC SOA_CompleteMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Complete = '');
         ENDIF;

         IF RetCode = 0 THEN
            RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'RS',
                       Issued = Move.RSIssued,
                       Operator = Move.RSOperator);
         ENDIF;
      ENDIF;

      IF RetCode < 0 THEN
   	   CALLPROC DDB_ROLLBACK;
   	   CALLPROC TraceError (
   	     UserMessage = 'ERROR: Unable to set timestamp for the expanded jobs.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertJobs; Unable to set issued timestamp of the expanded jobs.');    
   	   RETURN 0;
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*
      ** insert into the order job table.
      */
      RetCode = CALLPROC IR_InsertOpOrderJobs (
                              OrderNumber = OrderNumber,
                              Seq = Seq,
                              TORS = TORS,
                              Job = SubMoves[i].Job,
                              ParentJob = Move.Job);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
      	CALLPROC TraceError (
      	     UserMessage = 'ERROR: Unable to link expanded jobs to new Operating Order due to an error.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertOrderJobs; Unable to link expanded jobs to new Operating Order due to an error.');    
         RETURN 0;
      ENDIF;
      CALLPROC DDB_COMMIT;

      Seq = Seq + 1;
   ENDFOR;
   	
   RETURN Seq;
END;

PROCEDURE SetClearFeederStatus(
) =
DECLARE
   FdrList = ARRAY OF INTEGEROBJECT;
ENDDECLARE 
BEGIN  
   IF Feeder = -1 THEN
      i = 1;
      SELECT :FdrList[i].Value = Object
      FROM   TFMS_CardToObject
      WHERE  Card = :Jobs[1].Card
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE
      FdrList[1].Value = Feeder;
   ENDIF;

   FOR i = 1 TO FdrList.LASTROW DO
      IF FdrGndExist = TRUE THEN

         RetCode = CALLPROC SetStatus (Object = FdrList[i].Value,
                                       Status = Status$FdrG);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to set Feeder Ground status for the current feeder. ' +
                   'Please contact technical support.';
         ELSE 
            RetCode = CALLPROC FMS_ObjStatDel (Object = FdrList[i].Value,
                                                 Status = Status$GTGnd);
            IF RetCode < 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Unable to set Feeder Ground status and clear G&T Gnd status for the current feeder. ' +
                      'Please contact technical support.';
            ELSE
              CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;

      ELSEIF GTGndExist = TRUE THEN

         RetCode = CALLPROC SetStatus (Object = FdrList[i].Value,
                                       Status = Status$GTGnd);
         IF RetCode < 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Unable to set G&T Ground status for the current feeder. ' +
                      'Please contact technical support.';
         ELSE 
            RetCode = CALLPROC FMS_ObjStatDel (Object = FdrList[i].Value,
                                               Status = Status$FdrG);
            IF RetCode < 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Unable to set G&T Ground status and clear Feeder Gnd status for the current feeder. ' +
                      'Please contact technical support.';
            ELSE
              CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
     
      ELSEIF TestGndExist = TRUE THEN  /* let's clear both statuses in case they exist */

         RetCode = CALLPROC FMS_ObjStatDel (Object = FdrList[i].Value,
                                            Status = Status$GTGnd);
         IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           MESSAGE 'Unable to clear G&T Gnd status for the current feeder. ' +
                   'Please contact technical support.';
         ELSE
           CALLPROC DDB_COMMIT;
         ENDIF;

         RetCode = CALLPROC FMS_ObjStatDel (Object = FdrList[i].Value,
                                            Status = Status$FdrG);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to clear Feeder Gnd status for the current feeder. ' +
                   'Please contact technical support.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDFOR;
END;  

PROCEDURE DisplayOrderPrint(
) = 
DECLARE
    Command = Varchar(260) NOT NULL WITH DEFAULT;
    WorkDir = Varchar(100) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurSession.ProcessWait = FALSE;
   CurSession.ProcessWindow = FALSE;
    
   WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
   
   Command = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + WorkDir + '\order_print_callup.ps1" "' + VARCHAR(OrderNumber) + '"';                         
           
   CurProcedure.Trace (Command);
   CALL System Command;
END;
  

  

  
							 *Default Item

				 *Default Item


Application Component Report
============================

	Name:            GenerateOperatingOrderDSO

/*
**      Copyright c 2021 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          GenerateOperatingOrderDSO
**
**  Date:       Version Description
** ----------------------------------
**  08/10/21    em     Copied to create DSO version
**  09/17/21    em     Adding CE-TI and Drawing Numbers; Adding Order Feeders.
**  05/24/24    em     If only one card feeder move it order feeder list
**  05/28/24	em     If no feeders are selected, give SM message and opportunity 
**  04/08/25    em     Include Dielectric Structure in facility list if it has 
**                     CE-TI or Drawing Number
**  04/21/25    ysp    Add order level Scope-Of-Work
*/ 
INITIALIZE
(
    IssuedMoves = ARRAY OF JobInProgress;  /*Passed list of Moves*/
    Substation = INTEGER NOT NULL;         /*Passed Substation*/

    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER NOT NULL WITH DEFAULT;

    CardName = VARCHAR(200) NOT NULL WITH DEFAULT; /*For Outgoing Message*/
    CardTypeOfCard = INTEGER NOT NULL WITH DEFAULT;  /*For loading submoves*/
    ControlText = VARCHAR(256) NOT NULL;    /* For DBEvent   */
    CurObjRow = INTEGER NOT NULL WITH DEFAULT;
    CurConRow = INTEGER NOT NULL WITH DEFAULT;
    Equip = INTEGER NOT NULL WITH DEFAULT;
    FdrGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    FdrLineList = ARRAY OF ObjectClass;
    Feeder = INTEGER NOT NULL;
    GTGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    ISPermit = INTEGER NOT NULL WITH DEFAULT;
    JobSeq = INTEGER NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    LockedPermit = INTEGER NOT NULL WITH DEFAULT;
    MapClass = ObjectClass;
    MessageField = VARCHAR(800) NOT NULL;     /*Completion Message*/
    MsgKey = INTEGER NOT NULL;                /*Return MsgID*/
    OrderNumber = INTEGER NOT NULL;
    OrderObjectiveType = INTEGER NOT NULL;
    OrderStatus = INTEGER NOT NULL;           /*Initial Order Status*/
    OrderTarget = CHAR(4) NOT NULL WITH DEFAULT;
    OrderType = VARCHAR(14) NOT NULL WITH DEFAULT;
    ObjectiveList = ChoiceList;
    OrderCheck = INTEGER NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    Status = INTEGER NOT NULL WITH DEFAULT;
    StepHeading = VARCHAR(100) NOT NULL WITH DEFAULT;
    SubstationOrderNumber = INTEGER NOT NULL; /*Return from Insert*/
    SourceEquipType = INTEGER NOT NULL;
    SwapGnd = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    SingleSWP = OutageReport DEFAULT NULL;
    TempString = VARCHAR(40) NOT NULL WITH DEFAULT;
    TORS = INTEGER NOT NULL;    /* Takeout or Restore */
    TempObjective = ObjectiveClass;
    TestGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    TypeList = ChoiceList;
) =
DECLARE
/*
** local procedures
*/
    InsertOrderJobs = PROCEDURE RETURNING INTEGER NOT NULL;
ENDDECLARE
BEGIN
/*
** Setup default fields that we know now.
*/
   DistrictOperator = DOp.Description; 
   OrderTarget = 'DSO';
   CardTypeOfCard = TypeOfCard$DSO;
/*
** Setup moves takeout/restore side for display only.
*/
   OrderType = 'REGULAR';
   k = 1;
   FOR i = 1 TO IssuedMoves.LastRow() DO
        Jobs[k] = IssuedMoves[i].Duplicate();
        Jobs[k].BaseKey = 0;   
        IF IssuedMoves[i].Status = Job$Restore THEN
           Jobs[k].TOIssued = Jobs[k].RSIssued;
           Jobs[k].TOMove = Jobs[k].RSMove;
        ENDIF;
        IF IssuedMoves[i].StepPair = StepHeading$WorkPermit THEN
           OrderType = 'WORK PERMIT'; 
        ENDIF;

        k = k + 1;
        IF CardTypeOfCard <> 0 THEN
/*
** Select any submoves that will be added to the order when it is generated.
** These moves will simply be displayed here.  The BaseKey field contains
** the parent ID and will prevent the moves from being processed further.
*/
         IF IssuedMoves[i].Status = Job$Restore THEN
            TORS = 1;
         ELSEIF IssuedMoves[i].Status = Job$TakeOut THEN
            TORS = 0;
         ENDIF;

        SELECT DISTINCT
          :Jobs[k].JobClass = JCL.LinkJobClass,
          :Jobs[k].TOMove = '   ' + SQUEEZE(J.TOMove) + ' - ' + :IssuedMoves[i].EquipName,
          :Jobs[k].RSMove = '   ' + SQUEEZE(J.RSMove) + ' - ' + :IssuedMoves[i].EquipName,
          :Jobs[k].Seq = JCL.Seq,
          :Jobs[k].BaseKey = :IssuedMoves[i].Job,
          :Jobs[k].EquipClassName = :IssuedMoves[i].EquipClassName,
          :Jobs[k].EquipName = :IssuedMoves[i].EquipName
        FROM   FMS_JobClassLink JCL,
               FMS_JobClass J   
        WHERE  JCL.SourceJobClass = :IssuedMoves[i].JobClass AND
               JCL.SourceTypeOfCard = :CardTypeOfCard AND
               JCL.SourceStepPair = :IssuedMoves[i].StepPair AND
               JCL.SourceEquipClass IN (SELECT SuperType 
                                        FROM UDB_ExtendedType 
                                        WHERE Type = :IssuedMoves[i].EquipClass) AND
               JCL.SourceTORS = :TORS AND
               JCL.LinkJobClass = J.JobClass    
        ORDER BY Seq
        BEGIN
           FIELD(Jobs[k].EquipClassName).BgColor = CC_PALE_GRAY;
           FIELD(Jobs[k].EquipName).BgColor = CC_PALE_GRAY;
           FIELD(Jobs[k].TOMove).BgColor = CC_PALE_GRAY;
           IF TORS = 1 THEN  /*Display RS Move */
              Jobs[k].TOMove = Jobs[k].RSMove;
           ENDIF;
           k = k + 1;
        END;
        ENDIF;
     /*
      **  The substation atrribute contains the electric substation so we use the
      **  to try to find the dielectric facility.
      */  
      SELECT :MapClass.Object = O.Object,
             :MapClass.TypeName = O.TypeName,
             :MapClass.Name = O.Name,
             :MapClass.SpecNumber = O.SpecNumber,
             :MapClass.OwnerNumber = O.OwnerNumber
      FROM   Udb_Object O,
             Udb_Grouping G,
             Udb_SuperType ST
      WHERE  G.Member = :IssuedMoves[i].Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = O.Object AND
             O.Type = ST.Type AND
             ST.SuperType = :Type$DielectricFacility
      UNION 
      SELECT  O.Object,
              O.TypeName,
              O.Name,
              O.SpecNumber,
              O.OwnerNumber
      FROM   Udb_Object O,
             Udb_SuperType ST,
             Udb_Grouping G1,
             Udb_Grouping G2
      WHERE  G1.Member = :IssuedMoves[i].Equip AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = O.Object AND
             O.Type = ST.Type AND
             ST.SuperType = :Type$DielectricFacility
      UNION 
      SELECT  O.Object,
              O.TypeName,
              O.Name,
              O.SpecNumber,
              O.OwnerNumber
      FROM   Udb_Object O,
             Udb_ExtendedType ST,
             Udb_Grouping G1,
             Udb_Grouping G2
      WHERE  G1.Member = :IssuedMoves[i].Equip AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping =  O.Object AND
             O.Type = ST.Type AND
            (O.SpecNumber <> '' OR O.OwnerNumber <> '') AND
             ST.SuperType = :Type$DielectricStructure;
      
      IF MapClass.Object <> 0 THEN
         j = 1;
         WHILE j <= Nums.LastRow DO
            IF MapClass.Object = Nums[j].Object THEN
               ENDLOOP;
            ENDIF;
            j = j + 1;
         ENDWHILE;
         IF j > Nums.LastRow THEN
            Nums.InsertRow (RowNumber = j);
            Nums[j] = MapClass.Duplicate();
         ENDIF;
      ENDIF;
   ENDFOR;
   
   SELECT :CardName = CardName 
   FROM   SOA_ActiveCard
   WHERE  Card = :Jobs[1].Card;

   i = 1;
   SELECT :Fdrs[i].Object = Object,
          :Fdrs[i].Name = Name
   FROM   TFMS_CardToObject 
   WHERE  Card = :Jobs[1].Card AND
          Type = :Type$Line
   ORDER BY 2
   BEGIN
      i = i + 1;
   END;
   
   IF Fdrs.LastRow = 1 THEN
	  OFdrs[1] = Fdrs[1].Duplicate();
   ENDIF;

END;

ON CHILDSETVALUE Nums[*].SpecNumber =
DECLARE
   RowNum = INTEGER NOT NULL;
ENDDECLARE
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
		RESUME;
    ENDIF;
	RowNum = FIELD(Nums).CurRow;
	IF Nums[RowNum].SpecNumber = '' THEN
	   MESSAGE 'Do not not leave CE-TI blank.';
	   RESUME;
	ENDIF;
	
	RetCode = CALLPROC Udb_SpecNumberUpd (
	    Object = Nums[RowNum].Object,
	    SpecNumber = Nums[RowNum].SpecNumber);
	IF RetCode = 0 THEN
	   CALLPROC DDB_COMMIT;
	ELSE
	   CALLPROC DDB_ROLLBACK;
	   MESSAGE 'CE-TI Number update failed do to database error.';
	   Nums[RowNum].SpecNumber = 'Error' + Nums[RowNum].SpecNumber;
	ENDIF;
END;   

ON CHILDSETVALUE Nums[*].OwnerNumber =
DECLARE
   RowNum = INTEGER NOT NULL;
ENDDECLARE
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
		RESUME;
    ENDIF;
	RowNum = FIELD(Nums).CurRow;
	IF Nums[RowNum].OwnerNumber = '' THEN
	   MESSAGE 'Do not not leave Drawing Number blank.';
	   RESUME;
	ENDIF;
	
	RetCode = CALLPROC Udb_OwnerNumberUpd (
	    Object = Nums[RowNum].Object,
	    OwnerNumber = Nums[RowNum].OwnerNumber);
	IF RetCode = 0 THEN
	   CALLPROC DDB_COMMIT;
	ELSE
	   CALLPROC DDB_ROLLBACK;
	   MESSAGE 'Drawing Number update failed do to database error.';
	   Nums[RowNum].OwnerNumber = 'Error' + Nums[RowNum].OwnerNumber;
	ENDIF;
END;

ON CHILDENTRY Fdrs[*].Name = 
DECLARE
   RowNum = INTEGER NOT NULL;
ENDDECLARE
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
		RESUME;
    ENDIF;
    
	RowNum = FIELD(Fdrs).CurRow;
	i = 1;
	WHILE i <= OFdrs.LastRow DO
	   IF Fdrs[RowNum].Object = OFdrs[i].Object THEN
	      ENDLOOP;
	   ENDIF;
	   i = i + 1;
	ENDWHILE;
	
	IF i > OFdrs.LastRow THEN
	   OFdrs[i] = Fdrs[RowNum].Duplicate();
	ENDIF;
END;   

ON CHILDENTRY OFdrs[*].Name = 
DECLARE
   RowNum = INTEGER NOT NULL;
ENDDECLARE
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
		RESUME;
    ENDIF;
    
	RowNum = FIELD(OFdrs).CurRow;
	OFdrs.RemoveRow(RowNumber = RowNum);
END;   


ON CLICK Add_Btn =
BEGIN
/*
** Create Operating Order and link moves to the order.
*/
   IF DistrictOperator = '' THEN
      MESSAGE 'Please identify the Shift Manager creating the Operating Order';
      RESUME;
   ENDIF;
   
   IF SQUEEZE(ScopeOfWork) = '' THEN
      MESSAGE 'Please enter the Scope of Work of the Operating Order';
      RESUME;
   ENDIF;
/*
**  Make sure none of the moves is on an Opened/Download/Acknowledged order. 
*/
   FOR i = 1 to Jobs.LastRow() DO
      IF Jobs[i].Status = Job$Restore THEN
         TORS = 1;
      ELSEIF Jobs[i].Status = Job$TakeOut THEN
         TORS = 0;
      ENDIF;
      OrderCheck = 0;

      REPEATED 
      SELECT :OrderCheck = J.Job 
      FROM   IR_DSOOrder O,
             IR_DSOOrderJob J
      WHERE  J.Job = :Jobs[i].Job AND
             J.ToRs = :ToRS AND
             J.OrderNumber = O.OrderNumber AND
             O.OrderStatus IN (:Order$Opened,:Order$Downloaded,:Order$Acknowledged);
      CALLPROC DDB_ROLLBACK;
   
      IF OrderCheck <> 0 THEN
         MESSAGE 'Job: ' + Jobs[i].TOMove + ' is already in an outstanding order.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDFOR;
/*
** Give SM opportunity to add feeders to order
*/
   IF Ofdrs.LastRow = 0 AND Fdrs.LastRow > 0 THEN
      IF CurFrame.ConfirmPopup (messagetext = 'Gentle Reminder! You have not associated a feeder ' +
                     'to this order.  Click OK to continue with No Feeder or Cancel to pick a feeder.') = PU_CANCEL THEN
         RESUME;
      ENDIF;  
   ENDIF;
/*
** Now scroll through jobs array, and if the OrderType is Work Permit then each
** job is on its own order, otherwise they are all put on one order.
*/
   
   FOR k = 1 to Jobs.LastRow() DO

      OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
      IF (OrderNumber < 0) THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error: Could not generate an Operating Order Number.  Try again. ' +
                 'Udb_Lastkey table may not be synchronous between servers. ';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;

      IF ProcessAutoMode = TRUE THEN
         OrderStatus = Order$SetUp;
      ELSE
         OrderStatus = Order$Opened;
      ENDIF;

      RetCode = CALLPROC IR_DSOOrderIns (
                                        OrderNumber = OrderNumber,
                                        Card = Jobs[k].Card,
                                        OrderStatus = OrderStatus,
                                        OrderTarget = OrderTarget,
                                        OrderType = OrderType,
                                        Substation = Substation,
                                        ScopeOfWork = ScopeOfWork,
                                        IssuedBySM = DistrictOperator,
                                        IssueTime = 'now');
                                       
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to generate new Operating Order due to an error.';
         RETURN PU_CANCEL;
      ENDIF;
      
      FOR i = 1 TO OFdrs.LastRow DO
         RetCode = CALLPROC IR_DSOOrderFeederIns (
                        OrderNumber = OrderNumber,
                        Feeder = OFdrs[i].Object,
                        FeederName = OFdrs[i].Name);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert associated feeders for new Order.';
            RETURN PU_CANCEL;
         ENDIF;
      ENDFOR;

      FOR i = 1 TO Nums.LastRow DO
         RetCode = CALLPROC IR_DSOOrderDrawNumIns (
                        OrderNumber = OrderNumber,
                        Facility = Nums[i].Object,
                        FacilityType = Nums[i].TypeName,
                        FacilityName = Nums[i].Name,
                        CETINum = Nums[i].SpecNumber,
                        DrawingNum = Nums[i].OwnerNumber);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert drawing numbers for new Order.';
            RETURN PU_CANCEL;
         ENDIF;
      ENDFOR;

      IF OrderType = 'REGULAR' THEN

         JobSeq = 1; 
         FOR i = 1 TO Jobs.LastRow() DO 
            RetCode = CALLPROC IR_DSOOrderJobIns (
                                         OrderNumber = OrderNumber,
                                        Seq = i,
                                        TORS = 0,
                                        Job = Jobs[i].Job);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Unable to link jobs to new Operating Order due to an error.';
               RETURN PU_CANCEL;
            ENDIF;
         ENDFOR;
      ELSE
         RetCode = CALLPROC IR_DSOOrderJobIns (
                                        OrderNumber = OrderNumber,
                                        Seq = i,
                                        TORS = 0,
                                        Job = Jobs[k].Job);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to link jobs to new Operating Order due to an error.';
            RETURN PU_CANCEL;
          ENDIF;
       ENDIF;
       CALLPROC DDB_COMMIT; 
 
         MessageField = 'Operating Order ' + varchar(ordernumber) + 
                        ' has been created for ' + SubstationName; 
     
         RetCode = CALLPROC SOA_LogIns (
                            Card              = Jobs[k].Card
                            , Job             = NULL
                            , SwitchingItem   = Jobs[k].SwitchingItem
                            , Time            = DATE('now')
                            , UserName        = UserName
                            , Item            = 'Generate Order'
                            , Old             = 'For SSO at ' + SubstationName
                            , New             = 'Order Number: ' +
                                                 Varchar(OrderNumber));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to log generation of Operating Order due to an error.';
      ELSE   
         CALLPROC DDB_COMMIT;
      ENDIF; 

/*
** Now insert message for tracking purposes.
*
         MsgKey = CALLPROC MSG_SendMsg (Card = Jobs[k].Card,
                                  Action = 0,
                                  OrderNumber = IFNULL(OrderNumber,0), 
                                  Substation = Substation,
                                  SubstationName = SubstationName,
                                  Msg = CurrentApplication + ' ' + CardName + 
                                        ' sent Operating Order to ' + SubstationName + '.' + HC_NEWLINE +
                                        'First Move: ' + Jobs[k].TOMove,
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SSO',
                                  FromApp = CurrentApplication,
                                  Priority = 0
                                  );
         IF MsgKey < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message.' + 
              '  You might want to contact the Substation Operator to ' +
              'confirm that he has received the order.';
            MESSAGE :MessageField;
         ELSE
            CALLPROC DDB_COMMIT;
            RetCode = CALLPROC IR_MsgKeyUpd (MsgKey = MsgKey,
                                             OrderNumber = OrderNumber);
            IF Retcode = 0 THEN
               CALLPROC DDB_COMMIT;
            ELSE
               CALLPROC DDB_ROLLBACK;
               MessageField = MessageField + '  The system was, however, ' +
                 'unable to record the outgoing message id.' + 
                 '  You might want to contact the Substation Operator to ' +
                 'confirm that he has received the order.';
               MESSAGE :MessageField;
            ENDIF;
         ENDIF;
*/
         ControlText = varchar(ordernumber); 
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_NewOpOrder', 
                     EventText = ControlText);  

      IF OrderType = 'REGULAR' THEN
         ENDLOOP;  /* This busts us out of the Work Permit Loop*/
      ENDIF;
   ENDFOR;   /* If we are doing work permits one at at time, increment to next one.*/

   RETURN PU_OK;
END;

ON CLICK cancel_btn = 
BEGIN
   IF CurFrame.ConfirmPopup (messagetext = 
      'Exit without generating operating order?') = PU_OK THEN
      RETURN PU_CANCEL;
   ENDIF;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;



PROCEDURE InsertOrderJobs(
   OrderNumber = INTEGER NOT NULL;
   Seq = INTEGER NOT NULL;
   Move = JobInProgress;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CardTypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   EquipDescription = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
   TORS = INTEGER NOT NULL WITH DEFAULT;
   SingleSub = JobInProgress;
   SubMoves = ARRAY OF JobInProgress;
ENDDECLARE
BEGIN
   IF Move.Status = Job$Restore THEN
      TORS = 1;
   ELSEIF Move.Status = Job$TakeOut THEN
      TORS = 0;
   ENDIF;

   RetCode = CALLPROC IR_DSOOrderJobIns (
                           OrderNumber = OrderNumber,
                           Seq = Seq,
                           TORS = TORS,
                           Job = Move.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to link jobs to new Operating Order due to an error.';
      RETURN 0;
   ENDIF;
   CALLPROC DDB_COMMIT;

   Seq = Seq + 1;

   CardTypeOfCard = 0;

   IF CurrentApplication = Application$TFMS THEN
      CardTypeOfCard = TypeOfCard$TFMS;
   ELSEIF CurrentApplication = Application$SLC THEN
      CardTypeOfCard = TypeOfCard$SLC;
   ENDIF;

   IF CardTypeOfCard = 0 THEN
      RETURN Seq;
   ENDIF;

   EquipDescription = '';
   SELECT :EquipDescription = SQUEEZE(Description)
   FROM   Udb_Object
   WHERE  Object = :Move.Equip;

   IF EquipDescription <> '' THEN
      EquipDescription = EquipDescription + ' ';
   ENDIF;

   /*
   ** If this move has expanded moves, the expanded moves will be saved in the 
   ** soa_job table and linked to the order by putting them in the order job table.
   ** There will be no entry for the sub-moves in the soa_jobcontrol table.
   */
   SubMoves.Clear();
   SingleSub = Move.Duplicate();
   SingleSub.Status = '';

   i  = 1;
   SELECT DISTINCT
          :SingleSub.JobClass = JCL.LinkJobClass,
          :SingleSub.MoveType = J.MoveType,
          :SingleSub.TOMove = :EquipDescription + SQUEEZE(J.TOMove) + ' - ' + :Move.EquipName,
          :SingleSub.RSMove = :EquipDescription + SQUEEZE(J.RSMove) + ' - ' + :Move.EquipName,
          :SingleSub.TOMoveRules = J.TOMoveRules,
          :SingleSub.RSMoveRules = J.RSMoveRules,
          :SingleSub.Seq = JCL.Seq
   FROM   FMS_JobClassLink JCL,
          FMS_JobClass J   
   WHERE  JCL.SourceJobClass = :Move.JobClass AND
          JCL.SourceTypeOfCard = :CardTypeOfCard AND
          JCL.SourceStepPair = :Move.StepPair AND
          JCL.SourceEquipClass IN (SELECT SuperType 
                                  FROM UDB_ExtendedType 
                                  WHERE Type = :Move.EquipClass) AND
          JCL.SourceTORS = :TORS AND
          JCL.LinkJobClass = J.JobClass    
   ORDER BY Seq
   BEGIN
      SubMoves[i] = SingleSub.Duplicate();
      i = i + 1;
   END;

   FOR i = 1 TO SubMoves.LastRow() DO
      /*
      ** insert into the soa_job table.
      */
      SubMoves[i].Job = SubMoves[i].InsertJob (Card = SubMoves[i].Card);
      IF SubMoves[i].Job < 0 THEN  
         CALLPROC TraceError (
             UserMessage = 'ERROR: Expanded Job Insertion failed.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertOrderJobs; ' + 
                           'Expanded Job Insertion failed.');    
         RETURN 0;
      ENDIF;
      /*
      ** Expanded moves will have issued timestamp inserted.  Copy from main move.
      */
      SELECT :Move.TOIssued = TOIssued,
             :Move.TOComplete = TOComplete,
             :Move.TOOperator = TOOperator,
             :Move.RSIssued = RSIssued,
             :Move.RSComplete = RSComplete,
             :Move.RSOperator = RSOperator
      FROM   SOA_Job
      WHERE  Job = :Move.Job;
      
      IF TORS = 0 THEN
         RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Issued = Move.TOIssued,
                       Operator = Move.TOOperator);

      ELSE
/*
** Gray out TO/Issue Complete timestamp
*/
         RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Issued = '',
                       Operator = NULL);
 
         IF RetCode = 0 THEN
            RetCode = CALLPROC SOA_CompleteMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'TO',
                       Complete = '');
         ENDIF;

         IF RetCode = 0 THEN
            RetCode = CALLPROC SOA_IssueMove ( 
                       Job = SubMoves[i].Job,
                       Status = 'RS',
                       Issued = Move.RSIssued,
                       Operator = Move.RSOperator);
         ENDIF;
      ENDIF;

      IF RetCode < 0 THEN
   	   CALLPROC DDB_ROLLBACK;
   	   CALLPROC TraceError (
   	     UserMessage = 'ERROR: Unable to set timestamp for the expanded jobs.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertJobs; Unable to set issued timestamp of the expanded jobs.');    
   	   RETURN 0;
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*
      ** insert into the order job table.
      */
      RetCode = CALLPROC IR_InsertOpOrderJobs (
                              OrderNumber = OrderNumber,
                              Seq = Seq,
                              TORS = TORS,
                              Job = SubMoves[i].Job,
                              ParentJob = Move.Job);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
      	CALLPROC TraceError (
      	     UserMessage = 'ERROR: Unable to link expanded jobs to new Operating Order due to an error.',
             TraceMessage ='Frame:GenerateOperatingOrder.InsertOrderJobs; Unable to link expanded jobs to new Operating Order due to an error.');    
         RETURN 0;
      ENDIF;
      CALLPROC DDB_COMMIT;

      Seq = Seq + 1;
   ENDFOR;
   	
   RETURN Seq;
END;




