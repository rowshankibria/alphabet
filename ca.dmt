	Name:            ChangePrimarySource

/* 
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    CAC 
**  Frame:          ChangePrimarySource
**                  Frame used for selection of equipment in many different 
**                  instances depending on the input flag. 
** 
**  Modification log: 
** 
**  Date:     Version     Description 
** -------------------------------------------------- 
**  07/01/94    pw        Created           
**  10/04/94    pw        added DefectiveEquip flag code for when frame is called 
**                        from Restrictions frame
**  10/10/94    pw        added ExtractEquip flag code for when frame is called 
**                        from FeederCardLog frame
**  10/20/94    pw        change processing when an alternate source is chosen 
**  11/15/94    em        add handling of source breaker; choose source breaker first, 
**                        then source position. 
**  01/30/97    em        Allow selection of Blank equipment if ExtractEquipFl = TRUE
**  03/17/97    jfl       Use MacroGrouper to exclude grouper types.
**  07/25/98    em        Performance; removed NOT IN Grouper sub-select
**  12/23/02    ysp       Explicitly call soa_logins to log station ground update.
**  01/11/03    em        Log Substation&Position Updates
**  05/06/08    ysp       fix the SQL statement that selects the original source breaker
**  06/17/10    em        Change source position for 3G Network Feeder card.  
**  07/02/10    em        Present message when 3G feeder connected to two substations.  We
**                        are not supporting change source for this condition.
**  03/09/15    em        When changing feeder source, call process to manage card header changes.
**  12/02/16    ysp       Add equipment in 33kv portions to the list for defective equipment selection
**  08/07/19    em        If new source is in same substation, don't delete feeder to substation 
**                        membership because primary grouping update is not reinserting it.
**  08/07/19    pkw       Remove Source Connected relationship and insert audit log trail.
**  09/09/19    em        Remove prompt for Source Position unless feeder is in Staten Island and 
**                        a couple other conditions.
**  09/10/19    em        When OriginalPrimary and NewPrimary are passed in, move directly to ok_btn logic
*/ 
INITIALIZE   
(   
   OriginalPrimary = FMS_Equip;
   NewPrimary = FMS_Equip DEFAULT NULL;
   OriginalSP = FMS_Equip;
   C = FMS_Card;
   ExtractEquipFLG = INTEGER NOT NULL WITH DEFAULT;
   CreateSubfeederFLG = INTEGER NOT NULL WITH DEFAULT;
   DefectiveEquipFLG = INTEGER NOT NULL WITH DEFAULT;
   Feeder = INTEGER NOT NULL;
   SourceBreakerEquip = INTEGER NOT NULL; 
   SourcePositionEquip = INTEGER NOT NULL; 
) = 
DECLARE   
   i = INTEGER;		   
   j = INTEGER NOT NULL WITH DEFAULT;		   
   SelectedRow = INTEGER NOT NULL;
   retcode = INTEGER;
   
   TempSubstation = INTEGER NOT NULL;
   TempSubstationName = VARCHAR(40) NOT NULL;
   NewStationGround = VARCHAR(3) NOT NULL;
   CardFeeder = INTEGER NOT NULL;  /* Set Card Feeder in case we are a 3G card */
   Case3G = INTEGER NOT NULL WITH DEFAULT;  
   FeederObj = ARRAY OF INTEGEROBJECT;
   SourceToDelete = FMS_Equip;
ENDDECLARE
/* 
** Load the data for the equipment selection from the database 
** into the 4GL environment and set up the display: 
*/ 
BEGIN
   CardFeeder = C.Feeder;  /* Adjustment to support 3G, C.Feeder is -1 for 3G */
   Case3G = FALSE;
/*
** If a 3G network feeder, determine whether we have a feeder connected to a station.
** If no substation equipment, then we present open 3G Switches to be the selected for the source.  
** If one station, then we act as if were are single feeder.
** If two substations, then we allow source to change to other substation feeder source.
*/
   IF C.NetworkFeeder = NetworkFeeder$3G THEN 
      FeederObj.Clear();
      i = 1;
      SELECT :FeederObj[i].Value = G.Member
      FROM   TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  CTO.Card = :C.Card AND
             CTO.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation
      BEGIN
         i = i + 1;
      END;

      IF FeederObj.LastRow() = 0 THEN
         Case3G = TRUE;
      ELSEIF FeederObj.LastRow() = 1 THEN
         Case3G = FALSE;
         CardFeeder = FeederObj[1].Value;
      ELSE
         Case3G = TRUE;
      ENDIF;
   ENDIF;

   IF DefectiveEquipFLG = TRUE THEN
      Selected.Equip = 0;   /* initialize to zero */

      CurFrame.WindowPlacement = WP_PARENTCENTERED;
      CurFrame.WindowTitle = 'Select Defective Equipment';
      Field(SelectedEquip_Title).TextValue = 'Selected Defective Equipment:';
      Field(Display_Title).TextValue = 'Select Defective Equipment';

      SelectEquip.Clear();	/* Clear out storage */ 
      i = 1; 
      REPEATED
      SELECT  :SelectEquip[i].Equip = O.Object,  
              :SelectEquip[i].EquipName = O.Name, 
              :SelectEquip[i].EquipClass  = O.Type, 
              :SelectEquip[i].EquipClassName  = O.TypeName, 
              :SelectEquip[i].PrintID = G.Reference, 
              :SelectEquip[i].Origin = O.Ownernumber 
      FROM    Udb_Object O,  
              Udb_Grouping G  
      WHERE   G.Grouping = :Feeder AND
              G.Member = O.Object AND 
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type
                               FROM  Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch) AND
              G.MemberType NOT IN (:Type$AbstractHTV,
                                   :Type$ISOGrouper,
                                   :Type$Loop)
      UNION ALL
      SELECT  DISTINCT 
              O.Object,                            // equipment on 33kv portions
              O.Name, 
              O.Type, 
              O.TypeName, 
              G2.Reference, 
              O.Ownernumber 
      FROM    Udb_Object O,  
              Udb_Grouping G1,
              Udb_Grouping G2              
      WHERE   G1.Grouping = :Feeder AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.MemberType IN (SELECT Type 
                               FROM   UDB_ExtendedType
                               WHERE  SuperType = :Type$33KVPortion) AND
              G1.Member = G2.Grouping AND
              G2.Member = O.Object AND 
              G2.Relationship = :Interaction$MemberOf AND
              G2.MemberType IN (SELECT Type
                               FROM  Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch) AND
              G2.MemberType NOT IN (:Type$AbstractHTV,
                                   :Type$ISOGrouper,
                                   :Type$Loop)                                    
      ORDER BY PrintID, EquipName 
      BEGIN 
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;

   ELSEIF CreateSubfeederFLG = TRUE THEN
      Field(SelectedEquip_Title).TextValue = 'Selected Source Breaker:';
      Field(Display_Title).TextValue = 'Select a Source Breaker ' +
                                       HC_NEWLINE + 'for new Subfeeder';
   ELSEIF ExtractEquipFLG = TRUE THEN

      Selected.Equip = -99;   /* initialize to -99 */
      CurFrame.WindowPlacement = WP_PARENTCENTERED;
      CurFrame.WindowTitle = 'Select Equipment';
      Field(SelectedEquip_Title).TextValue = 'Selected Equipment:';
      Field(Display_Title).TextValue = 'Select Equipment';

   ELSEIF Case3G = TRUE THEN
      Field(SelectedEquip_Title).TextValue = 'Selected Source Breaker:';
      Field(Display_Title).TextValue = 'Change Source Breaker for 3G' +
                                       HC_NEWLINE + ' Feeders: ' + C.FeederName;
/*
** Are we dealing with a 3G card connected to no substations or to two substations?
*/
      IF FeederObj.LastRow() = 0 THEN

      i = 1;
      REPEATED
      SELECT DISTINCT 
              :SelectEquip[i].Equip = O.Object,  
              :SelectEquip[i].EquipName = O.Name, 
              :SelectEquip[i].EquipClass  = O.Type, 
              :SelectEquip[i].EquipClassName  = O.TypeName, 
              :SelectEquip[i].PrintID = G.Reference,               
              :SelectEquip[i].Origin = O.Ownernumber,
              :SelectEquip[i].Substation = G.Grouping   /*Hide Feeder*/              
      FROM    TFMS_CardToObject CTO,
              Udb_Object O, 
              Udb_Grouping G,
              Udb_Switch S  
      WHERE   CTO.Card = :C.Card AND
              CTO.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = :Type$3GSwitch AND
              G.Member = O.Object AND
              O.Object = S.Object AND
              S.CurrentlyOpen = 1
      BEGIN
/*
** Exclude 3G Switch that is already defined as Source Breaker
*/
         j = 0; 
         SELECT :j = 1
         FROM   Udb_Grouping
         WHERE  Member = :SelectEquip[i].Equip AND
                Relationship = :Interaction$SourceBreaker;

         IF j = 1 THEN
            SelectEquip.RemoveRow (rownumber = i);
         ELSE
/*
** If 3G Switch is on two feeders on the card (in the middle), we have an open
** switch in the middle and the DO should be prompted to reconfigure the card.
* THIS DOES NOT WORK FOR THE ATS LIKE DEVICE
            SELECT :j = COUNT(*)
            FROM   Udb_Grouping G,
                   TFMS_CardToObject CTO
            WHERE  CTO.Card = :C.Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = :SelectEquip[i].Equip;

            IF j > 1 THEN
               MESSAGE 'You have an Open 3G Switch in the middle of this feeder.  ' +
                       'Instead of Change Source you should first Separate 3G feeder cards ' +
                       'so that you have proper cards for the current configuration.';
               RETURN;
            ENDIF;
*/
            SELECT :SelectEquip[i].IsAssigned = StatusCount
            FROM   FMS_ObjectStatus
            WHERE  Object = :SelectEquip[i].Equip AND 
                   Status = :Status$Ground AND 
                   StatusCount > 0;
            i = i + 1; 
         ENDIF;
      END; 
      CALLPROC DDB_ROLLBACK;

      SELECT :Selected.FeederName = O1.Name,
             :Selected.Equip = O.Object,  
             :Selected.EquipName = O.Name,    
             :Selected.EquipClass  = O.Type,    
             :Selected.EquipClassName  = O.TypeName,    
             :Selected.PrintID = GG.Reference, 
             :Selected.Origin = O.OwnerNumber,
             :Selected.Substation = G.Grouping   /* Really the feeder */
      FROM   TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_Grouping GG,
             Udb_Object O,
             Udb_Object O1
      WHERE  CTO.Card = :C.Card AND
             CTO.Object = G.Grouping AND
             G.Grouping = O1.Object AND
             G.Relationship = :Interaction$SourceBreaker AND 
             G.Member = O.Object AND
             O.Object = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.Grouping = G.Grouping;
      CALLPROC DDB_ROLLBACK;

      SELECT :Selected.IsAssigned = StatusCount
      FROM   FMS_ObjectStatus
      WHERE  Object = :Selected.Equip AND 
             Status = :Status$Ground AND
             StatusCount > 0;
      OriginalPrimary = Selected.Duplicate();
/*
**    Get original Source Position
*/
      SELECT :OriginalSP.Equip = Member
      FROM   Udb_Grouping 
      WHERE  Grouping = :Selected.Substation AND
             Relationship = :Interaction$SourcePosition;

      ELSE
/*
** We defer logic for multiple substation 3G connections.
*/
         MESSAGE 'When 3G Network is connected to both substations, the Change Source function is not allowed.';
         RETURN;
      ENDIF;

   ELSE
      Field(SelectedEquip_Title).TextValue = 'Selected Source Breaker:';
      Field(Display_Title).TextValue = 'Change Source Breaker ' +
                                       HC_NEWLINE + 'for Feeder: ' + C.FeederName;
   
      SelectEquip.Clear();	/* Clear out storage */ 
      i = 1; 
      REPEATED
      SELECT  :SelectEquip[i].FeederName = O1.Name,
              :SelectEquip[i].Equip = O.Object,  
              :SelectEquip[i].EquipName = O.Name, 
              :SelectEquip[i].EquipClass  = O.Type, 
              :SelectEquip[i].EquipClassName  = O.TypeName, 
              :SelectEquip[i].PrintID = G.Reference, 
              :SelectEquip[i].Origin = O.Ownernumber, 
              :SelectEquip[i].Description = O2.Description,
              :SelectEquip[i].Substation = O2.Object
      FROM    Udb_Object O, 
              Udb_Object O1,
              Udb_Object O2,
              Udb_Grouping G  
      WHERE   G.Grouping = :CardFeeder AND
              G.Member = O.Object AND 
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type
                               FROM  Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch) AND
              G.MemberType NOT IN (:Type$AbstractHTV,
                                   :Type$ISOGrouper,
                                   :Type$Loop) AND         
              G.Grouping = O1.Object AND
              O1.PrimaryGrouping = O2.Object
      ORDER BY PrintID, EquipName 
      BEGIN 
         REPEATED
         SELECT :SelectEquip[i].IsAssigned = StatusCount
         FROM   FMS_ObjectStatus
         WHERE  Object = :SelectEquip[i].Equip AND 
                Status = :Status$Ground AND 
                StatusCount > 0;
         /* 
         **  If NewPrimary exists, set SelectedRow
         */
         IF NewPrimary IS NOT NULL THEN
            IF NewPrimary.Equip = SelectEquip[i].Equip THEN
               SelectedRow = i;
            ENDIF;
         ENDIF;       
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;

      /*
      **  If NewPrimary exists, set Selected
      */
      IF NewPrimary IS NOT NULL THEN
         Selected = NewPrimary;
      ELSE
      SELECT :Selected.FeederName = O1.Name,
             :Selected.Equip = O.Object,  
             :Selected.EquipName = O.Name,    
             :Selected.EquipClass  = O.Type,    
             :Selected.EquipClassName  = O.TypeName,    
             :Selected.PrintID = G.Reference, 
             :Selected.Origin = O.OwnerNumber, 
             :Selected.Description = O2.Description, 
             :Selected.Substation = O2.Object
      FROM   Udb_Grouping G,
             Udb_Grouping GG,
             Udb_Object O,
             Udb_Object O1,
             Udb_Object O2
      WHERE  O1.Object = :CardFeeder AND
             O1.PrimaryGrouping = O2.Object AND
             GG.Grouping = O1.Object AND
             GG.Relationship = :Interaction$SourceBreaker AND 
             GG.Member = G.Member AND
             G.RelationShip = :Interaction$MemberOf AND
             G.Grouping = O1.Object AND
             G.Member = O.Object;
      CALLPROC DDB_ROLLBACK;
      ENDIF;

      SELECT :Selected.IsAssigned = StatusCount
      FROM   FMS_ObjectStatus
      WHERE  Object = :Selected.Equip AND 
             Status = :Status$Ground AND
             StatusCount > 0;
             
      IF NewPrimary IS NULL THEN       /* OriginalPrimary is passed in with NewPrimary */
         OriginalPrimary = Selected.Duplicate();
      ENDIF;
/*
**    Get original Source Position
*/
      SELECT :OriginalSP.Equip = Member
      FROM   Udb_Grouping 
      WHERE  Grouping = :CardFeeder AND
             Relationship = :Interaction$SourcePosition;

      /*
          See if feeder is currently linked to temporary substation. TempSubstation
          will = 0 if feeder is not linked to temp substation.
      */
      SELECT :TempSubstation = IFNULL(O2.Object,0)
      FROM   Udb_Object O,
             Udb_Object O2
      WHERE  O.Object = :CardFeeder AND
             O.PrimaryGrouping = O2.Object AND
             O2.Type = :Type$TempSubstation;
   ENDIF;
/*
** Automatic OK click
*/   
   IF NewPrimary IS NOT NULL THEN
      CurFrame.SendUserEvent (EventName = 'AutoOK');
   ENDIF;
END; 

ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   SelectedRow = Field(SelectEquip).CurRow;
   Selected = SelectEquip[];
END; 

/* 
**  Handle OK click  
*/ 
ON Click OK_Btn,
ON USEREVENT 'AutoOK' =
DECLARE
   SameSP = INTEGER NOT NULL WITH DEFAULT;
   DivisionSI = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 

   IF DefectiveEquipFLG = TRUE THEN
      IF Selected.Equip = 0 THEN
         message 'You have not selected any equipment.';
         RESUME;
      ENDIF;
   ELSEIF CreateSubfeederFLG = TRUE THEN
      IF Selected.Equip = 0 THEN
         message 'You have not selected any equipment.';
         RESUME;
      ENDIF;
   ELSEIF ExtractEquipFLG = TRUE THEN
      IF Selected.Equip = -99 THEN
         message 'You have not selected any equipment.';
         RESUME;
      ENDIF;
   ELSE
      IF OriginalPrimary.Equip = Selected.Equip THEN
         IF CurFrame.ConfirmPopup(messagetext = 'The source breaker for feeder: ' +
                            C.FeederName + ' has not been changed,  do you want ' +
                            'to change to another?') = PU_OK THEN
            RESUME;
         ELSE
            RETURN;
         ENDIF;
      ELSE
/* 
**  Check if selected equipment already grouped with a substation.
**  If it is, use this substation.
*/
         SELECT :Selected.Description = O.Description,
                :Selected.Substation = O.Object
         FROM   Udb_Grouping G,
                Udb_Object O
         WHERE  G.Member = :Selected.Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType IN (:Type$Substation,:Type$UnitSubstation) AND
                G.Grouping = O.Object;

         IF iirowcount > 0 THEN  /* equip already grouped with substation */
/*
**  Now check if feeder grouped with temporary substation, i.e. from
**  former source change. If it is, put that substation back into the
**  pool because we don't need it any longer - we are using the substation 
**  for the new source which has already been established in the database.
*/
               IF TempSubstation <> 0 THEN

                  RetCode = CALLPROC FMS_ReturnObject
                        (Object = TempSubstation,
                         Description = '',
                         Primarygrouping = Unused$TempSubstation,
                         Type = Type$TempSubstation,
                         Name = varchar(TempSubstation));
           
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to put Temporary Substation back into pool.';
                     RESUME;
                  ENDIF;
                  CALLPROC DDB_COMMIT; 
                  /*
                      Remove all groupings to temporary substation
                  */
                  RetCode = CALLPROC Udb_GroupingDeleteAll
                        (Grouping = TempSubstation);
           
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to remove all groupings to temporary substation ';
                  ENDIF;
                  CALLPROC DDB_COMMIT; 

               ELSEIF OriginalPrimary.Substation <> Selected.Substation THEN
                  /*
                         Delete grouping to old substation
                  */
                  RetCode = CALLPROC Udb_GroupingDel (
                                               Grouping = OriginalPrimary.Substation,
                                               Member = CardFeeder,
                                               Relationship = Interaction$MemberOf);
                  IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        Message 'Unable to remove feeder relationship to with old substation.';
                        RESUME;
                  ENDIF;
                  CALLPROC DDB_COMMIT;
               ENDIF;
/*
**   Set up selected equip as new source breaker.
*/
               RetCode = CALLPROC Udb_GroupingIns (
                                            SystemVersion = 0,
                                            Grouping = CardFeeder,
                                            GroupingType = Type$Feeder,
                                            Member = Selected.Equip,
                                            MemberType = Selected.EquipClass,
                                            Relationship = Interaction$SourceBreaker);
               IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to make equipment source position.';
                     RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;
               /*
               ** disable the Source Connected value for the feeder to enforce validation and 
               ** confirmation of proper connectivity to the Source.
               */
               RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = CardFeeder);
               IF RetCode = 0 THEN
                  CALLPROC DDB_COMMIT;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  CurFrame.Trace(Text = 'Error: ChangePrimarySource; Failed to disable connected source flag for ' +  C.FeederName);
               ENDIF;
               /*
               ** insert audit trail
               */
               RetCode = CALLPROC FMS_AuditTrailIns (
                   Entity = 'Connected Source'
                  ,Handle = CardFeeder 
                  ,HandleName = C.FeederName
                  ,LogTime = DATE('Now')
                  ,Operator = DOp.Object
                  ,OperatorName = DOp.Description
                  ,Item = 'Update Flag'
                  ,Old = 'FROM CAC:ChangePrimarySource '
                  ,New = 'Feeder Source Disabled');     
               CALLPROC DDB_COMMIT;


               /*
                      Remove source breaker relationship for old equipment
               */
               RetCode = CALLPROC Udb_GroupingDel (
                                            Grouping = CardFeeder,
                                            Member = OriginalPrimary.Equip,
                                            Relationship = Interaction$SourceBreaker);
               IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Problems establishing single source breaker ' +
                             'for this feeder. Please correct in ModifyDB.';
                     RetCode = CALLPROC Udb_GroupingDel (
                                               Grouping = CardFeeder,
                                               Member = Selected.Equip,
                                               Relationship = Interaction$SourceBreaker);
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        Message 'Unable to remove selected equipment as source breaker,  ' +
                                'there are now two pieces of equipment defined as source ' +
                                'breaker for this feeder,  go to ModifyDB to correct problem.';
                        RESUME;
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                     RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;
               /*
                      primary group old source to feeder 
               */
               RetCode = CALLPROC Udb_ObjectUpd (
                                          Object = OriginalPrimary.Equip,
                                          PrimaryGrouping = CardFeeder,
                                          Type = OriginalPrimary.EquipClass,
                                          Name = OriginalPrimary.EquipName);
               IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to link old source back to feeder.';
                     RetCode = CALLPROC Udb_GroupingDel (
                                               Grouping = CardFeeder,
                                               Member = Selected.Equip,
                                               Relationship = Interaction$SourceBreaker);
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        Message 'Unable to remove selected equipment as source breaker,  ' +
                                'there now may be two pieces of equipment defined as source ' +
                                'breaker for this feeder,  go to ModifyDB to correct problem.';
                        RESUME;
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                     RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;
               /*
                      Group feeder to new substation
               */
               RetCode = CALLPROC Udb_ObjectUpd (
                                          Object = CardFeeder,
                                          PrimaryGrouping = Selected.Substation,
                                          Type = Type$Feeder,
                                          Name = C.FeederName);
               IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to primary group feeder to new substation.  Feeder MUST ' +
                             'be primary grouped to substation before creating a new card!  ' +
                             'Card insert will fail if this is not done.';
                     RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;
               /*
                      Group new source to substation
               */
               RetCode = CALLPROC Udb_ObjectUpd (
                                          Object = Selected.Equip,
                                          PrimaryGrouping = Selected.Substation,
                                          Type = Selected.EquipClass,
                                          Name = Selected.EquipName);
               IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to primary group new source breaker to substation.  ' + 
                             'The new source breaker MUST be primary grouped to new substation before '+
                             'creating a new card!  ' +
                             'Card insert will fail if this is not done.';
                     RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;

         ELSE /* equipment not grouped with substation */

          IF Case3G = TRUE THEN   /* We are switching ends of the 3G Feeder, don't worry about substation */
/*
** Get rid of all Source Breaker relationships associated to feeders on this card.  
** For this case, none are in a Substation - Substation field holds feeder.
*/ 
             SELECT :SourceToDelete.Equip = G.Member,
                    :SourceToDelete.Substation = G.Grouping
             FROM   TFMS_CardToObject CTO,
                    Udb_Grouping G
             WHERE  CTO.Card = :C.Card AND
                    CTO.Object = G.Grouping AND
                    G.Relationship = :Interaction$SourceBreaker
             BEGIN
                 RetCode = CALLPROC Udb_GroupingDel (
                   Grouping = SourceToDelete.Substation,
                   Relationship = Interaction$SourceBreaker,
                   Member = SourceToDelete.Equip);

                 IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to remove old SOurce Breaker relationships.';
                     RESUME;
                 ENDIF;
             END;

             RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = Selected.Substation,
                                      GroupingType = Type$Feeder,
                                      Member = Selected.Equip,
                                      MemberType = Selected.EquipClass,
                                      Relationship = Interaction$SourceBreaker);
             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to establish equipment as source breaker.';
                RESUME;
             ENDIF;
             CALLPROC DDB_COMMIT;
             /*
             ** disable the Source Connected value for the feeder to enforce validation and 
             ** confirmation of proper connectivity to the Source.
             */
             RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = CardFeeder);
             IF RetCode = 0 THEN
                CALLPROC DDB_COMMIT;
             ELSE
                CALLPROC DDB_ROLLBACK;
                CurFrame.Trace(Text = 'Error: ChangePrimarySource; Failed to disable connected source flag for ' +  C.FeederName);
             ENDIF;
             /*
             ** insert audit trail
             */
             RetCode = CALLPROC FMS_AuditTrailIns (
                   Entity = 'Connected Source'
                  ,Handle = Selected.Substation 
                  ,HandleName = C.FeederName
                  ,LogTime = DATE('Now')
                  ,Operator = DOp.Object
                  ,OperatorName = DOp.Description
                  ,Item = 'Update Flag'
                  ,Old = 'FROM CAC:ChangePrimarySource '
                  ,New = 'Feeder Source Disabled');     
             CALLPROC DDB_COMMIT;
              
          ELSE
/*
**  Grab a substation from the temporary pool, or reuse existing temp substation.
*/
            IF TempSubstation = 0 THEN
               SELECT :Selected.Substation = IFNULL(Object,0)
               FROM   UDB_OBJECT O
               WHERE  O.Object = (SELECT  MIN(Object)
                                  FROM    UDB_OBJECT D
                                  WHERE   D.Type = :Type$TempSubstation and
                                          varchar(D.Object) = D.Name);
               CALLPROC DDB_ROLLBACK;
               IF Selected.Substation = 0 THEN
                  Message 'Can not create temporary substation.  The temporary substation ' +
                          'pool is full.  Please contact FMS technical support.';
                  RESUME;
               ENDIF;
            ELSE
               Selected.Substation = TempSubstation;
            ENDIF;
            Selected.Description = Selected.EquipClassName + ' ' + Selected.EquipName +
                                   ' (Alternate Source)';    
            TempSubstationName = varchar(Selected.Substation) + '-TempSubstation';
        
            RetCode = CALLPROC FMS_ReturnObject (
                        Object  = Selected.Substation,
                        Description = Selected.Description,
                        Name    = TempSubstationName,
                        Type    = Type$TempSubstation,
                        PrimaryGrouping = Unused$TempSubstation);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Unable to Create Temporary Substation.';
               RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT; 
            /*
                Give equipment source breaker relationship
            */
            RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = Selected.Equip,
                                      MemberType = Selected.EquipClass,
                                      Relationship = Interaction$SourceBreaker);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Unable to establish equipment as source breaker.';
               RetCode = CALLPROC FMS_ReturnObject (
                           Object  = Selected.Substation,
                           Description = '',
                           Name    = varchar(Selected.Substation),
                           Type    = Type$TempSubstation,
                           PrimaryGrouping = Unused$TempSubstation);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to put Temporary Substation back into pool.  ' +
                          'Please contact technical support.';
                  RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT; 
               RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT;
            /*
            ** disable the Source Connected value for the feeder to enforce validation and 
            ** confirmation of proper connectivity to the Source.
            */
            RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = CardFeeder);
            IF RetCode = 0 THEN
               CALLPROC DDB_COMMIT;
            ELSE
               CALLPROC DDB_ROLLBACK;
               CurFrame.Trace(Text = 'Error: ChangePrimarySource; Failed to disable connected source flag for ' +  C.FeederName);
            ENDIF;
            /*
            ** insert audit trail
            */
            RetCode = CALLPROC FMS_AuditTrailIns (
                   Entity = 'Connected Source'
                  ,Handle = CardFeeder 
                  ,HandleName = C.FeederName
                  ,LogTime = DATE('Now')
                  ,Operator = DOp.Object
                  ,OperatorName = DOp.Description
                  ,Item = 'Update Flag'
                  ,Old = 'FROM CAC:ChangePrimarySource '
                  ,New = 'Feeder Source Disabled');     
            CALLPROC DDB_COMMIT;

            /*
                Remove source breaker relationship for old equipment
            */
            RetCode = CALLPROC Udb_GroupingDel (
                                      Grouping = CardFeeder,
                                      Member = OriginalPrimary.Equip,
                                      Relationship = Interaction$SourceBreaker);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Unable to remove old equipment as source breaker.';
               RetCode = CALLPROC Udb_GroupingDel (
                                         Grouping = CardFeeder,
                                         Member = Selected.Equip,
                                         Relationship = Interaction$SourceBreaker);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to remove selected equipment as source breaker,  ' +
                          'there are now two pieces of equipment defined as source ' +
                          'breaker for this feeder,  go to ModifyDB to correct problem.';
                  RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT;
               RetCode = CALLPROC FMS_ReturnObject (
                           Object  = Selected.Substation,
                           Description = '',
                           Name    = varchar(Selected.Substation),
                           Type    = Type$TempSubstation,
                           PrimaryGrouping = Unused$TempSubstation);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to put Temporary Substation back into pool.  ' +
                          'Please contact technical support.';
                  RESUME;
               ENDIF;
               CALLPROC DDB_COMMIT; 
               RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT;

            IF TempSubstation = 0 THEN
               /*
                   Group feeder to tempsubstation
               */
               RetCode = CALLPROC Udb_ObjectUpd (
                                       Object = CardFeeder,
                                       PrimaryGrouping = Selected.Substation,
                                       Type = Type$Feeder,
                                       Name = C.FeederName);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to link feeder to new substation.  Feeder MUST ' +
                          'be linked to new substation before creating a new card!  ' +
                          'Card insert will fail if this is not done.';
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
            /*
                Group new source to tempsubstation
            */
            RetCode = CALLPROC Udb_ObjectUpd (
                                    Object = Selected.Equip,
                                    PrimaryGrouping = Selected.Substation,
                                    Type = Selected.EquipClass,
                                    Name = Selected.EquipName);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Unable to link new source breaker to temporary substation.  ' + 
                       'The new source breaker MUST be linked to new substation before '+
                       'creating a new card!  ' +
                       'Card insert will fail if this is not done.';
               RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT;

            IF TempSubstation <> 0 THEN
               /*
                   Remove oldsource grouping to temp substation 
               */
               RetCode = CALLPROC Udb_GroupingDel (
                                         Grouping = TempSubstation,
                                         Member = OriginalPrimary.Equip,
                                         Relationship = Interaction$MemberOf);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to remove old source equipment from ' +
                          'temporary substation.';
               ENDIF;
               CALLPROC DDB_COMMIT;
               /*
                   primary group old source to feeder 
               */
               RetCode = CALLPROC Udb_ObjectUpd (
                                       Object = OriginalPrimary.Equip,
                                       PrimaryGrouping = CardFeeder,
                                       Type = OriginalPrimary.EquipClass,
                                       Name = OriginalPrimary.EquipName);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to link old source back to feeder.';
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
          ENDIF;   /*Case3G */
         ENDIF;
         /*
             Update top of card
         */      
         IF Case3G = FALSE THEN
    
           RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'substationname',
                                           NewValue = Selected.Description,
                                           MatchCard = C.Card);
           IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update substation name at top of card.';
            RESUME;
           ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'SubstationName',
                 Old  = C.SubstationName,
                 New  = Selected.Description);
           ENDIF;
           CALLPROC DDB_COMMIT;

         ENDIF;
      
         RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'position',
                                           NewValue = Selected.EquipName,
                                           MatchCard = C.Card);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update source breaker at top of card.';
            RESUME;
         ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Position',
                 Old  = C.Position,
                 New  = Selected.EquipName);
         ENDIF;
         CALLPROC DDB_COMMIT;
      
         CALLPROC FMS_ManageCardHeader (OptionalFeeder = CardFeeder);
         FCFrame.SendUserEvent (EventName = 'Load_Card');
      ENDIF;
   ENDIF;
/*
** If Changing Source or Creating SubFeeder, give user opportunity to
** select new source position to go with the new breaker.
*/
   SameSP = FALSE;
   IF DefectiveEquipFLG = FALSE AND ExtractEquipFLG = FALSE THEN
/*  
** If this is a StatenIsland Feeder or a CreateSubFeeder condition then
** will prompt whether to use source breaker as source position. Skip prompt for
** no Staten Island feeders.
*/
     DivisionSI = 0;
     SELECT :DivisionSI = Grouping
     FROM   Udb_Grouping 
     WHERE  Member = :CardFeeder AND
            Relationship = :Interaction$MemberOf AND
            Grouping = :Division$StatenIsland;
      
     IF CreateSubFeederFLG = TRUE OR Case3G = TRUE OR DivisionSI > 0 THEN 

      IF CurFrame.ConfirmPopup (MessageText = 'Should source breaker (CutOut Equipment) ' + 
              'also be used for source ' +
              'position (Grounding Equipment)?  ' + HC_NEWLINE + HC_NEWLINE +
              'Clicking "OK" will use the selected ' +
              'equipment as both the source breaker and source position. ' + HC_NEWLINE + HC_NEWLINE +
              'Clicking "Cancel" will let you pick a different piece of equipment for the ' +
              'source position.') = PU_CANCEL THEN

         SourceBreakerEquip = SelectedRow;
         Field(SelectedEquip_Title).TextValue = 'Selected Source Position:';
         Field(Display_Title).TextValue = 'Change Source Position (Grounding ' +
                                       'Equipment) ' + HC_NEWLINE + 'for Feeder: ' + C.FeederName;
         FIELD(ok_btn).CurBias = FB_INVISIBLE;
         FIELD(cancel_btn).CurBias = FB_INVISIBLE;
         FIELD(ok2_btn).CurBias = FB_CHANGEABLE;

         IF Case3G = TRUE THEN
/*
** Reload equipment list for SB Feeder.
*/
            SelectEquip.Clear();
            i = 1;
            REPEATED
            SELECT  :SelectEquip[i].Equip = O.Object,  
              :SelectEquip[i].EquipName = O.Name, 
              :SelectEquip[i].EquipClass  = O.Type, 
              :SelectEquip[i].EquipClassName  = O.TypeName, 
              :SelectEquip[i].PrintID = G.Reference,               
              :SelectEquip[i].Origin = O.Ownernumber,
              :SelectEquip[i].Substation = G.Grouping   /*Hide Feeder*/              
            FROM    
              Udb_Object O, 
              Udb_Grouping G
            WHERE  
               G.Grouping = :Selected.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = O.Object AND
               G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                                WHERE  SuperType = :Type$Switch)
            ORDER BY 5, 4, 2
            BEGIN
              SELECT :SelectEquip[i].IsAssigned = StatusCount
              FROM   FMS_ObjectStatus
              WHERE  Object = :SelectEquip[i].Equip AND 
                     Status = :Status$Ground AND 
                     StatusCount > 0;
              i = i + 1; 
            END;

         ENDIF;
      ELSE
         SameSP = TRUE;
      ENDIF;
      
     ELSE
        SameSP = TRUE;
     ENDIF;
     
     IF SameSP = TRUE THEN
         IF CreateSubfeederFLG = TRUE THEN
            SourceBreakerEquip = SelectedRow;
            SourcePositionEquip = SelectedRow;
            RETURN;
         ELSE
            SourceBreakerEquip = SelectedRow;
            CurFrame.SendUserEvent (EventName = 'EstablishSourcePosition');
         ENDIF;
     ENDIF;

   ELSE
      RETURN; 
   ENDIF;
 
END;


ON Click OK2_Btn =
BEGIN 
    IF CreateSubfeederFLG = TRUE THEN
        SourcePositionEquip = SelectedRow;
        RETURN;
    ENDIF;
    CurFrame.SendUserEvent (EventName = 'EstablishSourcePosition');
END;


ON UserEvent 'EstablishSourcePosition' = 
BEGIN
    IF Case3G = TRUE THEN
/*
** Get rid of all Source Position relationships associated to feeders on this card.  
** For this case, none are in a Substation - Substation field holds feeder.
*/ 
             SELECT :SourceToDelete.Equip = G.Member,
                    :SourceToDelete.Substation = G.Grouping
             FROM   TFMS_CardToObject CTO,
                    Udb_Grouping G
             WHERE  CTO.Card = :C.Card AND
                    CTO.Object = G.Grouping AND
                    G.Relationship = :Interaction$SourcePosition
             BEGIN
                 RetCode = CALLPROC Udb_GroupingDel (
                   Grouping = SourceToDelete.Substation,
                   Relationship = Interaction$SourcePosition,
                   Member = SourceToDelete.Equip);

                 IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to remove old Source Position relationships.';
                     RESUME;
                 ENDIF;
             END;

             RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = Selected.Substation,
                                      GroupingType = Type$Feeder,
                                      Member = Selected.Equip,
                                      MemberType = Selected.EquipClass,
                                      Relationship = Interaction$SourcePosition);
             IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Unable to establish equipment as source position.';
               RESUME;
             ENDIF;
             CALLPROC DDB_COMMIT;
    
/*
**  Only change source position if necessary
*/
    ELSEIF OriginalSP.Equip <> Selected.Equip THEN

        RetCode = CALLPROC Udb_GroupingIns (
                        SystemVersion = 0,
                        Grouping = CardFeeder,
                        GroupingType = Type$Feeder,
                        Member = Selected.Equip,
                        MemberType = Selected.EquipClass,
                        Relationship = Interaction$SourcePosition);
        IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to establish equipment source position.';
            RESUME;
        ENDIF;
        CALLPROC DDB_COMMIT;
    /*
       Remove source position relationship for old equipment
    */
        RetCode = CALLPROC Udb_GroupingDel (
                        Grouping = CardFeeder,
                        Member = OriginalPrimary.Equip,
                        Relationship = Interaction$SourcePosition);
        IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to remove old equipment from source position.';
            RetCode = CALLPROC Udb_GroupingDel (
                                Grouping = CardFeeder,
                                Member = Selected.Equip,
                                Relationship = Interaction$SourcePosition);
            IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to remove selected equipment as source position,  ' +
                    'there are now two pieces of equipment defined as source ' +
                    'position for this feeder,  go to ModifyDB to correct problem.';
                RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT;
            RESUME;
        ENDIF;
        CALLPROC DDB_COMMIT;
    ENDIF;

    IF OriginalSP.Equip <> Selected.Equip THEN
        IF Selected.IsAssigned >= 1 THEN
            NewStationGround = 'On';
        ELSE
            NewStationGround = 'Off';
        ENDIF;

        RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'stationground',
                                              NewValue = NewStationGround,
                                              MatchCard = C.Card);
        IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update station ground status at top of card.';
            RESUME;
        ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'StationGround',
                 Old  = C.StationGround,
                 New  = NewStationGround);
            CALLPROC DDB_COMMIT;
        ENDIF;
   
    ENDIF;
    RETURN;
END;      
/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
BEGIN 
   IF DefectiveEquipFLG = TRUE THEN
      Selected.Equip = 0;
   ELSEIF CreateSubfeederFLG = TRUE THEN
      SourceBreakerEquip = 0;
      SourcePositionEquip = 0;
   ELSEIF ExtractEquipFLG = TRUE THEN
      SelectedRow = -99;
   ENDIF;
   RETURN; 
END;

/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            ChangeSourceFCRPermit

/* 
**      Copyright c 2022 Pateric Software  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software. 
** 
**  Application:    CAC 
**  Procedure:          ChangeSourceFCRPermit
**                  Frame used for selection of equipment in many different 
**                  instances depending on the input flag. 
** 
**  Modification log: 
** 
**  Date:     Version     Description 
** -------------------------------------------------- 
**  02/16/22    em        Created       
**  04/26/22    em        Enable ManageCardHeader and reload of card at end of procedure    
**                        Identify PrintID or prompt if blank
*/ 
PROCEDURE ChangeSourceFCRPermit   
(   
   C = FMS_Card;
   OldS = INTEGER NOT NULL;
   NewS = INTEGER NOT NULL;
   OldSP = INTEGER NOT NULL;
   NewSP = INTEGER NOT NULL;
   OldSName    = VARCHAR(40) NOT NULL WITH DEFAULT;
   NewSName    = VARCHAR(40) NOT NULL WITH DEFAULT;
   OldSPName    = VARCHAR(40) NOT NULL WITH DEFAULT;
) = 
DECLARE   
   i = INTEGER;		   
   j = INTEGER NOT NULL WITH DEFAULT;		   
   x = INTEGER NOT NULL WITH DEFAULT;		   
   SelectedRow = INTEGER NOT NULL;
   retcode = INTEGER;
   ControlText = VARCHAR(256) NOT NULL;
   
   NewStationGround = CHAR(3) NOT NULL;
   CardFeeder = INTEGER NOT NULL;  /* Set Card Feeder in case we are a 3G card */
   Case3G = INTEGER NOT NULL WITH DEFAULT;  
   FeederObj = ARRAY OF INTEGEROBJECT;
   
   OldSub = INTEGER NOT NULL;
   NewSub = INTEGER NOT NULL;
   Feeder = INTEGER NOT NULL;
   FakeJobs = ARRAY OF JOB;
   ImpactedCardList = ARRAY OF INTEGEROBJECT; /*List of cards to be reloaded*/
   JobControlList       = ARRAY OF NewMoveCard;
   LastRow              = INTEGER      NOT NULL WITH DEFAULT;
   OutstandingMoves     = ARRAY OF Job;
   SLCCard= INTEGER NOT NULL WITH DEFAULT;
   SLCItem= INTEGER NOT NULL WITH DEFAULT;
   SLCShadowItem = INTEGER NOT NULL WITH DEFAULT;
   NewSubName = VARCHAR(40) NOT NULL WITH DEFAULT;
   NewSType = INTEGER NOT NULL;
   NewItem 		= SwitchingItem;                /*New Item Reference */
   Grounded = INTEGER NOT NULL WITH DEFAULT;
   PrintID = CHAR(2) NOT NULL WITH DEFAULT;
   ReturnID = CHAR(2);
   PromptPhrase = VARCHAR(100) NOT NULL WITH DEFAULT;
ENDDECLARE
/* 
** Load the data for the equipment selection from the database 
** into the 4GL environment and set up the display: 
*/ 
BEGIN
   CardFeeder = C.Feeder;  /* Adjustment to support 3G, C.Feeder is -1 for 3G */
   Case3G = FALSE;
/*
** If a 3G network feeder, determine whether we have a feeder connected to a station.
** If no substation equipment, then we present open 3G Switches to be the selected for the source.  
** If one station, then we act as if were are single feeder.
** If two substations, then we allow source to change to other substation feeder source.
*/
   IF C.NetworkFeeder = NetworkFeeder$3G THEN 
      FeederObj.Clear();
      i = 1;
      SELECT :FeederObj[i].Value = G.Member
      FROM   TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  CTO.Card = :C.Card AND
             CTO.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation
      BEGIN
         i = i + 1;
      END;

      IF FeederObj.LastRow() = 0 THEN
         Case3G = TRUE;  /* This is not possible since no longer using 3G transfer */
      ELSEIF FeederObj.LastRow() = 1 THEN
         Case3G = FALSE;
         CardFeeder = FeederObj[1].Value;
         SELECT :C.FeederName = Name
         FROM   Udb_Object
         WHERE  Object = :CardFeeder;
      ELSE
         Case3G = TRUE;  /* This is not possible since no longer using 3G transfer */
      ENDIF;
   ENDIF;
/*
** Look for N move PrintID or Prompt if blank
*/
   SELECT :PrintID = JC.PrintID
   FROM   SOA_JobControl JC,
          SOA_Job J
   WHERE  JC.Card = :C.Card AND
          JC.PrintID <> '' AND
          JC.Job = J.Job AND
          J.Equip = :NewS AND
          J.MoveCategory = :MoveCategory$Fake;
   
   IF PrintID = '' THEN
      PromptPhrase = 'Please enter the Print ID for the new Source:  ' +
                                   NewSName;
      
      ReturnID = CALLFRAME GenericEntry ( 
                                   PromptPhrase = PromptPhrase,
                                   PhraseLength = 2);
      PrintID = IFNULL(ReturnID,'');
   ENDIF;
/*
** Add the new source to the feeder, Need type for substation later PG update 
*/    
   SELECT :NewSType = Type
   FROM   Udb_Object 
   WHERE  Object = :NewS;
   
   RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewS,
                                      MemberType = NewSType,
                                      Relationship = Interaction$MemberOf,
                                      Reference = PrintID);
   IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add source to feeder.';
                RETURN PU_CANCEL;
   ENDIF;
   
   IF OldSP <> OldS THEN
      RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewSP,
                                      MemberType = NewSType,
                                      Relationship = Interaction$MemberOf,
                                      Reference = PrintID);
      IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add source position to feeder.';
                RETURN PU_CANCEL;
      ENDIF;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Extend the substation card moves for new source to this card.  The moves will remain controlled by
** substation card.
*/
   x = 1;   /*The following cannot be a REPEATED query */
   SELECT DISTINCT
           OutstandingMoves[x].Seq = JC.Seq,
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Card = :C.Card,  /* We are not inserting into a shadow item */
           OutstandingMoves[x].Substation = J.Substation,   /* so Initiating card is not important */
           JobControlList[x].Card = :C.Card,
           JobControlList[x].MoveEquipClass = JCC.EquipClass,
           JobControlList[x].StepHeading = JCC.StepPair,
           JobControlList[x].StepLevel = 0,
           JobControlList[x].SwitchingItem = 0,
           JobControlList[x].TypeOfCard = JCC.TypeOfCard,
           JobControlList[x].PrintID = :PrintID,  
           JobControlList[x].Application = :Application$FMS 
   FROM  FMS_JobClassControl JCC,
            SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard AC
   WHERE J.Equip IN (:NewS, :NewSP) AND 
           (JC.SwitchingItem = 0 OR 
           (JC.SwitchingItem <> 0 AND 
            J.SWItemStatus = :Card$Active )) AND 
           (J.ToComplete IS NULL OR 
            J.RSComplete IS NULL) AND 
            J.Status IN (' ', 'NIS') AND 
            J.MoveCategory = :MoveCategory$Normal AND 
            J.Job = JC.Job AND 
            JC.Card = AC.Card AND 
            JC.Card <> :C.Card AND 
            JC.Card <> :NIS$Card AND 
            JCC.TypeOfCard = :C.TypeOfCard AND 
            JCC.JobClass = J.JobClass AND 
            JCC.PreferredStep = 1 AND   
            J.EquipClass IN (SELECT Type 
                             FROM   Udb_ExtendedType 
                             WHERE  SuperType = JCC.EquipClass)
   BEGIN 
         x = x + 1;
   END;   
   
   FOR x = 1 TO OutstandingMoves.LastRow DO
                 RetCode = OutstandingMoves[x].InsertControl (
                                  ControlEntry = JobControlList[x]
                                 ,InitiatingCard = C.Card
                                 ,TransferFlag = FALSE
                                 ,SingleFeederOnly = TRUE
                                  );

                 IF RetCode = PU_CANCEL THEN
                    MESSAGE 'Unable to insert Outstanding Moves to the current card.';
                    ENDLOOP;
                    RETURN PU_CANCEL; 
                 ENDIF;  
   ENDFOR;
/*
** Delete N moves that may have been inserted as protection move reflections
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
            :FakeJobs[i].JobClass = J.JobClass,
            :FakeJobs[i].Job = J.Job,
            :FakeJobs[i].Card = JC.Card,
            :FakeJobs[i].Equip = J.Equip,
            :FakeJobs[i].EquipName = J.EquipName,
            :FakeJobs[i].EquipClass = J.EquipClass,
            :FakeJobs[i].EquipClassName = J.EquipClassName,
            :FakeJobs[i].TOMove = J.TOMove,
            :FakeJobs[i].TOOperator = J.TOOperator,
            :FakeJobs[i].TOIssued = J.TOIssued,
            :FakeJobs[i].TOComplete = J.TOComplete,
            :FakeJobs[i].RSIssued = J.RSIssued,
            :FakeJobs[i].RSComplete = J.RSComplete,
            :FakeJobs[i].RSOperator = J.RSOperator,
            :FakeJobs[i].MoveType = J.MoveType,
            :FakeJobs[i].RSMove = J.RSMove,
            :FakeJobs[i].TOMoveRules = J.TOMoveRules,
            :FakeJobs[i].RSMoveRules = J.RSMoveRules,
            :FakeJobs[i].Grounds = J.Grounds,
            :FakeJobs[i].GroundOn = J.GroundOn,
            :FakeJobs[i].MoveFGColor = J.MoveFGColor,
            :FakeJobs[i].StepPair = JC.StepPair,
            :FakeJobs[i].Substation = J.Substation,
            :FakeJobs[i].MoveEquipClass = JC.MoveEquipClass
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :C.Card AND
           JC.Job = J.Job AND
           J.Equip = :NewS AND
           J.MoveCategory = :MoveCategory$Fake AND
           J.Status <> 'Del' 
   BEGIN
      RetCode = FakeJobs[i].DeleteJob
               (ImpactedCardList = ImpactedCardList);
      i = i + 1; 
   END;
/*
** Compare Substation for New and Old Source.  If not the same then we must 
** reset the feeder to substation relationship.
*/   
   SELECT :NewSub = G.Grouping
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET
   WHERE  G.Member = :NewS AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = ET.Type AND
          ET.SuperType = :Type$Substation;

   SELECT :OldSub = G.Grouping
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET
   WHERE  G.Member = :OldS AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = ET.Type AND
          ET.SuperType = :Type$Substation;
   /*
** PrimaryGroup new source to Substation
*/   
   RetCode = CALLPROC Udb_ObjectUpd (
                                          Object = NewS,
                                          PrimaryGrouping = NewSub,
                                          Type = NewSType,
                                          Name = NewSName);
   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to primary group new source to substation.  Source MUST ' +
                             'be primary grouped to substation before creating a new card!  ' +
                             'Card insert will fail if this is not done.';
                     RETURN PU_CANCEL;
   ENDIF;

   CALLPROC DDB_COMMIT;
      
   IF OldSub <> NewSub THEN       /* Lock control, hit object table first then grouping table */
   
      RetCode = CALLPROC Udb_ObjectUpd (
                                          Object = CardFeeder,
                                          PrimaryGrouping = NewSub,
                                          Type = Type$Feeder,
                                          Name = C.FeederName);
      IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Unable to primary group feeder to new substation.  Feeder MUST ' +
                             'be primary grouped to substation before creating a new card!  ' +
                             'Card insert will fail if this is not done.';
                     RETURN PU_CANCEL;
      ENDIF;
      
      RetCode = CALLPROC Udb_GroupingDel (
                                               Grouping = OldSub,
                                               Member = CardFeeder,
                                               Relationship = Interaction$MemberOf);
      IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        Message 'Unable to remove feeder relationship to old substation.';
                        RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;
      
      SELECT :NewSubName = Description
      FROM   Udb_Object
      WHERE  Object = :NewSub;
   ENDIF;
/*
** Change Source Groupings
*/   
   RetCode = CALLPROC Udb_GroupingDel (
                                            Grouping = CardFeeder,
                                            Member = OldS,
                                            Relationship = Interaction$MemberOf);
   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Problems removing source breaker membership ' +
                             'for this feeder. Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingDel (
                                            Grouping = CardFeeder,
                                            Member = OldS,
                                            Relationship = Interaction$SourceBreaker);
   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Problems removing source breaker ' +
                             'for this feeder. Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   
   RetCode = CALLPROC Udb_GroupingDel (
                                            Grouping = CardFeeder,
                                            Member = OldSP,
                                            Relationship = Interaction$MemberOf);
   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Problems removing source position membership ' +
                             'for this feeder. Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingDel (
                                            Grouping = CardFeeder,
                                            Member = OldSP,
                                            Relationship = Interaction$SourcePosition);
   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     Message 'Problems removing source position ' +
                             'for this feeder. Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   
   RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewS,
                                      MemberType = 0,  /* let it be set by rule */
                                      Relationship = Interaction$MemberOf);
   IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add Source member relationship to feeder.  Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   
   IF NewS <> NewSP THEN
   
   RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewSP,
                                      MemberType = 0,  /* let it be set by rule */
                                      Relationship = Interaction$MemberOf);
   IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add Source Position member relationship to feeder.  Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   
   ENDIF;
   
   RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewS,
                                      MemberType = 0,  /* let it be set by rule */
                                      Relationship = Interaction$SourceBreaker);
   IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add source breaker relationship to feeder.  Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   
   RetCode = CALLPROC Udb_GroupingIns (
                                      SystemVersion = 0,
                                      Grouping = CardFeeder,
                                      GroupingType = Type$Feeder,
                                      Member = NewSP,
                                      MemberType = 0,  /* let it be set by rule */
                                      Relationship = Interaction$SourcePosition);
   IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to add source position relationship to feeder. Please correct in ModifyDB.';
                RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Transfer old source job control to active switching item.
*/
   REPEATED
   SELECT     :SLCCard = JC.Card,
              :SLCItem = JC.SwitchingItem,
              :SLCShadowItem = J2.ShadowLink
   FROM       SOA_Job J,
              SOA_Job J2,
              SOA_JobControl JC,
              SLC_Card C
   WHERE      JC.Card = C.Card AND
              JC.Job = J.Job AND
              J.Equip IN (:OldS, :OldSP) AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.ShadowLink = 0 AND
              J.SWItemStatus = :Card$Active AND
              JC.SwitchingItem = J2.Job;
/*
** If move is in a Shadow then a New Item needs to be created.
*/
   IF SLCShadowItem > 0 THEN
      NewItem.Job = CALLPROC SOA_JobLastKey();

      IF NewItem.Job < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error obtaining next job key for new switching item.';
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;
 
      NewItem.TOMove = 'Change Source for Feeder ' + C.FeederName;
      NewItem.CardClass = Type$SLCSCHD;
      NewItem.CardClassName = 'SCHD';
      NewItem.SwitchingItem = NewItem.Job;
      NewItem.TOComplete = '';
      NewItem.RSIssued = '';
      NewItem.SwItemStatus = Card$Active;
      NewItem.TOIssued = DATE('now');
      NewItem.TOComplete = '';
      NewItem.Response = 'Active';
      NewItem.JobClass = 0;
      NewItem.Status = '';
      NewItem.Equip = 0;
      NewItem.EquipClass = 0;
      NewItem.EquipClassName = '';
      NewItem.EquipName = '';        
      NewItem.MoveCategory = MoveCategory$SwitchingItem; 
          
      RetCode = NewItem.InsertItem (Card = SLCCard);

      IF RetCode = PU_OK THEN
         CALLPROC DDB_COMMIT;
         ControlText = VARCHAR(SLCCard) + ';' + VARCHAR(NewItem.Job);
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSActivateCard',
                     EventText = ControlText); 
      ENDIF;
/* 
** Transfer Equipment to the new Item
*/   
      RetCode = CALLPROC TransferSWItemEquip (
                  Card = SLCCard,
                  Equip = OldS,
                  OldSwitchingItem = SLCItem,
                  NewSwitchingItem = NewItem.SwitchingItem );
 
      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Transfer Equipment between switching items.';
      ELSE
         CALLPROC DDB_COMMIT;   
         
         RetCode = CALLPROC SOA_LogIns (
          Card            = SLCCard
        , Job             = NULL
        , SwitchingItem   = SLCItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer out of shadow: ' 
        , Old             = 'Equip: ' + OldSName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 1 indicating SW item to SW item Transfer.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_LogIns (
          Card            = SLCCard
        , Job             = NULL
        , SwitchingItem   = NewItem.SwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer from Shadow: ' 
        , Old             = 'Equip: ' + OldSName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 2 indicating SW item to SW item Transfer.';
         ENDIF;
         CALLPROC DDB_COMMIT;        

      ENDIF;
      
      IF OldS <> OldSP THEN
      
      RetCode = CALLPROC TransferSWItemEquip (
                  Card = SLCCard,
                  Equip = OldSP,
                  OldSwitchingItem = SLCItem,
                  NewSwitchingItem = NewItem.SwitchingItem );
 
      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Transfer Equipment between switching items.';
      ELSE
         CALLPROC DDB_COMMIT;   
         
         RetCode = CALLPROC SOA_LogIns (
          Card            = SLCCard
        , Job             = NULL
        , SwitchingItem   = SLCItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer out of shadow: ' 
        , Old             = 'Equip: ' + OldSPName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 1 indicating SW item to SW item Transfer.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_LogIns (
          Card            = SLCCard
        , Job             = NULL
        , SwitchingItem   = NewItem.SwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer from Shadow: ' 
        , Old             = 'Equip: ' + OldSPName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 2 indicating SW item to SW item Transfer.';
         ENDIF;
         CALLPROC DDB_COMMIT;        

      ENDIF;  
      ENDIF; 
   ENDIF;
/*
** Mark old source cards on current card as transferred.
*/
   x = 1;
   OutstandingMoves.Clear();
   SELECT DISTINCT
           OutstandingMoves[x].Seq = JC.Seq,
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Card = :C.Card,  /* We are not inserting into a shadow item */
           OutstandingMoves[x].Substation = J.Substation   /* so Initiating card is not important */
   FROM  SOA_Job J,
            SOA_JobControl JC
   WHERE J.Equip IN (:OldS, :OldSP) AND 
           (J.ToComplete IS NULL OR 
            J.RSComplete IS NULL) AND 
            J.Status IN (' ', 'NIS') AND 
            J.MoveCategory = :MoveCategory$Normal AND 
            J.Job = JC.Job AND 
            JC.Card = :C.Card 
   BEGIN 
         x = x + 1;
   END;   
   
            j = 1; 
            WHILE j <= OutstandingMoves.LastRow()  DO 

                      /* Blank out any NULL times: */
                     IF (OutstandingMoves[j].TOIssued IS NULL) THEN 
                        OutstandingMoves[j].ToIssued = ' '; 
                     ENDIF; 
                     IF (OutstandingMoves[j].TOComplete IS NULL) THEN 
                       OutstandingMoves[j].TOComplete = ' '; 
                     ENDIF; 
                     IF (OutstandingMoves[j].RSIssued IS NULL) THEN 
                       OutstandingMoves[j].RSIssued = ' '; 
                     ENDIF; 
                     IF (OutstandingMoves[j].RSComplete IS NULL) THEN  
                       OutstandingMoves[j].RSComplete = ' '; 
                     ENDIF; 

                        OutstandingMoves[j].Response = 'Xfer to Substation'; 
                        OutstandingMoves[j].Status = Job$Xfer; 
                        OutstandingMoves[j].GroundOn = NULL;
                        OutstandingMoves[j].MoveFGColor = CC_BLACK;

                        /* Update the job on current card: make a copy of the job for 
                        the source card and tranfer the original job to the destination
                        card. */ 
                        RetCode = CALLPROC SOA_TransferEquipJob
                                    ( Card       = C.Card,
                                    Job        = OutstandingMoves[j].Job, 
                                    Response   = OutstandingMoves[j].Response, 
                                    Status     = OutstandingMoves[j].Status, 
                                    TOIssued   = OutstandingMoves[j].TOIssued, 
                                    TOComplete = OutstandingMoves[j].TOComplete, 
                                    RSIssued   = OutstandingMoves[j].RSIssued, 
                                    RSComplete = OutstandingMoves[j].RSComplete,
                                    GroundOn   = OutstandingMoves[j].GroundOn,
                                    MoveFGColor= OutstandingMoves[j].MoveFGColor
                                    ); 
                                    
                        IF (RetCode <> 0) THEN 
                           CALLPROC DDB_ROLLBACK;
                           MESSAGE 'Unable to Archive Old Source Pos Equip Moves.';
                           ENDLOOP;
                        ENDIF;
                j = j + 1;
            ENDWHILE;
            CALLPROC DDB_COMMIT;
/*
** Delete any N moves for New Source, may have been inserted as protection move placeholders
*/
   
/* 
** Transfer old source control to SLC card
*/   
   RetCode = CALLPROC SOA_TransferEquipControl (
                  Equip = OldS,
                  ControlCard = SLCCard );
 
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to Transfer Old Source Equip Control to SLC.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
    
   IF OldS <> OldSP THEN
      RetCode = CALLPROC SOA_TransferEquipControl (
                  Equip = OldSP,
                  ControlCard = SLCCard );
 
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to Transfer Old Source Pos Equip Control to SLC.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
   ENDIF;
               /*
               ** disable the Source Connected value for the feeder to enforce validation and 
               ** confirmation of proper connectivity to the Source.
               */
               RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = CardFeeder);
               IF RetCode = 0 THEN
                  CALLPROC DDB_COMMIT;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  MESSAGE 'Error: ChangeSourceFCRPermit; Failed to disable connected source flag for ' +  C.FeederName;
               ENDIF;

               /*
               ** insert audit trail
               */
               RetCode = CALLPROC FMS_AuditTrailIns (
                   Entity = 'Connected Source'
                  ,Handle = CardFeeder 
                  ,HandleName = C.FeederName
                  ,LogTime = DATE('Now')
                  ,Operator = DOp.Object
                  ,OperatorName = DOp.Description
                  ,Item = 'Update Flag'
                  ,Old = 'FROM CAC:ChangeSourceFCRPermit'
                  ,New = 'Feeder Source Disabled');     
               CALLPROC DDB_COMMIT;
/*
** Remainder is Card Header Stuff
*/        
       IF NewSubName <> '' THEN                      
           RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'substationname',
                                           NewValue = NewSubName,
                                           MatchCard = C.Card);
           IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update substation name at top of card.';
           ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'SubstationName',
                 Old  = C.SubstationName,
                 New  = NewSubName);
           ENDIF;
           C.SubstationName = NewSubName;
           CALLPROC DDB_COMMIT;
       ENDIF;
       
         RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'position',
                                           NewValue = NewSName,
                                           MatchCard = C.Card);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update source breaker at top of card.';
         ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Position',
                 Old  = C.Position,
                 New  = NewSName);
         ENDIF;
         C.Position = NewSName;
         CALLPROC DDB_COMMIT;
         
            SELECT :Grounded = StatusCount
            FROM   FMS_ObjectStatus
            WHERE  Object = :NewSP AND 
                   Status = :Status$Ground AND 
                   StatusCount > 0;

        IF Grounded >= 1 THEN
            NewStationGround = 'On';
        ELSE
            NewStationGround = 'Off';
        ENDIF;

     IF NewStationGround  <> C.StationGround THEN
        RetCode = CALLPROC FMS_CardGenericUpd(FieldName = 'stationground',
                                              NewValue = NewStationGround,
                                              MatchCard = C.Card);
        IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to update station ground status at top of card.';
        ELSE
            CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'StationGround',
                 Old  = C.StationGround,
                 New  = NewStationGround);
        ENDIF;
        C.StationGround = NewStationGround;
        CALLPROC DDB_COMMIT;
     ENDIF;
     
     CALLPROC FMS_ManageCardHeader (OptionalFeeder = CardFeeder);
     FCFrame.SendUserEvent (EventName = 'Load_Card');

    RETURN PU_OK;
END;      

