/**     Start of Temperature Variable Operating Steps        **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with TV Operating step data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED 
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :TM$TVBogey
   ORDER BY Card, Status
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
/*
**  Only get new Bogeys if Flag is enabled.
*/
   IF BogeyEnabled = TRUE THEN
      REPEATED 
      SELECT CurObject.clist[i].Card = C.Card,
             CurObject.clist[i].Type = :TM$TVBogey,
             CurObject.clist[i].Description = T.Description,
             CurObject.clist[i].Division = OO.PrimaryGrouping,
             CurObject.clist[i].Feeder = C.Feeder,
             CurObject.clist[i].FeederName = C.FeederName,
             CurObject.clist[i].CardClass = C.CardClass,
             CurObject.clist[i].CardClassName = C.CardClassName,
             CurObject.clist[i].Object = 0,
             CurObject.clist[i].Status = OSS.OperatingStep,
             CurObject.clist[i].StartTime = OSS.StartTime
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             FMS_OperatingStepStatus OSS,
             Udb_SuperType ST,
             Udb_Type T,
             Udb_Object O,
             Udb_Object OO,
             Udb_ExtendedType ET
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey > 0 AND 
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
             C.Card = OSS.Card AND
             OSS.OperatingStep <> :Type$OperatingStepCount AND
             OSS.OperatingStep <> :Type$OTWPlus AND
             OSS.EndTime = '' AND
             OSS.OperatingStep = ST.Type AND
             ST.SuperType = :Type$OperatingStepStatus AND
             ST.Type = T.Type AND
             C.Card = CTO.Card AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = OO.Object AND
             OO.Type = ET.Type AND
             ET.SuperType = :Type$Substation
      UNION
      SELECT C.Card,
             :TM$TVBogey,
             T.Description,
             OO.Object,
             C.Feeder,
             C.FeederName,
             C.CardClass,
             C.CardClassName,
             0,
             OSS.OperatingStep,
             OSS.StartTime
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             FMS_OperatingStepStatus OSS,
             Udb_SuperType ST,
             Udb_Type T,
             Udb_Object OO
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey > 0 AND /* -1 means no fault info entered by cutin */
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
             C.Card = OSS.Card AND
             OSS.OperatingStep <> :Type$OperatingStepCount AND
             OSS.OperatingStep <> :Type$OTWPlus AND
             OSS.EndTime = '' AND
             OSS.OperatingStep = ST.Type AND
             ST.SuperType = :Type$OperatingStepStatus AND
             ST.Type = T.Type AND
             C.Card = CTO.Card AND
             CTO.Object = OO.Object  AND
             OO.Type = :Type$Division
      ORDER BY Card, Status
      BEGIN
         i = i + 1;
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

