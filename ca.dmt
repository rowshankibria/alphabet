   SELECT :Delay_SF.Reason = DelayReason,
          :Delay_SF.NewOutageDate = NewOutageDate
   FROM   SOA_OutageRequest
   WHERE  SWPNumber = :swp_tf[CurrentRow].ORNumber;
   CALLPROC DDB_ROLLBACK;
*/   
   IF Delay_SF.NewOutageDate = '' THEN
      Delay_SF.NewOutageDate = IFNULL(SWP_TF[CurrentRow].SkedOutageDate, DATE('NOW'));
   ENDIF;
   FIELD(Delay_SF).CurBias = FB_CHANGEABLE;
END;

ON CLICK Delay_SF.OK_Btn = 
BEGIN
/*
   IF SQUEEZE(Delay_SF.Reason) = '' OR Delay_SF.NewOutageDate = '' THEN
      MESSAGE 'Please enter the delay reason and new outage date.';
      RESUME;
   ENDIF;
   
   RetCode = CALLPROC SOA_SWPDelay (
               SWPNumber = swp_tf[CurrentRow].ORNumber,
               DelayReason = Delay_SF.Reason,
               NewOutageDate = Delay_SF.NewOutageDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (
                     UserMessage = 'ERROR: Unable to save delay reason for ' + swp_tf[CurrentRow].ORNumber,
                     TraceMessage = 
                       'SWP_Summary: ' +
                       'Unable to save delay reason for ' + swp_tf[CurrentRow].ORNumber);
      RESUME;
   ELSE
      CALLPROC DDB_COMMIT;
      swp_tf[CurrentRow].NewOutageDate = Delay_SF.NewOutageDate;
   ENDIF;
   FIELD(Delay_SF).CurBias = FB_INVISIBLE;
*/   
   IF SWP_TF[CurrentRow].NewOutageDate = '' AND SWP_TF[CurrentRow].SkedOutageDate < DATE('Now')  OR 
      SWP_TF[CurrentRow].NewOutageDate <> '' AND SWP_TF[CurrentRow].NewOutageDate < DATE('Now') THEN
      FIELD(SWP_TF[CurrentRow].SkedOutageDate).BGColor = CC_PALE_ORANGE;
   ELSE
      FIELD(SWP_TF[CurrentRow].SkedOutageDate).BGColor = CC_PALE_CYAN;
   ENDIF; 
END;

