*/

METHOD LoadMatrix(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.CondList.Clear();
   i = 1;
   SELECT    
         :CurObject.CondList[i].RowID = RowID,
         :CurObject.CondList[i].Sequence = Sequence,
         :CurObject.CondList[i].ClosedBreaker = ClosedBreaker,
         :CurObject.CondList[i].FdrBkrTimerMPR = FdrBkrTimerMPR,
         :CurObject.CondList[i].FdrBkrTimerLOR = FdrBkrTimerLOR,
         :CurObject.CondList[i].BusBkrTimerMPR = BusBkrTimerMPR,
         :CurObject.CondList[i].BusBkrTimerLOR = BusBkrTimerLOR,
         :CurObject.CondList[i].BusOverCurrent = BusOverCurrent,
         :CurObject.CondList[i].BusDifferential = BusDifferential,
         :CurObject.CondList[i].FeederTarget = FeederTarget,
         :CurObject.CondList[i].VisibleBusFault = VisibleBusFault,
         :CurObject.CondList[i].PQRTF = PQRTF,
         :CurObject.CondList[i].PQRMS = PQRMS,
         :CurObject.CondList[i].ManholeEvent = ManholeEvent,
         :CurObject.CondList[i].VisibleFaultFOD = VisibleFaultFOD,
         :CurObject.CondList[i].Action = Action
   FROM  SOA_BusFaultCorrelationMatrix
   WHERE MatrixType = :CurObject.MatrixType 
   ORDER BY Sequence ASC
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
END;

METHOD GetRecommendation(
   BFCCond = BusFaultOutageClass;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';
   
   FOR i = 1 TO CurObject.CondList.LastRow DO
       IF CurObject.CondList[i].BusDifferential <> '*' THEN
          IF (CurObject.CondList[i].BusDifferential = 'O' AND BFCCond.BDFound = 0) OR
             (CurObject.CondList[i].BusDifferential = 'X' AND BFCCond.BDFound = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].BusOverCurrent <> '*' THEN
          IF (CurObject.CondList[i].BusOverCurrent = 'O' AND BFCCond.BOCFound = 0) OR
             (CurObject.CondList[i].BusOverCurrent = 'X' AND BFCCond.BOCFound = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].FdrBkrTimerMPR <> '*' THEN
          IF (CurObject.CondList[i].FdrBkrTimerMPR = 'O' AND BFCCond.FBMPR = 0) OR
             (CurObject.CondList[i].FdrBkrTimerMPR = 'X' AND BFCCond.FBMPR = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].FdrBkrTimerLOR <> '*' THEN
          IF (CurObject.CondList[i].FdrBkrTimerLOR = 'O' AND BFCCond.FBLOR = 0) OR
             (CurObject.CondList[i].FdrBkrTimerLOR = 'X' AND BFCCond.FBLOR = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;
       
/* Obsolete ??? Leave it here for now.       
       IF CurObject.CondList[i].BackupTimer <> '*' THEN
          IF (CurObject.CondList[i].BackupTimer = 'O' AND BFCCond.BUTOperated = 0) OR
             (CurObject.CondList[i].BackupTimer = 'X' AND BFCCond.BUTOperated = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;
*/
       IF CurObject.CondList[i].BusBkrTimerMPR <> '*' THEN
          IF (CurObject.CondList[i].BusBkrTimerMPR = 'O' AND BFCCond.BBMPR = 0) OR
             (CurObject.CondList[i].BusBkrTimerMPR = 'X' AND BFCCond.BBMPR = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].BusBkrTimerLOR <> '*' THEN
          IF (CurObject.CondList[i].BusBkrTimerLOR = 'O' AND BFCCond.BBLOR = 0) OR
             (CurObject.CondList[i].BusBkrTimerLOR = 'X' AND BFCCond.BBLOR = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].FeederTarget <> '*' THEN
          IF (CurObject.CondList[i].FeederTarget = 'O' AND BFCCond.FTFound = 0) OR
             (CurObject.CondList[i].FeederTarget = 'X' AND BFCCond.FTFound = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].ClosedBreaker <> '*' THEN
          IF (CurObject.CondList[i].ClosedBreaker = 'O' AND BFCCond.ClFdrBkr = 0) OR
             (CurObject.CondList[i].ClosedBreaker = 'X' AND BFCCond.ClFdrBkr = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;


       IF CurObject.CondList[i].VisibleBusFault <> '*' THEN
          IF (CurObject.CondList[i].VisibleBusFault = 'O' AND BFCCond.VBFault = 0) OR
             (CurObject.CondList[i].VisibleBusFault = 'X' AND BFCCond.VBFault = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;       

       IF CurObject.CondList[i].PQRTF <> '*' THEN
          IF (CurObject.CondList[i].PQRTF = 'O' AND BFCCond.PQFound = 0) OR
             (CurObject.CondList[i].PQRTF = 'X' AND BFCCond.PQFound = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].PQRMS <> '*' THEN
          IF (CurObject.CondList[i].PQRMS= 'O' AND BFCCond.PQRMSFound = 0) OR
             (CurObject.CondList[i].PQRMS = 'X' AND BFCCond.PQRMSFound = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       IF CurObject.CondList[i].ManholeEvent <> '*' THEN
          IF (CurObject.CondList[i].ManholeEvent= 'O' AND BFCCond.MHEvent = 0) OR
             (CurObject.CondList[i].ManholeEvent = 'X' AND BFCCond.MHEvent = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;
       
       IF CurObject.CondList[i].VisibleFaultFOD <> '*' THEN
          IF (CurObject.CondList[i].VisibleFaultFOD= 'O' AND BFCCond.VFFOD = 0) OR
             (CurObject.CondList[i].VisibleFaultFOD = 'X' AND BFCCond.VFFOD = 1) THEN
             // MATCH
          ELSE
             CONTINUE;
          ENDIF;
       ENDIF;

       BFCCond.Action = CurObject.CondList[i].Action;
       RETURN;
   ENDFOR;  

   BFCCond.Action = 'No recommendation';
END;
   

