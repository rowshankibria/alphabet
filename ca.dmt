Application Component Report
============================

	Name:            PromptAmmeterClear

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptAmmeterClear
**
**  Modifications:
**	 01/16/93 gjc     Frame Created.
**  02/11/93  adl   Added call to create FOT card. 
**  03/03/93  em    Added One Phase, all phase feature.  changed
**                  failure criteria.  0 is acceptable, as are
**                  values over 1.0 so long as the value is not
**                  greater than .1 more than the next highest value.
**  03/05/93  em    removed COMMITs and ROLLBACKs, this procedure is
**                  part of much larger transaction.
**  05/08/93  em    corrected variance which didn't allow 0.00 results.
**  06/23/93  gjc   Changed call to FOT to the more general CreateXferCard
**                  routine.
**  05/09/94  mts   Changed call to suspecttest (SuspectTest no longer cares who calls it).
**  06/05/94  em    changed return to PU_CANCEL when creating FOT.
**  06/05/94  mts   removed reference to cancel button which is history
**  06/06/94  em    return special code following FOT creation.
**  03/27/94  em    Don't record failed test results unless failed test is accepted
**  08/14/95  pw    change callproc createxfercard to callframe createxfercard
**  04/11/97  jfl   fms205: Log the creation of an ISO due to FOT if card was ISO
**  02/20/01  ym    If the ir_downloadmove table is inserted for the issued
**                  move's information, the prompt frame of ammeter clear
**                  for this move should be just visible for the user. 
**  03/02/01  em    Set response when coming from an Operating Order also
**                  Go back to not making test results changeable since we 
**                  have already saved them into the history.  If we do
**                  want the DO to change SSO test results, we will need to 
**                  add a test result update database procedure.
**  04/08/01  my    The information will be recorded in the IR_FOTCount
**                  table when an ammeter clear test ha failed and the user
**                  creates a Fail on Test card when completing the Ammeter
**                  Clear move and recording the failed test results.
**  05/03/01  em    Changed FOT Count process.
**  07/19/01  em    Passing Parms and letting CreateXferCard process insert
**                  FOTCount info.
**  08/22/01  pkw   Don't log values in history that are greater than 1.
**  08/29/01  pkw   Pass OpOrder flag into Suspect test.  When returning 
**                  data from SOO the D.O. shouldn't be able to canel out of 
**                  the transaction so we will hide cancel button in this case. 
**  01/14/02  em    Introduced RR Considerations before creating FOT card.
**  08/16/02  em    Added processing for Fail Test No FOT return from 
**                  Suspect Test.
**  10/31/02  em    Job to JIP. 
**  03/10/04  em    If Automatic Execution, then test results must have been already 
**                  evaluated and we can continue as if test passed.
**  04/09/04  em    Delete test results on No FOT
**  03/01/06  ysp   FMS 335: Send a notification if the test failed and DO selects
**                  "Create FOT" or "No FOT" button.
**  08/04/08  ysp   FMS 382: pass FMS card object to SuspectTest frame so that it
**                  can checks for outstanding operating orders.
**  03/25/09  YSP   Support DO's adjustment of test results.
**  04/21/09  ysp   Temporarily turn off DO's adjustment of results
**  05/11/09  ysp   Add second DO confirmation.
**  05/22/09  ysp   Adjust the position of the 2nd DO confirmation stack field.
**  05/22/09  ysp   Save job id when saving manually entered test results.
**  01/27/10  ysp   Add email subject and template to class
**  11/11/10  em    Modify to support 3G, including adding FeederName to test history table.
**                  Save test history for each feeder on 3G card.
**  11/19/10  em    Modify load of test history to correct problems
**  12/06/10  em    IF KnownPointISO, CreateFOT cannot be an option
**  01/02/13  ysp   1. Prompt the user when the OK button is clicked if adjusted results have not been saved.
**                  2. Delay FOT card transfer if there are outstanding moves to confirm.
**  07/20/16  ysp   Save test result on the 33kv main feeder even if the job is completed on a portion card.
**  03/13/18  em    If DO hits copy with value = 0.00, don't check for 0's and present message on ok click
**  
*/
INITIALIZE
(
   JIP = JobInProgress;               /* Parm */

   C = FMS_Card;                      /* Load necessary card info */
   FeederObj = INTEGER NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; 
   NewCard = INTEGER NOT NULL WITH DEFAULT; 
   vtestdate = DATE NOT NULL WITH DEFAULT; /* test date */
   vphasearesult = FLOAT NOT NULL WITH DEFAULT; /* test result of phase A */
   vphasebresult = FLOAT NOT NULL WITH DEFAULT; /* test result of phase B */
   vphasecresult = FLOAT NOT NULL WITH DEFAULT; /* test result of phase C */
   FailedTestValues = VARCHAR (200) NOT NULL WITH DEFAULT;
   FHighTest = AmmeterClearTest;                             /* Highest test history */
   FTest = AmmeterClearTest;                                 /* Test being entered   */
   TestSuspect = INTEGER;                                    /* Test may have failed */
   BadPhase = VARCHAR (9) NOT NULL WITH DEFAULT;             /* Test may have failed */
   SuspectTestPhase = VARCHAR (100) NOT NULL WITH DEFAULT;   /* Suspect Test Message */
   ReturnStatus = INTEGER;                                   /* Return from frame    */
   KPSFeeder = INTEGER NOT NULL WITH DEFAULT;
   LogErrorText = VARCHAR (60);                              /* Error Text           */
   LogBaseTest =  VARCHAR (60);                              /* Test Base            */
   i = INTEGER NOT NULL WITH DEFAULT;                        /* Scratch integer      */
   status = INTEGER; 
   PhaseAChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
   PhaseBChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
   PhaseCChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
   DecimalLocation = INTEGER NOT NULL WITH DEFAULT;          /* used to locate '.'   */
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;         /* DBEventText */
   OpOrder = INTEGER NOT NULL WITH DEFAULT;
   DOObject = OperatorClass;
   ACFeeders = ARRAY OF pas!ObjectSummaryClass;             /* for recording test results */
   HitCopy = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   NotifyFailedTest = PROCEDURE;
ENDDECLARE
BEGIN
/*
** Get needed FMS Card information
*/
   HitCopy = FALSE;
   KPSFeeder = FALSE;
   C.Card = 0;

   REPEATED
   SELECT 
   DISTINCT
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.Card = C.Card,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.NetworkFeeder = C.NetworkFeeder,
          :C.TypeOfCard = C.TypeOfCard
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;

   IF C.Card = 0 THEN
      CALLPROC TraceError (UserMessage =
              'ERROR: Move is not related properly to an FMS Card.',
                           TraceMessage = 
              'PromptAmmeterClear: Move is not related properly to an FMS Card'
                          );
      RETURN (PU_CANCEL);
   ENDIF;  

   IF C.CardClass = Type$ISO AND C.TypeOfCard = TypeOfCard$13kV THEN
      KPSFeeder = TRUE;
   ENDIF;

   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      i = 1;
      SELECT C.Object[i].Object = Object,
             C.Object[i].Name = Name
      FROM   TFMS_CardToObject 
      WHERE  Card = :C.Card
      BEGIN
         i = i + 1;
      END;

      FeederObj = C.Object[1].Object;
      FeederName = C.Object[1].Name;
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');

      IF C.Object.LastRow() > 1 THEN
         FIELD(NetworkFeeder).ValueList.ChoiceItems.Clear();
         FOR i = 1 TO C.Object.LastRow() DO
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumValue = C.Object[i].Object;
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumText = C.Object[i].Name;
         ENDFOR;
         FIELD(NetworkFeeder).CurBias = FB_CHANGEABLE;
         /* OR5.1 FIELD(NetworkFeeder).ColumnWidthCompressed = TRUE; */
         FIELD(NetworkFeeder).UpdChoiceList();
      ENDIF;
      FIELD(Ammeter_Tests[*].FeederName).CurBias = FB_LANDABLE;   
      FIELD(Feeder_Name).CurBias = FB_LANDABLE;
   ELSE
      FeederObj = C.Feeder;
      FeederName = C.FeederName;
      C.Object[1].Object = C.Feeder;
      C.Object[1].Name = C.FeederName;
      field(Feeder_Name).TextLabel = 'Feeder: ' + C.FeederName;
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');
   ENDIF;

   /*
   ** decide where the test results will be recorded 
   */
   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      ACFeeders = C.Object.Duplicate();
         
   ELSEIF C.NetworkFeeder = NetworkFeeder$33KV THEN
      IF C.TypeOfCard = TypeOfCard$Portion THEN
         /* Hi Pot test applied to the main feeder only
         */
         SELECT  :ACFeeders[1].Object = C.Feeder,
                 :ACFeeders[1].Name = C.FeederName
         FROM    FMS_PortionLink L,
                 FMS_Card C
         WHERE   L.PortionCard = :C.Card AND
                 L.Card = C.Card;
         /* 
         ** append portion feeder name to the main feeder name
         */         
         ACFeeders[1].Name = ACFeeders[1].Name + ' ' + C.FeederName
      ELSE
         ACFeeders[1].Object  = C.Feeder;
         ACFeeders[1].Name  = C.FeederName;
      ENDIF;
   ELSE
      ACFeeders = C.Object.Duplicate();
   ENDIF;   
END;


ON SETVALUE NetWorkFeeder =
BEGIN
   FeederObj = FIELD(NetworkFeeder).CurEnumValue;
   FeederName = FIELD(NetworkFeeder).CurEnumText;
   CurFrame.SendUserEvent (EventName = 'LoadDisplay');
END;


ON USEREVENT 'LoadDisplay' = 
BEGIN
   PhaseAResult = 0.00;
   PhaseBResult = 0.00;
   PhaseCResult = 0.00;

   i = 1;
   Ammeter_Tests.Clear();
   SELECT  :Ammeter_Tests[i].TestDate = testdate,
           :Ammeter_Tests[i].FeederName = FeederName,
           :Ammeter_Tests[i].PhaseAResult = phasearesult,
           :Ammeter_Tests[i].PhaseBResult = phasebresult,
           :Ammeter_Tests[i].PhaseCResult = phasecresult
   FROM     FMS_AmmeterClearTest
   WHERE    Feeder = :FeederObj
   ORDER BY 1 DESC
   BEGIN
    i = i + 1;
   END;

   SELECT  :FHighTest.PhaseAResult = IFNULL(max(phasearesult),0) + 0.1,
           :FHighTest.PhaseBResult = IFNULL(max(phasebresult),0) + 0.1,
           :FHighTest.PhaseCResult = IFNULL(max(phasecresult),0) + 0.1
   FROM     FMS_AmmeterClearTest
   WHERE    Feeder = :FeederObj AND
           Job <> :JIP.Job;

   TestDate = DATE('NOW');
/*
** Load test data for the job, if test data exists, the move was likely downloaded
** to an operating order and the Substation Operating has already 
** supplied the test results.  We display them and let the DO confirm them.
*/
   SELECT :vtestdate = testdate,
          :vphasearesult = phasearesult,
          :vphasebresult = phasebresult,
          :vphasecresult = phasecresult
   FROM   FMS_AmmeterClearTest
   WHERE  job = :JIP.Job;

   IF iirowcount > 0 THEN
      OpOrder = TRUE;
      FIELD(doentry).CurBias = FB_INVISIBLE;
      FIELD(oporderentry).Curbias = FB_VISIBLE;
      FIELD(testdate).Curbias = FB_VISIBLE;
      FIELD(phasearesult).Curbias = FB_VISIBLE;
      FIELD(phasebresult).Curbias = FB_VISIBLE;
      FIELD(phasecresult).Curbias = FB_VISIBLE;
      testdate = vtestdate;
      phasearesult = vphasearesult;
      phasebresult = vphasebresult;
      phasecresult = vphasecresult;
      Field(TestDate).ParentField.HasDataChanged = TRUE;
      /* 
      ** set default bgcolor 
      */
      FIELD(testdate).BGColor = CC_PALE_PURPLE;
      FIELD(phasearesult).BGColor = CC_PALE_PURPLE;
      FIELD(phasebresult).BGColor = CC_PALE_PURPLE;
      FIELD(phasecresult).BGColor = CC_PALE_PURPLE;

      FIELD(Adjust_Btn).Curbias = FB_LANDABLE;
   ENDIF;   
        
   IF AutomaticExecution = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'MakeInvisible');
   ENDIF;
   CurFrame.Flush();
END; 


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;

ON CLICK Adjust_btn =
BEGIN
   IF FIELD(Adjust_Btn).TextLabel = 'Adjust Result' THEN
      FIELD(phasearesult).Curbias = FB_CHANGEABLE;
      FIELD(phasebresult).Curbias = FB_CHANGEABLE;
      FIELD(phasecresult).Curbias = FB_CHANGEABLE;
      FIELD(phasearesult).BGColor = CC_PALE_CYAN;
      FIELD(phasebresult).BGColor = CC_PALE_CYAN;
      FIELD(phasecresult).BGColor = CC_PALE_CYAN;
      FIELD(Adjust_Btn).TextLabel = 'Save Result';

   ELSE
      DetStack.OpConfirm.Operator1 = Dop.Description;
      /* make sure that ammeter_test table's parant field is wider than the detstack field 
      */ 
      FIELD(DetStack).AbsXLeft = (FIELD(Adjust_BTN).ParentField.ParentField.Width - FIELD(DetStack).Width)/2;
      FIELD(DetStack).AbsYBottom = FIELD(Adjust_BTN).ParentField.AbsYBottom;
      FIELD(DetStack).CurBias = FB_CHANGEABLE;
      CurFrame.IsAutoSized = TRUE;
      CurFrame.Flush();
   ENDIF;
END;

ON CLICK DetStack.OK_Btn = 
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;

   NewValues = VARCHAR(80) NOT NULL WITH DEFAULT;
   OldValues = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN 
   FIELD(phasearesult).Curbias = FB_VISIBLE;
   FIELD(phasebresult).Curbias = FB_VISIBLE;
   FIELD(phasecresult).Curbias = FB_VISIBLE;
   FIELD(phasearesult).BGColor = CC_PALE_PURPLE;
   FIELD(phasebresult).BGColor = CC_PALE_PURPLE;
   FIELD(phasecresult).BGColor = CC_PALE_PURPLE;
   FIELD(Adjust_Btn).TextLabel = 'Adjust Result';
     
   IF phasearesult = vphasearesult AND
      Phasebresult = vphasebresult AND
      phasecresult = vphasecresult THEN

      MESSAGE 'You did not change the result.';
      FIELD(DetStack).CurBias = FB_INVISIBLE;

      RESUME;
   ENDIF;
      
   IF DetStack.OpConfirm.Operator2 = '' THEN
       MESSAGE 'A second operator or manager must confirm this change!';
       RESUME;
   ENDIF;
/*
** Evaluate entered employee number
*/
   DOObject.Name = DetStack.OpConfirm.Operator2;
   Status = DOObject.IsDOOnDesk();
   IF Status = PU_CANCEL THEN
      RESUME;
   ENDIF;

   FOR i = 1 TO ACFeeders.LastRow() DO
      Status = CALLPROC IR_AmmeterClearDistUpd(
           Feeder = ACFeeders[i].Object,
           Job = JIP.Job,
           TestDate = TestDate,
           phasearesult = phasearesult,
           Phasebresult = phasebresult,
           phasecresult = phasecresult);

      IF Status < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Failed to save adjustments due to database error. Try again.',
                     TraceMessage = 'PromptAmmeterClear; Failed to save adjustments due to database error');

         phasearesult = vphasearesult;
         phasebresult = vphasebresult;
         phasecresult = vphasecresult;

         FIELD(DetStack).CurBias = FB_INVISIBLE;
         RESUME;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT; 

   OldValues = 'A:' + VARCHAR(vphasearesult) + 
               ', B:' + VARCHAR(vphasebresult) + 
               ', C:' + VARCHAR(vphasecresult);

   NewValues = 'A:' + VARCHAR(phasearesult) + 
               ', B:' + VARCHAR(phasebresult) + 
               ', C:' + VARCHAR(phasecresult); 

   CALLPROC SOA_LogIns (
                 Card = JIP.Card,
                 Job  = JIP.Job,
                 SwitchingItem = JIP.SwitchingItem,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Adjust Ammeter',
                 Old = OldValues,
                 New = NewValues);
/*
** refresh the original values.
*/
   vphasearesult = phasearesult;
   vphasebresult = phasebresult;
   vphasecresult = phasecresult;

   FOR i = 1 TO Ammeter_Tests.LastRow DO
         IF Ammeter_Tests[i].TestDate = testdate THEN
            Ammeter_Tests[i].PhaseAResult = phasearesult;
            Ammeter_Tests[i].PhaseBResult = phasebresult;
            Ammeter_Tests[i].PhaseCResult = phasecresult;
            ENDLOOP;
         ENDIF;
   ENDFOR;
   FIELD(Ammeter_Tests).UpdField();
/*
** Send email to Chief DO
*/
   IF EmailClass IS NULL THEN
         EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 3;            // ammeter update
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'CDO';
   EmailClass.Subject = 'Ammeter Clear Test Result on ' + C.FeederName + ' adjusted by ' + DOp.Description + ' and ' + DOObject.Description;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ' and ' + DOObject.Description +';;' + 
                            'CardID=' + VARCHAR(JIP.Card) + ';;' + 
                            'CardName=' + C.FeederName + ';;' + 
                            'TestDate=' + VARCHAR(TestDate) + ';;';                         
   EmailClass.Message2 = 'OldValue=' + OldValues + ';;' + 
                            'NewValue=' + NewValues + ';;';
   EmailClass.Template = 'AmmeterUpdateToCDO.html';
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
         Message 'Unable to notify Chief D.O. by email';
   ENDIF;
   FIELD(DetStack).CurBias = FB_INVISIBLE;
END;            

ON Click DetStack.Cancel_Btn = 
BEGIN
   phasearesult = vphasearesult;
   phasebresult = vphasebresult;
   phasecresult = vphasecresult;

   FIELD(phasearesult).Curbias = FB_VISIBLE;
   FIELD(phasebresult).Curbias = FB_VISIBLE;
   FIELD(phasecresult).Curbias = FB_VISIBLE;

   FIELD(phasearesult).BGColor = CC_PALE_PURPLE;
   FIELD(phasebresult).BGColor = CC_PALE_PURPLE;
   FIELD(phasecresult).BGColor = CC_PALE_PURPLE;

   FIELD(DetStack).CurBias = FB_INVISIBLE;
   FIELD(Adjust_Btn).TextLabel = 'Adjust Result';
END;


On SetValue doentry.AllPhases,
ON CLICK doentry.Copy_Btn =
BEGIN
    /**
        If copy button was used to alter the data, manually set has data changed flag
        (unless data really did not change.
    **/

    If PhaseAResult = doentry.AllPhases AND
       PhaseBResult = doentry.AllPhases AND
       PhaseCResult = doentry.AllPhases Then
        ;
    Else
        Field(TestDate).ParentField.HasDataChanged = TRUE;
    Endif;   
         
    PhaseAResult = doentry.AllPhases;
    PhaseBResult = doentry.AllPhases;
    PhaseCResult = doentry.AllPhases;
    HitCopy = TRUE;
END;


ON USEREVENT 'CompleteProcessing', 
ON Click Accept_Btn =
DECLARE
   DelayFOTCard = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN
   IF FIELD(Adjust_Btn).TextLabel = 'Save Result' THEN
      IF CurFrame.ConfirmPopup(messagetext = 'You have not saved your change, ' +
           'do you still want to continue?') = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;
   
   IF (Field(TestDate).ParentField.HasDataChanged = FALSE) AND
       AutomaticExecution = FALSE AND HitCopy = FALSE THEN
     IF CurFrame.ConfirmPopup(messagetext = 'You have not changed any ' +
           'data,  do you still want to continue?') = PU_CANCEL THEN
        RESUME;
     ENDIF;
   ENDIF;

   IF TestDate = '' AND AutomaticExecution = FALSE THEN
      MESSAGE 'A test date is required...';
      CurFrame.InputFocusField = FIELD(TestDate);
      RESUME;
   ENDIF;

   IF PhaseAResult IS NULL AND AutomaticExecution = FALSE THEN
      MESSAGE 'Please enter Phase A result...';
      CurFrame.InputFocusField = FIELD(PhaseAResult);
      RESUME;
   ENDIF;

   IF PhaseBResult IS NULL AND AutomaticExecution = FALSE THEN
      MESSAGE 'Please enter Phase B result...';
      CurFrame.InputFocusField = FIELD(PhaseBResult);
      RESUME;
   ENDIF;

   IF PhaseCResult IS NULL AND AutomaticExecution = FALSE THEN
      MESSAGE 'Please enter Phase C result...';
      CurFrame.InputFocusField = FIELD(PhaseCResult);
      RESUME;
   ENDIF;

   TestSuspect = 0;
   BadPhase = '';
   FailedTestValues = '';

   IF PhaseAResult > FHighTest.PhaseAResult or
     PhaseAResult < AmmeterClear$Low  THEN
      TestSuspect = 1;
      BadPhase    = 'A';
      FailedTestValues = 'A=' + VarChar(PhaseAResult);
   ENDIF;

   IF PhaseBResult > FHighTest.PhaseBResult or
     PhaseBResult < AmmeterClear$Low  THEN
      TestSuspect = 1;
      IF LENGTH(BadPhase) > 0 THEN
          BadPhase = BadPhase + ', ';
          FailedTestValues = FailedTestValues  + ', ';
      ENDIF;
      BadPhase    = BadPhase + 'B';
      FailedTestValues = FailedTestValues + 'B=' + VarChar(PhaseBResult);
   ENDIF;

   IF PhaseCResult > FHighTest.PhaseCResult or
     PhaseCResult < AmmeterClear$Low  THEN
      TestSuspect = 1;
      IF LENGTH(BadPhase) > 0 THEN
          BadPhase = BadPhase + ', ';
          FailedTestValues = FailedTestValues  + ', ';
      ENDIF;
      BadPhase    = BadPhase + 'C';
      FailedTestValues = FailedTestValues + 'C=' + VarChar(PhaseCResult);
   ENDIF;
   /*
   **   Convert to char and get rid of trailing 0
   */
   PhaseAChar = pad(squeeze(VarChar(IFNULL(PhaseAResult,0))));
   DecimalLocation = locate(PhaseAChar,'.');
   PhaseAChar = squeeze(shift(PhaseAChar,(size(PhaseAChar) - 
                                         (DecimalLocation + 2))));
   PhaseBChar = pad(squeeze(VarChar(IFNULL(PhaseBResult,0))));
   DecimalLocation = locate(PhaseAChar,'.');
   PhaseBChar = squeeze(shift(PhaseBChar,(size(PhaseBChar) - 
                                         (DecimalLocation + 2))));
   PhaseCChar = pad(squeeze(VarChar(IFNULL(PhaseCResult,0))));
   DecimalLocation = locate(PhaseAChar,'.');
   PhaseCChar = squeeze(shift(PhaseCChar,(size(PhaseCChar) - 
                                         (DecimalLocation + 2))));

   IF TestSuspect = 1 AND AutomaticExecution = FALSE THEN

      LogErrorText = 'Amm Clear Result-' +
                     ' A: ' + PhaseAChar +
                     ', B: ' + PhaseBChar +
                     ', C: ' + PhaseCChar;
      LogBaseTest  = 'Max Values Allowed-' +
                     ' A: ' + VARCHAR (FHighTest.PhaseAResult) +
                     ', B: ' + VARCHAR (FHighTest.PhaseBResult) +
                     ', C: ' + VARCHAR (FHighTest.PhaseCResult);
      CALLPROC SOA_LogIns (Card = C.Card,
                  SwitchingItem = 0,
                  Job  = JIP.Job,
                  Time = DATE('now'),
                  UserName = UserName,
                  Item = 'TEST FAILED',
              Old  = LogErrorText,
             New  = LogBaseTest);

      CALLPROC DDB_COMMIT;
/*
** Take a record of the time of the test failed.
*/
      SuspectTestPhase = 'Your Ammeter Clear test failed on Phase ' +
                         BadPhase + '.';
      ReturnStatus = 0;
      ReturnStatus = CALLFRAME SuspectTest(C = C,
                                           Text = SuspectTestPhase,
                                           OpOrderFailure = OpOrder,
                                           KPSFeeder = KPSFeeder);
      IF ReturnStatus = PU_OK THEN
         /* 
         ** DO selects "Create FOT", send a notification.
         */
         CALLPROC NotifyFailedTest(TestResult = FailedTestValues);
         /*
         ** Clear any saved test results that might have been returned
         ** from Rapid Restore.
         */
         FOR i = 1 TO ACFeeders.LastRow() DO
           status = CALLPROC FMS_FailedACTestDel (
                       Job = JIP.Job,
                       Feeder = ACFeeders[i].Object,
                       TestDate = TestDate );
           IF Status <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             CALLPROC TraceError (UserMessage =
                'ERROR: Failed test results could not be deleted from ' +
                'test history.  Have tech support review trace log.',
                     TraceMessage = 
                'PromptAmmeterClear: Unable to remove failed test results ' +
                'for Job:' + VARCHAR(JIP.Job)
                    );
           ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;

         JIP.Response = 'Test Failed - FOT';
         JIP.ResponseUpd();
         
         DelayFOTCard = FALSE;
         IF OrderReturnStatus IS NOT NULL THEN
            IF OrderReturnStatus.DelayFOT = TRUE THEN
               DelayFOTCard = TRUE;
               OrderReturnStatus.TestType = 'A';
               OrderReturnStatus.TestDate = TestDate;
               RETURN(PU_OK);
            ENDIF;
         ENDIF;

         IF DelayFOTCard = FALSE THEN
            /* 
            **  Create FOT card if card is not ISO
            **  else create another ISO 
            **  (the substitution to ISO is done in the called frame) 
            */ 
            status = CALLFRAME CreateXferCard
               (OldCardID    = C.Card, 
                XferCardKey = byref(NewCard),
                XferCardClass = Type$FOT, 
                TestType = 'A',
                TestDate = TestDate
                );
            IF (status = PU_OK) THEN 
                CALLPROC DDB_COMMIT;
                /*
                ** Log the creation of a transfer ISO card due to FOT
                */
                IF C.CardClass = Type$ISO THEN
                   CALLPROC SOA_LogIns (Card = NewCard,
                          SwitchingItem = 0,
                          Job  = NULL,
                          Time = DATE('now'),
                          UserName = UserName,
                          Item = 'Xfer Card Created',
                          Old  = '',
                          New  = 'Reason: AmmClear FOT');
                   CALLPROC DDB_COMMIT;
                ENDIF;
                /* 
                ** Update the active list on the feedercard frame 
                ** and load the new FOT card into the frame:    
                */ 
                FCFrame.SendUserEvent(EventName = 'update_xfer', 
                                      messageinteger = NewCard);
                /* 
                **  Stop processing of moves by returning special code back through 
                **  job actions
                */
                RETURN (Type$FOT);
            ELSE
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to create FOT Card.',
                  TraceMessage = 
                  'PromptAmmeterClear: Unable to create FOT Card.'
                       );
                RETURN (PU_CANCEL);
            ENDIF; 
         ENDIF;
      ELSEIF ReturnStatus = PU_CANCEL THEN
          RETURN (PU_CANCEL);

      ELSEIF ReturnStatus = FailTest$Accept THEN
          CALLPROC SOA_LogIns (Card = NewCard,
                       SwitchingItem = 0,
                       Job  = NULL,
                       Time = DATE('now'),
                       UserName = UserName,
                  Item = 'FORCED OK',
                  Old  = LogErrorText,
                  New  = LogBaseTest);
          CALLPROC DDB_COMMIT;

      ELSEIF ReturnStatus = FailTest$RRConsideration THEN
         /*
         ** Clear any saved saved test results that might have been returned
         ** from Rapid Restore.
         */
         FOR i = 1 TO ACFeeders.LastRow() DO
           status = CALLPROC FMS_FailedACTestDel (
                       Job = JIP.Job,
                       Feeder = ACFeeders[i].Object,
                       TestDate = TestDate );
           IF Status <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             CALLPROC TraceError (UserMessage =
                'ERROR: Failed test results could not be deleted from ' +
                'test history.  Have tech support review trace log.',
                     TraceMessage = 
                'PromptAmmeterClear: Unable to remove failed test results ' +
                'for Job:' + VARCHAR(JIP.Job)
                    );
           ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;

          CALLPROC SOA_LogIns (Card = NewCard,
                       SwitchingItem = 0,
                       Job  = JIP.Job,
                       Time = DATE('now'),
                       UserName = UserName,
                  Item = 'Test Failed',
                  Old  = 'RR Considerations',
                  New  = 'FOT not created');
          CALLPROC DDB_COMMIT;

      ELSEIF ReturnStatus = FailTest$NoFOT THEN
         /* 
         ** DO selects "No FOT", send a notification.
         */
         CALLPROC NotifyFailedTest(TestResult = FailedTestValues);

   /*
   ** Clear any saved saved test results that might have been returned
   ** from Rapid Restore.
   */
         FOR i = 1 TO ACFeeders.LastRow() DO
            status = CALLPROC FMS_FailedACTestDel (
                       Job = JIP.Job,
                       Feeder = ACFeeders[i].Object,
                       TestDate = TestDate );
            IF Status <> 0 THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
                 'ERROR: Failed test results could not be deleted from ' +
                 'test history.  Have tech support review trace log.',
                              TraceMessage = 
                 'PromptAmmeterClear: Unable to remove failed test results ' +
                 'for Job:' + VARCHAR(JIP.Job)
                    );
            ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;

         CALLPROC SOA_LogIns (Card = NewCard,
                       SwitchingItem = 0,
                       Job  = JIP.Job,
                       Time = DATE('now'),
                       UserName = UserName,
                  Item = 'Test Failed',
                  Old  = '',
                  New  = 'Clicked "No FOT"');
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
        
   IF Field(OpOrderEntry).CurBias = FB_INVISIBLE AND
       ReturnStatus <> FailTest$RRConsideration AND 
       ReturnStatus <> FailTest$NoFOT  THEN
      /*
      ** Per ConEd request, if D.O. accepts values over 1, we will not
      ** log them in the AmmeterClearHistory table.
      */          
      IF PhaseAResult < 1 AND
         PhaseBResult < 1 AND
         PhaseCResult < 1 THEN          

         FOR i = 1 TO ACFeeders.LastRow() DO
             status = FMS_AmcTstHistIns (Feeder = ACFeeders[i].Object,
                             FeederName = C.FeederName,
                             Job = JIP.Job,
                             TestDate = TestDate,
                             PhaseAResult = IFNULL(PhaseAResult,0),
                             PhaseBResult = IFNULL(PhaseBResult,0),
                             PhaseCResult = IFNULL(PhaseCResult,0));
             IF status <> 0 THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
                'ERROR: Unable to save ammeter clear test results.',
                           TraceMessage = 
                'PromptAmmeterClear: Unable to update ammeter clear history.'
                           );
                RETURN (PU_CANCEL);
             ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;
         JIP.Response = 'A' + PhaseAChar +
                   '/' + 'B' + PhaseBChar +
                   '/' + 'C' + PhaseCChar;
         JIP.ResponseUpd();
         RETURN (PU_OK);
      ELSE
         JIP.Response = 'A' + PhaseAChar +
                      '/' + 'B' + PhaseBChar +
                      '/' + 'C' + PhaseCChar;
         JIP.ResponseUpd();
         RETURN (PU_OK);
      ENDIF;
   ELSE
     JIP.Response = 'A' + PhaseAChar +
                   '/' + 'B' + PhaseBChar +
                   '/' + 'C' + PhaseCChar;
     JIP.ResponseUpd();
     RETURN (PU_OK);
   ENDIF;

END;

ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

Procedure NotifyFailedTest(
   TestResult = VARCHAR(200) NOT NULL WITH DEFAULT;
)
=
DECLARE
   DCCRegion = VARCHAR(20) NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
ENDDECLARE
BEGIN
   MsgText = 'Feeder ' + C.FeederName + 
             ' - Ammeter Clear Test Failed with ' + TestResult + '.';

   DccRegion = '';

   /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
          :DccRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :FeederObj AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                      ,MessageText = MsgText 
                                      ,Time = date('now')
                                      ,Priority = 0
                                      ,MessageType = 0
                                      ,Card = C.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace (Text = 'Automated DCC message ' + 
              'not sent for ' + C.FeederName + ' regarding: ' + 
              MsgText);
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;
END;
