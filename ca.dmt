Application Component Report
============================

	Name:            RegisteredTags_ASE


���p�x��Component Method Scripts
���p�x��--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          RegisteredTags_ASE
**
**  Date:    Version Description
** ----------------------------------
**  06/23/03  pkw    Created; 
**  09/26/16  ysp    Add CheckFeederType flag to support 33kv portions on FMS Online
**  02/09/18  ysp    Add report filtered by divisions 
*/ 
METHOD LoadRegTags (
   CheckFeederType = INTEGER NOT NULL WITH DEFAULT
)=
DECLARE
   i = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
   FeederType = INTEGER NOT NULL WITH DEFAULT;
   MainFeeder = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all registered tags of a specified feeder.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Feeder > 0 THEN
      MainFeeder = CurObject.Feeder;
      
      IF CheckFeederType = TRUE THEN
         FeederType = 0;
         SELECT :FeederType = O.Type
         FROM   UDB_Object O
         WHERE  O.Object = :CurObject.Feeder;
         
         IF FeederType = Type$PortionFeeder THEN
            SELECT :MainFeeder = C2.Feeder
            FROM   FMS_Card C1,
                   FMS_Card C2,
                   FMS_PortionLink L
            WHERE  C1.Feeder = :CurObject.Feeder AND
                   C1.Card = L.PortionCard AND
                   L.Card = C2.Card;
         ENDIF;
      ENDIF;
      
      CurObject.RT.Clear();
      i = 1;
      REPEATED
      SELECT :CurObject.RT[i].TagNumber = R.TagNumber, 
             :CurObject.RT[i].LocationStructure  = R.LocationStructure, 
             :CurObject.RT[i].Feeder    = R.Feeder, 
             :CurObject.RT[i].FeederName = O.Name, 
             :CurObject.RT[i].TagSentDate = R.TagSentDate, 
             :CurObject.RT[i].LocationStreet = R.LocationStreet, 
             :CurObject.RT[i].TagSentBy  = R.TagSentBy,
             :CurObject.RT[i].Phases = R.Phases, 
             :CurObject.RT[i].BrassTag = R.BrassTag, 
             :CurObject.RT[i].PlasticTag = R.PlasticTag,
             :CurObject.RT[i].TagNotes = R.TagNotes,
             :CurObject.RT[i].ExpirationDate = R.ExpirationDate,
             :CurObject.RT[i].WarningDate = R.WarningDate                
      FROM   FMS_Regtag R,
             UDB_Object O      
      WHERE  R.Feeder = :MainFeeder AND
             R.Feeder = O.Object
      ORDER BY TagSentDate 
      BEGIN
         i = i + 1;
      END;

   ELSEIF UPPERCASE(CurObject.DivisionName) = 'ALL' THEN
      CurObject.RT.Clear();
      i = 1;
      REPEATED
      SELECT :CurObject.RT[i].Division    = G.Grouping, 
             :CurObject.RT[i].Feeder    = O.Object, 
             :CurObject.RT[i].FeederName = O.Name, 
             :CurObject.RT[i].TagNumber = R.TagNumber, 
             :CurObject.RT[i].LocationStructure  = R.LocationStructure, 
             :CurObject.RT[i].TagSentDate = R.TagSentDate, 
             :CurObject.RT[i].LocationStreet = R.LocationStreet, 
             :CurObject.RT[i].TagSentBy  = R.TagSentBy,
             :CurObject.RT[i].Phases = R.Phases, 
             :CurObject.RT[i].BrassTag = R.BrassTag, 
             :CurObject.RT[i].PlasticTag = R.PlasticTag,
             :CurObject.RT[i].TagNotes = R.TagNotes,
             :CurObject.RT[i].ExpirationDate = R.ExpirationDate,
             :CurObject.RT[i].WarningDate = R.WarningDate                
      FROM  UDB_Object O, 
            UDB_Grouping G,      
            FMS_Regtag R    
      WHERE  O.Type = :Type$Feeder AND
             O.Name NOT LIKE '*OBSOLETE' AND
             O.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND
             O.Object = R.Feeder
      ORDER BY Division, FeederName, TagSentDate 
      BEGIN
         i = i + 1;
      END;   
   ELSE
      DynamicWhereClause = 'G.Grouping IN (';
      i = 1;
      WHILE LENGTH(CurObject.DivisionName) > 0 DO
         IF i > 1 THEN
            DynamicWhereClause = DynamicWhereClause + ',';
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + LEFT(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1));   
         CurObject.DivisionName = SHIFT(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         i = i + 1;
      ENDWHILE;
      DynamicWhereClause = DynamicWhereClause + ') AND '; 
      DynamicWhereClause = DynamicWhereClause + ' G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
             'G.MemberType = ' + VARCHAR(Type$Feeder) + ' AND ' +
             'G.Member = O.Object AND ' +
             'O.Object = R.Feeder ';

      CurObject.RT.Clear();
      i = 1;
      REPEATED
      SELECT :CurObject.RT[i].Division    = G.Grouping, 
             :CurObject.RT[i].Feeder    = O.Object, 
             :CurObject.RT[i].FeederName = O.Name, 
             :CurObject.RT[i].TagNumber = R.TagNumber, 
             :CurObject.RT[i].LocationStructure  = R.LocationStructure, 
             :CurObject.RT[i].TagSentDate = R.TagSentDate, 
             :CurObject.RT[i].LocationStreet = R.LocationStreet, 
             :CurObject.RT[i].TagSentBy  = R.TagSentBy,
             :CurObject.RT[i].Phases = R.Phases, 
             :CurObject.RT[i].BrassTag = R.BrassTag, 
             :CurObject.RT[i].PlasticTag = R.PlasticTag,
             :CurObject.RT[i].TagNotes = R.TagNotes,
             :CurObject.RT[i].ExpirationDate = R.ExpirationDate,
             :CurObject.RT[i].WarningDate = R.WarningDate                
      FROM  UDB_Grouping G,
            UDB_Object O,    
            FMS_Regtag R    
      WHERE  :DynamicWhereClause
      ORDER BY Division, FeederName, TagSentDate 
      BEGIN
         i = i + 1;
      END;   
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

Application Component Report
============================

	Name:            RejectFGO

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          RejectPermit
**
**  02/14/05  em    Created using AcknowledgeRFP as a base.
**  10/21/05  em    FMS 260: Outgoing Message change
**  04/20/07  ysp   ITC 210: Insert IR interface event in DB event queue
**  03/25/11  em    Updated for 3G
*/

INITIALIZE
(
/* passed in */
    Card = INTEGER NOT NULL;   			/* passed in card */
    ControlMsg = INTEGER NOT NULL;              /* Passed in FGO Message ID */

/* local variables */
#   include StandardDeclarations

    j = integer;			/* Temporary counter */

    AckMsg = VARCHAR(400) NOT NULL WITH DEFAULT;  
    CardClassName = VARCHAR(40) NOT NULL WITH DEFAULT;  
    EventText = VARCHAR(120) NOT NULL WITH DEFAULT;
    Feeder = INTEGER NOT NULL;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;  
    MsgKey = INTEGER NOT NULL WITH DEFAULT;  
) =
BEGIN
    DistrictOperator = DOp.Description;
/*
** Need Feeder for messages
*/
    SELECT :Feeder = CTO.Object,
           :FeederName = CTO.Name,
           :CardClassName = C.CardClassName
    FROM   FMS_Card C,
           TFMS_CardToObject CTO
    WHERE  C.Card = :Card AND
           C.Card = CTO.Card AND
           CTO.Type = :Type$Feeder;
END;


ON ENTRY DistrictOperator =
BEGIN
    RetCode = CALLFRAME DOLogIn (NoLogOut = TRUE);
    IF RetCode = 0 THEN
        RESUME;
    ELSE
        IF DOp.Description = '' THEN
           MESSAGE 'Please select a DO.';
           RESUME;
        ELSE 
           DistrictOperator = DOp.Description;
        ENDIF;
    ENDIF;                 
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN
/*
** A reason is required. 
*/
   IF DOComment = '' THEN
      MESSAGE 'You must enter a reason.';
      RESUME;
   ENDIF;

   IF DistrictOperator = '' THEN
      Message 'You have not selected your name.';
      RESUME;
   ENDIF;

   AckMsg = 'Returned FGO for ' + FeederName + ' Rejected by DO. ' +
            HC_NEWLINE +
            'This message will remain in the outgoing messages ' +
            'until the FCR has acknowledged the rejection.' + HC_NEWLINE +
            'The reason submitted by ' + DistrictOperator + ' is: ' +
            HC_NEWLINE + DOComment;

   MsgKey = 0;
/*
** Insert message for tracking purposes.
*/
   MsgKey = CALLPROC MSG_SendMsg (Card = Card,
                                  Action = 0,
                                  OrderNumber = ControlMsg,
                                  Substation = Feeder,
                                  SubstationName = FeederName,
                                  Msg = AckMsg,
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FCR',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
   IF MsgKey < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Not able to create an outgoing message.  ' +
              'Please try again.  If you continue to have problems, contact ' +
              'technical support.';
      RESUME;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Save Rejection Information
*/
   RetCode = CALLPROC IR_FGORejectionIns (
                         FGO = ControlMsg,
                         Card = Card,
                         RejectTime = Date('now'),
                         RejectDO = DistrictOperator,
                         RejectReason = DOComment,
                         RejectMsgKey = MsgKey);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Error Rejecting FGO.  Try again or contact tech support.';
      RESUME;
   ENDIF; 
	  
   CALLPROC SOA_LogIns (
         Card = Card,
         Job = null,
         SwitchingItem = 0,
         Time = 'now',
         UserName = UserName,
         Item = 'FGO Rejected',
	 Old = DistrictOperator + ' rejected returned FGO (' + VARCHAR(ControlMsg) + ')',
         New = DOComment);

/*
** Send rejection back to FCR.
*/
   EventText = VARCHAR(Card) + ';' + 
               VARCHAR(ControlMsg) + ';REJECT;' + 
               VARCHAR(DATE('now')) + ';' + 
               DistrictOperator + ';';
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_AcknowledgeFGO', 
                     EventText = EventText);  
   RETURN (PU_OK);
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =

    BEGIN
	    RETURN (PU_CANCEL);
    END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;


Application Component Report
============================

	Name:            RejectPermit

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          RejectPermit
**
**  02/14/05  em    Created using AcknowledgeRFP as a base.
**  10/21/05  em    FMS 260: Outgoing Message change
**  04/16/07  ysp   ITC210: Insert IR interface event in DB event queue
**  03/25/11  em    Updated for 3G
*/

INITIALIZE
(
/* passed in */
    Card = INTEGER NOT NULL;   			/* passed in card */
    WorkPermit = INTEGER NOT NULL;              /* Passed in Permit Job ID */

/* local variables */
#   include StandardDeclarations

    j = integer;			/* Temporary counter */

    AckMsg = VARCHAR(400) NOT NULL WITH DEFAULT;  
    CardClassName = VARCHAR(40) NOT NULL WITH DEFAULT;  
    DccMsg = VARCHAR(500) NOT NULL; 
    DccRegion = VARCHAR(20) NOT NULL;
    Feeder = INTEGER NOT NULL;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;  
    MsgKey = INTEGER NOT NULL WITH DEFAULT;  
    PermitText = VARCHAR(80) NOT NULL WITH DEFAULT;
) =
BEGIN
    DistrictOperator = DOp.Description;
/*
** Need Feeder for messages
*/
    SELECT :Feeder = CTO.Object,
           :FeederName = CTO.Name,
           :CardClassName = C.CardClassName
    FROM   FMS_Card C,
           TFMS_CardToObject CTO
    WHERE  C.Card = :Card AND
           C.Card = CTO.Card AND
           CTO.Type = :Type$Feeder;
END;


ON ENTRY DistrictOperator =
BEGIN
    RetCode = CALLFRAME DOLogIn (NoLogOut = TRUE);
    IF RetCode = 0 THEN
        RESUME;
    ELSE
        IF DOp.Description = '' THEN
           MESSAGE 'Please select a DO.';
           RESUME;
        ELSE 
           DistrictOperator = DOp.Description;
        ENDIF;
    ENDIF;                 
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN
/*
** A reason is required. 
*/
   IF DOComment = '' THEN
      MESSAGE 'You must enter a reason.';
      RESUME;
   ENDIF;

   IF DistrictOperator = '' THEN
      Message 'You have not selected your name.';
      RESUME;
   ENDIF;

   SELECT  :PermitText = TOMove
   FROM    SOA_Job
   WHERE   Job = :WorkPermit;

   AckMsg =    'Returned FCR Permit Rejected by DO. ' +
               'Permit: ' + PermitText + HC_NEWLINE +
               'This message will remain in the outgoing messages ' +
               'until the FCR has acknowledged the rejection.' + HC_NEWLINE +
               'The reason submitted by ' + DistrictOperator + ' is: ' +
               HC_NEWLINE + DOComment;

   MsgKey = 0;
/*
**  See if any previous messages have not been acknowledged.
**  If so, we will remove the outgoing message.
*/
   i = 0;
   SELECT :i = M.MsgKey
   FROM    IR_WorkPermit R,
           Msg_Message M
   WHERE   R.WorkPermit = :WorkPermit AND
           R.MsgKey = M.MsgKey AND
           M.DelByOpName = '';
   CALLPROC DDB_ROLLBACK;
      
   IF i <> 0 THEN  /* delete message */
      RetCode = CALLPROC Msg_UpdateMsg (Card = Card,
                        Ack = Ack$Delete,
                        MsgKey = i,
                        AckByOpName = 'FCRInterface',
                        AckDate = date('now'),
                        DelByOpName = 'FCRInterface',
                        DelDate = date('now'),
                        Substation = Feeder);
/*
** Log in trace window if this failed.  Not that big of deal.
** D.O. will just have to do it manually.
*/
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace (Text = VARCHAR(date('now')) +
                    ': Error - System was not able to ' +
                    'automatically delete previous outgoing ' + 
                    'message related to Permit ' + VARCHAR(WorkPermit));
      ENDIF; 
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Insert message for tracking purposes.
*/
   MsgKey = CALLPROC MSG_SendMsg (Card = Card,
                                  Action = 0,
                                  OrderNumber = WorkPermit,
                                  Substation = Feeder,
                                  SubstationName = FeederName,
                                  Msg = AckMsg,
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FCR',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
   IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Not able to create an outgoing message.  ' +
                 'Please try again.  If you continue to have problems, contact ' +
                 'technical support.';
         RESUME;
   ELSE
         CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Save Rejection Information
*/
   RetCode = CALLPROC IR_RejectPermit (
                   WorkPermit = WorkPermit,
                   PermitStatus = Permit$ReturnRejected,
                   MsgKey = MsgKey,
                   ReturnRejectTime = 'now',
                   ReturnRejectReason = DOComment,
                   ReturnRejectDO = DistrictOperator);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error Rejecting Permit.  Try again or ' +
                  'contact tech support.';
          RESUME;
   ENDIF; 
	 
   RetCode = CALLPROC IR_CompletePermit (
                        Job = WorkPermit,
                        RSComplete = NULL,
                        RSOperator = 0,
                        Response = '');
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
/*
** Send rejection to FCR.
*/
      ControlText = VARCHAR(WorkPermit);
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_RejectPermit', 
                     EventText = ControlText);  
   ELSE
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error clearing permit completion time on rejection.  Try again or ' +
                  'contact tech support.';
          RESUME;
   ENDIF; 
 
   CALLPROC SOA_LogIns (
         Card = Card,
         Job = WorkPermit,
         SwitchingItem = 0,
         Time = 'now',
         UserName = UserName,
         Item = 'Permit Rejected',
	 Old = DistrictOperator + ' rejected returned Permit',
         New = DOComment);
/*
** Now handle Delays and Notification
** Clear Pending FOD Ack
*/
   RetCode = CALLPROC FMS_OperatingStepUpd (
         Card = Card,
         OperatingStep = Type$DOAckDelay,
         EndTime = 'NOW');
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove Pending DO Ack Delay from feeder. ' +
                 'Please remove manually.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Check for outstanding NOPAPER delay, insert if one does not exist and
** link to work Permit
*/
   i = 0;
   SELECT :i = OperatingStep
   FROM   FMS_OperatingStepStatus
   WHERE  Card = :Card AND
          OperatingStep = :Delay$NoPaper AND
          EndTime = '';

   IF i = 0 THEN  
      RetCode = CALLPROC FMS_OperatingStepIns
             (Card = Card,
              CardClassName = CardClassName,
              Feeder = Feeder,
              FeederName = FeederName,
              OperatingStep = :Delay$NoPaper,
              StartTime = 'NOW'); 

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to add NoPaper Delay to feeder. ' +
                 'Please add manually.';
      ENDIF; 

      RetCode = CALLPROC FMS_JobDelayLinkIns
                               (Job  = WorkPermit,
                                Card = Card,
                                OperatingStep = Delay$NoPaper);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         message 'Unable to link NoPaper Delay to rejected FCR permit.  Please try manually.';
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;  

   CALLPROC SOA_LogIns (
         Card = Card,
         Job = WorkPermit,
         SwitchingItem = 0,
         Time = 'now',
         UserName = UserName,
         Item = 'Delay Added',
	 Old = 'NOPAPER delay for rejected permit',
         New = 'by ' + DistrictOperator);
   CALLPROC DDB_COMMIT;
/*
** Notification
*/
   DccRegion = '';
         /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
                :DccRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :Feeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      DccMsg = 'Permit Completion Papers for feeder ' +
               FeederName + ' have been rejected.';
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                            ,MessageText = DccMsg
                                            ,Time = date('now')
                                            ,Priority = 0
                                            ,MessageType = 0
                                            ,Card = Card);
      IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = '',
                                    TraceMessage =
                    'Automated DCC message ' + 
                    'not sent for ' + FeederName + ' regarding: ' + 
                    DccMsg);
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;
      
   RETURN (PU_OK);
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =

    BEGIN
	    RETURN (PU_CANCEL);
    END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;


Application Component Report
============================

	Name:            Relay_ASE


���p�eQ��Component Method Scripts
���p�eQ��--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    FMS_BusinessLogic
**  Class:          Relay_ASE
**
**  Date:       Version Description
** ----------------------------------
**  08/15/03    pkw     Created
**  08/07/08    em      Modifications for FMS_Online Access
**  08/12/08    ysp     Remove card type from relay select statement.
**                      Switching Item may be NULL or 0 when selecting
**                      for non-SLC card (FMS Online), so we split SELECT
**                      based on card type.  SLC inserts relays to other cards
**                      with NULL SwItem field.
**  12/28/11    pkw     Add Substation column for TFMS and updatemode flag.
**  09/08/19    pkw     Use operated instead of generic1 for table 2
*/ 
METHOD LoadRelaySummary (
)=
DECLARE
   CurRelayClass = CAC_RelayClass;
   CurRelayEquip = CAC_Relay;  
   FeederRelayEquip = ARRAY OF CAC_Relay;  
   i 		    = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j 		    = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   x 		    = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RowNum = INTEGER NOT NULL WITH DEFAULT;    /* Row Number */ 
   LastRow          = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
ENDDECLARE
BEGIN
/*
**  LoadRelaySummary Method load relays for SLC relay card.  This code is duplicated
**  from SOA!dis_relaysummary and any changes made here should also be made there too.
*/  
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Select all of the existing relays for this card
*/
   i = 1;
   CurObject.ROpList.Clear();
   IF CurObject.ArchiveCard = FALSE THEN
     IF CurObject.CardType <> Type$SLCApp THEN
      REPEATED
      SELECT  CurObject.ROpList[i].RelayOp = R.RelayOp,
              CurObject.ROpList[i].Trip = R.Trip,
              CurObject.ROpList[i].Line = R.Line,
              CurObject.ROpList[i].FeederName = R.FeederName,
              CurObject.ROpList[i].SubstationName = OO.Description,
              CurObject.ROpList[i].Equip = R.Equip,
              CurObject.ROpList[i].EquipName = R.EquipName,
              CurObject.ROpList[i].EquipClass = R.EquipClass,
              CurObject.ROpList[i].EquipClassName = R.EquipClassName,
              CurObject.ROpList[i].RelayType = R.RelayType,
              CurObject.ROpList[i].RelayTypeName = R.RelayTypeName,
              CurObject.ROpList[i].RelayClass = R.RelayClass,
              CurObject.ROpList[i].RelayClassName = R.RelayClassName,
              CurObject.ROpList[i].RelayName = R.RelayName,
              CurObject.ROpList[i].Operation = R.Operation,
              CurObject.ROpList[i].TimeStamp = R.TimeStamp,
              CurObject.ROpList[i].OutOfService = R.OutOfService,
              CurObject.ROpList[i].Compromised = R.Compromised,
              CurObject.ROpList[i].Status = ''
      FROM    CAC_RelayOps R,
              CAC_RelayOpsControl RC,
              Udb_Object O,
              Udb_Object OO
      WHERE   RC.Card = :CurObject.Card
        AND   R.RelayOp = RC.RelayOp
        AND   R.Equip = O.Object 
        AND   O.PrimaryGrouping = OO.Object
      ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
      BEGIN
         i = i + 1;
      END; 

     ELSE

      REPEATED
      SELECT  CurObject.ROpList[i].RelayOp = R.RelayOp,
              CurObject.ROpList[i].Trip = R.Trip,
              CurObject.ROpList[i].Line = R.Line,
              CurObject.ROpList[i].FeederName = R.FeederName,
              CurObject.ROpList[i].Equip = R.Equip,
              CurObject.ROpList[i].EquipName = R.EquipName,
              CurObject.ROpList[i].EquipClass = R.EquipClass,
              CurObject.ROpList[i].EquipClassName = R.EquipClassName,
              CurObject.ROpList[i].RelayType = R.RelayType,
              CurObject.ROpList[i].RelayTypeName = R.RelayTypeName,
              CurObject.ROpList[i].RelayClass = R.RelayClass,
              CurObject.ROpList[i].RelayClassName = R.RelayClassName,
              CurObject.ROpList[i].RelayName = R.RelayName,
              CurObject.ROpList[i].Operation = R.Operation,
              CurObject.ROpList[i].TimeStamp = R.TimeStamp,
              CurObject.ROpList[i].OutOfService = R.OutOfService,
              CurObject.ROpList[i].Compromised = R.Compromised,
              CurObject.ROpList[i].Status = ''
      FROM    CAC_RelayOps R,
              CAC_RelayOpsControl RC
      WHERE   RC.Card = :CurObject.Card
        AND   RC.SwitchingItem = :CurObject.SwitchingItem
        AND   R.RelayOp = RC.RelayOp
      ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
      BEGIN
         i = i + 1;
      END; 
     ENDIF;
   ELSE
     IF CurObject.CardType <> Type$SLCApp THEN
      REPEATED
      SELECT  CurObject.ROpList[i].RelayOp = R.RelayOp,
              CurObject.ROpList[i].Trip = R.Trip,
              CurObject.ROpList[i].Line = R.Line,
              CurObject.ROpList[i].FeederName = R.FeederName,
              CurObject.ROpList[i].SubstationName = OO.Description,
              CurObject.ROpList[i].Equip = R.Equip,
              CurObject.ROpList[i].EquipName = R.EquipName,
              CurObject.ROpList[i].EquipClass = R.EquipClass,
              CurObject.ROpList[i].EquipClassName = R.EquipClassName,
              CurObject.ROpList[i].RelayType = R.RelayType,
              CurObject.ROpList[i].RelayTypeName = R.RelayTypeName,
              CurObject.ROpList[i].RelayClass = R.RelayClass,
              CurObject.ROpList[i].RelayClassName = R.RelayClassName,
              CurObject.ROpList[i].RelayName = R.RelayName,
              CurObject.ROpList[i].Operation = R.Operation,
              CurObject.ROpList[i].TimeStamp = R.TimeStamp,
              CurObject.ROpList[i].OutOfService = R.OutOfService,
              CurObject.ROpList[i].Compromised = R.Compromised,
              CurObject.ROpList[i].Status = ''
      FROM    CAC_ArchiveRelayOps R,
              CAC_ArchiveROControl RC,
              Udb_Object O,
              Udb_Object OO
      WHERE   RC.Card = :CurObject.Card
        AND   R.RelayOp = RC.RelayOp
        AND   R.Equip = O.Object 
        AND   O.PrimaryGrouping = OO.Object
      ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
      BEGIN
         i = i + 1;
      END; 

     ELSE

      REPEATED
      SELECT  CurObject.ROpList[i].RelayOp = R.RelayOp,
              CurObject.ROpList[i].Trip = R.Trip,
              CurObject.ROpList[i].Line = R.Line,
              CurObject.ROpList[i].FeederName = R.FeederName,
              CurObject.ROpList[i].Equip = R.Equip,
              CurObject.ROpList[i].EquipName = R.EquipName,
              CurObject.ROpList[i].EquipClass = R.EquipClass,
              CurObject.ROpList[i].EquipClassName = R.EquipClassName,
              CurObject.ROpList[i].RelayType = R.RelayType,
              CurObject.ROpList[i].RelayTypeName = R.RelayTypeName,
              CurObject.ROpList[i].RelayClass = R.RelayClass,
              CurObject.ROpList[i].RelayClassName = R.RelayClassName,
              CurObject.ROpList[i].RelayName = R.RelayName,
              CurObject.ROpList[i].Operation = R.Operation,
              CurObject.ROpList[i].TimeStamp = R.TimeStamp,
              CurObject.ROpList[i].OutOfService = R.OutOfService,
              CurObject.ROpList[i].Compromised = R.Compromised,
              CurObject.ROpList[i].Status = ''
      FROM    CAC_ArchiveRelayOps R,
              CAC_ArchiveROControl RC
      WHERE   RC.Card = :CurObject.Card
        AND   RC.SwitchingItem = :CurObject.SwitchingItem
        AND   R.RelayOp = RC.RelayOp
      ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
      BEGIN
         i = i + 1;
      END; 
     ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   FeederRelayEquip.Clear();
   IF CurObject.ArchiveCard = FALSE THEN
      REPEATED
      SELECT DISTINCT
            :FeederRelayEquip[i].RelayOp = -1,
            :FeederRelayEquip[i].Line = -1,
            :FeederRelayEquip[i].FeederName = F.Name,
            :FeederRelayEquip[i].Equip = J.Equip,
            :FeederRelayEquip[i].EquipName = J.EquipName,
            :FeederRelayEquip[i].EquipClass = J.EquipClass,
            :FeederRelayEquip[i].EquipClassName = J.EquipClassName,
            :FeederRelayEquip[i].RelayClass = S.RelayType,
            :FeederRelayEquip[i].GenericInt1 = :FALSE,
            :FeederRelayEquip[i].GenericInt2 = :FALSE
      FROM   Udb_Object F,
             Udb_Grouping G,
             Udb_Switch S,
             SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :CurObject.Card AND   /*08/07/08 why was this not here?*/
             JC.SwitchingItem = :CurObject.SwitchingItem AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('',:JobStatus$NIS) AND
             J.EquipClass IN (SELECT EquipClass
                              FROM FMS_OpenAutoEquip)  AND
             J.Equip = G.Member AND
             G.RelationShip = :Interaction$MemberOf AND
             G.Grouping = F.Object AND
             F.Type IN (SELECT Type FROM Udb_ExtendedType WHERE SuperType = :Type$Feeder) AND
             J.Equip = S.Object
      ORDER BY RelayClass
      BEGIN
         i = i + 1; 
      END;
   ELSEIF CurObject.CardType = Type$FMSApp THEN
      REPEATED
      SELECT DISTINCT
            :FeederRelayEquip[i].RelayOp = -1,
            :FeederRelayEquip[i].Line = -1,
            :FeederRelayEquip[i].FeederName = F.Name,
            :FeederRelayEquip[i].Equip = J.Equip,
            :FeederRelayEquip[i].EquipName = J.EquipName,
            :FeederRelayEquip[i].EquipClass = J.EquipClass,
            :FeederRelayEquip[i].EquipClassName = J.EquipClassName,
            :FeederRelayEquip[i].RelayClass = S.RelayType,
            :FeederRelayEquip[i].GenericInt1 = :FALSE,
            :FeederRelayEquip[i].GenericInt2 = :FALSE
      FROM   Udb_Object F,
             Udb_Grouping G,
             Udb_Switch S,
             FMS_ArchiveJob J
      WHERE  J.Card = :CurObject.Card AND   /*08/07/08 why was this not here?*/
             J.Status = '' AND
             J.EquipClass IN (SELECT EquipClass
                              FROM FMS_OpenAutoEquip)  AND
             J.Equip = G.Member AND
             G.RelationShip = :Interaction$MemberOf AND
             G.Grouping = F.Object AND
             F.Type IN (SELECT Type FROM Udb_ExtendedType WHERE SuperType = :Type$Feeder) AND
             J.Equip = S.Object
      ORDER BY RelayClass
      BEGIN
         i = i + 1; 
      END;
   ELSE
      REPEATED
      SELECT DISTINCT
            :FeederRelayEquip[i].RelayOp = -1,
            :FeederRelayEquip[i].Line = -1,
            :FeederRelayEquip[i].FeederName = F.Name,
            :FeederRelayEquip[i].Equip = J.Equip,
            :FeederRelayEquip[i].EquipName = J.EquipName,
            :FeederRelayEquip[i].EquipClass = J.EquipClass,
            :FeederRelayEquip[i].EquipClassName = J.EquipClassName,
            :FeederRelayEquip[i].RelayClass = S.RelayType,
            :FeederRelayEquip[i].GenericInt1 = :FALSE,
            :FeederRelayEquip[i].GenericInt2 = :FALSE
      FROM   Udb_Object F,
             Udb_Grouping G,
             Udb_Switch S,
             SOA_ArchiveJob J
      WHERE  J.Card = :CurObject.Card AND   /*08/07/08 why was this not here?*/
             J.SwitchingItem = :CurObject.SwitchingItem AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.EquipClass IN (SELECT EquipClass
                              FROM FMS_OpenAutoEquip)  AND
             J.Equip = G.Member AND
             G.RelationShip = :Interaction$MemberOf AND
             G.Grouping = F.Object AND
             F.Type IN (SELECT Type FROM Udb_ExtendedType WHERE SuperType = :Type$Feeder) AND
             J.Equip = S.Object
      ORDER BY RelayClass
      BEGIN
         i = i + 1; 
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

/*
**  Select the relay classes
*/ 
   i = 1; 
   CurObject.RClasses.CLear();
   SELECT  :CurObject.RClasses[i].RelayClass = T.Type,
           :CurObject.RClasses[i].RelayClassName = T.Name,
           :CurObject.RClasses[i].ParentRelayInt = S.SuperType
   FROM    Udb_Type T,
           Udb_SuperType S 
   WHERE   T.Type IN (SELECT Type 
                      FROM Udb_ExtendedType
                      WHERE SuperType = :Type$Relay) AND
           S.Type = T.Type           
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
**  Select the relay types
*/
   i = 1;
   CurObject.RTypes.Clear();
   REPEATED
   SELECT  :CurObject.RTypes[i].Type = Type,
           :CurObject.RTypes[i].RelayType = RelayType,
           :CurObject.RTypes[i].RelayTypeName = RelayTypeName
   FROM    CAC_RelayTypes
   ORDER BY 3
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;


/*
**  Build the relay class tree
*/
   IF CurObject.RTypes.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Cannot find relay types please resolve in the dbm.';
      RETURN;
   ENDIF;

   IF CurObject.RClasses.LastRow() =  0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Cannot find relay classes please resolve in the dbm.';
      RETURN;  
   ENDIF;

/*
**  First Pass,
**  Assign the Pointer to the Parent Relay
*/
   i = 1;
   WHILE i <= CurObject.RClasses.LastRow() DO
      j = 1;
      WHILE j <= CurObject.RClasses.LastRow() DO
         IF CurObject.RClasses[i].ParentRelayInt = CurObject.RClasses[j].RelayClass THEN 
            CurObject.RClasses[i].ParentRelayClass = CurObject.RClasses[j];
            ENDLOOP;
         ENDIF;
         j = j + 1;
      ENDWHILE;
      i = i + 1;   
   ENDWHILE;  
/**
 **  Insert the relay types into the class hierarchy.
 **/
    i = 1;

    WHILE i <= CurObject.RClasses.LastRow() DO

        j = 1;

        WHILE j <= CurObject.RTypes.LastRow() DO
            IF CurObject.RClasses[i].RelayClass = CurObject.RTypes[j].Type THEN
                CurObject.RClasses[i].RelayList.InsertRow( RowNumber = CurObject.RClasses[i].RelayList.LastRow() + 1,
                                                     RowObject = CurObject.RTypes[j] );
            ENDIF;
            j = j + 1;
        ENDWHILE;
        i = i + 1;
    ENDWHILE;

/*
**  link currently open-auto equip to its relays. This give us all the
**  possible relays that may operate to trip a piece of equipment. With
**  this list, operators can simply select the relays that operated to
**  record open-auto events.  We sort out these relays into 
**  table 1 and table 2.
*/
   i = 1;
   WHILE i <= FeederRelayEquip.LastRow() DO
      j = 1;
      WHILE j <= CurObject.RClasses.LastRow() DO
         IF FeederRelayEquip[i].RelayClass = CurObject.RClasses[j].RelayClass THEN

            /* loop through the relay CLASS hierarchy, create an 
            ** equip-relay (4gl class CAC_Relay) entry for each relay
            ** type and put it in either table 1 or table 2
            */
            CurRelayClass = CurObject.RClasses[j].Duplicate();

            WHILE ( CurRelayClass.ParentRelayClass IS NOT NULL OR
                    CurRelayClass.RelayClass != Type$Relay ) DO       

               CurRelayEquip = FeederRelayEquip[i].Duplicate();
               CurRelayEquip.RelayClassName = CurRelayClass.RelayClassName;
                
               /* loop through all relay types for a relay class */
               x = 1;
               WHILE x <= CurRelayClass.RelayList.LastRow() DO
                  CurRelayEquip.RelayType = CurRelayClass.RelayList[x].RelayType;
                  CurRelayEquip.RelayTypeName = CurRelayClass.RelayList[x].RelayTypeName;
                       
                  IF CurRelayClass.RelayClass = RelayType$Normal THEN
                     CurObject.RSDist.InsertRow( 
                                          RowNumber = (CurObject.RSDist.LastRow() + 1),
                                          RowObject = CurRelayEquip.Duplicate());
                  ELSE
                     CurObject.RSOtherDist.InsertRow( 
                                          RowNumber = (CurObject.RSOtherDist.LastRow() + 1),
                                          RowObject = CurRelayEquip.Duplicate());
                  ENDIF;
                  
                  x = x + 1;
               ENDWHILE;
               CurRelayClass = CurRelayClass.ParentRelayClass.Duplicate();
            ENDWHILE;        
         ENDIF;
         j = j + 1;
      ENDWHILE;
      i = i + 1;
   ENDWHILE;
   FOR i = 1 TO CurObject.ROpList.LastRow DO
      IF CurObject.ROpList[i].Operation = RelayOp$Time THEN
         CurObject.ROpList[i].GenericInt2 = TRUE;
      ELSEIF CurObject.ROpList[i].Operation = RelayOp$Instantaneous THEN
         CurObject.ROpList[i].GenericInt1 = TRUE;
      ELSEIF CurObject.ROpList[i].Operation = RelayOp$Instantaneous + RelayOp$Time THEN
         CurObject.ROpList[i].GenericInt1 = TRUE;
         CurObject.ROpList[i].GenericInt2 = TRUE;
      ELSEIF CurObject.ROpList[i].Operation = RelayOp$Normal THEN
         CurObject.ROpList[i].Operated = TRUE;
      ENDIF;
   ENDFOR;
/* 
** Loop through table CurObject.RSDist and CurObject.RSOtherDist:
** update each relay if it operated by searching table RelayOpList.
** (Certainly, this can be easily done by using SQL SELECT, but it will
** take much more time). Field  RelayOpList.GenericInt1 will be used to
** point to these three tables.
**/
   i = 1;
   WHILE i <= CurObject.RSDist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.ROpList.LastRow() DO
         /* if it is not OTHER relay and has not yet updated somewhere */
         IF (CurObject.ROpList[j].Line = -1 AND CurObject.ROpList[j].Status = '') THEN
            IF (CurObject.ROpList[j].FeederName = CurObject.RSDist[i].FeederName  AND
               CurObject.ROpList[j].Equip = CurObject.RSDist[i].Equip AND
               CurObject.ROpList[j].RelayType = CurObject.RSDist[i].RelayType) THEN

               CurObject.RSDist[i].RelayOp = CurObject.ROpList[j].RelayOp;
               CurObject.RSDist[i].TimeStamp = CurObject.ROpList[j].TimeStamp;
               CurObject.RSDist[i].Operation = CurObject.ROpList[j].Operation;
               CurObject.RSDist[i].Operated = CurObject.ROpList[j].Operated;
               CurObject.RSDist[i].GenericInt1 = CurObject.ROpList[j].GenericInt1;
               CurObject.RSDist[i].GenericInt2 = CurObject.ROpList[j].GenericInt2;
               
               CurObject.ROpList[j].RelayTypeTable = 1;
               CurObject.ROpList[j].Status = 'Upd';   /* already updated in one table */
            ENDIF;   
         ENDIF;

         j = j + 1;    
      ENDWHILE;

      i = i + 1;
   ENDWHILE;

   i = 1;
   WHILE i <= CurObject.RSOtherDist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.ROpList.LastRow() DO
         /* if it is not OTHER relay and has not yet updated somewhere */
         IF (CurObject.ROpList[j].Line = -1 AND CurObject.ROpList[j].Status = '') THEN

            IF (CurObject.ROpList[j].FeederName = CurObject.RSOtherDist[i].FeederName AND
                CurObject.ROpList[j].Equip = CurObject.RSOtherDist[i].Equip AND
                CurObject.ROpList[j].RelayType = CurObject.RSOtherDist[i].RelayType ) THEN

               CurObject.RSOtherDist[i].RelayOp = CurObject.ROpList[j].RelayOp;
               CurObject.RSOtherDist[i].TimeStamp = CurObject.ROpList[j].TimeStamp;
               CurObject.RSOtherDist[i].Operation = CurObject.ROpList[j].Operation;
               CurObject.RSOtherDist[i].Operated = CurObject.ROpList[j].Operated;
               CurObject.RSOtherDist[i].GenericInt1 = CurObject.ROpList[j].GenericInt1;
               CurObject.RSOtherDist[i].GenericInt2 = CurObject.ROpList[j].GenericInt2;

               CurObject.ROpList[j].RelayTypeTable = 2;
               CurObject.ROpList[j].Status = 'Upd';   /* already updated in one table */
            ENDIF;
         ENDIF;
         j = j + 1;    
      ENDWHILE;
      i = i + 1;
   ENDWHILE;

   j = 1;
   WHILE j <= CurObject.ROpList.LastRow() DO
      /* not yet updated anywhere */
      IF CurObject.ROpList[j].Status = '' THEN
         RowNum = CurObject.RSOther.LastRow() + 1;
         CurObject.RSOther.InsertRow(RowNumber = RowNum, 
                               RowObject = CurObject.ROpList[j].Duplicate());

         CurObject.RSOther[RowNum].RelayOp = CurObject.ROpList[j].RelayOp;
         CurObject.RSOther[RowNum].TimeStamp = CurObject.ROpList[j].TimeStamp;
         CurObject.RSOther[i].Operated = CurObject.ROpList[j].Operated;
         CurObject.RSOther[i].GenericInt1 = CurObject.ROpList[j].GenericInt1;
         CurObject.RSOther[i].GenericInt2 = CurObject.ROpList[j].GenericInt2;
         /*
         **  For FMS Online put relayclass into relaytype fields
         */
         CurObject.ROpList[j].RelayType = Curobject.ROpList[j].RelayClass;
         CurObject.ROpList[j].RelayTypeName = Curobject.ROpList[j].RelayClassName;
         
         CurObject.ROpList[j].RelayTypeTable = 3;
         CurObject.ROpList[j].Status = 'Upd';   /* already updated in one table */
      ENDIF;
      j = j + 1;
   ENDWHILE;
/*
**  UpdateMode is used for PDF printouts.  Should be set to 1 when called from 
**  OpenROAD.  Read mode logic is handled in the applications.
* /   
   IF CurObject.UpdateMode <> TRUE THEN
      i = CurObject.RSDist.LastRow;
      WHILE i > 0 DO
         IF CurObject.RSDist[i].GenericInt1 = FALSE AND
            CurObject.RSDist[i].GenericInt2 = FALSE THEN
             
            CurObject.RSDist.RemoveRow (RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
      
      i = CurObject.RSOtherDist.LastRow;
      WHILE i > 0 DO
         IF CurObject.RSOtherDist[i].GenericInt1 = FALSE AND
            CurObject.RSOtherDist[i].GenericInt2 = FALSE THEN
             
            CurObject.RSOtherDist.RemoveRow (RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;  
   ENDIF;
*/
   RETURN;
END;

