** ----------------------------------
**  06/12/08   ysp  Created;
**  12/14/16   ysp  Increase the length of Objective and RevisionComment to 1500 
*/
METHOD LoadRFPLocations (
)=
DECLARE
   j = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   j = 1;
   CurObject.Locations.Clear();
   SELECT :CurObject.Locations[j].RFP = RFP
         ,:CurObject.Locations[j].RFPLocation = RFPLocation
         ,:CurObject.Locations[j].LocationStructure = LocationStructure
         ,:CurObject.Locations[j].LocationStreet = LocationStreet
         ,:CurObject.Locations[j].RevisionStatus = RevisionStatus
         ,:CurObject.Locations[j].TagsRequested = TagsRequested
         ,:CurObject.Locations[j].Instructions = Instructions
   FROM   IR_RFPLocation
   WHERE  RFP = :CurObject.RFP AND
          RevisionNumber = :CurObject.RevisionNumber
   BEGIN 
      j = j + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

