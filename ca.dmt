**
**  Date:       Version Description
** ----------------------------------
**  04/22/02    pkw     Created; 
**  01/21/03    pkw     Add username info to confirm exit method.
**  10/20/05    em      Adjusted Incoming Message
**  02/07/07    pkw     Added ClearDisabledFlag method.
**  01/06/10    ysp     FMS 247: Delete the mirror message from Outgoing Message Monitor if 
**                      the notification message is sent from DO.
**  03/23/11    pkw     Look for changes needed for 3G.  Ok to insert -1 for feeder attribute
**                      when inserting Operating Step.
**  08/08/13    pkw     Complete issued moves when acknowledging messages.
**  11/26/14    pkw     Update lastupdate when logging in, change link insert procedure, etc...
**  12/02/14    pkw     update to lastupdate logic
**  02/17/17    ysp     Send an incoming when CSD acknowledges the notification message from DO
**  04/12/18    ysp     Fix the last update by checking the value of the Substation variable before
**                      inserting an incoming message.
**  05/25/18    pkw     Don't send ack message back to do if operator is monitor.
**  10/29/20    em      Increased message length to 2000 characters.
**  07/25/22    ysp     Move common codes to new method TrackUser
*/ 
METHOD AckMessage (
)=
DECLARE
   AckUserCheck = VARCHAR(20) NOT NULL;
   AckTimeCheck = DATE NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
   CurrentMethod = VARCHAR(20) NOT NULL;
   DeskType   = VARCHAR(20) NOT NULL WITH DEFAULT;
   Feeder     = INTEGER NOT NULL;
   FeederName = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   x          = INTEGER NOT NULL;
   k          = INTEGER NOT NULL;
   MsgKey     = INTEGER NOT NULL WITH DEFAULT;
   MsgType    = INTEGER NOT NULL WITH DEFAULT;
   MsgCard    = INTEGER NOT NULL WITH DEFAULT;
   MsgApp     = VARCHAR(4) NOT NULL WITH DEFAULT;
   MsgStation = INTEGER NOT NULL WITH DEFAULT;
   MsgMessage = VARCHAR(2000) NOT NULL WITH DEFAULT;
   OrigMessage = VARCHAR(2000) NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(80) NOT NULL WITH DEFAULT;
   TOIssuedCheck   = DATE;
   RSIssuedCheck   = DATE;
   TOCompleteCheck = DATE;
   RSCompleteCheck = DATE;
   RetCode    = INTEGER NOT NULL;
   Substation = INTEGER NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set acknowledge time for message.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'AckMessage';

#  include CSD_Validate
   
   FOR k = 1 TO CurObject.MList.LastRow() DO
/*
**  See if this message has been acknowledged by someone else
**  already.  This can happen if person A acks message 1 and then
**  person B acks message 1 before he gets his 30 second update.
*/
      MsgKey  = 0;
      MsgType = 0;
      AckUserCheck = '';
      REPEATED 
      SELECT  :AckUserCheck = L.AckOperator,
              :AckTimeCheck = L.AckTime,
              :MsgKey = M.MsgKey,
              :MsgType = M.MessageType,
              :MsgCard = M.Card,
              :MsgMessage = M.MessageText,
              :DeskType = M.DeskType
      FROM    CSD_MessageLink L,
              CSD_Message M
      WHERE   L.IPAddress = :CurObject.IPAddress AND
              L.MessageId = :CurObject.Mlist[k].MessageId AND
              L.MessageId = M.MessageId;
      CALLPROC DDB_ROLLBACK;
      /*
      **  Sometimes the same user selects the ack multiple times before the 
      **  screen is refreshed.  We will make sure this is not the case before
      **  updating the field.
      */
      IF AckUserCheck <> '' AND 
         AckUserCheck <> CurObject.UserName THEN
         CurObject.Mlist[k].AckOperator = AckUserCheck + ', ' + CurObject.UserName;
         CurObject.Mlist[k].AckTime = AckTimeCheck;
      ELSE
         CurObject.Mlist[k].AckOperator = CurObject.UserName;
         CurObject.Mlist[k].AckTime = date('now');
      ENDIF;
      /*
      **  
      */
      RetCode = CALLPROC CSD_MessageLinkUpd (
                  MessageId = CurObject.Mlist[k].MessageId,
                  IPAddress = CurObject.IPAddress,
                  AckTime = CurObject.Mlist[k].AckTime,
                  AckOperator = CurObject.Mlist[k].AckOperator
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': MessageId ' + varchar(CurObject.Mlist[k].MessageId) +
                       ' could not be acknowledged by ' + CurObject.UserName);
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Message was not acknowledged. ' +
            'Please try again.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;

      IF MsgType = 2 THEN
         /*
         **  This message was created from prompt by issuing job.
         **  Acknowledging message completes the job.  
         **  MsgCard is the card the move was issued on.
         **  MsgKey is the Job that was issued.
         */
         i = 0;
         SELECT :i = J.Job,
                :TOIssuedCheck = J.TOIssued,
                :TOCompleteCheck = J.TOComplete,
                :RSIssuedCheck = J.RSIssued,
                :RSCompleteCheck = J.RSComplete,
                :MsgStation = J.Substation,
                :MsgMessage = J.TOMove
         FROM    SOA_Job J
         WHERE   J.Job = :MsgKey;
         IF i <> 0 THEN
            MsgApp = 'FMS';  /* SOA_Job */
            SELECT :CardName = AC.CardName
            FROM    SOA_ActiveCard AC
            WHERE   AC.Card = MsgCard;
         ELSE
            SELECT :i = J.Job,
                   :TOIssuedCheck = J.TOIssued,
                   :TOCompleteCheck = J.TOComplete,
                   :RSIssuedCheck = J.RSIssued,
                   :RSCompleteCheck = J.RSComplete,
                   :MsgStation = J.Circuit,
                   :CardName = J.LineNumber,
                   :MsgMessage = J.TOMove
            FROM    TC_Job J
            WHERE   J.Job = :MsgKey;
            
            IF i <> 0 THEN
               MsgApp = 'TLS';  /* TC_Job */
            ENDIF;
         ENDIF;
         IF MsgApp = 'FMS' THEN  /* Compete SOA_Job */
            IF TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL THEN
               RetCode = CALLPROC SOA_CompleteMove(Job = MsgKey,
                                       Complete = date('now'),
                                       Status = Job$TakeOut
                                       );
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Takeout Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;
               
               RetCode = CALLPROC SOA_LogIns (
                    Card            = MsgCard
                  , Job             = MsgKey
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = CurObject.Mlist[k].AckOperator
                  , Item            = 'TOComplete'
                  , Old             = ''
                  , New             = IFNULL(DATE('now'),'')
                  );
               
            ELSEIF RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL THEN
               RetCode = CALLPROC SOA_CompleteMove(Job = MsgKey,
                                       Complete = date('now'),
                                       Status = Job$Restore
                                       );
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Restore Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;
               
               RetCode = CALLPROC SOA_LogIns (
                    Card            = MsgCard
                  , Job             = MsgKey
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = CurObject.Mlist[k].AckOperator
                  , Item            = 'RSComplete'
                  , Old             = ''
                  , New             = IFNULL(DATE('now'),'')
                  );
            ENDIF;
            
         ELSEIF MsgApp = 'TLS' THEN  /* Complete TC_Job */
            IF TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL THEN
               RetCode = CALLPROC TC_CompleteJob (
                    Job = MsgKey,
                    Operator = 0,
                    OperatorName = CurObject.Mlist[k].AckOperator,
                    Complete = date('now'),
                    TORS = 0);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Takeout Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;

               CALLPROC TC_LogChange (Card = MsgCard,
                    Job  = MsgKey,
                    Item = 'TOComplete',
                    Old  = '', 
                    New = IFNULL(DATE('now'),'')
                    );
               CALLPROC DDB_COMMIT;
            ELSEIF RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL THEN
               RetCode = CALLPROC TC_CompleteJob (
                    Job = MsgKey,
                    Operator = 0,
                    OperatorName = CurObject.Mlist[k].AckOperator,
                    Complete = date('now'),
                    TORS = 1);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Restore Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;

               CALLPROC TC_LogChange (Card = MsgCard,
                    Job  = MsgKey,
                    Item = 'RSComplete',
                    Old  = '', 
                    New = IFNULL(DATE('now'),'')
                    );
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
         /*
         **  Send message back to DO letting them know move was acknowledged.
         */
         IF (TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL) OR
            (RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL) THEN
            MsgMessage = 'MOVE ACKNOWLEDGED by ' + CurObject.Mlist[k].AckOperator + HC_NEWLINE + HC_NEWLINE +
                 CardName + ' had the following move completed due to acknowledge of Notification ' +
                'message ' + HC_NEWLINE + MsgMessage; 
            RetCode = CALLPROC MSG_SendMsg (
                  Card = MsgCard,
                  Action = 0,
                  OrderNumber = 0,
                  Substation = MsgStation,
                  SubstationName = 'Message', 
                  Msg = MsgMessage,
                  FromOpName = CurObject.Mlist[k].AckOperator,
                  SendDate = IFNULL(DATE('now'),''),
                  ToApp = MsgApp,
                  FromApp = 'NOTIFY',
                  Priority = 2
                  );
            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurObject.Mlist[k].AckOperator + 's acknowledgement ' +
                       'could not be relayed to the DO.');   
            ENDIF;
         ENDIF;
      ELSEIF MsgKey > 0 THEN
         /*
         ** if this message is sent by DO, remove the mirror message from the outgoing message monitor
         */
         Substation = 0;
         SELECT :Substation = Substation,
                :SubstationName  = SubstationName,
                :OrigMessage = Msg
         FROM   MSG_Message
         WHERE  MsgKey = :MsgKey;
         
         RetCode = CALLPROC MSG_UpdateMsg (Card = 0,
                                       MsgKey = MsgKey,
                                       Ack = Ack$Delete,
                                       AckByOpName = CurObject.Mlist[k].AckOperator,
                                       AckDate = CurObject.Mlist[k].AckTime,
                                       DelByOpName = CurObject.Mlist[k].AckOperator,
                                       DelDate = CurObject.Mlist[k].AckTime,
                                       Substation = Substation);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                   'Error deleting the outgoing message.');
         ELSE
            CALLPROC DDB_COMMIT; 
         ENDIF;

         /*
         ** notify DO of CSD acknowledging the message
         */
         IF UPPERCASE(DeskType) = 'CSD' THEN
            IF Substation = 0 THEN
               SELECT :Substation = Substation,
                      :SubstationName  = SubstationName,
                      :OrigMessage = Msg
               FROM   MSG_ArchiveMessage
               WHERE  MsgKey = :MsgKey;         
            ENDIF;
         
            IF Substation > 0 THEN
               IF lowercase(CurObject.Mlist[k].AckOperator) <> 'monitor' THEN
                  RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                     Action = 0,
                                     OrderNumber = 0,
                                     Substation = Substation,
                                     SubstationName = SubstationName,
                                     Msg = 'Substation Shift Manager ' + CurObject.Mlist[k].AckOperator + 
                                           ' acknowledged this message from DO: ' + HC_NEWLINE + OrigMessage,
                                     FromOpName = CurObject.Mlist[k].AckOperator,
                                     SendDate = IFNULL(DATE('now'),''),
                                     ToApp = 'FMS',
                                     FromApp = 'FMS Notification',
                                     Priority = 0
                                     );
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;
/*
**  Update all version numbers
*/
      CurObject.Dlist.Clear();
      i = 1;
      REPEATED
      SELECT  :CurObject.Dlist[i].IPAddress = L.IPAddress,
              :CurObject.Dlist[i].MessageID = L.MessageId
      FROM     CSD_MessageLink L
      WHERE    MessageId = :CurObject.Mlist[k].MessageId
      BEGIN
         i = i + 1;
      END; 

      FOR i = 1 TO CurObject.Dlist.LastRow() DO      
/*
**  Update CSD_Version Array
*/   
         FOR x = 1 TO CSD_Version.LastRow() DO
            IF CurObject.Dlist[i].IPAddress = CSD_Version[x].IPAddress THEN
               CSD_Version[x].Version = CSD_Version[x].Version + 1;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      ENDFOR; 
   ENDFOR; 
   /*
   **  Update lastupdate time for this ipaddress
   */
   IF lowercase(CurObject.UserName) <> 'monitor' AND
      CurObject.ByPassLastUpd = 0 THEN
      CurObject.TrackUser();
   ENDIF;
   
   RETURN;
END;

METHOD ClearMessage (
)=
DECLARE
   AckTime    = DATE    NOT NULL;
   AckOperator = VARCHAR(40) NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
   CurrentMethod = VARCHAR(20) NOT NULL;
   DeskType   = VARCHAR(20) NOT NULL WITH DEFAULT;
   Feeder     = INTEGER NOT NULL;
   FeederName = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   x          = INTEGER NOT NULL;
   k          = INTEGER NOT NULL;
   MsgKey     = INTEGER NOT NULL WITH DEFAULT;
   MsgType    = INTEGER NOT NULL WITH DEFAULT;
   MsgCard    = INTEGER NOT NULL WITH DEFAULT;
   MsgApp     = VARCHAR(4) NOT NULL WITH DEFAULT;
   MsgStation = INTEGER NOT NULL WITH DEFAULT;
   MsgMessage = VARCHAR(2000) NOT NULL WITH DEFAULT;
   OrigMessage = VARCHAR(2000) NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(80) NOT NULL WITH DEFAULT;
   TOIssuedCheck   = DATE;
   RSIssuedCheck   = DATE;
   TOCompleteCheck = DATE;
   RSCompleteCheck = DATE;
   RetCode    = INTEGER NOT NULL;
   SimpleMsg = CSD_Message_ASE DEFAULT NULL; /* enables use of class methods */
   Substation = INTEGER NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set clear time for message.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'ClearMessage';
/*
**  Don't validate Clearmessage since it is called from 
**  the CSD monitor during message cleanup.
*/

   FOR k = 1 TO CurObject.Mlist.LastRow() DO
/*
**  See if message has been acknowledged already.
*/
      AckTime = '';
      REPEATED
      SELECT :AckTime = L.AckTime,
             :AckOperator = L.AckOperator,
             :MsgKey = M.MsgKey,
             :MsgType = M.MessageType,
             :MsgCard = M.Card,
             :MsgMessage = M.MessageText,
             :DeskType = M.DeskType
      FROM   CSD_MessageLink L,
             CSD_Message M
      WHERE  L.MessageId = :CurObject.Mlist[k].MessageId AND
             L.IPAddress = :CurObject.IPAddress AND
             L.MessageID = M.MessageID;
      CALLPROC DDB_ROLLBACK;

      IF AckTime = '' THEN
         IF SimpleMsg IS NULL THEN
            SimpleMsg = CSD_Message_ASE.Create();
         ENDIF;
      
         SimpleMsg.UserName = CurObject.UserName;
         SimpleMsg.ByPassLastUpd = CurObject.ByPassLastUpd;
         SimpleMsg.MList[1].MessageId = CurObject.Mlist[k].MessageId;
         SimpleMsg.IPAddress = CurObject.IPAddress;
         SimpleMsg.AckMessage();
       
         IF SimpleMsg.ReturnCode <> 0 THEN
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleMsg.ErrorMessage;
            SimpleMsg = NULL;
            RETURN;
         ENDIF;
         SimpleMsg = NULL;
      
         AckTime = Date('now');
         AckOperator = CurObject.UserName;
      ENDIF;

      RetCode = CALLPROC CSD_MessageLinkUpd (
                     MessageId = CurObject.Mlist[k].MessageId,
                     IPAddress = CurObject.IPAddress,
                     AckTime = AckTime,
                     AckOperator = AckOperator,
                     ClearTime = DATE('now'),
                     ClearOperator = CurObject.UserName
                     );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': MessageId ' + varchar(CurObject.Mlist[k].MessageId) +
                          ' could not be cleared by ' + CurObject.UserName);
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Message was not cleared. ' +
               'Please try again.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;

      IF MsgType = 2 THEN
         /*
         **  This message was created from prompt by issuing job.
         **  Acknowledging message completes the job.  
         **  MsgCard is the card the move was issued on.
         **  MsgKey is the Job that was issued.
         */
         i = 0;
         SELECT :i = J.Job,
                :TOIssuedCheck = J.TOIssued,
                :TOCompleteCheck = J.TOComplete,
                :RSIssuedCheck = J.RSIssued,
                :RSCompleteCheck = J.RSComplete,
                :MsgStation = J.Substation,
                :MsgMessage = J.TOMove
         FROM    SOA_Job J
         WHERE   J.Job = :MsgKey;
         IF i <> 0 THEN
            MsgApp = 'FMS';  /* SOA_Job */
            SELECT :CardName = AC.CardName
            FROM    SOA_ActiveCard AC
            WHERE   AC.Card = MsgCard;
         ELSE
            SELECT :i = J.Job,
                   :TOIssuedCheck = J.TOIssued,
                   :TOCompleteCheck = J.TOComplete,
                   :RSIssuedCheck = J.RSIssued,
                   :RSCompleteCheck = J.RSComplete,
                   :MsgStation = J.Circuit,
                   :CardName = J.LineNumber,
                   :MsgMessage = J.TOMove
            FROM    TC_Job J
            WHERE   J.Job = :MsgKey;
            
            IF i <> 0 THEN
               MsgApp = 'TLS';  /* TC_Job */
            ENDIF;
         ENDIF;
         IF MsgApp = 'FMS' THEN  /* Compete SOA_Job */
            IF TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL THEN
               RetCode = CALLPROC SOA_CompleteMove(Job = MsgKey,
                                       Complete = date('now'),
                                       Status = Job$TakeOut
                                       );
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Takeout Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;
               
               RetCode = CALLPROC SOA_LogIns (
                    Card            = MsgCard
                  , Job             = MsgKey
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = CurObject.Mlist[k].AckOperator
                  , Item            = 'TOComplete'
                  , Old             = ''
                  , New             = IFNULL(DATE('now'),'')
                  );
               
            ELSEIF RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL THEN
               RetCode = CALLPROC SOA_CompleteMove(Job = MsgKey,
                                       Complete = date('now'),
                                       Status = Job$Restore
                                       );
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Restore Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;
               
               RetCode = CALLPROC SOA_LogIns (
                    Card            = MsgCard
                  , Job             = MsgKey
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = CurObject.Mlist[k].AckOperator
                  , Item            = 'RSComplete'
                  , Old             = ''
                  , New             = IFNULL(DATE('now'),'')
                  );
            ENDIF;
            
         ELSEIF MsgApp = 'TLS' THEN  /* Complete TC_Job */
            IF TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL THEN
               RetCode = CALLPROC TC_CompleteJob (
                    Job = MsgKey,
                    Operator = 0,
                    OperatorName = CurObject.Mlist[k].AckOperator,
                    Complete = date('now'),
                    TORS = 0);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Takeout Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;

               CALLPROC TC_LogChange (Card = MsgCard,
                    Job  = MsgKey,
                    Item = 'TOComplete',
                    Old  = '', 
                    New = IFNULL(DATE('now'),'')
                    );
               CALLPROC DDB_COMMIT;
            ELSEIF RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL THEN
               RetCode = CALLPROC TC_CompleteJob (
                    Job = MsgKey,
                    Operator = 0,
                    OperatorName = CurObject.Mlist[k].AckOperator,
                    Complete = date('now'),
                    TORS = 1);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': CSD_Message_ASE.AckMessage; ' + 
                        'Error Restore Completing job ' + MsgKey);
               ENDIF;
               CALLPROC DDB_COMMIT;

               CALLPROC TC_LogChange (Card = MsgCard,
                    Job  = MsgKey,
                    Item = 'RSComplete',
                    Old  = '', 
                    New = IFNULL(DATE('now'),'')
                    );
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
         /*
         **  Send message back to DO letting them know move was acknowledged.
         */
         IF (TOIssuedCheck IS NOT NULL AND TOCompleteCheck IS NULL) OR
            (RSIssuedCheck IS NOT NULL AND RSCompleteCheck IS NULL) THEN
            MsgMessage = 'MOVE ACKNOWLEDGED by ' + CurObject.Mlist[k].AckOperator + HC_NEWLINE + HC_NEWLINE +
                 CardName + ' had the following move completed due to acknowledge of Notification ' +
                'message ' + HC_NEWLINE + MsgMessage; 
            RetCode = CALLPROC MSG_SendMsg (
                  Card = MsgCard,
                  Action = 0,
                  OrderNumber = 0,
                  Substation = MsgStation,
                  SubstationName = 'Message', 
                  Msg = MsgMessage,
                  FromOpName = CurObject.Mlist[k].AckOperator,
                  SendDate = IFNULL(DATE('now'),''),
                  ToApp = MsgApp,
                  FromApp = 'NOTIFY',
                  Priority = 2
                  );
            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurObject.Mlist[k].AckOperator + 's acknowledgement ' +
                       'could not be relayed to the DO.');   
            ENDIF;
         ENDIF;
      ENDIF;
/*
**  Update CSD_Version Array
*/   
      FOR x = 1 TO CSD_Version.LastRow() DO
         IF CurObject.IPAddress = CSD_Version[x].IPAddress THEN
            CSD_Version[x].Version = CSD_Version[x].Version + 1;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDFOR;
   /*
   **  Update lastupdate time for this ipaddress
   */
   IF lowercase(CurObject.UserName) <> 'monitor' AND
      CurObject.ByPassLastUpd = 0 THEN
      CurObject.TrackUser();
   ENDIF;
   RETURN;
END;


METHOD UpdEstCompleteTime (
)=
DECLARE
   AlertTime = DATE NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
   CurrentMethod = VARCHAR(20) NOT NULL;
   Feeder     = INTEGER NOT NULL;
   FeederName = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   SimpleMsg = CSD_Message_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update the Estimated completion time.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'UpdEstCompleteTime';

#  include CSD_Validate

/*
**  Make sure they entered some text.
*/
   IF CurObject.Mlist.LastRow() > 0 THEN
      IF CurObject.Mlist[1].TimeString <> '' THEN
         CurObject.Mlist[1].Time = DATE(CurObject.Mlist[1].TimeString);
      ELSE
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without valid Estimated Completion Time.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Valid Estimated Complete time not passed to application server. ' +
              'Please restart application and try again.  If problems continue, ' +
              'contact technical support.';
         RETURN;        
      ENDIF;
   ELSE
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without Estimated Completion Time.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Estimated Complete time not passed to application server. ' +
              'Please restart application and try again.  If problems continue, ' +
              'contact technical support.';
      RETURN;
   ENDIF;
/*
**  Make sure card is out of service.
*/
   i = 0;
   SELECT :i = C.Card
   FROM    FMS_Card C
   WHERE   C.Card = :CurObject.MList[1].Card AND
           C.Cutout IS NOT NULL AND
           C.CutIn IS NULL AND
           C.Status < :Card$Closed;
   IF i <> 0 THEN

/*
**  Update Estimated Completion time.
*/
      RetCode = CALLPROC FMS_EstTimeCompleteUpd 
                 (Card = CurObject.Mlist[1].Card,
                  EstTimeComplete = ifnull(CurObject.Mlist[1].Time,''));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' for card ' + 
                       varchar(CurObject.Mlist[1].Card) + ' failed.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Estimated Complete time update failed.  Please try again.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;
      
      AlertTime = IFNULL(CurObject.Mlist[1].Time,'') + '1 hours';                

      CALLPROC FMS_EstTimeInserviceUpd 
             (Card = CurObject.Mlist[1].Card,
              EstTimeInservice = AlertTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' for card ' + 
                       varchar(CurObject.Mlist[1].Card) + ' failed to update estimated ' +
                       'inservice time.');
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Clear all occurences of this messageid.
*/
   CurObject.Dlist.Clear();
   REPEATED
   SELECT  :CurObject.Dlist[1].IPAddress = L.IPAddress,
           :CurObject.Dlist[1].MessageID = L.MessageId
   FROM     CSD_MessageLink L
   WHERE    MessageId = :CurObject.Mlist[1].MessageId
   BEGIN
      IF SimpleMsg IS NULL THEN
         SimpleMsg = CSD_Message_ASE.Create();
      ENDIF;

      SimpleMsg.UserName = CurObject.UserName;
      SimpleMsg.ByPassLastUpd = TRUE;
      SimpleMsg.MList[1].MessageId = CurObject.Mlist[1].MessageId;
      SimpleMsg.MList[1].MessageType = CurObject.Mlist[1].MessageType;
      SimpleMsg.IPAddress = CurObject.Dlist[1].IPAddress;
      SimpleMsg.ClearMessage();
      
      IF SimpleMsg.ReturnCode <> 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleMsg.ErrorMessage;
         SimpleMsg = NULL;
         RETURN;
      ENDIF;
      SimpleMsg = NULL;

   END; 
   /*
   **  Update lastupdate time for this ipaddress
   */
   CurObject.TrackUser();
  
   RETURN;
END;



METHOD UpdSubDelay (
)=
DECLARE
   ArrayIndex = INTEGER NOT NULL;
   CurrentMethod = VARCHAR(20) NOT NULL;
   CardClassName = VARCHAR(20) NOT NULL;
   Feeder     = INTEGER NOT NULL;
   FeederName = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   JobLink    = ARRAY OF INTEGEROBJECT;
   RetCode    = INTEGER NOT NULL;
   SimpleMsg = CSD_Message_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update the Estimated completion time.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'UpdSubDelay';

#  include CSD_Validate

/*
**  Make sure they entered some text.
*/
   IF CurObject.Mlist.LastRow() > 0 THEN
      IF CurObject.Mlist[1].MessageText = '' OR
         CurObject.Mlist[1].Card = 0 THEN
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without valid Delay.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Valid Delay not passed to application server. ' +
              'Please restart application and try again.  If problems continue, ' +
              'contact technical support.';
         RETURN;        
      ENDIF;
   ELSE
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without delay entered.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Delay was passed to application server. ' +
              'Please restart application and try again.  If problems continue, ' +
              'contact technical support.';
      RETURN;
   ENDIF;
/*
**  Make sure delay is still on card.
*/
   i = 1;
   SELECT :JobLink[i].Value = J.Job,
          :CardClassName = C.CardClassName,
          :Feeder = C.Feeder,
          :FeederName = C.FeederName
   FROM    FMS_Card C,
           FMS_JobDelayLink J
   WHERE   C.Card = :CurObject.MList[1].Card AND
           C.Card = J.Card AND
           J.OperatingStep = :Type$SSOAckDelay
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF JobLink.LastRow() <> 0 THEN
/*
**  Remove PENDING SUBSTATION Ack delay and insert new delay.
*/
      RetCode = CALLPROC FMS_OperatingStepUpd ( 
                  Card = CurObject.Mlist[1].Card,
                  OperatingStep = :Type$SSOAckDelay,
                  EndTime = Date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' for card ' + 
                       varchar(CurObject.Mlist[1].Card) + ' failed to clear ' +
                       'PENDING SSO ACK delay.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not clear PENDING SSO ACK delay.  Please try again.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;
      
      RetCode = CALLPROC FMS_OperatingStepIns 
                 (Card = CurObject.Mlist[1].Card,
                  CardClassName = CardClassName,
                  Feeder = Feeder,
                  FeederName = FeederName,
                  OperatingStep = Delay$PendingCrew,
                  OperatingStepName = CurObject.Mlist[1].MessageText,
                  StartTime = date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' for card ' + 
                       varchar(CurObject.Mlist[1].Card) + ' failed to set ' +
                       'PENDING CREW delay.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not set ' + CurObject.Mlist[1].MessageText + 
                 ' delay.  Please try again.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;       
      
      FOR i = 1 TO JobLink.LastRow() DO
         RetCode = CALLPROC FMS_JobDelayLinkIns
                               (Job  = JobLink[i].Value,
                                Card = CurObject.Mlist[1].Card,
                                OperatingStep = Delay$PendingCrew);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' for card ' + 
                       varchar(CurObject.Mlist[1].Card) + HC_NEWLINE +
                       '            failed to link PENDING CREW Delay ' +
                       'to job:' + varchar(JobLink[i].Value));
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT; 
      ENDFOR;
   ENDIF;
   
/*
**  Clear all occurences of this messageid.
*/
   CurObject.Dlist.Clear();
   REPEATED
   SELECT  :CurObject.Dlist[1].IPAddress = L.IPAddress,
           :CurObject.Dlist[1].MessageID = L.MessageId
   FROM     CSD_MessageLink L
   WHERE    MessageId = :CurObject.Mlist[1].MessageId
   BEGIN
      IF SimpleMsg IS NULL THEN
         SimpleMsg = CSD_Message_ASE.Create();
      ENDIF;

      SimpleMsg.UserName = CurObject.UserName;
      SimpleMsg.ByPassLastUpd = TRUE;
      SimpleMsg.MList[1].MessageId = CurObject.Mlist[1].MessageId;
      SimpleMsg.MList[1].MessageType = CurObject.Mlist[1].MessageType;
      SimpleMsg.IPAddress = CurObject.Dlist[1].IPAddress;
      SimpleMsg.ClearMessage();
      
      IF SimpleMsg.ReturnCode <> 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleMsg.ErrorMessage;
         SimpleMsg = NULL;
         RETURN;
      ENDIF;
      SimpleMsg = NULL;

   END; 
   /*
   **  Update lastupdate time for this ipaddress
   */
   CurObject.TrackUser();
   
   RETURN;
END;


METHOD InitiateVersion (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to validate ipaddress and load messages for that user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'InitiateVersion';

   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': CSD Monitor initializing ' +
                    'CSD_Version array.');
   i = 1;
   SELECT :CSD_Version[i].IPAddress = IPAddress,
          :CSD_Version[i].NodeName = NodeName,
          :CSD_Version[i].NormallyDisabled = NormallyDisabled,
          :CSD_Version[i].CurrentlyDisabled = CurrentlyDisabled,
          :CSD_Version[i].Version = 1
   FROM    CSD_MessageType
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;


METHOD UpdVersion (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to validate ipaddress and load messages for that user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'UpdVersion';
/*
   CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Attempting to update CSD_Version array. ' +
                    'for ' + CurObject.IPAddress);
*/
/*
**  Update CSD_Version Array
*/   
   FOR i = 1 TO CSD_Version.LastRow() DO
      IF CurObject.IPAddress = CSD_Version[i].IPAddress THEN
         CSD_Version[i].Version = CSD_Version[i].Version + 1;
/*
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Updated CSD_Version array. ' +
                    'for ' + CurObject.IPAddress + ' ' + varchar(csd_version[i].Version));
*/
         ENDLOOP;
      ENDIF;
   ENDFOR;

   RETURN;
END;


METHOD CheckStatus (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i = INTEGER NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to validate ipaddress and load messages for that user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'CheckStatus';

#  include CSD_Validate

   IF CurObject.Validate = 1 THEN
      /*
      **  Update lastupdate time for this ipaddress
      */
      IF lowercase(CurObject.UserName) <> 'monitor' THEN
         CurObject.TrackUser();
      ENDIF;
      RETURN;
   ENDIF;
   
   IF CurObject.Version <> CSD_Version[ArrayIndex].Version THEN
      CurObject.Version = CSD_Version[ArrayIndex].Version;
      i = 1;
      CurObject.Dlist.Clear(); 
      SELECT  CurObject.Dlist[i].MessageId = M.MessageId,
              CurObject.Dlist[i].MessageText = M.MessageText,
              CurObject.Dlist[i].MessageType = M.MessageType,
              CurObject.Dlist[i].Priority = M.Priority,
              CurObject.Dlist[i].Time = M.Time,
              CurObject.Dlist[i].Card = M.Card,
              CurObject.Dlist[i].AckTime = L.AckTime,
              CurObject.Dlist[i].AckOperator = L.AckOperator,
              CurObject.Dlist[i].ClearTime = L.ClearTime,
              CurObject.Dlist[i].ClearOperator = L.ClearOperator
      FROM    CSD_Message M,
              CSD_MessageLink L
      WHERE   L.IPAddress = :CurObject.IPAddress AND
              L.ClearTime = '' AND
              L.MessageID = M.MessageID
      ORDER BY TIME ASC
      BEGIN 
         i = i + 1;
      END;  
      CALLPROC DDB_ROLLBACK;
      /*
      **  Select CurrentlyDisabled flag.
      */
      SELECT :CurObject.Disabled = T.CurrentlyDisabled
      FROM    CSD_MessageType T
      WHERE   T.IPAddress = :CurObject.IPAddress;
      CALLPROC DDB_ROLLBACK;
   ELSE
      RETURN;
   ENDIF;
   
   RETURN;
END;


METHOD LoadHistory (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i = INTEGER NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to validate ipaddress and load messages for that user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'LoadHistory';

#  include CSD_Validate

   IF CurObject.TimeString = '' THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without a time stamp.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No time was entered. Please try again.';
      RETURN;    
   ENDIF;   
   
   CurObject.Time = DATE(CurObject.TimeString);

   i = 1;
   CurObject.Dlist.Clear();
   IF CurObject.ToECC = 1 THEN
      REPEATED 
      SELECT  CurObject.Dlist[i].MessageId = T.MessageId,
              CurObject.Dlist[i].MessageText = T.MessageText,
              CurObject.Dlist[i].Time = T.Time,
              CurObject.Dlist[i].AckTime = IFNULL(M.AckDate,''),
              CurObject.Dlist[i].AckOperator = M.AckByOpName,
              CurObject.Dlist[i].DODesk = T.DODesk
      FROM    CSD_ToECC T,
              CSD_MessageLink L,
              MSG_Message M
      WHERE   L.IPAddress = :CurObject.IPAddress AND
              L.MessageID = T.MessageID AND
              T.Time >= :CurObject.Time AND
              T.Time <= date(:CurObject.Time) + date('1 day') AND
              T.MsgId = M.MsgKey
      UNION
      SELECT  T.MessageId,
              T.MessageText,
              T.Time,
              IFNULL(M.AckDate,''),
              M.AckByOpName,
              T.DODesk
      FROM    CSD_ToECC T,
              CSD_MessageLink L,
              MSG_ArchiveMessage M
      WHERE   L.IPAddress = :CurObject.IPAddress AND
              L.MessageID = T.MessageID AND
              T.Time >= :CurObject.Time AND
              T.Time <= date(:CurObject.Time) + date('1 day') AND
              T.MsgId = M.MsgKey
      ORDER BY TIME ASC
      BEGIN 
         i = i + 1;
      END;
   ELSE  
      REPEATED 
      SELECT  CurObject.Dlist[i].MessageId = M.MessageId,
              CurObject.Dlist[i].MessageText = M.MessageText,
              CurObject.Dlist[i].MessageType = M.MessageType,
              CurObject.Dlist[i].Priority = M.Priority,
              CurObject.Dlist[i].Time = M.Time,
              CurObject.Dlist[i].Card = M.Card,
              CurObject.Dlist[i].AckTime = L.AckTime,
              CurObject.Dlist[i].AckOperator = L.AckOperator,
              CurObject.Dlist[i].ClearTime = L.ClearTime,
              CurObject.Dlist[i].ClearOperator = L.ClearOperator
      FROM    CSD_Message M,
              CSD_MessageLink L
      WHERE   L.IPAddress = :CurObject.IPAddress AND
              L.MessageID = M.MessageID AND
              M.Time >= :CurObject.Time AND
              M.Time <= date(:CurObject.Time) + date('1 day')
      ORDER BY TIME ASC
      BEGIN 
         i = i + 1;
      END;  
   ENDIF;
   CALLPROC DDB_ROLLBACK;  
   
   RETURN;
END;


METHOD ConfirmExit (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i = INTEGER NOT NULL;
   ArrayIndex = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to validate ipaddress and load messages for that user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'CONFIRM EXIT';

#  include CSD_Validate

   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called with the following reason: ' + 
                       HC_NEWLINE + '            ' + CurObject.DOMessage + ' by ' +
                       CurObject.UserName + ' ' + CurObject.IPAddress);
   RETURN;    
END;


METHOD SendMessage (
)=
DECLARE
   ArrayIndex = INTEGER NOT NULL;
   CurrentMethod = VARCHAR(20) NOT NULL;
   Feeder     = INTEGER NOT NULL;
   FeederName = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to send a message back to the D.O.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'SendMessage';

#  include CSD_Validate
   
   IF CurObject.DODesk <> 'bq' AND
      CurObject.DODesk <> 'ws' AND 
      CurObject.DODesk <> 'mx' THEN

      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without valid DeskName.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Desk information not passed to application server. ' +
              'Please restart application and try again.  If problems continue, ' +
              'contact technical support.';
      RETURN;    
   ENDIF;   
   
   IF CurObject.DOMessage = '' THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurrentMethod + ' called without a message.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No message was entered. Please try again.';
      RETURN;    
   ENDIF;   
   
   REPEATED 
   SELECT  :Feeder = G.Member,
           :FeederName = 'Message'
   FROM     Udb_Grouping G,
            Udb_Object O
   WHERE    O.Type = :Type$OperatorDesk AND
            O.Name = :CurObject.DODesk AND
            O.Object = G.Grouping AND
            G.MemberType = :Type$Feeder AND
            G.RelationShip = :Interaction$ControlledBy;
   CALLPROC DDB_ROLLBACK;
      
   RetCode = CALLPROC MSG_SendMsg (
                  Card = Feeder,
                  Action = 0,
                  OrderNumber = 0,
                  Substation = Feeder,
                  SubstationName = FeederName, 
                  Msg = CurObject.DOMessage,
                  FromOpName = CurObject.UserName,
                  SendDate = IFNULL(DATE('now'),''),
                  ToApp = 'FMS',
                  FromApp = 'NOTIFY',
                  Priority = 2
                  );
   IF Retcode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurObject.UserName + 's comment ' +
                       'could not be relayed to the DO.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Message was not sent ' +
            'to the District Operator.  Please try again.';
      RETURN;    
   ENDIF;
   
   RetCode = CALLPROC CSD_ToECCIns(
            MsgID = RetCode
           ,Time = date('now')
           ,DODesk = :CurObject.DODesk
           ,MessageText = CurObject.DOMessage
           );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurObject.UserName + 's comment ' +
                       'relayed to the DO but message not saved in CSD_ToECC.');
      RETURN;    
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RetCode = CALLPROC CSD_MessageLinkIns(
            MessageID = RetCode
           ,IPAddress = :CurObject.IPAddress
           ,NodeName = :CurObject.NodeName
           );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': ' + CurObject.UserName + 's comment ' +
                       'relayed to the DO but message link not saved in CSD_ToECC.');
      RETURN;    
   ENDIF;
   CALLPROC DDB_COMMIT; 
   
   RETURN;
END;

METHOD ClearDisabledFlag (
)=
DECLARE
   CurrentMethod = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   msg        = ARRAY OF CSD_Message;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to clear the currently disabled flag.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   CurrentMethod = 'ClearDisabledFlag';

   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': Clearing DISABLED flag for ipaddress: ' + CurObject.IpAddress);
   
   RetCode = CALLPROC CSD_MessageTypeCurUpd(
            IpAddress = CurObject.IpAddress
           ,CurrentlyDisabled = FALSE
           ,LastUpdate = date('now')
           ,LastUser   = CurObject.UserName
           );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Unable to clear Disabled Flag.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'This console is currently disabled. ' +
          'Please restart FMS Notification window to enable messages.';
      RETURN;    
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Insert messages for the current day so user can see what has been happening 
**  for the information they are registered to see.
*/  
   i = 1;
   msg.Clear();
   REPEATED 
   SELECT :msg[i].MessageID = M.MessageID,
          :msg[i].IPAddress = MT.IPAddress,
          :msg[i].NodeName = MT.NodeName
   FROM    CSD_Message M,
           CSD_MessageType MT
   WHERE   M.Sent >= Date('Today') AND
           M.DeskType = MT.DeskType AND
           MT.IPAddress = :CurObject.IpAddress AND
           MT.CurrentlyDisabled = :FALSE
   ORDER BY MessageID
   BEGIN
      i = i + 1;
   END;
   IF msg.LastRow() <> 0 THEN
      i = 1;
      WHILE i <= msg.LastRow() DO

         RetCode = CALLPROC CSD_MessageLinkIns (
                             MessageID = msg[i].MessageID,
                             IPAddress = msg[i].IPAddress,
                             NodeName = msg[i].NodeName);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            DDB_Global.TopFrame.Trace
               (Text =  varchar(date('now')) + ' Could not update link for MessageID: ' +
                  varchar(msg[i].MessageId) + ' and IPAddress ' + msg[i].IPAddress);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;

         i = i + 1;
      ENDWHILE;
      /*
      **  Update version number for ipaddress
      */
      /*
      **  Update CSD_Version Array
      */   
      FOR i = 1 TO CSD_Version.LastRow() DO
         IF CurObject.IPAddress = CSD_Version[i].IPAddress THEN
            CSD_Version[i].Version = CSD_Version[i].Version + 1;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDIF;
   RETURN;
END;

METHOD TrackUser (
)=
DECLARE
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   RetCode = CALLPROC CSD_MessageTypeLastUpd (
            IPAddress = CurObject.IPAddress,
            LastUpdate = date('now'),
            LastUser   = CurObject.UserName
            );

   IF Retcode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                 ': IPAddress ' + varchar(CurObject.IPAddress) +
                 ' LastUpdate time not updated');
      /* Don't return error to user for this error */
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

Application Component Report
============================

	Name:            CSD_Validate


Include Script
--------------------------
/*
** Valid fields being passed in.
*/
IF CurObject.IpAddress = '' THEN
   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': ' + CurrentMethod + ' called without IPAddress.');
   CurObject.ReturnCode = -1;
   CurObject.ErrorMessage = 'User information not passed to application server. ' +
           'Please restart application and try again.  If problems continue, ' +
           'contact technical support.';
   RETURN;
ENDIF;
/*
**  Validate CSD_Version has data.
*/
IF CSD_Version.LastRow() = 0 THEN
   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': ASO Object created without CSD Monitor initializing ' +
                    HC_NEWLINE + '            CSD_Version array.');
   i = 1;
   SELECT :CSD_Version[i].IPAddress = IPAddress,
          :CSD_Version[i].NodeName = NodeName,
          :CSD_Version[i].NormallyDisabled = NormallyDisabled,
          :CSD_Version[i].CurrentlyDisabled = CurrentlyDisabled,
          :CSD_Version[i].Version = 1
   FROM    CSD_MessageType
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
ENDIF;
/* 
**  Validate IPAddress is in database.
*/ 
ArrayIndex = 0;  
FOR i = 1 TO CSD_Version.LastRow() DO
   IF CurObject.IPAddress = CSD_Version[i].IPAddress THEN
      ArrayIndex = i;
      ENDLOOP;
   ENDIF;
ENDFOR;
   
IF ArrayIndex = 0 THEN
   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': UNAUTHORIZED ACCESS to FMS Notification system.' + HC_NEWLINE +
                    '            IPAddress = ' + CurObject.IPAddress + HC_NEWLINE +
                    '            NodeName  = ' + CurObject.NodeName + HC_NEWLINE +
                    '            UserName  = ' + CurObject.UserName); 
   CurObject.ReturnCode = -1;
   CurObject.ErrorMessage = 'This machine is not authorized to use this system. ' +
           'Please report problem to Watch Engineer at ECC to set up access to ' +
           'the FMS Notification System.';
   RETURN;      
ENDIF;
/*
**  Validate username passed in.
*/
IF CurObject.UserName = '' THEN
   CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': ' + CurrentMethod + ' called without UserName.');
   CurObject.ReturnCode = -1;
   CurObject.ErrorMessage = 'User information not passed to application server. ' +
           'Please restart application and try again.  If problems continue, ' +
           'contact technical support.';
   RETURN;    
ENDIF;

Application Component Report
============================

	Name:            CutOutTrace

/*
**  Application:    CAC
**  Frame:          CutOutTrace
**
**  Date:       Author   Description
** ----------------------------------
**  09/18/15    em       Copied IsolationTrace to seed Scheduled card TFMS Card CutOut trace.
**                       Trace is initiated from AC LineSegment and stops at first breaker,
**                       assume passed in MoveEquip is open.  If any breakers are closed, the 
**                       procedure returns a positive return value indicating the card is not cutout.
**  10/06/15    em       Look for DOUBLE indicator to go through an in series breaker, ignore GT breakers
**                       GT breakers hardcoded for now, might need to adjust list later during testing
**  10/19/15    em       Be less restrictive on card scope trace, objecttocard link can exist with 0 or 1 value;
**                       Don't ignore GT breaker, treat it as being open.
**  01/20/17    em       Trump Inauguration, convert trace to QGIS
**  05/03/17    em       Remove hardcode for BkrROGT type
**  07/13/17    em       Return -1 for Closed breaker, merging interim change made in ce_dev
**                       Three return codes: PU_CANCEL = Error, -1 = Closed or Outof Scope, PU_OK = Open
**  
**
*/
PROCEDURE CutOutTrace (
    MoveEquip		= INTEGER NOT NULL;  /*Passed Equipment ID*/
    TraceStartEquip     = INTEGER NOT NULL WITH DEFAULT;  /*Passed trace startpoing*/
    Card	 	= INTEGER NOT NULL WITH DEFAULT;/*Passed Card to limit scope*/	

    BreakerType = INTEGER NOT NULL; /*Compare Bkr Type to Spare Bank Types*/
    CardScope = INTEGER NOT NULL;          /*BOOLEAN*/ 
    ConnectedEquip = ARRAY OF ConnectedEquipClass;  /*Trace equip loop*/
    DebugOn = INTEGER NOT NULL WITH DEFAULT; /*print debug messages*/
    DeviceOpen = INTEGER NOT NULL;          /*BOOLEAN*/ 
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;
    ExcludedNodes   = Array of IntegerObject;
    FirstObject = INTEGER NOT NULL WITH DEFAULT;                            
    i = INTEGER;                            
    j = INTEGER;
    k = INTEGER;                            
    m = INTEGER;          
    n = INTEGER NOT NULL;
    o = INTEGER NOT NULL;
    LastRow = INTEGER NOT NULL;
    LoadBreakingTypes    = ARRAY OF INTEGEROBJECT; /*Load breaking device types*/
    MoreObjects = INTEGER NOT NULL WITH DEFAULT;    /*Loop control*/                            
    OpenDevices = ARRAY OF INTEGEROBJECT;           /*Electrical Verification*/
    RetCode = INTEGER NOT NULL;                     /*return variable */
    StartEquip = ConnectedEquipClass;               /*Start Object*/
    StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
    SubstationScope   = ARRAY OF INTEGEROBJECT;  
    TempEquip = ARRAY OF ConnectedEquipClass;       /*Next connected object*/
    Trace = Trace_CutOutTrace;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Trace goes from start point in all directions to first breaker,
**  first breaker must be open.
*/
    DebugOn = FALSE;
    REPEATED
    SELECT  :StartEquip.Object = O.Object,
            :StartEquip.Type = O.Type,
            :StartEquip.Name = O.Name,
            :StartEquip.TypeName = O.TypeName,
            :StartEquip.PrimaryGrouping = O.PrimaryGrouping,
            :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
    FROM    Udb_Object O
    WHERE   O.Object = :TraceStartEquip;

    IF iirowcount <= 0 THEN
       CALLPROC TraceError (UserMessage = 
               'ERROR: Starting Equipment not found in database',
                            TraceMessage =
               'CutOutTrace: Equip Object ' + 
               VARCHAR(TraceStartEquip) + ' not found in database.' 
                            );
       RETURN (PU_CANCEL);
    ENDIF;
/*
** Limit scope to card objects
*/
    i = 1;
    SELECT :SubstationScope[i].Value = AO.Object
    FROM   SOA_ActiveObject AO
    WHERE  AO.Card = :Card
    BEGIN
       i = i + 1;
    END;
/*
** Prepare the trace loop
*/
   Trace.JCEquip.Object = MoveEquip;
   
   Trace.UsePendingStatus = FALSE;
   
   Trace.SubstationScope = SubstationScope;
   
   TraceStatus = Trace.StartTargetTrace(StartEquipObject = StartEquip.Object, 
                                        StartEquipSubstation = StartEquip.PrimaryGrouping);

   IF Trace.ClosedBreaker = TRUE THEN
      RETURN(-1);
   ELSE
/*
**  All paths must be open, Return OK to CutOut card.
*/
      RETURN (PU_OK);
   ENDIF; 
END;

Application Component Report
============================

	Name:            CutOutTrace_b4qgis

/*
**  Application:    CAC
**  Frame:          CutOutTrace
**
**  Date:       Author   Description
** ----------------------------------
**  09/18/15    em       Copied IsolationTrace to seed Scheduled card TFMS Card CutOut trace.
**                       Trace is initiated from AC LineSegment and stops at first breaker,
**                       assume passed in MoveEquip is open.  If any breakers are closed, the 
**                       procedure returns a positive return value indicating the card is not cutout.
**  10/06/15    em       Look for DOUBLE indicator to go through an in series breaker, ignore GT breakers
**                       GT breakers hardcoded for now, might need to adjust list later during testing
**  10/19/15    em       Be less restrictive on card scope trace, objecttocard link can exist with 0 or 1 value;
**                       Don't ignore GT breaker, treat it as being open.
**  03/23/17    em       Modify to support three return values:
**                         PU_CANCEL = Something didn't work, we produced an error message
**                         PU_OK = All breakers open, proceed with CutOut
**                         -1 = Found closed breaker, no CutOut
**                       Remove Spare Bank Breakers from exclusion list for the Scheduled card cutout trace
**
*/
PROCEDURE CutOutTrace_b4qgis (
    MoveEquip		= INTEGER NOT NULL;  /*Passed Equipment ID*/
    TraceStartEquip     = INTEGER NOT NULL WITH DEFAULT;  /*Passed trace startpoing*/
    Card	 	= INTEGER NOT NULL WITH DEFAULT;/*Passed Card to limit scope*/	

    BreakerType = INTEGER NOT NULL; /*Compare Bkr Type to Spare Bank Types*/
    CardScope = INTEGER NOT NULL;          /*BOOLEAN*/ 
    ConnectedEquip = ARRAY OF ConnectedEquipClass;  /*Trace equip loop*/
    DebugOn = INTEGER NOT NULL WITH DEFAULT; /*print debug messages*/
    DeviceOpen = INTEGER NOT NULL;          /*BOOLEAN*/ 
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;
    ExcludedNodes   = Array of IntegerObject;
    FirstObject = INTEGER NOT NULL WITH DEFAULT;                            
    i = INTEGER;                            
    j = INTEGER;
    k = INTEGER;                            
    m = INTEGER;          
    n = INTEGER NOT NULL;
    o = INTEGER NOT NULL;
    LastRow = INTEGER NOT NULL;
    LoadBreakingTypes    = ARRAY OF INTEGEROBJECT; /*Load breaking device types*/
    MoreObjects = INTEGER NOT NULL WITH DEFAULT;    /*Loop control*/                            
    OpenDevices = ARRAY OF INTEGEROBJECT;           /*Electrical Verification*/
    RetCode = INTEGER NOT NULL;                     /*return variable */
    StartEquip = ConnectedEquipClass;               /*Start Object*/
    StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
    TempEquip = ARRAY OF ConnectedEquipClass;       /*Next connected object*/
) =
BEGIN
/*
**  Trace goes from start point in all directions to first breaker,
**  first breaker must be open.
*/
    DebugOn = FALSE;
    REPEATED
    SELECT  :StartEquip.Object = O.Object,
            :StartEquip.Type = O.Type,
            :StartEquip.Name = O.Name,
            :StartEquip.TypeName = O.TypeName,
            :StartEquip.PrimaryGrouping = O.PrimaryGrouping,
            :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
    FROM    Udb_Object O
    WHERE   O.Object = :TraceStartEquip;

    IF iirowcount <= 0 THEN
       CALLPROC TraceError (UserMessage = 
               'ERROR: Starting Equipment not found in database',
                            TraceMessage =
               'CutOutTrace: Equip Object ' + 
               VARCHAR(TraceStartEquip) + ' not found in database.' 
                            );
       RETURN (PU_CANCEL);
    ENDIF;
/*
** Build list of load breaking types excluding ones that we don't care about
*/
    i = 1;
    SELECT
    DISTINCT  :LoadBreakingTypes[i].Value = Type
    FROM      Udb_ExtendedType
    WHERE     SuperType = :Type$LoadBreaking
    BEGIN
               j = 0;
               SELECT :j = COUNT(*) 
               FROM   Udb_ExtendedType 
               WHERE  Type = :LoadBreakingTypes[i].Value AND
                      SuperType IN 
                        (:Type$CktSwer,
                         :Type$CktInterrupt
                         );
               IF j > 0 THEN
                  LoadBreakingTypes.RemoveRow(RowNumber = i);
               ELSE
                  i = i + 1;
               ENDIF;
    END;
/*
**  Load the open equipment within the scope of the active card.
**  Ignore our current device.
*/
    OpenDevices.Clear();
    i = 1;
    REPEATED
    SELECT
    DISTINCT :OpenDevices[i].Value = S.Object
    FROM     SOA_ActiveObject AO,
             Udb_Grouping G2,
             Udb_Switch S
    WHERE    AO.Card = :Card AND
             AO.Object = G2.Grouping AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Member <> :MoveEquip AND
             G2.Member = S.Object AND
             S.CurrentlyOpen = 1 
    BEGIN
       i = i + 1;
    END;
/*
** Prepare the trace loop
*/
    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ' +
                        'T1.Object IN (';

    ConnectedEquip.Clear();
    ConnectedEquip.InsertRow(Rownumber = 1, 
                             RowObject = StartEquip.Duplicate());
    DynamicWhereClause = VARCHAR(StartEquip.Object) + ')';

    i = 1;
    MoreObjects = TRUE;
    WHILE MoreObjects = TRUE DO

      DynamicWhereClause = StaticWhereClause + DynamicWhereClause; 

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */
      ExcludedNodes.Clear();
      TempEquip.Clear();

      j = 1;
      k = 1;
      SELECT :TempEquip[j].Object = T2.Object
,            :TempEquip[j].Terminal = T2.Terminal
,            :TempEquip[j].Node  = T2.Node
,            :TempEquip[j].Used = 0 
,            :TempEquip[j].Outbound = :FALSE
,            :TempEquip[j].Type = O.Type
,            :TempEquip[j].Name = O.Name
,            :TempEquip[j].TypeName = O.TypeName
,            :TempEquip[j].Description = O.Description
,            :TempEquip[j].PrimaryGrouping = O.PrimaryGrouping
,            :TempEquip[j].PrimaryGroupingName = O.PrimaryGroupingName
,            :TempEquip[j].OwnerNumber = O.OwnerNumber
,            :TempEquip[j].PrevObject = T1.Object
      FROM  Udb_Terminal T1,
            Udb_Terminal T2,
            Udb_Object O
      WHERE :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
/*
** Only include the node in the Excluded array once.  Makes a performance
** difference on the PC.
*/
          LastRow = ExcludedNodes.LastRow();
          n = 1;
          WHILE n <= LastRow DO
             IF TempEquip[j].Node = ExcludedNodes[n].Value THEN
                ENDLOOP;
             ENDIF;
             n = n + 1;
          ENDWHILE;
          IF n > LastRow THEN
             ExcludedNodes.InsertRow (RowNumber = k); 
             ExcludedNodes[k].Value = TempEquip[j].Node;
             k = k + 1;
          ENDIF;
          j = j + 1;
      END;            

      MoreObjects = FALSE;
/*
** Check for card scope only if Card passed.  
** We stop when we find isolatedfromtype
** or if all paths are open.
*/
      k = 1;
      WHILE k <= TempEquip.LastRow() DO
/*
** Card Scope check.  if no longer on Card, then return, card is not CutOut.
*/
            CardScope = 0;
            REPEATED
            SELECT   :CardScope = AO.Object
            FROM     SOA_ActiveObject AO,
                     Udb_Grouping G
            WHERE    G.Member = :TempEquip[k].Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Grouping = AO.Object AND
                     AO.Card = :Card;
    
            IF CardScope = 0 THEN
               IF DebugOn = TRUE THEN
                  MESSAGE 'Trace failed beyond card scope at ' + TempEquip[k].PrimaryGroupingName +
                          ' ' + TempEquip[k].TypeName + ' ' + TempEquip[k].Name;
               ENDIF;
               RETURN(-1);   
            ENDIF;
/*
** If device is a breaker then it must be open to continue looking for CutOut.
*/
            BreakerType = FALSE;
            BreakerType = CALLPROC ArraySearch(     SearchArray = LoadBreakingTypes,
                                                    TargetObject = TempEquip[k].Type);
            IF BreakerType = TRUE THEN           
               DeviceOpen = FALSE;
               DeviceOpen = CALLPROC ArraySearch (
                 SearchArray = OpenDevices,
                 TargetObject = TempEquip[k].Object);

               IF DeviceOpen = TRUE OR 
                  TempEquip[k].Object = MoveEquip OR 
                  TempEquip[k].Type = 22573 THEN           /*Bkr-R/OGT*/
/*
** Stop trace on this path for open device or GT Breaker, assume move equip is open, may or may not be due to timing.
*/ 
                  IF DebugOn = TRUE THEN
                     MESSAGE 'Reached Open breaker ' + TempEquip[k].PrimaryGroupingName +
                             ' ' + TempEquip[k].TypeName + ' ' + TempEquip[k].Name;
                  ENDIF;
                  TempEquip[k].Used = 1;
/*
** Look for InSeries DOUBLE indicator and go through first one
*/
               ELSEIF TempEquip[k].OwnerNumber = 'DOUBLE' AND TempEquip[k].Outbound = FALSE THEN
                  IF DebugOn = TRUE THEN
                     MESSAGE 'Reached DOUBLE Pass Through breaker ' + TempEquip[k].PrimaryGroupingName +
                             ' ' + TempEquip[k].TypeName + ' ' + TempEquip[k].Name;
                  ENDIF;
                  TempEquip[k].Outbound = TRUE;   /* Use this field to indicate we are looking past first closed breaker */
/*
** Won't go through second closed breaker if In Series
*/
               ELSE
/*
** Must have reached a closed breaker and can consider card not CutOut.            
*/
                  IF DebugOn = TRUE THEN
                     MESSAGE 'Trace failed at closed breaker ' + TempEquip[k].PrimaryGroupingName +
                             ' ' + TempEquip[k].TypeName + ' ' + TempEquip[k].Name;
                  ENDIF;
                  RETURN(-1);  
               ENDIF;
            ENDIF;  
            k = k + 1
      ENDWHILE;

      FirstObject = TRUE;
      DynamicWhereClause = '';

      j = 1;
      WHILE j <= TempEquip.LastRow() DO
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[j].Object THEN
                ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;

         IF k > ConnectedEquip.LastRow() THEN   /* new equipment found */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                           RowObject = TempEquip[j].Duplicate());
/*
** Establish outbound value based on prior equipment
*/
            o = 1;  
            WHILE o < i DO
               IF ConnectedEquip[o].Object = 
                    ConnectedEquip[i].PrevObject AND
                    ConnectedEquip[o].OutBound = TRUE THEN
                  ConnectedEquip[i].OutBound = TRUE;
               ENDIF;
               o = o + 1;
            ENDWHILE;
/*
** If Used = 1, then we are at a Stop Point and we don't continue trace
** on this path.
*/
            IF ConnectedEquip[i].Used = 0 THEN
               IF FirstObject = TRUE THEN
                  MoreObjects = TRUE;
                  FirstObject = FALSE;
                  DynamicWhereClause = VARCHAR(ConnectedEquip[i].Object);
               ELSE
                  DynamicWhereClause = DynamicWhereClause + 
                           ',' + VARCHAR(ConnectedEquip[i].Object);
               ENDIF;

            ENDIF;
         ENDIF;
         j = j + 1;
      ENDWHILE;

      IF MoreObjects = TRUE THEN
         DynamicWhereClause = DynamicWhereClause + ') AND T1.Node NOT IN (';
         k = 1;
         WHILE k <= ExcludedNodes.LastRow() DO
           IF K = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[k].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause +  
                                   ',' + VARCHAR(ExcludedNodes[k].Value);
           ENDIF;

           k = k + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;

    ENDWHILE;
/*
**  All paths must be open, Return OK to CutOut card.
*/
    RETURN (PU_OK); 
END;

Application Component Report
============================

	Name:            DBCode


Application Component Report
============================

	Name:            DCCChecksForMoveIssue

/*
**
**      Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          DCCChecks
**
**  Date:       Version Description
** ----------------------------------
**  02/25/04    em      Pulled out of PerformMoves to support DCC checks
**                      at move issue, both on-line and Process Automation.
*/
PROCEDURE DCCChecksForMoveIssue (
   Card = INTEGER NOT NULL;            /*Parameter*/
   Feeder = INTEGER NOT NULL;          /*Parameter*/
   FeederName = VARCHAR(40) NOT NULL;  /*Parameter*/
   Move = JobInProgress;               /*Parameter*/

   DccMsg = VARCHAR(500) NOT NULL; 
   DccRegion = VARCHAR(20) NOT NULL;
   DccCheck = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;         
) =
BEGIN      
   DccMsg = '';
   IF Move.Status = Job$TakeOut THEN
 
         /* Check for feeder being grounded */
         IF LOWERCASE(Move.ToMove) like '%apply%station%ground%' THEN
            DccMsg = 'Station ground being applied to feeder ' + FeederName;
         ENDIF;

         /* Check for TC Feeder status being set */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$TakeoutInt AND
                 JA.IssueCompl = :JobClass$Issue AND
                (JA.Action = :JobAction$Set OR
                 JA.Action = :JobAction$Increment) AND
                 JA.Status = :TypeName$TC;
         IF DccCheck <> 0 THEN
            DccMsg = 'Tracing current being applied to feeder ' + FeederName; 
         ENDIF;

         /* Check for HV Feeder status being set */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$TakeoutInt AND
                 JA.IssueCompl = :JobClass$Issue AND
                (JA.Action = :JobAction$Set OR
                 JA.Action = :JobAction$Increment) AND
                 JA.Status = :TypeName$HV;
         IF DccCheck <> 0 THEN
            /* Make sure this is not a High Pot move */
            DccCheck = 0;
            REPEATED 
            SELECT :DccCheck = COUNT(*) 
            FROM    FMS_JobAction JA 
            WHERE   JA.JobClass = :Move.JobClass AND
                    JA.EquipClass = :Move.MoveEquipClass AND
                    JA.StepPair = :Move.StepPair AND
                    JA.TypeofCard = :Type$13kVCard AND
                    JA.FeederEquip = 0 AND  /* prompt */
                    JA.Action = :JobAction$Prompt AND
                    JA.Status = :TypeName$HiPotIssue;
            IF DccCheck = 0 THEN
               DccMsg = 'Condition being established on feeder ' + FeederName; 
            ENDIF;
         ENDIF;
 
   ELSEIF Move.Status = Job$Restore THEN

        /* Check for feeder being ground being removed */
        IF LOWERCASE(Move.ToMove) like '%remove%station%ground%' THEN
               /* 
               ** They sometimes issue Ammeter Clear and Remove Station ground 
               ** at the same time so we will append message if needed.
               */ 
            IF lowercase(DccMsg) like '%ammeter%' THEN
               DccMsg = 'S/S PFS and Ammeter Clear initiated on feeder ' + 
                        FeederName + '.';
            ELSE
               DccMsg = 'S/S PFS initiated on feeder ' + FeederName + '.';
            ENDIF;
         ENDIF;
  
         /* Check for TC Feeder status being cleared on complete */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$RestoreInt AND
                 JA.IssueCompl = :JobClass$Complete AND
                (JA.Action = :JobAction$Clear OR
                 JA.Action = :JobAction$Decrement) AND
                 JA.Status = :TypeName$TC;
         IF DccCheck <> 0 THEN
            DccMsg = 'Tracing current being removed from feeder ' + FeederName; 
         ENDIF;
               
         /* Check for HV Feeder status being cleared on complete */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$RestoreInt AND
                 JA.IssueCompl = :JobClass$Complete AND
                (JA.Action = :JobAction$Clear OR
                 JA.Action = :JobAction$Decrement) AND
                 JA.Status = :TypeName$HV;
         IF DccCheck <> 0 THEN
            /* Make sure this is not a High Pot move */
            DccCheck = 0;
            REPEATED 
            SELECT :DccCheck = COUNT(*) 
            FROM    FMS_JobAction JA 
            WHERE   JA.JobClass = :Move.JobClass AND
                    JA.EquipClass = :Move.MoveEquipClass AND
                    JA.StepPair = :Move.StepPair AND
                    JA.TypeofCard = :Type$13kVCard AND
                    JA.FeederEquip = 0 AND  /* prompt */
                    JA.Action = :JobAction$Prompt AND
                    JA.Status = :TypeName$HiPotIssue;
            IF DccCheck = 0 THEN
               DccMsg = 'High voltage being removed from feeder ' + FeederName; 
            ENDIF;
         ENDIF;

         /* Check for AmmeterClear status being set on issue */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$RestoreInt AND
                 JA.IssueCompl = :JobClass$Issue AND
                (JA.Action = :JobAction$Set OR
                 JA.Action = :JobAction$Increment) AND
                 JA.Status = :TypeName$ACClrInProg;
         IF DccCheck <> 0 THEN
               /* 
               ** They sometimes issue Ammeter Clear and Remove Station ground 
               ** at the same time so we will append message if needed.
               */ 
               IF lowercase(DccMsg) like '%s/s pfs%' THEN
                  DccMsg = 'S/S PFS and Ammeter Clear initiated on feeder ' + 
                            FeederName + '.';
               ELSE
                  DccMsg = 'Ammeter Clear started on feeder ' + FeederName; 
               ENDIF;
         ENDIF;
      ENDIF;
/*
**  Send message to DCC if DccMsg field is set.  
*/
      IF DccMsg <> '' THEN
         /*
         **  Determine which regions to send message.
         */
         DccRegion = '';
         /* shift 1 char to get rid of d in division user. */
         SELECT DISTINCT
                :DccRegion = shift(O.Name,-1)
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 Udb_Grouping GG
         WHERE   G.Member = :Feeder AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.GroupingType = :Type$Division AND
                 G.Grouping = GG.Member AND
                 GG.Relationship = :Interaction$MemberOf AND
                 GG.GroupingType = :Type$Region AND
                 GG.Grouping = O.Object
         BEGIN
            RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                            ,MessageText = DccMsg
                                            ,Time = date('now')
                                            ,Priority = 0
                                            ,MessageType = 0
                                            ,Card = Card);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = '',
                                    TraceMessage =
                    'Automated DCC message ' + 
                    'not sent for ' + FeederName + ' regarding: ' + 
                    DccMsg);
            ENDIF;
            CALLPROC DDB_COMMIT;
         END;
   ENDIF;
END;

Application Component Report
============================

	Name:            DCCChecksForMoveReturn

/*
**
**      Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          DCCChecksForMoveReturn
**
**  Date:       Version Description
** ----------------------------------
**  02/23/04    em      Pulled out of ReturnOperatorMoves to support DCC checks
**                      at move completion, both on-line and Process Automation.
**  09/15/15    pkw     Set SetPFSNow when setting pfs from this frame.
*/
PROCEDURE DCCChecksForMoveReturn (
   Card = INTEGER NOT NULL;            /*Parameter*/
   Feeder = INTEGER NOT NULL;          /*Parameter*/
   FeederName = VARCHAR(40) NOT NULL;  /*Parameter*/
   Move = JobInProgress;               /*Parameter*/
   Position = VARCHAR(6) NOT NULL;     /*Parameter*/

   CardClassName = VARCHAR(20) NOT NULL;
   DccMsg = VARCHAR(500) NOT NULL; 
   DccRegion = VARCHAR(20) NOT NULL;
   DccCheck = INTEGER NOT NULL;
   i = INTEGER NOT NULL WITH DEFAULT;         
   RetCode = INTEGER NOT NULL WITH DEFAULT;  
   SimpleStep = OperatingStep_ASE DEFAULT NULL;        
) =
BEGIN      
   DccMsg = '';
   IF Move.Status = Job$TakeOut THEN
 
      /* Check for feeder being grounded */
      IF LOWERCASE(Move.ToMove) like '%apply%station%ground%' THEN
         DccMsg = 'Station ground on feeder ' + FeederName;
      ENDIF;

      /* Check for TC Feeder status being set */
      DccCheck = 0;
      REPEATED 
      SELECT :DccCheck = COUNT(*) 
      FROM    FMS_JobAction JA 
      WHERE   JA.JobClass = :Move.JobClass AND
              JA.EquipClass = :Move.MoveEquipClass AND
              JA.StepPair = :Move.StepPair AND
              JA.TypeofCard = :Type$13kVCard AND
              JA.FeederEquip = 1 AND  /* Feeder */
              JA.TORS = :Job$TakeoutInt AND
              JA.IssueCompl = :JobClass$Issue AND
             (JA.Action = :JobAction$Set OR
              JA.Action = :JobAction$Increment) AND
              JA.Status = :TypeName$TC;
      IF DccCheck <> 0 THEN
         DccMsg = 'Tracing current on feeder ' + FeederName; 
      ENDIF;

      /* Check for HV Feeder status being set */
      DccCheck = 0;
      REPEATED 
      SELECT :DccCheck = COUNT(*) 
      FROM    FMS_JobAction JA 
      WHERE   JA.JobClass = :Move.JobClass AND
              JA.EquipClass = :Move.MoveEquipClass AND
              JA.StepPair = :Move.StepPair AND
              JA.TypeofCard = :Type$13kVCard AND
              JA.FeederEquip = 1 AND  /* Feeder */
              JA.TORS = :Job$TakeoutInt AND
              JA.IssueCompl = :JobClass$Issue AND
             (JA.Action = :JobAction$Set OR
              JA.Action = :JobAction$Increment) AND
              JA.Status = :TypeName$HV;
      IF DccCheck <> 0 THEN
         /* Make sure this is not a High Pot move */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 0 AND  /* prompt */
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :TypeName$HiPotIssue;
         IF DccCheck = 0 THEN
            DccMsg = 'High voltage on feeder ' + FeederName; 
         ENDIF;
      ENDIF;
 
   ELSEIF Move.Status = Job$Restore THEN
  
      /* Check for TC Feeder status being cleared on complete */
      DccCheck = 0;
      REPEATED 
      SELECT :DccCheck = COUNT(*) 
      FROM    FMS_JobAction JA 
      WHERE   JA.JobClass = :Move.JobClass AND
              JA.EquipClass = :Move.MoveEquipClass AND
              JA.StepPair = :Move.StepPair AND
              JA.TypeofCard = :Type$13kVCard AND
              JA.FeederEquip = 1 AND  /* Feeder */
              JA.TORS = :Job$RestoreInt AND
              JA.IssueCompl = :JobClass$Complete AND
             (JA.Action = :JobAction$Clear OR
              JA.Action = :JobAction$Decrement) AND
              JA.Status = :TypeName$TC;
      IF DccCheck <> 0 THEN
         DccMsg = 'Tracing current off feeder ' + FeederName; 
      ENDIF;
               
      /* Check for HV Feeder status being cleared on complete */
      DccCheck = 0;
      REPEATED 
      SELECT :DccCheck = COUNT(*) 
      FROM    FMS_JobAction JA 
      WHERE   JA.JobClass = :Move.JobClass AND
              JA.EquipClass = :Move.MoveEquipClass AND
              JA.StepPair = :Move.StepPair AND
              JA.TypeofCard = :Type$13kVCard AND
              JA.FeederEquip = 1 AND  /* Feeder */
              JA.TORS = :Job$RestoreInt AND
              JA.IssueCompl = :JobClass$Complete AND
             (JA.Action = :JobAction$Clear OR
              JA.Action = :JobAction$Decrement) AND
              JA.Status = :TypeName$HV;
      IF DccCheck <> 0 THEN
         /* Make sure this is not a High Pot move */
         DccCheck = 0;
         REPEATED 
         SELECT :DccCheck = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 0 AND  /* prompt */
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :TypeName$HiPotIssue;
         IF DccCheck = 0 THEN
            DccMsg = 'High voltage off feeder ' + FeederName; 
         ENDIF;
      ENDIF;

      /* Check for AmmeterClear status being set on issue */
      DccCheck = 0;
      REPEATED 
      SELECT :DccCheck = COUNT(*) 
      FROM    FMS_JobAction JA 
      WHERE   JA.JobClass = :Move.JobClass AND
              JA.EquipClass = :Move.MoveEquipClass AND
              JA.StepPair = :Move.StepPair AND
              JA.TypeofCard = :Type$13kVCard AND
              JA.FeederEquip = 1 AND  /* Feeder */
              JA.TORS = :Job$RestoreInt AND
              JA.IssueCompl = :JobClass$Issue AND
             (JA.Action = :JobAction$Set OR
              JA.Action = :JobAction$Increment) AND
              JA.Status = :TypeName$ACClrInProg;
      IF DccCheck <> 0 THEN
         DccMsg = 
            'Ammeter Clear complete on feeder ' + FeederName; 
      ENDIF;
      /*
      **  Check to see if the move removes a portable ground. If it does
      **  we need to check if it was the last one. This is for removing
      **  FG operating steps correctly. 
      */
      IF Move.EquipName <> Position THEN 
         i = 0;
         SELECT :i = COUNT(*) 
         FROM    FMS_JobAction JA 
         WHERE   JA.JobClass = :Move.JobClass AND
                 JA.EquipClass = :Move.MoveEquipClass AND
                 JA.StepPair = :Move.StepPair AND
                 JA.TypeofCard = :Type$13kVCard AND
                 JA.FeederEquip = 2 AND  /* Equip */
                 JA.TORS = :Job$RestoreInt AND
                 JA.IssueCompl = :JobClass$Complete AND
                (JA.Action = :JobAction$Clear OR
                 JA.Action = :JobAction$Decrement) AND
                 JA.Status = :Status$Ground;
         IF i <> 0 THEN
            /* 
            **  See how many ground are on Feeder.
            */
            i = 0;
            SELECT :i = GroundsOn,
                   :CardClassName = CardClassName
            FROM   FMS_Card
            WHERE  Card = :Card;
            
            IF i <= 1 THEN
/*          
**  If Current Operating Step is FG then we will start PFS.
**          
**  If current Operating Step is not FG we will do nothing.  
**  PFS will get started when completing the last permit or
**  issuing the Ammeter Clear test move.
*/           
               i = 0;
               SELECT :i = COUNT(*) 
               FROM    FMS_OperatingStepStatus
               WHERE   Card = :Card AND
                       OperatingStep = :Type$FG AND
                       EndTime = '';
               IF i <> 0 THEN /* Set PFS */
                  IF SimpleStep IS NULL THEN
                     SimpleStep = OperatingStep_ASE.Create();
                  ENDIF;    
                  SimpleStep.SO.Object   = Card;
                  SimpleStep.SO.Name     = CardClassName;
                  SimpleStep.SO.Type     = Feeder;
                  SimpleStep.SO.TypeName = FeederName;
                  SimpleStep.OpStep      = Type$PFS; /* PFS Operating Step */

                  SimpleStep.SetPFSNow   = 2;
                  SimpleStep.SetOpStep();
   
                  IF SimpleStep.ReturnCode <> 0 THEN
                     CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                        TraceMessage =
                           'Procedure:DCCChecksForMoveReturn; ' +
                           'Error clearing PFS Delay. ' +
                           'Card=' + VARCHAR(Card) +
                           ';Status=' + VARCHAR(Type$PFS) + '.'
                           );
                  ENDIF; 
                  SimpleStep = NULL;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;
/*
**  Send message to DCC if DccMsg field is set.  
*/
   IF DccMsg <> '' THEN
      /*
      **  Determine which regions to send message.
      */
      DccRegion = '';
      /* shift 1 char to get rid of d in division user. */
      SELECT DISTINCT
             :DccRegion = shift(O.Name,-1)
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_Grouping GG
      WHERE   G.Member = :Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = :Type$Division AND
              G.Grouping = GG.Member AND
              GG.Relationship = :Interaction$MemberOf AND
              GG.GroupingType = :Type$Region AND
              GG.Grouping = O.Object
      BEGIN
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                         ,MessageText = DccMsg
                                         ,Time = date('now')
                                         ,Priority = 0
                                         ,MessageType = 0
                                         ,Card = Card);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = '',
                                 TraceMessage =
                 'Automated DCC message ' + 
                 'not sent for ' + FeederName + ' regarding: ' + 
                 DccMsg);
         ENDIF;
         CALLPROC DDB_COMMIT;
      END;
   ENDIF;
END;

Application Component Report
============================

	Name:            DefineAutoBlock

/*
**
**      Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          DefineAutoBlock
**
**  Date:       Version Description
** ----------------------------------
**  01/14/04    em     Generate FMS Process Automation Block
**  01/15/04    em     Disable Cancel button, GenerateFODOrder is
**                     exiting after creation.
**  03/17/04    em     Add Start Execution button is if not executing
**  10/25/04    em     Set Order status to Issued after AutoBlock is
**                     inserted.  This will ensure that FOD or SSO Monitor
**                     knows order is participating in automation.
**  10/26/04    em     Moved Order status update to Process Automation Monitor.
**                     Removed code inserted on 10/25.
**  07/31/06    ysp    Add "Start on Completion of Any Move in the Prior Block" option.
**  09/14/06    ysp    Add the division information to the newly defined block for report.
**  09/27/06    ysp    The "Start on .."flag applies only to a block that has take-out moves that
**                     sets TC status.
**  02/15/07    em     Added IFNULL to prevent No Null Indicator run time error
**  09/22/08    em     Include TCLocationCheck Status in "Start On..." check for FOD order
**  03/24/11    ysp    "Start on Any" applies to Check No Common Location move only.
**  03/25/11    pkw    Make changes for 3G updates.
**  05/31/11    ysp    In the logic that determines the enability of the "Start on Any..." flag,
**                     include blocks with the status of "Issued" in the consideration because
**                     the DO may continue to set up blocks after the automation has started.
**  12/17/14    ysp    Fixed the SQL that gets the feeder's primarygrouping.
**  01/08/19    em     Add StartOnDBF options for 4kV cards
**  02/18/20    ysp    only show StartOnDBF if prior block has Check DBF
*/ 
INITIALIZE
(
    Card 	= INTEGER NOT NULL;       /*Input Parameter*/
    Block 	= INTEGER NOT NULL;      /*Input Parameter*/
    SendTo 	= CHAR(3) NOT NULL;     /*Input Parameter*/
    Title 	= VARCHAR(80) NOT NULL WITH DEFAULT; /*Input Parameter*/

    i = INTEGER NOT NULL WITH DEFAULT;
    CardExecutionState = INTEGER NOT NULL WITH DEFAULT;
    Division    = INTEGER NOT NULL WITH DEFAULT;
    Feeder = INTEGER NOT NULL WITH DEFAULT;
    FeederType  = INTEGER NOT NULL WITH DEFAULT;
    PrimaryGrouping  = INTEGER NOT NULL WITH DEFAULT;
    InsertandStart = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    NextSeq     = INTEGER NOT NULL WITH DEFAULT; /*Block Sequence*/
    PrevSeq     = INTEGER NOT NULL WITH DEFAULT; /*Block Sequence*/
    PrevSendTo  = CHAR(3) NOT NULL WITH DEFAULT;  
    RetCode 	= INTEGER NOT NULL WITH DEFAULT;  /*Return Code*/
    TypeOfCard 	= INTEGER NOT NULL WITH DEFAULT;  
) =
BEGIN
   BlockTo = SendTo;
   BlockTitle = Title;
   InsertandStart = FALSE;
/*
** Evaluate ExecutionState
*/
   SELECT :CardExecutionState = ProcessAutoExecution,
          :TypeOfCard = TypeOfCard
   FROM   FMS_Card
   WHERE  Card = :Card;
 
   IF CardExecutionState = Automation$No THEN
      FIELD(start_btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(start_btn).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** The block sequence for this new block
*/
   NextSeq = 0;
   SELECT  :NextSeq = IFNULL(MAX(BlockSeq),0)
   FROM    FMS_AutomationBlock 
   WHERE   Card = :Card AND
           BlockStatus < :BlockStatus$Cancelled;

   NextSeq = NextSeq + 1;
   IF TypeOfCard = TypeOfCard$4kv THEN
   
      i = 0;
      SELECT :i = COUNT(*)
      FROM   FMS_AutomationBlock AB,
             IR_FODOrderJobs FO,
             SOA_Job J,
             FMS_JobAction JA
      WHERE  AB.Card = :Card AND
             AB.BlockStatus < :BlockStatus$Stopped AND
             AB.BlockSeq < :NextSeq AND
             AB.Block = FO.OrderNumber AND
             FO.Job = J.Job AND
             J.JobClass = JA.JobClass AND
             JA.Action = :JobAction$Prompt AND
             JA.TORS = :Job$TakeoutInt AND
             JA.IssueCompl = :JobClass$Complete AND
             JA.Status = :Prompt$CheckDBF;
      
      IF i > 0 THEN     
         FIELD(only_4kv).CurBias = FB_CHANGEABLE;
      ENDIF;
   ENDIF;

/*
** "Start ..." flag applies only to a block that has take-out moves that
**  sets TC status for SSO or Verify No Common Location for FOD 
*/
   i = 0;
/*
** FMS 398: "Start On Any.." does not longer apply to TC moves
**
   IF SendTo = 'SSO' THEN
         SELECT :i = Count(*) 
         FROM    IR_OpOrderJobs OJ,
                 SOA_Job J,
                 SOA_JobControl JC,
                 FMS_JobAction JA 
         WHERE   OJ.OrderNumber = :Block AND
                 OJ.TORS = :Job$TakeoutInt AND                      /* Take out                 
                 OJ.Job = JC.Job AND
                 JC.Card = :Card AND  
                 JC.Job = J.Job AND
                 JA.JobClass = J.JobClass AND
                 JA.EquipClass = JC.MoveEquipClass AND
                 JA.StepPair = JC.StepPair AND
                 JA.FeederEquip = 1 AND  /* Feeder 
                 JA.TORS = :Job$TakeoutInt AND
                 JA.IssueCompl = :JobClass$Issue AND
                 (JA.Action = :JobAction$Set OR
                 JA.Action = :JobAction$Increment) AND
                 JA.Status = :TypeName$TC;                
   ELSE
*/
         SELECT :i = Count(*) 
         FROM    IR_FODOrderJobs OJ,
                 SOA_Job J,
                 SOA_JobControl JC,
                 FMS_JobAction JA 
         WHERE   OJ.OrderNumber = :Block AND
                 OJ.TORS = :Job$TakeoutInt AND                        /* Take out */
                 OJ.Job = JC.Job AND
                 JC.Card = :Card AND  
                 JC.Job = J.Job AND
                 JA.JobClass = J.JobClass AND
                 JA.EquipClass = JC.MoveEquipClass AND
                 JA.StepPair = JC.StepPair AND
                 JA.FeederEquip = 1 AND  /* Feeder */
                 JA.TORS = :Job$TakeoutInt AND
                 JA.IssueCompl = :JobClass$Complete AND
                 (JA.Action = :JobAction$Set OR
                 JA.Action = :JobAction$Increment) AND
                 JA.Status = :Status$TCLocationCheck;                
/* FMS 398
   ENDIF;
*/

   IF i = 0 THEN
      StartOnAny = 0;
      FIELD(StartOnAny).CurBias = FB_DIMMED;
   ELSE
/*
** "Start on Completion of Any Move in the Prior Block" does not apply to 
** the first block. 
*/
      PrevSeq = 0;
      SELECT :PrevSeq = IFNULL(MAX(BlockSeq),0)
      FROM    FMS_AutomationBlock 
      WHERE   Card = :Card AND
              BlockSeq < :NextSeq AND
              BlockStatus IN (:BlockStatus$Setup, :BlockStatus$Wait, :BlockStatus$Issued);

      IF PrevSeq = 0 THEN
         StartOnAny = 0;
         FIELD(StartOnAny).CurBias = FB_DIMMED;
      ELSE
/*
** "Start .." flag does not apply to the block that has multiple blocks prior to it or the block 
** that has an SSO order as the prior block.
*/
         i = 0;
         PrevSendTo = '';

         SELECT :PrevSendTo = SendTo
         FROM    FMS_AutomationBlock 
         WHERE   Card = :Card AND
                 BlockSeq = :PrevSeq AND
                 BlockStatus IN (:BlockStatus$Setup, :BlockStatus$Wait, :BlockStatus$Issued)
         BEGIN
            i = i + 1;
         END;
         IF i > 1 OR PrevSendTo = 'SSO' THEN
            StartOnAny = 0;
            FIELD(StartOnAny).CurBias = FB_DIMMED;
         ENDIF;
      ENDIF;
   ENDIF;
/*
** Don't display this screen for Work Permits to FCR
*/
   IF SendTo = 'FCR' THEN
      CurFrame.SendUserEvent (EventName = 'DirectInsert');
   ENDIF;    
END;


ON Click start_btn =
BEGIN
   InsertandStart = TRUE;
   CurFrame.SendUserEvent (EventName = 'DirectInsert');
END;


ON USEREVENT 'DirectInsert',
ON CLICK OK_btn = 
BEGIN
/*
** determine the division by finding the substation the feeder belongs to. If it is an ISO 
** feeder, we need to trace to the base feeder.
*/
   PrimaryGrouping = 0;
   Feeder = 0;
   FeederType = 0;
   
   SELECT :PrimaryGrouping = O1.PrimaryGrouping,
          :FeederType = O1.Type, 
          :Feeder = O1.Object
   FROM   TFMS_CardToObject CTO,
          Udb_Object O1,
          Udb_Object O2,
          Udb_ExtendedType ET
   WHERE  CTO.Card = :Card AND
          CTO.Object = O1.Object AND
          O1.PrimaryGrouping = O2.Object AND
          O2.Type = ET.Type AND
          ET.SuperType = :Type$Substation;

   IF FeederType = Type$ISOFeeder THEN

      WHILE FeederType = Type$ISOFeeder DO
         SELECT :Feeder = G.Grouping,
                :FeederType = G.GroupingType 
         FROM   UDB_Grouping G
         WHERE  G.Member = :Feeder AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder);
      ENDWHILE;

      SELECT :PrimaryGrouping = O.PrimaryGrouping
      FROM   Udb_Object O
      WHERE  O.Object = :Feeder;
   ENDIF;

   IF PrimaryGrouping > 0 THEN
      SELECT :Division = G.Grouping
      FROM   UDB_Grouping G
      WHERE  G.Member = :PrimaryGrouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division;
   ENDIF;    

   RetCode = CALLPROC FMS_AutoBlockIns (
       Card = Card,
       Block = Block,
       BlockSeq = NextSeq,
       SendTo = SendTo,
       InitiatingDO = DOp.Object,
       InitTime = 'now',
       BlockTitle = BlockTitle,
       BlockStatus = BlockStatus$SetUp, 
       StartOnAny = StartOnAny,
       StartOnDBF = only_4kv.StartOnDBF,
       Division = Division);      
   
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE 
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to save Automation Block due to an error.  ' +
              'Try again or contact Technical Support.';
      RESUME;
   ENDIF;

   IF InsertandStart = FALSE THEN
      RETURN;
   ELSE
/*
** Start Execution and continue setup mode
*/
      IF CurFrame.ConfirmPopup (MessageText = 'Starting Automatic Execution...') =
           PU_CANCEL THEN
         RETURN;
      ENDIF;

      RetCode = CALLPROC FMS_CardAutoExecution (
                  Card = Card,
                  ProcessAutoExecution = Automation$Go);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error starting automated execution. Try starting from card or ' +
                 'contact technical support.';
         RETURN;
      ENDIF;

      RetCode = CALLPROC FMS_AutoControlIns (
                 Card = Card,
                 AutomationSequence = 0,
                 Action = 'ISSUE');
                 
      IF RetCode <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error inserting automation control entry to start execution. ' +
                 'Try stopping and starting again from card or ' +
                 'contact technical support.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
      FCFrame.SendUserEvent (EventName = 'CheckPA');
      RETURN;
   ENDIF;
END;   

  
ON CLICK cancel_btn = 
BEGIN
   IF CurFrame.ConfirmPopup (messagetext = 
          'Exit without saving this automation block?') = PU_OK THEN
      RETURN;
   ENDIF;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;
					 *Default Item


Application Component Report
============================

	Name:            DeloadTrace33kV

/* 
**      Copyright c 2016 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software LLC proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          DeloadTrace33kV
**
**  Date:    Author   Description
** ----------------------------------
**  04/28/16 em       Created to identify isolated segments from interruptor switch that
**                    is being opened.  When reaching a CutOut source I assume isolation
**                    already exists unless I have crossed over a segment that is being
**                    FedBy a feeder.
**  09/13/16 em       Enable trace for multi-terminal source segment
**  09/07/18 em       Being called incorrectly for StepDown feeder.  If device not connected at all, exit gracefully
*/
PROCEDURE DeloadTrace33kV
(
   StartEquip = INTEGER NOT NULL;  /*Parameter - Starting interruptor switch*/
   FeederSegments = ARRAY OF INTEGEROBJECT; /*Out parameter*/ 
   SourceSegmentOption = INTEGER NOT NULL WITH DEFAULT; /* Optional In Parameter*/
) = 
DECLARE
   i = INTEGER;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER;
   x = INTEGER;
   ConnectedTerminals = INTEGER NOT NULL WITH DEFAULT; 

   RetCode = INTEGER;
   CurrentlyOpen = INTEGER NOT NULL;
   PendingOpen = INTEGER NOT NULL;
   PendingClosed = INTEGER NOT NULL;
   NormalOpen = INTEGER NOT NULL;
   MoreObjects = INTEGER NOT NULL WITH DEFAULT;                            
   NotIsolated = INTEGER NOT NULL WITH DEFAULT;
   FedByExists = INTEGER NOT NULL WITH DEFAULT;
   CutOutSourceReached = INTEGER NOT NULL WITH DEFAULT;
   
   StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;

   ExcludedNodes   = Array of IntegerObject;
   IncludedObjects = Array of IntegerObject;
   FeederSegmentTypes  = ARRAY OF INTEGEROBJECT; /* feeder segment device types*/   

   ConnectedEquip = ARRAY OF ConnectedEquipClass;
   FeederPortionList = ARRAY OF ConnectedEquipClass;
   FloatEquip = ConnectedEquipClass;   
   TempEquip = ARRAY OF ConnectedEquipClass;
   TempFeeder = ConnectedEquipClass;
ENDDECLARE
BEGIN
   FeederSegmentTypes.Clear();
   i = 1;
   SELECT :FeederSegmentTypes[i].Value = Type
   FROM   UDB_ExtendedType
   WHERE  SuperType = :Type$33KVPortion
   BEGIN
      i = i + 1;
   END;
/*
** Our starting point is expected to be an interruptor switch connected
** at both terminals. If we don't have that we back out with user error.
*/   
   ConnectedEquip.Clear();
   REPEATED
   SELECT :ConnectedEquip[1].Object = O.Object,
          :ConnectedEquip[1].Type = O.Type,
          :ConnectedEquip[1].Name = O.Name,
          :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
          :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName,
          :ConnectedEquip[1].Validated = O.Validated,
          :ConnectedEquip[1].ValidatedBy = O.ValidatedBy,
          :ConnectedEquip[1].Terminals = O.Terminals
   FROM   Udb_Object O,
          Udb_Terminal T
   WHERE  O.Object = :StartEquip AND
          O.Object = T.Object AND
          T.Node >= 20000;
   CALLPROC DDB_ROLLBACK;
/*
**  Exit gracefully if not connected.
*/
   IF ConnectedEquip.LastRow = 0 THEN
      RETURN PU_OK;
   ENDIF;
   ConnectedTerminals = ConnectedEquip[1].Terminals;
   FeederPortionList.Clear();
   IF SourceSegmentOption = FALSE AND ConnectedTerminals <> 2 THEN
      CALLPROC TraceError (UserMessage =
                      'ERROR: Sectionalized Feeder Network Connectivity error. ' + 
                      'Interruptor Switch does not have two terminals. ' +
                      'CheckDeloadComplete fails.', 
                           TraceMessage =
                      'DeloadTrace33kV: ' +
                      'Sectionalized Feeder Network Connectivity error at ' + 
                      'Interruptor Switch does not have two termianls. ' +
                      'CheckDeloadComplete fails at Object = ' + VARCHAR(StartEquip) ); 
      RETURN(PU_CANCEL);
   ELSEIF SourceSegmentOption = TRUE THEN
      FeederPortionList.InsertRow (rownumber = 1);
      FeederPortionList[1] = ConnectedEquip[1].Duplicate();
   ENDIF;

   NotIsolated = FALSE;
   FedByExists = FALSE;
   CutOutSourceReached = FALSE;

   FOR j = 1 TO ConnectedTerminals DO  /* Do each terminal separately, only one side can be new isolation */
     ConnectedEquip.Clear();
     IF SourceSegmentOption = FALSE THEN
        NotIsolated = FALSE;
        FedByExists = FALSE;
        CutOutSourceReached = FALSE;
        FeederPortionList.Clear();
     ENDIF;
/*
** Start connectivity tracing. Trace each terminal path separately.
*/ 
     StaticWhereClause = 'T2.Object = O.Object AND ' +
                         'T2.Object <> T1.Object AND ' +
                         'T2.Node > 20000 AND ' +
                         'T1.Node = T2.Node AND ' +
                         'T1.Node > 20000 AND ';

     DynamicWhereClause = StaticWhereClause + 'T1.Object = ' + VARCHAR(StartEquip) +
                          ' AND T1.Terminal = ' + VARCHAR(j);
/*
** start search on a single terminal then branch out in all
** directions. For every connected Switch, check for open close status.
** If open stop trace on this leg or pending open.  Keep trace of feeders encountered.
*/
     FloatEquip = NULL;
     MoreObjects = TRUE;

     WHILE MoreObjects = TRUE DO
      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */
      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object,
             :TempEquip[x].Validated = O.Validated,
             :TempEquip[x].ValidatedBy = O.ValidatedBy
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
         CALLPROC InsertValue (ValueList = ExcludedNodes, 
                               Value = TempEquip[x].Node);
         x = x + 1;
      END;            

      MoreObjects = FALSE;
      /* 
      ** If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO
         IF ConnectedEquip[x].Used = FALSE THEN
            RetCode = TempEquip.Find(AttributeName = 'PrevObject',
                                     Value = ConnectedEquip[x].Object);

            IF RetCode = ER_ROWNOTFOUND THEN
               IF ConnectedEquip[x].Terminals = 1 THEN                 
                  /* OK if single terminal device */
               ELSE 
                  FloatEquip = ConnectedEquip[x];     
               ENDIF;
            ENDIF;

            ConnectedEquip[x].Used = TRUE;
         ENDIF;
         x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     
      x = 1;
      WHILE x <= TempEquip.LastRow() AND NotIsolated = FALSE DO
         /* eliminate same piece of equipment which has already been checked
         */
         RetCode = ConnectedEquip.Find(AttributeName = 'Object',
                                       Value = TempEquip[x].Object,
                                       RowNumber = ByRef(k));
               
         IF RetCode = ER_OK THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  

         ELSE                                    /* new equip */

            i = ConnectedEquip.LastRow + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                                     RowObject = TempEquip[x].Duplicate());

            RetCode = FeederSegmentTypes.Find(AttributeName = 'Value',
                                              Value = TempEquip[x].Type);
            IF RetCode = ER_OK THEN
/*
** Feeder Segment Handling
*/
               FeederPortionList.InsertRow (rownumber = 1);
               FeederPortionList[1] = ConnectedEquip[i].Duplicate();
/*
** Is this segment Fed By a feeder? Only need to identify this once.
*/
               IF FedByExists = FALSE THEN
                  k = 0;
                  SELECT :k = G.Grouping
                  FROM   Udb_Grouping G
                  WHERE  G.Member = :TempEquip[x].Object AND
                         G.Relationship = :Interaction$FedBy;
                  IF k > 0 THEN
                     FedByExists = TRUE;
                  ENDIF;
               ENDIF;
/*
** If it is a source we need to know if the main feeder is cutout.
** If not cutout then this side is energized and no more tracing is needed.
*/
               IF TempEquip[x].Type = Type$SourceSegment THEN
                  k = 0;
                  REPEATED
                  SELECT :k = OS.Object
                  FROM   FMS_ObjectStatus OS,
                         Udb_Grouping G
                  WHERE  G.Member = :TempEquip[x].Object AND
                         G.Relationship = :Interaction$MemberOf AND
                         G.GroupingType = :Type$Feeder AND
                         G.Grouping = OS.Object AND
                         OS.Status = :Status$CO;

                  IF k = 0 THEN   /*Not CutOut, we are energized and can stop tracing this side*/
                     NotIsolated = TRUE;
                  ELSE
                     CutOutSourceReached = TRUE;
                  ENDIF;
               ENDIF;

            ELSE  
/* 
** Not a feeder segment so it must be an interruptor switch.
*/
               SELECT :NormalOpen = NormalOpen,
                      :CurrentlyOpen = CurrentlyOpen
               FROM   Udb_Switch
               WHERE  Object = :TempEquip[x].Object;
/*
** Looking for Pending that would change current status.
*/
               k = 0;
               IF CurrentlyOpen = TRUE THEN
                  SELECT :k = PendingStatus
                  FROM   FMS_PendingStatus 
                  WHERE  Object =  :TempEquip[x].Object AND
                         IssuedOperator = :FO.Object AND
                         PendingStatus = :Status$Closed AND
                         StatusCount > 0;

                  IF k > 0 THEN
                     CurrentlyOpen = FALSE;  /*Going to be closed*/
                  ENDIF;
               ELSE 
                  SELECT :k = PendingStatus
                  FROM   FMS_PendingStatus 
                  WHERE  Object =  :TempEquip[x].Object AND
                         IssuedOperator = :FO.Object AND
                         PendingStatus = :Status$Open AND
                         StatusCount > 0;

                  IF k > 0 THEN
                     CurrentlyOpen = TRUE;  /*Going to be open*/
                  ENDIF;
               ENDIF;
/*
** If Open then we stop trace in this direction
*/
               IF CurrentlyOpen = TRUE THEN
                  ConnectedEquip[i].Used = TRUE;  
               ENDIF; 
            ENDIF;
      
            IF ConnectedEquip[i].Used = FALSE THEN
               CALLPROC InsertValue (ValueList = IncludedObjects, 
                                     Value = ConnectedEquip[i].Object);
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for next round of search 
      */
      IF IncludedObjects.LastRow() > 0 AND NotIsolated = FALSE THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
            IF x = 1 THEN
               DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
            ELSE
               DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
            ENDIF;
            x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;
      /*
      **  We stop search due to a Floating Equip connectivity error.
      */
      IF FloatEquip IS NOT NULL THEN
         MoreObjects = FALSE;
      ENDIF;   
     ENDWHILE;
/* 
**  Give warning if Float equip found 
*/
     IF FloatEquip IS NOT NULL THEN
        CALLPROC TraceError (UserMessage =
                      'ERROR: Sectionalized Feeder Network Connectivity error at ' + 
                        FloatEquip.PrimaryGroupingName + '  ' +
                       FloatEquip.TypeName + '  ' + FloatEquip.Name,
                           TraceMessage =
                      'NetworkFeederTrace: ' +
                      'Sectionalized Feeder Network Connectivity error at ' + 
                        FloatEquip.PrimaryGroupingName + '  ' +
                       FloatEquip.TypeName + '  ' + FloatEquip.Name);
        RETURN(PU_CANCEL);

     ELSEIF NotIsolated = TRUE THEN
        FeederPortionList.Clear();
     ELSE
/*
** We have isolation but if we reached a CutOutSource without crossing a Fed By then
** we are already isolated.
*/      
        IF CutOutSourceReached = TRUE AND FedByExists = FALSE THEN  
           FeederPortionList.Clear();
        ENDIF;
        IF SourceSegmentOption = FALSE THEN
           ENDLOOP;
        ENDIF;
     ENDIF;
   ENDFOR;   
/*
** Take FeederPortionList and move into FeederSegments for return
*/
   FeederSegments.Clear();  
   FOR j = 1 TO FeederPortionList.LastRow() DO
      FeederSegments.InsertRow (rownumber = j);
      FeederSegments[j].Value = FeederPortionList[j].Object;
   ENDFOR;

   RETURN(PU_OK);
END;




Application Component Report
============================

	Name:            Determine3GSource

/*
**  Copyright c 2010 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Determine3GSource
**
**  Modification log:
**
**   04/16/10   em   Created
**   04/22/10   em   Add FeederName field at top of screen.
**   05/19/10   em   3G Switch must be open for selection as source.
**   06/06/10   em   Return Source Breaker and Source Position object.
**                   If we find we already have a Source Substation connection,
**                   we return SB and SP = -1 to indicate that the SB/SP already
**                   exists for the feeder source.
**                   SF = Source Feeder, when we have selected new source from 3G switch
**  06/07/10    em   Just insert SP/SB relationships in this program, not necessary to pass back
**  06/22/10    em   Add NoCancel parameter to prevent cancel when used during configuration processing.
**  09/23/10    em   Need to pass back SB when we know it for CutOut/CutIn status checking
**  11/18/10    em   Fixed issue where wrong feeder equip list was displayed for SP selection
**  01/24/11    em   Return Source Feeder; add NoPrompt optional Parm 
**  03/04/11    em   With the three-way switch being changed to not be a member of all feeders, it
**                   is possible to isolate the 14M02 without it having a open switch.  So we modify the
**                   selection so that it an open switch is not found, the selection list will display 
**                   any switch (namely the closed ones).
**  04/06/11    em   Show Type Name for Source in Substation.
*/
INITIALIZE   
(
    NetworkFeederList = ARRAY OF ConnectedEquipClass;        /*Parameter*/
    SubstationName3G = VARCHAR(40) NOT NULL WITH DEFAULT;    /*Return Parameter*/
    Position3G = VARCHAR(20) NOT NULL WITH DEFAULT;          /*Return Parameter*/
    SB = INTEGER NOT NULL WITH DEFAULT;                      /*Optional Return Parameter*/
    SF = INTEGER NOT NULL WITH DEFAULT;                      /*Optional Return Parameter*/
    SP = INTEGER NOT NULL WITH DEFAULT;                      /*Optional Return Parameter*/
    NoCancel = INTEGER NOT NULL WITH DEFAULT;                /*Optional Input Parameter*/
    NoPrompt = INTEGER NOT NULL WITH DEFAULT;                /*Optional Input Parameter*/

/* local variables */
#   include StandardDeclarations

    AllFeederList = ARRAY OF ConnectedEquipClass;          /*Parameter*/
    DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
    FeederClause = VARCHAR(400) NOT NULL WITH DEFAULT;
    FoundClosed = INTEGER NOT NULL WITH DEFAULT;
    FoundTwo = INTEGER NOT NULL WITH DEFAULT;
    SBFeeder = INTEGER NOT NULL WITH DEFAULT;
    SubstationList = ARRAY OF ObjectSummaryClass;
    k = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
    m = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
    n = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
) =
BEGIN
   SB = 0;
   SF = 0;
   SP = 0;

   IF NoCancel = TRUE THEN
      FIELD(cancel_btn).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** Get a list of substation/source combos that the network feeders belong to.
** Type/TypeName hides the Source Equipment
*/
   FOR i = 1 TO NetworkFeederList.LastRow() DO
       IF i = 1 THEN
          FeederClause = '(' + VARCHAR(NetworkFeederList[i].Object);
          FeederName = NetworkFeederList[i].Name;
       ELSE
          FeederClause = FeederClause + ',' + VARCHAR(NetworkFeederList[i].Object);
          FeederName = FeederName + ',' + NetworkFeederList[i].Name;
       ENDIF;
   ENDFOR;
   FeederClause = FeederClause + ')';
   DynamicWhereClause =  'O2.Object IN ' + FeederClause + ' AND ' + 
                         'O2.PrimaryGrouping = O.Object AND ' +
                         'O.Type = ' + VARCHAR(Type$Substation) + ' AND ' +
                         'O2.Object = G.Grouping AND ' +
                         'G.Relationship = ' + VARCHAR(Interaction$SourceBreaker) + ' AND ' +
                         'G.Member = O3.Object';
          
   SubstationList.Clear();
   i = 1;
   SELECT DISTINCT 
           :SubstationList[i].Object = O.Object,
           :SubstationList[i].Name = O.Description, 
           :SubstationList[i].Type = O3.Object,
           :SubstationList[i].TypeName = O3.Name,
           :SubstationList[i].PrimaryGroupingName = O3.TypeName,
           :SubstationList[i].PrimaryGrouping = O2.Object
   FROM    Udb_Grouping G,
           Udb_Object O,
           Udb_Object O2,
           Udb_Object O3
   WHERE   :DynamicWhereClause
   BEGIN
      i = i + 1;
   END;
/*
** If there is only one, then we'll use it.
*/
   IF SubstationList.LastRow = 1 THEN
      SubstationName3G = SubstationList[1].Name;
      Position3G = SubstationList[1].TypeName;
      SB = SubstationList[1].Type;
      SF = SubstationList[1].PrimaryGrouping;
      SP = -1;
      RETURN(PU_OK);
   ENDIF;
/*
** If there is more than one (shouldn't be more than two), evaluate each one for closed device.
** If both open or closed then display for selection.
*/
   IF SubstationList.LastRow > 1 THEN
      FoundTwo = FALSE;
      FoundClosed = 0;
      FOR i = 1 TO SubstationList.LastRow() DO
         k = 1;
         SELECT :k = CurrentlyOpen
         FROM   Udb_Switch
         WHERE  Object = :SubstationList[i].Type;

         IF k = 0 THEN  /*closed*/
            IF FoundClosed <> 0 THEN
               FoundTwo = TRUE;
            ELSE    
               FoundClosed = i;
            ENDIF;
         ENDIF;

         SelectSource[i].PrimaryGroupingName = SubstationList[i].Name;
         SelectSource[i].TypeName = SubstationList[i].PrimaryGroupingName;
         SelectSource[i].Name = SubstationList[i].TypeName;
         SelectSource[i].Object = SubstationList[i].Type;
      ENDFOR;

      IF FoundTwo = FALSE AND FoundClosed <> 0 THEN
         SubstationName3G = SubstationList[FoundClosed].Name;
         Position3G = SubstationList[FoundClosed].TypeName;
         SB = SubstationList[FoundClosed].Type;
         SF = SubstationList[FoundClosed].PrimaryGrouping;
         SP = -1;
         RETURN(PU_OK);
      ENDIF;   

      FIELD(SelectSub).ParentField.CurBias = FB_INVISIBLE;
  ENDIF;

  IF NoPrompt = TRUE THEN
     RETURN(PU_CANCEL);
  ENDIF;

/*
** If there are no substations, then we must present 3G Switches for Selection and also find a Substation.
*/
   IF SubstationList.LastRow = 0 THEN
       FIELD(SelectSource.PrimaryGroupingName).CurBias = FB_INVISIBLE;
       FIELD(Selected2.PrimaryGroupingName).CurBias = FB_INVISIBLE;
       
       DynamicWhereClause = 'G.Grouping IN ' + FeederClause + ' AND ' +
                            'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                            'G.Member = O.Object AND ' +
                            'O.Type = ' + VARCHAR(Type$3GSwitch) + ' AND ' +
                            'O.Object = S.Object AND ' +
                            'S.CurrentlyOpen = 1'; 

       SelectSource.Clear();
       i = 1;
       SELECT DISTINCT    
              :SelectSource[i].Name = O.Name,
              :SelectSource[i].TypeName = O.TypeName,
              :SelectSource[i].Object = O.Object
       FROM   Udb_Object O,
              Udb_Grouping G,
              Udb_Switch S
       WHERE  :DynamicWhereClause
       BEGIN
          i = i + 1;
       END;
/*
** If no open 3G switches are found, then we look for any 3G switch.
*/
       IF SelectSource.LastRow = 0 THEN

       DynamicWhereClause = 'G.Grouping IN ' + FeederClause + ' AND ' +
                            'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                            'G.Member = O.Object AND ' +
                            'O.Type = ' + VARCHAR(Type$3GSwitch) + ' AND ' +
                            'O.Object = S.Object';

       SelectSource.Clear();
       i = 1;
       SELECT DISTINCT    
              :SelectSource[i].Name = O.Name,
              :SelectSource[i].TypeName = O.TypeName,
              :SelectSource[i].Object = O.Object
       FROM   Udb_Object O,
              Udb_Grouping G,
              Udb_Switch S
       WHERE  :DynamicWhereClause
       BEGIN
          i = i + 1;
       END;

       ENDIF;
/*
** If we can't present a 3G switch for selection as source, then we have a problem.
*/
       IF SelectSource.LastRow = 0 THEN
          MESSAGE 'Database Setup problem.  Did not find any substation breaker or 3G switch that could be ' +
                  'used as a source for a 3G card.';
          RETURN(PU_CANCEL);
       ENDIF;

       RetCode = CALLPROC NetworkFeederTrace (
                           StartFeeder = NetworkFeederList[1].Object,  /*Start start with any feeder*/
                           NetworkFeederList = AllFeederList,
                           GetAll = TRUE);
       IF RetCode = PU_CANCEL THEN
          MESSAGE 'Not able to determine source for card.';
          IF NoCancel = TRUE  THEN
             RETURN(PU_OK);
          ELSE
             RETURN(PU_CANCEL);
          ENDIF;
       ENDIF;
/*
** Rebuild Feeder Clause to use all feeders to find a substation.
*/
       FOR i = 1 TO AllFeederList.LastRow() DO
          IF i = 1 THEN
             FeederClause = '(' + VARCHAR(AllFeederList[i].Object);
          ELSE
             FeederClause = FeederClause + ',' + VARCHAR(AllFeederList[i].Object);
          ENDIF;
       ENDFOR;
       FeederClause = FeederClause + ')';

       DynamicWhereClause =  'G.Member IN ' + FeederClause + ' AND ' + 
                             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                             'G.Grouping = O.Object AND ' +
                             'O.Type = ' + VARCHAR(Type$Substation);

       SelectSub.Clear();
       i = 1;
       SELECT DISTINCT    
              :SelectSub[i].Name = O.Description
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  :DynamicWhereClause
       BEGIN
          i = i + 1;
       END;

       IF SelectSub.LastRow() = 1 THEN
          Selected.Name = SelectSub[1].Name;
          FIELD(SelectSub).CurBias = FB_VISIBLE;
       ENDIF;
   ENDIF;
END;
 

ON CHILDENTRY SelectSub =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   Selected.Name = SelectSub[].Name;
END;

ON CHILDENTRY SelectSource =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   Selected2.PrimaryGroupingName = SelectSource[].PrimaryGroupingName;
   Selected2.Name = SelectSource[].Name;
   Selected2.TypeName = SelectSource[].TypeName;
   Selected2.Object = SelectSource[].Object;
END;
   
ON CLICK OK_btn =
BEGIN
   IF FIELD(SelectSub).ParentField.CurBias = FB_INVISIBLE THEN
      IF Selected2.Name = '' THEN
         MESSAGE 'Please Select the Source for the 3G Network Feeder Card.';
         RESUME;
      ELSE
         SubstationName3G = Selected2.PrimaryGroupingName;
         Position3G = Selected2.Name;
         SB = Selected2.Object;
      ENDIF;
   ELSE
      IF Selected2.Name = '' OR Selected.Name = '' THEN
         MESSAGE 'Please Select the Substation and the Source for the 3G Network Feeder Card.';
         RESUME;
      ELSE
         SubstationName3G = Selected.Name;
         Position3G = Selected2.Name;
         SB = Selected2.Object;
      ENDIF;
   ENDIF;
/*
** If SB is a Source Breaker for a Feeder, then we check if same feeder already has SP.
** IF we need to select an SP, then we reload 
** array and enable SP OK button.
*/
   SP = 0;
   SF = 0;
   SBFeeder = 0;
   SELECT  :SBFeeder = Grouping
   FROM    Udb_Grouping
   WHERE   Member = :SB AND
           Relationship = :Interaction$SourceBreaker;
   
   IF SBFeeder <> 0 THEN
      SELECT  :SP = Member
      FROM    Udb_Grouping
      WHERE   Grouping = :SBFeeder AND
              Relationship = :Interaction$SourcePosition;
      IF SP = 0 THEN
         SF = SBFeeder;
      ENDIF;
   ENDIF;
        
   IF SB > 0 AND SP > 0 THEN
      RETURN(PU_OK);
   ELSEIF SB > 0 AND SP = 0 THEN
/*
** We have Source Breaker, get the Source Position from the equipment for the same feeder.
*/
      IF SBFeeder <> 0 THEN
         SF = SBFeeder;      /* Actually this should already be set. */
      ENDIF;
   ENDIF;

   IF SBFeeder = 0 THEN
/*
** We have selected Source Breaker, get the Source Position from the equipment for the feeder
** where this equip appears.
*/
      SF = 0;
      SELECT :SBFeeder = Grouping
      FROM   Udb_Grouping
      WHERE  Member = :SB AND
             Relationship = :Interaction$MemberOf AND
             GroupingType = :Type$Feeder
      BEGIN
         FOR i = 1 TO NetworkFeederList.LastRow() DO
            IF SBFeeder = NetworkFeederList[i].Object AND SF = 0 THEN
               SF = SBFeeder;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      END;
   ENDIF;

   SelectSource.Clear();
   i = 1;
   SELECT DISTINCT    
              :SelectSource[i].PrimaryGroupingName = O.PrimaryGroupingName,
              :SelectSource[i].TypeName = O.TypeName,
              :SelectSource[i].Name = O.Name,
              :SelectSource[i].Object = O.Object
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :SF AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE SuperTYpe = :Type$Switch) AND
              G.Member = O.Object
   BEGIN
      i = i + 1;
   END;

   FIELD(hdr_text).TextValue = 'Now Select the Source Position for the new card to control Feeder Ground status.';
   FIELD(OK_btn).CurBias = FB_INVISIBLE;
   FIELD(SP_Btn).CurBias = FB_LANDABLE;
   FIELD(SelectSub).ParentField.CurBias = FB_INVISIBLE;
END;

ON CLICK SP_btn =
BEGIN
   IF Selected2.Name = '' THEN
         MESSAGE 'Please Select the Source Position for the 3G Network Feeder Card.';
         RESUME;
   ELSE
         SP = Selected2.Object
   ENDIF;

   IF SB > 0 THEN
/*
** Confirm that it doesn't already exist
*/ 
      SBFeeder = 0;
      SELECT  :SBFeeder = Grouping
      FROM    Udb_Grouping
      WHERE   Member = :SB AND
              Relationship = :Interaction$SourceBreaker AND
              Grouping = :SF;

      IF SBFeeder = 0 THEN
         RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = SF,
                                GroupingType = Type$Feeder,
                                Member = SB,
                                MemberType = 0,
                                Relationship = Interaction$SourceBreaker,
                                Reference = '');
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Error occurred inserted Source Breaker for 3G Feeder.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF; 

   IF SP > 0 THEN
      RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = SF,
                                GroupingType = Type$Feeder,
                                Member = SP,
                                MemberType = 0,
                                Relationship = Interaction$SourcePosition,
                                Reference = '');
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error occurred inserted Source Position for 3G Feeder.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF; 
   RETURN(PU_OK);
END;



ON CLICK Cancel_btn =
BEGIN
   RETURN(PU_CANCEL);
END;


ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

