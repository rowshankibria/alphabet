Application Component Report
============================

	Name:            FMS_ManageCardHeader

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
*/
/*
**  Application:    CAC
**  Frame:          FMS_ManageCardHeader
**
**  Modifications:
**  04/11/96  tp     Created
**  05/13/96  em     Debugging
**  12/13/96  em     During equip transfer, old card that no longer has the grounded 
**                   device needs to be managed.  Add Feeder
**                   Parameter, If feeder parameter set, just deal with that feeder and
**                   ignore equipment parameter.  If feeder not set, use equipment 
**                   parameter to determine feeders to touch.  Change related to FMS 
**                   only - will not hurt SLC or TFMS.
**  12/30/02  ysp    Log card's station grounds after updates to feeder station ground.
**  02/12/04  em     Process Automation, send messages to the Trace window
**  04/16/04  em     Test Connected Source Breaker...TEMPORARY
**                      Don't use connectivity in this procedure.
**                      Disable Next Equip link and go with state of Source Position
**                      Equipment only.
**  03/06/06  em     If Connectivity Trace is Enabled , then use ConnectSourceTrace
**                   logic for determining Station Ground and Feeder Ground Count.
**  10/21/10  em     Need to know if we are handling a feeder on a 3G card so all feeders can be
**                   included for the ground count.
**  01/20/11  em     Source Position length increased to 20
**  01/25/11  em     If Feeder Ground Count has not changed and we are on 3G, we still 
**                   want to trigger fms_objectstatus update because we may be initializing
**                   the card header on a newly configured card
**  07/26/13  pkw    Check for StepDown feeders when setting Station Ground Status.
**  04/21/16  em     33kV Feeder Ground Count and Station Ground Implementation, using 
**                   same logic as for 3G by including Udb_ExtendedType on Type$Feeder lookups
**  05/04/16  em     Exclude 33kV Feeder segments that have a fed by relationship, don't count grounds on
**                   fed by feeders either.
**  05/26/16  em     33kV Don't remove Source Position relationship here, do it on Configuration screen when
**                   segment removed from portion feeder.
**  06/01/16  em     Modify handling if FedBy feeder so that fedby feeder counts on card where it is fed
**  06/29/16  em     On 33kV, allow Source Position to be set when feeder ground count >= 1
*/
PROCEDURE FMS_ManageCardHeader
(
    Equip          = INTEGER NOT NULL;                   /* Passed Equip */
    OptionalFeeder = INTEGER NOT NULL WITH DEFAULT;      /* Passed Feeder - Optional */ 

    g              = INTEGER NOT NULL WITH DEFAULT;
    i              = INTEGER NOT NULL WITH DEFAULT;
    k              = INTEGER NOT NULL WITH DEFAULT;
    x              = INTEGER NOT NULL WITH DEFAULT;
    RetCode        = INTEGER NOT NULL WITH DEFAULT;

    Current_Card   = INTEGER NOT NULL WITH DEFAULT;
    Current_Equip   = INTEGER;
    Current_Feeder   = INTEGER NOT NULL WITH DEFAULT;
    Current_TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
    Current_Mode   = INTEGER NOT NULL WITH DEFAULT;
    Current_Position = VARCHAR(20) NOT NULL WITH DEFAULT; 
    Equip_Gnd      = INTEGER NOT NULL WITH DEFAULT;
    Equip_GndCnt   = INTEGER NOT NULL WITH DEFAULT;
    FedByFeeder    = INTEGER NOT NULL WITH DEFAULT;
    Feeder_Array   = ARRAY OF INTEGEROBJECT;
    FeederGndCnt   = INTEGER NOT NULL WITH DEFAULT;
    Feeder_GndDec  = INTEGER NOT NULL WITH DEFAULT;
    FeederName     = VARCHAR(40) NOT NULL WITH DEFAULT;
    FeederGroundCount = INTEGER WITH NULL;
    FeederStationGround = INTEGER NOT NULL WITH DEFAULT;
    Feeder3G       = ARRAY OF ObjectSummaryClass; 
    NetworkFeeder  = INTEGER NOT NULL WITH DEFAULT;
    NextEquip      = INTEGER WITH NULL;
    OC_Status      = INTEGER NOT NULL WITH DEFAULT;
    SaveFeederGndCnt   = INTEGER NOT NULL WITH DEFAULT;
    Source3GFeeder = INTEGER NOT NULL WITH DEFAULT;
    StaGnd         = INTEGER WITH NULL;
    StationGround  = CHAR(3) NOT NULL WITH DEFAULT; 
    Term2Gnd       = INTEGER NOT NULL WITH DEFAULT;
    TraceEnabled   = INTEGER NOT NULL WITH DEFAULT;
    SDFeeders = INTEGEROBJECT;
) =

BEGIN
/*
**  If Feeder is passed, just act upon it and ignore equipment,
**  else act upon all feeders to which equip is common.
**  If on a 3G card, we assume equipment is not common to another feeder
**  and we only handle that card.  Ground should not be placed on a 3G Switch.
**  On 33kV, Ground might be placed on interruptor switch and we ignore terminal.
*/
    i = 1;
    Feeder_Array.Clear();
    IF OptionalFeeder > 0 THEN
        Feeder_Array[i].Value = OptionalFeeder;
    ELSE
        REPEATED
        SELECT DISTINCT 
              :Feeder_Array[i].Value = G.Grouping
        FROM  UDB_Grouping G, 
              UDB_ExtendedType ET
        WHERE G.Member = :Equip AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = ET.Type AND
              ET.SuperType = :Type$Feeder 
        BEGIN
              i = i + 1;
        END;
    ENDIF;
/*
**  Code to handle Feeder Ground Count and Station Ground status.
*/
    i = 1;
    WHILE ( i <= Feeder_Array.LastRow() ) DO 

        Current_Card = 0;
        FeederGndCnt = 0;
        NetworkFeeder = FALSE;
        Feeder3G.Clear();
        Current_Feeder = Feeder_Array[i].Value;
/*
**  If feeder fed by another, get feeder ground to include count on other feeder and 
**  switch to other feeder card.
*/  
        FedByFeeder = 0;
        SELECT :FedByFeeder = Grouping
        FROM   Udb_Grouping
        WHERE  Member = :Current_Feeder AND
               Relationship = :Interaction$FedBy;

        IF FedByFeeder <> 0 THEN
            Equip_GndCnt = 0;
            REPEATED
            SELECT DISTINCT
                  :x = OS.Object,
                  :Equip_GndCnt = IFNULL(SUM(OS.StatusCount),0)
            FROM   Udb_Grouping G, 
                  FMS_ObjectStatus OS
            WHERE G.Grouping = :Current_Feeder AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Member = OS.Object AND
                  OS.Status = :Status$Ground  
            GROUP BY OS.Object
            BEGIN
               FeederGndCnt = FeederGndCnt + Equip_GndCnt;
            END;
            Current_Feeder = FedByFeeder; 
        ENDIF;

        REPEATED
        SELECT :Current_Card = AO.Card,
               :NetworkFeeder = C.NetworkFeeder,
               :Current_Position = C.Position,
               :Current_TypeOfCard = C.TypeOfCard
        FROM   SOA_ActiveObject AO,
               FMS_Card C
        WHERE  AO.Object = :Current_Feeder AND
               AO.Card = C.Card;
        /*
        ** If 27kV card is linked to 4kV StepDown feeder, add 4kV feeder to list
        ** so status gets updated on both cards.  Only add card if SD-VIS is
        ** closed.  Don't look at 27 kV if we are setting station ground on 4kV.  
        ** Only downstream.
        */
        IF Current_TypeOfCard <> TypeOfCard$4KV THEN
            SDFeeders = NULL;
            SDFeeders = IntegerObject.Create();
            REPEATED
            SELECT DISTINCT
                  :SDFeeders.Value = CTO.Object
            FROM    FMS_StepDownLink L,
                   Udb_Switch S,
                   Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   FMS_Card C
            WHERE   L.Card = :Current_Card AND
                   L.StepDownCard = C.Card AND
                   C.Card = CTO.Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = :Type$SDVIS AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = 0
            BEGIN
                x = 1;
                WHILE x <= Feeder_Array.LastRow DO
                    IF Feeder_Array[x].Value = SDFeeders.Value THEN
                        ENDLOOP;
                    ENDIF;
                    x = x + 1;
                ENDWHILE;
                IF x > Feeder_Array.LastRow THEN
                    Feeder_Array[x] = SDFeeders.Duplicate();
                ENDIF;
            END;      
        ENDIF;  
/* 
**  3G logic added has to go back to determine if any feeder is in a
**  station and also (if two are in station) which one is considered the source. 
*/
        IF NetworkFeeder <> 0 THEN  /*3G and 33kV*/
/*
**  If NetworkFeeder, then we cumulate grounds for all feeders on card excluding feeders fed by another.
*/   
            Equip_GndCnt = 0;
            REPEATED
            SELECT DISTINCT
                  :x = OS.Object,
                  :Equip_GndCnt = IFNULL(SUM(OS.StatusCount),0)
            FROM   Udb_Grouping G, 
                  FMS_ObjectStatus OS,
                  TFMS_CardToObject CTO,
                  Udb_ExtendedType ET
            WHERE CTO.Card = :Current_Card AND
                  CTO.Type = ET.Type AND  
                  ET.SuperType = :Type$Feeder AND
                  CTO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Member = OS.Object AND
                  OS.Status = :Status$Ground AND
                  G.Grouping NOT IN (SELECT GG.Member FROM Udb_Grouping GG
                                     WHERE  GG.Member = G.Grouping AND
                                            GG.Relationship = :Interaction$FedBy) 
            GROUP BY OS.Object
            BEGIN
               FeederGndCnt = FeederGndCnt + Equip_GndCnt;
            END;
/*
** Load the network feeders on this card, same Grounds status count will be applied to each
*/
            Source3GFeeder = 0;
            g = Feeder3G.Lastrow() + 1;   
            REPEATED     
            SELECT :Feeder3G[g].Object = O.Object,
                   :Feeder3G[g].PrimaryGrouping = O.PrimaryGrouping
            FROM   TFMS_CardToObject CTO,
                   Udb_Object O,
                   Udb_ExtendedType ET
            WHERE  CTO.Card = :Current_Card AND
                   CTO.Type = ET.Type AND
                   ET.SuperType = :Type$Feeder AND
                   CTO.Object = O.Object 
            BEGIN
/*
** We want to remove other feeders on the 3G card that might be in the Feeder Array so that we only process 3G card once.
*/
              k = i + 1;
              WHILE k <= Feeder_Array.LastRow() DO
                 IF Feeder3G[g].Object = Feeder_Array[k].Value THEN
                    Feeder_Array.RemoveRow (RowNumber = k);
                    ENDLOOP;
                 ENDIF;
                 k = k + 1;
              ENDWHILE;
/*
** If Primary Grouping is a Substation then this feeder might be the source.
** (Two feeders could be primary grouped with substation if 3G is connected all around.)
*/
              IF Source3GFeeder = 0 THEN
                 SELECT :Source3GFeeder = Object
                 FROM   Udb_Object 
                 WHERE  Object = :Feeder3G[g].PrimaryGrouping AND
                        Type = :Type$Substation;
/*
** We can confirm the 3G Source Feeder based on the Source Breaker device name in the Position
** field of the card.  Hopefully this logic works if two 3G feeders on the card are connected to a station. 
*/
                 IF Source3GFeeder <> 0 THEN
                    x = 0;
                    REPEATED
                    SELECT :x = G.Member
                    FROM   Udb_Object O,
                           Udb_Grouping G
                    WHERE  G.Grouping = :Feeder3G[g].Object AND
                           G.Relationship = :Interaction$SourceBreaker AND
                           G.Member = O.Object AND
                           O.Name = :Current_Position;

                    IF x = 0 THEN
                       Source3GFeeder = 0;
                    ELSE
                       Source3GFeeder = Feeder3G[g].Object;
                    ENDIF;
                 ENDIF;
              ENDIF;
              g = g + 1;
            END;
/*
**  If 3G Feeder is not connected to Source Substation, then we need to determine Source Position
**  from the remote feeders.
*/
            IF Source3GFeeder = 0 THEN
              SELECT :Source3GFeeder = CTO.Object 
              FROM   TFMS_CardToObject CTO,
                     Udb_Grouping G
              WHERE  CTO.Card = :Current_Card AND
                     CTO.Object = G.Grouping AND
                     G.Relationship = :Interaction$SourcePosition;
/* 
** If still 0, then 3G not setup properly, while 33kV segment card might not yet have a SP.
*/        
              IF Source3GFeeder = 0 THEN         
/*
** On 3G we have to do something so we just say the source is the current feeder 
*/
                 Source3GFeeder = Current_Feeder;
/*
** On 33kV we look at the Equip and see if it has a ground, if it is the only one on feeder,
** we make it the Source Position 
*/
                 IF NetworkFeeder = NetworkFeeder$33kV THEN
                    Source3GFeeder = 0;
                    Equip_GndCnt = 0;
                    SELECT :Equip_GndCnt = IFNULL(StatusCount,0)
                    FROM   FMS_ObjectStatus
                    WHERE  Object = :Equip AND
                           Status = :Status$Ground AND
                           StatusCount > 0;

                    IF Equip_GndCnt = 1 AND FeederGndCnt >= Equip_GndCnt THEN
/* 
** We know the equipment is a member of one feeder segment selected at the top of the frame.
*/                      
                       Source3GFeeder = Feeder_Array[1].Value;
                       RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = Feeder_Array[1].Value, 
                                GroupingType = 0,
                                Member = Equip,
                                MemberType = 0,
                                Relationship = Interaction$SourcePosition);
                       IF ( RetCode < 0 ) THEN
                          CALLPROC DDB_ROLLBACK;
                          CALLPROC TraceError (UserMessage = 
                             'ERROR: Unable to create Source Position for Feeder Portion. Please report to tech support.',
                           TraceMessage =
                             'Procedure:FMS_ManageCardHeaderSP; ' +
                             'Unable to establish Source Position for Feeder Portion ID ' + 
                             VARCHAR(Source3GFeeder) );
                       ELSE
                          CALLPROC DDB_COMMIT;
                          Source3GFeeder = Feeder_Array[1].Value;
                       ENDIF;
                    ENDIF;
                 ENDIF;
              ENDIF;
            ENDIF;
            Current_Feeder = Source3GFeeder;

        ELSE
/*
**  Count ALL grounds for equipment that's a "Member of" current feeder. 
*/   
           REPEATED
           SELECT :FeederGndCnt = IFNULL(SUM(OS.StatusCount),0)
           FROM   Udb_Grouping G, 
                  FMS_ObjectStatus OS
           WHERE  G.Grouping = :Current_Feeder AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Member = OS.Object AND
                  OS.Status = :Status$Ground;
        ENDIF;
        SaveFeederGndCnt = FeederGndCnt;

        TraceEnabled = 0;
        SELECT :TraceEnabled = Feeder
        FROM   FMS_ConnectedSource
        WHERE  Feeder = :Current_Feeder;
/*
** Do old station ground logic if trace not enabled.  
*/
        IF TraceEnabled = 0 AND Current_Feeder <> 0 THEN
/* 
**  Start at the Source Position for the current feeder. 
*/
            Current_Equip = NULL;
            SELECT :Current_Equip = Member
            FROM   Udb_Grouping G
            WHERE  G.Grouping = :Current_Feeder AND
                   G.Relationship = :Interaction$SourcePosition;
/* 
**  Initialize variables. 
*/
            Feeder_GndDec = 0; /* Ground count adjustment counter */
            Current_Mode = 0;  /* Check mode */
            StaGnd = NULL;     /* Station Ground status */
/* 
**  Trace connectivity toward Bus while equipment is still part of feeder. 
**  On a network feeder where SP does not have connectivity, ground status of SP equipment 
**  is all that matters.
*/
            WHILE ( Current_Equip IS NOT NULL ) DO

                IF ( Current_Mode = 0 )  THEN/* Check mode */

                /* Check open/closed status for equipment */
                    OC_Status = 0;
                    SELECT :OC_Status = CurrentlyOpen
                    FROM Udb_Switch S
                    WHERE S.Object = :Current_Equip;

                /* If equipment is currently open */
                    IF ( OC_Status = 1 ) THEN
                        Current_Mode = 1; /* Switch to Count mode */
                        /* Sum grounds on Bus side of open */
                        SELECT :Feeder_GndDec = IFNULL(SUM(OS.StatusCount),0)
                        FROM FMS_ObjectStatus OS
                        WHERE OS.Object = :Current_Equip AND
                          OS.Terminal = 1 AND
                          OS.Status = :Status$Ground;
                    ENDIF;

                    IF ( StaGnd IS NULL ) THEN /* Status of Station Ground still unknown. */

                        Equip_Gnd = 0;
                        SELECT :Equip_Gnd = IFNULL(SUM(OS.StatusCount),0)
                        FROM FMS_ObjectStatus OS
                        WHERE OS.Object = :Current_Equip AND
                              OS.Status = :Status$Ground;

                        IF OC_Status = 0 AND Equip_Gnd = 0 AND Current_TypeOfCard = TypeOfCard$4KV THEN
                            /*
                            ** This may be a 4kV Step Down and will be processed last
                            ** so we can check the Station ground status of the 27kV
                            ** and set the 4kV status based on that status.
                            */
                            x = 0;
                            SELECT :x = SD.Card 
                            FROM    FMS_StepDownLink SD
                            WHERE   SD.StepDownCard = :Current_Card;
                            IF x <> 0 THEN /* This is a step down 4kV Feeder */
                               StaGnd = 0;
                               SELECT  :StaGnd = 1 
                               FROM    FMS_ObjectStatus OS,
                                       TFMS_CardToObject CTO
                               WHERE   CTO.Card = :x AND
                                       CTO.Object = OS.Object AND
                                       OS.Status = :Status$StationGround;
                            ELSE
                               StaGnd = NULL; /* can't determine */
                            ENDIF;
                        ELSEIF ( (OC_Status = 0) AND (Equip_Gnd = 0) ) THEN
                            StaGnd = NULL; /* Still can't determine */
                        ELSEIF ( (OC_Status = 1) AND (Equip_Gnd = 0) ) THEN
                            StaGnd = 0; /* Station Ground OFF */
                        ELSEIF ( (OC_Status = 0) AND (Equip_Gnd > 0) ) THEN
                            StaGnd = 1; /* Station Ground ON */
                        ELSE /* ( (OC_Status = 1) AND (Equip_Gnd > 0) )*/

                            Term2Gnd = 0;
                            SELECT :Term2Gnd = IFNULL(SUM(OS.StatusCount),0)
                            FROM FMS_ObjectStatus OS
                            WHERE OS.Object = :Current_Equip AND
                              OS.Terminal IN (0,2) AND
                              OS.Status = :Status$Ground;

                            IF ( Term2Gnd > 0 ) THEN
                                StaGnd = 1; /* Station Ground ON */
                            ELSE
                                StaGnd = 0; /* Station Ground OFF */
                            ENDIF;
                        ENDIF;
                    ENDIF;

                ELSE /* Count mode */

                    /* Sum grounds for this equipment */
                    Equip_GndCnt = 0;
                    SELECT :Equip_GndCnt = IFNULL(SUM(OS.StatusCount),0)
                    FROM   FMS_ObjectStatus OS
                    WHERE  OS.Object = :Current_Equip AND
                           OS.Status = :Status$Ground;

                    Feeder_GndDec = Feeder_GndDec + Equip_GndCnt;
     
                ENDIF;
                
                Current_Equip = NULL;
            ENDWHILE;

        ELSEIF TraceEnabled = 0 AND Current_Feeder = 0 THEN
/*
** We get here if 33kV does not have a Source Position yet.
*/
           StaGnd = 0;
        ELSE
/*
** Call Connectivity Based Ground Trace Logic
*/ 
            RetCode = CALLPROC ConnectedSourceGroundTrace
                                (Feeder = Current_Feeder,
                                 StationGround = BYREF(StationGround),
                                 StationGroundCount = BYREF(Feeder_GndDec));
            IF RetCode = PU_CANCEL THEN
              StaGnd = NULL;
            ELSE
              IF StationGround = 'ON' THEN
                 StaGnd = 1;
              ELSE
                 StaGnd = 0;
              ENDIF;
            ENDIF;
        ENDIF;
/*
**  If StationGround still undetermined, assume it is off
*/
        IF StaGnd IS NULL THEN
            StaGnd = 0;
        ENDIF;
/*
**  For each 3G Feeder or single card feeder...
**  Verify that StationGroundStatus has changed prior
**  to updating it.
*/
        IF NetworkFeeder = 0 THEN
           Feeder3G[1].Object = Current_Feeder;
        ENDIF;

        FOR k = 1 TO Feeder3G.LastRow() DO

        Current_Feeder = Feeder3G[k].Object;

        FeederStationGround = 0;
        REPEATED 
        SELECT :FeederStationGround = 1
        FROM   FMS_ObjectStatus
        WHERE  Object = :Current_Feeder AND
           Status = :Status$StationGround;

        IF (FeederStationGround = 0 AND StaGnd = 1) THEN 
/*
**  Insert entry for Station Ground if status is ON. 
*/
            RetCode = CALLPROC FMS_ObjStatIns(Object = Current_Feeder,
                                          Terminal = 0,
                                          Status = Status$StationGround,
                                          StatusCount = 1,
                                          TimeSet = date('now'));

            IF k = 1 THEN
            /* log station ground for the fms card */
               CALLPROC SOA_LogIns   (Card = Current_Card,
                           Job = NULL,
                           Item = 'StationGround',
                           Old  = 'Off',
                           New = 'On',
                           Time = Date('now'),
                           Username = UserName);
            ENDIF;

        ELSEIF (FeederStationGround = 1 AND StaGnd = 0) THEN
/* 
**  Delete existing Station Ground entry. 
*/
            RetCode = CALLPROC FMS_ObjStatDel(Object = Current_Feeder,
                                      Terminal = 0,
                                      Status = Status$StationGround);

            IF k = 1 THEN
            /* log station ground for the fms card */
               CALLPROC SOA_LogIns   (Card = Current_Card,
                           Job = NULL,
                           Item = 'StationGround',
                           Old  = 'On',
                           New = 'Off',
                           Time = Date('now'),
                           Username = UserName);
            ENDIF;
        ENDIF;

        IF ( RetCode < 0 ) THEN
            CALLPROC DDB_ROLLBACK;
            SELECT :FeederName = Name 
            FROM   Udb_Object
            WHERE  Object = :Current_Feeder;
            CALLPROC TraceError (UserMessage = 
               'ERROR: Feeder Ground count or Station Ground status for feeder ' +
               FeederName + ' is incorrect. Please report to tech support.',
                           TraceMessage =
               'Procedure:FMS_ManageCardHeader1; ' +
               'Feeder Ground count or Station Ground status for feeder ' +
               FeederName + ' is incorrect. '
               );
        ENDIF;        
/*
**  Verify that FeederGrounds has changed prior
**  to updating it.
*/
        FeederGroundCount = NULL;
        REPEATED 
        SELECT :FeederGroundCount = StatusCount
        FROM   FMS_ObjectStatus
        WHERE  Object = :Current_Feeder AND
               Status = :Status$FeederGround;

    /* Calculate Feeder Ground Count. */
        FeederGndCnt = SaveFeederGndCnt - Feeder_GndDec;

        IF (FeederGroundCount > 0 AND FeederGndCnt = 0) THEN

    /* Delete existing Feeder Ground Count entry. */
            RetCode = CALLPROC FMS_ObjStatDel(Object = Current_Feeder,
                                      Terminal = 0,
                                      Status = Status$FeederGround);

        ELSEIF (FeederGroundCount IS NULL AND FeederGndCnt > 0) THEN
 
    /* Insert entry for current Feeder Ground Count. */
            RetCode = CALLPROC FMS_ObjStatIns(Object = Current_Feeder,
                                      Terminal = 0,
                                      Status = Status$FeederGround,
                                      StatusCount = FeederGndCnt,
                                      TimeSet = date('now'));
  
        ELSEIF (FeederGroundCount <> FeederGndCnt) AND
           (FeederGroundCount IS NOT NULL) THEN

    /* Calculate Increment. */
            FeederGndCnt = FeederGndCnt - FeederGroundCount;
            RetCode = CALLPROC FMS_ObjStatTimeSetUpd(Object = Current_Feeder,
                                      Terminal = 0,
                                      Status = Status$FeederGround,
                                      Increment = FeederGndCnt,
                                      TimeSet = date('now'));

        ELSEIF (FeederGroundCount = FeederGndCnt) AND
           (FeederGroundCount IS NOT NULL) AND
           (NetworkFeeder > 0) THEN

    /* We may be initializing 3G card header by forcing rule to fire */
            RetCode = CALLPROC FMS_ObjStatTimeSetUpd(Object = Current_Feeder,
                                      Terminal = 0,
                                      Status = Status$FeederGround,
                                      Increment = 0);
        ENDIF;

        IF ( RetCode < 0 ) THEN
            CALLPROC DDB_ROLLBACK;
            SELECT :FeederName = Name 
            FROM   Udb_Object
            WHERE  Object = :Current_Feeder;
            CALLPROC TraceError (UserMessage = 
               'ERROR: Feeder Ground count or Station Ground status for feeder ' +
               FeederName + ' is incorrect. Please report to tech support.',
                           TraceMessage =
               'Procedure:FMS_ManageCardHeader2; ' +
               'Feeder Ground count or Station Ground status for feeder ' +
               FeederName + ' is incorrect. '
               );
        ENDIF;        

        ENDFOR;   /*Feeder3G Loop */

        CALLPROC DDB_COMMIT;
        i = i + 1;

    ENDWHILE;

    RETURN;

END;


