	Name:            cac_deleterelayopforall

/*
** Copyright c 1995 ESCA Corporation. All Rights Reserved.
**
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
**
*/

PROCEDURE cac_deleterelayopforall
(
     CardType      = INTEGER NOT NULL,          /* PARAMETER */
     Card          = INTEGER NOT NULL,          /* PARAMETER */    
     Switchingitem = INTEGER WITH NULL,         /* PARAMETER */    
     RelayOp       = INTEGER NOT NULL,          /* PARAMETER */
     
     CardList = ARRAY OF CAC_Card,
     RetCode = INTEGER,
     i = INTEGER
)=
BEGIN
/* get a list of related cards */
    CardList.Clear();
    i = 1;

    REPEAT 
    SELECT :CardList[i].Card = RC.Card,
           :CardList[i].CardType = RC.CardType
    FROM   CAC_RelayOpsControl RC
    WHERE  RC.RelayOp = :RelayOp
    BEGIN
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;

/* delete it from database */
    RetCode = CALLPROC cac_deleterelayop
        (    RelayOp = RelayOp
        );
    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       message 'error in delete relay operation entry.';
       RETURN RetCode;
    ENDIF;
    CALLPROC DDB_COMMIT;

    IF CardList.LastRow() > 0 THEN
    /* 
    ** remove the current card from this list.
    */
       i = 1;
       WHILE i <= CardList.LastRow() DO
          IF CardList[i].Card = Card AND
             CardList[i].CardType = CardType THEN
             CardList.RemoveRow (RowNumber = i);   /* exclude current card */
             ENDLOOP;
          ENDIF;
          i = i + 1; 
       ENDWHILE;

       IF CardList.LastRow() > 0 THEN
          RetCode = CALLPROC CAC_RaiseRelayUpdate 
                                           (RelayOp  = ifnull(RelayOp,0),
                                            Action   = 'DELETE',
                                            CardList = CardList);
       ENDIF;
    ENDIF;

    RETURN RetCode;
END;

Application Component Report
============================

	Name:            cac_findrelatedcards

/*
** Copyright c 1995 ESCA Corporation. All Rights Reserved.
**
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
**
*/
/*
**  12/09/05   em  Corrected runtime error comparing G.Reference with
**                 an integer.
**  12/12/05   em  Changed Macro Station select to use Constant
**  03/24/11   em  Updated for 3G
**  05/21/11   em  Corrected table name runtime error
*/
PROCEDURE CAC_FindRelatedCards
(
     CardType = INTEGER NOT NULL,          /* PARAMETER */
     Card     = INTEGER NOT NULL,          /* PARAMETER */    
     RelayOp  = INTEGER NOT NULL,          /* PARAMETER */
     Equip    = INTEGER WITH NULL,         /* PARAMETER */
     CardList = ARRAY OF CAC_Card,         /* PARAMETER */
     
     i = INTEGER NOT NULL,
     MkvStn = INTEGER NOT NULL,
     RetCode = INTEGER,
     Grouping = INTEGER NOT NULL,
     GroupingType = INTEGER NOT NULL
)=
BEGIN
/* check if the equipment is a shared equipment, find out the cards
** which have the equipment in it. 
*/
    CardList.Clear();

    i = 1;
    SELECT :Grouping = G.Grouping,
           :GroupingType = ET.SuperType
    FROM   Udb_Grouping G,
           Udb_ExtendedType ET
    WHERE  G.Member = :Equip
      AND  G.Relationship = :Interaction$MemberOf
      AND  G.GroupingType = ET.Type 
      AND  ET.SuperType IN 
           (:Type$TransmissionFdr, :Type$Substation, :Type$Feeder)
    BEGIN
        IF GroupingType = :Type$TransmissionFdr THEN
           SELECT DISTINCT
                  :CardList[i].Card = CO.Card,
                  :CardList[i].CardType = :Type$TFMSApp    
           FROM   TFMS_CardToObject CO,
                  SOA_Card C,
                  SOA_ActiveCard AC
           WHERE  CO.Object = :Grouping
             AND  CO.Card = C.Card
             AND  C.Card = AC.Card
           BEGIN
              i = i + 1;
           END;       

        ELSEIF GroupingType = :Type$Substation THEN
           MkvStn = 0;
           SELECT :MkvStn = G.Grouping
           FROM   Udb_Grouping G
           WHERE  G.Relationship = :Interaction$MemberOf
             AND  G.Member = :Grouping
             AND  G.GroupingType = :Type$MacroSubstation;

           IF MkvStn > 0 THEN
              Grouping = MkvStn;
           ENDIF;

           SELECT DISTINCT
                  :CardList[i].Card = C.Card,
                  :CardList[i].CardType = :Type$SLCApp    
           FROM   SLC_Card C
           WHERE  C.Substation = :Grouping 
           BEGIN
              i = i + 1;
           END;
        ELSEIF GroupingType = :Type$Feeder THEN
           SELECT DISTINCT
                  :CardList[i].Card = C.Card,
                  :CardList[i].CardType = :Type$FMSApp    
           FROM   TFMS_CardToObject CO,
                  SOA_Card C,
                  SOA_ActiveCard AC
           WHERE  CO.Object = :Grouping
             AND  CO.Card = C.Card
             AND  C.Card = AC.Card
           BEGIN
              i = i + 1;
           END;
        ENDIF;
    END;
    CALLPROC DDB_ROLLBACK;
/* 
** remove the current card from this list.
*/
    IF CardList.LastRow () > 0 THEN
       i = 1;
       WHILE i <= CardList.LastRow() DO
          IF CardList[i].Card = Card AND
             CardList[i].CardType = CardType THEN
             CardList.RemoveRow (RowNumber = i);   /* exclude current card */
             ENDLOOP;
          ENDIF;
          i = i + 1; 
       ENDWHILE;
    ENDIF;

    RETURN RetCode;   
END;

