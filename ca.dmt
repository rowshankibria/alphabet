	Name:            ConvertHour

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FMS       
**  Frame:          ConvertHour 
**
**  Modifications:
**      04/04/94    pw     Created. 
*/

PROCEDURE ConvertHour 
(
    Tot_Min = INTEGER NOT NULL;
    T_Hour = INTEGER NOT NULL;
    T_Min = INTEGER NOT NULL;
    Ret_Time = VARCHAR(12) NOT NULL;
) =
BEGIN

    T_Hour = Tot_Min/60;
    T_Min = Tot_Min - (T_Hour * 60);
    IF T_Min < 10 THEN
       Ret_Time = varchar(T_Hour) + ':0' + varchar(T_Min);
    ELSE
       Ret_Time = varchar(T_Hour) + ':' + varchar(T_Min);
    ENDIF;
    RETURN (Ret_Time);

END;

