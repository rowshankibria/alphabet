	Name:            RPM_ASE


���p�$���Component Method Scripts
���p�$���--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          RPM_ASE
**
**  Date:       Version Description
** ----------------------------------
**  06/04/02    pkw     Created;
**  07/17/02    pkw     Fix problem with noteins and notedel
**  07/23/02    pkw     Change circuit search to search by feeder
**                      or circuit.
**  07/24/02    pkw     Fix bug with udb_grouping reference.
**  07/29/02    pkw     Change order of circuits when loading matrix.
**  08/01/02    pkw     Circuits are now ordered by seq.
**  08/02/02    pkw     Don't reset status values when updating circuit.
**  08/21/02    pkw     Check to see if circuit exists before inserting it.
**  07/10/04    pkw     Make updates for latest ITC 136 to 138.
**  07/27/04    pkw     Load RevisionDate when loading matrix.
**  01/20/05    pkw     Add Blank status for matrix.
**  05/16/05    pkw     Show groupername when loading a checked out matrix.
**  11/23/05    ysp     Fixed duplicate matrix note ids 
**  02/01/10    pkw     TLS 50: Update all selects with Udb_TelephoneCircuit to 
**                      use new Udb_CircuitRoute table.
**  02/08/10    ysp     Add Load and insert diagram attachments.
**  11/17/10    ysp     add LoadFeeders, LoadCircuits, CheckOutOnly method
**  01/24/12    pkw     Allow for 'sub' matrix.
*/
METHOD LoadFeeders(
)=
DECLARE
   AllFdrs    = ARRAY OF RelayGrouping;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   MatrixFdrs = ARRAY OF RelayGrouping;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of feeders not associated with
** a matrix.  For performance reasons, we will select all feeders and
** all feeders associated with a matrix and pull out the feeders in matrix.
** This allows us not to use a 'not in' in the whereclause.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   Filter = '%' + UPPERCASE(CurObject.Filter) + '%';
   /*
   **  Load All Feeders. 
   */
   CurObject.FList.Clear();
   i = 1;
   REPEATED
   SELECT  :CurObject.FList[i].Object = O.Object,
           :CurObject.FList[i].Name = O.Name
   FROM    Udb_Object O
   WHERE   O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.NAME) LIKE :Filter
   ORDER BY Name
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Flist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No feeders found for search criteria.';
      RETURN;     
   ENDIF;
   
   RETURN;   
END;
 
METHOD LoadNewFdr (
)=
DECLARE
   AllFdrs    = ARRAY OF RelayGrouping;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   MatrixFdrs = ARRAY OF RelayGrouping;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of feeders not associated with
** a matrix.  For performance reasons, we will select all feeders and
** all feeders associated with a matrix and pull out the feeders in matrix.
** This allows us not to use a 'not in' in the whereclause.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   Filter = '%' + UPPERCASE(CurObject.Filter) + '%';
   /*
   **  Load All Feeders. 
   */
   AllFdrs.Clear();
   i = 1;
   REPEATED
   SELECT  :AllFdrs[i].Object = O.Object,
           :AllFdrs[i].Name = O.Name
   FROM    Udb_Object O
   WHERE   O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.NAME) LIKE :Filter
   ORDER BY Name
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   /*
   **  Load Matrix Feeders. 
   */
   MatrixFdrs.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
           :MatrixFdrs[i].Object = O.Object,
           :MatrixFdrs[i].Name = O.Name
   FROM    Udb_Object O,
           CAC_Relay_Feeder F,
           CAC_Relay_Grouping G
   WHERE   F.Grouping = G.Grouping AND
           G.UserCheckOut = '' AND
           F.Feeder = O.Object AND
           O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.NAME) LIKE :Filter
   union  /* get only feeders that still exist on checked out matrix */
   SELECT  O.Object,
           O.Name
   FROM    Udb_Object O,
           CAC_CO_Feeder F,
           CAC_Relay_Grouping G
   WHERE   F.Grouping = G.Grouping AND
           G.UserCheckOut <> '' AND
           F.Feeder = O.Object AND
           O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.NAME) LIKE :Filter
   ORDER BY Name
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF MatrixFdrs.LastRow() <> 0 THEN
      j = 1;
      FOR i = 1 TO MatrixFdrs.LastRow() DO
         WHILE j <= AllFdrs.LastRow() DO
            IF MatrixFdrs[i].Name = AllFdrs[j].Name THEN
               AllFdrs.RemoveRow (RowNumber = j);
               MatrixFdrs.RemoveRow (RowNumber = i);
               IF MatrixFdrs.LastRow() = 0 THEN
                  ENDLOOP;
               ENDIF;
            ELSE
               j = j + 1;
            ENDIF;   
         ENDWHILE;
      ENDFOR;
   ENDIF;
   CurObject.Flist.Clear();
   CurObject.Flist = AllFdrs.Duplicate();

   IF MatrixFdrs.LastRow() <> 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR:: Application::CAC, Class::RPM_ASE - ' +
           'Found Transmission feeders in CAC_Relay_Feeder that are not ' +
           'valid feeders.';
      RETURN;     
   ENDIF;
   
   IF CurObject.Flist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No feeders found for search criteria.';
      RETURN;     
   ENDIF;
   
   RETURN;
END;


METHOD LoadMatrixFdr (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   LastFeeder = VARCHAR(40) NOT NULL;
   MatrixCount = INTEGER NOT NULL;
   TempChar = VARCHAR(40) NOT NULL;
   TempRouteName = VARCHAR(40) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of feeders not associated with
** a matrix.  For performance reasons, we will select all feeders and
** all feeders associated with a matrix and pull out the feeders in matrix.
** This allows us not to use a 'not in' in the whereclause.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   Filter = '%' + UPPERCASE(CurObject.Filter) + '%';
   /*
   **  Load Matrix Feeders. 
   */
   i = 1;
   REPEATED
   SELECT DISTINCT
           :CurObject.Flist[i].Object = O.Object,
           :CurObject.Flist[i].Name = O.Name,
           :CurObject.Flist[i].UserName = G.UserCheckOut,
           :CurObject.Flist[i].Grouping = G.Grouping,
           :CurObject.Flist[i].RevisionDate = G.RevisionDate,
           :CurObject.Flist[i].Comment = G.Comment
   FROM    Udb_Object O,
           CAC_Relay_Feeder F,
           CAC_Relay_Grouping G
   WHERE   F.Feeder = O.Object AND
           O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.Name) LIKE :Filter AND
           F.Grouping = G.Grouping
   union  /* get new matrix that hasn't been checked in yet */
   SELECT  O.Object,
           O.Name,
           G.UserCheckOut,
           G.Grouping,
           G.RevisionDate,
           G.Comment
   FROM    Udb_Object O,
           CAC_CO_Feeder F,
           CAC_Relay_Grouping G
   WHERE   F.Feeder = O.Object AND
           O.Type = :Type$TransmissionFdr AND
           UPPERCASE(O.Name) LIKE :Filter AND
           F.Grouping = G.Grouping
   ORDER BY Name
   BEGIN
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Feeder
      WHERE   Feeder = :CurObject.Flist[i].Object;
      IF MatrixCount > 1 THEN
         /* Get Feeders */
         CurObject.Flist[i].MatrixRelationship = 'Feeders: ';
         SELECT :TempChar = O.Name
         FROM    Udb_Object O,
                 CAC_Relay_Feeder F
         WHERE   F.Grouping = :CurObject.Flist[i].Grouping AND
                 F.Feeder   = O.Object
         BEGIN
            CurObject.Flist[i].MatrixRelationship = 
                 CurObject.Flist[i].MatrixRelationship + TempChar + ' ';
                 
         END;
         /* Get Circuit */
         CurObject.Flist[i].MatrixRelationship = 
               CurObject.Flist[i].MatrixRelationship + '  Circuits: ';
         SELECT :TempChar = O.Name,
                :TempRouteName = T.Name
         FROM    Udb_Object O,
                 CAC_Relay_Circuit C,
                 Udb_Type T
         WHERE   C.Grouping = :CurObject.Flist[i].Grouping AND
                 C.Circuit  = O.Object AND
                 C.Route = T.Type
         BEGIN
            CurObject.Flist[i].MatrixRelationship = 
                 CurObject.Flist[i].MatrixRelationship + TempChar + '(' + TempRouteName + ') ';
         END;
      ENDIF;
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.Flist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No feeders found for search criteria.';
      RETURN;     
   ENDIF;

   IF CurObject.FilterDistinct = TRUE THEN
      /* 
      **  Get rid of any duplicates.  We are adding a feeder 
      **  to a matrix.
      */
      i = 1;
      LastFeeder = '';
      WHILE i <= CurObject.Flist.LastRow() DO
         IF LastFeeder = CurObject.Flist[i].Name THEN
            CurObject.Flist.RemoveRow (RowNumber = i);
         ELSE
            LastFeeder = CurObject.Flist[i].Name;
            i = i + 1;
         ENDIF;
      ENDWHILE;
   ENDIF;
   
   RETURN;
END;


METHOD LoadCircuitTypes (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of circuit types
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
**  Load the optionfield "linetype_filter" with linetypenames from the type
**  table.  A blank type is loaded as the default which is actually telephone circuit.
*/
   CurObject.Flist.Clear();
   
   CurObject.Flist[1].Type = Type$TelCircuit;
   Curobject.Flist[1].Name = '';
   
   i = 2;
   REPEATED
   SELECT  :CurObject.Flist[i].Type = T.Type,
           :CurObject.Flist[i].Name = T.Name
   FROM    Udb_Type T,
           Udb_ExtendedType E
   WHERE   T.Type = E.Type
   AND     E.SuperType = :Type$TelCircuit
   AND     E.Type <> :Type$TelCircuit
   AND     E.Type NOT IN (SELECT Type
                          FROM Udb_ExtendedType
                          WHERE SuperType = :Type$TCEquipment)
   ORDER BY Name
   BEGIN
       i = i + 1;
   END;

   IF CurObject.Flist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No circuit types found in database.';
      RETURN;     
   ENDIF;
   
   RETURN;
END;


METHOD LoadHelpCircuitTypes (
)=
DECLARE
   AList      = Array of RelayGrouping;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of circuit types
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   Alist.Clear();
   i = 1;
   REPEATED
   SELECT  :Alist[i].Name = 'Unknown',
           :Alist[i].Type = T.Type,
           :Alist[i].TypeName = T.Name,
           :Alist[i].Comment = T.Description
   FROM    Udb_Type T,
           Udb_ExtendedType E
   WHERE   T.Type = E.Type
   AND     E.SuperType = :Type$TelCircuit
   AND     E.Type <> :Type$TelCircuit
   AND     E.Type NOT IN (SELECT Type
                          FROM Udb_ExtendedType
                          WHERE SuperType = :Type$TCEquipment)
   ORDER BY TypeName
   BEGIN
      i = i + 1;
   END;

   CurObject.Flist.Clear();
   i = 1;
   REPEATED
   SELECT  :CurObject.Flist[i].Name = T2.Name,
           :CurObject.Flist[i].Type = T.Type,
           :CurObject.Flist[i].TypeName = T.Name,
           :CurObject.Flist[i].Comment = T.Description
   FROM    Udb_Type T,
           Udb_Type T2,
           Udb_ExtendedType E,
           Udb_SuperType ST
   WHERE   T.Type = E.Type
   AND     E.SuperType = :Type$TelCircuit
   AND     E.Type <> :Type$TelCircuit
   AND     E.Type NOT IN (SELECT Type
                          FROM Udb_ExtendedType
                          WHERE SuperType = :Type$TCEquipment) 
   AND     T.Type = ST.Type 
   AND     ST.SuperType IN (SELECT Type
                            FROM   Udb_SuperType ST1
                            WHERE  ST1.SuperType = :Type$CircuitReportCategory)
   AND     ST.SuperType = T2.Type
   ORDER BY Name,TypeName
   BEGIN
       i = i + 1;
   END;

   IF Alist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No circuit types found in database.';
      RETURN;     
   ENDIF;

   FOR i = 1 TO AList.LastRow() DO
      j = 1;
      WHILE j <= CurObject.FList.LastRow() DO
         IF Alist[i].Type = CurObject.Flist[j].Type THEN
            ENDLOOP;
         ENDIF;
         j = j + 1;
      ENDWHILE;
      IF j > CurObject.Flist.LastRow() THEN
         CurObject.Flist.InsertRow (RowNumber = j,
                                    RowObject = Alist[i].Duplicate());
      ENDIF;   
   ENDFOR;
   
   RETURN;
END;

METHOD LoadCircuits (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   CircuitFilter    = VARCHAR(40) NOT NULL;
   LineTypeFilter   = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of circuits regardless whether
** they are already in rpm matrices. 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Filter = '' AND
      CurObject.LineTypeFilter = :Type$TelCircuit THEN

      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
          'You must enter some search criteria.';
      RETURN;     
   ENDIF;
   
   IF CurObject.LineTypeFilter = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
          'Invalid line type selected.';
      RETURN;     
   ENDIF;

   CircuitFilter = '%' + UPPERCASE(CurObject.Filter) + '%';
   
   LineTypeFilter = CurObject.LineTypeFilter;

   CurObject.Clist.Clear();

   i = 1;
   REPEATED
   SELECT DISTINCT
        :CurObject.Clist[i].Object = O.Object,
        :CurObject.Clist[i].Name = O.Name,
        :CurObject.Clist[i].TypeName = O.TypeName,
        :CurObject.Clist[i].Route = T.Type,
        :CurObject.Clist[i].RouteName = T.Name
   FROM Udb_Object O,
        Udb_Type T,
        Udb_CircuitRoute C
   WHERE UPPERCASE(O.Name) like :CircuitFilter AND
         O.Type IN (SELECT  Type
                    FROM    Udb_ExtendedType
                    WHERE   SuperType = :LineTypeFilter) AND
         O.Object = C.Object AND
         C.Route = T.Type
   ORDER BY Object
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
    
/*
**  Only allow up to 50 matches.
*/
   IF CurObject.Clist.LastRow() > 50 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please be more specific ' +
         'with your search criteria.';
      RETURN;
   ENDIF;

   CurObject.GetStationsAndFeeders();

   IF CurObject.Clist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No circuits found for the search criteria.';
      RETURN;     
   ENDIF;
   
   RETURN;
END;

METHOD LoadNewCircuit (
)=
DECLARE
   AllCircuits = ARRAY OF RelayGrouping;
   MatrixCircuits = ARRAY OF RelayGrouping;
   CircuitFilter    = VARCHAR(40) NOT NULL;
   LineTypeFilter   = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   i          = INTEGER NOT NULL;
   RouteName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of feeders not associated with
** a matrix.  For performance reasons, we will select all feeders and
** all feeders associated with a matrix and pull out the feeders in matrix.
** This allows us not to use a 'not in' in the whereclause.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Filter = '' AND
      CurObject.LineTypeFilter = :Type$TelCircuit THEN

      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
          'You must enter some search criteria.';
      RETURN;     
   ENDIF;
   
   IF CurObject.LineTypeFilter = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
          'Invalid line type passed entered.';
      RETURN;     
   ENDIF;

   CircuitFilter = '%' + UPPERCASE(CurObject.Filter) + '%';
   
   LineTypeFilter = CurObject.LineTypeFilter;
   /*
   **  Load Matrix Circuits. 
   **  We need to do two separate selects depending on if there is data in the
   **  feeder field since not all circuits have feeders.
   */
   AllCircuits.Clear();
   MatrixCircuits.Clear();
   CurObject.Clist.Clear();

/*
**  Select ALL circuits and do not join on the feeder grouping
*/
   IF CurObject.SearchOption = 1 THEN /* search by circuit */
      i = 1;
      REPEATED
      SELECT DISTINCT
           :AllCircuits[i].Object = O.Object,
           :AllCircuits[i].Name = O.Name,
           :AllCircuits[i].TypeName = O.TypeName,
           :AllCircuits[i].Route = T.Type,
           :AllCircuits[i].RouteName = T.Name
      FROM Udb_Object O,
           Udb_Type T,
           Udb_CircuitRoute C
      WHERE UPPERCASE(O.Name) like :CircuitFilter AND
            O.Type IN (SELECT  Type
                       FROM    Udb_ExtendedType
                       WHERE   SuperType = :LineTypeFilter) AND
            O.Object = C.Object AND
            C.Route = T.Type
      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
       
      i = 1;
      REPEATED
      SELECT DISTINCT
           :MatrixCircuits[i].Object = O.Object,
           :MatrixCircuits[i].Name = O.Name,
           :MatrixCircuits[i].TypeName = O.TypeName,
           :MatrixCircuits[i].Route = T.Type,
           :MatrixCircuits[i].RouteName = T.Name
      FROM Udb_Object O,               /* circuit */
           Udb_Type T,
           CAC_Relay_Circuit R,
           CAC_Relay_Grouping G
      WHERE   UPPERCASE(O.Name) like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType = :LineTypeFilter)
      AND     O.Object = R.Circuit
      AND     R.Route = T.Type
      AND     R.Grouping = G.Grouping
      AND     G.UserCheckOut = ''
      union
      SELECT 
           O.Object,
           O.Name,
           O.TypeName,
           T.Type,
           T.Name
      FROM Udb_Object O,               /* circuit */
           Udb_Type T,
           CAC_CO_Circuit R,
           CAC_Relay_Grouping G
      WHERE   UPPERCASE(O.Name) like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType = :LineTypeFilter)
      AND     O.Object = R.Circuit
      AND     R.Route = T.Type
      AND     R.Grouping = G.Grouping 
      AND     G.UserCheckOut <> ''
      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSEIF CurObject.SearchOption = 2 THEN /* search by feeder */

      i = 1;
      REPEATED
      SELECT DISTINCT
           :AllCircuits[i].Object = O2.Object,
           :AllCircuits[i].Name = O2.Name,
           :AllCircuits[i].TypeName = O2.TypeName,
           :AllCircuits[i].Route = T.Type,
           :AllCircuits[i].RouteName = T.Name
      FROM Udb_Object O,               /* Feeder */
           Udb_Object O2,              /* circuit */
           Udb_CircuitRoute C,
           Udb_Grouping G,
           Udb_Type T
      WHERE   UPPERCASE(O.Name) like :CircuitFilter /* feeder */
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType IN (:Type$Line,:Type$Feeder,
                                                :Type$Network, :Type$DivisionWorkstation))
      AND     O.Object = G.Grouping 
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :LineTypeFilter)
      AND     G.Member = O2.Object
      AND     G.Member = C.Object
      AND     C.Route = T.Type
      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      i = 1;
      REPEATED
      SELECT DISTINCT
           :MatrixCircuits[i].Object = O2.Object,
           :MatrixCircuits[i].Name = O2.Name,
           :MatrixCircuits[i].TypeName = O2.TypeName,
           :MatrixCircuits[i].Route = T.Type,
           :MatrixCircuits[i].RouteName = T.Name
      FROM Udb_Object O,               /* feeder */
           Udb_Object O2,              /* circuit */
           Udb_Type T,
           Udb_Grouping G,
           CAC_Relay_Circuit R,
           CAC_Relay_Grouping RG
      WHERE   UPPERCASE(O.Name) like :CircuitFilter /* feeder */
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType IN (:Type$Line,:Type$Feeder,
                                                :Type$Network, :Type$DivisionWorkstation))
      AND     O.Object = G.Grouping 
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :LineTypeFilter)
      AND     G.Member = O2.Object
      AND     G.Member = R.Circuit
      AND     R.Route = T.Type 
      AND     R.Grouping = RG.Grouping 
      AND     RG.UserCheckOut = ''
      union
      SELECT 
           O2.Object,
           O2.Name,
           O2.TypeName,
           T.Type,
           T.Name
      FROM Udb_Object O,               /* feeder */
           Udb_Object O2,              /* circuit */
           Udb_Grouping G,
           Udb_Type T,
           CAC_CO_Circuit R,
           CAC_Relay_Grouping RG
      WHERE   UPPERCASE(O.Name) like :CircuitFilter /* feeder */
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType IN (:Type$Line,:Type$Feeder,
                                                :Type$Network, :Type$DivisionWorkstation))
      AND     O.Object = G.Grouping 
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :LineTypeFilter)
      AND     G.Member = O2.Object
      AND     G.Member = R.Circuit 
      AND     R.Route = T.Type
      AND     R.Grouping = RG.Grouping 
      AND     RG.UserCheckOut <> ''
      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      
   ELSE  /* bad search criteria */
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR:: ' +
          'No search option was entered.';
      RETURN;     
   ENDIF;
/*
**  Filter out circuits already on a matrix
*/   
   IF MatrixCircuits.LastRow() <> 0 THEN
      j = 1;
      FOR i = 1 TO MatrixCircuits.LastRow() DO
         WHILE j <= AllCircuits.LastRow() DO
            IF MatrixCircuits[i].Name = AllCircuits[j].Name AND
               MatrixCircuits[i].Route = AllCircuits[j].Route THEN
               AllCircuits.RemoveRow (RowNumber = j);
               MatrixCircuits.RemoveRow (RowNumber = i);
               IF MatrixCircuits.LastRow() = 0 THEN
                  ENDLOOP;
               ENDIF;
            ELSE
               j = j + 1;
            ENDIF;   
         ENDWHILE;
      ENDFOR;
   ENDIF;
    
   CurObject.Clist.Clear();
   CurObject.Clist = AllCircuits.Duplicate();
/*
**  Only allow up to 50 matches.
*/
   IF CurObject.Clist.LastRow() > 50 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please be more specific ' +
         'with your search criteria.';
      RETURN;
   ENDIF;

   CurObject.GetStationsAndFeeders();

   IF CurObject.Clist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No circuits found for the search criteria.';
      RETURN;     
   ENDIF;
   
   RETURN;
END;

METHOD LoadMatrixCircuit (
)=
DECLARE
   CircuitFilter    = VARCHAR(40) NOT NULL;
   LastCircuit      = INTEGER NOT NULL;
   LastRoute        = INTEGER NOT NULL;
   LineTypeFilter   = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   i          = INTEGER NOT NULL;
   MatrixCount = INTEGER NOT NULL;
   TempChar = VARCHAR(40) NOT NULL;
   TempRouteName = VARCHAR(40) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load a list of feeders associated with
** a matrix.  
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Filter = '' AND
      CurObject.LineTypeFilter = 0 THEN

      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
          'You must enter some search criteria.';
      RETURN;     
   ENDIF;
   
   CircuitFilter = '%' + UPPERCASE(CurObject.Filter) + '%';
   
   LineTypeFilter = CurObject.LineTypeFilter;
   /*
   **  Load Matrix Circuits. 
   **  We need to do two separate selects depending on if there is data in the
   **  feeder field since not all circuits have feeders.
   */
   CurObject.Clist.Clear();

/*
**  Select ALL circuits and do not join on the feeder grouping
*/
   IF CurObject.SearchOption = 1 THEN  /* search by circuit */
      i = 1;
      REPEATED
      SELECT DISTINCT
               :CurObject.Clist[i].Object = O.Object,
               :CurObject.Clist[i].Name = O.Name,
               :CurObject.Clist[i].TypeName = O.TypeName,
               :CurObject.Clist[i].Route = T.Type,
               :CurObject.Clist[i].RouteName = T.Name,
               :CurObject.Clist[i].UserName = G.UserCheckOut,
               :CurObject.Clist[i].Grouping = G.Grouping,
               :CurObject.Clist[i].RevisionDate = G.RevisionDate,
               :CurObject.Clist[i].Comment = G.Comment
      FROM    Udb_Object O,               /* circuit */
              Udb_Type T,
              CAC_Relay_Circuit R,
              CAC_Relay_Grouping G
      WHERE   UPPERCASE(O.Name) like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType = :LineTypeFilter)
      AND     O.Object = R.Circuit
      AND     R.Route = T.Type
      AND     R.Grouping = G.Grouping
      union /* get new matrix that hasn't been checked in yet. */
      SELECT      O.Object,
                  O.Name,
                  O.TypeName,
                  T.Type,
                  T.Name,
                  G.UserCheckOut,
                  G.Grouping,
                  G.RevisionDate,
                  G.Comment
      FROM    Udb_Object O,               /* circuit */
              Udb_Type T,
              CAC_CO_Circuit R,
              CAC_Relay_Grouping G
      WHERE   UPPERCASE(O.Name) like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType = :LineTypeFilter)
      AND     O.Object = R.Circuit
      AND     R.Route = T.Type
      AND     R.Grouping = G.Grouping
   
      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSEIF CurObject.SearchOption = 2 THEN /* search by feeder */
      i = 1;
      REPEATED
      SELECT DISTINCT
               :CurObject.Clist[i].Object = O2.Object,
               :CurObject.Clist[i].Name = O2.Name,
               :CurObject.Clist[i].TypeName = O2.TypeName,
               :CurObject.Clist[i].Route = T.Type,
               :CurObject.Clist[i].RouteName = T.Name,
               :CurObject.Clist[i].UserName = RG.UserCheckOut,
               :CurObject.Clist[i].Grouping = RG.Grouping,
               :CurObject.Clist[i].RevisionDate = RG.RevisionDate,
               :CurObject.Clist[i].Comment = RG.Comment
      FROM    Udb_Object O,               /* feeder */
              Udb_Object O2,
              Udb_Grouping G,
              Udb_Type T,
              CAC_Relay_Circuit R,
              CAC_Relay_Grouping RG
      WHERE   UPPERCASE(O.Name) like :CircuitFilter /* feeder */
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType IN (:Type$Line,:Type$Feeder,
                                                :Type$Network, :Type$DivisionWorkstation))
      AND     O.Object = G.Grouping 
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :LineTypeFilter)
      AND     G.Member = R.Circuit
      AND     R.Route = T.Type 
      AND     R.Grouping = RG.Grouping 
      AND     RG.UserCheckOut = ''
      AND     R.Circuit = O2.Object

      union /* get new matrix that hasn't been checked in yet. */
      SELECT      O2.Object,
                  O2.Name,
                  O2.TypeName,
                  T.Type,
                  T.Name,
                  RG.UserCheckOut,
                  RG.Grouping,
                  RG.RevisionDate,
                  RG.Comment
      FROM    Udb_Object O,               /* feeder */
              Udb_Object O2,              /* circuit */
              Udb_Grouping G,
              Udb_Type T,
              CAC_CO_Circuit R,
              CAC_Relay_Grouping RG
      WHERE   UPPERCASE(O.Name) like :CircuitFilter /* feeder */
      AND     O.Type IN ( SELECT  Type
                          FROM    Udb_ExtendedType
                          WHERE   SuperType IN (:Type$Line,:Type$Feeder,
                                                :Type$Network, :Type$DivisionWorkstation))
      AND     O.Object = G.Grouping 
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :LineTypeFilter)
      AND     G.Member = R.Circuit 
      AND     R.Route = T.Type
      AND     R.Grouping = RG.Grouping 
      AND     RG.UserCheckOut <> ''
      AND     R.Circuit = O2.Object

      ORDER BY Object
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE  /* bad search criteria */
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR:: ' +
          'No search option was entered.';
      RETURN;     
   ENDIF;
/*
**  Only allow up to 50 matches.
*/
   IF CurObject.Clist.LastRow() > 50 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please be more specific ' +
         'with your search criteria.';
      RETURN;
   ENDIF;

/*
**  See if any circuits/routes are on multiple matrices.
*/
   FOR i = 1 TO CurObject.Clist.LastRow() DO
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Circuit
      WHERE   Circuit = :CurObject.Clist[i].Object AND
              Route = :CurObject.Clist[i].Route;
      IF MatrixCount > 1 THEN
         /* Get Feeders */
         CurObject.Clist[i].MatrixRelationship = 'Feeders: ';
         SELECT :TempChar = O.Name
         FROM    Udb_Object O,
                 CAC_Relay_Feeder F
         WHERE   F.Grouping = :CurObject.Clist[i].Grouping AND
                 F.Feeder   = O.Object
         BEGIN
            CurObject.Clist[i].MatrixRelationship = 
                 CurObject.Clist[i].MatrixRelationship + TempChar + ' ';
                 
         END;
         /* Get Circuit */
         CurObject.Clist[i].MatrixRelationship = 
               CurObject.Clist[i].MatrixRelationship + '  Circuits: ';
         SELECT :TempChar = O.Name,
                :TempRouteName = T.Name
         FROM    Udb_Object O,
                 CAC_Relay_Circuit C,
                 Udb_Type T
         WHERE   C.Grouping = :CurObject.Clist[i].Grouping AND
                 C.Circuit  = O.Object AND
                 C.Route = T.Type
         BEGIN
            CurObject.Clist[i].MatrixRelationship = 
                 CurObject.Clist[i].MatrixRelationship + TempChar + '(' + TempRouteName + ') ';
         END;
      ENDIF;
   ENDFOR;

   CurObject.GetStationsAndFeeders();

   IF CurObject.Clist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WARNING:: ' +
           'No circuits found for the search criteria.';
      RETURN;     
   ENDIF;
   
   IF CurObject.FilterDistinct = TRUE THEN
      /* 
      **  Get rid of any duplicates.  We are adding a circuit
      **  to a matrix.
      */
      i = 1;
      LastCircuit = 0;
      LastRoute = 0;
      WHILE i <= CurObject.Clist.LastRow() DO
         IF LastCircuit = CurObject.Clist[i].Object AND
            LastRoute = CurObject.Clist[i].Route THEN
            CurObject.Clist.RemoveRow (RowNumber = i);
         ELSE
            LastCircuit = CurObject.Clist[i].Object;
            LastRoute   = CurObject.Clist[i].Route;
            i = i + 1;
         ENDIF;
      ENDWHILE;
   ENDIF;

   RETURN;
END;

METHOD LoadMatrixHistory (
)=
DECLARE
   i          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load the history comments of a matrix
** when the matrix is checkin and out etc...
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.FilterDistinct = 0 THEN
      IF CurObject.Grouping = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No matrix value was selected. Please try again.';
         RETURN;     
      ENDIF;
      /*
      **  Load History for matrix
      */
      i = 1;
      CurObject.hlist.Clear();
      REPEATED
      SELECT :CurObject.hlist[i].UserName = H.UserName,
             :CurObject.hlist[i].RevisionDate = H.LogDate,
             :CurObject.hlist[i].Comment = H.Comment
      FROM   CAC_Relay_GroupingHistory H
      WHERE  H.Grouping = :CurObject.Grouping
      ORDER BY RevisionDate
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE
      IF CurObject.StartDate = '' THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No StartDate was selected. Please try again.';
         RETURN;     
      ENDIF;
      IF CurObject.EndDate = '' THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No EndDate was selected. Please try again.';
         RETURN;     
      ENDIF;
      /*
      **  Load data for report
      */
      i = 1;
      CurObject.hlist.Clear();
      REPEATED
      SELECT :CurObject.hlist[i].UserName = H.UserName,
             :CurObject.hlist[i].RevisionDate = H.LogDate,
             :CurObject.hlist[i].Comment = H.Comment
      FROM   CAC_Relay_GroupingHistory H
      WHERE  H.LogDate >= :CurObject.StartDate AND
             H.LogDate <= :CurObject.EndDate AND
             H.LogType = :CurObject.FilterDistinct
      ORDER BY RevisionDate
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
   RETURN;
END;



METHOD LoadMatrix (
)=
DECLARE
   Alist = ARRAY OF RelayGrouping;
   Blist = ARRAY OF RelayGrouping;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   MatrixCount = INTEGER NOT NULL;
   TempStationName = VARCHAR(60) NOT NULL;
   ChangeLastRow = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load the Feeder list, circuit list, notes
** etc. for a matrix.  The matrix details will be loaded in the LoadMatrix 
** method.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was selected, please try again.';
      RETURN;     
   ENDIF;
/*
**  Load Revision Date for reports
*/
   SELECT :CurObject.RevisionDate = RevisionDate
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Feeder list
*/
   i = 1;
   CurObject.Flist.Clear();
   REPEATED
   SELECT :CurObject.Flist[i].Name = O.Name,
          :CurObject.Flist[i].Object = O.Object
   FROM   CAC_Relay_Feeder RF,
          Udb_Object O
   WHERE  RF.Grouping = :CurObject.Grouping AND
          RF.Feeder = O.Object
   ORDER BY Name
   BEGIN
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Feeder
      WHERE   Feeder = :CurObject.Flist[i].Object;
      IF MatrixCount > 1 THEN
         CurObject.Flist[i].Name = CurObject.Flist[i].Name + ' (M)';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Circuit list
*/
   i = 1;
   CurObject.Clist.Clear();
   SELECT :CurObject.CList[i].Object = O.Object,
          :CurObject.Clist[i].Name = O.Name,
          :CurObject.Clist[i].TypeName = O.TypeName,
          :CurObject.Clist[i].Route = T.Type,
          :CurObject.Clist[i].RouteName = T.Name,
          :CurObject.Clist[i].Seq = RC.Seq
   FROM   CAC_Relay_Circuit RC,
          Udb_Object O,
          Udb_Type T
   WHERE  RC.Grouping = :CurObject.Grouping AND
          RC.Circuit = O.Object AND
          RC.Route = T.Type
   ORDER BY Seq
   BEGIN
      /*
      **  If feeder has a grouper than show it.
      */ 
      SELECT :CurObject.Clist[i].GrouperName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_ExtendedType ET
      WHERE   G.Member = :CurObject.Clist[i].Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = ET.Type AND
              ET.SuperType = :Type$TelCardGrouper AND
              G.Grouping = O.Object;
      /*
      **  Put M if circuit on multiple matrices.
      */
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Circuit
      WHERE   Circuit = :CurObject.Clist[i].Object AND
              Route   = :CurObject.Clist[i].Route;
      IF MatrixCount > 1 THEN
         CurObject.Clist[i].Name = CurObject.Clist[i].Name + ' (M)';
      ENDIF;
      /*
      **  Get all of the substations and concatenate them into one field
      */
      TempStationName = '';
      REPEATED
      SELECT  :TempStationName = O.Name
      FROM    Udb_Grouping G,
              Udb_ExtendedType ET,
              Udb_Object O
      WHERE   G.Member = :CurObject.Clist[i].Object
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.Grouping = O.Object
      AND     G.GroupingType = ET.Type
      AND     ET.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
      BEGIN
         IF (CurObject.Clist[i].SubstationNames = '') THEN
             CurObject.Clist[i].SubstationNames = TempStationName;
         ELSE
             CurObject.Clist[i].SubstationNames = CurObject.Clist[i].SubstationNames + 
                                                  ', ' + TempStationName;
         ENDIF;
      END;
      CALLPROC DDB_ROLLBACK;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
**  Load Feeder, Equipment, and note information
*/
   CurObject.sList.Clear();
   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].FdrStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_Relay_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Feeder
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].FdrStatus = Relay$Yes THEN
         CurObject.sList[i].FdrStatusName = Relay$YesName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$No THEN
         CurObject.sList[i].FdrStatusName = Relay$NoName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$STT THEN
         CurObject.sList[i].FdrStatusName = Relay$STTName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$Blank THEN
         CurObject.sList[i].FdrStatusName = Relay$BlankName;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].EquipStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_Relay_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Equipment
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].EquipStatus = Relay$Yes THEN
         CurObject.sList[i].EquipStatusName = Relay$YesName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$No THEN
         CurObject.sList[i].EquipStatusName = Relay$NoName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$STT THEN
         CurObject.sList[i].EquipStatusName = Relay$STTName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$Blank THEN
         CurObject.sList[i].EquipStatusName = Relay$BlankName;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CompStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_Relay_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Comparison
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CompStatus = Relay$GreaterThan THEN
         CurObject.sList[i].CompStatusName = Relay$GreaterThanName;
      ELSEIF CurObject.sList[i].CompStatus = Relay$Equal THEN
         CurObject.sList[i].CompStatusName = Relay$EqualName;
      ELSEIF CurObject.sList[i].CompStatus = Relay$LessThan THEN
         CurObject.sList[i].CompStatusName = Relay$LessThanName;
      ELSE  /* Default to 0 and '' */
         CurObject.sList[i].CompStatus = 0;
         CurObject.sList[i].CompStatusName = '';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CountStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_Relay_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Count
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CountStatus = 0 THEN
         CurObject.sList[i].CountStatusName = '';
      ELSE
         IF CurObject.sList[i].CountStatus < 10 THEN
            CurObject.sList[i].CountStatusName = ' ' + Varchar(CurObject.sList[i].CountStatus);
         ELSE
            CurObject.sList[i].CountStatusName = Varchar(CurObject.sList[i].CountStatus);
         ENDIF;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CktStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_Relay_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$CktStatus
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CktStatus = Relay$InService THEN
         CurObject.sList[i].CktStatusName = Relay$InServiceName;
      ELSEIF CurObject.sList[i].CktStatus = Relay$OutOfService AND
         CurObject.sList[i].CountStatus <> 0 THEN
         CurObject.sList[i].CktStatusName = Relay$OutOfServiceName;
      ELSE
         CurObject.sList[i].CktStatusName = '';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
**  Load Notes for Matrix.
*/
   i = 1;
   CurObject.nList.Clear();
   REPEATED
   SELECT :CurObject.nList[i].Note_Id = Note_Id,
          :CurObject.nList[i].Note_Seq = Note_Seq,
          :CurObject.nList[i].Note = Note
   FROM    CAC_Relay_Note
   WHERE   Grouping = :CurObject.Grouping
   ORDER BY Note_Seq, Note_Id
   BEGIN
      i = i + 1;
   END;
/*
**  Load Note links for each sequence status.
*/
   FOR i = 1 TO CurObject.sList.LastRow() DO
      j = 1;
      REPEATED 
      SELECT  :CurObject.sList[i].Note[j].Note_Id = L.Note_Id,
              :CurObject.sList[i].Note[j].Note_Seq = N.Note_Seq
      FROM     CAC_Relay_Note_Link L,
               CAC_Relay_Note N
      WHERE    L.Grouping = :CurObject.Grouping AND
               L.Seq = :CurObject.sList[i].Seq AND
               L.Note_Id = N.Note_Id AND
               N.Grouping = :CurObject.Grouping
      ORDER BY Note_Seq, Note_Id
      BEGIN
         j = j + 1;
      END;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Relay protection matrix info
*/
   CurObject.iList.Clear();
   i = 1;
   REPEATED 
   SELECT  :CurObject.iList[i].RelayProtection = R.RelayProtection,
           :CurObject.iList[i].BackupRelay = R.BackupRelay,
           :CurObject.iList[i].TransferTrip = R.TransferTrip,
           :CurObject.iList[i].FeederName = R.FeederName,
           :CurObject.iList[i].Sequence = R.Sequence
   FROM    CAC_Relay_Info R
   WHERE   R.Grouping = :CurObject.Grouping
   ORDER BY Sequence
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Matrix data
*/
   CurObject.mList.Clear();
   i = 1;
   WHILE i <= CurObject.cList.LastRow() DO
      IF i = 1 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col1 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col1 = Relay$OutofService THEN
               CurObject.mlist[j].Col1Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$InService THEN
               CurObject.mlist[j].Col1Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$Either THEN
               CurObject.mlist[j].Col1Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col1Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col1Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 2 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col2 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col2 = Relay$OutofService THEN
               CurObject.mlist[j].Col2Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$InService THEN
               CurObject.mlist[j].Col2Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$Either THEN
               CurObject.mlist[j].Col2Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col2Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col2Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 3 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col3 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col3 = Relay$OutofService THEN
               CurObject.mlist[j].Col3Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$InService THEN
               CurObject.mlist[j].Col3Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$Either THEN
               CurObject.mlist[j].Col3Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col3Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col3Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 4 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col4 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col4 = Relay$OutofService THEN
               CurObject.mlist[j].Col4Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$InService THEN
               CurObject.mlist[j].Col4Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$Either THEN
               CurObject.mlist[j].Col4Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col4Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col4Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 5 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col5 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col5 = Relay$OutofService THEN
               CurObject.mlist[j].Col5Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$InService THEN
               CurObject.mlist[j].Col5Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$Either THEN
               CurObject.mlist[j].Col5Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col5Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col5Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 6 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col6 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col6 = Relay$OutofService THEN
               CurObject.mlist[j].Col6Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$InService THEN
               CurObject.mlist[j].Col6Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$Either THEN
               CurObject.mlist[j].Col6Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col6Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col6Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 7 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col7 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col7 = Relay$OutofService THEN
               CurObject.mlist[j].Col7Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$InService THEN
               CurObject.mlist[j].Col7Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$Either THEN
               CurObject.mlist[j].Col7Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col7Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col7Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 8 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col8 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col8 = Relay$OutofService THEN
               CurObject.mlist[j].Col8Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$InService THEN
               CurObject.mlist[j].Col8Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$Either THEN
               CurObject.mlist[j].Col8Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col8Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col8Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 9 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col9 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col9 = Relay$OutofService THEN
               CurObject.mlist[j].Col9Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$InService THEN
               CurObject.mlist[j].Col9Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$Either THEN
               CurObject.mlist[j].Col9Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col9Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col9Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 10 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col10 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_Relay_Status RS 
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route = :CurObject.clist[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col10 = Relay$OutofService THEN
               CurObject.mlist[j].Col10Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$InService THEN
               CurObject.mlist[j].Col10Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$Either THEN
               CurObject.mlist[j].Col10Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col10Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col10Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  See if lastrow has all '*'.  If yes change Character to Letter 'A'
*/
   i = 1;
   j = CurObject.mlist.LastRow();
   ChangeLastRow = TRUE;
   WHILE i <= CurObject.cList.LastRow() DO
      IF i = 1 THEN
         IF CurObject.mlist[j].Col1 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 2 THEN
         IF CurObject.mlist[j].Col2 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 3 THEN
         IF CurObject.mlist[j].Col3 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 4 THEN
         IF CurObject.mlist[j].Col4 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 5 THEN
         IF CurObject.mlist[j].Col5 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 6 THEN
         IF CurObject.mlist[j].Col6 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 7 THEN
         IF CurObject.mlist[j].Col7 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 8 THEN
         IF CurObject.mlist[j].Col8 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 9 THEN
         IF CurObject.mlist[j].Col9 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      IF i = 10 THEN
         IF CurObject.mlist[j].Col10 <> Relay$Either THEN
            ChangeLastRow = FALSE;
            ENDLOOP;            
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   IF ChangeLastRow = TRUE THEN
      i = 1;
      WHILE i <= CurObject.cList.LastRow() DO
         IF i = 1 THEN
            CurObject.mlist[j].Col1 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col1Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 2 THEN
            CurObject.mlist[j].Col2 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col2Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 3 THEN
            CurObject.mlist[j].Col3 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col3Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 4 THEN
            CurObject.mlist[j].Col4 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col4Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 5 THEN
            CurObject.mlist[j].Col5 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col5Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 6 THEN
            CurObject.mlist[j].Col6 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col6Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 7 THEN
            CurObject.mlist[j].Col7 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col7Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 8 THEN
            CurObject.mlist[j].Col8 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col8Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 9 THEN
            CurObject.mlist[j].Col9 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col9Name = Relay$AllOtherConditionsName;
         ENDIF;
         IF i = 10 THEN
            CurObject.mlist[j].Col10 = Relay$AllOtherConditions;
            CurObject.mlist[j].Col10Name = Relay$AllOtherConditionsName;
         ENDIF;
         i = i + 1;
      ENDWHILE;
   ENDIF;
   /*
   **  Set ViewMode
   */
   CurObject.ViewMode = 0;
   /*
   **  Load diagram attachments 
   */
   CurObject.DList.Clear();
   i = 1;
   REPEATED 
   SELECT  :CurObject.DList[i].FileID = FileID,
           :CurObject.DList[i].FileName = FileName,
           :CurObject.DList[i].Grouping = Grouping
   FROM    CAC_Relay_Attachment
   WHERE   Grouping = :CurObject.Grouping
   ORDER BY FileID
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;



METHOD LoadCOMatrix (
)=
DECLARE
   Alist = ARRAY OF RelayGrouping;
   Blist = ARRAY OF RelayGrouping;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   MatrixCount = INTEGER NOT NULL;
   TempStationName = VARCHAR(60) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Load the Feeder list, circuit list, notes
** etc. for a matrix.  The matrix details will be loaded in the LoadMatrix 
** method.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was selected, please try again.';
      RETURN;     
   ENDIF;
/*
**  Load Revision Date for reports
*/
   SELECT :CurObject.RevisionDate = RevisionDate
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Feeder list
*/
   i = 1;
   CurObject.Flist.Clear();
   REPEATED
   SELECT :CurObject.Flist[i].Name = O.Name,
          :CurObject.Flist[i].Object = O.Object
   FROM   CAC_CO_Feeder RF,
          Udb_Object O
   WHERE  RF.Grouping = :CurObject.Grouping AND
          RF.Feeder = O.Object
   ORDER BY Name
   BEGIN
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Feeder
      WHERE   Feeder = :CurObject.Flist[i].Object;
      IF MatrixCount > 1 THEN
         CurObject.Flist[i].Name = CurObject.Flist[i].Name + ' (M)';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Circuit list
*/
   i = 1;
   CurObject.Clist.Clear();
   REPEATED
   SELECT :CurObject.CList[i].Object = O.Object,
          :CurObject.Clist[i].Name = O.Name,
          :CurObject.Clist[i].TypeName = O.TypeName,
          :CurObject.Clist[i].Route = T.Type,
          :CurObject.Clist[i].RouteName = T.Name,
          :CurObject.Clist[i].Seq = RC.Seq
   FROM   CAC_CO_Circuit RC,
          Udb_Object O,
          Udb_Type T
   WHERE  RC.Grouping = :CurObject.Grouping AND
          RC.Circuit = O.Object AND
          RC.Route = T.Type
   ORDER BY Seq
   BEGIN 
      /*
      **  If feeder has a grouper than show it.
      */ 
      SELECT :CurObject.Clist[i].GrouperName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_ExtendedType ET
      WHERE   G.Member = :CurObject.Clist[i].Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = ET.Type AND
              ET.SuperType = :Type$TelCardGrouper AND
              G.Grouping = O.Object;
      /*
      **  Put M if circuit on multiple matrices. 
      */
      SELECT :MatrixCount = COUNT(*)
      FROM    CAC_Relay_Circuit
      WHERE   Circuit = :CurObject.Clist[i].Object AND
              Route   = :CurObject.Clist[i].Route;
      IF MatrixCount > 1 THEN
         CurObject.Clist[i].Name = CurObject.Clist[i].Name + ' (M)';
      ENDIF;
      /*
      **  Get all of the substations and concatenate them into one field
      */
      TempStationName = '';
      REPEATED
      SELECT  :TempStationName = O.Name
      FROM    Udb_Grouping G,
              Udb_ExtendedType ET,
              Udb_Object O
      WHERE   G.Member = :CurObject.Clist[i].Object
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.Grouping = O.Object
      AND     G.GroupingType = ET.Type
      AND     ET.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
      BEGIN
         IF (CurObject.Clist[i].SubstationNames = '') THEN
             CurObject.Clist[i].SubstationNames = TempStationName;
         ELSE
             CurObject.Clist[i].SubstationNames = CurObject.Clist[i].SubstationNames + 
                                                  ', ' + TempStationName;
         ENDIF;
      END;
      CALLPROC DDB_ROLLBACK;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
**  Load Feeder, Equipment, and note information
*/
   CurObject.sList.Clear();
   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].FdrStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_CO_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Feeder
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].FdrStatus = Relay$Yes THEN
         CurObject.sList[i].FdrStatusName = Relay$YesName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$No THEN
         CurObject.sList[i].FdrStatusName = Relay$NoName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$STT THEN
         CurObject.sList[i].FdrStatusName = Relay$STTName;
      ELSEIF CurObject.sList[i].FdrStatus = Relay$Blank THEN
         CurObject.sList[i].FdrStatusName = Relay$BlankName;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].EquipStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_CO_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Equipment
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].EquipStatus = Relay$Yes THEN
         CurObject.sList[i].EquipStatusName = Relay$YesName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$No THEN
         CurObject.sList[i].EquipStatusName = Relay$NoName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$STT THEN
         CurObject.sList[i].EquipStatusName = Relay$STTName;
      ELSEIF CurObject.sList[i].EquipStatus = Relay$Blank THEN
         CurObject.sList[i].EquipStatusName = Relay$BlankName;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CompStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_CO_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Comparison
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CompStatus = Relay$GreaterThan THEN
         CurObject.sList[i].CompStatusName = Relay$GreaterThanName;
      ELSEIF CurObject.sList[i].CompStatus = Relay$Equal THEN
         CurObject.sList[i].CompStatusName = Relay$EqualName;
      ELSEIF CurObject.sList[i].CompStatus = Relay$LessThan THEN
         CurObject.sList[i].CompStatusName = Relay$LessThanName;
      ELSE  /* Default to 0 and '' */
         CurObject.sList[i].CompStatus = 0;
         CurObject.sList[i].CompStatusName = '';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CountStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_CO_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$Count
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CountStatus = 0 THEN
         CurObject.sList[i].CountStatusName = '';
      ELSE
         CurObject.sList[i].CountStatusName = Varchar(CurObject.sList[i].CountStatus);
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   REPEATED
   SELECT :CurObject.sList[i].CktStatus = RS.Status,
          :CurObject.sList[i].Seq = RS.Seq
   FROM   CAC_CO_Status RS
   WHERE  RS.Grouping = :CurObject.Grouping AND
          RS.Circuit = :Relay$CktStatus
   ORDER BY Seq
   BEGIN
      IF CurObject.sList[i].CktStatus = Relay$InService THEN
         CurObject.sList[i].CktStatusName = Relay$InServiceName;
      ELSEIF CurObject.sList[i].CktStatus = Relay$OutOfService THEN
         CurObject.sList[i].CktStatusName = Relay$OutOfServiceName;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

/*
**  Load Notes for Matrix.
*/
   i = 1;
   CurObject.nList.Clear();
   REPEATED
   SELECT :CurObject.nList[i].Note_Id = Note_Id,
          :CurObject.nList[i].Note_Seq = Note_Seq,
          :CurObject.nList[i].Note = Note
   FROM    CAC_CO_Note
   WHERE   Grouping = :CurObject.Grouping
   ORDER BY Note_Seq,Note_ID
   BEGIN
      i = i + 1;
   END;
/*
**  Load Note links for each sequence status.
*/
   FOR i = 1 TO CurObject.sList.LastRow() DO
      j = 1;
      REPEATED 
      SELECT  :CurObject.sList[i].Note[j].Note_Id = L.Note_Id,
              :CurObject.sList[i].Note[j].Note_Seq = N.Note_Seq
      FROM     CAC_CO_Note_Link L,
               CAC_CO_Note N
      WHERE    L.Grouping = :CurObject.Grouping AND
               L.Seq = :CurObject.sList[i].Seq AND
               L.Note_Id = N.Note_Id
      ORDER BY Note_Seq, Note_Id
      BEGIN
         j = j + 1;
      END;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Relay protection matrix info
*/
   CurObject.iList.Clear();
   i = 1;
   REPEATED 
   SELECT  :CurObject.iList[i].RelayProtection = R.RelayProtection,
           :CurObject.iList[i].BackupRelay = R.BackupRelay,
           :CurObject.iList[i].TransferTrip = R.TransferTrip,
           :CurObject.iList[i].FeederName = R.FeederName,
           :CurObject.iList[i].Sequence = R.Sequence
   FROM    CAC_CO_Info R
   WHERE   R.Grouping = :CurObject.Grouping
   ORDER BY Sequence
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
**  Load Matrix data
*/
   CurObject.mList.Clear();
   i = 1;
   WHILE i <= CurObject.cList.LastRow() DO
      IF i = 1 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col1 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.cList[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col1 = Relay$OutofService THEN
               CurObject.mlist[j].Col1Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$InService THEN
               CurObject.mlist[j].Col1Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$Either THEN
               CurObject.mlist[j].Col1Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col1Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col1 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col1Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 2 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col2 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col2 = Relay$OutofService THEN
               CurObject.mlist[j].Col2Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$InService THEN
               CurObject.mlist[j].Col2Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$Either THEN
               CurObject.mlist[j].Col2Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col2Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col2 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col2Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 3 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col3 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col3 = Relay$OutofService THEN
               CurObject.mlist[j].Col3Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$InService THEN
               CurObject.mlist[j].Col3Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$Either THEN
               CurObject.mlist[j].Col3Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col3Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col3 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col3Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 4 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col4 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col4 = Relay$OutofService THEN
               CurObject.mlist[j].Col4Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$InService THEN
               CurObject.mlist[j].Col4Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$Either THEN
               CurObject.mlist[j].Col4Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col4Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col4 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col4Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 5 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col5 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col5 = Relay$OutofService THEN
               CurObject.mlist[j].Col5Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$InService THEN
               CurObject.mlist[j].Col5Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$Either THEN
               CurObject.mlist[j].Col5Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col5Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col5 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col5Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 6 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col6 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col6 = Relay$OutofService THEN
               CurObject.mlist[j].Col6Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$InService THEN
               CurObject.mlist[j].Col6Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$Either THEN
               CurObject.mlist[j].Col6Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col6Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col6 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col6Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 7 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col7 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col7 = Relay$OutofService THEN
               CurObject.mlist[j].Col7Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$InService THEN
               CurObject.mlist[j].Col7Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$Either THEN
               CurObject.mlist[j].Col7Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col7Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col7 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col7Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 8 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col8 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col8 = Relay$OutofService THEN
               CurObject.mlist[j].Col8Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$InService THEN
               CurObject.mlist[j].Col8Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$Either THEN
               CurObject.mlist[j].Col8Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col8Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col8 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col8Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 9 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col9 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col9 = Relay$OutofService THEN
               CurObject.mlist[j].Col9Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$InService THEN
               CurObject.mlist[j].Col9Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$Either THEN
               CurObject.mlist[j].Col9Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col9Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col9 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col9Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      IF i = 10 THEN
         j = 1;
         REPEATED
         SELECT :CurObject.mlist[j].Col10 = RS.Status,
                :CurObject.mlist[j].Seq = RS.Seq    
         FROM   CAC_CO_Status RS 
         WHERE  RS.Grouping = :CurObject.Grouping AND
                RS.Circuit = :CurObject.clist[i].Object AND
                RS.Route   = :CurObject.cList[i].Route
         ORDER BY Seq
         BEGIN
            IF CurObject.mlist[j].Col10 = Relay$OutofService THEN
               CurObject.mlist[j].Col10Name = Relay$OutofServiceName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$InService THEN
               CurObject.mlist[j].Col10Name = Relay$InserViceName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$Either THEN
               CurObject.mlist[j].Col10Name = Relay$EitherName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$GrpCriteria THEN
               CurObject.mlist[j].Col10Name = Relay$GrpCriteriaName;
            ELSEIF CurObject.mlist[j].Col10 = Relay$StatusBlank THEN
               CurObject.mlist[j].Col10Name = Relay$StatusBlankName;
            ENDIF;
            j = j + 1;
         END;
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  Set view mode
*/
   CurObject.ViewMode = 1;

/*
**  Load diagram attachments 
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED 
   SELECT  :CurObject.DList[i].FileID = FileID,
           :CurObject.DList[i].FileName = FileName,
           :CurObject.DList[i].Grouping = Grouping
   FROM    CAC_CO_Attachment
   WHERE   Grouping = :CurObject.Grouping
   ORDER BY FileID
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

METHOD CheckOutOnly (
)=
DECLARE
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   COUserName = VARCHAR(40) NOT NULL;
   CurRevisionDate = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to insert/update row in 
** FMS_Security table.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.UserName = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No username supplied.';
      RETURN;           
   ENDIF;

   IF CurObject.Comment = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please enter a comment.';
      RETURN;           
   ENDIF;
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Matrix has been selected.  Please try again.';
      RETURN;     
   ENDIF;
/*
**  See if matrix is already checked out.
**  072004 pkw We are not updating the revision date at checkout ITC 136.
**             Select current revision date and pass it in to checkout 
**             matrix. Give up flexibility if we need to change again.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut,
          :CurRevisionDate = RevisionDate
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = '' THEN
      /* Check out matrix */   
      RetCode = CALLPROC CAC_Relay_CheckOut (
                  Grouping = CurObject.Grouping,
                  UserCheckOut = CurObject.UserName,
                  RevisionDate = CurRevisionDate,
                  Comment = CurObject.Comment
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(CurObject.Grouping) +
                       ' could not be checked out.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not check out matrix. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;

   ELSEIF COUserName = CurObject.UserName THEN   
      /* 
      ** user has already checked out Matrix.
      */         
   ELSE
      /*
      ** already checked out by someone else
      */
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Matrix is checked out to: ' + COUserName +
              '.  You must have ' + COUserName + ' check the matrix in before ' +
              'you can check it out.';
   ENDIF;

   RETURN;
END;

METHOD CheckOut (
)=
DECLARE
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   COUserName = VARCHAR(40) NOT NULL;
   CurRevisionDate = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to insert/update row in 
** FMS_Security table.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.UserName = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No username supplied.';
      RETURN;           
   ENDIF;

   IF CurObject.Comment = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please enter a comment.';
      RETURN;           
   ENDIF;
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Matrix has been selected.  Please try again.';
      RETURN;     
   ENDIF;
/*
**  See if matrix is already checked out.
**  072004 pkw We are not updating the revision date at checkout ITC 136.
**             Select current revision date and pass it in to checkout 
**             matrix. Give up flexibility if we need to change again.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut,
          :CurRevisionDate = RevisionDate
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = '' THEN
      /* Check out matrix */   
      RetCode = CALLPROC CAC_Relay_CheckOut (
                  Grouping = CurObject.Grouping,
                  UserCheckOut = CurObject.UserName,
                  RevisionDate = CurRevisionDate,
                  Comment = CurObject.Comment
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(CurObject.Grouping) +
                       ' could not be checked out.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not check out matrix. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*
      **  Load Checked Out matrix.
      */
      CurObject.LoadCOMatrix();
         
      RETURN;
   ELSE
      /* 
      ** If usernames match call load CO Matrix.
      ** If they don't, tell user they can't check out this matrix.
      */
      IF COUserName = CurObject.UserName THEN
         /*
         **  Load Checked Out matrix.
         */
         CurObject.LoadCOMatrix();
         
         RETURN;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Matrix is checked out to: ' + COUserName +
              '.  You must have ' + COUserName + ' check the matrix in before ' +
              'you can check it out.';
         RETURN;      
      ENDIF;
   ENDIF;
   RETURN;
END;

METHOD CheckIn (
)=
DECLARE
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   COUserName = VARCHAR(40) NOT NULL;
   CurRevisionDate = DATE NOT NULL WITH DEFAULT;
   LastComment     = VARCHAR(600) NOT NULL WITH DEFAULT;
   TempGrouping  = INTEGER NOT NULL;
   TempComment   = VARCHAR(600) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to check in Matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.UserName = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No username supplied.';
      RETURN;           
   ENDIF;
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was selected.  Please try again.';
      RETURN;     
   ENDIF;
/*
**  See if matrix is already checked out.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName THEN
      IF CurObject.SaveChanges = 1 THEN
         /*
         **  First see if any circuits or Feeder are in a condition
         **  where protection was manually overridden to a red condition.
         **  First look for feeders
         */
         TempGrouping = 0;
         SELECT DISTINCT
                :TempGrouping = G.Grouping,
                :TempComment  = G.Comment
         FROM    CAC_Relay_Grouping G,
                 CAC_CO_Feeder F1,
                 CAC_CO_Feeder F2
         WHERE   F1.Grouping = :CurObject.Grouping AND
                 F1.Feeder = F2.Feeder AND
                 F2.Grouping <> :CurObject.Grouping AND
                 F2.Grouping = G.Grouping AND
                 G.DOOverRide = :RPM$OverRideToRed
         BEGIN
            /*
            **  Remove circuit/feeder info.
            */
            RetCode = CALLPROC CAC_CO_GroupingDel
                     (Grouping   = TempGrouping);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(TempGrouping) +
                       ' Could not clear OverRide details.');
            ENDIF;
            CALLPROC DDB_COMMIT;
            /*
            **  Remove grouping info.
            */
            RetCode = CALLPROC CAC_Relay_GroupingDel
                     (Grouping   = TempGrouping);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(TempGrouping) +
                       ' Could not clear OverRide.');
            ENDIF;
            CALLPROC DDB_COMMIT;
            /*
            **  Log the event for historical purposes.
            */
            TempComment = 'Cleared (Added to Matrix) - ' + TempComment;
            RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                         Grouping = TempGrouping, 
                         UserName = 'RPM Interface',
                         LogDate = date('now'),
                         LogType = RPM$OverRideToRed,
                         Comment = TempComment);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace(Text = VARCHAR(DATE('now')) + 
                  'CLASS:RPM_ASE:Error logging Clear OverRide to Red condition.');
            ENDIF;
            CALLPROC DDB_COMMIT;  
         END;      
         /*
         **  Now look for circuits.
         */       
         TempGrouping = 0;
         SELECT DISTINCT
                :TempGrouping = G.Grouping,
                :TempComment  = G.Comment
         FROM    CAC_Relay_Grouping G,
                 CAC_CO_Circuit C1,
                 CAC_CO_Circuit C2
         WHERE   C1.Grouping = :CurObject.Grouping AND
                 C1.Circuit = C2.Circuit AND
                 C2.Grouping <> :CurObject.Grouping AND
                 C2.Grouping = G.Grouping AND
                 G.DOOverRide = :RPM$OverRideToRed
         BEGIN
            /*
            **  Remove circuit/feeder info.
            */
            RetCode = CALLPROC CAC_CO_GroupingDel
                     (Grouping   = TempGrouping);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(TempGrouping) +
                       ' Could not clear OverRide details.');
            ENDIF;
            CALLPROC DDB_COMMIT;
            /*
            **  Remove grouping info.
            */
            RetCode = CALLPROC CAC_Relay_GroupingDel
                     (Grouping   = TempGrouping);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(TempGrouping) +
                       ' Could not clear OverRide.');
            ENDIF;
            CALLPROC DDB_COMMIT;
            /*
            **  Log the event for historical purposes.
            */
            TempComment = 'Cleared (Added to Matrix) - ' + TempComment;
            RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                         Grouping = TempGrouping, 
                         UserName = 'RPM Interface',
                         LogDate = date('now'),
                         LogType = RPM$OverRideToRed,
                         Comment = TempComment);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace(Text = VARCHAR(DATE('now')) + 
                  'CLASS:RPM_ASE:Error logging Clear OverRide to Red condition.');
            ENDIF;
            CALLPROC DDB_COMMIT;  
         END;             
         /* 
         **  Check in matrix.  This call delete all rows in production 
         **  and copies data from temporary tables.
         */   
         RetCode = CALLPROC CAC_Relay_CheckIn (
                  Grouping = CurObject.Grouping,
                  RevisionDate = CurObject.RevisionDate,
                  Comment = CurObject.Comment
                  );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(CurObject.Grouping) +
                       ' could not be checked in.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not check in matrix. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
         CALLPROC DDB_COMMIT;
      ELSE
         /*
         **  Get last checked in comment and current revision date.
         */
         LastComment = '';
         SELECT :LastComment = H1.Comment
         FROM    CAC_Relay_GroupingHistory H1
         WHERE   H1.Grouping = :CurObject.Grouping AND
                 H1.LogDate = (SELECT MAX(H2.LogDate)
                               FROM   CAC_Relay_GroupingHistory H2
                               WHERE  H2.Grouping = :CurObject.Grouping);
         CALLPROC DDB_ROLLBACK;

         SELECT :CurRevisionDate = RevisionDate
         FROM    CAC_Relay_Grouping
         WHERE   Grouping = :CurObject.Grouping;
         CALLPROC DDB_ROLLBACK;
         
         RetCode = CALLPROC CAC_Relay_GroupingIns (
                  Grouping = CurObject.Grouping,
                  RevisionDate = CurRevisionDate,
                  Comment = LastComment
                  );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(CurObject.Grouping) +
                       ' could not be released.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not release matrix. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
      
      RetCode = CALLPROC CAC_CO_GroupingDel (
                  Grouping = CurObject.Grouping
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Unable to remove data in temporary tables.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not remove data from temporary tables ' +
               'for matrix ' + varchar(CurObject.Grouping) + '. ' +
               'Please report problem to technical support.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;
      
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Matrix is checked out to: ' + COUserName +
           '.  You can not check in matrix.';
      RETURN;      
   ENDIF;
   RETURN;
END;


METHOD CheckLoadMatrix (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   COUserName = VARCHAR(40) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to determine which version 
** of the matrix to load.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.UserName = '' THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No username supplied.';
      RETURN;           
   ENDIF;
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was selected.  Please try again.';
      RETURN;     
   ENDIF;
/*
**  See if matrix is already checked out.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName AND
      COUserName <> '' AND
      CurObject.ViewMode = 1 THEN
      /*
      **  Load Checked Out matrix.
      */
      CurObject.LoadCOMatrix();

      RETURN;
   ELSE
      /* 
      **  Load matrix.
      */
      CurObject.LoadMatrix();
      RETURN;
   ENDIF;
   RETURN;
END;


METHOD StatusIns (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   COUserName = VARCHAR(40) NOT NULL;
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update a status of a matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.slist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No updates were made.  Please try again.';
      RETURN;
   ENDIF;

/*
**  See if matrix is checked out to this user.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName THEN
      FOR i = 1 to CurObject.sList.LastRow() DO
         RetCode = CALLPROC CAC_CO_StatusIns (
                     Grouping = CurObject.Grouping,
                     Circuit = CurObject.sList[i].Circuit,
                     Route = CurObject.sList[i].Route,
                     Seq = CurObject.sList[i].Seq,
                     Status = CurObject.sList[i].Status
                     );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Matrix ' + varchar(CurObject.Grouping) +
                          ' status could not be updated.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not update status. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'You are not the user who has this matrix ' +
                'checked out and cannot make updates to it.';
      RETURN;
   ENDIF;
   RETURN;
END;


