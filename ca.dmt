METHOD RetrieveWorkPermit (
   Job		= INTEGER NOT NULL
) =
DECLARE

ENDDECLARE
BEGIN
   IF ArchiveCard = FALSE THEN
      SELECT :CurObject.PermitJobID = PermitJobID
            ,:CurObject.Description = Description
            ,:CurObject.EstTimeComplete = EstTimeComplete
            ,:CurObject.PhaseCheckIndicator = PhaseCheckIndicator
            ,:CurObject.Restoration = Restoration
            ,:CurObject.Sequence = Sequence
            ,:CurObject.Warning = Warning
            ,:CurObject.ProtectionRequired = ProtectionRequired
            ,:CurObject.PreIssued = PreIssued
            ,:CurObject.ShiftStartTime = ShiftStartTime
            ,:CurObject.AllRelaysNormal = AllRelaysNormal
            ,:CurObject.DefectRelayComment = DefectRelayComment
      FROM   SOA_WorkPermit
      WHERE  PermitJobID = :Job;
   ELSE
      SELECT :CurObject.PermitJobID = PermitJobID
            ,:CurObject.Description = Description
            ,:CurObject.EstTimeComplete = EstTimeComplete
            ,:CurObject.PhaseCheckIndicator = PhaseCheckIndicator
            ,:CurObject.Restoration = Restoration
            ,:CurObject.Sequence = Sequence
            ,:CurObject.Warning = Warning
            ,:CurObject.PreIssued = PreIssued
            ,:CurObject.ShiftStartTime = ShiftStartTime
            ,:CurObject.AllRelaysNormal = AllRelaysNormal
            ,:CurObject.DefectRelayComment = DefectRelayComment
      FROM   SOA_ArchiveWorkPermit
      WHERE  PermitJobID = :Job;
   ENDIF;

   IF iirowcount = 0 THEN
      RETURN NULL;
   ENDIF;

   CALLPROC DDB_ROLLBACK;
   RETURN :CurObject;
END;


METHOD UpdateWorkPermit (
   PermitJobID	= INTEGER NOT NULL
) =
DECLARE
   RetCode	= INTEGER NOT NULL WITH DEFAULT;
   Existence    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** If it exists, update; if not, insert.
*/
   Existence = 0;
   SELECT   :Existence = PermitJobID
   FROM     SOA_WorkPermit
   WHERE    PermitJobID = :PermitJobID;

   IF Existence = 0 THEN

      RetCode = CALLPROC SOA_WorkPermitIns (
          PermitJobID 	= PermitJobID
         ,Description 	= :CurObject.Description
         ,EstTimeComplete = :CurObject.EstTimeComplete
         ,PhaseCheckIndicator = :CurObject.PhaseCheckIndicator
         ,Restoration = :CurObject.Restoration
         ,Sequence = :CurObject.Sequence
         ,Warning = :CurObject.Warning
         ,ProtectionRequired = :CurObject.ProtectionRequired
         ,PreIssued = :CurObject.PreIssued
         ,ShiftStartTime = :CurObject.ShiftStartTime
         );

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'Insert into SOA_WorkPermit was not successful.',
                           TraceMessage =
             'WorkPermit:UpdateWorkPermit; Insert into SOA_WorkPermit was not successful.'
             );
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
         RETURN PU_OK;
      ENDIF;
   ELSE

      RetCode = CALLPROC SOA_WorkPermitUpd (
          PermitJobID 	= PermitJobID
         ,Description 	= :CurObject.Description
         ,EstTimeComplete = :CurObject.EstTimeComplete
         ,PhaseCheckIndicator = :CurObject.PhaseCheckIndicator
         ,Restoration = :CurObject.Restoration
         ,Sequence = :CurObject.Sequence
         ,Warning = :CurObject.Warning
         ,ProtectionRequired = :CurObject.ProtectionRequired
         ,PreIssued = :CurObject.PreIssued
         ,ShiftStartTime = :CurObject.ShiftStartTime
         );

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'Update of SOA_WorkPermit was not successful.',
                           TraceMessage =
             'WorkPermit:UpdateWorkPermit; Update of SOA_WorkPermit was not successful.'
             );
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
         RETURN PU_OK;
      ENDIF;
   ENDIF;
END;

