/*
**  Application:    SOA
**  Class:          CardSOA
**
**  Date:       Author   Description
** ----------------------------------
**  09/28/98    pkw      created
**  03/25/05    em       use active tables for Closed Steam card.
**  12/13/23    em       Add EnteredBy and EnteredByName attributes.
*/
METHOD LoadCardLog(
   Card          = INTEGER NOT NULL;
   SwitchingItem = INTEGER NOT NULL;
)=  
DECLARE 
   CardLog = ARRAY OF CardLogClass;
   i       = INTEGER NOT NULL WITH DEFAULT;
   m       = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF Card = 0 THEN
      RETURN(NULL);
   ENDIF;
    
   IF ArchiveCard = FALSE OR CurrentApplication = Application$SDS THEN
      i = 1; 
      m = 0;
      SELECT :CardLog[i].Card = CL.Card, 
             :CardLog[i].SwitchingItem = CL.SwitchingItem, 
             :CardLog[i].Log = CL.Log, 
             :CardLog[i].LogStatus = CL.LogStatus, 
             :CardLog[i].LogTime = CL.LogTime, 
             :CardLog[i].EnteredBy = CL.EnteredBy, 
             :CardLog[i].EnteredByName = O.Description 
      FROM   SOA_CardLog CL,
             Udb_Object O 
      WHERE  CL.Card = :Card AND
             CL.SwitchingItem = :SwitchingItem AND
             CL.EnteredBy = O.Object
      ORDER BY LogTime DESC
      BEGIN 
         IF CardLog[i].LogStatus = 'INCOMPLETE' THEN
            m = i;
         ENDIF;
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;
   ELSE
      i = 1; 
      m = 0;
      SELECT :CardLog[i].Card = CL.Card, 
             :CardLog[i].SwitchingItem = CL.SwitchingItem, 
             :CardLog[i].Log = CL.Log, 
             :CardLog[i].LogStatus = CL.LogStatus, 
             :CardLog[i].LogTime = CL.LogTime, 
             :CardLog[i].EnteredBy = CL.EnteredBy, 
             :CardLog[i].EnteredByName = O.Description 
      FROM   SOA_ArchiveCardLog CL,
             Udb_Object O  
      WHERE  CL.Card = :Card AND
             CL.SwitchingItem = :SwitchingItem AND
             CL.EnteredBy = O.Object
      ORDER BY LogTime DESC
      BEGIN 
         IF CardLog[i].LogStatus = 'INCOMPLETE' THEN
            m = i;
         ENDIF;
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
   RETURN(CardLog);
END;

