*/
METHOD SaveEquip (
) =
DECLARE
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC OSS_ImpactedEquipIns (
           RequestID = CurObject.RequestID
         , WorkItem = CurObject.WorkItem
         , Equip = CurObject.Equip);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_ImpactedEquip.SaveEquip; Error saving OSS Impacted Equip';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_ImpactedEquip.SaveEquip; ' + 
                'Error saving OSS Impacted Equip');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;


METHOD RemoveEquip (
) =
DECLARE
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC OSS_ImpactedEquipDel (
           RequestID = CurObject.RequestID
         , WorkItem = CurObject.WorkItem
         , Equip = CurObject.Equip);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_ImpactedEquip.RemoveEquip; Error deleting OSS Impacted Equip';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_ImpactedEquip.RemoveEquip; ' + 
                'Error deleting OSS Impacted Equip');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END; 

