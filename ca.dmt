Application Component Report
============================

	Name:            ATSLoad


���pXM��Component Method Scripts
���pXM��--------------------------
/*
**
**	Copyright c 2001 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Class:          ATSLoad
**
**  Date:       Author   Description
** ----------------------------------
**  05/14/08    pkw      Created
**  09/04/15    em       Rework select to get the ATS equip supertype 
**                       to use for DBF status setting
**  09/08/15    em       Need to be careful because getting two supertype rows
**                       because of hierarchy. Need to refocus and just get LoadP
**                       if it exists.
**                       
*/
METHOD CheckATSLoad(
   Object    = INTEGER NOT NULL;
   IsFeeder  = INTEGER NOT NULL;
)=
DECLARE
   i        = INTEGER NOT NULL;
   j        = INTEGER NOT NULL;
   Supply   = ARRAY OF INTEGEROBJECT;
   NewStatusCO = INTEGER NOT NULL;
   OldStatusCO = INTEGER NOT NULL;
   OldCutIn = DATE NOT NULL WITH DEFAULT;
   TempDate = DATE NOT NULL WITH DEFAULT;
   TempObject = INTEGER NOT NULL;
   CurJob = JobInProgress;     
   RetCode = INTEGER NOT NULL;
   FMS_NewCard = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   IF Object = 0 THEN
      RETURN;
   ENDIF;
/*
** Read the card in
*/  
   IF IsFeeder = TRUE THEN
      /*
      **  g1.grouping = feeder
      **  g1.member   = ATS Grouper
      **  g2.member   = ATS Load Equipment
      **  g3.grouping = ATS Load Feeder Joined to active object table.
      */
      i = 1;
      CurObject.ATS.Clear();
      REPEATED
      SELECT DISTINCT
             :CurObject.ATS[i].Object = G1.Member,
             :CurObject.LoadEquip[i].Object = G2.member,
             :CurObject.LoadFdr[i].Object = G3.Grouping,
             :CurObject.LoadFdr[i].Name = C.FeederName,
             :CurObject.LoadFdr[i].PrimaryGrouping = C.Card,
             :CurObject.LoadFdr[i].Type = C.CardClass,
             :CurObject.LoadFdr[i].TypeName = C.CardClassName
      FROM    Udb_Grouping G1,
              Udb_Grouping G2,
              Udb_grouping G3,
              SOA_ActiveObject AO,
              Udb_ExtendedType ET,
              FMS_Card C
      WHERE   G1.Grouping = :Object AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.MemberType IN (SELECT Type 
                                FROM   Udb_ExtendedType 
                                WHERE  SuperType = :Type$ATSGrouper) AND
              G1.Member = G2.Grouping AND 
              G2.Relationship = :Interaction$MemberOf AND
              G2.MemberType = ET.Type AND
              ET.SuperType IN (                      :Type$ATSLoad, 
                                                     :Type$ATSLoadP,
                                                     :Object$ATSLoad13KV,
                                                     :Object$ATSLoad33KV,
                                                     :Object$ATSLoadBronx) AND
              G2.Member = G3.Member AND 
              G3.Relationship = :Interaction$MemberOf AND
              G3.GroupingType IN (SELECT Type
                                  FROM   Udb_ExtendedType
                                  WHERE  SuperType = :Type$Feeder) AND
              G3.Grouping = AO.Object AND
              AO.Card = C.Card
      BEGIN
         CurObject.LoadEquip[i].Type = 0;
         REPEATED
         SELECT :CurObject.LoadEquip[i].Type = ET.SuperType
         FROM   Udb_ExtendedType ET,
                Udb_Object O
         WHERE  O.Object = :CurObject.LoadEquip[i].Object AND
                O.Type = ET.Type AND
                ET.SuperType = :Type$ATSLoadP;
         i = i + 1;
      END;
   ELSE
      /*
      **  g2.Grouping = ATS Grouper
      **  g2.member   = ATS Load Equipment
      **  g3.grouping = ATS Load Feeder Joined to active object table.
      */
      i = 1;
      CurObject.ATS.Clear();
      REPEATED
      SELECT DISTINCT
             :CurObject.ATS[i].Object = G2.Grouping,
             :CurObject.LoadEquip[i].Object = G2.member,
             :CurObject.LoadFdr[i].Object = G3.Grouping,
             :CurObject.LoadFdr[i].Name = C.FeederName,
             :CurObject.LoadFdr[i].PrimaryGrouping = C.Card,
             :CurObject.LoadFdr[i].Type = C.CardClass
      FROM    Udb_Grouping G2,
              Udb_grouping G3,
              SOA_ActiveObject AO,
              Udb_ExtendedType ET,
              FMS_Card C
      WHERE   G2.Grouping = :Object AND 
              G2.Relationship = :Interaction$MemberOf AND
              G2.MemberType = ET.Type AND
              ET.SuperType IN (                      :Type$ATSLoad, 
                                                     :Type$ATSLoadP,
                                                     :Object$ATSLoad13KV,
                                                     :Object$ATSLoad33KV,
                                                     :Object$ATSLoadBronx) AND
              G2.Member = G3.Member AND 
              G3.Relationship = :Interaction$MemberOf AND
              G3.GroupingType IN (SELECT Type
                                  FROM   Udb_ExtendedType
                                  WHERE  SuperType = :Type$Feeder) AND
              G3.Grouping = AO.Object AND
              AO.Card = C.Card
      BEGIN
         CurObject.LoadEquip[i].Type = 0;
         REPEATED
         SELECT :CurObject.LoadEquip[i].Type = ET.SuperType
         FROM   Udb_ExtendedType ET,
                Udb_Object O
         WHERE  O.Object = :CurObject.LoadEquip[i].Object AND
                O.Type = ET.Type AND
                ET.SuperType = :Type$ATSLoadP;
         i = i + 1;
      END;       
   ENDIF;
   /*
   **  Now we have a list of ATS Load Feeders that have active cards.
   **  For each Load Feeder look at statuses of supply side feeders to determine
   **  if load side should be cutout or cutin. 
   */
   FOR j = 1 TO CurObject.ATS.LastRow DO
      i = 1;
      Supply.Clear();
      SELECT :TempObject = G.Member,  /* Supply Equip 101/102 */
             :Supply[i].Value = S.CurrentlyOpen
      FROM    Udb_Grouping G,
              Udb_Switch S
      WHERE   G.Grouping = :CurObject.ATS[j].Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member <> :CurObject.LoadEquip[j].Object AND
              G.Member = S.Object
      BEGIN 
         IF Supply[i].Value = 0 THEN
            SELECT :Supply[i].Value = COUNT(*)
            FROM    FMS_ObjectStatus OS,
                    Udb_Grouping G
            WHERE   G.Member = :TempObject AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType IN (SELECT Type
                                       FROM   Udb_ExtendedType
                                       WHERE  SuperType = :Type$Feeder) AND
                    G.Grouping = OS.Object AND
                    OS.Status = :Status$CO;
         ENDIF;
         i = i + 1;
      END;
      /*
      **  Find out if Load side Feeder is cutout.
      */
      OldStatusCO = FALSE;
      SELECT :OldStatusCO = :TRUE 
      FROM    FMS_ObjectStatus OS 
      WHERE   OS.Object = :CurObject.LoadFdr[j].Object AND
              OS.Status = :Status$CO;
      /*
      **  Determine if what load side feeder status should be based on 
      **  Supply feeders and switch statuses.
      */
      NewStatusCO = TRUE;
      FOR i = 1 TO Supply.Lastrow DO
         IF Supply[i].Value = 0 THEN
            NewStatusCO = FALSE;
            ENDLOOP;
         ENDIF;
      ENDFOR;
      /*
      **  Compare values.  If they are the same we are done with this ATS.
      */
      IF NewStatusCO = OldStatusCO THEN
         CurMethod.Trace('No updates needed for ATS Load Feeder ' + CurObject.LoadFdr[j].Name);            
         CONTINUE;
      
      ELSEIF NewStatusCO = FALSE AND OldStatusCO = TRUE THEN
         /* CUTIN ATS Load Feeder */
         /* Set up needed job values */
         CurJob.Equip = CurObject.LoadEquip[j].Object;
         CurJob.EquipClass = CurObject.LoadEquip[j].Type;
         CurJob.EquipName = 'ATS Load';
         CurJob.RSComplete = Date('now');
             
         RetCode = CALLFRAME PromptCutin (JIP = CurJob,
                                          NoATSLoad = TRUE);
         
         IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (UserMessage = '',
                        TraceMessage =
            'Class:ATSLoad;Method:CheckATSLoad; ' +
            'Job Action PromptCutin did not complete successfully ' +
            ' for Feeder ' + CurObject.LoadFdr[j].Name + '.'
            );
         ELSE
            CurMethod.Trace('ATS Load Feeder ' + CurObject.LoadFdr[j].Name +
               ' was cutin successfully.');            
         ENDIF;
      
      ELSEIF NewStatusCO = TRUE AND OldStatusCO = FALSE THEN
         /*  Make sure card hasn't already been cutin */
         OldCutin = '';
         SELECT :OldCutIn = IFNULL(C.Cutin,'')
         FROM    FMS_Card C,
                 SOA_ActiveObject AO
         WHERE   AO.Object = :CurObject.LoadFdr[j].Object AND 
                 AO.Card = C.Card;
         IF OldCutin = '' THEN
            /* CUTOUT ATS Load Feeder */
            /* Set up needed job values */
            CurJob.Equip = CurObject.LoadEquip[j].Object;
            CurJob.EquipClass = CurObject.LoadEquip[j].Type;
            CurJob.EquipName = 'ATS Load';
            CurJob.ToComplete = Date('now');
             
            RetCode = CALLFRAME PromptCutout (JIP = CurJob,
                                              NoATSLoad = TRUE);
            
            IF RetCode = PU_CANCEL THEN
               CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:ATSLoad;Method:CheckATSLoad; ' +
               'Job Action PromptCutout did not complete successfully ' +
               ' for Feeder ' + CurObject.LoadFdr[j].Name + '.'
               );
            ELSE
               CurMethod.Trace('ATS Load Feeder ' + CurObject.LoadFdr[j].Name +
                  ' was cutout successfully.');            
            ENDIF;
         ELSE
            /*
            **  Check if there are outstanding moves on the card.  If no outstanding
            **  moves, close the card.  If there are outstaning moves create a transfer
            **  card and Cutout the new card.
            */
            i = 0;
            SELECT :i = COUNT(*) 
            FROM    SOA_Job J,
                    SOA_JobControl JC,
                    SOA_ActiveObject AO
            WHERE   AO.Object = :CurObject.LoadFdr[j].Object AND
                    AO.Card = JC.Card AND
                    JC.Job = J.Job AND
                    J.Status = '' AND
                    J.ControlCard = AO.Card AND 
                    J.MoveCategory = :MoveCategory$Normal AND
                  ((J.TOIssued IS NOT NULL AND J.TOIssued <> '') OR
                   (J.RSIssued IS NOT NULL AND J.RSIssued <> '')) AND
                   (J.TOComplete IS NULL OR 
                    J.RSComplete IS NULL);
            IF i <> 0 THEN
               RetCode = CALLFRAME CreateXferCard
                    (OldCardID    = CurObject.LoadFdr[j].PrimaryGrouping, 
                     XferCardKey = byref(FMS_NewCard),
                     XferCardClass = CurObject.LoadFdr[j].Type,
                     XferOpenCard = 0,
                     XferCutout = NULL);
               
               IF RetCode = PU_OK THEN 
                  CALLPROC DDB_COMMIT;
                  FCFrame.SendUserEvent(EventName = 'UpdateActiveList');
               
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 'Unable to Create New Card for ' + 
                                       CurObject.LoadFdr[j].Name,
                           TraceMessage =
                  'Class:ATSLoad;Method:CheckATSLoad; ' +
                  'CreateXferCard did not complete successfully ' +
                  ' for Feeder ' + CurObject.LoadFdr[j].Name + '.'
                  );
               ENDIF; 
               /*  Now cutout card */
               /* CUTOUT ATS Load Feeder */
               /* Set up needed job values */
               CurJob.Equip = CurObject.LoadEquip[j].Object;
               CurJob.EquipClass = CurObject.LoadEquip[j].Type;
               CurJob.EquipName = 'ATS Load';
               CurJob.ToComplete = Date('now');
             
               RetCode = CALLFRAME PromptCutout (JIP = CurJob,
                                                 NoATSLoad = TRUE);
            
               IF RetCode = PU_CANCEL THEN
                  CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                  'Class:ATSLoad;Method:CheckATSLoad; ' +
                  'Job Action PromptCutout did not complete successfully ' +
                  ' for Feeder ' + CurObject.LoadFdr[j].Name + '.'
                  );
               ELSE
                  CurMethod.Trace('ATS Load Feeder ' + CurObject.LoadFdr[j].Name +
                     ' was cutout successfully.');            
               ENDIF;

            ELSE
               TempDate = 'now';
               IF FMS_CloseCard_Proc IS NOT NULL THEN

                  FMS_CloseCard_Proc.Call(RetCode = ByRef(RetCode),
                               Closed = TempDate,
                               CardStatus = Card$Active,
                               Feeder = CurObject.LoadFdr[j].Object,
                               ISOType = Type$ISOFeeder,
                               Card = CurObject.LoadFdr[j].PrimaryGrouping);
                
                  IF (RetCode <> 0) THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 'Unable to Close Card for ' + 
                                       CurObject.LoadFdr[j].Name,
                              TraceMessage =
                     'Class:ATSLoad;Method:CheckATSLoad; ' +
                     'CloseCard did not complete successfully ' +
                     ' for Feeder ' + CurObject.LoadFdr[j].Name + '.'
                     );
                     CONTINUE;
                  ENDIF;
               ENDIF;
               
               RetCode = CALLPROC FMS_CloseCard
                      (Status = Card$Closed,
                       Closed = TempDate,
                       Card = CurObject.LoadFdr[j].PrimaryGrouping);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 'Unable to change card status for ' + 
                                       CurObject.LoadFdr[j].Name + ' to closed.',
                           TraceMessage =
                  'Class:ATSLoad;Method:CheckATSLoad; ' +
                  'FMS_CloseCard did not complete successfully ' +
                  ' for card ' + varchar(CurObject.LoadFdr[j].PrimaryGrouping) + '.'
                  );
                  CONTINUE;
               ELSE
                  CALLPROC SOA_LogIns (
                     Card = CurObject.LoadFdr[j].PrimaryGrouping,
                     Job  = NULL,
                     SwitchingItem = 0,
                     Time = DATE('Now'), 
                     UserName = UserName,
                     Item = 'Closed',
                     Old  = '',
                     New  = IFNULL(TempDate,''));
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;

   ENDFOR;
   RETURN;
END;

Application Component Report
============================

	Name:            AutoFODIssue

/*
**      Copyright c 2007 Pateric Software LLC  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  AutoFODIssue
**
**  Date:     Version  Description
** --------------------------------------------------
**  06/19/07  em       Created
**                     This procedure will take the passed Card and JobClass,
**                     look for an issued move with JobClass on that card.
**                     If it exists, done.  If not, checks for an unissued
**                     move.  If it does not exist, one will be inserted.
**                     The unissued move (or the new move) will then
**                     be issued and downloaded on an FOD Order.
**  09/12/18  em       Add optional Equip parameter
*/
PROCEDURE AutoFODIssue
(
    Card = INTEGER NOT NULL;     	/*Required Parameter*/
    TypeOfCard = INTEGER NOT NULL;     	/*Required Parameter*/
    FODJobClass = INTEGER NOT NULL;	/*Required Parameter*/
    OrderComment = VARCHAR(500) NOT NULL WITH DEFAULT;  /*Optional Comment*/
    Equip = FMS_Equip DEFAULT NULL;                /* Optional Equipment Parm */

    FODOrder = IR_FODOrder;
    J = Job;

    EquipObj = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
)= 
BEGIN 
/*
** Evaluate if Equip was passed to set Equip Obj
*/
   IF Equip IS NULL THEN
      EquipObj = 0;
   ELSE
      EquipObj = Equip.Equip;
   ENDIF;
   
   J.Job = 0;
   REPEATED
   SELECT :J.Job = J.Job
   FROM   SOA_JobControl JC,
          SOA_Job J
   WHERE  JC.Card = :Card AND
          JC.Job = J.Job AND
          J.Status = '' AND
          J.JobClass = :FODJobClass AND
          J.Equip = :EquipObj AND
          J.TOIssued IS NOT NULL;
   
   IF J.Job > 0 THEN
      RETURN;  /*Move exists on card and has been issued*/
   ENDIF;
 
   J.Job = 0;   
   REPEATED
   SELECT :J.Job = J.Job,
          :J.Equip = J.Equip,
          :J.EquipName = J.EquipName,
          :J.EquipClass = J.EquipClass,
          :J.EquipClassName = J.EquipClassName,
          :J.PrintID = JC.PrintID,
          :J.Grounds = J.Grounds,
          :J.GroundOn = J.GroundOn,
          :J.Substation = J.Substation,
          :J.DeskName = J.DeskName,
          :J.ControlCard = J.ControlCard,
          :J.Card = JC.Card,
          :J.Status = J.Status, 
          :J.JobClass = J.JobClass,
          :J.MoveType = J.MoveType,
          :J.TOMove = J.TOMove,
          :J.TOMoveRules = J.TOMoveRules,
          :J.RSMove = J.RSMove,
          :J.RSMoveRules = J.RSMoveRules,
          :J.MoveEquipClass = JC.MoveEquipClass,
          :J.StepPair = JC.StepPair
   FROM   SOA_JobControl JC,
          SOA_Job J
   WHERE  JC.Card = :Card AND
          JC.Job = J.Job AND
          J.Status = '' AND
          J.JobClass = :FODJobClass AND
          J.Equip = :EquipObj AND
          J.TOIssued IS NULL;

   IF J.Job = 0 THEN
/* 
** Must insert it.
*/
      J.Card = Card;
      
      IF Equip IS NULL THEN
         J.Equip = 0;
         J.EquipName = '';
         J.EquipClass = 0;
         J.EquipClassName = '';
         J.PrintID = '';
      ELSE
         J.Equip = Equip.Equip;
         J.EquipName = Equip.EquipName;
         J.EquipClass = Equip.EquipClass;
         J.EquipClassName = Equip.EquipClassName;
         J.PrintID = Equip.PrintID;
      ENDIF;
      
      J.Grounds = NULL;
      J.GroundOn = NULL;
      J.Substation = 0;
      J.DeskName = '';
      J.ControlCard = Card;

      SELECT J.Job = -1,
             J.Seq = -1,
             J.Status = '', 
             J.JobClass = JC.JobClass,
             J.MoveType = JC.MoveType,
             J.TOMove = JC.TOMove,
             J.TOMoveRules = JC.TOMoveRules,
             J.RSMove = JC.RSMove,
             J.RSMoveRules = JC.RSMoveRules,
             J.MoveFGColor = :CC_BLACK,
             J.Response = '',
             J.MoveEquipClass = JCC.EquipClass,
             J.StepPair = JCC.StepPair
      FROM   FMS_JobClass JC,
             FMS_JobClassControl JCC
      WHERE  JC.JobClass = :FODJobClass AND
             JC.JobClass = JCC.JobClass AND
             JCC.TypeOfCard = :TypeOfCard;

      J.Job = J.InsertMove (
                    CardTypeOfCard = TypeOfCard);

      IF J.Job < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Insert Move for automatic FOD Order.';
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;   
   ENDIF;
/*
** We have an unissued move, so we issue and then create FOD Order.
*/
   J.TOOperator = Operator$FOD;
   FO.Object = Operator$FOD;
   J.Status = Job$TakeOut;

   RetCode = J.IssueSingleMove();
   IF RetCode <> PU_OK THEN
      MESSAGE 'Unable to Issue Move for automatic FOD Order.';
      RETURN;
   ENDIF;
/*
** Now Generate the order
*/
   FODOrder.Moves.Clear();
   FODOrder.Moves[1] = J.Duplicate();
   FODOrder.OrderComment = OrderComment;
   FODOrder.FODEmployeeObject = Operator$FOD;

   RetCode = FODOrder.GenerateOrder (Card = Card);

   IF RetCode <> PU_OK THEN
      MESSAGE 'Automatic FOD Order was not generated successfully.';
      RETURN;
   ENDIF;
      
   RETURN;    
END; 

