	Name:            PromptSendTCOffToRR

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSendTCOffToRR
**
**  Modifications:
**  10/24/03   em   TC is being removed from Feeder, Send event to FOD
**  12/18/03   em   Exit if in Process Auto SetUp mode
**  04/16/07   ysp  ITC210: Insert IR interface event in DB event queue
**  03/25/11   em   Updated for 3G.
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL; 
    EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
) =
BEGIN
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;
/*
** Confirm that TC Feeder Status exists with Status Count = 1 for this feeder
** card before sending event to Rapid Restore.  Need to make sure the last
** TC status is being removed.
*/
   i = 0;
   REPEATED 
   SELECT   :i = OS.Status
   FROM     FMS_ObjectStatus OS,
            TFMS_CardToObject C
   WHERE    C.Card = :JIP.Card AND
            C.Object = OS.Object AND
            OS.StatusCount = 1 AND
            OS.Status = :Status$TC;

   IF i = Status$TC THEN
      EventText = VARCHAR(JIP.Card) + ';0;';
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_TCStatusChange',
                     EventText = EventText);
   ENDIF;
               
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptSendTCOnToRR

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSendTCOOnToRR
**
**  Modifications:
**  10/24/03   em   TC is on Feeder, Send event to FOD
**  03/05/04   em   Exit if in Process Auto SetUp mode
**  04/16/07   ysp  ITC210: Insert IR interface event in DB event queue
**  06/12/07   em   Add Record Fault Phase move
**  08/13/07   em   Commented out call to AutoFODIssue at Con Ed's request.
**  03/25/11   em   Modified for 3G
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
    CardStatus = INTEGER NOT NULL; 
    CardClass = INTEGER NOT NULL; 
    TypeOfCard = INTEGER NOT NULL; 
    EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
) =
BEGIN
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;
/*
** Confirm that TC Feeder Status exists for this feeder card before
** sending event to Rapid Restore.
*/
   CardStatus = 0;
   CardClass = 0;
   REPEATED 
   SELECT   :CardStatus = OS.Status,
            :CardClass = C.CardClass,
            :TypeOfCard = C.TypeOfCard
   FROM     FMS_ObjectStatus OS,
            TFMS_CardToObject CTO,
            FMS_Card C
   WHERE    C.Card = :JIP.Card AND
            C.Card = CTO.Card AND
            CTO.Object = OS.Object AND
            OS.StatusCount >= 1 AND
            OS.Status = :Status$TC;

   IF CardStatus = Status$TC THEN
      EventText = VARCHAR(JIP.Card) + ';1;';
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_TCStatusChange',
                     EventText = EventText);
/* 
**  A COMMIT has happened in the above called procedure.  What we are doing now will also commit.
**  TC Has been placed on Feeder.  If this is the first TC, we want to download the Record Fault
**  Phase move to the FOD.  Only do this on Auto, CIOA, and FOT cards.
*
      IF CardClass = Type$Auto OR CardClass = Type$FOT OR CardClass = Type$CIOA THEN
         CALLPROC AutoFODIssue (Card = JIP.Card,
                                FODJobClass = JobClass$FaultPhases,
                                TypeOfCard = TypeOfCard);
      ENDIF;  
*/        
   ENDIF;
               
   RETURN (PU_OK);
END;

   

