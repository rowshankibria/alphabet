/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    FMS_BusinessLogic
**  Class:          Security_ASE
**
**  Date:       Version Description
** ----------------------------------
**  06/09/02    pkw     Created; 
**  06/16/04    pkw     Add code for user group in load method.
**  11/09/06    ysp     Add CombinePermissions method to combine all permissions
**                      by username, ip and groups and subnet into one permission 
**                      string.
**  07/28/08    ysp     Fix CombinePermissions by using character comparision instead of
**                      integer. Some permission categories may use letters to represent 
**                      permission levels.
**  12/14/09    YSP     Add audit trail.
**  03/10/10    ysp     Set and query user's last login timestamp
*/ 
METHOD Ins (
)=
DECLARE
   i          = INTEGER NOT NULL;
   RetCode    = INTEGER NOT NULL;
   OldPrivString = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to insert/update row in 
** FMS_Security table.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.BuildPrivilegeList();
   CurObject.CheckOperator();
   
   FOR i = 1 TO CurObject.Dlist.LastRow() DO 
      OldPrivString = '';
      SELECT :OldPrivString = Privilege 
      FROM   FMS_Security
      WHERE  Type = :CurObject.Dlist[i].Type AND
             ID = :CurObject.Dlist[i].ID;
     
      RetCode = CALLPROC FMS_SecurityIns (
                  Type = CurObject.Dlist[i].Type,
                  TypeName = CurObject.Dlist[i].TypeName,
                  ID = CurObject.Dlist[i].ID,
                  Privilege = CurObject.Dlist[i].Privilege,
                  Description = CurObject.Dlist[i].Description
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': FMS Online Privileges for ' + CurObject.Dlist[i].ID +
                       ' could not be saved into database.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Modifications not saved to the database. ' +
            'Please try again.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;

      RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'FMS_Security'
                   ,Handle = 0     
                   ,HandleName = CurObject.Dlist[i].ID                           
                   ,LogTime = DATE('Now')
                   ,Operator = CurObject.Operator
                   ,OperatorName = CurObject.OperatorName
                   ,Item = 'Change Online Permission'
                   ,Old = 'Old=' + OldPrivString + ' New=' + CurObject.Dlist[i].Privilege
                   ,New = CurObject.AuditDetails(OldPrivString = OldPrivString, 
                                                 NewPrivString = CurObject.Dlist[i].Privilege)
                );     

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Failed to log FMS Online Privileges changes into database.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDFOR;

   RETURN;
END;


METHOD Del (
)=
DECLARE
   i          = INTEGER NOT NULL;
   k          = INTEGER NOT NULL;
   Char1 = CHAR(1) NOT NULL WITH DEFAULT;
   Details = VARCHAR(200) NOT NULL WITH DEFAULT;
   OldPrivString = VARCHAR(20) NOT NULL WITH DEFAULT;
   TempString = VARCHAR(20) NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to delete row in 
** FMS_Security table.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.BuildPrivilegeList();
   CurObject.CheckOperator();

   FOR i = 1 TO CurObject.Dlist.LastRow() DO      

      OldPrivString = '';
      SELECT :OldPrivString = Privilege 
      FROM   FMS_Security
      WHERE  Type = :CurObject.Dlist[i].Type AND
             ID = :CurObject.Dlist[i].ID;

      RetCode = CALLPROC FMS_SecurityDel (
                  Type = CurObject.Dlist[i].Type,
                  ID = CurObject.Dlist[i].ID
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Type ' + CurObject.Dlist[i].TypeName +
                       ' could not be removed from database.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not remove from database. ' +
            'Please try again.';
         RETURN;    
      ENDIF;
      CALLPROC DDB_COMMIT;
/*
** AUDIT TRAIL
*/
      Details = '';
      TempString = OldPrivString;
      k = 1;
      WHILE Length(TempString) > 0 DO

         /* get leftmost character */
         Char1 = Left(TempString,1);
      
         IF Char1 <> CurObject.PrivList[k].SubCodes[1].Bit THEN			// Lowest permission
            Details = Details + CurObject.PrivList[k].Privilege + ': ' + 
                   CurObject.GetPermission(PrivObject = CurObject.PrivList[k],Bit = Char1) + '; '; 
         ENDIF;
                     
         /* shift characters left one space */
         TempString= shift(TempString, -1);
         k = k + 1;
      ENDWHILE;

      RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'FMS_Security'
                   ,Handle = 0     
                   ,HandleName = CurObject.Dlist[i].ID                           
                   ,LogTime = DATE('Now')
                   ,Operator = CurObject.Operator
                   ,OperatorName = CurObject.OperatorName
                   ,Item = 'Delete Online Permission'
                   ,Old = OldPrivString
                   ,New = Details);     

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Failed to log FMS Online Privileges deletion into database.');
      ENDIF;
      CALLPROC DDB_COMMIT;

   ENDFOR;
   RETURN;
END;

METHOD Load (
)=
DECLARE
   Subnet = VARCHAR(40) NOT NULL;
   tmpPermission = VARCHAR(20) NOT NULL;
   tmpResult = VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load security data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
**  See if username is = ''.  If it is, we will return all rows in table.
**  Otherwise, we will just return data for particular user.
*/
   CurObject.Dlist.Clear();

   IF CurObject.UserName = '' AND CurObject.IPAddress = '' THEN
      i = 1;
      SELECT :CurObject.Dlist[i].Type = Type,
             :CurObject.Dlist[i].TypeName = TypeName,
             :CurObject.Dlist[i].ID = ID,
             :CurObject.Dlist[i].Privilege = Privilege,
             :CurObject.Dlist[i].Description = Description,
             :CurObject.Dlist[i].LastLogin = LastLogin 
      FROM   FMS_Security
      ORDER BY TypeName,ID
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   
   ELSE
/*
**  Order of validation is:
**     1) UserName match
       2) UserGroup info will be compared with username to give user most 
             privileges. Assumption is that higher number means more privilege
**     2) IPAddress match
**     3) Subnet match
**
**  If none of these produce a match, user can not view FMS online.
*/
      /*
      ** get permission by username 
      */
      tmpPermission = '';
      SELECT :tmpPermission = Privilege
      FROM   FMS_Security
      WHERE  Type = :Security$UserName AND
             UPPERCASE(ID) = UPPERCASE(:CurObject.UserName);
      CALLPROC DDB_ROLLBACK;
      
      IF tmpPermission <> '' THEN 
         CurObject.Dlist[1].Privilege = tmpPermission;

         RetCode = CALLPROC FMS_SecurityLogin(Type = Security$UserName,
                                              ID = CurObject.UserName,
                                              LastLogin = DATE('NOW'));
         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Security_ASE.Load; Failed to set LastLogin for UserName ' + CurObject.UserName);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;

      /*
      ** get permissions by groups
      */  
      FOR i = 1 TO CurObject.Glist.LastRow() DO
         tmpPermission = '';
         SELECT :tmpPermission = Privilege
         FROM    FMS_Security
         WHERE   Type = :Security$UserGroup AND
                 UPPERCASE(ID) = UPPERCASE(:CurObject.gList[i].ID);
      
         IF tmpPermission <> '' THEN
            IF CurObject.DList.LastRow() <> 0 THEN
               tmpResult = CurObject.CombinePermissions (
                                  PermString1 = CurObject.DList[1].Privilege,
                                  PermString2 = tmpPermission); 
            ELSE
               tmpResult = tmpPermission;
            ENDIF;                 
            CurObject.Dlist[1].Privilege = tmpResult;

            RetCode = CALLPROC FMS_SecurityLogin(Type = Security$UserGroup,
                                              ID = CurObject.gList[i].ID,
                                              LastLogin = DATE('NOW'));
            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Security_ASE.Load; Failed to set LastLogin for UserGroup ' + CurObject.gList[i].ID);
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
      ENDFOR;

      /*
      ** get permission by ip address
      */
      tmpPermission = '';
      SELECT :tmpPermission = Privilege
      FROM   FMS_Security
      WHERE  Type = :Security$IpAddress AND
             ID = :CurObject.IPAddress;
      CALLPROC DDB_ROLLBACK;

      IF tmpPermission <> '' THEN
         IF CurObject.DList.LastRow() <> 0 THEN
            tmpResult = CurObject.CombinePermissions (
                                  PermString1 = CurObject.DList[1].Privilege,
                                  PermString2 = tmpPermission); 
         ELSE
            tmpResult = tmpPermission;
         ENDIF;               
         CurObject.Dlist[1].Privilege = tmpResult;

         RetCode = CALLPROC FMS_SecurityLogin(Type = Security$IpAddress, 
                                              ID = CurObject.IPAddress,
                                              LastLogin = DATE('NOW'));
         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Security_ASE.Load; Failed to set LastLogin for IPAddress ' + CurObject.IPAddress);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;

      /*
      ** get permission by subnet
      */
      Subnet = '';
      CurObject.IpAddress = shift(CurObject.IpAddress,(-1*(locate(CurObject.IpAddress,'.'))));
      CurObject.IpAddress = shift(CurObject.IpAddress,(-1*(locate(CurObject.IpAddress,'.'))));
      Subnet = left(CurObject.IpAddress,(locate(CurObject.IpAddress,'.')-1));

      tmpPermission = '';
      SELECT :tmpPermission = Privilege
      FROM   FMS_Security
      WHERE  Type = :Security$Subnet AND
             ID = :SubNet;
      CALLPROC DDB_ROLLBACK;
      IF tmpPermission <> '' THEN
         IF CurObject.DList.LastRow() <> 0 THEN
            tmpResult = CurObject.CombinePermissions (
                                  PermString1 = CurObject.DList[1].Privilege,
                                  PermString2 = tmpPermission); 
         ELSE
            tmpResult = tmpPermission;
         ENDIF;               
         CurObject.Dlist[1].Privilege = tmpResult;

         RetCode = CALLPROC FMS_SecurityLogin(Type = Security$Subnet,
                                              ID = SubNet,
                                              LastLogin = DATE('NOW'));
         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Security_ASE.Load; Failed to set LastLogin for SubNet ' + SubNet);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN;
END;

METHOD CombinePermissions(
   PermString1 = VARCHAR(20) NOT NULL;
   PermString2 = VARCHAR(20) NOT NULL;
)=
DECLARE
   Char1    = CHAR(1) NOT NULL WITH DEFAULT;
   Char2    = CHAR(1) NOT NULL WITH DEFAULT;
   tmpResult= VARCHAR(20) NOT NULL;
   i          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/*
**  Compare Current privilege with tmpPrivilege and use 
**  higher numbers to create new privilege string.
*/
    tmpResult = '';
                  
    WHILE length(PermString1) > 0 DO
       /* get leftmost character */
       Char1 = Left(PermString1,1);
       Char2 = Left(PermString2,1);
                     
      /* compare integer values */
      IF Char1 >= Char2 THEN
         tmpResult = tmpResult + Char1;
      ELSE
         tmpResult = tmpResult + Char2;
      ENDIF;
                     
      /* shift characters left one space */
      PermString1 = shift(PermString1, -1);
      PermString2 = shift(PermString2, -1);
   ENDWHILE;

   RETURN tmpResult;
END;

METHOD CheckOperator(
) = 
DECLARE
   i = INTEGER NOT NULL;
   EmailName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.Operator = 0;

   IF CurObject.OperatorName <> '' THEN
      EmailName = LOWERCASE(CurObject.OperatorName) + '@coned.com';

      SELECT :CurObject.Operator = P.Object
      FROM   UDB_Person P
      WHERE  LOWERCASE(P.Email) = :EmailName;
      CALLPROC DDB_ROLLBACK;     
   ENDIF;
END;

METHOD AuditDetails(
   OldPrivString = VARCHAR(20) NOT NULL WITH DEFAULT;
   NewPrivString = VARCHAR(20) NOT NULL WITH DEFAULT;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   Char1    = CHAR(1) NOT NULL WITH DEFAULT;
   Char2    = CHAR(1) NOT NULL WITH DEFAULT;
   Details = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** compare old/new strings.
*/
    IF Length(NewPrivString) > Length(OldPrivString) THEN
       k = Length(NewPrivString);
    ELSE
       k = Length(OldPrivString);
    ENDIF;

    Details = '';
    i = 1;
    WHILE k > 0 DO

       /* get leftmost character */
       Char1 = Left(OldPrivString,1);
       Char2 = Left(NewPrivString,1);
      
       IF Char1 = ' ' THEN
          Char1 = CurObject.PrivList[i].SubCodes[1].Bit;			// Lowest permission
       ENDIF;
 
      /* compare integer values */
      IF Char1 <> Char2 THEN
         Details = Details + CurObject.PrivList[i].Privilege + ': ' + 
                   CurObject.GetPermission(PrivObject = CurObject.PrivList[i],Bit = Char1) + '->' + 
                   CurObject.GetPermission(PrivObject = CurObject.PrivList[i],Bit = Char2) + '; '; 
      ENDIF;
                     
      /* shift characters left one space */
      OldPrivString = shift(OldPrivString, -1);
      NewPrivString = shift(NewPrivString, -1);
      k = k - 1;
      i = i + 1;
   ENDWHILE;

   RETURN Details ;
END;

/*
** GetPermission: used for Audit Trail function only
*/
METHOD GetPermission(
   PrivObject = PrivilegeCodeClass;
   Bit = CHAR(1) NOT NULL WITH DEFAULT;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT; 
   Permission = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   RetCode = PrivObject.SubCodes.Find(AttributeName = 'bit',
                                      Value = Bit,
                                      RowNumber = Byref(i));
   IF RetCode = ER_OK THEN
      RETURN PrivObject.SubCodes[i].Privilege;
   ELSE
      RETURN PrivObject.SubCodes[1].Privilege;
   ENDIF;
END;

/*
** BuildPrivilegeList: used for Audit Trail function only
*/
