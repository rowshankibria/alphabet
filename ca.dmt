	Name:            Check229GroundsRemoved

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Procedure:      Check229GroundsRemoved               
**
**  Modifications:
**	10/20/94        bgh     Created 
**      03/29/99        em      Incorporated into SOA
**      11/26/02        pkw     Change Job to JIP for Merge.
**      02/26/16        em      If move is assigned to a Substation, then only check equipment
**                              on the line in that station.
**      03/21/17        ysp     Increase warning text size to 300
*/
PROCEDURE Check229GroundsRemoved 
(
    JIP = JobInProgress;			/* Job being processed */

    WarningStatus = INTEGER;
    i = INTEGER;
    GroundedText = VARCHAR(300) NOT NULL;
    GroundedEquip = ARRAY OF ObjectSummaryClass;
) =
BEGIN
/*
**  This check 
*/ 
    
    IF JIP.JobClass <> JobClass$229G  THEN
        RETURN(PU_OK);
    ENDIF;
        
    IF JIP.Substation = 0 THEN
/*
** The "old" logic for all equipment on the line.
*/
    GroundedText = 'The following equipment is grounded: ';
    i = 1;
    REPEATED
    SELECT :GroundedEquip[i].Object = O.Object,
           :GroundedEquip[i].TypeName = O.TypeName, 
           :GroundedEquip[i].PrimaryGroupingName = O.PrimaryGroupingName,
           :GroundedEquip[i].Name = O.Name
    FROM TFMS_CardToObject CTO,
         Udb_Grouping G,
         FMS_ObjectStatus OS,
         Udb_Object O
    WHERE CTO.Card = :JIP.Card AND 
          CTO.Type = :Type$Line AND
          CTO.Object = G.Grouping AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = OS.Object AND
          OS.Status = :Status$Ground AND
          OS.StatusCount > 0 AND
          OS.Object = O.Object
    BEGIN
        IF i = 1 THEN        
            GroundedText = GroundedText + GroundedEquip[i].PrimaryGroupingName + ' ' +
                                        GroundedEquip[i].TypeName + ' ' + 
                                        GroundedEquip[i].Name;
        ELSE 
            GroundedText = GroundedText + ', ' + GroundedEquip[i].PrimaryGroupingName + ' ' +
                                        GroundedEquip[i].TypeName + ' ' + 
                                        GroundedEquip[i].Name;
        ENDIF;
        i = i + 1;    
        
    END;
  
    ELSE
/*
**  The "new" logic to look at just equipment on the line in the substation.
*/ 
    GroundedText = 'The following equipment is grounded: ';
    i = 1;
    REPEATED
    SELECT :GroundedEquip[i].Object = O.Object,
           :GroundedEquip[i].TypeName = O.TypeName, 
           :GroundedEquip[i].PrimaryGroupingName = O.PrimaryGroupingName,
           :GroundedEquip[i].Name = O.Name
    FROM TFMS_CardToObject CTO,
         Udb_Grouping G,
         Udb_Grouping G2,
         FMS_ObjectStatus OS,
         Udb_Object O
    WHERE CTO.Card = :JIP.Card AND 
          CTO.Type = :Type$Line AND
          CTO.Object = G.Grouping AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.Grouping = :JIP.Substation AND
          G.Member = OS.Object AND
          OS.Status = :Status$Ground AND
          OS.StatusCount > 0 AND
          OS.Object = O.Object
    BEGIN
        IF i = 1 THEN        
            GroundedText = GroundedText + GroundedEquip[i].PrimaryGroupingName + ' ' +
                                        GroundedEquip[i].TypeName + ' ' + 
                                        GroundedEquip[i].Name;
        ELSE 
            GroundedText = GroundedText + ', ' + GroundedEquip[i].PrimaryGroupingName + ' ' +
                                        GroundedEquip[i].TypeName + ' ' + 
                                        GroundedEquip[i].Name;
        ENDIF;
        i = i + 1;    
        
    END;

    ENDIF;

    IF i > 1 THEN

        WarningStatus = CALLFRAME Warning (Card = JIP.Card, Job = JIP.Job,
                                           SwitchingItem = JIP.SwitchingItem,
                                           Text = GroundedText);

        IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            RETURN(Warning$Overridden);
        ENDIF;

    ENDIF;

    RETURN(PU_OK);

END; 

