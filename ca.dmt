	Name:            PromptNotifications

/*
**      Copyright c 1997 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          PromptNotifications
**
**  Modifications:
**  03/10/97 jfl    Created - (fms202)
**  11/07/02 em     J to JIP
**  02/13/04 em     Converted Message to TraceError
*/

INITIALIZE
(
    JIP = JobInProgress;          /* P:Job being processed */

    ToRs = INTEGER NOT NULL;      /* takeout/restore move */
    PrePost = INTEGER NOT NULL;   /* optional P: jobcheck precheck or job action prompt */
    retcode = INTEGER NOT NULL;   /* local return variable */
    i = INTEGER NOT NULL;       
) =
BEGIN
/*
** Determine if this could be pre-move or post-move notifications
** (for prechecks, the calling 4gl proc passed parameter prepost)
*/
    IF PrePost <> JobCheck$Precheck THEN
        Prepost = JobAction$Prompt;
    ENDIF;
/*
** Determine if it is a takeout or a restore move
*/
    IF Prepost = JobCheck$Precheck THEN
        IF (JIP.ToIssued IS NULL OR JIP.ToIssued = '') THEN
            ToRs = Job$TakeOutInt;
        ELSE
            ToRs = Job$RestoreInt;
        ENDIF;
    ELSE
        IF (JIP.RsIssued IS NULL OR JIP.RsIssued = '') 
           AND JIP.Steppair <> StepHeading$OTW THEN
            ToRs = Job$TakeOutInt;
        ELSE
            ToRs = Job$RestoreInt;
        ENDIF;
    ENDIF;
/*
** Load a temporary record to let the calling routine know that a prompt
** for notification is necessary
** Department = -1 is the convention to indicate that this record is temporary.
*/
    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = CardDetails.Card,
                      Job = JIP.Job,
                      Seq = 0,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = -1,
                      Person = '',
                      Notification  = '',
                      Issued = Notif$NotToBeIssuedYet,
                      Timestamp = NULL);
    IF RetCode > 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        CALLPROC TraceError (UserMessage = 
                      'ERROR: Unable to Insert Notifications record.',
                           TraceMessage =
                      'PromptNotifications:  ' +
                      'Unable to insert Notifications record related to ' +
                      'Job = ' + VARCHAR(JIP.Job) + '.'
                      );

    ENDIF;
    RETURN (PU_OK);
END;


Application Component Report
============================

	Name:            PromptNotifyStationShiftManager

/*
**
**  Copyright c 2001 Pateric Software, LLC.  All rights reserved.
**
**  Pateric Software, LLC. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software, LLC.
**
*/
/*
**  Application:    cac
**  Frame:          PromptNotifyStationShiftManager
**
** 09/18/13  pkw    Send csd_message to substation shift manager.
*/

INITIALIZE
(
    JIP = JobInProgress;        /* Job being processed */
    Feeder = INTEGER NOT NULL WITH DEFAULT; /* Optional; special processing */
    /* TC Parameters */
    J = TLSJob;
    Jobs = ARRAY OF TLSJob;
    C = CardClass;

    CardName = VARCHAR(80);         
    NotifyMsg = VARCHAR(400) NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;       /* counter variable */  
    k = INTEGER NOT NULL;       /* counter variable */  
    m = INTEGER NOT NULL;       /* counter variable */  
    n = INTEGER NOT NULL;       /* counter variable */  
    x = INTEGER NOT NULL;       /* return variable */
    RetCode = INTEGER NOT NULL;       /* return variable */
) =
DECLARE
ENDDECLARE
BEGIN
   IF CurrentApplication = Application$TLS THEN
      SELECT :CardName = TC.LineNumber 
      FROM   TC_Card TC
      WHERE  TC.Card = :C.Card;   

      NotifyMsg = DOp.Description + ' has sent the following message from ' + CurrentApplication + 
               ' card <a target="fms" href="<%type=card&app=' + CurrentApplication + '&card=' + VARCHAR(C.Card) + '%>">' + CardName + '</a>:: ' + 
               J.TOMove;

      /*
      ** send the message via FMS Notification
      */
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                             ,MessageText = NotifyMsg
                             ,MessageType = 2  /* Auto Complete move */
                             ,Card = C.Card
                             ,Priority = 0  /* High Priority */ 
                             ,Time = date('now')
                             ,MsgKey = J.Job);
   ELSE
      SELECT :CardName = AC.CardName 
      FROM   SOA_ActiveCard AC
      WHERE  AC.Card = :JIP.Card;

      NotifyMsg = DOp.Description + ' has sent the following message from ' + CurrentApplication + 
               ' card <a target="fms" href="<%type=card&app=' + CurrentApplication + '&card=' + VARCHAR(JIP.Card) + '%>">' + CardName + '</a>:: ' + 
               JIP.TOMove;
      /*
      ** send the message via FMS Notification
      */
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                             ,MessageText = NotifyMsg
                             ,MessageType = 2  /* Auto Complete move */
                             ,Card = JIP.Card
                             ,Priority = 0  /* High Priority */ 
                             ,Time = date('now')
                             ,MsgKey = JIP.Job);
   ENDIF;
   
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (
            UserMessage = 'ERROR: failed to send message. Please try again.',
            TraceMessage = 'Prompt:PromptNotifyStationShiftManager, ' +
                           'failed to insert notification message.');
      RETURN(PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RETURN PU_OK;
END;

