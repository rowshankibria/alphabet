	Name:            WarningOverride

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          WarningOverride
**
**  Date:       Author   Description
** ----------------------------------
**  09/10/98	EM       Created
**
*/
PROCEDURE WarningOverride 
(
   Card		 = INTEGER NOT NULL;         /*Parameter*/
   Job		 = INTEGER;	             /*Parameter*/
   SwitchingItem = INTEGER;	             /*Parameter*/
   WarningText   = VARCHAR(512) NOT NULL WITH DEFAULT; /*Parameter*/	   	

   NullableRetCode      = INTEGER;   /*Nullable retcode - Warning screen*/
   NullableTextCode     = VARCHAR(60);   /*Textual retcode - Override screen*/
   OverrideReturnText   = VARCHAR(60) NOT NULL WITH DEFAULT;
) =
BEGIN

   NullableRetCode = CALLFRAME Warning (
               Card = Card,
               SwitchingItem = SwitchingItem,
               Job = Job,
               Text = WarningText);
   IF NullableRetCode = PU_CANCEL THEN
      RETURN PU_CANCEL;
   ENDIF;

   NullableTextCode = CALLFRAME Override (
               Card = Card,
               Job = Job,
               SwitchingItem = SwitchingItem);
   IF NullableTextCode IS NULL THEN
      RETURN PU_CANCEL;
   ELSE
      OverrideReturnText = IFNULL(NullableTextCode,'');
      RETURN PU_OK;
   ENDIF;
 
END;

Application Component Report
============================

	Name:            WarningOverrideReview

/*
**  Application:    CAC
**  Frame:          WarningOverrideReview
**
**  Modifications:
**  08/13/15 em     Created
**  09/29/15 em     Default loginname and other onsite changes
**                  If Not Ok is selected, make all remaining warnings Not OK
**  09/30/15 em     Add READ option to LoadCommonCard dbevent
**  10/05/15 em     Set and clear Warning Review Lock
**  10/06/15 em     Add HashInteger attribute for uniqueness; convert display to bitmap button
**  10/16/15 em     Add Domain to UserName
**  01/17/17 em     If move triggering warning is a high pot move, display high pot test criteria.
**  02/13/17 em     Change formatting of high pot criteria
**  03/23/17 em     Formatting error discovered following production release
**  02/26/20 ysp    Use JobWarning class for the move & warnings table to accomondate longer warning texts  
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;      /* Passed  card */
    ReviewStage = CHAR(3);        /* Passed "Op1" or "Op2" */
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT;      /* Passed sw item */
    TwoOpConfirmEvent = DATE NOT NULL;  /* Passed Date */

    i = INTEGER NOT NULL;       
    k = INTEGER NOT NULL;       
    CL = ChoiceList;

    ControlText = VARCHAR(120) NOT NULL WITH DEFAULT;
    CredentialsConfirmed = INTEGER NOT NULL WITH DEFAULT;
    MsgKey = INTEGER NOT NULL WITH DEFAULT;       
    Ops = ARRAY OF DistrictOperatorClass;
    RetCode = INTEGER;   /* return variable */
    ReviewApproved = INTEGER NOT NULL WITH DEFAULT;
    ReviewComplete = INTEGER NOT NULL WITH DEFAULT;
    RightOperatorName = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   LoadWarnings = PROCEDURE;
   LoggedInOps = PROCEDURE;
   CancelMessage = PROCEDURE RETURNING INTEGER;
ENDDECLARE
BEGIN
   ReviewComplete = FALSE;
   CredentialsConfirmed = FALSE;
   IF ReviewStage = 'Op1' THEN
      Operator1 = DOp.Description;
      FIELD(Send_btn).CurBias = FB_DIMMED;
      FIELD(DO2).CurBias = FB_INVISIBLE;
      FIELD(OK_btn).CurBias = FB_INVISIBLE;
      CALLPROC LoggedInOps();
      CurFrame.PurgeDBEvent (DBEventName = 'SOA_WarningReviewAbort');
      CurFrame.StatusText = 'Select DO #2 to review Warning Overrides';
   ENDIF;
   IF ReviewStage = 'Op2' THEN
      FIELD(DO2).CurBias = FB_INVISIBLE;
      FIELD(J[*].ToIssuedFg).CurBias = FB_LANDABLE;
      FIELD(J[*].RsIssuedFg).CurBias = FB_LANDABLE;
      FIELD(Credentials).CurBias = FB_CHANGEABLE;
      FIELD(SelectText).CurBias = FB_INVISIBLE;
      FIELD(Send_btn).CurBias = FB_INVISIBLE;
      FIELD(Cancel_btn).CurBias = FB_INVISIBLE;
      FIELD(OK_btn).CurBias = FB_INVISIBLE;
      FIELD(Back1_btn).CurBias = FB_LANDABLE;
      FIELD(Reload_btn).CurBias = FB_LANDABLE;
      CL.ChoiceItems[1].EnumValue = DOp.Object;
      CL.ChoiceItems[1].EnumText = DOp.Description;
      Credentials.OperatorName = DOp.LoginName;
      FIELD(Operator2).ValueList = CL.Duplicate();
      FIELD(Operator2).UpdChoiceList();
      FIELD(Operator2).CurBias = FB_VISIBLE;
      FIELD(Operator2).BgColor = CC_PALE_PURPLE;
      CurFrame.StatusText = 'DO #2 Review - Mark Warnings OK or Not OK';
      CurFrame.InputFocusField = FIELD(Back1_btn);
   ENDIF;
/*
**  Use right two digits for managing Warning Review Lock messages
*/
   RightOperatorName = INT4(Right(UserName,2));

   CALLPROC LoadWarnings();
   ControlText = UserName + ';' + VARCHAR(Card) + ';' + 
                 CurrentApplication + ';' + 'READ;';
/*
** Clear DB Events that are queued
*/
   CurFrame.PurgeDBEvent(DBEventName = 'SOA_CompleteWarningOverride');
END;


ON SETVALUE Operator2 =
DECLARE
   MsgString = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   MsgKey = 0;
   IF Operator2 <> 0 THEN
/*
      FIELD(Send_btn).CurBias = FB_LANDABLE;
      FIELD(Send_btn).TextLabel = 'Send Incoming Msg';
*/
      MsgString = 'WARNING OVERRIDE REVIEW' + HC_NEWLINE +
               'District Operator ' + DOp.Description + ' has requested you to ' +
               'review and confirm warnings.' + HC_NEWLINE +
               'Click "Review Warnings" to load card with warnings.';  
      MsgKey = CALLPROC MSG_SendMsg (
                Card = Card,
                Action = 0,
                OrderNumber = SwitchingItem,
                Substation = FIELD(Operator2).CurEnumValue,
                SubstationName = FIELD(Operator2).CurEnumText,
                Msg = MsgString,
                FromOpName = DOp.Description,
                SendDate = IFNULL(TwoOpConfirmEvent,''),
                ToApp = CurrentApplication,
                FromApp = UserName,
                Priority = 1
                );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK; 
         MsgKey = 0;
         MESSAGE 'Error sending incoming message to DO #2.';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;

         CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #1 has requested Warning Override Review',
            New  = 'Requested of ' + FIELD(Operator2).CurEnumText);
         CALLPROC DDB_COMMIT;

         FIELD(Operator2).CurBias = FB_VISIBLE;
         FIELD(Send_btn).CurBias = FB_LANDABLE;
         FIELD(Send_btn).TextLabel = 'Rescind Message';
         CurFrame.StatusText = 'Waiting for DO #2 to review warning overrides.';
/*
** Lock Incoming Messages
*/
         CALLPROC EUE_SendExternalEvent('ext_MessageLock',RightOperatorName); 
      ENDIF;
   ENDIF;
END;


ON CLICK Send_btn =
DECLARE
   MsgString = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF FIELD(Send_btn).TextLabel = 'Rescind Message' THEN  
      IF MsgKey > 0 THEN
         RetCode = CALLPROC CancelMessage();
         IF RetCode = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;    
      FIELD(Operator2).CurBias = FB_CHANGEABLE;
      FIELD(Operator2).CurEnumValue = 0;
      FIELD(Send_btn).TextLabel = 'Send Incoming Msg';
      FIELD(Send_btn).CurBias = FB_DIMMED;
      CurFrame.StatusText = 'Select DO #2 to review Warning Overrides';
   ELSE
      IF FIELD(Operator2).CurEnumValue = 0 THEN
         MESSAGE 'Must select district operator to review.';
         RESUME;
      ENDIF;

      MsgString = 'WARNING OVERRIDE REVIEW' + HC_NEWLINE +
               'District Operator ' + DOp.Description + ' has requested you to ' +
               'review and confirm certain yellow warning overrides.' + HC_NEWLINE +
               'Click "Review Warnings" to load card with warnings.';  
      MsgKey = CALLPROC MSG_SendMsg (
                Card = Card,
                Action = 0,
                OrderNumber = SwitchingItem,
                Substation = FIELD(Operator2).CurEnumValue,
                SubstationName = FIELD(Operator2).CurEnumText,
                Msg = MsgString,
                FromOpName = DOp.Description,
                SendDate = IFNULL(TwoOpConfirmEvent,''),
                ToApp = CurrentApplication,
                FromApp = UserName,
                Priority = 1
                );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK; 
         MsgKey = 0;
         MESSAGE 'Error sending incoming message to DO #2.';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;

         CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #1 has requested Warning Override Review',
            New  = 'Requested of ' + FIELD(Operator2).CurEnumText);
         CALLPROC DDB_COMMIT;

         FIELD(Send_btn).TextLabel = 'Rescind Message';
         CurFrame.StatusText = 'Waiting for DO #2 to review warning overrides.';
      ENDIF; 
   ENDIF;
END;

ON ChildEntry J.TOIssuedFg =
DECLARE
   x = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurFrame.InputFocusField = FIELD(Back1_btn);
/*
** Don't allow change unless enabled.
*/
   IF FIELD(J[].TOIssuedFg).BgPattern = FP_Clear THEN
      RESUME;
   ELSEIF J[].TOIssuedBg = 1 THEN 
      FIELD(J[].TOIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
      J[].TOIssuedBg = 0;
   ELSE
      FIELD(J[].TOIssuedFg).BgBitmap = FIELD(ok_templt).BgBitmap;
      J[].TOIssuedBg = 1;
      FIELD(J[].RSIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
      J[].RSIssuedBg = 0;
      x = 1; 
      WHILE x <= J.LastRow() DO
         IF J[x].RSIssuedBg = 1 THEN
            ENDLOOP;
         ENDIF;
         x = x + 1;
      ENDWHILE;

      IF x > J.LastRow() THEN
         FIELD(Credentials).CurBias = FB_CHANGEABLE;
         FIELD(DO2).CurBias = FB_INVISIBLE;
      ENDIF;
   ENDIF;
END;

ON ChildEntry J.RSIssuedFg =
DECLARE
   x = INTEGER NOT NULL WITH DEFAULT;
   y = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   x = FIELD(J).CurRow;
   CurFrame.InputFocusField = FIELD(Back1_btn);
/*
** Don't allow change unless enabled.
*/
   IF FIELD(J[].RSIssuedFg).BgPattern = FP_Clear THEN
      RESUME;
   ELSEIF J[].RSIssuedBg = 1 THEN 
      FIELD(J[].RSIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
      J[].RSIssuedBg = 0;
   ELSE
      FIELD(J[].RSIssuedFg).BgBitmap = FIELD(ok_templt).BgBitmap;
      J[].RSIssuedBg = 1;
      IF J[].TOIssuedBg = 1 THEN
         FIELD(J[].TOIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
         J[].TOIssuedBg = 0;
      ENDIF;
      FIELD(DO2).CurBias = FB_CHANGEABLE;
      FIELD(Credentials).CurBias = FB_INVISIBLE;
      FOR y = x TO J.LastRow() DO
         IF FIELD(J[y].RSIssuedFg).BgPattern <> FP_Clear THEN
            FIELD(J[y].RSIssuedFg).BgBitmap = FIELD(ok_templt).BgBitmap;
            J[y].RSIssuedBg = 1;
            FIELD(J[y].TOIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
            J[y].TOIssuedBg = 0;
         ENDIF;
      ENDFOR; 
   ENDIF;
END;


ON CLICK Back1_btn = 
DECLARE
   ApprvValue = VARCHAR(24) NOT NULL WITH DEFAULT;
   LastJob = INTEGER NOT NULL WITH DEFAULT;
   UnapprovedJob = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Review to make sure all warnings are marked  
*/
   ApprvValue = 'APPROVED';
   FOR i = 1 TO J.LastRow DO
      IF J[i].Job <> 0 AND LastJob = 0 THEN 
         LastJob = J[i].Job;
      ENDIF;
      IF J[i].Job = 0 AND J[i].Seq = 1 THEN
         IF J[i].RSIssuedBg = 1 THEN
            ApprvValue = 'NOT APPROVED';
            FIELD(DO2).CurBias = FB_CHANGEABLE;
            FIELD(Credentials).CurBias = FB_INVISIBLE;
         ENDIF;
         IF J[i].TOIssuedBg = 0 AND J[i].RSIssuedBg = 0 AND ApprvValue = 'APPROVED'THEN
            MESSAGE 'Please mark all Yellow Warnings OK or Not OK';
            RESUME;
         ENDIF;
         IF J[i].TOIssuedBg = 1 AND J[i].RSIssuedBg = 1 THEN
            MESSAGE 'You have double marked a Yellow Warning both OK and Not OK';
            RESUME;
         ENDIF;
         IF J[i].RSIssuedBg = 1 AND DO2.ReturnComment = '' THEN
            MESSAGE 'Please enter a DO #2 Comment for your Not OK response';
            RESUME;
         ENDIF;
         IF UnapprovedJob = 0 AND J[i].RSIssuedBg = 1 THEN
            UnapprovedJob = LastJob;
         ENDIF;
      ENDIF;
   ENDFOR;
/*
** Perform Credential check
*/
   IF ApprvValue = 'APPROVED' AND
        (Credentials.OperatorName = '' OR Credentials.Password = '') THEN
      MESSAGE 'Please enter your Operations Network Login and Password.';
      FIELD(Credentials).CurBias = FB_CHANGEABLE;
      FIELD(DO2).CurBias = FB_INVISIBLE;
      RESUME;
   ENDIF;

   IF ApprvValue = 'APPROVED' THEN
      IF DOp.Domain <> '' THEN
         Credentials.OperatorName = DOp.Domain + '\' + DOp.LoginName;
      ELSE
         Credentials.OperatorName = DOp.LoginName;
      ENDIF;

      RetCode = CALLPROC CredentialCheck(Password=Credentials.Password,
                           OperatorName = Credentials.OperatorName);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Credential/Login Check Failed.';
         CredentialsConfirmed = FALSE;
         RESUME;
      ELSE
         CredentialsConfirmed = TRUE;
      ENDIF;

      IF CredentialsConfirmed = FALSE THEN
         RESUME;
      ENDIF;
   ENDIF;
/*
** Mark warnings with operator2 
*/
   FOR i = 1 TO J.LastRow DO
      IF J[i].ToIssuedBg = 1 THEN
         RetCode = CALLPROC SOA_WarningUpd (
                      LogDate = IFNULL(J[i].ToIssued,''),
                      Operator = IFNULL(J[i].ToOperator,0),
                      Operator2 = DOp.Object,
                      Operator2Name = DOp.Description,
                      TwoOpConfirmEvent = TwoOpConfirmEvent,
                      HashInteger = J[i].BaseKey);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to save warning approvals.';
            RESUME;
            ENDLOOP;
         ENDIF;
      ENDIF;
   ENDFOR;

   IF ApprvValue = 'APPROVED' THEN
      DO2.ReturnComment = 'Warning Override Validated by ' + DOp.Description;
      UnapprovedJob = LastJob;
   ENDIF;

   RetCode = CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 4,
                   WarningText = DO2.ReturnComment,
                   Card = Card,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   TwoOpConfirmEvent = TwoOpConfirmEvent,
                   Job = IFNULL(UnapprovedJob,0));
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to insert warning into SOA_Warning table '
          +           'for card ' + VARCHAR(Card) + ' Warning: ' + DO2.ReturnComment
          );
      ENDIF;

   CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #2 has completed Warning Override Review',
            New  = ApprvValue + ' by ' + DOp.Description);
   CALLPROC DDB_COMMIT;
   CurFrame.ParentFrame.SendUserEvent (EventName = 'WarningFrameExit');
   RETURN PU_OK;
END;

ON CLICK Reload_btn =
BEGIN
   IF CurrentApplication = Application$FMS THEN
      RAISE DBEVENT FMS_LoadCommonCard :ControlText;
   ELSE
      RAISE DBEVENT SOA_LoadCommonCard :ControlText;
   ENDIF;
END;
/*
** The following DBEvent incidates DO #1 has aborted the moves
*/
ON DBEVENT 'SOA_WarningReviewAbort' =
DECLARE
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   WO_Event = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   ControlText = CurFrame.DBEvent.DBEventText;

   WO_Event = '';
   WO_Event = left(ControlText,(locate(ControlText,';')-1));

   IF WO_Event = TwoOpConfirmEvent AND ReviewStage = 'Op2' THEN
      MESSAGE 'DO#1 has aborted the moves, your review is no longer needed.';
      CurFrame.ParentFrame.SendUserEvent (EventName = 'WarningFrameExit');
      RETURN PU_OK;
   ENDIF;
END;
/*
** The following DBEvent indicates DO #2 has completed the review
*/
ON DBEVENT 'SOA_CompleteWarningOverride' =
DECLARE
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   ControlUser = VARCHAR(24) NOT NULL WITH DEFAULT;
   WO_Event = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   ControlText = CurFrame.DBEvent.DBEventText;

   ControlUser = left(ControlText,(locate(ControlText,';')-1));   
/*
** Ignore ControlUser, it is DO #2
*/
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));
   WO_Event = '';
   WO_Event = left(ControlText,(locate(ControlText,';')-1));

   IF WO_Event <> TwoOpConfirmEvent THEN
/*
** Somebody else's event
*/    
      RESUME;
   ENDIF;

   CurFrame.StatusText = 'DO #2 has completed Warning Override Review';
   ReviewComplete = TRUE;
   CALLPROC LoadWarnings();
   FIELD(Send_btn).CurBias = FB_DIMMED;
   FIELD(DO2).CurBias = FB_LANDABLE;
   IF ReviewApproved = TRUE THEN
      FIELD(review_complete).CurBias = FB_VISIBLE;      
      FIELD(OK_btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(review_complete).CurBias = FB_VISIBLE;      
      FIELD(Cancel_btn).CurBias = FB_LANDABLE;
   ENDIF;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;

ON CLICK Ok_btn =
BEGIN
/*
** Release Incoming Messages
*/
   CALLPROC EUE_SendExternalEvent('ext_MessageRelease',RightOperatorName); 

   RETURN PU_OK;
END;

ON CLICK Cancel_btn =
DECLARE
   MsgAck = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF ReviewComplete = FALSE THEN

    IF CurFrame.ConfirmPopup (MessageText = 'All issued moves will be aborted.') = PU_CANCEL THEN
      RESUME;
    ELSE
/*
** Cancel outgoing message if not yet acknowledged.
*/
      IF MsgKey > 0 THEN
         RetCode = CALLPROC CancelMessage(CanOverride = TRUE);
         IF RetCode = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;      

      CALLPROC SOA_LogIns (
                Card           = Card
               ,Job            = NULL
               ,SwitchingItem  = SwitchingItem
               ,Time           = DATE('now')
               ,UserName       = UserName
               ,Item           = 'Override Canceled'
               ,Old            = 'Warning Override Review Cancelled'
               ,New            = 'All Issued Moves Aborted'
               );
      CALLPROC DDB_COMMIT;
    ENDIF; 
   ENDIF;
/*
** Release Incoming Messages
*/
   CALLPROC EUE_SendExternalEvent('ext_MessageRelease',RightOperatorName); 

   RETURN PU_CANCEL;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE LoggedInOps (
) = 
BEGIN
/*
** Prepare list of logged in operators
*/
   CL.ChoiceItems[1].EnumValue = 0;
   CL.ChoiceItems[1].EnumText = '';
   i = 1;
   SELECT :Ops[i].Operator = L.Operator,
          :Ops[i].OperatorName = L.OperatorName,
          :Ops[i].Machine = L.Machine
   FROM   SOA_DOLogin L,
          Udb_Object O
   WHERE  L.LogOut IS NULL AND
          L.Operator = O.Object  AND
          L.Operator <> :DOp.Object /*  AND
          O.Type = :Type$DistrictOperator */
   ORDER BY 2
   BEGIN
      CL.ChoiceItems[i+1].EnumValue = Ops[i].Operator;
      CL.ChoiceItems[i+1].EnumText = Ops[i].OperatorName;
      i = i + 1;
   END;

   FIELD(Operator2).ValueList = CL.Duplicate();
   FIELD(Operator2).UpdChoiceList();
END;


PROCEDURE CancelMessage (
   CanOverride = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   MsgAck = INTEGER NOT NULL;
   MsgText = VARCHAR(256) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Cancel outgoing message if not yet acknowledged.
*/
   MsgAck = 0;
   SELECT :MsgAck = Ack
   FROM   MSG_Message
   WHERE  MsgKey = :MsgKey;

   IF MsgAck <> 0 THEN
      IF CanOverride = TRUE THEN
         IF CurFrame.ConfirmPopUp (MessageText = 'DO #2 is reviewing Warnings. Do you still want to Cancel?') = 
              PU_CANCEL THEN
            RETURN PU_CANCEL;
         ENDIF;
      ELSE
         MESSAGE 'DO #2 is already reviewing Warnings.  Allow DO #2 to complete this process or Cancel.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;

   RetCode = CALLPROC MSG_UpdateMsg (Card = Card,
                                 MsgKey = MsgKey,
                                 Ack = Ack$Delete,
                                 AckByOpName = DOp.Description,
                                 AckDate = date('now'),
                                 DelByOpName = DOp.Description,
                                 DelDate = date('now'),
                                 Substation = FIELD(Operator2).CurEnumValue);
   IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          Message 'Error deleting outgoing message.  The message has not been ' +
             'deleted.  Please try again or contact your technical support.';
          RETURN PU_CANCEL; 
   ENDIF;
   FIELD(Send_btn).CurBias = FB_DIMMED;
   MsgText = VARCHAR(TwoOpConfirmEvent) + ';';
   RAISE DBEVENT SOA_WarningReviewAbort :MsgText;
   CALLPROC DDB_COMMIT; 
   MsgKey = 0;
   RETURN PU_OK;
END;


PROCEDURE LoadWarnings (
) =
DECLARE
   JIndex = INTEGER NOT NULL WITH DEFAULT;
   HP = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Load issued moves followed by warnings per move
*/
   ReviewApproved = TRUE;
   i = 1;
   REPEATED
   SELECT :J[i].Job = W.Job,
          :J[i].TORS = W.TORS,
          :J[i].Seq = W.Seq,
          :J[i].ToMove = J.ToMove,
          :J[i].RsMove = J.RsMove,
          :J[i].EquipClassName = J.EquipClassName,
          :J[i].EquipName = J.EquipName,
          :J[i].PrintID = JC.PrintID,
          :J[i].Substation = J.Substation,
          :J[i].ToIssuedBg = 0,
          :J[i].RsIssuedBg = 0
   FROM   SOA_WarningOverrideEvent W,
          SOA_Job J,
          SOA_JobControl JC
   WHERE  W.TwoOpConfirmEvent = :TwoOpConfirmEvent AND
          W.Job = J.Job AND
          J.Job = JC.Job AND
          JC.Card = :Card
   ORDER BY Seq
   BEGIN
      IF J[i].TORS = 1 THEN   /*Display RS Move text*/
         J[i].MoveOrWarning = J[i].RsMove;
      ELSE
         J[i].MoveOrWarning = J[i].TOMove;
      ENDIF;

      IF J[i].Substation <> 0 AND CurrentApplication <> Application$FMS THEN
         SELECT :J[i].SubstationName = Name
         FROM   Udb_Object
         WHERE  Object = :J[i].Substation; 
      ENDIF;
      FIELD(J[i].MoveOrWarning).BgColor = CC_PALE_BLUE;
      FIELD(J[i].ToIssuedFg).BgPattern = FP_Clear;
      FIELD(J[i].RsIssuedFg).BgPattern = FP_Clear;
      JIndex = i;

      HP = 0;
      SELECT :J[i+1].MoveOrWarning = 'High Pot Test Criteria:  ' +  
                              'FeederKV= ' + VARCHAR(feederkv) +
                              '; ' + :HC_NEWLINE + 'TestTypeKV= ' + VARCHAR(testtypekv) +
                              '; Duration= ' + VARCHAR(Duration) +
                              '; MaxMA= ' + VARCHAR(maxma),
              :HP = Job
      FROM   FMS_HiPotTestCriteria
      WHERE  Job = :J[i].Job
      UNION
      SELECT 'High Pot Test Criteria:  ' +  
                              'Phase= ' + VARCHAR(phase) +
                              '; ' + :HC_NEWLINE + 'EquipKV= ' + VARCHAR(equipkv) +
                              '; TestTypeKV= ' + VARCHAR(testtypekv) +
                              '; Duration= ' + VARCHAR(Duration) +
                              '; MaxMA= ' + VARCHAR(DECIMAL(maxma,5,1)), 
             Job
      FROM   SOA_HiPotTestCriteria
      WHERE  Job = :J[i].Job;

      IF HP > 0 THEN
         FIELD(J[i+1].MoveOrWarning).BgColor = CC_PALE_BLUE;
         FIELD(J[i+1].ToIssuedFg).BgPattern = FP_Clear;
         FIELD(J[i+1].RsIssuedFg).BgPattern = FP_Clear;
         i = i + 2;
      ELSE
         i = i + 1;
      ENDIF;      
      SELECT :J[i].MoveOrWarning = WarningText,
             :J[i].TOIssued = LogDate,   /* Need for sort */
             :J[i].Seq = WarningType,
             :J[i].ToOperator = Operator,
             :J[i].RsOperator = Operator2,
             :J[i].ToIssuedBg = 0,
             :J[i].RsIssuedBg = 0,
             :J[i].Job = 0,
             :J[i].BaseKey = HashInteger
      FROM   SOA_Warning
      WHERE  TwoOpConfirmEvent = :TwoOpConfirmEvent AND
             Job = :J[JIndex].Job 
      ORDER BY 2
      BEGIN 
         IF J[i].Seq = 1 THEN  /*Warning*/
            FIELD(J[i].ToIssuedFg).BgPattern = FP_BitMap;
            FIELD(J[i].RsIssuedFg).BgPattern = FP_BitMap;
            FIELD(J[i].MoveOrWarning).BgColor = CC_YELLOW;

            IF ReviewStage = 'Op2' THEN
               FIELD(J[i].ToIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
               FIELD(J[i].RsIssuedFg).BgBitmap = FIELD(notok_templt).BgBitmap;
            ENDIF;

            IF J[i].RsOperator > 0 THEN
               FIELD(J[i].ToIssuedFg).BgBitmap = FIELD(ok_templt).BgBitmap;
            ELSEIF ReviewComplete = TRUE THEN
               FIELD(J[i].RsIssuedFg).BgBitmap = FIELD(ok_templt).BgBitmap;
               ReviewApproved = FALSE;
            ENDIF;
         ELSEIF J[i].Seq = 2 THEN  /*Override*/
            FIELD(J[i].MoveOrWarning).BgColor = CC_RED;
            FIELD(J[i].ToIssuedFg).BgPattern = FP_Clear;
            FIELD(J[i].RsIssuedFg).BgPattern = FP_Clear;
         ELSEIF J[i].Seq = 4 THEN  /*Op 2 Comment*/
            DO2.ReturnComment = J[i].MoveOrWarning;
            J.RemoveRow (rownumber = i);
            i = i - 1;
         ENDIF;
         i = i + 1;
      END;
   END;

   IF J.LastRow() < 13 THEN
      FIELD(J).NumVisibleRows = J.LastRow();
   ENDIF;
   IF CurrentApplication = Application$FMS THEN
      FIELD(J[*].SubstationName).CurBias = FB_INVISIBLE;
   ELSE
      FIELD(J[*].PrintID).CurBias = FB_INVISIBLE;
   ENDIF;
   CurFrame.Flush();
END;
						 *Default Item


Application Component Report
============================

	Name:            WarningOverrideReview_backup

/*
**  Application:    CAC
**  Frame:          WarningOverrideReview
**
**  Modifications:
**  08/13/15 em     Created
**  09/29/15 em     Default loginname and other onsite changes
**                  If Not Ok is selected, make all remaining warnings Not OK
**  09/30/15 em     Add READ option to LoadCommonCard dbevent
**  10/05/15 em     Set and clear Warning Review Lock
**  10/06/15 em     Add HashInteger attribute for uniqueness
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;      /* Passed  card */
    ReviewStage = CHAR(3);        /* Passed "Op1" or "Op2" */
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT;      /* Passed sw item */
    TwoOpConfirmEvent = DATE NOT NULL;  /* Passed Date */

    i = INTEGER NOT NULL;       
    k = INTEGER NOT NULL;       
    CL = ChoiceList;

    ControlText = VARCHAR(120) NOT NULL WITH DEFAULT;
    CredentialsConfirmed = INTEGER NOT NULL WITH DEFAULT;
    MsgKey = INTEGER NOT NULL WITH DEFAULT;       
    Ops = ARRAY OF DistrictOperatorClass;
    RetCode = INTEGER NOT NULL;   /* return variable */
    ReviewApproved = INTEGER NOT NULL WITH DEFAULT;
    ReviewComplete = INTEGER NOT NULL WITH DEFAULT;
    RightOperatorName = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   LoadWarnings = PROCEDURE;
   LoggedInOps = PROCEDURE;
   CancelMessage = PROCEDURE RETURNING INTEGER;
ENDDECLARE
BEGIN
   ReviewComplete = FALSE;
   CredentialsConfirmed = FALSE;
   IF ReviewStage = 'Op1' THEN
      Operator1 = DOp.Description;
      FIELD(Send_btn).CurBias = FB_DIMMED;
      FIELD(DO2).CurBias = FB_INVISIBLE;
      FIELD(OK_btn).CurBias = FB_INVISIBLE;
      CALLPROC LoggedInOps();
      CurFrame.PurgeDBEvent (DBEventName = 'SOA_WarningReviewAbort');
      CurFrame.StatusText = 'Select DO #2 to review Warning Overrides';
   ENDIF;
   IF ReviewStage = 'Op2' THEN
      FIELD(DO2).CurBias = FB_INVISIBLE;
      FIELD(J[*].ToIssuedBg).CurBias = FB_CHANGEABLE;
      FIELD(J[*].RsIssuedBg).CurBias = FB_CHANGEABLE;
      FIELD(Credentials).CurBias = FB_CHANGEABLE;
      FIELD(SelectText).CurBias = FB_INVISIBLE;
      FIELD(Send_btn).CurBias = FB_INVISIBLE;
      FIELD(Cancel_btn).CurBias = FB_INVISIBLE;
      FIELD(OK_btn).CurBias = FB_INVISIBLE;
      FIELD(Back1_btn).CurBias = FB_LANDABLE;
      FIELD(Reload_btn).CurBias = FB_LANDABLE;
      CL.ChoiceItems[1].EnumValue = DOp.Object;
      CL.ChoiceItems[1].EnumText = DOp.Description;
      Credentials.OperatorName = DOp.LoginName;
      FIELD(Operator2).ValueList = CL.Duplicate();
      FIELD(Operator2).UpdChoiceList();
      FIELD(Operator2).CurBias = FB_VISIBLE;
      FIELD(Operator2).BgColor = CC_PALE_PURPLE;
      CurFrame.StatusText = 'DO #2 Review - Mark Warnings OK or Not OK';
   ENDIF;
/*
**  Use right two digits for managing Warning Review Lock messages
*/
   RightOperatorName = INT4(Right(UserName,2));

   CALLPROC LoadWarnings();
   ControlText = UserName + ';' + VARCHAR(Card) + ';' + 
                 CurrentApplication + ';' + 'READ;';
/*
** Clear DB Events that are queued
*/
   CurFrame.PurgeDBEvent(DBEventName = 'SOA_CompleteWarningOverride');
END;


ON SETVALUE Operator2 =
DECLARE
   MsgString = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   MsgKey = 0;
   IF Operator2 <> 0 THEN
/*
      FIELD(Send_btn).CurBias = FB_LANDABLE;
      FIELD(Send_btn).TextLabel = 'Send Incoming Msg';
*/
      MsgString = 'WARNING OVERRIDE REVIEW' + HC_NEWLINE +
               'District Operator ' + DOp.Description + ' has requested you to ' +
               'review and confirm warnings.' + HC_NEWLINE +
               'Click "Review Warnings" to load card with warnings.';  
      MsgKey = CALLPROC MSG_SendMsg (
                Card = Card,
                Action = 0,
                OrderNumber = SwitchingItem,
                Substation = FIELD(Operator2).CurEnumValue,
                SubstationName = FIELD(Operator2).CurEnumText,
                Msg = MsgString,
                FromOpName = DOp.Description,
                SendDate = IFNULL(TwoOpConfirmEvent,''),
                ToApp = CurrentApplication,
                FromApp = UserName,
                Priority = 1
                );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK; 
         MsgKey = 0;
         MESSAGE 'Error sending incoming message to DO #2.';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;

         CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #1 has requested Warning Override Review',
            New  = 'Requested of ' + FIELD(Operator2).CurEnumText);
         CALLPROC DDB_COMMIT;

         FIELD(Operator2).CurBias = FB_VISIBLE;
         FIELD(Send_btn).CurBias = FB_LANDABLE;
         FIELD(Send_btn).TextLabel = 'Rescind Message';
         CurFrame.StatusText = 'Waiting for DO #2 to review warning overrides.';
/*
** Lock Incoming Messages
*/
         CALLPROC EUE_SendExternalEvent('ext_MessageLock',RightOperatorName); 
      ENDIF;
   ENDIF;
END;


ON CLICK Send_btn =
DECLARE
   MsgString = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF FIELD(Send_btn).TextLabel = 'Rescind Message' THEN  
      IF MsgKey > 0 THEN
         RetCode = CALLPROC CancelMessage();
         IF RetCode = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;    
      FIELD(Operator2).CurBias = FB_CHANGEABLE;
      FIELD(Operator2).CurEnumValue = 0;
      FIELD(Send_btn).TextLabel = 'Send Incoming Msg';
      FIELD(Send_btn).CurBias = FB_DIMMED;
      CurFrame.StatusText = 'Select DO #2 to review Warning Overrides';
   ELSE
      IF FIELD(Operator2).CurEnumValue = 0 THEN
         MESSAGE 'Must select district operator to review.';
         RESUME;
      ENDIF;

      MsgString = 'WARNING OVERRIDE REVIEW' + HC_NEWLINE +
               'District Operator ' + DOp.Description + ' has requested you to ' +
               'review and confirm certain yellow warning overrides.' + HC_NEWLINE +
               'Click "Review Warnings" to load card with warnings.';  
      MsgKey = CALLPROC MSG_SendMsg (
                Card = Card,
                Action = 0,
                OrderNumber = SwitchingItem,
                Substation = FIELD(Operator2).CurEnumValue,
                SubstationName = FIELD(Operator2).CurEnumText,
                Msg = MsgString,
                FromOpName = DOp.Description,
                SendDate = IFNULL(TwoOpConfirmEvent,''),
                ToApp = CurrentApplication,
                FromApp = UserName,
                Priority = 1
                );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK; 
         MsgKey = 0;
         MESSAGE 'Error sending incoming message to DO #2.';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;

         CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #1 has requested Warning Override Review',
            New  = 'Requested of ' + FIELD(Operator2).CurEnumText);
         CALLPROC DDB_COMMIT;

         FIELD(Send_btn).TextLabel = 'Rescind Message';
         CurFrame.StatusText = 'Waiting for DO #2 to review warning overrides.';
      ENDIF; 
   ENDIF;
END;

ON CHILDSETVALUE J[*].TOIssuedBg =
DECLARE
   x = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Don't allow change unless enabled.
*/
   IF FIELD(J[].TOMove).BgColor = CC_YELLOW THEN
      IF J[].TOIssuedBg = 1 THEN
            J[].RSIssuedBg = 0;

            x = 1; 
            WHILE x <= J.LastRow() DO
               IF J[].RSIssuedBg = 1 THEN
                  ENDLOOP;
               ENDIF;
               x = x + 1;
            ENDWHILE;

            IF x > J.LastRow() THEN
               FIELD(Credentials).CurBias = FB_CHANGEABLE;
               FIELD(DO2).CurBias = FB_INVISIBLE;
            ENDIF;
      ENDIF;
   ELSE
      J[].TOIssuedBg = 0;
   ENDIF;
END;

ON CHILDSETVALUE J[*].RSIssuedBg =
DECLARE
   x = INTEGER NOT NULL WITH DEFAULT;
   y = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   x = FIELD(J).CurRow;
/*
** Don't allow change unless enabled.
*/
   IF FIELD(J[].TOMove).BgColor = CC_YELLOW THEN
      IF J[].RSIssuedBg = 1 THEN
         J[].TOIssuedBg = 0;
         FIELD(DO2).CurBias = FB_CHANGEABLE;
         FIELD(Credentials).CurBias = FB_INVISIBLE;
         FOR y = x TO J.LastRow() DO
            IF FIELD(J[y].TOMOve).BgColor = CC_YELLOW THEN
               J[y].TOIssuedBg = 0;
               J[y].RSIssuedBg = 1;
            ENDIF;
         ENDFOR; 
      ENDIF;
   ELSE
      J[].RSIssuedBg = 0;
   ENDIF;
END;


ON CLICK Back1_btn = 
DECLARE
   ApprvValue = VARCHAR(24) NOT NULL WITH DEFAULT;
   LastJob = INTEGER NOT NULL WITH DEFAULT;
   UnapprovedJob = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Review to make sure all warnings are marked  
*/
   ApprvValue = 'APPROVED';
   FOR i = 1 TO J.LastRow DO
      IF J[i].Job <> 0 AND LastJob = 0 THEN 
         LastJob = J[i].Job;
      ENDIF;
      IF J[i].Job = 0 AND J[i].Seq = 1 THEN
         IF J[i].RSIssuedBg = 1 THEN
            ApprvValue = 'NOT APPROVED';
            FIELD(DO2).CurBias = FB_CHANGEABLE;
            FIELD(Credentials).CurBias = FB_INVISIBLE;
         ENDIF;
         IF J[i].TOIssuedBg = 0 AND J[i].RSIssuedBg = 0 AND ApprvValue = 'APPROVED'THEN
            MESSAGE 'Please mark all Yellow Warnings OK or Not OK';
            RESUME;
         ENDIF;
         IF J[i].TOIssuedBg = 1 AND J[i].RSIssuedBg = 1 THEN
            MESSAGE 'You have double marked a Yellow Warning both OK and Not OK';
            RESUME;
         ENDIF;
         IF J[i].RSIssuedBg = 1 AND DO2.ReturnComment = '' THEN
            MESSAGE 'Please enter a DO #2 Comment for your Not OK response';
            RESUME;
         ENDIF;
         IF UnapprovedJob = 0 AND J[i].RSIssuedBg = 1 THEN
            UnapprovedJob = LastJob;
         ENDIF;
      ENDIF;
   ENDFOR;
/*
** Perform Credential check
*/
   IF ApprvValue = 'APPROVED' AND
        (Credentials.OperatorName = '' OR Credentials.Password = '') THEN
      MESSAGE 'Please enter your Operations Network Login and Password.';
      FIELD(Credentials).CurBias = FB_CHANGEABLE;
      FIELD(DO2).CurBias = FB_INVISIBLE;
      RESUME;
   ENDIF;

   IF ApprvValue = 'APPROVED' THEN
      RetCode = CALLPROC CredentialCheck(Password=Credentials.Password,
                           OperatorName = Credentials.OperatorName);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Credential/Login Check Failed.';
         CredentialsConfirmed = FALSE;
         RESUME;
      ELSE
         CredentialsConfirmed = TRUE;
      ENDIF;

      IF CredentialsConfirmed = FALSE THEN
         RESUME;
      ENDIF;
   ENDIF;
/*
** Mark warnings approved if Ok flag checked.
*/
   FOR i = 1 TO J.LastRow DO
      IF J[i].ToIssuedBg = 1 THEN
         RetCode = CALLPROC SOA_WarningUpd (
                      LogDate = IFNULL(J[i].ToIssued,''),
                      Operator = IFNULL(J[i].ToOperator,0),
                      Operator2 = DOp.Object,
                      Operator2Name = DOp.Description,
                      TwoOpConfirmEvent = TwoOpConfirmEvent,
                      HashInteger = J[i].BaseKey);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to save warning approvals.';
            RESUME;
            ENDLOOP;
         ENDIF;
      ENDIF;
   ENDFOR;

   IF ApprvValue = 'APPROVED' THEN
      DO2.ReturnComment = 'Warning Override Validated by ' + DOp.Description;
      UnapprovedJob = LastJob;
   ENDIF;

   RetCode = CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 4,
                   WarningText = DO2.ReturnComment,
                   Card = Card,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   TwoOpConfirmEvent = TwoOpConfirmEvent,
                   Job = IFNULL(UnapprovedJob,0));
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to insert warning into SOA_Warning table '
          +           'for card ' + VARCHAR(Card) + ' Warning: ' + DO2.ReturnComment
          );
      ENDIF;

   CALLPROC SOA_LogIns (
            Card = Card,
            Job  = NULL,
            SwitchingItem = SwitchingItem,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Review Warning',
            Old  = 'DO #2 has completed Warning Override Review',
            New  = ApprvValue + ' by ' + DOp.Description);
   CALLPROC DDB_COMMIT;
   CurFrame.ParentFrame.SendUserEvent (EventName = 'WarningFrameExit');
   RETURN;
END;

ON CLICK Reload_btn =
BEGIN
   IF CurrentApplication = Application$FMS THEN
      RAISE DBEVENT FMS_LoadCommonCard :ControlText;
   ELSE
      RAISE DBEVENT SOA_LoadCommonCard :ControlText;
   ENDIF;
END;
/*
** The following DBEvent incidates DO #1 has aborted the moves
*/
ON DBEVENT 'SOA_WarningReviewAbort' =
DECLARE
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   WO_Event = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   ControlText = CurFrame.DBEvent.DBEventText;

   WO_Event = '';
   WO_Event = left(ControlText,(locate(ControlText,';')-1));

   IF WO_Event = TwoOpConfirmEvent AND ReviewStage = 'Op2' THEN
      MESSAGE 'DO#1 has aborted the moves, your review is no longer needed.';
      CurFrame.ParentFrame.SendUserEvent (EventName = 'WarningFrameExit');
      RETURN;
   ENDIF;
END;
/*
** The following DBEvent indicates DO #2 has completed the review
*/
ON DBEVENT 'SOA_CompleteWarningOverride' =
DECLARE
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   ControlUser = VARCHAR(24) NOT NULL WITH DEFAULT;
   WO_Event = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   ControlText = CurFrame.DBEvent.DBEventText;

   ControlUser = left(ControlText,(locate(ControlText,';')-1));   
/*
** Ignore ControlUser, it is DO #2
*/
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));
   WO_Event = '';
   WO_Event = left(ControlText,(locate(ControlText,';')-1));

   IF WO_Event <> TwoOpConfirmEvent THEN
/*
** Somebody else's event
*/    
      RESUME;
   ENDIF;

   CurFrame.StatusText = 'DO #2 has completed Warning Override Review';
   ReviewComplete = TRUE;
   CALLPROC LoadWarnings();
   FIELD(Send_btn).CurBias = FB_DIMMED;
   FIELD(DO2).CurBias = FB_LANDABLE;
   IF ReviewApproved = TRUE THEN
      FIELD(review_complete).CurBias = FB_VISIBLE;      
      FIELD(OK_btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(review_complete).CurBias = FB_VISIBLE;      
      FIELD(Cancel_btn).CurBias = FB_LANDABLE;
   ENDIF;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;

ON CLICK Ok_btn =
BEGIN
/*
** Release Incoming Messages
*/
   CALLPROC EUE_SendExternalEvent('ext_MessageRelease',RightOperatorName); 

   RETURN PU_OK;
END;

ON CLICK Cancel_btn =
DECLARE
   MsgAck = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF ReviewComplete = FALSE THEN

    IF CurFrame.ConfirmPopup (MessageText = 'All issued moves will be aborted.') = PU_CANCEL THEN
      RESUME;
    ELSE
/*
** Cancel outgoing message if not yet acknowledged.
*/
      IF MsgKey > 0 THEN
         RetCode = CALLPROC CancelMessage(CanOverride = TRUE);
         IF RetCode = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;      

      CALLPROC SOA_LogIns (
                Card           = Card
               ,Job            = NULL
               ,SwitchingItem  = SwitchingItem
               ,Time           = DATE('now')
               ,UserName       = UserName
               ,Item           = 'Override Canceled'
               ,Old            = 'Warning Override Review Cancelled'
               ,New            = 'All Issued Moves Aborted'
               );
      CALLPROC DDB_COMMIT;
    ENDIF; 
   ENDIF;
/*
** Release Incoming Messages
*/
   CALLPROC EUE_SendExternalEvent('ext_MessageRelease',RightOperatorName); 

   RETURN PU_CANCEL;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE LoggedInOps (
) = 
BEGIN
/*
** Prepare list of logged in operators
*/
   CL.ChoiceItems[1].EnumValue = 0;
   CL.ChoiceItems[1].EnumText = '';
   i = 1;
   SELECT :Ops[i].Operator = L.Operator,
          :Ops[i].OperatorName = L.OperatorName,
          :Ops[i].Machine = L.Machine
   FROM   SOA_DOLogin L,
          Udb_Object O
   WHERE  L.LogOut IS NULL AND
          L.Operator = O.Object AND
          L.Operator <> :DOp.Object /* AND
          O.Type = :Type$DistrictOperator */
   ORDER BY 2
   BEGIN
      CL.ChoiceItems[i+1].EnumValue = Ops[i].Operator;
      CL.ChoiceItems[i+1].EnumText = Ops[i].OperatorName;
      i = i + 1;
   END;

   FIELD(Operator2).ValueList = CL.Duplicate();
   FIELD(Operator2).UpdChoiceList();
END;


PROCEDURE CancelMessage (
   CanOverride = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   MsgAck = INTEGER NOT NULL;
   MsgText = VARCHAR(256) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Cancel outgoing message if not yet acknowledged.
*/
         MsgAck = 0;
         SELECT :MsgAck = Ack
         FROM   MSG_Message
         WHERE  MsgKey = :MsgKey;

         IF MsgAck <> 0 THEN
            IF CanOverride = TRUE THEN
               IF CurFrame.ConfirmPopUp (MessageText = 'DO #2 is reviewing Warnings. Do you still want to Cancel?') = 
                    PU_CANCEL THEN
                  RETURN PU_CANCEL;
               ENDIF;
            ELSE
               MESSAGE 'DO #2 is already reviewing Warnings.  Allow DO #2 to complete this process or Cancel.';
               RETURN PU_CANCEL;
            ENDIF;
         ENDIF;

         RetCode = CALLPROC MSG_UpdateMsg (Card = Card,
                                       MsgKey = MsgKey,
                                       Ack = Ack$Delete,
                                       AckByOpName = DOp.Description,
                                       AckDate = date('now'),
                                       DelByOpName = DOp.Description,
                                       DelDate = date('now'),
                                       Substation = FIELD(Operator2).CurEnumValue);
         IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Error deleting outgoing message.  The message has not been ' +
                   'deleted.  Please try again or contact your technical support.';
                RETURN PU_CANCEL; 
         ENDIF;
         FIELD(Send_btn).CurBias = FB_DIMMED;
         MsgText = VARCHAR(TwoOpConfirmEvent) + ';';
         RAISE DBEVENT SOA_WarningReviewAbort :MsgText;
         CALLPROC DDB_COMMIT; 
         MsgKey = 0;
         RETURN PU_OK;
END;


PROCEDURE LoadWarnings (
) =
DECLARE
   JIndex = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Load issued moves followed by warnings per move
*/
   ReviewApproved = TRUE;
   i = 1;
   REPEATED
   SELECT :J[i].Job = W.Job,
          :J[i].TORS = W.TORS,
          :J[i].Seq = W.Seq,
          :J[i].ToMove = J.ToMove,
          :J[i].RsMove = J.RsMove,
          :J[i].EquipClassName = J.EquipClassName,
          :J[i].EquipName = J.EquipName,
          :J[i].PrintID = JC.PrintID,
          :J[i].Substation = J.Substation
   FROM   SOA_WarningOverrideEvent W,
          SOA_Job J,
          SOA_JobControl JC
   WHERE  W.TwoOpConfirmEvent = :TwoOpConfirmEvent AND
          W.Job = J.Job AND
          J.Job = JC.Job AND
          JC.Card = :Card
   ORDER BY Seq
   BEGIN
      IF J[i].TORS = 1 THEN   /*Display RS Move text*/
         J[i].ToMove = J[i].RsMove;
      ENDIF;

      IF J[i].Substation <> 0 AND CurrentApplication <> Application$FMS THEN
         SELECT :J[i].SubstationName = Name
         FROM   Udb_Object
         WHERE  Object = :J[i].Substation; 
      ENDIF;
      FIELD(J[i].ToMove).BgColor = CC_PALE_BLUE;
      FIELD(J[i].TOIssuedBg).BgColor = CC_PALE_BLUE;
      FIELD(J[i].RSIssuedBg).BgColor = CC_PALE_BLUE;
      JIndex = i;

      i = i + 1;
      SELECT :J[i].ToMove = WarningText,
             :J[i].TOIssued = LogDate,   /* Need for sort */
             :J[i].Seq = WarningType,
             :J[i].ToOperator = Operator,
             :J[i].RsOperator = Operator2,
             :J[i].ToIssuedBg = 0,
             :J[i].RsIssuedBg = 0,
             :J[i].Job = 0,
             :J[i].BaseKey = HashInteger
      FROM   SOA_Warning
      WHERE  TwoOpConfirmEvent = :TwoOpConfirmEvent AND
             Job = :J[JIndex].Job 
      ORDER BY 2
      BEGIN 
         IF J[i].Seq = 1 THEN  /*Warning*/
            FIELD(J[i].ToMove).BgColor = CC_YELLOW;
/*
            IF ReviewStage = 'Op2' THEN
               FIELD(J[i].TOIssuedBg).BgColor = CC_YELLOW;
               FIELD(J[i].RSIssuedBg).BgColor = CC_YELLOW;
            ENDIF;
*/
            IF J[i].RsOperator > 0 THEN
               J[i].ToIssuedBg = 1;
            ELSEIF ReviewComplete = TRUE THEN
               J[i].RSIssuedBg = 1;
               ReviewApproved = FALSE;
            ENDIF;
         ELSEIF J[i].Seq = 2 THEN  /*Override*/
            FIELD(J[i].ToMove).BgColor = CC_RED;
            FIELD(J[i].TOIssuedBg).BgColor = CC_RED;
            FIELD(J[i].RSIssuedBg).BgColor = CC_RED;
         ELSEIF J[i].Seq = 4 THEN  /*Op 2 Comment*/
            DO2.ReturnComment = J[i].ToMove;
            J.RemoveRow (rownumber = i);
            i = i - 1;
         ENDIF;
         i = i + 1;
      END;
   END;

   IF J.LastRow() < 13 THEN
      FIELD(J).NumVisibleRows = J.LastRow();
   ENDIF;
   IF CurrentApplication = Application$FMS THEN
      FIELD(J[*].SubstationName).CurBias = FB_INVISIBLE;
   ELSE
      FIELD(J[*].PrintID).CurBias = FB_INVISIBLE;
   ENDIF;
END;
						 *Default Item


