*/
METHOD LoadOutageReport(
) = 
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;

   ActualDate = DATE DEFAULT NULL;
   AdjustedDate = DATE DEFAULT NULL;
   DivName  = VARCHAR(10) NOT NULL WITH DEFAULT;
   DivNameList = VARCHAR(60) NOT NULL WITH DEFAULT;   /* List of divisions */
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   PrevDivision = INTEGER NOT NULL WITH DEFAULT;
   PrevNumber = VARCHAR(40) NOT NULL WITH DEFAULT;
   PrevIndex = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
   TempOR = OutageReport;
   WorkGroup = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ORList.Clear();
      
   IF CurObject.Status = 0 THEN  // ALL
      DynamicWhereClause = 'R.Status >= 0'; 
   ELSEIF CurObject.Status = 1 THEN // Active
      DynamicWhereClause = 'R.Status >= 0 ' + 
                           ' AND R.Status < ' + VARCHAR(Order$Closed);
   ELSE
      DynamicWhereClause = 'R.Status >= ' + VARCHAR(Order$Closed);
   ENDIF;

   // Specific Outage Request?
   IF CurObject.ORNumber <> '' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND R.ORNumber = ''' + CurObject.ORNumber + ''' ';
   ENDIF;
   DynamicWhereClause = DynamicWhereClause + ' AND R.ORNumber = W.ORNumber ';
   
   /*
   **  Build division filter based on input parameters passed in.
   */
   If lowercase(CurObject.DivisionName) like 'all%' THEN
      /* No filter by division */
   ELSE
      DivNameList = '';
      WHILE LENGTH(CurObject.DivisionName) > 0 DO
         IF DivNameList <> '' THEN
            DivNameList = DivNameList + ',';
         ENDIF; 
         DivName= left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1));   
         DivNameList = DivNameList + DivName;

         CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
      ENDWHILE;
      DynamicWhereClause = DynamicWhereClause + ' AND W.Division IN (' + DivNameList + ')';         
   ENDIF;  

   // filter date range
   IF CurObject.FilterTargetType = 1 THEN                // Outage Date filter
      IF CurObject.FilterDateType = 0 THEN // Scheduled
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.SkedOutageDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';

      ELSEIF CurObject.FilterDateType = 1 THEN // Actual
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.ActualOutageDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';
      ENDIF;

   ELSEIF CurObject.FilterTargetType = 2 THEN                // Start date filter
      IF CurObject.FilterDateType = 0 THEN // Scheduled
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.SkedStartDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';

      ELSEIF CurObject.FilterDateType = 1 THEN // Actual
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.ActualStartDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';
      ENDIF;
   
   ELSEIF CurObject.FilterTargetType = 3 THEN                // Return date filter
      IF CurObject.FilterDateType = 0 THEN // Scheduled
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.SkedReturnDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';

      ELSEIF CurObject.FilterDateType = 1 THEN // Actual
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.ActualReturnDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';
      ENDIF;

   ELSEIF CurObject.FilterTargetType = 4 THEN                // InService date filter
      IF CurObject.FilterDateType = 0 THEN // Scheduled
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.SkedInserviceDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';

      ELSEIF CurObject.FilterDateType = 1 THEN // Actual
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                ' (R.ActualInServiceDate BETWEEN ' + '''' + VARCHAR(CurObject.FilterStartDate) + '''' + 
                ' AND ' + '''' + VARCHAR(CurObject.FilterEndDate) + '''' + ')';
      ENDIF;
   ENDIF;
   
   // only include requests where an item has been linked to a permit in FMS/TOMS
   DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' W.ORNumber = P.ORNumber AND ' + 
             ' W.WorkItem = P.WorkItem';
   
   IF LowerCase(CurObject.WorkGroup) = 'all' OR CurObject.WorkGroup = '' THEN   
      i = 1;
      PrevDivision = 0;
      PrevNumber = '';
      
      SELECT DISTINCT
             :TempOR.Division = W.Division,
             :TempOR.ORNumber = R.ORNumber,
             :TempOR.Status = R.Status,
             :TempOR.CurrentStatus = R.CurrentStatus,
             :TempOR.Location = R.Location,
             :TempOR.Title = R.Title,
             :TempOR.Instruction = R.Instruction,
             :TempOR.SkedOutageDate = R.SkedOutageDate,
             :TempOR.ActualOutageDate = R.ActualOutageDate,
             :TempOR.ActualWorkIssueDate = R.ActualWorkIssueDate,
             :TempOR.SkedStartDate = R.SkedStartDate,
             :TempOR.ActualStartDate = R.ActualStartDate,
             :TempOR.SkedReturnDate = R.SkedReturnDate,
             :TempOR.ActualReturnDate = R.ActualReturnDate,
             :TempOR.SkedInserviceDate = R.SkedInserviceDate,
             :TempOR.ActualInserviceDate = R.ActualInserviceDate,
             :WorkGroup = P.WorkGroup
      FROM   SOA_OutageRequest R,
             SOA_ORWorkItem W,
             SOA_OutageRequestPermit P
      WHERE  :DynamicWhereClause 
      ORDER BY Division, ORNumber
      BEGIN  
         IF PrevDivision <> TempOR.Division OR PrevNumber <> TempOR.ORNumber THEN;
            CurObject.ORList[i].Division = TempOR.Division;
            CurObject.ORList[i].ORNumber = TempOR.ORNumber;
            CurObject.ORList[i].Status = TempOR.Status;
            CurObject.ORList[i].CurrentStatus = TempOR.CurrentStatus;
            CurObject.ORList[i].Location = TempOR.Location;
            CurObject.ORList[i].Title = TempOR.Title;
            CurObject.ORList[i].Instruction = TempOR.Instruction;
            CurObject.ORList[i].SkedOutageDate = TempOR.SkedOutageDate;
            CurObject.ORList[i].ActualOutageDate = TempOR.ActualOutageDate;
            CurObject.ORList[i].ActualWorkIssueDate = TempOR.ActualWorkIssueDate;
            CurObject.ORList[i].SkedStartDate = TempOR.SkedStartDate;
            CurObject.ORList[i].ActualStartDate = TempOR.ActualStartDate;
            CurObject.ORList[i].SkedReturnDate = TempOR.SkedReturnDate;
            CurObject.ORList[i].ActualReturnDate = TempOR.ActualReturnDate;
            CurObject.ORList[i].SkedInserviceDate = TempOR.SkedInserviceDate;
            CurObject.ORList[i].ActualInserviceDate = TempOR.ActualInserviceDate;
            k = 1;
            CurObject.ORList[i].WorkGroups[k].Name = WorkGroup;
            PrevIndex = i;
            PrevDivision = TempOR.Division;
            PrevNumber = TempOR.ORNumber;
            i = i + 1;
         ELSE
            k = CurObject.ORList[PrevIndex].WorkGroups.LastRow + 1;
            CurObject.ORList[PrevIndex].WorkGroups[k].Name = WorkGroup;
         ENDIF;
      END;
   ELSE
      DynamicWhereClause = DynamicWhereClause + ' AND P.WorkGroup = ''' + CurObject.WorkGroup + '''';
      i = 1;
      SELECT DISTINCT
             :CurObject.ORList[i].Division = W.Division,
             :CurObject.ORList[i].ORNumber = R.ORNumber,
             :CurObject.ORList[i].Status = R.Status,
             :CurObject.ORList[i].CurrentStatus = R.CurrentStatus,
             :CurObject.ORList[i].Location = R.Location,
             :CurObject.ORList[i].Title = R.Title,
             :CurObject.ORList[i].Instruction = R.Instruction,
             :CurObject.ORList[i].SkedOutageDate = R.SkedOutageDate,
             :CurObject.ORList[i].ActualOutageDate = R.ActualOutageDate,
             :CurObject.ORList[i].ActualWorkIssueDate = R.ActualWorkIssueDate,
             :CurObject.ORList[i].SkedStartDate = R.SkedStartDate,
             :CurObject.ORList[i].ActualStartDate = R.ActualStartDate,
             :CurObject.ORList[i].SkedReturnDate = R.SkedReturnDate,
             :CurObject.ORList[i].ActualReturnDate = R.ActualReturnDate,
             :CurObject.ORList[i].SkedInserviceDate = R.SkedInserviceDate,
             :CurObject.ORList[i].ActualInserviceDate = R.ActualInserviceDate,
             :CurObject.ORList[i].WorkGroups[1].Name = P.WorkGroup
      FROM   SOA_OutageRequest R,
             SOA_ORWorkItem W,
             SOA_OutageRequestPermit P
      WHERE  :DynamicWhereClause 
      ORDER BY Division, ORNumber
      BEGIN         
         i = i + 1;
      END;   
   ENDIF;
   
   /* 
   ** Loop through each request to get OUTAGE and WORK ISSUED delays reasons and
   ** check whethere or not it is late in work return and in-service
   */   
   FOR i = 1 TO CurObject.ORList.LastRow DO
      IF CurObject.ORList[i].ActualOutageDate IS NOT NULL OR
         CurObject.ORList[i].ActualWorkIssueDate IS NOT NULL THEN
         k = 1;
         REPEATED
         SELECT :CurObject.ORList[i].DList[k].TypeName = D.DelayType,
                :CurObject.ORList[i].DList[k].Category = D.DelayCategory,
                :CurObject.ORList[i].DList[k].CategoryName = T1.Name,
                :CurObject.ORList[i].DList[k].Subcategory = D.DelaySubcategory,
                :CurObject.ORList[i].DList[k].SubcategoryName = T2.Name,
                :CurObject.ORList[i].DList[k].Division = D.Division,
                :CurObject.ORList[i].DList[k].WorkGroup = T3.Name,
                :CurObject.ORList[i].DList[k].Reason = D.DelayReason
         FROM   SOA_ORDelay D,
                Udb_Type T1,
                Udb_Type T2,
                Udb_Type T3
         WHERE  D.ORNumber = :CurObject.ORList[i].ORNumber AND
                D.DelayCategory = T1.Type AND
                D.DelaySubcategory = T2.Type AND
                D.WorkingGroup = T3.Type 
         BEGIN
            k = k + 1;
         END;
      ENDIF;

      /* 
      ** if Actual Return Time > (Actual Work Start + (Sched Return Time - Sched Start Time)),
      ** this will count as an All Work Complete delay.
      */
      IF CurObject.ORList[i].ActualStartDate IS NOT NULL THEN
         ActualDate = CurObject.ORList[i].ActualReturnDate;
         IF ActualDate IS NULL THEN
            ActualDate = DATE('NOW');
         ENDIF;
         
         AdjustedDate = CurObject.ORList[i].ActualStartDate + 
               (CurObject.ORList[i].SkedReturnDate - CurObject.ORList[i].SkedStartDate);
         IF ActualDate > AdjustedDate THEN
            CurObject.ORList[i].LateWorkReturn = TRUE;
         ENDIF;
      ENDIF;
      
      /*
      ** if Actual In-Service Time > (Actual Return Time + (Sched In-Service Time � Sched Return Time))
      ** THEN this will count as Return to Service delay.
      */
      IF CurObject.ORList[i].ActualReturnDate IS NOT NULL THEN
         ActualDate = CurObject.ORList[i].ActualInserviceDate;
         IF ActualDate IS NULL THEN
            ActualDate = DATE('NOW');
         ENDIF;
         
         AdjustedDate = CurObject.ORList[i].ActualReturnDate + 
               (CurObject.ORList[i].SkedInserviceDate - CurObject.ORList[i].SkedReturnDate);
         IF ActualDate > AdjustedDate THEN
            CurObject.ORList[i].LateInService = TRUE;
         ENDIF;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

METHOD CheckORByCard(
   Card = INTEGER NOT NULL 
) =
DECLARE
   CutOffReturnTime = DATE NOT NULL;
   MultipleKVFlag = INTEGER NOT NULL WITH DEFAULT;
   ORCount 	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Filter out requests whose scheduled return date is more than two weeks old
*/
   SELECT :CutOffReturnTime = DATE('NOW') - '14 Days';
   
   ORCount = 0;
/*
** Look for Outstanding Requests based on Substation in the OR work items.
** This is a change for FMS, we used to be able to identify a feeder.
*/
   IF CurrentApplication = Application$FMS THEN
      REPEATED
      SELECT   :ORCount = COUNT(*)
      FROM     SOA_OutageRequest R,
               SOA_ORWorkItem WI,
               TFMS_CardToObject CTO,
               Udb_Grouping G,
               Udb_ExtendedType ET
      WHERE    CTO.Card = :Card AND
               CTO.Object = G.Member AND 
               G.Relationship = :Interaction$MemberOf AND
               G.GroupingType = ET.Type AND
               ET.SuperType = :Type$Substation AND
               G.Grouping = WI.Substation AND
               WI.ORNumber = R.ORNumber AND
               UPPER(R.Jurisdiction) = 'DISTRIBUTION' AND
               R.Status = :Order$Opened AND
              (R.SkedReturnDate IS NULL OR R.SkedReturnDate > :CutOffReturnTime);
   
   ELSEIF CurrentApplication = Application$TFMS THEN
      REPEATED
      SELECT   :ORCount = COUNT(*)
      FROM     SOA_ORWorkItem W,
               SOA_OutageRequest R,
               TFMS_CardToObject O,
               Udb_Grouping G1,
               Udb_Grouping G2,
               Udb_Object OO
      WHERE    O.Card = :Card AND
               O.Type = :Type$Substation AND
               O.Object = W.Substation AND
               W.ORNumber = R.ORNumber AND
               UPPER(R.Jurisdiction) <> 'DISTRIBUTION' AND
               R.Status = :Order$Opened AND
              (R.SkedReturnDate IS NULL OR R.SkedReturnDate > :CutOffReturnTime) AND
               W.Substation = G1.Member AND
               G1.Relationship = :Interaction$Memberof AND
               G1.Grouping = G2.Member AND
               G2.Relationship = :Interaction$Memberof AND
               G2.Grouping = OO.Object AND
               OO.Type = :Type$OperatorDesk AND 
               OO.Name = :UserGroup;

   ELSEIF CurrentApplication = Application$SLC THEN
      MultipleKVFlag = 1;
      SELECT :MultipleKVFlag = MultipleKVFlag 
      FROM   SLC_Card 
      WHERE  Card = :Card;

      IF MultipleKVFlag = 1 THEN
         SELECT :ORCount = COUNT(*)
         FROM   SLC_Card C,
                UDB_Grouping G,
                SOA_ORWorkItem W,
                SOA_OutageRequest R        
         WHERE  C.Card = :Card AND
                C.Substation = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.Reference > 0 AND 
                G.Member = W.Substation AND
                W.ORNumber = R.ORNumber AND
                UPPER(R.Jurisdiction) <> 'DISTRIBUTION' AND
                R.Status = :Order$Opened AND
               (R.SkedReturnDate IS NULL OR R.SkedReturnDate > :CutOffReturnTime);

      ELSE
         SELECT :ORCount = COUNT(*)
         FROM   SOA_ORWorkItem W,
                SOA_OutageRequest R, 
                SLC_Card C           
         WHERE  C.Card = :Card AND
                C.Substation = W.Substation AND
                W.ORNumber = R.ORNumber AND
                UPPER(R.Jurisdiction) <> 'DISTRIBUTION' AND
                R.Status = :Order$Opened AND
               (R.SkedReturnDate IS NULL OR R.SkedReturnDate > :CutOffReturnTime);
      ENDIF;
   ENDIF;
   RETURN (ORCount);     
END;

METHOD LoadNeverLinked(
) = 
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;

   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ORList.Clear();
      
   i = 1;   
   SELECT :CurObject.ORList[i].ORNumber = R.ORNumber,
          :CurObject.ORList[i].Location = R.Location,
          :CurObject.ORList[i].Title = R.Title,
          :CurObject.ORList[i].SkedOutageDate = R.SkedOutageDate,
          :CurObject.ORList[i].SkedStartDate = R.SkedStartDate,
          :CurObject.ORList[i].Jurisdiction = R.Jurisdiction
   FROM   SOA_ORNeverLinked R
   WHERE  R.SkedOutageDate BETWEEN :CurObject.FilterStartDate AND :CurObject.FilterEndDate
   UNION ALL
   SELECT 
          R.ORNumber,
          R.Location,
          R.Title,
          R.SkedOutageDate,
          R.SkedStartDate,
          R.Jurisdiction
   FROM   SOA_OutageRequest R
   WHERE  R.Status = :Order$Opened AND
          (R.SkedOutageDate BETWEEN :CurObject.FilterStartDate AND :CurObject.FilterEndDate)
   ORDER BY SkedOutageDate
   BEGIN  
      i = i + 1;
   END;  
   CALLPROC DDB_ROLLBACK;
   
   /*
   ** Get the number of requests during the same period that have been processed.
   */
   CurObject.Total = 0;
   
   SELECT :CurObject.Total = COUNT(*) 
   FROM   SOA_OutageRequest R
   WHERE  R.Status > :Order$Opened AND
          (R.SkedOutageDate BETWEEN :CurObject.FilterStartDate AND :CurObject.FilterEndDate);
   
   /*
   ** total numbers of requests 
   */
   CurObject.Total = CurObject.Total + CurObject.ORList.LastRow;
   
   RETURN;
END;

Application Component Report
============================

	Name:            OutageReportDelay


Application Component Report
============================

	Name:            OutageReportLog


Application Component Report
============================

	Name:            Override

/*
**
**  Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          Override
**
**  08/24/98 em     Copied and modified for SOA.
**  02/18/03 pkw    Added code for Yellow Warning report.
**  11/14/03 ysp    ITC143: add code to save job data for Yellow Warning report.
**  05/24/05 em     Extended Reason field to 80 chars from 60
**  12/08/09 em     Adding second operator confirmation of warnings
**  02/17/12 em     Modified second operator validation to be tight
**                  on District Operator and ECC Manager
**  11/28/12 em     Only validate second operator when connected to production database
**  08/05/15 em     Begin enhanced two operator confirm development.
**                  Three possible override types based on application.
**  09/29/15 em     Chnaged second operator indicator text
**  05/02/18 em     Add method call to record WarningBackout on Cancel.
**  05/24/18 em		WarningType=3 on override Cancel
**  04/15/19 em     Don't Clear WarningBuffer on OK click.
**  05/28/19 em     Don't Record Backout for TEST cardclass
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;
    Job = INTEGER;  /*Nullable*/
    SwitchingItem = INTEGER; /*Nullable*/
    i = integer NOT NULL WITH DEFAULT;
    PreSel = integer ;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    CardClass = INTEGER NOT NULL;
    CardName = VARCHAR(200) NOT NULL WITH DEFAULT;
    ConfirmWarning = INTEGER NOT NULL WITH DEFAULT;
    EmployeeName   = VARCHAR(40) NOT NULL WITH DEFAULT;
    EmployeeObject = INTEGER NOT NULL WITH DEFAULT;
    EmployeeType   = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   PreSel = 1;
   EmployeeObject = 0;
   EmployeeName = '';
/*
** Decide whether to present Two Operator confirmation.
** Enhanced Two Operator in effect only for electronic orders.
*/
   IF CurrentApplication = Application$FMS THEN
      SELECT :CardName = FeederName
      FROM   FMS_Card
      WHERE  Card = :Card;    
      SELECT :ConfirmWarning = ConfirmWarning
      FROM   FMS_SystemParameters;
   ELSEIF CurrentApplication = Application$TFMS THEN
      SELECT :CardName = FeederNames
      FROM   TFMS_Card
      WHERE  Card = :Card;
      SELECT :ConfirmWarning = ConfirmWarning
      FROM   TFMS_SystemParameters;
   ELSEIF CurrentApplication = Application$SLC THEN
      SELECT :CardName = SubstationName
      FROM   SLC_Card
      WHERE  Card = :Card;
      SELECT :ConfirmWarning = ConfirmWarning
      FROM   SLC_SystemParameters;
   ELSE
      SELECT :ConfirmWarning = ConfirmWarning
      FROM   AllApp_SystemParameters;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
/*
**  Get CardClass information for SOA_Warning insert.
*/
   IF SwitchingItem IS NULL OR
      SwitchingItem = 0 THEN
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SOA_Card
      WHERE   Card = :Card;
   ELSE
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SLC_InformationItem
      WHERE   Job = :SwitchingItem;
   ENDIF;
/*
** ConfirmWarning Values:
**    0 = Single Operator
**    1 = Standard Two Operator
**    2 = Enhanced Two Operator
*/
   IF ConfirmWarning = 0 THEN
      FIELD(OpConfirm).CurBias = FB_INVISIBLE;
      FIELD(W[*].Op1).CurBias = FB_INVISIBLE;
      FIELD(W[*].Op2).CurBias = FB_INVISIBLE;
   ELSEIF ElectronicOrder = FALSE OR ConfirmWarning = 1 THEN
      ConfirmWarning = 1;   /* Just in case value was 2 when not an electronic order */
      OpConfirm.Operator1 = Dop.Description;
      FIELD(OpConfirm).CurBias = FB_CHANGEABLE;
   ELSEIF ElectronicOrder = TRUE AND ConfirmWarning = 2 THEN
      FIELD(OpConfirm).CurBias = FB_INVISIBLE;
      FIELD(W[*].Op2).CurBias = FB_INVISIBLE;
      EnhancedTwoOpReview = TRUE;
      FIELD(TwoOp).CurBias = FB_VISIBLE;
   ENDIF; 

   IF WarningBuffer.LastRow() = 0 THEN
      MESSAGE 'Error presenting override screen with no warnings in buffer. Contact technical support.';
      CurFrame.SendUserEvent (EventName = 'NoWarning');
      RESUME;
   ENDIF;

   FOR i = 1 TO WarningBuffer.LastRow() DO
      W[i].WarningText = WarningBuffer[i].WarningText;
   ENDFOR;
   Curframe.InputFocusField = FIELD(Reason);
END;
/*
**  Handle the childclick 
*/
ON ChildSetValue W[*].Op2  =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
/*
**  Reset the highlight for the frame
*/
    Presel = FIELD(W).CurRow;
    IF OpConfirm.Operator2 = '' THEN
       MESSAGE 'Must enter DO#2 Employee number.';
       W[Presel].Op2 = 0;
    ENDIF;
END;
/*
**  Handle an OK click
*/
ON Click OKButton =
BEGIN

    IF Lowercase (Reason) LIKE '%fuck%' OR 
       Lowercase (Reason) LIKE '%shit%' OR 
       Lowercase (Reason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        Reason = '';
	RESUME;

   ELSEIF Length( Squeeze (Reason)) <= 6 THEN

        MESSAGE 'You must enter more explanation ';
        Reason = '';
       RESUME;

   ELSEIF ConfirmWarning = 1 THEN

      IF OpConfirm.Operator2 = '' THEN
         MESSAGE 'A second operator or manager must confirm this Warning!';
         RESUME;
      ENDIF;

      FOR i = 1 TO W.LastRow() DO
         IF W[i].Op1 = 0 OR W[i].Op2 = 0 THEN
            MESSAGE 'Each warning must be confirmed and marked by two District Operators.';
            RESUME;
            ENDLOOP;
         ENDIF;
      ENDFOR;

   ELSEIF ConfirmWarning = 2 THEN

      FOR i = 1 TO W.LastRow() DO
         IF W[i].Op1 = 0 THEN
            MESSAGE 'Each warning must be confirmed and marked.';
            RESUME;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDIF;

    IF CardClass <> Type$CardClassTest THEN   
       CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   Operator2 = EmployeeObject,
                   Operator2Name = EmployeeName,
                   UserName = UserName,
                   WarningType = 2,
                   WarningText = Reason,
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   TwoOpConfirmEvent = TwoOpConfirmEvent,
                   Job = IFNULL(Job,0));
       CALLPROC DDB_COMMIT;
    ENDIF;

    RetCode = CALLPROC SOA_LogIns (Card = Card,
                Job = Job,
                SwitchingItem = SwitchingItem,
                Time = DATE('now'),
                UserName = UserName,
                Item = 'Override',
                Old = Reason,
                New = 'DO #2: ' + EmployeeName);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
        RETURN (Reason);
    ELSE
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to log that a warning was overridden. Transaction cancelled'; 
        RETURN (NULL);
    ENDIF;
END;
/*
**  Handle a Cancel click
*/
ON USEREVENT 'NoWarning',
ON Click CancelButton =
DECLARE
   AllWarningText = VARCHAR(1000) NOT NULL WITH DEFAULT;
BEGIN
   IF CardClass <> Type$CardClassTest THEN   
      CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 3,
                   WarningText = 'Warning not overridden',
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   Job = IFNULL(Job,0));
      CALLPROC DDB_COMMIT;
   
      IF WarningBuffer.LastRow = 1 THEN
         ALLWarningText = WarningBuffer[1].WarningText;
      ELSE
         FOR i = 1 TO WarningBuffer.LastRow DO
            AllWarningText = AllWarningText + 'Warning #' + VARCHAR(i) + ': ' + 
                          WarningBuffer[i].WarningText + ';';
         ENDFOR;
      ENDIF;
   
      DOp.RecordBackout (WarningText = AllWarningText);
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                Job = Job,
                SwitchingItem = SwitchingItem,
                Time = DATE('now'),
                UserName = UserName,
                Item = 'Warning',
                Old = Reason,
                New = 'Warning not overridden');
   IF RetCode = 0 THEN
       CALLPROC DDB_COMMIT;
       WarningBuffer.Clear();
       RETURN (NULL);
   ELSE
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Unable to log that a warning was not overridden.';
       WarningBuffer.Clear();
       RETURN (NULL);
   ENDIF;
END;


ON WINDOWCLOSE =

   BEGIN
    RESUME;
   END;


ON SETVALUE Opconfirm.Operator2 =
BEGIN
/*
** If not connected to production fms server, then we don't validate second operator
*/
   IF uppercase(right(CurSession.GetEnv(name='DDB_SessionCur'),3)) = DB$ProductionDB THEN
/*
** Evaluate entered employee number
*/
      EmployeeObject = 0;
      SELECT :EmployeeObject = Object,
             :EmployeeType = Type,
             :EmployeeName = Description
      FROM   Udb_Object 
      WHERE  Name = :OpConfirm.Operator2 AND
             Type IN (SELECT Type FROM Udb_ExtendedType
                      WHERE  SuperType IN (:Type$DistrictOperator,
                                           :Type$ECCManager));

      IF EmployeeObject = 0 THEN
         MESSAGE 'Operator or manager with employee number ' +
                 VARCHAR(OpConfirm.Operator2) +
                 ' does not exist in the database.  Warning is ' +
                 'not confirmed.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF;     

      IF EmployeeObject = Dop.Object THEN
         MESSAGE 'Warning must be reviewed and confirmed by someone else.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF;  

      IF EmployeeObject = Operator$StaffSupport OR EmployeeType = Type$Staff THEN
         MESSAGE 'Staff Support is not qualified to confirm this Warning.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF; 
/*
** If not a Manager then confirm that DO is logged in on another machine
*/      
      IF EmployeeType <> Type$ECCManager THEN
         i = 0;
         SELECT :i = Operator
         FROM   SOA_DOLogin
         WHERE  Operator = :EmployeeObject AND
                LogOut IS NULL;

         IF i = 0 THEN
            MESSAGE 'Second Operator ' + VARCHAR(OpConfirm.Operator2) + ' - ' +
                    EmployeeName + ' is not logged in at this time.  Must ' +
                    'be logged in on another machine to confirm a warning.';
            OpConfirm.Operator2 = '';
            RESUME;
         ENDIF;
      ENDIF;
   ENDIF;
END;

