/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    FMS_BusinessLogic
**  Class:          TM_Alert_ASE
**
**  Date:       Version Description
** ----------------------------------
**  03/04/02    pkw     Created; 
**  06/11/02    pkw     Only monitor AUTO card types for operatingsteps.
**  06/28/02    pkw     Add automated out of service tracking.
**  07/05/02    pkw     Fix problem with automated message.
**  01/08/03    em      Converted FMS_Job to SOA
**  05/06/03    em      Add support for CIOA Card Type
**  05/14/03    pkw     Only monitor Auto and CIOA cards that are out of service
**                      and are not in OTW+.
**  05/16/03    pkw     Make FOD orders look at jobstatus instead of orderstatus.
**  05/30/03    pkw     If Permit re-initialized after returned, we need ignore
**                      it in the select by checking if ReturnTime is not null
**                      when permit status is initialized.
**  06/13/03    pkw     Make FOD Orders use job instead of ordernumber in object
**                      field.
**  06/17/03    pkw     Don't monitor data for FCR Permits if ReturnTime is not
**                      null.
**  07/31/03    pkw     Added Permit$Rejected to FCR monitoring.
**  08/07/03    pkw     Add FOD return status 
**  03/17/04    ysp     Change column CompletedTime to ReturnTime for operating 
**                      orders.
**  05/18/04    ysp     Display the substation names for operating orders
**  06/01/04    ysp     added OpStepBogeyTime method. Also modified the include 
**                      script (TM_AlertTableUpdates) to set the alert time if
**                      the op step is one of the combined steps (ISTA or OTW).
**  01/14/05    pkw     Add Type$OTWR and Type$OTWS when looking for estimated
**                      Completion time.
**  03/25/05    pkw     Modify UpdateAlertTable method to use entire primary
**                      key when filtering data to avoid duplicate key on 
**                      insert error.
**  04/05/05    pkw     Keep track of Estimated Complete time as long as it is 
**                      not equal blank or ActTimeComplete is equal blank.
**  02/06/06    pkw     Add IFNULL to select to prevent runtime error.
**  05/15/06    pkw     Add logic for Temperature variable bogies.
**  05/31/06    pkw     Add '1 second' to starttime of FOD orders to prevent
**                      duplicate key error.
**  06/30/06    pkw     Add update for TV on all statuses.
**  07/10/06    pkw     Move logic from ir_monitors to task monitor for setting
**                      PENDING ACK delays.
**  05/30/07    pkw     Modify SendAlerts Method to not insert delay if we can't 
**                      find a job to link it too.
**  11/16/10    pkw     3G Updates.
**  03/24/11    pkw     Update selects to get correct Divisions for 3g Feeders.
**  10/09/14    pkw     When sending bogey exceeded for PFS change statusname
**                      to TEST if there are no outstanding de-energize moves.
**  10/17/14    pkw     Also check for PFSS when setting TEST status.
**  09/20/15    pkw     Add support for PFS composite operating step.
**  01/24/17    pkw     Add support for I/LOC composite operating step.
**  05/16/18    pkw     Add support for TC Steps and Delays
**  05/22/18    pkw     Don't set notified flag when re-sending out pstn email.
**  05/22/18    pkw     Filter list when loading alerts for FMS
*/ 
METHOD LoadAlerts (
   TCUser = INTEGER NOT NULL WITH DEFAULT;
   FMSFilter = INTEGER NOT NULL WITH DEFAULT;
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   Alerts   = ARRAY OF TM_Alert;
   DynamicWhereClause = VARCHAR(500) NOT NULL;
   i        = INTEGER NOT NULL;
   j        = INTEGER NOT NULL;
   OldCard  = INTEGER NOT NULL;
   OldIndex = INTEGER NOT NULL;
   RetCode  = INTEGER NOT NULL;
   TimeNow  = DATE    NOT NULL WITH DEFAULT;
   OpenAutoCheck  = DATE    NOT NULL WITH DEFAULT;
   TempStr  = VARCHAR(40) NOT NULL WITH DEFAULT;
   TV_Check = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/* 
** Purpose of this method is to Load alerts for particular divisions into the Task Manager
** screen run from the message monitor application.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK; 

   DynamicWhereClause = 'B.Type = A.Type AND ' +
                        'B.Status = A.Status AND ' +
                        'A.Division IN ( ';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  Load TM_BogeyAlert table with Operating Order data.
*/
   Alerts.Clear();
   i = 1;
   IF TCUser = TRUE THEN
      DynamicWhereClause = 'B.Type IN (' + 
             varchar(Type$TCOpStepHeading) + ',' + 
             varchar(Type$TCDelay) + ') AND ' + 
             DynamicWhereClause;
      SELECT Alerts[i].Card = A.Card,
             Alerts[i].Type = A.Type,
             Alerts[i].TypeName = B.TypeName,
             Alerts[i].StartTime = A.StartTime,
             Alerts[i].Description = A.Description,
             Alerts[i].Division = A.Division,
             Alerts[i].Feeder = A.Feeder,
             Alerts[i].FeederName = A.FeederName,
             Alerts[i].CardClass = A.CardClass,
             Alerts[i].CardClassName = A.CardClassName,
             Alerts[i].AlertTime = A.AlertTime,
             Alerts[i].InitialAlert = A.InitialAlert,
             Alerts[i].NextAlert = B.NextAlert,
             Alerts[i].Object = A.Object,
             Alerts[i].Status = A.Status,
             Alerts[i].StatusName = B.StatusName
      FROM   TM_BogeyAlert A,
             TM_BogeyType B
      WHERE :DynamicWhereClause
      ORDER BY Card, AlertTime 
      BEGIN
         IF Alerts[i].AlertTime < TimeNow THEN
            Alerts[i].Color = CC_RED;
         ELSEIF Alerts[i].InitialAlert = FALSE THEN
            Alerts[i].Color = CC_YELLOW;
         ELSE
            Alerts[i].Color = CC_LIGHT_GREEN;
         ENDIF;
         i = i + 1;
      END; 
   ELSE
      IF FMSFilter = 1 THEN  /* FMS only */
         DynamicWhereClause = 'B.Type NOT IN (' + 
             varchar(Type$TCOpStepHeading) + ',' + 
             varchar(Type$TCDelay) + ') AND ' + 
             DynamicWhereClause;
      ELSEIF FMSFilter = 2 THEN  /* TLS only */
         DynamicWhereClause = 'B.Type IN (' + 
             varchar(Type$TCOpStepHeading) + ',' + 
             varchar(Type$TCDelay) + ') AND ' + 
             DynamicWhereClause;
      ENDIF;
      
      SELECT Alerts[i].Card = A.Card,
             Alerts[i].Type = A.Type,
             Alerts[i].TypeName = B.TypeName,
             Alerts[i].StartTime = A.StartTime,
             Alerts[i].Description = A.Description,
             Alerts[i].Division = A.Division,
             Alerts[i].Feeder = A.Feeder,
             Alerts[i].FeederName = A.FeederName,
             Alerts[i].CardClass = A.CardClass,
             Alerts[i].CardClassName = A.CardClassName,
             Alerts[i].AlertTime = A.AlertTime,
             Alerts[i].InitialAlert = A.InitialAlert,
             Alerts[i].NextAlert = B.NextAlert,
             Alerts[i].Object = A.Object,
             Alerts[i].Status = A.Status,
             Alerts[i].StatusName = B.StatusName
      FROM   TM_BogeyAlert A,
             TM_BogeyType B
      WHERE :DynamicWhereClause
      ORDER BY Card, AlertTime 
      BEGIN
         IF Alerts[i].AlertTime < TimeNow THEN
            Alerts[i].Color = CC_RED;
         ELSEIF Alerts[i].InitialAlert = FALSE THEN
            Alerts[i].Color = CC_YELLOW;
/*  Since we aren't showing estimated time no need to do this statement.
      ELSEIF Alerts[i].Type = TM$OtherType AND
        (Alerts[i].Status = TM$StatusEstComplete OR
         Alerts[i].Status = TM$StatusEstInservice) AND
         Alerts[i].StartTime < TimeNow THEN
         Alerts[i].Color = CC_YELLOW;
*/
         ELSE
            Alerts[i].Color = CC_LIGHT_GREEN;
         ENDIF;
/*
**  Don't show estimated times unless they are overdue.
*/
         IF Alerts[i].Color <> CC_RED AND
           (Alerts[i].Type = TM$OtherType OR
            Alerts[i].Type = TM$TVOtherType) AND
           (Alerts[i].Status = TM$StatusEstComplete OR
            Alerts[i].Status = TM$StatusEstInservice) THEN
            Alerts.RemoveRow(RowNumber = i);
         ELSE
            i = i + 1;
         ENDIF;
      END; 
   ENDIF;
   CALLPROC DDB_ROLLBACK;   
/*
**  Parse through the list and put all category reds at the top.
*/   
   OldCard = 0;
   FOR i = 1 to Alerts.LastRow() DO
      IF Alerts[i].Card = OldCard THEN

#        include TM_FormatAlert

         CurObject.Dlist[OldIndex].Details.InsertRow (RowNumber = 1,
                                                      RowObject = Alerts[i].Duplicate());
         /*
         **  If it is red already, do nothing.  Otherwise we need to look and see if 
         **  color priority needs to be changed.
         */
         IF CurObject.Dlist[OldIndex].Color <> CC_RED THEN
            IF Alerts[i].AlertTime < TimeNow THEN
               CurObject.Dlist[OldIndex].Color = CC_RED;
            ELSE
               IF CurObject.Dlist[OldIndex].Color <> CC_YELLOW THEN
                  IF Alerts[i].InitialAlert = FALSE THEN
                     CurObject.Dlist[OldIndex].Color = CC_YELLOW;
                  ENDIF;
               ENDIF;
            ENDIF;
         ENDIF;
      ELSE
         /*
         **  Update CardClassName if needed.
         */
         IF (Alerts[i].CardClass = Type$Auto OR 
             Alerts[i].CardClass = Type$CIOA) THEN
             OpenAutoCheck = '';
             SELECT :OpenAutoCheck = IFNULL(OpenAutoPlus,'')
             FROM   FMS_Card
             WHERE  Card = :Alerts[i].Card;
             IF OpenAutoCheck <> '' THEN
                Alerts[i].CardClassName = Alerts[i].CardClassName + '+';
             ENDIF;
             TV_Check = 0;
             SELECT :TV_Check = TV_Bogey
             FROM   FMS_Card
             WHERE  Card = :Alerts[i].Card;
             IF TV_Check > 0 THEN
                Alerts[i].CardClassName = 'TV ' + Alerts[i].CardClassName;
             ENDIF;
         ENDIF;
         /*
         **  Initialize OldCard and OldIndex
         */
         OldIndex = 0;
         OldCard = 0;
         Alerts[i].DisplayText = Alerts[i].FeederName + ' (' + 
                                 Alerts[i].CardClassName + ')';
         IF Alerts[i].Color = CC_RED THEN
            /* RED category alert, put at top */
            CurObject.Dlist.InsertRow (RowNumber = 1,
                                       RowObject = Alerts[i].Duplicate());
#           include TM_FormatAlert

            CurObject.Dlist[1].Details.InsertRow (RowNumber = 1,
                                                  RowObject = Alerts[i].Duplicate());   
            OldIndex = 1;
            OldCard = Alerts[i].Card; 

         ELSEIF Alerts[i].Color = CC_YELLOW THEN
            /* YELLOW category alert, put at top of yellow alerts */
            FOR j = 1 TO CurObject.Dlist.LastRow() DO
               IF CurObject.Dlist[j].Color = CC_YELLOW OR
                  CurObject.Dlist[j].Color = CC_LIGHT_GREEN  THEN
                  
                  CurObject.Dlist.InsertRow (RowNumber = j,
                                             RowObject = Alerts[i].Duplicate());
#                 include TM_FormatAlert
                  CurObject.Dlist[j].Details.InsertRow (RowNumber = 1,
                                                        RowObject = Alerts[i].Duplicate());   
                  OldIndex = j;
                  OldCard = Alerts[i].Card; 
                  ENDLOOP;                  
               ENDIF; 
            ENDFOR;
            
            IF OldIndex = 0 THEN /* Did not find any green or yellow alerts */
               OldIndex = CurObject.Dlist.LastRow() + 1;
               CurObject.Dlist.InsertRow (RowNumber = OldIndex,
                                          RowObject = Alerts[i].Duplicate());
#              include TM_FormatAlert
               CurObject.Dlist[OldIndex].Details.InsertRow (RowNumber = 1,
                                                            RowObject = Alerts[i].Duplicate());   
               OldCard = Alerts[i].Card;             
            ENDIF;
         ELSE
            /* GREEN category alert, put at top of green alerts */
            FOR j = 1 TO CurObject.Dlist.LastRow() DO
               IF CurObject.Dlist[j].Color = CC_LIGHT_GREEN  THEN
                  
                  CurObject.Dlist.InsertRow (RowNumber = j,
                                             RowObject = Alerts[i].Duplicate());
#                 include TM_FormatAlert
                  CurObject.Dlist[j].Details.InsertRow (RowNumber = 1,
                                                        RowObject = Alerts[i].Duplicate());   
                  OldIndex = j;
                  OldCard = Alerts[i].Card; 
                  ENDLOOP;                  
               ENDIF; 
            ENDFOR;
            
            IF OldIndex = 0 THEN /* Did not find any green alerts */
               OldIndex = CurObject.Dlist.LastRow() + 1;
               CurObject.Dlist.InsertRow (RowNumber = OldIndex,
                                          RowObject = Alerts[i].Duplicate());
#              include TM_FormatAlert
               CurObject.Dlist[OldIndex].Details.InsertRow (RowNumber = 1,
                                                            RowObject = Alerts[i].Duplicate());   
               OldCard = Alerts[i].Card;             
            ENDIF;         
         ENDIF;
      ENDIF;
/*
**  Put current operating step in duration field for feeder record.
*/
      IF Alerts[i].Type = Type$OperatingStepStatus OR
         Alerts[i].Type = TM$TVBogey OR 
         Alerts[i].Type = Type$TCOpStepHeading THEN
         CurObject.Dlist[OldIndex].Duration = Alerts[i].StatusName;
      ENDIF;
   ENDFOR;
   

   RETURN;
END;


METHOD InsertUserAlert (
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to insert an alert defined by the user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   RetCode = CALLPROC TM_BogeyAlertIns(Card = CurObject.clist[1].Card,
                                       Type = CurObject.clist[1].Type,
                                       StartTime = CurObject.clist[1].StartTime,
                                       Description = CurObject.clist[1].Description,
                                       Division = CurObject.clist[1].Division,
                                       Feeder = CurObject.clist[1].Feeder,
                                       FeederName = CurObject.clist[1].FeederName,
                                       CardClass = CurObject.clist[1].CardClass,
                                       CardClassName = CurObject.clist[1].CardClassName,
                                       Object = CurObject.clist[1].Object,
                                       Status = CurObject.clist[1].Status,
                                       AlertTime = CurObject.clist[1].AlertTime
                                       );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                               'Not able to insert user defined data into TM_BogeyAlert table.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   ControlText = VARCHAR(CurObject.clist[1].Division) + ';';
   CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                              DBEventText = ControlText);
   CALLPROC DDB_COMMIT;

   RETURN;
END;


METHOD DeleteAlert (
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to insert an alert defined by the user.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.clist[1].Division = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'VALIDATION ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                               'No division parameter passed to Delete Alert method.  Please contact ' +
                               'technical support to fix problem.';
      RETURN;
   ENDIF;   

   
   RetCode = CALLPROC TM_BogeyAlertDel(Card = CurObject.clist[1].Card,
                                       Type = CurObject.clist[1].Type,
                                       StartTime = CurObject.clist[1].StartTime
                                       );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                               'Not able to delete data from TM_BogeyAlert table.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   ControlText = VARCHAR(CurObject.clist[1].Division) + ';';
   CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                              DBEventText = ControlText);
   CALLPROC DDB_COMMIT;

   RETURN;
END;


METHOD ClosedCardCleanup (
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to cleanup any alerts at close card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   CurObject.dlist.Clear();
   REPEATED
   SELECT :CurObject.dlist[i].Card = A.Card,
          :CurObject.dlist[i].Type = A.Type,
          :CurObject.dlist[i].StartTime = A.StartTime,
          :CurObject.dlist[i].Division = A.Division
   FROM    TM_BogeyAlert A
   WHERE   A.Card = :CurObject.Card
   BEGIN 
      i = i + 1;
   END;

   FOR i = 1 TO CurObject.dlist.LastRow() DO
      RetCode = CALLPROC TM_BogeyAlertDel(Card = CurObject.dlist[i].Card,
                                          Type = CurObject.dlist[i].Type,
                                          StartTime = CurObject.dlist[i].StartTime
                                          );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                                  'Not able to delete data from TM_BogeyAlert table.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDFOR;
   
   IF CurObject.dlist.LastRow() <> 0 THEN
      ControlText = VARCHAR(CurObject.dlist[1].Division) + ';';
      CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                                 DBEventText = ControlText);
      CALLPROC DDB_COMMIT;
   ENDIF;
   RETURN;
END;


METHOD SendAlerts (
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   MessageType = INTEGER NOT NULL;
   TempDiv = INTEGER NOT NULL;
   TempChar = VARCHAR(40) NOT NULL;
   RetCode = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(400) NOT NULL;
   DeskType = VARCHAR(20) NOT NULL;
   DccRegion = VARCHAR(40) NOT NULL;
   FODRegion = VARCHAR(40) NOT NULL;
   NextAlertTime = DATE NOT NULL;
   SendMsg = VARCHAR(400) NOT NULL;
   DivisionList = ARRAY OF INTEGEROBJECT;
   DelayCheck         = Integer NOT NULL WITH DEFAULT;
   PendingAckName     = VARCHAR(40) NOT NULL WITH DEFAULT; /*Pending Ack Type Name*/
   CheckTime          = DATE NOT NULL;       
   CutOut             = DATE;                 /* Feeder CutOut Time */
   CutIn              = DATE;                 /* Feeder CutIn Time */
   OrderNumber        = INTEGER NOT NULL;
   OrderCard          = INTEGER NOT NULL;
   OrderCardClassName = VARCHAR(40) NOT NULL WITH DEFAULT;
   OrderFeeder        = INTEGER NOT NULL;
   OrderFeederName    = VARCHAR(40) NOT NULL WITH DEFAULT;
   DelayJob           = ARRAY OF INTEGEROBJECT;
   m                  = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
**  Purpose of this method is to send all exceeded alerts for each division, then find out 
**  when the next alert check should be based on current data.  These alerts will then be 
**  sent via userevent in the task monitor.
*/ 
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   DivisionList.Clear();
   CurObject.dlist.Clear();
   REPEATED
   SELECT CurObject.dlist[i].Card = A.Card,
          CurObject.dlist[i].Type = A.Type,
          CurObject.dlist[i].TypeName = B.TypeName,
          CurObject.dlist[i].StartTime = A.StartTime,
          CurObject.dlist[i].Description = A.Description,
          CurObject.dlist[i].Division = A.Division,
          CurObject.dlist[i].Feeder = A.Feeder,
          CurObject.dlist[i].FeederName = A.FeederName,
          CurObject.dlist[i].CardClass = A.CardClass,
          CurObject.dlist[i].CardClassName = A.CardClassName,
          CurObject.dlist[i].AlertTime = A.AlertTime,
          CurObject.dlist[i].InitialAlert = A.InitialAlert,
          CurObject.dlist[i].NextAlert = B.NextAlert,
          CurObject.dlist[i].AlertResend = B.AlertResend,
          CurObject.dlist[i].Object = A.Object,
          CurObject.dlist[i].Status = A.Status,
          CurObject.dlist[i].StatusName = B.StatusName,
          CurObject.dlist[i].NotifyCSD = B.EnableCSD,
          CurObject.dlist[i].NotifyFOD = B.EnableFOD,
          CurObject.dlist[i].NotifyCIG = B.EnableCIG,
          CurObject.dlist[i].NotifyDCC = B.EnableDCC,
          CurObject.dlist[i].NotifyPGM = B.EnablePGM
   FROM   TM_BogeyAlert A,
          TM_BogeyType B
   WHERE  A.AlertTime < Date('now') AND
          A.Notified = 0 AND
          A.Type = B.Type AND
          A.Status = B.Status
   UNION
/*
**  Send message to DCC once Estmated complete expires.
*/
   SELECT A.Card,
          A.Type,
          B.TypeName,
          A.StartTime,
          A.Description,
          A.Division,
          A.Feeder,
          A.FeederName,
          A.CardClass,
          A.CardClassName,
          A.AlertTime,
          A.InitialAlert,
          B.NextAlert,
          B.AlertResend,
          A.Object,
          A.Status,
          B.StatusName,
          B.EnableCSD,
          B.EnableFOD,
          B.EnableCIG,
          B.EnableDCC,
          B.EnablePGM
   FROM   TM_BogeyAlert A,
          TM_BogeyType B
   WHERE  A.StartTime < Date('now') AND
          A.Notified = 0 AND
         (A.Type = :TM$OtherType OR
          A.Type = :TM$TVOtherType) AND
          A.Status = :TM$StatusEstComplete AND
          A.Type = B.Type AND
          A.Status = B.Status
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
   
   FOR i = 1 TO CurObject.dlist.LastRow() DO
      IF (CurObject.dlist[i].InitialAlert = TRUE OR
          CurObject.dlist[i].AlertResend = TRUE) AND
         (CurObject.dlist[i].NotifyCSD = TRUE OR 
          CurObject.dlist[i].NotifyFOD = TRUE OR         
          CurObject.dlist[i].NotifyCIG = TRUE OR
          CurObject.dlist[i].NotifyDCC = TRUE OR
          CurObject.dlist[i].NotifyPGM = TRUE) THEN
         
         IF(CurObject.dlist[i].Type = TM$OtherType OR
            CurObject.dlist[i].Type = TM$TVOtherType) AND
           (CurObject.dlist[i].Status = TM$StatusEstComplete OR
            CurObject.dlist[i].Status = TM$StatusEstInservice) THEN
            SendMsg = CurObject.dlist[i].StatusName + ' on feeder: ' + 
                      CurObject.dlist[i].FeederName + ' (' + 
                      CurObject.dlist[i].CardClassName + 
                      ') has passed. Please update the ' + 
                      CurObject.dlist[i].StatusName + 
                      ' to the new estimate.';
         ELSE
            SendMsg = CurObject.CompositeMessage(
                                 Card          = CurObject.dlist[i].Card,
                                 OpStep        = CurObject.dlist[i].Status,
                                 StartTime     = CurObject.dlist[i].StartTime,
                                 StatusName    = CurObject.dlist[i].StatusName,
                                 FeederName    = CurObject.dlist[i].FeederName,
                                 CardClassName = CurObject.dlist[i].CardClassName);
         ENDIF; 
         
         IF CurObject.dlist[i].NotifyCSD = TRUE THEN
            /*
            **  If delay is PENDING CREW then only send if a
            **  valid sub-delay was picked.
            */
            IF CurObject.dlist[i].StatusName = 'PENDINGCREW' THEN
               :TempChar = '';
               SELECT :TempChar = OperatingStepName
               FROM    FMS_OperatingStepStatus
               WHERE   Card = :CurObject.dlist[i].Card AND
                       OperatingStep = :CurObject.dlist[i].Type AND
                       StartTime = :CurObject.dlist[i].StartTime;
               IF TempChar = 'Pending 2nd OPR REQ' OR
                  TempChar = 'Pending Crew SW DIST FDR' OR
                  TempChar = 'Pending S/S Crew' OR
                  TempChar = 'Pending S/S Crew on STA work' OR
                  TempChar = 'Pending S/S Crew SW TRANS FDR' OR
                  TempChar = 'Pending SSM' THEN
                  desktype = 'csd';
               ELSE
                  desktype = '';
               ENDIF;
            ELSE
               desktype = 'csd';
            ENDIF;
            /*
            **  Send message to CSD 
            */            
            IF DeskType = 'csd' THEN        
               RetCode = CALLPROC CSD_MessageIns(DeskType = DeskType
                                                ,MessageText = SendMsg
                                                ,Time = date('now')
                                                ,Card = CurObject.Dlist[i].Card
                                                ,Priority = 0
                                                ,MessageType = 0);
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Automated ' + DeskType + ' message ' + 
                        'not sent for ' + CurObject.dlist[i].FeederName + ' regarding: ' + SendMsg);
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
         
         IF CurObject.dlist[i].NotifyFOD = TRUE THEN
            /*
            **  Determine which regions to send message.
            */
            FODRegion = '';
            /* shift 1 char to get rid of d in division user. */
            SELECT DISTINCT
                   :FODRegion = shift(O.Name,-1)
            FROM    Udb_Object O,
                    Udb_Grouping G
            WHERE   G.Member = :CurObject.dlist[i].Division AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType = :Type$Region AND
                    G.Grouping = O.Object;
            CALLPROC DDB_ROLLBACK;
            DeskType = 'fod_' + FODRegion;
            
            IF CurObject.dlist[i].Status = TM$StatusEstComplete AND
              (CurObject.dlist[i].Type = TM$OtherType OR
               CurObject.dlist[i].Type = TM$TVOtherType) THEN
               MessageType = 1;
            ELSE
               MessageType = 0;
            ENDIF; 
            
            RetCode = CALLPROC CSD_MessageIns(DeskType = DeskType
                                             ,MessageText = SendMsg
                                             ,Time = date('now')
                                             ,Card = CurObject.Dlist[i].Card
                                             ,Priority = 0
                                             ,MessageType = MessageType);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Automated ' + DeskType + ' message ' + 
                     'not sent for ' + CurObject.dlist[i].FeederName + ' regarding: ' + SendMsg);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
          
         IF CurObject.dlist[i].NotifyCIG = TRUE THEN
            /*
            **  Send message to CIG 
            */    
            DeskType = 'cig';        
            
            RetCode = CALLPROC CSD_MessageIns(DeskType = DeskType
                                             ,MessageText = SendMsg
                                             ,Time = date('now')
                                             ,Card = CurObject.Dlist[i].Card
                                             ,Priority = 0
                                             ,MessageType = 0);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Automated ' + DeskType + ' message ' + 
                     'not sent for ' + CurObject.dlist[i].FeederName + ' regarding: ' + SendMsg);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
          
         IF CurObject.dlist[i].NotifyDCC = TRUE THEN
            /*
            **  Determine which regions to send message.
            */
            DccRegion = '';
            /* shift 1 char to get rid of d in division user. */
            SELECT DISTINCT
                   :DccRegion = shift(O.Name,-1)
            FROM    Udb_Object O,
                    Udb_Grouping G
            WHERE   G.Member = :CurObject.dlist[i].Division AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType = :Type$Region AND
                    G.Grouping = O.Object;
            CALLPROC DDB_ROLLBACK;
            DeskType = 'dcc_' + DccRegion;
            
            IF CurObject.dlist[i].Status = TM$StatusEstComplete AND
               CurObject.dlist[i].Type = TM$OtherType THEN
               MessageType = 1;
            ELSE
               MessageType = 0;
            ENDIF; 
         
            RetCode = CALLPROC CSD_MessageIns(DeskType = DeskType
                                             ,MessageText = SendMsg
                                             ,Time = date('now')
                                             ,Card = CurObject.Dlist[i].Card
                                             ,Priority = 0
                                             ,MessageType = MessageType);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Automated ' + DeskType + ' message ' + 
                     'not sent for ' + CurObject.dlist[i].FeederName + ' regarding: ' + SendMsg);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
         
         IF CurObject.dlist[i].NotifyPGM = TRUE THEN
            /*
            **  Send message to PGM 
            */    
            DeskType = 'pgm_online';        
            
            RetCode = CALLPROC CSD_MessageIns(DeskType = DeskType
                                             ,MessageText = SendMsg
                                             ,Time = date('now')
                                             ,Card = CurObject.Dlist[i].Card
                                             ,Priority = 0
                                             ,MessageType = 0);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Automated ' + DeskType + ' message ' + 
                     'not sent for ' + CurObject.dlist[i].FeederName + ' regarding: ' + SendMsg);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
/*
**  If we have a downloaded order that has not been Acknowledged we will 
**  apply a PENDING FCR/SSO/FOD ACK delay to the feeder.  This code has been 
**  moved from ir_'fcr/sso/fod'monitors so it can be based on Bogey values.
*/
      /**************************************************************/
      /**             Start of FOD PENDING ACK                     **/
      /**************************************************************/
      IF (CurObject.dlist[i].Type = TM$FODOrder OR
          CurObject.dlist[i].Type = TM$TVFODOrder) AND
          CurObject.dlist[i].Status = Order$Downloaded THEN
      
         DelayCheck = 0;
         SELECT :DelayCheck = COUNT(*) 
         FROM    IR_FODOrderJobs O,
                 IR_FODOrderJobs O2,
                 FMS_JobDelayLink J
         WHERE   O.Job = :CurObject.dlist[i].Object AND
                 O.OrderNumber = O2.OrderNumber AND
                 O2.Job = J.Job;
         CALLPROC DDB_ROLLBACK;

         IF DelayCheck = 0 THEN
            /*
            ** Initialize Pending FOD Ack Name from database here.
            */
            SELECT :PendingAckName = Name
            FROM    Udb_Type
            WHERE   Type = :Type$FODAckDelay;
            /*
            **  Find data associated with order.
            */
            OrderCard = 0;
            SELECT :OrderNumber = O.OrderNumber,
                   :OrderCard = C.Card,
                   :OrderCardClassName = C.CardClassName,
                   :OrderFeeder = C.Feeder,   /*OK for 3G*/
                   :OrderFeederName = C.FeederName,
                   :CutOut = C.CutOut,
                   :CutIn = C.CutIn,
                   :CheckTime = Date('now')
            FROM    IR_FODOrder O,
                    IR_FODOrderJobs J,
                    FMS_Card C
            WHERE   J.Job = :CurObject.dlist[i].Object AND
                    J.JobStatus = :Order$Downloaded AND
                    J.OrderNumber = O.OrderNumber AND
                    O.Card = C.Card;
            CALLPROC DDB_ROLLBACK;
            /*
            **  Find jobs to link delay too. 
            */
            DelayJob.Clear();
            m = 1;           
            SELECT :DelayJob[m].Value = Job 
            FROM    IR_FODOrderJobs
            WHERE   OrderNumber = :OrderNumber AND
                    JobStatus = :Order$Downloaded
            BEGIN
               m = m + 1;
            END;

            IF CutOut IS NULL OR 
               CutIn IS NOT NULL OR 
               OrderCard = 0 OR
               DelayJob.LastRow() = 0 THEN
               /* Do nothing */
            ELSE
               /*
               ** Insert Pending FOD Ack Delay and link to each job associated
               ** with order.
               */
               RetCode = CALLPROC FMS_OperatingStepIns
                                 (Card = OrderCard
                                 ,CardClassName = OrderCardClassName
                                 ,Feeder = OrderFeeder
                                 ,FeederName = OrderFeederName
                                 ,OperatingStep = Type$FODAckDelay
                                 ,OperatingStepName = PendingAckName
                                 ,StartTime = CheckTime
                                 );
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                      'Unable to apply ' + PendingAckName + 
                      ' to Order ' + VARCHAR(OrderNumber));
               ELSE
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Log Delay
                  */
                  CALLPROC SOA_LogIns(Card = OrderCard,
                             Job = NULL,
                             Item = 'Ack Overdue',
                             Old = 'Delay applied to feeder',
                             New = PendingAckName,
                             Time = Date('now'),
                             UserName = 'Task Monitor');
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Link to jobs.
                  */
                  FOR m = 1 TO DelayJob.LastRow() DO
                     RetCode = CALLPROC FMS_JobDelayLinkIns
                                 (Job = DelayJob[m].Value
                                 ,Card = OrderCard
                                 ,OperatingStep = Type$FODAckDelay
                                 );
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                           'Unable to link ' + PendingAckName + 
                           ' to Job ' + VARCHAR(DelayJob[m].Value));
                        ENDLOOP;
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                  ENDFOR;
               ENDIF;
            ENDIF;      
         ENDIF;
      ENDIF;
      /**************************************************************/
      /**             Start of SSO PENDING ACK                     **/
      /**************************************************************/
      IF (CurObject.dlist[i].Type = Operator$OpOrder OR
          CurObject.dlist[i].Type = TM$TVOpOrder) AND
          CurObject.dlist[i].Status = Order$Downloaded THEN
         /* 
         ** See if any delays exist on jobs associated with this order.
         */
         DelayCheck = 0;
         SELECT :DelayCheck = COUNT(*) 
         FROM    IR_OpOrderJobs O,
                 FMS_JobDelayLink J
         WHERE   O.OrderNumber = :CurObject.dlist[i].Object AND
                 O.Job = J.Job;
         CALLPROC DDB_ROLLBACK;

         IF DelayCheck = 0 THEN
            /*
            ** Initialize Pending SSO Ack Name from database here.
            */
            SELECT :PendingAckName = Name
            FROM    Udb_Type
            WHERE   Type = :Type$SSOAckDelay;
            /*
            **  Find data associated with order.
            */
            OrderCard = 0;
            SELECT :OrderCard = C.Card,
                   :OrderCardClassName = C.CardClassName,
                   :OrderFeeder = C.Feeder,   /*OK for 3G*/
                   :OrderFeederName = C.FeederName,
                   :CheckTime = Date('now')
            FROM    IR_OperatingOrder O,
                    FMS_Card C
            WHERE   O.OrderNumber = :CurObject.dlist[i].Object AND
                    O.Card = C.Card;
            CALLPROC DDB_ROLLBACK;

            IF OrderCard <> 0 THEN
               /*
               ** Insert Pending SSO Ack Delay and link to each job associated
               ** with order.
               */
               RetCode = CALLPROC FMS_OperatingStepIns
                                 (Card = OrderCard
                                 ,CardClassName = OrderCardClassName
                                 ,Feeder = OrderFeeder
                                 ,FeederName = OrderFeederName
                                 ,OperatingStep = Type$SSOAckDelay
                                 ,OperatingStepName = PendingAckName
                                 ,StartTime = CheckTime
                                 );
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                      'Unable to apply ' + PendingAckName + 
                      ' to order ' + VARCHAR(CurObject.dlist[i].Object));
               ELSE
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Log Delay
                  */
                  CALLPROC SOA_LogIns (Card = OrderCard,
                             Job = NULL,
                             Item = 'Ack Overdue',
                             Old = 'Delay applied to feeder',
                             New = PendingAckName,
                             Time = Date('now'),
                             UserName = 'Task Monitor');
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Link to jobs.
                  */
                  DelayJob.Clear();
                  m = 1;           
                  SELECT :DelayJob[m].Value = Job 
                  FROM    IR_OpOrderJobs
                  WHERE   OrderNumber = :CurObject.dlist[i].Object
                  BEGIN
                     m = m + 1;
                  END;
                  FOR m = 1 TO DelayJob.LastRow() DO
                     RetCode = CALLPROC FMS_JobDelayLinkIns
                                 (Job = DelayJob[m].Value
                                 ,Card = OrderCard
                                 ,OperatingStep = Type$SSOAckDelay
                                 );
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                           'Unable to link ' + PendingAckName + 
                           ' to Job ' + VARCHAR(DelayJob[m].Value));
                        ENDLOOP;
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                  ENDFOR;
                  /*
                  **  Send popup to CSD.
                  */
                  RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                       ,MessageText = PendingAckName + ' delay ' +
                          'applied to Feeder: ' + OrderFeederName
                       ,MessageType = Type$SSOAckDelay
                       ,Card = OrderCard
                       ,Priority = 1  /* High Priority */ 
                       ,Time = date('now'));
                  IF RetCode <> 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': ' +
                        'Popup notification failed, no message sent for Pending ' +
                        'Acknowledgement Delay.');
                  ENDIF;
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;

      /**************************************************************/
      /**             Start of FCR PENDING ACK                     **/
      /**************************************************************/
      IF (CurObject.dlist[i].Type = Operator$FCR OR
          CurObject.dlist[i].Type = TM$TVFCRPermit) AND
          CurObject.dlist[i].Status = Permit$Downloaded THEN
         /* 
         ** See if any delays exist on jobs associated with this order.
         */
         DelayCheck = 0;
         SELECT :DelayCheck = COUNT(*) 
         FROM    FMS_JobDelayLink J
         WHERE   J.Job = :CurObject.dlist[i].Object;
         CALLPROC DDB_ROLLBACK;

         IF DelayCheck = 0 THEN
            /*
            ** Initialize Pending SSO Ack Name from database here.
            */
            SELECT :PendingAckName = Name
            FROM    Udb_Type
            WHERE   Type = :Type$FCRAckDelay;
            /*
            **  Find data associated with permit.
            */
            OrderCard = 0;
            SELECT :OrderCard = C.Card,
                   :OrderCardClassName = C.CardClassName,
                   :OrderFeeder = C.Feeder,   /*OK for 3G*/
                   :OrderFeederName = C.FeederName,
                   :CheckTime = Date('now')
            FROM    SOA_JobControl JC,
                    FMS_Card C
            WHERE   JC.Job = :CurObject.dlist[i].Object AND
                    JC.Card = C.Card;
            CALLPROC DDB_ROLLBACK;
            IF OrderCard <> 0 THEN
               /*
               ** Insert Pending FCR Ack Delay and link to WorkPermit.
               */
               RetCode = CALLPROC FMS_OperatingStepIns
                                 (Card = OrderCard
                                 ,CardClassName = OrderCardClassName
                                 ,Feeder = OrderFeeder
                                 ,FeederName = OrderFeederName
                                 ,OperatingStep = Type$FCRAckDelay
                                 ,OperatingStepName = PendingAckName
                                 ,StartTime = CheckTime
                                 );
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                         'Unable to apply ' + PendingAckName + 
                         ' to Work Permit ' + VARCHAR(CurObject.dlist[i].Object));
               ELSE
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Log Delay
                  */
                  CALLPROC SOA_LogIns (Card = OrderCard,
                              	 Job  = NULL,
                             	 Item = 'Ack Overdue',
                             	 Old  = 'Delay applied to feeder',
                             	 New  = PendingAckName,
                                 Time = Date('now'),
                                 UserName = 'Task Monitor');
                  CALLPROC DDB_COMMIT;
                  /*
                  ** Link to jobs.
                  */
                  RetCode = CALLPROC FMS_JobDelayLinkIns
                                 (Job = CurObject.dlist[i].Object
                                 ,Card = OrderCard
                                 ,OperatingStep = Type$FCRAckDelay
                                 );
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': '+ 
                        'Unable to link ' + PendingAckName + 
                        ' to Job ' + VARCHAR(CurObject.dlist[i].Object));
                  ENDIF;
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;
      /**************************************************************/
      /**             Start of TC PST Notify  email                **/
      /**************************************************************/
      IF CurObject.dlist[i].Type = Type$TCOpStepHeading AND
         CurObject.dlist[i].Status = TCStep$PSTN THEN
         /* 
         ** Find an order number for this card that has a job that is outstandingPST Notification email and resend if status is still downloaded
         ** or issued.
         */
         OrderNumber = 0;
         SELECT :OrderNumber = R.RequestID
         FROM    TC_Job J,
                 TC_WorkGroupRequest R
         WHERE   J.Card = :CurObject.dlist[i].Card AND
                 J.Jobclass = :JobClass$PSTSupport AND
                 J.Job = R.Job AND
                 R.Status IN (:Order$Opened, :Order$Downloaded);
         CALLPROC DDB_ROLLBACK;

         IF OrderNumber <> 0 THEN
            /*
            ** Resend email associated with this requestid.
            */
            ControlText = varchar(OrderNumber);
            CALLPROC InsertDBEventQueue(
                     ToApp = 'TLS',
                     EventName = 'WG_NewEmailRequest', 
                     EventText = ControlText);  

            /*
            ** Log Resend of email
            */
            CALLPROC TC_LogChange (Card = CurObject.dlist[i].Card,
                       	 Job  = NULL,
                       	 Item = 'Request Email',
                         Old  = 'Resent from Task Monitor',
                         New  = 'Order Number: ' + ControlText,
                         Time = Date('now'));
            CALLPROC DDB_COMMIT;
            /*
            **  Update alert time for object.
            */
            CurObject.clist[1].Card = CurObject.dlist[i].Card;
            CurObject.clist[1].Type = CurObject.dlist[i].Type;
            CurObject.clist[1].Status = CurObject.dlist[i].Status;
            CurObject.clist[1].StartTime = CurObject.dlist[i].StartTime;
            CurObject.clist[1].NextAlert = CurObject.dlist[i].NextAlert;
            CurObject.clist[1].Division = CurObject.dlist[i].Division;

            CurObject.SnoozeAlert();
         ENDIF;
      ELSE
         /*    
         **  Set Notified Flag, don't set if pstn because we want to keep sending these emails.
         */    
         RetCode = CALLPROC TM_Notified(Card = CurObject.dlist[i].Card
                                    ,Type = CurObject.dlist[i].Type
                                    ,StartTime = CurObject.dlist[i].StartTime);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': Not able to update notified flag in ' +
                        'TM_BogeyAlert table.');
         ENDIF;
         CALLPROC DDB_COMMIT; 
      ENDIF;
/*    
**  Build divisionlist to send out dbevents.
*/       
      FOR j = 1 TO DivisionList.LastRow() DO
         IF DivisionList[j].Value = CurObject.dlist[i].Division THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF j > DivisionList.LastRow() THEN
         DivisionList[j].Value = CurObject.dlist[i].Division;
      ENDIF;
   ENDFOR;
   
   FOR i = 1 TO DivisionList.LastRow() DO
      ControlText = VARCHAR(DivisionList[i].Value) + ';';
      CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                                 DBEventText = ControlText);
      CALLPROC DDB_COMMIT;
   ENDFOR;
/*
**  Now find next alert due before the next polling period.
*/   
   DynamicWhereClause = 'A.AlertTime < date(''now'') + ''' + VARCHAR(CurObject.PollingRate) + ' seconds'' AND ' +
                        'A.Notified <> 1'; 
   
   NextAlertTime = '';
   SELECT :NextAlertTime = IFNULL(MIN(A.AlertTime),'')
   FROM    TM_BogeyAlert A 
   WHERE  :DynamicWhereClause;
   CALLPROC DDB_ROLLBACK;
   
   IF NextAlertTime <> '' THEN
      CurObject.NextCheck = INT4(interval('seconds', NextAlertTime - DATE('NOW')));
   ELSE
      CurObject.NextCheck = CurObject.PollingRate;
   ENDIF;
   
   RETURN;
END;


METHOD SnoozeAlert (
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL;
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   AdjustTime = VARCHAR(20) NOT NULL;
   AlertTime = DATE NOT NULL;
   TimeNow  = DATE    NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update the alerttime to the snoozed value.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK; 

   IF CurObject.clist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'VALIDATION ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                               'No parameters passed to Snooze Alert method.  Please contact ' +
                               'technical support to fix problem.';
      RETURN;   
   ENDIF;

   AdjustTime = '' + varchar(CurObject.clist[1].NextAlert) + ' min' + '';
   AlertTime = TimeNow + date(AdjustTime);

/*
**  IF we are snoozing an Estimated time(s), we need to update the actual card.  This will replace
**  the row in the Task monitor list so there is no need to update AlertTime.
*/
   IF (CurObject.clist[1].Type = TM$OtherType OR
       CurObject.clist[1].Type = TM$TVOtherType) AND
      CurObject.clist[1].Status = TM$StatusEstComplete THEN
      RetCode = CALLPROC FMS_EstTimeCompleteUpd 
             (Card = CurObject.clist[1].Card,
              EstTimeComplete = AlertTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                         'Estimated Complete updated failed.  Please do manually.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;
        
      AlertTime = AlertTime + '1 hours';                

      CALLPROC FMS_EstTimeInserviceUpd 
             (Card = CurObject.clist[1].Card,
              EstTimeInservice = AlertTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                         'Estimated Inservice updated failed.  Please do manually.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT;
         
   ELSEIF (CurObject.clist[1].Type = TM$OtherType OR
           CurObject.clist[1].Type = TM$TVOtherType) AND
          CurObject.clist[1].Status = TM$StatusEstInservice THEN
      CALLPROC FMS_EstTimeInserviceUpd 
             (Card = CurObject.clist[1].Card,
              EstTimeInservice = AlertTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                         'Estimated Inservice updated failed.  Please do manually.';
         RETURN;
      ENDIF;         
      CALLPROC DDB_COMMIT; 
   ELSE

      RetCode = CALLPROC TM_NextAlertUpd(Card = CurObject.clist[1].Card,
                                      Type = CurObject.clist[1].Type,
                                      StartTime = CurObject.clist[1].StartTime,
                                      AlertTime = AlertTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR:: Application::Task Monitor, Class::TM_Alert_ASE - ' +
                                  'Not able to update next alert time in TM_BogeyAlert table.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;  
/*
**  Raise DBEvent now so clients can update.  No need to raise dbevent in above if statement since 
**  procedure FRA_CardStatusUpd gets called via rules from updating the EstInservice time.  This
**  procedure raises the TM_BogeyAlertCheck DBEvent and is called in several cases of card updates.
**  The Task Monitor will pick this up and then send out a DBEvent TM_BogeyAlertUpd once the update
**  is made.  This avoid possible timing issued.
*/
      ControlText = VARCHAR(CurObject.clist[1].Division) + ';';
      CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                                 DBEventText = ControlText);
      CALLPROC DDB_COMMIT;
          
   ENDIF;
   
   RETURN;
END;

METHOD UpdateAlertTable (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   m = INTEGER NOT NULL;
   ControlText = VARCHAR(40) NOT NULL;
   RetCode = INTEGER NOT NULL;
   UpdatedDiv = ARRAY OF INTEGEROBJECT;
   BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
   BogeyTime = INTEGER NOT NULL WITH DEFAULT;
   AlertTime = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to check current data with data in TM_BogeyAlert 
** and update table to be current.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   UpdatedDiv.Clear();
/**************************************************************/
/**             Start of Operating Orders                    **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with Operating Order data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :Operator$OpOrder
   ORDER BY Card, Object
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.clist[i].Card = O.Card,
          CurObject.clist[i].Type = :Operator$OpOrder,
          CurObject.clist[i].Description = OO.Description,
          CurObject.clist[i].Division = OO.PrimaryGrouping,
          CurObject.clist[i].Feeder = C.Feeder,
          CurObject.clist[i].FeederName = C.FeederName,
          CurObject.clist[i].CardClass = C.CardClass,
          CurObject.clist[i].CardClassName = C.CardClassName,
          CurObject.clist[i].Object = O.OrderNumber,
          CurObject.clist[i].Status = O.OrderStatus,
          CurObject.clist[i].IssueTime = O.IssueTime,
          CurObject.clist[i].AcknowledgeTime = O.AckRejectTime,
          CurObject.clist[i].DownloadTime = O.DownloadTime,
          CurObject.clist[i].ReturnTime = O.ReturnTime         
   FROM   FMS_Card C,
          IR_OperatingOrder O,
          Udb_Object OO
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey <= 0 AND /* -1 means no fault info entered by cutin */
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = O.Card AND
          O.OrderStatus < :Order$Rescinded AND
          O.Substation = OO.Object 
   ORDER BY Card, Object
   BEGIN
      IF CurObject.clist[i].Status = Order$Acknowledged THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].AcknowledgeTime;
      ELSEIF CurObject.clist[i].Status = Order$Closed THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].ReturnTime;
      ELSEIF CurObject.clist[i].Status = Order$Downloaded THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].DownloadTime;
      ELSEIF CurObject.clist[i].Status = Order$Opened THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].IssueTime;
      ENDIF;


      CurObject.clist[i].Description = 'Operating Order: ' + 
                    VARCHAR(Curobject.clist[i].Object) + HC_NEWLINE +
                    'Substation: ' + CurObject.clist[i].Description;
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime  AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

#  include TM_AlertTableUpdates

/**************************************************************/
/**             Start of TV Operating Orders                 **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with TV Operating Order data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :TM$TVOpOrder
   ORDER BY Card, Object
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.clist[i].Card = O.Card,
          CurObject.clist[i].Type = :TM$TVOpOrder,
          CurObject.clist[i].Description = OO.Description,
          CurObject.clist[i].Division = OO.PrimaryGrouping,
          CurObject.clist[i].Feeder = C.Feeder,
          CurObject.clist[i].FeederName = C.FeederName,
          CurObject.clist[i].CardClass = C.CardClass,
          CurObject.clist[i].CardClassName = C.CardClassName,
          CurObject.clist[i].Object = O.OrderNumber,
          CurObject.clist[i].Status = O.OrderStatus,
          CurObject.clist[i].IssueTime = O.IssueTime,
          CurObject.clist[i].AcknowledgeTime = O.AckRejectTime,
          CurObject.clist[i].DownloadTime = O.DownloadTime,
          CurObject.clist[i].ReturnTime = O.ReturnTime         
   FROM   FMS_Card C,
          IR_OperatingOrder O,
          Udb_Object OO
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey > 0 AND 
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = O.Card AND
          O.OrderStatus < :Order$Rescinded AND
          O.Substation = OO.Object 
   ORDER BY Card, Object
   BEGIN
      IF CurObject.clist[i].Status = Order$Acknowledged THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].AcknowledgeTime;
      ELSEIF CurObject.clist[i].Status = Order$Closed THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].ReturnTime;
      ELSEIF CurObject.clist[i].Status = Order$Downloaded THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].DownloadTime;
      ELSEIF CurObject.clist[i].Status = Order$Opened THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].IssueTime;
      ENDIF;


      CurObject.clist[i].Description = 'Operating Order: ' + 
                    VARCHAR(Curobject.clist[i].Object) + HC_NEWLINE +
                    'Substation: ' + CurObject.clist[i].Description;
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime  AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

#  include TM_AlertTableUpdates

/**************************************************************/
/**             Start of FOD Operating Orders                **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with FOD Operating Order data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :TM$FODOrder
   ORDER BY Card, Object
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
          CurObject.clist[i].Card = O.Card,
          CurObject.clist[i].Type = :TM$FODOrder,
          CurObject.clist[i].Description = O.OrderComment,
          CurObject.clist[i].Division = OO.PrimaryGrouping,
          CurObject.clist[i].Feeder = C.Feeder,
          CurObject.clist[i].FeederName = C.FeederName,
          CurObject.clist[i].CardClass = C.CardClass,
          CurObject.clist[i].CardClassName = C.CardClassName,
          CurObject.clist[i].Object = OJ.Job,
          CurObject.clist[i].Status = OJ.JobStatus,
          CurObject.clist[i].IssueTime = O.IssueTime,
          CurObject.clist[i].AcknowledgeTime = OJ.AckRejectTime,
          CurObject.clist[i].DownloadTime = O.DownloadTime,
          CurObject.clist[i].TORS = OJ.TORS        
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          IR_FODOrder O,
          IR_FODOrderJobs OJ,
          Udb_Object O2,
          Udb_Object OO,
          Udb_ExtendedType ET
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey <= 0 AND /* -1 means no fault info entered by cutin */
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = O.Card AND
          O.OrderNumber = OJ.OrderNumber AND
          OJ.JobStatus IN (:Order$Acknowledged,:Order$Opened,:Order$Downloaded,:Order$Closed) AND
          C.Card = CTO.Card AND
          CTO.Object = O2.Object AND
          O2.PrimaryGrouping = OO.Object AND
          OO.Type = ET.Type AND
          ET.SuperType = :Type$Substation
   UNION  /* Get 3G feeders which have primary Grouping = Division instead of Substation */
   SELECT O.Card,
          :TM$FODOrder,
          O.OrderComment,
          OO.Object,
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          OJ.Job,
          OJ.JobStatus,
          O.IssueTime,
          OJ.AckRejectTime,
          O.DownloadTime,
          OJ.TORS             
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          IR_FODOrder O,
          IR_FODOrderJobs OJ,
          Udb_Object O2,
          Udb_Object OO
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey <= 0 AND /* -1 means no fault info entered by cutin */
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Card = O.Card AND
          O.OrderNumber = OJ.OrderNumber AND
          OJ.JobStatus IN (:Order$Acknowledged,:Order$Opened,:Order$Downloaded,:Order$Closed) AND
          C.Card = CTO.Card AND
          CTO.Object = O2.Object AND
          O2.PrimaryGrouping = OO.Object AND
          OO.Type = :Type$Division
   ORDER BY Card, Object
   BEGIN
      IF CurObject.clist[i].Status = Order$Acknowledged THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].AcknowledgeTime;
      ELSEIF CurObject.clist[i].Status = Order$Downloaded THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].DownloadTime;
      ELSEIF CurObject.clist[i].Status = Order$Opened THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].IssueTime;
      ELSEIF CurObject.clist[i].Status = Order$Closed THEN
         IF CurObject.clist[i].TORS = Job$TakeOutInt THEN
            REPEATED 
            SELECT :CurObject.clist[i].StartTime = IFNULL(TOComplete,'')
            FROM    SOA_Job
            WHERE   Job = :CurObject.clist[i].Object;
         ELSE
            REPEATED 
            SELECT :CurObject.clist[i].StartTime = IFNULL(RSComplete,'')
            FROM    SOA_Job
            WHERE   Job = :CurObject.clist[i].Object;      
         ENDIF;
      ENDIF;
      CurObject.clist[i].Description = 'FOD Operating Order: ' + 
                    VARCHAR(Curobject.clist[i].Object) + HC_NEWLINE +
                    CurObject.clist[i].Description;
      /*
      **  When takeout and restore orders are issued for the same job
      **  we have a problem when they are acknowledged etc because our
      **  primary key on the table is: card, type, status, starttime
      **  and job.  To solve this problem without making table modifications,
      **  we will ajust the starttime by 1 second if TORS = 1.
      */
      IF CurObject.clist[i].TORS = Job$RestoreInt THEN
         CurObject.clist[i].StartTime = CurObject.clist[i].StartTime + '1 second';
      ENDIF;
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].Type = CurObject.clist[j].Type AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime AND
            CurObject.dlist[i].Status = CurObject.clist[j].Status AND
            CurObject.dlist[i].Object = CurObject.clist[j].Object THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

