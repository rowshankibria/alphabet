	Name:            PromptPQNodeCheck

/*
**
**	Copyright c 2007 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptPQNodeCheck
**
**  06/26/07  em    Created
**  09/10/09  ysp   add sending InRush Email
**  10/19/09  em    Always send email, do not filter just for InRush Current
**  11/16/10  em    Added 3G Support
**  08/25/16  ysp   Add 33kv support
**  05/09/23  em    Replaced double quotes with singles due to compile errors.
*/

INITIALIZE
(
    JIP = JobInProgress;		/* Job being processed */
    NoReturn = INTEGER NOT NULL WITH DEFAULT; /*Optional Parm*/
   
    CardClass = INTEGER NOT NULL WITH DEFAULT;
    NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
    FODReturned = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;    /* Return Code */
) =
DECLARE
   UpdateJobResponse = PROCEDURE;
   SendInrushEmail = PROCEDURE;
   GetRelatedSegments = PROCEDURE RETURNING ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   SELECT :CardClass = CardClass,
          :NetworkFeeder = NetworkFeeder
   FROM   FMS_Card
   WHERE  Card = :JIP.Card;
/*
** If NoReturn is set to TRUE, this is not called as part of FOD order return
** but as part of the HiPot Check.  In this case, DO must enter the PQNode
** check result.
*/
   IF NoReturn = TRUE THEN
      FIELD(RC).CurBias = FB_INVISIBLE;
   ELSE
      SELECT :RC.ReturnComment = ReturnRemark
      FROM   IR_FODOrderJobs
      WHERE  Job = :JIP.Job AND
             OrderNumber = (SELECT MAX(OrderNumber) 
                            FROM   IR_FODOrderJobs
                            WHERE  Job = :JIP.Job);

      IF RC.ReturnComment = '' THEN

         IF AutomaticExecution = FALSE THEN
            MESSAGE 'There was no Return Comment entered by the FOD. ' + HC_NEWLINE +
                   'Please contact FOD verbally to determine PQNode Check result.';
         ENDIF;
         PQNode = 3;
         FIELD(Other).CurBias = FB_CHANGEABLE;
         Other.OtherResult = 'Unknown';

      ELSE
         IF UPPERCASE(RC.ReturnComment) LIKE '%INRUSH%' THEN
            PQNode = 1;
            FIELD(Other).CurBias = FB_DIMMED;
         ELSEIF 
            UPPERCASE(RC.ReturnComment) LIKE '%FAULT%' THEN
            PQNode = 2;
            FIELD(Other).CurBias = FB_DIMMED;
         ELSE
            PQNode = 3;
            FIELD(Other).CurBias = FB_CHANGEABLE;
            Other.OtherResult = 'Other';
         ENDIF;
      ENDIF;
   ENDIF;
/*
** if automation, return immediately
*/
   IF AutomaticExecution = TRUE THEN
      CALLPROC UpdateJobResponse();
      CALLPROC SendInrushEmail();
      RETURN(PU_OK);
   ENDIF;
END;


ON SETVALUE PQNode =
BEGIN
   IF PQNode = 1 OR PQNode = 2 THEN
      FIELD(Other).CurBias = FB_DIMMED;
   ELSE
      FIELD(Other).CurBias = FB_CHANGEABLE;
   ENDIF;
END;

      
ON Click OKButton =
BEGIN
   IF PQNode = 3 THEN
      IF Other.OtherResult = '' THEN
         MESSAGE 'Please enter Other Result to save on the move Response.';
         RESUME;
      ENDIF;

      IF UPPERCASE(Other.OtherResult) LIKE '%INRUSH%' THEN
         IF CurFrame.ConfirmPopup (MessageText = 'Should the result be marked InRush Current?') = PU_OK THEN
            PQNode = 1;
            FIELD(Other).CurBias = FB_INVISIBLE;
            RESUME;
         ENDIF;
      ENDIF;
   ENDIF;

   CALLPROC UpdateJobResponse();
   CALLPROC SendInrushEmail();

   RETURN (PU_OK);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE SendInrushEmail(
)
 =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN
   IF NoReturn <> TRUE THEN /* AND PQNode = 1 THEN */
      IF CardClass = Type$CIOA THEN
         EventText = VARCHAR(JIP.Card) + ';' + VARCHAR(JIP.Job) + ';'; 
         CALLPROC InsertDBEventQueue(EventName = 'IR_InRushEmail',
                                     EventText = EventText,
                                     ToApp = 'FOD');
      ENDIF;
   ENDIF; 
END;

PROCEDURE UpdateJobResponse(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   SegmentList = ARRAY OF INTEGEROBJECT;
   TmpJob  = Job;                          /* Used for Job Response Update */
ENDDECLARE 
BEGIN
   IF PQNode = 1 THEN
      JIP.Response = 'InRush Current';
      
      IF NetworkFeeder = NetworkFeeder$33KV THEN
         /*
         ** When setting InRush feeder object status, include other feeder segments
         ** fed by this feeder and exclude feeder segments fed by another.
         */
         SegmentList = CALLPROC GetRelatedSegments(Card = JIP.Card);
      ELSE
         i = 1;
         SELECT  :SegmentList[i].Value = Object
         FROM    TFMS_CardToObject
         WHERE   Card = :JIP.Card AND
                 Type = :Type$Feeder
         BEGIN
            i = i + 1;
         END;
      ENDIF;
      
      FOR i = 1 TO SegmentList.LastRow DO
        CALLPROC SetStatus (Object = SegmentList[i].Value, Status = Status$InRush);
        CALLPROC DDB_COMMIT;
      ENDFOR;
   
   ELSEIF PQNode = 2 THEN
      JIP.Response = 'Fault Current';
   ELSE
      JIP.Response = Other.OtherResult;
   ENDIF;

   TmpJob.Job = JIP.Job;
   TmpJob.Response = JIP.Response;
   TmpJob.ResponseUpd();

   CALLPROC SOA_LogIns (
                 Card = JIP.Card,
                 Job  = JIP.Job,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'PQNode Check Result',
                 Old  = '',
                 New  = JIP.Response);
   CALLPROC DDB_COMMIT;
END;

PROCEDURE GetRelatedSegments(
   Card = INTEGER NOT NULL
)=
DECLARE
   k = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   SegmentList = ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   SegmentList.Clear();
   k = 1;
   SELECT :SegmentList[k].Value = CTO.Object
   FROM   TFMS_CardToObject CTO
   WHERE  CTO.Card = :JIP.Card 
   BEGIN
      FedBy = 0;   // need to declare this variable
      SELECT :FedBy = Grouping
      FROM   Udb_Grouping
      WHERE  Member = :SegmentList[k].Value AND
             Relationship = :Interaction$FedBy;
      IF FedBy > 0 THEN
         SegmentList.RemoveRow (rownumber = k);
      ELSE
         k = k + 1;
         REPEATED 
         SELECT DISTINCT
                :SegmentList[k].Value = G.Member
         FROM   Udb_Grouping G
         WHERE  G.Grouping = :SegmentList[k-1].Value AND
                G.Relationship = :Interaction$FedBy
         BEGIN
            k = k + 1;
         END;
      ENDIF;          
   END;
   RETURN SegmentList;
END;
				 *Default Item


