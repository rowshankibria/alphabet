	Name:            OperatorChecks

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
*/
/*
**  Application:    SOA
**  Frame:          OperatorChecks 
**
**  Modifications:
**  10/10/98   pkw   modified FMS version 
**  01/27/06   em    Reduce Warning to a ConfirmPopUp
**  10/31/18   ysp   Change passed-in parameter to JIP and add skill for Arthur Kill stations
*/
PROCEDURE OperatorChecks (
   JIP = JobInProgress;                /* Parameter */
   IssuedOperator = INTEGER NOT NULL;  /* Parameter */
) =
DECLARE
   JobCount = INTEGER NOT NULL WITH DEFAULT;                /* requirements by job */
   IsAKMove = INTEGER NOT NULL WITH DEFAULT;
   AKSkill = INTEGER NOT NULL WITH DEFAULT;                 /* skill for AK */
   JobSkill = INTEGER NOT NULL WITH DEFAULT;                 /* skill for the job */
   RetCode = INTEGER;                                       /* ReturnCode*/ 
ENDDECLARE
BEGIN
   IsAKMove = 0;
   JobSkill = 0;
   AKSkill = 0;
/*
**  check to see if operator pocesses the required skills to perform the move based on the job. 
*/  
   JobCount = 0;
   
   REPEATED
   SELECT :JobCount = Count(*)
   FROM    FMS_JobToSkill
   WHERE   Jobclass = :JIP.Jobclass;
   
   IF JobCount > 0 THEN
      REPEATED
      SELECT :JobSkill = Count(*)
      FROM FMS_JobToSkill J
      WHERE J.Jobclass = :JIP.Jobclass AND
            J.skill IN (SELECT E.type
                        FROM UDB_Extendedtype E
                        WHERE E.supertype IN (SELECT Skill 
                                              FROM FMS_PersonToSkill 
                                              WHERE Operator = :IssuedOperator 
                                             )
                        ); 
   ELSE
      JobSkill = 1;
   ENDIF;
   
/*
** Check to see if the operator has the skill to operate at Arthur Kill stations
*/
   IF CurrentApplication = Application$TFMS AND 
      JIP.StepPair <> StepHeading$TestPermit AND
      JIP.StepPair <> StepHeading$WorkPermit THEN
      
      IF JIP.Substation = 144060 THEN     // AK2
         IsAKMove = 1;
         
         SELECT :AKSkill = 1 
         FROM FMS_PersonToSkill 
         WHERE Operator = :IssuedOperator AND
               Skill = :Skill$AK2;         
               
      ELSEIF JIP.Substation = 144231 THEN      // AK3
         IsAKMove = 1;
         
         SELECT :AKSkill = 1 
         FROM FMS_PersonToSkill 
         WHERE Operator = :IssuedOperator AND
               Skill = :Skill$AK3;
      ELSE
         AKSkill = 1;
      ENDIF;
   ELSE
      AKSkill = 1;
   ENDIF;     
   CALLPROC DDB_ROLLBACK;

   IF JobSkill = 0 OR AKSkill = 0 THEN
      IF CurProcedure.ConfirmPopUp (MessageText =
                    'The Operator is not qualified for this move.' + HC_NEWLINE +
                    'Do you wish to continue?') = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         CALLPROC SOA_LogIns (
              Card = JIP.Card,
              SwitchingItem = JIP.SwitchingItem,
              Job = JIP.Job,
              Time = DATE('now'),
              UserName = UserName,
              Item = 'WARNING',
              Old = 'Operator not qualified',
              New = 'Was overridden');
         CALLPROC DDB_COMMIT;
      ENDIF;   
   ENDIF;
   
   IF IsAKMove = 1 THEN
      /*
      ** Assign HoldOff number (TFMS card number) to the response column
      */
      IF JIP.Status = Job$TakeOut THEN
         IF JIP.Response <> '' THEN
            JIP.Response = JIP.Response + '. ';
         ENDIF;
         JIP.Response = JIP.Response + VARCHAR(JIP.Card;)
      ENDIF;         
   ENDIF;

   RETURN(PU_OK);
END;

