**  02/29/16    pkw      Update for 33kv feeders
**  08/10/16    ysp      Add GetGeneralCardName method
**  10/07/16    pkw      Insert row into fms_checklist table for SCHD or WR cards
**  02/07/20    em       Add ValidDiagram attribute 
*/
METHOD InsertCard(
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   LastRow   = INTEGER NOT NULL WITH DEFAULT;
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Create the Card
*/
   CurObject.Card = CALLPROC Udb_NextKey(KeyName = 'Card');
   IF CurObject.Card <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Could not generate a cardkey, try again.';
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

   CurObject.Status = Card$Open;  
   CurObject.Opened = DATE('now');
   RetCode = CALLPROC FMS_CardInsert(
                        Feeder         = CurObject.Feeder
                       ,CardClass      = CurObject.CardClass
                       ,Card           = CurObject.Card
                       ,CardStatus     = CurObject.Status
                       ,Opened         = CurObject.Opened
                       ,SourcePosition = Interaction$SourceBreaker
                       ,ISOFeeder      = Type$ISOFeeder
                       ,ISOCard        = Type$ISOCard
                       ,PortionFeeder  = Type$PortionFeeder
                       ,PortionCard    = Type$PortionCard
                       ,RatedAs        = Interaction$RatedAs
                       ,RatingFamily   = Type$RatingFamily
                       ,Card4kV        = Type$4kVCard
                       ,Card13kV       = Type$13kVCard
                       ,CardATSLoad    = TypeOfCard$ATSLoad
                       ,NetworkFeeder  = CurObject.NetworkFeeder
                       ,FeederName3G   = CurObject.FeederName
                       ,SubstationName3G = CurObject.SubstationName
                       ,Position3G     = CurObject.Position
                       );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;

      IF CurObject.NetworkFeeder <> NetWorkFeeder$3G THEN

         i = 0;
         SELECT :i = count(*)
         FROM   Udb_Object O
               ,Udb_Grouping G1
               ,Udb_Object G2  
         WHERE  O.Object = :CurObject.Feeder AND
                O.Object = G1.Grouping AND
                G1.Relationship = :Interaction$SourceBreaker AND     
                G1.Member = G2.Object AND 
                G2.PrimaryGrouping = O.PrimaryGrouping;
          
         IF i = 0 THEN
            MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                    'Could not create new card.  No equipment is defined as ' +
                    'the Source Breaker for this feeder or the Source Breaker ' +
                    'does not have a substation defined as the primary grouping.' +
                    '  Make corrections in the database and try again.';
         ELSEIF i > 1 THEN
            MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                    'Could not create new card. Multiple equipment defined as ' +
                    'the Source Breaker for this feeder.  Make corrections ' +
                    'in the database and try again.';
         ELSE
            MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                    'Could not insert new card due to errors,  try again.';
         ENDIF;
      ENDIF;   /*Above message only if not a 3G NetworkFeeder */

      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
/*
** Insert feeders into card to object table
*/
   FOR i = 1 TO CurObject.Object.LastRow() DO
       RetCode = CALLPROC TFMS_InsertCardToObject(
                         CardKey = CurObject.Card
                        ,CardObject = CurObject.Object[i].Object
                        ,CardObjectName = CurObject.Object[i].Name
                        ,ENDEEN = 0
                        ,ObjectType = CurObject.Object[i].Type
                        ,Status = 1
                        ,Seq = 0
                        ,ValidatedBy = CurObject.Object[i].TypeName);
      IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                  'Unable to insert network feeder list into card to object table. ';
          CurObject.Card = 0;
          RETURN CurObject;
      ENDIF;
   ENDFOR;
/*
** Insert row into fms_checklist table if SCHD or WR card type
*/
   IF CurObject.CardClass = Type$SCHD or 
      CurObject.CardClass = Type$WR THEN
      RetCode = CALLPROC FMS_ChecklistInsert(
                            Card = CurObject.Card);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
          MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                  'Unable to insert CheckList items for card into fms_checklist table. ';
          CurObject.Card = 0;
          RETURN CurObject;
      ENDIF;      
   ENDIF;

/*
** Select the fields that were determined in the card insert db proc.
*/
   CurObject.Application = Application$FMS;
   SELECT :CurObject.TypeOfCard = TypeOfCard, 
          :CurObject.Validated = Validated
   FROM   FMS_Card 
   WHERE  Card = :CurObject.Card;

   CurMethod.SendSuperClass();

   ArchiveCard = FALSE;
   RETURN CurObject;
END;


METHOD InsertAltCard(
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   LastRow   = INTEGER NOT NULL WITH DEFAULT;
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Create the Card
*/
   CurObject.Card = CALLPROC Udb_NextKey(KeyName = 'Card');
   IF CurObject.Card <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Could not generate a cardkey, try again.';
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

   CurObject.Opened = DATE('now');
   RetCode = CALLPROC FMS_AltCardIns(
                        AltFeeder      = CurObject.Feeder
                       ,AltFeederName  = CurObject.FeederName
                       ,SubstationName = CurObject.SubstationName
                       ,CardClass      = CurObject.CardClass
                       ,Card           = CurObject.Card
                       ,Status         = CurObject.Status
                       ,TypeOfCard     = CurObject.TypeOfCard
                       ,Opened         = IFNULL(CurObject.Opened,'')
                       ,Position       = CurObject.Position
                       ,Loop1          = CurObject.Loop1
                       ,Loop2          = CurObject.Loop2
                       ,Loop3          = CurObject.Loop3
                       ,Loop4          = CurObject.Loop4
                       ,Assoc          = CurObject.Assoc
                       ,Validated      = CurObject.Validated
                       );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Class:FMS_Card; Method:InsertAltCard; ' + HC_NEWLINE +
                 'Could not insert new card due to errors,  try again.';
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;

       RetCode = CALLPROC TFMS_InsertCardToObject(
                         CardKey = CurObject.Card
                        ,CardObject = CurObject.Feeder
                        ,CardObjectName = CurObject.FeederName
                        ,ENDEEN = 0
                        ,ObjectType = Type$Feeder
                        ,Status = 1
                        ,Seq = 0);
      IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Class:FMS_Card; Method:InsertAltCard; ' + HC_NEWLINE +
                  'Unable to insert feeder into card to object table. ';
          CurObject.Card = 0;
          RETURN CurObject;
      ENDIF;

/*
** Insert row into fms_checklist table if SCHD or WR card type
*/
   IF CurObject.CardClass = Type$SCHD or 
      CurObject.CardClass = Type$WR THEN
      RetCode = CALLPROC FMS_ChecklistInsert(
                            Card = CurObject.Card);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
          MESSAGE 'Class:FMS_Card; Method:InsertCard; ' + HC_NEWLINE +
                  'Unable to insert CheckList items for card into fms_checklist table. ';
          CurObject.Card = 0;
          RETURN CurObject;
      ENDIF;      
   ENDIF;

   RetCode = CALLPROC SOA_CardIns(Card = CurObject.Card
                                 ,Application = CurObject.Application
                                 ,CardClass = CurObject.CardClass
                                 ,Opened = IFNULL(CurObject.Opened,'')
                                 ,Status = CurObject.Status
                                 ,TypeOfCard = CurObject.TypeOfCard
                                 ,Validated = CurObject.Validated
                                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Could not insert new Card.  Please ' +
              'try again.';
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_LogIns (
          Card            = CurObject.Card
        , Job             = NULL
        , SwitchingItem   = 0
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'New Card'
        , New             = 'Card Created'
        );

   IF RetCode <> 0 THEN
/*
** Not a fatal error
*/
         CALLPROC DDB_ROLLBACK;
   ELSE
         CALLPROC DDB_COMMIT;
   ENDIF;  

   ArchiveCard = FALSE;
   RETURN CurObject;
END;

METHOD GetGeneralCardName(
)=
DECLARE
   GeneralCardName = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CurObject.NetworkFeeder = NetworkFeeder$33KV AND CurObject.TypeOfCard = TypeOfCard$Portion THEN
      SELECT :GeneralCardName = C.FeederName
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :CurObject.Card AND
             L.Card = C.Card;
      CALLPROC DDB_ROLLBACK;
      
      GeneralCardName = GeneralCardName + ' ' + SQUEEZE(CurObject.FeederName); 
   ELSE
      GeneralCardName = CurObject.FeederName;
   ENDIF;
   
   RETURN GeneralCardName;
END;

