	Name:            ReturnPoolObject

/*
**
**	Copyright c 2007 Pateric SOftware LLC  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ReturnPoolObject
**
**  Modifications:
**  08/17/07 em	    Created 
*/
PROCEDURE ReturnPoolObject
(
   Card	= INTEGER NOT NULL WITH DEFAULT;
   Object = INTEGER NOT NULL WITH DEFAULT;
   ObjectType = INTEGER NOT NULL WITH DEFAULT;
) =
declare
   RetCode = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
/*
** Return objects to pool by card or by individual object.
*/
   IF Card <> 0 THEN 
/*
** Look for mains or valves on card with object id < 20000.
*/
      Object = 0;
      SELECT :Object = Main
      FROM   SDS_CardMain 
      WHERE  Card = :Card AND
             Main < 20000
      BEGIN
         IF Object > 0 THEN
            RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = Object,
                         Type = Type$Main,
                         TypeName = 'Main',
                         PrimaryGrouping = Unused$EquipTypePool,                              
                         PrimaryGroupingName = '',
                         Name = VARCHAR(Object),
                         Description = 'In Pool',
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM'); 
   
            IF RetCode < 0 THEN    
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
             'ERROR1: Unable to return generic pool object to the Non-Sole Auth Main Pool.', 
                           TraceMessage =
             'Procedure:ReturnPoolObject: 1- ' +
             'Unable to return generic pool object to the Non-Sole Auth Main Pool.'
             );
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;  
         ENDIF;    
      END;

      Object = 0;
      SELECT :Object = J.Equip
      FROM   SOA_Job J, 
             SOA_JobControl JC 
      WHERE  JC.Card = :Card AND
             JC.Job = J.Job AND
             J.Equip < 20000
      BEGIN
         IF Object > 0 THEN
            RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = Object,
                         Type = Type$Valve,
                         TypeName = 'Valve',
                         PrimaryGrouping = Unused$EquipTypePool,                              
                         PrimaryGroupingName = '',
                         Name = VARCHAR(Object),
                         Description = 'In Pool',
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM'); 
   
            IF RetCode < 0 THEN    
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
             'ERROR2: Unable to return generic pool object to the Non-Sole Auth Main Pool.', 
                           TraceMessage =
             'Procedure:ReturnPoolObject: 2- ' +
             'Unable to return generic pool object to the Non-Sole Auth Main Pool.'
             );
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;  
         ENDIF;    
      END;
        
   ELSEIF Object <> 0 THEN

            RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = Object,
                         Type = ObjectType,
                         TypeName = '',
                         PrimaryGrouping = Unused$EquipTypePool,                              
                         PrimaryGroupingName = '',
                         Name = VARCHAR(Object),
                         Description = 'In Pool',
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM'); 
   
            IF RetCode < 0 THEN    
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
             'ERROR3: Unable to return generic pool object to the Non-Sole Auth Main Pool.', 
                           TraceMessage =
             'Procedure:ReturnPoolObject: 3- ' +
             'Unable to return generic pool object to the Non-Sole Auth Main Pool.'
             );
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;                   
   ENDIF;
END;

