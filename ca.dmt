	Name:            DeterminePhaseBreak

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  THIS PROCEDURE EXISTS IN DUPLICATE IN APPLICATIONS:
**    1) CAC
**    2) IR_SendAppServer
**
**  IF IT IS UPDATED IN ONE IT MUST BE MANUALLY COPIED TO THE OTHER.
**
**  Date   Initials    
** --------------------------------------------------------
**
**  07/11/06  em   Created
**  07/13/06  em   Removed type of card restriction...move actions should be
**                 for all card types.
**  07/31/06  em   Clear PhaseBreak variable before each select
*/
PROCEDURE DeterminePhaseBreak (
   JobClass	= INTEGER NOT NULL,
   EquipClass	= INTEGER NOT NULL,
   StepPair	= INTEGER NOT NULL,
   TORS		= INTEGER NOT NULL
) =
declare
   PhaseBreak  	= INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
/*
** Is this move set up to return phases?
*/
   PhaseBreak = 0;
   SELECT :PhaseBreak = JobClass
   FROM    FMS_JobAction JA
   WHERE   JobClass   = :JobClass AND
           :EquipClass IN (SELECT Type FROM Udb_ExtendedType
                           WHERE  SuperType = JA.EquipClass) AND
           StepPair   = :StepPair AND
           TORS       = :TORS AND
           IssueCompl = 1 AND            /*At Move Completion Time*/
           Status     = :Prompt$ReturnPhases;

   IF PhaseBreak = 0 THEN
      RETURN 0;
   ENDIF;

   PhaseBreak = 0;
   SELECT :PhaseBreak = EquipClass
   FROM    SOA_ReturnPhaseTypes
   WHERE   EquipClass = :EquipClass;

   IF PhaseBreak = 0 THEN
      RETURN 0;
   ENDIF;

   PhaseBreak = 0;
   SELECT :PhaseBreak = JobClass
   FROM    FMS_JobAction JA
   WHERE   JobClass = :JobClass AND
           :EquipClass IN (SELECT Type FROM Udb_ExtendedType
                           WHERE  SuperType = JA.EquipClass) AND
           StepPair = :StepPair AND
           TORS = :TORS AND
           IssueCompl = 1 AND            /*At Move Completion Time*/
           Status IN (:Status$VisibleBreak, 
                      :Prompt$SetCurrentlyOpen,
                      :Prompt$ClearCurrentlyOpen);

   IF PhaseBreak = 0 THEN
      RETURN 0;
   ENDIF;
/*
** If we haven't returned yet, all conditions are true and this is a Phase Break move.
*/
   RETURN 1;
END;

Application Component Report
============================

	Name:            DFAttachment


Component Method Scripts
--------------------------
/*
**
**      Copyright c 2021 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          DFAttachment 
**
**  Date:       Version Description
** ----------------------------------
**  12/27/21    em      copied from ISPAttachment
*/

METHOD InsertAttachment (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SaveDate = DATE NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    CurObject.ReturnCode = 0;
    CurObject.ErrorMessage = '';
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    SaveDate = DATE('NOW');
    UpdateSql = ' UPDATE FMS_DisseminationFile SET DataStream ' + 
                ' WHERE  FileID = ' + VARCHAR(CurObject.FileID);

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;

    IF DBSession1Status = -1 AND DBSession2Status = -1 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'DFAttachment.InsertAttachment; Error saving file binary in database.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : DFAttachment.InsertAttachment; Error saving file binary in database.');
       RetCode = CALLPROC FMS_DisseminationFileDel(
                              FileID = CurObject.FileID);
       CALLPROC DDB_COMMIT;
       RETURN;
    ELSEIF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       CurObject.DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       CurObject.DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       CurObject.DBServer = 2;

    ELSE
       CurObject.DBServer = -1;
    ENDIF;

    RETURN;
END;

METHOD GetBinaryStream (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SelectSql  = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.DBServer = DBServer,
          :CurObject.FileName = FileName
   FROM   FMS_DisseminationFile 
   WHERE  FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;
/*
** Read binary data from the database
*/
   SelectSql = 'SELECT DataStream FROM FMS_DisseminationFile WHERE ' + 
               'FileID = ' + VARCHAR(CurObject.FileID);

   IF CurObject.DBServer = 0 THEN
      CurMethod.DBSession = DDB_Global.Session.Cur;
 
   ELSEIF CurObject.DBServer = 1 AND DDB_Global.Session.One.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.One;

   ELSEIF CurObject.DBServer = 2 AND DDB_Global.Session.Two.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.Two;

   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'DFAttachment.GetBinaryStream; Attachment data not found in the connected database';
      RETURN;
   ENDIF;

   If CurObject.BinaryStream.FetchFromDB(Query = SelectSql) <> ER_OK THEN
      CurMethod.Trace(Text= varchar(date('now')) + ': failed to read binary from db for DF file ' + CurObject.FileName);
   ENDIF;
   ROLLBACK;
END;

Application Component Report
============================

	Name:            DIS_RelaySummary

/*
