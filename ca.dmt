PROCEDURE LogBreakerUpdate(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   EquipStatus = INTEGER NOT NULL WITH DEFAULT;
   IssueCompl = INTEGER NOT NULL WITH DEFAULT;
   PromptValue = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT; 
   TORS = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   IF NoAudit = TRUE THEN
      RETURN;
   ENDIF;
/*
** if the equipment type is what the SSL is logging
*/
   i = 0;
   SELECT :i = 1
   FROM   FMS_SSLEquipType 
   WHERE  Type = :Move.EquipClass;
   CALLPROC DDB_ROLLBACK;

   IF i = 0 THEN
      RETURN;
   ENDIF;

/*
** if this move sets/clears Currently Open
*/
   IF MessageText = 'TO Complete' THEN
      IssueCompl = JobClass$Complete;
      TORS = Job$TakeoutInt;
   ELSEIF MessageText = 'RS Complete' THEN
      IssueCompl = JobClass$Complete;
      TORS = Job$RestoreInt;
   ELSE
      RETURN;
   ENDIF;
	
   PromptValue = 0;
   SELECT DISTINCT
          :PromptValue = JA.Status
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :Move.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.TORS = :TORS AND
          JA.IssueCompl = :IssueCompl AND
          JA.JobClass = :Move.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair AND
          JA.Action = :JobAction$Prompt AND
          JA.Status IN (:Prompt$SendOpenToSSL, :Prompt$SendCloseToSSL);
   CALLPROC DDB_ROLLBACK;

   IF PromptValue = 0 THEN
      RETURN;

   ELSE
      IF PromptValue = Prompt$SendOpenToSSL THEN
         EquipStatus = 1;
      ELSE
         EquipStatus = 0;
      ENDIF;         

      RetCode = CALLPROC FMS_ObjectStatusAuditIns (
         Time = IFNULL(NewTime, DATE('NOW')),
         Object = Move.Equip,
         Status = EquipStatus,
         Job = Move.Job,
         TORS = ToRs,
         Card = Move.Card,
         SwitchingItem = Move.SwitchingItem,
         FromApp = CurrentApplication,
         DOName = DOp.Description,
         RowTime = DATE('NOW'),
         StatusUpdate = 1);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace(Text = VARCHAR(DATE('NOW')) + ': ManualTimeEntry: Unable to insert row into the ' +
                               'FMS_ObjectStatusAudit table for Equip = ' + Varchar(Move.Equip));
      ELSE 
         CALLPROC DDB_COMMIT;
         CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ObjectStatusAudit');
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   RETURN;
END;

