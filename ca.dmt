/*
**
**      Copyright c 2020 Pateric Software LLC. All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          MTA_Contingency_ASE
**
**  Date:       Version Description
** ----------------------------------
**  10/28/20    em      Created 
**  06/21/21    em      Modification to CIG Message
**  06/22/21    em      Add LoadCIGAlleviation Method
*/ 
METHOD LoadCIGMessage (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ErrorMessage = '';
   CurObject.ReturnCode = 0;

   CurObject.Contingency.Clear();
   i = 1;
   SELECT :CurObject.Contingency[i].Card = Card,
          :CurObject.Contingency[i].Contingency = Contingency,
          :CurObject.Contingency[i].ContingencyName = ContingencyName,
          :CurObject.Contingency[i].DOComment = DOComment,
          :CurObject.Contingency[i].Line = Line,
          :CurObject.Contingency[i].LineName = LineName        
   FROM   FMS_MTAContingency
   WHERE  Card = :CurObject.Card 
   ORDER BY LineName
   BEGIN
      j = 1;
      SELECT :CurObject.Contingency[i].Feeders[j].Object = Feeder,
             :CurObject.Contingency[i].Feeders[j].Name = FeederName
      FROM   FMS_MTAContingencyFeeder
      WHERE  Card = :CurObject.Card AND
             Line = :CurObject.Contingency[i].Line
      ORDER BY 2
      BEGIN
         j = j + 1;
      END;
      i = i + 1;
   END;
   
   IF CurObject.Contingency.LastRow > 0 THEN
       CurObject.CIGMessage = '<br \>' + HC_NEWLINE;
       CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE +
                              'MTA Contingency by Line:' + '<br \>' + HC_NEWLINE;
   ENDIF;
   FOR i = 1 TO CurObject.Contingency.LastRow DO
      CurObject.CIGMessage = CurObject.CIGMessage + '- ' + CurObject.Contingency[i].LineName + ': ' + 
                                    CurObject.Contingency[i].ContingencyName + ' ';
      FOR j = 1 TO CurObject.Contingency[i].Feeders.LastRow DO
         IF j = 1 THEN
            CurObject.CIGMessage = CurObject.CIGMessage + 'next worst or restricted feeder(s) ' + 
                                   CurObject.Contingency[i].Feeders[j].Name;
         ELSE  
            CurObject.CIGMessage = CurObject.CIGMessage + ', ' + 
                                   CurObject.Contingency[i].Feeders[j].Name;
         ENDIF;
      ENDFOR;                              
      IF CurObject.Contingency[i].DOComment <> '' THEN
         CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE + ' DO Comment: ' +
                                CurObject.Contingency[i].DOComment;
      ENDIF;
      CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE;               
   ENDFOR;
   /* Cap message length, allow 70 chars for Notification Cutout text string*/
   IF LENGTH(CurObject.CIGMessage) > 1930 THEN
      CurObject.CIGMessage = LEFT(CurObject.CIGMessage,1865) + '<br \>' + HC_NEWLINE + 
               '***REMAINDER OF MESSAGE CUT DUE TO EXCESSIVE LENGTH, CALL D.O.***'; 
   ENDIF;
END;


METHOD LoadCIGAlleviation (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   LastRow = INTEGER NOT NULL WITH DEFAULT;
   MsgYes = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ErrorMessage = '';
   CurObject.ReturnCode = 0;
   MsgYes = FALSE;
/*
** Two purposes, to load impacting contingencies for DO alleviation and to prepare
** CIG message for alleviation status.
*/ 
   CurObject.Contingency.Clear();
   i = 1;
   SELECT :CurObject.Contingency[i].Card = Card,
          :CurObject.Contingency[i].Contingency = Contingency,
          :CurObject.Contingency[i].ContingencyName = ContingencyName,
          :CurObject.Contingency[i].DOComment = DOComment,
          :CurObject.Contingency[i].Line = Line,
          :CurObject.Contingency[i].LineName = LineName,
          :CurObject.Contingency[i].AlleviationStatus = AlleviationStatus,        
          :CurObject.Contingency[i].NotAlleviatedComment = NotAlleviatedComment        
   FROM   FMS_MTAContingency
   WHERE  Card = :CurObject.Card AND
          Contingency <> :Type$MTANoImpact 
   ORDER BY LineName
   BEGIN
      j = 1;
      SELECT :CurObject.Contingency[i].Feeders[j].Object = Feeder,
             :CurObject.Contingency[i].Feeders[j].Name = FeederName
      FROM   FMS_MTAContingencyFeeder
      WHERE  Card = :CurObject.Card AND
             Line = :CurObject.Contingency[i].Line
      ORDER BY 2
      BEGIN
         j = j + 1;
      END;
      i = i + 1;
   END;
/* 
** Build CIG Message First
*/   
   LastRow = CurObject.Contingency.LastRow;
   IF LastRow > 0 THEN
       CurObject.CIGMessage = '<br \>' + HC_NEWLINE;
       CurObject.CIGMessage = 'MTA Contingency by Line:' + '<br \>' + HC_NEWLINE;
   ENDIF;
   
   FOR i = 1 TO CurObject.Contingency.LastRow DO
      
      IF CurObject.Contingency[i].AlleviationStatus > 0 THEN 
        
        MsgYes = TRUE;
        CurObject.CIGMessage = CurObject.CIGMessage + '- ' + CurObject.Contingency[i].LineName + ': ' + 
                                    CurObject.Contingency[i].ContingencyName + ' ';
        FOR j = 1 TO CurObject.Contingency[i].Feeders.LastRow DO
         IF j = 1 THEN
            CurObject.CIGMessage = CurObject.CIGMessage + 'next worst or restricted feeder(s) ' + 
                                   CurObject.Contingency[i].Feeders[j].Name;
         ELSE  
            CurObject.CIGMessage = CurObject.CIGMessage + ', ' + 
                                   CurObject.Contingency[i].Feeders[j].Name;
         ENDIF;
        ENDFOR;                              
        IF CurObject.Contingency[i].AlleviationStatus = 1 THEN
           CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE + ' All next worse conditions alleviated.';
        ELSEIF CurObject.Contingency[i].AlleviationStatus = 2  THEN
           CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE + ' Condition not alleviated. ' + 
                                  CurObject.Contingency[i].NotAlleviatedComment;               
        ENDIF;
        CurObject.CIGMessage = CurObject.CIGMessage + '<br \>' + HC_NEWLINE;  
        
      ENDIF;              
   ENDFOR;
   /* Cap message length, allow 70 chars for Notification Cutout text string*/
   IF LENGTH(CurObject.CIGMessage) > 1930 THEN
      CurObject.CIGMessage = LEFT(CurObject.CIGMessage,1865) + '<br \>' + HC_NEWLINE + 
               '***REMAINDER OF MESSAGE CUT DUE TO EXCESSIVE LENGTH, CALL D.O.***'; 
   ENDIF;
   
   IF MsgYes = FALSE THEN  /* Clear out message */
      CurObject.CIGMessage = '';
   ENDIF;
/*
** Only return lines where alleviation condition has not been answered
*/   
   i = LastRow;
   WHILE i > 0 DO
      IF CurObject.Contingency[i].AlleviationStatus > 0 THEN
         CurObject.Contingency.RemoveRow (RowNumber = i);
      ENDIF;
      i = i - 1;
   ENDWHILE;
END;

