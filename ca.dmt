	Name:            RelayProtectionMatrix

/*
**	Copyright c 1995 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**
**  Application:    CommonAppCompontents
**  Frame:          RelayProtectionMatrix
**
**  09/04/96   pkw    created
**  01/22/07   pkw    group notes by matrix instead of having a global set of notes.
**  03/28/97   pkw    allow multiple info rows
**  04/02/97   jfl    itc39 - Support ArchiveCard parameter
**  06/02/02   pkw    Modify for Web updates.
**  07/05/02   pkw    Clean out update ability since we can no longer update production
**                    tables.
**  07/20/04   pkw    Add variable for CheckCircuitStatus include script.
**  07/27/04   pkw    Modify DO Override button logic.
**  01/25/05   pkw    Allow for Multiple statuses in one matrix.
**  05/16/05   pkw    Put log into Relay_GroupingHistory when overriding to yellow.
**  02/10/10   ysp    Add showing attached diagrams
**  02/11/10   pkw    Update Replace Circuit feature.
**  03/15/10   pkw    Pass ReplaceCircuit flag to select circuit.
**  06/01/12   pkw    Change Multicheck from integer to integerobject.
*/

INITIALIZE
(
   CardObject = INTEGER NOT NULL WITH DEFAULT; /* passed from tfms */
   ArchiveCard = INTEGER NOT NULL WITH DEFAULT; /* P: True for TFMS archived card */
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   counter = INTEGER NOT NULL WITH DEFAULT;
   Currentstatus = INTEGER NOT NULL WITH DEFAULT;
   CurrentstatusName = VARCHAR(10) NOT NULL WITH DEFAULT;
   CurrentNotestatus = INTEGER NOT NULL WITH DEFAULT;
   RowInsert = INTEGER NOT NULL WITH DEFAULT;
   FeederRow = INTEGER NOT NULL WITH DEFAULT;
   CircuitRow = INTEGER NOT NULL WITH DEFAULT;
   Row = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   NewFeeder = OperatorClass;
   CurrentGrouping = INTEGER NOT NULL WITH DEFAULT;
   CurrentCircuit = INTEGER NOT NULL WITH DEFAULT;
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   FeederList = ARRAY OF OperatorClass; /* List of available feeders */
   CircuitList = ARRAY OF RelayStatusClass;
   RelayList = ARRAY OF RelayStatusClass;
   Relay = ARRAY OF CAC_Relay;
   LoadCircuit = CardClass;                    /* card/circuit information */
   TempNote = ARRAY OF NoteClass; 
   TempStationName = VARCHAR(20) NOT NULL;
   TempStatusName = VARCHAR(20) NOT NULL;
   TempRP = VARCHAR(600) NOT NULL;
   TempComment = VARCHAR(600) NOT NULL;
   TempCircuit = VARCHAR(80) NOT NULL;
   TempFeeder  = VARCHAR(60) NOT NULL;
   FoundStatus = INTEGER NOT NULL WITH DEFAULT;
   FoundSeq = INTEGER NOT NULL WITH DEFAULT;
   FeederStatus = INTEGER NOT NULL WITH DEFAULT;
   EquipmentStatus = INTEGER NOT NULL WITH DEFAULT;
   StatusColor = INTEGER NOT NULL WITH DEFAULT;
   FromTFMS = INTEGER NOT NULL WITH DEFAULT;
   FromTC = INTEGER NOT NULL WITH DEFAULT;
   MatrixFld = FieldObject;
   SimpleRPM = RPM_ASE DEFAULT NULL; /* enables use of class methods */
   CurrentRPM = RPM_ASE DEFAULT NULL;
   gCheck = INTEGER NOT NULL WITH DEFAULT; 
   gReset = INTEGER NOT NULL WITH DEFAULT; 
   gIn    = INTEGER NOT NULL WITH DEFAULT; 
   gOut   = INTEGER NOT NULL WITH DEFAULT; 
   CompStatus  = INTEGER NOT NULL WITH DEFAULT; 
   CountStatus = INTEGER NOT NULL WITH DEFAULT; 
   CktStatus   = INTEGER NOT NULL WITH DEFAULT; 
   MultiCheck  = ARRAY OF INTEGEROBJECT;
   StatusSeq   = ARRAY OF INTEGEROBJECT;
) =
BEGIN
/*
    CurSession.ProcessWait = FALSE;
    CurSession.ProcessWindow = FALSE;
*/
/*
**  Initialize statuscolor
*/
    StatusColor = CC_PALE_CYAN;
/*
** Make sure all columns are invisible.
*/
    i = 1;
    WHILE i <= Field(matrix).TableBody.Childfields.LastRow() DO
       Field(matrix).TableBody.ChildFields[i].CurBias = FB_INVISIBLE;
       i = i + 1;
    ENDWHILE;

    Field(RP).CurBias = FB_LANDABLE;
    Field(Matrix).CurBias = FB_Visible;
/*
**  Load Matrix data and format.
*/
    IF SimpleRPM IS NULL THEN
       SimpleRPM = RPM_ASE.Create();
    ENDIF;
    
    SimpleRPM.Grouping = CurrentGrouping;
    SimpleRPM.Feeder = 0;
    SimpleRPM.Circuit = 0;
    
    SimpleRPM.LoadMatrix();
   
    IF SimpleRPM.ReturnCode <> 0 THEN
       Message SimpleRPM.ErrorMessage;
       SimpleRPM = NULL;
       RESUME;
    ENDIF;
    CurFrame.SendUserEvent (eventname = 'load_data');
/*
**  IF called from tfms, then show relay and carrier button.
*/
    IF FromTFMS = TRUE THEN
        Field(Relay_btn).Curbias = FB_CHANGEABLE;
        Field(Carrier_btn).Curbias = FB_CHANGEABLE;
        CurFrame.SendUserEvent (eventname = 'RelayCarrier_Upd');
    ENDIF;
    CurFrame.WindowVisibility = WV_INVISIBLE;
END;


ON ChildClick Status[*].NoteStatus =
BEGIN
    i = 1;
    WHILE i <= Status.LastRow() DO
       Status[i].NoteStatus = FALSE;
       i = i + 1;
    ENDWHILE;

    CurrentNoteStatus = FIELD(Status).CurRow;
    Status[CurrentNoteStatus].NoteStatus = TRUE;
/*
**  Load notes for this status
*/
    Notes.Clear();
    FOR i = 1 TO CurrentRPM.sList[CurrentNoteStatus].Note.LastRow() DO
       FOR j = 1 TO CurrentRPM.nList.LastRow() DO
          IF CurrentRPM.sList[CurrentNoteStatus].Note[i].Note_ID = 
               CurrentRPM.nList[j].Note_ID THEN
             Notes[i] = CurrentRPM.nList[j].Duplicate();
             endloop;
          ENDIF;
       ENDFOR;
    ENDFOR;

END;


ON USEREVENT 'RelayCarrier_Upd' =
BEGIN
   StatusColor = CC_PALE_YELLOW;
#  include CheckRelayStatus
   FIELD(Relay_btn).BGCOLOR = StatusColor;

   StatusColor = CC_PALE_YELLOW;
#  include CheckCarrierStatus
   FIELD(Carrier_btn).BGCOLOR = StatusColor;
END;

ON Click OverRide_Btn =
BEGIN
   wa.Log = '';
   Field(wa).AbsYBottom = FIELD(OverRide_btn).AbsYBottom;		
   Field(wa).AbsXLeft = FIELD(RP).AbsXLeft;

   FIELD(wa).CurBias = FB_CHANGEABLE;
   FIELD(Close_Btn).ParentField.CurBias = FB_DIMMED;
   
END;

ON Click ClearOverRide_Btn = 
BEGIN 
   IF FromTFMS = TRUE THEN
      /*
      ** Log OverRide.
      */
      RetCode = CALLPROC SOA_LogIns (
               Card            = CardObject
              ,Job             = NULL
              ,SwitchingItem   = 0
              ,Time            = DATE('now')
              ,UserName        = UserName
              ,Item            = 'Matrix OverRide'
              ,New             = 'Cleared'
              );

      CALLPROC DDB_COMMIT;
   
   ELSEIF FromTC = TRUE THEN
      /*
      **  Log that they chose to continue
      */
      CALLPROC TC_LogChange (
              Card = CardObject,
              Job = NULL,
              Item = 'Matrix OverRide',
              Old = '',
              New = 'Cleared');
      CALLPROC DDB_COMMIT;

   ENDIF;
   
   RetCode = CALLPROC CAC_Relay_GroupingUpd
              (Grouping   = CurrentGrouping
              ,DOOverRide = FALSE
              );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not clear OverRide.';
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   CurFrame.SendUserEvent (eventname = 'locate_status');   
END; 

ON Click wa.OK_Btn = 
BEGIN 
   IF wa.Log = '' THEN
      message 'No reason was entered.';
      RESUME;
   ENDIF;
   
   IF FromTFMS = TRUE THEN
      /*
      ** Log OverRide.
      */
      RetCode = CALLPROC SOA_LogIns (
               Card            = CardObject
              ,Job             = NULL
              ,SwitchingItem   = 0
              ,Time            = DATE('now')
              ,UserName        = UserName
              ,Item            = 'Matrix OverRide'
              ,New             = 'See Log'
              );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to insert log' +
                 ' entry indicating Matrix OverRide.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*  
      **  Insert a new log into the database: 
      */ 
      RetCode = SOA_CardLogIns (Card = CardObject, 
                                SwitchingItem = 0,
                                LogTime = date('now'), 
                                Log = wa.Log, 
                                LogStatus = 'COMPLETE' 
                               ); 
      IF (RetCode <> 0) THEN 
         CALLPROC DDB_ROLLBACK; 
         Message 'Could not insert Log message';
      ENDIF; 
      CALLPROC DDB_COMMIT; 
   
   ELSEIF FromTC = TRUE THEN
      /*
      **  Log that they chose to continue
      */
      CALLPROC TC_LogChange (
              Card = CardObject,
              Job = NULL,
              Item = 'Matrix OverRide',
              Old = '',
              New = 'See Log');
      CALLPROC DDB_COMMIT;

      RetCode = TC_circuitsLogIns (Card = CardObject, 
	                          LogTime = date('now'), 
		                  Log = wa.Log, 
		                  LogStatus = 'COMPLETE' 
		                  ); 
      IF RetCode <> 0 THEN 
         CALLPROC DDB_ROLLBACK; 
         Message 'Could not insert into Circuit Log';
      ENDIF; 
      CALLPROC DDB_COMMIT;
      
   ENDIF;
   
   RetCode = CAC_Relay_GroupingUpd
              (Grouping   = CurrentGrouping
              ,DOOverRide = RPM$OverRideToYellow
              );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not set OverRide flag. Button will ' +
              'continue to show RED.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Log the event for historical purposes.
*/
   TempCircuit = '';
   FOR i = 1 TO Circuit.LastRow() DO
      TempCircuit = TempCircuit + '  ' + Circuit[i].Name;
   ENDFOR;

   TempFeeder = '';
   FOR i = 1 TO Fdr.LastRow() DO
      TempFeeder = TempFeeder + '  ' + Fdr[i].Name;
   ENDFOR;

   TempComment = wa.Log + HC_NEWLINE + 
              'Values in matrix:' + HC_NEWLINE +
              'Circuits:' + TempCircuit + HC_NEWLINE +
              'Feeders:' + TempFeeder;
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = CurrentGrouping, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$OverRideToYellow,
                   Comment = TempComment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:RelayProtectionMatrix:Error logging OverRide to Yellow condition.');
   ENDIF;
   CALLPROC DDB_COMMIT;  
   
   FIELD(wa).CurBias = FB_INVISIBLE;
   FIELD(Close_Btn).ParentField.CurBias = FB_CHANGEABLE;
   CurFrame.SendUserEvent (eventname = 'locate_status');   
END; 

ON Click wa.Cancel_Btn = 
BEGIN 
   FIELD(wa).CurBias = FB_INVISIBLE;
   FIELD(Close_Btn).ParentField.CurBias = FB_CHANGEABLE;   
END; 


ON Click Relay_Btn =
BEGIN
    RETURN(One$Value);
END;

ON Click Carrier_Btn =
BEGIN
    RETURN(Two$Value);
END;

ON USEREVENT 'locate_status' =
BEGIN
   StatusColor = CC_PALE_YELLOW;

#  include CheckCircuitStatus

   IF StatusColor = CC_RED AND
      ArchiveCard = FALSE AND
      CardObject <> 0 AND
     (FromTFMS = TRUE OR FromTC = TRUE) THEN

      FIELD(OverRide_btn).CurBias = FB_CHANGEABLE;
      FIELD(ClearOverRide_btn).CurBias = FB_INVISIBLE;
   ELSE
      FIELD(OverRide_btn).CurBias = FB_INVISIBLE;
      IF ArchiveCard = FALSE AND
        (FromTFMS = TRUE OR FromTC = TRUE) THEN
         i = 0;
         SELECT :i = DOOverRide
         FROM    CAC_Relay_Grouping
         WHERE   Grouping = :CurrentGrouping;
         IF i <> 0 AND CardObject <> 0 THEN
            FIELD(ClearOverRide_btn).CurBias = FB_CHANGEABLE;
         ELSE
            FIELD(ClearOverRide_btn).CurBias = FB_INVISIBLE;
         ENDIF;
      ENDIF;
   ENDIF;
/*
**  Highlight circuits that are out of service
*/
   FOR i = 1 TO CircuitList.LastRow() DO
      FOR j = 1 TO Circuit.LastRow() DO
         IF CircuitList[i].Circuit = Circuit[j].Object AND
            CircuitList[i].Route = Circuit[j].Route AND
            CircuitList[i].Status = 0 THEN
            FIELD(Circuit[j].GrouperName).BGCOLOR = StatusColor;
            FIELD(Circuit[j].Name).BGCOLOR = StatusColor;
            FIELD(Circuit[j].TypeName).BGCOLOR = StatusColor;
            FIELD(Circuit[j].RouteName).BGCOLOR = StatusColor;
            FIELD(Circuit[j].SubstationNames).BGCOLOR = StatusColor;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDFOR;

   IF StatusSeq.LastRow() <> 0 THEN
      FOR k = 1 TO StatusSeq.LastRow() DO
         /* 
         **  Find the row number for the status that was found. 
         */
         FOR i = 1 TO Matrix.LastRow() DO
            IF StatusSeq[k].Value = Matrix[i].Seq THEN
               /*
               **  If StatusSeq.LastRow() > 1 then 
               **  we will need to look again to see what to show.
               **  We don't want to change the include script because
               **  it is called from many places.
               */
               IF StatusSeq.LastRow() > 1 THEN
                  SELECT :FeederStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :CurrentGrouping AND
                         RS.Seq = :StatusSeq[k].Value AND
                         RS.Circuit = :Relay$Feeder;
                  CALLPROC DDB_ROLLBACK;
                  IF FeederStatus <> Relay$Yes AND
                     FeederStatus <> Relay$Blank THEN
                     StatusColor = CC_RED;
                  ELSE
                     /* If the feeder = 'y', then see if equipment is */
                     REPEATED 
                     SELECT :EquipmentStatus = RS.Status
                     FROM   CAC_Relay_Status RS
                     WHERE  RS.Grouping = :CurrentGrouping AND
                            RS.Seq = :StatusSeq[k].Value AND
                            RS.Circuit = :Relay$Equipment;
                     IF EquipmentStatus <> Relay$Yes AND
                        EquipmentStatus <> Relay$Blank THEN
                        StatusColor = CC_RED;
                     ELSE
                        /*
                        **  We will downgrade status one color
                        */
                        IF StatusColor = CC_RED THEN
                           StatusColor = CC_YELLOW;
                        ELSE
                           StatusColor = CC_PALE_YELLOW;
                        ENDIF;
                     ENDIF;
                  ENDIF;
               ENDIF;

               FoundStatus = i;
               ENDLOOP;
            ENDIF;
         ENDFOR;

         Field(matrix[FoundStatus].Col1Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col2Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col3Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col4Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col5Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col6Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col7Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col8Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col9Name).BgColor = StatusColor;
         Field(matrix[FoundStatus].Col10Name).BgColor = StatusColor;

         IF k = StatusSeq.LastRow() THEN
            /*
            **  Load notes for this status
            */
            Notes.Clear();
            FOR i = 1 TO CurrentRPM.sList[FoundStatus].Note.LastRow() DO
               FOR j = 1 TO CurrentRPM.nList.LastRow() DO
                  IF CurrentRPM.sList[FoundStatus].Note[i].Note_ID = 
                       CurrentRPM.nList[j].Note_ID THEN
                     Notes[i] = CurrentRPM.nList[j].Duplicate();
                     endloop;
                  ENDIF;
               ENDFOR;
            ENDFOR;
            Status[FoundStatus].NoteStatus = 1;
         ENDIF;
      ENDFOR;
   ENDIF;   
END;

ON USEREVENT 'resize_frame' =
BEGIN
/*
**  Size window to correct size
*/
   CurFrame.Flush();
   Curframe.WindowHeight = CurFrame.TopForm.ChildFields[1].Height;
   Curframe.WindowWidth = CurFrame.TopForm.ChildFields[1].Width;
   IF CurFrame.TopForm.ChildFields[1].Width > CurFrame.WindowWidth THEN
      CurFrame.HasScrollBars = TRUE;
   ENDIF;
/*
**  Do this to avoid flickering when display is called up.
*/
   IF CurFrame.WindowVisibility <> WV_VISIBLE THEN
      CurFrame.WindowVisibility = WV_VISIBLE;
   ENDIF;

END;

ON USEREVENT 'load_data' =
BEGIN
    Fdr.Clear();
    Fdr = SimpleRPM.fList.Duplicate();
    Field(fdr).NumVisibleRows = fdr.LastRow();

    Circuit.Clear();
    Circuit = SimpleRPM.cList.Duplicate();
    Field(Circuit).NumVisibleRows = Circuit.LastRow();
    Field(Circuit).IsHighlighted = TRUE;
    FIELD(Circuit).CurRow = 0;
    
    Status.Clear();
    Status = SimpleRPM.sList.Duplicate();
    Field(Status).NumVisibleRows = Status.LastRow();

    RP.Clear();
    RP = SimpleRPM.iList.Duplicate();

    IF SimpleRPM.DList.LastRow = 0 THEN
       FIELD(DiagTbl).CurBias = FB_INVISIBLE;
       CurFrame.Flush();
    ELSE
       DiagTbl = SimpleRPM.DList.Duplicate();
    ENDIF;

    CurFrame.SendUserEvent (eventname = 'load_matrix');
END;

ON USEREVENT 'load_matrix' =
BEGIN
/*
**  reinitialize columns for matrix table
*/
    i = 1;
    WHILE i <= Field(matrix).TableBody.Childfields.LastRow() DO
       Field(matrix).TableBody.ChildFields[i].CurBias = FB_INVISIBLE;
       i = i + 1;
    ENDWHILE;
/*
**  Load Matrix
*/
    Matrix.Clear();
    Matrix = SimpleRPM.mList.Duplicate();
    Field(Matrix).NumVisibleRows = Matrix.LastRow();
    
    FOR i = 1 TO SimpleRPM.cList.LastRow() DO
       Field(matrix).TableBody.ChildFields[i].CurBias = FB_CHANGEABLE;
    ENDFOR;
/*
**  Make copy of SimlpeRPM
*/
    CurrentRPM = NULL;
    CurrentRPM = RPM_ASE.Create();
    CurrentRPM = SimpleRPM.Duplicate();
/*
**  Set SimpleRPM back to NULL.
*/
    CurrentGrouping = SimpleRPM.Grouping;
    SimpleRPM = NULL;

    CurFrame.SendUserEvent (eventname = 'locate_status');

    CurFrame.SendUserEvent (eventname = 'resize_frame');
END;

ON CLICK Replace_Btn =
BEGIN
    i = 0;
    i = FIELD(Circuit).CurRow;
    IF i = 0 THEN
       MESSAGE 'You must first select which circuit you want to replace.';
       RESUME;
    ENDIF;  
    
    IF CurFrame.ConfirmPopup (messagetext = 'If ' + Circuit[i].Name + 
         ' / ' + Circuit[i].RouteName + 
         ' is the circuit/route you want to replace, select ''OK'' to choose ' +
         'the new circuit.') = PU_CANCEL THEN
       RESUME;
    ENDIF;

    LoadCircuit = CALLFRAME SelectCircuit(ReplaceCircuit = TRUE);

    IF LoadCircuit.Circuit = No$Value THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       /*
       **  Replace circuit in Matrix.
       */
       RetCode = CALLPROC CAC_Relay_ReplaceCircuit(
                              Grouping = CurrentGrouping,
                              OldCircuit = Circuit[i].Object,
                              OldRoute   = Circuit[i].Route,
                              NewCircuit = LoadCircuit.Circuit,
                              NewRoute   = LoadCircuit.Route);
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          Message 'Error occurred while replacing circuit in RPM.';
          RESUME;
       ENDIF;
       CALLPROC DDB_COMMIT;
       /*
       **  Log for reporting.
       */
       TempComment = 'Circuit ' + Circuit[i].Name + ' was replaced ' + 
                     'with circuit ' + LoadCircuit.LineNumber;
       RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                    Grouping = CurrentGrouping, 
                    UserName = DOp.Description,
                    LogDate = date('now'),
                    LogType = RPM$ReplaceCircuit,
                    Comment = TempComment);
       IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
             'FRAME:RelayProtectionMatrix:Error logging Replace of circuit.' + TempComment);
       ENDIF;
       CALLPROC DDB_COMMIT;  
/*
**  Initialize statuscolor
*/
       StatusColor = CC_PALE_CYAN;
       Field(matrix[FoundStatus].Col1Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col2Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col3Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col4Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col5Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col6Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col7Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col8Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col9Name).BgColor = StatusColor;
       Field(matrix[FoundStatus].Col10Name).BgColor = StatusColor;
       /*
       **  Load Matrix data and format.
       */
       IF SimpleRPM IS NULL THEN
          SimpleRPM = RPM_ASE.Create();
       ENDIF;
    
       SimpleRPM.Grouping = CurrentGrouping;
       SimpleRPM.Feeder = 0;
       SimpleRPM.Circuit = 0;
    
       SimpleRPM.LoadMatrix();
   
       IF SimpleRPM.ReturnCode <> 0 THEN
          Message SimpleRPM.ErrorMessage;
          SimpleRPM = NULL;
          RESUME;
       ENDIF;
       CurFrame.SendUserEvent (eventname = 'load_data');
    ENDIF;
END;

ON CHILDENTRY DiagTbl[*].FileName =
DECLARE
   DiagramFile = LongByteObject;
   FilePath = VARCHAR(80) NOT NULL WITH DEFAULT;
   SelectSql = VARCHAR(200) NOT NULL WITH DEFAULT;
   WorkDir = VARCHAR(40) NOT NULL WITH DEFAULT;
   OSCommand = VARCHAR(200) NOT NULL WITH DEFAULT;
   ScriptLogFile = StringObject;   /* holds contents of files */

ENDDECLARE
BEGIN
    IF (Curframe.ReasonCode = RC_PROGRAM OR Curframe.ReasonCode = RC_TFSCROLL) THEN
        RESUME;
    ENDIF;
    i = FIELD(DiagTbl).CurRow;

    WorkDir = CurSession.GetEnv(Name = 'II_TEMPORARY');
    FilePath = WorkDir + '\' + DiagTbl[i].FileName;

    SelectSql = ' SELECT DataStream FROM CAC_Relay_Attachment ' + 
                ' WHERE Grouping = ' + VARCHAR(CurrentGrouping) + ' AND ' + 
                ' FileID = ' + VARCHAR(DiagTbl[i].FileID);

    If DiagramFile.FetchFromDB(Query = SelectSql) <> ER_OK Then  
        ROLLBACK;
        Message 'Unable to read the diagram from the database. Try again.';
        Resume;
    ENDIF;
    COMMIT;

    If DiagramFile.WriteToFile(Filename = FilePath) <> ER_OK Then
        Message 'Unable to create the diagram to your disk.';
        RESUME;
    Endif;

    ScriptLogFile.Value = '';
    ScriptLogFile = ScriptLogFile.ConCatVarchar (text = 
           '@echo off' + HC_NEWLINE +
           'start ' + FilePath);
    i = ScriptLogFile.WriteToFile (filename = WorkDir + '\rpm_diagram.bat');

    IF i <> ER_OK THEN
       DDB_Global.TopFrame.Trace(Text = VARCHAR(DATE('now')) +
          'Error creating ' + WorkDir + '\rpm_diagram.bat');
    ENDIF;

    OSCommand = WorkDir + '\rpm_diagram.bat'; 

    CALL SYSTEM OSCommand;
END;

ON CLICK Close_Btn =
BEGIN  
    RETURN(No$Value);
END;

ON WindowClose =
BEGIN
    RESUME;
END;

Name:      item1

				Fieldobject Script
