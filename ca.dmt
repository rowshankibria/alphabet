Application Component Report
============================

	Name:            ManualFODOrderRescind

/*
**
**  Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software LLC proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          ManualFODOrderRescind
**
**  04/22/02     em    FOD version created from Op Order version.
**  05/02/02     pkw   On force rescind DO must select operator.
**  05/27/02     em    Removed temporary message on front of screen
**  12/02/02     pkw   Don't pass OfferSelection to SelectOperator screen.
**  01/06/03     ysp   ITC 114: Use DoLogin to select a DO.
**  01/23/03     ysp   Removed local FO object declaration
**  03/06/03     ysp   FOD1: if the fod order is sequenced, rescind all moves.
**  03/19/03     ysp   Support rescission of partial sequence order
**  04/04/03     ysp   Allow moves to be rescinded without showing the screen.
**  04/10/03     ysp   Implement new fod job status scheme
**  02/19/04     em    Don't allow selection of FOD Operator for Force Rescind
**  11/19/04     ysp   Set order status to order$rescinded if all moves have been
**                     rescinded.
**  12/07/04     pkw   Add #9 logic
**  07/20/05     em    When force completing, set status immediately to confirm rescinded.
**  02/10/06     em    Check for Job Status for Rejection at last second just to make
**                     sure FOD did not Reject in time screen was displayed.
**  12/08/06     ysp   Delete outgoing messages after orders forcibly rescinded.
**  04/16/07     ysp   ITC210: Insert IR interface event in DB event queue
**  06/12/09     pkw   Remove call to dologin screen.
**  12/23/10     em    Fix bug.  When force rescinding on sequential FOD order where
**                     prior moves have been completed already, when finished must set order
**                     status.  Order status will be set Confirm Complete instead of
**                     Confirm Rescinded because earlier moves have been completed.
*/

INITIALIZE
(
    MoveObject = MoveRescission;  /* Passed*/
    ForceRescind = INTEGER NOT NULL WITH DEFAULT;  /* Passed*/
    ShowScreen = INTEGER NOT NULL WITH DEFAULT;   /* Passed*/ 
 
/*    OrderNumber = INTEGER NOT NULL WITH DEFAULT;    Passed*/
/*    OrderJob = INTEGER NOT NULL WITH DEFAULT;    Passed*/ 
/*    TORS = INTEGER NOT NULL WITH DEFAULT;    Passed*/

    i = INTEGER NOT NULL WITH DEFAULT; /* Counter */
    j = INTEGER NOT NULL WITH DEFAULT; /* Counter */
    ControlText = VARCHAR(256) NOT NULL WITH DEFAULT; /*DBEventText*/
    Feeder = INTEGER NOT NULL WITH DEFAULT; 
    MsgKey = INTEGER NOT NULL WITH DEFAULT;
    OrderCard = INTEGER NOT NULL WITH DEFAULT;
    OrderTarget = VARCHAR(20) NOT NULL WITH DEFAULT;
    OrderSequence = VARCHAR(20) NOT NULL WITH DEFAULT;
    Presel = INTEGER NOT NULL WITH DEFAULT; /* Selection Value*/
    Retcode = INTEGER ;                /* Return code */
    JobList = ARRAY OF IntegerObject;
    ToRsList = ARRAY OF IntegerObject;
) =
BEGIN
    IF ShowScreen = FALSE THEN
       CurFrame.WindowVisibility = WV_INVISIBLE;
    ENDIF;
    
    IF ForceRescind = TRUE THEN
       FIELD(force_stack).CurBias = FB_VISIBLE;
       FIELD(rescind_stack).CurBias = FB_INVISIBLE;
       FIELD(FODOperator).CurBias = FB_CHANGEABLE;
    ELSE
 
       FIELD(force_stack).CurBias = FB_INVISIBLE;
       FIELD(rescind_stack).CurBias = FB_VISIBLE; 
       FIELD(FODOperator).CurBias = FB_INVISIBLE;
    ENDIF;

    SELECT :OrderSequence = SequenceType,
           :OrderTarget = OrderTarget,
           :OrderCard = Card,
           :Feeder = Feeder,
           :MsgKey = MsgKey 
    FROM    IR_FODOrder
    WHERE   OrderNumber = :MoveObject.OrderNumber;
    CALLPROC DDB_ROLLBACK;
/* 
**  Make two text strings because there is a limit of 256 characters.
*/
    FIELD(FODOperator.Contact_trm).TextValue = OrderTarget + ' Contacted:';
    FIELD(Rescind_stack.Rescind1_trm).TextValue = 
       '   You are rescinding an ' + OrderTarget + ' Move that has not yet' + HC_NEWLINE +
       'been acknowledged by the ' + OrderTarget + '. If this move is on a' + HC_NEWLINE +
       'Sequential order, all outstanding moves on the order' + HC_NEWLINE +
       'will be rescinded.';
    
    FIELD(Force_stack.FRescind1_trm).TextValue = 
       '   You are either:' + HC_NEWLINE +
       '1) Rescinding an ' + OrderTarget + ' Move that has already been' + HC_NEWLINE +
       'acknowledged by the ' + OrderTarget + ', or' + HC_NEWLINE +
       '2) Force Incompleting an unacknowledged ' + OrderTarget + ' move.';
    FIELD(Force_stack.FRescind2_trm).TextValue = 
       '   If this move is on a Sequential order, all outstanding' + HC_NEWLINE +
       'moves on the order will be rescinded.' + HC_NEWLINE +
       '   You should have already contacted the ' + OrderTarget + ' and' + HC_NEWLINE +
       'informed them of your intent. Please indicate the' + HC_NEWLINE +
       'reason you are rescinding this move.';
    
    Presel = 0;
    DistrictOperator = DOp.Description;
    FODOperator.Name = '';

    IF ShowScreen = FALSE THEN
       Reason = MoveObject.Reason;
       FODOperator.Name = MoveObject.FODName;
       IF FODOperator.Name = 'FOD' OR
          FODOperator.Name = '#9'    THEN
          FODOperator.Name = '';
       ENDIF;

       CurFrame.SendUserEvent (EventName = 'Rescind_Move');
    ELSE
       CurFrame.SendUserEvent (eventname='load table');
    ENDIF;
END;


ON USEREVENT 'load table' =
BEGIN
    O.Clear();
    i = 1;

    SELECT :O[i].Name = t.name,
           :O[i].Type = t.type
    FROM   udb_type t, 
           udb_extendedtype e      
    WHERE  e.supertype = :Type$RescissionReason AND
           e.type <> e.supertype AND
           t.type = e.type
    ORDER BY 1
    BEGIN
          i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
END;    

/*
**  Handle the childclick 
*/
ON Childentry O  =
BEGIN

    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

/*
**  Reset the highlight for the frame
*/
    Presel = FIELD(O).CurRow;

    i = 1;
    WHILE (i <= O.LastRow()) DO
        IF (i = Presel) THEN
            FIELD(O[i].Name).IsReverse = TRUE;
        ELSE
            FIELD(O[i].Name).IsReverse = FALSE;
        ENDIF;
        i = i + 1;
    ENDWHILE;    

    MoveObject.ReasonType.Type = O[Presel].Type;
    MoveObject.ReasonType.Name = O[Presel].Name;

    CurFrame.Flush();
END;

ON ChildSetValue O[*].Name =
BEGIN
    Curframe.InputFocusField = FIELD(Reason);
END;


ON ENTRY FODOperator.Name =
BEGIN
    RetCode = CALLFRAME SelectOperator (AnyName = TRUE);
    IF RetCode = PU_Cancel THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       FODOperator.Name = FO.Description;
       MoveObject.FODName = FODOperator.Name;
    ENDIF;             
END;


/*
**  Handle an OK click
*/
ON UserEvent 'Rescind_Move',
ON Click OKButton =
BEGIN
/*
** Validate entry fields
*/
  IF ShowScreen = TRUE THEN  
    IF Lowercase (Reason) LIKE '%fuck%' OR 
       Lowercase (Reason) LIKE '%shit%' OR 
       Lowercase (Reason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        Reason = '';
	RESUME;

    ELSEIF (ShowScreen = TRUE AND Presel = 0) OR 
            Length( Squeeze (Reason)) <= 6 THEN

        MESSAGE 'You must select a reason or enter more explanation.';
        Reason = '';
        RESUME;

    ELSEIF DistrictOperator = '' THEN
 
        MESSAGE 'Please Select your name from the District Operator list.';
        RESUME;

    ELSEIF (FODOperator.Name = '' OR FODOperator.Name = 'FOD' OR FODOperator.Name = '#9') AND 
            ForceRescind = TRUE THEN
 
        FODOperator.Name = '';
        MESSAGE 'Please Select the ' + OrderTarget + ' Operator with whom you ' +
                'confirmed the FORCE RESCIND.';
        RESUME;

    ENDIF;
  ENDIF;

  MoveObject.Reason = Reason;

/*
** If a portion of sequenced moves have been completed/incompleted, we will just rescind
** the rest of the order. 
*/
    IF OrderSequence = 'SEQUENCED' THEN
       /*
       ** check if moves have been returned.
       */
       i = 0;
       SELECT :i = COUNT(*)
       FROM   IR_FODOrderJobs 
       WHERE  OrderNumber = :MoveObject.OrderNumber AND
              JobStatus IN (:Order$Closed, :Order$ConfirmClosed, 
                            :Order$Rejected, :Order$ConfirmRejected);

       IF i > 0 THEN
          i = 1;
          SELECT :JobList[i].Value = Job,
                 :ToRsList[i].Value = TORS
          FROM   IR_FODOrderJobs 
          WHERE  OrderNumber = :MoveObject.OrderNumber AND
                 JobStatus IN (:Order$Opened, :Order$Downloaded, :Order$Acknowledged, 0)
          BEGIN
              i = i + 1;
          END;
          CALLPROC DDB_ROLLBACK;

          IF ForceRescind = TRUE THEN
             FOR i = 1 to JobList.LastRow() DO
       
                Reason = OrderTarget + ' Contacted: ' + FODOperator.Name + HC_NEWLINE + Reason;

                RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = JobList[i].Value,
                      TORS = ToRsList[i].Value,
                      JobStatus = Order$ConfirmRescinded,
                      RescindType = 'FORCE',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
 
                IF RetCode <> 0  THEN
                   CALLPROC DDB_ROLLBACK;
                   Message 'ERROR: Unable to Rescind the Order. ';
                   RETURN (PU_CANCEL);
                ENDIF;
             ENDFOR;
             CALLPROC DDB_COMMIT; 

             /* Set the order status to Order$ConfirmClosed */
             RetCode = CALLPROC IR_FODOrderStatusUpd (
                           Ordernumber = MoveObject.OrderNumber,
                           OrderStatus = Order$ConfirmClosed);
             CALLPROC DDB_COMMIT; 

           ELSE        /*  Rescission Request */

             FOR i = 1 to JobList.LastRow() DO
                RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = JobList[i].Value,
                      TORS = ToRsList[i].Value,
                      JobStatus = 0,
                      RescindType = 'REQUEST',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
 
                IF RetCode <> 0  THEN
                   CALLPROC DDB_ROLLBACK;
                   Message 'ERROR: Unable to Rescind the Order. ';
                   RETURN (PU_CANCEL);
                ENDIF;
             ENDFOR;
             CALLPROC DDB_COMMIT; 
          ENDIF;

       ELSE   /* no moves have been completed */
 
         IF ForceRescind = TRUE THEN
       
            Reason = OrderTarget + ' Contacted: ' + FODOperator.Name + HC_NEWLINE + Reason;

            RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = 0,
                      TORS = 0,
                      JobStatus = Order$ConfirmRescinded,
                      RescindType = 'FORCE',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
 
            IF RetCode <> 0  THEN
               CALLPROC DDB_ROLLBACK;
               Message 'ERROR: Unable to Rescind the Order. ';
               RETURN (PU_CANCEL);
            ENDIF;
            CALLPROC DDB_COMMIT; 
     
            /* Set the order status to Order$rescinded */
            RetCode = CALLPROC IR_FODOrderStatusUpd (
                           Ordernumber = MoveObject.OrderNumber,
                           OrderStatus = Order$ConfirmRescinded);
            CALLPROC DDB_COMMIT; 
          
         ELSE        /*  Rescission Request */

            RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = 0,
                      TORS = 0,
                      JobStatus = 0,
                      RescindType = 'REQUEST',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
 
            IF RetCode <> 0  THEN
               CALLPROC DDB_ROLLBACK;
               Message 'ERROR: Unable to Rescind the Order. ';
               RETURN (PU_CANCEL);
            ENDIF;
            CALLPROC DDB_COMMIT; 
         ENDIF;
       ENDIF;

    ELSE  /* not a sequenced order */

       SELECT :i = JobStatus
       FROM   IR_FODOrderJobs 
       WHERE  OrderNumber = :MoveObject.OrderNumber AND
              Job = :MoveObject.Job;

       IF i = Order$Rejected OR i = Order$Closed THEN
          MESSAGE 'This move has been returned or rejected ' +
                  'and must now be processed from the Incoming Message ' +
                  'to maintain consistency with Rapid Restore.';
          RETURN(PU_CANCEL);
       ENDIF;

       IF ForceRescind = TRUE THEN
       
          Reason = OrderTarget + ' Contacted: ' + FODOperator.Name + HC_NEWLINE + Reason;

          RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = MoveObject.Job,
                      TORS = MoveObject.TORS,
                      JobStatus = Order$ConfirmRescinded,
                      RescindType = 'FORCE',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
          IF RetCode <> 0  THEN
             CALLPROC DDB_ROLLBACK;
             Message 'ERROR: Unable to Rescind the Order. ';
             RETURN (PU_CANCEL);
          ENDIF;
          CALLPROC DDB_COMMIT; 

          /*
          ** if no more outstanding moves, change the order status to $Rescinded 
          */
          i = 0;
          SELECT :i = Count(*)
          FROM   IR_FODOrderJobs FOJ
          WHERE  FOJ.OrderNumber = :MoveObject.OrderNumber AND
                 FOJ.JobStatus IN (:Order$Opened, :Order$Downloaded, :Order$Acknowledged);
          IF i = 0 THEN
             RetCode = CALLPROC IR_FODOrderStatusUpd (
                           Ordernumber = MoveObject.OrderNumber,
                           OrderStatus = Order$ConfirmRescinded);
             CALLPROC DDB_COMMIT; 
          ENDIF;

       ELSE        /*  Rescission Request */

          RetCode = CALLPROC IR_FODJobRescindUpd (
                      Ordernumber = MoveObject.OrderNumber,
                      Job = MoveObject.Job,
                      TORS = MoveObject.TORS,
                      JobStatus = 0,
                      RescindType = 'REQUEST',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType = MoveObject.ReasonType.Type,
                      RescindReasonTypeName = MoveObject.ReasonType.Name,
                      RescindDO = DistrictOperator);
 
          IF RetCode <> 0  THEN
             CALLPROC DDB_ROLLBACK;
             Message 'ERROR: Unable to Rescind the Order. ';
             RETURN (PU_CANCEL);
          ENDIF;
          CALLPROC DDB_COMMIT; 
       ENDIF;
    ENDIF;
    CALLPROC DDB_COMMIT; 
/* 
** Raise DB EVENT for rescinding order.
*/
    ControlText = VARCHAR(MoveObject.OrderNumber) + ';' +
                  VARCHAR(MoveObject.Job) + ';' +
                  VARCHAR(MoveObject.TORS) + ';';
    CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_FODRescindOrder',
                     EventText = ControlText);  

/*
** delete outgoing "issue order" message 
*/
  IF ForceRescind = TRUE THEN
      RetCode = CALLPROC MSG_UpdateMsg (Card = OrderCard,
                                  Ack = Ack$Delete,
                                  MsgKey = MsgKey,
                                  AckByOpName = DistrictOperator,
                                  AckDate = date('now'),
                                  DelByOpName = DistrictOperator,
                                  DelDate = date('now'),
                                  Substation = Feeder 
                                  );
      CALLPROC DDB_COMMIT; 
  ENDIF;

    RETURN (PU_OK);   
END;
/*
**  Handle a Cancel click
*/
ON Click CancelButton =
BEGIN
    RETURN (PU_CANCEL);
END;


ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

