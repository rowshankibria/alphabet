	Name:            ConnectedSourceGroundTrace

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ConnectedSourceGroundTrace          
**
**  Modifications:
**  03/02/06   em   Created 
**                  StationGround = ON, OFF, or blank
**                  Called only from FMS_ManageCardHeader
**  05/14/09   em   Initialized ConnectedEquip array to FdrLoad device
**  01/25/17   ysp  Converted to QGis-based trace.
**  07/11/17   ysp  em   With Reason for No Station Ground enhancement, output trace message
**                  when trace stops due to floating equipment or visible break.
*/
PROCEDURE ConnectedSourceGroundTrace
(
   Feeder        = INTEGER NOT NULL;     /* Parameter*/
   StationGround = CHAR(3) NOT NULL WITH DEFAULT; /* Exit Parm*/
   StationGroundCount = INTEGER NOT NULL WITH DEFAULT; /*Exit Parm */
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   k		= INTEGER NOT NULL WITH DEFAULT;

   ExistingBreaks = ARRAY OF INTEGEROBJECT; /* List of Open Objects */
   FdrLoad	= ARRAY OF INTEGEROBJECT;
   FeederEquip	= ARRAY OF INTEGEROBJECT;    /* List of Equip on Feeder*/
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   Station      = INTEGER NOT NULL WITH DEFAULT;
   StationGrounds = ARRAY OF ObjectSummaryClass;
   TargetTypes = ARRAY OF INTEGEROBJECT;     /* List of bus section types */
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_ConnectedSourceGround DEFAULT NULL;
ENDDECLARE
BEGIN
   StationGround = '';
   Station = 0;
/*
** Get the Feeder Station
*/
   SELECT :Station = G.Grouping,
          :FeederName = O.Name
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  O.Object = :Feeder AND
          G.Member = O.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                           WHERE  SuperType = :Type$Substation);

   IF Station = 0 THEN   
      CALLPROC TraceError (UserMessage = 
               'ERROR: Feeder Ground count or Station Ground status cannot be ' +
               'determined since feeder does not have substation grouping. Please report to tech support.',
                           TraceMessage =
               'Procedure:ConnectSourceGroundTrace; ' +
               'Feeder ' + FeederName + ' not a member of a substation.'
               );

      RETURN(PU_CANCEL);
   ENDIF;
/*
** Get the grounds in the station and on the feeder
*/ 
   StationGrounds.Clear();
   StationGroundCount = 0;
   i = 1;
   REPEATED 
   SELECT :StationGrounds[i].Object = OS.Object,
          :StationGrounds[i].Terminal = OS.Terminal,
          :StationGrounds[i].BaseType = OS.StatusCount,
          :StationGrounds[i].Type = 0
   FROM   FMS_ObjectStatus OS,
          Udb_Grouping G1,
          Udb_Grouping G2
   WHERE  G1.Grouping = :Station AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.Member = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.Grouping = :Feeder AND
          G2.Member = OS.Object AND
          OS.Status = :Status$Ground
   BEGIN
      StationGroundCount = StationGroundCount + StationGrounds[i].BaseType;
      i = i + 1;
   END;
/*
** If we connect to a Bus Section, we have reached a target device
*/
   i = 1;
   SELECT
   DISTINCT  :TargetTypes[i].Value = Type
   FROM      Udb_ExtendedType 
   WHERE     SuperType = :TypeName$BusSect
   BEGIN
      i = i + 1;
   END;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all currently open devices
** into a sorted list that then can be searched using our bisection search.
*/
   ExistingBreaks.Clear();
   i = 1;        
   SELECT  :ExistingBreaks[i].Value = S.Object
   FROM    Udb_Switch S,
           Udb_Grouping G 
   WHERE   G.Grouping = :Feeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.Member = S.Object AND
           S.CurrentlyOpen = 1            /* Open device */
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
/*
** Scope trace must stay on feeder equipment, The Bus Section should be
** the first device in the substation.
*/ 
   FeederEquip.Clear();
   i = 1;
   SELECT  :FeederEquip[i].VALUE = G.Member
   FROM    Udb_Grouping G
   WHERE   G.Grouping = :Feeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$Switch)
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;          
/*
** Find each FdrLoad device on the Feeder
*/
   i = 1;
   FdrLoad.Clear();
   SELECT  :FdrLoad[i].Value = Member
   FROM    Udb_Grouping
   WHERE   Grouping = :Feeder AND
           Relationship = :Interaction$MemberOf AND
           MemberType = :Type$FdrLoad 
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** Now we trace starting from the FdrLoad devices on this card.
*/
   FOR j = 1 TO FdrLoad.LastRow() DO
      /*
      ** start search with this piece of equipment and then branch out in all
      ** directions.  When a trace dies or reaches an Open device we discontinue
      ** the trace in that direction.  
      */
      Trace = Trace_ConnectedSourceGround.Create();   // safer to create a trace object before each trace
      
      Trace.JCEquip.Object = FdrLoad[j].Value;
      Trace.Feeder = Feeder;
      Trace.FeederName = FeederName;
     
      Trace.StationGroundList = StationGrounds;
      Trace.TargetTypeList = TargetTypes;
      Trace.OpenBreakerList = ExistingBreaks;
      Trace.FeederSwitchList = FeederEquip;
      
      TraceStatus = Trace.StartTargetTrace();
      
      FOR k = 1 TO Trace.WarningList.LastRow DO
         CALLPROC TraceError (
                  UserMessage = Trace.WarningList[k].Value,
                  TraceMessage = 'ConnectedSourceGroundTrace: ' + Trace.WarningList[k].Value);       
         // continue
      ENDFOR;
      
      IF Trace.ReturnCode <> 0 THEN
         CALLPROC TraceError (
                  UserMessage = 'ERROR: The Connectivity trace from the feeder load discovered a connectivity problem: ' + Trace.ErrorMessage,
                  TraceMessage = 'ConnectedSourceGroundTrace: ' +
                    'The Connectivity trace from the feeder load ' + VARCHAR(FdrLoad[j].Value) + ' discovered a connectivity problem: ' + Trace.ErrorMessage);
         RETURN PU_CANCEL;
      ENDIF;
      
      /*
      ** Station Grounds - Connected Grounds = Number of grounds to deduct from feeder ground count
      */
      IF Trace.StationGround <> 'OFF' THEN
         StationGround = Trace.StationGround;
      ENDIF;
      
      StationGroundCount = StationGroundCount - Trace.GroundCount;
   ENDFOR;
   
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            ConnectedSourceGroundTrace_old

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ConnectedSourceGroundTrace          
**
**  Modifications:
**  03/02/06   em   Created 
**                  StationGround = ON, OFF, or blank
**                  Called only from FMS_ManageCardHeader
**  05/14/09   em   Initialized ConnectedEquip array to FdrLoad device
**  12/13/16   em   With Reason for No Station Ground enhancement, output trace message
**                  when trace stops due to floating equipment or visible break.
*/
PROCEDURE ConnectedSourceGroundTrace_old
(
   Feeder        = INTEGER NOT NULL;     /* Parameter*/
   StationGround = CHAR(3) NOT NULL WITH DEFAULT; /* Exit Parm*/
   StationGroundCount = INTEGER NOT NULL WITH DEFAULT; /*Exit Parm */
) =
DECLARE
   ExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Open Objects */
   FeederName   = VARCHAR(40) NOT NULL WITH DEFAULT;
   Feeders      = ARRAY OF FMS_Card;
   FdrLoad	= ARRAY OF INTEGEROBJECT;
   FeederEquip	= ARRAY OF INTEGEROBJECT;    /*List of Equip on Feeder*/
   f		= INTEGER NOT NULL WITH DEFAULT;
   g		= INTEGER NOT NULL WITH DEFAULT;
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   k		= INTEGER NOT NULL WITH DEFAULT;
   x		= INTEGER NOT NULL WITH DEFAULT;
   LastRow      = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   SourceBreaker  = INTEGER NOT NULL WITH DEFAULT;
   Station      = INTEGER NOT NULL WITH DEFAULT;
   StationGrounds = ARRAY OF ConnectedGround;
   ConnectedGroundCount = INTEGER NOT NULL WITH DEFAULT;
   TraceEnabled = INTEGER NOT NULL WITH DEFAULT;
/*
** Connectivity Types copied from CheckLocalOpen
*/
    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;
 
    VisibleBreak     = INTEGER NOT NULL WITH DEFAULT;
    FloatFound     = INTEGER NOT NULL WITH DEFAULT;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    TargetTypes    = ARRAY OF INTEGEROBJECT; /*Types we don't want to see*/
    TargetTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
ENDDECLARE
BEGIN
   StationGround = '';
   Station = 0;
   ConnectedGroundCount = 0;
/*
** Get the Feeder Station
*/
   SELECT :Station = Grouping
   FROM   Udb_Grouping G
   WHERE  Member = :Feeder AND
          Relationship = :Interaction$MemberOf AND
          GroupingType IN (SELECT Type FROM Udb_ExtendedType
                           WHERE  SuperType = :Type$Substation);

   IF Station = 0 THEN
      SELECT :FeederName = Name
      FROM   Udb_Object 
      WHERE  Object = :Feeder;
      CALLPROC TraceError (UserMessage = 
               'ERROR: Feeder Ground count or Station Ground status cannot be ' +
               'determined since feeder does not have substation grouping. Please report to tech support.',
                           TraceMessage =
               'Procedure:ConnectSourceGroundTrace; ' +
               'Feeder ' + FeederName + ' not a member of a substation.'
               );

      RETURN(PU_CANCEL);
   ENDIF;
/*
** Get the grounds in the station and on the feeder
*/ 
   StationGrounds.Clear();
   StationGroundCount = 0;
   i = 1;
   REPEATED 
   SELECT   :StationGrounds[i].Object = OS.Object,
            :StationGrounds[i].Terminal = OS.Terminal,
            :StationGrounds[i].Grounds = OS.StatusCount,
            :StationGrounds[i].Counted = 0
   FROM     FMS_ObjectStatus OS,
            Udb_Grouping G1,
            Udb_Grouping G2
   WHERE   G1.Grouping = :Station AND
           G1.Relationship = :Interaction$MemberOf AND
           G1.Member = G2.Member AND
           G2.Relationship = :Interaction$MemberOf AND
           G2.Grouping = :Feeder AND
           G2.Member = OS.Object AND
           OS.Status = :Status$Ground
   BEGIN
      StationGroundCount = StationGroundCount + StationGrounds[i].Grounds;
      i = i + 1;
   END;
/*
** If we connect to a Bus Section, we have reached a target device
*/
   i = 1;
   SELECT
   DISTINCT  :TargetTypes[i].Value = Type
   FROM      Udb_ExtendedType 
   WHERE     SuperType = :TypeName$BusSect
   BEGIN
      i = i + 1;
   END;
/*
** to facilitate looping and reduce connections to the database within the
** connectivity trace, we load all currently open devices
** into a sorted list that then can be searched using our bisection search.
*/
      ExistingBreaks.Clear();
      i = 1;        
      SELECT  :ExistingBreaks[i].Value = S.Object
      FROM    Udb_Switch S,
              Udb_Grouping G 
      WHERE   G.Grouping = :Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = S.Object AND
              S.CurrentlyOpen = 1            /* Open device */
      ORDER BY 1
      BEGIN
         i = i + 1;
      END;
/*
** Scope trace must stay on feeder equipment, The Bus Section should be
** the first device in the substation.
*/ 
      FeederEquip.Clear();
      i = 1;
      SELECT  :FeederEquip[i].VALUE = G.Member
      FROM    Udb_Grouping G
      WHERE   G.Grouping = :Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch)
      ORDER BY 1
      BEGIN
         i = i + 1;
      END;          
/*
** Find each FdrLoad device on the Feeder
*/
      i = 1;
      FdrLoad.Clear();
      SELECT  :FdrLoad[i].Value = Member
      FROM    Udb_Grouping
      WHERE   Grouping = :Feeder AND
              Relationship = :Interaction$MemberOf AND
              MemberType = :Type$FdrLoad 
      BEGIN
         i = i + 1;
      END;
/*
** Now we trace starting from the FdrLoad devices on this card.
*/
      StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';

      FOR j = 1 TO FdrLoad.LastRow() DO

          DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(FdrLoad[j].Value) + ')';
/*
** start search with this piece of equipment and then branch out in all
** directions.  When a trace dies or reaches an Open device we discontinue
** the trace in that direction.  
*/
          i = 1;
          ConnectedEquip.Clear();
          ConnectedEquip[i].Object = FdrLoad[j].Value;
          MoreObjects = TRUE;
          ClosedPaths = 0;

          WHILE MoreObjects = TRUE DO

             PrevClosedPaths = ClosedPaths;
             ClosedPaths = 0;
             OpenedPaths = 0;

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

             ExcludedNodes.Clear();
             TempEquip.Clear();

             x = 1;
             SELECT :TempEquip[x].Object = T2.Object,
               :TempEquip[x].Terminal = T2.Terminal,
               :TempEquip[x].Node  = T2.Node,
               :TempEquip[x].Used = :FALSE, 
               :TempEquip[x].GroundFound = :FALSE, 
               :TempEquip[x].OutBound = :FALSE, 
               :TempEquip[x].OutBoundBreakerFound = :FALSE, 
               :TempEquip[x].OutBoundDepth = 0, 
               :TempEquip[x].Type = O.Type,
               :TempEquip[x].TypeName = O.TypeName,
               :TempEquip[x].Name = O.Name,
               :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
               :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
               :TempEquip[x].Terminals = O.Terminals,
               :TempEquip[x].PrevObject = T1.Object
             FROM   Udb_Terminal T1,
                    Udb_Terminal T2,
                    Udb_Object O
             WHERE  :DynamicWhereClause
             ORDER BY PrevObject
             BEGIN
                CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
                x = x + 1;
             END;            

             MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
             x = 1;
             WHILE x <= ConnectedEquip.LastRow() DO

                IF ConnectedEquip[x].Used = FALSE THEN
                   FloatFound = TRUE;
                   k = 1;
                   WHILE k <= TempEquip.LastRow() DO
                      IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                         FloatFound = FALSE;
                         TempEquip[k].GroundFound = ConnectedEquip[x].GroundFound;
                         ENDLOOP;
                      ENDIF;
                      k = k + 1;
                   ENDWHILE;

                   IF FloatFound = TRUE THEN  /* OK if single terminal device */
                      IF ConnectedEquip[x].Terminals = 1 THEN                 
                         OpenedPaths = OpenedPaths + 1;
                      ELSE
/*
** Add trace message for connectivity problem
*/
                         SELECT :FeederName = Name
                         FROM   Udb_Object 
                         WHERE  Object = :Feeder;
                         CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
                               'Feeder ' + FeederName + ' source ground trace found connectivity problem at Object=' +
                               VARCHAR(ConnectedEquip[x].Object) );                                                                
                      ENDIF;
                   ENDIF;
                ENDIF;

                ConnectedEquip[x].Used = TRUE;
                x = x + 1;
             ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
             IncludedObjects.Clear();     

      /* check for open. */
             x = 1;
             WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
                k = 1;
                WHILE k <= ConnectedEquip.LastRow() DO
                   IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
                      ENDLOOP;
                   ENDIF;
                   k = k + 1;
                ENDWHILE;

                IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
                   IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN

                      VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = ExistingBreaks,
                                    TargetObject = TempEquip[x].Object);

                      IF VisibleBreak = FALSE THEN
               /* if this equip is in the next objectclause, remove it */
                         CALLPROC RemoveValue (ValueList = IncludedObjects,
                                     Value = ConnectedEquip[k].Object);
                      ENDIF;
                      ConnectedEquip[k].Used = TRUE;  
                   ENDIF;  
   
                ELSE                                    /* new equip */
                   i = i + 1;
                   ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());
            
                   VisibleBreak = CALLPROC ArraySearch(
                                    SearchArray = ExistingBreaks,
                                    TargetObject = TempEquip[x].Object);

                   IF VisibleBreak = TRUE THEN
                      ConnectedEquip[i].Used = TRUE;
                      OpenedPaths = OpenedPaths + 1;
/*
** Look for grounds on terminal side, count and set Station Ground if necessary
*/
                      FOR g = 1 TO StationGrounds.LastRow() DO
                         IF StationGrounds[g].Object = TempEquip[x].Object THEN

                            IF StationGrounds[g].Terminal = TempEquip[x].Terminal OR
                                 StationGrounds[g].Terminal = 0 THEN
                               IF StationGround <> 'OFF' THEN
                                  StationGround = 'ON';
                               ENDIF;
                               TempEquip[x].GroundFound = TRUE;
                               ConnectedEquip[i].GroundFound = TRUE;

                               IF StationGrounds[g].Counted = 0 THEN
                                  ConnectedGroundCount = ConnectedGroundCount + 
                                                         StationGrounds[g].Grounds; 
                                  StationGrounds[g].Counted = 1;
                               ENDIF;
                            ENDIF;
                         ENDIF;
                      ENDFOR;
/*
** If no station ground and this open equipment is not the source breaker, then present
** trace message.
*/
                      IF StationGround <> 'ON' THEN
                         SourceBreaker = 0;
                         SELECT :SourceBreaker = Member
                         FROM   Udb_Grouping 
                         WHERE  Grouping = :Feeder AND
                                Relationship = :Interaction$SourceBreaker AND
                                Member = :TempEquip[x].Object;

                         IF SourceBreaker = 0 THEN 
                            SELECT :FeederName = Name
                            FROM   Udb_Object 
                            WHERE  Object = :Feeder;
                            CALLPROC TraceError (UserMessage = '',
                               TraceMessage =
                                  'Feeder ' + FeederName + ' source ground connectivity trace stopped at OPEN device ' + 
                                  'with object id = ' +
                                  VARCHAR(TempEquip[x].Object) ); 
                         ENDIF;                                                               
                      ENDIF;
                   ELSE
/*
** Look for grounds, count and set Station Ground if necessary
*/
                      FOR g = 1 TO StationGrounds.LastRow() DO
                         IF StationGrounds[g].Object = TempEquip[x].Object THEN
                            
                               IF StationGround <> 'OFF' THEN
                                  StationGround = 'ON';
                               ENDIF;
                               TempEquip[x].GroundFound = TRUE;
                               ConnectedEquip[i].GroundFound = TRUE;

                               IF StationGrounds[g].Counted = 0 THEN
                                  ConnectedGroundCount = ConnectedGroundCount + 
                                                         StationGrounds[g].Grounds; 
                                  StationGrounds[g].Counted = 1;
                               ENDIF;
                         ENDIF;
                      ENDFOR;
/*
**  Look if we have a BusSect device
*/
                      TargetTypeFound = FALSE;
                      TargetTypeFound = CALLPROC ArraySearch(
                                    SearchArray = TargetTypes,
                                    TargetObject = TempEquip[x].Type);

                      IF TargetTypeFound = TRUE THEN
                         ConnectedEquip[i].Used = TRUE;
/*
** If no ground on this path, then Station Ground is OFF
*/
                         IF TempEquip[x].GroundFound = FALSE THEN
                            StationGround = 'OFF';
                         ENDIF;
                         ENDLOOP;
                      ELSE 
                         TargetTypeFound = FALSE;
                         TargetTypeFound = CALLPROC ArraySearch(
                                    SearchArray = FeederEquip,
                                    TargetObject = TempEquip[x].Object);
/*
**  The scope of the search must stay on the feeder, 
*/
                         IF TargetTypeFound = FALSE THEN
                            ConnectedEquip[i].Used = TRUE;
                            ENDLOOP;
                         ENDIF;
                      ENDIF;
                      ClosedPaths = ClosedPaths + 1;
                   ENDIF;
                ENDIF;
  
                IF ConnectedEquip[i].Used = FALSE THEN
                  CALLPROC InsertValue (ValueList = IncludedObjects, 
                                     Value = ConnectedEquip[i].Object);
                ENDIF;
                x = x + 1;
             ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
             IF IncludedObjects.LastRow() > 0 THEN
                MoreObjects = TRUE;
      
                DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
                x = 1;
               WHILE x <= ExcludedNodes.LastRow() DO  
                  IF x = 1 THEN
                     DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
                  ELSE
                     DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
                  ENDIF;
                  x = x + 1;
               ENDWHILE;

               DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
               x = 1;
               WHILE x <= IncludedObjects.LastRow() DO  
                  IF x = 1 THEN
                     DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
                  ELSE
                     DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
                  ENDIF;
                  x = x + 1;
               ENDWHILE;
               DynamicWhereClause = DynamicWhereClause + ')';
            ENDIF;

         ENDWHILE;

      ENDFOR;
/*
** Station Grounds - Connected Grounds = Number of grounds to deduct from feeder ground count
*/
   StationGroundCount = StationGroundCount - ConnectedGroundCount;
   
   RETURN (PU_OK);
END;

