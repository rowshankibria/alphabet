*/

INITIALIZE
(
    CompareTime = DATE NOT NULL;
    i	  	= INTEGER NOT NULL WITH DEFAULT;
    RetCode	= INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   DOName = Dop.Description;
   AffTime = DATE('now');
   
   CompareTime = AffTime - '18 hours';
   
   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_Log
   WHERE  Card = :Log$CovidAffirmation AND
          SwitchingItem = 0 AND
          Time > :CompareTime AND
          Operator = :DOp.Object;

   IF i > 0 THEN
      RETURN;
   ENDIF;
END;
/*
**  Handle a Yes click
*/
ON Click YesButton =
BEGIN
      RetCode = CALLPROC SOA_LogInsert(
             Card = Log$CovidAffirmation
        ,    SwitchingItem = 0
        ,    Job = 0
        ,    Time = AffTime
        ,    UserName = UserName
        ,    Item = 'COVID'
        ,    Old = 'Healthcheck'
        ,    New = 'Affirmed'
        ,    Operator = DOp.Object
        ,    OperatorName = DOp.Description
        );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Error logging COVID affirmation, please contact technical support',
                              TraceMessage = VARCHAR(AffTime) + ': Unable to insert COVID affirmation log entry for ' + DOp.Description);
      ENDIF;

   
   RETURN;
END;



