METHOD IssueMove (
   Job   = JobInProgress;
   SetTime = DATE;
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL;
BEGIN
/*
**  If no time was passed default to now.
*/
   IF SetTime = '' THEN
      SetTime = date('now');
   ENDIF;

   RetCode = CALLPROC SOA_IssueMove(Job = Job.Job,
                                    Issued = SetTime,
                                    Operator = FO.Object,
                                    Status = Job.Status
                                   );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error: Unable to issue move.',
                           TraceMessage =
               'Class:JobInProgress;Method:IssueMove; ' +
               'Unable to issue Job ' + VARCHAR(Job.Job) + '.'
               );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF Job.Status = Job$TakeOut THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'TOIssued'
                  , Old             = IFNULL(Job.TOIssued,'')
                  , New             = IFNULL(SetTime,'')
                  );
   ELSEIF Job.Status = Job$Restore THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'RSIssued'
                  , Old             = IFNULL(Job.RSIssued,'')
                  , New             = IFNULL(SetTime,'')
                  );
   ENDIF;

   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
               'Class:JobInProgress;Method:IssueMove; ' +
               'Unable to insert log' +
               ' entry indicating move has been issued for card ' +
                 VARCHAR(Job.Card) + ';Job ' + VARCHAR(Job.Job) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Set values now so they show up on PerformMoves screen
*/
   IF Job.Status = Job$TakeOut THEN
      Job.TOIssued = SetTime;
      Job.TOOperator = FO.Object;
   ELSEIF Job.Status = Job$Restore THEN
      Job.RSIssued = SetTime;
      Job.RSOperator = FO.Object;
   ENDIF;
/*
** If this move has an N move somewhere, update its timestamp
*/
   IF Job.Card <> 0 AND Job.Equip <> 0 THEN
         i = 0;
      
         SELECT :i = Job
         FROM   SOA_Job
         WHERE  Equip = :Job.Equip AND
                MoveCategory = :MoveCategory$Fake AND
                JobClass = :Job.JobClass AND
                lowercase(Status) <> 'del'
         BEGIN
            RetCode = CALLPROC SOA_IssueMove(Job = i,
                                       Issued = SetTime,
                                       Operator = FO.Object,
                                       Status = Job.Status
                                      );
         END;
         IF i > 0 THEN
            CALLPROC DDB_COMMIT;
         ENDIF;
   ENDIF;

   RETURN PU_OK;
END;


METHOD CompleteMove (
   Job   = JobInProgress;
   SetTime = DATE;
   ReturnOp = INTEGER;
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL;
BEGIN
/*
**  If no time was passed default to now.
*/
   IF SetTime = '' THEN
      SetTime = date('now');
   ENDIF;

   IF Job.Status = Job$TakeOut OR (Job.StepPair <> StepHeading$WorkPermit AND Job.StepPair <> StepHeading$TestPermit) THEN
      RetCode = CALLPROC SOA_CompleteMove(Job = Job.Job,
                                       Complete = SetTime,
                                       Status = Job.Status
                                       );
   ELSE
      RetCode = CALLPROC IR_CompletePermit(Job = Job.Job,
                                       RSComplete = SetTime,
                                       RSOperator = IFNULL(ReturnOp,0),
                                       Response = ''
                                       );
      IF RetCode = 0 AND CurrentApplication = Application$DSO THEN  /*Copy completion to TakeOut for display*/
         RetCode = CALLPROC SOA_CompleteMove(Job = Job.Job,
                                       Complete = SetTime,
                                       Status = Job$TakeOut
                                       );
      ENDIF;
   ENDIF;

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error: Unable to complete move.',
                           TraceMessage =
               'Class:JobInProgress;Method:CompleteMove; ' +
               'Unable to complete Job ' + VARCHAR(Job.Job) + '.'
               );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF Job.Status = Job$TakeOut THEN
      RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = date('now') 
                  , UserName        = UserName
                  , Item            = 'TOComplete'
                  , Old             = IFNULL(Job.TOComplete,'')
                  , New             = IFNULL(SetTime,'')
                  );
   ELSEIF Job.Status = Job$Restore THEN
      IF Job.StepPair <> StepHeading$WorkPermit AND Job.StepPair <> StepHeading$TestPermit THEN
         RetCode = CALLPROC FMS_CompletePhaseCheck
                  (Card = Job.Card,
                   CompleteTime = IFNULL(SetTime,''),
                   Equip = Job.Equip);
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           CALLPROC TraceError (UserMessage = '',
                             TraceMessage =
               'Class:JobInProgress;Method:CompleteMove; ' +
               'Unable to complete Phase Check for equip ' + Job.EquipName + '.'
               );
        ENDIF;
        CALLPROC DDB_COMMIT;
      ENDIF;
      
      RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = date('now') 
                  , UserName        = UserName
                  , Item            = 'RSComplete'
                  , Old             = IFNULL(Job.RSComplete,'')
                  , New             = IFNULL(SetTime,'')
                  );
   ENDIF;

   IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        CALLPROC TraceError (UserMessage = '',
                             TraceMessage =
               'Class:JobInProgress;Method:CompleteMove; ' +
               'Unable to insert log' +
               ' entry indicating move has been completed for card ' +
                 VARCHAR(Job.Card) + ';Job ' + VARCHAR(Job.Job) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
**  Set values now so they show up on PerformMoves screen
*/
   IF Job.Status = Job$TakeOut THEN
      Job.TOComplete = SetTime;
   ELSEIF Job.Status = Job$Restore THEN
      Job.RSComplete = SetTime;
   ENDIF;

/*
** If this move has an N move somewhere, update its timestamp
*/
   IF Job.Card <> 0 AND Job.Equip <> 0 THEN
         i = 0;
         SELECT :i = Job
         FROM   SOA_Job
         WHERE  Equip = :Job.Equip AND
                MoveCategory = :MoveCategory$Fake AND
                JobClass = :Job.JobClass AND
                lowercase(Status) <> 'del'
         BEGIN
            RetCode = CALLPROC SOA_CompleteMove(Job = i,
                                          Complete = SetTime,
                                          Status = Job.Status
                                          );
         END;
         IF i > 0 THEN
            CALLPROC DDB_COMMIT;
         ENDIF;
   ENDIF;

   RETURN PU_OK;
END;


METHOD CancelIssueMove (
   Job   = JobInProgress;
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL;
     FOName       = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
   IF Job.Status = Job$TakeOut THEN
      SELECT :FOName = Description
      FROM   UDB_OBJECT
      WHERE  Object = :Job.TOOperator;
   ELSE
      SELECT :FOName = Description
      FROM   UDB_OBJECT
      WHERE  Object = :Job.RSOperator;
   ENDIF;

   RetCode = CALLPROC SOA_IssueMove(Job = Job.Job,
                                    Issued = NULL,
                                    Operator = NULL,
                                    Status = Job.Status
                                   );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ERROR: Unable to cancel issued move.',
                           TraceMessage =
               'Class:JobInProgress;Method:CancelIssueMove; ' +
               'Unable to cancel issued Job ' + VARCHAR(Job.Job) + '.'
               );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF Job.Status = Job$TakeOut THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'TOIssued'
                  , Old             = IFNULL(Job.TOIssued,'')
                  );
      IF RetCode = 0 THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'TOOperator'
                  , Old             = FOName
                  );
      ENDIF;
   ELSEIF Job.Status = Job$Restore THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'RSIssued'
                  , Old             = IFNULL(Job.RSIssued,'')
                  );
      IF RetCode = 0 THEN
         RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'RSOperator'
                  , Old             = FOName
                  );
      ENDIF;
  ENDIF;
  IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:JobInProgress;Method:CancelIssueMove; ' +
               'Unable to insert log' +
               ' entry indicating change to issue timestamp for card ' +
                 VARCHAR(Job.Card) + ';Job ' + VARCHAR(Job.Job) + '.'
               );
  ENDIF;
  CALLPROC DDB_COMMIT;

/*
**  Set values now so they show up on PerformMoves screen
*/
   IF Job.Status = Job$TakeOut THEN
      Job.TOIssued = NULL;
      Job.TOOperator = NULL;
   ELSEIF Job.Status = Job$Restore THEN
      Job.RSIssued = NULL;
      Job.RSOperator = NULL;
   ENDIF;

   RETURN PU_OK;
END;


METHOD InCompleteMove (
   Job   = JobInProgress;
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL;
BEGIN   
   RetCode = CALLPROC SOA_CompleteMove(Job = Job.Job,
                                       Complete = NULL,
                                       Status = Job.Status
                                       );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'ERROR: Unable to incomplete move',
                           TraceMessage =
               'Class:JobInProgress;Method:IncompleteMove; ' +
               'Unable to incomplete move for card ' +
                 VARCHAR(Job.Card) + ';Job ' + VARCHAR(Job.Job) + '.'
               );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF Job.Status = Job$TakeOut THEN
      RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'TOComplete'
                  , Old             = IFNULL(Job.TOComplete,'')
                  );
   ELSEIF Job.Status = Job$Restore THEN
      RetCode = CALLPROC SOA_LogIns (
                    Card            = Job.Card
                  , Job             = Job.Job
                  , SwitchingItem   = Job.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'RSComplete'
                  , Old             = IFNULL(Job.RSComplete,'')
                  );
   ENDIF;

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:JobInProgress;Method:IncompleteMove; ' +
               'Unable to insert log' +
               ' entry for incomplete move on card ' +
                 VARCHAR(Job.Card) + ';Job ' + VARCHAR(Job.Job) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
**  Set values now so they show up on PerformMoves screen
*/
   IF Job.Status = Job$TakeOut THEN
      Job.TOComplete = NULL;
   ELSEIF Job.Status = Job$Restore THEN
      Job.RSComplete = NULL;
   ENDIF;

   RETURN PU_OK;
END;


METHOD JobChecks 
(
   IssueCompl = INTEGER NOT NULL;   /* 0 = Issue, 1 = Complete */
) =
DECLARE
   i = Integer;			/* Scratch counter */
   j = Integer;			/* Scratch counter */
   k = INTEGER;
   CheckProc  = Varchar(40) NOT NULL WITH DEFAULT;  /*CheckProcName*/
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   FeederSegmentRepeat = INTEGER NOT NULL WITH DEFAULT;   /*Present only one 33kV feeder segment warning*/
   ISWP = INTEGER NOT NULL;     /* Is this an In Service WP */
   InServicePermitEquip = INTEGER NOT NULL;
   NotifCount = INTEGER NOT NULL;      /* Count of notifications */
   Operator = INTEGER;          /* Operator to use for pending check*/
   OverrideReason = VARCHAR(60);       /*TextString*/
   OverRodeWarning = INTEGER NOT NULL WITH DEFAULT;
   PEquip = ARRAY OF IntegerObject;
   RetCode = INTEGER;                  /* ReturnCode*/
   SearchObjects = ARRAY OF ObjectSummaryClass;  /*ObjectID*/
   SDObjects = ObjectSummaryClass;  /*ObjectID*/
   TempObject = ObjectSummaryClass;  /*ObjectID*/
   SearchItem = VARCHAR(18) NOT NULL WITH DEFAULT; /*ObjectType*/ 
   SearchStatus = VARCHAR(40) NOT NULL WITH DEFAULT; /*TypeName*/
   SelectCount = INTEGER;              /* SelectionResult*/
   SkipWarning = INTEGER NOT NULL WITH DEFAULT;
   ToRs = INTEGER NOT NULL WITH DEFAULT;
   TypeDescription = VARCHAR(60) NOT NULL WITH DEFAULT;
   WarningEquip = VARCHAR(60) NOT NULL WITH DEFAULT;
BEGIN
   OverRodeWarning = FALSE;
/*
** Do not do any checks if in Process Automation Setup Mode
*/  
    IF ProcessAutoMode = TRUE THEN
       RETURN(PU_OK);
    ENDIF;
/*
**   Check to see if equipment has been picked up
*/
    IF CurObject.ActivityIdentifier = 'N' AND 
         IssueCompl = JobClass$Issue  AND
         CurrentApplication = Application$FMS AND
         AutomaticExecution = FALSE THEN
       MESSAGE 'You must first pickup equipment from the Dropped Bank, ' +
               'New Bank or ISO Feeder before issuing this move.';
       RETURN(PU_CANCEL); 
    ENDIF;
/*
**  Ensure the takeout side has been issued/completed if user is restoring.
*/
   IF CurObject.Status = Job$Restore AND 
       (CurObject.TOIssued IS NULL OR CurObject.TOComplete IS NULL) THEN 
/*
**  OK to issue restore if takeout is issued to the same operator.
**  Since we may be issuing the Restore in the same Perform Moves session
**  as the TakeOut, our TOIssued and TOOperator fields might not be current 
**  since the two moves are separate objects, i.e. our Restore CurObject was
**  not updated when the previous move object was TakeOut Issued.
**  We therefore reselect the fields here before determining whether to
**  present a warning. 
*/
      SELECT :CurObject.TOIssued = TOIssued,
             :CurObject.TOOperator = TOOperator
      FROM   SOA_Job
      WHERE  Job = :CurObject.Job;

      IF IssueCompl = JobClass$Issue AND 
           (CurObject.TOIssued IS NOT NULL AND CurObject.TOIssued <> '') AND
            CurObject.TOOperator = CurObject.RSOperator THEN
/*  
**  No warning necessary, this is okay for TFMS/SLC.  Will be merged into FMS
**  when systems are merged.
*/
      ELSE     
         RetCode = CALLFRAME Warning (
           Card = CurObject.Card,
           SwitchingItem = CurObject.SwitchingItem,
           Job = CurObject.Job,
           Text = 'The takeout side has not been completed.');

         IF RetCode = PU_CANCEL THEN
            RETURN PU_CANCEL;
         ELSE
            OverRodeWarning = TRUE;
         ENDIF;
      ENDIF;
   ENDIF;  
/*   
**  If this is a Test Permit, check that all work permits at this 
**  substation are signed off or tabled.
*/
   IF CurObject.StepPair = StepHeading$TestPermit AND 
      IssueCompl = JobClass$Issue THEN

      SelectCount = 0;  
      REPEATED
      SELECT :SelectCount = COUNT(*)
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :CurObject.Card AND
             JC.StepPair = :StepHeading$WorkPermit AND
             JC.Job = J.Job AND
             J.Substation = :CurObject.Substation AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.TOIssued IS NOT NULL AND
             J.RSComplete IS NULL AND
             J.Status = ''; 
      
      IF SelectCount > 0 THEN
         RetCode = CALLFRAME Warning (
              Card = CurObject.Card,
              SwitchingItem = CurObject.SwitchingItem,
              Job = CurObject.Job,
              Text = 'Not all Work Permits at this substation have been ' + 
                     'tabled or signed off.');
         IF RetCode = PU_CANCEL THEN
            RETURN PU_CANCEL;
         ELSE
            OverRodeWarning = TRUE;
         ENDIF;
      ENDIF;
   ENDIF;
/*   
**   For Work Permit, make sure linked Protection Move has been completed.
*/
   IF (CurObject.StepPair = StepHeading$WorkPermit OR
       CurObject.StepPair = StepHeading$TestPermit)  AND
       IssueCompl = JobClass$Issue THEN

      RetCode = CALLPROC ProtectionMoveClearCheck (
                  Job = CurObject.Job,
                  Card = CurObject.Card,
                  SwitchingItem = CurObject.SwitchingItem);
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSEIF RetCode = Warning$Overridden THEN
         OverRodeWarning = TRUE;
      ENDIF;
   ENDIF;
/*
**  For Restore Protection move, make sure linked Work Permit has been cleared.
*/
   IF (CurObject.Status = Job$Restore AND IssueCompl = JobClass$Issue) OR
       CurrentApplication = Application$DSO THEN
      
      RetCode = CALLPROC WorkPermitClearCheck (
                  Job = CurObject.Job,
                  Card = CurObject.Card,
                  SwitchingItem = CurObject.SwitchingItem);
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSEIF RetCode = Warning$Overridden THEN
         OverRodeWarning = TRUE;
      ENDIF;
   ENDIF;   
/*
**   Common Equipment work permit checks.
*/
   IF CurrentApplication = Application$FMS AND
      CurObject.Equip <> EquipClass$None AND
      IssueCompl = JobClass$Issue THEN

      i = 0;
      REPEATED
      SELECT :i = COUNT(*)
      FROM   FMS_ObjectStatus OS,
             Udb_Grouping G,
             Udb_ExtendedType ET,
             SOA_ActiveObject AO
      WHERE  G.Member = :CurObject.Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Feeder AND
             G.Grouping = AO.Object AND
             AO.Card <> :CurObject.Card AND
             G.Grouping = OS.Object AND
             OS.StatusCount > 0 AND
             OS.Status = :Status$OTW;

      IF i > 0 THEN
         RetCode  = CALLFRAME Warning (
                       Card = CurObject.Card, 
                       Job = CurObject.Job,
                       SwitchingItem = CurObject.SwitchingItem,
                       Text = 'Associated Feeder (common equipment) ' +
                           'is Out To Work.');
         IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
         ELSE
             OverRodeWarning = True;
         ENDIF;      
      ENDIF;

   ENDIF;  
/*
**  Get jobchecks for all types of moves where this job exists.
*/
   CurObject.JobCheck.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.JobCheck[i].JobClass = JC.JobClass,
          :CurObject.JobCheck[i].FeederEquip = JC.FeederEquip,
          :CurObject.JobCheck[i].ToRs = JC.ToRs,
          :CurObject.JobCheck[i].IssueCompl = JC.IssueCompl,
          :CurObject.JobCheck[i].JobCheck = JC.JobCheck,
          :CurObject.JobCheck[i].Status = JC.Status
   FROM   FMS_JobCheck JC,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JC.TypeofCard AND
          JC.JobClass = :CurObject.JobClass AND
          JC.EquipClass = J.MoveEquipClass AND
          JC.StepPair  = J.StepPair  
   ORDER BY FeederEquip DESC
   BEGIN
      i = i + 1;
   END;            
/*
**  For test environment only 4/26/2018.
**  If Card is a Known Point ISO and move is not shared, load job checks only for ISO TypeofCard
*/
   IF CardDetails.TypeOfCard = TypeOfCard$13kV AND 
      CardDetails.CardClass = Type$ISO AND 
      CurObject.ActivityIdentifier <> 'S' THEN
   CurObject.JobCheck.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.JobCheck[i].JobClass = JC.JobClass,
          :CurObject.JobCheck[i].FeederEquip = JC.FeederEquip,
          :CurObject.JobCheck[i].ToRs = JC.ToRs,
          :CurObject.JobCheck[i].IssueCompl = JC.IssueCompl,
          :CurObject.JobCheck[i].JobCheck = JC.JobCheck,
          :CurObject.JobCheck[i].Status = JC.Status
   FROM   FMS_JobCheck JC,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          JC.TypeOfCard = :Type$ISOCard AND
          JC.JobClass = :CurObject.JobClass AND
          JC.EquipClass = J.MoveEquipClass AND
          JC.StepPair  = J.StepPair  
   ORDER BY FeederEquip DESC
   BEGIN
      i = i + 1;
   END;            
   ENDIF;
/*
**  Set ToRs based on status field.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
      CurObject.ToRs = 0;
   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
      CurObject.ToRs = 1;
   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:JobChecks; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
   ENDIF;
/*
**  If this is an ISWP, skip JobChecks and go ot override analysis
*/
   ISWP = 0;
   InServicePermitEquip = 0;
   IF CurrentApplication = Application$SLC THEN
       SELECT :InServicePermitEquip = PhaseCheckIndicator
       FROM   SOA_WorkPermit
       WHERE  PermitJobId = :CurObject.Job;

       IF InServicePermitEquip = 0 THEN 
          SELECT  :ISWP = ISPermit
          FROM    SOA_InServicePermit
          WHERE   Job = :CurObject.Job;

          IF ISWP <> 0 THEN
             CurObject.JobCheck.Clear();
          ENDIF;
      ENDIF;
   ENDIF;
/*
**  Loop through JobChecks, perform necessary checks; All Checks will
**  be performed, unless cancelled, and a final procedure return code 
**  established.  
*/
   i = 1;
   WHILE i <= CurObject.JobCheck.LastRow() DO

      IF CurObject.JobCheck[i].ToRs = ToRs AND    /*Check for TakeOut/Restore*/
         CurObject.JobCheck[i].IssueCompl = IssueCompl THEN /* and issue/complete */
   
         IF CurObject.JobCheck[i].FeederEquip <> 0 THEN
#           include GetJCSearchObjects          
         ENDIF;

         IF CurObject.JobCheck[i].JobCheck = Type$Warning THEN
            IF AutomaticExecution = FALSE THEN

               SELECT :TypeDescription = Description
               FROM   Udb_Type
               WHERE  Type = :Curobject.JobCheck[i].Status;

               RetCode  = CALLFRAME Warning (
                          Card = CurObject.Card, 
                          Job = CurObject.Job,
                          SwitchingItem = CurObject.SwitchingItem,
                          Text = TypeDescription);
               IF RetCode = PU_CANCEL THEN
                  RETURN(PU_CANCEL);
               ELSE
                  OverRodeWarning = TRUE;
               ENDIF;
            
            ENDIF;
         ELSEIF Curobject.JobCheck[i].JobCheck = Type$Confirm THEN
            IF AutomaticExecution = FALSE THEN

            SELECT :TypeDescription = Description
            FROM   Udb_Type
            WHERE  Type = :Curobject.JobCheck[i].Status;
  
            RetCode = CALLFRAME Confirm (
                           Card = CurObject.Card, 
                           Job = CurObject.Job,
                           SwitchingItem = CurObject.SwitchingItem,
                           Text = TypeDescription);
            IF RetCode = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ENDIF;
   
            ENDIF;
         ELSEIF Curobject.JobCheck[i].JobCheck = JobCheck$PreCheck THEN

            SELECT :CheckProc = Name              /*Get Procedure Name*/
            FROM   Udb_Type
            WHERE  Type = :Curobject.JobCheck[i].Status;

            CheckProc = Squeeze('Check' + :CheckProc);

            RetCode = CALLPROC :CheckProc (JIP = CurObject);
             
            IF RetCode = PU_CANCEL THEN
              RETURN(PU_CANCEL);
              ENDLOOP;
            ELSEIF RetCode = Warning$Overridden THEN
              OverRodeWarning = TRUE;
            ENDIF;

         ELSEIF Curobject.JobCheck[i].JobCheck = JobCheck$Exists OR 
                 Curobject.JobCheck[i].JobCheck = JobCheck$AdjExists THEN
             
            j = 1;
            FeederSegmentRepeat = FALSE;
            WHILE j <= SearchObjects.LastRow() DO
  
               SelectCount = 0;                     /*Check for existence */
               REPEATED
               SELECT :SelectCount = Count(*)
               FROM   FMS_ObjectStatus OS,
                      Udb_ExtendedType ET 
               WHERE  OS.Object = :SearchObjects[j].Object AND
                      OS.Status = ET.Type AND 
                      ET.SuperType = :Curobject.JobCheck[i].Status AND 
                      OS.StatusCount > 0; 

               IF SelectCount = 0 THEN

                  IF IssueCompl = JobClass$Issue THEN
                     IF CurObject.Status = Job$Restore THEN
                        Operator = CurObject.RSOperator;
                     ELSE
                        Operator = CurObject.TOOperator;
                     ENDIF;
 
                     REPEATED
                     SELECT :SelectCount = Count(*)
                     FROM   FMS_PendingStatus PS,
                            Udb_ExtendedType ET 
                     WHERE  PS.Object = :SearchObjects[j].Object AND
                            PS.IssuedOperator = :Operator AND
                            PS.StatusCount > 0 AND
                            PS.PendingStatus = ET.Type AND
                            ET.SuperType = :CurObject.JobCheck[i].Status; 
                  ENDIF;
                
                  IF SelectCount = 0 THEN
                     IF MicroGridOpen = TRUE THEN
                        SkipWarning = FALSE;
                        SELECT :SkipWarning = :TRUE 
                        FROM   Udb_Grouping G,
                               Udb_Grouping G2,
                               Udb_ExtendedType ET
                        WHERE  G.Member = :CurObject.Equip AND
                               G.Relationship = :Interaction$DownstreamFrom AND
                               G.Grouping = G2.Member AND
                               G2.Relationship = :Interaction$MicroGridFor AND
                               G2.Groupingtype = ET.Type AND
                               ET.SuperType = :Type$Feeder;
                        /* 
                        ** This may be a To: FCR permit with equipment = 0.  Look at all
                        ** protection move and if all are downstreamfrom Micro Grid then 
                        ** ignore warnings.
                        */       
                        IF SkipWarning = FALSE AND
                           CurObject.StepPair = StepHeading$WorkPermit AND
                           CurObject.Equip = EquipClass$None THEN
                           
                           k = 1;
                           PEquip.Clear();
                           SELECT :PEquip[k].Value = J.Equip
                           FROM    FMS_WorkPermitProtection WPP,
                                   SOA_Job J
                           WHERE   WPP.PermitJobId = :CurObject.Job AND
                                   WPP.ProtectionJobId = J.Job
                           BEGIN
                              k = k + 1;
                           END;
                           
                           k = 1;
                           WHILE k <= PEquip.LastRow DO
                              SelectCount = 0;
                              SELECT :SelectCount = COUNT(*)
                              FROM   Udb_Grouping G,
                                     Udb_Grouping G2,
                                     Udb_ExtendedType ET
                              WHERE  G.Member = :PEquip[k].Value AND
                                     G.Relationship = :Interaction$DownstreamFrom AND
                                     G.Grouping = G2.Member AND
                                     G2.Relationship = :Interaction$MicroGridFor AND
                                     G2.Groupingtype = ET.Type AND
                                     ET.SuperType = :Type$Feeder;
                              /*
                              **  Confirm each equipment is downstream from micro grid line equipment
                              */
                              IF SelectCount = 0 THEN
                                 /*
                                 **  Equipment not downstream of micro grid.  If it is new equipment
                                 **  not yet on any feeder warning can still be skipped.
                                 */
                                 SELECT :SelectCount = COUNT(*)
                                 FROM   Udb_Grouping G,
                                        Udb_ExtendedType ET
                                 WHERE  G.Member = :PEquip[k].Value AND
                                        G.Relationship = :Interaction$MemberOf AND
                                        G.GroupingType = ET.Type AND
                                        ET.SuperType = :Type$Feeder;
                                 IF SelectCount <> 0 THEN 
                                    ENDLOOP;
                                 ENDIF;
                              ENDIF;
                              k = k + 1;
                           ENDWHILE;
                           IF k > PEquip.LastRow AND
                              PEquip.LastRow > 0 THEN
                              SkipWarning = TRUE;
                           ENDIF;
                        ENDIF;
                     ENDIF;
                     
                     /*
                     **  Don't display DBF warnings when MTA Isolation switch or 
                     **  Micro Grid Line is open.
                     **  MTAOpen and MicroGridOpen are set in UpdateCardColor2 in 
                     **  Feedercard frame.
                     */    
                     IF MTAOpen = TRUE AND
                            CurObject.JobCheck[i].Status = Status$DBF THEN
                        /* do nothing */
                     ELSEIF MicroGridOpen = TRUE AND
                            SkipWarning = TRUE AND
                           (CurObject.JobCheck[i].Status = Status$DBF OR
                            CurObject.JobCheck[i].Status = Status$StationGround OR
                            CurObject.JobCheck[i].Status = Status$CO) THEN
                        /* do nothing */
                     ELSE

                        SELECT :SearchStatus = Name
                        FROM   Udb_Type
                        WHERE  Type = :Curobject.JobCheck[i].Status;

                        IF SearchItem = 'Feeder' AND CardDetails.NetworkFeeder = NetworkFeeder$33kV THEN
                           IF FeederSegmentRepeat = TRUE THEN
                              j = j + 1;
                              CONTINUE;
                           ELSE
                              FeederSegmentRepeat = TRUE;
                              IF SearchObjects[j].TypeName = 'Feeder' THEN
                                 WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                              ELSE
                                 REPEATED
                                 SELECT :SearchObjects[j].Name = O.Name
                                 FROM   Udb_Object O,
                                        Udb_Grouping G
                                 WHERE  O.Object = G.Grouping AND
                                        G.GroupingType = :Type$Feeder AND
                                        G.Relationship = :Interaction$MemberOf AND
                                        G.Member = :SearchObjects[j].Object;
                                 WarningEquip = SearchObjects[j].Name + ' Feeder Segment';
                              ENDIF;
                           ENDIF;
                        ELSEIF SearchItem = SearchObjects[j].TypeName THEN
                           WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                        ELSE
                           WarningEquip = SearchItem + ' ' + SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                        ENDIF;

                        RetCode  = CALLFRAME Warning (
                            Card = CurObject.Card, 
                            Job = CurObject.Job,
                            SwitchingItem = CurObject.SwitchingItem,
                            Text = WarningEquip + ' does not have a status of ' + :SearchStatus); 
                        IF RetCode = PU_CANCEL THEN
                           RETURN(PU_CANCEL);
                        ELSE
                           OverRodeWarning = TRUE;
                        ENDIF;
                     ENDIF;
                  ENDIF;
               ENDIF;
               j = j + 1;
            ENDWHILE;

         ELSEIF Curobject.JobCheck[i].JobCheck = JobCheck$DoesNotExist OR
                 Curobject.JobCheck[i].JobCheck = JobCheck$AdjNotExist THEN

            j = 1;
            FeederSegmentRepeat = FALSE;
            WHILE j <= SearchObjects.LastRow() DO

               SelectCount = 0;                     /*Check for lack of existence*/
               REPEATED
               SELECT :SelectCount = StatusCount
               FROM   FMS_ObjectStatus OS,
                      Udb_ExtendedType ET 
               WHERE  OS.Object = :SearchObjects[j].Object AND
                      OS.Status = ET.Type AND 
                      OS.StatusCount > 0 AND
                      ET.SuperType = :Curobject.JobCheck[i].Status; 

               IF SelectCount > 0 AND iirowcount > 0 THEN
/* 
** Check that removal of status isn't pending before giving warning
*/
                  SelectCount = 0;
                  IF IssueCompl = JobClass$Issue THEN
                     IF CurObject.Status = Job$Restore THEN
                        Operator = CurObject.RSOperator;
                     ELSE
                        Operator = CurObject.TOOperator;
                     ENDIF;
 
                     REPEATED
                     SELECT :SelectCount = Count(*)
                     FROM   FMS_PendingStatus PS,
                            Udb_ExtendedType ET 
                     WHERE  PS.Object = :SearchObjects[j].Object AND
                            PS.IssuedOperator = :Operator AND
                            PS.StatusCount = 0 AND
                            PS.PendingStatus = ET.Type AND
                            ET.SuperType = :CurObject.JobCheck[i].Status; 
                  ENDIF;
                
                  IF SelectCount = 0 THEN
 
                     SELECT :SearchStatus = Name
                     FROM   Udb_Type
                     WHERE  Type = :CurObject.JobCheck[i].Status;

                     IF SearchItem = 'Feeder' AND CardDetails.NetworkFeeder = NetworkFeeder$33kV THEN
                        IF FeederSegmentRepeat = TRUE THEN
                           j = j + 1;
                           CONTINUE;
                        ELSE
                           FeederSegmentRepeat = TRUE;
                           IF SearchObjects[j].TypeName = 'Feeder' THEN
                              WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                           ELSE
                              REPEATED
                              SELECT :SearchObjects[j].Name = O.Name
                              FROM   Udb_Object O,
                                     Udb_Grouping G
                              WHERE  O.Object = G.Grouping AND
                                     G.GroupingType = :Type$Feeder AND
                                     G.Relationship = :Interaction$MemberOf AND
                                     G.Member = :SearchObjects[j].Object;
                              WarningEquip = SearchObjects[j].Name + ' Feeder Segment';
                           ENDIF;
                        ENDIF;
                     ELSEIF SearchItem = SearchObjects[j].TypeName THEN
                        WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                     ELSE
                        WarningEquip = SearchItem + ' ' + SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                     ENDIF;

                     RetCode  = CALLFRAME Warning (
                       Card = CurObject.Card, 
                       Job = CurObject.Job,
                       SwitchingItem = CurObject.SwitchingItem,
                       Text = WarningEquip + ' has a status of ' + :SearchStatus); 
                     IF RetCode = PU_CANCEL THEN
                        RETURN(PU_CANCEL);
                     ELSE
                        OverRodeWarning = TRUE;
                     ENDIF;
                  ENDIF;
               ENDIF;
            
               j = j + 1;
            ENDWHILE;

         ELSEIF Curobject.JobCheck[i].JobCheck = JobCheck$EqualOne OR
                 Curobject.JobCheck[i].JobCheck = JobCheck$AdjEqualOne THEN

            j = 1;
            FeederSegmentRepeat = FALSE;
            WHILE j <= SearchObjects.LastRow() DO

               SelectCount = 0;                /*Check for Count = 1 */
               SELECT :SelectCount = StatusCount
               FROM   FMS_ObjectStatus 
               WHERE  Object = :SearchObjects[j].Object AND
                      Status = :CurObject.JobCheck[i].Status AND
                      StatusCount = 1; 

               IF SelectCount <> 1 THEN
/* 
** Check for pending status = 1
*/
                  IF IssueCompl = JobClass$Issue THEN
                     IF CurObject.Status = Job$Restore THEN
                        Operator = CurObject.RSOperator;
                     ELSE
                        Operator = CurObject.TOOperator;
                     ENDIF;
 
                     SelectCount = 0;
                     REPEATED
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_PendingStatus PS,
                            Udb_ExtendedType ET 
                     WHERE  PS.Object = :SearchObjects[j].Object AND
                            PS.IssuedOperator = :Operator AND
                            PS.StatusCount = 1 AND
                            PS.PendingStatus = ET.Type AND
                            ET.SuperType = :CurObject.JobCheck[i].Status; 
                  ENDIF;
                
                  IF SelectCount <> 1 THEN

                     SELECT :SearchStatus = Name
                     FROM   Udb_Type
                     WHERE  Type = :CurObject.JobCheck[i].Status;

                     IF SearchItem = 'Feeder' AND CardDetails.NetworkFeeder = NetworkFeeder$33kV THEN
                           IF FeederSegmentRepeat = TRUE THEN
                              j = j + 1;
                              CONTINUE;
                           ELSE
                              FeederSegmentRepeat = TRUE;
                              IF SearchObjects[j].TypeName = 'Feeder' THEN
                                 WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                              ELSE
                                 REPEATED
                                 SELECT :SearchObjects[j].Name = O.Name
                                 FROM   Udb_Object O,
                                        Udb_Grouping G
                                 WHERE  O.Object = G.Grouping AND
                                        G.GroupingType = :Type$Feeder AND
                                        G.Relationship = :Interaction$MemberOf AND
                                        G.Member = :SearchObjects[j].Object;
                                 WarningEquip = SearchObjects[j].Name + ' Feeder Segment';
                              ENDIF;
                           ENDIF;
                     ELSEIF SearchItem = SearchObjects[j].TypeName THEN
                        WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                     ELSE
                        WarningEquip = SearchItem + ' ' + SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                     ENDIF;

                     RetCode  = CALLFRAME Warning (
                        Card = CurObject.Card, 
                        Job = CurObject.Job,
                        SwitchingItem = CurObject.SwitchingItem,
                        Text =  WarningEquip + ' ' + :SearchStatus + ' count is not equal to 1'); 
                     IF RetCode = PU_CANCEL THEN
                        RETURN(PU_CANCEL);
                     ELSE
                        OverRodeWarning = TRUE;
                     ENDIF;
                  ENDIF;
               ENDIF;
   
               j = j + 1;
            ENDWHILE;

         ELSEIF CurObject.JobCheck[i].JobCheck = JobCheck$GreaterThanOne OR
                 CurObject.JobCheck[i].JobCheck = JobCheck$AdjGreaterOne THEN
           
            j = 1;
            FeederSegmentRepeat = FALSE;
            WHILE j <= SearchObjects.LastRow() DO
          
               /*
               **  We are looking for Feeder Ground count > 1, but it is possible that 
               **  some moves were issued in the same block that are removing ground
               **  for equipment and the feeder ground status won't be updated until
               **  those moves are completed.
               */
               IF CurObject.JobCheck[i].Status = Status$FeederGround THEN
                  /*
                  **  Find out how many FeederGrounds on Feeder
                  */
                  SelectCount = 0;               
                  SELECT :SelectCount = StatusCount
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[j].Object AND
                         Status = :CurObject.JobCheck[i].Status; 
                  /*
                  **  Look for equipment on Feeder in Pending status.
                  */
                  IF CurObject.Status = Job$Restore THEN
                     Operator = CurObject.RSOperator;
                  ELSE
                     Operator = CurObject.TOOperator;
                  ENDIF;

                  SELECT DISTINCT
                         :TempObject.Object = J.Equip,
                         :TempObject.Type = IFNULL(J.Grounds,0),
                         :TempObject.BaseType = IFNULL(PS.StatusCount,0)
                  FROM    SOA_Job J,
                          SOA_JobControl JC,
                          FMS_PendingStatus PS,
                          TFMS_CardToObject CTO
                  WHERE   CTO.Object = :SearchObjects[j].Object AND
                          CTO.Card = JC.Card AND
                          JC.Job = J.Job AND
                          J.Status = '' AND
                          J.Equip = PS.Object AND
                          PS.PendingStatus = :Status$Ground AND
                          PS.IssuedOperator = :Operator
                  BEGIN 
                     SelectCount = SelectCount + (TempObject.BaseType - TempObject.Type);
                  END;
                  
                  IF SelectCount <= 1 THEN
                     SelectCount = 0;
                  ENDIF;
               ELSE
                  SelectCount = 0;                /*Check for Count > 1 */
                  SELECT :SelectCount = Count(*)
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[j].Object AND
                         Status = :CurObject.JobCheck[i].Status AND
                         StatusCount > 1; 
               ENDIF;

               IF SelectCount = 0 THEN
                  IF CurObject.JobCheck[i].Status = Status$FeederGround THEN
                     /*
                     **  When looking for grounds, check if this card has a link 
                     **  to 4kv StepDown cards and combine counts for both cards.
                     **  Only check if SD-VIS AND SDLoadElbow are both closed.
                     */
                     SelectCount = 0;
                     SELECT :SelectCount = COUNT(*) 
                     FROM    FMS_StepDownLink L,
                             Udb_Switch S,
                             Udb_Grouping G,
                             SOA_ActiveObject AO,
                             TFMS_CardToObject CTO2
                     WHERE  AO.Object = :SearchObjects[j].Object AND
                           (AO.Card = L.Card OR
                            AO.Card = L.StepDownCard) AND
                            L.StepDownCard = CTO2.Card AND
                            CTO2.Object = G.Grouping AND
                            G.Relationship = :Interaction$MemberOf AND
                            G.MemberType in (:Type$SDVIS,:Type$SDLoadElbow) AND
                            G.Member = S.Object AND
                            S.CurrentlyOpen = 0;
                  
                     IF SelectCount = 2 THEN  
                        /* 
                        ** Both devices are closed.  Now check grounds on all feeders involved.
                        */
                        SELECT :SelectCount = Sum(StatusCount) 
                        FROM   FMS_ObjectStatus OS,
                               FMS_StepDownLink L,
                               SOA_ActiveObject AO,
                               TFMS_CardToObject CTO2
                        WHERE  AO.Object = :SearchObjects[j].Object AND
                              (AO.Card = L.Card OR
                               AO.Card = L.StepDownCard) AND 
                              (L.Card = CTO2.Card OR
                               L.StepDownCard = CTO2.Card) AND
                               CTO2.Object = OS.Object AND
                               OS.Status = :CurObject.JobCheck[i].Status;
                        IF SelectCount > 1 THEN
                           j = j + 1;
                           CONTINUE;  /* Do not present warning */
                        ELSE
                           SelectCount = 0;
                        ENDIF;
                     ENDIF; 
                  ENDIF;
/* 
** Check for pending status > 1
*/
                  IF IssueCompl = JobClass$Issue THEN
                     IF CurObject.Status = Job$Restore THEN
                        Operator = CurObject.RSOperator;
                     ELSE
                        Operator = CurObject.TOOperator;
                     ENDIF;
 
                     SelectCount = 0;
                     REPEATED
                     SELECT :SelectCount = Count(*)
                     FROM   FMS_PendingStatus PS,
                            Udb_ExtendedType ET 
                     WHERE  PS.Object = :SearchObjects[j].Object AND
                            PS.IssuedOperator = :Operator AND
                            PS.StatusCount > 1 AND
                            PS.PendingStatus = ET.Type AND
                            ET.SuperType = :CurObject.JobCheck[i].Status; 
                  ENDIF;

                  IF SelectCount = 0 THEN
                     /*
                     **  Don't display ground warnings when MTA Isolation switch is open.
                     **  MTAOpen is set in UpdateCardColor2 in Feedercard frame.
                     */    
                     IF MTAOpen = TRUE AND
                        CurObject.JobCheck[i].Status = Status$FeederGround THEN
                        /* do nothing */
                     ELSE
                        SELECT :SearchStatus = Name
                        FROM   Udb_Type
                        WHERE  Type = :CurObject.JobCheck[i].Status;

                        IF SearchItem = 'Feeder' AND CardDetails.NetworkFeeder = NetworkFeeder$33kV THEN
                           IF FeederSegmentRepeat = TRUE THEN
                              j = j + 1;
                              CONTINUE;
                           ELSE
                              FeederSegmentRepeat = TRUE;
                              IF SearchObjects[j].TypeName = 'Feeder' THEN
                                 WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                              ELSE
                                 REPEATED
                                 SELECT :SearchObjects[j].Name = O.Name
                                 FROM   Udb_Object O,
                                        Udb_Grouping G
                                 WHERE  O.Object = G.Grouping AND
                                        G.GroupingType = :Type$Feeder AND
                                        G.Relationship = :Interaction$MemberOf AND
                                        G.Member = :SearchObjects[j].Object;
                                 WarningEquip = SearchObjects[j].Name + ' Feeder Segment';
                              ENDIF;
                           ENDIF;
                        ELSEIF SearchItem = SearchObjects[j].TypeName THEN
                           WarningEquip = SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                        ELSE
                           WarningEquip = SearchItem + ' ' + SearchObjects[j].TypeName + ' ' + SearchObjects[j].Name;
                        ENDIF;

                        RetCode  = CALLFRAME Warning (
                           Card = CurObject.Card, 
                           Job = CurObject.Job,
                           SwitchingItem = CurObject.SwitchingItem, 
                           Text = WarningEquip + ' ' + :SearchStatus + ' count is not greater than 1.');
                        IF RetCode = PU_CANCEL THEN
                           RETURN(PU_CANCEL);
                        ELSE
                           OverRodeWarning = TRUE;
                        ENDIF;
                     ENDIF;
                  ENDIF;
               ENDIF;
 
               j = j + 1;
            ENDWHILE;

         ELSE                   /* Unknown Check */
            CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:JobInProgress;Method:JobChecks; ' +
               'Bad data in JobCheck table for Job ' + 
                VARCHAR(CurObject.Job) + '; Unknown Job Check ' +
                varchar(Curobject.JobCheck[i].JobCheck) + '.'
               );
         ENDIF; 
      ENDIF;

      i = i + 1;
   ENDWHILE;     

   IF OverRodeWarning = TRUE AND AutomaticExecution = FALSE THEN 

      OverRideReason = CALLFRAME Override (
            Card = CurObject.Card, 
            Job = CurObject.Job,
            SwitchingItem = CurObject.SwitchingItem);
      IF OverRideReason IS NULL THEN /* They hit cancel */
         RETURN(PU_CANCEL);
      ENDIF; 

   ENDIF;
/*
** Count the number of notification records for the move to be
** issued. Prompt for notification if at least one was found.
*/
   IF IssueCompl = JobClass$Issue AND AutomaticExecution = FALSE THEN
       NotifCount = 0;
       SELECT :NotifCount = COUNT(*)
       FROM FMS_Notifications N
       WHERE N.Job = :CurObject.Job
         AND N.PrePost = :JobCheck$Precheck
         AND N.ToRs = :ToRs;
       CALLPROC DDB_ROLLBACK;

       IF NotifCount > 0 THEN
           CALLFRAME NotificationsPrompt (JIP = CurObject,
                                          Card = CurObject.Card,
                                          ToRs = IFNULL(ToRs,0),
                                          PrePost = JobCheck$Precheck);
       ENDIF; 
   ENDIF;
/*
** Call ProtectionCheckConfirm for all work permit moves.
*/
   IF AutomaticExecution = FALSE AND 
        IssueCompl = JobClass$Issue AND
        CurObject.StepPair = StepHeading$WorkPermit THEN

      RetCode = CALLFRAME ProtectionCheckConfirm (
                         Card = CurObject.Card, 
                         SwitchingItem = CurObject.SwitchingItem,
                         Job = CurObject.Job);
    
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ENDIF;
   ENDIF;

   RETURN(PU_OK);
END;


METHOD JobActions 
(
   InTerminal = INTEGER NOT NULL WITH DEFAULT; /*If we already know terminal*/
   IssueCompl = INTEGER NOT NULL;   /* 0 = Issue, 1 = Complete */
   NoCard     = INTEGER NOT NULL WITH DEFAULT; /*Pass True if this job is not on a card */
   NoPrompts  = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Prompts */
   NoLineSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Line acts */
   NoFeederSt = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Fdr acts */
   NoStatSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Prompts */
   NoEquipSt  = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Equip acts*/
   NoOperSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip OpStep acts*/
   SingleFeederOnly = INTEGER NOT NULL WITH DEFAULT; /*passed limiting parm*/
) =
DECLARE
   ActionInt = INTEGER NOT NULL WITH DEFAULT; 
   C = CardSOA;
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   EquipASE = EquipClass_ASE;
   FedBy = INTEGER NOT NULL;
   Feeder = INTEGER NOT NULL;
   FeederName = VARCHAR(40) NOT NULL;     /*TextString */
   ISWP = INTEGER NOT NULL WITH DEFAULT;  /* Is this and In Service WP */
   InServicePermitEquip = INTEGER NOT NULL WITH DEFAULT;  /* Is this and In Service WP */
   i = Integer NOT NULL;	/* Scratch counter */
   j = Integer;			/* Scratch counter */
   k = Integer;			/* Scratch counter */
   MoveText = VARCHAR(160) NOT NULL WITH DEFAULT;
   NotifCount = INTEGER NOT NULL;      /* Count of notifications */
   OverrideReason = VARCHAR(60);       /*TextString */
   OverRodeWarning = INTEGER NOT NULL WITH DEFAULT;
   PromptFrame  = Varchar(32) NOT NULL WITH DEFAULT;  /*PromptFrameName */
   RetCode = INTEGER;                  /* ReturnCode */
   SpecialReturnCode = INTEGER NOT NULL WITH DEFAULT;
   SearchObjects = ARRAY OF ObjectSummaryClass;  /* ObjectID */
   SearchItem = VARCHAR(10) NOT NULL WITH DEFAULT; /*ObjectType */ 
   SearchStatus = VARCHAR(40) NOT NULL WITH DEFAULT; /* TypeName */
   SelectCount = INTEGER;              /* SelectionResult*/
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   TFMSStep = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
   SkipAction = INTEGER NOT NULL WITH DEFAULT;  /* flag to show if action skipped */
   TermValue = INTEGER NOT NULL WITH DEFAULT;
   TerminalCount = INTEGER NOT NULL;              /*# of Terminals*/
   TempString = VARCHAR(160) NOT NULL WITH DEFAULT;
   ToRs = INTEGER NOT NULL WITH DEFAULT;
   EquipStatus = INTEGER NOT NULL WITH DEFAULT;
   DBTime  = DATE NOT NULL WITH DEFAULT;
   TFMSOpStepLog = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
   SpecialReturnCode = PU_OK;
/*
**  Get out of here if this is an ISWP.
*/
   ISWP = 0;
   InServicePermitEquip = 0;
   IF CurrentApplication = Application$SLC THEN
       SELECT :InServicePermitEquip = PhaseCheckIndicator
       FROM   SOA_WorkPermit
       WHERE  PermitJobId = :CurObject.Job;

       IF InServicePermitEquip = 0 THEN 
          SELECT  :ISWP = ISPermit
          FROM    SOA_InServicePermit
          WHERE   Job = :CurObject.Job;

          IF ISWP <> 0 THEN
             RETURN (PU_OK);
          ENDIF;
      ENDIF;
   ENDIF;
/*
**  Get jobactions for all types of moves where this job exists.
*/
   CurObject.JobAction.Clear();
   i = 1;
   IF NoCard = TRUE THEN
      REPEATED
      SELECT DISTINCT
             :CurObject.JobAction[i].JobClass = JA.JobClass,
             :CurObject.JobAction[i].FeederEquip = JA.FeederEquip,
             :CurObject.JobAction[i].ToRs = JA.ToRs,
             :CurObject.JobAction[i].IssueCompl = JA.IssueCompl,
             :CurObject.JobAction[i].Action = JA.Action,
             :CurObject.JobAction[i].Status = JA.Status
      FROM   FMS_JobAction JA
      WHERE  JA.JobClass = :CurObject.JobClass AND
             JA.EquipClass = :CurObject.MoveEquipClass AND
             JA.StepPair  = :CurObject.StepPair  
      ORDER BY FeederEquip DESC
      BEGIN
         i = i + 1;
      END;
   ELSE
      REPEATED
      SELECT DISTINCT
             :CurObject.JobAction[i].JobClass = JA.JobClass,
             :CurObject.JobAction[i].FeederEquip = JA.FeederEquip,
             :CurObject.JobAction[i].ToRs = JA.ToRs,
             :CurObject.JobAction[i].IssueCompl = JA.IssueCompl,
             :CurObject.JobAction[i].Action = JA.Action,
             :CurObject.JobAction[i].Status = JA.Status
      FROM   FMS_JobAction JA,
             SOA_JobControl J,
             SOA_ActiveCard AC
      WHERE  J.Job = :CurObject.Job AND
             J.Card = AC.Card AND
             AC.TypeofCard = JA.TypeofCard AND
             JA.JobClass = :CurObject.JobClass AND
             JA.EquipClass = J.MoveEquipClass AND
             JA.StepPair  = J.StepPair  
      ORDER BY FeederEquip DESC
      BEGIN
         i = i + 1;
      END;            
   ENDIF;
/*
**  Set ToRs based on status field.
**  Also Set TFMSOpStepLog based on TORS and IssueCompl.  This is used 
**  when logging opstep changes so Coned can easily determine what was
**  done when move was set.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
      TFMSOpStepLog = 'TO';
   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
      TFMSOpStepLog = 'RS';
   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:JobActions; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
      TFMSOpStepLog = '??';
   ENDIF;
   CurObject.ToRs = ToRs;
/*
**  Finalize TFMSOpStepLog value.
*/
   IF IssueCompl = JobClass$Issue THEN
      TFMSOpStepLog = TFMSOpStepLog + 'I';
   ELSEIF IssueCompl = JobClass$Complete THEN
      TFMSOpStepLog = TFMSOpStepLog + 'C';
   ELSE
      TFMSOpStepLog = TFMSOpStepLog + '?';
   ENDIF;
/*
**  Processing for PENDING Delay Management 
*/
   IF ProcessAutoMode = FALSE AND NoCard <> TRUE THEN

      IF SimpleStep IS NULL THEN
         SimpleStep = OperatingStep_ASE.Create();
      ENDIF;
    
      SimpleStep.Job = CurObject.Job;
      SimpleStep.IssueCompl = IssueCompl;
      SimpleStep.ToRs = ToRs;
    
      SimpleStep.PendingDelayMgt(MoveType = CurObject.MoveType,
                                 StepPair = CurObject.StepPair);
   
      SimpleStep = NULL;
   ENDIF;      
   /*
   ** ITC 181: check if there is an action to increment/decrement ground status at
   ** completion. If so, select the terminal to place or remove a ground when 
   ** issuing the move
   */
   IF IssueCompl = JobClass$Issue AND NoEquipSt = FALSE THEN
      i = 1;
      WHILE i <= CurObject.JobAction.LastRow() DO
         IF CurObject.JobAction[i].ToRs = ToRs AND
            CurObject.JobAction[i].IssueCompl = JobClass$Complete AND
            (CurObject.JobAction[i].Action = JobAction$Increment OR
             CurObject.JobAction[i].Action = JobAction$Decrement) AND
            CurObject.JobAction[i].Status = Status$Ground THEN
               
            /* if this equipment is connected. Ask DO which terminal to
            ** place the ground on or remove the ground from.
            */
            TerminalCount = 0;
            SELECT :TerminalCount = COUNT(*)
            FROM   DSO_Connection C
            WHERE  C.FromObj = :CurObject.Equip OR 
                   C.ToObj = :CurObject.Equip;

            IF CurObject.JobAction[i].Action = JobAction$Increment THEN
               ActionInt = 1;
            ELSE
               ActionInt = -1;
            ENDIF;

            IF TerminalCount > 0 THEN /* Connectivity defined */
               TermValue = 0;
               IF InTerminal = 0 THEN
/*
**  Prepare Move Text
*/
                  IF ToRs = 0 THEN
                     MoveText = CurObject.TOMove;
                  ELSE
                     MoveText = CurObject.RSMove;
                  ENDIF;

                  IF ActionInt = 1 THEN
                     IF CurObject.GroundTerminal > 0 THEN
                        /* Terminal has been selected during the VisibleBreak precheck
                        */
                        IF CurObject.GroundTerminal = CurObject.Equip THEN
                           TermValue = 0;
                        ELSE
                           TermValue = CurObject.GroundTerminal;
                        ENDIF;
                     ELSE
                        TermValue = CALLFRAME SelectTerminal(
                               JIP = CurObject,
                               Action = 'placing',
                               MoveText = BYREF(MoveText));
                     ENDIF;
                  ELSE
                     TermValue = CALLFRAME SelectTerminal(
                               JIP = CurObject,
                               Action = 'removing',
                               MoveText = BYREF(MoveText));
                  ENDIF;

                  IF TermValue < 0 THEN
                     TermValue = 0;
                  ENDIF;
               ELSE
                  TermValue = InTerminal;
               ENDIF;

               /* Save the selected terminal in the new table by job (to/rs)
               */
               Retcode = CALLPROC SOA_GroundTerminalIns (
                                          Equip = CurObject.Equip,
                                          Action = ActionInt,
                                          Job = CurObject.Job,
                                          TORS = ToRs,
                                          Terminal = TermValue);
                     
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF;
               /*
               **  Update move text if it has changed. 
               */
               IF (TORS = 0 AND CurObject.TOMove <> MoveText) THEN

                        RetCode = CALLPROC SOA_JobMoveTextUpd (
                                 Job = CurObject.Job,
                                 TOMove = MoveText,  
                                 RSMove = CurObject.RSMove);

               ELSEIF (TORS = 1 AND CurObject.RSMove <> MoveText) THEN 
                        /* When a move is Restore issued, the TOMove was overriden with
                        ** RSMove in PerformMoves screen. so we have reload TOMove from 
                        ** the database
                        */
                        SELECT :TempString = TOMove
                        FROM   SOA_Job
                        WHERE  Job = :CurObject.Job;

                        RetCode = CALLPROC SOA_JobMoveTextUpd (
                                 Job = CurObject.Job,
                                 TOMove = TempString,
                                 RSMove = MoveText);  
               ENDIF;

               IF RetCode <> 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                                 'Error updating Ground Move Text. ' +
                                 'Please do it manually on the Move Details screen.',
                                             TraceMessage =
                                 'Class:JobInProgress;Method:JobActions; ' +
                                 'Error updating Ground Move Text for '+
                                 'Job=' + VARCHAR(CurObject.Job) + '.'
                                 );
               ELSE
                        IF ToRs = 0 THEN
                           CurObject.TOMove = MoveText;
                        ELSE
                           CurObject.RSMove = MoveText;
                        ENDIF;
                        CALLPROC DDB_COMMIT;
               ENDIF;                                             
            ENDIF;   // TerminalCount > 0                 
            ENDLOOP;
         ENDIF;
         i = i + 1;  
      ENDWHILE;
   ENDIF;  
/*
**  Loop through JobActions, perform necessary actions ; All actions will
**  be performed, unless cancelled.
*/
   i = 1;
   WHILE i <= CurObject.JobAction.LastRow() DO

      IF CurObject.JobAction[i].ToRs = ToRs AND
         CurObject.JobAction[i].IssueCompl = IssueCompl THEN     
            
         IF CurObject.JobAction[i].FeederEquip <> 0 THEN 
#           include GetJASearchObjects
         ENDIF;
           
         IF CurObject.JobAction[i].Action = JobAction$Prompt THEN
            /*
            ** Always do CutOut and CutIn prompts 
            */
            IF NoPrompts = FALSE OR
               CurObject.JobAction[i].Status = JobAction$CutOut OR
               CurObject.JobAction[i].Status = JobAction$CutIn  THEN
               
               SELECT :PromptFrame = Name              /*Get Frame Name*/
               FROM   Udb_Type
               WHERE  Type = :CurObject.JobAction[i].Status;
               
               PromptFrame = SQUEEZE('Prompt' + PromptFrame);

               RetCode = CALLFRAME :PromptFrame (JIP = CurObject);
/*
**  RetCode from test prompt may be Type$FOT, so the check below should not be changed to
**  <> PU_OK
*/
               IF RetCode = PU_CANCEL AND AutomaticExecution = FALSE THEN
                  CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
                              'Class:JobInProgress;Method:JobActions; ' +
                              'Job Action Prompt ' + PromptFrame + ' did not complete successfully ' +
                              ' for Job ' + VARCHAR(CurObject.Job) + '.');
               ELSEIF RetCode = Type$FOT THEN
                  SpecialReturnCode = Type$FOT;
               ENDIF;                
            ENDIF;
           
         ELSE
/*           
**  Perform check to see if we do not wish to perform this action.
*/            
            IF ProcessAutoMode = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 1 AND  /* Feeder */
                NoFeederSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 2 AND  /* Equip */
                NoEquipSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 3 AND /*Op Step*/
                NoOperSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 7 AND /* Line */
                NoLineSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 8 AND /* Station */
                NoStatSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 9 AND /*TFMS Op Step */
                NoOperSt = TRUE THEN
               SkipAction = TRUE;
            ELSE
               SkipAction = FALSE;
            ENDIF;
          
            IF CurObject.JobAction[i].Action = JobAction$SetAdjacent AND
                 SkipAction = FALSE THEN
               
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  SelectCount = 0;       /* Set Status if not already set */
                  SELECT :SelectCount = Count(*)
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[k].Object AND
                         Status = :CurObject.JobAction[i].Status; 
       
                  IF SelectCount = 0 THEN
                     RetCode = CALLPROC FMS_ObjStatIns(  
                                    Object = SearchObjects[k].Object,
                                    Status = CurObject.JobAction[i].Status,
                     	            StatusCount = 1,
                                    Terminal = 0,
                                    TimeSet = date('now'));
       
                  ELSE    /* At the very least, update the timestamp so that this
                           is the most recent object status; bump the count, just
                           so we know we've set this status in more than one 
                           place.  Count will help if we have to incomplete the
                           job for some reason. */
          
       	             RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	   	              Object = :SearchObjects[k].Object, 
	   	              Status = :CurObject.JobAction[i].Status,
                              Terminal = 0,
	                      increment = 1,
	   	              TimeSet = date('now'));
                  ENDIF; 

                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                           'Error setting an Object Status.  Tech Support should be ' +
                           'contacted to review your machine trace log',
                        TraceMessage =
                           'Class:JobInProgress;Method:JobActions; ' +
                           'Error setting an adjacent Object Status. ' +
                           'Object=' + VARCHAR(SearchObjects[k].Object) +
                           ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                           );
                     RETURN (PU_Cancel);
                  ENDIF;
                  k = k + 1;
                         
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Action = JobAction$RemoveAdjacent AND
               SkipAction = FALSE THEN

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                
                  RetCode = CALLPROC FMS_ObjStatDel(
                                          Object = SearchObjects[k].Object,
                                          Terminal = 0, 
                                       Status = CurObject.JobAction[i].Status);
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                        'Error removing an Object Status.  Tech Support should be ' +
                        'contacted to review your machine trace log',
                        TraceMessage =
                        'Class:JobInProgress;Method:JobActions; ' +
                        'Error removing an adjacent Object Status. ' +
                        'Object=' + VARCHAR(SearchObjects[k].Object) +
                        ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                        );
                     RETURN (PU_Cancel);
                  ENDIF;
                  k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Action = JobAction$Set AND
               SkipAction = FALSE THEN
            
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN

                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;    
                     SimpleStep.SO.BaseType = SearchObjects[k].BaseType;
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.SO.Name     = SearchObjects[k].Name;
                     SimpleStep.SO.Type     = SearchObjects[k].Type;
                     SimpleStep.SO.TypeName = SearchObjects[k].TypeName;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;
                     SimpleStep.Job         = CurObject.Job;
                     /*
                     ** If we are setting a PFSS Operating Step at completion
                     ** there is no need to wait until all moves have been issued.
                     */
                     IF IssueCompl = JobClass$Complete AND
                        SimpleStep.OpStep = Type$PFSS THEN
                        SimpleStep.SetPFSNow = 2;
                     ENDIF;

                     SimpleStep.SetOpStep();
   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error setting an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN

                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;

                     TFMSStep.SetOpStep();
   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                              'Class:JobInProgress;Method:JobActions; ' +
                              'Error setting a TFMS Operating Step. ' +
                              'Card=' + VARCHAR(SearchObjects[k].Object) +
                              ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                              );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                  ELSE
                     SelectCount = 0;      /* Set Status if not already set */
                     SELECT :SelectCount = Count(*)
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Status = :CurObject.JobAction[i].Status; 
                    
                     IF SelectCount = 0 THEN
                    
                        RetCode = CALLPROC FMS_ObjStatIns(
                                     Object = SearchObjects[k].Object,
                                     Status = CurObject.JobAction[i].Status,
                                     StatusCount = 1,
                                     Terminal = 0,
                                     TimeSet = date('now'));
                      
/*                       
**  At the very least, update the timestamp so that this is the most recent 
**  object status; bump the count, just so we know we've set this status in 
**  more than one place.  Count will help if we have to incomplete the job 
**  for some reason. 
*/                 
                     ELSE           
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                  Object = :SearchObjects[k].Object,
                                  Status = :CurObject.JobAction[i].Status,
                                  Terminal = 0,
                                  increment = 1,
                                  TimeSet = date('now'));
                     ENDIF; 
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                           'Error setting an Object Status.  Tech Support should be ' +
                           'contacted to review your machine trace log',
                                       TraceMessage =
                           'Class:JobInProgress;Method:JobActions; ' +
                           'Error setting an Object Status. ' +
                           'Object=' + VARCHAR(SearchObjects[k].Object) +
                           ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                           );
                        RETURN (PU_Cancel);
                     ENDIF;
                  ENDIF;
                  k = k + 1;
               ENDWHILE;
               
            ELSEIF CurObject.JobAction[i].Action = JobAction$Clear AND
                   SkipAction = FALSE THEN
                
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;    
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;

                     SimpleStep.ClearOpStep();
   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error clearing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN
                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;

                     TFMSStep.ClearOpStep();
   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error clearing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                  ELSE
                     RetCode = CALLPROC FMS_ObjStatDel(
                                   Object = SearchObjects[k].Object,
                                   Terminal = 0, 
                                   Status = CurObject.JobAction[i].Status);
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                           'Error clearing an Object Status.  Tech Support should be ' +
                           'contacted to review your machine trace log',
                          TraceMessage =
                           'Class:JobInProgress;Method:JobActions; ' +
                           'Error clearing an Object Status. ' +
                           'Object=' + VARCHAR(SearchObjects[k].Object) +
                           ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                           );
                        RETURN (PU_Cancel);
                     ENDIF;
                  ENDIF;
                  k = k + 1;
               ENDWHILE;
                
            ELSEIF CurObject.JobAction[i].Action = JobAction$Increment AND
                   SkipAction = FALSE THEN
                        
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  TermValue = 0;                  
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;    
                     SimpleStep.SO.BaseType = SearchObjects[k].BaseType;
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.SO.Name     = SearchObjects[k].Name;
                     SimpleStep.SO.Type     = SearchObjects[k].Type;
                     SimpleStep.SO.TypeName = SearchObjects[k].TypeName;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;
                     SimpleStep.Job         = CurObject.Job;

                     SimpleStep.SetOpStep();
   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error setting an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN
                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;

                     TFMSStep.SetOpStep();
   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error setting an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                  ELSE
                     IF CurObject.JobAction[i].Status = Status$Ground THEN
                        TerminalCount = 0;
                        SELECT :TerminalCount = COUNT(*)
                        FROM  DSO_Connection 
                        WHERE FromObj = :CurObject.Equip OR
                              ToObj = :CurObject.Equip;
                       
                        IF TerminalCount > 0 THEN /* Connectivity defined */
                           TermValue = -1;
                           IF InTerminal = 0 THEN
                              /* check if the terminal is already selected at issue 
                              */
                              SELECT :TermValue = Terminal
                              FROM   SOA_GroundTerminal
                              WHERE  Job = :CurObject.Job AND
                                     TORS = :ToRs;

                              IF TermValue = -1 THEN
                                 TermValue = CALLFRAME SelectTerminal(
                                           JIP = CurObject,
                                           Action = 'placed');
                              ELSE
                                 CALLPROC SOA_GroundTerminalDel (Job = CurObject.Job,
                                                           TORS = ToRs);
                                 CALLPROC DDB_COMMIT;
                              ENDIF;
                              
                              IF TermValue < 0 THEN
                                 PhaseTerminal = 0;
                                 TermValue = 0;
                              ELSE
                                 PhaseTerminal = TermValue;
                              ENDIF;
                           ELSE
                              TermValue = InTerminal;
                           ENDIF;
                        ENDIF; 
                     ENDIF; 
                     
                     SelectCount = 0;     /*Check for Count Existence */
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Terminal = :TermValue AND
                            Status = :CurObject.JobAction[i].Status;
                       
                     IF SelectCount = 0 THEN
                        RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = SearchObjects[k].Object,
                     		      Status = CurObject.JobAction[i].Status,
                                      Terminal = TermValue,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
                     ELSE    
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	    	                      Object = SearchObjects[k].Object, 
                                      Status = CurObject.JobAction[i].Status,
                                      Terminal = TermValue,
                                      increment = 1,
                                      TimeSet = date('now'));
                     ENDIF; 
                  ENDIF;  
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                          'Error incrementing an Object Status.  Tech Support should be ' +
                          'contacted to review your machine trace log',
                       TraceMessage =
                          'Class:JobInProgress;Method:JobActions; ' +
                          'Error incrementing an Object Status. ' +
                          'Object=' + VARCHAR(SearchObjects[k].Object) +
                          ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                       );
                     RETURN (PU_Cancel);
                  ENDIF;
                  CALLPROC DDB_COMMIT;
                  k = k + 1;
               ENDWHILE;
/*              
**  If this is a ground, do the dirty work on the Job for display purposes 
**  for all jobs with this equipment.  
**  Job G field handled within this db procedure as part of deadlock 
**  avoidance maneuver.
*/                 
               IF CurObject.JobAction[i].Status = Status$Ground THEN 
/*               
**   Set GroundOn field if this is a takeout to signal that this move
**   set the ground.
*/                
                  IF CurObject.JobAction[i].ToRs = Job$TakeOutInt THEN
                     CurObject.GroundOn = 'now';
                  ELSE
                     CurObject.GroundOn = NULL;
	          ENDIF;
                  RetCode = CALLPROC SOA_GroundOnUpd (
                                 GroundOn = CurObject.GroundOn,
                                 Job      = CurObject.Job,
                                 Equip    = CurObject.Equip
                                 );
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                           'Error making Ground Move turn red.  Tech Support should be ' +
                           'contacted to review your machine trace log',
                        TraceMessage =
                           'Class:JobInProgress;Method:JobActions; ' +
                           'Error setting Ground On value for. ' +
                           'Job=' + VARCHAR(CurObject.Job) +
                           ';Equip=' + VARCHAR(CurObject.Equip) + '.'
                        );
                     RETURN (PU_Cancel);
                  ENDIF;         
                  CALLPROC DDB_COMMIT;                                              
/*                  
**   Call procedure which manages card header info related to grounds
*/                IF NoCard <> TRUE THEN                  
                     CALLPROC FMS_ManageCardHeader (Equip = CurObject.Equip); 
                  ENDIF;
               ENDIF;
                
            ELSEIF CurObject.JobAction[i].Action = JobAction$Decrement AND
                 SkipAction = FALSE THEN
               
               k = 1;          
               WHILE k <= SearchObjects.LastRow() DO
                  TermValue = 0;
                    
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;    
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;
                      
                     SimpleStep.DecrementOpStep();
                   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error decrementing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
                   
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN
                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;
                      
                     TFMSStep.DecrementOpStep();
                   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:JobActions; ' +
                            'Error decrementing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                  ELSE
                     IF CurObject.JobAction[i].Status = Status$Ground THEN
                        TerminalCount = 0;
                        SELECT :TerminalCount = COUNT(*)
                        FROM  DSO_Connection 
                        WHERE FromObj = :CurObject.Equip OR
                              ToObj = :CurObject.Equip;                
                      
                        IF TerminalCount > 0 THEN  /* Connectivity Defined */
                           TermValue = -1;
                           IF InTerminal = 0 THEN
                              /* check if the terminal is already selected at issue 
                              */
                              SELECT :TermValue = Terminal
                              FROM   SOA_GroundTerminal
                              WHERE  Job = :CurObject.Job AND
                                     TORS = :ToRs;

                              IF TermValue = -1 THEN
                                 TermValue = CALLFRAME SelectTerminal(
                                              JIP = CurObject,
                                              Action = 'removed');
                              ELSE
                                 CALLPROC SOA_GroundTerminalDel (Job = CurObject.Job,
                                                           TORS = ToRs);
                                 CALLPROC DDB_COMMIT;
                              ENDIF; 
                              IF TermValue < 0 THEN
                                 PhaseTerminal = 0;
                                 TermValue = 0;
                              ELSE
                                 PhaseTerminal = TermValue;
                              ENDIF;
                           ELSE
                              TermValue = InTerminal;
                           ENDIF;
                        ENDIF;
                     ENDIF; 
                     
                     SelectCount = 0;          /*Check for Count Existence */
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Terminal = :TermValue AND
                            Status = :CurObject.JobAction[i].Status;
                     
                     IF SelectCount = 1 THEN   /* Decrementing will remove status*/
                        RetCode = CALLPROC FMS_ObjStatDel(
                                       Object = SearchObjects[k].Object, 
                                       Terminal = TermValue,
                                       Status = CurObject.JobAction[i].Status);
                           
                     ELSEIF SelectCount > 1 OR SelectCount < 0 THEN 
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                     Object = SearchObjects[k].Object, 
	                             Status = CurObject.JobAction[i].Status,
                                     Terminal = TermValue,
                                     increment = -1,
                                     TimeSet = date('now'));
                     ELSEIF SelectCount = 0 AND CurObject.JobAction[i].Status <> Status$Caution THEN
                        RetCode = CALLPROC FMS_ObjStatIns(
                               Object = SearchObjects[k].Object,
                                        Status = CurObject.JobAction[i].Status,
                                        StatusCount = -1,
                                        Terminal = TermValue,
                                        TimeSet = date('now'));
                     ENDIF;
                  ENDIF;   
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                        'Error decrementing an Object Status.  Tech Support should be ' +
                        'contacted to review your machine trace log',
                                    TraceMessage =
                        'Class:JobInProgress;Method:JobActions; ' +
                        'Error decrementing an Object Status. ' +
                        'Object=' + VARCHAR(SearchObjects[k].Object) +
                        ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                        );
                     RETURN (PU_Cancel);
                  ENDIF;
                  CALLPROC DDB_COMMIT;
                  k = k + 1;
               ENDWHILE;
/*               
**  If this is a ground, do the dirty work on the Job for display purposes.
**  For all jobs with this equipment. 
*/               
               IF CurObject.JobAction[i].Status = Status$Ground THEN 
                  CurObject.GroundOn = NULL; 
                  RetCode = CALLPROC SOA_GroundOnUpd (
                                GroundOn = CurObject.GroundOn,
                                Job      = CurObject.Job,
                                Equip    = CurObject.Equip
                              );
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                        'Error taking red off of Ground Move.  Tech Support should be ' +
                        'contacted to review your machine trace log',
                                    TraceMessage =
                        'Class:JobInProgress;Method:JobActions; ' +
                        'Error removing Ground On value for. ' +
                        'Job=' + VARCHAR(CurObject.Job) +
                        ';Equip=' + VARCHAR(CurObject.Equip) + '.'
                        );
                     RETURN (PU_Cancel);
                  ENDIF;                   
                  CALLPROC DDB_COMMIT;                
/*                  
**   Call procedure which manages card header info related to grounds
*/                
                  IF NoCard <> TRUE THEN  
                     CALLPROC FMS_ManageCardHeader (Equip = CurObject.Equip);
                  ENDIF;
               ENDIF; 
            ENDIF; 
         ENDIF;        
         CALLPROC DDB_COMMIT;     
      ENDIF;
      i = i + 1;
   ENDWHILE;     
                 
   IF OverRodeWarning = TRUE THEN 
       
      OverRideReason = CALLFRAME Override (
            Card = CurObject.Card, 
            Job = CurObject.Job,
            SwitchingItem = CurObject.SwitchingItem);
      IF OverRideReason IS NULL THEN /* They hit cancel */
         RETURN(PU_CANCEL);
      ENDIF; 
   ENDIF;
/*
** Count the number of notification records for the move that was
** completed. Prompt for notification if at least one was found.
*/
   IF IssueCompl = JobClass$Complete  AND AutomaticExecution = FALSE  THEN
      NotifCount = 0;
      SELECT :NotifCount = COUNT(*)
      FROM FMS_Notifications N
      WHERE N.Job = :CurObject.Job
        AND N.PrePost = :JobAction$Prompt
        AND N.ToRs = :ToRs;
      IF NotifCount > 0 THEN
         CALLFRAME NotificationsPrompt (JIP = CurObject,
                                        ToRs = IFNULL(ToRs,0),
                                        PrePost = JobAction$Prompt);
      ENDIF;
   ENDIF;
/*
**  )9/05/17 Commented out since OutageMonitor repurposed to be used only for CurrentlyOpen
**  Look through all JobActions and see if any set VisibleBreak or Rackout
**  status.  If yes send notification to TOMS Outage Monitor.
*
   IF NoEquipSt <> TRUE THEN
      FOR i = 1 TO CurObject.JobAction.LastRow() DO

         IF CurObject.JobAction[i].ToRs = ToRs AND
            CurObject.JobAction[i].IssueCompl = IssueCompl AND
            CurObject.JobAction[i].FeederEquip = 2 AND  /* Equip *
           (CurObject.JobAction[i].Status = Status$VisibleBreak OR
            CurObject.JobAction[i].Status = Status$RO) THEN
            
            IF CurObject.JobAction[i].Action = JobAction$Decrement OR
               CurObject.JobAction[i].Action = JobAction$Clear THEN
               /* Get the current status of the Equipment *
               SELECT :EquipStatus = CurrentlyOpen
               FROM    Udb_Switch 
               WHERE   Object = :CurObject.Equip;
            ELSE
               /* When setting or incrementing alway use Visible Break *
               EquipStatus = Status$VisibleBreak;
            ENDIF;
            /*
            **  Select Timestamp from job table to get correct time if 
            **  manual entry mode is used.
            *
            DBTime = '';
            IF ToRs = Job$TakeoutInt AND IssueCompl = JobClass$Issue THEN
               SELECT :DBTIME = IFNULL(J.TOIssued,'')
               FROM    SOA_Job J
               WHERE   J.Job = :CurObject.Job;
            ELSEIF ToRs = Job$TakeoutInt AND IssueCompl = JobClass$Complete THEN
               SELECT :DBTIME = IFNULL(J.TOComplete,'')
               FROM    SOA_Job J
               WHERE   J.Job = :CurObject.Job;
            ELSEIF ToRs = Job$RestoreInt AND IssueCompl = JobClass$Issue THEN
               SELECT :DBTIME = IFNULL(J.RSIssued,'')
               FROM    SOA_Job J
               WHERE   J.Job = :CurObject.Job;
            ELSEIF ToRs = Job$RestoreInt AND IssueCompl = JobClass$Complete THEN
               SELECT :DBTIME = IFNULL(J.RSComplete,'')
               FROM    SOA_Job J
               WHERE   J.Job = :CurObject.Job;
            ENDIF;
            IF DBTime = '' THEN
               SELECT :DBTime = DATE('NOW');
            ENDIF;
  
            RetCode = CALLPROC FMS_ObjectStatusQueueIns (
               Time = DBTime,
               Object = CurObject.Equip,
               Status = EquipStatus, 
               Job = Curobject.Job,
               TORS = CurObject.ToRs,
               Card = CurObject.Card,
               SwitchingItem = Curobject.SwitchingItem,
               FromApp = CurrentApplication,
               DOName = DOp.Description);
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = '',
                        TraceMessage =
                  'JobInProgress:JobActions: Unable to insert row into the ' +
                  'FMS_ObjectStatusQueue table for Equip = ' + Varchar(CurObject.Equip));
            ELSE 
               CALLPROC DDB_COMMIT;
               CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ObjectStatusQueue');
               CALLPROC DDB_COMMIT;
            ENDIF;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDIF;
*/
   
   IF SpecialReturnCode <> PU_OK THEN
      RETURN(SpecialReturnCode);
   ELSE               
      RETURN(PU_OK);
   ENDIF;
END;


METHOD UndoJobActions 
(
   IssueCompl = INTEGER NOT NULL;   /* 0 = Issue, 1 = Complete */
   NoPrompts  = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Prompts */
   NoLineSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Line acts */
   NoFeederSt = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Fdr acts */
   NoStatSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Prompts */
   NoEquipSt  = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip Equip acts*/
   NoOperSt   = INTEGER NOT NULL WITH DEFAULT; /*Pass True to skip OpStep acts*/
   InTerminal = INTEGER NOT NULL WITH DEFAULT; /* If we already know terminal */
   SingleFeederOnly = INTEGER NOT NULL WITH DEFAULT; /*passed limiting parm*/
) =
DECLARE 
   C = CardSOA;
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   i = Integer NOT NULL;	/* Scratch counter */
   j = Integer;			/* Scratch counter */
   k = Integer;			/* Scratch counter */
   OppositePrompt = INTEGER NOT NULL WITH DEFAULT;
   OverrideReason = VARCHAR(60);       /*TextString*/
   OverRodeWarning = INTEGER NOT NULL WITH DEFAULT;
   PromptFrame  = Varchar(32) NOT NULL WITH DEFAULT;  /*PromptFrameName*/
   RetCode = INTEGER;                  /* ReturnCode*/
   SearchObjects = ARRAY OF ObjectSummaryClass;  /*ObjectID*/
   SearchItem = VARCHAR(10) NOT NULL WITH DEFAULT; /*ObjectType*/ 
   SearchStatus = VARCHAR(40) NOT NULL WITH DEFAULT; /*TypeName*/
   SelectCount = INTEGER;              /* SelectionResult*/
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   TFMSStep = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
   SkipAction = INTEGER NOT NULL WITH DEFAULT;  /* flag to show if action skipped */
   TermValue = INTEGER NOT NULL WITH DEFAULT;
   TempString = VARCHAR(160) NOT NULL WITH DEFAULT; 
   ToRs = INTEGER NOT NULL WITH DEFAULT;
   TFMSOpStepLog = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
/*
**  Get jobactions for all types of moves where this job exists.
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.JobAction[i].JobClass = JA.JobClass,
          :CurObject.JobAction[i].FeederEquip = JA.FeederEquip,
          :CurObject.JobAction[i].ToRs = JA.ToRs,
          :CurObject.JobAction[i].IssueCompl = JA.IssueCompl,
          :CurObject.JobAction[i].Action = JA.Action,
          :CurObject.JobAction[i].Status = JA.Status
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.JobClass = :CurObject.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair  
   ORDER BY FeederEquip DESC
   BEGIN
      i = i + 1;
   END;            
   CALLPROC DDB_ROLLBACK;
/*
**  Set ToRs based on status field.
**  Also Set TFMSOpStepLog based on TORS and IssueCompl.  This is used 
**  when logging opstep changes so Coned can easily determine what was
**  done when move was set.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
      TFMSOpStepLog = 'TO';
   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
      TFMSOpStepLog = 'RS';
   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:UndoJobActions; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
      TFMSOpStepLog = '??';
   ENDIF;
/*
**  Finalize TFMSOpStepLog value.
*/
   IF IssueCompl = JobClass$Issue THEN
      TFMSOpStepLog = TFMSOpStepLog + 'I Undo';
   ELSEIF IssueCompl = JobClass$Complete THEN
      TFMSOpStepLog = TFMSOpStepLog + 'C Undo';
   ELSE
      TFMSOpStepLog = TFMSOpStepLog + '? Undo';
   ENDIF;
/*
**  Processing for PENDING Delay Management
*/
   IF SimpleStep IS NULL THEN
      SimpleStep = OperatingStep_ASE.Create();
   ENDIF;
    
   SimpleStep.Job = CurObject.Job;
   SimpleStep.IssueCompl = IssueCompl;
   SimpleStep.ToRs = ToRs;
   SimpleStep.IncompleteFlag = TRUE;
    
   SimpleStep.PendingDelayMgt();
   
   SimpleStep = NULL;
   /*
   ** ITC 181: Delete the terminal that was selected and saved at the time of issuing the move
   */
   IF IssueCompl = JobClass$Issue THEN
      TermValue = -1;
      SELECT :TermValue = Terminal
      FROM   SOA_GroundTerminal
      WHERE  Job = :CurObject.Job AND
             TORS = :ToRs;

      IF TermValue >= 0 THEN
         CALLPROC SOA_GroundTerminalDel(Job = CurObject.Job,
                                        TORS = ToRs);
         CALLPROC DDB_COMMIT;
         /*
         ** Remove the adjacent equipment from the move text
         */
         IF ToRs = 0 THEN
            IF CurObject.TOMove LIKE '% - Adjacent to:%' THEN
               CurObject.TOMove = LEFT(CurObject.TOMove,LOCATE(CurObject.TOMove,' - Adjacent to:')-1); 

               RetCode = CALLPROC SOA_JobMoveTextUpd (
                     Job = CurObject.Job,
                     TOMove = CurObject.TOMove,
                     RSMove = CurObject.RSMove);
            ENDIF;
         ELSE
            IF CurObject.RSMove LIKE '% - Adjacent to:%' THEN
               CurObject.RSMove = LEFT(CurObject.RSMove,LOCATE(CurObject.RSMove,' - Adjacent to:')-1);
               /* When a move is Restore issued, the TOMove was overriden with
               ** RSMove in PerformMoves screen. so we have reload TOMove from 
               ** the database
               */
               SELECT :TempString = TOMove
               FROM   SOA_Job
               WHERE  Job = :CurObject.Job;

               RetCode = CALLPROC SOA_JobMoveTextUpd (
                     Job = CurObject.Job,
                     TOMove = TempString,
                     RSMove = CurObject.RSMove);
 
            ENDIF;
         ENDIF;
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                     'Error removing adjacent equipment location from Ground Move Text. ' +
                     'Please do it manually on the Move Details screen.',
                      TraceMessage =
                     'Class:JobInProgress;Method:UndoJobActions; ' +
                     'Error removing adjacent equipment location from Ground Move Text '+
                     'for Job=' + VARCHAR(CurObject.Job) + '.'
                     );
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF; 
   ENDIF;
/*
**  Loop through JobActions, perform necessary actions ; All actions will
**  be performed, unless cancelled.
*/
   i = 1;
   WHILE i <= CurObject.JobAction.LastRow() DO

      IF CurObject.JobAction[i].ToRs = ToRs AND
         CurObject.JobAction[i].IssueCompl = IssueCompl THEN     
            
         IF CurObject.JobAction[i].FeederEquip <> 0 THEN 
#           include GetJASearchObjects          
         ENDIF;
           
         IF CurObject.JobAction[i].Action = JobAction$Prompt THEN
/*
**   Can't reverse a prompt, Prompts have historically been done at
**   Completion time, so this may not be a problem initially.
**   Of course, the new jobclass maintenance does not prevent prompts
**   from being used at issue time.
**   we are supporting reversal of paired prompts that are opposite in actions.  
**   These are easy to support, since they are mirror reversals from each other.
*/
            OppositePrompt = 0;
            IF NoEquipSt = FALSE OR 
               CurObject.JobAction[i].Status = Prompt$CallSOCCSX OR
               CurObject.JobAction[i].Status = Prompt$Phases THEN 

               SELECT :OppositePrompt = Reverse
               FROM   FMS_CustomPrompt
               WHERE  Prompt = :CurObject.JobAction[i].Status AND
                      Reverse IS NOT NULL;
            ENDIF;          
/*
** 8/21/13: Replaced by data-driven reversed prompt lookup.
**          
            IF CurObject.JobAction[i].Status = Prompt$SetCurrentlyOpen AND 
                   NoEquipSt = FALSE THEN
               OppositePrompt = Prompt$ClearCurrentlyOpen;
            ELSEIF CurObject.JobAction[i].Status = Prompt$ClearCurrentlyOpen AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$SetCurrentlyOpen;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Close101FromLoad AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Open101FromLoad;
            ELSEIF CurObject.JobAction[i].Status = Prompt$Open101FromLoad AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Close101FromLoad;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Close101FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Open101FromMacro;
            ELSEIF CurObject.JobAction[i].Status = Prompt$open101FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Close101FromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Close102FromLoad AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Open102FromLoad;
            ELSEIF CurObject.JobAction[i].Status = Prompt$Open102FromLoad AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Close102FromLoad;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Close102FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Open102FromMacro;
            ELSEIF CurObject.JobAction[i].Status = Prompt$open102FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Close102FromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$CloseConnectedATS AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$OpenConnectedATS;
            ELSEIF CurObject.JobAction[i].Status = Prompt$OpenConnectedATS AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$CloseConnectedATS; 

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetGroundBreakerSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$RemoveGroundBreakerSide; 
            ELSEIF CurObject.JobAction[i].Status = Prompt$RemoveGroundBreakerSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$SetGroundBreakerSide;

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetGroundBkrSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$RemoveGroundBkrSide; 
            ELSEIF CurObject.JobAction[i].Status = Prompt$RemoveGroundBkrSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$SetGroundBkrSide;

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetGroundFeederSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$RemoveGroundFeederSide; 
            ELSEIF CurObject.JobAction[i].Status = Prompt$RemoveGroundFeederSide AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$SetGroundFeederSide;

            ELSEIF CurObject.JobAction[i].Status = Prompt$StopTag AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$RemoveStopTag;

            ELSEIF CurObject.JobAction[i].Status = Prompt$SendTCOffToRR AND 
                   NoFeederSt = FALSE THEN   
               OppositePrompt = Prompt$SendTCOnToRR; 
            ELSEIF CurObject.JobAction[i].Status = Prompt$SendTCOnToRR AND 
                   NoFeederSt = FALSE THEN   
               OppositePrompt = Prompt$SendTCOffToRR;

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetATSManualFromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$ClearATSManualFromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$ClearATSManualFromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$SetATSManualFromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Declutch101FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Reclutch101FromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Reclutch101FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Declutch101FromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Declutch102FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Reclutch102FromMacro;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Reclutch102FromMacro AND 
                   NoEquipSt = FALSE THEN   
               OppositePrompt = Prompt$Declutch102FromMacro;
            ENDIF;
*/         
            PromptFrame = '';

            IF OppositePrompt <> 0 THEN
               SELECT :PromptFrame = Name              
               FROM   Udb_Type
               WHERE  Type = :OppositePrompt;
            ENDIF;
            
            IF PromptFrame <> '' THEN
               PromptFrame = SQUEEZE('Prompt' + PromptFrame);

               RetCode = CALLFRAME :PromptFrame (JIP = CurObject);

               IF RetCode <> PU_OK THEN
                  RETURN(RetCode);
                  ENDLOOP;
               ENDIF;
            ENDIF;         
/*
**   Added reversal for PromptCallSOCCSX which is performed at Issue Time.
* 8/21/13: replaced by PromptClearSOCCSX driven from fms_CustomPrompt

            IF CurObject.JobAction[i].Status = Prompt$CallSOCCSX THEN

               /* Delete all messages from the FMS_SOCCSXMESSAGE table: *

                  RetCode = CALLPROC FMS_SoccsxMessageDel
                       ( UserName = UserName );
                  IF RetCode <> 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
               'ERROR: Call to SOCCSX cannot be deleted.  Contact tech ' +
               'support and refer them to your trace log for daignosis.',
                           TraceMessage =
               'Class:JobInProgress;Method:UndoJobActions; ' +
               'Unable to delete Call to SOCCSX. ' +
               'SOCCSX Interface will have problems ' +
               'for username ' + UserName + ' if not manually ' +
               'cleared.'
               );
                  ENDIF;
            ENDIF;
*/
/*
**   Added reversal for PromptPhases which is performed at Issue Time.
*  8/21/13: replaced by PromptRemovePhases driven from fms_CustomPrompt

            IF CurObject.JobAction[i].Status = Prompt$Phases THEN

               RetCode = CALLPROC IR_PhasesDel (
                         Job = CurObject.Job);
  
               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
               'ERROR: Unable to delete old phases information. Contact tech ' +
               'support and refer them to your trace log for daignosis.',
                           TraceMessage =
               'Class:JobInProgress;Method:UndoJobActions; ' +
               'Unable to delete old Phases information for Job ' +
               VARCHAR(CurObject.Job) + '.' 
               );
               ENDIF;
            ENDIF;   
*/           
         ELSE
/*           
**  Perform check to see if we do not wish to perform this action.
*/            
            IF CurObject.JobAction[i].FeederEquip = 1 AND      /* Feeder */
                NoFeederSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 2 AND  /* Equip */
                NoEquipSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 3 AND /*Op Step*/
                NoOperSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 7 AND /*Line*/
                NoLineSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 8 AND /*Station*/
                NoStatSt = TRUE THEN
               SkipAction = TRUE;
            ELSEIF CurObject.JobAction[i].FeederEquip = 9 AND /*TFMS Op Step*/
                NoOperSt = TRUE THEN 
               SkipAction = TRUE;
            ELSE
               SkipAction = FALSE;
            ENDIF;
          
            IF CurObject.JobAction[i].Action = JobAction$SetAdjacent AND
               SkipAction = FALSE THEN
/*
**   Clear Status, or decrement count if set more than once. 
*/
               k = 1;             
               WHILE k <= SearchObjects.LastRow() DO
   
                  SelectCount = 0;
                  SELECT :SelectCount = StatusCount 
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[k].Object AND
                         Terminal = 0 AND
                         Status = :CurObject.JobAction[i].Status; 

                  IF SelectCount = 1 THEN
            
                     RetCode = CallProc FMS_ObjStatDel(
                                  Object = SearchObjects[k].Object,
                                  Terminal = 0,
                                  Status = CurObject.JobAction[i].Status);
               
                  ELSEIF SelectCount > 1 THEN   
        
   	             RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                    object = SearchObjects[k].Object,
	                            Status = CurObject.JobAction[i].Status,
                                    Terminal = 0,
	                            increment = -1,
	                            TimeSet = date(''));
        
                  ENDIF;
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
               'Error clearing an Object Status.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'Class:JobInProgress;Method:UndoJobActions; ' +
               'Error clearing an adjacent Object Status. ' +
               'Object=' + VARCHAR(SearchObjects[k].Object) +
               ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
               );
                     RETURN (PU_Cancel);
                  ENDIF;
                  k = k + 1;
        
               ENDWHILE; 


            ELSEIF CurObject.JobAction[i].Action = JobAction$RemoveAdjacent AND
               SkipAction = FALSE THEN
/*   
**   Set Status or increment if it already exists.
*/
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
   
                  SelectCount = 0;
                  SELECT :SelectCount = StatusCount 
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[k].Object AND
                         Terminal = 0 AND 
                         Status = :CurObject.JobAction[i].Status; 
          
                  IF SelectCount = 0 THEN
            
                     RetCode = CALLPROC FMS_ObjStatIns(	
                               Object = SearchObjects[k].Object,
                               Status = CurObject.JobAction[i].Status,
                               Terminal = 0, 
                               StatusCount = 1,
                               TimeSet = date('now'));
                  ELSEIF SelectCount > 0 THEN  
                
	             RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	                     object = SearchObjects[k].Object,
	                     Status = CurObject.JobAction[i].Status,
                             Terminal = 0,
	                     increment = 1,
	                     TimeSet = date(''));
                  ENDIF;
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
               'Error setting an Object Status.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'Class:JobInProgress;Method:UndoJobActions; ' +
               'Error setting an adjacent Object Status. ' +
               'Object=' + VARCHAR(SearchObjects[k].Object) +
               ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
               );
                     RETURN (PU_Cancel);
                  ENDIF;
                  k = k + 1;

               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Action = JobAction$Set AND
               SkipAction = FALSE THEN
            
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN  /* FMS OpSteps */
                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;
    
                     SimpleStep.SO.BaseType = SearchObjects[k].BaseType;
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.SO.Name     = SearchObjects[k].Name;
                     SimpleStep.SO.Type     = SearchObjects[k].Type;
                     SimpleStep.SO.TypeName = SearchObjects[k].TypeName;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;
                     SimpleStep.Job         = CurObject.Job;

                     IF ToRs = 0 THEN
                        SimpleStep.UndoOpStep(IssueTime = CurObject.TOIssued
                                             ,Action = JobAction$Set);
                     ELSEIF ToRs = 1 THEN
                        SimpleStep.UndoOpStep(IssueTime = CurObject.RSIssued
                                             ,Action = JobAction$Set);
                     ENDIF;
   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error clearing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
    
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN /* TFMS OpSteps */
                     
                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;
                      
                     TFMSStep.DecrementOpStep();
                   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error decrementing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                     
                  ELSE  
                     SelectCount = 0;              
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Status = :CurObject.JobAction[i].Status; 
                    
                     IF SelectCount = 1 THEN
                    
                        RetCode = CALLPROC FMS_ObjStatDel(
                                     Object = SearchObjects[k].Object,
                                     Status = CurObject.JobAction[i].Status,
                                     Terminal = 0);
                      
/*                       
**  At the very least, update the timestamp so that this is the most recent 
**  object status; bump the count, just so we know we've set this status in 
**  more than one place.  Count will help if we have to incomplete the job 
**  for some reason. 
*/                 
                     ELSEIF SelectCount > 1 THEN           
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                  Object = :SearchObjects[k].Object,
                                  Status = :CurObject.JobAction[i].Status,
                                  Terminal = 0,
                                  increment = -1,
                                  TimeSet = date('now'));
                     ENDIF; 
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                       'Error clearing an Object Status.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'Class:JobInProgress;Method:UndoJobActions; ' +
                       'Error clearing an Object Status. ' +
                       'Object=' + VARCHAR(SearchObjects[k].Object) +
                       ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                       );
                        RETURN (PU_Cancel);
                     ENDIF;
                  ENDIF;
                  k = k + 1;
               ENDWHILE;
               
            ELSEIF CurObject.JobAction[i].Action = JobAction$Clear AND
                   SkipAction = FALSE THEN
                
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     /* We don't undo Clear FMS operating steps */
                  
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN /* TFMS OpSteps */


                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;

                     TFMSStep.SetOpStep();
   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error setting a TFMS Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;

                  ELSE
                     SelectCount = 0;
                     SELECT :SelectCount = StatusCount 
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Terminal = 0 AND
                            Status = :CurObject.JobAction[i].Status; 

                     IF SelectCount = 0 THEN
                        RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = SearchObjects[k].Object,
                                      Status = CurObject.JobAction[i].Status,
                                      Terminal = 0,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
                     ELSEIF SelectCount > 0 THEN
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                      Object = SearchObjects[k].Object,
                                      Status = CurObject.JobAction[i].Status,
                                      Terminal = 0,
                                      Increment = 1,
                                      TimeSet = date('now'));
                     ENDIF;

                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                  'Error setting an Object Status.  Tech Support should be ' +
                  'contacted to review your machine trace log',
                           TraceMessage =
                  'Class:JobInProgress;Method:UndoJobActions; ' +
                  'Error setting an Object Status. ' +
                  'Object=' + VARCHAR(SearchObjects[k].Object) +
                  ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                  );
                        RETURN (PU_Cancel);
                     ENDIF;
                  ENDIF;
                  k = k + 1;
               ENDWHILE;
                
            ELSEIF CurObject.JobAction[i].Action = JobAction$Increment AND
                   SkipAction = FALSE THEN
                        
               k = 1;          
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     IF SimpleStep IS NULL THEN
                        SimpleStep = OperatingStep_ASE.Create();
                     ENDIF;
    
                     SimpleStep.SO.BaseType = SearchObjects[k].BaseType;
                     SimpleStep.SO.Object   = SearchObjects[k].Object;
                     SimpleStep.SO.Name     = SearchObjects[k].Name;
                     SimpleStep.SO.Type     = SearchObjects[k].Type;
                     SimpleStep.SO.TypeName = SearchObjects[k].TypeName;
                     SimpleStep.OpStep      = CurObject.JobAction[i].Status;
                     SimpleStep.Job         = CurObject.Job;

                     IF ToRs = 0 THEN
                        SimpleStep.UndoOpStep(IssueTime = CurObject.TOIssued
                                             ,Action = JobAction$Increment);
                     ELSEIF ToRs = 1 THEN
                        SimpleStep.UndoOpStep(IssueTime = CurObject.RSIssued
                                             ,Action = JobAction$Increment);
                     ENDIF;
   
                     IF SimpleStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error clearing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        SimpleStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     SimpleStep = NULL;
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN /* TFMS OpSteps */
                     
                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;
                      
                     TFMSStep.DecrementOpStep();
                   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error decrementing an Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                     
                  ELSE  
                     TermValue = 0;
  
                     IF CurObject.JobAction[i].Status = Status$Ground THEN
                        SelectCount = 0;
                        SELECT :SelectCount = COUNT(*)
                        FROM  DSO_Connection 
                        WHERE FromObj = :CurObject.Equip OR
                              ToObj = :CurObject.Equip;
                      
                        IF SelectCount > 0 THEN  /* Connectivity Defined */
                           SelectCount = 0;
                           SELECT :SelectCount = COUNT(*)
                           FROM  FMS_Objectstatus O
                           WHERE O.Object = :CurObject.Equip AND
                                 O.Status = :Status$Ground AND
                                 O.Terminal >= 0;
                          
                           IF SelectCount > 1 THEN
                              IF InTerminal = 0 THEN
                                 TermValue = CALLFRAME SelectTerminal(
                                              JIP = CurObject,
                                              Action = 'removed');
                                 IF TermValue < 0 THEN
                                    PhaseTerminal = 0;
                                    TermValue = 0;
                                 ELSE
                                    PhaseTerminal = TermValue;
                                 ENDIF;
                              ELSE
                                 TermValue = InTerminal;
                              ENDIF;
                           ELSEIF SelectCount = 1 THEN
                              /* Make sure of terminal that is grounded. */
                              SELECT :TermValue = O.Terminal
                              FROM    FMS_ObjectStatus O
                              WHERE   O.Object = :CurObject.Equip AND
                                      O.Status = :Status$Ground;
                           ENDIF;
                        ENDIF;
                     ENDIF; 
                     
                     SelectCount = 0;                /*Check for Count Existence */
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Terminal = :TermValue AND
                            Status = :CurObject.JobAction[i].Status;
                     
                     IF SelectCount = 1 THEN       /* Decrementing will remove status*/
                        RetCode = CALLPROC FMS_ObjStatDel(
                                       Object = SearchObjects[k].Object, 
                                       Terminal = TermValue,
                                       Status = CurObject.JobAction[i].Status);
                           
                     ELSEIF SelectCount > 1 OR SelectCount < 0 THEN 
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                     Object = SearchObjects[k].Object, 
	                             Status = CurObject.JobAction[i].Status,
                                     Terminal = TermValue,
                                     increment = -1,
                                     TimeSet = date('now'));
                     ELSEIF SelectCount = 0 THEN
                        RetCode = CALLPROC FMS_ObjStatIns(
                               Object = SearchObjects[k].Object,
                                        Status = CurObject.JobAction[i].Status,
                                        StatusCount = -1,
                                        Terminal = TermValue,
                                        TimeSet = date('now'));
                     ENDIF;
                     
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                         'Error decrementing an Object Status.  Tech Support should be ' +
                         'contacted to review your machine trace log',
                               TraceMessage =
                         'Class:JobInProgress;Method:UndoJobActions; ' +
                         'Error decrementing an Object Status. ' +
                         'Object=' + VARCHAR(SearchObjects[k].Object) +
                         ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                         );
                        RETURN (PU_Cancel);
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                  ENDIF;
                  k = k + 1;
               ENDWHILE;
/*               
**  If this is a ground, do the dirty work on the Job for display purposes.
**  For all jobs with this equipment. 
*/               
               IF CurObject.JobAction[i].Status = Status$Ground THEN 
                  CurObject.GroundOn = NULL; 
                  RetCode = CALLPROC SOA_GroundOnUpd (
                                GroundOn = CurObject.GroundOn,
                                Job      = CurObject.Job,
                                Equip    = CurObject.Equip
                              );
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
               'Error taking red off Ground.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'Class:JobInProgress;Method:JobActions; ' +
               'Error removing Ground On value for. ' +
               'Job=' + VARCHAR(CurObject.Job) +
               ';Equip=' + VARCHAR(CurObject.Equip) + '.'
               );
                     RETURN (PU_Cancel);
                  ENDIF;
                   
                  CALLPROC DDB_COMMIT;
                 
/*                  
**   Call procedure which manages card header info related to grounds
*/                 
                  CALLPROC FMS_ManageCardHeader (Equip = CurObject.Equip);
               ENDIF; 
                
            ELSEIF CurObject.JobAction[i].Action = JobAction$Decrement AND
                 SkipAction = FALSE THEN

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
                  IF CurObject.JobAction[i].FeederEquip = 3 THEN
                     /* We don't undo decrement operating steps */
                  
                  ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN /* TFMS OpSteps */


                     IF TFMSStep IS NULL THEN
                        TFMSStep = TFMSOpStep_ASE.Create();
                     ENDIF;    
                     TFMSStep.SO.BaseType = SearchObjects[k].BaseType;
                     TFMSStep.SO.Object   = SearchObjects[k].Object;
                     TFMSStep.SO.Name     = SearchObjects[k].Name;
                     TFMSStep.SO.Type     = SearchObjects[k].Type;
                     TFMSStep.SO.TypeName = SearchObjects[k].TypeName;
                     TFMSStep.OpStep      = CurObject.JobAction[i].Status;
                     TFMSStep.Job         = CurObject.Job;
                     TFMSStep.LogAppend   = TFMSOpStepLog;

                     TFMSStep.SetOpStep();
   
                     IF TFMSStep.ReturnCode <> 0 THEN
                        CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
                           TraceMessage =
                            'Class:JobInProgress;Method:UndoJobActions; ' +
                            'Error setting a TFMS Operating Step. ' +
                            'Card=' + VARCHAR(SearchObjects[k].Object) +
                            ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                            );
                        TFMSStep = NULL;
                        RETURN (PU_Cancel);
                     ENDIF; 
                     TFMSStep = NULL;
                  ELSE
                     TermValue = 0;
 
                     IF CurObject.JobAction[i].Status = Status$Ground THEN
                        SelectCount = 0;
                        SELECT :SelectCount = COUNT(*)
                        FROM  DSO_Connection 
                        WHERE FromObj = :CurObject.Equip OR
                              ToObj = :CurObject.Equip;
                       
                        IF SelectCount > 0 THEN /* Connectivity defined */
                           TermValue = 0;
                           IF InTerminal = 0 THEN
                              TermValue = CALLFRAME SelectTerminal(
                                           JIP = CurObject,
                                           Action = 'placed');
                              IF TermValue < 0 THEN
                                 PhaseTerminal = 0;
                                 TermValue = 0;
                              ELSE
                                 PhaseTerminal = TermValue;
                              ENDIF;
                           ELSE
                              TermValue = InTerminal;
                           ENDIF;
                        ENDIF; 
                     ENDIF; 
                     
                     SelectCount = 0;                /*Check for Count Existence */
                     SELECT :SelectCount = StatusCount
                     FROM   FMS_ObjectStatus 
                     WHERE  Object = :SearchObjects[k].Object AND
                            Terminal = :TermValue AND
                            Status = :CurObject.JobAction[i].Status;
                       
                     IF SelectCount = 0 THEN
                        RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = SearchObjects[k].Object,
                                      Status = CurObject.JobAction[i].Status,
                                      Terminal = TermValue,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
                     ELSE    
                        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                                      Object = SearchObjects[k].Object, 
                                      Status = CurObject.JobAction[i].Status,
                                      Terminal = TermValue,
                                      increment = 1,
                                      TimeSet = date('now'));
                     ENDIF; 
                     
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                  'Error incrementing an Object Status.  Tech Support should be ' +
                  'contacted to review your machine trace log',
                           TraceMessage =
                  'Class:JobInProgress;Method:UndoJobActions; ' +
                  'Error incrementing an Object Status. ' +
                  'Object=' + VARCHAR(SearchObjects[k].Object) +
                  ';Status=' + VARCHAR(CurObject.JobAction[i].Status) + '.'
                  );
                       RETURN (PU_Cancel);
                     ENDIF;
                  ENDIF;
                  CALLPROC DDB_COMMIT;
                  k = k + 1;
               ENDWHILE;
/*              
**  If this is a ground, do the dirty work on the Job for display purposes 
**  for all jobs with this equipment.  
**  Job G field handled within this db procedure as part of deadlock 
**  avoidance maneuver.
*/                 
               IF CurObject.JobAction[i].Status = Status$Ground THEN 
/*               
**   Set GroundOn field if this is a restore to signal that this move
**   set the ground.
*/                
                  IF CurObject.JobAction[i].ToRs = Job$RestoreInt THEN
                     CurObject.GroundOn = 'now';
                  ELSE
                     CurObject.GroundOn = NULL;
	          ENDIF;
                  RetCode = CALLPROC SOA_GroundOnUpd (
                                 GroundOn = CurObject.GroundOn,
                                 Job      = CurObject.Job,
                                 Equip    = CurObject.Equip
                                 );
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
               'Error making Ground Move red.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'Class:JobInProgress;Method:JobActions; ' +
               'Error setting Ground On value for. ' +
               'Job=' + VARCHAR(CurObject.Job) +
               ';Equip=' + VARCHAR(CurObject.Equip) + '.'
               );
                     RETURN (PU_Cancel);
                  ENDIF;         
                  CALLPROC DDB_COMMIT;                
/*                  
**   Call procedure which manages card header info related to grounds
*/                                  
                  CALLPROC FMS_ManageCardHeader (Equip = CurObject.Equip); 
               ENDIF;               

            ENDIF; 
         ENDIF;        
         CALLPROC DDB_COMMIT;     
      ENDIF;
      i = i + 1;
   ENDWHILE;     
                 
   IF OverRodeWarning = TRUE THEN 
       
      OverRideReason = CALLFRAME Override (
            Card = CurObject.Card, 
            Job = CurObject.Job,
            SwitchingItem = CurObject.SwitchingItem);
      IF OverRideReason IS NULL THEN /* They hit cancel */
         RETURN(PU_CANCEL);
      ENDIF; 
   ENDIF;

   RETURN(PU_OK);
END;


METHOD SetPendingActions 
(
) =
DECLARE
   ATS = ObjectSummaryClass;
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   i = Integer;			/* Scratch counter */
   j = Integer;			/* Scratch counter */
   k = Integer;			/* Scratch counter */
   IssuedOperator = INTEGER NOT NULL; 
   ToRs = Integer;                      
   RetCode = INTEGER;                  /* ReturnCode*/
   ProcRetCode = INTEGER;                  /* ReturnCode*/
   SelectCount = INTEGER;              /*SelectionResult*/
   SearchObjects = ARRAY OF ObjectSummaryClass;  /*ObjectID*/
   SDObjects = ObjectSummaryClass;  /*ObjectID*/
   SearchItem = VARCHAR(10) NOT NULL WITH DEFAULT; /*ObjectType*/ 
   SearchStatus = VARCHAR(40) NOT NULL WITH DEFAULT; /*TypeName*/
   SingleFeederOnly = INTEGER NOT NULL WITH DEFAULT; /*passed limiting parm*/
BEGIN
/*
**  Get jobactions for all types of moves where this job exists.
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.JobAction[i].JobClass = JA.JobClass,
          :CurObject.JobAction[i].FeederEquip = JA.FeederEquip,
          :CurObject.JobAction[i].ToRs = JA.ToRs,
          :CurObject.JobAction[i].IssueCompl = JA.IssueCompl,
          :CurObject.JobAction[i].Action = JA.Action,
          :CurObject.JobAction[i].Status = JA.Status
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.JobClass = :CurObject.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair  
   ORDER BY FeederEquip DESC
   BEGIN
      i = i + 1;
   END;            
   CALLPROC DDB_ROLLBACK;
/*
**  Set ToRs based on status field.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
      IssuedOperator = IFNULL(CurObject.TOOperator,0);

   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
      IssuedOperator = IFNULL(CurObject.RSOperator,0);
   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:SetPendingActions; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
   ENDIF;
/*
**  Loop through JobActions, perform necessary actions ; All actions will
**  be performed, unless cancelled.
*/
   i = 1;
   WHILE i <= CurObject.JobAction.LastRow() DO

      IF CurObject.JobAction[i].ToRs = ToRs AND
         CurObject.JobAction[i].IssueCompl = JobClass$Complete THEN     

         IF CurObject.JobAction[i].FeederEquip <> 0 THEN
#           include GetJASearchObjects          
         ENDIF;
    
         IF CurObject.JobAction[i].Action = JobAction$Prompt   THEN
/*
**   Prompts are largely ignored, however, here are the exceptions:
**       CheckDBF, CutOut, CutIn, 
**       RemoveGroundBreaker/FeederSide (but not with Terminal)
**       Reclutch101/102FromMacro
*/   
            IF CurObject.JobAction[i].Status = Prompt$CheckDBF THEN

               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;
               /*
               **  If this card has a link to 4kv StepDown cards, look for more objects.
               **  Only check if SD-VIS is closed.
               */
               SDObjects = NULL;
               SDObjects = ObjectSummaryClass.Create();
               REPEATED
               SELECT DISTINCT
                      :SDObjects.Object = O.Object,
                      :SDObjects.Name = O.Name,
                      :SDObjects.TypeName = O.TypeName
               FROM    FMS_StepDownLink L,
                       TFMS_CardToObject T,
                       Udb_Switch S,
                       Udb_Grouping G,
                       Udb_Object O
               WHERE  (L.Card = :CurObject.Card OR
                       L.StepDownCard = :CurObject.Card) AND
                      (L.Card = T.Card OR
                       L.StepDownCard = T.Card) AND
                       T.Object = O.Object AND
                       O.Type = :Type$Feeder AND
                       T.Object = G.Grouping AND
                       G.Relationship = :Interaction$MemberOf AND
                       G.MemberType = :Type$SDVIS AND
                       G.Member = S.Object AND
                       S.CurrentlyOpen = 0
               BEGIN
                  k = 1;
                  WHILE k <= SearchObjects.LastRow DO
                     IF SearchObjects[k].Object = SDObjects.Object THEN
                        ENDLOOP;
                     ENDIF;
                     k = k + 1;
                  ENDWHILE;
                  IF k > SearchObjects.LastRow THEN
                     SearchObjects[k] = SDObjects.Duplicate();
                  ENDIF;
               END;

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;                /*Check for Count Existence */
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$DBF;
 
               IF SelectCount = 0 THEN
 
                  CALLPROC FMS_SetPendingStatus(
                                 Object = :SearchObjects[k].Object,
                                 IssuedOperator = :IssuedOperator,
                                 PendingStatus = :Status$DBF,
                                 StatusCount = 1);
               ELSE    

                  CALLPROC FMS_BumpPendingStatCount(
                                Object = :SearchObjects[k].Object, 
                                IssuedOperator = :IssuedOperator,
                                PendingStatus = :Status$DBF,
                                increment = 1);
               ENDIF; 

               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$CutOut THEN

               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;                /*Check for Count Existence */
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$CO;
 
               IF SelectCount = 0 THEN
 
                  CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$CO,
                                  StatusCount = 1);
               ELSE    

                  CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$CO,
                                  increment = 1);
               ENDIF;
 
               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$CutIn THEN

               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;                /*Check for Count Existence */
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$RS;
 
               IF SelectCount = 0 THEN
 
                  CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$RS,
                                  StatusCount = 1);
               ELSE    

                  CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$RS,
                                  increment = 1);
               ENDIF; 

               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$RemoveGroundBreakerSide OR
                   CurObject.JobAction[i].Status = Prompt$RemoveGroundFeederSide THEN
/*
** If no pending, check actual and insert with pending count deducted by 1.
** Don't insert anything if no pending and no actual...we don't need -1 pending statuses.
*/ 
               SelectCount = 0;      
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :CurObject.Equip AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$Ground; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN

                  SELECT :SelectCount = SUM(StatusCount)  /*Sum of all Terminals*/
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :CurObject.Equip AND
                         Status = :Status$Ground; 

                  IF SelectCount > 0 THEN

                     SelectCount = SelectCount - 1;
 
                     CALLPROC FMS_SetPendingStatus(
                                  Object = :CurObject.Equip,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$Ground,
                                  StatusCount = IFNULL(SelectCount,0));

                  ENDIF;

               ELSE    

      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = CurObject.Equip, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$Ground,
                                  increment = -1);
               ENDIF;

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetGroundBreakerSide OR
                   CurObject.JobAction[i].Status = Prompt$SetGroundFeederSide THEN
/*
** If no pending, check actual and insert with pending count deducted by 1.
** Don't insert anything if no pending and no actual...we don't need -1 pending statuses.
*/ 
               SelectCount = 0;      
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :CurObject.Equip AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$Ground; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN

                  SELECT :SelectCount = IFNULL(SUM(StatusCount),0)  /*Sum of all Terminals*/
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :CurObject.Equip AND
                         Status = :Status$Ground; 

                  SelectCount = SelectCount + 1;
 
                  CALLPROC FMS_SetPendingStatus(
                               Object = :CurObject.Equip,
                               IssuedOperator = :IssuedOperator,
                               PendingStatus = :Status$Ground,
                               StatusCount = IFNULL(SelectCount,0));

               ELSE    

      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = CurObject.Equip, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :Status$Ground,
                                  increment = 1);
               ENDIF;

            ELSEIF CurObject.JobAction[i].Status = Prompt$Reclutch101FromMacro OR
                   CurObject.JobAction[i].Status = Prompt$Reclutch102FromMacro THEN

              ATS.Object = 0;
              IF CurObject.JobAction[i].Status = Prompt$Reclutch101FromMacro THEN

               REPEATED
               SELECT :ATS.Object = O.Object,
                      :ATS.TypeName = O.TypeName,
                      :ATS.Name = O.Name 
               FROM   Udb_Object O,
                      Udb_Grouping G
               WHERE  G.Grouping = :CurObject.Equip AND
                      G.GroupingType IN (SELECT Type
                                         FROM   Udb_ExtendedType
                                         WHERE  SuperType = :Type$ATSGrouper) AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Member = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$ATS101);
              ELSE

               REPEATED
               SELECT :ATS.Object = O.Object,
                      :ATS.TypeName = O.TypeName,
                      :ATS.Name = O.Name 
               FROM   Udb_Object O,
                      Udb_Grouping G
               WHERE  G.Grouping = :CurObject.Equip AND
                      G.GroupingType IN (SELECT Type
                                         FROM   Udb_ExtendedType
                                         WHERE  SuperType = :Type$ATSGrouper) AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Member = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$ATS102);
              ENDIF;
/*
** If no pending, check actual and insert with pending count deducted by 1.
** Don't insert anything if no pending and no actual...we don't need -1 pending statuses.
*/ 
              IF ATS.Object > 0 THEN
               SelectCount = 0;      
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :ATS.Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$Declutch; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN

                  SELECT :SelectCount = StatusCount  
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :ATS.Object AND
                         Status = :Status$Declutch; 

                  IF SelectCount > 0 THEN

                     CALLPROC FMS_SetPendingStatus(
                                  Object = ATS.Object,
                                  IssuedOperator = IssuedOperator,
                                  PendingStatus = Status$Declutch,
                                  StatusCount = 0);
                  ENDIF;

               ELSE    

                  SelectCount = SelectCount * -1;
      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = ATS.Object, 
                                  IssuedOperator = IssuedOperator,
                                  PendingStatus = Status$Declutch,
                                  increment = SelectCount);
               ENDIF;
              ENDIF;

            ENDIF; 
/*
**  Keep Ignore of Op Steps a separate IF statement, because it will
**  cause an error if an operating step is being set. 
*/
         ELSEIF CurObject.JobAction[i].FeederEquip = 3 THEN /*Ignore Op Steps*/
         ELSEIF CurObject.JobAction[i].FeederEquip = 9 THEN /*Ignore TFMS Op Steps*/
         ELSEIF CurObject.JobAction[i].Action = JobAction$Set OR  
                CurObject.JobAction[i].Action = JobAction$SetAdjacent    THEN

            k = 1;
            WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;      /*Set Status if notf already set*/
               SELECT :SelectCount = Count(*)
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :CurObject.JobAction[i].Status; 
 
               IF SelectCount = 0 THEN
 
                  CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  StatusCount = 1);

               ELSE    

      	         CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  increment = 1);
               ENDIF;
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Clear OR
                CurObject.JobAction[i].Action = JobAction$RemoveAdjacent THEN
/*
** Set pending status count = 0, by inserting or decrementing
*/
            k = 1;
            WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;      
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :CurObject.JobAction[i].Status; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN
 
                  CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  StatusCount = 0);

               ELSE    

      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  increment = IFNULL((-1 * IFNULL(SelectCount,0)),0));
               ENDIF;
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Increment THEN

            k = 1;
            WHILE k <= SearchObjects.LastRow() DO

               SelectCount = 0;     
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :CurObject.JobAction[i].Status; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN
/*
** If no pending, check actual and bump it.
*/ 
                  SELECT :SelectCount = StatusCount
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[k].Object AND
                         Status = :CurObject.JobAction[i].Status; 

                  SelectCount = SelectCount + 1;

                  CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  StatusCount = IFNULL(SelectCount,0));

               ELSE    

      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  increment = 1);
               ENDIF;
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Decrement THEN

            k = 1;
            WHILE k <= SearchObjects.LastRow() DO
/*
** If no pending, check actual and insert with pending count deducted by 1.
** Don't insert anything if no pending and no actual...we don't need -1 pending statuses.
*/ 
               SelectCount = 0;      
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :CurObject.JobAction[i].Status; 
 
               IF SelectCount = 0 AND iirowcount = 0 THEN

                  SELECT :SelectCount = StatusCount
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :SearchObjects[k].Object AND
                         Status = :CurObject.JobAction[i].Status; 

                  IF SelectCount > 0 THEN

                     SelectCount = SelectCount - 1;
 
                     CALLPROC FMS_SetPendingStatus(
                                  Object = :SearchObjects[k].Object,
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  StatusCount = IFNULL(SelectCount,0));

                  ENDIF;

               ELSE    

      	          CALLPROC FMS_BumpPendingStatCount(
                                  Object = :SearchObjects[k].Object, 
                                  IssuedOperator = :IssuedOperator,
                                  PendingStatus = :CurObject.JobAction[i].Status,
                                  increment = -1);
               ENDIF;
               k = k + 1;
            ENDWHILE; 

         ELSE                   /* Unknown Action  */

            CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:JobInProgress;Method:SetPendingActions; ' +
               'Bad data in JobAction table for Job ' + 
                VARCHAR(CurObject.Job) + '; Unknown Job Check ' +
                varchar(Curobject.JobAction[i].Action) + '.'
               );
         ENDIF;
         CALLPROC DDB_COMMIT;       

      ENDIF;

      i = i + 1;
   ENDWHILE;
END;


METHOD ClearPendingActions 
(
) =
DECLARE
   ATS = ObjectSummaryClass;
   CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
   FedBy = INTEGER NOT NULL WITH DEFAULT;
   i = Integer;			/* Scratch counter */
   j = Integer;			/* Scratch counter */
   k = Integer;			/* Scratch counter */
   IssuedOperator = INTEGER NOT NULL; 
   ToRs = Integer;                      
   RetCode = INTEGER;                  /* ReturnCode*/
   ProcRetCode = INTEGER;                  /* ReturnCode*/
   SelectCount = INTEGER;              /*SelectionResult*/
   SearchObjects = ARRAY OF ObjectSummaryClass;  /*ObjectID*/
   SDObjects = ObjectSummaryClass;  /*ObjectID*/
   SearchItem = VARCHAR(10) NOT NULL WITH DEFAULT; /*ObjectType*/ 
   SearchStatus = VARCHAR(40) NOT NULL WITH DEFAULT; /*TypeName*/
   SingleFeederOnly = INTEGER NOT NULL WITH DEFAULT; /*passed limiting parm*/

BEGIN
/*
**  Get jobactions for all types of moves where this job exists.
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.JobAction[i].JobClass = JA.JobClass,
          :CurObject.JobAction[i].FeederEquip = JA.FeederEquip,
          :CurObject.JobAction[i].ToRs = JA.ToRs,
          :CurObject.JobAction[i].IssueCompl = JA.IssueCompl,
          :CurObject.JobAction[i].Action = JA.Action,
          :CurObject.JobAction[i].Status = JA.Status
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.JobClass = :CurObject.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair  
   ORDER BY FeederEquip DESC
   BEGIN
      i = i + 1;
   END;            
   CALLPROC DDB_ROLLBACK;

/*
**  Set ToRs based on status field.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
      IssuedOperator = IFNULL(CurObject.TOOperator,0);

   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
      IssuedOperator = IFNULL(CurObject.RSOperator,0);

   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:ClearPendingActions; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
   ENDIF;

/*
**  Loop through JobActions, perform necessary actions ; All actions will
**  be performed, unless cancelled.
*/
   i = 1;
   WHILE i <= CurObject.JobAction.LastRow() DO

      IF CurObject.JobAction[i].ToRs = ToRs AND
         CurObject.JobAction[i].IssueCompl = JobClass$Complete THEN     

         IF CurObject.JobAction[i].FeederEquip <> 0 THEN
#           include GetJASearchObjects          
         ENDIF;
    
         IF CurObject.JobAction[i].Action = JobAction$Prompt   THEN
/*
**   Prompts are largely ignored, however, here are the exceptions:
**       CheckDBF, CutOut, CutIn
**       RemoveGroundBreaker/FeederSide (but not with Terminal)
*/   
            IF CurObject.JobAction[i].Status = Prompt$CheckDBF THEN
            
               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;
               /*
               **  If this card has a link to 4kv StepDown cards, look for more objects.
               **  Only check if SD-VIS is closed.
               */
               SDObjects = NULL;
               SDObjects = ObjectSummaryClass.Create();
               REPEATED
               SELECT DISTINCT
                      :SDObjects.Object = O.Object,
                      :SDObjects.Name = O.Name,
                      :SDObjects.TypeName = O.TypeName
               FROM    FMS_StepDownLink L,
                       TFMS_CardToObject T,
                       Udb_Switch S,
                       Udb_Grouping G,
                       Udb_Object O
               WHERE  (L.Card = :CurObject.Card OR
                       L.StepDownCard = :CurObject.Card) AND
                      (L.Card = T.Card OR
                       L.StepDownCard = T.Card) AND
                       T.Object = O.Object AND
                       O.Type = :Type$Feeder AND
                       T.Object = G.Grouping AND
                       G.Relationship = :Interaction$MemberOf AND
                       G.MemberType = :Type$SDVIS AND
                       G.Member = S.Object AND
                       S.CurrentlyOpen = 0
               BEGIN
                  k = 1;
                  WHILE k <= SearchObjects.LastRow DO
                     IF SearchObjects[k].Object = SDObjects.Object THEN
                        ENDLOOP;
                     ENDIF;
                     k = k + 1;
                  ENDWHILE;
                  IF k > SearchObjects.LastRow THEN
                     SearchObjects[k] = SDObjects.Duplicate();
                  ENDIF;
               END;
               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
/*
               SelectCount = 0;                /*Check for Count Existence *
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$DBF;

               IF SelectCount = 1 THEN
*/

                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$DBF); 
/*                   
               ELSEIF SelectCount > 1 THEN   
       
                  CALLPROC FMS_BumpPendingStatCount (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$DBF,
                      increment = -1); 
               ENDIF;
*/     
               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$CutOut THEN

               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
/*
               SelectCount = 0;                /*Check for Count Existence *
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$CO;

               IF SelectCount = 1 THEN
*/
                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$CO); 
/*                   
               ELSEIF SelectCount > 1 THEN   
       
                  CALLPROC FMS_BumpPendingStatCount (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$CO,
                      increment = -1); 
  
               ENDIF; 
*/     
               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$CutIn THEN

               k = 1;
               REPEATED
               SELECT :SearchObjects[k].Object = O.Object,
                      :SearchObjects[k].Name = O.Name,
                      :SearchObjects[k].TypeName = O.TypeName
               FROM   SOA_ActiveObject AO,
                      Udb_Object O,
                      SOA_JobControl JC
               WHERE  JC.Job = :CurObject.Job AND
                      JC.Card = AO.Card AND
                      AO.Object = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder)
               BEGIN
                  k = k + 1;
               END;

               k = 1;
               WHILE k <= SearchObjects.LastRow() DO
/*
               SelectCount = 0;                /*Check for Count Existence *
               SELECT :SelectCount = StatusCount
               FROM   FMS_PendingStatus
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND
                      PendingStatus = :Status$RS;

               IF SelectCount = 1 THEN
*/
                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$RS); 
/*                   
               ELSEIF SelectCount > 1 THEN   
       
                  CALLPROC FMS_BumpPendingStatCount (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :Status$RS,
                      increment = -1); 
  
               ENDIF; 
*/     
               k = k + 1;
               ENDWHILE;

            ELSEIF CurObject.JobAction[i].Status = Prompt$RemoveGroundBreakerSide OR
                   CurObject.JobAction[i].Status = Prompt$RemoveGroundFeederSide THEN

                  CALLPROC FMS_PendingStatDel (
                      Object = CurObject.Equip,
                      IssuedOperator = IssuedOperator,
                      PendingStatus = Status$Ground); 

            ELSEIF CurObject.JobAction[i].Status = Prompt$SetGroundBreakerSide OR
                   CurObject.JobAction[i].Status = Prompt$SetGroundFeederSide THEN

                  CALLPROC FMS_PendingStatDel (
                      Object = CurObject.Equip,
                      IssuedOperator = IssuedOperator,
                      PendingStatus = Status$Ground); 

            ELSEIF CurObject.JobAction[i].Status = Prompt$Reclutch101FromMacro OR
                   CurObject.JobAction[i].Status = Prompt$Reclutch102FromMacro THEN

              ATS.Object = 0;
              IF CurObject.JobAction[i].Status = Prompt$Reclutch101FromMacro THEN

               REPEATED
               SELECT :ATS.Object = O.Object,
                      :ATS.TypeName = O.TypeName,
                      :ATS.Name = O.Name 
               FROM   Udb_Object O,
                      Udb_Grouping G
               WHERE  G.Grouping = :CurObject.Equip AND
                      G.GroupingType IN (SELECT Type
                                         FROM   Udb_ExtendedType
                                         WHERE  SuperType = :Type$ATSGrouper) AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Member = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$ATS101);
              ELSE

               REPEATED
               SELECT :ATS.Object = O.Object,
                      :ATS.TypeName = O.TypeName,
                      :ATS.Name = O.Name 
               FROM   Udb_Object O,
                      Udb_Grouping G
               WHERE  G.Grouping = :CurObject.Equip AND
                      G.GroupingType IN (SELECT Type
                                         FROM   Udb_ExtendedType
                                         WHERE  SuperType = :Type$ATSGrouper) AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Member = O.Object AND
                      O.Type IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$ATS102);
              ENDIF;

              IF ATS.Object > 0 THEN
                 CALLPROC FMS_PendingStatDel (
                      Object = ATS.Object,
                      IssuedOperator = IssuedOperator,
                      PendingStatus = Status$Declutch); 
              ENDIF;

            ENDIF; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Set OR
                 CurObject.JobAction[i].Action = JobAction$SetAdjacent  THEN

            k = 1;
            WHILE k <= SearchObjects.LastRow() DO
/*
               SelectCount = 0;
               SELECT :SelectCount = StatusCount 
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND 
                      PendingStatus = :CurObject.JobAction[i].Status; 

               IF SelectCount = 1 THEN
*/
                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status); 
/*                   
               ELSEIF SelectCount > 1 THEN   
       
                  CALLPROC FMS_BumpPendingStatCount (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status,
                      increment = -1); 
  
               ENDIF; 
*/
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Clear OR
                CurObject.JobAction[i].Action = JobAction$RemoveAdjacent THEN
/* 
** Don't know whether pending status existed previously, we just remove it (should
** have statuscount = 0
*/
            k = 1;
            WHILE k <= SearchObjects.LastRow() DO

                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status); 
                   
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Increment THEN

            k = 1;
            WHILE k <= SearchObjects.LastRow() DO
/*
               SelectCount = 0;
               SELECT :SelectCount = StatusCount 
               FROM   FMS_PendingStatus 
               WHERE  Object = :SearchObjects[k].Object AND
                      IssuedOperator = :IssuedOperator AND 
                      PendingStatus = :CurObject.JobAction[i].Status; 

               IF SelectCount = 1 THEN
*/
                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status); 
/*                   
               ELSEIF SelectCount > 1 THEN   
       
                  CALLPROC FMS_BumpPendingStatCount (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status,
                      increment = -1); 
  
               ENDIF; 
*/
               k = k + 1;
            ENDWHILE; 

         ELSEIF CurObject.JobAction[i].Action = JobAction$Decrement THEN
/* 
** Don't know whether pending status existed previously, we just remove it (possibly could
** have statuscount > 0 but we have no way to know)
*/
            k = 1;
            WHILE k <= SearchObjects.LastRow() DO

                  CALLPROC FMS_PendingStatDel (
                      Object = :SearchObjects[k].Object,
                      IssuedOperator = :IssuedOperator,
                      PendingStatus = :CurObject.JobAction[i].Status); 
                   
               k = k + 1;
            ENDWHILE; 

         ELSE                   /* Unknown Action  */
            CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Class:JobInProgress;Method:ClearPendingActions; ' +
               'Bad data in JobAction table for Job ' + 
                VARCHAR(CurObject.Job) + '; Unknown Job Check ' +
                varchar(Curobject.JobAction[i].Action) + '.'
               );
         ENDIF;
         CALLPROC DDB_COMMIT;       

      ENDIF;

      i = i + 1;
   ENDWHILE;
END;


METHOD IsJobActionReversible
(
   IssueCompl = INTEGER NOT NULL;   /* 0 = Issue, 1 = Complete */
) =
DECLARE 
   i = Integer NOT NULL;	/* Scratch counter */
   
   NameList = VARCHAR(80) NOT NULL WITH DEFAULT;
   OverrideReason = VARCHAR(60);       /*TextString*/
   ProcRetCode = INTEGER;
   PromptList = ARRAY OF IntegerObject;
   PromptName = VARCHAR(40) NOT NULL WITH DEFAULT;
   Reversible = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;                  /* ReturnCode*/
   ToRs = INTEGER NOT NULL WITH DEFAULT;
BEGIN

/*
**  Set ToRs based on status field.
*/
   IF CurObject.Status = Job$TakeOut THEN
      ToRs = 0;
   ELSEIF CurObject.Status = Job$Restore THEN
      ToRs = 1;
   ELSE
      CALLPROC TraceError (UserMessage = 
               'Unable to determine if move is TakeOut or Restore.',
                           TraceMessage =
               'Class:JobInProgress;Method:JobActions; ' +
               ' Unable to determine if move is TakeOut or Restore for Job ' +
               VARCHAR(CurObject.Job) + '.'
               );
   ENDIF;

/*
**  Get jobactions for all types of moves where this job exists.
*/
   PromptList.Clear();

   i = 1;
   REPEATED
   SELECT DISTINCT
          :PromptList[i].Value = JA.Status
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :CurObject.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.TORS = :ToRs AND
          JA.IssueCompl = :IssueCompl AND
          JA.JobClass = :CurObject.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair AND
          JA.Action = :JobAction$Prompt 
   BEGIN
      i = i + 1;
   END;            
/*
**  Loop through JobActions.If a prompt is not defined in the developer 
**  maintained table, the prompt is assumed to be irreversible.
*/
   ProcRetCode = PU_OK; 
   NameList = '';

   i = 1;
   WHILE i <= PromptList.LastRow() DO

      Reversible = 0;
      SELECT :Reversible = P.Reversible
      FROM   FMS_CustomPrompt P
      WHERE  P.Prompt = :PromptList[i].Value;
               
      IF Reversible = 0 THEN
         PromptName = '';      
         SELECT :PromptName = T.Name
         FROM   Udb_Type T
         WHERE  T.Type = :PromptList[i].Value;

         IF (CurMethod.ConfirmPopup(MessageText = 'This undo action may not be able to change feeder status ' + 
                 'and may cause erroneous warnings. Continue undoing this move?') = PU_CANCEL) THEN
            RETURN PU_CANCEL;
         ELSE
            IF NameList <> '' THEN
               NameList = NameList + ';';
            ENDIF;
            NameList = NameList + PromptName;
            ProcRetCode = Warning$Overridden;
         ENDIF;
      ENDIF;

      i = i + 1;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;
   
   IF ProcRetCode = Warning$Overridden THEN
      CALLPROC SOA_LogIns (Card = CurObject.Card,
                       Job  =  CurObject.Job,
                       SwitchingItem  = CurObject.SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'UNDO',
                       Old  = 'Irreversible Prompts:', 
                       New =  NameList);
     CALLPROC DDB_COMMIT;
   ENDIF;
   RETURN PU_OK;
END;

METHOD GetAdjacentEquipment(
   TargetType = INTEGER NOT NULL;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;

   RetCode = INTEGER; 
   SearchObjects = ARRAY OF ObjectSummaryClass;
   Trace = Trace_AdjacentEquipment;
BEGIN
/* old codes in GetJASearchObjects
   j = 1;
   REPEATED
   SELECT DISTINCT
          :SearchObjects[j].Object = O.Object,
          :SearchObjects[j].Name = O.Name,
          :SearchObjects[j].TypeName = O.TypeName
   FROM   Udb_Terminal T1,
          Udb_Terminal T2,
          Udb_Object O,
          Udb_ExtendedType ET
   WHERE  T1.Object = :CurObject.Equip AND
          T1.Node >= 20000 AND
          T1.Node = T2.Node AND
          T2.Object = O.Object AND
          O.Type = ET.Type AND
          ET.SuperType = :CurObject.JobAction[i].FeederEquip
   BEGIN 
      j = j + 1;
   END;
*/
   RetCode = Trace.FindAdjacentEquipment(JobEquip = CurObject.Equip,
                                         TargetType = TargetType);
   m = 1;                                      
   FOR i = 1 TO Trace.PathResultList.LastRow DO
      FOR k = 1 TO Trace.PathResultList[i].TargetEquipList.LastRow DO
         SearchObjects[m] = ObjectSummaryClass.Create();
         SearchObjects[m].Object = Trace.PathResultList[i].TargetEquipList[k].Object;
         SearchObjects[m].Name = Trace.PathResultList[i].TargetEquipList[k].Name;
         SearchObjects[m].TypeName = Trace.PathResultList[i].TargetEquipList[k].TypeName;
         SearchObjects[m].PrimaryGrouping = Trace.PathResultList[i].TargetEquipList[k].PrimaryGrouping;
         m = m + 1;
      ENDFOR;
   ENDFOR;
   
   RETURN (SearchObjects);
END;






