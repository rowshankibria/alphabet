   CurObject.Total.IntPFS = CALLPROC CalculateTotal(CT = List_PFS);
   CurObject.Total.PFS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPFS);
   SD_PFS = CALLPROC CalculateStandardDeviation(CT = List_PFS, Total = CurObject.Total.IntPFS);
   IF List_PFS.LastRow() <> 0 THEN
      CurObject.Average.IntPFS = CurObject.Total.IntPFS/List_PFS.LastRow();
      CurObject.Average.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS);
      CurObject.High95.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS + (2*SD_PFS));
      CurObject.High68.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS + SD_PFS);
      IF CurObject.Average.IntPFS - SD_PFS < 0 THEN
         CurObject.Low68.PFS = '0:00';
      ELSE
         CurObject.Low68.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS - SD_PFS);
      ENDIF;
      IF CurObject.Average.IntPFS - (2*SD_PFS) < 0 THEN
         CurObject.Low95.PFS = '0:00';
      ELSE
         CurObject.Low95.PFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFS - (2*SD_PFS));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntPFSS = CALLPROC CalculateTotal(CT = List_PFSS);
   CurObject.Total.PFSS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPFSS);
   SD_PFSS = CALLPROC CalculateStandardDeviation(CT = List_PFSS, Total = CurObject.Total.IntPFSS);
   IF List_PFSS.LastRow() <> 0 THEN
      CurObject.Average.IntPFSS = CurObject.Total.IntPFSS/List_PFSS.LastRow();
      CurObject.Average.PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSS);
      CurObject.High95.PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSS + (2*SD_PFSS));
      CurObject.High68.PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSS + SD_PFSS);
      IF CurObject.Average.IntPFSS - SD_PFSS < 0 THEN
         CurObject.Low68.PFSS = '0:00';
      ELSE
         CurObject.Low68.PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSS - SD_PFSS);
      ENDIF;
      IF CurObject.Average.IntPFSS - (2*SD_PFSS) < 0 THEN
         CurObject.Low95.PFSS = '0:00';
      ELSE
         CurObject.Low95.PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSS - (2*SD_PFSS));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntPFSF = CALLPROC CalculateTotal(CT = List_PFSF);
   CurObject.Total.PFSF  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntPFSF);
   SD_PFSF = CALLPROC CalculateStandardDeviation(CT = List_PFSF, Total = CurObject.Total.IntPFSF);
   IF List_PFSF.LastRow() <> 0 THEN
      CurObject.Average.IntPFSF = CurObject.Total.IntPFSF/List_PFSF.LastRow();
      CurObject.Average.PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSF);
      CurObject.High95.PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSF + (2*SD_PFSF));
      CurObject.High68.PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSF + SD_PFSF);
      IF CurObject.Average.IntPFSF - SD_PFSF < 0 THEN
         CurObject.Low68.PFSF = '0:00';
      ELSE
         CurObject.Low68.PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSF - SD_PFSF);
      ENDIF;
      IF CurObject.Average.IntPFSF - (2*SD_PFSF) < 0 THEN
         CurObject.Low95.PFSF = '0:00';
      ELSE
         CurObject.Low95.PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntPFSF - (2*SD_PFSF));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntFG = CALLPROC CalculateTotal(CT = List_FG);
   CurObject.Total.FG  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntFG);
   SD_FG = CALLPROC CalculateStandardDeviation(CT = List_FG, Total = CurObject.Total.IntFG);
   IF List_FG.LastRow() <> 0 THEN
      CurObject.Average.IntFG = CurObject.Total.IntFG/List_FG.LastRow();
      CurObject.Average.FG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntFG);
      CurObject.High95.FG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntFG + (2*SD_FG));
      CurObject.High68.FG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntFG + SD_FG);
      IF CurObject.Average.IntFG - SD_FG < 0 THEN
         CurObject.Low68.FG = '0:00';
      ELSE
         CurObject.Low68.FG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntFG - SD_FG);
      ENDIF;
      IF CurObject.Average.IntFG - (2*SD_FG) < 0 THEN
         CurObject.Low95.FG = '0:00';
      ELSE
         CurObject.Low95.FG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntFG - (2*SD_FG));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotISTA = CALLPROC CalculateTotal(CT = List_TotISTA);
   CurObject.Total.TotISTA  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotISTA);
   SD_TotISTA = CALLPROC CalculateStandardDeviation(CT = List_TotISTA, Total = CurObject.Total.IntTotISTA);
   IF List_TotISTA.LastRow() <> 0 THEN
      CurObject.Average.IntTotISTA = CurObject.Total.IntTotISTA/List_TotISTA.LastRow();
      CurObject.Average.TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISTA);
      CurObject.High95.TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISTA + (2*SD_TotISTA));
      CurObject.High68.TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISTA + SD_TotISTA);
      IF CurObject.Average.IntTotISTA - SD_TotISTA < 0 THEN
         CurObject.Low68.TotISTA = '0:00';
      ELSE
         CurObject.Low68.TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISTA - SD_TotISTA);
      ENDIF;
      IF CurObject.Average.IntTotISTA - (2*SD_TotISTA) < 0 THEN
         CurObject.Low95.TotISTA = '0:00';
      ELSE
         CurObject.Low95.TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISTA - (2*SD_TotISTA));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotISL = CALLPROC CalculateTotal(CT = List_TotISL);
   CurObject.Total.TotISL  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotISL);
   SD_TotISL = CALLPROC CalculateStandardDeviation(CT = List_TotISL, Total = CurObject.Total.IntTotISL);
   IF List_TotISL.LastRow() <> 0 THEN
      CurObject.Average.IntTotISL = CurObject.Total.IntTotISL/List_TotISL.LastRow();
      CurObject.Average.TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISL);
      CurObject.High95.TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISL + (2*SD_TotISL));
      CurObject.High68.TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISL + SD_TotISL);
      IF CurObject.Average.IntTotISL - SD_TotISL < 0 THEN
         CurObject.Low68.TotISL = '0:00';
      ELSE
         CurObject.Low68.TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISL - SD_TotISL);
      ENDIF;
      IF CurObject.Average.IntTotISL - (2*SD_TotISL) < 0 THEN
         CurObject.Low95.TotISL = '0:00';
      ELSE
         CurObject.Low95.TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotISL - (2*SD_TotISL));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotSTG = CALLPROC CalculateTotal(CT = List_TotSTG);
   CurObject.Total.TotSTG  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotSTG);
   SD_TotSTG = CALLPROC CalculateStandardDeviation(CT = List_TotSTG, Total = CurObject.Total.IntTotSTG);
   IF List_TotSTG.LastRow() <> 0 THEN
      CurObject.Average.IntTotSTG = CurObject.Total.IntTotSTG/List_TotSTG.LastRow();
      CurObject.Average.TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotSTG);
      CurObject.High95.TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotSTG + (2*SD_TotSTG));
      CurObject.High68.TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotSTG + SD_TotSTG);
      IF CurObject.Average.IntTotSTG - SD_TotSTG < 0 THEN
         CurObject.Low68.TotSTG = '0:00';
      ELSE
         CurObject.Low68.TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotSTG - SD_TotSTG);
      ENDIF;
      IF CurObject.Average.IntTotSTG - (2*SD_TotSTG) < 0 THEN
         CurObject.Low95.TotSTG = '0:00';
      ELSE
         CurObject.Low95.TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotSTG - (2*SD_TotSTG));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotOTW = CALLPROC CalculateTotal(CT = List_TotOTW);
   CurObject.Total.TotOTW  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotOTW);
   SD_TotOTW = CALLPROC CalculateStandardDeviation(CT = List_TotOTW, Total = CurObject.Total.IntTotOTW);
   IF List_TotOTW.LastRow() <> 0 THEN
      CurObject.Average.IntTotOTW = CurObject.Total.IntTotOTW/List_TotOTW.LastRow();
      CurObject.Average.TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotOTW);
      CurObject.High95.TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotOTW + (2*SD_TotOTW));
      CurObject.High68.TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotOTW + SD_TotOTW);
      IF CurObject.Average.IntTotOTW - SD_TotOTW < 0 THEN
         CurObject.Low68.TotOTW = '0:00';
      ELSE
         CurObject.Low68.TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotOTW - SD_TotOTW);
      ENDIF;
      IF CurObject.Average.IntTotOTW - (2*SD_TotOTW) < 0 THEN
         CurObject.Low95.TotOTW = '0:00';
      ELSE
         CurObject.Low95.TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotOTW - (2*SD_TotOTW));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotILOC = CALLPROC CalculateTotal(CT = List_TotILOC);
   CurObject.Total.TotILOC  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotILOC);
   SD_TotILOC = CALLPROC CalculateStandardDeviation(CT = List_TotILOC, Total = CurObject.Total.IntTotILOC);
   IF List_TotILOC.LastRow() <> 0 THEN
      CurObject.Average.IntTotILOC = CurObject.Total.IntTotILOC/List_TotILOC.LastRow();
      CurObject.Average.TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotILOC);
      CurObject.High95.TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotILOC + (2*SD_TotILOC));
      CurObject.High68.TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotILOC + SD_TotILOC);
      IF CurObject.Average.IntTotILOC - SD_TotILOC < 0 THEN
         CurObject.Low68.TotILOC = '0:00';
      ELSE
         CurObject.Low68.TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotILOC - SD_TotILOC);
      ENDIF;
      IF CurObject.Average.IntTotILOC - (2*SD_TotILOC) < 0 THEN
         CurObject.Low95.TotILOC = '0:00';
      ELSE
         CurObject.Low95.TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotILOC - (2*SD_TotILOC));
      ENDIF;    
   ENDIF;


   CurObject.Total.IntTotFPFS = CALLPROC CalculateTotal(CT = List_TotFPFS);
   CurObject.Total.TotFPFS  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.IntTotFPFS);
   SD_TotFPFS = CALLPROC CalculateStandardDeviation(CT = List_TotFPFS, Total = CurObject.Total.IntTotFPFS);
   IF List_TotFPFS.LastRow() <> 0 THEN
      CurObject.Average.IntTotFPFS = CurObject.Total.IntTotFPFS/List_TotFPFS.LastRow();
      CurObject.Average.TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotFPFS);
      CurObject.High95.TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotFPFS + (2*SD_TotFPFS));
      CurObject.High68.TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotFPFS + SD_TotFPFS);
      IF CurObject.Average.IntTotFPFS - SD_TotFPFS < 0 THEN
         CurObject.Low68.TotFPFS = '0:00';
      ELSE
         CurObject.Low68.TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotFPFS - SD_TotFPFS);
      ENDIF;
      IF CurObject.Average.IntTotFPFS - (2*SD_TotFPFS) < 0 THEN
         CurObject.Low95.TotFPFS = '0:00';
      ELSE
         CurObject.Low95.TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.Average.IntTotFPFS - (2*SD_TotFPFS));
      ENDIF;    
   ENDIF;


   CurObject.Total.Int_TotDuration = CALLPROC CalculateTotal(CT = List_TotDuration);
/*
**  Subtract out OTWPlus time.
*/
   CurObject.Total.Int_TotDuration = CurObject.Total.Int_TotDuration - CurObject.Total.IntOTWPlus; 
   CurObject.Total.Char_TotDuration  = CALLPROC ConvertHour(Tot_Min = CurObject.Total.Int_TotDuration);
   SD_TotDuration = CALLPROC CalculateStandardDeviation(CT = List_TotDuration, Total = CurObject.Total.Int_TotDuration);
   IF List_TotDuration.LastRow() <> 0 THEN
      CurObject.Average.Int_TotDuration = CurObject.Total.Int_TotDuration/List_TotDuration.LastRow();
      CurObject.Average.Char_TotDuration = CALLPROC ConvertHour(Tot_Min = CurObject.Average.Int_TotDuration);
      CurObject.High95.Char_TotDuration = CALLPROC ConvertHour(Tot_Min = CurObject.Average.Int_TotDuration + (2*SD_TotDuration));
      CurObject.High68.Char_TotDuration = CALLPROC ConvertHour(Tot_Min = CurObject.Average.Int_TotDuration + SD_TotDuration);
      IF CurObject.Average.Int_TotDuration - SD_TotDuration < 0 THEN
         CurObject.Low68.Char_TotDuration = '0:00';
      ELSE
         CurObject.Low68.Char_TotDuration = CALLPROC ConvertHour(Tot_Min = CurObject.Average.Int_TotDuration - SD_TotDuration);
      ENDIF;
      IF CurObject.Average.Int_TotDuration - (2*SD_TotDuration) < 0 THEN
         CurObject.Low95.Char_TotDuration = '0:00';
      ELSE
         CurObject.Low95.Char_TotDuration = CALLPROC ConvertHour(Tot_Min = CurObject.Average.Int_TotDuration - (2*SD_TotDuration));
      ENDIF;    
   ENDIF;




   RETURN;
END;


METHOD Load_ReportExclusionReason 
( 
   ExcludedFrom = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder History Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   CurObject.Comment = '';


   SELECT :CurObject.Comment = Reason
   FROM   FMS_FRTExclusion
   WHERE  Card = :CurObject.Card AND
          ExcludedFrom = :ExcludedFrom;
   CALLPROC DDB_ROLLBACK;


   RETURN;
END;


METHOD MoveToHistoryException
( 
)=
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   RetCode = CALLPROC FMS_FRTExclusionIns(
                          Card = CurObject.Card,
                          ExcludedFrom = 0,
                          Reason = CurObject.Comment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.MoveToHistoryException ' + 
                       'failed to insert reason for card ' + VARCHAR(CurObject.Card) + 
                       ' into FMS_FRTExclusion table.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to insert the reason into the database.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;


   RETURN;   
END;


METHOD MoveToHistoryReport
( 
)=
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   RetCode = CALLPROC FMS_FRTExclusionDel(Card = CurObject.Card);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.MoveToHistoryReport ' + 
                       'failed to delete reason for card ' + VARCHAR(CurObject.Card) + 
                       ' from FMS_FRTExclusion table.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to delete the reason from the database.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;


   RETURN;   
END;


METHOD Load_FeederMilestoneData (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1000);
   WhereClause3G = VARCHAR(1000);
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   Tot_Min = INTEGER NOT NULL;
   TempDuration = INTEGER NOT NULL;
   TotalDelayCnt = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   OS = ARRAY OF OperatingStepStatusClass;
   STABogey = INTEGER NOT NULL;		/* should not be used.*/
   ESTBogey = INTEGER NOT NULL;
   LOCBogey = INTEGER NOT NULL;
   IDBogey = INTEGER NOT NULL;
   OTWBogey = INTEGER NOT NULL;
   OTWPlusBogey = INTEGER NOT NULL;
   TESTBogey = INTEGER NOT NULL;
   PFSBogey = INTEGER NOT NULL;
   PFSSBogey = INTEGER NOT NULL;
   PFSFBogey = INTEGER NOT NULL;
   DMBogey = INTEGER NOT NULL;
   RGBogey = INTEGER NOT NULL;
   TGBogey = INTEGER NOT NULL;
   TCBogey = INTEGER NOT NULL;
   RGTCBogey = INTEGER NOT NULL;
   ISOBogey = INTEGER NOT NULL;		/* should not be used.*/
   ISTABogey = INTEGER NOT NULL;
   ABFBogey = INTEGER NOT NULL;
   INSPBogey = INTEGER NOT NULL;
   OTWRBogey = INTEGER NOT NULL;	/* should not be used.*/
   OTWSBogey = INTEGER NOT NULL;	/* should not be used.*/
   PFWBogey  = INTEGER NOT NULL;
   FGBogey = INTEGER NOT NULL;
   OOSBogey = INTEGER NOT NULL;


   STABogeyTV = INTEGER NOT NULL;		/* should not be used.*/
   ESTBogeyTV = INTEGER NOT NULL;
   LOCBogeyTV = INTEGER NOT NULL;
   IDBogeyTV = INTEGER NOT NULL;
   OTWBogeyTV = INTEGER NOT NULL;
   OTWPlusBogeyTV = INTEGER NOT NULL;
   TESTBogeyTV = INTEGER NOT NULL;
   PFSBogeyTV = INTEGER NOT NULL;
   PFSSBogeyTV = INTEGER NOT NULL;
   PFSFBogeyTV = INTEGER NOT NULL;
   DMBogeyTV = INTEGER NOT NULL;
   RGBogeyTV = INTEGER NOT NULL;
   TGBogeyTV = INTEGER NOT NULL;
   TCBogeyTV = INTEGER NOT NULL;
   RGTCBogeyTV = INTEGER NOT NULL;
   ISOBogeyTV = INTEGER NOT NULL;		/* should not be used.*/
   ISTABogeyTV = INTEGER NOT NULL;
   ABFBogeyTV = INTEGER NOT NULL;
   INSPBogeyTV = INTEGER NOT NULL;
   OTWRBogeyTV = INTEGER NOT NULL;	/* should not be used.*/
   OTWSBogeyTV = INTEGER NOT NULL;	/* should not be used.*/
   PFWBogeyTV  = INTEGER NOT NULL;
   FGBogeyTV = INTEGER NOT NULL;
   OOSBogeyTV = INTEGER NOT NULL;


   TempStep = INTEGER NOT NULL;
   TempBogey = INTEGER NOT NULL;
   TVForecast         = FLOAT NOT NULL;
   TVDayAhead         = FLOAT NOT NULL;
   TV_Bogey           = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder Milestone Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Get TV information
*/
   SELECT :CurObject.BogeyEnabled = TM_BogeyEnabled
   FROM   FMS_SystemParameters;
   CALLPROC DDB_ROLLBACK; 
   /*
   **  IF BogeyEnabled is TRUE, then we need to figure out what the TV
   **  Forecast values are and build a text string.
   */
   IF CurObject.BogeyEnabled = TRUE THEN
      TVForecast = 0;
      SELECT :TVForecast = B.Forecast,
             :TVDayAhead = B.DayAhead
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory);
      CALLPROC DDB_ROLLBACK;
      
      IF TVForecast = 0 THEN
         CurObject.TV_Text = 'NOT ENTERED';     
      ELSE  
         CurObject.TV_Text = 'Today: ' + 
            left(varchar(TVForecast),(locate(varchar(TVForecast),'.')+2)) + 
            ' Tomorrow: ' + 
            left(varchar(TVDayAhead),(locate(varchar(TVDayAhead),'.')+2));
      ENDIF;
   ENDIF;   
/*   
**  Establish bogey timers for each step.
*/
   TempStep = 0;  
   SELECT :TempStep = T.Status,
          :TempBogey = T.BogeyAlert
   FROM   TM_BogeyType T
   WHERE  T.Type = :Type$OperatingStepStatus OR
         (T.Type = :TM$OtherType AND
          T.Status = :TM$StatusOutOfService)
   BEGIN
      IF TempStep = Type$STA THEN
         STABogey = TempBogey;
      ELSEIF TempStep = Type$EST THEN
         ESTBogey = TempBogey;
      ELSEIF TempStep = Type$LOC THEN
         LOCBogey = TempBogey;
      ELSEIF TempStep = Type$ID THEN
         IDBogey = TempBogey;
      ELSEIF TempStep = Type$OTW THEN
         OTWBogey = TempBogey;
      ELSEIF TempStep = Type$OTWPlus THEN
         OTWPlusBogey = TempBogey;
      ELSEIF TempStep = Type$TEST THEN
         TESTBogey = TempBogey;
      ELSEIF TempStep = Type$PFS THEN
         PFSBogey = TempBogey;
      ELSEIF TempStep = Type$PFSS THEN
         PFSSBogey = TempBogey;
      ELSEIF TempStep = Type$PFSF THEN
         PFSFBogey = TempBogey;
      ELSEIF TempStep = Type$DM THEN
         DMBogey = TempBogey;
      ELSEIF TempStep = Type$RG THEN
         RGBogey = TempBogey;
      ELSEIF TempStep = Type$TG THEN
         TGBogey = TempBogey;
      ELSEIF TempStep = Type$TC THEN
         TCBogey = TempBogey;
      ELSEIF TempStep = Type$RGTC THEN
         RGTCBogey = TempBogey;
      ELSEIF TempStep = Type$ISOStep THEN
         ISOBogey = TempBogey;
      ELSEIF TempStep = Type$ISTA THEN
         ISTABogey = TempBogey;
      ELSEIF TempStep = Type$ABF THEN
         ABFBogey = TempBogey;
      ELSEIF TempStep = Type$INSP THEN
         INSPBogey = TempBogey;
      ELSEIF TempStep = Type$OTWR THEN
         OTWRBogey = TempBogey;
      ELSEIF TempStep = Type$OTWS THEN
         OTWSBogey = TempBogey;
      ELSEIF TempStep = Type$PFW THEN
         PFWBogey = TempBogey;
      ELSEIF TempStep = Type$FG THEN
         FGBogey = TempBogey;


      ELSEIF TempStep = TM$StatusOutOfService THEN
         OOSBogey = TempBogey;
      ENDIF;
   END;
/*   
**  Establish Temperature Variables bogey timers for each step.
*/
   TempStep = 0;  
   SELECT :TempStep = T.Status,
          :TempBogey = T.BogeyAlert
   FROM   TM_BogeyType T
   WHERE  T.Type = :TM$TVBogey OR
         (T.Type = :TM$TVOtherType AND
          T.Status = :TM$StatusOutOfService)
   BEGIN
      IF TempStep = Type$STA THEN
         STABogeyTV = TempBogey;
      ELSEIF TempStep = Type$EST THEN
         ESTBogeyTV = TempBogey;
      ELSEIF TempStep = Type$LOC THEN
         LOCBogeyTV = TempBogey;
      ELSEIF TempStep = Type$ID THEN
         IDBogeyTV = TempBogey;
      ELSEIF TempStep = Type$OTW THEN
         OTWBogeyTV = TempBogey;
      ELSEIF TempStep = Type$OTWPlus THEN
         OTWPlusBogeyTV = TempBogey;
      ELSEIF TempStep = Type$TEST THEN
         TESTBogeyTV = TempBogey;
      ELSEIF TempStep = Type$PFS THEN
         PFSBogeyTV = TempBogey;
      ELSEIF TempStep = Type$PFSS THEN
         PFSSBogeyTV = TempBogey;
      ELSEIF TempStep = Type$PFSF THEN
         PFSFBogeyTV = TempBogey;
      ELSEIF TempStep = Type$DM THEN
         DMBogeyTV = TempBogey;
      ELSEIF TempStep = Type$RG THEN
         RGBogeyTV = TempBogey;
      ELSEIF TempStep = Type$TG THEN
         TGBogeyTV = TempBogey;
      ELSEIF TempStep = Type$TC THEN
         TCBogeyTV = TempBogey;
      ELSEIF TempStep = Type$RGTC THEN
         RGTCBogeyTV = TempBogey;
      ELSEIF TempStep = Type$ISOStep THEN
         ISOBogeyTV = TempBogey;
      ELSEIF TempStep = Type$ISTA THEN
         ISTABogeyTV = TempBogey;
      ELSEIF TempStep = Type$ABF THEN
         ABFBogeyTV = TempBogey;
      ELSEIF TempStep = Type$INSP THEN
         INSPBogeyTV = TempBogey;
      ELSEIF TempStep = Type$OTWR THEN
         OTWRBogeyTV = TempBogey;
      ELSEIF TempStep = Type$OTWS THEN
         OTWSBogeyTV = TempBogey;
      ELSEIF TempStep = Type$PFW THEN
         PFWBogeyTV = TempBogey;
      ELSEIF TempStep = Type$FG THEN
         FGBogeyTV = TempBogey;
      ELSEIF TempStep = TM$StatusOutOfService THEN
         OOSBogeyTV = TempBogey;
      ENDIF;
   END;




   
   DynamicWhereClause = 'C.CutOut IS NOT NULL AND C.Cutout <> '' '' AND C.Cutin IS NULL AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = CTO.Card AND CTO.Object = O2.Object AND O2.PrimaryGrouping = O.Object AND ' +
           'O.PrimaryGrouping IN ( ';


   WhereClause3G = 'C.CutOut IS NOT NULL AND C.Cutout <> '' '' AND C.Cutin IS NULL AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = CTO.Card AND CTO.Object = O.Object AND ' +
           'O.PrimaryGrouping IN ( ';
      
      IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
         If lowercase(CurObject.DivisionName) like 'all%' THEN
            /*
            **  Load Division table
            */
            IF SimpleDivision IS NULL THEN
               SimpleDivision = Division_ASE.Create();
            ENDIF;
         
            SimpleDivision.LoadDivisions();
         
            IF SimpleDivision.ReturnCode = 0 THEN
               i = 1;
               WHILE i <= SimpleDivision.Dlist.LastRow() DO
                  EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
                  i = i + 1;
               ENDWHILE;
            ELSE
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
               SimpleDivision = NULL;
               RETURN;
            ENDIF;
            SimpleDivision = NULL;
            
         ELSE
            IF CurObject.Division <> 0 THEN
               EffectiveDivisions[1].Object = CurObject.Division;
            ELSE
               i = 1;
               WHILE LENGTH(CurObject.DivisionName) > 0 DO
                  CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
                  EffectiveDivisions[i].Object = CurObject.Division;
                  i = i + 1;
                  CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
               ENDWHILE;
            ENDIF;  
            
         ENDIF;
      ENDIF;


      i = 1;
      WHILE i <= EffectiveDivisions.LastRow() DO
 
         IF i = EffectiveDivisions.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';
            
            WhereClause3G = WhereClause3G + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';
            
            WhereClause3G = WhereClause3G + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';
         ENDIF;
         i = i + 1;
      ENDWHILE;


   CurObject.OSS.Clear();
   i = 1;
   SELECT  :CurObject.OSS[i].Card = C.Card,
           :CurObject.OSS[i].SubstationName = C.SubstationName,
           :CurObject.OSS[i].Feeder = C.Feeder,
           :CurObject.OSS[i].FeederName = C.FeederName,
           :CurObject.OSS[i].Cutout = IFNULL(C.Cutout,''),
           :CurObject.OSS[i].Cutin = IFNULL(C.Cutin,''),
           :CurObject.OSS[i].OpenAutoPlus = IFNULL(C.OpenAutoPlus,''),
           :CurObject.OSS[i].EstTimeInService = C.EstTimeInService,
           :CurObject.OSS[i].CardClass = C.CardClass,
           :CurObject.OSS[i].CardClassName = C.CardClassName,
           :TV_Bogey = C.TV_Bogey
   FROM    FMS_Card C,
           TFMS_CardToObject CTO,
           Udb_Object O,
           Udb_Object O2 
   WHERE   :DynamicWhereClause
   UNION
   SELECT  C.Card,
           C.SubstationName,
           C.Feeder,
           C.FeederName,
           IFNULL(C.Cutout,''),
           IFNULL(C.Cutin,''),
           IFNULL(C.OpenAutoPlus,''),
           C.EstTimeInService,
           C.CardClass,
           C.CardClassName,
           C.TV_Bogey
   FROM    FMS_Card C,
           TFMS_CardToObject CTO,
           Udb_Object O 
   WHERE   :WhereClause3G
   
   ORDER BY SubstationName,FeederName
   BEGIN
/*
**  Look for open auto plus and FOT Count
*/  
      IF (CurObject.OSS[i].CardClass = Type$Auto OR CurObject.OSS[i].CardClass = Type$CIOA) AND
         CurObject.OSS[i].OpenAutoPlus IS NOT NULL AND CurObject.OSS[i].OpenAutoPlus <> '' THEN
         CurObject.OSS[i].CardClassName = CurObject.OSS[i].CardClassName + '+';
      ENDIF;
/*
**  Show all TV Bogey Reason field in reverse video.
*/ 
      IF CurObject.BogeyEnabled = TRUE AND TV_Bogey > 0 THEN
         CurObject.OSS[i].CardClass_Reverse = TRUE; 
         IF TV_Bogey = 1 OR TV_Bogey = 11 THEN
            CurObject.OSS[i].TV_Reason = 'Triggered by Actual TV Forecast';
         ELSEIF TV_Bogey = 2 OR TV_Bogey = 12 THEN
            CurObject.OSS[i].TV_Reason = 'Triggered by Current TV Forecast';            
         ELSEIF TV_Bogey = 3 OR TV_Bogey = 13 THEN
            CurObject.OSS[i].TV_Reason = 'Triggered by Day Ahead TV Forecast';
         ENDIF;        
      ENDIF;


      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;


   j = 1;
   WHILE j <= CurObject.OSS.LastRow() DO
      REPEATED
      SELECT :CurObject.OSS[j].NetWork = O.Name
      FROM   UDB_OBJECT O,
             UDB_GROUPING G,
             TFMS_CardToObject CTO
      WHERE  CTO.Card = :CurObject.OSS[j].Card AND
             CTO.Object = G.Member AND
             G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) and
             G.GroupingType = :Type$Network and
             O.Object = G.Grouping;
      j = j + 1;
   ENDWHILE; 
   CALLPROC DDB_ROLLBACK;    


   j = 1;
   WHILE j <= CurObject.OSS.LastRow() DO
      i = 1;
      k = 0;
      TotalDelayCnt = 0;
      OS.Clear();
      REPEATED
      SELECT :OS[i].OperatingStep = OS.OperatingStep,
             :OS[i].OperatingStepName = OS.OperatingStepName,
             :OS[i].StartTime = OS.StartTime,
             :OS[i].EndTime = OS.EndTime,
             :OS[i].DurationMins = OS.DurationMins,
             :OS[i].Description = T.Description
      FROM   FMS_OperatingStepStatus OS,
             Udb_ExtendedType ET,
             Udb_Type T
      WHERE  OS.Card = :CurObject.OSS[j].Card AND
             OS.OperatingStep = ET.Type AND
             ET.SuperType = :Type$OperatingStepStatus AND
             ET.Type = T.Type
      BEGIN
         IF OS[i].OperatingStep = Type$STA THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntSTA <> 0 THEN
                  CurObject.OSS[j].STAColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].STAColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntSTA = CurObject.OSS[j].IntSTA + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntSTA <> 0 THEN
                  CurObject.OSS[j].STAColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].STAColor = CC_FOREGROUND;                 
               ENDIF;


               CurObject.OSS[j].IntSTA = CurObject.OSS[j].IntSTA + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].STA = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntSTA);


         ELSEIF OS[i].OperatingStep = Type$ISTA THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntISTA <> 0 THEN
                  CurObject.OSS[j].ISTAColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ISTAColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntISTA = CurObject.OSS[j].IntISTA + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntISTA <> 0 THEN
                  CurObject.OSS[j].ISTAColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ISTAColor = CC_FOREGROUND;                 
               ENDIF;


               CurObject.OSS[j].IntISTA = CurObject.OSS[j].IntISTA + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ISTA = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntISTA);


         ELSEIF OS[i].OperatingStep = Type$ISOStep THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntISO <> 0 THEN
                  CurObject.OSS[j].ISOColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ISOColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntISO = CurObject.OSS[j].IntISO + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntISO <> 0 THEN
                  CurObject.OSS[j].ISOColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ISOColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntISO = CurObject.OSS[j].IntISO + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ISO = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntISO);


         ELSEIF OS[i].OperatingStep = Type$ABF THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntABF <> 0 THEN
                  CurObject.OSS[j].ABFColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ABFColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntABF = CurObject.OSS[j].IntABF + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntABF <> 0 THEN
                  CurObject.OSS[j].ABFColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ABFColor = CC_FOREGROUND;                 
               ENDIF;


               CurObject.OSS[j].IntABF = CurObject.OSS[j].IntABF + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ABF = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntABF);


            IF ((CurObject.OSS[j].IntABF > ABFBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntABF > ABFBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].ABFColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$EST THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntEST <> 0 THEN
                  CurObject.OSS[j].ESTColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].ESTColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntEST = CurObject.OSS[j].IntEST + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntEST <> 0 THEN
                  CurObject.OSS[j].ESTColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].ESTColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntEST = CurObject.OSS[j].IntEST + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].EST = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntEST);


            IF ((CurObject.OSS[j].IntEST > ESTBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntEST > ESTBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].ESTColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$LOC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntLOC <> 0 THEN
                  CurObject.OSS[j].LOCColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].LOCColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntLOC = CurObject.OSS[j].IntLOC + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntLOC <> 0 THEN
                  CurObject.OSS[j].LOCColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].LOCColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntLOC = CurObject.OSS[j].IntLOC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].LOC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntLOC);


            IF ((CurObject.OSS[j].IntLOC > LOCBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntLOC > LOCBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].LOCColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$INSP THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntINSP <> 0 THEN
                  CurObject.OSS[j].INSPColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].INSPColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntINSP = CurObject.OSS[j].IntINSP + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntINSP <> 0 THEN
                  CurObject.OSS[j].INSPColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].INSPColor = CC_FOREGROUND;                 
               ENDIF;


               CurObject.OSS[j].IntINSP = CurObject.OSS[j].IntINSP + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].INSP = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntINSP);


            IF ((CurObject.OSS[j].IntINSP > INSPBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntINSP > INSPBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].INSPColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$DM THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntDM <> 0 THEN
                  CurObject.OSS[j].DMColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].DMColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntDM = CurObject.OSS[j].IntDM + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntDM <> 0 THEN
                  CurObject.OSS[j].DMColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].DMColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntDM = CurObject.OSS[j].IntDM + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].DM = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntDM);


            IF ((CurObject.OSS[j].IntDM > DMBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntDM > DMBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].DMColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$RG THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntRG <> 0 THEN
                  CurObject.OSS[j].RGColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].RGColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntRG = CurObject.OSS[j].IntRG + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntRG <> 0 THEN
                  CurObject.OSS[j].RGColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].RGColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntRG = CurObject.OSS[j].IntRG + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].RG = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntRG);


            IF ((CurObject.OSS[j].IntRG > RGBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntRG > RGBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].RGColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$TG THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntTG <> 0 THEN
                  CurObject.OSS[j].TGColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].TGColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntTG = CurObject.OSS[j].IntTG + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntTG <> 0 THEN
                  CurObject.OSS[j].TGColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].TGColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntTG = CurObject.OSS[j].IntTG + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].TG = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTG);


            IF ((CurObject.OSS[j].IntTG > TGBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntTG > TGBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].TGColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$TC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntTC <> 0 THEN
                  CurObject.OSS[j].TCColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].TCColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntTC = CurObject.OSS[j].IntTC + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntTC <> 0 THEN
                  CurObject.OSS[j].TCColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].TCColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntTC = CurObject.OSS[j].IntTC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].TC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTC);


            IF ((CurObject.OSS[j].IntTC > TCBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntTC > TCBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].TCColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$RGTC THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntRGTC <> 0 THEN
                  CurObject.OSS[j].RGTCColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].RGTCColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntRGTC = CurObject.OSS[j].IntRGTC + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntRGTC <> 0 THEN
                  CurObject.OSS[j].RGTCColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].RGTCColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntRGTC = CurObject.OSS[j].IntRGTC + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].RGTC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntRGTC);


            IF ((CurObject.OSS[j].IntRGTC > RGTCBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntRGTC > RGTCBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].RGTCColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$ID THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntID <> 0 THEN
                  CurObject.OSS[j].IDColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].IDColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntID = CurObject.OSS[j].IntID + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntID <> 0 THEN
                  CurObject.OSS[j].IDColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].IDColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntID = CurObject.OSS[j].IntID + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].ID = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntID);


            IF ((CurObject.OSS[j].IntID > IDBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntID > IDBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].IDColor = CC_RED;
            ENDIF;
         ELSEIF OS[i].OperatingStep = Type$OTW THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTW <> 0 THEN
                  CurObject.OSS[j].OTWColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTW = CurObject.OSS[j].IntOTW + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTW <> 0 THEN
                  CurObject.OSS[j].OTWColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntOTW = CurObject.OSS[j].IntOTW + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTW = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTW);
           
            /* 5/28/04 combine OTW/OTWR+OTWS to OTW
            **
            IF CurObject.OSS[j].IntOTW > OTWBogey AND 
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].OTWColor = CC_RED;
            ENDIF;
            */
         ELSEIF OS[i].OperatingStep = Type$OTWPlus THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTWPlus <> 0 THEN
                  CurObject.OSS[j].OTWPlusColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWPlusColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTWPlus = CurObject.OSS[j].IntOTWPlus + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTWPlus <> 0 THEN
                  CurObject.OSS[j].OTWPlusColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWPlusColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntOTWPlus = CurObject.OSS[j].IntOTWPlus + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTWPlus = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWPlus);


/*
**   We aren't checking bogey colors for OTW+.  If we were, a row would
**   need to be added to the TM_BogeyType table for OTW+.
**
            IF CurObject.OSS[j].IntOTWPlus > OTWPlusBogey AND 
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].OTWPlusColor = CC_RED;
            ENDIF;
*/
         ELSEIF OS[i].OperatingStep = Type$PFW THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPFW <> 0 THEN
                  CurObject.OSS[j].PFWColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PFWColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPFW = CurObject.OSS[j].IntPFW + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPFW <> 0 THEN
                  CurObject.OSS[j].PFWColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PFWColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntPFW = CurObject.OSS[j].IntPFW + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PFW = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFW);


            IF ((CurObject.OSS[j].IntPFW > PFWBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntPFW > PFWBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].PFWColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$OTWR THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTWR <> 0 THEN
                  CurObject.OSS[j].OTWRColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWRColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTWR = CurObject.OSS[j].IntOTWR + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTWR <> 0 THEN
                  CurObject.OSS[j].OTWRColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWRColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntOTWR = CurObject.OSS[j].IntOTWR + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTWR = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWR);


            /* 5/28/04 combine OTW/OTWR+OTWS to OTW
            **
            IF CurObject.OSS[j].IntOTWR > OTWRBogey AND 
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) THEN


               CurObject.OSS[j].OTWRColor = CC_RED;
            ENDIF;
            */
         ELSEIF OS[i].OperatingStep = Type$OTWS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntOTWS <> 0 THEN
                  CurObject.OSS[j].OTWSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].OTWSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntOTWS = CurObject.OSS[j].IntOTWS + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntOTWS <> 0 THEN
                  CurObject.OSS[j].OTWSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].OTWSColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntOTWS = CurObject.OSS[j].IntOTWS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].OTWS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntOTWS);


            /* 5/28/04 combine OTW/OTWR+OTWS to OTW
            **
            IF CurObject.OSS[j].IntOTWS > OTWSBogey AND 
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) THEN


               CurObject.OSS[j].OTWSColor = CC_RED;
            ENDIF;
            */ 
         ELSEIF OS[i].OperatingStep = Type$TEST THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntTEST <> 0 THEN
                  CurObject.OSS[j].TESTColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].TESTColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntTEST = CurObject.OSS[j].IntTEST + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntTEST <> 0 THEN
                  CurObject.OSS[j].TESTColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].TESTColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntTEST = CurObject.OSS[j].IntTEST + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].TEST = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTEST);


            IF ((CurObject.OSS[j].IntTEST > TESTBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntTEST > TESTBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].TESTColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$PFS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPFS <> 0 THEN
                  CurObject.OSS[j].PFSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PFSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPFS = CurObject.OSS[j].IntPFS + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPFS <> 0 THEN
                  CurObject.OSS[j].PFSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PFSColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntPFS = CurObject.OSS[j].IntPFS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PFS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFS);


            IF ((CurObject.OSS[j].IntPFS > PFSBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntPFS > PFSBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].PFSColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$PFSS THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPFSS <> 0 THEN
                  CurObject.OSS[j].PFSSColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PFSSColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPFSS = CurObject.OSS[j].IntPFSS + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPFSS <> 0 THEN
                  CurObject.OSS[j].PFSSColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PFSSColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntPFSS = CurObject.OSS[j].IntPFSS + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PFSS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFSS);


            IF ((CurObject.OSS[j].IntPFSS > PFSSBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntPFSS > PFSSBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].PFSSColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$PFSF THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntPFSF <> 0 THEN
                  CurObject.OSS[j].PFSFColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].PFSFColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntPFSF = CurObject.OSS[j].IntPFSF + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntPFSF <> 0 THEN
                  CurObject.OSS[j].PFSFColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].PFSFColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntPFSF = CurObject.OSS[j].IntPFSF + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].PFSF = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntPFSF);


            IF ((CurObject.OSS[j].IntPFSF > PFSFBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntPFSF > PFSFBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].PFSFColor = CC_RED;
            ENDIF;


         ELSEIF OS[i].OperatingStep = Type$FG THEN
            IF OS[i].EndTime = '' THEN
               IF CurObject.OSS[j].IntFG <> 0 THEN
                  CurObject.OSS[j].FGColor = CC_LIGHT_BLUE;
               ELSE
                  CurObject.OSS[j].FGColor = CC_BLUE;
               ENDIF;
               CurObject.OSS[j].IntFG = CurObject.OSS[j].IntFG + INT4(interval('minute', DATE('NOW') - DATE(OS[i].StartTime)));
            ELSE
               IF CurObject.OSS[j].IntFG <> 0 THEN
                  CurObject.OSS[j].FGColor = CC_LIGHT_GRAY;
               ELSE
                  CurObject.OSS[j].FGColor = CC_FOREGROUND;
               ENDIF;


               CurObject.OSS[j].IntFG = CurObject.OSS[j].IntFG + OS[i].DurationMins;
            ENDIF;
            CurObject.OSS[j].FG = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntFG);


            IF ((CurObject.OSS[j].IntFG > FGBogey AND 
                 CurObject.OSS[j].CardClass_Reverse = FALSE) OR
                (CurObject.OSS[j].IntFG > FGBogeyTV AND 
                 CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
              (CurObject.OSS[j].CardClass = Type$Auto OR
               CurObject.OSS[j].CardClass = Type$CIOA OR
               CurObject.OSS[j].CardClass = Type$FOT) AND
               CurObject.BogeyEnabled = TRUE THEN


               CurObject.OSS[j].FGColor = CC_RED;
            ENDIF;


         ELSE   /* Delays */
            IF OS[i].EndTime <> '' THEN
               TotalDelayCnt = TotalDelayCnt + OS[i].DurationMins;
            ELSE         
               TotalDelayCnt = TotalDelayCnt + INT4(interval('minute', DATE('NOW') -
                               DATE(OS[i].StartTime)));
            ENDIF;
            k = k + 1;
         ENDIF;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      IF k > 0 THEN
         CurObject.OSS[j].Char_TotDuration = CALLPROC ConvertHour(Tot_Min = TotalDelayCnt);
         CurObject.OSS[j].Delays = k;
      ENDIF;
/*
** The ISTA bogey time applys to ISO/STA/ISTA. 
*/ 
      TempDuration = CurObject.OSS[j].IntISO + 
                     CurObject.OSS[j].IntISTA + 
                     CurObject.OSS[j].IntSTA;


      IF ((TempDuration > ISTABogey AND 
           CurObject.OSS[j].CardClass_Reverse = FALSE) OR
          (TempDuration > ISTABogeyTV AND 
           CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
        (CurObject.OSS[j].CardClass = Type$Auto OR
         CurObject.OSS[j].CardClass = Type$CIOA OR
         CurObject.OSS[j].CardClass = Type$FOT) AND
         CurObject.BogeyEnabled = TRUE THEN


         CurObject.OSS[j].ISOColor = CC_RED;
         CurObject.OSS[j].STAColor = CC_RED;
         CurObject.OSS[j].ISTAColor = CC_RED;
      ENDIF;
/*
** Combine ABF + ISO + STA + ISTA into TotISTA; .
*/   
      CurObject.OSS[j].IntTotISTA = CurObject.OSS[j].IntABF +
                                    CurObject.OSS[j].IntISO + 
                                    CurObject.OSS[j].IntISTA + 
                                    CurObject.OSS[j].IntSTA;
      IF CurObject.OSS[j].IntTotISTA > 0 THEN
         CurObject.OSS[j].TotISTA = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotISTA);


         IF CurObject.OSS[j].ISOColor = CC_RED OR
           CurObject.OSS[j].ABFColor = CC_RED OR
           CurObject.OSS[j].ISTAColor = CC_RED OR
           CurObject.OSS[j].STAColor = CC_RED THEN
           CurObject.OSS[j].TotISTAColor = CC_RED;


         ELSEIF CurObject.OSS[j].ISOColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].ABFColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].ISTAColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].STAColor = CC_LIGHT_BLUE THEN
           CurObject.OSS[j].TotISTAColor = CC_LIGHT_BLUE;


         ELSEIF CurObject.OSS[j].ISOColor = CC_BLUE OR
           CurObject.OSS[j].ABFColor = CC_BLUE OR
           CurObject.OSS[j].ISTAColor = CC_BLUE OR
           CurObject.OSS[j].STAColor = CC_BLUE THEN
           CurObject.OSS[j].TotISTAColor = CC_BLUE;


         ELSEIF CurObject.OSS[j].ISOColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].ABFColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].ISTAColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].STAColor = CC_LIGHT_GRAY THEN
           CurObject.OSS[j].TotISTAColor = CC_LIGHT_GRAY;
         ELSE
           CurObject.OSS[j].TotISTAColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** combine STA + ISTA into TotSTG; .
*/   
      CurObject.OSS[j].IntTotSTG = CurObject.OSS[j].IntSTA + 
                                   CurObject.OSS[j].IntISTA;
                                    
      IF CurObject.OSS[j].IntTotSTG > 0 THEN
         CurObject.OSS[j].TotSTG = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotSTG);


         IF CurObject.OSS[j].ISTAColor = CC_RED OR
            CurObject.OSS[j].STAColor = CC_RED THEN
            CurObject.OSS[j].TotSTGColor = CC_RED;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].STAColor = CC_LIGHT_BLUE THEN
           CurObject.OSS[j].TotSTGColor = CC_LIGHT_BLUE;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_BLUE OR
           CurObject.OSS[j].STAColor = CC_BLUE THEN
           CurObject.OSS[j].TotSTGColor = CC_BLUE;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].STAColor = CC_LIGHT_GRAY THEN
           CurObject.OSS[j].TotSTGColor = CC_LIGHT_GRAY;
         ELSE
           CurObject.OSS[j].TotSTGColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** Combine ISO + ISTA into TotISL. 
*/
      CurObject.OSS[j].IntTotISL = CurObject.OSS[j].IntISO + 
                                   CurObject.OSS[j].IntISTA;
                                    
      IF CurObject.OSS[j].IntTotISL > 0 THEN
         CurObject.OSS[j].TotISL = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotISL);


         IF CurObject.OSS[j].ISTAColor = CC_RED OR
            CurObject.OSS[j].ISOColor = CC_RED THEN
            CurObject.OSS[j].TotISLColor = CC_RED;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].ISOColor = CC_LIGHT_BLUE THEN
           CurObject.OSS[j].TotISLColor = CC_LIGHT_BLUE;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_BLUE OR
           CurObject.OSS[j].ISOColor = CC_BLUE THEN
           CurObject.OSS[j].TotISLColor = CC_BLUE;


         ELSEIF CurObject.OSS[j].ISTAColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].ISOColor = CC_LIGHT_GRAY THEN
           CurObject.OSS[j].TotISLColor = CC_LIGHT_GRAY;


         ELSE
           CurObject.OSS[j].TotISLColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** Combine OTW+, OTW, OTWR, OTWS  to TotOTW.  OTW bogey applys to the combined OTW/OTWS/OTWR.
*/
      TempDuration = CurObject.OSS[j].IntOTW + 
                     CurObject.OSS[j].IntOTWS + 
                     CurObject.OSS[j].IntOTWR;


      IF ((TempDuration > OTWBogey AND 
           CurObject.OSS[j].CardClass_Reverse = FALSE) OR
          (TempDuration > OTWBogeyTV AND 
           CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
        (CurObject.OSS[j].CardClass = Type$Auto OR
         CurObject.OSS[j].CardClass = Type$CIOA OR
         CurObject.OSS[j].CardClass = Type$FOT) AND
         CurObject.BogeyEnabled = TRUE THEN


         CurObject.OSS[j].OTWColor = CC_RED;
         CurObject.OSS[j].OTWRColor = CC_RED;
         CurObject.OSS[j].OTWSColor = CC_RED;
      ENDIF;


      CurObject.OSS[j].IntTotOTW = CurObject.OSS[j].IntOTWPlus + 
                                    CurObject.OSS[j].IntOTW + 
                                    CurObject.OSS[j].IntOTWR + 
                                    CurObject.OSS[j].IntOTWS;
      IF CurObject.OSS[j].IntTotOTW > 0 THEN


         CurObject.OSS[j].TotOTW = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotOTW);
         IF CurObject.OSS[j].OTWPlusColor = CC_RED OR
           CurObject.OSS[j].OTWColor = CC_RED OR
           CurObject.OSS[j].OTWRColor = CC_RED OR
           CurObject.OSS[j].OTWSColor = CC_RED THEN
           CurObject.OSS[j].TotOTWColor = CC_RED;


         ELSEIF CurObject.OSS[j].OTWPlusColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].OTWColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].OTWRColor = CC_LIGHT_BLUE OR
           CurObject.OSS[j].OTWSColor = CC_LIGHT_BLUE THEN
           CurObject.OSS[j].TotOTWColor = CC_LIGHT_BLUE;


         ELSEIF CurObject.OSS[j].OTWPlusColor = CC_BLUE OR
           CurObject.OSS[j].OTWColor = CC_BLUE OR
           CurObject.OSS[j].OTWRColor = CC_BLUE OR
           CurObject.OSS[j].OTWSColor = CC_BLUE THEN
           CurObject.OSS[j].TotOTWColor = CC_BLUE;


         ELSEIF CurObject.OSS[j].OTWPlusColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].OTWColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].OTWRColor = CC_LIGHT_GRAY OR
           CurObject.OSS[j].OTWSColor = CC_LIGHT_GRAY THEN
           CurObject.OSS[j].TotOTWColor = CC_LIGHT_GRAY;
         ELSE
           CurObject.OSS[j].TotOTWColor = CC_FOREGROUND;
         ENDIF;
      ENDIF;
/*
** combine INSP and LOC to TotILOC
*/
      CurObject.OSS[j].IntTotILOC = CurObject.OSS[j].IntINSP + 
                                    CurObject.OSS[j].IntLOC;
      IF CurObject.OSS[j].IntTotILOC > 0 THEN
       CurObject.OSS[j].TotILOC = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotILOC);
       IF CurObject.OSS[j].INSPColor = CC_RED OR
         CurObject.OSS[j].LOCColor = CC_RED THEN
         CurObject.OSS[j].TotILOCColor = CC_RED;


       ELSEIF CurObject.OSS[j].INSPColor = CC_LIGHT_BLUE OR
         CurObject.OSS[j].LOCColor = CC_LIGHT_BLUE THEN
         CurObject.OSS[j].TotILOCColor = CC_LIGHT_BLUE;


       ELSEIF CurObject.OSS[j].INSPColor = CC_BLUE OR
         CurObject.OSS[j].LOCColor = CC_BLUE THEN
         CurObject.OSS[j].TotILOCColor = CC_BLUE;


       ELSEIF CurObject.OSS[j].INSPColor = CC_LIGHT_GRAY OR
         CurObject.OSS[j].LOCColor = CC_LIGHT_GRAY THEN
         CurObject.OSS[j].TotILOCColor = CC_LIGHT_GRAY;
       ELSE
         CurObject.OSS[j].TotILOCColor = CC_FOREGROUND;
       ENDIF;
      ENDIF;
/*
** combine FG, TEST, PFS, PFSS and PFSF to TotFPFS
*/
      CurObject.OSS[j].IntTotFPFS = CurObject.OSS[j].IntFG + 
                                    CurObject.OSS[j].IntTEST + 
                                    CurObject.OSS[j].IntPFS + 
                                    CurObject.OSS[j].IntPFSS + 
                                    CurObject.OSS[j].IntPFSF;
      IF CurObject.OSS[j].IntTotFPFS > 0 THEN
       CurObject.OSS[j].TotFPFS = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[j].IntTotFPFS);
       IF CurObject.OSS[j].FGColor = CC_RED OR
         CurObject.OSS[j].TESTColor = CC_RED OR
         CurObject.OSS[j].PFSColor = CC_RED OR
         CurObject.OSS[j].PFSSColor = CC_RED OR
         CurObject.OSS[j].PFSFColor = CC_RED THEN
         CurObject.OSS[j].TotFPFSColor = CC_RED;


       ELSEIF CurObject.OSS[j].FGColor = CC_LIGHT_BLUE OR
         CurObject.OSS[j].TESTColor = CC_LIGHT_BLUE OR
         CurObject.OSS[j].PFSColor = CC_LIGHT_BLUE OR
         CurObject.OSS[j].PFSSColor = CC_LIGHT_BLUE OR
         CurObject.OSS[j].PFSFColor = CC_LIGHT_BLUE THEN
         CurObject.OSS[j].TotFPFSColor = CC_LIGHT_BLUE;


       ELSEIF CurObject.OSS[j].FGColor = CC_BLUE OR
         CurObject.OSS[j].TESTColor = CC_BLUE OR
         CurObject.OSS[j].PFSColor = CC_BLUE OR
         CurObject.OSS[j].PFSSColor = CC_BLUE OR
         CurObject.OSS[j].PFSFColor = CC_BLUE THEN
         CurObject.OSS[j].TotFPFSColor = CC_BLUE;


       ELSEIF CurObject.OSS[j].FGColor = CC_LIGHT_GRAY OR
         CurObject.OSS[j].TESTColor = CC_LIGHT_GRAY OR
         CurObject.OSS[j].PFSColor = CC_LIGHT_GRAY OR
         CurObject.OSS[j].PFSSColor = CC_LIGHT_GRAY OR
         CurObject.OSS[j].PFSFColor = CC_LIGHT_GRAY THEN
         CurObject.OSS[j].TotFPFSColor = CC_LIGHT_GRAY;
       ELSE
         CurObject.OSS[j].TotFPFSColor = CC_FOREGROUND;
       ENDIF;
      ENDIF;
/*
**  Set Out of Service time by subtracting OTW+ from it.
*/      
      IF CurObject.OSS[j].CutOut = '' THEN
         CurObject.OSS[j].Char_Duration = '';
      ELSE
         IF CurObject.OSS[j].CutIn = '' THEN
            Tot_Min = INT4(interval('minute',DATE('now') - DATE(CurObject.OSS[j].CutOut)));
            Tot_Min = Tot_Min - CurObject.OSS[j].IntOTWPlus;
            CurObject.OSS[j].Char_Duration = CALLPROC ConvertHour(Tot_Min = Tot_Min);
            CurObject.OSS[j].CutInColor = CC_LIGHT_BLUE;
            CurObject.OSS[j].CutIn = CurObject.OSS[j].EstTimeInService;
         ELSE
            Tot_Min = INT4(interval('minute',DATE(CurObject.OSS[j].CutIn) - DATE(CurObject.OSS[j].CutOut)));
            Tot_Min = Tot_Min - CurObject.OSS[j].IntOTWPlus;
            CurObject.OSS[j].Char_Duration = CALLPROC ConvertHour(Tot_Min = Tot_Min);
            CurObject.OSS[j].CutInColor = CC_FOREGROUND;
         ENDIF;


         IF ((Tot_Min > OOSBogey AND 
              CurObject.OSS[j].CardClass_Reverse = FALSE) OR
             (Tot_Min > OOSBogeyTV AND 
              CurObject.OSS[j].CardClass_Reverse = TRUE)) AND
           (CurObject.OSS[j].CardClass = Type$Auto OR
            CurObject.OSS[j].CardClass = Type$CIOA OR
            CurObject.OSS[j].CardClass = Type$FOT) AND
            CurObject.BogeyEnabled = TRUE THEN


            CurObject.OSS[j].Char_DurationColor = CC_RED; 
         ELSE
            CurObject.OSS[j].Char_DurationColor = CC_FOREGROUND; 
         ENDIF;
      ENDIF;
       
      j = j + 1;       
   ENDWHILE;
   RETURN;
END;


METHOD Load_Networks (
)=
DECLARE
   DivCheck = INTEGER NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Networks associated with a division.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   DivCheck = 0;
   SELECT :DivCheck = COUNT(*) 
   FROM    Udb_Object 
   WHERE   Object = :CurObject.Division AND
           Type = :Type$Division;


   IF DivCheck = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please select a valid division.';
      RETURN;
   ENDIF;
   
   CurObject.Olist.Clear();
   i = 1;
   REPEATED
   SELECT  :CurObject.Olist[i].Object = O.Object,
           :CurObject.Olist[i].Name = O.Name
   FROM    Udb_Object O,
           Udb_Grouping G 
   WHERE   G.MemberType = :Type$Network AND
           G.Relationship = :Interaction$MemberOf AND 
           G.Grouping = :CurObject.Division AND
           G.Member = O.Object
   ORDER BY Name
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;




