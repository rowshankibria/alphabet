	Name:            SelectType

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    Common
**  Frame:          SelectType  
**
**    03/11/93    em     Created.
**    04/07/93    em     removed repeated select for ddb
**    12/11/96    tp     Added TypeOfCard subselect and fallback select.
**    04/15/04    ysp    Add type search feature
**    08/22/15    pkw    Add FilterATS; Used when called from AddEquip Frame.
**
*/

INITIALIZE
(
    SuperType = INTEGER NOT NULL;                  /*Passed Type*/
    Type = INTEGER NOT NULL WITH DEFAULT;          /*Passed Type*/
    TypeName = VARCHAR(40) NOT NULL WITH DEFAULT;  /*Passed Name*/
    CardType = INTEGER NOT NULL WITH DEFAULT;      /*Passed TypeOfCard*/
    FilterATS = INTEGER NOT NULL WITH DEFAULT;     /*Optional: Filters ATS equip types except for main groupers*/
    i = integer NOT NULL WITH DEFAULT;	 /* Temporary counter */
    RetCode = INTEGER NOT NULL;
    ScrollTo = INTEGER NOT NULL WITH DEFAULT;
) =                                                          
BEGIN

    i = 1;
    ScrollTo = 1;
    SELECT :T[i].Type = T.Type,
           :T[i].Name = T.Name,
           :T[i].Description = T.Description
    FROM   Udb_Type T,
           Udb_ExtendedType ET
    WHERE  T.Type = ET.Type AND
           ET.SuperType = :SuperType AND
           T.Type IN (SELECT DISTINCT CT.Type
                      FROM   Cac_CardType CT
                      WHERE  CT.CardType = :CardType) AND
           T.Type NOT IN (SELECT ET2.TYPE
                          FROM   Udb_ExtendedType ET2
                          WHERE  1 = :FilterATS AND
                                 ET2.SuperType IN (:Type$ATSGeneric,:Type$ATSGrouper) AND
                                 ET2.Type NOT IN (:Type$ATS,:Type$ATSU,:Type$ATSP,:Type$ATSD))
    ORDER BY Name
    BEGIN
       IF T[i].Name = TypeName THEN
          ScrollTo = i;
       ENDIF;
       i = i + 1;
    END;


/* 
   If the SELECT above failed to return any equipment types
   (probably because the TypeOfCard is not setup) then use
   the old method where all equipment types are selected.
*/
    IF i = 1 THEN
        ScrollTo = 1;
        SELECT :T[i].Type = T.Type,
               :T[i].Name = T.Name,
               :T[i].Description = T.Description
        FROM   Udb_Type T,
               Udb_ExtendedType ET
        WHERE  T.Type = ET.Type AND
               ET.SuperType = :SuperType AND
               T.Type NOT IN (SELECT ET2.TYPE
                              FROM   Udb_ExtendedType ET2
                              WHERE  1 = :FilterATS AND
                                     ET2.SuperType IN (:Type$ATSGeneric,:Type$ATSGrouper) AND
                                     ET2.Type NOT IN (:Type$ATS,:Type$ATSU,:Type$ATSP,:Type$ATSD))
        ORDER BY Name
        BEGIN
           IF T[i].Name = TypeName THEN
              ScrollTo = i;
           ENDIF;
           i = i + 1;
        END;
    ENDIF;

    FIELD(T).ActiveRow = ScrollTo;
    CALLPROC DDB_ROLLBACK; 
    CurFrame.InputFocusField = FIELD(TypeText);
END;

ON Click Find_Button =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   RetCode = T.Find (AttributeName = 'name',
                     SearchString = TypeText + '%',
                     CaseSensitive = FALSE,
                     RowNumber = ByRef(ScrollTo));
   IF RetCode <> ER_OK THEN
         MESSAGE 'Cannot find any type that contains the text.';
         RESUME;         
   ENDIF;

   FIELD(T).ActiveRow = ScrollTo;

   FOR i = 1 To T.LastRow() DO
       IF i = ScrollTo THEN
          FIELD(T[i].Name).IsReverse = TRUE;
          FIELD(T[i].Description).IsReverse = TRUE;
       ELSE
          FIELD(T[i].Name).IsReverse = FALSE;
          FIELD(T[i].Description).IsReverse = FALSE;
       ENDIF; 
   ENDFOR;
END;

/*
*/
ON ChildEntry T =
BEGIN

   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   TypeName = T[].Name;
   Type = T[].Type;
   RETURN;
 
END;

ON Click Cancel_btn =
BEGIN
    RETURN;
END;

