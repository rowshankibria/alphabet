#   include StandardDeclarations
    ParentFrame = FRAMEEXEC;
    Presel = INTEGER NOT NULL WITH DEFAULT; /* Selection Value*/
) =
BEGIN
    Presel = 0;
    DistrictOperator = DOp.Description;
    FCROperator.Name = '';

    O.Clear();
