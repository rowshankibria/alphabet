	Name:            SelectFMSTypeBySLC

/*
**
**	Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    SOA
**  Frame:          SelectFMSTypeBySLC
**
**  Modifications:
**  01/10/08  ysp  Created
**  12/16/11  em   Modified presentation to be generic for TFMS and SLC
*/

INITIALIZE
(
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   SLCCardClass = INTEGER NOT NULL;

#  include StandardDeclarations
) =
BEGIN
   /*  Set the corresponding FMS card class. */
   IF SLCCardClass = Type$SLCAuto OR SLCCardClass = Type$TFMSAuto THEN
      RETURN Type$AUTO;
		
   ELSEIF SLCCardClass = Type$SLCOOE1 OR SLCCardClass = Type$TFMSOOE1 THEN   
      RETURN Type$OOE1;
		
   ELSEIF SLCCardClass = Type$SLCTEST THEN
      RETURN Type$CardClassTest;
   ENDIF;
/*
** Otherwise, SLCCardClass = Type$SLCOOE2 OR SLCCardClass = Type$SLCSCHD THEN   		
*/
   FIELD(FeederString).TextValue = 'feeder: ' + FeederName;
	
   SelectType.Clear();
   i = 1;
   SELECT :SelectType[i].Type = Type,
          :SelectType[i].Name = Name
   FROM   UDB_Type 
   WHERE  TYPE IN (:Type$SCHD, :Type$OOE2, :Type$RAP)
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

/*
** Handle a type selection from the list
*/
ON ChildEntry SelectType =
BEGIN
   Selected.Type = SelectType[].Type;
   Selected.Name = SelectType[].Name;
END;

ON Click OK_Btn =
BEGIN
   IF Selected.Type = 0 THEN       
      Message 'You have not selected a type.';
      Selected.Name = '';
      Selected.Type = 0;
      RESUME;
   ELSE 
      RETURN (Selected.Type);
   ENDIF; 
END;

On Entry Selected.Name =
BEGIN
   Selected.Type = 0;
END;

ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

