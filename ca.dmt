============================

	Name:            Check3PDisconnectOpen

/* 
**      Copyright c 2017 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software LLC proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          Check3PDisconnectOpen
**
**  Date:       Author   Description
** ----------------------------------
**  02/03/17	em       Created 
**  02/13/17    em       Used Disconnect name in warning
*/
PROCEDURE Check3PDisconnectOpen
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER;
    Operator = INTEGER;
    Disconnect = INTEGER NOT NULL WITH DEFAULT;
    DisconnectName = VARCHAR(40) NOT NULL WITH DEFAULT;
    DisconnectOpen = INTEGER NOT NULL WITH DEFAULT;

    RetCode         = INTEGER;
) =
BEGIN
/*
**  Job equipment must have 3PGrdSw relationship to a disconnect
*/
   Disconnect = 0;
   SELECT :Disconnect = G.Grouping,
          :DisconnectName = O.Name
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  G.Member = :JIP.Equip AND
          G.Relationship = :Interaction$3PGrdSwToDisc AND
          G.Grouping = O.Object;

   IF Disconnect = 0 THEN
      RETURN PU_OK;
   ENDIF;

   DisconnectOpen = 0;
   SELECT :DisconnectOpen = Object
   FROM   Udb_Switch
   WHERE  Object = :Disconnect AND
          CurrentlyOpen = 1;

   IF DisconnectOpen > 0 THEN
      RETURN PU_OK;
   ENDIF;

   IF JIP.Status = Job$Restore THEN
      Operator = JIP.RSOperator;
   ELSE
      Operator = JIP.TOOperator;
   ENDIF;

   SELECT :DisconnectOpen = Object
   FROM   FMS_PendingStatus 
   WHERE  Object = :Disconnect AND
          PendingStatus = :Status$Open AND
          StatusCount > 0 AND
          IssuedOperator = :Operator;

   IF DisconnectOpen > 0 THEN
      RETURN PU_OK;
   ENDIF;

   
   RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                Job = JIP.Job,
                                SwitchingItem = JIP.SwitchingItem, 
                Text = 'Three Position Switch ' + 
                       DisconnectName + 
                       ' required to be Open before Grounding. ');

   IF RetCode = PU_CANCEL THEN
      RETURN(PU_CANCEL);
   ELSE
      RETURN(Warning$Overridden);
   ENDIF;
END;

