**                     so DO can set the new order's priority accordingly.
**  04/14/05    ysp    Objective "Swap from Feeder Gnd to Test Bus Gnd" can be inserted
**                     only if the bus configuration has a test bus.
**  04/15/05    ysp    Allow DO to delete pre-loaded objectives.
**  07/16/05    em     Modifications in support of TOMS/SSO Interface
**  07/21/05    em     Prevent duplicate objectives from being selected
**  08/11/05    em     Changed way Other Orders button is presented
**  08/15/05    ysp    Set TORS = 1 for work permits because this is the value we expect
**                     from SSO's return order.
**  08/30/05    em     Reverse previous change due to two problems with gray move color and
**                     downloading wrong move text.
**  10/21/05    em     FMS 260: Modified outgoing message.
**  11/16/05    em     No default comment for TFMS Orders.
**  11/17/05    em     Add "In connection with" feeder/line enhancement
**  11/22/05    ysp    Allow DO to enter equipment names in "In connection with" list.
**  12/14/05    ysp    Increase the size of tomove to 160 chars
**  01/04/06    ysp    ITC190: allow DO to modify substation map numbers.
**  01/17/06    ysp    Don't show the map number for a macro substation.
**  01/30/06    em     Corrected screen ObjDetail properties - improper class instance.
**  05/24/06    ysp    Add type fields for "In Connection With".
**  06/29/06    ysp    TOMS Expanded Move: insert expanded jobs in the order job table.
**  08/02/06    em     If FdrPickList is empty, as it might be if moves on order
**                     have None equipment, the populate pick list with an
**                     instruction that something must be manually entered
**  08/03/06    em     Display expanded sub moves.
**  08/19/06    em     When inserting sub moves, don't grey out RS side for T/O moves, for RS moves
**                     copy TakeOut timestamp and show T/O Move text (not RS move text).
**  10/05/06    em     When primary move is RS, show RS Move text for the submove - this undoes part 
**                     of the previous change.  
**  10/23/06    em     Work Permit Orders from FMS allowed, to use TOMS Order structures.
**  10/27/06    em     Don't require an objective for FMS work permit orders
**  03/26/07    em     If the order is for an In-Service Permit, load In-Connection-With 
**                     information.
**  04/16/07   ysp     ITC210: Insert IR interface event in DB event queue
**  05/14/07    em     Add handling for G&T Ground similar to Feeder Ground and Test Bus.  Work is incomplete.
**  05/31/07    em     Completed G&T Ground status.
**  11/19/07    ysp    Require an objective for TOMS operating orders
**  01/08/08    ysp    SLC 52: Save "In Connection With" equipment type name in its own db column
**  03/12/08    ysp    for conditional In-Service permit, update its request's status to ISSUED 
**                     if the permit was created from a request.
**  05/12/08    em     Only require objective for non-WP TOMS orders.
**  07/24/08    ysp    pass DO's name to isp request upadte procedure.
**  09/26/08    ysp    Check duplicate InConnectionWith name before saving into the database.
**  10/10/08    em     Corrected problem setting TORS for submoves when issuing Restore + Takeout move
**  04/23/09    em     Add DISTINCT to Submove select to avoid getting duplicates when equipclass ihierarchy 
**                     has submoves linked at different levels. 
**  06/12/09    pkw    Remove ability to change logged on DO.
**  08/24/10    ysp    commented out the code that updates request's status.
**  09/14/11    ysp    Enforce selection of equip type name for in-connection-with field.
**  11/03/11    ysp    Check to set SWP report's Actual Work Permit Issue time when issuing a permit.
**  12/07/11    em     Correcting sub move problem when issuing takeout and restore at same time.
**                     For Restore moves we will gray out the Takeout issue/complete timestamp.
**  01/09/13    em     Poor re-use of index is causing array out of range error. 
**  08/27/13    ysp    1. Use the equip type of the source position on the 3G card to get 
**                     the bus configuration type. 2. Any feeder's ground status is used as 
**                     the 3G FdrGnd 
**  09/19/14    ysp    Use SWPOutageReport class to handle swp updates
**  01/09/15    ysp    Allow DO to enter equipment type if the picklist does not contain the type.
**  03/10/15    em     Don't force DO to enter inconnection with type name
**  03/22/17    em     Don't load InConnectionWith for OutOfService Permit with related ISWP
**  10/30/17    em     Change SWPOutageReport to OutageReport
**  01/29/20    em     New special case Test Bus Configuration added for Jamaica substation
**  11/09/23    ysp    Add procedure DisplayOrderPrint for TOMS orders.
*/ 
INITIALIZE
(
    IssuedMoves = ARRAY OF JobInProgress;  /*Passed list of Moves*/
    Substation = INTEGER NOT NULL;         /*Passed Substation*/
    Objective = VARCHAR(400) NOT NULL WITH DEFAULT; /* passed. supports TOMS order comment */

    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER NOT NULL WITH DEFAULT;

    CardName = VARCHAR(200) NOT NULL WITH DEFAULT; /*For Outgoing Message*/
    CardTypeOfCard = INTEGER NOT NULL WITH DEFAULT;  /*For loading submoves*/
    ControlText = VARCHAR(256) NOT NULL;    /* For DBEvent   */
    CurObjRow = INTEGER NOT NULL WITH DEFAULT;
    CurConRow = INTEGER NOT NULL WITH DEFAULT;
    Equip = INTEGER NOT NULL WITH DEFAULT;
    FdrGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    FdrLineList = ARRAY OF ObjectClass;
    Feeder = INTEGER NOT NULL;
    GTGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    ISPermit = INTEGER NOT NULL WITH DEFAULT;
    JobSeq = INTEGER NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    LockedPermit = INTEGER NOT NULL WITH DEFAULT;
    MessageField = VARCHAR(800) NOT NULL;     /*Completion Message*/
    MsgKey = INTEGER NOT NULL;                /*Return MsgID*/
    OrderNumber = INTEGER NOT NULL;
    OrderObjectiveType = INTEGER NOT NULL;
    OrderStatus = INTEGER NOT NULL;           /*Initial Order Status*/
    OrderTarget = CHAR(4) NOT NULL WITH DEFAULT;
    OrderType = VARCHAR(14) NOT NULL WITH DEFAULT;
    ObjectiveList = ChoiceList;
    OrderCheck = INTEGER NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    Status = INTEGER NOT NULL WITH DEFAULT;
    StepHeading = VARCHAR(100) NOT NULL WITH DEFAULT;
    SubstationOrderNumber = INTEGER NOT NULL; /*Return from Insert*/
    SourceEquipType = INTEGER NOT NULL;
    SwapGnd = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    SingleSWP = OutageReport DEFAULT NULL;
    TempString = VARCHAR(40) NOT NULL WITH DEFAULT;
    TORS = INTEGER NOT NULL;    /* Takeout or Restore */
    TempObjective = ObjectiveClass;
    TestGndExist = INTEGER NOT NULL WITH DEFAULT;        /* flag */
    TypeList = ChoiceList;
) =
DECLARE
/*
** local procedures
*/
    RemoveBlankFeeders = PROCEDURE;
    UpdateMapNumbers = PROCEDURE;
    InsertOrderJobs = PROCEDURE RETURNING INTEGER NOT NULL;
    SetClearFeederStatus = PROCEDURE;
    DisplayOrderPrint = PROCEDURE;
ENDDECLARE
BEGIN
/*
** Setup default fields that we know now.
*/
   DistrictOperator = DOp.Description; 
   OrderComment = Objective;
   IF CurrentApplication = Application$FMS THEN
      OrderTarget = 'SSO';
      OrderObjectiveType = Type$OrderObjective;

      FIELD(InConnectionWith).CurBias = FB_INVISIBLE;
      FIELD(FdrPickList).CurBias = FB_INVISIBLE;
   ELSE 
      OrderTarget = 'TOMS';
      OrderObjectiveType = Type$OrderObjectiveTOMS;

      TypeList.ChoiceItems.clear();
      /** Give them a "blank result to choose from **/
      TypeList.ChoiceItems[1].EnumValue =  0;
      TypeList.ChoiceItems[1].EnumText  =  '';
 
      i = 2;
      REPEATED
      SELECT 
          :TypeList.ChoiceItems[i].EnumValue = T.Type,
          :TypeList.ChoiceItems[i].EnumText  = T.Name 
      FROM  Udb_Type T, 
            Udb_SuperType S 
      WHERE T.Type = S.Type AND
            S.SuperType = :Type$RRType
      ORDER BY 2 
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      Field(TypePopup.List).ValueList = TypeList;
      FIELD(TypePopup.List).UpdChoiceList();

      FIELD(InConnectionWith).CurBias = FB_CHANGEABLE;
      FIELD(FdrPickList).CurBias = FB_LANDABLE;
   ENDIF;

   CardTypeOfCard = 0;
   IF CurrentApplication = Application$TFMS THEN
      CardTypeOfCard = TypeOfCard$TFMS;
   ELSEIF CurrentApplication = Application$SLC THEN
      CardTypeOfCard = TypeOfCard$SLC;
   ENDIF;
/*
** Setup moves takeout/restore side for display only.
*/
   OrderType = 'REGULAR';
   k = 1;
   FOR i = 1 TO IssuedMoves.LastRow() DO
        Jobs[k] = IssuedMoves[i].Duplicate();
        Jobs[k].BaseKey = 0;   
        IF IssuedMoves[i].Status = Job$Restore THEN
           Jobs[k].TOIssued = Jobs[k].RSIssued;
           Jobs[k].TOMove = Jobs[k].RSMove;
        ENDIF;
        IF IssuedMoves[i].StepPair = StepHeading$WorkPermit THEN
           OrderType = 'WORK PERMIT'; 
/*
** Check if this is an In-Service Permit (there will be only one move).
** If so, get equip, lines and feeders associated to the permit.
*/
           ISPermit = 0;
           SELECT :ISPermit = ISPermit
           FROM   SOA_InServicePermit
           WHERE  Job = :Jobs[1].Job;

           IF ISPermit <> 0 THEN
/*
** If an OutOfService permit then do not load ISPermit Feeder links.
*/
              InConnectionWith.Clear();
              LockedPermit = 0;
              SELECT :LockedPermit = PhaseCheckIndicator
              FROM   SOA_WorkPermit
              WHERE  PermitJobID = :Jobs[1].Job;

              IF LockedPermit = 0 THEN
                 j = 1;
                 SELECT :InConnectionWith[j].Object = Object,
                        :InConnectionWith[j].Name = Name
                 FROM   IR_OpOrderFeeders
                 WHERE  ISPermit = :ISPermit
                 BEGIN 
                    j = j + 1;
                 END;
              ENDIF;
           ENDIF;

        ENDIF;
        IF Jobs[k].ReturnRemark = '' THEN  /*Will be specnumber*/
           SELECT :Jobs[k].SubstationName = Name,
                  :Jobs[k].ReturnRemark = SpecNumber
           FROM   UDB_Object
           WHERE  Object = :Jobs[k].Substation; 
           CALLPROC UpdateMapNumbers(
                        UpdatedSubstn = Jobs[k].Substation,
                        NewMapNumber = Jobs[k].ReturnRemark,
                        SubstationName = Jobs[k].SubstationName);
        ENDIF;
        k = k + 1;
        IF CardTypeOfCard <> 0 THEN
/*
** Select any submoves that will be added to the order when it is generated.
** These moves will simply be displayed here.  The BaseKey field contains
** the parent ID and will prevent the moves from being processed further.
*/
         IF IssuedMoves[i].Status = Job$Restore THEN
            TORS = 1;
         ELSEIF IssuedMoves[i].Status = Job$TakeOut THEN
            TORS = 0;
         ENDIF;

        SELECT DISTINCT
          :Jobs[k].JobClass = JCL.LinkJobClass,
          :Jobs[k].TOMove = '   ' + SQUEEZE(J.TOMove) + ' - ' + :IssuedMoves[i].EquipName,
          :Jobs[k].RSMove = '   ' + SQUEEZE(J.RSMove) + ' - ' + :IssuedMoves[i].EquipName,
          :Jobs[k].Seq = JCL.Seq,
          :Jobs[k].BaseKey = :IssuedMoves[i].Job,
          :Jobs[k].EquipClassName = :IssuedMoves[i].EquipClassName,
          :Jobs[k].EquipName = :IssuedMoves[i].EquipName
        FROM   FMS_JobClassLink JCL,
               FMS_JobClass J   
        WHERE  JCL.SourceJobClass = :IssuedMoves[i].JobClass AND
               JCL.SourceTypeOfCard = :CardTypeOfCard AND
               JCL.SourceStepPair = :IssuedMoves[i].StepPair AND
               JCL.SourceEquipClass IN (SELECT SuperType 
                                        FROM UDB_ExtendedType 
                                        WHERE Type = :IssuedMoves[i].EquipClass) AND
               JCL.SourceTORS = :TORS AND
               JCL.LinkJobClass = J.JobClass    
        ORDER BY Seq
        BEGIN
           FIELD(Jobs[k].EquipClassName).BgColor = CC_PALE_GRAY;
           FIELD(Jobs[k].EquipName).BgColor = CC_PALE_GRAY;
           FIELD(Jobs[k].TOMove).BgColor = CC_PALE_GRAY;
           FIELD(Jobs[k].ReturnRemark).BgColor = CC_PALE_BLUE;
           IF TORS = 1 THEN  /*Display RS Move */
              Jobs[k].TOMove = Jobs[k].RSMove;
           ENDIF;
           k = k + 1;
        END;
      ENDIF;
   ENDFOR;
   
   SELECT :CardName = CardName 
   FROM   SOA_ActiveCard
   WHERE  Card = :Jobs[1].Card;
/*
** Enable button if there are any other orders in the Station
*/
   i = 0;
   REPEATED
   SELECT  :i = COUNT(*)
   FROM   IR_OperatingOrder OO
   WHERE  OO.Substation = :Substation AND
          OO.OrderStatus < :Order$Closed AND
          OO.OrderStatus > :Order$SetUp AND
          OO.OrderStatus <> :Order$Rejected
   UNION ALL
   SELECT  OO.OrderStatus
   FROM   IR_TelephoneOrder OO
   WHERE  OO.Substation = :Substation AND
          OO.OrderStatus <:Order$Closed AND
          OO.OrderStatus <> :Order$Rejected;
   CALLPROC DDB_ROLLBACK;
   
   IF i = 0 THEN
      FIELD(OtherOrders_Btn).CurBias = FB_INVISIBLE;
   ELSE
      FIELD(OtherOrders_Btn).CurBias = FB_LANDABLE;
   ENDIF;
/*
** load a valid list of objectives
*/
   ObjectiveList.ChoiceItems.Clear();
   ObjectiveList.ChoiceItems[1].EnumValue = 0;     
   ObjectiveList.ChoiceItems[1].EnumText  = ' ';   

   i = 2;
   REPEATED
   SELECT 
          :ObjectiveList.ChoiceItems[i].EnumValue = T.Type,
          :ObjectiveList.ChoiceItems[i].EnumText  = T.Name 
   FROM  Udb_Type T, 
         Udb_SuperType S 
   WHERE T.Type = S.Type
     AND S.SuperType = :OrderObjectiveType
   ORDER BY 2 
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   FIELD(AddObjective).ValueList = ObjectiveList.Duplicate();
   FIELD(AddObjective).UpdChoiceList();
   FIELD(ObjDetails).CurBias = FB_INVISIBLE;
/*
** If the order is sent to a macro substation, don't show the substation map number
*/
   i = 0;
   SELECT :i = O.Type,
          :Sub2Field.SubstnNumber = O.SpecNumber
   FROM   Udb_Object O
   WHERE  O.Object = :Substation;

   IF i = Type$MacroSubstation THEN
      FIELD(Sub2Field).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** Get Bus Configuration for FMS orders. 
** Get the transmission and distribution feeders for TOMS orders.
*/
   BusConfiguration.Name = '';
   BusConfiguration.Type = 0;
   IF CurrentApplication = Application$FMS THEN
/*
** find the source equipment of the feeder
*/
      SELECT :Feeder = C.Feeder
      FROM   FMS_Card C
      WHERE  C.Card = :Jobs[1].Card;

      SourceEquipType = 0;
      IF Feeder = -1 THEN   // 3G
         /*
         ** Use the equip type of the source breaker on the card
         */
         SELECT :SourceEquipType = O.Type
         FROM   FMS_Card C,
                TFMS_CardToObject CTO,
                Udb_Object O,
                Udb_Grouping G
         WHERE  C.Card = :Jobs[1].Card
           AND  CTO.Card = C.Card  
           AND  CTO.Object = G.Grouping  
           AND  G.RelationShip = :Interaction$SourceBreaker
           AND  G.Member = O.Object 
           AND  UPPERCASE(O.Name) = UPPERCASE(C.Position);
         
      ELSE
         SELECT :SourceEquipType = O2.Type
         FROM   Udb_Object O1,
                Udb_Object O2,
                Udb_Grouping G
         WHERE  O1.Object = :Feeder 
           AND  G.Grouping = O1.Object 
           AND  G.RelationShip = :Interaction$SourceBreaker
           AND  G.Member = O2.Object 
           AND  O2.PrimaryGrouping = O1.PrimaryGrouping;
      ENDIF;

      IF SourceEquipType <> 0 THEN
         SELECT :BusConfiguration.Name = T.Name,
                :BusConfiguration.Type = T.Type
         FROM   FMS_BusConfiguration B,
                Udb_Type T
         WHERE  B.EquipClass = :SourceEquipType
        AND  B.BusType = T.Type;
      ENDIF;
      CALLPROC DDB_ROLLBACK;
      
      IF BusConfiguration.Type = 0 THEN
         MESSAGE 'A default bus configuration has not been defined for ' +
              'the source equipment type. Please define the bus ' +
              'configuration in DBM and resend the order.';
         RETURN PU_CANCEL;
      ENDIF;
/*
** Build the order objective list based on the moves in the order
*/
      j = 1;
      Objectives.Clear();

      FOR i = 1 TO IssuedMoves.LastRow() DO
         IF Jobs[i].Status = Job$Restore THEN
            TORS = 1;
         ELSEIF Jobs[i].Status = Job$TakeOut THEN
            TORS = 0;
         ENDIF;

         j = Objectives.LastRow() + 1;
         REPEATED
         SELECT :Objectives[j].ID = T.Type, 
                :Objectives[j].Description = T.Name 
         FROM   FMS_JobObjective JO,
                UDB_Type T
         WHERE  JO.JobClass = :IssuedMoves[i].JobClass 
           AND  JO.TORS = :TORS
           AND  JO.Objective = T.Type;

         j = Objectives.LastRow();
         /* remove duplicate objective */
         k = 1;
         WHILE k < j DO
            IF Objectives[k].ID = Objectives[j].ID THEN
               Objectives.RemoveRow (RowNumber = j);
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
      ENDFOR;
      CALLPROC DDB_ROLLBACK;

      FdrGndExist = FALSE;
      GTGndExist = FALSE;
      TestGndExist = FALSE;
      SwapGnd = FALSE;
      CurObjRow = 0;
/*
** Get any feeder status FdrG or G&T that is set, these statuses are mutually exclusive.
** Last one set (G&T) takes charge
*/
      i = 0 ;
      Status = 0;
      IF Feeder = -1 THEN 
         SELECT :i = StatusCount,
                :Status = S.Status
         FROM   TFMS_CardToObject CTO,
                FMS_ObjectStatus S
         WHERE  CTO.Card = :Jobs[1].Card AND
                CTO.Object = S.Object AND
                S.Status IN (:Status$FdrG, :Status$GTGnd)
         BEGIN
            IF Status = Status$FdrG AND i <> 0 THEN
               FdrGndExist = TRUE;
            ELSEIF Status = Status$GTGnd AND i <> 0 THEN
               GTGndExist = TRUE;
            ENDIF;
         END;
      ELSE
         SELECT :i = StatusCount,
                :Status = Status
         FROM   FMS_ObjectStatus
         WHERE  Object = :Feeder AND
                Status IN (:Status$FdrG, :Status$GTGnd)  
         BEGIN
            IF Status = Status$FdrG AND i <> 0 THEN
               FdrGndExist = TRUE;
            ELSEIF Status = Status$GTGnd AND i <> 0 THEN
               GTGndExist = TRUE;
            ENDIF;
         END;
      ENDIF;
      IF GTGndExist = TRUE THEN
         FdrGndExist = FALSE;
      ENDIF;

      FOR i = 1 to Objectives.LastRow() DO
        CurFrame.SendUserEvent (EventName = 'Special_Logic',
                              MessageInteger = i);
      ENDFOR;
   ELSE
      /*
      ** Get the transmission and distribution feeders that are
      ** associated to equipment on the order.
      */
      Equip = 0; 
      FOR i = 1 to IssuedMoves.LastRow() DO
         IF IssuedMoves[i].Equip <> Equip AND
            IssuedMoves[i].Equip <> 0 THEN

            FdrLineList.Clear();

            CALLPROC GetLinesAndFeeders (
               Device = IssuedMoves[i].Equip,
               Substation = IssuedMoves[i].Substation,
               ObjectList = FdrLineList);  
         
            FOR j = 1 TO FdrLineList.LastRow() DO
               FOR k = 1 TO FdrPickList.LastRow() DO
                  IF FdrLineList[j].Object = FdrPickList[k].Object THEN
                     ENDLOOP;
                  ENDIF;
               ENDFOR;
            
               IF k > FdrPickList.LastRow() THEN
                  FdrPickList.InsertRow(RowNumber = k, 
                                        RowObject = FdrLineList[j].Duplicate());
                  FdrPickList[k].TypeName = 'FDR';
               ENDIF;
            ENDFOR;
            Equip = IssuedMoves[i].Equip;
         ENDIF;
      ENDFOR;
      IF FdrPickList.LastRow = 0 AND InConnectionWith.LastRow = 0 THEN
         FdrPickList[1].Object = 0;
         FdrPickList[1].Name = 'In Connection';
         FdrPickList[2].Object = 0;
         FdrPickList[2].Name = 'With must';
         FdrPickList[3].Object = 0;
         FdrPickList[3].Name = 'be manually';
         FdrPickList[4].Object = 0;
         FdrPickList[4].Name = 'typed by DO';
      ENDIF;
      IF FdrPickList.LastRow > 6 THEN
         FIELD(FdrPickList).HasScrollBar = TRUE;
      ENDIF;
/* 
** TOMS order screen adjustments
*/
      FIELD(OrderComment).ParentField.CurBias = FB_CHANGEABLE;
      FIELD(BusConfiguration).ParentField.CurBias = FB_INVISIBLE;
   ENDIF;

END;


ON UserEvent 'Special_Logic' =
BEGIN
   CurObjRow = CurFrame.MessageInteger;
   IF CurObjRow < 1 THEN
      RESUME;
   ENDIF;
/* 
** special logic to manage objectives and bus configuration 
*/
   IF Objectives[CurObjRow].ID = Objective$ApplyFdrGnd THEN
      FdrGndExist = TRUE;
      GTGndExist = FALSE;
      TestGndExist = FALSE;
   ENDIF; 
/*
** If Bus Configuraton is a Test Bus and the order has an Apply Ground objective, 
** prompt DO.
*/
   IF (BusConfiguration.Type = BusConfig$ROBkrTestBus OR
       BusConfiguration.Type = BusConfig$FixBkrTestBus OR 
       BusConfiguration.Type = BusConfig$ROBkrTestBusJamaica) AND
      (Objectives[CurObjRow].ID = Objective$BkrOpenApplyGnd OR
       Objectives[CurObjRow].ID = Objective$RemoveIATCApplyGnd) THEN

       RetCode = CALLFRAME SSOOrderGround();

       IF RetCode = 0 THEN        
          /* Test Bus Ground */
          Objectives[CurObjRow].Description = 
                       Objectives[CurObjRow].Description + ' Test Bus';
          GTGndExist = FALSE; 
          FdrGndExist = FALSE;
          TestGndExist = TRUE;

       ELSEIF RetCode = 2 THEN        
          /* G&T Ground */
          Objectives[CurObjRow].Description = 
                       Objectives[CurObjRow].Description + ' G&T';
  
          GTGndExist = TRUE; 
          FdrGndExist = FALSE;
          TestGndExist = FALSE;
/*
** Change Bus Config to No Test Bus 
*/
          IF BusConfiguration.Type = BusConfig$ROBkrTestBus THEN
             BusConfiguration.Type = BusConfig$ROBkrNoTestBus;
          ELSEIF BusConfiguration.Type = BusConfig$FixBkrTestBus THEN
             BusConfiguration.Type = BusConfig$FixBkrNoTestBus;
          ELSEIF BusConfiguration.Type = BusConfig$ROBkrTestBusJamaica THEN
             BusConfiguration.Type = BusConfig$ROBkrNoTestBusJamaica;
          ENDIF;
          
          SELECT :BusConfiguration.Name = T.Name
          FROM   Udb_Type T
          WHERE  T.Type = :BusConfiguration.Type;

       ELSEIF FdrGndExist = FALSE THEN /* Feeder Ground selected */
       /* Feeder Ground: insert a "Apply Feeder Ground" objective and add a new
       ** Fdr object status for the feeder
       */
             
          TempObjective.ID = Objective$ApplyFdrGnd;
          TempObjective.Comment = '';

          SELECT :TempObjective.Description = Name
          FROM   Udb_Type
          WHERE  Type = :Objective$ApplyFdrGnd;

          Objectives.InsertRow (RowNumber = CurObjRow+1,
                         RowObject = TempObjective.Duplicate());

          FdrGndExist = TRUE;
          GTGndExist = FALSE;
          TestGndExist = FALSE;
       ENDIF;
   ENDIF;
   
   IF SwapGnd = FALSE AND
      (BusConfiguration.Type = BusConfig$ROBkrTestBus OR
       BusConfiguration.Type = BusConfig$FixBkrTestBus OR 
       BusConfiguration.Type = BusConfig$ROBkrTestBusJamaica) AND
      (Objectives[CurObjRow].ID = Objective$ApplyIATC OR
       Objectives[CurObjRow].ID = Objective$EstCond OR
       Objectives[CurObjRow].ID = Objective$HiPot OR
       Objectives[CurObjRow].ID = Objective$AmmeterClear) THEN

       IF FdrGndExist = TRUE THEN
          TempObjective.ID = Objective$SwapGnd;
          TempObjective.Comment = '';

          SELECT :TempObjective.Description = Name
          FROM   Udb_Type
          WHERE  Type = :Objective$SwapGnd;

          Objectives.InsertRow (RowNumber = CurObjRow,
                         RowObject = TempObjective.Duplicate());
          
          SwapGnd = TRUE;
       ENDIF;
   ENDIF;
END;

ON ENTRY Sub2Field.SubstnNumber = 
BEGIN
   SubDetails.SubObject.Substation = Substation;
   SubDetails.SubObject.SubstationName = SubstationName;

   SubDetails.SubstnNumber = Sub2Field.SubstnNumber;

   FIELD(SubDetails).AbsXRight = FIELD(Sub2Field.SubstnNumber).AbsXRight;
   FIELD(SubDetails).AbsYTop = FIELD(Sub2Field.SubstnNumber).AbsYBottom + 50;
   FIELD(SubDetails).CurBias = FB_CHANGEABLE;
END;

ON CLICK SubDetails.Update_btn =
BEGIN         
   SubDetails.SubObject.UpdateMapNumber(MapNumber = SubDetails.SubstnNumber);
   IF SubDetails.SubObject.ReturnCode <> 0 THEN
      MESSAGE SubDetails.SubObject.ErrorMessage;
      FIELD(SubDetails).CurBias = FB_INVISIBLE;
      RESUME;
   ELSE
      CALLPROC SOA_LogIns (Card = Jobs[1].Card,
                        Job = NULL,
                        SwitchingItem = Jobs[1].SwitchingItem,
                        UserName = UserName,
                        Time = DATE('now'),
                        Item = 'Substn Map Number Updated',
                        Old = '',
                        New = SubDetails.SubstnNumber);
      CALLPROC DDB_COMMIT;
   ENDIF;

   CALLPROC UpdateMapNumbers(
                        UpdatedSubstn = SubDetails.SubObject.Substation,
                        NewMapNumber = SubDetails.SubstnNumber,
                        SubstationName = SubDetails.SubObject.SubstationName);
   FIELD(SubDetails).CurBias = FB_INVISIBLE;
END;

ON CLICK SubDetails.Cancel_btn =
BEGIN        
   FIELD(SubDetails).CurBias = FB_INVISIBLE;
END;

ON CHILDENTRY Jobs[*].ReturnRemark = 
BEGIN
   IF FIELD(Jobs[].ReturnRemark).BgColor = CC_PALE_BLUE THEN
      RESUME;
   ENDIF;
   SubDetails.SubObject.Substation = Jobs[].Substation;
   SubDetails.SubObject.SubstationName = Jobs[].SubstationName;

   SubDetails.SubstnNumber = Jobs[].ReturnRemark;

   FIELD(SubDetails).CurBias = FB_CHANGEABLE;
   Field(SubDetails).AbsXLeft = FormField(CurFrame.TriggerField).AbsXRight;
   Field(SubDetails).AbsYTop = FormField(CurFrame.TriggerField).AbsYTop;

   /** Handle case where popup would go to low on the screen */
   IF Field(SubDetails).AbsYBottom > field(Jobs).AbsYBottom THEN
      Field(SubDetails).AbsYBottom = field(Jobs).AbsYBottom;
   ENDIF;
   CurFrame.InputFocusField = FIELD(SubDetails.Cancel_btn);
   CurFrame.Flush();
END;

ON CLICK OtherOrders_Btn = 
BEGIN
   CALLFRAME OtherOrdersInSubstation(
                         OrderSubstation = Substation);
END;


ON CHILDENTRY Objectives = 
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    i = FIELD(Objectives).CurRow;
/*
** highlight the selected row
*/
    j = 1;
    WHILE (j <= Objectives.LastRow()) DO
       IF i = j THEN
          FIELD(Objectives[j].Description).IsReverse = TRUE;
          FIELD(Objectives[j].Comment).IsReverse = TRUE;
       ELSE
          FIELD(Objectives[j].Description).IsReverse = FALSE;
          FIELD(Objectives[j].Comment).IsReverse = FALSE;
       ENDIF;
       j = j + 1;
    ENDWHILE;

    ObjDetails.Selected = Objectives[i].Duplicate();

    IF ObjDetails.Selected.ID = Objective$Blank THEN
       FIELD(ObjDetails.Selected.Description).CurBias = FB_CHANGEABLE;
    ELSE  
       FIELD(ObjDetails.Selected.Description).CurBias = FB_VISIBLE;
    ENDIF;

    FIELD(ObjDetails.Delete_Btn).CurBias = FB_LANDABLE;
    FIELD(ObjDetails).AbsXLeft = FIELD(Objectives).AbsXLeft;
    FIELD(ObjDetails).AbsYTop = FIELD(Objectives).AbsYBottom;
    FIELD(ObjDetails).CurBias = FB_CHANGEABLE;
END;


ON CLICK ObjDetails.Delete_Btn = 
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    i = FIELD(Objectives).CurRow;
    IF i < 1 THEN
       RESUME;
    ENDIF;

    IF ObjDetails.Selected.ID = Objectives[i].ID THEN
       IF ObjDetails.Selected.ID = Objective$ApplyFdrGnd THEN
          FdrGndExist = FALSE;
       ENDIF;
       Objectives.RemoveRow (RowNumber = i);
    ENDIF;
    FIELD(ObjDetails).CurBias = FB_INVISIBLE;
END;


ON CLICK ObjDetails.Update_Btn = 
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    i = FIELD(Objectives).CurRow;
    IF i < 1 THEN
       RESUME;
    ENDIF;

    IF ObjDetails.Selected.ID = Objectives[i].ID THEN
       Objectives[i].Description = ObjDetails.Selected.Description;
       Objectives[i].Comment = ObjDetails.Selected.Comment;
    ENDIF;
    FIELD(ObjDetails).CurBias = FB_INVISIBLE;
END;


ON CLICK ObjDetails.Cancel_Btn = 
BEGIN
    FIELD(ObjDetails).CurBias = FB_INVISIBLE;
END;


ON SETVALUE AddObjective = 
BEGIN
   IF AddObjective = 0 THEN
      RESUME;
   ENDIF;
   
   IF AddObjective = Objective$SwapGnd THEN    
      IF BusConfiguration.Type <> BusConfig$ROBkrTestBus AND
         BusConfiguration.Type <> BusConfig$FixBkrTestBus AND
         BusConfiguration.Type <> BusConfig$ROBkrTestBusJamaica  THEN
         IF CurFrame.ConfirmPopup(MessageText = 'The bus configuration does not have a test bus. ' + 
                'Continue to insert this objective?') = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;
      SwapGnd = TRUE;
   ENDIF; 
/*
** Prevent Duplicates
*/
   FOR i = 1 TO Objectives.LastRow() DO
       IF AddObjective = Objectives[i].ID THEN
          MESSAGE 'Objective already used in list.';
          RESUME;
       ENDIF;
   ENDFOR;

   TempObjective.Description = FIELD(AddObjective).CurEnumText;
   TempObjective.Comment = '';
   TempObjective.ID = AddObjective;

   
   Objectives.InsertRow (RowNumber = Objectives.LastRow()+1,
                         RowObject = TempObjective.Duplicate());

   FIELD(Objectives).ActiveRow = Objectives.LastRow();

   CurObjRow = Objectives.LastRow();

   CurFrame.SendUserEvent (EventName = 'Special_Logic',
                           MessageInteger = CurObjRow);
END;

ON CHILDENTRY FdrPickList = 
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
    CALLPROC RemoveBlankFeeders();

    i = FIELD(FdrPickList).CurRow;
    IF FdrPickList[i].Object = 0 THEN
       RESUME;
    ENDIF;
    j = InConnectionWith.LastRow()+1;

/* Check duplicate equipment name 
*/
    RetCode = InConnectionWith.Find(AttributeName = 'Name',
                                    Value = FdrPickList[i].Name);
    IF RetCode = ER_OK THEN
       MESSAGE 'A duplicate name is found in '' In Connection With'' list';
       RESUME;
    ENDIF;
	
    InConnectionWith.InsertRow(RowNumber = j, 
                               RowObject = FdrPickList[i].Duplicate());
    FIELD(InConnectionWith[j].Name).BGColor = CC_PALE_BLUE;
    IF InConnectionWith.LastRow >= 6 THEN
       FIELD(InConnectionWith).HasScrollBar = TRUE;
    ELSE
       FIELD(InConnectionWith).HasScrollBar = FALSE;
    ENDIF;

    FdrPickList.RemoveRow(RowNumber = i);
    CurFrame.InputFocusField = FIELD(OrderComment);
END;

ON CHILDENTRY InConnectionWith[*].Name = 
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
    i = FIELD(InConnectionWith).CurRow;

    IF FIELD(InConnectionWith[i].Name).BGColor = CC_PALE_CYAN THEN
       RESUME NEXT;
    ELSE    
       FdrPickList.InsertRow(RowNumber = FdrPickList.LastRow()+1, 
                             RowObject = InConnectionWith[i].Duplicate());
       InConnectionWith.RemoveRow(RowNumber = i);
       CurFrame.InputFocusField = FIELD(OrderComment);
    ENDIF;
END;

ON ChildSetValue InConnectionWith[*].Name = 
BEGIN
   CALLPROC RemoveBlankFeeders();
   IF InConnectionWith.LastRow >= 6 THEN
       FIELD(InConnectionWith).HasScrollBar = TRUE;
   ELSE
       FIELD(InConnectionWith).HasScrollBar = FALSE;
   ENDIF;
END;

ON CHILDENTRY InConnectionWith[*].TypeName =
BEGIN 
/*
**  Get the job row we are on
*/
    CurConRow = Field(InConnectionWith).WhichRow(Cellfield = CurFrame.TriggerField);

    IF InConnectionWith[CurConRow].Type <> 0 THEN
       FIELD(TypePopup.List).CurEnumValue = InConnectionWith[CurConRow].Type;
       FIELD(TypePopup.List).CurEnumText = InConnectionWith[CurConRow].TypeName;
    ELSE
        TypePopup.Selected.Type = InConnectionWith[CurConRow].Type;
        TypePopup.Selected.Name = InConnectionWith[CurConRow].TypeName;
    ENDIF;    
/*
**  Place the popup list on the screen
*/
    Field(TypePopup).AbsXLeft = FormField(CurFrame.TriggerField).AbsXLeft;
    Field(TypePopup).AbsYTop = FormField(CurFrame.TriggerField).AbsYBottom;
    Field(TypePopup).CurBias = FB_CHANGEABLE;
    CurFrame.InputFocusField = FIELD(TypePopup.Cancel_Btn);
    CurFrame.Flush();
END;

On Click TypePopup.List =
BEGIN
    TypePopup.Selected.Type = FIELD(TypePopup.List).CurEnumValue;
    TypePopup.Selected.Name = FIELD(TypePopup.List).CurEnumText;   
END;

On SetValue TypePopup.Selected.Name = 
BEGIN
    TypePopup.Selected.Type = 0;
END;

On Click TypePopup.OK_Btn = 
BEGIN
/*
** Put the value into the type column
*/
    InConnectionWith[CurConRow].Type = TypePopup.Selected.Type;
    InConnectionWith[CurConRow].TypeName = TypePopup.Selected.Name;

    FIELD(TypePopup).CurBias = FB_INVISIBLE;
END;

On Click TypePopup.Cancel_Btn =
BEGIN
    FIELD(TypePopup).CurBias = FB_INVISIBLE;
END;

ON CLICK Add_Btn =
BEGIN
/*
** Create Operating Order and link moves to the order.
*/
   IF Objectives.LastRow() = 0 THEN
      IF OrderType = 'WORK PERMIT' THEN
         /* OK */
      ELSE
         MESSAGE 'Please enter an Objective for the Operating Order';
         RESUME;
      ENDIF;
   ENDIF;
   IF DistrictOperator = '' THEN
      MESSAGE 'Please identify the District Operator creating the Operating Order';
      RESUME;
   ENDIF;
   IF FIELD(ObjDetails).CurBias = FB_VISIBLE THEN
      MESSAGE 'Please close the objective details screen.';
      RESUME;
   ENDIF;

   IF FIELD(SubDetails).CurBias <> FB_INVISIBLE THEN
      MESSAGE 'Please close the substation map number screen.';
      RESUME;
   ENDIF;
/*
** Check for unedited blank objective.
*/
   FOR i = 1 TO Objectives.LastRow() DO
      IF Objectives[i].ID = Objective$Blank AND 
            (Objectives[i].Description LIKE '%Blank Objective%' OR 
             Objectives[i].Description = '') THEN
         MESSAGE 'Please update the blank objective or delete it. ' + HC_NEWLINE + 'Thank you.';
         RESUME;
      ENDIF;
   ENDFOR;
/*
** Check for G&T and Bus Config change.
*/
   IF (BusConfiguration.Type = BusConfig$ROBkrTestBus OR
       BusConfiguration.Type = BusConfig$FixBkrTestBus OR
       BusConfiguration.Type = BusConfig$ROBkrTestBusJamaica) AND
       GTGndExist = TRUE THEN 
          IF BusConfiguration.Type = BusConfig$ROBkrTestBus THEN
             BusConfiguration.Type = BusConfig$ROBkrNoTestBus;
          ELSEIF BusConfiguration.Type = BusConfig$FixBkrTestBus THEN
             BusConfiguration.Type = BusConfig$FixBkrNoTestBus;
          ELSEIF BusConfiguration.Type = BusConfig$ROBkrTestBusJamaica THEN
             BusConfiguration.Type = BusConfig$ROBkrNoTestBusJamaica;
          ENDIF;
          
          SELECT :BusConfiguration.Name = T.Name
          FROM   Udb_Type T
          WHERE  T.Type = :BusConfiguration.Type;
   ENDIF;
/*
** make sure at least one feeder/line has been selected or added
*/
   IF FIELD(FdrPickList).CurBias <> FB_INVISIBLE THEN
      FOR i = 1 TO InConnectionWith.LastRow DO
          IF TRIM(InConnectionWith[i].Name) <> '' THEN
             ENDLOOP;
          ENDIF; 
      ENDFOR;

      IF i > InConnectionWith.LastRow THEN
         MESSAGE 'Please select or enter feeders or lines that are in connection with the Operating Order';
         RESUME;
      ENDIF;
      /*
      ** make sure each In-Connection-With equip has a type name
      ** This check no longer desired as of 03/10/15.
      FOR i = 1 TO InConnectionWith.LastRow DO
         IF TRIM(InConnectionWith[i].TypeName) = '' THEN
            InConnectionWith[i].Name = TRIM(InConnectionWith[i].Name);
            k = LOCATE(InConnectionWith[i].Name, ' ');
            IF k = (SIZE(InConnectionWith[i].Name) + 1) THEN  // type name not included in equip name
               MESSAGE 'Please select or enter the type for equipment ' + InConnectionWith[i].Name + ' in the ''In Connection With'' list.';
               RESUME;   
            ENDIF;
         ENDIF;
      ENDFOR;
      */
   ENDIF;
/*
** check for dupliate names in 'In Connection With' list
*/   
   FOR i = 2 TO InConnectionWith.LastRow DO
      FOR j = 1 TO i-1 DO
          IF InConnectionWith[j].Name = InConnectionWith[i].Name AND
             InConnectionWith[j].TypeName = InConnectionWith[i].TypeName AND
             InConnectionWith[j].Object = InConnectionWith[i].Object THEN
             MESSAGE 'Please remove duplicate equipment in the ''In Connection With'' list.';
             RESUME;
          ENDIF;
      ENDFOR;
   ENDFOR;

/*
**  Make sure none of the moves is on an Opened/Download/Acknowledged order. 
*/
   FOR i = 1 to Jobs.LastRow() DO
      IF Jobs[i].Status = Job$Restore THEN
         TORS = 1;
      ELSEIF Jobs[i].Status = Job$TakeOut THEN
         TORS = 0;
      ENDIF;
      OrderCheck = 0;

      REPEATED 
      SELECT :OrderCheck = J.Job 
      FROM   IR_OperatingOrder O,
             IR_OpOrderJobs J
      WHERE  J.Job = :Jobs[i].Job AND
             J.ToRs = :ToRS AND
             J.OrderNumber = O.OrderNumber AND
             O.OrderStatus IN (:Order$Opened,:Order$Downloaded,:Order$Acknowledged);
      CALLPROC DDB_ROLLBACK;
   
      IF OrderCheck <> 0 THEN
         MESSAGE 'Job: ' + Jobs[i].TOMove + ' is already in an outstanding order.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDFOR;
/*
** Now scroll through jobs array, and if the OrderType is Work Permit then each
** job is on its own order, otherwise they are all put on one order.
*/
   
   FOR k = 1 to Jobs.LastRow() DO

      OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
      IF (OrderNumber < 0) THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error: Could not generate an Operating Order Number.  Try again. ' +
                 'Udb_Lastkey table may not be synchronous between servers. ';
         RESUME;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;

      IF ProcessAutoMode = TRUE THEN
         OrderStatus = Order$SetUp;
      ELSE
         OrderStatus = Order$Opened;
      ENDIF;

      RetCode = CALLPROC IR_OperatingOrderIns (
                                        OrderNumber = OrderNumber,
                                        Application = CurrentApplication,
                                        Card = Jobs[k].Card,
                                        SwitchingItem = Jobs[k].SwitchingItem,
                                        OrderStatus = OrderStatus,
                                        OrderTarget = OrderTarget,
                                        OrderComment = OrderComment,
                                        OrderType = OrderType,
                                        Substation = Substation,
                                        BusConfiguration = BusConfiguration.Type,
                                        IssuedByDO = DistrictOperator,
                                        ByDesk = Jobs[k].DeskName,
                                        IssueTime = 'now');
                                       
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to generate new Operating Order due to an error.';
         RETURN PU_CANCEL;
      ENDIF;

      IF OrderType = 'REGULAR' THEN

         JobSeq = 1; 
         FOR i = 1 TO Jobs.LastRow() DO 
            IF Jobs[i].Basekey = 0 THEN  /* Don't insert submoves here */
               JobSeq = CALLPROC InsertOrderJobs(
                                 OrderNumber = OrderNumber,
                                 Seq = JobSeq,
                                 Move = Jobs[i]);

               IF JobSeq = 0 THEN
                  RETURN PU_CANCEL;
               ENDIF;
            ENDIF;
         ENDFOR;

      ELSE
         RetCode = CALLPROC IR_InsertOpOrderJobs (
                                        OrderNumber = OrderNumber,
                                        Seq = 1,
                                        TORS = 0,
                                        Job = Jobs[k].Job);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to link jobs to new Operating Order due to an error.';
            RETURN PU_CANCEL;
          ENDIF;
       ENDIF;
  
       FOR i = 1 TO Objectives.LastRow() DO 
          RetCode = CALLPROC IR_OpOrderObjectiveIns (
                                        OrderNumber = OrderNumber,
                                        Seq = i,
                                        Objective = Objectives[i].ID,
                                        Description = Objectives[i].Description,
                                        Comment = Objectives[i].Comment);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Unable to link objectives to new Operating Order due to an error.';
             RETURN PU_CANCEL;
          ENDIF;
       ENDFOR;
       CALLPROC DDB_COMMIT;

       LastRow = InConnectionWith.LastRow();
       FOR i = 1 TO LastRow DO 
          IF TRIM(InConnectionWith[i].Name) <> '' THEN
             RetCode = ER_ROWNOTFOUND;
             IF i > 1 AND InConnectionWith[i].Object = 0 THEN
                RetCode = InConnectionWith.Find(AttributeName = 'Name',
                                             Value = InConnectionWith[i].Name,
                                             RowNumber = ByRef(j),
                                             EndRow = (i-1));
                IF RetCode = ER_OK THEN
                   IF InConnectionWith[j].Object <> 0 THEN
                      RetCode = ER_ROWNOTFOUND;
                   ENDIF;
                ENDIF;
             ENDIF;
             IF RetCode = ER_ROWNOTFOUND THEN
                RetCode = CALLPROC IR_OpOrderFeedersIns (
                                        OrderNumber = OrderNumber,
                                        Object = InConnectionWith[i].Object,
                                        Name = InConnectionWith[i].Name,
                                        TypeName = InConnectionWith[i].TypeName);
                IF RetCode < 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Unable to add feeders/lines to new Operating Order due to an error.';
                ENDIF;
             ENDIF;
          ENDIF;
       ENDFOR;
       CALLPROC DDB_COMMIT;      

       IF ProcessAutoMode = TRUE THEN

          RetCode = CALLPROC SOA_LogIns (
                            Card              = Jobs[1].Card
                            , Job             = NULL
                            , SwitchingItem   = Jobs[1].SwitchingItem
                            , Time            = DATE('now')
                            , UserName        = UserName
                            , Item            = 'Generate Order'
                            , Old             = 'For SSO Automation'
                            , New             = 'Order Number: ' +
                                                 Varchar(OrderNumber));
      ELSE
         MessageField = 'Operating Order ' + varchar(ordernumber) + 
                        ' has been created for ' + SubstationName; 
     
         RetCode = CALLPROC SOA_LogIns (
                            Card              = Jobs[k].Card
                            , Job             = NULL
                            , SwitchingItem   = Jobs[k].SwitchingItem
                            , Time            = DATE('now')
                            , UserName        = UserName
                            , Item            = 'Generate Order'
                            , Old             = 'For SSO at ' + SubstationName
                            , New             = 'Order Number: ' +
                                                 Varchar(OrderNumber));
      ENDIF;

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to log generation of Operating Order due to an error.';
      ELSE   
         CALLPROC DDB_COMMIT;
      ENDIF; 

      IF ProcessAutoMode = FALSE THEN
/*
** Now insert message for tracking purposes.
*/
         MsgKey = CALLPROC MSG_SendMsg (Card = Jobs[k].Card,
                                  Action = 0,
                                  OrderNumber = IFNULL(OrderNumber,0), 
                                  Substation = Substation,
                                  SubstationName = SubstationName,
                                  Msg = CurrentApplication + ' ' + CardName + 
                                        ' sent Operating Order to ' + SubstationName + '.' + HC_NEWLINE +
                                        'First Move: ' + Jobs[k].TOMove,
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SSO',
                                  FromApp = CurrentApplication,
                                  Priority = 0
                                  );
         IF MsgKey < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message.' + 
              '  You might want to contact the Substation Operator to ' +
              'confirm that he has received the order.';
            MESSAGE :MessageField;
         ELSE
            CALLPROC DDB_COMMIT;
            RetCode = CALLPROC IR_MsgKeyUpd (MsgKey = MsgKey,
                                             OrderNumber = OrderNumber);
            IF Retcode = 0 THEN
               CALLPROC DDB_COMMIT;
            ELSE
               CALLPROC DDB_ROLLBACK;
               MessageField = MessageField + '  The system was, however, ' +
                 'unable to record the outgoing message id.' + 
                 '  You might want to contact the Substation Operator to ' +
                 'confirm that he has received the order.';
               MESSAGE :MessageField;
            ENDIF;
         ENDIF;

         ControlText = varchar(ordernumber); 
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_NewOpOrder', 
                     EventText = ControlText);  
/*
** All done with order, Call priority update screen which will only display
** if there is more than one outstanding order.
*/
         CALLFRAME ChangeOrderPriority (OrderSubstation = Substation);

         /*
         ** check to update SWP outage report's actual work permit issue time
         */
         IF OrderType = 'WORK PERMIT' THEN
            IF SingleSWP IS NULL THEN
               SingleSWP = OutageReport.Create();
            ENDIF;
            SingleSWP.SetActualWorkIssueDate(JIP = Jobs[k]);
         ENDIF;
      ELSE
/* 
** Build Block Title and Using Step Heading and words after the description
/* Save order for Process Automation Execution.
*/    
         SELECT :StepHeading = SQUEEZE(Name) + ' ' 
         FROM   FMS_StepPair
         WHERE  TypeOfCard = :Type$13kVCard AND
                StepPair = :Jobs[1].StepPair;

         IF Jobs[1].Status = Job$TakeOut THEN
            StepHeading = SQUEEZE(LEFT(StepHeading,LOCATE(StepHeading,' '))) + ': ';
        
            i = 0;
            i = LOCATE(Jobs[1].TOMove, '-');
            IF i = (SIZE(Jobs[1].TOMove) + 1) THEN
               StepHeading = StepHeading + Jobs[1].TOMove;
            ELSE
               StepHeading = SQUEEZE(StepHeading + SHIFT(Jobs[1].TOMove, -1 * i));
            ENDIF;
         ELSE
            i = 0;
            i = LOCATE(SHIFT(StepHeading, -1 * (LOCATE(StepHeading,' '))),'-');
            IF i <> (SIZE(StepHeading) + 1) THEN
               StepHeading = SQUEEZE(SHIFT(StepHeading, -1 * (i+1)));
            ENDIF;
            StepHeading = StepHeading + ': ';

            i = 0;
            i = LOCATE(Jobs[1].RSMove, '-');
            IF i = (SIZE(Jobs[1].RSMove) + 1) THEN
               StepHeading = StepHeading + Jobs[1].RSMove;
            ELSE
               StepHeading = SQUEEZE(StepHeading + SHIFT(Jobs[1].RSMove, -1 * i));
            ENDIF;

         ENDIF;
  
         CALLFRAME DefineAutoBlock (
                  Card = Jobs[1].Card,
                  Block = OrderNumber,
                  SendTo = 'SSO',
                  Title = StepHeading);  
      ENDIF;

      IF OrderType = 'REGULAR' THEN
         ENDLOOP;  /* This busts us out of the Work Permit Loop*/
      ENDIF;
   ENDFOR;   /* If we are doing work permits one at at time, increment to next one.*/
/*
** Set or Remove G&T or Feeder Ground status for the feeder.
*/
   CALLPROC SetClearFeederStatus();

   IF ManualOrderToggle = TRUE AND
      (CurrentApplication = Application$TFMS OR CurrentApplication = Application$SLC) AND 
      OrderType = 'REGULAR' THEN
      CALLPROC DisplayOrderPrint();
   ENDIF;
   
   RETURN PU_OK;
END;

ON CLICK cancel_btn = 
BEGIN
   IF CurFrame.ConfirmPopup (messagetext = 
      'Exit without generating operating order?') = PU_OK THEN
      RETURN PU_CANCEL;
   ENDIF;
END;


