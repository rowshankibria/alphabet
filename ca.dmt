**                          new procedure to ask user what to drive
**  11/24/93    em          use object type instead of member type
**  06/10/93    pw          drop feeder statuses associated w/dropped equipment    
**  09/29/94    hlf         allow user to choose division to drop to if there is more than one
**  11/14/94    em          display message indicating connectivity implications
**  11/16/94    em          add message if attempting to drop source position 
**                          or source breaker.
**  12/14/94    bgh         Passed EquipClass to FMS_PickupEquip procedure
**  01/10/95    pkw         Drop equipment from connectivity if needed
**  04/17/95    pkw         Drop connectivity for production
**  08/09/95    em          Manage moves for Macro Equip
**  12/13/96    em          Call FMS_ManageCardHeader when grounded equip dropped.
**  03/17/97    jfl         Use MacroGrouper to exclude grouper types.
**  07/25/98    em          Performance; removed NOT IN Grouper sub-select
**  08/04/02    pkw         Add comment fields from FCR.
**  08/20/02    ysp         Merge: use SOA_Job tables.
**  01/16/03    em          Added soem strategic commits
**  02/04/03    ysp         changed FeederStatusUpd to FeederStatusUndo
**  02/07/03    em          Make sure Grounds is not zero before calling
**                          UpdateJob
**  03/31/03    em          SELECT DISTINCT when getting outstandingmoves
**  04/07/05    ysp         Not to save ground moves in the drop bank.
**  08/10/05    ysp         A change to 4/7/05 implementation: only NWP type equipment 
**                          (and all its subtypes) will lose the ground when the equipment 
**                          is dropped.  Grounds (and the ground move) on all other 
**                          dropped equipment should be retained.
**  09/21/05    ysp         check the ground status before dropping the outstanding jobs 
**                          so that Grounded has the correct value to allow us to update
**                          the card hearder.
** 12/14/05     ysp         Increase the size of tomove to 160 chars
** 04/19/06     ysp         FMS322: because the system already grays out the moves in both the 
**                          active and open cards, the code to purge open cards is commented out.
**                          This feature has been replaced by db rule fms_closeopencards1
** 05/15/06     ysp         Remove FCR entered equipment because it is no longer displayed.
** 06/02/06     ysp         Return PU_OK if equipment is dropped, otherwise, PU_CANCEL.
** 07/09/06     ysp         ITC 184: Equipment can not be dropped if it has moves in outstanding
**                          operationg order or FOD order.
** 09/12/06     ysp         Highlight all rows if SelectEquip is passed in from the calling environment.
** 11/20/07     ysp         Bug fix: pass TO/RSOperator to soa_updatejob procedure.
** 04/02/08     ysp         ITC 213: log audit trail when equipment is dropped
** 04/02/08     pkw         Change dop.description to dop.object when logging
** 05/16/08     ysp         FMS 382: Check for duplicate equipment in drop bank before dropping
**                          the selected equipment to prevent duplicate insert error.
** 08/20/10     em          Adjust for 3G.
** 03/28/11     pkw         Pass FeederObj and FeederName 
** 12/17/12     em          Exclude ATS Grouper from drop equipment list.
** 03/05/13     pkw         Add calls to FMS_DeadMoveCount so that count is 
**                          updated when dropping equipment.
** 07/25/13     ysp         Drop equipment phase checks when equipment is dropped
** 09/16/13     ysp         Drop equipment from connectivity and disable feeder connected source and  
**                          validation flags. Pass dropped equipment and feeder to DropConnectivity frame.
** 09/20/13     pkw         Pair selects of SD-VIS and SD-TRANSF.
** 04/20/16     ysp         1. set Equip object's Feeder and FeederName attributes. 2. For 33kv, show all equipment
**                          on all portions on the card.
** 12/12/16     em          Removed REPEATED from one select where :FeederName was in the select list.
** 02/02/17     pkw         Make sure to drop macro equipment when dropping one of the legs
** 06/13/17     em          Remove QGIS Model connectivity when dropping except for Fdr_Load equip types
** 04/11/19     em          Correct bug that is clearing SourceConnected when dropping equipment; this code
**                          will have even bigger ramifications when feeder diagrams are implemented.  
**                          This program is already blocking Source Breaker and Source Position from being disconnected.
**                          Since Feeder Diagrams connectivity changes will come through pvl and source connectivity needs 
**                          to be managed on the QGIS Diagram Editor, we are simply not going to change any connectivity 
**                          when dropping feeder equipment and not delete SourceConnected at all.
**                          The call to the DisconnectEquipment procedure has been commented out.
** 06/13/19     pkw         Update audit trail insert to match inserts from other frames.
** 08/07/19     pkw         comment out audit trail insert now that connected source got commented out.
** 03/34/20     em          Add call to MarkDiagramInvalid for the Feeder
*/ 
INITIALIZE   
(
/* passed-in */
    C = FMS_Card DEFAULT NULL;		    /* parameter - current card */ 
    Jobs = ARRAY of Job;

/* local variables */
#   include StandardDeclarations
    j = integer;		
    k = integer;
    m = integer;		
    n = INTEGER NOT NULL WITH DEFAULT;	
    ByPassSelection = INTEGER NOT NULL WITH DEFAULT;	
    status = integer;   	/* return status variable */ 
    entrymade = integer;	/* indicates if an entry was made */ 
    Div = ARRAY OF DIVISION;   
    EquipDiv = DIVISION; /* which division for equip */
    OtherFeeders = ARRAY OF ObjectSummaryClass;  /* feeders for common equip */
    DropFromAll= INTEGER NOT NULL WITH DEFAULT; /*Boolean*/
    OrigCard = FrameExec;
    EventText = VARCHAR(256) NOT NULL;
    FeederObj = INTEGER NOT NULL WITH DEFAULT;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; 
    Title = VARCHAR(100) NOT NULL;
    MacroEquip = INTEGER NOT NULL WITH DEFAULT;
    MacroEquipClass = INTEGER NOT NULL WITH DEFAULT;
    MacroEquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
    MacroMoves = INTEGER NOT NULL WITH DEFAULT;
    Grounded = INTEGER NOT NULL WITH DEFAULT;
    ImpactedFeeders = ARRAY OF ObjectSummaryClass; 
    x = INTEGER;
    TempCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
    ImpactedCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
    OutStandingJobs = ARRAY of IntegerObject;
    OutStandingCards = ARRAY of IntegerObject;
    NWPGroundMove = INTEGER NOT NULL WITH DEFAULT; 
) = 
DECLARE
    AddToImpactedFeeders = PROCEDURE;
    DisconnectEquipment = PROCEDURE RETURNING INTEGER;
    SD_Link = PROCEDURE;
    SD_Drop = PROCEDURE;
ENDDECLARE
/* 
**  Load the data for the equipment selection from the database 
**  into the 4GL environment and set up the display: 
*/ 
BEGIN 
   entrymade = 0; 
   ByPassSelection = 0;

   IF SelectEquip.LastRow() > 0 THEN
      FIELD(SelectEquip).Title = 'Selected Equipment to Drop';
      FIELD(Done_Btn).TextLabel = 'Confirm To Drop';
      ByPassSelection = 1;
      
      FOR i = 1 TO SelectEquip.LastRow() DO
         IF C.NetworkFeeder > 0 THEN 
            SELECT :SelectEquip[i].Feeder = G.Grouping,
                   :SelectEquip[i].FeederName = O.Name
            FROM   UDB_Grouping G,
                   UDB_Object O
            WHERE G.Member = :SelectEquip[i].Equip AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.GroupingType IN (SELECT Type 
                                     FROM   UDB_ExtendedType
                                     WHERE  SuperType = :Type$Feeder) AND
                  G.Grouping = O.Object;
         ELSE
            SelectEquip[i].Feeder = C.Feeder;
            SelectEquip[i].FeederName = C.FeederName;
         ENDIF;
         
         FIELD(SelectEquip[i].Origin).IsReverse = TRUE;
         FIELD(SelectEquip[i].PrintID).IsReverse = TRUE;
         FIELD(SelectEquip[i].EquipClassName).IsReverse = TRUE;
         FIELD(SelectEquip[i].EquipName).IsReverse = TRUE;
         FIELD(SelectEquip[i].Description).IsReverse = TRUE;
      ENDFOR;
      CurFrame.Flush();

   ELSEIF C.NetworkFeeder = NetworkFeeder$3G THEN
      FeederObj = C.Object[1].Object;
      FeederName = C.Object[1].Name; 
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');

      IF C.Object.LastRow() > 1 THEN
         FIELD(NetworkFeeder).ValueList.ChoiceItems.Clear();
         FOR i = 1 TO C.Object.LastRow() DO
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumValue = C.Object[i].Object;
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumText = C.Object[i].Name;
         ENDFOR;
         FIELD(NetworkFeeder).CurBias = FB_CHANGEABLE;
         /* OR5.1 FIELD(NetworkFeeder).ColumnWidthCompressed = TRUE; */
         FIELD(NetworkFeeder).UpdChoiceList();
         NetworkFeeder = C.Object[1].Object; 
      ENDIF;
   ELSE
      FeederObj = C.Feeder;
      FeederName = C.FeederName;
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');
   ENDIF;
   OrigCard = OpenFrame OriginalCard (C = C);
END;

ON SETVALUE NetWorkFeeder =
BEGIN
   FeederObj = FIELD(NetworkFeeder).CurEnumValue;
   FeederName = FIELD(NetworkFeeder).CurEnumText;
   CurFrame.SendUserEvent (EventName = 'LoadDisplay');
END;

ON USEREVENT 'LoadDisplay' =
BEGIN
   /*
   ** FeederObj and FeederName will be set when drop process starts because each equipment is on a different portion.
   */

   SelectEquip.Clear();
   i = 1;
   
   IF C.NetworkFeeder = NetworkFeeder$33KV THEN
      REPEATED
      SELECT  :SelectEquip[i].Equip = O.Object,  
              :SelectEquip[i].EquipName = O.Name, 
              :SelectEquip[i].EquipClass  = O.Type, 
              :SelectEquip[i].EquipClassName  = O.TypeName, 
              :SelectEquip[i].PrintID = G.Reference, 
              :SelectEquip[i].Origin = O.OwnerNumber, 
              :SelectEquip[i].Description = O.Description,
              :SelectEquip[i].Feeder = G.Grouping,
              :SelectEquip[i].FeederName = O2.Name
      FROM    Udb_Object O, 
              Udb_Grouping G,
              TFMS_CardToObject CTO,
              Udb_Object O2
      WHERE   CTO.Card = :C.Card AND
              CTO.Object = O2.Object AND 
              CTO.Object = G.Grouping AND	
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND 
              O.Type IN (SELECT Type
                         FROM   Udb_ExtendedType
                         WHERE  SuperType = :Type$Switch) AND
              O.Type NOT IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  SuperType IN (:Type$Grouper,:Type$3GSwitch)) AND 
              O.Object > 20000  /* excludes generic equipment from list */
      ORDER BY PrintID, EquipName, Equip
      BEGIN 
         i = i + 1; 
      END; 
      
      /* remove duplicate interrupter switches because they are members of two portions.
      */
      i = SelectEquip.LastRow;
      WHILE i >=2 DO
         IF SelectEquip[i-1].Equip = SelectEquip[i].Equip THEN
            SelectEquip.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
   ELSE
      SELECT   :SelectEquip[i].Equip = O.Object,  
               :SelectEquip[i].EquipName = O.Name, 
               :SelectEquip[i].EquipClass  = O.Type, 
               :SelectEquip[i].EquipClassName  = O.TypeName, 
               :SelectEquip[i].PrintID = G.Reference, 
               :SelectEquip[i].Origin = O.OwnerNumber, 
               :SelectEquip[i].Description = O.Description,
               :SelectEquip[i].Feeder = G.Grouping,
               :SelectEquip[i].FeederName = :FeederName
      FROM    Udb_Object O, 
              Udb_Grouping G  
      WHERE   G.Grouping = :FeederObj AND	/* tied to a feeder */ 
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND 
              O.Type IN (SELECT Type
                         FROM   Udb_ExtendedType
                         WHERE  SuperType = :Type$Switch) AND
              O.Type NOT IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  SuperType IN (:Type$Grouper,:Type$3GSwitch)) AND 
              O.Object > 20000   /* excludes generic equipment from list */
      ORDER BY PrintID, EquipName 
      BEGIN 
         i = i + 1; 
      END; 
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END; 

/* 
**  Handle an equipment selection from the list: 
*/ 
ON ChildEntry SelectEquip = 
BEGIN 
    IF (CurFrame.ReasonCode <> RC_MOUSECLICK) THEN 
      RESUME; 
    ENDIF; 
/*
** if SelectEquip is passed in, don't allow de-selection of equipment.
*/
    IF ByPassSelection = 1 THEN
       RESUME;
    ENDIF;

    entrymade = 1; 
    IF (FIELD(SelectEquip[].Description).IsReverse = FALSE) THEN 
       /*
       **  Check if equip has a move that was downloaded to an Operating Order or FOD Order
       */
       RetCode = CALLPROC CheckOutstandingEquip(Equip = SelectEquip[].Equip);

       IF RetCode = PU_CANCEL THEN
          MESSAGE 'Equipment ' +
                SelectEquip[].EquipClassName + '  ' +
                SelectEquip[].EquipName +
               ' has a move or moves that were downloaded to an order. ' + 
               ' This equipment cannot be dropped from the feeder ' +
               'until the order order processing is complete and confirmed.';
          RESUME;
      ENDIF;

      FIELD(SelectEquip[].Origin).IsReverse = TRUE; 
      FIELD(SelectEquip[].Description).IsReverse = TRUE; 
      FIELD(SelectEquip[].PrintID).IsReverse = TRUE; 
      FIELD(SelectEquip[].EquipName).IsReverse = TRUE; 
      FIELD(SelectEquip[].EquipClassName).IsReverse = TRUE; 
       
      CALLPROC SD_Link(Object = SelectEquip[].Equip,
                       IsReverse = TRUE,
                       Type = SelectEquip[].EquipClass);
    ELSE 
      FIELD(SelectEquip[].Origin).IsReverse = FALSE; 
      FIELD(SelectEquip[].Description).IsReverse = FALSE; 
      FIELD(SelectEquip[].PrintID).IsReverse = FALSE; 
      FIELD(SelectEquip[].EquipName).IsReverse = FALSE; 
      FIELD(SelectEquip[].EquipClassName).IsReverse = FALSE; 
       
      CALLPROC SD_Link(Object = SelectEquip[].Equip,
                       IsReverse = FALSE,
                       Type = SelectEquip[].EquipClass);
    ENDIF; 
END; 

ON Click Cancel_Btn,
ON Click Done_Btn =
BEGIN
/*
**  Check to see whether or not the original card data needs to be saved.
*/
    IF (Curframe.TriggerField = FIELD(Done_Btn)) THEN
        OrigCard.SendUserEvent (EventName = 'UpdateCard');
        Curframe.SendUserEvent (EventName = 'ContinueDone_Btn');
    ELSE
        OrigCard.SendUserEvent (EventName = 'ExitFrame');
        Curframe.SendUserEvent (EventName = 'ContinueCancel_Btn');
    ENDIF;
END;

/* 
**   Handle a DONE click:  
*/ 
ON UserEvent 'ContinueDone_Btn' = 
BEGIN 
   ImpactedFeeders.Clear();
/*
** loop through selected equipment
*/
   i = SelectEquip.FirstRow(); 
   WHILE (i <= SelectEquip.LastRow()) DO 

      IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN 
/*
**  Check for source breaker/source position complications
*/
         REPEATED 
         SELECT :j = COUNT(*)
         FROM   Udb_Grouping
         WHERE  Member = :SelectEquip[i].Equip AND
               Relationship IN (:Interaction$SourcePosition, 
                                :Interaction$SourceBreaker) AND
               Grouping = :SelectEquip[i].Feeder;
         IF j > 0 THEN 
           Message 'A selected equipment is defined as a Source Position or ' +
                'Source Breaker for this feeder and cannot be dropped. ' +
                'Use ModifyDB or Udb Access to resolve ' +              
                'source breaker/source position issues for the feeder before ' +
                'attempting to drop this equipment.';
               RESUME;
         ENDIF;
/* 
**  Which division should this equip be dropped to? 
*/
         Div.Clear();
         j = 1;
         REPEATED
         SELECT :Div[j].Division = G.Grouping,
                :Div[j].DivisionName = O.Name
         FROM   Udb_Grouping G,
                Udb_Object O
         WHERE  G.Member = :SelectEquip[i].Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Division AND
                G.Grouping = O.Object
         BEGIN
            j = j + 1;
         END;

         /*  Only one division, then set it */
         IF (Div.LastRow() = 1) THEN
            EquipDiv.Division = Div[1].Division;
            EquipDiv.DivisionName = Div[1].DivisionName;

         /*  Multiple Divisions, make them choose only one!. */
         ELSEIF (Div.LastRow() > 1) THEN
            EquipDiv = CALLFRAME SelectDivision ( Div = Div );

         /*  No explicit Division, get Division for Feeder thru hierarchy */
         ELSEIF (Div.LastRow() = 0) THEN

           REPEATED
           SELECT :EquipDiv.Division = G2.Grouping,
                  :EquipDiv.DivisionName = O.Name
           FROM   Udb_Grouping G1,
                  Udb_Grouping G2,
                  Udb_Object O
           WHERE  G1.Member = :SelectEquip[i].Equip AND
                  G1.Relationship = :Interaction$MemberOf AND
                  G1.GroupingType IN (SELECT Type 
                                      FROM   Udb_ExtendedType
                                      WHERE  SuperType = :Type$Feeder) AND
                  G1.Grouping = G2.Member AND
                  G2.Relationship = :Interaction$MemberOf AND
                  G2.GroupingType = :Type$Division AND
                  G2.Grouping = O.Object;

           IF EquipDiv.Division = 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Could not find appropriate Division for this Equipment.';
              RESUME; 
           ENDIF; 
         ENDIF; 
/*
** check if there is already a piece of equipment with the same name and type
** in the drop bank.
*/
         n = 0;
         SELECT :n = Object
         FROM   Udb_Object
         WHERE  Type = :SelectEquip[i].EquipClass AND
               Name = :SelectEquip[i].EquipName AND
               PrimaryGrouping = :EquipDiv.Division;
         IF n > 0 THEN
           /* There is a duplicate. Ask the DO to change the name of the equipment
           ** in the drop bank.
           */
           RetCode = CALLFRAME RenameDroppedEquipment(Equip = n);
           IF RetCode = PU_CANCEL THEN
              i = i + 1;
              CONTINUE; 
           ENDIF;
         ENDIF;

         j = 1;
         OtherFeeders.Clear();

         REPEATED
         SELECT :OtherFeeders[j].Object = O.Object,
                :OtherFeeders[j].Name   = O.Name
         FROM   Udb_Object O,
                Udb_Grouping G
         WHERE  O.Object = G.Grouping AND
                O.Type IN (SELECT Type
                          FROM   Udb_ExtendedType
                          WHERE  SuperType = :Type$Feeder) AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = :SelectEquip[i].Equip
         BEGIN
           j = j + 1;
         END;

         DropFromAll= TRUE;
         IF j > 2 THEN  /* It's common equipment */

           status = CALLFRAME DropCommonEquipment 
                      (C = C,
                       Jobs = Jobs,
                       EquipToDrop = SelectEquip[i],
                       OtherFeeders = OtherFeeders,
                       FeederObj = SelectEquip[i].Feeder,
                       FeederName = SelectEquip[i].FeederName
                       );

           IF status = 1 OR Status = 0 THEN  /* Either dropped single or cancelled*/
              DropFromAll = FALSE;
           ENDIF;
         ENDIF;   
/* 
**  Drop the piece of equipment - for all feeders - assign to division 
*/
         IF DropFromAll= TRUE THEN

            status = CALLPROC FeederStatusUndo(Equip = SelectEquip[i].Equip,
                                             SourceCard = C,
                                             J = Jobs,
                                             Action = '');
            IF (status = PU_CANCEL) THEN 
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Unable to drop feeder statuses from current card';
              RESUME; 
            ENDIF;

            status = CALLPROC FMS_DropEquip 
               (Division = EquipDiv.Division,
                     Feeder = SelectEquip[i].Feeder, 
                     FeederType = Type$Feeder,
                     CurrentTime = date('now'),  
                     Equip = SelectEquip[i].Equip, 
                     Relation = Interaction$MemberOf,
                     EquipClass = SelectEquip[i].EquipClass
                ); 

            IF (status <> 0) THEN 
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Unable to drop equipment from current card';
              RESUME; 
            ENDIF;           
            /*
            ** If there are outstanding moves for this piece of equipment, 
            ** save these moves so that they can be picked up when the 
            ** equipment is picked up.
            */
            j = 1;
            OutStandingJobs.Clear();
            OutStandingCards.Clear();

            REPEATED
            SELECT 
            DISTINCT :OutStandingJobs[j].Value = J.Job,
                    :OutStandingCards[j].Value = JC.Card
            FROM   SOA_Job J,
                  SOA_JobControl JC,
                  SOA_ActiveCard AC,
                  SOA_ActiveObject AO
            WHERE  AO.Object = :SelectEquip[i].Feeder AND
                  AO.ObjectToCardLink = 1 AND
                  AO.Card = AC.Card AND
                  AC.Card = JC.Card AND
                  JC.Job = J.Job AND
                  J.Equip = :SelectEquip[i].Equip AND
                  J.TOComplete IS NOT NULL AND
                  J.RSComplete IS NULL AND
                  J.Status = ''
            BEGIN
               j = j + 1;
            END;
            /*
            ** find out if this equipment has a ground status. If so, we will
            ** update the card header after the outstanding jobs are dropped. 
            */
            Grounded = 0;
            REPEATED 
            SELECT  :Grounded = StatusCount
            FROM    FMS_ObjectStatus
            WHERE   Object = :SelectEquip[i].Equip AND
                   Status = :Status$Ground;

            /* we make copies of outstanding moves and save the copies 
            ** to the dropped job bank.  Then we blank out the original
            ** moves. In this way, we don't have to find out what cards 
            ** link to what moves. This is why the logic in this db proc
            ** is not part of FMS_DropEquip.
            */
            j = 1;
            WHILE j <= OutStandingJobs.LastRow() DO
               /*
               ** We will not save the ground moves in the drop bank when dropping equipment.
               ** After the equipment is dropped, it is outside of the DO's jurisdiction. The 
               ** ground may be removed or the equipment may be replaced. When the DO picks 
               ** up the equipment, DO will verify the ground. If there is a ground, DO will 
               ** insert the ground at that time. Per request for Bob. 4/7/05
               ** 8/10/05 - Add a check for the equipment type. This logic is applied to NWP only.
               */
               NWPGroundMove = FALSE;
               SELECT :NWPGroundMove = :TRUE
               FROM   SOA_Job J,
                     SOA_JobControl JC,
                     FMS_JobAction JA
               WHERE  JC.Job = :OutStandingJobs[j].Value AND
                     JC.Card = :OutStandingCards[j].Value AND
                     JC.Job = J.Job AND
                     J.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                           WHERE  SuperType = :TypeName$NWP) AND
                     JA.JobClass = J.JobClass AND
                     JA.Status = :Status$Ground AND
                     JA.EquipClass IN (SELECT SuperType FROM Udb_ExtendedType
                                        WHERE  Type = JC.MoveEquipClass);

               IF NWPGroundMove = TRUE THEN
                  status = CALLPROC FMS_ObjStatDel(
                                          Object = SelectEquip[i].Equip,
                                          Terminal = 0, 
                                          Status = Status$Ground);
                 IF (status <> 0) THEN 
                    CALLPROC DDB_ROLLBACK;
                    MESSAGE 'Unable to delete the ground status ' + 
                         'for the dropped equipment.';
                    RESUME; 
                 ENDIF;
               ELSE
                 status = CALLPROC FMS_SaveEquipJob(
                                          Equip = :SelectEquip[i].Equip,
                                          Job = OutStandingJobs[j].Value);
                 IF (status <> 0) THEN 
                    CALLPROC DDB_ROLLBACK;
                    MESSAGE 'Unable to store moves in the job bank ' + 
                         'for the dropped equipment.';
                    RESUME; 
                 ENDIF;
               ENDIF;

               j = j + 1; 
            ENDWHILE;
            CALLPROC DDB_COMMIT; 
            /*
            **   IF Dropped Equip is grounded, Manage Card Header for each impacted feeder
            */
            IF Grounded > 0 THEN
               x = 1;
               WHILE x <= OtherFeeders.LastRow() DO
                  CALLPROC FMS_ManageCardHeader (OptionalFeeder = OtherFeeders[x].Object,
                            Equip = 0);
                  CALLPROC DDB_COMMIT;
                  x = x + 1;
               ENDWHILE;
            ENDIF;                                        
            /*
            **   Remove from connectivity if necessary  
            **   04/11/19 Feeder Source Equipment is already blocked from being dropped.  We don't want to mess up
            **   Feeder Diagrams by deleting connnectivity.  Pvl updates will manage Feeder Diagram changes.
            **   No need to do anything with the DisconnectEquipment procedure (why mark feeder invalid when equipment dropped). 
            IF (SelectEquip[i].EquipClass <> Type$FdrLoad AND
                 SelectEquip[i].EquipClass <> Type$LinkPH AND
                 SelectEquip[i].EquipClass <> Type$FdrPH AND
                 SelectEquip[i].EquipClass <> Type$GrdStud) THEN
               CALLPROC DisconnectEquipment(DroppedEquip = SelectEquip[i]);
            ENDIF;
            */
            
            /*
            **  Update Dead move count on top of card if needed.
            */
            RetCode = CALLPROC FMS_DeadMoveCount (
                       Card = C.Card);
            IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage = '',
                            TraceMessage =
                    'DropEquipment; ' +
                    'Unable to update dead move count on Card=' +
                    VARCHAR(C.Card) + '.' 
                    );
            ENDIF;
            CALLPROC DDB_COMMIT;
            /* 
            ** if equipment has an outstanding phase check, drop the phase check
            */
            j = 1;
            WHILE j <= OtherFeeders.LastRow() DO
               CALLPROC TransferPhaseCheckEquipment(
                              Equip = SelectEquip[i].Equip,
                              EquipName = SelectEquip[i].EquipName,
                              OldFeeder = OtherFeeders[j].Object,
                              OldFeederName = OtherFeeders[j].Name,  
                              NewFeeder = 0,
                              NewFeederName = '');
               j = j + 1;
            ENDWHILE;
            /*            
            **   Log the dropping of equipment 
            */ 
            CALLPROC SOA_LogIns
                       (Card = C.Card, 
                        Job  = NULL,
                        UserName = UserName,
                        Time = DATE('now'),       
                        Item = 'Dropped Equip', 
                        Old  = SelectEquip[i].PrintID + '  ' +
                               SelectEquip[i].EquipClassName + '  ' +
                               SelectEquip[i].EquipName,
                        New  = 'To Division ' + :EquipDiv.DivisionName ); 
            CALLPROC DDB_COMMIT;
            /*
            ** Log audit trail
            */
            RetCode = CALLPROC FMS_AuditTrailIns (
                     Entity = 'UDB_Object',
                     Handle = SelectEquip[i].Equip,
                     LogTime = DATE('NOW'),
                     Operator = DOp.Object,
                     Item = 'Drop Equipment',
                     Old = SelectEquip[i].PrintID + '  ' +
                           SelectEquip[i].EquipClassName + '  ' +
                           SelectEquip[i].EquipName,
                     New = 'To Division ' + :EquipDiv.DivisionName );
            CALLPROC DDB_COMMIT;

            /* 
            **   Remove equipment statuses from ObjectStatus table: except for ground
            */ 
            status = CALLPROC FMS_ObjEquipDel 
                                 ( Object = SelectEquip[i].Equip, 
                                   Ground = Status$Ground 
                                 ); 

            IF (status <> 0) THEN 
               CALLPROC DDB_ROLLBACK; 
               MESSAGE 'Unable to remove equipment statuses'; 
               RESUME; 
            ENDIF; 
            CALLPROC DDB_COMMIT;
            /* 
            **   Update jobs on all cards that have this piece of equipment: 
            */ 
            TempCardList.Clear();
            status = CALLPROC UpdateAllCardEquip (
                                Equip = SelectEquip[i].Equip,
                                ImpactedCards = ByRef(TempCardList)); 
            IF (status = PU_CANCEL) THEN 
               CALLPROC DDB_ROLLBACK; 
               RESUME; 
            ENDIF; 

            /* manage impacted card list */
            IF TempCardList.LastRow() >= 1 THEN
               j= 1;
               WHILE j <= TempCardList.LastRow() DO
                  k = 1;
                  WHILE k <= ImpactedCardList.LastRow() DO
                    IF TempCardList[j].Value = ImpactedCardList[k].Value THEN
                        ENDLOOP;   
                    ENDIF;                       
                    k = k + 1;
                  ENDWHILE;
                  /*
                  ** Add Card if not already in the list.
                  */
                  IF k = (ImpactedCardList.LastRow() + 1) THEN
                   ImpactedCardList.InsertRow (rownumber = k);
                   ImpactedCardList[k].Value = TempCardList[j].Value;
                  ENDIF;        
                  j = j + 1;
               ENDWHILE;
            ENDIF;

            /*
            **   Check if equipment is attached to a macro equipment.  If it is, the
            **   macro equip was dropped, now we have to deal with any moves for the
            **   macro equip.  Can use DropSingleEquip procedure if moves exist.
            */
            MacroEquip = 0;
            REPEATED 
            SELECT :MacroEquip = G.Grouping,
                   :MacroEquipClass = G.GroupingType,
                   :MacroEquipName = O.Name
            FROM   Udb_Grouping G,
                   Udb_ExtendedType ET, 
                   Udb_Object O
            WHERE  G.GroupingType  = ET.Type AND
                   ET.SuperType    = :Type$Switch AND
                   G.Relationship  = :Interaction$MemberOf AND
                   G.Member        = :SelectEquip[i].Equip AND
                   G.Grouping      = O.Object;

            IF MacroEquip > 0 THEN 
               status = CALLPROC FMS_DropSingleEquip (                              
                            Feeder = SelectEquip[i].Feeder, 
                            Equip  = MacroEquip, 
                            CurrentTime = DATE('now'), 
                            InteractionSourcePos = Interaction$SourcePosition,
                            InteractionMemberOf  = Interaction$MemberOf,
                            StatusGround = Status$Ground,
                            StatusFeederGround = Status$FeederGround,
                            StatusStationGround = Status$StationGround,
                            ActiveCard = Card$Active,  
                            EquipClass = MacroEquipClass);

               IF status < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to drop moves related to macro ' +
                         'equipment, if any, due to an error.  Macro Equipment ' +
                         'has been dropped, moves have not.';
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF;

               /* Manipulate moves on current card. */
               j = 1; 
               WHILE j <= Jobs.LastRow()  DO 
                  IF  Jobs[j].Equip = MacroEquip AND 
                      Jobs[j].Status = '' THEN

                     IF ((Jobs[j].TOIssued IS NULL) OR   
                       (Jobs[j].TOComplete IS NULL) OR   
                       (Jobs[j].RSIssued   IS NULL) OR   
                       (Jobs[j].RSComplete IS NULL)   ) THEN  
                        /* Blank out any NULL times: */
                        IF (Jobs[j].TOIssued IS NULL) THEN 
                           Jobs[j].ToIssued = ' '; 
                        ENDIF; 
                        IF (Jobs[j].TOComplete IS NULL) THEN 
                           Jobs[j].TOComplete = ' '; 
                        ENDIF; 
                        IF (Jobs[j].RSIssued IS NULL) THEN 
                           Jobs[j].RSIssued = ' '; 
                        ENDIF; 
                        IF (Jobs[j].RSComplete IS NULL) THEN  
                           Jobs[j].RSComplete = ' '; 
                        ENDIF; 

                        Jobs[j].Response = 'Equipment Dropped'; 
                        Jobs[j].Status = Job$Xfer; 
                        IF Jobs[j].Grounds = 0 THEN
                           Jobs[j].Grounds = NULL;
                        ENDIF;
                        Jobs[j].GroundOn = NULL;
                        Jobs[j].MoveFGColor = CC_BLACK;
                        /* Update the job on current card into the db: */ 
                        status = CALLPROC SOA_UpdateJob 
                                           ( Job        = Jobs[j].Job, 
                                             Response   = Jobs[j].Response, 
                                             Status     = Jobs[j].Status, 
                                             TOIssued   = Jobs[j].TOIssued, 
                                             TOComplete = Jobs[j].TOComplete, 
                                             TOOperator = Jobs[j].TOOperator,
                                             RSIssued   = Jobs[j].RSIssued, 
                                             RSComplete = Jobs[j].RSComplete,
                                             RSOperator = Jobs[j].RSOperator,
                                             Grounds    = Jobs[j].Grounds,
                                             GroundOn   = Jobs[j].GroundOn,
                                             MoveFGColor= Jobs[j].MoveFGColor 
                                          ); 
                        IF (status <> 0) THEN 
                            CALLPROC DDB_ROLLBACK;
                            Message 'Unable to update current card to reflect ' +
                                    'moves related to dropped equipment.';            
                            ENDLOOP;
                        ENDIF;
                        CALLPROC DDB_COMMIT;
                     ENDIF; 
                  ENDIF; 
                  j = j + 1; 
               ENDWHILE; 
            ENDIF;  // IF MacroEquip > 0                                     
         ENDIF; /* DropFromAll= TRUE */
         /*
         **  Drop SD Link if necessary.
         */
         CALLPROC SD_Drop (SE = SelectEquip[i].Duplicate());

      ENDIF; /* (FIELD(SelectEquip[i].Description).IsReverse = TRUE) */ 

      i = i + 1; 
   ENDWHILE; 
   CALLPROC MarkDiagramInvalid (Feeder = FeederObj);

#  include NotifyImpactedCards
   RETURN PU_OK; 
END; 

/* 
**  Handle a Cancel click:  
*/ 
ON UserEvent 'ContinueCancel_Btn' = 
BEGIN 
    IF (entrymade = 1) THEN 
      IF (CurFrame.ConfirmPopup(messagetext= 
          'Drop Equipment cancelled?') = PU_OK ) THEN 
        RETURN PU_CANCEL; 
      ENDIF; 
    ELSE 
      RETURN PU_CANCEL;
    ENDIF; 
END;

/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE AddToImpactedFeeders(
   Feeder = INTEGER NOT NULL;
   Name = VARCHAR(40) NOT NULL WITH DEFAULT;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = 1;
   WHILE i <= ImpactedFeeders.LastRow() DO
      IF Feeder = ImpactedFeeders[i].Object THEN
         ENDLOOP;
       ELSE
         i = i + 1;
       ENDIF;
   ENDWHILE;

   IF i > ImpactedFeeders.LastRow() THEN
      ImpactedFeeders[i].Object = Feeder;
      ImpactedFeeders[i].Name = Name;
   ENDIF;
END;

PROCEDURE DisconnectEquipment(
   DroppedEquip = FMS_Equip
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;		
   j = INTEGER NOT NULL WITH DEFAULT;			
   k = INTEGER NOT NULL WITH DEFAULT;	

   Connect1List = ARRAY OF CONNECTCLASS;
   Connect2List = ARRAY OF CONNECTCLASS;
   DropControl = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/*
**   See if equipment is set up in connectivity and delete
*/
   Connect1List.Clear();
   Connect2List.Clear();
   j = 0;
   REPEATED
   SELECT :j = OID
   FROM   DSO_Connection
   WHERE  FromObj = :DroppedEquip.Equip OR
          ToObj = :DroppedEquip.Equip
   BEGIN
      status = CALLPROC DSO_ConnectionDel (OID = j);
      IF status < 0 Then
         CALLPROC DDB_ROLLBACK;
         message 'Unable to remove equipment: ' +  DroppedEquip.EquipClassName +
             ' ' + DroppedEquip.EquipName + ' from connectivity.  ' +
             'Please try again.';
         RETURN PU_CANCEL;
      ENDIF;
   END;
   CALLPROC DDB_COMMIT;
   
/* OLD LOGIC
   Equipment is connected in connectivity  *
   k = 1;
   REPEATED
   SELECT :Connect1List[k].Object   = O.Object,
         :Connect1List[k].Name     = O.Name,
         :Connect1List[k].TypeName = O.TypeName,
         :Connect1List[k].Terminal = T1.Terminal,
         :Connect1List[k].NextTerminal = T2.Terminal,
         :Connect1List[k].Node     = T1.Node 
   FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O
   WHERE  T1.Object = :DroppedEquip.Equip AND
         T1.Node > 20000 AND
         T1.Terminal = :Terminal$One AND
         T1.Node =  T2.Node  AND
         T2.Node > 20000 AND
         T2.Object <> T1.Object AND
         T2.Object = O.Object
   BEGIN
      k = k + 1;
   END;

   k = 1;
   REPEATED
   SELECT :Connect2List[k].Object   = O.Object,
         :Connect2List[k].Name     = O.Name,
         :Connect2List[k].TypeName = O.TypeName,
         :Connect2List[k].Terminal = T1.Terminal,
         :Connect2List[k].NextTerminal = T2.Terminal,
         :Connect2List[k].Node     = T1.Node 
   FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O
   WHERE  T1.Object = :DroppedEquip.Equip AND
         T1.Node > 20000 AND
         T1.Terminal = :Terminal$Two AND
         T1.Node =  T2.Node  AND
         T2.Node > 20000 AND
         T2.Object <> T1.Object AND
         T2.Object = O.Object
   BEGIN
      k = k + 1;
   END;
  
   IF Connect1List.LastRow() = 0 AND Connect2List.LastRow() = 0 THEN   
      /*  Not in Connectivity, no need to do anything *
      RETURN PU_CANCEL;
   ENDIF;

   DropControl = CALLFRAME DropConnectivity(
                             Feeder = DroppedEquip.Feeder,
                             DroppedEquip = DroppedEquip,
                             EquipList1 = Connect1List.Duplicate(),
                             EquipList2 = Connect2List.Duplicate());
   IF DropControl = PU_CANCEL THEN
      RETURN PU_CANCEL;
   ENDIF;
   
   /*  Remove both terminal connections to nodes  *
   status = CALLPROC Udb_TerminalUpd(Node = Node$Floating,
                                    Object = DroppedEquip.Equip,
                                    Terminal = Terminal$One); 
   IF status < 0 Then
      CALLPROC DDB_ROLLBACK;
      message 'Unable to remove equipment: ' +  DroppedEquip.EquipClassName +
             ' ' + DroppedEquip.EquipName + ' from connectivity.  ' +
             'Please try again.';
      RETURN PU_CANCEL;
   ENDIF;

   status = CALLPROC Udb_TerminalUpd(Node = Node$Floating,
                                    Object = DroppedEquip.Equip,
                                    Terminal = Terminal$Two); 
   IF status < 0 Then
      CALLPROC DDB_ROLLBACK;
      message 'Unable to remove equipment: ' +  DroppedEquip.EquipClassName +
             ' ' + DroppedEquip.EquipName + ' from connectivity.  ' +
             'Please try again.';
      RETURN PU_CANCEL;
   ENDIF;

   IF DropControl = Terminal$ConnectAround THEN
      /* impossible to get to here. But keep the code here *
      j = 1;
      WHILE j <= Connect1List.LastRow() DO
         status = CALLPROC Udb_TerminalUpd(
                           Node = Connect2List[1].Node,
                           Object = Connect1List[j].Object,
                           Terminal = Connect1List[j].NextTerminal);
         IF status < 0 Then
            CALLPROC DDB_ROLLBACK;
            message 'Unable to remove equipment: ' +  DroppedEquip.EquipClassName +
                    ' ' + DroppedEquip.EquipName + ' from connectivity.  ' +
                    'Please try again.';
            RETURN PU_CANCEL;
         ENDIF;
         j = j + 1;
      ENDWHILE;
   ENDIF;
   CALLPROC DDB_COMMIT;
OLD LOGIC  */ 
/*
** disable the Source Connected value for the feeder to enforce validation and 
** confirmation of proper connectivity to the Source.
* 
** Causing whole host of problems
**  
   RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = DroppedEquip.Feeder);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = 'Error: DropEquipment; Failed to disable connected source flag for ' +  FeederName);
   ENDIF;
/*
** insert audit trail
* 
   RetCode = CALLPROC FMS_AuditTrailIns (
                Entity = 'Connected Source'
               ,Handle = DroppedEquip.Feeder                               
               ,HandleName = DroppedEquip.FeederName                                
               ,LogTime = DATE('Now')
               ,Operator = DOp.Object
               ,OperatorName = DOp.Description
               ,Item = 'Update Flag'
               ,Old = 'FROM CAC:DropEquipment '
               ,New = 'Feeder marked Invalid by System ' + 
                      'because equip ' + DroppedEquip.EquipClassName + ' ' + DroppedEquip.EquipName + ' is dropped from feeder');     
   CALLPROC DDB_COMMIT;
*/
   RetCode = CALLPROC UDB_ObjectValidationUpd(
                          Object = DroppedEquip.Feeder,
                          Validated = NULL,
                          ValidatedBy = '');
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = 'Error: DropEquipment; Failed to mark feeder ' +  FeederName + ' invalid');
   ENDIF;

   RETURN TRUE;
END;

PROCEDURE SD_Link (
   Object    = INTEGER NOT NULL WITH DEFAULT;
   IsReverse = INTEGER NOT NULL WITH DEFAULT;
   Type      = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   SDObject  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   /*
   **  Check to see if this is a type we are interested in.
   */
   SDObject = 0;
   IF Type = Type$StepDown THEN  /* SD-TRANSF */
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Member
      FROM    Udb_Grouping G
      WHERE   G.Grouping = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.MemberType = :Type$SDVIS;
   ELSEIF Type = Type$SDVIS THEN
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Grouping
      FROM    Udb_Grouping G
      WHERE   G.Member = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.GroupingType = :Type$StepDown;
   ENDIF;
   
   IF SDObject <> 0 THEN 
      FOR i = 1 TO SelectEquip.LastRow DO
         IF SelectEquip[i].Equip = SDObject THEN
            FIELD(SelectEquip[i].Origin).IsReverse = IsReverse;
            FIELD(SelectEquip[i].Description).IsReverse = IsReverse;
            FIELD(SelectEquip[i].PrintID).IsReverse = IsReverse;
            FIELD(SelectEquip[i].EquipName).IsReverse = IsReverse;
            FIELD(SelectEquip[i].EquipClassName).IsReverse = IsReverse;
 
            RETURN;
         ENDIF;
      ENDFOR;
   ENDIF;
          
   RETURN;
END;

PROCEDURE SD_Drop (
   SE = FMS_Equip;
) =
DECLARE
   SDCard  = INTEGER NOT NULL WITH DEFAULT;
   Card    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   /*
   **  Only check when SDVIS device is being transferred.
   */
   IF SE.EquipClass <> Type$SDVIS THEN
      RETURN;
   ENDIF;
   /*
   **  Only transfer links for 27kV cards.
   */
   IF C.TypeOfCard = TypeOfCard$4KV THEN
      RETURN;
   ENDIF;
   /*
   **  Find the StepDown card that this equipment is on.
   */
   Card = 0;
   SELECT :SDCard = L.StepDownCard,
          :Card = L.Card
   FROM    Udb_Grouping G,
           SOA_ActiveObject AO,
           FMS_StepDownLink L
   WHERE   G.Member = :SE.Equip AND
           G.Relationship = :Interaction$SourceBreaker AND
           G.Grouping = AO.Object AND
           AO.Card = L.StepDownCard;

   IF Card <> 0 THEN
      /*
      **  Remove link from Step Down link table. 
      */
      CALLPROC FMS_StepDownLinkDel
           (Card = Card,
            StepDownCard = SDCard);
      CALLPROC DDB_COMMIT;
      FCFrame.SendUserEvent (EventName = 'RefreshCardLinks');
   ENDIF;         
          
   RETURN;
END;
