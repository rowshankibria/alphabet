**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptSetABMode
**
**  Modifications:
**  06/24/14   em  Created
**  07/30/14   em  Modified to set status directly.
*/
INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
) =
BEGIN
  
      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'xoabmode',
                FieldValue = 2
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Valve XOAB Mode.',
                           TraceMessage =
               'PromptSetACFeedRemoved: Unable to set XOAB mode ' +
               'for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;

END;
