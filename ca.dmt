PROCEDURE Validate_BusSectionRelays(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ContinueCheck = INTEGER NOT NULL WITH DEFAULT;
   FCRPermit = INTEGER NOT NULL WITH DEFAULT;
   p = INTEGER NOT NULL WITH DEFAULT;
   WG = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF bs.BDHasDataChanged = TRUE THEN
      IF bs.BDRelayName <> '' AND
        (bs.BDPhaseA = 0 AND
         bs.BDPhaseB = 0 AND
         bs.BDPhaseC = 0) THEN
         MESSAGE 'Bus Differential Relay Name ''' + bs.BDRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.BOCHasDataChanged = TRUE THEN
      IF bs.BOCRelayName <> '' AND
        (bs.BOCPhaseA = 0 AND
         bs.BOCPhaseB = 0 AND
         bs.BOCPhaseC = 0 AND
         bs.BOCPhaseN = 0) THEN
         MESSAGE 'Bus Over Current Relay Name ''' + bs.BOCRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FBMPRHasDataChanged = TRUE THEN
      /*
      IF bs.BUTRelayName <> '' AND
         bs.BUTOperated = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.BUTRelayName + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
      */
      IF bs.FBMPRValue <> '' AND
         bs.FBMPR = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.FBMPRValue + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FTHasDataChanged = TRUE THEN
      IF bs.FTRelayName <> '' AND
        (bs.FTPhaseA = 0 AND
         bs.FTPhaseB = 0 AND
         bs.FTPhaseC = 0 AND
         bs.FTPhaseN = 0 AND
         bs.FTFeeder = 0) THEN
         MESSAGE 'Feeder Target Relay Name ''' + bs.FTRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
       
      IF (bs.FTPhaseA = 0 AND
          bs.FTPhaseB = 0 AND
          bs.FTPhaseC = 0 AND
          bs.FTPhaseN = 0) AND
          bs.FTFeeder <> 0 THEN

         MESSAGE 'A Feeder was chosen but no Feeder Relay Targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

      IF (bs.FTPhaseA <> 0 OR
          bs.FTPhaseB <> 0 OR
          bs.FTPhaseC <> 0 OR
          bs.FTPhaseN <> 0) AND
          bs.FTFeeder = 0 THEN

         MESSAGE 'Feeder Relay Targets were selected but no Feeder was chosen.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

   ENDIF;
   RETURN(0);
END;
