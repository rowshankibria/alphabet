**  02/22/19        pkw      Remove openauto move on stepdown 4kv if ooe1,auto or cioa xfer card.
**  06/04/19        pkw      Remove code related to rapidrestore flag.
**  07/22/19        pkw      Make sure to track CERC days on Friday from 3pm to 6pm.
**  08/08/19        pkw      Handle TV bogey on transfer
*/
INITIALIZE
(
    OldCardID = INTEGER NOT NULL;    /* parameter - old card Id to xfer */ 
    XferCardKey = INTEGER NOT NULL;  /* the new card key, output parameter */ 
    XferCardClass = INTEGER NOT NULL;  /* P: the new card class */ 
    TestType = CHAR(1) NOT NULL WITH DEFAULT;   /*Parm from CreateFOT */
    TestDate = DATE NOT NULL WITH DEFAULT;      /*Parm from CreateFOT */
    XferOpenCard = INTEGER NOT NULL WITH DEFAULT;   /*Optional: passed in open card id */
    XferCutout = DATE;   /* optional: value is Not NULL when creating SX Transfer */                          
)=
DECLARE
    i = INTEGER NOT NULL;   /*Counter*/
    j = INTEGER NOT NULL;   /*Counter*/
    k = INTEGER NOT NULL;   /*Counter*/
    m = INTEGER NOT NULL;   /*Counter*/
    n = INTEGER NOT NULL;   /*Counter*/
    x = INTEGER NOT NULL;   /*Counter*/

    AmmClearObj = INTEGER NOT NULL WITH DEFAULT;
    CautionCount = INTEGER NOT NULL WITH DEFAULT;  
    CommonEquip          = ARRAY OF INTEGEROBJECT;
    ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
    DBEventText = VARCHAR(256) NOT NULL WITH DEFAULT;
    DeadMovesCount = INTEGER NOT NULL WITH DEFAULT;  
    EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
    FOTCount = INTEGER NOT NULL WITH DEFAULT;   /*Select previous FOT Count*/
    HasSTEquip = INTEGER NOT NULL WITH DEFAULT;
    Idx = ARRAY of IntegerObject;   
    ImpactedCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
    JobControlList       = ARRAY OF NewMoveCard;
    KeepRAPStats   = INTEGER NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL;   /*Counter*/
    LogEntries = INTEGER NOT NULL;  /* Log entries for old card */
    NewJobsRow = INTEGER;   /*Nullable return code*/
    NetworkProtectorJob = INTEGER NOT NULL;
    NewXferCard = FMS_Card;   /* the new Xfer card */ 
    NotShadow = INTEGER NOT NULL;  /* Set to FALSE when new card is CutOut */
    OldCard = FMS_Card DEFAULT NULL;       /* Old Card data */ 
    OutstandingMoves     = ARRAY OF Job;
    PreloadedMoves 	 = ARRAY OF Job;
    ProcessCount = INTEGER NOT NULL;
    ProcessWindow = FrameExec;            
    RRIssues = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
    ShadowCard = INTEGER NOT NULL WITH DEFAULT;  
    ShadowItem = INTEGER NOT NULL WITH DEFAULT;  
    SimpleJob = Job DEFAULT NULL;        /*Enables use of class methods*/
    status = INTEGER NOT NULL;   /*return code*/
    SOACard = CardSOA;           /* Used to insert into SOA */
    OrderList = ARRAY OF INTEGEROBJECT;
    IsAuto       = INTEGER NOT NULL;
    TV_BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
    TV_FaultCheck   = INTEGER NOT NULL WITH DEFAULT;
    TV_Bogey        = INTEGER NOT NULL WITH DEFAULT;
    TV_Threshold    = FLOAT   NOT NULL WITH DEFAULT;
    TV_ForeCast     = FLOAT   NOT NULL WITH DEFAULT;
    SaveFeeder   = INTEGER NOT NULL WITH DEFAULT;   /*3G Implementation*/
    WarningTxt = VARCHAR(256) NOT NULL WITH DEFAULT;
    SimpleStep = OperatingStep_ASE DEFAULT NULL;
    LinkedCard = ARRAY OF INTEGEROBJECT;
    StepDownOAJob = Job;
    IsStepDown  = INTEGER NOT NULL WITH DEFAULT;  
    July4Start      = DATE NOT NULL WITH DEFAULT;
    July4End        = DATE NOT NULL WITH DEFAULT;
    IsCERC          = INTEGER NOT NULL WITH DEFAULT;
    Tot_Min         = INTEGER NOT NULL WITH DEFAULT;

/*
** local procedures
*/
    CheckActiveStepDown = PROCEDURE;
ENDDECLARE
BEGIN
    KeepRAPStats = FALSE;
    NotShadow = TRUE;
/*
**  Get Old Card Data
*/
    OldCard = NULL;
    OldCard = FMS_Card.Create();
    OldCard.Status = 0;
    SELECT :OldCard.Status = Status,
           :OldCard.Card = Card,
           :OldCard.Feeder = Feeder,
           :OldCard.FeederName = FeederName,
           :OldCard.CardClass = CardClass,
           :OldCard.CardClassName = CardClassName,
           :OldCard.CutIn = CutIn,
           :OldCard.CutOut = CutOut,
           :OldCard.Position = Position,
           :OldCard.SubstationName = SubstationName,
           :OldCard.TypeOfCard = TypeOfCard,
           :OldCard.StationGround = StationGround,
           :OldCard.GroundsOn = GroundsOn,
           :OldCard.DeadMovesTO = DeadMovesTO,
           :OldCard.NetworkFeeder = NetworkFeeder,
           :OldCard.Loop1 = Loop1,
           :OldCard.Loop2 = Loop2,
           :OldCard.Loop3 = Loop3,
           :OldCard.Loop4 = Loop4,
           :OldCard.Assoc = Assoc,
           :OldCard.Validated = Validated
    FROM   FMS_Card
    WHERE  Card = :OldCardID;

    i = 1;
    SELECT :OldCard.Object[i].Object = Object,
           :OldCard.Object[i].Name = Name,
           :OldCard.Object[i].Type = Type,
           :OldCard.Object[i].TypeName = ValidatedBy
    FROM   TFMS_CardToObject
    WHERE  Card = :OldCardId
    BEGIN
       i = i + 1;
    END;
/*
**  See if there are any Outstanding FOD orders on any jobs for this card.
**  If there is, we will update the card Id for each order so that when 
**  the moves are returned, the proper card will get called up.  Update 
**  will be done after new card is create.  We are getting the outstanding
**  order before the jobs are transferred to the new card.
*/
    i = 1;
    OrderList.Clear();
    REPEATED
    SELECT DISTINCT 
            :OrderList[i].Value = OJ.OrderNumber
    FROM     IR_FODOrderJobs OJ,
             IR_FODOrder O,
             SOA_Job J
    WHERE    O.Card = :OldCard.Card AND
             O.OrderNumber = OJ.OrderNumber AND
             OJ.JobStatus < :Order$Closed AND
             OJ.Job = J.Job AND 
            (J.TOComplete IS NULL OR
             J.RSComplete IS NULL) AND
             J.Status = '' AND
             J.MoveCategory = :MoveCategory$Normal
    BEGIN
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
/*
**  For ISO card, create another ISO card if requested type is FOT 
*/  
    IF OldCard.CardClass = Type$ISO AND XferCardClass = Type$FOT THEN
        XferCardClass = Type$ISO;
    ENDIF; 
/*
**  Old Card Active Sanity Check
*/
    IF OldCard.Status < Card$Active OR OldCard.Status >= Card$Closed THEN
       CALLPROC TraceError (UserMessage =
              'ERROR: Transfer cannot be completed because old card is no ' +
              'longer active.  Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Xfer failed because old card is no longer ' +
              'active.  See Card:' + VARCHAR(OldCard.Card)
                             );
       RETURN(PU_CANCEL);
    ENDIF;
/*
**  Commits performed constantly during transfer to reduce transaction
**  size and release locks.
*/
/*
** Check if there are any Rapid Restore issues before we allow a FOT card to
** be generated.
** Review RFPS calls Request for Permit
*/
    status = CALLFRAME ReviewRFPs (Card = OldCard, XferOrClose = 'XFER');

    IF status = PU_CANCEL THEN
       RETURN(PU_CANCEL);
    ENDIF;
/*
**  Open process window indicator.  Since there is no while loop for this
**  procedure,  we will hardcode the max steps to 9.  If this procedure in the
**  future gets more steps this number will have to get increased and the frame
**  updated where the extra procedure is called.
*/
    ProcessCount = 1;
    ProcessWindow = OPENFRAME ProcessIndicator 
                                 (ParentFrame = CurFrame,
                                  Pct_Title = 'Create Transfer Card',
                                  MaxValue = 10);
    CurFrame.WaitFor (EventName = 'Received');
/*
**  Hide card behind unknown status so end-user has no access to
**  it during transfer.
*/
    status = CALLPROC FMS_CardStatusUpd (NewStatus = 99, 
                                Card = OldCard.Card);
    IF (status < 0) THEN 
        CALLPROC DDB_ROLLBACK;
        CALLPROC TraceError (UserMessage =
              'ERROR: Transfer cannot be completed because old card cannot ' +
              'be marked for transfer.  Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Xfer failed because old card cannot be ' +
              'marked for transfer.  See Card:' + VARCHAR(OldCard.Card)
                             );
        RETURN(PU_CANCEL);
    ENDIF;
    CALLPROC DDB_COMMIT;
/* 
**  Get key for new transfer card
*/
    IF XferOpenCard = 0 THEN
       XferCardKey = CALLPROC Udb_NextKey(KeyName = 'Card');
       IF (XferCardKey < 0) THEN
           CALLPROC DDB_ROLLBACK;
           CALLPROC TraceError (UserMessage =
                 'ERROR: Transfer cannot be completed because new card key ' +
                 'could not be generated.  Have tech support review trace log',
                              TraceMessage = 
                 'CreateXferCard: Xfer failed because new card key ' +
                 'could not be generated.' 
                                );
           CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                         Card = OldCard.Card);
           CALLPROC DDB_COMMIT;
           RETURN(PU_CANCEL);
       ENDIF;
       CALLPROC DDB_COMMIT;

       /* 
       **  Copy old card userclass to new card userclass 
       */ 
       NewXferCard = OldCard.Duplicate(); 
       
       /* 
       **  Modify the new card to be an ':XferCardClass' card 
       */ 
       NewXferCard.Card = XferCardKey;    /* Set new card's key */ 
       NewXferCard.CardClass = XferCardClass;
       NewXferCard.Status = 0;            /* Hide new card in 'Ready' bin */
       
       /*
       **  Get cardclass name from type table.
       */        
       REPEATED                                 
       SELECT  :NewXferCard.CardClassName = Name
       FROM    Udb_Type
       WHERE   Type = :XferCardClass;
    ELSE
       /* use the existing open card to transfer moves 
       */
       XferCardKey = XferOpenCard;

       NewXferCard = NULL;
       NewXferCard = FMS_Card.Create();

       SELECT :NewXferCard.Status = Status,
              :NewXferCard.Card = Card,
              :NewXferCard.Feeder = Feeder,
              :NewXferCard.FeederName = FeederName,
              :NewXferCard.CardClass = CardClass,
              :NewXferCard.CardClassName = CardClassName,
              :NewXferCard.CutIn = CutIn,
              :NewXferCard.Position = Position,
              :NewXferCard.SubstationName = SubstationName,
              :NewXferCard.TypeOfCard = TypeOfCard,
              :NewXferCard.StationGround = StationGround,
              :NewXferCard.GroundsOn = GroundsOn,
              :NewXferCard.DeadMovesTO = DeadMovesTO,
              :NewXferCard.NetworkFeeder = NetworkFeeder,
              :NewXferCard.Loop1 = Loop1,
              :NewXferCard.Loop2 = Loop2,
              :NewXferCard.Loop3 = Loop3,
              :NewXferCard.Loop4 = Loop4,
              :NewXferCard.Assoc = Assoc,
              :NewXferCard.Validated = Validated
       FROM   FMS_Card
       WHERE  Card = :XferOpenCard;       
    ENDIF;
/*
**  Adjust CutOut/CutIn as appropriate per card type
*/
    IF NewXferCard.CardClass = Type$FOT THEN
        NewXferCard.CutOut = 'now';  
        NewXferCard.CutIn = NULL;  
        NotShadow = FALSE;
    ELSEIF OldCard.CardClass = Type$RAP AND OldCard.CutOut IS NOT NULL AND
             OldCard.CutIn IS NULL THEN
        NewXferCard.CutOut = OldCard.CutOut;  
        NewXferCard.CutIn = NULL;  
        KeepRAPStats = TRUE;
        NotShadow = FALSE;
    ELSE
        NewXferCard.CutIn = NULL;  
        NewXferCard.CutOut = NULL;  
    ENDIF;

    IF NewXferCard.CardClass = Type$FOT OR KeepRAPStats = TRUE THEN
/*
**  Get feeder status of old card; FOT cards have HV removed
**  but have not had 'C' userclass updated.
*/ 
        REPEATED 
        SELECT   :NewXferCard.FeederStatus = FeederStatus,
                 :NewXferCard.FeederStatusName = FeederStatusName
        FROM     FMS_Card
        WHERE    Card = :OldCard.Card;                         
        CALLPROC DDB_ROLLBACK;
    ELSE
/*
** Set Appropriate New card feeder status.
*/ 
        IF NewXferCard.CardClassName = 'OOE1' THEN

            NewXferCard.FeederStatus = Status$ISM;
            NewXferCard.FeederStatusName = 'ISM';        
        ELSE

            NewXferCard.FeederStatus = Status$DL;
            NewXferCard.FeederStatusName = 'DL';        
        ENDIF;
    ENDIF;
/* 
** If we are going to transfer to a new card, 
** insert the new Xfer card into the database 
*/    
    IF XferOpenCard = 0 THEN  
       /*
       **  Update process window
       */    
       ProcessCount = ProcessCount + 1;
       ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);
       CurFrame.WaitFor (EventName = 'Received');

       NewXferCard.Opened = 'now';  
       status = CALLPROC FMS_InsCard 
                 (Card = NewXferCard.Card, 
                  SubstationName = NewXferCard.SubstationName, 
                  TypeOfCard = NewXferCard.TypeOfCard,
                  Feeder = NewXferCard.Feeder, 
                  FeederName = NewXferCard.FeederName, 
                  FeederStatus = NewXferCard.FeederStatus, 
                  FeederStatusName = NewXferCard.FeederStatusName, 
                  Status = NewXferCard.Status, 
                  CardClass = NewXferCard.CardClass, 
                  CardClassName = NewXferCard.CardClassName, 
                  Position = NewXferCard.Position, 
                  StationGround = NewXferCard.StationGround, 
                  GroundsOn = NewXferCard.GroundsOn, 
                  DeadMoves = 0,
                   /* let deadmove count be set via dead move insertion rules*/ 
                  DeadMovesTO = NewXferCard.DeadMovesTO, 
                  NetworkFeeder = NewXferCard.NetworkFeeder,
                  Loop1 = NewXferCard.Loop1, 
                  Loop2 = NewXferCard.Loop2, 
                  Loop3 = NewXferCard.Loop3, 
                  Loop4 = NewXferCard.Loop4, 
                  Assoc = NewXferCard.Assoc, 
                  Relays = '', 
                  Notifications = '', 
                  Validated = NewXferCard.Validated, 
                  Opened = NewXferCard.Opened, 
                  Closed = NULL, 
                  CutOut = NewXferCard.CutOut, 
                  CutIn = NewXferCard.CutIn
                 ); 
        IF (status < 0) THEN 
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because new card ' +
                  'creation failed.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because new card could not be created.');

            CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                        Card = OldCard.Card);
            CALLPROC DDB_COMMIT;
            RETURN(PU_CANCEL);
        ENDIF;

        /*
        ** Since we used a custom insert to create the new transfer card instead of the 
        ** InsertCard method, we have to have this extra step to insert the SOA card.
        */
        SOACard.Card = NewXferCard.Card;
        SOACard.Application = Application$FMS;
        SOACard.CardClass = NewXferCard.CardClass;
        SOACard.Opened = NewXferCard.Opened;
        SOACard.Status = NewXferCard.Status;
        SOACard.TypeOfCard = NewXferCard.TypeOfCard;
        SOACard.Validated = NewXferCard.Validated;

        SOACard.InsertCard();

        IF SOACard.Card = 0 THEN
           CALLPROC DDB_ROLLBACK;
           CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because new card ' +
                  'could not be created.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because SOA_Card insertion ' +
                  'did not work.  Card to be purged:' + VARCHAR(NewXferCard.Card)
                                 );

           CALLPROC FMS_CardStatusUpd (NewStatus = Card$Purge,
                                          Card = NewXferCard.Card);
           CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                          Card = OldCard.Card);
           CALLPROC DDB_COMMIT;
           RETURN(PU_CANCEL);
        ENDIF;
/*
** Insert feeders into card to object table
*/
        FOR i = 1 TO OldCard.Object.LastRow() DO

           status = CALLPROC TFMS_InsertCardToObject(
                         CardKey = NewXferCard.Card
                        ,CardObject = OldCard.Object[i].Object
                        ,CardObjectName = OldCard.Object[i].Name
                        ,ENDEEN = 0
                        ,ObjectType = OldCard.Object[i].Type
                        ,Status = 1
                        ,ValidatedBy = OldCard.Object[i].TypeName
                        ,Seq = 0);

           IF status < 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because feeder ' +
                  'transfer failed.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because TFMS_CardToObject insertion ' +
                  'did not work.  Card to be purged:' + VARCHAR(NewXferCard.Card)
                                );

              CALLPROC FMS_CardStatusUpd (NewStatus = Card$Purge,
                                          Card = NewXferCard.Card);
              CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                          Card = OldCard.Card);
              CALLPROC DDB_COMMIT;
              RETURN(PU_CANCEL);
           ENDIF;
  
        ENDFOR;
        CALLPROC DDB_COMMIT;
        /*
        **  Update process window
        */    
        ProcessCount = ProcessCount + 1;
        ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                     MessageInteger = ProcessCount);

        CurFrame.WaitFor (EventName = 'Received');
        /*
        **  PreLoad the card with normal preloaded moves for new cardclass.
        */
/*
** Look at new preload parms
*/
        Status = CALLFRAME PreloadMoves (
                        Card = NewXferCard.Card, 
                        TypeofCard = NewXferCard.TypeofCard,        
                        Feeder = NewXferCard.Feeder,    
                        CardClass  = NewXferCard.CardClass);

        IF status = PU_CANCEL THEN 
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because job preload ' +
                  'failed on new card.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because Preload Moves ' +
                  'failed.  Card to be purged:' + VARCHAR(NewXferCard.Card)
                                 );
            CALLPROC FMS_CardStatusUpd (NewStatus = Card$Purge,
                                          Card = NewXferCard.Card);
            CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                          Card = OldCard.Card);
            CALLPROC DDB_COMMIT;
            RETURN(PU_CANCEL);
        ENDIF;
        CALLPROC DDB_COMMIT;
    ELSE  
       /* update status to the existing opened card */
       Status = CALLPROC FMS_CardCut(CutIn = NewXferCard.CutIn, 
		                     CutOut = NewXferCard.CutOut, 
		                     Card = NewXferCard.Card);
       IF Status < 0 THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because status updates to ' +
                  'the opened card failed.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because FMS_CardCut update ' +
                  'did not work.');
          CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                      Card = OldCard.Card);
          CALLPROC DDB_COMMIT;
          RETURN(PU_CANCEL);
       ENDIF;

       Status = CALLPROC FMS_CardFeederStatusUpd(NewStatus = NewXferCard.FeederStatus, 
		                     NewStatusName = NewXferCard.FeederStatusName, 
		                     Card = NewXferCard.Card);
       IF Status < 0 THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
                  'ERROR: Transfer cannot be completed because status updates to ' +
                  'the opened card failed.  Have tech support review trace log',
                               TraceMessage = 
                  'CreateXferCard: Xfer failed because FMS_CardFeederStatusUpd update ' +
                  'did not work.');
          CALLPROC FMS_CardStatusUpd (NewStatus = Card$Active,
                                      Card = OldCard.Card);
          CALLPROC DDB_COMMIT;
          RETURN(PU_CANCEL);
       ENDIF;
       CALLPROC DDB_COMMIT;
    ENDIF;
/*
**  Insert a log entry to prevent a pending delay from getting an incorrect 
**  starttime.  To fix problems created by ddb failover, we look at the 
**  toissued, rsissued, etc... to determine the last time a job was 
**  issued or completed. This log entry will resolve the problem due to  
**  creating a transfercard.
*/
/*
**  Log the transfer for the new card
*/
    CALLPROC SOA_LogIns (Card     = NewXferCard.Card,
                         Job      = NULL,
                         Time     = Date('now'),
                         UserName = UserName,
                         Item = 'Prevent Delay',
                         Old = '', 
                         New = varchar(date('now')));
    CALLPROC DDB_COMMIT;
/*
**  Get Preloaded moves so that duplicates can be deleted when outstanding moves
**  are inserted.
*/
    i = 1;
    PreloadedMoves.Clear();
    REPEATED
    SELECT :PreloadedMoves[i].Job = J.Job,
           :PreloadedMoves[i].Equip = J.Equip,
           :PreloadedMoves[i].Substation = J.Substation,
           :PreloadedMoves[i].EquipClass = J.EquipClass,
           :PreloadedMoves[i].JobClass = J.JobClass,
           :PreloadedMoves[i].StepPair = JC.StepPair
    FROM   SOA_JobControl JC,
           SOA_Job J
    WHERE  JC.Card = :NewXferCard.Card AND
           JC.Job = J.Job AND
           J.MoveCategory = :MoveCategory$Normal
    BEGIN
       i = i + 1;
    END;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);

    CurFrame.WaitFor (EventName = 'Received');
/*
**  Get Outstanding Moves from old card, including work permits, excluding
**  the network protection check
*/
    i = 1;
    OutStandingMoves.Clear();
    JobControlList.Clear();
    REPEATED
    SELECT DISTINCT
           OutstandingMoves[i].Job = J.Job,
           OutstandingMoves[i].Equip = J.Equip,
           OutstandingMoves[i].JobClass = J.JobClass,
           OutstandingMoves[i].TOIssued = J.TOIssued,
           OutstandingMoves[i].RSIssued = J.RSIssued,
           OutstandingMoves[i].TOComplete = J.TOComplete,
           OutstandingMoves[i].RSComplete = J.RSComplete,
           OutstandingMoves[i].MoveCategory = J.MoveCategory,
           OutstandingMoves[i].Substation = J.Substation,  
           OutstandingMoves[i].ControlCard = J.ControlCard,  
           OutstandingMoves[i].ActivityIdentifier = J.ActivityIdentifier,  
           JobControlList[i].MoveEquipClass = JC.MoveEquipClass,
           JobControlList[i].StepHeading = JC.StepPair,
           JobControlList[i].StepLevel = 0,
           JobControlList[i].SwitchingItem = 0,
           JobControlList[i].PrintID = JC.PrintID
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :OldCard.Card AND
           JC.Job = J.Job AND
           J.Status <> 'Del' AND
/*           J.JobClass <> :Move$NetworkProtectionCheck AND  */
           J.MoveCategory IN (:MoveCategory$Normal, :MoveCategory$Fake)
   BEGIN
      JobControlList[i].Application = Application$FMS; 
      JobControlList[i].TypeOfCard = OldCard.TypeOfCard;
      JobControlList[i].Card = NewXferCard.Card;
/*
** Don't transfer unissued Deload Moves to Auto/OOE1 card.
** Confirm normal moves are outstanding.
*/
      IF (NewXferCard.CardClass = Type$OOE1 OR 
          NewXferCard.CardClass = Type$Auto) AND
          JobControlList[i].StepHeading = StepHeading$Deload AND
          OutstandingMoves[i].MoveCategory = MoveCategory$Normal AND       
          OutstandingMoves[i].TOIssued IS NULL THEN

         OutstandingMoves.RemoveRow(RowNumber = i);
         JobControlList.RemoveRow(RowNumber = i);
      ELSEIF OutstandingMoves[i].MoveCategory = MoveCategory$Normal AND       
          (OutstandingMoves[i].TOComplete IS NULL OR 
           OutstandingMoves[i].RSComplete IS NULL) THEN
         i = i + 1;
      ELSEIF OutstandingMoves[i].MoveCategory = MoveCategory$Fake THEN
         i = i + 1;
      ELSE
/*
** Normal move must not be outstanding, we don't want it.
*/
         OutstandingMoves.RemoveRow(RowNumber = i);
         JobControlList.RemoveRow(RowNumber = i);
      ENDIF;
   END;

   FOR i = 1 TO OutStandingMoves.LastRow() DO
      /*
      **  Remove preloaded jobs that are duplicated.
      */  
      LastRow = PreloadedMoves.LastRow();
      FOR k = LastRow DOWNTO 1 DO
         IF PreloadedMoves[k].JobClass = OutstandingMoves[i].JobClass AND
            PreloadedMoves[k].Equip = OutstandingMoves[i].Equip AND
            PreloadedMoves[k].StepPair = JobControlList[i].StepHeading THEN      

            status = CALLPROC SOA_JobDel (Job = PreloadedMoves[k].Job);
            IF status < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
              'WARNING: New card will have duplicate moves because duplicate ' +
              'preloads cannot be removed.  Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Duplicate preload moves on new card. ' +
              'Unable to remove Job:' + VARCHAR(PreloadedMoves[k].Job)
                          );
            ENDIF;

            PreloadedMoves.RemoveRow (RowNumber = k);
            ENDLOOP;
         ENDIF;
      ENDFOR;
      /*
      **  Insert Control entries on xfer card for outstanding 
      **  moves.
      */  
      status = OutstandingMoves[i].InsertControl (
                  ControlEntry = JobControlList[i],
                  InitiatingCard = NewXferCard.Card,
                  TransferFlag = TRUE,
                  SingleFeederOnly = TRUE);
      IF status = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage =
              'WARNING: Outstanding Moves could not be added to xfer card. ' +
              'Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Unable to insert Job Control entry for ' +
              'outstanding moves on Card:' + VARCHAR(NewXferCard.Card)
                             );
      ELSE
         IF OutstandingMoves[i].ActivityIdentifier <> 'S' AND
            OutstandingMoves[i].ActivityIdentifier <> 'N' THEN
            CALLPROC SOA_JobActivityIDUpd (
                         Job = OutstandingMoves[i].Job,
                         ActivityIdentifier = 'T');
         ENDIF;
/*
**  Update ControlCard if it points to the current card.
*/ 
         IF OutstandingMoves[i].ControlCard = OldCard.Card THEN

            status = CALLPROC SOA_JobControlCardUpd (
                                            Job = OutstandingMoves[i].Job,
                                            Card = NewXferCard.Card);
            IF status <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
              'WARNING: Unable to update control for certain moves on xfer ' +
              'card.  Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Unable to set ControlCard value for  ' +
              'xfer Job:' + VARCHAR(OutStandingMoves[i].Job)
                             );
            ENDIF;
         ENDIF;
      ENDIF;
      /*
      **  Update transferred moves on old card.
      */    
      IF ( (OutstandingMoves[i].TOIssued IS NULL) OR   
           (OutstandingMoves[i].TOComplete IS NULL) OR   
           (OutstandingMoves[i].RSIssued   IS NULL) OR   
           (OutstandingMoves[i].RSComplete IS NULL)) THEN

         /* Blank out any NULL times: */
         IF (OutstandingMoves[i].TOIssued IS NULL) THEN 
            OutstandingMoves[i].ToIssued = ' '; 
         ENDIF; 
         IF (OutstandingMoves[i].TOComplete IS NULL) THEN 
            OutstandingMoves[i].TOComplete = ' '; 
         ENDIF; 
         IF (OutstandingMoves[i].RSIssued IS NULL) THEN 
            OutstandingMoves[i].RSIssued = ' '; 
         ENDIF; 
         IF (OutstandingMoves[i].RSComplete IS NULL) THEN  
            OutstandingMoves[i].RSComplete = ' '; 
         ENDIF; 
        
         OutstandingMoves[i].Response = 'Xfer to ' +
                   NewXferCard.FeederName; 
         OutstandingMoves[i].Status = Job$Xfer; 
         OutstandingMoves[i].GroundOn = NULL;
         OutstandingMoves[i].MoveFGColor = CC_BLACK;
              
         /* Transfer the job from the old card  */ 
         
         status = CALLPROC SOA_TransferEquipJob 
            ( Card       = OldCard.Card,
              Job        = OutstandingMoves[i].Job, 
              Response   = OutstandingMoves[i].Response, 
              Status     = OutstandingMoves[i].Status, 
              TOIssued   = OutstandingMoves[i].TOIssued, 
              TOComplete = OutstandingMoves[i].TOComplete, 
              RSIssued   = OutstandingMoves[i].RSIssued, 
              RSComplete = OutstandingMoves[i].RSComplete,
              GroundOn   = OutstandingMoves[i].GroundOn,
              MoveFGColor= OutstandingMoves[i].MoveFGColor
            ); 
         
         IF (status <> 0) THEN 
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
            'WARNING: Marking old moves as transferred has failed. ' +
            'Have tech support review trace log',
                         TraceMessage = 
            'CreateXferCard: marking old moves as transferred has ' +
            'failed on Card:' + VARCHAR(OldCard.Card)
                     );
         ENDIF;    
       ENDIF;
    ENDFOR;
/*
**  Get Returned Complete Permits with Outstanding Phase Checks
*/
    i = 1;
    OutStandingMoves.Clear();
    JobControlList.Clear();
    REPEATED
    SELECT DISTINCT
           OutstandingMoves[i].Job = J.Job,
           OutstandingMoves[i].Equip = J.Equip,
           OutstandingMoves[i].JobClass = J.JobClass,
           OutstandingMoves[i].TOIssued = J.TOIssued,
           OutstandingMoves[i].RSIssued = J.RSIssued,
           OutstandingMoves[i].TOComplete = J.TOComplete,
           OutstandingMoves[i].RSComplete = J.RSComplete,
           OutstandingMoves[i].Substation = J.Substation,  
           OutstandingMoves[i].ActivityIdentifier = J.ActivityIdentifier,  
           JobControlList[i].MoveEquipClass = JC.MoveEquipClass,
           JobControlList[i].StepHeading = JC.StepPair,
           JobControlList[i].StepLevel = 0,
           JobControlList[i].SwitchingItem = 0,
           JobControlList[i].PrintID = JC.PrintID 
   FROM    SOA_Job J,
           SOA_JobControl JC,
           FMS_PhaseCheck PC
   WHERE   JC.Card = :OldCard.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           JC.Card = PC.Card AND
           J.Job  =  PC.WorkPermit AND
           PC.CompletionTime IS NULL 
   BEGIN
      JobControlList[i].Application = Application$FMS; 
      JobControlList[i].TypeOfCard = OldCard.TypeOfCard; 
      JobControlList[i].Card = NewXferCard.Card;
      i = i + 1;
   END;

   FOR i = 1 TO OutStandingMoves.LastRow() DO
     
      status = OutstandingMoves[i].InsertControl (
         ControlEntry = JobControlList[i],
         InitiatingCard = NewXferCard.Card,
         TransferFlag = TRUE,
         SingleFeederOnly = TRUE);
      IF status = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage =
                  'WARNING: Unable to transfer work permit related to outstanding ' +
                  'phase check.  Have tech support review trace log',
                  TraceMessage = 
                  'CreateXferCard: Unable to insert Job Control entry for permit ' +
                  'with outstanding phase checks, Job:' +
                   VARCHAR(OutstandingMoves[i].Job)
                    );    
         ENDLOOP;
      ELSE
         IF OutstandingMoves[i].ActivityIdentifier <> 'S' THEN
            CALLPROC SOA_JobActivityIDUpd (
                Job = OutstandingMoves[i].Job,
                ActivityIdentifier = 'T');
         ENDIF;
/*
**  Update ControlCard if it points to the current card.
*/ 
         IF OutstandingMoves[i].ControlCard = OldCard.Card THEN
      
            status = CALLPROC SOA_JobControlCardUpd (
                                   Job = OutstandingMoves[i].Job,
                                   Card = NewXferCard.Card);
            IF status <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
                  'WARNING: Unable to set Control for outstanding move to new ' +
                  'transfer card.  Have tech support review trace log',
                  TraceMessage = 
                  'CreateXferCard: Unable to update Control Card for outstanding ' +
                  'Job:' + VARCHAR(OutstandingMoves[i].Job)
                    );
            ENDIF;
         ENDIF;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);

    CurFrame.WaitFor (EventName = 'Received');

    status = CALLPROC FMS_XferPhaseChecks
                 ( OldCard = OldCard.Card,
                   NewCard = NewXferCard.Card
                 );
    IF (status < 0) THEN 
/*
**  Not a fatal error. Give message, then continue.
*/
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
              'WARNING: Unable to transfer outstanding ' +
              'phase checks.  Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Unable to transfer phase checks to new card: ' +
               VARCHAR(NewXferCard.Card) 
                             );
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);
    CurFrame.WaitFor (EventName = 'Received');
/*
**  Remove AmmClearInProgress equipment status for feeder source position
*/
    AmmClearObj = 0;
    REPEATED
    SELECT  :AmmClearObj = OS.Object
    FROM    TFMS_CardToObject AO,
            Udb_Grouping G,
            FMS_ObjectStatus OS
    WHERE   AO.Card = :NewXferCard.Card AND
            AO.Object = G.Grouping AND
            G.Relationship = :Interaction$SourcePosition AND
            G.Member = OS.Object AND
            OS.StatusCount > 0 AND
            OS.Status = :Status$AmmClearInProgress;

    IF AmmClearObj > 0 THEN
     
       status = CALLPROC FMS_ObjStatDel(
                                       Object = AmmClearObj,
                                       Terminal = 0, 
                                       Status = Status$AmmClearInProgress);
       IF status <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
                'WARNING: Unable to remove AmmClearInProgress Status. ' +
                'Have tech support review trace log',
                             TraceMessage = 
                'CreateXferCard: Unable to remove AmmClearInProgress Status for Object:' +
                 VARCHAR(AmmClearObj)
                               );
       ELSE
          CALLPROC DDB_COMMIT;
       ENDIF; 
   ENDIF;  
/*
**  Adjust Feeder Statuses for the transfer card's feeder.
*/ 
   IF NewXferCard.CardClass = Type$FOT OR KeepRAPStats = TRUE THEN
/*
**      No Status Changes
*/
      IF NewXferCard.CardClass = Type$FOT THEN
         FOTCount = 0;
       
         SELECT :FOTCount = FOTCount
         FROM   IR_FOTCount 
         WHERE  Card = :OldCard.Card;
       
         FOTCount = FOTCount + 1;
         IF TestType = '' THEN   /* TestType and TestDate passed from CREATE FOT*/
            TestType = 'O';
         ENDIF;
/*
** Insert data into IR_FOTCount.
** Possible impact for network feeder card.  Use Card count for 3G feeders.
*/                
         status = CALLPROC IR_InsertingFOTCount(VCard = NewXferCard.Card, 
                                              Vfeeder = NewXferCard.Feeder,  /* OK for 3G*/
                                              VFOTCount = FOTCount,
                                              VFOTTestType = TestType,
                                              FTestDate = TestDate,
                                              VPreviousCard = OldCard.Card);
                                      
         IF status <> 0 THEN
            CALLPROC DDB_ROLLBACK;
                    CALLPROC TraceError (UserMessage =
                'WARNING: Unable to record FOT Count. ' +
                'Have tech support review trace log',
                             TraceMessage = 
                'CreateXferCard: Unable to record FOT Count for Card:' +
                 VARCHAR(NewXferCard.Card)
                               );
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF; 
      ENDIF;
/*
** Update Shadow Switching Item to reflect new card info.
*/              
      ShadowCard = 0;
      ShadowItem = 0;
      REPEATED 
      SELECT   :ShadowCard = JC.Card, 
               :ShadowItem = JC.Job
      FROM     TFMS_CardToObject CTO,
               Udb_Grouping G,
               Udb_ExtendedType ET,
               SOA_Job J,
               SOA_JobControl JC,
               SOA_ActiveObject AO
      WHERE    CTO.Card = :OldCard.Card AND
               CTO.Object = G.Member AND
               G.Relationship = :Interaction$MemberOf AND
               G.GroupingType = ET.Type AND
               ET.SuperType = :Type$Substation AND
               G.Grouping = AO.Object AND
               AO.ObjectToCardLink = 1 AND  /*Primary Substation Card*/
               AO.Card = JC.Card AND
               JC.Job = J.Job AND
               J.ShadowLink = :OldCard.Card AND
               J.MoveCategory = :MoveCategory$SwitchingItem;
      
      IF ShadowCard <> 0 AND ShadowItem <> 0 THEN
      
         status = CALLPROC FMS_XferShadowItem
                  (FMSCard = NewXferCard.Card,
                   ShadowCard = ShadowCard,
                   ShadowItem = ShadowItem);
      
         IF status <> 0 THEN
            CALLPROC DDB_ROLLBACK;                  
            CALLPROC TraceError (UserMessage =
             'WARNING: Unable to update FMS Shadow Item text. ' +
             'Have tech support review trace log',
                          TraceMessage = 
             'CreateXferCard: Unable to update FMS Shadow Item text for Card:' +
              VARCHAR(NewXferCard.Card));
         ELSE
            CALLPROC DDB_COMMIT;
            CALLPROC SOA_LogIns (
                        Card = ShadowCard,
                        SwitchingItem = ShadowItem,
                        Job      = NULL,
                        Time     = Date('now'),
                        UserName = UserName,
                        Item     = 'FMS Xfer Card',
                        Old      = '',
                        New      = 'Shadow Item transferred to ' + 
                                    NewXferCard.CardClassName + ' card');
            CALLPROC DDB_COMMIT;   
         ENDIF;
      ENDIF;   

   ELSE
/*
**      For each feeder object on card, handle transfer of feeder status
*/
      SaveFeeder = NewXferCard.Feeder;
      FOR i = 1 TO NewXferCard.Object.LastRow() DO

         NewXferCard.Feeder = NewXferCard.Object[i].Object;
/*
**       Check DeadMoves Count
*/
         DeadMovesCount = 0;
         REPEATED
         SELECT  :DeadMovesCount = StatusCount
         FROM    FMS_ObjectStatus
         WHERE   Object = :NewXferCard.Feeder AND       
                 Status = :Status$DeadMove;
/*       
**      Check Caution Count
*/
         CautionCount = 0;
         REPEATED
         SELECT  :CautionCount = StatusCount
         FROM    FMS_ObjectStatus
         WHERE   Object = :NewXferCard.Feeder AND       
                 Status = :Status$Caution;
/*     
**      Remove all existing Feeder Statuses
*/ 
         status = CALLPROC FMS_ObjEquipDel (Object = NewXferCard.Feeder);
         IF status < 0 THEN
             CALLPROC DDB_ROLLBACK;
             CALLPROC TraceError (UserMessage =
               'WARNING: Unable to remove existing Feeder Statuses. ' +
               'Have tech support review trace log',
                            TraceMessage = 
               'CreateXferCard: Unable to remove existing feeder statuses ' +
               'for feeder:' + VARCHAR(NewXferCard.Feeder)
                              );
         ENDIF;
/*
**      Reinsert DeadMoves Statuses
*/      
         WHILE DeadMovesCount > 0 DO
       
            status = CALLPROC ForceStatus (Feeder = NewXferCard.Feeder,
                                           NewStatus = Status$DeadMove);
            IF status = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
               'WARNING: Unable to set DeadMovesTakenOut Count for new card. ' +
               'Have tech support review trace log',
                            TraceMessage = 
               'CreateXferCard: Unable to set DeadMovesTakenOut for feeder:' +
                VARCHAR(NewXferCard.Feeder)
                              );
            ENDIF;
       
            DeadMovesCount = DeadMovesCount - 1;
       
         ENDWHILE;
/*
**      Reinsert Caution Statuses
*/      
         WHILE CautionCount > 0 DO
       
            status = CALLPROC ForceStatus (Feeder = NewXferCard.Feeder,
                                           NewStatus = Status$Caution);
            IF status = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
               'WARNING: Unable to set Caution status for new card. ' +
               'Have tech support review trace log',
                            TraceMessage = 
               'CreateXferCard: Unable to set Caution status for feeder:' +
                VARCHAR(NewXferCard.Feeder)
                              );
            ENDIF;
       
            CautionCount = CautionCount - 1;
       
         ENDWHILE;
/*     
**      Insert appropriate ones based on card type
*/     
         IF NewXferCard.CardClassName = 'OOE1' THEN
       
            status = CALLPROC ForceStatus (Feeder = NewXferCard.Feeder,
                                  NewStatus = Status$ISM);
            IF status = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage =
               'WARNING: Unable to set ISM status for new card. ' +
               'Have tech support review trace log',
                            TraceMessage = 
               'CreateXferCard: Unable to set ISM status for feeder:' +
                VARCHAR(NewXferCard.Feeder)
                              );
            ENDIF;
         
         ELSE
       
            status = CALLPROC ForceStatus (Feeder = NewXferCard.Feeder,
                                  NewStatus = Status$DL);
            IF status = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                   CALLPROC TraceError (UserMessage =
               'WARNING: Unable to set DL status for new card. ' +
               'Have tech support review trace log',
                            TraceMessage = 
               'CreateXferCard: Unable to set DL status for feeder:' +
                VARCHAR(NewXferCard.Feeder)
                              );
            ENDIF;
         
         ENDIF;
         CALLPROC DDB_COMMIT;
  
      ENDFOR;
      NewXferCard.Feeder = SaveFeeder;

   ENDIF;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);
    CurFrame.WaitFor (EventName = 'Received');
/*
**  Propagate Preloaded Moves for Common Equipment
*/
   CommonEquip.Clear();
   i = 1;
   REPEATED 
   SELECT    
   DISTINCT  :CommonEquip[i].Value = G1.Member
   FROM      Udb_Grouping G1,
             Udb_Grouping G2,
             SOA_ActiveObject AO,
             TFMS_CardToObject CTO
   WHERE     CTO.Card = :NewXferCard.Card AND
             CTO.Object = G1.Grouping AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Member = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = AO.Object AND
             AO.ObjectToCardLink = 1 AND
             AO.Card <> :NewXferCard.Card AND
             AO.Card <> :OldCard.Card
   BEGIN
      i = i + 1;
   END;
/*
**  Activate the new transfer card
*/
   status = FMS_ActivateCard (Status = Card$Active,
                              Activated = DATE('now'),
                              Card = NewXferCard.Card);
   IF (status < 0) THEN 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
             'ERROR: Unable to mark transfer card status to Active. ' +
             'Have tech support review trace log',
                          TraceMessage = 
             'CreateXferCard: Unable to mark xfer card status Active for card:' +
              VARCHAR(NewXferCard.Card)
                            );
   
      RETURN(PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Update DeadMoveCount at top of card
*/
   status = CALLPROC FMS_DeadMoveCount (
                 Card = NewXferCard.Card);
   IF status < 0 THEN
      CALLPROC DDB_ROLLBACK;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Scroll thru preloaded moves, if any are for common equipment, propagate
**  the move to other cards
*/          
   FOR i = 1 TO PreloadedMoves.LastRow() DO
   
      FOR j = 1 TO CommonEquip.LastRow() DO
   
         IF PreloadedMoves[i].Equip = CommonEquip[j].Value THEN
   
              Idx.Clear();
              Idx = CALLPROC CascadeMoves (Move = PreloadedMoves[i],
                                           Card = OldCard.Card,
                                           NotShadowItem = NotShadow
                                          );
         ENDIF;
      ENDFOR;
   ENDFOR;
/*
**  Check if Network Protection Check move exists on card.  If so,
**  set feeder status for Network Protection.
*/
   NetworkProtectorJob = 0;
   SELECT :NetworkProtectorJob = J.Job
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :NewXferCard.Card AND
          JC.Job = J.Job AND
          J.Status = '' AND
          J.TOComplete IS NULL AND
          J.JobClass = :Move$NetworkProtectionCheck;

   IF NetworkProtectorJob > 0 THEN
      FOR n = 1 TO NewXferCard.Object.LastRow() DO
/*
** On 33kV Feeder make sure segment has S-T equipment.
*/
         IF NewXferCard.NetworkFeeder = NetworkFeeder$33kV THEN
            HasSTEquip = FALSE;
            SELECT :HasSTEquip = G.Member
            FROM   Udb_Grouping G,
                   Udb_ExtendedType ET
            WHERE  G.Grouping = :NewXferCard.Object[n].Object AND
                   G.Relationship = :Interaction$MemberOf AND  
                   G.MemberType = ET.Type AND 
                   ET.SuperType = :TypeName$ST;

            IF HasSTEquip = FALSE THEN
               CONTINUE;
            ENDIF; 
         ENDIF;

         status = CALLPROC ForceStatus (Feeder = NewXferCard.Object[n].Object,
                           NewStatus = Status$NetWProt);
         IF status = PU_CANCEL THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 'Network Protector Check status did not get set for ' +
                    'Feeder ' + NewXferCard.Object[n].Name + '.' + 
                    'Warnings related to network protector check move will ' +
                    'not be presented because of this error.',
                    TraceMessage = 'Error - ActivateFMSCard ' +                         
                    'failed to set Network Protector Check status for card ' + VARCHAR(NewXferCard.Card) );
         ENDIF;
      ENDFOR;                     
      CALLPROC DDB_COMMIT;
   ENDIF;

#   include NotifyImpactedCards

/*
**  Display message to DO to send order to FOD
*/            
   IF XferCardClass = Type$Auto OR 
      XferCardClass = Type$OOE1 THEN
      IF SimpleJob IS NULL THEN
         SimpleJob = Job.Create();
      ENDIF;
      
      SimpleJob.EquipName = '';
      SELECT :SimpleJob.EquipName = O.Name,
             :SimpleJob.EquipClassName = O.TypeName
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Grouping = :NewXferCard.Feeder AND
              G.Relationship = :Interaction$MicroGridGenFor AND
              G.Member = O.Object;
      IF SimpleJob.EquipName <> '' THEN
         WarningTxt = 'Feeder ' + NewXferCard.FeederName + ' has a MicroGrid generator.  ' +
                     'The generator breaker does not have transfer trip capability.  ' +
                     'You must send FOD an order to cut out ' + SimpleJob.EquipClassName + ' ' +
                     SimpleJob.EquipName + ' immediately.  Call FOD and confirm order.'; 
         CALLFRAME DDB_Message(MessageText = WarningTxt,
                               Application = 'WARNING',
                               Color = CC_YELLOW,
                               Timeout = 300);
         
         CALLPROC SOA_LogIns (
            Card = NewXferCard.Card,
            Job  = NULL,
            SwitchingItem = 0,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Micro Grid',
            Old  = SimpleJob.EquipClassName + ' ' + SimpleJob.EquipName,
            New  = 'Generator found on feeder. Prompted DO to issue cut out order to FOD.');
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;                                                    
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);

    CurFrame.WaitFor (EventName = 'Received');
/*
**  If OA/CIOA/FOT, we need to determine if this should be a  
**  Temperature Variable Bogey outage.  This code is similar
**  to the code in PromptCutin so here we will make sure 
**  TV_Bogey is > 0 so we don't repeat a step that was done 
**  at Cutin. 
*/
    IsAuto = 0;
    SELECT  :IsAuto = COUNT(*)
    FROM    FMS_Card
    WHERE   Card = :OldCard.Card AND
            TV_Bogey > 0 AND 
            CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT);
    
    IF IsAuto <> 0 THEN
       TV_BogeyEnabled = FALSE;
       SELECT :TV_BogeyEnabled = TM_BogeyEnabled
       FROM    FMS_SystemParameters;
   
      IF TV_BogeyEnabled <> FALSE THEN
         TV_FaultCheck = 0;
         SELECT :TV_FaultCheck = COUNT(*)
         FROM    FMS_Fault 
         WHERE   Card = :OldCard.Card;

         IF TV_FaultCheck = 0 THEN
            /*
            **  No fault info entered. Check for OTWR/S or EST step.
            **  Would like to look if HV was applied to feeder but
            **  HV is a Feeder Status that gets removed once move is 
            **  completed so look for EST which gets set at same time.
            */
            SELECT :TV_FaultCheck = COUNT(*)
            FROM    FMS_OperatingStepStatus
            WHERE   Card = :OldCard.Card AND
                    OperatingStep IN (:Type$OTWR,:Type$OTWS,:Type$EST);
            IF TV_FaultCheck = 0 THEN
               CALLPROC FMS_CardTVUpd (
                   Card = OldCard.Card,
                   Type = 0,  /* Active card */
                   TV_Bogey = -1);
               CALLPROC DDB_COMMIT;
            ENDIF;
         ELSEIF TV_FaultCheck > 1 THEN
            /*
            **  Find Total mins of outage time and divide number by
            **  Number of faults entered.
            */
            IF OldCard.Cutin IS NULL THEN
               Tot_Min = IFNULL(INT4(interval('minute',DATE('now') - DATE(OldCard.CutOut))),0);            
            ELSE
               Tot_Min = IFNULL(INT4(interval('minute',DATE(OldCard.CutIn) - DATE(OldCard.CutOut))),0);
            ENDIF;
            Tot_Min = INT4(Tot_Min/TV_FaultCheck);
      
            CALLPROC SOA_LogIns (
                 Card = OldCard.Card,
                Job  = NULL,
                SwitchingItem = 0,
                Time = DATE('Now'), 
                UserName = UserName,
                Item = 'TV Update Duration',
                Old  = VARCHAR(TV_FaultCheck) + ' faults entered as part of outage',
                New  = VARCHAR(Tot_Min));
      
         ENDIF;
      ENDIF;
    ENDIF;
/*
**  Transfer links for 33kv portion cards and 4kv StepDown feeders if necessary.
*/
    LinkedCard.Clear();
    IF OldCard.NetworkFeeder = NetworkFeeder$33KV THEN
       IF OldCard.TypeOfCard = TypeOfCard$Portion THEN
          /* Can only be one 33kv card linked to a portion card */
          i = 1;
          SELECT :LinkedCard[i].Value = L.Card
          FROM    FMS_PortionLink L 
          WHERE   L.PortionCard = :OldCard.Card
          BEGIN
             i = i + 1;
          END;
          
          IF LinkedCard.LastRow > 0 THEN
             FOR i = 1 TO LinkedCard.LastRow DO
                CALLPROC FMS_PortionLinkUpd
                       (OldCard = LinkedCard[i].Value,
                        Card = 0,        /* Triggers update of PortionCard */
                        OldPortionCard = OldCard.Card,
                        PortionCard = XferCardKey);
                CALLPROC DDB_COMMIT;
             ENDFOR;
          ELSE
             CurFrame.Trace(Text = 'CreateXferCard; Error: old 33kv portion card ' + VARCHAR(OldCard.Card) + ' not linked to the main card');
            
             /* work around the problem
             */
             SELECT  DISTINCT
                     :LinkedCard[1].Value = C.Card
             FROM    TFMS_CardToObject CTO,
                     UDB_Grouping G,
                     FMS_Card C
             WHERE   CTO.Card = :OldCard.Card AND
                     CTO.Object = G.Member AND
                     G.RelationShip = :Interaction$MemberOf AND
                     G.GroupingType = :Type$Feeder AND
                     G.Grouping = C.Feeder AND
                     C.Status = :Card$Active;
                     
             CALLPROC FMS_PortionLinkIns
                           (Card = LinkedCard[1].Value,
                            PortionCard = XferCardKey);
             CALLPROC DDB_COMMIT;
          ENDIF;          
       ELSE
          /* 
          ** Can be multiple portion cards linked to a 33kv main card 
          */
          i = 1;
          SELECT :LinkedCard[i].Value = L.PortionCard
          FROM    FMS_PortionLink L 
          WHERE   L.Card = :OldCard.Card
          BEGIN 
             i = i + 1;
          END;
          
          FOR i = 1 TO LinkedCard.LastRow DO
             CALLPROC FMS_PortionLinkUpd
                    (OldCard = OldCard.Card,
                     Card = XferCardKey,                   
                     OldPortionCard = LinkedCard[i].Value,
                     PortionCard = 0);   /* Triggers update of Card */
             CALLPROC DDB_COMMIT;
          ENDFOR;
       ENDIF;
    ELSE
       IF OldCard.TypeOfCard = TypeOfCard$4KV THEN
          /* Can only be one 13kv card linked to 4kv card */
          i = 1;
          SELECT :LinkedCard[i].Value = L.Card
          FROM    FMS_StepDownLink L 
          WHERE   L.StepDownCard = :OldCard.Card
          BEGIN
             i = i + 1;
          END;
          
          FOR i = 1 TO LinkedCard.LastRow DO
             CALLPROC FMS_StepDownLinkUpd
                    (OldCard = LinkedCard[i].Value,
                     Card = 0,        /* Triggers update of StepDownCard */
                     OldStepDownCard = OldCard.Card,
                     StepDownCard = XferCardKey);
             CALLPROC DDB_COMMIT;
             IF NewXferCard.CardClass = Type$Auto OR
                NewXferCard.CardClass = Type$CIOA OR
                NewXferCard.CardClass = Type$OOE1 THEN
                /*
                **  Remove openauto move if it exists on StepDown 4kV card.
                */
                StepDownOAJob = NULL;
                StepDownOAJob = Job.Create();
                IF NewXferCard.CardClass = Type$OOE1 THEN
                   SELECT :StepDownOAJob.Job = J.Job,
                          :StepDownOAJob.Card = :XferCardKey,
                          :StepDownOAJob.MoveType = J.MoveType,
                          :StepDownOAJob.TOMove = J.TOMove,
                          :StepDownOAJob.RSMove = J.RSMove,
                          :StepDownOAJob.SwitchingItem = 0
                   FROM   SOA_JobControl SJ,
                          SOA_Job J,
                          FMS_JobAction JA
                   WHERE  SJ.Card = :XferCardKey AND 
                          SJ.Job = J.Job AND
                          J.TOIssued IS NULL AND
                          J.TOComplete IS NULL AND
                          J.JobClass = JA.JobClass AND
                          JA.EquipClass = SJ.MoveEquipClass AND
                          JA.StepPair = SJ.StepPair AND
                          J.Status <> 'Del' AND
                          JA.TORS = :Job$TakeoutInt AND
                          JA.Action = :JobAction$Prompt AND
                          JA.Status =  :JobAction$CutOut;
                ELSE
                   SELECT :StepDownOAJob.Job = J.Job,
                          :StepDownOAJob.Card = :XferCardKey,
                          :StepDownOAJob.MoveType = J.MoveType,
                          :StepDownOAJob.TOMove = J.TOMove,
                          :StepDownOAJob.RSMove = J.RSMove,
                          :StepDownOAJob.SwitchingItem = 0
                   FROM   SOA_JobControl SJ,
                          SOA_Job J
                   WHERE  SJ.Card = :XferCardKey AND
                          SJ.Job = J.Job AND
                          J.JobClass = :JobClass$OpenAuto AND
                          J.Status <> 'Del'; 
                ENDIF;
                /*
                **  Delete OpenAuto move on 4kv card.
                */
                IF StepDownOAJob.Job <> 0 THEN
                   StepDownOAJob.DeleteJob();
                   IsStepDown = TRUE;
                ENDIF;                      
             ENDIF;
          ENDFOR;
       ELSE
          /* 
          ** Make sure all possible StepDown cards are active so they
          ** will be transferred to new 13kV card.
          */
          CALLPROC CheckActiveStepDown(CheckCard = OldCard.Card);
          /* 
          ** Can be multiple 4kv cards linked to on 13kv card 
          */
          i = 1;
          SELECT :LinkedCard[i].Value = L.StepDownCard
          FROM    FMS_StepDownLink L 
          WHERE   L.Card = :OldCard.Card
          BEGIN 
             i = i + 1;
          END;
          
          FOR i = 1 TO LinkedCard.LastRow DO
             CALLPROC FMS_StepDownLinkUpd
                    (OldCard = OldCard.Card,
                     Card = XferCardKey,                   
                     OldStepDownCard = LinkedCard[i].Value,
                     StepDownCard = 0);   /* Triggers update of Card */
             CALLPROC DDB_COMMIT;
          ENDFOR;
       ENDIF;
    ENDIF;
/*
**  Close former card
*/
    status = FMS_CloseCard (Status = Card$Closed,
                            Closed = DATE('now'),
                            Card = OldCard.Card);
    IF (status < 0) THEN 
       CALLPROC DDB_ROLLBACK;
                   CALLPROC TraceError (UserMessage =
              'ERROR: Unable to mark old card as closed. ' +
              'Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Unable to mark old card status to closed for card:' +
               VARCHAR(OldCard.Card)
                             );
    ENDIF;
    CALLPROC DDB_COMMIT;
/* 
**  restore feeder restrictions that may have been lifted.
*/
    Status = CALLPROC FMS_RestoreFeederRestriction (
                  Feeder = OldCard.Feeder);

    IF Status < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CALLPROC TraceError (UserMessage = 
                   'ERROR: Unable to restore feeder restrictions that ' +
                   'may have been lifted for feeder ' +
                   OldCard.FeederName,
               TraceMessage = 
                   'CreateXferCard: ' +
                   'Unable to restore feeder restrictions that ' +
                   'may have been lifted for feeder ' +
                   OldCard.FeederName
                   );
    ELSE
       CALLPROC DDB_COMMIT;   
    ENDIF;

    CALLPROC SOA_DeleteLinkByFMS (FMSCard = OldCard.Card);
    CALLPROC DDB_COMMIT;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);
    CurFrame.WaitFor (EventName = 'Received');
/*
**  Update card values for any outstanding fod orders.  Orderlist was 
**  selected before moves were transferred.
*/
    FOR i = 1 TO OrderList.LastRow() DO
       status = IR_FODOrderCardUpd (OrderNumber = OrderList[i].Value
                                   ,OldCardID   = OldCard.Card
                                   ,NewCardID   = NewXferCard.Card
                                   );
       IF status < 0 THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
              'WARNING: Unable to transfer outstanding FOD Orders to new ' +
              'card.  You will manually need to rescind outstanding FOD ' +
              'Orders on the new card.',
                           TraceMessage = 
              'CreateXferCard: Manual intervention necessary to rescind ' +
              'FOD Orders on card:' +
               VARCHAR(NewXferCard.Card)
                             );
         ENDLOOP;
       ENDIF;
       CALLPROC DDB_COMMIT;
    ENDFOR;
/*
**  Update process window
*/    
    ProcessCount = ProcessCount + 1;
    ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                 MessageInteger = ProcessCount);

    CurFrame.WaitFor (EventName = 'Received');
    
/*
**  Prompt to transfer Log entries if any
*/
    LogEntries = 0;
    SELECT LogEntries = Count(*)
    FROM FMS_FeederLog
    WHERE Card = :OldCard.Card;
    CALLPROC DDB_ROLLBACK;

    IF LogEntries > 0 THEN
        CALLFRAME XferFeederLog (OldC = OldCard, NewC = NewXferCard);
    ENDIF;
/*
**  If new cardtype indicates feeder is cutout, set STA operating step
**  status for the card.
*/
    IF (NewXferCard.CardClass = Type$FOT OR 
        NewXferCard.CardClass = Type$Auto OR 
        NewXferCard.CardClass = Type$CIOA) AND
        DisableOperatingStep = FALSE THEN

        IF SimpleStep IS NULL THEN
           SimpleStep = OperatingStep_ASE.Create();
        ENDIF;    

        SimpleStep.StartTime   = DATE('now');
        SimpleStep.OpStep      = Type$STA;
        SimpleStep.Job         = 0;
        SimpleStep.SO.Object   = NewXferCard.Card;
        SimpleStep.SO.BaseType = NewXferCard.CardClass;
        SimpleStep.SO.Name     = NewXferCard.CardClassName;
        SimpleStep.SO.Type     = NewXferCard.Feeder;
        SimpleStep.SO.TypeName = NewXferCard.FeederName;

        SimpleStep.SetOpStep();
   
        IF SimpleStep.ReturnCode <> 0 THEN
           CALLPROC TraceError (UserMessage =
              'WARNING: Unable to set STA operating step for new card. ' +
              'Have tech support review trace log',
                           TraceMessage = 
              'CreateXferCard: Unable to set STA operating step for card:' +
               VARCHAR(NewXferCard.Card)
                             );
        ENDIF; 
        SimpleStep = NULL;
    ENDIF;
/*
** Report Data check, not if cutin because it was probably already done 
*/
    IF OldCard.CutIn IS NULL THEN
       CALLFRAME RecordCardForReportFilter (Card = OldCard.Card);
    ENDIF;
/*
** RR Interface, send Card to RR (no longer matters if Trouble or Scheduled).
*/ 
    IF NewXferCard.NetworkFeeder = NetworkFeeder$33KV AND
       NewXferCard.TypeOfCard = TypeOfCard$Portion THEN
       /* Skip this. Portion cards are not visible to Rapid Restore */
    ELSE
       DBEventText = VARCHAR(NewXferCard.Card);
       IF NewXferCard.CardClass = Type$FOT THEN
          CALLPROC InsertDBEventQueue(
                        ToApp = 'FCR',
                        EventName = 'IR_TroubleCard',
                        EventText = DBEventText);  

       ELSEIF NewXferCard.CardClass <> Type$CardClassTest THEN
          CALLPROC InsertDBEventQueue(
                        ToApp = 'FCR',
                        EventName = 'IR_CreateCard',
                        EventText = DBEventText);  
       ENDIF;
       /*
       ** Initiate RR Xfer Card Interface Message if there were orders transferred
       */
       IF OrderList.LastRow() > 0 THEN
          DBEventText = VARCHAR(OldCard.Card) + ';' + VARCHAR(NewXferCard.Card) + ';';
          CALLPROC InsertDBEventQueue(
                        ToApp = 'FCR',
                        EventName = 'IR_XferCard',
                        EventText = DBEventText);  
       ENDIF;
    ENDIF;
/*
**  Log the transfer for the new card
*/
    CALLPROC SOA_LogIns (Card     = NewXferCard.Card,
                         Job      = NULL,
                         Time     = Date('now'),
                         UserName = UserName,
                         Item     = 'Card XFR',
                         Old      = OldCard.FeederName + ' - ' +
                                    OldCard.CardClassName,
                         New      = NewXferCard.FeederName + ' -- ' + 
                                   NewXferCard.CardClassName);

    CALLPROC DDB_COMMIT;

    CALLPROC SOA_LogIns (Card     = OldCard.Card,
                         Job      = NULL,
                         Time     = Date('now'),
                         UserName = UserName,
                         Item     = 'Card XFR',
                         Old      = OldCard.FeederName + ' - ' +
                                    OldCard.CardClassName,
                         New      = NewXferCard.FeederName + ' -- ' + 
                                    NewXferCard.CardClassName);

    CALLPROC DDB_COMMIT;
/*
** Automatically issue the Open Auto Move on the new card.
*/
    IF (NewXferCard.CardClass = Type$Auto OR
        NewXferCard.CardClass = Type$CIOA) AND
        IsStepDown = FALSE THEN

       IF XferCutout IS NOT NULL AND
          XferCutout <> '' THEN
          CALLPROC OpenAutoMoves (
                            CutOut = XferCutout,
                            Card = NewXferCard.Card);
       ELSE
          CALLPROC OpenAutoMoves (
                            CutOut = NewXferCard.CutOut,
                            Card = NewXferCard.Card);
       ENDIF;

    ELSEIF NewXferCard.CardClass = Type$OOE1 AND
           (XferCutout IS NOT NULL AND
            XferCutout <> '') AND
            IsStepDown = FALSE THEN
          CALLPROC OpenAutoMoves (
                            CutOut = XferCutout,
                            CardType = Type$OOE1,
                            Card = NewXferCard.Card);
    ENDIF;
/*
**  Check for TV if new card is FOT.
*/
    IF NewXferCard.CardClass = Type$FOT THEN
       /*
       **  See if TV_BogeyEnabled = TRUE. 
       */
       TV_BogeyEnabled = FALSE;
       SELECT :TV_BogeyEnabled = TM_BogeyEnabled,
              :TV_Threshold = TV_Threshold
       FROM    FMS_SystemParameters;
   
       IF TV_BogeyEnabled <> FALSE THEN
          TV_Forecast = 0;
          IF date_part('hour',NewXferCard.CutOut) < 18 THEN
             /*  Get Today's Forecast */
             SELECT :TV_Forecast = B.Forecast
             FROM    TV_BogeyHistory B
             WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
                     B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                                  FROM   TV_BogeyHistory);

             IF TV_Forecast = 0 THEN
                /* Get Yesterdays 'day ahead' forecast */
                SELECT :TV_Forecast = B.DayAhead
                FROM    TV_BogeyHistory B
                WHERE   B.LogDate >= date_trunc('day',date('NOW')) - '1 day' AND
                        B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                                     FROM   TV_BogeyHistory);
             ENDIF;
             TV_Bogey = 2;
          ELSE
             /*  Get Tomorrows Forecast */
             SELECT :TV_Forecast = B.DayAhead
             FROM    TV_BogeyHistory B
             WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
                     B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                                  FROM   TV_BogeyHistory);
             TV_Bogey = 3;
          ENDIF;

          IF TV_Forecast = 0 THEN
             WarningTxt = 'Feeder ' + NewXferCard.FeederName + ' has been cutout and ' + 
                   'no Forecasted Temperature Variables have been entered ' +
                   'for today.  Please enter the Forecasted Temperature Variables ' +
                   'using FMS_Online.'; 
             CALLPROC CSD_MessageIns(DeskType = 'pgm_online'
                             ,MessageText = WarningTxt
                             ,MessageType = 0
                             ,Card = 0
                             ,Priority = 0  /* High Priority */ 
                             ,Time = date('now'));
             CALLPROC TraceError (
                UserMessage = '',
                TraceMessage = 'CreatXferCard: No Temperature Variable values ' +
                               'are in the database for today.');
          ENDIF;

          IF TV_Forecast >= TV_Threshold THEN
             /*
             **  See if today is a CERC day.  If yes then today can be tracked as 
             **  a TV day if the TV Threshold has been met.
             */
             IsCerc = 0;
             IF UPPERCASE(dow(NewXferCard.CutOut)) = 'FRI' AND
                date_part('hour',NewXferCard.CutOut) >= 15 THEN 
                /* On Friday after 3pm check tomorrow */
                SELECT :IsCERC = 1
                FROM    FMS_CercDay C
                WHERE   C.DateValue = DATE_TRUNC('day',date(:NewXferCard.CutOut) + '1 day');   
             ELSEIF date_part('hour',NewXferCard.CutOut) < 18 THEN
                SELECT :IsCERC = 1
                FROM    FMS_CercDay C
                WHERE   C.DateValue = DATE_TRUNC('day',date(:NewXferCard.CutOut));
             ELSE  /* After 6pm check tomorrow */
                SELECT :IsCERC = 1
                FROM    FMS_CercDay C
                WHERE   C.DateValue = DATE_TRUNC('day',date(:NewXferCard.CutOut) + '1 day');   
             ENDIF;
             /*
             **  Set up July 4 date
             */
             July4Start = date('03-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');
             July4End   = date('04-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');
             /*
             **  Don't track TV on weekends or July 4th.
             */
             IF IsCERC = 0 AND
               (UPPERCASE(dow(NewXferCard.CutOut)) = 'SAT' OR
               (UPPERCASE(dow(NewXferCard.CutOut)) = 'FRI' AND
                date_part('hour',NewXferCard.CutOut) >= 15) OR 
               (UPPERCASE(dow(NewXferCard.CutOut)) = 'SUN' AND
                date_part('hour',NewXferCard.CutOut) < 18) OR
               (NewXferCard.CutOut >= July4Start AND
                NewXferCard.CutOut < July4End)) THEN
                /* Do nothing */
             ELSE
                CALLPROC FMS_CardTVUpd 
                    (Card = NewXferCard.Card,
                     Type = 0, /* Active card */
                     TV_Bogey = TV_Bogey);  
                CALLPROC DDB_COMMIT;    
             ENDIF;
          ENDIF;
       ENDIF;
    ENDIF;
/*
**  Make sure OperatingStepCount(10147) is set correctly.
*/
    CALLPROC CheckOpStepCount(Card = NewXferCard.Card);

/*
**  Attempt to clear pending operating steps on old card.
**  Don't really care about RetCode.
*/
    CALLPROC FMS_ClearPendingOpSteps (Card = OldCard.Card);
    CALLPROC DDB_COMMIT;

    ProcessWindow.Terminate();
    RETURN(PU_OK); 
END; 

PROCEDURE CheckActiveStepDown(
   CheckCard = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT; 
    CheckActive = INTEGER NOT NULL WITH DEFAULT; 
    StepDownCard = ARRAY OF FMS_Card;
    d  = Date;          /* Temporary date */
    RetCode = INTEGER;
ENDDECLARE
BEGIN
   /*
   **  Check to see if Feeder has a step down feeder associated with it
   **  using SD-VIS as the common piece of equipment that is a source
   **  breaker for a 4KV feeder.  As part of the check, make sure there
   **  is no active card.  If there is an active card we can ignore it.
   **  This is only called when transfering to a new 13kV card.  Not 4kV.
   **  If no SDVis equipment found, then nothing more to do. 
   */
   i = 1;
   StepDownCard.Clear();
   SELECT :StepDownCard[i].Feeder = G2.Grouping       /* StepDown Feeder */
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          Udb_Grouping G,
          Udb_Grouping G2,
          Udb_Grouping G3,
          Udb_Rating R
   WHERE  C.Card = :CheckCard AND
          CTO.Card = C.Card AND
          CTO.Object = G.Grouping AND 
          G.Relationship = :Interaction$MemberOf AND 
          G.MemberType = :Type$SDVIS AND 
          G.Member = G2.Member AND   /* SDVis Object on feeder */
          G2.Relationship = :Interaction$SourceBreaker AND 
          G2.Grouping = G3.Member AND
          G3.Relationship = :Interaction$RatedAs AND 
          G3.Grouping = R.Object AND
          R.Normal = :Rating$4KV
   BEGIN
      i = i + 1;
   END;
     
   FOR i = 1 TO StepDownCard.LastRow DO
      CheckActive = 0;
      SELECT :CheckActive = COUNT(*)
      FROM    SOA_ActiveObject AO
      WHERE   AO.Object = :StepDownCard[i].Feeder;
      IF CheckActive = 0 THEN
         StepDownCard[i].Card = CALLPROC CreateFMSOpenCard(
                          NewCardFeeder = StepDownCard[i].Feeder,
                          NewCardClass = NewXferCard.CardClass,
                          NetworkFeeder = FALSE,
                          SubstationName3G = OldCard.SubstationName,
                          Position3G = OldCard.Position,
                          NoStepDown = TRUE);
         /*
         **  Add link for newly created card.
         */
         IF StepDownCard[i].Card <> 0 THEN
            CALLPROC FMS_StepDownLinkIns
                 (Card = CheckCard,
                  StepDownCard = StepDownCard[i].Card);
            CALLPROC DDB_COMMIT;
            /*
            **  Activate the card linked to 27kv card
            */
            d = NULL;
            RetCode = CALLFRAME ActivateFMSCard(Card = StepDownCard[i].Card,
                                      OldCardStatus = Card$Open,
                                      Cutout = d,
                                      NoStepDown = TRUE);
            IF RetCode = PU_CANCEL THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Problem activating card for linked 4KV feeder ' +
                    StepDownCard[i].FeederName +
                    '.  Please manually activate card for 4KV feeder.';
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;
END;

