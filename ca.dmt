	Name:            EmailAttachmentClass


���ph�N��Component Method Scripts
���ph�N��--------------------------
/*
**
**      Copyright c 2015 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          EmailAttachmentClass
**
**  Date:       Version Description
** ----------------------------------
**  15/17/15 ysp Created
*/
METHOD InsertAttachment (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   BinaryStream = LongByteObject;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   DBServer = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_EmailAttachmentIns(
                  RequestID = CurObject.RequestID,
                  FileID = CurObject.FileID,
                  FileName = CurObject.FileName);

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'EmailAttachmentClass.InsertAttachment; Error inserting email attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : EmailAttachmentClass.InsertAttachment; ' + 
                'Error inserting email attachment');
       RETURN -1;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    UpdateSql = ' UPDATE FMS_EmailAttachment SET DataStream ' + 
                ' WHERE  RequestID = ' + VARCHAR(CurObject.RequestID) + 
                ' AND   FileID = ' + VARCHAR(CurObject.FileID);

    // Read in the image file
    BinaryStream.FileHandle = CurObject.Location;

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;
 
    IF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       DBServer = 2;

    ELSE
       DBServer = -1;
    ENDIF;

    RETURN DBServer;
END;

