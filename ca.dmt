	Name:            Confirm3GConfiguration

/*
**  Copyright c 2010 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    FeederCard
**  Frame:          Confirm3GConfiguration
**
**  Modification log:
**
**   08/25/10   em     Created; Return Parameter PU_OK if configuration is the same,
**                     PU_CANCEL if it is different based on Card Class input parm
**   03/03/16   pkw    Implement for 33kv portion feeders.
**   03/20/16   pkw    Add Fed By checking using PrimaryGrouping attribute.
**   03/24/16   pkw    If later traces don't have a FeedingNeighbor should trigger new 
**                     configuration.
**   04/14/16   pkw    3G trace uses primary grouping so must handle arrays separately.
**   05/26/16   pkw    If a segment is fed by previously and now fed by is -1 don't prompt DO.
**   08/03/16   ysp    Add NotifyFedByChange parameter to notify DO if changes in Fed By relation
*/
PROCEDURE Confirm3GConfiguration 
(
   Card = FMS_Card;                                
   NotifyFedByChange = INTEGER NOT NULL WITH DEFAULT;   /* Optional: True - prompt DO if changes in fed by relation */
) =
DECLARE
/* local variables */
#  include StandardDeclarations

   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;
   FoundCommonOpen = INTEGER NOT NULL WITH DEFAULT;
   AddToList = INTEGER NOT NULL;   
   HasLinks = INTEGER NOT NULL WITH DEFAULT;
   CardFeederList = ARRAY OF ObjectSummaryClass;
   AllPortionList = ARRAY OF ConnectedEquipClass;    
   NetworkFeederList = ARRAY OF ConnectedEquipClass;          
   FeederPortionList = ARRAY OF ConnectedEquipClass;          
   SwitchList = ARRAY OF ConnectedEquipClass;          
   OpenSwitchList = ARRAY OF ConnectedEquipClass;          
   NewFeederList = ARRAY OF ConnectedEquipClass; 
   FeedingNeighbor = INTEGER NOT NULL WITH DEFAULT;
   MainFeeder = INTEGER NOT NULL;   
ENDDECLARE
BEGIN
/*
** Pass the first feeder on the card into the configuration utility then compare the 
** resulting feeder lists.
*/  
   CardFeederList = Card.Object.Duplicate();

   IF Card.NetworkFeeder = NetworkFeeder$33KV THEN
      SELECT :MainFeeder = G.Grouping
      FROM   TFMS_CardToObject CTO,
             UDB_Grouping G
      WHERE  CTO.Card = :Card.Card AND
             CTO.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Feeder;
      CALLPROC DDB_ROLLBACK;
      /*
      **  Remove Feeder object from list since it doesn't participate in connectivity
      */
      FOR i = 1 TO CardFeederList.LastRow DO
         IF CardFeederList[i].Type = Type$Feeder OR
            CardFeederList[i].Type = Type$PortionFeeder THEN
            CardFeederList.RemoveRow (RowNumber = i);
            ENDLOOP;
         ENDIF;
      ENDFOR;
      /*
      **  Call trace for all portions on this card.  
      **  If there are links, and we are on the main feeder then we 
      **  need to look at all portions because
      **  something could have happened down the feeder that this 
      **  current cards object don't know about.
      */
      HasLinks = FALSE;
      SELECT :HasLinks = :TRUE
      FROM    FMS_PortionLink
      WHERE   Card = :Card.Card;
      IF HasLinks = TRUE THEN
         RetCode = CALLPROC PortionFeederTrace (
                  MainFeeder = MainFeeder,
                  StartPortion = CardFeederList[1].Object,  /*Start start with any portion*/
                  FeederPortionList = ByRef(AllPortionList),
                  SwitchList = ByRef(SwitchList),
                  GetAll = TRUE);
         IF RetCode = PU_CANCEL THEN
            MESSAGE 'Network trace failed to identify Switches and Feeders.';
            RETURN(PU_CANCEL);
         ENDIF;
         FeederPortionList = AllPortionList.Duplicate();
      ELSE
         FOR i = 1 TO CardFeederList.LastRow DO
            FeederPortionList[i].Object = CardFeederList[i].Object;
         ENDFOR;
      ENDIF;
      NetworkFeederList.Clear();
      
      WHILE FeederPortionList.LastRow() > 0 DO
         FeedingNeighbor = 0;
         NewFeederList.Clear();
   
         RetCode = CALLPROC PortionFeederTrace (
                  MainFeeder = MainFeeder,
                  StartPortion = FeederPortionList[1].Object,
                  FeederPortionList = ByRef(NewFeederList),
                  SwitchList = ByRef(SwitchList),
                  FeedingNeighbor = ByRef(FeedingNeighbor));
         IF RetCode = PU_CANCEL THEN
            MESSAGE 'Network trace failed to identify portion feeders.';
            RETURN(PU_CANCEL);
         ENDIF;
         IF Card.TypeOfCard = TypeOfCard$Portion THEN   
            /* 
            ** Use Switchlist to store open switches on each target card
            */
            FoundCommonOpen = FALSE;
            j = OpenSwitchList.LastRow + 1;  
            FOR i = 1 TO SwitchList.LastRow DO
               IF SwitchList[i].CurrentlyOpen = TRUE THEN
                  /*
                  **  See if equip is in list
                  */
                  RetCode = OpenSwitchList.Find(AttributeName = 'Object',
                                          Value = SwitchList[i].Object,
                                          RowNumber = ByRef(x));
                  IF RetCode = ER_OK THEN
                     /*
                     **  Found row so this is in the middle, remove equip from list
                     */
                     FoundCommonOpen = TRUE;
                  ELSE
                     OpenSwitchList[j] = SwitchList[i].Duplicate();
                     j = j + 1;
                  ENDIF;
               ENDIF;
            ENDFOR;
         ENDIF;
         /*
         ** All traces after the first trace should be fed by a neighbor
         ** feeder.  If a trace isn't being fed by a neighbor it should not
         ** get added to NetworkFeederList.  
         ** The exception is when we are on a portion card.  In this case,
         ** if we found common open equipment on multiple traces then the 
         ** portions should be added to NetworkFeederList.
         */
         AddToList = TRUE;
         IF NetworkFeederList.LastRow <> 0 AND
             FeedingNeighbor = 0 THEN  
            AddToList = FALSE;
         ENDIF;
         IF Card.TypeOfCard = TypeOfCard$Portion AND
            FoundCommonOpen = TRUE THEN
            /* 
            ** Reset flag to true if this is the second trace and we found
            ** common open equipment for portion card.
            */
            AddToList = TRUE;
         ENDIF;  
         /*
         ** Take NewFeederList out of FeederPortionList and build NetworkFeederList
         */
         k = NetworkFeederList.LastRow + 1;
         FOR i = 1 TO NewFeederList.LastRow DO
            IF AddToList = TRUE THEN
               NetworkFeederList[k].Object = NewFeederList[i].Object;
               NetworkFeederList[k].PrimaryGrouping = FeedingNeighbor;  /* Fed By */
               k = k + 1;
            ENDIF;
            FOR j = 1 TO FeederPortionList.LastRow DO
               IF NewFeederList[i].Object = FeederPortionList[j].Object THEN
                  FeederPortionList.RemoveRow (RowNumber = j);
                  ENDLOOP;
               ENDIF;
            ENDFOR;
         ENDFOR;
      
      ENDWHILE;
   ELSEIF Card.NetworkFeeder = NetworkFeeder$3G THEN

      RetCode = CALLPROC NetworkFeederTrace (
                   StartFeeder = Card.Object[1].Object,  /*Start start with any feeder*/
                   NetworkFeederList = NetWorkFeederList);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Network trace failed to identify 3G Feeders.';
         RETURN(PU_CANCEL);
      ENDIF;
   ENDIF;
   
   i = NetworkFeederList.LastRow();
   WHILE i > 0 DO
      j = CardFeederList.LastRow();
      WHILE j > 0 DO
         IF Card.NetworkFeeder = NetworkFeeder$33KV AND
            NetworkFeederList[i].Object = CardFeederList[j].Object AND
           (NetworkFeederList[i].PrimaryGrouping = CardFeederList[j].PrimaryGrouping OR
            (NetworkFeederList[i].PrimaryGrouping = -1 AND NotifyFedByChange = FALSE)) THEN

            NetworkFeederList.RemoveRow (RowNumber = i);
            CardFeederList.RemoveRow (RowNumber = j);
            ENDLOOP;

         ELSEIF Card.NetworkFeeder = NetworkFeeder$3G AND
            NetworkFeederList[i].Object = CardFeederList[j].Object THEN
            
            NetworkFeederList.RemoveRow (RowNumber = i);
            CardFeederList.RemoveRow (RowNumber = j);
            ENDLOOP;

         ENDIF;
         j = j - 1;
      ENDWHILE;
      i = i - 1;
   ENDWHILE;  
   
   IF CardFeederList.LastRow = 0 AND NetworkFeederList.LastRow > 0 THEN 
      i = 1;
      WHILE i <= NetworkFeederList.LastRow DO
         IF NetworkFeederList[i].PrimaryGrouping = -1 THEN
            NetworkFeederList.RemoveRow(RowNumber = i);
         ELSE
            i = i + 1;
         ENDIF;
      ENDWHILE;
   ENDIF;
/*
** Compare what is left, if nothing, both lists are the same
*/
   IF NetWorkFeederList.LastRow() = 0 AND CardFeederList.LastRow() = 0 THEN
      RETURN(PU_OK);
   ELSE
      RETURN(PU_CANCEL);
   ENDIF;
END;

Application Component Report
============================

	Name:            Confirm3GOutofService

/*
**  Copyright c 2010 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Confirm3GOutofService
**
**  Modification log:
**  09/20/10     em  Created
**  11/17/10     em  Was popping out of In Service loop at improper time.
**  03/08/11     em  Don't know why current feeder is excluded from lookup.
**                   Commenting that out and adding ConnectedSource lookup.
**                   Add Skip feeder to avoid feeder from PromptCutOut.
**
** THIS PROCEDURE RETURNS PU_CANCEL IF FEEDER IS ENERGIZED, PU_OK IF IT IS OUT OF SERVICE
*/
procedure Confirm3GOutofService
(
    Feeder = 	INTEGER NOT NULL;
    SkipFeeder = INTEGER NOT NULL WITH DEFAULT;  /*From PromptCutOut*/
) =
declare
    i 	= INTEGER NOT NULL WITH DEFAULT;
    FeederStatus = INTEGER NOT NULL WITH DEFAULT; 
    FeederStation = INTEGER NOT NULL WITH DEFAULT; 
    NetworkFeederList = ARRAY OF ConnectedEquipClass;        /*Parameter*/
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    TraceEnabled = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
   RetCode = CALLPROC NetworkFeederTrace (
                           StartFeeder = Feeder,  
                           NetworkFeederList = NetworkFeederList);
/*
** For each feeder except the current one, check if part of substation with closed source breaker.
*/ 
   RetCode = PU_OK;  /*Default Out of Service return code */
   FOR i = 1 TO NetworkFeederList.LastRow() DO

/*      IF Feeder = NetworkFeederList[i].Object THEN
         CONTINUE;
      ELSE
*/
      IF Feeder = SkipFeeder THEN
         CONTINUE;
      ELSE      
         FeederStatus = -1;
         FeederStation = 0;
         TraceEnabled = 0;
         SELECT :FeederStatus = S.CurrentlyOpen,
                :FeederStation = G2.Grouping
         FROM   Udb_Switch S,
                Udb_Grouping G1,
                Udb_Grouping G2
         WHERE  S.Object = G1.Member AND
                G1.Relationship = :Interaction$SourceBreaker AND
                G1.Grouping = :NetworkFeederList[i].Object AND
                G1.Member = G2.Member AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                    WHERE  SuperType = :Type$Substation);
         IF FeederStation <> 0 THEN

            SELECT :TraceEnabled = Feeder
            FROM   FMS_ConnectedSource
            WHERE  Feeder = :NetworkFeederList[i].Object;

         ENDIF;

         IF TraceEnabled > 0 THEN  /* Trace is enabled */

            RetCode = CALLPROC Connected3GSourceCutOutTrace (
                         Feeder = NetworkFeederList[i].Object);

            IF RetCode = 0 THEN  /* FeederIsEnergized */
               RetCode = PU_CANCEL;
               ENDLOOP;
            ENDIF;
              
         ELSEIF FeederStatus > -1 THEN
            IF FeederStatus = 0 THEN    /* CurrentlyOpen = FALSE, feeder is energized */
               RetCode = PU_CANCEL;
               ENDLOOP;
            ENDIF;
         ENDIF;
      ENDIF; 
   ENDFOR;
   RETURN(RetCode);
END;

