	Name:            PreloadEngine

/*
**
**      Copyright c 2000 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          PreloadEngine
**
**  Date:       Author   Description
** ----------------------------------
**  09/20/00	EM       Created
**  10/30/00    em       removed preferredstep = 1 from where clause
**  10/26/12    em       Incorporate multiple preloads.
**  11/26/12    em       On multiple preload, let new move screen handle
**                       putting two moves on the card.
**  10/03/17    em       Add option to save equipment so preload engine
**                       can be called twice for WorkPoint function
**
*/
PROCEDURE PreloadEngine 
(
   CardTypeOfCard = INTEGER NOT NULL;    /*Input TypeOfCard*/
   ScenarioDate = DATE NOT NULL;         /*Input Date*/
   Scenario	= INTEGER NOT NULL;      /*Input Scenario*/
   UserName     = VARCHAR(24) NOT NULL;  /*Input User*/
   SaveEquip = INTEGER NOT NULL WITH DEFAULT; /*Save Equipment Input Option*/
   
   PreloadJobs  = ARRAY OF Job;          /*OutPut List of Preload Jobs*/

   i 		= INTEGER NOT NULL WITH DEFAULT;  /*Counter*/
   RetCode      = INTEGER NOT NULL;      /*Return Code*/
) =
BEGIN
/*
** Load Jobs for the scenario and the equipment involved in the scenario.
*/
   i = 1;
   REPEATED
   SELECT  
   DISTINCT   
         :PreloadJobs[i].StepPair = JCC.StepPair,
         :PreloadJobs[i].PrintId = '',
         :PreloadJobs[i].EquipClassName = O.TypeName, 
         :PreloadJobs[i].EquipName = O.Name, 
         :PreloadJobs[i].Seq = JCC.Seq,     /* will be changed upon insertion*/
         :PreloadJobs[i].Job = -1,
         :PreloadJobs[i].JobClass = JCC.JobClass,
         :PreloadJobs[i].Equip = O.Object,
         :PreloadJobs[i].EquipClass = O.Type, 
         :PreloadJobs[i].Status = '',       /* equipment should be connected */
         :PreloadJobs[i].MoveType = JC.MoveType, 
         :PreloadJobs[i].MoveCategory = :MoveCategory$Normal,
         :PreloadJobs[i].TOMove = SQUEEZE(O.Description + ' ' + JC.TOMove + 
                                    ' - ' + O.Name),
         :PreloadJobs[i].RSMove = SQUEEZE(O.Description + ' ' + JC.RSMove + 
                                    ' - ' + O.Name),
         :PreloadJobs[i].TOMoveRules = JC.TOMoveRules,         
         :PreloadJobs[i].RSMoveRules = JC.RSMoveRules, 
         :PreloadJobs[i].Substation = O.PrimaryGrouping, 
         :PreloadJobs[i].MoveEquipClass = JCC.EquipClass,
         :PreloadJobs[i].MultiplePreload = PL.Multiple  
   FROM  FMS_JobClassControl JCC,
         FMS_JobClass JC,
         Udb_Object O,
         Udb_ExtendedType ET,          
         SOA_ScenarioEquip SE,
         FMS_Preload PL
   WHERE SE.UserName = :UserName AND
         SE.ScenarioDate = :ScenarioDate AND 
         SE.Equip = O.Object AND
         SE.EquipClass = ET.Type AND
         ET.SuperType = JCC.EquipClass AND
         JCC.TypeOfCard = :CardTypeOfCard AND
         JCC.JobClass = JC.JobClass AND
         JCC.JobClass = PL.JobClass AND
         PL.TypeOfCard = :CardTypeOfCard AND
         PL.CardClass = :Scenario AND
         PL.StepPair = JCC.StepPair AND
         PL.EquipClass = JCC.EquipClass
   BEGIN 
      i = i + 1;
   END;

   IF SaveEquip = FALSE THEN
      RetCode = CALLPROC SOA_ScenarioEquipDel (
                UserName = UserName,
                ScenarioDate = ScenarioDate);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error occurred removing Scenario Equipment from preload ' +
              'engine database table for UserName: ' + UserName + 
              ', Scenario Date: ' + VARCHAR(ScenarioDate) +
              '.  Please contact tech support so that the data can be ' +
              'deleted manually.  Scenario Load process will continue.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;      
END;

