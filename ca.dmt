	Name:            SelectEquipment

/* 
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    SubstationLogCard 
**  Frame:          SelectEquip
** 
**  Modification log: 
** 
**  Date:     Version     Description 
** -------------------------------------------------- 
**  12/07/94    pw        created
**  05/25/98    em        copied from SLC for Activity Log function
**  08/04/98    em        allow selection of NON equipment type
**  12/04/09    em        include Equipclass
*/ 
INITIALIZE   
(   
#   include StandardDeclarations	   
    Equip		= INTEGER NOT NULL;  /*Returned Equipment*/
) = 
/* 
** Load the data for the equipment selection from the database 
** into the 4GL environment and set up the display: 
*/ 
BEGIN 

   Selected.Equip = 0;   /* initialize to zero */
   Selected.EquipClassName = '';
   Selected.EquipClass = 0;
   Equip = 0;
END; 

ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   Selected = SelectEquip[];
END; 

/* 
**  Handle OK click  
*/ 
ON Click OK_Btn = 
BEGIN 

   IF Selected.Equip = 0 AND Selected.EquipClassName = '' THEN
      message 'You have not selected any equipment.';
      RESUME;
   ENDIF;
   Equip = Selected.Equip;
   RETURN (PU_OK);
END;

/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
BEGIN 
   RETURN (PU_CANCEL); 
END;

ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'FMS_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return (0);
END;


/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

