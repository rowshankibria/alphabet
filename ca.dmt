============================

	Name:            Check3GSwitchBlockOpen

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Check3GSwitchBlockOpen
**
**  Modification log:
**
**   02/07/11   em  Created
**   02/08/11   em  Extend to PendingStatus 
*/
PROCEDURE CHECK3GSwitchBlockOpen
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    Sw = INTEGER NOT NULL WITH DEFAULT;
    SwName = VARCHAR(80) NOT NULL WITH DEFAULT;                   

    i = INTEGER NOT NULL;              /* index */ 
    SwBlockOpen = INTEGER NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
)= 
BEGIN 
/*
** Make sure Job Equip has VisibleBreakFor relationship, we are looking toward
** the 3GSwitch for Block Open status.
*/ 
   RetCode = NULL;
   Sw = 0;
   REPEATED
   SELECT  :Sw = G.Grouping,
           :SwName = O.Name
   FROM    Udb_Grouping G,
           Udb_Object O
   WHERE   G.Member = :JIP.Equip AND
           G.Relationship = :Interaction$VisibleBreakFor AND
           G.Grouping = O.Object AND
           O.Type = :Type$3GSwitch;
         
   IF Sw = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GSwitchBlockOpen called from equipment that is not related ' +
                          'to a 3G Switch.');
      RETURN(RetCode);

   ELSE

      SwBlockOpen = 0;
      SELECT :SwBlockOpen = Object
      FROM   FMS_ObjectStatus
      WHERE  Object = :Sw AND
             Status = :Status$BO AND
             StatusCount > 0;  
   
      IF SwBlockOpen = 0 THEN      

         IF JIP.Status = Job$Restore THEN
            Operator = JIP.RSOperator;
         ELSE
            Operator = JIP.TOOperator;
         ENDIF;

         SELECT  :SwBlockOpen = Object
         FROM    FMS_PendingStatus 
         WHERE   PendingStatus = :Status$BO AND
                 StatusCount > 0 AND
                 IssuedOperator = :Operator;

         IF SwBlockOpen = 0 THEN      

              WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = '3G Switch ' + SwName + 
                           ' is not blocked open.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN (RetCode);
END;

