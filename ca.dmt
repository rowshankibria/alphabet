	Name:            EmailNotificationClass


���ph)x��Component Method Scripts
���ph)x��--------------------------
/*
**
**      Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          EmailNotificationClass
**
**  Description: 
**  EmailType:
**     1 - FMS card class change notification
**     2 - hipot update notification
**     3 - Ammeter result Update notification
**     4 - New feeder creation notification to staff
**     5 - New feeder notification to New Feeder Position
**     6 - ISWP pending or denied. OSWP denied.
**     7 - ISWP (CCTN & Trans Lines outside substation) approved.
**     8 - DOS Problem Reports (report from DO, online users and report monitor) to 
**     9 - ISWP NYISO Notification email
**     10- HTV Customer Crew Request to Energy Service Managers
**     11- ISWP Return Confirmation to Working Group
**     12- Restriction entered by District Operator
**     13- Warning on holiday dates
**     14- ISWP Request submitted to RCC
**     15- Relay Targets to Transmission Operator (TO)
**     16- Cap Bank Open to ACDO
**     17- HTV Breaker Status Change
**     18- Common Feeder Group Equipment report
**     19- Warning Backout Level Exceeded to ACDO
**     20- XA21 equipment update
**     21- Monthly Warning Backout per DO
**     22- MTA Contingency Analysis to ACDO
**     23- Possible relay mis-operation
**     24- DO Activity Threshold Exceeded
**     25- Two Op Override Review Rejection
**     26- Operating Step Update
**     27- Expired Registered Tag Report
**     28- Fault Correlation interface problem alert.
**     29- Email to Scheduling DO of HTV Picked Up or Dropped
**     
**     9999 - FMS problem reports.
**
**  Date:       Version Description
** ----------------------------------
**  05/05/09    YSP  Created.
**  11/20/09    ysp  Add DB Event queue for CSD after an email request is inserted.
**  12/28/09    ysp  Delete the CloseRequest method
**  01/27/10    ysp  Add Subject and Template columns
**  04/18/11    ysp  increase recipient to varchar(160)
**  07/09/13    ysp  Add RequestTimeChar attribute
**  12/17/15    ysp  Add support of attachments.
**  04/19/22    em   Add Expired Reg Tag Report
**  06/24/23    ysp  Add Fault Correlation interface problem alert
*/
METHOD InsertRequest (
)=
DECLARE
   i  = INTEGER NOT NULL;     /*Counter*/
   DBServer = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 0;
   SELECT :i = IFNULL(MAX(RequestID), 0)
   FROM   FMS_EmailNotification;
   
   CurObject.RequestID = i + 1;
   CurObject.RequestTime = DATE('now');

   RetCode = CALLPROC FMS_EmailNotificationIns(
                            RequestID = CurObject.RequestID,
                            RequestTime = CurObject.RequestTime,
                            EmailType = CurObject.EmailType,
                            Sender = CurObject.Sender,
                            Recipient = CurObject.Recipient,
                            Subject = CurObject.Subject,
                            Message1 = CurObject.Message1,
                            Message2 = CurObject.Message2,
                            Template = CurObject.Template);
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': EmailNotificationClass.InsertRequest; ' + 
                      'Failed to insert request ' + VARCHAR(CurObject.RequestID));
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Failed to insert email request';
      RETURN;
   ENDIF;
   
   FOR i = 1 TO CurObject.Attachments.LastRow DO
      CurObject.Attachments[i].RequestId = CurObject.RequestID;
      CurObject.Attachments[i].FileID = i;
      
      DBServer = CurObject.Attachments[i].InsertAttachment();
      IF DBServer = -1 THEN
         RetCode = CALLPROC FMS_EmailAttachmentDel(
                          RequestID = CurObject.RequestID,
                          FileID = i);
         CALLPROC DDB_COMMIT;
         MESSAGE 'Failed to save attachment ' + CurObject.Attachments[i].FileName + 
                 ' to the database.';
      ELSE
         RetCode = CALLPROC FMS_EmailAttachmentUpd (
                        RequestID = CurObject.RequestID,
                        FileID = i,
                        DBServer = DBServer);
         CALLPROC DDB_COMMIT;
      ENDIF;       
   ENDFOR;
   
   CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'FMS_EmailNotification',
                     EventText = VARCHAR(CurObject.RequestID));

END;

Application Component Report
============================

	Name:            EnDeEnCheck

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          EnDeEnCheck
**  OverView:       When the last cut out breaker move (as identified by moves 
**                  for breaker equipment which call PromptSetCurrentlyOpen) in
**                  the En-De-En substation is executed, we must check that all
**                  other cut out breaker in all substations on the card are 
**                  complete.
**                  Conversely, when breakers are being opened, we must make 
**                  sure that the first breaker opened on the card appears in
**                  the En-De-En substation.
**                   
**  Modifications:
**	02/01/96    jfl     Created 
**	06/21/96    jfl     Make this a standard precheck
**			    Implement check for restore moves: first
**			    closing breaker must be at EN-DE-EN substation
**      03/23/99    em      Incorporated into SOA.  Corrected bugs as identified
**                          in 4/24/98 email.  
**      05/03/99    em      Use Udb to determine Load Breaking equipment rather
**                          than jobs on the card, just in case a LoadBreaking
**                          device doesn't have a move on the card.
**                          Look at PendingStatus if initial check fails.
**      05/10/99    em      Split off from CheckEnDeEn
**      05/10/99    em      Reduced scope of grouping selects to limit breaker
**                          list to those appearing on lines on the card, not
**                          all breakers in each impacted substation.
**      05/10/99    em      To avoid cartesian product, build list of endeen 
**                          breakers which we can search to confirm inclusion. 
**      10/05/99    em      Added Pending Open Breakers to TakeOut Check
**      06/30/01    em      Before doing the EnDeEn check,
**                          perform a connectivity check from the current device
**                          to make sure it is not isolated from an ACLineSeg.
**                          If it is isolated (all paths open), we don't need 
**                          to check EnDeEn. 
**      02/05/03    em      Ignore CktSwer type devices (sub type under
**                          Load Breaking) in TakeOut code path
**      05/16/03    em      When evaluating other breakers, try to 
**                          ignore alternate spare breakers and include
**                          primary spare breakers.  Primary/Alternate is
**                          a line grouping member type.  
**                          Also exclude Ckt Interruptor.
**      02/22/05    em      When looking for other closed breakers in not EnDeEn
**                          stations, make sure the other breaker is within the 
**                          line scope of the card before presenting TakeOut warning
**                          that not all breakers are open.
**      09/01/06    em      Added Pending Status Count > 0 to SELECT
**      08/10/17    em      Special case breakers, If any of these breakers are open or pending open
**                          then exclude other breakers in substations to ignore.	 
**      09/30/19    em      When dual connected breakers exist, as in CORONA, only one of the two needs 
**                          to be open to satisfy the EnDeEn check logic.  To be applied for both takeout 
**                          and restore logic.
**      11/02/20    em      Add new CktSwer type to exclusion list
*/
PROCEDURE EnDeEnCheck
(
    Job = JobInProgress;                    /* Passed Job*/
    Card = INTEGER NOT NULL WITH DEFAULT;   /* Passed TFMS Card*/

    BreakerInStation = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    BreakerName = VARCHAR(40) NOT NULL WITH DEFAULT;
    BreakerPG = VARCHAR(40) NOT NULL WITH DEFAULT; /*Primary Grouping Name*/
    BreakerT = VARCHAR(40) NOT NULL WITH DEFAULT;  /*Type Name*/
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
    DualConnectedBreaker = INTEGER NOT NULL WITH DEFAULT;
    DualConnectedBreakerOpen = INTEGER NOT NULL WITH DEFAULT;
    EnDeEnBreakers = ARRAY OF INTEGEROBJECT; /*Breakers in EnDeEn*/
    EnDeEnBkrOpen = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    EnDeEnStation = INTEGER NOT NULL WITH DEFAULT; /*EN-DE-EN Substation*/
    i = INTEGER NOT NULL WITH DEFAULT;     /*COUNTER*/
    IgnoreSubstation = ARRAY OF INTEGEROBJECT; /*Special substations to ignore*/
    IgnoreWhereClause = VARCHAR(100) NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;     /*COUNTER*/
    OpenBreakers = ARRAY OF INTEGEROBJECT; /*List of open breakers on card*/
    OtherBreakers = ARRAY OF INTEGEROBJECT; /*Breakers in non-EnDeEn*/
    OtherBkrOpen = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    PendingOpenBreakers = ARRAY OF INTEGEROBJECT; /*Pend open breakers on card*/
    PendingStatus = INTEGER NOT NULL;       /*Pending open or Closed*/
    RetCode = INTEGER;             /* Code Returned by Warning frame */ 
    SpareBankBreaker = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    StationBreakers = ARRAY OF INTEGEROBJECT; /*Breakers in EnDeEn Station*/
    ObjectValue = INTEGER NOT NULL;  /* Object Holder for array insertion */
    ValidBreaker = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
) =
BEGIN
/* 
**  Perform a connectivity trace here to check if the current device is isolated
**  from an ACLineSegment on the Card.  
**  If it is, we don't need to perform the EnDeEn check
*/
    RetCode = CALLPROC IsolationTrace (
                          Equip = Job.Equip,
                          Card = Card,
                          IsolatedFromType = Type$ACLineSegment);
    IF RetCode = PU_CANCEL THEN
       RETURN (PU_OK);
    ENDIF;
/*
**  Determine the EN-DE-EN substation if there is one
*/
    EnDeEnStation = 0;
    SELECT DISTINCT EnDeEnStation = CTO.Object 
    FROM TFMS_CardToObject CTO
    WHERE CTO.Type = :Type$Substation AND
          CTO.Card = :Card AND
          CTO.EnDeEn = :TRUE;

    IF EnDeEnStation = 0 THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  Determine whether we are taking out or restoring the move to apply the 
**  appropriate check.
*/
    IF Job.Status = Job$Restore THEN 
/*
**  We are Restoring; we must make sure the first restore is in the EnDeEn
**  substation.  First, is this move taking place in the EnDeEn substation.
*/
       IF Job.Substation = EnDeEnStation THEN
          RETURN (PU_OK);
       ENDIF;
/*
**  Load list of all station breakers to avoid cartesian product when
**  confirming breaker is on line AND in EnDeEn station.
*/
       i = 1;
       StationBreakers.Clear();
       EnDeEnBkrOpen = FALSE;
       REPEATED
       SELECT   :StationBreakers[i].Value = G.Member
       FROM     Udb_Grouping G,
                Udb_ExtendedType ET
       WHERE    G.Grouping = :EnDeEnStation AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType = :Type$LoadBreaking
       ORDER BY 1
       BEGIN
/*
**  Want to make sure EnDeEn Station has at least one breaker on this
**  card.  If not, we will exit.
*/
          IF EnDeEnBkrOpen = FALSE THEN
             REPEATED
             SELECT   :EnDeEnBkrOpen = :TRUE
             FROM     Udb_Grouping G,
                      TFMS_CardToObject CTO
             WHERE    G.Member = :StationBreakers[i].Value AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Grouping = CTO.Object AND
                      CTO.Type = :Type$Line AND
                      CTO.Card = :Card;
          ENDIF;         
          i = i + 1;
       END;

       IF EnDeEnBkrOpen = FALSE THEN
          RETURN (PU_OK);
       ENDIF;
/*
**  Let's determine if the EnDeEn substation has a breaker that is closed.
**  If so, we are okay.  If not let's produce the warning.
*/
       EnDeEnBkrOpen = TRUE;
       REPEATED
       SELECT   :ObjectValue = G.Member
       FROM     Udb_Grouping G,
                Udb_ExtendedType ET,
                Udb_Switch S,
                TFMS_CardToObject CTO
       WHERE    CTO.Card = :Card AND
                CTO.Type = :Type$Line AND
                G.Grouping = CTO.Object AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType = :Type$LoadBreaking AND
                G.Member = S.Object AND
                S.CurrentlyOpen = :FALSE
       BEGIN
          BreakerInStation = FALSE;
          BreakerInStation = CALLPROC ArraySearch (
                            SearchArray = StationBreakers,
                            TargetObject = ObjectValue);
          IF BreakerInStation = TRUE THEN
             /* If this breaker has a dual peer breaker, the peer must also be closed */
             DualConnectedBreakerOpen = 0;
             SELECT :DualConnectedBreakerOpen = G.Grouping 
             FROM   Udb_Grouping G,
                    Udb_Switch S
             WHERE  G.Member = :ObjectValue AND
                    G.Relationship = :Interaction$DualConnectedWith AND
                    G.Grouping = S.Object AND
                    S.CurrentlyOpen = :TRUE;
                    
             IF DualConnectedBreakerOpen = 0 THEN
                EnDeEnBkrOpen = FALSE;                            
             ENDIF;
          ENDIF;
       END;
          
       IF EnDeEnBkrOpen = TRUE THEN /*All are still open*/
/*
**  Is there a pending close in the EnDeEn Station
*/
          PendingStatus = FALSE;
          REPEATED
          SELECT  :ObjectValue = G.Member
          FROM    Udb_Grouping G,
                  Udb_ExtendedType ET,
                  FMS_PendingStatus PS,
                  TFMS_CardToObject CTO
          WHERE   G.MemberType = ET.Type AND
                  ET.SuperType = :Type$LoadBreaking AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Grouping = CTO.Object AND
                  CTO.Type = :Type$Line AND
                  CTO.Card = :Card AND
                  G.Member = PS.Object AND
                  PS.IssuedOperator = :FO.Object AND
                  PS.StatusCount > 0 AND
                  PS.PendingStatus = :Status$Closed
          BEGIN
             IF PendingStatus = FALSE THEN
                BreakerInStation = FALSE;
                BreakerInStation = CALLPROC ArraySearch (
                            SearchArray = StationBreakers,
                            TargetObject = ObjectValue);
                IF BreakerInStation = TRUE THEN
                   /* If this breaker has a dual peer breaker, it must also be closed */
                   DualConnectedBreaker = 0;
                   DualConnectedBreakerOpen = 0;
                   SELECT :DualConnectedBreaker = G.Grouping 
                   FROM   Udb_Grouping G
                   WHERE  G.Member = :ObjectValue AND
                          G.Relationship = :Interaction$DualConnectedWith;
                          
                   IF DualConnectedBreaker > 0 THEN
                      DualConnectedBreakerOpen = TRUE; 
                   
                      SELECT :DualConnectedBreakerOpen  = 0
                      FROM   FMS_PendingStatus PS
                      WHERE  PS.Object = :DualConnectedBreaker AND
                             PS.IssuedOperator = :FO.Object AND
                             PS.StatusCount > 0 AND
                             PS.PendingStatus = :Status$Closed;
                   ENDIF;
 
                   IF DualConnectedBreakerOpen = 0 THEN
                      PendingStatus = TRUE;
                   ENDIF;
                ENDIF;
             ENDIF;
          END;

          IF PendingStatus = FALSE THEN
             RetCode = CALLFRAME Warning (Card = Job.Card, 
                                            Job = Job.Job,
                                            SwitchingItem = Job.SwitchingItem, 
                       Text = 'Breaker ' +
                              ' at EN-DE-EN Substation must be closed first. ' + 
                              'See Transmission card ' + VARCHAR(Card) + '.');
             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                RETURN(Warning$Overridden);
             ENDIF;
          ENDIF;

       ENDIF;

    ELSE
/*  
**  We are TakingOut; we must make sure that all cut outs are complete if
**  this is the last one in the EnDeEn substation.
*/
       IF Job.TOIssued IS NOT NULL THEN  /*Sanity Check*/
          RETURN (PU_OK);
       ENDIF;
/* 
**  Are we in the En-De-En substation?
*/     
       IF Job.Substation <> EnDeEnStation THEN
          RETURN (PU_OK);
       ENDIF;
/*
**  Get list of OpenBreakers for active objects on this card
*/
       i = 1;
       REPEATED 
       SELECT DISTINCT :OpenBreakers[i].Value = S.Object
       FROM     SOA_ActiveObject AO,
                Udb_Grouping G,
                Udb_ExtendedType ET,
                Udb_Switch S
       WHERE    AO.Card = :Card AND
                AO.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType IN (:Type$LoadBreaking,:Type$MODFdrInterlock) AND
                G.Member = S.Object AND
                S.CurrentlyOpen = :TRUE
       BEGIN 
          i = i + 1;
       END;
/*
**  Get list of Pending Open Breakers on this card
*/
       i = 1;
       REPEATED 
       SELECT DISTINCT :PendingOpenBreakers[i].Value = PS.Object
       FROM     SOA_ActiveObject AO,
                Udb_Grouping G,
                Udb_ExtendedType ET,
                FMS_PendingStatus PS
       WHERE    AO.Card = :Card AND
                AO.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType IN (:Type$LoadBreaking,:Type$MODFdrInterlock) AND
                G.Member = PS.Object AND
                PS.IssuedOperator = :FO.Object AND
                PS.StatusCount > 0 AND
                PS.PendingStatus = :Status$Open
       BEGIN 
          i = i + 1;
       END;
/*
**  Load list of all station breakers to avoid cartesian product when
**  confirming breaker is on line AND in EnDeEn station.
*/
       i = 1;
       StationBreakers.Clear();
       REPEATED
       SELECT   :StationBreakers[i].Value = G.Member
       FROM     Udb_Grouping G,
                Udb_ExtendedType ET
       WHERE    G.Grouping = :EnDeEnStation AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType = :Type$LoadBreaking
       ORDER BY 1
       BEGIN
          i = i + 1;
       END;
/*  
**  Is this the last breaker in the EnDeEn substation? Check for other
**  breaker equipment with status open.  Verify that
**  each one is open. If all are open, then we are opening the last one
**  and must perform the EnDeEn check to ensure all other breakers on this card
**  are open.
*/
       i = 1;
       REPEATED 
       SELECT DISTINCT  :ObjectValue = G.Member
       FROM     Udb_Grouping G,
                Udb_ExtendedType ET,
                TFMS_CardToObject CTO
       WHERE    G.MemberType = ET.Type AND
                ET.SuperType = :Type$LoadBreaking AND
                G.Relationship = :Interaction$MemberOf AND
                G.Grouping = CTO.Object AND
                CTO.Type = :Type$Line AND
                CTO.Card = :Card AND
                G.Member <> :Job.Equip
       BEGIN
          BreakerInStation = FALSE;
          BreakerInStation = CALLPROC ArraySearch (
                            SearchArray = StationBreakers,
                            TargetObject = ObjectValue);
          IF BreakerInStation = TRUE THEN
             EnDeEnBreakers[i].Value = ObjectValue;
             i = i + 1;
          ENDIF;
       END;

       EnDeEnBkrOpen = TRUE;   
       i = 1;
       WHILE i <= EnDeEnBreakers.LastRow() DO
          EnDeEnBkrOpen = CALLPROC ArraySearch (
                            SearchArray = OpenBreakers,
                            TargetObject = EnDeEnBreakers[i].Value);
          IF EnDeEnBkrOpen = FALSE THEN
/*
**  Check for Pending Open
*/
             EnDeEnBkrOpen = CALLPROC ArraySearch (
                            SearchArray = PendingOpenBreakers,
                            TargetObject = EnDeEnBreakers[i].Value);
                            
             IF EnDeEnBkrOpen = FALSE THEN
                /* Check if open or pending dual peer breaker.  If either dual peer is open then we are okay. */
                DualConnectedBreaker = 0;
                DualConnectedBreakerOpen = 0;
                SELECT :DualConnectedBreaker = G.Grouping 
                FROM   Udb_Grouping G
                WHERE  G.Member = :EnDeEnBreakers[i].Value AND
                       G.Relationship = :Interaction$DualConnectedWith;
                       
                IF DualConnectedBreaker = Job.Equip THEN
                   EnDeEnBkrOpen = TRUE;
                       
                ELSEIF DualConnectedBreaker > 0 THEN
                   DualConnectedBreakerOpen = CALLPROC ArraySearch (
                            SearchArray = OpenBreakers,
                            TargetObject = DualConnectedBreaker);
                   IF DualConnectedBreakerOpen = TRUE THEN
                      EnDeEnBkrOpen = TRUE;
                   ELSE
                      DualConnectedBreakerOpen = CALLPROC ArraySearch (
                            SearchArray = PendingOpenBreakers,
                            TargetObject = DualConnectedBreaker);
                      IF DualConnectedBreakerOpen = TRUE THEN
                         EnDeEnBkrOpen = TRUE;
                      ENDIF;
                   ENDIF;
                ENDIF;
                   
                IF EnDeEnBkrOpen = FALSE THEN                   
                   ENDLOOP;
                ENDIF;
             ENDIF;
          ENDIF;
          i = i + 1;
       ENDWHILE;
/*
**  If not all EnDeEn breakers are open, we can exit.
*/
       IF EnDeEnBkrOpen = FALSE THEN
          RETURN (PU_OK);
       ENDIF;
/*
**  We must be opening the last EnDeEn breaker, let's verify that all breakers
**  are open.  First get all breakers associated to objects on the card.
*/ 
       IgnoreSubstation.Clear();
       OtherBreakers.Clear();
       i = 1;
       j = 1;
       REPEATED 
       SELECT DISTINCT   :OtherBreakers[i].Value = G.Member
       FROM     SOA_ActiveObject AO,
                Udb_Grouping G,
                Udb_ExtendedType ET
       WHERE    AO.Card = :Card AND
                AO.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = ET.Type AND
                ET.SuperType IN (:Type$LoadBreaking,:Type$MODFdrInterlock) AND
                G.Member <> :Job.Equip 
       BEGIN
/*
** If Breaker is open, build a list of IgnoreSubstations if the Breaker is in the special case table.
*/
          OtherBkrOpen = FALSE;
          OtherBkrOpen = CALLPROC ArraySearch (
                            SearchArray = OpenBreakers,
                            TargetObject = OtherBreakers[i].Value);
          IF OtherBkrOpen = FALSE THEN
             OtherBkrOpen = CALLPROC ArraySearch (
                            SearchArray = PendingOpenBreakers,
                            TargetObject = OtherBreakers[i].Value);
          ENDIF;

          IF OtherBkrOpen = TRUE THEN
             SELECT :IgnoreSubstation[j].Value = Substation
             FROM   SOA_EnDeEnSpecial
             WHERE  Breaker = :OtherBreakers[i].Value
             BEGIN
                j = j + 1;
             END;
          ENDIF;
          i = i + 1;
       END;
/*
** Build IgnoreSubstation Where Clause
*/
       IgnoreWhereClause = '';
       IF IgnoreSubstation.LastRow > 0 THEN
          FOR i = 1 TO IgnoreSubstation.LastRow DO
             IF i = 1 THEN
                IgnoreWhereClause = '(' + VARCHAR(IgnoreSubstation[i].Value);
             ELSE
                IgnoreWhereClause = IgnoreWhereClause + ',' + VARCHAR(IgnoreSubstation[i].Value);
             ENDIF;
          ENDFOR;
          IgnoreWhereClause = IgnoreWhereClause + ')';
       ENDIF;

       i = OtherBreakers.Lastrow;
       WHILE i >= 1 DO  
/*
** Now start excluding ones that don't belong...
** Ignore breakers in the EnDeEn.
** Ignore breakers that are not on a line on the card.
** Ignore CktSwer and Ckt Interrupt
** Ignore alternate spare bank breakers
** Ignore breakers in special IgnoreSubsation array. 
*/        
          ValidBreaker = 1;
          SELECT  :ValidBreaker = 0 
          FROM    Udb_Grouping 
          WHERE   Grouping = :EnDeEnStation AND
                  Relationship = :Interaction$MemberOf AND
                  Member = :OtherBreakers[i].Value;

          IF ValidBreaker = 0 THEN  /* This device is in the EnDeEn */
             OtherBreakers.RemoveRow (RowNumber = i);
          ELSE 

             ValidBreaker = 0;
             REPEATED
             SELECT  :ValidBreaker = 1
             FROM    Udb_Grouping G,
                     TFMS_CardToObject CTO
             WHERE   G.Member = :OtherBreakers[i].Value AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Grouping = CTO.Object AND
                     CTO.Type = :Type$Line AND
                     CTO.Card = :Card;

             IF ValidBreaker = 0 THEN  /* This device is not in line scope */
                OtherBreakers.RemoveRow (RowNumber = i);
             ELSE 

                REPEATED
                SELECT  :ValidBreaker  = 0
                FROM    Udb_ExtendedType ET,
                        Udb_Object O
                WHERE   O.Object = :OtherBreakers[i].Value AND
                        O.Type = ET.Type AND
                        ET.SuperType IN (:Type$CktSwer,
                                         :Type$CktSwerNew,
                                         :Type$CktInterrupt);

                IF ValidBreaker = 0 THEN  /* This device is not right type */
                   OtherBreakers.RemoveRow (RowNumber = i);
                ELSE
/*
** remove from list if in an ignore station
*/
                   j = 0;
                   IF IgnoreWhereClause <> '' THEN
                      DynamicWhereClause = 'Member = ' + VARCHAR(OtherBreakers[i].Value) + ' AND ' +
                                           'Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                                           'Grouping IN ' + IgnoreWhereClause;
                      SELECT :j = Grouping
                      FROM   Udb_Grouping
                      WHERE  :DynamicWhereClause;

                      IF j > 0 THEN
                         OtherBreakers.RemoveRow (RowNumber = i);
                      ENDIF;
                   ENDIF;
/*
** Determine if a spare bank breaker
*/
                   IF j = 0 THEN

                   SpareBankBreaker = 0;
                   REPEATED
                   SELECT  :SpareBankBreaker  = 1
                   FROM    Udb_ExtendedType ET,
                           Udb_Object O
                   WHERE   O.Object = :OtherBreakers[i].Value AND
                           O.Type = ET.Type AND
                           ET.SuperType IN 
                               (:Type$BkrSpare, 
                                :Type$BkrROSpare);
             
                   IF SpareBankBreaker = 1 THEN
/*
** If it is a primary Spare Bank Breaker on a line on the card, then
** we include it, otherwise it is an alternate and we exclude.  Primary/
** Alternate is a awkward thing using letter matching in the type name.
*/              
                      SpareBankBreaker = 0;
                      REPEATED 
                      SELECT   :SpareBankBreaker = 1
                      FROM     SOA_ActiveObject AO,
                               Udb_Grouping G,
                               Udb_Type T
                      WHERE    AO.Card = :Card AND
                               AO.Object = G.Grouping AND
                               G.GroupingType = :Type$Line AND
                               G.Relationship = :Interaction$MemberOf AND
                               G.MemberType = T.Type AND
                               UPPERCASE(T.Name) LIKE '%PRI%' AND
                               G.Member = :OtherBreakers[i].Value;

                      IF SpareBankBreaker = 0 THEN 
                         OtherBreakers.RemoveRow (RowNumber = i);
                      ENDIF;
                   ENDIF;
                   ENDIF; /* IF j = 0 */
                ENDIF;
             ENDIF;
          ENDIF;
          i = i - 1;
       ENDWHILE;
/*
** If Other Breaker is not open, produce warning
*/
       OtherBkrOpen = TRUE;   
       i = 1;
       WHILE i <= OtherBreakers.LastRow() DO
          OtherBkrOpen = CALLPROC ArraySearch (
                            SearchArray = OpenBreakers,
                            TargetObject = OtherBreakers[i].Value);
          IF OtherBkrOpen = FALSE THEN
/*
**  Check if the Open is Pending for this breaker
*/
             PendingStatus = FALSE;
             PendingStatus = CALLPROC ArraySearch (
                            SearchArray = PendingOpenBreakers,
                            TargetObject = OtherBreakers[i].Value);
             IF PendingStatus = FALSE THEN
                SELECT :BreakerName = Name,
                       :BreakerPG = PrimaryGroupingName,
                       :BreakerT = TypeName
                FROM   Udb_Object
                WHERE  Object = :OtherBreakers[i].Value;
                ENDLOOP;
             ELSE
                OtherBkrOpen = TRUE;
             ENDIF;
          ENDIF;
          i = i + 1;
       ENDWHILE;

       IF OtherBkrOpen = FALSE THEN
          RetCode = CALLFRAME Warning (Card = Job.Card, 
                                            Job = Job.Job,
                                            SwitchingItem = Job.SwitchingItem, 
             Text = 'Breaker ' + BreakerPG + ' ' + 
                     BreakerT + ' ' + BreakerName +
                    ' at another Substation (not the En-De-En) is not open.' +
                    '  See Transmission Card ' + Varchar(Card) + '.');
          IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RETURN(Warning$Overridden);
          ENDIF;

       ENDIF;       

    ENDIF;

    RETURN (PU_OK);

END;

Application Component Report
============================

	Name:            EquipClass_ASE


Component Method Scripts
--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      Pateric Software LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          EquipClass_ASE
**
**  Date:       Version Description
** ----------------------------------
**  03/21/05    ysp     Created; 
**  04/06/05    ysp     Order the grouping history by transfer time.
**  04/07/05    ysp     If a substation equipment, set th grouping type (OwnerNumber)
**                      to Substation.
**  05/26/05    ysp     Add method GetRRTypeName
**  11/11/21    ysp     Add GroupingFilter2 attribute
**  11/26/25    ysp     Increase generic equipment search limit to 10000. We still don't want users to 
**                      look up any equipment without some specific knowledge of the equipment.
*/ 
METHOD LoadEquipByFilters(
)=
DECLARE
   i = INTEGER NOT NULL;

   FeederEquip = INTEGER NOT NULL WITH DEFAULT;
   NameFilter  = VARCHAR(40);        /* Equipment name filter */
   GroupingName = VARCHAR(40) NOT NULL WITH DEFAULT;
   GroupingList = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to search all equipment that
** matches the search criteria.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.SearchOption = 1 THEN      /* begins with */
      NameFilter = UPPERCASE(CurObject.EquipFilter) + '%';
   ELSEIF CurObject.SearchOption = 2 THEN  /* contains */
      NameFilter = '%' + UPPERCASE(CurObject.EquipFilter) + '%';
   ELSE
      NameFilter = UPPERCASE(CurObject.EquipFilter);
   ENDIF;

   CurObject.EList.Clear();

   IF  CurObject.GroupingFilter > 0 OR CurObject.GroupingFilter2 > 0 THEN
      IF CurObject.TypeFilter = 0 THEN
         i = 1;
         SELECT :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName,
                :CurObject.EList[i].Equip = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClassName = T.Name,
                :CurObject.EList[i].InService = O.InService,
                :CurObject.EList[i].OutService = O.OutService
         FROM   Udb_Grouping G,
                Udb_Object O, 
                Udb_Type T
         WHERE  G.Grouping IN (:CurObject.GroupingFilter, :CurObject.GroupingFilter2) AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Member = O.Object AND
                O.Name LIKE :NameFilter AND
                UPPER(O.TypeName) NOT LIKE '%OBSOLETE%' AND
                O.Type = T.Type
         ORDER BY EquipName, EquipClassName, PrimaryGroupingName
         BEGIN
            i = i + 1;
         END;
      ELSE
         i = 1;
         SELECT :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName,
                :CurObject.EList[i].Equip = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClassName = T.Name,
                :CurObject.EList[i].InService = O.InService,
                :CurObject.EList[i].OutService = O.OutService
         FROM   Udb_Grouping G,
                Udb_Object O,
                Udb_Type T
         WHERE  G.Grouping IN (:CurObject.GroupingFilter, :CurObject.GroupingFilter2) AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Member = O.Object AND
                O.Name LIKE :NameFilter AND
                UPPER(O.TypeName) NOT LIKE '%OBSOLETE%' AND
                O.Type IN (SELECT ET.Type 
                           FROM   Udb_ExtendedType ET, 
                                  IR_TypeTranslation TT 
                           WHERE  TT.RRType =  :CurObject.TypeFilter AND
                                  TT.Type = ET.SuperType) AND
                O.Type = T.Type
         ORDER BY EquipName, EquipClassName, PrimaryGroupingName
         BEGIN
            i = i + 1;
         END;
      ENDIF;   
   ELSE
      IF CurObject.TypeFilter = 0 THEN
         i = 1;
         SELECT :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName,
                :CurObject.EList[i].Equip = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClassName = T.Name,
                :CurObject.EList[i].InService = O.InService,
                :CurObject.EList[i].OutService = O.OutService
         FROM   Udb_Object O, 
                Udb_Type T
         WHERE  O.Name LIKE :NameFilter AND
                UPPER(O.TypeName) NOT LIKE '%OBSOLETE%' AND
                O.Type = T.Type
         ORDER BY EquipName, EquipClassName, PrimaryGroupingName
         BEGIN
            i = i + 1;
         END;
      ELSE
         i = 1;
         SELECT :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName,
                :CurObject.EList[i].Equip = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClassName = T.Name,
                :CurObject.EList[i].InService = O.InService,
                :CurObject.EList[i].OutService = O.OutService
         FROM   Udb_Object O,
                Udb_Type T
         WHERE  O.Name LIKE :NameFilter AND
                UPPER(O.TypeName) NOT LIKE '%OBSOLETE%' AND
                O.Type IN (SELECT ET.Type 
                           FROM   Udb_ExtendedType ET, 
                                  IR_TypeTranslation TT 
                           WHERE  TT.RRType =  :CurObject.TypeFilter AND
                                  TT.Type = ET.SuperType) AND
                O.Type = T.Type
         ORDER BY EquipName, EquipClassName, PrimaryGroupingName
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.EList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matched equipment found in database.';
   ELSEIF CurObject.EList.LastRow() > 10000 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'There are ' + varchar(CurObject.EList.LastRow) + ' pieces of equipment ' +
           'that match the criteria. Please be more specific with the search criteria.';   
   ENDIF;

/*
** Find the lines, feeders, substation and divisions the equipment belongs to.
** Use OwnerNumber attribute to indicate the type of grouping.
*/
   FOR i = 1 TO CurObject.EList.LastRow() DO
       GroupingList = '';
       GroupingName = '';

       /* 
       ** if the equipment is a member of feeders
       */
       REPEATED
       SELECT :GroupingName = O.Name
       FROM   Udb_Object O, 
                 Udb_Grouping G 
       WHERE  G.Member = :CurObject.EList[i].Equip AND
                 G.Relationship = :Interaction$Memberof AND
                 G.GroupingType IN (SELECT  Type 
                                    FROM    Udb_ExtendedType
                                    WHERE   SuperType = :Type$Feeder) AND 
                 G.Grouping = O.Object AND
                 O.Name != VARCHAR(O.Object)
       BEGIN
              IF GroupingList = '' THEN
                 GroupingList = GroupingName;
              ELSE
                 GroupingList = GroupingList + ',' + GroupingName;
              ENDIF;
       END;
       IF GroupingList != '' THEN
             CurObject.EList[i].PrimaryGroupingName = GroupingList;
             CurObject.EList[i].OwnerNumber = 'Feeder';
             CONTINUE;
       ENDIF;

       /*
       ** if the equipment is a member of transmission lines
       */
       REPEATED
       SELECT :GroupingName = O.Name
       FROM   Udb_Object O, 
                 Udb_Grouping G 
       WHERE  G.Member = :CurObject.EList[i].Equip AND
                 G.Relationship = :Interaction$Memberof AND
                 G.GroupingType = :Type$LINE AND 
                 G.Grouping = O.Object
       BEGIN
              IF GroupingList = '' THEN
                 GroupingList = GroupingName;
              ELSE
                 GroupingList = GroupingList + ',' + GroupingName;
              ENDIF;
       END;
       IF GroupingList != '' THEN
             CurObject.EList[i].PrimaryGroupingName = GroupingList;
             CurObject.EList[i].OwnerNumber = 'Line';
             CONTINUE;
       ENDIF;

       /*
       ** if the equipment is a mumber of a substation
       */
        REPEATED
        SELECT :GroupingName = O.Name
        FROM   Udb_Object O, 
                 Udb_Grouping G 
        WHERE  G.Member = :CurObject.EList[i].Equip AND
                 G.Relationship = :Interaction$Memberof AND
                 G.GroupingType IN (SELECT  Type 
                                    FROM    Udb_ExtendedType
                                    WHERE   SuperType = :Type$Substation) AND 
                 G.Grouping = O.Object;
       IF GroupingName != '' THEN
             CurObject.EList[i].PrimaryGroupingName = GroupingName;
             CurObject.EList[i].OwnerNumber = 'Substation';
             CONTINUE;
       ENDIF;
       /*
       ** IF NEW/DROP Bank
       */
       IF (CurObject.EList[i].InService IS NULL AND CurObject.EList[i].OutService IS NULL) OR    /* New Equipment or substation equip*/
          CurObject.EList[i].OutService IS NOT NULL THEN   /* dropped equipment */
          
          FeederEquip = 0;
          REPEATED 
          SELECT :FeederEquip = 1,
                 :CurObject.EList[i].PrimaryGroupingName = O.Name
          FROM   Udb_Object O, 
                 Udb_Grouping G 
          WHERE  G.Member = :CurObject.EList[i].Equip AND
                 G.Relationship = :Interaction$Memberof AND
                 G.GroupingType = :Type$Division AND
                 G.Grouping = O.Object;

          IF FeederEquip = 0 THEN
             CurObject.EList[i].OwnerNumber = 'Substation';

          ELSEIF CurObject.EList[i].OutService IS NOT NULL THEN 
             CurObject.EList[i].OwnerNumber = 'Drop Bank';

          ELSE
             CurObject.EList[i].OwnerNumber = 'New Bank';
          ENDIF;
       ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
   RETURN;
END;

METHOD LoadEquipDetails(
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to search all equipment that
** matches the search criteria.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
** We are going to use the first element of the array
** to store the details of the equipment.
*/
   CurObject.EList.Clear();

   REPEATED
   SELECT :CurObject.EList[1].Equip = O.Object,
          :CurObject.EList[1].EquipClass = O.Type,
          :CurObject.EList[1].EquipClassName = T.Name,
          :CurObject.EList[1].EquipName = O.Name,
          :CurObject.EList[1].ObjectDescription = O.Description,
          :CurObject.EList[1].EquipComment = O.Comment,
          :CurObject.EList[1].PrimaryGrouping = O.PrimaryGrouping
   FROM   Udb_Object O,
          Udb_Type T
   WHERE  O.Object = :CurObject.Object AND
          O.Type = T.Type;

   /* not all equipment has location information */
   REPEATED
   SELECT :CurObject.EList[1].Address1 = L.L1,
          :CurObject.EList[1].Address2 = L.L2,
          :CurObject.EList[1].Address3 = L.L3,
          :CurObject.EList[1].Address4 = L.L4,
          :CurObject.EList[1].LocationComment = L.Comment
   FROM   Udb_Grouping GL,
          Udb_Location L
   WHERE  GL.Member = :CurObject.Object AND
          GL.Relationship = :Interaction$LocatedWith AND
          GL.Grouping = L.Object;
   CALLPROC DDB_ROLLBACK;           

   IF CurObject.EList.LastRow = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Information could not be found for the selected equipment.';
      RETURN;
   ENDIF;

/*
** Get memberships.
*/
   i = 1;
   REPEATED
   SELECT    :CurObject.EList[1].GList[i].Relationship = G.RelationShip,
             :CurObject.EList[1].GList[i].RelationshipName = T.Name,
             :CurObject.EList[1].GList[i].Grouping = G.Grouping,
             :CurObject.EList[1].GList[i].GroupingType = G.GroupingType,
             :CurObject.EList[1].GList[i].Member = G.Member,
             :CurObject.EList[1].GList[i].MemberType = G.MemberType
   FROM      Udb_Grouping G,
             Udb_Type T
   WHERE     G.Member = :CurObject.Object AND
             G.RelationShip = T.Type
   BEGIN
      SELECT  :CurObject.EList[1].GList[i].GO.Object = GO.Object,
              :CurObject.EList[1].GList[i].GO.BaseType = GO.BaseType,
              :CurObject.EList[1].GList[i].GO.Type = GO.Type,
              :CurObject.EList[1].GList[i].GO.PrimaryGrouping = GO.PrimaryGrouping,
              :CurObject.EList[1].GList[i].GO.TypeName = GO.TypeName,
              :CurObject.EList[1].GList[i].GO.Name = GO.Name,
              :CurObject.EList[1].GList[i].GO.PrimaryGroupingName = GO.PrimaryGroupingName
      FROM    Udb_Object GO
      WHERE   GO.Object = :CurObject.EList[1].GList[i].Grouping;

      IF CurObject.EList[1].GList[i].Grouping = CurObject.EList[1].PrimaryGrouping AND
         CurObject.EList[1].GList[i].Relationship = :Interaction$MemberOf THEN
         CurObject.EList[1].GList[i].Primary = 1;
      ELSE
         CurObject.EList[1].GList[i].Primary = 0;
      ENDIF;

      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD LoadGroupingHistory(
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to select the grouping history for the equipment
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** We are going to use the first element of the array
** to store the details of the equipment.
*/
   CurObject.EList.Clear();
   i = 1;
   REPEATED
   SELECT  :CurObject.EList[1].HList[i].RelationshipName = T1.Name,
           :CurObject.EList[1].HList[i].GroupingTypeName = G.GroupingTypeName,
           :CurObject.EList[1].HList[i].TransferTime = G.TransferTime,
           :CurObject.EList[1].HList[i].GroupingName = G.GroupingName
   FROM    Udb_GroupingHistory G,
           Udb_Type T1
   WHERE   G.Member = :CurObject.Object AND
           G.Relationship = T1.Type
   ORDER BY TransferTime DESC
   BEGIN
           i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
END;

METHOD GetRRTypeName(
   EquipType = INTEGER NOT NULL WITH DEFAULT; // optional
)=
DECLARE
   EquipClass        = INTEGER NOT NULL WITH DEFAULT;
   RRType            = INTEGER NOT NULL WITH DEFAULT;
   RRName            = VARCHAR(40) NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   IF EquipType = 0 THEN
      SELECT :EquipClass = Type
      FROM   UDB_Object
      WHERE  Object = :CurObject.Object;
   ELSE
      EquipClass = EquipType;
   ENDIF;
   RRType = 0;

   WHILE EquipClass <> 0 DO
      SELECT :RRType = T.Type,
             :RRName = T.Name             
      FROM   IR_TypeTranslation TT,
             Udb_Type T
      WHERE  TT.Type = :EquipClass AND
             TT.RRType = T.Type;
   
      IF RRType <> 0 THEN
         ENDLOOP;
      ELSE
         SELECT :EquipClass = SuperType
         FROM   Udb_SuperType 
         WHERE  Type = :EquipClass;
      ENDIF;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;
   
   RETURN RRName;
END;

METHOD LoadCircuitByFilters(
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   CircuitFilter = VARCHAR(40) NOT NULL WITH DEFAULT;
   StationFilter = VARCHAR(40)NOT NULL WITH DEFAULT;   
   FeederFilter = VARCHAR(40)NOT NULL WITH DEFAULT;   
   LineTypeFilter = VARCHAR(40)NOT NULL WITH DEFAULT;   
       
   GroupingInfo = ARRAY of ObjectClass; 
   SubTypeOfStation = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to search all equipment that
** matches the search criteria.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.CircuitFilter = '' THEN
      CircuitFilter = '%';
   ELSE
      IF CurObject.SearchOption = 1 THEN      /* begins with */
         CircuitFilter = UPPERCASE(CurObject.CircuitFilter) + '%';
      ELSEIF CurObject.SearchOption = 2 THEN  /* contains */
         CircuitFilter = '%' + UPPERCASE(CurObject.CircuitFilter) + '%';
      ELSE
         CircuitFilter = UPPERCASE(CurObject.CircuitFilter);
      ENDIF;
   ENDIF;

   IF CurObject.StationFilter = '' THEN
      StationFilter = '%';
   ELSE
      IF CurObject.SearchOption = 1 THEN      /* begins with */
         StationFilter = UPPERCASE(CurObject.StationFilter) + '%';
      ELSEIF CurObject.SearchOption = 2 THEN  /* contains */
         StationFilter = '%' + UPPERCASE(CurObject.StationFilter) + '%';
      ELSE
         StationFilter = UPPERCASE(CurObject.StationFilter);
      ENDIF;
   ENDIF;

   IF CurObject.FeederFilter = '' THEN
      FeederFilter = '%';
   ELSE
      IF CurObject.SearchOption = 1 THEN      /* begins with */
         FeederFilter = UPPERCASE(CurObject.FeederFilter) + '%';
      ELSEIF CurObject.SearchOption = 2 THEN  /* contains */
         FeederFilter = '%' + UPPERCASE(CurObject.FeederFilter) + '%';
      ELSE
         FeederFilter = UPPERCASE(CurObject.FeederFilter);
      ENDIF;
   ENDIF;

   IF CircuitFilter = '%' AND 
      StationFilter = '%' AND 
      FeederFilter = '%' AND 
      CurObject.LineTypeFilter = Type$TelCircuit THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'You must enter some search criteria';
      RETURN;
   ENDIF; 

   CurObject.CList.Clear();

      IF (FeederFilter = '%') THEN
      /*
      **  Select ALL circuits and do not join on the feeder grouping
      */
      i = 1;
      REPEATED
      SELECT DISTINCT
             :CurObject.CList[i].Circuit = O.Object,
             :CurObject.CList[i].LineNumber = O.Name,
             :CurObject.CList[i].LineType = O.Type,
             :CurObject.CList[i].LineTypeName = O.TypeName,
             :CurObject.CList[i].RouteName = T.Name,
             :CurObject.CList[i].Route = T.Type
      FROM   Udb_Object O,               /* circuit */
             Udb_Grouping G,             /* circuit grouped to station */
             Udb_Object O1,
             Udb_CircuitRoute R,
             Udb_Type T
      WHERE   O.Name like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                         FROM    Udb_ExtendedType
                         WHERE   SuperType = :CurObject.LineTypeFilter)
      AND     O.Object = G.Member
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.GroupingType IN ( SELECT  Type
                                 FROM    Udb_ExtendedType
                                 WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
      AND     G.Grouping = O1.Object
      AND     O1.Name like :StationFilter
      AND     O.Object = R.Object
      AND     R.Route = T.Type
      ORDER BY Circuit
      BEGIN
      /*
      **  Get all of the grouping info and concatenate it into 
      **  the substation and feeder fields
      */
         GroupingInfo.Clear();
         j = 1;
         REPEATED
         SELECT  :GroupingInfo[j].Object = G.Grouping,
                 :GroupingInfo[j].Type = G.GroupingType,
                 :GroupingInfo[j].Name = O.Name
         FROM    Udb_Grouping G,
                 Udb_Object O
         WHERE   G.Member = :CurObject.CList[i].Circuit
         AND     G.Relationship = :Interaction$MemberOf
         AND     G.GroupingType <> :Type$TelCardGrouper
         AND     G.GroupingType <> :Type$Division
         AND     G.Grouping = O.Object
         BEGIN
             j = j + 1;
         END;
         CALLPROC DDB_ROLLBACK;

         j = 1;
         WHILE (j <= GroupingInfo.LastRow()) DO
             SubTypeOfStation  = 0;
             SELECT SubTypeOfStation = 1
             FROM   Udb_ExtendedType
             WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
             AND    Type = :GroupingInfo[j].Type;
             CALLPROC DDB_ROLLBACK;

             IF (SubTypeOfStation = 1) THEN
                 IF (CurObject.CList[i].SubstationNames = '') THEN
                     CurObject.CList[i].SubstationNames = GroupingInfo[j].Name;
                 ELSE
                     CurObject.CList[i].SubstationNames = CurObject.CList[i].SubstationNames+', '+GroupingInfo[j].Name;
                 ENDIF;
             ELSE
                 IF (CurObject.CList[i].FeederNames = '') THEN
                     CurObject.CList[i].FeederNames = GroupingInfo[j].Name;
                 ELSE
                     CurObject.CList[i].FeederNames = CurObject.CList[i].FeederNames+', '+GroupingInfo[j].Name;
                 ENDIF;
             ENDIF;
             j = j + 1;
         ENDWHILE;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

   ELSE
      /*
      **  Select ONLY those circuits which have a grouping with a feeder
      */
      i = 1;
      REPEATED
      SELECT DISTINCT
             :CurObject.CList[i].Circuit = O.Object,
             :CurObject.CList[i].LineNumber = O.Name,
             :CurObject.CList[i].LineType = O.Type,
             :CurObject.CList[i].LineTypeName = O.TypeName,
             :CurObject.CList[i].RouteName = T.Name,
             :CurObject.CList[i].Route = T.Type
      FROM    Udb_Object O,               /* circuit */
             Udb_Grouping G,             /* circuit grouped to station */
             Udb_Object O1,              /* substation */
             Udb_Grouping G1,            /* circuit grouped to feeder */
             Udb_Object O2,
             Udb_CircuitRoute R,
             Udb_Type T
      WHERE   O.Name like :CircuitFilter
      AND     O.Type IN ( SELECT  Type
                         FROM    Udb_ExtendedType
                         WHERE   SuperType = :CurObject.LineTypeFilter)
      AND     O.Object = G.Member
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.GroupingType IN ( SELECT  Type
                                 FROM    Udb_ExtendedType
                                 WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
      AND     G.Grouping = O1.Object
      AND     O1.Name like :StationFilter
      AND     O.Object = G1.Member
      AND     G1.Relationship = :Interaction$MemberOf
      AND     G1.GroupingType IN (SELECT  Type
                                 FROM    Udb_ExtendedType
                                 WHERE   Supertype IN (:Type$Line,:Type$Feeder,
                                                       :Type$Network,:Type$DivisionWorkstation))
      AND     G1.Grouping = O2.Object
      AND     O2.Name like :FeederFilter
      AND     O.Object = R.Object
      AND     R.Route = T.Type
      ORDER BY Circuit
      BEGIN
      /*
      **  Get all of the grouping info and concatenate it into 
      **  the substation and feeder fields
      */
         GroupingInfo.Clear();
         j = 1;
         REPEATED
         SELECT  :GroupingInfo[j].Object = G.Grouping,
                 :GroupingInfo[j].Type = G.GroupingType,
                 :GroupingInfo[j].Name = O.Name
         FROM    Udb_Grouping G,
                 Udb_Object O
         WHERE   G.Member = :CurObject.CList[i].Circuit
         AND     G.Relationship = :Interaction$MemberOf
         AND     G.GroupingType <> :Type$TelCardGrouper
         AND     G.GroupingType <> :Type$Division
         AND     G.Grouping = O.Object
         BEGIN
             j = j + 1;
         END;
         CALLPROC DDB_ROLLBACK;

         j = 1;
         WHILE (j <= GroupingInfo.LastRow()) DO
             SubTypeOfStation = 0;
             SELECT SubTypeOfStation = 1
             FROM   Udb_ExtendedType
             WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
             AND    Type = :GroupingInfo[j].Type;
             CALLPROC DDB_ROLLBACK;

             IF (SubTypeOfStation = 1) THEN
                 IF (CurObject.CList[i].SubstationNames = '') THEN
                     CurObject.CList[i].SubstationNames = GroupingInfo[j].Name;
                 ELSE
                     CurObject.CList[i].SubstationNames = CurObject.CList[i].SubstationNames+', '+GroupingInfo[j].Name;
                 ENDIF;
             ELSE
                 IF (CurObject.CList[i].FeederNames = '') THEN
                     CurObject.CList[i].FeederNames = GroupingInfo[j].Name;
                 ELSE
                     CurObject.CList[i].FeederNames = CurObject.CList[i].FeederNames+', '+GroupingInfo[j].Name;
                 ENDIF;
             ENDIF;
             j = j + 1;
         ENDWHILE;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   IF CurObject.CList.LastRow > 1 THEN
       i = 2;
       WHILE i <= CurObject.CList.LastRow DO
          IF CurObject.CList[i -1].Circuit = CurObject.CList[i].Circuit THEN
             CurObject.CList.RemoveRow(RowNumber = i);
          ELSE
             i = i + 1;
          ENDIF; 
       ENDWHILE;
    ENDIF;
END; 

METHOD LoadCircuitDetails(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RouteName = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   **  Get the information for the current circuit
   */    
   REPEATED
   SELECT  :CurObject.CircuitDetail.CircuitInfo.Object = O.Object,
           :CurObject.CircuitDetail.CircuitInfo.Name = O.Name,
           :CurObject.CircuitDetail.CircuitInfo.Description = O.Description,
           :CurObject.CircuitDetail.CircuitInfo.Type = O.Type,
           :CurObject.CircuitDetail.CircuitInfo.TypeName = O.TypeName,
           :CurObject.CircuitDetail.CircuitInfo.PrimaryGrouping = O.PrimaryGrouping,
           :CurObject.CircuitDetail.CircuitInfo.PrimaryGroupingName = O.PrimaryGroupingName,
           :CurObject.CircuitDetail.CircuitInfo.Comment = O.Comment,
           :CurObject.CircuitDetail.CircuitInfo.Validated = O.Validated,
           :CurObject.CircuitDetail.CircuitInfo.ValidatedBy = O.ValidatedBy,
           :CurObject.CircuitDetail.CircuitInfo.Inservice = O.Inservice,
           :CurObject.CircuitDetail.CircuitInfo.Outservice = O.Outservice,
           :CurObject.CircuitDetail.CircuitInfo.PositionX = O.PositionX,
           :CurObject.CircuitDetail.CircuitInfo.PositionY = O.PositionY,
           :CurObject.CircuitDetail.CircuitInfo.OwnerNumber = O.OwnerNumber,
           :CurObject.CircuitDetail.CircuitInfo.SerialNumber = O.SerialNumber,
           :CurObject.CircuitDetail.CircuitInfo.SpecNumber = O.SpecNumber,
           :CurObject.CircuitDetail.CircuitInfo.Combination = O.Combination,
           :CurObject.CircuitDetail.CircuitInfo.LockNumber = O.LockNumber,
           :CurObject.CircuitDetail.CircuitInfo.LastChanged = O.LastChanged,
           :CurObject.CircuitDetail.CircuitInfo.LastChangedBy = O.LastChangedBy,
           :CurObject.CircuitDetail.FunctionArea = C.FunctionArea,
           :CurObject.CircuitDetail.FunctionAreaName = T1.Name,
           :CurObject.CircuitDetail.PriorityLine = C.PriorityLine,
           :CurObject.CircuitDetail.CurrentlyOpen = C.CurrentlyOpen
   FROM    Udb_Object O,
           Udb_TelephoneCircuit C,
           Udb_Type T1
   WHERE   O.Object = :CurObject.Object
   AND     O.Object = C.Object
   AND     C.FunctionArea = T1.Type;
   CALLPROC DDB_ROLLBACK;
   
   // get circuit's route/channels
   RouteName = ''; 
   SELECT :TempName = SQUEEZE(T.Name)
   FROM   UDB_CircuitRoute C,
          UDB_Type T
   WHERE  C.Object = :CurObject.Object AND
          C.Route = T.Type AND
          C.Route <> 0
   BEGIN
      IF RouteName <> '' THEN
         RouteName = RouteName  + '; ' ;
      ENDIF;
      RouteName = RouteName + TempName;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   CurObject.CircuitDetail.RouteName = RouteName;
   
   //  Get CSO Report type
   SELECT :CurObject.CircuitDetail.CircuitInfo.Status = T.Name
   FROM    Udb_Type T,
           Udb_SuperType ST,
           Udb_Supertype ST2
   WHERE   T.Type = ST.SuperType AND
           ST.Type = :CurObject.CircuitDetail.CircuitInfo.Type AND
           ST.SuperType = ST2.Type AND
           ST2.SuperType = :Type$CircuitReportCategory;
   CALLPROC DDB_ROLLBACK;
   
   // get Provided By Carrier info
   REPEATED
   SELECT  :CurObject.CircuitDetail.CarrierInfo.Object = O.Object,
           :CurObject.CircuitDetail.CarrierInfo.Type = O.Type,  
           :CurObject.CircuitDetail.CarrierInfo.TypeName = O.TypeName,
           :CurObject.CircuitDetail.CarrierInfo.Name = O.Name
   FROM    Udb_Grouping G,
           Udb_Object O
   WHERE   G.Member = :CurObject.Object
   AND     G.Relationship = :Interaction$ProvidedBy
   AND     G.Grouping = O.Object;
   CALLPROC DDB_ROLLBACK;
   
   // Verizon Interface format
   IF CurObject.CircuitDetail.CarrierInfo.Object = Company$Verizon THEN
       SELECT :CurObject.CircuitDetail.CircuitInfo.CreatedBy = V.LineName
       FROM    TC_VerizonCircuit V
       WHERE   V.Circuit = :CurObject.Object;
   ENDIF;
    
   /*
   **  Get all grouping information for the circuit
   */   
   REPEATED
   SELECT  :CurObject.CircuitDetail.Grouper.Object = O.Object,
           :CurObject.CircuitDetail.Grouper.Type = O.Type,
           :CurObject.CircuitDetail.Grouper.TypeName = O.PrimaryGroupingName, /*load substation*/
           :CurObject.CircuitDetail.Grouper.Name = O.Name
   FROM    Udb_Grouping G,
           Udb_Object O
   WHERE   G.Member = :CurObject.Object
   AND     G.Relationship = :Interaction$MemberOf
   AND     G.GroupingType IN ( SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$TelCardGrouper)
   AND     G.Grouping = O.Object;
   CALLPROC DDB_ROLLBACK;

   // associates
   i = 1;
   REPEATED
   SELECT  :CurObject.CircuitDetail.Associates[i].Object = O.Object,
           :CurObject.CircuitDetail.Associates[i].Name = O.Name,
           :CurObject.CircuitDetail.Associates[i].Type = O.Type,
           :CurObject.CircuitDetail.Associates[i].TypeName = O.TypeName
   FROM    Udb_Grouping G,
           Udb_Object O
   WHERE   G.Grouping = :CurObject.Object
   AND     G.Relationship = :Interaction$MemberOf
   AND     G.MemberType IN (SELECT Type
                            FROM   Udb_ExtendedType
                            WHERE  Supertype = :Type$TelCircuit)
   AND     G.Member = O.Object
   ORDER BY Status
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   // substations
   i = 1;
   REPEATED
   SELECT  :CurObject.CircuitDetail.SubstationInfo[i].Object = O.Object,
           :CurObject.CircuitDetail.SubstationInfo[i].Name = O.Name,
           :CurObject.CircuitDetail.SubstationInfo[i].Type = O.Type,
           :CurObject.CircuitDetail.SubstationInfo[i].TypeName = O.TypeName,
           :CurObject.CircuitDetail.SubstationInfo[i].Status = G.Reference    /* use this for now */
   FROM    Udb_Grouping G,
           Udb_Object O
   WHERE   G.Member = :CurObject.Object
   AND     G.Relationship = :Interaction$MemberOf
   AND     G.GroupingType IN ( SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
   AND     G.Grouping = O.Object
   ORDER BY Status
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   // feeders
   i = 1;
   REPEATED
   SELECT  :CurObject.CircuitDetail.FeederInfo[i].Object = O.Object,
           :CurObject.CircuitDetail.FeederInfo[i].Type = O.Type,
           :CurObject.CircuitDetail.FeederInfo[i].TypeName = O.TypeName,
           :CurObject.CircuitDetail.FeederInfo[i].Name = O.Name
   FROM    Udb_Object O,
           Udb_Grouping G
   WHERE   G.Member = :CurObject.Object
   AND     G.Relationship = :Interaction$MemberOf
   AND     G.GroupingType IN ( SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  Supertype IN 
                                      (:Type$Feeder,:Type$Network,:Type$Line,
                                       :Type$DivisionWorkstation))
   AND     G.Grouping = O.Object
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   // Populate division and desk fields
   CurObject.CircuitDetail.BoroughName = '';
   SELECT  :TempName = O.Name
   FROM     Udb_Object O,
            Udb_Grouping G
   WHERE    G.Member = :CurObject.Object AND
            G.RelationShip = :Interaction$MemberOf AND
            G.GroupingType = :Type$Division AND
            G.Grouping = O.Object
   BEGIN
      IF CurObject.CircuitDetail.BoroughName <> '' THEN
         CurObject.CircuitDetail.BoroughName = CurObject.CircuitDetail.BoroughName + ',';
      ENDIF;
      CurObject.CircuitDetail.BoroughName = CurObject.CircuitDetail.BoroughName + TempName;
   END;  

   // Is it a grouper 
   SELECT :CurObject.CircuitDetail.CircuitInfo.BaseType = ET.Type
   FROM    Udb_ExtendedType ET
   WHERE   SuperType = :Type$TelCardGrouper AND
            Type = :CurObject.CircuitDetail.CircuitInfo.Type;

   CALLPROC DDB_ROLLBACK;
END;

Application Component Report
============================

	Name:            EquipControlCheck

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**
**  Application:    CAC
**  Frame:          EquipControlCheck
**
**  01/23/03   pkw  Check to see if equipment control should be transferred
**                  to another card before closing switchingitem or card.
**  01/24/03   pkw  Add check to make sure outstanding job is not in a shadow
**                  switching item.
**  02/13/03   pkw  Add SwItemStatus when checking if move is on an active 
**                  Switching Item.
**  03/07/03   pkw  Change comments.
**  11/09/05   em   Added Closed SwItemStatus check to where clause so that 
**                  this select is the same as the one in TransferControl
**  12/14/07   em   There is a problem when equipment
**                  has been transferred between switching items, and the new
**                  switching item has control of an outstanding move shared
**                  to TFMS/FMS, trying to close the old sw item.  We add
**                  an additional select to make sure the equip is does
**                  not have outstanding move in another sw item.
*/
PROCEDURE EquipControlCheck (
   Card           = INTEGER NOT NULL;               /* Parm */
   SwitchingItem  = INTEGER NOT NULL WITH DEFAULT;  /* Parm */

   i              = INTEGER NOT NULL WITH DEFAULT;              
   m              = INTEGER NOT NULL WITH DEFAULT;              
   ControlEquip   = ARRAY OF INTEGEROBJECT;         /* Job Equip List */
   ControlCheck   = INTEGER NOT NULL;              
   JobCheck       = ARRAY OF INTEGEROBJECT;               
   RetCode        = INTEGER NOT NULL WITH DEFAULT;              
) =
BEGIN
/*
** Get a list of Equipment that are controlled by the card/switchingitem.
*/
   i = 1;
   ControlEquip.Clear();
   REPEATED
   SELECT DISTINCT
          :ControlEquip[i].Value = J.Equip    
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :Card AND
           JC.SwitchingItem = :SwitchingItem AND
           JC.Job = J.Job AND
           J.ControlCard = :Card AND
           J.Equip <> 0
   BEGIN
      i = i + 1;
   END;

   ControlCheck = FALSE;
   FOR i = 1 TO ControlEquip.LastRow() DO
/*
** If we are on a Switching Item, make sure the equipment is not
** in another switching item with an outstanding move...because that
** item is the one that really has control of the equipment and we can
** ignore that we found the equipment in the switching item we are trying
** to close.
** We cannot only look at outstanding moves on the prior Equip select, 
** because certain moves may not be shared between card types so it would
** be possible for a card to have control with no outstanding moves where
** a non-shared outstanding move still exists on the other card.
*/
      IF SwitchingItem <> 0 THEN 
         m = 0;
         REPEATED
         SELECT  :m = J.Job
         FROM    SOA_Job J,
                 SOA_JobControl JC
         WHERE   JC.Card = :Card AND
                 JC.SwitchingItem <> :SwitchingItem AND
                 JC.Job = J.Job AND
                 J.ControlCard = :Card AND
                 J.Equip = :ControlEquip[i].Value AND
                (J.TOComplete IS NULL OR
                 J.RSComplete IS NULL) AND
                 J.Status IN ('',:JobStatus$NIS) AND
                 J.SwItemStatus < :Card$Closed AND
                 J.MoveCategory = :MoveCategory$Normal;

         IF m <> 0 THEN
            CONTINUE;
         ENDIF;
      ENDIF;
/*
**  For each piece of equipment found, find all jobs that
**  have outstanding moves.  We are only looking at the 
**  SwitchingItem field because we will only return TRUE
**  if we find a job on a non-shadow item.
*/
      m = 1;
      JobCheck.Clear();
      REPEATED
      SELECT DISTINCT  
             :JobCheck[m].Value = JC.SwitchingItem
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC
      WHERE   J.ControlCard = :Card AND
              J.Equip = :ControlEquip[i].Value AND
             (J.TOComplete IS NULL OR
              J.RSComplete IS NULL) AND
              J.Status IN ('',:JobStatus$NIS) AND
              J.SwItemStatus < :Card$Closed AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.Job = JC.Job AND
              JC.Card = AC.Card AND
              JC.Card <> :Card AND
              JC.Card <> :NIS$Card
      BEGIN
         m = m + 1;
      END;
      
      FOR m = 1 TO JobCheck.LastRow() DO
/*
**  If a job doesn't have a switchingitem associated with it,
**  we are done checking.  If a job has a switchingitem associated
**  with it, we will check to see if it is not on a shadow switching
**  item (shadowlink = 0).  If it was on a shadow item, we need to 
**  continue through the list.
*/
         IF JobCheck[m].Value = 0 THEN
            ControlCheck = TRUE;
            ENDLOOP;
         ELSE
            ControlCheck = FALSE;
            REPEATED
            SELECT :ControlCheck = :TRUE
            FROM    SOA_Job J
            WHERE   J.Job = :JobCheck[m].Value AND
                    J.ShadowLink = 0 AND
                    J.SwItemStatus = :Card$Active; 
            IF ControlCheck = TRUE THEN
               ENDLOOP;
            ENDIF;
         ENDIF;
      ENDFOR;
      IF ControlCheck = TRUE THEN
         ENDLOOP;
      ENDIF;
   ENDFOR;

   IF ControlCheck = TRUE THEN
      RETURN (TRUE);
   ELSE
      RETURN (FALSE);
   ENDIF;
END;

