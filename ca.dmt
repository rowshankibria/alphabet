**  12/20/18 ysp Merged with the class in FeederCard
**  02/18/19 ysp Upgrade to support online data
**  03/07/19 ysp Add new combo fields for DM lock card
**  03/12/19 ysp Add DMBadging
**  12/15/20 ysp Add SwitchLocked and CamOpsLocked
*/

METHOD GetConfiguration(
) = 
DECLARE

ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :CurObject.LastMImport = MAX(Received)
   FROM   FMS_SesameLockCard
   WHERE Division = :Division$Manhattan;
   
   SELECT :CurObject.LastSImport = MAX(Received)
   FROM   FMS_SesameLockCard
   WHERE Division = :Division$StatenIsland;
   
   SELECT :CurObject.LastXWImport = MAX(Received)
   FROM   FMS_SesameLockCard
   WHERE Division IN (:Division$Bronx, :Division$WestChester);

   SELECT :CurObject.LastBQImport = MAX(Received)
   FROM   FMS_SesameLockCard
   WHERE Division IN (:Division$Brooklyn, :Division$Queens);

   SELECT :CurObject.LastAllImport = MAX(Received)
   FROM   FMS_SesameLockCard;
   
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadRecords(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;      /* List of divisions*/
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1200) NOT NULL WITH DEFAULT;
   Feeder   = INTEGER NOT NULL WITH DEFAULT;   
   FeederType   = INTEGER NOT NULL WITH DEFAULT;   
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   IF CurObject.Card IS NOT NULL THEN
      Feeder = CurObject.Card.Feeder;
      /*
      ** in case the passed-in card is an ISO feeder or portion feeder card
      */
      IF Feeder <> -1 THEN  /* Would indicate Network Feeder */
         FeederType = 0;
         WHILE :FeederType = 0 DO
            SELECT :Feeder = G.Grouping,  
                   :FeederType = G.GroupingType
            FROM   UDB_Grouping G,
                   Udb_ExtendedType ET
            WHERE  G.Member = :Feeder AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.GroupingType = ET.Type AND
                   ET.SuperType = :Type$Feeder;

            IF FeederType <> 0 AND FeederType <> Type$Feeder THEN
               FeederType = 0;  /*Must still be an ISO, keep looping*/
            ELSEIF FeederType = 0 THEN
               FeederType = -1; /* No Parent Feeder, bust out of loop */
            ENDIF;              /* Will bust out if FeederType= Type$Feeder */
         ENDWHILE;
      ENDIF;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
** query for list
*/ 
   DynamicWhereClause = 'S.Division IN (';
   IF EffectiveDivisions.LastRow > 0 THEN
      FOR i = 1 TO EffectiveDivisions.LastRow DO
         IF i > 1 THEN
            DynamicWhereClause = DynamicWhereClause + ',';
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + VARCHAR(EffectiveDivisions[i].Object);
      ENDFOR;
   ELSE
      DynamicWhereClause = DynamicWhereClause + '-1';
   ENDIF;  

   IF Feeder <> - 1 THEN
      DynamicWhereClause = DynamicWhereClause + ') AND ' + 
                        'S.Division = D.Object AND ' + 
                        'S.Feeder = ' + VARCHAR(Feeder) + ' AND ';
   ELSE
      DynamicWhereClause = DynamicWhereClause + ') AND ' + 
                        'S.Division = D.Object AND ';

      IF CurObject.Card.Object.LastRow() = 0 THEN
         DynamicWhereClause = DynamicWhereClause +
                             'S.Feeder = 0 AND '; 
      ELSE
         DynamicWhereClause = DynamicWhereClause +
                        'S.Feeder IN ('; 
         FOR i = 1 TO CurObject.Card.Object.LastRow() DO
            IF i > 1 THEN
               DynamicWhereClause = DynamicWhereClause + ',';
            ENDIF;
            DynamicWhereClause = DynamicWhereClause + VARCHAR(CurObject.Card.Object[i].Object);
         ENDFOR;
         DynamicWhereClause = DynamicWhereClause + ') AND ';
      ENDIF;
   ENDIF;
   DynamicWhereClause = DynamicWhereClause + 'S.Feeder = F.Object AND ';
                        
   IF CurObject.ShowActive = TRUE THEN
      DynamicWhereClause = DynamicWhereClause + 'S.Processed = 0 ';      
   ELSE
      CurObject.EndDate = CurObject.EndDate + '24 Hours';
      DynamicWhereClause = DynamicWhereClause + 'S.Processed = 1 AND ' + 
                           'S.Received >= DATE(''' + VARCHAR(CurObject.StartDate) + ''') AND ' +
                           'S.Received <= DATE(''' + VARCHAR(CurObject.EndDate) + ''')';
   ENDIF;

   CurObject.LoadLockList(DynamicWhereClause  = DynamicWhereClause);  

/* obsolete  2/18/19   
   CurObject.LockList.Clear();
   i = 1;
   SELECT :CurObject.LockList[i].FormID = 0
         ,:CurObject.LockList[i].FormType = 0
         ,:CurObject.LockList[i].Received = S.Received
         ,:CurObject.LockList[i].Division = S.Division
         ,:CurObject.LockList[i].DivisionName = D.Name        
         ,:CurObject.LockList[i].Feeder = S.Feeder
         ,:CurObject.LockList[i].FeederName = F.Name         
         ,:CurObject.LockList[i].Equip = S.Equip
         ,:CurObject.LockList[i].ComboNo = S.ComboNo          
         ,:CurObject.LockList[i].FDRAndStruct = S.FDRAndStruct   
         ,:CurObject.LockList[i].Location = S.Location       
         ,:CurObject.LockList[i].InstalledBy = S.InstalledBy    
         ,:CurObject.LockList[i].InstallDate = S.InstallDate    
         ,:CurObject.LockList[i].Supervisor = S.Supervisor     
         ,:CurObject.LockList[i].ApprovalDate = S.ApprovalDate   
         ,:CurObject.LockList[i].SerialNo = S.SerialNo          
         ,:CurObject.LockList[i].LockNo = S.LockNo            
         ,:CurObject.LockList[i].PhaseA = S.PhaseA            
         ,:CurObject.LockList[i].PhaseASerial = S.PhaseASerial      
         ,:CurObject.LockList[i].PhaseALock = S.PhaseALock        
         ,:CurObject.LockList[i].PhaseB = S.PhaseB            
         ,:CurObject.LockList[i].PhaseBSerial = S.PhaseBSerial      
         ,:CurObject.LockList[i].PhaseBLock = S.PhaseBLock        
         ,:CurObject.LockList[i].PhaseC = S.PhaseC            
         ,:CurObject.LockList[i].PhaseCSerial = S.PhaseCSerial      
         ,:CurObject.LockList[i].PhaseCLock = S.PhaseCLock        
         ,:CurObject.LockList[i].NWTrans = S.NWTrans  
         ,:CurObject.LockList[i].Radial = S.Radial   
         ,:CurObject.LockList[i].Reactor = S.Reactor  
         ,:CurObject.LockList[i].GroundSW = S.GroundSW 
         ,:CurObject.LockList[i].FDRAndVault = S.FDRAndVault       
         ,:CurObject.LockList[i].SesameLock = S.SesameLock        
         ,:CurObject.LockList[i].UnitLocked = S.UnitLocked        
         ,:CurObject.LockList[i].NeutralInstalled = S.NeutralInstalled  
         ,:CurObject.LockList[i].AnodesInstalled = S.AnodesInstalled   
         ,:CurObject.LockList[i].Remarks = S.Remarks
         ,:CurObject.LockList[i].Processed = S.Processed
         ,:CurObject.LockList[i].UpdateTime = S.UpdateTime
         ,:CurObject.LockList[i].ByDO = S.ByDO
   FROM   FMS_SesameLockCard S,
          Udb_Object D,
          Udb_Object F
   WHERE  :DynamicWhereClause  
   ORDER BY Feeder, Received
   BEGIN
      i = i + 1; 
   END;
   CALLPROC DDB_ROLLBACK; 
*/   
END;

METHOD LoadLockList(
   DynamicWhereClause = VARCHAR(1200) NOT NULL WITH DEFAULT
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;   
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   IF DynamicWhereClause = '' THEN     /* Called From FMS Online */
      If LOWERCASE(CurObject.DivisionName) LIKE 'all%' THEN
         DynamicWhereClause = 'S.Division = D.Object ';
      ELSE
         IF CurObject.Division <> 0 THEN
            DynamicWhereClause = 'S.Division = ' + VARCHAR(CurObject.Division);
         ELSE
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               i = locate(CurObject.DivisionName,';');
               CurObject.Division = int4(left(CurObject.DivisionName, i-1));   
               
               IF DynamicWhereClause <> '' THEN
                  DynamicWhereClause = DynamicWhereClause + ',';
               ENDIF;
               DynamicWhereClause = DynamicWhereClause + VARCHAR(CurObject.Division);
               
               CurObject.DivisionName = shift(CurObject.DivisionName, -i);
            ENDWHILE;
            
            DynamicWhereClause = 'S.Division IN (' + DynamicWhereClause + ')';
         ENDIF;  
         
         DynamicWhereClause = DynamicWhereClause + ' AND S.Division = D.Object ';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + ' AND S.Feeder = F.Object ';
      
      IF CurObject.Feeder > 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND S.Feeder = ' + VARCHAR(CurObject.Feeder);
      ENDIF;
   
      IF CurObject.Structure <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND S.FDRAndStruct LIKE ''%' + CurObject.Structure + '%''';
      ENDIF;
      
      IF CurObject.StartDate <> '' AND CurObject.EndDate <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND ' + 
                           'S.Received >= DATE(''' + VARCHAR(CurObject.StartDate) + ''') AND ' +
                           'S.Received <= DATE(''' + VARCHAR(CurObject.EndDate) + ''')';
      ENDIF;
   ENDIF;

   CurObject.LockList.Clear();
   i = 1;
   SELECT :CurObject.LockList[i].FormID = S.FormID
         ,:CurObject.LockList[i].FormType = S.FormType
         ,:CurObject.LockList[i].Received = S.Received
         ,:CurObject.LockList[i].EnteredBy = S.EnteredBy
         ,:CurObject.LockList[i].Division = S.Division
         ,:CurObject.LockList[i].DivisionName = D.Name        
         ,:CurObject.LockList[i].Feeder = S.Feeder
         ,:CurObject.LockList[i].FeederName =  F.Name        
         ,:CurObject.LockList[i].Equip = S.Equip
         ,:CurObject.LockList[i].ComboNo = S.ComboNo          
         ,:CurObject.LockList[i].FDRAndStruct = S.FDRAndStruct   
         ,:CurObject.LockList[i].Location = S.Location       
         ,:CurObject.LockList[i].InstalledBy = S.InstalledBy    
         ,:CurObject.LockList[i].InstallDate = S.InstallDate    
         ,:CurObject.LockList[i].Supervisor = S.Supervisor     
         ,:CurObject.LockList[i].ApprovalDate = S.ApprovalDate   
         ,:CurObject.LockList[i].SerialNo = S.SerialNo          
         ,:CurObject.LockList[i].LockNo = S.LockNo            
         ,:CurObject.LockList[i].PhaseA = S.PhaseA            
         ,:CurObject.LockList[i].PhaseASerial = S.PhaseASerial      
         ,:CurObject.LockList[i].PhaseALock = S.PhaseALock        
         ,:CurObject.LockList[i].PhaseB = S.PhaseB            
         ,:CurObject.LockList[i].PhaseBSerial = S.PhaseBSerial      
         ,:CurObject.LockList[i].PhaseBLock = S.PhaseBLock        
         ,:CurObject.LockList[i].PhaseC = S.PhaseC            
         ,:CurObject.LockList[i].PhaseCSerial = S.PhaseCSerial      
         ,:CurObject.LockList[i].PhaseCLock = S.PhaseCLock        
         ,:CurObject.LockList[i].Remarks = S.Remarks
         ,:CurObject.LockList[i].KV = S.KV
         ,:CurObject.LockList[i].KVA = S.KVA
         ,:CurObject.LockList[i].KV2 = S.KV2
         
         ,:CurObject.LockList[i].NWTrans = S.NWTrans  
         ,:CurObject.LockList[i].Radial = S.Radial   
         ,:CurObject.LockList[i].Reactor = S.Reactor  
         ,:CurObject.LockList[i].GroundSW = S.GroundSW 
         ,:CurObject.LockList[i].FDRAndVault = S.FDRAndVault       
         ,:CurObject.LockList[i].SesameLock = S.SesameLock        
         ,:CurObject.LockList[i].UnitLocked = S.UnitLocked        
         ,:CurObject.LockList[i].NeutralInstalled = S.NeutralInstalled  
         ,:CurObject.LockList[i].AnodesInstalled = S.AnodesInstalled   
         
         ,:CurObject.LockList[i].PowerSupplySerial = S.PowerSupplySerial 
         ,:CurObject.LockList[i].PowerSupplyLock   = S.PowerSupplyLock   
         ,:CurObject.LockList[i].PowerSupplyCombo  = S.PowerSupplyCombo   
         ,:CurObject.LockList[i].HandHeldSerial = S.HandHeldSerial
         ,:CurObject.LockList[i].HandHeldLock   = S.HandHeldLock  
         ,:CurObject.LockList[i].HandHeldCombo  = S.HandHeldCombo
         ,:CurObject.LockList[i].SCADASerial   = S.SCADASerial  
         ,:CurObject.LockList[i].SCADALock     = S.SCADALock    
         ,:CurObject.LockList[i].SCADACombo    = S.SCADACombo    
         ,:CurObject.LockList[i].ManualSerial  = S.ManualSerial 
         ,:CurObject.LockList[i].ManualLock    = S.ManualLock   
         ,:CurObject.LockList[i].ManualCombo   = S.ManualCombo  
         ,:CurObject.LockList[i].CamASerial = S.CamASerial
         ,:CurObject.LockList[i].CamALock   = S.CamALock  
         ,:CurObject.LockList[i].CamACombo  = S.CamACombo
         ,:CurObject.LockList[i].CamBSerial = S.CamBSerial
         ,:CurObject.LockList[i].CamBLock   = S.CamBLock  
         ,:CurObject.LockList[i].CamBCombo  = S.CamBCombo
         ,:CurObject.LockList[i].CamCSerial = S.CamCSerial
         ,:CurObject.LockList[i].CamCLock   = S.CamCLock
         ,:CurObject.LockList[i].CamCCombo  = S.CamCCombo
         ,:CurObject.LockList[i].DMBadging = S.DMBadging
         ,:CurObject.LockList[i].SwitchLocked = S.SwitchLocked
         ,:CurObject.LockList[i].CamOpsLocked = S.CamOpsLocked
 
         ,:CurObject.LockList[i].Processed = S.Processed
         ,:CurObject.LockList[i].UpdateTime = S.UpdateTime
         ,:CurObject.LockList[i].ByDO = S.ByDO
   FROM   FMS_SesameLockCard S,
          Udb_Object D,
          Udb_Object F
   WHERE  :DynamicWhereClause  
   ORDER BY Received DESC
   BEGIN
      /*
      IF CurObject.LockList[i].FeederName <> '' THEN
         k = LOCATE(CurObject.LockList[i].FDRAndStruct, CurObject.LockList[i].FeederName);
         IF k = (SIZE(CurObject.LockList[i].FDRAndStruct) + 1) THEN  // feeder name not found 
            CurObject.LockList[i].FDRAndStruct = CurObject.LockList[i].FeederName + ' ' + CurObject.LockList[i].FDRAndStruct;
         ENDIF;
      ENDIF;
      */
      i = i + 1; 
   END;
   CALLPROC DDB_ROLLBACK;                            
END;

