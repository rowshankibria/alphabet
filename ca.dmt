/*
**  Application:    FeederCard DBM
**  Frame:          Equipment Templates
**
**  Date:       Version Description
** ----------------------------------
**  12/16/97   em   Created
**  05/08/97   pkw  Modified Feedercard_DBM version to show display only
**  03/31/99   em   Added ViewOnly option
*/

INITIALIZE
(
#   include StandardDeclarations
    CurTemplate = INTEGER NOT NULL WITH DEFAULT;
    CurManufacturer = INTEGER NOT NULL WITH DEFAULT;
    ScrollTemplate = VARCHAR(40) NOT NULL WITH DEFAULT;
    TemplateTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
    ManufacturerObject = ObjectSummaryClass;
    Opens = INTEGER NOT NULL WITH DEFAULT;
    Closes = INTEGER NOT NULL WITH DEFAULT;
    InsulatingMedium = INTEGER NOT NULL WITH DEFAULT;
    Status = Integer not null;
    SelectedTemplate = INTEGER NOT NULL WITH DEFAULT;
    SelectedTemplateName = VARCHAR(40) NOT NULL WITH DEFAULT;
    ViewOnly = INTEGER NOT NULL WITH DEFAULT;  /*Optional Pased parm*/
) =
BEGIN
    SELECT :TemplateTypeName = Name
    FROM   Udb_Type
    WHERE  Type = :Type$EquipmentTemplate;
 
    IF ViewOnly = TRUE THEN
       CurFrame.CurMode = FM_READ;
    ELSE
       CurFrame.CurMode = FM_UPDATE;
    ENDIF;

    CurFrame.SendUserEvent (EventName = 'Load Templates');
END;

ON UserEvent 'Load Templates' =
BEGIN
/*
**  Load the equipment templates
*/
    ET_Tbl.Clear();
    i = 1;
    REPEATED
    SELECT 
        :ET_Tbl[i].Object = O.Object,
        :ET_Tbl[i].Name = O.Name,
        :ET_Tbl[i].Description = O.Description
    FROM    Udb_Object O
    WHERE   O.Type = :Type$EquipmentTemplate
    ORDER BY 2 
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;

    i = 1;
    LastRow = ET_Tbl.LastRow();
    WHILE i <= LastRow DO
       IF ET_Tbl[i].Object = SelectedTemplate THEN
           FIELD(ET_Tbl).SetInputFocus (row=i);      
       ENDIF;
       i = i + 1;
    ENDWHILE;
END;


ON ChildEntry ET_Tbl =
BEGIN
/*
**  Load the information for the selected Equipment Template.
*/
/*
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
*/
    CurTemplate = ET_Tbl[].Object;
    Name = ET_Tbl[].Name;
    Description = ET_Tbl[].Description;
    SelectedTemplate = ET_Tbl[].Object;
    SelectedTemplateName = ET_Tbl[].Name;

    Manufacturer = '';
    CurManufacturer = 0;
    REPEATED
    SELECT :Manufacturer = O.Name,
           :CurManufacturer = O.Object
    FROM   Udb_Object O,
           Udb_Grouping G,
           Udb_ExtendedType ET
    WHERE  O.Object = G.Grouping AND
           G.Relationship = :Type$Made_By AND
           G.Member = :CurTemplate AND
           G.GroupingType = ET.Type AND
           ET.SuperType = :Type$Manufacturer;

    REPEATED 
    SELECT :Tank = O.Tank,
           :Opens = O.Opens,
           :Closes = O.Closes,
           :InsulatingMedium = O.InsulatingMedium,
           :MetalClad = MetalClad,
           :OpensName = T1.Name,
           :ClosesName = T2.Name,
           :InsulatingMediumName = T3.Name,
           :HiAlarm = O.HiAlarm,
           :LoAlarm = O.LoAlarm,
           :Trip = O.Trip,
           :LockOut = O.LockOut
    FROM   SLC_EquipTemplate O,
           Udb_Type T1,
           Udb_Type T2,
           Udb_Type T3
    WHERE  O.Object = :CurTemplate AND
           O.Opens = T1.Type AND
           O.Closes = T2.Type AND
           O.InsulatingMedium = T3.Type;

    CALLPROC DDB_ROLLBACK;

END;


ON Click OK_Btn =
BEGIN
    IF SelectedTemplateName = '' THEN
        message 'You have not selected an equipment type.';
        RESUME;
    ENDIF;
    RETURN (SelectedTemplate);
END;


ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;


ON Click Exit_Btn =
BEGIN
    SelectedTemplate = 0;
    SelectedTemplateName = '';
    RETURN (SelectedTemplate);
END;
