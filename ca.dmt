	Name:            PromptSetInternalsRemoved

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSetACFeedRemoved
**
**  Modifications:
**  06/24/14   em   Created
**  07/29/14   em   Changed procedure call
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
) =
BEGIN
  
      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'internalsremoved',
                FieldValue = 1
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Valve Internals Removed.',
                           TraceMessage =
               'PromptSetInternalsRemoved: Unable to set InternalsRemoved ' +
               'device status for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;

END;

Application Component Report
============================

	Name:            PromptSetMicroGridOpen

/*
**
**	Copyright c 2012 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSetMicroGridOpen  
**
**  Modifications:
**	11/05/18   pkw	Created 
*/
INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
) =
DECLARE
    C = FMS_Card;				/* Card details */
    i = INTEGER NOT NULL;
    x = INTEGER NOT NULL;
    FedBy = INTEGER NOT NULL;
    NetworkFeeders = ARRAY OF INTEGEROBJECT;
    RetCode = INTEGER;
ENDDECLARE
BEGIN
/*
**  Only Set Status if equipment has MicroGridFor feeder relationship.
*/
    C.Feeder = 0;
    REPEATED
    SELECT DISTINCT
           :C.Card = C.Card,
           :C.Feeder = C.Feeder,
           :C.NetworkFeeder = C.NetworkFeeder
    FROM    SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C,
            Udb_Grouping G,
            Udb_ExtendedType ET
    WHERE   J.Job = :JIP.Job AND
            J.Equip = G.Member AND
            G.Relationship = :Interaction$MicroGridFor AND
            G.GroupingType = ET.Type AND
            ET.SuperType = :Type$Feeder AND
            J.Job = JC.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card;
   IF C.Feeder <> 0 THEN
      /* 
      **  Equipment is an Micro Grid Line switch.  Set MicroGridOpen Status.
      */
      NetworkFeeders.Clear();
      IF C.NetworkFeeder > 0 THEN
         x = 1;
         SELECT :NetworkFeeders[x].Value = CTO.Object
         FROM   TFMS_CardToObject CTO,
                Udb_ExtendedType ET
         WHERE  CTO.Card = :C.Card AND
                CTO.Type = ET.Type AND
                ET.SuperType = :Type$Feeder
         BEGIN
            IF C.NetworkFeeder = NetworkFeeder$33kV THEN
               /*
               **  Include segments fed by this feeder and exclude segments fed by 
               ** another feeder when setting feeder status
               */
               FedBy = 0;    
               SELECT :FedBy = G.Grouping
               FROM   Udb_Grouping G
               WHERE  G.Member = :NetworkFeeders[x].Value AND
                      G.Relationship = :Interaction$FedBy;
               IF FedBy > 0 THEN
                  NetworkFeeders.RemoveRow (rownumber = x);
               ELSE
                  x = x + 1;
               ENDIF;
            ELSE
               x = x + 1;
            ENDIF;
         END;
      ELSE
         NetworkFeeders[1].Value = C.Feeder;
      ENDIF;      
 
      FOR x = 1 TO NetworkFeeders.LastRow() DO     
         CALLPROC ForceStatus (Feeder = NetworkFeeders[x].Value,
                               NewStatus = Status$MicroGridOpen);
      ENDFOR;
   ENDIF;

   RETURN (PU_OK);
 
END;


