**  07/29/14   em  Don't display screen, just set cracked/open status.
*/
INITIALIZE 
(
   JIP = JobInProgress;			/* Job being processed */
) =
DECLARE
   RetCode = INTEGER;
   CurrentlyOpen = INTEGER;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   StructureType = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
