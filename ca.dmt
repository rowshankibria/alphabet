Application Component Report
============================

	Name:            ManageEquipment_vm

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ManageEquipment
**
**  Date:       Author   Description
** ----------------------------------
**  11/12/98	EM       Converted for use in SOA
**                       Will use existing SLC tables
**  11/20/98    em       Place In/Remove From Service functions
**  07/23/99    em       Change focus of screen, will be used when:
**                         1) Connectivity Change menu item selected -
**                            Will list all equipment links for permits on
**                            the card, allowing document information to
**                            be changed, and/or PV to be called.
**                         2) SLC Verify Documents button -
**                            Same function as #1, with no PV Access.
**                         3) At Permit Completion time -
**                            Will list just equipment links for that card,
**                            allowing document information to
**                            be changed, and/or PV to be called.
**                        Thus the function of the screen will be the same for 
**                        each invocation.  The heading on the screen will be
**                        different for each of the invocations.
**                        The Completing Permits function itself will continue
**                        after display of this screen and will verify that
**                        connectivity changes were made.    
**  08/10/99   em        WaitFor method not working in single frame.  Must
**                       develop new method to update and check connectivity at
**                       completion time.
**  08/31/99   em        Insertion of NIS moves not happening on SLC cards.
**  10/07/99   em        Various variances fixes realted to providing more
**                       information about the permit.
**  11/22/99   em        Error returning too soon before completing NIS
**                       events required ReturnOK userevent
**  04/17/00   em        Bus Link Objectives added
**  06/20/03   em        Added IFNULL to EquipmentDocuments call
**  09/29/03   em        Modify PVStart call, add PVDir global to CAC
**  12/13/05   ysp       increase TPermitMove to varchar(160)
**  11/24/11   pkw       Change call to PV.  Use session.cur.database
*/
INITIALIZE 
(
#  include StandardDeclarations

    Card = INTEGER NOT NULL;          /* Passed card */
    Function = INTEGER NOT NULL;      /* Passed function parameter:
                                         1-Connectivity Change,
                                         2-Document Verification,
                                         3-Permit Completion */
    PermitJob = INTEGER NOT NULL WITH DEFAULT; /*Optional Parm used with #3*/
    PermitSwItem = INTEGER NOT NULL WITH DEFAULT; /*Optional Parm used with #3*/
    TPermitMove = VARCHAR(160) NOT NULL WITH DEFAULT;/*Optional Permit Move*/
    TPermitStatus = VARCHAR(20) NOT NULL WITH DEFAULT;/*Optional Permit Status*/

    Connected = INTEGER NOT NULL WITH DEFAULT; /*Flag for In/Out of service*/
    ControlInsert = NewMoveCard;  /*Insert NIS Moves*/
    IncidentDate = DATE NOT NULL; /*Reporting Connectivity Problem*/
    IncidentSubstation = INTEGER NOT NULL; /*Reporting Connectivity Problem*/
    j = integer not null with default;  /*Local: Temporary counter */
    NISEquip = INTEGER NOT NULL;      /*Equipment NIS status changed*/
    PermitGoal = VARCHAR(15) NOT NULL; /*Goal for problems insertion*/
    SelectedRow = INTEGER NOT NULL;   /*Index into Selected Row */
    SubstationVerified = INTEGER NOT NULL; /*BOOLEAN*/

   Idx                  = ARRAY OF IntegerObject; /*Track impacted cards*/
   ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
   InsertionList        = ARRAY OF NewMoveCard; /*List of cards to insert move*/
   k = INTEGER NOT NULL;
   n = INTEGER NOT NULL;
   NISJob = ARRAY OF Job;
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   PV_Command = VARCHAR(512) NOT NULL WITH DEFAULT;
 
) =
BEGIN   
/*
**  Function Drives Screen Heading and Availability of Connectivity button.
*/
    SelectedRow = 1;
    IF Function = PermitObjective$Connectivity THEN
       FIELD(ScreenTitle).TextValue = 'Equipment and intended Connectivity ' +               'Changes linked to Permits on this Card.';
       FIELD(PermitHeader).CurBias = FB_INVISIBLE;
    ELSEIF Function = PermitObjective$Document THEN  
       FIELD(ScreenTitle).TextValue = 'Documentation Verification for Equipment' +                ' linked to Permits on this Card.';
       FIELD(PermitHeader).CurBias = FB_INVISIBLE;
     ELSEIF Function = PermitObjective$Completion THEN
       FIELD(ScreenTitle).TextValue = 'Goals identified for Completion of ' +                 'Permit';
       FIELD(PermitHeader).CurBias = FB_LANDABLE;
       PermitHeader.PermitMove = TPermitMove;
       PermitHeader.PermitStatus = TPermitStatus;
     ELSE
       MESSAGE 'ManageEquipment Frame improperly called.  Programming error.';
       RETURN PU_CANCEL;
    ENDIF;

    SelectEquip.Clear();
    i = 1;
    REPEATED
    SELECT  :SelectEquip[i].Equip = O.Object, 
            :SelectEquip[i].EquipName = O.Name,
            :SelectEquip[i].EquipClass  = O.Type,
            :SelectEquip[i].EquipClassName  = O.TypeName,
            :SelectEquip[i].Description = O.Description,
            :SelectEquip[i].Substation = O.PrimaryGrouping,
            :SelectEquip[i].SubstationName = O.PrimaryGroupingName,
            :SelectEquip[i].RelayType = J.Job,  /*Hiding Permit ID*/
            :SelectEquip[i].Goal = L.Goal  
    FROM    Udb_Object O,
            SOA_JobControl JC,
            SOA_Job J,
	    SLC_WPEquipLinks L
    WHERE   JC.Card = :Card AND
            JC.Job = J.Job AND
            J.Status IN ('',:JobStatus$NIS) AND
            J.Job = L.PermitJobID AND
	    L.LinkEquip = O.Object 
    ORDER BY SubstationName, EquipClassName, EquipName   
/*
** Substation Order is important for connectivity problem insertion
*/                  
    BEGIN
/*
**  If Function = 3 (completing permit), then parse by permitJob
*/
       IF (Function = PermitObjective$Completion AND 
           PermitJob = SelectEquip[i].RelayType) OR
           Function = PermitObjective$Connectivity OR 
           Function = PermitObjective$Document THEN
      
           Connected = 0;
           REPEATED
           SELECT  :Connected = Node 
           FROM    Udb_Terminal
           WHERE   Object = :SelectEquip[i].Equip AND
                   Node > 0;
           IF Connected > 0 THEN
/*
** If equipment was previously not connected, we must handle any NIS moves
** that might exist for this equipment.
*/
              IF SelectEquip[i].Goal = Goal$PlaceInService THEN
                 CurFrame.SendUserEvent (EventName = 'RemoveNIS',
                                         MessageInteger = SelectEquip[i].Equip);
              ENDIF;
              SelectEquip[i].InServiceOutService = 1;
           ELSE
/*
** If equipment was previously connected, we must handle mark any moves
** that might exist for this equipment as NIS.
*/
              IF SelectEquip[i].Goal = Goal$RemoveFromService THEN
                 CurFrame.SendUserEvent (EventName = 'MarkNIS',
                                         MessageInteger = SelectEquip[i].Equip);
              ENDIF;
              SelectEquip[i].InServiceOutService = 0;
           ENDIF;            
           i = i + 1;   /*Put here on purpose*/
       ELSE
/*
**  Since row should not be included, explicitly remove it here.  Inadvertently
**  including incorrect row if it is the last one.
*/            
          SelectEquip.RemoveRow(rownumber = i);
       ENDIF;

    END;    

    IF i = 1 THEN
       IF Function = PermitObjective$Completion THEN
          RETURN PU_OK;
       ELSE
          MESSAGE 'No Equipment on this card is linked to a permit for ' +
                  'Connection/Disconnect or Documenation.';
          RETURN PU_CANCEL;
       ENDIF;
    ELSE
       CurFrame.SendUserEvent(EventName = 'UpdateStatus');
    ENDIF;

END;


ON UserEvent 'RemoveNIS' =
BEGIN
/*
** Equipment is connected, any moves that are NIS moves must now be enabled
** everywhere where the equipment exists.
*/
   NISEquip = CurFrame.MessageInteger;

   IF NISEquip = 0 THEN
      MESSAGE 'Error retrieving connected equipment ID necessary to activate ' +
              'NIS moves.';
      RESUME;
   ENDIF;
 
   RetCode = CALLPROC SOA_NISMoveUpd (
                    Equip = NISEquip 
                   ,Card = Card          
                   ,Status = ''
                   ,Remark = 'Connected');
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error marking moves as Connected.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Select all NIS moves on the equip and insert them where they belong.
*/
   i = 1;
   REPEATED 
   SELECT   :NISJob[i].Job = J.Job,
            :NISJob[i].JobClass = J.JobClass,
            :NISJob[i].Substation = J.Substation,
            :NISJob[i].Equip = J.Equip,
            :NISJob[i].EquipClass = J.EquipClass
   FROM     SOA_JobControl JC,
            SOA_Job J
   WHERE    JC.Card = :NIS$Card AND
            JC.Job = J.Job AND
            J.Equip = :NISEquip
   BEGIN
      i = i + 1;
   END;

   i = 1; 
   WHILE i <= NISJob.LastRow() DO

      ControlInsert.Application = CurrentApplication;
      ControlInsert.SwitchingItem = 0;
      ControlInsert.Card = Card;
      ControlInsert.StepLevel = 0;
      ControlInsert.PrintID = '';
/*
** Make sure move does not appear in another SwitchingItem
*/
            
      IF CurrentApplication = Application$SLC THEN  

         REPEATED 
         SELECT   :ControlInsert.SwitchingItem = JC.SwitchingItem
         FROM     SOA_Job J,
                  SOA_JobControl JC
         WHERE    JC.Card = :Card AND
                  JC.Job = J.Job AND
                  J.Status = '' AND
                  J.SwItemStatus = :Card$Active AND
                  J.Equip = :NISJob[i].Equip;

         IF ControlInsert.SwitchingItem = 0 THEN
            ControlInsert.SwitchingItem = PermitSwItem;
         ENDIF;

      ENDIF;

      REPEATED 
      SELECT  DISTINCT  
            :ControlInsert.TypeOfCard = AC.TypeOfCard,
            :ControlInsert.StepHeading = JCC.StepPair,
            :ControlInsert.MoveEquipClass = JCC.EquipClass
      FROM   SOA_ActiveCard AC,
             FMS_JobClassControl JCC
      WHERE  AC.Card = :Card AND
             AC.TypeOfCard = JCC.TypeOfCard AND
             JCC.JobClass = :NISJob[i].JobClass AND
             JCC.PreferredStep = :TRUE AND
            :NISJob[i].EquipClass IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = JCC.EquipClass);
/*
**  Insert Just into this card then cascade as necessary
*/

      RetCode = NISJob[i].InsertControl (
               ControlEntry = ControlInsert,
               InitiatingCard = Card);
            
      IF RetCode = PU_CANCEL THEN
              MESSAGE 'Error inserting NIS move.'; 
              i = i + 1;
              CONTINUE;
      ENDIF;         

          Idx.Clear();
          Idx = CALLPROC CascadeMoves (Move = NISJob[i],
                                       Card = Card
                                     );

#         include ManageImpactedCards

          i = i + 1;
   ENDWHILE;

#  include NotifyImpactedCards

   RetCode = CALLPROC SOA_NISMoveDel (
                    Equip = NISEquip,
                    Card = NIS$Card);           
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error removing NIS moves from NIS card.';
   ENDIF;
   CALLPROC DDB_COMMIT;
   SOAFrame.SendUserEvent (EventName =  'LoadJobs');
END;


ON UserEvent 'MarkNIS' =
BEGIN
/*
** Equipment is disconnected, any equipment moves must now be marked as NIS.
*/
   NISEquip = CurFrame.MessageInteger;

   IF NISEquip = 0 THEN
      MESSAGE 'Error retrieving connected equipment ID necessary to activate ' +
              'NIS moves.';
      RESUME;
   ENDIF;

   RetCode = CALLPROC SOA_NISMoveUpd (
                    Equip = NISEquip  
                   ,Status = JobStatus$NIS
                   ,Remark = 'Disconnected');
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error marking moves as Disconnected.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   SOAFrame.SendUserEvent (EventName =  'LoadJobs');
END;

/**
 **  Handle an equip selection from the list
 **/
ON ChildEntry SelectEquip =
BEGIN
/*
** Set row index for subsequent processing.
*/
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;

    SelectedRow = FIELD(SelectEquip).CurRow;
    IF SelectedRow = 0 THEN
       MESSAGE 'Error selecting row';
    ENDIF; 
END;

/**
 **  Update the Missing Documents indicator
 **/
ON USEREVENT 'UpdateStatus' =
BEGIN
/*
** Are documents missing.  Two pass check - If no row, then Missing = TRUE.
** If row and status = missing, then Missing = TRUE.  Possible to have multiple
** rows per equip, some with missing some without.
*/
   FOR i = 1 TO SelectEquip.LastRow() DO
 
           Connected = 0;
           REPEATED
           SELECT  :Connected = Equip
           FROM    SLC_Document
           WHERE   Equip = :SelectEquip[i].Equip;

           IF Connected > 0 THEN
              Connected = 0;
              REPEATED
              SELECT  :Connected = Equip
              FROM    SLC_Document
              WHERE   Equip = :SelectEquip[i].Equip AND
		      Status = :Document$Missing;

              IF Connected = 0 THEN
                 SelectEquip[i].MissingDocuments = FALSE;
              ELSE
                 SelectEquip[i].MissingDocuments = TRUE;
              ENDIF;
           ELSE
              SelectEquip[i].MissingDocuments = TRUE;
           ENDIF;   
   ENDFOR;
END;


/**
 **  Handle a Show Documents click
 **/
ON CLICK ShowDoc =
BEGIN
    IF SelectedRow = 0 THEN
       MESSAGE 'Must select an equipment row.';
       RESUME;
    ENDIF;

    CALLFRAME EquipmentDocuments ( 
                  Object = IFNULL(SelectEquip[SelectedRow].Equip,0),
                  Goal = SelectEquip[SelectedRow].Goal);
    CurFrame.SendUserEvent( EventName = 'UpdateStatus');   
END;
 

ON CLICK Connectivity_Btn = 
BEGIN
/*
**  Call up PV for selected substation
*/
    IF SelectedRow = 0 THEN
       MESSAGE 'Must select a substation/equipment row.';
       RESUME;
    ENDIF;
/*
**  Confirm we have a substation
*/   
    SubstationVerified = FALSE;
    SELECT :SubstationVerified = Object
    FROM   Udb_Object 
    WHERE  Type = :Type$Substation AND
           Name = :SelectEquip[SelectedRow].SubstationName;

    IF SubstationVerified <> SelectEquip[SelectedRow].Substation THEN
       MESSAGE 'Substation Name Problem, unable to call PowerVisuals.';
       RESUME;
    ENDIF;

    IF CurFrame.ConfirmPopup (MessageText = 'Will call PowerVisuals for ' +
         'substation ' + SelectEquip[SelectedRow].SubstationName + '?') = 
         PU_OK THEN
    
       PV_Command =  PVDir + '/pvstart -station ' + 
                             SelectEquip[SelectedRow].SubstationName + 
                             ' -stationPK ' +
                             varchar(SelectEquip[SelectedRow].Substation) +
                             ' -db1 ' + DDB_Global.Session.Cur.Database + 
                             ' -db2 ' + DDB_Global.Session.Cur.Database;

       CurFrame.Trace (text = PV_Command);
       CALL SYSTEM :PV_Command;
/*
**  Waste some time, giving the PV Monitor a chance to update the database.
*/
       i = 1;
       WHILE i < 100000 DO
          IF i = i THEN
             i = i + 1;
          ENDIF;
       ENDWHILE;

       MESSAGE 'Once control is returned from PowerVisuals, we have to wait a' +
               ' moment so that the Connectivity changes can be reflected ' +
               'in the database, then we will update the equipment ' +
               '"Connection?" status and you will be able to continue.';

#      INCLUDE ManageEquipUpdateConnectivity
   ENDIF;
END;


/**
 **  Handle an OK click
 **/
ON Click OK_Btn =
BEGIN
/*
**  IF Completing Permits, verify that goals have been achieved and
**  documentation is not missing.
*/
   CurFrame.PurgeUserEvent (EventName = 'CheckComplete');
   IF Function = PermitObjective$Connectivity OR 
      Function = PermitObjective$Document THEN
      RETURN PU_OK;
   ENDIF;
/*
** Documentation
*/
   FOR i = 1 TO SelectEquip.LastRow() DO
      IF SelectEquip[i].MissingDocuments = TRUE THEN
            RetCode = CALLPROC WarningOverride (
                 Card = Card,
                 SwitchingItem = PermitSwItem,
                 Job = PermitJob,
                 WarningText = 'Equip ' +  SelectEquip[i].EquipClassName +
                   '  ' + SelectEquip[i].EquipName + ' is missing ' +
                   'documentation.');
            IF RetCode = PU_CANCEL THEN
               RESUME;
            ENDIF;
      ENDIF;
   ENDFOR;    
/*
**  Bus Link
*/
   FOR i = 1 TO SelectEquip.LastRow() DO
      IF SelectEquip[i].Goal = Goal$InsertBusLink OR
           SelectEquip[i].Goal = Goal$RemoveBusLink THEN

         RetCode = CALLFRAME Confirm (
                           Card = Card, 
                           Job = PermitJob,
                           SwitchingItem = PermitSwItem,
                           Text = 'Have the necessary Bus Link connectivity ' +
                                  'changes been completed?');
         IF RetCode = PU_CANCEL THEN
               Message 'You may use PowerVisuals to make necessary Bus Link ' +
                       'connectivity changes.';
               RESUME;
         ENDIF;

         ENDLOOP;
      ENDIF;
   ENDFOR;    

/*
** Connectivity
*/
   IncidentSubstation = 0;
   FOR i = 1 TO SelectEquip.LastRow() DO
      IF (SelectEquip[i].InServiceOutService = 1 AND 
           SelectEquip[i].Goal = Goal$RemoveFromService) OR
         (SelectEquip[i].InServiceOutService = 0 AND 
           SelectEquip[i].Goal = Goal$PlaceInService) THEN 
/*
** Goal not complete, let's verify by loading again and rechecking
*/
#         INCLUDE ManageEquipUpdateConnectivity

          IF (SelectEquip[i].InServiceOutService = 1 AND 
                SelectEquip[i].Goal = Goal$RemoveFromService) OR
             (SelectEquip[i].InServiceOutService = 0 AND 
                SelectEquip[i].Goal = Goal$PlaceInService) THEN 

               IF SelectEquip[i].Goal = Goal$RemoveFromService THEN
                  PermitGoal = 'To Disconnect';
               ELSE
                  PermitGoal = 'To Connect';
               ENDIF;

             IF IncidentSubstation <> SelectEquip[i].Substation THEN 

               IF CurFrame.ConfirmPopup (MessageText = 'Permit '+                                 'connectivity changes have not been completed.' +
                 '  Selecting OK will allow ' +
                 'you to complete the permit but will flag a ' +
                 'connectivity problem for substation: ' +
                 SelectEquip[i].SubstationName + '.  Selecting Cancel will ' +
                 'stop processing and allow you to use PowerVisuals to ' +
                 'make the proper connectivity change.') = PU_CANCEL THEN
 
                 RESUME;

               ENDIF;
             ENDIF;
/*
**  Share code from Connectivity Problem.  Not Object-Oriented, but oh well.
*/
                IncidentSubstation = SelectEquip[i].Substation;
                IncidentDate = date('now');
                RetCode = CALLPROC SOA_ConnProbIns (
                      Substation = IncidentSubstation,
                      IncidentDate = Incidentdate );
  
                IF RetCode <> 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Error inserting new connectivity problem incident.';
                   RESUME;
                ENDIF;
                CALLPROC DDB_COMMIT;

                RetCode = CALLPROC SOA_ConnProbUpd (
                       Substation = IncidentSubstation,
                       IncidentDate = IncidentDate,
                       IncidentNote = 'Did not make scheduled connectivity ' +
                         'changes when completing a permit.' + HC_NEWLINE +
                         'Permit "' + SQUEEZE(PermitHeader.PermitMove) + 
                         '" completed ' + 'with status "' + 
                         PermitHeader.PermitStatus + '" had completion ' +
                         'objective "' + PermitGoal + '" the equipment ' +
                         'linked to this incident.  That objective was ' +
                         'not met at the time of Permit Completion.' 
                        );

                IF RetCode <> 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Error: Unable to update incident note.';
                   RESUME;
                ENDIF; 
                CALLPROC DDB_COMMIT;   

             RetCode = SOA_ConnProbEquipIns (
                    Substation = IncidentSubstation,
                    IncidentDate = IncidentDate,
                    EquipObject = SelectEquip[i].Equip);

             IF RetCode <> 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Error: Unable to link equip to incident.';
                   RESUME;
             ENDIF;
             CALLPROC DDB_COMMIT;   
          ENDIF;
      ENDIF;
   ENDFOR;
/*
** Because we may have raised the NIS events. We postpone our RETURN to
** all other UserEvents to complete.
*/
   CurFrame.SendUserEvent (EventName = 'ReturnOK');
END;

ON UserEvent 'ReturnOK' = 
BEGIN
   RETURN PU_OK;
END;
 
