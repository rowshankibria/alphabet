	Name:            InsertDBEventQueue

/*
**      Copyright c 2007 Pateric Software LLC. All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written 
**      permission from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Frame:          InsertDBEventQueue
** 
**  Date:     Version  Description 
** ------------------------------------------------- 
**  04/13/06   ysp  Created
**  05/30/07   pkw  Send event name and eventtext to make messages backward compatible.
**  04/29/09   ysp  When having problem inserting an event, RRMsgID may be out of synch
**  09/22/09   ysp  Add events for Email and OSWP monitors.
**  06/23/10   ysp  replace FMS_OSWPDBEvent with FMS_TaskDBEvent
**  09/09/10   ysp  updated to use InterfaceDBEvent class
*/
PROCEDURE InsertDBEventQueue
(
   EventName = VARCHAR(32) NOT NULL WITH DEFAULT;
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   ToApp = VARCHAR(10) NOT NULL WITH DEFAULT;
) =
declare
   EventObject = InterfaceDBEvent;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
   EventObject.Name = EventName;
   EventObject.Text = EventText;
   EventObject.ToApp = ToApp;
   EventObject.FromApp = CurrentApplication;

   EventObject.InsertEvent();
 
   IF EventObject.ID <= 0 THEN
      CALLPROC TraceError (
                  UserMessage = EventObject.ErrorMessage,
                  TraceMessage = VARCHAR(DATE('NOW')) + ': InsertDBEventQueue; Failed to insert queue for Event = ' + 
                       EventName + ', Text = ' + EventText);                  
      RETURN PU_CANCEL;
   ELSE
      RETURN PU_OK;
   ENDIF;              
END;

Application Component Report
============================

	Name:            InsertJobsRow

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**  05/05/92   em       Added new parm to handle BackFromWork exception
**                      must keep TOIssued time in this situation.  (#14)
**  05/05/92   em       Added Card as parm to handle bifurcated feeder error.
**                      (#15c)
**  05/10/92   em       Modified sort order for row insertion.
**                      (#15a)
**  08/17/92    em      (ON-SITE) Added Feeder Status Fields to insert 
**          			statements.exit
**  01/Sep/92   rg      Removed Step complete logic as Phase 2 commences.
**  10/20/92    em      Modified to support integer/udb.
**  10/29/92    rg      Modified tables to reflect new fields.
**  11/09/92    em      Update Deadmoves count on card if new movetype is
**                      'Dead'.  Note: Card Table DeadMoves field updated
**                      by rule/procedure following insert to FMS_Job.
**  12/06/92    gc      Updated to call dbrocs for ddb
**  12/11/92    em      fixed bug - potential to add row at bottom of card
**                      gets array out of sequence when generating new row
**                      number.                                      
**  12/19/92    gjc     Added columns TO-RS MoveRules to db proc calls (#25).
**  12/22/92    em      changed db procedure for job insert to generate job
**                      key. returned job key gets handled here.
**  12/30/92    em      set TO/RS Complete times to NULL before insert.    
**  01/16/93    em      removed update of deadmovecount.  handled via dbevent.
**  01/31/93    em      added new parameter PermitJob, if not zero, carry 
**                      protections forward with new job.
**  02/25/93    em      avoid trying insert at zero
**  03/08/93    em      remove PermitJob, don't carry protections with new job.
**  03/15/93    em      removed commit from bottom.
**  05/07/93    em      log row insertion
**  05/31/93    em      add parameter to regulate job insertion. don't want 
**                      to insert job into all cards based on common equip.
**  10/18/93    em      Confirm insertion if outstanding move for equip and
**                      jobclass already exists.
**  11/05/93    gjc     Cleaned up after failure to insert job. Deleted the
**                      row that had been added to the Jobs array.
**  11/29/93    em      manipulative tostep (duplicateseq) sequencing for
**                      duplicate moves
**  12/08/93    em      add bypass parameter to bypass duplicate move message
**  12/17/93    em      grab equip ground count for Move G field
**  12/20/93    em      set up move using move rules; if inserting into open
**                      card, check if move exists on an active/OTW card.  If
**                      it does, display message and stop insert.  Move will
**                      be picked up when card is activated.  Common equipment
**                      insert also changed to insert moves into Open cards.
**                      Need to do whatever it takes to keep common moves on
**                      common equipment cards.
**  12/23/93    em      Refined error messages
**  01/04/94    em      avoid equip = 0 in open card inserts
**  02/10/94    em      duplicate move insertion, always choose new tostep,
**                      even if no outstanding moves.  Undo capability forces
**                      this issue.
**  03/31/94    bh      inhibit messages for background processes
**  04/27/94    em      added Move Origin
**  05/13/94    em      disallow common move insertion if move is inserted into
**                      open card 
**  05/20/94    em      undo partial 12/20 work, don't display message or stop 
**                      insert of common move into open card when feeder has
**                      already has active card. 
**  10/26/94    em      added move equip class parm to job insertion
**  12/22/94    em      special ground move logic, if new move tostep = -99
**                      don't set times to NULL
**   01/25/00   em    Removed sequencing code since it was possible to reuse
**                    same sequence if many rows were being inserted, not
**                    recognizing that the database had performed a
**                    resequence operation.  Insert all moves with seq = -1
**   02/09/00   em    Previous fix caused problem in that Jobs array is not 
**                    being refreshed automatically on move insertion.  Since
**                    the InsertJobsRow procedure is used whenever a new move
**                    is inserted (Phase Check, Caution, From Work, etc.), 
**                    raise the load_jobs event for the FCFrame Global here.
**  07/12/02    ysp   Merge: Use Job class to insert jobs; 
**                    Remove passed-in Job array; 
**                    Return list of impacted cards.  
**  09/04/02    ysp   Merge: Remove ActivityIdentifier from passed-in
**                    parameters.
**  09/06/02    em    Use CascadeMoves to propagate new move. 
**  01/07/03    em    Removed BackFromWork input parm.
**                    BackFromWork prompts have been moved to CAC.
**  01/15/03    em    Remove LogIns; already being done in InsertControl 
**  01/22/03    pkw   Remove ImpactedCards array because ImpactedCardlist
**                    was always getting overwritten by it. 
**  01/23/03    em    Added NotShadowITem parameter to pass to cascade moves. 
**  04/07/05    ysp   Allow inserting N moves into open cards.	
**  10/14/05    em    Convert all messages into TraceError calls since Phase Check
**                    move may be inserted during automation.	
**  08/13/09    em    Only give duplicate move message if dupe is outstanding	
**  03/28/11    pkw   Modified for 3G updates.
*/
PROCEDURE InsertJobsRow (
/* passed in */
    NewJob = Job,						
    C = FMS_Card,				
    ByPassDuplicateMessage = INTEGER NOT NULL WITH DEFAULT,
    NotShadowItem = INTEGER NOT NULL WITH DEFAULT,
    SingleCardInsertion = INTEGER NOT NULL WITH DEFAULT,
    ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
    OriginalTOStep = INTEGER NOT NULL WITH DEFAULT,

/* local variables */
    ControlEntry = ARRAY OF NewMoveCard,
    i = INTEGER NOT NULL WITH DEFAULT,
    k              = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
    m              = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
    n              = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
    Idx            = ARRAY OF IntegerObject; /*Track impacted cards*/
    MoveExists = INTEGER NOT NULL WITH DEFAULT,
    RetCode = INTEGER NOT NULL WITH DEFAULT

)=
BEGIN
/*
**      Check for a duplicate.  Set TOStep Sequence. 
*/
    IF OriginalTOStep <> TRUE AND NewJob.MoveCategory <> MoveCategory$Fake THEN
/*
**  Don't check for outstanding moves, just move existence.
**  Undo feature requires entirely new tostep.
*/
      REPEATED
      SELECT :MoveExists = COUNT(*)
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :C.Card AND
             JC.Job = J.Job AND
             J.Equip = :NewJob.Equip AND
             J.JobClass = :NewJob.JobClass AND
            (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Status = '';
    
      IF MoveExists > 0 AND ByPassDuplicateMessage = FALSE THEN

        IF CurProcedure.ConfirmPopup (MessageText = '''' +
           NewJob.PrintID + ' ' + NewJob.EquipClassName + ' ' +
           NewJob.EquipName + '   ' + NewJob.TOMove + '''' +
           ' is a duplicate move.  The card already ' +
           'includes this move for this equipment. ' +
           'Click OK to insert the ' +
           'duplicate - or click Cancel to stop the insert.') <> PU_OK THEN
           RETURN NULL;
        ENDIF;

      ENDIF;

    ENDIF;
/*
**  If an open card, move should be inserted into only the open card.
**  Also, make the ControlCard the current card to influence subsequent
**  database procedure job insertion process (quote from soa)
*/  
    IF C.Status = Card$Open THEN
       SingleCardInsertion = TRUE;
       NewJob.ControlCard = C.Card;
    ELSE
       NewJob.ControlCard = 0;       
    ENDIF;

    IF NewJob.MoveCategory <> MoveCategory$Fake THEN
       /*
       **  If an OPEN card, look for move on Active/OTW card.  If it
       **  exists, don't allow insert.
       */
       IF C.Status = Card$Open AND NewJob.Equip <> Object$Null THEN

          REPEATED
          SELECT  :MoveExists = COUNT(*)
          FROM    SOA_ActiveObject AO,
                  SOA_JobControl JC,
                  SOA_Job J,
                  TFMS_CardToObject CTO
          WHERE   CTO.Card = :C.Card AND
              CTO.Object = AO.Object AND
              AO.ObjectToCardLink = 1 AND
              AO.Card = JC.Card AND
              JC.Job = J.Job AND
              J.Status = '' AND
              (J.RSComplete IS NULL OR J.TOComplete IS NULL) AND
              J.Equip = :NewJob.Equip AND
              J.JobClass = :NewJob.JobClass;
 
         IF MoveExists > 0 THEN
   
            IF (DDB_Global.InhibitMessages = FALSE) THEN
               Message NewJob.PrintID + ' ' + NewJob.EquipClassName + ' ' +
                 NewJob.EquipName + '   ' + NewJob.TOMove +
                 ' is a move which already exists on an active/OTW card for an ' +
                 'associated feeder (due to common ' +
                 'equipment).  The move will automatically be added ' +
                 'to this card when this card is activated - thus it ' +
                 'will not be inserted at this time.';
            ENDIF;
            
            RETURN NULL;
                                                 
         ENDIF;
       ENDIF;     
/*
**  If a "fake" move, leave existing issue/complete timestamps. 
*/
       NewJob.TOOperator = NULL;
       NewJob.TOIssued   = NULL;
       NewJob.TOComplete = NULL;
       NewJob.RSOperator = NULL;
       NewJob.RSIssued   = NULL;
       NewJob.RSComplete = NULL;
    ENDIF;
/*  
**	Load it into the database and update the object key in the array.
*/
    NewJob.Job = -1;
    NewJob.Seq = -1;
    NewJob.Job = NewJob.InsertJob (Card = NewJob.Card);

    IF NewJob.Job < 0 THEN     /* Error Occurred */
       IF (DDB_Global.InhibitMessages = FALSE) THEN
              Message 'Error while inserting New Move: ' + 
                   NewJob.PrintID + ' ' + NewJob.EquipClassName + ' ' +
                   NewJob.EquipName + '   ' + NewJob.TOMove +
                   '.  The insert has failed.';
       ELSE
               CurProcedure.Trace (Text = varchar(date('now')) +
                   ' - Error while inserting New Move: ' + 
                   NewJob.PrintID + ' ' + NewJob.EquipClassName + ' ' +
                   NewJob.EquipName + '   ' + NewJob.TOMove +
                   '.  The insert has failed.');

       ENDIF;
       RETURN NULL;
    ENDIF;

    ControlEntry[1].Card = NewJob.Card;
    ControlEntry[1].Seq = 0;
    ControlEntry[1].SwitchingItem = 0;
    ControlEntry[1].Application = Application$FMS;
    ControlEntry[1].StepHeading = NewJob.StepPair;
    ControlEntry[1].TypeOfCard = C.TypeOfCard;
    ControlEntry[1].MoveEquipClass = NewJob.MoveEquipClass;
    ControlEntry[1].StepLevel = 0;
    ControlEntry[1].PrintID = NewJob.PrintID;

    RetCode = NewJob.InsertControl (
               ControlEntry = ControlEntry[1],
               InitiatingCard = NewJob.Card);

    IF RetCode = PU_CANCEL THEN
       CALLPROC TraceError (UserMessage = 
             'PROCEDURE:InsertNewJob; ' +
             'Failure inserting FMS move into SOA_JobControl.',
                           TraceMessage =
             'Failure inserting FMS move into SOA_JobControl.'
             );
       RETURN NULL;
    ENDIF;

    ImpactedCardList.Clear();
    ImpactedCardList.InsertRow (rownumber = 1);
    ImpactedCardList[1].Value = NewJob.Card;
/*
**   Insert the new job into any card that is active and whose feeder contains the 
**   equipment.
*/ 
    IF SingleCardInsertion = FALSE THEN

         Idx.Clear();
         Idx = CALLPROC CascadeMoves (Move = NewJob,
                                      Card = NewJob.Card,                                                               NotShadowItem = NotShadowItem
                                      );

#        include ManageImpactedCards

    ENDIF;

    FCFrame.SendUserEvent (EventName = 'load_jobs'); 
    RETURN NewJob.Job;
END;

Application Component Report
============================

	Name:            InsertKPSException

/*
**
**      Copyright c 2020 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Procedure:      InsertKPSException
**
**  Date:   Version Description
** ----------------------------------
**  03/24/20  em    Created
**                  If picking up KPS Equipment to a feeder that has a diagram
**                  insert KPS Exception for DO to link KPS to a manhole after 
**                  the manhole has been added to the diagram via the pvl Update process.
*/
procedure InsertKPSException
(
   Equip  = FMS_Equip; 

) =
declare
   CustomComment = VARCHAR(80) NOT NULL WITH DEFAULT;
   FeederDiagram = INTEGER NOT NULL WITH DEFAULT;
   IsItKPS = INTEGER NOT NULL WITH DEFAULT;
   IsItOnDiagram = INTEGER NOT NULL WITH DEFAULT;
   MainFeeder = INTEGER NOT NULL WITH DEFAULT;
   MainFeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeOfFeeder = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
/*
** Check the equipment type, looking for KPS type only
*/
   IsItKPS = 0;
   SELECT :IsItKPS = Type
   FROM   Udb_ExtendedType
   WHERE  Type = :Equip.EquipClass AND
          SuperType = :Type$KPS;
          
   IF IsItKPS = 0 THEN
      RETURN;
   ENDIF;
/*
** Is it on a regular feeder or ISO feeder, check if Feeder has a diagram
*/              
   SELECT :TypeOfFeeder = Type
   FROM   Udb_Object
   WHERE  Object = :Equip.Feeder;
   
   FeederDiagram = 0;                  
   IF TypeOfFeeder = Type$ISOFeeder THEN
      SELECT :FeederDiagram = G.Grouping,
             :MainFeeder = G1.Grouping,
             :MainFeederName = O.Name
      FROM   Udb_Grouping G,
             Udb_Grouping G1,
             Udb_Object O
      WHERE  G1.Member = :Equip.Feeder AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping = G.Member AND
             G1.Grouping = O.Object AND
             G.Relationship = :Interaction$ShownOn AND
             G.GroupingType = :Type$FeederDiagram;
   
      CustomComment = 'Existing ISO Equip not found in pvl Data';
   ELSE
      CustomComment = 'Existing Feeder Equip not found in pvl Data';
      SELECT :FeederDiagram = G.Grouping
      FROM   Udb_Grouping G
      WHERE  G.Member = :Equip.Feeder AND
             G.Relationship = :Interaction$ShownOn AND
             G.GroupingType = :Type$FeederDiagram;
      MainFeeder = Equip.Feeder;
      MainFeederName = Equip.FeederName;       
   ENDIF;
   
   IF FeederDiagram = 0 THEN
      RETURN;
   ENDIF;
   
   IsItOnDiagram = 0;
   SELECT :IsItOnDiagram = Object 
   FROM   DSO_Object 
   WHERE  Pocket = :FeederDiagram AND
          Object = :Equip.Equip;
          
   IF IsItOnDiagram > 0 THEN
      RETURN;
   ENDIF;
/*
** Insert exception record
*/              
   RetCode = CALLPROC pvl_XRefExceptionIns (
                 Timestamp = DATE('now'),
                 Source = 'udb',
                 Feeder = MainFeeder,
				 FeederName = MainFeederName,
				 Object = Equip.Equip,
				 TypeName = Equip.EquipClassName,
				 Name = Equip.EquipName,
                 Comment = CustomComment 
                 );
                 
              IF RetCode = 0 THEN
                 CALLPROC DDB_COMMIT;
              ELSE
                 CALLPROC DDB_ROLLBACK;
	             CurProcedure.Trace(Text= 
                   'Failed to insert XRef Exception for Feeder ' + MainFeederName);
              ENDIF;
   
END;

Application Component Report
============================

	Name:            InsertObjectLink

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**  01/27/98    pkw     Modified TFMS Version to get all values and 
**                      insert at the end.
**  08/25/98    em      Add warning when no EN-DE-EN.
**                      Corrected Dynamic Where Clause SQL errors.
**  02/19/99    em      Modified Breaker Type lookup.
**  05/17/99    em      Changed breaker type from Type$Breaker to 
**                      Type$LoadBreaking
**  06/04/99    em      Special Note if this processing is ever modified -
**                      much of it is duplicated in the SplitLine and Xfer
**                      process.
**  09/08/99    em      Choose line/feeder list based on ACLineSegment/Jumper.
**                      This is done to prevent subsequent card creation on
**                      Split Line cards where common equipment is found on 
**                      the Bus Section.
**  11/02/99    em      Modified to receive list of Breakers and list of
**                      Line Segments found in previous connectivity trace.
**                      Determine lines from the Line Segments.  If any lines
**                      are on an active cards, we will display the list of
**                      and ask user which ones should appear on the card.
**  05/30/00    em      Include subtypes of ACLineSegment where appropriate
**  06/08/00    em      Use LineList to get list of Substations for card instead
**                      of Line Seg list.  Get the primarygrouping for all
**                      equipment that is a member of the line and make sure 
**                      those primary groupings are just substations.
**  09/18/00    em      Adjust the ConnectedBreakers list based on the LineList
**                      if we had to call DetermineScope.  ConnectedBreaker
**                      list will be passed back to be used for the Breaker
**                      Preload Engine and for Normal/Abnormal
**                      trip selection if card type is Auto. 
**  09/21/00    em      If CardClass = Auto, don't let Determine LineSegment
**                      include lines taht are on an active card.
**  11/15/00    em      Changed logic around DetermineLineScope. If no lines, 
**                      no card.
**  01/30/01    em      Connected Breakers list index incorrect after Determine
**                      Line Scope
**  07/30/07    ysp     Add support of Black Start cards
**  12/04/07    ysp     Add all end substations of lines in a black start scenario 
**                      into the cardobjects.
*/
PROCEDURE InsertObjectLink (
    CardDetails = CardTFMS;  /*Passed Card Object*/
    ConnectedBreakers = ARRAY OF ConnectedEquipClass;   /*Passed in */
    ConnectedLineSegs = ARRAY OF ConnectedEquipClass;   /*Passed in */

    i = INTEGER NOT NULL WITH DEFAULT,
    j = INTEGER NOT NULL WITH DEFAULT,
    x = INTEGER NOT NULL WITH DEFAULT,
    MaxKv = INTEGER NOT NULL WITH DEFAULT,
    DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
    MiscWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
    LinesWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
    SubstationList = ARRAY of ObjectSummaryClass;
    ENDEENList = ARRAY of ObjectSummaryClass;
    SelectedENDEEN = INTEGER NOT NULL WITH DEFAULT;
    Status = Integer;                   /* Return status */
    FeederNames = VARCHAR(500) NOT NULL;
    SubstationNames = VARCHAR(800) NOT NULL;
    TempENDEEN = INTEGER NOT NULL;
    LastRow = INTEGER NOT NULL WITH DEFAULT;
    LineList = ARRAY OF ObjectSummaryClass;
    ActiveCardFlag = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
)=
BEGIN
/*
** Get the lines for the LineSegments
*/
   LastRow = ConnectedLineSegs.LastRow();  
   IF LastRow = 0 AND CardDetails.CardClass <> Type$TFMSBLCK THEN
      MESSAGE 'Connectivity Trace did not find any valid lines to build ' +
              'a card.';
      RETURN PU_CANCEL;
   ENDIF;
 
   MiscWhereClause = '';
   IF LastRow > 0 THEN
      FOR i = 1 TO LastRow DO
          IF i = 1 THEN
             MiscWhereClause = '(' + VARCHAR(ConnectedLineSegs[i].Object);
          ELSE    
             MiscWhereClause = MiscWhereClause + ',' +
                               VARCHAR(ConnectedLineSegs[i].Object);
          ENDIF;
      ENDFOR;
      MiscWhereClause = MiscWhereClause + ')';

      DynamicWhereClause = 'G.Member IN ' + MiscWhereClause + ' AND ' +
                           'G.Relationship = ' + VARCHAR(Interaction$MemberOf) +
                           ' AND G.Grouping = O.Object AND O.Type = ' +
                           VARCHAR(Type$Line);  
      /*
      ** Use PrimaryGroupingName field for ValidatedBy information.
      */
      i = 1;
      LineList.Clear();
      SELECT DISTINCT
             :LineList[i].Object = O.Object,
             :LineList[i].Name = O.Name,
             :LineList[i].PrimaryGroupingName = O.ValidatedBy
      FROM   Udb_Object O,
             Udb_Grouping G
      WHERE  :DynamicWhereClause
      ORDER BY 2
      BEGIN  
         IF i = 1 THEN 
            FeederNames = varchar(LineList[i].Name);
         ELSE
            FeederNames = FeederNames + ',  ' + varchar(LineList[i].Name);
         ENDIF;
         i = i + 1;
      END;

      IF i = 1 THEN
         MESSAGE 'Error in InsertObjectLink: Line Segments do not map to Transmission Lines.';
         RETURN PU_CANCEL;
      ENDIF;
      /*
      ** D.O. can create black start cards. But for other types of card, check 
      ** if any of these lines is on an active card, if so present user with
      ** selection list.  Using BaseType Field
      ** of ObjectSummaryClass to hold true false information regarding whether
      ** an active card for the object exists.
      */
      ActiveCardFlag = FALSE;
      IF CardDetails.CardClass <> Type$TFMSBLCK THEN
         FOR i = 1 TO LineList.LastRow() DO
            x = 0;
            SELECT  :x = Card
            FROM    SOA_ActiveObject
            WHERE   Object = :LineList[i].Object AND
                    ObjectToCardLink = :TRUE;
            IF x > 0 THEN
               LineList[i].BaseType = TRUE;
               ActiveCardFlag = TRUE;
            ELSE          
               LineList[i].BaseType = FALSE;
            ENDIF; 
         ENDFOR;

         IF ActiveCardFlag = TRUE THEN
            /*
            ** Select lines to include on card
            */
            CALLFRAME DetermineLineScope (LineList = LineList,
                                          CardClass = CardDetails.CardClass);

            IF LineList.LastRow() = 0 THEN
               MESSAGE 'Card will not be created. ' +
                       'There are no remaining lines to include on the card.';
               RETURN PU_CANCEL;
            ENDIF;
         ENDIF;
      ENDIF;
      /* 
      ** Since the Line List may have changed, we should appropriately update
      ** our Misc Where Clause so that we can properly find the substations
      ** for only those lines that are now involved.
      */
      FOR i = 1 TO LineList.LastRow() DO
          IF i = 1 THEN
              MiscWhereClause = '(' + VARCHAR(LineList[i].Object);
              FeederNames = varchar(LineList[i].Name);
          ELSE    
              MiscWhereClause = MiscWhereClause + ',' +
                               VARCHAR(LineList[i].Object);
              FeederNames = FeederNames + ',  ' + varchar(LineList[i].Name);
          ENDIF;
      ENDFOR;
      MiscWhereClause = MiscWhereClause + ')';
      /*
      ** If line list changed, update the Connected Breaker list.
      ** Remove breakers that are no longer members of lines in line list.
      ** Note: skip this logic if the card class is Black Start because equipment
      ** included in the scenario may not be members of the lines included 
      ** in the scenario.
      */
      IF ActiveCardFlag = TRUE THEN
         i = ConnectedBreakers.LastRow();
         WHILE i > 0 DO
            DynamicWhereClause = 'Grouping IN ' + MiscWhereClause +
                                 ' AND Relationship = ' +
                                 VARCHAR(Interaction$MemberOf) +
                                 ' AND Member = ' +
                                 VARCHAR(ConnectedBreakers[i].Object); 
            j = 0;
            SELECT :j = Grouping
            FROM    Udb_Grouping
            WHERE  :DynamicWhereClause;

            IF j = 0 THEN 
               ConnectedBreakers.RemoveRow (RowNumber = i);
            ENDIF;
            i = i - 1;
         ENDWHILE;
      ENDIF;
      /*
      **  Insert a row in the CardToObject table for each transmission feeder
      **  associated with the card.
      */
      FOR i = 1 TO LineList.LastRow() DO
         Status = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CardDetails.Card
                                   ,CardObject = LineList[i].Object
                                   ,CardObjectName = LineList[i].Name
                                   ,ObjectType = Type$Line
                                   ,Status = 1
                                   ,Seq = 0
                                   ,ValidatedBy = LineList[i].PrimaryGroupingName);
         IF Status < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not create the card.  A database error ' +
                    ' occurred while inserting the Feeder to Card link.';
            RETURN PU_CANCEL;
         ENDIF;          
      ENDFOR;    
      CALLPROC DDB_COMMIT;  
   ENDIF;
/*
** insert Black Start scenario in CardToObject table so when the card is activated
** the scenario is inserted into ActiveObject table, which helps synchronize jobs 
** between TFMS and SLC.
*/
   IF CardDetails.CardClass = Type$TFMSBLCK THEN
      Status = CALLPROC TFMS_InsertCardToObject(
                         CardKey = CardDetails.Card
                        ,CardObject = CardDetails.BlackStart
                        ,CardObjectName = CardDetails.BlackStartName
                        ,ObjectType = Type$BlackStartScenario
                        ,Status = 1
                        ,Seq = 0);
      IF Status < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Could not create the card.  A database error ' +
                 'occurred while inserting the Black Start scenario to Card link.';
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

/*
** Get List of Substations. 
** For Black Start, include the substations that are the Primary Grouping of the
** equipment that are included in the scenario.
** For regular TFMS cards: include the substations based on equipment membership to the 
** lines.  
** The equipment Primary Grouping should be a substation, ignore it
** if not (ACLineSegments are Praimary Grouped with the line).
*/
   SubstationList.Clear();
   ENDEENList.Clear();
   i = 1;

   IF CardDetails.CardClass = Type$TFMSBLCK THEN
      SELECT DISTINCT
              :SubstationList[i].Object = O2.Object,
              :SubstationList[i].Name = O2.Name,
              :SubstationList[i].Type = R.Normal
      FROM    Udb_Grouping G1,
              Udb_Grouping G2,
              Udb_Object O1,
              Udb_Object O2,
              UDB_Rating R
      WHERE   G1.Grouping = :CardDetails.BlackStart AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.MemberType <> :Type$TransmissionFdr AND
              G1.Member = O1.Object AND
              O1.PrimaryGrouping = O2.Object AND 
              O2.Type IN (SELECT TYPE FROM UDB_ExtendedType 
                          WHERE SuperType = :Type$Substation) AND 
              G2.Member = O2.Object AND 
              G2.Grouping = R.Object AND 
              G2.Relationship = :Interaction$RatedAs
      UNION
      SELECT DISTINCT
              O2.Object,
              O2.Name,
              R.Normal
      FROM    Udb_Grouping G1,
              Udb_Grouping G2,
              Udb_Grouping G3,
              Udb_Grouping G4,
              Udb_Object O2,
              UDB_Rating R
      WHERE   G1.Grouping = :CardDetails.BlackStart AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.MemberType = :Type$TransmissionFdr AND
              G1.Member = G2.Grouping AND			/* Find ac lines */
              G2.Relationship = :Interaction$MemberOf AND
              G2.MemberType = :Type$ACLineSegment AND
              G2.Member = G3.Member AND				/* find AC line segements */
              G3.Relationship = :Interaction$MemberOf AND
              G3.GroupingType IN (SELECT TYPE FROM UDB_ExtendedType 
                          WHERE SuperType = :Type$Substation) AND 
              G3.Grouping = O2.Object AND
              G4.Member = O2.Object AND 
              G4.Grouping = R.Object AND 
              G4.Relationship = :Interaction$RatedAs
      ORDER BY Type ASC
      BEGIN
         i = i + 1;
      END;               
   ELSE
      DynamicWhereClause = 'G.Grouping IN ' + MiscWhereClause + ' AND ' +
                        'G.Relationship = ' + VARCHAR(Interaction$MemberOf) +
                        ' AND G.MemberType IN ' + 
                        '(SELECT TYPE FROM UDB_ExtendedType WHERE ' + 
                        'SuperType = ' + varchar(:Type$Conducting) + ')' +
                        ' AND G.Member = O.Object AND ' +
                        'O.PrimaryGrouping = O2.Object AND O2.Type IN ' + 
                        '(SELECT TYPE FROM UDB_ExtendedType WHERE ' + 
                        'SuperType = ' + varchar(:Type$Substation) + ')' +
                        ' AND G2.Member = O2.Object AND ' +
                        'G2.Grouping = R.Object AND ' + 
                        'G2.Relationship = ' + varchar(:Interaction$RatedAs); 
 
      SELECT DISTINCT
              :SubstationList[i].Object = O2.Object,
              :SubstationList[i].Name = O2.Name,
              :SubstationList[i].Type = R.Normal
      FROM UDB_Grouping G,
           Udb_Grouping G2,
           UDB_Object O,
           UDB_Object O2,
           UDB_Rating R
      WHERE :DynamicWhereClause
      ORDER BY Type ASC
      BEGIN
         i = i + 1;
      END;               
   ENDIF;

   IF i = 1 THEN
      MESSAGE 'Error in InsertObjectLink: Unable to find substations related to lines/equipment.';
      RETURN PU_CANCEL;
   ENDIF;
/*
**  Select the EN-DE-EN substations for the feeders associated with the card.
**
**  The algorithm is:
**   For each transmissionline included, load the ENDEEN substation(s).
**   If none, create transmission card with no ENDEEN substation.
**   If one, that is the ENDEEN substation.
**   If more than one, find highest kv rating.  If there is a tie for 
**     the highest kv rating there will not be an ENDEEN substation.
*/
   IF MiscWhereClause <> '' THEN
      DynamicWhereClause = 'G.Relationship = ' + varchar(:Interaction$ENDEENat) + 
                     ' AND ' +
                     'G.Grouping = O.Object AND ' +
                     'G.Member IN ' + MiscWhereClause;
      i = 1;
      SELECT DISTINCT
            :ENDEENList[i].Object = G.Grouping,
            :ENDEENList[i].Name = O.Name,
            :ENDEENList[i].TypeName = O.TypeName
      FROM UDB_Grouping G,
           UDB_Object O
      WHERE :DynamicWhereClause
      BEGIN
         i = i + 1;
      END;
   ENDIF;
        
   IF ENDEENList.LastRow() = 0 THEN
      SelectedENDEEN = 0;

   ELSEIF ENDEENList.LastRow() = 1 THEN
      SelectedENDEEN = ENDEENList[1].Object;

   ELSE  /* more than one EnDeEn, find highest */
/*
**  Get kv rating for all substations found
*/
      j = 1;
      WHILE j <= ENDEENList.LastRow() DO

         i = 1;
         WHILE i <= SubstationList.LastRow() DO
            IF SubstationList[i].Object = ENDEENList[j].Object THEN
               ENDEENList[j].Type = SubstationList[i].Type;
               ENDLOOP;
            ENDIF; 
            i = i + 1;
         ENDWHILE;

         j = j + 1;
      ENDWHILE;
/*
**  Find max kv.
*/
      MaxKv = 0;
      FOR i = 1 TO ENDEENList.LastRow() DO
         IF ENDEENList[i].Type > MaxKv THEN
            MaxKv = ENDEENList[i].Type; 
         ENDIF;
      ENDFOR;
/*
**  Make the station with the max kv the EnDeEn.  If more than one
**  then no one will be EnDeEn.
*/          
      SelectedENDEEN = 0;
      FOR i = 1 TO ENDEENList.LastRow() DO
         IF ENDEENList[i].Type = MaxKv THEN
            IF SelectedENDEEN <> 0 THEN   /*Already found one, no one wins*/
               SelectedENDEEN = 0;
               ENDLOOP;
            ELSE
               SelectedENDEEN = ENDEENList[i].Object;
            ENDIF;
         ENDIF;
      ENDFOR;
 
   ENDIF;
/*
**  Put the ENDEEN substation at the end of the substation list regardless of
**  the KV rating.
*/
   j = SubstationList.LastRow();
   WHILE j > 0 DO
      IF SubstationList[j].Object = SelectedENDEEN THEN
         IF j <> SubstationList.LastRow() THEN
            SubstationList.InsertRow(RowNumber = SubstationList.LastRow() + 1,
                                     RowObject = SubstationList[j].Duplicate());
            SubstationList.RemoveRow(RowNumber = j);
         ENDIF;
         ENDLOOP;
      ENDIF;
      j = j - 1;
   ENDWHILE;
/*
**  Insert a row in the CardToObject table for each substation
**  associated with the card.
*/
   i = 1;
   WHILE i <= SubstationList.LastRow() DO
      TempENDEEN = FALSE;
      IF SelectedENDEEN = SubstationList[i].Object THEN
         TempENDEEN = TRUE;
      ENDIF;
      Status = CALLPROC TFMS_InsertCardToObject(
                         CardKey = CardDetails.Card
                        ,CardObject = SubstationList[i].Object
                        ,CardObjectName = SubstationList[i].Name
                        ,ENDEEN = TempENDEEN
                        ,ObjectType = Type$Substation
                        ,Status = 0
                        ,Seq = i);
      IF Status < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Could not create the card.  A database error ' +
                 'occurred while inserting the Substation to Card link.';
         RETURN PU_CANCEL;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   CALLPROC DDB_COMMIT;
/*
**  build the substation list for the card description
*/
   SubstationNames = '';
   IF CardDetails.CardClass = Type$TFMSBLCK THEN
      /*
      ** include the list of lines associated to black start scenario as well as
      ** the substations related to equipment associated to the scenario. 
      */
      SubstationNames = 'Lines:(';
      FOR i = 1 TO LineList.LastRow() DO
          IF i = 1 THEN
             SubstationNames = SubstationNames + LineList[i].Name;
          ELSE
             SubstationNames = SubstationNames + ',' + LineList[i].Name;
          ENDIF;
      ENDFOR;
      SubstationNames = SubstationNames + ')';

      SubstationNames = SubstationNames + '   Stations:(';
      i = 1;
      FOR i = 1 TO SubstationList.LastRow() DO
         IF i = 1 THEN
            SubstationNames = SubstationNames + SubstationList[i].Name; 
         ELSE
            SubstationNames = SubstationNames + ',' + SubstationList[i].Name; 
         ENDIF;
      ENDFOR; 
      SubstationNames = SubstationNames + ')';        
        
   ELSE
      i = 1;
      WHILE i <= SubstationList.LastRow() DO
         IF SubstationNames <> '' THEN
            SubstationNames = SubstationNames + ')       '
         ENDIF;

         SubstationNames = SubstationNames + UpperCase(SubstationList[i].Name) + ':' + '(';

         j = 1;
         x = 1;
         WHILE j <= ConnectedBreakers.LastRow() DO
            IF ConnectedBreakers[j].PrimaryGrouping = SubstationList[i].Object THEN
               IF x = 1 THEN
                  SubstationNames = SubstationNames + ConnectedBreakers[j].Name; 
               ELSE
                  SubstationNames = 
                        SubstationNames + ',' + ConnectedBreakers[j].Name; 
               ENDIF;
               x = x + 1;
            ENDIF;
            j = j + 1;
         ENDWHILE;

         i = i + 1;
      ENDWHILE;   
      SubstationNames = SubstationNames + ')';        
   ENDIF;

   CardDetails.FeederNames = FeederNames;
   CardDetails.Description = SubstationNames;

   RETURN PU_OK;
END;

