METHOD GetRREquipTypes(
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.CList.Clear();
/* 
** Purpose of this method is to load all the Rapid Restore
** equipment types.
*/
   CurObject.Type = Type$RRType;
   CurObject.GetChildren();
   
   RETURN;
END;

Method GetEquipTypeMapping (
) =
DECLARE
    i = integer not null;
    j = integer not null; 
    RetCode       = INTEGER NOT NULL;  
    SubType      = INTEGER NOT NULL;
    TypeTranslation = TypeClass;
ENDDECLARE
BEGIN
/*
** In IR_TypeTranslation table, if a supertype has a RR type, its subtypes
** inherite the same translation. But the subtypes can have their own 
** translation.
** To build a type mapping list, we use UDB_ExtendedType table to find the 
** translation for a supertype and all its subtypes and add them to CList.
** We use Level attribute to remember where the translation comes from. 
** If a type is already in CList, we check the relation between the translation 
** levels. A subtype translation can override the supertype translation.
*/
   i = 1;
   SELECT :TypeTranslation.Level = TT.Type,    
          :TypeTranslation.Type = ET.Type,         /* fms type id */
          :TypeTranslation.BaseType = TT.RRType,   /* RR type id */
          :TypeTranslation.Description = T.Name    /* RR type name */
   FROM   IR_TypeTranslation TT,
          UDB_ExtendedType ET,
          Udb_Type T
   WHERE  TT.Type = ET.SuperType AND
          TT.RRType = T.Type
   BEGIN 
      RetCode = CurObject.CList.Find(AttributeName = 'Type',
                                     Value = TypeTranslation.Type,
                                     RowNumber = ByRef(j));
      IF RetCode = ER_OK THEN
         SubType = 0;
         SELECT :SubType = 1
         FROM   UDB_ExtendedType ET
         WHERE  ET.Type = :TypeTranslation.Level AND
                ET.SuperType = :CurObject.CList[j].Level;                   

         IF SubType  = 1 THEN  /* Override */
            CurObject.CList[j] = TypeTranslation.Duplicate();         
         ENDIF;
      ELSE
         CurObject.CList[i] = TypeTranslation.Duplicate();
         i = i + 1;    
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

