============================

	Name:            Check3GGroundIsolated

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Check3GGroundIsolated
**
**  Modification log:
**
**   01/12/11   em  Created
**   04/25/22   em  warning is showing a substation name, need to make sure the
**                  the objecttocard link =1 to select only feeder grounds.
*/
PROCEDURE CHECK3GGroundIsolated 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

    CardList = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   

    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;              /* index */ 
    CuttingInGround = INTEGER NOT NULL WITH DEFAULT;
    FeederList = ARRAY OF INTEGEROBJECT;
    GroundList = ARRAY OF ObjectSummaryClass;
    LastFeeder = INTEGER NOT NULL WITH DEFAULT;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
)= 
DECLARE
   CheckFeederInService   = PROCEDURE RETURNING INTEGER NOT NULL;
ENDDECLARE
BEGIN 
/*
** Make sure Job appears on active 3G Card
*/
   CardList.Clear();
   i = 1;
   SELECT :CardList[i].Card = C.Card,
          :CardList[i].FeederName = C.FeederName
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card AND
          C.NetworkFeeder = 1
   BEGIN
      i = i + 1;
   END;

   IF CardList.LastRow() = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GGroundIsolated called on a non 3G Network Feeder card from ' +
                          'Card=' + VARCHAR(JIP.Card) + '; Job=' + VARCHAR(JIP.Job) );
      RETURN(NULL);
   ENDIF;
/*
** Load all grounds on card feeders, if none then check is okay.
*/
   i = 1;
   k = 1;
   LastFeeder = 0;
   FeederList.Clear();
   GroundList.Clear();
   FOR j = 1 TO CardList.LastRow() DO
      SELECT DISTINCT
             :GroundList[i].PrimaryGrouping = AO.Object,    /*EquipFeeder*/
             :GroundList[i].Object = O.Object,
             :GroundList[i].Name = O.Name
      FROM   SOA_ActiveObject AO,
             Udb_Grouping G,
             Udb_Object O,
             FMS_ObjectStatus OS
      WHERE  AO.Card = :CardList[j].Card AND
             AO.ObjectToCardLink = 1 AND
             AO.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.Member = O.Object AND
             G.Member = OS.Object AND
             OS.StatusCount > 0 AND
             OS.Status = :Status$Ground
      ORDER BY 1
      BEGIN
         IF LastFeeder <> GroundList[i].PrimaryGrouping THEN
            FeederList[k].Value = GroundList[i].PrimaryGrouping;
            LastFeeder = GroundList[i].PrimaryGrouping;  /*FeederList depends on order by PG*/
            k = k + 1;
         ENDIF;
         GroundList[i].Type = CardList[j].Card;       /*Hide the card in the Type attribute*/
         i = i + 1;
      END;
   ENDFOR;

   IF GroundList.LastRow() = 0 THEN
      RETURN(NULL);
   ENDIF;
/*
** For each Feeder with a Ground, we trace attempting to reach the substation with a closed Source Breaker. 
** If the Source Breaker is the current Job Equip, we assume the move is to close it. 
** For the feeder with the source breaker, since connectivity may be used to determine cut out status, we can just
** use the cutout status of the feeder.
*/ 
   CuttingInGround = FALSE;
   FOR i = 1 TO GroundList.LastRow() DO
/*
** Make sure Ground Feeder is still in list and remove it.  If it is no longer in list
** then we have already processed that feeder and can ignore it.
*/ 
      k = FeederList.LastRow();
      WHILE k >= 1 DO
         IF GroundList[i].PrimaryGrouping = FeederList[k].Value THEN
            FeederList.RemoveRow(RowNumber = k);
            ENDLOOP;
         ENDIF;
         k = k - 1;
      ENDWHILE;
/*
** If Feeder found in remaining ground list, then we perform trace to see if we are putting feeder back
** in service with a ground.
*/
      IF k >= 1 THEN
         j = 0;
         CuttingInGround = CALLPROC CheckFeederInService (Feeder = GroundList[i].PrimaryGrouping);
      ENDIF;     

      IF CuttingInGround = TRUE THEN
         ENDLOOP;
      ENDIF;
   ENDFOR;

   IF CuttingInGround = TRUE THEN
      SELECT :FeederName = Name
      FROM   Udb_Object 
      WHERE  Object = :GroundList[i].PrimaryGrouping;

      WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'There are grounds on Feeder ' + FeederName + 
                           '.  You may be energizing into a ground!'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
   ELSE
      RETURN(NULL);
   ENDIF;
END;


PROCEDURE CheckFeederInService (
   Feeder = INTEGER NOT NULL
) =
DECLARE
   FeederCutOut = INTEGER NOT NULL WITH DEFAULT;
   FeederSource = INTEGER NOT NULL WITH DEFAULT;
   InStation = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeederList = ARRAY OF ConnectedEquipClass;	
ENDDECLARE
BEGIN
   NetWorkFeederList.Clear();
   CALLPROC NetworkFeederTrace (
                           StartFeeder = Feeder,  
                           NetworkFeederList = NetworkFeederList,
                           SwitchClosing = JIP.Equip);

   IF NetworkFeederList.LastRow() = 0 THEN
      NetworkFeederList[1].Object = Feeder;
   ENDIF;

   FOR i = 1 TO NetWorkFeederList.LastRow() DO
      Feeder = NetWorkFeederList[i].Object;
/*
**  Is this feeder a member of a substation
*/
      InStation = 0;
      SELECT :InStation = G.Grouping
      FROM   Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  G.Member = :Feeder AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation;

      IF InStation > 0 THEN
/*
**  Get FeederSource
*/
         FeederSource = 0; 
         SELECT :FeederSource = G.Member
         FROM   Udb_Grouping G
         WHERE  G.Grouping = :Feeder AND
                G.Relationship = :Interaction$SourceBreaker;

         IF FeederSource = JIP.Equip THEN
            RETURN(TRUE);    /* By closing source breaker, we may be cutting in feeder */
         ENDIF;
/*
** Check CutOut Status of feeder (must still be CutOut)
*/
         FeederCutOut = 0;
         SELECT  :FeederCutOut = Object
         FROM    FMS_ObjectStatus
         WHERE   Object = :Feeder AND
                 StatusCount >= 0 AND
                 Status = :Status$CO;

         IF FeederCutOut = 0 THEN
            RETURN(TRUE);   /* We are closing into an in-service breaker */
         ENDIF; 
      ENDIF;
/*
** Remove each reviewed feeder from FeederList so it doesn't have to be reviewed again.
*/
      k = FeederList.LastRow();
      WHILE k >= 1 DO
         IF Feeder = FeederList[k].Value THEN
            FeederList.RemoveRow(RowNumber = k);
            ENDLOOP;
         ENDIF;
         k = k - 1;
      ENDWHILE;
   ENDFOR;

   RETURN(FALSE);
END;

Application Component Report
============================

	Name:            Check3GMultiWay

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Check3GMultiWay
**
**  Modification log:
**
**   04/07/11   em  Created
**                  Look across multi-way switch to other feeder and present warning if it is 
**                  out-of-service.  Used on Close 3G Switch moves.
*/
PROCEDURE CHECK3GMultiWay 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    CardList = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;                   

    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
)= 
BEGIN 
/*
** Make sure Job appears on active 3G Card
*/
   CardList.Clear();
   i = 1;
   SELECT :CardList[i].Card = C.Card,
          :CardList[i].FeederName = C.FeederName
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card AND
          C.NetworkFeeder = 1
   BEGIN
      i = i + 1;
   END;

   IF CardList.LastRow() = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GMultiWay called on a non 3G Network Feeder card from ' +
                          'Card=' + VARCHAR(JIP.Card) + '; Job=' + VARCHAR(JIP.Job) );
      RETURN(NULL);
   ENDIF;
/* 
** Look for 3G Switch neighbor
*/
           i = 1;
           FeederNames = '';
           REPEATED
           SELECT
           DISTINCT  :FeederName = O2.Name
           FROM    Udb_Grouping G,
                   Udb_Switch S,
                   Udb_Object O,
                   Udb_Object O2,
                   Udb_Terminal T1,
                   Udb_Terminal T2,
                   FMS_ObjectStatus OS
           WHERE   T1.Object = :JIP.Equip AND
                   T1.Node = T2.Node AND
                   T2.Object = O.Object AND
                   O.Type IN (SELECT Type FROM Udb_ExtendedType
                              WHERE  SuperType = :Type$3GSwitch) AND
                   O.Object = S.Object AND
                   S.CurrentlyOpen = 0 AND
                   O.Object = G.Member AND
                   G.Relationship = :Interaction$MemberOf AND  
                   G.GroupingType = :Type$Feeder AND
                   G.Grouping = O2.Object AND
                   G.Grouping = OS.Object AND
                   OS.StatusCount > 0 AND
                   OS.Status = :Status$CO AND                 
                   T1.Node > 20000 AND
                   T2.Node > 20000 AND
                   T1.Object <> T2.Object
           BEGIN
              IF i > 1 THEN
                 FeederNames = FeederNames + ',';
              ENDIF;
              FeederNames = FeederNames + FeederName;
              i = i + 1;
           END;

   IF FeederNames <> '' THEN
      WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'You are closing into out-of-service Feeder(s) ' + FeederNames + '.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
   ELSE
      RETURN(NULL);
   ENDIF;
END;



