*/
/*
**  Application:    CAC
**  Frame:          PromptSetACFeedRemoved
**
**  Modifications:
**  06/24/14   em   Created
**  07/29/14   em   Changed Procedure Call
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
) =
BEGIN
  
      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'acfeedremoved',
                FieldValue = 1
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Valve AC Feed Removed.',
                           TraceMessage =
               'PromptSetACFeedRemoved: Unable to set ACFeedRemoved ' +
               'device status for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;

END;

Application Component Report
============================

	Name:            PromptSetATSManualFromMacro

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    cac
**  Frame:          PromptSetATSManualFromMacro         
**
**  Modifications:
**  03/05/08   pkw  Created to handle ATS moves impacting both 101 and 102 
**                  performed against the ATS Macro device (the ATS 
**                  Superstructure). The move will appear as a common
**                  equipment move on all cards where the ATS Macro is a
**                  common equipment.  
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    ATS = ObjectSummaryClass;
    ATS102 = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device.
**  Then find its related ATS102 device.
*/ 
   ATS.Object = 0;
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'PromptSetATSFromMacro:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );
      RETURN (PU_CANCEL);
   ENDIF;

   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptSetATSManualFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;

   ATS102.Object = 0;
   REPEATED
   SELECT :ATS102.Object = O.Object,
          :ATS102.TypeName = O.TypeName,
          :ATS102.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS102);

   IF ATS102.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptSetATSManualFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;
/*
** ATS 101 and 102 device is found, now set ATSManual status.
*/
   RetCode = CALLPROC SetStatus (Object = ATS101.Object,
                                 Status = Status$ATSManual);
   IF RetCode = PU_CANCEL THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;

   RetCode = CALLPROC SetStatus (Object = ATS102.Object,
                                 Status = Status$ATSManual);
   IF RetCode = PU_CANCEL THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;

   CALLPROC DDB_COMMIT;

   RETURN (PU_OK);
END;

