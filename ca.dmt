	Name:            TakeControl

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**  Application:      SOA
**  Frame:            TakeControl
**
**  05/25/98   pkw    Modified FMS version
**  10/14/08   em     Add a timer, in a take control situation,
**                    if this screen has not been acted upon in 30 seconds
**                    then clear it.
**                    
*/

INITIALIZE
(
   MessageName = VARCHAR(100) NOT NULL;
   Application = VARCHAR(100) NOT NULL;
   ControlAction = INTEGER NOT NULL;
   TimeOut = INTEGER NOT NULL;
) =
BEGIN
   IF ControlAction = Card$RequestControl THEN
      Field(VO_Btn).CurBias      = FB_INVISIBLE;
      Field(TC_Btn).TextLabel    = 'Keep Control';
      Field(Clear_Btn).TextLabel = 'Give up Control';
      CurFrame.SendUserEvent (EventName = 'Return_Cancel',
                              Delay = :TimeOut);
   ELSEIF ControlAction = Card$KeepControl THEN
      Field(TC_Btn).CurBias = FB_Dimmed;
   ELSE
      CurFrame.SendUserEvent (EventName = 'Return_Cancel',
                              Delay = 30);
   ENDIF;
   Field(ConfirmText).TextValue = MessageName;
   Field(ApplicationName).TextValue = Application;
END;

ON Click TC_Btn =
BEGIN
   RETURN 1;
END;

ON Click VO_Btn =
BEGIN
   RETURN 3;
END;

ON UserEvent 'Return_Cancel',
ON Click Clear_Btn =
BEGIN
   IF ControlAction = Card$RequestControl THEN
      CurFrame.PurgeUserEvent(EventName = 'Return_Cancel');
   ENDIF;

   RETURN 2;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

