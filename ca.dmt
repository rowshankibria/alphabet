*/

INITIALIZE
(
   Equip = INTEGER NOT NULL;   /* passed in */
   i = INTEGER NOT NULL WITH DEFAULT; 
) =
BEGIN
   i = 1;
   REPEATED
   SELECT    :GH[i].RelationshipText = T1.Name,
             :GH[i].GroupingTypeText = G.GroupingTypeName,
             :GH[i].TransferTime = G.TransferTime,
             :GH[i].ObjectName = G.GroupingName
   FROM      Udb_GroupingHistory G,
             Udb_Type T1
   WHERE     G.Member = :Equip AND
             G.Relationship = T1.Type
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
END;

