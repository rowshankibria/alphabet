	Name:            FMS_EvalNotifState

/* 
**      Copyright c 1997 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  4GLProc:        FMS_EvalNotifState
** 
**  Modification log: 
** 
**  Date:  	  Version       Description 
** -------------------------------------------------- 
**  03/07/97   jfl      Created
**  09/30/02   ysp      Merge: rename job to move because Job is a class name.
**                          
*/ 
PROCEDURE FMS_EvalNotifState (
    Notification = FMS_Notifications;     /* P: notification */
    InProgress = INTEGER NOT NULL;        /* P: TRUE if the move is to be issued or completed */

    ValidChange = INTEGER NOT NULL;       /* Return value: T if the change is valid */
    MovePerformed = INTEGER NOT NULL;     /* TRUE if the move was already issued or performed */  
    Move = JOB;
) =
BEGIN
/*
** Reevaluate the notification state for incomplete notifications
**     not_to_be_issued_yet
**     issued
**     pending
**
** NOTE that this state is stored in the Issued field of the 
**      FMS_Notifications table.
**
*/
    ValidChange = TRUE;  /* be positive */
/*
** A change is attempted from the Prompt Notification screen
*/
    IF InProgress = TRUE THEN
        IF Notification.Compl = 1 THEN
            IF Notification.Person <> '' THEN
                Notification.NotifState = Notif$Issued;
            ELSE        
                Notification.NotifState = Notif$Pending;
            ENDIF;
        ELSE
            Notification.NotifState = Notif$Pending;
        ENDIF;
/*
** A change is attempted from the Notification Log screen
*/
    ELSE
        SELECT
            :Move.ToIssued = J.ToIssued,
            :Move.ToComplete = J.ToComplete,
            :Move.RsIssued = J.RsIssued,
            :Move.RsComplete = J.RsComplete
        FROM SOA_Job J
        WHERE J.Job = :Notification.Job;
        CALLPROC DDB_ROLLBACK;
/*
** See if the move has been issued or restored yet
*/
        MovePerformed = TRUE;
        IF Notification.ToRs = Job$TakeOutInt THEN
            IF (Notification.PrePost = JobCheck$Precheck 
                AND Move.ToIssued IS NULL) OR
               (Notification.PrePost <> JobCheck$Precheck  
                AND Move.ToComplete IS NULL) THEN
                MovePerformed = FALSE;
            ENDIF;
        ELSE
            IF (Notification.PrePost = JobCheck$Precheck 
                AND Move.RsIssued IS NULL) OR
               (Notification.PrePost <> JobCheck$Precheck 
                AND Move.RsComplete IS NULL) THEN
                MovePerformed = FALSE;
            ENDIF;
        ENDIF;
/*
**  If the operator says it is issued, the move must have
**  been issued or completed
*/
        IF Notification.Compl = 1 THEN
            IF MovePerformed = TRUE THEN
                IF Notification.Person <> '' THEN
                    Notification.NotifState = Notif$Issued;
                ELSE        
                    Notification.NotifState = Notif$Pending;
                ENDIF;
            ELSE
/*
** INVALID: let the calling program warn the operator
*/
               ValidChange = FALSE;
            ENDIF;
/*
** The notification has just been created. If the move is
** already issued or performed, state is now PENDING
*/
        ELSE
            IF MovePerformed = TRUE THEN
                Notification.NotifState = Notif$Pending;
            ELSE
                Notification.NotifState = Notif$NotToBeIssuedYet;
            ENDIF;
        ENDIF;
    ENDIF;

/*
** Only issuing a notification before the prompt is invalid
*/  
    RETURN (ValidChange);

END;

