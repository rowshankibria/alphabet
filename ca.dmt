	Name:            SelectBusEquip

/* 
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    NewMoves
**  Frame:          SelectBusEquip
** 
**  Modification log: 
** 
**  Date:     Version     Description 
** -------------------------------------------------- 
**  01/20/00    py        Select Equipment for connecting to bus section
**                        Specify terminal of equipment, if two terminal
**  06/12/00    em        Pass back selected node instead of terminal
**  12/04/00    em        If Card Parameter is non-zero, we need to make
**                        sure selected equipment is part of the TFMS line
**                        so that we don't go beyond our logical scope. 
*/ 
INITIALIZE   
(   
#   include StandardDeclarations	   
    Card 		= INTEGER NOT NULL WITH DEFAULT; /*Non-zero for TFMS*/
    Substation          = INTEGER NOT NULL WITH DEFAULT;
    SelectedEquip       = INTEGER NOT NULL WITH DEFAULT;
    SelectedTerm        = INTEGER NOT NULL WITH DEFAULT;
    SelectedNode        = INTEGER NOT NULL WITH DEFAULT;
    BusSectionName      = VARCHAR(80) NOT NULL WITH DEFAULT ;
    Term1Node           = INTEGER NOT NULL WITH DEFAULT;
    Term2Node           = INTEGER NOT NULL WITH DEFAULT;
    Term1Obj            = INTEGER NOT NULL WITH DEFAULT;
    Term2Obj            = INTEGER NOT NULL WITH DEFAULT;
    m                   = INTEGER NOT NULL WITH DEFAULT;
    TempNode            = INTEGER NOT NULL WITH DEFAULT;
 ) = 
/* 
** Load the data for the equipment selection from the database 
** into the 4GL environment and set up the display: 
*/ 
BEGIN 
   BusSectiontext = BusSectionName;
   Selected.Equip = 0;
   SelectedNode = 0;
   Selected.EquipClassName = '';
   i = 1;

   REPEATED
   SELECT  
   DISTINCT 
            :SelectEquip[i].Substationname = O.PrimaryGroupingname,
            :SelectEquip[i].EquipClassName  = O.TypeName,
            :SelectEquip[i].EquipName = O.Name,
            :SelectEquip[i].Equip = O.Object, 
            :SelectEquip[i].EquipClass  = O.Type,
            :SelectEquip[i].ObjectDescription = O.Description,
            :SelectEquip[i].Substation = O.PrimaryGrouping
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_ExtendedType E,
           Udb_Terminal T
   WHERE   G.Grouping = :Substation AND
           G.Relationship = :Interaction$MemberOf AND
           O.Object = G.Member AND
           E.SuperType = :Type$Conducting AND
           E.Type NOT IN (SELECT Type
                          FROM Udb_ExtendedType
                          WHERE SuperType IN (:Type$Line, :Type$Feeder, :Typename$BusSect)) AND 
           G.MemberType = E.Type AND
           O.Object = T.Object AND
           T.Node >= 20000           
   BEGIN
      i = i + 1;
   END;

END; 

ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   Selected = SelectEquip[];
   SelectedEquip = Selected.Equip;
/*
** Determine the node and terminal of the selected equipment.
** If two terminal, specify which terminal where the bus section connect to 
*/ 
   TempNode = 0;
   SELECT :TempNode = Node
   FROM Udb_Terminal
   WHERE Object = :SelectedEquip AND
         Node > 20000;

   IF TempNode = 0 THEN
      MESSAGE 'Cannot connect, no connected terminal found,' + 
              ' Please select another device';
      RESUME;
   ENDIF;
/*
** IF Card parm is non-zero - a TFMS card - make sure selected device is 
** within scope of the card.
*/
   IF Card > 0 THEN
      m = 0;
      REPEATED
      SELECT   :m = CTO.Object
      FROM     TFMS_CardToObject CTO,
               Udb_Grouping G
      WHERE    CTO.Card = :Card AND
               CTO.Type = :Type$Line AND
               CTO.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = :SelectedEquip;
      
      IF m = 0 THEN
         MESSAGE 'Selected device is not within scope of your TFMS card. ' +
                 'Please select another device.';
         RESUME;
      ENDIF;
   ENDIF;      
  
   m = 0;
   SELECT :m = count(*)
   FROM Udb_Terminal
   WHERE Object = :SelectedEquip AND
         Node > 20000;

   IF m = 0 THEN
      MESSAGE 'Selected Equipment is not connected.';
      RESUME;
   
   ELSEIF m = 1 THEN

      SELECT :SelectedTerm = Terminal,
             :SelectedNode = Node
      FROM Udb_Terminal
      WHERE Object = :SelectedEquip AND
            Node > 20000;

      FIELD(SelectTerm).CurBias = FB_INVISIBLE;

      CurFrame.WindowWidth = 5500;
      CurFrame.WindowHeight = 6500;

   ELSEIF m = 2 THEN
 
      CurFrame.SendUserEvent (EventName ='LoadTerm'); 

   ELSE 
      MESSAGE 'Selected Object has too many terminals (more than two), ' +
              'please select another device.';
      RESUME; 
   ENDIF;
END;
 

ON USEREVENT 'LoadTerm' =
BEGIN
/*
** Get the objects connected at each terminal
*/
   SelectTerm.term1_equip = '';                              
   SelectTerm.term1_type = '';

   SELECT  :Term1Node = T.Node
   FROM    Udb_Terminal T
   WHERE   T.object = :SelectedEquip AND
           T.terminal = 1;

   REPEATED
   SELECT :Term1Obj = T.object,
          :SelectTerm.term1_equip = O.name,
          :SelectTerm.term1_type = O.typename
   FROM  Udb_terminal T,
         Udb_Object O
   WHERE T.node = :Term1Node AND
         T.object <> :SelectedEquip AND
         T.Object = O.Object;

   SelectTerm.term2_equip = '';
   SelectTerm.term2_type = '';

   SELECT  :Term2Node = T.Node
   FROM    Udb_Terminal T
   WHERE   T.object = :SelectedEquip AND
           T.terminal = 2;
  
   REPEATED
   SELECT :Term2Obj = T.object,
          :SelectTerm.term2_equip = O.name,
          :SelectTerm.term2_type = O.typename
   FROM  Udb_terminal T,
         Udb_Object O
   WHERE T.node = :Term2Node AND
         T.object <> :SelectedEquip AND
         T.Object = O.Object;
/*
** If another side of device is not connected, then select the
** connected side
*/
   IF SelectTerm.term1_equip = '' THEN
      SelectedTerm = 2;      
      SelectedNode = Term2Node;
      FIELD(SelectTerm).CurBias = FB_INVISIBLE;
      CurFrame.WindowWidth = 5500;
      CurFrame.WindowHeight = 6500;
   ELSEIF SelectTerm.term2_equip = '' THEN
      SelectedNode = Term1Node;
      SelectedTerm = 1;
      FIELD(SelectTerm).CurBias = FB_INVISIBLE;
      CurFrame.WindowWidth = 5500;
      CurFrame.WindowHeight = 6500;
   ELSE
/*make terminal selection field visible*/
      CurFrame.WindowWidth = 7000;
      CurFrame.WindowHeight = 8000;
/*
**      FIELD(SelectTerm).AbsXRight = FIELD(Selected.Equipname).AbsXRight + 1500;
**      FIELD(SelectTerm).AbsYTop = FIELD(Selected.Equipname).AbsYTop - 1500;
*/
      FIELD(SelectTerm).CurBias = FB_CHANGEABLE;      
      SelectTerm.term1_selected = FALSE;
      SelectTerm.term2_selected = FALSE;      
   ENDIF;
END;


ON Click SelectTerm.term1_selected =
BEGIN
   SelectTerm.term1_selected = TRUE;
   SelectTerm.term2_selected = FALSE;
   SelectedTerm = 1; 
   SelectedNode = Term1Node;
   RESUME;
END;

ON Click SelectTerm.term2_selected =
BEGIN
   SelectTerm.term1_selected = FALSE;
   SelectTerm.term2_selected = TRUE;
   SelectedTerm = 2;
   SelectedNode = Term2Node;
   RESUME;
END;

/* 
**  Handle OK click  
*/ 
ON Click OK_Btn = 
BEGIN 

   IF Selected.Equip = 0 AND Selected.EquipClassName = '' THEN
      message 'You have not selected any equipment.';
      RESUME;
   ENDIF;

   IF Selectterm.term1_equip <>'' AND Selectterm.term2_equip <>'' THEN   
      IF m = 2 AND SelectTerm.term1_selected = FALSE AND 
                   SelectTerm.term2_selected = FALSE THEN
         MESSAGE('You have to choose one of the terminal of device');
         RESUME;
      ENDIF; 
   ENDIF;

   RETURN (SelectedNode);
END;

/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
BEGIN 
   RETURN (0); 
END;

ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return (0);
END;


/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

