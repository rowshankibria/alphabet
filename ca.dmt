Application Component Report
============================

	Name:            PromptStopTag

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          PromptStopTag
**
**  06/30/00  em    Modified from FMS version
**                  Since the Stop Tag may have been already set by the 
**                  Operating Order, we will preload it.
**  10/29/02   em   Job to JIP
**  02/20/04  em    Converted Message to TraceError call
**  03/04/04  em    Don't display screen during automation execution.
*/

INITIALIZE
(
    JIP = JobInProgress;          /* Passed Job */

    retcode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
       IF JIP.Equip = 0 THEN
          CALLPROC TraceError (UserMessage =
                     'ERROR: No Equipment associated to this job; ' +
                     'cannot insert stop tag',
                                TraceMessage =
                     'PromptStopTag: No equipment associated to job=' +
                     VARCHAR(JIP.Job) + '. Cannot save stop tag.'
                                );
          RETURN (PU_OK);
       ELSE
          SELECT :Response = StopTag 
          FROM   Udb_Switch
          WHERE  Object = :JIP.Equip;
       ENDIF;

   IF AutomaticExecution = TRUE THEN
      Curframe.SendUserEvent (EventName = 'MakeInvisible');
   ENDIF;
END;


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;

ON USEREVENT 'CompleteProcessing',
ON Click OKButton =

   BEGIN
        retcode = CALLPROC FMS_SetStopTag (Object = JIP.Equip, 
                                           StopTag = Response);

        IF retcode <> 0 THEN
           CALLPROC DDB_ROLLBACK;
           CALLPROC TraceError (UserMessage =
                     'ERROR: Unable to permanently save stop tag.',
                                TraceMessage =
                     'PromptStopTag: Unable to save stop tag for ' +
                     'equip=' + VARCHAR(JIP.Equip) + '.'
                                );
           RETURN (PU_Cancel);
        ENDIF;        
        CALLPROC DDB_COMMIT;

        JIP.Response = Squeeze(Response + ' ' + JIP.Response);
        JIP.ResponseUpd();

	RETURN (PU_OK);
   END;

ON Click CancelButton =

   BEGIN
	RETURN (PU_Cancel);
   END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

Application Component Report
============================

	Name:            PromptTankFillLevel

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptTankFillLevel
**
**  06/12/14  ysp  Created
**  07/30/14  em   Added validation for tank to gauge relationship and 
**                 adjusted procedure calls per table changes 
**  07/01/15  em   Added attributes
**  10/29/21  em   Incorporate SSO return
**  11/10/21  em   No longer showing Tank/Tank Compartment or using MeasuredBy, move
**                 is directly assigned to a Compartment
**  06/30/22  em   AutoComplete if Reading is loaded from RR
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
/*
** Tank Compartment Attributes
*/
   Compartment = INTEGER NOT NULL WITH DEFAULT;
   CompartmentName = VARCHAR(40) NOT NULL WITH DEFAULT;
   BaffleSize = INTEGER NOT NULL WITH DEFAULT;
   MainCompartment = INTEGER NOT NULL WITH DEFAULT;
   MaximumGaugeLevel = INTEGER NOT NULL WITH DEFAULT;
/*
** Tank Attributes
*/
   Tank = INTEGER NOT NULL WITH DEFAULT;
   BaffledTank = INTEGER NOT NULL WITH DEFAULT;
   BaffleLevel = INTEGER NOT NULL WITH DEFAULT;
   TankSize = INTEGER NOT NULL WITH DEFAULT;
   Partitions = INTEGER NOT NULL WITH DEFAULT;

   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   StructureType = VARCHAR(40) NOT NULL WITH DEFAULT;
   Fill_Level = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :StructureType = StructureTypeName,
          :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;

   SELECT :Fill_Level = TankFillLevelResult
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF Fill_Level > 0 THEN
      FillLevel = Fill_Level;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(FillLevel).CurBias = FB_VISIBLE;
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName='AutoComplete');
   ENDIF;

   FIELD(Heading).TextValue = 'Reading from ' + SQUEEZE(StructureType + ' ' + Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName);

   Compartment = 0;
   SELECT :Compartment = O.Object,
          :CompartmentName = O.Name,
          :BaffleSize = T.BaffleSize,
          :MainCompartment = T.MainCompartment,
          :MaximumGaugeLevel = T.MaximumGaugeLevel
   FROM   UDB_Object O,
          UDB_TankCompartment T
   WHERE  O.Object = :JIP.Equip AND
          O.Object = T.Object;
END;

ON USEREVENT 'AutoComplete',
ON Click OKButton =
DECLARE
   Reading = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF FillLevel IS NULL THEN
      MESSAGE 'Please enter the fill level';
      RESUME;
   ENDIF;
   IF FillLevel <= 0 THEN
      MESSAGE 'Please enter the fill level, a positive integer';
      RESUME;
   ENDIF;
   
   Reading = CompartmentName + ': ' + VARCHAR(FillLevel) + ' Gallons';
   RetCode = CALLPROC DSO_ReadingIns(
      Card = JIP.Card,
      Time = DATE('NOW'),
      Job = JIP.Job,
      Structure = JIP.Substation,
      Equip = JIP.Equip,
      ReadingType = 'Tank Fill Level',
      Reading = Reading);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record tank fill level in Reading.',
                           TraceMessage =
                  'PromptTankFillLevel: Unable to record tank fill level for ' +
                  'card=' + VARCHAR(JIP.Card));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;
   
   IF Compartment <>  0 THEN
      RetCode = CALLPROC UDB_TankCompartmentUpd(
                              Object = Compartment,
                              BaffleSize = BaffleSize,
                              MainCompartment = MainCompartment,
                              MaximumGaugeLevel = MaximumGaugeLevel,
                              FillLevel = IFNULL(FillLevel,0));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record tank fill level for compartment.',
                           TraceMessage =
                  'PromptTankFillLevel: Unable to record tank fill level for ' +
                  'compartment=' + VARCHAR(compartment));
         RETURN (PU_Cancel);
      ENDIF;        
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF JIP.Response <> '' THEN
      JIP.Response = Squeeze(Reading + '; ' + JIP.Response);
   ELSE
      JIP.Response = Reading;
   ENDIF;
   JIP.ResponseUpd();
                 
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

