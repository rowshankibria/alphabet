	Name:            AlterTCEquipType

/*
**      Copyright c 1997 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    TelephoneCard
**  Frame:          AlterTCEquipType
**
**  Modifications:
**  07/15/97 jfl    Created
*/

INITIALIZE
(
    Circuit = ObjectClass;          /* P: Circuit */
    Substation = ObjectClass;       /* P: Substation */
    i = INTEGER NOT NULL;       
) =
BEGIN
/*
** Update Title
*/
    FIELD(TheTitle).TextValue = 'Equipment of Circuit ' + Circuit.Name +
                                ' at Substation ' + Substation.Name;
/*
** Load the Equipment at the passed substation for the passed circuit  
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
        :Equipt[i].Object   = O.Object,
        :Equipt[i].Name     = O.Name,
        :Equipt[i].Type     = O.Type,
        :Equipt[i].TypeName = O.TypeName
    FROM Udb_Object O,
         Udb_ExtendedType ET,
         Udb_Grouping G1,
         Udb_Grouping G2
    WHERE O.Object = G1.Member
      AND G1.Grouping = :Circuit.Object
      AND G1.RelationShip = :Interaction$MemberOf
      AND G1.MemberType IN (SELECT Type 
                            FROM Udb_ExtendedType
                            WHERE Supertype = :Type$TCEquipment)
      AND G1.Member = G2.Member
      AND G2.RelationShip = :Interaction$MemberOf
      AND G2.Grouping = :Substation.Object
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    CurFrame.InputFocusField = NULL;
END;

/*
** Call frame to change the type for the selected equipment
*/
ON ChildEntry Equipt[*].TypeName =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
    i = FIELD(Equipt).WhichRow (cellfield = CurFrame.TriggerField);
    CALLFRAME SetTCEquipType (TypeName = byref(Equipt[i].TypeName),
                              Equipt = Equipt[i]);
/*
**  refocus on another field to allow new selection
*/ 
    CurFrame.InputFocusField = FIELD(Ok_Btn);
END;


ON Click Ok_Btn =
BEGIN
    RETURN;
END;

ON WindowClose =
BEGIN
    RESUME;
END;


