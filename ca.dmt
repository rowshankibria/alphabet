**
**  Date:       Version Description
** ----------------------------------
**  09/09/14  ysp  Created; 
**  04/02/15  ysp  Add linked attribute
**  10/24/17  em   Modifications for new OSS Interface
**  03/26/18  em   Set ControlCard to current card if equipment = 0 in method
**                 CreateWorkPermit
*/
METHOD LoadJobs(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.PermitList.Clear();

   IF CurrentApplication = Application$FMS THEN
      i = 1;
      REPEATED
      SELECT :CurObject.PermitList[i].AppName = 'FMS',
             :CurObject.PermitList[i].Card = JC.Card,
             :CurObject.PermitList[i].SwitchingItem = JC.SwitchingItem,
             :CurObject.PermitList[i].CardName = C.FeederName,
             :CurObject.PermitList[i].PrintID = JC.PrintID,
             :CurObject.PermitList[i].EquipclassName = J.EquipclassName,
             :CurObject.PermitList[i].EquipName = J.EquipName,
             :CurObject.PermitList[i].TOMove = J.TOMove,
             :CurObject.PermitList[i].Job = J.Job
      FROM   SOA_OutageRequestPermit S,
             SOA_Job J,
             SOA_JobControl JC,
             FMS_Card C             
      WHERE  S.ORNumber = :CurObject.ORNumber AND
             S.WorkItem = :CurObject.WorkItem AND
             S.PermitJobID = J.Job AND
             J.Job = JC.Job AND
             JC.Card = C.Card
      BEGIN
         CurObject.PermitList[i].BaseKey = 1;  // to enable check mark
         i = i + 1;
      END;
   ELSE
      i = 1;
      REPEATED
      SELECT :CurObject.PermitList[i].AppName = 'TFMS',
             :CurObject.PermitList[i].Card = JC.Card,
             :CurObject.PermitList[i].SwitchingItem = JC.SwitchingItem,
             :CurObject.PermitList[i].CardName = C.FeederNames,
             :CurObject.PermitList[i].PrintID = JC.PrintID,
             :CurObject.PermitList[i].EquipclassName = J.EquipclassName,
             :CurObject.PermitList[i].EquipName = J.EquipName,
             :CurObject.PermitList[i].TOMove = J.TOMove,
             :CurObject.PermitList[i].Job = J.Job
      FROM   SOA_OutageRequestPermit S,
             SOA_Job J,
             SOA_JobControl JC,
             TFMS_Card C             
      WHERE  S.ORNumber = :CurObject.ORNumber AND
             S.WorkItem = :CurObject.WorkItem AND
             S.PermitJobID = J.Job AND
             J.Job = JC.Job AND
             JC.Card = C.Card
      UNION ALL
      SELECT 'SLC',
             JC.Card,
             JC.SwitchingItem,
             J2.TOmove,
             JC.PrintID,
             J.EquipclassName,
             J.EquipName,
             J.TOMove,
             J.Job
      FROM   SOA_OutageRequestPermit S,
             SOA_Job J,
             SOA_JobControl JC,
             SOA_Job J2             
      WHERE  S.ORNumber = :CurObject.ORNumber AND
             S.WorkItem = :CurObject.WorkItem AND
             S.PermitJobID = J.Job AND
             J.Job = JC.Job AND
             JC.SwitchingItem = J2.Job AND
             J2.ShadowLink = 0               // avoid jobs in shadow switching item
      BEGIN
         CurObject.PermitList[i].BaseKey = 1;  // to enable check mark
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   CurObject.ConcatePermitList();
END;

METHOD MapSubstation(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ReturnCode = CALLPROC SOA_ORWorkItemUpd (
                              WorkItem = CurObject.WorkItem,
                              ORNumber = CurObject.ORNumber,
                              FieldName = 'Substation',
                              Value = CurObject.Substation);
   IF CurObject.ReturnCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ErrorMessage = 'Failed to update work item substation due to database errror';
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageWorkItemClass;' + 
            ' ERROR: Failed to update work item substation for item ' + 
            CurObject.Item + ' in ' + CurObject.ORNumber);
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;

METHOD CreateWorkPermit(
   TypeofCard = INTEGER NOT NULL WITH DEFAULT;
   Card = INTEGER NOT NULL WITH DEFAULT;
   CardStatus = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;
   Application = CHAR(4) NOT NULL WITH DEFAULT;
   MoveEquip = FMS_Equip;   
   JobClass = INTEGER NOT NULL WITH DEFAULT;
   StepPair = INTEGER NOT NULL WITH DEFAULT;
   TOMove = VARCHAR(160) NOT NULL WITH DEFAULT;
   RSMove = VARCHAR(160) NOT NULL WITH DEFAULT;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ControlCard = INTEGER NOT NULL WITH DEFAULT;
   NewMove = SWPJob DEFAULT NULL;
   Permit = WorkPermit DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   // determine which card has the control of the equipment.
   IF CardStatus = Card$Open THEN
      ControlCard = Card;
   ELSEIF MoveEquip.Equip = 0 THEN
      ControlCard = Card;
   ELSE
      ControlCard = 0;
      SELECT :ControlCard = J.ControlCard
      FROM   SOA_Job J,
             SOA_ActiveCard AC
      WHERE  J.Equip = :MoveEquip.Equip AND
             J.MoveCategory = :MoveCategory$Normal AND
             (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Status IN ('', :JobStatus$NIS, :JobStatus$Table) AND
             J.ControlCard = AC.Card AND
             AC.Card <> :NIS$Card;  
      CALLPROC DDB_ROLLBACK;

      IF ControlCard = 0 THEN
         ControlCard = Card;
      ENDIF;
   ENDIF;
   
   NewMove = SWPJob.Create();
   NewMove.AppName = Application;
   NewMove.Card = Card;
   NewMove.JobClass = JobClass;
   NewMove.Equip = MoveEquip.Equip;
   NewMove.EquipName = MoveEquip.EquipName;
   NewMove.EquipClass = MoveEquip.EquipClass;
   NewMove.EquipClassName = MoveEquip.EquipClassName;
   NewMove.Grounds = NULL;
   NewMove.GroundOn = NULL;
   NewMove.StepPair = StepPair;
   NewMove.Substation = CurObject.Substation;
   NewMove.DeskName = '';
   NewMove.ControlCard = ControlCard;
   NewMove.TOMove = TOMove;
   NewMove.RSMove = RSMove;
   NewMove.SwitchingItem = SwitchingItem;
   NewMove.PrintId = MoveEquip.PrintID;
/*
** Get DeskName based on Substation
*/
   REPEATED
   SELECT :NewMove.DeskName = O.Name
   FROM Udb_Object O,
        Udb_Grouping G,
        Udb_Grouping GG
   WHERE O.Object = G.Grouping AND
         G.GroupingType = :Type$OperatorDesk AND
         G.Member = GG.Grouping AND   /* Divisions for the Desk */
         GG.Member = :CurObject.Substation AND
         GG.Relationship = :Interaction$Memberof;  /* Station in Division */
         
   NewMove.Job = NewMove.InsertMove(CardTypeOfCard = TypeofCard, 
                                    KeepMoveText = TRUE);
   IF NewMove.Job > 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ERROR. Not able to insert new Work Permit move.';
      RETURN;
   ENDIF;
/*
** Now insert work permit details
*/
   IF Application = Application$FMS THEN
      RetCode = CALLPROC FMS_WorkPermitUpdate (
         Description = CurObject.Description,
         RSMove      = NewMove.RSMove,
         TOMove      = NewMove.TOMove,
         Job         = NewMove.Job,
         EstTimeComplete = '',
         Warning     = 0,
         ProtectionRequired = TRUE);

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'ERROR. Not able to insert FMS Work Permit Details.';
      ENDIF;
   ENDIF; 

   IF Permit IS NULL THEN
      Permit = WorkPermit.Create();
   ENDIF;
   Permit.PermitJobID = NewMove.Job;
   Permit.PreIssued = 0;
   Permit.ShiftStartTime = '';
   Permit.Description = CurObject.Description;
   Permit.ProtectionRequired = TRUE;

   RetCode = Permit.UpdateWorkPermit (PermitJobId = NewMove.Job);
   IF RetCode = PU_CANCEL THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error. Not able to insert SOA Work Permit Details.';
   ENDIF;
   
   // link to work item
   CurObject.LinkWorkPermit(SWPPermit = NewMove);
END;

METHOD LinkWorkPermit(
   SWPPermit = SWPJob 
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
  
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   ** save the permit job id into the OR/WP reference table
   */
   RetCode = CALLPROC SOA_ORPermitIns (
                      ORNumber = CurObject.ORNumber,
                      WorkItem = CurObject.WorkItem,
                      PermitJobID = SWPPermit.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ': SWPWorkItem; ERROR: Failed to save ' + 
            CurObject.ORNumber + ' and Job ' + VARCHAR(SWPPermit.Job) + ' in OR/WP reference table');
   ELSE
      CALLPROC DDB_COMMIT;
      
      i = CurObject.PermitList.LastRow + 1;
      CurObject.PermitList[i] = SWPPermit.Duplicate();
      

      IF CurObject.PermitList[i].AppName = Application$FMS THEN
         SELECT :CurObject.PermitList[i].CardName = FeederName
         FROM   FMS_Card
         WHERE  Card = :CurObject.PermitList[i].Card;
         
      ELSEIF CurObject.PermitList[i].AppName = Application$TFMS THEN
         SELECT :CurObject.PermitList[i].CardName = FeederNames
         FROM   TFMS_Card
         WHERE  Card = :CurObject.PermitList[i].Card;

      ELSEIF CurObject.PermitList[i].AppName = Application$Slc THEN
         SELECT :CurObject.PermitList[i].CardName = TOMove
         FROM   SOA_Job
         WHERE  Job = :CurObject.PermitList[i].Switchingitem;
      ENDIF;

      CurObject.PermitList[i].BaseKey = 1;  // to enable check mark

      CurObject.ConcatePermitList();
   ENDIF;   
END;

METHOD UnlinkWorkPermit(
   PermitJobID = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(80) NOT NULL WITH DEFAULT;
   ImpactedCardList = ARRAY OF INTEGEROBJECT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   RetCode = CALLPROC SOA_ORPermitDel(PermitJobID = PermitJobID);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE   
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = ' ERROR: Failed to unlink work permit from item ' + 
            CurObject.Item + ' in ' + CurObject.ORNumber;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPWorkItem;' + 
         ' ERROR: Failed to unlink PermitJobID ' + VARCHAR(PermitJobID) + ' from OR/WP reference table');
      RETURN;
   ENDIF;

   CurObject.ConcatePermitList();
END;

METHOD ConcatePermitList(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.PermitJobs = '';
   FOR i = 1 TO CurObject.PermitList.LastRow DO
      IF CurObject.PermitJobs <> '' THEN
         CurObject.PermitJobs = CurObject.PermitJobs + HC_NEWLINE;
      ENDIF;
      CurObject.PermitJobs = CurObject.PermitJobs + VARCHAR(CurObject.PermitList[i].Job);
   ENDFOR;
   IF CurObject.PermitJobs = '' THEN
      CurObject.Linked = 0;
   ELSE
      CurObject.Linked = 1;
   ENDIF;
END;

