**  12/09/19 ysp Add HandsOff restrictions
*/
METHOD DeleteRestriction (
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
  
   RetCode = CALLPROC SOA_ISPRestrictionDel (
                           Restriction = CurObject.Restriction
                           );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Error deleting ISWP Request Restriction';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPRestriction.DeleteRestriction; ' + 
                'Error deleting ISWP Request Restriction');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;

    RETURN;
END;

METHOD InsertRestriction (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Restriction = 0 THEN
      CurObject.Restriction = CALLPROC Udb_NextKey(KeyName = 'Restriction');
      IF (CurObject.Restriction < 0) THEN
          CALLPROC DDB_ROLLBACK;
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'Error: Could not generate a restriction number.  Try again. ' +
                  'Udb_Lastkey table may not be synchronous between servers. ';
          RETURN;
      ELSE
          CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   CurObject.StartTime = DATE(CurObject.StartTimeChar);
   IF CurObject.Status = 0 THEN     // applied until EndTime
      CurObject.EndTime = DATE(CurObject.EndTimeChar);
   ELSE
      CurObject.EndTime = NULL;
   ENDIF;
   CurObject.EnterTime = DATE('NOW');
   
   RetCode = CALLPROC SOA_ISPRestrictionIns(
                           Restriction  = CurObject.Restriction
                         , HandsOff     = CurObject.HandsOff
                         , Remark       = CurObject.Remark       
                         , StartTime    = CurObject.StartTime    
                         , EndTime      = CurObject.EndTime      
                         , Status       = CurObject.Status       
                         , EnterTime    = CurObject.EnterTime    
                         , EnterBy      = CurObject.EnterBy
                         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Error inserting ISWP Request Restriction';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPRestriction.InsertRestriction; ' + 
                'Error inserting ISWP Request Restriction');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;

    RETURN;
END;

METHOD LiftRestriction (
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
  
   RetCode = CALLPROC SOA_ISPRestrictionLifted (
                           Restriction = CurObject.Restriction,
                           LiftTime = DATE('Now')
                           );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Error lifting ISWP Request Restriction';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPRestriction.LiftRestriction; ' + 
                'Error lifting ISWP Request Restriction');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;

    RETURN;
END;

METHOD UpdateItems (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 to CurObject.DL.LastRow DO
      RetCode = CALLPROC SOA_ISPRestrictionItemDel (
                           Restriction = CurObject.Restriction,
                           Object = CurObject.DL[i].Object
                           );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error deleting ISWP Request Restriction Item';
         CurMethod.Trace(Text = varchar(date('now')) + ' : ISPRestriction.UpdateItems; ' + 
                'Error deleting ISWP Request Restriction Item');
         RETURN;
      ENDIF;
   ENDFOR;
   
   FOR i = 1 to CurObject.AL.LastRow DO
      RetCode = CALLPROC SOA_ISPRestrictionItemIns (
                           Restriction = CurObject.Restriction,
                           Object = CurObject.AL[i].Object
                           );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error inserting ISWP Request Restriction Item';
         CurMethod.Trace(Text = varchar(date('now')) + ' : ISPRestriction.UpdateItems; ' + 
                'Error inserting ISWP Request Restriction Item');
         RETURN;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   // return EnterTime to the web page
   CurObject.EnterTime = DATE('NOW');

   RETURN;
END;

METHOD AddItemSubstation (
   ItemEquip = ObjectSummaryClass
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   Substation = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF ItemEquip.Type = Type$Substation THEN
      CurObject.AddSubstation(Substation = ItemEquip.Object);
      
   ELSEIF ItemEquip.Type = Type$TransmissionFdr THEN
      SELECT :Substation = G2.Grouping
      FROM   UDB_Grouping G1,
             UDB_Grouping G2
      WHERE  G1.Grouping = :ItemEquip.Object AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.MemberType = :Type$ACLineSegment AND
             G1.Member = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.GroupingType = :Type$Substation
      BEGIN
         CurObject.AddSubstation(Substation = Substation);
      END;
      
   ELSEIF ItemEquip.Object > 0 THEN
      SELECT :Substation = G2.Grouping
      FROM   UDB_Grouping G2
      WHERE  G2.Member = :ItemEquip.Object AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.GroupingType = :Type$Substation
      BEGIN
         CurObject.AddSubstation(Substation = Substation);
      END;   
   ENDIF;
   
   RETURN;
END;

METHOD AddSubstation (
   Substation = INTEGER NOT NULL WITH DEFAULT
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   RetCode = CurObject.DL.Find(AttributeName = 'Object', Value = Substation);
   IF RetCode = ER_ROWNOTFOUND THEN
      i = CurObject.DL.LastRow + 1;
      CurObject.DL[i].Object = Substation;
   ENDIF;
END;

