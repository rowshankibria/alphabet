METHOD LoadJobs (
)=
DECLARE
   i = INTEGER NOT NULL;
   CardClassName = VARCHAR(10) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.J.Clear();
   IF CurObject.Application = Application$SLC THEN
      CurObject.LoadSLCJobs();
      
      FOR i = 1 TO CurObject.J.LastRow() DO
         IF CurObject.J[i].MoveCategory = MoveCategory$InformationItem OR
            CurObject.J[i].MoveCategory = MoveCategory$SwitchingItem OR
            CurObject.J[i].MoveCategory = MoveCategory$InServiceWP THEN

            SELECT :CurObject.J[i].Severity = Severity,
                   :CardClassName = CardClassName
            FROM    SLC_InformationItem
            WHERE   Job = :CurObject.J[i].Job;
            
            IF CardClassName <> '' AND CurObject.J[i].MoveCategory = MoveCategory$SwitchingItem THEN
               IF LOCATE(CurObject.J[i].Response,CardClassName) = (SIZE(CurObject.J[i].Response) + 1) THEN
                  CurObject.J[i].Response = CurObject.J[i].Response + ' - ' + CardClassName;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDFOR;

   ELSEIF CurObject.Application = Application$TFMS OR 
             CurObject.Application = Application$DSO OR 
             CurObject.Application = Application$SDS THEN
      CurObject.LoadTFMSJobs();

   ELSEIF CurObject.Application = Application$FMS THEN
      CurObject.LoadFMSJobs();

   ENDIF;
/*
**  Make sure something was found.  
*/   
   IF CurObject.J.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No jobs found for card.';
   ENDIF;
   RETURN;
END;

METHOD LoadSLCJobs (
)=
DECLARE
   i = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(500) NOT NULL WITH DEFAULT; /* Used for SLC Archive Items*/
   SwitchingItemSeq = VARCHAR(24) NOT NULL; /* Used to sequence SLC moves*/
ENDDECLARE
BEGIN     
   CurObject.JobsRow = 0;
   i = 1;

   IF CurObject.ArchiveCard = FALSE THEN
      IF CurObject.SLCItemType = Items$Active THEN
#           INCLUDE SLCLoadAllJobs  
               J2.SwItemStatus = :Card$Active
            ORDER BY SwitchingItemSeq, StepPair, StepLevel, Seq
            BEGIN
               i = i + 1;
            END;
      ELSEIF CurObject.SLCItemType = Items$Opened THEN
#           INCLUDE SLCLoadAllJobs  
               J2.SwItemStatus = :Card$Open
            ORDER BY SwitchingItemSeq, StepPair, StepLevel, Seq
            BEGIN
               i = i + 1;
            END;
      ELSEIF CurObject.SLCItemType = Items$NotClosed THEN
#           INCLUDE SLCLoadAllJobs  
               J2.SwItemStatus < :Card$Closed
            ORDER BY SwitchingItemSeq, StepPair, StepLevel, Seq
            BEGIN
               i = i + 1;
            END;
      ELSEIF CurObject.SLCItemType = Items$Specific THEN
#           INCLUDE SLCLoadAllJobs  
                SJ.SwitchingItem = :CurObject.SLCSpecificItem
            ORDER BY SwitchingItemSeq, StepPair, StepLevel, Seq
            BEGIN
               i = i + 1;
            END;
      ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Class:Job;Method:LoadJobs; Cannot load jobs.  Unknown SLC Switching Item Type.';
      ENDIF;
   ELSE
      IF CurObject.SLCItems.LastRow = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Class:Job;Method:LoadJobs; No closed items selected.'; 
         RETURN;
      ENDIF;
   
      /**  Will have passed a list of items to load */
      DynamicWhereClause = 'J.Card = ' + VARCHAR(CurObject.Card) + 
                              ' AND J.Status <> ''Del'' ' +
                              'AND J.SwitchingItem IN ';
      i = 1;
      WHILE i <= CurObject.SLCItems.LastRow() DO
            IF i = 1 THEN
               DynamicWhereClause = DynamicWhereClause +
                   '(' + VARCHAR(CurObject.SLCItems[i].Value);
            ELSE
               DynamicWhereClause = DynamicWhereClause +
                   ',' + VARCHAR(CurObject.SLCItems[i].Value);
            ENDIF;
            i = i + 1;
      ENDWHILE;                             
      DynamicWhereClause = DynamicWhereClause + ') ';

      i = 1;
      SELECT
           :CurObject.J[i].Job = J.Job,
           :CurObject.J[i].Card = J.Card,
           :CurObject.J[i].SwitchingItem = J.SwitchingItem,
           :CurObject.J[i].Seq = J.Seq,
           :CurObject.J[i].Status = J.Status,
           :CurObject.J[i].JobClass = J.JobClass,
           :CurObject.J[i].Equip = J.Equip,
           :CurObject.J[i].EquipClass = J.EquipClass,
           :CurObject.J[i].EquipClassName = J.EquipClassName,
           :CurObject.J[i].EquipName = J.EquipName,
           :CurObject.J[i].StepPair = J.StepPair,
           :CurObject.J[i].MoveType = J.MoveType,
           :CurObject.J[i].TOMove = J.TOMove,
           :CurObject.J[i].TOOperator = J.TOOperator,
           :CurObject.J[i].TOIssued = J.TOIssued,
           :CurObject.J[i].TOComplete = J.TOComplete,
           :CurObject.J[i].RSMove = J.RSMove,
           :CurObject.J[i].RSOperator = J.RSOperator,
           :CurObject.J[i].RSIssued = J.RSIssued,
           :CurObject.J[i].RSComplete = J.RSComplete,
           :CurObject.J[i].Response = J.Response,
           :CurObject.J[i].MoveBgColor = J.MoveBgColor,
           :CurObject.J[i].MoveFgColor = J.MoveFgColor,
           :CurObject.J[i].StepLevel = J.StepLevel,
           :CurObject.J[i].MoveCategory = J.MoveCategory,
           :CurObject.J[i].ActivityIdentifier = J.ActivityIdentifier,
           :CurObject.J[i].Grounds = NULL,
           :CurObject.J[i].ControlCard = :CurObject.Card
      FROM   SOA_ArchiveJob J
      WHERE  :DynamicWhereClause
      ORDER BY SwitchingItem, StepPair, StepLevel, Seq
      BEGIN
           i = i + 1;
      END;
   ENDIF;
END;

METHOD LoadTFMSJobs (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN     
   CurObject.JobsRow = 0;
   i = 1;
/*
** SDS Closed Card jobs stay in regular table.
*/
   IF CurObject.ArchiveCard = FALSE OR 
      CurObject.Application = Application$DSO OR 
      CurObject.Application = Application$SDS THEN
      
      IF CurObject.Application = Application$DSO THEN
         REPEATED
         SELECT
           :CurObject.J[i].Job = J.Job,
           :CurObject.J[i].Card = SJ.Card,
           :CurObject.J[i].Seq = SJ.Seq,
           :CurObject.J[i].Status = J.Status,
           :CurObject.J[i].JobClass = J.JobClass,
           :CurObject.J[i].Equip = J.Equip,
           :CurObject.J[i].EquipClass = J.EquipClass,
           :CurObject.J[i].EquipClassName = J.EquipClassName,
           :CurObject.J[i].EquipName = J.EquipName,
           :CurObject.J[i].StepPair = SJ.StepPair,
           :CurObject.J[i].Grounds = J.Grounds,
           :CurObject.J[i].MoveType = J.MoveType,
           :CurObject.J[i].TOMove = J.TOMove,
           :CurObject.J[i].TOMoveRules = J.TOMoveRules,
           :CurObject.J[i].TOOperator = J.TOOperator,
           :CurObject.J[i].TOIssued = J.TOIssued,
           :CurObject.J[i].TOComplete = J.TOComplete,
           :CurObject.J[i].GroundOn = J.GroundOn,
           :CurObject.J[i].RSMove = J.RSMove,
           :CurObject.J[i].RSMoveRules = J.RSMoveRules,
           :CurObject.J[i].RSOperator = J.RSOperator,
           :CurObject.J[i].RSIssued = J.RSIssued,
           :CurObject.J[i].RSComplete = J.RSComplete,
           :CurObject.J[i].Response = J.Response,
           :CurObject.J[i].ActivityIdentifier = J.ActivityIdentifier,
           :CurObject.J[i].MoveEquipClass = SJ.MoveEquipClass,
           :CurObject.J[i].Substation = J.Substation,
           :CurObject.J[i].SubstationName = O.Name, 
           :CurObject.J[i].StructurePGName = O.PrimaryGroupingName, 
           :CurObject.J[i].StructureType = O.Type, 
           :CurObject.J[i].ShadowLink = J.ShadowLink,
           :CurObject.J[i].MoveCategory = J.MoveCategory,
           :CurObject.J[i].StepLevel = SJ.StepLevel,    
           :CurObject.J[i].ControlCard = J.ControlCard,    
           :CurObject.J[i].MoveFgColor = J.MoveFgColor,    
           :CurObject.J[i].MoveBgColor = J.MoveBgColor,    
           :CurObject.J[i].DeskName = J.DeskName
         FROM   SOA_Job J,
                SOA_JobControl SJ,
                Udb_Object O
         WHERE  SJ.Card = :CurObject.Card AND
                SJ.Job = J.Job AND
                J.Substation = O.Object AND
                J.Status <> 'Del'
         ORDER BY Seq
         BEGIN
         /* All for new dielectric structure subtypes*/   
            SELECT :CurObject.J[i].StructureType = SuperType 
            FROM   Udb_ExtendedType 
            WHERE  Type = :CurObject.J[i].StructureType AND
                SuperType IN (:Type$PotheadStructure,:Type$ValveManifold,:Type$ValveCabinet);
                
            IF CurObject.J[i].StructureType = Type$PotheadStructure THEN
               CurObject.J[i].SubstationName = CurObject.J[i].StructurePGName +
                     ' PH ' + CurObject.J[i].SubstationName;
            ELSEIF CurObject.J[i].StructureType = Type$ValveManifold THEN
               CurObject.J[i].SubstationName = CurObject.J[i].StructurePGName +
                     ' VM ' + CurObject.J[i].SubstationName;
            ELSEIF CurObject.J[i].StructureType = Type$ValveCabinet THEN
               CurObject.J[i].SubstationName = CurObject.J[i].StructurePGName +
                     ' VC ' + CurObject.J[i].SubstationName;
            ENDIF;
            i = i + 1;
         END;
      ELSE
         REPEATED
         SELECT
           :CurObject.J[i].Job = J.Job,
           :CurObject.J[i].Card = SJ.Card,
           :CurObject.J[i].Seq = SJ.Seq,
           :CurObject.J[i].Status = J.Status,
           :CurObject.J[i].JobClass = J.JobClass,
           :CurObject.J[i].Equip = J.Equip,
           :CurObject.J[i].EquipClass = J.EquipClass,
           :CurObject.J[i].EquipClassName = J.EquipClassName,
           :CurObject.J[i].EquipName = J.EquipName,
           :CurObject.J[i].StepPair = SJ.StepPair,
           :CurObject.J[i].Grounds = J.Grounds,
           :CurObject.J[i].MoveType = J.MoveType,
           :CurObject.J[i].TOMove = J.TOMove,
           :CurObject.J[i].TOMoveRules = J.TOMoveRules,
           :CurObject.J[i].TOOperator = J.TOOperator,
           :CurObject.J[i].TOIssued = J.TOIssued,
           :CurObject.J[i].TOComplete = J.TOComplete,
           :CurObject.J[i].GroundOn = J.GroundOn,
           :CurObject.J[i].RSMove = J.RSMove,
           :CurObject.J[i].RSMoveRules = J.RSMoveRules,
           :CurObject.J[i].RSOperator = J.RSOperator,
           :CurObject.J[i].RSIssued = J.RSIssued,
           :CurObject.J[i].RSComplete = J.RSComplete,
           :CurObject.J[i].Response = J.Response,
           :CurObject.J[i].ActivityIdentifier = J.ActivityIdentifier,
           :CurObject.J[i].MoveEquipClass = SJ.MoveEquipClass,
           :CurObject.J[i].Substation = J.Substation,
           :CurObject.J[i].SubstationName = O.Name, 
           :CurObject.J[i].StructurePGName = O.PrimaryGroupingName, 
           :CurObject.J[i].StructureType = O.Type, 
           :CurObject.J[i].ShadowLink = J.ShadowLink,
           :CurObject.J[i].MoveCategory = J.MoveCategory,
           :CurObject.J[i].StepLevel = SJ.StepLevel,    
           :CurObject.J[i].ControlCard = J.ControlCard,    
           :CurObject.J[i].MoveFgColor = J.MoveFgColor,    
           :CurObject.J[i].MoveBgColor = J.MoveBgColor,    
           :CurObject.J[i].DeskName = J.DeskName
         FROM   SOA_Job J,
                SOA_JobControl SJ,
                Udb_Object O
         WHERE  SJ.Card = :CurObject.Card AND
                SJ.Job = J.Job AND
                J.Substation = O.Object AND
                J.Status <> 'Del'
         ORDER BY StepPair, StepLevel, Seq
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ELSE
      REPEATED
      SELECT
           :CurObject.J[i].Job = J.Job,
           :CurObject.J[i].Card = J.Card,
           :CurObject.J[i].Seq = J.Seq,
           :CurObject.J[i].Status = J.Status,
           :CurObject.J[i].JobClass = J.JobClass,
           :CurObject.J[i].Equip = J.Equip,
           :CurObject.J[i].EquipClass = J.EquipClass,
           :CurObject.J[i].EquipClassName = J.EquipClassName,
           :CurObject.J[i].EquipName = J.EquipName,
           :CurObject.J[i].StepPair = J.StepPair,
           :CurObject.J[i].MoveType = J.MoveType,
           :CurObject.J[i].TOMove = J.TOMove,
           :CurObject.J[i].TOOperator = J.TOOperator,
           :CurObject.J[i].TOIssued = J.TOIssued,
           :CurObject.J[i].TOComplete = J.TOComplete,
           :CurObject.J[i].RSMove = J.RSMove,
           :CurObject.J[i].RSOperator = J.RSOperator,
           :CurObject.J[i].RSIssued = J.RSIssued,
           :CurObject.J[i].RSComplete = J.RSComplete,
           :CurObject.J[i].Response = J.Response,
           :CurObject.J[i].ActivityIdentifier = J.ActivityIdentifier,
           :CurObject.J[i].Substation = J.Substation,
           :CurObject.J[i].MoveCategory = J.MoveCategory,
           :CurObject.J[i].StepLevel = J.StepLevel,    
           :CurObject.J[i].MoveFgColor = J.MoveFgColor,    
           :CurObject.J[i].MoveBgColor = J.MoveBgColor,
           :CurObject.J[i].Grounds = NULL,
           :CurObject.J[i].ControlCard = :CurObject.Card              
      FROM   SOA_ArchiveJob J
      WHERE  J.Card = :CurObject.Card AND
                J.Status <> 'Del' 
      ORDER BY StepPair, StepLevel, Seq
      BEGIN
            i = i + 1;
      END;
   ENDIF;
END;

METHOD LoadFMSJobs (
)=
DECLARE
   i = INTEGER NOT NULL;
   m = INTEGER NOT NULL WITH DEFAULT;
   Feeder = INTEGER NOT NULL;
ENDDECLARE
BEGIN     
   CurObject.JobsRow = 0;
   i = 1;

   IF CurObject.ArchiveCard = FALSE THEN
      Feeder = 0; 
      SELECT :Feeder = Feeder
      FROM   FMS_Card
      WHERE  Card = :CurObject.Card;

      REPEATED
      SELECT :CurObject.J[i].Job = J.Job, 
             :CurObject.J[i].Status = J.Status,
             :CurObject.J[i].JobClass = J.JobClass,
             :CurObject.J[i].Card = SJ.Card,   
             :CurObject.J[i].Seq = SJ.Seq,
             :CurObject.J[i].Equip = J.Equip,
             :CurObject.J[i].EquipClass = J.EquipClass,  
             :CurObject.J[i].MoveEquipClass = SJ.MoveEquipClass,  
             :CurObject.J[i].EquipClassName = J.EquipClassName,  
             :CurObject.J[i].PrintID = SJ.PrintID,
             :CurObject.J[i].EquipName = J.EquipName,
             :CurObject.J[i].StepPair = SJ.StepPair,
             :CurObject.J[i].Grounds = J.Grounds,
             :CurObject.J[i].MoveType = J.MoveType,
             :CurObject.J[i].TOMove = J.TOMove,
             :CurObject.J[i].TOOperator = J.TOOperator,
             :CurObject.J[i].TOIssued = J.TOIssued,
             :CurObject.J[i].TOComplete = J.TOComplete,
             :CurObject.J[i].GroundOn = J.GroundOn,
             :CurObject.J[i].RSMove = J.RSMove,
             :CurObject.J[i].RSOperator = J.RSOperator,
             :CurObject.J[i].RSIssued = J.RSIssued,
             :CurObject.J[i].RSComplete = J.RSComplete,
             :CurObject.J[i].TOMoveRules = J.TOMoveRules,
             :CurObject.J[i].RSMoveRules = J.RSMoveRules,
             :CurObject.J[i].Response = J.Response,
             :CurObject.J[i].MoveFGColor = J.MoveFGColor,
             :CurObject.J[i].MoveBGColor = J.MoveBGColor,
             :CurObject.J[i].ControlCard = J.ControlCard,
             :CurObject.J[i].Substation = J.Substation,
             :CurObject.J[i].MoveCategory = J.MoveCategory,
             :CurObject.J[i].ActivityIdentifier = J.ActivityIdentifier
      FROM   SOA_JobControl SJ,
             SOA_Job J
      WHERE  SJ.Card = :CurObject.Card AND
             SJ.Job = J.Job AND
             J.Status <> 'Del' AND
             J.Status <> 'Hid'
      ORDER BY Seq
      BEGIN
          i = i + 1;
      END;
   ELSE
      Feeder = 0; 
      SELECT :Feeder = Feeder
      FROM   FMS_ArchiveCard
      WHERE  Card = :CurObject.Card;

      REPEATED
      SELECT :CurObject.J[i].Job = J.Job, 
             :CurObject.J[i].Status = J.Status,
             :CurObject.J[i].JobClass = J.JobClass,
             :CurObject.J[i].Card = J.Card,   
             :CurObject.J[i].Seq = J.Seq,
             :CurObject.J[i].Equip = J.Equip,
             :CurObject.J[i].MoveEquipClass = J.MoveEquipClass,  
             :CurObject.J[i].EquipClass = J.EquipClass,  
             :CurObject.J[i].EquipClassName = J.EquipClassName,  
             :CurObject.J[i].PrintID = J.PrintID,
             :CurObject.J[i].EquipName = J.EquipName,
             :CurObject.J[i].StepPair = J.StepPair,
             :CurObject.J[i].Grounds = J.G,
             :CurObject.J[i].MoveType = J.MoveType,
             :CurObject.J[i].TOMove = J.TOMove,
             :CurObject.J[i].TOOperator = J.TOOperator,
             :CurObject.J[i].TOIssued = J.TOIssued,
             :CurObject.J[i].TOComplete = J.TOComplete,
             :CurObject.J[i].GroundOn = J.GroundOn,
             :CurObject.J[i].RSMove = J.RSMove,
             :CurObject.J[i].RSOperator = J.RSOperator,
             :CurObject.J[i].RSIssued = J.RSIssued,
             :CurObject.J[i].RSComplete = J.RSComplete,
             :CurObject.J[i].TOMoveRules = J.TOMoveRules,
             :CurObject.J[i].RSMoveRules = J.RSMoveRules,
             :CurObject.J[i].ControlCard = J.Card,
             :CurObject.J[i].Response = J.Response,
             :CurObject.J[i].MoveFGColor = J.Colors,
             :CurObject.J[i].ActivityIdentifier = J.MoveOrigin              
      FROM   FMS_ArchiveJob J
      WHERE  J.Card = :CurObject.Card AND
             J.Status <> 'Del' AND
             J.Status <> 'Hid'
      ORDER BY Seq
      BEGIN
         i = i + 1;
      END;
   ENDIF;
/*
**  Scroll through equipment looking for grouper types, then get the 
**  subtype to the feeder.
*/
    FOR i = 1 TO CurObject.J.LastRow() DO

       IF CurObject.J[i].Equip = 0 OR Feeder = 0 THEN
          CONTINUE;
       ENDIF;

       m = 0;
       SELECT  :m = Type
       FROM    Udb_ExtendedType 
       WHERE   SuperType = :Type$ATSGrouper AND
               Type = :CurObject.J[i].EquipClass;

       IF m > 0 THEN
/*
** Only display ATS subtype if the jobclass is defined to the move subtype 
*/
          m = 0;
          SELECT :m = G.MemberType
          FROM   Udb_Grouping G
          WHERE  G.Member = :CurObject.J[i].Equip AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Grouping = :Feeder AND
                 :CurObject.J[i].MoveEquipClass IN ( 
                                   SELECT Type FROM Udb_ExtendedType
                                   WHERE  SuperType = G.MemberType);
       ENDIF;

       IF m > 0 THEN 
          REPEATED 
          SELECT :CurObject.J[i].EquipClass = G.MemberType,
                 :CurObject.J[i].EquipClassName = T.Name
          FROM   Udb_Grouping G,
                 Udb_Type T
          WHERE  G.Grouping = :Feeder AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = :CurObject.J[i].Equip AND 
                 G.MemberType = T.Type;
       ENDIF;
    ENDFOR;
                
END;

METHOD LoadSingleFMSJob (
   Job = INTEGER NOT NULL;
)=
DECLARE
   i = INTEGER NOT NULL;
   m = INTEGER NOT NULL WITH DEFAULT;
   Feeder = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.JobsRow = 0;

   IF CurObject.ArchiveCard = FALSE THEN

         Feeder = 0; 
         SELECT :Feeder = Feeder
         FROM   FMS_Card
         WHERE  Card = :CurObject.Card;
    
         REPEATED
         SELECT :CurObject.J[i].Job = J.Job, 
                :CurObject.J[1].Status = J.Status,
                :CurObject.J[1].JobClass = J.JobClass,
                :CurObject.J[1].Card = SJ.Card,   
                :CurObject.J[1].Seq = SJ.Seq,
                :CurObject.J[1].Equip = J.Equip,
                :CurObject.J[1].EquipClass = J.EquipClass,  
                :CurObject.J[1].MoveEquipClass = SJ.MoveEquipClass,  
                :CurObject.J[1].EquipClassName = J.EquipClassName,  
                :CurObject.J[1].PrintID = SJ.PrintID,
                :CurObject.J[1].EquipName = J.EquipName,
                :CurObject.J[1].StepPair = SJ.StepPair,
                :CurObject.J[1].Grounds = J.Grounds,
                :CurObject.J[1].MoveType = J.MoveType,
                :CurObject.J[1].TOMove = J.TOMove,
                :CurObject.J[1].TOOperator = J.TOOperator,
                :CurObject.J[1].TOIssued = J.TOIssued,
                :CurObject.J[1].TOComplete = J.TOComplete,
                :CurObject.J[1].GroundOn = J.GroundOn,
                :CurObject.J[1].RSMove = J.RSMove,
                :CurObject.J[1].RSOperator = J.RSOperator,
                :CurObject.J[1].RSIssued = J.RSIssued,
                :CurObject.J[1].RSComplete = J.RSComplete,
                :CurObject.J[1].TOMoveRules = J.TOMoveRules,
                :CurObject.J[1].RSMoveRules = J.RSMoveRules,
                :CurObject.J[1].Response = J.Response,
                :CurObject.J[1].MoveFGColor = J.MoveFGColor,
                :CurObject.J[1].MoveBGColor = J.MoveBGColor,
                :CurObject.J[1].ControlCard = J.ControlCard,
                :CurObject.J[1].Substation = J.Substation,
                :CurObject.J[1].MoveCategory = J.MoveCategory,
                :CurObject.J[1].ActivityIdentifier = J.ActivityIdentifier
         FROM   SOA_JobControl SJ,
                SOA_Job J
         WHERE  SJ.Card = :CurObject.Card AND
                SJ.Job = :Job AND 
                SJ.Job = J.Job;
   ELSE
         Feeder = 0; 
         SELECT :Feeder = Feeder
         FROM   FMS_ArchiveCard
         WHERE  Card = :CurObject.Card;

         REPEATED
         SELECT :CurObject.J[1].Job = J.Job, 
                :CurObject.J[1].Status = J.Status,
                :CurObject.J[1].JobClass = J.JobClass,
                :CurObject.J[1].Card = J.Card,   
                :CurObject.J[1].Seq = J.Seq,
                :CurObject.J[1].Equip = J.Equip,
                :CurObject.J[1].MoveEquipClass = J.MoveEquipClass,  
                :CurObject.J[1].EquipClass = J.EquipClass,  
                :CurObject.J[1].EquipClassName = J.EquipClassName,  
                :CurObject.J[1].PrintID = J.PrintID,
                :CurObject.J[1].EquipName = J.EquipName,
                :CurObject.J[1].StepPair = J.StepPair,
                :CurObject.J[1].Grounds = J.G,
                :CurObject.J[1].MoveType = J.MoveType,
                :CurObject.J[1].TOMove = J.TOMove,
                :CurObject.J[1].TOOperator = J.TOOperator,
                :CurObject.J[1].TOIssued = J.TOIssued,
                :CurObject.J[1].TOComplete = J.TOComplete,
                :CurObject.J[1].GroundOn = J.GroundOn,
                :CurObject.J[1].RSMove = J.RSMove,
                :CurObject.J[1].RSOperator = J.RSOperator,
                :CurObject.J[1].RSIssued = J.RSIssued,
                :CurObject.J[1].RSComplete = J.RSComplete,
                :CurObject.J[1].TOMoveRules = J.TOMoveRules,
                :CurObject.J[1].RSMoveRules = J.RSMoveRules,
                :CurObject.J[1].ControlCard = J.Card,
                :CurObject.J[1].Response = J.Response,
                :CurObject.J[1].MoveFGColor = J.Colors,
                :CurObject.J[1].ActivityIdentifier = J.MoveOrigin              
         FROM   FMS_ArchiveJob J
         WHERE  J.Card = :CurObject.Card AND
                J.Job = :Job;
   ENDIF;
/*
**  Scroll through equipment looking for grouper types, then get the 
**  subtype to the feeder. These codes are the same as in LoadFMSJobs.
*/
    FOR i = 1 TO CurObject.J.LastRow() DO

       IF CurObject.J[i].Equip = 0 OR Feeder = 0 THEN
          CONTINUE;
       ENDIF;

       m = 0;
       SELECT  :m = Type
       FROM    Udb_ExtendedType 
       WHERE   SuperType = :Type$ATSGrouper AND
               Type = :CurObject.J[i].EquipClass;

       IF m > 0 THEN
/*
** Only display ATS subtype if the jobclass is defined to the move subtype 
*/
          m = 0;
          SELECT :m = G.MemberType
          FROM   Udb_Grouping G
          WHERE  G.Member = :CurObject.J[i].Equip AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Grouping = :Feeder AND
                 :CurObject.J[i].MoveEquipClass IN ( 
                                   SELECT Type FROM Udb_ExtendedType
                                   WHERE  SuperType = G.MemberType);
       ENDIF;
       
       IF m > 0 THEN
          REPEATED 
          SELECT :CurObject.J[i].EquipClass = G.MemberType,
                 :CurObject.J[i].EquipClassName = T.Name
          FROM   Udb_Grouping G,
                 Udb_Type T
          WHERE  G.Grouping = :Feeder AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = :CurObject.J[i].Equip AND 
                 G.MemberType = T.Type;
       ENDIF;
    ENDFOR;
END;

METHOD LoadPhaseCheckMoves (
)=
DECLARE
   PhaseCheckEquip = ARRAY OF FMS_Equip;
   AltPhaseCheckEquip = ARRAY OF FMS_Equip;
   i = INTEGER NOT NULL;
   x = INTEGER NOT NULL;
   SDCard = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load colors for phase check moves.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.J.LastRow() = 0 THEN
      RETURN;
   ENDIF;

   IF CurObject.J[1].Card = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Class:Job_ASE, ' +
         'Method:LoadPhaseCheckMoves - Card attribute not found in jobs array.';   
   ENDIF;
   
   i = 1;
   x = 1;
   PhaseCheckEquip.Clear();
   AltPhaseCheckEquip.Clear();
   REPEATED
   SELECT :PhaseCheckEquip[i].Equip = PhaseCheckEquip,       
          :AltPhaseCheckEquip[x].Equip = SatisfyEquip       
   FROM   FMS_PhaseCheck
   WHERE  Card = :CurObject.J[1].Card AND
          CompletionTime IS NULL
   UNION
   SELECT P.PhaseCheckEquip,
          P.SatisfyEquip
   FROM   FMS_PhaseCheck P,
          FMS_StepDownLink L
   WHERE ((L.Card = :CurObject.J[1].Card AND
          L.StepDownCard = P.Card) OR 
         (L.StepDownCard = :CurObject.J[1].Card AND
          L.Card = P.Card)) AND
          P.CompletionTime IS NULL
   UNION
   SELECT P.PhaseCheckEquip,
          P.SatisfyEquip
   FROM   FMS_PhaseCheck P,
          FMS_PortionLink L
   WHERE ((L.Card = :CurObject.J[1].Card AND
          L.PortionCard = P.Card) OR 
         (L.PortionCard = :CurObject.J[1].Card AND
          L.Card = P.Card)) AND
          P.CompletionTime IS NULL
   BEGIN
      /*
      ** do not put it in alternate list if not sure that
      ** there is an alternate
      */
      IF PhaseCheckEquip[i].Equip = AltPhaseCheckEquip[x].Equip THEN
         AltPhaseCheckEquip[x].Equip = -1;
      /*
      ** put both in alternate list 
      */
      ELSE
         x = x + 1;
         AltPhaseCheckEquip[x].Equip = PhaseCheckEquip[i].Equip;
      ENDIF;
      i = i + 1;
      x = x + 1;
   END;
/*
** Lighten the Moveorigin field to indicate phase checks:
**     RED for phase check without alternate
**     PALE RED for phase check with alternate (all alternates)
*/
   x = 1;
   WHILE x <= CurObject.J.LastRow() DO

      IF (CurObject.J[x].StepPair = StepHeading$Deload OR
          CurObject.J[x].StepPair = StepHeading$Iso) THEN

         CurObject.J[x].PhaseCheckColor = CurObject.CardNormalColor;
    /*
    ** first round can make it RED
    */
         i = 1;
         WHILE i <= PhaseCheckEquip.LastRow() DO
            IF CurObject.J[x].Equip = PhaseCheckEquip[i].Equip THEN
                IF CurObject.J[x].RSComplete IS NULL THEN
                    CurObject.J[x].PhaseCheckColor = CC_RED;
                    ENDLOOP;
                ENDIF;
            ENDIF;
            i = i + 1;
         ENDWHILE;
    /*
    ** second round can make it PALE RED (salmon)
    */
         i = 1;
         WHILE i <= AltPhaseCheckEquip.LastRow() DO
            IF CurObject.J[x].Equip = AltPhaseCheckEquip[i].Equip THEN
                IF CurObject.J[x].RSComplete IS NULL THEN
                    CurObject.J[x].PhaseCheckColor = CC_PALE_RED;
                    ENDLOOP;
                ENDIF;
            ENDIF;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.J[x].PhaseCheckColor = CurObject.CardNormalColor;
      ENDIF;

      IF CurObject.J[x].ActivityIdentifier = 'N' THEN
         CurObject.J[x].PhaseCheckColor = CC_PALE_GRAY;
      ENDIF;

      x = x + 1;
   ENDWHILE;

   RETURN;
END;

METHOD LoadWorkPermits(
   IncludeHidden = INTEGER NOT NULL WITH DEFAULT  /* Passed from PhaseChecks screen */
)=
DECLARE
   i = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.WP.Clear();      /* clear array */ 

   IF CurObject.ArchiveCard = FALSE THEN
      IF IncludeHidden = 1 THEN
         DynamicWhereClause = 'JC.Card = ' + VARCHAR(CurObject.Card) + ' AND ' + 
             'JC.StepPair = ' + VARCHAR(StepHeading$OTW) + ' AND ' + 
             'JC.Job = J.Job AND ' +
             'J.Status IN('''', ''Hid'') AND ' + 
             'J.JobClass <> 0 AND ' +
             'WP.PermitJobID = J.Job ';
      ELSE
         DynamicWhereClause = 'JC.Card = ' + VARCHAR(CurObject.Card) + ' AND ' + 
             'JC.StepPair = ' + VARCHAR(StepHeading$OTW) + ' AND ' + 
             'JC.Job = J.Job AND ' +
             'J.Status = '''' AND ' + 
             'J.JobClass <> 0 AND ' +
             'WP.PermitJobID = J.Job ';
      ENDIF;

      i = 1;
      SELECT :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Card = JC.Card,
             :CurObject.WP[i].Seq = JC.Seq,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].PrintID = JC.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].StepPair = JC.StepPair,
             :CurObject.WP[i].Grounds = J.Grounds,
             :CurObject.WP[i].MoveType = J.MoveType,
             :CurObject.WP[i].TOMove = J.TOMove,
             :CurObject.WP[i].TOOperator = J.TOOperator,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].GroundOn = J.GroundOn,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSOperator = J.RSOperator,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].TOMoveRules = J.TOMoveRules,
             :CurObject.WP[i].RSMoveRules = J.RSMoveRules,
             :CurObject.WP[i].Response = J.Response,
             :CurObject.WP[i].MoveFGColor = J.MoveFGColor,
             :CurObject.WP[i].PhaseCheckIndicator = WP.PhaseCheckIndicator
      FROM   SOA_JobControl JC,
             SOA_Job J,
             FMS_WorkPermit WP
      WHERE  :DynamicWhereClause 
      ORDER BY Seq
      BEGIN
         i = i + 1;
      END;

   ELSE
      IF IncludeHidden = 1 THEN
         DynamicWhereClause = 'J.Card = ' + VARCHAR(CurObject.Card) + ' AND ' + 
             'J.Status IN ('''', ''Hid'') AND ' +
             'J.StepPair = ' + VARCHAR(StepHeading$OTW) + ' AND ' + 
             'J.JobClass <> 0 ';
      ELSE
          DynamicWhereClause = 'J.Card = ' + VARCHAR(CurObject.Card) + ' AND ' + 
             'J.Status = '''' AND ' +
             'J.StepPair = ' + VARCHAR(StepHeading$OTW) + ' AND ' + 
             'J.JobClass <> 0 ';
      ENDIF;
      
      i = 1;
      SELECT :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Card = J.Card,
             :CurObject.WP[i].Seq = J.Seq,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].PrintID = J.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].StepPair = J.StepPair,
             :CurObject.WP[i].Grounds = J.G,
             :CurObject.WP[i].MoveType = J.MoveType,
             :CurObject.WP[i].TOMove = J.TOMove,                                              
             :CurObject.WP[i].TOOperator = J.TOOperator,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].GroundOn = J.GroundOn,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSOperator = J.RSOperator,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].TOMoveRules = J.TOMoveRules,
             :CurObject.WP[i].RSMoveRules = J.RSMoveRules,
             :CurObject.WP[i].Response = J.Response,
             :CurObject.WP[i].MoveFGColor = J.Colors,
             :CurObject.WP[i].PhaseCheckIndicator = 0
      FROM   FMS_ArchiveJob J
      WHERE  :DynamicWhereClause 
      ORDER BY Seq
      BEGIN
         i = i + 1;
      END;

   ENDIF;
   CALLPROC DDB_ROLLBACK;
/*
**  Make sure something was found.  
*/  
   IF CurObject.WP.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No WorkPermits found for card.';
   ENDIF;
   RETURN;
END;


METHOD LoadJobDetails (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load job details for a job.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ArchiveCard = TRUE AND 
           CurObject.Application <> Application$SDS THEN
      IF CurObject.Application = Application$FMS THEN
         REPEATED
         SELECT  :CurObject.JD.PrintID = J.PrintID,
                 :CurObject.JD.Equip = J.Equip,
                 :CurObject.JD.EquipName = J.EquipName,
                 :CurObject.JD.Response = J.Response,
                 :CurObject.JD.TOMove = J.TOMove,
                 :CurObject.JD.RSMove = J.RSMove,
                 :CurObject.JD.TOOperator = J.TOOperator,
                 :CurObject.JD.RSOperator = J.RSOperator
         FROM     FMS_ArchiveJob J
         WHERE    J.Job = :CurObject.JD.Job;
      ELSE
         REPEATED
         SELECT  :CurObject.JD.PrintID = J.PrintID,
                 :CurObject.JD.Equip = J.Equip,
                 :CurObject.JD.EquipName = J.EquipName,
                 :CurObject.JD.Response = J.Response,
                 :CurObject.JD.TOMove = J.TOMove,
                 :CurObject.JD.RSMove = J.RSMove,
                 :CurObject.JD.TOOperator = J.TOOperator,
                 :CurObject.JD.RSOperator = J.RSOperator
         FROM     SOA_ArchiveJob J
         WHERE    J.Job = :CurObject.JD.Job;
      ENDIF;
      CALLPROC DDB_ROLLBACK; 
   ELSE
      REPEATED
      SELECT  :CurObject.JD.PrintID = JC.PrintID,
              :CurObject.JD.Equip = J.Equip,
              :CurObject.JD.EquipName = J.EquipName,
              :CurObject.JD.Response = J.Response,
              :CurObject.JD.TOMove = J.TOMove,
              :CurObject.JD.RSMove = J.RSMove,
              :CurObject.JD.TOOperator = J.TOOperator,
              :CurObject.JD.RSOperator = J.RSOperator
      FROM     SOA_Job J,
               SOA_JobControl JC
      WHERE    J.Job = :CurObject.JD.Job AND
               J.Job = JC.Job AND
               JC.Card = :CurObject.Card;
      CALLPROC DDB_ROLLBACK; 
   ENDIF;
      
   CurObject.JD.ShutOffOp = '';
   CurObject.JD.DiffShutOffOp = '';
   IF CurObject.JD.TOOperator IS NOT NULL THEN            
      SELECT :CurObject.JD.TOOperatorName = Description
      FROM   Udb_Object
      WHERE  Object = :CurObject.JD.TOOperator; 
      CALLPROC DDB_ROLLBACK;
    
      IF CurObject.JD.TOOperator = Operator$SteamDistribMechanic OR
          CurObject.JD.TOOperator = Operator$StationOperator OR
          CurObject.JD.TOOperator = Operator$StationSupervisor THEN
         SELECT :CurObject.JD.ShutOffOp = New
         FROM   SOA_Log
         WHERE  Job = :CurObject.JD.Job AND
                Item = 'GENERIC OP' AND
                Old = 'ShutOff Operator';
      ENDIF;

         SELECT :CurObject.JD.DiffShutOffOp = New
         FROM   SOA_Log
         WHERE  Job = :CurObject.JD.Job AND
                Item = 'RETURN OP' AND
                Old = 'ShutOff Operator';
   ENDIF;
      
   CurObject.JD.TurnOnOp = '';
   CurObject.JD.DiffTurnOnOp = '';
   IF CurObject.JD.RSOperator IS NOT NULL THEN            
      SELECT :CurObject.JD.RSOperatorName = Description
      FROM   Udb_Object
      WHERE  Object = :CurObject.JD.RSOperator; 
      CALLPROC DDB_ROLLBACK;

      IF CurObject.JD.RSOperator = Operator$SteamDistribMechanic OR
          CurObject.JD.RSOperator = Operator$StationOperator OR
          CurObject.JD.RSOperator = Operator$StationSupervisor THEN
         SELECT :CurObject.JD.TurnOnOp = New
         FROM   SOA_Log
         WHERE  Job = :CurObject.JD.Job AND
                Item = 'GENERIC OP' AND
                Old = 'TurnOn Operator';
      ENDIF;

         SELECT :CurObject.JD.DiffTurnOnOp = New
         FROM   SOA_Log
         WHERE  Job = :CurObject.JD.Job AND
                Item = 'RETURN OP' AND
                Old = 'TurnOn Operator';
   ENDIF;
/*
** Break select apart to support equip not in switch or
** without location.
*/      
   SELECT :CurObject.JD.EquipClass  = O.Type,
          :CurObject.JD.EquipClassName   = O.TypeName,
          :CurObject.JD.Combination = O.Combination,
          :CurObject.JD.LockNumber = O.LockNumber,
          :CurObject.JD.EquipComment     = O.Comment
   FROM    Udb_Object O
   WHERE   O.Object = :CurObject.JD.Equip;

   REPEATED
   SELECT :CurObject.JD.Network     = T1.Name,    
          :CurObject.JD.Relay       = T2.Name, 
          :CurObject.JD.NormalOpen  = S.NormalOpen,
          :CurObject.JD.CurrentlyOpen = S.CurrentlyOpen,
          :CurObject.JD.StopTag     = S.StopTag
   FROM    Udb_Switch S,
           Udb_Type T1,
           Udb_Type T2
   WHERE   S.Object = :CurObject.JD.Equip AND
           S.NetworkType = T1.Type AND
           S.RelayType = T2.Type;

   REPEATED
   SELECT :CurObject.JD.Address1    = L.L1,
          :CurObject.JD.Address2    = L.L2,
          :CurObject.JD.Address3    = L.L3,
          :CurObject.JD.Address4    = L.L4,
          :CurObject.JD.LocationComment     = L.Comment
   FROM    Udb_Location L,          
           Udb_Grouping G 
   WHERE   G.Member = :CurObject.JD.Equip AND
           G.Relationship = :Interaction$LocatedWith AND
           G.Grouping = L.Object;
   CALLPROC DDB_ROLLBACK; 
/*
**  Load 
*/   
   SELECT   :CurObject.JD.EquipTemplateObject = O.Object,
            :CurObject.JD.EquipTemplateName = O.Name
   FROM     Udb_Grouping G,
            Udb_Object O
   WHERE    G.Member = :CurObject.JD.Equip AND
            G.Relationship = :Interaction$CharacteristicsFrom AND              
            G.Grouping = O.Object;
   
/*
**  Get acknowledged by FCR name time
*/ 
   IF CurObject.ArchiveCard = FALSE THEN
      SELECT :CurObject.JD.AcknowledgedByFCR = AcknowledgedByFCR,
             :CurObject.JD.AcknowledgedTime = AcknowledgedTime
      FROM FMS_WorkPermit
      WHERE PermitJobID = :CurObject.JD.Job;
   ELSE
      /* 
      ** Fields are not being archived.  Once they are, they should be
      ** selected in here.
      */
   ENDIF;
   RETURN;
END;

METHOD SetFMSColors (
)=
DECLARE
   BT = TM_Alert;
   BGColor = INTEGER NOT NULL;
   FGColor = INTEGER NOT NULL;
   COFeeders = ARRAY OF INTEGERObject;  /* Feeding feeders that are cutout */
   COFedBy = ARRAY OF INTEGERObject;  /* Feeding feeders that are cutout */
   FedBy = ARRAY OF INTEGERObject;  /* Jobs with equipment fed by another feeder, excluding interupter switches */
   Feeder = INTEGER NOT NULL WITH DEFAULT;
   FODMoves = ARRAY OF FODJob;          /*Moves on an FOD Order */
   FaultMoves = ARRAY OF Job;           /*Fault Moves on the card */
   OrderNumber = INTEGER NOT NULL;
   OpOrderDoesNotExist = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN*/
   OpOrderStatus = INTEGER NOT NULL WITH DEFAULT; /*UpdateMoveColor checks*/
   NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
   PAExists = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   PAMoves = ARRAY OF Job;                    /*Process Auto moves on the card*/
   PermitStatus = INTEGER NOT NULL;          /* FCR Permit Revision? */
   i = INTEGER NOT NULL;
   m = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TempFeeder = INTEGER NOT NULL WITH DEFAULT;
   TempJob = INTEGER NOT NULL WITH DEFAULT;
   TimeNow = DATE NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :TimeNow = date('now'),
          :Feeder = Feeder,
          :TypeOfCard = TypeOfCard,
          :NetworkFeeder = NetworkFeeder
   FROM   FMS_CARD
   WHERE  Card = :CurObject.Card;
/*
**  If we are on a 33kv feeder find any equipment being fed by another feeder
*/
   IF NetworkFeeder = NetworkFeeder$33kv THEN
      /*
      ** Find Cutout feeders that are feeding a segment on this feeder.
      */
      COFeeders.Clear();
      i = 1;
      SELECT :TempFeeder = G.Grouping
      FROM   TFMS_CardToObject CTO,
             Udb_Grouping G
      WHERE  CTO.Card = :CurObject.Card AND
             CTO.Object = G.Member AND
             G.RelationShip = :Interaction$FedBy AND
             G.GroupingType = :Type$Feeder
      BEGIN
         m = 0;
         SELECT :m = 1
         FROM   FMS_ObjectStatus OS
         WHERE  OS.Object = :TempFeeder AND
                OS.Status = :Status$CO;
         IF m = 1 THEN
            COFeeders[i].Value = TempFeeder;
            i = i + 1;
         ENDIF;
      END;
      
      COFedBy.Clear();
      FedBy.Clear();
      m = 1;
      i = 1;
      SELECT :TempJob = J.Job,
             :TempFeeder = G2.Grouping
      FROM   SOA_Job J,
             SOA_JobControl JC,
             Udb_Grouping G,
             Udb_Grouping G2
      WHERE  JC.Card = :CurObject.Card AND
             JC.Job = J.Job AND
             J.Status <> 'Del' AND J.Status <> :Job$Xfer AND
             J.JobClass <> :Move$NetworkProtectionCheck AND  
             J.MoveCategory IN (:MoveCategory$Normal, :MoveCategory$Fake) AND
             J.Equip = G.Member AND
             G.MemberType NOT IN (SELECT Type
                                  FROM   Udb_ExtendedType
                                  WHERE  SuperType = :Type$ISOSwitch) AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$FedBy AND
             G2.GroupingType = :Type$Feeder
      BEGIN
         RetCode = COFeeders.Find(AttributeName = 'Value',
                                  Value = TempFeeder);
         IF RetCode = ER_OK THEN
            COFedBy[m].Value = TempJob;
            m = m + 1;
         ELSE
            FedBy[i].Value = TempJob;
            i = i + 1; 
         ENDIF;     
      END;
   ENDIF;
/*
** Get list of Moves on the card that are on an FOD Order.  Will be used for
** subsequent checking to set move color to gray if issued move order is not yet
** acknowledged or completed move is not yet confirmed.
*/
   FODMoves.Clear();
   i = 1; 
   REPEATED
   SELECT :FODMoves[i].Job = FOJ.Job
         ,:FODMoves[i].TORS = FOJ.TORS
         ,:FODMoves[i].JobStatus = FOJ.JobStatus
   FROM   IR_FODOrder FO,
          IR_FODOrderJobs FOJ
   WHERE  FO.Card = :CurObject.Card AND
          FO.OrderNumber = FOJ.OrderNumber AND
          FOJ.JobStatus IN (:Order$Opened, :Order$Downloaded,
                            :Order$Acknowledged, :Order$Closed)
   BEGIN
      i = i + 1;
   END;
/*
** Get list of Fault Moves on the card that have not yet been reviewed.  
** Will be used for subsequent checking to set move color to gray.
*/
   FaultMoves.Clear();
   i = 1; 
   REPEATED
   SELECT :FaultMoves[i].Job = F.Job
   FROM   SOA_JobControl JC,
          FMS_Fault F
   WHERE  JC.Card = :CurObject.Card AND
          JC.Job = F.Job AND
          F.FODFaultStatus = :Fault$Received
   BEGIN
      i = i + 1;
   END;
/*
** Load all outstanding process automation moves on these card for each 
** interface, the unissued move will be colored to indicate the move has been
** set up for process automation.
*/
   PAExists = 0;
   SELECT  :PAExists = COUNT(*)
   FROM    FMS_AutomationBlock
   WHERE   Card = :CurObject.Card AND
           BlockStatus <= :BlockStatus$Wait;

   IF PAExists > 0 THEN

      PAMoves.Clear();
      i = 1;
      REPEATED
      SELECT :PAMoves[i].Job = J.Job
      FROM   FMS_AutomationBlock AB,
             IR_WorkPermit WP,
             SOA_Job J
      WHERE  AB.Card = :CurObject.Card AND
             AB.BlockStatus <= :BlockStatus$Wait AND
             AB.Block = WP.WorkPermit AND
             AB.Block = J.Job AND
             J.TOIssued IS NULL 
      BEGIN       
         PAMoves[i].TORS = Job$TakeoutInt;  
         i = i + 1;
      END;

      REPEATED
      SELECT :PAMoves[i].Job = J.Job,
             :PAMoves[i].TORS = FOJ.TORS  
      FROM   FMS_AutomationBlock AB,
             IR_FODOrderJobs FOJ,
             SOA_Job J
      WHERE  AB.Card = :CurObject.Card AND
             AB.BlockStatus <= :BlockStatus$Wait AND
             AB.Block = FOJ.OrderNumber AND
             FOJ.TORS = :Job$TakeoutInt AND
             FOJ.Job = J.Job AND
             J.TOIssued IS NULL 
      BEGIN       
         i = i + 1;
      END;

      REPEATED
      SELECT :PAMoves[i].Job = J.Job,
             :PAMoves[i].TORS = FOJ.TORS  
      FROM   FMS_AutomationBlock AB,
             IR_FODOrderJobs FOJ,
             SOA_Job J
      WHERE  AB.Card = :CurObject.Card AND
             AB.BlockStatus <= :BlockStatus$Wait AND
             AB.Block = FOJ.OrderNumber AND
             FOJ.TORS = :Job$RestoreInt AND
             FOJ.Job = J.Job AND
             J.RSIssued IS NULL 
      BEGIN       
         i = i + 1;
      END;

      REPEATED
      SELECT :PAMoves[i].Job = J.Job,
             :PAMoves[i].TORS = OJ.TORS  
      FROM   FMS_AutomationBlock AB,
             IR_OpOrderJobs OJ,
             SOA_Job J
      WHERE  AB.Card = :CurObject.Card AND
             AB.BlockStatus <= :BlockStatus$Wait AND
             AB.Block = OJ.OrderNumber AND
             OJ.TORS = :Job$TakeoutInt AND
             OJ.Job = J.Job AND
             J.TOIssued IS NULL 
      BEGIN       
         i = i + 1;
      END;

      REPEATED
      SELECT :PAMoves[i].Job = J.Job,
             :PAMoves[i].TORS = OJ.TORS  
      FROM   FMS_AutomationBlock AB,
             IR_OpOrderJobs OJ,
             SOA_Job J
      WHERE  AB.Card = :CurObject.Card AND
             AB.BlockStatus <= :BlockStatus$Wait AND
             AB.Block = OJ.OrderNumber AND
             OJ.TORS = :Job$RestoreInt AND
             OJ.Job = J.Job AND
             J.RSIssued IS NULL 
      BEGIN       
         i = i + 1;
      END;
   ENDIF;

   OpOrderDoesNotExist = FALSE;
   i = 1;
   WHILE i <= CurObject.J.LastRow() DO
      CurObject.J[i].TOIssuedFG = CC_BLACK;
      CurObject.J[i].RSIssuedFG = CC_BLACK;
      CurObject.J[i].TOCompleteFG = CC_BLACK;
      CurObject.J[i].RSCompleteFG = CC_BLACK;  
      /*
      **  If Job is FedBy another feeder show response in yellow
      */
      IF NetworkFeeder = NetworkFeeder$33kv THEN
         RetCode = FedBy.Find(AttributeName = 'Value',
                              Value = CurObject.J[i].Job);
         IF RetCode = ER_OK THEN
            CurObject.J[i].ResponseBG = CC_YELLOW;
         ELSE  /* see if red condition applies */
            RetCode = COFedBy.Find(AttributeName = 'Value',
                                   Value = CurObject.J[i].Job);
            IF RetCode = ER_OK THEN
               CurObject.J[i].ResponseBG = CC_RED;
            ENDIF;     
         ENDIF;     
      ENDIF;
/*
** Check if move is on an operating order, then get specific to check the status
** and set the move color.
*/ 
      FOR m = FODMoves.LastRow() DOWNTO 1 DO
         IF CurObject.J[i].Job = FODMoves[m].Job THEN
            BT.AlertTime = '';
            REPEATED
            SELECT :BT.StartTime = B.StartTime,
                   :BT.AlertTime = B.AlertTime,
                   :BT.InitialAlert = B.InitialAlert
            FROM    TM_BogeyAlert B
            WHERE   B.Card = :CurObject.Card AND
                    B.Type = :TM$FODOrder AND
                    B.Object = :FODMoves[m].Job AND
                    B.Status = :FODMoves[m].JobStatus;
            IF BT.AlertTime <> '' AND
                  BT.AlertTime < TimeNow THEN
               BGColor = CC_RED; 
               FGColor = CC_BLACK;
            ELSEIF BT.AlertTime <> '' AND
                  BT.InitialAlert = FALSE THEN
               BGColor = CC_YELLOW;
               FGColor = CC_BLACK;
            ELSE
               IF FODMoves[m].JobStatus = Order$Acknowledged THEN
                  BGColor = CC_PALE_GREEN;
                  FGColor = CC_BLACK;
               ELSE
                  BGColor = 0;
                  FGColor = CC_PALE_GRAY;
               ENDIF;
            ENDIF;

            IF FODMoves[m].TORS = Job$TakeoutInt AND
                  CurObject.J[i].TOIssued IS NOT NULL AND 
                  CurObject.J[i].TOIssued <> '' AND
                  CurObject.J[i].TOComplete IS NULL THEN
               CurObject.J[i].TOIssuedFG = FGColor;
               CurObject.J[i].TOIssuedBG = BGColor;
               FODMoves.RemoveRow (RowNumber = m);
               CONTINUE;
            ENDIF;

            IF FODMoves[m].TORS = Job$TakeoutInt AND
                  CurObject.J[i].TOComplete IS NOT NULL AND 
                  CurObject.J[i].TOComplete <> '' THEN
               CurObject.J[i].TOCompleteFG = FGColor;
               CurObject.J[i].TOCompleteBG = BGColor;
               FODMoves.RemoveRow (RowNumber = m);
               CONTINUE;
            ENDIF;
            IF FODMoves[m].TORS = Job$RestoreInt AND
                  CurObject.J[i].RSIssued IS NOT NULL AND 
                  CurObject.J[i].RSIssued <> '' AND
                  CurObject.J[i].RSComplete IS NULL THEN
               CurObject.J[i].RSIssuedFG = FGColor;
               CurObject.J[i].RSIssuedBG = BGColor;
               FODMoves.RemoveRow (RowNumber = m);
               CONTINUE;
            ENDIF;
            IF FODMoves[m].TORS = Job$RestoreInt AND
                  CurObject.J[i].RSComplete IS NOT NULL AND 
                  CurObject.J[i].RSComplete <> '' THEN
               CurObject.J[i].RSCompleteFG = FGColor;
               CurObject.J[i].RSCompleteBG = BGColor;
               FODMoves.RemoveRow (RowNumber = m);
               CONTINUE;
            ENDIF;
         ENDIF;
      ENDFOR;
/*
** IF this move is an unacknowledged FOD Fault, then gray the TOIssued 
** timestamp.
*/
      FOR m = 1 TO FaultMoves.LastRow() DO
         IF CurObject.J[i].Job = FaultMoves[m].Job AND (
               CurObject.J[i].TOIssued <> '' AND 
               CurObject.J[i].TOIssued IS NOT NULL AND
               CurObject.J[i].TOComplete IS NULL) THEN
            CurObject.J[i].TOIssuedFG = CC_PALE_GRAY;
         ENDIF;
      ENDFOR;
/*
** If move is issued to Operating Order, get status of order and confirm
** existence of the order.
*/
      IF CurObject.J[i].TOOperator = Operator$OpOrder THEN      

         OpOrderStatus = -1;
         REPEATED
         SELECT :OpOrderStatus = O.OrderStatus,
                :OrderNumber = O.OrderNumber
         FROM    IR_OperatingOrder O,
                 IR_OpOrderJobs OJ
         WHERE   OJ.Job = :CurObject.J[i].Job AND
                 OJ.TORS = :Job$TakeoutInt AND
                 OJ.OrderNumber = O.OrderNumber AND
                 O.OrderStatus IN (:Order$Opened, :Order$Downloaded,
                            :Order$Acknowledged, :Order$Closed);
/*
**  Keep select separate in case task manager is not running.
*/
         IF OpOrderStatus = -1 THEN
/*
** check to make sure the move is not still outstanding.
** If it is, then we have an error condition.
*/
            SELECT :OpOrderStatus = O.OrderStatus
            FROM   IR_OperatingOrder O,
                   IR_OpOrderJobs OJ
            WHERE  OJ.Job = :CurObject.J[i].Job AND
                   OJ.TORS = :Job$TakeoutInt AND
                   OJ.OrderNumber = O.OrderNumber;
             
            IF OpOrderStatus = -1 AND 
               CurObject.J[i].TOComplete IS NULL THEN
               OpOrderDoesNotExist = TRUE;
               CurObject.J[i].TOIssuedFG = CC_RED;
            ENDIF;

         ELSE
            BT.AlertTime = '';
            REPEATED
            SELECT :BT.StartTime = B.StartTime,
                   :BT.AlertTime = B.AlertTime,
                   :BT.InitialAlert = B.InitialAlert
            FROM    TM_BogeyAlert B
            WHERE   B.Card = :CurObject.Card AND
                    B.Type = :Operator$OpOrder AND
                    B.Object = :OrderNumber AND
                    B.Status = :OpOrderStatus;
            IF BT.AlertTime <> '' AND
                  BT.AlertTime < TimeNow THEN
               BGColor = CC_RED; 
               FGColor = CC_BLACK;
            ELSEIF BT.AlertTime <> '' AND
                  BT.InitialAlert = FALSE THEN
               BGColor = CC_YELLOW;
               FGColor = CC_BLACK;
            ELSE
               IF OpOrderStatus = Order$Acknowledged THEN
                  BGColor = CC_PALE_GREEN;
                  FGColor = CC_BLACK;
               ELSE
                  BGColor = 0;
                  FGColor = CC_PALE_GRAY;
               ENDIF;
            ENDIF;

            IF CurObject.J[i].TOIssued IS NOT NULL AND 
               CurObject.J[i].TOIssued <> '' AND
               (CurObject.J[i].TOComplete IS NULL OR
		CurObject.J[i].TOComplete = '') THEN
               CurObject.J[i].TOIssuedFG = FGColor;
               CurObject.J[i].TOIssuedBG = BGColor;
            ENDIF;
/*
** Special handling for Restore side of Permit Order move.
*/
            IF CurObject.J[i].TOComplete = '' AND
               CurObject.J[i].RSIssued = '' AND
               (CurObject.J[i].RSComplete IS NOT NULL OR
		CurObject.J[i].RSComplete <> '') THEN
               CurObject.J[i].RSCompleteFG = FGColor;
               CurObject.J[i].RSCompleteBG = BGColor;
            ENDIF;

            IF CurObject.J[i].TOComplete IS NOT NULL AND 
               CurObject.J[i].TOComplete <> '' THEN
               CurObject.J[i].TOCompleteFG = FGColor;
               CurObject.J[i].TOCompleteBG = BGColor;
            ENDIF;
         ENDIF;
 
      ENDIF;
/*
** Look at the Restore side
*/
      IF CurObject.J[i].RSOperator = Operator$OpOrder THEN      

         OpOrderStatus = -1;
         REPEATED
         SELECT :OpOrderStatus = O.OrderStatus,
                :OrderNumber = O.OrderNumber
         FROM    IR_OperatingOrder O,
                 IR_OpOrderJobs OJ
         WHERE   OJ.Job = :CurObject.J[i].Job AND
                 OJ.TORS = :Job$RestoreInt AND
                 OJ.OrderNumber = O.OrderNumber AND
                 O.OrderStatus IN (:Order$Opened, :Order$Downloaded,
                            :Order$Acknowledged, :Order$Closed);

/*
**  Keep select separate in case task manager is not running.
*/
         IF OpOrderStatus = -1 THEN
/*
** check to make sure THE move is not still outstanding.
** If it is, then we have an error condition.
*/
            SELECT :OpOrderStatus = O.OrderStatus
            FROM    IR_OperatingOrder O,
                    IR_OpOrderJobs OJ
            WHERE   OJ.Job = :CurObject.J[i].Job AND
                    OJ.TORS = :Job$RestoreInt AND
                    OJ.OrderNumber = O.OrderNumber;

            IF OpOrderStatus = -1 AND
               CurObject.J[i].RSComplete IS NULL THEN
               OpOrderDoesNotExist = TRUE;
               CurObject.J[i].RSIssuedFG = CC_RED;
            ENDIF;

         ELSE
            BT.AlertTime = '';
            REPEATED
            SELECT :BT.StartTime = B.StartTime,
                   :BT.AlertTime = B.AlertTime,
                   :BT.InitialAlert = B.InitialAlert
            FROM    TM_BogeyAlert B
            WHERE   B.Card = :CurObject.Card AND
                    B.Type = :Operator$OpOrder AND
                    B.Object = :OrderNumber AND
                    B.Status = :OpOrderStatus;
            IF BT.AlertTime <> '' AND
                  BT.AlertTime < TimeNow THEN
               BGColor = CC_RED; 
               FGColor = CC_BLACK;
            ELSEIF BT.AlertTime <> '' AND
                  BT.InitialAlert = FALSE THEN
               BGColor = CC_YELLOW;
               FGColor = CC_BLACK;
            ELSE
               IF OpOrderStatus = Order$Acknowledged THEN
                  BGColor = CC_PALE_GREEN;
                  FGColor = CC_BLACK;
               ELSE
                  BGColor = 0;
                  FGColor = CC_PALE_GRAY;
               ENDIF;
            ENDIF;

            IF CurObject.J[i].RSIssued IS NOT NULL AND 
               CurObject.J[i].RSIssued <> '' AND
               CurObject.J[i].RSComplete IS NULL THEN
               CurObject.J[i].RSIssuedFG = FGColor;
               CurObject.J[i].RSIssuedBG = BGColor;
            ENDIF;

            IF CurObject.J[i].RSComplete IS NOT NULL AND 
               CurObject.J[i].RSComplete <> '' THEN
               CurObject.J[i].RSCompleteFG = FGColor;
               CurObject.J[i].RSCompleteBG = BGColor;
            ENDIF;
         ENDIF;
      ENDIF;

      IF CurObject.J[i].TOIssued = '' THEN
         CurObject.J[i].TOIssuedBG = CC_PALE_GRAY;
      ENDIF;

      IF CurObject.J[i].TOComplete = '' THEN
         CurObject.J[i].TOCompleteBG = CC_PALE_GRAY;
      ENDIF;

      IF CurObject.J[i].RSIssued = '' THEN
         CurObject.J[i].RSIssuedBG = CC_PALE_GRAY;
      ENDIF;

      IF CurObject.J[i].RSComplete = '' THEN
         CurObject.J[i].RSCompleteBG = CC_PALE_GRAY;
      ENDIF;

      IF CurObject.J[i].ActivityIdentifier = 'N' THEN
         CurObject.J[i].TOIssuedBG = CC_PALE_GRAY;
         CurObject.J[i].TOCompleteBG = CC_PALE_GRAY;
         CurObject.J[i].RSIssuedBG = CC_PALE_GRAY;
         CurObject.J[i].RSCompleteBG = CC_PALE_GRAY;
      ENDIF;
/*
** Check Permit Status permits issued to FCR in Preparation for Dimming 
** and background move coloring.
*/          
      IF CurObject.J[i].TOIssued IS NOT NULL AND 
            CurObject.J[i].TOOperator = Operator$FCR THEN

         PermitStatus = -1;
         SELECT :PermitStatus = PermitStatus
         FROM   IR_WorkPermit
         WHERE  WorkPermit = :CurObject.J[i].Job;
/*
**  Keep select separate in case task manager is not running.
*/
         IF PermitStatus <> -1 THEN
            BT.AlertTime = '';
            REPEATED
            SELECT :BT.StartTime = B.StartTime,
                   :BT.AlertTime = B.AlertTime,
                   :BT.InitialAlert = B.InitialAlert
            FROM    TM_BogeyAlert B
            WHERE   B.Card = :CurObject.Card AND
                    B.Type = :Operator$FCR AND
                    B.Object = :CurObject.J[i].Job AND
                    B.Status = :PermitStatus;
            IF BT.AlertTime <> '' AND
                  BT.AlertTime < TimeNow THEN
               BGColor = CC_RED; 
               FGColor = CC_BLACK;
            ELSEIF BT.AlertTime <> '' AND
                  BT.InitialAlert = FALSE THEN
               BGColor = CC_YELLOW;
               FGColor = CC_BLACK;
            ELSE
               IF PermitStatus = Permit$Acknowledged THEN
                  BGColor = CC_PALE_GREEN;
                  FGColor = CC_BLACK;
               ELSEIF PermitStatus = Permit$Initialized AND
                      CurObject.J[i].RSComplete IS NULL THEN
                  BGColor = CC_PALE_RED;
                  FGColor = CC_BLACK;
               ELSE
                  BGColor = 0;
                  FGColor = CC_PALE_GRAY;
               ENDIF;
            ENDIF;
         ENDIF;
/*
** If permit is initialized and not yet returned, set the move background
** color to indicate the DO has changes that have not yet been sent to
** the FCR.
** Else look at the permit status to determine if toissue or rscomplete
** should be dimmed.
*/
         IF CurObject.J[i].RSComplete IS NULL AND
            CurObject.J[i].TOIssued IS NOT NULL AND
            CurObject.J[i].TOIssued <> '' AND
           (PermitStatus = Permit$Issued OR 
            PermitStatus = Permit$Acknowledged OR
            PermitStatus = Permit$Rejected OR
            PermitStatus = Permit$Downloaded OR
            PermitStatus = Permit$Initialized) THEN
      
            CurObject.J[i].TOIssuedBG = BGColor;
            CurObject.J[i].TOIssuedFG = FGColor;

         ELSEIF PermitStatus = Permit$Returned THEN
            CurObject.J[i].RSCompleteFG = FGColor;
            CurObject.J[i].RSCompleteBG = BGColor;
         ENDIF;
      ENDIF;   
/*
** Look if this move is included on the outstanding PA Moves List and
** set color of issue field if necessary to indicate Process Automation setup
** Since both TakeOut and Restore for same move may be involved, we need to
** continue through entire PAMoves array and not endloop.
*/
      FOR m = 1 TO PAMoves.LastRow() DO
         IF CurObject.J[i].Job = PAMoves[m].Job THEN
            IF PAMoves[m].TORS = Job$TakeoutInt THEN
               CurObject.J[i].TOIssuedBG = CC_LIGHT_BROWN;
            ELSE
               CurObject.J[i].RSIssuedBG = CC_LIGHT_BROWN;
            ENDIF;
         ENDIF;
      ENDFOR;

      i = i + 1;
   ENDWHILE;
/*
** If a move was issued to the Operating Order, and the order no longer
** exists, then we need to present a Warning.
*/
   IF OpOrderDoesNotExist = TRUE THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Display warning popup for FMS Update users.';
   ENDIF;
    
   RETURN;
END;

METHOD LoadIncompleteJobs (
)=
DECLARE
    i = INTEGER NOT NULL;           /* Temporary counter */
    k = INTEGER NOT NULL;           /* Temporary counter */
    AL = ARRAY OF CardLog;         
    BeginTime = DATE NOT NULL;
    EndTime = DATE NOT NULL;
    Feeder = INTEGER NOT NULL;
    JL = ARRAY OF IncompleteJob;
    OrderNumber = INTEGER NOT NULL WITH DEFAULT; 
    Remark1 = VARCHAR(200) NOT NULL WITH DEFAULT; 
    Remark2 = VARCHAR(200) NOT NULL WITH DEFAULT; 
    Remark3 = VARCHAR(200) NOT NULL WITH DEFAULT; 
    Remark4 = VARCHAR(200) NOT NULL WITH DEFAULT; 
    Status = INTEGER NOT NULL WITH DEFAULT; 
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Load transaction log data.
*/
   IF CurObject.Application = Application$SLC THEN
      SwitchingItem = CurObject.SLCItems[1].Value;
   ELSE
      SwitchingItem = 0;
   ENDIF;

   AL.Clear();
   i = 1;

   IF CurObject.ArchiveCard = FALSE THEN
      Feeder = 0;
      SELECT :Feeder = Feeder
      FROM   FMS_Card 
      WHERE  Card = :CurObject.Card;

      REPEATED
      SELECT  :AL[i].Job = J.Job,
              :AL[i].Time = L.Time,
              :AL[i].PrintID = '',
              :AL[i].Equip = J.Equip,
              :AL[i].EquipName = J.EquipName,
              :AL[i].EquipClassName = J.EquipClassName,
              :AL[i].TOMove = J.TOMove,
              :AL[i].RSMove = J.RSMove,
              :AL[i].UserName = L.UserName,
              :AL[i].Item = L.Item,
              :AL[i].Old = L.Old,
              :AL[i].New = L.New,
              :AL[i].Operator = L.Operator,
              :AL[i].OperatorName = L.OperatorName
      FROM    SOA_Log L,
              SOA_Job J
      WHERE   L.Card = :CurObject.Card AND
              L.SwitchingItem = :SwitchingItem AND
              L.Item IN ('TOIssued', 'RSIssued', 'TOOperator', 'RSOperator') AND
              L.Old <> '' AND
              L.New = '' AND
              L.Job = J.Job
      UNION
      SELECT  J.Job,
              L.Time,
              '',
              J.Equip,
              J.EquipName,
              J.EquipClassName,
              J.TOMove,
              J.RSMove,
              L.UserName,
              L.Item,
              L.Old,
              L.New,
              L.Operator,
              L.OperatorName
      FROM    SOA_Log L,
              FMS_ArchiveJob J
      WHERE   L.Card = :CurObject.Card AND
              L.Item IN ('TOIssued', 'RSIssued', 'TOOperator', 'RSOperator') AND
              L.Old <> '' AND
              L.New = '' AND
              L.Card = J.Card AND
              L.Job = J.Job
      ORDER BY Job, Time 
      BEGIN
         IF Feeder <> 0 AND AL[i].Equip <> 0 THEN
            SELECT :AL[i].PrintID = Reference
            FROM   Udb_Grouping
            WHERE  Grouping = :Feeder AND
                   Relationship = :Interaction$MemberOf AND
                   Member = :AL[i].Equip;
         ENDIF;
         i = i + 1;
      END;

      /*
      ** get returned Incomplete work permits 
      ** Commented out 9/26/06 after on-site review
      IF CurObject.Application = Application$FMS THEN
         SELECT :AL[i].Job = J.Job,
                :AL[i].TOMove = J.TOMove,
                :AL[i].TOOperator = J.TOOperator,
                :AL[i].Old = VARCHAR(J.TOIssued),
                :AL[i].Time = J.RSComplete,
                :AL[i].Item = 'FCR_PERMIT'
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CurObject.Card AND
                JC.SwitchingItem = :SwitchingItem AND
                JC.StepPair = :StepHeading$OTW AND
                JC.Job = J.Job AND
                J.Status IN ('', :Job$OPC) AND
                J.JobClass <> 0 AND
                J.Response = 'Incomplete'
         BEGIN
            i = i + 1;
         END;
      ELSE
         SELECT :AL[i].Job = J.Job,
                :AL[i].EquipName = J.EquipName,
                :AL[i].EquipClassName = J.EquipClassName,
                :AL[i].TOMove = J.TOMove,
                :AL[i].TOOperator = J.TOOperator,
                :AL[i].Old = VARCHAR(J.TOIssued),
                :AL[i].Time = J.RSComplete,
                :AL[i].Item = 'SOA_PERMIT'
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CurObject.Card AND
                JC.SwitchingItem = :SwitchingItem AND
                JC.StepPair IN (:StepHeading$TestPermit, :StepHeading$WorkPermit) AND
                JC.Job = J.Job AND
                J.Status IN ('', :JobStatus$NIS, :JobStatus$Table) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.Response = 'Incomplete'
         BEGIN
            i = i + 1;
         END;
      ENDIF;  
      */
   ELSE /* archived card or switcingitem */
      IF CurObject.Application = Application$FMS THEN
         REPEATED
         SELECT  :AL[i].Job = L.Job,
                 :AL[i].Time = L.Time,
                 :AL[i].PrintID = J.PrintID,
                 :AL[i].Equip = J.Equip,
                 :AL[i].EquipName = J.EquipName,
                 :AL[i].EquipClassName = J.EquipClassName,
                 :AL[i].TOMove = J.TOMove,
                 :AL[i].RSMove = J.RSMove,
                 :AL[i].UserName = L.UserName,
                 :AL[i].Item = L.Item,
                 :AL[i].Old = L.Old,
                 :AL[i].New = L.New,
                 :AL[i].Operator = L.Operator,
                 :AL[i].OperatorName = L.OperatorName
         FROM    FMS_ArchiveLog L,
                 FMS_ArchiveJob J
         WHERE   L.Card = :CurObject.Card AND
                 J.Card = L.Card AND
                 J.Job = L.Job
         UNION
         SELECT  L.Job,
                 L.Time,
                 '',
                 J.Equip,
                 J.EquipName,
                 J.EquipClassName,
                 J.TOMove,
                 J.RSMove,
                 L.UserName,
                 L.Item,
                 L.Old,
                 L.New,
                 L.Operator,
                 L.OperatorName
         FROM    FMS_ArchiveLog L,
                 SOA_Job J
         WHERE   L.Card = :CurObject.Card AND
                 L.Item IN ('TOIssued', 'RSIssued', 'TOOperator', 'RSOperator') AND
                 L.Old <> '' AND
                 L.New = '' AND
                 J.Job = L.Job
         ORDER BY Job, Time
         BEGIN
            i = i + 1;
         END;
 
         /*
         ** get incomplete FCR work permits 
         ** Commented out 9/26/06 after on-site review
         SELECT :AL[i].Job = J.Job,
                :AL[i].TOMove = J.TOMove,
                :AL[i].TOOperator = J.TOOperator,
                :AL[i].Old = VARCHAR(J.TOIssued),
                :AL[i].Time = J.RSComplete,
                :AL[i].Item = 'FCR_PERMIT'
         FROM   FMS_ArchiveJob J
         WHERE  J.Card = :CurObject.Card AND
                J.StepPair = :StepHeading$OTW AND
                J.Status IN ('', :Job$OPC) AND
                J.JobClass <> 0 AND
                J.Response = 'Incomplete'
         BEGIN
            i = i + 1;
         END;
         */
      ELSE  
         REPEATED
         SELECT  :AL[i].Job = L.Job,
                 :AL[i].Time = L.Time,
                 :AL[i].PrintID = J.PrintID,
                 :AL[i].Equip = J.Equip,
                 :AL[i].EquipName = J.EquipName,
                 :AL[i].EquipClassName = J.EquipClassName,
                 :AL[i].TOMove = J.TOMove,
                 :AL[i].RSMove = J.RSMove,
                 :AL[i].UserName = L.UserName,
                 :AL[i].Item = L.Item,
                 :AL[i].Old = L.Old,
                 :AL[i].New = L.New,
                 :AL[i].Operator = L.Operator,
                 :AL[i].OperatorName = L.OperatorName
         FROM    SOA_ArchiveLog L,
                 SOA_ArchiveJob J
         WHERE   L.Card = :CurObject.Card AND
                 L.SwitchingItem = :SwitchingItem AND
                 L.Item IN ('TOIssued', 'RSIssued', 'TOOperator', 'RSOperator') AND
                 L.Old <> '' AND
                 L.New = '' AND
                 J.Job = L.Job
         UNION
         SELECT  L.Job,
                 L.Time,
                 '',
                 J.Equip,
                 J.EquipName,
                 J.EquipClassName,
                 J.TOMove,
                 J.RSMove,
                 L.UserName,
                 L.Item,
                 L.Old,
                 L.New,
                 L.Operator,
                 L.OperatorName
         FROM    SOA_ArchiveLog L,
                 SOA_Job J
         WHERE   L.Card = :CurObject.Card AND
                 L.SwitchingItem = :SwitchingItem AND
                 L.Item IN ('TOIssued', 'RSIssued', 'TOOperator', 'RSOperator') AND
                 L.Old <> '' AND
                 L.New = '' AND
                 J.Job = L.Job
         ORDER BY Job, Time DESC
         BEGIN
            i = i + 1;
         END;

         /*
         ** get incomplete soa work permits 
         ** Commented out 9/26/06 after on-site review
         SELECT :AL[i].Job = J.Job,
                :AL[i].TOMove = J.TOMove,
                :AL[i].EquipName = J.EquipName,
                :AL[i].EquipClassName = J.EquipClassName,
                :AL[i].TOOperator = J.TOOperator,
                :AL[i].Old = VARCHAR(J.TOIssued),
                :AL[i].Time = J.RSComplete,
                :AL[i].Item = 'SOA_PERMIT'
         FROM   SOA_ArchiveJob J
         WHERE  J.Card = :CurObject.Card AND
                J.SwitchingItem = :SwitchingItem AND
                J.StepPair IN (:StepHeading$TestPermit, :StepHeading$WorkPermit) AND
                J.Status = '' AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.Response = 'Incomplete'
         BEGIN
            i = i + 1;
         END;
         */
      ENDIF;  
   ENDIF;

/*
** Analyze the transaction log data and build a list of incomplete jobs summary
*/
   CurObject.IJ.Clear();
   k = 0;

   i = 1;
   WHILE i <= AL.LastRow() DO
      IF AL[i].Item = 'TOIssued' OR AL[i].Item = 'RSIssued' THEN
         k = k + 1;
         CurObject.IJ[k].Job = AL[i].Job;
         CurObject.IJ[k].PrintID = AL[i].PrintID;
         CurObject.IJ[k].EquipName = AL[i].EquipName;
         CurObject.IJ[k].EquipClassName = AL[i].EquipClassName;

         IF AL[i].Item = 'TOIssued' THEN            
            CurObject.IJ[k].TORS = 0;
            CurObject.IJ[k].MoveText = AL[i].TOMove;
         ELSEIF AL[i].Item = 'RSIssued' THEN            
            CurObject.IJ[k].TORS = 1;
            CurObject.IJ[k].MoveText = AL[i].RSMove;
         ENDIF;

         CurObject.IJ[k].IssuedTime = DATE(AL[i].Old);
         CurObject.IJ[k].IncompleteTime = AL[i].Time;

         /* order information
         */
         OrderNumber = 0;
         Status = 0;
         Remark1 = '';
         Remark2 = '';
         Remark3 = '';
         Remark4 = '';
         BeginTime = CurObject.IJ[k].IssuedTime;
         EndTime = CurObject.IJ[k].IncompleteTime;

         /* is it an operating orders ? */
         SELECT :OrderNumber = OJ.OrderNumber,
                :Remark1 = OO.AckRejectComment, 
                :Remark2 = OO.RescindComment,
                :Remark3 = OO.ReturnComment,
                :Remark4 = OJ.ReturnRemark,
                :Status = OO.OrderStatus
         FROM   IR_OpOrderJobs OJ,
                IR_OperatingOrder OO
         WHERE  OJ.Job = :CurObject.IJ[k].Job AND
                OJ.TORS = :CurObject.IJ[k].TORS AND
                OJ.OrderNumber = OO.OrderNumber AND
                OO.IssueTime BETWEEN VARCHAR(:BeginTime) AND VARCHAR(:EndTime); 

         IF OrderNumber <> 0 THEN
            IF Status = Order$Rejected OR Status = Order$ConfirmRejected THEN
               CurObject.IJ[k].Remark = 'Rejected SSO Order ' + VARCHAR(OrderNumber) + ': ' + Remark1;
            ELSEIF Status = Order$Rescinded OR Status = Order$ConfirmRescinded THEN
               CurObject.IJ[k].Remark = 'Rescinded SSO Order ' + VARCHAR(OrderNumber) + ': ' + Remark2; 
            ELSE
               CurObject.IJ[k].Remark = 'SSO Order ' + VARCHAR(OrderNumber) + ': ' + Remark3;
               IF Remark4 <> '' THEN
                  CurObject.IJ[k].Remark = CurObject.IJ[k].Remark + ';' + Remark4;
               ENDIF;        
            ENDIF;
         ELSEIF CurObject.Application = Application$FMS THEN
            /* is it an FOD orders ? */
            SELECT :OrderNumber = OJ.OrderNumber,
                   :Remark1 = OJ.AckRejectedComment, 
                   :Remark2 = OJ.RescindComment,
                   :Remark3 = OJ.ReturnRemark,
                   :Status = OJ.JobStatus
            FROM   IR_FODOrderJobs OJ,
                   IR_FODOrder FO
            WHERE  OJ.Job = :CurObject.IJ[k].Job AND
                   OJ.TORS = :CurObject.IJ[k].TORS AND
                   OJ.OrderNumber = FO.OrderNumber AND
                   FO.IssueTime BETWEEN VARCHAR(:BeginTime) AND VARCHAR(:EndTime); 
            IF OrderNumber <> 0 THEN
               IF Status = Order$Rejected OR Status = Order$ConfirmRejected THEN
                  CurObject.IJ[k].Remark = 'Rejected FOD Order ' + VARCHAR(OrderNumber) + ': ' + Remark1;
               ELSEIF Status = Order$Rescinded OR Status = Order$ConfirmRescinded THEN
                  CurObject.IJ[k].Remark = 'Rescinded FOD Order ' + VARCHAR(OrderNumber) + ': ' + Remark2; 
               ELSE
                  CurObject.IJ[k].Remark = 'FOD Order ' + VARCHAR(OrderNumber)+': ' + Remark3;
               ENDIF;
            ELSE
               /* is it a FCR work permit ? */
               BeginTime = CurObject.IJ[k].IncompleteTime - '10 seconds';
               EndTime = CurObject.IJ[k].IncompleteTime + '20 seconds';

               IF CurObject.ArchiveCard = FALSE THEN
                  SELECT :OrderNumber = Job,
                         :Remark1 = Old,
                         :Remark2 = New
                  FROM   SOA_Log
                  WHERE  Job = :CurObject.IJ[k].Job AND
                         Item = 'Rejected' AND
                         Time BETWEEN VARCHAR(:BeginTime) AND VARCHAR(:EndTime); 
               ELSE
                  SELECT :OrderNumber = Job,
                         :Remark1 = Old,
                         :Remark2 = New
                  FROM   SOA_ArchiveLog
                  WHERE  Job = :CurObject.IJ[k].Job AND
                         Item = 'Rejected' AND
                         Time BETWEEN VARCHAR(:BeginTime) AND VARCHAR(:EndTime);
               ENDIF;
               IF OrderNumber <> 0 THEN
                  CurObject.IJ[k].Remark = 'Rejected ' + Remark1 + ': ' + Remark2;
               ENDIF;
            ENDIF;
         ENDIF; 

      /*
      ** Commented out 9/26/06 after on-site review
      ELSEIF AL[i].Item = 'FCR_PERMIT' THEN
         k = k + 1;
         CurObject.IJ[k].Job = AL[i].Job;
         CurObject.IJ[k].TORS = 0;
         CurObject.IJ[k].MoveText = AL[i].TOMove;
         CurObject.IJ[k].IssuedTime = DATE(AL[i].Old);
         CurObject.IJ[k].IncompleteTime = AL[i].Time;

         SELECT :CurObject.IJ[k].OperatorName = Description
         FROM   UDB_Object
         WHERE  Object = :AL[i].TOOperator;

         /* 
         ** return comment
         SELECT :CurObject.IJ[k].Remark = 'Return Comment: ' + Comment
         FROM   IR_WorkPermit
         WHERE  WorkPermit = :CurObject.IJ[k].Job;

      ELSEIF AL[i].Item = 'SOA_PERMIT' THEN
         k = k + 1;
         CurObject.IJ[k].Job = AL[i].Job;
         CurObject.IJ[k].TORS = 0;
         CurObject.IJ[k].EquipName = AL[i].EquipName;
         CurObject.IJ[k].EquipClassName = AL[i].EquipClassName;
         CurObject.IJ[k].MoveText = AL[i].TOMove;
         CurObject.IJ[k].IssuedTime = DATE(AL[i].Old);
         CurObject.IJ[k].IncompleteTime = AL[i].Time;

         SELECT :CurObject.IJ[k].OperatorName = Description
         FROM   UDB_Object
         WHERE  Object = :AL[i].TOOperator;

         /* 
         ** return comment
         BeginTime = CurObject.IJ[k].IssuedTime;
         EndTime = CurObject.IJ[k].IncompleteTime;

         SELECT :CurObject.IJ[k].Remark = 'Return Comment: ' + OO.ReturnComment
         FROM   IR_OpOrderJobs OJ,
                IR_OperatingOrder OO
         WHERE  OJ.Job = :CurObject.IJ[k].Job AND
                OJ.TORS = :CurObject.IJ[k].TORS AND
                OJ.OrderNumber = OO.OrderNumber AND
                OO.IssueTime BETWEEN VARCHAR(:BeginTime) AND VARCHAR(:EndTime); 
      */
      ELSE
         /* The log entry of resetting the TOOperator OR RSOperator value 
         ** is inserted either right before or right after the log entry of 
         ** resetting the timestamp. If it is before, we are going to insert  
         ** a copy right after TOIssued/RSIssued log entry so that it's operator name
         ** will be assigned to the incomplete job in the next looping.
         */
         IF i = 1 THEN
            AL.InsertRow(RowNumber=3, RowObject = AL[i].Duplicate());
         ELSEIF AL[i].Job <> AL[i-1].Job THEN
            AL.InsertRow(RowNumber=(i+2), RowObject = AL[i].Duplicate());
         ELSEIF CurObject.IJ[k].Job =  AL[i].Job THEN
            CurObject.IJ[k].OperatorName = AL[i].Old;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD LoadISPConditions (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.J.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.J[i].JobClass = J.JobClass,
          :CurObject.J[i].TOMove = J.TOMove
   FROM   FMS_JobClass J, 
          FMS_JobClassControl JCC
   WHERE  J.JobClass = JCC.JobClass
    AND   JCC.TypeofCard = :Type$SLCCard 
    AND   JCC.StepPair = :StepHeading$ISPConditions
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD LoadJobRules (
)=
DECLARE
   i = INTEGER NOT NULL;
   JobClass = INTEGER NOT NULL WITH DEFAULT;
   MoveEquipClass = INTEGER NOT NULL WITH DEFAULT;
   StepPair = INTEGER NOT NULL WITH DEFAULT;
   TypeofCard = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.ArchiveCard = TRUE AND CurObject.Application <> Application$SDS THEN
      IF CurObject.Application = Application$FMS THEN
         REPEATED
         SELECT  :JobClass = J.JobClass,
                 :MoveEquipClass = J.MoveEquipClass,
                 :StepPair = J.StepPair,
                 :TypeofCard = C.TypeofCard
         FROM     FMS_ArchiveJob J,
                  FMS_ArchiveCard C
         WHERE    C.Card = :CurObject.Card AND
                  C.Card = J.Card AND
                  J.Job = :CurObject.JD.Job;
                  
      ELSEIF CurObject.Application = Application$TFMS THEN
         REPEATED
         SELECT  :JobClass = J.JobClass,
                 :MoveEquipClass = J.EquipClass,
                 :StepPair = J.StepPair,
                 :TypeofCard = C.TypeofCard
         FROM     SOA_ArchiveJob J,
                  TFMS_ArchiveCard C
         WHERE    C.Card = :CurObject.Card AND
                  C.Card = J.Card AND
                  J.Job = :CurObject.JD.Job;
      ELSE
         REPEATED
         SELECT  :JobClass = J.JobClass,
                 :MoveEquipClass = J.EquipClass,
                 :StepPair = J.StepPair,
                 :TypeofCard = C.TypeofCard
         FROM     SOA_ArchiveJob J,
                  SOA_Card C
         WHERE    C.Card = :CurObject.Card AND
                  C.Card = J.Card AND
                  J.Job = :CurObject.JD.Job;
      
      ENDIF;
      CALLPROC DDB_ROLLBACK; 
   ELSE
      REPEATED
      SELECT  :JobClass = J.JobClass,
              :MoveEquipClass = JC.MoveEquipClass,
              :StepPair = JC.StepPair,
              :TypeofCard = C.TypeofCard
      FROM     SOA_Job J,
               SOA_JobControl JC,
               SOA_Card C
      WHERE    JC.Card = :CurObject.Card AND
               JC.Job = :CurObject.JD.Job AND
               JC.Card = C.Card AND
               JC.Job = J.Job;
      CALLPROC DDB_ROLLBACK; 
   ENDIF;
   
   CurObject.Rules.Clear();
   i = 1; 
   REPEATED
   SELECT :CurObject.Rules[i].RuleType = 0,     /* get checks first */
          :CurObject.Rules[i].ToRs = JC.ToRs,
          :CurObject.Rules[i].IssueCompl = JC.IssueCompl,
          :CurObject.Rules[i].ActionCheck = JC.JobCheck,
          :CurObject.Rules[i].ActionCheckName = T1.Name,
          :CurObject.Rules[i].FeederEquip = JC.FeederEquip,
          :CurObject.Rules[i].Status = JC.Status,
          :CurObject.Rules[i].StatusName = T2.Name
   FROM   FMS_JobCheck JC,
          Udb_Type T1,
          Udb_Type T2
   WHERE  JC.JobClass = :JobClass
   AND    JC.EquipClass = :MoveEquipClass
   AND    JC.StepPair = :StepPair
   AND    JC.TypeofCard = :TypeofCard
   AND    JC.JobCheck = T1.Type 
   AND    JC.Status = T2.Type
   UNION  
   SELECT 1,     /* get actions      */
          JA.ToRs,
          JA.IssueCompl, 
          JA.Action,
          T1.Name,  
          JA.FeederEquip,
          JA.Status,
          T2.Name
   FROM   FMS_JobAction JA,
          Udb_Type T1,
          Udb_Type T2 
   WHERE  JA.JobClass = :JobClass  
   AND    JA.EquipClass = :MoveEquipClass
   AND    JA.StepPair = :StepPair
   AND    JA.TypeofCard = :TypeofCard  
   AND    JA.Action = T1.Type 
   AND    JA.Status = T2.Type
   ORDER BY ToRs,IssueCompl,ActionCheck 
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK; 

   i = 1;
   WHILE i <= CurObject.Rules.LastRow() DO

      IF (CurObject.Rules[i].RuleType = 0) THEN
          CurObject.Rules[i].RuleTypeName = 'Check';
      ELSE
          CurObject.Rules[i].RuleTypeName = 'Action';
      ENDIF;

      IF (CurObject.Rules[i].ToRs = 0) THEN
          CurObject.Rules[i].ToRsName = 'TakeOut';
      ELSE
          CurObject.Rules[i].ToRsName = 'Restore';
      ENDIF;

      IF (CurObject.Rules[i].IssueCompl = 0) THEN
          CurObject.Rules[i].IssueComplName = 'Issue';
      ELSE
          CurObject.Rules[i].IssueComplName = 'Completion';
      ENDIF;

      IF (CurObject.Rules[i].FeederEquip = 1) THEN
          CurObject.Rules[i].FeederEquipName = 'Feeder';
      ELSEIF (CurObject.Rules[i].FeederEquip = 2) THEN
          CurObject.Rules[i].FeederEquipName = 'Equip';
      ELSEIF (CurObject.Rules[i].FeederEquip = 3) THEN
          CurObject.Rules[i].FeederEquipName = 'FMS OpStep';
      ELSEIF (CurObject.Rules[i].FeederEquip = 4) THEN
          CurObject.Rules[i].FeederEquipName = 'Common';
      ELSEIF (CurObject.Rules[i].FeederEquip = 7) THEN
          CurObject.Rules[i].FeederEquipName = 'All Lines';
      ELSEIF (CurObject.Rules[i].FeederEquip = 8) THEN
          CurObject.Rules[i].FeederEquipName = 'Substation';
      ELSEIF (CurObject.Rules[i].FeederEquip = 9) THEN
          CurObject.Rules[i].FeederEquipName = 'TFMS OpStep';
      ELSEIF (CurObject.Rules[i].FeederEquip = 10) THEN
          CurObject.Rules[i].FeederEquipName = 'Connected Lines';
      ELSEIF (CurObject.Rules[i].FeederEquip = 11) THEN
          CurObject.Rules[i].FeederEquipName = 'Current Line';
      ELSEIF (CurObject.Rules[i].FeederEquip = 12) THEN
          CurObject.Rules[i].FeederEquipName = 'Network Restriction';
      ELSE
          CurObject.Rules[i].FeederEquipName = '';
          SELECT :CurObject.Rules[i].FeederEquipName = Name
          FROM   Udb_Type
          WHERE  Type = :CurObject.Rules[i].FeederEquip;
      ENDIF;

      i = i + 1;
   ENDWHILE;
END;

