	Name:            ModifyCircuitDetails

/*
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Unified Information. 
** 
**  Application:    Telephone Card 
**  Frame:          ModifyCircuit 
** 
**  ModIFication log: 
** 
**  Date:   Version     Description 
** -------------------------------------------------- 
**  10/02/93    HLF     Select circuit for creating new card 
**  10/03/93    HLF     Move array select to TelCard (starting frame)
**  03/29/94    HLF     Update due to customer response
**  10/24/94    hlf     Revamp of telephone card    
**  10/24/94    em      Revamp revamp    
**  10/27/94    em      more of the same   
***************
**  08/25/95    hlf     Rewrite
**  12/12/95    em      changed existing card message
**  01/31/96    em      allow TEST role to access all circuits 
**  07/17/97    jfl     tls20: TC Equipment subtypes are not circuit types
**  01/16/04    em      Use Type$Line instead of ACLineSeg
**  09/24/04    em      Pass back card if New Card circuit is already on a card.
**  10/06/08    pkw     Added Exit_Frame userevent to be called from CircuitDetails screen.
**  01/19/10    ysp     TLS 50: Support multiple routes for a circuit
**  02/11/10    pkw     TLS 50: Show circuits with multiple routes in separate rows
**                      since it is called from RelayProtectionMatrix when using
**                      the Replace Circuit function.
**  03/17/10    pkw     Combined SelectCircuit and CircuitDetails into one frame.
**  04/26/10    em      Bring LineTypeList to Front
**  12/13/10    pkw     Popup message if circuit is checked out so user can use RPM to remove
**  12/06/12    ysp     TLS 58: A grouper can be a member of another grouper 
**  11/11/17    em      Add Description field to display; Extend circuit search to object comment 
**  09/04/18    em      Add AltLine attributes
**  09/10/18    em      Pending Disconnect remove check for RPM matrix
**  10/03/18    em      Add CardCircuit parm to drive circuit load on display
**  05/02/19    em      Add RTUCircuit Type attribute
**  07/18/19    em      Screen text change; Investigating why screen is locking itslef in read-only mode
**  10/09/19    ysp     Manually hightlight the selected row in Ckts table to fix the screen issue
**                      after cancellation of a row change.
**  02/01/24    em      Deactivate Relay Protection Matrix by removing checks that prevent actions based
**                      on matrix existence.
*/ 
INITIALIZE (
    NewCard = integer NOT NULL WITH DEFAULT;            /* passed in boolean */
    ReplaceCircuit = integer NOT NULL WITH DEFAULT;           /* passed in parm */    
    CardCircuit = integer NOT NULL WITH DEFAULT;           /* passed in parm */    

    CurrentCircuit = CardClass;         
    i = integer NOT NULL WITH DEFAULT; 
    j = integer NOT NULL WITH DEFAULT;
    k = integer not null not default;
    found = integer NOT NULL WITH DEFAULT;
    SelectedRow = integer NOT NULL WITH DEFAULT;  

    status = integer not null not default;              /* card status */
    linetype = integer;                                 /* linetype type */
    linename = varchar(40);                             /* linetype name */

    CircuitPass = CardClass;                            /* dummy circuit info */
    GroupingInfo = ARRAY of ObjectClass;                /* grouping info for circuit */
    SubTypeofSub = INTEGER NOT NULL;                    /* subtype of substation flag */
    CktSearch = ARRAY of CardClass;

    TempName = varchar(40) not null not default;

    vLineType = integer;
    vLineNumber = varchar(15) not null not default;     /* variables for */
    vFeederName = varchar(40) not null not default;     /*    filters    */
    vSubstationName = varchar(40) not null not default;

    Chosen = integer not null not default;
    HighRef = integer not null not default;
    NewRow = integer not null not default;
    RetCode = integer not null not default;
      
    LoadList = ARRAY of TypeClass;
    RouteTypeList = ARRAY of TypeClass;   /* Type lists */
    FuncAreaList = ARRAY of TypeClass;

    FdrList = ARRAY of ObjectClass;     /* Object lists */
    StnList = ARRAY of ObjectClass;
    CompanyList = ARRAY of ObjectClass;
    GrouperList = ARRAY of ObjectClass;

    CurStnList = ARRAY of ObjectClass;  /* Current grouping information */
    CurFdrList = ARRAY of ObjectClass;
    CktTypeList = ARRAY of ObjectClass; 
    CurAssocList = ARRAY of ObjectClass; 
    CurCarrier = ObjectClass;
    CurGrouper = ObjectClass;
    CurVerizonName = VARCHAR(40) NOT NULL WITH DEFAULT;
    
    SearchList = ARRAY of ObjectClass;
    ReducedList = ARRAY of ObjectClass;
    RouteName = VARCHAR(40) NOT NULL NOT DEFAULT;
    SearchName = VARCHAR(40) NOT NULL NOT DEFAULT;

    CalledFrom = VARCHAR(100) NOT NULL NOT DEFAULT;
    cl = ChoiceList;
    LoadCircuit = CardClass;
    TempChar = VARCHAR(40) NOT NULL WITH DEFAULT;
    PreFixName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SvcCodeName = VARCHAR(20) NOT NULL WITH DEFAULT;
    PreSerialName = VARCHAR(20) NOT NULL WITH DEFAULT;
    PostSerialName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SegmentName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SvcCodeLength = INTEGER NOT NULL WITH DEFAULT;
    DashCount = INTEGER NOT NULL WITH DEFAULT;
    CompanyCode = VARCHAR(20) NOT NULL WITH DEFAULT;
    TempComment = VARCHAR(500) NOT NULL WITH DEFAULT;
    MatrixGrouping = ARRAY OF INTEGEROBJECT; /*List of matrix for ckt*/
    TempMatrix = INTEGER NOT NULL WITH DEFAULT; 
    TV       = TreeViewField;
    TCObject = TreeClass;
    SelectedType = INTEGER NOT NULL;
    SelectedName = VARCHAR(40) NOT NULL;
    btn_Clicked = integer not null not default;
    OldRouteList = ARRAY OF TypeClass;
) =
DECLARE
   Update_Routes = PROCEDURE;
   HighlightCktRow = PROCEDURE;
BEGIN
/*  Dummy circuit information */
    CircuitPass.circuit = No$Value;
    CircuitPass.Card = 0;

    Ckts.Clear();
/*
**  Load the optionfield "linetype_filter" with linetypenames from the type
**  table.  A blank type is loaded as the default which is actually telephone circuit.
*/
    FIELD(linetypelist).CurBias = FB_INVISIBLE;
    FIELD(linetypelist).ValueList.ChoiceItems[1].EnumValue = Type$TelCircuit;
    FIELD(linetypelist).ValueList.ChoiceItems[1].EnumText = '';

    j = 2;
    SELECT  :linetype = T.Type,
            :linename = T.Name
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$TelCircuit
    AND     E.Type <> :Type$TelCircuit
    AND     E.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)
    ORDER BY linename
    BEGIN
        FIELD(linetypelist).ValueList.ChoiceItems[j].EnumValue = IFnull(linetype,0);
        FIELD(linetypelist).ValueList.ChoiceItems[j].EnumText = IFnull(linename,'');
        j = j + 1;
    END;
/*
**  setup the linetype filter
*/
    linetype_filter = FIELD(linetypelist).ValueList.ChoiceItems[1].EnumText;
    vLineType = FIELD(linetypelist).ValueList.ChoiceItems[1].EnumValue;
    vLineNumber = '%';
    vSubstationName = '%';
    vFeederName = '%';
/*
**  Details initialization
*/
    Curframe.CurMode = FM_READ;
    FIELD(TypeStack).CurBias = FB_INVISIBLE;
    FIELD(Obj).CurBias = FB_INVISIBLE;
/*
**  Initialize btn clicked so that we can clear the validated field.
*/
    btn_clicked = FALSE;
/*
**  Load type lists
*/

 /** Circuit Type **/
    i = 1;
    REPEATED
    SELECT  :CktTypeList[i].Object = T.Type,
            :CktTypeList[i].Name = T.Name,
            :CktTypeList[i].Description = T.Description
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$TelCircuit
    AND     E.Supertype <> E.Type
    AND     E.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)
    ORDER BY Name
    BEGIN
        /* We do not want user to pick any type that has a * in it */
        IF CktTypeList[i].Name LIKE '*%' THEN
           CktTypeList.RemoveRow(RowNumber = i);
        ELSE
           i = i + 1;
        ENDIF;
    END;
    
 /** Route **/
    RouteTypeList[1].Type = Type$Blank;
    RouteTypeList[1].Name = 'BLANK';
    i = 2;
    REPEATED
    SELECT  :RouteTypeList[i].Type = T.Type,
            :RouteTypeList[i].Name = T.Name
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$Route
    AND     E.Supertype <> E.Type
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;

 /** Function Area **/
    i = 1;
    REPEATED
    SELECT  :FuncAreaList[i].Type = T.Type,
            :FuncAreaList[i].Name = T.Name
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$FunctionArea
    AND     E.Supertype <> E.Type
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;
/*
**  Load Object Lists
*/
 /** Feeders/Networks/DivisionWorkStations **/
    i = 1;
    REPEATED
    SELECT  :FdrList[i].Object = O.Object,
            :FdrList[i].Name = O.Name,
            :FdrList[i].Type = O.Type,
            :FdrList[i].TypeName = O.TypeName
    FROM    Udb_Object O
    WHERE   O.Type IN (:Type$Line,:Type$Feeder,
                       :Type$Network,:Type$DivisionWorkstation)
    AND     O.Name <> 'Template'
    BEGIN
        i = i + 1;
    END;

 /** Substations and circuit terminals **/
    i = 1;
    REPEATED
    SELECT  :StnList[i].Object = O.Object,
            :StnList[i].Name = O.Name,
            :StnList[i].Type = O.Type,
            :StnList[i].TypeName = O.TypeName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
    BEGIN
        i = i + 1;
    END;

 /** Companies **/
    i = 1;
    REPEATED
    SELECT  :CompanyList[i].Object = O.Object,
            :CompanyList[i].Name = O.Name,
            :CompanyList[i].Type = O.Type,
            :CompanyList[i].TypeName = O.TypeName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType = :Type$Company
    BEGIN
        i = i + 1;
    END;
    
        CALLPROC LoadTypeList (EF = FIELD(Ckt.AltLineType1),
                               StartType = Type$AltLine1Types);

        CALLPROC LoadTypeList (EF = FIELD(Ckt.AltLineType2),
                               StartType = Type$AltLine2Types);

        CALLPROC LoadTypeList (EF = FIELD(Ckt.RTUCircuitType),
                               StartType = RTU$CircuitTypes);

 /** Groupers **/

/*
**  put the primarygroupingname in for the type name
*/
    i = 1;
    REPEATED
    SELECT  :GrouperList[i].Object = O.Object,
            :GrouperList[i].Name = O.Name,
            :GrouperList[i].Type = O.Type,
            :GrouperList[i].TypeName = O.PrimaryGroupingName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType = :Type$TelCardGrouper
    BEGIN
        i = i + 1;
    END;
/*
**  Init route list field
*/
   cl.ChoiceItems.Clear();
   i = 1;
   WHILE (i <= RouteTypeList.LastRow()) DO
        cl.ChoiceItems[i].EnumValue = RouteTypeList[i].Type;
        cl.ChoiceItems[i].EnumText = RouteTypeList[i].Name;
        i = i + 1;
   ENDWHILE;
   FIELD(RTP.RT).ValueList = cl.Duplicate();
   FIELD(RTP.RT).UpdChoiceList();

/*
**  Build tree object
*/
   TCObject.TV = FIELD(tab.tree.TVF);
   TCObject.Root = Type$TelCircuit;
   TCObject.BuildTree(); 
/*
**  Make the focus automatically go to the circuit name
*/
    Curframe.InputFocusField = FIELD(Feeder_Filter);
/* 
**  AutoLoad Card Circuit
*/
    IF CardCircuit <> 0 THEN
       CurrentCircuit.Circuit = CardCircuit;
       CurFrame.SendUserEvent ( EventName = 'LoadCircuitDetails');
    ENDIF;    
END;

ON ChildEntry ckts =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME NEXT;
   ENDIF;
   
   IF FIELD(Ckt).HasDataChanged = TRUE OR btn_Clicked = TRUE THEN
      IF CurFrame.ConfirmPopup (messagetext = 'You have not saved your changes. Continue?') = PU_CANCEL THEN
         FIELD(Ckts).CurRow = SelectedRow;
         CALLPROC HighlightCktRow();
         RESUME;
      ENDIF;
   ENDIF;
   
   SelectedRow = Field(Ckts).CurRow; 
   CurrentCircuit = Ckts[SelectedRow];
   CALLPROC HighlightCktRow();

   CurFrame.SendUserEvent ( EventName = 'LoadCircuitDetails');
END;
                     
ON ENTRY linetype_filter =
BEGIN
/*
**  Place the linetypelist over the field to choose from
*/
    FIELD(linetypelist).AbsXRight = Field(linetype_filter).AbsXRight; 
    FIELD(linetypelist).AbsYTop = Field(linetype_filter).AbsYTop; 
    FIELD(linetypelist).CurBias = FB_CHANGEABLE;
    FIELD(linetype_filter).ParentField.ParentField.CurBias = FB_VISIBLE;
    Curframe.Flush();
END;

ON Click linetypelist =
BEGIN
    linetype_filter = FIELD(linetypelist).CurEnumText;
    vLineType = FIELD(linetypelist).CurEnumValue;
    
    FIELD(linetypelist).CurBias = FB_INVISIBLE;
    FIELD(linetype_filter).ParentField.ParentField.CurBias = FB_CHANGEABLE;
    FIELD(linetype_filter).IsCurField = FALSE;
    FIELD(substation_filter).IsCurField = TRUE;
    Curframe.Flush();
END;

ON SETVALUE circuitstyle,
ON SETVALUE circuit_filter,
ON SETVALUE feeder_filter,
ON SETVALUE substation_filter  =
BEGIN
/*
**  If the filter is left blank we want to get ALL information for that field,
**  otherwise, we will filter the field dependent on the information in the
**  filter.  We THEN select information from the array dependent on the 
**  filter and display it in the tablefield.
*/

    IF circuit_filter = '' THEN
        vLineNumber = '%';
    ELSE
        IF CircuitStyle = 2 THEN
            vLineNumber = circuit_filter;
        ELSEIF CircuitStyle = 1 THEN
            vLineNumber = circuit_filter + '%';
        ELSE
            vLineNumber = '%' + circuit_filter + '%';
        ENDIF;
    ENDIF;

    IF substation_filter = '' THEN
        vSubstationName = '%';
    ELSE
        vSubstationName = '%' + substation_filter + '%';
    ENDIF;

    IF feeder_filter = '' THEN
        vFeederName = '%';
    ELSE
        vFeederName = '%' + feeder_filter + '%';
    ENDIF;
END;

ON CLICK clr_filters =
BEGIN
/* Reset the filter fields. */
    Field(linetype_filter).SetToDefault();
    Field(feeder_filter).SetToDefault();
    Field(substation_filter).SetToDefault();
    Field(circuit_filter).SetToDefault();

    linetype_filter = FIELD(linetypelist).ValueList.ChoiceItems[1].EnumText;
    vLineType = FIELD(linetypelist).ValueList.ChoiceItems[1].EnumValue;
    vLineNumber = '%';
    vSubstationName = '%';
    vFeederName = '%';
END;


ON CLICK search_btn =
BEGIN
    IF (vLineNumber = '%') AND
       (vSubstationName = '%') AND
       (vFeederName = '%') AND
       (vLineType = Type$TelCircuit) THEN
        Message 'You must enter some search criteria.';
        RESUME;
    ENDIF;
/*
**  Select circuits for creating a new card.
**  We need to do two separate selects depending on if there is data in the
**  feeder field since not all circuits have feeders.
*/
    Ckts.Clear();
    CktSearch.Clear();
/*
**  If UserRole = TEST then do not use Controlled By Desk in
**  where clause.  Following Select IF-THEN-ELSE structure copied
**  for role tester.  Causes a lot of code duplication, but is
**  simplest approach.  We want a repeated select and not a 
**  dynamic where clause for this mess.
*/
    IF UserRole = Role$Tester THEN

    IF (VFeederName = '%') THEN
/*
**  Select ALL circuits and do not join on the feeder grouping
*/
        i = 1;
        REPEATED
        SELECT DISTINCT
                :cktsearch[i].Circuit = O.Object,
                :cktsearch[i].LineNumber = O.Name,
                :cktsearch[i].LineType = O.Type,
                :cktsearch[i].LineTypeName = O.TypeName,
                :cktsearch[i].RouteName = T.Name,
                :cktsearch[i].Route = T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Name like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = R.Object
        AND     R.Route = T.Type
        UNION
        SELECT  O.Object,
                O.Name,
                O.Type,
                O.TypeName,
                T.Name,
                T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Comment like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = R.Object
        AND     R.Route = T.Type
        ORDER BY Circuit
        BEGIN
        /*
        **  Get all of the grouping info and concatenate it into 
        **  the substation and feeder fields
        */
            GroupingInfo.Clear();
            j = 1;
            REPEATED
            SELECT  :GroupingInfo[j].Object = G.Grouping,
                    :GroupingInfo[j].Type = G.GroupingType,
                    :GroupingInfo[j].Name = O.Name
            FROM    Udb_Grouping G,
                    Udb_Object O
            WHERE   G.Member = :cktsearch[i].Circuit
            AND     G.Relationship = :Interaction$MemberOf
            AND     G.GroupingType <> :Type$TelCardGrouper
            AND     G.GroupingType <> :Type$Division
            AND     G.Grouping = O.Object
            BEGIN
                j = j + 1;
            END;
            CALLPROC DDB_ROLLBACK;

            j = 1;
            WHILE (j <= GroupingInfo.LastRow()) DO
                SubTypeofSub = 0;
                SELECT SubTypeofSub = 1
                FROM   Udb_ExtendedType
                WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
                AND    Type = :GroupingInfo[j].Type;
                CALLPROC DDB_ROLLBACK;

                IF (SubTypeofSub = 1) THEN
                    IF (cktsearch[i].SubstationNames = '') THEN
                        cktsearch[i].SubstationNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].SubstationNames = cktsearch[i].SubstationNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ELSE
                    IF (cktsearch[i].FeederNames = '') THEN
                        cktsearch[i].FeederNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].FeederNames = cktsearch[i].FeederNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ENDIF;
                j = j + 1;
            ENDWHILE;
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;

    ELSE
/*
**  Select ONLY those circuits which have a grouping with a feeder
*/
        i = 1;
        REPEATED
        SELECT DISTINCT
                :cktsearch[i].Circuit = O.Object,
                :cktsearch[i].LineNumber = O.Name,
                :cktsearch[i].LineType = O.Type,
                :cktsearch[i].LineTypeName = O.TypeName,
                :cktsearch[i].RouteName = T.Name,
                :cktsearch[i].Route = T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,              /* substation */
                Udb_Grouping G1,            /* circuit grouped to feeder */
                Udb_Object O2,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Name like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = G1.Member
        AND     G1.Relationship = :Interaction$MemberOf
        AND     G1.GroupingType IN (SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Line,:Type$Feeder,
                                                          :Type$Network,:Type$DivisionWorkstation))
        AND     G1.Grouping = O2.Object
        AND     O2.Name like :vfeedername
        AND     O.Object = R.Object
        AND     R.Route = T.Type
        UNION
        SELECT  O.Object,
                O.Name,
                O.Type,
                O.TypeName,
                T.Name,
                T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,              /* substation */
                Udb_Grouping G1,            /* circuit grouped to feeder */
                Udb_Object O2,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Comment like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = G1.Member
        AND     G1.Relationship = :Interaction$MemberOf
        AND     G1.GroupingType IN (SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Line,:Type$Feeder,
                                                          :Type$Network,:Type$DivisionWorkstation))
        AND     G1.Grouping = O2.Object
        AND     O2.Name like :vfeedername
        AND     O.Object = R.Object
        AND     R.Route = T.Type        
        ORDER BY Circuit
        BEGIN
        /*
        **  Get all of the grouping info and concatenate it into 
        **  the substation and feeder fields
        */
            GroupingInfo.Clear();
            j = 1;
            REPEATED
            SELECT  :GroupingInfo[j].Object = G.Grouping,
                    :GroupingInfo[j].Type = G.GroupingType,
                    :GroupingInfo[j].Name = O.Name
            FROM    Udb_Grouping G,
                    Udb_Object O
            WHERE   G.Member = :cktsearch[i].Circuit
            AND     G.Relationship = :Interaction$MemberOf
            AND     G.GroupingType <> :Type$TelCardGrouper
            AND     G.GroupingType <> :Type$Division
            AND     G.Grouping = O.Object
            BEGIN
                j = j + 1;
            END;
            CALLPROC DDB_ROLLBACK;

            j = 1;
            WHILE (j <= GroupingInfo.LastRow()) DO
                SubTypeofSub = 0;
                SELECT SubTypeofSub = 1
                FROM   Udb_ExtendedType
                WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
                AND    Type = :GroupingInfo[j].Type;
                CALLPROC DDB_ROLLBACK;

                IF (SubTypeofSub = 1) THEN
                    IF (cktsearch[i].SubstationNames = '') THEN
                        cktsearch[i].SubstationNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].SubstationNames = cktsearch[i].SubstationNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ELSE
                    IF (cktsearch[i].FeederNames = '') THEN
                        cktsearch[i].FeederNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].FeederNames = cktsearch[i].FeederNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ENDIF;
                j = j + 1;
            ENDWHILE;
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;
    ENDIF;

    ELSE  /* Not Tester */

    IF (VFeederName = '%') THEN
/*
**  Select ALL circuits and do not join on the feeder grouping
*/
        i = 1;
        REPEATED
        SELECT DISTINCT
                :cktsearch[i].Circuit = O.Object,
                :cktsearch[i].LineNumber = O.Name,
                :cktsearch[i].LineType = O.Type,
                :cktsearch[i].LineTypeName = O.TypeName,
                :cktsearch[i].RouteName = T.Name,
                :cktsearch[i].Route = T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,              /* substation */
                Udb_Grouping G2,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Name like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = G2.Member
        AND     G2.Relationship = :Interaction$ControlledBy
        AND     G2.Grouping = :UserDesk
        AND     O.Object = R.Object 
        AND     R.Route = T.Type
        ORDER BY Circuit
        BEGIN
        /*
        **  Get all of the grouping info and concatenate it into 
        **  the substation and feeder fields
        */
            GroupingInfo.Clear();
            j = 1;
            REPEATED
            SELECT  :GroupingInfo[j].Object = G.Grouping,
                    :GroupingInfo[j].Type = G.GroupingType,
                    :GroupingInfo[j].Name = O.Name
            FROM    Udb_Grouping G,
                    Udb_Object O
            WHERE   G.Member = :cktsearch[i].Circuit
            AND     G.Relationship = :Interaction$MemberOf
            AND     G.GroupingType <> :Type$TelCardGrouper
            AND     G.GroupingType <> :Type$Division
            AND     G.Grouping = O.Object
            BEGIN
                j = j + 1;
            END;
            CALLPROC DDB_ROLLBACK;

            j = 1;
            WHILE (j <= GroupingInfo.LastRow()) DO
                SubTypeofSub = 0;
                SELECT SubTypeofSub = 1
                FROM   Udb_ExtendedType
                WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
                AND    Type = :GroupingInfo[j].Type;
                CALLPROC DDB_ROLLBACK;

                IF (SubTypeofSub = 1) THEN
                    IF (cktsearch[i].SubstationNames = '') THEN
                        cktsearch[i].SubstationNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].SubstationNames = cktsearch[i].SubstationNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ELSE
                    IF (cktsearch[i].FeederNames = '') THEN
                        cktsearch[i].FeederNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].FeederNames = cktsearch[i].FeederNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ENDIF;
                j = j + 1;
            ENDWHILE;
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;

    ELSE
/*
**  Select ONLY those circuits which have a grouping with a feeder
*/
        i = 1;
        REPEATED
        SELECT DISTINCT
                :cktsearch[i].Circuit = O.Object,
                :cktsearch[i].LineNumber = O.Name,
                :cktsearch[i].LineType = O.Type,
                :cktsearch[i].LineTypeName = O.TypeName,
                :cktsearch[i].RouteName = T.Name,
                :cktsearch[i].Route = T.Type
        FROM    Udb_Object O,               /* circuit */
                Udb_Grouping G,             /* circuit grouped to station */
                Udb_Object O1,              /* substation */
                Udb_Grouping G1,            /* circuit grouped to feeder */
                Udb_Object O2,              /* feeder */
                Udb_Grouping G2,
                Udb_CircuitRoute R,
                Udb_Type T
        WHERE   O.Name like :vlinenumber
        AND     O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :vLineType)
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
        AND     G.Grouping = O1.Object
        AND     O1.Name like :vsubstationname
        AND     O.Object = G1.Member
        AND     G1.Relationship = :Interaction$MemberOf
        AND     G1.GroupingType IN (SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype IN (:Type$Line,:Type$Feeder,
                                                          :Type$Network,:Type$DivisionWorkstation))
        AND     G1.Grouping = O2.Object
        AND     O2.Name like :vfeedername
        AND     O.Object = G2.Member
        AND     G2.Relationship = :Interaction$ControlledBy
        AND     G2.Grouping = :UserDesk
        AND     O.Object = R.Object 
        AND     R.Route = T.Type
        ORDER BY Circuit
        BEGIN
        /*
        **  Get all of the grouping info and concatenate it into 
        **  the substation and feeder fields
        */
            GroupingInfo.Clear();
            j = 1;
            REPEATED
            SELECT  :GroupingInfo[j].Object = G.Grouping,
                    :GroupingInfo[j].Type = G.GroupingType,
                    :GroupingInfo[j].Name = O.Name
            FROM    Udb_Grouping G,
                    Udb_Object O
            WHERE   G.Member = :cktsearch[i].Circuit
            AND     G.Relationship = :Interaction$MemberOf
            AND     G.GroupingType <> :Type$TelCardGrouper
            AND     G.GroupingType <> :Type$Division
            AND     G.Grouping = O.Object
            BEGIN
                j = j + 1;
            END;
            CALLPROC DDB_ROLLBACK;

            j = 1;
            WHILE (j <= GroupingInfo.LastRow()) DO
                SubTypeofSub = 0;
                SELECT SubTypeofSub = 1
                FROM   Udb_ExtendedType
                WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
                AND    Type = :GroupingInfo[j].Type;
                CALLPROC DDB_ROLLBACK;

                IF (SubTypeofSub = 1) THEN
                    IF (cktsearch[i].SubstationNames = '') THEN
                        cktsearch[i].SubstationNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].SubstationNames = cktsearch[i].SubstationNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ELSE
                    IF (cktsearch[i].FeederNames = '') THEN
                        cktsearch[i].FeederNames = GroupingInfo[j].Name;
                    ELSE
                        cktsearch[i].FeederNames = cktsearch[i].FeederNames+', '+GroupingInfo[j].Name;
                    ENDIF;
                ENDIF;
                j = j + 1;
            ENDWHILE;
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;
    ENDIF;

    ENDIF;  /* Tester IF-THEN-ELSE */

    IF (i <= 1) THEN
        Message 'No circuits found for the search criteria.';
        RESUME;
    ENDIF;
    /*
    **  Clean up duplicates if we aren't calling from Protection Matrix screen.
    */
    IF ReplaceCircuit <> TRUE AND cktsearch.LastRow > 1 THEN
       i = 2;
       WHILE i <= cktsearch.LastRow DO
          IF cktsearch[i -1].Circuit = cktsearch[i].Circuit THEN
             cktsearch.RemoveRow(RowNumber = i);
          ELSE
             i = i + 1;
          ENDIF; 
       ENDWHILE;
    ENDIF;
    
    ckts = cktsearch.Duplicate();
    FIELD(ckts).UpdField(); 
    SelectedRow = 0;
END;


ON USEREVENT 'LoadCircuitDetails' =
BEGIN
    FIELD(Ckt).HasDataChanged = FALSE;
    btn_Clicked = FALSE;
    
    Curframe.SendUserEvent (EventName = 'ClearData');
    Curframe.SendUserEvent (EventName = 'LoadData');
END;

ON USEREVENT 'ClearData' =
BEGIN
/* clear the circuit information */
    FIELD(Ckt.CircuitInfo).SetToDefault();

/* clear the carrier information */
    CurCarrier.Object = 0;
    CurCarrier.Type = 0;
    CurCarrier.Name = '';
    CurCarrier.TypeName = '';
    FIELD(Ckt.CarrierInfo).SetToDefault();

/* clear the grouper information */
    CurGrouper.Object = 0;
    CurGrouper.Type = 0;
    CurGrouper.TypeName = '';
    CurGrouper.Name = '';
    FIELD(Grouper).SetToDefault();

/* clear the associated circuits information */
    CurAssocList.Clear();
    Associated_sf.Circuits.Clear();

/* clear the substation information */
    Ckt.SubstationInfo.Clear();
    CurStnList.Clear();

/* clear the feeder information */
    Ckt.FeederInfo.Clear();
    CurFdrList.Clear();

/* clear the verizon format */
    CurVerizonName = '';
    
    Ckt.AltLine1 = '';
    Ckt.AltLine2 = '';
    Ckt.AltLineType1 = 0;
    Ckt.AltLineType2 = 0;
    Ckt.RTUCircuitType = 0;
END;

ON USEREVENT 'LoadData' =
BEGIN
    Curframe.CurMode = FM_UPDATE;
/*
**  Get the information for the current circuit
*/    
    REPEATED
    SELECT  :Ckt.CircuitInfo.Object = O.Object,
            :Ckt.CircuitInfo.Name = O.Name,
            :Ckt.CircuitInfo.Description = O.Description,
            :Ckt.CircuitInfo.Type = O.Type,
            :Ckt.CircuitInfo.TypeName = O.TypeName,
            :Ckt.CircuitInfo.PrimaryGrouping = O.PrimaryGrouping,
            :Ckt.CircuitInfo.PrimaryGroupingName = O.PrimaryGroupingName,
            :Ckt.CircuitInfo.Comment = O.Comment,
            :Ckt.CircuitInfo.Validated = O.Validated,
            :Ckt.CircuitInfo.ValidatedBy = O.ValidatedBy,
            :Ckt.CircuitInfo.Inservice = O.Inservice,
            :Ckt.CircuitInfo.Outservice = O.Outservice,
            :Ckt.CircuitInfo.PositionX = O.PositionX,
            :Ckt.CircuitInfo.PositionY = O.PositionY,
            :Ckt.CircuitInfo.OwnerNumber = O.OwnerNumber,
            :Ckt.CircuitInfo.SerialNumber = O.SerialNumber,
            :Ckt.CircuitInfo.SpecNumber = O.SpecNumber,
            :Ckt.CircuitInfo.Combination = O.Combination,
            :Ckt.CircuitInfo.LockNumber = O.LockNumber,
            :Ckt.CircuitInfo.LastChanged = O.LastChanged,
            :Ckt.CircuitInfo.LastChangedBy = O.LastChangedBy,
            :Ckt.FunctionArea = C.FunctionArea,
            :Ckt.FunctionAreaName = T1.Name,
            :Ckt.PriorityLine = C.PriorityLine,
            :Ckt.CurrentlyOpen = C.CurrentlyOpen,
            :Ckt.AltLine1 = C.AltLine1,
            :Ckt.AltLine2 = C.AltLine2,
            :Ckt.AltLineType1 = C.AltLineType1,
            :Ckt.AltLineType2 = C.AltLineType2,
            :Ckt.RTUCircuitType = C.RTUCircuitType
    FROM    Udb_Object O,
            Udb_TelephoneCircuit C,
            Udb_Type T1
    WHERE   O.Object = :CurrentCircuit.Circuit
    AND     O.Object = C.Object
    AND     C.FunctionArea = T1.Type;
    CALLPROC DDB_ROLLBACK;
/*
** get circuit's route/channels
*/
    RouteName = '';
    OldRouteList.Clear();
    i = 1;
    SELECT :OldRouteList[i].Type = T.Type,
           :OldRouteList[i].Name = SQUEEZE(T.Name)
    FROM   UDB_CircuitRoute C,
           UDB_Type T
    WHERE  C.Object = :CurrentCircuit.Circuit AND
           C.Route = T.Type AND
           C.Route <> 0
    BEGIN
       IF RouteName <> '' THEN
          RouteName = RouteName  + '; ' ;
       ENDIF;
       RouteName = RouteName + OldRouteList[i].Name;
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    RTP.RL = OldRouteList.Duplicate();
    FIELD(Ckt.RouteName).TextValue = RouteName;
/*
**  Get CSO Report type
*/
    SELECT :Ckt.CircuitInfo.Status = T.Name
    FROM    Udb_Type T,
            Udb_SuperType ST,
            Udb_Supertype ST2
    WHERE   T.Type = ST.SuperType AND
            ST.Type = :Ckt.CircuitInfo.Type AND
            ST.SuperType = ST2.Type AND
            ST2.SuperType = :Type$CircuitReportCategory;
    CALLPROC DDB_ROLLBACK;
/*
**  Get all grouping information for the circuit
*/
    REPEATED
    SELECT  :CurCarrier.Object = O.Object,
            :CurCarrier.Type = O.Type,  
            :CurCarrier.TypeName = O.TypeName,
            :CurCarrier.Name = O.Name
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$ProvidedBy
    AND     G.Grouping = O.Object;
    CALLPROC DDB_ROLLBACK;
    Ckt.CarrierInfo = CurCarrier.Duplicate();
    
    IF Ckt.CarrierInfo.Object = Company$Verizon THEN
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_CHANGEABLE;
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_CHANGEABLE;
       SELECT :CurVerizonName = V.LineName
       FROM    TC_VerizonCircuit V
       WHERE   V.Circuit = :CurrentCircuit.Circuit;
       Ckt.CircuitInfo.CreatedBy = CurVerizonName;
       IF Ckt.CircuitInfo.CreatedBy = '' THEN
          Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
       ENDIF;
       CurFrame.IsAutoSized = TRUE;
       CurFrame.Flush();   
    ELSE
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_INVISIBLE;
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_INVISIBLE;
    ENDIF;
    
    REPEATED
    SELECT  :CurGrouper.Object = O.Object,
            :CurGrouper.Type = O.Type,
            :CurGrouper.TypeName = O.PrimaryGroupingName, /*load substation*/
            :CurGrouper.Name = O.Name
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  SuperType = :Type$TelCardGrouper)
    AND     G.Grouping = O.Object;
    CALLPROC DDB_ROLLBACK;
    Grouper = CurGrouper.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurAssocList[i].Object = O.Object,
            :CurAssocList[i].Name = O.Name,
            :CurAssocList[i].Type = O.Type,
            :CurAssocList[i].TypeName = O.TypeName
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Grouping = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.MemberType IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  Supertype = :Type$TelCircuit)
    AND     G.Member = O.Object
    ORDER BY Status
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    Associated_sf.Circuits = CurAssocList.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurStnList[i].Object = O.Object,
            :CurStnList[i].Name = O.Name,
            :CurStnList[i].Type = O.Type,
            :CurStnList[i].TypeName = O.TypeName,
            :CurStnList[i].Status = G.Reference    /* use this for now */
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
    AND     G.Grouping = O.Object
    ORDER BY Status
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    Ckt.SubstationInfo = CurStnList.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurFdrList[i].Object = O.Object,
            :CurFdrList[i].Type = O.Type,
            :CurFdrList[i].TypeName = O.TypeName,
            :CurFdrList[i].Name = O.Name
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  Supertype IN 
                                       (:Type$Feeder,:Type$Network,:Type$Line,
                                        :Type$DivisionWorkstation))
    AND     G.Grouping = O.Object
    BEGIN
        i = i + 1;
    END;
    Ckt.FeederInfo = CurFdrList.Duplicate();
/*
**  Populate division and desk fields
*/
    TempComment = '';
    SELECT  :TempName = O.Name
    FROM     Udb_Object O,
             Udb_Grouping G
    WHERE    G.Member = :CurrentCircuit.Circuit AND
             G.RelationShip = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND
             G.Grouping = O.Object
    BEGIN
       TempComment = TempComment + TempName + HC_NEWLINE;
    END;
    IF TempComment = '' THEN
       FIELD(Division_Txt).BGColor = CC_RED;
       TempComment = 'NONE!' + HC_NEWLINE;
    ELSE
       FIELD(Division_Txt).BGColor = CC_PALE_BLUE;
    ENDIF;

    TempComment = left(TempComment, length(TempComment) - 1);
    FIELD(Division_txt).TextValue = TempComment;
    

    TempComment = '';
    SELECT  :TempName = O.Name
    FROM     Udb_Object O,
             Udb_Grouping G
    WHERE    G.Member = :CurrentCircuit.Circuit AND
             G.RelationShip = :Interaction$ControlledBy AND
             G.GroupingType = :Type$OperatorDesk AND
             G.Grouping = O.Object
    BEGIN
       TempComment = TempComment + TempName + HC_NEWLINE;
    END;
    IF TempComment = '' THEN
       FIELD(Desk_Txt).BGColor = CC_RED;
       TempComment = 'NONE!' + HC_NEWLINE;
    ELSE
       FIELD(Desk_Txt).BGColor = CC_PALE_BLUE;
    ENDIF;

    TempComment = left(TempComment, length(TempComment) - 1);
    FIELD(Desk_txt).TextValue = TempComment;
/*
** Determine which field to show.
*/
    i = 0;
    SELECT :i = ET.Type
    FROM    Udb_ExtendedType ET
    WHERE   SuperType = :Type$TelCardGrouper AND
            Type = :Ckt.CircuitInfo.Type;

    IF i <> 0 THEN /* Grouper circuit type */
       /*
       ** 12/06/2012 a grouper can be a member of another grouper 
       */
       Grouper = CurGrouper.Duplicate();
       FIELD(Grouper).ParentField.AllBias = FB_LANDABLE;
       FIELD(Grouper).ParentField.CurBias = FB_LANDABLE;

       Associated_sf.Circuits = CurAssocList.Duplicate();
       FIELD(Associated_sf).AllBias = FB_LANDABLE;
       FIELD(Associated_sf).CurBias = FB_LANDABLE;
/*
obsolete 12/06/2012
       FIELD(Grouper).SetToDefault();
       FIELD(Grouper).ParentField.AllBias = FB_INVISIBLE;
       FIELD(Grouper).ParentField.CurBias = FB_INVISIBLE;
*/       
    ELSE
       Grouper = CurGrouper.Duplicate();
       FIELD(Grouper).ParentField.AllBias = FB_LANDABLE;
       FIELD(Grouper).ParentField.CurBias = FB_LANDABLE;

       Associated_sf.Circuits.Clear();
       FIELD(Associated_sf).AllBias = FB_INVISIBLE;
       FIELD(Associated_sf).CurBias = FB_INVISIBLE;
       
    ENDIF;
/*
**  Determine which buttons to show on the bottom of the screen. 
*/
    IF UPPERCASE(Ckt.CircuitInfo.Name) LIKE '%PENDDISC' THEN
       FIELD(Pending_btn).AllBias = FB_INVISIBLE;
       FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
       FIELD(Remove_btn).AllBias = FB_LANDABLE;
       FIELD(Remove_btn).CurBias = FB_LANDABLE;       
    ELSE
       FIELD(Pending_btn).AllBias = FB_LANDABLE;
       FIELD(Pending_btn).CurBias = FB_LANDABLE;
              
       FIELD(Remove_btn).AllBias = FB_INVISIBLE;
       FIELD(Remove_btn).CurBias = FB_INVISIBLE;
    ENDIF;

    CurFrame.IsAutoSized = TRUE;
    CurFrame.Flush();   

    CurFrame.BringToFront();
END;

ON CLICK Pending_btn =
BEGIN
   
   IF CurFrame.ConfirmPopup (messagetext = 'Are you sure you want to ' +
         'remove all groupings with this circuit and set the name to ' + 
         Ckt.CircuitInfo.Name + '_PendDisc?   Select ''OK'' to continue.') = PU_CANCEL THEN
   
      RESUME;
   ENDIF;
   /*  REMOVED 09/10/2018
   **  Make sure circuit is not on a matrix.
   **
   i = 0;
   SELECT :i = COUNT(*)
   FROM    CAC_Relay_Circuit
   WHERE   Circuit = :CurrentCircuit.Circuit;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      IF CurFrame.ConfirmPopup (messagetext = 'This circuit is part of a ' + 
              'Relay Protection Matrix. Before setting a circuit ' +
              'to Pending Disconnect, you must first replace the circuit ' +
              'in the Relay Protection Matrix.  Select ''OK'' to load the ' + 
              'Relay Protection Matrix and replace the circuit.') = PU_CANCEL THEN
         RESUME;
      ENDIF;
      /*
      **  First select the number of matrix's each circuit is a member of.
      **  If there are more than one, then we will display a frame to select
      **  which matrix they would like to view.
      **  If there is only one, we will load the matrix.
      *
      MatrixGrouping.Clear();
      SELECT :TempMatrix = R.Grouping
      FROM   CAC_Relay_Circuit R
      WHERE  R.Circuit = :CurrentCircuit.Circuit
      BEGIN
         FOR i = 1 TO MatrixGrouping.LastRow() DO
            If MatrixGrouping[i].Value = TempMatrix THEN
               ENDLOOP;
            ENDIF;
         ENDFOR;
         IF i > MatrixGrouping.LastRow() THEN
            MatrixGrouping[i].Value = TempMatrix;
         ENDIF;          
      END;

      IF MatrixGrouping.LastRow() = 1 THEN
          CALLFRAME RelayProtectionMatrix(
                              CurrentGrouping = MatrixGrouping[1].Value,
                              CardObject = 0,
                              FromTC = TRUE);
      ELSE
          CALLFRAME ProtectionCompromised(
                              MatrixGrouping = MatrixGrouping.Duplicate(),
                              FromTC = TRUE);         
      ENDIF;
      RESUME;
   ENDIF;
*/
   TempComment = '(Substations:';
   FOR i = 1 TO Ckt.SubstationInfo.LastRow() DO
      TempComment = TempComment + ' ' + Ckt.SubstationInfo[i].Name;
   ENDFOR;

   TempComment = TempComment + ') (Feeders:';   
   IF Ckt.FeederInfo.LastRow() = 0 THEN
      TempComment = TempComment + 'None';
   ELSE
      FOR i = 1 TO Ckt.FeederInfo.LastRow() DO
         TempComment = TempComment + ' ' + Ckt.FeederInfo[i].Name;
      ENDFOR;
   ENDIF;
   
   TempComment = TempComment + ') Route: ' + Ckt.RouteName;

   TempComment = Ckt.CircuitInfo.Comment + HC_NEWLINE + 
                 TempComment;
   Ckt.CircuitInfo.Comment = TempComment;
   /*
   **  Update for Grouping History insert.
   */
   TempComment = Ckt.CircuitInfo.Name + ' was set to Pending Disconnect. ' + 
                 'Comment: ' + TempComment;
   
   Ckt.CircuitInfo.Name = Ckt.CircuitInfo.Name + '_PendDisc';
   Ckt.CircuitInfo.Outservice = DATE('now');

   IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
      Ckt.CircuitInfo.Validated = 'now';
   ELSE
      IF DOp.Type = Type$PersonDO THEN
         Ckt.CircuitInfo.Validated = 'now';
         Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
      ELSE
         Ckt.CircuitInfo.Validated = NULL;
      ENDIF;
   ENDIF;
/*
**  Update object and remove telephone circuit information
*/
   RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Ckt.CircuitInfo.Type,
                PrimaryGrouping = Ckt.CircuitInfo.PrimaryGrouping,
                TypeName = Ckt.CircuitInfo.TypeName,
                PrimaryGroupingName = Ckt.CircuitInfo.PrimaryGroupingName,
                Name = Ckt.CircuitInfo.Name,
                Description = Ckt.CircuitInfo.Description,
                Comment = Ckt.CircuitInfo.Comment,
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error occurred while updating circuit object information.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen,
                AltLineType1 = Ckt.AltLineType1,
                AltLine1 = Ckt.AltLine1,
                AltLineType2 = Ckt.AltLineType2,
                AltLine2 = Ckt.AltLine2,
                RTUCircuitType = Ckt.RTUCircuitType);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while updating circuit information.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Update routes.
*/
   CALLPROC Update_Routes();
/*
**  Remove Verizon format
*/
   RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to remove the Verizon format.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Delete all grouping information
*/
   RetCode = CALLPROC Udb_GroupingDeleteAll (
               Grouping = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping information.';
       RESUME;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingMemberDel (
               Member = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping memberships.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Log for reporting.
   */
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = 0, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$PendingDisconnect,
                   Comment = TempComment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:CircuitDetails:Error logging Pending Disconnect of circuit.');
   ENDIF;
   CALLPROC DDB_COMMIT;  
   /*
   **  Set bias for buttons.
   */
   FIELD(Pending_btn).AllBias = FB_INVISIBLE;
   FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
   FIELD(Remove_btn).AllBias = FB_LANDABLE;
   FIELD(Remove_btn).CurBias = FB_LANDABLE;       
END;

ON CLICK Remove_btn =
BEGIN
   /*  Removed 02/01/24
   **  Make sure circuit is not on a matrix.
   *
   i = 0;
   SELECT :i = COUNT(*)
   FROM    CAC_Relay_Circuit
   WHERE   Circuit = :CurrentCircuit.Circuit;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      MESSAGE 'Before deleting a circuit, ' +
              'you must first remove it from any Relay Protection Matix.';
      RESUME;
   ENDIF;
   */
   IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
      Ckt.CircuitInfo.Validated = 'now';
   ELSE
      IF DOp.Type = Type$PersonDO THEN
         Ckt.CircuitInfo.Validated = 'now';
         Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
      ELSE
         Ckt.CircuitInfo.Validated = NULL;
      ENDIF;
   ENDIF;
/*
**  Update object and remove telephone circuit information
*/
   RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Type$ObsoleteObject,
                PrimaryGrouping = 0,
                TypeName = 'Obsolete Object',
                PrimaryGroupingName = '',
                Name = varchar(Ckt.CircuitInfo.Object),
                Description = '',
                Comment = '',
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error occurred while updating circuit object information.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen,
                AltLineType1 = Ckt.AltLineType1,
                AltLine1 = Ckt.AltLine1,
                AltLineType2 = Ckt.AltLineType2,
                AltLine2 = Ckt.AltLine2,
                RTUCircuitType = Ckt.RTUCircuitType);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while updating circuit information.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Remove Verizon format
*/
   RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to remove the Verizon format.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Delete all grouping information
*/
   RetCode = CALLPROC Udb_GroupingDeleteAll (
               Grouping = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping information.';
       RESUME;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingMemberDel (
               Member = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping memberships.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Log for reporting.
   */
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = 0, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$RemoveCircuit,
                   Comment = Ckt.CircuitInfo.Name + ' removed; Comment was: ' +
                             Ckt.CircuitInfo.Comment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:CircuitDetails:Error logging Removing of circuit.');
   ENDIF;
   CALLPROC DDB_COMMIT;  
   /*
   **  Set bias for buttons.
   */
   FIELD(Pending_btn).AllBias = FB_INVISIBLE;
   FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
   FIELD(Remove_btn).AllBias = FB_INVISIBLE;
   FIELD(Remove_btn).CurBias = FB_INVISIBLE;     
END;


ON SetValue Ckt.CircuitInfo.Name = 
BEGIN
   IF Ckt.CarrierInfo.Object = Company$Verizon THEN
      Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
   ENDIF;
END;

ON UserEvent 'ConvertToVerizon' = 
BEGIN
   /*
   **  First lets replace any '.' with a '-' and see
   **  how many - we have.
   */
   TempName = Ckt.CircuitInfo.Name;
   PreFixName = '';
   DashCount = 0;
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF TempChar = '.' OR
         TempChar = '-' THEN
         TempChar = '-';
         DashCount = DashCount + 1;
      ENDIF;
      PreFixName = PreFixName + TempChar;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;

   TempName = PreFixName;

   PreFixName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF '0' <= TempChar AND TempChar <= '9' THEN
         PreFixName = PreFixName + TempChar;
      ELSE
         ENDLOOP;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;

   SvcCodeName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF '0' <= TempChar AND TempChar <= '9' THEN
         ENDLOOP;
      ELSE
         SvcCodeName = SvcCodeName + TempChar;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;
   
   SvcCodeLength = LENGTH(SvcCodeName);
   IF SvcCodeLength = 4 THEN
      CompanyCode = '/ny';
   ELSE
      IF DashCount > 1 THEN
         CompanyCode = '/';
      ELSE
         CompanyCode = '';
      ENDIF;
   ENDIF;
   
   PreSerialName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF TempChar = '-' THEN
         TempName = SHIFT(TempName,-1);
         ENDLOOP;
      ELSE
         PreSerialName = PreSerialName + TempChar;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;
   
   IF Length(TempName) > 0 THEN
      TempChar = left(TempName,1);
   ELSE
      TempChar = '';
   ENDIF;
   /*
   **  If next character is a number and SvcCode is not 4 characters
   **  this is part of the SerialName.  Otherwise it is part of the segment.
   */
   IF SvcCodeLength <> 4 AND 
     ('0' <= TempChar AND TempChar <= '9') THEN
      PostSerialName = '';
      WHILE length(TempName) >= 0 DO
         TempChar = left(TempName,1);
         /*
         **  Go through this logic if we see a '-' or if this
         **  is the last character of the linenumber.
         */
         IF TempChar = '-' OR LENGTH(TempName) = 0 THEN
            IF TempChar = '-' THEN
               TempName = SHIFT(TempName,-1);
            ENDIF;
            IF LENGTH(PostSerialName) = 1 THEN
               PostSerialName = '00' + PostSerialName;
            ELSEIF LENGTH(PostSerialName) = 2 THEN
               PostSerialName = '0' + PostSerialName;
            ENDIF;
            TempChar = PreSerialName + PostSerialName;
            SegmentName = '';
            WHILE LENGTH(TempChar) < 10 DO
               SegmentName = SegmentName + ' ';
               TempChar = PreSerialName + SegmentName + PostSerialName;          
            ENDWHILE;
            PreSerialName = TempChar;
            SegmentName = '';
            ENDLOOP;
         ELSE
            PostSerialName = PostSerialName + TempChar;
         ENDIF;
         TempName = SHIFT(TempName,-1);
      ENDWHILE;
   ENDIF;

   IF TempName <> '' THEN
      SegmentName = '/' + TempName;
   ELSE
      SegmentName = '';
   ENDIF;
   /*
   **  Don't show message if this is a future circuit.
   */
   IF Ckt.CircuitInfo.Name like 'FUTURE%' THEN
      RESUME;
   ENDIF;

   IF PreFixName = '' OR
      SvcCodeName = '' OR
      PreSerialName = '' THEN
      MESSAGE 'Unable to convert to Verizon format. ' + HC_NEWLINE +
              'You can not use the eletronic interface ' + HC_NEWLINE +
              'to create tickets for this Circuit with ' + HC_NEWLINE +
              'no Verizon Format.  ' + HC_NEWLINE +
              'Please contact Verizon for proper format.';
      RESUME;
   ENDIF;
     
   Ckt.CircuitInfo.CreatedBy = PreFixName + '/' + 
                               SvcCodeName + '/' + 
                               PreSerialName + 
                               CompanyCode + 
                               SegmentName;
END;

ON ENTRY Ckt.RouteName = 
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   FIELD(RTP).AbsXLeft = FIELD(Ckt.RouteName).AbsXLeft;
   FIELD(RTP).AbsYTop = FIELD(Ckt.RouteName).AbsYBottom;
   FIELD(RTP.DEL_Btn).CurBias = FB_DIMMED;
   FIELD(RTP).CurBias = FB_CHANGEABLE;
/*
**  Make the focus automatically go to the circuit name
*/
    Curframe.InputFocusField = FIELD(Ckt.CircuitInfo.Name);
END;

ON SetValue RTP.RT = 
DECLARE
   NewRoute = TypeClass;
BEGIN
   IF RTP.RT = 0 THEN
      RESUME;
   ENDIF;

   RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = RTP.RT);
   IF RetCode = ER_OK THEN
      MESSAGE 'Your selected route is already defined for this circuit';
      RESUME; 
   ENDIF;
        
   NewRoute.Type = RTP.RT;
   NewRoute.Name = FIELD(RTP.RT).CurEnumText;
   RTP.RL.InsertRow(RowNumber = (RTP.RL.LastRow + 1),
                             RowObject = NewRoute);
   Curframe.Flush();
/*
**  Set btn clicked so that we can clear the validated field.
*/
   btn_clicked = TRUE;
   RESUME;
END;

ON ChildEntry RTP.RL =
BEGIN
   FIELD(RTP.DEL_Btn).CurBias = FB_LANDABLE;
END; 

ON Click RTP.Del_Btn = 
BEGIN
   i = FIELD(RTP.RL).CurRow;
   RetCode = OldRouteList.Find(AttributeName = 'type',
                               Value = RTP.RL[i].Type);
   IF RetCode = ER_OK THEN
      /*  Removed 02/01/24
      **  Make sure circuit is not on a matrix.
      *
      k = 0;
      SELECT :k = 1 
      FROM   CAC_CO_Circuit
      WHERE  Circuit = :Ckt.CircuitInfo.Object AND
             Route = :RTP.RL[i].Type
      UNION
      SELECT 1 
      FROM   CAC_Relay_Circuit
      WHERE  Circuit = :Ckt.CircuitInfo.Object AND
             Route = :RTP.RL[i].Type;

      IF k = 1 THEN
         IF CurFrame.ConfirmPopup (messagetext = 'This route is part of a ' + 
              'Relay Protection Matrix.  ' +
              'You must remove this route from the matrix ' +
              'before deleting it from the circuit.  Select ''OK'' to load the ' + 
              'Relay Protection Matrix and replace the circuit/route.') = PU_CANCEL THEN
            RESUME;
         ENDIF;
         /*
         **  Update route information so user has option of switching current
         **  circuit/route combo with a new circuit/route combo.
         *
         CALLPROC Update_Routes();
         /*
         **  First select the number of matrix's each circuit is a member of.
         **  If there are more than one, then we will display a frame to select
         **  which matrix they would like to view.
         **  If there is only one, we will load the matrix.
         *
         MatrixGrouping.Clear();
         SELECT :TempMatrix = R.Grouping
         FROM   CAC_Relay_Circuit R
         WHERE  R.Circuit = :CurrentCircuit.Circuit
         BEGIN
            FOR i = 1 TO MatrixGrouping.LastRow() DO
               If MatrixGrouping[i].Value = TempMatrix THEN
                  ENDLOOP;
               ENDIF;
            ENDFOR;
            IF i > MatrixGrouping.LastRow() THEN
               MatrixGrouping[i].Value = TempMatrix;
            ENDIF;          
         END;

         IF MatrixGrouping.LastRow() = 1 THEN
            CALLFRAME RelayProtectionMatrix(
                              CurrentGrouping = MatrixGrouping[1].Value,
                              CardObject = 0,
                              FromTC = TRUE);
         ELSEIF MatrixGrouping.LastRow() = 0 THEN
            /*
            **  This circuit/route must be in a checked out matrix only.
            **  Show message telling user who has the matrix checked out.
            *
            TempName = '';
            SELECT :TempName = R.UserCheckOut
            FROM    CAC_CO_Circuit C,
                    CAC_Relay_Grouping R
            WHERE   C.Circuit = :CurrentCircuit.Circuit AND
                    C.Grouping = R.Grouping;
            IF TempName <> '' THEN
               MESSAGE TempName + ' has his Matrix checked out at this time. ' +
                       'Please contact ' + TempName + ' and ask them to remove the ' +
                       'circuit/route from the checked out Matrix.'; 
            ENDIF;         
         ELSE
            CALLFRAME ProtectionCompromised(
                              MatrixGrouping = MatrixGrouping.Duplicate(),
                              FromTC = TRUE);         
         ENDIF;
         RESUME;
      ENDIF;
      */
   ENDIF;
   RTP.RL.RemoveRow(RowNumber = i);
   FIELD(RTP.DEL_Btn).CurBias = FB_DIMMED;
/*
**  Set btn clicked so that we can clear the validated field.
*/
   btn_clicked = TRUE;
END;

ON Click RTP.OK_Btn = 
BEGIN
   RouteName = '';
   FOR i = 1 TO RTP.RL.LastRow DO
       IF RouteName <> '' THEN
          RouteName = RouteName + '; ';
       ENDIF;
       RouteName = RouteName + RTP.RL[i].Name;
   ENDFOR;
   Field(Ckt.RouteName).TextValue = RouteName;
   FIELD(Ckt.RouteName).IsCurField = FALSE;

   FIELD(RTP).CurBias = FB_INVISIBLE;
END;

ON ENTRY Ckt.CircuitInfo.PrimaryGroupingName,
ON ENTRY Ckt.FunctionAreaName =
BEGIN
/*
**  Keep track of where the type list was called from
*/
    CalledFrom = Curframe.TriggerField.FullName;
/*
**  Load the list for the appropriate field
*/
    IF (CalledFrom like '%functionareaname%') THEN
        LoadList = FuncAreaList.Duplicate();
    ELSEIF (CalledFrom like '%primarygroupingname%') THEN
        i = 0;
        SELECT :i = ET.Type
        FROM    Udb_ExtendedType ET
        WHERE   SuperType = :Type$TelCardGrouper AND
                Type = :Ckt.CircuitInfo.Type;
        LoadList.Clear();
        IF i <> 0 THEN /* Grouper circuit type */
           IF Ckt.SubstationInfo.LastRow() = 0 THEN
              message 'You must add a substation before choosing a Primary Grouping.';
              RESUME;
           ENDIF;
           
           FOR i = 1 TO Ckt.SubstationInfo.LastRow() DO
              LoadList[i].Type = Ckt.SubstationInfo[i].Object;
              LoadList[i].Name = Ckt.SubstationInfo[i].Name;
           ENDFOR;
        ELSE
           IF Ckt.FeederInfo.LastRow() = 0 AND
              Ckt.SubstationInfo.LastRow() = 0 THEN
              message 'You must add a substation/feeder before choosing a Primary Grouping.';
              RESUME;
           ENDIF;

           FOR i = 1 TO Ckt.FeederInfo.LastRow() DO
              LoadList[i].Type = Ckt.FeederInfo[i].Object;
              LoadList[i].Name = Ckt.FeederInfo[i].Name;
           ENDFOR;      
           FOR j = 1 TO Ckt.SubstationInfo.LastRow() DO
              LoadList[i].Type = Ckt.SubstationInfo[j].Object;
              LoadList[i].Name = Ckt.SubstationInfo[j].Name;
              i = i + 1;            
           ENDFOR;
        ENDIF;

    ENDIF;
    
    cl.ChoiceItems.Clear();
    i = 1;
    WHILE (i <= LoadList.LastRow()) DO
        cl.ChoiceItems[i].EnumValue = LoadList[i].Type;
        cl.ChoiceItems[i].EnumText = LoadList[i].Name;
        i = i + 1;
    ENDWHILE;

    FIELD(TypeStack.TheTypeList).ValueList = cl.Duplicate();
    FIELD(TypeStack.TheTypeList).UpdChoiceList();

/*
**  Default to the current type
*/
    IF (CalledFrom like '%functionareaname%') THEN
        TypeStack.TheTypeList = Ckt.FunctionArea;
    ENDIF;
        
    Curframe.Curmode = FM_READ;
    Curframe.Flush();
    FIELD(TypeStack).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
    FIELD(TypeStack).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop;
    FIELD(TypeStack).CurBias = FB_CHANGEABLE;
    Curframe.Flush();
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END; 

ON CLICK TypeStack.OK_Btn =
BEGIN
/*
**  Place the chosen value into the appropriate field
*/
    IF (CalledFrom like '%functionareaname%') THEN
        Ckt.FunctionArea = FIELD(TypeStack.TheTypeList).CurEnumValue;
        Ckt.FunctionAreaName = FIELD(TypeStack.TheTypeList).CurEnumText;
        FIELD(Ckt.FunctionAreaName).IsCurField = FALSE;
    ELSEIF (CalledFrom like '%primarygroupingname%') THEN
        Ckt.CircuitInfo.PrimaryGrouping = FIELD(TypeStack.TheTypeList).CurEnumValue;
        Ckt.CircuitInfo.PrimaryGroupingName = FIELD(TypeStack.TheTypeList).CurEnumText;
        FIELD(Ckt.CircuitInfo.PrimaryGroupingName).IsCurField = FALSE;
    ENDIF;

    FIELD(TypeStack).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
/*
**  Make the focus automatically go to the circuit name
*/
    Curframe.InputFocusField = FIELD(Ckt.CircuitInfo.Name);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;


ON ENTRY Ckt.CarrierInfo.Name,
ON ENTRY Grouper.Name,
ON ENTRY Grouper.TypeName,
ON CLICK Add_Sub,
ON CLICK Add_Feeder =
BEGIN
    CalledFrom = Curframe.TriggerField.FullName;

    Curframe.CurMode = FM_READ;
    FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList[*].Description).CurBias = FB_INVISIBLE;
    Curframe.Flush();

    IF (CalledFrom like '%grouper%name%') THEN
        Obj.TheObjectList = GrouperList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Grouper';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXRight = FIELD(Grouper.TypeName).AbsXRight;
        FIELD(Obj).AbsYBottom = FORMFIELD(Curframe.TriggerField).AbsYBottom;
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        Obj.TheObjectList = CompanyList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Carrier';
        FIELD(Obj).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
        FIELD(Obj).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop - 1000;
    ELSEIF (CalledFrom like '%add_sub%') THEN
        Obj.TheObjectList = StnList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Substation';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXLeft = FIELD(Ckt.SubstationInfo).AbsXLeft;
        FIELD(Obj).AbsYBottom = FIELD(Ckt.SubstationInfo).AbsYBottom;
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        Obj.TheObjectList = FdrList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Feeder/Network';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXRight = FIELD(Ckt.FeederInfo).AbsXRight;
        FIELD(Obj).AbsYBottom = FIELD(Ckt.FeederInfo).AbsYBottom;
    ENDIF;

    FIELD(Obj).CurBias = FB_CHANGEABLE;
    FIELD(Obj.TheObjectList).UpdField();
    Curframe.Flush();
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END; 

ON ENTRY Ckt.CircuitInfo.TypeName =
BEGIN
   FIELD(tab).CurBias = FB_CHANGEABLE;
   Curframe.Flush();
   FIELD(tab).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
   FIELD(tab).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop;
   tab.tbl.TheObjectList = CktTypeList.Duplicate();     
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;   
END;

ON CLICK Associated_sf.Add_Btn = 
BEGIN
/*
**  Select a list of all circuits
*/
    LoadCircuit = CALLFRAME SelectCircuit();

    IF LoadCircuit.Circuit = No$Value THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       FOR i = 1 TO Associated_sf.Circuits.LastRow() DO
          IF Associated_sf.Circuits[i].Object = LoadCircuit.Circuit THEN
             message 'This circuit is already in the list.';
             RESUME;
          ENDIF;
       ENDFOR; 
       i = Associated_sf.Circuits.LastRow() + 1;
       Associated_sf.Circuits[i].Object   = LoadCircuit.Circuit;
       Associated_sf.Circuits[i].Name     = LoadCircuit.LineNumber;
       Associated_sf.Circuits[i].Type     = LoadCircuit.LineType;
       Associated_sf.Circuits[i].TypeName = LoadCircuit.LineTypeName;
    ENDIF;
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

ON CLICK Associated_sf.Delete_Btn =
BEGIN
    Chosen = FIELD(Associated_sf.Circuits).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a circuit to delete.';
        RESUME;
    ENDIF;

    Associated_sf.Circuits.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

/*
** Call frame to view the equipment at the selected substation
*/
ON ChildProperties Ckt.SubstationInfo[*].Name =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
    i = FIELD(Ckt.SubstationInfo).WhichRow (cellfield = CurFrame.TriggerField);
    CALLFRAME AlterTCEquipType (Circuit = Ckt.CircuitInfo,
                                Substation = Ckt.SubstationInfo[i]);
END;


ON CHILDENTRY Obj.TheObjectList[*].Name,
ON CHILDENTRY Obj.TheObjectList[*].Description,
ON CHILDENTRY Obj.TheObjectList[*].TypeName =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    Chosen = FIELD(Obj.TheObjectList).CurRow;
/*
**  Put the information into the appropriate place
*/
    IF (CalledFrom like '%grouper%name%') THEN
        Grouper.Object = Obj.TheObjectList[Chosen].Object;
        Grouper.Name = Obj.TheObjectList[Chosen].Name;
        Grouper.Type = Obj.TheObjectList[Chosen].Type;
        Grouper.TypeName = Obj.TheObjectList[Chosen].TypeName;
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        Ckt.CarrierInfo.Object = Obj.TheObjectList[Chosen].Object;
        Ckt.CarrierInfo.Name = Obj.TheObjectList[Chosen].Name;
        Ckt.CarrierInfo.Type = Obj.TheObjectList[Chosen].Type;
        Ckt.CarrierInfo.TypeName = Obj.TheObjectList[Chosen].TypeName;

        IF Ckt.CarrierInfo.Object = Company$Verizon THEN
           FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_CHANGEABLE;
           FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_CHANGEABLE;
           Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
        ELSE
           IF FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias <> FB_INVISIBLE THEN
              Ckt.CircuitInfo.CreatedBy = '';
              FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_INVISIBLE;
              FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_INVISIBLE;
           ENDIF;
        ENDIF;
        CurFrame.IsAutoSized = TRUE;
        CurFrame.Flush();   
    ELSEIF (CalledFrom like '%add_sub%') THEN
        NewRow = Ckt.SubstationInfo.LastRow() + 1;
        Ckt.SubstationInfo[NewRow].Object = Obj.TheObjectList[Chosen].Object;
        Ckt.SubstationInfo[NewRow].Name = Obj.TheObjectList[Chosen].Name;
        Ckt.SubstationInfo[NewRow].Type = Obj.TheObjectList[Chosen].Type;
        Ckt.SubstationInfo[NewRow].TypeName = Obj.TheObjectList[Chosen].TypeName;
    /*
    **  Determine the next highest reference number
    */
        HighRef = 0;
        i = 1;
        WHILE (i <= Ckt.SubstationInfo.LastRow()) DO
            IF (Int4(Ckt.SubstationInfo[i].Status) > HighRef) THEN
                HighRef = int4(Ckt.SubstationInfo[i].Status);
            ENDIF; 
            i = i + 1;
        ENDWHILE;
        HighRef = HighRef + 1;
        Ckt.SubstationInfo[NewRow].Status = varchar(HighRef);
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        NewRow = Ckt.FeederInfo.LastRow() + 1;
        Ckt.FeederInfo[NewRow].Object = Obj.TheObjectList[Chosen].Object;
        Ckt.FeederInfo[NewRow].Name = Obj.TheObjectList[Chosen].Name;
        Ckt.FeederInfo[NewRow].Type = Obj.TheObjectList[Chosen].Type;
        Ckt.FeederInfo[NewRow].TypeName = Obj.TheObjectList[Chosen].TypeName;

    ENDIF;

    FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList[*].Description).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList).UpdField();
    Curframe.Flush();
    FIELD(Obj).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
END;

ON CLICK Obj.Find_Btn =
BEGIN
    SearchName = '%' + Obj.FindName + '%';    

    SearchList.Clear();
    ReducedList.Clear();
    IF (CalledFrom like '%grouper%name%') THEN
        SearchList = GrouperList.Duplicate();
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        SearchList = CompanyList.Duplicate();
    ELSEIF (CalledFrom like '%add_sub%') THEN
        SearchList = StnList.Duplicate();
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        SearchList = FdrList.Duplicate();
    ELSEIF (CalledFrom like '%typename%') THEN
        SearchList = CktTypeList.Duplicate();
    ENDIF;

    i = 1;
    j = 1;
    WHILE (i <= SearchList.LastRow()) DO
        IF (Uppercase(SearchList[i].Name) like Uppercase(SearchName)) THEN
            ReducedList[j] = SearchList[i].Duplicate();
            j = j + 1;
        ENDIF;
        i = i + 1;
    ENDWHILE;
    Obj.TheObjectList = ReducedList.Duplicate();
    FIELD(Obj.TheObjectList).UpdField();
END;

ON CLICK Obj.Cancel_Btn =
BEGIN
    FIELD(Obj).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
END;

ON CLICK Delete_Sub =
BEGIN
    Chosen = FIELD(Ckt.SubstationInfo).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a substation to delete.';
        RESUME;
    ENDIF;
    /* Make them reselect the Primary Grouping */
    IF Ckt.Substationinfo[Chosen].Object = Ckt.CircuitInfo.PrimaryGrouping THEN
       Ckt.CircuitInfo.PrimaryGrouping = 0;
       Ckt.CircuitInfo.PrimaryGroupingName = '';
    ENDIF;
    
    Ckt.SubstationInfo.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

ON CLICK Delete_Feeder =
BEGIN
    Chosen = FIELD(Ckt.FeederInfo).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a feeder to delete.';
        RESUME;
    ENDIF;

    IF Ckt.Feederinfo[Chosen].Object = Ckt.CircuitInfo.PrimaryGrouping THEN
       Ckt.CircuitInfo.PrimaryGrouping = 0;
       Ckt.CircuitInfo.PrimaryGroupingName = '';
    ENDIF;

    Ckt.FeederInfo.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;
    
ON CLICK Replace_Btn =
DECLARE
  RouteChange = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    IF FIELD(Ckt).HasDataChanged = TRUE OR
       btn_Clicked = TRUE THEN
       Ckt.CircuitInfo.ValidatedBy = '';
    ENDIF;

    IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
       Ckt.CircuitInfo.Validated = 'now';
    ELSE
       IF DOp.Type = Type$PersonDO THEN
          Ckt.CircuitInfo.Validated = 'now';
          Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
       ELSE
          Ckt.CircuitInfo.Validated = NULL;
       ENDIF;
    ENDIF;
    IF Ckt.CircuitInfo.PrimaryGrouping = 0 THEN
       message 'Please enter a Primary Grouping for the circuit.';
       RESUME;
    ENDIF;
/*
**  Replace all object and telephone circuit information
*/
    RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Ckt.CircuitInfo.Type,
                PrimaryGrouping = Ckt.CircuitInfo.PrimaryGrouping,
                TypeName = Ckt.CircuitInfo.TypeName,
                PrimaryGroupingName = Ckt.CircuitInfo.PrimaryGroupingName,
                Name = Ckt.CircuitInfo.Name,
                Description = Ckt.CircuitInfo.Description,
                Comment = Ckt.CircuitInfo.Comment,
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while updating circuit object information.';
        RESUME;
    ENDIF;

    RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen,
                AltLineType1 = Ckt.AltLineType1,
                AltLine1 = Ckt.AltLine1,
                AltLineType2 = Ckt.AltLineType2,
                AltLine2 = Ckt.AltLine2,
                RTUCircuitType = Ckt.RTUCircuitType);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while updating circuit information.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;

/*
** Update routes.
*/
   RouteChange = FALSE;
   FOR i = 1 TO OldRouteList.LastRow DO
      RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = OldRouteList[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteDel (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = OldRouteList[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;
         RouteChange = TRUE;                                                        
      ENDIF;   
   ENDFOR;

   FOR i = 1 TO RTP.RL.LastRow DO
      RetCode = OldRouteList.Find(AttributeName = 'type',
                                  Value = RTP.RL[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteIns (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = RTP.RL[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT; 
         RouteChange = TRUE;                                                       
      ENDIF;   
   ENDFOR;
 
   IF RouteChange = TRUE THEN
      /* raise event to soa_event_manager */
      CALLPROC DDB_RaiseDBEvent(DBEventName = 'TC_CardRouteUpd',
                             DBEventText = VARCHAR(Ckt.CircuitInfo.Object));
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  IF Verizon format update is needed do it.
*/
    IF Ckt.CircuitInfo.CreatedBy <> CurVerizonName THEN
       IF Ckt.CarrierInfo.Object <> Company$Verizon THEN
          RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Failed to remove the Verizon format.';
          ENDIF;
       ELSE
          RetCode = CALLPROC TC_VerizonCircuitIns(
               Circuit = CurrentCircuit.Circuit,
               LineName = Ckt.CircuitInfo.CreatedBy);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Failed to save the new line number in Verizon format.';
          ENDIF;
       ENDIF;
    ENDIF;
/*
**  Replace all grouping information
*/
    /* delete and insert carrier information */
    RetCode = CALLPROC Udb_GroupingDel (
                Grouping = CurCarrier.Object,
                Member = CurrentCircuit.Circuit,
                Relationship = Interaction$ProvidedBy);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while deleting carrier information.';
        RESUME;
    ENDIF;

    RetCode = CALLPROC Udb_GroupingIns (
                SystemVersion = 1,
                Grouping = Ckt.CarrierInfo.Object,
                GroupingType = Ckt.CarrierInfo.Type,
                Relationship = Interaction$ProvidedBy,
                MemberType = Ckt.CircuitInfo.Type,
                Member = Ckt.CircuitInfo.Object);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while inserting carrier information.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;  


    /* delete and insert grouper information */
    RetCode = CALLPROC Udb_GroupingDel (
                Grouping = CurGrouper.Object,
                Member = CurrentCircuit.Circuit,
                Relationship = Interaction$MemberOf);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while deleting grouper information.';
        RESUME;
    ENDIF;

    IF Grouper.Object > 0 THEN
        RetCode = CALLPROC Udb_GroupingIns (
                SystemVersion = 1,
                Grouping = Grouper.Object,
                GroupingType = Grouper.Type,
                Relationship = Interaction$MemberOf,
                MemberType = Ckt.CircuitInfo.Type,
                Member = Ckt.CircuitInfo.Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting grouper information.';
            RESUME;
        ENDIF;
    ENDIF;
    CALLPROC DDB_COMMIT;  

    /* delete the circuits associated with grouper and insert the new ones */
    i = 1;
    WHILE (i <= CurAssocList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurrentCircuit.Circuit,
                    Member = CurAssocList[i].Object,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting associated circuit information.';
            RESUME;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE i <= Associated_sf.Circuits.LastRow() DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = CurrentCircuit.Circuit,
                    GroupingType = Ckt.CircuitInfo.Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Associated_sf.Circuits[i].Type,
                    Member = Associated_sf.Circuits[i].Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting associated circuit information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;

    CALLPROC DDB_COMMIT;  

    /* delete the current substation groupings and insert the new ones */
    i = 1;
    WHILE (i <= CurStnList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurStnList[i].Object,
                    Member = CurrentCircuit.Circuit,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting substation information.';
            RESUME;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE i <= Ckt.SubstationInfo.LastRow() DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = Ckt.SubstationInfo[i].Object,
                    GroupingType = Ckt.SubstationInfo[i].Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Ckt.CircuitInfo.Type,
                    Member = Ckt.CircuitInfo.Object,
                    Reference = Ckt.SubstationInfo[i].Status);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting substation information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;

    CALLPROC DDB_COMMIT;  

    /* delete the current feeder groupings and insert the new ones */
    i = 1;
    WHILE (i <= CurFdrList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurFdrList[i].Object,
                    Member = CurrentCircuit.Circuit,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting feeder/network information.';
            RESUME;
            ENDLOOP;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE (i <= Ckt.FeederInfo.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = Ckt.FeederInfo[i].Object,
                    GroupingType = Ckt.FeederInfo[i].Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Ckt.CircuitInfo.Type,
                    Member = Ckt.CircuitInfo.Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting feeder/network information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;
    CALLPROC DDB_COMMIT; 
    
    FIELD(Ckt).HasDataChanged = FALSE;
    btn_Clicked = FALSE;
END;

ON CLICK Clear_Grouper_btn = 
BEGIN
    FIELD(Grouper).SetToDefault();
END;

ON CHILDENTRY tab.tbl.TheObjectList[*].Name,
ON CHILDENTRY tab.tbl.TheObjectList[*].Description =
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   Chosen = FIELD(tab.tbl.TheObjectList).CurRow;
   SelectedType = tab.tbl.TheObjectList[Chosen].Object;
   SelectedName = tab.tbl.TheObjectList[Chosen].Name;
END;

ON SetValue tab.tree.TVF = 
DECLARE
   CurTypeObj = ObjectSummaryClass; 
ENDDECLARE
BEGIN
   TCObject.SetValueHandler();

   IF TCObject.TV.CurNode IS NULL THEN
      MESSAGE 'Please select a valid type.';
      RESUME;
   ENDIF;
   
   CurTypeObj = ObjectSummaryClass(TCObject.TV.CurNode.ClientData);
   IF CurTypeObj.Name LIKE '*%' THEN
      MESSAGE CurTypeObj.Name + ' is not a valid circuit type. ' +
              'Please pick a type without an ''*'' at the begining.';
      SelectedType = 0;
      SelectedName = '';
      RESUME;
   ENDIF;
   SelectedType = CurTypeObj.Type;
   SelectedName = CurTypeObj.Name;
END;

ON EXPANDED tab.tree.TVF =
BEGIN
    TCObject.ExpandedHandler();
END;

ON CLICK Cancel_Btn = 
BEGIN
   IF FIELD(Ckt).HasDataChanged = TRUE OR btn_Clicked = TRUE THEN
      IF CurFrame.ConfirmPopup (messagetext = 'Exit without saving data?') = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;
   RETURN;
END;

ON COLLAPSED tab.tree.TVF =
DECLARE
    CurNode = TreeNode;
ENDDECLARE
BEGIN
    CurNode = TV.TriggerNode;
END;

ON CLICK tab.tree.SS.Find_Btn = 
BEGIN
   TCObject.FindHandler(FindName = tab.tree.SS.TypeName);
END;

/*
**  Handle an ok click for tab fields.
*/
ON Click tab.tree.OK_Btn,
ON Click tab.tbl.OK_Btn =
BEGIN
   IF SelectedType = 0 THEN
      MESSAGE 'Please select a valid circuit type.';
      RESUME;
   ENDIF;

   Ckt.CircuitInfo.Type = SelectedType;
   Ckt.CircuitInfo.TypeName = SelectedName;
   FIELD(Ckt.CircuitInfo.Name).IsCurField = FALSE;
   /*
   **  Get CSO Report type
   */
   SELECT :Ckt.CircuitInfo.Status = T.Name
   FROM    Udb_Type T,
           Udb_SuperType ST,
           Udb_Supertype ST2
   WHERE   T.Type = ST.SuperType AND
           ST.Type = :Ckt.CircuitInfo.Type AND
           ST.SuperType = ST2.Type AND
           ST2.SuperType = :Type$CircuitReportCategory;
   CALLPROC DDB_ROLLBACK;
   /*
   **  If Circuit Type is a Grouper Circuit, we should show
   **  the associated_sf.  Otherwise we should show the grouper
   **  stackfield.  Remember to clear whichever list doesn't 
   **  show up.  If we are changing, we can prepopulate fields
   **  with initial database values. 
   */
   i = 0;
   SELECT :i = ET.Type
   FROM    Udb_ExtendedType ET
   WHERE   SuperType = :Type$TelCardGrouper AND
           Type = :Ckt.CircuitInfo.Type;
   IF i <> 0 THEN /* Grouper circuit type */
           Associated_sf.Circuits = CurAssocList.Duplicate();
           FIELD(Associated_sf).AllBias = FB_LANDABLE;
           FIELD(Associated_sf).CurBias = FB_LANDABLE;

           FIELD(Grouper).SetToDefault();
           FIELD(Grouper).ParentField.AllBias = FB_INVISIBLE;
           FIELD(Grouper).ParentField.CurBias = FB_INVISIBLE;
        ELSE
           Grouper = CurGrouper.Duplicate();
           FIELD(Grouper).ParentField.AllBias = FB_LANDABLE;
           FIELD(Grouper).ParentField.CurBias = FB_LANDABLE;

           Associated_sf.Circuits.Clear();
           FIELD(Associated_sf).AllBias = FB_INVISIBLE;
           FIELD(Associated_sf).CurBias = FB_INVISIBLE;
   ENDIF;

   FIELD(tab).CurBias = FB_INVISIBLE;

   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();   
END;

ON Click tab.tree.Cancel_Btn,
ON Click tab.tbl.Cancel_Btn =
BEGIN
   FIELD(tab).CurBias = FB_INVISIBLE; 
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE Update_Routes(
) =
BEGIN
   FOR i = 1 TO OldRouteList.LastRow DO
      RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = OldRouteList[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteDel (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = OldRouteList[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;                                                        
      ENDIF;   
   ENDFOR;

   FOR i = 1 TO RTP.RL.LastRow DO
      RetCode = OldRouteList.Find(AttributeName = 'type',
                                  Value = RTP.RL[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteIns (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = RTP.RL[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;                                                        
      ENDIF;   
   ENDFOR;
   OldRouteList = RTP.RL.Duplicate();
END;

PROCEDURE HighlightCktRow(
) = 
DECLARE

ENDDECLARE
BEGIN
   FOR i = 1 TO Ckts.LastRow DO
      IF i = SelectedRow THEN
         FIELD(Ckts[i].LineNumber).IsReverse = TRUE;
         FIELD(Ckts[i].SubstationNames).IsReverse = TRUE;
         FIELD(Ckts[i].FeederNames).IsReverse = TRUE;
         FIELD(Ckts[i].LineTypeName).IsReverse = TRUE;
      ELSE
         FIELD(Ckts[i].LineNumber).IsReverse = FALSE;
         FIELD(Ckts[i].SubstationNames).IsReverse = FALSE;
         FIELD(Ckts[i].FeederNames).IsReverse = FALSE;
         FIELD(Ckts[i].LineTypeName).IsReverse = FALSE;      
      ENDIF;
   ENDFOR;
END;
