** ----------------------------------
**  11/02/11  ysp  Created
**  08/22/14  ysp  change SWPOutageReport.Description to SWPOutageReport.SWPDescription
**  09/18/14  ysp  for report, if a date is null, return blank(''). Move SWP level methods
**                 to SWPOutageReport class.
**  04/13/15  ysp  update CheckSWPByCard to support FMS application
**  10/16.17  em   Renaming OutageReport_ASE for interface to new OSS
*/
METHOD LoadSWPOutageReport(
) = 
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   DivName  = VARCHAR(10) NOT NULL WITH DEFAULT;
   DivNameList = VARCHAR(60) NOT NULL WITH DEFAULT;   /* List of divisions */
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   PrevIdx    = INTEGER NOT NULL WITH DEFAULT;
   PrevDiv    = INTEGER NOT NULL WITH DEFAULT;
   PrevSWP    = VARCHAR(40) NOT NULL WITH DEFAULT;
   PrevSubstn = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Status = 0 THEN  // ALL
      DynamicWhereClause = 'R.Status >= 0'; 
   ELSEIF CurObject.Status = 1 THEN // Active
      DynamicWhereClause = 'R.Status >= 0 ' + 
                           ' AND R.Status < ' + VARCHAR(Order$Closed);
   ELSE
      DynamicWhereClause = 'R.Status >= ' + VARCHAR(Order$Closed);
   ENDIF;
   
   /*
   **  Build division filter based on input parameters passed in.
   */
   If lowercase(CurObject.DivisionName) like 'all%' THEN
      /* No filter by division */
   ELSE
      DivNameList = '';
      WHILE LENGTH(CurObject.DivisionName) > 0 DO
         IF DivNameList <> '' THEN
            DivNameList = DivNameList + ',';
         ENDIF; 
         DivName= left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1));   
         DivNameList = DivNameList + DivName;

         CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
      ENDWHILE;
      DynamicWhereClause = DynamicWhereClause + ' AND R.Division IN (' + DivNameList + ')';         
   ENDIF;  

   IF CurObject.SWPNumber <> '' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND R.SWPNumber = ''' + CurObject.SWPNumber + '''';
   ENDIF;

   // outage date filter
   IF CurObject.OutageFilter = 0 THEN // Scheduled
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.SkedOutageDate BETWEEN ' + '''' + VARCHAR(CurObject.OutageStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.OutageEndDate) + '''' + ')';

   ELSEIF CurObject.OutageFilter = 1 THEN // Actual
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.ActualOutageDate BETWEEN ' + '''' + VARCHAR(CurObject.OutageStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.OutageEndDate) + '''' + ')';
   ENDIF;

   // Start date filter
   IF CurObject.StartFilter = 0 THEN // Scheduled
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.SkedStartDate BETWEEN ' + '''' + VARCHAR(CurObject.StartStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.StartEndDate) + '''' + ')';

   ELSEIF CurObject.StartFilter = 1 THEN // Actual
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.ActualStartDate BETWEEN ' + '''' + VARCHAR(CurObject.StartStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.StartEndDate) + '''' + ')';
   ENDIF;

   // Return date filter
   IF CurObject.ReturnFilter = 0 THEN // Scheduled
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.SkedReturnDate BETWEEN ' + '''' + VARCHAR(CurObject.ReturnStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.ReturnEndDate) + '''' + ')';

   ELSEIF CurObject.ReturnFilter = 1 THEN // Actual
      DynamicWhereClause = DynamicWhereClause + ' AND ' + 
             ' (R.ActualReturnDate BETWEEN ' + '''' + VARCHAR(CurObject.ReturnStartDate) + '''' + 
             ' AND ' + '''' + VARCHAR(CurObject.ReturnEndDate) + '''' + ')';
   ENDIF;

   i = 1;
   SELECT :CurObject.SWPList[i].Division = R.Division,
          :CurObject.SWPList[i].SWPNumber = R.SWPNumber,
          :CurObject.SWPList[i].Location = R.Location,
          :CurObject.SWPList[i].SWPDescription = R.SWPDescription,
          :CurObject.SWPList[i].SkedOutageDate = R.SkedOutageDate,
          :CurObject.SWPList[i].ActualOutageDate = R.ActualOutageDate,
          :CurObject.SWPList[i].ActualWorkIssueDate = R.ActualWorkIssueDate,
          :CurObject.SWPList[i].SkedStartDate = R.SkedStartDate,
          :CurObject.SWPList[i].ActualStartDate = R.ActualStartDate,
          :CurObject.SWPList[i].SkedReturnDate = R.SkedReturnDate,
          :CurObject.SWPList[i].ActualReturnDate = R.ActualReturnDate,
          :CurObject.SWPList[i].DelayReason = R.DelayReason,
          :CurObject.SWPList[i].NewOutageDate = R.NewOutageDate
   FROM   SOA_SWPOutageReport R
   WHERE  :DynamicWhereClause 
   ORDER BY Division, SWPNumber
   BEGIN
      i = i + 1;
   END;

   /*
   ** Consolidate permits that are in the same substation for each SWP
   **
   PrevDiv = -1;
   PrevSWP = '';
   PrevSubstn = -1;
   PrevIdx = -1;
   
   i = 1;
   WHILE i <= CurObject.SWPList.LastRow DO
      IF PrevDiv <> CurObject.SWPList[i].Division OR
         PrevSWP <> CurObject.SWPList[i].SWPNumber OR
         PrevSubstn <> CurObject.SWPList[i].Substation THEN

         PrevIdx = i;
         PrevDiv = CurObject.SWPList[i].Division;
         PrevSWP = CurObject.SWPList[i].SWPNumber;
         PrevSubstn = CurObject.SWPList[i].Substation;
         i = i + 1;
      ELSE
         CurObject.SWPList[PrevIdx].EquipName = CurObject.SWPList[PrevIdx].EquipName + ', ' + CurObject.SWPList[i].EquipName;
         CurObject.SWPList.RemoveRow(RowNumber = i);                  
      ENDIF;
   ENDWHILE;
   */
   RETURN;
END;

METHOD CheckSWPByCard(
   Card = INTEGER NOT NULL 
) =
DECLARE
   MultipleKVFlag = INTEGER NOT NULL WITH DEFAULT;
   SWPCount 	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SWPCount = 0;
/*
** Look for Outstanding SWP Requests based on substations in the swp work items.
*/
   IF CurrentApplication = Application$FMS THEN
      REPEATED
      SELECT   :SWPCount = COUNT(*)
      FROM     SOA_SWPOutageReport R,
               TFMS_CardToObject O
      WHERE    O.Card = :Card AND
               O.Type = :Type$Feeder AND
               O.Object = R.Feeder AND
               R.Status < :Order$Closed;
   
   ELSEIF CurrentApplication = Application$TFMS THEN
      REPEATED
      SELECT   :SWPCount = COUNT(*)
      FROM     OSS_WorkItem W,
               SOA_SWPOutageReport R,
               TFMS_CardToObject O,
               Udb_Grouping G1,
               Udb_Grouping G2,
               Udb_Object OO
      WHERE    O.Card = :Card AND
               O.Type = :Type$Substation AND
               O.Object = W.Substation AND
               W.SWPNumber = R.SWPNumber AND
               R.Feeder = 0 AND
               R.Status < :Order$Closed AND
               W.Substation = G1.Member AND
               G1.Relationship = :Interaction$Memberof AND
               G1.Grouping = G2.Member AND
               G2.Relationship = :Interaction$Memberof AND
               G2.Grouping = OO.Object AND
               OO.Type = :Type$OperatorDesk AND 
               OO.Name = :UserGroup;

   ELSEIF CurrentApplication = Application$SLC THEN
      MultipleKVFlag = 1;
      SELECT :MultipleKVFlag = MultipleKVFlag 
      FROM   SLC_Card 
      WHERE  Card = :Card;

      IF MultipleKVFlag = 1 THEN
         SELECT :SWPCount = COUNT(*)
         FROM   SLC_Card C,
                UDB_Grouping G,
                OSS_WorkItem W,
                SOA_SWPOutageReport R        
         WHERE  C.Card = :Card AND
                C.Substation = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.Reference > 0 AND 
                G.Member = W.Substation AND
                W.SWPNumber = R.SWPNumber AND
                R.Feeder = 0 AND
                R.Status < :Order$Closed;
      ELSE
         SELECT :SWPCount = COUNT(*)
         FROM   OSS_WorkItem W,
                SOA_SWPOutageReport R, 
                SLC_Card C           
         WHERE  C.Card = :Card AND
                C.Substation = W.Substation AND
                W.SWPNumber = R.SWPNumber AND
                R.Feeder = 0 AND
                R.Status < :Order$Closed;
      ENDIF;
   ENDIF;
   RETURN (SWPCount);     
END;

