	Name:            FeederStatusUndo

/*
**
**      Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    FeederCard
**  4GL Procedure:  FeederStatusUndo
**
**  Date:       Version   Description
** ----------------------------------
** 02/04/03       ysp     created
*/ 
PROCEDURE FeederStatusUndo
(
/*
**  Passed Parameters
*/
   SourceCard = FMS_Card;   		/* parameter - current card */ 
   J = ARRAY of Job; 		        /* parameter - all Jobs of either source or destination card */ 
   Equip = INTEGER NOT NULL;
   Action = VARCHAR(10) NOT NULL;

   i = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
   JIP = JobInProgress;
   SingleFeederOnly = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF Action = 'DropSingle' OR
      Action = 'Xfer' THEN
      SingleFeederOnly = TRUE;
   ENDIF;

   i = 1;
   WHILE i <= J.LastRow() DO
      IF J[i].Equip = Equip AND
         J[i].Status = '' THEN

         IF J[i].RSComplete > date('') THEN
/*
**  Don't do anything for this job,  it is not outstanding.
*/
         ELSE
#           include   ConvertSingleToJobIP
            JIP.Card = SourceCard.Card;

            IF J[i].RSIssued > date('') THEN
               JIP.Status = Job$Restore;
               RetCode = JIP.UndoJobActions (
                                       IssueCompl = JobClass$Issue,
                                       NoEquipSt = TRUE,
                                       NoOperSt = TRUE,
                                       SingleFeederOnly = SingleFeederOnly);
               IF RetCode = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  RETURN PU_CANCEL;
               ENDIF; 
            ENDIF;
      
            IF J[i].TOComplete > date('') THEN
               JIP.Status = Job$TakeOut;
               RetCode = JIP.UndoJobActions (
                                       IssueCompl = JobClass$Complete,
                                       NoEquipSt = TRUE,
                                       NoOperSt = TRUE,
                                       SingleFeederOnly = SingleFeederOnly);

               IF RetCode = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  RETURN PU_CANCEL;
               ENDIF; 
            ENDIF;

            IF J[i].TOIssued > date('') THEN
               JIP.Status = Job$TakeOut;
               RetCode = JIP.UndoJobActions (
                                       IssueCompl = JobClass$Issue,
                                       NoEquipSt = TRUE,
                                       NoOperSt = TRUE,
                                       SingleFeederOnly = SingleFeederOnly);

               IF RetCode = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  RETURN PU_CANCEL;
               ENDIF; 
            ENDIF;

         ENDIF;  /* not restored yet */

      ENDIF;     /* equip and status check */
      i = i + 1;
   ENDWHILE;

   RETURN (PU_OK);

END;

