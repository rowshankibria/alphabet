**                      exception list of the Feeder History report.
**  06/10/04    ysp     FMS 215: Allow FMS Admin to move feeder between Valid
**                      and exception list for Feeder History report.
**  06/25/04    ysp     Group ISO+ISTA to ISL and STA+ISTA to STG.
**  09/20/04    pkw     Modify for Restoration report.
**  05/18/06    pkw     Add Temperature Variable Bogey
**  07/17/06    pkw     Add TM_BogeyEnabled to Load_BogeyLegend call.
**  07/25/06    pkw     Use Closed time for Cutin if cutin is null on FeederHistory
**  03/14/08    ysp     Add substation descriptions to the substation list.
**  07/17/08    pkw     Put outages with cutout on weekend (Fri 6 pm to Sun 6 pm)
**                      in exception bin if excludeweekend is set.
**  07/23/09    pkw     Allow filter by more kv types.
**  12/21/09    ysp     Add Load_AuditTrail method
**  02/18/10    ysp     add Unit Substations to Load_Substations method
**  11/02/10    pkw     3G Updates add new WhereClause3G.
**  09/25/11    pkw     Add code for PFSF step.
**  10/20/11    ysp     Add loading of PURS stations to Load_Substations method
**  03/20/13    pkw     Add lookup table to FeederHistory to improve performance.
**  07/29/13    pkw     FOT should behave like Auto and CIOA
**  09/22/14    pkw     Look for non-network feeders when processing networks
**  10/31/14    pkw     Add report for FOD orders.
**  12/04/14    pkw     In Load_FODReport, Filter out users that have loginname = verbal.
**                      These operators will always get orders issued verbally so they
**                      shouldn't count against the statistics. 
**  07/14/15    ysp     Add Load_SSOReport method
**  08/04/15    ysp     Add load_failedhipotfeeders
**  09/10/15    pkw     Add code for TEST operating step
**  09/20/15    pkw     Filter out expanded composite opsteps in legend
**  10/06/15    ysp     Use NRI values to filter Appendix A feeders.
**  10/20/15    em      Modify failed hot pot test select to support 27 kV
**  12/22/15    ysp     Fix SSO report query.
**  01/29/16    em      Change load_failedhipotfeeders hardcoded minimum time
**                      from 30 to 5 minutes
**  01/09/17    ysp     Include Downloaded and Acknowledged SSO orders in the SSO report.
**  07/18/17    pkw     Add Load_ManholeActivity method
**  07/26/17    em      Modification to Load_Manhole DynamicWhereClause
**  07/31/17    pkw     Add Load_ManholeList method
**  12/02/18    pkw     Add Load_tvkpi method
**  03/12/19    pkw     Filter out INSP and LOC Steps since they are part of composite step.
**  04/15/19    ysp     Add Load_MTALines method
**  07/15/19    pkw     Add Load_DOScheduledWorkData
**  08/07/19    pkw     Add return to MoveTo_TvKpiException if card not found in database
**  09/17/19    em      Add DiffDistance for FCRProtection
**  12/13/19    ysp     Add Load_HighPotHistory
**  03/17/20    ysp     Add search MTA lines by feeder names
**  10/20/20    pkw     Update for TV82 report
**  12/21/20    pkw     Update select loop for tv82kpi report
**  02/14/22    pkw     Separate queries in fod/sso report for performance reasons.
**  02/15/22    pkw     Sort times by asc
**  02/14/23    ysp     Rename High Pot to 'DC' for type = 1
*/ 
METHOD Load_OutageFrequencyReport (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);
   WhereClause3G = VARCHAR(1500);
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   x = INTEGER NOT NULL;
   tot = INTEGER;
   CardFilter = ARRAY OF IntegerObject;
   DivisionWhereClause = VARCHAR(200);
   RegionName = StringObject;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   TotalFeedersOut = FLOAT NOT NULL;
   TotalOutages = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder Milestone Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Set up total column
*/
   CurObject.TList.Clear();
   tot = 1;
 
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
/*
**  Build effective division based on input parameters passed in.
*/
      
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;


      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF;  
   ENDIF;


   IF CurObject.ReportStatus = 1 OR CurObject.ReportStatus = 3 THEN
      If lowercase(CurObject.DivisionName) like 'all%' THEN
/*
**  Hardcode in regions.  If more frames will be using regions, this section should be redesigned.
*/
         RegionName.Value = 'Brooklyn/Queens';
         DivisionWhereClause = '(20003,20005)';
#        include LoadOutageFrequencyData


         RegionName.Value = 'Manhattan';
         DivisionWhereClause = '(20004)';
#        include LoadOutageFrequencyData
 
         RegionName.Value = 'Westchester/Bronx';
         DivisionWhereClause = '(20002,20007)';
#        include LoadOutageFrequencyData


         RegionName.Value = 'Staten Island';
         DivisionWhereClause = '(20006)';
#        include LoadOutageFrequencyData


      ELSE         
         k = 1;
         WHILE k <= EffectiveDivisions.LastRow() DO
            REPEATED
            SELECT :RegionName.Value = O.Name
            FROM    Udb_Object O
            WHERE   O.Object = :EffectiveDivisions[k].Object;
            
            DivisionWhereClause = '(' + VARCHAR(EffectiveDivisions[k].Object) + ')';


#           include LoadOutageFrequencyData


            k = k + 1;
         ENDWHILE;
      ENDIF;
   ELSEIF CurObject.ReportStatus = 2 THEN
      RegionName.Value = '';
      DivisionWhereClause = '(';
      i = 1;
      WHILE i <= EffectiveDivisions.LastRow() DO
 
         IF i = EffectiveDivisions.LastRow() THEN
            DivisionWhereClause = DivisionWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';
         ELSE
            DivisionWhereClause = DivisionWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';
         ENDIF;


         i = i + 1;
      ENDWHILE;


#     include LoadOutageFrequencyData
   ENDIF;
/*
**  If we have data for the last row of the summary table, we need to 
**  calculate the totals.
*/
   IF CurObject.ReportStatus = 1 OR CurObject.ReportStatus = 3 THEN
      CurObject.TList[tot].DivisionName = 'Total:';


      IF CurObject.ReportStatus = 1 THEN   
         i = 1;
         WHILE i < tot DO
            CurObject.TList[tot].Feeder = CurObject.TList[tot].Feeder + CurObject.TList[i].Feeder;
            CurObject.TList[tot].Outages = CurObject.TList[tot].Outages + CurObject.TList[i].Outages;
            CurObject.TList[tot].TotalFeeders = CurObject.TList[tot].TotalFeeders + CurObject.TList[i].TotalFeeders;
            i = i + 1;
         ENDWHILE;
   
         CurObject.TList[tot].OutageRate = CurObject.TList[tot].Outages / float8(CurObject.TList[tot].Feeder);
         CurObject.TList[tot].FrequencyIndex = CurObject.TList[tot].Outages / float8(CurObject.TList[tot].TotalFeeders); 


      ELSEIF CurObject.ReportStatus = 3 THEN
         i = 1;
         WHILE i < tot DO
            CurObject.TList[tot].Feeder = CurObject.TList[tot].Feeder + CurObject.TList[i].Feeder;
            CurObject.TList[tot].One = CurObject.TList[tot].One + CurObject.TList[i].One;
            CurObject.TList[tot].Two = CurObject.TList[tot].Two + CurObject.TList[i].Two;
            CurObject.TList[tot].Three = CurObject.TList[tot].Three + CurObject.TList[i].Three;
            CurObject.TList[tot].Four = CurObject.TList[tot].Four + CurObject.TList[i].Four;
            CurObject.TList[tot].Five = CurObject.TList[tot].Five + CurObject.TList[i].Five;
            CurObject.TList[tot].Six = CurObject.TList[tot].Six + CurObject.TList[i].Six;
            i = i + 1;
         ENDWHILE;
      ENDIF;
/*
**  Clear out DList array so we aren't sending extra data over the intranet.  It is only
**  returned if CurObject.ReportStatus = 2.
*/
      CurObject.DList.Clear();
   ENDIF;
   RETURN;
END;




METHOD Load_FeederActivityReport (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   WhereClause3G = VARCHAR(1500);
   DynamicWhereClause = VARCHAR(1500);
   DivisionWhereClause = VARCHAR(200);
   RowWhereClause = VARCHAR(200);
   SubTypeWhereClause = VARCHAR(200);
   OutageWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardFilterWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   TotalWhereClause = VARCHAR(1500);
   TotalWhereClause3G = VARCHAR(1500);
   SimpleOSS = FMS_MgtReports_ASE DEFAULT NULL;
   TempCutout = integer;


   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   oas = INTEGER NOT NULL;
   LastRow = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder Activity Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
   IF CurObject.Feeder = 0 AND
      CurObject.NetWork = 0 AND
      CurObject.Substation = 0 THEN
      RowWhereClause = 'O.Object IN (';
   ENDIF;


/*
**  If Substation or Network were passed in we do not need to
**  put divisions in DynamicWhereClause or in RowWhereClause.
*/
   IF CurObject.NetWork = 0 AND 
      CurObject.Substation = 0 THEN
      
      DivisionWhereClause = ''; /* Used for Row and Dynamic WhereClause */


      IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
         If lowercase(CurObject.DivisionName) like 'all%' THEN
            /*
            **  Load Division table
            */
            IF SimpleDivision IS NULL THEN
               SimpleDivision = Division_ASE.Create();
            ENDIF;
         
            SimpleDivision.LoadDivisions();
         
            IF SimpleDivision.ReturnCode = 0 THEN
               i = 1;
               WHILE i <= SimpleDivision.Dlist.LastRow() DO
                  EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
                  i = i + 1;
               ENDWHILE;
            ELSE
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
               SimpleDivision = NULL;
               RETURN;
            ENDIF;
            SimpleDivision = NULL;
            
         ELSE
            IF CurObject.Division <> 0 THEN
               EffectiveDivisions[1].Object = CurObject.Division;
            ELSE
               i = 1;
               WHILE LENGTH(CurObject.DivisionName) > 0 DO
                  CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
                  EffectiveDivisions[i].Object = CurObject.Division;
                  i = i + 1;
                  CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
               ENDWHILE;
            ENDIF;  
            
         ENDIF;
      ENDIF;


      i = 1;
      WHILE i <= EffectiveDivisions.LastRow() DO
 
         IF i = EffectiveDivisions.LastRow() THEN
            DivisionWhereClause = DivisionWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';
         ELSE
            DivisionWhereClause = DivisionWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';
         ENDIF;
         i = i + 1;
      ENDWHILE;


      RowWhereClause = RowWhereClause + DivisionWhereClause;
   ENDIF;
/*
**  Get all card types from database
*/
   CurObject.TypeList.Clear();
   CurObject.TypeList[1].Name = '';
   CurObject.TypeList[2].Name = 'Total';
   CurObject.TypeList[3].Name = 'YES';
   CurObject.TypeList[4].Name = 'NO';
   i = 5;
/*
**  Load Type List
*/
   IF SimpleOSS IS NULL THEN
      SimpleOSS = FMS_MgtReports_ASE.Create();
   ENDIF;
   
   SimpleOSS.LoadReportCardTypes();
   
   IF SimpleOSS.ReturnCode = 0 THEN
      FOR j = 1 TO SimpleOSS.OSS.LastROW() DO
         CurObject.TypeList[i].Name = SimpleOSS.OSS[j].CardClassName;
         i = i + 1;
      ENDFOR;
   ELSE
      Message SimpleOSS.ErrorMessage;
      SimpleOSS = NULL;
      RETURN;
   ENDIF;
   SimpleOSS = NULL;


/*
**  Get all divisions from database
*/
   CurObject.RowName.Clear();
   CurObject.RowName[1].Name = '';
   i = 2;
   IF CurObject.Feeder <> 0 THEN
      SELECT  :CurObject.RowName[i].Name = O.Name
      FROM    Udb_Object O
      WHERE   O.Object = :CurObject.Feeder
      BEGIN
         i = i + 1;
      END;
      CurObject.RowName[i].Name = 'Total';   
   ELSEIF CurObject.Network <> 0 THEN
      SELECT  :CurObject.RowName[i].Name = O.Name
      FROM    Udb_Object O
      WHERE   O.Object = :CurObject.Network
      BEGIN
         i = i + 1;
      END;
      CurObject.RowName[i].Name = 'Total';   
      
   ELSEIF CurObject.Substation <> 0 THEN
      SELECT  :CurObject.RowName[i].Name = O.Name
      FROM    Udb_Object O
      WHERE   O.Object = :CurObject.Substation
      BEGIN
         i = i + 1;
      END;
      CurObject.RowName[i].Name = 'Total';   
      
   ELSE
      SELECT  :CurObject.RowName[i].Name = O.Name
      FROM    Udb_Object O
      WHERE  :RowWhereClause
      BEGIN
         i = i + 1;
      END;
      CurObject.RowName[i].Name = 'Total';   
   ENDIF;
   CALLPROC DDB_ROLLBACK;
 
#  include MgtRpt_SelectClause


   IF CurObject.Feeder <> 0 THEN
      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'CTO.Object = ' + VARCHAR(:CurObject.Feeder);


   ELSEIF CurObject.Network <> 0 THEN
      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
          'CTO.Object = G.Member AND G.Relationship = ' +
          VARCHAR(:Interaction$MemberOf) + ' AND G.Grouping = ' +
          VARCHAR(:CurObject.NetWork) + ' AND G.Grouping = O.Object';    


   ELSEIF CurObject.Substation <> 0 THEN
      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
          'CTO.Object = O.Object AND O.PrimaryGrouping = ' +
          VARCHAR(:CurObject.Substation);     


   ELSE
      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
         ' AND O.PrimaryGrouping IN ( '; 


      WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'CTO.Object = O.Object ' +
         ' AND O.PrimaryGrouping IN ( '; 
   ENDIF;


   IF CurObject.Feeder <> 0 THEN
      TotalWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
           'CTO.Object = ' + VARCHAR(:CurObject.Feeder);
   ELSEIF CurObject.NetWork <> 0 THEN
      TotalWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause +
           ' AND CTO.Object = G.Member AND G.Relationship = ' +
           VARCHAR(:Interaction$MemberOf) + ' AND G.Grouping = ' + VARCHAR(:CurObject.Network);
   ELSEIF CurObject.Substation <> 0 THEN
      TotalWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause +
           ' AND CTO.Object = O.Object AND O.PrimaryGrouping = ' +
           VARCHAR(:CurObject.Substation);


   ELSE
      TotalWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
           'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
           ' AND O.PrimaryGrouping IN ( ' + DivisionWhereClause;


      TotalWhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
           'CTO.Object = O.Object ' +
           ' AND O.PrimaryGrouping IN ( ' + DivisionWhereClause;
   ENDIF;


/*
**  If Substation or Network were passed in we do not need to
**  put divisions in DynamicWhereClause or in RowWhereClause.
*/
   IF CurObject.NetWork = 0 AND 
      CurObject.Substation = 0 AND
      CurObject.Feeder = 0 THEN
      
      DynamicWhereClause = DynamicWhereClause + DivisionWhereClause;
      WhereClause3G = WhereClause3G + DivisionWhereClause;
   ENDIF;


/*
**  Get values for matrix
*/
   CurObject.DList.Clear();
   i = 1;


   IF CurObject.NetWork <> 0 THEN
      SELECT   :CurObject.DList[i].CardClassName = C.CardClassName,
               :CurObject.Dlist[i].Card = C.Card,
               :CurObject.Dlist[i].CutOut = C.CutOut,
               :CurObject.Dlist[i].DivisionName = O.Name
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Grouping G,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               O.Name 
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Grouping G,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.Dlist[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.Dlist[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.Dlist[i].CutOut > '' THEN
             i = i + 1;
         ELSE
             CurObject.Dlist.RemoveRow (rownumber = i);
         ENDIF;
      END;
   
   ELSEIF CurObject.Substation <> 0 THEN
      SELECT   :CurObject.Dlist[i].CardClassName = C.CardClassName,
               :CurObject.Dlist[i].Card = C.Card,
               :CurObject.Dlist[i].CutOut = C.CutOut,
               :CurObject.Dlist[i].DivisionName = O.PrimaryGroupingName
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               O.PrimaryGroupingName 
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.Dlist[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.Dlist[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.Dlist[i].CutOut > '' THEN
             i = i + 1;
         ELSE
             CurObject.Dlist.RemoveRow (rownumber = i);
         ENDIF;
      END;


   ELSEIF CurObject.Feeder <> 0 THEN
      SELECT   :CurObject.Dlist[i].CardClassName = C.CardClassName,
               :CurObject.Dlist[i].Card = C.Card,
               :CurObject.Dlist[i].CutOut = C.CutOut,
               :CurObject.Dlist[i].DivisionName = C.FeederName
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               C.FeederName 
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.Dlist[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.Dlist[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.Dlist[i].CutOut > '' THEN
             i = i + 1;
         ELSE
             CurObject.Dlist.RemoveRow (rownumber = i);
         ENDIF;
      END;
  
   ELSE
      SELECT   :CurObject.Dlist[i].CardClassName = C.CardClassName,
               :CurObject.Dlist[i].Card = C.Card,
               :CurObject.Dlist[i].CutOut = C.CutOut,
               :CurObject.Dlist[i].DivisionName = O.PrimaryGroupingName
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Object OO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause


      UNION
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               O.PrimaryGroupingName 
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :WhereClause3G


      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               O.PrimaryGroupingName 
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Object OO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :DynamicWhereClause


      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut,
               O.PrimaryGroupingName 
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :WhereClause3G


      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.Dlist[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.Dlist[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.Dlist[i].CutOut > '' THEN
             i = i + 1;
         ELSE
             CurObject.Dlist.RemoveRow (rownumber = i);
         ENDIF;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
/*
**  For all Auto Card types, get schd info. 
*/
   CurObject.TList.Clear();
   k = 1;
   LastRow = CurObject.Dlist.LastRow();
   j = LastRow + 1;
   FOR i = 1 TO LastRow DO
      IF CurObject.Dlist[i].CardClassName = 'Auto' OR
         CurObject.Dlist[i].CardClassName = 'CIOA' THEN
         OAS = 0;
         REPEATED 
         SELECT :OAS = COUNT(*)
         FROM    FMS_CardTypeFilter
         WHERE   Card = :CurObject.Dlist[i].Card;
         IF OAS = 0 THEN /* No Schd work done */
            CurObject.Dlist[j].CardClassName = 'NO';
            CurObject.Tlist[k].CardClassName = 'NO';
         ELSE            /* Schd work done */
            CurObject.Dlist[j].CardClassName = 'YES';
            CurObject.Tlist[k].CardClassName = 'YES';
         ENDIF;
         CurObject.Dlist[j].Card = CurObject.Dlist[i].Card;
         CurObject.Dlist[j].CutOut = CurObject.Dlist[i].CutOut;
         CurObject.Dlist[j].DivisionName = CurObject.Dlist[i].DivisionName;


         CurObject.Tlist[k].Card = CurObject.Dlist[i].Card;
         CurObject.Tlist[k].CutOut = CurObject.Dlist[i].CutOut;
         j = j + 1;
         k = k + 1;
      ENDIF;
   ENDFOR;
/*
**  Get totals for card types
*/
   i = CurObject.Tlist.LastRow() + 1; /* start counting i from where k left off above */
   IF CurObject.Network <> 0 THEN
      SELECT   :CurObject.TList[i].CardClassName = C.CardClassName,
               :CurObject.TList[i].Card = C.Card,
               :CurObject.TList[i].CutOut = C.CutOut
      FROM     FMS_Card C,
               Udb_Grouping G,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause 
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_ArchiveCard C,
               Udb_Grouping G,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.TList[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.TList[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.TList[i].CutOut > '' THEN
            i = i + 1;
         ELSE
            CurObject.TList.RemoveRow (rownumber = i);
         ENDIF;
      END;


   ELSEIF CurObject.Substation <> 0 THEN /* have to go to grouping table */
      SELECT   :CurObject.TList[i].CardClassName = C.CardClassName,
               :CurObject.TList[i].Card = C.Card,
               :CurObject.TList[i].CutOut = C.CutOut
      FROM     FMS_Card C,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_ArchiveCard C,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.TList[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.TList[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.TList[i].CutOut > '' THEN
            i = i + 1;
         ELSE
            CurObject.TList.RemoveRow (rownumber = i);
         ENDIF;
      END;
   ELSEIF CurObject.Feeder <> 0 THEN 
      SELECT   :CurObject.TList[i].CardClassName = C.CardClassName,
               :CurObject.TList[i].Card = C.Card,
               :CurObject.TList[i].CutOut = C.CutOut
      FROM     FMS_Card C,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause
      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_ArchiveCard C,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause
      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.TList[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.TList[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.TList[i].CutOut > '' THEN
            i = i + 1;
         ELSE
            CurObject.TList.RemoveRow (rownumber = i);
         ENDIF;
      END;
   ELSE
      SELECT   :CurObject.TList[i].CardClassName = C.CardClassName,
               :CurObject.TList[i].Card = C.Card,
               :CurObject.TList[i].CutOut = C.CutOut
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Object OO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause


      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_Card C,
               TFMS_CardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause3G


      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Object OO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause


      UNION 
      SELECT   C.CardClassName,
               C.Card,
               C.CutOut
      FROM     FMS_ArchiveCard C,
               TFMS_ArchiveCardToObject CTO,
               Udb_Object O,
               Udb_Grouping GR,
               Udb_Rating R
      WHERE   :TotalWhereClause3G


      ORDER BY CardClassName
      BEGIN
         TempCutout = (date_part('hour',date(CurObject.TList[i].Cutout)) * 100) +
                      date_part('min',date(CurObject.TList[i].Cutout));
         IF (TempCutout >= CurObject.StartTimeInt and TempCutout <= CurObject.EndTimeInt) AND
             CurObject.TList[i].CutOut > '' THEN
            i = i + 1;
         ELSE
            CurObject.TList.RemoveRow (rownumber = i);
         ENDIF;
      END;
   ENDIF;
   CurObject.TotalCards = i - k;
   CALLPROC DDB_ROLLBACK;


   RETURN;
END;


METHOD Load_ManholeActivity (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);


   DM_TO_WC = VARCHAR(1500);
   DM_RS_WC = VARCHAR(1500);


   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   OldJob = INTEGER NOT NULL;
   OldDivision = INTEGER NOT NULL;
   OldStatus = INTEGER NOT NULL;
   OldTORS = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Disconnecting Manhole operations
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Need two different Where Clauses.  Each one is slightly different. 
*/
   DM_TO_WC = ' (J.TOComplete BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.EquipClass = ET.Type AND ' + 
          'ET.SuperType IN (20017,10449,22763,20226,22072) AND ' +
          'J.Equip = O.Object AND ' +
          'J.Card = C.Card AND ' +
          'J.JobClass = JA.JobClass AND ' +
          'J.Status = ' + '''' + '''' + ' AND ' +
          'JA.TORS = ' + VARCHAR(:Job$TakeoutInt) + ' AND ' +
          'JA.Status IN (' + VARCHAR(:Prompt$SetCurrentlyOpen) + ',' + VARCHAR(:Prompt$ClearCurrentlyOpen) + ') AND ' +
          'C.Card = CTO.Card AND ' +
          'CTO.Type = ' + VARCHAR(:Type$Feeder) + ' AND ' +
          'CTO.Object = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   DM_RS_WC = ' (J.RSComplete BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.EquipClass = ET.Type AND ' + 
          'ET.SuperType IN (20017,10449,22763,20226,22072) AND ' +
          'J.Equip = O.Object AND ' +
          'J.Card = C.Card AND ' +
          'J.JobClass = JA.JobClass AND ' +
          'J.Status = ' + '''' + '''' + ' AND ' +
          'JA.TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +
          'JA.Status IN (' + VARCHAR(:Prompt$SetCurrentlyOpen) + ',' + VARCHAR(:Prompt$ClearCurrentlyOpen) + ') AND ' +
          'C.Card = CTO.Card AND ' +
          'CTO.Type = ' + VARCHAR(:Type$Feeder) + ' AND ' +
          'CTO.Object = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   If lowercase(CurObject.DivisionName) like 'all%' THEN
      /*
      **  Load Division table
      */
      IF SimpleDivision IS NULL THEN
         SimpleDivision = Division_ASE.Create();
      ENDIF;
        
      SimpleDivision.LoadDivisions();
         
      IF SimpleDivision.ReturnCode = 0 THEN
         i = 1;
         WHILE i <= SimpleDivision.Dlist.LastRow() DO
            EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
         SimpleDivision = NULL;
         RETURN;
      ENDIF;
      SimpleDivision = NULL;
            
   ELSE
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;  
   ENDIF;
   
   DynamicWhereClause = '';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';


      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   DM_TO_WC = DM_TO_WC + DynamicWhereClause;
   DM_RS_WC = DM_RS_WC + DynamicWhereClause;


   CurObject.DList.Clear();


   i = 1;
   j = 0;
   OldJob = 0;
   OldDivision = 0;
   SELECT DISTINCT
         :CurObject.DList[i].StartTime = J.TOComplete,        
         :CurObject.DList[i].Card = C.Card,
         :CurObject.DList[i].CardClassName = C.CardClassName,
         :CurObject.DList[i].Division = O2.PrimaryGrouping,
         :CurObject.DList[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.DList[i].Feeder = C.Feeder,
         :CurObject.DList[i].FeederName = C.Feedername,
         :CurObject.DList[i].Equip = J.Equip,
         :CurObject.DList[i].EquipTypeName = J.EquipClassName,
         :CurObject.DList[i].EquipName = J.EquipName,
         :CurObject.DList[i].Status = JA.Status,
         :CurObject.DList[i].Comment = O.Comment
   FROM   FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          FMS_ArchiveJob J,
          Udb_ExtendedType ET,
          FMS_JobAction JA,
          Udb_Object O,
          Udb_Object O1,
          Udb_Object O2
   WHERE  :DM_TO_WC 


   UNION  
   SELECT DISTINCT
          J.RSComplete,        
          C.Card,
          C.CardClassName,
          O2.PrimaryGrouping,
          O2.PrimaryGroupingName,
          C.Feeder,
          C.Feedername,
          J.Equip,
          J.EquipClassName,
          J.EquipName,
          JA.Status,
          O.Comment
   FROM   FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          FMS_ArchiveJob J,
          Udb_ExtendedType ET,
          FMS_JobAction JA,
          Udb_Object O,
          Udb_Object O1,
          Udb_Object O2
   WHERE :DM_RS_WC 


   ORDER BY DivisionName, FeederName, StartTime
   BEGIN
      IF CurObject.DList[i].Status = Prompt$SetCurrentlyOpen THEN
         CurObject.DList[i].Char_Duration = 'Open';
      ELSEIF CurObject.DList[i].Status = Prompt$ClearCurrentlyOpen THEN
         CurObject.DList[i].Char_Duration = 'Close';
      ENDIF;
      i = i + 1;
   END;       
   CALLPROC DDB_ROLLBACK;
  
   RETURN;
END;


METHOD Load_ManholeList (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);


   DM_WC = VARCHAR(1500);


   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   OldJob = INTEGER NOT NULL;
   OldDivision = INTEGER NOT NULL;
   OldStatus = INTEGER NOT NULL;
   OldTORS = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Disconnecting Manhole operations
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Need two different Where Clauses.  Each one is slightly different. 
*/
   DM_WC = ' O.Type = ET.Type AND ' + 
          'ET.SuperType IN (20017,10449,22763,20226,22072) AND ' +
          'O.Object = G.Member AND ' +
          'G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
          'G.GroupingType = ' + VARCHAR(:Type$Feeder) + ' AND ' +
          'G.Grouping = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   If lowercase(CurObject.DivisionName) like 'all%' THEN
      /*
      **  Load Division table
      */
      IF SimpleDivision IS NULL THEN
         SimpleDivision = Division_ASE.Create();
      ENDIF;
        
      SimpleDivision.LoadDivisions();
         
      IF SimpleDivision.ReturnCode = 0 THEN
         i = 1;
         WHILE i <= SimpleDivision.Dlist.LastRow() DO
            EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
         SimpleDivision = NULL;
         RETURN;
      ENDIF;
      SimpleDivision = NULL;
            
   ELSE
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;  
   ENDIF;
   
   DynamicWhereClause = '';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';


      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   DM_WC = DM_WC + DynamicWhereClause;


   CurObject.DList.Clear();


    i = 1;
   j = 0;
   OldJob = 0;
   OldDivision = 0;
   SELECT DISTINCT
         :CurObject.DList[i].Division = O2.PrimaryGrouping,
         :CurObject.DList[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.DList[i].Feeder = O1.Object,
         :CurObject.DList[i].FeederName = O1.name,
         :CurObject.DList[i].Equip = O.Object,
         :CurObject.DList[i].EquipTypeName = O.TypeName,
         :CurObject.DList[i].EquipName = O.Name,
         :CurObject.DList[i].Comment = O.Comment
   FROM   Udb_ExtendedType ET,
          Udb_Grouping G,
          Udb_Object O,
          Udb_Object O1,
          Udb_Object O2
   WHERE  :DM_WC 
   ORDER BY DivisionName, FeederName
   BEGIN
      i = i + 1;
   END;       
   CALLPROC DDB_ROLLBACK;
  
   RETURN;
END;


METHOD LoadReportCardTypes (
)=
DECLARE
   i                   = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load card types to view on 
** management reports.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Load CardTypes
*/
   CurObject.OSS.Clear();
   i = 1;
   SELECT CurObject.OSS[i].CardClassName = Name,
          CurObject.OSS[i].CardClass     = Type
   FROM   Udb_Type
   WHERE  Type <> :Type$ISO AND
          Type <> :Type$CardClassTest AND
          Type IN (SELECT Type
                   FROM   Udb_ExtendedType
                   WHERE  SuperType = :Type$CardClass AND
                          Type <> :Type$CardClass)
   ORDER BY CardClassName
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No card types found in database.';
   ENDIF;
   RETURN;
END;


METHOD Load_FODReport (
   EffectiveCardTypes = ARRAY OF IntegerObject;  /* List of cardtypes */
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);


   RR_ActiveTO_WC  = VARCHAR(1500);
   RR_ArchiveTO_WC = VARCHAR(1500);
   RR_ActiveRS_WC  = VARCHAR(1500);
   RR_ArchiveRS_WC = VARCHAR(1500);
   
   V_ActiveTO_WC  = VARCHAR(1500);
   V_ArchiveTO_WC = VARCHAR(1500);
   V_ActiveRS_WC  = VARCHAR(1500);
   V_ArchiveRS_WC = VARCHAR(1500);


   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   OldJob = INTEGER NOT NULL;
   OldDivision = INTEGER NOT NULL;
   OldStatus = INTEGER NOT NULL;
   OldTORS = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with FOD electronic and verbal orders
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Need eight different Where Clauses.  Each one is slightly different. 
*/
   RR_ActiveTO_WC = ' (FO.IssueTime BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Substation = 0 AND ' +    /* Non substation equipment */
          'J.Equip <> 0 AND ' +
          'J.Job = F.Job AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'F.JobStatus >= ' + VARCHAR(:Order$ConfirmClosed) + ' AND ' +
          'F.OrderNumber = FO.OrderNumber AND ' + 
          'F.TORS = ' + VARCHAR(:Job$TakeOutInt) + ' AND ' +       /* Take out */
          'F.FODEmployeeObject = O.Object AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Job = JC.Job AND ' +
          'JC.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +
          'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' + 
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   RR_ArchiveTO_WC = ' (FO.IssueTime BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Equip = fe.equip_id AND ' +
          'J.Job = F.Job AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'F.JobStatus >= ' + VARCHAR(:Order$ConfirmClosed) + ' AND ' +
          'F.OrderNumber = FO.OrderNumber AND ' + 
          'F.TORS = ' + VARCHAR(:Job$TakeOutInt) + ' AND ' +       /* Take out */
          'F.FODEmployeeObject = O.Object AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   RR_ActiveRS_WC = ' (FO.IssueTime BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Substation = 0 AND ' +    /* Non substation equipment */
          'J.Equip <> 0 AND ' +
          'J.Job = F.Job AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'F.JobStatus >= ' + VARCHAR(:Order$ConfirmClosed) + ' AND ' +
          'F.OrderNumber = FO.OrderNumber AND ' + 
          'F.TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +       /* Restore */
          'F.FODEmployeeObject = O.Object AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Job = JC.Job AND ' +
          'JC.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +
          'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' + 
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
      
   RR_ArchiveRS_WC = ' (FO.IssueTime BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Equip = fe.equip_id AND ' +
          'J.Job = F.Job AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'F.JobStatus >= ' + VARCHAR(:Order$ConfirmClosed) + ' AND ' +
          'F.OrderNumber = FO.OrderNumber AND ' + 
          'F.TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +       /* Restore */
          'F.FODEmployeeObject = O.Object AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   V_ActiveTO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Substation = 0 AND ' +    /* Non substation equipment */
          'J.Equip <> 0 AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'J.Job NOT IN (SELECT Job ' +
                        'FROM   IR_FODOrderJobs ' + 
                        'WHERE  TORS = ' + VARCHAR(:Job$TakeOutInt) + ' AND ' +
                               'JobStatus <= ' + VARCHAR(:Order$ConfirmClosed) + ') AND ' +
          'J.TOOperator = O.Object AND ' + 
          'J.TOOperator <> 0 AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Job = JC.Job AND ' +
          'JC.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +    /* 3G feeder */
          'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' + 
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   V_ArchiveTO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Equip = fe.equip_id AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'J.Job NOT IN (SELECT Job ' +
                        'FROM   IR_FODOrderJobs ' + 
                        'WHERE  TORS = ' + VARCHAR(:Job$TakeOutInt) + ' AND ' +
                               'JobStatus <= ' + VARCHAR(:Order$ConfirmClosed) + ') AND ' +
          'J.TOOperator = O.Object AND ' + 
          'J.TOOperator <> 0 AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +    /* 3G feeder */
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   V_ActiveRS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Substation = 0 AND ' +    /* Non substation equipment */
          'J.Equip <> 0 AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'J.Job NOT IN (SELECT Job ' +
                        'FROM   IR_FODOrderJobs ' + 
                        'WHERE  TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +
                               'JobStatus <= ' + VARCHAR(:Order$ConfirmClosed) + ') AND ' +
          'J.RSOperator = O.Object AND ' + 
          'J.RSOperator <> 0 AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Job = JC.Job AND ' +
          'JC.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +    /* 3G feeder */
          'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' + 
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   V_ArchiveRS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.Equip = fe.equip_id AND ' +
          'lowercase(J.Status) <> ' + '''' + 'del' + '''' + ' AND ' +
          'J.Job NOT IN (SELECT Job ' +
                        'FROM   IR_FODOrderJobs ' + 
                        'WHERE  TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +
                               'JobStatus <= ' + VARCHAR(:Order$ConfirmClosed) + ') AND ' +
          'J.RSOperator = O.Object AND ' + 
          'J.RSOperator <> 0 AND ' +
          'O.Object = P.Object AND ' +
          'lowercase(P.LoginName) <> ' + '''' + 'verbal' + '''' + ' AND ' +
          'J.Card = C.Card AND ' +
          'C.Feeder <> -1 AND ' +    /* 3G feeder */
          'C.Feeder = O1.Object AND ' +
          'O1.PrimaryGrouping = O2.Object AND ' +
          'O2.PrimaryGrouping in ( ';
   
   If lowercase(CurObject.DivisionName) like 'all%' THEN
      /*
      **  Load Division table
      */
      IF SimpleDivision IS NULL THEN
         SimpleDivision = Division_ASE.Create();
      ENDIF;
        
      SimpleDivision.LoadDivisions();
         
      IF SimpleDivision.ReturnCode = 0 THEN
         i = 1;
         WHILE i <= SimpleDivision.Dlist.LastRow() DO
            EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
         SimpleDivision = NULL;
         RETURN;
      ENDIF;
      SimpleDivision = NULL;
            
   ELSE
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;  
   ENDIF;
   
   DynamicWhereClause = '';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';


      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   RR_ActiveTO_WC  = RR_ActiveTO_WC  + DynamicWhereClause;
   RR_ArchiveTO_WC = RR_ArchiveTO_WC + DynamicWhereClause;
   RR_ActiveRS_WC  = RR_ActiveRS_WC  + DynamicWhereClause;
   RR_ArchiveRS_WC = RR_ArchiveRS_WC + DynamicWhereClause;
   
   V_ActiveTO_WC  = V_ActiveTO_WC  + DynamicWhereClause;
   V_ArchiveTO_WC = V_ArchiveTO_WC + DynamicWhereClause;
   V_ActiveRS_WC  = V_ActiveRS_WC  + DynamicWhereClause;
   V_ArchiveRS_WC = V_ArchiveRS_WC + DynamicWhereClause;
   /*
   **  Create temporary tables
   */
   DECLARE GLOBAL TEMPORARY TABLE SESSION.stationequip 
      (Equip_id INTEGER NOT NULL) 
      ON COMMIT PRESERVE ROWS WITH NORECOVERY;


   DECLARE GLOBAL TEMPORARY TABLE SESSION.fodequip 
      (Equip_id INTEGER NOT NULL) 
      ON COMMIT PRESERVE ROWS WITH NORECOVERY;


   INSERT INTO SESSION.stationequip (Equip_id)
       SELECT O.Object
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  O.Type IN (SELECT Type
                         FROM Udb_ExtendedType
                         WHERE Supertype = :Type$Switch) AND
              O.Object = G.Member AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Substation);


   INSERT INTO SESSION.fodequip (Equip_id)
      SELECT O.Object
      FROM   Udb_Object O
      WHERE  O.Type IN (SELECT Type
                        FROM  Udb_ExtendedType
                        WHERE SuperType = :Type$Switch) AND
             O.Object NOT IN (SELECT Equip_id FROM session.stationequip);


   i = 1;
   j = 0;
   OldJob = 0;
   OldDivision = 0;
   SELECT DISTINCT
         :CurObject.FOD[i].TORS = F.TORS,        /* takeout */
         :CurObject.FOD[i].JobStatus = F.JobStatus,
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = FO.IssueTime,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.TOMove,
         :CurObject.FOD[i].RescindType = F.RescindType,
         :CurObject.FOD[i].RescindComment = F.RescindComment,
         :CurObject.FOD[i].AckRejectedComment = F.AckRejectedComment
   FROM   SOA_Job J,
          SOA_JobControl JC,
          Udb_Person P,
          Udb_Object O,
          Udb_Object O2,
          Udb_Object O1,
          FMS_Card C,
          IR_FODOrderJobs F,
          IR_FODOrder FO
   WHERE  :RR_ActiveTO_WC
   BEGIN      
      i = i + 1;
   END;


   SELECT 
         :CurObject.FOD[i].TORS = F.TORS,        
         :CurObject.FOD[i].JobStatus = F.JobStatus,
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = FO.IssueTime,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.TOMove,
         :CurObject.FOD[i].RescindType = F.RescindType,
         :CurObject.FOD[i].RescindComment = F.RescindComment,
         :CurObject.FOD[i].AckRejectedComment = F.AckRejectedComment
   FROM   FMS_ArchiveJob J,
          session.fodequip fe,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_ArchiveCard C,
          IR_FODOrderJobs F,
          IR_FODOrder FO 
   WHERE :RR_ArchiveTO_WC
   BEGIN      
      i = i + 1;
   END;


   SELECT 
         :CurObject.FOD[i].TORS = F.TORS,        
         :CurObject.FOD[i].JobStatus = F.JobStatus,
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = FO.IssueTime,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.RSMove,
         :CurObject.FOD[i].RescindType = F.RescindType,
         :CurObject.FOD[i].RescindComment = F.RescindComment,
         :CurObject.FOD[i].AckRejectedComment = F.AckRejectedComment
   FROM   SOA_Job J,
          SOA_JobControl JC,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_Card C,
          IR_FODOrderJobs F,
          IR_FODOrder FO 
   WHERE  :RR_ActiveRS_WC
   BEGIN      
      i = i + 1;
   END;


   SELECT 
         :CurObject.FOD[i].TORS = F.TORS,        
         :CurObject.FOD[i].JobStatus = F.JobStatus,
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = FO.IssueTime,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.RSMove,
         :CurObject.FOD[i].RescindType = F.RescindType,
         :CurObject.FOD[i].RescindComment = F.RescindComment,
         :CurObject.FOD[i].AckRejectedComment = F.AckRejectedComment
   FROM   FMS_ArchiveJob J,
          session.fodequip fe,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_ArchiveCard C,
          IR_FODOrderJobs F,
          IR_FODOrder FO 
   WHERE  :RR_ArchiveRS_WC
   BEGIN      
      i = i + 1;
   END;


   SELECT              /* Verbal Takeout  from Active */
         :CurObject.FOD[i].TORS = 0,           /* Takeout */        
         :CurObject.FOD[i].JobStatus = 0,      /* Verbal status complete */
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = J.TOIssued,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.TOMove,
         :CurObject.FOD[i].RescindType = '',
         :CurObject.FOD[i].RescindComment = '',
         :CurObject.FOD[i].AckRejectedComment = ''
   FROM   SOA_Job J,
          SOA_JobControl JC,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_Card C
   WHERE  :V_ActiveTO_WC
   BEGIN      
      i = i + 1;
   END;


   SELECT               /* Verbal Takeout  from Archive  */
         :CurObject.FOD[i].TORS = 0,           /* Takeout */        
         :CurObject.FOD[i].JobStatus = 0,      /* Verbal status complete */
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = J.TOIssued,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.TOMove,
         :CurObject.FOD[i].RescindType = '',
         :CurObject.FOD[i].RescindComment = '',
         :CurObject.FOD[i].AckRejectedComment = ''
   FROM   FMS_ArchiveJob J,
          session.fodequip fe,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_ArchiveCard C
   WHERE  :V_ArchiveTO_WC
   BEGIN      
      i = i + 1;
   END;
   
   SELECT             /* Verbal Restore from Active  */
         :CurObject.FOD[i].TORS = 1,           /* Takeout */        
         :CurObject.FOD[i].JobStatus = 0,      /* Verbal status complete */
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = J.RSIssued,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.RSMove,
         :CurObject.FOD[i].RescindType = '',
         :CurObject.FOD[i].RescindComment = '',
         :CurObject.FOD[i].AckRejectedComment = ''
   FROM   SOA_Job J,
          SOA_JobControl JC,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_Card C 
   WHERE  :V_ActiveRS_WC
   BEGIN      
      i = i + 1;
   END;
   
   SELECT         /* Verbal Restore from Archive */
         :CurObject.FOD[i].TORS = 1,           /* Takeout */        
         :CurObject.FOD[i].JobStatus = 0,      /* Verbal status complete */
         :CurObject.FOD[i].Division = O2.PrimaryGrouping,
         :CurObject.FOD[i].DivisionName = O2.PrimaryGroupingName,
         :CurObject.FOD[i].FeederName = C.Feedername,
         :CurObject.FOD[i].FodEmployeeName = O.Description,
         :CurObject.FOD[i].IssueTime = J.RSIssued,
         :CurObject.FOD[i].EquipClassName = J.EquipClassName,
         :CurObject.FOD[i].EquipName = J.EquipName,
         :CurObject.FOD[i].Job = J.Job,
         :CurObject.FOD[i].MoveText = J.RSMove,
         :CurObject.FOD[i].RescindType = '',
         :CurObject.FOD[i].RescindComment = '',
         :CurObject.FOD[i].AckRejectedComment = ''
   FROM   FMS_ArchiveJob J,
          session.fodequip fe,
          Udb_Person P,
          Udb_Object O2,
          Udb_Object O,
          Udb_Object O1,
          FMS_ArchiveCard C
   WHERE  :V_ArchiveRS_WC
   BEGIN      
      i = i + 1;
   END;


   CurObject.FOD.Sort(DivisionName = AS_ASC,
                      FeederName = AS_ASC,
                      IssueTime = AS_DESC
                     );


   FOR i = 1 TO CurObject.FOD.LastRow DO


      IF OldDivision <> CurObject.FOD[i].Division THEN
         j = j + 1;
         CurObject.FOD_Summary[j].Division = CurObject.FOD[i].Division;
         CurObject.FOD_Summary[j].DivisionName = CurObject.FOD[i].DivisionName;
      ENDIF;


      CurObject.FOD_Summary[j].Orders_Total = CurObject.FOD_Summary[j].Orders_Total + 1;
      
      IF CurObject.FOD[i].JobStatus = Order$ConfirmClosed THEN
         CurObject.FOD_Summary[j].Orders_Electronic = CurObject.FOD_Summary[j].Orders_Electronic + 1;
      
      ELSEIF CurObject.FOD[i].Job = OldJob AND
             CurObject.FOD[i].TORS = OldTORS THEN
         IF CurObject.FOD[i].JobStatus > Order$ConfirmClosed AND OldStatus = 0 THEN
            /* 
            ** Assume they force completed an order so we will decrement 
            ** Last Verbal and add one to electronic successful.
            ** Decrement total in this case also to keep percentages correct.
            */
            CurObject.FOD_Summary[j].Orders_Total = CurObject.FOD_Summary[j].Orders_Total - 1;
            CurObject.FOD_Summary[j].Orders_Verbal = CurObject.FOD_Summary[j].Orders_Verbal - 1;
            CurObject.FOD_Summary[j].Orders_Electronic = CurObject.FOD_Summary[j].Orders_Electronic + 1;
         ELSEIF CurObject.FOD[i].JobStatus > Order$ConfirmClosed THEN
            CurObject.FOD_Summary[j].Orders_Electronic_Fail = CurObject.FOD_Summary[j].Orders_Electronic_Fail + 1;
            /* rescind and rejected orders don't count against the total */
            CurObject.FOD_Summary[j].Orders_Total = CurObject.FOD_Summary[j].Orders_Total - 1;


         ELSE
            CurObject.FOD_Summary[j].Orders_Verbal_After = CurObject.FOD_Summary[j].Orders_Verbal_After + 1;
            CurObject.FOD[i].JobStatus = 1;
         ENDIF;
      ELSE   /* current job is different than previous */
         IF CurObject.FOD[i].JobStatus > Order$ConfirmClosed THEN
            CurObject.FOD_Summary[j].Orders_Electronic_Fail = CurObject.FOD_Summary[j].Orders_Electronic_Fail + 1;
            /* rescind and rejected orders don't count against the total */
            CurObject.FOD_Summary[j].Orders_Total = CurObject.FOD_Summary[j].Orders_Total - 1;
         ELSE
            CurObject.FOD_Summary[j].Orders_Verbal = CurObject.FOD_Summary[j].Orders_Verbal + 1;
         ENDIF;
      ENDIF;


      OldStatus = CurObject.FOD[i].JobStatus;
      OldDivision = CurObject.FOD[i].Division;
      OldJob = CurObject.FOD[i].Job;
      OldTORS = CurObject.FOD[i].TORS;
      
      IF CurObject.FOD[i].JobStatus = 0 THEN
         CurObject.FOD[i].JobStatusName = 'Verbal';
      ELSEIF CurObject.FOD[i].JobStatus = 1 THEN
         CurObject.FOD[i].JobStatusName = 'Verbal after fail';
      ELSEIF CurObject.FOD[i].JobStatus = Order$ConfirmClosed THEN
         CurObject.FOD[i].JobStatusName = 'Electronic';
      ELSEIF CurObject.FOD[i].JobStatus = Order$ConfirmRejected THEN
         CurObject.FOD[i].JobStatusName = 'Reject';
         CurObject.FOD[i].ReturnRemark = CurObject.FOD[i].AckRejectedComment;
      ELSEIF CurObject.FOD[i].JobStatus = Order$ConfirmRescinded THEN
         CurObject.FOD[i].JobStatusName = CurObject.FOD[i].RescindType + ' Rescind';
         CurObject.FOD[i].ReturnRemark = CurObject.FOD[i].Rescindcomment;
      ENDIF;
      
      i = i + 1;
   ENDFOR;       
   CALLPROC DDB_ROLLBACK;
   /*
   **  Drop temporary tables.  Don't need after rollback;
   DROP SESSION.stationequip; 
   DROP SESSION.fodequip;
   */
  
   RETURN;
END;




METHOD Load_FeederHistoryData (
   EffectiveCardTypes = ARRAY OF IntegerObject;  /* List of cardtypes */
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);
   WhereClause3G = VARCHAR(1500);
   SubTypeWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   OutageWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardFilterWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   kv_rad = INTEGER NOT NULL;     /*radio field value*/
   Outage_rad = INTEGER NOT NULL;     /*radio field value*/
   OldCard = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   SimpleOSS = FMS_MgtReports_ASE DEFAULT NULL;
   TempOS = OperatingStepStatusClass;                                         
   Total_Min = INTEGER NOT NULL;
   StartDate = DATE;
   EndDate = DATE;
   TempStart = INTEGER NOT NULL;
   TempEnd = INTEGER NOT NULL;
   MaxMinutes = INTEGER NOT NULL;
   zz = INTEGER NOT NULL;
   ExcCards = ARRAY OF INTEGEROBJECT;
   ExcFlags = ARRAY OF INTEGEROBJECT;
   TV_Bogey = INTEGER NOT NULL WITH DEFAULT;
   FN_Lookup = ARRAY OF ObjectSummaryClass;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder History Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ExceptionFlag = FALSE;


   MaxMinutes = CurObject.MaxHours * 60;
   
#  include MgtRpt_SelectClause
/*
**  CardClass is not in fms_operatingstepstatus so we need to use CardClassName. 
*/
   IF CurObject.Feeder <> 0 THEN


      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'CTO.Object = ' + VARCHAR(:CurObject.Feeder) + ' AND ' +
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
         ' AND O.PrimaryGrouping IN ( ';  


      WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'CTO.Object = ' + VARCHAR(:CurObject.Feeder) + ' AND ' + 
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = O.Object ' +
         ' AND O.PrimaryGrouping IN ( ';  


   ELSEIF CurObject.Substation <> 0 THEN


      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
         ' AND O.Object = ' + VARCHAR(:CurObject.Substation) + 
         ' AND O.PrimaryGrouping IN ( ';  


      WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' + 
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = O.Object ' +
         ' AND O.Object = ' + VARCHAR(:CurObject.Substation) + 
         ' AND O.PrimaryGrouping IN ( ';  


   ELSE


      DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
         ' AND O.PrimaryGrouping IN ( '; 


      WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type AND ' +
         'CTO.Object = O.Object ' +
         ' AND O.PrimaryGrouping IN ( '; 
   ENDIF;
   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
      
         SimpleDivision.LoadDivisions();
      
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
         
      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
         
      ENDIF;
   ENDIF;


   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO


      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';


         WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';


         WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;


   DynamicWhereClause = DynamicWhereClause + ' AND C.CardClass IN ( ';
   WhereClause3G = WhereClause3G + ' AND C.CardClass IN ( ';


   IF EffectiveCardTypes.LastRow() = 0 THEN  /* Called from ASP */
      If lowercase(CurObject.CardTypeName) like 'all%' THEN
         /*
         **  Load Report Card types table
         */
         IF SimpleOSS IS NULL THEN
            SimpleOSS = FMS_MgtReports_ASE.Create();
         ENDIF;
         
         SimpleOSS.LoadReportCardTypes();
         
         IF SimpleOSS.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleOSS.OSS.LastRow() DO
               IF i = SimpleOSS.OSS.LastRow() THEN
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';
               ELSE
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';
               ENDIF;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleOSS.ErrorMessage;
            RETURN;
         ENDIF;
         SimpleOSS = NULL;
         
      ELSE
         IF CurObject.CardType = Report$AutoAll THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        


            WhereClause3G = WhereClause3G + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        
         ELSEIF CurObject.CardType <> 0 THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(CurObject.CardType) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(CurObject.CardType) + ')';
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'had no card type parameter supplied with it.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'No card type parameter supplied.';
            RETURN;
         ENDIF;  
      ENDIF;
   ELSE  /* Called from OpenRoad */
      i = 1;
      WHILE i <= EffectiveCardTypes.LastRow() DO
 
         IF i = EffectiveCardTypes.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';


            WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';
         ENDIF;
         i = i + 1;
      ENDWHILE;
   ENDIF;


   i = 0;
   j = 1;
   OldCard = 0;
   SELECT DISTINCT
          :TempOS.Card = C.Card,
          :TempOS.Division = O.PrimaryGrouping,
          :TempOS.DivisionName = O.PrimaryGroupingName,
          :TempOS.OpenAutoPlus = C.OpenAutoPlus,
          :TempOS.SubstationName = O.Description,
          :TempOS.Activated = C.Activated,
          :TempOS.CutOut = C.CutOut,
          :TempOS.CutIn = C.CutIn,
          :TempOS.OpenAutoPlus = C.OpenAutoPlus,
          :TempOS.Closed = C.Closed,
          :TempOS.Status = C.Status,
          :TempOS.Feeder = C.Feeder,
          :TempOS.FeederName = C.FeederName,
          :TempOS.Description = T.Description,
          :TempOS.StartTime = OS.StartTime,
          :TempOS.EndTime = OS.EndTime,
          :TempOS.DurationMins = OS.DurationMins,
          :TempOS.CardClass = C.CardClass,
          :TempOS.CardClassName = C.CardClassName,
          :TempOS.OperatingStep = OS.OperatingStep,
          :TempOS.OperatingStepName = OS.OperatingStepName,
          :TV_Bogey = C.TV_Bogey
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C,
          TFMS_CardToObject CTO,
          Udb_ExtendedType S,
          Udb_Type T,
          Udb_Object OO,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :DynamicWhereClause


   UNION 
   SELECT C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          C.OpenAutoPlus,
          C.SubstationName,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C,
          TFMS_CardToObject CTO,
          Udb_ExtendedType S,
          Udb_Type T,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :WhereClause3G


   UNION 
   SELECT C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          C.OpenAutoPlus,
          O.Description,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_ArchiveOperatingStep OS,
          FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          Udb_ExtendedType S,
          Udb_Type T,
          Udb_Object OO,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :DynamicWhereClause


   UNION 
   SELECT C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          C.OpenAutoPlus,
          C.SubstationName,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_ArchiveOperatingStep OS,
          FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          Udb_ExtendedType S,
          Udb_Type T,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :WhereClause3G


   ORDER BY FeederName,Card,OperatingStep
   BEGIN
#     include LoadHistoryData
   END;       
   CALLPROC DDB_ROLLBACK;


   IF i <> 0 THEN
      Total_Min = CurObject.OSS[i].Int_TotDuration - CurObject.OSS[i].IntOTWPlus;
      CurObject.OSS[i].Char_TotDuration = CALLPROC ConvertHour(Tot_Min = Total_Min);
      IF CurObject.OSS[i].Int_ActDuration > 0 THEN
         /*
         ** This is a feeder that has the outage time limited.
         */
         CurObject.OSS[i].Char_ActDuration = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[i].Int_ActDuration);
      ENDIF;
   ENDIF;
   /*
   **  Create lookup table to improve performance
   */
   i = 1;
   FN_Lookup.Clear();
   SELECT  :FN_Lookup[i].Object = G.Member,
           :FN_Lookup[i].Type   = G.Grouping,
           :FN_Lookup[i].TypeName = O.Name
   FROM     Udb_Object O,
            Udb_Grouping G 
   WHERE    G.MemberType = :Type$Feeder AND
            G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) AND
            G.GroupingType = :Type$Network AND
            G.Grouping = O.Object
   BEGIN 
      i = i + 1;
   END;


   i = 1;
   WHILE i <= CurObject.OSS.LastRow() DO
      IF CurObject.OSS[i].Feeder <> -1 THEN
         FOR j = 1 TO FN_Lookup.LastRow DO
            IF CurObject.OSS[i].Feeder = FN_Lookup[j].Object THEN
               CurObject.OSS[i].NetWork = FN_Lookup[j].TypeName;
               zz = FN_Lookup[j].Type;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      ELSE
         REPEATED
         SELECT :CurObject.OSS[i].NetWork = O.Name,
                :zz = O.Object  /* Temp holder for network id */
         FROM   UDB_Object O,
                UDB_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :CurObject.OSS[i].Card AND
                CTO.Object = G.Member AND
                G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) and
                G.GroupingType = :Type$Network and
                O.Object = G.Grouping
         UNION
         SELECT O.Name,
                O.Object  /* Temp holder for network id */
         FROM   UDB_Object O,
                UDB_Grouping G,
                TFMS_ArchiveCardToObject CTO
         WHERE  CTO.Card = :CurObject.OSS[i].Card AND
                CTO.Object = G.Member AND
                G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) and
                G.GroupingType = :Type$Network and
                O.Object = G.Grouping;
      ENDIF;
      
      IF CurObject.Network <> 0 AND
         zz <> CurObject.Network THEN
         CurObject.OSS.RemoveRow (RowNumber = i);
      ELSE
         i = i + 1;
      ENDIF;
   ENDWHILE; 
   CALLPROC DDB_ROLLBACK;    


/*
** check if the card has been moved to the exception by the FMS administrator.
*/
   DynamicWhereClause = OutageWhereClause + ' AND ' + 
                        CardFilterWhereClause + ' AND ' + 
                        'C.Card = E.Card ';


   i = 1;
   SELECT :ExcCards[i].Value = E.Card,
          :ExcFlags[i].Value = E.ExcludedFrom
   FROM  FMS_Card C,
         TFMS_CardToObject CTO,
         FMS_FRTExclusion E,
         Udb_Grouping GR,
         Udb_Rating R
   WHERE :DynamicWhereClause 
   UNION ALL
   SELECT E.Card,
          E.ExcludedFrom
   FROM  FMS_ArchiveCard C,
         TFMS_ArchiveCardToObject CTO,
         FMS_FRTExclusion E,
         Udb_Grouping GR,
         Udb_Rating R
   WHERE :DynamicWhereClause 
   ORDER BY 1, 2
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;


   FOR i = 1 TO ExcCards.LastRow() DO
       FOR j = 1 TO CurObject.OSS.LastRow() DO
          IF ExcCards[i].Value = CurObject.OSS[j].Card THEN
             CurObject.OSS[j].TagForDelete = TRUE;
             CurObject.OSS[j].Check = 1; /* this feeder was moved to the exception with reason */
             CurObject.ExceptionFlag = TRUE; /* There are cards in the exception list */
             ENDLOOP;
          ENDIF;
       ENDFOR;
   ENDFOR;


   RETURN;
END;


METHOD Load_FeederHistoryDataKPI (
   EffectiveCardTypes = ARRAY OF IntegerObject;  /* List of cardtypes */
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);
   WhereClause3G = VARCHAR(1500);
   SubTypeWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   OutageWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardFilterWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   kv_rad = INTEGER NOT NULL;     /*radio field value*/
   Outage_rad = INTEGER NOT NULL;     /*radio field value*/
   OldCard = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   SimpleOSS = FMS_MgtReports_ASE DEFAULT NULL;
   TempOS = OperatingStepStatusClass;                                         
   Total_Min = INTEGER NOT NULL;
   StartDate = DATE;
   EndDate = DATE;
   TempStart = INTEGER NOT NULL;
   TempEnd = INTEGER NOT NULL;
   MaxMinutes = INTEGER NOT NULL;
   zz = INTEGER NOT NULL;
   ExcCards = ARRAY OF INTEGEROBJECT;
   ExcFlags = ARRAY OF INTEGEROBJECT;
   TV_Bogey = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder History Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ExceptionFlag = FALSE;


   MaxMinutes = CurObject.MaxHours * 60;
   
#  include MgtRpt_SelectClause
/*
**  CardClass is not in fms_operatingstepstatus so we need to use CardClassName. 
*/
   DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type ';


   WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
         'C.Card = OS.Card AND ' +
         'OS.OperatingStep = S.Type AND ' +
         'S.SuperType = ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type <> ' + VARCHAR(:Type$OperatingStepStatus) + ' AND ' +
         'S.Type = T.Type ';
   




   DynamicWhereClause = DynamicWhereClause + ' AND C.CardClass IN ( ';
   WhereClause3G = WhereClause3G + ' AND C.CardClass IN ( ';


   IF EffectiveCardTypes.LastRow() = 0 THEN  /* Called from ASP */
      If lowercase(CurObject.CardTypeName) like 'all%' THEN
         /*
         **  Load Report Card types table
         */
         IF SimpleOSS IS NULL THEN
            SimpleOSS = FMS_MgtReports_ASE.Create();
         ENDIF;
         
         SimpleOSS.LoadReportCardTypes();
         
         IF SimpleOSS.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleOSS.OSS.LastRow() DO
               IF i = SimpleOSS.OSS.LastRow() THEN
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';
               ELSE
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';
               ENDIF;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleOSS.ErrorMessage;
            RETURN;
         ENDIF;
         SimpleOSS = NULL;
         
      ELSE
         IF CurObject.CardType = Report$AutoAll THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        


            WhereClause3G = WhereClause3G + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        
         ELSEIF CurObject.CardType <> 0 THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(CurObject.CardType) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(CurObject.CardType) + ')';
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'had no card type parameter supplied with it.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'No card type parameter supplied.';
            RETURN;
         ENDIF;  
      ENDIF;
   ELSE  /* Called from OpenRoad */
      i = 1;
      WHILE i <= EffectiveCardTypes.LastRow() DO
 
         IF i = EffectiveCardTypes.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';


            WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';
         ENDIF;
         i = i + 1;
      ENDWHILE;
   ENDIF;


   i = 0;
   j = 1;
   OldCard = 0;
   SELECT DISTINCT
          :TempOS.Card = C.Card,
          :TempOS.Division = 0,
          :TempOS.DivisionName = 'KPI Division',
          :TempOS.OpenAutoPlus = C.OpenAutoPlus,
          :TempOS.SubstationName = C.Substationname,
          :TempOS.Activated = C.Activated,
          :TempOS.CutOut = C.CutOut,
          :TempOS.CutIn = C.CutIn,
          :TempOS.OpenAutoPlus = C.OpenAutoPlus,
          :TempOS.Closed = C.Closed,
          :TempOS.Status = C.Status,
          :TempOS.Feeder = C.Feeder,
          :TempOS.FeederName = C.FeederName,
          :TempOS.Description = T.Description,
          :TempOS.StartTime = OS.StartTime,
          :TempOS.EndTime = OS.EndTime,
          :TempOS.DurationMins = OS.DurationMins,
          :TempOS.CardClass = C.CardClass,
          :TempOS.CardClassName = C.CardClassName,
          :TempOS.OperatingStep = OS.OperatingStep,
          :TempOS.OperatingStepName = OS.OperatingStepName,
          :TV_Bogey = C.TV_Bogey
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C,
          Udb_ExtendedType S,
          Udb_Type T
   WHERE  :DynamicWhereClause


   UNION 
   SELECT C.Card,
          0,
          'KPI Division',
          C.OpenAutoPlus,
          C.SubstationName,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C,
          Udb_ExtendedType S,
          Udb_Type T
   WHERE  :WhereClause3G


   UNION 
   SELECT C.Card,
          0,
          'KPI Division',
          C.OpenAutoPlus,
          C.SubstationName,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_ArchiveOperatingStep OS,
          FMS_ArchiveCard C,
          Udb_ExtendedType S,
          Udb_Type T
   WHERE  :DynamicWhereClause


   UNION 
   SELECT C.Card,
          0,
          'KPI Division',
          C.OpenAutoPlus,
          C.SubstationName,
          C.Activated,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          C.OpenAutoPlus,
          C.Closed,
          C.Status,
          C.Feeder,
          C.FeederName,
          T.Description,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          C.CardClass,
          C.CardClassName,
          OS.OperatingStep,
          OS.OperatingStepName,
          C.TV_Bogey
   FROM   FMS_ArchiveOperatingStep OS,
          FMS_ArchiveCard C,
          Udb_ExtendedType S,
          Udb_Type T
   WHERE  :WhereClause3G


   ORDER BY FeederName,Card,OperatingStep
   BEGIN
#     include LoadHistoryData
   END;       
   CALLPROC DDB_ROLLBACK;


   IF i <> 0 THEN
      Total_Min = CurObject.OSS[i].Int_TotDuration - CurObject.OSS[i].IntOTWPlus;
      CurObject.OSS[i].Char_TotDuration = CALLPROC ConvertHour(Tot_Min = Total_Min);
      IF CurObject.OSS[i].Int_ActDuration > 0 THEN
         /*
         ** This is a feeder that has the outage time limited.
         */
         CurObject.OSS[i].Char_ActDuration = CALLPROC ConvertHour(Tot_Min = CurObject.OSS[i].Int_ActDuration);
      ENDIF;
   ENDIF;


/*
** check if the card has been moved to the exception by the FMS administrator.
*/
   DynamicWhereClause = OutageWhereClause + ' AND ' + 
                        CardFilterWhereClause + ' AND ' + 
                        'C.Card = E.Card ';


   i = 1;
   SELECT :ExcCards[i].Value = E.Card,
          :ExcFlags[i].Value = E.ExcludedFrom
   FROM  FMS_Card C,
         FMS_FRTExclusion E
   WHERE :DynamicWhereClause 
   UNION ALL
   SELECT E.Card,
          E.ExcludedFrom
   FROM  FMS_ArchiveCard C,
         FMS_FRTExclusion E
   WHERE :DynamicWhereClause 
   ORDER BY 1, 2
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;


   FOR i = 1 TO ExcCards.LastRow() DO
       FOR j = 1 TO CurObject.OSS.LastRow() DO
          IF ExcCards[i].Value = CurObject.OSS[j].Card THEN
             CurObject.OSS[j].TagForDelete = TRUE;
             CurObject.OSS[j].Check = 1; /* this feeder was moved to the exception with reason */
             CurObject.ExceptionFlag = TRUE; /* There are cards in the exception list */
             ENDLOOP;
          ENDIF;
       ENDFOR;
   ENDFOR;


   RETURN;
END;


METHOD Calc_FeederHistoryTotals (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   m = INTEGER NOT NULL;     /*Counter*/
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   List_STA = ARRAY OF IntegerObject; 
   List_DM = ARRAY OF IntegerObject; 
   List_EST = ARRAY OF IntegerObject; 
   List_LOC = ARRAY OF IntegerObject; 
   List_RG = ARRAY OF IntegerObject; 
   List_TG = ARRAY OF IntegerObject; 
   List_TC = ARRAY OF IntegerObject; 
   List_ID = ARRAY OF IntegerObject; 
   List_RGTC = ARRAY OF IntegerObject; 
   List_OTW = ARRAY OF IntegerObject; 
   List_OTWPlus = ARRAY OF IntegerObject; 
   List_TEST = ARRAY OF IntegerObject; 
   List_PFS = ARRAY OF IntegerObject; 
   List_PFSS = ARRAY OF IntegerObject; 
   List_PFSF = ARRAY OF IntegerObject; 


   List_ISO = ARRAY OF IntegerObject; 
   List_ISTA = ARRAY OF IntegerObject; 
   List_ABF = ARRAY OF IntegerObject; 
   List_INSP = ARRAY OF IntegerObject; 
   List_PFW = ARRAY OF IntegerObject; 
   List_OTWR = ARRAY OF IntegerObject; 
   List_OTWS = ARRAY OF IntegerObject; 
   List_FG = ARRAY OF IntegerObject; 
   List_TotISTA = ARRAY OF IntegerObject; 
   List_TotISL = ARRAY OF IntegerObject; 
   List_TotSTG = ARRAY OF IntegerObject; 
   List_TotOTW = ARRAY OF IntegerObject; 
   List_TotILOC = ARRAY OF IntegerObject; 
   List_TotFPFS = ARRAY OF IntegerObject; 


   List_TotDuration = ARRAY OF IntegerObject; 
   List_Delays = ARRAY OF IntegerObject; 
 
   SD_ISO = FLOAT NOT NULL;
   SD_ISTA = FLOAT NOT NULL;
   SD_ABF = FLOAT NOT NULL;
   SD_INSP = FLOAT NOT NULL;
   SD_PFW = FLOAT NOT NULL;
   SD_OTWR = FLOAT NOT NULL;
   SD_OTWS = FLOAT NOT NULL;
   SD_FG = FLOAT NOT NULL;
   SD_TotISTA = FLOAT NOT NULL;
   SD_TotISL = FLOAT NOT NULL;
   SD_TotSTG = FLOAT NOT NULL;
   SD_TotOTW = FLOAT NOT NULL;
   SD_TotILOC = FLOAT NOT NULL;
   SD_TotFPFS = FLOAT NOT NULL;


   SD_STA = FLOAT NOT NULL;
   SD_DM = FLOAT NOT NULL;
   SD_EST = FLOAT NOT NULL;
   SD_LOC = FLOAT NOT NULL;
   SD_RG = FLOAT NOT NULL;
   SD_TG = FLOAT NOT NULL;
   SD_TC = FLOAT NOT NULL;
   SD_ID = FLOAT NOT NULL;
   SD_RGTC = FLOAT NOT NULL;
   SD_OTW = FLOAT NOT NULL;
   SD_OTWPlus = FLOAT NOT NULL;
   SD_TEST = FLOAT NOT NULL;
   SD_PFS = FLOAT NOT NULL;
   SD_PFSS = FLOAT NOT NULL;
   SD_PFSF = FLOAT NOT NULL;
   SD_TotDuration = FLOAT NOT NULL;
   SD_Delays = FLOAT NOT NULL;
ENDDECLARE
BEGIN
/*
**  Clear arrays to calculate average and Standard Deviation
*/
   List_ISO.Clear(); 
   List_ISTA.Clear(); 
   List_ABF.Clear(); 
   List_INSP.Clear(); 
   List_PFW.Clear(); 
   List_OTWR.Clear(); 
   List_OTWS.Clear(); 
   List_FG.Clear(); 
   List_TotISTA.Clear(); 
   List_TotISL.Clear(); 
   List_TotSTG.Clear(); 
   List_TotOTW.Clear(); 
  
   List_STA.Clear(); 
   List_DM.Clear(); 
   List_EST.Clear(); 
   List_LOC.Clear(); 
   List_RG.Clear(); 
   List_TG.Clear(); 
   List_TC.Clear(); 
   List_ID.Clear(); 
   List_RGTC.Clear(); 
   List_OTW.Clear(); 
   List_OTWPlus.Clear(); 
   List_TEST.Clear(); 
   List_PFS.Clear(); 
   List_PFSS.Clear(); 
   List_PFSF.Clear(); 


   List_TotDuration.Clear(); 
   List_Delays.Clear(); 
/*
** Remove all unwanted rows
*/
/*
**  get all feeders selected.
*/
   CurObject.AllFeeders = CurObject.OSS.LastRow();
   i = 1;
   WHILE i <= CurObject.OSS.LastRow() DO
      IF (CurObject.OSS[i].TagForDelete = TRUE AND
          CurObject.ExceptionFlag = FALSE) OR        /* text says 'show valid list' */
         (CurObject.OSS[i].TagForDelete = FALSE AND
          CurObject.ExceptionFlag = TRUE) THEN       /* text says 'show exception list' */


         CurObject.OSS.RemoveRow (RowNumber = i);         
      ELSE
         IF CurObject.OSS[i].IntISO <> 0 THEN
            m = List_ISO.LastRow + 1;
            List_ISO[m].Value = CurObject.OSS[i].IntISO;
         ENDIF;               
         IF CurObject.OSS[i].IntSTA <> 0 THEN
            m = List_STA.LastRow + 1;
            List_STA[m].Value = CurObject.OSS[i].IntSTA;
         ENDIF;               
         IF CurObject.OSS[i].IntISTA <> 0 THEN
            m = List_ISTA.LastRow + 1;
            List_ISTA[m].Value = CurObject.OSS[i].IntISTA;
         ENDIF;               
         IF CurObject.OSS[i].IntABF <> 0 THEN
            m = List_ABF.LastRow + 1;
            List_ABF[m].Value = CurObject.OSS[i].IntABF;
         ENDIF;               
         IF CurObject.OSS[i].IntDM <> 0 THEN
            m = List_DM.LastRow + 1;
            List_DM[m].Value = CurObject.OSS[i].IntDM;
         ENDIF;               
         IF CurObject.OSS[i].IntEST <> 0 THEN
            m = List_EST.LastRow + 1;
            List_EST[m].Value = CurObject.OSS[i].IntEST;
         ENDIF;               
         IF CurObject.OSS[i].IntLOC <> 0 THEN
            m = List_LOC.LastRow + 1;
            List_LOC[m].Value = CurObject.OSS[i].IntLOC;
         ENDIF;               
         IF CurObject.OSS[i].IntINSP <> 0 THEN
            m = List_INSP.LastRow + 1;
            List_INSP[m].Value = CurObject.OSS[i].IntINSP;
         ENDIF;               
         IF CurObject.OSS[i].IntRG <> 0 THEN
            m = List_RG.LastRow + 1;
            List_RG[m].Value = CurObject.OSS[i].IntRG;
         ENDIF;               
         IF CurObject.OSS[i].IntTG <> 0 THEN
            m = List_TG.LastRow + 1;
            List_TG[m].Value = CurObject.OSS[i].IntTG;
         ENDIF;               
         IF CurObject.OSS[i].IntTC <> 0 THEN
            m = List_TC.LastRow + 1;
            List_TC[m].Value = CurObject.OSS[i].IntTC;
         ENDIF;               
         IF CurObject.OSS[i].IntID <> 0 THEN
            m = List_ID.LastRow + 1;
            List_ID[m].Value = CurObject.OSS[i].IntID;
         ENDIF;               
         IF CurObject.OSS[i].IntRGTC <> 0 THEN
            m = List_RGTC.LastRow + 1;
            List_RGTC[m].Value = CurObject.OSS[i].IntRGTC;
         ENDIF;               
         IF CurObject.OSS[i].IntPFW <> 0 THEN
            m = List_PFW.LastRow + 1;
            List_PFW[m].Value = CurObject.OSS[i].IntPFW;
         ENDIF;               
         IF CurObject.OSS[i].IntOTW <> 0 THEN
            m = List_OTW.LastRow + 1;
            List_OTW[m].Value = CurObject.OSS[i].IntOTW;
         ENDIF;               
         IF CurObject.OSS[i].IntOTWPlus <> 0 THEN
            m = List_OTWPlus.LastRow + 1;
            List_OTWPlus[m].Value = CurObject.OSS[i].IntOTWPlus;
         ENDIF;               
         IF CurObject.OSS[i].IntOTWR <> 0 THEN
            m = List_OTWR.LastRow + 1;
            List_OTWR[m].Value = CurObject.OSS[i].IntOTWR;
         ENDIF;               
         IF CurObject.OSS[i].IntOTWS <> 0 THEN
            m = List_OTWS.LastRow + 1;
            List_OTWS[m].Value = CurObject.OSS[i].IntOTWS;
         ENDIF;               
         IF CurObject.OSS[i].IntTEST <> 0 THEN
            m = List_TEST.LastRow + 1;
            List_TEST[m].Value = CurObject.OSS[i].IntTEST;
         ENDIF;    
         IF CurObject.OSS[i].IntPFS <> 0 THEN
            m = List_PFS.LastRow + 1;
            List_PFS[m].Value = CurObject.OSS[i].IntPFS;
         ENDIF;    
         IF CurObject.OSS[i].IntPFSS <> 0 THEN
            m = List_PFSS.LastRow + 1;
            List_PFSS[m].Value = CurObject.OSS[i].IntPFSS;
         ENDIF;    
         IF CurObject.OSS[i].IntPFSF <> 0 THEN
            m = List_PFSF.LastRow + 1;
            List_PFSF[m].Value = CurObject.OSS[i].IntPFSF;
         ENDIF;    
         IF CurObject.OSS[i].IntFG <> 0 THEN
            m = List_FG.LastRow + 1;
            List_FG[m].Value = CurObject.OSS[i].IntFG;
         ENDIF;               
         IF CurObject.OSS[i].Delays <> 0 THEN
            m = List_Delays.LastRow() + 1;
            List_Delays[m].Value = CurObject.OSS[i].Delays;
         ENDIF;              
         IF CurObject.OSS[i].Int_TotDuration <> 0 THEN
            m = List_TotDuration.LastRow() + 1;
            List_TotDuration[m].Value = CurObject.OSS[i].Int_TotDuration;
         ENDIF;              
         IF CurObject.OSS[i].IntTotISTA <> 0 THEN
            m = List_TotISTA.LastRow + 1;
            List_TotISTA[m].Value = CurObject.OSS[i].IntTotISTA;
         ENDIF;               
         IF CurObject.OSS[i].IntTotISL <> 0 THEN
            m = List_TotISL.LastRow + 1;
            List_TotISL[m].Value = CurObject.OSS[i].IntTotISL;
         ENDIF;               
         IF CurObject.OSS[i].IntTotSTG <> 0 THEN
            m = List_TotSTG.LastRow + 1;
            List_TotSTG[m].Value = CurObject.OSS[i].IntTotSTG;
         ENDIF;               
         IF CurObject.OSS[i].IntTotOTW <> 0 THEN
            m = List_TotOTW.LastRow + 1;
            List_TotOTW[m].Value = CurObject.OSS[i].IntTotOTW;
         ENDIF;               
         IF CurObject.OSS[i].IntTotILOC <> 0 THEN
            m = List_TotILOC.LastRow + 1;
            List_TotILOC[m].Value = CurObject.OSS[i].IntTotILOC;
         ENDIF;               
         IF CurObject.OSS[i].IntTotFPFS <> 0 THEN
            m = List_TotFPFS.LastRow + 1;
            List_TotFPFS[m].Value = CurObject.OSS[i].IntTotFPFS;
         ENDIF;               
  
        i = i + 1;
