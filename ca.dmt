/* tablefield initialize */
initialize =
declare
#   include _tfInitDecl		-- _tblfld, _tfarray, _i, _rownum
enddeclare
begin
#   include _tfInit
end

Name:      ok_btn

					Fieldobject Script
					------------------



Name:      confirm_btn

					Fieldobject Script
					------------------



Application Component Report
============================

	Name:            TransferControlToSwItem

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          TransferControlToSWItem
**
**  Date:       Author   Description
** ----------------------------------
**  12/11/98	EM       Created
**  07/22/02    ysp      Merge: copied from SOA. 
**                       Added FMS Card Control db event handler. 
**                       If this frame is called, user is not allowed to create
**                       a new switching item.
**  01/14/03    pkw      MERGE with SOA version.
**  12/14/05    ysp      increase the size of tomove to 160 chars
**
*/
INITIALIZE 
(
/* passed in */
   Card  		= INTEGER NOT NULL;  /*Passed Card*/
   CardStation          = INTEGER NOT NULL;  /*Card's SubStation*/
   CardInitiator        = INTEGER NOT NULL;  /*Passed start card*/
   Equip                = INTEGER NOT NULL;  /*Passed Equipment*/
   NewSwitchingItem     = INTEGER NOT NULL; /*Selected SW Item*/

/* local variables */
#  include StandardDeclarations

   AppInitiator         = VARCHAR(10) NOT NULL WITH DEFAULT;
   CardClass    	= INTEGER NOT NULL;             
   CardClassName    	= VARCHAR(40) NOT NULL;         
   EventText            = VARCHAR(100) NOT NULL WITH DEFAULT; /* DBEvent text*/
   j   			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   k  			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   MenuEntry		= CHOICEITEM DEFAULT NULL; /*Temporary Object*/  
   OldSwitchingItem     = INTEGER NOT NULL; /*Passed SW Item*/
) =
BEGIN
   OldSwitchingItem = NewSwitchingItem;
   NewSwitchingItem = 0;
   CardClass = 0;
   Equipment = 'Equip: ' + Equipment;
 
   SELECT     :AppInitiator = C.Application
   FROM       SOA_Card C
   WHERE      C.Card = :CardInitiator;

   i = 1;
   REPEATED
   SELECT     :ActiveItem[i].Job = JC.Job
             ,:ActiveItem[i].TOMove = J.TOMove
             ,:CardStation = C.Substation
   FROM       SOA_Job J,
              SOA_JobControl JC,
              SLC_Card C
   WHERE      JC.Card = :Card AND
              C.Card = :Card AND
              JC.Job = J.Job AND
              J.MoveCategory = :MoveCategory$SwitchingItem AND
              J.ShadowLink = 0 AND
              J.SWItemStatus = :Card$Active
   BEGIN 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;              

   IF i = 1 THEN
      IF AppInitiator = Application$FMS THEN
         MESSAGE 'No active switching items on card.  Shadow Items ' +
              'cannot take control.  '  +
              'You will need to create a new item from SLC application first ' +
              'and then come back to transfer control.';
         RETURN PU_CANCEL; 

      ELSE
         MESSAGE 'No active switching items on card.  Shadow Items ' +
              'cannot take control.  '  +
              'You will need to create a new item in order to ' +
              'transfer control.';
         FIELD(Switching_item_decision).CurBias = FB_VISIBLE;
      ENDIF;
   ENDIF;

   FIELD(ActiveItem).CurBias = FB_VISIBLE;

/*
**  Load the card class list
*/    
   FIELD(CardClass_Opt).ValueList.ChoiceItems.Clear();
   FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumText = '';

   i = 2;
   MenuEntry = ChoiceItem.Create();
   SELECT  :MenuEntry.EnumText = T.Name,
           :MenuEntry.EnumValue = T.Type 
   FROM    Udb_Type T,
           Udb_SuperType ST  
   WHERE   ST.SuperType = :Type$SLCCardClass and
           ST.Type = T.Type and
           ST.Type <> :Type$SLCShadow
   BEGIN
      FIELD(CardClass_Opt).ValueList.ChoiceItems[i].EnumValue = 
         MenuEntry.EnumValue;
      FIELD(CardClass_Opt).ValueList.ChoiceItems[i].EnumText = 
         MenuEntry.EnumText;
      i = i + 1;
   END;
   FIELD(CardClass_Opt).UpdChoiceList(); 

   /* not allow to create new Switching Item from FMS application */
   IF AppInitiator = Application$FMS THEN
       switching_item_decision = 2;

       FIELD(switching_item_decision).CurBias = FB_DIMMED;
       FIELD(item_title).CurBias = FB_DIMMED;
       FIELD(cardclass_opt).CurBias = FB_DIMMED;   
       FIELD(ActiveItem).CurBias = FB_LANDABLE;
   ELSE
      switching_item_decision = 1;
   ENDIF;

   CurFrame.Flush();
END;


ON SetValue CardClass_opt = 
BEGIN
   CardClass = FIELD(CardClass_Opt).CurEnumValue;
   CardClassName = FIELD(CardClass_Opt).CurEnumText;
END;


ON SETVALUE switching_item_decision =
BEGIN
   IF switching_item_decision = 1 THEN
      item_title = '';
      FIELD(item_title).CurBias = FB_CHANGEABLE;
      FIELD(ActiveItem).CurBias = FB_VISIBLE;
      NewSwitchingItem = 0;
      CurFrame.InputFocusField = FIELD(item_title);
   ELSE
      item_title = '';
      FIELD(item_title).CurBias = FB_VISIBLE;
      FIELD(ActiveItem).CurBias = FB_LANDABLE;
   ENDIF;
   CurFrame.Flush();
END;

ON CHILDENTRY ActiveItem =
BEGIN
/* 
**  Set row highlight or remove highlight
*/
    IF CurFrame.ReasonCode = RC_PROGRAM OR 
            CurFrame.ReasonCode = RC_TFSCROLL THEN
        RESUME;
    ENDIF;

    j = FIELD(ActiveItem).CurRow;
 
    NewSwitchingItem = ActiveItem[j].Job;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
/*
** Depending on decision, insert new item or use existing one.
*/
   IF switching_item_decision = 1 THEN

      IF item_title = '' THEN
         MESSAGE 'You must give the new switching item a title';
         RESUME;
      ENDIF;  

      IF CardClass = 0 THEN
         MESSAGE 'You must select a card class for new Switching Items.';
         RESUME;
      ENDIF;

      RetCode = CALLFRAME NewItem (
                      CardSubstation = CardStation
                     ,CardClass = CardClass
                     ,CardClassName = CardClassName
                     ,DisplayOnly = FALSE
                     ,InsertShadow = TRUE
                     ,InsertOnly = TRUE
                     ,MultiplekVFlag = FALSE
                     ,SubstationCard = Card
                     ,InitiatingCard = CardInitiator
                     ,TOMove = item_title
                     ,PassedMode = FM_UPDATE
                     ); 

      IF RetCode = PU_OK OR RetCode = PU_CANCEL THEN
               MESSAGE 'Insert of New Switching Item did not complete ' +
                       'successfully.';
               RESUME;
      ENDIF;
      NewSwitchingItem = RetCode;

   ELSEIF NewSwitchingItem = 0 THEN
      MESSAGE 'Please select an active switching item to where control ' +
              'should be transferred.';
      RESUME;
   ENDIF;
/* 
** Transfer Equipment in the Database
*/   
   RetCode = CALLPROC TransferSWItemEquip (
                  Card = Card,
                  Equip = Equip,
                  OldSwitchingItem = OldSwitchingItem,
                  NewSwitchingItem = NewSwitchingItem );
 
      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Transfer Equipment between switching items.';
      ELSE
         CALLPROC DDB_COMMIT;   

         RetCode = CALLPROC SOA_LogIns (
          Card            = Card
        , Job             = NULL
        , SwitchingItem   = OldSwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer out of shadow: ' 
        , Old             = 'Equip: ' + Equipment
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 1 indicating SW item to SW item Transfer.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_LogIns (
          Card            = Card
        , Job             = NULL
        , SwitchingItem   = NewSwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'SW Item Transfer'
        , New             = 'Xfer from Shadow: ' 
        , Old             = 'Equip: ' + Equipment
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 2 indicating SW item to SW item Transfer.';
         ENDIF;

         CALLPROC DDB_COMMIT;        

      ENDIF;
/*
** Inform other view only users of equipment change
*/
   IF i > 1 THEN 
      EventText = VARCHAR(Card) + ';' +
                     UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_NewJobOnCard', 
                                  DBEventText = EventText); 
      CALLPROC DDB_COMMIT;
/*
** OK Return means reload moves for the card; CANCEL return will not
*/  
      RETURN PU_OK;
   ELSE
      RETURN PU_CANCEL;
   ENDIF;

END; 


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation or reutrn to sElect mode if on Confirm.
*/
   RETURN PU_CANCEL;
END;


