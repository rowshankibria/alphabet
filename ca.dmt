	Name:            BugReport_ASE


���pȘ
��Component Method Scripts
���pȘ
��--------------------------
METHOD LoadBugReports(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   IF CurObject.StartTimeChar = '' THEN
      SELECT :CurObject.BL[i].RequestID = RequestID,
             :CurObject.BL[i].RequestTime = RequestTime,
             :CurObject.BL[i].EmailType = EmailType,
             :CurObject.BL[i].Sender = Sender, 
             :CurObject.BL[i].Recipient = Recipient,
             :CurObject.BL[i].Subject = Subject,
             :CurObject.BL[i].Message1 = Message1,
             :CurObject.BL[i].Message2 = Message2,
             :CurObject.BL[i].Template = Template
      FROM   FMS_EmailNotification
      WHERE  EmailType = 8
      BEGIN
         i = i + 1;
      END;
   ELSE
      CurObject.StartTime = Date(CurObject.StartTimeChar);
      
      SELECT :CurObject.BL[i].RequestID = RequestID,
             :CurObject.BL[i].RequestTime = RequestTime,
             :CurObject.BL[i].EmailType = EmailType,
             :CurObject.BL[i].Sender = Sender, 
             :CurObject.BL[i].Recipient = Recipient,
             :CurObject.BL[i].Subject = Subject,
             :CurObject.BL[i].Message1 = Message1,
             :CurObject.BL[i].Message2 = Message2,
             :CurObject.BL[i].Template = Template
      FROM   FMS_EmailNotification
      WHERE  EmailType = 8 AND
             RequestTime > :CurObject.StartTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   FOR i = 1 TO CurObject.BL.LastRow DO
      CurObject.BL[i].RequestTimeChar = FormatDate(RawDate = CurObject.BL[i].RequestTime,
                                                   Format = 'FULL');   
   ENDFOR;
END;

