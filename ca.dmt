METHOD SetPriority (
   NewPriority = INTEGER NOT NULL,
   UpdatedBy = VARCHAR(40) NOT NULL WITH DEFAULT
)=
DECLARE
   OldPriority = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT
ENDDECLARE
BEGIN
   RetCode = CALLPROC TC_CardPriorityUpd(
                        Card = CurObject.Card,
                        Priority = NewPriority);
      
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = 'CardClass.SetPriority; Unable to update card priority due to database error');
      RETURN FALSE;
   ELSE
      CALLPROC DDB_COMMIT;
      
      RetCode = TC_LogInsert(
                      Card = CurObject.Card
                     ,Job = NULL
                     ,Time = DATE('Now')
                     ,Operator = 0
                     ,OperatorName = UpdatedBy
                     ,Item = 'Priority'
                     ,Old = VARCHAR(CurObject.Priority)
                     ,New = VARCHAR(NewPriority));
                    
      CALLPROC DDB_COMMIT;
      
      RETURN TRUE;
   ENDIF;
END;

