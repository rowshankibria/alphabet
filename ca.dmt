	Name:            SelectRescindType

/*
**
**	Copyright c 1994 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**  Application:      FeederCard
**  Frame:            SelectRescindType
**
**  03/19/03   ysp    create
**  11/15/04   ysp    Add FCR withdrawal selection.
**  12/08/04   pkw    Add #9 logic
**  08/01/05   ysp    Add SSO logic
**  01/10/07   em     Rescinding #9 was also showing SSO Rescind message text
**  09/18/15   em     Add Cancel option, 0 = Cancel, 1 = Request, 2 = Force
*/

INITIALIZE
(
   RRType = VARCHAR(4) NOT NULL WITH DEFAULT;
) =
BEGIN
   IF RRType = 'FCR' THEN
      FIELD(FOD).CurBias = FB_INVISIBLE;
      FIELD(SSO).CurBias = FB_INVISIBLE;
      FIELD(Request_Btn).TextLabel = 'Request Withdrawal';
      FIELD(Force_Btn).TextLabel = 'Force Withdrawal';
   ELSEIF RRType = 'SSO' OR RRType = 'TOMS' THEN
      FIELD(FOD).CurBias = FB_INVISIBLE;
      FIELD(FCR).CurBias = FB_INVISIBLE;
      FIELD(Request_Btn).TextLabel = 'Request Rescind';
      FIELD(Force_Btn).TextLabel = 'Force Rescind';
   ELSE
      FIELD(FCR).CurBias = FB_INVISIBLE;
      FIELD(SSO).CurBias = FB_INVISIBLE;
      FIELD(FOD.Title_trm).TextValue = 'Rescind ' + RRType + ' Move';
      /*
      **  Use two freetrim values due to character constraints.
      */
      FIELD(FOD.Desc1_trm).TextValue = 
         '   Since the move has not been acknowledged by the ' + RRType + ', you' + HC_NEWLINE +
         'should Request a Rescission and wait for incoming confirmation.';
      FIELD(FOD.Desc2_trm).TextValue = 
         '   If there are technical problems, you may force the move incomplete,' + HC_NEWLINE +
         'but you first need to contact the ' + RRType + ' verbally before Force Rescinding.' + HC_NEWLINE +
         'YOU MUST THEN RE-ISSUE THE MOVE VERBALLY.';
      FIELD(Request_Btn).TextLabel = 'Request Rescind';
      FIELD(Force_Btn).TextLabel = 'Force Rescind';
   ENDIF;
END;

ON Click Request_Btn =
BEGIN
   RETURN (1);
END;

ON Click Force_Btn =
BEGIN
   RETURN (2);
END;

ON Click Cancel_Btn =
BEGIN
   RETURN (0);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            SelectScenario

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          SelectScenario
**
**  Date:       Author   Description
** ----------------------------------
**  11/14/18    em       Created
**
*/
INITIALIZE 
(
#  include StandardDeclarations

   Application 	= VARCHAR(20) NOT NULL;  /*Passed Application*/
   StartPoint   = INTEGER NOT NULL WITH DEFAULT;  /*Passed WorkPoint */
   StartPointT = INTEGER NOT NULL WITH DEFAULT;
   StartPointST = INTEGER NOT NULL WITH DEFAULT;
   ScenarioList = ARRAY OF TypeClass;
   
   ScenarioApp	= INTEGER NOT NULL WITH DEFAULT;   
   k	= INTEGER NOT NULL WITH DEFAULT;   

   SelectedScenario = INTEGER NOT NULL;
) =
BEGIN
   SelectedScenario = 0;
   i = 1;
   ScenarioList.Clear();
   
   IF Application = Application$TFMS THEN
      ScenarioApp = Scenarios$TFMS;
   ELSEIF Application = Application$SLC THEN
      ScenarioApp = Scenarios$SLC;      
   ELSE 
      Message 'Must be SLC or TFMS';
      RETURN 0;
   ENDIF;
   
   SELECT :ScenarioList[i].Type = T.Type,
          :ScenarioList[i].Name = T.Name
   FROM    Udb_Type T,
           Udb_SuperType ST
   WHERE   ST.SuperType = :ScenarioApp AND
           ST.Type = T.Type AND
           T.Type <> :Scenario$WorkPoint   
   BEGIN 
      i = i + 1;
   END;
   
   SELECT :StartPointName = PrimaryGroupingName + '  ' + TypeName + '  ' + Name,
          :StartPointT = Type
   FROM   Udb_Object
   WHERE  Object = :StartPoint;

   StartPointST = 0;
   SELECT :StartPointST = ET.SuperType
   FROM   Udb_ExtendedType ET
   WHERE  ET.Type = :StartPointT AND
          ET.SuperType IN (:Type$Transformer,:TypeName$BusSect,
                           :Type$BREAKER,
                           :Type$PowerTransformer,:Type$PhaseShifter,:Type$Reactor,
                           :Type$ManDiscBus,
                           :Type$ACLineSegment);
                           
   IF StartPointST = 0 THEN
      MESSAGE 'There are no Scenarios defined for this type of equipment ' + StartPointName;
      RETURN 0;
   ENDIF;
   
   k = 0;
   i = 1;
   WHILE i <= ScenarioList.LastRow DO
      IF StartPointST = Type$Transformer  THEN
         IF (ScenarioList[i].Type = Scenario$TripCheck AND Application = Application$SLC) OR
            (ScenarioList[i].Type = Scenario$EquipmentVerification AND Application = Application$SLC) OR
            (ScenarioList[i].Type = Scenario$ElectricalVerification AND Application = Application$SLC) OR
            ScenarioList[i].Type = Scenario$TapChangerInspection THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = TypeName$BusSect THEN
         IF (ScenarioList[i].Type = Scenario$TripCheck AND Application = Application$SLC) OR
            (ScenarioList[i].Type = Scenario$EquipmentVerification AND Application = Application$SLC) OR
            (ScenarioList[i].Type = Scenario$ElectricalVerification AND Application = Application$SLC) OR
            ScenarioList[i].Type = Scenario$BusSectionWork THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$ACLineSegment THEN
         IF (ScenarioList[i].Type = Scenario$TripCheck AND Application = Application$TFMS) OR
            (ScenarioList[i].Type = Scenario$EquipmentVerification AND Application = Application$TFMS) OR
            (ScenarioList[i].Type = Scenario$ElectricalVerification AND Application = Application$TFMS) OR
            (ScenarioList[i].Type = Scenario$FeederWork AND Application = Application$TFMS) THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$ManDiscBus THEN
         IF (ScenarioList[i].Type = Scenario$GroupDisconnect AND Application = Application$SLC) THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$BREAKER THEN
         IF ScenarioList[i].Type = Scenario$BreakerInspection THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$PowerTransformer THEN
         IF ScenarioList[i].Type = Scenario$DelugeTest THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$PhaseShifter THEN
         IF ScenarioList[i].Type = Scenario$DelugeTest THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ELSEIF StartPointST = Type$Reactor THEN
         IF ScenarioList[i].Type = Scenario$DelugeTest THEN
            
            k = k + 1;
            ScenarioArray[k] = ScenarioList[i].Duplicate();
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   IF ScenarioArray.LastRow = 1 THEN 
      SelectedScenario = ScenarioArray[1].Type;
      RETURN SelectedScenario;
   ENDIF;
 
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CHILDENTRY ScenarioArray =
BEGIN
   SelectedScenario = ScenarioArray[].Type;
END;

ON CLICK OK_btn =
BEGIN
   IF SelectedScenario = 0 THEN
      MESSAGE 'Must select a Scenario';
      RESUME;
   ENDIF;
   RETURN SelectedScenario;
END;


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN 0;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

