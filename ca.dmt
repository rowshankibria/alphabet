/*
**  Application:    CAC
**  Class:          FCRProtectionResult
**
**  Modifications: 
**   08/29/19  ysp  Created.
**   09/17/19  em   Add DiffDistance attribute
*/

METHOD LoadProtections(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.AList.Clear();
   CurObject.SList.Clear();

   i = 1;
   SELECT :CurObject.AList[i].Object = O.Object,
          :CurObject.AList[i].Name = O.Name
   FROM   FMS_WPProtectionActual W,
          UDB_Object O
   WHERE  W.WorkPermit = :CurObject.WorkPermit AND
          W.IssueDate = :CurObject.IssueDate AND
          W.ActualEquip = O.Object
   ORDER BY Name ASC
   BEGIN
      i = i + 1;
   END;
   

   i = 1;
   SELECT :CurObject.SList[i].Object = O.Object,
          :CurObject.SList[i].Name = O.Name
   FROM   FMS_WPProtectionSuggested W,
          UDB_Object O
   WHERE  W.WorkPermit = :CurObject.WorkPermit AND
          W.IssueDate = :CurObject.IssueDate AND
          W.SuggestedEquip = O.Object
   ORDER BY Name ASC
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

