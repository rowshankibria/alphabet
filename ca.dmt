============================

	Name:            PromptCommonLocation

/*
**
**	Copyright c 2011 Pateric Software LLC. All rights reserved.
**
**	Pateric Software LLC. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptCommonLocation
**
**  Modifications:
**  03/24/11  ysp  Created
**  04/07/11  em   Dim unselected choices
*/

INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    ElectronicReturn = INTEGER;
    DBConflict = CHAR(3);
    DBTCType = VARCHAR(20) NOT NULL WITH DEFAULT;
    DBPhaseA = CHAR(3);
    DBPhaseB = CHAR(3);
    DBPhaseC = CHAR(3);
    RetCode = Integer not null;
) =
DECLARE
    UpdateJobResponse = PROCEDURE;
ENDDECLARE
BEGIN
/*
** If there is a common location check result, we will display the result that the FOD returned.
*/
   ElectronicReturn = 0;
   SELECT :ElectronicReturn = 1,
          :Conflict = Conflict,
          :TCType = TCType,
          :CATC.PhaseA = PhaseA,
          :CATC.PhaseB = PhaseB,
          :CATC.PhaseC = PhaseC
   FROM   IR_CommonLocation
   WHERE  Job = :JIP.Job;
   CALLPROC DDB_ROLLBACK;

   IF AutomaticExecution = TRUE THEN
      CALLPROC UpdateJobResponse();
      RETURN (PU_OK);
   ENDIF;      

   IF ElectronicReturn = 0 THEN
      FIELD(Title).TextValue = 'Enter the Result for Common Location Check';
      /*
      ** prompt DO to enter the values
      */
      FIELD(Conflict).CurBias = FB_CHANGEABLE;
      FIELD(Conflict).BGColor = CC_PALE_CYAN;
      FIELD(TCType).ParentField.CurBias = FB_DIMMED;
      FIELD(CATC).CurBias = FB_DIMMED;
    ELSE
      FIELD(Title).TextValue = 'Result Returned by FOD for Common Location Check';
      IF Conflict = 'NO' THEN
         FIELD(TCType).ParentField.CurBias = FB_DIMMED;
         FIELD(CATC).CurBias = FB_DIMMED;
      ELSEIF TCType = 'IATC' THEN
         FIELD(CATC).CurBias = FB_DIMMED;
      ENDIF;
   ENDIF;
END;

ON SetValue Conflict =
BEGIN
   IF Conflict = 'YES' THEN
      FIELD(TCType).CurBias = FB_CHANGEABLE;
      FIELD(TCType).ParentField.CurBias = FB_CHANGEABLE;
      FIELD(TCType).BGColor = CC_PALE_CYAN;
   ELSE
      TCType = '';
      CATC.PhaseA = '';
      CATC.PhaseB = '';
      CATC.PhaseC = '';
      FIELD(TCType).CurBias = FB_VISIBLE;
      FIELD(TCType).ParentField.CurBias = FB_DIMMED;
      FIELD(TCType).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseA).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseB).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseC).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseA).CurBias = FB_VISIBLE;
      FIELD(CATC.PhaseB).CurBias = FB_VISIBLE;
      FIELD(CATC.PhaseC).CurBias = FB_VISIBLE;
      FIELD(CATC).CurBias = FB_DIMMED;
   ENDIF;
END;

ON SetValue TCType =
BEGIN
   IF TCType = 'CATC' THEN
      FIELD(CATC.PhaseA).BGColor = CC_PALE_CYAN;
      FIELD(CATC.PhaseB).BGColor = CC_PALE_CYAN;
      FIELD(CATC.PhaseC).BGColor = CC_PALE_CYAN;
      FIELD(CATC.PhaseA).CurBias = FB_CHANGEABLE;
      FIELD(CATC.PhaseB).CurBias = FB_CHANGEABLE;
      FIELD(CATC.PhaseC).CurBias = FB_CHANGEABLE;
      FIELD(CATC).CurBias = FB_CHANGEABLE;
   ELSE
      FIELD(CATC.PhaseA).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseB).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseC).BGColor = CC_PALE_BLUE;
      FIELD(CATC.PhaseA).CurBias = FB_VISIBLE;
      FIELD(CATC.PhaseB).CurBias = FB_VISIBLE;
      FIELD(CATC.PhaseC).CurBias = FB_VISIBLE;
      FIELD(CATC).CurBias = FB_DIMMED;
   ENDIF;
END;

ON Click OKButton =
BEGIN
   IF ElectronicReturn = 0 THEN
      IF Conflict = 'YES' AND TCType <> 'IATC' AND TCType <> 'CATC' THEN
         MESSAGE 'TC to execute must be IATC or CATC when there are location conflicts';
         RESUME;
      ENDIF;

      IF TCType = 'CATC' THEN
         IF CATC.PHASEA <> '+' AND CATC.PHASEA <> '-' AND CATC.PHASEA <> 'CLR' THEN
            MESSAGE 'Phase A must be +, - or CLR';
            RESUME;
         ENDIF;
         IF CATC.PHASEB <> '+' AND CATC.PHASEB <> '-' AND CATC.PHASEB <> 'CLR' THEN
            MESSAGE 'Phase B must be +, - or CLR';
            RESUME;
         ENDIF;
         IF CATC.PHASEC <> '+' AND CATC.PHASEC <> '-' AND CATC.PHASEC <> 'CLR' THEN
            MESSAGE 'Phase C must be +, - or CLR';
            RESUME;
         ENDIF;
      ENDIF;
   ENDIF;
   
   CALLPROC UpdateJobResponse();

   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE UpdateJobResponse(
) =
BEGIN
   IF Conflict = 'YES' THEN
      IF UPPERCASE(TCType) = 'CATC' THEN
         JIP.Response = 'Conflict; Apply CATC A:' + CATC.PhaseA + ',B:' + CATC.PhaseB + ',C:' + CATC.PhaseC;
      ELSE
         JIP.Response = 'Conflict; Apply IATC'
      ENDIF;
   ELSE
      JIP.Response = 'No Conflict';
   ENDIF;
      
   JIP.ResponseUpd();
END;
							 *Default Item

							 *Default Item

							 *Default Item

							 *Default Item

							 *Default Item


