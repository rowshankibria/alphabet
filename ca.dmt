	Name:            PromptRequestCustomerCrew

/*
**
**	Copyright c 2013 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FMS
**  Frame:          PromptRequestCustomerCrew
**
**  Modifications:
**  10/11/13 ysp Creatred
**  11/26/13 ysp Remove email template section from screen
*/
INITIALIZE
(
    JIP = JobInProgress;			      /*P: Job being processed */

    Name = VARCHAR(40) NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    OrigTime = DATE NOT NULL WITH DEFAULT;
    TempMove = VARCHAR(160) NOT NULL WITH DEFAULT;
    TimeSet =  DATE NOT NULL;
    i = INTEGER NOT NULL;
) =
DECLARE

ENDDECLARE
BEGIN
   /* feeder name */
   SELECT :FeederName = C.FeederName
   FROM    FMS_Card C,
           SOA_ActiveCard AC,
           SOA_JobControl JC
   WHERE   JC.Job = :JIP.Job AND
           JC.Card = AC.Card AND
           AC.Card = C.Card;

   /* HTV and Customer name */
   SELECT  :HTVName = Name,
           :Customer = Description
   FROM    Udb_Object
   WHERE   Object = :JIP.Equip;
     
   /* DO Desk */
   SELECT  :Name  = Name
   FROM    Udb_Object
   WHERE   Object = :UserDesk;
   
   Desk = '';
   IF UPPERCASE(Name) = 'BQ' THEN
      Desk = 'Brooklyn/Queens DO';
      Phone = '212-580-6748';

   ELSEIF UPPERCASE(Name) = 'MX' THEN
      Desk = 'Manhattan/Bronx DO';
      Phone = '212-580-6750';

   ELSEIF UPPERCASE(Name) = 'WS' THEN
      Desk = 'Westchester/Staten Island DO';
      Phone = '212-580-6753';

   ELSE
      Desk = 'FMS Test';
      Phone = '212-580-5385';
   ENDIF; 
   CALLPROC DDB_ROLLBACK;
   
   /*
   Email = 'The District Operator has been unable to contact <Customer> to restore ' +
           'their equipment at High Tension Vault <HTV> on feeder <Feeder>. ' +
           'Please have CPM contact the customer and have the customer call the District ' +
           'Operator.' + HC_NEWLINE + HC_NEWLINE +
           '<District Operator Desk>' + HC_NEWLINE +
           '<Desk Phone Number>';
   */
END;

ON Click OKButton =
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;
ENDDECLARE
BEGIN
/*
** Send email
*/
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 10;
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'EnergyServiceManagers';
   EmailClass.Subject = 'Customer Crew Requested by District Operator ' +  DOp.Description;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                         'Feeder=' + FeederName + ';;' + 
                         'HTV=' + HTVName + ';;' + 
                         'Customer=' + Customer + ';;'; 
                         
   EmailClass.Message2 = 'District Operator Desk=' + Desk + ';;' + 
                         'Desk Phone Number=' + Phone + ';;';
   EmailClass.Template = 'HTVCustomerCrewRequest.html';
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      Message 'Unable to send email to Energy Service Managers. Please contact them verbally';
   ENDIF;

   RETURN (PU_OK);   
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;




