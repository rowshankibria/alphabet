/*
**  Application:    SOA
**  Class:          CardSOA
**
**  Date:       Author   Description
** ----------------------------------
**  04/20/98    em       Created
**  10/19/98    em       Add update item; Use InformationItem table for saving
**                       item details instead of Work Permit table
**  10/20/98    em       Added Equip Link methods.
**  07/19/02    em       In InsertItem method, if Job is 0, go get a new one.
**  02/16/04    em       Convert Message to TraceError Call
**  02/15/06    em       Remove Card Class from SLC_InformationItemUpd call
*/ 
METHOD InsertItem (
   Card         = INTEGER NOT NULL
) =
DECLARE
   RetCode	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** If Job = 0, get a new one here.
*/
   IF CurObject.Job = 0 THEN
      CurObject.Job = CALLPROC SOA_JobLastKey();
      IF CurObject.Job <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to obtain new job key. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertItem; ' +
             'Unable to obtain new SOA_Job key. ' 
             );
         RETURN PU_CANCEL;
      ELSE
 
         CurObject.SwitchingItem = CurObject.Job;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/* 
** Inserts row into job, jobcontrol, and work permit tables
*/
   RetCode = CALLPROC SOA_ItemIns (
	  Card            = Card 
	, Job             = CurObject.Job
	, Equip           = CurObject.Equip
        , Status          = CurObject.Status
	, JobClass        = CurObject.JobClass
        , CardClass       = CurObject.CardClass
        , CardClassName   = CurObject.CardClassName
	, EquipName       = CurObject.EquipName
	, EquipClass      = CurObject.EquipClass
	, EquipClassName  = CurObject.EquipClassName
	, MoveType        = CurObject.MoveType
	, TOMove          = CurObject.TOMove
	, TOMoveRules     = MoveRules$TOIssueRSComplete
        , TOIssued        = CurObject.TOIssued
        , Response        = CurObject.Response
        , ShadowLink      = CurObject.ShadowLink
	, SwItemStatus    = CurObject.SwItemStatus
	, Substation      = CurObject.Substation
        , MoveCategory    = CurObject.MoveCategory
	, TypeGround      = Type$Ground
        , Category	  = CurObject.Category
        , Severity        = CurObject.Severity
        , Description     = CurObject.Description
	);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert Switching Item. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertItem; ' +
             'Switching Item insert into Job table failed. ' 
             );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_JobControlIns (
          Card            = Card
        , Job             = CurObject.Job
        , SwitchingItem   = CurObject.Job
	, StepPair        = 0
        );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert Switching Item Control. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertItem; ' +
             'Switching Item insert into Job Control table failed. ' 
             );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_LogIns (
          Card            = Card
        , Job             = CurObject.Job
        , SwitchingItem   = CurObject.Job
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'New Item'
        , New             = 'Sw/Info Item Created'
        );

   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert new Switching Item log entry. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertItem; ' +
             'Switching Item insert log entry failed. ' 
             );
   ENDIF;
   CALLPROC DDB_COMMIT;

   RETURN(PU_OK);

END;


METHOD ItemUpdate (
) =
DECLARE
   RetCode 	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   RetCode = CALLPROC SLC_InformationItemUpd (
                 Job 		= CurObject.Job
               , Category 	= CurObject.Category
               , Severity	= CurObject.Severity
 	       , Title		= CurObject.TOMove
	       , Description	= CurObject.Description);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update Item.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;ItemUpdate; ' +
             'Unable to updateitem details.' 
             );
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN PU_OK;
   ENDIF;
END;   


METHOD RetrieveItem (
   Job	       = INTEGER NOT NULL;
   ArchiveItem = INTEGER NOT NULL WITH DEFAULT;
)=
BEGIN
   IF ArchiveItem = FALSE THEN

      REPEATED
      SELECT :CurObject.Category = I.Category,
             :CurObject.Severity = I.Severity,
             :CurObject.Description = I.Description,
             :CurObject.CategoryName = C.Name,
             :CurObject.Job = I.Job
      FROM   SLC_InformationItem I,
             SLC_ItemCategory C
      WHERE  I.Job = :Job AND
             I.Category = C.Category;
   ELSE

      REPEATED
      SELECT :CurObject.Category = I.Category,
             :CurObject.Severity = I.Severity,
             :CurObject.Description = I.Description,
             :CurObject.CategoryName = C.Name,
             :CurObject.Job = I.Job
      FROM   SLC_ArchiveInfItem I,
             SLC_ItemCategory C
      WHERE  I.Job = :Job AND
             I.Category = C.Category;   
   ENDIF;

   IF iirowcount = 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN NULL;
   ELSE 
      CALLPROC DDB_ROLLBACK;
      RETURN :CurObject;
   ENDIF;
END;

METHOD InsertEquipLink (
   Equip		= INTEGER NOT NULL;
   Substation		= INTEGER NOT NULL;
) =
DECLARE
   Division		= INTEGER NOT NULL;
   RetCode              = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Get Division associated to Substation for reporting.
*/
   Division = 0;
   SELECT :Division = G.Grouping
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  G.Member = :Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = O.Object AND
          O.Type = :Type$Division;

   IF Division = 0 THEN
      CALLPROC TraceError (UserMessage = 
             'ERROR: Udb Problem. Unable to find related division for ' + 
             'substation.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertEquipLink; ' +
             'Unable to find ' +
             'related division for substation.  Correct problem in Udb.'
             );
      RETURN PU_CANCEL;
   ENDIF;
 
   RetCode = CALLPROC SLC_InfItemEquipIns (
                Job = :CurObject.Job,
                Equip = Equip,
                Substation = Substation,
                Division = Division);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Udb Problem. Unable to insert item equipment link ' + 
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertEquipLink; ' +
             'Equipment link to Switching Item insert failed.'
             );
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN PU_OK;
   ENDIF;
END;
   
       

METHOD RemoveEquipLink (
   Equip		= INTEGER NOT NULL;
) =
DECLARE
   RetCode              = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   RetCode = CALLPROC SLC_InfItemEquipDel (
                Job = :CurObject.Job,
                Equip = Equip);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Udb Problem. Unable to remove item equipment link ' + 
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Switching Item;InsertEquipLink; ' +
             'Equipment link to Switching Item delete failed.'
             );
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN PU_OK;
   ENDIF;
END;

