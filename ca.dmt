Application Component Report
============================

	Name:            Connected3GSourceCutOutTrace

/*
**
**	Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          Connected3GSourceCutOutTrace          
**
**  Modifications:
**  03/08/11   em   Created from ConnectedSourceCutOutTrace to support 3G substation feeder passed in 
**                  instead of equipment
**  01/23/17   ysp  Use QGis-based trace class Trace_ConnectedSourceCutOut 
**
**  RETURNS -1 IF No Determination, 0 IF In Service, 1 IF Out OF SERVICE
*/
PROCEDURE Connected3GSourceCutOutTrace
(
   Feeder       = INTEGER NOT NULL;  /* PARAMETER */
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;

   FdrLoad	= ARRAY OF INTEGEROBJECT;
   FeederIsCutIn = INTEGER NOT NULL WITH DEFAULT;
   Substation	= INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   TraceEnabled = INTEGER NOT NULL WITH DEFAULT;
   TraceStatus   = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_ConnectedSourceCutOut DEFAULT NULL;
ENDDECLARE
BEGIN
/* 
** Determine whether a trace is necessary.
**  1) Is device in a substation and on a feeder with an active card?
**     It may be related to more than one feeder.
**  2) Is the active card already CutIn or CutOut?  Don't need to duplicate the
**     status.
**  3) Is the feeder set up in DBM for a Connected Source trace?
*/
   Substation = 0;  
   SELECT  :Substation = Grouping                      /* we will use this station later*/
   FROM    Udb_Grouping
   WHERE   Member = :Feeder AND
           Relationship = :Interaction$MemberOf AND
           GroupingType IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$Substation);

   IF Substation = 0 THEN
      RETURN -1;   /* Bail immediately if device not in a substation */
   ENDIF;

   TraceEnabled = 0;
   SELECT :TraceEnabled = Feeder
   FROM   FMS_ConnectedSource
   WHERE  Feeder = :Feeder;

   IF TraceEnabled = 0 THEN  /* Trace is not enabled */
      RETURN -1;
   ENDIF;
/*
** Find each FdrLoad device on the Feeder
*/
   i = 1;
   FdrLoad.Clear();
   SELECT  :FdrLoad[i].Value = Member
   FROM    Udb_Grouping
   WHERE   Grouping = :Feeder AND
           Relationship = :Interaction$MemberOf AND
           MemberType = :Type$FdrLoad 
   BEGIN
      i = i + 1;
   END;  
   CALLPROC DDB_ROLLBACK;
/*
** Now we trace starting from the FdrLoad devices on this card.
** Our default condition is an Out of Service (CutOut) feeder.
** If any trace reaches a BusSection device or another FdrLoad,
** then the feeder is In Service (CutIn).
*/
   FeederIsCutIn = FALSE;
   FOR j = 1 TO FdrLoad.LastRow() DO
      Trace = Trace_ConnectedSourceCutOut.Create();   // safer to create a trace object before each trace
  
/*
** start search with this piece of equipment and then branch out in all
** directions.  When a trace dies or reaches an Open device we discontinue
** the trace in that direction.  If a Bus Section or Fdr Load type device is 
** encountered, then the feeder is In Service (CutIn).
*/
      Trace.JCEquip.Object = FdrLoad[j].Value;
      Trace.SubstationScope[1].Value = Substation;
      
      TraceStatus = Trace.StartTargetTrace();
      
      IF Trace.ReturnCode <> 0 THEN
         CALLPROC TraceError (
                  UserMessage = 'ERROR: The Connectivity trace from ' + 
                     ' Feeder Load discovered a connectivity problem: ' + Trace.ErrorMessage,
                  TraceMessage = 'Connected3GSourceCutOutTrace: The Connectivity trace from ' + 
                     ' Feeder Load ' + VARCHAR(FdrLoad[j].Value) + ' discovered a connectivity problem: ' + Trace.ErrorMessage);
         RETURN -1;
      ENDIF;
/*
**  We stop search only if Feeder is CutIn
*/
      IF Trace.FeederIsCutIn = TRUE THEN
         FeederIsCutIn = TRUE;
         ENDLOOP;
      ENDIF;
   ENDFOR;
/*
** Now we check the FeederIsCutIn flag that we may have "set" during our trace.  
*/
   IF FeederIsCutIn = TRUE THEN
      RETURN (0);  /* Feeder in service */
   ELSE
      RETURN (1);  /* Feeder is out of service */
   ENDIF;
END;








