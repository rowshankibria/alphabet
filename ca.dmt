	Name:            CalculateStandardDeviation

/*
**  Copyright c 1993 ESCA Corporation  All rights reserved.
**
**  ESCA Corporation proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of ESCA Corporation. 
*/
/*
**  Application:    FeederCard
**  Procedure:      CalculateStandardDeviation
**
**  Modifications:
**  06/12/00   pkw  Initial
*/
PROCEDURE CalculateStandardDeviation
(
   CT = ARRAY OF INTEGEROBJECT;  
   CTSquare = FLOAT NOT NULL;  
   SquareTotal = FLOAT NOT NULL;
   CTValue = FLOAT NOT NULL;
   Total = FLOAT NOT NULL;      
   Average = INTEGER NOT NULL;                                    
   i = INTEGER NOT NULL;                                          
   x = float not null;
   y = float not null;
   z = float not null;
   SD2 = float not null;
   SD = float not null;
) =
BEGIN
/*
**  Find total Value for array or integerobject passed in.
*/
   Total = 0;
   SquareTotal = 0;
   SD2 = 0;
   SD = 0;
   i = 1;
   WHILE i <= CT.LastRow() DO
      CTValue = CT[i].Value; /* to prevent integer overflow on big numbers */
      CTSquare = CTValue * CTValue;
      SquareTotal = SquareTotal + CTSquare;
      Total = Total + CT[i].Value;
      i = i + 1;
   ENDWHILE;

   x = Total * Total;
   y = SquareTotal * CT.LastRow();
   z = y - x;
   IF CT.LastRow() <> 0 THEN   
      SD2 = z/(CT.LastRow() * CT.LastRow());
      SD = sqrt(SD2);
   ENDIF;
   RETURN SD;
END;

