	Name:            OriginalCard

/*
**
**  Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          OriginalCard
**
**  Modifications:
**  03/08/93    em      created
**  09/30/94    hlf     Make sure parentframe will not exit without saving.
**  12/24/02    ysp     Explicitly call soa_logins to log card header changes.   
**  05/21/09    em      Change Parent Centered to Parent Relative Positioning
**  05/25/10    em      Increase feeder name on screen for 3G
**  01/19/11    em      Add 3G Feeder Toggle
**  01/20/11    pkw     Implement for 3G
**  08/25/16    ysp     Disable updates on pool feeder for 33kv portion cards. 
**                      The header details should be updated only on the top of 
**                      the card so the information stays with the card.
*/
INITIALIZE (
    RetCode = INTEGER NOT NULL WITH DEFAULT;   /*Return Code*/
    CSave = FMS_Card; 
   
    i = INTEGER NOT NULL WITH DEFAULT;   
    FeederObj = INTEGER NOT NULL WITH DEFAULT;
    NoCardUpd = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      FeederObj = C.Object[1].Object;
      FeederName = C.Object[1].Name;
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');

      IF C.Object.LastRow() > 1 THEN
         FIELD(NetworkFeeder).ValueList.ChoiceItems.Clear();
         FOR i = 1 TO C.Object.LastRow() DO
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumValue = C.Object[i].Object;
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumText = C.Object[i].Name;
         ENDFOR;
         FIELD(NetworkFeeder).CurBias = FB_CHANGEABLE;
         /* OR5.1 FIELD(NetworkFeeder).ColumnWidthCompressed = TRUE; */
         FIELD(NetworkFeeder).UpdChoiceList();
      ENDIF;
      NetworkFeeder = FeederObj;
   ELSE
      FeederObj = C.Feeder;
      FeederName = C.FeederName;
      CurFrame.SendUserEvent (EventName = 'LoadDisplay');
      
      IF C.NetworkFeeder = NetworkFeeder$33KV AND
         C.TypeOfCard = TypeOfCard$Portion THEN
         FIELD(Heading).TextValue = 'Card Heading for: ';
         FIELD(C).CurBias = FB_VISIBLE;
         FIELD(OK_Btn).CurBias = FB_INVISIBLE;
      ENDIF;
   ENDIF;   
END;

ON SETVALUE NetWorkFeeder =
BEGIN
   FeederObj = FIELD(NetworkFeeder).CurEnumValue;
   FeederName = FIELD(NetworkFeeder).CurEnumText;
   CurFrame.SendUserEvent (EventName = 'LoadDisplay');
END;


ON USEREVENT 'LoadDisplay' =
BEGIN
   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      i = 0;
      SELECT :i = G.Member
      FROM   Udb_Object O,
             Udb_Grouping G
      WHERE  G.Grouping = :FeederObj AND
             G.Relationship = :Interaction$SourceBreaker AND
             G.Member = O.Object AND
             O.Name = :C.Position;

      IF i = 0 THEN
         SELECT :C.Loop1 = L.L1,
                :C.Loop2 = L.L2,
                :C.Loop3 = L.L3,
                :C.Loop4 = L.L4,
                :C.Assoc = O.Description
         FROM    Udb_Grouping G,
                 Udb_Location L,
                 Udb_Object O
         WHERE   O.Object = :FeederObj AND
                 O.Object = G.Member AND
                 G.Relationship = :Interaction$LocatedWith AND
                 G.Grouping = L.Object;
         NoCardUpd = TRUE;      
      ELSE
         SELECT :C.Loop1 = C.Loop1,
                :C.Loop2 = C.Loop2,
                :C.Loop3 = C.Loop3,
                :C.Loop4 = C.Loop4,
                :C.Assoc = C.Assoc
         FROM    FMS_Card C
         WHERE   C.Card = :C.Card;
         NoCardUpd = FALSE;
      ENDIF;     
   ENDIF;
   CSave = C.Duplicate();
END;


ON UserEvent 'UpdateCard',
ON Click OK_Btn =
BEGIN
/*
**  Force a setvalue to occur
*/
    IF (Curframe.InputFocusField != FIELD(C.Loop1)) THEN
        Curframe.InputFocusField = FIELD(C.Loop1);
    ELSE
        Curframe.InputFocusField = FIELD(C.Loop2);
    ENDIF;
/*
**  If there haven't been any changes, then just exit out; otherwise, save the changes.
*/
    IF (CSave.Loop1 = C.Loop1) AND
       (CSave.Loop2 = C.Loop2) AND
       (CSave.Loop3 = C.Loop3) AND
       (CSave.Loop4 = C.Loop4) AND
       (CSave.Assoc = C.Assoc) THEN
        RETURN;
    ELSE        

    /*
    **  Save the card information.
    */
        RetCode = CALLPROC FMS_OriginalCardUpdate (
                 Card    = C.Card,
                 Feeder  = FeederObj,
                 Loop1   = C.Loop1,
                 Loop2   = C.Loop2,
                 Loop3   = C.Loop3,
                 Loop4   = C.Loop4,
                 Assoc   = C.Assoc,
                 NoCardUpd = NoCardUpd);

        IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to Update Original Card.';
            RESUME;
        ENDIF;
        CALLPROC DDB_COMMIT;   

        IF (CSave.Loop1 <> C.Loop1) THEN
           CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Loop1',
                 Old  = CSave.Loop1,
                 New  = C.Loop1);
           CALLPROC DDB_COMMIT;
        ENDIF;

        IF (CSave.Loop2 <> C.Loop2) THEN
           CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Loop2',
                 Old  = CSave.Loop2,
                 New  = C.Loop2);
           CALLPROC DDB_COMMIT;
        ENDIF;

        IF (CSave.Loop3 <> C.Loop3) THEN
           CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Loop3',
                 Old  = CSave.Loop3,
                 New  = C.Loop3);
           CALLPROC DDB_COMMIT;
        ENDIF;

        IF (CSave.Loop4 <> C.Loop4) THEN
           CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Loop4',
                 Old  = CSave.Loop4,
                 New  = C.Loop4);
           CALLPROC DDB_COMMIT;
        ENDIF;

        IF (CSave.Assoc <> C.Assoc) THEN
           CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Assoc',
                 Old  = CSave.Assoc,
                 New  = C.Assoc);
           CALLPROC DDB_COMMIT;
        ENDIF;

        RETURN; 
    ENDIF;
END;

ON UserEvent 'ExitFrame',
ON Click Cancel_Btn =
BEGIN
    C.Loop1 = CSave.Loop1;
    C.Loop2 = CSave.Loop2;
    C.Loop3 = CSave.Loop3;
    C.Loop4 = CSave.Loop4;
    C.Assoc = CSave.Assoc;
    RETURN;
END;

