	Name:            CheckCommonDeloadRestore

/*
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    FeederCard 
**  4GL Procedure:  CheckDeloadRestore
**
**  Date:     Version  Description
** --------------------------------------------------
**  11/22/96    pw    Created to check deload restore on 4kv Cards
**  11/18/02    ysp   Merge: removed C and Jobs as passed-ins.
**  02/28/03    pkw   Use DISTINCT against SOA_ActiveCard for feeder
**                    that span divisions.
**  02/03/05    pkw   Include filtered moves on check.
**  04/10/07    ysp   ITC203: Remove Move$Filtered as a job status.
**  12/28/11    em    This check looks like it is obsolete.  There is no type for it in the Type 
**                    Hierarchy and it is not documented in the UG.
*/
PROCEDURE CheckCommonDeloadRestore 
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              
    k = INTEGER NOT NULL;               
    CommonFeederCard = ARRAY OF FMS_CARD;
    TempJobs = ARRAY of Job; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
    i = 1;
    SELECT DISTINCT
           :CommonFeederCard[i].Feeder = C.Feeder,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Card = C.Card
    FROM   SOA_JobControl JC,
           SOA_ActiveCard AC,
           FMS_Card C
    WHERE  JC.Job = :JIP.Job AND
           JC.Card = C.Card AND
           JC.Card = AC.Card
    BEGIN
        i = i + 1;
    END;

    RetCode = NULL;

    FOR i = 1 to CommonFeederCard.LastRow() DO
        k = 0;
        REPEATED
        SELECT :k = COUNT(*)
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
               JC.StepPair = :StepHeading$Deload AND
               J.JobClass <> 0 AND 
               J.RSComplete IS NULL AND
               J.Status = '';
        IF k > 0 THEN
  
           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Not all Deload moves have been restored ' +
                             'on feeder ' + CommonFeederCard[i].FeederName
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
               RETURN(PU_CANCEL);
           ELSE
               RetCode = Warning$Overridden;
           ENDIF;
        ENDIF;
    ENDFOR;
    RETURN (Retcode);
END; 

Application Component Report
============================

	Name:            CheckCommonLocation


/*
**
**	Copyright c 2008 Unified Information, Inc.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckCommonLocation
**
**  Modifications:
**  05/27/08 em	    Created DeadStop Check
**  08/13/08 em     Add FeederName to message since move may be common to mulitple cards.
**  08/14/08 em     Expanded check into a warning to replace logic that had been used on New Moves screen
**                  and included TCIP status.
**  09/08/08 em     Removed unnecessary TCIP status
**  09/22/08 em     Show Common Manholes screen after showing warning;
**                  Use main feeder if this is an ISO    
**  09/14/10 em     Check for Common Manhole problem before displaying warning.
**  10/20/10 em     On 3G card, look for any feeder object to have status set.
**  03/24/11 ysp    FMS 397: Replacing Messages with TraceError
**  09/10/15 em     Attempt to differentiate TC being applied from common feeder TC before presenting warning.
**  07/15/16 em     Include KPSFeeder in ISOFeeder loop to get to main feeder.
**  07/19/16 em     Extend TC check to looks for TC on Known Point ISO 
**  11/19/19 em     Remove Yellow Warning that is appearing after Gray Trace Error message which
**                  is supposed to be a dead stop.
*/
PROCEDURE CheckCommonLocation 
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    j = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    ISOFeeder = INTEGER NOT NULL WITH DEFAULT;
    Feeder = INTEGER NOT NULL WITH DEFAULT;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
    TCBeingApplied = INTEGER NOT NULL WITH DEFAULT;
    TCTypeName = CHAR(4) NOT NULL WITH DEFAULT;
) =
BEGIN
   RetCode = PU_OK;
/*
** The first check is a hard stop.
*/
   i = 0;
   REPEATED
   SELECT
   DISTINCT
          :i = OS.Status,
          :FeederName = C.FeederName
   FROM   SOA_JobControl JC,
          SOA_ActiveObject AO,
          FMS_Card C,
          FMS_ObjectStatus OS
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AO.Card AND
	  AO.Object = OS.Object AND
          AO.ObjectToCardLink = 1 AND
          OS.StatusCount > 0 AND
          OS.Status = :Status$TCLocationCheck;

   IF i = 0 THEN
      CALLPROC TraceError(
              UserMessage = 'You may not continue until you have verified that there is no common location. ' + 
                            HC_NEWLINE + 'Common location check must be performed on feedercard ' + FeederName + '.',
              TraceMessage = 'Common location check was not performed on feedercard ' + FeederName + '. Precheck failed.');
/*
** 11/19/19 Not sure why this yellow warning is here after gray dead stop
      IF AutomaticExecution = FALSE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Common location check was not performed on feedercard ' + FeederName
                    ); 
      ENDIF;
*/      
      RETURN PU_CANCEL;
   ENDIF;

   i = 0;
   SELECT :i = COUNT(Feeder)
   FROM FMS_MHProblem;

   IF i > 0 THEN
      RETURN (retcode);
   ENDIF;
/*
** Identify TC being applied by this move.
*/ 
   TCBeingApplied = 0;
   SELECT :TCBeingApplied = Status
   FROM   FMS_JobAction
   WHERE  JobClass = :JIP.JobClass AND
          Action IN (:JobAction$Increment, :JobAction$Set) AND
          Status IN (:Status$CATC, :Status$IATC);

   IF TCBeingApplied = 0 THEN
      CALLPROC TraceError(
              UserMessage = 'This TC move is not set up properly with appropriate IATC or CATC Job Action. ' + 
                            HC_NEWLINE + 'Common location check cannot be performed as needed.',
              TraceMessage = 'No IATC/CATC Job Action. Common location check was not performed on feedercard ' + FeederName + '. Precheck failed.');
/*
** 11/19/19 Not sure why this yellow warning is here after gray dead stop
      IF AutomaticExecution = FALSE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'No IATC/CATC Job Action. Common location check was not performed on feedercard ' + FeederName
                    ); 
      ENDIF;
*/
      RETURN PU_CANCEL;
   ENDIF;

   IF TCBeingApplied = Status$CATC THEN
      TCTypeName = 'CATC';
   ELSE
      TCTypeName = 'IATC';
   ENDIF;
/*
** Check for ISO
*/
   FOR j = 1 TO CardDetails.Object.LastRow() DO
      Feeder = CardDetails.Object[j].Object;
      FeederName = CardDetails.Object[j].Name;

      ISOFeeder = 1;
      WHILE ISOFeeder <> 0 DO
         ISOFeeder = 0;
         SELECT :ISOFeeder = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :Feeder AND
                MemberType IN (:Type$ISOFeeder,:Type$KPSFeeder) AND
                Relationship = :Interaction$MemberOf AND
                GroupingType IN (SELECT Type FROM Udb_ExtendedType 
                                 WHERE  SuperType = :Type$Feeder);

         IF ISOFeeder <> 0 THEN
            Feeder = ISOFeeder;
            SELECT :FeederName = Name
            FROM   Udb_Object 
            WHERE  Object = :Feeder;
         ENDIF;
      ENDWHILE;     
   /*
   ** Now we do regular warning.
   */
      i = 0;
      SELECT  :i = COUNT(*) 
      FROM    FMS_CommonManhole CM,
              FMS_ObjectStatus OS 
      WHERE   CM.Feeder1 = :Feeder AND
              CM.Feeder2 = OS.Object AND
              OS.Status = :TCBeingApplied AND
              OS.StatusCount > 0; 
            
      IF i = 0 THEN
         SELECT  :i = COUNT(*) 
         FROM    FMS_CommonManhole CM,
                 FMS_ObjectStatus OS 
         WHERE   CM.Feeder2 = :Feeder AND
                 CM.Feeder1 = OS.Object AND
                 OS.Status = :TCBeingApplied AND
                 OS.StatusCount > 0;  
      ENDIF;

      IF i = 0 THEN
         SELECT  :i = COUNT(*) 
         FROM    FMS_CommonManhole CM,
                 FMS_ObjectStatus OS, 
                 Udb_Grouping G 
         WHERE   CM.Feeder1 = :Feeder AND
                 CM.Feeder2 = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$KPSFeeder AND
                 G.Member = OS.Object AND
                 OS.Status = :TCBeingApplied AND
                 OS.StatusCount > 0;  
      ENDIF;

      IF i = 0 THEN
         SELECT  :i = COUNT(*) 
         FROM    FMS_CommonManhole CM,
                 FMS_ObjectStatus OS, 
                 Udb_Grouping G 
         WHERE   CM.Feeder2 = :Feeder AND
                 CM.Feeder1 = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$KPSFeeder AND
                 G.Member = OS.Object AND
                 OS.Status = :TCBeingApplied AND
                 OS.StatusCount > 0;  
      ENDIF;

      IF i > 0 THEN
         WarningStatus = CALLFRAME Warning
                   ( Card = JIP.Card, 
                     Job = JIP.Job,
                     SwitchingItem = JIP.SwitchingItem, 
                     Text = 'A Common Manhole Feeder has ' + TCTypeName + ' on it. ' +
                         'Are you applying TC with a different characteristic? ' 
                   ); 
         IF (WarningStatus = PU_CANCEL) THEN
             RETURN(PU_CANCEL);
         ELSE
             RetCode = Warning$Overridden;

             IF CardDetails.Card <> 0 AND Feeder <> 0 AND FeederName <> '' THEN
                IF AutomaticExecution <> TRUE THEN
                   CALLFRAME CommonManholes (Card = CardDetails.Card,
                                             Feeder = Feeder,
                                             FeederName = FeederName);
                ENDIF;
             ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;

   RETURN (RetCode);
END; 

Application Component Report
============================

	Name:            CheckConfirm3GConfiguration

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          CheckConfirm3GConfiguration
**
**  Modification log:
**
**   01/11/11   em  Created; Based on Confirm3GConfiguration program in Feedercard app
*/
PROCEDURE CheckConfirm3GConfiguration 
(
   JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

   Card = INTEGER NOT NULL WITH DEFAULT; 
   FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   

/* local variables */
#  include StandardDeclarations

   j = INTEGER NOT NULL WITH DEFAULT;
   CardFeederList = ARRAY OF ObjectSummaryClass;
   NetworkFeederList = ARRAY OF ConnectedEquipClass;          
   WarningStatus = INTEGER;  /* return status of Warning Frame */ 
) =
BEGIN
/*
** Make sure Job appears on active 3G Card
*/
   Card = 0;
   SELECT :Card = C.Card,
          :FeederName = C.FeederName
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card AND
          C.NetworkFeeder = 1;

   IF Card = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: CheckConfirm3GConfiguration called on a non 3G Network Feeder card from ' +
                          'Card=' + VARCHAR(JIP.Card) + '; Job=' + VARCHAR(JIP.Job) );
      RETURN(NULL);
   ENDIF;
/*
**
*/
   i = 1;
   SELECT :CardFeederList[i].Object = Object
   FROM   TFMS_CardToObject
   WHERE  Card = :Card
   BEGIN
      i = i + 1;
   END;
/*
** Pass the first feeder on the card into the configuration utility then compare the 
** resulting feeder lists.
*/  
   RetCode = CALLPROC NetworkFeederTrace (
                   StartFeeder = CardFeederList[1].Object,  /*Start start with any feeder*/
                   NetworkFeederList = NetWorkFeederList);

   IF RetCode = PU_CANCEL THEN
      MESSAGE 'Network trace failed to identify 3G Feeders.';
      RETURN(PU_CANCEL);
   ENDIF;
   
   i = NetworkFeederList.LastRow();
   WHILE i > 0 DO
      j = CardFeederList.LastRow();
      WHILE j > 0 DO
         IF NetworkFeederList[i].Object = CardFeederList[j].Object THEN
            NetworkFeederList.RemoveRow (RowNumber = i);
            CardFeederList.RemoveRow (RowNumber = j);
            ENDLOOP;
         ENDIF;
         j = j - 1;
      ENDWHILE;
      i = i - 1;
   ENDWHILE;   
/*
** Compare what is left, if nothing, both lists are the same
*/
   IF NetWorkFeederList.LastRow() = 0 AND CardFeederList.LastRow() = 0 THEN
      RETURN(NULL);
   ELSE
      WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'The current 3G Network Feeder configuration does match the ' +
                           'expected configuration for card ' + :FeederName + 
                           '.  Select 3G button to initiate configuration change.' 
                    ); 
      IF (WarningStatus = PU_CANCEL) THEN
         RETURN(PU_CANCEL);
      ELSE
         RetCode = Warning$Overridden;
      ENDIF;
   ENDIF;
END;

Application Component Report
============================

	Name:            CheckDeadMovesTakenOut

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckDeadMovesTakenOut 
**
**  Modifications:
**  11/03/92 em	    Created 
**  01/09/93 em     Changed Condition which forces warning to if deadmovesto < deadmoves.
**  01/10/02 pkw    Pass in jobs array to warning frame.
**  02/08/02 pkw    Fix problem with array initialization.
**  11/19/02 ysp    Merge: removed passed-in C and Jobs
**  01/22/03 ysp    Add variable j to correct variable conflict.
**  02/28/03 pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                  that span divisions.
**  10/29/04 em     Expanded warning due to an operating error after the Dead Move
**                  had been restored. Three possible warnings if Dead Moves TO < Dead Moves Count:
**                     1) Show Dead Moves that have not been taken out.
**                     2) Show Dead Moves that have been restored.
**                     3) If there are no dead moves meeting 1 or 2, give generic warning without
**                        displaying the moves.
**  11/01/04 em     Check for and show all possible of the three warnings, not just the first.
**  11/02/04 em     For Restore moves, include all Job Status other than 'Del'
**  08/10/16 ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
**  03/06/18 pkw    ignore warnings for equipment defined as downstream of MTA Iso switch when 
**                  MTAOpen = TRUE or CardType = Auto, CIOA, OOE1.  
**  11/09/20 em     Exclude Deadmoves on feeder segment equipment fed by another feeder. 
*/
Procedure CheckDeadMovesTakenOut 
(
    JIP = JobInProgress; 
) =
DECLARE    
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;              
    CommonFeederCard = ARRAY OF FMS_Card;
    DeadMoveCount = INTEGER NOT NULL WITH DEFAULT;  /*Allows multiple warnings*/
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    TempJobs = ARRAY of JobInProgress; 
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    FilterMTAMoves = Procedure;
    FilterFedByMoves = Procedure;
ENDDECLARE
BEGIN

   i = 1;
   SELECT DISTINCT
          :CommonFeederCard[i].Card = C.Card,
          :CommonFeederCard[i].CardClass = C.CardClass,
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].DeadMovesTO = C.DeadMovesTO,
          :CommonFeederCard[i].DeadMoves = C.DeadMoves,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
          :CommonFeederCard[i].TypeOfCard = C.TypeOfCard
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card
   BEGIN 
       i = i + 1;
   END;

   RetCode = NULL;
    
   i = 1;
   WHILE i <= CommonFeederCard.LastRow() DO
      FeederName = CommonFeederCard[i].GetGeneralCardName();
      
      DeadMoveCount = CommonFeederCard[i].DeadMovesTO;
      IF DeadMoveCount < CommonFeederCard[i].DeadMoves THEN
/*
**  See what dead moves haven't been taken out.
*/
         k = 1;
         TempJobs.Clear();
         REPEATED
         SELECT :TempJobs[k].PrintId = JC.PrintId,
                :TempJobs[k].Equip = J.Equip,
                :TempJobs[k].EquipName = J.EquipName,
                :TempJobs[k].EquipClassName = J.EquipClassName,
                :TempJobs[k].ToMove = J.ToMove,
                :TempJobs[k].Job = J.Job
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                JC.StepPair = :StepHeading$DeadMove AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
                J.TOComplete IS NULL AND
                J.Status = ''
         BEGIN
            k = k + 1;
         END;

         CALLPROC FilterMTAMoves(CardClass = CommonFeederCard[i].CardClass);
         CALLPROC FilterFedByMoves();

         IF TempJobs.LastRow() > 0 THEN
            DeadMoveCount = DeadMoveCount + TempJobs.LastRow();
            WarningStatus = CALLFRAME Warning 
                         (Card = JIP.Card, 
                          Job = JIP.Job, 
                          SwitchingItem = JIP.SwitchingItem,
                          Jobs = TempJobs,
                          Text = 'Some dead moves have not been take out from feeder ' +
                                 FeederName + '. ' + 
                                 'Please confirm each move if you wish to continue.');
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_Cancel);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;
/* 
**  See if there are any deadmoves that have been restored.
*/
      IF DeadMoveCount < CommonFeederCard[i].DeadMoves THEN
         k = 1;
         TempJobs.Clear();
         REPEATED
         SELECT :TempJobs[k].PrintId = JC.PrintId,
                :TempJobs[k].Equip = J.Equip,
                :TempJobs[k].EquipName = J.EquipName,
                :TempJobs[k].EquipClassName = J.EquipClassName,
                :TempJobs[k].ToMove = J.ToMove,
                :TempJobs[k].Job = J.Job
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                JC.StepPair = :StepHeading$DeadMove AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
                J.TOComplete IS NOT NULL AND J.TOComplete <> '' AND
                J.RSComplete IS NOT NULL AND J.RSComplete <> '' AND
                J.Status <> 'Del'
         BEGIN
            k = k + 1;
         END;

         CALLPROC FilterMTAMoves(CardClass = CommonFeederCard[i].CardClass);
         CALLPROC FilterFedByMoves();

         IF TempJobs.LastRow() > 0 THEN
            DeadMoveCount = DeadMoveCount + TempJobs.LastRow();
            WarningStatus = CALLFRAME Warning 
                         (Card = JIP.Card, 
                          Job = JIP.Job, 
                          SwitchingItem = JIP.SwitchingItem,
                          Jobs = TempJobs,
                          Text = 'Some Dead Moves need to be taken out from feeder ' +
                                 FeederName + ' but have ' +
                                 'already been restored. ' + 
                                 'Please confirm each move if you wish to continue.');
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_Cancel);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;
/*
** If DeadMoveCount is still less than the number on the card, then
** we give this last warning indicating dead moves for HV Sensitive equip
** have been deleted.
*/
      IF DeadMoveCount < CommonFeederCard[i].DeadMoves THEN
  
         WarningStatus = CALLFRAME Warning 
                         (Card = JIP.Card, 
                          Job = JIP.Job, 
                          SwitchingItem = JIP.SwitchingItem,
                          Text = 'Dead Moves still need to be taken out from feeder ' +
                                 FeederName + '. The dead moves may have ' +
                                 'been deleted and/or need to be added to the card');
         IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_Cancel);
         ELSE
               RetCode = Warning$Overridden;
         ENDIF;
      ENDIF;

      i = i + 1;
   ENDWHILE;

   RETURN(RetCode);
END;

PROCEDURE FilterMTAMoves (
   CardClass = INTEGER NOT NULL;
) =
DECLARE
   DownstreamCheck = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   IF TempJobs.LastRow = 0 THEN
      RETURN;
   ENDIF;
   
   IF MTAOpen = TRUE OR
      CardClass = Type$Auto OR
      CardClass = Type$CIOA OR
      CardClass = Type$OOE1 THEN
      
      i = 1;
      WHILE i <= TempJobs.LastRow DO
         DownstreamCheck = 0;
         SELECT :DownstreamCheck = COUNT(*)
         FROM    Udb_Grouping G
         WHERE   G.Member = :TempJobs[i].Equip AND
                 G.Relationship = :Interaction$MTADownstreamOf;
         
         IF DownstreamCheck <> 0 THEN
            TempJobs.RemoveRow (Rownumber = i);
            DeadMoveCount = DeadMoveCount + 1;
         ELSE
            i = i + 1;
         ENDIF;        
      ENDWHILE;
   ENDIF;

   RETURN;
END;

PROCEDURE FilterFedByMoves (
) =
DECLARE
   j = INTEGER NOT NULL WITH DEFAULT;
   FedByExists = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CommonFeederCard[i].NetworkFeeder  = NetworkFeeder$33KV THEN
      j = 1;
      WHILE j <= TempJobs.LastRow DO
          FedByExists = 0;
		  SELECT :FedByExists = G2.Grouping
		  FROM    Udb_Grouping G,
		          Udb_Grouping G2
		  WHERE   G.Member = :TempJobs[j].Equip AND
		          G.RelationShip = :Interaction$MemberOf AND
		          G.GroupingType = :Type$FeederSegment AND
		          G.Grouping = G2.Member AND
		          G2.RelationShip = :Interaction$FedBy;
		  
          IF FedByExists > 0 THEN                     
             TempJobs.RemoveRow (Rownumber = j);
             DeadMoveCount = DeadMoveCount + 1;
          ELSE
             j = j + 1;
          ENDIF;
      ENDWHILE;
   ENDIF;

   RETURN; 
END;

Application Component Report
============================

	Name:            CheckDeclutchFromLoad

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckDeclutchFromLoad  
**
**  Modifications:
**	11/15/11   kw	Created 
*/
PROCEDURE  CheckDeclutchFromLoad 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER NOT NULL WITH DEFAULT;
    ATSSourceEquip = ObjectSummaryClass;  
    FeederOut = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Using Grouper Membership, make sure the 101 and 102 Feeders are declutched
*/ 

  RetCode = NULL;
  i = 0;

  REPEATED
  SELECT :i = COUNT(*)
  FROM   FMS_ObjectStatus OS,
         Udb_Grouping G1,
         Udb_Grouping G2,
         Udb_Extendedtype ET1,
         Udb_Extendedtype ET2
  WHERE  ET1.Supertype = :Type$ATSGrouper AND
         ET2.Supertype = :Type$ATS101 AND
         OS.Status = :Status$Declutch AND
         G1.Member = :JIP.Equip AND
         G2.relationship = :Interaction$MemberOf AND
         G1.relationship = :Interaction$MemberOf AND
         G1.Groupingtype = ET1.type AND
         G1.Grouping = G2.Grouping AND
         G2.Membertype = ET2.Type AND
         G2.Member = OS.Object;
         CALLPROC DDB_ROLLBACK;
  
  WarningStatus = PU_OK;
  
  IF i < 1 THEN
    
    WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
	                               Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem,
                                       Text = 'ATS 101 Source Feeder is not declutched.');
    IF (WarningStatus = PU_CANCEL) THEN
       RETURN(PU_CANCEL);
    ELSE
       RetCode = Warning$Overridden;
    ENDIF;
 
  ENDIF;

  i = 0;
  REPEATED
  SELECT :i = COUNT(*)
  FROM   FMS_ObjectStatus OS,
         Udb_Grouping G1,
         Udb_Grouping G2,
         Udb_Extendedtype ET1,
         Udb_Extendedtype ET2
  WHERE  ET1.Supertype = :Type$ATSGrouper AND
         ET2.Supertype = :Type$ATS102 AND
         OS.Status = :Status$Declutch AND
         G1.Member = :JIP.Equip AND
         G2.relationship = :Interaction$MemberOf AND
         G1.relationship = :Interaction$MemberOf AND
         G1.Groupingtype = ET1.type AND
         G1.Grouping = G2.Grouping AND
         G2.Membertype = ET2.Type AND
         G2.Member = OS.Object;
         CALLPROC DDB_ROLLBACK;
  
  WarningStatus = PU_OK;
  
  IF i < 1 THEN
    
    WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
	                               Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem,
                                       Text = 'ATS 102 Source Feeder is not declutched.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
       RetCode = Warning$Overridden;
    ENDIF;
 
  ENDIF;

  RETURN(RetCode); 

END;

Application Component Report
============================

	Name:            CheckDeclutchFromMacro

/*
**
**	Copyright c 2012 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckDeclutchFromMacro  
**
**  Modifications:
**	06/05/12   em	Created from CheckDeclutchFromLoad 
**      06/18/12   em   Add Pending Status
*/
PROCEDURE  CheckDeclutchFromMacro
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    Operator         = INTEGER;  /*Operator to use for pending status check*/
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    ATSSourceEquip = ObjectSummaryClass;  
    FeederOut = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    IF JIP.Status = Job$Restore THEN
       Operator = JIP.RSOperator;
    ELSE
       Operator = JIP.TOOperator;
    ENDIF;
/*
**  Starting from Macro relationship, make sure the 101 and 102 Feeders are declutched
*/ 
  RetCode = NULL;
  i = 0;
  j = 0;
  REPEATED
  SELECT :i = COUNT(*)
  FROM   FMS_ObjectStatus OS,
         Udb_Grouping G,
         Udb_Extendedtype ET1,
         Udb_Extendedtype ET2
  WHERE  ET1.Supertype = :Type$ATSGrouper AND
         ET2.Supertype = :Type$ATS101 AND
         OS.Status = :Status$Declutch AND
         G.Grouping = :JIP.Equip AND
         G.Relationship = :Interaction$MemberOf AND
         G.Groupingtype = ET1.Type AND
         G.Membertype = ET2.Type AND
         G.Member = OS.Object;

  IF i > 0 THEN
    SELECT  :j = COUNT(*) 
    FROM    FMS_PendingStatus PS,
            Udb_Grouping G,
            Udb_Extendedtype ET1,
            Udb_Extendedtype ET2
    WHERE  ET1.Supertype = :Type$ATSGrouper AND
           ET2.Supertype = :Type$ATS101 AND
           PS.PendingStatus = :Status$Declutch AND
           PS.StatusCount = 0 AND
           PS.IssuedOperator = :Operator AND
           G.Grouping = :JIP.Equip AND
           G.Relationship = :Interaction$MemberOf AND
           G.Groupingtype = ET1.type AND
           G.Membertype = ET2.Type AND
           G.Member = PS.Object;
  ENDIF;
 
  WarningStatus = PU_OK; 
  IF i > 0 AND j = 0 THEN
    
    WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
	                               Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem,
                                       Text = 'ATS 101 Source Feeder is declutched.');
    IF (WarningStatus = PU_CANCEL) THEN
       RETURN(PU_CANCEL);
    ELSE
       RetCode = Warning$Overridden;
    ENDIF;
 
  ENDIF;

  i = 0;
  j = 0;
  REPEATED
  SELECT :i = COUNT(*)
  FROM   FMS_ObjectStatus OS,
         Udb_Grouping G,
         Udb_Extendedtype ET1,
         Udb_Extendedtype ET2
  WHERE  ET1.Supertype = :Type$ATSGrouper AND
         ET2.Supertype = :Type$ATS102 AND
         OS.Status = :Status$Declutch AND
         G.Grouping = :JIP.Equip AND
         G.relationship = :Interaction$MemberOf AND
         G.Groupingtype = ET1.type AND
         G.Membertype = ET2.Type AND
         G.Member = OS.Object;
  
  IF i > 0 THEN
    SELECT  :j = COUNT(*) 
    FROM    FMS_PendingStatus PS,
            Udb_Grouping G,
            Udb_Extendedtype ET1,
            Udb_Extendedtype ET2
    WHERE  ET1.Supertype = :Type$ATSGrouper AND
           ET2.Supertype = :Type$ATS102 AND
           PS.PendingStatus = :Status$Declutch AND
           PS.StatusCount = 0 AND
           PS.IssuedOperator = :Operator AND
           G.Grouping = :JIP.Equip AND
           G.Relationship = :Interaction$MemberOf AND
           G.Groupingtype = ET1.type AND
           G.Membertype = ET2.Type AND
           G.Member = PS.Object;
  ENDIF;

  WarningStatus = PU_OK;
  IF i > 0 AND j = 0 THEN
    
    WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
	                               Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem,
                                       Text = 'ATS 102 Source Feeder is declutched.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
       RetCode = Warning$Overridden;
    ENDIF;
 
  ENDIF;

  RETURN(RetCode); 

END;

Application Component Report
============================

	Name:            CheckDeloadComplete

/*
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckDeloadComplete
**
**  Date:     Version  Description
** --------------------------------------------------
**  08/16/95    pw     Created to check deload complete on 4kv Cards
**  12/20/99    em     Make sure no deload moves have been restored.  Also
**                     made this check work for multiple common feeders.
**  04/24/00    pkw    If a move has a movetype of ISL or NONE, it will
**                     not cause a deload warning. All other move types will.
**  11/18/02    ysp    Merge:check deload moves on all cards including cards 
**                     that the equipment is common to.
**  01/15/03    ysp    Pass in jobs array to warning frame.
**  02/28/03    pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                     that span divisions.
**  05/06/03    em     Add support for CIOA type
**  02/03/05    pkw    Include filtered moves on check.
**  04/10/07    ysp    ITC203: Remove Move$Filtered as a job status.
**  11/05/10    em     3G Feeder Support
**  04/07/11    em     Add Feeder Restriction check logic here (moved from feedercard)
**  05/31/11    em     Add distinct to feeder restriction select to eliminate duplicates
**  01/03/12    em     Ignore Feeder Restriction that have been lifted.
**  04/27/16    em     Changes in support of 33kV network feeders. Use FeederObjects to
**                     to access feeder segment moves instead of looking at whole card.
**  05/26/16    em     3G considers SP as Source, 33kV should not.
**  06/27/16    em     For 33kV card segments, add Network Protection feeder status check
**  09/13/16    em     For 33kV source, call deloadcomplete trace with source segment option
**  08/09/17    ysp    For 33kv section, give a warning if not all Sensitive type equipment have
**                     currently-open status.
*/
PROCEDURE CheckDeloadComplete
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL; 
    k = INTEGER NOT NULL; 
    AllDLJobs = ARRAY of Job;  
    CommonFeederCard = ARRAY OF FMS_Card;
    DynamicFeederList = VARCHAR(120) NOT NULL WITH DEFAULT;   
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;   
    FedByExists = INTEGER NOT NULL; 
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;   
    FeederObjects = ARRAY OF INTEGEROBJECT;                
    NetworkFeederSource = INTEGER NOT NULL WITH DEFAULT;  
    SensitiveDevice = ARRAY OF Equipment;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
/*
**    Find all feeder cards where this job appears.
**    If no cards then nothing more to do. 
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CommonFeederCard[i].Card = C.Card,
          :CommonFeederCard[i].CardClass = C.CardClass,
          :CommonFeederCard[i].CutIn = C.CutIn,
          :CommonFeederCard[i].CutOut = C.CutOut,
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].Feeder = C.Feeder,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder
   FROM    SOA_JobControl JC,
           SOA_ActiveCard AC,
           FMS_Card C
   WHERE   JC.Job = :JIP.Job AND
           JC.Card = C.Card AND
           JC.Card = AC.Card
   BEGIN
      i = i + 1;
   END;
   
   IF i = 1 THEN
      RETURN(NULL); 
   ENDIF;
/*
**  Do check unless (Open Auto OR OOE1 card type) AND equip is the 
**  source breaker or source position.
*/
   RetCode = NULL;
   
   FOR i = 1 TO CommonFeederCard.LastRow() DO
      NetworkFeederSource = 0;
      IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$3G THEN
/*
** Selecting Network Source info here, will use it later in two spots, 
** second spot is specfic to 33kV handling. 3G consider this a source
** if SB or SP.
*/
         REPEATED
         SELECT :NetworkFeederSource = COUNT(*)
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Member = :JIP.Equip AND
               (G.Relationship = :Interaction$SourceBreaker OR
                G.Relationship = :Interaction$SourcePosition); 
 
      ELSEIF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
/*
** 33kV Source look for SB only
*/
         REPEATED
         SELECT :NetworkFeederSource = COUNT(*)
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Member = :JIP.Equip AND
                G.Relationship = :Interaction$SourceBreaker;  
      ENDIF;         

      IF CommonFeederCard[i].CardClass = Type$OOE1 OR
         CommonFeederCard[i].CardClass = Type$Auto OR
         CommonFeederCard[i].CardClass = Type$CIOA THEN 

         k = 0;
         IF CommonFeederCard[i].NetworkFeeder <> 0 THEN
            k = NetworkFeederSource;
         ELSE
            SELECT :k = COUNT(*)
            FROM   Udb_Grouping
            WHERE  Grouping = :CommonFeederCard[i].Feeder AND
                   Member = :JIP.Equip AND
                  (Relationship = :Interaction$SourceBreaker OR
                   Relationship = :Interaction$SourcePosition);
         ENDIF;

         IF k > 0 THEN  /* Skip deload complete on Auto */
            CONTINUE;
         ENDIF;

      ELSE
/* 
** Feeder Restriction check is applied only to non-auto card types
*/
         FeederName = '';
         k = 1;
         REPEATED
         SELECT  
         DISTINCT  :FeederName = O.Name
         FROM    FMS_FeederRestriction FR,
                 TFMS_CardToObject CTO,
                 Udb_Object O
         WHERE   CTO.Card = :CommonFeederCard[i].Card AND
                 CTO.Object = O.Object AND
                 O.Object = FR.Feeder AND
                 FR.Lifted = 0
         BEGIN
            IF k > 1 THEN
               FeederNames = FeederNames + ',';
            ENDIF;
            FeederNames = FeederNames + FeederName;
            k = k + 1;
         END;

         IF FeederNames <> '' THEN
            WarningStatus = CALLFRAME Warning
                 (Card = JIP.Card, 
                  Job = JIP.Job, 
                  SwitchingItem = JIP.SwitchingItem,
                  Text = 'Feeder ' + FeederNames + ' has Engineering Restrictions on it.'
                 ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;
/*
**  If we have a 33kV card we want to look at only the feeder segments 
**  that are associated to the card. 
**  If we are calling this check from a
**  source breaker equipment, then we can build equipment list from
**  segments associated to the card including segments fed by the main 
**  feeder while excluding segments fed by another feeder.  
**  If we are opening an interrupter switch
**  then we perform a trace to see if we will be isolating a portion and then 
**  only use the segments being isolated. 
*/  
      FedByExists = FALSE;
      FeederObjects.Clear();
      IF CommonFeederCard[i].NetworkFeeder = NetworkFeeder$33kV THEN
         IF NetworkFeederSource > 0 THEN  /* Indicates source breaker */

            SELECT :NetworkFeederSource = CTO.Object
            FROM   TFMS_CardToObject CTO
            WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Type = :Type$SourceSegment;

            RetCode = CALLPROC DeloadTrace33kV (
                           StartEquip = :NetworkFeederSource,
                           FeederSegments = ByRef(FeederObjects),
                           SourceSegmentOption = TRUE);
            IF RetCode = PU_CANCEL THEN
               RETURN (PU_CANCEL);
            ENDIF;
/* obsolete
** Trying to replace with a trace.
**
            j = 1;
            SELECT :FeederObjects[j].Value = CTO.Object
            FROM   TFMS_CardToObject CTO,
                   Udb_ExtendedType ET
            WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                   CTO.Type = ET.Type AND
                   ET.SuperType = :Type$Feeder
            BEGIN
/*
** If this feeder segment is fed by another feeder then remove it
*
                k = 0;
                SELECT :k = Grouping
                FROM   Udb_Grouping
                WHERE  Relationship = :Interaction$FedBy AND
                       Member = :FeederObjects[j].Value;
                IF k > 0 THEN
                   FeederObjects.RemoveRow (rownumber = j);
                ELSE  
                   k = j;     
                   j = j + 1;
/*
** If this feeder feeds another segment, then include that segment
*
                   SELECT :FeederObjects[j].Value = Member
                   FROM   Udb_Grouping
                   WHERE  Relationship = :Interaction$FedBy AND
                          Grouping = :FeederObjects[k].Value
                   BEGIN
                      FedByExists = TRUE;
                      j = j + 1;
                   END;
                ENDIF;
             END; 
*/
         ELSE     /* Indicates non-source equip, interruptor switch */
/*
** If equipment being opened is already on a portion card, 
** it is already isolated and we aren't
** isolating anything new that requires a Deload Complete check.
*/
            k = 0;
            REPEATED
            SELECT :k = AC.Card
            FROM   Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   SOA_ActiveCard AC
            WHERE  G.Member = :JIP.Equip AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Grouping = CTO.Object AND
                   CTO.Card = AC.Card AND
                   AC.TypeOfCard = :TypeOfCard$Portion;
/*
** Call trace to return feeder segments that will be isolated.  If none returned, then we aren't isolating
** and don't need to do deload complete check.
*/
            IF k = 0 THEN
               RetCode = CALLPROC DeloadTrace33kV (
                              StartEquip = :JIP.Equip,
                              FeederSegments = ByRef(FeederObjects));
               IF RetCode = PU_CANCEL THEN
                  RETURN (PU_CANCEL);
               ENDIF;
            ENDIF;                  
         ENDIF;
/*
** If FeederObjects array is empty on a 33kV card, that means we are not isolating anything 
*/
         IF FeederObjects.LastRow() = 0 THEN
            CONTINUE;
         ENDIF;
      ENDIF;
/*
**  For each card, check for Deload moves complete and that no restore 
**  moves are complete.
**  33kV deload complete check is based on feeder segments not the card.  
**  Also check feeder segment NWP status.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicFeederList = '';
         DynamicWhereClause = '';
         FOR k = 1 TO FeederObjects.LastRow() DO
            IF k = 1 THEN
               DynamicFeederList = ' (' + VARCHAR(FeederObjects[k].Value);
            ELSE
               DynamicFeederList = DynamicFeederList + ',' + VARCHAR(FeederObjects[k].Value);
            ENDIF;  
         ENDFOR;
         DynamicFeederList = DynamicFeederList + ') ';

         DynamicWhereClause = 'Object IN ' + DynamicFeederList + ' AND ' +
                              'StatusCount > 0 AND ' +
                              'Status = ' + VARCHAR(Status$NetWProt);
         k = 0;
         SELECT :k = COUNT(*)
         FROM   FMS_ObjectStatus
         WHERE  :DynamicWhereClause;

         IF k > 0 THEN
            WarningStatus = CALLFRAME Warning
                     ( Card = JIP.Card, 
                       Job = JIP.Job, 
                       SwitchingItem = JIP.SwitchingItem,
                       Text = 'A Feeder Segment still has a Network Protector Check requirement.' 
                     ); 
            IF (WarningStatus = PU_CANCEL) THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;       
             
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               'JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NULL AND ' +
               'J.Status = ' + '''' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'ISL' + '''' + ' AND ' +
               'J.MoveType <> ' + '''' + 'NONE' + ''''; 

         k = 1;
         TempJobs.Clear();
         SELECT DISTINCT 
                :TempJobs[k].PrintID = JC.PrintID,
                :TempJobs[k].EquipName = J.EquipName,
                :TempJobs[k].EquipClassName = J.EquipClassName,
                :TempJobs[k].ToMove = J.ToMove,
                :TempJobs[k].Job = J.Job
         FROM   SOA_Job J, 
                SOA_JobControl JC,
                Udb_Grouping G,
                SOA_ActiveObject AO
         WHERE  :DynamicWhereClause
         BEGIN
            k = k + 1;
         END;

      ELSE     /*Normal DeloadComplete*/
         k = 1;
         TempJobs.Clear();
         REPEATED
         SELECT :TempJobs[k].PrintId = JC.PrintId,
                :TempJobs[k].EquipName = J.EquipName,
                :TempJobs[k].EquipClassName = J.EquipClassName,
                :TempJobs[k].ToMove = J.ToMove,
                :TempJobs[k].Job = J.Job
         FROM   SOA_Job J, 
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND
                JC.StepPair = :StepHeading$Deload AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
                J.TOComplete IS NULL AND
                J.Status = '' AND
                J.MoveType <> 'ISL' AND
                J.MoveType <> 'NONE'
         BEGIN
            k = k + 1;
         END;
      ENDIF;
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
      IF FedByExists = TRUE THEN
         FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
      ELSE
         FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
      ENDIF;

      IF TempJobs.LastRow() > 0 THEN
           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      Jobs = TempJobs,
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Not all Deload moves have been completed ' + FeederName + 
                             '. Please confirm each move if you wish to continue.'
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;
      ENDIF;       
/*
**  See if there are any moves that have been restored.  If there
**  are, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
**  33kV deload move check is based on feeder segments not the card.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               'JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               '(J.RSComplete IS NOT NULL AND J.RSComplete <> '''') AND ' + 
               'J.Status = '''' AND ' +
               'J.MoveType <> ''ISL'' AND ' +
               'J.MoveType <> ''NONE'''; 

         k = 1;
         TempJobs.Clear();
         SELECT :TempJobs[k].Job = J.Job,
                :TempJobs[k].JobClass = J.JobClass,
                :TempJobs[k].Equip = J.Equip
         FROM   SOA_Job J, 
                SOA_JobControl JC,
                Udb_Grouping G,
                SOA_ActiveObject AO
         WHERE  :DynamicWhereClause
         BEGIN
            k = k + 1;
         END;

      ELSE  /*Normal DeloadComplete*/

         k = 1;
         TempJobs.Clear();
         REPEATED
         SELECT :TempJobs[k].Job = J.Job,
                :TempJobs[k].JobClass = J.JobClass,
                :TempJobs[k].Equip = J.Equip
         FROM   SOA_Job J,
                SOA_JobControl JC
         WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                JC.StepPair = :StepHeading$Deload AND
                JC.Job = J.Job AND
                J.JobClass <> 0 AND 
               (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
                J.Status = '' AND
                J.MoveType <> 'ISL' AND
                J.MoveType <> 'NONE'
         BEGIN
            k = k + 1;
         END;
      ENDIF;
 
      IF TempJobs.LastRow() > 0 THEN
         /*
         ** Get all De-Load moves from this card 
         */
         IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */

            DynamicWhereClause = 
               'J.Equip = G.Member AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Grouping = AO.Object AND ' +
               'AO.Object IN ' + DynamicFeederList + ' AND ' +
               'AO.Card = JC.Card AND ' + 
               'JC.StepPair = ' + VARCHAR(StepHeading$Deload) + ' AND ' +
               'JC.Job = J.Job AND ' + 
               'J.JobClass <> 0 AND ' + 
               'J.TOComplete IS NOT NULL AND ' +
               'J.RSComplete IS NULL AND ' +
               'J.Status = ''''';  

            k = 1;
            AllDLJobs.Clear();
            SELECT :AllDLJobs[k].Job = J.Job,
                   :AllDLJobs[k].JobClass = J.JobClass,
                   :AllDLJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_Grouping G,
                   SOA_ActiveObject AO
            WHERE  :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;

         ELSE  /*Normal DeloadComplete*/

            k = 1;
            AllDLJobs.Clear();
            REPEATED
            SELECT :AllDLJobs[k].Job = J.Job,
                   :AllDLJobs[k].JobClass = J.JobClass,
                   :AllDLJobs[k].Equip = J.Equip
            FROM   SOA_Job J,
                   SOA_JobControl JC
            WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                   JC.StepPair = :StepHeading$Deload AND
                   JC.Job = J.Job AND
                   J.JobClass <> 0 AND 
                   J.TOComplete IS NOT NULL AND 
                   J.RSComplete IS NULL AND
                   J.Status = '' 
            BEGIN
                 k = k + 1;
            END;
         ENDIF;

         k = 1;
         WHILE k <= AllDLJobs.LastRow() AND TempJobs.LastRow() > 0 DO

            IF AllDLJobs[k].JobClass = TempJobs[1].JobClass AND
               AllDLJobs[k].Job <> TempJobs[1].Job AND
               AllDLJobs[k].Equip = TempJobs[1].Equip THEN
               
               TempJobs.RemoveRow (Rownumber = 1);
               k = 0; 
            ENDIF;
            k = k + 1;
         ENDWHILE;

         IF TempJobs.LastRow() > 0 THEN
/* 
** On 33kV feeder, this warning is not showing the name for the other
** feeder when the violating move is on a 'fed by' segment. Might need to
** add a special warning for that condition.
*/
            IF FedByExists = TRUE THEN
               FeederName = 'for equipment on or "Fed By" feeder ' + CommonFeederCard[i].FeederName;
            ELSE
               FeederName = 'on feedercard ' + CommonFeederCard[i].FeederName;
            ENDIF;
            WarningStatus = CALLFRAME Warning
                      ( Card = JIP.Card, 
                        Job = JIP.Job,
                        SwitchingItem = JIP.SwitchingItem, 
                        Text = 'A Deload move has been Restored ' +
                            FeederName + '. You must ' +
                            'confirm that the necessary Deload moves ' +
                            'have been Taken Out.'
                      ); 
            IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
            ELSE
                RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;   
      ENDIF;
/*
** for a 33kv, look for Sensitive type equipment in the section. If Sensitive type equipment exists,
** then also look for a Reactor type equipment (shuntReact). If no Reactor exists, then all Sensitive
** type equipment in the section must have currently-open status.
*/
      IF FeederObjects.LastRow() > 0 THEN  /* Isolated Feeder Segments */
         DynamicWhereClause = 
               'G.Grouping IN ' + DynamicFeederList + ' AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Member = O.Object AND ' +
               'O.Type = ' + VARCHAR(Type$ShuntReact); 
         k = 0;
         SELECT :k = Count(*) 
         FROM   UDB_Grouping G,
                UDB_Object O
         WHERE  :DynamicWhereClause;
         
         IF k = 0 THEN     // No reactor type equipment
            DynamicWhereClause = 
               'G.Grouping IN ' + DynamicFeederList + ' AND ' +
               'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
               'G.Member = O.Object AND ' +
               'O.Type IN (' + VARCHAR(TypeName$I) + ',' +
                               VARCHAR(TypeName$S) + ',' +
                               VARCHAR(TypeName$ST) + ',' +
                               VARCHAR(TypeName$STP) + ',' +
                               VARCHAR(TypeName$INF) + ',' + 
                               VARCHAR(TypeName$SNF) + ',' + 
                               VARCHAR(TypeName$STNF) + ') AND ' +                  // S, S-NF, S-T, S-T-NF, S-T-P, I, I-NF
               'O.Object = S.Object AND ' +
               'S.CurrentlyOpen = 0'; 
               
            k = 1;
            SELECT :SensitiveDevice[k].EquipClassName = O.TypeName,
                   :SensitiveDevice[k].EquipName = O.Name
            FROM   UDB_Grouping G,
                   UDB_Object O,
                   UDB_Switch S
            WHERE :DynamicWhereClause
            BEGIN
               k = k + 1;
            END;
            
            IF k > 1 THEN
               WarningStatus = CALLFRAME Warning
                         ( Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = 'Equipment ' + SensitiveDevice[1].EquipClassName + ' ' + SensitiveDevice[1].EquipName + 
                                  ' must be blocked open prior to opening Interrupter Switch ' + 
                                  JIP.EquipClassName + ' ' + JIP.EquipName
                         ); 
               IF (WarningStatus = PU_CANCEL) THEN
                   RETURN(PU_CANCEL);
               ELSE
                   RetCode = Warning$Overridden;
               ENDIF;            
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR; 

   RETURN (RetCode);    
END; 

