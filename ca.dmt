**
**  04/19/07  ysp   created
*/
Method Load(
) = 
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;           /* Temporary counter  */
ENDDECLARE
BEGIN
   CurObject.EL.Clear();
   i = 1;
   SELECT :CurObject.EL[i].Time = Time,
          :CurObject.EL[i].ID = ID,
          :CurObject.EL[i].ToApp = ToApp,
          :CurObject.EL[i].FromApp = FromApp,
          :CurObject.EL[i].Name = Name,
          :CurObject.EL[i].Text = Text,
          :CurObject.EL[i].Attempt = Attempt
   FROM   FMS_DBEventQueue
   ORDER BY Time ASC
   BEGIN 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

Application Component Report
============================

	Name:            IR_FODOrder


���pH�x��Component Method Scripts
���pH�x��--------------------------
/*
**
**      Copyright c 2007 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          IR_FODOrder
**
**  Date:       Version Description
** ----------------------------------
**  06/08/07    em     created
**  04/02/08    em     Remove Fault Phase case
**  04/15/22    em     Update in support of 3G to save a non -1 feeder.
*/ 
METHOD GenerateOrder (
   Card  	= INTEGER NOT NULL;
)=
DECLARE
   ControlText = VARCHAR(40) NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   FODMoveType = VARCHAR(40) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   MessageField = VARCHAR(400) NOT NULL WITH DEFAULT;
   MsgKey = INTEGER NOT NULL WITH DEFAULT;
   MainFeeder = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TORS = INTEGER NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   
BEGIN
/*
** Create Operating Order and link moves to the order.
*/
   CurObject.Feeder = 0;
   FeederName = '';
   SELECT :CurObject.Feeder = Feeder,
          :FeederName = FeederName,
          :NetworkFeeder = NetworkFeeder,
          :TypeOfCard = TypeOfCard
   FROM   FMS_Card 
   WHERE  Card = :Card;
/*
** If the order is issued from a 33k portion card, set the order feeder to be the main feeder
*/
   MainFeeder = 0;
   IF NetworkFeeder = NetworkFeeder$33KV AND TypeOfCard = TypeOfCard$Portion THEN
      SELECT :MainFeeder = C.Feeder
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :Card AND
             L.Card = C.Card;

   ELSEIF NetworkFeeder = NetworkFeeder$3G THEN
      REPEATED
      SELECT :MainFeeder = O.Object
      FROM   Udb_Object O,
             TFMS_CardToObject CTO,
             Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  CTO.Card = :Card AND
             CTO.Type = ET.Type AND
             ET.SuperType = :Type$Feeder AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$SourceBreaker AND
             G.Grouping = O.Object;
   ELSE
      MainFeeder = CurObject.Feeder;
   ENDIF;   
   CALLPROC DDB_ROLLBACK;
   
   IF MainFeeder = 0 THEN
         MESSAGE 'Error identifying main feeder from the NetworkFeeder.  Unable to build FOD order without it.';
         RETURN PU_CANCEL;
   ENDIF;   
   

   CurObject.OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
   IF (CurObject.OrderNumber < 0) THEN
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Error: Could not generate an Order Number. ' +
               'Udb_Lastkey table may not be synchronous between servers. ';
       RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC IR_FODOrderIns (
                                        OrderNumber = CurObject.OrderNumber,
                                        Feeder = MainFeeder,
                                        Card = Card,
                                        OrderStatus = Order$Opened,
                                        SequenceType = 'SEQUENCED',
                                        IssuedByDO = DOp.Description,
                                        FODEmployeeObject = CurObject.FODEmployeeObject,
                                        OrderComment = CurObject.OrderComment,
                                        OrderTarget = 'FOD',
                                        IssueTime = 'now',
                                        Priority = '');
                                       
   IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to generate new FOD' + 
                ' Order due to an error.';
        RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   FOR i = 1 TO CurObject.Moves.LastRow() DO 
      IF CurObject.Moves[i].Status = Job$Restore THEN
         TORS = 1;
      ELSEIF CurObject.Moves[i].Status = Job$TakeOut THEN
         TORS = 0;
      ENDIF;
      /*
      ** determine the move type and set the parameter values
      */
      j = 0;
      SELECT :j = Status
      FROM    FMS_JobAction
      WHERE   JobClass = :CurObject.Moves[i].JobClass AND
              EquipClass = :CurObject.Moves[i].MoveEquipClass AND
              StepPair = :CurObject.Moves[i].StepPair AND
              TypeOfCard = :TypeOfCard AND
              TORS = :TORS AND
              IssueCompl = 1 AND                                     /* look for prompts at move completion time */
              Action = :JobAction$Prompt AND
              Status IN(:Prompt$CheckDBF,
                        :Prompt$HighPotDist,:Prompt$ModHighPotDist,:Prompt$ACHighPotDist,
                        :Prompt$AmmeterClearDist,
                        :Prompt$Phases,
                        :Prompt$Relay);

      IF j = Prompt$CheckDBF THEN                   /* Dead Back Feed */
         FODMoveType = 'DEAD_ON_BACKFEED';

      ELSEIF j = Prompt$HighPotDist THEN            /* High Pot */
         FODMoveType = 'HIGHPOT';

      ELSEIF j = Prompt$ModHighPotDist THEN         /* Mod High Pot */
         FODMoveType = 'MODHIGHPOT';

      ELSEIF j = Prompt$ACHighPotDist THEN          /* AC High Pot */
         FODMoveType = 'ACHIGHPOT';

      ELSEIF j = Prompt$AmmeterClearDist THEN       /* ammeter clear */ 
         FODMoveType = 'AMMETER_CLEAR';

      ELSEIF j = Prompt$Phases THEN                 /* CATC Phases */
         FODMoveType = 'CATC_PHASES';

      ELSEIF j = Prompt$Relay  THEN  /* Target Relays */
         FODMoveType = 'TARGET_RELAY';

      ELSEIF j = Prompt$EnterFault THEN             /* Fault */
         FODMoveType = 'FAULT';

      ELSE
         FODMoveType = 'GENERAL'; 
      ENDIF;

      RetCode = CALLPROC IR_FODOrderJobsIns (
                                        OrderNumber = CurObject.OrderNumber,
                                        Seq = i,
                                        TORS = TORS,
                                        JobStatus = Order$Opened,
                                        PhaseCheckReq = 0,
                                        Job = CurObject.Moves[i].Job,
                                        MoveType = FODMoveType);
      IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to link job to new FOD ' + 
                ' Order due to an error.';
        RETURN PU_CANCEL;
      ENDIF;

   ENDFOR;
   CALLPROC DDB_COMMIT;
 
      MessageField = 'FOD Order ' + varchar(CurObject.ordernumber) + 
                  ' has been issued'; 

      RetCode = CALLPROC SOA_LogIns (Card = Card,
                                  SwitchingItem = 0,
                                  Job  = CurObject.Moves[1].Job,
                                  Time = DATE('now'),
                                  UserName = UserName,
                                  Item            = 'FOD Order',
                                  Old             = '',
                                  New             = 'Order Number: ' +
                                                 Varchar(CurObject.OrderNumber));
  
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to log generation of FOD' + 
              ' Order due to an error.';
   ELSE   
      CALLPROC DDB_COMMIT;
   ENDIF; 

/*
** Now insert message for tracking purposes.
*/
      MsgKey = CALLPROC MSG_SendMsg (Card = Card,
                                  Action = 0,
                                  OrderNumber = IFNULL(CurObject.OrderNumber,0), 
                                  Substation = MainFeeder,
                                  SubstationName = FeederName,
                                  Msg = 'New FOD Order for ' +
                                        'Feeder ' + FeederName + '.  ' +
                                        HC_NEWLINE + 
                                        'First Move: ' + CurObject.Moves[1].TOMove, 
                                 
                                  FromOpName = DOp.Description,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FOD',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
      IF MsgKey < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message.' + 
              '  You might want to contact the FOD to ' + 
              'confirm that he has received the order.';
         MESSAGE :MessageField;
      ELSE
         CALLPROC DDB_COMMIT;
         RetCode = CALLPROC IR_FODOrderMsgKeyUpd (MsgKey = MsgKey,
                                        OrderNumber = CurObject.OrderNumber);
         IF Retcode = 0 THEN
           CALLPROC DDB_COMMIT;
         ELSE
           CALLPROC DDB_ROLLBACK;
           MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message id.' + 
              '  You might want to contact the FOD to ' + 
              'confirm that he has received the wireless order.';
           MESSAGE :MessageField;
         ENDIF;
      ENDIF;

      ControlText = varchar(CurObject.OrderNumber); 
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_NewFODOrder', 
                     EventText = ControlText);  
   RETURN PU_OK;
END;

