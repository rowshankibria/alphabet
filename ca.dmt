METHOD LoadCard (
)=
DECLARE
   StartTime    = DATE        NOT NULL;
   DurationText = VARCHAR(12) NOT NULL;
   en = INTEGER NOT NULL;
   i = INTEGER NOT NULL;
   FOTCount = INTEGER NOT NULL WITH DEFAULT;
   FeederDiagram = INTEGER NOT NULL WITH DEFAULT;
   FDValidated = DATE;
   FDValidatedBy = CHAR(24) NOT NULL WITH DEFAULT;
   TV_Bogey = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*  
**  Read the card in
*/  
   IF CurObject.ArchiveCard = FALSE THEN
      SELECT  
           :CurObject.C.Card = C.Card,
           :CurObject.C.Activated = C.Activated,
           :CurObject.C.SubstationName = C.SubstationName,
           :CurObject.C.TypeOfCard = C.TypeOfCard,
           :CurObject.C.Feeder = C.Feeder,
           :CurObject.C.FeederName = C.FeederName,
           :CurObject.C.FeederStatus = C.FeederStatus,
           :CurObject.C.FeederStatusName = C.FeederStatusName,
           :CurObject.C.Status = C.Status,
           :CurObject.C.CardClass = C.CardClass,
           :CurObject.C.CardClassName = C.CardClassName,
           :CurObject.C.Position = C.Position,
           :CurObject.C.StationGround = C.StationGround,
           :CurObject.C.GroundsOn = C.GroundsOn,
           :CurObject.C.DeadMoves = C.DeadMoves,
           :CurObject.C.DeadMovesTO = C.DeadMovesTO,
           :CurObject.C.Loop1 = C.Loop1,
           :CurObject.C.Loop2 = C.Loop2,
           :CurObject.C.Loop3 = C.Loop3,
           :CurObject.C.Loop4 = C.Loop4,
           :CurObject.C.Assoc = C.Assoc,
           :CurObject.C.Relays = C.Relays,
           :CurObject.C.Notifications = C.Notifications,
           :CurObject.C.Validated = C.Validated,
           :CurObject.C.CutOut = C.CutOut,
           :CurObject.C.CutIn = C.CutIn,
           :CurObject.C.OpenAutoPlus = C.OpenAutoPlus,
           :CurObject.C.PhaseChecks = C.PhaseChecks, 
           :CurObject.C.EstTimeInService = C.EstTimeInService,
           :CurObject.C.EstTimeComplete = C.EstTimeComplete,
           :CurObject.C.ActTimeComplete = C.ActTimeComplete,
           :CurObject.C.WorkpermitFlag = C.WorkpermitFlag,
           :CurObject.C.XferFlag = C.XferFlag,
           :CurObject.C.NotifyFlag = C.NotifyFlag,
           :CurObject.C.ProcessAutoExecution = C.ProcessAutoExecution,
           :CurObject.C.Closed = C.Closed,
           :CurObject.C.NetworkFeeder = C.NetworkFeeder,        
           :TV_Bogey = C.TV_Bogey
      FROM  FMS_Card C
      WHERE C.Card = :CurObject.Card;
      /*
      **  Default cardname, may get changed if 4kv.
      */
      CurObject.C.CardName = CurObject.C.FeederName;
      CurObject.C.Enable3GConfigChange = FALSE;

      SELECT :CurObject.C.Note = Note,
             :CurObject.C.ShowNoteFlag = ShowNoteFlag
      FROM   SOA_Card
      WHERE  Card = :CurObject.Card;
      CALLPROC DDB_ROLLBACK;
/*
**  Find out if this card has a 4kv Step Down card associated with it.
**  If it does, we will set a global variable to use in GetJCSearchObjects.
*/
      Is4kvStepDown = FALSE;
      If CurObject.C.TypeOfCard = TypeOfCard$4kv THEN
         SELECT :Is4kvStepDown = :TRUE
         FROM    FMS_StepDownLink L
         WHERE   L.StepDownCard = :CurObject.Card;
      ELSE
         SELECT :Is4kvStepDown = :TRUE
         FROM    FMS_StepDownLink L
         WHERE   L.Card = :CurObject.Card;
      ENDIF;
/*
** If a 3G Network Feeder card, load the feeder list
*/
      IsSectionalFeeder = FALSE;
      IsKnownPointISO = FALSE;
      IF CurObject.C.NetworkFeeder > 0 THEN   /* 3G or Portion feeders */
         i = 1;
         SELECT :CurObject.C.Object[i].Object = CTO.Object,
                :CurObject.C.Object[i].Type = CTO.Type,
                :CurObject.C.Object[i].Name = CTO.Name,
                :CurObject.C.Object[i].TypeName = O.ValidatedBy  /*Hide Validation Info in this field */
         FROM   TFMS_CardToObject CTO,
                Udb_Object O
         WHERE  CTO.Card = :CurObject.Card AND
                CTO.Object = O.Object
         BEGIN
            /* 
            **  Get Fed By relationship and store in PrimaryGrouping field
            */
            IF CurObject.C.NetworkFeeder = NetworkFeeder$33KV THEN
               SELECT :CurObject.C.Object[i].PrimaryGrouping = G.Grouping
               FROM    Udb_Grouping G
               WHERE   G.Member = :CurObject.C.Object[i].Object AND
                       G.RelationShip = :Interaction$FedBy AND
                       G.GroupingType = :Type$Feeder;
            ENDIF;
            /* 
            ** Will 3G Configuration Changes be enabled for this card?  Rapid Restore
            ** is enabled only when configuration changes are disabled.
            */
            IF CurObject.C.NetworkFeeder = NetworkFeeder$3G AND 
                 CurObject.C.Enable3GConfigChange = FALSE THEN
               en = 0;
               SELECT :en = Feeder
               FROM   FMS_EnableConfigChange
               WHERE  Feeder = :CurObject.C.Object[i].Object;
               
               IF en > 0 THEN
                  CurObject.C.Enable3GConfigChange = TRUE;
               ENDIF;
            ENDIF;
            /*
            ** If any feeders have not been validated, display blank card validation stamp
            */
            IF CurObject.C.Object[i].TypeName = '' THEN
               CurObject.C.Validated = '';
            ENDIF;
            i = i + 1;
         END;
      ELSE
         CurObject.C.Object[1].Object = CurObject.C.Feeder;
         CurObject.C.Object[1].Type = Type$Feeder;
         CurObject.C.Object[1].Name = CurObject.C.FeederName;
         CurObject.C.SectionalFeeder = 0; 
         i = 0;
         SELECT :i = COUNT(*)
         FROM   Udb_Grouping
         WHERE  Grouping = :CurObject.C.Feeder AND
                Relationship = :Interaction$MemberOf AND
                MemberType = :Type$SectionalFeeder;
         IF i > 0 THEN
            CurObject.C.SectionalFeeder = 1;  /* This Feeder has a sectional feeder */
            IsSectionalFeeder = 1;
         ELSE
            SELECT :i = Type
            FROM   Udb_Object
            WHERE  Object = :CurObject.C.Feeder;
            IF i = Type$SectionalFeeder THEN
               CurObject.C.SectionalFeeder = 2;  /* This Feeder is a sectional feeder */
               IsSectionalFeeder = 2;
            ENDIF;
         ENDIF;
         IF IsSectionalFeeder = FALSE THEN
            /*
            **  Check to see if this feeder has an active known point splice.
            */ 
            i = 0;
            SELECT :i = COUNT(*)
            FROM   Udb_Grouping
            WHERE  Grouping = :CurObject.C.Feeder AND
                   Relationship = :Interaction$MemberOf AND
                   MemberType = :Type$KPSFeeder;
            IF i > 0 THEN
               IsKnownPointISO = 1;  /* This feeder has a known point iso */
            ELSE
               SELECT :i = Type
               FROM   Udb_Object
               WHERE  Object = :CurObject.C.Feeder;
               IF i = Type$KPSFeeder THEN
                  IsKnownPointISO = 2;   /* This Feeder is a known point iso */
               ENDIF;
            ENDIF;  
         ENDIF;
      ENDIF;
/*
**  Load FeederLinks if this is 3G, StepDown or sectionalized feeder
*/
      CurObject.LoadFeederLinks();
/*
**  Load Current Delay and OperatingStep
*/
      CurObject.CurrentStepName = '';
      REPEATED
      SELECT :CurObject.CurrentStepName = OS.OperatingStepName, 
             :StartTime = OS.StartTime
      FROM   FMS_OPERATINGSTEPSTATUS OS
      WHERE  OS.Card = :CurObject.Card AND
             EndTime = '' AND
             OperatingStep <> :Type$OperatingStepCount AND
             StartTime = (SELECT   MAX(StartTime)
                          FROM     FMS_OperatingStepStatus OS2,
                                   Udb_SuperType S
                          WHERE    OS2.Card = :CurObject.Card AND
                                   OS2.EndTime = '' AND
                                   OS2.OperatingStep <> :Type$OperatingStepCount AND
                                   OS2.OperatingStep = S.Type AND
                                   S.SuperType = :Type$OperatingStepStatus);

      IF CurObject.CurrentStepName <> '' THEN
         DurationText = CALLPROC ConvertHour(Tot_Min = 
                    INT4(interval('minute', date('now') - DATE(StartTime))));
         CurObject.CurrentStepName = CurObject.CurrentStepName + ' (' + DurationText +  ')';
      ENDIF;

      CurObject.CurrentDelayName = '';
      REPEATED
      SELECT :CurObject.CurrentDelayName = OS.OperatingStepName, 
             :CurObject.CurrentDelay = OS.OperatingStep,
             :StartTime = OS.StartTime
      FROM   FMS_OPERATINGSTEPSTATUS OS
      WHERE  OS.Card = :CurObject.Card AND
             EndTime = '' AND
             OperatingStep <> :Type$OperatingStepCount AND
             StartTime = (SELECT   MAX(StartTime)
                          FROM     FMS_OperatingStepStatus OS2,
                                   Udb_SuperType S
                          WHERE    OS2.Card = :CurObject.Card AND
                                   OS2.EndTime = '' AND
                                   OS2.OperatingStep <> :Type$OperatingStepCount AND
                                   OS2.OperatingStep = S.Type AND
                                   S.SuperType = :Type$Delay);
      IF CurObject.CurrentDelayName <> '' THEN
         DurationText = CALLPROC ConvertHour(Tot_Min = 
                    INT4(interval('minute', date('now') - DATE(StartTime))));
         CurObject.CurrentDelayName = CurObject.CurrentDelayName + ' (' + DurationText +  ')';
         
         CurObject.DelayJobLink = '';
         REPEATED 
         SELECT i = Job
         FROM   FMS_JobDelayLink
         WHERE  Card = :CurObject.Card AND
                OperatingStep = :CurObject.CurrentDelay
         BEGIN
            CurObject.DelayJobLink = CurObject.DelayJobLink + varchar(i) + ';';
         END;
      ENDIF;
      
      /* incident reports
      */
      SELECT :CurObject.C.IncidentReport = COUNT(*)
      FROM   TFMS_CardToObject CTO,
             SOA_IncidentReportLink L
      WHERE  CTO.Card = :CurObject.Card AND
             CTO.Status = 1 AND
             CTO.Object = L.Object; 
      
      /* Feeder Diagram status
      */
      CurObject.C.ValidDiagram = FeederDiagram$None;
      FeederDiagram = 0;
      REPEATED
      SELECT :FeederDiagram = O.Object,
             :FDValidated = O.Validated,
             :FDValidatedBy = O.ValidatedBy
      FROM   Udb_Grouping G,
             TFMS_CardToObject CTO,
             Udb_Object O
      WHERE  CTO.Card = :CurObject.Card AND
             CTO.Type = :Type$Feeder AND
             CTO.Object = G.Member AND
             G.Relationship = :Interaction$ShownOn AND
             G.Grouping = O.Object;
      /*
      ** Reach higher if this is an ISO or some kind of portion card
      */       
      IF FeederDiagram = 0 THEN
         REPEATED
         SELECT :FeederDiagram = O.Object,
             :FDValidated = O.Validated,
             :FDValidatedBy = O.ValidatedBy
         FROM   Udb_Grouping G,
             TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Grouping G2
         WHERE  CTO.Card = :CurObject.Card AND
             CTO.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Feeder AND
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$ShownOn AND
             G2.Grouping = O.Object;
      ENDIF;
              
      IF FeederDiagram > 0 THEN
         CurObject.C.ValidDiagram = FeederDiagram$Invalid;        
         IF FDValidatedBy <> '' AND FDValidated IS NOT NULL AND FDValidated <> '' THEN
      /*
      ** Must be a diagram with more than five objects. 
      */
            i = 0;
            SELECT :i = COUNT(Object)
            FROM   DSO_Object
            WHERE  Pocket = :FeederDiagram;
            
            IF i > 5 THEN
               CurObject.C.ValidDiagram = FeederDiagram$Valid;        
            ENDIF;
         ENDIF;
      ENDIF;  
   ELSE  /* Load from Archives */
   
      REPEATED
      SELECT  
           :CurObject.C.Card = C.Card,
           :CurObject.C.Activated = C.Activated,
           :CurObject.C.SubstationName = C.SubstationName,
           :CurObject.C.TypeOfCard = C.TypeOfCard,
           :CurObject.C.Feeder = C.Feeder,
           :CurObject.C.FeederName = C.FeederName,
           :CurObject.C.FeederStatus = C.FeederStatus,
           :CurObject.C.FeederStatusName = C.FeederStatusName,
           :CurObject.C.Status = C.Status,
           :CurObject.C.CardClass = C.CardClass,
           :CurObject.C.CardClassName = C.CardClassName,
           :CurObject.C.Position = C.Position,
           :CurObject.C.StationGround = C.StationGround,
           :CurObject.C.GroundsOn = C.GroundsOn,
           :CurObject.C.DeadMoves = C.DeadMoves,
           :CurObject.C.DeadMovesTO = C.DeadMovesTO,
           :CurObject.C.Loop1 = C.Loop1,
           :CurObject.C.Loop2 = C.Loop2,
           :CurObject.C.Loop3 = C.Loop3,
           :CurObject.C.Loop4 = C.Loop4,
           :CurObject.C.Assoc = C.Assoc,
           :CurObject.C.Relays = C.Relays,
           :CurObject.C.Notifications = C.Notifications,
           :CurObject.C.Validated = C.Validated,
           :CurObject.C.CutOut = C.CutOut,
           :CurObject.C.CutIn = C.CutIn,
           :CurObject.C.OpenAutoPlus = C.OpenAutoPlus,
           :CurObject.C.PhaseChecks = C.PhaseChecks,
           :CurObject.C.EstTimeInService = C.EstTimeInService,
           :CurObject.C.EstTimeComplete = C.EstTimeComplete,
           :CurObject.C.ActTimeComplete = C.ActTimeComplete,
           :CurObject.C.WorkpermitFlag = C.WorkpermitFlag,
           :CurObject.C.NotifyFlag = C.NotifyFlag,
           :CurObject.C.Closed = C.Closed,
           :CurObject.C.NetworkFeeder = C.NetworkFeeder,        
           :TV_Bogey = C.TV_Bogey
      FROM  FMS_ArchiveCard C
      WHERE C.Card = :CurObject.Card; 
      CALLPROC DDB_ROLLBACK; 
      /*
      **  Default cardname, may get changed if 4kv.
      */
      CurObject.C.CardName = CurObject.C.FeederName;

      /* incident reports
      */
      SELECT :CurObject.C.IncidentReport = COUNT(*)
      FROM   TFMS_ArchiveCardToObject CTO,
             SOA_IncidentReportLink L
      WHERE  CTO.Card = :CurObject.Card AND
             CTO.Status = 1 AND
             CTO.Object = L.Object;       
   ENDIF;
/*
**  Make sure something was found.  
*/   
   IF CurObject.C.Card = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Card not found in database.';
   ENDIF;
/*
** If Cardclass is WR or SCHD load checklist values
*/   
   IF CurObject.C.CardClass = Type$SCHD OR
      CurObject.C.CardClass = Type$WR THEN
      
      SELECT  :CurObject.C.CL.Card = CL.Card,
              :CurObject.C.CL.VerifyPrint = CL.VerifyPrint,
              :CurObject.C.CL.RequiredPaperwork = CL.RequiredPaperwork,
              :CurObject.C.CL.NewEquipment = CL.NewEquipment,
              :CurObject.C.CL.RFPSubmitted = CL.RFPSubmitted,
              :CurObject.C.CL.ProtectionLinked = CL.ProtectionLinked,
              :CurObject.C.CL.TCContinuity = CL.TCContinuity,
              :CurObject.C.CL.TagsLinked = CL.TagsLinked
      FROM    FMS_CheckList CL
      WHERE   CL.Card = :CurObject.C.Card;      
      CALLPROC DDB_ROLLBACK; 
      
   ENDIF;   
/*
** If a 3G Network Feeder card, load the line list
*/
   IF CurObject.C.NetworkFeeder > 0 THEN   /* 3G or Portion Feeders */
      i = 1;
      SELECT :CurObject.C.Object[i].Object = Object,
             :CurObject.C.Object[i].Type = Type,
             :CurObject.C.Object[i].Name = Name
      FROM   TFMS_ArchiveCardToObject
      WHERE  Card = :CurObject.Card
      BEGIN
         i = i + 1;
      END;
   ELSE
      CurObject.C.Object[1].Object = CurObject.C.Feeder;
      CurObject.C.Object[1].Type = Type$Feeder;
      CurObject.C.Object[1].Name = CurObject.C.FeederName;
   ENDIF;
   /*
   **  Show all TV Bogey Reason field in reverse video.
   */ 
   IF TV_Bogey > 0 THEN
      CurObject.C.CardClass_Reverse = TRUE; 
      IF TV_Bogey = 1 THEN
         CurObject.C.TV_Reason = 'Triggered by Actual TV Forecast';
      ELSEIF TV_Bogey = 2 THEN
         CurObject.C.TV_Reason = 'Triggered by Current TV Forecast';            
      ELSEIF TV_Bogey = 3 THEN
         CurObject.C.TV_Reason = 'Triggered by Day Ahead TV Forecast';
      ENDIF;        
   ENDIF;
/*
**  Look for open auto plus and FOT Count
*/  
   IF (CurObject.C.CardClass = Type$Auto OR 
         CurObject.C.CardClass = Type$CIOA) AND
         CurObject.C.OpenAutoPlus IS NOT NULL AND 
         CurObject.C.OpenAutoPlus <> '' THEN
      CurObject.C.CardClassName = CurObject.C.CardClassName + '+';
   ENDIF;

   IF CurObject.C.CardClass = Type$FOT THEN
      FOTCount = 0;
      SELECT :FOTCount = FOTCount
      FROM   IR_FOTCount
      WHERE  Card = :CurObject.C.Card;
   
      IF FOTCount <> 0 THEN
         CurObject.C.CardClassName = 
                 CurObject.C.CardClassName + VARCHAR(FOTCount);
      ENDIF;
   ENDIF;
   
   RETURN;
END;


METHOD LoadClosedCards (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
   Filter        = VARCHAR(40);        /* Feeder name filter */
   FOTCount = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Default filter to current card if any is currently loaded
*/
   IF CurObject.Card <> 0 THEN
      CurObject.FeederFilter = '';
      IF CurObject.ArchiveCard = FALSE THEN
         SELECT :CurObject.FeederFilter = C.FeederName
         FROM   FMS_Card C
         WHERE C.Card = :CurObject.Card;

         IF CurObject.FeederFilter = '' THEN
            SELECT :CurObject.FeederFilter = C.FeederName
            FROM   FMS_ArchiveCard C
            WHERE C.Card = :CurObject.Card;
         ENDIF;
      ELSE
         SELECT :CurObject.FeederFilter = C.FeederName
         FROM   FMS_ArchiveCard C
         WHERE C.Card = :CurObject.Card;

         IF CurObject.FeederFilter = '' THEN
            SELECT :CurObject.FeederFilter = C.FeederName
            FROM   FMS_Card C
            WHERE C.Card = :CurObject.Card;
         ENDIF;
     ENDIF;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   IF CurObject.SearchOption = 1 THEN      /* begins with */
      Filter = UPPERCASE(CurObject.FeederFilter) + '%';
   ELSEIF CurObject.SearchOption = 2 THEN  /* contains */
      Filter = '%' + UPPERCASE(CurObject.FeederFilter) + '%';
   ELSE
      Filter = UPPERCASE(CurObject.FeederFilter);
   ENDIF;

   CurObject.CList.Clear();
   IF CurObject.Filter = TRUE THEN   /* find only portion cards */            
      i = 1;
      REPEATED
      SELECT  :CurObject.Clist[i].Card = Card,
              :CurObject.Clist[i].FeederName = FeederName,
              :CurObject.Clist[i].CardClass = CardClass,
              :CurObject.Clist[i].CardClassName  = CardClassName,
              :CurObject.Clist[i].CutOut = CutOut,
              :CurObject.Clist[i].OpenAutoPlus = OpenAutoPlus,
              :CurObject.Clist[i].CutIn = CutIn,
              :CurObject.Clist[i].Closed = Closed
      FROM    FMS_ArchiveCard
      WHERE   FeederName LIKE :Filter
      AND     TypeOfCard = :Type$PortionCard
      ORDER BY Closed desc
      BEGIN
/*
**  Look for open auto plus and FOT Count
*/  
         IF (CurObject.CList[i].CardClass = Type$Auto OR 
             CurObject.CList[i].CardClass = Type$CIOA) AND
             CurObject.CList[i].OpenAutoPlus IS NOT NULL AND 
             CurObject.CList[i].OpenAutoPlus <> '' THEN
            CurObject.CList[i].CardClassName = CurObject.CList[i].CardClassName + '+';
         ENDIF;

         IF CurObject.CList[i].CardClass = Type$FOT THEN
            FOTCount = 0;
            SELECT :FOTCount = FOTCount
            FROM   IR_FOTCount
            WHERE  Card = :CurObject.CList[i].Card;
    
            IF FOTCount <> 0 THEN
               CurObject.CList[i].CardClassName = 
                  CurObject.CList[i].CardClassName + VARCHAR(FOTCount);
            ENDIF;
         ENDIF;      
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE                        /* find all other types of cards */
         
      i = 1;
      REPEATED
      SELECT  :CurObject.Clist[i].Card = Card,
              :CurObject.Clist[i].FeederName = FeederName,
              :CurObject.Clist[i].CardClass = CardClass,
              :CurObject.Clist[i].CardClassName  = CardClassName,
              :CurObject.Clist[i].CutOut = CutOut,
              :CurObject.Clist[i].OpenAutoPlus = OpenAutoPlus,
              :CurObject.Clist[i].CutIn = CutIn,
              :CurObject.Clist[i].Closed = Closed
      FROM    FMS_ArchiveCard
      WHERE   FeederName LIKE :Filter
      ORDER BY Closed desc
      BEGIN
/*
**  Look for open auto plus and FOT Count
*/  
         IF (CurObject.CList[i].CardClass = Type$Auto OR 
             CurObject.CList[i].CardClass = Type$CIOA) AND
             CurObject.CList[i].OpenAutoPlus IS NOT NULL AND 
             CurObject.CList[i].OpenAutoPlus <> '' THEN
            CurObject.CList[i].CardClassName = CurObject.Clist[i].CardClassName + '+';
         ENDIF;

         IF CurObject.CList[i].CardClass = Type$FOT THEN
            FOTCount = 0;
            SELECT :FOTCount = FOTCount
            FROM   IR_FOTCount
            WHERE  Card = :CurObject.CList[i].Card;
    
            IF FOTCount <> 0 THEN
               CurObject.CList[i].CardClassName = 
                  CurObject.CList[i].CardClassName + VARCHAR(FOTCount);
            ENDIF;
         ENDIF;      
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
**  Make sure something was found.  We will only pass back results < 100.  
*/   
   IF CurObject.CList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Did not find any closed cards for feeder name ' + CurObject.FeederFilter;
   ELSEIF CurObject.CList.LastRow() > 100 AND LENGTH(CurObject.FeederFilter) < 4 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Too many matches. Please be more specific with your search criteria.';   
   ENDIF;
   RETURN;
END;

METHOD LoadDelayHistory (
)=
DECLARE
   TimeNow = DATE NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Operating Step and Delay 
** history associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK;

   i = 1;
   CurObject.OpSteps.Clear();
   REPEATED
   SELECT :CurObject.OpSteps[i].OperatingStepName = OS.OperatingStepName,
          :CurObject.OpSteps[i].StartTime = OS.StartTime,
          :CurObject.OpSteps[i].EndTime = OS.EndTime,
          :CurObject.OpSteps[i].DurationMins = OS.DurationMins
   FROM   FMS_ArchiveOperatingStep OS
   WHERE  OS.Card = :CurObject.Card AND
          OS.OperatingStep IN (SELECT Type
                               FROM   Udb_SuperType
                               WHERE  SuperType = :Type$OperatingStepStatus AND
                                      Type <> :Type$Delay AND
                                      Type <> :Type$OperatingStepCount AND
                                      Type <> :Type$DODelay)
   union all
   SELECT OS.OperatingStepName,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C
   WHERE  OS.Card = :CurObject.Card AND
          OS.Card = C.Card AND
          C.Status < :Card$Closed AND
          OS.OperatingStep IN (SELECT Type
                               FROM   Udb_SuperType
                               WHERE  SuperType = :Type$OperatingStepStatus AND
                                      Type <> :Type$Delay AND
                                      Type <> :Type$OperatingStepCount AND
                                      Type <> :Type$DODelay)
   ORDER BY StartTime
   BEGIN
      IF CurObject.OpSteps[i].EndTime = '' THEN
         CurObject.OpSteps[i].DurationMins = INT4(interval('minute',TimeNow - DATE(CurObject.OpSteps[i].StartTime)));
      ENDIF;
      CurObject.OpSteps[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = CurObject.OpSteps[i].DurationMins);        
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;


   i = 1;
   CurObject.Delays.Clear();
   REPEATED
   SELECT :CurObject.Delays[i].OperatingStep = OS.OperatingStep,
          :CurObject.Delays[i].OperatingStepName = OS.OperatingStepName,
          :CurObject.Delays[i].StartTime = OS.StartTime,
          :CurObject.Delays[i].EndTime = OS.EndTime,
          :CurObject.Delays[i].DurationMins = OS.DurationMins
   FROM   FMS_ArchiveOperatingStep OS
   WHERE  OS.Card = :CurObject.Card AND
          OS.OperatingStep IN (SELECT Type
                               FROM   Udb_SuperType
                               WHERE  SuperType = :Type$Delay AND
                                      Type <> :Type$OperatingStepCount)
   union all
   SELECT OS.OperatingStep,
          OS.OperatingStepName,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C
   WHERE  OS.Card = :CurObject.Card AND
          OS.Card = C.Card AND
          C.Status < :Card$Closed AND
          OS.OperatingStep IN (SELECT Type
                               FROM   Udb_SuperType
                               WHERE  SuperType = :Type$Delay AND
                                      Type <> :Type$OperatingStepCount)
   ORDER BY StartTime
   BEGIN
      IF CurObject.Delays[i].EndTime = '' THEN
         CurObject.Delays[i].DurationMins = INT4(interval('minute',TimeNow - DATE(CurObject.Delays[i].StartTime)));
      ENDIF;
      CurObject.Delays[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = CurObject.Delays[i].DurationMins);        
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   IF CurObject.OpSteps.LastRow() = 0 AND CurObject.Delays.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No operating step or delay data found for card.';
      RETURN;
   ENDIF;
      
   RETURN;
END;


METHOD LoadDelayLinks (
)=
DECLARE
   i = INTEGER NOT NULL;
   TempJob = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Delay links to jobs.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.Delays.LastRow() DO
      CurObject.Delays[i].JobLinks = '';
      IF CurObject.Delays[i].EndTime = '' THEN
         REPEATED
         SELECT :TempJob = Job
         FROM    FMS_JobDelayLink
         WHERE   Card = :CurObject.Card AND
                 OperatingStep = :CurObject.Delays[i].OperatingStep
         BEGIN
            CurObject.Delays[i].JobLinks = CurObject.Delays[i].JobLinks +
                                           VARCHAR(TempJob) + ';'; 
         END;
      ELSE
         REPEATED
         SELECT :TempJob = Job
         FROM   FMS_ArchiveJobDelayLink
         WHERE  Card = :CurObject.Card AND
                OperatingStep = :CurObject.Delays[i].OperatingStep AND
                StartTime = :CurObject.Delays[i].StartTime
         BEGIN
            CurObject.Delays[i].JobLinks = CurObject.Delays[i].JobLinks +
                                           VARCHAR(TempJob) + ';'; 
         END;     
      ENDIF;    
   ENDFOR;
      
   RETURN;
END;


METHOD LoadFeederLog (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Log data associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.Log.Clear();
   IF CurObject.ArchiveCard = FALSE THEN
    
      i = 1; 
      SELECT :CurObject.Log[i].Card = FL.Card, 
             :CurObject.Log[i].Log = FL.Log, 
             :CurObject.Log[i].LogStatus = FL.LogStatus, 
             :CurObject.Log[i].LogTime = FL.LogTime, 
             :CurObject.Log[i].EnteredBy = FL.EnteredBy, 
             :CurObject.Log[i].EnteredByName = O.Description  
      FROM   FMS_FeederLog FL,
             Udb_Object O 
      WHERE  FL.Card = :CurObject.Card AND
             FL.EnteredBy = O.Object 
      ORDER BY LogTime DESC
      BEGIN 
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;

   ELSE
  
      i = 1; 
      SELECT :CurObject.Log[i].Card = FL.Card, 
             :CurObject.Log[i].Log = FL.Log, 
             :CurObject.Log[i].LogStatus = FL.LogStatus, 
             :CurObject.Log[i].LogTime = FL.LogTime, 
             :CurObject.Log[i].EnteredBy = FL.EnteredBy, 
             :CurObject.Log[i].EnteredByName = O.Description 
      FROM   FMS_ArchiveFeederLog FL,
             Udb_Object O  
      WHERE  FL.Card = :CurObject.Card AND
             FL.EnteredBy = O.Object  
      ORDER BY LogTime DESC
      BEGIN 
         i = i + 1; 
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
      
   RETURN;
END;


METHOD LoadLogStatus (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the log status associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   /*
   ** Look for an log entries for the current feedercard:
   ** If the log has an 'INCOMPLETE', it will the MAX, else
   ** 'COMPLETE' will be max. If there are no logs, the
   ** default 'EMPTY' will be used.
   */
   IF CurObject.ArchiveCard = FALSE THEN
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(FL.LogStatus), 'EMPTY') 
      FROM   FMS_FeederLog FL 
      WHERE  FL.Card = :CurObject.Card;  
   ELSE
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(FL.LogStatus), 'EMPTY') 
      FROM   FMS_ArchiveFeederLog FL 
      WHERE  FL.Card = :CurObject.Card;  
   ENDIF;
      
   RETURN;
END;

METHOD LoadTxLog (
)=
DECLARE
   i = INTEGER NOT NULL;
   Feeder = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the transaction log associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.FCLog.Clear();
   i = 1;
   IF CurObject.ArchiveCard = FALSE OR CurrentApplication = Application$SDS THEN
     Feeder = 0;
     SELECT :Feeder = Feeder
     FROM   FMS_Card 
     WHERE  Card = :CurObject.Card;

     i = 1;
     REPEATED
     SELECT  :CurObject.FCLog[i].Time = L.Time,
             :CurObject.FCLog[i].PrintID = '',
             :CurObject.FCLog[i].Equip = J.Equip,
             :CurObject.FCLog[i].EquipName = J.EquipName,
             :CurObject.FCLog[i].EquipClassName = J.EquipClassName,
             :CurObject.FCLog[i].TOMove = J.TOMove,
             :CurObject.FCLog[i].TOOperator = J.TOOperator,
             :CurObject.FCLog[i].RSMove = J.RSMove,
             :CurObject.FCLog[i].RSOperator = J.RSOperator,
             :CurObject.FCLog[i].UserName = L.UserName,
             :CurObject.FCLog[i].Item = L.Item,
             :CurObject.FCLog[i].Old = L.Old,
             :CurObject.FCLog[i].New = L.New,
             :CurObject.FCLog[i].Operator = L.Operator,
             :CurObject.FCLog[i].OperatorName = L.OperatorName
     FROM    SOA_Log L,
             SOA_Job J
     WHERE   L.Card = :CurObject.Card AND
             L.SwitchingItem = :CurObject.SwitchingItem AND
             L.Job = J.Job 
     UNION
     SELECT  L.Time,
             J.PrintID,
             J.Equip,
             J.EquipName,
             J.EquipClassName,
             J.TOMove,
             J.TOOperator,
             J.RSMove,
             J.RSOperator,
             L.UserName,
             L.Item,
             L.Old,
             L.New,
             L.Operator,
             L.OperatorName
     FROM    SOA_Log L,
             FMS_ArchiveJob J
     WHERE   L.Card = :CurObject.Card AND
             L.SwitchingItem = :CurObject.SwitchingItem AND
             L.Card = J.Card AND
             L.Job = J.Job
     UNION
     SELECT  L.Time,
             '',
             0,
             '',
             '',
             '',
             0,
             '',
             0,
             L.UserName,
             L.Item,
             L.Old,
             L.New,
             L.Operator,
             L.OperatorName
     FROM    SOA_Log L
     WHERE   L.Card = :CurObject.Card AND
             L.SwitchingItem = :CurObject.SwitchingItem AND
             L.Job IS NULL 
     ORDER BY Time DESC
     BEGIN
        IF Feeder > 0 AND CurObject.FCLog[i].Equip <> 0 AND 
             CurObject.FCLog[i].PrintID = '' THEN
/*
** Getting Print ID will not work for any 3G card.
*/
           SELECT :CurObject.FCLog[i].PrintID = Reference
           FROM   Udb_Grouping
           WHERE  Grouping = :Feeder AND
                  Relationship = :Interaction$MemberOf AND
                  Member = :CurObject.FCLog[i].Equip;
        ENDIF;
        i = i + 1;
     END;
   
   ELSE
     IF CurrentApplication = Application$FMS THEN
        REPEATED
        SELECT  :CurObject.FCLog[i].Time = L.Time,
                :CurObject.FCLog[i].PrintID = '',  /*J.PrintID,*/
                :CurObject.FCLog[i].Equip = J.Equip,
                :CurObject.FCLog[i].EquipName = J.EquipName,
                :CurObject.FCLog[i].EquipClassName = J.EquipClassName,
                :CurObject.FCLog[i].TOMove = J.TOMove,
                :CurObject.FCLog[i].TOOperator = J.TOOperator,
                :CurObject.FCLog[i].RSMove = J.RSMove,
                :CurObject.FCLog[i].RSOperator = J.RSOperator,
                :CurObject.FCLog[i].UserName = L.UserName,
                :CurObject.FCLog[i].Item = L.Item,
                :CurObject.FCLog[i].Old = L.Old,
                :CurObject.FCLog[i].New = L.New,
                :CurObject.FCLog[i].Operator = L.Operator,
                :CurObject.FCLog[i].OperatorName = L.OperatorName
        FROM    FMS_ArchiveLog L,
                FMS_ArchiveJob J
        WHERE   L.Card = :CurObject.Card AND
               /* J.Card = L.Card AND */
                J.Job = L.Job
        UNION
        SELECT  L.Time,
                '',
                J.Equip,
                J.EquipName,
                J.EquipClassName,
                J.TOMove,
                J.TOOperator,
                J.RSMove,
                J.RSOperator,
                L.UserName,
                L.Item,
                L.Old,
                L.New,
                L.Operator,
                L.OperatorName
        FROM    FMS_ArchiveLog L,
                SOA_Job J
        WHERE   L.Card = :CurObject.Card AND
                J.Job = L.Job
        UNION
        SELECT  L.Time,
             '',
             0,
             '',
             '',
             '',
             0,
             '',
             0,
             L.UserName,
             L.Item,
             L.Old,
             L.New, 
             L.Operator,
             L.OperatorName
        FROM    FMS_ArchiveLog L
        WHERE   L.Card = :CurObject.Card AND
                L.Job IS NULL 
        ORDER BY Time DESC
        BEGIN
           i = i + 1;
        END;
     ELSE  
        REPEATED
        SELECT  :CurObject.FCLog[i].Time = L.Time,
                :CurObject.FCLog[i].PrintID = '', /*J.PrintID,*/
                :CurObject.FCLog[i].Equip = J.Equip,
                :CurObject.FCLog[i].EquipName = J.EquipName,
                :CurObject.FCLog[i].EquipClassName = J.EquipClassName,
                :CurObject.FCLog[i].TOMove = J.TOMove,
                :CurObject.FCLog[i].TOOperator = J.TOOperator,
                :CurObject.FCLog[i].RSMove = J.RSMove,
                :CurObject.FCLog[i].RSOperator = J.RSOperator,
                :CurObject.FCLog[i].UserName = L.UserName,
                :CurObject.FCLog[i].Item = L.Item,
                :CurObject.FCLog[i].Old = L.Old,
                :CurObject.FCLog[i].New = L.New,
                :CurObject.FCLog[i].Operator = L.Operator,
                :CurObject.FCLog[i].OperatorName = L.OperatorName
        FROM    SOA_ArchiveLog L,
                SOA_ArchiveJob J
        WHERE   L.Card = :CurObject.Card AND
                L.SwitchingItem = :CurObject.SwitchingItem AND
               /* J.Card = L.Card AND */
                J.Job = L.Job
        UNION
        SELECT  L.Time,
                '',
                J.Equip,
                J.EquipName,
                J.EquipClassName,
                J.TOMove,
                J.TOOperator,
                J.RSMove,
                J.RSOperator,
                L.UserName,
                L.Item,
                L.Old,
                L.New,
                L.Operator,
                L.OperatorName
        FROM    SOA_ArchiveLog L,
                SOA_Job J
        WHERE   L.Card = :CurObject.Card AND
                L.SwitchingItem = :CurObject.SwitchingItem AND
                J.Job = L.Job
        UNION
        SELECT  L.Time,
             '',
             0,
             '',
             '',
             '',
             0,
             '',
             0,
             L.UserName,
             L.Item,
             L.Old,
             L.New, 
             L.Operator,
             L.OperatorName
        FROM    SOA_ArchiveLog L
        WHERE   L.Card = :CurObject.Card AND
                L.SwitchingItem = :CurObject.SwitchingItem AND
                L.Job IS NULL 
        ORDER BY Time DESC
        BEGIN
           i = i + 1;
        END;
     ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

METHOD LoadTxLogEquip (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the equipment associated with a transaction log.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.FCLog.Clear();
   i = 1;
   IF CurObject.ArchiveCard = FALSE THEN
      REPEATED
      SELECT DISTINCT
              :CurObject.FCLog[i].PrintID = JC.PrintID,
              :CurObject.FCLog[i].Equip = J.Equip,
              :CurObject.FCLog[i].EquipName = J.EquipName,
              :CurObject.FCLog[i].EquipClassName = J.EquipClassName
      FROM     SOA_Log L,
               SOA_Job J,
               SOA_JobControl JC
      WHERE    L.Card = :CurObject.Card AND
               L.SwitchingItem = :CurObject.SwitchingItem AND
               L.Job  = J.Job AND
               J.Job = JC.Job AND
               JC.Card = :CurObject.Card
      ORDER BY PrintID
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF CurrentApplication = Application$FMS THEN
         REPEATED
         SELECT 
              :CurObject.FCLog[i].PrintID = J.PrintID,
              :CurObject.FCLog[i].Equip = J.Equip,
              :CurObject.FCLog[i].EquipName = J.EquipName,
              :CurObject.FCLog[i].EquipClassName = J.EquipClassName
         FROM  FMS_ArchiveLog L,
               FMS_ArchiveJob J
         WHERE L.Card = :CurObject.Card AND
               L.Card = J.Card AND
               L.Job  = J.Job
         UNION
         SELECT 
              '',
              J.Equip,
              J.EquipName,
              J.EquipClassName
         FROM  FMS_ArchiveLog L,
               SOA_Job J
         WHERE L.Card = :CurObject.Card AND
               L.Job  = J.Job
         ORDER BY EquipClassName
         BEGIN
            i = i + 1;
         END;
      ELSE
         REPEATED
         SELECT 
              :CurObject.FCLog[i].PrintID = J.PrintID,
              :CurObject.FCLog[i].Equip = J.Equip,
              :CurObject.FCLog[i].EquipName = J.EquipName,
              :CurObject.FCLog[i].EquipClassName = J.EquipClassName
         FROM  SOA_ArchiveLog L,
               SOA_ArchiveJob J
         WHERE L.Card = :CurObject.Card AND
               L.SwitchingItem = :CurObject.SwitchingItem AND
               L.Job  = J.Job
         UNION
         SELECT 
              '',
              J.Equip,
              J.EquipName,
              J.EquipClassName
         FROM  SOA_ArchiveLog L,
               SOA_Job J
         WHERE L.Card = :CurObject.Card AND
               L.SwitchingItem = :CurObject.SwitchingItem AND
               L.Job  = J.Job
         ORDER BY EquipClassName
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

