**   07/14/94       bgh     Created
**   03/13/94       pw      make title text field so it will behave dynamically
*/

INITIALIZE
(
    PhraseLength = INTEGER NOT NULL;
    ef = EntryField;    
) =
BEGIN
    Curframe.WindowTitle = PromptPhrase;
    Field(PromptPhrase).TextValue = PromptPhrase;
/*
**  Create an entryfield so that we can set it's data length and display size.
*/
    ef = Field(phrase).Duplicate();
    ef.CharsperLine = PhraseLength + 1;
    ef.DataType = 'VARCHAR(' + varchar(PhraseLength) + ')';
    ef.MaxCharacters = PhraseLength;
    Field(Phrase).CurBias = FB_INVISIBLE;
    ef.ParentField = FIELD(Phrase).ParentFIeld;

END;

