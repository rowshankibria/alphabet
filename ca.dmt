/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Class:          EquipInProgress
**
**  Date:       Author   Description
** ----------------------------------
**  10/22/98    pkw       Created
**  03/30/05    em        Break into multiple selects;
**                        there is no guarantee that Location or
**                        Switch exists. Unclear how to formulate
**                        outer join using grouping+location tables
**  12/14/05    ysp       Increase the size of MoveText to 160 chars
*/
METHOD LoadEquipDetails (
   Equip   = INTEGER NOT NULL;
)=
DECLARE
   JD      = EquipInProgress;
BEGIN
   SELECT :JD.EquipClass  = O.Type,
          :JD.EquipClassName   = O.TypeName,
          :JD.Combination = O.Combination,
          :JD.LockNumber = O.LockNumber,
          :JD.EquipComment     = O.Comment
   FROM    Udb_Object O
   WHERE   O.Object = :Equip;

   REPEATED
   SELECT :JD.Network     = T1.Name,    
          :JD.Relay       = T2.Name, 
          :JD.NormalOpen  = S.NormalOpen,
          :JD.CurrentlyOpen = S.CurrentlyOpen,
          :JD.StopTag     = S.StopTag
   FROM    Udb_Switch S,
           Udb_Type T1,
           Udb_Type T2
   WHERE   S.Object = :Equip AND
           S.NetworkType = T1.Type AND
           S.RelayType = T2.Type;

   REPEATED
   SELECT :JD.Address1    = L.L1,
          :JD.Address2    = L.L2,
          :JD.Address3    = L.L3,
          :JD.Address4    = L.L4,
          :JD.LocationComment     = L.Comment
   FROM    Udb_Location L,          
           Udb_Grouping G 
   WHERE   G.Member = :Equip AND
           G.Relationship = :Interaction$LocatedWith AND
           G.Grouping = L.Object;
   CALLPROC DDB_ROLLBACK; 

   RETURN JD.Duplicate();
END;

