	Name:            AutomationBlock


Component Method Scripts
--------------------------
/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Class:          AutomationLock
**
**  Modifications:
**  01/28/04    em  Created LoadBlocks method
**  03/26/04    em  Don't select CANCELLED Blocks
**  07/31/06    ysp Add loading of StartOnAny flag.
**  01/08/20    em  Include StartOnDBF attribute
*/
METHOD LoadBlocks (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.AB.Clear();
   i = 1;
   SELECT  :CurObject.AB[i].Card = Card
          ,:CurObject.AB[i].Block = Block
          ,:CurObject.AB[i].BlockSeq = BlockSeq
          ,:CurObject.AB[i].BlockEnd = BlockEnd
          ,:CurObject.AB[i].BlockStart = BlockStart
          ,:CurObject.AB[i].BlockStatus = BlockStatus
          ,:CurObject.AB[i].BlockStopped = BlockStopped
          ,:CurObject.AB[i].BlockTitle = BlockTitle
          ,:CurObject.AB[i].InitiatingDO = InitiatingDO
          ,:CurObject.AB[i].InitTime = InitTime
          ,:CurObject.AB[i].SendTo = SendTo
          ,:CurObject.AB[i].StopReason = StopReason
          ,:CurObject.AB[i].StartOnAny = StartOnAny
          ,:CurObject.AB[i].StartOnDBF = StartOnDBF
   FROM   FMS_AutomationBlock
   WHERE  Card = :CurObject.Card AND
          BlockStatus <> :BlockStatus$Cancelled
   ORDER BY BlockSeq
   BEGIN
      CurObject.AB[i].DOName = '';
      SELECT :CurObject.AB[i].DOName = Description
      FROM   Udb_Object 
      WHERE  Object = :CurObject.AB[i].InitiatingDO;
   
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF i = 1 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Card ' + VARCHAR(CurObject.Card) + 
                               ' has no Automation Blocks defined.';
   ENDIF;
END;

   

