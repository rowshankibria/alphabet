Application Component Report
============================

	Name:            PromptDefectiveRelay

/*
**
**	Copyright c 2018 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptDefectiveRelay
**
**  Modifications:
**  10/23/18   ysp  Created
*/
INITIALIZE 
(
   JIP = JobInProgress;			/* Job being processed */
) =
DECLARE
   AllRelaysNormal = CHAR(3) NOT NULL WITH DEFAULT;
   DefectEquipment = VARCHAR(256) NOT NULL WITH DEFAULT;
   DOEntered = INTEGER NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
   ReturnStatus = VARCHAR(20) NOT NULL WITH DEFAULT;    /* just a holder for the value in db */
   ReturnToService = CHAR(3) NOT NULL WITH DEFAULT;     /* just a holder for the value in db */
   
   SendEventToMainScreen = PROCEDURE;
ENDDECLARE
BEGIN  
   SELECT :AllRelaysNormal = AllRelaysNormal,
          :DefectRelayComment = DefectRelayComment,
          :ReturnStatus = ReturnStatus,
          :ReturnToService = ReturnToService
   FROM   SOA_WorkPermit
   WHERE  PermitJobID = :JIP.Job;
   
   IF iirowcount = 0 OR AllRelaysNormal = '   ' THEN           // 3 spaces 
      DOEntered = TRUE;
      FIELD(Heading).TextValue = 'Enter Relay Information:';
      FIELD(NormalIndicator).BGColor = CC_PALE_CYAN;
      FIELD(NormalIndicator).CurBias = FB_CHANGEABLE;
      FIELD(DefectRelayComment).BGColor = CC_PALE_BLUE;
      FIELD(DefectRelayComment).CurBias = FB_LANDABLE;
   ELSE
      DOEntered = FALSE;

      IF AllRelaysNormal = 'YES' THEN
         NormalIndicator = 1;
      ELSEIF AllRelaysNormal = 'NO ' THEN
         NormalIndicator = 0;
      ELSE
		 NormalIndicator = 2;
      ENDIF;
   ENDIF;
END;

ON SETVALUE NormalIndicator = 
BEGIN
   IF CurFrame.ReasonCode = RC_PROGRAM THEN
        RESUME;
   ENDIF;
   
   IF NormalIndicator = 0 THEN
      FIELD(DefectRelayComment).BGColor = CC_PALE_CYAN;
      FIELD(DefectRelayComment).CurBias = FB_CHANGEABLE;
   ELSE
      FIELD(DefectRelayComment).BGColor = CC_PALE_BLUE;
      FIELD(DefectRelayComment).CurBias = FB_LANDABLE;
   ENDIF;   
END;

ON CLICK OK_BTN = 
DECLARE
ENDDECLARE
BEGIN
   IF NormalIndicator IS NULL THEN
      MESSAGE 'Are all relays normal?';
      RESUME;
   ENDIF;
   
   IF NormalIndicator = 1 THEN
      AllRelaysNormal = 'YES';
      
   ELSEIF NormalIndicator = 2 THEN
      AllRelaysNormal = 'N/A';

   ELSEIF NormalIndicator = 0 THEN
      AllRelaysNormal = 'NO';
      IF DOEntered = TRUE AND SQUEEZE(DefectRelayComment) = '' THEN
         MESSAGE 'Please enter the defective relay/equipment.';
         RESUME;
      ENDIF;
   ENDIF;
   
   IF DOEntered = TRUE THEN
      RetCode = CALLPROC SOA_WPReturnStatusUpd ( 
               PermitJobID = JIP.Job
               ,ReturnStatus = ReturnStatus           /* Save back the original value */
               ,ReturnToService = ReturnToService     /* Save back the original value */
               ,AllRelaysNormal = AllRelaysNormal
               ,DefectRelayComment = DefectRelayComment);
               
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to record relay information due to an error!';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;   
   ENDIF;
   
   IF AllRelaysNormal = 'YES' OR AllRelaysNormal = 'N/A' THEN
      RETURN;
   ELSE
      FIELD(SF_Card_Prompt).AbsXLeft = FIELD(DefectRelayComment).AbsXLeft;
      FIELD(SF_Card_Prompt).AbsYBottom = FIELD(OK_Btn).AbsYBottom;
      FIELD(SF_Card_Prompt).CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON SETVALUE SF_Card_Prompt.TLS_Option = 
DECLARE
   EventText = VARCHAR(100) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   EventText = Left(UserName,Length(UserName) - 3) + VARCHAR(Application$TLSInt) + Right(UserName, 2);         
   EventText = EventText + ';' + VARCHAR(JIP.Substation) + ';';
  
   CALLPROC DDB_RaiseDBEvent ( DBEventName = 'TC_DefectiveRelay', 
                              DBEventText = EventText); 
   CALLPROC DDB_COMMIT;
   
   IF CurSession.OperatingSystem = SY_NT THEN
	  /*
	  **  Send Request Event to get WidgetID's if needed. 
	  */
	  IF WidgetID_TLS = 0 THEN
		 CALLPROC EUE_SendExternalEvent('ext_tls_widgetid_request');
		 CurFrame.Trace (text = VARCHAR(DATE('now')) + ' : ' +
			   'Requesting WidgetID from TLS application.');
	  ELSE
		 CALLPROC ShowWindow(WidgetId_TLS,1);
		 CALLPROC SetForegroundWindow(WidgetId_TLS);
	  ENDIF;
   ENDIF;           
                   
   RETURN;
END;

ON SETVALUE SF_Card_Prompt.SLC_Option = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(100) NOT NULL WITH DEFAULT;
BEGIN

   SF_Equip_Prompt.EL.Clear();  
   i = 1;
   SELECT :OrderNumber = E.OrderNumber,
          :SF_Equip_Prompt.EL[i].TypeName = E.TypeName,
          :SF_Equip_Prompt.EL[i].Name = E.Name,
          :SF_Equip_Prompt.EL[i].Object = E.Object
   FROM   SOA_InServicePermit P,
          IR_OpOrderFeeders E
   WHERE  P.Job = :JIP.Job AND
          P.Status >= :ISPStatus$Complete AND
          P.ISPermit = E.ISPermit
   BEGIN
      i = i + 1;
   END;
   
   IF SF_Equip_Prompt.EL.LastRow = 1 THEN
      DefectEquipment = VARCHAR(OrderNumber) + ';' + 
						VARCHAR(SF_Equip_Prompt.EL[1].Object) + ';' +
                        SF_Equip_Prompt.EL[1].Name;
      CALLPROC SendEventToMainScreen();
      RETURN;
   ELSE
      FIELD(SF_Card_Prompt).CurBias = FB_INVISIBLE;

      FIELD(SF_Equip_Prompt).AbsXLeft = FIELD(DefectRelayComment).AbsXLeft;
      FIELD(SF_Equip_Prompt).AbsYBottom = FIELD(OK_Btn).AbsYBottom;
      FIELD(SF_Equip_Prompt).CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON ChildEntry SF_Equip_Prompt.EL =
BEGIN
    DefectEquipment = VARCHAR(OrderNumber) + ';' + 
						VARCHAR(SF_Equip_Prompt.EL[].Object) + ';' +
                        SF_Equip_Prompt.EL[].Name;;
    FIELD(SF_Equip_Prompt.OK_Btn).CurBias = FB_LANDABLE;
END;

ON CLICK SF_Equip_Prompt.OK_Btn =
BEGIN
   IF DefectEquipment = '' THEN
      MESSAGE 'Select a piece of equipment to create a switching item';
      RESUME;
   ENDIF;
   
   CALLPROC SendEventToMainScreen();
   RETURN;
END;

PROCEDURE SendEventToMainScreen(
) =
BEGIN
   SOAFrame.SendUserEvent (EventName = 'SLC_DefectiveRelay', 
                           MessageInteger = JIP.Job,
                           MessageVarchar = DefectEquipment);
END;
