	Name:            CheckOutstandingTags

/*
**
**	Copyright c 2002 Pateric Software LLC  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckOutstandingTags 
**
**  Modifications:
**  04/02/04 ysp  Created; check if there is any outstanding directional or
**                certified tag on RFPs that are linked to the current card.
**  07/21/05 em   Exclude NO_LONGER_NEEDED RFP locations from the tag select.
**  08/30/05 em   Previous change did not take into account that each revision
**                inserts a new row in the rfp location table.  So even
**                if a location is marked as NO LONGER NEEDED, we may still
**                find the tag associated to the prior revision.  Hence
**                we perform our location check in a seperate SELECT.  Also
**                we add a DISTINCT SELECT to prevent duplicate rows.
**  02/15/06 em   Ignore Outstanding directional tags, only present warning
**                for Certified Tags.  Warning Reduction Act.
**  02/27/06 em   Reinstituted warning for Directional and Certified tags.
**                     
**
*/
PROCEDURE CheckOutstandingTags 
(
    JIP = JobInProgress;				/* Job being processed */

    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;

    i = INTEGER NOT NULL WITH DEFAULT;    
    k = INTEGER NOT NULL WITH DEFAULT;
    TagInWPLocation = INTEGER NOT NULL WITH DEFAULT;
    RFPTags = ARRAY OF IR_WorkLocationTag;
    TagDisposition = VARCHAR(17) NOT NULL WITH DEFAULT;
    WarningMessage = VARCHAR(256) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Find all certified tags on RFPs which are linked to the
**  current card.
*/
    k = 1;
    REPEATED
    SELECT DISTINCT
           :RFPTags[k].RequestForPermit = R.RequestForPermit,
           :RFPTags[k].WPLocation = T.RFPLocation,
           :RFPTags[k].Location = L.LocationStructure,
           :RFPTags[k].TagNumber  = T.TagNumber,
           :RFPTags[k].TagType  = T.TagType,
           :RFPTags[k].Phases = R.RFP  /*Need this for our location check */
    FROM    IR_RFPLocationTag T,
            IR_RFPLocation L,
            IR_RequestForPermit R
    Where   R.Card = :JIP.Card AND
            R.RFP = L.RFP AND
            L.RFP = T.RFP AND
            L.RFPLocation = T.RFPLocation AND
            T.TagType IN ('CERTIFIED', 'DIRECTIONAL')
    BEGIN
        k = k + 1;
    END;
/*
** Look for NO LONGER NEEDED Locations and remove in reverse order.
*/
    k = RFPTags.LastRow();
    WHILE k >= 1 DO
       i = 0;
       SELECT :i = RFP
       FROM   IR_RFPLocation
       WHERE  RFP = :RFPTags[k].Phases AND  /*Phases = RFP; see select*/
              RFPLocation = :RFPTags[k].WPLocation AND  /*Ditto*/
              RevisionStatus = 'NO_LONGER_NEEDED';
       IF i > 0 THEN   
          RFPTags.RemoveRow(rownumber = k);
       ENDIF;
       k = k - 1;
    ENDWHILE;     

    RetCode = NULL;
    FOR k = 1 TO RFPTags.LastRow() DO
/*
**  Check two things:
**  1. if a tag is not in a work permit location, give a warning
**  2. else if a tag's disposition is blank or 'LEFT', give a warning
*/
       TagInWPLocation = FALSE;
       TagDisposition = '';

       SELECT :TagInWPLocation = 1,
              :TagDisposition = WT.TagDisposition 
       FROM   IR_WorkLocation WL,
              IR_WorkLocationTag WT,
              SOA_JobControl JC
       WHERE  WT.TagType = :RFPTags[k].TagType AND
              WT.TagNumber = :RFPTags[k].TagNumber AND
              WT.WorkPermit = WL.WorkPermit AND
              WT.WPLocation = WL.WPLocation AND
              WL.RequestForPermit = :RFPTags[k].RequestForPermit AND
              WL.RFPLocation = :RFPTags[k].WPLocation AND
              WL.WorkPermit = JC.Job AND
              JC.Card = :JIP.Card AND
              JC.StepPair = :StepHeading$OTW;

        IF TagInWPLocation = FALSE OR TagDisposition = '' OR TagDisposition = 'LEFT' THEN

           WarningMessage = RFPTags[k].TagType + ' tag: ' + RFPTags[k].TagNumber;

           IF TagInWPLocation = FALSE THEN
              WarningMessage = WarningMessage + ' is outstanding with RFP location: ' + RFPTags[k].Location
           ELSEIF TagDisposition = '' THEN
              WarningMessage = WarningMessage + ' is outstanding with Work location: ' + RFPTags[k].Location
           ELSE
              WarningMessage = WarningMessage + ' is left with Work location: ' + RFPTags[k].Location
           ENDIF;   
           WarningMessage = WarningMessage + '.';  

           WarningStatus = CALLFRAME Warning 
                                (Card = JIP.Card, 
                                 Job = JIP.Job,
                                 SwitchingItem = JIP.SwitchingItem,
                                 Text = WarningMessage);   
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;
        ENDIF;
    ENDFOR;

    RETURN(RetCode)
END; 

Application Component Report
============================

	Name:            CheckPhaseBalanceRelay

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckPhaseBalanceRelay 
**
**  Modifications:
**  11/03/19 pkw    Created 
**  11/18/19 pkw    Don't look at RTFValue and present grey box warning to allow backout
**  06/23/21 em     Correct row-out-of-range run-time error on line 78
*/
PROCEDURE CheckPhaseBalanceRelay 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE    
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    ActiveCards = ARRAY OF FMS_Card;
    i = INTEGER NOT NULL;
    x = INTEGER NOT NULL;
    SkipWarning = INTEGER NOT NULL;
    FirstTime = INTEGER NOT NULL;
    Relay = ARRAY OF TypeClass;
    okList = ARRAY OF DDB_ApplicationClass;
ENDDECLARE
BEGIN
 
  WarningStatus = PU_OK;
  RetCode = NULL;

  i = 1;
  REPEATED 
  SELECT DISTINCT
         :ActiveCards[i].Card = C.Card,
         :ActiveCards[i].Feeder = C.Feeder,
         :ActiveCards[i].FeederName = C.FeederName,
         :ActiveCards[i].StationGround = C.StationGround,
         :ActiveCards[i].GroundsOn = C.GroundsOn,
         :ActiveCards[i].NetworkFeeder = C.NetworkFeeder,
         :ActiveCards[i].TypeOfCard = C.TypeOfCard
  FROM   FMS_Card C,
         SOA_ActiveCard AC,
         SOA_JobControl JC
  WHERE  JC.Job = :JIP.Job AND
         JC.Card = AC.Card AND
         AC.Card = C.Card
  BEGIN
     i = i + 1;
  END;

  i = 1;
  FirstTime = TRUE;

  WHILE i <= ActiveCards.LastRow() DO
    FeederName = ActiveCards[i].GetGeneralCardName();    
/*  
**  See if card had only one Relay operated that was a 46T phase balance relay.
*/
    x = 1;
    SELECT :Relay[x].Name = R.RelayTypeName
    FROM   CAC_RelayOps R,
           CAC_RelayOpsControl RC
    WHERE  RC.Card = :ActiveCards[i].Card AND
           RC.RelayOp = R.RelayOp
    BEGIN
       x = x + 1;
    END;
    
    IF Relay.LastRow > 0 THEN
     IF Relay.LastRow = 1 AND Relay[1].Name like '46T%' THEN
       IF AutomaticExecution = FALSE THEN
          okList[1].Name = 'Additional Relay Targets';
          okList[2].Name = 'RTF Data';
          okList[3].Name = 'Consult with Regional Control Center';
          i = CALLFRAME DDB_Message(MessageText = 'Phase Balance Relay Reported.  Did you check the following?' + HC_NEWLINE,
                         Timeout = 300,
                         tf = okList.Duplicate(),
                         HasCancel = TRUE);
          IF i = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ENDIF;
       ENDIF;
       WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
                                          Job = JIP.Job,
                                          SwitchingItem = JIP.SwitchingItem,
                                          Text = 'Phase Balance Relay Reported on Feeder.');
       IF WarningStatus = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RetCode = Warning$Overridden;
       ENDIF;
     ENDIF;
    ENDIF;
   
    i = i + 1;
  ENDWHILE;

  RETURN(RetCode);
END;

Application Component Report
============================

	Name:            CheckPortableGround

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
*/
/*
**  Application:    SOA
**  Frame:          CheckPortableGround 
**
**  Modifications:
**  04/02/96  wc    Created 
**  09/24/96  wc    Added code to created a view table to improve the performance
**  04/28/99  em    Incorporated into SOA
**  11/26/02  pkw   Change Job to JIP for Merge.
**  06/17/09  em    Ignore check for Operating Order; add PortableGroundisOn flag
*/
PROCEDURE CheckportableGround 
(
    JIP = JobInProgress;                /* Pasesed Job */
    IssuedOperator = INTEGER;           /* Current Operator */
    IssuedMoves = ARRAY OF JobInProgress; /* Moves issued to this operator */
    i = INTEGER;
    NotPortableGround = INTEGER NOT NULL; /*BOOLEAN */
    RetCode = INTEGER;                  /* Warning frame return code */
) =
BEGIN
/*
** Use global Field Operator which must established before the check is 
** performed.  Operator is selected, then jobchecks are performed.
*/
    IssuedOperator = FO.Object;  
    PortableGroundConditionisON = TRUE;
/*
**  check to see if any other outstanding moves issued to this operator  
*/
     IF IssuedOperator = 0 OR IssuedOperator = Operator$OpOrder THEN
        RETURN(PU_OK);
     ENDIF;
/*  
** Look for outstanding moves issued to this operator on this card.  Must limit 
** search to this card for performance reasons.  Not reasonable to search job
** table based on an operator.
*/
     i = 1;
     REPEATED
     SELECT 
     DISTINCT :IssuedMoves[i].JobClass = J.JobClass,
              :IssuedMoves[i].EquipClass = J.EquipClass,
              :IssuedMoves[i].StepPair = JC2.StepPair,
              :IssuedMoves[i].Job = JC2.Job
     FROM     SOA_Job J,
              SOA_JobControl JC,
              SOA_JobControl JC2,
              SOA_ActiveCard AC
     WHERE    JC.Job = :JIP.Job AND
              JC.Card = JC2.Card AND
              JC2.StepPair <> :StepHeading$TestPermit AND
              JC2.Job <> :JIP.Job AND
              JC2.Job = J.Job AND
              J.Status = '' AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.TOIssued IS NOT NULL AND
              J.TOComplete IS NULL AND
              J.TOOperator = :IssuedOperator AND
              JC2.Card = AC.Card AND    /* must be active card/sw item*/
              J.SwItemStatus < :Card$Closed
     UNION
     SELECT   J.JobClass,
              J.EquipClass,
              JC2.StepPair,
              JC2.Job
     FROM     SOA_Job J,
              SOA_JobControl JC,
              SOA_JobControl JC2,
              SOA_ActiveCard AC
     WHERE    JC.Job = :JIP.Job AND
              JC.Card = JC2.Card AND
              JC2.StepPair <> :StepHeading$TestPermit AND
              JC2.Job <> :JIP.Job AND
              JC2.Job = J.Job AND
              J.Status = '' AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.RSIssued IS NOT NULL AND
              J.RSComplete IS NULL AND
              J.RSOperator = :IssuedOperator AND
              JC2.Card = AC.Card AND    /* must be active card/sw item*/
              J.SwItemStatus < :Card$Closed
     BEGIN
          i = i + 1;         
     END;
/*
** If the other issued move is a portable ground (checks ground), we let it go
*/

     IF i = 1 THEN  /*No other outstanding moves */
        RETURN PU_OK;
     ENDIF;

     i = 1;
     WHILE i <= IssuedMoves.LastRow() DO

         NotPortableGround = TRUE;        
         SELECT :NotPortableGround = :FALSE
         FROM   FMS_JobCheck JC
         WHERE  JC.JobClass = :IssuedMoves[i].JobClass AND
                JC.JobCheck = :JobCheck$PreCheck AND
                JC.StepPair = :IssuedMoves[i].StepPair AND
                :IssuedMoves[i].EquipClass IN (
                           SELECT Type FROM Udb_ExtendedType
                           WHERE  SuperType = JC.EquipClass ) AND
                JC.Status = :PreCheck$PortableGround;

         IF NotPortableGround = TRUE THEN
            ENDLOOP;
         ELSE
            i = i + 1;
         ENDIF;
     ENDWHILE;

     IF NotPortableGround = TRUE THEN
        RetCode = CALLFRAME Warning ( Card = JIP.Card, 
                                     Job = JIP.Job,
                                     SwitchingItem = JIP.SwitchingItem,
                Text = 'When a portable ground is issued to an operator, ' + 
                       'this operator cannot have any other type of moves ' +
                       'outstanding and issued at the same time.');
            
        IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
        ELSE
            RETURN(Warning$Overridden);            
        ENDIF;   
     ENDIF;     

     RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckPQNode

/*
**
