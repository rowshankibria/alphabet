METHOD InactivateFile (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   
   EmailClass = EmailNotificationClass DEFAULT NULL;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.InactiveDate = DATE('now');
   RetCode = CALLPROC FMS_DissFileInactivate (
       FileID = CurObject.FileID,
       InactiveDate = CurObject.InactiveDate);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'DissFileRecord.InactivateFile; Error inactivating DisseminationFile ' + 
                               VARCHAR(CurObject.FileID);
      CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InactivateFile. ERROR: ' + 
                'Unable to inactivate DisseminationFile ' + 
                               VARCHAR(CurObject.FileID));
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
END;
      
METHOD InsertFile (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.LoadDate = DATE('now');
   RetCode = CALLPROC FMS_DisseminationFileIns (
       FileName = CurObject.FileName,
       Title = CurObject.Title,
       LoadDate = CurObject.LoadDate,
       LoadUserName = CurObject.LoadUserName);
   
   IF RetCode > 0 THEN
      CALLPROC DDB_COMMIT;
      CurObject.FileID = RetCode;
   ELSEIF RetCode = -99 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -99;
      CurObject.ErrorMessage = 'DissFileRecord.InsertFile; Dissemination File ' + CurObject.FileName + ' Already Exists';
      CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InsertFile. ERROR: ' + 
                'Dissemination File ' + CurObject.FileName + ' Already Exists');
      RETURN;
   ELSEIF RetCode <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'DissFileRecord.InsertFile; Error saving Dissemination File ' + CurObject.FileName;
      CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InsertFile. ERROR: ' + 
                'Dissemination File ' + CurObject.FileName + ' Insert Failed');
      RETURN;
   ENDIF;
/*
** Now save attachment
*/   
   CurObject.Attachment.FileID = CurObject.FileID;
   CurObject.Attachment.InsertAttachment ();
   IF CurObject.Attachment.ReturnCode < 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'DissFileRecord.InsertFile; Error saving pdf file Content ' + CurObject.FileName;
      CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InsertFile. ERROR: ' + 
                'Dissemination File pdf ' + CurObject.FileName + ' Insert Failed');
      RETURN;

   ELSEIF CurObject.Attachment.DBServer > 0 THEN  /* Single Server */
      CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InsertFile. Warning: ' + 
                'Dissemination File pdf ' + CurObject.FileName + ' save to DB' + VARCHAR(CurObject.Attachment.DBServer) + ' only');
      RetCode = CALLPROC FMS_DisseminationFileUpd (
          FileID = CurObject.FileID,
          DBServer = CurObject.Attachment.DBServer);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'DissFileRecord.InsertFile; Unable to mark single server for pdf file ' + CurObject.FileName;
         CurMethod.Trace(Text = varchar(date('now')) + ':DissFileRecord.InsertFile. ERROR: ' + 
                'Unable to mark single server for Dissemination File ' + CurObject.FileName);
         RetCode = CALLPROC FMS_DisseminationFileDel(
                              FileID = CurObject.FileID);
         CALLPROC DDB_COMMIT;
         RETURN;
      ENDIF;
   ENDIF;       
   RETURN;
END;
       
   

