      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to log reason for removing exception in database.';
   ENDIF; 
 
   RETURN;   
END;


METHOD Load_TvKpi (
   EffectiveCardTypes = ARRAY OF IntegerObject;  /* List of cardtypes */
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);
   WhereClause3G = VARCHAR(1500);
   CL = ARRAY OF CardLog;
   MultiDivFdr = ARRAY OF IntegerObject;
   DivisionList = ARRAY OF Division;
   SubTypeWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   OutageWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardFilterWhereClause  = VARCHAR(500) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   SimpleOSS = FMS_MgtReports_ASE DEFAULT NULL;
   TimeNow = DATE NOT NULL WITH DEFAULT;
   TempLC = ListedCard;                                         
   StartDate = DATE;
   EndDate = DATE;
   TargetFCR = VARCHAR(20) NOT NULL WITH DEFAULT;
   TargetDiv = INTEGER NOT NULL;
   PermitIssued = DATE;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with TV outages
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
    
   TimeNow = date('now');  


#  include MgtRpt_SelectClause
/*
**  CardClass is not in fms_operatingstepstatus so we need to use CardClassName. 
*/
   DynamicWhereClause = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
      'CTO.Object = OO.Object AND OO.PrimaryGrouping = O.Object ' +
      ' AND O.PrimaryGrouping IN ( '; 


   WhereClause3G = OutageWhereClause + ' AND ' + CardFilterWhereClause + ' AND ' +
      'CTO.Object = O.Object ' +
      ' AND O.PrimaryGrouping IN ( '; 


   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
        
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
            
      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
            
      ENDIF;
   ENDIF;


   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
         WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';


         WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;


   DynamicWhereClause = DynamicWhereClause + ' AND C.CardClass IN ( ';
   WhereClause3G = WhereClause3G + ' AND C.CardClass IN ( ';


   IF EffectiveCardTypes.LastRow() = 0 THEN  /* Called from ASP */
      If lowercase(CurObject.CardTypeName) like 'all%' THEN
         /*
         **  Load Report Card types table
         */
         IF SimpleOSS IS NULL THEN
            SimpleOSS = FMS_MgtReports_ASE.Create();
         ENDIF;
         
         SimpleOSS.LoadReportCardTypes();
         
         IF SimpleOSS.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleOSS.OSS.LastRow() DO
               IF i = SimpleOSS.OSS.LastRow() THEN
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ')';
               ELSE
                  DynamicWhereClause = DynamicWhereClause + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';


                  WhereClause3G = WhereClause3G + 
                     VARCHAR(SimpleOSS.OSS[i].CardClass) + ',';
               ENDIF;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleOSS.ErrorMessage;
            RETURN;
         ENDIF;
         SimpleOSS = NULL;
         
      ELSE
         IF CurObject.CardType = Report$AutoAll THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        


            WhereClause3G = WhereClause3G + 
               VARCHAR(:Type$Auto) + ',' + VARCHAR(:Type$CIOA) + ',' + VARCHAR(:Type$FOT) + ')';        
         ELSEIF CurObject.CardType <> 0 THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(CurObject.CardType) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(CurObject.CardType) + ')';
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'had no card type parameter supplied with it.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'No card type parameter supplied.';
            RETURN;
         ENDIF;  
      ENDIF;
   ELSE  /* Called from OpenRoad */
      i = 1;
      WHILE i <= EffectiveCardTypes.LastRow() DO
 
         IF i = EffectiveCardTypes.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';


            WhereClause3G = WhereClause3G + 
               VARCHAR(EffectiveCardTypes[i].Value) + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';


            WhereClause3G = WhereClause3G + 
            VARCHAR(EffectiveCardTypes[i].Value) + ',';
         ENDIF;
         i = i + 1;
      ENDWHILE;
   ENDIF;
   /*
   **  First select all log entries with TV Update Duration as the Item
   */
   i = 1;
   CL.Clear();
   SELECT :CL[i].Time = L.Time,
          :CL[i].Card = L.Card,
          :CL[i].Item = L.Item,
          :CL[i].Old  = L.Old,
          :CL[i].New  = L.New
   FROM    SOA_Log L
   WHERE   L.Time > :CurObject.StartDate AND
           lowercase(L.Item) = 'tv update duration' 
   UNION
   SELECT L.Time,
          L.Card,
          L.Item,
          L.Old,
          L.New
   FROM    FMS_ArchiveLog L
   WHERE   L.Time > :CurObject.StartDate AND
           lowercase(L.Item) = 'tv update duration' 
   
   ORDER BY Time DESC
   BEGIN
      i = i + 1;
   END;
   /*
   **  Build array of all feeders in multiple divisions
   */
   i = 1;
   MultiDivFdr.Clear();
   SELECT :MultiDivFdr[i].Value = G.Member
   FROM    Udb_Grouping G
   WHERE   G.GroupingType = :Type$Division AND 
           G.Relationship = :Interaction$MemberOf AND 
           G.MemberType = :Type$Feeder
   GROUP BY Member 
   HAVING COUNT(*) > 1 
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   /*
   **  Build Division List
   */
   IF SimpleDivision IS NULL THEN
      SimpleDivision = Division_ASE.Create();
   ENDIF;
         
   SimpleDivision.LoadDivisions();
        
   IF SimpleDivision.ReturnCode = 0 THEN
      i = 1;
      WHILE i <= SimpleDivision.Dlist.LastRow() DO
         DivisionList[i].Division = SimpleDivision.Dlist[i].Division;
         DivisionList[i].DivisionName = SimpleDivision.Dlist[i].DivisionName;
         i = i + 1;
      ENDWHILE;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
      SimpleDivision = NULL;
      RETURN;
   ENDIF;
   SimpleDivision = NULL;


   CurObject.TvKpi_minutes = 0;
   CurObject.TvKpi_avg_minutes = 0;
   i = 1;
   j = 1;
   CurObject.TvKpi.Clear();
   CurObject.TvKpi_exclude.Clear();
   SELECT DISTINCT
          :TempLC.IsArchive = 0,
          :TempLC.Card = C.Card,
          :TempLC.Division = O.PrimaryGrouping,
          :TempLC.DivisionName = O.PrimaryGroupingName,
          :TempLC.SubstationName = O.Description,
          :TempLC.CutOut = C.CutOut,
          :TempLC.CutIn = IFNULL(C.CutIn,''),
          :TempLC.EstTimeInService = IFNULL(C.EstTimeInService,''),
          :TempLC.Feeder = C.Feeder,
          :TempLC.FeederName = C.FeederName,
          :TempLC.CardClass = C.CardClass,
          :TempLC.CardClassName = C.CardClassName,
          :TempLC.TV_Bogey = C.TV_Bogey,
          :TempLC.TV_Reason = ''
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          Udb_ExtendedType S,
          Udb_Object OO,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :DynamicWhereClause


   UNION 
   SELECT 0,
          C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          C.SubstationName,
          C.CutOut,
          IFNULL(C.CutIn,''),
          IFNULL(C.EstTimeInService,''),
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          C.TV_Bogey,
          ''
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          Udb_ExtendedType S,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :WhereClause3G


   UNION 
   SELECT 1,
          C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          O.Description,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          IFNULL(C.EstTimeInService,''),
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          C.TV_Bogey,
          ''
   FROM   FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          Udb_ExtendedType S,
          Udb_Object OO,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :DynamicWhereClause


   UNION 
   SELECT 1,
          C.Card,
          O.PrimaryGrouping,
          O.PrimaryGroupingName,
          C.SubstationName,
          C.CutOut,
          IFNULL(C.CutIn,C.Closed),
          IFNULL(C.EstTimeInService,''),
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          C.TV_Bogey,
          ''
   FROM   FMS_ArchiveCard C,
          TFMS_ArchiveCardToObject CTO,
          Udb_ExtendedType S,
          Udb_Object O,
          Udb_Grouping GR,
          Udb_Rating R
   WHERE  :WhereClause3G


   ORDER BY FeederName,Card
   BEGIN


      RetCode = MultiDivFdr.Find(AttributeName = 'Value',
                        Value = TempLC.Feeder);
      IF RetCode = ER_OK THEN  /* Feeder has member of multiple divisions */
         TargetFCR = '';
         IF TempLC.IsArchive = 0 THEN
            SELECT :TargetFCR = WP.TargetFCR,
                   :PermitIssued = J.ToIssued
            FROM   SOA_JobControl JC,
                   SOA_Job J,
                   IR_Workpermit WP
            WHERE  JC.Card = :TempLC.Card AND
                   JC.Job = J.Job AND
                   J.Job = WP.WorkPermit AND
                   WP.TargetFCR <> ''
            ORDER BY PermitIssued DESC;
         ELSE
            SELECT :TargetFCR = WP.TargetFCR,
                   :PermitIssued = J.ToIssued
            FROM   FMS_ArchiveJob J,
                   IR_Workpermit WP
            WHERE  J.Card = :TempLC.Card AND
                   J.Job = WP.WorkPermit AND
                   WP.TargetFCR <> ''
            ORDER BY PermitIssued DESC;
         ENDIF;
         TargetDiv = 0;
         IF TargetFCR = 'B' THEN
            TargetDiv = Division$Brooklyn;
         ELSEIF TargetFCR = 'M' THEN
            TargetDiv = Division$Manhattan;
         ELSEIF TargetFCR = 'Q' THEN
            TargetDiv = Division$Queens;
         ELSEIF TargetFCR = 'R' THEN
            TargetDiv = Division$StatenIsland;
         ELSEIF TargetFCR = 'W' THEN
            TargetDiv = Division$Westchester;
         ELSEIF TargetFCR = 'X' THEN
            TargetDiv = Division$Bronx;
         ENDIF;
         
         IF TargetDiv <> 0 AND
            TargetDiv <> TempLC.Division THEN
            
            RetCode = DivisionList.Find(AttributeName = 'Division',
                        Value = TargetDiv,
                        RowNumber = ByRef(k));
            IF RetCode = ER_OK THEN
               TempLC.Division = DivisionList[k].Division;
               TempLC.DivisionName = DivisionList[k].DivisionName;
            ENDIF;
         ENDIF;
      ENDIF;
 
      RetCode = CL.Find(AttributeName = 'Card',
                        Value = TempLC.Card,
                        RowNumber = ByRef(k));
      IF RetCode = ER_OK THEN  /* Card has a TV duration update */
         TempLC.Char_DurationInt = INT4(CL[k].New);
         TempLC.TV_Reason = CL[k].Old;
      ELSE
         IF TempLC.CutIn = '' THEN
            IF TempLC.EstTimeInService = '' THEN
               TempLC.Char_DurationInt = IFNULL(INT4(interval('minute',TimeNow - DATE(TempLC.CutOut))),0);
            ELSE
               TempLC.Char_DurationInt = IFNULL(INT4(interval('minute',DATE(TempLC.EstTimeInService) - DATE(TempLC.CutOut))),0);
            ENDIF;
         ELSE
            TempLC.Char_DurationInt = IFNULL(INT4(interval('minute',DATE(TempLC.CutIn) - DATE(TempLC.CutOut))),0);     
         ENDIF;
      ENDIF;
      IF TempLC.TV_Bogey < 0 THEN  /* excluded feeders */
         CurObject.TvKpi_exclude[j] = TempLC.Duplicate();
         j = j + 1;
      ELSE
         IF TempLC.CutIn <> '' THEN
            CurObject.TvKpi_minutes = CurObject.TvKpi_minutes + TempLC.Char_DurationInt;
            CurObject.TvKpi_Avg_minutes = CurObject.TvKpi_Avg_minutes + 1;       
         ENDIF;
         CurObject.TvKpi_Est_minutes = CurObject.TvKpi_Est_minutes + TempLC.Char_DurationInt;
         CurObject.TvKpi_Avg_Est_minutes = CurObject.TvKpi_Avg_Est_minutes + 1;
        
         CurObject.TvKpi[i] = TempLC.Duplicate();
         i = i + 1;
      ENDIF;
   END;       
   CALLPROC DDB_ROLLBACK;
   /*
   **  Calculate the Average minutes of inservice outages
   */
   IF CurObject.TVKpi_Avg_minutes <> 0 THEN
      CurObject.TvKpi_Avg_minutes = int4(float8(CurObject.TvKpi_minutes)/CurObject.TvKpi_Avg_minutes + 0.5);
   ENDIF;
   IF CurObject.TVKpi_Avg_Est_minutes <> 0 THEN
      CurObject.TvKpi_Avg_Est_minutes = int4(float8(CurObject.TvKpi_Est_minutes)/CurObject.TvKpi_Avg_Est_minutes + 0.5);
   ENDIF;
   RETURN;
END;


METHOD Load_BogeyLegend (
)=
DECLARE
   TV     = INTEGER NOT NULL;
   TVType = INTEGER NOT NULL;
   i      = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load BogeyTimes for OperatingSteps.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :CurObject.TM_BogeyEnabled = TM_BogeyEnabled
   FROM    FMS_SystemParameters;
   CALLPROC DDB_ROLLBACK;


   CurObject.OSS.Clear();
   i = 1;
   SELECT :CurObject.OSS[i].OperatingStep = B.Status,
          :CurObject.OSS[i].OperatingStepName = B.StatusName,
          :CurObject.OSS[i].Description = T.Description,
          :CurObject.OSS[i].DurationMins = B.BogeyAlert,
          :TVType = B.Type 
   FROM    TM_BogeyType B,
           Udb_Type T
   WHERE   B.Type = :CurObject.Filter AND
           B.Status = T.Type
   union
   SELECT  B.Status,
           B.StatusName,
           'Total Duration a feeder has been out of service',
           B.BogeyAlert,
           B.Type
   FROM    TM_BogeyType B
   WHERE   B.Type = :TM$OtherType AND
           B.Status = :TM$StatusOutOfService
   BEGIN
      CurObject.OSS[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = 
                                         CurObject.OSS[i].DurationMins);
             
      IF CurObject.OSS[i].OperatingStep = Type$OTWR OR
         CurObject.OSS[i].OperatingStep = Type$OTWS OR
         CurObject.OSS[i].OperatingStep = Type$OTWPlus OR
         CurObject.OSS[i].OperatingStep = Type$INSP OR
         CurObject.OSS[i].OperatingStep = Type$LOC OR
         CurObject.OSS[i].OperatingStep = Type$ABF OR
         CurObject.OSS[i].OperatingStep = Type$ISOStep OR
         CurObject.OSS[i].OperatingStep = Type$STA OR
         CurObject.OSS[i].OperatingStep = Type$FG OR
         CurObject.OSS[i].OperatingStep = Type$TEST OR
         CurObject.OSS[i].OperatingStep = Type$PFSS OR
         CurObject.OSS[i].OperatingStep = Type$PFSF THEN
         /*
         ** Filter out expanded opsteps from legend
         */
         CurObject.OSS.RemoveRow (RowNumber = i);


      ELSEIF TVType = Type$OperatingStepStatus THEN
         /*
         **  Get values for Temperature Variable
         */
         SELECT :TV = B.BogeyAlert
         FROM    TM_BogeyType B
         WHERE   B.Type = :TM$TVBogey AND
                 B.Status = :CurObject.OSS[i].OperatingStep;
         CurObject.OSS[i].Char_TotDuration = CALLPROC ConvertHour(Tot_Min = TV); 


         i = i + 1;
      ELSEIF TVType = TM$OtherType THEN
         SELECT :TV = B.BogeyAlert
         FROM    TM_BogeyType B
         WHERE   B.Type = :TM$TVOtherType AND
                 B.Status = :TM$StatusOutOfService;
         CurObject.OSS[i].Char_TotDuration = CALLPROC ConvertHour(Tot_Min = TV); 
      
         i = i + 1;
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;


   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Bogey information found.';
      RETURN;
   ENDIF;
   
   RETURN;
END;




METHOD Load_OSDetails (
)=
DECLARE
   TimeNow = DATE NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Details for and operating step or delay.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK;
   
   i = 1;
   CurObject.OSS.Clear();
   REPEATED
   SELECT :CurObject.OSS[i].OperatingStepName = OS.OperatingStepName,
          :CurObject.OSS[i].StartTime = OS.StartTime,
          :CurObject.OSS[i].EndTime = OS.EndTime,
          :CurObject.OSS[i].DurationMins = OS.DurationMins,
          :CurObject.OSS[i].Description = T.Description,
          :CurObject.OSS[i].FeederName = OS.FeederName
   FROM   FMS_ArchiveOperatingStep OS,
          Udb_ExtendedType ST,
          Udb_Type T
   WHERE  OS.Card = :CurObject.Card AND
          OS.OperatingStep = T.Type AND
          ST.SuperType = :CurObject.Filter AND
          ST.Type = T.Type
   union all
   SELECT OS.OperatingStepName,
          OS.StartTime,
          OS.EndTime,
          OS.DurationMins,
          T.Description,
          OS.FeederName
   FROM   FMS_OperatingStepStatus OS,
          FMS_Card C,
          Udb_ExtendedType ST,
          Udb_Type T
   WHERE  OS.Card = :CurObject.Card AND
          OS.Card = C.Card AND
          C.Status < :Card$Closed AND
          OS.OperatingStep = T.Type AND
          ST.SuperType = :CurObject.Filter AND
          ST.Type = T.type      
   BEGIN
      IF CurObject.OSS[i].EndTime = '' THEN
         CurObject.OSS[i].DurationMins = INT4(interval('minute',TimeNow - 
                                      DATE(CurObject.OSS[i].StartTime)));
      ENDIF;
      CurObject.OSS[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = 
                                      CurObject.OSS[i].DurationMins);           
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;


   IF CurObject.OSS.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Details found.';
      RETURN;
   ENDIF;
   
   RETURN;
END;


METHOD Load_AuditTrail(
)=
DECLARE
   DynamicWhereClause = VARCHAR(600) NOT NULL WITH DEFAULT;
   TimeNow = DATE NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Details for and operating step or delay.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   IF CurObject.Filter = 1 THEN        /* FMS_Security table */      
      DynamicWhereClause = 'T.Entity = ''FMS_Security'' ';


      IF CurObject.StartDate <> '' THEN
         DynamicWhereClause  = DynamicWhereClause + ' AND T.LogTime >= DATE(''' + VARCHAR(CurObject.StartDate) + ''')';
      ENDIF;


      IF CurObject.EndDate <> '' THEN
         DynamicWhereClause  = DynamicWhereClause + ' AND T.LogTime <= DATE(''' + VARCHAR(CurObject.EndDate) + ''')';
      ENDIF;


      IF CurObject.OperatorName <> '' THEN
         DynamicWhereClause  = DynamicWhereClause + ' AND UPPERCASE(T.OperatorName) = ''' + UPPERCASE(CurObject.OperatorName) + ''''; 
      ENDIF;


      IF CurObject.UserName <> '' THEN
         DynamicWhereClause  = DynamicWhereClause + ' AND UPPERCASE(T.HandleName) LIKE ''%' + UPPERCASE(CurObject.UserName) + '%'''; 
      ENDIF;


      i = 1;
      SELECT  :CurObject.AuditList[i].Entity = T.Entity,
              :CurObject.AuditList[i].Handle = T.Handle,
              :CurObject.AuditList[i].HandleName = T.HandleName,
              :CurObject.AuditList[i].LogTime = T.LogTime,
              :CurObject.AuditList[i].OperatorName = T.OperatorName,
              :CurObject.AuditList[i].Item = T.Item,
              :CurObject.AuditList[i].Old = T.Old,
              :CurObject.AuditList[i].New = T.New
      FROM   FMS_AuditTrail T
      WHERE  :DynamicWhereClause
      ORDER BY LogTime, HandleName
      BEGIN
         i = i + 1;
      END;     
   ENDIF;


   RETURN;
END;


METHOD Load_SSOReport (
   EffectiveCardTypes = ARRAY OF IntegerObject;  /* List of cardtypes */
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
   OrderType = VARCHAR(14) NOT NULL;
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500);


   General_WC  = VARCHAR(1500);
   
   RR_FMS_Regular_WC  = VARCHAR(1500);    // electronic regular order where clause
   RR_TOMS_Regular_WC = VARCHAR(1500);   
   RR_TLS_Regular_WC  = VARCHAR(1500);
   
   RR_FMS_WP_WC  = VARCHAR(1500);         // electronic work permit where clause
   RR_TOMS_WP_WC = VARCHAR(1500);
   RR_TLS_WP_WC  = VARCHAR(1500);
   
   V_Active_SOA_Regular_TO_WC   = VARCHAR(1500);      // verbal Regular Takeout order on active cards
   V_Active_SOA_Regular_RS_WC   = VARCHAR(1500);
   
   V_Archive_FMS_Regular_TO_WC  = VARCHAR(1500);
   V_Archive_FMS_Regular_RS_WC  = VARCHAR(1500);
   
   V_Archive_TOMS_Regular_TO_WC = VARCHAR(1500);
   V_Archive_TOMS_Regular_RS_WC = VARCHAR(1500);
   
   V_TLS_Regular_TO_WC = VARCHAR(1500);
   V_TLS_Regular_RS_WC = VARCHAR(1500);
   
   V_Active_SOA_WP_WC   = VARCHAR(1500);        // verbal Work Permit on active cards
   V_Archive_FMS_WP_WC  = VARCHAR(1500);
   V_Archive_TOMS_WP_WC = VARCHAR(1500);
   V_TLS_WP_WC          = VARCHAR(1500);


   i = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   OldDivisionID = INTEGER NOT NULL WITH DEFAULT;
   OldDivisionName = VARCHAR(40) NOT NULL WITH DEFAULT;
   OldOrder = INTEGER NOT NULL WITH DEFAULT;


   OldJob = INTEGER NOT NULL WITH DEFAULT;
   OldTORS = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SimpleDivision = Division_ASE;            /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with substation electronic and verbal orders
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Load Division table
*/     
   SimpleDivision.LoadDivisions();
      
   IF SimpleDivision.ReturnCode <> 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
      SimpleDivision = NULL;
      RETURN;
   ENDIF;
/*
**  Create a temporary table for substation equipment
*/
   DECLARE GLOBAL TEMPORARY TABLE SESSION.StationEquip 
      (Substation INTEGER NOT NULL, 
       Equip INTEGER NOT NULL) 
      ON COMMIT PRESERVE ROWS WITH NORECOVERY;


   INSERT INTO SESSION.StationEquip (Substation, Equip)
       SELECT G.Grouping, 
              O.Object
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  O.Type IN (SELECT Type
                         FROM Udb_ExtendedType
                         WHERE Supertype = :Type$Switch) AND
              O.Object = G.Member AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Substation);


/*
**  Need different Where Clauses.  Each one is slightly different. 
*/
   General_WC = ' (OO.IssueTime BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'OO.OrderStatus IN (' + VARCHAR(Order$Downloaded) + ',' + 
                                  VARCHAR(Order$Acknowledged) + ',' + 
                                  VARCHAR(Order$Closed) + ',' + 
                                  VARCHAR(Order$ConfirmClosed) + ') AND ' +
          'OO.OrderNumber = OJ.OrderNumber AND ' + 
          'OJ.Job = J.Job AND ' +
          'OO.Substation = S.Object AND ' + 
          'OO.Substation = G.Member AND ' + 
          'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G.Grouping in ( ';


   RR_FMS_Regular_WC = 'OO.Application = ''FMS'' AND ' + 
                       'OO.OrderType = ''REGULAR'' AND ' + 
                       General_WC;
                       
   RR_FMS_WP_WC = 'OO.Application = ''FMS'' AND ' + 
                       'OO.OrderType = ''WORK PERMIT'' AND ' + 
                       General_WC;
   
   RR_TOMS_Regular_WC = 'OO.Application <> ''FMS'' AND ' + 
                       'OO.OrderType = ''REGULAR'' AND ' + 
                       General_WC;


   RR_TOMS_WP_WC = 'OO.Application <> ''FMS'' AND ' + 
                       'OO.OrderType = ''WORK PERMIT'' AND ' + 
                       General_WC;


   RR_TLS_Regular_WC = 'OO.OrderType = ''REGULAR'' AND ' + 
                       General_WC;


   RR_TLS_WP_WC = 'OO.OrderType = ''WORK PERMIT'' AND ' + 
                       General_WC;


   // active fms, toms and slc verbal moves 
   General_WC = 'JC.Card = C.Card AND ' +     
          'J.ControlCard = C.Card AND ' +       // filter out common and shadow moves
          'J.Substation = S.Object AND ' + 
          'J.Substation = G.Member AND ' + 
          'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G.Grouping in ( ';


   V_Active_SOA_Regular_TO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          'J.Job = JC.Job AND ' + 
          'JC.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          General_WC;


   V_Active_SOA_Regular_RS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.RSOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          'J.Job = JC.Job AND ' + 
          'JC.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          General_WC;


   V_Active_SOA_WP_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          'J.Job = JC.Job AND ' + 
          'JC.StepPair = ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          General_WC;


   // archive fms verbal moves ?? HOW TO PREVENT A COMMON JOB IN SOA??
   General_WC = 
          'J.Equip = SE.Equip AND ' + 
          'SE.Substation = S.Object AND ' + 
          'SE.Substation = G.Member AND ' + 
          'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G.Grouping in ( ';


   V_Archive_FMS_Regular_TO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;
          
   V_Archive_FMS_Regular_RS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.RSOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;


   V_Archive_FMS_WP_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair = ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;


   // archive toms verbal moves.       
   General_WC = 'J.Substation = S.Object AND ' + 
          'J.Substation = G.Member AND ' + 
          'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G.Grouping in ( ';


   V_Archive_TOMS_Regular_TO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;


   V_Archive_TOMS_Regular_RS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair <> ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.RSOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;
          
   V_Archive_TOMS_WP_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair = ' + VARCHAR(StepHeading$WorkPermit) + ' AND ' + 
          'J.TOOperator <> ' + VARCHAR(Operator$OpOrder) + ' AND ' +
          General_WC;


   // tls verbal moves. 
   General_WC = 'J.Job NOT IN (SELECT OJ.Job ' + 
                              ' FROM IR_TelephoneOrder OO, IR_TLSOrderJob OJ ' + 
                              ' WHERE OO.Card = J.Card AND ' + 
                              '       OO.OrderNumber = OJ.OrderNumber AND ' + 
                              '       OO.OrderStatus IN (' + VARCHAR(Order$Downloaded) + ',' + 
                                                             VARCHAR(Order$Acknowledged) + ',' + 
                                                             VARCHAR(Order$Closed) + ',' + 
                                                             VARCHAR(Order$ConfirmClosed) + ')) AND ' +
          'J.Substation = S.Object AND ' + 
          'J.Substation = G.Member AND ' + 
          'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G.Grouping in ( ';
          
   V_TLS_Regular_TO_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair NOT IN (' + VARCHAR(StepHeading$TLS_ISWP) + ',' + VARCHAR(Step$WorkPermit) + ') AND ' + 
          General_WC;
      
   V_TLS_Regular_RS_WC = ' (J.RSIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair NOT IN (' + VARCHAR(StepHeading$TLS_ISWP) + ',' + VARCHAR(Step$WorkPermit) + ') AND ' + 
          General_WC;
      
   V_TLS_WP_WC = ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' +
          'J.StepPair IN (' + VARCHAR(StepHeading$TLS_ISWP) + ',' + VARCHAR(Step$WorkPermit) + ') AND ' + 
          General_WC;


   If lowercase(CurObject.DivisionName) like 'all%' THEN
      i = 1;
      WHILE i <= SimpleDivision.Dlist.LastRow() DO
         EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
         i = i + 1;
      ENDWHILE;            
   ELSE
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;  
   ENDIF;
   
   DynamicWhereClause = '';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';


      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
     
   i = 1;
   OldDivisionID = 0;
   OldDivisionName = ''; 
   
   IF OrderType = 'REGULAR' THEN
      RR_FMS_Regular_WC  = RR_FMS_Regular_WC  + DynamicWhereClause;
      RR_TOMS_Regular_WC  = RR_TOMS_Regular_WC  + DynamicWhereClause;   
      RR_TLS_Regular_WC  = RR_TLS_Regular_WC  + DynamicWhereClause;
      
      V_Active_SOA_Regular_TO_WC  = V_Active_SOA_Regular_TO_WC  + DynamicWhereClause;
      V_Active_SOA_Regular_RS_WC = V_Active_SOA_Regular_RS_WC + DynamicWhereClause;
    
      V_Archive_FMS_Regular_TO_WC  = V_Archive_FMS_Regular_TO_WC  + DynamicWhereClause;
      V_Archive_FMS_Regular_RS_WC = V_Archive_FMS_Regular_RS_WC + DynamicWhereClause;
     
      V_Archive_TOMS_Regular_TO_WC  = V_Archive_TOMS_Regular_TO_WC  + DynamicWhereClause;   
      V_Archive_TOMS_Regular_RS_WC = V_Archive_TOMS_Regular_RS_WC + DynamicWhereClause;
      
      V_TLS_Regular_TO_WC  = V_TLS_Regular_TO_WC  + DynamicWhereClause;
      V_TLS_Regular_RS_WC  = V_TLS_Regular_RS_WC  + DynamicWhereClause;
      
      IF 0 = 1 THEN
         CurMethod.Trace(Text = 'RR_FMS_Regular_WC = ' + RR_FMS_Regular_WC);
         CurMethod.Trace(Text = 'RR_TOMS_Regular_WC = ' + RR_TOMS_Regular_WC);
         CurMethod.Trace(Text = 'RR_TLS_Regular_WC = ' + RR_TLS_Regular_WC);
         CurMethod.Trace(Text = 'V_Active_SOA_Regular_TO_WC = ' + V_Active_SOA_Regular_TO_WC);  
         CurMethod.Trace(Text = 'V_Active_SOA_Regular_RS_WC = ' + V_Active_SOA_Regular_RS_WC);                                                           
         CurMethod.Trace(Text = 'V_Archive_FMS_Regular_TO_WC = ' + V_Archive_FMS_Regular_TO_WC);
         CurMethod.Trace(Text = 'V_Archive_FMS_Regular_RS_WC = ' + V_Archive_FMS_Regular_RS_WC);
         CurMethod.Trace(Text = 'V_Archive_TOMS_Regular_TO_WC = ' + V_Archive_TOMS_Regular_TO_WC);
         CurMethod.Trace(Text = 'V_Archive_TOMS_Regular_RS_WC = ' + V_Archive_TOMS_Regular_RS_WC);
         CurMethod.Trace(Text = 'V_TLS_Regular_TO_WC = ' + V_TLS_Regular_TO_WC);
         CurMethod.Trace(Text = 'V_TLS_Regular_RS_WC = ' + V_TLS_Regular_RS_WC);
      ENDIF;


CurMethod.Trace(Text = 'Start at ' + varchar(date('now')));
      
      // electronic orders
      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = J.RSMove,
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  IR_OperatingOrder OO,
            IR_OpOrderJobs OJ,  
            Udb_Grouping G,
            Udb_Object S,
            SOA_Job J 
      WHERE  :RR_FMS_Regular_WC           // Active 
      BEGIN      
         i = i + 1;
      END;
CurMethod.Trace(Text = 'i = ' + varchar(i) + ' after select 1 ' + varchar(date('now')));


      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
