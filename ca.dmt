	Name:            SelectOperator

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          SelectOperator
**
**  10/23/92  em    modified per integer/udb 
**  12/20/92  gjc   added window close logic to fix bug 6.
**  02/25/93  adl   fixed null integer warnings
**  04/07/93  em    removed repeated select for ddb
**  05/10/94  mts   Added flag indicating that select list should include
**		            only those with outstanding moves for this card.
**  05/13/94  mts   Added code "Cancel" frame if another user has taken control of card
**  05/30/95  pw    Update dbevent FMS_Card_Control_Taken
**  12/01/95  pw    Change objectclass to operatorclass
**  09/22/96  pw    Added AnyName flag to let operator type in any name when
**                  called from Registered tags display.
**  04/08/98  pkw   if DO flag is set to true only show District Operators.
**  05/01/00  em    card control change
**  04/10/01  em    Add Global District Operator.
**  12/12/01  em    Restructured District Operator SELECT
**  07/17/02  ysp   Merge: use an include script to handle card control
**  11/23/02  pkw   Merge: combine with selectoperator in SOA.  Get rid of
**                  OfferSelection field since it doesn't appear to be used 
**                  anymore.
**  12/27/07  ysp   Remove selection of District Operators. Use DOLogIn when
**                  selection of a District Operator is needed.
**  12/31/08  em    For Steam User, load operator list based on skill group.
**                  Provide Generic Operator selection.
**  02/02/09  em    IF JobClass = Caution, then Load Steam Dispatcher type operators.
**  04/05/09  ysp   Add optional Title parameter. 
**  09/30/09  em    Add Type parm fro Steam Dispatcher
*/

INITIALIZE
(
    JobClass = INTEGER NOT NULL WITH DEFAULT;   /*Optional Parameter used by Steam App*/
    AnyName = INTEGER NOT NULL WITH DEFAULT;
    Title = VARCHAR(80) NOT NULL WITH DEFAULT;  /* Optional parameter */
    OpType = INTEGER NOT NULL WITH DEFAULT;  /* Optional parm for Steam */

#   include StandardDeclarations

    GenOpName = STRINGOBJECT;
    j = integer;			/* Temporary counter */
    Jobs = Array of Job;
    OpASE = OperatorClass_ASE DEFAULT NULL;  
    Partial = ObjectClass;       /* partial operator (name) */
    ReducedList = ARRAY OF OperatorClass;	/* Reduced list of operators */
    OutStandingList = ARRAY OF OperatorClass;	/* Reduced list of operators */
    Row = Integer NOT NULL WITH DEFAULT; /* Row number */
    SSO = OperatorClass;                        /* Senior System Operator */
    wclause = varchar(1800);
) =
BEGIN
   IF TRIM(Title) <> '' THEN
      FIELD(SelectOperator).Title = Title;
   ENDIF;

   Selected.Description = '';
   Selected.Name = '';
   Row = 1;

/*
**  Load Operators
*/
   SelectOperator = OperatorList.Duplicate();
   IF UserRole = Role$Steam AND JobClass <> 0 THEN
      IF OpASE IS NULL THEN
         OpASE = OperatorClass_ASE.Create();
      ENDIF;

      RetCode = 0;
      IF JobClass = Type$Caution THEN
         OpASE.Type = Type$SteamDispatcher;
         OpASE.LoadByType();
      ELSE 
         RetCode = OpASE.LoadBySkill(JobClass = JobClass);
      ENDIF;
    
      IF RetCode = -1 THEN    /*Job Does not require skill, proceed normally*/
      ELSEIF RetCode = -2 THEN    /*No operators possess required skill, proceed normally*/
         MESSAGE 'The Move has a skill requirement, but no operators have this skill, so ' +
                 'select any operator';
      ELSE
         SelectOperator.Clear(); 
         SelectOperator = OpASE.OL.Duplicate();
      ENDIF;
   ENDIF;
/*
** For OpType Steam$Dispatcher, insert Senior System Operator to list.
*/
   IF OpType = Type$SteamDispatcher THEN
      IF OpASE IS NULL THEN
         OpASE = OperatorClass_ASE.Create();
      ENDIF;
      OpASE.Type = Type$SteamDispatcher;
      OpASE.LoadByType();
      SelectOperator.Clear(); 
      SelectOperator = OpASE.OL.Duplicate();
      SSO.Object = 1;
      SSO.Name = 'SSO';
      SSO.Description = 'Sr System Operator';
      SelectOperator.InsertRow (rownumber = 1, rowobject = SSO);
   ENDIF;

   Row = 1;

   WHILE Row <= SelectOperator.LastRow() DO

      IF SelectOperator[Row].Object = FO.Object THEN
         FIELD(SelectOperator).ActiveRow = Row;
         Selected.Object = SelectOperator[Row].Object;
         Selected.Name = SelectOperator[Row].Name;
         Selected.Description = SelectOperator[Row].Description;
         FO.Name = Selected.Name;
         FO.Description = Selected.Description; 
         ENDLOOP;
      ENDIF;

      Row = Row + 1;
   ENDWHILE;

   CALLPROC DDB_ROLLBACK;
   CurFrame.InputFocusField = FIELD(Selected.Description);

END;

/*
**	Handle an operator selection from the list
*/
ON ChildEntry SelectOperator =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   Selected.Object = SelectOperator[].Object;
   Selected.Name = SelectOperator[].Name;
   Selected.Description = SelectOperator[].Description;
/*
** Generic Steam Op logic
*/
   IF Selected.Object = Operator$SteamDistribMechanic OR
      Selected.Object = Operator$StationOperator OR
      Selected.Object = Operator$StationSupervisor THEN

      IF CurFrame.ReplyPopUp (MessageText = 'Please enter the name of the ' +
           'operator being issued the move(s).', Reply = GenOpName) = PU_OK THEN
         Selected.Description = GenOpName.Value;
      ELSE
         Selected.Object = 0;
         Selected.Name = '';
         Selected.Description = '';
         RESUME;
      ENDIF;
   ENDIF;
   
   FO.Object = Selected.Object;
   FO.Name = Selected.Name;
   FO.Description = Selected.Description;
END;

/*
**	Handle an operator selection by operator number
*/
ON SetValue Selected.Name =
BEGIN
/*
** Pick out everyone on the list with a similar "ctrl number"
*/
   Partial.Name  = Trim(Lowercase(Selected.Name)) + '%';
   Selected.Description  = '';
/*
**  For registered tags,  they want to select an operator name.  They also
**  want the ability to just type in a name that is not on the list.  When 
**  this frame is called from there, we will let them type in any name.
*/
   IF AnyName = FALSE THEN
      Selected.Object = -1;
   ENDIF;
   ReducedList.Clear();
   i = 1;
   Row = 0;
            
   WHILE i <= OperatorList.LastRow() DO
      IF Lowercase(OperatorList[i].Name) LIKE Partial.name THEN
         Row = Row + 1;
         ReducedList[Row] = OperatorList[i];
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      SelectOperator = ReducedList;
   ENDIF;
/*
**   If there is only one in the list, make it the default
*/
   IF (Row = 1) THEN
      Selected.Object  = SelectOperator[1].Object;
      Selected.Name = SelectOperator[1].Name;
      Selected.Description  = SelectOperator[1].Description;
   ENDIF;
END;
/*
**  Handle operator selection by partial name
*/
ON SetValue Selected.Description,
ON CLICK Find_Btn  =
BEGIN
/*
**   Pick out everyone on the list with a similar name
*/
   Partial.Description  = Trim(Lowercase(Selected.Description)) + '%';
   Selected.Name  = '';
/*
**  For registered tags,  they want to select an operator name.  They also
**  want the ability to just type in a name that is not on the list.  When 
**  this frame is called from there, we will let them type in any name.
*/
   IF AnyName = FALSE THEN
      Selected.Object = -1;
   ENDIF;
   ReducedList.Clear();
   i = 1;
   Row = 0;
            
   WHILE i <= OperatorList.LastRow() DO
      IF Lowercase(OperatorList[i].Description) LIKE Partial.Description THEN
         Row = Row + 1;
         ReducedList[Row] = OperatorList[i];
      ENDIF;

      i = i + 1;
   ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      SelectOperator = ReducedList;
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   IF (Row = 1) THEN
      Selected.Object  = SelectOperator[1].Object;
      Selected.Name = SelectOperator[1].Name;
      Selected.Description  = SelectOperator[1].Description;
   ENDIF;

END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN
   IF Selected.Description = '' OR Selected.Object = -1 THEN
      Message 'You have not selected an Operator.';
      resume;
   ELSE        
      FO.Object  = Selected.Object; 
      FO.Name = Selected.Name;
      FO.Description = Selected.Description;
      RETURN (PU_OK);
   ENDIF;
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =
BEGIN
   RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

/*
**      Another desk wants control of the card.  parse dbevent text, 
**      present message, and file card.
*/
ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'FMS_card_control_taken' =
BEGIN
#  include Card_Control

   RETURN(PU_CANCEL);
END;


Application Component Report
============================

	Name:            SelectOrder

/* 
**      Copyright c 1993 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  Frame:          SelectOrder 
** 
**  Modification log: 
** 
**  Date:  	  Version       Description 
** -------------------------------------------------- 
**  11/09/23  em            Created for ManualOrderToggle
*/
INITIALIZE (
   Card = INTEGER NOT NULL /* Parameter */
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;
   SelectedOrder = INTEGER NOT NULL;
BEGIN
   SelectedOrder = 0;
   i = 1;
   SELECT :OO[i].OrderNumber = OrderNumber,
          :OO[i].IssueTime = IssueTime
   FROM   IR_OperatingOrder
   WHERE  Card = :Card AND
          OrderStatus >= :Order$Opened AND 
          OrderStatus < :Order$Closed AND
          OrderType = 'REGULAR'
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   
   IF OO.LastRow = 0 THEN
      MESSAGE 'ERROR:  Did not find outstanding orders for this card.';
      RETURN 0;
   ELSEIF OO.LastRow = 1 THEN
      RETURN OO[1].OrderNumber;
   ENDIF;
 
END;

ON ChildEntry OO =
BEGIN
    IF (Curframe.ReasonCode != RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
    SelectedOrder = OO[].OrderNumber;
END;

ON Click Ok_Btn =
BEGIN
    IF SelectedOrder = 0 THEN
       MESSAGE 'Please select an order';
    ELSE
       RETURN :SelectedOrder;
    ENDIF;
END;


