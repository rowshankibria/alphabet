METHOD FeederIns (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Feeder name filter */
   COUserName = VARCHAR(40) NOT NULL;
   RetCode    = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(400) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update a status of a matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.fList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No feeder inserts/updates were made.  Please try again.';
      RETURN;
   ENDIF;

/*
**  See if matrix is checked out to this user.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName THEN
/*
**  See if any feeders are already on a matrix.
**  02/25/05 feeders can now be on multiple matrices...
      DynamicWhereClause = 'Grouping <> ' + varchar(:CurObject.Grouping) + 
                           ' AND Feeder IN (';
      FOR i = 1 TO CurObject.fList.LastRow() DO
         IF i = CurObject.fList.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + varchar(CurObject.fList[i].Object) + ')';      
         ELSE
            DynamicWhereClause = DynamicWhereClause + varchar(CurObject.fList[i].Object) + ',';
         ENDIF;
      ENDFOR;
   
      i = 0;
      SELECT :i = COUNT(*) 
      FROM    CAC_Relay_Feeder
      WHERE  :DynamicWhereClause;
      CALLPROC DDB_ROLLBACK;
   
      IF i <> 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Some feeders already exist on a matrix.  Please try again.';
         RETURN;      
      ENDIF;
*/
      FOR i = 1 to CurObject.fList.LastRow() DO
         RetCode = CALLPROC CAC_CO_FeederIns (
                     Grouping = CurObject.Grouping,
                     Feeder = CurObject.fList[i].Object
                     );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Could not insert feeder information.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not insert feeder information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'You are not the user who has this matrix ' +
                'checked out and cannot make updates to it.';
      RETURN;
   ENDIF;
   RETURN;
END;



