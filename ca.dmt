	Name:            SelectNotifiablePerson

/*
**      Copyright c 1997 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          SelectNotifiablePerson
**
**  Modifications:
**  03/07/97 jfl    Created
*/

INITIALIZE
(
    Department = INTEGER NOT NULL;  /* P: passed department */
    Person = VARCHAR(60) NOT NULL;  /* P: selected Person   */
    DepartmentName = VARCHAR(40) NOT NULL;  /* Department name */
    i = INTEGER NOT NULL;           /* Counter              */
    SelectRow = INTEGER NOT NULL;   /* Clicked RowNumber    */
) =
BEGIN
/*
**  Load Persons of the passed department into the SelectPerson list
*/
    SelectPerson.Clear();
    i = 1;
    SELECT
        :SelectPerson[i].Object = O.Object,
        :SelectPerson[i].Name   = O.Name,
        :SelectPerson[i].Description = O.Description,
        :DepartmentName = O2.Name
    FROM Udb_Object O,
         Udb_Object O2,
         Udb_Grouping G
    WHERE O.Object = G.Member 
      AND G.MemberType = :Type$Person
      AND G.Grouping = :Department
      AND G.Grouping = O2.Object
      AND G.GroupingType = :Type$Department
      AND G.Relationship = :Interaction$Memberof
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
/*
** Update displayed title
*/
    FIELD(TheTitle).TextValue = FIELD(TheTitle).TextValue + DepartmentName;

END;

On Childentry SelectPerson =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Deselect eventual selected row
*/
    SelectedPerson = NULL;
/*
**  Update row selected
*/
    SelectRow = FIELD(SelectPerson).CurRow;
    SelectedPerson = SelectPerson[SelectRow].Duplicate();
END;


ON Click Exit_Btn =
BEGIN
    Person = SelectedPerson.Description;
    RETURN;
END;

ON Click Cancel_Btn =
BEGIN
    RETURN;
END;


ON WindowClose =
BEGIN
    RESUME;
END;


