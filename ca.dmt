Application Component Report
============================

	Name:            FMS_PhaseCheckEquip_ASE


���pHx��Component Method Scripts
���pHx��--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          FMS_PhaseCheckEquip_ASE
**
**  Date:       Version Description
** ----------------------------------
**  02/15/02    pkw     Created
**  08/31/10    em      Support 3G multi feeders
**  04/07/11    em      Remove PrintID from order by on archive select;
**                      It is possible on 3G card that archive cto table
**                      won't have rows, so use of CTO is commented out.
**  09/25/13    pkw     Also look at 4kV StepDown cards
**  08/15/16    ysp     Updated to support 33kv cards
*/ 
METHOD LoadPhaseCheckEquip (
)=
DECLARE
   i = INTEGER NOT NULL;
   TempId = INTEGER NOT NULL;
   CardList = VARCHAR(100) NOT NULL WITH DEFAULT;
   FeederList = VARCHAR(100) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all division types.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Build CardList and FeederList variables.  
*/   
   IF CurObject.NetworkFeeder = NetworkFeeder$33KV THEN 
      CardList = varchar(CurObject.Card);
      
      FeederList = '';
      SELECT :TempID = CTO.Object
      FROM    TFMS_CardToObject CTO
      WHERE   CTO.Card = :CurObject.Card
      BEGIN
         IF FeederList = '' THEN
            FeederList = VARCHAR(TempID);
         ELSE
            FeederList = FeederList + ',' + VARCHAR(TempID);
         ENDIF;
      END;
   
   ELSEIF CurObject.TypeOfCard = TypeOfCard$4kV THEN
      CardList = varchar(CurObject.Card);
      SELECT :TempID = L.Card
      FROM    FMS_StepDownLink L
      WHERE   L.StepDownCard = :CurObject.Card
      BEGIN
         CardList = CardList + ',' + VARCHAR(TempID);
      END;
      
      FeederList = varchar(CurObject.Feeder);
      SELECT :TempID = CTO.Object
      FROM    FMS_StepDownLink L,
              TFMS_CardToObject CTO
      WHERE   L.StepDownCard = :CurObject.Card AND
              L.Card = CTO.Card
      BEGIN
         FeederList = FeederList + ',' + VARCHAR(TempID);
      END;
   ELSE
      CardList = varchar(CurObject.Card);
      SELECT :TempID = L.StepDownCard
      FROM    FMS_StepDownLink L
      WHERE   L.Card = :CurObject.Card
      BEGIN
         CardList = CardList + ',' + VARCHAR(TempID);
      END;
      
      FeederList = varchar(CurObject.Feeder);
      SELECT :TempID = CTO.Object
      FROM    FMS_StepDownLink L,
              TFMS_CardToObject CTO
      WHERE   L.Card = :CurObject.Card AND
              L.StepDownCard = CTO.Card
      BEGIN
         FeederList = FeederList + ',' + VARCHAR(TempID);
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   CurObject.PCE.Clear();    /* Clear array */ 

   IF CurObject.NetworkFeeder > 0 THEN    /* 3G or 33KV */

      IF CurObject.ArchiveCard = FALSE THEN
         DynamicWhereClause = 'CTO.Card in (' + CardList + ') AND ' +
                 'CTO.Object = G.Grouping  AND ' +
                 'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
                 'G.Member = O.Object  AND ' +
                 'P.PhaseCheckEquip = O.Object  AND ' + 
                 'CTOB.Card IN (' + CardList + ') AND ' +
                 'CTOB.Object = GB.Grouping AND ' +            
                 'GB.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
                 'GB.Member = OB.Object AND ' + 
                 'P.SatisfyEquip = OB.Object  AND ' +
                 'P.WorkPermit = ' + varchar(:CurObject.Job) + ' AND ' +
                 'P.Card in (' + CardList + ')'; 
         
         i = 1;
         SELECT  DISTINCT
                 :CurObject.PCE[i].Card = CTO.Card,
                 :CurObject.PCE[i].Equip = O.Object,
                 :CurObject.PCE[i].EquipName = O.Name,
                 :CurObject.PCE[i].EquipClass  = O.Type,
                 :CurObject.PCE[i].EquipClassName  = O.TypeName,
                 :CurObject.PCE[i].SPC_Equip = OB.Object,
                 :CurObject.PCE[i].SPC_EquipName = OB.Name,
                 :CurObject.PCE[i].SPC_EquipClass  = OB.Type,
                 :CurObject.PCE[i].SPC_EquipClassName = OB.TypeName,
                 :CurObject.PCE[i].IssueTime = P.IssueTime, 
                 :CurObject.PCE[i].CompletionTime = P.CompletionTime 
         FROM    Udb_Object O, 
                 Udb_Object OB, 
                 Udb_Grouping G, 
                 Udb_Grouping GB, 
                 FMS_PhaseCheck P,
                 TFMS_CardToObject CTO, 
                 TFMS_CardToObject CTOB 
         WHERE  :DynamicWhereClause
         ORDER BY EquipName 
         BEGIN
            SELECT :CurObject.PCE[i].PrintID = IFNULL(MIN(G.Reference),'')
            FROM   Udb_Grouping G,
                   TFMS_CardToObject CTO
            WHERE  G.Member = :CurObject.PCE[i].Equip AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Grouping = CTO.Object AND
                   CTO.Card = :CurObject.PCE[i].Card;
             
            SELECT :CurObject.PCE[i].SPC_PrintID = IFNULL(MIN(GB.Reference),'')
            FROM   Udb_Grouping GB,
                   TFMS_CardToObject CTO
            WHERE  GB.Member = :CurObject.PCE[i].SPC_Equip AND
                   GB.Relationship = :Interaction$MemberOf AND
                   GB.Grouping = CTO.Object AND
                   CTO.Card = :CurObject.PCE[i].Card;

            i = i + 1;
         END;

      ELSE

         i = 1;
         REPEATED
         SELECT  DISTINCT
                 :CurObject.PCE[i].Card = P.Card,
                 :CurObject.PCE[i].Equip = O.Object,
                 :CurObject.PCE[i].EquipName = O.Name,
                 :CurObject.PCE[i].EquipClass  = O.Type,
                 :CurObject.PCE[i].EquipClassName  = O.TypeName,
                 :CurObject.PCE[i].SPC_Equip = OB.Object,
                 :CurObject.PCE[i].SPC_EquipName = OB.Name,
                 :CurObject.PCE[i].SPC_EquipClass  = OB.Type,
                 :CurObject.PCE[i].SPC_EquipClassName = OB.TypeName,
                 :CurObject.PCE[i].IssueTime = P.IssueTime, 
                 :CurObject.PCE[i].CompletionTime = P.CompletionTime 
         FROM    Udb_Object O, 
                 Udb_Object OB, 
                 FMS_ArchivePhaseCheck P
    /*             , 
                 Udb_Grouping G, 
                 Udb_Grouping GB, 
                 TFMS_ArchiveCardToObject CTO, 
                 TFMS_ArchiveCardToObject CTOB 
    */
         WHERE   /*CTO.Card = :CurObject.Card AND
                 CTO.Object = G.Grouping  AND 
                 G.Relationship = :Interaction$MemberOf  AND 
                 G.Member = O.Object  AND */
                 P.PhaseCheckEquip = O.Object  AND 
                 /*CTOB.Card = :CurObject.Card AND
                 CTOB.Object = GB.Grouping AND             
                 GB.Relationship = :Interaction$MemberOf  AND 
                 GB.Member = OB.Object  AND */
                 P.SatisfyEquip = OB.Object  AND 
                 P.WorkPermit = :CurObject.Job  AND 
                 P.Card = :CurObject.Card 
         /* 
         ** do not try to link to 4kv Stepdown because link goes away when 
         ** card is closed.
         */
         ORDER BY EquipName 
         BEGIN
            SELECT :CurObject.PCE[i].PrintID = IFNULL(MIN(G.Reference),'')
            FROM   Udb_Grouping G,
                   TFMS_ArchiveCardToObject CTO
            WHERE  G.Member = :CurObject.PCE[i].Equip AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Grouping = CTO.Object AND
                   CTO.Card = :CurObject.Card;

            SELECT :CurObject.PCE[i].SPC_PrintID = IFNULL(MIN(GB.Reference),'')
            FROM   Udb_Grouping GB,
                   TFMS_ArchiveCardToObject CTO
            WHERE  GB.Member = :CurObject.PCE[i].SPC_Equip AND
                   GB.Relationship = :Interaction$MemberOf AND
                   GB.Grouping = CTO.Object AND
                   CTO.Card = :CurObject.Card;
            i = i + 1;
         END;
      ENDIF;
   ELSE

      IF CurObject.ArchiveCard = FALSE THEN
         DynamicWhereClause = 'G.Grouping IN (' + FeederList + ') AND ' + 
                 'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
                 'G.Member = O.Object AND ' + 
                 'P.PhaseCheckEquip = O.Object AND ' + 
                 'GB.Grouping IN (' + FeederList + ') AND ' + 
                 'GB.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
                 'GB.Member = OB.Object AND ' + 
                 'P.SatisfyEquip = OB.Object AND ' +
                 'P.WorkPermit = ' + varchar(:CurObject.Job) + ' AND ' +
                 'P.Card IN (' + CardList + ')';

         i = 1;
         SELECT  :CurObject.PCE[i].Card = P.Card,
                 :CurObject.PCE[i].Equip = O.Object,
                 :CurObject.PCE[i].EquipName = O.Name,
                 :CurObject.PCE[i].EquipClass  = O.Type,
                 :CurObject.PCE[i].EquipClassName  = O.TypeName,
                 :CurObject.PCE[i].PrintID = G.Reference,
                 :CurObject.PCE[i].SPC_Equip = OB.Object,
                 :CurObject.PCE[i].SPC_EquipName = OB.Name,
                 :CurObject.PCE[i].SPC_EquipClass  = OB.Type,
                 :CurObject.PCE[i].SPC_EquipClassName = OB.TypeName,
                 :CurObject.PCE[i].SPC_PrintID = GB.Reference,
                 :CurObject.PCE[i].IssueTime = P.IssueTime, 
                 :CurObject.PCE[i].CompletionTime = P.CompletionTime 
         FROM    Udb_Object O, 
                 Udb_Object OB, 
                 Udb_Grouping G, 
                 Udb_Grouping GB, 
                 FMS_PhaseCheck P 
         WHERE  :DynamicWhereClause 
         ORDER BY PrintID, EquipName 
         BEGIN
            i = i + 1;
         END;

      ELSE

         i = 1;
         REPEATED
         SELECT  :CurObject.PCE[i].Card = P.Card,
                 :CurObject.PCE[i].Equip = O.Object,
                 :CurObject.PCE[i].EquipName = O.Name,
                 :CurObject.PCE[i].EquipClass  = O.Type,
                 :CurObject.PCE[i].EquipClassName  = O.TypeName,
                 :CurObject.PCE[i].PrintID = G.Reference,
                 :CurObject.PCE[i].SPC_Equip = OB.Object,
                 :CurObject.PCE[i].SPC_EquipName = OB.Name,
                 :CurObject.PCE[i].SPC_EquipClass  = OB.Type,
                 :CurObject.PCE[i].SPC_EquipClassName = OB.TypeName,
                 :CurObject.PCE[i].SPC_PrintID = GB.Reference,
                 :CurObject.PCE[i].IssueTime = P.IssueTime, 
                 :CurObject.PCE[i].CompletionTime = P.CompletionTime 
         FROM    Udb_Object O, 
                 Udb_Object OB, 
                 Udb_Grouping G, 
                 Udb_Grouping GB, 
                 FMS_ArchivePhaseCheck P 
         WHERE   G.Grouping = :CurObject.Feeder  AND 
                 G.Relationship = :Interaction$MemberOf  AND 
                 G.Member = O.Object  AND 
                 P.PhaseCheckEquip = O.Object  AND 
                 GB.Grouping = :CurObject.Feeder  AND 
                 GB.Relationship = :Interaction$MemberOf  AND 
                 GB.Member = OB.Object  AND 
                 P.SatisfyEquip = OB.Object  AND 
                 P.WorkPermit = :CurObject.Job  AND 
                 P.Card = :CurObject.Card 
         /* 
         ** do not try to link to 4kv Stepdown because link goes away when 
         ** card is closed.
         */
         ORDER BY PrintID, EquipName 
         BEGIN
            i = i + 1;
         END;

      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   RETURN;
END;

Application Component Report
============================

	Name:            FMS_RelaySummary

/**
 **
 **  Copyright c 1996 Unified Information, Inc.  All rights reserved.
 **
 **  Unified Information, Inc. proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Unified Information, Inc.
 **
 **
 **  Application:    CAC
 **  Frame:          FMS_RelaySummary
 **
 **  Modification log:
 **
 **  Date:     Version   Description 
 ** --------------------------------------------------        
 **  10/29/96    ysp     Initial Version: modified from SLC          
 **  04/02/97    jfl     itc39: Support for archived item
 **                      Expected Mode for Archived Card is FM_READ
 **  07/25/98    em      Exclude Groupers from Equipment list
 **  05/01/00    em      card control change
 **  09/18/01    em      Minor adjustment to better support returned relays
 **  07/16/02    ysp     Merge: use an include script to handle card control.
 **  12/23/02    ysp     Explicitly call soa_logins to log card relays update.
 **  03/30/09    ysp     Downlad relay to Feederboard
 **  04/03/09    ysp     Moved from the FeederCard app. Prompt DO to select the
 **                      SSO who returns the relay infor and insert log.
 **  08/24/10    em      Updates for 3G Card
 **  12/22/11    pkw     Use Relay classes to load data to be consistent with FMS Online.
 **                      Update class to use update mode and allow PDF report callup.
 **  12/27/16    ysp     query equipment from the archive card to object table for archived cards.
 **  11/15/18    ysp     Add seventh parameter for pdf script
 **  08/08/19    em      Highlight 46T if operated
 **  09/10/19    pkw     Combine three tables into one.
 **  09/09/22    ysp     replace vb script by powershell script that displays reports from FMS_ReportService web site.
**/

INITIALIZE   
(
/* passed in */
    C = FMS_Card;                                 /*P: Passed card */
    ArchiveCard = INTEGER NOT NULL WITH DEFAULT;  /*P: Passed boolean */
 
/* local variables */
#   include StandardDeclarations

    j = integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */
    k = integer NOT NULL WITH DEFAULT;
    x = integer NOT NULL WITH DEFAULT;
    y = integer NOT NULL WITH DEFAULT;
    ChangeMade = integer NOT NULL WITH DEFAULT;
    DataUpd    = INTEGER NOT NULL WITH DEFAULT;   
    TIDistributionRelays = ARRAY OF CAC_Relay;
    OtherDistributionRelays = ARRAY OF CAC_Relay;
    OtherRelays = ARRAY OF CAC_Relay;

    RowNum = INTEGER NOT NULL WITH DEFAULT;    /* Row Number */ 
    Row4kVNum = INTEGER NOT NULL WITH DEFAULT;    /* Row Number */ 
    FoundIt = SMALLINT NOT NULL WITH DEFAULT;
    RelayOpList = ARRAY OF CAC_Relay;          /*Local: Array of existing relay operations */
    RelayTypes = Array of CAC_RelayType;       /*Local: List of RelayTypes */ 
    RelayClasses = ARRAY of CAC_RelayClass;    /*Local: RelayClass Hierarchy */

    ModifyFlag = VARCHAR(10) NOT NULL WITH DEFAULT;
    FeederRelayEquip = ARRAY OF CAC_Relay;  
    CurRelay = CAC_RelayType;
    CurRelayClass = CAC_RelayClass;
    CurRelayEquip = CAC_Relay;  
    TempString = VARCHAR(40);  
    OldRelays = VARCHAR(60);  

    RelayClassChoiceList = ChoiceList  NOT NULL WITH DEFAULT;    /*Local: ChoiceList of RelayClasses */

    OpenAutoEquip = ARRAY OF CAC_Relay;
    AllEquip = ARRAY OF CAC_Relay;

    TIDistBack = ARRAY OF CAC_Relay;
    OtherDistBack = ARRAY OF CAC_Relay;   
    OtherBack = ARRAY OF CAC_Relay;   
    SimpleRelay = Relay_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
/**
 **  Ahem!
 **  Clear your arrays.
 **/
/* clear equip tables which allow users to select for "Other Relays" */
    EquipList.Clear();
    OpenAutoEquip.Clear();
    AllEquip.Clear();


/*  retrieve card relay information. */
    IF ArchiveCard = FALSE THEN
        SELECT Relays = C.Relays
        FROM   FMS_Card C
        WHERE  C.Card = :C.Card;
    ELSE
        SELECT Relays = C.Relays
        FROM   FMS_ArchiveCard C
        WHERE  C.Card = :C.Card;
        Field(Insert_Relay_btn).ParentField.CurBias = FB_DIMMED;
        Field(Relays).CurBias = FB_LANDABLE;
    ENDIF;
    OldRelays = Relays;
    CALLPROC DDB_ROLLBACK;
    /*
    **  Load equipment using Source and Unit-STD equipment
    */
    EquipList.Clear();
    i = 1;
    SELECT  :EquipList[i].Equip = O.Object, 
            :EquipList[i].EquipName = O.Name,
            :EquipList[i].EquipClass  = O.Type,
            :EquipList[i].EquipClassName  = O.TypeName,
            :EquipList[i].Description = O.Description
    FROM     Udb_Object O,
             Udb_Grouping G,
             TFMS_CardToObject CTO,
             Udb_ExtendedType ET
    WHERE    CTO.Card = :C.Card AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOF AND
             G.MemberType = ET.Type AND
             ET.SuperType IN (:Type$Source,:Type$UnitSEquip) AND
             G.Member = O.Object
    BEGIN
       i = i + 1;
    END;
/*
**   Load both equip arrays: openauto and All
* /      
    i = 1;
    IF ArchiveCard = FALSE THEN
        REPEATED
        SELECT DISTINCT
                :OpenAutoEquip[i].Equip = J.Equip,
                :OpenAutoEquip[i].EquipName = J.EquipName,
                :OpenAutoEquip[i].EquipClass = J.EquipClass,
                :OpenAutoEquip[i].EquipClassName = J.EquipClassName,
                :OpenAutoEquip[i].Description = O.Description  
        FROM    SOA_JobControl JC,
                SOA_Job J,
                Udb_Grouping G,
                Udb_Object O,
                TFMS_CardToObject CTO
        WHERE   JC.Card = :C.Card AND
                JC.Job = J.Job AND
                J.Status != 'Pur' AND
                J.Status != 'Del' AND
                J.EquipClass IN (SELECT EquipClass
                                 FROM FMS_OpenAutoEquip)  AND
                J.Equip = G.Member AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                J.Equip = O.Object           
        BEGIN
            i = i + 1; 
        END;
        CALLPROC DDB_ROLLBACK;

        /**
        **  Select all of the equipment that are members of the feeder.
        ** /
        i = 1;                                                       
        REPEATED
        SELECT  :AllEquip[i].Equip = O.Object, 
                :AllEquip[i].EquipName = O.Name,
                :AllEquip[i].EquipClass  = O.Type,
                :AllEquip[i].EquipClassName  = O.TypeName,
                :AllEquip[i].Description = O.Description
        FROM    Udb_Object O,
                Udb_Grouping G,
                Udb_ExtendedType E,
                TFMS_CardToObject CTO
        WHERE   G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = O.Object AND 
                O.Type NOT IN (:Type$AbstractHTV,
                               :Type$ISOGrouper,
                               :Type$Loop) AND 
                G.MemberType = E.Type AND
                E.SuperType = :Type$Switch 
        ORDER BY Description, EquipName 
        BEGIN
                i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;
 
    ELSE
        REPEATED
        SELECT DISTINCT
                :OpenAutoEquip[i].Equip = J.Equip,
                :OpenAutoEquip[i].EquipName = J.EquipName,
                :OpenAutoEquip[i].EquipClass = J.EquipClass,
                :OpenAutoEquip[i].EquipClassName = J.EquipClassName,
                :OpenAutoEquip[i].Description = O.Description  
        FROM    FMS_ArchiveJob J,
                Udb_Grouping G,
                Udb_Object O,
                TFMS_ArchiveCardToObject CTO
        WHERE   J.Card = :C.Card AND
                J.Status != 'Pur' AND
                J.Status != 'Del' AND
                J.EquipClass IN (SELECT EquipClass
                                 FROM FMS_OpenAutoEquip)  AND
                J.Equip = G.Member AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                J.Equip = O.Object           
        BEGIN
            i = i + 1; 
        END;
        CALLPROC DDB_ROLLBACK;

        /**
        **  Select all of the equipment that are members of the feeder.
        ** /
        i = 1;                                                       
        REPEATED
        SELECT  :AllEquip[i].Equip = O.Object, 
                :AllEquip[i].EquipName = O.Name,
                :AllEquip[i].EquipClass  = O.Type,
                :AllEquip[i].EquipClassName  = O.TypeName,
                :AllEquip[i].Description = O.Description
        FROM    Udb_Object O,
                Udb_Grouping G,
                Udb_ExtendedType E,
                TFMS_ArchiveCardToObject CTO
        WHERE   G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = O.Object AND 
                O.Type NOT IN (:Type$AbstractHTV,
                               :Type$ISOGrouper,
                               :Type$Loop) AND 
                G.MemberType = E.Type AND
                E.SuperType = :Type$Switch 
        ORDER BY Description, EquipName 
        BEGIN
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;        
    ENDIF;

/*
**  Default Equip to OpenAuto
* /
    IF OpenAutoEquip.LastRow() > 0 THEN
        EquipList = OpenAutoEquip.Duplicate();
    ELSE 
        IF AllEquip.LastRow() > 0 THEN
            EquipList = AllEquip.Duplicate();
            Equip_choice = 2;
        ELSE
            CurFrame.InfoPopup(MessageText =
                            'No Eligible Equipment Found', 
                            MessageType = MT_WARNING);
            RETURN;
        ENDIF; 
    ENDIF;

    CurFrame.BringToFront();
    CurFrame.Flush();   
*/
    CurFrame.IsAutoSized = TRUE;
    CurFrame.Flush();
    /*
    **  Place popup items in proper place.  Use i to figure out width of border.
    */
    i = (Field(RelayTypeList).OuterWidth -Field(RelayTypeList).Width)/2;
    Field(WA).AbsYBottom = Field(Delete_Relay_Btn).AbsYBottom;
    Field(WA).AbsXLeft = Field(FeederRelays).AbsXLeft - StackField(Field(wa)).ChildLeftMargin - i;

    Field(RelayTypeList).AbsYTop = Field(WA.TF).TableHeader.AbsYBottom;
    Field(RelayTypeList).AbsXLeft = Field(WA.TF).TableHeader.ChildFields[4].AbsXLeft - i;

    Field(EquipList).AbsYTop = Field(WA.TF).TableHeader.AbsYBottom;
    Field(EquipList).AbsXLeft = Field(WA.TF).TableHeader.ChildFields[2].AbsXLeft - i;

    CurFrame.SendUserEvent(EventName = 'LoadRelays');

    DataUpd = FALSE;
    CurFrame.Flush();
END;

ON UserEvent 'LoadRelays' =
BEGIN
/* clear the list of relays which operated. */
    RelayOpList.Clear(); 

/* clear the three user-interface tables: 1) TIME & INST., 2) Other Dist., 
** 3) Other Relay
*/
    TIDistributionRelays.Clear(); 
    OtherDistributionRelays.Clear();
    OtherRelays.Clear();

    TIDistBack.Clear(); 
    OtherDistBack.Clear();
/*
**  Load relay info
*/
    IF SimpleRelay IS NULL THEN
       SimpleRelay = Relay_ASE.Create();
    ENDIF;
     
    SimpleRelay.Card = C.Card;    
    SimpleRelay.ArchiveCard = ArchiveCard;
    SimpleRelay.CardType = Type$FMSApp;
    SimpleRelay.SwitchingItem = 0;
    SimpleRelay.UpdateMode = 1;  /* Always load all data */
    
    SimpleRelay.LoadRelaySummary();
   
    IF SimpleRelay.ReturnCode <> 0 THEN
       Message SimpleRelay.ErrorMessage;
       RETURN;
    ENDIF;
   
    RelayClasses = SimpleRelay.RClasses.Duplicate();
    RelayTypes   = SimpleRelay.RTypes.Duplicate();
    RelayOpList  = SimpleRelay.ROpList.Duplicate();
    
    TIDistributionRelays = SimpleRelay.RSDist.Duplicate();   
    OtherDistributionRelays = SimpleRelay.RSOtherDist.Duplicate();
    OtherRelays = SimpleRelay.RSOther.Duplicate();

    SimpleRelay = NULL;
    /*
    **  Build table for relays that operated
    */
    FeederRelays.Clear();
    Feeder4kVRelays.Clear();
    x = 1;
    y = 1;
    FOR i = 1 TO RelayOpList.LastRow DO
       IF RelayOpList[i].RelayTypeTable = 1 THEN
          /*
          **  Look in Instantaneous array
          */
          RetCode = TIDistributionRelays.Find(AttributeName = 'relayop', 
                                   Value = RelayOpList[i].RelayOp,
                                   RowNumber = ByRef(k));
          IF RetCode = ER_OK THEN
             FeederRelays[x] = TIDistributionRelays[k].Duplicate();
             FeederRelays[x].RelayTypeTable = 1;
             x = x + 1;
             TIDistributionRelays.RemoveRow(RowNumber = k);
          ENDIF;   
          
       ELSEIF RelayOpList[i].RelayTypeTable = 2 THEN
          /*
          **  Look in OtherDistributionRelays array
          */
          RetCode = OtherDistributionRelays.Find(AttributeName = 'relayop', 
                                   Value = RelayOpList[i].RelayOp,
                                   RowNumber = ByRef(k));
          IF RetCode = ER_OK THEN
             FeederRelays[x] = OtherDistributionRelays[k].Duplicate();
             FeederRelays[x].RelayTypeTable = 2;
             x = x + 1;
             OtherDistributionRelays.RemoveRow(RowNumber = k);
          ENDIF;   
       ELSEIF RelayOpList[i].RelayTypeTable = 3 THEN
          /*
          **  Look in OtherRelays array
          */
          RetCode = OtherRelays.Find(AttributeName = 'relayop', 
                                   Value = RelayOpList[i].RelayOp,
                                   RowNumber = ByRef(k));
          IF RetCode = ER_OK THEN
             Feeder4kvRelays[y] = OtherRelays[k].Duplicate();
             Feeder4kvRelays[y].RelayType = Feeder4kvRelays[y].RelayClass;
             Feeder4kvRelays[y].RelayTypeName = Feeder4kvRelays[y].RelayClassName;
             Feeder4kvRelays[y].RelayTypeTable = 3;
             y = y + 1;             
             OtherRelays.RemoveRow(RowNumber = k);
          ENDIF;   
       ENDIF;
    ENDFOR;
    
    FOR i = 1 TO FeederRelays.LastRow DO
       /*
       ** Highlight 46T
       */
       IF FeederRelays[i].RelayTypeName like '46T%' THEN
          FIELD(FeederRelays[i].RelayTypeName).BgColor = CC_YELLOW;
          FIELD(FeederRelays[i].Operated).BgColor = CC_YELLOW;
          FIELD(FeederRelays[i].TimeStamp).BgColor = CC_YELLOW;
       ENDIF;

       IF FeederRelays[i].Operated = 0 THEN
          FIELD(FeederRelays[i].Operated).FGColor = CC_PALE_BLUE;
          FIELD(FeederRelays[i].Operated).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF FeederRelays[i].GenericInt1 = 0 THEN
          FIELD(FeederRelays[i].GenericInt1).FGColor = CC_PALE_BLUE;
          FIELD(FeederRelays[i].GenericInt1).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF FeederRelays[i].GenericInt2 = 0 THEN
          FIELD(FeederRelays[i].GenericInt2).FGColor = CC_PALE_BLUE;
          FIELD(FeederRelays[i].GenericInt2).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF FeederRelays[i].Line = -1 THEN
          FeederRelays[i].LineName = '';
       ELSEIF FeederRelays[i].Line = 0 THEN
          FeederRelays[i].LineName = '1ST';
       ELSEIF FeederRelays[i].Line = 1 THEN
          FeederRelays[i].LineName = '2ND';
       ENDIF;  
    ENDFOR;     
  
    FOR i = 1 TO Feeder4kVRelays.LastRow DO
       /*
       ** Highlight 46T
       */
       IF Feeder4kVRelays[i].RelayTypeName like '46T%' THEN
          FIELD(Feeder4kVRelays[i].RelayTypeName).BgColor = CC_YELLOW;
          FIELD(Feeder4kVRelays[i].Operated).BgColor = CC_YELLOW;
          FIELD(Feeder4kVRelays[i].TimeStamp).BgColor = CC_YELLOW;
       ENDIF;

       IF Feeder4kVRelays[i].Operated = 0 THEN
          FIELD(Feeder4kVRelays[i].Operated).FGColor = CC_PALE_BLUE;
          FIELD(Feeder4kVRelays[i].Operated).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF Feeder4kVRelays[i].GenericInt1 = 0 THEN
          FIELD(Feeder4kVRelays[i].GenericInt1).FGColor = CC_PALE_BLUE;
          FIELD(Feeder4kVRelays[i].GenericInt1).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF Feeder4kVRelays[i].GenericInt2 = 0 THEN
          FIELD(Feeder4kVRelays[i].GenericInt2).FGColor = CC_PALE_BLUE;
          FIELD(Feeder4kVRelays[i].GenericInt2).BGColor = CC_PALE_BLUE;       
       ENDIF;
       IF Feeder4kVRelays[i].Line = -1 THEN
          Feeder4kVRelays[i].LineName = '';
       ELSEIF Feeder4kVRelays[i].Line = 0 THEN
          Feeder4kVRelays[i].LineName = '1ST';
       ELSEIF Feeder4kVRelays[i].Line = 1 THEN
          Feeder4kVRelays[i].LineName = '2ND';
       ENDIF;  
    ENDFOR;       

END;

//ON InsertRow FeederRelays,
//ON UserEvent 'InsertRelay',
ON Click Insert_Relay_Btn =
BEGIN
    IF CurFrame.TriggerField IS NOT NULL THEN
       IF lowercase(Curframe.Triggerfield.Name) <> 'insert_relay_btn' THEN
          FeederRelays.RemoveRow(RowNumber = FeederRelays.LastRow);
       ENDIF;
    ENDIF;
/*
**  Clear table and insert new row
*/
    WA.TF.Clear();
    WA.TF.InsertRow(RowNumber = 1);
    WA.TF[1].TimeStamp = 'now';
    WA.TF[1].FeederName = C.FeederName;
/*
**  Only allow them work in workarea
*/
    Field(Close_btn).ParentField.CurBias = FB_VISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;
    
    CurFrame.SendUserEvent(EventName = 'PickEquipment');

    ModifyFlag = 'Insert';
END;

ON Click Update_Relay_Btn =
BEGIN
/*
**  Find which row we are updating
*/
    RowNum = 0;
    Row4kVNum = 0;
    RowNum = Field(FeederRelays).CurRow;
    IF RowNum = 0 THEN
       Row4kVNum = Field(Feeder4kVRelays).CurRow;
       IF Row4kVNum = 0 THEN
          message 'You must select which relay you want to modify.';
          RESUME;
       ENDIF;
    ENDIF;
/*
**  Clear table and insert new row
*/
    WA.TF.Clear();
    IF RowNum <> 0 THEN
       WA.TF.InsertRow(RowNumber = 1, RowObject = FeederRelays[RowNum].Duplicate());
    ELSE
       WA.TF.InsertRow(RowNumber = 1, RowObject = Feeder4kVRelays[Row4kVNum].Duplicate());
    ENDIF;
    WA.TF[1].TimeStamp = 'now';
    IF WA.TF[1].RelayTypeTable = 1 THEN
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_DIMMED;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_DIMMED;
       FIELD(WA.TF[*].RelayName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_PURPLE;
       FIELD(WA.TF[*].LineName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_PURPLE;
       
    ELSEIF WA.TF[1].RelayTypeTable = 2 THEN
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_DIMMED;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_DIMMED;
       FIELD(WA.TF[*].RelayName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_PURPLE;
       FIELD(WA.TF[*].LineName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_PURPLE;

    ELSEIF WA.TF[1].RelayTypeTable = 3 THEN
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_CHANGEABLE;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[*].RelayName).CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_CYAN;
       FIELD(WA.TF[*].LineName).CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_CYAN;

    ENDIF;
/*
**  Only allow them work in workarea
*/
    Field(Close_btn).ParentField.CurBias = FB_Visible;
    CurFrame.Flush();
    Field(WA).Curbias = FB_CHANGEABLE;

    ModifyFlag = 'Update';
END;



ON Click Delete_Relay_Btn =
DECLARE
   DelRelay = ARRAY OF CAC_Relay;
   TempRelay = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Find which row we are deleting
*/
    RowNum = 0;
    Row4kVNum = 0;
    RowNum = Field(FeederRelays).CurRow;
    IF RowNum = 0 THEN
       Row4kVNum = Field(Feeder4kVRelays).CurRow;
       IF Row4kVNum = 0 THEN
          message 'You must select which relay you want to delete.';
          RESUME;
       ENDIF;
    ENDIF;
/*
**  Clear table and insert new row
*/
    DelRelay.Clear();
    IF RowNum <> 0 THEN
       DelRelay.InsertRow(RowNumber = 1, RowObject = FeederRelays[RowNum].Duplicate());
    ELSE
       DelRelay.InsertRow(RowNumber = 1, RowObject = Feeder4kVRelays[Row4kVNum].Duplicate());
    ENDIF;
/*
**  Delete row from table and database.
*/
    IF DelRelay[1].RelayName = '' THEN
       TempRelay = DelRelay[1].RelayTypeName;
    ELSE
       TempRelay = DelRelay[1].RelayName;
    ENDIF;
    IF CurFrame.ConfirmPopup (MessageText = 'Deleting Relay:  ' +
                TempRelay) = PU_OK THEN

       RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                 CardType = Type$FMSApp,
                                 Card     = C.Card,
                                 RelayOp = DelRelay[1].RelayOp );
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Not able to remove relay.  Please try again.';
          RESUME;
       ENDIF;
       CALLPROC DDB_COMMIT;
       IF RowNum <> 0 THEN
          FeederRelays.RemoveRow(rownumber = RowNum);
       ELSE
          Feeder4kVRelays.RemoveRow(rownumber = Row4kVNum);
       ENDIF;
       DataUpd = TRUE;
       CurFrame.SendUserEvent(EventName = 'LoadRelays');
    ENDIF;
END;


ON UserEvent 'PickRelayType',
ON ChildEntry WA.TF[*].RelayTypeName =
BEGIN
    /*
    **  Populate RelayTypeList Based on equipment selected.
    */
    i = 0;
    SELECT :i = COUNT(*)
    FROM     Udb_ExtendedType ET
    WHERE    ET.Type = :WA.TF[1].EquipClass AND
             ET.SuperType = :Type$Source;
             
    RelayTypeList.Clear();
    IF i <> 0 THEN
       FOR k = 1 TO TIDistributionRelays.LastRow DO
          RelayTypeList[k] = TIDistributionRelays[k].Duplicate();
          RelayTypeList[k].RelayTypeTable = 1;
       ENDFOR;
       k = RelayTypeList.LastRow + 1;
       FOR i = 1 TO OtherDistributionRelays.LastRow DO
          RelayTypeList[k] = OtherDistributionRelays[i].Duplicate();
          RelayTypeList[k].RelayTypeTable = 2;
          /*
          ** Highlight 46T
          */
          IF RelayTypeList[k].RelayTypeName like '46T%' THEN
             FIELD(RelayTypeList[k].RelayTypeName).BGColor = CC_YELLOW;
          ENDIF;
          k = k + 1;
       ENDFOR;
    ELSE
       FOR i = 1 TO RelayClasses.LastRow DO
          RelayTypeList[i].RelayTypeName = RelayClasses[i].RelayClassName;
          RelayTypeList[i].RelayType = RelayClasses[i].RelayClass;
          RelayTypeList[i].RelayTypeTable = 3;
       ENDFOR;
    ENDIF;
    IF RelayTypeList.LastRow = 0 THEN
       message 'Relays are not set up for this feeder.';
       RESUME;
    ENDIF;
    Field(RelayTypeList).CurBias = FB_LANDABLE;
    Field(WA).Curbias = FB_VISIBLE;
END;

ON Click WA.Cancel_Btn =
BEGIN
    Field(Close_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
END;

ON UserEvent 'PickEquipment',
ON ChildEntry WA.TF[*].EquipClassName,
ON ChildEntry WA.TF[*].EquipName = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    IF EquipList.LastRow = 1 THEN
       Field(EquipList).CurBias = FB_INVISIBLE;
       Field(WA).Curbias = FB_CHANGEABLE;

       WA.TF[1].EquipClass = EquipList[1].EquipClass;
       WA.TF[1].EquipClassName = EquipList[1].EquipClassName;
       WA.TF[1].Equip = EquipList[1].Equip;
       WA.TF[1].EquipName = EquipList[1].EquipName;
       WA.TF[1].FeederName = C.FeederName;

       CurFrame.SendUserEvent(EventName = 'PickRelayType');
    ELSEIF EquipList.LastRow > 1 THEN
       Field(EquipList).CurBias = FB_CHANGEABLE;
       Field(WA).Curbias = FB_VISIBLE;
    ENDIF;   
END;

ON ChildEntry RelayTypeList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;
    i = Field(RelayTypeList).CurRow;
   
    Field(RelayTypeList).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;

    IF RelayTypeList[i].RelayTypeTable = 1 THEN
       WA.TF[1] = RelayTypeList[i].Duplicate();
       WA.TF[1].Line = -1;
       WA.TF[1].TimeStamp = date('now');
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_DIMMED;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_DIMMED;
       FIELD(WA.TF[*].RelayName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_PURPLE;
       FIELD(WA.TF[*].LineName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_PURPLE;
       
    ELSEIF RelayTypeList[i].RelayTypeTable = 2 THEN
       WA.TF[1] = RelayTypeList[i].Duplicate();
       WA.TF[1].Line = -1;
       WA.TF[1].TimeStamp = date('now');
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_DIMMED;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_DIMMED;
       FIELD(WA.TF[*].RelayName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_PURPLE;
       FIELD(WA.TF[*].LineName).CurBias = FB_DIMMED;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_PURPLE;
//       WA.TF[1].Operated = TRUE;

    ELSEIF RelayTypeList[i].RelayTypeTable = 3 THEN
       
       WA.TF[1].RelayType = RelayTypeList[i].RelayType;
       WA.TF[1].RelayTypeName = RelayTypeList[i].RelayTypeName;
       WA.TF[1].TimeStamp = date('now');
       WA.TF[1].RelayTypeTable = RelayTypeList[i].RelayTypeTable;
       FIELD(WA.TF).Tableheader.ChildFields[5].CurBias = FB_CHANGEABLE;
       FIELD(WA.TF).Tableheader.ChildFields[6].CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[*].RelayName).CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[1].RelayName).BGColor = CC_PALE_CYAN;
       FIELD(WA.TF[*].LineName).CurBias = FB_CHANGEABLE;
       FIELD(WA.TF[1].LineName).BGColor = CC_PALE_CYAN;
//       WA.TF[1].Operated = TRUE;

    ENDIF;
END;

ON ChildEntry EquipList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;
    i = Field(EquipList).CurRow;
   
    Field(EquipList).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;

    WA.TF[1].EquipClass = EquipList[i].EquipClass;
    WA.TF[1].EquipClassName = EquipList[i].EquipClassName;
    WA.TF[1].Equip = EquipList[i].Equip;
    WA.TF[1].EquipName = EquipList[i].EquipName;


    CurFrame.SendUserEvent(EventName = 'PickRelayType');
END;

ON ChildSetValue WA.TF[*].Operated =
BEGIN
   WA.TF[1].GenericInt1 = FALSE;
   WA.TF[1].GenericInt2 = FALSE;
END;

ON ChildSetValue WA.TF[*].GenericInt1,
ON ChildSetValue WA.TF[*].GenericInt2 =
BEGIN
   WA.TF[1].Operated = FALSE;
END;

ON Click WA.OK_Btn =
BEGIN
    WA.TF[1].Operation = (WA.TF[1].GenericInt1 * RelayOp$Instantaneous) +
                         (WA.TF[1].GenericInt2 * RelayOp$Time);
    IF WA.TF[1].RelayTypeTable = 3 THEN
       IF WA.TF[1].RelayName = '' THEN
          message 'You must enter a Relay Name.';
          RESUME;
       ENDIF;
       /*  Mike doesn't want to pick line.  Lets see what happens.
       IF WA.TF[1].LineName = "" THEN
          message 'You must enter 1ST or 2ND Line.';
          RESUME;
       ENDIF;
       */
       WA.TF[1].RelayClass = WA.TF[1].RelayType;
       WA.TF[1].RelayClassName = WA.TF[1].RelayTypeName;
       WA.TF[1].RelayType = 0;
       WA.TF[1].RelayTypeName = '';
    ENDIF;
    IF WA.TF[1].Operation = 0 THEN
       /* If no selected, default to Operated */
       WA.TF[1].Operation = RelayOp$Normal;
    ENDIF;

    IF lowercase(ModifyFlag) = 'insert' THEN
       /*
       **  Insert/Update row in DB
       */
       RetCode = CALLPROC CAC_InsertRelayOpForAll(
                           CardType = Type$FMSApp, 
                           Card = C.Card,
                           Line = WA.TF[1].Line,
                           FeederName = WA.TF[1].FeederName,
                           Equip = WA.TF[1].Equip,
                           EquipName = WA.TF[1].EquipName,
                           EquipClass = WA.TF[1].EquipClass,
                           EquipClassName = WA.TF[1].EquipClassName,
                           RelayTypeName = WA.TF[1].RelayTypeName,
                           RelayType =  WA.TF[1].RelayType,
                           RelayClass = WA.TF[1].RelayClass,
                           RelayClassName = WA.TF[1].RelayClassName,
                           RelayName = WA.TF[1].RelayName,
                           Operation = WA.TF[1].Operation,
                           TimeStamp = WA.TF[1].TimeStamp
                           );  
    ELSEIF lowercase(ModifyFlag) = 'update' THEN                       
       RetCode = CALLPROC CAC_UpdateRelayOpForAll( 
                           CardType = Type$FMSApp,
                           Card     = C.Card,
                           RelayOp = WA.TF[1].RelayOp,
                           Line = WA.TF[1].Line,
                           FeederName = WA.TF[1].FeederName,
                           Equip = WA.TF[1].Equip,
                           EquipName = WA.TF[1].EquipName,
                           EquipClass = WA.TF[1].EquipClass,
                           EquipClassName = WA.TF[1].EquipClassName,
                           RelayTypeName = WA.TF[1].RelayTypeName,
                           RelayType =  WA.TF[1].RelayType,
                           RelayClass = WA.TF[1].RelayClass,
                           RelayClassName = WA.TF[1].RelayClassName,
                           RelayName = WA.TF[1].RelayName,
                           Operation = WA.TF[1].Operation,
                           TimeStamp = WA.TF[1].TimeStamp
                           );
    ENDIF;
    IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Failed to Insert/Update Relay Target, please try again.';
       RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;
    
    IF WA.TF[1].RelayTypeTable = 3 THEN
       /*
       **  Put fields back so they show up correctly
       */
       WA.TF[1].RelayType = WA.TF[1].RelayClass;
       WA.TF[1].RelayTypeName = WA.TF[1].RelayClassName;
       WA.TF[1].RelayClass = 0;
       WA.TF[1].RelayClassName = '';
    ENDIF;

    CurFrame.SendUserEvent(EventName = 'LoadRelays');
    Field(Close_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
    DataUpd = TRUE;
END;

/*
**  Handle Equipment choice toggle
* /
ON CLICK Equip_Choice =
BEGIN

  EquipList.Clear();
  IF Equip_choice = 1 THEN

    IF OpenAutoEquip.LastRow() > 0 THEN
        EquipList = OpenAutoEquip.Duplicate();
    ELSE 
        Message 'No Open Auto Equip.  Equip List defaults to All Equip.';
        EquipList = AllEquip.Duplicate();
        Equip_choice = 2;
    ENDIF;

  ELSE
    EquipList = AllEquip.Duplicate();
  ENDIF;
END;
*/
ON ChildEntry WA.TF[*].LineName = 
BEGIN
   IF WA.TF[1].LineName = '' THEN
      WA.TF[1].Line = 0;
      WA.TF[1].LineName = '1ST';
   ELSEIF WA.TF[1].LineName = '1ST' THEN
      WA.TF[1].Line = 1;
      WA.TF[1].LineName = '2ND';
   ELSEIF WA.TF[1].LineName = '2ND' THEN
      WA.TF[1].Line = -1;
      WA.TF[1].LineName = '';
   ENDIF;
   CurFrame.InputFocusField = FIELD(WA.Cancel_btn);
END;

/**  Handle an Cancel button click
 **  the user has chosen to postpone action.
 **/
ON Click Close_Btn =
BEGIN
    CurFrame.Flush();
    IF (FIELD(Relays).HasDataChanged = TRUE) THEN
       CALLPROC FMS_CardRelaysUpd (NewRelays = Relays,
                                   Card = C.Card);
       CALLPROC DDB_COMMIT;

       CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = OldRelays,
                 New  = Relays);
       CALLPROC DDB_COMMIT;
    ENDIF;
    /*
    ** download relay to feederboard (FSS)
    */    
    IF DataUpd = TRUE AND
       ArchiveCard = FALSE THEN
      
       CALLPROC DownloadRelayToFSS(Card = C.Card, ArchiveCard = ArchiveCard );
       /*
       ** log the substation operator
       */
       RetCode = CALLFRAME SelectOperator (AnyName = TRUE, 
                                        Title = 'Select SSO that reported the Relay Targets');
       IF RetCode = PU_OK THEN
          CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = '',
                 New  = FO.Description + ' returned relay information');    
       ENDIF;
    ENDIF;

    RETURN;
END;

/**
 **  Another desk has taken control of the card.  Parse dbevent text, 
 **  present message, and file card.
 **/
ON DBEvent 'fms_card_control_taken' =
BEGIN
#  include Card_Control

   RETURN;
END;


ON CLICK PDF_Btn =
DECLARE
    PDFDir = Varchar(100);  
    PDFCommand = Varchar(200);
BEGIN
    PDFDir = CurSession.GetEnv(Name = 'FMS_Misc');
/*
** 09/09/22: replaced by powershell script that displays reports from FMS_ReportService web site.
**      
    PDFCommand = 'wscript ' + PDFDir + '\relay_report.vbs "FMS" ' + 
                                        varchar(ArchiveCard) + ' ' +
                                        varchar(C.Card) + ' ' +
                                        varchar(0) + ' ' +      /* Switching Item *
                                        VARCHAR(2) +            /* review mode *
                                        ' "Relays for ' + C.FeederName + ' in ' + C.SubstationName + '" ' + '""'; 
*/
   PDFCommand = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + 
                                       PDFDir + '\PrintReport.ps1" RELAY FMS ' +
                                       varchar(ArchiveCard) + ' ' +
                                       varchar(C.Card) + ' ' +
                                       varchar(0) + ' ' +      /* Switching Item */
                                       '2 ' +                  /* review mode */
                                       '"Relays for ' + C.FeederName + ' in ' + C.SubstationName + '" ' + '"" '; 
                                        
    CurFrame.Trace (PDFCommand);
    CALL System PDFCommand;   
END;

/**
 **  Handle a closeframe event.
 **/
ON UserEvent 'CloseFrame' =
BEGIN
    RETURN;
END;

