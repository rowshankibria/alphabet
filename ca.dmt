���pxLx��Component Method Scripts
���pxLx��--------------------------
/*
**
**      Copyright c 2003 Pateric Software, LLC.  All rights reserved.
**
**      Pateric Software, LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software, LLC.
**
**  Application:    CAC
**  Class:          OpActivity_ASE
**
**  Date:       Version Description
** ----------------------------------
**  02/26/03    pkw     Created.
**  05/26/05    ysp     Add InitDOSumList and GetSumIndex to support 12 hour shifts
**  12/28/05    ysp     TLS 39: add TLS to the activity report
**  11/13/07    ysp     Fix 12 hour report: check returned index from GetSumIndex. 
**  12/17/09    ysp     fix new database's Group By problem by specifically adding 
**                      Order By clause when loading DO data
**  04/26/18    ysp     Add loading of statistics on Issued, Completed and Work Permits
**  05/15/18    YSP     Add LoadActivityDetail 
*/ 
METHOD LoadActivity (
)=
DECLARE
   AppName = VARCHAR(4) NOT NULL WITH DEFAULT;
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   Idx          = INTEGER NOT NULL;
   DOActList = ARRAY OF OpActivity_RPT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Load Operations
*/
   CurObject.DList.Clear();

   IF CurObject.ShiftType = 0 THEN	/* 8 Hour Shift */
      i = 1;
      IF CurObject.AppType = 0 THEN
         SELECT :CurObject.DList[i].Division = Division,
                :CurObject.DList[i].TypeOfDay = TypeOfDay,
                :CurObject.DList[i].ShiftTime = ShiftTime,
                :CurObject.DList[i].Moves = Count(ShiftTime)
         FROM   SOA_Activity
         WHERE  LogDate <= :CurObject.EndDate AND
                LogDate >= :CurObject.StartDate
         GROUP BY Division,TypeOfDay,ShiftTime
         BEGIN
            i = i + 1;
         END; 
         CALLPROC DDB_ROLLBACK;
      ELSE
         AppName = '';
         IF CurObject.AppType = 1 THEN
            AppName = Application$TFMS;
         ELSEIF CurObject.AppType = 2 THEN
            AppName = Application$FMS;
         ELSEIF CurObject.AppType = 3 THEN
            AppName = Application$SLC;
         ELSEIF CurObject.AppType = 4 THEN
            AppName = Application$TLS;
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                     ': MESSAGE: OpActivity_ASE(LoadActivity): ' +
                     'Invalid AppType passed in (' + 
                     VARCHAR(CurObject.AppType) + ')');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Bad application filter value passed.';
            RETURN;
         ENDIF;

         SELECT :CurObject.DList[i].Division = Division,
                :CurObject.DList[i].TypeOfDay = TypeOfDay,
                :CurObject.DList[i].ShiftTime = ShiftTime,
                :CurObject.DList[i].Moves = Count(ShiftTime)
         FROM   SOA_Activity
         WHERE  LogDate <= :CurObject.EndDate AND
              LogDate >= :CurObject.StartDate AND
              Application = :AppName
         GROUP BY Division,TypeOfDay,ShiftTime
         BEGIN
            i = i + 1;
         END; 
         CALLPROC DDB_ROLLBACK;
      ENDIF;
    
      IF CurObject.DList.LastRow() = 0 THEN
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                     ': MESSAGE: OpActivity_ASE(LoadActivity): ' +
                     'No data found. Values passed in:' + HC_NEWLINE +
                     '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                     '   EndDate   = ' + VARCHAR(CurObject.EndDate) + HC_NEWLINE +
                     '   AppType   = ' + VARCHAR(CurObject.AppType));
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No data found for time period selected.';
         RETURN;
      ENDIF; 
  
   ELSE  /* ============== 12 HOUR SHIFT =============== */
      /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
      ** don't count the first 6 hours of the start day, and need to include the first 6 hours 
      ** of the next day of the end date. For example, if the start date is 12/1 and the end
      ** date is 12/5, the actual time window is 12/1 6:00 and 12/6 6:00. 
      */      
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.EndDate + '6 hours';
   
      i = 1;
      IF CurObject.AppType = 0 THEN
         SELECT :DOActList[i].Division = Division,
                :DOActList[i].LogDate = LogDate,
                :DOActList[i].TypeOfDay = TypeOfDay,
                :DOActList[i].ShiftTime = ShiftTime
         FROM   SOA_Activity
         WHERE  LogDate <= :CurObject.EndDate AND
                LogDate >= :CurObject.StartDate
         ORDER BY LogDate,ShiftTime
         BEGIN
            i = i + 1;
         END; 	   
         CALLPROC DDB_ROLLBACK;
      ELSE
         AppName = '';
         IF CurObject.AppType = 1 THEN
            AppName = Application$TFMS;
         ELSEIF CurObject.AppType = 2 THEN
            AppName = Application$FMS;
         ELSEIF CurObject.AppType = 3 THEN
            AppName = Application$SLC;
         ELSEIF CurObject.AppType = 4 THEN
            AppName = Application$TLS;
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                     ': MESSAGE: OpActivity_ASE(LoadActivity): ' +
                     'Invalid AppType passed in (' + 
                     VARCHAR(CurObject.AppType) + ')');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Bad application filter value passed.';
            RETURN;
         ENDIF;

         SELECT :DOActList[i].Division = Division,
                :DOActList[i].LogDate = LogDate,
                :DOActList[i].TypeOfDay = TypeOfDay,
                :DOActList[i].ShiftTime = ShiftTime
         FROM   SOA_Activity
         WHERE  LogDate <= :CurObject.EndDate AND
                LogDate >= :CurObject.StartDate AND
                Application = :AppName
         ORDER BY LogDate,ShiftTime
         BEGIN
            i = i + 1;
         END; 
         CALLPROC DDB_ROLLBACK;
      ENDIF;
    
      IF DOActList.LastRow() = 0 THEN
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                     ': MESSAGE: OpActivity_ASE(LoadActivity): ' +
                     'No data found. Values passed in:' + HC_NEWLINE +
                     '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                     '   EndDate   = ' + VARCHAR(CurObject.EndDate) + HC_NEWLINE +
                     '   AppType   = ' + VARCHAR(CurObject.AppType));
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No data found for time period selected.';
         RETURN;
      ENDIF; 
      /*
      ** Recalculate the activity counts. The move counts for ShiftTime = 1 
      */ 
      CurObject.InitDOSumList();

      FOR i = 1 TO DOActList.LastRow() DO

         IF DATE_PART('hour', DOActList[i].LogDate) < 6 THEN
	         DOActList[i].ShiftTime = 1;

         ELSEIF DATE_PART('hour', DOActList[i].LogDate) >= 6 AND
            DATE_PART('hour', DOActList[i].LogDate) < 18 THEN
            DOActList[i].ShiftTime = 2;

         ELSE
            DOActList[i].ShiftTime = 3;
         ENDIF;

        IF Uppercase(DOW(DOActList[i].LogDate)) = 'MON' AND
           DOActList[i].ShiftTime = 1 THEN

           DOActList[i].TypeOfDay = 1;
           DOActList[i].ShiftTime = 3;
          
        ELSEIF Uppercase(DOW(DOActList[i].LogDate)) = 'SAT' AND
           DOActList[i].ShiftTime = 1 THEN

           DOActList[i].TypeOfDay = 2;
           DOActList[i].ShiftTime = 3;
        ENDIF; 
 
        Idx = CurObject.GetSumIndex(DOObject = DOActList[i]);
        IF Idx >=1 AND Idx <= CurObject.DList.LastRow THEN
           CurObject.DList[Idx].Moves = CurObject.DList[Idx].Moves + 1;
        ENDIF;
      ENDFOR;
   ENDIF;

   RETURN;
END;

/*
** Initialize the move count array by division, day type and shift.
*/
Method InitDOSumList (
) =
declare
    i = integer not null with default;
    j = integer not null with default;
    k = integer not null with default;
    idx = integer not null with default;
    DivCode = INTEGER not null with default;
enddeclare
BEGIN
    idx = 1;
    FOR i = 0 TO 5 DO
       DivCode = 20002 + i;	// Base division code is 20002
       FOR j = 1 to 2 DO	// 1 - weekend, 2 - weekday
          FOR k = 1 to 2 DO	// 1 - 6 to 18, 2 - 18 to 6. this value has different meaning from shifttime in the db table
              CurObject.DList[idx].Division = DivCode;
              CurObject.DList[idx].TypeOfDay = j;	
              CurObject.DList[idx].ShiftTime = k;	
	      CurObject.DList[idx].Moves = 0; 
              idx = idx + 1;
          ENDFOR;
       ENDFOR;
    ENDFOR;
END;

/*
** return the index of the array element based on its division, day type and shift
*/
Method GetSumIndex (
    DOObject = OpActivity_RPT;
) =
declare
    i	= integer not null with default;
    BaseIdx = integer not null with default;
    Idx = integer not null with default;
enddeclare
BEGIN
    BaseIdx = (DOObject.Division - 20002) * 4;
    if DOObject.TypeOfDay = 1 THEN
       IF DOObject.ShiftTime = 2 THEN
          Idx = BaseIdx + 1;
       ELSE 
          Idx = BaseIdx + 2;
       ENDIF;
    ELSE
       IF DOObject.ShiftTime = 2 THEN
          Idx = BaseIdx + 3;
       ELSE 
          Idx = BaseIdx + 4;
       ENDIF;
    ENDIF;
    RETURN Idx;
END;

METHOD LoadDO (
)=
DECLARE
   OldOperator = INTEGER NOT NULL;
   Activity    = ARRAY OF OpActivity_Rpt;  
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode = INTEGER NOT NULL  WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period and group them by DO.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ShiftType = 1 THEN
      /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
      ** don't count the first 6 hours of the start day and the last 6 hours 
      ** of the end date spill over to the following day. 
      */      
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.EndDate + '6 hours';
   ENDIF;

/*
**  Load Activity by Application
*/
   i = 1;
   Activity.Clear();
   SELECT :Activity[i].Operator = Operator,
          :Activity[i].OperatorName = OperatorName,
          :Activity[i].Application = Application,
          :Activity[i].Moves = Count(Application)
   FROM   SOA_Activity
   WHERE  LogDate <= :CurObject.EndDate AND
          LogDate >= :CurObject.StartDate 
   GROUP BY Operator,OperatorName,Application
   ORDER BY Operator
   BEGIN
      i = i + 1;   
   END; 
   
   IF Activity.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: OpActivity_ASE(LoadDO): ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for time period selected.';
      RETURN;
   ENDIF; 
/*
**  Fill in Details array.
*/ 
   CurObject.DList.Clear();
   OldOperator = -1;        /* in case Operator is not set */
   j = 0;
   FOR i = 1 TO Activity.LastRow() DO
      IF OldOperator <> Activity[i].Operator THEN
         j = j + 1;
         OldOperator = Activity[i].Operator;
         CurObject.DList[j].Operator = Activity[i].Operator;
         CurObject.DList[j].OperatorName = Activity[i].OperatorName;
      ENDIF;
      IF Activity[i].Application = Application$FMS THEN
         CurObject.DList[j].FMSMoves = Activity[i].Moves;

      ELSEIF Activity[i].Application = Application$TFMS THEN
         CurObject.DList[j].TFMSMoves = Activity[i].Moves;

      ELSEIF Activity[i].Application = Application$SLC THEN
         CurObject.DList[j].SLCMoves = Activity[i].Moves;

      ELSEIF Activity[i].Application = Application$TLS THEN
         CurObject.DList[j].TLSMoves = Activity[i].Moves;
      ENDIF;
      CurObject.DList[j].Moves = CurObject.DList[j].Moves + Activity[i].Moves;
   ENDFOR;
   
   /*
   **  Load Activity by IssueComplete
   */
   i = 1;
   Activity.Clear();
   SELECT :Activity[i].Operator = Operator,
          :Activity[i].OperatorName = OperatorName,
          :Activity[i].IssueComplete = IssueComplete,
          :Activity[i].Moves = Count(IssueComplete)
   FROM   SOA_Activity
   WHERE  LogDate <= :CurObject.EndDate AND
          LogDate >= :CurObject.StartDate AND
          IssueComplete <> 0
   GROUP BY Operator,OperatorName, IssueComplete
   ORDER BY Operator
   BEGIN
      i = i + 1;   
   END; 
   
   FOR i = 1 TO Activity.LastRow() DO
      RetCode = CurObject.DList.Find(AttributeName = 'Operator', 
                                     Value = Activity[i].Operator,
                                     RowNumber = ByRef(j));
      IF RetCode = ER_OK THEN
         IF Activity[i].IssueComplete = 1 THEN
            CurObject.DList[j].IssuedMoves = Activity[i].Moves;
         ELSEIF Activity[i].IssueComplete = 2 THEN
            CurObject.DList[j].CompletedMoves = Activity[i].Moves;
         ENDIF;
      ENDIF;
   ENDFOR;
   
   /*
   **  Load WORK PERMIT Activities
   */
   i = 1;
   Activity.Clear();
   SELECT :Activity[i].Operator = Operator,
          :Activity[i].OperatorName = OperatorName,
          :Activity[i].Moves = Count(WorkPermit)
   FROM   SOA_Activity
   WHERE  LogDate <= :CurObject.EndDate AND
          LogDate >= :CurObject.StartDate AND
          WorkPermit = 1
   GROUP BY Operator,OperatorName,WorkPermit
   ORDER BY Operator
   BEGIN
      i = i + 1;   
   END; 
   
   FOR i = 1 TO Activity.LastRow() DO
      RetCode = CurObject.DList.Find(AttributeName = 'Operator', 
                                     Value = Activity[i].Operator,
                                     RowNumber = ByRef(j));
      IF RetCode = ER_OK THEN
         CurObject.DList[j].Permitmoves = Activity[i].Moves;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

METHOD LoadActivityDetail (
) = 
DECLARE
   Activity    = ARRAY OF OpActivity_Rpt;  
   i            = INTEGER NOT NULL;     /*Counter*/
   DynamicWhereClause = VARCHAR(200) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL  WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period and group them by DO.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ShiftType = 1 THEN
      /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
      ** don't count the first 6 hours of the start day and the last 6 hours 
      ** of the end date spill over to the following day. 
      */      
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.EndDate + '6 hours';
   ENDIF;

   DynamicWhereClause = 'LogDate <= DATE(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                        'LogDate >= DATE(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                        'Operator = ' + VARCHAR(CurObject.Operator);
                        
   IF CurObject.DetailType = 'FMS' OR 
      CurObject.DetailType = 'TFMS' OR
      CurObject.DetailType = 'SLC' OR
      CurObject.DetailType = 'TLS' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND Application = ''' + CurObject.DetailType + '''';
   ELSEIF CurObject.DetailType = 'ISSUED' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND IssueComplete = 1';
   ELSEIF CurObject.DetailType = 'COMPLETE' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND IssueComplete = 2';
   ELSEIF CurObject.DetailType = 'PERMIT' THEN
      DynamicWhereClause = DynamicWhereClause + ' AND WorkPermit = 1';
   ENDIF;
  
   //CurMethod.Trace(Text = DynamicWhereClause);
/*
**  Load Activity by Application
*/
   i = 1;
   CurObject.DList.Clear();
   SELECT :CurObject.DList[i].Operator = Operator,
          :CurObject.DList[i].OperatorName = OperatorName,
          :CurObject.DList[i].LogDate = LogDate,
          :CurObject.DList[i].Application = Application,
          :CurObject.DList[i].IssueComplete = IssueComplete,
          :CurObject.DList[i].WorkPermit = WorkPermit
   FROM   SOA_Activity
   WHERE  :DynamicWhereClause
   ORDER BY LogDate
   BEGIN
      i = i + 1;   
   END;    
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

