**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC
**
**  Application:    CAC
**  Class:          CardSOA_ASE
**
**  Date:       Version Description
** ----------------------------------
**  09/10/03    pkw     Created; 
**  03/25/05    em      Steam closed card log stays in active table
*/
METHOD LoadLogStatus (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the log status associated with a card/switchingitem.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   /*
   ** Look for an log entries for the current feedercard:
   ** If the log has an 'INCOMPLETE', it will the MAX, else
   ** 'COMPLETE' will be max. If there are no logs, the
   ** default 'EMPTY' will be used.
   */
   IF CurObject.Status = Card$Closed AND CurrentApplication <> Application$SDS THEN
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(CL.LogStatus), 'EMPTY') 
      FROM    SOA_ArchiveCardLog CL 
      WHERE   CL.Card = :CurObject.Card AND
              CL.SwitchingItem = :CurObject.SwitchingItem;
   ELSE
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(CL.LogStatus), 'EMPTY') 
      FROM   SOA_CardLog CL 
      WHERE  CL.Card = :CurObject.Card AND
             CL.SwitchingItem = :CurObject.SwitchingItem;  
   ENDIF;
      
   RETURN;
END;


