	Name:            SelectFeeder

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          SelectFeeder
**
**  Modifications:
**  07/30/92 em     #19.  Present Feeders for session's effective divisions
**                  Only. Use new division/feeder view rather than feeder
**                  table.
**  08/07/92 em     Modified Select -added order by
**  08/17/92 em     (ON-SITE) To improve performance, feeder list selection
**                  performed once in feeder_card, not every time here.
**	                 removed load_data feeder selection from this code.
**  10/13/92 em     Modified to use Udb Object Table for feeder selection.
**                  Security manipulated so feeder not available to 
**                  desk cannot be chosen. 
**  12/20/92 gjc    added window close logic to fix bug 6.
**  04/21/94 mts    Added a find button to match to particular feeders
**  07/09/94 bgh    Added code to process passed parameter (GetAllFeeders)
**                  to use all feeders in the select list.
**  04/25/16 ysp    Filter out 33kv portion feeders  
**  10/04/18 em     Converted to OpenFrame for Select ISO 
**  10/24/18 ysp    Remove load_data user event so that this frame does not appear 
**                  where there is only one iso feeder to select.
*/

INITIALIZE
(
    ParentFrame = FRAMEEXEC DEFAULT NULL;    /* Used when an OpenFrame call */
    i     = integer;			/* Temporary counter */
    match = varchar(40);        
    GetAllFeeders = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
	IF GetAllFeeders = TRUE THEN
		SelectFeeder.Clear();
		i = 1;
		REPEATED
		SELECT  :SelectFeeder[i].Object = O.Object,
				:SelectFeeder[i].Name = O.Name
		FROM    Udb_Object O
		WHERE   O.Type IN ( SELECT  Type 
							FROM    Udb_ExtendedType
							WHERE   SuperType = :Type$Feeder) AND
				O.Type NOT IN (SELECT  Type 
							FROM    Udb_ExtendedType
							WHERE   SuperType = :Type$33KVPortion) AND
				O.Type != :Type$PortionFeeder AND            
				O.Name != Varchar(O.Object) AND
				O.Name != '' AND
				UPPERCASE(O.Name) NOT LIKE '%OBSOLETE'
		ORDER BY Name
		BEGIN
			i = i + 1;
		END; 
	ENDIF;            
/*
**	CurFrame.SendUserEvent (eventname = 'load_data');
*/
   Selected.Object = 0;
   Selected.Name = '';
   CALLPROC DDB_ROLLBACK;
/*
** If an OpenFrame and only one row exists, just load the row
*/
   IF ParentFrame IS NOT NULL AND SelectFeeder.LastRow = 1 THEN
      ParentFrame.SendUserEvent (EventName = 'Load_ISO_Feeder', MessageInteger = SelectFeeder[1].Object);
      ParentFrame.SendUserEvent (EventName = 'Close_ISO_Frame');
      RETURN;
   ENDIF;   
END;
/*
**	Handle a feeder selection from the list
*/
ON ChildEntry SelectFeeder =

    BEGIN
	    Selected.Object = SelectFeeder[].Object;
	    Selected.Name = SelectFeeder[].Name;
        IF ParentFrame IS NOT NULL THEN
           ParentFrame.SendUserEvent (EventName = 'Load_ISO_Feeder', MessageInteger = SelectFeeder[].Object);
        ENDIF;   
    END;


ON Click OK_Btn =

    BEGIN
        IF Selected.Object = 0 THEN 
            IF Selected.Name <> '' THEN
                i = 1;
                WHILE i <= SelectFeeder.LastRow() Do
                    match = uppercase(Selected.Name);
                    IF Uppercase(SelectFeeder[i].Name) like match THEN
                        Endloop;
                    Endif;

                    i = i + 1;
                ENDWHILE;

                If i <= SelectFeeder.LastRow() Then
                    Field(SelectFeeder).ActiveRow = i;
  	                Selected.Object = SelectFeeder[].Object;
	                Selected.Name = SelectFeeder[].Name;
                    RETURN (Selected.Object);
                Else
     	            Message 'You have not selected a Feeder.';
		            Selected.Name = '';
                    Selected.Object = 0;
		            RESUME;
                ENDIF;
            ELSE
     	        Message 'You have not selected a Feeder.';
		        Selected.Name = '';
                Selected.Object = 0;
		        RESUME;
            ENDIF;
        ELSE 
            IF ParentFrame IS NOT NULL THEN
               ParentFrame.SendUserEvent (EventName = 'Close_ISO_Frame');
               RETURN;
            ELSE
	           RETURN (Selected.Object);
	        ENDIF;
        ENDIF; 
    END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =

    BEGIN
            IF ParentFrame IS NOT NULL THEN
               ParentFrame.SendUserEvent (EventName = 'Close_ISO_Frame');
               RETURN;
            ELSE
	           RETURN (0);
	        ENDIF;
    END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

ON CLICK FindButton =
BEGIN
    i = 1;
    WHILE i <= SelectFeeder.LastRow() Do
        match = uppercase(Selected.Name) + '%';
        IF Uppercase(SelectFeeder[i].Name) like match THEN
            Endloop;
        Endif;

        i = i + 1;

    ENDWHILE;

    If i <= SelectFeeder.LastRow() Then
        Field(SelectFeeder).ActiveRow = i;
    Else
		MESSAGE 'Feeder does not exist or is not available to you.';
		Selected.Name = '';
        Selected.Object = 0;
		RESUME;
    ENDIF;
END;

On Entry Selected.Name =
{
    Selected.Object = 0;
};

