	Name:            CheckPreTurnOnComplete

/*
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckPreShutOffComplete
**
**  Date:     Version  Description
** --------------------------------------------------
**  10/04/16    em     New for Steam, Copied from CheckDeloadComplete
**  11/14/16    em     Include Pressurize step moves in warning.
*/
PROCEDURE CheckPreTurnOnComplete
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL; 
    k = INTEGER NOT NULL; 
    CommonFeederCard = ARRAY OF CardSDS;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
/*
**    Find all cards where this job appears.
**    If no cards then nothing more to do. 
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].MSONumber = C.MSONumber,
           :CommonFeederCard[i].StationName = C.StationName,
           :CommonFeederCard[i].Station = C.Station
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            SDS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
/*
**  For each card, check for PreShutOff moves complete 
*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].PrintId = JC.PrintId,
               :TempJobs[k].EquipName = J.EquipName,
               :TempJobs[k].EquipClassName = J.EquipClassName,
               :TempJobs[k].ToMove = J.ToMove,
               :TempJobs[k].Job = J.Job
        FROM   SOA_Job J, 
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
               JC.StepPair IN (:StepHeading$PreTurnOn,:StepPair$DeEnergize) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               J.RSComplete IS NULL AND
               J.Status = ''
        BEGIN
           k = k + 1;
        END;

      IF TempJobs.LastRow() > 0 THEN
           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      Jobs = TempJobs,
                      SwitchingItem = 0,
                      Text = 'Not all Pre Turn-On and Pressurization moves have been completed for MSO ' + 
                             CommonFeederCard[i].MSONumber + 
                             '. Please confirm each move if you wish to continue.'
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;
      ENDIF;       

    ENDFOR; 

    RETURN (RetCode);    
END; 

