**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ConditionalMoves
**
**  Date:       Author   Description
** ----------------------------------
**  04/06/00	EM       Created by modifying NewMoves
**  12/13/05    ysp      increase variable OtherSWName to varchar(160) 
*/
INITIALIZE 
(
#  include StandardDeclarations
/*
** Passed variables
*/
   Card                	= INTEGER NOT NULL;   /* Card parameter */
   CardSwitchingItem    = INTEGER NOT NULL WITH DEFAULT; /*Passed switch item*/
/*
** Local variables
*/
   CardTypeofCard       = INTEGER NOT NULL WITH DEFAULT; /* TypeofCard*/
   EquipConnected	= INTEGER NOT NULL WITH DEFAULT; /*Connected Flag*/
   EquipStatus		= CHAR(3) NOT NULL WITH DEFAULT; /*Blank or NIS*/
   EventText            = VARCHAR(256) NOT NULL WITH DEFAULT; /*DBEvent Text*/
   FullEquipList        = ARRAY OF Equipment;   /*Storage to avoid reselect*/
   Idx                  = ARRAY OF IntegerObject; /*Track impacted cards*/
   ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
   InsertionList        = ARRAY OF NewMoveCard; /*List of cards to insert move*/
   J                    = ARRAY OF Job;  /*Needed to perform conversion*/
   JIP                  = ARRAY OF JobInProgress;/*Needed to perform conversi*/
   k                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   l                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   LockedMove           = JOB DEFAULT NULL;  /* Selected Move for Insertion*/
   m                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   Match		= VARCHAR(80) NOT NULL WITH DEFAULT; /*MatchingString*/
   MoveSelected         = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   n                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   OtherJobControlCard  = INTEGER NOT NULL WITH DEFAULT; /*Job control elsewhr*/
   OtherSwitchingItem   = INTEGER NOT NULL WITH DEFAULT; /*Switching Item*/
   OtherSWName          = VARCHAR(160) NOT NULL WITH DEFAULT; /*SW TO Move Text*/
   OutofControl         = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   PrefixMoveText       = VARCHAR(40) NOT NULL WITH DEFAULT; /*Text Holder*/
   ProtectionMoveList   = ARRAY OF Generic_Job; /*List of moves inserted*/
   RepeatMove       	= INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   Select_Equip         = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/ 
   Select_Node          = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/
   Select_Term          = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/
   Stepheading          = VARCHAR(60) NOT NULL WITH DEFAULT; /*Step Heading*/
   StepHeadingExist     = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   SubstationExist      = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   SuffixMoveText       = VARCHAR(40) NOT NULL WITH DEFAULT; /*Text Holder*/
   TimeCompleted        = DATE;                         /*Same completion time*/
   TimeIssued           = DATE;                         /*Same issue time*/
) =
BEGIN
   NewMoves.Clear();
   IF Move.Status = Job$Restore THEN
      Move.TOMove = Move.RSMove;
      FO.Object  = Move.RSOperator; 
      TimeIssued = Move.RSIssued;
      TimeCompleted = Move.RSComplete;
      FIELD(Move.RSComplete).BgColor = CC_PALE_PINK;
   ELSE
      FO.Object  = Move.TOOperator; 
      TimeIssued = Move.TOIssued;
      TimeCompleted = Move.TOComplete;
      FIELD(Move.TOComplete).BgColor = CC_PALE_PINK;
   ENDIF;
   SELECT :CardTypeOfCard = TypeOfCard
   FROM   SOA_ActiveCard
   WHERE  Card = :Card;
   CurFrame.SendUserEvent( EventName = 'LoadEquipment' );
END;



ON USEREVENT 'LoadEquipment' =
BEGIN
/*
**  Load equipment based on passed object, or object selected on
**  screen.  Select statements are different depending on application.
*/
    Selected.Equip = 0;
    Selected.SubstationName = '';
    Selected.Substation= 0;
    Selected.PrintId = '';
    Selected.EquipClassName = '';
    Selected.EquipName = '';
    Selected.ObjectDescription = '';
    SelectEquip.Clear();        /* Clear out storage */

    IF Move.Substation = 0 THEN
       MESSAGE 'Conditional Moves cannot be selected since current ' +
               'move is not in a substation.';
       RETURN PU_CANCEL;
    ELSE

       i = 1;
       REPEATED
       SELECT  :SelectEquip[i].Equip = O.Object, 
               :SelectEquip[i].EquipName = O.Name,
               :SelectEquip[i].EquipClass  = O.Type,
               :SelectEquip[i].EquipClassName  = O.TypeName,
               :SelectEquip[i].ObjectDescription = O.Description
       FROM    Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType E
       WHERE   G.Grouping = :Move.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               O.Object = G.Member AND
               E.SuperType = :Type$Conducting AND
               E.Type NOT IN (SELECT Type
                              FROM Udb_ExtendedType
                              WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
               G.MemberType = E.Type
       ORDER BY EquipClassName, EquipName     
       BEGIN
          SelectEquip[i].SubstationName = Move.SubstationName;
          SelectEquip[i].Substation = Move.Substation;
          i = i + 1;
       END;

    ENDIF;

    SelectMove.Clear();
    CurFrame.StatusText = 'Select Equipment for additional moves...';
END;


ON CLICK Find_Btn = 
BEGIN
/*  
** Find specific equipment.
** Refocus on the equipment name field 
*/
    CurFrame.InputFocusField = FIELD(Selected.EquipName);

    IF Selected.EquipName = '' THEN
        Message 'Please enter the equipment name to find';
        RESUME;
    ENDIF;

    i = 1;
    WHILE i <= SelectEquip.LastRow() DO
        Match = UpperCase (Selected.EquipName) + '%';
        IF UpperCase(SelectEquip[i].EquipName) like Match THEN
            Endloop;
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
**  Reset selection fields and 
**  move first found equipment to top of table
*/
    Selected.Equip = 0;
    Selected.SubstationName = '';
    Selected.Substation = 0;
    Selected.PrintId = '';
    Selected.EquipClassName = '';
    Selected.ObjectDescription = '';

    IF i <= SelectEquip.LastRow() THEN
        Field(SelectEquip).ActiveRow = i;
        Selected.EquipName = '';
    ELSE        
        Message 'Equipment not found';
        RESUME;
    ENDIF;
END;


ON ChildEntry SelectEquip =
BEGIN
/*
** Equipment has been selected.  Load moves for that equipment class.  
** If SLC, check to make sure this equipment does not have moves in another 
** switching item.  If it does, allow change control of equipment to this
** switching item (if other item is a shadow).
*/
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;

    EquipStatus = '';
    EquipConnected = 0;
    Selected = SelectEquip[].Duplicate();

       FIELD(Selected.ObjectDescription).Curbias = FB_VISIBLE;
       FIELD(Selected.ObjectDescription).BgColor = CC_PALE_CYAN;
       FIELD(Selected.EquipName).Curbias = FB_VISIBLE;
       FIELD(Selected.EquipName).BgColor = CC_PALE_CYAN;

/*
** Make sure selected equipment does not appear in another switching item.
** If it does not, continue with program.
** If it does, prompt user with automatic transfer query if transfer is 
** allowable.  If transfer is not allowable, do not continue process.
** 
** Allow transfer of the equip and moves to the current sw item if and 
** only if:
**     1) the other switching item is not controlled by someone else 
** AND 2) the equipment (moves) is controlled by the current card. 
*/
       IF CurrentApplication = Application$SLC THEN         

         OtherSwitchingItem = 0;
         OtherSWName = '';
         OtherJobControlCard = 0;

         REPEATED
         SELECT :OtherSwitchingItem = J2.Job,
                :OtherSWName = J2.TOMove,
                :OtherJobControlCard = J1.ControlCard
         FROM   SOA_Job J1,
                SOA_Job J2,
                SOA_JobControl JC
         WHERE  J1.Equip = :Selected.Equip 
         AND    J1.Status IN ('',:JobStatus$NIS) 
         AND    J1.MoveCategory = :MoveCategory$Normal                         
         AND    J1.Job = JC.Job 
         AND    JC.Card = :Card 
         AND    JC.SwitchingItem <> :CardSwitchingItem 
         AND    JC.SwitchingItem = J2.Job
         AND    J2.SWItemStatus = :Card$Active;
    
         IF OtherSwitchingItem <> 0 THEN 

            OutOfControl = 0;
            REPEATED
            SELECT :OutofControl = COUNT(*)
            FROM   SOA_CardControl
            WHERE  Card = :Card AND
                   SwitchingItem = :OtherSwitchingItem AND
                   AccessType = 1;

            IF OutofControl = 0 AND OtherJobControlCard = Card THEN

               IF CurFrame.ConfirmPopUp (messagetext = 'This equipment has ' +
                     'moves in another switching item: ' + OtherSWName +
                     HC_NEWLINE + 'Do you want to transfer the equipment ' +
                     '(and the ' +
                     'equipment moves) to your current switching item?') 
                      = PU_OK THEN

                  RetCode = CALLPROC TransferSWItemEquip (
                          Card = Card,
                          NewSwitchingItem = CardSwitchingItem,
                          OldSwitchingItem = OtherSwitchingItem,
                          Equip = Selected.Equip);
                  
                  IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Frame:ConditionalMoves; ERROR: Unable to transfer ' +
                             'equipment control to the current switching item.';
                     Selected.Equip = 0;
                     Selected.SubstationName = '';
                     Selected.Substation = 0;
                     Selected.PrintId = '';
                     Selected.EquipClassName = '';
                     Selected.EquipName = '';
                     Selected.ObjectDescription = '';
                     RESUME;                                    
                  ENDIF;
                  CALLPROC DDB_COMMIT;

               ELSE
                  Selected.Equip = 0;
                  Selected.SubstationName = '';
                  Selected.Substation = 0;
                  Selected.PrintId = '';
                  Selected.EquipClassName = '';
                  Selected.EquipName = '';
                  Selected.ObjectDescription = '';
                  RESUME;
               ENDIF; 

            ELSE
   
               MESSAGE 'This equipment has moves in another switching item: ' +
                       OtherSWName + HC_NEWLINE + 'The other switching item ' +
                       'is locked by another user, or the equipment is ' +
                       'controlled by another card.  You may not insert ' +
                       'moves for the equipment unless you can gain control ' +
                       'of the equipment and/or the other switching item.';
               Selected.Equip = 0;
               Selected.SubstationName = '';
               Selected.Substation = 0;
               Selected.PrintId = '';
               Selected.EquipClassName = '';
               Selected.EquipName = '';
               Selected.ObjectDescription = '';
               RESUME; 

            ENDIF;

         ENDIF;
       ENDIF;
       CurFrame.SendUserEvent (EventName = 'load_moves');
END;


/**
 **  load moves/jobclasses for selected equipment type
 **  locknumber field in SLC_Job userclass will be used to hold the 
 **  the step heading temporarily on this screen.
 **/
ON UserEvent 'load_moves' =
BEGIN
   
    MoveSelected = FALSE;
    SelectMove.Clear();     /* Clear out storage */
    StepHeading = '';
/**
 **  Select the moveequipclassname for the moveequipclass within
 **  the select begin end to speed things up performance wise.
 **  (This will keep us from having to do a third join in the union.)
 **/
    i = 1;
    REPEATED
    SELECT  :SelectMove[i].JobClass = 0,
            :SelectMove[i].TOMove = SP.Name,
            :SelectMove[i].MoveType = '',
            :SelectMove[i].RSMove = '',
            :SelectMove[i].TOMoveRules = 0,
            :SelectMove[i].RSMoveRules = 0,
            :SelectMove[i].StepPair = SP.StepPair,
            :SelectMove[i].MoveEquipClass = 0,
            :SelectMove[i].Seq = 0
    FROM    FMS_StepPair SP
    WHERE   SP.TypeOfCard = :CardTypeOfCard
    UNION
    SELECT  J.JobClass,
            J.TOMove,
            J.MoveType,
            J.RSMove,
            J.TOMoveRules,
            J.RSMoveRules,
            JCC.StepPair,
            JCC.EquipClass,
            JCC.Seq
    FROM    FMS_JobClass J, 
            FMS_JobClassControl JCC
    WHERE   J.JobClass = JCC.JobClass
    AND     JCC.TypeofCard = :CardTypeOfCard
    AND     JCC.EquipClass IN (
                    SELECT SuperType
                    FROM   Udb_ExtendedType 
                    WHERE  Type =  :Selected.EquipClass) 
    ORDER BY StepPair, Seq
    BEGIN
        IF (SelectMove[i].MoveEquipClass = 0) THEN
            SelectMove[i].MoveEquipClassName = '';
        ELSE
            SELECT  :SelectMove[i].MoveEquipClassName = Name
            FROM    Udb_Type
            WHERE   Type = :SelectMove[i].MoveEquipClass;
        ENDIF;

        IF SelectMove[i].JobClass = 0 THEN
           FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
           StepHeading = SQUEEZE(SelectMove[i].TOMove); 
        ENDIF;
        SelectMove[i].StepPairName = StepHeading;
        i = i + 1;
    END;
    CurFrame.StatusText = 'Select additional move for selected equipment...';
END;

/**
 **  Handle a job class selection from the list
 **/
ON ChildEntry SelectMove =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;

/**
 **  Insert appropriate moves into new move list.
 **/
    IF SelectMove[].JobClass <> 0 THEN

        SelectMove[].TOIssued = NULL;
        SelectMove[].TOOperator = NULL;
        SelectMove[].TOComplete = NULL;
        SelectMove[].RSIssued = NULL;
        SelectMove[].RSOperator = NULL;
        SelectMove[].RSComplete = NULL;
        SelectMove[].GroundOn = NULL;
        SelectMove[].DeskName = '';

        LockedMove = SelectMove[].Duplicate();
        MoveSelected = TRUE;
        CurFrame.SendUserEvent (EventName = 'insertmove');

    ENDIF;
END;



ON UserEvent 'insertmove' =
BEGIN
    IF Selected.EquipClassName = '' THEN
        RESUME;
    ENDIF;

    LockedMove.Equip = Selected.Equip;
    LockedMove.EquipName = Selected.EquipName;
    LockedMove.EquipClass = Selected.EquipClass;
    LockedMove.Substation = Selected.Substation;
    LockedMove.SubstationName = Selected.SubstationName;
    LockedMove.EquipClassName = Selected.EquipClassName;
/*
**  determine the desk from the substation
*/
        REPEATED
        SELECT :LockedMove.DeskName = O.Name
        FROM Udb_Object O,
             Udb_Grouping G,
             Udb_Grouping GG
        WHERE O.Object = G.Grouping AND
              G.GroupingType = :Type$OperatorDesk AND
              G.Member = GG.Grouping AND
              GG.Member = :LockedMove.Substation AND
              GG.Relationship = :Interaction$Memberof;

    IF LockedMove.DeskName <> '' AND UserGroup <> LockedMove.DeskName THEN
       MESSAGE 'Your desk is not authorized to insert moves for this ' +
               'substation/equipment.';
       RESUME;
    ENDIF;

    i = 1;
    WHILE i <= NewMoves.LastRow() DO
         
        IF LockedMove.StepPair = NewMoves[i].StepPair THEN 

            IF LockedMove.JobClass = NewMoves[i].JobClass AND
               LockedMove.MoveEquipClass = NewMoves[i].MoveEquipClass AND
               LockedMove.Substation = NewMoves[i].Substation AND
               LockedMove.Equip = NewMoves[i].Equip AND
               LockedMove.EquipName = NewMoves[i].EquipName THEN
               /*
               **   If they selected repeat button don't check for duplicate move
               */
               IF RepeatMove = FALSE THEN

                  IF CurFrame.ConfirmPopup (messagetext = 'Move appears in List ' +
                    'of New Moves already. Insert it another time?') = PU_CANCEL THEN
                     i = 0;
                     ENDLOOP;
                     RESUME;
                  ENDIF;
                  i = i + 1;
               ENDIF;
               ENDLOOP;
            ENDIF;
        ELSEIF NewMoves[i].StepPair > LockedMove.StepPair THEN
            ENDLOOP;
        ENDIF;

        i = i + 1;
    ENDWHILE;
/*
** Check for duplicates on the card.  THis check was formerly done at a later 
** time.  Done here to simplify subsequent insert processing.
** Only check active cards if move being inserted on an active card.
*/
      l = 0;
      REPEATED 
      SELECT   :l = COUNT(*)
      FROM     SOA_Job J,
               SOA_JobControl JC
      WHERE    JC.Card = :Card AND
               JC.Job = J.Job AND
               J.SwItemStatus IN (:Card$Active,0) AND
               J.Equip = :LockedMove.Equip AND
               J.Substation = :LockedMove.Substation AND
               J.JobClass = :LockedMove.JobClass AND
               J.Status IN ('','NIS') AND
               (J.TOComplete IS NULL OR J.RSComplete IS NULL);
      IF l > 0 THEN
         IF CurFrame.ConfirmPopup (MessageText = 
            'This move already exists for this equipment on this card.  ' +
            'Click OK to insert a duplicate or CANCEL insert.') = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;

    IF i > 0 THEN

        NewMoves.InsertRow (RowNumber = i, RowObject = LockedMove.Duplicate());
        PreFixMoveText = '';
        SuffixMoveText = '';
        IF Selected.ObjectDescription <> '' THEN
            PreFixMoveText = Selected.ObjectDescription + ' ';
        ENDIF;
        IF Selected.EquipName <> '' THEN
            SuffixMoveText = ' - ' + Selected.EquipName;
        ENDIF;
        NewMoves[i].Status = EquipStatus;
        NewMoves[i].TOMove = 
              SQUEEZE (PrefixMoveText + LockedMove.TOMove
                      + SuffixMoveText);
        NewMoves[i].RSMove = 
              SQUEEZE (PrefixMoveText + LockedMove.RsMove
                      + SuffixMoveText);

    ENDIF;

    CurFrame.StatusText = 'Select additional moves, another equipment, or OK...'; 
END;




/**
 **  Remove row from New Move List
 **/
ON CLICK Delete_Btn =
BEGIN
    NewMoves.RemoveRow(rownumber = FIELD(NewMoves).ActiveRow);
    IF NewMoves.LastRow() < 1 THEN
       CurFrame.InputFocusField = NULL;
    ENDIF;
END;

/**
 **  Clear New Move List
 **/
ON CLICK Clear_Btn =
BEGIN
    NewMoves.Clear();
    CurFrame.InputFocusField = NULL;
END;



ON CLICK ok_btn =
BEGIN

    IF NewMoves.LastRow() = 0 THEN
       Message 'There are no new moves to insert.';
       RESUME;
    ENDIF;
/*
** Scroll through moves in insertion list.  For each move, determine where it
** needs to go:
**          Similar process to New Moves,  insert the move, 
**          then issue complete same side (TakeOut or Restore) as original move
**          and preform job actions.
*/
   i = 1;
   m = 1;
   ProtectionMoveList.Clear();
   InsertionList.Clear();
   ImpactedCardList.Clear();
/*
** Need to use J and JIP to use conversion include script to convert Job to
** JobInProgress.
*/
   J.Clear();
   J = NewMoves.Duplicate();

   WHILE i <= J.LastRow() DO
      J[i].ControlCard = 0;
      J[i].Job = J[i].InsertJob (Card = Card);
      IF J[i].Job < 0 THEN      
         MESSAGE 'Frame:ConditionalMoves; Job Insertion failed.';
         ENDLOOP;
         RESUME;
      ENDIF;

      InsertionList[1].Card = Card;
      InsertionList[1].SwitchingItem = CardSwitchingItem;
      InsertionList[1].Application = CurrentApplication;
      InsertionList[1].StepHeading = J[i].StepPair;
      InsertionList[1].TypeOfCard = CardTypeOfCard;
      Insertionlist[1].MoveEquipClass = J[i].MoveEquipClass;
      Insertionlist[1].StepLevel = 0;
      Insertionlist[1].PrintID = J[i].PrintID;

      CurFrame.StatusText = 'Inserting Additional Move...';
      CurFrame.Flush();

      RetCode = J[i].InsertControl (
               ControlEntry = InsertionList[1],
               InitiatingCard = Card);
      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Frame:ConditionalMoves; Error inserting control entries for a ' +
                 'move.';
         ENDLOOP;
         RESUME;
      ENDIF;

      JIP.Clear();
#     include ConvertJobToJobInProgress

      JIP[i].Status = Move.Status;
/*
** Issue the move
*/
      CurFrame.StatusText = 'Issuing Move and doing Job Actions...';
      CurFrame.Flush();

      RetCode = JIP[i].IssueMove(Job = JIP[i],
                                 SetTime = TimeIssued);

      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;

      RetCode = JIP[i].JobActions(IssueCompl = JobClass$Issue);

      IF RetCode = PU_CANCEL THEN

         RetCode = JIP[i].CancelIssueMove(Job = JIP[i]);

         IF RetCode = PU_CANCEL THEN
            Message 'Please update the additional move manually';
         ENDIF;

         RESUME;
      ENDIF;
/*
** Complete the move
*/
      CurFrame.StatusText = 'Completing Move and doing Job Actions...';
      CurFrame.Flush();

      RetCode = JIP[i].CompleteMove(Job = JIP[i],
                                       SetTime = TimeCompleted);
      IF RetCode = PU_CANCEL THEN
         Message 'Please manually complete the additional move.';
      ENDIF;
              
      RetCode = JIP[i].JobActions(IssueCompl = JobClass$Complete);
      IF RetCode = PU_CANCEL THEN
         
         RetCode = JIP[i].InCompleteMove(Job = JIP[i]);
          
         IF RetCode = PU_CANCEL THEN
            Message 'Please update the additional move manually';
         ENDIF;

         RESUME;
      ENDIF;
/*
**  Cascade equipment moves to other possible cards
*/
      IF J[i].Equip <> 0 THEN

         Idx.Clear();
         Idx = CALLPROC CascadeMoves (Move = J[i],
                                      Card = Card
                                     );

#        include ManageImpactedCards

      ENDIF;
/*
** Never increment i counter, just remove first row until no more exist.
*/       
      J.RemoveRow(RowNumber = 1);
   ENDWHILE;

#  include NotifyImpactedCards
 
   RETURN PU_OK;
END;


ON DBEvent 'soa_card_control_taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return PU_CANCEL;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    IF NewMoves.LastRow() <> 0 THEN
       IF CurFrame.ConfirmPopUp (messagetext = 'Are you sure you want to' +
             ' exit without inserting your new moves into the card?  Click' +
             ' OK to exit - or Cancel to stay.') = PU_CANCEL THEN
          RESUME;
       ENDIF;
    ENDIF;
    RETURN PU_CANCEL;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

