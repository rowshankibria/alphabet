	Name:            OSWPRequest_ASE


���p�uA��Component Method Scripts
���p�uA��--------------------------
/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          InServicePermit_ASE
**
**  Date:       Version Description
** ----------------------------------
**  07/10/08 ysp Created; 
**  07/16/09 ysp Add substation filter
**  01/27/10 ysp load email attribute
**  10/24/11 ysp load OutageType attribute
*/ 
METHOD LoadOSWPRequests(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   DynamicWhereClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';

   DynamicWhereClause = '';
   CurObject.PL.Clear();

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;

   IF CurObject.GroupFilter > 0 THEN	
      DynamicWhereClause = ' P.WorkGroup = ' + VARCHAR(CurObject.GroupFilter) + ' AND ';
   ENDIF;

   IF CurObject.StatusFilter = OSPStatus$AllCurrent THEN	// all current
      DynamicWhereClause = DynamicWhereClause + ' P.Status <> ' + VARCHAR(OSPStatus$Archived) + ' AND ';

   ELSEIF CurObject.StatusFilter = OSPStatus$AllArchived THEN	// archived
       DynamicWhereClause = DynamicWhereClause + ' P.Status = ' + VARCHAR(OSPStatus$Archived) + ' AND ';

   ELSEIF CurObject.StatusFilter = OSPStatus$Acknowledged THEN		// accepted by D.O.
       DynamicWhereClause = DynamicWhereClause  + ' P.Status IN ( ' + VARCHAR(OSPStatus$Acknowledged) + ',' +
              VARCHAR(OSPStatus$Permit) + ') AND ';              
   ELSE 
       DynamicWhereClause = DynamicWhereClause  + ' P.Status = ' + VARCHAR(CurObject.StatusFilter ) + ' AND ';
   ENDIF;

   IF CurObject.DivisionFilter <> 0 AND CurObject.SubstationFilter = 0 THEN		
      DynamicWhereClause = DynamicWhereClause  + ' G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.MemberType = ' + VARCHAR(Type$Substation) + ' AND ' + 
             'G.Member = P.Substation AND ' +    
             'P.Substation = O.Object ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND P.EnterTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.EnterTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + ' AND P.ReviewedByDO = O2.Object';

//      CurMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause );  

      i = 1;
      SELECT :CurObject.PL[i].PermitJobID = P.PermitJobID,
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].EnterByName = P.EnterByName,
             :CurObject.PL[i].Email = P.Email,		      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].WorkGroup = P.WorkGroup,
             :CurObject.PL[i].HTOD = O.SpecNumber, 
             :CurObject.PL[i].Equip = P.Equip,
             :CurObject.PL[i].EquipName = P.EquipName,
             :CurObject.PL[i].Title = P.Title,			    
             :CurObject.PL[i].Description = P.Description,
             :CurObject.PL[i].PreIssue = P.PreIssue,
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].WorkTestPermit = P.WorkTestPermit,		    		    
             :CurObject.PL[i].ClearFromEquip = P.ClearFromEquip,
             :CurObject.PL[i].AdditionalWork = P.AdditionalWork,
             :CurObject.PL[i].ReducedPressure = P.ReducedPressure,
             :CurObject.PL[i].EquipStatusChange = P.EquipStatusChange,			      
             :CurObject.PL[i].ExtendReturn = P.ExtendReturn,
             :CurObject.PL[i].ProtectionNote = P.ProtectionNote,
             :CurObject.PL[i].WorkLocation = P.WorkLocation,
             :CurObject.PL[i].RecallTime = P.RecallTime,
             :CurObject.PL[i].RecallTerm = P.RecallTerm ,
             :CurObject.PL[i].ContinuousDaily = P.ContinuousDaily,
             :CurObject.PL[i].HoursPerDay = P.HoursPerDay ,
             :CurObject.PL[i].DaysPerWeek = P.DaysPerWeek ,
             :CurObject.PL[i].OutageType = P.OutageType,
             :CurObject.PL[i].SWP = P.SWP,
             :CurObject.PL[i].WorkOrder = P.WorkOrder ,
             :CurObject.PL[i].OutageRequest = P.OutageRequest ,
             :CurObject.PL[i].BARequired = P.BARequired,
             :CurObject.PL[i].ReviewedByDO = P.ReviewedByDO,
             :CurObject.PL[i].ReviewTime = P.ReviewTime,
             :CurObject.PL[i].ReviewedByName = O2.Description,
             :CurObject.PL[i].ReviewRemarks = P.ReviewRemarks
      FROM   SOA_OSWPRequest P,
             UDB_Grouping G,
             UDB_Object O,
             UDB_Object O2 
      WHERE  :DynamicWhereClause 
      ORDER BY 4 					// P.EnterTime 
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF CurObject.SubstationFilter <> 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + ' P.Substation = O.Object ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND P.EnterTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.EnterTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + ' AND P.ReviewedByDO = O2.Object';

//      CurMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause ); 

      i = 1;
      SELECT :CurObject.PL[i].PermitJobID = P.PermitJobID,
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].EnterByName = P.EnterByName,		      
             :CurObject.PL[i].Email = P.Email,		      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].HTOD = O.SpecNumber, 
             :CurObject.PL[i].Equip = P.Equip,
             :CurObject.PL[i].EquipName = P.EquipName,
             :CurObject.PL[i].Title = P.Title,			    
             :CurObject.PL[i].Description = P.Description,
             :CurObject.PL[i].PreIssue = P.PreIssue,
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].WorkTestPermit = P.WorkTestPermit,		    		    
             :CurObject.PL[i].ClearFromEquip = P.ClearFromEquip,
             :CurObject.PL[i].AdditionalWork = P.AdditionalWork,
             :CurObject.PL[i].ReducedPressure = P.ReducedPressure,
             :CurObject.PL[i].EquipStatusChange = P.EquipStatusChange,			      
             :CurObject.PL[i].ExtendReturn = P.ExtendReturn,
             :CurObject.PL[i].ProtectionNote = P.ProtectionNote,
             :CurObject.PL[i].WorkLocation = P.WorkLocation,
             :CurObject.PL[i].RecallTime = P.RecallTime,
             :CurObject.PL[i].RecallTerm = P.RecallTerm ,
             :CurObject.PL[i].ContinuousDaily = P.ContinuousDaily,
             :CurObject.PL[i].HoursPerDay = P.HoursPerDay ,
             :CurObject.PL[i].DaysPerWeek = P.DaysPerWeek ,
             :CurObject.PL[i].OutageType = P.OutageType,
             :CurObject.PL[i].SWP = P.SWP,
             :CurObject.PL[i].WorkOrder = P.WorkOrder ,
             :CurObject.PL[i].OutageRequest = P.OutageRequest ,
             :CurObject.PL[i].BARequired = P.BARequired,
             :CurObject.PL[i].ReviewedByDO = P.ReviewedByDO,
             :CurObject.PL[i].ReviewTime = P.ReviewTime,
             :CurObject.PL[i].ReviewedByName = O2.Description,
             :CurObject.PL[i].ReviewRemarks = P.ReviewRemarks
      FROM   SOA_OSWPRequest P,
             UDB_Object O,
             UDB_Object O2 
      WHERE  :DynamicWhereClause 
      ORDER BY 4 				// P.EnterTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;    
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Out-Of-Service Work Permit Requests match the filter criteria.';
      RETURN;
   ENDIF;

   FOR i = 1 TO CurObject.PL.LastRow DO
      IF CurObject.PL[i].Status > OSPStatus$Permit THEN
         CurObject.PL[i].GetOrderStatus();
      ENDIF;
   ENDFOR;

   RETURN; 
END;

METHOD DeleteOSWPRequests (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].DeleteOSWPRequest();
   ENDFOR;

   RETURN;
END;


Application Component Report
============================

	Name:            OSWPRequest_vm

/* 
**      Copyright c 2008 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          OSWPRequest
**
**  Date:       Author   Description
** ----------------------------------
**  07/11/08	em       created for proof-of-concept
**  01/13/09    em       Second prototype add attachment access
**  08/04/09    em       Moving to CAC for further development
**  09/01/09    em       Changing logic for card selection options
**  09/02/09    em       Add DISTINCT to equipment selects
**  09/03/09    em       manually highlight selected card. Don't use activeobject
**                       table to load equipment for Open cards 
**  09/23/09    em       Selected Equip must be non-zero to search for it on another item
**  09/25/09    ysp      Use script to display attachments.
**  10/07/09    em       Confirm Security before enabling buttons.
**  07/08/10    ysp      Restore attachments directly from database 
**  02/10/11    ysp      When inserting the new permit, set the control of job the same as
**                       the current contorl of the equipment.
**  03/24/11    em       Convert card feeder access for 3G
**  10/24/11    ysp      Increase the size of the EquipName field to varchar(160)
**  11/01/11    ysp      When inserting a scheduled SWP permit, trigger soo monitor to
**                       create SWP Outage Report record.
**  11/20/11    pkw      Modify for VM environment.  Use Session.Cur.
**                       
*/
INITIALIZE (
   OSWPRequest  	= INTEGER NOT NULL;      /* Passed Request ID */
   FromIncoming		= INTEGER NOT NULL WITH DEFAULT; /*Optional Parm*/
   OSWPR                = OSWPRequestClass;

   i  			= INTEGER NOT NULL;
   j  			= INTEGER NOT NULL;
   ControlCard          = INTEGER NOT NULL WITH DEFAULT; 
   NewMove 		= Job;
   Permit           	= WorkPermit;
   RequestDiv           = INTEGER NOT NULL WITH DEFAULT;
   RequestSecure        = INTEGER NOT NULL WITH DEFAULT; 
   RetCode              = INTEGER NOT NULL WITH DEFAULT;
   SelectedApplication  = CHAR(4) NOT NULL;
   SelectedCard   	= INTEGER NOT NULL;
   SelectedCardStatus 	= INTEGER NOT NULL;
   SelectedEquip   	= INTEGER NOT NULL;
   SelectedEquipClass  	= INTEGER NOT NULL;
   SelectedJobClass   	= INTEGER NOT NULL;
   SelectedStepPair   	= INTEGER NOT NULL;
   SelectedSwitchingItem   = INTEGER NOT NULL;
   SelectedTypeofCard   = INTEGER NOT NULL;
   TempChar             = VARCHAR(5) NOT NULL WITH DEFAULT;
   ControlText 		= VARCHAR(256) NOT NULL WITH DEFAULT;

) =
DECLARE
   LoadAnotherCard     = PROCEDURE;
ENDDECLARE
BEGIN
   OSWPR.PermitJobID = OSWPRequest;
   OSWPR.GetOSWPRequest();
   IF OSWPR.ReturnCode <> 0 THEN
      MESSAGE 'Unable to retrieve OFS Permit Request for ID ' + VARCHAR(OSWPRequest);
      RETURN PU_CANCEL;
   ENDIF;
   OSWPReq = OSWPR.Duplicate();
/*
** Get Division and confirm against Effective Divisions
*/
   RequestDiv = 0;
   SELECT :RequestDiv = Grouping
   FROM   Udb_Grouping 
   WHERE  Member = :OSWPR.Substation AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$Division;

   RequestSecure = FALSE;
   FOR i = 1 TO EffectiveDivisions.LastRow() DO
      IF RequestDiv = EffectiveDivisions[i].Object THEN
         RequestSecure = TRUE;
      ENDIF;
   ENDFOR;

   IF RequestSecure = FALSE THEN     
      FIELD(ok_btn).CurBias = FB_INVISIBLE;
      FIELD(reject_btn).CurBias = FB_INVISIBLE;
   ELSEIF OSWPR.Status = OSPStatus$Acknowledged THEN
      FIELD(ok_btn).TextLabel = 'Create Work Permit';
      FIELD(reject_btn).CurBias = FB_INVISIBLE;
   ELSEIF OSWPR.Status = OSPStatus$Permit THEN 
      FIELD(ok_btn).TextLabel = 'Unlink Work Permit';
      FIELD(reject_btn).CurBias = FB_INVISIBLE;
   ELSEIF OSWPR.Status > OSPStatus$Permit THEN 
      FIELD(ok_btn).CurBias = FB_INVISIBLE;
      FIELD(reject_btn).CurBias = FB_INVISIBLE;
   ENDIF;
END;


ON CLICK Reject_btn = 
BEGIN
   Reject_Box.DOName = DOp.Description;
   Reject_Box.ReviewRemarks = '';
   FIELD(Reject_Box).AbsXLeft = FIELD(OK_btn).AbsXLeft - 150;
   FIELD(Reject_Box).AbsYBottom = FIELD(OK_btn).AbsYBottom + 25;
   FIELD(Reject_Box).CurBias = FB_CHANGEABLE;
END;


ON CLICK Reject_Box.Cancel_btn =
BEGIN
   FIELD(Reject_Box).CurBias = FB_INVISIBLE;
END;


ON CLICK Reject_Box.Confirm_btn =
BEGIN
   FIELD(Reject_Box).CurBias = FB_INVISIBLE;
   OSWPReq.Status = ISPStatus$RequestDenied;
   OSWPReq.ReviewedByDO = DOp.Object;
   OSWPReq.ReviewTime = 'now';
   OSWPReq.ReviewRemarks = Reject_box.ReviewRemarks;
   OSWPReq.UpdateOSWPRequestStatus();
   IF OSWPReq.ReturnCode = 0 THEN
      RETURN PU_OK;
   ENDIF;
END;


ON CHILDENTRY OSWPReq.Attachments =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   SelectSql  = VARCHAR(200) NOT NULL WITH DEFAULT;
   WorkDir = Varchar(100);
 
   FileName = VARCHAR(255) DEFAULT 'c:\install\coned\data\';
ENDDECLARE
BEGIN
   IF CurSession.OperatingSystem = SY_UNIX THEN
      Message 'Sorry, must use PC environment to access to this file.';

   ELSEIF CurSession.OperatingSystem = SY_NT THEN
      /*
      WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
      Command = 'wscript ' + WorkDir + '\oswpviewer.js "' + OSWPReq.Attachments[].FileName + '"';
      */
      SelectSql = 'SELECT DataStream FROM SOA_OSWPBinaryFile WHERE ' + 
                'PermitJobID = ' + VARCHAR(OSWPReq.Attachments[].PermitJobID) + ' AND ' +
                'FileID = ' + VARCHAR(OSWPReq.Attachments[].FileID);

      IF OSWPReq.Attachments[].DBServer = 0 THEN
          CurFrame.DBSession = DDB_Global.Session.Cur;

      ELSE
         MESSAGE 'Not able to display attachment due to database connection'; 
         RESUME;
      ENDIF;

      If OSWPReq.Attachments[].BinaryStream.FetchFromDB(Query = SelectSql) <> ER_OK THEN
         ROLLBACK;
         CurFrame.Trace(Text= varchar(date('now')) + ': failed to read binary from db for OSWP file ' + OSWPReq.Attachments[].FileName);
         RESUME;
       ELSE
         ROLLBACK;
      ENDIF;

      WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
      WorkDir  = WorkDir + '\report';
/*
**  See if \install\coned\or41\misc\release directory exists.  If is doesn't create it.
*/
      i = CurSession.DirectoryExists(Directory = WorkDir);
      IF i <> TRUE THEN
         CurSession.CreateDirectory(Directory = WorkDir);
      ENDIF;

      FileName = WorkDir + '\' + OSWPReq.Attachments[].FileName;
      IF OSWPReq.Attachments[].BinaryStream.WriteToFile(Filename = FileName ) <> ER_OK Then
         CurFrame.Trace(Text= varchar(date('now')) + ': failed to restore OSWP file ' + OSWPReq.Attachments[].FileName);
         RESUME;
      ENDIF;

      CALL SYSTEM 'start /b ' + FileName;
   ENDIF;
END;

ON CLICK OK_btn = 
BEGIN
/*
** Possible three activities on this button click.
** 1) Ack with Permit insertion option
** 2) Permit Insertion option
** 3) Unlink permit
*/
   IF OSWPReq.Status < OSPStatus$Acknowledged THEN
      OSWPReq.Status = OSPStatus$Acknowledged;
      OSWPReq.ReviewedByDO = DOp.Object;
      OSWPReq.ReviewTime = 'now';
      OSWPReq.ReviewRemarks = '';
      OSWPReq.UpdateOSWPRequestStatus();
      IF OSWPReq.ReturnCode <> 0 THEN
         RESUME;
      ENDIF;
   ENDIF;

 IF OSWPReq.Status < OSPStatus$Permit THEN 
/*
** Load card list...
** 1) Where equipment is associated to distribution feeder card
** 2) Where "equipment" is a feeder with a card
** 3) Where equipment is associated to a transmission line card
** 4) Where "equipment" is a line with a card
** 5) All switching items associated to the SLC card 
*/
   Ack.Card.Clear();
   i = 1;
   SELECT Ack.Card[i].Application = :Application$FMS,
          Ack.Card[i].CardClassName = C.CardClassName,
          Ack.Card[i].CardName = C.FeederName,
          Ack.Card[i].Card = C.Card,
          Ack.Card[i].CardStatus = C.Status,
          Ack.Card[i].TypeOfCard = C.TypeOfCard,
          Ack.Card[i].FeederStatusName = '',   
          Ack.Card[i].SwitchingItem = 0       
   FROM   Udb_Grouping G,
          TFMS_CardToObject CTO,
          FMS_Card C
   WHERE  G.Member = :OSWPReq.Equip AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = CTO.Object AND
          CTO.Card = C.Card AND
          C.Status < :Card$Closed
   UNION
   SELECT :Application$FMS,
          C.CardClassName,
          C.FeederName,
          C.Card,
          C.Status,
          C.TypeOfCard,
          '',   
          0       
   FROM   FMS_Card C,
          SOA_ActiveObject AO
   WHERE  AO.Object = :OSWPReq.Equip AND
          AO.Card = C.Card AND
          C.Status < :Card$Closed
    UNION
   SELECT SC.Application,
          SC.CardClassName,
          C.FeederNames,
          C.Card,
          SC.Status,
          SC.TypeOfCard,
          '',   
          0       
   FROM   Udb_Grouping G,
          SOA_Card SC,
          TFMS_CardToObject CTO,
          TFMS_Card C
   WHERE  G.Member = :OSWPReq.Equip AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = CTO.Object AND
          CTO.Type = :Type$Line AND
          CTO.Card = C.Card AND
          C.Card = SC.Card AND
          SC.Status < :Card$Closed 
   UNION
   SELECT SC.Application,
          SC.CardClassName,
          C.FeederNames,
          C.Card,
          SC.Status,
          SC.TypeOfCard,
          '',   
          0       
   FROM   SOA_Card SC,
          TFMS_CardToObject CTO,
          TFMS_Card C
   WHERE  CTO.Object = :OSWPReq.Equip AND
          CTO.Type = :Type$Line AND
          CTO.Card = C.Card AND
          C.Card = SC.Card AND
          SC.Status < :Card$Closed 
   UNION
   SELECT AC.Application,
          AC.CardClassName,
          AC.CardName,
          AC.Card,
          J.SwItemStatus,
          AC.TypeOfCard,
          J.TOMove,
	  JC.SwitchingItem          
   FROM   SOA_ActiveCard AC,
          SOA_ActiveObject AO,
          SOA_JobControl JC,
          SOA_Job J
   WHERE  AC.Card = AO.Card AND
          AO.Object = :OSWPReq.Substation AND
          AO.ObjectToCardLink = 1 AND
          AO.Card = JC.Card AND 
          JC.Job = J.Job AND
          JC.Job = JC.SwitchingItem AND
          J.SwItemStatus IN (:Card$Active, :Card$Open) AND
          J.ShadowLink = 0 AND
          J.MoveCategory = :MoveCategory$SwitchingItem
   BEGIN
      IF Ack.Card[i].CardStatus = Card$Open THEN
         Ack.Card[i].CardStatusChar = 'Open';
      ELSE
         Ack.Card[i].CardStatusChar = 'Active';
      ENDIF;
      i = i + 1;
   END;
   FIELD(Ack).AbsXLeft = 50; /*FIELD(OK_btn).AbsXLeft - 550;*/
   FIELD(Ack).AbsYTop = 50; /*FIELD(OK_btn).AbsYBottom + 25;*/
   FIELD(Ack).CurBias = FB_CHANGEABLE;

 ELSEIF OSWPReq.Status = OSPStatus$Permit THEN
/* Now Unlink */ 
    OSWPReq.UpdatePermitJobID();
    IF OSWPReq.ReturnCode = 0 THEN
       /*
       ** unlink from SWP
       */
       IF OSWPReq.SWP <> '' THEN
          RetCode = CALLPROC SOA_SWPPermitDel(PermitJobID = OSWPReq.PermitJobID);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             CurFrame.Trace(Text = VARCHAR(DATE('NOW')) + 'OSWPRequest;' + 
               ' ERROR: Failed to unlink PermitJobID ' + VARCHAR(OSWPReq.PermitJobID) + ' from SWP/WP reference table');
          ELSE
             CALLPROC DDB_COMMIT;
          ENDIF;
       ENDIF;           

       RETURN(PU_OK);
    ENDIF;
 ENDIF;
END;


ON CHILDENTRY Ack.Card = 
BEGIN
   Ack.Job_tf.Clear();
   Ack.TOMove = '';
   Ack.RSMove = '';

   Ack.SelectEquip.Clear();        /* Clear out storage */
   Ack.Selected.Equip = 0;
   Ack.Selected.SubstationName = '';
   Ack.Selected.Substation = 0;
   Ack.Selected.PrintId = '';
   Ack.Selected.EquipClassName = '';
   Ack.Selected.EquipName = '';
   Ack.Selected.Description = '';

   j = 0;
   j = FIELD(Ack.Card).CurRow;

   IF j = 0 THEN
      RESUME;
   ENDIF;

   FOR i = 1 TO Ack.Card.LastRow() DO
      IF i = j THEN
         FIELD(Ack.Card[i].Application).IsReverse = TRUE;
         FIELD(Ack.Card[i].CardClassName).IsReverse = TRUE;
         FIELD(Ack.Card[i].CardName).IsReverse = TRUE;
         FIELD(Ack.Card[i].FeederStatusName).IsReverse = TRUE;
      ELSE
         FIELD(Ack.Card[i].Application).IsReverse = FALSE;
         FIELD(Ack.Card[i].CardClassName).IsReverse = FALSE;
         FIELD(Ack.Card[i].CardName).IsReverse = FALSE;
         FIELD(Ack.Card[i].FeederStatusName).IsReverse = FALSE;
      ENDIF;
   ENDFOR;

   SelectedTypeofCard = Ack.Card[j].TypeOfCard;
   SelectedCard = Ack.Card[j].Card;
   SelectedCardStatus = Ack.Card[j].CardStatus;
   SelectedSwitchingItem = Ack.Card[j].SwitchingItem;
   SelectedApplication = Ack.Card[j].Application;
   SelectedEquip = 0;
   SelectedJobClass = 0;
   SelectedEquipClass = 0;
   SelectedStepPair = 0;
/*
**  Load equipment based on passed object, or object selected on
**  screen.  Select statements are different depending on application.
*/
    Ack.Selected.Equip = 0;
    Ack.Selected.SubstationName = '';
    Ack.Selected.Substation= 0;
    Ack.Selected.PrintId = '';
    Ack.Selected.EquipClassName = '';
    Ack.Selected.EquipName = '';
    Ack.Selected.Description = '';

    Ack.SelectEquip.Clear();        /* Clear out storage */
/*
** DEFAULT Equipment NONE
*/
    Ack.SelectEquip[1].Equip = 0;   
    Ack.SelectEquip[1].SubstationName = '';
    Ack.SelectEquip[1].Substation = 0;
    Ack.SelectEquip[1].PrintId = '';
    Ack.SelectEquip[1].EquipName = '';
    Ack.SelectEquip[1].EquipClass = 0;
    Ack.SelectEquip[1].EquipClassName = 'NONE';
    Ack.SelectEquip[1].Description = '';       
    i = 2;

    IF SelectedApplication = Application$SLC THEN

       Ack.SelectEquip[1].Substation = OSWPReq.Substation;
       Ack.SelectEquip[1].SubstationName = OSWPReq.SubstationName;

       REPEATED
       SELECT DISTINCT  
                  :Ack.SelectEquip[i].Equip = O.Object, 
                  :Ack.SelectEquip[i].EquipName = O.Name,
                  :Ack.SelectEquip[i].EquipClass  = O.Type,
                  :Ack.SelectEquip[i].EquipClassName  = O.TypeName,
                  :Ack.SelectEquip[i].Description = O.Description,
                  :Ack.SelectEquip[i].PrintID = ''
       FROM    Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType E
       WHERE   G.Grouping = :OSWPReq.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               O.Object = G.Member AND
               (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
               E.SuperType = :Type$Conducting AND
               E.Type NOT IN (SELECT Type
                                 FROM Udb_ExtendedType
                                 WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
               G.MemberType = E.Type 
       ORDER BY EquipClassName, EquipName     
       BEGIN
             Ack.SelectEquip[i].SubstationName = OSWPReq.SubstationName;
             Ack.SelectEquip[i].Substation = OSWPReq.Substation;
             i = i + 1;
       END;

    ELSEIF SelectedApplication = Application$TFMS THEN

       Ack.SelectEquip[2].Equip = 0;   
       Ack.SelectEquip[2].SubstationName = OSWPReq.SubstationName;
       Ack.SelectEquip[2].Substation = OSWPReq.Substation;
       Ack.SelectEquip[2].PrintId = '';
       Ack.SelectEquip[2].EquipName = '';
       Ack.SelectEquip[2].EquipClass = 0;
       Ack.SelectEquip[2].EquipClassName = 'NONE';
       Ack.SelectEquip[2].Description = '';       
       i = 3;

             REPEATED
             SELECT
             DISTINCT    :Ack.SelectEquip[i].Equip = O.Object, 
                     :Ack.SelectEquip[i].EquipName = O.Name,
                     :Ack.SelectEquip[i].EquipClass  = O.Type,
                     :Ack.SelectEquip[i].EquipClassName  = O.TypeName,
                     :Ack.SelectEquip[i].Description = O.Description,
                     :Ack.SelectEquip[i].PrintID = ''
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E,
                     TFMS_CardToObject CTO,
                     Udb_Grouping G2
             WHERE   G.Grouping = :OSWPReq.Substation AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Member = O.Object AND
                     CTO.Card = :Ack.Card[j].Card AND
                     CTO.Type = :Type$Line AND    /* Line */
                     CTO.Object = G2.Grouping AND
                     G2.Relationship = :Interaction$MemberOf AND
                     G2.Member = O.Object AND
                     (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                     O.Type = E.Type AND
                     E.SuperType = :Type$Conducting 
             ORDER BY EquipClassName, EquipName     
             BEGIN
                Ack.SelectEquip[i].SubstationName = OSWPReq.SubstationName;
                Ack.SelectEquip[i].Substation = OSWPReq.Substation;
                i = i + 1;
             END;

    ELSEIF SelectedApplication = Application$FMS THEN

             REPEATED
             SELECT
             DISTINCT  :Ack.SelectEquip[i].Equip = O.Object, 
                     :Ack.SelectEquip[i].EquipName = O.Name,
                     :Ack.SelectEquip[i].EquipClass  = O.Type,
                     :Ack.SelectEquip[i].EquipClassName  = O.TypeName,
                     :Ack.SelectEquip[i].Description = O.Description,
                     :Ack.SelectEquip[i].PrintID = G2.Reference
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E,
                     FMS_Card C,
                     Udb_Grouping G2
             WHERE   G.Grouping = :OSWPReq.Substation AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Member = O.Object AND
                     C.Card = :Ack.Card[j].Card AND
                     C.Feeder = G2.Grouping AND
                     G2.Relationship = :Interaction$MemberOf AND
                     G2.Member = O.Object AND
                     (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                     O.Type = E.Type AND
                     E.SuperType = :Type$Conducting 
             ORDER BY EquipClassName, EquipName     
             BEGIN
                Ack.SelectEquip[i].SubstationName = OSWPReq.SubstationName;
                Ack.SelectEquip[i].Substation = OSWPReq.Substation;
                i = i + 1;
             END;
    ENDIF;  
/* 
** Scroll to Equipment included on Request
*/
    FOR i = 1 TO Ack.SelectEquip.LastRow() DO
       IF Ack.SelectEquip[i].Equip = OSWPReq.Equip THEN
          FIELD(Ack.SelectEquip).CurRow = i;
          ENDLOOP;
       ENDIF;   
    ENDFOR; 

END;

ON CHILDENTRY Ack.SelectEquip = 
BEGIN
   Ack.Job_tf.Clear();
   Ack.TOMove = '';
   Ack.RSMove = '';

   i = 0;
   i = FIELD(Ack.SelectEquip).CurRow;

   IF i = 0 THEN
      RESUME;
   ENDIF;
/* 
** For SLC, validate that the equip is not part of another switching
** item on the card.
*/
   IF SelectedApplication = Application$SLC AND 
         SelectedCardStatus = Card$Active AND
         Ack.SelectEquip[i].Equip > 0 THEN
      j = 0;
      REPEATED
      SELECT :j = JC.SwitchingItem
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :SelectedCard AND
             JC.SwitchingItem <> :SelectedSwitchingItem AND
             JC.Job = J.Job AND
             J.Equip = :Ack.SelectEquip[i].Equip AND
            (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Status = '' AND
             J.SwItemStatus = :Card$Active AND
             J.MoveCategory = :MoveCategory$Normal;

      IF j <> 0 THEN
         MESSAGE 'This Equipment is part of another active switching item.';
         RESUME;
      ENDIF;
   ENDIF;

   Ack.Selected = Ack.SelectEquip[i].Duplicate();
   SelectedEquip = Ack.Selected.Equip;

   j = 1;
   SELECT DISTINCT
          :Ack.Job_tf[j].StepPairName = SQUEEZE(SP.Name),
          :Ack.Job_tf[j].StepPair = JCC.StepPair,
          :Ack.Job_tf[j].EquipClass = JCC.EquipClass,
          :Ack.Job_tf[j].TOMove = JC.TOMove,
          :Ack.Job_tf[j].RSMove = JC.RSMove,
          :Ack.Job_tf[j].JobClass = JC.JobClass
   FROM   FMS_JobClass JC,
          FMS_JobClassControl JCC,
          FMS_StepPair SP
   WHERE  JCC.TypeOfCard = :SelectedTypeOfCard AND
          JCC.StepPair IN (:StepHeading$WorkPermit, :StepHeading$TestPermit) AND
          :Ack.Selected.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                       WHERE  SuperType = JCC.EquipClass) AND
          JCC.JobClass = JC.JobClass AND
          JCC.StepPair = SP.StepPair AND
          JCC.TypeOfCard = SP.TypeOFCard 
   BEGIN
      j = j + 1;
   END;

END; 


ON CHILDENTRY Ack.Job_tf =
BEGIN
   Ack.TOMove = '';
   Ack.RSMove = '';
   j = 0;
   j = FIELD(Ack.Job_tf).CurRow;

   IF j = 0 THEN
      RESUME;
   ENDIF;

   Ack.TOMove = Ack.Job_tf[j].TOMove + ' ' + OSWPReq.Title;
   Ack.RSMove = Ack.Job_tf[j].RSMove + ' ' + OSWPReq.Title;

   SelectedJobClass = Ack.Job_tf[j].JobClass;
   SelectedEquipClass = Ack.Job_tf[j].EquipClass;
   SelectedStepPair = Ack.Job_tf[j].StepPair;
END;



ON CLICK Ack.Cancel_btn =
BEGIN
   FIELD(Ack).CurBias = FB_INVISIBLE;
   FIELD(ok_btn).TextLabel = 'Create Work Permit';
   FIELD(reject_btn).CurBias = FB_INVISIBLE;
   FIELD(cancel_btn).TextLabel = 'Exit';
END;


ON Click Ack.View_Btn =
BEGIN
   IF SelectedCard = 0 THEN
      Message 'You have not selected a card.';
      RESUME;
   ENDIF;

   IF CurrentApplication = SelectedApplication THEN
      MESSAGE 'You cannot view ' + SelectedApplication + 
              ' since you are using ' + SelectedApplication + '.';
      RESUME
   ELSEIF (CurrentApplication = Application$TFMS OR 
           CurrentApplication = Application$SLC) AND
          (SelectedApplication = Application$TFMS OR 
           SelectedApplication = Application$SLC) THEN
      MESSAGE 'You cannot views another TOMS card since you are ' +
              'using TOMS.';
      RESUME;
   ENDIF; 
   CALLPROC LoadAnotherCard();
END;


ON CLICK Ack.Load_Card,
ON USEREVENT 'LoadCard' =
BEGIN
   FIELD(Ack).CurBias = FB_INVISIBLE;
   CALLPROC LoadAnotherCard();
   RETURN PU_OK;
END;


ON CLICK Ack.Confirm_btn =
DECLARE
   ActualReturnDate = DATE DEFAULT NULL;
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   SWPNumber = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF SelectedJobClass = 0 THEN
      MESSAGE 'Please Select Card, Equipment, and Permit Move.';
      RESUME;
   ENDIF;

   FIELD(Ack).CurBias = FB_INVISIBLE;
/* 
** Now insert the permit move into the selected card and
** raise event to load that card to the permit protection screen.
** Step Headings should be taken care of by the methods.
** The EquipClass is not important for Job Checks/Actions, but we need a valid one for the 
** step heading. 
*/
   // determine which card has the control of the equipment.
   ControlCard = 0;
   SELECT :ControlCard = J.ControlCard
   FROM   SOA_Job J,
          SOA_ActiveCard AC
   WHERE  J.Equip = :SelectedEquip AND
          J.MoveCategory = :MoveCategory$Normal AND
          (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
          J.Status IN ('', :JobStatus$NIS, :JobStatus$Table) AND
          J.ControlCard = AC.Card AND
          AC.Card <> :NIS$Card;  
   CALLPROC DDB_ROLLBACK;

   IF ControlCard = 0 THEN
      ControlCard = SelectedCard;
   ENDIF;

   NewMove = NULL;
   NewMove = Job.Create();

   NewMove.Job = OSWPReq.PermitJobID;

   NewMove.EquipClass = SelectedEquipClass;
   NewMove.Card = SelectedCard;
   NewMove.JobClass = Ack.Job_tf[j].JobClass;
   NewMove.Equip = SelectedEquip;
   NewMove.EquipName = Ack.Selected.EquipName;
   NewMove.EquipClassName = Ack.Selected.EquipClassName;
   NewMove.Grounds = NULL;
   NewMove.GroundOn = NULL;
   NewMove.StepPair = SelectedStepPair;
   NewMove.Substation = OSWPReq.Substation;
   NewMove.DeskName = '';
   NewMove.ControlCard = ControlCard;
   NewMove.TOMove = Ack.TOMove;
   NewMove.RSMove = Ack.RSMove;
   NewMove.SwitchingItem = SelectedSwitchingItem;
   NewMove.PrintId = Ack.Selected.PrintID;
/*
** Get DeskName based on Substation
*/
   REPEATED
   SELECT :NewMove.DeskName = O.Name
   FROM Udb_Object O,
        Udb_Grouping G,
        Udb_Grouping GG
   WHERE O.Object = G.Grouping AND
         G.GroupingType = :Type$OperatorDesk AND
         G.Member = GG.Grouping AND   /* Divisions for the Desk */
         GG.Member = :OSWPReq.Substation AND
         GG.Relationship = :Interaction$Memberof;  /* Station in Division */
         
   RetCode = NewMove.InsertMove (CardTypeOfCard = SelectedTypeofCard, 
                                 KeepMoveText = TRUE,
                                 KeepJobID = TRUE);

   IF RetCode > 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'ERROR. Not able to insert new Out-of-Service Work Permit move.';
      RESUME;
   ENDIF;
/*
** Now insert work permit details
*/
   IF SelectedApplication = Application$FMS THEN
      RetCode = CALLPROC FMS_WorkPermitUpdate (
       Description = OSWPReq.Description,
       RSMove      = NewMove.RSMove,
       TOMove      = NewMove.TOMove,
       Job         = OSWPReq.PermitJobID,
       EstTimeComplete = '',
       Warning     = 0,
       ProtectionRequired = TRUE);

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'ERROR. Not able to insert FMS Work Permit Details.';
      ENDIF;
   ENDIF; 

   IF Permit IS NULL THEN
      Permit = WorkPermit.Create();
   ENDIF;
   Permit.PermitJobID = OSWPReq.PermitJobID;
   Permit.PreIssued = OSWPReq.PreIssue;
   Permit.ShiftStartTime = OSWPReq.ShiftStartTime;
   Permit.Description = OSWPReq.Description;
   Permit.ProtectionRequired = TRUE;

   RetCode = Permit.UpdateWorkPermit (PermitJobId = OSWPReq.PermitJobID);

   IF RetCode = PU_CANCEL THEN
      MESSAGE 'Error. Not able to insert SOA Work Permit Details.';
   ENDIF;

   OSWPReq.Status = OSPStatus$Permit;
   OSWPReq.ReviewedByDO = DOp.Object;
   OSWPReq.ReviewTime = 'now';
   OSWPReq.ReviewRemarks = '';
   OSWPReq.UpdateOSWPRequestStatus();

   IF OSWPReq.ReturnCode <> 0 THEN
   ENDIF;
/*
** If this request is for a Scheduled outage work with an SWP number,
** create an SWP Outage Report to keep track of progress
*/
   SWPNumber = '';
   SELECT :SWPNumber = SQUEEZE(SWP)
   FROM   SOA_OSWPRequest R
   WHERE  R.PermitJobID = :OSWPReq.PermitJobID AND
          R.OutageType = 1;
          
   IF IsNumber(Value = SWPNumber) = TRUE THEN
      i = 0;
      SELECT :i = 1,
             :ActualReturnDate = ActualReturnDate 
      FROM   SOA_SWPOutageReport
      WHERE  SWPNumber = :SWPNumber;
      CALLPROC DDB_ROLLBACK;

      IF i = 0 THEN
         RetCode = CALLPROC SOA_SWPOutageReportIns (
                      Division = RequestDiv,
                      SWPNumber = SWPNumber,
                      SWPDescription = '',
                      SkedOutageDate = NULL,
                      SkedStartDate = NULL,
                      SkedReturnDate = NULL);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;      
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + ': OSWPRequest; Error - failed to create ' + 
                      'a SWP record for SWP ' + SWPNumber);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;

         /* trigger SOO monitor to get SWP details 
         */
         EventText = VARCHAR(SWPNumber);
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'SOA_GetSWPData',
                     EventText = EventText);   

      ELSEIF ActualReturnDate IS NOT NULL THEN
      /*
      ** Once an SWP's last permit is returned and if a new work permit is 
      ** created from an OSWP Request for the same SWP number, the application 
      ** will re-open the actual outage end time and link the new work 
      ** permit to the existing outage.
      */
         RetCode = CALLPROC SOA_SWPOutageReopened (
                      SWPNumber = SWPNumber);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;      
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + ': OSWPRequest; Error - failed to reopen ' + 
                      'a SWP ' + SWPNumber);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;          
      ENDIF;
      /*
      ** save the permit job id into the SWP/WP reference table
      */
      RetCode = CALLPROC SOA_SWPPermitIns (
                         SWPNumber = SWPNumber,
                         PermitJobID = OSWPReq.PermitJobID);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace(Text = VARCHAR(DATE('NOW')) + ': OSWPRequest; ERROR: Failed to save SWP ' + SWPNumber + 
                  ' and PermitJobID ' + VARCHAR(OSWPReq.PermitJobID) + ' in SWP/WP reference table');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   CurFrame.SendUserEvent (EventName = 'LoadCard');
END;


ON CLICK Cancel_btn =
BEGIN
   IF FIELD(cancel_btn).TextLabel = 'Exit' THEN  /*Have acknowledged*/
      RETURN PU_OK;
   ELSE
      RETURN PU_CANCEL; 
   ENDIF;  
END;


ON WindowClose =
BEGIN
   RESUME;
END;

PROCEDURE LoadAnotherCard (
)=
BEGIN
   IF SelectedApplication = Application$FMS THEN
      TempChar = Left(UserName, 2) + VARCHAR(Application$FMSInt) + Right(UserName, 2);
      ControlText = TempChar + ';' + VARCHAR(SelectedCard) + '; ;';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'LoadFMSCard', 
                               DBEventText = ControlText); 
      CALLPROC DDB_COMMIT;
   ELSE
           TempChar = Left(UserName, 2) + VARCHAR(Application$TFMSInt) + Right(UserName, 2);
           ControlText = TempChar + ';';
           ControlText = ControlText + varchar(SelectedCard) + ';';
           ControlText = ControlText + SelectedApplication + ';'; 
           ControlText = ControlText + UserName + ';';
           CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_LoadCommonCard', 
                                           DBEventText = ControlText);      
           CALLPROC DDB_COMMIT;           
   ENDIF;
END;
