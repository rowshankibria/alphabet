/*
**  Application:    CAC
**  Frame:          CCPDGroundEnergization
**
**  Date:       Author   Description
** ----------------------------------
**  03/07/03    em       Created to be called from CheckNotEnergizingGround.
*/
INITIALIZE (
   GroundEquip    = ConnectedEquipClass;            /*Parameter*/
   Card           = INTEGER NOT NULL;               /*Parameter*/
   Job            = INTEGER NOT NULL;               /*Parameter*/
   SwitchingItem  = INTEGER NOT NULL WITH DEFAULT;  /*Parameter*/

   IfBPDorCCPD    = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   RetCode        = INTEGER NOT NULL;               /*Return Code*/
) =
BEGIN
   IfBPDorCCPD = FALSE;
   SELECT  :IfBPDorCCPD = :TRUE
   FROM    Udb_ExtendedType 
   WHERE   SuperType IN (:Type$BPD, :Type$CCPD) AND
           Type = :GroundEquip.Type;

   IF IfBPDorCCPD = FALSE THEN
      RETURN (PU_CANCEL);
   ENDIF;

   DeviceName = SQUEEZE(GroundEquip.PrimaryGroupingName +
                        GroundEquip.TypeName + 
                        GroundEquip.Name);
END;

ON CLICK OK_btn =
BEGIN
/*
** Set Visible Break status for this Object and repeat trace.
*/
   RetCode = CALLPROC FMS_ObjStatIns(	
                               Object = GroundEquip.Object,
                               Status = Status$VisibleBreak,
                               Terminal = 0, 
                               StatusCount = 1,
                               TimeSet = date('now'));
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to set Visible Break Status for Grounded CCPD/BPD. ' +
              'Potential Timeout or Deadlock when setting status.'; 
      RETURN (PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Job,
                            Time = DATE('now'),
                            UserName = UserName,
			    Item = 'CCPD/BPD',
			    Old = 'CCPD/BPD Ground Found',
			    New = 'Marked as Out of Service and continued');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to Log CCPD/BPD Ground OFS.';
   ENDIF;
   RETURN (PU_OK);   
END;


ON CLICK Cancel_btn =
BEGIN
/*
** DO will leave things as they are and proceed to warning.
*/
   RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Job,
                            Time = DATE('now'),
                            UserName = UserName,
			    Item = 'CCPD/BPD',
			    Old = 'CCPD/BPD Ground Found',
			    New = 'Ground marked In Service to be followed ' +
                                  'by Yellow Warning');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to Log CCPD/BPD Ground as In Service.';
   ENDIF;

   RETURN (PU_CANCEL);
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

