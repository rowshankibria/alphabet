	Name:            SendRapportInstruction

/* 
**	Copyright c 1993 ESCA Corporation.  All rights reserved. 
** 
**	ESCA Corporation proprietary and trade secret information. 
**	Do not copy or disclose to third parties without written 
**	permission from an officer of ESCA Corporation. 
**
**  PURPOSE:	This 4GL procedure is called by the FMS 4GL code 
**		a message to HABITAT that positions to a one-line 
**		display of the same name as the provided Substation
**		name, then positions to the specified device name. 
** 
**  OVERVIEW:	Constructs the RAPPORT messages, then inserts them, 
**		tagged with a timestamp (to make them unique), into 
**		the FMS_RAPPORT table. 
**
**  Modifications:
**    AUGUST 93  ADL   Created. 
**    11/21/02   em    Insert both rows in single transaction.       
**    02/16/04   em    Converted Message to TraceError Call  
**    01/16/08   ysp   Connected to send db event to XA monitor.         
**    12/13/12   em    Convert UserName to FMSOperatorName for XA21 Display Reference
*/ 
procedure SendRapportInstruction  
(
	Substation  = varchar(8)  NOT NULL; /* PARAMETER - substation id */ 
	Device      = varchar(14) NOT NULL; /* PARAMETER - device id */ 

	Instruction = varchar(80) NOT NULL; /* rapport instruction */ 
        FMSOperatorName = VARCHAR(5) NOT NULL WITH DEFAULT;
) = 
BEGIN 
/* Construct message for XA Monitor: 
** Don't send time in the event text. The time difference between the database
** and the PC may cause the request to look old.
*/ 
   FMSOperatorName = Left(UserName, 2) + '2' + Right(UserName,2);
   Instruction = Substation + ';' + Device + ';' + FMSOperatorName + ';'; 

   CALLPROC DDB_RaiseDBEvent(
             DBEventName = 'XA_DisplayRequest',
             DBEventText = Instruction);
   
   CALLPROC DDB_COMMIT; 
   RETURN (0); 
END; 


Application Component Report
============================

	Name:            SendRapportInstruction_SOCCSX

/* 
**	Copyright c 1993 ESCA Corporation.  All rights reserved. 
** 
**	ESCA Corporation proprietary and trade secret information. 
**	Do not copy or disclose to third parties without written 
**	permission from an officer of ESCA Corporation. 
**
**  PURPOSE:	This 4GL procedure is called by the FMS 4GL code 
**		a message to HABITAT that positions to a one-line 
**		display of the same name as the provided Substation
**		name, then positions to the specified device name. 
** 
**  OVERVIEW:	Constructs the RAPPORT messages, then inserts them, 
**		tagged with a timestamp (to make them unique), into 
**		the FMS_RAPPORT table. 
**
**  Modifications:
**    AUGUST 93  ADL   Created. 
**    11/21/02   em    Insert both rows in single transaction.       
**    02/16/04   em    Converted Message to TraceError Call           
**
*/ 
procedure SendRapportInstruction_SOCCSX
(
	Substation  = varchar(8)  NOT NULL; /* PARAMETER - substation id */ 
	Device      = varchar(14) NOT NULL; /* PARAMETER - device id */ 
	Instruction = varchar(80) NOT NULL; /* rapport instruction */ 
	Timestamp   = date        NOT NULL; 
	status      = integer     NOT NULL; 
) = 
BEGIN 
	/* Construct message to call up substation display: */ 
	Instruction = 'DISPLAY ' + Substation + '\'; 
	/* Insert RAPPORT message into FMS_RAPPORT table: */ 
	Timestamp = Date('now'); /* current time */ 
	status = CALLPROC FMS_RapportIns  
		(Instruction = Instruction, 
		 Timestamp   = Timestamp   ); 
	IF (status <> 0) THEN 
	    CALLPROC DDB_ROLLBACK; 
            CALLPROC TraceError (UserMessage=
                    'ERROR: Unable to save <DISPLAY> RAPPORT message for ' +
                    'SoccsX Interface.',
                                 TraceMessage =
                    'SendRapportInstruction Unable to save <DISPLAY> RAPPORT ' +
                    'message for ' +
                    'SoccsX Interface.'
                    ); 
	    RETURN (status); 
	ENDIF; 

	/* Construct message to position to breaker: */ 
/*  ***  assumes that all POINT id's are 'TC'  ***    */ 
	Instruction = 'FIND DEVICE=' + Device + ',POINT=TC\'; 
	/* Insert RAPPORT message into FMS_RAPPORT table: */ 
	Timestamp = Date('now') + date('1 second'); /* current time */ 
	status = CALLPROC FMS_RapportIns  
		(Instruction = Instruction, 
		 Timestamp   = Timestamp   ); 
	IF (status <> 0) THEN 
	    CALLPROC DDB_ROLLBACK; 
            CALLPROC TraceError (UserMessage=
                    'ERROR: Unable to save <FIND> RAPPORT message for ' +
                    'SoccsX Interface.',
                                 TraceMessage =
                    'SendRapportInstruction Unable to save <FIND> RAPPORT ' +
                    'message for ' +
                    'SoccsX Interface.'
                    ); 
	    RETURN (status); 
	ELSE 
	    CALLPROC DDB_COMMIT; 
	ENDIF; 

	RETURN (status); 
END; 


