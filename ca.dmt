METHOD CircuitIns (
)=
DECLARE
   CircuitCheck = INTEGER NOT NULL;
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Circuit name filter */
   COUserName = VARCHAR(40) NOT NULL;
   RetCode    = INTEGER NOT NULL;
   SeqList    = ARRAY OF INTEGEROBJECT;
   DynamicWhereClause = VARCHAR(400) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update a status of a matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.cList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Circuit inserts/updates were made.  Please try again.';
      RETURN;
   ENDIF;


/*
**  See if matrix is checked out to this user.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName THEN
/*
**  Select Sequence that are on matrix.
*/
      i = 1;
      SeqList.Clear();
      REPEATED 
      SELECT DISTINCT
              :SeqList[i].Value = Seq
      FROM     CAC_CO_Status
      WHERE    Grouping = :CurObject.Grouping
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
       
      FOR i = 1 to CurObject.cList.LastRow() DO
/*
**  See if this is an insert or and update to a circuit sequence.
*/
         CircuitCheck = 0;
         REPEATED
         SELECT :CircuitCheck = COUNT(*) 
         FROM    CAC_CO_Circuit
         WHERE   Circuit = :CurObject.Clist[i].Object AND
                 Route   = :CurObject.Clist[i].Route AND
                 Grouping = :CurObject.Grouping;

         RetCode = CALLPROC CAC_CO_CircuitIns (
                     Grouping = CurObject.Grouping,
                     Circuit = CurObject.cList[i].Object,
                     Route = CurObject.cList[i].Route,
                     Seq = CurObject.cList[i].Seq
                     );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Could not insert Circuit information.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not insert Circuit information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;

         IF CircuitCheck = 0 THEN
            FOR j = 1 TO SeqList.LastRow() DO
               RetCode = CALLPROC CAC_CO_StatusIns (
                        Grouping = CurObject.Grouping,
                        Circuit = CurObject.cList[i].Object,
                        Route = CurObject.cList[i].Route,
                        Seq = SeqList[j].Value,
                        Status = 0
                        );

               IF Retcode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                             ': Matrix ' + varchar(CurObject.Grouping) +
                             ' status could not be inserted.');
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Could not insert status related to circuit. ' +
                     'Please try again or contact technical support if ' + 
                     'problem continues.';
                  RETURN;    
               ENDIF;
            ENDFOR;
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'You are not the user who has this matrix ' +
                'checked out and cannot make updates to it.';
      RETURN;
   ENDIF;
   RETURN;
END;



