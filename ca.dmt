	Name:            InsertPhaseCheck

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
** 
** Changes:
** 10/14/05  em  Created for Insert of Phase Check move during FOD Return move
**               processing in ReturnMoves and FMS Automation Monitor	
** 04/23/09  em  Don't insert new Phase Check move if an outstanding one already
**               exists on the card. 
*/
PROCEDURE InsertPhaseCheck (
   Card		= INTEGER NOT NULL;    	/*Parameter*/
   Equip	= INTEGER NOT NULL;    	/*Parameter*/
   EquipName  	= VARCHAR(40) NOT NULL WITH DEFAULT; 	/*Parameter*/
   EquipClass	= INTEGER NOT NULL;    	/*Parameter*/
   EquipClassName  = VARCHAR(40) NOT NULL WITH DEFAULT; 	/*Parameter*/
   PrintID      = CHAR(3) NOT NULL WITH DEFAULT; 	/*Parameter*/
   IssueIt      = INTEGER NOT NULL WITH DEFAULT; 	/*Parameter*/
   Operator   	= INTEGER;		/*Optional Parameter*/

   C            = FMS_Card;             /*Need Class fro InsertJobsRow*/
   IssueTime    = DATE;                 /*Timestamp*/
   NewJob       = INTEGER;              /*Nullable Return Code 0r New Job*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;  
   AlreadyExists = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** Phase Check Job will already be setup in FMS, but perhaps not in FMS
** Automation
*/
   IF PhaseCheckJob.Job = 0 THEN
      SELECT PhaseCheckJob.Job = -1,
             PhaseCheckJob.Seq = -1,
             PhaseCheckJob.Status = '', 
             PhaseCheckJob.JobClass = JC.JobClass,
             PhaseCheckJob.MoveType = JC.MoveType,
             PhaseCheckJob.TOMove = JC.TOMove,
             PhaseCheckJob.TOMoveRules = JC.TOMoveRules,
             PhaseCheckJob.RSMove = JC.RSMove,
             PhaseCheckJob.RSMoveRules = JC.RSMoveRules,
             PhaseCheckJob.MoveFGColor = :CC_BLACK,
             PhaseCheckJob.Response = '',
             PhaseCheckJob.MoveEquipClass = :Type$Switch
      FROM   FMS_JobClass JC
      WHERE  JC.JobClass = :PhaseCheck$JobClass;
   ENDIF; 
/*
** Set up FMS_Card class fields needed by InsertJobsRow routine.
*/
   SELECT :C.Card = Card,
          :C.Status = Status,
          :C.Feeder = Feeder,
          :C.TypeOfCard = TypeOfCard
   FROM   FMS_Card
   WHERE  Card = :Card;
/*
** Complete PhaseCheckJob setup and perform insert
*/
   PhaseCheckJob.Card = C.Card;   
   PhaseCheckJob.Equip = Equip;
   PhaseCheckJob.EquipClass = EquipClass;  
   PhaseCheckJob.EquipClassName = EquipClassName;  
   PhaseCheckJob.PrintID = PrintID;
   PhaseCheckJob.EquipName = EquipName;
   PhaseCheckJob.Grounds = NULL;
   PhaseCheckJob.GroundOn = NULL;
   PhaseCheckJob.StepPair = StepHeading$DeLoad;

   AlreadyExists = FALSE;
   REPEATED
   SELECT  :AlreadyExists = J.Job
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :PhaseCheckJob.Card AND
           JC.Job = J.Job AND
           J.JobClass = :PhaseCheckJob.JobClass AND
           J.Equip = :PhaseCheckJob.Equip AND 
           J.RSIssued IS NULL AND
           J.Status = '';
 
   IF AlreadyExists = FALSE THEN 
          
      NewJob = CALLPROC InsertJobsRow 
                      (NewJob = PhaseCheckJob,
                       C = C,
                       ByPassDuplicateMessage = TRUE,
                       SingleCardInsertion = TRUE);

      IF (NewJob IS NULL) THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
             'Unable to insert Phase Check Move into Card.',
                           TraceMessage =
             'Procedure: InsertPhaseCheck; Unable to insert Phase Check Move into Card');
         RETURN;
      ENDIF;
   ELSE
      NewJob = AlreadyExists;
   ENDIF; 
   CALLPROC DDB_COMMIT;
/*
** Now issue Restore Phase Check if we need to.
*/
   IF IssueIt = TRUE THEN
      IssueTime = 'now';

      RetCode = CALLPROC SOA_IssueMove (
                  Job = IFNULL(NewJob,0),
                  Status = Job$Restore,
                  Issued = IssueTime,
                  Operator = Operator);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
             'Unable to issue new Phase Check move.',
                           TraceMessage =
             'Procedure: InsertPhaseCheck; Unable to issue new Phase Check Move');
         RETURN;
      ENDIF; 

      RetCode = CALLPROC SOA_CompleteMove (
                  Job = IFNULL(NewJob,0),
                  Status = Job$Restore,
                  Complete = IssueTime);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
             'Unable to complete new Phase Check move.',
                           TraceMessage =
             'Procedure: InsertPhaseCheck; Unable to complete new Phase Check Move');
         RETURN;
      ENDIF; 
 
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

