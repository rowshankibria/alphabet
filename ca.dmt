	Name:            PromptTemperature

/*
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptTemperature
**
**  09/10/14  em   Created
**  07/01/15  em   Added Attributes
**  10/29/21  em   Incorporate SSO return
**  06/30/22  em   AutoComplete if Reading is loaded from RR
*/
INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   TemperatureCheck = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;
   
   SELECT :TemperatureCheck = TemperatureCheckResult
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF TemperatureCheck > 0 THEN
      Reading = TemperatureCheck;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(Reading).CurBias = FB_VISIBLE;
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName='AutoComplete');
   ENDIF;
   
   FIELD(Heading).TextValue = 'Reading from ' + Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName;
END;

ON USEREVENT 'AutoComplete',
ON Click OKButton =
BEGIN
   RetCode = CALLPROC DSO_ReadingIns(
      Card = JIP.Card,
      Time = DATE('NOW'),
      Job = JIP.Job,
      Structure = JIP.Substation,
      Equip = JIP.Equip,
      ReadingType = 'Temperature',
      Reading = VARCHAR(Reading) + ' degrees');

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record temperature reading.',
                           TraceMessage =
                  'PromptTemperature: Unable to record temperature reading for ' +
                  'card=' + VARCHAR(JIP.Card));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;

   IF JIP.Response <> '' THEN
      JIP.Response = Squeeze(VARCHAR(Reading) + ' degrees; ' + JIP.Response);
   ELSE
      JIP.Response = Squeeze(VARCHAR(Reading) + ' degrees ');
   ENDIF;
   JIP.ResponseUpd();
                 
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

