Application Component Report
============================

	Name:            PromptMTAContingency

/*
**
**	Copyright c 2020 Pateric Software LLC. All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptMTAContingency
**
**  Modifications:
**  10/15/20   em   Created
**  06/21/21   em   Preview pane and Prview button made invisible.
**                  If the feeder is CutOut, send an immediate message to CIG.
**  01/18/24   em   Display title changes directed by Dave ONeill
*/
INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER NOT NULL WITH DEFAULT;
    FeederCount = INTEGER NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL;
    MTAC = ARRAY OF MTAContingency;
    MTAMsg = MTAContingency_ASE;
    RetCode = Integer not null;
    SelectedRow = INTEGER NOT NULL WITH DEFAULT;
    TempObj = INTEGER NOT NULL;
    TempChar = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
DECLARE
    SaveLastRow = PROCEDURE;
    SaveData = PROCEDURE;
ENDDECLARE
BEGIN
/*
** Select the lines associated with the HTV
*/
   i = 1;
   FIELD(Lines).ValueList.ChoiceItems.Clear();
   SELECT :TempChar = O.Name,
          :TempObj = O.Object
   FROM    Udb_Object O,
           Udb_Grouping G
   WHERE   G.Member = :JIP.Equip AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$MTALine AND
           G.Grouping = O.Object
   ORDER BY 1
   BEGIN 
      FIELD(Lines).ValueList.ChoiceItems[i].EnumValue = TempObj;
      FIELD(Lines).ValueList.ChoiceItems[i].EnumText = TempChar;
      i = i + 1;
   END;
   
   IF FIELD(Lines).ValueList.ChoiceItems.LastRow <= 10 THEN
      FIELD(Lines).VisibleRows = FIELD(Lines).ValueList.ChoiceItems.LastRow;
   ELSE
      FIELD(Lines).VisibleRows = 10;
   ENDIF;
   FIELD(Lines).UpdChoiceList();
/*
** Load Contingency Types
*/   
   i = 1;
   FIELD(Contingency).ValueList.ChoiceItems.Clear();
   SELECT :TempChar = T.Name,
          :TempObj = T.Type
   FROM    Udb_Type T,
           Udb_SuperType ST
   WHERE   ST.SuperType = :Type$MTAContingencies AND
           ST.Type = T.Type
   ORDER BY 2
   BEGIN 
      FIELD(Contingency).ValueList.ChoiceItems[i].EnumValue = TempObj;
      FIELD(Contingency).ValueList.ChoiceItems[i].EnumText = TempChar;
      i = i + 1;
   END;
   FIELD(Contingency).UpdChoiceList();
/*
** Build out background array from existing card data if it exists.
*/ 
   MTAC.Clear();
   LastRow = FIELD(Lines).ValueList.ChoiceItems.LastRow;
   FOR i = 1 TO LastRow DO
      MTAC[i].Card = JIP.Card;
      MTAC[i].Line = FIELD(Lines).ValueList.ChoiceItems[i].EnumValue;
      MTAC[i].LineName = FIELD(Lines).ValueList.ChoiceItems[i].EnumText;
      MTAC[i].LoadContingency();
      IF MTAC[i].Contingency = 0 THEN
         MTAC[i].Contingency = Type$MTANoImpact;
         MTAC[i].ContingencyName = 'No Impact';
      ENDIF;
   ENDFOR;

   IF MTAC.LastRow = 0 THEN
      CurFrame.Trace(VARCHAR(DATE('now')) + ': There are no MTA LInes associated with HTV Rectifier ' + 
                            VARCHAR(JIP.Equip) );
      RETURN(PU_OK);
   ENDIF; 
END;

ON SETVALUE Lines =
DECLARE
   CardFeeder = INTEGER NOT NULL WITH DEFAULT;
   FirstInt = INTEGER NOT NULL WITH DEFAULT;
   NextInt = INTEGER NOT NULL WITH DEFAULT;
   RefChar = CHAR(10) NOT NULL WITH DEFAULT;
   RefInt = INTEGER NOT NULL WITH DEFAULT;
   SelectedLine = INTEGER NOT NULL WITH DEFAULT;
   WhereClause = VARCHAR(500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** If changing row, then save data for old row to background list
*/   
   IF SelectedRow > 0 THEN
      CALLPROC SaveLastRow();
   ENDIF;
/*
** Update display for selected line
*/   
   SelectedLine = FIELD(Lines).CurEnumValue;
   FeederCount = 0;
   RefChar = '';
   SELECT :RefChar = G.Reference
   FROM   Udb_Grouping G
   WHERE  G.Member = :JIP.Equip AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = :SelectedLine;
          
   IF RefChar = '' THEN
      MESSAGE 'Data SetUp Error: HTV Rectifier does not have a sequence associated with MTA Line. Contact Core Group DO. ' +
              'Automated message cannot be sent to CIG.';
      RETURN (PU_OK);
   ENDIF;        
/* 
** Get list of surrounding reference integers greater than zero, start building dynamic where clause 
*/   
   RefInt = INT4(RefChar);
   WhereClause = '(';
   FirstInt = FALSE;
   FOR i = (RefInt - 4) TO (RefInt + 4) DO
         NextInt = i;
         IF NextInt <= 0 OR NextInt = RefInt THEN 
            CONTINUE;
         ENDIF;
         IF FirstInt = FALSE THEN
            WhereClause = WhereClause + VARCHAR(NextInt); 
            FirstInt = TRUE;
         ELSE
            WhereClause = WhereClause + ',' + VARCHAR(NextInt); 
         ENDIF;
   ENDFOR;
   WhereClause = WhereClause + ')';
   WhereClause = 
         'G1.Grouping = ' + VARCHAR(SelectedLine) + ' AND ' +
         'G1.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
         'G1.Reference IN ' + WhereClause + ' AND ' +
         'G1.Member = G2.Member AND ' +
         'G2.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
         'G2.GroupingType = ' + VARCHAR(Type$Feeder) + ' AND ' +
         'G2.Grouping = O.Object';
   
   Feeders.Clear();
   i = 1;
   SELECT :Feeders[i].Name = O.Name,
          :Feeders[i].Object = O.Object
   FROM   Udb_Grouping G1,
          Udb_Grouping G2,
          Udb_Object O
   WHERE  :WhereClause 
   ORDER BY Name
   BEGIN 
      i = i + 1;
   END;
/*
** Remove Feeder already associated to this card
*/
   i = Feeders.LastRow;
   WHILE i > 0 DO
      FIELD(Feeders[i].Name).ISReverse = FALSE;
      CardFeeder = 0;
      SELECT :CardFeeder = Object
      FROM   TFMS_CardToObject 
      WHERE  Card = :JIP.Card AND
             Object = :Feeders[i].Object;

      IF CardFeeder > 0 THEN
         Feeders.RemoveRow (RowNumber = i);
      ENDIF; 
      i = i - 1;
   ENDWHILE;
/*
** Preset based on existing data in background array, if it exists
*/
   Contingency = Type$MTANoImpact;
   FOR i = 1 TO MTAC.LastRow DO 
      IF SelectedLine = MTAC[i].Line THEN
         SelectedRow = i;
         Contingency = MTAC[i].Contingency;
         DOComment = MTAC[i].DOComment;
         IF Contingency <> Type$MTANoImpact THEN
         /*
         ** For each feeder in background array, find it on screen list and highlight it or insert it if not there.
         */
            j = 1;
            WHILE j <= MTAC[i].Feeders.LastRow DO
               k = 1;
               WHILE k <= Feeders.LastRow DO
                  IF Feeders[k].Object = MTAC[i].Feeders[j].Object THEN
                     FIELD(Feeders[k].Name).ISReverse = TRUE;
                     FeederCount = FeederCount + 1;
                     ENDLOOP;
                  ENDIF;   
                  k = k + 1;
               ENDWHILE;
               IF k > Feeders.LastRow THEN
                  NextInt = Feeders.LastRow + 1;
                  Feeders.InsertRow (RowNumber=NextInt);
                  Feeders[NextInt].Object = MTAC[i].Feeders[j].Object;
                  Feeders[NextInt].Name = MTAC[i].Feeders[j].Name;
                  FIELD(Feeders[NextInt].Name).ISReverse = TRUE;
                  FeederCount = FeederCount + 1;
               ENDIF;   
               j = j + 1;
            ENDWHILE;
         ENDIF;
         ENDLOOP;
      ENDIF;
   ENDFOR; 
   
   IF Contingency = Type$MTANoImpact THEN
      FIELD(Feeders).CurBias = FB_DIMMED;
      FIELD(DOComment).ParentField.CurBias = FB_DIMMED;
      DOCOmment = '';
   ELSE
      FIELD(Feeders).CurBias = FB_LANDABLE;
      FIELD(DOComment).ParentField.CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON CHILDENTRY Feeders =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   
   IF FIELD(Feeders[].Name).ISReverse = TRUE THEN
      FIELD(Feeders[].Name).ISReverse = FALSE;
      FeederCount = FeederCount - 1;
   ELSEIF FeederCount >= 5 THEN
      MESSAGE 'Feeders limited to a count of five to control message length.';
   ELSE
      FIELD(Feeders[].Name).ISReverse = TRUE;
      FeederCount = FeederCount + 1;
   ENDIF;
END;

ON SETVALUE Contingency = 
BEGIN
   IF SelectedRow = 0 THEN
      MESSAGE 'Must select MTA Line.';
      RESUME;
   ENDIF;
   IF Contingency = Type$MTANoImpact THEN
      MTAC[SelectedRow].Feeders.Clear();
      FOR i = 1 TO Feeders.LastRow DO
         FIELD(Feeders[i].Name).ISReverse = FALSE; 
      ENDFOR;
      FIELD(Feeders).CurBias = FB_DIMMED;
      MTAC[SelectedRow].DOComment = '';
      DOComment = '';
      FIELD(DOComment).ParentField.CurBias = FB_DIMMED;
   ELSE
      FIELD(Feeders).CurBias = FB_LANDABLE;
      FIELD(DOComment).ParentField.CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON Click Review_Btn =
BEGIN
   CALLPROC SaveData();
/*
** Load data for testing and review
*/   
   MTAMsg.Card = JIP.Card;
   MTAMsg.CIGMessage = '';
   MTAMsg.LoadCIGMessage();
   IF MTAMsg.CIGMessage = '' THEN
      CIGNote = 'No MTA Contingency data for this Card';
   ELSE
      CIGNote = MTAMsg.CIGMessage;
   ENDIF;
END;

ON Click OKButton =
DECLARE
   FdrName = Varchar(80) NOT NULL;     
   IsCutOut = INTEGER NOT NULL WITH DEFAULT;
   MsgTxt = Varchar(2000) NOT NULL;     /* CIG text */
   MTAMsg = MTAContingency_ASE;
BEGIN
/*
** Don't allow save and exit unless minimum effort has been made
*/
   IF SelectedRow = 0 THEN
      IF MTAC.LastRow <= 1 THEN
         SelectedRow = 1;
      ELSE
         MESSAGE 'Please review MTA Contingency for each line.';
         RESUME;
      ENDIF;
   ENDIF;
   
   CALLPROC SaveData();
/*
** Send CIG Message if CutOut
*/
   IsCutOut = 0;
   SELECT :IsCutOut = 1,
          :FdrName = FeederName
   FROM   FMS_Card 
   WHERE  Card = :JIP.Card AND
          CutOut IS NOT NULL;
          
   IF IsCutOut = 1 THEN
      MTAMsg.Card = JIP.Card;
      MTAMsg.CIGMessage = '';
      MTAMsg.LoadCIGMessage();
      IF MTAMsg.CIGMessage <> '' THEN
         MsgTxt = 'MTA Contingency Update for Feeder ' + FdrName + '.' +
                     MTAMsg.CIGMessage;
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                 ,MessageText = MsgTxt
                 ,Time = date('now')
                 ,Priority = 1
                 ,MessageType = 0
                 ,Card = JIP.Card);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Could not send automated ' +
                  'message to CIG.  Please contact CIG verbally to let ' +
                  'them know feeder ' + FdrName + ' supplying MTA is updated.',
                     TraceMessage = 'Could not send automated message to CIG for ' +
                  'feeder supplying railroad customer.' 
                  );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;        
   ENDIF;
   
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE SaveLastRow (
) =
BEGIN
      MTAC[SelectedRow].Contingency = Contingency;
      MTAC[SelectedRow].ContingencyName = FIELD(Contingency).CurEnumText;
      IF Contingency = Type$MTANoImpact THEN
         DOComment = '';
         MTAC[SelectedRow].DOComment ='';
         MTAC[SelectedRow].Feeders.Clear();
      ELSE
         MTAC[SelectedRow].DOComment = DOComment;
         j = 0;
         MTAC[SelectedRow].Feeders.Clear();
         FOR i = 1 TO Feeders.LastRow DO
            IF FIELD(Feeders[i].Name).ISReverse = TRUE THEN
               j = j + 1;
               MTAC[SelectedRow].Feeders.InsertRow (RowNumber = j);
               MTAC[SelectedRow].Feeders[j].Object = Feeders[i].Object;
               MTAC[SelectedRow].Feeders[j].Name = Feeders[i].Name;
            ENDIF;
         ENDFOR;
      ENDIF;
END;

PROCEDURE SaveData (
) =
BEGIN
/*
** If changing row, then save data for old row to background list
*/   
   IF SelectedRow > 0 THEN
      CALLPROC SaveLastRow();
/*
** Save background data to database
*/
      FOR i = 1 TO MTAC.LastRow DO
         RetCode = CALLPROC FMS_MTAContingencyIns (
                          Card = MTAC[i].Card,
                          Line = MTAC[i].Line,
                          LineName = MTAC[i].LineName,
                          Contingency = MTAC[i].Contingency,
                          ContingencyName = MTAC[i].ContingencyName,
                          DOComment = MTAC[i].DOComment);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Unable to save MTA Contingency';
            RESUME;
         ENDIF;
         
         FOR j = 1 TO MTAC[i].Feeders.LastRow DO
            RetCode = CALLPROC FMS_MTAContingencyFeederIns (
                          Card = MTAC[i].Card,
                          Line = MTAC[i].Line,
                          FeederName = MTAC[i].Feeders[j].Name,
                          Feeder = MTAC[i].Feeders[j].Object);        
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'ERROR: Unable to save MTA Contingency Feeder';
               RESUME;
            ENDIF;
         ENDFOR;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ENDIF;
END;
