	Name:            PromptPendingClose101

/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptPendingClose101         
**
**  Modifications:
**  06/26/02   em   Created to handle ATS moves impacting both 101 and 101 
**                  performed against the ATS Macro device (the ATS 
**                  Superstructure). The move will appear as a common
**                  equipment move on all cards where the ATS Macro is a
**                  common equipment.  
**  05/06/04   em   Modified PromptClose101FromMacro to set pending close to
**                  be used at Issue Time 
**  06/01/04   em   Return Code Evaluation Error
*/
INITIALIZE                         
(
    JIP = JobInProgress;		/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    ATS = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
    IssuedOperator = INTEGER NOT NULL; 
    SelectCount = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device.
**  Then find its related ATS101 device.
*/ 
   ATS.Object = 0;
   REPEATED
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'PromptPendingClose101:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );
      RETURN (PU_CANCEL);
   ENDIF;

   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'PromptPedningClose101:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;
/*
** ATS 101 device is found, now set a pending closed status.
*/
   IF JIP.Status = Job$TakeOut THEN
      IssuedOperator = IFNULL(JIP.TOOperator,0);
   ELSEIF JIP.Status = Job$Restore THEN
      IssuedOperator = IFNULL(JIP.RSOperator,0);
   ENDIF;

   SelectCount = 0;                /*Check for Count Existence */
   SELECT :SelectCount = StatusCount
   FROM   FMS_PendingStatus 
   WHERE  Object = :ATS101.Object AND
          IssuedOperator = :IssuedOperator AND
          PendingStatus = :Status$Closed;
 
   IF SelectCount = 0 THEN
 
      RetCode = CALLPROC FMS_SetPendingStatus(
                                 Object = :ATS101.Object,
                                 IssuedOperator = :IssuedOperator,
                                 PendingStatus = :Status$Closed,
                                 StatusCount = 1);
   ELSE    

      RetCode = CALLPROC FMS_BumpPendingStatCount(
                                Object = :ATS101.Object, 
                                IssuedOperator = :IssuedOperator,
                                PendingStatus = :Status$Closed,
                                increment = 1);
   ENDIF; 

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN (PU_OK);
   ENDIF;
END;

