	Name:            ManualOrderRescind

/*
**
**  Copyright c 2001 ALSTOM
**  ESCA CORPORATION.  All rights reserved.
**
**  ALSTOM ESCA CORPORATION. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of ALSTOM ESCA CORPORATION.
**
*/
/*
**  Application:    FeederCard
**  Frame:          ManualOrderRescind
**
**  02/07/01        my     Created
**  02/22/01        em     Code Review
**  09/13/01        pkw    Add card control code.
**  10/04/01        em     Modified to support new table structure and
**                         Reason Types.
**  10/08/01        em     Check for duplicate before insert.
**  10/09/01        pkw    Change color of screen.
**  04/01/02        em     Changed AND to OR when evaluating Presel = 0. Don't know
**                         why this wasn't seen before.
**  05/02/02        pkw    On force rescind DO must select operator.
**  09/25/02        ysp    Merge: use include script to handle card control.
**  12/02/02        pkw    Don't pass OfferSelection to SelectOperator screen.
**  01/06/03        ysp    ITC 114: Use DoLogin to select a DO.
**  01/23/03        ysp    Removed local FO object declaration
**  02/16/04        ysp    SSO Enhancement: save rescind status in the order table.
**                         and reset the feeder ground status
**  07/20/05        em     For Force Rescind, set status to Confirm Rescinded
**  02/10/06        em     Reselect OrderStatus on OK click just to make sure
**                         Order has not been Rejected or Acknowledged in the
**                         time this screen is displayed.
**  12/08/06        ysp    Delete outgoing messages after orders forcibly rescinded.
**  04/05/07        ysp    If this order is an in-service permit, populate the reason field
**                         with T.O. entered withdrawal reason. 
**  04/16/07        ysp    ITC210: Insert IR interface event in DB event queue
**  06/12/09        pkw    Remove ability to change DO login.
**  10/27/21        em     Add support for DSO
*/

INITIALIZE
(
    ForceRescind = INTEGER NOT NULL WITH DEFAULT;  /* Passed*/
    OrderNumber = INTEGER NOT NULL WITH DEFAULT;   /* Passed*/
    OrderStatus = INTEGER NOT NULL WITH DEFAULT;   /* Passed*/

#   include StandardDeclarations
    Feeder = INTEGER NOT NULL WITH DEFAULT;
    InServicePermit = INTEGER NOT NULL WITH DEFAULT;
    MsgKey = INTEGER NOT NULL WITH DEFAULT;
    OrderApplication = VARCHAR(3) NOT NULL WITH DEFAULT;
    OrderCard = INTEGER NOT NULL WITH DEFAULT;
    OrderCheck = INTEGER NOT NULL WITH DEFAULT;
    OrderSubstation = INTEGER NOT NULL WITH DEFAULT;
    ParentFrame = FRAMEEXEC;
    Presel = INTEGER NOT NULL WITH DEFAULT; /* Selection Value*/
) =
BEGIN
    IF ForceRescind = TRUE THEN
       FIELD(force_stack).CurBias = FB_VISIBLE;
       FIELD(rescind_stack).CurBias = FB_INVISIBLE;
       FIELD(SSOOperator).CurBias = FB_CHANGEABLE;
    ELSE
       FIELD(force_stack).CurBias = FB_INVISIBLE;
       FIELD(rescind_stack).CurBias = FB_VISIBLE; 
       FIELD(SSOOperator).CurBias = FB_INVISIBLE;
    ENDIF;
    Presel = 0;
    DistrictOperator = DOp.Description;
    SSOOperator.Name = '';
/*
** If this order is an in-service permit, populate the reason field
** with T.O. entered reason.
*/
    IF ForceRescind = TRUE THEN
       InServicePermit = 0;
       SELECT :InServicePermit = P.ISPermit
       FROM   IR_OpOrderJobs J,
              SOA_InServicePermit P
       WHERE  J.OrderNumber = :OrderNumber AND
              J.Job = P.Job AND
              P.Status = :ISPStatus$WithdrawRequest;

       IF InServicePermit > 0 THEN
          SELECT :Reason = E.WithdrawReason,
                 :DistrictOperator = O.Description 
          FROM   SOA_ISPWithdrawPermit P,
                 SOA_ISPWithdrawEvent E,
                 UDB_Object O
          WHERE  P.ISPermit = :InServicePermit AND
                 P.WithdrawEvent = E.WithdrawEvent AND
                 P.WithdrawTime = E.WithdrawTime AND
                 E.WithdrawBy = O.Object;

          FIELD(RescindByLabel).TextValue = 'Rescinded by TO';
       ENDIF;
    ENDIF;

    CurFrame.SendUserEvent (eventname='load table');
END;


ON USEREVENT 'load table' =
BEGIN
    O.Clear();
    i = 1;

    SELECT :O[i].Name = t.name,
           :O[i].Type = t.type
    FROM   udb_type t, 
           udb_extendedtype e      
    WHERE  e.supertype = :Type$RescissionReason AND
           e.type <> e.supertype AND
           t.type = e.type
    ORDER BY 1
    BEGIN
          i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
END;    

/*
**  Handle the childclick 
*/
ON Childentry O  =
BEGIN

    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

/*
**  Reset the highlight for the frame
*/
    Presel = FIELD(O).CurRow;

    i = 1;
    WHILE (i <= O.LastRow()) DO
        IF (i = Presel) THEN
            FIELD(O[i].Name).IsReverse = TRUE;
        ELSE
            FIELD(O[i].Name).IsReverse = FALSE;
        ENDIF;
        i = i + 1;
    ENDWHILE;    

    CurFrame.Flush();

END;

ON ChildSetValue O[*].Name =
BEGIN
    Curframe.InputFocusField = FIELD(Reason);
END;


ON ENTRY SSOOperator.Name =
BEGIN
    RetCode = CALLFRAME SelectOperator (AnyName = TRUE);
    IF RetCode = PU_Cancel THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       SSOOperator.Name = FO.Description;
    ENDIF;             
END;


/*
**  Handle an OK click
*/
ON Click OKButton =
BEGIN
/*
** Validate entry fields
*/
    IF Lowercase (Reason) LIKE '%fuck%' OR 
       Lowercase (Reason) LIKE '%shit%' OR 
       Lowercase (Reason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        Reason = '';
	RESUME;

    ELSEIF Presel = 0 OR Length( Squeeze (Reason)) <= 6 THEN

        MESSAGE 'You must select a reason or enter more explanation.';
        Reason = '';
        RESUME;

    ELSEIF DistrictOperator = '' THEN
 
        MESSAGE 'Please Select your name from the District Operator list.';
        RESUME;

    ELSEIF SSOOperator.Name = '' AND ForceRescind = TRUE THEN
 
        MESSAGE 'Please Select the SSO Operator with whom you ' +
                'confirmed the FORCE RESCIND.';
        RESUME;

    ENDIF;
/*
**  Sanity Check.  Has order status changed?
*/
    IF CurrentApplication = Application$DSO THEN   
       SELECT  :OrderStatus = OrderStatus,
            :OrderCard = Card,
            :OrderSubstation = Substation,
            :MsgKey = 0 
       FROM    IR_DSOOrder
       WHERE   OrderNumber = :OrderNumber;
    ELSE
       SELECT  :OrderStatus = OrderStatus,
            :OrderCard = Card,
            :OrderSubstation = Substation,
            :MsgKey = MsgKey 
       FROM    IR_OperatingOrder
       WHERE   OrderNumber = :OrderNumber;
    ENDIF;
    
    IF ForceRescind = TRUE THEN
       RetCode = CALLPROC MSG_UpdateMsg (Card = OrderCard,
                                  Ack = Ack$Delete,
                                  MsgKey = MsgKey,
                                  AckByOpName = DistrictOperator,
                                  AckDate = date('now'),
                                  DelByOpName = DistrictOperator,
                                  DelDate = date('now'),
                                  Substation = OrderSubstation
                                  );
       CALLPROC DDB_COMMIT;
       
       IF OrderStatus = Order$Rejected OR OrderStatus = Order$Closed THEN
          MESSAGE 'This order has been returned or rejected by the SSO ' +
                  'and must now be processed from the Incoming Message ' +
                  'to maintain consistency with Rapid Restore.';
          RETURN(PU_CANCEL);
       ENDIF;

       Reason = 'SSO Contacted: ' + SSOOperator.Name + 
                '. Reason: ' + Reason;

       IF CurrentApplication = Application$DSO THEN   
          RetCode = CALLPROC IR_DSOOrderRescindUpd (
                      OrderNumber = OrderNumber,
                      OrderStatus = Order$ConfirmRescinded,
                      RescindType = 'FORCE',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType =  O[Presel].Type,
                      RescindReasonTypeName = O[Presel].Name,                            
                      RescindDO = DistrictOperator);
       ELSE
          RetCode = CALLPROC IR_OpOrderRescindUpd (
                      OrderNumber = OrderNumber,
                      OrderStatus = Order$ConfirmRescinded,
                      RescindType = 'FORCE',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType =  O[Presel].Type,
                      RescindReasonTypeName = O[Presel].Name,                            
                      RescindDO = DistrictOperator);
       ENDIF;

       IF RetCode <> 0  THEN
          CALLPROC DDB_ROLLBACK;
          Message 'ERROR: Unable to Rescind the Order. ';
          RETURN (PU_CANCEL);
       ELSE       
          CALLPROC DDB_COMMIT; 

          ControlText = VARCHAR(OrderNumber);
          CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_ForceRescindOrder',
                     EventText = ControlText);  

          /*
          ** If this order sets the Feeder Ground status, we should reset it.
          ** check if there is a Apply Feeder Ground objective in the order
          */
          OrderApplication = '';
          SELECT :OrderApplication = OP.Application,
                 :Feeder = C.Feeder
          FROM   IR_OperatingOrder OP,
                 FMS_Card C
          WHERE  OP.OrderNumber = :OrderNumber AND
                 OP.Card = C.Card;
          CALLPROC DDB_ROLLBACK;
 
          IF OrderApplication = 'FMS' THEN     
             OrderCheck = 0;
             SELECT :OrderCheck = Objective
             FROM   IR_OpOrderObjectives
             WHERE  OrderNumber = :OrderNumber AND
                    Objective = :Objective$ApplyFdrGnd;

             IF OrderCheck > 0 THEN
                OrderCheck = 0;
                SELECT :OrderCheck = StatusCount
                FROM   FMS_ObjectStatus
                WHERE  Object = :Feeder 
                  AND  Status = :Status$FdrG
                  AND  StatusCount > 0;

                RetCode = 0;
                IF OrderCheck = 1 THEN
                   RetCode = CALLPROC FMS_ObjStatDel (
                        Object = Feeder,
                        Terminal = 0,
                        Status = Status$FdrG);
                ELSEIF OrderCheck > 0 THEN
                   RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                        Object = Feeder,
                        Status = Status$FdrG,
                        Increment = -1,
                        TimeSet = Date('now'));
                ENDIF;

                IF RetCode < 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Unable to reset Feeder Ground status for the current feeder. ' +
                       'Please reset the status manually.';
                ELSE
                   CALLPROC DDB_COMMIT;
                ENDIF;
             ENDIF;
          ENDIF;
       ENDIF;
    ELSE  /* Rescission Request */

       IF CurrentApplication = Application$DSO THEN      
          RetCode = CALLPROC IR_DSOOrderRescindUpd (
                      OrderNumber = OrderNumber,
                      OrderStatus = OrderStatus,
                      RescindType = 'REQUEST',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType =  O[Presel].Type,
                      RescindReasonTypeName = O[Presel].Name,
                      RescindDO = DistrictOperator);
       ELSE
          RetCode = CALLPROC IR_OpOrderRescindUpd (
                      OrderNumber = OrderNumber,
                      OrderStatus = OrderStatus,
                      RescindType = 'REQUEST',
                      RescindComment = Reason,
                      RescindTime = 'now',
                      RescindReasonType =  O[Presel].Type,
                      RescindReasonTypeName = O[Presel].Name,
                      RescindDO = DistrictOperator);
       ENDIF;

       IF RetCode <> 0  THEN
              CALLPROC DDB_ROLLBACK;
              Message 'ERROR: Unable to Rescind the Order. ';
              RETURN (PU_CANCEL);
       ELSE
              CALLPROC DDB_COMMIT; 
           
              ControlText = VARCHAR(OrderNumber);
              CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_RescindOrder',
                     EventText = ControlText);  
       ENDIF;
    ENDIF;     

    RETURN(PU_OK);
END;
/*
**  Handle a Cancel click
*/
ON Click CancelButton =
BEGIN
    RETURN (PU_CANCEL);
END;
