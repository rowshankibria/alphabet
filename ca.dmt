	Name:            SelectFMSCard

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          SelectFMSCard
**
**  Modifications:
**  03/30/06  ysp   Created
**  11/29/07  ysp   ITC154 enhancement: Add view card button.
*/
INITIALIZE
(
   Title = Varchar(80) NOT NULL WITH DEFAULT;   /* passed in */

   i = integer;			        /* Temporary counter */
   FMSOperatorName = VARCHAR(10) NOT NULL WITH DEFAULT;
   EventText = VARCHAR(100) NOT NULL WITH DEFAULT;
) =
BEGIN
   FIELD(CardList).Title = Title;

   IF UserName = Role$Manager OR UserName = Role$Tester THEN
      FIELD(View_Btn).CurBias = FB_INVISIBLE;
   ENDIF;
END;

/*
**	Handle an open card selection from the list
*/
ON ChildEntry CardList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;    

    Selected.Card = CardList[].Card;
    Selected.Opened = CardList[].Opened;
    Selected.FeederName = CardList[].FeederName;
    Selected.FeederStatus = CardList[].FeederStatus;
    Selected.FeederStatusName = CardList[].FeederStatusName;
    Selected.CardClassName = CardList[].CardClassName;
    Selected.CurrentNote = CardList[].CurrentNote;
END;

/*
** Handle an OK click
*/
ON Click OK_Btn =
BEGIN
   IF Selected.FeederName = '' THEN
      Message 'You have not selected a card.';
      RESUME;
   ENDIF;
   RETURN Selected.Card;
END;

ON Click View_Btn =
BEGIN
   IF Selected.FeederName = '' THEN
      Message 'You have not selected a card.';
      RESUME;
   ENDIF;

   FMSOperatorName = Left(UserName, 2) + '2' + Right(UserName,2);
   EventText = FMSOperatorName + ';' + VARCHAR(Selected.Card) + '; ;';
   CALLPROC DDB_RaiseDBEvent ( DBEventName = 'LoadFMSCard', 
                               DBEventText = EventText); 
   CALLPROC DDB_COMMIT;
END;

/*
** Handle an Cancel click
*/
ON Click Create_Btn =
BEGIN
   RETURN (0);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

