Application Component Report
============================

	Name:            PromptHVPhases

/*
**
**	Copyright c 2019 Pateric Software, LLC. All rights reserved.
**
**	Pateric Software, LLC. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software, LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptHVPhases
**
**  Modifications:
**  02/14/19  pkw   Display High Voltage phase options
**  02/18/19  pkw   Log Comment in transaction log if present
**  02/28/23  em    Add insert into FRA_HVPhases for FSS download
**  03/03/23  em    Download FRA only for Auto/CIOA
**  05/05/23  em    Add FOT to FRA Download
*/

INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    C = FMS_Card;				/* Card details */
    BackFeedCheckResult = VARCHAR(3) not null;/* IR_DOWNLOADMOVE table column */
    PT = Varchar(20);			/* Prompt text */
    NewJob = JobInProgress;                       /* NewJob */
    NetworkFeeders = ARRAY OF INTEGEROBJECT;
    SDFeeders = INTEGEROBJECT;
    i = INTEGER;
    x = INTEGER NOT NULL WITH DEFAULT;
    StepCount = integer not null;
    RetCode = Integer not null;
    FodMsg = VARCHAR(500) NOT NULL; 
    FodRegion = VARCHAR(20) NOT NULL;
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
/*
**  Only use prompt if move issued on substation equipment.
*/
   i = 0;
   SELECT :i = G.Grouping
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET
   WHERE  G.Member = :JIP.Equip AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = ET.Type AND
          ET.SuperType = :Type$Substation;
   IF i = 0 THEN
      RETURN (PU_OK);
   ENDIF;
/*
** Get needed FMS Card information
*/
   C.Feeder = 0;
   REPEATED
   SELECT DISTINCT
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.Card = C.Card,
          :C.CutOut = C.CutOut,
          :C.CutIn = C.CutIn,
          :C.TypeOfCard = C.TypeOfCard,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.NetworkFeeder = C.NetworkFeeder
   FROM   FMS_Card C,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card;

   IF C.Feeder = 0 THEN
      CALLPROC TraceError (UserMessage =
                 'High Voltage Phases move is not properly related to an FMS card.',
                           TraceMessage =
                 'PromptHVPhases: Move is not related properly to an FMS ' +
                 'Card.'
                           );
      RETURN (PU_CANCEL);
   ENDIF;  
/*
** If there is a High Voltage phases result then the move was downloaded to
** an operating order and we will display the result that the SSO returned.
** The DO cannot change the data if the SSO entered it.
*/
   PhaseA = '';
   SELECT :PhaseA = PhaseA,
          :PhaseB = PhaseB,
          :PhaseC = PhaseC,
          :Comment = Comment 
   FROM   IR_HVPhases
   WHERE  Job = :JIP.Job;

   IF PhaseA <> '' THEN

      FIELD(text1).Curbias = FB_INVISIBLE;
      FIELD(text2).Curbias = FB_VISIBLE;
      FIELD(cancelbutton).CurBias = FB_DIMMED;
      FIELD(Comment).ParentField.ParentField.Curbias  = FB_VISIBLE;
   ELSE
      PhaseA = 'NO';
   ENDIF; 
/*
** We must complete processing here if we are in automatic execution
*/
   IF AutomaticExecution = TRUE THEN
      IF PhaseA = '' THEN
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                 'PromptHVPhases: Not able to determine which phases ' +
                 'have high voltage. SSO returned blank value.'
                              ); 
         RETURN PU_CANCEL;
      ELSEIF PhaseA = 'NO' AND
             PhaseB = 'NO' AND
             PhaseC = 'NO' AND
             Comment = '' THEN
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                 'PromptHVPhases: All phases marked NO with out a comment being entered.'
                              ); 
         RETURN PU_CANCEL;
      ELSE
         Curframe.SendUserEvent (EventName = 'MakeInvisible');
      ENDIF;
   ENDIF;
END;


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;


ON Click OKButton,
ON USEREVENT 'CompleteProcessing' =
DECLARE
   NewResponse = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /* Confirm if all NO then comment must not be blank */
   IF PhaseA = 'NO' AND
      PhaseB = 'NO' AND
      PhaseC = 'NO' AND
      Comment = '' THEN
      
      MESSAGE 'If all phases are marked ''NO'' a comment must be entered.';
      RESUME;
   ENDIF;     

   NewResponse = '';
   IF PhaseA = 'YES' THEN
      NewResponse = NewResponse + 'A,';
   ENDIF;
   IF PhaseB = 'YES' THEN
      NewResponse = NewResponse + 'B,';
   ENDIF;
   IF PhaseC = 'YES' THEN
      NewResponse = NewResponse + 'C,';
   ENDIF;
   IF NewResponse <> '' THEN
      /* Remove last comma */
      NewResponse = left(NewResponse,(length(NewResponse)-1)) + ' Phase';   
      JIP.Response = NewResponse + ' ' + JIP.Response;
      JIP.ResponseUpd();
      FODMsg = 'Feeder ' + C.FeederName + ' condition traveling on: ' + NewResponse;
      IF Comment <> '' THEN
         FODMsg = FODMsg + ' Comment from SSO: ' + Comment;
      ENDIF;
   ELSE
      FODMsg = 'Feeder ' + C.FeederName + ' other condition: ' + Comment;   
   ENDIF;
   
   IF Comment <> '' THEN
      CALLPROC SOA_LogIns (
           Card = C.Card,
           Job  = JIP.Job,
           SwitchingItem = JIP.SwitchingItem,
           Time = DATE('Now'), 
           UserName = UserName,
           Item = 'HVPhases',
           Old  = 'Other Comment',
           New  = Comment);
      CALLPROC DDB_COMMIT;
   ENDIF;

   /*
   **  Determine which regions to send message.
   */
   FodRegion = '';
   /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
          :FodRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :C.Feeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'fod_' + FODRegion
                                       ,MessageText = FODMsg
                                       ,Time = date('now')
                                       ,Priority = 0
                                       ,MessageType = 0
                                       ,Card = C.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                   'PromptHVPhases: Automated DCC message ' + 
                   'not sent for ' + C.FeederName + ' regarding: ' + FODMsg);
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;
   
   IF C.CardClass = Type$Auto OR C.CardClass = Type$CIOA OR 
       C.CardClass = Type$FOT THEN
   
    RetCode = CALLPROC FRA_HVPhasesIns (
      Card  = C.Card,
      Job   = JIP.Job,
      MoveComplete = IFNULL(JIP.TOComplete,''),
      PhaseA = PhaseA,
      PhaseB = PhaseB,
      PhaseC = PhaseC,
      Comment = Comment);
      
    IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                   VARCHAR(DATE('now')) + ': PromptHVPhases: FRA_HVPhases insert ' + 
                   'failed for ' + C.FeederName);
    ENDIF;
    CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN (PU_OK);
END;

ON Click CancelButton =
BEGIN
   RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
							 *Default Item

							 *Default Item

							 *Default Item


