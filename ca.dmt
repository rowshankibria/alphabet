	Name:            MarkDiagramInvalid

/*
**
**      Copyright c 2020 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC 
**  Procedure:      MarkDiagramInvalid
**
**  Date:   Version Description
** ----------------------------------
**  03/24/20  em    Created
**                  If Feeder2 parameter is included, nust check that both feeders are 
**                  main type=40 feeders.  If they are then look at each for diagram.
**                  If they are not, like if one is an ISO, then we aren't really triggering 
**                  diagram change.
*/
procedure MarkDiagramInvalid
(
   Feeder  = INTEGER NOT NULL,
   Feeder2 = INTEGER NOT NULL WITH DEFAULT 
) =
declare
   FeederDiagram = INTEGER NOT NULL WITH DEFAULT;
   MainFeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeOfFeeder = INTEGER NOT NULL WITH DEFAULT;
   TypeOfFeeder2 = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
   SELECT :TypeOfFeeder = Type
   FROM   Udb_Object
   WHERE  Object = :Feeder;
   /*
   ** For a transfer we make sure both feeders are main feeders before continuing.
   */
   IF Feeder2 > 0 THEN
      SELECT :TypeOfFeeder2 = Type
      FROM   Udb_Object
      WHERE  Object = :Feeder2;
      
      IF TypeOfFeeder <> Type$Feeder OR TypeOfFeeder2 <> Type$Feeder THEN
         RETURN;   /*ISO transfers don't impact diagrams*/
      ENDIF;
   ENDIF;
/*
** Is it a regular feeder or ISO feeder, check if Feeder has a diagram
*/               
   FeederDiagram = 0;                  
   IF TypeOfFeeder = Type$ISOFeeder THEN
      REPEATED
      SELECT :FeederDiagram = G.Grouping,
             :MainFeederName = O.Name
      FROM   Udb_Grouping G,
             Udb_Grouping G1,
             Udb_Object O
      WHERE  G1.Member = :Feeder AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping = G.Member AND
             G.Relationship = :Interaction$ShownOn AND
             G.GroupingType = :Type$FeederDiagram AND
             G.Grouping = O.Object;
   ELSE
      SELECT :FeederDiagram = G.Grouping,
             :MainFeederName = O.Name
      FROM   Udb_Grouping G,
             Udb_Object O
      WHERE  G.Member = :Feeder AND
             G.Relationship = :Interaction$ShownOn AND
             G.GroupingType = :Type$FeederDiagram AND
             G.Grouping = O.Object;
   ENDIF;
   
   IF FeederDiagram > 0 THEN
/*
** Mark Feeder Diagram Invalid
*/
   RetCode = CALLPROC Udb_ObjectValidationUpd (
             Object = FeederDiagram,
             ValidatedBy = '', 
             Validated = DATE('now') );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
         CurProcedure.Trace(Text= VARCHAR(DATE('now')) + 
             MainFeederName + ' Feeder Diagram has been marked invalid.');
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurProcedure.Trace(Text= VARCHAR(DATE('now')) + 
             'Unable to mark feeder diagram invalid for feeder ' + MainFeederName);
      ENDIF;

   ENDIF;
/*
** Do same for Feeder2
*/   
   FeederDiagram = 0;
   IF Feeder2 > 0 THEN
      SELECT :FeederDiagram = G.Grouping,
             :MainFeederName = O.Name
      FROM   Udb_Grouping G,
             Udb_Object O
      WHERE  G.Member = :Feeder2 AND
             G.Relationship = :Interaction$ShownOn AND
             G.GroupingType = :Type$FeederDiagram AND
             G.Grouping = O.Object;
   ENDIF;
   
   IF FeederDiagram > 0 THEN
/*
** Mark Feeder Diagram Invalid
*/
   RetCode = CALLPROC Udb_ObjectValidationUpd (
             Object = FeederDiagram,
             ValidatedBy = '', 
             Validated = DATE('now') );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
         CurProcedure.Trace(Text= VARCHAR(DATE('now')) + 
             MainFeederName + ' Feeder Diagram has been marked invalid.');
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurProcedure.Trace(Text= VARCHAR(DATE('now')) + 
             'Unable to mark feeder diagram invalid for feeder ' + MainFeederName);
      ENDIF;
   ENDIF;
END;

