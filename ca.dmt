/*
**  Application:    cac
**  Frame:          PromptCPMCheckList         
**
**  Modifications:
**  02/03/23   em   Created.  How checklist when called from WPDetails, otherwise immediated exit.
**  04/19/23   em   Attempting to address requested changes from Dave O'Neill.
**  1.	When you access the checklist from the permit details screen, can you lock the window that pops up showing the summary to the front so that it doesn�t go behind all of the other open windows.
**  2.	Can you number the questions? You have them numbered when you get the small prompt window that states you need to enter a note because question #1 is not answered but not on the larger list
**  3.	In the response column you put �All Work Done � SeeChecklist� can you swap that? �See Checklist � All Work Done�
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */
    WPDetail = INTEGER NOT NULL WITH DEFAULT; /* Contains WP Id when called from WP Details. */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF WPDetail = 0 THEN
      RETURN(PU_OK);
   ENDIF;
   
   SELECT :WorkComplete = WorkComplete,
          :TestComplete = TestComplete,
          :PhaseCheckNeeded = PhaseCheckNeeded,
          :ClearancesDisturbed = ClearancesDisturbed,
          :RelaysNormal = RelaysNormal,
          :GroundsRemoved = GroundsRemoved,
          :EquipmentReady = EquipmentReady,
          :Notes = Notes
   FROM   FMS_CPMCheckList
   WHERE  WorkPermit = :WPDetail;
END;

ON CLICK ok_btn =
BEGIN
   RETURN (PU_OK);
END;
