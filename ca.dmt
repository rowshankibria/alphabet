Application Component Report
============================

	Name:            HighpotIssue

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          HighPotIssue    
**
**  03/21/00  py    Frame created     
**  08/04/00  em    If move incompleted, high pot test criteria will remain.
**                  When re-issuing, will get duplicate key on insert trying
**                  to insert crieria again.  Therefore, before insert of 
**                  criteria, we will delete - and anything that might exist
**                  will be deleted.  Must do same for hi pot test equipment.  
**  01/06/03  em    Convert Job to JIP     
**  05/02/03  em    Made Cancel button invisible on front of screen to avoid
**                  HV status from getting out of whack if user, opts to cancel
**                  in midstream of JobActions.
**  07/17/05  em    Add Phase to test criteria
**  08/19/05  em    Update move text if testing individual phase.
*/

INITIALIZE
(
    JIP = JobInProgress;			  /* Job being processed */
    HiPotType = Integer NOT NULL;           /* hi pot or modified hi pot */

    i = INTEGER NOT NULL;              
    RetCode = INTEGER NOT NULL; 
    PrimaryEquip = VARCHAR(20) NOT NULL;
    CurSubstation = VARCHAR(20) NOT NULL;
) =
BEGIN
   CurSubstation = JIP.Substationname;
   PrimaryEquip = JIP.Equipname;
/*
** Determine High Pot Type
*/
   IF HiPotType = 1 THEN
      field(Title).TextLabel = 'High Pot Test Criteria for Primary Equipment ' + PrimaryEquip + HC_NEWLINE + ' at Substation ' + CurSubstation;
   ELSEIF HiPotType = 2 THEN 
      field(Title).TextLabel = 'Modified High Pot Test Criteria for Primary Equipment ' + PrimaryEquip + HC_NEWLINE + ' at Substation ' + CurSubstation;
   ELSE
      message 'Unknown High Pot Test Type ... Unable to continue';
      RETURN (PU_CANCEL);
   ENDIF;

   AddEquip.Clear();

/* 
** Select equipments within the substation 
*/
   SelectEquip.Clear();
   i = 1;
   REPEATED
   SELECT  :SelectEquip[i].Equip = O.Object, 
           :SelectEquip[i].EquipName = O.Name,
           :SelectEquip[i].EquipClass  = O.Type,
           :SelectEquip[i].EquipClassName  = O.TypeName,
           :SelectEquip[i].ObjectDescription = O.Description
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_ExtendedType E
   WHERE   G.Grouping = :JIP.Substation AND
           G.Relationship = :Interaction$MemberOf AND
           O.Object = G.Member AND
           E.SuperType = :Type$Conducting AND
           E.Type NOT IN (SELECT Type
                          FROM Udb_ExtendedType
                          WHERE SuperType IN (:Type$Line, :Type$Feeder, :Typename$BusSect)) AND 
           G.MemberType = E.Type AND
           O.Object <> :JIP.Equip       
   ORDER BY EquipClassName, EquipName     
   BEGIN
      i = i + 1;
   END;
END;


ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   AddEquip.InsertRow(Rownumber = AddEquip.LastRow() + 1,
                      RowObject = SelectEquip[].Duplicate());
   SelectEquip.RemoveRow(Rownumber = Field(SelectEquip).CurRow);   
END;


ON ChildEntry AddEquip =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   SelectEquip.InsertRow(Rownumber = SelectEquip.LastRow() + 1,
                         RowObject = AddEquip[].Duplicate());   
   AddEquip.RemoveRow(Rownumber = Field(AddEquip).CurRow);
END;

  

ON Click OK_Btn =
BEGIN
/*
** Delete in case we incompleted a previous issue.
*/
   RetCode = CALLPROC SOA_HiPotTestCriteriaDel (Job = JIP.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message ('Error deleting Hi Pot test criteria.');
      RESUME;
   ENDIF;
   RetCode = CALLPROC SOA_HiPotTestEquipDel (Job = JIP.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message ('Error deleting Hi Pot test equipment.');
      RESUME;
   ENDIF;
/*
** Save criteria in table to compare when job is complete
*/
   RetCode = CALLPROC SOA_HiPotTestCriteriaIns (Job = JIP.Job, 
                                                Phase = PhaseCriteria,
                                                HipotType = HipotType,
                                                Equipkv = Equipkv,
                                                TestTypekv = TestTypekv,
                                                Duration = Duration,
                                                Maxma = Maxma);
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message ('Error insert SOA Hi Pot test criteria. Please try again or contact your technical support');
         RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;                            
/*
** Insert primary equipment in Hi Pot Equipment table
*/
   
   Retcode = CALLPROC SOA_HiPotTestEquipIns (Job = JIP.Job,
                                     HipotType  = HipotType,
                                     EquipType  = JIP.EquipClassName,
                                     EquipName  = JIP.EquipName,
                                     Equip      = JIP.Equip);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message ('Error insert Additional Equipment List. Please try again or contact your technical support');
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT; 

/*
** Insert additional equipment in Hi Pot Equipment table
*/
   IF AddEquip.LastRow() > 0 THEN
      FOR i = 1 TO AddEquip.LastRow() DO
         Retcode = CALLPROC SOA_HiPotTestEquipIns (Job = JIP.Job,
                                        HipotType  = HipotType,
                                        EquipType  = AddEquip[i].EquipClassName,
                                        EquipName  = AddEquip[i].EquipName,
                                        Equip      = AddEquip[i].Equip);

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message ('Error insert Additional Equipment List. Please try again or contact your technical support');
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;      
      ENDFOR;
   ENDIF;
/*
** Update Move Text if for individual Phase.
*/
   IF PhaseCriteria <> 'ALL' THEN
      RetCode = CALLPROC SOA_JobMoveTextUpd (
			TOMove = JIP.TOMove + ': ' + 
                                 PhaseCriteria + ' Phase Only',
			RSMove = JIP.RSMove + ': ' + 
                                 PhaseCriteria + ' Phase Only',
			Job    = JIP.Job);
      IF Retcode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Move text was not successfully updated with phase.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
      
   RETURN (PU_OK);
END;


ON CLICK menu.file.cls,
ON ClICK CancelButton =
BEGIN
    RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
    RESUME;
END;
