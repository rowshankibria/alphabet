**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          WorkPermit_ASE
**
**  Date:       Version Description
** ----------------------------------
**  02/15/02    pkw     Created; 
**  05/05/02    ysp     Change constants to new values.
**  07/22/02    pkw     Change j.card reference from soa_job to soa_jobcontrol.
**  09/27/02    ysp     Merge: removed obsolete attributes from WP array.
**  02/04/03    ysp     Added MoveEquipClass to the Work Permimt moves.
**  02/19/03    em      For FMS, load permits and protections independent
**                      of card and card type
**  02/25/03    em      Modified call to LoadProtectionMove to utilize
**                      generic include script.
**  03/05/03    em      If protection move has been deleted, a blank protection
**                      link appears on the establish permit screen.
**                      If no row is selected, do not display the link.
**  03/21/03    em      On a closed card, load all permits with status other 
**                      than 'Del'
**  07/14/03    pkw     Added LoadSOA_WP class.
**  07/21/03    ysp     Add IsWorkPermit attribute to LoadSOA_WP method
**  09/10/03    pkw     Add LoadWP_LocTags to load all locations and tags for 
**                      a given workpermit.
**  03/24/05    em      Load closed SDS permits from active table
**  09/01/05    em      MoveEquipClass was not being loaded for SOA Work Permits.
**  12/19/05    ysp     Load EquipClass from soa_archiveJob table because MoveEquipClass 
**                      is not defined in this table.
**  03/15/07    em      Add SwitchingItem to Select
**  04/10/07    ysp     ITC203: Remove Move$Filtered as a job status.
**  09/20/08    pkw     Add filter by equip and outage.
**  02/20/15    em      Add PrePost and Seq attributes to protection move selection. 
**                      PrePost will only be used in DSO. DSO Cards are not being archived
**                      so archive table selects are not changed to include PrePost.
**  02/24/15    pkw     add order by to protection select.
**  12/19/16    em      Include Substation attribute for all selects from SOA_Job.
**  12/30/16    ysp     Fix the bug introduced by the previous fix: get equipment's substation 
**                      from the grouping table instead of the archived job table.
**  11/16/17    em      Include MoveRules attribute in select from job
**  02/19/19    pkw     Update LoadSOA_WP method to handle filteroutage = 3.
**  08/08/19    pkw     When showing outstanding work permits don't show WP that has been issued.
**  12/11/19    pkw     Add SortAttribute to select
*/ 
METHOD LoadWorkPermits (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;

   RowFound = INTEGER NOT NULL WITH DEFAULT; /*Used to search for prot moves*/
   ProtectionRequired = INTEGER NOT NULL;
   PPL = ARRAY of WorkPermitProtection;               /*Permit Protections*/
   PM = Generic_Job DEFAULT NULL;       /*Single Protection Move Select */ 
   SortAttribute = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all division types.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.SortByRSComplete = TRUE THEN
      SortAttribute = 'RSComplete';
   ELSE
      SortAttribute = 'Seq';
   ENDIF;
   
   CurObject.WP.Clear();
   i = 1;

   IF CurObject.ArchiveCard = FALSE THEN

      SELECT :CurObject.WP[i].CardType = :Type$FMSApp,
             :CurObject.WP[i].CardTypeName = 'FMS',                
             :CurObject.WP[i].CardName = C.FeederName,
             :CurObject.WP[i].CardStatus = '',
             :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Card = JC.Card,
             :CurObject.WP[i].Seq = JC.Seq,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].MoveEquipClass = JC.MoveEquipClass,
             :CurObject.WP[i].PrintID = JC.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].Subsordesk = C.SubstationName,
             :CurObject.WP[i].Substation = J.Substation,
             :CurObject.WP[i].StepPair = JC.StepPair,
             :CurObject.WP[i].MoveType = J.MoveType,
             :CurObject.WP[i].TOMove = J.TOMove,
             :CurObject.WP[i].TOMoveRules = J.TOMoveRules,
             :CurObject.WP[i].TOOperator = J.TOOperator,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSMoveRules = J.RSMoveRules,
             :CurObject.WP[i].RSOperator = J.RSOperator,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].Response = J.Response,
             :CurObject.WP[i].ActivityIdentifier = J.ActivityIdentifier,
             :CurObject.WP[i].MoveFGColor = J.MoveFGColor,
             :CurObject.WP[i].IsWorkPermit = 1
      FROM   SOA_Job J,
             SOA_JobControl JC,
             FMS_Card C
/*
** Job$OPC allows view of completion papers on closed cards.
*/
      WHERE  C.Card = :CurObject.Card AND
             JC.Card = C.Card AND
             JC.Job = J.Job AND
             J.Status IN ('',:Job$OPC) AND
             JC.StepPair = :StepHeading$OTW AND
             J.JobClass <> 0
      ORDER BY :SortAttribute
      BEGIN
         IF CurObject.FilterOutage <> 0 THEN
            IF CurObject.FilterOutage = 1 THEN /* Show only OTW */
               IF CurObject.WP[i].ToIssued IS NULL OR
                  CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                                    
               ENDIF;
            ELSEIF CurObject.FilterOutage = 2 THEN /* Show Outstanding only */
               IF CurObject.WP[i].RSComplete IS NOT NULL OR
                  CurObject.WP[i].TOIssued IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                  
               ENDIF;
            ENDIF;
         ENDIF;
         
         IF CurObject.FilterEquip <> 0 THEN
            j = 0;
            SELECT :j = COUNT(*)
            FROM    FMS_WorkPermitProtection WPP,
                    SOA_Job J
            WHERE   WPP.PermitJobId = :CurObject.WP[i].Job AND
                    WPP.ProtectionJobId = J.Job AND
                    J.Equip = :CurObject.FilterEquip;
            IF j = 0 THEN
               CurObject.WP.RemoveRow(RowNumber = i);
               CONTINUE;
            ENDIF;
         ENDIF;

         j = i;
/*
** Set the work permit attributes.  
** i index governs row in displayed tablefield.
** j index governs the current work permit.
** k index governs the protection per permit.
*/
/*
** Get ProtectionRequired value from FMS_WorkPermit    
*/
         ProtectionRequired = 1;
         SELECT :ProtectionRequired = ProtectionRequired
         FROM FMS_WorkPermit
         WHERE PermitJobId = :CurObject.WP[j].Job;
         
         CurObject.WP[j].MoveFGColor = ProtectionRequired;
/*
** Get the list of Protection Links for this permit.
** Scroll throught the List and retrieve only those that are necessary.
*/
         k = 1;
         PPL.Clear();
         REPEATED 
         SELECT  :PPL[k].PermitCardType 	= PermitCardType
                ,:PPL[k].PermitJobID    	= PermitJobID
                ,:PPL[k].PermitCard		= PermitCard
                ,:PPL[k].ProtectionCardType 	= ProtectionCardType
                ,:PPL[k].ProtectionJobID    	= ProtectionJobID
                ,:PPL[k].ProtectionCard	    	= ProtectionCard
                ,:PPL[k].PrePost	    	= PrePost
                ,:PPL[k].Seq		    	= Seq
         FROM   FMS_WorkPermitProtection
         WHERE  PermitJobID = :CurObject.WP[j].Job 
            AND PermitCardType = 0    /* Avoids conflicts with TLS Job IDs */
         ORDER BY Seq
         BEGIN
            k = k + 1;
         END;

         i = i + 1;
         FOR k = 1 TO PPL.LastRow() DO
             PM = NULL;
             PM = Generic_Job.Create();

#INCLUDE LoadProtectionMove
              
             IF PM.CardTypeName <> '' THEN  /*Only show move if it was loaded*/
                PM.Prepost = PPL[k].PrePost;
                PM.Seq = PPL[k].Seq;
                CurObject.WP[i] = PM.Duplicate();
                i = i + 1;
             ENDIF;
         ENDFOR;

      END;

    ELSE
/*
** Look for Archived Work Permits
*/
      SELECT :CurObject.WP[i].CardType = :Type$FMSApp,
             :CurObject.WP[i].CardTypeName = 'FMS',                
             :CurObject.WP[i].CardName = C.FeederName,
             :CurObject.WP[i].CardStatus = 'Cls',
             :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Card = J.Card,
             :CurObject.WP[i].Seq = J.Seq,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].MoveEquipClass = J.MoveEquipClass, 
             :CurObject.WP[i].PrintID = J.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].Subsordesk = C.SubstationName,
             :CurObject.WP[i].Substation = 0,                  // archive table does not have Substation
             :CurObject.WP[i].StepPair = J.StepPair,
             :CurObject.WP[i].MoveType = J.MoveType,
             :CurObject.WP[i].TOMove = J.TOMove,
             :CurObject.WP[i].TOOperator = J.TOOperator,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSOperator = J.RSOperator,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].Response = J.Response,
             :CurObject.WP[i].ActivityIdentifier = J.MoveOrigin,
             :CurObject.WP[i].MoveFGColor = J.Colors,
             :CurObject.WP[i].IsWorkPermit = 1
      FROM     FMS_ArchiveJob J,
               FMS_ArchiveCard C
      WHERE    C.Card = :CurObject.Card AND
             J.Card = C.Card AND
             J.Status <> 'Del' AND
             J.StepPair = :StepHeading$OTW AND
             J.JobClass <> 0
      ORDER BY :SortAttribute
      BEGIN
         IF CurObject.WP[i].Equip > 0 THEN
            SELECT :CurObject.WP[i].Substation = Grouping
            FROM   UDB_Grouping 
            WHERE  Member = :CurObject.WP[i].Equip AND
                   RelationShip = :Interaction$MemberOf AND
                   GroupingType IN (SELECT Type 
                                    FROM   UDB_ExtendedType 
                                    WHERE  SuperType = :Type$Substation);
         ENDIF;
         
         IF CurObject.FilterOutage <> 0 THEN
            IF CurObject.FilterOutage = 1 THEN /* Show only OTW */
               IF CurObject.WP[i].ToIssued IS NULL OR
                  CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                                    
               ENDIF;
            ELSEIF CurObject.FilterOutage = 2 THEN /* Show Outstanding only */
               IF CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                  
               ENDIF;
            ENDIF;
         ENDIF;
         
         IF CurObject.FilterEquip <> 0 THEN
            j = 0;
            SELECT :j = COUNT(*)
            FROM    FMS_ArchiveWPProtection WPP,
                    FMS_ArchiveJob J
            WHERE   WPP.PermitJobId = :CurObject.WP[i].Job AND
                    WPP.ProtectionJobId = J.Job AND
                    J.Equip = :CurObject.FilterEquip;
            IF j = 0 THEN
               CurObject.WP.RemoveRow(RowNumber = i);
               CONTINUE;
            ENDIF;
         ENDIF;
         
         j = i;
/*
** Set the work permit attributes.  
** i index governs row in displayed tablefield.
** j index governs the current work permit.
** k index governs the protection per permit.
*/
/*
** Get the list of Protection Links for this permit.
** Scroll throught the List and retrieve only those that are necessary.
*/
         k = 1;
         PPL.Clear();
         REPEATED 
         SELECT  :PPL[k].PermitCardType 	= PermitCardType
                ,:PPL[k].PermitJobID    	= PermitJobID
                ,:PPL[k].PermitCard		= PermitCard
                ,:PPL[k].ProtectionCardType 	= ProtectionCardType
                ,:PPL[k].ProtectionJobID    	= ProtectionJobID
                ,:PPL[k].ProtectionCard	    	= ProtectionCard
         FROM   FMS_ArchiveWPProtection
         WHERE  PermitJobID = :CurObject.WP[j].Job
            AND PermitCardType = 0    /* Avoids conflicts with TLS Job IDs */
         BEGIN
            k = k + 1;
         END;

         i = i + 1;
         FOR k = 1 TO PPL.LastRow() DO
             PM = NULL;
             PM = Generic_Job.Create();

#INCLUDE LoadProtectionMove

             IF PM.CardTypeName <> '' THEN  /*Only show move if it was loaded*/
                CurObject.WP[i] = PM.Duplicate();
                i = i + 1;
             ENDIF;
         ENDFOR;

      END;    

    ENDIF;
    CALLPROC DDB_ROLLBACK;
   
    RETURN;
END;


METHOD LoadSOA_WP (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;

   RowFound = INTEGER NOT NULL WITH DEFAULT; /*Used to search for prot moves*/
   ProtectionRequired = INTEGER NOT NULL;
   PPL = ARRAY of WorkPermitProtection;               /*Permit Protections*/
   PM = Generic_Job DEFAULT NULL;       /*Single Protection Move Select */ 
   SortAttribute = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Work Permit Protections.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.SortByRSComplete = TRUE THEN
      SortAttribute = 'RSComplete';
   ELSE
      SortAttribute = 'Seq';
   ENDIF;

    CurObject.WP.Clear();
    i = 1;

    IF CurObject.ArchiveCard = FALSE OR CurrentApplication = Application$SDS THEN

      REPEATED
      SELECT :CurObject.WP[i].CardType = 0,
             :CurObject.WP[i].CardTypeName = '',                
             :CurObject.WP[i].CardName = '',
             :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].SwitchingItem = JC.SwitchingItem,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Seq = JC.Seq,
             :CurObject.WP[i].Card = JC.Card,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].MoveEquipClass = JC.MoveEquipClass,
             :CurObject.WP[i].PrintID = JC.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].SubsOrDesk = O.NAME,
             :CurObject.WP[i].Substation = J.Substation,
             :CurObject.WP[i].StepPair = JC.StepPair,
             :CurObject.WP[i].TOMove = J.TOMove,
             :CurObject.WP[i].TOMoveRules = J.TOMoveRules,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSMoveRules = J.RSMoveRules,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].Movefgcolor = J.MovefgColor,
             :CurObject.WP[i].IsWorkPermit = 1             
      FROM   SOA_Job J,
             SOA_JobControl JC,
             Udb_Object O
      WHERE  JC.Card = :CurObject.Card AND
             JC.SwitchingItem = :CurObject.SwitchingItem AND
             JC.StepPair = :CurObject.PermitType AND 
             JC.Job = J.Job AND
             J.Status IN ('',:JobStatus$NIS,:JobStatus$Table) AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Substation = O.Object
             
      ORDER BY :SortAttribute
      BEGIN
         IF CurObject.FilterOutage <> 0 THEN
            IF CurObject.FilterOutage = 1 THEN /* Show only OTW */
               IF CurObject.WP[i].ToIssued IS NULL OR
                  CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                                    
               ENDIF;
            ELSEIF CurObject.FilterOutage = 2 THEN /* Show Outstanding only */
               IF CurObject.WP[i].RSComplete IS NOT NULL OR
                  CurObject.WP[i].TOIssued IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                  
               ENDIF;
            ELSEIF CurObject.FilterOutage = 3 THEN /* Show Complete/Incomplete only with no Protection moves */
               /*
               ** Check ReturnStatus
               */
               CurObject.WP[i].ReturnStatus = '';
               SELECT :CurObject.WP[i].ReturnStatus = ReturnStatus,
                      :CurObject.WP[i].ReturntoService = ReturnToService,
                      :CurObject.WP[i].ProtectionRequired = ProtectionRequired
               FROM SOA_WorkPermit
               WHERE PermitJobId = :CurObject.WP[i].Job AND
                     ReturnStatus IN ('COMPLETE','INCOMPLETE');

               IF CurObject.WP[i].ReturnStatus = '' THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
               ELSE
                  i = i + 1;
               ENDIF;
               CONTINUE; 
            ENDIF;
         ENDIF;
         
         IF CurObject.FilterEquip <> 0 THEN
            j = 0;
            SELECT :j = COUNT(*)
            FROM    FMS_WorkPermitProtection WPP,
                    SOA_Job J
            WHERE   WPP.PermitJobId = :CurObject.WP[i].Job AND
                    WPP.ProtectionJobId = J.Job AND
                    J.Equip = :CurObject.FilterEquip;
            IF j = 0 THEN
               CurObject.WP.RemoveRow(RowNumber = i);
               CONTINUE;
            ENDIF;
         ENDIF;
         j = i;
/*
** Get ProtectionRequired value from SOA_Workpermit
*/
         CurObject.WP[j].ProtectionRequired = 1;
         SELECT :CurObject.WP[j].ProtectionRequired = ProtectionRequired
         FROM SOA_WorkPermit
         WHERE PermitJobId = :CurObject.WP[j].Job;
/*
** Get the list of Protection Links for this permit.
** Scroll throught the List and retrieve only those that are necessary.
*/
         k = 1;
         PPL.Clear();
         REPEATED 
         SELECT  :PPL[k].PermitCardType 	= PermitCardType
                ,:PPL[k].PermitJobID    	= PermitJobID
                ,:PPL[k].PermitCard		= PermitCard
                ,:PPL[k].ProtectionCardType 	= ProtectionCardType
                ,:PPL[k].ProtectionJobID    	= ProtectionJobID
                ,:PPL[k].ProtectionCard	    	= ProtectionCard
                ,:PPL[k].PrePost	    	= PrePost
                ,:PPL[k].Seq		    	= Seq
         FROM   FMS_WorkPermitProtection
         WHERE  PermitJobID = :CurObject.WP[j].Job 
            AND PermitCardType = 0    /* Avoids conflicts with TLS Job IDs */
         ORDER BY Seq
         BEGIN
            k = k + 1;
         END;

         i = i + 1;
         FOR k = 1 TO PPL.LastRow() DO
             PM = NULL;
             PM = Generic_Job.Create();

#INCLUDE LoadProtectionMove

             IF PM.CardTypeName <> '' THEN  /*ignore if blank, may be deleted*/
                PM.Prepost = PPL[k].PrePost;
                PM.Seq = PPL[k].Seq;
                CurObject.WP[i] = PM.Duplicate();
                i = i + 1;
             ENDIF;
         ENDFOR;
        
      END;

    ELSE   /*Look at Archive tables */
   
      REPEATED
      SELECT :CurObject.WP[i].CardType = 0,
             :CurObject.WP[i].CardTypeName = '',                
             :CurObject.WP[i].CardName = '',
             :CurObject.WP[i].CardStatus = 'Closed',
             :CurObject.WP[i].Job = J.Job,
             :CurObject.WP[i].SwitchingItem = J.SwitchingItem,
             :CurObject.WP[i].Seq = J.Seq,
             :CurObject.WP[i].Status = J.Status,
             :CurObject.WP[i].JobClass = J.JobClass,
             :CurObject.WP[i].Card = J.Card,
             :CurObject.WP[i].Equip = J.Equip,
             :CurObject.WP[i].EquipClass = J.EquipClass,
             :CurObject.WP[i].EquipClassName = J.EquipClassName,
             :CurObject.WP[i].MoveEquipClass = J.EquipClass,
             :CurObject.WP[i].PrintID = J.PrintID,
             :CurObject.WP[i].EquipName = J.EquipName,
             :CurObject.WP[i].SubsOrDesk = O.NAME,
             :CurObject.WP[i].Substation = J.Substation,
             :CurObject.WP[i].StepPair = J.StepPair,
             :CurObject.WP[i].TOMove = J.TOMove,
             :CurObject.WP[i].TOIssued = J.TOIssued,
             :CurObject.WP[i].TOComplete = J.TOComplete,
             :CurObject.WP[i].RSMove = J.RSMove,
             :CurObject.WP[i].RSIssued = J.RSIssued,
             :CurObject.WP[i].RSComplete = J.RSComplete,
             :CurObject.WP[i].IsWorkPermit = 1
      FROM     SOA_ArchiveJob J,
               Udb_Object O
      WHERE    J.Card = :CurObject.Card AND
               J.SwitchingItem = :CurObject.SwitchingItem AND
               J.Status = '' AND
               J.StepPair = :CurObject.PermitType AND 
               J.MoveCategory = :MoveCategory$Normal AND
               J.Substation = O.Object
      ORDER BY :SortAttribute
      BEGIN
         IF CurObject.FilterOutage <> 0 THEN
            IF CurObject.FilterOutage = 1 THEN /* Show only OTW */
               IF CurObject.WP[i].ToIssued IS NULL OR
                  CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                                    
               ENDIF;
            ELSEIF CurObject.FilterOutage = 2 THEN /* Show Outstanding only */
               IF CurObject.WP[i].RSComplete IS NOT NULL THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
                  CONTINUE;                  
               ENDIF;
            ELSEIF CurObject.FilterOutage = 3 THEN /* Show Complete/Incomplete only with no Protection moves */
               /*
               ** Check ReturnStatus
               */
               CurObject.WP[i].ReturnStatus = '';
               SELECT :CurObject.WP[i].ReturnStatus = ReturnStatus,
                      :CurObject.WP[i].ReturntoService = ReturnToService,
                      :CurObject.WP[i].ProtectionRequired = ProtectionRequired
               FROM SOA_ArchiveWorkPermit
               WHERE PermitJobId = :CurObject.WP[i].Job AND
                     ReturnStatus IN ('COMPLETE','INCOMPLETE');

               IF CurObject.WP[i].ReturnStatus = '' THEN
                  CurObject.WP.RemoveRow(RowNumber = i);
               ELSE
                  i = i + 1;
               ENDIF;
               CONTINUE; 
            ENDIF;
         ENDIF;
         
         IF CurObject.FilterEquip <> 0 THEN
            j = 0;
            SELECT :j = COUNT(*)
            FROM    FMS_ArchiveWPProtection WPP,
                    SOA_ArchiveJob J
            WHERE   WPP.PermitJobId = :CurObject.WP[i].Job AND
                    WPP.ProtectionJobId = J.Job AND
                    J.Equip = :CurObject.FilterEquip;
            IF j = 0 THEN
               CurObject.WP.RemoveRow(RowNumber = i);
               CONTINUE;
            ENDIF;
         ENDIF;
         j = i;
/*
** Get the list of Protection Links for this permit.
** Scroll throught the List and retrieve only those that are necessary.
*/
         k = 1;
         PPL.Clear();
         REPEATED 
         SELECT  :PPL[k].PermitCardType 	= PermitCardType
                ,:PPL[k].PermitJobID    	= PermitJobID
                ,:PPL[k].PermitCard		= PermitCard
                ,:PPL[k].ProtectionCardType 	= ProtectionCardType
                ,:PPL[k].ProtectionJobID    	= ProtectionJobID
                ,:PPL[k].ProtectionCard	    	= ProtectionCard
         FROM   FMS_ArchiveWPProtection
         WHERE  PermitJobID = :CurObject.WP[j].Job 
            AND PermitCardType = 0    /* Avoids conflicts with TLS Job IDs */
         BEGIN
            k = k + 1;
         END;

         i = i + 1;
         FOR k = 1 TO PPL.LastRow() DO
             PM = NULL;
             PM = Generic_Job.Create();

#INCLUDE LoadProtectionMove

             IF PM.CardTypeName <> '' THEN  /*ignore if blank, may be deleted*/
                CurObject.WP[i] = PM.Duplicate();
                i = i + 1;
             ENDIF;
         ENDFOR;
      END;

    ENDIF;
    CALLPROC DDB_ROLLBACK;
    RETURN;
END;


METHOD LoadWP_LocTags (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all Locations and Tags for a given Work Permit.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 1;
   CurObject.LT.Clear();
   SELECT :CurObject.LT[i].LocationStructure = LocationStructure
         ,:CurObject.LT[i].LocationStreet = LocationStreet
         ,:CurObject.LT[i].LocationStatus = LocationStatus
         ,:CurObject.LT[i].WorkSummary = WorkSummary
         ,:CurObject.LT[i].WPLocation = WPLocation
         ,:CurObject.LT[i].XferToRFP = XferToRFP
         ,:CurObject.LT[i].XferToISO = XferToISO
   FROM   IR_WorkLocation
   WHERE  WorkPermit = :CurObject.WorkPermit
   BEGIN
      IF CurObject.LT[i].XferToRFP > 0  THEN
         CurObject.LT[i].Xfer = 'X';
      ELSE
         CurObject.LT[i].Xfer = '';            
      ENDIF;

      j = 1;
      SELECT :CurObject.LT[i].Tags[j].TagType = TagType         
            ,:CurObject.LT[i].Tags[j].TagNumber = TagNumber         
            ,:CurObject.LT[i].Tags[j].TagDisposition = TagDisposition
            ,:CurObject.LT[i].Tags[j].Phases = Phases     
            ,:CurObject.LT[i].Tags[j].BrassTag = BrassTag
            ,:CurObject.LT[i].Tags[j].PlasticTag = PlasticTag
            ,:CurObject.LT[i].Tags[j].TagNotes = TagNotes
      FROM   IR_WorkLocationTag
      WHERE  WorkPermit = :CurObject.WorkPermit AND
             WPLocation = :CurObject.LT[i].WPLocation
      BEGIN
         j = j + 1;
      END;
      i = i + 1;
   END;

   CALLPROC DDB_ROLLBACK;
   RETURN;
END;


Application Component Report
============================

	Name:            WorkPermitClass


Application Component Report
============================

	Name:            WorkPermitClearCheck

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          WorkPermitClearCheck
**
**  Date:       Author   Description
** ----------------------------------
**  11/02/98	EM       Based on previous versions.
**  11/05/98    em       Permit Links from FMS/TLS will set Protection Card
**                       and Card Type values to non-zero values.
**  09/06/01    em       Work Permit Protection enhancement.
**  06/09/02    pkw      Comment out protectioncardtype and protectioncard in
**                       soa select.
**  11/06/02    pkw      Merge FMS_WPPClearCheck into this frame.
**  02/24/03    em       Card and CardType fields are 0 for FMS also; post-Merge
**  09/27/07    em       For Steam, make sure all work permits are clear if this is a
**                       Turn-On or Pressurize move.
**  10/04/07    em       Added additional step heading for SDS.
**  10/29/08    em       Include Job Status NIS in certain select stmts.
**  01/04/11    em       Remove use of Carddetails.Feeder for 3G
**  02/20/15    em       Add qualification for DSO PrePost = 1 (After)
**  12/28/15    em       For UGSpear permit, permit is issued/completed on 
**                       takeout side.
**
*/
PROCEDURE WorkPermitClearCheck
(
    Job 	= INTEGER NOT NULL;  /* Passed Job - Protection Move */ 
    Card        = INTEGER NOT NULL;  /* Passed Card - for Warning*/
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT; /*Passed Item for warning*/
    FGOCheck = INTEGER NOT NULL;     /* Look for FGO on FMS */
    Online = INTEGER;                /* scratch counter */
    RetCode = INTEGER;               /* Return Code*/
    ProcRetCode = INTEGER NOT NULL;           /* Return Code */ 
    Name = VARCHAR(80) NOT NULL WITH DEFAULT;  /*CardName*/
    PermitJC = INTEGER NOT NULL WITH DEFAULT;
    PermitTOComplete = DATE;
) =
BEGIN
   ProcRetCode = PU_OK;
/*
** For Steam, look for outstanding work permits if move is Turn-On or Pressurize
*/
    IF CurrentApplication = Application$SDS THEN  
  /* re-using existing step heading constants that match the same numbers
     used within SDS */

       Online = 0;
       SELECT :Online = Job
       FROM   SOA_JobControl
       WHERE  Job = :Job AND
              Card = :Card AND
              StepPair IN  (:StepHeading$Deload, 
                            :StepPair$DeEnergize, 
                            :StepHeading$ISO);
       
       IF Online > 0 THEN
          Online = 0;
          REPEATED
          SELECT :Online = COUNT(J.Job)
          FROM   SOA_Job J,
                 SOA_JobControl JC
          WHERE  JC.Card = :Card AND
                 JC.StepPair = :StepHeading$WorkPermit AND 
                 JC.Job = J.Job AND
                 J.Status IN ('',:JobStatus$NIS) AND 
                 J.MoveCategory = :MoveCategory$Normal AND
                 J.TOIssued IS NOT NULL AND
                 J.RSComplete IS NULL;

          IF Online > 0 THEN
                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'Turn-On or Pressurize moves should not be issued until UIDs are ' +
                               'complete.');
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   RETURN(Warning$Overridden);
                ENDIF;
          ENDIF;
       ENDIF;   
       RETURN(PU_OK);
    ENDIF;
/* 
** Check SOA work permit moves; must be on active card or sw item 
*/
   Online = 0;
   Name = '';
   REPEATED
   SELECT :Name = AC.CardName,
          :PermitJC = J.JobClass,
          :PermitTOComplete = J.TOComplete
   FROM   SOA_Job J,
          SOA_ActiveCard AC,
          FMS_WorkPermitProtection WPP
   WHERE  WPP.ProtectionJobID = :Job
     AND  WPP.ProtectionCardType = 0   /* Non-TLS */
     AND  WPP.PermitCardType = 0   /* Non-TLS */
     AND  WPP.PermitJobID = J.Job
     AND (WPP.PrePost = 1 OR
          AC.Application <> :Application$DSO)
     AND  J.ControlCard = AC.Card     
     AND  J.Status IN ('',:JobStatus$NIS) 
     AND  J.SwItemStatus < :Card$Closed
     AND  J.TOIssued IS NOT NULL 
     AND  J.RSComplete IS NULL
   BEGIN
      IF PermitJC = JobClass$UGSpear THEN
         IF PermitTOComplete IS NULL THEN
            Online = Online + 1;
         ENDIF;
      ELSE
         Online = Online + 1;
      ENDIF;
   END;      
   CALLPROC DDB_ROLLBACK;
      
   IF Online > 0 THEN /*Linked permit still outstanding*/

      IF CurrentApplication = Application$FMS THEN
         FGOCheck = 0;
         /*
         **  Is the feeder in FGO?
         */
         SELECT   :FGOCheck = OS.Status
         FROM     FMS_ObjectStatus OS,
                  TFMS_CardToObject CTO
         WHERE    CTO.Card = :Card AND
                  CTO.Object = OS.Object AND
                  OS.StatusCount > 0 AND
                  OS.Status = :Status$FGO;
         /*
         **  If in FGO, lets get a count of outstanding 
         **  non-FGO impactive permits
         */  
         IF FGOCheck = Status$FGO THEN
            FGOCheck = 0;
            
            REPEATED
            SELECT :FGOCheck = COUNT(*)
            FROM    SOA_Job J,
                    SOA_JobControl JC,
                    SOA_ActiveCard AC,
                    FMS_JobAction JA,
                    FMS_WorkPermitProtection WPP
            WHERE   WPP.ProtectionJobID = :Job
              AND   WPP.ProtectionCardType = 0   /* Non-TLS */
              AND   WPP.PermitCardType = 0   /* Non-TLS */
              AND   WPP.PermitJobID = J.Job 
              AND   J.Status IN ('',:JobStatus$NIS) 
              AND   J.TOIssued IS NOT NULL 
              AND   J.RSComplete IS NULL
              AND   J.Job = JC.Job
              AND   J.COntrolCard = AC.Card 
              AND   AC.Card = JC.Card 
              AND   JA.TypeOfCard = AC.TypeOfCard 
              AND   JA.JobClass = J.JobClass
              AND   JA.StepPair = JC.StepPair
              AND   JA.EquipClass = JC.MoveEquipClass 
              AND   JA.Status = :Prompt$FromWorkFCR; 
              
            IF FGOCheck < Online THEN 
               /*
               ** All permits are not FGO impactive, 
               ** we can display warning
               */
               RetCode  = CALLFRAME Warning 
                       (Card = Card, 
                       Job = Job,
                       SwitchingItem = SwitchingItem,
                       Text = 'This is a Protection Move: ' +
                              'A Work Permit is still outstanding' +
                              ' on Card ' + Name);
               IF RetCode = PU_CANCEL THEN
                  RETURN(PU_CANCEL);
               ELSE
                  ProcRetCode = Warning$Overridden;
               ENDIF;
            ENDIF;    

         ELSE    /*Not FGO, can display warning */      
                   
            RetCode  = CALLFRAME Warning(
                       Card = Card, 
                       Job = Job,
                       SwitchingItem = SwitchingItem,
                       Text = 'This is a Protection Move: ' +
                              'A Work Permit is still outstanding' +
                               ' on Card ' + Name);
            IF RetCode = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               ProcRetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
       
      ELSE
         RetCode  = CALLFRAME Warning (
                      Card = Card, 
                      Job = Job,
                      SwitchingItem = SwitchingItem,
                      Text = 'This is a Protection Move: ' +
                              'A Work Permit is still outstanding ' +
                             'on card: ' + Name);
         IF RetCode = PU_CANCEL THEN
            RETURN(PU_CANCEL);
         ELSE
            ProcRetCode = Warning$Overridden;
         ENDIF;
      ENDIF;
   ENDIF;
/* 
** Check work permit moves in TLS cards 
*/
    Name = '';
    REPEATED
    SELECT :Name = C.LineNumber
    FROM   TC_Job J,
           TC_Card C,
           FMS_WorkPermitProtection WPP
    WHERE  WPP.ProtectionJobID = :Job 
      AND  WPP.ProtectionCardType = 0   /* Non-TLS */
      AND  WPP.PermitCardType = :Type$TLSApp
      AND  WPP.PermitCard = J.Card
      AND  WPP.PermitJobID = J.Job
      AND  C.Card = J.Card
      AND  J.Status = '' 
      AND  C.Status < 4 /*Card may be Active (1) or in PST or Telco status*/
      AND  J.TOIssued IS NOT NULL 
      AND  J.RSComplete IS NULL;
    CALLPROC DDB_ROLLBACK;

    IF Name <> '' THEN
       RetCode  = CALLFRAME Warning (
                       Card = Card, 
                       Job = Job,
                       SwitchingItem = SwitchingItem,
                       Text = 'This is a Protection Move: ' +
                              'A Work Permit is still outstanding ' +
                              'on TLS card: ' + Name);
       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          ProcRetCode = Warning$Overridden;
       ENDIF;
    ENDIF;

    RETURN (ProcRetCode);
END;

