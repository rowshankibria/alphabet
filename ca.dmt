/*=============================================================================================
** code for the diagram
** ============================================================================================
*/
/*
- Source segment is the 1st element in EquipList
- Meaning of EquipList attributes:
  - Node: Node ID during NetworkTrace and node level when finding longest path
  - Terminal: Terminal ID during NetworkTrace and if =1 the equip is on the longest path
  - BaseType: Type$33KVPortion - a portion feeder, 0 - a switch
  - Status: for feeders, 1 = energized, 0 = deenergized.
  - Source: Terminal ID during NetworkTrance and if = 1 the feeder is feeding portions of this main feeder.
*/

PROCEDURE DisplayDiagram (   
) = 
DECLARE
   ColorInt = integer not null with default;    
   BkrImage = RectangleShape DEFAULT NULL;
   EquipLabel = EntryField DEFAULT NULL;
ENDDECLARE
BEGIN 
   SELECT :FeederName = Name
   FROM   UDB_Object
   WHERE  Object = :MainFeeder;
   CALLPROC DDB_ROLLBACK;
   
   CALLPROC ShowFeederAndNavigation();
   
   SELECT :SourceSegment = G.Member
   FROM   UDB_Grouping G
   WHERE  G.Grouping = :MainFeeder AND
          G.Relationship = :Interaction$MemberOf AND
          G.MemberType = :Type$SourceSegment;
   CALLPROC DDB_ROLLBACK;

   IF SourceSegment = 0 THEN
      MESSAGE 'No source segment defined for this feeder';
      RETURN;
   ENDIF;

   SELECT :SourceBreaker.Object = O.Object,
          :SourceBreaker.Name = O.Name,
          :SourceBreaker.Type = O.Type,
          :SourceBreaker.CurrentlyOpen = S.CurrentlyOpen
   FROM   UDB_Grouping G,
          Udb_Object O,
          Udb_Switch S
   WHERE  G.Grouping = :MainFeeder AND
          G.Relationship = :Interaction$SourceBreaker AND
          G.Member = O.Object AND
          O.Object = S.Object;
   CALLPROC DDB_ROLLBACK;
   
   RetCode = CALLPROC NetworkTrace();
   IF RetCode = FALSE THEN
      RETURN;
   ENDIF;
   
   RetCode = CALLPROC GetLongestPath();
   IF RetCode = FALSE THEN
      RETURN;
   ENDIF;

   /* Set feeder status 
   */
   CALLPROC SetFeederStatus();   
/*
** Draw graphic representation of the feeder equipment
*/
   InitDiagramX = 200;
   IF EquipList[1].ConnectedTo.LastRow <= 2 THEN
      InitDiagramY = FIELD(VP).OuterHeight/3;
   ELSE
      InitDiagramY = FIELD(VP).OuterHeight/2;
   ENDIF;
/*
** draw the source breaker
*/   
/* Source Breaker */
   IF SourceBreaker.CurrentlyOpen = 1 THEN
      ColorInt = CC_GREEN;
   ELSE
      ColorInt = CC_RED;
   ENDIF;

   BkrImage = RectangleShape.Create();
   BkrImage.LineWidth = LW_VERYTHIN;
   BkrImage.LineColor = ColorInt; 
   BkrImage.YTop = InitDiagramY - FIELD(BREAKER_TEMPLATE).OuterHeight/2;
   BkrImage.XLeft = InitDiagramX;
   BkrImage.Width = FIELD(BREAKER_TEMPLATE).OuterWidth;
   BkrImage.Height = FIELD(BREAKER_TEMPLATE).OuterHeight;
   BkrImage.BgPattern = FP_SOLID;
   BkrImage.BgColor = ColorInt; 
   BkrImage.ParentField = Field(VP.TemplateObj).ParentField;
   BkrImage.LayerSequence = 3;

   // Breaker Name
   EquipLabel = EntryField.Create();
   EquipLabel.TextValue = SourceBreaker.Name;
   EquipLabel.CharsPerLine = LENGTH(SourceBreaker.Name) + 1;
   EquipLabel.XLeft = InitDiagramX;
   EquipLabel.YTop  = InitDiagramY + FIELD(BREAKER_TEMPLATE).OuterHeight/2 + 50 ;
   EquipLabel.BgColor = CC_WHITE;
   EquipLabel.OutlineWidth = LW_NOLINE;
   EquipLabel.ParentField  = Field(VP.TemplateObj).ParentField;
   EquipLabel.LayerSequence = 1;
   
   CALLPROC DrawSubTree(X = InitDiagramX + BkrImage.OuterWidth,
                        Y = InitDiagramY,
                        Direction = 0,
                        PrevEquipIdx = 0,
                        CurEquipIdx = 1);
END;


PROCEDURE NetworkTrace(
) =
DECLARE
   interrupterTypes    = ARRAY OF INTEGEROBJECT; /* interrupter switch device types*/
   FeederSegmentTypes  = ARRAY OF INTEGEROBJECT; /* feeder segment device types*/   

   Equip1 = ConnectedEquipClass;
   Equip2 = ConnectedEquipClass;
   ExcludedNodes = ARRAY OF INTEGEROBJECT;
   MoreObjects = INTEGER NOT NULL WITH DEFAULT;
   staticwhereclause = VARCHAR(500) NOT NULL WITH DEFAULT;
   dynamicwhereclause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   NextList = ARRAY OF ConnectedEquipClass;
   ReverseTracing = INTEGER NOT NULL WITH DEFAULT;   
   TempEquip = ConnectedEquipClass;
ENDDECLARE
BEGIN
   i = 1;
   SELECT :interrupterTypes[i].Value = Type
   FROM   UDB_ExtendedType
   WHERE  SuperType = :Type$ISOSwitch
   BEGIN
      i = i + 1;
   END;
   
   i = 1;
   SELECT :FeederSegmentTypes[i].Value = Type
   FROM   UDB_ExtendedType
   WHERE  SuperType = :Type$33KVPortion
   BEGIN
      i = i + 1;
   END;
   
   EquipList.Clear();

   SELECT :EquipList[1].Object = O.Object,
          :EquipList[1].Name = O.Name,
          :EquipList[1].Description = O.Description,
          :EquipList[1].Type = O.Type,
          :EquipList[1].TypeName = O.TypeName,
          :EquipList[1].Terminals = O.Terminals,
          :EquipList[1].PrimaryGrouping = O.PrimaryGrouping,
          :EquipList[1].PrimaryGroupingName = O.PrimaryGroupingName,
          :EquipList[1].BaseType = :Type$33KVPortion,
          :EquipList[1].Used = :FALSE
   FROM   Udb_Object O
   WHERE  O.Object = :SourceSegment;
   CALLPROC DDB_ROLLBACK;

/*
** Start at the first segment to trace the feeder until the neighbor feeders
*/
   StaticWhereClause = 'T2.Object = O.Object AND ' + 
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ' +
                        'T1.Object IN (';

   DynamicWhereClause = VARCHAR(EquipList[1].Object) + ')';

   MoreObjects = TRUE;
   WHILE MoreObjects = TRUE DO
      MoreObjects = FALSE;

      /* find all connected equipment. Use ExcludedNodes to avoid retrieving
      ** already-selected equipment.
      */
      IF ExcludedNodes.LastRow > 0 THEN 
         DynamicWhereClause = DynamicWhereClause + ' AND T1.Node NOT IN (';
         k = 1;
         WHILE k <= ExcludedNodes.LastRow() DO
           IF K = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[k].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause +  
                                   ',' + VARCHAR(ExcludedNodes[k].Value);
           ENDIF;

           k = k + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';

         ExcludedNodes.Clear();
      ENDIF;

      DynamicWhereClause = StaticWhereClause + DynamicWhereClause; 

      NextList.Clear();
      j = 1;
      SELECT :NextList[j].Object = T2.Object,
             :NextList[j].Terminal = T2.Terminal,
             :NextList[j].Source = T1.Terminal,
             :NextList[j].Terminals = O.Terminals,
             :NextList[j].BaseType = 0,            // 0 = switch, otherwise = portion feeder
             :NextList[j].Node  = T2.Node,
             :NextList[j].Name = O.Name,
             :NextList[j].Description = O.Description,
             :NextList[j].Type = O.Type,
             :NextList[j].TypeName = O.TypeName,
             :NextList[j].PrimaryGrouping = O.PrimaryGrouping,
             :NextList[j].PrimaryGroupingName = O.PrimaryGroupingName,
             :NextList[j].PrevObject = T1.Object,
             :NextList[j].OutBound = :FALSE,
             :NextList[j].Used = :FALSE
      FROM  Udb_Terminal T1,
            Udb_Terminal T2,
            Udb_Object O
      WHERE :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          ExcludedNodes.InsertRow (RowNumber = j); 
          ExcludedNodes[j].Value = NextList[j].Node;
          j = j + 1;
      END;            
      CALLPROC DDB_ROLLBACK;
      DynamicWhereClause = '';

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      FOR k =1 TO EquipList.LastRow() DO
         IF EquipList[k].Used = FALSE THEN
            RetCode = NextList.Find(AttributeName = 'PrevObject',
                                     Value = EquipList[k].Object);

            IF RetCode = ER_ROWNOTFOUND THEN
               IF EquipList[k].Terminals = 1 THEN                 
                  // OK if single terminal device 
               ELSE 
                  MESSAGE EquipList[k].Name + ' is floating. Please correct the connectivity for the feeder';     
                  RETURN FALSE;
              ENDIF;
            ENDIF;

            EquipList[k].Used = TRUE;
         ENDIF;
      ENDFOR;
      */
      
      j = 1;
      WHILE j <= NextList.LastRow() DO
         RetCode = EquipList.Find(AttributeName = 'object',
                                  Value = NextList[j].Object,
                                  RowNumber = ByRef(k));

         IF RetCode = ER_ROWNOTFOUND THEN  /* new equipment found */
            k = EquipList.LastRow + 1;
            EquipList.InsertRow(Rownumber = k, 
                                RowObject = NextList[j].Duplicate());

            RetCode = InterrupterTypes.Find(AttributeName = 'Value',
                                            Value = EquipList[k].Type);
                                            
            IF  RetCode = ER_OK THEN
               SELECT :EquipList[k].CurrentlyOpen = S.CurrentlyOpen,
                      :EquipList[k].NormalOpen = S.NormalOpen,
                      :EquipList[k].SpecNumber = G.Reference
               FROM   Udb_Switch S,
                      Udb_Grouping G
               WHERE  S.Object = :EquipList[k].Object AND
                      S.Object = G.Member AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Grouping = :EquipList[k].PrevObject;               
            ELSE
               /* If we've reached a feeder segment, check if it is a neighbor feeder
               */
               RetCode = FeederSegmentTypes.Find(AttributeName = 'Value',
                                                 Value = EquipList[k].Type);
               IF RetCode = ER_OK THEN
                  EquipList[k].BaseType = :Type$33KVPortion;
                  
                  IF EquipList[k].PrimaryGrouping = MainFeeder THEN 
                     // continue
                  ELSE 
                     /*
                     ** we are in the neightbor feeder area. 
                     */
                     EquipList[k].Used = TRUE;
                     EquipList[k].OutBound = TRUE;
                     /*
                     ** Try to identify the common interrupter switch (PrevObject) between two main feeders.
                     */
                     RetCode = EquipList.Find(AttributeName = 'Object',
                                               Value = EquipList[k].PrevObject,
                                               RowNumber = ByRef(m));
                     IF RetCode = ER_OK THEN
                        EquipList[m].OutBound = TRUE;
                     ENDIF;
                  ENDIF;
               ENDIF;
            ENDIF;

            RetCode = EquipList.Find(AttributeName = 'object',
                                     Value = EquipList[k].PrevObject,
                                     RowNumber = ByRef(m));
            
            n = EquipList[m].ConnectedTo.LastRow + 1;
            EquipList[m].ConnectedTo[n] = ConnectedObject.Create();
            EquipList[m].ConnectedTo[n].Object = EquipList[k].Object;
            EquipList[m].ConnectedTo[n].RowID = k;
            EquipList[m].ConnectedTo[n].Terminal = EquipList[k].Source;    
            
            n = EquipList[k].ConnectedTo.LastRow + 1;
            EquipList[k].ConnectedTo[n] = ConnectedObject.Create();
            EquipList[k].ConnectedTo[n].Object = EquipList[m].Object;
            EquipList[k].ConnectedTo[n].RowID = m;
            EquipList[k].ConnectedTo[n].Terminal = EquipList[k].Terminal;     // K's Terminal connects to m

            IF EquipList[k].Used = FALSE THEN         
               MoreObjects = TRUE;
               IF DynamicWhereClause = '' THEN
                  DynamicWhereClause = VARCHAR(EquipList[k].Object);
               ELSE
                  DynamicWhereClause = DynamicWhereClause + ',' + VARCHAR(EquipList[k].Object);
               ENDIF;
            ENDIF;
         ENDIF;
         
         j = j + 1;
      ENDWHILE;

      IF MoreObjects = TRUE THEN
        DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;
   ENDWHILE; 

   /*
   ** reset all equip Node and Terminal attributes, which will be used to find longest path
   */
   FOR i = 1 TO EquipList.LastRow DO
      EquipList[i].Node = 0;
      EquipList[i].Terminal = 0;
      EquipList[i].Status = 0;
      EquipList[i].Source = 0;
   ENDFOR;
   
   RETURN TRUE;
END;

PROCEDURE SetFeederStatus(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   ActiveObjects = ARRAY OF INTEGEROBJECT;
   FedByList = ARRAY OF INTEGEROBJECT;
   FeedingList = ARRAY OF INTEGEROBJECT;
   FeedingStatus = ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   i = 1;
   SELECT :FedByList[i].Value = G2.Member,
          :FeedingList[i].Value = G2.Grouping
   FROM   UDB_Grouping G1,
          UDB_Grouping G2
   WHERE  G1.Grouping = :MainFeeder AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.Member = G2.Member AND
          G2.Relationship = :Interaction$FedBy AND
          G2.GroupingType = :Type$Feeder
   BEGIN
      FeedingStatus[i].Value = 1;

      SELECT :FeedingStatus[i].Value = 0
      FROM   FMS_ObjectStatus OS
      WHERE  OS.Object = :FeedingList[i].Value AND
             OS.Status = :Status$CO;

      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   FOR i = 1 TO EquipList.LastRow DO
      IF EquipList[i].BaseType <> Type$33KVPortion THEN
         CONTINUE;
      ENDIF;
      
      IF EquipList[i].PrimaryGrouping = MainFeeder THEN                   
         RetCode = FedByList.Find(AttributeName = 'Value',
                                  Value = EquipList[i].Object,
                                  RowNumber = ByRef(k));
         IF RetCode = ER_OK THEN
            // look for the cutout status of the feeding feeder
            EquipList[i].Status = FeedingStatus[k].Value;

            IF EquipList[i].Status = 1 THEN
               CALLPROC SetFeederEnergized(PrevEquipIdx = 0, CurEquipIdx = i);
            ENDIF;
            CONTINUE;
         ENDIF;
      ELSE
         RetCode = FeedingList.Find(AttributeName = 'Value',
                                    Value = EquipList[i].PrimaryGrouping,
                                    RowNumber = ByRef(k));
         IF RetCode = ER_OK THEN 
            EquipList[i].Status = FeedingStatus[k].Value;

            IF EquipList[i].Status = 1 THEN
               EquipList[i].Source = 1;      // feeding feeder
            ELSE
               EquipList[i].Source = Status$CO; 
            ENDIF;
         ELSE 
            EquipList[i].Status = 1;
            SELECT :EquipList[i].Status = 0
            FROM   FMS_ObjectStatus OS
            WHERE  OS.Object = :EquipList[i].Object AND
                   OS.Status = :Status$CO;
         ENDIF;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   // See what portions are fed by the closed source breaker
   IF SourceBreaker.CurrentlyOpen = 0 THEN
      CALLPROC SetFeederEnergized(PrevEquipIdx = 0, CurEquipIdx = 1);
   ENDIF;   
      
   RETURN;
END;

PROCEDURE SetFeederEnergized(
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;

   CurEquip = ConnectedEquipClass;
ENDDECLARE
BEGIN
   CurEquip = EquipList[CurEquipIdx];
   
   IF CurEquip.BaseType = Type$33KVPortion THEN
      CurEquip.Status = 1; 
   ELSEIF CurEquip.CurrentlyOpen = 1 THEN 
      RETURN;
   ENDIF;
   
   FOR i = 1 TO CurEquip.ConnectedTo.LastRow DO
      IF CurEquip.ConnectedTo[i].RowID <> PrevEquipIdx THEN
         CALLPROC SetFeederEnergized(
            PrevEquipIdx = CurEquipIdx,
            CurEquipIdx = CurEquip.ConnectedTo[i].RowID);
      ENDIF;
   ENDFOR;

   RETURN;
END;

PROCEDURE GetLongestPath(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   MaxNode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /* first trace to mark the position of each piece of equipment in the tree
   */
   MaxNode = CALLPROC MarkNextNode(Node = 1, 
                          PrevEquipIdx = 0,
                          CurEquipIdx = 1);
   /*
   ** Trace backward to mark the longest path.
   */
   RetCode = EquipList.FIND(AttributeName = 'Node',
                            Value = MaxNode,
                            RowNumber = ByRef(i));
   IF RetCode <> ER_OK THEN
      MESSAGE 'Application error in GetLongestPath. Please report to FMS Staff';
      RETURN FALSE;
   ENDIF;
   
   FOR k = 1 TO MaxNode DO
      EquipList[i].Terminal = 1;         
      
      FOR j = 1 TO EquipList[i].ConnectedTo.LastRow DO
         IF EquipList[EquipList[i].ConnectedTo[j].RowID].Node <= EquipList[i].Node THEN
            i = EquipList[i].ConnectedTo[j].RowID;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDFOR;
   
   RETURN TRUE;
END;
                     
PROCEDURE MarkNextNode(
   Node = INTEGER NOT NULL,
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   NextNode = INTEGER NOT NULL WITH DEFAULT;
   MaxNode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   MaxNode = Node;
   IF EquipList[CurEquipIdx].Outbound = TRUE AND EquipList[CurEquipIdx].Type = Type$FeederSegment THEN
      EquipList[CurEquipIdx].Node = EquipList[PrevEquipIdx].Node;
      RETURN EquipList[CurEquipIdx].Node;
   ENDIF;
   
   EquipList[CurEquipIdx].Node = Node;
      
   FOR i = 1 TO EquipList[CurEquipIdx].ConnectedTo.LastRow DO
      IF PrevEquipIdx <> EquipList[CurEquipIdx].ConnectedTo[i].RowID THEN
         NextNode = CALLPROC MarkNextNode(Node = Node+1, 
                          PrevEquipIdx = CurEquipIdx,
                          CurEquipIdx = EquipList[CurEquipIdx].ConnectedTo[i].RowID);  
         IF NextNode > MaxNode THEN
            MaxNode = NextNode;
         ENDIF;
      ENDIF;
   ENDFOR;
   RETURN MaxNode;
END;

PROCEDURE DrawSubTree(
   X = INTEGER NOT NULL,
   Y = INTEGER NOT NULL,
   Direction = INTEGER NOT NULL,    /* 0 = horizontally to the right, 90 = vertially up, -90 = vertically down */
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) = 
DECLARE
   i = integer not null with default; 
   k = integer not null with default; 
   x1 = integer not null; 
   y1 = integer not null;
ENDDECLARE
BEGIN
   CALLPROC DrawOneEquipment(X = X,
                             Y = Y,
                             Direction = Direction,
                             PrevEquipIdx = PrevEquipIdx,
                             CurEquipIdx = CurEquipIdx);
                             
   FOR i = 1 TO EquipList[CurEquipIdx].ConnectedTo.LastRow DO
      IF EquipList[CurEquipIdx].ConnectedTo[i].RowID <> PrevEquipIdx THEN
         CALLPROC DrawSubTree(X = EquipList[CurEquipIdx].ConnectedTo[i].PositionX,
                              Y = EquipList[CurEquipIdx].ConnectedTo[i].PositionY,
                              Direction = EquipList[CurEquipIdx].ConnectedTo[i].Direction,
                              PrevEquipIdx = CurEquipIdx,
                              CurEquipIdx = EquipList[CurEquipIdx].ConnectedTo[i].RowID);
      ENDIF;
   ENDFOR;                             
END;

PROCEDURE DrawOneEquipment (
   X = INTEGER NOT NULL,
   Y = INTEGER NOT NULL,
   Direction = INTEGER NOT NULL,    /* 0 = horizontally to the right, 90 = vertially up, -90 = vertically down */
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) =
DECLARE
   i = integer not null with default; 
   k = integer not null with default; 
ENDDECLARE
BEGIN
   IF EquipList[CurEquipIdx].BaseType = Type$33KVPortion THEN
      CALLPROC DrawFeeder(X = X,
                          Y = Y,
                          Direction = Direction,
                          PrevEquipIdx = PrevEquipIdx,
                          CurEquipIdx = CurEquipIdx);
   ELSE
      CALLPROC DrawSwitch(X = X,
                          Y = Y,
                          Direction = Direction,
                          PrevEquipIdx = PrevEquipIdx,
                          CurEquipIdx = CurEquipIdx);
   
   ENDIF;
   CurFrame.Flush();
END;

PROCEDURE DrawFeeder (
   X = INTEGER NOT NULL,
   Y = INTEGER NOT NULL,
   Direction = INTEGER NOT NULL,    /* 0 = horizontally to the right, 90 = vertially up, -90 = vertically down */
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) =
DECLARE
   i = integer not null with default; 
   k = integer not null with default; 

   PrevEquipTerminal = integer not null with default;
   CurEquip = ConnectedEquipClass;

   idx = integer not null with default; 
   IdxList = ARRAY OF INTEGEROBJECT; 

   x1 = integer not null; 
   y1 = integer not null;
   x2 = integer not null; 
   y2 = integer not null;
   VSpace = integer not null;
   HSpace = integer not null;
   InitHSpace = integer not null;
   InitVSpace = integer not null;
   
   FeederLength = integer not null with default;
   
   ColorInt = integer not null with default; 
   NewDirection = integer not null with default; 
   
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipLabel = EntryField DEFAULT NULL;

   LineNumber = integer not null with default;
   
   LineShape = SegmentShape;
ENDDECLARE
BEGIN
   IF PrevEquipIdx > 0 THEN
      PrevEquipTerminal = EquipList[PrevEquipIdx].Terminal;
   ELSE
      PrevEquipTerminal = 0;
   ENDIF;
   CurEquip = EquipList[CurEquipIdx];
   IF CurEquip.Status = 1 THEN
       ColorInt = CC_RED;
   ELSE
      ColorInt = CC_GREEN;
   ENDIF;
   
   /*
   In order to display the longest path in the middle of the screen, we use IdxList[1].Value to
   to store the index in the ConnectedTo array of the equipment on the longest path. The equipment on
   the top or bottom of the screen are randomly selected and stored in IdxList[2, 3, 4...].
   IdxList is important only when displaying the immediate equipment on the downstream of the source segment.
   */
   k = 1;
   FOR i = 1 TO CurEquip.ConnectedTo.LastRow DO
      IF CurEquip.ConnectedTo[i].RowID <> PrevEquipIdx THEN
         IdxList[k].Value = i;
      
         IF EquipList[CurEquip.ConnectedTo[i].RowID].Terminal = 1 THEN		// on the longest path
            IF IdxList[1].Value <> i THEN
               IdxList[k].Value = IdxList[1].Value;
               IdxList[1].Value = i;
            ENDIF;
         ENDIF;
         k = k + 1;
      ENDIF;
   ENDFOR;

   IF CurEquip.Type = Type$SourceSegment AND CurEquip.Outbound = FALSE THEN
      /* Source feeder. 
      ** To remember which branch a piece of equipment is on, we use EquipList[].Terminal:
      ** = 0 - top branch
      ** = 1 - longest path, middle or bottom branch
      ** = 2 - bottom branches, if there are more than two branches.
      **
      ** Indice to the ConnectedTo array:
      ** IdxList[2] ------------- element to be displayed on the top branch
      ** IdxList[1] ------------- longest path
      ** IdxList[3] ------------- element to be displayed on the bottom branch
      */      
      x1 = X;
      y1 = Y;
      x2 = X + FIELD(FDR_TEMPLATE.YBRANCH1).OuterWidth;
      y2 = Y;
      LineNumber = 1;

      CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_' + VARCHAR(LineNumber),
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

      // feeder Name
      IF ShowPortionName = TRUE THEN
         EquipName = CurEquip.Name;
         EquipLabel = EntryField.Create();
         EquipLabel.TextValue = CurEquip.Name;
         EquipLabel.CharsPerLine = LENGTH(CurEquip.Name)+1;
         EquipLabel.ToolTipText = VARCHAR(CurEquip.Object);
         EquipLabel.XLeft = X + 100;
         EquipLabel.YBottom  = Y - 60;
         EquipLabel.BgColor = CC_WHITE;
         EquipLabel.OutlineWidth = LW_NOLINE;
         EquipLabel.ParentField  = Field(VP.TemplateObj).ParentField; 
         EquipLabel.LayerSequence = 1;
      ENDIF;
      
      IF CurEquip.ConnectedTo.LastRow = 1 THEN      
         CurEquip.ConnectedTo[IdxList[1].Value].PositionX = x2;
         CurEquip.ConnectedTo[IdxList[1].Value].PositionY = y2;
         CurEquip.ConnectedTo[IdxList[1].Value].Direction = 0;
      
      ELSE
         /* vertical line
         ** the size of the template is for 2 branches of source feeders. If there are
         ** more branches, we will increase it.
         */         
         IF CurEquip.ConnectedTo.LastRow = 2 THEN
            FeederLength = FIELD(FDR_TEMPLATE.YBRANCH2).OuterHeight;
         ELSE
            FeederLength = FIELD(FDR_TEMPLATE.YBRANCH2).OuterHeight * (CurEquip.ConnectedTo.LastRow - 1);
         ENDIF;
         VSpace = FIELD(FDR_TEMPLATE.YBRANCH2).OuterHeight;
         
         LineNumber = LineNumber + 1;
         x1 = x2;
         y1 = y2 - FeederLength/2;
         y2 = y2 + FeederLength/2;
         
         CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_' + VARCHAR(LineNumber),
                     ColorInt = ColorInt,
                     ClientData = CurEquip);
                  
         // ------ top line (IdxList[2].value)
         LineNumber = LineNumber + 1;
         x1 = x1;
         x2 = x1 + FIELD(FDR_TEMPLATE.YBRANCH3).OuterWidth;         
         y1 = y1;
         y2 = y1;

         LineShape = CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_' + VARCHAR(LineNumber),
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

         CurEquip.ConnectedTo[IdxList[2].Value].PositionX = x2;
         CurEquip.ConnectedTo[IdxList[2].Value].PositionY = y2;
         CurEquip.ConnectedTo[IdxList[2].Value].Direction = 0;
         EquipList[CurEquip.ConnectedTo[IdxList[2].Value].RowID].Terminal = 0;
         
         // ------- 2nd line: the longest path (IdxList[1].Value])
         LineNumber = LineNumber + 1;
         x1 = x1;
         x2 = x2;         
         y1 = y1 + VSpace;
         y2 = y1;

         LineShape = CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_' + VARCHAR(LineNumber),
                     ColorInt = ColorInt,
                     ClientData = CurEquip);
         
         CurEquip.ConnectedTo[IdxList[1].Value].PositionX = x2;
         CurEquip.ConnectedTo[IdxList[1].Value].PositionY = y2;
         CurEquip.ConnectedTo[IdxList[1].Value].Direction = 0;
            
         FOR i = 3 TO IdxList.LastRow DO   
            // Draw the rest of branches
            LineNumber = LineNumber + 1;
            x1 = x1;
            x2 = x2;         
            y1 = y1 + VSpace; 
            y2 = y1;
            
            LineShape = CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                        LineName = CurEquip.Name + '_' + VARCHAR(LineNumber),
                        ColorInt = ColorInt,
                        ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[i].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[i].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[i].Value].Direction = 0;
            EquipList[CurEquip.ConnectedTo[IdxList[i].Value].RowID].Terminal = 2;            
         ENDFOR;
      ENDIF;      
   ELSE
      //  ====================== other type of portion feeders ======================
      x1 = X;
      y1 = Y;
      IF CurEquip.Outbound = TRUE THEN
         FeederLength = 300;
         EquipName = CurEquip.PrimaryGroupingName;
      ELSE
         IF CurEquip.Type = Type$LoadSegment AND Direction <> 0 THEN
            FeederLength = 300;
         ELSEIF CurEquip.ConnectedTo.LastRow <= 3 THEN
            FeederLength = FIELD(FDR_TEMPLATE.BENCH1).OuterWidth /2;
         ELSEIF CurEquip.ConnectedTo.LastRow = 4 THEN
            FeederLength = FIELD(FDR_TEMPLATE.BENCH1).OuterWidth;
         ELSE
            FeederLength = FIELD(FDR_TEMPLATE.BENCH1).OuterWidth /2 * (CurEquip.ConnectedTo.LastRow - 2);
         ENDIF;
         EquipName = CurEquip.Name;
      ENDIF;
      
      IF Direction = 0 THEN
         x2 = X + FeederLength;
         y2 = Y;
      ELSEIF Direction = 90 THEN
         x2 = X;
         y2 = Y - FeederLength;
      ELSEIF Direction = -90 THEN
         x2 = X;
         y2 = Y + FeederLength;
      ENDIF;
      
      CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_1',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

      // a load segment.
      IF CurEquip.Type = Type$LoadSegment THEN
         EquipLabel = EntryField.Create();
         EquipLabel.TextValue = 'Load';
         EquipLabel.CharsPerLine = 5;
         IF Direction = 0 THEN
            EquipLabel.XLeft = x2;
            EquipLabel.YBottom  = y2 + 150;
         ELSEIF Direction = 90 THEN
            EquipLabel.XLeft = x2 - 300;
            EquipLabel.YBottom  = y2;
         ELSEIF Direction = -90 THEN
            EquipLabel.XLeft = x2 - 300;
            EquipLabel.YTop  = Y2;
         ENDIF;
         EquipLabel.ParentField  = Field(VP.TemplateObj).ParentField; 
         EquipLabel.LayerSequence = 1;
      ENDIF;

      // feeder Name
      IF ShowPortionName = TRUE OR CurEquip.Outbound = TRUE THEN
         EquipLabel = EntryField.Create();
         IF CurEquip.Source > 0 THEN
            EquipLabel.TextValue = 'Fed By ' + EquipName;
            IF CurEquip.Source = 1 THEN
               EquipLabel.BgColor = CC_YELLOW;
            ELSEIF CurEquip.Source = Status$CO THEN
               EquipLabel.BgColor = CC_RED;
            ENDIF;
         ELSE
            EquipLabel.TextValue = EquipName;
            EquipLabel.BgColor = CC_WHITE;
         ENDIF;
         EquipLabel.CharsPerLine = LENGTH(EquipLabel.TextValue)+1;
         IF ShowPortionName = TRUE THEN
            EquipLabel.ToolTipText = VARCHAR(CurEquip.Object);
         ENDIF;
         EquipLabel.OutlineWidth = LW_NOLINE;

         IF CurEquip.Outbound = TRUE THEN
            IF Direction = 0 THEN
               EquipLabel.XLeft = x2 + 100;
               EquipLabel.YBottom  = y2 + 150;
            ELSEIF Direction = 90 THEN
               EquipLabel.XLeft = x2 - 300;
               EquipLabel.YBottom  = y2;
            ELSEIF Direction = -90 THEN
               EquipLabel.XLeft = x2 - 300;
               EquipLabel.YTop  = Y2;
            ENDIF;
            IF Nav2NeighborOK = TRUE THEN
               EquipLabel.ClientData = CurEquip;
            ENDIF;
         ELSE
            IF Direction = 0 THEN
               EquipLabel.XLeft = X + 300;
               EquipLabel.YBottom  = Y - 60;
            ELSEIF Direction = 90 THEN
               EquipLabel.XRight = X - 100;
               EquipLabel.YBottom  = Y - FeederLength/3 + 50;      
            ELSEIF Direction = -90 THEN
               EquipLabel.XRight = X - 100;
               EquipLabel.YTop  = Y + FeederLength/3 - 50;      
            ENDIF;
         ENDIF;
         EquipLabel.ParentField  = Field(VP.TemplateObj).ParentField; 
         EquipLabel.LayerSequence = 1;
      ENDIF;
      
      IF IdxList.LastRow > 0 THEN
         // something is connected on the other side
         CurEquip.ConnectedTo[IdxList[1].Value].PositionX = x2;
         CurEquip.ConnectedTo[IdxList[1].Value].PositionY = y2;
         CurEquip.ConnectedTo[IdxList[1].Value].Direction = Direction;
         EquipList[CurEquip.ConnectedTo[IdxList[1].Value].RowID].Terminal = PrevEquipTerminal;      
      ENDIF;

      IF CurEquip.ConnectedTo.LastRow > 2 THEN
         IF Direction = 0 THEN
            IF PrevEquipTerminal = 0 THEN
               NewDirection = 90;
            ELSE
               NewDirection = -90;
            ENDIF;
         ELSE
            NewDirection = 0;
         ENDIF;
         
         IF CurEquip.ConnectedTo.LastRow = 3 THEN
            IF NewDirection = 0 THEN
               x1 = x1;
               y1 = y1 + (y2 - y1)/2;
               x2 = x1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
               y2 = y1;
            ELSEIF NewDirection = 90 THEN
               x1 = x1 + (x2 - x1)/2;
               x2 = x1;
               y1 = y1;
               y2 = Y1 - FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ELSEIF NewDirection = -90 THEN
               x1 = x1 + (x2 - x1)/2;
               x2 = x1;
               y1 = y1;
               y2 = Y1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_2',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[2].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[2].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[2].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[2].Value].RowID].Terminal = PrevEquipTerminal;      
            
         ELSEIF CurEquip.ConnectedTo.LastRow = 4 THEN
            // -------- 1st leg
            IF NewDirection = 0 THEN
               VSpace = (y2 - y1)/4;
               
               x1 = x1;
               y1 = y1 + VSpace;
               x2 = x1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
               y2 = y1;
            ELSEIF NewDirection = 90 THEN
               HSpace = (x2 - x1)/4;

               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = Y1 - FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ELSEIF NewDirection = -90 THEN
               HSpace = (x2 - x1)/4;

               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = Y1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_3',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[2].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[2].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[2].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[2].Value].RowID].Terminal = PrevEquipTerminal;      
         
            // ---------- 2nd leg
            IF NewDirection = 0 THEN
               x1 = x1;
               y1 = y1 + 2*VSpace;
               x2 = x2;
               y2 = y1;
            ELSE
               x1 = x1 + 2*HSpace;
               x2 = x1;
               y1 = y1;
               y2 = y2;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_4',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[3].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[3].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[3].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[3].Value].RowID].Terminal = PrevEquipTerminal;      

         ELSEIF CurEquip.ConnectedTo.LastRow = 5 THEN            
            // -------- 1st leg
            IF NewDirection = 0 THEN
               VSpace = (y2 - y1)/4;
               
               x1 = x1;
               y1 = y1 + VSpace;
               x2 = x1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
               y2 = y1;
            ELSEIF NewDirection = 90 THEN
               HSpace = (x2 - x1)/4;

               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = Y1 - FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ELSEIF NewDirection = -90 THEN
               HSpace = (x2 - x1)/4;

               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = Y1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_2',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[2].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[2].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[2].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[2].Value].RowID].Terminal = PrevEquipTerminal;  
            
            // ---------- 2nd leg
            IF NewDirection = 0 THEN
               x1 = x1;
               y1 = y1 + VSpace;
               x2 = x2;
               y2 = y1;
            ELSE
               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = y2;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_3',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[3].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[3].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[3].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[3].Value].RowID].Terminal = PrevEquipTerminal; 
            
            // ----------3rd leg
            IF NewDirection = 0 THEN
               x1 = x1;
               y1 = y1 + VSpace;
               x2 = x2;
               y2 = y1;
            ELSE
               x1 = x1 + HSpace;
               x2 = x1;
               y1 = y1;
               y2 = y2;
            ENDIF;
            
            CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                     LineName = CurEquip.Name + '_4',
                     ColorInt = ColorInt,
                     ClientData = CurEquip);

            CurEquip.ConnectedTo[IdxList[4].Value].PositionX = x2;
            CurEquip.ConnectedTo[IdxList[4].Value].PositionY = y2;
            CurEquip.ConnectedTo[IdxList[4].Value].Direction = NewDirection;
            EquipList[CurEquip.ConnectedTo[IdxList[4].Value].RowID].Terminal = PrevEquipTerminal; 

         ELSE
            VSpace = (y2 - y1)/(CurEquip.ConnectedTo.LastRow - 2);
            InitVSpace = VSpace /2;
            HSpace = (x2 - x1)/(CurEquip.ConnectedTo.LastRow - 2);
            InitHSpace = HSpace /2;

            FOR k = 1 TO (CurEquip.ConnectedTo.LastRow - 2) DO
               idx = k + 1;
            
               IF k = 1 THEN
                  IF NewDirection = 0 THEN
                     x1 = x1;
                     y1 = y1 + InitVSpace;
                     x2 = x1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
                     y2 = y1;
                  ELSEIF NewDirection = 90 THEN
                     x1 = x1 + InitHSpace;
                     x2 = x1;
                     y1 = y1;
                     y2 = Y1 - FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
                  ELSEIF NewDirection = -90 THEN
                     x1 = x1 + InitHSpace;
                     x2 = x1;
                     y1 = y1;
                     y2 = Y1 + FIELD(FDR_TEMPLATE.BENCH2).OuterHeight;
                  ENDIF;
               ELSE
                  IF NewDirection = 0 THEN
                     x1 = x1;
                     y1 = y1 + VSpace;
                     x2 = x2;
                     y2 = y1;
                  ELSE
                     x1 = x1 + HSpace;
                     x2 = x1;
                     y1 = y1;
                     y2 = y2;
                  ENDIF;
               ENDIF;
               
               CALLPROC DrawLine(x1 = x1, y1 = y1, x2 = x2, y2 = y2,
                        LineName = CurEquip.Name + '_' + VARCHAR(idx),
                        ColorInt = ColorInt,
                        ClientData = CurEquip);

               CurEquip.ConnectedTo[IdxList[idx].Value].PositionX = x2;
               CurEquip.ConnectedTo[IdxList[idx].Value].PositionY = y2;
               CurEquip.ConnectedTo[IdxList[idx].Value].Direction = NewDirection;
               EquipList[CurEquip.ConnectedTo[IdxList[idx].Value].RowID].Terminal = PrevEquipTerminal;  
            ENDFOR;
         ENDIF;
      ENDIF;
   ENDIF;
   
   //RETURN TRUE;
END;
  
PROCEDURE DrawSwitch (
   X = INTEGER NOT NULL,
   Y = INTEGER NOT NULL,
   Direction = INTEGER NOT NULL,    /* 0 = horizontally to the right, 90 = vertially up, -90 = vertically down */
   PrevEquipIdx = INTEGER NOT NULL,
   CurEquipIdx = INTEGER NOT NULL
) =
DECLARE
   i = integer not null with default; 
   k = integer not null with default; 

   PrevEquipTerminal = integer not null with default;
   CurEquip = ConnectedEquipClass;

   idx = integer not null with default; 

   x2 = integer not null; 
   y2 = integer not null;
   ColorInt = integer not null with default; 
   YTop  = integer not null with default; 
   XLeft = integer not null with default; 
      
   ISImage = ImageField DEFAULT NULL;
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   //EquipLabel1 = EntryField DEFAULT NULL;
   //EquipLabel2 = EntryField DEFAULT NULL;
   EquipLabel1 = FreeTrim DEFAULT NULL;
   EquipLabel2 = FreeTrim DEFAULT NULL;

   ENDDECLARE
BEGIN 
   IF PrevEquipIdx > 0 THEN
      PrevEquipTerminal = EquipList[PrevEquipIdx].Terminal;
   ELSE
      PrevEquipTerminal = 0;
   ENDIF;
   
   CurEquip = EquipList[CurEquipIdx];
   
   FOR i = 1 TO CurEquip.ConnectedTo.LastRow DO
      IF CurEquip.ConnectedTo[i].RowID <> PrevEquipIdx THEN
         idx = i;
         ENDLOOP;
      ENDIF;
   ENDFOR;
   
   ISImage = ImageTrim.Create();
   IF Direction = 0 THEN
      IF CurEquip.CurrentlyOpen = 1 THEN   
         ISImage.Image = FIELD(IS_H_0_template).Image; 
      ELSE
         ISImage.Image = FIELD(IS_H_1_template).Image; 
      ENDIF;

      ISImage.YBottom = Y + FIELD(IS_H_0_Template).OuterHeight/2 - 50;     // 50 to compensate the outline width
      ISImage.XLeft = X ;
      
      x2 = X + FIELD(IS_H_0_Template).OuterHeight;
      y2 = Y;
   ELSE
      IF CurEquip.CurrentlyOpen = 1 THEN   
         ISImage.Image = FIELD(IS_V_0_template).Image; 
      ELSE
         ISImage.Image = FIELD(IS_V_1_template).Image; 
      ENDIF;
      IF Direction = 90 THEN
         ISImage.YBottom = Y;
         ISImage.XLeft = X - FIELD(IS_V_0_Template).OuterWidth/2;
         
         x2 = X;
         y2 = Y - FIELD(IS_V_0_Template).OuterHeight + 50;  // 50 = recalibration due to placement deviation
      ELSE
         ISImage.YTop = Y;
         ISImage.XLeft = X - FIELD(IS_V_0_Template).OuterWidth/2;

         x2 = X;
         y2 = Y + FIELD(IS_V_0_Template).OuterHeight;
      ENDIF;
   ENDIF;
   ISImage.OutlineWidth = LW_EXTRATHIN;
   ISImage.CurBias = FB_ClickPoint;
   ISImage.ParentField = Field(VP.TemplateObj).ParentField;
   ISImage.LayerSequence = 3;

   // interrupter Switch print ID
   IF Direction = 0 THEN
      YTop  = ISImage.YBottom;
      XLeft = ISImage.XLeft - 150;
   ELSE
      YTop  = ISImage.YTop + 50;
      XLeft = ISImage.XRight + 50;   
   ENDIF;

   EquipName = SQUEEZE(CurEquip.SpecNumber);
   IF EquipName <> '' THEN     
      EquipLabel1 = FreeTrim.Create();
      EquipLabel1.TextValue = EquipName;
      //EquipLabel1.CharsPerLine = LENGTH(EquipName)+1;
      EquipLabel1.YTop  = YTop;
      EquipLabel1.XLeft = XLeft;
      EquipLabel1.TypeSize = 14;
      EquipLabel1.FgColor = CC_BLUE;
      EquipLabel1.BgColor = CC_PALE_ORANGE;
      EquipLabel1.OutlineWidth = LW_NOLINE;
      EquipLabel1.ParentField  = Field(VP.TemplateObj).ParentField;
      EquipLabel1.LayerSequence = 1;
   ENDIF;
   
   // interrupter Switch Name
   IF Direction = 0 THEN
      XLeft = XLeft + 230;
      IF LENGTH(EquipName) = 2 THEN
         XLeft = XLeft + 100;
      ENDIF;
      YTop = YTop + 30;
   ELSE
      YTop = YTop + 250;
   ENDIF;
      
   EquipName = CurEquip.Name;
   EquipLabel2 = FreeTrim.Create();
   EquipLabel2.TextValue = EquipName;
   //EquipLabel2.CharsPerLine = LENGTH(EquipName) + 4;
   EquipLabel2.YTop  = YTop;
   EquipLabel2.XLeft = XLeft;
   EquipLabel2.BgColor = CC_WHITE;
   EquipLabel2.OutlineWidth = LW_NOLINE;
   EquipLabel2.ParentField  = Field(VP.TemplateObj).ParentField;
   EquipLabel2.LayerSequence = 1;
 
   IF idx > 0 THEN
      // something is connected on the other side.
      CurEquip.ConnectedTo[idx].PositionX = x2;
      CurEquip.ConnectedTo[idx].PositionY = y2;
      CurEquip.ConnectedTo[idx].Direction = Direction;
      EquipList[CurEquip.ConnectedTo[idx].RowID].Terminal = PrevEquipTerminal; 
   ENDIF;
END; 

PROCEDURE DrawLine(
   x1 = integer not null,
   y1 = integer not null,
   x2 = integer not null, 
   y2 = integer not null,
   LineName = VARCHAR(40) NOT NULL,
   ColorInt = integer not null,
   ClientData = ConnectedEquipClass DEFAULT NULL;
) = 
DECLARE
   FdrSegment = SegmentShape;
   ActiveCursor = CursorBitmap;
ENDDECLARE
BEGIN
   ActiveCursor.SysCursor = SP_SIZE;
   
   FdrSegment  = SegmentShape.Create();
   FdrSegment.Name = LineName;
   FdrSegment.LineWidth = LW_VERYTHIN;
   FdrSegment.LineColor = ColorInt;
   FdrSegment.SetEndPoints(
         Point1X = x1,
         Point1Y = y1,
         Point2X = x2,
         Point2Y = y2);
   FdrSegment.ParentField = Field(VP.TemplateObj).ParentField; 
   FdrSegment.ClientData = ClientData;
   FdrSegment.LayerSequence = 2;
      
   IF ClientData.Outbound = FALSE THEN
      FdrSegment.CurBias = FB_ClickPoint;      
      FdrSegment.Cursor = ActiveCursor;
   ENDIF;
   
   RETURN FdrSegment;
END;

PROCEDURE ShowFeederAndNavigation(
) = 
DECLARE
   FeederList = ChoiceList;
ENDDECLARE
BEGIN
   FIELD(Heading).TextValue = FeederName + ' Feeder Diagram';

   RetCode = NavHistory.Find(AttributeName = 'Object',
                             Value = MainFeeder);
   IF RetCode = ER_RowNotFound THEN
      k = NavHistory.LastRow + 1;
      NavHistory.InsertRow(RowNumber = k);
      NavHistory[k].Object = MainFeeder;
      NavHistory[k].Name = FeederName;
      
      IF k <= 1 THEN
         RETURN;
      ENDIF;
      
      FeederList.ChoiceItems.Clear();
      FeederList.ChoiceItems[1].EnumValue = 0;     
      FeederList.ChoiceItems[1].EnumText  = '';
      FOR i = 1 to k DO
         FeederList.ChoiceItems[i+1].EnumValue = NavHistory[i].Object;     
         FeederList.ChoiceItems[i+1].EnumText  = NavHistory[i].Name;
      ENDFOR;
      FIELD(ToFeeder).ValueList = FeederList.Duplicate();
      FIELD(ToFeeder).UpdChoiceList();
      FIELD(ToFeeder).ParentField.CurBias = FB_CHANGEABLE;
   ENDIF;
END;

PROCEDURE ResetViewport(
) = 
DECLARE
   ParentForm = FlexibleForm;
ENDDECLARE
BEGIN
   ParentForm = FlexibleForm(Field(VP.TemplateObj).ParentField);
   i = ParentForm.ChildFields.LastRow;
   WHILE i >= 1 DO
      IF ParentForm.ChildFields[i].Name <> 'templateobj' THEN
         ParentForm.ChildFields[i].ParentField = NULL;
      ENDIF;
      i = i - 1;
   ENDWHILE;
END;

PROCEDURE CheckConfigurationChange(
) = 
DECLARE
   CardID = INTEGER NOT NULL WITH DEFAULT;
   CardASE = FMS_Card_ASE;
ENDDECLARE
BEGIN
   CardID = 0;
   
   SELECT :CardID = C.Card
   FROM  FMS_Card C, 
         SOA_ActiveCard AC
   WHERE C.Feeder = :MainFeeder AND
         C.Card = AC.Card;
         
   IF CardID = 0 THEN
      RETURN;
   ENDIF;
   
   CardASE.Card = CardID;
   CardASE.ArchiveCard = FALSE;
   CardASE.LoadCard();
   
   IF CardASE.ReturnCode <> 0 THEN
      Message CardASE.ErrorMessage;
      RETURN;
   ENDIF;

   RetCode = CALLPROC Confirm3GConfiguration (Card = CardASE.C,
                                              NotifyFedByChange = TRUE);
   IF RetCode = PU_CANCEL THEN 
      MESSAGE CardASE.C.FeederName + ' configuration has changed. The portion status on the diagram may be incorrect.';
   ENDIF;
END;

PROCEDURE LoadPortionEquipment(
   Portion = ConnectedEquipClass
)= 
DECLARE

ENDDECLARE
BEGIN
   EquipStack.PortionEquip.Clear();
   i = 1;
   SELECT :EquipStack.PortionEquip[i].Object = O.Object,
          :EquipStack.PortionEquip[i].Name = O.Name,
          :EquipStack.PortionEquip[i].Type = O.Type,
          :EquipStack.PortionEquip[i].TypeName = O.TypeName,
          :EquipStack.PortionEquip[i].BaseType = O.BaseType,
          :EquipStack.PortionEquip[i].Description = O.Description,
          :EquipStack.PortionEquip[i].PrimaryGrouping = O.PrimaryGrouping,
          :EquipStack.PortionEquip[i].PrimaryGroupingName = O.PrimaryGroupingName,
          :EquipStack.PortionEquip[i].SpecNumber = G.Reference
   FROM   Udb_Grouping G,
          Udb_Object O,
          Udb_ExtendedType ET
   WHERE G.Grouping = :Portion.Object AND
         G.Relationship = :Interaction$MemberOf AND
         G.Member = O.Object AND
         O.Type = ET.Type AND
         ET.SuperType = :Type$Switch
   ORDER BY SpecNumber, TypeName, Name
   BEGIN
      SELECT :EquipStack.PortionEquip[i].Combination = O.Name
      FROM   UDB_Grouping G,
             UDB_ExtendedType ET,
             UDB_Object O      
      WHERE  G.Member = :EquipStack.PortionEquip[i].Object AND
             G.Relationship = :Interaction$MemberOf AND 
             G.Grouping <> :Portion.Object AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Feeder AND
             G.Grouping = O.Object;
          
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;


PROCEDURE GetPortionName(
   Portion = ConnectedEquipClass
)= 
DECLARE
   EndSwitchList = ARRAY OF STRINGOBJECT;
   PortionName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   m = 1;
   FOR i = 1 TO Portion.ConnectedTo.LastRow DO
      IF EquipList[Portion.ConnectedTo[i].RowID].NormalOpen = 0 THEN
         EndSwitchList[m].Value = EquipList[Portion.ConnectedTo[i].RowID].SpecNumber;
         m = m + 1;
      ENDIF;
   ENDFOR;
   EndSwitchList.Sort(Value = AS_ASC);

   PortionName = '';
   FOR i = 1 TO EndSwitchList.LastRow DO
      IF i = 1 THEN
         PortionName = EndSwitchList[i].Value;
      ELSE
         PortionName = PortionName + '<-->' + EndSwitchList[i].Value;
      ENDIF;
   ENDFOR;
   IF Portion.Type = Type$SourceSegment THEN
      PortionName = 'Source<-->' + PortionName;
   ELSEIF Portion.Type = Type$LoadSegment THEN
      PortionName = PortionName + '<-->Load';
   ENDIF;
   PortionName = FeederName + ' ' + PortionName;
   
   RETURN PortionName;
END;

PROCEDURE GetPortionRectangle(
   PortionField = FieldObject,
   x1 = INTEGER NOT NULL WITH DEFAULT,
   x2 = INTEGER NOT NULL WITH DEFAULT,
   y1 = INTEGER NOT NULL WITH DEFAULT,
   y2 = INTEGER NOT NULL WITH DEFAULT 
)= 
DECLARE
   CurEquip = ConnectedEquipClass;
   LineName = VARCHAR(20) NOT NULL WITH DEFAULT;
   LineField = SegmentShape;
ENDDECLARE
BEGIN
   x1 = 0;
   y1 = 0;
   x2 = 0;
   y2 = 0;
  
   // search for branches of the same segment
   CurEquip = ConnectedEquipClass(PortionField.ClientData); 
   LineName = LOWERCASE(CurEquip.Name) + '_%';
   
   FOR i = 1 TO SegmentShape(PortionField).ParentField.ChildFields.LastRow DO
      IF SegmentShape(PortionField).ParentField.ChildFields[i].Name Like LineName THEN
         LineField = SegmentShape(SegmentShape(PortionField).ParentField.ChildFields[i]);
         IF x1 = 0 and x2 = 0 THEN
            IF LineField.Point1X <= LineField.Point2X THEN
               x1 = LineField.Point1X;
               x2 = LineField.Point2X ;
            ELSE
               x1 = LineField.Point2X;
               x2 = LineField.Point1X ;            
            ENDIF;
            IF LineField.Point1Y <= LineField.Point2Y THEN
               y1 = LineField.Point1Y;
               y2 = LineField.Point2Y ;
            ELSE
               y1 = LineField.Point2Y;
               y2 = LineField.Point1Y ;            
            ENDIF;
         ELSE
            IF LineField.Point1X < x1 THEN
               x1 = LineField.Point1X;
            ELSEIF LineField.Point2X < x1 THEN
               x1 = LineField.Point2X;
            ENDIF;
            IF LineField.Point1X > x2 THEN
               x2 = LineField.Point1X;
            ELSEIF LineField.Point2X > x2 THEN
               x2 = LineField.Point2X;
            ENDIF;
            IF LineField.Point1Y < y1 THEN
               y1 = LineField.Point1Y;
            ELSEIF LineField.Point2Y < y1 THEN
               y1 = LineField.Point2Y;
            ENDIF;
            IF LineField.Point1Y > y2 THEN
               y2 = LineField.Point1Y;
            ELSEIF LineField.Point2Y > y2 THEN
               y2 = LineField.Point2Y;
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;   
END;
				 *Default Item


Application Component Report
============================

	Name:            PortionFeederDiagram_orig

/*
