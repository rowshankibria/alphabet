	Name:            SetStatus

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
*/
/*
**  Application:    FeederCard
**  Frame:          SetStatus 
**
**  Modifications:
**  06/10/93  em    Created 
**  07/07/94  em    added return code processing
*/
PROCEDURE SetStatus  
(
    Object = INTEGER NOT NULL;          /*Passed object */
    Status = INTEGER NOT NULL;          /*Passed status */
    SelectCount = INTEGER;              /*SelectionResult*/
    RetCode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   SelectCount = 0;                 /*Set Status if not already set*/
   REPEATED
   SELECT :SelectCount = Count(*)
   FROM   FMS_ObjectStatus 
   WHERE  Object = :Object AND
          Status = :Status; 

   IF SelectCount = 0 THEN

      RetCode = CALLPROC FMS_ObjStatIns(  Object = Object,
                  Status = Status,
                  StatusCount = 1,
                  TimeSet = date('now'));
       IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           RETURN (PU_CANCEL);
       ENDIF;

   ELSE    

        RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
      Object = Object, 
      Status = Status,
      increment = 1,
      TimeSet = date('now'));
       IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           RETURN (PU_CANCEL);
       ENDIF;

   ENDIF; 

   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            SetTCEquipType

/*
**      Copyright c 1997 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    TelephoneCard
**  Frame:          SetTCEquipType
**
**  Modifications:
**  07/16/97 jfl    Created
*/

INITIALIZE
(
    TypeName = VARCHAR(40) NOT NULL;       /* P: Type Name passed byref */
    Equipt   = ObjectClass;                   /* P: passed TC equipment    */
    SelectedEquipType = ObjectClass;       /* selected Equipment type   */
    CopyOfEquipt      = ObjectClass;       /* Copy of Equipt            */
    i = INTEGER NOT NULL;       
    Error = INTEGER NOT NULL NOT DEFAULT;
) =
BEGIN
/*
** Update Title
*/
    FIELD(TheTitle).TextValue = 'Select Equipment Type for ' + Equipt.Name;
/*
** Load an alphabetic ordered list of TC Equipment types
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
        :EquipType[i].Object   = T.Type,
        :EquipType[i].Name     = T.Name
    FROM Udb_Type T,
         Udb_ExtendedType ET
    WHERE T.Type = ET.Type
      AND ET.Supertype = :Type$TCEquipment
      AND T.Type <> :Type$TCEquipment
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
/*
**  init selection
*/
    SelectedEquipType.Object = 0;
    SelectedEquipType.Name = '';
END;

/*
** Keep selection in temporary object
*/
ON ChildEntry EquipType[*].Name =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;
    i = FIELD(EquipType).WhichRow (cellfield = CurFrame.TriggerField);
    SelectedEquipType = EquipType[i];
END;

/*
** update object type in udb
*/
ON Click Apply_Btn =
BEGIN
    IF SelectedEquipType.Object = 0 THEN
        Message ' Please, select a valid equipment type first.';
        RESUME;
    ENDIF;

/*
** Select everything from object table for the equipment
*/
    SELECT  :CopyOfEquipt.Object = O.Object,
            :CopyOfEquipt.Name = O.Name,
            :CopyOfEquipt.Description = O.Description,
            :CopyOfEquipt.Type = O.Type,
            :CopyOfEquipt.TypeName = O.TypeName,
            :CopyOfEquipt.PrimaryGrouping = O.PrimaryGrouping,
            :CopyOfEquipt.PrimaryGroupingName = O.PrimaryGroupingName,
            :CopyOfEquipt.Comment = O.Comment,
            :CopyOfEquipt.Validated = O.Validated,
            :CopyOfEquipt.ValidatedBy = O.ValidatedBy,
            :CopyOfEquipt.Inservice = O.Inservice,
            :CopyOfEquipt.Outservice = O.Outservice,
            :CopyOfEquipt.PositionX = O.PositionX,
            :CopyOfEquipt.PositionY = O.PositionY,
            :CopyOfEquipt.OwnerNumber = O.OwnerNumber,
            :CopyOfEquipt.SerialNumber = O.SerialNumber,
            :CopyOfEquipt.SpecNumber = O.SpecNumber,
            :CopyOfEquipt.Combination = O.Combination,
            :CopyOfEquipt.LockNumber = O.LockNumber,
            :CopyOfEquipt.LastChanged = O.LastChanged,
            :CopyOfEquipt.LastChangedBy = O.LastChangedBy
    FROM Udb_Object O
    WHERE O.Object = :Equipt.Object;
    CALLPROC DDB_ROLLBACK;
/*
** Update the type for this object
*/
    Error = CALLPROC Udb_ObjectUpdAll(
                Object = CopyOfEquipt.Object,
                Type = SelectedEquipType.Object,
                PrimaryGrouping = CopyOfEquipt.PrimaryGrouping,
                TypeName = SelectedEquipType.Name,
                PrimaryGroupingName = CopyOfEquipt.PrimaryGroupingName,
                Name = CopyOfEquipt.Name,
                Description = CopyOfEquipt.Description,
                Comment = CopyOfEquipt.Comment,
                Inservice = CopyOfEquipt.Inservice,
                Outservice = CopyOfEquipt.Outservice,
                PositionX = CopyOfEquipt.PositionX,
                PositionY = CopyOfEquipt.PositionY,
                OwnerNumber = CopyOfEquipt.OwnerNumber,
                SerialNumber = CopyOfEquipt.SerialNumber,
                SpecNumber = CopyOfEquipt.SpecNumber,
                Combination = CopyOfEquipt.Combination,
                LockNumber = CopyOfEquipt.LockNumber,
                Validated = CopyOfEquipt.Validated,
                ValidatedBy = CopyOfEquipt.ValidatedBy,
                LastChanged = CopyOfEquipt.LastChanged,
                LastChangedBy = CopyOfEquipt.LastChangedBy);
    IF (Error <> 0) THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while updating Equipment object information.';
        RESUME;
    ELSE
        CALLPROC DDB_COMMIT;
    ENDIF;
/*
** update byref value to refresh parent screen
*/
    TypeName = SelectedEquipType.Name;
    RETURN;
END;


ON Click Cancel_Btn =
BEGIN
    RETURN;
END;

ON WindowClose =
BEGIN
    RESUME;
END;


