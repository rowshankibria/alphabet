PROCEDURE DeterminePhase(
   RowNumber = INTEGER NOT NULL
)=
DECLARE
   i = INTEGER NOT NULL;
   NISMove = INTEGER NOT NULL;	/*BOOLEAN*/
ENDDECLARE
BEGIN
   i = RowNumber;
/*
** Check whether this move appropriately is a move that can return Phases.
** If it is already a Phase move, then it cannot be split into phases again.
** If it is NIS move (must check DB since status field in array is being
** used to determine if a TO or RS), don't allow phase.
*/
   IF Moves[i].MoveType = MoveType$Phase THEN
      RETURN;
   ENDIF;

   NISMove = FALSE; 
   BreakMove = FALSE; 
   GroundMove = FALSE; 

   SELECT  :NISMove = :TRUE
   FROM    SOA_Job 
   WHERE   Job = :Moves[i].Job AND
           Status = :JobStatus$NIS;

   IF NISMove = TRUE THEN
      RETURN;
   ENDIF;
/*
**  Check to make sure this is a Visible Break or a Ground Move
**  i is retained from previous event as the current row number.
*/
   SELECT  :GroundMove = :TRUE
   FROM    FMS_JobAction 
   WHERE   JobClass = :Moves[i].JobClass AND
           EquipClass = :Moves[i].MoveEquipClass AND
           Status = :Status$Ground;

   IF GroundMove = FALSE THEN 
/*
** Call function to determine if move is a Phase Break move
*/
      BreakMove = FALSE;
      BreakMove = CALLPROC DeterminePhaseBreak (
                   JobClass = Moves[i].JobClass,
                   EquipClass = Moves[i].EquipClass,
                   StepPair = Moves[i].StepPair,
                   TORS = TORS);
   ENDIF;

   IF BreakMove = TRUE OR GroundMove = TRUE THEN
      FIELD(Moves[i].Phase_btn).FgCOLOR = CC_BLACK;
   ENDIF;

   RETURN;
END;

PROCEDURE CreateDelayedFOTCard(
) = 
DECLARE
   NewCard = INTEGER NOT NULL WITH DEFAULT;
   Reason = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /* 
   **  Create FOT card if card is not ISO
   **  else create another ISO 
   **  (the substitution to ISO is done in the called frame) 
   */ 
   RetCode = CALLFRAME CreateXferCard
            (OldCardID    = Card, 
            XferCardKey = byref(NewCard),
            XferCardClass = Type$FOT, 
            TestType = OrderReturnStatus.TestType,
            TestDate = OrderReturnStatus.TestDate);

   IF (RetCode = PU_OK) THEN 
      CALLPROC DDB_COMMIT;
      /*
      ** Log the creation of a transfer ISO card due to FOT
      */
      IF CardDetails.CardClass = Type$ISO THEN
         IF OrderReturnStatus.TestType = 'A' THEN
            Reason = 'Reason: AmmClear FOT';
         ELSEIF OrderReturnStatus.TestType = 'H' THEN
            Reason = 'Reason: HiPot FOT';
         ENDIF;
         
         CALLPROC SOA_LogIns (Card = NewCard,
                       SwitchingItem = 0,
                       Job  = NULL,
                       Time = DATE('now'),
                       UserName = UserName,
                       Item = 'Xfer Card Created',
                       Old  = '',
                       New  = Reason);
           CALLPROC DDB_COMMIT;
      ENDIF;
      /* 
      **   Load the new FOT card into the frame:   
      */ 
      FCFrame.SendUserEvent(EventName = 'update_xfer', 
                            messageinteger = NewCard);
   ENDIF;
END;

PROCEDURE UpdateOpOrderStatus(
) = 
DECLARE
   Feeder = INTEGER NOT NULL WITH DEFAULT;
   FdrList = ARRAY OF INTEGEROBJECT;
   RunTimeCorrection = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF OrderStatus = Order$Rejected THEN
      Status = Order$ConfirmRejected;

   ELSEIF OrderStatus = Order$Rescinded THEN
      Status = Order$ConfirmRescinded;

   ELSEIF OrderStatus = Order$Closed THEN
      Status = Order$ConfirmClosed;
   ELSE
      /*
      **  Make sure status has a value.  We should not get into
      **  this else, but we have seen orderstatus with orderstatus
      **  of 0, so we will look here first.
      */
      Status = Order$ConfirmClosed;
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              ': WARNING - Order Status ' + 
              'unknown for order: ' + varchar(oporder) +
              ' setting to ' + varchar(Order$ConfirmClosed));
      IF Moves.LastRow = 0 THEN  /* Correct Row out of range error */
         RunTimeCorrection = 0;  
      ELSE
         RunTimeCorrection = Moves[1].SwitchingItem;
      ENDIF;
      CALLPROC SOA_LogIns (Card = Card,
                 Job  = NULL,
                 SwitchingItem  = RunTimeCorrection,  
                 UserName = UserName,
                 Time = 'now',
                 Item = 'Order Return',
                 Old  = 'OrderStatus not known for order ' + VARCHAR(:OpOrder), 
                 New = 'Setting to: ' + varchar(Order$ConfirmClosed));
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF CurrentApplication = Application$DSO THEN
      RetCode = CALLPROC IR_DSOOrderStatusUpd
                (OrderNumber = OpOrder,
                 OrderStatus = IFNULL(Status,0));

   ELSE
      RetCode = CALLPROC IR_OrderStatusUpd
                (OrderNumber = OpOrder,
                 OrderStatus = IFNULL(Status,0));
   ENDIF;
   
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              ': WARNING - Order Status ' + 
              'not updated to: ' + varchar(Status) + 
              ' for order: ' + varchar(oporder));
      Message 'Unable to update Operating Order status. ' + 
              'Please report problem to ' +
              'technical support.' + HC_NEWLINE + 'Order Status ' + 
              'not updated to: ' + varchar(Status) + 
              ' for order: ' + varchar(oporder);
   ENDIF;
   CALLPROC DDB_COMMIT; 

   IF OrderStatus = Order$Closed AND ManualOrderToggle = FALSE THEN
      ControlText = VARCHAR(OpOrder) + ';';
      ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
      ControlText = ControlText + AckDO + ';'; 
      CALLPROC InsertDBEventQueue(
               ToApp = 'SOO',
               EventName = 'IR_AckOpOrderReturn',
               EventText = ControlText);  

      IF CurrentApplication = Application$FMS THEN
         /*
         ** If SSO return start times for the operating steps, we need to adjust 
         ** the start time here.
         */
         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    
         SimpleStep.OrderNumber = OpOrder;

         SimpleStep.StartTimeUpd();

         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = '',
               TraceMessage = SimpleStep.ErrorMessage);
         ENDIF; 
         SimpleStep = NULL;         
      ENDIF;
   ELSE
      IF OrderStatus = Order$Rejected THEN
         ControlText = VARCHAR(OpOrder) + ';';
         ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
         ControlText = ControlText + AckDO + ';'; 
         CALLPROC InsertDBEventQueue(
               ToApp = 'SOO',
               EventName = 'IR_AckOpOrderRejection', 
               EventText = ControlText);  
      ENDIF;

      IF CurrentApplication = Application$FMS THEN
         /*
         ** If this order sets the Feeder Ground status, we should reset it.
         ** check if there is a Apply Feeder Ground objective in the order
         */
         x = 0;
         SELECT :x = 1,
                :OrderCard = C.Card,
                :Feeder = C.Feeder
         FROM   IR_OperatingOrder OP,
                FMS_Card C
         WHERE  OP.OrderNumber = :OpOrder AND
                OP.Application = 'FMS' AND
                OP.Card = C.Card;
         CALLPROC DDB_ROLLBACK;

         IF x = 1 THEN     
            x = 0;
            SELECT :x = Objective
            FROM   IR_OpOrderObjectives
            WHERE  OrderNumber = :OpOrder AND
                   Objective = :Objective$ApplyFdrGnd;

                   
            IF x > 0 THEN
               IF Feeder = -1 THEN
                  i = 1;
                  SELECT :FdrList[i].Value = Object
                  FROM   TFMS_CardToObject
                  WHERE  Card = :OrderCard
                  BEGIN
                     i = i + 1;
                  END;
                  CALLPROC DDB_ROLLBACK;
               ELSE
                  FdrList[1].Value = Feeder; 
               ENDIF;

               FOR i = 1 TO FdrList.LASTROW DO
                  x = 0;
                  SELECT :x = StatusCount
                  FROM   FMS_ObjectStatus
                  WHERE  Object = :FdrList[i].Value 
                    AND  Status = :Status$FdrG
                    AND  StatusCount > 0;

                  IF x = 1 THEN
                     RetCode = CALLPROC FMS_ObjStatDel (
                         Object = FdrList[i].Value,
                         Terminal = 0,
                         Status = Status$FdrG);
                  ELSEIF x > 1 THEN
                     RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                         Object = FdrList[i].Value,
                         Status = Status$FdrG,
                         Increment = -1,
                         TimeSet = Date('now'));
                  ELSE
                     RetCode = 0;
                  ENDIF;

                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to reset Feeder Ground status for the current feeder. ' +
                        'Please reset the status manually.';
                  ELSE
                     CALLPROC DDB_COMMIT;
                  ENDIF;
               ENDFOR;
            ENDIF;
         ENDIF;
      ENDIF;   // FMS app
   ENDIF; 
END;

