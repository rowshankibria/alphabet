	Name:            OpStepStartTimeUpdate

/*
**
**	Copyright c 1994 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:         OpStepStartTimeUpdate
**
**  Modifications:
**   05/04/04  em   Created in support of Operating Step enhancement.
**   05/05/04  pkw  Validate that time entered is not in future or 
**                  less than issue time of job.
*/
INITIALIZE
(
#  include StandardDeclarations
   PassedTime = DATE NOT NULL WITH DEFAULT;    
   MinTime    = DATE NOT NULL WITH DEFAULT;
   TORS       = INTEGER NOT NULL;
   Job        = INTEGER NOT NULL;
) =
BEGIN
   NewTime = PassedTime;
/*
**  Find minimum time allowed to enter.
*/
   IF TORS = Job$TakeOutInt THEN
      SELECT :MinTime = IFNULL(TOIssued,'')
      FROM    SOA_Job
      WHERE   Job = :Job;
   ELSE
      SELECT :MinTime = IFNULL(RSIssued,'')
      FROM    SOA_Job
      WHERE   Job = :Job;  
   ENDIF;
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN

    IF NewTime = '' OR NewTime IS NULL THEN
       Message 'You cannot clear operating step start time.';
       NewTime = PassedTime;
       RESUME;
    ENDIF;

    IF NewTime > PassedTime THEN
       MESSAGE 'Sorry, you cannot set the start time later than the default time. ';
       NewTime = PassedTime;
       RESUME;
    ENDIF;

    IF NewTime < MinTime THEN
       MESSAGE 'Sorry, you cannot set the start time earlier than the time the job was issued (' + 
               VARCHAR(MinTime) + '). ';
       NewTime = PassedTime;
       RESUME;
    ENDIF;

    PassedTime = NewTime;
    RETURN;
END;



ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

