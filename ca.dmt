**  Application:    CAC
**  Class:          WorkGroupRequestClass
**
**  Date:       Version Description
** ----------------------------------
**  05/27/09  ysp  Created.
**  06/26/09  ysp  Reply-to is valid for PST only
**  10/06/09  ysp  Pass circuit id to the Substation field in the incoming message
**  02/27/17  em   Updated InService timestmp if needed when returning work group response.
**  03/20/17  em   Remove prior change, not going inservice on email response.
**  05/04/18  ysp  Add Priority attribute
**  05/11/18  em   Add Ack attribute
*/ 
METHOD LoadRequest (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   CardObject   = TLSCard_ASE;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   i = 0;
   SELECT :i = 1,
          :CurObject.RequestID = R.RequestID,
          :CurObject.Status = R.Status,
          :CurObject.Card = R.Card,
          :CurObject.Job = R.Job,
          :CurObject.JobClass = J.JobClass,
          :CurObject.RequestType = JC.TOMove,
          :CurObject.WorkGroup = R.WorkGroup,
          :CurObject.Circuit = R.Circuit,
          :CurObject.RouteName = C.RouteName,
          :CurObject.LineNumber = C.Linenumber,
          :CurObject.LineType = C.LineType,
          :CurObject.Priority = C.Priority,
          :CurObject.MeetTime = R.MeetTime,
          :CurObject.Location = R.Location,
          :CurObject.DOComment = R.DOComment,
          :CurObject.IssuedByDO = R.IssuedByDO,
          :CurObject.DownloadTime = R.DownloadTime
   FROM   TC_WorkGroupRequest R,
          TC_Card C,
          TC_Job J,
          FMS_JobClass JC
   WHERE  R.RequestID = :CurObject.RequestID AND
          R.Card = C.Card AND 
          R.Job  = J.Job AND
          J.JobClass = JC.JobClass;
   CALLPROC DDB_ROLLBACK;

   IF i = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'WorkGroupRequestClass.LoadRequest; Invalid Request ID - ' + VARCHAR(CurObject.RequestID);
      CurMethod.Trace(Text = varchar(date('now')) + ' : WorkGroupRequestClass.LoadRequest; Invalid Request ID - ' + 
				VARCHAR(CurObject.RequestID));
      RETURN;      
   ENDIF;

   IF CurObject.Status = Order$Downloaded THEN
      CurObject.StatusName = 'ISSUED';
   ELSEIF CurObject.Status = Order$Closed THEN
      CurObject.StatusName = 'RESPONDED';
   ELSEIF CurObject.Status = Order$ConfirmClosed THEN
      CurObject.StatusName = 'COMPLETED';
   ELSEIF CurObject.Status = Order$Rescinded THEN
      CurObject.StatusName = 'RESCINDED';
   ELSEIF CurObject.Status = Order$ConfirmRescinded THEN
      CurObject.StatusName = 'RESCINDED';
   ENDIF;

   CurObject.LineTypeName = CALLPROC GetCircuitReportCategory(
                                CircuitType = CurObject.LineType);
/*
** load email recipients
*/
   CurObject.Recipients.Clear();
   j = 1;
   SELECT :CurObject.Recipients[j].Name = Name,
          :CurObject.Recipients[j].RecipientID = RecipientID,
          :CurObject.Recipients[j].Grouping = Grouping,
          :CurObject.Recipients[j].ResponseTime = ResponseTime,
          :CurObject.Recipients[j].RespondedBy = RespondedBy,
          :CurObject.Recipients[j].ResponseText = ResponseText,
          :CurObject.Recipients[j].ResponseComment = ResponseComment
   FROM   TC_WGRequestRecipient
   WHERE  RequestID = :CurObject.RequestID
   ORDER BY ResponseTime ASC
   BEGIN
      j = j + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** load substations and feeders
*/
   CardObject.Circuit = CurObject.Circuit;
   CardObject.LoadFeedersAndStations();

   CurObject.Feeders = CardObject.C.Feeders;
   CurObject.Stations = CardObject.C.Stations;
END;


METHOD RespondToRequest (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   ResponseComplete = INTEGER NOT NULL;     /*Counter*/
   MsgText = VARCHAR(400) NOT NULL WITH DEFAULT;
   Operator = INTEGER NOT NULL WITH DEFAULT;
   OperatorName = VARCHAR(40) NOT NULL WITH DEFAULT;
   PrevTime = DATE NOT NULL WITH DEFAULT;
   prevBy = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   RespondedBy = VARCHAR(40) NOT NULL WITH DEFAULT;
   Respondents = VARCHAR(80) NOT NULL WITH DEFAULT;
   Subject = VARCHAR(160) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   PrevTime  = '';
   REPEATED
   SELECT :PrevTime = W.ResponseTime,
          :PrevBy = W.RespondedBy,
          :CurObject.Card = R.Card,
          :CurObject.Job = R.Job,
          :CurObject.TORS = R.TORS,
          :CurObject.WorkGroup = R.WorkGroup,
          :CurObject.Circuit = C.Circuit,
          :CurObject.LineNumber = C.Linenumber
   FROM   TC_WGRequestRecipient W,
          TC_WorkGroupRequest R,
          TC_Card C
   WHERE  W.RequestID = :CurObject.RequestID AND
          W.RecipientID = :CurObject.Recipients[1].RecipientID AND
          R.RequestID = :CurObject.RequestID AND
          R.Card = C.Card;
    
   IF PrevTime <> '' THEN
      CurObject.ReturnCode = -2;    // let the client knows this.
      CurObject.ErrorMessage = 'Request has already been responded by ' + PrevBy + '. Your response is ignored.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : WorkGroupRequestClass.RespondToRequest; ' + 
             'Request has been responded.');
      RETURN;
   ENDIF;

   IF CurObject.TORS = 0 THEN
      SELECT
          :CurObject.Operator = J.TOOperator,
          :CurObject.OperatorName = J.TOOperatorName,
          :CurObject.JobClass = J.JobClass
      FROM   TC_Job J
      WHERE  J.Job = :CurObject.Job;
   ELSE
      SELECT
          :CurObject.Operator = J.RSOperator,
          :CurObject.OperatorName = J.RSOperatorName,
          :CurObject.JobClass = J.JobClass
      FROM   TC_Job J
      WHERE  J.Job = :CurObject.Job;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
/*
** An incoming message is sent to the DO after responses have been received from
** all groups. But for Setup Meet request, if the first group confirms with an
** alternate meet time, the request is also considered complete because it is 
** assumed that the PST groups have discussed and agreed on the meet time.
**
*/
   ResponseComplete = FALSE;
   i = 0;
   SELECT :i = COUNT(*)
   FROM   TC_WGRequestRecipient W
   WHERE  W.RequestID = :CurObject.RequestID AND
          W.ResponseTime = '';

   IF i = 1 THEN 
      ResponseComplete = TRUE;
   ELSEIF CurObject.JobClass = JobClass$SetupMeet AND 
          LOWERCASE(CurObject.Recipients[1].ResponseText) LIKE '%alternate%' THEN
      ResponseComplete = TRUE;
   ENDIF;
/*
** save this response 
*/
   CurObject.Recipients[1].ResponseTime = Date('now');
   RetCode = CALLPROC TC_WGRequestResponded(
                      RequestID = CurObject.RequestID,
                      RecipientID = CurObject.Recipients[1].RecipientID,
                      ResponseTime = CurObject.Recipients[1].ResponseTime, 
                      RespondedBy = CurObject.Recipients[1].RespondedBy,
                      ResponseText = CurObject.Recipients[1].ResponseText,
                      ResponseComment = CurObject.Recipients[1].ResponseComment);

   IF RetCode = -1 THEN   
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error saving work group response. Try again.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : WorkGroupRequestClass.RespondToRequest; ' + 
             'Error saving work group response.');
      RETURN;
   ENDIF;

/* 
** send an incoming message to the DO
*/
   IF ResponseComplete = FALSE THEN
      CALLPROC DDB_COMMIT;
   ELSE
      /* response is complete. Tie job completion and response together.
      */
      CurObject.Status = Order$Closed;
      CurObject.StatusName = 'RESPONDED';

      RetCode = CALLPROC TC_WGRequestStatusUpd(
                            RequestID = CurObject.RequestID,
                            Status = CurObject.Status);

      IF RetCode = 0 THEN
         /*
         ** set complete time stamp
         */    
         RetCode = CALLPROC TC_CompleteJob (
                    Job = CurObject.Job,
                    Operator = CurObject.Operator,
                    OperatorName = CurObject.OperatorName,
                    Complete = Date('now'),
                    TORS = CurObject.TORS);
      ENDIF;

      IF RetCode = 0 THEN   
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error saving work group response. Try again.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : WorkGroupRequestClass.RespondToRequest; ' + 
             'Error saving work group response.');
         RETURN;
      ENDIF;

      RetCode = CALLPROC TC_UpdateResults (
                       Job = CurObject.Job,
                       Results = 'MB2 for Response');

      CALLPROC DDB_RaiseDBEvent (DBEventName = 'TC_JobUpdated',
                                 DBEventText = VARCHAR(CurObject.Job) + ';');
      CALLPROC DDB_COMMIT;

      CALLPROC TC_LogChange (
                 Card = CurObject.Card, 
                 Job = CurObject.Job,
                 Item = 'Work Group Response',
                 Old = CurObject.Recipients[1].RespondedBy,
                 New = CurObject.Recipients[1].ResponseText + '. ' + CurObject.Recipients[1].ResponseComment);
      CALLPROC DDB_COMMIT;
   /* 
   ** Send incoming message
   */
      Respondents = '';
      SELECT :RespondedBy = W.RespondedBy 
      FROM   TC_WGRequestRecipient W
      WHERE  W.RequestID = :CurObject.RequestID AND
             W.ResponseTime <> ''
      BEGIN
         IF Respondents = '' THEN
            Respondents = RespondedBy;
         ELSE
            Respondents = Respondents + ' and ' + RespondedBy;
         ENDIF;
      END;

      MsgText = 'TLS EMAIL RESPONDED' + HC_NEWLINE; 

      IF CurObject.JobClass = JobClass$SetupMeet THEN
         Subject = 'Set Up Meet';
         MsgText = MsgText + CurObject.WorkGroup + ', ' + Respondents + ', responded to "' + Subject  + '": ' + HC_NEWLINE;
         MsgText = MsgText + CurObject.Recipients[1].ResponseText + HC_NEWLINE;
      ELSEIF CurObject.JobClass = JobClass$PSTSupport THEN
         Subject = 'Request PST Support';
         MsgText = MsgText + CurObject.WorkGroup + ', ' + Respondents + ', responded to "' + Subject  + '": ' + HC_NEWLINE;
      ELSEIF CurObject.JobClass = JobClass$RequestCrew THEN
         Subject = 'Request Crew';
         MsgText = MsgText + CurObject.WorkGroup + ', ' + Respondents + ', responded to "' + Subject  + '": ' + HC_NEWLINE;
      ELSEIF CurObject.JobClass = JobClass$ArrangeAccess THEN
         Subject = 'Arrangement for Access' ;
         MsgText = MsgText + CurObject.WorkGroup + ', ' + Respondents + ', responded to "' + Subject  + '": ' + HC_NEWLINE;
         MsgText = MsgText + CurObject.Recipients[1].ResponseText + HC_NEWLINE;
      ENDIF;

      IF CurObject.Recipients[1].ResponseComment <> '' THEN
         MsgText = MsgText + 'Remark: ' + CurObject.Recipients[1].ResponseComment;
      ENDIF;

      RetCode = CALLPROC MSG_SendMsg (Card = CurObject.Card,
                                  Action = 0,
                                  OrderNumber = CurObject.RequestID,
                                  Substation = CurObject.Circuit,
                                  SubstationName = CurObject.LineNumber,
                                  Msg = MsgText,
                                  FromOpName = 'FMS Online',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'TLS',
                                  FromApp = 'FMS Online',
                                  Priority = 1
                                  );
      IF RetCode <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = varchar(date('now')) + ' : WorkGroupRequestClass.RespondToRequest; ' + 
                   'Unable to send incoming message to DO for working group response.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   /*
   ** trigger reply-all
   */
   IF CurObject.WorkGroup = 'PST' THEN
      CALLPROC InsertDBEventQueue(
                  ToApp = 'TLS',
                  EventName = 'WG_SendReplyAll', 
                  EventText = VARCHAR(CurObject.RequestID) + ';' + VARCHAR(CurObject.Recipients[1].RecipientID));  
   ENDIF; 
END;

Application Component Report
============================

	Name:            WorkLocationProtectionComparison

/*
**      Copyright c 2019 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    Feedercard
**  Frame:          WorkLocationProtectionComparison
**
**  Date:    Author   Description
** ----------------------------------
**  07/25/19  em     Created
**  08/20/19  em     Add Protection Quality return parameter
**  09/17/19  em     Change POOR to QUESTIONABLE and hide path column
**                   Add DiffDistance return parameter
*/
INITIALIZE 
(
   DiffDistance = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   ProtectionQuality = INTEGER NOT NULL WITH DEFAULT;  
ENDDECLARE 
BEGIN
   ProtectionQuality = 0;
   DiffDistance = 0;
   FOR i = 1 TO WPC.LastRow DO
      IF WPC[i].SEquip = WPC[i].AEquip THEN
         WPC[i].MatchQuality = 'MATCH';
         FIELD(WPC[i].MatchQuality).BgColor = CC_LIGHT_GREEN;
      ELSEIF WPC[i].AEquip > 0  AND (WPC[i].ADistance - WPC[i].SDistance) <= WP_ProtCompDistance THEN
         WPC[i].MatchQuality = 'OK';
         FIELD(WPC[i].MatchQuality).BgColor = CC_PALE_GREEN;
         IF (WPC[i].ADistance - WPC[i].SDistance) > DiffDistance AND ProtectionQuality = 0 THEN
            DiffDistance = WPC[i].ADistance - WPC[i].SDistance;
         ENDIF;
      ELSEIF WPC[i].AEquip > 0  AND (WPC[i].ADistance - WPC[i].SDistance) > WP_ProtCompDistance THEN
         WPC[i].MatchQuality = 'QUESTIONABLE';
         FIELD(WPC[i].MatchQuality).BgColor = CC_YELLOW;
         FIELD(WPC[i].SDistance).BgColor = CC_YELLOW;
         FIELD(WPC[i].ADistance).BgColor = CC_YELLOW;
         IF ProtectionQuality = 0 THEN
            ProtectionQuality = 1;
         ENDIF;
         IF (WPC[i].ADistance - WPC[i].SDistance) > DiffDistance AND ProtectionQuality = 1 THEN
            DiffDistance = WPC[i].ADistance - WPC[i].SDistance;
         ENDIF;
      ELSEIF WPC[i].SEquip > 0 AND WPC[i].AEquip = 0 THEN
         WPC[i].MatchQuality = 'MISSING';
         FIELD(WPC[i].MatchQuality).BgColor = CC_RED;
         IF ProtectionQuality <= 1 THEN
            ProtectionQuality = 2;
            DiffDistance = 0;       /* Reset since we don't want to show distance for MISSING */
         ENDIF;
      ENDIF; 
   ENDFOR;
   IF ProtectionQuality < 2 THEN
      RETURN :ProtectionQuality;
   ENDIF;
END;

ON CLICK ok_btn =
BEGIN
   RETURN ProtectionQuality;
END;

Application Component Report
============================

	Name:            WorkLocationProtectionTrace

/*
**      Copyright c 2019 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          WorkLocationProtectionTrace
**
**  Date:    Author   Description
** ----------------------------------
**  02/01/19  em     Created
**  02/20/19  em     Skip trace for No Match Equip.
**  03/07/19  em     Add GroundBankPrimry move for Grd-SwTrf target
**  03/15/19  em     Add Link to Find Match on Diagram
**  04/02/19  em     Modify HTV-G lookup, no subtypes.  
**                   Extend trace past NGS equipment.
**  06/24/19  em     LocalGrounds logic, no trace needed
**  07/08/19  em     Add EquipToSkip attribute for situation when another permit's
**                   work location was used as a protection point.
**                   WLEquip parameter will be used both for incoming and return.  If 
**                   the incoming WLEquip array is empty EquipToSkip will be set to FALSE and 
**                   will be evaluated to establish the WLEquip outgoing parameter.  When
**                   WLEquip has rows, EquipToSkip will be set to TRUE and target equipment 
**                   will be compared to the WLEquip list and skipped if a match is found.  
**  07/11/19  em     Look at WP PickupEquip list for out of scope equipment, if closer than
**                   in scope target, then determine if Protective Ground N move should be linked
**                   to the permit.  Return N Job in EquipWithJob array.
**  07/22/19  em     ISO Pickup Equipment will meet protection requirement on a single path, do not also need to 
**                   return next closest. Introduce PUConditionMet to make this work.
**  07/24/19  em     If Work Location not in feeder scope but is a pickup equipment for the work permit,
**                   then add the protection move as an N move
**  07/25/19  em     Implement temporary suggested vs actual comparison with new incoming ProtEq array
**  08/05/19  em     Correction to Line 789 Array out of range error
**  08/06/19  em     Add second Block Open Deload move for Local Grounds for equip type I.
**                   Ignore Excavation work locations.
**                   For No Match work location, look for New Bank equip match in PU Equip list and  
**                   if type NWP or HTV with outstanding protective ground move, load "N" move.
**  08/07/19  em     Remove Source Position equipment from Protection List.  Will already be ground at Station.
**  08/08/19  em     Manage PUEq2 up top when matching diagram equipment
**  08/20/19  em     Save selected work point when resolving No Match
**  08/22/19  em     Save leg list for protection comparison 
**  09/18/19  em     Remove check for Actual = 0 to allow a closer actual.
**                   Incorporate DidIpassThruDM to all potential for an additional ground on a path
**  09/25/19  em     Can't depend on ProtEq to contain value when needing to do comparison, add specific CompareFlag parm
**  02/13/20  em     Evaluate for invalid diagram and present message (not doing this until after 
**                   we know we have FCR work locations) 
**  03/02/20  em     Attempt to correct row out of range error when comparing actual to suggested.
**  09/22/20  em     Include Feeder ISO equipment in feederscope.  This is a change that conflicts with code comment, so
**                   not sure if creating a problem for another use of this trace.
*/
INITIALIZE 
(
   WorkPermit            = INTEGER NOT NULL;   /* Passed object ID */
   Card                  = INTEGER NOT NULL;   /* Passed Card ID */
   ProtEq    			 = ARRAY OF INTEGEROBJECT; /* Optional passed list of protection equip objects */
   CompareFlag           = INTEGER NOT NULL WITH DEFAULT;   /* Optional incoming parm, used for protection comparison */
   EquipWithJob          = ARRAY OF Job;   /* Return List containing Equip ID with JobClass ID */
   WLEquip               = ARRAY OF INTEGEROBJECT;   /* Out Parameter when EquipToSkip=1 */
   LG 					 = ARRAY OF EQUIPMENT; /*Out Parameter for Local Grounds */
   WPC                   = ARRAY OF WPComparison;  /*Out parameter for ProtectionCheckConfirm */
) =
DECLARE
   d = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   i = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   j = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   k = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   m = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   n = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   q = INTEGER NOT NULL WITH DEFAULT; /*Counter*/

   ComputerName  = VARCHAR(40) NOT NULL WITH DEFAULT;
   DiagramID = INTEGER NOT NULL WITH DEFAULT;
   DE = ARRAY OF Equipment; /* Diagram Equipment List */
   FeederScope = ARRAY OF INTEGEROBJECT;
   FeederID = INTEGER NOT NULL WITH DEFAULT;
   Distance = FLOAT NOT NULL WITH DEFAULT;
   Idx = INTEGER NOT NULL WITH DEFAULT;
   LockCombo = INTEGER NOT NULL WITH DEFAULT;
   NWPTypes = ARRAY OF INTEGEROBJECT;
   HTVTypes = ARRAY OF INTEGEROBJECT;
   PADMTypes = ARRAY OF INTEGEROBJECT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SkipEquip = INTEGER NOT NULL WITH DEFAULT;
   SkipProtection = INTEGER NOT NULL WITH DEFAULT;
   Status = INTEGER NOT NULL WITH DEFAULT;
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   Trace = Trace_FeederTargetGrounds;
   WorkPointEquip = EQUIPMENT;
   NGS = ARRAY OF EQUIPMENT;
   PUEq = ARRAY OF EQUIPMENT;
   PUEq2 = ARRAY OF EQUIPMENT;

    CharFind = INTEGER NOT NULL WITH DEFAULT;
    FoundStart = INTEGER NOT NULL WITH DEFAULT;
    WordLength = INTEGER NOT NULL WITH DEFAULT;
    Word = VARCHAR(40) NOT NULL WITH DEFAULT;
    SingleChar = CHAR(1) NOT NULL WITH DEFAULT;
    LastRow = INTEGER NOT NULL WITH DEFAULT;
    FoundDupe = INTEGER NOT NULL WITH DEFAULT;
    DuplicateExists = INTEGER NOT NULL WITH DEFAULT;
    DuplicateLeg = INTEGER NOT NULL WITH DEFAULT;

   EventText = VARCHAR(260) NOT NULL WITH DEFAULT;
   EquipToSkip           = INTEGER NOT NULL WITH DEFAULT;   
   LegsOK = INTEGER NOT NULL WITH DEFAULT;
   MatchRow = INTEGER NOT NULL WITH DEFAULT;
   QGISCalled = INTEGER NOT NULL WITH DEFAULT;
   w = INTEGER NOT NULL WITH DEFAULT;
   WP_ProtectionComparison = INTEGER NOT NULL WITH DEFAULT;
   NewBankPickUp = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN
   ComputerName = CurSession.GetEnv(name = 'COMPUTERNAME');
   IF ComputerName = '' THEN
       Message 'Application is not setup properly.' + HC_NEWLINE
          +   'A COMPUTERNAME environmental variable is required.';
       RETURN PU_CANCEL;                  /* Application is not usable. */
   ENDIF; 
/*
** Set internal variable to indicate we are comparing actual with suggested.
*
   IF ProtEq.LastRow > 0 THEN
*/
   IF CompareFlag > 0 THEN
      WP_ProtectionComparison = TRUE;
   ELSE
      WP_ProtectionComparison = FALSE;
   ENDIF;
   
   IF WLEquip.LastRow = 0 THEN
      EquipToSkip = FALSE;
   ELSE
      EquipToSkip = TRUE;
   ENDIF;

   EquipWithJob.Clear();
   WL.Clear();
   LegsOK = TRUE;
   i = 1;
   /* all work location attributes are *hidden" using attributes from the Equipment Class */
   REPEATED
   SELECT 
   DISTINCT 
          :WL[i].OwnerNumber = WL.LocationStructure,  /* structure loaded in ownernumber field */
          :WL[i].EquipComment = RL.TagsRequested,     /* tags requested loaded in equipcomment */
          :WL[i].PrimaryGrouping = WL.WPLocation,     /* location index loaded in primarygrouping field */
          :WL[i].LocationObject = WL.MatchEquip,      /* no match work point loaded in locationobject field */
          :WL[i].Combination = WL.MatchLeg,           /* selected legs loaded in combination field */
          :WL[i].CurrentlyOpen = 0                    /* Local Grounds Boolean stored in currentlyopen */
   FROM   IR_WorkLocation WL,
          IR_RFPLocation RL,
          IR_RequestForPermit RFP
   WHERE  WL.WorkPermit = :WorkPermit AND
          WL.RFP = RL.RFP AND
          WL.RFPLocation = RL.RFPLocation AND
          RL.RFP = RFP.RFP AND
          RL.RevisionNumber = RFP.RevisionNumber AND
          RFP.RFPStatus = 0
   ORDER BY 1
   BEGIN
   /* Remove open excavation work locations */
              IF UPPERCASE(WL[i].OwnerNumber) LIKE 'OPEN EX%' OR 
                  UPPERCASE(WL[i].OwnerNumber) LIKE '%EXCAV%' THEN
                 WL.RemoveRow (RowNumber = i );
                 i = i - 1;
              ELSE
   /* Parse for numeric portion of name and save in Barcode field. */
              Word = WL[i].OwnerNumber;
              WHILE LENGTH(Word) >= 1 DO
                 SingleChar = LEFT(Word,1);     
                 IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
                    CharFind = LOCATE(Word, '-');
                    IF CharFind = (SIZE(Word) + 1) THEN
                       WL[i].BarCode = Word;
                    ELSE
                       WL[i].BarCode = LEFT(Word,CharFind-1);
                    ENDIF;
                    ENDLOOP;
                 ELSE
                    Word = SHIFT(Word, -1);
                 ENDIF;
              ENDWHILE;
              IF Word = '' THEN
                 CurFrame.Trace (text = VARCHAR(DATE('now')) + ' : ' +
                         'Not able to parse for numeric portion of RFP Location ' + WL[i].OwnerNumber +
                         '. Cannot match to diagram equipment for trace.');
                 WL[i].BarCode = '-999';
              ENDIF;
              IF UPPERCASE(WL[i].EquipComment) LIKE '%LOCAL GROUNDS%' THEN
                 WL[i].CurrentlyOpen = 1;  /* To be evaluated later */
              ENDIF;
              ENDIF;
      i = i + 1;
   END;
/*
** If no work locations, can exit immediately
*/   
   IF WL.LastRow = 0 THEN
      RETURN PU_CANCEL;
   ELSEIF CardDetails.ValidDiagram = FeederDiagram$Invalid THEN
       MESSAGE 'Will not perform trace to identify protection because Feeder Diagram ' +
               'has been marked invalid.  Please ask core group member to validate Feeder Diagram.';
       RETURN PU_CANCEL;
   ENDIF;
/*
** Identify Feeder Diagram using card.
*/   
   DiagramID = 0;
   REPEATED
   SELECT :DiagramID = G.Grouping,
          :FeederID = G.Member
   FROM   Udb_Grouping G,
          TFMS_CardToObject CTO
   WHERE  G.GroupingType = :Type$FeederDiagram AND
          G.Relationship = :Interaction$ShownOn AND
          G.Member = CTO.Object AND
          CTO.Type = :Type$Feeder AND
          CTO.Card = :Card;
/*
** Might need to go up a level from an ISO Feeder
*/   
   IF DiagramID = 0 THEN
    
   SELECT :DiagramID = G.Grouping,
          :FeederID = G.Member
   FROM   Udb_Grouping G,
          Udb_Grouping G2,
          TFMS_CardToObject CTO
   WHERE  G.GroupingType = :Type$FeederDiagram AND
          G.Relationship = :Interaction$ShownOn AND
          G.Member = G2.Grouping AND
          G2.GroupingType = :Type$Feeder AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.Member = CTO.Object AND
          CTO.Card = :Card;
   ENDIF;
/*
** If no Feeder Diagram, can exit immediately
*/   
   IF DiagramID = 0 THEN
      RETURN PU_CANCEL;
   ENDIF;
/*
** Load the scope of card feeder equipment, want to ignore dropped equipment /*enabled ISO 9/22/20* / 
** that may appear on the diagram but should not be used for protection.
** Future enhancement will load N moves for out of scope equip if it is being picked up.
*/
   FeederScope.Clear();
   i = 1;
   REPEATED
   SELECT :FeederScope[i].Value = G.Member
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET,
          TFMS_CardToObject CTO
   WHERE  ET.SuperType = :Type$Switch AND 
          G.MemberType = ET.Type AND 
          G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                              WHERE  SuperType = :Type$Feeder) AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = CTO.Object AND
          CTO.Card = :Card
   UNION
   SELECT G2.Member
   FROM   Udb_Grouping G,
          Udb_Grouping G2,
          Udb_ExtendedType ET,
          TFMS_CardToObject CTO
   WHERE  ET.SuperType = :Type$Switch AND 
          G2.MemberType = ET.Type AND 
          G2.Relationship = :Interaction$MemberOf AND
          G.Member = G2.Grouping AND
          G.MemberType = :Type$ISOFeeder AND
          G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                              WHERE  SuperType = :Type$Feeder) AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = CTO.Object AND
          CTO.Card = :Card
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
/*
** Load Diagram Equipment and parse number out of the name.
*/ 
   DE.Clear();
   i = 1;
   SELECT :DE[i].Equip = Object,
          :DE[i].EquipClassName = TypeName,
          :DE[i].EquipClass = Type,
          :DE[i].EquipName = Name
   FROM   DSO_Object
   WHERE  Pocket = :DiagramID
   ORDER BY EquipName
   BEGIN
   /* Parse for numeric portion of name and save in Barcode field. */
              Word = DE[i].EquipName;
              WHILE LENGTH(Word) >= 1 DO
                 SingleChar = LEFT(Word,1);     
                 IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
                    CharFind = LOCATE(Word, '-');
                    IF CharFind = (SIZE(Word) + 1) THEN
                       CharFind = LOCATE(Word, ':');
                       IF CharFind = (SIZE(Word) + 1) THEN
                          DE[i].BarCode = Word;
                       ELSE
                          DE[i].BarCode = LEFT(Word,CharFind-1);
                       ENDIF;
                    ELSE
                       DE[i].BarCode = LEFT(Word,CharFind-1);
                    ENDIF;
                    ENDLOOP;
                 ELSE
                    Word = SHIFT(Word, -1);
                 ENDIF;
              ENDWHILE;
      
      i = i + 1;
   END;
/*
** Load equipment scheduled to be picked up with this work permit
*/
   PUEq.Clear();
   i = 1;
   SELECT :PUEq[i].Equip = WE.Equip,
          :PUEq[i].EquipClassName = O.TypeName,
          :PUEq[i].EquipClass = O.Type,
          :PUEq[i].EquipName = O.Name
   FROM   IR_WorkEquipment WE,
          Udb_Object O
   WHERE  WE.WorkPermit = :WorkPermit AND
          WE.Type = 1 AND   /* PICK UP */
          WE.Equip = O.Object
   ORDER BY 1
   BEGIN
   /* Parse for numeric portion of name and save in Barcode field. */
              Word = PUEq[i].EquipName;
              WHILE LENGTH(Word) >= 1 DO
                 SingleChar = LEFT(Word,1);     
                 IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
                    CharFind = LOCATE(Word, '-');
                    IF CharFind = (SIZE(Word) + 1) THEN
                       PUEq[i].BarCode = Word;
                    ELSE
                       PUEq[i].BarCode = LEFT(Word,CharFind-1);
                    ENDIF;
                    ENDLOOP;
                 ELSE
                    Word = SHIFT(Word, -1);
                 ENDIF;
              ENDWHILE;

      i = i + 1;
   END;
   /* Create second pass list */
   PUEq2 = PUEq.Duplicate();
  
/* Find matches using numeric portion of names */
   j = WL.LastRow;
   k = 0;
   DuplicateExists = FALSE;
   DuplicateLeg = FALSE;
   WHILE j > 0 DO
      FoundDupe = FALSE;
      WL[j].Equip = 0;
      FOR i = 1 TO DE.LastRow() DO
      /* Compare numeric portion or whole name */
         IF WL[j].BarCode = DE[i].BarCode OR WL[j].OwnerNumber = DE[i].EquipName THEN
            /* 
            ** If we are doing a comparison, check for Leglist and skip diagram equip on legs that 
            ** were not selected. 
            */
            IF WP_ProtectionComparison = TRUE THEN
               IF WL[j].Combination <> '' THEN
                        IF DE[i].EquipName LIKE 'M%:L%' THEN
                           SingleChar = 'L';
                        ELSEIF DE[i].EquipName LIKE 'M%:M%' THEN
                           SingleChar = 'M';
                        ELSEIF DE[i].EquipName LIKE 'M%:R%' THEN
                           SingleChar = 'R';
                        ELSEIF DE[i].EquipName LIKE 'M%:J%' THEN
                           SingleChar = 'J';
                        ELSEIF DE[i].EquipName LIKE 'M%:K%' THEN
                           SingleChar = 'K';
                        ELSEIF DE[i].EquipName LIKE 'M%:W%' THEN
                           SingleChar = 'W';
                        ENDIF;
                        Status = LOCATE(WL[j].Combination,SingleChar);
                        IF Status = (SIZE(WL[j].Combination) + 1) THEN
                           CONTINUE;
                        ENDIF;
               ENDIF;
            ENDIF;

            IF FoundDupe = FALSE THEN
               FoundDupe = TRUE;    /* Indicates to look for duplicate on next iteration */
            ELSE                            
               IF DE[i].EquipName LIKE 'M%:L%' OR DE[i].EquipName LIKE 'M%:M%' OR
                  DE[i].EquipName LIKE 'M%:R%' OR DE[i].EquipName LIKE 'M%:J%' OR
                  DE[i].EquipName LIKE 'M%:K%' OR DE[i].EquipName LIKE 'M%:W%' THEN
                  /* Check for anomaly*/
                  m = 0;
                  SELECT :m = Feeder
                  FROM   FMS_3MAnomaly
                  WHERE  Feeder = :FeederID;
                  
                  IF m = FeederID THEN                  
                     DuplicateLeg = TRUE;
                  ELSE
                     LegsOK = FALSE;
                     DuplicateExists = TRUE;
                     FOR d = i-1 TO i DO    /* Go back one to make sure first gets enabled */
                        IF DE[d].EquipName LIKE 'M%:L%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.l_stack).CurBias = FB_CHANGEABLE;
                        ELSEIF DE[d].EquipName LIKE 'M%:M%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.m_stack).CurBias = FB_CHANGEABLE;
                        ELSEIF DE[d].EquipName LIKE 'M%:R%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.r_stack).CurBias = FB_CHANGEABLE;
                        ELSEIF DE[d].EquipName LIKE 'M%:J%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.j_stack).CurBias = FB_CHANGEABLE;
                        ELSEIF DE[d].EquipName LIKE 'M%:K%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.k_stack).CurBias = FB_CHANGEABLE;
                        ELSEIF DE[d].EquipName LIKE 'M%:W%' AND WP_ProtectionComparison = FALSE THEN
                           FIELD(leg_stack).CurBias = FB_CHANGEABLE;
                           FIELD(leg_stack.w_stack).CurBias = FB_CHANGEABLE;
                        ENDIF;
                     ENDFOR;
                  ENDIF;
               ELSE
                  DuplicateExists = TRUE;
               ENDIF;
               WL.InsertRow (RowNumber = j); /* we have a duplicate */
               WL[j].OwnerNumber = WL[j+1].OwnerNumber;
               WL[j].BarCode = WL[j+1].BarCode;
               WL[j].Combination = WL[j+1].Combination;
               WL[j].PrimaryGrouping = WL[j+1].PrimaryGrouping;
            ENDIF;
            WL[j].Equip = DE[i].Equip;
            WL[j].EquipClassName = DE[i].EquipClassName;
            WL[j].EquipName = DE[i].EquipName;
            /* Remove matched equipment from second pass list. */
            Status = PUEq2.Find (AttributeName = 'Equip',
                       Value = WL[j].Equip,
                       RowNumber = BYREF(q));
            IF Status = ER_OK THEN
               PUEq2.RemoveRow (rownumber = q);
            ENDIF;  
            /* Candidate Equip for Local Grounds cannot be a Manhole */
            IF DE[i].EquipClass = TypeName$MH THEN
               WL[j].CurrentlyOpen = 0; 
            ELSEIF EquipToSkip = FALSE THEN  /*Record equipment for return parm */
               k = k + 1;
               WLEquip.InsertRow (rownumber = k);
               WLEquip[k].Value = DE[i].Equip;
            ENDIF;
            
         ELSEIF FoundDupe = TRUE THEN  /*Can skip to end of FOR loop*/
            ENDLOOP; 
         ENDIF;
      ENDFOR;
      
      IF WL[j].Equip = 0 THEN
      
         RetCode = CALLPROC NewBankPickUp (NewEquip = WL[j]);
         IF RetCode = PU_CANCEL THEN
            /* Use previously saved match */
            IF WL[j].LocationObject > 0 THEN
               WL[j].Equip = WL[j].LocationObject;
               SELECT :WL[j].EquipClassName = TypeName,
                      :WL[j].EquipClass = Type,
                      :WL[j].EquipName = Name
               FROM   DSO_Object
               WHERE  Pocket = :DiagramID AND
                      Object = :WL[j].LocationObject; 
               IF EquipToSkip = FALSE AND WL[j].EquipClass <> TypeName$MH THEN  /*Record equipment for return parm */
                  k = k + 1;
                  WLEquip.InsertRow (rownumber = k);
                  WLEquip[k].Value = WL[j].Equip;
               ENDIF; 
            ELSE       
               WL[j].EquipName = 'No Match';
               WL[j].CurrentlyOpen = 0; 
               FIELD(FindMatch).CurBias = FB_LANDABLE;
            ENDIF;
         ELSE
            WL.RemoveRow (RowNumber = j);
         ENDIF;
      ENDIF;
      j = j - 1;
   ENDWHILE;
   /* Add protections for second pass list */
   q = PUEq2.LastRow;
   WHILE q >=1 DO
      CALLPROC NewBankPickUp (NewEquip = PUEq2[q]);
      q = q - 1;
   ENDWHILE;
/*
** If we don't need to find a match or select a leg we can continue
*/   
   IF FIELD(FindMatch).CurBias = FB_LANDABLE OR FIELD(leg_stack).CurBias = FB_CHANGEABLE THEN
      RESUME;
   ELSEIF WL.LastRow = 0 THEN   /* Must have found all work locations in new bank for pickup */
      RETURN PU_OK;
   ELSE
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'PerformTrace');
   ENDIF;
END;


ON CHILDENTRY wl =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
      RESUME;
   ENDIF;
    
   MatchRow = FIELD(wl).CurRow;
END;

ON CLICK FindMatch = 
DECLARE
   Widget_QGis = INTEGER;
   MaxX = INTEGER NOT NULL WITH DEFAULT;
   MinX = INTEGER NOT NULL WITH DEFAULT;
   MaxY = INTEGER NOT NULL WITH DEFAULT;
   MinY = INTEGER NOT NULL WITH DEFAULT;
   MinObj = INTEGER NOT NULL WITH DEFAULT;
   PosX = INTEGER NOT NULL WITH DEFAULT;
   PosY = INTEGER NOT NULL WITH DEFAULT;
   QGISCall = VARCHAR(256) NOT NULL WITH DEFAULT;
   ZoomLevel = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF MatchRow = 0 THEN
      MESSAGE 'No row selected.';
      RESUME;
   ENDIF;
   IF wl[MatchRow].EquipName <> 'No Match' THEN
      MESSAGE 'This row is already matched.';
      RESUME;
   ENDIF;
   
   IF CurSession.OperatingSystem = SY_NT THEN
      CurFrame.RegisterUserEvent(EventName = 'ext_qgis_work_point');
   ENDIF;
   
   ZoomLevel = 0;
   SELECT :MaxX = Max(Pos_x),
          :MinX = Min(Pos_x),
          :MaxY = Max(Pos_y),  
          :MinY = Min(Pos_y),
          :MinObj = Min(Object)
   FROM   DSO_Object
   WHERE  Pocket = :DiagramID;
/*   
** Use another work location on diagram if available
*/
   FOR i = 1 TO wl.LastRow DO
      IF i <> MatchRow and wl[i].Equip <> 0 THEN
         MinObj = wl[i].Equip;
         ENDLOOP;
      ENDIF;
   ENDFOR;
   
   SELECT :PosX = Pos_x,
          :PosY = Pos_y
   FROM   DSO_Object
   WHERE  Pocket = :DiagramID AND
          Object = :MinObj;

   MaxX = MaxX - MinX;
   MaxY = MaxY - MinY;
   IF MaxY > MaxX THEN
      MaxX = MaxY;
   ENDIF;

   IF MaxX < 100000 THEN
      ZoomLevel = MaxX / 10000;
      IF ZoomLevel = 0 THEN
         ZoomLevel = 1;
      ENDIF;
   ELSE
      ZoomLevel = 10 + ((MaxX - 100000) / 20000);
   ENDIF;

   RetCode = CALLPROC QGIS_ExternalEventIns(
                              EventDate = DATE('now'),
                              ComputerName = ComputerName,
                              EventType = 'IDENTIFYWL',
                              EventText = 'Diagram=' + VARCHAR(DiagramID) + ';' +
                                          'NewMHName=' + 
                                           wl[MatchRow].OwnerNumber + ';' +
                                          'X=' + VARCHAR(Posx) + ';' +
                                          'Y=' + VARCHAR(Posy) + ';' +
                                          'Zoom=' + VARCHAR(ZoomLevel) + ';' 
                                          );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Call to QGIS failed due to error';
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;      

   QGISCall = 'qgis_launch';
   DDB_Global.TopFrame.Trace
          (   Text =  varchar(date('now')) + ':CallQGIS: ' + QGISCall 
          );
   CALL SYSTEM :QGISCall;              
   
   // bring Qgis screen to the foreground
   Sleep(1);
   Widget_QGis = CALLPROC FindWindowA('QWidget', 'QGIS Diagram Editor');
   CALLPROC ShowWindow(Widget_QGis, 1);
   CALLPROC SetForegroundWindow(Widget_QGis);              
END;


ON UserEvent 'ext_qgis_work_point' = 
DECLARE
   WorkPoint = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN  
   CALLPROC ShowWindow(CurFrame.WidgetID,1);
   CALLPROC SetForegroundWindow(CurFrame.WidgetID);
   QGISCalled = TRUE;

   WorkPoint = CurFrame.MessageInteger;
   CurFrame.UnRegisterUserEvent(EventName = 'ext_qgis_work_point');
   DDB_Global.TopFrame.Trace
          (   Text =  varchar(date('now')) + ': Received from QGIS Object ID ' + VARCHAR(WorkPoint) 
          );
   wl[MatchRow].Equip = WorkPoint;
   SELECT :wl[MatchRow].EquipName = Name,
          :wl[MatchRow].EquipClass = Type
   FROM   DSO_Object 
   WHERE  Object = :WorkPoint AND
          Pocket = :DiagramID;
/* 
** Save Match for future use
*/ 
   RetCode = CALLPROC FMS_MatchEquipUpd (
                          WorkPermit = WorkPermit,
                          WPLocation = WL[MatchRow].PrimaryGrouping, /* Hidden WPLocation*/
                          MatchEquip = WorkPoint);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Warning, Not able to save diagram equipment selection for future use.';
   ENDIF;                       
/*
** Add to WLEquip if we are building list.
*/          
   IF EquipToSkip = FALSE AND DE[i].EquipClass <> TypeName$MH THEN  /*Record equipment for return parm */
               k = k + 1;
               WLEquip.InsertRow (rownumber = k);
               WLEquip[k].Value = WorkPoint;
   ENDIF; 
   /*
   ** Check if more matches needed.
   */
   i = 1;
   WHILE i <= WL.LastRow DO
      IF WL[i].EquipName = 'No Match' THEN
         ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   IF i > WL.LastRow THEN
      FIELD(FindMatch).CurBias = FB_INVISIBLE;
      IF LegsOK = TRUE THEN
         CurFrame.SendUserEvent (EventName = 'PerformTrace');
      ENDIF;
   ENDIF;
END;


ON CLICK leg_stack.ok_btn =
DECLARE
   LegList = VARCHAR(20) NOT NULL WITH DEFAULT;
BEGIN
   LegsOK = TRUE;
   IF FIELD(leg_stack.l_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.l_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',L';
         ELSE
            LegList = 'L';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   IF FIELD(leg_stack.m_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.m_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',M';
         ELSE
            LegList = 'M';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   IF FIELD(leg_stack.r_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.r_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',R';
         ELSE
            LegList = 'R';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   IF FIELD(leg_stack.j_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.j_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',J';
         ELSE
            LegList = 'J';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   IF FIELD(leg_stack.k_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.k_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',K';
         ELSE
            LegList = 'K';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   IF FIELD(leg_stack.w_stack).CurBias = FB_CHANGEABLE THEN
      IF leg_stack.w_stack.leg = 1 THEN
         IF LegList <> '' THEN
            LegList = LegList + ',W';
         ELSE
            LegList = 'W';
         ENDIF;
      ELSE
         LegsOK = FALSE;
      ENDIF;
   ENDIF;
   
   IF LegsOK = FALSE THEN
      IF Leglist = '' THEN
         MESSAGE 'You have not selected any legs to work.';
         RESUME;
      ENDIF;
      IF CurFrame.ConfirmPopup (messagetext = 'You have chosen to work ' +
            Leglist + ' leg only') = PU_CANCEL THEN
         RESUME;
      ENDIF;
      /*
         Scroll through work locations and eliminate equipment on Legs marked No
      */
      i = WL.LastRow;
      WHILE i >= 1 DO
         IF FIELD(leg_stack.l_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.l_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:L%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
         IF FIELD(leg_stack.m_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.m_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:M%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
         IF FIELD(leg_stack.r_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.r_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:R%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
          IF FIELD(leg_stack.j_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.j_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:J%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
          IF FIELD(leg_stack.k_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.k_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:K%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
          IF FIELD(leg_stack.w_stack).CurBias = FB_CHANGEABLE AND
             leg_stack.w_stack.leg = 0 THEN
            IF WL[i].EquipName LIKE 'M%:W%' THEN
               WL.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;
            ENDIF;
         ENDIF;
/* 
** Save legList for future use
*/ 
         RetCode = CALLPROC FMS_MatchLegUpd (
                          WorkPermit = WorkPermit,
                          WPLocation = WL[i].PrimaryGrouping, /* Hidden WPLocation*/
                          MatchLeg = LegList);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Warning, Not able to save leg list for future use.';
         ENDIF;                      
         i = i - 1;
      ENDWHILE;
      LegsOK = TRUE;
   ENDIF;
   /*
   ** Check if more matches needed.
   */
   i = 1;
   WHILE i <= WL.LastRow DO
      IF WL[i].EquipName = 'No Match' THEN
         ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   IF i > WL.LastRow THEN
      FIELD(FindMatch).CurBias = FB_INVISIBLE;
      IF LegsOK = TRUE THEN
         CurFrame.SendUserEvent (EventName = 'PerformTrace');
      ENDIF;
   ENDIF;
END;



ON USEREVENT 'PerformTrace' =
DECLARE
   ng = INTEGER NOT NULL WITH DEFAULT;
   ng2 = INTEGER NOT NULL WITH DEFAULT;
   ngpath = INTEGER NOT NULL WITH DEFAULT;
   NGSType = INTEGER NOT NULL WITH DEFAULT;
   Idx2 = INTEGER NOT NULL WITH DEFAULT;
   DMIdx = INTEGER NOT NULL WITH DEFAULT;
   Distance2 = FLOAT NOT NULL WITH DEFAULT;
   DMDistance = FLOAT NOT NULL WITH DEFAULT;
   PUConditionMet = INTEGER NOT NULL WITH DEFAULT;
   PUEqJob = INTEGER NOT NULL WITH DEFAULT;
   ComputerName = VARCHAR(40) NOT NULL WITH DEFAULT;
   HTVName = VARCHAR(40) NOT NULL WITH DEFAULT;
   Combination = VARCHAR(20) NOT NULL WITH DEFAULT;
   LockNumber = VARCHAR(40) NOT NULL WITH DEFAULT;
   Description = VARCHAR(60) NOT NULL WITH DEFAULT;
   DeloadJobExists = INTEGER NOT NULL WITH DEFAULT;
   DeloadJobIssued = DATE;
ENDDECLARE
BEGIN
   CurFrame.UnRegisterUserEvent(EventName = 'ext_qgis_work_point');
   IF LegsOK = FALSE AND WP_ProtectionComparison = FALSE THEN
      MESSAGE 'Please Select Legs to be worked.';
      RESUME; 
   ENDIF;
    IF FIELD(FindMatch).CurBias <> FB_INVISIBLE THEN
      MESSAGE 'Please Find Work Location on Diagram.';
      RESUME; 
   ENDIF;

   NWPTypes.Clear();
   i = 1;
   SELECT :NWPTypes[i].Value = ET.Type
   FROM   UDB_ExtendedType ET
   WHERE  ET.SuperType = :TypeName$NWP
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   
   EventText = 'Diagram=' + VARCHAR(DiagramID) + '; ' +
               'WLGrounds={';
 
   Idx2 = 0;
   Distance2 = -1.0;
   j = 0;
   w = 0;
   m = 1;
   PL.Clear();
   WPC.Clear();
   NGS.Clear();
   LG.Clear();
   FOR i = 1 TO WL.LastRow DO
   /*
   ** Make sure WL Equip has a value before continuing to avoid the NO MATCH equip.
   */
      IF WL[i].Equip = 0 THEN
         CONTINUE;
      ENDIF;
      /* If we have a Local Grounds situation, save for later and skip trace for this location */
      IF WL[i].CurrentlyOpen = 1 THEN
         LG.InsertRow (Rownumber = 1, RowObject = WL[i].Duplicate());
         CONTINUE;
      ENDIF;
      
      CurFrame.Trace(Text = 'Work Point = ' + VARCHAR(WL[i].EquipName));
      n = 0;
      IF i = 1 THEN
       /*  CALLPROC CallQGIS (Object = WL[i].Equip);  */
         EventText = EventText +  VARCHAR(WL[i].Equip) + ':[';
      ELSE
         EventText = EventText +  '],' + VARCHAR(WL[i].Equip) + ':[';
      ENDIF;
      
      SELECT  :WorkPointEquip.Equip = O.Object, 
           :WorkPointEquip.EquipName = O.Name,
           :WorkPointEquip.EquipClass  = O.Type,
           :WorkPointEquip.EquipClassName  = O.TypeName,
           :WorkPointEquip.PrimaryGrouping = O.StructureObj,
           :WorkPointEquip.PrimaryGroupingName = O.StructureName
      FROM    DSO_Object O
      WHERE   O.Pocket = :DiagramID AND
              O.Object = :WL[i].Equip;
   /* 
   ** start connectivity trace
   */
      Trace = Trace_FeederTargetGrounds.Create();
      Trace.WorkPoint.Object = WL[i].Equip;  
      TraceStatus = Trace.StartTargetTrace( );
   
      IF TraceStatus = TraceStatus$Isolated THEN
         MESSAGE 'Object is not connected';
      
      ELSEIF TraceStatus = TraceStatus$Floating THEN
         MESSAGE 'Object is floating';
      ENDIF;
   
      ng = 0;
      FOR j = 1 TO Trace.PathResultList.LastRow DO
         Distance = -1.0;
         Idx = 0;
         DMDistance = -1.0;
         DMIdx = 0;
         ngpath = NGS.LastRow();
         /* 
         ** If we are comparing suggested to actual, insert a new comparison row 
         */
         IF WP_ProtectionComparison = TRUE THEN
            w = w + 1;
            WPC[w].WLEquip = WorkPointEquip.Equip;
            IF w > 1 THEN
               IF WPC[w].WLEquip <> WPC[w-1].WLEquip THEN
                  WPC[w].WLEquipClassName = WorkPointEquip.EquipClassName;
                  WPC[w].WLEquipName = WorkPointEquip.EquipName;  
               ENDIF;
            ELSE
                  WPC[w].WLEquipClassName = WorkPointEquip.EquipClassName;
                  WPC[w].WLEquipName = WorkPointEquip.EquipName;  
            ENDIF;  
            WPC[w].Path = j;    
            WPC[w].AEquip = 0;
         ENDIF;
 
         FOR k = 1 TO Trace.PathResultList[j].TargetEquipList.LastRow DO
         /*
         ** If we are comparing suggested to actual, check for actual
         */
          IF WP_ProtectionComparison = TRUE AND w > 0 THEN
           /*IF WPC[w].AEquip = 0 THEN    allow something closer */
            status = ProtEq.Find (AttributeName = 'Value',
                                  Value = Trace.PathResultList[j].TargetEquipList[k].Object);
            IF status = ER_OK THEN
               IF WPC[w].ADistance = 0 OR 
                  Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart < WPC[w].ADistance THEN
                  WPC[w].AEquip = Trace.PathResultList[j].TargetEquipList[k].Object;
                  WPC[w].AEquipClassName = Trace.PathResultList[j].TargetEquipList[k].TypeName;
                  WPC[w].AEquipName = Trace.PathResultList[j].TargetEquipList[k].Name;   
                  WPC[w].ADistance = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart; 
               ENDIF;
            ENDIF;
           /*ENDIF;*/
          ENDIF; 
         /*
         ** Check returned target against EquipToSkip 
         */ 
          SkipEquip = FALSE;
          IF EquipToSkip = TRUE THEN
             Status = WLEquip.Find (AttributeName = 'Value',
                                Value = Trace.PathResultList[j].TargetEquipList[k].Object);                                          
             IF Status = ER_OK THEN             
                SkipEquip = TRUE;
             ENDIF;
          ENDIF;
         /*
         ** If not in Feeder Scope then skip it, NGS equipment cannot provide PL but will have
         ** protection move if within scope of trace. 
         */
          Status = FeederScope.Find(AttributeName = 'Value',
                                          Value = Trace.PathResultList[j].TargetEquipList[k].Object);                                          
          IF Status = ER_OK AND SkipEquip = FALSE THEN
          /* Determine if NGS Equipment */
            NGSType = FALSE; 
            IF (Trace.PathResultList[j].TargetEquipList[k].LockNumber = '' AND 
                Trace.PathResultList[j].TargetEquipList[k].Combination = '') OR 
                Trace.PathResultList[j].TargetEquipList[k].Description LIKE '%(NGS%' THEN
             
                Status = NWPTypes.Find(AttributeName = 'Value',
                                        Value = Trace.PathResultList[j].TargetEquipList[k].Type); 
                IF Status = ER_OK THEN
                   NGSType = TRUE;
                   ng = ng + 1;
                   NGS[ng] = Equipment.Create();
                   NGS[ng].Equip = Trace.PathResultList[j].TargetEquipList[k].Object;
                   NGS[ng].EquipClass = Trace.PathResultList[j].TargetEquipList[k].Type;
                   NGS[ng].EquipClassName = Trace.PathResultList[j].TargetEquipList[k].TypeName;
                   NGS[ng].EquipName = Trace.PathResultList[j].TargetEquipList[k].Name;
                   NGS[ng].Terminals = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
                   NGS[ng].Description = WL[i].EquipName;
                ENDIF;
            ENDIF;  

            IF Trace.PathResultList[j].TargetEquipList[k].DidIPassThruDM = 1 AND NGSType = FALSE THEN
               IF DMIdx = 0 THEN 
                  DMDistance = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
                  DMIdx = k;   
               ELSEIF DMDistance > Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart AND NGSType = FALSE THEN
                  DMDistance = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
                  DMIdx = k;   
               ENDIF;
            ENDIF;
            IF Idx = 0 AND NGSType = FALSE AND Trace.PathResultList[j].TargetEquipList[k].DidIPassThruDM = 0 THEN
               Distance = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
               Idx = k;
            ELSEIF Distance > Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart AND NGSType = FALSE AND 
                   Trace.PathResultList[j].TargetEquipList[k].DidIPassThruDM = 0 THEN                    
               Distance = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
               Idx = k;
            ENDIF;
          ELSE
          /* If not in Feeder Scope, we want to check if this is pickup equipment and then keep separate Distance stats if it is */
             Status = PUEq.Find (AttributeName = 'Equip',
                                 Value = Trace.PathResultList[j].TargetEquipList[k].Object);
             IF Status = ER_OK THEN
                IF Idx2 = 0 THEN
                   Distance2 = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
                   Idx2 = k;
                ELSEIF Distance2 > Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart THEN
                   Distance2 = Trace.PathResultList[j].TargetEquipList[k].DistanceFromStart;
                   Idx2 = k;
                ENDIF;
             ENDIF;                   
          ENDIF;
         ENDFOR;

         PUConditionMet = FALSE;
         /* Is there a closer out-of-scope/ISO equipment being picked up? */
         IF Idx2 <> 0 AND Distance2 < Distance THEN
            /* Does this ISO equipment have an outstanding ground move? */
            PUEqJob = 0;
            SELECT :PUEqJob = Job
            FROM   SOA_Job
            WHERE  Equip = :Trace.PathResultList[j].TargetEquipList[Idx2].Object AND
                   JobClass = :JobClass$ProtectiveGround AND
                   MoveCategory = :MoveCategory$Normal AND
                   TOComplete IS NOT NULL AND
                   RSIssued IS NULL;
            IF PUEqJob > 0 THEN
               PUConditionMet = TRUE;
               q = EquipWithJob.LastRow + 1;
               EquipWithJob[q].Equip = Trace.PathResultList[j].TargetEquipList[Idx2].Object;
               EquipWithJob[q].JobClass = JobClass$ProtectiveGround;
               EquipWithJob[q].Job = PUEqJob;
               EquipWithJob[q].ActivityIdentifier = 'N';
               IF n = 0 THEN
                  EventText = EventText + VARCHAR(Trace.PathResultList[j].TargetEquipList[Idx2].Object);
               ELSE
                  EventText = EventText + ',' + VARCHAR(Trace.PathResultList[j].TargetEquipList[Idx2].Object);
               ENDIF;              
               n = n + 1;                      
               /*
               ** If we are comparing suggested to actual, record suggested
               */
               IF WP_ProtectionComparison = TRUE THEN
                  WPC[w].SEquip = Trace.PathResultList[j].TargetEquipList[Idx2].Object;
                  WPC[w].SEquipClassName = Trace.PathResultList[j].TargetEquipList[Idx2].TypeName;
                  WPC[w].SEquipName = Trace.PathResultList[j].TargetEquipList[Idx2].Name;   
                  WPC[w].SDistance = Trace.PathResultList[j].TargetEquipList[Idx2].DistanceFromStart; 
               ENDIF;
            ENDIF;
         ENDIF;

         IF (Idx <> 0 OR DMIdx <> 0) AND PUConditionMet = FALSE THEN    /*PUConditionMet gives control to return only one equip on this path */  
            SkipProtection = FALSE;
            IF Idx <> 0 THEN
               PL[m] = Equipment.Create();
               PL[m].Equip = Trace.PathResultList[j].TargetEquipList[Idx].Object;
               PL[m].EquipClass = Trace.PathResultList[j].TargetEquipList[Idx].Type;
               PL[m].EquipClassName = Trace.PathResultList[j].TargetEquipList[Idx].TypeName;
               PL[m].EquipName = Trace.PathResultList[j].TargetEquipList[Idx].Name;
               PL[m].Description = WL[i].EquipName;
            
               IF n = 0 THEN
                  EventText = EventText + VARCHAR(PL[m].Equip);
               ELSE
                  EventText = EventText + ',' + VARCHAR(PL[m].Equip);
               ENDIF;
               m = m + 1;
               n = n + 1;
            /*
            ** If we are comparing suggested to actual, record suggested
            */
               IF WP_ProtectionComparison = TRUE THEN
                  WPC[w].SEquip = Trace.PathResultList[j].TargetEquipList[Idx].Object;
                  WPC[w].SEquipClassName = Trace.PathResultList[j].TargetEquipList[Idx].TypeName;
                  WPC[w].SEquipName = Trace.PathResultList[j].TargetEquipList[Idx].Name;   
                  WPC[w].SDistance = Trace.PathResultList[j].TargetEquipList[Idx].DistanceFromStart; 
               ENDIF;
            ENDIF;
            
            IF DMIdx <> 0 AND (DMDistance < Distance OR Idx = 0) THEN  /*Include only if less than non-DM */
               PL[m] = Equipment.Create();
               PL[m].Equip = Trace.PathResultList[j].TargetEquipList[DMIdx].Object;
               PL[m].EquipClass = Trace.PathResultList[j].TargetEquipList[DMIdx].Type;
               PL[m].EquipClassName = Trace.PathResultList[j].TargetEquipList[DMIdx].TypeName;
               PL[m].EquipName = Trace.PathResultList[j].TargetEquipList[DMIdx].Name;
               PL[m].Description = WL[i].EquipName;
            
               IF n = 0 THEN
                  EventText = EventText + VARCHAR(PL[m].Equip);
               ELSE
                  EventText = EventText + ',' + VARCHAR(PL[m].Equip);
               ENDIF;
               m = m + 1;
               n = n + 1;
            /*
            ** If we are comparing suggested to actual, record suggested
            */
               IF WP_ProtectionComparison = TRUE THEN
                  WPC[w].SEquip = Trace.PathResultList[j].TargetEquipList[DMIdx].Object;
                  WPC[w].SEquipClassName = Trace.PathResultList[j].TargetEquipList[DMIdx].TypeName;
                  WPC[w].SEquipName = Trace.PathResultList[j].TargetEquipList[DMIdx].Name;   
                  WPC[w].SDistance = Trace.PathResultList[j].TargetEquipList[DMIdx].DistanceFromStart; 
               ENDIF;
            ENDIF;
            
            /* Remove NGS Equipment beyond final Distance on this path */
            ng2 = NGS.Lastrow;
            WHILE ng2 > ngpath DO
               IF Distance < NGS[ng2].Terminals THEN   /*DistanceFromStart hidden in Terminals attribute*/
                  NGS.RemoveRow(rownumber = ng2);
                  ng = ng - 1;
               ENDIF;
               ng2 = ng2 - 1;
            ENDWHILE;       
         ENDIF;
      ENDFOR;       
        /*
         ** if the work point itself is a target ground, add it to the list 
         */ 
      IF WorkPointEquip.EquipClass <> TypeName$MH THEN
   
           Status = Trace.TargetTypeList.Find(AttributeName = 'Value',
                                          Value = WorkPointEquip.EquipClass);                                          
           IF Status <> ER_OK THEN
           /* If not in feeder scope then look to see if it is pickup equip */
              Status = FeederScope.Find(AttributeName = 'Value',
                                          Value = WorkPointEquip.Equip);                                          
              IF Status = ER_OK THEN
                 PL[m] = Equipment.Create();
                 PL[m].Equip = WorkPointEquip.Equip;
                 PL[m].EquipClass = WorkPointEquip.EquipClass;
                 PL[m].EquipClassName = WorkPointEquip.EquipClassName;
                 PL[m].EquipName = WorkPointEquip.EquipName;
                 PL[m].Description = WL[i].EquipName;
                 
                 IF n = 0 THEN
                    EventText = EventText + VARCHAR(PL[m].Equip);
                 ELSE
                    EventText = EventText + ',' + VARCHAR(PL[m].Equip);
                 ENDIF;
                 m = m + 1;
                 n = n + 1;
              ELSE
                 Status = PUEq.Find (AttributeName = 'Equip',
                                 Value = WorkPointEquip.Equip);
                 IF Status = ER_OK THEN
                    PUEqJob = 0;
                    SELECT :PUEqJob = Job
                    FROM   SOA_Job
                    WHERE  Equip = :WorkPointEquip.Equip AND
                           JobClass = :JobClass$ProtectiveGround AND
                           MoveCategory = :MoveCategory$Normal AND
                           TOComplete IS NOT NULL AND
                           RSIssued IS NULL;
                    IF PUEqJob > 0 THEN
                       q = EquipWithJob.LastRow + 1;
                       EquipWithJob[q].Equip = WorkPointEquip.Equip;
                       EquipWithJob[q].JobClass = JobClass$ProtectiveGround;
                       EquipWithJob[q].Job = PUEqJob;
                       EquipWithJob[q].ActivityIdentifier = 'N';
                       IF n = 0 THEN
                          EventText = EventText + VARCHAR(WorkPointEquip.Equip);
                       ELSE
                          EventText = EventText + ',' + VARCHAR(WorkPointEquip.Equip);
                       ENDIF;              
                       n = n + 1;                      
                    ENDIF;
                 ENDIF;
              ENDIF;
           ENDIF;   
         /* 
         ** If we are comparing suggested to actual, insert a new comparison row 
         */
         IF WP_ProtectionComparison = TRUE THEN
            w = w + 1;
            WPC[w].WLEquip = WorkPointEquip.Equip;
            IF w > 1 AND WPC[w].WLEquip <> WPC[w-1].WLEquip THEN
               WPC[w].WLEquipClassName = WorkPointEquip.EquipClassName;
               WPC[w].WLEquipName = WorkPointEquip.EquipName;  
            ENDIF;  
            WPC[w].Path = WPC[w-1].Path + 1;    
            WPC[w].SEquip = WorkPointEquip.Equip;
            WPC[w].SEquipClassName = WorkPointEquip.EquipClassName;
            WPC[w].SEquipName = WorkPointEquip.EquipName;    
            WPC[w].SDistance = 0;    
            WPC[w].AEquip = 0;
            
            status = ProtEq.Find (AttributeName = 'Value',
                                  Value = WorkPointEquip.Equip);
            IF status = ER_OK THEN
               WPC[w].AEquip = WorkPointEquip.Equip;
               WPC[w].AEquipClassName = WorkPointEquip.EquipClassName;
               WPC[w].AEquipName = WorkPointEquip.EquipName;    
               WPC[w].ADistance = 0;    
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;
   EventText = EventText + ']}';
/*
** Load Evaluation Equip Types
*/
   HTVTypes.Clear();
   i = 1;
   SELECT :HTVTypes[i].Value = ET.Type
   FROM   UDB_ExtendedType ET
   WHERE  ET.SuperType = :Type$HTVStd
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   PADMTypes.Clear();
   i = 1;
   SELECT :PADMTypes[i].Value = ET.Type
   FROM   UDB_ExtendedType ET
   WHERE  ET.SuperType = :Type$PADMNTStd
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
/* 
** Process Protection list
*/   
   IF n > 0 THEN /* No Event to send to QGIS when n=0 */
   
      CurFrame.Trace(Text = 'EventText= ' + EventText);
      IF LENGTH(EventText) > 240 THEN 
         MESSAGE 'Parameter length > 240. Too many Work Location Ground Points to pass to QGIS External Event.';
      ELSE
         ComputerName = CurSession.GetEnv(name = 'COMPUTERNAME');
         IF ComputerName = '' THEN
            Message 'Application is not setup properly for QGIS call.' + HC_NEWLINE
          +   'A COMPUTERNAME environmental variable is required.' + HC_NEWLINE
          +   'Please notify the on-call person.';
         ELSE 
   
            RetCode = CALLPROC QGIS_ExternalEventIns(
                  EventDate = DATE('now'),
                  ComputerName = ComputerName,
                  EventType='WORKLOCATION', 
                  EventText=EventText);
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF;
/*
** Remove Duplicates from Protection List, Evaluate for source position and remove 
*/    
   m = PL.LastRow;
   WHILE m > 1 DO
      i = m - 1;
      WHILE i >= 1 DO
         IF PL[m].Equip = PL[i].Equip THEN
            PL.RemoveRow (Rownumber = i);
            m = m - 1;
         ENDIF;
         i = i - 1;
      ENDWHILE;
      m = m - 1;
   ENDWHILE;   
/*
** Evaluate for source position and remove 
*/    
   m = PL.LastRow;
   WHILE m > 0 DO
            q = 0;
            SELECT :q = Relationship
            FROM   Udb_Grouping 
            WHERE  Member = :PL[m].Equip AND
                   Relationship = :Interaction$SourcePosition;
            IF q > 0 THEN
               i = WPC.LastRow;
               WHILE i >= 1 DO
                  IF PL[m].Equip = WPC[i].SEquip THEN
                     WPC.RemoveRow (RowNumber = i);
                  ENDIF;
                  i = i - 1;
               ENDWHILE;
               PL.RemoveRow (Rownumber = m);
            ENDIF;
       m = m - 1;
   ENDWHILE;   
/*
** Build Return Equip with JobClass Array
*/
   n = EquipWithJob.LastRow + 1;
   FOR m = 1 TO PL.LastRow DO
      EquipWithJob[n].Equip = PL[m].Equip;
      EquipWithJob[n].JobClass = JobClass$ProtectiveGround; /* The default */
            
      Status = HTVTypes.Find(AttributeName = 'Value',
                                          Value = PL[m].EquipClass); 
      IF Status = ER_OK THEN
      
         IF PL[m].EquipClass = Type$HTVRect THEN       /* Add a second protection move for HTVRect */
            n = n + 1;        
            EquipWithJob[n].Equip = PL[m].Equip;
            EquipWithJob[n].JobClass = JobClass$CheckOpenRackOut;   
         ELSE
  /* Look for HTV-G specific equipment (not subtypes) associated to feeder with the same HTV name */      
         i = 0;   
         HTVName = LEFT(PL[m].EquipName,LOCATE(PL[m].EquipName,'-')-1) + '%';
         REPEATED
         SELECT :i = G2.Member
         FROM   Udb_Grouping G,
                Udb_Grouping G2,
                Udb_ExtendedType ET,
                Udb_ExtendedType ET2,
                Udb_Object O
         WHERE  G.Member = :PL[m].Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = ET2.Type AND
                ET2.SuperType = :Type$Feeder AND
                G.Grouping = G2.Grouping AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.MemberType = :ExcludeHTV$G AND
                G2.Member = O.Object AND
                O.Name LIKE :HTVName;
         IF i > 0 THEN
            EquipWithJob[n].Equip = i;
            EquipWithJob[n].JobClass = JobClass$CloseKnife;   
         ENDIF;   /*HTV-G*/ 
         ENDIF;   /*HTV-Rect*/
            
         n = n + 1;        
         CONTINUE;
      ENDIF;
      
      Status = PADMTypes.Find(AttributeName = 'Value',
                                          Value = PL[m].EquipClass); 
      IF Status = ER_OK THEN
         EquipWithJob[n].JobClass = JobClass$PortableGround;           
         n = n + 1;        
         CONTINUE;
      ENDIF;
      
      IF PL[m].EquipClass = Type$GrdSwTrf THEN
         EquipWithJob[n].JobClass = JobClass$GroundBankPrimary;           
         n = n + 1;        
         CONTINUE;
      ENDIF;
      n = n + 1;              
   ENDFOR;
/*
** Add NGS Equip Protection Moves
*/
   FOR m = 1 TO NGS.LastRow DO
      EquipWithJob[n].Equip = NGS[m].Equip;
      EquipWithJob[n].JobClass = JobClass$BlockOpen;
      n = n + 1;        
   ENDFOR;
/*
** Add Local Ground Equip Protection Moves
*/
   FOR m = 1 TO LG.LastRow DO
      /* Use Outstanding DELOAD move or IDENTIFY step move */  
      DeloadJobExists = FALSE;
      SELECT :DeloadJobExists = J.Job
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :Card AND
             JC.Job = J.Job AND
             J.Equip = :LG[m].Equip AND
             J.JobClass = :JobClass$RemoveFusesDL AND
             J.TOIssued IS NOT NULL AND
             J.RSIssued IS NULL;
      IF DeloadJobExists <> FALSE THEN
         EquipWithJob[n].JobClass = JobClass$RemoveFusesDL;
      ELSE 
         EquipWithJob[n].JobClass = JobClass$RemoveFusesID;
      ENDIF;
      EquipWithJob[n].Equip = LG[m].Equip;
      n = n + 1; 

      DeloadJobExists = FALSE;
      SELECT :DeloadJobExists = J.JobClass,
             :DeloadJobIssued = J.TOIssued
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :Card AND
             JC.Job = J.Job AND
             J.Equip = :LG[m].Equip AND
            (J.JobClass = :JobClass$BlockOpenDL OR 
             J.JobClass = :JobClass$BlockOpenDLI) AND
             J.RSIssued IS NULL;
      IF DeloadJobExists = JobClass$BlockOpenDLI THEN
         EquipWithJob[n].JobClass = DeloadJobExists;
      ELSEIF DeloadJobExists = JobClass$BlockOpenDL AND DeloadJobIssued IS NOT NULL THEN
         EquipWithJob[n].JobClass = DeloadJobExists;      
      ELSE 
         EquipWithJob[n].JobClass = JobClass$BlockOpenID;
      ENDIF;
      EquipWithJob[n].Equip = LG[m].Equip;
      n = n + 1;     
  
      /* Automatic Apply Protective Ground move */
      EquipWithJob[n].Equip = LG[m].Equip;
      EquipWithJob[n].JobClass = JobClass$ProtectiveGround;
      n = n + 1; 
   ENDFOR;   
   
   IF QGISCalled = TRUE THEN  /* Make sure OR has focus */
      CALLPROC ShowWindow(CurFrame.WidgetID,1);
      CALLPROC SetForegroundWindow(CurFrame.WidgetID);
   ENDIF;
   RETURN PU_OK;
END;

ON CLICK cancel_btn =
BEGIN
   RETURN PU_CANCEL;
END;

PROCEDURE NewBankPickUp (
   NewEquip = EQUIPMENT
) =
DECLARE
   Eq = INTEGER NOT NULL WITH DEFAULT;
   q = INTEGER NOT NULL WITH DEFAULT;
   PickEquip = INTEGER NOT NULL WITH DEFAULT;
   InNewBank = INTEGER NOT NULL WITH DEFAULT;
   OutstandingGroundMove = INTEGER NOT NULL WITH DEFAULT;   
   OutstandingSTJobClass = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
/*
** Does the equipment match anything in pickup equipment?
*/
   Status = PUEq.Find (AttributeName = 'BarCode',
                       Value = NewEquip.BarCode,
                       RowNumber = BYREF(Eq));
   IF Status = ER_OK THEN
   /* Remove matched equipment from second pass list. */
      Status = PUEq2.Find (AttributeName = 'Equip',
                       Value = PUEq[Eq].Equip,
                       RowNumber = BYREF(PickEquip));
      IF Status = ER_OK THEN
         PUEq2.RemoveRow (rownumber = PickEquip);
      ENDIF;  
      
      PickEquip = PUEq[Eq].Equip;
   /* Is this NWP equipment in the new bank for this desk */
      InNewBank = FALSE;
      REPEATED
      SELECT :InNewBank = O.Object
      FROM   Udb_Object O,
             Udb_Grouping G,
             Udb_Grouping G2
      WHERE  O.Object = :PickEquip AND
             O.Object = G.Member AND
             O.Type IN (SELECT Type FROM Udb_ExtendedType WHERE SuperType = :TypeName$NWP) AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND 
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = :UserDesk AND
             O.Inservice IS NULL AND
             O.OutService IS NULL;

      IF InNewBank = PickEquip THEN
      /* Is this NWP equipment with and outstanding Ground Move */
          OutstandingGroundMove = 0;
          SELECT :OutstandingGroundMove = Job
          FROM   SOA_Job 
          WHERE  Equip = :PickEquip AND
                 Status = '' AND
                 JobClass = :JobClass$ProtectiveGround AND
                 TOComplete IS NOT NULL AND
                 RSIssued IS NULL;
                 
          IF OutstandingGroundMove > 0 THEN
             q = EquipWithJob.LastRow + 1;
             EquipWithJob[q].Equip = PickEquip;
             EquipWithJob[q].JobClass = JobClass$ProtectiveGround;
             EquipWithJob[q].Job = OutstandingGroundMove;
             EquipWithJob[q].ActivityIdentifier = 'N';
          
             RETURN PU_OK;
          ENDIF;       
      ENDIF;      
  
   /* Is this HTV equipment in the new bank for this desk */
      InNewBank = FALSE;
      REPEATED
      SELECT :InNewBank = O.Object
      FROM   Udb_Object O,
             Udb_Grouping G,
             Udb_Grouping G2
      WHERE  O.Object = :PickEquip AND
             O.Object = G.Member AND
             O.Type IN (SELECT Type FROM Udb_ExtendedType WHERE SuperType = :Type$HTVStd) AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND 
             G.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = :UserDesk AND
             O.Inservice IS NULL AND
             O.OutService IS NULL;

      IF InNewBank = PickEquip THEN
      /* Is this NWP equipment with and outstanding Ground Move */
          OutstandingGroundMove = 0;
          SELECT :OutstandingGroundMove = Job,
                 :OutstandingSTJobClass = JobClass
          FROM   SOA_Job 
          WHERE  Equip = :PickEquip AND
                 Status = '' AND
                 JobClass = :JobClass$ProtectiveGround AND
                 TOComplete IS NOT NULL AND
                 RSIssued IS NULL;
                 
          IF OutstandingGroundMove = 0 THEN
             RETURN PU_CANCEL;
          ELSE;
             q = EquipWithJob.LastRow + 1;
             EquipWithJob[q].Equip = PickEquip;
             EquipWithJob[q].JobClass = JobClass$ProtectiveGround;
             EquipWithJob[q].Job = OutstandingGroundMove;
             EquipWithJob[q].ActivityIdentifier = 'N';
          ENDIF;       
           /* Look for second stop tag related move */
          OutstandingGroundMove = 0;
          SELECT :OutstandingGroundMove = Job,
                 :OutstandingSTJobClass = JobClass
          FROM   SOA_Job 
          WHERE  Equip = :PickEquip AND
                 Status = '' AND
                 JobClass IN (SELECT JobClass FROM FMS_JobAction WHERE Status = :Prompt$StopTag) AND
                 TOComplete IS NOT NULL AND
                 RSIssued IS NULL;
                 
          IF OutstandingGroundMove > 0 THEN
             q = EquipWithJob.LastRow + 1;
             EquipWithJob[q].Equip = PickEquip;
             EquipWithJob[q].JobClass = OutstandingSTJobClass;
             EquipWithJob[q].Job = OutstandingGroundMove;
             EquipWithJob[q].ActivityIdentifier = 'N';
          ENDIF; 
                
          RETURN PU_OK;
      ENDIF;        
   ENDIF;  
   RETURN PU_CANCEL;
END;
