	Name:            CheckIfISOFeederInSrvc

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckIfISOFeederInSrvc
**
**  Modifications:
**  02/14/93 em	    Created
**  11/19/02 ysp    Merge: removed passed-in C and Jobs 
**  01/31/03 ysp    Changed warning text to include the base feeder name.
**  02/28/03 pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                  that span divisions.
**  10/18/16 ysp    Merge from pkw: Add portion feeder to feeder check for 33KV ISO
*/
PROCEDURE  CheckIfISOFeederInSrvc
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    ISOFeederCard = ARRAY OF FMS_Card;
    TempFeeder = INTEGER NOT NULL;
    BaseFeeder = INTEGER NOT NULL;
    BaseFeederType = INTEGER NOT NULL;
    BaseFeederName = VARCHAR(40) NOT NULL WITH DEFAULT; 
    WarningStatus = INTEGER;
    RetCode = INTEGER;
) =
BEGIN
/*
** the job belongs to one ISO card only, use an array just in case
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
          :ISOFeederCard[i].FeederName = C.FeederName,
          :ISOFeederCard[i].Feeder = C.Feeder,
          :ISOFeederCard[i].Card = C.Card
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          JC.Card = C.Card AND
          C.CardClass = :Type$ISO
   BEGIN
      i = i + 1;
   END;
/*
**  If this is an ISO Card, when going out to work we to make sure that the 
**  base Feeder is CutIn.  We may have to climb up the grouping hierarchy because
**  ISO can be created from ISOs.   Go up the hierarchy until GroupingType =
**  Type Feeder.
*/ 
   RetCode = NULL;
   FOR i = 1 TO ISOFeederCard.LastRow() DO

     BaseFeeder = 0;
     BaseFeederType = 0;
     TempFeeder = ISOFeederCard[i].Feeder;

     WHILE TempFeeder <> 0 DO   

       SELECT :BaseFeeder = G.Grouping,
              :BaseFeederType = G.GroupingType
       FROM   Udb_Grouping G
       WHERE  G.Member = :TempFeeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = :Type$Feeder); 

       IF BaseFeederType = Type$Feeder OR BaseFeederType = Type$PortionFeeder THEN   /* We've found it */
          TempFeeder = 0;
       ELSE
          TempFeeder = BaseFeeder;
       ENDIF;

     ENDWHILE;

     IF BaseFeeder <> 0 THEN  /* Yes we found one, check for C/O status. */

        SELECT :k = StatusCount
        FROM   FMS_ObjectStatus
        WHERE  Object = :BaseFeeder AND
               Status = :Status$CO;

        IF k > 0 THEN    /* Feeder CutOut */

            BaseFeederName = '';
            SELECT :BaseFeederName = Name
            FROM   Udb_Object
            WHERE  Object = :BaseFeeder;
            CALLPROC DDB_ROLLBACK;
    
            WarningStatus = CALLFRAME Warning 
                            (Card = JIP.Card, 
                             Job = JIP.Job,
                             SwitchingItem = JIP.SwitchingItem,
                             Text = 'The feeder ' + BaseFeederName + ' for this ISO is not in service.');  
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden; 
            ENDIF;
        ENDIF;

     ENDIF;

  ENDFOR;

  RETURN(RetCode); 

END;

