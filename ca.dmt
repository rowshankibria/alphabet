	Name:            PromptEnterSequenceEngineer

/*
**
**	Copyright c 2005 Pateric Software.  All rights reserved.
**
**	Pateric Software LLC. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptEnterSequenceEngineer
**
**  03/24/05  em    new for SDS 
**  02/12/08  em    Just use RSOperator and don't show screen. 
*/

INITIALIZE
(
    JIP = JobInProgress;		/* Job being processed */

    i = INTEGER NOT NULL WITH DEFAULT;
    OperatorName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
   OperatorName = '';
   SELECT :OperatorName = O.Description
   FROM   Udb_Object O,
          SOA_Job J
   WHERE  J.Job = :JIP.Job AND
          J.RSOperator = O.Object;

   IF OperatorName <> '' THEN
	JIP.Response = OperatorName;
        JIP.ResponseUpd();
	RETURN (PU_OK);
   ENDIF;
/*
** If operator could not be determined, then display for selection
*/
   IF AutomaticExecution = TRUE THEN
      RETURN PU_OK;
   ENDIF;

      i = 1;
      SELECT  :OperatorChoices[i].Object      = Object, 
              :OperatorChoices[i].Name        = Name, 
              :OperatorChoices[i].Description = Description
      FROM    Udb_Object
      WHERE   Type IN (
                    SELECT  Type
                    FROM    Udb_ExtendedType
                    WHERE   SuperType = :Type$SequenceEngineer)
      BEGIN
         i = i + 1;
      END; 
END;

ON CHILDENTRY OperatorChoices[*].Description,
ON CHILDENTRY OperatorChoices[*].Name =
BEGIN
   Selected.Object = OperatorChoices[].Object;
   Selected.Name = OperatorChoices[].Name;
   Selected.Description = OperatorChoices[].Description;
END; 


ON Click OKButton =

   BEGIN
	JIP.Response = Selected.Description;
        JIP.ResponseUpd();
	RETURN (PU_OK);
   END;

ON Click CancelButton =

   BEGIN
	RETURN (PU_Cancel);
   END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

