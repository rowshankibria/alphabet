	Name:            PAReport


Application Component Report
============================

	Name:            PAReport_ASE


���p�x��Component Method Scripts
���p�x��--------------------------
/*
**
**      Copyright c 2006 Pateric Software, LLC.  All rights reserved.
**
**      Pateric Software, LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software, LLC.
**
**  Application:    CAC
**  Class:          PAReport_ASE
**
**  Date:       Version Description
** ----------------------------------
**  09/12/06  ysp  Created.
*/ 
METHOD LoadByDivision (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/

   ABList = ARRAY OF FMS_AutomationBlock;
   StartTime = DATE NOT NULL WITH DEFAULT;
   EndTime = DATE NOT NULL WITH DEFAULT;
   OPList = ARRAY OF OrderList;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   CurObject.DList.Clear();
/*
**  Load all automation blocks
*/
   ABList.Clear();
   i = 1;
   SELECT  :ABList[i].Card = Card
          ,:ABList[i].Division = Division
          ,:ABList[i].Block = Block
          ,:ABList[i].BlockSeq = BlockSeq
          ,:ABList[i].BlockEnd = BlockEnd
          ,:ABList[i].BlockStart = BlockStart
          ,:ABList[i].BlockStatus = BlockStatus
          ,:ABList[i].BlockStopped = BlockStopped
          ,:ABList[i].BlockTitle = BlockTitle
          ,:ABList[i].InitiatingDO = InitiatingDO
          ,:ABList[i].InitTime = InitTime
          ,:ABList[i].SendTo = SendTo
          ,:ABList[i].StopReason = StopReason
   FROM   FMS_AutomationBlock
   WHERE  InitTime <= :CurObject.EndDate AND
          InitTime >= :CurObject.StartDate 
   ORDER BY InitTime, BlockSeq
   BEGIN  
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF ABList.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: Process Automation Report: ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for time period selected.';
      RETURN;
   ENDIF; 
   
   j = 1;
   CurObject.DList[j].RptDate = Date_Trunc('day',CurObject.StartDate);            
/*
**  Go through each blocks found.
*/
   FOR i = 1 TO ABList.LastRow() DO
      /*
      **  There were no blocks on this day.  We must increment
      **  RptDate until we get to the day of the next block
      */
      WHILE CurObject.DList[j].RptDate + '1 day' < ABList[i].InitTime DO
         j = j + 1;
         CurObject.DList[j].RptDate = CurObject.DList[j-1].RptDate + '1 day';
      ENDWHILE;

      IF ABList[i].Division = 20002 THEN					/* Bronx */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DX),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DX),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSEIF ABList[i].Division = 20003 THEN					/* Brooklyn */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DB),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DB),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSEIF ABList[i].Division = 20004 THEN					/* Manhattan */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DM),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DM),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSEIF ABList[i].Division = 20005 THEN					/* Queens */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DQ),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DQ),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSEIF ABList[i].Division = 20006 THEN					/* Staten Is */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DS),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DS),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSEIF ABList[i].Division = 20007 THEN					/* Westchester  */
         CurObject.ProcessOneBlock(Block = ABList[i],
                                DayDiv = ByRef(CurObject.DList[j].DW),
                                DaySys = ByRef(CurObject.DList[j].SYS),
                                TotDiv = ByRef(CurObject.TList.DW),
                                TotSys = ByRef(CurObject.TList.SYS));

      ELSE
         CurMethod.Trace(Text = 'PAReport_ASE: Division undefined for blocks with card = ' + VARCHAR(ABList[i].Card));
      ENDIF;
   ENDFOR; 

/*
** find the number of operating orders for each day
*/
   StartTime = CurObject.DList[1].RptDate;
   EndTime = CurObject.DList[CurObject.DList.LastRow].RptDate + '1 day';

   i = 1;
   OPList.Clear();

   REPEATED
   SELECT :OPList[i].IssueTime = O.IssueTime,
          :OPList[i].Status = G.Grouping	/* division info */
   FROM   IR_OperatingOrder O,
          UDB_Grouping G
   WHERE  O.IssueTime BETWEEN :StartTime AND :EndTime AND
          O.OrderTarget = 'SSO' AND
          O.Substation = G.Member AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$Division
   ORDER BY IssueTime, Status
   BEGIN
      i = i + 1;
   END;

   CurObject.ProcessOrders(OPList = OPList,
                           StartTime = StartTime);

/*
** find the number of FOD or #9 orders for each day. We are ignoring the orders issued from
** ISO cards. There is no way to trace their divisions once the iso cards are closed, because 
** iso feeders are from ISO pool. Fortunately, there are relatively small number of orders
** from ISO cards.
*/
   i = 1;
   OPList.Clear();

   REPEATED
   SELECT :OPList[i].IssueTime = O.IssueTime,
          :OPList[i].Status = G2.Grouping	/* division info */
   FROM   IR_FODOrder O,
          UDB_Grouping G1,
          UDB_Grouping G2
   WHERE  O.IssueTime BETWEEN :StartTime AND :EndTime AND
          O.Feeder = G1.Member AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.GroupingType = :Type$Substation AND
          G1.Grouping = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.GroupingType = :Type$Division
   ORDER BY IssueTime, Status
   BEGIN
      i = i + 1;
   END;

   CurObject.ProcessOrders(OPList = OPList,
                           StartTime = StartTime);
   RETURN;
END;

METHOD ProcessOneBlock (
   Block = FMS_AutomationBlock;
   DayDiv = PARptDetail;
   DaySys = PARptDetail;
   TotDiv = PARptDetail;
   TotSys = PARptDetail;
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   DayDiv.Total = DayDiv.Total + 1;
   DaySys.Total = DaySys.Total + 1;
   TotDiv.Total = TotDiv.Total + 1;
   TotSys.Total = TotSys.Total + 1;

   IF Block.BlockStatus = BlockStatus$Complete THEN
      DayDiv.Successful = DayDiv.Successful + 1;
      DaySys.Successful = DaySys.Successful + 1;
      TotDiv.Successful = TotDiv.Successful + 1;
      TotSys.Successful = TotSys.Successful + 1;

   ELSEIF Block.BlockStatus = BlockStatus$Cancelled THEN
      DayDiv.Cancelled = DayDiv.Cancelled + 1;
      DaySys.Cancelled = DaySys.Cancelled + 1;
      TotDiv.Cancelled = TotDiv.Cancelled + 1;
      TotSys.Cancelled = TotSys.Cancelled + 1;

   ELSEIF Block.BlockStatus = BlockStatus$Manual THEN
      DayDiv.Manual = DayDiv.Manual + 1;
      DaySys.Manual = DaySys.Manual + 1;
      TotDiv.Manual = TotDiv.Manual + 1;
      TotSys.Manual = TotSys.Manual + 1;
 
   ELSEIF Block.BlockStatus = BlockStatus$Stopped THEN
      DayDiv.Stopped = DayDiv.Stopped + 1;
      DaySys.Stopped = DaySys.Stopped + 1;
      TotDiv.Stopped = TotDiv.Stopped + 1;
      TotSys.Stopped = TotSys.Stopped + 1;

   ENDIF;
END;

METHOD ProcessOrders(
   OPList = ARRAY OF OrderList;
   StartTime = DATE NOT NULL WITH DEFAULT;
) = 
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   FOR i = 1 TO OPList.LastRow DO
      j = INT4(INTERVAL('days', (Date_Trunc('day',OPList[i].IssueTime) - StartTime))) + 1;
   
      CurObject.DList[j].SYS.RROrders = CurObject.DList[j].SYS.RROrders + 1;
      CurObject.TList.SYS.RROrders = CurObject.TList.SYS.RROrders + 1;

      IF OPList[i].Status = 20002 THEN						/* Bronx */
         CurObject.DList[j].DX.RROrders = CurObject.DList[j].DX.RROrders + 1;
         CurObject.TList.DX.RROrders = CurObject.TList.DX.RROrders + 1;

      ELSEIF OPList[i].Status = 20003 THEN					/* Brooklyn */
         CurObject.DList[j].DB.RROrders = CurObject.DList[j].DB.RROrders + 1;
         CurObject.TList.DB.RROrders = CurObject.TList.DB.RROrders + 1;

      ELSEIF OPList[i].Status = 20004 THEN					/* Manhattan */
         CurObject.DList[j].DM.RROrders = CurObject.DList[j].DM.RROrders + 1;
         CurObject.TList.DM.RROrders = CurObject.TList.DM.RROrders + 1;

      ELSEIF OPList[i].Status = 20005 THEN					/* Queens */
         CurObject.DList[j].DQ.RROrders = CurObject.DList[j].DQ.RROrders + 1;
         CurObject.TList.DQ.RROrders = CurObject.TList.DQ.RROrders + 1;

      ELSEIF OPList[i].Status = 20006 THEN					/* Staten Is */
         CurObject.DList[j].DS.RROrders = CurObject.DList[j].DS.RROrders + 1;
         CurObject.TList.DS.RROrders = CurObject.TList.DS.RROrders + 1;

      ELSEIF OPList[i].Status = 20007 THEN					/* Westchester  */
         CurObject.DList[j].DW.RROrders = CurObject.DList[j].DW.RROrders + 1;
         CurObject.TList.DW.RROrders = CurObject.TList.DW.RROrders + 1;
      ENDIF;
   ENDFOR;
END;

METHOD LoadByDO (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/

   PrevOperator = INTEGER NOT NULL;
   ABList  = ARRAY OF FMS_AutomationBlock;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period and group them by DO.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.DList.Clear();
   
   ABList.Clear();
   i = 1;
   SELECT  :ABList[i].BlockStatus = B.BlockStatus
          ,:ABList[i].InitiatingDO = B.InitiatingDO    
          ,:ABList[i].DOName = O.Description
   FROM   FMS_AutomationBlock B,
          UDB_Object O
   WHERE  B.InitTime BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          B.InitiatingDO = O.Object
   ORDER BY InitiatingDO
   BEGIN  
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF ABList.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: Process Automation Report: ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for time period selected.';
      RETURN;
   ENDIF; 

   PrevOperator = -1;
   j = 0;

   FOR i = 1 TO ABList.LastRow DO
      IF PrevOperator <> ABList[i].InitiatingDO THEN
         j = j + 1;
         PrevOperator = ABList[i].InitiatingDO;

         CurObject.DList[j].Operator = ABList[i].InitiatingDO;
         CurObject.DList[j].OperatorName = ABList[i].DOName;
      ENDIF;

      CurObject.DList[j].OPSum.Total = CurObject.DList[j].OPSum.Total + 1;
   
      IF ABList[i].BlockStatus = BlockStatus$Complete THEN
         CurObject.DList[j].OPSum.Successful = CurObject.DList[j].OPSum.Successful + 1;

      ELSEIF ABList[i].BlockStatus = BlockStatus$Cancelled THEN
         CurObject.DList[j].OPSum.Cancelled = CurObject.DList[j].OPSum.Cancelled + 1;

      ELSEIF ABList[i].BlockStatus = BlockStatus$Manual THEN
         CurObject.DList[j].OPSum.Manual = CurObject.DList[j].OPSum.Manual + 1;
 
      ELSEIF ABList[i].BlockStatus = BlockStatus$Stopped THEN
         CurObject.DList[j].OPSum.Stopped = CurObject.DList[j].OPSum.Stopped + 1;

      ENDIF;   
   ENDFOR;

   RETURN;
END;

METHOD LoadDetails (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;     /*Counter*/

   DynamicWhereClause = VARCHAR(600) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load details for a particular cell
** that was selected on the yellow warning report.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';  

   CurObject.BList.Clear();

   IF CurObject.StatusIdx = 0 THEN 
      CurObject.BlockStatus = 0;

   ELSEIF CurObject.StatusIdx = 1 THEN 
      CurObject.BlockStatus = BlockStatus$Complete;

   ELSEIF CurObject.StatusIdx = 2 THEN 
      CurObject.BlockStatus = BlockStatus$Manual;

   ELSEIF CurObject.StatusIdx = 3 THEN 
      CurObject.BlockStatus = BlockStatus$Stopped;
   
   ELSEIF CurObject.StatusIdx = 4 THEN 
      CurObject.BlockStatus = BlockStatus$Cancelled;
   ENDIF;

   IF CurObject.Operator = 0 THEN  /* Selecting details for a day */
      CurObject.EndDate = CurObject.StartDate + '1 day';

      IF CurObject.BlockStatus = 0 THEN					/* TOTAL FIELD */
         IF CurObject.Division = 0 THEN
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
         ELSE
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.Division =' + VARCHAR(CurObject.Division) + ' AND ' + 
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
         ENDIF;
      ELSE						/* successful, stopped, manual or cancelled */
         IF CurObject.Division = 0 THEN
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.BlockStatus = ' + VARCHAR(CurObject.BlockStatus) + ' AND ' +
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
         ELSE
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.Division =' + VARCHAR(CurObject.Division) + ' AND ' + 
                'B.BlockStatus = ' + VARCHAR(CurObject.BlockStatus) + ' AND ' +
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
         ENDIF;
      ENDIF;
   ELSE
      /*
      ** detailed blocks initiated by the D.O.
      */
      CurObject.EndDate = CurObject.EndDate + '1 day';

      IF CurObject.BlockStatus = 0 THEN					/* TOTAL FIELD */
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.InitiatingDO = ' + VARCHAR(CurObject.Operator) + ' AND ' + 
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
      ELSE						/* successful, stopped, manual or cancelled */
            DynamicWhereClause = 'B.InitTime <= Date(''' + VARCHAR(CurObject.EndDate) + ''') AND ' + 
                'B.InitTime >= Date(''' + VARCHAR(CurObject.StartDate) + ''') AND ' + 
                'B.InitiatingDO = ' + VARCHAR(CurObject.Operator) + ' AND ' + 
                'B.BlockStatus = ' + VARCHAR(CurObject.BlockStatus) + ' AND ' +
                'B.InitiatingDO = O.Object AND ' + 
                'B.Card = C.Card';
     ENDIF;
   ENDIF;

   i = 1;
   SELECT  :CurObject.BList[i].Card = B.Card
          ,:CurObject.BList[i].CardName = C.FeederName
          ,:CurObject.BList[i].Division = B.Division
          ,:CurObject.BList[i].Block = B.Block
          ,:CurObject.BList[i].BlockSeq = B.BlockSeq
          ,:CurObject.BList[i].BlockEnd = B.BlockEnd
          ,:CurObject.BList[i].BlockStart = B.BlockStart
          ,:CurObject.BList[i].BlockStatus = B.BlockStatus
          ,:CurObject.BList[i].BlockStopped = B.BlockStopped
          ,:CurObject.BList[i].BlockTitle = B.BlockTitle
          ,:CurObject.BList[i].DOName = O.Description
          ,:CurObject.BList[i].InitTime = B.InitTime
          ,:CurObject.BList[i].SendTo = B.SendTo
          ,:CurObject.BList[i].StopReason = B.StopReason
   FROM   FMS_AutomationBlock B,
          FMS_Card C,
          UDB_Object O
   WHERE  :DynamicWhereClause
   UNION
   SELECT   B.Card
          , C.FeederName
          , B.Division
          , B.Block
          , B.BlockSeq
          , B.BlockEnd
          , B.BlockStart
          , B.BlockStatus
          , B.BlockStopped
          , B.BlockTitle
          , O.Description
          , B.InitTime
          , B.SendTo
          , B.StopReason
   FROM   FMS_AutomationBlock B,
          FMS_ArchiveCard C,
          UDB_Object O
   WHERE  :DynamicWhereClause 
   ORDER BY Division, Card, BlockSeq, InitTime
   BEGIN  
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
    
   IF CurObject.BList.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: PAReport_ASE(LoadDetails): ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate) + HC_NEWLINE +
                  '   Division      = ' + VARCHAR(CurObject.Division) + HC_NEWLINE +
                  '   BlockStatus     = ' + VARCHAR(CurObject.BlockStatus) + HC_NEWLINE +
                  '   Operator  = ' + VARCHAR(CurObject.Operator));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for selected field.';
   ENDIF;

   RETURN;
END;

