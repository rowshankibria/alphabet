/*
**
**      Copyright c 2000 ALSTOM ESCA Corporation.  All rights reserved.
**
**      ALSTOMe ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          Equipment
**
**  Date:       Author   Description
** ----------------------------------
**  06/12/00    em   Created GenerateBusSection method
**  12/04/00    em   TFMS cards will pass the card parm, then we need
**                   to use it to make sure selected terminal
**                   is for a device on the current TFMS card.
**  02/16/03    em   Replace Message with TraceError Call
**  01/08/07    em   Make sure this is not a duplicate in the substation.
**  08/18/10    ysp  New AddNewEquip method - converted from FeederCard's AddEquip frame.
**  06/21/12    em   ATS Grouper use ExtendedType instead of SuperType
**  08/24/15    pkw  Stream line ATS creation process.
**  06/12/17    em   GenerateBusSection is no longer used by SOA NewMoves but
**                   still is linked to EstablishEquipmentObjective.
**                   The connectivity handling is being disabled with the QGIS
**                   connectivity model.
**  03/12/19    ysp  add method NotifyXA21
**
**/
METHOD GenerateBusSection (
   Card                 = INTEGER NOT NULL WITH DEFAULT; /*Passed for TFMS*/
) =
DECLARE
   ConnectToEquip	= INTEGER NOT NULL; /*Equip where bus sect connected*/
   ConnectToNode	= INTEGER NOT NULL; /*Node where bus sect connected*/
   i          		= INTEGER NOT NULL; /*Index*/
   LineList		= ARRAY OF ObjectSummaryClass; /*Connected Lines*/
   RetCode 		= INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** Duplicate Check
*/
   i = 0;
   SELECT :i = O.Object
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :CurObject.Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Name = :CurObject.EquipName AND
          O.Type IN (SELECT Type FROM Udb_ExtendedType 
                     WHERE  SuperType = :CurObject.EquipClass);
 
   IF i <> 0 THEN
      CALLPROC TraceError (UserMessage = 
             'WARNING: Trying to create a duplicate Bus Section. ',
                           TraceMessage =
             'Equipment;GenerateBusSection; Trying to create a duplicate.'
             );
       RETURN(0);
   ENDIF;                 
/*
** get next available bus sectionobject from unused pool.
*/
   CurObject.Equip = 0;
   SELECT :CurObject.Equip = IFNULL(MIN(Member),0) 
   FROM   Udb_Grouping 
   WHERE  Grouping = :Unused$BusSect AND
          Relationship = :Interaction$MemberOf;

   IF CurObject.Equip = 0 THEN
      CALLPROC TraceError (UserMessage = 
             'ERROR: No more bus sections available in unused pool. ' +
              'Please inform technical support.',
                           TraceMessage =
             'Equipment;GenerateBusSection; No more bus sections available ' +
             'in unused pool.'
             );
      RETURN(0);
   ELSE 
/*
** get node where we will be connecting
** Disabled 06/12/17
      ConnectToNode = 0;
      ConnectToNode = CALLFRAME SelectBusEquip(
                                 Card = Card,
                                 Substation = CurObject.Substation,
                                 BusSectionName = CurObject.Equipname,
                                 SelectedEquip = BYREF(ConnectToEquip));

      IF ConnectToNode = 0 THEN
         CALLPROC TraceError (UserMessage = 
             'ERROR: No connectivity information provided for generic ' + 
              'Bus Section',
                           TraceMessage =
             'Equipment;GenerateBusSection; No connectivity information ' +
             'provided for generic ' + 
             'Bus Section.'
             );
         RETURN(0);
      ENDIF;
/*
** update necessary information in the database, including, object, groupings,
** and terminals.
*/
      RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = CurObject.Equip,
                         Type = CurObject.EquipClass,
                         TypeName = CurObject.EquipClassName,
                         PrimaryGrouping = CurObject.Substation,                              
                         PrimaryGroupingName = CurObject.Substationname,
                         Name = CurObject.EquipName,
                         Description = CurObject.Description,
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM');                              
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update Bus Section Object. ', 
                           TraceMessage =
             'Equipment;GenerateBusSection; ' +
             'Unable to update Bus Section Object. '
             );
         RETURN(0);
      ENDIF;
/*
** remove link to unused pool
*/ 
      RetCode = CALLPROC Udb_GroupingDel (
                         Grouping = Unused$BusSect ,                    
                         Relationship = Interaction$MemberOf,
                         Member = CurObject.Equip);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to remove Bus Section Object from pool. ', 
                           TraceMessage =
             'Equipment;GenerateBusSection; ' +
             'Unable to remove Bus Section Object from pool. '
             );
         RETURN(0);
      ENDIF;
/*
** Update the connectivity
** Disabled 06/12/17
      RetCode = CALLPROC Udb_TerminalUpd (
                         Node = ConnectToNode,
                         Object = CurObject.Equip,
                         Terminal = 1);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to establish connectivity for new bus section. ', 
                           TraceMessage =
             'Equipment;GenerateBusSection; ' +
             'Unable to establish connectivity for new bus section. '
             );
         RETURN(0);
      ENDIF;
      CALLPROC DDB_COMMIT;
/*
**  Make the new bus section be the member of lines to where it is 
**  being connected
*/
      i = 1;
      SELECT :LineList[i].Object = G.Grouping,
             :LineList[i].Type = G.GroupingType
      FROM Udb_Grouping G,
           Udb_ExtendedType ET
      WHERE G.Member = :ConnectToEquip AND
            G.GroupingType = ET.Type AND
            ET.SuperType = :Type$Line AND
            G.Relationship = :Interaction$MemberOf
      BEGIN 
            i = i + 1;
      END;

      FOR i = 1 TO LineList.LastRow() DO
         RetCode = CALLPROC Udb_GroupingIns (
                                        SystemVersion = 0,
                                        Grouping = LineList[i].Object,
                                        GroupingType = LineList[i].Type,
                                        Member = CurObject.Equip,
                                        MemberType = CurObject.EquipClass,
                                        Relationship = Interaction$MemberOf,
                                        Reference = '');

         IF (RetCode < 0) THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to link new Bus Section ' + 
                     CurObject.EquipName + ' with the appropriate lines. ' +
                    'You will need to correct this manually.'; 
                           TraceMessage =
             'Equipment;GenerateBusSection; ' +
             'Unable to link new Bus Section ' + 
             CurObject.EquipName + ' with the appropriate lines. ' +
             'Will need to correct this manually.. '
             );
         ENDIF;
      ENDFOR;     
      CALLPROC DDB_COMMIT;

      RETURN (CurObject.Equip);
   ENDIF;  
END;

METHOD AddNewEquip(
   Division = INTEGER NOT NULL;
   DivisionName = VARCHAR(40) NOT NULL;
   CoLocatedEquip = INTEGER NOT NULL;
   CoLocatedType = INTEGER NOT NULL;
) =
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;             /* Temporary counters */ 
    j = INTEGER NOT NULL WITH DEFAULT;             /* Temporary counters */ 

    ATSTrue = INTEGER NOT NULL;         /* boolean for ATS equipment */
    ATSType = INTEGER NOT NULL;    
    CurNode = INTEGER NOT NULL;         /* current node for connectivity */

    EquipBank = ObjectClass;
    EquipName = VARCHAR(40) NOT NULL;
    EquipClassName = VARCHAR(40) NOT NULL; 

    Fdr   = FeederObject DEFAULT NULL; 
    FeederExists = VARCHAR(40) NOT NULL WITH DEFAULT;
    HTVTrue = INTEGER NOT NULL;         /* boolean for HTV equipment */
    
    IsNC = INTEGER;
    IsPG = INTEGER;
    ATSLoadFdr = VARCHAR(40) NOT NULL WITH DEFAULT;
    LF_Address = Equipment;    

    MacroAdded = INTEGER NOT NULL WITH DEFAULT; 
    MacroType = INTEGER NOT NULL;       /* Macro Type */
    MacroName = VARCHAR(40) NOT NULL;   /* Macro Name */
    MacroName2 = VARCHAR(40) NOT NULL;  /* Macro Name for parsing */
    MacroName3 = VARCHAR(40) NOT NULL;  /* Macro Name for parsing */
    MacroValidated = DATE;
    MacroValidatedBy = VARCHAR(6) NOT NULL WITH DEFAULT;
    MacroObj = INTEGER NOT NULL WITH DEFAULT;
    NewObj = INTEGER NOT NULL WITH DEFAULT;
    NormalStatus = INTEGER NOT NULL WITH DEFAULT;    

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    SaveATS = ARRAY OF Equipment;      /* Save ATS equipment */
    SaveATSType = INTEGER NOT NULL;    /* one of ATS-Grouper subtypes */
    SaveATSTypeName = VARCHAR(40) NOT NULL;    /* one of ATS-Grouper subtypes */
    SDVISTrue = INTEGER NOT NULL;      /* boolean for ATS equipment */
    Terminal = INTEGER NOT NULL;
    TempName = VARCHAR(40) NOT NULL;    
    TempType = INTEGER NOT NULL;    
    SelectedEquipment = Equipment DEFAULT NULL;
   
    Validated = DATE;
    ValidatedBy = VARCHAR(6) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    CurObject.ReturnCode = 0;
    CurObject.ErrorMessage = '';            

   IF Division = 0 OR DivisionName = '' THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You must select a Division';
      RETURN;
   ENDIF;
   
   IF CurObject.EquipClass <= 0 THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You must select an Equipment Type.';
      RETURN;
   ENDIF;

   IF CurObject.EquipName = '' THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You must enter the Equipment Name.';
      RETURN;
   ENDIF;
/*
** Look for new equipment in division - may be in dropped bank, new bank, or on
** another feeder. 
*/
   EquipBank.Object = 0;
   REPEATED
   SELECT    :EquipBank.Object = O.Object,
             :EquipBank.InService = O.InService,
             :EquipBank.OutService = O.OutService
   FROM      UDB_Object O
   WHERE     O.Type = :CurObject.EquipClass AND
             O.Name = :CurObject.EquipName AND
             O.PrimaryGrouping = :Division;

   IF EquipBank.Object <> 0 THEN
      IF EquipBank.InService IS NULL AND EquipBank.OutService IS NULL THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Equipment with this type and name already exists in the New Equipment Bank for ' +
                DivisionName;
         RETURN;

      ELSEIF EquipBank.OutService IS NOT NULL THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Equipment with this type and name already exists in the Dropped Equipment Bank for ' +
                DivisionName;
         RETURN;

      ELSE
         FeederExists = '';
         REPEATED 
         SELECT  :FeederExists = O.Name
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 Udb_ExtendedType ET 
         WHERE   ET.SuperType = :Type$Feeder AND
                 ET.Type = G.GroupingType AND 
                 O.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = :EquipBank.Object;

         IF FeederExists <> '' THEN
             CurObject.ReturnCode = -100;
             CurObject.ErrorMessage = 'Equipment with this type and name already exists on Feeder ' +
                     :FeederExists + '.';
             RETURN;
         ELSE
             CurObject.ReturnCode = -200;
             CurObject.ErrorMessage = 'Equipment with this type and name already exists in the ' +
                     'Division. Could not determine on which feeder.';
             RETURN;
         ENDIF;
      ENDIF;

   ELSE   
/*
** Look for equipment on all feeders or substations in division
*/
      FeederExists = '';
      REPEATED 
      SELECT  :FeederExists = O1.Name
      FROM    Udb_Object O1,
              Udb_Object O2,
              Udb_Grouping G
      WHERE   G.Grouping = :Division AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O1.Object AND
              G.Member = O2.PrimaryGrouping AND
              O2.Type = :CurObject.EquipClass AND
              O2.Name = :CurObject.EquipName;

      IF FeederExists <> '' THEN
          CurObject.ReturnCode = -100;
          CurObject.ErrorMessage = 'Equipment with this type and name already exists on ' +
                  'Feeder or Substation: ' + FeederExists + '.';
          RETURN;
      ENDIF;
   ENDIF;

/*
**  Check to see if they are adding an SD-VIS.
**  If so, add the SD-VIS and all of it's pieces along with connectivity.
*/
   IF (CurObject.EquipClass = Type$SDVis) THEN
        /*
        ** Let the user know what we are about to do, and let them cancel out if they wish.
        ** If they choose to cancel out, nothing will be created.
        */  
        IF (CurMethod.ConfirmPopup(messagetext = 'The system will automatically create ' +
            'the SD-VIS and the line and load side components and connect them together.' +
            '  Continue?') = PU_CANCEL) THEN
            CurObject.ReturnCode = -2;
            CurObject.ErrorMessage = 'The SD-VIS will not be created.';
            RETURN;
        ENDIF;
        /*
        ** Add an object for each piece.  (3 objects in all)
        ** Prevalidate Macro object
        */
        MacroValidatedBy = 'SYSTEM';
        MacroValidated = 'now';
          
        /* Set terminals to 2 */
        CurObject.Terminals = 2;
  
        i = 1;
        j = 1;
        WHILE (i <= 3) DO
            NewObj = CALLPROC FMS_AddEquipmentOnLine (
                    Type = CurObject.EquipClass,
                    Name = CurObject.EquipName,
                    Description = CurObject.ObjectDescription,
                    Validated = MacroValidated,
                    ValidatedBy = MacroValidatedBy,
                    Terminals = CurObject.Terminals,
                    EquipComment = CurObject.EquipComment,
                    RelayType = CurObject.RelayType,
                    NetworkType = CurObject.NetworkType,
                    Combination = CurObject.Combination,
                    NormalOpen = CurObject.NormalOpen,
                    LockNumber = CurObject.LockNumber,
                    PrimaryGrouping = Division,
                    L1 = CurObject.Address1,
                    L2 = CurObject.Address2,
                    L3 = CurObject.Address3,
                    L4 = CurObject.Address4,
                    Comment = CurObject.LocationComment,
                    ColocatedEquipment = CoLocatedEquip,
                    ColocatedType = CoLocatedType); 

            IF (NewObj <= 0) THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = -1;
                CurObject.ErrorMessage = 'Error occurred while trying to add SD-VIS equipment. No equipment added!';
                RETURN;
            ENDIF;

            IF (CurObject.EquipClass != Type$SDVis) THEN /* EquipClass is updated in loop */
                /* make the component a member of the SD-VIS 
                */
                RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = MacroObj,
                                GroupingType = Type$SDVis,
                                Member = NewObj,
                                MemberType = CurObject.EquipClass,
                                Relationship = Interaction$MemberOf,
                                Reference = '');

                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for SD-VIS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
                /* delete the location grouping for the component created above 
                */
                RetCode = CALLPROC Udb_GroupingDel (
                                Grouping = NewObj,
                                Relationship = Interaction$LocatedWith,
                                Member = NewObj);
        
                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for SD-VIS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
                /* locate the component with the SD-VIS 
                */
                RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = MacroObj,
                                GroupingType = Type$SDVis,
                                Member = NewObj,
                                MemberType = CurObject.EquipClass,
                                Relationship = Interaction$LocatedWith,
                                Reference = '');

                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for SD-VIS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
            ELSE        /* the macroobject is the SD-VIS object */
                MacroObj = NewObj;
                CurObject.Equip = MacroObj;
                EquipName = CurObject.EquipName;
                EquipClassName = CurObject.EquipClassName;
            ENDIF;
        /*
        **  Save the pieces of the SD-VIS
        */
            IF (i > 1) THEN
                SaveATS[j] = CurObject.Duplicate();
                SaveATS[j].Equip = NewObj;
                j = j + 1;
            ENDIF;    
        /*
        **  Create the name for the next piece and assign a type for it.
        */
            IF (i = 1) THEN
                CurObject.EquipClass = Type$SDVISLine;
                CurObject.EquipClassName = 'SD-VISLine';
                CurObject.EquipName = EquipName;
            ELSEIF (i = 2) THEN
                CurObject.EquipClass = Type$SDVISLoad;
                CurObject.EquipClassName = 'SD-VISLoad';
                CurObject.EquipName = EquipName;
            ENDIF;

            i = i + 1;            
        ENDWHILE;
        CALLPROC DDB_COMMIT;

        /* insert audit trail 
        */
        RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'UDB_Object'
                   ,Handle = MacroObj     
                   ,HandleName = EquipClassName + ' ' + EquipName                           
                   ,LogTime = DATE('Now')
                   ,Operator = DOp.Object
                   ,OperatorName = DOp.Description
                   ,Item = 'Add SD-VIS'
                   ,Old = DivisionName + ' ' + 
                      EquipClassName + ' ' + 
                      EquipName 
                   ,New = 'Desk ' + UserName);     
        CALLPROC DDB_COMMIT;    

        /*
        **  Popup the Change SD-VIS Equipment Screen.
        */
        CALLFRAME ChangeATSEquipType(JD = byref(SaveATS),
                                     EquipClassName = 'SD-VIS' );
        /*
        **  Loop through the Save equipment array and update the types and
        **  add connectivity information.
        */ 
        i = SaveATS.LastRow();
        WHILE (i >= 1) DO
            RetCode = CALLPROC Udb_ObjectUpd (  
                Object = SaveATS[i].Equip,
                PrimaryGrouping = Division,
                Type = SaveATS[i].EquipClass, 
                Name = SaveATS[i].EquipName);

            IF (RetCode != 0) THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = -1;
                CurObject.ErrorMessage = 'There was an error updating the type for ' + SaveATS[i].EquipName;
            ELSE
                CALLPROC DDB_COMMIT;
            ENDIF;

            /* Add the connectivity                 
            ** For the load SD-VIS piece, attach terminal one, for the others, attach terminal 2
            */
            IF i = SaveATS.LastRow() THEN     /* create the node and attach terminal one */
                CurNode = CALLPROC Udb_CreateNewNode(
                             Node = -1,                        /* new node */
                             Name = '',                        /* no name */
                             PrimaryGrouping = MacroObj,       /* the SD-VIS */ 
                             kVLevel = 0,                      /* unknown */
                             Object = SaveATS[i].Equip, 
                             Terminal = 1);

                IF (CurNode < 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Unable to connect SD-VIS equipment.';
                    RETURN;
                ENDIF;
                CALLPROC DDB_COMMIT;

            ELSEIF (i < SaveATS.LastRow()) THEN     /* attach terminal two */
                Retcode = CALLPROC Udb_TerminalUpd(
                            Node = CurNode,
                            Object = SaveATS[i].Equip, 
                            Terminal = 2);
                IF (Retcode < 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Unable to connect SD-VIS equipment.';
                    RETURN;
                ENDIF;
                CALLPROC DDB_COMMIT;    
            ENDIF;

            i = i - 1;
        ENDWHILE;

        CurObject.ReturnCode = 0;
        CurObject.ErrorMessage = 'Equipment was added successfully.';
        RETURN; /* resume so that the other code will not be processed */
   ENDIF;

/*
**  Check to see if they are adding an ATS.
**  (ATS/ATP/ATSU/ATSD are subtypes of ATS-Grouper)
**  If so, add the ATS and all of it's pieces along with connectivity.
**  We are explicitly only looking for the ATS Macro Types that are direct
**  subtypes of the ATS Grouper.
*/
    ATSType = 0;
    SaveATSType = 0;

    REPEATED
    SELECT :ATSType = Count(*) 
    FROM   Udb_ExtendedType ST
    WHERE  ST.SuperType = :Type$ATSGrouper AND
           ST.Type = :CurObject.EquipClass; 

    IF ATSType >= 1 THEN
       RetCode = CALLFRAME ATSEquipOptions(
                          ATSType = CurObject.EquipClassName,
                          ATSName = CurObject.EquipName,
                          Closed = byref(IsNC),
                          Feeder = byref(ATSLoadFdr),
                          IsPG  = byref(IsPG),
                          LF = byref(LF_Address)
                          );

       IF RetCode = PU_CANCEL THEN
          CurObject.ReturnCode = -2;
          CurObject.ErrorMessage = CurObject.EquipClassName + ' ' + CurObject.EquipName +
                                  ' creation was cancelled';
          RETURN;
       ENDIF;
       /*
       ** Add an object for each piece.  (4 objects in all)
       ** Prevalidate Macro object
       */
        MacroValidatedBy = 'SYSTEM';
        MacroValidated = 'now';
        SaveATSType = CurObject.EquipClass;
        SaveATSTypeName = CurObject.EquipClassName;

        /* set terminals to 2 */
        CurObject.Terminals = 2;
            
        i = 1;
        j = 1;
        WHILE (i <= 4) DO
            NewObj = CALLPROC FMS_AddEquipmentOnLine (
                    Type = CurObject.EquipClass,
                    Name = CurObject.EquipName,
                    Description = CurObject.ObjectDescription,
                    Validated = MacroValidated,
                    ValidatedBy = MacroValidatedBy,
                    Terminals = CurObject.Terminals,
                    EquipComment = CurObject.EquipComment,
                    RelayType = CurObject.RelayType,
                    NetworkType = CurObject.NetworkType,
                    Combination = CurObject.Combination,
                    NormalOpen = CurObject.NormalOpen,
                    LockNumber = CurObject.LockNumber,
                    PrimaryGrouping = Division,
                    L1 = CurObject.Address1,
                    L2 = CurObject.Address2,
                    L3 = CurObject.Address3,
                    L4 = CurObject.Address4,
                    Comment = CurObject.LocationComment,
                    ColocatedEquipment = CoLocatedEquip,
                    ColocatedType = CoLocatedType); 

            IF (NewObj <= 0) THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = -1;
                CurObject.ErrorMessage = 'Error occurred while trying to add ATS equipment. No equipment added!';
                RETURN;
            ENDIF;

            IF CurObject.EquipClass <> SaveATSType THEN
                /* make the component a member of the ATS */
                RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = MacroObj,
                                GroupingType = SaveATSType,
                                Member = NewObj,
                                MemberType = CurObject.EquipClass,
                                Relationship = Interaction$MemberOf,
                                Reference = '');

                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for ATS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
                /* delete the location grouping for the component created above 
                */
                RetCode = CALLPROC Udb_GroupingDel (
                                Grouping = NewObj,
                                Relationship = Interaction$LocatedWith,
                                Member = NewObj);
        
                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for ATS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
                /* locate the component with the ATS 
                */
                RetCode = CALLPROC Udb_GroupingIns (
                                SystemVersion = 0,
                                Grouping = MacroObj,
                                GroupingType = SaveATSType,
                                Member = NewObj,
                                MemberType = CurObject.EquipClass,
                                Relationship = Interaction$LocatedWith,
                                Reference = '');

                IF (RetCode != 0) THEN
                    CALLPROC DDB_ROLLBACK;
                    CurObject.ReturnCode = -1;
                    CurObject.ErrorMessage = 'Error occurred while trying to add groupings for ATS equipment.' +
                            '  No equipment added!';
                    RETURN;
                ENDIF;
            ELSE        /* the macroobject is the ATS object */
                MacroObj = NewObj;
                CurObject.Equip = MacroObj;
                EquipName = CurObject.EquipName;
                EquipClassName = CurObject.EquipClassName;
            ENDIF;
        /*
        **  Save the pieces of the ATS
        */
            IF (i > 1) THEN
               SaveATS[j] = CurObject.Duplicate();
               SaveATS[j].Equip = NewObj;
               
               IF j < 3 THEN
                  /*
                  **  Attempt to initialize the 101 and 102 device
                  */
                  RetCode = CALLPROC Udb_SwitchCurrentUpd(
                         Object = NewObj,
                         CurrentlyOpen = NormalStatus);
                  
                  IF (RetCode <> 0) THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage =
                        'ERROR: Unable to set Currently Open device status.',
                           TraceMessage =
                        'Equipment: Unable to set Currently Open ' +
                        'device status for switch object=' + VARCHAR(NewObj) + '.'
                        );
                  ENDIF;
                  CALLPROC DDB_COMMIT;
               ENDIF;
 
               j = j + 1;
            ENDIF;    
        /*
        **  Create the name for the next piece and assign a type for it.
        */
            IF (i < 4) THEN
                CurObject.EquipName = EquipName + '-10' + char(i);
            ENDIF;
        
            IF (i = 1) THEN
                TempType = Type$ATS101;
                IF IsNC = 1 THEN
                   TempName = lowercase(SaveATSTypeName) + '-nc1';
                   NormalStatus = 0;
                ELSE
                   TempName = lowercase(SaveATSTypeName) + '-no1';
                   NormalStatus = 1;
                ENDIF;
            ELSEIF (i = 2) THEN
                TempType = Type$ATS102;
                IF IsNC = 1 THEN
                   TempName = lowercase(SaveATSTypeName) + '-no2';
                   NormalStatus = 1;
                ELSE
                   TempName = lowercase(SaveATSTypeName) + '-nc2';
                   NormalStatus = 0;
                ENDIF;

            ELSEIF (i = 3) THEN
                TempType = Type$ATSLoad;
                IF IsPG = 1 THEN
                   TempName = 'ats-loadp';
                ELSE
                   TempName = 'ats-load';
                ENDIF;
            ENDIF;
            
            IF i < 4 THEN  /* Leave values for load to be used later */
               SELECT :CurObject.EquipClass = T.Type,
                      :CurObject.EquipClassName = T.Name
               FROM    Udb_ExtendedType ET,
                       Udb_Type T
               WHERE   ET.Supertype = :TempType AND
                       ET.Type = T.Type AND
                       lowercase(T.Name) = :TempName;
            ENDIF;
            i = i + 1;
            
        ENDWHILE;
        CALLPROC DDB_COMMIT;

        /* insert audit trail */
        RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'UDB_Object'
                   ,Handle = MacroObj      
                   ,HandleName = EquipClassName + ' ' + EquipName                        
                   ,LogTime = DATE('Now')
                   ,Operator = DOp.Object
                   ,OperatorName = DOp.Description
                   ,Item = 'Add ATS'
                   ,Old = DivisionName + ' ' + 
                      EquipClassName + ' ' + 
                      EquipName 
                   ,New = 'Desk ' + UserName);     
        CALLPROC DDB_COMMIT;    
        /*
        ** Create ATS Load Side Feeder
        */
        Fdr = NULL;
        Fdr = FeederObject.Create();
   
        Fdr.Object = 0;
        Fdr.Address1 = LF_Address.Address1;
        Fdr.Address2 = LF_Address.Address2;
        Fdr.Address3 = LF_Address.Address3;
        Fdr.Address4 = LF_Address.Address4;
        Fdr.Comment = '';
        Fdr.Description = LF_Address.Description;
        Fdr.Division = Division;
        Fdr.Legs = 0;  
        Fdr.LocationComment = 'Please see feeder print for ''Notes''';
        Fdr.Name = ATSLoadFdr;
        Fdr.Network = 0;
        Fdr.OtherDivision = 0;
        Fdr.Rating = 0;
        IF Division = Division$Bronx THEN
           Fdr.Substation = Object$ATSLoadBronx;
        ELSEIF Division = Division$StatenIsland THEN
           Fdr.Substation = Object$ATSLoad33kv;
        ELSE
           Fdr.Substation = Object$ATSLoad13kv;
        ENDIF;  
        Fdr.SubstationName = 'ATS LOAD';

        SelectedEquipment = NULL;
        SelectedEquipment = Equipment.Create();
        SelectedEquipment.Equip = 0;
      
        Fdr.GenerateFeeder(Source = SelectedEquipment);
        
        IF Fdr.ReturnCode < 0 THEN
           MESSAGE :Fdr.ErrorMessage;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Please review Feeder and correct any problems using Udb screens.';
           RETURN; 
        ENDIF;
        /*
        **  Add feeder to feeder array list that get initialized at feedercard startup
        */
        i = FeederList.LastRow + 1;
        FeederList[i].Object = Fdr.Object;
        FeederList[i].Name   = ATSLoadFdr;
        /*
        ** Set up relationships with load side equip and Feeder
        **
        */
        RetCode = CALLPROC FMS_PickupEquip
                    (Feeder = Fdr.Object
                    ,CurrentTime = date('now')
                    ,Equip = NewObj
                    ,Reference = LF_Address.PrintID
                    ,Relation = Interaction$MemberOf
                    ,EquipClass = CurObject.EquipClass
                    );
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Feeder Object saved, error creating membership with load side equipment.';  
           RETURN;
        ENDIF;
        CALLPROC DDB_COMMIT;
        /*
        **  Update Primary Grouping of Load side equip with ATS LOAD Substation
        */
        RetCode = CALLPROC Udb_ObjectUpd (  
             Object = NewObj,
             PrimaryGrouping = Fdr.Substation,
             Type = CurObject.EquipClass, 
             Name = CurObject.EquipName);

        IF (RetCode <> 0) THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'There was an error updating the type for ' + SaveATS[i].EquipName;
           RETURN;
        ENDIF;
        CALLPROC DDB_COMMIT;
        /*
        ** Source Groupings
        */
        RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = Fdr.Object
                    ,GroupingType = Type$Feeder
                    ,Member = NewObj
                    ,MemberType = CurObject.EquipClass
                    ,Relationship = Interaction$SourceBreaker
                    ,Reference = ''
                    );
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Feeder Object and Location saved, error insert Source Breaker grouping.';
           RETURN;
        ENDIF;

        RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = Fdr.Object
                    ,GroupingType = Type$Feeder
                    ,Member = NewObj
                    ,MemberType = CurObject.EquipClass
                    ,Relationship = Interaction$SourcePosition
                    ,Reference = ''
                    );
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Feeder Object and Location saved, error insert Source Position grouping.';
           RETURN;
        ENDIF;
        CALLPROC DDB_COMMIT;
        /*
        ** Update Member type of Grouper to load side Feeder
        */
        TempType = 0;
        SELECT :TempType = T.Type
        FROM    Udb_Type T,
                Udb_ExtendedType ET
        WHERE   ET.SuperType = :SaveATSType AND
                ET.Type = T.Type AND
                lowercase(T.Name) like '%load%';

        RetCode = CALLPROC Udb_GroupingUpd (
                  Grouping = Fdr.Object,
                  Relationship = Interaction$MemberOf,
                  Member = MacroObj,
                  MemberType = TempType,
                  Reference = LF_Address.PrintID);
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           Message 'Problem setting Mebertype and PrintID for ATS Grouper. ' +
                   'Correct via Udb Access.';
        ENDIF;
        CALLPROC DDB_COMMIT;

        
        CurObject.ReturnCode = 0;
        CurObject.ErrorMessage = 'Equipment was added successfully.';
        RETURN; /* resume so that the other code will not be processed */
    ENDIF;
/*
**  Check to see if the equipment that was just added belongs to an ATS or an HTV.
**  If so, check to see that a "grouper" exists for the equipment; if there isn't
**  one, then add it (as long as it does not exist in the exclusion list.
*/
/* check for SD-Vis */
    SDVISTrue = 0;
    REPEATED 
    SELECT  :SDVISTrue = 1
    FROM    Udb_ExtendedType
    WHERE   Type = :CurObject.EquipClass
    AND     SuperType = :Type$StepDown;

    IF SDVISTrue = 1 THEN
        CurObject.ReturnCode = -2;
        CurObject.ErrorMessage = 'This type of equipment should be created using the SD-VIS Superstructure.  ' +
                'Select Equipment type SD-VIS and create this equipment type as one of the ' +
                'SD-VIS components.';
        RETURN;
    ENDIF;

/* check for ATS */
    ATSTrue = 0;
    REPEATED 
    SELECT  :ATSTrue = 1
    FROM    Udb_ExtendedType
    WHERE   Type = :CurObject.EquipClass
    AND     SuperType = :Type$ATSGeneric;

/* if not ATS, check for HTV */
    IF (ATSTrue = 0) THEN
        HTVTrue = 0;
        SELECT  :HTVTrue = 1
        FROM    Udb_ExtendedType
        WHERE   Type = :CurObject.EquipClass
        AND     SuperType = :Type$HTVStd;

    ENDIF;  
/* 
** Build the appropriate Macro Name
*/                  
    IF (ATSTrue = 1) THEN   /* ATS Macro */
       MacroType = Type$ATS;
       /*
       **  Parse through the name to get the macro name
       */
       MacroName = left(CurObject.EquipName,(locate(CurObject.EquipName, '-')-1));
       MacroName2 = shift(CurObject.EquipName,(-1*(locate(CurObject.EquipName,'-'))));
       MacroName3 = left(MacroName2,(locate(MacroName2,'-')-1));
       IF (length(MacroName2) != length(MacroName3)) THEN
          MacroName =  MacroName + '-' + MacroName3;
       ENDIF;

    ELSEIF (HTVTrue = 1) THEN
       MacroType = Type$AbstractHTV; 

       IF LOCATE(CurObject.EquipName, 'HTV') < (SIZE(CurObject.EquipName)+1) THEN
          CurObject.ReturnCode = -2;
          CurObject.ErrorMessage = 'The HTV naming convention is "xxxx-yyy", like 7654-101. ' +
                  'You cannot use letters HTV in the equipment name.';
          RETURN;
       ENDIF;

       /* 
       ** If equipment name has two dashes, we want is in the middle for the
       ** HTV Macro Name.
       */
       MacroName3 = '';
       MacroName = left(CurObject.EquipName,(locate(CurObject.EquipName, '-')-1));
       MacroName2 = shift(CurObject.EquipName,(-1*(locate(CurObject.EquipName,'-'))));
       i = locate(MacroName2,'-');
       IF i < (SIZE(Macroname2)+1) THEN
          MacroName3 = left(MacroName2,(locate(MacroName2,'-')-1));
       ENDIF;
       IF length(MacroName3) > 0 THEN
          MacroName =  MacroName3;
       ENDIF;
       /*
       **  Add the letters 'HTV' to the macroname unless
       **  it is already there
       */
       IF LOCATE(MacroName, 'HTV') = (SIZE(MacroName)+1) THEN
          MacroName = 'HTV' + MacroName;
       ENDIF;
    ENDIF;

/*
** If the equipment is any of the following types, then it does not need/have
**  a macro/grouper for it.  Otherwise check to see if a macro/grouper already
**  exists for the equipment.
*/
    IF (CurObject.EquipClass = ExcludeHTV$G) OR
       (CurObject.EquipClass = ExcludeHTV$GFDRST) OR
       (CurObject.EquipClass = ExcludeHTV$PT) OR
       (CurObject.EquipClass = ExcludeHTV$PTA) OR
       (CurObject.EquipClass = ExcludeHTV$PTB) THEN
        ATSTrue = 0;    /* does not need ATS macro */
        HTVTrue = 0;    /* does not need HTV macro */
    ELSE
        MacroObj = 0;
        REPEATED
        SELECT  :MacroObj = O.Object,
                :MacroType = O.Type 
        FROM    Udb_Object O, 
                Udb_Grouping G
        WHERE   O.Name = :MacroName
        AND     O.Type = :MacroType
        AND     O.Object = G.Member
        AND     G.Relationship = :Interaction$MemberOf
        AND     G.GroupingType = :Type$Division
        AND     G.Grouping = :Division;
    ENDIF;
/*
**  Confirm action for the HTV/ATS equipment macros (if they are needed)
*/
    IF (MacroType = Type$AbstractHTV) AND (HTVTrue = 1) THEN
        RetCode = CALLFRAME ConfirmGrouper (  Division = Division,
                                              MacroObj = byref(MacroObj),
                                              MacroName = byref(MacroName) );
        IF (RetCode = PU_CANCEL) THEN
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'The HTV component has not been created.';
            RETURN;
        ENDIF;
    ELSEIF (MacroType = Type$ATS) AND (ATSTrue = 1) THEN
        IF (MacroObj = 0) THEN
            IF (CurMethod.ConfirmPopUp(messagetext = 'An ATS Superstructure ' + :MacroName + 
                ' does not exist for the ATS component you are adding. It will be created ' +
                'for you if you continue. You should, however, refer to the FMS User Guide ' +
                'for instructions on how best to add new ATS equipment.  Continue?') = PU_CANCEL) THEN
                Message 'The new ATS has not been created.';
                RETURN;
            ENDIF;
        ELSE
            IF (CurMethod.ConfirmPopUp(messagetext = 'This ATS component will be linked ' +
                'with ' + :MacroName + '.  Continue?') = PU_CANCEL) THEN
                CurObject.ReturnCode = -2;
                CurObject.ErrorMessage = 'New Equipment has not been created.';
                RETURN;
            ENDIF;
        ENDIF;
    ENDIF;
    
    IF DOp.Type = Type$PersonDO THEN
       Validated = 'now';
       ValidatedBy = DOp.Initials;
    ELSE
       Validated = NULL;
       ValidatedBy = '';
    ENDIF;
    
    NewObj = CALLPROC FMS_AddEquipmentOnLine (
               Type = CurObject.EquipClass,
               Name = CurObject.EquipName,
               Description = CurObject.ObjectDescription,
               Validated = Validated,
               ValidatedBy = ValidatedBy,
               Terminals = CurObject.Terminals,
               EquipComment = CurObject.EquipComment,
               RelayType = CurObject.RelayType,
               NetworkType = CurObject.NetworkType,
               Combination = CurObject.Combination,
               NormalOpen = CurObject.NormalOpen,
               LockNumber = CurObject.LockNumber,
               PrimaryGrouping = Division,
               L1 = CurObject.Address1,
               L2 = CurObject.Address2,
               L3 = CurObject.Address3,
               L4 = CurObject.Address4,
               Comment = CurObject.LocationComment,
               ColocatedEquipment = CoLocatedEquip,
               ColocatedType = CoLocatedType); 
 
    IF NewObj < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Unable to add new equipment.';
       RETURN;
    ENDIF;

/*
**  If this does not belong to an ATS or an HTV then just resume;
*/
    IF (ATSTrue = 0) AND (HTVTrue = 0) THEN
        CALLPROC DDB_COMMIT;

        CurObject.Equip = NewObj;

        CurObject.ReturnCode = 0;
        CurObject.ErrorMessage = 'New Equipment successfully added.';
  
        /* insert audit trail */
        RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'UDB_Object'
                   ,Handle = NewObj
                   ,HandleName = CurObject.EquipClassName + ' ' + CurObject.EquipName                               
                   ,LogTime = DATE('Now')
                   ,Operator = DOp.Object
                   ,OperatorName = DOp.Description
                   ,Item = 'Add Equip'
                   ,Old = DivisionName + ' ' + 
                      CurObject.EquipClassName + ' ' + 
                      CurObject.EquipName 
                   ,New = 'Desk ' + UserName);     
        CALLPROC DDB_COMMIT;
        RETURN;
    ENDIF;

/*
** NOTE!!  Do not commit until the grouper and it's groupings have been added.
*/
    MacroAdded = FALSE;
    IF (MacroObj = 0) THEN      /* create a macro */
        MacroObj = CALLPROC FMS_AddEquipmentOnLine (
               Type = MacroType,
               Name = MacroName,
               Description = '',
               Validated = 'now',
               ValidatedBy = 'SYSTEM',
               Terminals = 0,
               EquipComment = CurObject.EquipComment,
               RelayType = CurObject.RelayType,
               NetworkType = CurObject.NetworkType,
               Combination = CurObject.Combination,
               NormalOpen = CurObject.NormalOpen,
               LockNumber = CurObject.LockNumber,
               PrimaryGrouping = Division,
               L1 = CurObject.Address1,
               L2 = CurObject.Address2,
               L3 = CurObject.Address3,
               L4 = CurObject.Address4,
               Comment = CurObject.LocationComment,
               ColocatedEquipment = CoLocatedEquip,
               ColocatedType = CoLocatedType); 
 
        IF (MacroObj < 0) THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Error adding equipment information.  No new equipment added! ';
            RETURN;
        ENDIF;
        MacroAdded = TRUE;
    ENDIF;

/*
**  Group new equipment to the macro and if it's an ATS group the locations.
*/
    RetCode = CALLPROC Udb_GroupingIns (
                SystemVersion = Object$Null,
                Grouping = MacroObj,
                GroupingType = MacroType,
                Member = NewObj, 
                MemberType = CurObject.EquipClass,
                Relationship = Interaction$MemberOf,
                Reference = '');

    IF (RetCode != 0) THEN
        CALLPROC DDB_ROLLBACK;
        CurObject.ReturnCode = -1;
        CurObject.ErrorMessage = 'Error inserting grouping information for equipment.';
        RETURN;
    ENDIF;

    IF (ATSTrue = 1) THEN
        /* delete the location grouping for the component created */
        RetCode = CALLPROC Udb_GroupingDel (
                        Grouping = NewObj,
                        Relationship = Interaction$LocatedWith,
                        Member = NewObj);

        IF (RetCode != 0) THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Error occurred while trying to add groupings for ATS equipment.' +
                    '  No equipment added!';
            RETURN;
        ENDIF;
        /* locate the component with the ATS */
        RetCode = CALLPROC Udb_GroupingIns (
                        SystemVersion = 0,
                        Grouping = MacroObj,
                        GroupingType = Type$ATS,
                        Member = NewObj,
                        MemberType = CurObject.EquipClass,
                        Relationship = Interaction$LocatedWith,
                        Reference = '');

        IF (RetCode != 0) THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Error occurred while trying to add groupings for ATS equipment.' +
                    '  No equipment added!';
            RETURN;
        ENDIF;
    ENDIF;
/*
**  Commit now that all the groupings are correct!
*/
    CurObject.Equip = NewObj;

    CALLPROC DDB_COMMIT;

/* insert audit trail */
    IF MacroAdded = TRUE THEN
       SELECT :EquipClassName = Name      
       FROM   UDB_Type 
       WHERE  Type = :MacroType;

       RetCode = CALLPROC FMS_AuditTrailIns (
                    Entity = 'UDB_Object'
                   ,Handle = MacroObj   
                   ,HandleName = EquipClassName + ' ' + MacroName                            
                   ,LogTime = DATE('Now')
                   ,Operator = DOp.Object
                   ,OperatorName = DOp.Description
                   ,Item = 'Add ' + EquipClassName
                   ,Old = DivisionName + ' ' + 
                      EquipClassName + ' ' + MacroName
                   ,New = 'Desk ' + UserName);     
       CALLPROC DDB_COMMIT;
    ENDIF;
/*
**  If this is an ATS, add the connectivity information.
*/
    IF (ATSTrue = 1) THEN

        IF (CurObject.EquipName = (MacroName + '-103')) THEN
            Terminal = 1;
        ELSE
            Terminal = 2;
        ENDIF;
        /*
        **  Find the node for this equipment.
        */
        /* make the macroname search for all */
        MacroName = MacroName + '%';
        CurNode = 0;
        REPEATED
        SELECT  :CurNode = Node
        FROM    Udb_Terminal    
        WHERE   Object IN ( SELECT Object
                            FROM    Udb_Object
                            WHERE   Name LIKE :MacroName
                            AND     Type != :Type$ATS)
        AND     Node != 0;
        CALLPROC DDB_ROLLBACK;
        /*
        ** If no node exists, create one which will automatically attach the terminal.
        **  Otherwise, attach the terminal to the existing node.
        */
        IF (CurNode = 0) THEN   /* create the new node and attach the terminal */
            CurNode = CALLPROC Udb_CreateNewNode(
                         Node = -1,                        /* new node */
                         Name = '',                        /* no name */
                         PrimaryGrouping = MacroObj,  /* the ATS */ 
                         kVLevel = 0,                      /* unknown */
                         Object = NewObj, 
                         Terminal = Terminal);

            IF (CurNode < 0) THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = -1;
                CurObject.ErrorMessage = 'Equipment was added, but ATS was not connected successfully.  ' +
                        'Please correct connectivity using the Udb Access screens.';
                RETURN;
            ENDIF;
            CALLPROC DDB_COMMIT;

        ELSE                   /* attach the terminal to the node */
            Retcode = CALLPROC Udb_TerminalUpd(
                        Node = CurNode,
                        Object = NewObj, 
                        Terminal = Terminal);
            IF (Retcode < 0) THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = -1;
                CurObject.ErrorMessage = 'Equipment was added, but ATS was not connected successfully.  ' +
                        'Please correct connectivity using the Udb Access screens.';
                RETURN;
            ENDIF;
            CALLPROC DDB_COMMIT;    
        ENDIF;
    ENDIF;

    CurObject.ReturnCode = 0;
    CurObject.ErrorMessage = 'New Equipment successfully added to the New Bank for ' + DivisionName;            
    RETURN;
END;

METHOD NotifyXA21 (
) =
DECLARE
   i = INTEGER NOT NULL; /*Index*/
   EmailClass = EmailNotificationClass DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   FMSStation = VARCHAR(40) NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
   IF UPPERCASE(CurObject.OldEquipName) = UPPERCASE(CurObject.EquipName) THEN
      RETURN FALSE;
   ENDIF;
   
   // is it a load breaking or a source breaker?
   i = 0;
   SELECT :i = 1
   FROM   UDB_ExtendedType ET
   WHERE  ET.SuperType IN (:Type$LoadBreaking,
                           :Type$Source,
                           :Type$SOURCE_SBFKS,
                           :Type$SOURCE_Bifur,
                           :Type$SOURCE_VISY)  AND
          ET.Type = :CurObject.EquipClass;
                                    
   IF i = 0 THEN
      RETURN FALSE;
   ENDIF;
   
   // is it excluded from XA21 interface?   
   i = 0;
   SELECT :i = 1
   FROM   SOA_XA21Exclusion X,
          UDB_ExtendedType ET
   WHERE  X.Type = ET.SuperType AND
          ET.Type = :CurObject.EquipClass;
   CALLPROC DDB_ROLLBACK;
   
   IF i = 1 THEN
      RETURN FALSE;
   ENDIF;
   
   SELECT :SubstationName = Description,
          :FMSStation = Name
   FROM   UDB_Object
   WHERE  Object = :CurObject.Substation;
         
   // Send an email
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 20;                        // xa21 equipment update
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = '';     

   EmailClass.Subject = 'Equipment update for XA21-FMS interface';       
   EmailClass.Message1 = 'Type=' + CurObject.EquipClassName + ';;' + 
            'Old=' + CurObject.OldEquipName + ';;' +
            'New=' + CurObject.EquipName + ';;' +
            'Substation=' + SubstationName + ';;' +
            'FMSStation=' + FMSStation + ';;';

   EmailClass.Message2 = 'Message=Device ' + CurObject.EquipClassName + ' ' + CurObject.OldEquipName +
            ' in station ' + CurObject.SubstationName + 
            ' was renamed to ' + CurObject.EquipName + ';;';
   EmailClass.Template = 'XA21EquipUpdate.html';                      
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      CurMethod.Trace(Text = varchar(date('now')) + ':Equipment.NotifyXA21. ERROR: ' + 
             'Unable to notify XA21 of update of ' + CurObject.EquipClassName + ' ' + CurObject.EquipName);
      RETURN FALSE;
   ENDIF;

   RETURN TRUE;
END;   

