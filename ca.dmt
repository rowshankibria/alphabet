INITIALIZE
(
#  include StandardDeclarations
   J = ARRAY OF Job;                               /* Passed Jobs Array, for non-OpOrders */
   Card = INTEGER NOT NULL;                        /* Passed Card, for non-OpOrders ?? */
   OpOrder = INTEGER NOT NULL;                     /* Passed Operating Order, for OpOrders */
   FaultJob = INTEGER NOT NULL;                    /* Passed Fault Move, for FOD Interface */
   ReturnOpOrder = INTEGER NOT NULL WITH DEFAULT;  /* Passed BOOLEAN */ 
   ReturnFODOrder = INTEGER NOT NULL WITH DEFAULT; /* Passed BOOLEAN */
   ReturnFault = INTEGER NOT NULL WITH DEFAULT;    /* Passed BOOLEAN */
   TooQuick = INTEGER NOT NULL WITH DEFAULT;       /* Optional parm for FOD Order Return handling */
   XA21Job = INTEGER NOT NULL WITH DEFAULT;           /* Optional parm for manual XA21 completion */

   k = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;
   tq = INTEGER NOT NULL WITH DEFAULT;

   AckDO = VARCHAR(40) NOT NULL WITH DEFAULT; /* Ret Order Acknowledged by DO */
   AutomaticExecution = INTEGER NOT NULL WITH DEFAULT; /* Automation Status */ 
   BlankJD = EquipInProgress;         /* blank class */
   BreakMove = INTEGER NOT NULL;	/*BOOLEAN */
   CardClass = INTEGER NOT NULL WITH DEFAULT;
   Complete = DATE;              
   ConditionalMove = INTEGER NOT NULL;	/*BOOLEAN */
   Crew  = VARCHAR(40) NOT NULL WITH DEFAULT;
   CompleteOrIncomplete = CHAR(1) NOT NULL; /* C or I for the button */
   DccMsg = VARCHAR(500) NOT NULL; 
   DccRegion = VARCHAR(20) NOT NULL;
   DccCheck = INTEGER NOT NULL;
   Division = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1800);
   DSOReturnComment = VARCHAR(400) NOT NULL WITH DEFAULT;
   FODResponseType = VARCHAR(20) NOT NULL WITH DEFAULT;/*Byref to Define Fault*/
   FOTSituation = INTEGER NOT NULL WITH DEFAULT;   /* BOOLEAN */
   FodJobList = ARRAY OF FODJob;
   GroundMove = INTEGER NOT NULL;	/*BOOLEAN */
   GJ = Job;
   JIP = ARRAY OF JobInProgress; 
   Jobs = ARRAY OF JobInProgress; 
   JobStatus = INTEGER NOT NULL WITH DEFAULT;
   LastBtnHit = VARCHAR(15) NOT NULL WITH DEFAULT;
   ManualOperator = INTEGER NOT NULL WITH DEFAULT;  
   ManualRescind = INTEGER NOT NULL;   /*BOOLEAN */
   ManualFODRescind = INTEGER NOT NULL;   /*BOOLEAN */
   ManualReturnStarted = INTEGER NOT NULL WITH DEFAULT;
   OrderCard = INTEGER NOT NULL WITH DEFAULT;
   OrderTarget = VARCHAR(20) NOT NULL WITH DEFAULT;
   OrderDate = DATEOBJECT;
   OrderList = ARRAY OF DATEOBJECT;
   OrderIssueTime = DATE NOT NULL;
   OrderNum = INTEGER NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   OrderNumber1 = INTEGER NOT NULL WITH DEFAULT;
   OrderSequence = VARCHAR(20) NOT NULL WITH DEFAULT;
   OrderStatus = INTEGER NOT NULL WITH DEFAULT;
   OutstandingPhaseCheck = ARRAY OF FMS_PhaseCheckEquip;
   PhaseCheckRequired = INTEGER NOT NULL WITH DEFAULT;
   ReducedList = ARRAY OF ObjectClass; /* Reduced list of operators */
   RescindedMove = MoveRescission;
   ReturnOperatorList = ARRAY OF ObjectClass; 
   Row = Integer NOT NULL WITH DEFAULT;/* Row number */
   RSWhereClause = VARCHAR(1000) NOT NULL; 
   ShowRescindScreen = Integer NOT NULL WITH DEFAULT;
   SimpleEquip = EquipInProgress; /*Enables use of class methods */
   SimpleJob = JobInProgress;             /*Enables use of class methods */
   Status = INTEGER;
   TempJob = JobInProgress;
   TORS = INTEGER NOT NULL WITH DEFAULT;
   TOWhereClause = VARCHAR(1000) NOT NULL; 
   TempResponse = VARCHAR(120) NOT NULL WITH DEFAULT;
   ShiftTime = INTEGER NOT NULL WITH DEFAULT;
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   SteamOp = VARCHAR(40) NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   TypeOfDay = INTEGER NOT NULL WITH DEFAULT;
   TempString = VARCHAR(256) NOT NULL WITH DEFAULT;
   UndoRow = INTEGER NOT NULL WITH DEFAULT;
   vphaseground                 = INTEGER NOT NULL WITH DEFAULT; 
   vphasegroundresult           = CHAR(3) NOT NULL WITH DEFAULT;
   vphasebreak                  = INTEGER NOT NULL WITH DEFAULT;
   vphasebreakresult            = CHAR(3) NOT NULL WITH DEFAULT;
   vconditionalmove             = INTEGER NOT NULL WITH DEFAULT;
   vconditionalmoveresult       = CHAR(3) NOT NULL WITH DEFAULT;
   vcompositegroundmoveresult   = VARCHAR(12) NOT NULL WITH DEFAULT;
) =
DECLARE
   DeterminePhase = PROCEDURE;
   CreateDelayedFOTCard = PROCEDURE;
   UpdateOpOrderStatus = PROCEDURE;
ENDDECLARE
BEGIN
   CompleteOrIncomplete = '';
   BreakMove = FALSE; 
   ConditionalMove = FALSE; 
   GroundMove = FALSE;
   ManualRescind = FALSE;
   ManualFODRescind = FALSE;
   ShowRescindScreen = TRUE;
   AckDO = '';
   OrderReturnStatus = NULL;

   IF CurrentApplication = Application$FMS THEN
      FIELD(Moves[*].MoveFlag).CurBias = FB_VISIBLE;
      FIELD(Moves[*].PrintID).CurBias = FB_VISIBLE;
      FIELD(Moves[*].SubstationName).CurBias = FB_INVISIBLE;
/*    
** Load Card Details for current CutIn/CutOut
*/
      SELECT :CardDetails.CutOut = CutOut,
             :CardDetails.CutIn = CutIn
      FROM   FMS_Card
      WHERE  Card = :CardDetails.Card; 
   ELSE
      FIELD(Moves[*].MoveFlag).CurBias = FB_INVISIBLE;
      FIELD(Moves[*].PrintID).CurBias = FB_INVISIBLE;
      FIELD(Moves[*].SubstationName).CurBias = FB_VISIBLE;
   ENDIF;
   CurFrame.Flush();
   CurFrame.SendUserEvent(EventName = 'PositionFreeText');

   IF ReturnOpOrder = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'ReturnOpOrder');
   ELSEIF ReturnFODOrder = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'ReturnFODOrder');
   ELSEIF ReturnFault = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'ReturnFault');
   ELSEIF XA21Job <> 0 THEN
      CurFrame.SendUserEvent (EventName = 'XA21Manual');
   ELSE
      CurFrame.SendUserEvent (EventName = 'NormalReturn');
   ENDIF;
END;

ON USEREVENT 'PositionFreeText' =
BEGIN
/* 
**  size the title areas so that they line up appropriately
*/
   /** figure out width of line **/
   i = ((Field(LineWidthTemplate).OuterWidth - 
           Field(LineWidthTemplate).Width)/ 2);

   Field(TakeOut_txt).AbsXleft =
        Field(Moves).TableHeader.ChildFields[1].AbsXleft - i;
   Field(TakeOut_txt).AbsYBottom =
        Field(Moves).TableHeader.AbsYTop;	

   IF CurrentApplication = Application$FMS THEN
      Field(Restore_txt).AbsXleft =
           Field(Moves).TableHeader.ChildFields[10].AbsXleft - i;
   ELSE
      Field(Restore_txt).AbsXleft =
           Field(Moves).TableHeader.ChildFields[9].AbsXleft - i;
   ENDIF;
   Field(Restore_txt).AbsYBottom =
        Field(Moves).TableHeader.AbsYTop;	
	
   IF CurrentApplication = Application$FMS THEN
      Field(Status_txt).AbsXleft =
           Field(Moves).TableHeader.ChildFields[12].AbsXRight + i;
   ELSE
      Field(Status_txt).AbsXleft =
           Field(Moves).TableHeader.ChildFields[11].AbsXRight + i;
   ENDIF;
   Field(Status_txt).AbsYTop =
        Field(Moves).TableHeader.AbsYTop + i;		
   CurFrame.Flush();
END;

ON CLICK DiffOp =
BEGIN
/*
** Prepare for selection of a different return by operator.
*/ 
   SteamOp = '';
   RetCode = CALLFRAME SelectOperator (JobClass = Moves[1].JobClass);

   IF RetCode = PU_OK THEN
      SteamOp = FO.Description;
      Selected.Name = FO.Name;
      Selected.Description = FO.Description;
   ENDIF;
END;


ON USEREVENT 'NormalReturn' =
BEGIN
/* 
**  Standard Return of Moves on the Card.
**  Convert job array to jobinprogress array 
*/
   JIP.Clear();
   i = 1;
   WHILE i <= J.LastRow() DO
#     include ConvertJobToJobInProgress

      i = i + 1;
   ENDWHILE;
/*
** Remove Jobs from array that are not controlled by the current card
*/
   FOR i = JIP.LastRow() DOWNTO 1 DO
      IF JIP[i].ControlCard <> Card THEN
         JIP.RemoveRow (rownumber = i);
      ENDIF;
   ENDFOR;

   Jobs = JIP.Duplicate();
/*
**  Clear Operator list
*/
   operatorselection.Clear();
/*
**  Find a list of all the operators who have been issued moves
*/
   DynamicWhereClause = 'Object in (';
   i = Jobs.LastRow();
   k = 1;  /* Index for Return Operator List */
   WHILE i > 0 DO
      IF Jobs[i].RSIssued IS NOT NULL AND Jobs[i].RSComplete IS NULL AND
          Jobs[i].RSOperator IS NOT NULL THEN
/*
** Look for generic op
*/
         IF Jobs[i].RSOperator = Operator$SteamDistribMechanic OR
              Jobs[i].RSOperator = Operator$StationOperator OR
              Jobs[i].RSOperator = Operator$StationSupervisor THEN
            SELECT :Jobs[i].StepPairName = New
            FROM   SOA_Log
            WHERE  Job = :Jobs[i].Job AND
                   Item = 'GENERIC OP' AND
                   Old = 'TurnOn Operator';
            x = 1;
            WHILE x <= ReturnOperatorList.LastRow() DO
               IF ReturnOperatorList[x].Object = Jobs[i].RSOperator AND
                  ReturnOperatorList[x].Description = Jobs[i].StepPairName THEN
                  ENDLOOP;
               ELSE
                  x = x + 1;
               ENDIF;
            ENDWHILE;
 
            IF x > ReturnOperatorList.LastRow() THEN
               ReturnOperatorList[k].Object = IFNULL(Jobs[i].RSOperator, 0);
               ReturnOperatorList[k].Name = '';
               ReturnOperatorList[k].Description = Jobs[i].StepPairName;
               k = k + 1;
            ENDIF;
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + varchar(Jobs[i].RSOperator) + ',';
      ENDIF;

      IF Jobs[i].TOIssued IS NOT NULL and Jobs[i].TOComplete IS NULL AND
          Jobs[i].TOOperator IS NOT NULL THEN
/*
** Look for generic op
*/
         IF Jobs[i].TOOperator = Operator$SteamDistribMechanic OR
              Jobs[i].TOOperator = Operator$StationOperator OR
              Jobs[i].TOOperator = Operator$StationSupervisor THEN
            SELECT :Jobs[i].StepPairName = New
            FROM   SOA_Log
            WHERE  Job = :Jobs[i].Job AND
                   Item = 'GENERIC OP' AND
                   Old = 'ShutOff Operator';
            x = 1;
            WHILE x <= ReturnOperatorList.LastRow() DO
               IF ReturnOperatorList[x].Object = Jobs[i].TOOperator AND
                  ReturnOperatorList[x].Description = Jobs[i].StepPairName THEN
                  ENDLOOP;
               ELSE
                  x = x + 1;
               ENDIF;
            ENDWHILE;
 
            IF x > ReturnOperatorList.LastRow() THEN
               ReturnOperatorList[k].Object = IFNULL(Jobs[i].TOOperator,0);
               ReturnOperatorList[k].Name = '';
               ReturnOperatorList[k].Description = Jobs[i].StepPairName;
               k = k + 1;
            ENDIF;
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + varchar(Jobs[i].TOOperator) + ',';
      ENDIF;
      i = i - 1;
   ENDWHILE;
    
   IF DynamicWhereClause =  'Object in (' THEN
      Message 'There are no outstanding Jobs to complete.';
      PhaseTerminal = 0;
      RETURN PU_CANCEL;
   ENDIF;   
    
   /** strip off last comma **/
   DynamicWhereClause = left(DynamicWhereClause, length(DynamicWhereClause) - 1);
   DynamicWhereClause = DynamicWhereClause + ')';
    
   SELECT  DISTINCT :ReturnOperatorList[k].Object = Object,
                    :ReturnOperatorList[k].Name = Name,
                    :ReturnOperatorList[k].Description = Description
   FROM   UDB_Object 
   WHERE :DynamicWhereClause
   ORDER BY Name
   BEGIN
      k = k + 1;
   END;

   IF ReturnOperatorList.LastRow() = 0 Then
      Message 'There are no outstanding Jobs to complete.';
      PhaseTerminal = 0;
      RETURN PU_CANCEL;
   ENDIF;
    
   operatorselection = ReturnOperatorList;
   Selected.Description = '';
   Selected.Name = '';
/*
**  If only 1 operator with outstanding job moves, just use it 
*/
   IF operatorselection.LastRow() = 1 THEN
      Selected.Object  = operatorselection[1].Object; 
      Selected.Name = operatorselection[1].Name;
      Selected.Description = operatorselection[1].Description;

      FO.Object = operatorselection[1].Object;
      FO.Name = operatorselection[1].Name;
      FO.Description = operatorselection[1].Description;
      
     IF operatorselection[1].Object = Operator$OpOrder AND ManualOrderToggle = TRUE THEN
        /* See how many orders are out there */
        OrderNum = CALLFRAME SelectOrder (Card = Card);
        IF OrderNum = 0 THEN
           MESSAGE 'The new temporary Manual Order logic is not working for this card.  Will need to be adjusted.  Report problem by phone.';
        ELSE
           OpOrder = OrderNum;
           Curframe.SendUserEvent(EventName = 'LoadOpOrderJobs');
        ENDIF;
     ELSE
      FIELD(Selected).CurBias = FB_VISIBLE;
      FIELD(operatorselection).CurBias = FB_VISIBLE;
      FIELD(Find_Btn).CurBias = FB_DIMMED;
      Curframe.SendUserEvent(EventName = 'LoadJobs');
     ENDIF;
     
   ENDIF;

   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;
   LastBtnHit = '';
END;


ON USEREVENT 'ReturnOpOrder' =
BEGIN
/* 
**  Returning Moves related to an Operating Order. 
*/
   operatorselection.Clear();
   i = 1;
   SELECT  DISTINCT :ReturnOperatorList[i].Object = Object,
                    :ReturnOperatorList[i].Name = Name,
                    :ReturnOperatorList[i].Description = Description
   FROM   UDB_Object 
   WHERE  Object = :Operator$OpOrder;

   IF ReturnOperatorList.LastRow() = 0 Then
      Message 'Major Error: Operating Order Operator ' +
              'does not properly exist in the database.';
      PhaseTerminal = 0;
      RETURN PU_CANCEL;
   ENDIF;

   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;
   LastBtnHit = '';
    
   operatorselection = ReturnOperatorList;
   Selected.Object  = operatorselection[1].Object; 
   Selected.Name = operatorselection[1].Name;
   Selected.Description = operatorselection[1].Description;
   FIELD(Selected).CurBias = FB_VISIBLE;
   FIELD(operatorselection).CurBias = FB_VISIBLE;
   FIELD(Find_Btn).CurBias = FB_DIMMED;
/*
** get order status
*/
   Opstack.OrderNumber = OpOrder;

   IF CurrentApplication = Application$DSO THEN
      SELECT :OrderStatus = OrderStatus,
          :Opstack.BySSO = AckRejectBySSO,
          :Crew = ReturnBySSO,
          :DSOReturnComment = ReturnComment
      FROM   IR_DSOOrder
      WHERE  OrderNumber = :OpOrder;
   ELSE
      SELECT :OrderStatus = OrderStatus,
          :Opstack.BySSO = AckRejectBySSO,
          :Crew = ReturnBySSO
      FROM   IR_OperatingOrder
      WHERE  OrderNumber = :OpOrder;
   ENDIF;
   
   IF OrderStatus = Order$Closed THEN
      FIELD(OpStack.StatusText).TextValue = 'was returned by SSO:';
      Opstack.BySSO = Crew;

   ELSEIF OrderStatus = Order$Rejected THEN
      FIELD(OpStack.StatusText).TextValue = 'was rejected by SSO:';

   ELSEIF OrderStatus = Order$Rescinded THEN
      Opstack.BySSO = '';
      FIELD(OpStack.StatusText).TextValue = 'was returned rescinded.';
   ENDIF;
   
   IF DSOReturnComment <> '' THEN
      DOstack.DSOComment = DSOReturnComment;
      FIELD(DOstack.DSOComment).CurBias = FB_LANDABLE;
   ENDIF;

   FIELD(OpStack).CurBias = FB_VISIBLE;

   IF OrderStatus <> Order$Rescinded THEN
      FIELD(dostack).AbsXLeft = FIELD(operatorselection).AbsXLeft;
      FIELD(dostack).AbsYTop = FIELD(operatorselection).AbsYTop + 200;
       
      dostack.districtoperator = DOP.Description;

      FIELD(dostack).Curbias = FB_CHANGEABLE;
      FIELD(dostack.districtoperator).Curbias = FB_LANDABLE;
      FIELD(ok_btn).Curbias = FB_DIMMED;     
   ENDIF;
   CurFrame.Flush();
   CurFrame.WindowHeight = STACKFIELD(FIELD(OpStack).ParentField).Height+100;

   CurFrame.SendUserEvent(EventName = 'PositionFreeText');
   CurFrame.SendUserEvent(EventName = 'LoadOpOrderJobs');
END;

ON CHILDENTRY Moves[*].TOMove =
BEGIN
   FullMoveText.Move = Moves[].TOMove;
   FIELD(FullMoveText).XLeft = FIELD(Moves[*].TOMove).XLeft;   
   FIELD(FullMoveText).YTop = FIELD(Moves[*].TOMove).YBottom;   
   FIELD(FullMoveText).CurBias = FB_LANDABLE;
   CurFrame.Flush();
END;

ON CLICK FullMoveText.OKBtn =
BEGIN
   FIELD(FullMoveText).CurBias = FB_INVISIBLE;
   CurFrame.InputFocusField = FIELD(ok_btn);
END;


ON USEREVENT 'ReturnFODOrder' =
BEGIN
/*
** Returning Moves related to an FOD Operating Order.
*/ 
   OperatorSelection.Clear();
   SELECT  :ReturnOperatorList[1].Object = O.Object,
           :ReturnOperatorList[1].Name = O.Name,
           :ReturnOperatorList[1].Description = O.Description
   FROM    UDB_Object O,
           IR_FODOrder FO
   WHERE   FO.OrderNumber = :OpOrder AND
           FO.FODEmployeeObject = O.Object;
   
   IF ReturnOperatorList.LastRow() = 0 THEN
      Message 'Major Error: FOD Operator ' +
              'does not properly exist in the database.';
      RETURN(PU_CANCEL);
   ENDIF;
   
   OperatorSelection = ReturnOperatorList;
   Selected.Object = OperatorSelection[1].Object;
   Selected.Name = OperatorSelection[1].Name;
   Selected.Description = OperatorSelection[1].Description;
   FIELD(Selected).CurBias = FB_VISIBLE;
   FIELD(OperatorSelection).CurBias = FB_VISIBLE;
   FIELD(Find_Btn).CurBias = FB_DIMMED;
/* 
** get order status
*/ 
   SELECT :OrderStatus = OrderStatus,
          :OrderSequence = SequenceType,
          :OrderTarget = OrderTarget
   FROM   IR_FODOrder
   WHERE  OrderNumber = :OpOrder;
   
   m = 0;
   x = 0;
   k = 0;
   i = 0;
   tq = 0;

   SELECT :JobStatus = J.JobStatus,
          :Status = J.Pending
   FROM   IR_FODOrderJobs J
   WHERE  J.OrderNumber = :OpOrder
   BEGIN
      IF Status = 1 THEN                            /* pending */
         IF JobStatus = Order$Rejected THEN
            x = x + 1;
         ELSEIF JobStatus = Order$Rescinded THEN
            k = k + 1;            
         ELSEIF JobStatus = Order$Closed THEN
            m = m + 1;
         ENDIF;
      ELSEIF JobStatus = Order$Acknowledged AND TooQuick = TRUE THEN
         tq = tq + 1;
      ELSEIF JobStatus < Order$Closed AND JobStatus <> Order$Rejected THEN
         i = i + 1;
      ENDIF;
   END;
   
   TempString = 'Order ' + VARCHAR(OpOrder) +' has currently ';

   IF x > 0 THEN
      TempString = TempString  + varchar(x) + ' move(s) being REJECTED, ';
   ENDIF;

   IF k > 0 THEN
      TempString = TempString +  varchar(k) + ' move(s) being RESCINDED, ';
   ENDIF;

   IF m > 0 THEN
      TempString = TempString +  varchar(m) + ' move(s) being RETURNED,';
   ENDIF;

   FIELD(FODOpStack.DisplayTxt).TextValue = TempString + ' ' + varchar(i) + ' move(s) outstanding.';

   IF tq > 0 THEN
      IF tq = 1 THEN
         TempString = 'An FOD/#9 move was ';
      ELSE
         TempString = 'Up to ' + varchar(tq) + ' FOD/#9 moves were ';
      ENDIF;
      TempString = TempString + 'returned TOO QUICKLY and must be processed verbally.';
      FIELD(FODOpStack.DisplayTxt).TextValue = TempString;
   ENDIF;
   /*
   **  Update order status back to Downloaded if order
   **  status is Pending Move completion/rescission.
   */
   IF OrderStatus = Order$PendingMoves THEN
         RetCode = CALLPROC IR_FODOrderStatusUpd (
                        OrderNumber = OpOrder,
                        OrderStatus = Order$Downloaded);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            IF m <> 0 THEN
               /* no need to display message if all job have been returned. */
               message 'Unable to update order status back to ' + 
                  varchar(Order$Downloaded) + 
                  'Please contact technical support to update status for Order ' + 
                  varchar(oporder) + '. You will not receive any more incoming ' +
                  'messages for returned moves on this order until problem is resolved.';
            ENDIF;
         ENDIF;
   ENDIF;

   IF m = 0 AND k = 0 AND x = 0 AND tq = 0 THEN
      Message 'All moves have been processed.';
      RETURN(PU_CANCEL); 
   ENDIF;
   
   IF x > 0 OR m > 0 THEN
      FIELD(dostack).AbsXLeft = FIELD(operatorselection).AbsXLeft;
      FIELD(dostack).AbsYTop = FIELD(operatorselection).AbsYTop + 200;

      FIELD(dostack.Displaytxt).TextValue = 
                     'You are acknowledging an FOD Order.' + HC_NEWLINE +
                     'Your name will be sent back to the ' + HC_NEWLINE +
                      OrderTarget + '.';        
      dostack.districtoperator = DOp.Description;

      FIELD(dostack).Curbias = FB_CHANGEABLE;
      FIELD(dostack.districtoperator).Curbias = FB_LANDABLE;
      FIELD(ok_btn).Curbias = FB_DIMMED;   
   ENDIF;
   FIELD(FODOpStack).CurBias = FB_VISIBLE;
   CurFrame.Flush();
   CurFrame.WindowHeight = STACKFIELD(FIELD(OpStack).ParentField).Height+100;

   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;

   CurFrame.SendUserEvent(EventName = 'PositionFreeText');
   CurFrame.SendUserEvent(EventName = 'LoadFODJobs');
END;


ON USEREVENT 'ReturnFault' =
BEGIN
/*
** Review Fault Move.
*/ 
   OperatorSelection.Clear();
   ReturnOperatorList.Clear();
   SELECT  :ReturnOperatorList[1].Object = O.Object,
           :ReturnOperatorList[1].Name = O.Name,
           :ReturnOperatorList[1].Description = O.Description
   FROM    UDB_Object O,
           SOA_Job J
   WHERE   J.Job = :FaultJob AND
           J.TOOperator = O.Object;
   
   IF ReturnOperatorList.LastRow() = 0 THEN
      Message 'Major Error: FOD Operator ' +
              'does not properly exist in the database.';
      RETURN(PU_CANCEL);
   ENDIF;
   
   OperatorSelection = ReturnOperatorList;
   Selected.Object = OperatorSelection[1].Object;
   Selected.Name = OperatorSelection[1].Name;
   Selected.Description = OperatorSelection[1].Description;
   FIELD(Selected).CurBias = FB_VISIBLE;
   FIELD(OperatorSelection).CurBias = FB_VISIBLE;
   FIELD(Find_Btn).CurBias = FB_DIMMED;

   CurFrame.SendUserEvent(EventName = 'LoadFaultJob');
END;


ON USEREVENT 'LoadJobs' = 
BEGIN
   Moves.Clear();
   OrderList.Clear();
/*
**  Look through job list for valid jobs which have been assigned
**  to this operator and not completed.  Build operator move array.
*/
   i = 1;
   WHILE i <= Jobs.LastRow() DO

      IF (Jobs[i].Status = '' OR
          Jobs[i].Status = JobStatus$NIS OR
          Jobs[i].Status = Job$TakeOut OR
          Jobs[i].Status = Job$Restore) AND
        (((Jobs[i].TOOperator = Selected.Object AND NOT (
            Jobs[i].TOOperator = Operator$SteamDistribMechanic OR
            Jobs[i].TOOperator = Operator$StationOperator OR
            Jobs[i].TOOperator = Operator$StationSupervisor)
           OR (
           (Jobs[i].TOOperator = Operator$SteamDistribMechanic OR
            Jobs[i].TOOperator = Operator$StationOperator OR
            Jobs[i].TOOperator = Operator$StationSupervisor) AND
           Selected.Description = Jobs[i].StepPairName) ) AND        
          Jobs[i].TOIssued IS NOT NULL AND
          Jobs[i].TOComplete IS NULL) OR 
         ((Jobs[i].RSOperator = Selected.Object AND NOT (
            Jobs[i].RSOperator = Operator$SteamDistribMechanic OR
            Jobs[i].RSOperator = Operator$StationOperator OR
            Jobs[i].RSOperator = Operator$StationSupervisor)
           OR (
           (Jobs[i].RSOperator = Operator$SteamDistribMechanic OR
            Jobs[i].RSOperator = Operator$StationOperator OR
            Jobs[i].RSOperator = Operator$StationSupervisor) AND
           Selected.Description = Jobs[i].StepPairName) ) AND        
          Jobs[i].RSIssued IS NOT NULL AND
          Jobs[i].RSComplete IS NULL))  THEN

         IF Jobs[i].TOIssued IS NOT NULL AND
                    Jobs[i].TOComplete IS NULL THEN
             OrderDate.Value = IFNULL(Jobs[i].TOIssued, '');
         ELSE
             OrderDate.Value = IFNULL(Jobs[i].RSIssued, '');
         ENDIF;
         k = 1;
         WHILE k <= OrderList.LastRow() DO
            IF OrderDate.Value <= OrderList[k].Value THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         OrderList.InsertRow(RowNumber = k, 
                             RowObject = OrderDate.Duplicate());
         Moves.InsertRow    (RowNumber = k, RowObject = Jobs[i].Duplicate());
        
         Moves[k].Confirm = 0;
         
         IF Jobs[i].ControlCard <> Jobs[i].Card THEN
            FIELD(Moves[k].EquipClassName).FGColor = CC_LIGHT_GRAY;
            FIELD(Moves[k].EquipName).FGColor = CC_LIGHT_GRAY;
         ENDIF;
/*
**  Mark the move as a takeout(T) or restore(R).  Check is done this way
**  to prevent completing takeout side if this operator was issued the 
**  restor move.
*/
         IF Jobs[i].TOOperator = Selected.Object AND        
            Jobs[i].TOIssued IS NOT NULL         AND
            Jobs[i].TOComplete IS NULL           THEN

            Moves[k].Status = Job$Takeout;
            FIELD(Moves[k].TOIssued).BGColor = CC_LIGHT_BLUE;

            IF Jobs[i].TOOperator = Operator$FOD OR
               Jobs[i].TOOperator = Operator$NO9 THEN
               FIELD(Moves[k].Complete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
               FIELD(Moves[k].Complete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
            ENDIF;

         ELSEIF Jobs[i].RSOperator = Selected.Object AND
            Jobs[i].RSIssued IS NOT NULL             AND
            Jobs[i].RSComplete IS NULL               THEN

            Moves[k].Status = Job$Restore;
            FIELD(Moves[k].RSIssued).BGColor = CC_LIGHT_BLUE;
            Moves[k].ToMove = Moves[k].RSMove;

            IF Jobs[i].RSOperator = Operator$FOD OR
               Jobs[i].RSOperator = Operator$NO9 THEN
               FIELD(Moves[k].Complete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
               FIELD(Moves[k].Complete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
            ENDIF;
         ENDIF;

         IF Moves[k].TOIssued = '' THEN
            FIELD(Moves[k].TOIssued).BgColor = CC_LIGHT_GRAY;
         ENDIF;

         IF Moves[k].TOComplete = '' THEN
            FIELD(Moves[k].TOComplete).BgColor = CC_LIGHT_GRAY;
         ENDIF;
          
         IF Moves[k].RSIssued = '' THEN
            FIELD(Moves[k].RSIssued).BgColor = CC_LIGHT_GRAY;
         ENDIF;

         IF Moves[k].RSComplete = '' THEN
            FIELD(Moves[k].RSComplete).BgColor = CC_LIGHT_GRAY;
         ENDIF;
/*
** If the move was issued on BOTH sides and not completed BOTH 
** on the takeout and on the restore side, we want to make sure 
** that the move is listed twice.  Since the above code will take 
** care of the takeout side, we will take care of the restore side 
** duplication.
*/
         IF Jobs[i].TOIssued IS NOT NULL            AND
            Jobs[i].TOIssued <> ''                  AND
            Jobs[i].TOComplete IS NULL              AND
            Jobs[i].RSIssued IS NOT NULL            AND
            Jobs[i].RSIssued <> ''                  AND
            Jobs[i].RSComplete IS NULL              AND
            Jobs[i].TOOperator = Selected.Object    AND
            Jobs[i].TOOperator = Jobs[i].RSOperator THEN

            OrderDate.Value = IFNULL(Jobs[i].RSIssued, '');
            k = 1;
            WHILE k <= OrderList.LastRow() DO
               IF OrderDate.Value <= OrderList[k].Value THEN
                  ENDLOOP;
               ENDIF;
               k = k + 1;
            ENDWHILE;
            OrderList.InsertRow(RowNumber = k, 
                                RowObject = OrderDate.Duplicate());
            Moves.InsertRow    (RowNumber = k, RowObject = Jobs[i].Duplicate());        
            Moves[k].Confirm = 0;

            Moves[k].Status = Job$Restore;
/*
**  Since this will the restore move, show the restore text
*/
            Moves[k].TOMove = Moves[k].RSMove;         
            FIELD(Moves[k].RSIssued).BGColor = CC_LIGHT_BLUE;
         ENDIF;                     
      ENDIF;
      i = i + 1;
   ENDWHILE; 

   IF OrderList.LastRow() = 0 THEN
      IF (Curframe.ConfirmPopup(messagetext = 'You have already returned all moves for ' +
               'this operator.  You may continue returning moves for other operators or ' +
               'exit the frame.  Continue returning moves?') = PU_OK) THEN
         RESUME;
      ELSE
         PhaseTerminal = 0;
         RETURN PU_OK;
      ENDIF;
   ENDIF;
/*
**  There are moves for the operator, lets see if any have incomplete
**  phase checks.  We only care about RS moves.
**  Moves must also be in the deload/restore step pair for non-4kv Card
**  or in the Isolation Moves step pair for 4kV Card.
*/
   IF CurrentApplication = Application$FMS THEN
      i = 1;
      SELECT :OutstandingPhaseCheck[i].SPC_Equip = P.SatisfyEquip
      FROM   FMS_PhaseCheck P
      WHERE  P.Card = :CardDetails.Card AND
             P.CompletionTime IS NULL
      UNION
      SELECT P.SatisfyEquip
      FROM   FMS_PhaseCheck P,
             FMS_PortionLink L
      WHERE ((L.Card = :CardDetails.Card AND
              L.PortionCard = P.Card) OR
             (L.PortionCard = :CardDetails.Card AND
              L.Card = P.Card)) AND
              P.CompletionTime IS NULL
      BEGIN
         i = i + 1;
      END;

      k = 1;
      WHILE k <= Moves.LastRow() DO
         IF Moves[k].RSIssued IS NOT NULL AND Moves[k].RSComplete IS NULL AND
            (Moves[k].StepPair = StepHeading$Deload OR 
             Moves[k].StepPair = StepHeading$Iso) THEN
             i = 1;
             WHILE i <= OutstandingPhaseCheck.LastRow() DO
                IF OutstandingPhaseCheck[i].SPC_Equip =
                   Moves[k].Equip THEN
                   IF CardDetails.Cutout IS NULL OR 
                      CardDetails.CutIn IS NOT NULL THEN
                       FIELD(Moves[k].MoveFlag).BgColor = CC_RED;
                   ELSE
/*
**  Load phase check moves so that move origin column gets cleared.
*/
                      FCFrame.SendUserEvent (EventName = 'LoadPhaseCheckMoves');                       
                   ENDIF;
                ENDIF; 
                i = i + 1;
             ENDWHILE;
         ENDIF;
         k = k + 1;
      ENDWHILE;
   ENDIF;
/* 
** Set move FgColor to red if grounded.
*/
   FOR i = 1 TO Moves.LastRow() DO
      IF Moves[i].Grounds IS NOT NULL AND Moves[i].Grounds > 0 AND
             Moves[i].GroundOn IS NOT NULL THEN
         FIELD(Moves[i].TOMove).FgColor = CC_RED;
      ELSE
         FIELD(Moves[i].TOMove).FgColor = CC_BLACK;
      ENDIF;
   ENDFOR;     

   IF CurrentApplication = Application$SDS THEN
      FIELD(diffop).CurBias = FB_LANDABLE;
      FIELD(TakeOut_Txt).TextValue = '   ShutOff   ';
      FIELD(Restore_Txt).TextValue = ' TurnOn   ';    
      CurFrame.SendUserEvent(EventName = 'PositionFreeText');
   ELSE
      FIELD(diffop).CurBias = FB_INVISIBLE;
   ENDIF;   
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();  
END;


ON USEREVENT 'LoadOpOrderJobs' =
BEGIN
/*
**  Setup the List of moves that are part of the operating order
**  If the move has been completed, We will change the button to
**  Confirm, otherwise, we leave Incomplete.
*/
  IF CurrentApplication = Application$DSO THEN
  
   i = 1;
   Moves.Clear();
   FODJobList.Clear();
   SELECT  
         :Moves[i].Job = J.Job,
         :Moves[i].JobClass = J.JobClass,
         :Moves[i].Card = J.ControlCard,
         :Moves[i].SwitchingItem = JC.SwitchingItem,
         :Moves[i].ControlCard = J.ControlCard,
         :Moves[i].DeskName = J.DeskName,
         :Moves[i].Equip = J.Equip,
         :Moves[i].EquipClass = J.EquipClass,
         :Moves[i].EquipClassName = J.EquipClassName,
         :Moves[i].EquipName = J.EquipName,
         :Moves[i].StepPair = JC.StepPair,
         :Moves[i].MoveEquipClass = JC.MoveEquipClass,
         :Moves[i].PrintID = JC.PrintID,
         :Moves[i].TOMove = J.TOMove,
         :Moves[i].TOOperator = J.TOOperator,
         :Moves[i].RSMove = J.RSMove,
         :Moves[i].RSOperator = J.RSOperator,
         :Moves[i].Seq = JTS.Seq,
         :Moves[i].Status = :Job$TakeOut,
         :Moves[i].TOIssued = J.TOIssued,
         :Moves[i].TOComplete = J.TOComplete,
         :Moves[i].RSIssued = J.RSIssued,
         :Moves[i].RSComplete = J.RSComplete,
         :Moves[i].Substation = J.Substation,
         :Moves[i].MoveType = J.MoveType,
         :Moves[i].Grounds = J.Grounds,
         :Moves[i].GroundOn = J.GroundOn,
         :Moves[i].TOMoveRules = J.TOMoveRules,
         :Moves[i].RSMoveRules = J.RSMoveRules,
         :Moves[i].SubstationName = O.Name,
         :Moves[i].Response = J.Response,
         :Moves[i].OrderNumber = OO.OrderNumber,
         :Moves[i].TORS = JTS.TORS,
         :FODJobList[i].ReturnRemark = '',
         :FODJobList[i].AckRejectedComment = OO.AckRejectComment,              
         :FODJobList[i].JobStatus = OO.OrderStatus 
   FROM    SOA_Job J,
            SOA_JobControl JC,
            IR_DSOOrder OO,
            IR_DSOOrderJob JTS,
            Udb_Object O
   WHERE   OO.OrderNumber = :OpOrder AND
            JTS.OrderNumber = :OpOrder AND
            JTS.TORS = :Job$TakeOutInt AND
            JTS.Job = J.Job AND
            J.Job = JC.Job AND
            JC.Card = :Card AND
            J.Substation = O.Object
   UNION 
   SELECT  
         J.Job,
         J.JobClass,
         J.ControlCard,
         JC.SwitchingItem,
         J.ControlCard,
         J.DeskName,
         J.Equip,
         J.EquipClass,
         J.EquipClassName,
         J.EquipName,
         JC.StepPair,
         JC.MoveEquipClass,
         JC.PrintID,
         J.RSMove,
         J.TOOperator,
         J.RSMove,
         J.RSOperator,
         JTS.Seq,
         :Job$Restore,
         J.TOIssued,
         J.TOComplete,
         J.RSIssued,
         J.RSComplete,
         J.Substation,
         J.MoveType,
         J.Grounds,
         J.GroundOn,
         J.TOMoveRules,
         J.RSMoveRules,
         O.Name,
         J.Response,
         OO.OrderNumber,
         JTS.TORS,
         '',
         OO.AckRejectComment,
         OO.OrderStatus             
   FROM    SOA_Job J,
            SOA_JobControl JC,
            IR_DSOOrder OO,
            IR_DSOOrderJob JTS,
            Udb_Object O
   WHERE   OO.OrderNumber = :OpOrder AND
            JTS.OrderNumber = :OpOrder AND
            JTS.TORS = :Job$RestoreInt AND
            JTS.Job = J.Job AND
            J.Job = JC.Job AND
            JC.Card = :Card AND
            J.Substation = O.Object
   ORDER BY Seq
   BEGIN
       i = i + 1;
   END;  
   
  ELSE

   i = 1;
   Moves.Clear();
   FODJobList.Clear();
   SELECT  
         :Moves[i].Job = J.Job,
         :Moves[i].JobClass = J.JobClass,
         :Moves[i].Card = J.ControlCard,
         :Moves[i].SwitchingItem = JC.SwitchingItem,
         :Moves[i].ControlCard = J.ControlCard,
         :Moves[i].DeskName = J.DeskName,
         :Moves[i].Equip = J.Equip,
         :Moves[i].EquipClass = J.EquipClass,
         :Moves[i].EquipClassName = J.EquipClassName,
         :Moves[i].EquipName = J.EquipName,
         :Moves[i].StepPair = JC.StepPair,
         :Moves[i].MoveEquipClass = JC.MoveEquipClass,
         :Moves[i].PrintID = JC.PrintID,
         :Moves[i].TOMove = J.TOMove,
         :Moves[i].TOOperator = J.TOOperator,
         :Moves[i].RSMove = J.RSMove,
         :Moves[i].RSOperator = J.RSOperator,
         :Moves[i].Seq = JTS.Seq,
         :Moves[i].Status = :Job$TakeOut,
         :Moves[i].TOIssued = J.TOIssued,
         :Moves[i].TOComplete = J.TOComplete,
         :Moves[i].RSIssued = J.RSIssued,
         :Moves[i].RSComplete = J.RSComplete,
         :Moves[i].Substation = J.Substation,
         :Moves[i].MoveType = J.MoveType,
         :Moves[i].Grounds = J.Grounds,
         :Moves[i].GroundOn = J.GroundOn,
         :Moves[i].TOMoveRules = J.TOMoveRules,
         :Moves[i].RSMoveRules = J.RSMoveRules,
         :Moves[i].SubstationName = O.Name,
         :Moves[i].Response = J.Response,
         :Moves[i].OrderNumber = OO.OrderNumber,
         :Moves[i].TORS = JTS.TORS,
         :FODJobList[i].ReturnRemark = OO.ReturnComment + :HC_NEWLINE +  JTS.ReturnRemark,
         :FODJobList[i].AckRejectedComment = OO.AckRejectComment,              
         :FODJobList[i].JobStatus = OO.OrderStatus
   FROM    SOA_Job J,
            SOA_JobControl JC,
            IR_OperatingOrder OO,
            IR_OPOrderJobs JTS,
            Udb_Object O
   WHERE   OO.OrderNumber = :OpOrder AND
            JTS.OrderNumber = :OpOrder AND
            JTS.TORS = :Job$TakeOutInt AND
            JTS.Job = J.Job AND
            J.Job = JC.Job AND
            JC.Card = :Card AND
            J.Substation = O.Object
   UNION 
   SELECT  
         J.Job,
         J.JobClass,
         J.ControlCard,
         JC.SwitchingItem,
         J.ControlCard,
         J.DeskName,
         J.Equip,
         J.EquipClass,
         J.EquipClassName,
         J.EquipName,
         JC.StepPair,
         JC.MoveEquipClass,
         JC.PrintID,
         J.RSMove,
         J.TOOperator,
         J.RSMove,
         J.RSOperator,
         JTS.Seq,
         :Job$Restore,
         J.TOIssued,
         J.TOComplete,
         J.RSIssued,
         J.RSComplete,
         J.Substation,
         J.MoveType,
         J.Grounds,
         J.GroundOn,
         J.TOMoveRules,
         J.RSMoveRules,
         O.Name,
         J.Response,
         OO.OrderNumber,
         JTS.TORS,
         OO.ReturnComment + :HC_NEWLINE +  JTS.ReturnRemark,
         OO.AckRejectComment,
         OO.OrderStatus              
   FROM    SOA_Job J,
            SOA_JobControl JC,
            IR_OperatingOrder OO,
            IR_OpOrderJobs JTS,
            Udb_Object O
   WHERE   OO.OrderNumber = :OpOrder AND
            JTS.OrderNumber = :OpOrder AND
            JTS.TORS = :Job$RestoreInt AND
            JTS.Job = J.Job AND
            J.Job = JC.Job AND
            JC.Card = :Card AND
            J.Substation = O.Object
   ORDER BY Seq
   BEGIN
       i = i + 1;
   END;
  ENDIF;

   FOR i = 1 TO Moves.LastRow() DO
/*
** There would be a problem here if somehow the operator kills the application
** after having confirmed completion or incompletion - we would have no good
** way to determine which moves were confirmed complete, and thus would
** probably end up executing the job actions twice.  Confirming incomplete
** is easier since we just have to look at the Issued time to determine
** whether incompletion has already been done.
** Either way - THEY SHOULD NOT BE KILLING SOA WHILE RETURNING ORDERS.
*/
       IF (Moves[i].Status = Job$TakeOut AND Moves[i].TOComplete = '') OR
            (Moves[i].Status = Job$Restore AND Moves[i].RSComplete = '') THEN
/*
** This means most likely that the parent job has been expanded.
*/
          FIELD(Moves[i].Complete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Complete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Incomplete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Incomplete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;

       ELSEIF (Moves[i].Status = Job$TakeOut AND Moves[i].TOComplete IS NULL)  OR
            (Moves[i].Status = Job$Restore AND Moves[i].RSComplete IS NULL) THEN
            
          /* Let's skip this in a Manual Order situation */
         IF ManualOrderToggle = FALSE THEN

          FIELD(Moves[i].Complete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Complete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;

          /* Our test case handling if an Incomplete was killed */
          IF (Moves[i].Status = Job$TakeOut AND Moves[i].TOIssued IS NULL) OR
              (Moves[i].Status = Job$Restore AND Moves[i].RSIssued IS NULL) THEN
             FIELD(Moves[i].Incomplete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
             FIELD(Moves[i].Incomplete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          ENDIF;
         ENDIF;

       ELSE /* On completion in a KILL situation, we have to let it repeat */

          FIELD(Moves[i].Incomplete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Incomplete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
       ENDIF;

       IF Moves[i].TOIssued = '' THEN
          FIELD(Moves[i].TOIssued).BgColor = CC_LIGHT_GRAY;
       ENDIF;

       IF Moves[i].TOComplete = '' THEN
          FIELD(Moves[i].TOComplete).BgColor = CC_LIGHT_GRAY;
       ENDIF;
          
       IF Moves[i].RSIssued = '' THEN
          FIELD(Moves[i].RSIssued).BgColor = CC_LIGHT_GRAY;
       ENDIF;

       IF Moves[i].RSComplete = '' THEN
          FIELD(Moves[i].RSComplete).BgColor = CC_LIGHT_GRAY;
       ENDIF;
/* 
** Set move FgColor to red if grounded.
*/
       IF Moves[i].Grounds IS NOT NULL AND Moves[i].Grounds > 0 AND
           Moves[i].GroundOn IS NOT NULL THEN
          FIELD(Moves[i].TOMove).FgColor = CC_RED;
       ELSE
          FIELD(Moves[i].TOMove).FgColor = CC_BLACK;
       ENDIF;
   ENDFOR;
   
   IF OrderStatus = Order$Closed AND
      CurrentApplication = Application$FMS THEN
      /*
      ** if DO is processing the return of an operating order, keep track
      ** the progress of the return process and whether the DO tries to create
      ** or has created an FOT card.
      */
      OrderReturnStatus = OrderReturnStatusClass.Create();
      OrderReturnStatus.Card = Card;
      OrderReturnStatus.OrderNumber = OpOrder;
      OrderReturnStatus.JobList = Moves;
      OrderReturnStatus.DelayFOT = FALSE;
   ENDIF;
END;


ON USEREVENT 'LoadFODJobs' =
BEGIN
/*
** Setup the list of moves that are part of the FOD operating order
** If the move has been completed, we will change the button to
** Confirm, otherwise, we leave Incomplete.
*/
   IF TooQuick = TRUE THEN 
      TOWhereClause = 'JTS.OrderNumber = ' + VARCHAR(:OpOrder) + ' AND ' +
                      'JTS.TORS = ' + VARCHAR(:Job$TakeoutInt) + ' AND ' +
                      'JTS.Job = J.Job AND J.Job = JC.Job AND JC.Card = ' +
                      VARCHAR(:Card) + ' AND JTS.Pending = 0 AND ' +
                      'JTS.JobStatus = ' + VARCHAR(Order$Acknowledged);

      RSWhereClause = 'JTS.OrderNumber = ' + VARCHAR(:OpOrder) + ' AND ' +
                      'JTS.TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +
                      'JTS.Job = J.Job AND J.Job = JC.Job AND JC.Card = ' +
                      VARCHAR(:Card) + ' AND JTS.Pending = 0 AND ' +
                      'JTS.JobStatus = ' + VARCHAR(Order$Acknowledged);
   ELSE
      TOWhereClause = 'JTS.OrderNumber = ' + VARCHAR(:OpOrder) + ' AND ' +
                      'JTS.TORS = ' + VARCHAR(:Job$TakeoutInt) + ' AND ' +
                      'JTS.Job = J.Job AND J.Job = JC.Job AND JC.Card = ' +
                      VARCHAR(:Card) + ' AND JTS.Pending = 1';

      RSWhereClause = 'JTS.OrderNumber = ' + VARCHAR(:OpOrder) + ' AND ' +
                      'JTS.TORS = ' + VARCHAR(:Job$RestoreInt) + ' AND ' +
                      'JTS.Job = J.Job AND J.Job = JC.Job AND JC.Card = ' +
                      VARCHAR(:Card) + ' AND JTS.Pending = 1';
   ENDIF;
   
   i = 1;
   Moves.Clear();
   FODJobList.Clear();
   SELECT
         :Moves[i].Job = J.Job,
         :Moves[i].Status = :Job$TakeOut,
         :Moves[i].JobClass = J.JobClass,
         :Moves[i].Card = JC.Card,
         :Moves[i].SwitchingItem = JC.SwitchingItem,    
         :Moves[i].Seq = JTS.Seq,
         :Moves[i].Equip = J.Equip,
         :Moves[i].EquipClass = J.EquipClass,
         :Moves[i].MoveEquipClass = JC.MoveEquipClass,
         :Moves[i].EquipClassName = J.EquipClassName,
         :Moves[i].PrintID = JC.PrintID,
         :Moves[i].EquipName = J.EquipName,
         :Moves[i].StepPair = JC.StepPair,
         :Moves[i].Grounds = J.Grounds,
         :Moves[i].MoveType = J.MoveType,
         :Moves[i].TOMove = J.TOMove,
         :Moves[i].TOOperator = J.TOOperator,
         :Moves[i].TOIssued = J.TOIssued,
         :Moves[i].TOComplete = J.TOComplete,
         :Moves[i].GroundOn = J.GroundOn,
         :Moves[i].RSMove = J.RSMove,     
         :Moves[i].RSOperator = J.RSOperator,
         :Moves[i].RSIssued = J.RSIssued,
         :Moves[i].RSComplete = J.RSComplete,
         :Moves[i].TOMoveRules = J.TOMoveRules,
         :Moves[i].RSMoveRules = J.RSMoveRules,
         :Moves[i].Response = J.Response,
         :Moves[i].ControlCard = J.ControlCard,
         :Moves[i].DeskName = J.DeskName,
         :Moves[i].PhaseCheckColor = JTS.PhaseCheckComplete,
         :Moves[i].Substation = J.Substation,
         :FODJobList[i].ReturnRemark = JTS.ReturnRemark,
         :FODJobList[i].AckRejectedComment = JTS.AckRejectedComment,
         :FODJobList[i].JobStatus = JTS.JobStatus,
         :FODJobList[i].EmployeeObject = JTS.FODEmployeeObject,
         :FODJobList[i].VerbalEmployeeObject = JTS.VerbalEmployeeObject,
         :FODJobList[i].ContactInfo = JTS.ContactInfo,
         :FODJobList[i].SendBackType = JTS.SendBackType
   FROM   SOA_Job J,
          SOA_JobControl JC,
          IR_FODOrderJobs JTS
   WHERE :TOWhereClause
   UNION
   SELECT
         J.Job,
         :Job$Restore,
         J.JobClass,
         JC.Card,
         JC.SwitchingItem,
         JTS.Seq,
         J.Equip,
         J.EquipClass,
         JC.MoveEquipClass,
         J.EquipClassName,
         JC.PrintID,
         J.EquipName,
         JC.StepPair,
         J.Grounds,
         J.MoveType,
         J.RSMove,
         J.TOOperator,
         J.TOIssued,
         J.TOComplete,
         J.GroundOn,
         J.RSMove,     
         J.RSOperator,
         J.RSIssued,
         J.RSComplete,
         J.TOMoveRules,
         J.RSMoveRules,
         J.Response,
         J.ControlCard,            
         J.DeskName,
         JTS.PhaseCheckComplete,
         J.Substation,
         JTS.ReturnRemark,
         JTS.AckRejectedComment,
         JTS.JobStatus,
         JTS.FODEmployeeObject,
         JTS.VerbalEmployeeObject,
         JTS.ContactInfo,
         JTS.SendBackType
   FROM   SOA_Job J,
          SOA_JobControl JC,
          IR_FODOrderJobs JTS
   WHERE :RSWhereClause
   ORDER BY Seq
   BEGIN
      i = i + 1;
   END;
    
   IF Moves.LastRow() = 0 THEN
      Message 'Error: No jobs available for return.';
      RETURN(PU_CANCEL); 
   ENDIF;

   FOR i = 1 TO Moves.LastRow() DO
/*
** There would be a problem here if somehow the operator kills the application
** after having confirmed completion or incompletion - we would have no good way 
** to determine which moves were confirmed complete, and thus would 
** probably end up executing the job action twice. Confirming incomplete 
** is easier since we just have to look at the Issued time to determine 
** whether incompletion has already been done.
** Either way - THEY SHOULD NOT BE KILLING FMS WHILE RETURNING ORDERS.
*/
       IF TooQuick = FALSE THEN
/*
** Don't adjust button colors for returned to quickly moves.
*/
       IF (Moves[i].Status = Job$TakeOut AND Moves[i].TOComplete IS NULL) OR
            (Moves[i].Status = Job$Restore AND Moves[i].RSComplete IS NULL) THEN
          FIELD(Moves[i].Complete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Complete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;

          /* Our test case handling if an Incomplete was killed */
          IF (Moves[i].Status = Job$TakeOut AND Moves[i].TOIssued IS NULL) OR
              (Moves[i].Status = Job$Restore AND Moves[i].RSIssued IS NULL) THEN
             FIELD(Moves[i].Incomplete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
             FIELD(Moves[i].Incomplete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          ENDIF;

       ELSE /* On completion in a KILL situation, we have to let it repeat */
          FIELD(Moves[i].Incomplete_btn).BgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
          FIELD(Moves[i].Incomplete_btn).FgCOLOR =
                       field(Moves[*].ToIssued).BgColor;
       ENDIF;

       ENDIF;

       IF Moves[i].TOIssued = '' THEN
          FIELD(Moves[i].TOIssued).BgColor = CC_LIGHT_GRAY;
       ENDIF;

       IF Moves[i].TOComplete = '' THEN
          FIELD(Moves[i].TOComplete).BgColor = CC_LIGHT_GRAY;
       ENDIF;
          
       IF Moves[i].RSIssued = '' THEN
          FIELD(Moves[i].RSIssued).BgColor = CC_LIGHT_GRAY;
       ENDIF;

       IF Moves[i].RSComplete = '' THEN
          FIELD(Moves[i].RSComplete).BgColor = CC_LIGHT_GRAY;
       ENDIF;
/* 
** Set move FgColor to red if grounded.
*/
       IF Moves[i].Grounds IS NOT NULL AND Moves[i].Grounds > 0 AND
           Moves[i].GroundOn IS NOT NULL THEN
          FIELD(Moves[i].TOMove).FgColor = CC_RED;
       ELSE
          FIELD(Moves[i].TOMove).FgColor = CC_BLACK;
       ENDIF;
   ENDFOR;
END;


ON USEREVENT 'XA21Manual' =
DECLARE
   XA21Card = INTEGER NOT NULL;
   XA21Station = INTEGER NOT NULL;
BEGIN
/*
** Get the Station and Card associated with the Xa21 Job being completed manually to load
** all outstanding XA21 moves on that card in that station.
*/
   XA21Card = 0;
   XA21Station = 0;
   SELECT :XA21Card  = ControlCard,
          :XA21Station = Substation
   FROM   SOA_Job
   WHERE  Job = :XA21Job;

   Moves.Clear();
   i = 1;
   SELECT
         :Moves[i].OrderIssued = J.TOIssued,
         :Moves[i].Job = J.Job,
         :Moves[i].JobClass = J.JobClass,
         :Moves[i].Card = JC.Card,
         :Moves[i].SwitchingItem = JC.SwitchingItem,    
         :Moves[i].Seq = JC.Seq,
         :Moves[i].Status = :Job$TakeOut,
         :Moves[i].Equip = J.Equip,
         :Moves[i].EquipClass = J.EquipClass,
         :Moves[i].MoveEquipClass = JC.MoveEquipClass,
         :Moves[i].EquipClassName = J.EquipClassName,
         :Moves[i].PrintID = JC.PrintID,
         :Moves[i].EquipName = J.EquipName,
         :Moves[i].StepPair = JC.StepPair,
         :Moves[i].Grounds = J.Grounds,
         :Moves[i].MoveType = J.MoveType,
         :Moves[i].TOMove = J.TOMove,
         :Moves[i].TOOperator = J.TOOperator,
         :Moves[i].TOIssued = J.TOIssued,
         :Moves[i].TOComplete = J.TOComplete,
         :Moves[i].GroundOn = J.GroundOn,
         :Moves[i].RSMove = J.RSMove,     
         :Moves[i].RSOperator = J.RSOperator,
         :Moves[i].RSIssued = J.RSIssued,
         :Moves[i].RSComplete = J.RSComplete,
         :Moves[i].TOMoveRules = J.TOMoveRules,
         :Moves[i].RSMoveRules = J.RSMoveRules,
         :Moves[i].Response = J.Response,
         :Moves[i].ControlCard = J.ControlCard,
         :Moves[i].DeskName = J.DeskName,
         :Moves[i].Substation = J.Substation
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE JC.Card = :XA21Card AND
         JC.Job = J.Job AND
         J.Substation = :XA21Station AND
         J.TOIssued IS NOT NULL AND
         J.TOComplete IS NULL AND
         J.TOOperator = :Operator$XA21  
   UNION
   SELECT
         J.RSIssued,
         J.Job,
         J.JobClass,
         JC.Card,
         JC.SwitchingItem,    
         JC.Seq,
         :Job$Restore,
         J.Equip,
         J.EquipClass,
         JC.MoveEquipClass,
         J.EquipClassName,
         JC.PrintID,
         J.EquipName,
         JC.StepPair,
         J.Grounds,
         J.MoveType,
         J.TOMove,
         J.TOOperator,
         J.TOIssued,
         J.TOComplete,
         J.GroundOn,
         J.RSMove,     
         J.RSOperator,
         J.RSIssued,
         J.RSComplete,
         J.TOMoveRules,
         J.RSMoveRules,
         J.Response,
         J.ControlCard,
         J.DeskName,
         J.Substation
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE JC.Card = :XA21Card AND
         JC.Job = J.Job AND
         J.Substation = :XA21Station AND      
         J.RSIssued IS NOT NULL AND
         J.RSComplete IS NULL AND
         J.RSOperator = :Operator$XA21
   ORDER BY 1
   BEGIN
      IF Moves[i].Status = :Job$Restore THEN
        Moves[i].TOMove = Moves[i].RSMove;
      ENDIF;

      IF Moves[i].TOIssued = '' THEN
          FIELD(Moves[i].TOIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;

      IF Moves[i].TOComplete = '' THEN
          FIELD(Moves[i].TOComplete).BgColor = CC_LIGHT_GRAY;
      ENDIF;
          
      IF Moves[i].RSIssued = '' THEN
          FIELD(Moves[i].RSIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;

      IF Moves[i].RSComplete = '' THEN
          FIELD(Moves[i].RSComplete).BgColor = CC_LIGHT_GRAY;
      ENDIF;
/* 
** Set move FgColor to red if grounded.
*/
      IF Moves[i].Grounds IS NOT NULL AND Moves[i].Grounds > 0 AND
          Moves[i].GroundOn IS NOT NULL THEN
          FIELD(Moves[i].TOMove).FgColor = CC_RED;
      ELSE
         FIELD(Moves[i].TOMove).FgColor = CC_BLACK;
      ENDIF;
      i = i + 1;
   END;

   Selected.Object  = Operator$XA21; 
   Selected.Name = '';
   Selected.Description = 'XA21';

   FO.Object = Operator$XA21;
   FO.Name = '';
   FO.Description = 'XA21';

   FIELD(Selected).CurBias = FB_VISIBLE;
   FIELD(operatorselection).CurBias = FB_VISIBLE;
   FIELD(Find_Btn).CurBias = FB_DIMMED;

   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;
   LastBtnHit = '';
END;

ON USEREVENT 'LoadFaultJob' =
BEGIN
/*
** Load the Fault Move and call the PromptEnterFault screen to review the FOD
** Fault.  Return from that screen determines whether to complete or incomplete 
** the move.
*/
    i = 1;
   Moves.Clear();
   FODJobList.Clear();
   SELECT
                :Moves[i].Job = J.Job,
                :Moves[i].Status = :Job$TakeOut,
                :Moves[i].JobClass = J.JobClass,
                :Moves[i].Card = JC.Card,
                :Moves[i].SwitchingItem = JC.SwitchingItem,
                :Moves[i].Seq = JC.Seq,
                :Moves[i].Equip = J.Equip,
                :Moves[i].EquipClass = J.EquipClass,
                :Moves[i].MoveEquipClass = JC.MoveEquipClass,
                :Moves[i].EquipClassName = J.EquipClassName,
                :Moves[i].PrintID = JC.PrintID,
                :Moves[i].EquipName = J.EquipName,
                :Moves[i].StepPair = JC.StepPair,
                :Moves[i].Grounds = J.Grounds,
                :Moves[i].MoveType = J.MoveType,
                :Moves[i].TOMove = J.TOMove,
                :Moves[i].TOOperator = J.TOOperator,
                :Moves[i].TOIssued = J.TOIssued,
                :Moves[i].TOComplete = J.TOComplete,
                :Moves[i].GroundOn = J.GroundOn,
                :Moves[i].RSMove = J.RSMove,
                :Moves[i].RSOperator = J.RSOperator,
                :Moves[i].RSIssued = J.RSIssued,
                :Moves[i].RSComplete = J.RSComplete,
                :Moves[i].TOMoveRules = J.TOMoveRules,
                :Moves[i].RSMoveRules = J.RSMoveRules,
                :Moves[i].Response = J.Response,
                :Moves[i].ControlCard = J.ControlCard,
                :Moves[i].DeskName = J.DeskName,
                :Moves[i].Substation = J.Substation
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  J.Job = :FaultJob AND
          J.Job = JC.Job AND
          JC.Card = :Card;
    
   IF Moves.LastRow() = 0 THEN
      Message 'Error: FOD Fault move was not found.';
      RETURN(PU_CANCEL); 
   ENDIF;
/*
** Review the Fault here.
*/ 
   RetCode = CALLFRAME PromptEnterFault (
                         JIP = Moves[i].Duplicate(),
                         FODResponseType = BYREF(FODResponseType));
   IF RetCode = PU_CANCEL THEN
      RETURN(PU_CANCEL);
   ELSE
      IF FODResponseType = 'ACKNOWLEDGE' THEN
/*
** Complete the TakeOut move
*/
         i = 1;
         CurFrame.SendUserEvent (EventName = 'Complete');
      ELSEIF FODResponseType = 'REJECT' OR 
             FODResponseType = 'REQUEST_FOR_CHANGE' THEN
/*
** Incomplete the TakeOut move
*/
         i = 1;
         CurFrame.SendUserEvent (EventName = 'Incomplete');
      ELSE
         MESSAGE 'Error: Unexpected Response Type returned from Fault Review';
         RETURN(PU_CANCEL);
      ENDIF;
   ENDIF;
                         
END;

ON CLICK dostack.okbtn = 
BEGIN 
/*
** DO selected, enable the rest of the frame.
*/
   FIELD(dostack).Curbias = FB_INVISIBLE;
   FIELD(ok_btn).Curbias = FB_LANDABLE;
   ACKDO = dostack.districtoperator;
   CALLPROC SOA_LogIns (Card = Card,
                       Job  = NULL,
                       SwitchingItem  = IFNULL(Moves[1].SwitchingItem,0),
                       UserName = UserName,
                       Time = 'now',
                       Item = 'Order Return',
                       Old  = 'Order ' + VARCHAR(:OpOrder) + 
                              ' Return Acknowledged', 
                       New = 'DO: ' + dostack.DistrictOperator);
   CALLPROC DDB_COMMIT;
END;


ON CHILDCLICK Moves[*].Complete_Btn =
BEGIN
# include commoncheckingforROM

   BreakMove = FALSE; 
   ConditionalMove = FALSE; 
   GroundMove = FALSE; 
   PhaseTerminal = 0;
   CompleteOrIncomplete = 'C';
   vcompositegroundmoveresult = '';
   rmstack.compgroundresult = FALSE;
   FIELD(rmstack.compgroundresult).CurBias = FB_INVISIBLE;
/*
** If we are returning an operating order, then display the 
** return remark if one exists.  After displaying the remark,
** continue with Completion or Incompletion events for move = i.
*/                             
   IF Selected.Object = Operator$OpOrder AND ReturnOpOrder = TRUE THEN

      IF SQUEEZE(FODJobList[i].ReturnRemark) <> '' THEN

         FIELD(rmstack).AbsXLeft = FIELD(find_btn).AbsXLeft;
         FIELD(rmstack).AbsYTop = FIELD(find_btn).AbsYTop;

         rmstack.ReturnRemark = FODJobList[i].ReturnRemark;
         Moves[i].ReturnRemark = rmstack.ReturnRemark;

         FIELD(rmstack).Curbias = FB_LANDABLE;
         RESUME;
      ENDIF;
   ENDIF;
/*
** New Manual Order logic, need to Select the SSO Operator that is returning the Order.
*/
   IF Selected.Object = Operator$OpOrder AND ManualOrderToggle = TRUE AND ManualOperator = 0 THEN
      RetCode = CALLFRAME SelectOperator (JobClass = Moves[1].JobClass);

      IF RetCode = PU_OK THEN
         ManualOperator = FO.Object;
         Selected.Name = FO.Name;
         Selected.Description = FO.Description;
         CALLPROC SOA_LogIns (Card = Card,
                       Job  = NULL,
                       SwitchingItem  = IFNULL(Moves[1].SwitchingItem,0),
                       UserName = UserName,
                       Time = 'now',
                       Item = 'Manual Order',
                       Old  = 'Order ' + VARCHAR(:OpOrder) + 
                              ' being returned verbally', 
                       New = 'From SSO: ' + FO.Description);
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
   /* This is where the new manual order return locks the order, must be completed */
   IF Selected.Object = Operator$OpOrder AND ManualOrderToggle = TRUE THEN
      ManualReturnStarted = TRUE;
      FIELD(Selected).CurBias = FB_VISIBLE;
      FIELD(operatorselection).CurBias = FB_VISIBLE;
      FIELD(Find_Btn).CurBias = FB_DIMMED;
   ENDIF;
/*
** If we are returning an FOD operating order, then display the 
** return remark if one exists.  After displaying the remark,
** continue with Completion or Incompletion events for move = i.
*/                             
   IF ReturnFODOrder = TRUE THEN
      IF FODJobList[i].ReturnRemark <> '' OR 
         FODJobList[i].AckRejectedComment <> '' OR
         Moves[i].PhaseCheckColor = 1 THEN

         FIELD(fodrmstack).AbsXLeft = FIELD(find_btn).AbsXLeft;
         FIELD(fodrmstack).AbsYTop = FIELD(find_btn).AbsYTop;

         IF Moves[i].PhaseCheckColor = 1 AND
           (Moves[i].StepPair = StepHeading$Deload OR 
            Moves[i].StepPair = StepHeading$Iso) AND
           (CardDetails.Cutout IS NULL OR 
            CardDetails.CutIn IS NOT NULL) THEN

            FIELD(fodrmstack.PhaseChecktxt).CurBias = FB_VISIBLE;
         ELSE
            FIELD(fodrmstack.PhaseChecktxt).CurBias = FB_INVISIBLE;
         ENDIF;

         FIELD(fodrmstack.FODCrew).Curbias = FB_INVISIBLE;
         IF FODJobList[i].ReturnRemark <> '' THEN
            fodrmstack.ReturnRemark = FODJobList[i].ReturnRemark;

         ELSE
            IF FODJobList[i].VerbalEmployeeObject > 0 THEN 
               SELECT :FODJobList[i].VerbalEmployeeName = O.Description     
               FROM UDB_Object O 
               WHERE O.Object = :FODJobList[i].VerbalEmployeeObject;

               fodrmstack.FODCrew = 'Re-issue verbally to crew: ' +
                                    HC_NEWLINE +  
                                    FODJobList[i].VerbalEmployeeName;
               IF FODJobList[i].ContactInfo <> '' THEN
                  fodrmstack.FODCrew = fodrmstack.FODCrew +
                                    HC_NEWLINE +  
                                    'Contact Info: ' +
                                    FODJobList[i].ContactInfo;
               ENDIF;
               FIELD(fodrmstack.FODCrew).Curbias = FB_VISIBLE;

            ELSEIF FODJobList[i].SendBackType = 'SEND_BACK_TO_SELF' THEN 
               SELECT :FODJobList[i].EmployeeName = O.Description     
               FROM UDB_Object O 
               WHERE O.Object = :FODJobList[i].EmployeeObject;

               fodrmstack.FODCrew = 'Re-issue electronically to FOD -' +
                                    'wireless crew: ' +
                                    HC_NEWLINE +  
                                    FODJobList[i].EmployeeName; 
               IF FODJobList[i].ContactInfo <> '' THEN
                  fodrmstack.FODCrew = fodrmstack.FODCrew +
                                    HC_NEWLINE +  
                                    'Contact Info: ' +
                                    FODJobList[i].ContactInfo;
               ENDIF;
               FIELD(fodrmstack.FODCrew).Curbias = FB_VISIBLE;

            ENDIF;
            fodrmstack.ReturnRemark = FODJobList[i].AckRejectedComment; 
         ENDIF;
           
         FIELD(fodrmstack.rm_trim).TextValue = 'The ' + OrderTarget + ' entered the following' + HC_NEWLINE +
                  'remark for the move being returned.';
 
         FIELD(fodrmstack).Curbias = FB_MOVEABLE;
         RESUME;
      ENDIF;
   ENDIF;
   CurFrame.SendUserEvent (EventName = 'Complete');
END;


ON CLICK rmstack.okbtn = 
BEGIN
   IF LENGTH(rmstack.ReturnRemark) > 75 THEN
      rmstack.ReturnRemark = LEFT(rmstack.ReturnRemark,75) + '...';
   ENDIF;   
   CALLPROC SOA_LogIns (Card = Moves[i].Card,
                       Job  = Moves[i].Job,
                       SwitchingItem  = Moves[i].SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'ReturnRemark',
                       Old  = 'Message from SSO',
                       New  = rmstack.ReturnRemark);
      
   IF vcompositegroundmoveresult = 'NOT GROUNDED' THEN
      CALLPROC SOA_LogIns (Card = Moves[i].Card,
                       Job  = Moves[i].Job,
                       SwitchingItem  = Moves[i].SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'Feeder Ground',
                       Old  = 'SSO Reports',
                       New  = 'Feeder could not be re-ground');
      FIELD(CompGroundResult).CurBias = FB_VISIBLE;
/*
** Insert Apply Station Ground move
*/
      GJ.Job = 0;
      REPEATED
      SELECT :GJ.Job = J.Job,
             :GJ.Equip = J.Equip,
             :GJ.EquipName = J.EquipName,
             :GJ.EquipClass = J.EquipClass,
             :GJ.EquipClassName = J.EquipClassName,
             :GJ.PrintID = JC.PrintID,
             :GJ.Grounds = J.Grounds,
             :GJ.GroundOn = J.GroundOn,
             :GJ.Substation = J.Substation,
             :GJ.DeskName = J.DeskName,
             :GJ.ControlCard = J.ControlCard,
             :GJ.Card = JC.Card,
             :GJ.Status = J.Status,
             :GJ.JobClass = J.JobClass,
             :GJ.MoveType = J.MoveType,
             :GJ.TOMove = J.TOMove,
             :GJ.TOMoveRules = J.TOMoveRules,
             :GJ.RSMove = J.RSMove,
             :GJ.RSMoveRules = J.RSMoveRules,
             :GJ.MoveEquipClass = JC.MoveEquipClass,
             :GJ.StepPair = JC.StepPair,
             :TypeOfCard = C.TypeOfCard
      FROM   SOA_JobControl JC,
             SOA_Job J,
             SOA_Card C
      WHERE  JC.Card = :Card AND
             JC.Job = J.Job AND
             JC.StepPair = :StepPair$DeEnergize AND
             JC.Card = C.Card AND
             J.Status = '' AND
             J.TOComplete IS NOT NULL AND
             J.RSIssued IS NULL AND
             J.Grounds > 0 AND
             J.GroundOn IS NOT NULL;

      IF GJ.Job = 0 THEN
         MESSAGE 'Unable to find outstanding station ground move to copy.';
      ELSE
         GJ.Card = Card;
         GJ.GroundOn = NULL;
         GJ.ControlCard = Card;
         GJ.Job = -1;
         GJ.Seq = -1;
         GJ.Job = GJ.InsertMove (CardTypeofCard = TypeOfCard,
                                 KeepMoveText = TRUE);

         IF GJ.Job <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert open station ground move due to an error.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;      
   ENDIF;
   CALLPROC DDB_COMMIT;
   FIELD(rmstack).curbias = FB_INVISIBLE;

   IF CompleteOrIncomplete = 'C' THEN
      CurFrame.SendUserEvent (EventName = 'Complete');
   ELSE
      CurFrame.SendUserEvent (EventName = 'InComplete');
   ENDIF;            
END;

ON CLICK fodrmstack.okbtn = 
BEGIN
   IF LENGTH(fodrmstack.ReturnRemark) > 70 THEN
      fodrmstack.ReturnRemark = LEFT(fodrmstack.ReturnRemark,59) + '...';
   ENDIF;   
   CALLPROC SOA_LogIns (Card = Moves[i].Card,
                       Job  = Moves[i].Job,
                       SwitchingItem  = Moves[i].SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'ReturnRemark',
                       Old  = 'Message from ' + OrderTarget,
                       New  = fodrmstack.ReturnRemark);
   CALLPROC DDB_COMMIT;
   FIELD(fodrmstack).curbias = FB_INVISIBLE;
    
   IF CompleteOrIncomplete = 'C' THEN
      CurFrame.SendUserEvent (EventName = 'Complete');
   ELSE
      CurFrame.SendUserEvent (EventName = 'InComplete');
   ENDIF;            
END;

ON USEREVENT 'Complete' =
BEGIN                      
/*
**  TempResponse is set as a separate variable because TempJob
**  is reset after successful completion of completing a move.
** 
**  TempJob is set here so that we can keep track of the fields 
**  if the user Undo's and Incomplete move.
**
**  TempResponse is used when the Undo button is selected. 
*/
   TempJob = Moves[i].Duplicate();
   TempResponse = Moves[i].Response; 
/*
** If we are returning an order, don't do JobChecks or complete the move,
** but do everything else.
*/
   IF ReturnOpOrder = FALSE AND
      (ReturnFODOrder = FALSE OR TooQuick = TRUE) THEN

      LastBtnHit = 'complete';
/*
**  Perform JobChecks on move
*/
      RetCode = Moves[i].JobChecks(IssueCompl = JobClass$Complete);

      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;
/*
**  Record the state of things
*/
      Complete = 'now';
/*
** If manual entry mode is true, allow them to change the complete time
*/
      IF ManualEntryModeFlag = TRUE THEN
         IF Moves[i].Status = Job$TakeOut THEN
            Moves[i].TOComplete = Complete;
            CALLFRAME ManualTimeEntry 
                   (Move = Moves[i],
                    MessageText = 'TO Complete',
                    NoAudit = TRUE);
            Complete = Moves[i].TOComplete;
         ELSE
            Moves[i].RSComplete = Complete;
            CALLFRAME ManualTimeEntry 
                   (Move = Moves[i],
                    MessageText = 'RS Complete',
                    NoAudit = TRUE);
            Complete = Moves[i].RSComplete;
         ENDIF;
      ENDIF;
/*
**  Complete the move
*/
      RetCode = SimpleJob.CompleteMove(Job = Moves[i],
                                       SetTime = Complete);
      IF RetCode = PU_CANCEL THEN
         Message 'Please manually complete the move.';
      ENDIF;
   ENDIF;
/*
**  Perform JobActions for move
*/
   FOTSituation = FALSE;
   RetCode = Moves[i].JobActions(IssueCompl = JobClass$Complete);
   IF RetCode = PU_CANCEL THEN
         
      RetCode = SimpleJob.InCompleteMove(Job = Moves[i]);
      IF RetCode = PU_CANCEL THEN
         Message 'Please update move manually';
      ENDIF;

      RESUME NEXT;
   ELSEIF RetCode = Type$FOT THEN  
      FOTSituation = TRUE;
   ENDIF;
/*
**   Log changed Steam Operator.
*/
   IF SteamOp <> '' THEN
      IF Moves[i].Status = Job$TakeOut THEN
         CALLPROC SOA_LogIns (
           Card           = Moves[i].Card
         , Job            = Moves[i].Job
         , SwitchingItem  = Moves[i].SwitchingItem
         , Time           = DATE('now')
         , UserName       = UserName
         , Item           = 'RETURN OP'
         , Old            = 'ShutOff Operator'
         , New            = SteamOp
         );
      ELSE
         CALLPROC SOA_LogIns (
           Card           = Moves[].Card
         , Job            = Moves[].Job
         , SwitchingItem  = Moves[].SwitchingItem
         , Time           = DATE('now')
         , UserName       = UserName
         , Item           = 'RETURN OP'
         , Old            = 'TurnOn Operator'
         , New            = SteamOp
         );
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
       
   TempJob = Moves[i].Duplicate();
/*
**  Remove any pending statuses
*/
   Moves[i].ClearPendingActions();

   Moves[i].ReturnConfirmed = 1;
/* 
** Prevent selection of another operator after Complete/Incomplete is clicked
*/
   FIELD(OperatorSelection).CurBias = FB_VISIBLE;
/*
**  Loop through moves and update the fields for all occurrences of this job.
*/
   m = 1;
   WHILE m <= Moves.LastRow() DO
      IF Moves[i].Job = Moves[m].Job AND i <> m THEN
      /*
      **  Update the complete date on the current move.
      */
         IF Moves[i].Status = Job$TakeOut THEN
            Moves[m].TOIssued = Moves[i].ToIssued;
            Moves[m].TOOperator = Moves[i].TOOperator;
            Moves[m].TOComplete = Moves[i].ToComplete;
         ELSE
            Moves[m].RSIssued = Moves[i].RSIssued;
            Moves[m].RSOperator = Moves[i].RSOperator;
            Moves[m].RSComplete = Moves[i].RSComplete;
         ENDIF;
      ENDIF;
      m = m + 1;
   ENDWHILE;        

   FIELD(Moves[i].Complete_btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Incomplete_btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Incomplete_btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
/*
**   If this is a 4kv card and c.stepdownjob is set,  check to see if all
**   checks pass for this card.
**   11/22/96 - issue SDClearCheck on both takeout and restore
     01/07/02 - being commented out since Step down wasn't moved forward
                with Merge effort.
   IF CardDetails.TypeOfCard = Type$4KVCard AND 
      Card.StepDownJob <> 0   THEN
      CALLPROC SDClearCheck(C = Card);
   ENDIF;
*/
/*
**  Get CardClass information for SOA_Activity insert.
*/
   IF CardClass = 0 THEN
      IF Moves[i].SwitchingItem IS NULL OR
         Moves[i].SwitchingItem = 0 THEN
         REPEATED
         SELECT :CardClass = CardClass
         FROM    SOA_Card
         WHERE   Card = :Moves[i].Card;
      ELSE
         REPEATED
         SELECT :CardClass = CardClass
         FROM    SLC_InformationItem
         WHERE   Job = :Moves[i].SwitchingItem;
      ENDIF;
   ENDIF;
/*
**  Find Division for job.
*/
   Division = 0;
   IF Moves[i].Substation <> 0 THEN
      REPEATED
      SELECT :Division = G.Grouping 
      FROM   Udb_Grouping G
      WHERE  G.Member = :Moves[i].Substation AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division;

   ELSEIF CurrentApplication = Application$TFMS AND 
          Moves[i].Substation = 0 AND
          Moves[i].Equip <> 0 THEN

      REPEATED
      SELECT :Division = GG.Grouping 
      FROM   Udb_Grouping G,
             Udb_Grouping GG
      WHERE  G.Member = :Moves[i].Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Line AND
             G.Grouping = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.GroupingType = :Type$Division;

   ELSEIF CurrentApplication = Application$FMS THEN
      REPEATED
      SELECT :Division = GG.Grouping 
      FROM   Udb_Grouping G,
             Udb_Grouping GG
      WHERE  G.Member = :CardDetails.Object[1].Object AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Substation AND
             G.Grouping = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.GroupingType = :Type$Division;

      IF Division = 0 THEN
         SELECT :Division = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :CardDetails.Object[1].Object AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Division;
      ENDIF;

   ELSEIF CurrentApplication <> Application$SDS AND
          Moves[i].Equip <> 0 THEN
      Message 'Warning::(ReturnOperatorMoves) Equipment ' + 
              Moves[i].EquipClassName + 
              ' ' + Moves[i].Equipname + ' does not appear to ' +
              'be set up correctly in the database.  Please notify ' +
              'technical support of this problem.';
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              'Warning::(ReturnOperatorMoves) ' +
              'Equipment ' + Moves[i].EquipClassName + ' ' + 
              Moves[i].Equipname + 
              ' does not appear to be set up correctly in the database.');
   ENDIF;

   IF CardClass <> Type$CardClassTest AND Division <> 0 THEN   
      IF Uppercase(dow(date('now'))) = 'SAT' OR 
         Uppercase(dow(date('now'))) = 'SUN' THEN
         TypeOfDay = 1;
      ELSE
         TypeOfDay = 2;
      ENDIF;
 
      IF date_part('hour',date('now')) < 8 THEN
         ShiftTime = 1;
      ELSEIF date_part('hour',date('now')) >= 8 AND
             date_part('hour',date('now')) < 16 THEN
         ShiftTime = 2;
      ELSE
         ShiftTime = 3;
      ENDIF;
          
      CALLPROC SOA_ActivityIns(
                   Application = CurrentApplication,
                   Division = Division,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   ShiftTime = ShiftTime,
                   TypeOfDay = TypeOfDay,
                   IssueComplete = 2,
                   ShiftID = DOp.ShiftID);
      CALLPROC DDB_COMMIT;

   ENDIF;
/*
**  Send heads up message to Division Control Center if condition exists.
**  Start of DCC checks
*/
   IF CurrentApplication = Application$FMS AND
      CardDetails.TypeOfCard = Type$13kVCard THEN

      CALLPROC DCCChecksForMoveReturn (Move = Moves[i],
                          FeederName = CardDetails.FeederName,
                          Feeder = CardDetails.Object[1].Object,
                          Position = CardDetails.Position,
                          Card = CardDetails.Card);
   ENDIF; 

   IF ReturnFault = TRUE THEN
      RETURN(PU_OK);
   ENDIF;

   IF ReturnFODOrder = TRUE THEN

      IF FODJobList[i].JobStatus = Order$Closed THEN
/*
** Update the job status to Order$ConfirmClosed in the IR_FODOrderJobs table.
*/
         RetCode = CALLPROC IR_FODJobStatusUpd( OrderNumber = OpOrder,
                                             Job = Moves[i].Job, 
                                             TORS = TORS,
                                             JobStatus = Order$ConfirmClosed,
                                             Pending = 0);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
 
            /*  Send acknowledgement to RR  */ 
            ControlText = VARCHAR(OpOrder) + ';';
            ControlText = ControlText + varchar(Moves[i].Job) + ';';
            ControlText = ControlText + varchar(TORS) + ';';
            ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
            ControlText = ControlText + AckDO + ';';
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_AckFODReturnMove',
                     EventText = ControlText);  
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Unable to update move status for job from ' +
                     'downloaded order. Job may not show up correctly ' +
                     'on the front of the card.' +  
                     HC_NEWLINE +
                     'Contact technical support.  Job = ' +
                     VARCHAR(Moves[i].Job);
         ENDIF;
/*
** This is where we check if Phase Check was not completed AND was required.  We need to insert an
** explicit Phase Check move for the equipment in this situation.
*/ 
        IF Moves[i].PhaseCheckColor = 0 THEN   /* was not completed */

           PhaseCheckRequired = 0;
           SELECT :PhaseCheckRequired = SatisfyEquip
           FROM   FMS_PhaseCheck 
           WHERE  Card = :CardDetails.Card AND
                  CompletionTime IS NULL AND
                  SatisfyEquip = :Moves[i].Equip;

           IF PhaseCheckRequired <> 0 AND
             (Moves[i].StepPair = StepHeading$Deload OR 
              Moves[i].StepPair = StepHeading$Iso) AND
             (CardDetails.Cutout IS NULL OR 
              CardDetails.CutIn IS NOT NULL) THEN   /* was required */
   
              CALLPROC InsertPhaseCheck (Card = CardDetails.Card,
                                         Equip = Moves[i].Equip,
                                         EquipName = Moves[i].EquipName,
                                         EquipClass = Moves[i].EquipClass,
                                         EquipClassName = Moves[i].EquipClassName,
                                         PrintID = Moves[i].PrintID,
                                         IssueIt = FALSE);
           ENDIF;
        ENDIF;
     ENDIF;
   ENDIF;
/*
** If an FOT was created, this is where we break out of our processing.
*/
   IF FOTSituation = TRUE THEN
      /*  
      ** Check if this is an SSO Order Return.
      */
      IF ReturnOpOrder = TRUE THEN
         /*  
         ** Check if all moves complete.
         ** 01/03/13: if this is an SSO order return, FOT will be delayed until all moves are processed.
         ** So, it is unnecessary to check outstanding moves here.
         *
         FOR i = 1 TO Moves.LastRow() DO
             IF FIELD(Moves[i].Complete_btn).BGColor = CC_PALE_CYAN OR 
                FIELD(Moves[i].InComplete_btn).BGColor = CC_PALE_CYAN THEN

                MESSAGE 'An FOT has been created.  The order is being marked ' +
                        'complete, but you still have to complete/incomplete ' +
                        'outstanding moves on the FOT card...';

                ENDLOOP;
             ENDIF;
         ENDFOR;
         01/03/13  */
         
         CALLPROC UpdateOpOrderStatus();
         /*
         **  Set Operating Order Status = Order$ConfirmClosed.
         *
         RetCode = CALLPROC IR_OrderStatusUpd
                  (OrderNumber = OpOrder,
                   OrderStatus = Order$ConfirmClosed);

         IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              ': WARNING - Order Status ' + 
              'not updated to: ' + varchar(Order$ConfirmClosed) + 
              ' for order: ' + varchar(oporder));
             Message 'Unable to update Operating Order status. ' +
              'Timestamp(s) will ' +
              'continue to show as gray. Please report problem to ' +
              'technical support.' + HC_NEWLINE + 'Order Status ' + 
              'not updated to: ' + varchar(Order$ConfirmClosed) + 
              ' for order: ' + varchar(oporder);
             RETURN (PU_CANCEL);
         ELSE
             CALLPROC DDB_COMMIT;             
              // RETURN(PU_OK);
         ENDIF;
         01/03/13  */
      ENDIF;
      /* 
      **   FOT Card created. processing must stop because the original card is 
      **   Closed.
      **   If there are outstanding moves, the DO will need to 
      **   complete processing on the new card.
      */
      IF CardDetails.CardClass <> Type$ISO THEN
          Message 'Creation of FOT Card has closed the current card. ' +
              'Outstanding moves have been transferred. Please ' +
              'continue work using the new FOT card.';
      ELSE
          Message 'Creation of Xfer Card has closed the current card. ' +
              'Outstanding moves have been transferred. Please ' +
              'continue work using the new ISO card.';
      ENDIF;
     
      RETURN(PU_OK);                          
   ENDIF;
/*
** Continue remainder of processing for this screen if not an FOT Situation.
*/
   IF ReturnOpOrder = TRUE THEN
/*
** If a returned order, automatically call conditional moves or return phases
** if necessary.
*/
      SELECT 
            :vphaseground = PhaseGround,
            :vphasegroundresult = PhaseGroundResult,
            :vphasebreak = PhaseBreak,
            :vphasebreakresult = PhaseBreakResult,
            :vconditionalmove = ConditionalMove,
            :vconditionalmoveresult = ConditionalMoveResult
      FROM  IR_DownloadMove
      WHERE OrderNumber = :OpOrder AND
            Job = :Moves[i].job AND
            TORS = :TORS;

      IF vconditionalmove = 1 AND vconditionalmoveresult = 'YES' THEN
         RetCode = CALLFRAME ConditionalMoves (
                   Move = Moves[i]
                ,  Card = Moves[i].Card
                ,  CardSwitchingItem = Moves[i].SwitchingItem
               );   
         IF RetCode = PU_OK THEN
            FIELD(Moves[i].Conditional_btn).FgCOLOR = CC_RED;
            FIELD(Moves[i].Conditional_btn).BgCOLOR = FIELD(Moves[i].Incomplete_btn).BgCOLOR;
         ENDIF;
      ENDIF;
/*
** With sub-moves, RR is not sending back phase results, so no need to attempt this logic.

      IF (vphasebreak = 1 AND vphasebreakresult <> 'ALL') THEN

         IF vphasebreakresult = '' THEN
            MESSAGE 'Individual Phases not returned from Rapid Restore.  Assuming all phases complete.';
         ELSE
            RetCode = CALLFRAME ReturnPhases (PhaseMove = Moves[i],
                                     BreakMove = TRUE,
                                     GroundMove = FALSE,
                                     CompletedPhases = vphasebreakresult);
            IF RetCode = PU_OK THEN
               FIELD(Moves[i].Phase_btn).FgCOLOR = CC_RED;
               FIELD(Undo_BTN).CurBias = FB_DIMMED;
               UndoRow = 0;
            ENDIF;
         ENDIF;
      ENDIF;     

      IF (vphaseground = 1 AND vphasegroundresult <> 'ALL') THEN

         IF vphasegroundresult = '' THEN
            MESSAGE 'Individual Phases not returned from Rapid Restore.  Assuming all phases complete.';
         ELSE
            RetCode = CALLFRAME ReturnPhases (PhaseMove = Moves[i],
                                     BreakMove = FALSE,
                                     GroundMove = TRUE,
                                     CompletedPhases = vphasegroundresult);
            IF RetCode = PU_OK THEN
               FIELD(Moves[i].Phase_btn).FgCOLOR = CC_RED;
               FIELD(Undo_BTN).CurBias = FB_DIMMED;
               UndoRow = 0;
            ENDIF;
         ENDIF;
      ENDIF;     
*/
      FIELD(Undo_BTN).CurBias = FB_DIMMED;
      UndoRow = 0;

   ELSE
/*
** Check if a Conditional Move.
*/
      SELECT :ConditionalMove = Conditional
      FROM   FMS_JobClass 
      WHERE  JobClass = :Moves[i].JobClass;

      IF ConditionalMove = TRUE THEN
         FIELD(Moves[i].Conditional_btn).FgColor = CC_BLACK;
         FIELD(Moves[i].Conditional_btn).BgColor = CC_PALE_CYAN;
      ENDIF;
      IF ReturnOpOrder = FALSE AND ManualRescind = FALSE AND 
         ReturnFODOrder = FALSE AND ManualFODRescind = FALSE THEN
         Field(Undo_BTN).CurBias = FB_CHANGEABLE;
         UndoRow = i;
      ENDIF;

      CALLPROC DeterminePhase(RowNumber = i);
   ENDIF;
/*
** Check if Grounded and set color appropriately
*/
   k = 0;
   REPEATED 
   SELECT :k = 1
   FROM   SOA_Job J,
          FMS_ObjectStatus OS
   WHERE  J.Job = :Moves[i].Job AND
          J.GroundOn IS NOT NULL AND
          J.Equip = OS.Object AND
          OS.StatusCount >= 1 AND
          OS.Status = :Status$Ground;

   IF k = 1 THEN
      FIELD(Moves[i].TOMove).FGColor = CC_RED;
   ELSE
      FIELD(Moves[i].TOMove).FGColor = CC_BLACK;
   ENDIF;
/*
** IF Operator is XA21, want to remove associated XA21 Display Request
*/
   IF Selected.Object = Operator$XA21 THEN
      CALLPROC FMS_SoccsXMessageDel (Job = Moves[i].Job);
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Update move response
*/
   IF CurrentApplication = Application$TFMS AND Moves[i].Status = Job$Restore AND
      (Moves[i].Substation = 144060 OR Moves[i].Substation = 144231) THEN
      /*
      ** clear HoldOff number (TFMS card number) from the response column
      */
      Moves[i].Response = Replace(S1 = Moves[i].Response, S2=VARCHAR(Card), S3='');
      Moves[i].ResponseUpd();           
   ENDIF;

   SELECT :Moves[i].Response = Response
   FROM   SOA_Job
   WHERE  Job = :Moves[i].Job;
   CurFrame.Flush();
END;


ON CHILDCLICK Moves[*].Incomplete_Btn =
BEGIN
# include commoncheckingforROM 

   BreakMove = FALSE; 
   ConditionalMove = FALSE; 
   GroundMove = FALSE; 
   CompleteOrIncomplete = 'I';
/*
** If we are returning an operating order, then display the 
** return remark if one exists.  After displaying the remark,
** continue with Completion or Incompletion events for move = i.
*/                             
   vcompositegroundmoveresult = '';
   IF Selected.Object = Operator$OpOrder AND ReturnOpOrder = TRUE THEN
/*
** If a composite ground move.returned order, automatically call conditional moves or return phases
** if necessary.
*/
      SELECT 
            :vcompositegroundmoveresult = CompositeGroundMoveResult
      FROM  IR_DownloadMove
      WHERE OrderNumber = :OpOrder AND
            Job = :Moves[i].job AND
            TORS = :TORS AND
            CompositeGroundMove = 1;

      IF squeeze(FODJobList[i].ReturnRemark) <> '' OR
         FODJobList[i].AckRejectedComment <> '' OR
         vcompositegroundmoveresult = 'NOT GROUNDED' THEN

         FIELD(rmstack).AbsXLeft = FIELD(find_btn).AbsXLeft;
         FIELD(rmstack).AbsYTop = FIELD(find_btn).AbsYTop;

         IF SQUEEZE(FODJobList[i].ReturnRemark) <> '' THEN
            rmstack.ReturnRemark = FODJobList[i].ReturnRemark;
            IF vcompositegroundmoveresult <> '' THEN 
               rmstack.ReturnRemark = rmstack.ReturnRemark;
            ENDIF;
         ELSEIF FODJobList[i].AckRejectedComment <> '' THEN
            rmstack.ReturnRemark = FODJobList[i].AckRejectedComment; 
            IF vcompositegroundmoveresult <> '' THEN 
               rmstack.ReturnRemark = rmstack.ReturnRemark;
            ENDIF;
         ENDIF;

         IF vcompositegroundmoveresult = 'NOT GROUNDED' THEN
            rmstack.compgroundresult = TRUE;
            FIELD(rmstack.compgroundresult).CurBias = FB_VISIBLE;
         ELSE
            rmstack.compgroundresult = FALSE;
            FIELD(rmstack.compgroundresult).CurBias = FB_INVISIBLE;
         ENDIF; 
         FIELD(rmstack).Curbias = FB_LANDABLE; 
         CurFrame.Flush();
         RESUME;
      ENDIF;
   ENDIF;
   /* This is where the new manual order return locks the order, must be incompleted */
   IF Selected.Object = Operator$OpOrder AND ManualOrderToggle = TRUE THEN
      ManualReturnStarted = TRUE;
      FIELD(Selected).CurBias = FB_VISIBLE;
      FIELD(operatorselection).CurBias = FB_VISIBLE;
      FIELD(Find_Btn).CurBias = FB_DIMMED;
   ENDIF;
/*
** If we are returning an FOD operating order, then display the 
** return remark if one exists.  After displaying the remark,
** continue with Completion or Incompletion events for move = i.
*/                             
   IF ReturnFODOrder = TRUE THEN
      IF FODJobList[i].ReturnRemark <> '' OR 
         FODJobList[i].AckRejectedComment <> '' OR
         Moves[i].PhaseCheckColor = 1 THEN

         FIELD(fodrmstack).AbsXLeft = FIELD(find_btn).AbsXLeft;
         FIELD(fodrmstack).AbsYTop = FIELD(find_btn).AbsYTop;

         IF Moves[i].PhaseCheckColor = 1 AND
           (Moves[i].StepPair = StepHeading$Deload OR 
            Moves[i].StepPair = StepHeading$Iso) AND
           (CardDetails.Cutout IS NULL OR 
            CardDetails.CutIn IS NOT NULL) THEN
            FIELD(fodrmstack.PhaseChecktxt).CurBias = FB_VISIBLE;
         ELSE
            FIELD(fodrmstack.PhaseChecktxt).CurBias = FB_INVISIBLE;
         ENDIF;

         FIELD(fodrmstack.FODCrew).Curbias = FB_INVISIBLE;
         IF FODJobList[i].ReturnRemark <> '' THEN
            fodrmstack.ReturnRemark = FODJobList[i].ReturnRemark;

         ELSE
            IF FODJobList[i].VerbalEmployeeObject > 0 THEN 
               SELECT :FODJobList[i].VerbalEmployeeName = O.Description     
               FROM UDB_Object O 
               WHERE O.Object = :FODJobList[i].VerbalEmployeeObject;

               fodrmstack.FODCrew = 'Re-issue verbally to crew: ' +
                                    HC_NEWLINE +  
                                    FODJobList[i].VerbalEmployeeName;
               IF FODJobList[i].ContactInfo <> '' THEN
                  fodrmstack.FODCrew = fodrmstack.FODCrew +
                                    HC_NEWLINE +  
                                    'Contact Info: ' +
                                    FODJobList[i].ContactInfo;
               ENDIF;
               FIELD(fodrmstack.FODCrew).Curbias = FB_VISIBLE;

            ELSEIF FODJobList[i].SendBackType = 'SEND_BACK_TO_SELF' THEN 
               SELECT :FODJobList[i].EmployeeName = O.Description     
               FROM UDB_Object O 
               WHERE O.Object = :FODJobList[i].EmployeeObject;

               fodrmstack.FODCrew = 'Re-issue electronically to FOD -' +
                                    'wireless crew: ' +
                                    HC_NEWLINE +  
                                    FODJobList[i].EmployeeName; 
               IF FODJobList[i].ContactInfo <> '' THEN
	          fodrmstack.FODCrew = fodrmstack.FODCrew +
                                    HC_NEWLINE +  
                                    'Contact Info: ' +
                                    FODJobList[i].ContactInfo;
               ENDIF;
               FIELD(fodrmstack.FODCrew).Curbias = FB_VISIBLE;

            ENDIF;
            fodrmstack.ReturnRemark = FODJobList[i].AckRejectedComment; 
         ENDIF;

         FIELD(fodrmstack.rm_trim).TextValue = 'The ' + OrderTarget + ' entered the following' + HC_NEWLINE +
                  'remark for the move being returned.';
 
         FIELD(fodrmstack).Curbias = FB_MOVEABLE;
         RESUME;
      ENDIF;
   ENDIF;
   
   CurFrame.SendUserEvent (EventName = 'Incomplete');
END;

ON USEREVENT 'Incomplete' =
DECLARE 
   text_string = STRINGOBJECT;
ENDDECLARE
BEGIN            
/*
**  TempResponse is set as a separate variable because TempJob
**  is reset after successful completion of completing a move.
** 
**  TempJob is set here so that we can keep track of the fields 
**  if the user Undo's and Incomplete move.
**
**  TempResponse is used when the Undo button is selected. 
*/
   TempJob = Moves[i].Duplicate();
   TempResponse = Moves[i].Response; 

   LastBtnHit = 'incomplete';
/*
** Prompt for incomplete reason on DSO
*/
   text_string.value = '';
   IF CurrentApplication = Application$DSO THEN
      IF ReturnOpOrder = TRUE THEN
         IF OrderStatus = Order$Rescinded THEN
            text_string.value = 'Rescinded by SM';
         ELSEIF OrderStatus = Order$Rejected THEN
            text_string.value = 'Rejected by SSO';
         ELSE
            text_string.value = 'XXX Figure this out in ReturnOperatorMoves';
         ENDIF;
      ENDIF;
   
      WHILE text_string.value = '' AND ManualRescind = FALSE DO
          RetCode = CurFrame.ReplyPopup (MessageText = 'Reason for Incompletion?',
                                         Reply = text_string);
          IF RetCode <> PU_OK THEN
             RESUME;
          ENDIF;
      ENDWHILE;
      Moves[i].Response = 'Incomplete: ' + text_string.value + '; ' + TempResponse;
   ENDIF;
/*
**  Remove any pending statuses.  Do this before CancelIssueMove
**  because to/rs operator gets cleared and then ClearPendingActions
**  won't work.
*/
   Moves[i].ClearPendingActions();
/*
**  Clear issued move.
*/
   RetCode = SimpleJob.CancelIssueMove(Job = Moves[i]);

   IF RetCode = PU_CANCEL THEN
      Message 'Please update move manually';
   ENDIF;
/*
**  Reverse any JobActions that may have taken place at issue time.
**    Do this after CancelIssueMove because PendingDelay check looks
**    at outstanding moves and problems occur is this is the last 
**    outstanding move being incompleted.  OperatingStepCount gets 
**    set to 1 instead of 0 and then no pending delay is set for this 
**    card.
*/
   RetCode = Moves[i].UndoJobActions(IssueCompl = JobClass$Issue);
      
   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;

   Moves[i].ReturnConfirmed = 1;
/* 
** Prevent selection of another operator after Complete/Incomplete is clicked
*/
   FIELD(OperatorSelection).CurBias = FB_VISIBLE;
/*
**  Loop through moves and update the fields for all occurrences of this job.
*/
   m = 1;
   WHILE m <= Moves.LastRow() DO
      IF Moves[i].Job = Moves[m].Job AND i <> m THEN
   /*
   **  Update the complete date on the current move.
   */
         IF Moves[i].Status = Job$TakeOut THEN
            Moves[m].TOIssued = Moves[i].ToIssued;
            Moves[m].TOOperator = Moves[i].TOOperator;
            Moves[m].TOComplete = Moves[i].ToComplete;
         ELSE
            Moves[m].RSIssued = Moves[i].RSIssued;
            Moves[m].RSOperator = Moves[i].RSOperator;
            Moves[m].RSComplete = Moves[i].RSComplete;
         ENDIF;
      ENDIF;
      m = m + 1;
   ENDWHILE;        

   FIELD(Moves[i].Complete_btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Complete_btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Incomplete_btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
    
   IF ReturnFODOrder = TRUE THEN
      IF FodJobList[i].JobStatus = Order$Rejected THEN
         RetCode = CALLPROC IR_FODJobStatusUpd( OrderNumber = OpOrder,
                                             Job = Moves[i].Job, 
                                             TORS = TORS,
                                             JobStatus = Order$ConfirmRejected,
                                             Pending = 0);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Unable to set the job status to ConfirmRejected. ' +
                     HC_NEWLINE +
                     'Contact technical support.  Job = ' +
                     VARCHAR(Moves[i].Job);
         ENDIF;
         /*
         ** if the fod order is unsequenced, return reject acknowledgement to RR
         */
         IF OrderSequence = 'UNSEQUENCED' THEN

            ControlText = VARCHAR(OpOrder) + ';';
            ControlText = ControlText + VARCHAR(Moves[i].Job) + ';'; 
            ControlText = ControlText + VARCHAR(TORS) + ';'; 
            ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
            ControlText = ControlText + AckDO + ';'; 
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_AckFODOrderRejection', 
                     EventText = ControlText);  
         ENDIF;

      ELSEIF FodJobList[i].JobStatus = Order$Rescinded THEN 
         RetCode = CALLPROC IR_FODJobStatusUpd( OrderNumber = OpOrder,
                                             Job = Moves[i].Job, 
                                             TORS = TORS,
                                             JobStatus = Order$ConfirmRescinded,
                                             Pending = 0);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Unable to set the job status to ConfirmRescinded. ' +      
                     HC_NEWLINE +
                     'Contact technical support.  Job = ' +
                     VARCHAR(Moves[i].Job);
         ENDIF;

      ELSE
         /*
         ** Update the job status to Order$ConfirmClosed in the IR_FODOrderJobs table.
         */
         RetCode = CALLPROC IR_FODJobStatusUpd( OrderNumber = OpOrder,
                                             Job = Moves[i].Job, 
                                             TORS = TORS,
                                             JobStatus = Order$ConfirmClosed,
                                             Pending = 0);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;

            /*  Send acknowledgement to RR  */ 
            ControlText = VARCHAR(OpOrder) + ';';
            ControlText = ControlText + varchar(Moves[i].Job) + ';';
            ControlText = ControlText + varchar(TORS) + ';';
            ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
            ControlText = ControlText + AckDO + ';'; 
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_AckFODReturnMove', 
                     EventText = ControlText);  
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Unable to update move status for job from ' +
                     'downloaded order. Job may not show up correctly ' +
                     'on the front of the card.' +  
                     HC_NEWLINE +
                     'Contact technical support.  Job = ' +
                     VARCHAR(Moves[i].Job);
         ENDIF; 
      ENDIF;
/*
** This is where we check if Phase Check was completed.  We need to insert an
** explicit Phase Check move for the equipment in this situation and complete it.
** Only insert move if this is a restore side move.
*/ 
        IF Moves[i].PhaseCheckColor = 1 AND
           TORS = Job$RestoreInt AND
          (Moves[i].StepPair = StepHeading$Deload OR 
           Moves[i].StepPair = StepHeading$Iso) AND
          (CardDetails.Cutout IS NULL OR 
           CardDetails.CutIn IS NOT NULL) THEN   /* was completed */

              CALLPROC InsertPhaseCheck (Card = CardDetails.Card,
                                         Equip = Moves[i].Equip,
                                         EquipName = Moves[i].EquipName,
                                         EquipClass = Moves[i].EquipClass,
                                         EquipClassName = Moves[i].EquipClassName,
                                         PrintID = Moves[i].PrintID,
                                         IssueIt = TRUE,
					 Operator = ReturnOperatorList[1].Object);
        ENDIF;
   ENDIF;

   IF ReturnOpOrder = FALSE AND ManualRescind = FALSE AND 
      ReturnFODOrder = FALSE AND ManualFODRescind = FALSE AND XA21Job = 0 THEN
      Field(Undo_BTN).CurBias = FB_CHANGEABLE;
      UndoRow = i;
   ENDIF;
/*
** Check if Grounded and set color appropriately
*/
   k = 0;
   REPEATED 
   SELECT :k = 1
   FROM   SOA_Job J,
          FMS_ObjectStatus OS
   WHERE  J.Job = :Moves[i].Job AND
          J.GroundOn IS NOT NULL AND
          J.Equip = OS.Object AND
          OS.StatusCount >= 1 AND 
          OS.Status = :Status$Ground;

   IF k = 1 THEN
      FIELD(Moves[i].TOMove).FGColor = CC_RED;
   ELSE
      FIELD(Moves[i].TOMove).FGColor = CC_BLACK;
   ENDIF;
/*
** IF Operator is XA21, want to remove associated XA21 Display Request
*/
   IF Selected.Object = Operator$XA21 THEN
      CALLPROC FMS_SoccsXMessageDel (Job = Moves[i].Job);
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Update move response
*/
   IF ReturnFault = TRUE THEN
      RETURN(PU_OK);
   ENDIF;
   
   IF CurrentApplication = Application$DSO THEN
      Moves[i].ResponseUpd();
      
   ELSEIF CurrentApplication = Application$TFMS AND Moves[i].Status = Job$TakeOut AND
      (Moves[i].Substation = 144060 OR Moves[i].Substation = 144231) THEN
      /*
      ** clear HoldOff number (TFMS card number) from the response column
      */
      Moves[i].Response = Replace(S1 = Moves[i].Response, S2=VARCHAR(Card), S3='');
      Moves[i].ResponseUpd();           
   ENDIF;
  
   SELECT :Moves[i].Response = Response
   FROM   SOA_Job
   WHERE  Job = :Moves[i].Job;
   CurFrame.Flush();
/*
** If incompleting an XA21 issued move, also incomplete any additional moves
*/
   IF XA21Job <> 0 AND i < Moves.LastRow THEN
      i = i + 1;
      IF FIELD(Moves[i].Incomplete_btn).BgCOLOR <> field(Moves[*].ToIssued).BgColor THEN
         CurFrame.SendUserEvent (EventName = 'Incomplete');
      ENDIF;
   ENDIF;
END;

/*
ON CHILDCLICK Moves[*].Conditional_Btn =
BEGIN
   i = field(Moves).CurRow;

   IF i <= 0 THEN
      RESUME;
   ENDIF;

   IF FIELD(Moves[i].Conditional_btn).FgCOLOR <> CC_BLACK THEN
      RESUME;
   ENDIF;

   IF Moves[i].ControlCard <> Moves[i].Card THEN
      Message 'Move not controlled by this card; cannot be modified...';      
      RESUME;
   ENDIF;

   RetCode = CALLFRAME ConditionalMoves (
                   Move = Moves[i]
                ,  Card = Moves[i].Card
                ,  CardSwitchingItem = Moves[i].SwitchingItem
               );   

   IF RetCode = PU_OK THEN
      FIELD(Moves[i].Conditional_btn).FgCOLOR = CC_RED;
      FIELD(Moves[i].Conditional_btn).BgCOLOR =
                 FIELD(Moves[i].Incomplete_btn).BgCOLOR;
      FIELD(Undo_BTN).CurBias = FB_DIMMED;
      UndoRow = 0;
   ENDIF;     
END;
*/

ON CHILDCLICK Moves[*].Phase_Btn =
BEGIN
   i = field(Moves).CurRow;

   IF i <= 0 THEN
      RESUME;
   ENDIF;

   IF FIELD(Moves[i].Phase_btn).FgCOLOR <> CC_BLACK THEN
      RESUME;
   ENDIF;

   IF BreakMove = FALSE AND GroundMove = FALSE THEN
      RESUME;
   ENDIF;

   IF Moves[i].ControlCard <> Moves[i].Card THEN
      Message 'Move not controlled by this card; cannot be modified...';      
      RESUME;
   ENDIF;

   RetCode = CALLFRAME ReturnPhases (PhaseMove = Moves[i],
                                     BreakMove = BreakMove,
                                     GroundMove = GroundMove);

   IF RetCode = PU_OK THEN
      FIELD(Moves[i].Phase_btn).FgCOLOR = CC_RED;
      FIELD(Undo_BTN).CurBias = FB_DIMMED;
      UndoRow = 0;
   ENDIF;     
END;


ON CLICK undo_btn =
BEGIN
   IF UndoRow = 0 THEN
      MESSAGE 'No row is identified for Undo; probable programming error. Tell tech support.';
      RESUME;
   ENDIF;

   IF LastBtnHit = 'complete' THEN
/*
** check if any custom prompt prevents the undo
*/
      RetCode = Moves[UndoRow].IsJobActionReversible(IssueCompl = JobClass$Complete);      
      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;
     
/*
**  Reverse any JobActions that may have taken place at issue time.
**  We will not undo any FMS operatingsteps when undo is selected since
**  we don't know if a step that was completed actually existed.  For
**  TFMS this may be different.
*/
      RetCode = Moves[UndoRow].UndoJobActions(IssueCompl = JobClass$Complete,
                                              NoOperSt = TRUE);
      
      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;

      CALLPROC SOA_LogIns (Card = Card,
                       Job  =  Moves[UndoRow].Job,
                       SwitchingItem  = Moves[UndoRow].SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'UNDO',
                       Old  = VARCHAR(Moves[UndoRow].Status) + ' Completion', 
                       New =  '');
      CALLPROC DDB_COMMIT;

/*
**  Clear complete field for move.
*/
      RetCode = SimpleJob.InCompleteMove(Job = Moves[UndoRow]);
          
      IF RetCode = PU_CANCEL THEN
         Message 'Unable to ''Undo'' Completed move';
         RetCode = Moves[UndoRow].JobActions(IssueCompl = JobClass$Complete);
         IF RetCode = PU_CANCEL THEN
            Message 'JobActions were cleared for move and unable to ' +
                    'be reset.  Please contact technical support.';
            RESUME;
         ENDIF;
      ENDIF;
/*
**  Update response and status fields for job.
*/
      Moves[UndoRow].Response = TempResponse; 
      Moves[UndoRow].ResponseUpd();
      
   ELSEIF LastBtnHit = 'incomplete' THEN
      IF Moves[UndoRow].Status = Job$Takeout THEN
         Complete = TempJob.TOIssued;
      ELSEIF Moves[UndoRow].Status = Job$Restore THEN
         Complete = TempJob.RSIssued;
      ELSE
         message 'Can not determine previous Issue time.';
         RESUME;
      ENDIF;

      RetCode = SimpleJob.IssueMove(Job = Moves[UndoRow],
                                    SetTime = Complete);

      IF RetCode = PU_CANCEL THEN
         message 'Unable to ''Undo'' move Incomplete.  Please try again.';
         RESUME;
      ENDIF;
   
      RetCode = Moves[UndoRow].JobActions(IssueCompl = JobClass$Issue);

      IF RetCode = PU_CANCEL THEN

         RetCode = SimpleJob.CancelIssueMove(Job = Moves[UndoRow]);

         IF RetCode = PU_CANCEL THEN
            Message 'Please update move manually';
         ENDIF;

         RESUME;
      ENDIF;

      CALLPROC SOA_LogIns (Card = Card,
                       Job  =  Moves[UndoRow].Job,
                       SwitchingItem  = Moves[UndoRow].SwitchingItem,
                       UserName = UserName,
                       Time = 'now',
                       Item = 'UNDO',
                       Old  = VARCHAR(Moves[UndoRow].Status) + ' Incompletion', 
                       New =  '');
      CALLPROC DDB_COMMIT;

   ELSE
      message 'Not able to ''Undo'' last action.';
      RESUME;
   ENDIF;
/*
**  Set the pending statuses for this operator
*/
   Moves[UndoRow].SetPendingActions();

/*
**  Loop through moves and update the fields for all occurrences of this job.
*/
   m = 1;
   WHILE m <= Moves.LastRow() DO
      IF Moves[UndoRow].Job = Moves[m].Job AND UndoRow <> m THEN
      /*
      **  Update the complete date on the current move.
      */
         IF Moves[UndoRow].Status = Job$TakeOut THEN
            Moves[m].TOIssued = Moves[UndoRow].TOIssued;
            Moves[m].TOOperator = Moves[UndoRow].TOOperator;
            Moves[m].TOComplete = Moves[UndoRow].TOComplete;
         ELSE
            Moves[m].RSIssued = Moves[UndoRow].RSIssued;
            Moves[m].RSOperator = Moves[UndoRow].RSOperator;
            Moves[m].RSComplete = Moves[UndoRow].RSComplete;
         ENDIF;
      ENDIF;
      m = m + 1;
   ENDWHILE;        

   FIELD(Moves[UndoRow].Incomplete_btn).BgCOLOR = CC_PALE_CYAN;
   FIELD(Moves[UndoRow].Incomplete_btn).FgCOLOR = CC_FOREGROUND;
   FIELD(Moves[UndoRow].Complete_btn).BgCOLOR = CC_PALE_CYAN;
   FIELD(Moves[UndoRow].Complete_btn).FgCOLOR = CC_FOREGROUND;
   FIELD(Moves[UndoRow].Phase_btn).FgCOLOR = CC_PALE_GRAY;
   FIELD(Moves[UndoRow].Conditional_btn).FgCOLOR = CC_PALE_PINK;
   FIELD(Moves[UndoRow].Conditional_btn).BgCOLOR = CC_PALE_PINK;
/*
** Check if Grounded and set color appropriately
*/
   k = 0;
   REPEATED 
   SELECT :k = 1
   FROM   SOA_Job J,
          FMS_ObjectStatus OS
   WHERE  J.Job = :Moves[i].Job AND
          J.GroundOn IS NOT NULL AND
          J.Equip = OS.Object AND
          OS.StatusCount >= 1 AND 
          OS.Status = :Status$Ground;

   IF k = 1 THEN
      FIELD(Moves[UndoRow].TOMove).FGColor = CC_RED;
   ELSE
      FIELD(Moves[UndoRow].TOMove).FGColor = CC_BLACK;
   ENDIF;
/*
** RESET
*/
   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;
   LastBtnHit = '';
   BreakMove = FALSE; 
   GroundMove = FALSE; 
END;


/*
** show equipment details for the current job row.
*/
ON ChildProperties Moves =
BEGIN
   i = FIELD(moves).WhichRow (cellfield = CurFrame.TriggerField);
   IF (i > 0) THEN

      CALLFRAME ShowJobDetails (J = Moves[i]);
   ENDIF;
END;


/*****************************************************
********************* Operator code ******************
******************************************************/
/*
**  Handle an operator selection from the list
*/
ON ChildEntry operatorselection =
BEGIN
   Field(Undo_BTN).CurBias = FB_DIMMED;
   UndoRow = 0;
   LastBtnHit = '';

   FO.Object = operatorselection[].Object;
   FO.Name = operatorselection[].Name;
   FO.Description = operatorselection[].Description;

   Selected.Object = operatorselection[].Object;
   Selected.Name = operatorselection[].Name;
   Selected.Description = operatorselection[].Description;

   ManualFODRescind = FALSE;
   ShowRescindScreen = TRUE;
   
   IF FO.Object = Operator$OpOrder AND ManualOrderToggle = TRUE THEN
   /* How many orders are outstanding? */
      OrderNum = CALLFRAME SelectOrder (Card = Card);
      IF OrderNum = 0 THEN
         MESSAGE 'The new temporary Manual Order logic is not working for this card.  Will need to be adjusted.  Report problem by phone.';
      ELSE
         OpOrder = OrderNum;
         Curframe.SendUserEvent(EventName = 'LoadOpOrderJobs');
      ENDIF; 
   ELSE
      Curframe.SendUserEvent(EventName = 'LoadJobs');
   ENDIF;
END;

/*
**  Handle an operator selection by operator number
*/
ON SetValue Selected.Name =
BEGIN
/*
**  Pick out everyone on the list with a similar "ctrl number"
*/
   TempChar  = Trim(Lowercase(Selected.Name)) + '%';
   Selected.Description  = '';
   Selected.Object = -1;
   ReducedList.Clear();

   Row = 0;
   i = 1;
   WHILE i <= ReturnOperatorList.LastRow() DO
      IF (Lowercase(ReturnOperatorList[i].Name) LIKE TempChar) THEN
         Row = Row + 1;
         ReducedList[Row] = ReturnOperatorList[i];
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      operatorselection = ReducedList;
   ENDIF;
/*
**  If there is only one in the list, make it the default and load the jobs
*/
   IF (Row = 1) THEN
      Selected.Object  = operatorselection[1].Object;
      Selected.Name = operatorselection[1].Name;
      Selected.Description  = operatorselection[1].Description;

      Curframe.SendUserEvent(EventName = 'LoadJobs');
   ENDIF;
END;
/*
**  Handle operator selection by partial name
*/
ON SetValue Selected.Description,
ON CLICK Find_Btn  =
BEGIN
/*
**  Pick out everyone on the list with a similar name
*/
   TempChar = Trim(Lowercase(Selected.Description)) + '%';
   Selected.Name  = '';
   Selected.Object = -1;
   ReducedList.Clear();
   Row = 0;
        
   i = 1;
   WHILE i <= ReturnOperatorList.LastRow() DO
      IF (Lowercase(ReturnOperatorList[i].Description) LIKE TempChar) THEN
         Row = Row + 1;
         ReducedList[Row] = ReturnOperatorList[i];
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      operatorselection = ReducedList;
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   IF (Row = 1) THEN
      Selected.Object  = operatorselection[1].Object;
      Selected.Name = operatorselection[1].Name;
      Selected.Description  = operatorselection[1].Description;
      Curframe.SendUserEvent(EventName = 'LoadJobs');
   ENDIF;
END;

ON CLICK Menu.File.Close_btn,
ON CLICK OK_Btn =
BEGIN
/*
** If we force rescind a job of a sequenced order, all jobs in that order
** has to be rescinded.
*/
   IF ManualFODRescind = TRUE THEN
      FOR i = 1 TO Moves.LastRow() DO
         IF FIELD(Moves[i].Complete_btn).BGColor = CC_PALE_CYAN OR 
            FIELD(Moves[i].InComplete_btn).BGColor = CC_PALE_CYAN THEN
            ENDLOOP;
         ENDIF;
      ENDFOR;

      IF i <= Moves.LastRow() THEN     
         IF Moves[i].Status = Job$Restore THEN
            TORS = 1;
         ELSE
            TORS = 0;
         ENDIF;

         k = 0;
         SELECT :k = 1
         FROM   IR_FODOrderJobs OJ, 
                IR_FODOrder O
         WHERE  OJ.Job = :Moves[i].Job AND
                OJ.TORS = :TORS AND
                OJ.JobStatus <:Order$Closed AND
                OJ.OrderNumber = O.OrderNumber AND
                O.SequenceType = 'SEQUENCED';
         CALLPROC DDB_ROLLBACK;
       
         IF k = 1 AND TooQuick = FALSE THEN
            MESSAGE 'You may not exit without rescinding all ' + OrderTarget + ' Order moves.';
            RESUME;
         ENDIF;
      ENDIF;     
/*
** If we are Returning an Op Order and everything is not done, prevent the
** close.
*/
   ELSEIF (ReturnOpOrder = TRUE OR ManualRescind = TRUE) OR 
          (ReturnFODOrder = TRUE AND TooQuick = FALSE) OR 
          (OpOrder <> 0 AND ManualOrderToggle = TRUE) THEN
          
      FOR i = 1 TO Moves.LastRow() DO
         IF FIELD(Moves[i].Complete_btn).BGColor = CC_PALE_CYAN OR 
              FIELD(Moves[i].InComplete_btn).BGColor = CC_PALE_CYAN THEN
            /* If this is the special Manual condition, don't want to block exit unless move return has started*/               
            IF (OpOrder <> 0 AND ManualOrderToggle = TRUE AND ManualReturnStarted = FALSE) THEN  
               RETURN PU_OK;
            ENDIF;
  
            MESSAGE 'You may not exit without confirming all Operating ' +
                    'Order moves as Complete or Incomplete.';
            RESUME;
         ENDIF;
      ENDFOR;
/*
**  Set Operating Order Status = Order$ConfirmClosed.
*/
      IF ReturnOpOrder = TRUE OR (OPOrder <> 0 AND ManualOrderToggle = TRUE) THEN
         CALLPROC UpdateOpOrderStatus();

         IF OrderStatus = Order$Closed AND
            CurrentApplication = Application$FMS THEN
            /*
            ** if FOT was delayed when processing a failed test, Create the FOT card here
            */
            IF OrderReturnStatus.DelayFOT = TRUE THEN
               IF (Curframe.ConfirmPopup(messagetext = 'Transfer to FOT was delayed until ' +
                   'all returned moves were confirmed. Continue to create an FOT card?') = PU_OK) THEN
                  CALLPROC CreateDelayedFOTCard();
               ENDIF;
            ENDIF;
            OrderReturnStatus = NULL;
         ENDIF;         
      ENDIF;

/*
** if the FOD order is sequenced and any move was rejected,
** send an acknowledgement to RR. Note: send jobid = 0 to
** the FOD monitor.
*/
      IF ReturnFODOrder = TRUE AND
         OrderSequence = 'SEQUENCED' THEN 
 
         IF FodJobList[1].JobStatus = Order$Rejected THEN
           ControlText = VARCHAR(OpOrder) + ';';
           ControlText = ControlText + '0;';           /* JOB ID */
           ControlText = ControlText + '0;';           /* TORS */
           ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
           ControlText = ControlText + AckDO + ';'; 
           CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_AckFODOrderRejection', 
                     EventText = ControlText);  
         ENDIF;
      ENDIF;
   ENDIF;
   
   PhaseTerminal = 0;

   IF Moves.LastRow > 0 THEN
      DOp.CheckActivity(Move = Moves[1].Duplicate());
   ENDIF;
   
   RETURN PU_OK;
END;

