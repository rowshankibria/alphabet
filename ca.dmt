METHOD LoadUserPreference (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   CurObject.Setting = '';

   SELECT :CurObject.Setting = Setting
   FROM   FMS_UserSetting
   WHERE  UserName = :CurObject.UserName AND
          Function = :CurObject.Function;

   CALLPROC DDB_ROLLBACK;
END;

METHOD SaveUserPreference (
)=
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   RetCode = CALLPROC FMS_UserSettingIns(
                          UserName = CurObject.UserName,
                          Function = CurObject.Function,
                          Setting = CurObject.Setting);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to update to the database';   
      CurMethod.Trace(Text=VARCHAR('NOW') + ': UserPreference.SaveUserPreference; Failed to save to the database'); 
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

