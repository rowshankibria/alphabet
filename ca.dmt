*/
METHOD DeleteAttachment (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
  
   SELECT :FileName = FileName
   FROM   SOA_ISPAttachment 
   WHERE  ISPermit = :CurObject.ISPermit AND
          FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;

   RetCode = CALLPROC SOA_ISPAttachmentDel (
           ISPermit = CurObject.ISPermit,
           FileID = CurObject.FileID
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'ISPAttachment.DeleteAttachment; Error deleting ISWP Request attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPAttachment.DeleteAttachment; ' + 
                'Error deleting ISWP Request attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;

    RETURN;
END;

METHOD InsertAttachment (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SaveDate = DATE NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 0;
   SELECT :i = IFNULL(max(FileID), 0)
   FROM   SOA_ISPAttachment
   WHERE  ISPermit = :CurObject.ISPermit;

   CurObject.FileID = i + 1;

   RetCode = CALLPROC SOA_ISPAttachmentIns(
           ISPermit = CurObject.ISPermit,
           FileID = CurObject.FileID,
           FileName = VARCHAR(CurObject.ISPermit) + '_' + SQUEEZE(CurObject.FileName)
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'ISPAttachment.InsertAttachment; Error inserting ISWP Request attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPAttachment.InsertAttachment; ' + 
                'Error inserting ISWP Request attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    SaveDate = DATE('NOW');
    UpdateSql = ' UPDATE SOA_ISPBinaryFile SET DataStream ' + 
                ' WHERE  ISPermit = ' + VARCHAR(CurObject.ISPermit) + 
                ' AND   FileID = ' + VARCHAR(CurObject.FileID);

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;

/*
** make it ddb compliant again.
*/
//    CurMethod.DBSession = DDB_Global.Session.Cur;
    
    IF DBSession1Status = -1 AND DBSession2Status = -1 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'ISPAttachment.InsertAttachment; Error saving file binary in database.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : ISPAttachment.InsertAttachment; Error saving file binary in database.');
       RetCode = CALLPROC SOA_ISPAttachmentDel(
                              ISPermit = CurObject.ISPermit,
                              FileID = CurObject.FileID);
       CALLPROC DDB_COMMIT;
       RETURN;
    ELSEIF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       CurObject.DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       CurObject.DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       CurObject.DBServer = 2;

    ELSE
       CurObject.DBServer = -1;
    ENDIF;

    RETURN;
END;

METHOD GetBinaryStream (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SelectSql  = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.DBServer = DBServer,
          :CurObject.FileName = FileName
   FROM   SOA_ISPAttachment 
   WHERE  ISPermit = :CurObject.ISPermit AND
          FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;
/*
** Read binary data from the database
*/
   SelectSql = 'SELECT DataStream FROM SOA_ISPBinaryFile WHERE ' + 
               'ISPermit = ' + VARCHAR(CurObject.ISPermit) + ' AND ' +
               'FileID = ' + VARCHAR(CurObject.FileID);

   IF CurObject.DBServer = 0 THEN
      CurMethod.DBSession = DDB_Global.Session.Cur;
 
   ELSEIF CurObject.DBServer = 1 AND DDB_Global.Session.One.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.One;

   ELSEIF CurObject.DBServer = 2 AND DDB_Global.Session.Two.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.Two;

   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPAttachment.GetBinaryStream; Attachment data not found in the connected database';
      RETURN;
   ENDIF;

   If CurObject.BinaryStream.FetchFromDB(Query = SelectSql) <> ER_OK THEN
      CurMethod.Trace(Text= varchar(date('now')) + ': failed to read binary from db for ISWP file ' + CurObject.FileName);
   ENDIF;
   ROLLBACK;
END;

