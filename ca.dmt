	Name:            TransformerGroundSearch

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    SOA
**  Frame:          TransformerGroundSearch
**
**  Date:       Author   Description
** ----------------------------------
**  06/12/00    em       Search for grounds on all sides of a Transformer.
**                       Used when high potting a transformer.
**  02/28/17    ysp      Converted to use QGis-based trace Trace_TransformerGrounds
**  07/25/17    em       Spelling error correction
*/
PROCEDURE TransformerGroundSearch
(
    JIP = JobInProgress;   /*Passed Job*/				         
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   RetCode = INTEGER;
   CardObjectList   = ARRAY OF INTEGEROBJECT;
   EquipGrounded  = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   TraceStatus  = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_TransformerGrounds;
ENDDECLARE
BEGIN
   i = 1;
   SELECT  :CardObjectList[i].Value = Object
   FROM    SOA_ActiveObject
   WHERE   Card = :JIP.Card
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
    
/*
** start search with this piece of equipment and then branch out in all
** directions. Each path must have one ground.
*/
   Trace.JCEquip.Object = JIP.Equip;
   Trace.CardScopeList = CardObjectList;
   TraceStatus = Trace.StartTargetTrace();
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
   IF TraceStatus = TraceStatus$Isolated THEN
      RETURN (PU_OK);
   ENDIF;

/*
** Did we find a ground on each terminal?
*/
   FOR i = 1 TO Trace.PathResultList.LastRow DO
      IF Trace.PathResultList[i].SpareInteger = FALSE THEN
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                       Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem, 
                   Text = 'Could not find Ground on each path connecting to ' +
                          'transformer ' + JIP.EquipClassName + '  ' +
                          JIP.EquipName + '.');       

          IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RETURN(Warning$Overridden);
          ENDIF;
      ENDIF;
   ENDFOR;   

   RETURN(PU_OK);
END;


