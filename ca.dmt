   RetCode = CALLPROC SOA_IssueISP(
                      ISPermit = CurObject.ISPermit, 
                      TOOperator = CurObject.TOOperator, 
                      TOOperatorName = CurObject.TOOperatorName, 
                      TOIssued = CurObject.TOIssued, 
                      Note = CurObject.Note);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPJob.IssueMove; Error in issuing In Service Permit';
      CurMethod.Trace(Text = varchar(date('now')) + ':ISPJob.IssueMove. ERROR: Unable to issue In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

END;

