Application Component Report
============================

	Name:            ConfirmCardDetails


Include Script
--------------------------
/*
** ConfirmCardDetails Include Script
** 03/30/11 em  Created
** 08/24/16 ysp Include Fed By Segments in and exclude Segments Fed By another from CardDetails.Object list 
** 09/07/16 pkw added type for 33kv feeders
**
** Initialize CardDetails if running TOMS or if it has no data
*/
   IF CurrentApplication <> Application$FMS OR CardDetails.Card = 0 OR
      CardDetails.Feeder = 0 THEN
   
      CardDetails.Feeder = 0;
      SELECT 
      DISTINCT  :CardDetails.Feeder = C.Feeder,
                :CardDetails.FeederName = C.FeederName,
                :CardDetails.Card = C.Card,
                :CardDetails.NetworkFeeder = C.NetworkFeeder
      FROM      SOA_JobControl JC,
                SOA_ActiveCard AC,
                FMS_Card C
      WHERE     JC.Job = :JIP.Job AND
                JC.Card = C.Card AND
                JC.Card = AC.Card;
   
      IF CardDetails.Feeder = 0 THEN     /*OK for 3G since 3G Feeder = -1*/
         RETURN (NULL);
      ENDIF;
   
      IF CardDetails.NetworkFeeder > 0 THEN
         i = 1;
         SELECT :CardDetails.Object[i].Object = CTO.Object,
                :CardDetails.Object[i].Type = CTO.Type,
                :CardDetails.Object[i].Name = CTO.Name
         FROM   TFMS_CardToObject CTO,
                Udb_Object O
         WHERE  CTO.Card = :CardDetails.Card AND
                CTO.Object = O.Object
         BEGIN
/*
** Still need to include fed by segments and exclude segments fed by another feeder
*/
            IF CardDetails.NetworkFeeder = NetworkFeeder$33kV THEN
               FedBy = 0;   // need to declare this variable
               SELECT :FedBy = Grouping
               FROM   Udb_Grouping
               WHERE  Member = :CardDetails.Object[i].Object AND
                      Relationship = :Interaction$FedBy;
               IF FedBy > 0 THEN
                  CardDetails.Object.RemoveRow (rownumber = i);
               ELSE
                  i = i + 1;
                  REPEATED 
                  SELECT DISTINCT
                         :CardDetails.Object[i].Object = O.Object,
                         :CardDetails.Object[i].Name = O.Name,
                         :CardDetails.Object[i].Type = O.Type,
                         :CardDetails.Object[i].TypeName = O.TypeName
                  FROM   Udb_Grouping G,
                         Udb_Object O
                  WHERE  G.Grouping = :CardDetails.Object[i-1].Object AND
                         G.Relationship = :Interaction$FedBy AND
                         G.Member = O.Object
                  BEGIN
                     i = i + 1;
                  END;
               ENDIF;          
            ELSE
               i = i + 1;
            ENDIF;
         END;
      ELSE
         CardDetails.Object[1].Object = CardDetails.Feeder;
         CardDetails.Object[1].Type = Type$Feeder;
         CardDetails.Object[1].Name = CardDetails.FeederName;
      ENDIF;
   ENDIF;

