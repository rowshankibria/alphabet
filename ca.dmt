**  02/20/19    pkw   Always explode RFP because sometime they hit return alot and they may only
**                    have 50 characters but 5 lines
*/
INITIALIZE   
(
    Card	= FMS_Card;                       /*Parameter*/
    EffectiveDivisions = ARRAY OF ObjectSummaryClass; /*Passed, pass through*/
    LocalDivisions = ARRAY OF ObjectSummaryClass; /*Passed, pass through*/
    CurFrameMode = INTEGER NOT NULL WITH DEFAULT; /*Passed, pass through*/
    ArchiveCard  = INTEGER NOT NULL WITH DEFAULT; /*Passed, pass through*/
    ParentFrame = FRAMEEXEC;              /*Only when called from ReviewRFPs */

/* local variables */
#   include StandardDeclarations
    j = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
    k = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */

    BaseFeeder = INTEGER NOT NULL;
    BaseFeederType = INTEGER NOT NULL;
    TempFeeder = INTEGER NOT NULL;
    
    CardFeeder = INTEGER NOT NULL;                          /*Pool RFP Feeder*/
    Linked_Permit = Job;                                    /*Permit Location*/
    OutstandingPermit = INTEGER NOT NULL WITH DEFAULT;      /*BOOLEAN*/
    LocationIndex = INTEGER NOT NULL;                       /*Selected Loc*/ 
    RFPCard = INTEGER NOT NULL WITH DEFAULT;                /* card linked to RFP */
    RFPFeederName = VARCHAR(40) NOT NULL WITH DEFAULT;      /* Pool RFP Feeder name */
    RFPIndex	= INTEGER NOT NULL;                         /*Loaded RFP Index*/ 
    ResponseType = VARCHAR(40) NOT NULL;                    /*Type of Ack*/                      
    WPLocation  = INTEGER NOT NULL;                         /*Location ID*/
    FCRJobs	= ARRAY OF Job;                             /*Return from New Moves*/
    FCRPermit   = INTEGER NOT NULL;                         /*New Permit ID*/
    WorkLocationTags = ARRAY OF IR_WorkLocationTag;         /*Location Tags*/
    ReqFP       = INTEGER NOT NULL;                         /*Loc RFP*/
    ReqFPLocation = INTEGER NOT NULL;                         /*Loc RFP*/
    TagExists   = INTEGER NOT NULL WITH DEFAULT;            /*BOOLEAN*/

    RevisionOnFlag = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
    RevisionUpdateError = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
    RevisionComment = VARCHAR(1500) NOT NULL WITH DEFAULT; /* For FCR */
    RevisionDate = DATE NOT NULL;                /* Single Revision Date */
    RevisionPermit = INTEGER NOT NULL;           /* Permit being revised */
    RevisionNumber = INTEGER NOT NULL;           /* Permit Rev # */
    RevisedPermitStatus = INTEGER NOT NULL;      /* Downloaded or not */
    TempRevComment = VARCHAR(700) NOT NULL WITH DEFAULT; /*For include script */
    TempString = VARCHAR(40) NOT NULL;                                   
 
    LinkedWPLoc = ARRAY OF IR_WorkLocation; /*Work Locs linked to RFP Loc*/
    RFPHistoryFrame = FRAMEEXEC;    /*History Frame*/
    PermitAck = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN*/
    LinkedRFP = INTEGER NOT NULL WITH DEFAULT; /* Link Confirmed RFP */

    Structures = ARRAY OF IR_RFPLocation;      /* For Common Manhole Comparison */
    StructNumeric = VARCHAR(20) NOT NULL WITH DEFAULT; /*Numeric component of Structure name*/
    Manholes = ARRAY OF CommonManhole;        /* Manholes associated to card feeder */
) =
DECLARE
   ExtractRFPLocNumber  = PROCEDURE RETURNING VARCHAR(20);
ENDDECLARE
BEGIN
   IF ArchiveCard = TRUE THEN
      CurFrame.CurMode = FM_READ;
   ELSE
      CurFrame.CurMode = CurFrameMode;
   ENDIF;

   CurFrame.WindowVisibility = WV_INVISIBLE;
   CurFrame.PurgeDBEvent (DBEventName = 'IR_LinkConfirmed');
/*
** Load RFP list in reverse timestamp order.
** If card feeder is not the main feeder, but a sub feeder or ISO, etc.
** then get and use the main feeder.
*/
   CardFeeder = Card.Feeder;
   RFPCard = Card.Card;
   RFPFeederName = Card.FeederName;

   i = 0;
   SELECT  :i = Object
   FROM    Udb_Object 
   WHERE   Type = :Type$Feeder AND
           Object = :Card.Feeder;

   IF i = 0 THEN
      IF Card.NetworkFeeder = NetworkFeeder$3G THEN                 /*3G Card*/ 
         CardFeeder = -1;

      ELSEIF Card.NetworkFeeder = NetworkFeeder$33KV AND Card.TypeOfCard = TypeOfCard$Portion THEN
         SELECT :RFPCard = C.Card,
                :CardFeeder = C.Feeder,
                :RFPFeederName = C.FeederName
         FROM   FMS_PortionLink L,
                FMS_Card C
         WHERE  L.PortionCard = :Card.Card AND
                L.Card = C.Card;
                         
      ELSE /* Not the Main Feeder, it is a sub feeder or ISO */
         TempFeeder = Card.Feeder;
         
         WHILE TempFeeder <> 0 DO
            BaseFeeder = 0;
            BaseFeederType = 0;

            SELECT  :BaseFeeder = Grouping,
                    :BaseFeederType = GroupingType
            FROM    Udb_Grouping
            WHERE   Relationship = :Interaction$MemberOf AND
                    Member = :TempFeeder AND
                    GroupingType IN (SELECT Type 
                                     FROM   Udb_ExtendedType
                                     WHERE  SuperType = :Type$Feeder);

            IF BaseFeederType = Type$Feeder THEN
               TempFeeder = 0;
            ELSE
               TempFeeder = BaseFeeder;
            ENDIF;
         ENDWHILE;

         IF BaseFeeder = 0 THEN
            MESSAGE 'Error: Card Feeder ' + VARCHAR(Card.Feeder) + ' could not ' +
                 'be mapped to a regular feeder.  Cannot use this feeder to ' +
                 'find related RFPs.';
            RETURN;
         ELSE
            CardFeeder = BaseFeeder;
         ENDIF;
      ENDIF;
   ENDIF;

   ResponseType = '';
   RFPIndex = 0;
   LocationIndex = 0;
   FCRPermit = 0;
   RevisionOnFlag = FALSE;
   i = 1;
   RFP.Clear();
   SELECT :RFP[i].Card = Card
         ,:RFP[i].RequestForPermit = RequestForPermit
         ,:RFP[i].RFP = RFP
         ,:RFP[i].RevisionNumber = RevisionNumber
         ,:RFP[i].RevisionChar = VARCHAR(RequestForPermit) +
                                 '.' + VARCHAR(RevisionNumber)
         ,:RFP[i].RevisionComment = RevisionComment
         ,:RFP[i].FCRName = FCRName
         ,:RFP[i].TimeStamp = TimeStamp
         ,:RFP[i].OutageType = OutageType
         ,:RFP[i].Objective = Objective
         ,:RFP[i].AcknowledgedByDO = AcknowledgedByDO
         ,:RFP[i].ManualInsertByDO = ManualInsertByDO
         ,:RFP[i].RejectedByDO = RejectedByDO
         ,:RFP[i].RevisionRequestedByDO = RevisionRequestedByDO
         ,:RFP[i].DOComment = DOComment
         ,:RFP[i].LinkedByDO = LinkedByDO
   FROM   IR_RequestForPermit
   WHERE  (Card = :RFPCard OR
           (Card = 0 AND
            Feeder = :CardFeeder) OR
           (Card = 0 AND
            Feeder IN (SELECT Object FROM TFMS_CardToObject
                       WHERE  Card = :RFPCard))
          ) AND
          RFPStatus = 0 AND           /*Current RFPs Only*/
          RejectedByDO = 0              /*Has not been Rejected*/
   ORDER BY TimeStamp DESC
   BEGIN
      IF RFP[i].Card = 0 THEN
         RFP[i].RevisionChar = RFP[i].OutageType;
         RFP[i].LinkedBy = '';
      ELSE
         IF RFP[i].LinkedByDO = 0 THEN
            RFP[i].LinkedBy = 'FCR';
         ELSE
	    RFP[i].LinkedBy = 'D.O.';
         ENDIF;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF i = 1 THEN
      MESSAGE 'There are no Requests For Permit associated with this card ' +
              'or feeder.';
      RETURN;
   ENDIF; 
   
   FIELD(Change_btn).CurBias = FB_INVISIBLE;
   FIELD(Reject_btn).CurBias = FB_INVISIBLE;
   FIELD(Ack_btn).CurBias = FB_INVISIBLE;
   FIELD(RevRequest).CurBias = FB_INVISIBLE;
   FIELD(Link_btn).CurBias = FB_INVISIBLE;
   FIELD(Unlink_btn).CurBias = FB_INVISIBLE;

   CurFrame.SendUserEvent (EventName = 'LoadFCRPermits');
   CurFrame.SendUserEvent (EventName = 'MakeVisible');
END;


ON USEREVENT 'LoadFCRPermits' =
BEGIN
   i = 1;
   FCR_Permits.Clear();
   IF ArchiveCard = FALSE THEN
      REPEATED
      SELECT :FCR_Permits[i].Job = J.Job
         ,:FCR_Permits[i].Card = JC.Card
         ,:FCR_Permits[i].JobClass = J.JobClass
         ,:FCR_Permits[i].MoveEquipClass = JC.MoveEquipClass
         ,:FCR_Permits[i].StepPair = JC.StepPair
         ,:FCR_Permits[i].TOIssued = J.TOIssued
         ,:FCR_Permits[i].Seq = JC.Seq                 /*Used for WPLocation*/
         ,:FCR_Permits[i].BaseKey = :FALSE         /*Used to indicate Link*/
         ,:FCR_Permits[i].RSComplete = J.RSComplete
         ,:FCR_Permits[i].TOMove = J.TOMove
         ,:FCR_Permits[i].RSMove = J.RSMove
         ,:FCR_Permits[i].PrintID = JC.PrintID
         ,:FCR_Permits[i].EquipClassName = J.EquipClassName
         ,:FCR_Permits[i].EquipName = J.EquipName
      FROM   SOA_Job J,
             SOA_JobControl JC,
             FMS_JobAction JA
      WHERE  JC.Card = :Card.Card AND
             JC.Job = J.Job AND
             JC.StepPair = :StepHeading$OTW AND
             J.JobClass = JA.JobClass AND
             J.Status = '' AND
             JC.MoveEquipClass = JA.EquipClass AND
             JC.StepPair = JA.StepPair AND
             JA.TypeOfCard = :Card.TypeOfCard AND
            (JA.Status = :Prompt$FromWorkFCR OR
             JA.Status = :Prompt$FromWorkFCRNoFGO) 
      ORDER  BY Seq
      BEGIN
/*
** IF Location Selected, mark any linked locations.
*/
         FCR_Permits[i].Seq = 0;
         IF LocationIndex <> 0 THEN
            SELECT :FCR_Permits[i].Seq = WPLocation                 
                  ,:FCR_Permits[i].BaseKey = :TRUE
            FROM   IR_WorkLocation
            WHERE  WorkPermit = :FCR_Permits[i].Job AND
                   RFP = :RFP[RFPIndex].RFP AND
                   RequestForPermit = :RFP[RFPIndex].RequestForPermit AND 
                   RFPLocation = :RFPLocation[LocationIndex].RFPLocation;
         ENDIF; 
         i = i + 1;
      END;
   ELSE
      REPEATED
      SELECT :FCR_Permits[i].Job = J.Job
         ,:FCR_Permits[i].Card = J.Card
         ,:FCR_Permits[i].JobClass = J.JobClass
         ,:FCR_Permits[i].MoveEquipClass = J.MoveEquipClass
         ,:FCR_Permits[i].StepPair = J.StepPair
         ,:FCR_Permits[i].TOIssued = J.TOIssued
         ,:FCR_Permits[i].Seq = 0                 /*Used for WPLocation*/
         ,:FCR_Permits[i].BaseKey = :FALSE         /*Used to indicate Link*/
         ,:FCR_Permits[i].RSComplete = J.RSComplete
         ,:FCR_Permits[i].TOMove = J.TOMove
         ,:FCR_Permits[i].RSMove = J.RSMove
         ,:FCR_Permits[i].PrintID = J.PrintID
         ,:FCR_Permits[i].EquipClassName = J.EquipClassName
         ,:FCR_Permits[i].EquipName = J.EquipName
      FROM   FMS_ArchiveJob J,
             FMS_JobAction JA
      WHERE  J.Card = :Card.Card AND
             J.StepPair = :StepHeading$OTW AND
             J.JobClass = JA.JobClass AND
             J.Status = '' AND
             J.MoveEquipClass = JA.EquipClass AND
             J.StepPair = JA.StepPair AND
             JA.TypeOfCard = :Card.TypeOfCard AND
            (JA.Status = :Prompt$FromWorkFCR OR
             JA.Status = :Prompt$FromWorkFCRNoFGO) 
      ORDER  BY RSComplete, TOIssued
      BEGIN
/*
** IF Location Selected, mark any linked locations.
*/
         IF LocationIndex <> 0 THEN
            SELECT :FCR_Permits[i].Seq = WPLocation                 
                  ,:FCR_Permits[i].BaseKey = :TRUE
            FROM   IR_WorkLocation
            WHERE  WorkPermit = :FCR_Permits[i].Job AND
                   RFP = :RFP[RFPIndex].RFP AND
                   RequestForPermit = :RFP[RFPIndex].RequestForPermit AND 
                   RFPLocation = :RFPLocation[LocationIndex].RFPLocation;
         ENDIF; 
         i = i + 1;
      END;   
   ENDIF;
END;


ON USEREVENT 'MakeVisible' =
BEGIN
   CurFrame.WindowVisibility = WV_VISIBLE;
   IF ParentFrame IS NOT NULL THEN
      ParentFrame.SendUserEvent (EventName = 'BringToFront');
   ENDIF;
END;


ON CHILDENTRY RFP =
BEGIN 
/*
** Load specific RFP, adjust button availability appropriately
*/
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   i = 0;
   i = FIELD(RFP).CurRow;
   IF i = 0 THEN 
      MESSAGE 'No RFP selected.';
      RESUME;
   ENDIF;

   FOR j = 1 TO RFP.LastRow() DO
      IF j = i THEN
         FIELD(RFP[j].FCRName).IsReverse = TRUE;
         FIELD(RFP[j].Timestamp).IsReverse = TRUE;
         FIELD(RFP[j].Objective).IsReverse = TRUE;
         FIELD(RFP[j].AcknowledgedByDO).IsReverse = FALSE;
         FIELD(RFP[j].RevisionChar).IsReverse = FALSE;
      ELSE
 
         FIELD(RFP[j].FCRName).IsReverse = FALSE;
         FIELD(RFP[j].Timestamp).IsReverse = FALSE;
         FIELD(RFP[j].Objective).IsReverse = FALSE;
         FIELD(RFP[j].AcknowledgedByDO).IsReverse = FALSE;
         FIELD(RFP[j].RevisionChar).IsReverse = FALSE;
      ENDIF;
   ENDFOR; 

   IF lowercase(CurFrame.TriggerField.Name) = 'objective' THEN
      nt_sf.note_text = rfp[i].Objective;
      /*
      **  Position Stack field
      */
      FIELD(nt_sf).CurBias = FB_CHANGEABLE;
      Field(nt_sf).AbsXRight = FormField(CurFrame.TriggerField).AbsXRight + 10;
      Field(nt_sf).AbsYBottom = FormField(CurFrame.TriggerField).ParentField.AbsYBottom;
      CurFrame.Flush();   
   ELSE
      FIELD(nt_sf).CurBias = FB_INVISIBLE;
   ENDIF;

   FOR j = 1 TO FCR_Permits.LastRow() DO
       FCR_Permits[j].BaseKey = FALSE;
       FCR_Permits[j].Seq = 0;
   ENDFOR;
/*
** Don't show Ack btn if RFP is pending.
*/
   IF ArchiveCard <> TRUE AND CurFrameMode <> FM_READ THEN

      IF RFP[i].AcknowledgedByDO = TRUE OR RFP[i].Card = 0 THEN
         FIELD(Ack_btn).CurBias = FB_INVISIBLE;
      ELSE
         FIELD(Ack_btn).CurBias = FB_LANDABLE;
      ENDIF;   

      IF CurFrame.CurMode <> FM_USER1 THEN
         FIELD(Change_btn).CurBias = FB_LANDABLE;
      ENDIF;
      IF RFP[i].ManualInsertByDO = TRUE THEN
         FIELD(Ack_btn).CurBias = FB_INVISIBLE;
         FIELD(Change_btn).CurBias = FB_INVISIBLE;
      ENDIF;      

      IF RFP[i].RevisionNumber > 0 THEN
         FIELD(FCRRevision).CurBias = FB_LANDABLE;
         FCRRevision.RevisionComment = RFP[i].RevisionComment;
      ELSE
         FIELD(FCRRevision).CurBias = FB_INVISIBLE;
      ENDIF;

      IF RFP[i].RevisionRequestedByDO = TRUE THEN
         FIELD(RevRequest).CurBias = FB_LANDABLE;
         FIELD(FCRRevision).CurBias = FB_INVISIBLE;
         RevRequest.DOComment = RFP[i].DOComment;
      ELSE
         FIELD(RevRequest).CurBias = FB_INVISIBLE;
      ENDIF;
   ENDIF;
/*
** If Work Permit linked to an RFP Location has been issued, then
** RFP cannot be Rejected.
*/
   OutstandingPermit = FALSE;
/* 
** the code here is replaced to support 33kv cards. 9/13/16
**
   IF ArchiveCard = FALSE THEN
      REPEATED
      SELECT :OutstandingPermit = :TRUE
      FROM   IR_WorkLocation WL,
             SOA_Job J,
             SOA_JobControl JC
      WHERE  WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.RFP = :RFP[i].RFP AND
             WL.WorkPermit = J.Job AND
             J.TOIssued IS NOT NULL AND
             J.Job = JC.Job AND
             JC.Card = :Card.Card;
   ELSE
      REPEATED
      SELECT :OutstandingPermit = :TRUE
      FROM   IR_WorkLocation WL,
             FMS_ArchiveJob J
      WHERE  WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.RFP = :RFP[i].RFP AND
             WL.WorkPermit = J.Job AND
             J.TOIssued IS NOT NULL AND
             J.Card = :Card.Card;
   ENDIF;
obsolete */

   IF ArchiveCard = FALSE THEN
      REPEATED
      SELECT :OutstandingPermit = :TRUE
      FROM   IR_WorkLocation WL,
             SOA_Job J
      WHERE  WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.RFP = :RFP[i].RFP AND
             WL.WorkPermit = J.Job AND
             J.TOIssued IS NOT NULL;
   ELSE
      REPEATED
      SELECT :OutstandingPermit = :TRUE
      FROM   IR_WorkLocation WL,
             FMS_ArchiveJob J
      WHERE  WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.RFP = :RFP[i].RFP AND
             WL.WorkPermit = J.Job AND
             J.TOIssued IS NOT NULL;
   ENDIF;

   IF OutstandingPermit = TRUE THEN
      FIELD(Reject_btn).CurBias = FB_INVISIBLE;
   ELSEIF CurFrame.CurMode <> FM_READ THEN
      FIELD(Reject_btn).CurBias = FB_LANDABLE;
   ENDIF;
/*
** IF RFP is a scheduled pending RFP not linked to the card, enable the Link 
** button.
*/
   IF RFP[i].Card = 0 AND CurFrame.CurMode <> FM_READ THEN
      FIELD(Link_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(Link_Btn).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** If RFP locations are not linked to a Work Permit, enable the unlink button.
*/
/*
** the code here is replaced to support 33kv cards. 9/13/16 
   IF ArchiveCard = FALSE THEN
      j = 0;
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             SOA_Job J,
             SOA_JobControl JC
      WHERE  WL.RFP = :RFP[i].RFP AND
             WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.WorkPermit = J.Job AND
             J.Job = JC.Job AND
             JC.Card = :Card.Card;
   ELSE
      j = 0;
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             FMS_ArchiveJob J
      WHERE  WL.RFP = :RFP[i].RFP AND
             WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.WorkPermit = J.Job AND
             J.Card = :Card.Card;    
   ENDIF;
obsolete */

   IF ArchiveCard = FALSE THEN
      j = 0;
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             SOA_Job J
      WHERE  WL.RFP = :RFP[i].RFP AND
             WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.WorkPermit = J.Job;
   ELSE
      j = 0;
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             FMS_ArchiveJob J
      WHERE  WL.RFP = :RFP[i].RFP AND
             WL.RequestForPermit = :RFP[i].RequestForPermit AND
             WL.WorkPermit = J.Job;    
   ENDIF;

   IF j = 0 AND RFP[i].Card <> 0 AND CurFrame.CurMode <> FM_READ THEN
      FIELD(UnLink_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(UnLink_Btn).CurBias = FB_INVISIBLE;
   ENDIF;

   RFPIndex = i;

/*
** Equipment to be dropped or picked up
*/
   DropEquip.Clear();
   PickEquip.Clear();
   j = 1;
   k = 1;
   SELECT :TempString = EquipName,
          :i = Type
   FROM   IR_RFPEquipment
   WHERE  RFP = :RFP[RFPIndex].RFP AND
          RevisionNumber = :RFP[RFPIndex].RevisionNumber
   BEGIN
      IF i = 0 THEN
         DropEquip[j].EquipName = TempString;
         j = j + 1;
      ELSE
         PickEquip[k].EquipName = TempString;
         k = k + 1;
      ENDIF;
   END;
   IF j > 7 THEN
       FIELD(DropEquip).HasScrollBar = TRUE;
   ELSE
       FIELD(DropEquip).HasScrollBar = FALSE;
   ENDIF;

   IF k > 7 THEN
       FIELD(PickEquip).HasScrollBar = TRUE;
   ELSE
       FIELD(PickEquip).HasScrollBar = FALSE;
   ENDIF;

   CurFrame.Flush();
   CurFrame.WindowHeight = FIELD(ok_btn).ParentField.OuterHeight + 10;
   CurFrame.SendUserEvent (EventName = 'LoadLocations');
END;

ON ENTRY nt_sf.X = 
BEGIN
   FIELD(nt_sf).CurBias = FB_INVISIBLE;
   CurFrame.Flush();   
   
   /*
   **  Set input focus away from note_text field.
   */   
   CurFrame.InputFocusField = FIELD(Ok_Btn);
END;

ON USEREVENT 'LoadLocations' =
BEGIN
   IF RFPIndex = 0 THEN
      RESUME;
   ENDIF;
/*
** Load work locations
*/
   j = 1;
   RFPLocation.Clear();
   SELECT :RFPLocation[j].RFP = RFP
         ,:RFPLocation[j].RFPLocation = RFPLocation
         ,:RFPLocation[j].LocationStructure = LocationStructure
         ,:RFPLocation[j].LocationStreet = LocationStreet
         ,:RFPLocation[j].RevisionStatus = RevisionStatus
         ,:RFPLocation[j].TagsRequested = TagsRequested
         ,:RFPLocation[j].Instructions = Instructions
   FROM   IR_RFPLocation
   WHERE  RFP = :RFP[RFPIndex].RFP AND
          RevisionNumber = :RFP[RFPIndex].RevisionNumber
   BEGIN 
      IF RFPLocation[j].RevisionStatus = 'NO_LONGER_NEEDED' THEN
         FIELD(RFPLocation[j].LocationStructure).FGCOLOR = CC_LIGHT_GRAY;
         FIELD(RFPLocation[j].LocationStreet).FGCOLOR = CC_LIGHT_GRAY;
         FIELD(RFPLocation[j].TagsRequested).FGCOLOR = CC_LIGHT_GRAY;
         FIELD(RFPLocation[j].Instructions).FGCOLOR = CC_LIGHT_GRAY;
         FIELD(RFPLocation[j].RevisionStatus).FGCOLOR = CC_LIGHT_GRAY;
      ENDIF;
      j = j + 1;
   END;
   
   IF j = 1 THEN
      MESSAGE 'There are no work locations for this Request For Permit and ' +
              'that is a problem.';
      RESUME;
   ENDIF;

   FOR j = 1 TO FCR_Permits.LastRow() DO
       FCR_Permits[j].BaseKey = FALSE;
       FCR_Permits[j].Seq = 0;
   ENDFOR;
   LocationIndex = 0;
END;


ON CLICK Ack_btn =
BEGIN
/*
** Get DO and save info in database
*/
    IF RFPIndex = 0 THEN
       MESSAGE 'ERROR: RFP Not correctly selected.';
       RESUME;
    ENDIF;

    ResponseType = 'ACKNOWLEDGE';
    RetCode = CALLFRAME AcknowledgeRFP (
                              Card = Card,
                              RFP = RFP[RFPIndex],
                              ResponseType = ResponseType);
    IF RetCode = PU_OK THEN
       FIELD(Ack_btn).CurBias = FB_INVISIBLE;
       CurFrame.Flush();
/*
** Now continue by reviewing the RFP locations, looking for revision status
** CHANGED.  For those that are changed, find any related WP locations, copy
** the change to the WP location, and update the WP Revision information.
** FCR cannot change Location Structure.
*/ 
       FOR i = 1 TO RFPLocation.LastRow() DO
          IF RFPLocation[i].RevisionStatus = 'CHANGED' THEN
             j = 1;
             LinkedWPLoc.Clear();
/*
** the code here is replaced to support 33kv cards. 9/13/16
             REPEATED
             SELECT  :LinkedWPLoc[j].WorkPermit = WL.WorkPermit
                    ,:LinkedWPLoc[j].WPLocation = WL.WPLocation
                    ,:LinkedWPLoc[j].LocationNotes = WL.LocationNotes
                    ,:LinkedWPLoc[j].LocationStructure = WL.LocationStructure
             FROM    IR_WorkLocation WL
                    ,SOA_Job J
                    ,SOA_JobControl JC
             WHERE  JC.Card = :Card.Card AND
                    JC.Job = J.Job AND
                    J.Status = '' AND
                    J.Job = WL.WorkPermit AND
                    WL.RFP = :RFP[RFPIndex].RFP AND
                    WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
                    WL.RFPLocation = :RFPLocation[i].RFPLocation
             BEGIN
                j = j + 1;
             END;
Obsolete */             
             REPEATED
             SELECT  :LinkedWPLoc[j].WorkPermit = WL.WorkPermit
                    ,:LinkedWPLoc[j].WPLocation = WL.WPLocation
                    ,:LinkedWPLoc[j].LocationNotes = WL.LocationNotes
                    ,:LinkedWPLoc[j].LocationStructure = WL.LocationStructure
             FROM    IR_WorkLocation WL
                    ,SOA_Job J
             WHERE  J.Status = '' AND
                    J.Job = WL.WorkPermit AND
                    WL.RFP = :RFP[RFPIndex].RFP AND
                    WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
                    WL.RFPLocation = :RFPLocation[i].RFPLocation
             BEGIN
                j = j + 1;
             END;
             CALLPROC DDB_ROLLBACK;

             FOR j = 1 TO LinkedWPLoc.LastRow() DO
                RevisionOnFlag = TRUE;
                RevisionPermit = LinkedWPLoc[j].WorkPermit;
                TempRevComment = 'FCR Revised Loc ' + 
                                 LinkedWPLoc[j].LocationStructure + '; ';

#               INCLUDE WPRevisionLogic

                RevisionOnFlag = FALSE;
                IF RevisionUpdateError = TRUE THEN
                   MESSAGE 'CHANGED RFP Location Street for Structure ' + 
                           LinkedWPLoc[j].LocationStructure + ' could not ' +
                           'be cascaded to related Work Permit Locations ' +
                           'due to a logging error.  Please manually correct ' +
                           'the related Work Permit Locations.';
                   CONTINUE;
                ENDIF;

                RetCode = CALLPROC IR_WorkLocationUpd (
                           WorkPermit = LinkedWPLoc[j].WorkPermit,
                           WPLocation = LinkedWPLoc[j].WPLocation,
                           LocationStructure = LinkedWPLoc[j].LocationStructure,
                           LocationStatus = 'Tag Needed',
                           LocationStreet = RFPLocation[i].LocationStreet,
                           LocationNotes = 'Street Revised by FCR; ' +
                                            LinkedWPLoc[j].LocationNotes,
                           RevisionDate = RevisionDate);
                IF RetCode = 0 THEN
                   CALLPROC DDB_COMMIT;
                ELSE
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'CHANGED RFP Location Street for Structure ' + 
                           LinkedWPLoc[j].LocationStructure + ' could not ' +
                           'be cascaded to related Work Permit Locations ' +
                           'due to an transaction error.  Please manually ' +                               'correct the related Work Permit Locations.';
                   CONTINUE;
                ENDIF;
             ENDFOR;
/*
** For any NO_LONGER_NEEDED locations, remove work permit links for non-issued
** permits.
*/         
          ELSEIF RFPLocation[i].RevisionStatus = 'NO_LONGER_NEEDED' THEN
             j = 1;
             LinkedWPLoc.Clear();
/*
** the code here is replaced to support 33kv cards. 9/13/16              
             REPEATED
             SELECT  :LinkedWPLoc[j].WorkPermit = WL.WorkPermit
                    ,:LinkedWPLoc[j].WPLocation = WL.WPLocation
                    ,:LinkedWPLoc[j].LocationNotes = WL.LocationNotes
                    ,:LinkedWPLoc[j].LocationStructure = WL.LocationStructure
             FROM    IR_WorkLocation WL
                    ,SOA_Job J
                    ,SOA_JobControl JC
             WHERE  JC.Card = :Card.Card AND
                    JC.Job = J.Job AND
                    J.Status = '' AND
                    J.TOIssued IS NULL AND
                    J.Job = WL.WorkPermit AND
                    WL.RFP = :RFP[RFPIndex].RFP AND
                    WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
                    WL.RFPLocation = :RFPLocation[i].RFPLocation
             BEGIN
                j = j + 1;
             END;
obsolete */             
             REPEATED
             SELECT  :LinkedWPLoc[j].WorkPermit = WL.WorkPermit
                    ,:LinkedWPLoc[j].WPLocation = WL.WPLocation
                    ,:LinkedWPLoc[j].LocationNotes = WL.LocationNotes
                    ,:LinkedWPLoc[j].LocationStructure = WL.LocationStructure
             FROM    IR_WorkLocation WL
                    ,SOA_Job J
             WHERE  J.Status = '' AND
                    J.TOIssued IS NULL AND
                    J.Job = WL.WorkPermit AND
                    WL.RFP = :RFP[RFPIndex].RFP AND
                    WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
                    WL.RFPLocation = :RFPLocation[i].RFPLocation
             BEGIN
                j = j + 1;
             END;
             CALLPROC DDB_ROLLBACK;

             FOR j = 1 TO LinkedWPLoc.LastRow() DO
/*
** Delete is cascaded to Work Location Tags
*/
                RetCode = CALLPROC IR_WorkLocationDel (
                       WorkPermit = LinkedWPLoc[j].WorkPermit
                     , WPLocation = LinkedWPLoc[j].WPLocation
                     );

                IF RetCode <> 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   MESSAGE 'Unable to delete No Longer Needed location ' +
                           'from a permit.  Please remove location ' +
                           'manually.';
                ELSE
                   CALLPROC DDB_COMMIT;
                ENDIF;
             ENDFOR;
          ENDIF;
       ENDFOR;
    ENDIF;
END;


ON CLICK Reject_btn =
BEGIN
    IF RFPIndex = 0 THEN
       MESSAGE 'ERROR: RFP Not correctly selected.';
       RESUME;
    ENDIF;
/*
** Allow rejection of Pool RFPs.
*/
    IF RFP[RFPIndex].Card <> 0 AND 
       RFP[RFPIndex].OutageType <> 'NOWOUT' AND
       RFP[RFPIndex].OutageType <> 'TROUBLE' THEN

       MESSAGE 'Scheduled RFPs must be unlinked ' +
               'from the card in order to be rejected. ' +
               'Please Unlink, then Reject.';
       RESUME;
    ENDIF;
/*
** Make sure RFP locations have not been linked to a work permit.  If they
** have, we want the DO to remove them before continuing with the rejection
*/
   OutstandingPermit = FALSE;
/*
** the code here is replaced to support 33kv cards. 9/13/16 
   REPEATED
   SELECT :OutstandingPermit = :TRUE
   FROM   IR_WorkLocation WL,
          SOA_Job J,
          SOA_JobControl JC
   WHERE  WL.RFP = :RFP[RFPIndex].RFP AND
          WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
          WL.WorkPermit = J.Job AND
          J.Job = JC.Job AND
          JC.Card = :Card.Card;
obsolete */
   REPEATED
   SELECT :OutstandingPermit = :TRUE
   FROM   IR_WorkLocation WL,
          SOA_Job J
   WHERE  WL.RFP = :RFP[RFPIndex].RFP AND
          WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
          WL.WorkPermit = J.Job;

   IF OutstandingPermit = TRUE THEN
      MESSAGE 'RFP Locations have been included on a Work Permit.  You ' +
              'must remove the Locations from the Permit in order to ' +
              'reject the RFP.';
      RESUME;
   ENDIF; 
/*
** Get DO and save info in database.  If good return code, refresh the
** screen fields and remove Rejected RFP from the list.
*/
    ResponseType = 'REJECT';
    RetCode = CALLFRAME AcknowledgeRFP (
               Card = Card,
               RFP = RFP[RFPIndex],
               ResponseType = ResponseType);

    IF RetCode = PU_OK THEN
       RFP.RemoveRow (RowNumber = RFPIndex);
       RevRequest.DOComment = '';
       FCRRevision.RevisionComment = '';
       RFPLocation.Clear();
       FIELD(Reject_btn).CurBias = FB_INVISIBLE;
       FIELD(Change_btn).CurBias = FB_INVISIBLE;
       FIELD(Ack_btn).CurBias = FB_INVISIBLE;
       FIELD(Link_btn).CurBias = FB_INVISIBLE;
       FOR j = 1 TO FCR_Permits.LastRow() DO
           FCR_Permits[j].BaseKey = FALSE;
           FCR_Permits[j].Seq = 0;
       ENDFOR;
   ENDIF;       
   CurFrame.Flush();
   CurFrame.WindowHeight = FIELD(ok_btn).ParentField.OuterHeight + 10;
END;


ON CLICK Change_btn =
BEGIN
/*
** Get DO and save info in database; Update DOComment upon succesful return.
*/
    IF RFPIndex = 0 THEN
       MESSAGE 'ERROR: RFP Not correctly selected.';
       RESUME;
    ENDIF;
/*
** Temporary solution for pending RFP
*/
    IF RFP[RFPIndex].Card = 0 THEN
       MESSAGE 'Rapid Restore does not currently support ' +
         'Revision of Pending RFPs. ' +
         'You may link this RFP to a card and then ' +
         'Request a Revision.  Or you can ' +
         'call the person that submitted the RFP ' +
         'and ask them to Withdraw it and ' +
         'submit a revision. ' +
         'Those are your two options to correct the RFP.';
       RESUME;
    ENDIF;

    ResponseType = 'REQUEST_FOR_CHANGE';
    RetCode = CALLFRAME AcknowledgeRFP (
                           Card = Card,
                           RFP = RFP[RFPIndex],
                           ResponseType = ResponseType);
    IF RetCode = PU_OK THEN
       RevRequest.DOComment = RFP[RFPIndex].DOComment;
       FIELD(RevRequest).CurBias = FB_LANDABLE;
       FIELD(FCRRevision).CurBias = FB_INVISIBLE;
       FIELD(Ack_btn).CurBias = FB_INVISIBLE;
    ENDIF;
    CurFrame.Flush();
    CurFrame.WindowHeight = FIELD(ok_btn).ParentField.OuterHeight + 10;
END;


ON DBEvent 'IR_LinkConfirmed' =
BEGIN
/*
** Scroll through RFPs and set RevisionChar field if link has been 
** confirmed by Rapid Restore.  This event is actually waiting for the Link
** process to complete in RR before the DO can do anymore activity related to 
** this RFP.  We are depending on the sequential RequestForPermit field for the
** RFP on the card.
*/
   ControlText = CurFrame.DBEvent.DBEventText;

   LinkedRFP = int4(left(ControlText,(locate(ControlText,';')-1)));   
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));
   j = int4(left(ControlText,(locate(ControlText,';')-1)));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));
   TempString = left(ControlText,(locate(ControlText,';')-1));

   FOR i = 1 TO RFP.LastRow() DO
      IF LinkedRFP = RFP[i].RFP THEN

         IF TempString = 'LINKED' THEN
            RFP[i].RequestForPermit = j;
            RFP[i].RevisionChar = VARCHAR(j) +
                                 '.' + VARCHAR(RFP[i].RevisionNumber);   
         ELSEIF TempString = 'UNDONE' THEN
            /* failed to link due to an interface error, FCR Monitor has
            ** unlinked the RFP from the card so the DO can try again.
            */
            SELECT :RFP[i].Card = Card
                  ,:RFP[i].RevisionChar = OutageType
                  ,:RFP[i].AcknowledgedByDO = AcknowledgedByDO
                  ,:RFP[i].LinkedByDO = LinkedByDO
    	          ,:RFP[i].LinkedBy = ''
            FROM   IR_RequestForPermit
            WHERE  RFP = :RFP[i].RFP;

            CALLPROC DDB_ROLLBACK;

            FIELD(Link_btn).CurBias = FB_LANDABLE; 
            FIELD(Unlink_btn).CurBias = FB_INVISIBLE;

            MESSAGE 'Unable to notify Rapid Restore of linked RFP to Card. ' +
                    'Read the incoming message for more information.';
         ENDIF;
         ENDLOOP;

      ENDIF;
   ENDFOR;
END; 


ON CHILDENTRY RFPLocation =
BEGIN
/*
** We control the highlighted rows in the code so that we don't lose
** focus of the highlighted location.
*/
   i = 0; 
   i = FIELD(RFPLocation).CurRow;
   IF i = 0 THEN
      MESSAGE 'No work location selected.';
      RESUME;
   ENDIF;
   
   IF FIELD(RFPLocation[i].RevisionStatus).FGCOLOR = CC_PALE_GRAY THEN
      RESUME;
   ENDIF;

   LocationIndex = i;

   FOR j = 1 TO RFPLocation.LastRow() DO
      IF j = i THEN
         FIELD(RFPLocation[j].LocationStructure).IsReverse = TRUE;
         FIELD(RFPLocation[j].LocationStreet).IsReverse = TRUE;
         FIELD(RFPLocation[j].TagsRequested).IsReverse = TRUE;
         FIELD(RFPLocation[j].Instructions).IsReverse = TRUE;
         FIELD(RFPLocation[j].RevisionStatus).IsReverse = TRUE;
      ELSE
         FIELD(RFPLocation[j].LocationStructure).IsReverse = FALSE;
         FIELD(RFPLocation[j].LocationStreet).IsReverse = FALSE;
         FIELD(RFPLocation[j].TagsRequested).IsReverse = FALSE;
         FIELD(RFPLocation[j].Instructions).IsReverse = FALSE;
         FIELD(RFPLocation[j].RevisionStatus).IsReverse = FALSE;
      ENDIF;
   ENDFOR;   
/*
** Mark the FCR Permits that are linked to this location.
*/
   FOR j = 1 TO FCR_Permits.LastRow() DO
       FCR_Permits[j].BaseKey = FALSE;
       FCR_Permits[j].Seq = 0;
   ENDFOR;

   IF ArchiveCard = FALSE THEN
      REPEATED 
      SELECT     :Linked_Permit.Job = J.Job      
                ,:Linked_Permit.Card = JC.Card      
                ,:Linked_Permit.JobClass = J.JobClass
                ,:Linked_Permit.MoveEquipClass = JC.MoveEquipClass
                ,:Linked_Permit.StepPair = JC.StepPair
                ,:Linked_Permit.Seq = WL.WPLocation    /* Hide in seq field */
                ,:Linked_Permit.TOIssued = J.TOIssued
                ,:Linked_Permit.RSComplete = J.RSComplete
                ,:Linked_Permit.TOMove = J.TOMove
                ,:Linked_Permit.RSMove = J.RSMove
                ,:Linked_Permit.PrintID = JC.PrintID
                ,:Linked_Permit.EquipClassName = J.EquipClassName
                ,:Linked_Permit.EquipName = J.EquipName
      FROM   SOA_Job J,
             SOA_JobControl JC,
             IR_WorkLocation WL
      WHERE  JC.Card = :Card.Card AND
             JC.Job = J.Job AND
             J.Status = '' AND
             J.Job = WL.WorkPermit AND
             WL.RFP = :RFP[RFPIndex].RFP AND
             WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             WL.RFPLocation = :RFPLocation[LocationIndex].RFPLocation
      BEGIN
            FOR j = 1 TO FCR_Permits.LastRow() DO
               IF Linked_Permit.Job = FCR_Permits[j].Job THEN
                  FCR_Permits[j].BaseKey = TRUE;
                  FCR_Permits[j].Seq = Linked_Permit.Seq;
               ENDIF;
            ENDFOR;
      END;
   ELSE
      REPEATED 
      SELECT     :Linked_Permit.Job = J.Job      
                ,:Linked_Permit.Card = J.Card      
                ,:Linked_Permit.JobClass = J.JobClass
                ,:Linked_Permit.MoveEquipClass = J.MoveEquipClass
                ,:Linked_Permit.StepPair = J.StepPair
                ,:Linked_Permit.Seq = WL.WPLocation    /* Hide in seq field */
                ,:Linked_Permit.TOIssued = J.TOIssued
                ,:Linked_Permit.RSComplete = J.RSComplete
                ,:Linked_Permit.TOMove = J.TOMove
                ,:Linked_Permit.RSMove = J.RSMove
                ,:Linked_Permit.PrintID = J.PrintID
                ,:Linked_Permit.EquipClassName = J.EquipClassName
                ,:Linked_Permit.EquipName = J.EquipName
      FROM   FMS_ArchiveJob J,
             IR_WorkLocation WL
      WHERE  J.Card = :Card.Card AND
             J.Status = '' AND
             J.Job = WL.WorkPermit AND
             WL.RFP = :RFP[RFPIndex].RFP AND
             WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             WL.RFPLocation = :RFPLocation[LocationIndex].RFPLocation
      BEGIN
            FOR j = 1 TO FCR_Permits.LastRow() DO
               IF Linked_Permit.Job = FCR_Permits[j].Job THEN
                  FCR_Permits[j].BaseKey = TRUE;
                  FCR_Permits[j].Seq = Linked_Permit.Seq;
               ENDIF;
            ENDFOR;
      END;
   ENDIF;
END;


ON CHILDSETVALUE FCR_Permits[*].BaseKey =
BEGIN
/*
** Remove Location to Permit link as long as Permit has not been issued.
*/
   i = FIELD(FCR_Permits).ActiveRow;
   IF i = 0 THEN
      MESSAGE 'You have not selected a Work Permit.';
#     INCLUDE RFPReverseLink
   ENDIF;
/*
** If RFP Card still pending/ Card= 0, don't allow links to WP.
*/
   IF RFPIndex = 0 THEN
      MESSAGE 'Please select a RFP and a RFP location.';
#     INCLUDE RFPReverseLink
   ENDIF;

   IF RFP[RFPIndex].Card = 0 THEN
      MESSAGE 'The RFP is not linked to the card or is waiting for ' +
              'link confirmation from Rapid Restore.';
#     INCLUDE RFPReverseLink
   ENDIF;           
 
   IF RFP[RFPIndex].RequestForPermit = 0 THEN
      MESSAGE 'The RFP is not linked to the card or is waiting for ' +
              'link confirmation from Rapid Restore.';
#     INCLUDE RFPReverseLink
   ENDIF;           
 
   IF FCR_Permits[i].RSComplete IS NOT NULL THEN 
      MESSAGE 'Work Permit has been completed already.';
#     INCLUDE RFPReverseLink
   ENDIF;

   IF LocationIndex = 0 THEN
      MESSAGE 'No RFP Location has been selected.';
#     INCLUDE RFPReverseLink
   ENDIF;

   IF FCR_Permits[i].BaseKey = FALSE THEN
/*
** Cannot remove locations from an outstanding permit.
*/
      IF FCR_Permits[i].TOIssued IS NOT NULL THEN 
         MESSAGE 'You may not remove work locations from an issued permit. ' +
                 'The best you can do at this point is mark the location ' +
                 'as NOT NEEDED.';
#        INCLUDE RFPReverseLink
      ENDIF;
/*
** If there are any tags on the Work Permit Location, they must be copied
** to the RFP Location if they don't already exist there.  Tags on work 
** locations should be deleted with deleted location.  (Cascading rule might
** be best implementation.)
**
** This code is left here to be backward compatible with old data.
** Modification to Tag screen means new tags are automatically copied back
** to the RFP Location.
*/       
      j = 1;
      WorkLocationTags.Clear();
      SELECT   :WorkLocationTags[j].WorkPermit = WorkPermit
           ,:WorkLocationTags[j].WPLocation = WPLocation
           ,:WorkLocationTags[j].TagType = TagType
           ,:WorkLocationTags[j].TagNumber = TagNumber
           ,:WorkLocationTags[j].TagNotes = TagNotes
           ,:WorkLocationTags[j].BrassTag = BrassTag
           ,:WorkLocationTags[j].PlasticTag = PlasticTag
           ,:WorkLocationTags[j].Phases = Phases
           ,:WorkLocationTags[j].DirectionalEquip = DirectionalEquip
           ,:WorkLocationTags[j].TagSentBy = TagSentBy
           ,:WorkLocationTags[j].TagSentDate = TagSentDate
      FROM     IR_WorkLocationTag
      WHERE    WorkPermit = :FCR_Permits[i].Job AND
               WPLocation = :FCR_Permits[i].Seq
      BEGIN
         j = j + 1;
      END;
/*
** Get the RFP location, check for tag existence, copy if not there.
*/
      ReqFP = 0;
      ReqFPLocation = 0;
      SELECT  :ReqFP = RequestForPermit
             ,:ReqFPLocation = RFPLocation
      FROM     IR_WorkLocation
      WHERE    WorkPermit = :FCR_Permits[i].Job AND
               WPLocation = :FCR_Permits[i].Seq;
 
      FOR j = 1 TO WorkLocationTags.LastRow() DO

         TagExists = FALSE;
         SELECT  :TagExists = :TRUE
         FROM    IR_RFPLocationTag
         WHERE   RFP = :RFPLocation[LocationIndex].RFP AND
              RFPLocation = :ReqFPLocation AND
              TagType = :WorkLocationTags[j].TagType AND
              TagNumber = :WorkLocationTags[j].TagNumber;

         IF TagExists = FALSE THEN   /*Save WPLocationTag to RFPLocationTag*/
 
            RetCode = CALLPROC IR_RFPLocationTagIns (
            RFP = RFPLocation[LocationIndex].RFP
          , RFPLocation = ReqFPLocation
          , TagType = WorkLocationTags[j].TagType
          , TagNumber = WorkLocationTags[j].TagNumber
          , TagNotes = WorkLocationTags[j].TagNotes
          , BrassTag = WorkLocationTags[j].BrassTag
          , PlasticTag = WorkLocationTags[j].PlasticTag
          , Phases = WorkLocationTags[j].Phases
          , DirectionalEquip = WorkLocationTags[j].DirectionalEquip
          , TagSentBy = WorkLocationTags[j].TagSentBy
          , TagSentDate = WorkLocationTags[j].TagSentDate
          );

            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Error: Unable to copy Work Location Tags to the RFP. ' +
                    'Work Permit Location cannot be removed.'; 
#              INCLUDE RFPReverseLink
            ENDIF;      
         ENDIF;       
      ENDFOR;
      CALLPROC DDB_COMMIT;
/*
** Delete is cascaded to Work Location Tags
*/
      RetCode = CALLPROC IR_WorkLocationDel (
                WorkPermit = FCR_Permits[i].Job
              , WPLocation = FCR_Permits[i].Seq
              );

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to delete location from the permit.  Try again or ' +
              'call tech support.';
#        INCLUDE RFPReverseLink
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** If RFP locations are not linked to a Work Permit, enable the unlink button.
*/
      j = 0;
/*
** the code here is replaced to support 33kv cards. 9/13/16 
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             SOA_Job J,
             SOA_JobControl JC
      WHERE  WL.RFP = :RFP[RFPIndex].RFP AND
             WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             WL.WorkPermit = J.Job AND
             J.Job = JC.Job AND
             JC.Card = :Card.Card;
obsolete */
      REPEATED
      SELECT :j = COUNT(*) 
      FROM   IR_WorkLocation WL,
             SOA_Job J
      WHERE  WL.RFP = :RFP[RFPIndex].RFP AND
             WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             WL.WorkPermit = J.Job;

      IF j = 0 AND RFP[RFPIndex].Card <> 0 THEN
         FIELD(UnLink_Btn).CurBias = FB_LANDABLE;
      ELSE
         FIELD(UnLink_Btn).CurBias = FB_INVISIBLE;
      ENDIF;

   ELSE
/*
** Make sure RFP is acknowledged first.
*/
      IF FIELD(Ack_btn).CurBias = FB_LANDABLE THEN
         MESSAGE 'You need to acknowledge the RFP before you can set up work ' +
                'permits from it.  Click the "DO Acknoweldges RFP" button in ' +
                'upper right section of the screen.';
#        INCLUDE RFPReverseLink
      ENDIF; 
/*
** If RFP location is no longer needed, then don't let it be linked to a work 
** permit.
*/
      IF RFPLocation[LocationIndex].RevisionStatus = 'NO_LONGER_NEEDED' THEN
         MESSAGE 'The RFP location is NO LONGER NEEDED so it should not ' +
                 'be linked to a Work Permit.';
#         INCLUDE RFPReverseLink
      ENDIF;
/*
** make sure the location is not already linked to an outstanding permit
*/
      j = 0;
      SELECT :j = COUNT(*)
      FROM   IR_WorkLocation WL,
             SOA_Job J
      WHERE  WL.RFP = :RFP[RFPIndex].RFP AND
             WL.RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             WL.RFPLocation = :RFPLocation[LocationIndex].RFPLocation AND
             WL.WorkPermit = J.Job AND
             J.Status = '' AND 
             J.RSComplete IS NULL; 

      IF j > 0 THEN
         IF Card.NetworkFeeder = NetworkFeeder$33KV THEN
            MESSAGE 'A RFP location should not be linked to multiple Work Permits.' + HC_NEWLINE +
                    'A permit on the main card or a portion card was already linked to this location';
         ELSE
            MESSAGE 'A RFP location should not be linked to multiple Work Permits.';
         ENDIF;
#        INCLUDE RFPReverseLink
      ENDIF;

/*
** If Permit is outstanding, make sure it has been acknowledged.
** Otherwise subsequent ack will mark all locations and WP return could fail.
*/
      IF FCR_Permits[i].TOIssued IS NOT NULL THEN
         PermitAck = FALSE;
         SELECT :PermitAck = PermitStatus
         FROM   IR_WorkPermit
         WHERE  WorkPermit = :FCR_Permits[i].Job;

         IF PermitAck <> Permit$Acknowledged AND 
                  PermitAck <> Permit$Initialized THEN
            MESSAGE 'Locations cannot be added to outstanding permits that ' +
                    'have not been acknowledged.  The FCR should acknowledge ' +
                    'or reject the permit before you can add a location to it.';
#           INCLUDE RFPReverseLink
         ENDIF;
      ENDIF;    

      IF FCR_Permits[i].TOIssued IS NOT NULL THEN
         IF CurFrame.ConfirmPopup (MessageText = 'Please confirm that you ' +
               'are adding a location to an outstanding permit.  The permit ' +
               'will need to be resent to the FCR on the Work Location ' +
               'or Permit Details screen when it is sufficiently TAGGED.') =
                PU_CANCEL THEN
#           INCLUDE RFPReverseLink
         ENDIF;
      ENDIF;

      FCRPermit = FCR_Permits[i].Job;

      IF FCR_Permits[i].TOIssued IS NOT NULL AND 
         FCR_Permits[i].TOIssued <> '' THEN

         RevisionOnFlag = TRUE;
         RevisionPermit = FCRPermit;
         TempRevComment = 'Added Location: ' +
			  RFPLocation[LocationIndex].LocationStructure + '; ';

#        INCLUDE WPRevisionLogic

         RevisionOnFlag = FALSE;
         IF RevisionUpdateError = TRUE THEN
#           INCLUDE RFPReverseLink
         ENDIF;

      ELSE
/*
** IF we did not go into our Revision Update code for an outstanding permit,
** then we need to set the RevisionDate now so that it can be used as the
** Insertion Date later.
*/
         RevisionDate = DATE('now');
      ENDIF;
/*
** Make sure an FCR Interface permit exists for this Work Permit.  If not,
** insert it.
*/
      j = 0;
      SELECT :j = COUNT(*)
      FROM   IR_WorkPermit
      WHERE  WorkPermit = :FCRPermit;

      IF j = 0 THEN
         RetCode = CALLPROC IR_NewFCRWorkPermit (
                             WorkPermit = FCRPermit);
 
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to create FCR Interface permit where locations ' +
                 'can be linked. Try again or call tech support.';
#           INCLUDE RFPReverseLink
         ENDIF;
      ENDIF;
/*
** Get the highest WPLocation value and add one to it for each location.
*/
      WPLocation = 0;
      SELECT :WPLocation = IFNULL(MAX(WPLocation),0)
      FROM   IR_WorkLocation
      WHERE  WorkPermit = :FCRPermit;   
/*
** Make sure the location is not already on the permit, if not then add it.
*/
      k = 0;
      SELECT :k = COUNT(*) 
      FROM   IR_WorkLocation  
      WHERE  WorkPermit = :FCRPermit AND
             RFP = :RFP[RFPIndex].RFP AND
             RequestForPermit = :RFP[RFPIndex].RequestForPermit AND
             RFPLocation = :RFPLocation[LocationIndex].RFPLocation;
      IF k > 0 THEN
         MESSAGE 'Location for Structure ' +
              RFPLocation[LocationIndex].LocationStructure + 
              ' is already on the Permit.';
         RESUME;
      ENDIF;
        
      WPLocation = WPLocation + 1;
      RetCode = CALLPROC IR_WorkLocationIns (
             WorkPermit 	= FCRPermit
           , WPLocation 	= WPLocation
           , RFP                = RFP[RFPIndex].RFP
           , RequestForPermit 	= RFP[RFPIndex].RequestForPermit
           , RFPLocation  	= RFPLocation[LocationIndex].RFPLocation
           , LocationStructure 	= RFPLocation[LocationIndex].LocationStructure
           , LocationStreet   	= RFPLocation[LocationIndex].LocationStreet
           , LocationStatus  	= 'Tag Needed'
           , InsertionDate      = RevisionDate
           ); 
      IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to add a location to a Work Permit. ' +
                 'Try again or call tech support.';
#           INCLUDE RFPReverseLink
      ENDIF;
/*
** Now Copy RFP location tags to WP work location
*/
      RetCode = CALLPROC IR_CopyRFPTagsToWP (
             WorkPermit 	= FCRPermit
           , WPLocation 	= WPLocation
           , RFP         	= RFPLocation[LocationIndex].RFP
           , RFPLocation  	= RFPLocation[LocationIndex].RFPLocation
           ); 
      IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to copy RFP Location Tags to the Work Permit ' +
                 'Location. Location not added to permit. ' +
                 'Try again or call tech support.';
#           INCLUDE RFPReverseLink
      ENDIF;
      CALLPROC DDB_COMMIT;
      FCR_Permits[i].Seq = WPLocation;
      FIELD(UnLink_Btn).CurBias = FB_INVISIBLE;

   ENDIF;
END; 


ON CLICK Link_btn =
BEGIN
/*
** Link the RFP to the card, wait for RR to return Card RequestForPermit ID
** before continuing.
*/
   RetCode = CALLPROC IR_LinkRFPCard (
                 RFP = RFP[RFPIndex].RFP,
                 Card = RFPCard,
                 LinkedByDO = 1);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;

      RFP[RFPIndex].LinkedBy = 'D.O.';
      RFP[RFPIndex].LinkedByDO = 1;
      RFP[RFPIndex].RevisionChar = 'Pending';
      RFP[RFPIndex].Card = RFPCard;

      IF DOp.Description = '' THEN
         DOp.Description = UserName;
      ENDIF;

      ControlText = VARCHAR(RFP[RFPIndex].RFP) + ';' +
                    VARCHAR(RFPCard) + ';' +
                    DOp.Description + ';';

      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_LinkRFPCard',
                     EventText = ControlText);  
/*
** Acknowledge the Permit if it is unacknowledged.
** No need to evaluate retcode.
*/
      IF RFP[RFPIndex].AcknowledgedByDO = FALSE THEN
         ResponseType = 'LINKACK';
         RetCode = CALLFRAME AcknowledgeRFP (
                                 Card = Card,
                                 RFP = RFP[RFPIndex],
                                 ResponseType = ResponseType);
         RFP[RFPIndex].AcknowledgedByDO = TRUE;
      ENDIF;

      MESSAGE 'The RFP has been linked to the Card but will remain in the ' +
              'pending state until Rapid Restore has been updated.';
      FIELD(Link_btn).CurBias = FB_INVISIBLE;
      FIELD(Unlink_btn).CurBias = FB_LANDABLE; 
/*
** Compare RFP Location Structures to common manholes for this feeder.  If any match
** we must insert into ManholeRFP table.  Look for DM or M only.
*/
      IF Card.CutOut IS NOT NULL AND Card.CutIn IS NULL THEN
         Structures.Clear();
         j = 1;
         SELECT 
         DISTINCT :Structures[j].RFP = R.RFP,
                  :Structures[j].LocationStructure = L.LocationStructure,
                  :Structures[j].Feeder = R.Feeder
         FROM   IR_RequestForPermit R,
                IR_RFPLocation L,
                TFMS_CardToObject CTO
         WHERE  R.Card = :RFPCard AND
                CTO.Card = R.Card AND
                CTO.Object = R.Feeder AND
                R.RFP = L.RFP AND
               (L.LocationStructure LIKE 'M%' OR
                L.LocationStructure LIKE 'DM%')
         BEGIN 
            j = j + 1;
         END;
         
         Manholes.Clear();
         k = 1;
         SELECT :Manholes[k].Structure = Manhole
         FROM   FMS_CommonManhole 
         WHERE  (Feeder1 IN (SELECT Object FROM TFMS_CardToObject 
                                WHERE  Card = :RFPCard))  OR 
                (Feeder2 IN (SELECT Object FROM TFMS_CardToObject 
                                WHERE  Card = :RFPCard))
         BEGIN
            k = k + 1;
         END;
/*
** Parse for a structure number, make the name consistent with the Common Manhole standard,
** then look for a common manhole match and insert into the Manhole RFP table if one is found.
*/
         FOR j = 1 TO Structures.LastRow() DO
            StructNumeric = CALLPROC ExtractRFPLocNumber (
                    NameString = Structures[j].LocationStructure);
            IF StructNumeric = '' THEN
               CONTINUE;
            ENDIF;

            IF Structures[j].LocationStructure LIKE 'M%' THEN
               StructNumeric = 'M' + StructNumeric;
            ELSE
               StructNumeric = 'DM' + StructNumeric;
            ENDIF;

            RetCode = -1;
            RetCode = Manholes.Find (AttributeName = 'structure',
                                     Value = StructNumeric);

            IF RetCode = ER_OK THEN      
               RetCode = CALLPROC FMS_ManholeRFPIns (
                               Card = RFPCard,
                               Feeder = Structures[j].Feeder,
                               RFP = Structures[j].RFP,
                               Manhole = StructNumeric);

               IF RetCode >= 0 THEN  /* RetCode = 1 means it already Exists */
                  CALLPROC DDB_COMMIT;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  CurFrame.Trace(Text = VARCHAR(DATE('Now')) + ': Failed to insert common manhole ' + StructNumeric + 
                               ' for Feeder ' + RFPFeederName + ' work location.');
                  MESSAGE 'Failed to insert common manhole ' + StructNumeric + 
                               ' for ' + RFPFeederName + ' work location due to Ingres error.';    
               ENDIF;                          
            ENDIF;   
         ENDFOR;
      ENDIF;   

      CALLFRAME ReviewRFPTags (RFP = RFP[RFPIndex].RFP,
                               Card = Card.Card);
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Error: Linking the RFP to the card was unsuccessful.';
   ENDIF;      
END;

ON CLICK Unlink_btn =
BEGIN
/*
** If RFP is an old one with negative key or a trouble RFP or if link
** is still pending, don't allow unlink.
*/
   IF RFP[RFPIndex].RFP < 0 THEN
      MESSAGE 'This is an old FCR RFP which cannot be unlinked from the card.';
      RESUME;
   ENDIF;

   IF RFP[RFPIndex].OutageType = 'TROUBLE' OR 
      RFP[RFPIndex].OutageType = 'NOWOUT' THEN
      MESSAGE 'The RFP was sent by Rapid Restore as a Trouble or ' +
              'NowOut RFP explicitly linked to this card by the FCR. This ' +
              'RFP must remain with this card and cannot be unlinked.';
      RESUME;
   ENDIF;

   IF RFP[RFPIndex].RevisionChar = 'Pending' THEN
      MESSAGE 'Since RFP link is still Pending it cannot yet be unlinked. ' +
              'Exit screen and re-enter to refresh RFP link status.';
      RESUME;
   ENDIF;
/*
** FMS 315: Does not allow DO to unkink RFP linked by FCR
*/
   IF RFP[RFPIndex].LinkedByDO = 0 THEN
      MESSAGE 'The RFP was linked to this card by the FCR. Please request ' +
              'the FCR to withdraw the RFP and resend a new RFP without linking to the card.';
      RESUME;
   ENDIF; 
/*
** Remove RFP from the card and return it to the pool.
*/
   RetCode = CALLPROC IR_LinkRFPCard (
                 RFP = RFP[RFPIndex].RFP,
                 Card = 0,
                 LinkedByDO = 0);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;

      ControlText = VARCHAR(RFP[RFPIndex].RFP) + ';' +
                    VARCHAR(RFPCard) + ';' +
                    VARCHAR(RFP[RFPIndex].RequestForPermit) + ';' + 
                    DOp.Description + ';';
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_UnLinkRFPCard',
                     EventText = ControlText);  

      RFP[RFPIndex].LinkedBy = '';
      RFP[RFPIndex].LinkedByDO = 0; 
      RFP[RFPIndex].RevisionChar = RFP[RFPIndex].OutageType;
      RFP[RFPIndex].Card = 0;
      RFP[RFPIndex].RequestForPermit = 0;
/*
** Institute a delay to prevent immediate relink, which has proven to be a prob
** during integrated testing due to timing problems of the db events to the
** FCR Monitor.  We deselect the RFP forcing reselection, which may provide 
** enough time for the Unlink process to fully complete.
*/
      FIELD(Unlink_btn).CurBias = FB_INVISIBLE;
      FIELD(Change_btn).CurBias = FB_INVISIBLE;
      FIELD(Reject_btn).CurBias = FB_INVISIBLE;
      FIELD(Ack_btn).CurBias = FB_INVISIBLE;
      FIELD(RevRequest).CurBias = FB_INVISIBLE;
      FIELD(FCRRevision).CurBias = FB_INVISIBLE;

      FIELD(RFP[RFPIndex].FCRName).IsReverse = FALSE;
      FIELD(RFP[RFPIndex].Timestamp).IsReverse = FALSE;
      FIELD(RFP[RFPIndex].Objective).IsReverse = FALSE;
      FIELD(RFP[RFPIndex].AcknowledgedByDO).IsReverse = FALSE;
      FIELD(RFP[RFPIndex].RevisionChar).IsReverse = FALSE;

      RFPLocation.Clear();
      CurFrame.Flush();
      CurFrame.WindowHeight = FIELD(ok_btn).ParentField.OuterHeight + 10;

      CALLFRAME ReviewRFPTags (RFP = RFP[RFPIndex].RFP,
                               Card = Card.Card);
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Error: Linking the RFP to the card was unsuccessful.';
   ENDIF;      

END;


ON CLICK New_Link_btn =
BEGIN
/*
** Disable if in QUERY Mode.
*/
   IF CurFrame.CurMode = FM_USER1 THEN
      MESSAGE 'Function not available when in Review RFP mode.';
      RESUME;
   ENDIF;
/*
** Make sure RFP is acknowledged first.
*/
   IF FIELD(Ack_btn).CurBias = FB_LANDABLE THEN
      MESSAGE 'You need to acknowledge the RFP before you can set up work ' +
              'permits from it.';
      RESUME;
   ENDIF; 
/*
** Take user to NewMoves screen to create a New Work Permit.
*/
   MESSAGE 'Please create your new FCR Work Permit on the New Moves screen.';

   FCRJobs.Clear();
   CALLFRAME NewMoves (
                 C = Card,
                 EffectiveDivisions = EffectiveDivisions,
                 NewJobs = ByRef(FCRJobs));
   IF FCRJobs.LastRow > 0 THEN
      MESSAGE 'New Permit created.  RFP locations can be linked to it now.';
      CurFrame.SendUserEvent (EventName = 'LoadFCRPermits');
   ELSE
      MESSAGE 'No new FCR Work Permit was created.';
   ENDIF;
END;


ON CHILDPROPERTIES FCR_Permits =
BEGIN
/*
** Disable if in QUERY Mode.
*/
   IF CurFrame.CurMode = FM_USER1 THEN
      MESSAGE 'Function not available when in Review RFP mode.';
      RESUME;
   ENDIF;
/*
** Edit Permit Details.
*/  
   CALLFRAME EstablishWorkPermit ( ArchiveCard = ArchiveCard,
                                   EffectiveDivisions = LocalDivisions,
                                   C = Card) WITH CurMode = CurFrameMode;
   CurFrame.SendUserEvent (EventName = 'LoadFCRPermits');      
END;


ON CHILDDETAILS FCR_Permits =
BEGIN
/*
** Disable if in QUERY Mode.
*/
   IF CurFrame.CurMode = FM_USER1 THEN
      MESSAGE 'Function not available when in Review RFP mode.';
      RESUME;
   ENDIF;

   i = FIELD(FCR_Permits).WhichRow (cellfield = CurFrame.TriggerField);
   IF (i > 0) THEN 
/*
** Too many issues surrounding outstanding permits, just don't allow group 
** additions.
*/
      IF FCR_Permits[i].TOIssued IS NOT NULL THEN
         MESSAGE 'Since permit is outstanding, group location additions ' +
                 'are no longer allowed.  You have to make adjustments ' +
                 'on an individual bases on this screen.';
         RESUME;
      ENDIF;
/*
** All RequestForPermit for this card must be acknowledged to do group 
** links.
*/
      j = 0;
      SELECT :j = COUNT(*) 
      FROM   IR_RequestForPermit
      WHERE  Card = :RFPCard AND
             AcknowledgedByDO = 0;
              
      IF j > 0 THEN
         MESSAGE 'You will need to acknowledge all RFPs linked to this ' +
                 'card before you can link locations in groups.';
         RESUME;
      ENDIF;
/*
** Make sure FCR Permit already exists so we don't have to check on each
** link attempt.
*/
      j = 0;
      SELECT :j = COUNT(*)
      FROM   IR_WorkPermit
      WHERE  WorkPermit = :FCRPermit;

      IF j = 0 THEN
         RetCode = CALLPROC IR_NewFCRWorkPermit (
                             WorkPermit = FCRPermit);
 
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to create FCR Interface permit where locations ' +
                 'can be linked as a group. Call tech support.';
            RESUME;
         ENDIF;
      ENDIF;

      CALLFRAME WPtoLocationLink (Permit = FCR_Permits[i].Duplicate(),
                                  Card = Card);
      CurFrame.SendUserEvent (EventName = 'LoadLocations');
   ELSE
      MESSAGE 'Unable to determine proper Work Permit. Try Again.';
   ENDIF;
END;


