/*
**      Copyright c 2004 Pateric Software LLC  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software.
**
**  Application:    FeederCard_DBM
**  Frame:          OperatorEditor
**
**  Modification log:
**
**  Date:       Version         Description
** --------------------------------------------------
**  08/11/04    em              Created
*/
INITIALIZE
(
    ParentFrame = FRAMEEXEC;
    i = integer;                     /* Temporary counters */
    CurrentRow = INTEGER NOT NULL;   /* Temporary counters */
    FindText = STRINGOBJECT; /*Find This String*/
    TypePerson = INTEGER NOT NULL;   /*Normal Operator or RCC Operator*/
    RetCode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   CurrentRow = 1;
   CurFrame.SendUserEvent (EventName = 'Loadlist');
END;


ON USEREVENT 'Loadlist' =
BEGIN
/*
** Build array of unit substations
*/
   i = 1;
   Op.Clear();
   REPEATED
   SELECT  :Op[i].Name = O.Name
          ,:Op[i].Object = O.Object
          ,:Op[i].Description = O.Description
          ,:Op[i].Type = O.Type
          ,:Op[i].PrimaryGrouping = O.PrimaryGrouping
          ,:Op[i].TypeName = O.TypeName
          ,:Op[i].PrimaryGroupingName = O.PrimaryGroupingName
          ,:Op[i].LastChanged = O.LastChanged
          ,:Op[i].LastChangedBy = O.LastChangedBy
          ,:Op[i].Comment = O.Comment
   FROM    Udb_Object O
   WHERE   O.Type IN (SELECT Type FROM Udb_ExtendedType
                      WHERE  SuperType = :Type$Person) AND
           O.Object > 20000      
   ORDER BY Name
   BEGIN
      i = i + 1;
   END;
   O.Object = 0;
   O.Name = '';
   O.Description = '';
   O.PrimaryGrouping = 0;
   O.BaseType = FALSE;
   FIELD(Op).ActiveRow = CurrentRow;
END;


ON CHILDENTRY Op,
ON USEREVENT 'TriggerEntry' = 
BEGIN
   O.Object = Op[].Object;
   O.Name = Op[].Name;
   O.Description = Op[].Description;
   O.PrimaryGrouping = Op[].PrimaryGrouping;
   CurrentRow = FIELD(Op).CurRow;
   IF Op[].Type = Type$RCCOperator THEN
      O.BaseType = TRUE;
   ELSE
      O.BaseType = FALSE;
   ENDIF;
END;


ON CLICK Add_btn =
BEGIN
   IF O.Name = '' OR O.Description = '' THEN
      MESSAGE 'Blank field.  Must enter both employee number and name.';
      RESUME;
   ENDIF;

   IF O.BaseType = TRUE THEN
      TypePerson = Type$RCCOperator;
   ELSE
      TypePerson = Type$Person;
   ENDIF;
/* 
** New Person Object process
*/   
      i = 0;
      SELECT :i = Object 
      FROM    Udb_Object 
      WHERE   Name = :O.Name AND
              Type IN (SELECT Type FROM Udb_ExtendedType 
                       WHERE SuperType = :Type$Person);
      IF i > 0 THEN
         MESSAGE 'Operator with this Employee Number already exists.';
         RESUME;
      ENDIF;
      CALLPROC DDB_ROLLBACK;

      O.Object = 0;
      O.Object = CALLPROC Udb_NextKey (KeyName = 'Object');
      IF O.Object <= 0 THEN
         CALLPROC DD_ROLLBACK;
         MESSAGE 'Unable to generate new object key.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RetCode = CALLPROC Udb_SubstationIns (
              Object = O.Object,
              Type = TypePerson,
              PrimaryGrouping = Division$StatenIsland,
              Name = O.Name,
              Description = O.Description,
              LocatedWith = Interaction$LocatedWith);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to insert new person object.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;

   CurFrame.SendUserEvent (EventName = 'Loadlist');
END;


ON CLICK Update_btn =
BEGIN
   IF O.Name = '' OR O.Description = '' THEN
      MESSAGE 'Blank field.  Must enter both employee number and name.';
      RESUME;
   ENDIF;

   IF O.BaseType = TRUE THEN
      TypePerson = Type$RCCOperator;
   ELSE
      TypePerson = Type$Person;
   ENDIF;
/* 
** Update Person Object process
*/      
      i = 0;
      SELECT :i = Object 
      FROM    Udb_Object 
      WHERE   Name = :O.Name AND
              Object <> :O.Object AND
              Type IN (SELECT Type FROM Udb_ExtendedType 
                       WHERE SuperType = :Type$Person);
      IF i > 0 THEN
         MESSAGE 'Operator with this Employee Number already exists.';
         RESUME;
      ENDIF;
      CALLPROC DDB_ROLLBACK;

      RetCode = CALLPROC Udb_ObjectUpd (
              PrimaryGrouping = O.PrimaryGrouping,
              Object = O.Object,
              Name = O.Name,
              Type = TypePerson);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to update operator type.';
         RESUME;
      ENDIF;

      RetCode = CALLPROC Udb_SubstationUpd (
              Object = O.Object,
              Name = O.Name,
              Description = O.Description,
              PrimaryGrouping = O.PrimaryGrouping,
              LastChangedBy = UserName,
              LastChanged = 'now');

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to update operator.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;

   CurFrame.SendUserEvent (EventName = 'Loadlist');
END;


ON CLICK Find_btn = 
BEGIN
   FindText.Value = '';
   IF CurFrame.ReplyPopup (MessageText =
                  'Enter Employee Number or Name to Find:',
                  Reply = FindText) <> PU_OK THEN
      RESUME;
   ENDIF;
   
   IF FindText.Value <> '' THEN
      FindText.Value = '%' + UPPERCASE(FindText.Value) + '%';
      i = CurrentRow;
      WHILE i <= Op.LastRow() DO
         IF UPPERCASE(Op[i].Name) LIKE FindText.Value OR 
              UPPERCASE(Op[i].Description) LIKE FindText.Value THEN
            FIELD(Op).ActiveRow = i;
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;
     
      IF i > Op.LastRow() THEN
         IF CurrentRow = 1 THEN
            MESSAGE 'Employee "' + FindText.Value + '" not found';
            RESUME;
         ELSE
            i = 1;
            WHILE i <= CurrentRow DO
               IF UPPERCASE(Op[i].Name) LIKE FindText.Value OR 
                    UPPERCASE(Op[i].Description) LIKE FindText.Value THEN
                  FIELD(Op).ActiveRow = i;
                  ENDLOOP;
               ENDIF;
               i = i + 1;
            ENDWHILE;
            IF i > CurrentRow THEN
               MESSAGE 'Employee "' + FindText.Value + '" not found';
               RESUME;
            ENDIF;
         ENDIF;   
      ENDIF;
   ENDIF;
   CurFrame.SendUserEvent (EventName = 'TriggerEntry');
END;

      
         

ON CLICK Exit_btn =
BEGIN
   RETURN;
END;


ON WindowClose =
BEGIN
   RESUME;
END;

