               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptSetATSManualFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_CANCEL);
   ENDIF;

/*
** ATS 102 device is found, now clear declutch status.
*/
   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS102.Object,
                                     Status = Status$Declutch);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;

   CALLPROC DDB_COMMIT;

   RETURN (PU_OK);
