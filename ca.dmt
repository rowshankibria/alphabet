	Name:            PromptPhases

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptPhases
**
**  10/22/92  em    modified per integer/udb 
**  11/09/92  em    Removed prompt text field (PT) because of JobClass and
**                  JobAction changes.  
**  12/20/92 gjc    added window close logic to fix bug 6.
**  06/04/94  em    reversed concatenation of response with j.response
**  09/10/01  em    Enhanced to Support download and Return of Phase information
**                  to and from the Substation Operator
**  11/04/02  em    Job to JIP. 
**  03/06/03  ysp   Changed Clr to CLR
**  05/02/03  em    Don't allow Cancel button at Issue time.  It is messing up 
**                  TC feeder statuses, because Job Actions are not being undone
**                  if cancelled in mid stream.  Best to Abort move after 
**                  issuing.
**  02/18/04  em    Exit during automatic execution
**  09/01/05  em    Don't allow adjustment if returned from RR
*/

INITIALIZE
(
    JIP = JobInProgress;		/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;    /* Return Code */
    J   = Job;                          /* Used for Job Response Update */
) =
BEGIN
/*
** Attempt to load Phase information to determine whether to set 
** up for issue or completion.
*/
   SELECT :initA = InitialPhaseA
         ,:initB = InitialPhaseB
         ,:initC = InitialPhaseC
         ,:finA  = FinalPhaseA
         ,:finB  = FinalPhaseB
         ,:finC  = FinalPhaseC
   FROM   IR_Phases
   WHERE  Job = :JIP.Job;

   IF iirowcount = 0 THEN
      FIELD(return_comment).CurBias = FB_INVISIBLE;
      FIELD(complete_trim).CurBias = FB_INVISIBLE;
      finA = '';
      FIELD(finA).CurBias = FB_INVISIBLE;
      FIELD(finB).CurBias = FB_INVISIBLE;
      FIELD(finC).CurBias = FB_INVISIBLE;
   ELSE
/*
** Row Exists, assume completion, now determine whether it was returned
** via RR and if it was modified.
*/ 
      FIELD(initA).CurBias = FB_VISIBLE;
      FIELD(initB).CurBias = FB_VISIBLE;
      FIELD(initC).CurBias = FB_VISIBLE;

      IF finA = '' THEN
         return_comment.mod_toggle = FALSE;
         finA = initA;
         finB = initB;
         finC = initC;
      ELSE
         IF (initA <> finA) OR (initB <> finB) OR (initC <> finC) THEN
            return_comment.mod_toggle = TRUE;
            FIELD(finA).CurBias = FB_VISIBLE;
            FIELD(finB).CurBias = FB_VISIBLE;
            FIELD(finC).CurBias = FB_VISIBLE;
         ENDIF;
      ENDIF;  
   ENDIF;
/*
** Disable cancel at all times.
*/
   FIELD(cancelbutton).CurBias = FB_INVISIBLE;
   IF AutomaticExecution = TRUE THEN
      JIP.Response = 'A=' + finA + '; B=' + finB + '; C=' + finC;
      J.Job = JIP.Job;
      J.Response = JIP.Response;
      J.ResponseUpd();
      RETURN(PU_OK);
   ENDIF;
END;

ON Click OKButton =

   BEGIN
        IF finA = '' THEN 
           IF initA = '' THEN
              MESSAGE 'Please mark Phase A...';
              RESUME;
           ENDIF;
           IF initB = '' THEN
              MESSAGE 'Please mark Phase B...';
              RESUME;
           ENDIF;
           IF initC = '' THEN
              MESSAGE 'Please mark Phase C...';
              RESUME;
           ENDIF;

           RetCode = CALLPROC IR_PhasesIns (
               Job = JIP.Job
              ,PhaseA = initA
              ,PhaseB = initB
              ,PhaseC = initC);
 
           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage =
                         'ERROR: Unable to record Phases due to an error.',
                                   TraceMessage =
                         'PromptPhases: ' +
                         'Unable to record phases for Job=' +
                         VARCHAR(JIP.Job) + '.'
                                   );
              RESUME;
           ENDIF;
           CALLPROC DDB_COMMIT;

	   JIP.Response = 'A=' + initA + '; B=' + initB + '; C=' + initC;           
           J.Job = JIP.Job;
           J.Response = JIP.Response;
           J.ResponseUpd();
        ELSE
           RetCode = CALLPROC IR_PhasesDel (
               Job = JIP.Job);
  
           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage =
                         'ERROR: Unable to delete Phases due to an error. ' +
                         'Have tech support look at trace log.',
                                   TraceMessage =
                         'PromptPhases: ' +
                         'Unable to delete phases for Job=' +
                         VARCHAR(JIP.Job) + '.'
                                   );
              RESUME;
           ENDIF;
           CALLPROC DDB_COMMIT;

	   JIP.Response = 'A=' + finA + '; B=' + finB + '; C=' + finC;
           J.Job = JIP.Job;
           J.Response = JIP.Response;
           J.ResponseUpd();
        ENDIF;
	RETURN (PU_OK);
   END;

ON Click CancelButton =

   BEGIN
	RETURN (PU_Cancel);
   END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;
							 *Default Item

							 *Default Item

							 *Default Item

							 *Default Item

							 *Default Item

							 *Default Item


