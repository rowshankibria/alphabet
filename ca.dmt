	Name:            BuildCTSEOSReason

/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    SOA
**  Frame:          BuildCTSEOSReason
**
**  Date:       Author   Description
** ----------------------------------
**  01/15/08    pkw      Created
**  01/22/08    pkw      Only get equipment related to card.
**
*/
INITIALIZE 
(
#  include StandardDeclarations
   PassedCard = INTEGER     NOT NULL WITH DEFAULT;
   PassedApp  = VARCHAR(40) NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   i = 1;
   SelectPhrase.Clear();
   SELECT :SelectPhrase[i].Name = T.Name
   FROM    Udb_Type T,
           Udb_SuperType ST
   WHERE   ST.SuperType = :Type$CTSEOSPhrases AND
           ST.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   i = 1;
   SelectEquip.Clear();
   IF PassedApp = Application$SLC THEN
      SELECT :SelectEquip[i].EquipClassName = O.TypeName,
             :SelectEquip[i].EquipName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G,
              SOA_ActiveObject AO
      WHERE   AO.Card = :PassedCard AND
              AO.ObjectToCardLink = 1 AND /* Just get equipment in Substation */
              AO.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT ET.Type
                               FROM   Udb_ExtendedType ET,
                                      SOA_OutageEquipType OT
                               WHERE  ET.SuperType = OT.Type) AND
              G.Member = O.Object
      BEGIN
         i = i + 1;
      END;   
   ELSEIF PassedApp = Application$TFMS THEN
      SELECT :SelectEquip[i].EquipClassName = 'Feeder',
             :SelectEquip[i].EquipName = O.Name,
             :k = 1
      FROM    Udb_Object O,
              TFMS_CardToObject CTO
      WHERE   CTO.Card = :PassedCard AND
              CTO.Status = 1 AND  /* Just get Lines */
              CTO.Object = O.Object
      UNION
      SELECT  O.TypeName,
              O.Name,
              2
      FROM    Udb_Object O,
              Udb_Grouping G,
              TFMS_CardToObject CTO
      WHERE   CTO.Card = :PassedCard AND
              CTO.Status = 1 AND  /* Just get equipment on Lines */
              CTO.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT ET.Type
                               FROM   Udb_ExtendedType ET,
                                      SOA_OutageEquipType OT
                               WHERE  ET.SuperType = OT.Type) AND
              G.Member = O.Object
      ORDER BY 3  /* Want feeders on top of list */
      BEGIN
         i = i + 1;
      END;
   ENDIF;
END;

ON CHILDENTRY SelectPhrase = 
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   i = FIELD(SelectPhrase).CurRow;
   PassedDescription = SQUEEZE(PassedDescription + ' ' + SelectPhrase[i].Name);
END;

ON CHILDENTRY SelectEquip = 
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   i = FIELD(SelectEquip).CurRow;
   PassedDescription = SQUEEZE(PassedDescription + ' ' + 
       SelectEquip[i].EquipClassName + ' ' + SelectEquip[i].EquipName);
END;

ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
   /*
   ** Validate data was entered.
   */
   IF Length(Squeeze(PassedDescription)) <= 10 THEN
      MESSAGE 'You must enter more explanation.';
      RESUME;
   ENDIF;
   /*
   **  Make sure they didn't just hold one key down.
   **  Check first five characters.
   */
   Tempchar = left(PassedDescription,1);
   FOR i = 2 to 5 DO
      IF TempChar <> right(left(PassedDescription,i),1) THEN
         endloop;
      ENDIF;
   ENDFOR;
   IF i > 5 THEN
      MESSAGE 'Repeated letters are hard to read.  ' +
              'Please re-enter reason for outage.';
      PassedDescription = '';
      RESUME;
   ENDIF;
   
   RETURN;
END;

ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

