Application Component Report
============================

	Name:            PromptSetCurrentlyOpen

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptSetCurrentlyOpen
**
**  Modifications:
**  10/19/94   mts  Initial
**  03/20/96   pkw  highlight xfer button
**  05/13/96   em   add call to feedercard header manager
**  06/18/96   pw   set xferflag in card table      
**  03/22/99   em   included in SOA.  Commented out FMS specifics.   
**  07/02/02   ysp  Merge: Run FMS specifics for FMS Job   
**  11/01/02   em   Job to JIP.  Disable Xfer Flag functions.
**  12/18/03   em   Exit if in Process Auto SetUp mode
**  02/20/04   em   Convert Message to TraceError call
**  03/25/04   em   On Steam card, look to see if ISO Valve is
**                  being opened. If so, we can update top of card.
**                  Removed commented xfer button code.
**  03/23/06   em   Add call to ConnectedSourceCutOutTrace for 
**                  potential connectivity based FMS Card CutOut 
**                  processing.
**  08/08/07   em   Add ISO Valve to procedure call.
**  09/27/07   pkw  Make call to TOMS outage monitor.
**  10/20/07   pkw  Add SwitchingItem to fms_objectstatusins call.
**  10/24/07   pkw  Use database time for FMS_ObjectStatusQueue Insert.
**  01/17/08   pkw  Select time from soa_job table for FMS_ObjectStatusQueue insert.
**  01/22/08   em   Clear SDS Main ISOValveClosed Status if necessary.
**  09/15/09   ysp  Substation Audit Log: add TORS and DOName to object status queue.
**                  Also remove the restriction that excludes FMS application.
**  09/24/09   em   Confirm equip status change before inserting into Status Queue.
**  03/05/11   pkw  Modify for role$dso.
**  11/02/11   ysp  Set SWP Outage Report's Actual Outage Date, if SWP is being managed.
**  06/24/14   em   Remove NormalOpen for DSO valve due to DB proc change
**  07/29/14   em   Change procedure call for DSO
**  09/19/14   ysp  Use SWPOutageReport class to handle swp updates
**  03/01/17   em   Prepare DB Event Queue record when HTV-Fdr equipment status changes; remove
**                  SWP Outage logic by commenting it out.
**  03/20/17   em   HTV Breaker status for Manhattan only
**  09/05/17   em   Re-enable Outage logic for repurposed OutageMonitor.
**  10/30/17   em   Re-enable SWP Actual outage logic.
**  02/20/18   em   Always make call to set SWP Actual even when Status hasn't changed.
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL; 
    ISOValveCard = INTEGER NOT NULL WITH DEFAULT;  
    ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
    DBTime  = DATE NOT NULL WITH DEFAULT;
    HTV = INTEGER NOT NULL WITH DEFAULT;
    StatusChange = INTEGER NOT NULL WITH DEFAULT;
    SingleSWP = OutageReport DEFAULT NULL;
) =
BEGIN
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;
   
   IF CurrentApplication = Application$DSO THEN

      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName =  'currentlyopen',
                FieldValue = 1
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Currently Open device status.',
                           TraceMessage =
               'PromptSetCurrentlyOpen: Unable to set Currently Open ' +
               'device status for switch object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;
   ELSE 

      StatusChange = FALSE;
      SELECT  :StatusChange = 1    /*TRUE*/
      FROM    Udb_Switch
      WHERE   Object = :JIP.Equip AND
              CurrentlyOpen = 0;
 
      RetCode = CALLPROC Udb_SwitchCurrentUpd(
                         Object = JIP.Equip,
                         CurrentlyOpen = 1);

      IF (RetCode <> 0) THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Currently Open device status.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to set Currently Open ' +
               'device status for switch object=' + VARCHAR(JIP.Equip) + '.'
                           );
         RETURN (PU_CANCEL);
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF CurrentApplication = Application$SDS THEN
      ISOValveCard = 0;
      REPEATED
      SELECT  :ISOValveCard = C.Card
      FROM    SOA_ActiveObject C,
              Udb_Grouping G
      WHERE   G.Member = :JIP.Equip AND
              G.Relationship = :Interaction$SourcePosition AND
              G.Grouping = C.Object AND
              C.ObjectToCardLink = 1;

      IF ISOValveCard <> 0 THEN
         RetCode = CALLPROC SDS_ISOValveUpd (
                         Card = ISOValveCard,
                         ISOValve = :JIP.Equip,
                         Status = 1);
         IF (RetCode <> 0) THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
               'ERROR: Unable to Update ISO Valve Status at top of card.',
                           TraceMessage =
               'PromptClearCurrentlyOpen: Unable to Update ISO Valve Status ' +
               'for Card=' + VARCHAR(ISOValveCard) + '.'
                           );
         ELSE
            CALLPROC DDB_COMMIT;         
         ENDIF;
      ENDIF;
      CALLFRAME PromptOpenISOValve (JIP = JIP);
   ELSE
      CALLPROC FMS_ManageCardHeader (Equip = JIP.Equip);
      CALLPROC ConnectedSourceCutOutTrace (JIP = JIP, CloseOrOpen = 0);
      /*
      ** this breaker may be on a card where a scheduled outage is being managed.  
      **/
      SingleSWP = OutageReport.Create();
      SingleSWP.SetActualOutageDate(JIP = JIP);
   ENDIF;

   IF StatusChange = TRUE THEN
      /*
      **  Select times from database in case user is using manual entry mode.
      */
      DBTime = '';
      IF JIP.Status = Job$TakeOut THEN
         SELECT :DBTIME = IFNULL(J.TOComplete,'')
         FROM    SOA_Job J
         WHERE   J.Job = :JIP.Job;
      ELSEIF JIP.Status = Job$Restore THEN
         SELECT :DBTIME = IFNULL(J.RSComplete,'')
         FROM    SOA_Job J
         WHERE   J.Job = :JIP.Job;        
      ENDIF;
      IF DBTime = '' THEN
         SELECT :DBTime = DATE('NOW');
      ENDIF;
/*
** Determine if Job Equip is an HTV-Fdr to initiate HTV Breaker Status change email.
*/
      HTV = 0;
      REPEATED
      SELECT :HTV = ET.Type
      FROM   Udb_ExtendedType ET,
             Udb_Object O,
             Udb_Grouping G1, 
             Udb_Grouping G2
      WHERE  ET.SuperType = :Type$HTVFdr AND
             ET.Type = O.Type AND 
             O.Object = :JIP.Equip AND
             O.Object = G1.Member AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = :Division$Manhattan;

      IF HTV > 0 THEN
         ControlText = VARCHAR(JIP.Equip) + ';OPENED;' + VARCHAR(DBTime) + ';';
         CALLPROC InsertDBEventQueue(
                    ToApp = 'CSD',
                    EventName = 'FMS_HTVEmail',
                    EventText = ControlText);  
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** Save Open status for OutageMonitor processing
*/
      RetCode = CALLPROC FMS_ObjectStatusQueueIns (
            Time = DBTime,
            Object = JIP.Equip,
            Status = 1,
            Job = JIP.Job,
            TORS = JIP.ToRs,
            Card = JIP.Card,
            SwitchingItem = JIP.SwitchingItem,
            FromApp = CurrentApplication,
            DOName = DOp.Description);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                        TraceMessage =
            'PromptSetCurrentlyOpen: Unable to insert row into the ' +
            'FMS_ObjectStatusQueue table for Equip = ' + Varchar(JIP.Equip));
      ELSE 
         CALLPROC DDB_COMMIT;
         CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ObjectStatusQueue');
         CALLPROC DDB_COMMIT;
      ENDIF;

   ENDIF;
   RETURN (PU_OK);
END;


Application Component Report
============================

	Name:            PromptSetGroundBkrSide

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSetGroundBkrSide          
**
**  Modifications:
**  03/31/05   em   Created for TOMS
**  08/30/05   em   Corrected SQL grammar error.
**  12/21/06   em   Include BkrSpare
**  04/05/17   em   Converted to use QGIS connectivity trace.
**                  Added BkrRO and BkrROSpare.
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    i  = INTEGER NOT NULL WITH DEFAULT;     
    GroundTerminal  = INTEGER NOT NULL WITH DEFAULT;     /* Terminal to Ground */

    RetCode         = INTEGER;
    SelectCount     = INTEGER NOT NULL WITH DEFAULT;     /* Number of Existing Grounds */
    TargetTypes = ARRAY OF IntegerObject;
    Trace = Trace_AdjacentEquipment DEFAULT NULL;
) =
BEGIN
   GroundTerminal = 0;
/*
** Look at connectivity for each Terminal.
*/
   TargetTypes[1].Value = Type$Bkr;
   TargetTypes[2].Value = Type$BkrSpare;
   TargetTypes[3].Value = Type$BkrRO;
   TargetTypes[4].Value = Type$BkrROSpare;
   Trace = Trace_AdjacentEquipment.Create();
   RetCode = Trace.FindAdjacentEquipment(JobEquip = JIP.Equip,
                                         TargetTypes = TargetTypes);
   IF RetCode = TraceStatus$TargetFound THEN
      FOR i = 1 TO Trace.PathResultList.LastRow DO
         IF Trace.PathResultList[i].Status = TraceStatus$TargetFound THEN
            GroundTerminal = Trace.PathResultList[i].FirstEquip.Object;
         ENDIF;
      ENDFOR;
   ENDIF;

   IF GroundTerminal = 0 THEN
       GroundTerminal = CALLFRAME SelectTerminal(
                                           JIP = JIP,
                                           Action = 'placed');
   ENDIF;
/*
**  Place Ground and set Move color to red 
*/
   SelectCount = 0;     /*Check for Count Existence */
   SELECT :SelectCount = StatusCount
   FROM   FMS_ObjectStatus 
   WHERE  Object   = :JIP.Equip AND
          Terminal = :GroundTerminal AND
          Status   = :Status$Ground;
                       
   IF SelectCount = 0 THEN
      RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = JIP.Equip,
                     		      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
   ELSE    
      RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	    	                      Object = JIP.Equip, 
                                      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      increment = 1,
                                      TimeSet = date('now'));
   ENDIF; 
                  
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
                       'Error incrementing an Object Status.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptSetGroundBkrSide; ' +
                       'Error incrementing an Object Status. ' +
                       'Object=' + VARCHAR(JIP.Equip) +
                       ';Ground Status=' + VARCHAR(Status$Ground) + '.'
                       );
      RETURN (PU_Cancel);
   ENDIF;
   CALLPROC DDB_COMMIT;
/*               
**   Set GroundOn field if this is a takeout to signal that this move
**   set the ground.
*/                
   IF JIP.ToRs = Job$TakeOutInt THEN
      JIP.GroundOn = 'now';
   ELSE
      JIP.GroundOn = NULL;
   ENDIF;

   RetCode = CALLPROC SOA_GroundOnUpd (
                                 GroundOn = JIP.GroundOn,
                                 Job      = JIP.Job,
                                 Equip    = JIP.Equip
                                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error making Ground Move turn red.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'PromptSetGroundkrSide; ' +
               'Error setting Ground On value for. ' +
               'Job=' + VARCHAR(JIP.Job) +
               ';Equip=' + VARCHAR(JIP.Equip) + '.'
               );
      RETURN (PU_Cancel);
   ENDIF;         
   CALLPROC DDB_COMMIT;  
/*
** Manage Card Header for Grounds.
*/
   CALLPROC FMS_ManageCardHeader (Equip = JIP.Equip);

   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptSetGroundBreakerSide

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSetGroundBreakerSide          
**
**  Modifications:
**  02/28/05   em   Created
**  03/16/06   em   In order to support phased implementation to production,
**                  the Apply Station Ground move where this Prompt will be setup
**                  must use this prompt if the feeder is setup with a connected
**                  source.  If it is not connected, then this prompt must
**                  increment/decrement directly on the device so that the 
**                  Job Action to Inc/Decr the equip ground count can be removed.
**                  A Job Class should not call both this prompt and also inc/dec
**                  the Equip Ground Count.
**                  Thus this prompt will not exit without acting on a Ground - with 
**                  default Terminal = 0.
** 02/01/07    em   If we are starting the trace from the Source Breaker, then we
**                  need to do something different to find the Breaker Side Terminal 
**                  which would be on the bus side.  We look for Fdr-Load along with 
**                  Feeder Source.
** 11/28/07    em   Minor tweaks to ensure ground is set; removed check for Automation since 
**                  Select Terminal does that already.
** 04/22/09    em   Remove UserMessage when device is not connected. 
** 11/05/10    em   Handling when prompt is called for a 3G card.
** 01/07/11    em   3G Position length increased to 20 Characters
** 04/18/14    pkw  If equipment is not connected set SkipSetTerminal flag.
** 04/10/17    em   Convert for QGIS Model trace
** 07/18/17    em   Modification for SelectTerminal return
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    i = INTEGER NOT NULL WITH DEFAULT;
    fl = INTEGER NOT NULL;
    k = INTEGER;
    x = INTEGER NOT NULL WITH DEFAULT;

    Card         = INTEGER NOT NULL WITH DEFAULT;     /* FMS Card  */
    Current_Position = VARCHAR(20) NOT NULL WITH DEFAULT; 
    FdrLoad        = ARRAY OF INTEGEROBJECT;
    Feeder          = INTEGER NOT NULL WITH DEFAULT;     /* FMS Card Feeder */
    FeederLoadFound   = INTEGER NOT NULL WITH DEFAULT;/* BOOLEAN */
    FeederName      = VARCHAR(40) NOT NULL WITH DEFAULT; /* FMS Card Feeder */
    Feeder3G       = ARRAY OF ObjectSummaryClass; 
    GroundTerminal  = INTEGER NOT NULL WITH DEFAULT;     /* Terminal to Ground */
    NetworkFeeder          = INTEGER NOT NULL WITH DEFAULT;     /* FMS 3G Card  */
    RetCode         = INTEGER;
    SelectCount     = INTEGER NOT NULL WITH DEFAULT;     /* Number of Existing Grounds */
    SourceBreaker   = INTEGER NOT NULL WITH DEFAULT;     /* Feeder Source Breaker */
    SourceBreakerFound   = INTEGER NOT NULL WITH DEFAULT;/* BOOLEAN */
    Source3GFeeder = INTEGER NOT NULL WITH DEFAULT;
    TraceEnabled    = INTEGER NOT NULL WITH DEFAULT;

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    CloseLoop      = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;

    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

    SkipSetTerminal = INTEGER NOT NULL;
    OutBoundType   = INTEGER NOT NULL;    /*Look at OutBoundTypes*/    
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    Trace          = Trace_DistFdrGround;
) =
BEGIN
   GroundTerminal = 0;
   SourceBreakerFound = FALSE;
   SkipSetTerminal = FALSE;
/*
** if job is not on an FMS card, then no need to do a connectivity trace
*/
   Feeder = 0;
   NetworkFeeder = FALSE;
   REPEATED
   SELECT :Feeder = C.Feeder,
          :FeederName = C.FeederName,
          :NetworkFeeder = C.NetworkFeeder,
          :Current_Position = C.Position,
          :Card = C.Card
   FROM   FMS_Card C,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card;

   IF Feeder = 0 THEN
      CALLPROC TraceError (TraceMessage = 'Job Action SetGroundBreakerSide invoked on a move ' +
                                           'that is not on an FMS card. Job=' + VARCHAR(JIP.Equip),
                           UserMessage  = 'JobAction SetGroundBreakerSide is being called incorrectly ' +
                                           'on a move that is not on a Feedercard.  Ground placed ON equip.');
   ENDIF;
   
   SELECT :SkipSetTerminal = OID
   FROM   DSO_Connection
   WHERE  FromObj = :JIP.Equip OR
          ToObj = :JIP.Equip;

   IF SkipSetTerminal = FALSE THEN 
/* 
** Not Connected
*/
      SkipSetTerminal = TRUE;
   ENDIF;  
/*
** If 3G card, then we need to identify the source feeder.
** If feeder does not have a source breaker, then no need to do a connectivity trace
*/
   IF NetworkFeeder = FALSE THEN

      SourceBreaker = 0;
      SELECT :SourceBreaker = Member
      FROM   Udb_Grouping
      WHERE  Grouping = :Feeder AND
             Relationship = :Interaction$SourceBreaker;

      IF SourceBreaker = 0 THEN
         CALLPROC TraceError (TraceMessage = 'Job Action SetGroundBreakerSide invoked on a feeder ' +
                                           'that does not have a Source Breaker. Feeder=' + FeederName,
                           UserMessage  = 'JobAction SetGroundBreakerSide is being called incorrectly ' +
                                           'for a feeder that has no Source Breaker.  Ground placed ON equip.');
      ENDIF;

   ELSE

      Feeder3G.Clear();
      Source3GFeeder = 0;
      i = 1;   
      REPEATED     
      SELECT :Feeder3G[i].Object = O.Object,
             :Feeder3G[i].PrimaryGrouping = O.PrimaryGrouping
      FROM   TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object O2
      WHERE  CTO.Card = :Card AND
             CTO.Type = :Type$Feeder AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = O2.Object AND
             O2.Type = :Type$Substation
      BEGIN
/*
** If Primary Grouping is a Substation then this feeder might be the source.
** (Two feeders could be primary grouped with substation if 3G is connected all around.)
** We can confirm the 3G Source Feeder based on the Source Breaker device name in the Position
** field of the card.  Hopefully this logic works if two 3G feeders on the card are connected to a station. 
*/
            IF Source3GFeeder = 0 THEN
               x = 0;
               REPEATED
               SELECT :x = G.Member
               FROM   Udb_Object O,
                      Udb_Grouping G
               WHERE  G.Grouping = :Feeder3G[i].Object AND
                      G.Relationship = :Interaction$SourceBreaker AND
                      G.Member = O.Object AND
                      O.Name = :Current_Position;

               IF x = 0 THEN
                  Source3GFeeder = 0;
               ELSE
                  Source3GFeeder = Feeder3G[i].Object;
                  SourceBreaker = x;
               ENDIF;
            ENDIF;
            i = i + 1;
      END;
      Feeder = Source3GFeeder;
   ENDIF;

   TraceEnabled = 0;
   SELECT :TraceEnabled = Feeder
   FROM   FMS_ConnectedSource
   WHERE  Feeder = :Feeder;

   Trace = Trace_DistFdrGround.Create();
   IF TraceEnabled <> 0 AND SkipSetTerminal <> FALSE THEN
/*
** Load all equipment on the feeder to make scope check simple
*/
   i = 1;
   CardObjects.Clear();
   REPEATED
   SELECT 
   DISTINCT 
            :Trace.FeederScope[i].Value = G.Member
   FROM    Udb_Grouping G,
           Udb_ExtendedType ET
   WHERE   G.Grouping = :Feeder AND   
           G.Relationship = :Interaction$MemberOf AND
           G.MemberType = ET.Type AND
           ET.SuperType = :Type$Switch
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;

   Trace.TargetTypeList[1].Value = SourceBreaker;
   RetCode = Trace.StartTargetTrace(StartEquipObject = JIP.Equip, 
                                        StartEquipSubstation = JIP.Substation);

   IF RetCode = TraceStatus$TargetFound THEN
      FOR i = 1 TO Trace.PathResultList.LastRow DO
         IF Trace.PathResultList[i].Status = TraceStatus$TargetFound THEN
            GroundTerminal = Trace.PathResultList[i].FirstEquip.Object;
         ENDIF;
      ENDFOR;
   ENDIF;
/*
**  If we did not find source breaker, we will present Select Terminal
*/
   IF GroundTerminal = 0 AND SkipSetTerminal = FALSE THEN
       GroundTerminal = CALLFRAME SelectTerminal(
                                           JIP = JIP,
                                           Action = 'placed');
   ENDIF;

   ENDIF;  /*End of Trace Enabled Logic*/
/*
**  Place Ground and set Move color to red 
*/
   SelectCount = 0;     /*Check for Count Existence */
   SELECT :SelectCount = StatusCount
   FROM   FMS_ObjectStatus 
   WHERE  Object   = :JIP.Equip AND
          Terminal = :GroundTerminal AND
          Status   = :Status$Ground;
                       
   IF SelectCount = 0 THEN
      RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = JIP.Equip,
                     		      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
   ELSE    
      RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	    	                      Object = JIP.Equip, 
                                      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      increment = 1,
                                      TimeSet = date('now'));
   ENDIF; 
                  
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
                       'Error incrementing an Object Status.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptSetGroundBreakerSide; ' +
                       'Error incrementing an Object Status. ' +
                       'Object=' + VARCHAR(JIP.Equip) +
                       ';Ground Status=' + VARCHAR(Status$Ground) + '.'
                       );
      JIP.Response = 'Error Setting Ground';
      JIP.ResponseUpd();
      RETURN (PU_Cancel);
   ENDIF;
   CALLPROC DDB_COMMIT;
/*               
**   Set GroundOn field if this is a takeout to signal that this move
**   set the ground.
*/                
   IF JIP.ToRs = Job$TakeOutInt THEN
      JIP.GroundOn = 'now';
   ELSE
      JIP.GroundOn = NULL;
   ENDIF;

   RetCode = CALLPROC SOA_GroundOnUpd (
                                 GroundOn = JIP.GroundOn,
                                 Job      = JIP.Job,
                                 Equip    = JIP.Equip
                                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error making Ground Move turn red.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'PromptSetGroundBreakerSide; ' +
               'Error setting Ground On value for. ' +
               'Job=' + VARCHAR(JIP.Job) +
               ';Equip=' + VARCHAR(JIP.Equip) + '.'
               );
      JIP.Response = 'Error No Red Ground';
      JIP.ResponseUpd();
      RETURN (PU_Cancel);
   ENDIF;         
   CALLPROC DDB_COMMIT;  
/*
** Manage Card Header for Grounds.
*/
   CALLPROC FMS_ManageCardHeader (Equip = JIP.Equip);

   RETURN (PU_OK);
END;


Application Component Report
============================

	Name:            PromptSetGroundFeederSide

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptSetGroundFeederSide          
**
**  Modifications:
**  06/14/05   em   Created; Reversed Breaker Side Prompt
**  03/16/06   em   In order to support phased implementation to production,
**                  the Apply Station Ground move where this Prompt will be setup
**                  must use this prompt if the feeder is setup with a connected
**                  source.  If it is not connected, then this prompt must
**                  increment/decrement directly on the device so that the 
**                  Job Action to Inc/Decr the equip ground count can be removed.
**                  A Job Class should not call both this prompt and also inc/dec
**                  the Equip Ground Count.
**                  Thus this prompt will not exit without acting on a Ground - with 
**                  default Terminal = 0.
** 02/01/07    em   If we are starting the trace from the Source Breaker, then we
**                  need to do something different to find the Feeder Side Terminal 
**                  which would be on the Feeder side.  We look for Fdr-Load along with 
**                  Feeder Source.
** 11/28/07    em   Minor tweaks to ensure ground is set; removed check for Automation since 
**                  Select Terminal does that already.
** 04/22/09    em   Remove user message when feeder not connected.
** 11/01/10    em   Handling when prompt is called for a 3G card.
** 01/07/11    em   3G Position length increased to 20 Characters
** 04/18/14    pkw  If equipment is not connected set SkipSetTerminal flag.
** 04/10/17    em   Convert for QGIS Model trace
**/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    i = INTEGER NOT NULL WITH DEFAULT;
    fl = INTEGER NOT NULL;
    k = INTEGER;
    x = INTEGER NOT NULL WITH DEFAULT;

    Card         = INTEGER NOT NULL WITH DEFAULT;     /* FMS Card  */
    Current_Position = VARCHAR(20) NOT NULL WITH DEFAULT; 
    FdrLoad        = ARRAY OF INTEGEROBJECT;
    Feeder          = INTEGER NOT NULL WITH DEFAULT;     /* FMS Card Feeder */
    FeederName      = VARCHAR(40) NOT NULL WITH DEFAULT; /* FMS Card Feeder */
    FeederLoadFound   = INTEGER NOT NULL WITH DEFAULT;/* BOOLEAN */
    Feeder3G       = ARRAY OF ObjectSummaryClass; 
    GroundTerminal  = INTEGER NOT NULL WITH DEFAULT;     /* Terminal to Ground */
    NetworkFeeder          = INTEGER NOT NULL WITH DEFAULT;     /* FMS 3G Card  */
    RetCode         = INTEGER;
    SelectCount     = INTEGER NOT NULL WITH DEFAULT;     /* Number of Existing Grounds */
    SourceBreaker   = INTEGER NOT NULL WITH DEFAULT;     /* Feeder Source Breaker */
    SourceBreakerFound   = INTEGER NOT NULL WITH DEFAULT;/* BOOLEAN */
    Source3GFeeder = INTEGER NOT NULL WITH DEFAULT;
    TraceEnabled    = INTEGER NOT NULL WITH DEFAULT;

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    CloseLoop      = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;

    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

    SkipSetTerminal = INTEGER NOT NULL;
    OutBoundType   = INTEGER NOT NULL;    /*Look at OutBoundTypes*/    
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    Trace 	   = Trace_DistFdrGround
) =
BEGIN
   GroundTerminal = 0;
   SourceBreakerFound = FALSE;
   SkipSetTerminal = FALSE;
/*
** if job is not on an FMS card, then no need to do a connectivity trace
*/
   Feeder = 0;
   NetworkFeeder = FALSE;
   REPEATED
   SELECT :Feeder = C.Feeder,
          :FeederName = C.FeederName,
          :NetworkFeeder = C.NetworkFeeder,
          :Current_Position = C.Position,
          :Card = C.Card
   FROM   FMS_Card C,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card;

   IF Feeder = 0 THEN
      CALLPROC TraceError (TraceMessage = 'Job Action SetGroundFeederSide invoked on a move ' +
                                           'that is not on an FMS card. Job=' + VARCHAR(JIP.Equip),
                           UserMessage  = 'JobAction SetGroundFeederSide is being called incorrectly ' +
                                           'on a move that is not on a Feedercard.  Ground placed ON equip.');
   ENDIF;
   
   SELECT :SkipSetTerminal = OID
   FROM   DSO_Connection
   WHERE  FromObj = :JIP.Equip OR
          ToObj = :JIP.Equip;

   IF SkipSetTerminal = FALSE THEN 
/* 
** Not Connected
*/
      SkipSetTerminal = TRUE;
   ENDIF;  
/*
** If 3G card, then we need to identify the source feeder.
** If feeder does not have a source breaker, then no need to do a connectivity trace
*/
   IF NetworkFeeder = FALSE THEN

      SourceBreaker = 0;
      SELECT :SourceBreaker = Member
      FROM   Udb_Grouping
      WHERE  Grouping = :Feeder AND
             Relationship = :Interaction$SourceBreaker;

      IF SourceBreaker = 0 THEN
         CALLPROC TraceError (TraceMessage = 'Job Action SetGroundFeederSide invoked on a feeder ' +
                                           'that does not have a Source Breaker. Feeder=' + FeederName,
                              UserMessage  = 'JobAction SetGroundFeederSide is being called incorrectly ' +
                                           'for a feeder that has no Source Breaker.  Ground placed ON equip.');
      ENDIF;

   ELSE

      Feeder3G.Clear();
      Source3GFeeder = 0;
      i = 1;   
      REPEATED     
      SELECT :Feeder3G[i].Object = O.Object,
             :Feeder3G[i].PrimaryGrouping = O.PrimaryGrouping
      FROM   TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object O2
      WHERE  CTO.Card = :Card AND
             CTO.Type = :Type$Feeder AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = O2.Object AND
             O2.Type = :Type$Substation
      BEGIN
/*
** If Primary Grouping is a Substation then this feeder might be the source.
** (Two feeders could be primary grouped with substation if 3G is connected all around.)
** We can confirm the 3G Source Feeder based on the Source Breaker device name in the Position
** field of the card.  Hopefully this logic works if two 3G feeders on the card are connected to a station. 
*/
         IF Source3GFeeder = 0 THEN
            x = 0;
            REPEATED
            SELECT :x = G.Member
            FROM   Udb_Object O,
                   Udb_Grouping G
            WHERE  G.Grouping = :Feeder3G[i].Object AND
                   G.Relationship = :Interaction$SourceBreaker AND
                   G.Member = O.Object AND
                   O.Name = :Current_Position;

            IF x = 0 THEN
               Source3GFeeder = 0;
            ELSE
               Source3GFeeder = Feeder3G[i].Object;
               SourceBreaker = x;
            ENDIF;
         ENDIF;
         i = i + 1;
      END;
      Feeder = Source3GFeeder;
   ENDIF;

   TraceEnabled = 0;
   SELECT :TraceEnabled = Feeder
   FROM   FMS_ConnectedSource
   WHERE  Feeder = :Feeder;

   Trace = Trace_DistFdrGround.Create();
   IF TraceEnabled <> 0 AND SkipSetTerminal <> FALSE THEN
/*
** Load all equipment on the feeder to make scope check simple
*/
      i = 1;
      REPEATED
      SELECT 
      DISTINCT 
               :Trace.FeederScope[i].Value = G.Member
      FROM    Udb_Grouping G,
              Udb_ExtendedType ET
      WHERE   G.Grouping = :Feeder AND   
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = ET.Type AND
              ET.SuperType = :Type$Switch
      ORDER BY 1
      BEGIN
         i = i + 1;
      END;
/*
** Find each FdrLoad device on the Feeder
*/
      i = 1;
      SELECT  :Trace.TargetTypeList[i].Value = Member
      FROM    Udb_Grouping
      WHERE   Grouping = :Feeder AND
              Relationship = :Interaction$MemberOf AND
              MemberType = :Type$FdrLoad 
      BEGIN
         i = i + 1;
      END;

      RetCode = Trace.StartTargetTrace(StartEquipObject = JIP.Equip, 
                                           StartEquipSubstation = JIP.Substation);

      IF RetCode = TraceStatus$TargetFound THEN
         FOR i = 1 TO Trace.PathResultList.LastRow DO
            IF Trace.PathResultList[i].Status = TraceStatus$TargetFound THEN
               GroundTerminal = Trace.PathResultList[i].FirstEquip.Object;
            ENDIF;
         ENDFOR;
      ENDIF;
/*
**  If we did not find Fdr Load, we will present Select Terminal 
*/
      IF GroundTerminal = 0 AND SkipSetTerminal = FALSE THEN
          GroundTerminal = CALLFRAME SelectTerminal(
                                              JIP = JIP,
                                              Action = 'placed');
      ENDIF;

   ENDIF;  /*End of Trace Enabled Logic*/
/*
**  Place Ground and set Move color to red 
*/
   SelectCount = 0;     /*Check for Count Existence */
   SELECT :SelectCount = StatusCount
   FROM   FMS_ObjectStatus 
   WHERE  Object   = :JIP.Equip AND
          Terminal = :GroundTerminal AND
          Status   = :Status$Ground;
                       
   IF SelectCount = 0 THEN
      RetCode = CALLPROC FMS_ObjStatIns(
                                      Object = JIP.Equip,
                     		      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      StatusCount = 1,
                                      TimeSet = date('now'));
   ELSE    
      RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	    	                      Object = JIP.Equip, 
                                      Status = Status$Ground,
                                      Terminal = GroundTerminal,
                                      increment = 1,
                                      TimeSet = date('now'));
   ENDIF; 
                  
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
                       'Error incrementing an Object Status.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptSetGroundFeederSide; ' +
                       'Error incrementing an Object Status. ' +
                       'Object=' + VARCHAR(JIP.Equip) +
                       ';Ground Status=' + VARCHAR(Status$Ground) + '.'
                       );
      JIP.Response = 'Error Setting Ground';
      JIP.ResponseUpd();
      RETURN (PU_Cancel);
   ENDIF;
   CALLPROC DDB_COMMIT;
/*               
**   Set GroundOn field if this is a takeout to signal that this move
**   set the ground.
*/                
   IF JIP.ToRs = Job$TakeOutInt THEN
      JIP.GroundOn = 'now';
   ELSE
      JIP.GroundOn = NULL;
   ENDIF;

   RetCode = CALLPROC SOA_GroundOnUpd (
                                 GroundOn = JIP.GroundOn,
                                 Job      = JIP.Job,
                                 Equip    = JIP.Equip
                                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'Error making Ground Move turn red.  Tech Support should be ' +
               'contacted to review your machine trace log',
                           TraceMessage =
               'PromptSetGroundFeederSide; ' +
               'Error setting Ground On value for. ' +
               'Job=' + VARCHAR(JIP.Job) +
               ';Equip=' + VARCHAR(JIP.Equip) + '.'
               );
      JIP.Response = 'Error No Red Ground';
      JIP.ResponseUpd();
      RETURN (PU_Cancel);
   ENDIF;         
   CALLPROC DDB_COMMIT;  
/*
** Manage Card Header for Grounds.
*/
   CALLPROC FMS_ManageCardHeader (Equip = JIP.Equip);

   RETURN (PU_OK);
END;





