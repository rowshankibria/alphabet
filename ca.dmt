	Name:            CheckRAPIsolation

/*
**
**	Copyright c 2008 Unified Information, Inc.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckRAPIsolation
**
**  Modifications:
**  09/18/08 em     IF RAP card and Apply Station Ground move, it is a dead stop with
**                  guidance to create transfer card.
*/
PROCEDURE CheckRAPIsolation 
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
   RetCode = PU_OK;
/*
** The first check is a hard stop.
*/
   i = 0;
   REPEATED
   SELECT
   DISTINCT
          :i = C.CardClass
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card AND
          C.CardClass = :Type$RAP;

   IF i = Type$RAP THEN
      MESSAGE 'You do not have isolation for Dead-As-Dead work.  You may transfer to a SCHD card.';
      RETURN PU_CANCEL;
   ENDIF;

   RETURN (RetCode);
END; 

Application Component Report
============================

	Name:            CheckRelatedISOotw

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckRelatedISOOTW    
**
**  Modifications:
**	 02/14/93 em	    Created 
**  03/21/94 em     Minor code adjustments
**  12/06/02 ysp    Merge: the procedure is a pre-check as well as a normal
**                  4gl procedure that is called from anywhere else. Removed
**                  passed-in Card object and Jobs array.
**  03/03/03 ysp    check for Override return code from ISO OTW proc.
**  04/13/09 em     Include Known Point Splice ISOs in this check (Subfeeders with
**                  card class ISO)
**  01/03/11 em     Add Support for 3G
**  12/01/14 em     Add Support for StepDownFeeder
**  12/19/14 em     Removed quotes around warning text parameter
**  09/14/16 em     Enable use from 33kV portion
*/
PROCEDURE  CheckRelatedISOotw    
(
/* Passed in */
    JIP = JobInProgress;				/* Job being processed */
    ISOFeeder = INTEGER NOT NULL WITH DEFAULT;     /* Pass this ISO parm */

/* local */
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    Feeders = ARRAY OF INTEGEROBJECT;		/* Card details */
    ChildISO = INTEGER NOT NULL;
    ISOorSD = INTEGER NOT NULL WITH DEFAULT; /* 0=ISO, 1=SD*/
    WarningText = VARCHAR(200) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    RetCode = INTEGER;
) =
BEGIN
/*
**  If this procedure is called from pre-check logic, ISOFeeder is equal to zero (0).  
**  Otherwise, ISOFeeder is the feeder to be checked.
*/
  IF ISOFeeder = 0 THEN    
     k = 1;
     SELECT 
     DISTINCT
            :Feeders[k].Value = AO.Object
     FROM   SOA_JobControl JC,
            SOA_ActiveObject AO,
            FMS_Card C
     WHERE  JC.Job = :JIP.Job AND
            JC.Card = AO.Card AND
            AO.ObjectToCardLink = 1 AND
            JC.Card = C.Card 
     BEGIN
        k = k + 1;
     END;
/*
** If this job is on portion card, use link to main card to include main feeder iso search.
*/
     SELECT 
     DISTINCT
            :Feeders[k].Value = AO.Object
     FROM   SOA_JobControl JC,
            SOA_ActiveObject AO,
            FMS_PortionLink PL
     WHERE  JC.Job = :JIP.Job AND
            JC.Card = PL.PortionCard AND
            PL.Card = AO.Card AND 
            AO.ObjectToCardLink = 1 
      BEGIN
        k = k + 1;
     END;

  ELSE
     Feeders[1].Value = ISOFeeder;
  ENDIF;

/*
**  Check to make sure any related ISO are not outtowork.  
**  We may have to climb down the grouping hierarchy because
**  ISO can be created from ISOs.   Go down looking for OTW Statuses
**  on any children ISOs. This procedure will recursively call itself 
**  until all ISOs have been evaluated.
*/ 

  RetCode = NULL;

  FOR k = 1 TO Feeders.LastRow() DO

     ISOOrSD = 0;
     SELECT :ChildISO = G.Member,
            :ISOorSD = 0
     FROM   Udb_Grouping G,
            FMS_Card C
     WHERE  G.Grouping = :Feeders[k].Value AND
            G.Relationship = :Interaction$MemberOf AND
           (G.MemberType = :Type$ISOFeeder OR (
            G.MemberType = :Type$SubFeeder AND 
            C.CardClass = :Type$ISO) ) AND
            G.Member = C.Feeder AND
            C.Status <> :Card$Closed
     UNION 
     SELECT C.Feeder,
            1
     FROM   FMS_StepDownLink SD,
            FMS_Card C,
            TFMS_CardToObject CTO
     WHERE  CTO.Object = :Feeders[k].Value AND
            CTO.Card = SD.Card AND
            SD.StepDownCard = C.Card 
     BEGIN
/*
**   Check if ISO out to work
*/
        i = 0;
        SELECT :i = IFNULL(COUNT(*),0)
        FROM   FMS_ObjectStatus
        WHERE  Object = :ChildISO AND
               Status = :Status$OTW AND
               StatusCount > 0;

        IF i > 0 THEN    

          IF ISOorSD = 0 THEN
             WarningText = 'A related ISO is Out To Work';
          ELSE
             WarningText = 'A related StepDown is Out To Work';
          ENDIF;
/*
**    IF JIP is NULL, we can't call our normal warning screen,
**    This routine can be called from places other than the normal
**    PreCheck routines.
*/    
          IF JIP IS NULL THEN

            IF CurProcedure.ConfirmPopup (messagetext =
               'Warning - ' + WarningText) = PU_OK THEN
 
               RetCode = Warning$Overridden;
            ELSE
               RETURN(PU_CANCEL);
            ENDIF;
             
          ELSE
 
            WarningStatus = CALLFRAME Warning 
                                     (Card = JIP.Card, 
                                      Job = JIP.Job,
                                      SwitchingItem = JIP.SwitchingItem,
                                      Text = WarningText);  
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
          ENDIF;

        ELSE 
  
            WarningStatus = CALLPROC CheckRelatedISOotw
                                (JIP = JIP, 
                                 ISOFeeder = ChildISO);
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSEIF WarningStatus = Warning$Overridden THEN
               RetCode = WarningStatus;
            ENDIF;
        ENDIF;
     END;
  ENDFOR;

  RETURN(RetCode); 

END;

Application Component Report
============================

	Name:            CheckReliefPath

/* 
**      Copyright c 2014 PATERIC SOFTWARE LLC All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          CheckReliefPath
**
**  Purpose: Verify there is at least a relief path from the pump to a tank.
**
**  Date:   Author  Description
** ----------------------------------
**  06/12/14  ysp Created
**  05/18/22  em  Use DSO_Trace_Engine components
*/
PROCEDURE CheckReliefPath (
   JIP = JobInProgress;   /*Passed Job*/				         
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;                       

   IssuedOperator = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;                     /*return variable */
   ReturnStatus = INTEGER NOT NULL WITH DEFAULT; 
   WarningText = VARCHAR(300) NOT NULL WITH DEFAULT;
   StartEquip = ARRAY OF dso_trace_engine!Equipment;
   OtherRelief = INTEGER NOT NULL WITH DEFAULT; 
   ReducedPressure = INTEGER NOT NULL WITH DEFAULT; 
   SafetyRelief = INTEGER NOT NULL WITH DEFAULT; 
   TraceClient = DSO_TraceClient;
   ValveType = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   ReturnStatus = PU_OK;
   WarningText = '';
   
   // verify equipment is pump
   i = 0;
   SELECT :i = 1
   FROM   UDB_ExtendedType ET
   WHERE  ET.Type = :JIP.EquipClass AND
          ET.SuperType = :Type$Pump;
   CALLPROC DDB_ROLLBACK;
   
   IF i=0 THEN
      WarningText = JIP.EquipClassName + ' ' + JIP.EquipName + 
            ' is not a pump. Not able to verify relief path';
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;
   ENDIF;
   
   /* 
   ** Trace from the pump for relief paths
   */
   StartEquip[1].Object = JIP.Equip;
   SELECT :StartEquip[1].Pocket = O.Pocket
   FROM   DSO_Object O
   WHERE  O.Object = :StartEquip[1].Object;
   CALLPROC DDB_ROLLBACK;
   
   IF StartEquip[1].Pocket = 0 THEN
      WarningText = 'Pocket is not set for ' + JIP.SubstationName + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName + 
            ' Not able to verify relief path';
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;   
   ENDIF;
   
   IF JIP.Status = Job$TakeOut THEN
      IssuedOperator = IFNULL(JIP.TOOperator, 0);
   ELSEIF JIP.Status = Job$Restore THEN
      IssuedOperator = IFNULL(JIP.RSOperator, 0);
   ENDIF;
   
   TraceClient.TraceForReliefLine(
      StartEquip = StartEquip,
      IssuedOperator = IssuedOperator);
   
   SafetyRelief = FALSE;
   ReducedPressure = FALSE;
   OtherRelief = FALSE;

   IF TraceClient.ReturnCode = 0 AND TraceClient.TracedPathResults.LastRow > 0THEN
      FOR i = 1 TO TraceClient.TracedPathResults[1].TargetEquip.LastRow DO
         ValveType = 0;
         SELECT :ValveType = ReliefValveType
         FROM   udb_ReliefValve
         WHERE  Object = :TraceClient.TracedPathResults[1].TargetEquip[i].Object;
         
         IF ValveType = Type$ReliefValve_Safety THEN
            SafetyRelief = TRUE;
         ELSEIF ValveType = Type$ReliefValve_Reduced THEN
            ReducedPressure = TRUE;
         ELSE
            OtherRelief = TRUE;
         ENDIF;
      ENDFOR;
      
      IF SafetyRelief = FALSE THEN
         WarningText = 'No safety relief path from ' + JIP.SubstationName + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName + 
         ' to a tank';
      ELSEIF OtherRelief = FALSE THEN
         WarningText = 'No other relief path from ' + JIP.SubstationName + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName + 
         ' to a tank';
         IF ReducedPressure = TRUE THEN
            WarningText = WarningText + '. However, there is a reduced pressure relief path open to a tank.'
         ENDIF;
      ENDIF;
   ELSE
      WarningText = 'Failed to verify relief path for ' + JIP.SubstationName + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName +
         ' due to system error: ' + TraceClient.ErrorMessage;      
   ENDIF;
   
   IF WarningText <> '' THEN
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;
   ENDIF;

   IF ReturnStatus <> PU_OK THEN
      RETURN ReturnStatus;
   ELSE
      RETURN(PU_OK);
   ENDIF;
END;

Application Component Report
============================

	Name:            CheckShutOffComplete

/*
**      Copyright c 2005 Pateric Software LLC  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckShutOffComplete
**
**  Date:    Version  Description
** --------------------------------------------------
**  04/05/05  em    For Steam, copied from CheckDeloadComplete
**  04/10/07  ysp   ITC203: Remove Move$Filtered as a job status.
**  07/26/07  em    Modified card select for multiple mains per card.
**  02/07/08  em    Included Street ShutOff step heading.
*/
PROCEDURE CheckShutOffComplete
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL; 
    CommonFeederCard = ARRAY OF CardSDS;
    AllDLJobs = ARRAY of Job;  
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
/*
**    Find all feeder cards which this piece of equipment is common too.
**    If we couldn't find a feeder then nothing more to do. 
*/
    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].CardClass = C.CardClass,
           :CommonFeederCard[i].StationName = C.StationName,
           :CommonFeederCard[i].Station = C.Station
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            SDS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN
       RETURN(NULL); 
    ENDIF;
    RetCode = NULL;
    
    FOR i = 1 TO CommonFeederCard.LastRow() DO
/*
**  For each card, check for Deload/ShutOff moves complete and that no restore 
**  moves are complete.
*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].PrintId = JC.PrintId,
               :TempJobs[k].EquipName = J.EquipName,
               :TempJobs[k].EquipClassName = J.EquipClassName,
               :TempJobs[k].ToMove = J.ToMove,
               :TempJobs[k].Job = J.Job
        FROM   SOA_Job J, 
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND
               JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
               J.TOComplete IS NULL AND
               J.Status = '' AND
               J.MoveType <> :MoveType$ISL
        BEGIN
           k = k + 1;
        END;

        IF TempJobs.LastRow() > 0 THEN
           WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      Jobs = TempJobs,
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Not all required Shut-Off moves have been completed ' +
                             'for card at ' + CommonFeederCard[i].StationName + '.' + HC_NEWLINE +
                             ' Please confirm each move if you wish to continue.'
                    ); 
           IF (WarningStatus = PU_CANCEL) THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;
        ENDIF;
        
/*
**  See if there are any moves that have been restored.  If there
**  are, we will look through the list of jobs and see if we have
**  the same move with the same equipment that has been cleared.
*/
        k = 1;
        TempJobs.Clear();
        REPEATED
        SELECT :TempJobs[k].Job = J.Job,
               :TempJobs[k].JobClass = J.JobClass,
               :TempJobs[k].Equip = J.Equip
        FROM   SOA_Job J,
               SOA_JobControl JC
        WHERE  JC.Card = :CommonFeederCard[i].Card AND 
               JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
               JC.Job = J.Job AND
               J.JobClass <> 0 AND 
              (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
               J.Status = '' AND
               J.MoveType <> :MoveType$ISL 
        BEGIN
           k = k + 1;
        END;

        IF TempJobs.LastRow() > 0 THEN
           /*
           ** Get all De-Load moves from this card 
           */
           k = 1;
           AllDLJobs.Clear();
           REPEATED
           SELECT :AllDLJobs[k].Job = J.Job,
                  :AllDLJobs[k].JobClass = J.JobClass,
                  :AllDLJobs[k].Equip = J.Equip
           FROM   SOA_Job J,
                  SOA_JobControl JC
           WHERE  JC.Card = :CommonFeederCard[i].Card AND 
                  JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
                  JC.Job = J.Job AND
                  J.JobClass <> 0 AND 
                  J.TOComplete IS NOT NULL AND 
                  J.RSComplete IS NULL AND
                  J.Status = '' 
           BEGIN
                k = k + 1;
           END;

           k = 1;
           WHILE k <= AllDLJobs.LastRow() AND TempJobs.LastRow() > 0 DO

              IF AllDLJobs[k].JobClass = TempJobs[1].JobClass AND
                 AllDLJobs[k].Job <> TempJobs[1].Job AND
                 AllDLJobs[k].Equip = TempJobs[1].Equip THEN
                 
                 TempJobs.RemoveRow (Rownumber = 1);
                 k = 0; 
              ENDIF;
              k = k + 1;
           ENDWHILE;

           IF TempJobs.LastRow() > 0 THEN
              WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'A Shut-Off move has been Restored on ' +
                              'card at ' + CommonFeederCard[i].StationName +
                              '.  You must ' +
                              'confirm that the necessary Shut-Off moves ' +
                              'have been completed.'
                        ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
           ENDIF;   
        ENDIF;

    ENDFOR; 

    RETURN (RetCode);    
END; 

Application Component Report
============================

	Name:            CheckSpecialGrndExists

/*
**  Application:    CAC
**  Frame:          CheckSpecialGrndExists
**
**  Date:       Author   Description
** ----------------------------------
**  01/30/20    em       Special case precheck for Line 76/77
**  02/18/20    em       Changed the Special Ground relationship
**  02/19/20    em       Can exit immediately if special relationship does not exist
*/
PROCEDURE CheckSpecialGrndExists
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER NOT NULL WITH DEFAULT;
    x = INTEGER;

    RetCode         = INTEGER;
    GroundedTargets  = ARRAY OF INTEGEROBJECT;

    TraceSGE = Trace_SpecialGrndExists;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
    
    SubDescription = VARCHAR(60) NOT NULL WITH DEFAULT;
    StartEquipName = VARCHAR(80) NOT NULL WITH DEFAULT;
    
) =
BEGIN
   /*
   ** Check if special relationship exist, if not can exit immediately
   */
   x = 0;
   SELECT :x = G.Member
   FROM   Udb_Grouping G
   WHERE  G.Grouping = :JIP.Equip AND
          G.Relationship = :Interaction$SpecialGroundExists;
       
   IF x = 0 THEN
      RETURN PU_OK;
   ENDIF;
/*
** Identify equipment that must be ground before we can place a 
** ground on this device.
** First find candidate target ground equip that are ground. 
*/
   GroundedTargets.Clear();
   i = 1;
   REPEATED
   SELECT :GroundedTargets[i].Value = G.Member
   FROM   Udb_Grouping G,
          FMS_ObjectStatus OS
   WHERE  G.Grouping = :JIP.Equip AND
          G.Relationship = :Interaction$SpecialGroundExists AND
          G.Member = OS.Object AND
          OS.Status = :Status$Ground AND
          OS.StatusCount > 0
   BEGIN 
      i = i + 1;
   END;
/*
** Is Ground Placement pending?
*/
   REPEATED
   SELECT :GroundedTargets[i].Value = G.Member
   FROM   Udb_Grouping G,
          FMS_PendingStatus OS
   WHERE  G.Grouping = :JIP.Equip AND
          G.Relationship = :Interaction$SpecialGroundExists AND
          G.Member = OS.Object AND
          OS.PendingStatus = :Status$Ground AND
          OS.IssuedOperator = :JIP.TOOperator AND
          OS.StatusCount > 0
   BEGIN 
      i = i + 1;
   END;

   IF GroundedTargets.LastRow > 0 THEN
/* 
** Can we trace to the GroundedTarget?
*/
      TraceSGE = Trace_SpecialGrndExists.Create();
   
      TraceSGE.JCEquip.Object = JIP.Equip;
      TraceSGE.TargetTypeList = GroundedTargets.Duplicate();
      
      TraceSGE.UsePendingStatus = TRUE;
      TraceSGE.IssuedOperator = JIP.TOOperator;
      
      TraceStatus = TraceSGE.StartTargetTrace();
   
      IF TraceStatus = TraceStatus$TargetFound THEN
         RETURN(PU_OK);
      ENDIF;
   ELSE
      
   ENDIF;
/*
** Unsucessful trace or no ground exists, present warning
*/
      SubDescription = '';
      REPEATED
      SELECT  :SubDescription = S.Description,
              :StartEquipName = O.TypeName + ' ' + O.Name
      FROM    Udb_Object O,
              Udb_Object S
      WHERE   O.Object = :JIP.Equip AND
              O.PrimaryGrouping = S.Object;
      StartEquipName = SubDescription + ' ' + StartEquipName;

   RetCode = CALLFRAME Warning (Card = JIP.Card,
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = StartEquipName + 
                      ' cannot be applied/removed. Check Operating Notes.');
   
   IF RetCode = PU_CANCEL THEN
      RETURN(PU_CANCEL);
   ELSE
      RETURN(Warning$Overridden);
   ENDIF;
END;

Application Component Report
============================

	Name:            CheckSpecialGrndNotExist

/*
**  Application:    CAC
**  Frame:          CheckSpecialGndNotExist
**
**  Date:       Author   Description
** ----------------------------------
**  01/30/20    em       Special case precheck for Line F83/F84
**  02/18/20    em       Changed the Special Ground relationship
**  02/19/20    pkw      Look for ground being removed within last
**                       3 hours.  If not should get warning like ground
**                       never existed on GroundedTarget equip. 
**                       3 hours was chosed out of the blue by Jimmy G.
*/
PROCEDURE CheckSpecialGrndNotExist
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER NOT NULL WITH DEFAULT;
    x = INTEGER;
    RetCode         = INTEGER;
    GroundedTarget  = INTEGER NOT NULL WITH DEFAULT;
    RemovalPending  = INTEGER NOT NULL WITH DEFAULT;
    NeedWarning  = INTEGER NOT NULL WITH DEFAULT;

    TraceSGNE = Trace_SpecialGrndNotExist;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
    
    SubDescription = VARCHAR(60) NOT NULL WITH DEFAULT;
    StartEquipName = VARCHAR(80) NOT NULL WITH DEFAULT;
    TargetEquipName = VARCHAR(80) NOT NULL WITH DEFAULT;
    
) =
BEGIN
   NeedWarning = FALSE;
/*
** Identify equipment that needs ground removed before we can remove 
** ground on this device.
** First check if target equipment has a ground. 
*/
   GroundedTarget = 0;
   REPEATED
   SELECT :GroundedTarget = G.Member
   FROM   Udb_Grouping G,
          FMS_ObjectStatus OS
   WHERE  G.Grouping = :JIP.Equip AND
          G.Relationship = :Interaction$SpecialGroundNoExist;
   IF GroundedTarget = 0 THEN
      RETURN (PU_OK);
   ENDIF;

   i = 0;
   REPEATED
   SELECT :i = OS.Object
   FROM   FMS_ObjectStatus OS
   WHERE  OS.Object = :GroundedTarget AND
          OS.Status = :Status$Ground AND
          OS.StatusCount > 0;

   IF i = 0 THEN
      SELECT DISTINCT :i = COUNT(*)
      FROM   SOA_Log L,
             SOA_Job J,
             FMS_JobAction JA
      WHERE  L.Card = :JIP.Card AND
             L.Time > Date('now') - '1 hour' AND
             lowercase(L.Item) = 'rscomplete' AND
             L.Job = J.Job AND
             J.Equip = :GroundedTarget AND
             J.JobClass = JA.JobClass AND
             JA.Status = :Status$Ground AND
             JA.Action = :JobAction$Decrement AND
             JA.TypeOfCard = :TypeOfCard$TFMS;
      IF i <> 0 THEN
         RETURN PU_OK;
      ELSE
         NeedWarning = TRUE;
      ENDIF;
   ENDIF;
/*
** Is Ground Removal pending?
* /
   RemovalPending = 0;
   SELECT :RemovalPending = Object
   FROM   FMS_PendingStatus 
   WHERE  Object = :GroundedTarget AND
          PendingStatus = :Status$Ground AND
          IssuedOperator = :JIP.RSOperator AND
          StatusCount = 0;

   IF RemovalPending = GroundedTarget THEN
      RETURN PU_OK;
   ENDIF;
*/   
/* 
** Can we trace to the GroundedTarget?
*/
   IF NeedWarning <> TRUE THEN
      TraceSGNE = Trace_SpecialGrndNotExist.Create();
   
      TraceSGNE.JCEquip.Object = JIP.Equip;
      TraceSGNE.TargetGround = GroundedTarget;
   
      TraceStatus = TraceSGNE.StartTargetTrace();
      
      IF TraceStatus = TraceStatus$TargetFound THEN
         NeedWarning = TRUE;
      ENDIF;
   ENDIF;
   
   IF NeedWarning = TRUE THEN
      SubDescription = '';
      REPEATED
      SELECT  :SubDescription = S.Description,
              :StartEquipName = O.TypeName + ' ' + O.Name
      FROM    Udb_Object O,
              Udb_Object S
      WHERE   O.Object = :JIP.Equip AND
              O.PrimaryGrouping = S.Object;
      StartEquipName = SubDescription + ' ' + StartEquipName;

      SubDescription = '';
      REPEATED
      SELECT  :SubDescription = S.Description,
              :TargetEquipName = O.TypeName + ' ' + O.Name
      FROM    Udb_Object O,
              Udb_Object S
      WHERE   O.Object = :GroundedTarget AND
              O.PrimaryGrouping = S.Object;
      TargetEquipName = SubDescription + ' ' + TargetEquipName;
      
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem, 
               Text = 'Ground at: ' + TargetEquipName + 
                      ' must be removed within the last hour before removing ' + 
                      StartEquipName);
   
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         RETURN(Warning$Overridden);
      ENDIF;
   ENDIF;
   RETURN(PU_OK);
END;






Application Component Report
============================

	Name:            CheckStationGroundOff

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckStationGroundOff
**
**  Modifications:
**  11/25/92   em	    Created 
**  11/19/02   ysp    Merge: removed passed-in C and Jobs
**  08/10/16   ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
*/
PROCEDURE CheckStationGroundOff 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
ENDDECLARE
BEGIN
   i = 1;
   REPEATED
   SELECT
   DISTINCT
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].StationGround = C.StationGround,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
          :CommonFeederCard[i].TypeOfCard = C.TypeOfCard
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card
   BEGIN
      i = i + 1;
   END;

   RetCode = NULL;

   FOR i = 1 TO CommonFeederCard.LastRow() DO
      FeederName = CommonFeederCard[i].GetGeneralCardName();
      
      IF CommonFeederCard[i].StationGround <> 'Off' THEN 
    
         WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'The Feeder: ' + FeederName + 
                                          ' is grounded.');           
         IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
         ELSE
            RetCode = Warning$Overridden;
         ENDIF;
      ENDIF; 
  ENDFOR;

  RETURN(RetCode)
END; 

Application Component Report
============================

	Name:            CheckStationGroundOnly

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckStationGroundOnly  
**
**  Modifications:
**  11/03/92 em	 Created 
**  05/25/93 em  station ground count can be greater than one,
**               must compare C.GroundsOn to actual number of grounds
**               on the source equipment.  
**  02/18/94 em  added IFNULL to prevent null warning
**  11/19/02 ysp Merge: removed passed-in C and Jobs
**  11/16/10 em  Add 3G Support
**  02/13/13 pkw Check for grounds on Step Down card.
**  08/10/16 ysp For 33kv portion card, prepend main feeder name to the portion name in messages 
*/
PROCEDURE  CheckStationGroundOnly 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    j = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    SDObjects = FMS_Card;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    SourceGrounds = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER;
ENDDECLARE
BEGIN
   i = 1;
   REPEATED
   SELECT
   DISTINCT
          :CommonFeederCard[i].Card = C.Card,
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].Feeder = C.Feeder,
          :CommonFeederCard[i].StationGround = C.StationGround,
          :CommonFeederCard[i].GroundsOn = C.GroundsOn,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
          :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
          :CommonFeederCard[i].Status = 0     /* Used to signify Link 4kv card; 0 look for Station Ground, 1 = All grounds considered field ground */
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card
   BEGIN
      i = i + 1;
   END;
   /*
   **  For each feeder look for Step Down link to other feeder
   */
   FOR i = 1 TO CommonFeederCard.LastRow DO      
      /*
      **  Check to see if current feeder has a link to StepDown Feeder.
      **  If so look at 4kV feeder to see if SD-LoadElbow equipment type
      **  is closed.  If yes, then look for other linked cards
      **  and check ground status on those card.  
      **  For other linked cards, all grounds will be considered Field grounds.
      **  We will signify other linked cards by setting Status = 1 and in this case 
      **  the station checks will be ignored below.
      */
      IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV AND 
         CommonFeederCard[i].Status = 0 THEN
         
         SDObjects = NULL;
         SDObjects = FMS_Card.Create();
         REPEATED
         SELECT DISTINCT
               :SDObjects.Card = C.Card,
               :SDObjects.FeederName = C.FeederName,
               :SDObjects.Feeder = C.Feeder,
               :SDObjects.StationGround = C.StationGround,
               :SDObjects.GroundsOn = C.GroundsOn,
               :SDObjects.NetworkFeeder = C.NetworkFeeder,
               :SDObjects.TypeOfCard = C.TypeOfCard,
               :SDObjects.Status = 1     
         FROM  FMS_StepDownLink L,
               Udb_Switch S,
               Udb_Grouping G,
               TFMS_CardToObject CTO,
               FMS_Card C
         WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
               L.Card = C.Card AND
               CTO.Card = L.StepDownCard AND
               CTO.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.MemberType = :Type$SDLoadElbow AND
               G.Member = S.Object AND
               S.CurrentlyOpen = 0
         BEGIN
            j = 1;
            WHILE j <= CommonFeederCard.LastRow DO
               IF CommonFeederCard[j].Card = SDObjects.Card THEN
                  ENDLOOP;
               ENDIF;
               j = j + 1;
            ENDWHILE;
            IF j > CommonFeederCard.LastRow THEN
               CommonFeederCard[j] = SDObjects.Duplicate();
            ENDIF;
         END;
          
      ELSEIF CommonFeederCard[i].Status = 0 THEN
         SDObjects = NULL;
         SDObjects = FMS_Card.Create();
         REPEATED
         SELECT DISTINCT
               :SDObjects.Card = C.Card,
               :SDObjects.FeederName = C.FeederName,
               :SDObjects.Feeder = C.Feeder,
               :SDObjects.StationGround = C.StationGround,
               :SDObjects.GroundsOn = C.GroundsOn,
               :SDObjects.NetworkFeeder = C.NetworkFeeder,
               :SDObjects.TypeOfCard = C.TypeOfCard,
               :SDObjects.Status = 1     
         FROM    FMS_StepDownLink L,
                 Udb_Switch S,
                 Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 FMS_Card C
         WHERE   L.Card = :CommonFeederCard[i].Card AND
                 L.StepDownCard = C.Card AND
                 C.Card = CTO.Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$SDLoadElbow AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0
         BEGIN
            j = 1;
            WHILE j <= CommonFeederCard.LastRow DO
               IF CommonFeederCard[j].Card = SDObjects.Card THEN
                  ENDLOOP;
               ENDIF;
               j = j + 1;
            ENDWHILE;
            IF j > CommonFeederCard.LastRow THEN
               CommonFeederCard[j] = SDObjects.Duplicate();
            ENDIF;
         END;      
      ENDIF;  
   ENDFOR; 

   RetCode = NULL;

   FOR i = 1 TO CommonFeederCard.LastRow() DO
      FeederName = CommonFeederCard[i].GetGeneralCardName();

      IF CommonFeederCard[i].Status = 0 THEN  /* Perform usual check */
         /*
         **  get source equipment ground count; using sum allows for
         **  potential multiple source positions
         */ 
         SourceGrounds = 0;

         SELECT :SourceGrounds = IFNULL(Sum(S.StatusCount),0)
         FROM   FMS_ObjectStatus S,
                Udb_Grouping G,
                TFMS_CardToObject CTO 
         WHERE  CTO.Card = :CommonFeederCard[i].Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$SourcePosition AND
                G.Member = S.Object AND
                S.Status = :Status$Ground;

         WarningStatus = PU_OK;

         IF CommonFeederCard[i].StationGround = 'On' AND 
            CommonFeederCard[i].GroundsOn = SourceGrounds THEN
            CONTINUE;

         ELSEIF CommonFeederCard[i].StationGround <> 'On' THEN 
            WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'The feeder: ' + FeederName + 
                                          ' is NOT grounded.');  
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
 
         ELSE
            WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'There are still field grounds applied on feeder: ' +
                                          FeederName + '.');
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ELSE
         IF CommonFeederCard[i].GroundsOn <> 0 THEN
            WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'There are still field grounds applied on feeder: ' +
                                          FeederName + '.');
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;    
   ENDFOR;

   RETURN(RetCode); 
END;


Application Component Report
============================

	Name:            CheckStepDownClear

/*
**      Copyright c 2012 Pateric Software LLC  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckStepDownCardClear
**
**  Date:     Version  Description
** --------------------------------------------------
**  11/07/12   pkw     Created to check deload complete on 4kv Step Down Cards
**  02/14/13   pkw     Check Isolation moves in addition to deload moves.
**  10/05/13   pkw     Use TFMS_CardtoObject when looking for stepdown clear.
**  10/05/13   pkw     Comment out 4kv check at top of precheck.
*/
PROCEDURE CheckStepDownClear
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL; 
    StepDownCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;                   
    AllDLJobs = ARRAY of Job;  
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;
)= 
BEGIN 
    RetCode = NULL;
/*
**  Confirm this is not a 4KV Feeder.
**  LET CHECK HAPPEN NO MATTER WHAT.  This check
**  prevents warning when on StepDown which is not desired.
    i = 0;
    SELECT :i = COUNT(*)
    FROM    TFMS_CardToObject CTO,
            Udb_Grouping G,
            Udb_Rating R
    WHERE   CTO.Card = :JIP.Card AND
            CTO.Object = G.Member AND
            G.Relationship = :Interaction$RatedAs AND
            G.Grouping = R.Object AND
            R.Normal = :Rating$4KV;
    IF i <> 0 THEN  / * This is a 4kv feeder * /
       RETURN (RetCode); 
    ENDIF;
*/
/*
**  See if feeder has any SDVis equipment on it that is a source
**  breaker for a 4KV feeder.
**  If no SDVis equipment found, then nothing more to do. 
*/
    i = 1;
    SELECT :StepDownCard[i].CardName = C.Feedername, /* FeederName where job issued */
           :StepDownCard[i].FeederName = O.Name,     /* StepDown FeederName */
           :StepDownCard[i].Feeder = O.Object,       /* StepDown Feeder */
           :StepDownCard[i].Loop1 = O2.TypeName,     /* Typename for SDVIS equip */
           :StepDownCard[i].Loop2 = O2.Name          /* SDVIS equipment name */
    FROM   FMS_Card C,
           TFMS_CardToObject CTO,
           Udb_Object O,
           Udb_Object O2,
           Udb_Grouping G,
           Udb_Grouping G2,
           Udb_Grouping G3,
           Udb_Rating R
    WHERE  C.Card = :JIP.Card AND
           CTO.Card = :JIP.Card AND
           CTO.Object = G.Grouping AND 
           G.Relationship = :Interaction$MemberOf AND 
           G.MemberType = :Type$SDVIS AND 
           G.Member = G2.Member AND   /* SDVis Object on feeder */
           G.Member = O2.Object AND
           G2.Relationship = :Interaction$SourceBreaker AND 
           G2.Grouping = G3.Member AND
           G2.Grouping = O.Object AND
           G3.Relationship = :Interaction$RatedAs AND 
           G3.Grouping = R.Object AND
           R.Normal = :Rating$4KV
    BEGIN
       i = i + 1;
    END;

    IF i = 1 THEN  /* No SDVIS equip common with 4kv feeders */
       RETURN (RetCode); 
    ENDIF;
/*
**  For each Step Down Feeder look for active card.  Present warning
**  if card does not exist.
*/
    
    FOR i = 1 TO StepDownCard.LastRow() DO
       SELECT :StepDownCard[i].Card = AC.Card
       FROM   SOA_ActiveCard AC,
              TFMS_CardToObject CTO
       WHERE  CTO.Object = :StepDownCard[i].Feeder AND
              CTO.Card = AC.Card;

       IF StepDownCard[i].Card = 0 THEN
          WarningStatus = CALLFRAME Warning
               (Card = JIP.Card, 
                Job = JIP.Job, 
                SwitchingItem = JIP.SwitchingItem,
                Text = 'Feeder ' + StepDownCard[i].CardName + ' has (' + 
                       StepDownCard[i].Loop1 + ' ' + StepDownCard[i].Loop2 + 
                       ') common to Feeder ' + StepDownCard[i].FeederName +
                       ' that does not have an active card associated with it. ' + 
                       StepDownCard[i].FeederName + ' should be Deloaded before continuing.' 
                ); 
          IF (WarningStatus = PU_CANCEL) THEN
             RETURN(PU_CANCEL);
          ELSE
             RetCode = Warning$Overridden;
          ENDIF;
       ELSE
          /*
          **  For each card, check for Deload moves complete and that no restore 
          **  moves are complete.
          */
          k = 1;
          TempJobs.Clear();
          REPEATED
          SELECT :TempJobs[k].PrintId = JC.PrintId,
                 :TempJobs[k].EquipName = J.EquipName,
                 :TempJobs[k].EquipClassName = J.EquipClassName,
                 :TempJobs[k].ToMove = J.ToMove,
                 :TempJobs[k].Job = J.Job
          FROM   SOA_Job J, 
                 SOA_JobControl JC
          WHERE  JC.Card = :StepDownCard[i].Card AND
                (JC.StepPair = :StepHeading$Deload OR
                 JC.StepPair = :StepHeading$ISO) AND
                 JC.Job = J.Job AND
                 J.JobClass <> 0 AND 
                 J.TOComplete IS NULL AND
                 J.Status = '' AND
                 J.MoveType <> 'NONE'
          BEGIN
             k = k + 1;
          END;

          IF TempJobs.LastRow() > 0 THEN
             WarningStatus = CALLFRAME Warning
                   ( Card = JIP.Card, 
                     Job = JIP.Job, 
                     Jobs = TempJobs,
                     SwitchingItem = JIP.SwitchingItem,
                     Text = 'Not all Deload moves have been completed ' +
                            'on feedercard ' + StepDownCard[i].FeederName + 
                            ' Please confirm each move if you wish to continue.'
                   ); 
             IF (WarningStatus = PU_CANCEL) THEN
                RETURN(PU_CANCEL);
             ELSE
                RetCode = Warning$Overridden;
             ENDIF;
          ENDIF;       
          /*
          **  See if there are any moves that have been restored.  If there
          **  are, we will look through the list of jobs and see if we have
          **  the same move with the same equipment that has been cleared.
          */
          k = 1;
          TempJobs.Clear();
          REPEATED
          SELECT :TempJobs[k].Job = J.Job,
                 :TempJobs[k].JobClass = J.JobClass,
                 :TempJobs[k].Equip = J.Equip
          FROM   SOA_Job J,
                 SOA_JobControl JC
          WHERE  JC.Card = :StepDownCard[i].Card AND 
                (JC.StepPair = :StepHeading$Deload OR
                 JC.StepPair = :StepHeading$ISO) AND
                 JC.Job = J.Job AND
                 J.JobClass <> 0 AND 
                (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
                 J.Status = '' AND
                 J.MoveType <> 'NONE'
          BEGIN
            k = k + 1;
          END;

          IF TempJobs.LastRow() > 0 THEN
             /*
             ** Get all De-Load moves from this card 
             */
             k = 1;
             AllDLJobs.Clear();
             REPEATED
             SELECT :AllDLJobs[k].Job = J.Job,
                    :AllDLJobs[k].JobClass = J.JobClass,
                    :AllDLJobs[k].Equip = J.Equip
             FROM   SOA_Job J,
                    SOA_JobControl JC
             WHERE  JC.Card = :StepDownCard[i].Card AND 
                   (JC.StepPair = :StepHeading$Deload OR
                    JC.StepPair = :StepHeading$ISO) AND
                    JC.Job = J.Job AND
                    J.JobClass <> 0 AND 
                    J.TOComplete IS NOT NULL AND 
                    J.RSComplete IS NULL AND
                    J.Status = '' 
             BEGIN
                k = k + 1;
             END;

             k = 1;
             WHILE k <= AllDLJobs.LastRow() AND TempJobs.LastRow() > 0 DO

                IF AllDLJobs[k].JobClass = TempJobs[1].JobClass AND
                   AllDLJobs[k].Job <> TempJobs[1].Job AND
                   AllDLJobs[k].Equip = TempJobs[1].Equip THEN
                 
                   TempJobs.RemoveRow (Rownumber = 1);
                   k = 0; 
                ENDIF;
                k = k + 1;
             ENDWHILE;

             IF TempJobs.LastRow() > 0 THEN
                WarningStatus = CALLFRAME Warning
                      ( Card = JIP.Card, 
                        Job = JIP.Job,
                        SwitchingItem = JIP.SwitchingItem, 
                        Text = 'A Deload move has been Restored on ' +
                              'feedercard ' + StepDownCard[i].FeederName +
                              '.  You must ' +
                              'confirm that the necessary Deload moves ' +
                              'have been Taken Out.'
                      ); 
                IF (WarningStatus = PU_CANCEL) THEN
                   RETURN(PU_CANCEL);
                ELSE
                   RetCode = Warning$Overridden;
                ENDIF;
             ENDIF;   
          ENDIF;
       ENDIF;
    ENDFOR; 

    RETURN (RetCode);    
END; 

Application Component Report
============================

	Name:            CheckStreetPressurized

/*
**      Copyright c 2008 Pateric Software LLC  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckStreetPressurized
**
**  Date:    Version  Description
** --------------------------------------------------
**  02/19/08  em    created
*/
PROCEDURE CheckStreetPressurized
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    i = INTEGER NOT NULL;              /* index */ 
    RetCode = INTEGER NOT NULL WITH DEFAULT;
)= 
BEGIN 
/*
**    Look for shared street valve move where move exists on a non-sole authority
**    card.  The Generic street main should not have De-Pressurized status. 
*/
    i = 0;
    REPEATED
    SELECT  :i = COUNT(JC.Job)
    FROM    SOA_JobControl JC,
            SOA_JobControl JC2,
            SOA_ActiveCard AC,
            SDS_CardMain CM,
            FMS_ObjectStatus OS
    WHERE   JC.Card = :JIP.Card AND
            JC.Job = JC2.Job AND
            JC2.Card <> :JIP.Card AND 
            JC2.Card = AC.Card AND
            AC.TypeOfCard = :TypeOfCard$SteamNSA AND 
            AC.Card = CM.Card AND
            CM.Main = OS.Object AND
            OS.Status = :Status$DePressurized AND
            OS.StatusCount >= 1; 

    IF i > 0 THEN  

           RetCode = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = 0,
                      Text = 'Street Main is not Pressurized'
                    ); 
           IF (RetCode = PU_CANCEL) THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;
    ENDIF;
    RETURN(PU_OK);
END;

Application Component Report
============================

	Name:            CheckTankLine

/* 
**      Copyright c 2014 PATERIC SOFTWARE LLC All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    CAC
**  Frame:          CheckTankLine
**
**  Date:   Author  Description
** ----------------------------------
**  06/21/14  ysp Created
**  05/18/22  em  Use DSO_Trace_Engine components
*/
PROCEDURE CheckTankLine (
   JIP = JobInProgress;   /*Passed Job*/				         
) =
DECLARE
   i = INTEGER;                            
   j = INTEGER;
   k = INTEGER;                            

   IssuedOperator = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER;                     /*return variable */
   ReturnStatus = INTEGER NOT NULL WITH DEFAULT; 
   WarningText = VARCHAR(300) NOT NULL WITH DEFAULT;
   StartEquip = ARRAY OF DSO_trace_engine!Equipment;
   TraceClient = DSO_TraceClient;
ENDDECLARE
BEGIN
   ReturnStatus = PU_OK;
   
   // verify equipment is pump
   i = 0;
   SELECT :i = 1
   FROM   UDB_ExtendedType ET
   WHERE  ET.Type = :JIP.EquipClass AND
          ET.SuperType = :Type$Pump;
   CALLPROC DDB_ROLLBACK;
   
   IF i=0 THEN
      WarningText = JIP.EquipClassName + ' ' + JIP.EquipName + 
            ' is not a pump. Not able to verify open tank line';
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;
   ENDIF;
   
   /* 
   ** Trace from the pump for an open line to a tank
   */
   StartEquip[1].Object = JIP.Equip;
   SELECT :StartEquip[1].Pocket = O.Pocket
   FROM   DSO_Object O
   WHERE  O.Object = :StartEquip[1].Object;
   CALLPROC DDB_ROLLBACK;
   
   IF StartEquip[1].Pocket = 0 THEN
      WarningText = 'Pocket is not specified for ' + JIP.EquipClassName + ' ' + JIP.EquipName + 
            ' Not able to verify open tank line';
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);

      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;   
   ENDIF;

   IF JIP.Status = Job$TakeOut THEN
      IssuedOperator = IFNULL(JIP.TOOperator, 0);
   ELSEIF JIP.Status = Job$Restore THEN
      IssuedOperator = IFNULL(JIP.RSOperator, 0);
   ENDIF;
   
   RetCode = TraceClient.TraceForOpenLineToTank(
      StartEquip = StartEquip,
      IssuedOperator = IssuedOperator);
   
   IF RetCode = FALSE THEN
      WarningText = 'There is not an open line from ' + JIP.EquipClassName + ' ' + JIP.EquipName + 
         ' to a tank';
      RetCode = CALLFRAME Warning (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem, 
                           Text = WarningText);
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         ReturnStatus = Warning$Overridden;
      ENDIF;
   ENDIF;

   IF ReturnStatus <> PU_OK THEN
      RETURN ReturnStatus;
   ELSE
      RETURN(PU_OK);
   ENDIF;
END;

Application Component Report
============================

	Name:            CheckVisibleBreaks

/* 
**      Copyright c 1999 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    SOA
**  Frame:          CheckVisibleBreaks
**
**  Date:       Author   Description
** ----------------------------------
**  02/16/99	EM       Combined TFMS/SLC versions, modified for SOA
**                       To be used when placing a ground to verify that
**                       site (job's equipment) is isolated with visible breaks
**  03/09/99    em       Modified per design changes
**  05/06/99    em       Extended search to look as far as outbound disconnect
**                       or depth of five in neighboring substation.
**  07/08/99    em       Commented out confirm - now they don't want it.
**  09/15/99    em       Change stop at Type Gnd-Sw to stop at single terminal
**                       devices.
**  09/16/99    em       Ignore Closed Loops.  (Intended to find DB errors.)
**  11/17/99    em       Add PrimaryGrouping Name to error messages.
**  11/26/02    pkw      Change Job to JIP for Merge.
**  01/24/03    em       Use scope of Job on all cards to select Active Objects
**                       instead of limiting scope to current job's card.  Check
**                       reacts differently if performed from SLC vs. TFMS when
**                       limiting to current card.
**  11/02/05    em       Change Outbound Depth to 10 from 5.  Received warning when
**                       break was on device 6. Remove device name from warning.
**  01/20/06	em 	 Include Distribution Feeder Source Breaker Types in Load-Breaking
**                       type list.  Equipment R/O and B/O Status satisfies visible break.
**                       Extend trace to Feeder Load.
**  02/15/06    em       Feeder Load is treated as a Visible Break if the related feeder has 
**                       DBF Status.  B/O status will not be considered a visible break.
**  03/16/06    em       If Job Equip is a Two Position Switch, then consider 
**                       all moves currently be performed and add to Pending Breaks if necessary.
**                       Do trace in direction of breaker only.
**  03/17/06    em       Correcting issues with Two Position Switch
**  09/01/06    em       PendingStatusCount must be > 0
**  05/14/09    em       Correcting error using Status$DBF constant
**  07/15/09    em       Extend DBF check, look for Feeder Cutout, Only present warning if no DBF
**                       and cutout feeder.
**  01/26/10    em       Removed two occurences of ORDER BY 1 on SELECT DISTINCT
**  01/26/10    em       Increased size of DynamicWhereClause to address ORDER by trace window error.
**  04/06/17    em       When multiple closed paths converge it is possible that the catch-all  
**                       warning will be presented because OpenedPaths count cannot reach PrevClosedPath count.
**                       Added LoopCount variable to count paths that have been traversed to reduce Closed Path Count.
**  04/12/17    em       Conversion to QGIS connectivity tracing
**  05/02/17    em       Made ClosedOutBound message generic
**  01/23/18    ysp      Add handling of placing a ground on the terminal of the JIP equipment.
**  12/16/20    em       If the move equipment is a special ground stud, perform alternate visible break check 
**                       specific to certain equipment in Cherry St, Ave A, and West 19 St.
**  06/22/21    em       Special Grd-Stud condition for WASH_ST 3G1 (155546 hardcoded), perform Double Side check, 
**                       then run normal trace for single side (since it extends to multiple paths outside the 
**                       station (It is an AND condition, not an OR condition on the Single Side.) 
*/
PROCEDURE CheckVisibleBreaks
(
    JIP = JobInProgress;   /*Passed Job*/				         

    i = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER;
    p = INTEGER NOT NULL WITH DEFAULT; /*Perform Moves Array index */
    x = INTEGER;

    MoveText = VARCHAR(160) NOT NULL WITH DEFAULT;
    RetCode         = INTEGER;
    VisibleBreak    = INTEGER NOT NULL;

    DoubleSideBreaker  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadObject  = INTEGER NOT NULL WITH DEFAULT;
    StatusDBF      = INTEGER NOT NULL WITH DEFAULT;

    GroundTerminal = INTEGER NOT NULL WITH DEFAULT;
    ToRs = INTEGER NOT NULL WITH DEFAULT;
    TwoPosition    = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

    TargetTypes = ARRAY OF IntegerObject;
    TraceAdj = Trace_AdjacentEquipment;
    TraceVB = Trace_VisibleBreak;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   /*
   ** check if there is an action to increment ground status at completion. 
   ** If so, select the terminal to place the ground when 
   ** issuing the move before the visible break connectivity trace.
   */
   JIP.GroundTerminal = 0;          // default value
   
   x = 0;
   IF JIP.Status = Job$TakeOut THEN
      ToRs = 0;
      MoveText = JIP.TOMove;
   ELSE
      ToRs = 1;
      MoveText = JIP.RSMove;
   ENDIF;
      
   SELECT :x = 1
   FROM   FMS_JobAction JA,
          SOA_JobControl J,
          SOA_ActiveCard AC
   WHERE  J.Job = :JIP.Job AND
          J.Card = AC.Card AND
          AC.TypeofCard = JA.TypeofCard AND
          JA.JobClass = :JIP.JobClass AND
          JA.EquipClass = J.MoveEquipClass AND
          JA.StepPair  = J.StepPair AND
          JA.ToRs = :ToRs AND
          JA.Action = :JobAction$Increment AND
          JA.Status = :Status$Ground AND
          JA.IssueCompl = :JobClass$Complete;
   IF x = 1 THEN   
      /* if this equipment is connected to two piece of equipment. Ask DO which terminal to
      ** place the ground on.
      */
      x = 0;
      SELECT :x = COUNT(*)
      FROM   DSO_Connection C
      WHERE  C.FromObj = :JIP.Equip OR 
             C.ToObj = :JIP.Equip;
      IF x >= 2 THEN
         GroundTerminal = CALLFRAME SelectTerminal(
                                     JIP = JIP,
                                     Action = 'placing',
                                     MoveText = BYREF(MoveText));
             
         IF GroundTerminal <= 0 THEN
            JIP.GroundTerminal = JIP.Equip;
         ELSE
            JIP.GroundTerminal = GroundTerminal;
         ENDIF;
      ENDIF;
   ENDIF;
   
   // Setup Trace, we need IssuedOperator for pending checks in special grd stud code
   TraceVB = Trace_VisibleBreak.Create();
   TraceVB.UsePendingStatus = TRUE;
   IF JIP.Status = Job$Restore THEN
      TraceVB.IssuedOperator = JIP.RSOperator;
   ELSE
      TraceVB.IssuedOperator = JIP.TOOperator;
   ENDIF;
   
   // Determine if Special Grd Stud triggers alternate visible break check
   RetCode = SpecialGrdStuds.Find (attributename = 'value', value = JIP.Equip);
   
   IF RetCode = ER_OK THEN
       // Must find three Visible Breaks, one from each table, single path (1) and double path (2)
       VisibleBreak = 0;
       SELECT :VisibleBreak = 1
       FROM   FMS_ObjectStatus OS,
              SOA_VisibleBreakCheck VBC
       WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
              VBC.DoubleSideBreakerVB = OS.Object AND
              OS.Status IN (:Status$VisibleBreak, :Status$RO) AND
              OS.StatusCount > 0;
      
       IF VisibleBreak = 0 THEN        
         SELECT  :VisibleBreak = 1
         FROM    FMS_PendingStatus PS,
                 SOA_VisibleBreakCheck VBC 
         WHERE   VBC.InitiatingGrdStud = :JIP.Equip AND
                 VBC.DoubleSideBreakerVB = PS.Object AND
                 PS.PendingStatus IN (:Status$VisibleBreak, :Status$RO) AND
                 PS.StatusCount > 0 AND
                 PS.IssuedOperator = :TraceVB.IssuedOperator;
       ENDIF;
       /* Special condition for WASH_ST 3G1 single side */
       IF VisibleBreak = 1 AND JIP.Equip <> 155546 THEN  

       VisibleBreak = 0;
       SELECT :VisibleBreak = 1
       FROM   FMS_ObjectStatus OS,
              SOA_VBCheckSingleSide VBC
       WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
              VBC.SingleSideVB = OS.Object AND
              OS.Status IN (:Status$VisibleBreak, :Status$RO) AND
              OS.StatusCount > 0;
      
       IF VisibleBreak = 0 THEN        
         SELECT  :VisibleBreak = 1
         FROM    FMS_PendingStatus PS,
                 SOA_VBCheckSingleSide VBC
         WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
                 VBC.SingleSideVB = PS.Object AND
                 PS.PendingStatus IN (:Status$VisibleBreak, :Status$RO) AND
                 PS.StatusCount > 0 AND
                 PS.IssuedOperator = :TraceVB.IssuedOperator;
       ENDIF;

       ENDIF; 

       IF VisibleBreak = 1 THEN

       VisibleBreak = 0;
       SELECT :VisibleBreak = 1
       FROM   FMS_ObjectStatus OS,
              SOA_VBCheckDoubleSide VBC
       WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
              VBC.DoubleSideVB = OS.Object AND
              OS.Status IN (:Status$VisibleBreak, :Status$RO) AND
              OS.StatusCount > 0;
      
       IF VisibleBreak = 0 THEN        
         SELECT  :VisibleBreak = 1
         FROM    FMS_PendingStatus PS,
                 SOA_VBCheckDoubleSide VBC
         WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
                 VBC.DoubleSideVB = PS.Object AND
                 PS.PendingStatus IN (:Status$VisibleBreak, :Status$RO) AND
                 PS.StatusCount > 0 AND
                 PS.IssuedOperator = :TraceVB.IssuedOperator;
       ENDIF;

       ENDIF; 
       
       IF VisibleBreak = 0 THEN  // Did not find necessary visible paths       
          SELECT :DoubleSideBreaker = O.Name
          FROM   Udb_Object O,
                 SOA_VisibleBreakCheck VBC
          WHERE  VBC.InitiatingGrdStud = :JIP.Equip AND
                 VBC.DoubleSideBreakerVB = O.Object;
                 
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'The required Visible Breaks for Grd-Stud (' + JIP.EquipName + 
                        ') have not been found.  Both sides of Breaker (' + DoubleSideBreaker +
                        ') must be de-energized and isolated before applying this ground.');

          IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RETURN(Warning$Overridden);
          ENDIF;
       /* Special condition for WASH_ST 3G1 single side, also run regular trace on single side */
       ELSEIF JIP.Equip <> 155546 THEN
          RETURN PU_OK;
       ENDIF;
   ENDIF;
   
   // begin connectivity trace logic     
   i = 1;
   REPEATED
   SELECT 
   DISTINCT 
           :TraceVB.CardObjects[i].Value = AO.Object
   FROM    SOA_ActiveObject AO,
           SOA_JobControl JC
   WHERE   JC.Job = :JIP.Job AND   
           JC.Card = AO.Card
   BEGIN
       i = i + 1;
   END;

   // set default start position
   TraceVB.JCEquip.Object = JIP.Equip;
   TraceVB.JCEquip.TypeName = JIP.EquipClassName;
   TraceVB.JCEquip.Name = JIP.EquipName;
   TraceVB.JCEquip.Substation = JIP.Substation;

   TraceVB.TraceFromEquip = 0;
   
   IF JIP.GroundTerminal > 0 THEN
      /*
      ** if a ground is to be placed between JIP and an adjacent device, the paths
      ** to trace are determined based on the VB status of the JIP equipment.
      ** 1. if JIP has a VB status, we just need to find a VB on the ground side
      ** 2. if JIP does not have a VB status, we need to find VB on both sides
      */
      /*
      ** Look for Visible Break
      */
      k = 0;
      SELECT :k = 1
      FROM   FMS_ObjectStatus
      WHERE  Object = :JIP.Equip AND
             Status IN (:Status$VisibleBreak, :Status$RO) AND
             StatusCount > 0;
      
      IF k = 0 THEN        
         SELECT  :k = 1
         FROM    FMS_PendingStatus 
         WHERE   Object = :JIP.Equip AND
                 PendingStatus IN (:Status$VisibleBreak, :Status$RO) AND
                 StatusCount > 0 AND
                 IssuedOperator = :TraceVB.IssuedOperator;
      ENDIF;
    
      IF k = 1 THEN         
         SELECT :TraceVB.TraceFromEquip = FromObj
         FROM   DSO_Connection
         WHERE  TOObj= :JIP.Equip AND
                FromObj <> :JIP.GroundTerminal;
                
         IF TraceVB.TraceFromEquip = 0 THEN
            SELECT :TraceVB.TraceFromEquip = TOObj
            FROM   DSO_Connection
            WHERE  FromObj = :JIP.Equip AND
                   TOObj <> :JIP.GroundTerminal;         
         ENDIF;
      ENDIF; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
   
/* 
** If a Two Position Switch Start toward breaker.
*/
   IF JIP.EquipClass = Type$DiscGrdBkr THEN
      TargetTypes[1].Value = Type$Bkr;
      TargetTypes[2].Value = Type$BkrSpare;
      TargetTypes[3].Value = Type$BkrRO;
      TargetTypes[4].Value = Type$BkrROSpare;
      TraceAdj = Trace_AdjacentEquipment.Create();
      TraceStatus = TraceAdj.FindAdjacentEquipment(JobEquip = JIP.Equip,
                                                   TargetTypes = TargetTypes);
      IF TraceStatus = TraceStatus$TargetFound THEN
         i = 0;
         RetCode = TraceAdj.PathResultList.Find(AttributeName = 'Status',
                                                Value = TraceStatus$TargetFound,
                                                RowNumber = ByRef(i));                              
         IF RetCode = ER_OK THEN
            // trace toward breaker
            TraceVB.JCEquip = TraceAdj.PathResultList[i].FirstEquip.Duplicate();            
            TraceVB.TraceFromEquip = JIP.Equip;
         ENDIF;
      ENDIF;   
/*
** If we are operating on a Two Position Switch, extend the Pending Breaks based on the 
** PerformMovesArray.  We are expecting both two position switches for the breaker to be
** operated in the same order.
*/
       FOR p = 1 TO PerformMovesArray.LastRow() DO

             TwoPosition = FALSE;
             REPEATED
             SELECT :TwoPosition = 1
             FROM    FMS_JobAction JA,
                     SOA_JobControl JC,
                     SOA_ActiveCard AC
             WHERE   JA.JobClass = :PerformMovesArray[p].JobClass AND
                     JA.EquipClass = :PerformMovesArray[p].MoveEquipClass AND
                     JA.StepPair = :PerformMovesArray[p].StepPair AND
                     JA.TypeOfCard = AC.TypeOfCard AND
                     AC.Card = JC.Card AND
                     JC.Job = :PerformMovesArray[p].Job AND
                     JA.TORS = :PerformMovesArray[p].TORS AND
                     JA.IssueCompl = 1 AND            /*At Move Completion Time*/
                     JA.Action = :JobAction$Set AND
                     JA.Status IN (:Status$VisibleBreak,:Status$RO);

             IF TwoPosition = 1 THEN
/*
** Insert new entry in PendingBreaks in appropriate numerical slot.
*/ 
                i = 1;
                WHILE i <= TraceVB.TwoPositionPendingBreaks.LastRow() DO
                   IF TraceVB.TwoPositionPendingBreaks[i].VALUE = PerformMovesArray[p].Equip THEN
                      /* Already Exists in Array */
                      i = 0;
                      ENDLOOP;
                   ENDIF;
                   IF i = 1 THEN
                      IF PerformMovesArray[p].Equip < TraceVB.TwoPositionPendingBreaks[i].VALUE THEN
                         ENDLOOP;
                      ENDIF;
                   ELSEIF PerformMovesArray[p].Equip < TraceVB.TwoPositionPendingBreaks[i].VALUE AND
                          PerformMovesArray[p].Equip > TraceVB.TwoPositionPendingBreaks[i-1].VALUE THEN
                      ENDLOOP;
                   ENDIF;
                   i = i + 1;
                ENDWHILE;
                
                IF i <> 0 THEN
                   TraceVB.TwoPositionPendingBreaks.InsertRow (rownumber = i);
                   TraceVB.TwoPositionPendingBreaks[i].Value = PerformMovesArray[p].Equip;
                ENDIF;
             ENDIF;
       ENDFOR;        
   ENDIF;        

    TraceStatus = TraceVB.StartVisibleBreakTrace();

/* Give warning if visible break check failed */
    IF TraceVB.FloatEquip IS NOT NULL THEN
/*
** Float Equip may indicated unconnected two terminal error or Fdr Load.
*/
       IF TraceVB.FloatEquip.Type = Type$FdrLoad THEN

          SELECT :FdrLoadFeeder = O.Name
          FROM   Udb_Object O,
                 Udb_Grouping G
          WHERE  O.Object = G.Grouping AND
                 G.GroupingType = :Type$Feeder AND
                 G.Relationship = :interaction$MemberOf AND
                 G.Member = :TraceVB.FloatEquip.Object;

          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'No visible break found on distribution feeder ' + FdrLoadFeeder);
       ELSE
          RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                Text = 'Not all visible breaks found.' + HC_NEWLINE +
                       'Starting from ' +  
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                       ', ran into a database connectivity problem at ' + 
                        TraceVB.FloatEquip.PrimaryGroupingName + '  ' +
                        TraceVB.FloatEquip.TypeName + '  ' + TraceVB.FloatEquip.Name);       
       ENDIF;
    
       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF TraceVB.ClosedOutBound IS NOT NULL THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'Not all visible breaks found.'  + HC_NEWLINE +  
                       'Starting from ' + 
                       JIP.EquipClassName + ' ' + JIP.EquipName + 
                         ', trace did not find a visible break ' +
                        'in all directions.');

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;

    ELSEIF TraceStatus = TraceStatus$Floating OR 
           TraceStatus = TraceStatus$OutofScope THEN

       RetCode = CALLFRAME Warning (Card = JIP.Card, 
                                    Job = JIP.Job,
                                    SwitchingItem = JIP.SwitchingItem, 
                 Text = 'Not all visible breaks found.' + HC_NEWLINE +
                        'Starting from ' + 
                        JIP.EquipClassName + ' ' + JIP.EquipName + 
                        ', trace did not find a visible break ' +
                        'in all directions.');

       IF RetCode = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RETURN(Warning$Overridden);
       ENDIF;
    ENDIF;

    RETURN(PU_OK);
END;


Application Component Report
============================

	Name:            CircuitClass


Component Method Scripts
--------------------------
/*
**
**      Copyright c 2010 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          CircuitClass
**
**  Date:       Version Description
** ----------------------------------
**  04/12/10 ysp  Add GetSubstationInfo method
**  05/02/19 em   Add RTUCircuitType
*/ 
METHOD GetSubstationInfo(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Borough <> 0 THEN
      i = 1;
      REPEATED
      SELECT :CurObject.SubstationInfo[i].Name = O.Name,
             :CurObject.SubstationInfo[i].Object = O.Object,
             :CurObject.SubstationInfo[i].Description = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.Circuit AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN ( SELECT  Type
                                FROM    Udb_ExtendedType
                                WHERE   Supertype IN (:Type$Substation, :Type$TelCircuitTerminal)
                                AND     Type <> :Type$TELCOSubstation) AND
              G.Grouping = O.Object AND
              O.PrimaryGrouping = :CurObject.Borough
      BEGIN
         i = i + 1;
      END;
   ELSE
      i = 1;
      REPEATED
      SELECT :CurObject.SubstationInfo[i].Name = O.Name,
             :CurObject.SubstationInfo[i].Object = O.Object,
             :CurObject.SubstationInfo[i].Description = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.Circuit AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN ( SELECT  Type
                                FROM    Udb_ExtendedType
                                WHERE   Supertype IN (:Type$Substation, :Type$TelCircuitTerminal)
                                AND     Type <> :Type$TELCOSubstation) AND
              G.Grouping = O.Object 
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;   
END;

Application Component Report
============================

	Name:            CircuitDetails_obsolete

/*
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Unified Information. 
** 
**  Application:    Telephone Card 
**  Frame:          CircuitDetails 
** 
**  ModIFication log: 
** 
**  Date:   Version     Description 
** -------------------------------------------------- 
**  10/24/95    hlf     Details for a particular circuit
**  12/12/95    em      fixed bugs
**  12/13/95    em      Set validated field based on validatedby
**  07/17/97    jfl     tls20: display TC equipment when MB3 on
**                      substationname.
**  01/16/04    em      Use Type$Line instead of AcLineSeg
**  04/26/05    pkw     Show type description and CSO reporting type and
**                      rework frame for ITC 155.
**  05/17/05    pkw     fix problem with add members of grouper circuits
**  10/06/08    pkw     Make screen similar to add new circuit screen.
**  11/22/08    pkw     Add automatic object validation
**  01/10/09    pkw     Auto-validate when any fields are updated on screen.
**  04/22/09    pkw     Allow ok button to show up on tab bar field.
**  01/19/10    ysp     TLS50: support multiple circuit routes
**  03/16/10    pkw     Update routes in database when trying to remove one
**                      so that user can replace circuit in matrix.
*/

INITIALIZE(
    CurrentCircuit = CardClass;         /* passed from select circuit screen */

    i = integer not null not default;
    j = integer not null not default;
    k = integer not null not default;
    Chosen = integer not null not default;
    HighRef = integer not null not default;
    NewRow = integer not null not default;
    RetCode = integer not null not default;
      
    LoadList = ARRAY of TypeClass;
    RouteTypeList = ARRAY of TypeClass;   /* Type lists */
    FuncAreaList = ARRAY of TypeClass;

    FdrList = ARRAY of ObjectClass;     /* Object lists */
    StnList = ARRAY of ObjectClass;
    CompanyList = ARRAY of ObjectClass;
    GrouperList = ARRAY of ObjectClass;

    CurStnList = ARRAY of ObjectClass;  /* Current grouping information */
    CurFdrList = ARRAY of ObjectClass;
    CktTypeList = ARRAY of ObjectClass; 
    CurAssocList = ARRAY of ObjectClass; 
    CurCarrier = ObjectClass;
    CurGrouper = ObjectClass;
    CurVerizonName = VARCHAR(40) NOT NULL WITH DEFAULT;
    
    SearchList = ARRAY of ObjectClass;
    ReducedList = ARRAY of ObjectClass;
    RouteName = VARCHAR(40) NOT NULL NOT DEFAULT;
    SearchName = VARCHAR(40) NOT NULL NOT DEFAULT;

    CalledFrom = VARCHAR(100) NOT NULL NOT DEFAULT;
    cl = ChoiceList;
    LoadCircuit = CardClass;
    TempChar = VARCHAR(40) NOT NULL WITH DEFAULT;
    TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
    PreFixName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SvcCodeName = VARCHAR(20) NOT NULL WITH DEFAULT;
    PreSerialName = VARCHAR(20) NOT NULL WITH DEFAULT;
    PostSerialName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SegmentName = VARCHAR(20) NOT NULL WITH DEFAULT;
    SvcCodeLength = INTEGER NOT NULL WITH DEFAULT;
    DashCount = INTEGER NOT NULL WITH DEFAULT;
    CompanyCode = VARCHAR(20) NOT NULL WITH DEFAULT;
    TempComment = VARCHAR(500) NOT NULL WITH DEFAULT;
    MatrixGrouping = ARRAY OF INTEGEROBJECT; /*List of matrix for ckt*/
    TempMatrix = INTEGER NOT NULL WITH DEFAULT; 
    TV       = TreeViewField;
    TCObject = TreeClass;
    SelectedType = INTEGER NOT NULL;
    SelectedName = VARCHAR(40) NOT NULL;
    btn_Clicked = integer not null not default;
    OldRouteList = ARRAY OF TypeClass;
) =
DECLARE
   Update_Routes = PROCEDURE;
BEGIN
    Curframe.CurMode = FM_READ;
    FIELD(TypeStack).CurBias = FB_INVISIBLE;
    FIELD(Obj).CurBias = FB_INVISIBLE;
/*
**  Initialize btn clicked so that we can clear the validated field.
*/
    btn_clicked = FALSE;
/*
**  Load type lists
*/

 /** Circuit Type **/
    i = 1;
    REPEATED
    SELECT  :CktTypeList[i].Object = T.Type,
            :CktTypeList[i].Name = T.Name,
            :CktTypeList[i].Description = T.Description
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$TelCircuit
    AND     E.Supertype <> E.Type
    AND     E.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)
    ORDER BY Name
    BEGIN
        /* We do not want user to pick any type that has a * in it */
        IF CktTypeList[i].Name LIKE '*%' THEN
           CktTypeList.RemoveRow(RowNumber = i);
        ELSE
           i = i + 1;
        ENDIF;
    END;
    
 /** Route **/
    RouteTypeList[1].Type = Type$Blank;
    RouteTypeList[1].Name = 'BLANK';
    i = 2;
    REPEATED
    SELECT  :RouteTypeList[i].Type = T.Type,
            :RouteTypeList[i].Name = T.Name
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$Route
    AND     E.Supertype <> E.Type
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;

 /** Function Area **/
    i = 1;
    REPEATED
    SELECT  :FuncAreaList[i].Type = T.Type,
            :FuncAreaList[i].Name = T.Name
    FROM    Udb_Type T,
            Udb_ExtendedType E
    WHERE   T.Type = E.Type
    AND     E.SuperType = :Type$FunctionArea
    AND     E.Supertype <> E.Type
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;
/*
**  Load Object Lists
*/
 /** Feeders/Networks/DivisionWorkStations **/
    i = 1;
    REPEATED
    SELECT  :FdrList[i].Object = O.Object,
            :FdrList[i].Name = O.Name,
            :FdrList[i].Type = O.Type,
            :FdrList[i].TypeName = O.TypeName
    FROM    Udb_Object O
    WHERE   O.Type IN (:Type$Line,:Type$Feeder,
                       :Type$Network,:Type$DivisionWorkstation)
    AND     O.Name <> 'Template'
    BEGIN
        i = i + 1;
    END;

 /** Substations and circuit terminals **/
    i = 1;
    REPEATED
    SELECT  :StnList[i].Object = O.Object,
            :StnList[i].Name = O.Name,
            :StnList[i].Type = O.Type,
            :StnList[i].TypeName = O.TypeName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
    BEGIN
        i = i + 1;
    END;

 /** Companies **/
    i = 1;
    REPEATED
    SELECT  :CompanyList[i].Object = O.Object,
            :CompanyList[i].Name = O.Name,
            :CompanyList[i].Type = O.Type,
            :CompanyList[i].TypeName = O.TypeName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType = :Type$Company
    BEGIN
        i = i + 1;
    END;

 /** Groupers **/

/*
**  put the primarygroupingname in for the type name
*/
    i = 1;
    REPEATED
    SELECT  :GrouperList[i].Object = O.Object,
            :GrouperList[i].Name = O.Name,
            :GrouperList[i].Type = O.Type,
            :GrouperList[i].TypeName = O.PrimaryGroupingName
    FROM    Udb_Object O,
            Udb_ExtendedType E
    WHERE   O.Type = E.Type
    AND     E.SuperType = :Type$TelCardGrouper
    BEGIN
        i = i + 1;
    END;
/*
**  Init route list field
*/
   cl.ChoiceItems.Clear();
   i = 1;
   WHILE (i <= RouteTypeList.LastRow()) DO
        cl.ChoiceItems[i].EnumValue = RouteTypeList[i].Type;
        cl.ChoiceItems[i].EnumText = RouteTypeList[i].Name;
        i = i + 1;
   ENDWHILE;
   FIELD(RTP.RT).ValueList = cl.Duplicate();
   FIELD(RTP.RT).UpdChoiceList();

/*
**  Build tree object
*/
   TCObject.TV = FIELD(tab.tree.TVF);
   TCObject.Root = Type$TelCircuit;
   TCObject.BuildTree(); 

END;

ON USEREVENT 'LoadCircuitDetails' =
BEGIN
    CurrentCircuit = Curframe.MessageObject;
    Curframe.SendUserEvent (EventName = 'ClearData');
    Curframe.SendUserEvent (EventName = 'LoadData');
END;

ON USEREVENT 'ClearData' =
BEGIN
/* clear the circuit information */
    FIELD(Ckt.CircuitInfo).SetToDefault();

/* clear the carrier information */
    CurCarrier.Object = 0;
    CurCarrier.Type = 0;
    CurCarrier.Name = '';
    CurCarrier.TypeName = '';
    FIELD(Ckt.CarrierInfo).SetToDefault();

/* clear the grouper information */
    CurGrouper.Object = 0;
    CurGrouper.Type = 0;
    CurGrouper.TypeName = '';
    CurGrouper.Name = '';
    FIELD(Grouper).SetToDefault();

/* clear the associated circuits information */
    CurAssocList.Clear();
    Associated_sf.Circuits.Clear();

/* clear the substation information */
    Ckt.SubstationInfo.Clear();
    CurStnList.Clear();

/* clear the feeder information */
    Ckt.FeederInfo.Clear();
    CurFdrList.Clear();

/* clear the verizon format */
    CurVerizonName = '';
END;

ON USEREVENT 'LoadData' =
BEGIN
    Curframe.CurMode = FM_UPDATE;
/*
**  Get the information for the current circuit
*/    
    REPEATED
    SELECT  :Ckt.CircuitInfo.Object = O.Object,
            :Ckt.CircuitInfo.Name = O.Name,
            :Ckt.CircuitInfo.Description = O.Description,
            :Ckt.CircuitInfo.Type = O.Type,
            :Ckt.CircuitInfo.TypeName = O.TypeName,
            :Ckt.CircuitInfo.PrimaryGrouping = O.PrimaryGrouping,
            :Ckt.CircuitInfo.PrimaryGroupingName = O.PrimaryGroupingName,
            :Ckt.CircuitInfo.Comment = O.Comment,
            :Ckt.CircuitInfo.Validated = O.Validated,
            :Ckt.CircuitInfo.ValidatedBy = O.ValidatedBy,
            :Ckt.CircuitInfo.Inservice = O.Inservice,
            :Ckt.CircuitInfo.Outservice = O.Outservice,
            :Ckt.CircuitInfo.PositionX = O.PositionX,
            :Ckt.CircuitInfo.PositionY = O.PositionY,
            :Ckt.CircuitInfo.OwnerNumber = O.OwnerNumber,
            :Ckt.CircuitInfo.SerialNumber = O.SerialNumber,
            :Ckt.CircuitInfo.SpecNumber = O.SpecNumber,
            :Ckt.CircuitInfo.Combination = O.Combination,
            :Ckt.CircuitInfo.LockNumber = O.LockNumber,
            :Ckt.CircuitInfo.LastChanged = O.LastChanged,
            :Ckt.CircuitInfo.LastChangedBy = O.LastChangedBy,
            :Ckt.FunctionArea = C.FunctionArea,
            :Ckt.FunctionAreaName = T1.Name,
            :Ckt.PriorityLine = C.PriorityLine,
            :Ckt.CurrentlyOpen = C.CurrentlyOpen
    FROM    Udb_Object O,
            Udb_TelephoneCircuit C,
            Udb_Type T1
    WHERE   O.Object = :CurrentCircuit.Circuit
    AND     O.Object = C.Object
    AND     C.FunctionArea = T1.Type;
    CALLPROC DDB_ROLLBACK;
/*
** get circuit's route/channels
*/
    RouteName = '';
    OldRouteList.Clear();
    i = 1;
    SELECT :OldRouteList[i].Type = T.Type,
           :OldRouteList[i].Name = SQUEEZE(T.Name)
    FROM   UDB_CircuitRoute C,
           UDB_Type T
    WHERE  C.Object = :CurrentCircuit.Circuit AND
           C.Route = T.Type AND
           C.Route <> 0
    BEGIN
       IF RouteName <> '' THEN
          RouteName = RouteName  + '; ' ;
       ENDIF;
       RouteName = RouteName + OldRouteList[i].Name;
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    RTP.RL = OldRouteList.Duplicate();
    FIELD(Ckt.RouteName).TextValue = RouteName;
/*
**  Get CSO Report type
*/
    SELECT :Ckt.CircuitInfo.Status = T.Name
    FROM    Udb_Type T,
            Udb_SuperType ST,
            Udb_Supertype ST2
    WHERE   T.Type = ST.SuperType AND
            ST.Type = :Ckt.CircuitInfo.Type AND
            ST.SuperType = ST2.Type AND
            ST2.SuperType = :Type$CircuitReportCategory;
    CALLPROC DDB_ROLLBACK;
/*
**  Get all grouping information for the circuit
*/
    REPEATED
    SELECT  :CurCarrier.Object = O.Object,
            :CurCarrier.Type = O.Type,  
            :CurCarrier.TypeName = O.TypeName,
            :CurCarrier.Name = O.Name
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$ProvidedBy
    AND     G.Grouping = O.Object;
    CALLPROC DDB_ROLLBACK;
    Ckt.CarrierInfo = CurCarrier.Duplicate();
    
    IF Ckt.CarrierInfo.Object = Company$Verizon THEN
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_CHANGEABLE;
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_CHANGEABLE;
       SELECT :CurVerizonName = V.LineName
       FROM    TC_VerizonCircuit V
       WHERE   V.Circuit = :CurrentCircuit.Circuit;
       Ckt.CircuitInfo.CreatedBy = CurVerizonName;
       IF Ckt.CircuitInfo.CreatedBy = '' THEN
          Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
       ENDIF;
       CurFrame.IsAutoSized = TRUE;
       CurFrame.Flush();   
    ELSE
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_INVISIBLE;
       FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_INVISIBLE;
    ENDIF;
    
    REPEATED
    SELECT  :CurGrouper.Object = O.Object,
            :CurGrouper.Type = O.Type,
            :CurGrouper.TypeName = O.PrimaryGroupingName, /*load substation*/
            :CurGrouper.Name = O.Name
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  SuperType = :Type$TelCardGrouper)
    AND     G.Grouping = O.Object;
    CALLPROC DDB_ROLLBACK;
    Grouper = CurGrouper.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurAssocList[i].Object = O.Object,
            :CurAssocList[i].Name = O.Name,
            :CurAssocList[i].Type = O.Type,
            :CurAssocList[i].TypeName = O.TypeName
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Grouping = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.MemberType IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  Supertype = :Type$TelCircuit)
    AND     G.Member = O.Object
    ORDER BY Status
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    Associated_sf.Circuits = CurAssocList.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurStnList[i].Object = O.Object,
            :CurStnList[i].Name = O.Name,
            :CurStnList[i].Type = O.Type,
            :CurStnList[i].TypeName = O.TypeName,
            :CurStnList[i].Status = G.Reference    /* use this for now */
    FROM    Udb_Grouping G,
            Udb_Object O
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
    AND     G.Grouping = O.Object
    ORDER BY Status
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    Ckt.SubstationInfo = CurStnList.Duplicate();

    i = 1;
    REPEATED
    SELECT  :CurFdrList[i].Object = O.Object,
            :CurFdrList[i].Type = O.Type,
            :CurFdrList[i].TypeName = O.TypeName,
            :CurFdrList[i].Name = O.Name
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   G.Member = :CurrentCircuit.Circuit
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.GroupingType IN ( SELECT Type
                                FROM   Udb_ExtendedType
                                WHERE  Supertype IN 
                                       (:Type$Feeder,:Type$Network,:Type$Line,
                                        :Type$DivisionWorkstation))
    AND     G.Grouping = O.Object
    BEGIN
        i = i + 1;
    END;
    Ckt.FeederInfo = CurFdrList.Duplicate();
/*
**  Populate division and desk fields
*/
    TempComment = '';
    SELECT  :TempName = O.Name
    FROM     Udb_Object O,
             Udb_Grouping G
    WHERE    G.Member = :CurrentCircuit.Circuit AND
             G.RelationShip = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND
             G.Grouping = O.Object
    BEGIN
       TempComment = TempComment + TempName + HC_NEWLINE;
    END;
    IF TempComment = '' THEN
       FIELD(Division_Txt).BGColor = CC_RED;
       TempComment = 'NONE!' + HC_NEWLINE;
    ELSE
       FIELD(Division_Txt).BGColor = CC_PALE_BLUE;
    ENDIF;

    TempComment = left(TempComment, length(TempComment) - 1);
    FIELD(Division_txt).TextValue = TempComment;
    

    TempComment = '';
    SELECT  :TempName = O.Name
    FROM     Udb_Object O,
             Udb_Grouping G
    WHERE    G.Member = :CurrentCircuit.Circuit AND
             G.RelationShip = :Interaction$ControlledBy AND
             G.GroupingType = :Type$OperatorDesk AND
             G.Grouping = O.Object
    BEGIN
       TempComment = TempComment + TempName + HC_NEWLINE;
    END;
    IF TempComment = '' THEN
       FIELD(Desk_Txt).BGColor = CC_RED;
       TempComment = 'NONE!' + HC_NEWLINE;
    ELSE
       FIELD(Desk_Txt).BGColor = CC_PALE_BLUE;
    ENDIF;

    TempComment = left(TempComment, length(TempComment) - 1);
    FIELD(Desk_txt).TextValue = TempComment;
/*
** Determine which field to show.
*/
    i = 0;
    SELECT :i = ET.Type
    FROM    Udb_ExtendedType ET
    WHERE   SuperType = :Type$TelCardGrouper AND
            Type = :Ckt.CircuitInfo.Type;
    IF i <> 0 THEN /* Grouper circuit type */
       Associated_sf.Circuits = CurAssocList.Duplicate();
       FIELD(Associated_sf).AllBias = FB_LANDABLE;
       FIELD(Associated_sf).CurBias = FB_LANDABLE;

       FIELD(Grouper).SetToDefault();
       FIELD(Grouper).ParentField.AllBias = FB_INVISIBLE;
       FIELD(Grouper).ParentField.CurBias = FB_INVISIBLE;
       
    ELSE
       Grouper = CurGrouper.Duplicate();
       FIELD(Grouper).ParentField.AllBias = FB_LANDABLE;
       FIELD(Grouper).ParentField.CurBias = FB_LANDABLE;

       Associated_sf.Circuits.Clear();
       FIELD(Associated_sf).AllBias = FB_INVISIBLE;
       FIELD(Associated_sf).CurBias = FB_INVISIBLE;
       
    ENDIF;
/*
**  Determine which buttons to show on the bottom of the screen. 
*/
    IF UPPERCASE(Ckt.CircuitInfo.Name) LIKE '%PENDDISC' THEN
       FIELD(Pending_btn).AllBias = FB_INVISIBLE;
       FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
       FIELD(Remove_btn).AllBias = FB_LANDABLE;
       FIELD(Remove_btn).CurBias = FB_LANDABLE;       
    ELSE
       FIELD(Pending_btn).AllBias = FB_LANDABLE;
       FIELD(Pending_btn).CurBias = FB_LANDABLE;
              
       FIELD(Remove_btn).AllBias = FB_INVISIBLE;
       FIELD(Remove_btn).CurBias = FB_INVISIBLE;
    ENDIF;

    CurFrame.IsAutoSized = TRUE;
    CurFrame.Flush();   

    CurFrame.BringToFront();
END;

ON CLICK Pending_btn =
BEGIN
   
   IF CurFrame.ConfirmPopup (messagetext = 'Are you sure you want to ' +
         'remove all groupings with this circuit and set the name to ' + 
         Ckt.CircuitInfo.Name + '_PendDisc?   Select ''OK'' to continue.') = PU_CANCEL THEN
   
      RESUME;
   ENDIF;
   /*
   **  Make sure circuit is not on a matrix.
   */
   i = 0;
   SELECT :i = COUNT(*)
   FROM    CAC_Relay_Circuit
   WHERE   Circuit = :CurrentCircuit.Circuit;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      IF CurFrame.ConfirmPopup (messagetext = 'This circuit is part of a ' + 
              'Relay Protection Matrix. Before setting a circuit ' +
              'to Pending Disconnect, you must first replace the circuit ' +
              'in the Relay Protection Matrix.  Select ''OK'' to load the ' + 
              'Relay Protection Matrix and replace the circuit.') = PU_CANCEL THEN
         RESUME;
      ENDIF;
      /*
      **  First select the number of matrix's each circuit is a member of.
      **  If there are more than one, then we will display a frame to select
      **  which matrix they would like to view.
      **  If there is only one, we will load the matrix.
      */
      MatrixGrouping.Clear();
      SELECT :TempMatrix = R.Grouping
      FROM   CAC_Relay_Circuit R
      WHERE  R.Circuit = :CurrentCircuit.Circuit
      BEGIN
         FOR i = 1 TO MatrixGrouping.LastRow() DO
            If MatrixGrouping[i].Value = TempMatrix THEN
               ENDLOOP;
            ENDIF;
         ENDFOR;
         IF i > MatrixGrouping.LastRow() THEN
            MatrixGrouping[i].Value = TempMatrix;
         ENDIF;          
      END;

      IF MatrixGrouping.LastRow() = 1 THEN
          CALLFRAME RelayProtectionMatrix(
                              CurrentGrouping = MatrixGrouping[1].Value,
                              CardObject = 0,
                              FromTC = TRUE);
      ELSE
          CALLFRAME ProtectionCompromised(
                              MatrixGrouping = MatrixGrouping.Duplicate(),
                              FromTC = TRUE);         
      ENDIF;
      RESUME;
   ENDIF;


   TempComment = '(Substations:';
   FOR i = 1 TO Ckt.SubstationInfo.LastRow() DO
      TempComment = TempComment + ' ' + Ckt.SubstationInfo[i].Name;
   ENDFOR;

   TempComment = TempComment + ') (Feeders:';   
   IF Ckt.FeederInfo.LastRow() = 0 THEN
      TempComment = TempComment + 'None';
   ELSE
      FOR i = 1 TO Ckt.FeederInfo.LastRow() DO
         TempComment = TempComment + ' ' + Ckt.FeederInfo[i].Name;
      ENDFOR;
   ENDIF;
   
   TempComment = TempComment + ') Route: ' + Ckt.RouteName;

   TempComment = Ckt.CircuitInfo.Comment + HC_NEWLINE + 
                 TempComment;
   Ckt.CircuitInfo.Comment = TempComment;
   /*
   **  Update for Grouping History insert.
   */
   TempComment = Ckt.CircuitInfo.Name + ' was set to Pending Disconnect. ' + 
                 'Comment: ' + TempComment;
   
   Ckt.CircuitInfo.Name = Ckt.CircuitInfo.Name + '_PendDisc';
   Ckt.CircuitInfo.Outservice = DATE('now');

   IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
      Ckt.CircuitInfo.Validated = 'now';
   ELSE
      IF DOp.Type = Type$PersonDO THEN
         Ckt.CircuitInfo.Validated = 'now';
         Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
      ELSE
         Ckt.CircuitInfo.Validated = NULL;
      ENDIF;
   ENDIF;
/*
**  Update object and remove telephone circuit information
*/
   RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Ckt.CircuitInfo.Type,
                PrimaryGrouping = Ckt.CircuitInfo.PrimaryGrouping,
                TypeName = Ckt.CircuitInfo.TypeName,
                PrimaryGroupingName = Ckt.CircuitInfo.PrimaryGroupingName,
                Name = Ckt.CircuitInfo.Name,
                Description = Ckt.CircuitInfo.Description,
                Comment = Ckt.CircuitInfo.Comment,
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error occurred while updating circuit object information.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while updating circuit information.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Update routes.
*/
   CALLPROC Update_Routes();
/*
**  Remove Verizon format
*/
   RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to remove the Verizon format.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Delete all grouping information
*/
   RetCode = CALLPROC Udb_GroupingDeleteAll (
               Grouping = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping information.';
       RESUME;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingMemberDel (
               Member = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping memberships.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Log for reporting.
   */
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = 0, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$PendingDisconnect,
                   Comment = TempComment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:CircuitDetails:Error logging Pending Disconnect of circuit.');
   ENDIF;
   CALLPROC DDB_COMMIT;  
   /*
   **  Set bias for buttons.
   */
   FIELD(Pending_btn).AllBias = FB_INVISIBLE;
   FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
   FIELD(Remove_btn).AllBias = FB_LANDABLE;
   FIELD(Remove_btn).CurBias = FB_LANDABLE;       
END;

ON CLICK Remove_btn =
BEGIN
   /*
   **  Make sure circuit is not on a matrix.
   */
   i = 0;
   SELECT :i = COUNT(*)
   FROM    CAC_Relay_Circuit
   WHERE   Circuit = :CurrentCircuit.Circuit;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      MESSAGE 'Before deleting a circuit, ' +
              'you must first remove it from any Relay Protection Matix.';
      RESUME;
   ENDIF;

   IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
      Ckt.CircuitInfo.Validated = 'now';
   ELSE
      IF DOp.Type = Type$PersonDO THEN
         Ckt.CircuitInfo.Validated = 'now';
         Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
      ELSE
         Ckt.CircuitInfo.Validated = NULL;
      ENDIF;
   ENDIF;
/*
**  Update object and remove telephone circuit information
*/
   RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Type$ObsoleteObject,
                PrimaryGrouping = 0,
                TypeName = 'Obsolete Object',
                PrimaryGroupingName = '',
                Name = varchar(Ckt.CircuitInfo.Object),
                Description = '',
                Comment = '',
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Error occurred while updating circuit object information.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while updating circuit information.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Remove Verizon format
*/
   RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to remove the Verizon format.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Delete all grouping information
*/
   RetCode = CALLPROC Udb_GroupingDeleteAll (
               Grouping = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping information.';
       RESUME;
   ENDIF;

   RetCode = CALLPROC Udb_GroupingMemberDel (
               Member = CurrentCircuit.Circuit);
   IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Error occurred while deleting grouping memberships.';
       RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Log for reporting.
   */
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = 0, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$RemoveCircuit,
                   Comment = Ckt.CircuitInfo.Name + ' removed; Comment was: ' +
                             Ckt.CircuitInfo.Comment);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:CircuitDetails:Error logging Removing of circuit.');
   ENDIF;
   CALLPROC DDB_COMMIT;  
   /*
   **  Set bias for buttons.
   */
   FIELD(Pending_btn).AllBias = FB_INVISIBLE;
   FIELD(Pending_btn).CurBias = FB_INVISIBLE;
              
   FIELD(Remove_btn).AllBias = FB_INVISIBLE;
   FIELD(Remove_btn).CurBias = FB_INVISIBLE;     
END;


ON SetValue Ckt.CircuitInfo.Name = 
BEGIN
   IF Ckt.CarrierInfo.Object = Company$Verizon THEN
      Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
   ENDIF;
END;

ON UserEvent 'ConvertToVerizon' = 
BEGIN
   /*
   **  First lets replace any '.' with a '-' and see
   **  how many - we have.
   */
   TempName = Ckt.CircuitInfo.Name;
   PreFixName = '';
   DashCount = 0;
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF TempChar = '.' OR
         TempChar = '-' THEN
         TempChar = '-';
         DashCount = DashCount + 1;
      ENDIF;
      PreFixName = PreFixName + TempChar;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;

   TempName = PreFixName;

   PreFixName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF '0' <= TempChar AND TempChar <= '9' THEN
         PreFixName = PreFixName + TempChar;
      ELSE
         ENDLOOP;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;

   SvcCodeName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF '0' <= TempChar AND TempChar <= '9' THEN
         ENDLOOP;
      ELSE
         SvcCodeName = SvcCodeName + TempChar;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;
   
   SvcCodeLength = LENGTH(SvcCodeName);
   IF SvcCodeLength = 4 THEN
      CompanyCode = '/ny';
   ELSE
      IF DashCount > 1 THEN
         CompanyCode = '/';
      ELSE
         CompanyCode = '';
      ENDIF;
   ENDIF;
   
   PreSerialName = '';
   WHILE length(TempName) > 0 DO
      TempChar = left(TempName,1);
      IF TempChar = '-' THEN
         TempName = SHIFT(TempName,-1);
         ENDLOOP;
      ELSE
         PreSerialName = PreSerialName + TempChar;
      ENDIF;
      TempName = SHIFT(TempName,-1);
   ENDWHILE;
   
   IF Length(TempName) > 0 THEN
      TempChar = left(TempName,1);
   ELSE
      TempChar = '';
   ENDIF;
   /*
   **  If next character is a number and SvcCode is not 4 characters
   **  this is part of the SerialName.  Otherwise it is part of the segment.
   */
   IF SvcCodeLength <> 4 AND 
     ('0' <= TempChar AND TempChar <= '9') THEN
      PostSerialName = '';
      WHILE length(TempName) >= 0 DO
         TempChar = left(TempName,1);
         /*
         **  Go through this logic if we see a '-' or if this
         **  is the last character of the linenumber.
         */
         IF TempChar = '-' OR LENGTH(TempName) = 0 THEN
            IF TempChar = '-' THEN
               TempName = SHIFT(TempName,-1);
            ENDIF;
            IF LENGTH(PostSerialName) = 1 THEN
               PostSerialName = '00' + PostSerialName;
            ELSEIF LENGTH(PostSerialName) = 2 THEN
               PostSerialName = '0' + PostSerialName;
            ENDIF;
            TempChar = PreSerialName + PostSerialName;
            SegmentName = '';
            WHILE LENGTH(TempChar) < 10 DO
               SegmentName = SegmentName + ' ';
               TempChar = PreSerialName + SegmentName + PostSerialName;          
            ENDWHILE;
            PreSerialName = TempChar;
            SegmentName = '';
            ENDLOOP;
         ELSE
            PostSerialName = PostSerialName + TempChar;
         ENDIF;
         TempName = SHIFT(TempName,-1);
      ENDWHILE;
   ENDIF;

   IF TempName <> '' THEN
      SegmentName = '/' + TempName;
   ELSE
      SegmentName = '';
   ENDIF;
   /*
   **  Don't show message if this is a future circuit.
   */
   IF Ckt.CircuitInfo.Name like 'FUTURE%' THEN
      RESUME;
   ENDIF;

   IF PreFixName = '' OR
      SvcCodeName = '' OR
      PreSerialName = '' THEN
      MESSAGE 'Unable to convert to Verizon format. ' + HC_NEWLINE +
              'You can not use the eletronic interface ' + HC_NEWLINE +
              'to create tickets for this Circuit with ' + HC_NEWLINE +
              'no Verizon Format.  ' + HC_NEWLINE +
              'Please contact Verizon for proper format.';
      RESUME;
   ENDIF;
     
   Ckt.CircuitInfo.CreatedBy = PreFixName + '/' + 
                               SvcCodeName + '/' + 
                               PreSerialName + 
                               CompanyCode + 
                               SegmentName;
END;

ON ENTRY Ckt.RouteName = 
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   FIELD(RTP).AbsXLeft = FIELD(Ckt.RouteName).AbsXLeft;
   FIELD(RTP).AbsYTop = FIELD(Ckt.RouteName).AbsYBottom;
   FIELD(RTP.DEL_Btn).CurBias = FB_DIMMED;
   FIELD(RTP).CurBias = FB_CHANGEABLE;
END;

ON SetValue RTP.RT = 
DECLARE
   NewRoute = TypeClass;
BEGIN
   IF RTP.RT = 0 THEN
      RESUME;
   ENDIF;

   RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = RTP.RT);
   IF RetCode = ER_OK THEN
      MESSAGE 'Your selected route is already defined for this circuit';
      RESUME; 
   ENDIF;
        
   NewRoute.Type = RTP.RT;
   NewRoute.Name = FIELD(RTP.RT).CurEnumText;
   RTP.RL.InsertRow(RowNumber = (RTP.RL.LastRow + 1),
                             RowObject = NewRoute);
   RESUME;
END;

ON ChildEntry RTP.RL =
BEGIN
   FIELD(RTP.DEL_Btn).CurBias = FB_LANDABLE;
END; 

ON Click RTP.Del_Btn = 
BEGIN
   i = FIELD(RTP.RL).CurRow;
   RetCode = OldRouteList.Find(AttributeName = 'type',
                               Value = RTP.RL[i].Type);
   IF RetCode = ER_OK THEN
      /*
      **  Make sure circuit is not on a matrix.
      */
      k = 0;
      SELECT :k = 1 
      FROM   CAC_CO_Circuit
      WHERE  Circuit = :Ckt.CircuitInfo.Object AND
             Route = :RTP.RL[i].Type
      UNION
      SELECT 1 
      FROM   CAC_Relay_Circuit
      WHERE  Circuit = :Ckt.CircuitInfo.Object AND
             Route = :RTP.RL[i].Type;

      IF k = 1 THEN
         IF CurFrame.ConfirmPopup (messagetext = 'This route is part of a ' + 
              'Relay Protection Matrix.  ' +
              'You must remove this route from the matrix ' +
              'before deleting it from the circuit.  Select ''OK'' to load the ' + 
              'Relay Protection Matrix and replace the circuit/route.') = PU_CANCEL THEN
            RESUME;
         ENDIF;
         /*
         **  Update route information so user has option of switching current
         **  circuit/route combo with a new circuit/route combo.
         */
         CALLPROC Update_Routes();
         /*
         **  First select the number of matrix's each circuit is a member of.
         **  If there are more than one, then we will display a frame to select
         **  which matrix they would like to view.
         **  If there is only one, we will load the matrix.
         */
         MatrixGrouping.Clear();
         SELECT :TempMatrix = R.Grouping
         FROM   CAC_Relay_Circuit R
         WHERE  R.Circuit = :CurrentCircuit.Circuit
         BEGIN
            FOR i = 1 TO MatrixGrouping.LastRow() DO
               If MatrixGrouping[i].Value = TempMatrix THEN
                  ENDLOOP;
               ENDIF;
            ENDFOR;
            IF i > MatrixGrouping.LastRow() THEN
               MatrixGrouping[i].Value = TempMatrix;
            ENDIF;          
         END;

         IF MatrixGrouping.LastRow() = 1 THEN
            CALLFRAME RelayProtectionMatrix(
                              CurrentGrouping = MatrixGrouping[1].Value,
                              CardObject = 0,
                              FromTC = TRUE);
         ELSE
            CALLFRAME ProtectionCompromised(
                              MatrixGrouping = MatrixGrouping.Duplicate(),
                              FromTC = TRUE);         
         ENDIF;
         RESUME;
      ENDIF;
   ENDIF;
   RTP.RL.RemoveRow(RowNumber = i);
   FIELD(RTP.DEL_Btn).CurBias = FB_DIMMED;
END;

ON Click RTP.OK_Btn = 
BEGIN
   RouteName = '';
   FOR i = 1 TO RTP.RL.LastRow DO
       IF RouteName <> '' THEN
          RouteName = RouteName + '; ';
       ENDIF;
       RouteName = RouteName + RTP.RL[i].Name;
   ENDFOR;
   Field(Ckt.RouteName).TextValue = RouteName;
   FIELD(Ckt.RouteName).IsCurField = FALSE;

   FIELD(RTP).CurBias = FB_INVISIBLE;
END;

ON ENTRY Ckt.CircuitInfo.PrimaryGroupingName,
ON ENTRY Ckt.FunctionAreaName =
BEGIN
/*
**  Keep track of where the type list was called from
*/
    CalledFrom = Curframe.TriggerField.FullName;
/*
**  Load the list for the appropriate field
*/
    IF (CalledFrom like '%functionareaname%') THEN
        LoadList = FuncAreaList.Duplicate();
    ELSEIF (CalledFrom like '%primarygroupingname%') THEN
        i = 0;
        SELECT :i = ET.Type
        FROM    Udb_ExtendedType ET
        WHERE   SuperType = :Type$TelCardGrouper AND
                Type = :Ckt.CircuitInfo.Type;
        LoadList.Clear();
        IF i <> 0 THEN /* Grouper circuit type */
           IF Ckt.SubstationInfo.LastRow() = 0 THEN
              message 'You must add a substation before choosing a Primary Grouping.';
              RESUME;
           ENDIF;
           
           FOR i = 1 TO Ckt.SubstationInfo.LastRow() DO
              LoadList[i].Type = Ckt.SubstationInfo[i].Object;
              LoadList[i].Name = Ckt.SubstationInfo[i].Name;
           ENDFOR;
        ELSE
           IF Ckt.FeederInfo.LastRow() = 0 AND
              Ckt.SubstationInfo.LastRow() = 0 THEN
              message 'You must add a substation/feeder before choosing a Primary Grouping.';
              RESUME;
           ENDIF;

           FOR i = 1 TO Ckt.FeederInfo.LastRow() DO
              LoadList[i].Type = Ckt.FeederInfo[i].Object;
              LoadList[i].Name = Ckt.FeederInfo[i].Name;
           ENDFOR;      
           FOR j = 1 TO Ckt.SubstationInfo.LastRow() DO
              LoadList[i].Type = Ckt.SubstationInfo[j].Object;
              LoadList[i].Name = Ckt.SubstationInfo[j].Name;
              i = i + 1;            
           ENDFOR;
        ENDIF;

    ENDIF;
    
    cl.ChoiceItems.Clear();
    i = 1;
    WHILE (i <= LoadList.LastRow()) DO
        cl.ChoiceItems[i].EnumValue = LoadList[i].Type;
        cl.ChoiceItems[i].EnumText = LoadList[i].Name;
        i = i + 1;
    ENDWHILE;

    FIELD(TypeStack.TheTypeList).ValueList = cl.Duplicate();
    FIELD(TypeStack.TheTypeList).UpdChoiceList();

/*
**  Default to the current type
*/
    IF (CalledFrom like '%functionareaname%') THEN
        TypeStack.TheTypeList = Ckt.FunctionArea;
    ENDIF;
        
    Curframe.Curmode = FM_READ;
    Curframe.Flush();
    FIELD(TypeStack).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
    FIELD(TypeStack).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop;
    FIELD(TypeStack).CurBias = FB_CHANGEABLE;
    Curframe.Flush();
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END; 

ON CLICK TypeStack.OK_Btn =
BEGIN
/*
**  Place the chosen value into the appropriate field
*/
    IF (CalledFrom like '%functionareaname%') THEN
        Ckt.FunctionArea = FIELD(TypeStack.TheTypeList).CurEnumValue;
        Ckt.FunctionAreaName = FIELD(TypeStack.TheTypeList).CurEnumText;
        FIELD(Ckt.FunctionAreaName).IsCurField = FALSE;
    ELSEIF (CalledFrom like '%primarygroupingname%') THEN
        Ckt.CircuitInfo.PrimaryGrouping = FIELD(TypeStack.TheTypeList).CurEnumValue;
        Ckt.CircuitInfo.PrimaryGroupingName = FIELD(TypeStack.TheTypeList).CurEnumText;
        FIELD(Ckt.CircuitInfo.PrimaryGroupingName).IsCurField = FALSE;
    ENDIF;

    FIELD(TypeStack).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
/*
**  Make the focus automatically go to the circuit name
*/
    Curframe.InputFocusField = FIELD(Ckt.CircuitInfo.Name);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;


ON ENTRY Ckt.CarrierInfo.Name,
ON ENTRY Grouper.Name,
ON ENTRY Grouper.TypeName,
ON CLICK Add_Sub,
ON CLICK Add_Feeder =
BEGIN
    CalledFrom = Curframe.TriggerField.FullName;

    Curframe.CurMode = FM_READ;
    FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList[*].Description).CurBias = FB_INVISIBLE;
    Curframe.Flush();

    IF (CalledFrom like '%grouper%name%') THEN
        Obj.TheObjectList = GrouperList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Grouper';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXRight = FIELD(Grouper.TypeName).AbsXRight;
        FIELD(Obj).AbsYBottom = FORMFIELD(Curframe.TriggerField).AbsYBottom;
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        Obj.TheObjectList = CompanyList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Carrier';
        FIELD(Obj).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
        FIELD(Obj).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop - 1000;
    ELSEIF (CalledFrom like '%add_sub%') THEN
        Obj.TheObjectList = StnList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Substation';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXLeft = FIELD(Ckt.SubstationInfo).AbsXLeft;
        FIELD(Obj).AbsYBottom = FIELD(Ckt.SubstationInfo).AbsYBottom;
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        Obj.TheObjectList = FdrList.Duplicate();
        FIELD(Obj.TheObjectList).Title = 'Select Feeder/Network';
        FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_LANDABLE;
        Curframe.Flush();
        FIELD(Obj).AbsXRight = FIELD(Ckt.FeederInfo).AbsXRight;
        FIELD(Obj).AbsYBottom = FIELD(Ckt.FeederInfo).AbsYBottom;
    ENDIF;

    FIELD(Obj).CurBias = FB_CHANGEABLE;
    FIELD(Obj.TheObjectList).UpdField();
    Curframe.Flush();
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END; 

ON ENTRY Ckt.CircuitInfo.TypeName =
BEGIN
   FIELD(tab).CurBias = FB_CHANGEABLE;
   Curframe.Flush();
   FIELD(tab).AbsXRight = FORMFIELD(Curframe.TriggerField).AbsXRight;
   FIELD(tab).AbsYTop = FORMFIELD(Curframe.TriggerField).AbsYTop;
   tab.tbl.TheObjectList = CktTypeList.Duplicate();     
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;   
END;

ON CLICK Associated_sf.Add_Btn = 
BEGIN
/*
**  Select a list of all circuits
*/
    LoadCircuit = CALLFRAME SelectCircuit();

    IF LoadCircuit.Circuit = No$Value THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       FOR i = 1 TO Associated_sf.Circuits.LastRow() DO
          IF Associated_sf.Circuits[i].Object = LoadCircuit.Circuit THEN
             message 'This circuit is already in the list.';
             RESUME;
          ENDIF;
       ENDFOR; 
       i = Associated_sf.Circuits.LastRow() + 1;
       Associated_sf.Circuits[i].Object   = LoadCircuit.Circuit;
       Associated_sf.Circuits[i].Name     = LoadCircuit.LineNumber;
       Associated_sf.Circuits[i].Type     = LoadCircuit.LineType;
       Associated_sf.Circuits[i].TypeName = LoadCircuit.LineTypeName;
    ENDIF;
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

ON CLICK Associated_sf.Delete_Btn =
BEGIN
    Chosen = FIELD(Associated_sf.Circuits).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a circuit to delete.';
        RESUME;
    ENDIF;

    Associated_sf.Circuits.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

/*
** Call frame to view the equipment at the selected substation
*/
ON ChildProperties Ckt.SubstationInfo[*].Name =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
    i = FIELD(Ckt.SubstationInfo).WhichRow (cellfield = CurFrame.TriggerField);
    CALLFRAME AlterTCEquipType (Circuit = Ckt.CircuitInfo,
                                Substation = Ckt.SubstationInfo[i]);
END;


ON CHILDENTRY Obj.TheObjectList[*].Name,
ON CHILDENTRY Obj.TheObjectList[*].Description,
ON CHILDENTRY Obj.TheObjectList[*].TypeName =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    Chosen = FIELD(Obj.TheObjectList).CurRow;
/*
**  Put the information into the appropriate place
*/
    IF (CalledFrom like '%grouper%name%') THEN
        Grouper.Object = Obj.TheObjectList[Chosen].Object;
        Grouper.Name = Obj.TheObjectList[Chosen].Name;
        Grouper.Type = Obj.TheObjectList[Chosen].Type;
        Grouper.TypeName = Obj.TheObjectList[Chosen].TypeName;
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        Ckt.CarrierInfo.Object = Obj.TheObjectList[Chosen].Object;
        Ckt.CarrierInfo.Name = Obj.TheObjectList[Chosen].Name;
        Ckt.CarrierInfo.Type = Obj.TheObjectList[Chosen].Type;
        Ckt.CarrierInfo.TypeName = Obj.TheObjectList[Chosen].TypeName;

        IF Ckt.CarrierInfo.Object = Company$Verizon THEN
           FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_CHANGEABLE;
           FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_CHANGEABLE;
           Curframe.SendUserEvent (EventName = 'ConvertToVerizon');
        ELSE
           IF FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias <> FB_INVISIBLE THEN
              Ckt.CircuitInfo.CreatedBy = '';
              FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.AllBias = FB_INVISIBLE;
              FIELD(Ckt.CircuitInfo.CreatedBy).ParentField.CurBias = FB_INVISIBLE;
           ENDIF;
        ENDIF;
        CurFrame.IsAutoSized = TRUE;
        CurFrame.Flush();   
    ELSEIF (CalledFrom like '%add_sub%') THEN
        NewRow = Ckt.SubstationInfo.LastRow() + 1;
        Ckt.SubstationInfo[NewRow].Object = Obj.TheObjectList[Chosen].Object;
        Ckt.SubstationInfo[NewRow].Name = Obj.TheObjectList[Chosen].Name;
        Ckt.SubstationInfo[NewRow].Type = Obj.TheObjectList[Chosen].Type;
        Ckt.SubstationInfo[NewRow].TypeName = Obj.TheObjectList[Chosen].TypeName;
    /*
    **  Determine the next highest reference number
    */
        HighRef = 0;
        i = 1;
        WHILE (i <= Ckt.SubstationInfo.LastRow()) DO
            IF (Int4(Ckt.SubstationInfo[i].Status) > HighRef) THEN
                HighRef = int4(Ckt.SubstationInfo[i].Status);
            ENDIF; 
            i = i + 1;
        ENDWHILE;
        HighRef = HighRef + 1;
        Ckt.SubstationInfo[NewRow].Status = varchar(HighRef);
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        NewRow = Ckt.FeederInfo.LastRow() + 1;
        Ckt.FeederInfo[NewRow].Object = Obj.TheObjectList[Chosen].Object;
        Ckt.FeederInfo[NewRow].Name = Obj.TheObjectList[Chosen].Name;
        Ckt.FeederInfo[NewRow].Type = Obj.TheObjectList[Chosen].Type;
        Ckt.FeederInfo[NewRow].TypeName = Obj.TheObjectList[Chosen].TypeName;

    ENDIF;

    FIELD(Obj.TheObjectList[*].TypeName).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList[*].Description).CurBias = FB_INVISIBLE;
    FIELD(Obj.TheObjectList).UpdField();
    Curframe.Flush();
    FIELD(Obj).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
END;

ON CLICK Obj.Find_Btn =
BEGIN
    SearchName = '%' + Obj.FindName + '%';    

    SearchList.Clear();
    ReducedList.Clear();
    IF (CalledFrom like '%grouper%name%') THEN
        SearchList = GrouperList.Duplicate();
    ELSEIF (CalledFrom like '%carrier%name%') THEN
        SearchList = CompanyList.Duplicate();
    ELSEIF (CalledFrom like '%add_sub%') THEN
        SearchList = StnList.Duplicate();
    ELSEIF (CalledFrom like '%add_feeder%') THEN
        SearchList = FdrList.Duplicate();
    ELSEIF (CalledFrom like '%typename%') THEN
        SearchList = CktTypeList.Duplicate();
    ENDIF;

    i = 1;
    j = 1;
    WHILE (i <= SearchList.LastRow()) DO
        IF (Uppercase(SearchList[i].Name) like Uppercase(SearchName)) THEN
            ReducedList[j] = SearchList[i].Duplicate();
            j = j + 1;
        ENDIF;
        i = i + 1;
    ENDWHILE;
    Obj.TheObjectList = ReducedList.Duplicate();
    FIELD(Obj.TheObjectList).UpdField();
END;

ON CLICK Obj.Cancel_Btn =
BEGIN
    FIELD(Obj).CurBias = FB_INVISIBLE;
    Curframe.CurMode = FM_UPDATE;
    Curframe.Flush();
END;

ON CLICK Delete_Sub =
BEGIN
    Chosen = FIELD(Ckt.SubstationInfo).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a substation to delete.';
        RESUME;
    ENDIF;
    /* Make them reselect the Primary Grouping */
    IF Ckt.Substationinfo[Chosen].Object = Ckt.CircuitInfo.PrimaryGrouping THEN
       Ckt.CircuitInfo.PrimaryGrouping = 0;
       Ckt.CircuitInfo.PrimaryGroupingName = '';
    ENDIF;
    
    Ckt.SubstationInfo.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;

ON CLICK Delete_Feeder =
BEGIN
    Chosen = FIELD(Ckt.FeederInfo).CurRow;

    IF (Chosen <= 0) THEN
        Message 'You must select a feeder to delete.';
        RESUME;
    ENDIF;

    IF Ckt.Feederinfo[Chosen].Object = Ckt.CircuitInfo.PrimaryGrouping THEN
       Ckt.CircuitInfo.PrimaryGrouping = 0;
       Ckt.CircuitInfo.PrimaryGroupingName = '';
    ENDIF;

    Ckt.FeederInfo.RemoveRow(RowNumber = Chosen);
/*
**  Set btn clicked so that we can clear the validated field.
*/
    btn_clicked = TRUE;
END;
    
ON CLICK Replace_Btn =
DECLARE
  RouteChange = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    IF FIELD(Ckt).HasDataChanged = TRUE OR
       btn_Clicked = TRUE THEN
       Ckt.CircuitInfo.ValidatedBy = '';
    ENDIF;

    IF Ckt.CircuitInfo.ValidatedBy <> '' THEN
       Ckt.CircuitInfo.Validated = 'now';
    ELSE
       IF DOp.Type = Type$PersonDO THEN
          Ckt.CircuitInfo.Validated = 'now';
          Ckt.CircuitInfo.ValidatedBy = DOp.Initials;        
       ELSE
          Ckt.CircuitInfo.Validated = NULL;
       ENDIF;
    ENDIF;
    IF Ckt.CircuitInfo.PrimaryGrouping = 0 THEN
       message 'Please enter a Primary Grouping for the circuit.';
       RESUME;
    ENDIF;
/*
**  Replace all object and telephone circuit information
*/
    RetCode = CALLPROC Udb_ObjectUpdAll(
                Object = Ckt.CircuitInfo.Object,
                Type = Ckt.CircuitInfo.Type,
                PrimaryGrouping = Ckt.CircuitInfo.PrimaryGrouping,
                TypeName = Ckt.CircuitInfo.TypeName,
                PrimaryGroupingName = Ckt.CircuitInfo.PrimaryGroupingName,
                Name = Ckt.CircuitInfo.Name,
                Description = Ckt.CircuitInfo.Description,
                Comment = Ckt.CircuitInfo.Comment,
                Inservice = Ckt.CircuitInfo.Inservice,
                Outservice = Ckt.CircuitInfo.Outservice,
                PositionX = Ckt.CircuitInfo.PositionX,
                PositionY = Ckt.CircuitInfo.PositionY,
                OwnerNumber = Ckt.CircuitInfo.OwnerNumber,
                SerialNumber = Ckt.CircuitInfo.SerialNumber,
                SpecNumber = Ckt.CircuitInfo.SpecNumber,
                Combination = Ckt.CircuitInfo.Combination,
                LockNumber = Ckt.CircuitInfo.LockNumber,
                Validated = Ckt.CircuitInfo.Validated,
                ValidatedBy = Ckt.CircuitInfo.ValidatedBy,
                LastChanged = Ckt.CircuitInfo.LastChanged,
                LastChangedBy = Ckt.CircuitInfo.LastChangedBy);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while updating circuit object information.';
        RESUME;
    ENDIF;

    RetCode = CALLPROC Udb_TelephoneCircuitUpd(
                Object = Ckt.CircuitInfo.Object,
                FunctionArea = Ckt.FunctionArea,
                PriorityLine = Ckt.PriorityLine,
                CurrentlyOpen = Ckt.CurrentlyOpen);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while updating circuit information.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;

/*
** Update routes.
*/
   RouteChange = FALSE;
   FOR i = 1 TO OldRouteList.LastRow DO
      RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = OldRouteList[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteDel (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = OldRouteList[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;
         RouteChange = TRUE;                                                        
      ENDIF;   
   ENDFOR;

   FOR i = 1 TO RTP.RL.LastRow DO
      RetCode = OldRouteList.Find(AttributeName = 'type',
                                  Value = RTP.RL[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteIns (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = RTP.RL[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT; 
         RouteChange = TRUE;                                                       
      ENDIF;   
   ENDFOR;
 
   IF RouteChange = TRUE THEN
      /* raise event to soa_event_manager */
      CALLPROC DDB_RaiseDBEvent(DBEventName = 'TC_CardRouteUpd',
                             DBEventText = VARCHAR(Ckt.CircuitInfo.Object));
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  IF Verizon format update is needed do it.
*/
    IF Ckt.CircuitInfo.CreatedBy <> CurVerizonName THEN
       IF Ckt.CarrierInfo.Object <> Company$Verizon THEN
          RetCode = CALLPROC TC_VerizonCircuitDel(
               Circuit = CurrentCircuit.Circuit);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Failed to remove the Verizon format.';
          ENDIF;
       ELSE
          RetCode = CALLPROC TC_VerizonCircuitIns(
               Circuit = CurrentCircuit.Circuit,
               LineName = Ckt.CircuitInfo.CreatedBy);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Failed to save the new line number in Verizon format.';
          ENDIF;
       ENDIF;
    ENDIF;
/*
**  Replace all grouping information
*/
    /* delete and insert carrier information */
    RetCode = CALLPROC Udb_GroupingDel (
                Grouping = CurCarrier.Object,
                Member = CurrentCircuit.Circuit,
                Relationship = Interaction$ProvidedBy);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while deleting carrier information.';
        RESUME;
    ENDIF;

    RetCode = CALLPROC Udb_GroupingIns (
                SystemVersion = 1,
                Grouping = Ckt.CarrierInfo.Object,
                GroupingType = Ckt.CarrierInfo.Type,
                Relationship = Interaction$ProvidedBy,
                MemberType = Ckt.CircuitInfo.Type,
                Member = Ckt.CircuitInfo.Object);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while inserting carrier information.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;  


    /* delete and insert grouper information */
    RetCode = CALLPROC Udb_GroupingDel (
                Grouping = CurGrouper.Object,
                Member = CurrentCircuit.Circuit,
                Relationship = Interaction$MemberOf);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Error occurred while deleting grouper information.';
        RESUME;
    ENDIF;

    IF Grouper.Object > 0 THEN
        RetCode = CALLPROC Udb_GroupingIns (
                SystemVersion = 1,
                Grouping = Grouper.Object,
                GroupingType = Grouper.Type,
                Relationship = Interaction$MemberOf,
                MemberType = Ckt.CircuitInfo.Type,
                Member = Ckt.CircuitInfo.Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting grouper information.';
            RESUME;
        ENDIF;
    ENDIF;
    CALLPROC DDB_COMMIT;  

    /* delete the circuits associated with grouper and insert the new ones */
    i = 1;
    WHILE (i <= CurAssocList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurrentCircuit.Circuit,
                    Member = CurAssocList[i].Object,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting associated circuit information.';
            RESUME;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE i <= Associated_sf.Circuits.LastRow() DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = CurrentCircuit.Circuit,
                    GroupingType = Ckt.CircuitInfo.Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Associated_sf.Circuits[i].Type,
                    Member = Associated_sf.Circuits[i].Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting associated circuit information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;

    CALLPROC DDB_COMMIT;  

    /* delete the current substation groupings and insert the new ones */
    i = 1;
    WHILE (i <= CurStnList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurStnList[i].Object,
                    Member = CurrentCircuit.Circuit,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting substation information.';
            RESUME;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE i <= Ckt.SubstationInfo.LastRow() DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = Ckt.SubstationInfo[i].Object,
                    GroupingType = Ckt.SubstationInfo[i].Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Ckt.CircuitInfo.Type,
                    Member = Ckt.CircuitInfo.Object,
                    Reference = Ckt.SubstationInfo[i].Status);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting substation information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;

    CALLPROC DDB_COMMIT;  

    /* delete the current feeder groupings and insert the new ones */
    i = 1;
    WHILE (i <= CurFdrList.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingDel (
                    Grouping = CurFdrList[i].Object,
                    Member = CurrentCircuit.Circuit,
                    Relationship = Interaction$MemberOf);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while deleting feeder/network information.';
            RESUME;
            ENDLOOP;
        ENDIF;        
        i = i + 1;
    ENDWHILE;

    i = 1;
    WHILE (i <= Ckt.FeederInfo.LastRow()) DO
        RetCode = CALLPROC Udb_GroupingIns (
                    SystemVersion = 1,
                    Grouping = Ckt.FeederInfo[i].Object,
                    GroupingType = Ckt.FeederInfo[i].Type,
                    Relationship = Interaction$MemberOf,
                    MemberType = Ckt.CircuitInfo.Type,
                    Member = Ckt.CircuitInfo.Object);
        IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Error occurred while inserting feeder/network information.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;
    CALLPROC DDB_COMMIT;  
END;

ON CLICK Clear_Grouper_btn = 
BEGIN
    FIELD(Grouper).SetToDefault();
END;

ON CHILDENTRY tab.tbl.TheObjectList[*].Name,
ON CHILDENTRY tab.tbl.TheObjectList[*].Description =
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   Chosen = FIELD(tab.tbl.TheObjectList).CurRow;
   SelectedType = tab.tbl.TheObjectList[Chosen].Object;
   SelectedName = tab.tbl.TheObjectList[Chosen].Name;
END;

ON SetValue tab.tree.TVF = 
DECLARE
   CurTypeObj = ObjectSummaryClass; 
ENDDECLARE
BEGIN
   TCObject.SetValueHandler();

   IF TCObject.TV.CurNode IS NULL THEN
      MESSAGE 'Please select a valid type.';
      RESUME;
   ENDIF;
   
   CurTypeObj = ObjectSummaryClass(TCObject.TV.CurNode.ClientData);
   IF CurTypeObj.Name LIKE '*%' THEN
      MESSAGE CurTypeObj.Name + ' is not a valid circuit type. ' +
              'Please pick a type without an ''*'' at the begining.';
      SelectedType = 0;
      SelectedName = '';
      RESUME;
   ENDIF;
   SelectedType = CurTypeObj.Type;
   SelectedName = CurTypeObj.Name;
END;

ON EXPANDED tab.tree.TVF =
BEGIN
    TCObject.ExpandedHandler();
END;

ON COLLAPSED tab.tree.TVF =
DECLARE
    CurNode = TreeNode;
ENDDECLARE
BEGIN
    CurNode = TV.TriggerNode;
END;

ON CLICK tab.tree.SS.Find_Btn = 
BEGIN
   TCObject.FindHandler(FindName = tab.tree.SS.TypeName);
END;

/*
**  Handle an ok click for tab fields.
*/
ON Click tab.tree.OK_Btn,
ON Click tab.tbl.OK_Btn =
BEGIN
   IF SelectedType = 0 THEN
      MESSAGE 'Please select a valid circuit type.';
      RESUME;
   ENDIF;

   Ckt.CircuitInfo.Type = SelectedType;
   Ckt.CircuitInfo.TypeName = SelectedName;
   FIELD(Ckt.CircuitInfo.Name).IsCurField = FALSE;
   /*
   **  Get CSO Report type
   */
   SELECT :Ckt.CircuitInfo.Status = T.Name
   FROM    Udb_Type T,
           Udb_SuperType ST,
           Udb_Supertype ST2
   WHERE   T.Type = ST.SuperType AND
           ST.Type = :Ckt.CircuitInfo.Type AND
           ST.SuperType = ST2.Type AND
           ST2.SuperType = :Type$CircuitReportCategory;
   CALLPROC DDB_ROLLBACK;
   /*
   **  If Circuit Type is a Grouper Circuit, we should show
   **  the associated_sf.  Otherwise we should show the grouper
   **  stackfield.  Remember to clear whichever list doesn't 
   **  show up.  If we are changing, we can prepopulate fields
   **  with initial database values. 
   */
   i = 0;
   SELECT :i = ET.Type
   FROM    Udb_ExtendedType ET
   WHERE   SuperType = :Type$TelCardGrouper AND
           Type = :Ckt.CircuitInfo.Type;
   IF i <> 0 THEN /* Grouper circuit type */
           Associated_sf.Circuits = CurAssocList.Duplicate();
           FIELD(Associated_sf).AllBias = FB_LANDABLE;
           FIELD(Associated_sf).CurBias = FB_LANDABLE;

           FIELD(Grouper).SetToDefault();
           FIELD(Grouper).ParentField.AllBias = FB_INVISIBLE;
           FIELD(Grouper).ParentField.CurBias = FB_INVISIBLE;
        ELSE
           Grouper = CurGrouper.Duplicate();
           FIELD(Grouper).ParentField.AllBias = FB_LANDABLE;
           FIELD(Grouper).ParentField.CurBias = FB_LANDABLE;

           Associated_sf.Circuits.Clear();
           FIELD(Associated_sf).AllBias = FB_INVISIBLE;
           FIELD(Associated_sf).CurBias = FB_INVISIBLE;
   ENDIF;

   FIELD(tab).CurBias = FB_INVISIBLE;

   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();   
END;

ON Click tab.tree.Cancel_Btn,
ON Click tab.tbl.Cancel_Btn =
BEGIN
   FIELD(tab).CurBias = FB_INVISIBLE; 
END;

ON WINDOWCLOSE =
BEGIN
   CurFrame.ParentFrame.SendUserEvent (EventName = 'Exit_Frame');
END;

PROCEDURE Update_Routes(
) =
BEGIN
   FOR i = 1 TO OldRouteList.LastRow DO
      RetCode = RTP.RL.Find(AttributeName = 'type',
                                  Value = OldRouteList[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteDel (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = OldRouteList[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;                                                        
      ENDIF;   
   ENDFOR;

   FOR i = 1 TO RTP.RL.LastRow DO
      RetCode = OldRouteList.Find(AttributeName = 'type',
                                  Value = RTP.RL[i].Type);
      IF RetCode = ER_ROWNOTFOUND THEN
         RetCode = CALLPROC Udb_CircuitRouteIns (
                                Object = Ckt.CircuitInfo.Object
                               ,Route = RTP.RL[i].Type);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Telephone Circuit route update not successful';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;                                                        
      ENDIF;   
   ENDFOR;
   OldRouteList = RTP.RL.Duplicate();
END;
