/*
**
**      Copyright c 2013 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OrderReturnStatusClass
**
**  Date:       Version Description
** ----------------------------------
**  01/03/13  ysp   Created
*/
Method MovesToConfirm(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   ReturnCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN
   k = 0;
   FOR i = 1 TO CurObject.JobList.LastRow DO
      IF CurObject.JobList[i].ReturnConfirmed = 0 THEN
         k = k + 1;
      ENDIF;
   ENDFOR;

   IF k >= 2 THEN
      /* 
      ** there are still outstanding moves in the order to be confirmed.
      ** (the current move that is being processed still has ReturnConfirmed = 0)
      */
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   ENDIF;
END;

