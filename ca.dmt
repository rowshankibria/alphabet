============================

	Name:            CheckIs101OpenFromMacro

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckIs101OpenFromMacro         
**
**  Modifications:
**  08/22/02   em   Created to handle ATS moves impacting both 101 and 102 
**                  performed against the ATS Macro device (the ATS 
**                  Superstructure).
**  11/19/02   ysp  Merge: removed passed-in C and Jobs 
**  01/30/03   ysp  added switchingitem to warning
**  05/02/04   em   Modified to allow check to be run from Macro or from any Macro member device
**  05/06/04   em   Look at Pending Status before presenting warning
**  06/01/04   em   Reverse Pending Check
**  09/01/06    em       PendingStatusCount must be > 0
*/
PROCEDURE CheckIs101OpenFromMacro 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */
    i = INTEGER;              /* index */ 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    ATS = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
    AlreadyOpen = INTEGER NOT NULL WITH DEFAULT;  /* Select Value */
    Operator = INTEGER NOT NULL;
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device or part a ATS-Grouper.
**  Then find its related ATS101 device.
*/ 
   ATS.Object = 0;
   REPEATED
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN

      REPEATED
      SELECT :ATS.Object = O.Object,
             :ATS.TypeName = O.TypeName,
             :ATS.Name = O.Name 
      FROM   Udb_Object O,
             Udb_Grouping G
      WHERE  G.Member = :JIP.Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = O.Object AND
             O.Type IN (SELECT Type
                        FROM   Udb_ExtendedType
                        WHERE  SuperType = :Type$ATSGrouper);
      

      IF ATS.Object = 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckIs101OpenFromMacro:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );

         IF AutomaticExecution = TRUE THEN
            CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS Grouper device move checks are not setup properly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
            RETURN(PU_CANCEL);
         ELSE
            RETURN(NULL);
         ENDIF;
      ENDIF;
   ENDIF;

   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckIs101OpenFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS Grouper device is not setup properly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
         RETURN(PU_CANCEL);
      ELSE
         RETURN(NULL);
      ENDIF;
   ENDIF;
/*
** ATS 101 device is found, now see if Currently Open status is TRUE.
*/   
   AlreadyOpen = 0;
   SELECT  :AlreadyOpen = CurrentlyOpen
   FROM    Udb_Switch
   WHERE   Object = :ATS101.Object;

   IF AlreadyOpen = 1 THEN   
/*
** Look for pending status
*/
      IF JIP.Status = Job$Restore THEN
         Operator = IFNULL(JIP.RSOperator,0);
      ELSE
         Operator = IFNULL(JIP.TOOperator,0);
      ENDIF;
 
      SELECT :AlreadyOpen = Count(*)
      FROM   FMS_PendingStatus PS
      WHERE  PS.Object = :ATS101.Object AND
             PS.IssuedOperator = :Operator AND
             PS.StatusCount > 0 AND
             PS.PendingStatus = :Status$Open;

      IF AlreadyOpen = 0 THEN

         WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS 101 is already Open.'
                    ); 
         IF (WarningStatus = PU_CANCEL) THEN
            RETURN(PU_CANCEL);
         ELSE
            RETURN(Warning$Overridden);
         ENDIF;
      ENDIF;
   ENDIF;
   RETURN(NULL);
END; 

