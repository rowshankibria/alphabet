/*
**  Application:    CAC
**  Class:          CardSLC
**
**  Date:       Author   Description
** ----------------------------------
**  01/14/98    pkw      Created
**  12/28/09    ysp      Add BusOutages attribute to check if active bus outages within the substation.
**  07/25/17    ysp      add loading of incident reports flag           
*/
METHOD LoadCard(
   Card     = INTEGER NOT NULL;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Card = 0 THEN
      RETURN(CurObject);
   ENDIF;

   CurMethod.SendSuperClass();

   REPEATED
   SELECT :CurObject.Substation     = C.Substation,
          :CurObject.SubstationName = C.SubstationName,
          :CurObject.MultipleKVFlag = C.MultipleKVFlag,
          :CurObject.GroundsOn      = C.GroundsOn,
          :CurObject.AddressLine1   = C.AddressLine1,
          :CurObject.AddressLine2   = C.AddressLine2,
          :CurObject.AddressLine3   = C.AddressLine3,
          :CurObject.AddressLine4   = C.AddressLine4,
          :CurObject.OperatorName   = C.OperatorName,
          :CurObject.OperatorDesk   = C.OperatorDesk,
          :CurObject.Object[1].Object  = C.Substation,
          :CurObject.Object[1].Name    = C.SubstationName,
          :CurObject.Object[1].Type    = O.Type,
          :CurObject.Object[1].TypeName = O.TypeName
   FROM  SLC_Card C,
         Udb_Object O
   WHERE C.Card = :Card AND
         C.Substation = O.Object;

   CurObject.BusOutages = 0;
   SELECT :CurObject.BusOutages = COUNT(*)
   FROM   SOA_BusFaultOutage B,
          SOA_Job J
   WHERE  B.Substation = :CurObject.Substation AND
          B.SwitchingItem = J.Job AND
          J.SWItemStatus = :Card$Active;
   CALLPROC DDB_ROLLBACK;

   // load incident reports flag
   SELECT CurObject.IncidentReport = Count(*)
   FROM   SOA_ActiveObject C,
          SOA_IncidentReportLink L
   WHERE  C.Card = :Card AND
          C.Object = L.Object;
   
   RETURN(CurObject);
END;

METHOD IsLinkedToOutageRequest (
   SwitchingItem = INTEGER NOT NULL
) = 
DECLARE
   CardClass = INTEGER NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CardClass = 0;
   SELECT :CardClass = CardClass
   FROM   SLC_InformationItem
   WHERE  Job = :SwitchingItem;
   
   IF CardClass = Type$SLCSchd THEN
      /* 
      ** Is there a work permit on the switching item ?
      */
      x = 0;
      SELECT :x = COUNT(*)
      FROM   SOA_JobControl JC
      WHERE  JC.Card = :CurObject.Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.StepPair IN (:StepHeading$WorkPermit, :StepHeading$TestPermit);
      CALLPROC DDB_ROLLBACK;
      
      IF x = 0 THEN
         RETURN TRUE;
      ENDIF;

      x = 0;
      SELECT :x = 1 
      FROM   SOA_JobControl JC,
             SOA_OutageRequestPermit P
      WHERE JC.Card = :CurObject.Card AND
            JC.SwitchingItem = :SwitchingItem AND
            JC.Job = P.PermitJobID;
      CALLPROC DDB_ROLLBACK;

      IF x = 0 THEN
         MESSAGE 'No work permit on this switching item is linked to an Outage Request. ' + 
                 'A SCHD item cannot be activated until at least one work permit ' + 
                 'is linked to an Outage Request';
         RETURN FALSE;     
      ENDIF;
   ENDIF;
   
   RETURN TRUE;
END;

