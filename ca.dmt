Application Component Report
============================

	Name:            Replace

procedure Replace
(
   S1 = VARCHAR(1500) NOT NULL WITH DEFAULT,
   S2 = VARCHAR(256)  NOT NULL WITH DEFAULT,
   S3 = VARCHAR(256)  NOT NULL WITH DEFAULT
) =
DECLARE
   Idx = INTEGER NOT NULL WITH DEFAULT;
   NewString = VARCHAR(1500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Idx = LOCATE(S1, S2);
   IF Idx > SIZE(S1) THEN        // Not found
      RETURN S1;
   ELSE
      NewString = LEFT(S1, Idx -1);
      S1 = SHIFT(S1, -1*(Idx-1 + LENGTH(S2)));
      
      NewString = NewString + S3 + S1;
      
      RETURN Replace(S1=NewString, S2=S2, S3=S3);
   ENDIF;
   
END

