	Name:            GreenSheet


Component Method Scripts
--------------------------
 /*
**
**	Copyright c 2020 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties  without  written 
**	permission from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class           GreenSheetClass
**
**  01/09/20  ysp   Initial version. 
**  03/02/20  ysp   Support multiple feeders and attachments.
**  06/23/21  pkw   Update search string to look for SD feeders.
**  06/28/21  ysp   Set DBServer flag for attachments.
**  02/26/24  ysp   Assign a RequestID to a greensheet if it is set by CPM
*/
METHOD ImportRequest(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   AllFeeders = ARRAY OF FeederObject;
   ErrorCount = INTEGER NOT NULL WITH DEFAULT;
   Feeder = INTEGER NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   SearchString = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
   RequestID = INTEGER NOT NULL WITH DEFAULT;  
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   /*
   **  Import Process passes in character field to get around GMT time problem.
   */
   CurObject.Received = Date(CurObject.ReceivedChar);
   CurObject.StartDate = Date(CurObject.StartDateChar);
   
   /*
   ** validate and save each feeder
   */
   ErrorCount = 0;
   FOR i = 1 TO CurObject.FeederList.LastRow DO
      CurObject.FeederList[i].Object = 0;

      IF CurObject.FeederList[i].Name <> '' THEN
         SearchString = CurObject.FeederList[i].Name;
         
         IF UPPERCASE(left(SearchString, 2)) = 'SD' THEN
            IF LEFT(SHIFT(SearchString,-2), 1) <> '-' THEN 
               SearchString = 'SD-' + SHIFT(SearchString,-2);
               CurObject.FeederList[i].Name = SearchString;
            ENDIF;
         ENDIF;
      
         SELECT :CurObject.FeederList[i].Object = O.Object
         FROM   Udb_Object O
         WHERE  O.Name = :SearchString  AND
                O.Type = :Type$Feeder;
         
         IF CurObject.FeederList[i].Object > 0 THEN
            AllFeeders.InsertRow(RowObject = CurObject.FeederList[i].Duplicate());
         ELSE
            // Could be a 4KV feeder
            SearchString = CurObject.FeederList[i].Name + '_%';
            
            SELECT :Feeder = O.Object,
                   :FeederName = O.Name
            FROM   Udb_Object O,
                   Udb_Grouping G
            WHERE  O.Name LIKE :SearchString AND
                   O.Type = :Type$Feeder AND
                   O.Object = G.Member AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.GroupingType = :Type$UnitSubstation
            BEGIN
                  CurObject.FeederList[i].Object = Feeder;
                  CurObject.FeederList[i].Name = FeederName;
                  AllFeeders.InsertRow(RowObject = CurObject.FeederList[i].Duplicate());
            END;                  
         ENDIF;
         CALLPROC DDB_ROLLBACK;
         
         IF CurObject.FeederList[i].Object = 0 THEN
            ErrorCount = ErrorCount + 1;
            CurMethod.Trace(Text = 'Failed to validate feeder ' + CurObject.FeederList[i].Name +
                                ' in Green Sheet #' + VARCHAR(CurObject.RequestID));
         ENDIF;
      ENDIF;
   ENDFOR;

   IF ErrorCount = CurObject.FeederList.LastRow THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to validate feeders in green sheet #' + VARCHAR(CurObject.RequestID);
      RETURN;
   ENDIF;
   
   /*
   ** if this is a revision, delete the old one.
   */
   i = 0;
   SELECT :i = 1
   FROM	 FMS_GreenSheet
   WHERE  RequestID = :CurObject.RequestID;

   IF i = 1 THEN   //CurObject.Revision = 1
      RetCode = CALLPROC FMS_GreenSheetDel(RequestID = CurObject.RequestID);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to revise green sheet #' + VARCHAR(CurObject.RequestID);
         CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - GreenSheetClass.ImportRequest; Failed to revise green sheet #' + VARCHAR(CurObject.RequestID));
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
   ENDIF;

   /*
   ** If the RequestID is less than 1,000,000, it is a temporary ID. We are going to reassign it to a number
   ** between 1,000,000 and 5,000,0000.
   */
   IF CurObject.RequestID < 1000000 THEN  
	  SELECT :RequestID = IFNULL(MAX(RequestID), 1000000)
	  FROM	 FMS_GreenSheet
	  WHERE  RequestID > 1000000 AND
	         RequestID < 5000000;
	  CALLPROC DDB_ROLLBACK;
	  
	  CurObject.RequestID = RequestID + 1
   ENDIF;
   
   RetCode = CALLPROC FMS_GreenSheetIns(
          RequestID = CurObject.RequestID
         ,Received = CurObject.Received
         ,RequestBy = CurObject.RequestBy
         ,Customer = CurObject.Customer         
         ,Revision = CurObject.Revision         
         ,StartDate = CurObject.StartDate
      );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to save green sheet in the FMS database';
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - GreenSheetClass.ImportRequest; Failed to save green sheet #' + VARCHAR(CurObject.RequestID));
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Successfully imported green sheet #' + VARCHAR(CurObject.RequestID));
   ENDIF;   

   FOR i = 1 TO AllFeeders.LastRow DO   
      CurMethod.Trace(Text= 'saving feeder=' + AllFeeders[i].Name + ' equip=' + AllFeeders[i].LocationComment + ' for green sheet #' + VARCHAR(CurObject.RequestID));

      RetCode = CALLPROC FMS_GreenSheetFdrIns(
                   RequestID = CurObject.RequestID
                  ,FeederName = AllFeeders[i].Name         
                  ,Feeder = AllFeeders[i].Object         
                  ,EquipNames = AllFeeders[i].LocationComment
                  );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to save feeders for green sheet #' + VARCHAR(CurObject.RequestID);
         CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - GreenSheetClass.ImportRequest; Failed to save feeder ' + 
                     AllFeeders[i].Name +
                     ' for green sheet #' + VARCHAR(CurObject.RequestID));
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;

   /*
   ** Save the sheet and other attachments
   */
   FOR i = 1 TO CurObject.FileList.LastRow DO
      CurObject.FileList[i].FileID = i;
      CurObject.FileList[i].RequestID = CurObject.RequestID;
      CurObject.FileList[i].InsertFile();
      
      IF CurObject.FileList[i].ReturnCode = 0 AND
         CurObject.FileList[i].DBServer >= 0 THEN
         
         RetCode = CALLPROC FMS_GreenSheetFileUpd(     
             RequestID = CurObject.FileList[i].RequestID,
             FileID = CurObject.FileList[i].FileID,
             DBServer = CurObject.FileList[i].DBServer);
            
         IF RetCode = 0 THEN
             CALLPROC DDB_COMMIT;
         ELSE
             CALLPROC DDB_ROLLBACK;
             CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Failed to set FMS_GreenSheetFile.DBServer to ' + 
                       VARCHAR(CurObject.FileList[i].DBServer) + ' for request ' + 
                       VARCHAR(CurObject.FileList[i].RequestID) + ', file ' + 
                       VARCHAR(CurObject.FileList[i].FileID));
         ENDIF;
      ELSE
         CurObject.ReturnCode = CurObject.FileList[i].ReturnCode;
         CurObject.ErrorMessage = CurObject.FileList[i].ErrorMessage;
         RETURN;
      ENDIF;
   ENDFOR;
END;

