	Name:            z2

initialize()=
declare
   return_status = INTEGER NOT NULL WITH DEFAULT;
enddeclare
{
 /*
 *  Connect to the databases.
 */
    return_status = CALLPROC DDB_Connect(TopFrame = CurFrame);
    IF return_status != 0 THEN      /* No usable databases. */
        RETURN;                     /* Quit */
    ENDIF;
    
   CurFrame.InputFocusField = field(change_btn);
   tf[1].Move = 'This is a move';
   FIELD(tf[1].ok).BgPattern = FP_Clear;
   tf[2].Move = 'This is a warning';
   FIELD(tf[2].ok).BGPattern = FP_BitMap;
   FIELD(tf[2].ok).BgBitmap = Field(ent_off).BgBitmap;
   tf[3].Move = 'This is a RED warning';
   FIELD(tf[1].ok).BgPattern = FP_Clear;
}

ON ChildEntry tf.ok =
begin
   CurFrame.InputFocusField = field(change_btn);
   IF Field(tf[].ok).BgPattern = FP_Clear THEN
      RESUME;
   ELSEIF Field(tf[].ok).BgBitmap = Field(ent_off).BgBitmap THEN
      Field(tf[].ok).BgBitmap = Field(tempent_on).BgBitmap;
   ELSEIF Field(tf[].ok).BgBitmap = Field(tempent_on).BgBitmap THEN
      Field(tf[].ok).BgBitmap = Field(ent_off).BgBitmap;
   ENDIF;
   
end;

ON entry ENT_ON =
begin
   CurFrame.InputFocusField = field(change_btn);
   IF Field(ent_on).BgPattern = FP_Clear THEN
      Field(ent_on).BgPattern = FP_BitMap;
      Field(ent_on).BgBitmap = Field(ent_off).BgBitmap;
   ELSEIF Field(ent_on).BgBitmap = Field(ent_off).BgBitmap THEN
      Field(ent_on).BgBitmap = Field(tempent_on).BgBitmap;
   ELSEIF Field(ent_on).BgBitmap = Field(tempent_on).BgBitmap THEN
      Field(ent_on).BgPattern = FP_Clear;
   ENDIF;
   
end;

ON CLICK CHANGE_BTN =
BEGIN
   IF Field(ent_off).BgPattern = FP_Clear THEN
      Field(ent_off).BgPattern = FP_Clear;
      Field(ent_off).BgBitmap = NULL;
   ELSE
      Field(ent_off).BgBitmap = Field(ent_on).BgBitmap;
   ENDIF;
END;

ON CLICK POWERSHELL_BTN =
BEGIN
    CALL SYSTEM 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "d:\install\coned\or41\misc\incidentreport.ps1" "smm - copy.htm"';
   // CALL SYSTEM 'C:\Windows\SysWOW64\WindowsPowerShell\v1.0\powershell.exe "d:\install\coned\or41\misc\incidentreport.ps1 ''smm - copy.htm''"';
   Message 'file opened';   
END;

on click btnLoadRequestReport = 
declare
   wprrpt = PermitRequest_ASE;
enddeclare
begin
   WPRRpt.StartDate = DATE('11-OCT-2022');
   WPRRpt.EndDate = DATE('12-APR-2023');
   WPRRpt.Application = 'ISWP';
   WPRRpt.DivisionName = 'all';
   
   WPRRpt.Load_PermitRequestData();
end;

on click BtnParse = 
declare
   IdxList = ARRAY OF INTEGEROBJECT;
   k = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   EquipList = varchar(80) NOT NULL WITH DEFAULT;
   EquipString = varchar(20) NOT NULL WITH DEFAULT;
enddeclare
begin
    EquipList = 'BKR 2E - FDR 15032; BKR 3,TXF 2E';
    
    while EquipList <> '' do
        IdxList[1].Value = locate(EquipList, ' - ');
		IdxList[2].Value = locate(EquipList, ';');
		IdxList[3].Value = locate(EquipList, ',');
		
		i = IdxList[1].Value;
		IdxList.Sort(Value = AS_ASC);
        k = IdxList[1].Value;
 
		IF k = (size(EquipList) + 1) THEN        
		   EquipString = EquipList;
		   EquipList = '';		
        ELSE                                      
		   EquipString = left(EquipList, k-1);
		   
  		   IF i = k then
  		      EquipList = SHIFT(EquipList, -1 * (k+2));
           ELSE 
		      EquipList = SHIFT(EquipList, -1 * k);
		   ENDIF;
		ENDIF;
		
		message EquipString;
    endwhile;
end;
            
ON CLICK EXIT_BTN =
BEGIN
   RETURN;
END;

