Application Component Report
============================

	Name:            OR_Summary_SLC

/*
**
**      Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permissio
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          OR_Summary
**
**  Date:       Version Description
** ----------------------------------------------------------clic---------------------------
** 10/02/14  ysp  Add SWP summary
** 12/04/14  YSP  Right mouse click to bring up SWP detail screen 
** 10/19/17  em   Transition to new Outage Request interface
** 10/25/17  em   If scheduled Sw Item parameter is TRUE then look for Transformer to be selected
**                from equipment list to initiate a Tap Changer inspection scenario.
** 10/27/17  em   Disable delay reason function, DO will enter delays when they occur, not come to
**                this screen.
** 11/08/17  em   Default to Open SLC item list
** 11/09/17  em   Remove 10/25/17 enhancement 
** 03/27/18  em   Use Jurisdiction attribute to distinguish FMS from TOMS
** 02/19/19  ysp  Don't show requests whose scheduled return date is more than two weeks old
** 08/22/19  ysp  Add OR number to the message that shows an existing permit already linked to an OR
*/ 
INITIALIZE
(
   FMSCard = FMS_Card DEFAULT NULL;          /* Optional. passed in*/
   TFMSCard = CardTFMS DEFAULT NULL;         /* Optional. passed in*/
   SLCCard = CardSLC DEFAULT NULL;           /* Optional. passed in*/
   SWItem = INTEGER NOT NULL WITH DEFAULT;   /* Optional. passed in*/
) =
DECLARE
#   include StandardDeclarations
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;

   DivisionList = ChoiceList;  /* All divisions    */
   CurrentRow = INTEGER NOT NULL WITH DEFAULT;     /* Currently selected SWP row number */
   FilterByDivision = INTEGER NOT NULL WITH DEFAULT;
   SWP_LastColumn = varchar(32) not null;
   SWP_SortOrder = integer not null;

   // Outage request related variables
   ORList = ARRAY OF SWPOutageClass;
   ORIdx = INTEGER NOT NULL WITH DEFAULT;          /* Currently selected Outage Request row number */
   WIIdx = INTEGER NOT NULL WITH DEFAULT;          /* Currently selected Work Item row number */
   ORViewPort = ViewportField;
   
   SelectedTypeofCard = INTEGER NOT NULL WITH DEFAULT;
   SelectedCard = INTEGER NOT NULL WITH DEFAULT;
   SelectedCardStatus = INTEGER NOT NULL WITH DEFAULT;
   SelectedSwitchingItem = INTEGER NOT NULL WITH DEFAULT;
   SelectedApplication = CHAR(4) NOT NULL WITH DEFAULT;
   SelectedEquip = INTEGER NOT NULL WITH DEFAULT;
   SelectedJobClass = INTEGER NOT NULL WITH DEFAULT;
   SelectedEquipClass = INTEGER NOT NULL WITH DEFAULT;
   SelectedStepPair = INTEGER NOT NULL WITH DEFAULT;
   SelectWPRow = INTEGER NOT NULL WITH DEFAULT;

   SWItemName = VARCHAR(160) NOT NULL WITH DEFAULT;
   TOIssued = Date DEFAULT NULL;
   TemplateStack = StackField;      /* used for framesize manipulation, and scrollbar */   
   TemplateParent = StackField;      /* used for framesize manipulation, and scrollbar */

   // internal procedures
   ShowSWPReports = PROCEDURE;
   HighlightSWP = PROCEDURE;
   LoadCard = PROCEDURE;
   EnableSWPLoadCard = PROCEDURE;
   ShowSWPDetails = PROCEDURE;
   ShowWorkItem = PROCEDURE;
   HighlightWorkItem = PROCEDURE;
   EnableAddPermit = PROCEDURE;
   MapStationByHTOD = PROCEDURE;
   ShowSubstations = PROCEDURE;
   SubstationSearch = PROCEDURE;
   ShowSwitchingItems = PROCEDURE;
   HighlightCard = PROCEDURE;
   ShowJobsByCard = PROCEDURE;
   ReloadCard= PROCEDURE;
   UpdateSWPStatus = PROCEDURE;
   CreateSLCItem = PROCEDURE RETURNING INTEGER;
BEGIN
   /*
   ** position popup stack fields 
   */
   FIELD(Card_SF).AbsYTop = FIELD(SWP_TF).AbsYBottom;
   FIELD(Card_SF).AbsXLeft = (FIELD(SWP_TF).Width - FIELD(Card_SF).Width)/2 ;      

   FIELD(Delay_SF).AbsYTop = FIELD(SWP_TF).AbsYBottom;
   FIELD(Delay_SF).AbsXLeft = (FIELD(SWP_TF).Width - FIELD(Delay_SF).Width)/2 ;      

   FIELD(SUBSF).YBottom = FIELD(WorkItem.Substation).AbsYBottom;
   FIELD(SUBSF).XLeft = FIELD(WorkItem.Substation).AbsXLeft;

   /* Save pointer to outage request template's parentfield */
   TemplateStack = FIELD(Template);
   TemplateParent = TemplateStack.ParentField;
   ORViewPort = TemplateParent.ParentField.ParentField;

   /*
   ** initialize division menu item
   */
   DivisionList.ChoiceItems.Clear();
   DivisionList.ChoiceItems[1].EnumValue = 1;
   DivisionList.ChoiceItems[1].EnumText = 'Local';
   DivisionList.ChoiceItems[2].EnumValue = 2;
   DivisionList.ChoiceItems[2].EnumText = 'All';

   i = 3;
   SELECT  :DivisionList.ChoiceItems[i].EnumText = Name,
           :DivisionList.ChoiceItems[i].EnumValue = Object 
   FROM    Udb_Object  
   WHERE   Type = :Type$Division and
           PrimaryGrouping <> 0  
   ORDER BY 1
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   field(menu.division_list.division).ValueList = CHOICELIST(DivisionList);
   field(menu.division_list.division).UpdChoiceList();
   field(menu.division_list.division).CurEnumValue = 1;
   field(menu.division_list.division).CurEnumText = 'Local';
   field(menu.division_list.division).UpdChoiceList();  

   /*
   ** load swp list
   */
   MappingOption = 1;      // default: Mapped
   FilterByDivision = 0;
   CALLPROC ShowSWPReports();
   
   IF /* FMSCard IS NULL AND TFMSCard IS NULL AND */ SLCCard IS NULL THEN
      MESSAGE 'A Substation Log Card must be selected first';
      RETURN 0;
      /*
      FIELD(Link_Btn).CurBias = FB_INVISIBLE;
      FIELD(Card_Title).TextValue = 'Select Card or Switching Item to Place New Permit';
      IF CurrentApplication = Application$FMS OR
         CurrentApplication = Application$TFMS THEN
         FIELD(Create_Btn).CurBias = FB_LANDABLE;
      ENDIF;
      */
   ELSE
      FIELD(Card_Title).TextValue = 'Select Switching Item to Link Permits'; 
      //IF FMSCard IS NOT NULL OR TFMSCard IS NOT NULL THEN
      //   FIELD(CardOption).CurBias = FB_INVISIBLE;
      //ENDIF;
      IF SLCCard IS NOT NULL AND SWItem = 0 THEN
         FIELD(Create_Btn).CurBias = FB_LANDABLE;
      ENDIF;

      IF SWItem > 0 THEN
         SELECT :SWItemName = Title
         FROM  SLC_InformationItem
         WHERE  Job = :SWItem;
      ENDIF;
      CALLPROC DDB_ROLLBACK;      
   ENDIF;
END;

ON SETVALUE menu.division_list.division =
BEGIN
   FilterByDivision = 1;
   CALLPROC ShowSWPReports();
   IF swp_tf.LastRow() = 0 THEN
      MESSAGE 'No Scheduling Work Packages.';
   ENDIF;
END;

ON CLICK SWP_TF.ORNumber_hdr,
ON CLICK SWP_TF.OSSStatus_hdr,
ON CLICK SWP_TF.CurrentStatus_hdr,
ON CLICK SWP_TF.Title_hdr,
ON CLICK SWP_TF.SkedOutageDate_hdr,
ON CLICK SWP_TF.SkedStartDate_hdr =
DECLARE
   table_field = TableField default null;
   tf_array = ArrayObject default null;
   col_name = varchar(32) not null;
   PrevSWPNumber = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CurrentRow > 0 THEN
      PrevSWPNumber = SWP_TF[CurrentRow].ORNumber;
   ENDIF;
   
   /* Find out what table and column we are in,
   ** if any. 
   */   
   table_field = CurFrame.TriggerField.WhichTableField();
   IF table_field is null THEN
      MESSAGE 'You must be in a table field to sort it. ';
      RESUME;
   ENDIF;
   /*
   **  Strip off the '_hdr' to match column name
   */
   col_name = Left(CurFrame.TriggerField.Name,LENGTH(CurFrame.TriggerField.Name) -4);
   /* 
   ** Point tf_array to the array underlying
   ** the tablefield 
   */
   table_field.GetFieldValue(value = byref(tf_array));
   /*
   ** Use CurEnumValue to specify sort order.
   ** Note that the first item in the menu list
   ** is labeled sort in ascending order, and the
   ** second item to sort in descending order.
   */
   IF SWP_SortOrder = AS_ASC AND SWP_LastColumn = col_name  THEN 
      SWP_SortOrder = AS_DESC;
   ELSE
      SWP_SortOrder = AS_ASC;
   ENDIF;
   SWP_LastColumn = col_name;

   /* Note the colon in front of col_name is required
   ** to indicate that col_name is a variable, not the
   ** literal column name.*/
   tf_array.sort(:col_name = SWP_SortOrder);
   
   IF CurrentRow > 0 THEN
      RetCode = SWP_TF.Find(AttributeName = 'ornumber',
                            Value = PrevSWPNumber,
                            RowNumber = ByRef(i));
      IF RetCode = ER_OK THEN
         CurrentRow = i;
         Field(SWP_TF).ActiveRow = i;
         CALLPROC HighlightSWP(SelectRow = CurrentRow);
      ENDIF;
   ENDIF;
END;

ON CHILDENTRY SWP_TF =
DECLARE
   
ENDDECLARE
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
