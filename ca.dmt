	Name:            GetUserMachine

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties  without  written 
**	permission from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Procedure       GetUserMachine
**
**  01/01/03  ysp   Initial version. Copied from FeederCard
**                  
*/
Procedure GetUserMachine
(
    i = INTEGER NOT NULL WITH DEFAULT;
    WorkDir = VARCHAR(40) NOT NULL WITH DEFAULT;
    DisplaytmpEnv = VARCHAR(20) NOT NULL WITH DEFAULT;
    Display_obj = StringObject;
) =
BEGIN
   UserMachine = '';
/* 
** ITC 40
** Get the path name of the working directory. 
*/
   WorkDir= CurSession.GetEnv(Name = 'HOME');

   IF CurSession.OperatingSystem = SY_NT THEN
      UserMachine = CurSession.GetEnv(Name = 'COMPUTERNAME');

   ELSEIF CurSession.OperatingSystem = SY_UNIX THEN 
      DisplaytmpEnv = CurSession.GetEnv(Name = 'DISPLAY');
      UserMachine = left(DisplaytmpEnv,(locate(DisplaytmpEnv,':')-1));
/*
**  04/18/00  pkw - If application was started without the DISPLAY environment
**            variable being set, it means it is running on the local machine.
**            The reason we don't set this in the st_application script is 
**            the two-headed machines need to allow for dynamic setting of the
**            DISPLAY evironment. When it does this the DISPLAY is set to 
**            :0.0 or :0.1.
**            To get the current node name we will use 'hostname'.
*/
      IF UserMachine = '' THEN
         CALL SYSTEM 'hostname > ' + WorkDir + '/hostname.txt';
         Display_obj.FileHandle = WorkDir + '/hostname.txt';
         IF Display_obj.ErrorStatus = 0 THEN /* file existed */
             i = Display_obj.Length;
             IF i > 0 THEN
                UserMachine = varchar(Display_obj.SubString(1,i - 1));
                CALL SYSTEM 'rm ' + WorkDir + '/hostname.txt';
             ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;
   RETURN (UserMachine);
END;

