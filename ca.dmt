*/
ON Click OK_Btn =

    BEGIN
	    RETURN;
    END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

PROCEDURE LoadWPEquip(
   Type = INTEGER NOT NULL WITH DEFAULT;
)
= 
DECLARE
   i = integer not null;      /* Temporary counter */ 
   DynamicWhereClause = VARCHAR(400) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Equip_sf.TblFormat.Clear();

   IF Type = 0 THEN         /* only equip that has been dropped */
      DynamicWhereClause = 'E.WorkPermit = ' + VARCHAR(WorkPermit) + ' AND ' +
              'E.Type = 0 AND ' + 
              '(E.ReturnFGO > 0 OR E.ReturnPermit > 0) AND ' + 
              'E.Equip = O.Object';

   ELSEIF Type = 1 THEN     /* only equip that has been picked up */
      DynamicWhereClause = 'E.WorkPermit = ' + VARCHAR(WorkPermit) + ' AND ' +
              'E.Type = 1 AND ' + 
              '(E.ReturnFGO > 0 OR E.ReturnPermit > 0) AND ' + 
              'E.Equip = O.Object';

   ELSEIF Type = 2 THEN     /* equip that has not been returned */
      DynamicWhereClause = 'E.WorkPermit = ' + VARCHAR(WorkPermit) + ' AND ' +
              'E.ReturnFGO = 0 AND ' + 
              'E.ReturnPermit = 0 AND ' + 
              'E.Equip = O.Object';

   ELSEIF Type = 3 THEN     /* equip that has been returned */
      DynamicWhereClause = 'E.WorkPermit = ' + VARCHAR(WorkPermit) + ' AND ' +
              '(E.ReturnFGO > 0 OR E.ReturnPermit > 0) AND ' + 
              'E.Equip = O.Object';

   ELSEIF Type = 4 THEN     /* all equip */
      DynamicWhereClause = 'E.WorkPermit = ' + VARCHAR(WorkPermit) + ' AND ' +
              'E.Equip = O.Object';
   ENDIF;

   i = 1;
   SELECT  :Equip_sf.TblFormat[i].Equip = O.Object,  
           :Equip_sf.TblFormat[i].EquipName = O.Name, 
           :Equip_sf.TblFormat[i].EquipClassName  = O.TypeName, 
           :Equip_sf.TblFormat[i].Description = O.Description,
           :Equip_sf.TblFormat[i].G = E.Type,
           :Equip_sf.TblFormat[i].Substation = E.ReturnFGO + E.ReturnPermit,  
           :Equip_sf.TblFormat[i].Source = E.Source
   FROM    Udb_Object O,
           IR_DownloadEquip E
   WHERE   :DynamicWhereClause 
   ORDER BY 5, 6 DESC
   BEGIN
      IF Equip_sf.TblFormat[i].Substation = 0 THEN
         Equip_sf.TblFormat[i].Comment = 'No';
         FIELD(Equip_sf.TblFormat[i].Comment).BgColor = CC_RED;
         FIELD(Equip_sf.RedEquipMisMatch).CurBias = FB_VISIBLE;   
      ELSE
         Equip_sf.TblFormat[i].Comment = 'Yes';
      ENDIF;
      i = i + 1;
   END;
 
   IF Equip_sf.TblFormat.LastRow() = 0 THEN
      FIELD(Equip_sf.TblFormat).CurBias = FB_INVISIBLE;
   ENDIF;

   RETURN;
END;

Name:      item1

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
