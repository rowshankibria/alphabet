	Name:            HolidayClass


Application Component Report
============================

	Name:            IncidentReport

/*
**	Copyright c 2017 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          IncidentReport
**
**  07/03/17  ysp  Created
**  10/05/17  em   Close screen on View because need doc to appear on to
*/
INITIALIZE (
   Card = INTEGER NOT NULL;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CurReportIdx = INTEGER NOT NULL WITH DEFAULT;           /* row being updated */
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   
   DisplayIncidentReport = PROCEDURE;
BEGIN
   // load reports specific to the card objects and boroughs
   SpecReports.Clear();
   GenReports.Clear();
   
   IF ArchiveCard = FALSE THEN
      IF CurrentApplication = Application$FMS OR
         CurrentApplication = Application$TFMS THEN         
         i = 1;
         SELECT  DISTINCT
                 :SpecReports[i].Title = R.Title,
                 :SpecReports[i].ReportID = R.ReportID,
                 :SpecReports[i].FileName = R.FileName
         FROM    TFMS_CardToObject CTO,
                 SOA_IncidentReport R,
                 SOA_IncidentReportLink L
         WHERE   CTO.Card = :Card AND
                 CTO.Status = 1 AND
                 CTO.Object = L.Object AND
                 L.ReportID = R.ReportID
         BEGIN                  
            i = i + 1;
         END;
         
      ELSEIF CurrentApplication = Application$SLC THEN
         i = 1;
         SELECT  DISTINCT
                 :SpecReports[i].Title = R.Title,
                 :SpecReports[i].ReportID = R.ReportID,
                 :SpecReports[i].FileName = R.FileName
         FROM    SOA_ActiveObject C,
                 SOA_IncidentReport R,
                 SOA_IncidentReportLink L
         WHERE   C.Card = :Card AND
                 C.Object = L.Object AND
                 L.ReportID = R.ReportID
         BEGIN                  
            i = i + 1;
         END;      
      ELSEIF CurrentApplication = Application$TLS THEN
         i = 1;
         SELECT  DISTINCT
                 :SpecReports[i].Title = R.Title,
                 :SpecReports[i].ReportID = R.ReportID,
                 :SpecReports[i].FileName = R.FileName
         FROM    TC_Card C,
                 SOA_IncidentReport R,
                 SOA_IncidentReportLink L
         WHERE   C.Card = :Card AND
                 C.Circuit = L.Object AND
                 L.ReportID = R.ReportID
         BEGIN                  
            i = i + 1;
         END;      
      ENDIF;
   ELSE
      IF CurrentApplication = Application$FMS OR
         CurrentApplication = Application$TFMS THEN         
         i = 1;
         SELECT  DISTINCT
                 :SpecReports[i].Title = R.Title,
                 :SpecReports[i].ReportID = R.ReportID,
                 :SpecReports[i].FileName = R.FileName
         FROM    TFMS_ArchiveCardToObject CTO,
                 SOA_IncidentReport R,
                 SOA_IncidentReportLink L
         WHERE   CTO.Card = :Card AND
                 CTO.Status = 1 AND
                 CTO.Object = L.Object AND
                 L.ReportID = R.ReportID
         BEGIN                  
            i = i + 1;
         END;
      ELSEIF CurrentApplication = Application$TLS THEN
         i = 1;
         SELECT  DISTINCT
                 :SpecReports[i].Title = R.Title,
                 :SpecReports[i].ReportID = R.ReportID,
                 :SpecReports[i].FileName = R.FileName
         FROM    TC_ArchiveCard C,
                 SOA_IncidentReport R,
                 SOA_IncidentReportLink L
         WHERE   C.Card = :Card AND
                 C.Circuit = L.Object AND
                 L.ReportID = R.ReportID
         BEGIN                  
            i = i + 1;
         END;      
      ENDIF;   
   ENDIF;
   
   i = 1;
   REPEATED
   SELECT  DISTINCT
           :GenReports[i].Title = R.Title,
           :GenReports[i].ReportID = R.ReportID,
           :GenReports[i].FileName = R.FileName
   FROM    SOA_IncidentReport R,
           SOA_IncidentReportLink L
   WHERE   L.Object = :UserDesk AND
           L.ReportID = R.ReportID
   BEGIN                  
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF SpecReports.LastRow = 0 AND GenReports.LastRow = 0 THEN
      MESSAGE 'No Incident Reports for this card';
      RETURN;
   ELSEIF SpecReports.LastRow = 1 AND GenReports.LastRow = 0 THEN
      CALLPROC DisplayIncidentReport(FileName = SpecReports[1].FileName);
      RETURN;
   ELSEIF GenReports.LastRow = 1 AND SpecReports.LastRow = 0 THEN
      CALLPROC DisplayIncidentReport(FileName = GenReports[1].FileName);
      RETURN;
   ENDIF;
END;

ON CHILDENTRY SpecReports = 
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      resume;
   ENDIF;
   CurReportIdx = FIELD(SpecReports).CurRow;

   Selected = SpecReports[CurReportIdx].Duplicate();
/*   
   FOR i = 1 TO SpecReports.LastRow DO
      IF i = CurReportIdx THEN
         FIELD(SpecReports[i].Title).IsReverse = TRUE;
         FIELD(SpecReports[i].FileName).IsReverse = TRUE;
      ELSE
         FIELD(SpecReports[i].Title).IsReverse = FALSE;
         FIELD(SpecReports[i].FileName).IsReverse = FALSE;
      ENDIF;
   ENDFOR;
*/
END;

ON CHILDENTRY GenReports = 
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      resume;
   ENDIF;
   CurReportIdx = FIELD(GenReports).CurRow;

   Selected = GenReports[CurReportIdx].Duplicate();
END;

ON Click View_Btn = 
BEGIN
   CALLPROC DisplayIncidentReport(FileName = Selected.FileName);
   RETURN;
END;
   
ON CLICK OK_BTN =
BEGIN
   IF CURFRAME.ReasonCode = RC_MOUSECLICK THEN
      RETURN;
   ENDIF;
END;

PROCEDURE DisplayIncidentReport(
   FileName  = VARCHAR(160) NOT NULL WITH DEFAULT
) = 
DECLARE
    Command = Varchar(260) NOT NULL WITH DEFAULT;
    WorkDir = Varchar(100) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
   
   Command = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + WorkDir + '\incident_report.ps1" "' + FileName + '"';                         
           
	CurProcedure.Trace (Command);
	CALL System Command;
END;

