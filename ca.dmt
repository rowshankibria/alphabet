============================

	Name:            PreloadMoves

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PreloadMoves  
**
**  Modifications:
**	 07/07/02  em	Created 
**  01/15/03  em  Set TransferFlag = TRUE when inserting moves to avoid
**                log entries for preloaded moves.
**  02/11/03  em  Set ControlCard = Current Card, will be changed when 
**                card is activated.
**  05/06/03  em  Add support for CIOA card type
**  02/16/04  em  Temporarily adding Flush() after selecting feeder 
**                equip moves.
**  09/08/06  ysp converted from a procedure and add process indicator
**  04/16/10  em  Modified to insert equipment moves using TFMS_CardToObject
**                in order to support 3G Network Feeders.
**  06/07/10  em  Add StepHeadingsOnly parameter
**  04/05/11  em  Append Equip Name to move text
**  04/06/11  em  Only append equip name for equipment in substation
**  09/28/15  em  For ATS Grouper equipment, set move equip class to the
**                membertype to the feeder
**  10/02/15  pkw Second thought, don't set move equip class to membertype
**                of feeder.  
**  03/01/16  pkw Update Preload to load moves on Portion Feeders 33kv
*/
INITIALIZE
(
    Card	= INTEGER NOT NULL;		/* Passed Card */
    CardClass   = INTEGER NOT NULL;		/* Passed CardClass */
    Feeder      = INTEGER NOT NULL;		/* Passed Feeder */
    TypeOfCard  = INTEGER NOT NULL;		/* Passed Type Of Card */
    StepHeadingsOnly = INTEGER NOT NULL WITH DEFAULT; /* Optional Parm */

    ControlEntry = NewMoveCard;
    i = INTEGER NOT NULL;
    Jobs = ARRAY OF Job;
    LastEQ = INTEGER NOT NULL WITH DEFAULT;
    LastID = CHAR(2) NOT NULL WITH DEFAULT;
    LastJC = INTEGER NOT NULL WITH DEFAULT;
    ProcessCount = INTEGER NOT NULL;
    ProcessWindow = FrameExec;            
    RetCode = INTEGER;
) =
BEGIN
/*
**  Open process window indicator.
*/
    ProcessCount = 1;
    ProcessWindow = OPENFRAME ProcessIndicator 
                                 (ParentFrame = CurFrame,
                                  Pct_Title = 'Preload Moves',
                                  MaxValue = 8);
    CurFrame.WaitFor (EventName = 'Received');
/*
** For New FMS Card, Insert: 
**     1) Step Headings, 
**     2) NULL Equip Preloads, and 
**     3) Feeder Equipment Preloads,
**     4) Network Protector Check if Necessary.
*/
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT  :Jobs[i].StepPair = StepPair,
           :Jobs[i].TOMove = Name
   FROM    FMS_StepPair
   WHERE   TypeOfCard = :TypeOfCard 
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].MoveCategory = MoveCategory$StepHeading;
      Jobs[i].JobClass = 0;
      Jobs[i].Substation = 0;
      Jobs[i].Equip = 0;
      Jobs[i].EquipClass = 0;
      i = i + 1;
   END;

/* done with selecting step headings 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

/*
** Insert Step Headings
*/   
   FOR i = 1 TO Jobs.LastRow() DO

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting step heading into SOA_Job.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card;
      ControlEntry.Seq = 0;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$FMS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = TypeOfCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting step heading into SOA_JobControl.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

   IF StepHeadingsOnly = TRUE THEN
      ProcessWindow.Terminate();
      RETURN PU_OK;
   ENDIF;
/* 
** done with inserting step headings 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = JC.TOMove, 
           :Jobs[i].RSMove = JC.RSMove, 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC
   WHERE   JCC.EquipClass = 0 AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :TypeOfCard AND 
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :CardClass AND 
                                  PL.TypeofCard = :TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = :Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      Jobs[i].Substation = 0;
      Jobs[i].Equip = 0;
      Jobs[i].EquipClass = 0;
     i = i + 1;
   END;

/* done with selecting null equipment moves 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

/*
** Insert NULL Equipment moves
*/
   FOR i = 1 TO Jobs.LastRow() DO

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting null equipment move into SOA_Job.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$FMS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = TypeOfCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting null equipment move into SOA_JobControl.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

/* done with inserting null equipment moves 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

   LastID = '';
   LastEQ = 0;
   LastJC = 0;
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].PrintID = G.Reference, 
           :Jobs[i].EquipClassName = E.TypeName, 
           :Jobs[i].EquipName = E.Name, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].Equip = E.Object, 
           :Jobs[i].EquipClass = E.Type,
           :Jobs[i].MoveEquipClass = JCC.EquipClass, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = E.Description + JC.TOMove, 
           :Jobs[i].RSMove = E.Description + JC.RSMove, 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC, 
           Udb_Grouping G,
           Udb_Object E, 
           Udb_ExtendedType ET,
           Udb_SuperType ST,
           TFMS_CardToObject CTO 
   WHERE   CTO.Card = :Card AND
          (CTO.Type = :Type$Feeder OR
          (CTO.Type = ST.Type AND
           ST.SuperType = :Type$33KVPortion)) AND
           CTO.Object = G.Grouping AND
           G.Relationship = :Interaction$MemberOf AND 
           G.Member = E.Object AND 
           G.MemberType = ET.Type AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :TypeOfCard AND 
           JCC.EquipClass = ET.SuperType AND
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :CardClass AND 
                                  PL.TypeofCard = :TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      IF Jobs[i].PrintID = '' AND
          Jobs[i].EquipClass = Type$3GSwitch THEN
         Jobs.RemoveRow (RowNumber = i);
      ELSE
         Jobs[i].Job = -1;
         Jobs[i].Seq = -1;
         Jobs[i].Card = :Card;
         Jobs[i].ControlCard = :Card;
         Jobs[i].MoveCategory = MoveCategory$Normal;
         Jobs[i].Substation = 0;
         i = i + 1;
      ENDIF;
   END;
/* 
** done with selecting feeder equipment moves 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');
/*
** Insert Feeder Equipment Moves
*/
   CurFrame.Flush();
   FOR i = 1 TO Jobs.LastRow() DO
/*
** Get the Substation if one exists.
*/
      Jobs[i].Substation = 0;
      REPEATED 
      SELECT  :Jobs[i].Substation = O.Object,
              :Jobs[i].SubstationName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   O.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = :Jobs[i].Equip AND
              O.Type IN (SELECT Type FROM Udb_ExtendedType
                         WHERE  SuperType = :Type$Substation);

      IF Jobs[i].Substation <> 0 THEN
         Jobs[i].TOMove = Jobs[i].TOMove + ' - ' + Jobs[i].EquipName;
         Jobs[i].RSMove = Jobs[i].RSMove + ' - ' + Jobs[i].EquipName; 
      ENDIF;

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting equipment move into SOA_Job.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$FMS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = TypeOfCard;
      ControlEntry.MoveEquipClass = Jobs[i].MoveEquipClass;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = Jobs[i].PrintID;

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting equipment move into SOA_JobControl.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

/* done with inserting feeder equipment moves 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

   i = 1;
   Jobs.Clear();
   IF CardClass <> Type$FOT AND CardClass <> Type$Auto AND 
       CardClass <> Type$CIOA AND CardClass <> Type$OOE1 THEN
    
      REPEATED 
      SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = JC.TOMove, 
           :Jobs[i].RSMove = JC.RSMove, 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
      FROM    FMS_JobClass JC, 
              FMS_JobClassControl JCC
      WHERE   JC.JobClass = :Move$NetworkProtectionCheck AND
              JC.JobClass = JCC.JobClass AND
              JCC.TypeOfCard = :TypeOfCard AND 
              EXISTS (SELECT * FROM Udb_Grouping G, Udb_ExtendedType ET, TFMS_CardToObject CTO, Udb_SuperType ST 
                      WHERE  CTO.Card = :Card AND
                            (CTO.Type = :Type$Feeder OR
                            (CTO.Type = ST.Type AND
                             ST.SuperType = :Type$33kvPortion)) AND
                             CTO.Object = G.Grouping AND 
                             G.Relationship = :Interaction$MemberOf AND  
                             G.MemberType = ET.Type AND 
                             ET.SuperType = :TypeName$ST)
      BEGIN
         Jobs[i].Job = -1;
         Jobs[i].Seq = -1;
         Jobs[i].Card = :Card;
         Jobs[i].MoveCategory = MoveCategory$Normal;
         Jobs[i].Substation = 0;
         Jobs[i].Equip = 0;
         Jobs[i].EquipClass = 0;
         i = i + 1;
      END;
   ENDIF;
/* done with selecting network protector moves 
*/
   ProcessCount = ProcessCount + 1;
   ProcessWindow.SendUserEvent (EventName = 'Update_Percent',
                                MessageInteger = ProcessCount);
   CurFrame.WaitFor (EventName = 'Received');

/*
** Insert Network Protector Check for certain card types only
*/
   FOR i = 1 TO Jobs.LastRow() DO

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting Network Protector Check into SOA_Job.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$FMS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = TypeOfCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting Network Protector Check into ' +
                 'SOA_JobControl.';
         ProcessWindow.Terminate();
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

/* done with everything 
*/
   ProcessWindow.Terminate();

   RETURN PU_OK;
END;


Application Component Report
============================

	Name:            PreloadSDSMoves

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    SOA
**  Frame:          PreloadSDSMoves  
**
**  Modifications:
**	03/23/05 em	Created 
**      01/18/06 em     Add Valve name to end of move text.
**      08/02/07 em     Load Main into Job Substation field on Sole Authority card.
**      08/06/07 em     If move has already been loaded for a valve on another main, then
**                      don't insert for next main.  Can't insert for both and make shared, would
**                      get duplicate key error.
**      10/01/07 em     Don't include type name on Main moves. 
**      10/25/07 em     Add NewMainOnly parameter to load new moves
**                      for a main added to the card.
**      01/18/08 em     Use TypeOfCard field from Card class to support NSA cards
**      01/30/08 em     When adding NewMainOnly, check for duplicate valve moves.
**      02/12/08 em     Preload Main moves on Non-Sole Auth card 
*/
PROCEDURE PreloadSDSMoves 
(
    Card        = CardSDS;                      /* Passed Card Class*/
    NewMainOnly = INTEGER NOT NULL WITH DEFAULT;  /* Optional - New Main on Card*/
    NewMainName = VARCHAR(40) NOT NULL WITH DEFAULT; /*Optional - New Main Name*/

    ControlEntry = NewMoveCard;
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    Jobs = ARRAY OF Job;
    RetCode = INTEGER;
) =
BEGIN
/*
** For New SDS Card, Insert: 
**     1) Step Headings, 
**     2) NULL Valve Preloads, 
**     3) MAIN Preloads and 
**     4) Valve Preloads.
** 4  only for Sole Authority Cards 
*/
  IF NewMainOnly = FALSE THEN
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT  :Jobs[i].StepPair = StepPair,
           :Jobs[i].TOMove = Name
   FROM    FMS_StepPair
   WHERE   TypeOfCard = :Card.TypeOfCard
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].MoveCategory = MoveCategory$StepHeading;
      Jobs[i].JobClass = 0;
      Jobs[i].Substation = 0;
      Jobs[i].Equip = 0;
      Jobs[i].EquipClass = 0;
      i = i + 1;
   END;
/*
** Insert Step Headings
*/   
   FOR i = 1 TO Jobs.LastRow() DO

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting step heading into SOA_Job.';
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.Seq = 0;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting step heading into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = JC.TOMove, 
           :Jobs[i].RSMove = JC.RSMove, 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC
   WHERE   JCC.EquipClass = 0 AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :Card.TypeOfCard AND 
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :Card.CardClass AND 
                                  PL.TypeofCard = :Card.TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = Card.Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      Jobs[i].Substation = 0;
      Jobs[i].Equip = 0;
      Jobs[i].EquipClass = 0;
     i = i + 1;
   END;
/*
** Insert NULL Equipment moves
*/
   FOR i = 1 TO Jobs.LastRow() DO

      Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting null equipment move into SOA_Job.';
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = 0;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = '';

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting null equipment move into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** Insert moves on the Card Mains.
*/
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].PrintID = '', 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].Equip = 0,  /*Want this blank on the move*/
           :Jobs[i].EquipClass = E.Type,
           :Jobs[i].EquipClassName = '',  /*Want this blank on the move*/
           :Jobs[i].MoveEquipClass = JCC.EquipClass, 
           :Jobs[i].EquipName = E.Name,  /*Want this blank on the move*/ 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = JC.TOMove, 
           :Jobs[i].RSMove = JC.RSMove, 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules,
           :Jobs[i].Substation = CM.Main,
           :Jobs[i].SubstationName = CM.MainName
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC, 
           Udb_Object E, 
           Udb_ExtendedType ET,
           SDS_CardMain CM 
   WHERE   CM.Card = :Card.Card AND
           CM.Main = E.Object AND 
           E.Type = ET.Type AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :Card.TypeOfCard AND 
           JCC.EquipClass = ET.SuperType AND
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :Card.CardClass AND 
                                  PL.TypeofCard = :Card.TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = Card.Card;
      Jobs[i].ControlCard = Card.Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      IF Card.SoleAuthority = TRUE THEN      
/* 
** Append Main Name only if Sole Auth card.
** Clear EquipName field afterwards because we want it blank on the card.
*/
         Jobs[i].TOMove = SQUEEZE(Jobs[i].TOMove + ' - ' + Jobs[i].EquipName);
         Jobs[i].RSMove = SQUEEZE(Jobs[i].RSMove + ' - ' + Jobs[i].EquipName);
      ENDIF;
      Jobs[i].EquipName = '';
      i = i + 1;
   END;
/*
** Insert Main Moves
*/
   CurProcedure.Flush();
   FOR i = 1 TO Jobs.LastRow() DO
      Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting main move into SOA_Job.';
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = Jobs[i].MoveEquipClass;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = Jobs[i].PrintID;

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting main move into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

   IF Card.SoleAuthority = TRUE THEN
/*
** Valve moves
*/
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].PrintID = G.Reference, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].Equip = E.Object, 
           :Jobs[i].EquipClass = E.Type,
           :Jobs[i].EquipClassName = E.TypeName, 
           :Jobs[i].MoveEquipClass = JCC.EquipClass, 
           :Jobs[i].EquipName = E.Name, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = SQUEEZE(E.Description + JC.TOMove + ' - ' + E.Name), 
           :Jobs[i].RSMove = SQUEEZE(E.Description + JC.RSMove + ' - ' + E.Name), 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules,
           :Jobs[i].Substation = CM.Main,
           :Jobs[i].SubstationName = CM.MainName
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC, 
           Udb_Grouping G,
           Udb_Object E, 
           Udb_ExtendedType ET,
           SDS_CardMain CM 
   WHERE   CM.Card = :Card.Card AND
           CM.Main = G.Grouping AND 
           G.Relationship = :Interaction$MemberOf AND 
           G.Member = E.Object AND 
           G.MemberType = ET.Type AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :Card.TypeOfCard AND 
           JCC.EquipClass = ET.SuperType AND
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :Card.CardClass AND 
                                  PL.TypeofCard = :Card.TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = Card.Card;
      Jobs[i].ControlCard = Card.Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      i = i + 1;
   END;
/*
** Insert Main Valve Moves
*/
   CurProcedure.Flush();
   FOR i = 1 TO Jobs.LastRow() DO
/*
** Get the Substation if one exists.
** Using the Main.
*
      REPEATED 
      SELECT  :Jobs[i].Substation = O.Object,
              :Jobs[i].SubstationName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   O.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = :Jobs[i].Equip AND
              O.Type IN (SELECT Type FROM Udb_ExtendedType
                         WHERE  SuperType = :Type$Substation);
*/
/*
** Look for duplicate move.  
*/ 
      IF i > 1 THEN
         FOR k = 1 TO (i-1) DO
            IF Jobs[i].JobClass = Jobs[k].JobClass AND 
                 Jobs[i].Equip = Jobs[k].Equip THEN
               Jobs[i].Job = Jobs[k].Job;
            ENDIF;  
         ENDFOR;
      ENDIF;

      IF Jobs[i].Job <> -1 THEN
         CONTINUE;  /* Skip this one*/
      ELSE
         Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);
    
         IF Jobs[i].Job < 0 THEN      
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'PROCEDURE:PreloadMoves; ' +
                    'Failure inserting valve move into SOA_Job.';
            RETURN PU_CANCEL;
         ENDIF;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = Jobs[i].MoveEquipClass;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = Jobs[i].PrintID;

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting valve move into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

   ENDIF;  /*Skipping on non-sole auth card */

  ELSE  /* Single Main Moves */

/*
** Insert moves on the Card Mains.
*/
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].PrintID = '', 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].Equip = 0,  /*Want this blank on the move*/
           :Jobs[i].EquipClass = E.Type,
           :Jobs[i].EquipClassName = '',  /*Want this blank on the move*/
           :Jobs[i].MoveEquipClass = JCC.EquipClass, 
           :Jobs[i].EquipName = '',  /*Want this blank on the move*/ 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = SQUEEZE(E.Description + JC.TOMove + ' - ' + E.Name), 
           :Jobs[i].RSMove = SQUEEZE(E.Description + JC.RSMove + ' - ' + E.Name), 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC, 
           Udb_Object E, 
           Udb_ExtendedType ET
   WHERE   E.Object = :NewMainOnly AND 
           E.Type = ET.Type AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :Card.TypeOfCard AND 
           JCC.EquipClass = ET.SuperType AND
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :Card.CardClass AND 
                                  PL.TypeofCard = :Card.TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = Card.Card;
      Jobs[i].ControlCard = Card.Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      Jobs[i].Substation = NewMainOnly;
      Jobs[i].SubstationName = NewMainName;
      i = i + 1;
   END;
/*
** Insert Main Moves
*/
   CurProcedure.Flush();
   FOR i = 1 TO Jobs.LastRow() DO
      Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);

      IF Jobs[i].Job < 0 THEN      
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting main move into SOA_Job.';
         RETURN PU_CANCEL;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = Jobs[i].MoveEquipClass;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = Jobs[i].PrintID;

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting main move into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** Valve moves
*/
   i = 1;
   Jobs.Clear();
   REPEATED 
   SELECT DISTINCT 
           :Jobs[i].StepPair = JCC.StepPair, 
           :Jobs[i].PrintID = G.Reference, 
           :Jobs[i].Seq = JCC.Seq,
           :Jobs[i].JobClass = JC.JobClass, 
           :Jobs[i].Equip = E.Object, 
           :Jobs[i].EquipClass = E.Type,
           :Jobs[i].EquipClassName = E.TypeName, 
           :Jobs[i].MoveEquipClass = JCC.EquipClass, 
           :Jobs[i].EquipName = E.Name, 
           :Jobs[i].MoveType = JC.MoveType, 
           :Jobs[i].TOMove = SQUEEZE(E.Description + JC.TOMove + ' - ' + E.Name), 
           :Jobs[i].RSMove = SQUEEZE(E.Description + JC.RSMove + ' - ' + E.Name), 
           :Jobs[i].TOMoveRules = JC.TOMoveRules,
           :Jobs[i].RSMoveRules = JC.RSMoveRules
   FROM    FMS_JobClass JC, 
           FMS_JobClassControl JCC, 
           Udb_Grouping G,
           Udb_Object E, 
           Udb_ExtendedType ET
   WHERE   G.Grouping = :NewMainOnly AND 
           G.Relationship = :Interaction$MemberOf AND 
           G.Member = E.Object AND 
           G.MemberType = ET.Type AND 
           JC.JobClass = JCC.JobClass AND
           JCC.TypeOfCard = :Card.TypeOfCard AND 
           JCC.EquipClass = ET.SuperType AND
           JC.JobClass IN (SELECT PL.JobClass FROM FMS_Preload PL 
                           WHERE  PL.CardClass = :Card.CardClass AND 
                                  PL.TypeofCard = :Card.TypeOfCard AND
                                  PL.StepPair = JCC.StepPair AND 
                                  PL.EquipClass = JCC.EquipClass)
   BEGIN
      Jobs[i].Job = -1;
      Jobs[i].Seq = -1;
      Jobs[i].Card = Card.Card;
      Jobs[i].ControlCard = Card.Card;
      Jobs[i].MoveCategory = MoveCategory$Normal;
      Jobs[i].Substation = NewMainOnly;
      Jobs[i].SubstationName = NewMainName;
      i = i + 1;
   END;
/*
** Insert Main Valve Moves
*/
   CurProcedure.Flush();
   FOR i = 1 TO Jobs.LastRow() DO
/*
** Get the Substation if one exists.
** Using the Main.
*
      REPEATED 
      SELECT  :Jobs[i].Substation = O.Object,
              :Jobs[i].SubstationName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   O.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = :Jobs[i].Equip AND
              O.Type IN (SELECT Type FROM Udb_ExtendedType
                         WHERE  SuperType = :Type$Substation);
*/
/*
** Look for duplicate move.  
*/ 
      IF i > 1 THEN
         FOR k = 1 TO (i-1) DO
            IF Jobs[i].JobClass = Jobs[k].JobClass AND 
                 Jobs[i].Equip = Jobs[k].Equip THEN
               Jobs[i].Job = Jobs[k].Job;
            ENDIF;  
         ENDFOR;
      ENDIF;
/*
** Look for duplicate outstanding Job already on card.
*/
      SELECT :Jobs[i].Job = -1
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :Card.Card AND
             JC.Job = J.Job AND
             J.Equip = :Jobs[i].Equip AND
             J.JobClass = :Jobs[i].JobClass AND
            (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Status = '' AND
             J.MoveCategory = :MoveCategory$Normal;

      IF Jobs[i].Job <> -1 THEN
         CONTINUE;  /* Skip this one*/
      ELSE
         Jobs[i].Job = Jobs[i].InsertJob (Card = Card.Card);
    
         IF Jobs[i].Job < 0 THEN      
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'PROCEDURE:PreloadMoves; ' +
                    'Failure inserting valve move into SOA_Job.';
            RETURN PU_CANCEL;
         ENDIF;
      ENDIF;

      ControlEntry.Card = Card.Card;
      ControlEntry.SwitchingItem = 0;
      ControlEntry.Application = Application$SDS;
      ControlEntry.StepHeading = Jobs[i].StepPair;
      ControlEntry.TypeOfCard = Card.TypeOfCard;
      ControlEntry.MoveEquipClass = Jobs[i].MoveEquipClass;
      ControlEntry.StepLevel = 0;
      ControlEntry.PrintID = Jobs[i].PrintID;

      RetCode = Jobs[i].InsertControl (
               ControlEntry = ControlEntry,
               TransferFlag = TRUE,
               InitiatingCard = Card.Card);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'PROCEDURE:PreloadMoves; ' +
                 'Failure inserting valve move into SOA_JobControl.';
         RETURN PU_CANCEL;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_COMMIT;

  ENDIF;

   RETURN PU_OK;
END;



