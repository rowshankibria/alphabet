Application Component Report
============================

	Name:            ProtectionCheckConfirm

/*
**
**	Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**	ALSTOM ESCA, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of ALSTOM ESCA, Inc.
**
**  Application:    FeederCard
**  Frame:          ProtectionCheckConfirm
**
**  08/06/01  my    Created
**  08/31/01  em    Validation
**  01/07/02  em    Added optional message for sending permit revisions
**  10/08/02  ysp   Merge: use SOA Job and log tables
**  01/23/03  em    Frame needs work to support parameters Card and 
**                  Job.
**  02/24/03  em    Redesigned select to match logic used for 
**                  LoadProtectionMoves include script.
**  05/19/03  em    Don't display screen if protection not required.
**  07/18/05  em    Add Switching Item to support TOMS 
**  12/14/05  ysp   increase the size of tomove to 160 chars
**  03/27/07  em    Don't display this for ISWP Conditions.
**  02/20/14  em    PrePost must equal 0. Include Order by Seq.
**  02/21/17  em    Highlight selected row
**  03/20/17  em    If In-Service Equipment Permit, then don't count ISWP
**  08/21/19  em    Call Work Location Protection Trace for FMS FCR Permit 
**  09/03/19  em    Save protection results for green condition also.
**  09/17/19  em    If Protection Move is restore issued or not takeout complete then do not count it for Protection comparison
**                  New Attribute DiffDistance returned from ProtectionComparison
**  09/25/19  em    If WorkPermitProtection moves exist even if not properly outstanding, still need Work Permit Protection trace. 
**                  Add CompareFlag parm into WorkLocationProtectionTrace call
**  02/07/20  em    Use ValidPermit attribute to control WorkLocationProtectionTrace call
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;   /*Passed Parameter*/
    Job  = INTEGER NOT NULL;   /*Passed Parameter*/
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT; /*Optional Parameter*/

    PermitRev = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm*/

    Text = Varchar(160) NOT NULL;		/* Confirm text */
    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    ProtectionCardType = INTEGER NOT NULL;
    ProtectionRequired = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
    ProtectionResult = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
    InServicePermitEquip = INTEGER NOT NULL;
    PPL = ARRAY of WorkPermitProtection;
    k = INTEGER NOT NULL WITH DEFAULT;
    status = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    RowFound = INTEGER NOT NULL WITH DEFAULT;
    PM = Generic_Job DEFAULT NULL;       /*Single Protection Move Select */ 
    ISPermit = INTEGER NOT NULL WITH DEFAULT;  /* if an ISPermit */
    ProtEq = ARRAY OF INTEGEROBJECT;
    ProtSugg = ARRAY OF INTEGEROBJECT;
    WPC  = ARRAY OF WPComparison;  /*Out parameter from WorkLocationProtectionTrace */
    PermitMoveText = VARCHAR(160) NOT NULL WITH DEFAULT;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
    IssueDate = DATE NOT NULL WITH DEFAULT;
    DiffDistance = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    IF PermitRev = TRUE THEN
       FIELD(Send_Revision_Message).Curbias = FB_VISIBLE;
    ENDIF;

    ProtectionRequired = TRUE;
    InServicePermitEquip = 0;
    IF CurrentApplication = Application$FMS THEN
       SELECT :ProtectionRequired = ProtectionRequired
       FROM   FMS_WorkPermit
       WHERE  PermitJobID = :Job;
    ELSE
       SELECT :ProtectionRequired = ProtectionRequired,
              :InServicePermitEquip = PhaseCheckIndicator
       FROM   SOA_WorkPermit
       WHERE  PermitJobId = :Job;

       IF InServicePermitEquip = 0 THEN 
          ISPermit = 0;
          SELECT  :ISPermit = ISPermit
          FROM    SOA_InServicePermit
          WHERE   Job = :Job;

          IF ISPermit <> 0 THEN
             ProtectionRequired = FALSE;   /* Exit on next statement */
          ENDIF;
       ENDIF;
    ENDIF;

    IF ProtectionRequired = FALSE THEN
       RETURN(PU_OK);
    ENDIF; 
/*
** Get the list of Protection Links for this permit.
** Scroll throught the List and retrieve only those that are necessary.
*/
    k = 1;
    PPL.Clear();
    REPEATED 
    SELECT  :PPL[k].PermitCardType 	= PermitCardType
           ,:PPL[k].PermitJobID    	= PermitJobID
           ,:PPL[k].PermitCard		= PermitCard
           ,:PPL[k].ProtectionCardType 	= ProtectionCardType
           ,:PPL[k].ProtectionJobID    	= ProtectionJobID
           ,:PPL[k].ProtectionCard	= ProtectionCard
           ,:PPL[k].Seq			= Seq
    FROM   FMS_WorkPermitProtection
    WHERE  PermitJobID = :Job AND
           PermitCardType = 0 AND   /* Avoids conflicts with TLS Job IDs */
           PrePost = 0
    ORDER BY Seq
    BEGIN
      k = k + 1;
    END;
    
    i = 1;
    FOR k = 1 TO PPL.LastRow() DO
        PM = NULL;
        PM = Generic_Job.Create();

#INCLUDE LoadProtectionMove

        WP[i] = PM.Duplicate();
        i = i + 1;
    ENDFOR;
/* 
** For an FCR permit with work locations, prepare to call WorkLocationProtectionTrace
** to compare actual protections with suggested protections.
*/
    IF CurrentApplication = Application$FMS AND CardDetails.ValidDiagram = FeederDiagram$Valid THEN
       ISPermit = 0;
       SELECT :ISPermit = COUNT(*)
       FROM   IR_WorkLocation
       WHERE  WorkPermit = :Job;
       
       IF ISPermit > 0 THEN
          ProtEq.Clear();
          i = 1; 
          j = 0;
          WHILE i <= WP.LastRow DO
             /* Avoid duplicates */
             status = ProtEq.Find (AttributeName = 'Value',
                                   Value =  WP[i].Equip);
             IF status <> ER_OK AND 
                   WP[i].RSIssued IS NULL AND 
                   WP[i].TOComplete IS NOT NULL THEN   /* Don't count if TO not complete or RS Issued */
                j = j + 1;
                ProtEq[j].Value = WP[i].Equip;
             ENDIF;
             i = i + 1;
          ENDWHILE;
          
          IF ProtEq.LastRow > 0 OR WP.LastRow > 0 THEN    /*Include WP.LastRow in case WP moves are not outstanding leaving ProtEq empty */
             SELECT :PermitMoveText = TOMove
             FROM   SOA_Job
             WHERE  Job = :Job;
             SELECT :FeederName = FeederName
             FROM   FMS_Card
             WHERE  Card = :Card;
             
             CALLFRAME WorkLocationProtectionTrace (
                 Card = Card,
                 WorkPermit = Job,
                 PermitMoveText = PermitMoveText,
                 ProtEq = ProtEq,
                 CompareFlag = TRUE,
                 WPC = BYREF(WPC));

             IF WPC.LastRow > 0 THEN
                ProtectionResult = CALLFRAME WorkLocationProtectionComparison (WPC = WPC,
                                                         PermitMoveText = PermitMoveText, 
                                                         DiffDistance = BYREF(DiffDistance));
                IF ProtectionResult = 2 THEN
                   FIELD(AdequateProtection).CurBias = FB_VISIBLE;         
                ENDIF;                          
             ENDIF;
             
             /* Remove Duplicates */
             ProtSugg.Clear();
             i = 1; 
             j = 0;
             WHILE i <= WPC.LastRow DO
                status = ProtSugg.Find (AttributeName = 'Value',
                                   Value =  WPC[i].SEquip);
                IF status <> ER_OK THEN  
                   j = j + 1;
                   ProtSugg[j].Value = WPC[i].SEquip;
                ENDIF;
                i = i + 1;
             ENDWHILE;
             
             /* Save results and protections when not adequate */
             IssueDate = DATE('now');
             RetCode = CALLPROC FMS_WPProtectionResultIns (
                         WorkPermit = Job,
                         IssueDate = IssueDate,
                         Card = Card,
                         FeederName = FeederName,
                         TOMove = PermitMoveText,
                         Operator = DOp.Object,
                         OperatorName = DOp.Description,
                         ProtectionResult = ProtectionResult,
                         DiffDistance = DiffDistance);

             IF RetCode <> 0 THEN
                CALLPROC DDB_ROLLBACK;
                MESSAGE 'Error saving Protection Check Comparison Result';
                RESUME;
             ENDIF; 
             
             IF ProtectionResult >= 0 THEN
                FOR i = 1 TO ProtEq.LastRow DO
                   RetCode = CALLPROC FMS_WPProtectionActualIns (
                                  WorkPermit = Job,
                                  IssueDate = IssueDate,
                                  ActualEquip = ProtEq[i].Value);
                   IF RetCode <> 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Error saving actual Protections for poor comparison result';
                     RESUME;
                   ENDIF; 
                ENDFOR;
                FOR i = 1 TO ProtSugg.LastRow DO
                   RetCode = CALLPROC FMS_WPProtectionSuggestedIns (
                                  WorkPermit = Job,
                                  IssueDate = IssueDate,
                                  SuggestedEquip = ProtSugg[i].Value);
                   IF RetCode <> 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Error saving suggested Protections for poor comparison result';
                     RESUME;
                   ENDIF; 
                ENDFOR;
                CALLPROC DDB_COMMIT;
             ENDIF;
          ENDIF;
       ENDIF;
 /*temp disable, not for production yet

    ELSEIF CurrentApplication = Application$FMS AND CardDetails.ValidDiagram = FeederDiagram$Invalid THEN
       ISPermit = 0;
       SELECT :ISPermit = COUNT(*)
       FROM   IR_WorkLocation
       WHERE  WorkPermit = :Job;   /* Make sure this an FCR permit that has work locations *
       
       IF ISPermit > 0 THEN
          MESSAGE 'Cannot use Feeder Diagram trace because diagram has been marked invalid. ' +
               'Please inform Core Group member to review this feeder diagram.';
       ENDIF;
 */
    ENDIF;  
END;
/*
**	Handle a Yes click
*/
ON Click YesButton =

    BEGIN
	CALLPROC SOA_LogIns (Card = Card,
			    Job = Job,
                            SwitchingItem = SwitchingItem,
			    Item = 'Confirm',
			    Old = Text,
			    New = ' Protections Confirmed',
                            Time = Date('now'),
                            UserName = UserName);
        CALLPROC DDB_COMMIT;
	RETURN (PU_OK);
    END;
/*
**	Handle a No click
*/
ON Click NoButton =

    BEGIN
	CALLPROC SOA_LogIns (Card = Card,
			    Job = Job,
                            SwitchingItem = SwitchingItem,
			    Item = 'Confirm',
			    Old = Text,
			    New = 'Did not confirm Protections',
                            Time = Date('now'),
                            UserName = UserName);
        CALLPROC DDB_COMMIT;
	RETURN (PU_Cancel);
    END;

ON CHILDENTRY WP =
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   IF FIELD(WP[].CardTypeName).IsReverse = TRUE THEN
      FIELD(WP[].CardTypeName).IsReverse = FALSE;
      FIELD(WP[].CardStatus).IsReverse = FALSE;
      FIELD(WP[].CardName).IsReverse = FALSE;
      FIELD(WP[].TOIssued).IsReverse = FALSE;
      FIELD(WP[].TOComplete).IsReverse = FALSE;
      FIELD(WP[].SubsOrDesk).IsReverse = FALSE;
      FIELD(WP[].PrintID).IsReverse = FALSE;
      FIELD(WP[].EquipClassName).IsReverse = FALSE;
      FIELD(WP[].EquipName).IsReverse = FALSE;
      FIELD(WP[].TOMove).IsReverse = FALSE;
      FIELD(WP[].RSIssued).IsReverse = FALSE;
      FIELD(WP[].RSComplete).IsReverse = FALSE;
   ELSE
      FIELD(WP[].CardTypeName).IsReverse = TRUE;
      FIELD(WP[].CardStatus).IsReverse = TRUE;
      FIELD(WP[].CardName).IsReverse = TRUE;
      FIELD(WP[].TOIssued).IsReverse = TRUE;
      FIELD(WP[].TOComplete).IsReverse = TRUE;
      FIELD(WP[].SubsOrDesk).IsReverse = TRUE;
      FIELD(WP[].PrintID).IsReverse = TRUE;
      FIELD(WP[].EquipClassName).IsReverse = TRUE;
      FIELD(WP[].EquipName).IsReverse = TRUE;
      FIELD(WP[].TOMove).IsReverse = TRUE;
      FIELD(WP[].RSIssued).IsReverse = TRUE;
      FIELD(WP[].RSComplete).IsReverse = TRUE;
   ENDIF;

END;

ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

