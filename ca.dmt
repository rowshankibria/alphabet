METHOD LoadActiveRequests (
) = 
DECLARE
   i       = INTEGER NOT NULL;     /*Counter*/
   j       = INTEGER NOT NULL;     /*Counter*/
   CurPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   NewPermList = VARCHAR(100) NOT NULL WITH DEFAULT; 
   DynamicWhereClause = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReqList.Clear();
   IF CurObject.AccessType = 'RAPID_RESTORE' THEN
      i = 1;
      SELECT   	 
            :CurObject.ReqList[i].RequestID = R.RequestID,      
            :CurObject.ReqList[i].RequestTime = R.RequestTime,      
            :CurObject.ReqList[i].Department = R.Department,
            :CurObject.ReqList[i].ManagerTitle = R.ManagerTitle,
            :CurObject.ReqList[i].ManagerName = R.ManagerName,
            :CurObject.ReqList[i].ManagerEmail = R.ManagerEmail,
            :CurObject.ReqList[i].CrewName = R.CrewName,
            :CurObject.ReqList[i].CrewEMPNumber = R.CrewEMPNumber,
            :CurObject.ReqList[i].CrewObject = R.CrewObject,
            :CurObject.ReqList[i].RequestRemark = R.RequestRemark,
            :CurObject.ReqList[i].Status = R.Status,
            :CurObject.ReqList[i].ReviewedBy= R.ReviewedBy,
            :CurObject.ReqList[i].ReviewTime = R.ReviewTime,
            :CurObject.ReqList[i].ReviewRemark = R.ReviewRemark,
            :CurPermList = R.CurPermission,     
            :NewPermList = R.NewPermission
      FROM FMS_AccessRequest R
      WHERE R.Status IN (:Request$Opened, :Request$Denied, :Request$Approved)
      BEGIN
         /*
         ** check if it is already in the object table
         */
         IF CurObject.ReqList[i].CrewObject = 0 THEN
            SELECT :CurObject.ReqList[i].CrewObject = O.Object
            FROM   UDB_Object O
            WHERE  O.Name = :CurObject.ReqList[i].CrewEMPNumber AND
                   O.Type IN (SELECT  Type
                        FROM    Udb_ExtendedType
                        WHERE   SuperType = :Type$Person);
         ENDIF;
   
         CurObject.ReqList[i].CurPermList.Clear();
         IF CurObject.ReqList[i].CrewObject > 0 THEN
            j = 1;
            SELECT :CurObject.ReqList[i].CurPermList[j].Name = T.Name,
                   :CurObject.ReqList[i].CurPermList[j].Type = S.Skill
            FROM   FMS_PersonToSkill S,
                   UDB_Type T
            WHERE  S.Operator = :CurObject.ReqList[i].CrewObject AND
                   S.Skill = T.Type
            BEGIN
               j = j + 1;
            END;
         ENDIF;

         DynamicWhereClause = 'T.Type IN (' + NewPermList + ')';
         CurObject.ReqList[i].NewPermList.Clear();
         j = 1;
         SELECT :CurObject.ReqList[i].NewPermList[j].Name = T.Name,
                :CurObject.ReqList[i].NewPermList[j].Type = T.Type
         FROM   UDB_Type T
         WHERE  :DynamicWhereClause 
         BEGIN
            j = j + 1;
         END;

         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;

