Application Component Report
============================

	Name:            SaveGroundJobs

/* 
**      Copyright c 2004 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software. 
** 
**  Application:    CAC 
**  4GL Procedure:  SaveGroundJobs 
** 
**  Modification log: 
** 
**  Date:  	Version		Description 
** -------------------------------------------------- 
** 01/15/04     ysp     creation
*/ 
PROCEDURE SaveGroundJobs
(
    Card          = INTEGER NOT NULL;
    SwitchingItem = INTEGER NOT NULL;
    i             = INTEGER NOT NULL WITH DEFAULT;
    j             = INTEGER NOT NULL WITH DEFAULT;
    SaveFailed    = INTEGER NOT NULL WITH DEFAULT;
    OutStandingEquip = ARRAY of IntegerObject;
    OutStandingJobs = ARRAY of IntegerObject;
    RetCode         = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** If there are outstanding ground moves on the card, 
** save these moves so that they can be picked up when a new card 
** on the feeder or transmission line is activated.
*/
   j = 1;
   REPEATED
   SELECT DISTINCT
         :OutStandingEquip[j].Value = J.Equip,
         :OutStandingJobs[j].Value = J.Job
   FROM  SOA_Job J,
         SOA_JobControl JC,
         FMS_ObjectStatus OS,
         FMS_JobAction JA
   WHERE JC.Card = :Card AND
         JC.SwitchingItem = :SwitchingItem AND
         JC.Job = J.Job AND
         J.TOComplete IS NOT NULL AND
         J.RSComplete IS NULL AND
         J.Status = '' AND
         J.ControlCard = :Card AND
         J.MoveCategory = :MoveCategory$Normal AND
         J.Equip = OS.Object AND
         OS.Status = :Status$Ground AND
         OS.StatusCount > 0 AND
         J.JobClass = JA.JobClass AND
         JA.Status = :Status$Ground AND
         JA.EquipClass IN (SELECT SuperType FROM Udb_ExtendedType
                          WHERE  Type = JC.MoveEquipClass)
   BEGIN
      j = j + 1;
   END;
 
/* we make copies of outstanding moves and save the copies 
** to the dropped job bank.
*/
   SaveFailed = FALSE;
   j = 1;
   WHILE j <= OutStandingJobs.LastRow() DO
      RetCode = CALLPROC FMS_SaveEquipJob(
                             Equip = OutstandingEquip[j].Value,
                             Job = OutStandingJobs[j].Value);
      IF (RetCode < 0) THEN 
         CALLPROC DDB_ROLLBACK;
         SaveFailed = TRUE;
      ENDIF;

      j = j + 1; 
   ENDWHILE;
   CALLPROC DDB_COMMIT; 
   
   IF SaveFailed = TRUE THEN
      RETURN PU_CANCEL; 
   ELSE
      RETURN PU_OK;
   ENDIF;
END;

Application Component Report
============================

	Name:            SaveGroundMove

/*
**
**  Copyright c 2007 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          Modified from SelectGroundMoves
**
**  Modification log:
**
**   12/03/07   ysp Created
**   07/14/15   em  Changes to click behavior on screen, default to takeout
**   10/19/15   em  Allow multiple moves to be selected. Remove Restore capability
**                  Restore capability exists on another screen.  Save moves in global array for
**                  pass back to ProtectionMove link screen.
**   10/20/15   em  Logic is deleting moves from the drop bank when move is one-sided takeout only.
**                  Changing this logic to support insertion of takeout only moves for ATS Macro equip.
**                  Make Ok_btn invisible.
**                  
*/
INITIALIZE   
(
    C = FMS_Card;
    SelectEquip = FMS_Equip;
    NoInsert = INTEGER NOT NULL;

/* local variables */
#   include StandardDeclarations

    j = integer;            /* Temporary counter */
    k = integer NOT NULL WITH DEFAULT;
    m = integer NOT NULL WITH DEFAULT;
    n = integer NOT NULL WITH DEFAULT;

    EventText = VARCHAR(256) NOT NULL;
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
    IDText = VARCHAR(2);
    ImpactedCardList = ARRAY OF IntegerObject; /*Track impacted cards*/
    NewJobID = INTEGER NOT NULL; /* return variable */
    NMoveID = integer NOT NULL WITH DEFAULT; 
    PromptPhrase = VARCHAR(100) NOT NULL;
    Operator = INTEGER NOT NULL;        /* Operator id */
    Partial = ObjectClass;              /* partial operator (name) */
    ReducedList = ARRAY OF OperatorClass; /* Reduced list of operators */
    RowIdx = INTEGER NOT NULL WITH DEFAULT; 
    Selected = JobInProgress;
    Status = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   ProcessMove = PROCEDURE;
ENDDECLARE
BEGIN

    Selectedop.Description = '';
    Selectedop.Name = '';
    IDText = NULL;
    i = 1;
    k = 0;
    WHILE i <= OperatorList.LastRow() DO
       IF OperatorList[i].Electronic = 0 THEN
          k = k + 1;
          SelectOperator[k] = OperatorList[i].Duplicate();
       ENDIF;         
       i = i + 1;
    ENDWHILE;

    IF NoInsert = TRUE THEN
       Field(InsertCard_Btn).CurBias = FB_Invisible;
    ENDIF;

    CURFRAME.InputFocusField=FIELD(selectedop);

    Field(SelectMove).Title = 'Select Move for Equipment:  ' +
                               SelectEquip.EquipClassName + '  ' +
                               SelectEquip.EquipName;

    CurFrame.SendUserEvent(EventName = 'Load_Jobs');
END;

ON UserEvent 'Load_Jobs' = 
BEGIN 
   SelectMove.Clear();     /* Clear out storage */
   i = 1;

   REPEATED
   SELECT :SelectMove[i].Job = 0,
          :SelectMove[i].JobClass = 0,
          :SelectMove[i].Card = 0,
          :SelectMove[i].TOMove = SP.Name,
          :SelectMove[i].Seq = 0,
          :SelectMove[i].MoveType = '',
          :SelectMove[i].RSMove = '',
          :SelectMove[i].TOMoveRules = 0,
          :SelectMove[i].RSMoveRules = 0,
          :SelectMove[i].StepPair = SP.StepPair,
          :SelectMove[i].MoveEquipClass = 0
   FROM   FMS_StepPair SP
   WHERE  SP.TypeOfCard = :CardDetails.TypeOfCard
   UNION
   SELECT 0, 
          J.JobClass,
          :C.Card,
          J.TOMove,
          JC.Seq,
          J.MoveType,
          J.RSMove,
          J.TOMoveRules,
          J.RSMoveRules,
          JC.StepPair,
          JC.EquipClass
   FROM   FMS_JobClass J, 
          FMS_JobClassControl JC
   WHERE  J.JobClass = JC.JobClass
   AND    J.TOMoveRules IN (:MoveRule$IC, :MoveRule$IAuto)
   AND    JC.TypeofCard = :CardDetails.TypeofCard
   AND    JC.StepPair <> :StepHeading$WorkPermit 
   AND    JC.StepPair <> :StepHeading$TestPermit 
   AND    JC.EquipClass IN (
                  SELECT SuperType
                  FROM   Udb_ExtendedType 
                  WHERE  Type = :SelectEquip.EquipClass)
   UNION
   SELECT J.Job,
          J.JobClass,
          :C.Card,   
          J.TOMove,
          JCC.Seq,
          J.MoveType,
          J.RSMove,
          J.TOMoveRules,
          J.RSMoveRules,
          JCC.StepPair,
          JCC.EquipClass
    FROM  SOA_Job J,
          FMS_JobClass JC, 
          FMS_JobClassControl JCC,
          FMS_DroppedEquipJobs D
    WHERE   D.Equip = :SelectEquip.Equip
    AND     D.Job = J.Job
    AND     J.JobClass = JC.JobClass
    AND     JC.JobClass = JCC.JobClass 
    AND     JCC.TypeOfCard = :CardDetails.TypeOfCard
    AND     JCC.PreferredStep = 1 
    AND     JCC.EquipClass IN (SELECT SuperType FROM Udb_ExtendedType
                               WHERE  Type = :SelectEquip.EquipClass)
   ORDER BY StepPair, Seq
   BEGIN
      SelectMove[i].TOIssued = NULL;
      SelectMove[i].TOComplete = NULL;
      SelectMove[i].RSIssued = NULL;
      SelectMove[i].RSComplete = NULL;

      IF (SelectMove[i].MoveEquipClass = 0) THEN
            SelectMove[i].MoveEquipClassName = '';
      ELSE
            SELECT  :SelectMove[i].MoveEquipClassName = Name
            FROM    Udb_Type
            WHERE   Type = :SelectMove[i].MoveEquipClass;
      ENDIF;

      IF SelectMove[i].JobClass = 0 THEN
         FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
      ELSE
         /*
         ** We are not going to handle ground move here.  They are Handled in SelectGroundMove screen. 
         */
         k = 0;
         SELECT :k = JA.JobClass
         FROM   FMS_JobAction JA
         WHERE  JA.JobClass = :SelectMove[i].JobClass 
         AND    JA.Status = :Status$Ground			          
         AND    JA.Action IN (:JobAction$Set, :JobAction$Increment)
         AND    JA.TypeofCard = :CardDetails.TypeofCard;

         IF k > 0 THEN
            SelectMove.RemoveRow(RowNumber = i);
            i = i -1;
         ELSEIF SelectMove[i].Job > 0 THEN
            SELECT :SelectMove[i].TOIssued = J.TOIssued,
                   :SelectMove[i].TOComplete = J.TOComplete,
                   :SelectMove[i].RSIssued = J.RSIssued,
                   :SelectMove[i].RSComplete = J.RSComplete
            FROM   SOA_Job J
            WHERE  J.Job = :SelectMove[i].Job;
         ENDIF;
      ENDIF;
      i = i + 1;
   END;  

   FOR i = 1 TO SelectMove.LastRow DO
      IF SelectMove[i].JobClass = 0 THEN
         CONTINUE;
      ENDIF;

      IF SelectMove[i].TOMoveRules = MoveRule$None THEN
         SelectMove[i].TOIssued = '';
         SelectMove[i].TOComplete = '';
         FIELD(SelectMove[i].TOIssued).BGColor = CC_PALE_GRAY;
         FIELD(SelectMove[i].TOComplete).BGColor = CC_PALE_GRAY;

      ELSEIF SelectMove[i].TOMoveRules = MoveRule$Issue THEN
         SelectMove[i].TOComplete = '';
         SelectMove[i].RSIssued = '';
         FIELD(SelectMove[i].TOComplete).BGColor = CC_PALE_GRAY;
         FIELD(SelectMove[i].RSIssued).BGColor = CC_PALE_GRAY;
      ENDIF;

      IF SelectMove[i].RSMoveRules = MoveRule$None THEN
         SelectMove[i].RSIssued = '';
         SelectMove[i].RSComplete = '';
         FIELD(SelectMove[i].RSIssued).BGColor = CC_PALE_GRAY;
         FIELD(SelectMove[i].RSComplete).BGColor = CC_PALE_GRAY;
      ENDIF;
   ENDFOR;
END;

/*
**  Handle a job class selection from the list
*/
ON ChildEntry SelectMove[*].TOIssued,
ON ChildEntry SelectMove[*].TOComplete,
ON ChildEntry SelectMove[*].TOMove =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;
/*
**  Make sure an operator has been selected.
*/
    FO.Object = Selectedop.Object;
    IF (FO.Object <= 0) THEN
        Message 'You must select an operator from the list.';
        RESUME;
    ENDIF;

    i = FIELD(SelectMove).CurRow;

       IF FIELD(SelectMove[i].TOIssued).IsReverse = TRUE THEN
             FIELD(SelectMove[i].TOIssued).IsReverse = FALSE;
             FIELD(SelectMove[i].TOComplete).IsReverse = FALSE;
       ELSE
             FIELD(SelectMove[i].TOIssued).IsReverse = TRUE;
             FIELD(SelectMove[i].TOComplete).IsReverse = TRUE;
       ENDIF;

       FIELD(InsertCard_Btn).CurBias = FB_LANDABLE;
/*       FIELD(OK_Btn).CurBias = FB_LANDABLE; */
END;



/*  Handle operator selection
*/

ON ChildEntry SelectOperator =
BEGIN
    Selectedop.Object = SelectOperator[].Object;
    Selectedop.Name = SelectOperator[].Name;
    Selectedop.Description = SelectOperator[].Description;
END;

/* select operator acording to operator number 
*/
ON SetValue Selectedop.Name =
BEGIN
/*
**  Pick out everyone on the list with a similar "ctrl number"
*/
        Partial.Name  = Trim(Lowercase(Selectedop.Name)) + '%';
        Selectedop.Description  = '';
        Selectedop.Object = -1;
        ReducedList.Clear();
        RowIdx = 0;

        i = 1;
        WHILE i <= OperatorList.LastRow() DO
            IF (Lowercase(OperatorList[i].Name) LIKE Partial.name) THEN
                RowIdx = RowIdx + 1;
                ReducedList[RowIdx] = OperatorList[i];
            ENDIF;
            i = i + 1;
        ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
    IF (RowIdx > 0) THEN
        SelectOperator = ReducedList;
    ENDIF;
/*
**  If there is only one in the list, make it the default
*/
    IF (RowIdx = 1) THEN
        Selectedop.Object  = SelectOperator[1].Object;
        Selectedop.Name = SelectOperator[1].Name;
        Selectedop.Description  = SelectOperator[1].Description;
    ENDIF;
END;
/*
**  Handle operator selection by partial name
*/
ON CLICK Find_Btn  =
BEGIN
/*
**  Pick out everyone on the list with a similar name
*/
    Partial.Description  = Trim(Lowercase(Selectedop.Description)) + '%';
    Selectedop.Name  = '';
    Selectedop.Object = -1;
    ReducedList.Clear();
    RowIdx = 0;
        
    i = 1;
    WHILE i <= OperatorList.LastRow() DO
        IF (Lowercase(OperatorList[i].Description) LIKE Partial.Description) THEN
            RowIdx = RowIdx + 1;
            ReducedList[RowIdx] = OperatorList[i];
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
    IF (RowIdx > 0) THEN
        SelectOperator = ReducedList;
    ENDIF;
/*
**  If there is only one in the list, make it the default
*/
    IF (RowIdx = 1) THEN
        Selectedop.Object  = SelectOperator[1].Object;
        Selectedop.Name = SelectOperator[1].Name;
        Selectedop.Description  = SelectOperator[1].Description;
    ENDIF;
END;

ON Click Cancel_Btn =
BEGIN
    RETURN (PU_CANCEL);
END;

ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

ON Click InsertCard_Btn,
ON Click OK_Btn =
DECLARE
   j = INTEGER NOT NULL WITH DEFAULT;
   WithInsert = INTEGER NOT NULL WITH DEFAULT; 
BEGIN
   IF CurFrame.TriggerField = Field(InsertCard_Btn) THEN
      WithInsert = TRUE;
   ELSE 
      WithInsert = FALSE;
   ENDIF;

   FOR j = 1 TO SelectMove.LastRow() DO
      IF FIELD(SelectMove[j].ToIssued).IsReverse = TRUE THEN
         Selected = SelectMove[j].Duplicate();
       /*
       **  Set up tomove after copying SelectMove -> Selected so that TOMove
       **  doesn't get multiple description fields.
       */
         Selected.Equip = SelectEquip.Equip;
         Selected.EquipName = SelectEquip.EquipName;
         Selected.EquipClass = SelectEquip.EquipClass;
         Selected.EquipClassName = SelectEquip.EquipClassName;
         Selected.TOMove = 
           SQUEEZE(SelectEquip.Description + ' ' + SelectMove[j].TOMove);
         Selected.RSMove = 
           SQUEEZE(SelectEquip.Description + ' ' + SelectMove[j].RSMove);
         CALLPROC ProcessMove (WithInsert = WithInsert);         
      ENDIF;
   ENDFOR;
   RETURN PU_OK;
END;

PROCEDURE ProcessMove (
   WithInsert = INTEGER NOT NULL WITH DEFAULT
) =
BEGIN
   IF Selected.JobClass = 0 THEN
       Message 'You have not selected a move.';
       RESUME;
   ENDIF;
/*
**  Group job insertions/update in one transaction.
*/
   Selected.ControlCard = C.Card;
   Selected.Status = '';
   IF Selected.Job > 0 THEN
      NewJobID = Selected.Job;
   ELSE
      NewJobID = Selected.InsertJob (Card = 0);
      IF NewJobID < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'Unable to save selected move,  try again.',
             TraceMessage = 'RecordEquipMove; Unable to save selected move'
             );
         RESUME;
      ENDIF;
   ENDIF;
/*
** Issue and complete this move.
*/
   Selected.Job = NewJobID;

   IF Selected.TOIssued IS NULL THEN
/*
** Jigger status to properly invoke procedure. We are allowing TakeOut only.
*/ 
   Selected.Status = Job$TakeOut; 

   RetCode = Selected.IssueMove(Job = Selected);
   IF RetCode = PU_CANCEL THEN
      CALLPROC TraceError (UserMessage = 
             'Unable to issue selected move,  try again.',
             TraceMessage = 'RecordEquipMove; Unable to issue selected move'
             );
      RESUME;
   ENDIF;

   RetCode = Selected.JobActions(IssueCompl = JobClass$Issue,
                               NoCard = TRUE,
                               NoOperSt  = TRUE,
                               NoLineSt  = TRUE,
                               NoFeederSt = TRUE); 

   IF RetCode = PU_CANCEL THEN
      RetCode = Selected.CancelIssueMove(Job = Selected);
      IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage = 
             'Job action failed. Unable to incomplete move. Please update the move manually',
             TraceMessage = 'RecordEquipMove; Job action failed. Unable to incomplete move. ' + 
             'Manually delete move = ' + VARCHAR(Selected.Job)
             );
         RESUME;
      ENDIF;
   ENDIF;
/*
**  complete the job.
*/
   RetCode = Selected.CompleteMove(Job = Selected);
   IF RetCode = PU_CANCEL THEN
      CALLPROC TraceError (UserMessage = 
             'AutoComplete failed, please manually complete the move.',
                           TraceMessage =
             'RecordEquipMove; ' +
             'AutoComplete failed, manually delete move=' +
             VARCHAR(Selected.Job) + '.' 
             );
      RESUME;
   ENDIF;
              
   RetCode = Selected.JobActions(IssueCompl = JobClass$Complete,
                               NoCard = TRUE,
                               NoOperSt  = TRUE,
                               NoLineSt  = TRUE,
                               NoFeederSt = TRUE); 
   IF RetCode = PU_CANCEL THEN         
      RetCode = Selected.InCompleteMove(Job = Selected);
          
      IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (UserMessage = 
             'InComplete failed, please manually incomplete the move.',
                           TraceMessage =
             'RecordEquipMove; ' +
             'InComplete failed, manually incomplete move=' +
             VARCHAR(Selected.Job) + '.' 
             );
      ENDIF;
      RESUME;
   ENDIF;

   IF Selected.Status = Job$TakeOut THEN
      RetCode = CALLPROC SOA_LogIns (
                    Card            = C.Card
                  , Job             = null
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'Job Bank TakeOut'
                  , Old             = '(' + Selected.EquipClassName + ' ' + Selected.EquipName + ') ' + Selected.TOMove
                  , New             = 'Issued and completed by ' + SelectedOp.Description
                  );
   ELSE
      RetCode = CALLPROC SOA_LogIns (
                    Card            = C.Card
                  , Job             = null
                  , SwitchingItem   = 0
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'Job Bank Restore'
                  , Old             = '(' + Selected.EquipClassName + ' ' + Selected.EquipName + ') ' + Selected.RSMove
                  , New             = 'Issued and completed by ' + SelectedOp.Description
                  ); 
   ENDIF;
   CALLPROC DDB_COMMIT;

   ENDIF;  /*End of Move Processing if not already issued */

   IF Selected.TOComplete IS NOT NULL AND 
         (Selected.RSComplete IS NOT NULL AND Selected.RSComplete <> '') THEN
      /*
      ** the move is TO and RS completed, remove it from the drop bank
      */
      RetCode = CALLPROC FMS_DroppedEquipJobsDel(
                                  Job = Selected.Job);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to delete move for equipment: ' +
                        SelectEquip.EquipClassName + '  ' +
                        SelectEquip.EquipName + ' from job bank.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
      RETURN;
   ELSE
      /* insert the move into the job bank */
      RetCode = CALLPROC FMS_DroppedEquipJobsIns
                            (Job   = NewJobID,
                             Equip = SelectEquip.Equip);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         message 'Unable to save selected move in job bank,  try again.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;                                               
/*
** If D.O. wants to insert this move as an N move to the current card.
*/    
   IF WithInsert = TRUE THEN
       PromptPhrase = 'Please enter ID for Equipment:  ' +
                       SelectEquip.EquipClassName + '  ' + 
                       SelectEquip.EquipName;
   
       IF IDText IS NULL THEN
          IDText = CALLFRAME GenericEntry ( 
                PromptPhrase = PromptPhrase,
                PhraseLength = 2);
   
          IF IDText IS NULL THEN
/* 
**  If they hit cancel,  close frame and if they don't want the ground 
**  move they selected they can hit the ground button again which will
**  delete the job they inserted into FMS_Job and FMS_DroppedEquipJobs
**  above.
*/
             RETURN ;
          ENDIF;
       ENDIF;
/*
**   Keep track if they already entered a printid for a piece of equipment.
*/
       SelectEquip.PrintID = IFNULL(IDText,'');

       Selected.PrintID = IFNULL(IDText,'');
       Selected.GroundOn = NULL;
       Selected.MoveCategory = MoveCategory$Fake;  /* SOA_JobIns will blank out TO/RS Issue/Complete Times */
       Selected.TOMoveRules = -1;  /* don't let move rules affect move*/
       Selected.RSMoveRules = -1;
       Selected.ActivityIdentifier = 'N';
       Selected.Status = '';
    
       RetCode = CALLPROC InsertJobsRow
                (C = C, 
                 NewJob = Selected, 
                 SingleCardInsertion = TRUE,
                 ImpactedCardList = ByRef(ImpactedCardList));
       IF RetCode IS NULL THEN
          CALLPROC DDB_ROLLBACK;
          message 'Could not insert move:  ' + '''' + Selected.TOMove + '''' +
                  HC_NEWLINE + '  into current card.  Please try again.';
          RESUME;
       ELSE
          CALLPROC DDB_COMMIT;
          Selected.Job = RetCode;

          /* update the Takeout time stamps and response column 
          */
          RetCode = CALLPROC SOA_JobTimeUpd (
                            Job = Selected.Job,
                            Response = 'TakeOut Completed',
                            TOIssued = Selected.TOIssued,
                            TOComplete = Selected.TOComplete,
                            RSIssued = Selected.RSIssued,
                            RSComplete = Selected.RSComplete);
          CALLPROC DDB_COMMIT;
          DropBankJobs.InsertRow (rownumber = 1, 
                                  rowobject = Selected.Duplicate());

#         include NotifyImpactedCards
          FCFrame.SendUserEvent (EventName = 'load_jobs');  
       ENDIF;
   ENDIF;

   RETURN;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            ScenarioHistory


Application Component Report
============================

	Name:            ScenarioTrace

/*
**
**	Copyright c 2000 ALSTOM ESCA.  All rights reserved.
**
**	ALSTOM ESCA proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified ALSTOM ESCA.
**
*/
/*
**  Application:    CAC
**  Procedure:      ScenarioTrace
**
**  Modifications:
**  10/13/00    em  Created. See ISO9000 design note for documentation.
**                  OutBoundBreakerFound field of ConnectedEquipClass will
**                  be used to hold information pertaining to whether a 
**                  De-Energizing Breaker has been found on this path.
**  11/14/00    em  Modified Bus Section scenario trace.  If leaving substation
**                  (without having found the outboard disconnect), we present
**                  a message indicating that the trace is incomplete, but
**                  include equipment up to this point and let the trace 
**                  complete in other directions.
**  11/28/00    em  Added PrimaryGrouping to messages.
**  12/12/00    em  For OutBoard Disconnect trace, we need to keep track of
**                  OutBoardBreaker Found flag for each device between the
**                  breaker and the disconnect since the two devices do not
**                  necessarily have to be together.
**  12/20/00    my  On an SLC Switching Item, when the Trip Checks or Tap 
**                  Changer Inspection scenario is used, Spare breaker in the 
**                  substation will have moves preload. If the selected spare
**                  breaker is include in the scenario equipment list, the 
**                  equipment type used for the scenario preload will be 
**                  modified to PRIMARY, otherwise it is ALT.
**  12/21/00    em  For Spare Bank selection, use the PrimaryGrouping 
**                  (substation) of the startpoint.  Prevents selection of
**                  multiple spare banks from a Macro station.
**  01/19/01    em  Added Electrical Verification scenario which stops at
**                  Open Device.
**  10/04/02    em  Removed REPEATED SELECT for existence of Equip on Card to
**                  correct run-time error when returning 0 rows.
**  04/01/04    em  Add Bus Tie breaker to Visible Breake Equipment type list
**  06/07/06    em  For Deluge Test scenario, include all equipment up to and 
**                  including DeEnBreaker 
**  10/23/06    em  For Deluge Test scenario, include start point in equipment
**                  list; also include Spare Bank Breaker equipment.
**  01/07/08	em  For Bus Section scenario, include inboard disconnect if it 
**                  is a two-position switch, Type$DiscGrdBkr 
**                  On SLC Trip Checks scenario when Bus Section is selected
**                  as startpoint do not include Spare Bank Equipment  
**  01/08/08    em  Extend prior inclusion of inboard disconnect to Scenarios
**                  Deluge Test, Tap Changer Inspection, and Trip Checks
**                  On Tap Changer Inspection, extend to outboard disconnect
**                  when disconnect is a two position switch, Type$DiscGrdBkr.  
**  05/09/08   ysp  SLC55: Add Group Disconnect trace to find source breakers.
**  03/11/15    em  Add Bkr-R/O/ARS to VisibleBreakTypeList list
**  02/06/17    em  If collecting an InterSSConn on SLC for certain scenarios,
**                  then also include equipment grouped with the InterSSConn
**                  using grouping membertype.
**  04/20/17   ysp  Moved to CAC. Converted to QGis-based connectivity trace
*/
PROCEDURE ScenarioTrace
(
   Card       = INTEGER NOT NULL;     /* Passed Card, used to control scope */
   StartPoint = INTEGER NOT NULL;     /* Passed Trace StartPoint */
   StopPoint  = VARCHAR(24) NOT NULL; /* Passed Trace Stop Point */
   Scenario   = INTEGER NOT NULL;     /* Passed Scenario - if Bus Section */
/*
** Possible StopPoint values and their meanings are:
**    DeEnBreaker  - we are just looking for de-energizing breakers, do not
**                   collect equip traversed list, just the breakers.
**    VisibleBreak - stop trace at first visible break, collect equipment.
**    OutboardDisc - stop trace at outboard disconnect, collect equipment, but
**                   exclude inboard disconnect from equipment list.
*/
   CollectedEquip = ARRAY OF ConnectedEquipClass;  /*Return Equip List*/
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;                            
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;                            

   BreakerTypeList = ARRAY OF INTEGEROBJECT;  /*Valid de-en brkr types*/
   DeEnBreakerType = INTEGER NOT NULL;     /*Based on type of card*/
   InterSSConnEquip = ARRAY OF ConnectedEquipClass;  /*equip related to InterSSConn*/
   RetCode = INTEGER NOT NULL;                     /*return variable */
   SubType = INTEGER NOT NULL;
   SpareBreakers = ARRAY OF ConnectedEquipClass;  /* Selected Spare Breakers */          
   StartEquip = ConnectedEquipClass;               /*Start Object*/
   ScopeObjectList = ARRAY OF INTEGEROBJECT;
   SourceBreakTypeList = ARRAY OF INTEGEROBJECT; /* Source breaker types*/
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   TypeFound = INTEGER NOT NULL WITH DEFAULT;      /*BOOLEAN*/
   VisibleBreakTypeList = ARRAY OF INTEGEROBJECT; /*Valid visible break types*/
   
   Trace = Trace_ScenarioBuilder DEFAULT NULL;
ENDDECLARE
BEGIN
   CollectedEquip.Clear();

   SELECT  :StartEquip.Object = O.Object,
           :StartEquip.Type = O.Type,
           :StartEquip.Name = O.Name,
           :StartEquip.PrimaryGrouping = O.PrimaryGrouping,
           :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
   FROM    Udb_Object O
   WHERE   O.Object = :StartPoint;

   IF iirowcount <= 0 THEN
      Message 'Did not find Start Point Object.';
      RETURN PU_CANCEL;
   ENDIF;

   IF CurrentApplication = Application$TFMS THEN
      DeEnBreakerType = Type$BREAKER;
 
   ELSEIF CurrentApplication = Application$SLC THEN
      DeEnBreakerType = Type$LoadBreaking;

   ELSE
      Message 'Not a valid type of card for a scenario trace.';
      RETURN PU_CANCEL;
   ENDIF;
/*
** If we are collecting equipment, let's include the start point now.
*/
   IF StopPoint <> 'DeEnBreaker' OR Scenario = Scenario$DelugeTest THEN  
      CollectedEquip[1] = StartEquip.Duplicate();
   ENDIF;
/*
** Load our search arrays.
*/
   i = 1;
   BreakerTypeList.Clear();
   REPEATED
   SELECT :BreakerTypeList[i].Value = Type
   FROM   Udb_ExtendedType
   WHERE  SuperType = :DeEnBreakerType
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;

   i = 1;
   VisibleBreakTypeList.Clear();
   REPEATED
   SELECT
   DISTINCT :VisibleBreakTypeList[i].Value = Type
   FROM   Udb_ExtendedType
   WHERE  SuperType IN 
          (:Type$Disconnect,:Type$CktSwer,:Type$BkrRO,:Type$BkrROARS,:Type$BkrROspare,:Type$BusTie)  
   BEGIN
      i = i + 1;
   END;

   i = 1;
   SourceBreakTypeList.Clear();
   REPEATED
   SELECT
   DISTINCT :SourceBreakTypeList[i].Value = Type
   FROM   Udb_ExtendedType
   WHERE  SuperType = :Type$Source  
   BEGIN
      i = i + 1;
   END;
   
   IF CurrentApplication = Application$TFMS THEN
      i = 1;
      SELECT   :ScopeObjectList[i].Value = G.Member
      FROM     TFMS_CardToObject CTO,
               Udb_Grouping G
      WHERE    G.Relationship = :Interaction$MemberOf AND
               G.Grouping = CTO.Object AND
               CTO.Type = :Type$Line AND
               CTO.Card = :Card
      BEGIN
         i = i + 1;
      END;
   ELSE  
      i = 1;
      SELECT   :ScopeObjectList[i].Value = G.Member
      FROM     SOA_ActiveObject AO,
               Udb_Grouping G
      WHERE    G.Relationship = :Interaction$MemberOf AND
               G.Grouping = AO.Object AND
               AO.Card = :Card
      BEGIN
         i = i + 1;
      END;
   ENDIF;

/* 
**  Algorithm (see documentation):  
**     1) Check for card scope
**     1B) Bus Section Trace scope check
**     2) Collecting Equip?
**     3) De-En Breaker? Include equipment up to De-En Breaker for Deluge Test
**     4) Visible Break?
**     5) Add to collection if appropriate
**     6) Check for stop point
*/
   Trace = Trace_ScenarioBuilder.Create();
   Trace.Scenario = Scenario;
   Trace.ScenarioStartPoint = StartPoint;
   Trace.ScenarioStopPoint = StopPoint;
   Trace.Application = CurrentApplication;
   
   Trace.BreakerTypeList = BreakerTypeList;
   Trace.VisibleBreakTypeList = VisibleBreakTypeList;
   Trace.SourceBreakTypeList = SourceBreakTypeList;
   Trace.ScopeObjectList = ScopeObjectList;
   
   TraceStatus = Trace.StartScenarioTrace();
   
   IF Trace.ReturnCode <> 0 THEN
      Message 'Scenario connectivity trace found a problem: ' + HC_NEWLINE + 
              Trace.ErrorMessage;
      RETURN(PU_CANCEL);
   ENDIF;   

   IF TraceStatus = TraceStatus$Error THEN
      RETURN(PU_CANCEL);
   ENDIF;
   
   /*
   ** convert and merge collected equipment
   */
   FOR i = 1 TO Trace.CollectedEquip.LastRow DO
      k  = CollectedEquip.LastRow + 1;
      CollectedEquip[k] = ConnectedEquipClass.Create();
      CollectedEquip[k].Object = Trace.CollectedEquip[i].Object;
      CollectedEquip[k].Type = Trace.CollectedEquip[i].Type;      
      CollectedEquip[k].Name = Trace.CollectedEquip[i].Name;
      CollectedEquip[k].PrimaryGrouping = Trace.CollectedEquip[i].PrimaryGrouping;
      CollectedEquip[k].PrimaryGroupingName = Trace.CollectedEquip[i].PrimaryGroupingName;
   ENDFOR;

/*
** On an SLC Switch Item, when the Trip Checks or Tap Changer Inspection
** is used, select the Spare Bank equipment in the substation to preload.
*/
   SpareBreakers.Clear();
   IF (Scenario = Scenario$TripCheck 
        OR Scenario = Scenario$TapChangerInspection 
        OR Scenario = Scenario$DelugeTest) AND 
        NOT (Scenario = Scenario$TripCheck AND
        StartEquip.Type = TypeName$BusSect) AND
        CurrentApplication = Application$SLC THEN
/*
** Make sure start equip is primarygrouped with a substation
*/
      i = 0;
      REPEATED
      SELECT   :i = O.Object
      FROM     Udb_ExtendedType ET,
               Udb_Object O
      WHERE    O.Object = :StartEquip.PrimaryGrouping AND
               O.Type = ET.Type AND
               ET.SuperType = :Type$Substation;
      IF i = 0 THEN
         MESSAGE 'Unable to determine if substation has any Spare Bank ' +
                  'Breaker equipment because selected scenario trace ' +
                  'start point device is not properly Primary Grouped ' +
                  'to a substation.';
      ELSE             
         i = 1;     
         REPEATED
         SELECT
               :SpareBreakers[i].Object = O.object,
               :SpareBreakers[i].Type = O.Type
         FROM Udb_Object O,
              Udb_ExtendedType ET,
              Udb_Grouping G
         WHERE G.Grouping = :StartEquip.PrimaryGrouping AND
               G.Relationship = :Interaction$MemberOf AND
               O.Object = G.Member AND
               O.Type = ET.Type AND
               ET.Supertype in (:Type$Bkrspare, :Type$BkrROspare)
         BEGIN
            i = i  + 1;
         END;
      ENDIF;
   ENDIF;

   j = 1;
   WHILE j <= SpareBreakers.LastRow() DO
      i = 1;
      WHILE i <= CollectedEquip.LastRow() DO
         IF SpareBreakers[j].Object = CollectedEquip[i].Object THEN
            SubType = 0;
            REPEATED
            SELECT 
                  :SubType = T.Type
            FROM Udb_type T,
                 Udb_Supertype ST
            WHERE ST.SuperType = :SpareBreakers[j].Type AND
                  ST.Type = T.Type AND
                  UPPERCASE(T.Name) LIKE '%PRI%';
            IF SubType <> 0 THEN
               CollectedEquip[i].Type = SubType;
            ENDIF;
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;
            
      IF i > CollectedEquip.LastRow() THEN
         SubType = 0;
         REPEATED
         SELECT 
               :SubType = T.Type
         FROM Udb_type T,
              Udb_Supertype ST
         WHERE ST.SuperType = :SpareBreakers[j].Type AND
               ST.Type = T.Type AND
               UPPERCASE(T.Name) LIKE '%ALT%';
         IF SubType <> 0 THEN
            SpareBreakers[j].Type = SubType;
         ENDIF;
         
         CollectedEquip.InsertRow(RowNumber = i,
                        RowObject = SpareBreakers[j].Duplicate());                                       
          
      ENDIF;
      j = j + 1; 
   ENDWHILE;

/*
** Add equipment related to InterSSConn for certain SLC scenarios
*/
   IF (Scenario = Scenario$TripCheck OR
       Scenario = Scenario$TapChangerInspection OR 
       Scenario = Scenario$BusSectionWork) AND 
       CurrentApplication = Application$SLC THEN

      j = 1;
      WHILE j <= CollectedEquip.LastRow() DO

         IF CollectedEquip[j].Type = Type$InterSSConn THEN

            InterSSConnEquip.Clear();
            i = 1;
            SELECT   :InterSSConnEquip[i].Object = Member,
                     :InterSSConnEquip[i].Type = MemberType
            FROM     Udb_Grouping 
            WHERE    Grouping = :CollectedEquip[j].Object AND
                     Relationship = :Interaction$MemberOf 
            BEGIN
               i = i + 1;
            END;

            FOR i = 1 TO InterSSConnEquip.LastRow DO
               RetCode = CollectedEquip.Find(AttributeName = 'object',
                                          Value = InterSSConnEquip[i].Object);
               IF RetCode = ER_ROWNOTFOUND THEN              
                  k  = CollectedEquip.LastRow + 1;
                  CollectedEquip.InsertRow(RowNumber = k,
                           RowObject = InterSSConnEquip[i].Duplicate());

               ENDIF;
            ENDFOR;
         ENDIF;
         j = j + 1;
      ENDWHILE;
   ENDIF;
    
   RETURN(PU_OK);
END;  

