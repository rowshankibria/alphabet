============================

	Name:            Check101InServFromMacro

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          Check101InServFromMacro         
**
**  Modifications:
**  09/19/02   em   Created to handle load-side ATS moves performed on 
**                  the ATS Macro device (the ATS Superstructure), presenting a
**                  warning if the 101 Feeder is not in service. 
**  11/15/02   ysp  Merge: removed Jobs and C from passed-in.
**  02/13/04   em   Replace messages with TraceError calls
*/
PROCEDURE Check101InServFromMacro 
(
    JIP = JobInProgress;			  /* parameter - Job being processed */
    i = INTEGER;              /* index */ 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    ATS = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
    ATS101Feeder = INTEGER NOT NULL;
    AlreadyOpen = INTEGER NOT NULL WITH DEFAULT;  /* Select Value */
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device.
**  Then find its related ATS101 device.
*/ 
   ATS.Object = 0;
   REPEATED
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Check101InServFromMacro:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS Grouper device is not setup properly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
         RETURN(PU_CANCEL);
      ELSE
         RETURN(NULL);
      ENDIF;
   ENDIF;

   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Check101InServFromMacro:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS Grouper device is not setup properly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
         RETURN(PU_CANCEL);
      ELSE
         RETURN(NULL);
      ENDIF;
   ENDIF;
/*
** ATS 101 device is found, now get the 101 feeder.
*/   
   ATS101Feeder = 0;
   REPEATED 
   SELECT  :ATS101Feeder = G1.Grouping
   FROM    Udb_Grouping G1,
           Udb_Grouping G2
   WHERE   G1.Member = :ATS101.Object AND
           G1.Relationship = :Interaction$MemberOf AND
           G1.Grouping = G2.Grouping AND
           G2.Member = :ATS.Object AND
           G2.Relationship = :Interaction$MemberOf AND
           G1.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE  SuperType = :Type$Feeder);

   IF ATS101Feeder = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS feeder for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Check101InServFromMacro:  ATS setup problem. ' +
               'Unable to find ATS feeder for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS Grouper device is not setup properly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
         RETURN(PU_CANCEL);
      ELSE
         RETURN(NULL);
      ENDIF;
   ENDIF;
            
   AlreadyOpen = 0;
   SELECT  :AlreadyOpen = Status
   FROM    FMS_ObjectStatus
   WHERE   Object = :ATS101Feeder AND
           Status = :Status$CO;

   IF AlreadyOpen <> 0 THEN   

        WarningStatus = CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS 101 Feeder is not in Service.'
                    ); 
        IF (WarningStatus = PU_CANCEL) THEN
            RETURN(PU_CANCEL);
        ELSE
            RETURN(Warning$Overridden);
        ENDIF;
   ENDIF;
   RETURN(NULL);
END; 

