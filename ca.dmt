	Name:            ViewMoves

/*
**
**  Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          ViewMoves
**
**  Modification log:
**
**   03/10/95   pkw   Created
**   07/25/02   ysp   Merge: Remove passed-in Job array. Rename job attributes 
**                    (MoveOrigin, TOStep, g). 
**   08/28/02   ysp   Merge: use SOA Job table to load jobs.
**   01/16/03   em    Correct Testing errors.
**   02/04/03   em    Adjustment to selection of moves to try to get step 
**                    heading in the right place.
**   02/13/03   em    Don't pass ActivityIdentifier to InsertJobsRow
**   11/11/03   ysp   FMS307: 1) allow to restore ground moves. Changed the
**                    job select statement so that TOMove/RSMove are loaded
**                    from soa_job table. 2) Check if the same 'N' move already 
**                    exists in the card, if so, no insertion is allowed.
**   03/17/04  ysp    change the button text to Remove Ground
**   03/11/05  ysp    when process the Remove Ground button, check if there is 
**                    an N move in any card. If there is, we will issue/complete 
**                    the restore side. If no, we will delete the ground jobs.
**   03/14/05  em     update fake move with Timestamps.
**   09/01/05  ysp    After a ground move's restore, remove it from the new/drop bank.
**   12/14/05  ysp    increase the size of tomove to 160 chars
**   06/04/07  ysp    FMS 363: Support restore of moves in drop/new bank.
**   10/20/15  em     Add inserted move to DropBankJobs array for pass back to Permit Links.
**   03/03/16  em     Consolidate Restore Move/Remove Ground; add capability to edit timestamp
**   03/04/16  em     This frame gets called by SelectNDModifyDB where there is no Card loaded.
**                    Not loading any data because CardDetails is empty, need an alternate select
**                    for this condition.
**   03/24/16  em     Establish SelectMove.Card value
**   04/07/16  em     Edit timestamp not properly cascading to N move, expecting N move on only 
**                    one card.  Why would user want to put N move on more than one card, the 
**                    equipment can be picked up only once?
**   04/19/16  em     Don't add Description field when inserting N move, should already by on move.
**   05/23/16  em     Communicate closure back to parent frame
**                    
*/
INITIALIZE   
(
    C = FMS_Card;                /* Passed Card */
    
    i = integer;            /* Temporary counter */
    k = INTEGER;
    J = ARRAY OF Job;  
    Description = VARCHAR(40) NOT NULL;
    EditTimeStamp = INTEGER NOT NULL WITH DEFAULT;
    Equip = INTEGER NOT NULL;
    EquipName = VARCHAR(20) NOT NULL;
    EquipClassName = VARCHAR(20) NOT NULL;
    FakedJob = INTEGER NOT NULL WITH DEFAULT;
    IDText = VARCHAR(2);
    JIP = JobInProgress;
    MoveInserted = INTEGER NOT NULL WITH DEFAULT;
    OldJob = Job;
    ParentFrame = FrameExec;
    PromptPhrase = VARCHAR(100) NOT NULL;
    RetCode = INTEGER;  /*Nullable return code*/
    SMove = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    EditTimeStamp = FALSE;
    CurFrame.WindowVisibility = WV_Invisible;
END;

ON UserEvent 'load_moves' = 
BEGIN
    MoveInserted = FALSE; /* initialize */
    Equip = CurFrame.MessageInteger;
    IF C.Card = 0 THEN
       FIELD(ok_btn).CurBias = FB_INVISIBLE;
    ENDIF;
  
    REPEATED
    SELECT :EquipName = O.Name,
           :EquipClassName = O.TypeName,
           :Description = O.Description
    FROM   Udb_Object O
    WHERE  O.Object = :Equip;
    CALLPROC DDB_ROLLBACK;

    Field(SelectMove).Title = 'Moves Associated with Equipment:  ' +
                               EquipClassName + '  ' + EquipName;
                             
    SelectMove.Clear();     /* Clear out storage */
    i = 1;
    IF C.Card > 0 THEN
    REPEATED
    SELECT  :SelectMove[i].Job = 0,
            :SelectMove[i].JobClass = 0,
            :SelectMove[i].Card = 0,
            :SelectMove[i].Equip = 0,
            :SelectMove[i].EquipName = '',
            :SelectMove[i].EquipClass = 0,
            :SelectMove[i].EquipClassName = '',
            :SelectMove[i].TOMove = SP.Name,
            :SelectMove[i].TOOperator = NULL,
            :SelectMove[i].TOIssued = NULL,
            :SelectMove[i].TOComplete = NULL,
            :SelectMove[i].RSIssued = NULL,
            :SelectMove[i].RSComplete = NULL,
            :SelectMove[i].RSOperator = NULL,
            :SelectMove[i].MoveType = '',
            :SelectMove[i].RSMove = '',
            :SelectMove[i].TOMoveRules = 0,
            :SelectMove[i].RSMoveRules = 0,
            :SelectMove[i].Grounds = NULL,
            :SelectMove[i].GroundOn = NULL,
            :SelectMove[i].MoveFGColor = 0,
            :SelectMove[i].StepPair = StepPair,
            :SelectMove[i].Response = '',
            :SelectMove[i].MoveEquipClass = 0
    FROM    FMS_StepPair SP
    WHERE   SP.TypeOfCard = :C.TypeOfCard
    UNION
    SELECT  J.Job,
            J.JobClass,
            0,   
           :Equip,
            J.EquipName,
            J.EquipClass,  
            J.EquipClassName,  
            J.TOMove,
            J.TOOperator,
            J.TOIssued,
            J.TOComplete,
            J.RSIssued,
            J.RSComplete,
            J.RSOperator,
            J.MoveType,
            J.RSMove,
            J.TOMoveRules,
            J.RSMoveRules,
            J.Grounds,
            J.GroundOn,
            J.MoveFGColor,
            JCC.StepPair,
            J.Response,
            JCC.EquipClass
    FROM    SOA_Job J,
            FMS_JobClass JC, 
            FMS_JobClassControl JCC,
            FMS_DroppedEquipJobs D
    WHERE   D.Equip = :Equip
    AND     D.Job = J.Job
    AND     J.JobClass = JC.JobClass
    AND     JC.JobClass = JCC.JobClass 
    AND     JCC.TypeOfCard = :C.TypeofCard
    AND     JCC.PreferredStep = 1 
    AND     JCC.EquipClass IN (SELECT SuperType FROM Udb_ExtendedType
                               WHERE  Type = J.EquipClass)
    ORDER BY StepPair, JobClass
    BEGIN
        IF SelectMove[i].JobClass = 0 THEN
           FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
        ENDIF;

        IF SelectMove[i].TOIssued = '' THEN
           FIELD(SelectMove[i].TOIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].TOComplete = '' THEN
           FIELD(SelectMove[i].TOComplete).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].RSIssued = '' THEN
           FIELD(SelectMove[i].RSIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].RSComplete = '' THEN
           FIELD(SelectMove[i].RSComplete).BgColor = CC_PALE_GRAY;
        ENDIF;

        i = i + 1;
    END;

    ELSE

    SELECT  :SelectMove[i].Job = J.Job,
            :SelectMove[i].JobClass = J.JobClass,
            :SelectMove[i].Card = 0,
            :SelectMove[i].Equip = J.Equip,
            :SelectMove[i].EquipName = J.EquipName,
            :SelectMove[i].EquipClass = J.EquipClass,
            :SelectMove[i].EquipClassName = J.EquipClassName,
            :SelectMove[i].TOMove = J.TOMove,
            :SelectMove[i].TOOperator = J.TOOperator,
            :SelectMove[i].TOIssued = J.TOIssued,
            :SelectMove[i].TOComplete = J.TOComplete,
            :SelectMove[i].RSIssued = J.RSIssued,
            :SelectMove[i].RSComplete = J.RSComplete,
            :SelectMove[i].RSOperator = J.RSOperator,
            :SelectMove[i].MoveType = J.MoveType,
            :SelectMove[i].RSMove = J.RSMove,
            :SelectMove[i].TOMoveRules = J.TOMoveRules,
            :SelectMove[i].RSMoveRules = J.RSMoveRules,
            :SelectMove[i].Grounds = J.Grounds,
            :SelectMove[i].GroundOn = J.GroundOn,
            :SelectMove[i].MoveFGColor = J.MoveFGColor,
            :SelectMove[i].Response = J.Response
    FROM    SOA_Job J,
            FMS_DroppedEquipJobs D
    WHERE   D.Equip = :Equip
    AND     D.Job = J.Job
    ORDER BY JobClass
    BEGIN
        IF SelectMove[i].JobClass = 0 THEN
           FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
        ENDIF;

        IF SelectMove[i].TOIssued = '' THEN
           FIELD(SelectMove[i].TOIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].TOComplete = '' THEN
           FIELD(SelectMove[i].TOComplete).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].RSIssued = '' THEN
           FIELD(SelectMove[i].RSIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF SelectMove[i].RSComplete = '' THEN
           FIELD(SelectMove[i].RSComplete).BgColor = CC_PALE_GRAY;
        ENDIF;
/*
** Get one MoveEquipClass just in case they try restoring the move
*/
        SELECT
            :SelectMove[i].StepPair = JCC.StepPair,
            :SelectMove[i].MoveEquipClass = JCC.EquipClass
        FROM    FMS_JobClassControl JCC
        WHERE   JCC.JobClass =  :SelectMove[i].JobClass
        AND     JCC.PreferredStep = 1 
        AND     JCC.EquipClass IN (SELECT SuperType FROM Udb_ExtendedType
                               WHERE  Type = :SelectMove[i].EquipClass);

        i = i + 1;
    END;

    ENDIF;
/*
** Make a copy of SelectMove for the purpose of restoring Ground Moves
*/
    J = SelectMove.Duplicate();
    FIELD(Restore_Btn).CurBias = FB_DIMMED;

    CALLPROC DDB_ROLLBACK;
    CurFrame.WindowVisibility = WV_Visible;
    CurFrame.BringToFront();
END;

ON ChildEntry SelectMove[*].TOMove =
BEGIN
   k = FIELD(SelectMove).CurRow;

   IF SelectMove[k].JobClass <> 0 THEN
       IF FIELD(SelectMove[k].TOMove).IsReverse = FALSE THEN 
       
          /*
          **  check to see if an "N" move already exists in the card
          */
          i = 0;
          SELECT :i = J.Job
          FROM   SOA_JobControl JC,
                 SOA_Job J
          WHERE  JC.Card = :C.Card 
            AND  JC.Job = J.Job
            AND  J.Status <> 'Del' 
            AND  J.MoveCategory = :MoveCategory$Fake
            AND  J.Equip = :SelectMove[k].Equip
            AND  J.JobClass = :SelectMove[k].JobClass;
          CALLPROC DDB_ROLLBACK; 
          
          IF i = 0 OR C.Card = 0 THEN
             FIELD(SelectMove[k].TOMove).IsReverse = TRUE; 
          ELSE
             MESSAGE 'This move already exists in the card.';
          ENDIF;
       ELSE 
           FIELD(SelectMove[k].TOMove).IsReverse = FALSE; 
       ENDIF;
   ENDIF;

   /* 
   ** disable the restore buttons.
   */
   i = 1;
   WHILE i <= SelectMove.LastRow() DO
      FIELD(SelectMove[i].RSIssued).IsReverse = FALSE;
      FIELD(SelectMove[i].RSComplete).IsReverse = FALSE; 
      i = i + 1;
   ENDWHILE;
   FIELD(Restore_Btn).CurBias = FB_DIMMED;
END;

ON CLICK Timestamp_btn =
BEGIN
   IF EditTimeStamp = FALSE THEN
      EditTimeStamp = TRUE;
   ELSE
      EditTimeStamp = FALSE;
   ENDIF;

   i = 1;
   WHILE i <= SelectMove.LastRow() DO
      IF EditTimeStamp = TRUE AND 
           SelectMove[i].TOIssued IS NOT NULL AND SelectMove[i].TOIssued <> '' THEN            
         FIELD(SelectMove[i].TOIssued).BgColor = CC_CYAN;
      ELSE
         IF FIELD(SelectMove[i].TOIssued).BgColor = CC_CYAN THEN
            FIELD(SelectMove[i].TOIssued).BgColor = CC_PALE_CYAN;
         ENDIF;
      ENDIF;
      IF EditTimeStamp = TRUE AND 
           SelectMove[i].RSIssued IS NOT NULL AND SelectMove[i].RSIssued <> '' THEN            
         FIELD(SelectMove[i].RSIssued).BgColor = CC_CYAN;
      ELSE 
         IF FIELD(SelectMove[i].RSIssued).BgColor = CC_CYAN THEN
            FIELD(SelectMove[i].RSIssued).BgColor = CC_PALE_CYAN;
         ENDIF;
      ENDIF;
      IF EditTimeStamp = TRUE AND 
           SelectMove[i].TOComplete IS NOT NULL AND SelectMove[i].TOComplete <> '' THEN            
         FIELD(SelectMove[i].TOComplete).BgColor = CC_CYAN;
      ELSE
         IF FIELD(SelectMove[i].TOComplete).BgColor = CC_CYAN THEN
            FIELD(SelectMove[i].TOComplete).BgColor = CC_PALE_CYAN;
         ENDIF;
      ENDIF;
      IF EditTimeStamp = TRUE AND 
           SelectMove[i].RSComplete IS NOT NULL AND SelectMove[i].RSComplete <> '' THEN            
         FIELD(SelectMove[i].RSComplete).BgColor = CC_CYAN;
      ELSE 
         IF FIELD(SelectMove[i].RSComplete).BgColor = CC_CYAN THEN
            FIELD(SelectMove[i].RSComplete).BgColor = CC_PALE_CYAN;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
END; 

ON ChildEntry SelectMove[*].TOIssued, 
ON ChildEntry SelectMove[*].TOComplete, 
ON ChildEntry SelectMove[*].RSIssued, 
ON ChildEntry SelectMove[*].RSComplete =
BEGIN
    k = FIELD(SelectMove).CurRow;
    CurFrame.Flush();
    IF SelectMove[k].JobClass = 0 THEN
       RESUME;
    ENDIF;
/*
** Check for Edit TimeStamp Mode
*/
    IF EditTimeStamp = TRUE THEN
       i = PU_CANCEL;
       OldJob = SelectMove[k].Duplicate();
            IF CURFRAME.TriggerField.Name like '%toissued' AND 
                FIELD(SelectMove[k].TOIssued).BgColor = CC_CYAN THEN

                   i = CALLFRAME ManualTimeEntry 
                         (Move = byref(SelectMove[k]),
                          MessageText = 'TO Issue');

            ELSEIF CURFRAME.TriggerField.Name like '%tocomplete' AND 
                FIELD(SelectMove[k].TOComplete).BgColor = CC_CYAN THEN

                   i = CALLFRAME ManualTimeEntry 
                         (Move = byref(SelectMove[k]),
                          MessageText = 'TO Complete');

            ELSEIF CURFRAME.TriggerField.Name like '%rsissued' AND 
                FIELD(SelectMove[k].RSIssued).BgColor = CC_CYAN THEN

                   i = CALLFRAME ManualTimeEntry 
                         (Move = byref(SelectMove[k]),
                          MessageText = 'RS Issue');

            ELSEIF CURFRAME.TriggerField.Name like '%rscomplete' AND 
                FIELD(SelectMove[k].RSComplete).BgColor = CC_CYAN THEN

                   i = CALLFRAME ManualTimeEntry 
                         (Move = byref(SelectMove[k]),
                          MessageText = 'RS Complete');

            ENDIF;

            IF i = PU_OK THEN

               i = CALLPROC SOA_JobTimeUpd
                    (Job = SelectMove[k].Job,
                     TOIssued = SelectMove[k].TOIssued,
                     TOComplete = SelectMove[k].TOComplete,
                     RSIssued = SelectMove[k].RSIssued,
                     RSComplete = SelectMove[k].RSComplete,
                     Response = SelectMove[k].Response);

               IF i < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  SelectMove[k].TOIssued = OldJob.TOIssued;
                  SelectMove[k].RSIssued = OldJob.RSIssued;
                  SelectMove[k].TOComplete = OldJob.TOComplete;
                  SelectMove[k].RSComplete = OldJob.RSComplete;
                  Message 'Manual timestamp was unsuccessful.  Try again.';
                  RESUME;
               ENDIF; 
               CALLPROC DDB_COMMIT;
/*
** Now handle N moves
** check if there is an N move in a card. If there is, we will issue/complete the
** restore side. Then, we will delete the ground job from the bank.
*/
              FakedJob = 0;
              SELECT :FakedJob = J.Job
              FROM   SOA_Job J,
                     SOA_JobControl JC
              WHERE  J.Equip = :SelectMove[k].Equip AND
                     J.JobClass = :SelectMove[k].JobClass AND
                     J.Status = '' AND
                     J.MoveCategory = :MoveCategory$Fake AND
                     J.Job = JC.Job;

              IF FakedJob > 0 THEN
                 i = CALLPROC SOA_JobTimeUpd
                    (Job = FakedJob,
                     TOIssued = SelectMove[k].TOIssued,
                     TOComplete = SelectMove[k].TOComplete,
                     RSIssued = SelectMove[k].RSIssued,
                     RSComplete = SelectMove[k].RSComplete,
                     Response = SelectMove[k].Response);
                 IF i = 0 THEN
                    CALLPROC DDB_COMMIT;
                 ELSE
                    CALLPROC DDB_ROLLBACK;
                 ENDIF;
                 FCFrame.SendUserEvent (EventName = 'load_jobs');  
              ENDIF;
           ENDIF;
       RESUME; 
    ELSE
       IF CURFRAME.TriggerField.Name like '%toissued' OR 
            CURFRAME.TriggerField.Name like '%tocomplete' THEN
          RESUME;
       ENDIF;
    ENDIF;  
/*
**  If this row is currently selected, de-select this row
*/
    IF FIELD(SelectMove[k].RSIssued).IsReverse = TRUE THEN 
       FIELD(SelectMove[k].RSIssued).IsReverse = FALSE;
       FIELD(SelectMove[k].RSComplete).IsReverse = FALSE; 
       RESUME;
    ENDIF;
/*
**  Otherwise, hightlight the newly selected row
*/ 
    IF (SelectMove[k].TOComplete IS NULL OR
        SelectMove[k].TOComplete = '' OR
        SelectMove[k].RSIssued IS NOT NULL) THEN
        RESUME;
    ENDIF;

    i = 1;
    WHILE i <= SelectMove.LastRow() DO
       IF i <> k THEN
          FIELD(SelectMove[i].TOMove).IsReverse = FALSE;
          FIELD(SelectMove[i].RSIssued).IsReverse = FALSE;
          FIELD(SelectMove[i].RSComplete).IsReverse = FALSE; 
       ELSE
          FIELD(SelectMove[k].RSIssued).IsReverse = TRUE; 
          FIELD(SelectMove[k].RSComplete).IsReverse = TRUE; 
          FIELD(Restore_Btn).CurBias = FB_LANDABLE;
       ENDIF;
       i = i + 1;
    ENDWHILE;
END;


ON Click OK_Btn =
BEGIN
/*
**  Make sure they selected a move
*/
    SMove = FALSE;
    i = 1;
    WHILE i <= SelectMove.LastRow() DO
       IF FIELD(SelectMove[i].TOMove).IsReverse = TRUE  THEN
          SMove = TRUE;
          ENDLOOP;
       ENDIF;
       i = i + 1;
    ENDWHILE;

    IF SMove = FALSE THEN
       message 'You have not selected any moves to insert.';
       RESUME;
    ENDIF;

    PromptPhrase = 'Please enter ID for Equipment:  ' +
                    EquipClassName + '  ' + EquipName;

    IDText = CALLFRAME GenericEntry ( 
             PromptPhrase = PromptPhrase,
             PhraseLength = 2);

    IF IDText IS NULL THEN
       RESUME;
    ENDIF;

    i = 1;
    WHILE i <= SelectMove.LastRow() DO
       IF FIELD(SelectMove[i].TOMove).IsReverse = TRUE  THEN

          SelectMove[i].Card = C.Card;
          SelectMove[i].PrintID = IFNULL(IDText,'');
          SelectMove[i].GroundOn = NULL;
          SelectMove[i].MoveCategory = MoveCategory$Fake;  
          SelectMove[i].TOMoveRules = -1;  /* don't let move rules affect move*/
          SelectMove[i].RSMoveRules = -1;
          SelectMove[i].ActivityIdentifier = 'N';

          RetCode = CALLPROC InsertJobsRow
                   (C = C, NewJob = SelectMove[i]);
          IF RetCode IS NULL THEN
             CALLPROC DDB_ROLLBACK;
             message 'Could not insert move:  ' + SelectMove[i].TOMove +
                     '  into current card.  Please try again.';
             RESUME;
          ELSE
             CALLPROC DDB_COMMIT;
             /*
             ** set the Takeout time stamps
             */
             RetCode = CALLPROC SOA_JobTimeUpd (
                            Job = IFNULL(RetCode,0),
                            Response = '',
                            TOIssued = SelectMove[i].TOIssued,
                            TOComplete = SelectMove[i].TOComplete,
                            RSIssued = SelectMove[i].RSIssued,
                            RSComplete = SelectMove[i].RSComplete);
             CALLPROC DDB_COMMIT;
    
             MoveInserted = TRUE;
             DropBankJobs.InsertRow (rownumber = 1, 
                                  rowobject = SelectMove[i].Duplicate());
          ENDIF;
       ENDIF;
       i = i + 1;
    ENDWHILE;

    /* Update Feedercard frame so that moves are greyed out */
    IF MoveInserted = TRUE THEN
       FCFrame.SendUserEvent (EventName = 'UpdateMoveColor');
    ENDIF;
 
    CurFrame.WindowVisibility = WV_Invisible;
END;


ON Click Restore_Btn =
BEGIN
/*
**  Make sure they selected a move
*/
    i = 0;
    k = 1;
    WHILE k <= SelectMove.LastRow() DO
       IF FIELD(SelectMove[k].RSIssued).IsReverse = TRUE  THEN
          i = k;
          ENDLOOP;
       ENDIF;
       k = k + 1;
    ENDWHILE;

    IF i = 0 THEN
       message 'You have not selected a move to restore.';
       RESUME;
    ENDIF;
/*
**  select an operator
*/
    RetCode = CALLFRAME SelectOperator(AnyName = TRUE);
    IF RetCode = PU_Cancel THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ENDIF;
      
    FIELD(SelectMove[i].RSIssued).IsReverse = FALSE;
    FIELD(SelectMove[i].RSComplete).IsReverse = FALSE;

    /* convert job to JobInProgress object */
    JIP = NULL;
    JIP = JobInProgress.Create();
#   Include ConvertSingleToJobIP
         
    /* RS issue this move */          
    JIP.Status = Job$Restore;

    JIP.RSIssued = 'now';
    RetCode = JIP.IssueMove(Job = JIP, SetTime = JIP.RSIssued);
    IF Retcode = PU_CANCEL THEN
       Message 'Unable to issue restoring the move.';
       RESUME;
    ENDIF;
       
    /* perform job actions */
    RetCode = JIP.JobActions(IssueCompl = JobClass$Issue,
                             NoCard = TRUE,
                             NoOperSt  = TRUE,
                             NoLineSt  = TRUE,
                             NoFeederSt = TRUE); 
    IF Retcode = PU_CANCEL THEN
       Message 'Unable to perform job actions on the move.';
       RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;
    SelectMove[i].RSIssued = JIP.RSIssued;

    /* auto complete the move */
    JIP.RSComplete = JIP.RSIssued;
       
    RetCode = JIP.CompleteMove(Job = JIP, SetTime = JIP.RSComplete);
    IF Retcode = PU_CANCEL THEN
       Message 'Unable to complete restoring the move.';
       RESUME;
    ENDIF;
       
    /* perform job actions */
    RetCode = JIP.JobActions(IssueCompl = JobClass$Complete,
                               NoCard = TRUE,
                               NoOperSt  = TRUE,
                               NoLineSt  = TRUE,
                               NoFeederSt = TRUE); 
    IF Retcode = PU_CANCEL THEN
       Message 'Unable to perform job actions on the move.';
       RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;
    SelectMove[i].RSComplete = JIP.RSComplete;

   /* delete the move
   */
   RetCode = CALLPROC FMS_DroppedEquipJobsDel(
                                  Job = SelectMove[i].Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to remove the move for equipment: ' +
                        EquipClassName + '  ' +
                        EquipName + ' from job bank.';
   ENDIF;                                               
   CALLPROC DDB_COMMIT; 

   RetCode = CALLPROC SOA_JobDel(Job = SelectMove[i].Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to remove move from soa_job table.',
             TraceMessage = 'ViewMoves; Unable to remove the move ' + 
                          VARCHAR(SelectMove[i].Job) + ' from soa_job table.');
   ENDIF;                                               
   CALLPROC DDB_COMMIT; 
/*
** Now handle N moves
** check if there is an N move in a card. If there is, we will issue/complete the
** restore side. Then, we will delete the ground job from the bank.
*/
    FakedJob = 0;
    SELECT :FakedJob = J.Job
    FROM   SOA_Job J,
           SOA_JobControl JC
    WHERE  J.Equip = :SelectMove[i].Equip AND
           J.JobClass = :SelectMove[i].JobClass AND
           J.Status = '' AND
           J.MoveCategory = :MoveCategory$Fake AND
           J.Job = JC.Job;

    IF FakedJob > 0 THEN
      /* We are going to issue/complete the restore side. When we do the job actions,
      ** we have to use the faked move because the job in the drop/new bank is NOT on
      ** any card and, therefore, the JobActions method in JIP does not retrieve any
      ** job action from the FMS_JobAction table.
      */

      /* convert job to JobInProgress object */
      JIP = NULL;
      JIP = JobInProgress.Create();
#     Include ConvertSingleToJobIP
         
       /* RS issue this move */          
       JIP.Status = Job$Restore;
      
       RetCode = JIP.JobChecks(IssueCompl = JobClass$Issue);

       IF RetCode = PU_CANCEL THEN
          RESUME;
       ENDIF;

       FIELD(SelectMove[i].RSIssued).IsReverse = FALSE;
       FIELD(SelectMove[i].RSComplete).IsReverse = FALSE;

       JIP.RSIssued = 'now';
      /* perform job actions, exclude Equip actions so they don't happen twice */
       JIP.Job = FakedJob;
       RetCode = JIP.JobActions(IssueCompl = JobClass$Issue,
                                NoEquipSt = TRUE);
       IF Retcode = PU_CANCEL THEN
          Message 'Unable to perform job actions on the move.';
          RESUME;
       ENDIF;
       CALLPROC DDB_COMMIT;
       SelectMove[i].RSIssued = JIP.RSIssued;

       /* auto complete the move */
       JIP.RSComplete = JIP.RSIssued;
       /* perform job actions */
       JIP.Job = FakedJob;
       RetCode = JIP.JobActions(IssueCompl = JobClass$Complete,
                                NoEquipSt = TRUE);
       JIP.Job = J[i].Job;
       IF Retcode = PU_CANCEL THEN
         Message 'Unable to perform job actions on the move.';
         RESUME;
       ENDIF;
       CALLPROC DDB_COMMIT;
       SelectMove[i].RSComplete = JIP.RSComplete;
 
       /* update the restore time stamps and response column of the N move*/
       RetCode = CALLPROC SOA_JobTimeUpd (
                            Job = FakedJob,
                            Response = 'Move Restored',
                            TOIssued = JIP.TOIssued,
                            TOComplete = JIP.TOComplete,
                            RSIssued = JIP.RSIssued,
                            RSComplete = JIP.RSComplete);
       CALLPROC DDB_COMMIT;

       FCFrame.SendUserEvent (EventName = 'load_jobs');  
   ENDIF;
/*
** Tell the parent frame to update the counts.
*/
   ParentFrame.SendUserEvent(EventName = 'Update_Equip_Ground',
                              MessageInteger = Equip);

   FIELD(Restore_Btn).CurBias = FB_DIMMED;
END;

ON Click Close_Btn =
BEGIN
   ParentFrame.SendUserEvent(EventName = 'ViewMoves_Closed');
   CurFrame.WindowVisibility = WV_Invisible;
END;

ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

Application Component Report
============================

	Name:            ViewTypeHierarchy

/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          ViewTypeHierachy
**
**  04/16/04  ysp   created to show how RR types are translated.
**  05/13/04  ysp   append type descriptions to the type names 
**  01/18/07  em    Copied from DBM application RR Type Translation
**                  frame and removed visbile parts related to RR
**                  type translations.  Will be using this frame
**                  just to display the Type Hierarchy.
**  02/15/07  ysp   Add the capability to search a type under a selected root.
**  10/04/07  pkw   Add ShowTracking option.
**  10/20/07  pkw   Change procedure name to SOA_OutageEquipTypeINS/DEL
**  08/21/08  ysp   Remove RR type translation logic. It is replaced by TypeMappingTreeView
**                  in DBM
**  05/01/15  em    Add support for DSO hierarchy 
*/

INITIALIZE
(
 //   ShowMapping = INTEGER NOT NULL WITH DEFAULT;    /* Optional parameter default = 0 */
    ShowTracking = INTEGER NOT NULL WITH DEFAULT;    /* Optional parameter default = 0 */
) =
DECLARE
    RetCode       = INTEGER NOT NULL; 
    i             = INTEGER NOT NULL WITH DEFAULT;         
    j             = INTEGER NOT NULL WITH DEFAULT;          
    Mapped        = INTEGER NOT NULL WITH DEFAULT;         

    TV            = TreeViewField;
    TVNodes       = ARRAY OF TreeNode;
    GrayIdx       = INTEGER NOT NULL WITH DEFAULT;
    BlueIdx       = INTEGER NOT NULL WITH DEFAULT;         
    RedIdx        = INTEGER NOT NULL WITH DEFAULT;

    CList         = ChoiceList;
    CurTypeObj    = ObjectSummaryClass;
    HasChanged    = INTEGER NOT NULL WITH DEFAULT;
    TypeASE       = TypeClass_ASE WITH DEFAULT;
    TypeTranslation = ARRAY OF TypeClass;

    MatchList     = ARRAY OF ObjectSummaryClass;
    NextMatchIdx  = INTEGER NOT NULL WITH DEFAULT;         
    SearchString  = VARCHAR(20) NOT NULL WITH DEFAULT; 
    SearchRootName = VARCHAR(40) NOT NULL WITH DEFAULT;
    SearchRootType = INTEGER NOT NULL WITH DEFAULT;
    SelectRootName = VARCHAR(40) NOT NULL WITH DEFAULT;
    SelectRootType = INTEGER NOT NULL WITH DEFAULT;

    /* Interal Procedures 
    */
    AddTypeNode = PROCEDURE Returning TreeNode;
    ExpandTreeNode = PROCEDURE;
    FindNextMatch = PROCEDURE;

    SetupBitmaps = PROCEDURE;
    UpdateSubTreeMapping = PROCEDURE;
    GetDirectMapping = PROCEDURE;
    SetMappingIcon = PROCEDURE;
ENDDECLARE 
{
   TV = FIELD(TVF);
   HasChanged = FALSE;

   IF ShowTracking = 1 THEN
      /*
      ** Get the existing udb-rr mappings
      */
      i = 1;
      TypeTranslation.Clear(); 
      SELECT :TypeTranslation[i].BaseType = T.Type,
             :TypeTranslation[i].Type = T.Type,
             :TypeTranslation[i].Name = T.Name
      FROM   SOA_OutageEquipType TT,
             Udb_Type T
      WHERE  TT.Type = T.Type
      BEGIN 
         i = i + 1;
      END;

      CALLPROC SetupBitmaps();
   ELSE
      FIELD(Tracking).CurBias = FB_INVISIBLE;
   ENDIF;   
/*
** load up the udb type data from the database.
*/
   IF TypeASE IS NULL THEN
      TypeASE = TypeClass_ASE.Create();
   ENDIF;

   IF CurrentApplication = Application$TLS THEN
      TypeASE.Type = Type$TelCircuit;
   ELSEIF CurrentApplication = Application$DSO THEN
      TypeASE.Type = Type$DielectricEquipment;
   ELSE     
      TypeASE.Type = Type$Conducting;
   ENDIF;
   TypeASE.MaxLevel = 3;
   TypeASE.GetTree();

   IF TypeASE.ReturnCode <> 0 THEN
      MESSAGE 'Failed to get equipment types from the database:' + TypeASE.ErrorMessage;
      ViewTypeFrame = NULL;
      RETURN PU_CANCEL;
   ENDIF;
/*
** add data to the tree field.
*/
   FOR i = 1 To TypeASE.CList.LastRow() DO
      CurTypeObj.BaseType = TypeASE.CList[i].BaseType;
      CurTypeObj.Name = TypeASE.CList[i].Name;
      CurTypeObj.TypeName = TypeASE.CList[i].Description;
      CurTypeObj.Type = TypeASE.CList[i].Type;
      CurTypeObj.Object = i;
      
      IF ShowTracking = 1 THEN 
         CALLPROC GetDirectMapping(TypeObject = BYREF(CurTypeObj));
      ENDIF;

      IF i = 1 THEN
         TVNodes[i] = CALLPROC AddTypeNode 
                                 ( TypeTree = TV.Tree,
                                   TypeObject = CurTypeObj.Duplicate(),
                                   ParentNode = NULL);
      ELSE
         TVNodes[i] = CALLPROC AddTypeNode 
                                 ( TypeTree = TV.Tree,
                                   TypeObject = CurTypeObj.Duplicate(),
                                   ParentNode = TVNodes[CurTypeObj.BaseType]);
      ENDIF;
   ENDFOR;  

   TVNodes[1].IsExpanded = TRUE;
/*
** Because the root of the tree is selected by default, we'd better 
** set the search root to be the tree root.
*/
   SelectRootType = ObjectSummaryClass(TVNodes[1].ClientData).Type;
   SelectRootName = ObjectSummaryClass(TVNodes[1].ClientData).Name;
}


ON SetValue TVF = 
DECLARE
    CurNode	= TreeNode;
    MappedRR    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
{
   CurNode = TV.CurNode;        
   SelectRootType = ObjectSummaryClass(CurNode.ClientData).Type;
   SelectRootName = ObjectSummaryClass(CurNode.ClientData).Name;
}


ON EXPANDED TVF =
DECLARE
    CurNode = TreeNode;
ENDDECLARE
{
/*
** When a node is expanded to add child nodes, the child notes are added
** to the end of TVNodes array. In this way the index of the previously loaded
** tree nodes are intact.
*/
    CurNode = TV.TriggerNode;
    CALLPROC ExpandTreeNode(ParentNode = CurNode); 
}

ON COLLAPSED TVF =
DECLARE
    CurNode	= TreeNode;
ENDDECLARE
{
    CurNode = TV.TriggerNode;
}

ON CLICK SS.Find_Btn = 
DECLARE
    i  = INTEGER NOT NULL WITH DEFAULT;
    CurNode = TreeNode;
    TempString = VARCHAR(30) NOT NULL WITH DEFAULT; 
ENDDECLARE
{  

   IF SS.TypeName = '' THEN
      MESSAGE 'Please enter a string to search.';
      RESUME;
   ENDIF;
   TempString = '%' + UpperCase(SS.TypeName) + '%';

   IF SelectRootType = 0 THEN
      MESSAGE 'Please select a super type of the subtree to search.';
      RESUME;
   ENDIF;

   IF SearchString = SS.TypeName AND SelectRootType = SearchRootType  THEN
       CALLPROC FindNextMatch();
       RESUME;
   ELSE
      SearchString = SS.TypeName;  
      SearchRootType = SelectRootType;
      SearchRootName = SelectRootName;
   ENDIF;

   MatchList.Clear();
   i = 1;
   REPEATED
   SELECT :MatchList[i].Type = T.Type,
          :MatchList[i].Name = T.Name  
   FROM   UDB_Type T,
          UDB_ExtendedType ET
   WHERE  ET.SuperType = :SearchRootType AND
          ET.Type = T.Type AND
          UpperCase(T.Name) LIKE :TempString 
   ORDER BY Type
   BEGIN
      i = i + 1;
   END;

   IF MatchList.LastRow = 0 THEN
      MESSAGE 'No matches found under ''' +  SearchRootName  + ''' super type.';
      RESUME;
   ENDIF;
/*
** Let's locate the first matched in the tree. 
*/
   NextMatchIdx = 0;
   CALLPROC FindNextMatch();
}


/*
**  Handle an Exit click
*/
ON Click OK_Btn =
{
   ViewTypeFrame = NULL;
   RETURN PU_OK;
}

ON WINDOWCLOSE =
{
    RESUME;
}

ON USEREVENT 'BringToFront' =
