METHOD Load_Substations (
)=
DECLARE
   DivCheck = INTEGER NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load substations associated with a division.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   DivCheck = 0;
   SELECT :DivCheck = COUNT(*) 
   FROM    Udb_Object 
   WHERE   Object = :CurObject.Division AND
           Type = :Type$Division;


   IF DivCheck = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please select a valid division.';
      RETURN;
   ENDIF;
   
   CurObject.Olist.Clear();
   i = 1;
   IF CurObject.Filter = 0 THEN        // Area Substations
      REPEATED
      SELECT  :CurObject.Olist[i].Object = O.Object,
              :CurObject.Olist[i].Name = O.Name,
              :CurObject.Olist[i].TypeName = O.Description       
      FROM    Udb_Object O,
              Udb_Grouping G 
      WHERE   G.MemberType = :Type$Substation AND
              G.Relationship = :Interaction$MemberOf AND 
              G.Grouping = :CurObject.Division AND
              G.Member = O.Object
      ORDER BY Name
      BEGIN
         i = i + 1;
      END; 
   ELSEIF CurObject.Filter = 1 THEN   // Unit Substations
      REPEATED
      SELECT  :CurObject.Olist[i].Object = O.Object,
              :CurObject.Olist[i].Name = O.Name,
              :CurObject.Olist[i].TypeName = O.Description       
      FROM    Udb_Object O,
              Udb_Grouping G 
      WHERE   G.MemberType = :Type$UnitSubstation AND
              G.Relationship = :Interaction$MemberOf AND 
              G.Grouping = :CurObject.Division AND
              G.Member = O.Object
      ORDER BY Name
      BEGIN
         i = i + 1;
      END; 
   ELSEIF CurObject.Filter = 2 THEN   // PURS stations
      REPEATED
      SELECT  :CurObject.Olist[i].Object = O.Object,
              :CurObject.Olist[i].Name = O.Name,
              :CurObject.Olist[i].TypeName = O.Description       
      FROM    Udb_Object O,
              Udb_Grouping G 
      WHERE   G.MemberType = :Type$PURSStation AND
              G.Relationship = :Interaction$MemberOf AND 
              G.Grouping = :CurObject.Division AND
              G.Member = O.Object
      ORDER BY Name
      BEGIN
         i = i + 1;
      END; 
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;


METHOD Load_TvKpiLogDetails
( 
)=
DECLARE
   i       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   CurObject.tlist.Clear();
   IF CurObject.IsArchive = 0 THEN
      SELECT :CurObject.tlist[i].StartTime = L.Time,
             :CurObject.tlist[i].UserName  = L.UserName,
             :CurObject.tlist[i].Network  = L.Item,
             :CurObject.tlist[i].Comment  = L.Old,
             :CurObject.tlist[i].Char_Duration  = L.New
      FROM    SOA_Log L
      WHERE   L.Card = :CurObject.Card AND
              lowercase(L.Item) like 'tv update%' 
      ORDER BY Time DESC
      BEGIN
         i = i + 1;
      END;
   ELSE
      SELECT :CurObject.tlist[i].StartTime = L.Time,
             :CurObject.tlist[i].UserName  = L.UserName,
             :CurObject.tlist[i].Network  = L.Item,
             :CurObject.tlist[i].Comment  = L.Old,
             :CurObject.tlist[i].Char_Duration = L.New
      FROM    FMS_ArchiveLog L
      WHERE   L.Card = :CurObject.Card AND
              lowercase(L.Item) like 'tv update%' 
      ORDER BY Time DESC
      BEGIN
         i = i + 1;
      END;
   
   ENDIF;


   RETURN;   
END;


METHOD Load_TvKpiCercDate
( 
)=
DECLARE
   i       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.StartDateChar = '01-jan-' + CurObject.Comment;
   CurObject.EndDateChar   = '31-dec-' + CurObject.Comment;
   CurObject.StartDate = Date(CurObject.StartDateChar);
   CurObject.EndDate = Date(CurObject.EndDateChar); 
 
   i = 1;
   CurObject.tlist.Clear();
   SELECT :CurObject.tlist[i].StartTime = C.DateValue
   FROM    FMS_CercDay C
   WHERE   C.DateValue BETWEEN :CurObject.StartDate AND :CurObject.EndDate 
   ORDER BY DateValue
   BEGIN
      i = i + 1;
   END;


   RETURN;   
END;


METHOD Add_TvKpiCercDate
( 
)=
DECLARE
   i       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
 
   FOR i = 1 TO CurObject.tlist.LastRow DO
      RetCode = CALLPROC FMS_CercDayIns(
             DateValue = DATE(CurObject.tlist[i].Comment)
             );
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.AddTvKpiCERC ' + 
                    'failed to insert CERC date into database.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to insert CERC date into database.';
         ENDLOOP;
      ENDIF;
   ENDFOR; 
   RETURN;   
END;


METHOD Remove_TvKpiCercDate
( 
)=
DECLARE
   i       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
 
   FOR i = 1 TO CurObject.dlist.LastRow DO
      RetCode = CALLPROC FMS_CercDayDel(
             DateValue = DATE(CurObject.dlist[i].Comment)
             );
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.AddTvKpiCERC ' + 
                    'failed to remove CERC date from database.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to remove CERC date from database.';
         ENDLOOP;
      ENDIF;
   ENDFOR; 
   RETURN;   
END;


METHOD Adjust_TvKpiDuration
( 
)=
DECLARE
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
 
   IF CurObject.IsArchive = 0 THEN
      /*
      **  Call SOA_LogInsert instead of SOA_Log because usermachine and dop.* is not set.
      */
      RetCode = CALLPROC SOA_LogInsert(
             Card = CurObject.Card,
             SwitchingItem = 0,
             Job = NULL,
             Time = Date('now'),
             UserName = CurObject.UserName,
             Item = 'TV Update Duration',
             Old = IFNULL(CurObject.Comment, ''),
             New = IFNULL(CurObject.TV_Text, ''),
             Operator = 0,
             OperatorName = 'FMS Online'
      );


   ELSE
      RetCode = CALLPROC FMS_ArchiveLogIns (
             Card = CurObject.Card, 
             Job = NULL,
             Time = DATE('NOW'),       
             UserName = CurObject.UserName,
	         Item = 'TV Update Duration',      
	         Old = IFNULL(CurObject.Comment, ''),       
	         New = IFNULL(CurObject.TV_Text, ''),
             Operator = 0,
             OperatorName = 'FMS Online'); 
   ENDIF;
  
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.AdjustTvKpiDuration ' + 
                    'failed to update duration for card ' + VARCHAR(CurObject.Card) + 
                    ' in SOA_Log(' + varchar(CurObject.IsArchive) + ') table.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to update duration in the database.';
   ENDIF; 
   RETURN;   
END;


METHOD MoveTo_TvKpiException
( 
)=
DECLARE
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   TV_Bogey = INTEGER NOT NULL WITH DEFAULT;
   Archive  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   TV_Bogey = -99;
   SELECT :TV_Bogey = C.TV_Bogey,
          :Archive = 0  /* Active */
   FROM   FMS_Card C
   WHERE  C.Card = :CurObject.Card AND
          C.Status < :Card$Closed
   UNION ALL
   SELECT  AC.TV_Bogey,
           1  /* Archive */
   FROM   FMS_ArchiveCard AC
   WHERE  AC.Card = :CurObject.Card;
   
   IF TV_Bogey <> -99 THEN
      IF TV_Bogey > 0 THEN
         TV_Bogey = TV_Bogey - 10;
      ENDIF;
      RetCode = CALLPROC FMS_CardTVUpd(
                          Card = CurObject.Card,
                          Type = Archive,
                          TV_Bogey = TV_Bogey);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.MoveToTvKpiException ' + 
                       'failed to update tv_bogey for card ' + VARCHAR(CurObject.Card) + 
                       ' in FMS_Card(' + varchar(archive) + ') table.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to update tv_bogey value in the database.';
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Card not found in database.'; 
      RETURN;
   ENDIF;
   IF Archive = 0 THEN
      /*
      **  Call SOA_LogInsert instead of SOA_Log because usermachine and dop.* is not set.
      */
      RetCode = CALLPROC SOA_LogInsert(
             Card = CurObject.Card,
             SwitchingItem = 0,
             Job = NULL,
             Time = Date('now'),
             UserName = CurObject.UserName,
             Item = 'TV Update Add Exception',
             Old = IFNULL(CurObject.Comment, ''),
             New = IFNULL(CurObject.TV_Text, ''),
             Operator = 0,
             OperatorName = 'FMS Online'
      );


   ELSE
      RetCode = CALLPROC FMS_ArchiveLogIns (
             Card = CurObject.Card, 
             Job = NULL,
             Time = DATE('NOW'),       
             UserName = CurObject.UserName,
	         Item = 'TV Update Add Exception',      
	         Old = IFNULL(CurObject.Comment, ''),       
	         New = IFNULL(CurObject.TV_Text, ''),
             Operator = 0,
             OperatorName = 'FMS Online'); 
   ENDIF;
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': DEBUGGING MESSAGE: FMS_MgtReports_ASE.MoveTo_TvKpiException ' + 
                    'failed to log reason for exception for card ' + VARCHAR(CurObject.Card) + 
                    ' in SOA_Log(' + varchar(Archive) + ') table.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to log reason for exception in database.';
   ENDIF; 
 
   RETURN;   
END;


METHOD MoveTo_TvKpiReport
( 
