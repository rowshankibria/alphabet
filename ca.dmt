	Name:            PromptVisibleBusFault

/*
**
**	Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptVisibleBusFault          
**
**  Modifications:
**  05/05/09   em   Created for SLC
**  05/11/09   em   Changed term to Visible Bus Damage
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    RetCode         = INTEGER;
    BFExists        = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** Only Display screen if we are in a Bus Section Fault.
*/
   BFExists = FALSE;
   SELECT :BFExists = SwitchingItem
   FROM   SOA_BusFaultOutage
   WHERE  SwitchingItem = :JIP.SwitchingItem;

   IF BFExists = FALSE THEN
      RETURN (PU_OK);
   ENDIF;
END;


ON SETVALUE VB =
BEGIN
   IF VB = TRUE THEN
      FIELD(Damage).CurBias = FB_CHANGEABLE;
   ELSE
      FIELD(Damage).CurBias = FB_DIMMED;
      Damage = '';
   ENDIF;
END;
   
    
ON CLICK OK_btn = 
BEGIN
   IF VB = TRUE AND Damage = '' THEN
      MESSAGE 'If there is a visible bus fault, must enter short description.';
      RESUME;
   ENDIF;

   RetCode = CALLPROC SOA_BFVisibleFaultUpd (
          SwitchingItem = JIP.SwitchingItem,
          VBFault = VB,
          VBFDescription = Damage,
          VBFLastUpd = 'now',
          VBFLastUpdBy = DOp.Description);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to Record Visible Bus Fault due to an error!';
      RETURN (PU_CANCEL);
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN (PU_OK);
   ENDIF;
END;

