METHOD IsLoggedIn (
) =
DECLARE
BEGIN
   IF CurObject.Object = 0 THEN
      RETURN (FALSE);
   ELSE
      RETURN (TRUE);
   ENDIF;   
END;

/*===================================================================
** Init operator at application startup.
*/
METHOD Init (
   Machine = VARCHAR(20) NOT NULL WITH DEFAULT;
) =
DECLARE
BEGIN
   CurObject.Object = 0;
   CurObject.Name = '';
   CurObject.Description = '';
   CurObject.Machine = :Machine;
   CurObject.LoginTime = NULL;
   CurObject.LoginName = '';
   CurObject.Initials = '';
   CurObject.Type = 0;
   CurObject.Domain = CurSession.GetEnv(Name = 'USERDOMAIN');

/*
** Check if the user was logged in previously 
*/
   SELECT :CurObject.Object      = O.Object, 
          :CurObject.Name        = O.Name, 
          :CurObject.Description = O.Description,
          :CurObject.LoginTime   = T.Login,
          :CurObject.LoginName   = P.LoginName,
          :CurObject.Type        = O.Type,
          :CurObject.Initials    = P.Initials
   FROM   Udb_Object O,
          SOA_DOLogIn T,
          Udb_Person P
   WHERE  T.Machine = :Machine AND
          T.Logout IS NULL AND
          T.Operator = O.Object AND
          O.Object = P.Object;

   CALLPROC DDB_ROLLBACK;
/*
**  Set DBMOperator in case user accesses Udb Access.
*/
   DBMOperator.Object = CurObject.Object;
   DBMOperator.Name   = CurObject.Name;
   DBMOperator.Description = CurObject.Description;
   DBMOperator.LoginTime = CurObject.LoginTime;
   DBMOperator.Type = CurObject.Type;
   DBMOperator.Initials = CurObject.Initials;
   
   CurObject.WBLogin(LoginTime = IFNULL(CurObject.LoginTime,''));

   RETURN (PU_OK);
END;

/*===================================================================
** Sync up the operator with other applications
*/
METHOD SyncUp (
   Operator = INTEGER NOT NULL;
) =
DECLARE
BEGIN
   CurObject.Object = 0;
   CurObject.Name = '';
   CurObject.Description = '';
   CurObject.LoginTime = NULL;
   CurObject.LoginName = '';
   CurObject.Initials = '';
   CurObject.Type = 0;

   IF Operator > 0 THEN
      SELECT :CurObject.Object      = O.Object, 
             :CurObject.Name        = O.Name, 
             :CurObject.Description = O.Description,
             :CurObject.LoginTime   = T.Login,
             :CurObject.LoginName   = P.LoginName,
             :CurObject.Type        = O.Type,
             :CurObject.Initials    = P.Initials
      FROM   Udb_Object O,
             SOA_DOLogIn T,
             Udb_Person P
      WHERE  O.Object = :Operator AND
             T.Operator = :Operator AND
             T.Machine = :CurObject.Machine AND
             T.Logout IS NULL AND
             P.Object = :Operator;

      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
**  Set DBMOperator in case user accesses Udb Access.
*/
   DBMOperator.Object = CurObject.Object;
   DBMOperator.Name   = CurObject.Name;
   DBMOperator.Description = CurObject.Description;
   DBMOperator.LoginTime = CurObject.LoginTime;
   DBMOperator.Type = CurObject.Type;
   DBMOperator.Initials = CurObject.Initials;

   IF CurObject.Object <> Operator THEN
      RETURN (PU_CANCEL);
   ELSE
      RETURN (PU_OK);
   ENDIF;
END;

/*===================================================================
** log in a new operator
*/
METHOD LogIn (
   Operator = INTEGER NOT NULL;
   Name = VARCHAR(40) NOT NULL WITH DEFAULT;
   Description = VARCHAR(60) NOT NULL WITH DEFAULT;
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   LoginTime = DATE NOT NULL;
BEGIN
   LoginTime = Date('now');
   CurObject.Domain = '';
   CurObject.Domain = CurSession.GetEnv(Name = 'USERDOMAIN');

   RetCode = CALLPROC SOA_DOLogIn (Operator = Operator,
                                   Machine = CurObject.Machine,
                                   Login = LoginTime);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;  

      SELECT :CurObject.Type        = O.Type,
             :CurObject.LoginName   = P.LoginName,
             :CurObject.Initials    = P.Initials
      FROM   Udb_Object O,
             Udb_Person P
      WHERE  O.Object = :Operator AND
             O.Object = P.Object;

      CurObject.Object  = Operator; 
      CurObject.Name = Name;
      CurObject.Description = Description;
      CurObject.LoginTime = LoginTime;
/*
**  Set DBMOperator in case user accesses Udb Access.
*/
      DBMOperator.Object = CurObject.Object;
      DBMOperator.Name   = CurObject.Name;
      DBMOperator.Description = CurObject.Description;
      DBMOperator.LoginTime = CurObject.LoginTime;
      DBMOperator.Type = CurObject.Type;
      DBMOperator.Initials = CurObject.Initials;
   
      CurObject.WBLogin(LoginTime = IFNULL(CurObject.LoginTime,''));       

      RETURN (PU_OK);
   ELSE        
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ENDIF;
END;

/*===================================================================
** check operator activity
*/
METHOD CheckActivity (
   Move = JobInProgress;
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   ActivityCnt = INTEGER NOT NULL;
   AutomationCnt = INTEGER NOT NULL;
   CheckDate = DATE NOT NULL;
   i = INTEGER NOT NULL WITH DEFAULT;
   EmailClass = EmailNotificationClass DEFAULT NULL;
BEGIN
   IF CurObject.Threshold = 0 THEN
      SELECT :CurObject.Threshold = S.Threshold,
             :CurObject.LastWarning = S.LastWarning
      FROM    FMS_Speedbump S
      WHERE   S.Object = :CurObject.Object;
      IF CurObject.Threshold = 0 THEN
         SELECT :CurObject.Threshold = S.Threshold
         FROM    FMS_Speedbump S
         WHERE   Object = -1;  /* default values */
      ENDIF;
   ENDIF;
   
   CheckDate = date('now') - '1 hour';
   ActivityCnt = 0;
   SELECT :ActivityCnt = COUNT(*)
   FROM    SOA_Activity A
   WHERE   A.Operator = :CurObject.Object AND
           A.LogDate > :CheckDate;
           
   IF ActivityCnt <= CurObject.Threshold THEN
      RETURN;
   ENDIF;
   /*
   **  Subtract SSO Automation messages
   */
   AutomationCnt = 0;
   SELECT :AutomationCnt = COUNT(*) 
   FROM    FMS_AutomationBlock AB,
           IR_OpOrderJobs O
   WHERE   AB.InitiatingDO = :Curobject.Object AND
           AB.InitTime > :CheckDate AND
           AB.Block = O.OrderNumber;
   ActivityCnt = ActivityCnt - AutomationCnt;
   /*
   **  Subtract FOD Automation messages
   */   
   AutomationCnt = 0;
   SELECT :AutomationCnt = COUNT(*) 
   FROM    FMS_AutomationBlock AB,
           IR_FODOrderJobs O
   WHERE   AB.InitiatingDO = :Curobject.Object AND
           AB.InitTime > :CheckDate AND
           AB.Block = O.OrderNumber;
   ActivityCnt = ActivityCnt - AutomationCnt;
           
   IF ActivityCnt <= CurObject.Threshold THEN
      RETURN;
   ENDIF;
   /*
   **  Look at XA21 OpenAuto messages for last 4 hours.  If more than 
   **  20 don't show message.
   */
   AutomationCnt = 0;
   i = 0;
   SELECT :i = COUNT(*) 
   FROM    MSG_Message M
   WHERE   M.Senddate > date('now') - '4 hours' AND
           lowercase(M.Msg) like 'breaker opened%' AND
           lowercase(M.FromApp) = 'xa';
   AutomationCnt = i;
   
   i = 0;
   SELECT :i = COUNT(*)  
   FROM    MSG_ArchiveMessage M
   WHERE   M.Senddate > date('now') - '4 hours' AND
           lowercase(M.Msg) like 'breaker opened%' AND
           lowercase(M.FromApp) = 'xa';
   AutomationCnt = AutomationCnt + i;
           
   IF AutomationCnt > 20 THEN
      RETURN;
   ENDIF;
   /*
   **  Check when last warning was received.  If less than delay popup, return.
   */
   IF CurObject.DelayPopup = 0 THEN
      SELECT :CurObject.DelayPopup = S.DelayPopup
      FROM    FMS_Speedbump S
      WHERE   S.Object = -1;  /* default values */
   ENDIF;
   /*
   **  Now find the last time this DO got a warning
   */
   SELECT :CurObject.LastWarning = S.LastWarning
   FROM    FMS_Speedbump S
   WHERE   S.Object = :CurObject.Object;
   
   IF CurObject.LastWarning = '' THEN
      i = CurObject.DelayPopup + 10;  /* Make i greater than delay popup so DO gets message */
   ELSE
      i = INT4(interval('minute', DATE('NOW') - DATE(CurObject.LastWarning)))
   ENDIF;
   
   IF i < CurObject.DelayPopup THEN
      RETURN;
   ENDIF;
   
   CALLFRAME DDB_Message(MessageText = 'You have reached a high level of operations within ' +
                        'the past hour. Please slow down to maintain operational awareness.',
                         Application = 'Activity Threshold Exceeded',
                         Color = CC_YELLOW,
                         Timeout = 300,
                         OkDelay = 5);
   /*
   **  Update last warning field.
   */                      
   RetCode = CALLPROC FMS_SpeedBumpUpd(
              Object      = CurObject.Object
            , LastWarning = DATE('NOW')
            );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to update Last Warning value in database.  Please report problem to support.',
               TraceMessage = 'Class:DistrictOperatorClass;Unable to update LastWarning field in FMS_Speedbump table for DO: ' +
                          varchar(CurObject.Object));
      RETURN;
   ENDIF;
   CurObject.LastWarning = DATE('NOW');
   CALLPROC DDB_COMMIT;

   /*
   **  Track Threshold warning
   */                      
   RetCode = CALLPROC FMS_SpeedBumpCntIns(
              Object      = CurObject.Object
            , WarningTime = CurObject.LastWarning
            );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to track Warning threshold value in database.  Please report problem to support.',
               TraceMessage = 'Class:DistrictOperatorClass;Unable to Track threshold Warning field in FMS_SpeedbumpCnt table for DO: ' +
                          varchar(CurObject.Object));
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

                         
   RetCode = CALLPROC SOA_LogIns (
              Card           = Move.Card
            , Job            = 0
            , SwitchingItem  = Move.SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'Activity Threshold'
            , New            = 'Operator acknowledged high activity message'
            );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
               TraceMessage = 'Class:DistrictOperatorClass;Unable to Log Activity Threshold message. ' +
                          'Card: ' + varchar(Move.Card) + ' Job: ' + varchar(Move.Job));
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Send Email.
   */
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;
   EmailClass.EmailType = 24;
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'ACDO';
   EmailClass.Subject = 'Activity Threshold Exceeded by ' + DOp.Description;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                         'PT=' + VARCHAR(CurObject.Threshold)  + ';;' +
                         'NO=' + VARCHAR(ActivityCnt) + ';;' +
                         'DELAYPOP=' + VARCHAR(CurObject.DelayPopup) + ';;';
   EmailClass.Message2 = '';
   EmailClass.Template = 'DOActivityThreshold.html';
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      Message 'Unable to notify ACDO of Activity Threshold exceeded';
   ENDIF;

   RETURN;
END;

/*===================================================================
** Log Out the current operator
*/
METHOD LogOut (
   RaiseEvent = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
BEGIN
   RetCode = CALLPROC SOA_DOLogOut (Operator = CurObject.Object,
                                    Machine = CurObject.Machine,
                                    Logout = Date('now'));
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ELSE
      /* 
      **  This event will now shutdown applications.
      */
      IF RaiseEvent = TRUE THEN
         ControlText = 'LOGOUT;' + 
                       CurObject.Machine + ';' + 
                       VARCHAR(CurObject.Object) + ';';
         CALLPROC DDB_RaiseDBEvent (DBEventName = 'SOA_DOLogInOut',
                                DBEventText = ControlText);
      ENDIF;
      CALLPROC DDB_COMMIT;  

      CurObject.Object  = 0; 
      CurObject.Name = '';
      CurObject.Description = '';
      CurObject.LoginTime = NULL;
      CurObject.LoginName = '';
      CurObject.Type = 0;
      CurObject.Initials = '';

/*
**  Set DBMOperator in case user accesses Udb Access.
*/
      DBMOperator.Object = CurObject.Object;
      DBMOperator.Name   = CurObject.Name;
      DBMOperator.Description = CurObject.Description;
      DBMOperator.LoginTime = CurObject.LoginTime;
      DBMOperator.Type = CurObject.Type;
      DBMOperator.Initials = CurObject.Initials;

      RETURN (PU_OK);
   ENDIF;
END;


/*===================================================================
** Record Warning Backout
*/
METHOD RecordBackOut (
   WarningText = VARCHAR(1000) NOT NULL WITH DEFAULT
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   BackOutCount = INTEGER NOT NULL WITH DEFAULT;
   DBEventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   EmailClass = EmailNotificationClass DEFAULT NULL;
   EventID = INTEGER NOT NULL WITH DEFAULT;
   Message1 = VARCHAR(200) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   RedOverride = INTEGER NOT NULL WITH DEFAULT;
   RequestID = INTEGER NOT NULL WITH DEFAULT;
   Warnings = ARRAY OF WarningClass;
   LimitWarningSize = INTEGER NOT NULL WITH DEFAULT;
   WarningCounted = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Only Record BackOut if there is a target level
*/
   IF CurObject.TargetBackoutLevel = 0 THEN
      RETURN;
   ENDIF;

   BackOutCount = CALLPROC SOA_WBCountUpd (
                   Operator = CurObject.Object,
                   ShiftID = CurObject.ShiftID);
   IF BackOutCount < 0 THEN 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
              'ERROR: Not able to increase Warning Backout Count. ',
                           TraceMessage = 
              'DistrictOperatorClass Method RecordBackout: Unable to increase warning backout count ' +
              'for Operator:' + VARCHAR(CurObject.Object)
                          );
      RETURN;
   ELSE 
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Send Email to ACDO if targetbackout level reached or exceeded.
*/   
   IF BackOutCount >= CurObject.TargetBackoutLevel THEN
/*
** Email code cut, paste, modified from BugReport app
** get the next email notification id
*/
      RequestID = 0;
      SELECT :RequestID = MAX(RequestID) + 1
      FROM   FMS_EmailNotification;
/*
** save report to the database
*/
      Message1 = 'Text1=' + 'Warning Backout Level of ' + VARCHAR(CurObject.TargetBackoutLevel) + 
                 ' for ' + DOp.Description + ' has been reached or exceeded with ' +
                 'warning backout #' + VARCHAR(BackOutCount) + '.;;';
/* 
** Load warnings for this operator since login in reverse order 
*/
      Warnings.Clear();
      i = 1;
      SELECT :Warnings[i].Logdate = LogDate,
             :Warnings[i].WarningType = WarningType,
             :Warnings[i].WarningText = WarningText
      FROM   SOA_Warning
      WHERE  LogDate >= :CurObject.LoginTime AND
             Operator = :CurObject.Object
      ORDER BY LogDate DESC
      BEGIN 
         i = i + 1;
      END;
      
      IF i > 6 THEN
         LimitWarningSize = TRUE;
      ELSE
         LimitWarningSize = FALSE;
      ENDIF;
/*
** Rebuild Warning Text to include warning type = 0 (yellow cancel) and all warning type = 1 (yellow ok) after warning type = 3 (red cancel)
*/
      RedOverride = FALSE;
      WarningCounted = FALSE;
      WarningText = '';
      FOR i = 1 TO Warnings.LastRow DO
         IF Warnings[i].WarningType = 0 THEN
            IF LimitWarningSize = TRUE THEN
               WarningText = WarningText + VARCHAR(Warnings[i].LogDate) + ': ' + LEFT(Warnings[i].WarningText,80) + '<br>'; 
            ELSE
               WarningText = WarningText + VARCHAR(Warnings[i].LogDate) + ': ' + Warnings[i].WarningText + '<br>';
            ENDIF;
            RedOverride = FALSE;
            WarningCounted = FALSE;
         
         ELSEIF Warnings[i].WarningType = 1 AND RedOverride = TRUE THEN
            WarningCounted = TRUE;
            IF LimitWarningSize = TRUE THEN
               WarningText = WarningText + VARCHAR(Warnings[i].LogDate) + ': ' + LEFT(Warnings[i].WarningText,80) + '<br>'; 
            ELSE
               WarningText = WarningText + VARCHAR(Warnings[i].LogDate) + ': ' + Warnings[i].WarningText + '<br>';
            ENDIF;
        
         ELSEIF Warnings[i].WarningType = 3 THEN
            RedOverride = TRUE;
            WarningCounted = FALSE;
            
         ELSEIF RedOverride = TRUE AND WarningCounted = TRUE THEN  /* This ignores WarningType=2 after two op confirm abort */
            RedOverride = FALSE;
            WarningCounted = FALSE;
         ENDIF;
      ENDFOR;  
      
      IF EmailClass IS NULL THEN
         EmailClass = EmailNotificationClass.Create();
      ENDIF;
      EmailClass.EmailType = 19;
      EmailClass.Sender = DOp.Description;
      EmailClass.Recipient = 'ACDO';
      EmailClass.Subject = 'Warning Backout Level Exceeded by ' + DOp.Description;
      EmailClass.Message1 = Message1;
      EmailClass.Message2 = 'Text2=' + WarningText + ';;';
      EmailClass.Template = 'WBExceededToCDO.html';
      EmailClass.InsertRequest();

      IF EmailClass.ReturnCode <> 0 THEN 
         CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to save Warning Backout Level Exceeded message to ACDO.',
                           TraceMessage =
                  'DistrictOperatorClass Method RecordBackout: Unable to alert ACDO of excess warning backouts ' +
                  'for Operator:' + VARCHAR(CurObject.Object) );
      ENDIF;
  
/*
** Show DO WarningBackout PopUp if Popup trigger is set.
*/   
      IF CurObject.TargetBackoutPopupTrigger = TRUE THEN
         CALLFRAME WarningBackoutNotify ( NotifyText = CurObject.Description + ' ' +
             'Number of Warning Backouts during this shift = ' + VARCHAR(BackOutCount) + '. ' +
             'You have reached or exceeded your established warning backout level. ' + 
             'Please use this as a reminder to be deliberate in all of your operations ' + 
             'and to fully utilize all your HPI tools.'); 
      ENDIF;
   ENDIF;   
   RETURN; 
END;

/*===================================================================
** log in operator for Warning Backout
*/
METHOD WBLogIn (
   LoginTime = DATE NOT NULL;
) =
DECLARE
   DayDate = Date NOT NULL WITH DEFAULT;
   Shift = INTEGER NOT NULL WITH DEFAULT;
   ShiftID = INTEGER NOT NULL WITH DEFAULT;
   AMLoginStart = DATE NOT NULL WITH DEFAULT;
   AMLoginEnd = DATE NOT NULL WITH DEFAULT;
   PMLoginStart = DATE NOT NULL WITH DEFAULT;
   PMLoginEND = DATE NOT NULL WITH DEFAULT;
   NextShiftID = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF CurObject.Object = 0 THEN
         CALLPROC TraceError (UserMessage =
                  '',
                           TraceMessage = VARCHAR(DATE('now')) + 
                  'DistrictOperatorClass Method WBLogin: Passed Operator ID is 0.');
         RETURN;
   ENDIF;
/*
**  Establish Operator for WarningBackout Reporting
**  Keep same login for 14 hour window
*/
      Shift = 0;
      ShiftID = 0;
      CurObject.ShiftID = 0;
      SELECT :ShiftID = ShiftID
      FROM   SOA_WarningBackout
      WHERE  Operator = :CurObject.Object AND
             LoginDate >= (:LoginTime - '14 hours');
             
      IF ShiftID > 0 THEN
         CurObject.ShiftID = ShiftID;  /*Already logged in*/
      ELSE            /* Not currently logged in, check 4:30-6:30 time period */
         SELECT :DayDate = date_trunc('day',:LoginTime);
         AMLoginStart = VARCHAR(DayDate) + ' 04:30'; 
         AMLoginEnd = VARCHAR(DayDate) + ' 06:30'; 
         PMLoginStart = VARCHAR(DayDate) + ' 16:30'; 
         PMLoginEnd = VARCHAR(DayDate) + ' 18:30'; 
         
         IF (LoginTime >= AMLoginStart AND LoginTime <= AMLoginEnd) THEN
            Shift = 1;  /*Day Shift*/
         ELSEIF (LoginTime >= PMLoginStart AND LoginTime <= PMLoginEnd) THEN
            Shift = 2;  /*Night Shift*/
         ENDIF;
/*
** Record WarningBackout Login for Day/Night Shift
*/         
         IF Shift > 0 THEN
            NextShiftID = CALLPROC Udb_NextKey (KeyName = 'OperatorShift');
            IF NextShiftID > 0 THEN
               CALLPROC DDB_COMMIT;
               
               ShiftID = CALLPROC SOA_WBLogin (
                             Operator = CurObject.Object,
                             LogInDate = LoginTime,
                             ShiftType = Shift,
                             ShiftID = NextShiftID,
                             UserName = UserName);
            ELSE
               CALLPROC DDB_ROLLBACK;
            ENDIF;
         ENDIF;
      ENDIF;    
        
      IF ShiftID > 0 THEN
         CALLPROC DDB_COMMIT;
         CurObject.ShiftID = ShiftID;   
                  
         SELECT :CurObject.TargetBackoutLevel = TargetBackoutLevel,
                :CurObject.TargetBackoutPopupTrigger = PopupTrigger
         FROM   SOA_WarningBackOutTarget
         WHERE  Operator = :CurObject.Object;  
      ELSE
         CALLPROC DDB_ROLLBACK;    
      ENDIF;

      RETURN;
END;

