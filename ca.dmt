/*
**
**      Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    SOA
**  Class:          SDS_Card
**
**  Date:       Author   Description
** ----------------------------------
**  03/22/05    em       Created
**  07/25/07    em       Modified to support multiple mains per card.
**  08/13/07    em       Valves split from Mains to their own table
**  01/17/08    em       Set type of card for Non-SoleAuthority card.
**  12/29/08    ysp      Add ArchiveCard attribute for App Server
**  10/07/09    em       Backing out Special Instruction
**  02/01/13    em       Let NewSteamCard set SoleAuhority Type of Card. 
*/
METHOD LoadCard(
   Card	= INTEGER NOT NULL
)=
DECLARE
   j          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF Card = 0 THEN
       CurObject.Card = 0;
       RETURN(CurObject);
   ENDIF;

   CurMethod.SendSuperClass();
/*
** Read the card in
*/   
   IF CurObject.ArchiveCard = FALSE THEN  
      SELECT  
           :CurObject.MSONumber = MSONumber,
           :CurObject.SoleAuthority = SoleAuthority,
           :CurObject.Station = Station,
           :CurObject.StationName = StationName,
           :CurObject.CardClass = CardClass,
           :CurObject.CardClassName = CardClassName,
           :CurObject.Status = Status,
           :CurObject.Opened = Opened,
           :CurObject.Activated = Activated,
           :CurObject.Closed = Closed,
           :CurObject.Card = Card,
           :CurObject.PreparedBy = PreparedBy,
           :CurObject.CheckedBy = CheckedBy
      FROM    SDS_Card
      WHERE   Card = :Card;

      j = 1;
      SELECT  
           :CurObject.Main[j].Main = M.Main,
           :CurObject.Main[j].MainName = M.MainName,
           :CurObject.Main[j].ISOValve = V.ISOValve,
           :CurObject.Main[j].ISOValveName = V.ISOValveName,
           :CurObject.Main[j].ISOValveStatus = V.ISOValveStatus
      FROM    SDS_CardMain M, SDS_CardMainValve V
      WHERE   M.Card = :Card AND
              M.Card = V.Card AND
              M.Main = V.Main
      ORDER BY 2
      BEGIN
/* 
** For non-sole authority card, this select will not return any values because the
** Card Valve table is empty for the card.
*/
         j = j + 1;
      END;
   ELSE
      SELECT 
           :CurObject.MSONumber = MSONumber,
           :CurObject.SoleAuthority = SoleAuthority,
           :CurObject.Station = Station,
           :CurObject.StationName = StationName,
           :CurObject.CardClass = CardClass,
           :CurObject.CardClassName = CardClassName,
           :CurObject.Status = Status,
           :CurObject.Opened = Opened,
           :CurObject.Activated = Activated,
           :CurObject.Closed = Closed,
           :CurObject.Card = Card,
           :CurObject.PreparedBy = PreparedBy,
           :CurObject.CheckedBy = CheckedBy
      FROM    SDS_Card
      WHERE   Card = :Card;

      j = 1;
      SELECT  
           :CurObject.Main[j].Main = M.Main,
           :CurObject.Main[j].MainName = M.MainName,
           :CurObject.Main[j].ISOValve = V.ISOValve,
           :CurObject.Main[j].ISOValveName = V.ISOValveName,
           :CurObject.Main[j].ISOValveStatus = V.ISOValveStatus
      FROM    SDS_CardMain M, SDS_CardMainValve V
      WHERE   M.Card = :Card AND
              M.Card = V.Card AND
              M.Main = V.Main
      ORDER BY 2
      BEGIN
         j = j + 1;
      END;
   ENDIF;

   RETURN(CurObject);
END;


METHOD InsertCard(
)=
DECLARE
   j          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   PoolObject = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Create the Card
*/
   PoolObject = 0;
   CurObject.Card = CALLPROC Udb_NextKey(KeyName = 'Card');
   IF CurObject.Card <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to generic card key.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDS;InsertCard; Unable to generic card key.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Get the ISO Valve for all the Mains.  If the card is Sole Authority,
** then produce a generic main object.
*/
   IF CurObject.SoleAuthority = TRUE THEN

      FOR j = 1 TO CurObject.Main.LastRow() DO
         k = 1;
         REPEATED
         SELECT  :CurObject.Main[j].Valve[k].ISOValve = G.Member,
                 :CurObject.Main[j].Valve[k].ISOValveName = O.Name,
                 :CurObject.Main[j].Valve[k].ISOValveStatus = S.CurrentlyOpen
         FROM    Udb_Grouping G,
                 Udb_Object O,
                 Udb_Switch S
         WHERE   G.Grouping = :CurObject.Main[j].Main AND
                 G.Relationship = :Interaction$SourcePosition AND
                 G.Member = O.Object AND
                 O.Object = S.Object
         BEGIN
            k = k + 1;
         END;     
   
         IF CurObject.Main[j].Valve.LastRow() = 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Datababase not setup properly.  ' +
             'Main ' + CurObject.Main[j].MainName +
             ' does not have a Source Position ISO Valve relationship.',
                           TraceMessage =
             'CardSDS;InsertCard; Card insert problem. ' +
             'Main ' + CurObject.Main[j].MainName + ' does not have a Source ' +
             'Position ISO Valve relationship.'
             );
            CurObject.Card = 0;
            RETURN CurObject;
         ENDIF;
      ENDFOR;

   ELSE
      CurObject.TypeOfCard = TypeOfCard$SteamNSA;
/*  
** Here we get a generic main from the pool. 
*/
      SELECT :PoolObject = MIN(Object)
      FROM   Udb_Object 
      WHERE  Type = :Type$Main AND
             PrimaryGrouping = :Unused$EquipTypePool AND
             Name = VARCHAR(Object);

      IF PoolObject = 0 THEN      
            CALLPROC TraceError (UserMessage = 
             'ERROR: Generic Pool for Non-Sole Authority card main ' +
             'is empty.  Unable to build a new non-sole authority card.', 
                           TraceMessage =
             'CardSDS;InsertCard; Card insert problem. ' +
             'Generic Pool for Non-Sole Authority card main ' +
             'is empty.'
             );
            CurObject.Card = 0;
            RETURN CurObject;
      ELSE
            CurObject.Main[1].Main = PoolObject;
            CurObject.Main[1].MainName = 'Non-SoleAuth ' + VARCHAR(PoolObject);

            RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = PoolObject,
                         Type = Type$Main,
                         TypeName = 'Main',
                         PrimaryGrouping = 0,                              
                         PrimaryGroupingName = '',
                         Name = CurObject.Main[1].MainName,
                         Description = CurObject.Main[1].MainName,
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM'); 
   
            IF RetCode < 0 THEN    
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to take generic pool object from the Non-Sole Auth Main Pool.', 
                           TraceMessage =
             'CardSDS;InsertCard; Card insert problem. ' +
             'Unable to take generic pool object from the Non-Sole Auth Main Pool.'
             );
               CurObject.Card = 0;
               RETURN CurObject;                 
            ENDIF; 

            RetCode = CALLPROC Udb_GroupingDel (
                         Member = PoolObject,
                         Relationship = Interaction$MemberOf,
                         Grouping = Unused$EquipTypePool);  
                
            IF RetCode < 0 THEN    
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to remove generic pool object from the unused Pool.', 
                           TraceMessage =
             'CardSDS;InsertCard; Card insert problem. ' +
             'Unable to remove generic pool object from the unused Pool.'
             );
               CurObject.Card = 0;
               RETURN CurObject;                 
            ENDIF; 
            CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
** Insert card info into SDS_Card. No commit is done until
** card info has been inserted into SOA_Card.
*/
   CurObject.Application = Application$SDS;
   CurObject.Status = Card$Open;
   CurObject.Opened = 'now';

   RetCode = CALLPROC SDS_CardIns   (Card = CurObject.Card,
                                     SoleAuthority = CurObject.SoleAuthority,
                                     MSONumber = CurObject.MSONumber,
                                     CardClass = CurObject.CardClass,
                                     CardClassName = CurObject.CardClassName,
                                     Station = CurObject.Station,
                                     StationName = CurObject.StationName,
                                     Status = Card$Open,
                                     Opened = CurObject.Opened,
                                     PreparedBy = DOp.Description
                                     );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;InsertCard; Card insert failed.'
             );
      IF PoolObject <> 0 THEN
         CALLPROC ReturnPoolObject (Object = PoolObject,ObjectType = Type$Main);
      ENDIF;
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
/*
** Now insert the mains for the card
*/
   FOR j = 1 TO CurObject.Main.LastRow() DO

      RetCode = CALLPROC SDS_CardMainIns   (Card = CurObject.Card,
                                     Main = CurObject.Main[j].Main,
                                     MainName = CurObject.Main[j].MainName
                                     );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card main.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;InsertCard; Card main insert failed.'
             );
         IF PoolObject <> 0 THEN
            CALLPROC ReturnPoolObject (Object = PoolObject,ObjectType = Type$Main);
         ENDIF;
         CurObject.Card = 0;
         RETURN CurObject;
      ENDIF;

      FOR k = 1 TO CurObject.Main[j].Valve.LastRow() DO

         RetCode = CALLPROC SDS_CardMainValveIns   (Card = CurObject.Card,
                                     Main = CurObject.Main[j].Main,
                                     ISOValve = CurObject.Main[j].Valve[k].ISOValve,
                                     ISOValveStatus = CurObject.Main[j].Valve[k].ISOValveStatus,
                                     ISOValveName = CurObject.Main[j].Valve[k].ISOValveName
                                     );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card main iso valve.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;InsertCard; Card main iso valve insert failed.'
             );
            IF PoolObject <> 0 THEN
               CALLPROC ReturnPoolObject (Object = PoolObject,ObjectType = Type$Main);
            ENDIF;
            CurObject.Card = 0;
            RETURN CurObject;
         ENDIF;
      ENDFOR;

   ENDFOR;
   CurMethod.SendSuperClass();

   CurObject.ArchiveCard = FALSE;
   ArchiveCard = FALSE;
   RETURN CurObject;
END;


METHOD AddMain(
)=
DECLARE
   j          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(200) NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   MainName   = VARCHAR(40) NOT NULL WITH DEFAULT;
   PoolObject = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Get the ISO Valve for all the Mains.  If the card is Sole Authority,
** then produce a generic main object.
*/
   IF CurObject.SoleAuthority = TRUE THEN

      FOR j = 1 TO CurObject.Main.LastRow() DO
         k = 1;
         REPEATED
         SELECT  :CurObject.Main[j].Valve[k].ISOValve = G.Member,
                 :CurObject.Main[j].Valve[k].ISOValveName = O.Name,
                 :CurObject.Main[j].Valve[k].ISOValveStatus = S.CurrentlyOpen
         FROM    Udb_Grouping G,
                 Udb_Object O,
                 Udb_Switch S
         WHERE   G.Grouping = :CurObject.Main[j].Main AND
                 G.Relationship = :Interaction$SourcePosition AND
                 G.Member = O.Object AND
                 O.Object = S.Object
         BEGIN
            k = k + 1;
         END;     
   
         IF CurObject.Main[j].Valve.LastRow() = 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Datababase not setup properly.  ' +
             'Main ' + CurObject.Main[j].MainName +
             ' does not have a Source Position ISO Valve relationship.',
                           TraceMessage =
             'CardSDS;AddMain; Main insert problem. ' +
             'Main ' + CurObject.Main[j].MainName + ' does not have a Source ' +
             'Position ISO Valve relationship.'
             );
            RETURN PU_CANCEL;
         ENDIF;
      ENDFOR;

   ENDIF;
/*
** Add the mains to the card
*/
   FOR j = 1 TO CurObject.Main.LastRow() DO

      RetCode = CALLPROC SDS_CardMainIns   (Card = CurObject.Card,
                                     Main = CurObject.Main[j].Main,
                                     MainName = CurObject.Main[j].MainName
                                     );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card main.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;AddMain; Card main insert failed.'
             );
         RETURN PU_CANCEL;
      ENDIF;

      FOR k = 1 TO CurObject.Main[j].Valve.LastRow() DO

         RetCode = CALLPROC SDS_CardMainValveIns   (Card = CurObject.Card,
                                     Main = CurObject.Main[j].Main,
                                     ISOValve = CurObject.Main[j].Valve[k].ISOValve,
                                     ISOValveStatus = CurObject.Main[j].Valve[k].ISOValveStatus,
                                     ISOValveName = CurObject.Main[j].Valve[k].ISOValveName
                                     );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card main iso valve.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;AddMain; Card main iso valve insert failed.'
             );
            RETURN PU_CANCEL;
         ENDIF;
      ENDFOR;

      IF CurObject.Status >= Card$Active AND CurObject.Status < Card$Closed THEN
         RetCode = CALLPROC SDS_AddActiveMain (Card = CurObject.Card,
                                  Main = CurObject.Main[j].Main);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert SDS card active main.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;AddMain; Card active main insert failed.'
             );
            RETURN PU_CANCEL;
         ENDIF;
/*
** Build new active card name
*/   
         CardName = '';
         SELECT :MainName = MainName
         FROM   SDS_CardMain
         WHERE  Card = :CurObject.Card
         ORDER BY MainName
         BEGIN
            IF CardName = '' THEN
               CardName = MainName;
            ELSE
               CardName = CardName + ', ' + MainName;
            ENDIF; 
         END;

         RetCode = SOA_ActiveCardNameUpd (
                      Card = CurObject.Card,
                      CardName = CardName);

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update active card name.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSDSS;AddMain; Active Card Main Name update failed.'
             );
            RETURN PU_CANCEL;
         ENDIF;

         CALLPROC SOA_LogIns (
                  Card = CurObject.Card,
                  SwitchingItem = 0,
                  Job = NULL,
                  Time = DATE('now'),
                  UserName = UserName,
                  Item = 'NewMain',
                  Old = 'Mains added to card, now:',
                  New = CardName);
      ENDIF;
   ENDFOR;
   RETURN PU_OK;
END;

