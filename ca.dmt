METHOD LoadClosedItems (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.CList.Clear();

   IF CurObject.Filter = 1 THEN
       IF CurObject.CardFilter IS NULL THEN
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'Please specify the card for closed items.';
          RETURN;
       ENDIF;
 
       i = 1;
       SELECT :CurObject.CList[i].Equip      = J.Equip,
              :CurObject.CList[i].TOIssued   = J.TOIssued,
              :CurObject.CList[i].RSComplete = J.RSComplete,
              :CurObject.CList[i].TOMove     = J.TOMove,
              :CurObject.CList[i].SwitchingItem = J.SwitchingItem,
              :CurObject.CList[i].MoveCategory = J.MoveCategory,
              :CurObject.CList[i].Job = J.Job
       FROM   SOA_ArchiveJob J
       WHERE  J.Card = :CurObject.CardFilter AND
              J.MoveCategory IN (:MoveCategory$SwitchingItem,
                                 :MoveCategory$InformationItem,
                                 :MoveCategory$InServiceWP) 
       ORDER BY RSComplete DESC
       BEGIN       
          i = i + 1; 
       END;
       CALLPROC DDB_ROLLBACK;

       IF iirowcount = 0 THEN
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'There are no closed items for this substation log card.';
          RETURN;
       ENDIF;
    
    ELSEIF CurObject.Filter = 2 THEN

       IF CurObject.CardFilter IS NULL OR CurObject.EquipFilter IS NULL THEN
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'Please specify the card and equipment.';
          RETURN;
       ENDIF;
         
       i = 1;
       REPEATED
       SELECT DISTINCT 
             :CurObject.CList[i].TOIssued   = JJ.TOIssued,
             :CurObject.CList[i].RSComplete = JJ.RSComplete,
             :CurObject.CList[i].TOMove     = JJ.TOMove,
             :CurObject.CList[i].SwitchingItem = JJ.SwitchingItem,
             :CurObject.CList[i].MoveCategory = JJ.MoveCategory,
             :CurObject.CList[i].Job = JJ.Job
       FROM   SOA_ArchiveJob J,
              SOA_ArchiveJob JJ
       WHERE  J.Card       = :CurObject.CardFilter AND
              J.Equip      = :CurObject.EquipFilter AND
              J.SwitchingItem = JJ.Job
       ORDER BY SwitchingItem
       BEGIN       
             i = i + 1; 
       END;
       CALLPROC DDB_ROLLBACK;

       IF iirowcount = 0 THEN
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'There are no closed items containing this equipment in this card.';
          RETURN;
       ENDIF;

   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please specify the card number.';
      RETURN;
   ENDIF;

   RETURN;
END;

METHOD LoadEquipList (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN

   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Archive = TRUE THEN
       i = 1;
       SELECT DISTINCT  
             :CurObject.EList[i].EquipClassName  = J.EquipClassName,
             :CurObject.EList[i].EquipName = J.EquipName,
             :CurObject.EList[i].Equip = J.Equip, 
             :CurObject.EList[i].EquipName = J.EquipName,
             :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName
       FROM  SOA_ArchiveJob J,
             Udb_Object O
       WHERE J.Card = :CurObject.CardFilter AND
             J.Equip <> 0 AND
             O.Object = J.Equip   
       BEGIN
          i = i + 1;
       END;
   ELSE
       i = 1;
       SELECT DISTINCT  
             :CurObject.EList[i].EquipClassName  = J.EquipClassName,
             :CurObject.EList[i].EquipClass = J.EquipClass,
             :CurObject.EList[i].Equip = J.Equip, 
             :CurObject.EList[i].EquipName = J.EquipName,
             :CurObject.EList[i].PrimaryGroupingName = O.PrimaryGroupingName
       FROM  SOA_JobControl JC,
             SOA_Job J,
             Udb_Object O
       WHERE JC.Card = :CurObject.CardFilter AND
             JC.Job = J.Job AND 
             J.Equip <> 0 AND
             O.Object = J.Equip
       BEGIN
          i = i + 1;
       END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   RETURN;
END;

METHOD LoadCard (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.C = CurObject.C.LoadCard(Card = CurObject.Card);   
      
   RETURN;
END;

METHOD LoadActiveItems (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load switching item data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.CList.Clear();

   IF CurObject.CardFilter IS NULL THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please specify the card for active items.';
      RETURN;
   ENDIF;
 
   i = 1;
   SELECT :CurObject.CList[i].Equip      = J.Equip,
          :CurObject.CList[i].TOIssued   = J.TOIssued,
          :CurObject.CList[i].RSComplete = J.RSComplete,
          :CurObject.CList[i].TOMove     = J.TOMove,
          :CurObject.CList[i].MoveCategory = J.MoveCategory,
          :CurObject.CList[i].Job = J.Job,
          :CurObject.CList[i].Seq = JC.Seq
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :CurObject.CardFilter AND
	  JC.Job = J.Job AND
          J.Status <> 'Del' AND
          J.SWItemStatus = :Card$Active AND
          J.MoveCategory IN (:MoveCategory$SwitchingItem,
                             :MoveCategory$InformationItem) 
   ORDER BY Seq
   BEGIN       
          i = i + 1; 
   END;
   CALLPROC DDB_ROLLBACK;

   IF iirowcount = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'There are no active items for this substation log card.';
   ENDIF;
    
   RETURN;
END;

METHOD IsArchivedItem(
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.Archive = 1;

   SELECT :CurObject.Archive = 0
   FROM   SOA_Job
   WHERE  Job = :CurObject.SwitchingItem;

   RETURN;
END;

METHOD LoadBusFaultOutages(
)=
DECLARE
   i = INTEGER NOT NULL;
   BFOASE = BusFaultOutage_ASE;
ENDDECLARE
BEGIN
   BFOASE.LoadBFCMatrices();
   BFOASE.FilterType = CurObject.BFFilter;
   BFOASE.FilterObject = CurObject.C.Substation;
   BFOASE.LoadOutageList(ActiveOutage = TRUE);

   CurObject.BFOList = BFOASE.BFOList.Duplicate();

   CurObject.ReturnCode = BFOASE.ReturnCode;
   CurObject.ErrorMessage = BFOASE.ErrorMessage;
END;

