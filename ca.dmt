/*
**
**  Copyright c 2014 Pateric Software LLC.  All rights reserved.
**  
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          SWPOutageReport
**
**  Date:       Version Description
** ----------------------------------
**  09/15/14  ysp Created. 
**  04/10/15  ysp Add UpdateAfterNewPermit method
**  09/08/17  ysp replaced obsolete table OSS_WorkPermit with SOA_SWPPermit
**  10/16/17  em  Renaming OutageReport for new OSS interface
*/
METHOD UpdateAfterNewPermit(
) =
DECLARE
   ActualReturnDate = DATE DEFAULT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Status = Order$Opened THEN
      CurObject.Status = Order$Acknowledged;
      CurObject.UpdateStatus();
      IF CurObject.ReturnCode <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   
   SELECT :ActualReturnDate = ActualReturnDate 
   FROM   SOA_SWPOutageReport
   WHERE  SWPNumber = :CurObject.SWPNumber;
   CALLPROC DDB_ROLLBACK;

   IF ActualReturnDate IS NOT NULL THEN
      /*
      ** Once the SWP's last permit is returned and if a new work permit is 
      ** created for the same SWP number, the application 
      ** will re-open the actual outage end time and link the new work 
      ** permit to the existing outage.
      */
      CurObject.ResetActualReturnDate();
      CurObject.Status = Order$Acknowledged;
      CurObject.UpdateStatus();
      IF CurObject.ReturnCode <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   
   RETURN;
END;
   
METHOD LinkPermitToReport(
   Move = Job
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
   WorkItem  = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** This method is called when a new permit is added to a card by DO
*/
   /*
   ** Use work permits primary equipment as the key to mapping multiple work permits 
   ** to the same outage:
   ** if the equipment of this new work permit is associated with a scheduled outage (SWP),
   ** the permit will be linked to this scheduled outage and inserted into the SWP/WP Reference table.
   */
   CurObject.SWPNumber = '';
   WorkItem = 0;
   SELECT :CurObject.SWPNumber = R.SWPNumber,
          :WorkItem = P.WorkItem
   FROM   SOA_Job J,
          SOA_JobControl JC,
          SOA_SWPPermit P,
          SOA_SWPOutageReport R   
   WHERE  J.Equip = :Move.Equip AND
          J.Job <> :Move.Job AND
          J.Job = JC.Job AND
          JC.StepPair IN (:StepHeading$TestPermit, :StepHeading$WorkPermit) AND
          JC.Job = P.PermitJobID AND
          P.SWPNumber = R.SWPNumber AND
          R.ActualReturnDate IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.SWPNumber <> '' THEN
      RetCode = CALLPROC SOA_SWPPermitIns (
                         SWPNumber = CurObject.SWPNumber,
                         WorkItem = WorkItem,
                         PermitJobID = Move.Job);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.LinkPermitToReport;' + 
                  ' ERROR: Failed to save SWP ' + CurObject.SWPNumber + 
                  ' and PermitJobID ' + VARCHAR(Move.Job) + ' in SWP/WP reference table');
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;          
   RETURN PU_OK;       
END;

METHOD DeletePermitFromReport(
   Move = Job
)=
DECLARE
   i        = INTEGER NOT NULL WITH DEFAULT;
   k        = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** This method is called when a permit is deleted from a card.
*/
   IF Move.StepPair <> StepHeading$TestPermit AND
      Move.StepPair <> StepHeading$WorkPermit THEN
      RETURN PU_OK;
   ENDIF;

   RetCode = CALLPROC SOA_SWPPermitDel(PermitJobID = Move.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.DeletePermitFromReport;' + 
               ' ERROR: Failed to delete PermitJobID ' + VARCHAR(Move.Job) + ' from SWP/WP reference table');
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;          

   RETURN PU_OK;       
END;

METHOD SetActualOutageDate(
   JIP = JobInProgress                /* Job being processed in PromptSetCurrentlyOpen */
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   OutageDate = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF JIP.Equip = 0 THEN
      RETURN;
   ENDIF;
/*
** check if this breaker is on a card where a scheduled outage is being managed. 
** If so, and if this is the first breaker to open (the SWP Actual Outage Date = NULL), 
** the takeout restore time is set as the Actual Outage Date for the associated SWP
*/
   CurObject.SWPNumber = '';
   SELECT :CurObject.SWPNumber = R.SWPNumber
   FROM   SOA_JobControl JC1,
          SOA_JobControl JC2,
          SOA_SWPPermit P,
          SOA_SWPOutageReport R
   WHERE  JC1.Job = :JIP.Job AND
          JC1.Card = JC2.Card AND
          JC1.SwitchingItem = JC2.SwitchingItem AND
          JC2.Job = P.PermitJobID AND
          P.SWPNumber = R.SWPNumber AND
          R.ActualOutageDate IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.SWPNumber = '' THEN
      RETURN;
   ENDIF;

   IF JIP.Status = Job$TakeOut THEN
      OutageDate = IFNULL(JIP.TOComplete, DATE('NOW'));

   ELSEIF JIP.Status = Job$Restore THEN
      OutageDate = IFNULL(JIP.RSComplete, DATE('NOW'));
   ENDIF;

   RetCode = CALLPROC SOA_SWPActualDateUpd(
                      SWPNumber	= CurObject.SWPNumber,
                      FieldName = 'ActualOutageDate',
                      FieldValue = OutageDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.SetActualOutageDate;' + 
               ' ERROR: Failed to Actual Outage Date ' + VARCHAR(OutageDate) + ' for SWP ' + CurObject.SWPNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   /* trigger SOO monitor to get SWP details again.*/
   CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'SOA_GetSWPData',
                     EventText = VARCHAR(CurObject.SWPNumber));   
END;

METHOD ResetActualReturnDate(
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   OutageDate = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC SOA_SWPOutageReopened (
                                 SWPNumber = CurObject.SWPNumber);
   IF CurObject.ReturnCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'Failed to reset the SWP acutal return date due to database error'; 
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': SWPOutageRequest; Error - failed to reset ' + 
                'acutal return date for SWP ' + CurObject.SWPNumber);
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;          
   RETURN;
END;

METHOD SetActualWorkIssueDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   ISWP       = INTEGER NOT NULL WITH DEFAULT;
   IssueDate  = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** The SWP Actual Work Issue Time is set to the date/time when the first work permit 
** is issued by the DO.  This work permit may be rejected and re-issued, but the initial 
** issuance will remain as the work issue time to avoid the District Operator from 
** being charged with Delay. 
** In the case where the first work permit for the outage is a pre-issued permit, 
** the pre-issue shift start time will be used as the actual Work Issue Time.
*/
   CurObject.FirstIssuedPermit = 0;
   CurObject.SWPNumber = '';

   SELECT :CurObject.SWPNumber = P.SWPNumber
   FROM   SOA_SWPPermit P,
          SOA_SWPOutageReport R
   WHERE  P.PermitJobID = :JIP.Job AND
          P.SWPNumber = R.SWPNumber AND
          R.ActualWorkIssueDate IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.SWPNumber = '' THEN
      RETURN;
   ENDIF;
   
/*
** Check if this is an ISWP, must set the status for it
*/
   ISWP = 0;
   SELECT :ISWP = ISPermit,
          :IssueDate = ShiftStartTime 
   FROM   SOA_InServicePermit
   WHERE  Application = :Application$SLC AND
          Job = :JIP.Job AND
          PreIssued = 1;
   CALLPROC DDB_ROLLBACK;

   IF ISWP = 0 THEN
      IssueDate = IFNULL(JIP.TOIssued, DATE('NOW')); 
   ENDIF;

   RetCode = CALLPROC SOA_SWPActualDateUpd(
                      SWPNumber	= CurObject.SWPNumber,
                      FieldName = 'ActualWorkIssueDate',
                      FieldValue = IssueDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.SetActualWorkIssueDate;' + 
               ' ERROR: Failed to Actual Work Issue Date ' + VARCHAR(IssueDate) + ' for SWP ' + CurObject.SWPNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** FirstIssuedPermit attribute is useful only when this permit is issued verbally. It is
** used to set Actual Start Date.
*/
   CurObject.FirstIssuedPermit = JIP.Job;
END;

METHOD SetActualStartDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   StartDate  = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF CurObject.FirstIssuedPermit = JIP.Job THEN
      /* do nothing. Use the existing SWPNumber value */
   ELSE
      CurObject.SWPNumber = '';
      SELECT :CurObject.SWPNumber = P.SWPNumber
      FROM   SOA_SWPPermit P,
             SOA_SWPOutageReport R
      WHERE  P.PermitJobID = :JIP.Job AND
             P.SWPNumber = R.SWPNumber AND
             R.ActualStartDate IS NULL;
      CALLPROC DDB_ROLLBACK;       
   ENDIF;

   IF CurObject.SWPNumber = '' THEN
      RETURN;
   ENDIF;

   StartDate = IFNULL(JIP.TOIssued, DATE('NOW')); 
   RetCode = CALLPROC SOA_SWPActualDateUpd(
                      SWPNumber	= CurObject.SWPNumber,
                      FieldName = 'ActualStartDate',
                      FieldValue = StartDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.SetActualStartDate;' + 
               ' ERROR: Failed to Actual Start Date ' + VARCHAR(StartDate) + ' for SWP ' + CurObject.SWPNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

METHOD SetActualReturnDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   IssueDate  = DATE DEFAULT NULL;
   StartDate  = DATE DEFAULT NULL;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** As work permits are returned Complete, the SWP/WP Reference table will be evaluated 
** to check if it is the last work permit. If so, the SWP's Actual Return Date is set 
** to the date/time when the last work permit is returned Complete.
*/
   /*
   ** At first, check if this permit is in an outstanding SWP.
   */
   CurObject.SWPNumber = '';
   SELECT :CurObject.SWPNumber = P.SWPNumber,
          :IssueDate = R.ActualWorkIssueDate,
          :StartDate = R.ActualStartDate
   FROM   SOA_SWPPermit P,
          SOA_SWPOutageReport R
   WHERE  P.PermitJobID = :JIP.Job AND
          P.SWPNumber = R.SWPNumber AND
          R.ActualReturnDate IS NULL;
   CALLPROC DDB_ROLLBACK;       
   
   IF CurObject.SWPNumber = '' THEN
      RETURN;
   ENDIF;
   
   /*
   ** then, check if all permits have been returned.
   */
   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_SWPPermit P,
          SOA_Job J
   WHERE  P.SWPNumber = :CurObject.SWPNumber AND
          P.PermitJobID = J.Job AND
          J.RSComplete IS NULL;
   CALLPROC DDB_ROLLBACK;       

   IF i > 0 THEN
      RETURN;      // there are still outstanding permits.
   ENDIF;

   RetCode = CALLPROC SOA_SWPActualDateUpd(
                      SWPNumber	= CurObject.SWPNumber,
                      FieldName = 'ActualReturnDate',
                      FieldValue = JIP.RSComplete);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to Actual Return Date ' + VARCHAR(JIP.RSComplete) + ' for SWP ' + CurObject.SWPNumber);
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   /*
   ** Just in case the working group did not acknowledge any issued permit and simply 
   ** starts the work and return the permits (just like we do using the simulator),
   ** set the start date the same as the issue date.
   */
   IF StartDate IS NULL THEN
      RetCode = CALLPROC SOA_SWPActualDateUpd(
                      SWPNumber	= CurObject.SWPNumber,
                      FieldName = 'ActualStartDate',
                      FieldValue = IssueDate);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to Actual Start Date ' + VARCHAR(IssueDate) + ' for SWP ' + CurObject.SWPNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
   ENDIF;

/* 
** set the SWP status to closed if no Work Item is left unprocessed 
*/
   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_SWPPermit 
   WHERE  SWPNumber = :CurObject.SWPNumber AND
          PermitJobID = 0;
   
   IF i = 0 THEN
      CurObject.Status = Order$Closed;
      CurObject.UpdateStatus();
   ENDIF;
   
   RETURN;
END;

METHOD UpdateStatus(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ReturnCode = CALLPROC SOA_SWPStatusUpd(
               SWPNumber = CurObject.SWPNumber,
               Status = CurObject.Status,
               StatusTime = Date('Now'));

   IF CurObject.ReturnCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ErrorMessage = 'Failed to update SWP status due to database errror';
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'SWPOutageReport;' + 
            ' ERROR: Failed to update SWP status for ' + CurObject.SWPNumber);
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;

