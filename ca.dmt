**  Class:          CardTLS_ASE
**
**  Date:       Version Description
** ----------------------------------
**  08/14/06  ysp  Created; 
**  12/01/06  ysp  add LoadCircuitLog method
**  01/21/10  ysp  Remove the Route attribute from the class
**  07/03/17  ysp  add loading of incident report flag
**  05/02/18  ysp  Add UpdatePriority method
**  05/22/18  YSP  complete TO Notified move when priority is set
**  06/04/18  em   Remove Priority Attribute from closed card selection.
**  06/15/18  ysp  add loading of circuit document flag
**  09/10/18  em   Add AltLine1/2 to LoadCard
**  10/20/23  em   For closed card, load feeder and station from card and parse into list.
*/
METHOD LoadCard (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.C.Feeders.Clear();
   CurObject.C.Stations.Clear();

  /* Card information */
    IF CurObject.ArchiveCard = FALSE THEN
       SELECT  :CurObject.C.Card = Card,
               :CurObject.C.Circuit = Circuit,
               :CurObject.C.Linenumber = Linenumber,
               :CurObject.C.AltLine1 = AltLine1,
               :CurObject.C.AltLine2 = AltLine2,
               :CurObject.C.LineType = LineType,
               :CurObject.C.CardType = CardType,
               :CurObject.C.Linetypename = LineTypeName,
               :CurObject.C.Routename = RouteName,
               :CurObject.C.TroubleCategory = TroubleCategory,
               :CurObject.C.TroubleCategoryName = TroubleCategoryName,
               :CurObject.C.Functionarea = FunctionArea,
               :CurObject.C.Functionareaname = FunctionAreaName,
               :CurObject.C.Reasonforfailure = ReasonForFailure,
               :CurObject.C.ValidatedBy = ValidatedBy,
               :CurObject.C.ShowNote = ShowNote,
               :CurObject.C.Notes = Notes,
               :CurObject.C.Status = Status,
               :CurObject.C.Carrier = Carrier,
               :CurObject.C.CarrierName = CarrierName,
               :CurObject.C.Opened = Opened,
               :CurObject.C.Closed = Closed,
               :CurObject.C.Priority = Priority
       FROM    TC_Card
       WHERE   Card = :CurObject.Card;
    ELSE
       SELECT  :CurObject.C.Card = Card,
               :CurObject.C.Circuit = Circuit,
               :CurObject.C.Linenumber = Linenumber,
               :CurObject.C.AltLine1 = AltLine1,
               :CurObject.C.AltLine2 = AltLine2,
               :CurObject.C.LineType = LineType,
               :CurObject.C.CardType = CardType,
               :CurObject.C.Linetypename = LineTypeName,
               :CurObject.C.Routename = RouteName,
               :CurObject.C.TroubleCategory = TroubleCategory,
               :CurObject.C.TroubleCategoryName = TroubleCategoryName,
               :CurObject.C.Functionarea = FunctionArea,
               :CurObject.C.Functionareaname = FunctionAreaName,
               :CurObject.C.Reasonforfailure = ReasonForFailure,
               :CurObject.C.ShowNote = ShowNote,
               :CurObject.C.Notes = Notes,
               :CurObject.C.Status = Status,
               :CurObject.C.Carrier = Carrier,
               :CurObject.C.CarrierName = CarrierName,
               :CurObject.C.Opened = Opened,
               :CurObject.C.Closed = Closed
       FROM    TC_ArchiveCard
       WHERE   Card = :CurObject.Card;
    ENDIF;

    SELECT  :CurObject.C.CardNote = Note
    FROM    TC_CardNote
    WHERE   Card = :CurObject.Card;

    CALLPROC DDB_ROLLBACK;   

    IF CurObject.C.Status = 1 THEN
       CurObject.C.StatusName = 'ACTIVE';
    ELSEIF CurObject.C.Status = 2 THEN
       CurObject.C.StatusName = 'TELCO';
    ELSEIF CurObject.C.Status = 3 THEN
       CurObject.C.StatusName = 'PST';
    ELSEIF CurObject.C.Status = 4 THEN
       CurObject.C.StatusName = 'CLOSED';
    ENDIF;

    IF CurObject.C.CardType = 0 THEN
       CurObject.C.CardTypeName = 'TROUBLE';
    ELSE
       CurObject.C.CardTypeName = 'SCHEDULED';
    ENDIF;

    CurObject.Circuit = CurObject.C.Circuit;
    
    // incident report flag
    SELECT :CurObject.C.IncidentReport = COUNT(*)
    FROM   SOA_IncidentReportLInk L
    WHERE  L.Object = :CurObject.C.Circuit;

    // circuit document flag
    SELECT :CurObject.C.Documents = COUNT(*)
    FROM   TC_CircuitDocumentLInk L
    WHERE  L.Object = :CurObject.C.Circuit;
END;

METHOD LoadFeedersAndStations (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
   j             = INTEGER NOT NULL WITH DEFAULT;
   SearchText    = VARCHAR(80) NOT NULL WITH DEFAULT;
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ArchiveCard = FALSE THEN

    i = 1;
    REPEATED
    SELECT :CurObject.C.Feeders[i].Name = SQUEEZE(O.Name),
           :CurObject.C.Feeders[i].Object = O.Object
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   G.Grouping = O.Object
    AND     G.GroupingType IN ( SELECT  Type          
                                FROM    Udb_ExtendedType
                                WHERE   Supertype IN(:Type$Feeder,:Type$Network,
                                                     :Type$Line,:Type$DivisionWorkstation))
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.Member = :CurObject.Circuit
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    
    i = 1;
    REPEATED
    SELECT :CurObject.C.Stations[i].Name = O.Name,
           :CurObject.C.Stations[i].Object = O.Object
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   G.Grouping = O.Object
    AND     G.GroupingType IN ( SELECT  Type
                                FROM    Udb_ExtendedType
                                WHERE   Supertype IN (:Type$Substation,:Type$TelCircuitTerminal))
    AND     G.Relationship = :Interaction$MemberOf
    AND     G.Member = :CurObject.Circuit
    BEGIN
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;  

   ELSE
      SELECT  :CurObject.C.FeederNames = FeederNames,
              :CurObject.C.SubstationNames = SubstationNames
      FROM    TC_ArchiveCard
      WHERE   Card = :CurObject.Card;
       
      i = 1;
      SearchText = CurObject.C.FeederNames; 
      WHILE i > 0 DO
         j = LOCATE(SearchText, ',');
         IF j = SIZE(SearchText) + 1 THEN
            CurObject.C.Feeders[i].Name = SQUEEZE(SearchText);
            i = 0;
         ELSE
            CurObject.C.Feeders[i].Name = SQUEEZE(LEFT(SearchText, j-1));
            SearchText = SHIFT(SearchText, j * -1);
            i = i + 1;
         ENDIF;
      ENDWHILE;
      
      i = 1;
      SearchText = CurObject.C.SubstationNames; 
      WHILE i > 0 DO
         j = LOCATE(SearchText, ',');
         IF j = SIZE(SearchText) + 1 THEN
            CurObject.C.Stations[i].Name = SQUEEZE(SearchText);
            i = 0;
         ELSE
            CurObject.C.Stations[i].Name = SQUEEZE(LEFT(SearchText, j-1));
            SearchText = SHIFT(SearchText, j * -1);
            i = i + 1;
         ENDIF;
      ENDWHILE;
   ENDIF; 
END;

METHOD LoadCardList (
)=
DECLARE
    i = INTEGER;           /* Temporary counter  */
    vLineNumber = varchar(40) not null not default;     
    vSubstationName = varchar(40) not null not default;
    vFeederName = varchar(40) not null not default;     
    vLineTypeName = varchar(40) not null not default;   
    StatusName = varchar(40) not null not default;      
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
   
   IF CurObject.LineNumberFilter = '' THEN
      vLineNumber = '%';
   ELSEIF CurObject.Filter = 1 THEN
      vLineNumber = CurObject.LineNumberFilter + '%';
   ELSEIF CurObject.Filter = 2 THEN
      vLineNumber = CurObject.LineNumberFilter;
   ELSE
      vLineNumber = '%' + CurObject.LineNumberFilter + '%';
   ENDIF;

   IF CurObject.SubstationFilter = '' THEN
      vSubstationName = '%';
   ELSEIF CurObject.Filter = 1 THEN
      vSubstationName = CurObject.SubstationFilter + '%';
   ELSEIF CurObject.Filter = 2 THEN
      vSubstationName = CurObject.SubstationFilter; 
   ELSE
      vSubstationName = '%' + CurObject.SubstationFilter + '%';
   ENDIF;

   IF CurObject.FeederFilter = '' THEN
      vFeederName = '%';
   ELSEIF CurObject.Filter = 1 THEN
      vFeederName = CurObject.FeederFilter + '%';
   ELSEIF CurObject.Filter = 2 THEN
      vFeederName = CurObject.FeederFilter;
   ELSE
      vFeederName = '%' + CurObject.FeederFilter + '%';
   ENDIF;

   IF CurObject.LineTypeFilter = '' THEN
      vLineTypeName = '%';
   ELSEIF CurObject.Filter = 1 THEN
      vLineTypeName = CurObject.LineTypeFilter + '%';
   ELSEIF CurObject.Filter = 2 THEN
      vLineTypeName = CurObject.LineTypeFilter;
   ELSE
      vLineTypeName = '%' + CurObject.LineTypeFilter + '%';
   ENDIF;

   CurObject.CList.Clear();
   i = 1;

   IF CurObject.ArchiveCard = TRUE THEN
      SELECT  DISTINCT
          :CurObject.CList[i].Card = C.Card,
          :CurObject.CList[i].Circuit = C.Circuit,
          :CurObject.CList[i].LineNumber = C.LineNumber,
          :CurObject.CList[i].LineTypeName = C.LineTypeName,
          :CurObject.CList[i].FeederNames = C.FeederNames,
          :CurObject.CList[i].SubstationNames = C.SubstationNames,
          :CurObject.CList[i].RouteName = C.RouteName,
          :CurObject.CList[i].FunctionAreaName = C.FunctionAreaName,
          :CurObject.CList[i].Closed = C.Closed,
          :CurObject.CList[i].Notes = C.Notes
      FROM    TC_ArchiveCard C
      WHERE   C.Status = :TC_Card$Closed 
      AND     C.LineNumber like :vlinenumber
      AND     C.LineTypeName like :vlinetypename
      AND     C.FeederNames like :vfeedername
      AND     C.SubstationNames like :vsubstationname
      ORDER BY LineNumber
      BEGIN
          i = i + 1;
      END;
   ELSEIF CurObject.StatusFilter > 0 THEN
      /* load cards for TLS Online */

      IF CurObject.StatusFilter = TLS_Card$Active THEN
         StatusName = 'Active';
      ELSEIF CurObject.StatusFilter = TLS_Card$Telco THEN
         StatusName = 'TELCO';
      ELSEIF CurObject.StatusFilter = TLS_Card$PST THEN
         StatusName = 'PST';
      ENDIF;

      SELECT  DISTINCT
          :CurObject.CList[i].Card = C.Card,
          :CurObject.CList[i].Circuit = C.Circuit,
          :CurObject.CList[i].LineNumber = C.LineNumber,
          :CurObject.CList[i].LineTypeName = C.LineTypeName,
          :CurObject.CList[i].FeederNames = C.FeederNames,
          :CurObject.CList[i].SubstationNames = C.SubstationNames,
          :CurObject.CList[i].RouteName = C.RouteName,
          :CurObject.CList[i].FunctionAreaName = C.FunctionAreaName,
          :CurObject.CList[i].Status = C.Status,
          :CurObject.CList[i].Closed = C.Closed,
          :CurObject.CList[i].Notes = C.Notes
      FROM    TC_Card C
      WHERE   C.Status = :CurObject.StatusFilter
      AND     C.LineNumber like :vlinenumber
      AND     C.LineTypeName like :vlinetypename
      AND     C.FeederNames like :vfeedername
      AND     C.SubstationNames like :vsubstationname
      ORDER BY LineNumber
      BEGIN
          CurObject.CList[i].StatusName = StatusName;
          i = i + 1;
      END;
   ELSE
      SELECT  DISTINCT
          :CurObject.CList[i].Card = C.Card,
          :CurObject.CList[i].Circuit = C.Circuit,
          :CurObject.CList[i].LineNumber = C.LineNumber,
          :CurObject.CList[i].FeederNames = C.FeederNames,
          :CurObject.CList[i].SubstationNames = C.SubstationNames,
          :CurObject.CList[i].Status = C.Status
      FROM    TC_Card C
      WHERE   C.Status IN (:TLS_Card$Active,:Card$Telco,:Card$PST)
      AND     C.LineNumber like :vlinenumber
      AND     C.LineTypeName like :vlinetypename
      AND     C.FeederNames like :vfeedername
      AND     C.SubstationNames like :vsubstationname
      ORDER BY LineNumber
      BEGIN
          IF CurObject.CList[i].Status = TLS_Card$Active THEN
             CurObject.CList[i].StatusName = 'Active';
          ELSEIF CurObject.CList[i].Status = Card$Telco THEN
             CurObject.CList[i].StatusName = 'TELCO';
          ELSEIF CurObject.CList[i].Status = Card$PST THEN
             CurObject.CList[i].StatusName = 'PST';
          ENDIF;

          i = i + 1;
      END;

      /*
      **  Go through each circuit and figure out which organization has control of 
      **  the circuit.
      */
      i = 1;
      WHILE i <= CurObject.CList.LastRow() DO

           SELECT :CurObject.CList[i].OrganizationName = RS.OrganizationName
           FROM   TC_ReportStats RS
           WHERE  RS.Card = :CurObject.CList[i].Card AND
                  RS.OutService IS NOT NULL AND
                  RS.Inservice IS NULL AND
                  RS.Circuit = :CurObject.CList[i].Circuit;
           i = i + 1;
      ENDWHILE;
      CALLPROC DDB_ROLLBACK;
   ENDIF;  

   IF CurObject.CList.LastRow = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No card with the search string was found.';
   ENDIF;

   RETURN;
END;

METHOD LoadLogStatus (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the log status associated with a card/switchingitem.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   /*
   ** Look for an log entries for the current card:
   ** If the log has an 'INCOMPLETE', it will the MAX, else
   ** 'COMPLETE' will be max. If there are no logs, the
   ** default 'EMPTY' will be used.
   */
   IF CurObject.ArchiveCard = FALSE THEN
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(CL.LogStatus), 'EMPTY') 
      FROM    TC_CircuitsLog CL 
      WHERE   CL.Card = :CurObject.Card;
   ELSE
      REPEATED
      SELECT :CurObject.LogStatus = IFNULL(MAX(CL.LogStatus), 'EMPTY') 
      FROM   TC_ArchiveCircuitsLog CL 
      WHERE  CL.Card = :CurObject.Card;  
   ENDIF;
      
   RETURN;
END;

METHOD LoadTxLog (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the transaction log associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.LList.Clear();

   IF CurObject.ArchiveCard = FALSE THEN

      i = 1;
		SELECT  :CurObject.LList[i].Time = L.Time,
		        :CurObject.LList[i].TOMove = J.TOMove,
		        :CurObject.LList[i].TOOperator = J.TOOperator,
		        :CurObject.LList[i].TOOperatorName = IFNULL(J.TOOperatorName,''),
		        :CurObject.LList[i].RSMove = J.RSMove,
		        :CurObject.LList[i].RSOperator = J.RSOperator,
		        :CurObject.LList[i].RSOperatorName = IFNULL(J.RSOperatorName,''),
		        :CurObject.LList[i].Substation = J.Substation,
		        :CurObject.LList[i].SubstationName = J.SubstationName,
		        :CurObject.LList[i].UserName = L.UserName,
		        :CurObject.LList[i].Item = L.Item,
		        :CurObject.LList[i].Old = L.Old,
		        :CurObject.LList[i].New = L.New,
		        :CurObject.LList[i].Operator = L.Operator,
		        :CurObject.LList[i].OperatorName = L.OperatorName
		FROM    TC_Log L, 
		        TC_Job J
		WHERE   L.Card = :CurObject.Card AND
		        J.Job = L.Job
      UNION
	   SELECT  L.Time,
              '',
              0,
              '',
              '',
              0,
              '',
              0,
              '',
              L.UserName,
              L.Item,
              L.Old,
              L.New,
              L.Operator,
              L.OperatorName 
      FROM    TC_Log L
      WHERE   L.Card = :CurObject.Card AND
              L.Job IS NULL 
      ORDER BY Time DESC
      BEGIN
         i = i + 1;
      END;
   
   ELSE
		i = 1;
		SELECT  :CurObject.LList[i].Time = L.Time,
		        :CurObject.LList[i].TOMove = J.TOMove,
		        :CurObject.LList[i].TOOperator = J.TOOperator,
		        :CurObject.LList[i].TOOperatorName = IFNULL(J.TOOperatorName,''),
		        :CurObject.LList[i].RSMove = J.RSMove,
		        :CurObject.LList[i].RSOperator = J.RSOperator,
		        :CurObject.LList[i].RSOperatorName = IFNULL(J.RSOperatorName,''),
		        :CurObject.LList[i].Substation = J.Substation,
		        :CurObject.LList[i].SubstationName = J.SubstationName,
		        :CurObject.LList[i].UserName = L.UserName,
		        :CurObject.LList[i].Item = L.Item,
		        :CurObject.LList[i].Old = L.Old,
		        :CurObject.LList[i].New = L.New,
		        :CurObject.LList[i].Operator = L.Operator,
		        :CurObject.LList[i].OperatorName = L.OperatorName
		FROM    TC_ArchiveLog L, 
		        TC_ArchiveJob J
		WHERE   L.Card = :CurObject.Card AND
		        J.Job = L.Job
		UNION
		SELECT  L.Time,
		         '',
		         0,
		         '',
		         '',
		         0,
		         '',
		         0,
		         '',
		         L.UserName,
		         L.Item,
		         L.Old,
		         L.New, 
		         L.Operator,
		         L.OperatorName 
		 FROM    TC_ArchiveLog L
		 WHERE   L.Card = :CurObject.Card AND
		         L.Job IS NULL 
		 ORDER BY Time DESC
		 BEGIN
		     i = i + 1;
		 END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

METHOD LoadCircuitLog (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the transaction log associated with a card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.DList.Clear();

   IF CurObject.ArchiveCard = FALSE THEN
   		    
      i = 1; 
      j = 0;
      SELECT :CurObject.DList[i].Card = FL.Card, 
             :CurObject.DList[i].Log = FL.Log, 
             :CurObject.DList[i].LogStatus = FL.LogStatus, 
             :CurObject.DList[i].LogTime = FL.LogTime 
      FROM   TC_CircuitsLog FL 
      WHERE  FL.Card = :CurObject.Card 
      BEGIN 
         IF CurObject.DList[i].LogStatus = 'INCOMPLETE' THEN
             j = i;
         ENDIF;
         i = i + 1; 
      END; 
   ELSE
      	
      i = 1; 
      j = 0;
      SELECT :CurObject.DList[i].Card = FL.Card, 
             :CurObject.DList[i].Log = FL.Log, 
             :CurObject.DList[i].LogStatus = FL.LogStatus, 
             :CurObject.DList[i].LogTime = FL.LogTime 
      FROM   TC_ArchiveCircuitsLog FL 
      WHERE  FL.Card = :CurObject.Card 
      BEGIN 
         IF CurObject.DList[i].LogStatus = 'INCOMPLETE' THEN
             j = i;
         ENDIF;
         i = i + 1; 
      END;   
   ENDIF;

   IF j > 0 THEN
      CurObject.ReturnCode = 1;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END;

METHOD UpdatePriority (
)=
DECLARE
   Job = INTEGER NOT NULL WITH DEFAULT;
   Operator = INTEGER NOT NULL WITH DEFAULT;
   NewPriority = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT
ENDDECLARE
BEGIN
/* 
** this method is called from TLS Online when TO sets the priority.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.C.Card = CurObject.Card;
   
   SELECT :CurObject.C.Priority = Priority
   FROM   TC_Card
   WHERE  Card = :CurObject.C.Card;
   
   SELECT :NewPriority = INT4(Name)
   FROM   UDB_Type
   WHERE  Type = :CurObject.Priority;
      
   RetCode = CurObject.C.SetPriority(NewPriority = NewPriority,
                           UpdatedBy = CurObject.UpdatedByName);
      
   IF RetCode = FALSE THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Unable to update card priority due to database error';
      RETURN;
   ENDIF;
   
/*
** Fill in the completion time stamp on "Transmission Operator Notified" move
*/ 
   Job = 0;
   SELECT :Job = Job,
          :Operator = TOOperator
   FROM   TC_Job
   WHERE  Card = :CurObject.C.Card AND
          JobClass = :JobClass$TONotified AND
          TOIssued IS NOT NULL AND
          TOComplete IS NULL;
   	
   IF Job > 0 THEN	
      RetCode = CALLPROC TC_CompleteJob (
                    Job = Job,
                    Operator = Operator,
                    OperatorName = CurObject.UpdatedByName,
                    Complete = DATE('Now'),
                    TORS = Job$TakeOutInt);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = 'TO set priority. Failed to complete TO Notified move.');
      ELSE 
         CALLPROC DDB_COMMIT;
         
         RetCode = CALLPROC TC_LogInsert(
              Card = CurObject.C.Card
             ,Job = Job
             ,Time = date('now')
             ,Item = 'TOComplete'
             ,Old = ''
             ,New = DATE('Now')
             ,Operator = 0
             ,OperatorName = CurObject.UpdatedByName
             );
             
         CALLPROC DDB_COMMIT;                     
      ENDIF;
    ENDIF;
END;
   
   

