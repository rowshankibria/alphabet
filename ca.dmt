	Name:            XferCardLog

/* 
**	Copyright c 1997 ESCA Corporation.  All rights reserved. 
** 
**	ESCA Corporation proprietary and trade secret information. 
**	Do not copy or disclose to third parties without written 
**	permission from an officer of ESCA Corporation. 
**
**  APPLICATION: Feedercard 
**  FRAME:	XferFeederLog 
**
**  PURPOSE:	This frame is called up from the FEEDERCARD frame
**		at the time a transfer card is created if some logs were
**      created in the original card.
**      The operator should select some log entries and poke the
**      Transfer Selected Entries button to have them in the new
**      card. 
**
** 		The "EXIT" button simply returns with no action. 
** 
**  Modifications:
**    04/11/97   jfl   Created.
**    09/11/19   ysp   Close the window after logs have been transferred.
**    12/14/23   em    Copied from XferFeederLog
**    12/22/23   em    Order by Log Time descending
**    01/16/24   em    Limit Log Status to COMPLETE/INCOMPLETE when completing transfer
*/ 
INITIALIZE 
(  	OldC = INTEGER NOT NULL;              /* parameter - original card */ 
    NewC = INTEGER NOT NULL;              /* parameter - new card */ 
    SelectRow = INTEGER NOT NULL; /* Clicked RowNumber */
   	Status = INTEGER NOT NULL;    /* return status variable */ 
    FoundSelected = INTEGER NOT NULL; /* Boolean */
	i = INTEGER NOT NULL; 
	j = INTEGER NOT NULL; 
) = 
BEGIN
/*
**  Load the cardlog entries 
*/ 
	i = 1; 
	SELECT :FL_TB[i].Card = FL.Card, 
	       :FL_TB[i].Log = FL.Log, 
	       :FL_TB[i].LogStatus = FL.LogStatus, 
	       :FL_TB[i].LogTime = FL.LogTime,
	       :FL_TB[i].EnteredBy = FL.EnteredBy,
	       :FL_TB[i].EnteredByName = O.Description
	FROM   SOA_CardLog FL,
           Udb_Object O 
	WHERE  FL.Card = :OldC AND 
           FL.EnteredBy = O.Object
    UNION
	SELECT  FL.Card, 
	        FL.Log, 
	        FL.LogStatus, 
	        FL.LogTime,
	        FL.EnteredBy,
	        O.Description
	FROM   SOA_ArchiveCardLog FL,
           Udb_Object O 
	WHERE  FL.Card = :OldC AND 
           FL.EnteredBy = O.Object
    ORDER BY LogTime DESC
	BEGIN 
	    IF FL_TB[i].EnteredBy > 0 AND FL_TB[i].EnteredByName <> '' THEN
	       FL_TB[i].LogStatus = UPPER(FL_TB[i].LogStatus) + HC_NEWLINE + 'By: ' + FL_TB[i].EnteredByName;
	    ENDIF;
	    i = i + 1; 
	END; 
    CurFrame.InputFocusField = NULL;
END; 

/* 
** When a selection is made from the log menu, highlight it
** If the entry was selected already, unselect it.
*/ 
ON ChildEntry FL_TB = 
BEGIN 
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    

    SelectRow = FIELD(FL_TB).CurRow;
    IF FIELD(FL_TB[SelectRow].LogTime).IsReverse = FALSE THEN
        FIELD(FL_TB[SelectRow].LogTime).IsReverse = TRUE;
        FIELD(FL_TB[SelectRow].LogStatus).IsReverse = TRUE;
        FIELD(FL_TB[SelectRow].Log).IsReverse = TRUE;
    ELSE
        FIELD(FL_TB[SelectRow].LogTime).IsReverse = FALSE;
        FIELD(FL_TB[SelectRow].LogStatus).IsReverse = FALSE;
        FIELD(FL_TB[SelectRow].Log).IsReverse = FALSE;
    ENDIF;
    CurFrame.InputFocusField = NULL;
END; 

/* 
** Copy the log entries in the database for the new card 
*/ 
ON Click Xfr_Selected_Btn = 
BEGIN 
    /* 
    ** Loop thru the table to identify the selected entries
    ** Remove them from the table as long as they are transferred
    ** Warn the operator if no entry was selected
    */
    FoundSelected = FALSE;
    i = FL_TB.LastRow();
    WHILE i >= 1 DO
        IF FIELD(FL_TB[i].LogTime).IsReverse = TRUE THEN
            FoundSelected = TRUE;
            IF FL_TB[i].LogStatus LIKE 'COMPL%' THEN
               FL_TB[i].LogStatus = 'COMPLETE';
            ELSEIF FL_TB[i].LogStatus LIKE 'INCOMPL%' THEN
               FL_TB[i].LogStatus = 'INCOMPLETE';
            ENDIF;
            Status = SOA_CardLogIns (Card = NewC, 
                                       LogTime = FL_TB[i].LogTime, 
                                       Log = FL_TB[i].Log, 
                                       LogStatus = FL_TB[i].LogStatus,
                                       EnteredBy = FL_TB[i].EnteredBy); 
            IF (Status <> 0) THEN 
                CALLPROC DDB_ROLLBACK; 
                Message 'Could not copy Card Log.';
                CurFrame.SendUserEvent( eventname = 'deselect_le' );
                RESUME;
            ELSE 
                CALLPROC DDB_COMMIT; 
                FL_TB.RemoveRow (RowNumber = i);
            ENDIF;
        ENDIF;
        i = i - 1;
    ENDWHILE;
    IF FoundSelected = FALSE THEN
        Message 'No Log Entry was selected.';
        RESUME;
    ENDIF;
    CurFrame.InputFocusField = NULL;
    
    RETURN;
END; 

/*
** Deselect all selected entries
*/
On USEREVENT 'deselect_le' =
BEGIN 
    i = FL_TB.LastRow();
    WHILE i >= 1 DO
        FIELD(FL_TB[i].LogTime).IsReverse = FALSE;
        i = i - 1;
    ENDWHILE;
    CurFrame.InputFocusField = NULL;
END;

/* 
** Handle the CANCEL button: 
*/ 
ON Click EXIT_BTN = 
BEGIN 
	RETURN; 
END; 

/* 
** Handle the Close Window Command: 
*/ 
ON WINDOWCLOSE = 
BEGIN
	RESUME; 
END; 


