	Name:            PromptPumpOnVFDBypass

/*
**
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptSetPumpToHand
**
**  Modifications:
**  06/25/14   em  Created
**  07/30/14   em  Modified to set status directly.
*/
INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    retcode = INTEGER NOT NULL; /* return variable */
) =
BEGIN
  
      RetCode = CALLPROC Udb_PumpFieldUpd (
                Object = JIP.Equip,
                FieldName =  'ByPassOn',
                FieldValue = 1 
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Pump on VFD ByPass On.',
                           TraceMessage =
               'PromptSetACFeedRemoved: Unable to set pump VFD ByPass  ' +
               'for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ELSE
          CALLPROC DDB_COMMIT;
          RETURN (PU_OK);
      ENDIF;

END;
				 *Default Item

					 *Default Item

					 *Default Item


