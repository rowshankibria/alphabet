============================

	Name:            Check101OpenFromLoad

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          Check101OpenFromLoad  
**
**  Modifications:
**	07/30/93   em	Created 
**      11/15/02   ysp  Merge: remove C and Job as passed-ins. 
*/
PROCEDURE  Check101OpenFromLoad 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    ATSSourceEquip = ObjectSummaryClass;  
    FeederOut = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Using connectivity in Database, make sure the 101 Feeders is open
*/ 
  SELECT :i = COUNT(*)
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O,
         FMS_ObjectStatus OS 
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 1 AND      /* Terminal 1 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND      /* Terminal 2 */
         T2.Object = O.Object AND
         O.Type IN (SELECT Type
                    FROM   Udb_ExtendedType
                    WHERE  SuperType = :Type$ATS101) AND
         O.Object = OS.Object AND
         OS.Status = :Status$Open;
         CALLPROC DDB_ROLLBACK;
  
  WarningStatus = PU_OK;
  
  IF i < 1 THEN
    
    WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
	                               Job = JIP.Job,
                                       SwitchingItem = JIP.SwitchingItem,
                                       Text = 'ATS 101 Source Feeder is not open.');
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
 
  ENDIF;

  RETURN(NULL); 

END;

