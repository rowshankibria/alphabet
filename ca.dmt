ON CLICK Insert_Btn =
DECLARE

ENDDECLARE
BEGIN
   IF SelectedJobClass = 0 THEN
      MESSAGE 'Please Select Equipment, Card and Permit Move.';
      RESUME;
   ENDIF;
/* 
** Now insert the permit move into the selected card and
** raise event to load that card to the permit protection screen.
** Step Headings should be taken care of by the methods.
** The EquipClass is not important for Job Checks/Actions, but we need a valid one for the 
** step heading. 
*/
   WorkItem.CreateWorkPermit(
            TypeofCard = SelectedTypeofCard,
            Card = SelectedCard,
            CardStatus = SelectedCardStatus,
            SwitchingItem = SelectedSwitchingItem,
            Application = SelectedApplication,            
            MoveEquip = Selected,                     // FMS_Equip class
            JobClass = SelectedJobClass,
            StepPair = SelectedStepPair,
            TOMove = TOMove,
            RSMove = TOMove);
   IF WorkItem.ReturnCode <> 0 THEN
      MESSAGE WorkItem.ErrorMessage;
      RESUME;
   ENDIF;
   FIELD(WorkItem.PermitList).UpdField();  
   CALLPROC UpdateSWPStatus();
   CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
   
   CALLPROC ReloadCard();
END;

ON CHILDENTRY WorkItem.PermitList = 
BEGIN   
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    

    SelectWPRow = FIELD(WorkItem.PermitList).CurRow;
/*
**   Deselect selected rows. 
*/
    FOR i = 1 TO WorkItem.PermitList.LastRow() DO
       IF i = SelectWPRow THEN
          FIELD(WorkItem.PermitList[i].AppName).IsReverse = TRUE;
          FIELD(WorkItem.PermitList[i].CardName).IsReverse = TRUE;
          FIELD(WorkItem.PermitList[i].EquipClassName).IsReverse = TRUE;
          FIELD(WorkItem.PermitList[i].EquipName).IsReverse = TRUE;
          FIELD(WorkItem.PermitList[i].TOMove).IsReverse = TRUE;
       ELSE
          FIELD(WorkItem.PermitList[i].AppName).IsReverse = FALSE;
          FIELD(WorkItem.PermitList[i].CardName).IsReverse = FALSE;
          FIELD(WorkItem.PermitList[i].EquipClassName).IsReverse = FALSE;
          FIELD(WorkItem.PermitList[i].EquipName).IsReverse = FALSE;
          FIELD(WorkItem.PermitList[i].TOMove).IsReverse = FALSE;
        ENDIF;
    ENDFOR;
END;

ON CLICK Link_Btn = 
DECLARE
   ORNumber = VARCHAR(20) NOT NULL WITH DEFAULT;
   SWPPermit = SWPJob DEFAULT NULL;
   TitleText = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF ORIdx = 0 OR WIIdx = 0 THEN
      MESSAGE 'Select an Outage Request Work Item first';
      RESUME;
   ENDIF;
   
   IF FMSCard IS NOT NULL THEN
      TitleText = 'Select FMS Card ' + FMSCard.FeederName;
      SWPPermit = CALLFRAME SWPWorkPermit(Card = FMSCard.Card,
                                        SWItem = 0,
                                        TitleText = TitleText);
   ELSEIF TFMSCard IS NOT NULL THEN
      TitleText = 'Select TFMS Card ' + TFMSCard.FeederNames;
      SWPPermit = CALLFRAME SWPWorkPermit(Card = TFMSCard.Card,
                                        SWItem = 0,
                                        TitleText = TitleText);
   ELSEIF SLCCard IS NOT NULL THEN 
      TitleText = 'Select Switching Item from SLC Card ' + SLCCard.SubstationName;
      SWPPermit = CALLFRAME SWPWorkPermit(Card = SLCCard.Card,
                                        SWItem = SWItem,
                                        TitleText = TitleText);   
   ENDIF;
   IF SWPPermit IS NOT NULL THEN
      i = 0;
      SELECT :i = 1,
             :ORNumber = ORNumber
      FROM   SOA_OutageRequestPermit
      WHERE  PermitJobID = :SWPPermit.Job;
      IF i = 1 THEN
         MESSAGE 'The existing permit has already been linked to Outage Request ' + ORNumber + '.';
         RESUME;
      ELSE
         WorkItem.LinkWorkPermit(SWPPermit = SWPPermit);
         FIELD(WorkItem.PermitList).UpdField(); 
         CALLPROC UpdateSWPStatus();
         CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
      ENDIF
   ENDIF;
END;

ON CLICK Unlink_Btn =
DECLARE
   ORStack = StackField;
ENDDECLARE
BEGIN
   IF SelectWPRow <= 0 THEN
      MESSAGE 'Select a work permit to delete';
      RESUME;
   ENDIF;
   
   IF CurFrame.ConfirmPopup(messagetext = 
         'Unlink the selected work permit from the work item?') = PU_CANCEL THEN   
      RESUME;
   ENDIF;
         
   WorkItem.UnlinkWorkPermit(PermitJobID = WorkItem.PermitList[SelectWPRow].Job);
   IF WorkItem.ReturnCode <> 0 THEN
      MESSAGE WorkItem.ErrorMessage;
      RESUME;
   ENDIF;   
   WorkItem.PermitList.RemoveRow(RowNumber = SelectWPRow);

   // reset selected row index
   SelectWPRow = 0;
   
   // if there is not any work permit linked to the SWP, change the SWP's status
   // back to IMPORTED
   i = 0;
   SELECT :i = Count(*)
   FROM   SOA_OutageRequestPermit
   WHERE  ORNumber = :SWP.ORNumber;
   
   IF i = 0 THEN
      SWP.Status = Order$Opened;
      SWP.UpdateStatus();
      IF SWP.ReturnCode <> 0 THEN
         MESSAGE SWP.ErrorMessage;
      ENDIF;
   ENDIF;
   CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
   /*   
   ORList[ORIdx].WIList[WIIdx] = WorkItem;
   ORStack = Curframe.TopForm.FieldByFullName(fullname = 'ORSF_' + varchar(ORIdx) );
   ORStack.SetFieldValue(Value = byref(ORList[ORIdx]));
   ORStack.UpdField();
   */
END;


