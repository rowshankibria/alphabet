INITIALIZE (
   Card = INTEGER NOT NULL WITH DEFAULT;        /* passed in*/
   SWItem = INTEGER NOT NULL WITH DEFAULT;      /*  passed in*/
   TitleText = VARCHAR(160) NOT NULL WITH DEFAULT;
) =
DECLARE
#  include StandardDeclarations

   SelectItem = INTEGER NOT NULL WITH DEFAULT;
   CurrentRow = INTEGER NOT NULL WITH DEFAULT;
   
   ShowCards = PROCEDURE;
   ShowWorkPermits = PROCEDURE;
ENDDECLARE
BEGIN
   FIELD(Title1).TextValue = TitleText;
   IF CurrentApplication = Application$SLC AND SWItem = 0 THEN
      FIELD(CardOption).CurBias = FB_CHANGEABLE;
      CardOption = 2;    // Open
   ELSE
      FIELD(CardOption).CurBias = FB_INVISIBLE;
   ENDIF;

   CALLPROC ShowCards();
   IF Card_TF.LastRow = 1 THEN
      SelectItem = Card_TF[1].SwitchingItem;
      CALLPROC ShowWorkPermits();
   ENDIF;
END;

ON CHILDENTRY Card_TF = 
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   i = FIELD(Card_TF).CurRow;
   SelectItem = Card_TF[i].SwitchingItem;
   
   CALLPROC ShowWorkPermits();
END;

ON SETVALUE CardOption = 
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   CALLPROC ShowCards();
   IF Card_TF.LastRow = 1 THEN
      SelectItem = Card_TF[1].SwitchingItem;
      CALLPROC ShowWorkPermits();
   ENDIF;
END;

/*
**   Build SelectList for selected rows.
*/
ON ChildEntry WP_tf =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;    

   CurrentRow = 0;
   CurrentRow = FIELD(WP_tf).CurRow; 
   
   FOR i = 1 TO WP_TF.LastRow() DO
      IF CurrentRow = i THEN
         FIELD(WP_TF[i].PrintID).IsReverse = TRUE;
         FIELD(WP_TF[i].EquipClassName).IsReverse = TRUE;
         FIELD(WP_TF[i].EquipName).IsReverse = TRUE;
         FIELD(WP_TF[i].TOMove).IsReverse = TRUE;
      ELSE 
         FIELD(WP_TF[i].PrintID).IsReverse = FALSE;
         FIELD(WP_TF[i].EquipClassName).IsReverse = FALSE;
         FIELD(WP_TF[i].EquipName).IsReverse = FALSE;
         FIELD(WP_TF[i].TOMove).IsReverse = FALSE;
      ENDIF;
   ENDFOR; 
END;

ON CLICK OK_Btn = 
BEGIN
   IF CurrentRow = 0 THEN
      MESSAGE 'Select a work permit';
      RESUME;
   ENDIF;
   
   RETURN WP_TF[CurrentRow];
END;

ON CLICK CANCEL_Btn = 
BEGIN   
   RETURN NULL;
END;

ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return NULL;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

PROCEDURE ShowCards(
) = 
DECLARE
   ItemStatus = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItemSeq = VARCHAR(24) NOT NULL WITH DEFAULT;
BEGIN
   Card_TF.Clear();

   IF CurrentApplication = Application$FMS THEN
      i = 1;
      SELECT :Card_TF[i].CardClassName = C.CardClassName,
             :Card_TF[i].CardName = C.FeederName
      FROM   FMS_Card C
      WHERE  C.Card = :Card;

   ELSEIF CurrentApplication = Application$TFMS THEN
      i = 1;
      SELECT :Card_TF[i].CardClassName = C.CardClassName,
             :Card_TF[i].CardName = T.FeederNames
      FROM   SOA_Card C,
             TFMS_Card T
      WHERE  C.Card = :Card AND
             T.Card = :Card;

   ELSEIF CurrentApplication = Application$SLC THEN 
      IF SWItem > 0 THEN
         i = 1;
         REPEATED
         SELECT :Card_TF[i].CardClassName = CardClassName,
                :Card_TF[i].CardName = Title,
                :Card_TF[i].SwitchingItem = Job
         FROM   SLC_InformationItem
         WHERE  Job = :SWItem;
      ELSE
         IF CardOption = 1 THEN
            ItemStatus = Card$Active;
         ELSE   
            ItemStatus = Card$Open;
         ENDIF;
         
         i = 1;
         SELECT DISTINCT 
                :Card_TF[i].CardClassName = I.CardClassName,
                :Card_TF[i].CardName = I.Title,
                :Card_TF[i].SwitchingItem = I.Job,
                :SwitchingItemSeq = 
                           RIGHT('00000000'+Varchar(JC2.Seq),8) + 
                           RIGHT('00000000'+Varchar(JC2.Job),8)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                SOA_Job J2,
                SOA_JobControl JC2,
                SLC_InformationItem I
         WHERE  JC.Card = :Card AND
                JC.StepPair IN (:StepHeading$WorkPermit,  :StepHeading$TestPermit) AND 
                JC.Job = J.Job AND
                J.Status IN ('',:JobStatus$NIS,:JobStatus$Table) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.TOIssued IS NULL AND
                JC.SwitchingItem = JC2.Job AND
                JC2.Job = I.Job AND
                JC2.Job = J2.Job AND
                J2.ShadowLink = 0 AND
                J2.MoveCategory = :MoveCategory$SwitchingItem AND
                J2.SwItemStatus = :ItemStatus
         ORDER BY SwitchingItemSeq
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   WP_TF.Clear();
END;

PROCEDURE ShowWorkPermits(
) = 
DECLARE
   ItemStatus = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItemSeq = VARCHAR(24) NOT NULL WITH DEFAULT;
BEGIN
   WP_TF.Clear();
   
   IF CurrentApplication = Application$FMS THEN
      i = 1;
      REPEATED
      SELECT :WP_TF[i].Job = J.Job,
             :WP_TF[i].Status = J.Status,
             :WP_TF[i].JobClass = J.JobClass,
             :WP_TF[i].Card = JC.Card,
             :WP_TF[i].Seq = JC.Seq,
             :WP_TF[i].Equip = J.Equip,
             :WP_TF[i].EquipClass = J.EquipClass,
             :WP_TF[i].EquipClassName = J.EquipClassName,
             :WP_TF[i].MoveEquipClass = JC.MoveEquipClass,
             :WP_TF[i].PrintID = JC.PrintID,
             :WP_TF[i].EquipName = J.EquipName,
             :WP_TF[i].StepPair = JC.StepPair,
             :WP_TF[i].MoveType = J.MoveType,
             :WP_TF[i].TOMove = J.TOMove,
             :WP_TF[i].TOOperator = J.TOOperator,
             :WP_TF[i].TOIssued = J.TOIssued,
             :WP_TF[i].TOComplete = J.TOComplete,
             :WP_TF[i].RSMove = J.RSMove,
             :WP_TF[i].RSOperator = J.RSOperator,
             :WP_TF[i].RSIssued = J.RSIssued,
             :WP_TF[i].RSComplete = J.RSComplete,
             :WP_TF[i].Response = J.Response,
             :WP_TF[i].ActivityIdentifier = J.ActivityIdentifier,
             :WP_TF[i].MoveFGColor = J.MoveFGColor,
             :WP_TF[i].Substation = J.Substation
      FROM   SOA_Job J,
             SOA_JobControl JC,
             FMS_Card C
      WHERE  C.Card = :Card AND
             JC.Card = C.Card AND
             JC.StepPair = :StepHeading$OTW AND
             JC.Job = J.Job AND
             J.Status = '' AND
             J.JobClass <> 0 AND
             J.TOIssued IS NULL
      ORDER BY Seq
      BEGIN
         WP_TF[i].AppName = CurrentApplication;
         i = i + 1;
      END;
   ELSEIF CurrentApplication = Application$TFMS THEN
      i = 1;
      REPEATED
      SELECT :WP_TF[i].Job = J.Job,
             :WP_TF[i].SwitchingItem = JC.SwitchingItem,
             :WP_TF[i].Status = J.Status,
             :WP_TF[i].JobClass = J.JobClass,
             :WP_TF[i].Seq = JC.Seq,
             :WP_TF[i].Card = JC.Card,
             :WP_TF[i].Equip = J.Equip,
             :WP_TF[i].EquipClass = J.EquipClass,
             :WP_TF[i].EquipClassName = J.EquipClassName,
             :WP_TF[i].MoveEquipClass = JC.MoveEquipClass,
             :WP_TF[i].PrintID = JC.PrintID,
             :WP_TF[i].EquipName = J.EquipName,
             :WP_TF[i].StepPair = JC.StepPair,
             :WP_TF[i].TOMove = J.TOMove,
             :WP_TF[i].TOMoveRules = J.TOMoveRules,
             :WP_TF[i].TOIssued = J.TOIssued,
             :WP_TF[i].TOComplete = J.TOComplete,
             :WP_TF[i].RSMove = J.RSMove,
             :WP_TF[i].RSMoveRules = J.RSMoveRules,
             :WP_TF[i].RSIssued = J.RSIssued,
             :WP_TF[i].RSComplete = J.RSComplete,
             :WP_TF[i].Movefgcolor = J.MovefgColor,
             :WP_TF[i].Substation = O.Object,
             :WP_TF[i].SubstationName = O.Name
      FROM   SOA_Job J,
             SOA_JobControl JC,
             Udb_Object O
      WHERE  JC.Card = :Card AND
             JC.StepPair IN (:StepHeading$WorkPermit,  :StepHeading$TestPermit) AND 
             JC.Job = J.Job AND
             J.Status IN ('',:JobStatus$NIS,:JobStatus$Table) AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.TOIssued IS NULL AND
             J.Substation = O.Object
      ORDER BY Seq
      BEGIN
         WP_TF[i].AppName = CurrentApplication;
         i = i + 1;
      END;
   ELSE
         i = 1;
         REPEATED
         SELECT :WP_TF[i].Job = J.Job,
                :WP_TF[i].SwitchingItem = JC.SwitchingItem,
                :WP_TF[i].Status = J.Status,
                :WP_TF[i].JobClass = J.JobClass,
                :WP_TF[i].Seq = JC.Seq,
                :WP_TF[i].Card = JC.Card,
                :WP_TF[i].Equip = J.Equip,
                :WP_TF[i].EquipClass = J.EquipClass,
                :WP_TF[i].EquipClassName = J.EquipClassName,
                :WP_TF[i].MoveEquipClass = JC.MoveEquipClass,
                :WP_TF[i].PrintID = JC.PrintID,
                :WP_TF[i].EquipName = J.EquipName,
                :WP_TF[i].StepPair = JC.StepPair,
                :WP_TF[i].TOMove = J.TOMove,
                :WP_TF[i].TOMoveRules = J.TOMoveRules,
                :WP_TF[i].TOIssued = J.TOIssued,
                :WP_TF[i].TOComplete = J.TOComplete,
                :WP_TF[i].RSMove = J.RSMove,
                :WP_TF[i].RSMoveRules = J.RSMoveRules,
                :WP_TF[i].RSIssued = J.RSIssued,
                :WP_TF[i].RSComplete = J.RSComplete,
                :WP_TF[i].Movefgcolor = J.MovefgColor,
                :WP_TF[i].Substation = O.Object,
                :WP_TF[i].SubstationName = O.Name
         FROM   SOA_Job J,
                SOA_JobControl JC,
                Udb_Object O
         WHERE  JC.Card = :Card AND
                JC.SwitchingItem = :SelectItem AND
                JC.StepPair IN (:StepHeading$WorkPermit,  :StepHeading$TestPermit) AND 
                JC.Job = J.Job AND
                J.Status IN ('',:JobStatus$NIS,:JobStatus$Table) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.TOIssued IS NULL AND
                J.Substation = O.Object
         ORDER BY Seq
         BEGIN
            WP_TF[i].AppName = CurrentApplication;
            i = i + 1;
         END;
/* obsolete
      IF SelectItem = 0 THEN
         IF CardOption = 1 THEN
            ItemStatus = Card$Active;
         ELSE   
            ItemStatus = Card$Open;
         ENDIF;
         
         i = 1;
         REPEATED
         SELECT :WP_TF[i].Job = J.Job,
                :WP_TF[i].SwitchingItem = JC.SwitchingItem,
                :WP_TF[i].Status = J.Status,
                :WP_TF[i].JobClass = J.JobClass,
                :WP_TF[i].Seq = JC.Seq,
                :WP_TF[i].Card = JC.Card,
                :WP_TF[i].Equip = J.Equip,
                :WP_TF[i].EquipClass = J.EquipClass,
                :WP_TF[i].EquipClassName = J.EquipClassName,
                :WP_TF[i].MoveEquipClass = JC.MoveEquipClass,
                :WP_TF[i].PrintID = JC.PrintID,
                :WP_TF[i].EquipName = J.EquipName,
                :WP_TF[i].StepPair = JC.StepPair,
                :WP_TF[i].TOMove = J.TOMove,
                :WP_TF[i].TOMoveRules = J.TOMoveRules,
                :WP_TF[i].TOIssued = J.TOIssued,
                :WP_TF[i].TOComplete = J.TOComplete,
                :WP_TF[i].RSMove = J.RSMove,
                :WP_TF[i].RSMoveRules = J.RSMoveRules,
                :WP_TF[i].RSIssued = J.RSIssued,
                :WP_TF[i].RSComplete = J.RSComplete,
                :WP_TF[i].Movefgcolor = J.MovefgColor,
                :WP_TF[i].Substation = O.Object,
                :WP_TF[i].SubstationName = O.Name,
                :SwitchingItemSeq = 
                           RIGHT('00000000'+Varchar(JC2.Seq),8) + 
                           RIGHT('00000000'+Varchar(JC2.Job),8)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                Udb_Object O,
                SOA_Job J2,
                SOA_JobControl JC2
         WHERE  JC.Card = :Card AND
                JC.StepPair IN (:StepHeading$WorkPermit,  :StepHeading$TestPermit) AND 
                JC.Job = J.Job AND
                J.Status IN ('',:JobStatus$NIS,:JobStatus$Table) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.TOIssued IS NULL AND
                J.Substation = O.Object AND
                JC.SwitchingItem = JC2.Job AND
                JC2.Job = J2.Job AND
                J2.ShadowLink = 0 AND
                J2.MoveCategory = :MoveCategory$SwitchingItem AND
                J2.SwItemStatus = :ItemStatus
         ORDER BY SwitchingItemSeq, Seq
         BEGIN
            WP_TF[i].AppName = CurrentApplication;
            i = i + 1;
         END;
      ENDIF;
*/
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END;
					 *Default Item


