	Name:            CheckGroundIssueConfirm

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckGroundIssueConfirm 
**
**  Modifications:
**  11/24/14 em	    Created 
*/
PROCEDURE CheckGroundIssueConfirm 
(
    JIP = JobInProgress;				/* Job being processed */

    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    RetCode = INTEGER;
) =
BEGIN
/*
** First determine if Job Equipment on more than one feeder.
*/
    IF JIP.Equip = 0 THEN
       RETURN(PU_OK);
    ENDIF; 

    i = 0;
    SELECT  :i = COUNT(Grouping) 
    FROM    Udb_Grouping
    WHERE   Member = :JIP.Equip AND
            Relationship = :Interaction$MemberOf AND
            GroupingType = :Type$Feeder;

    IF i <= 1 THEN
       RETURN(PU_OK);
    ENDIF; 
/*
** Equipment is on more than one feeder, if Source or Grouper then ignore
*/        
    i = 0;
    SELECT  :i = SuperType 
    FROM    Udb_ExtendedType
    WHERE   Type = :JIP.EquipClass AND
            SuperType IN (:Type$ATSGrouper,
                          :Type$AbstractHTV, 
                          :Type$ISOGrouper,
                          :Type$Loop,
                          :Type$Source,
                          :Type$SOURCE_SBFKS,
                          :Type$SOURCE_Bifur,
                          :Type$SOURCE_VISY);
 
    IF i > 0 THEN
       RETURN(PU_OK);
    ENDIF; 
/*
** We have a shared equipment that is not a Grouper or Source. 
** Confirm placement of the ground.
*/
    RetCode = CALLFRAME Warning (Card = JIP.Card,
                                 SwitchingItem = JIP.SwitchingItem,
                                 Job = JIP.Job,
                                 Text = 
               'Equipment ' + JIP.EquipClassName + ' ' +  JIP.EquipName + 
               ' is a member of more than one feeder.   ' + 
               'Are you sure you want to apply this ground on feeder ' +
               CardDetails.FeederName + '?');  
    IF RetCode = PU_CANCEL THEN
             RETURN(PU_CANCEL);
    ELSE
             RetCode = Warning$Overridden; 
    ENDIF;

    RETURN(RetCode);                          
END;

