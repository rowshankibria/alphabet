**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          InterfaceDBEvent
**
**  04/19/07  ysp   created
**  05/16/07  ysp   When the attempt counter is reset, raise the dbevent to
**                  resend the message
**  09/09/10  ysp   add InsertEvent and GetDBEventName
**  10/02/23  ysp   add FMS_FSSDBEvent for FSS monitor
*/
Method InsertEvent(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;           /* Temporary counter  */
   DBEventName = VARCHAR(32) NOT NULL WITH DEFAULT;
   DBEventText = Varchar(256) NOT NULL WITH DEFAULT;
   EventID = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ID = CALLPROC FMS_DBEventQueueIns(
                 Time = DATE('NOW'),
                 Name = CurObject.Name,
                 Text = CurObject.Text,
                 ToApp = CurObject.ToApp,
                 FromApp = CurObject.FromApp);
   IF CurObject.ID < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to insert an event queue for Event = ' + CurObject.Name + ', Text = ' + CurObject.Text + HC_NEWLINE + 
                               '. RRMsgID lastkey may be out of synch. Please contact FMS support.';                  
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;  

   DBEventName = CurObject.GetDBEventName();
   DBEventText = VARCHAR(CurObject.ID) + ';' + CurObject.Name + ';' + CurObject.Text;

   CALLPROC DDB_RaiseDBEvent(DBEventName = DBEventName,
                             DBEventText = DBEventText);
   CALLPROC DDB_COMMIT;
END;

Method DeleteEvent(
) = 
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;           /* Temporary counter  */
    RetCode = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_DBEventQueueDel(ID = CurObject.ID);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to delete event from the database.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

Method ResendEvent(
) = 
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;           /* Temporary counter  */
    DBEventName = VARCHAR(32) NOT NULL WITH DEFAULT;
    DBEventText = Varchar(256) NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT; ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_DBEventQueueUpd(
                            ID = CurObject.ID,
                            Attempt = 0);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to reset attempt to zero.';
   ELSE
      CALLPROC DDB_COMMIT;
      CurObject.Attempt = 0;

      DBEventName = CurObject.GetDBEventName();
      DBEventText = VARCHAR(CurObject.ID) + ';' + CurObject.Name + ';' + CurObject.Text;

      CALLPROC DDB_RaiseDBEvent(DBEventName = DBEventName,
                                DBEventText = DBEventText);
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

Method GetDBEventName(
) = 
DECLARE
   DBEventName = VARCHAR(32) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CurObject.ToApp = 'FCR' THEN
      DBEventName = 'IR_FCRDBEvent';
   ELSEIF CurObject.ToApp = 'SOO' THEN
      DBEventName = 'IR_SOODBEvent';
   ELSEIF CurObject.ToApp = 'FOD' THEN
      DBEventName = 'IR_FODDBEvent';
   ELSEIF CurObject.ToApp = 'TLS' THEN
      DBEventName = 'IR_TLSDBEvent';
   ELSEIF CurObject.ToApp = 'VZN' THEN
      DBEventName = 'VZ_TLSDBEvent';
   ELSEIF CurObject.ToApp = 'CSD' THEN
      DBEventName = 'FMS_EmailDBEvent';
   ELSEIF CurObject.ToApp = 'TASK' THEN
      DBEventName = 'FMS_TaskDBEvent';
   ELSEIF CurObject.ToApp = 'FSS' THEN
      DBEventName = 'IR_FSSDBEvent';
   ENDIF;
   
   RETURN DBEventName;
END;

