	Name:            PromptPressure

/*
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptPressure
**
**  06/20/14  ysp  Created
**  07/01/15  em   Added attributes
**  10/28/21  em   Incorporate SSO return
**  06/30/22  em   AutoComplete if Reading is loaded from RR
*/
INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   PressureCheck = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;
   
   SELECT :PressureCheck = PressureCheckResult
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF PressureCheck > 0 THEN
      Reading = PressureCheck;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(Reading).CurBias = FB_VISIBLE;
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName='AutoComplete');
   ENDIF;
   
   FIELD(Heading).TextValue = 'Reading from ' + Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName;
END;

ON USEREVENT 'AutoComplete',
ON Click OKButton =
BEGIN
   RetCode = CALLPROC DSO_ReadingIns(
      Card = JIP.Card,
      Time = DATE('NOW'),
      Job = JIP.Job,
      Structure = JIP.Substation,
      Equip = JIP.Equip,
      ReadingType = 'Pressure',
      Reading = VARCHAR(Reading) + ' PSI');

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record pressure reading.',
                           TraceMessage =
                  'PromptPressure: Unable to record pressure reading for ' +
                  'card=' + VARCHAR(JIP.Card));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;

   IF JIP.Response <> '' THEN
      JIP.Response = Squeeze(VARCHAR(Reading) + ' PSI; ' + JIP.Response);
   ELSE
      JIP.Response = Squeeze(VARCHAR(Reading) + ' PSI ' );
   ENDIF;
   JIP.ResponseUpd();
                 
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            PromptProcFromWork

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptProcFromWork
**
**  Modifications:
**      03/04/93 em     New, to support non FCR OTW jobs.  Remove availibility
**                      to return back to Work with FGO.
**      03/17/93 em     modified to use new back from work table.
**      07/29/93 em     added all done with work phase check reminder
**      01/03/94 em     removed backfromwork update
**      01/07/94 em     when backtemp, create new work permit and copy
**                      protections and phase checks.
**      06/13/94 em     OTW Operating Step handling relegated to FROM FCR
**                      only. removed from here.
**      07/07/94 em     added full return code processing
**      01/09/95 pw     change when PFS status gets set
**      04/04/95 pw     prompt user if they want equip picked up for moves
**                      on new equipment w/protection links.
**      04/13/95 em     removed indiscriminate rollback
**      04/27/95 em     add commits to reduce contention
**      05/09/95 pw     Check to see if work permit is linked to move on an ISO 
**      05/16/95 pw     Show IsoFeederName in messagetext
**      06/30/95 pw     Changed PromptFromWork Frame to procedure so that D.O. can
**                      select backtowork option before completing move
**      10/20/95 ysp    itc6:Added checking of card type for work permit and 
**                      protection moves.
**      12/22/95 dr     copied code to decrement BACKTEMP Status to
**                      Feedercard 'ON PerformMoves' section
**      10/22/96 pkw    set esttimecomplete to 2hours after last permit that 
**                      prevents restoration is completed.
**      09/30/99 em     set ETC to be same as ATC.
**      11/07/00 em     Use IFNULL for esttimeinserviceupd
**      05/02/01 em     Added include script copy permit
**                      locations and tags if returned BT
**                      from the FCR interface
**      01/04/02 pkw    Added OldRevision for include script
**      09/20/02 pkw    Don't set PFS step unless card is cutin.
**      01/07/03 em     Converted for Merge
**      01/13/02 pkw    Remove update response call.  It is done in CompletePermits.
**      01/22/03 em     Changed MoveOrigin reference to ActivityIdentifier
**      02/03/03 ysp    Reset the new work permit's status because JIP' status could be set 
**                      to something other than blank.
**      02/26/03 em     Modified WorkPermitProtection Select
**      04/03/03 pkw    Select cutout and cutin so that PFS can get started.
**      05/15/03 em     Handle entry into OTW+ op step
**      07/16/03 em     Change ETIS to 1 hour from 2.
**      04/27/04 ysp    OperatingStep enhancement: split OTW into OTWR and OTWS.
**      05/10/04 pkw    Modify logic for OTWR and OTWS
**      07/21/06 pkw    Check for TC feeder status before going to PFS
**      09/11/06 ysp    copy drop/pickup equipment to the new work permit when the original
**                      work permit is returned back temp.
**      12/22/06 em     Only present equipment pick/drop comment when there something xferred.
**                      Added SuspendedOrder Parm to handle SOA_WorkPermit
**      05/08/08 pkw    Look at SLC link for BusSect Outage.
**      01/05/11 em     Scroll through Card Objects to cover 3G feeders on FromWorkStatus updates.
**      12/20/11 pkw    Start PFSS instead of PFS.
**      09/15/15 pkw    Set SetPFSNow when setting pfs from this frame.
**      08/25/16 ysp    For 33kv, From Work Status and FMS Object Status adjustments need to include 
**                      segments fed by the current feeder and exclude segments fed by another feeder
**      01/18/24 em     Changed query to include SOA_JobControl instead of using Control Card
*/

PROCEDURE PromptProcFromWork
(
    JIP = JobInProgress;			/* Job being processed */
    SuspendedOrder = INTEGER NOT NULL WITH DEFAULT;  /*SSO Order*/

    C = FMS_Card;				/* Card details */
    PT = Varchar(20);			/* Prompt text */
    NewJob = JobInProgress;		/* New job to be added */
    i = INTEGER;			/* Scratch integer */
    k = INTEGER NOT NULL WITH DEFAULT;	/* Scratch integer */
    JobID = INTEGER NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    PickupEquip = ARRAY OF FMS_Equip;
    PromptText = VARCHAR(1000);
    ISOMove = ARRAY OF FMS_Equip;
    ISOFeeder = VARCHAR(40) NOT NULL WITH DEFAULT;
    PFS_Continue = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
    OldRevisionNumber = INTEGER NOT NULL WITH DEFAULT;
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
    WPOpStep = INTEGER NOT NULL WITH DEFAULT;
    CurOpStep = INTEGER NOT NULL WITH DEFAULT;
    RemainOTWR = INTEGER NOT NULL WITH DEFAULT;
    RemainOTWS = INTEGER NOT NULL WITH DEFAULT;
    RemainBusSect = INTEGER NOT NULL WITH DEFAULT;
    NewOpStep = INTEGER NOT NULL WITH DEFAULT;
    FdrObjList = ARRAY OF pas!ObjectSummaryClass;
    FedBy = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   C.BackFromWork = JIP.WorkStatus;
/*
** Get needed FMS Card information
*/
   C.Feeder = 0;
   REPEATED
   SELECT DISTINCT 
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.TypeOfCard = C.TypeOfCard,
          :C.Card = C.Card,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.Cutout = C.CutOut,
          :C.OpenAutoPlus = C.OpenAutoPlus,
          :C.CutIn = C.CutIn,
          :C.NetworkFeeder = C.NetworkFeeder
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_Job J,
          SOA_JobControl JC
   WHERE  J.Job = :JIP.Job AND
          J.Job = JC.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;

   IF C.Feeder = 0 THEN
      MESSAGE 'PromptFromWork: Move is not related properly to an active FMS Card.';
      RETURN (PU_CANCEL);
   ENDIF; 

   /*
   ** 33KV cards: From Work Status and FMS Object Status adjustments need the object array to include 
   ** segments fed by this feeder and exclude segments fed by another feeder
   */
   IF C.NetworkFeeder = NetworkFeeder$33KV THEN
      k = 1;
      SELECT :FdrObjList[k].Object = CTO.Object
      FROM   TFMS_CardToObject CTO
      WHERE  CTO.Card = :JIP.Card 
      BEGIN
         FedBy = 0;   // need to declare this variable
         SELECT :FedBy = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :FdrObjList[k].Object AND
                Relationship = :Interaction$FedBy;
         IF FedBy > 0 THEN
            FdrObjList.RemoveRow (rownumber = k);
         ELSE
            k = k + 1;
            REPEATED 
            SELECT DISTINCT
                   :FdrObjList[k].Object = O.Object
            FROM   Udb_Grouping G,
                   Udb_Object O
            WHERE  G.Grouping = :FdrObjList[k-1].Object AND
                   G.Relationship = :Interaction$FedBy AND
                   G.Member = O.Object
            BEGIN
               k = k + 1;
            END;
         ENDIF;          
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE
      FdrObjList = CardDetails.Object.Duplicate(); 
   ENDIF;
/*
**   Remove any BT statuses
**   related to this Jobclass and equip
*/
   FOR k = 1 TO FdrObjList.LastRow() DO
      i = CALLPROC FMS_FromWorkStatusDel
                  (JobClass = JIP.JobClass,
                   Equip = JIP.Equip,
                   Job = 0,
                   Status = Status$BT,
                   Feeder = FdrObjList[k].Object);

      IF i < 0 THEN
         CALLPROC DDB_ROLLBACK;
         RETURN (PU_CANCEL);
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   IF C.BackFromWork = 'Back temp' THEN
/*
**   Set BT status for this job
*/
      FOR k = 1 TO FdrObjList.LastRow() DO
          i = CALLPROC FMS_FromWorkStatusIns
                  (JobClass = JIP.JobClass,
                   Equip = JIP.Equip,
                   Job = JIP.Job, 
                   Status = Status$BT,
                   Feeder = FdrObjList[k].Object);
         IF i < 0 THEN
            CALLPROC DDB_ROLLBACK;
            RETURN (PU_CANCEL);
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
        
      NewJob = JIP.Duplicate();
      NewJob.TOOperator = NULL;
      NewJob.TOIssued = NULL;
      NewJob.RSComplete = NULL;
      NewJob.RSOperator = NULL;
      NewJob.Response = '';
      NewJob.WorkStatus = '';
      NewJob.Status = '';

      i = NewJob.InsertMove ( 
                  CardTypeOfCard = C.TypeOfCard,
                  KeepMoveText = TRUE);

      IF i <= 0 THEN
         MESSAGE 'Error creating new work permit to cover back temp.' +
                 'You will have to set up the new work permit manually.';
         RETURN(PU_CANCEL);
      ENDIF;  

      JobID = IFNULL(i,0);
/*
**  Copy WorkPermits and PhaseChecks from old work permit to new one.
*/
      RetCode = CALLPROC FMS_WorkPermitCopy
                 (Card = C.Card,
                  OldWorkPermit = JIP.Job,
                  NewWorkPermit = JobID);
      IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           Message 'Unable to copy protections and phase checks to new work permit.';
           RETURN (PU_CANCEL);
      ENDIF;
      CALLPROC DDB_COMMIT;      
/*
**  Check if an FCR returned permit, if so, copy locations
**  and tags to new permit.
*/
#     INCLUDE FCRPermitBTCopy          

/*
**  Copy drop/pickup equipment to the new work permit if necessary
*/
      i = 0;
      SELECT :i = COUNT(*) 
      FROM   IR_WorkEquipment
      WHERE  WorkPermit = :JIP.Job;
  
      IF i > 0 THEN
         RetCode = CALLPROC FMS_CopyPermitEquip
                 (Card = C.Card,
                  OldWorkPermit = JIP.Job,
                  NewWorkPermit = JobID);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
         ELSE
            CALLPROC DDB_COMMIT;
            Message 'Equipment to drop or pick up was copied to the new work permit. ' + 
                    'Drop/Pick equipment can be modified on the Work Permit Detail screen.';
         ENDIF;
      ENDIF;
/*
** If SuspendedOrder parm contains a value, we are processing a Suspended SSO Order and
** we need to handle SOA_WorkPermit table.
*/
      IF SuspendedOrder > 0 THEN
         RetCode = CALLPROC  SOA_SetSuspendedPermit ( 
                       PermitJobID = JobID, 
                       SuspendedPermit = JIP.Job,         /* Original TOMS Permit that was Suspended */
                       SuspendedOrder = SuspendedOrder  /* Order number for suspended permit */  
                       );
         CALLPROC DDB_COMMIT;
         IF RetCode < 0 THEN
            Message 'A new work permit has been created. But the reference to the suspended permit ' + 
                    'is not set. Please report this problem to FMS staff.';
         ENDIF;
      ENDIF;

   ELSE
	 
      PFS_Continue = TRUE;
      IF C.CardClass = Type$Auto OR C.CardClass = Type$CIOA THEN
      
         RetCode = CALLFRAME OAPlusCheckWPReturn (
                              Card = C,
                              PermitJob = JIP.Job);
               
         IF RetCode = PU_CANCEL THEN
            PFS_Continue = FALSE;
         ENDIF;
      ENDIF;

      IF (C.BackFromWork = 'All work done' OR
          C.BackFromWork = 'No work done')  THEN
         /*  
         **  See if there are any outstanding work permits 
         **  that prevent restoration
         */
         RemainOTWR = 0;
         REPEATED
         SELECT :RemainOTWR = count(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                FMS_WorkPermit WP,
                FMS_JobAction JA
         WHERE  JC.Card = :C.Card AND
                JC.Job = J.Job AND
               (J.RSComplete = '' OR
                J.RSComplete IS NULL) AND
                J.Status <> 'Del' AND
                J.Job  = WP.PermitJobID AND
                WP.Restoration = :FALSE AND  /* 0 = prevent restoration */
                JA.JobClass = J.JobClass AND
                JA.FeederEquip = 3 AND
                JA.Status = :Type$OTWR AND
                JA.TypeOfCard = :C.TypeOfCard;
      
         RemainOTWS = 0;
         REPEATED
         SELECT :RemainOTWS = count(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                FMS_WorkPermit WP,
                FMS_JobAction JA
         WHERE  JC.Card = :C.Card AND
                JC.Job = J.Job AND
               (J.RSComplete = '' OR
                J.RSComplete IS NULL) AND
                J.Status <> 'Del' AND
                J.Job  = WP.PermitJobID AND
                WP.Restoration = :FALSE AND  /* 0 = prevent restoration */
                JA.JobClass = J.JobClass AND
                JA.FeederEquip = 3 AND
                JA.Status = :Type$OTWS AND
                JA.TypeOfCard = :C.TypeOfCard;
      
         RemainBusSect = 0;
         SELECT :RemainBusSect = count(*)
         FROM    SOA_FMSSLCLink S,
                 SOA_Job J,
                 SOA_JobControl JC
         WHERE   S.FMSCard = :C.Card AND
                 S.SLCCard = JC.Card AND
                 S.SwitchingItem = JC.SwitchingItem AND
                 JC.StepPair = :StepHeading$WorkPermit AND
                 JC.Job = J.Job AND
                 J.Status <> 'Del' AND
                 J.EquipClass = :TypeName$BusSect AND
                 J.ToIssued IS NOT NULL AND 
                 J.RSComplete IS NULL;
                 
         IF RemainOTWR = 0 AND RemainOTWS = 0 AND RemainBusSect = 0 THEN 
/*
**         No return code processing on purpose. This only sets actual 
**         timecomplete.  No need to fail entire transaction.
*/
              CALLPROC FMS_EstTimeCompleteUpd (
                      Card = C.Card,
                      EstTimeComplete = date('now'));

              CALLPROC FMS_CardGenericUpd
                     (FieldName = 'acttimecomplete',
                      NewValue  = varchar('now'),
                      MatchCard = C.Card);
/*
**         Update esttimeinservice to be 1 hours from now
*/   
              CALLPROC FMS_EstTimeInServiceUpd 
                     (Card = C.Card,
                      EstTimeInService = IFNULL(date('now') + '1 hours',''));
              CALLPROC DDB_COMMIT;
         ENDIF;
             
         IF (C.CutOut IS NOT NULL AND C.CutIn IS NULL) AND 
             PFS_Continue = TRUE THEN
            /*
            **  Determine what step should be.
            */
            IF RemainOTWR <> 0 THEN
               NewOpStep = Type$OTWR;
            ELSEIF RemainOTWS <> 0 OR RemainBusSect <> 0 THEN
               NewOpStep = Type$OTWS;
            ELSE
               /*
               **  Look for TC Feeder status.  If feeder is currently
               **  in TC we will go to TC instead of PFS.  
               */
               i = 0;
               SELECT :i = COUNT(*) 
               FROM    FMS_ObjectStatus
               WHERE   Object = :FdrObjList[1].Object AND
                       Status = :Status$TC AND
                       StatusCount > 0;
               IF i <> 0 THEN
                  NewOpStep = Type$TC;
               ELSE
                  NewOpStep = Type$PFSS;
               ENDIF;
            ENDIF;
            /* 
            ** look at the current operating step
            */
            CurOpStep = 0;
            SELECT :CurOpStep = OperatingStep
            FROM   FMS_OperatingStepStatus
            WHERE  Card = :C.Card AND
                   OperatingStep in (:Type$OTWS, :Type$OTWR) AND
                   EndTime = '';         
            
            IF NewOpStep > 0 AND
               NewOpStep <> CurOpStep THEN
                IF SimpleStep IS NULL THEN
                   SimpleStep = OperatingStep_ASE.Create();
                ENDIF;    
                SimpleStep.SO.BaseType = C.CardClass;
                SimpleStep.SO.Object   = C.Card;
                SimpleStep.SO.Name     = C.CardClassName;
                SimpleStep.SO.Type     = C.Feeder;   /* OK if -1 for 3G */
                SimpleStep.SO.TypeName = C.FeederName;
                SimpleStep.OpStep      = NewOpStep;
                SimpleStep.Job         = 0;
            
                SimpleStep.SetPFSNow = 2;  /* Forces PFSS to be set immediately */
                SimpleStep.SetOpStep();
                IF SimpleStep.ReturnCode <> 0 THEN
                   CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                                        TraceMessage =
                                            'Prompt:ProcFromWork; ' +
                                            'Error setting op step. ' +
                                            'Card=' + VARCHAR(C.Card) +
                                            ';Status=' + VARCHAR(NewOpStep) + '.'
                                        );
                    RETURN (PU_Cancel);
                ENDIF; 
            ENDIF;  // NewOpStep
         ENDIF; // PFS_Continue 
      ENDIF; //All work done

      IF C.BackFromWork = 'All work done' THEN
                                                   
         C.PhaseChecks = TRUE;
/*    
**       No return code processing on purpose. This piece only highlights
**       phase check button. No need to fail entire transaction.
*/    
         CALLPROC FMS_CardGenericUpd
                (FieldName = 'phasechecks',
                 NewValue  = varchar(C.PhaseChecks),
                 MatchCard = C.Card);
         FCFrame.SendUserEvent (EventName = 'HandlePhaseChecks');
         CALLPROC DDB_COMMIT;
   
         i = 1;
         PickupEquip.Clear();
         REPEATED
         SELECT DISTINCT 
                PickupEquip[i].Equip = O.Object,
                PickupEquip[i].EquipName = O.Name,
                PickupEquip[i].EquipClass = O.Type,
                PickupEquip[i].EquipClassName = O.TypeName,
                PickupEquip[i].Description = O.Description
         FROM   SOA_Job JJ,
                FMS_WorkPermitProtection WPP,
                Udb_Object O
         WHERE  WPP.PermitCardType = 0 AND  /* Non-TLS */
                WPP.PermitJobID = :JIP.Job AND
                WPP.ProtectionCardType = 0 AND
                WPP.ProtectionJobID = JJ.Job AND
                JJ.ActivityIdentifier = 'N' AND
                JJ.Equip = O.Object
         BEGIN
            i = i + 1;
         END;
   
         IF PickupEquip.LastRow() >= 1 THEN
            i = 1;
            k = 1;
            ISOMove.Clear();
            WHILE i <= PickupEquip.LastRow() DO
               ISOFeeder = '';
               REPEATED
               SELECT :ISOFeeder = O.Name
               FROM    Udb_ExtendedType ET,
                       Udb_Object O, 
                       Udb_Grouping G
               WHERE   ET.SuperType = :Type$Feeder AND
                       ET.Type = G.GroupingType AND
                       G.RelationShip = :Interaction$MemberOf AND
                       G.Member = :PickupEquip[i].Equip AND
                       G.Grouping = O.Object;
         
               IF ISOFeeder <> '' THEN
                  ISOMove[k] = PickupEquip[i].Duplicate();
                  ISOMove[k].FeederName = ISOFeeder;
                  k = k + 1;
                  PickupEquip.RemoveRow(rownumber = i); /* don't increment i */
               ELSE
                  i = i + 1;
               ENDIF;
            ENDWHILE;
        
            IF PickupEquip.LastRow() >= 1 THEN
               PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                       'Picked Up.  Equipment which should be Picked Up:'  + HC_NEWLINE;  
               i = 1;  
               WHILE i <= PickupEquip.LastRow() DO
                  PromptText = PromptText + '  ''  ' + PickupEquip[i].EquipClassName + 
                               '  ' + PickupEquip[i].EquipName + '  ''' + HC_NEWLINE;
                  i = i + 1;
               ENDWHILE;
               PromptText = PromptText + HC_NEWLINE +
                          'You should Pick Up the equipment at this time.';
            
               MESSAGE :PromptText;
            
               CALLFRAME ConfirmPickupEquip(C = C,
                                            ChosenEquip = PickupEquip
                                            );
               CALLPROC DDB_COMMIT;
            ENDIF;
        
            IF ISOMove.LastRow() >= 1 THEN
            
               PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                       'transferred to Feeder.  Equipment which should be transferred:'  + 
                        HC_NEWLINE;  
               i = 1;  
               WHILE i <= ISOMove.LastRow() DO
                  PromptText = PromptText + 'Feeder:  ' + ISOMove[i].FeederName + '    ' +
                              'Equipment:   ' + ISOMove[i].EquipClassName + 
                               '   ' + ISOMove[i].EquipName + HC_NEWLINE;
                  i = i + 1;
               ENDWHILE;
               PromptText = PromptText + HC_NEWLINE +
                          'You should transfer the equipment at this time.';
            
               MESSAGE :PromptText;
            ENDIF;
         ENDIF;   
      ENDIF;
   ENDIF;

   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptProcFromWorkFCR

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Procedure:      PromptProcFromWorkFCR
**
**  Modifications:
**      07/27/92 em	   set feeder status when returning from work. ml #18.
**      10/22/92 em     modified per integer/udb 
**      11/09/92 em     added call to force status.
**      11/25/92 em     added back temp status set.  
**  	  12/05/92 mts    Updated db calls to use dbprocs for dual database
**      12/20/92 gjc    added window close logic to fix bug 6.
**      01/31/93 em     if backfromwork is FGO, carry protections along with 
**                      new job. New Parm passed to InsertJobsRow contains
**                      job number for permit job.
**      02/12/93 em     added call to jobactions for new job created on FGO.
**      03/04/93 em     changed name: PromptFromWorkFCR
**      03/05/93 em     Make sure takeout issue jobactions get performed for 
**                      new OTW FGO job.
**      03/08/93 em     remove permitjob parameter
**      03/16/93 em     update all jobs with same jobclass/equip when FGO returned
**      03/17/93 em     remove BT and FGO statuses here.
**      04/29/93 em     changes made to new FCR job related to variances.
**      04/29/93 em     Major Variance Functionality change for FGO.
**                      delete all FGO for jobclass, Equip instead
**                      of just Job.
**      07/29/93 em     added phasecheck notification if all work done.
**      12/08/93 em     added ByPass Parameter
**      01/02/94 em     changed value of retcode from insertjobsrow from jobs
**                      array index to new job key.
**      01/07/94 em     when returning BackTemp, insert to out to work move,
**                      copy work permit and phasecheck information.
**      06/13/94 em     modified operating step completion status and OTW
**                      status clearing when coming back ALL WORK DONE.
**      07/07/94 em     added full return code processing.
**      01/09/95 pw     change when PFS status gets set
**      04/04/95 pw     prompt user if they want equip picked up for moves
**                      on new equipment w/protection links.
**      04/13/95 em     removed indiscriminate rollback
**      04/27/95 em     add commits to reduce contention
**      05/09/95 pw     Check to see if work permit is linked to move on an ISO 
**      05/16/95 pw     Show IsoFeederName in messagetext
**      06/30/95 pw     Changed PromptFromWorkFCR Frame to procedure so that D.O. can
**                      select backtowork option before completing move
**      10/20/95 ysp    itc6: added check of card type
**      12-26-95 dr     copied code to decrement BACKTEMP Status to Feedercard 'ON PERFORMMOVES' Section
**      10/22/96 pkw    set esttimecomplete to 2hours after last permit that 
**                      prevents restoration is completed.
**      09/30/99 em     set etc at same time atc to ensure consistency.
**      11/07/00 em     Use IFNULL for esttimeinserviceupd
**      05/02/01 em     Added include script copy permit
**                      locations and tags if returned BT
**                      from the FCR interface
**      05/03/01 em     Take away FromWorkStatus interaction with FGO.  FGO
**                      is handled differently now, only getting set once
**                      per feeder and getting removed only when all FCR
**                      permits are complete.
**      01/04/02 pkw    Added OldRevisionNumber for include script
**      09/20/02 pkw    Don't set PFS step unless card is cutin.
**      01/07/03 em     Convert J to JIP
**      01/13/02 pkw    Remove update response call.  It is done in CompletePermits.
**      01/18/03 ysp    Convert MoveOrigin to ActivityIdentifier and fix 
**                      SOA_job query.
**      01/22/03 ysp    fix soa jobcontrol query
**      02/03/03 ysp    Reset the new work permit's status before being inserted into the database
**                      because the JIP status was set to 'RS'.
**      02/11/03 pkw    Make call to issuemove method since a job can't be inserted
**                      with toissued already being set.
**      02/26/03 em     Modified WorkPermitProtection Select
**      04/03/03 pkw    Select cutout and cutin so that PFS can get started.
**      05/15/03 em     Handle entry into OTW+ op step
**      07/16/03 em     Change ETIS to 1 hour instead of 2
**      04/27/04 ysp    OperatingStep enhancement: split OTW into OTWR and OTWS.
**      05/10/04 pkw    Modify logic for OTWR and OTWS
**      07/21/06 pkw    Check for TC feeder status before going to PFS
**      09/11/06 ysp    copy drop/pickup equipment to the new work permit when the original
**                      work permit is returned back temp.
**      12/22/06 em     Only present equipment pick/drop comment when there something xferred.
**                      Added SuspendedOrder Parm but will not use it here.
**      05/08/08 pkw    Look at SLC link for BusSect Outage.
**      01/05/11 em     Scroll through card feeders instead of using CardDetails.Feeder
**      12/20/11 pkw    Start PFSS instead of PFS.
**      09/15/15 pkw    Set SetPFSNow when setting pfs from this frame.
**      09/06/16 ysp    For 33kv, From Work Status and FMS Object Status adjustments need to include 
**                      segments fed by the current feeder and exclude segments fed by another feeder
**      01/18/24 em     Changed query to include SOA_JobControl instead of using Control Card
*/
PROCEDURE PromptProcFromWorkFCR
(
    JIP = JobInProgress;		/* Job being processed */
    SuspendedOrder = INTEGER NOT NULL WITH DEFAULT;  /* Parm will not be used here.*/ 
   
    C = FMS_Card;                       /* Card Details */
    PT = Varchar(20);			/* Prompt text */
    NewJob = JobInProgress;		/* New job to be added */
    i = INTEGER NOT NULL WITH DEFAULT;	/* Scratch integer */
    f = INTEGER NOT NULL WITH DEFAULT;	/* Scratch integer */
    k = INTEGER NOT NULL WITH DEFAULT;	/* Scratch integer */
    JobID = INTEGER NOT NULL;   /*New Job */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    PickupEquip = ARRAY OF FMS_Equip;
    ISOMove = ARRAY OF FMS_Equip;
    PromptText = VARCHAR(1000);
    ISOFeeder = VARCHAR(40) NOT NULL WITH DEFAULT;
    FGOExists = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
    PFS_Continue = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
    OldRevisionNumber = INTEGER NOT NULL WITH DEFAULT;
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
    WPOpStep = INTEGER NOT NULL WITH DEFAULT;
    CurOpStep = INTEGER NOT NULL WITH DEFAULT;
    RemainOTWR = INTEGER NOT NULL WITH DEFAULT;
    RemainOTWS = INTEGER NOT NULL WITH DEFAULT;
    RemainBusSect = INTEGER NOT NULL WITH DEFAULT;
    NewOpStep = INTEGER NOT NULL WITH DEFAULT;
    FdrObjList = ARRAY OF pas!ObjectSummaryClass;
    FedBy = INTEGER NOT NULL WITH DEFAULT;    
) =
BEGIN
   C.BackFromWork = JIP.WorkStatus;
   IF JIP.Response <> JIP.WorkStatus THEN
      JIP.Response = SQUEEZE(C.BackFromWork + ' ' + JIP.Response);
   ENDIF;
/*
** Get needed FMS Card information
*/
   C.Feeder = 0;
   REPEATED
   SELECT DISTINCT
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.TypeOfCard = C.TypeOfCard,
          :C.Card = C.Card,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.Cutout = C.CutOut,
          :C.OpenAutoPlus = C.OpenAutoPlus,
          :C.CutIn = C.CutIn,
          :C.NetworkFeeder = C.NetworkFeeder
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_Job J,
          SOA_JobControl JC
   WHERE  J.Job = :JIP.Job AND
          J.Job = JC.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;

   IF C.Feeder = 0 THEN
      MESSAGE 'PromptFromWorkFCR: Move is not related properly to an active FMS ' +
                   'Card.';
      RETURN (PU_CANCEL);
   ENDIF;

   /*
   ** 33KV cards: From Work Status and FMS Object Status adjustments need the object array to include 
   ** segments fed by this feeder and exclude segments fed by another feeder
   */
   IF C.NetworkFeeder = NetworkFeeder$33KV THEN
      k = 1;
      SELECT :FdrObjList[k].Object = CTO.Object
      FROM   TFMS_CardToObject CTO
      WHERE  CTO.Card = :JIP.Card 
      BEGIN
         FedBy = 0;   // need to declare this variable
         SELECT :FedBy = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :FdrObjList[k].Object AND
                Relationship = :Interaction$FedBy;
         IF FedBy > 0 THEN
            FdrObjList.RemoveRow (rownumber = k);
         ELSE
            k = k + 1;
            REPEATED 
            SELECT DISTINCT
                   :FdrObjList[k].Object = O.Object
            FROM   Udb_Grouping G,
                   Udb_Object O
            WHERE  G.Grouping = :FdrObjList[k-1].Object AND
                   G.Relationship = :Interaction$FedBy AND
                   G.Member = O.Object
            BEGIN
               k = k + 1;
            END;
         ENDIF;          
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE
      FdrObjList = CardDetails.Object.Duplicate(); 
   ENDIF;   
/*
**   Remove any BT statuses related to this Jobclass and equip
*/
    FGOExists = FALSE;
    FOR i = 1 TO FdrObjList.LastRow() DO
       RetCode = CALLPROC FMS_FromWorkStatusDel
                  (JobClass = JIP.JobClass,
                   Equip = JIP.Equip,
                   Job = 0,
                   Status = Status$BT,
                   Feeder = FdrObjList[i].Object);
       IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          RETURN (PU_CANCEL);
       ENDIF;

       IF FGOExists = FALSE THEN
          SELECT  :FGOExists = :TRUE
          FROM    FMS_ObjectStatus 
          WHERE   Object = :FdrObjList[i].Object AND
                  Status = :Status$FGO AND
                  StatusCount > 0;
       ENDIF;
    ENDFOR;
    CALLPROC DDB_COMMIT;
/*
**  IF FGO exists for the feeder, then check if there are any other outstanding
**  FCR permits on the card.  If not, remove the FGO Feeder status.
*/
    IF FGOExists = TRUE THEN
       k = 0;

       REPEATED
       SELECT :k = COUNT(*)
       FROM   SOA_JobControl JC,
              SOA_Job J,
              FMS_JobAction JA
       WHERE  JC.Card = :C.Card AND
              JC.Job = J.Job AND
              J.TOIssued IS NOT NULL AND
              J.RSComplete IS NULL AND
              J.Equip = 0 AND
              J.JobClass = JA.JobClass AND
              JC.MoveEquipClass = JA.EquipClass AND
              JC.StepPair = JA.StepPair AND
              JA.TypeOfCard = :C.TypeOfCard AND
              JA.Status = :Prompt$FromWorkFCR;

       IF k = 0 THEN  /*No outstanding FCR permits, okay to remove FGO.*/

          FOR i = 1 TO FdrObjList.LastRow() DO
     
             RetCode = CALLPROC FMS_ObjStatDel
                  (Object = FdrObjList[i].Object,
                   Status = Status$FGO);

             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                MESSAGE 'Error removing FGO status for feeder.';
                RETURN (PU_CANCEL);
             ENDIF;
          ENDFOR;
          CALLPROC DDB_COMMIT;         
       ENDIF;        

    ENDIF;

    IF C.BackFromWork = 'Field grds only' THEN
/*
**  Update all OTW jobs that are related to this FGO JobClass and Equip
*/
        RetCode = CALLPROC FMS_CompleteFGO
                   (Response = JIP.Response,
                    JobClass = JIP.JobClass,
                    Equip = JIP.Equip,
                    Job = JIP.Job,
                    Card = C.Card,
                    StatusFGO = Status$FGO,
                    StatusOTW = Status$OTW,
                    Feeder = C.Feeder,  /* DB Proc has been modified for 3G to not use Feeder */
                    CompletionTime = JIP.RSComplete);
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           Message 'Problem attempting to complete with FGO.';
           RETURN (PU_CANCEL);
        ENDIF;
        CALLPROC DDB_COMMIT;

	NewJob = JIP.Duplicate();
        NewJob.TOOperator = NULL;
        NewJob.TOIssued = NULL;
	NewJob.RSComplete = NULL;
	NewJob.RSOperator = NULL;
	NewJob.TOMove = 'To FCR:  All FCR Work';
	NewJob.RSMove = 'To FCR:  All FCR Work';
	NewJob.Response = '';
	NewJob.WorkStatus = '';
        NewJob.Status = '';

        i = NewJob.InsertMove ( 
                  CardTypeOfCard = C.TypeOfCard,
                  KeepMoveText = TRUE);

        IF i <= 0 THEN
           MESSAGE 'Error creating new work permit for FCR All Work Done.' +
                 'You will have to set up the new work permit manually.';
           RETURN(PU_CANCEL);
        ENDIF;  

        JobID = IFNULL(i,0);
        CALLPROC DDB_COMMIT;

        NewJob.Status = Job$TakeOut;

        RetCode = NewJob.IssueMove(Job = NewJob);
        
        IF RetCode = PU_CANCEL THEN
           RETURN(PU_CANCEL);
        ENDIF;
/*
**  Call jobactions for new issue job
*/
        RetCode = NewJob.JobActions(IssueCompl = JobClass$Issue);

        IF RetCode = PU_CANCEL THEN
           RETURN(PU_CANCEL);
        ENDIF;
        CALLPROC DDB_COMMIT;
/*
**   Set FGO status for this feeder. previous frame prevents FGO from being set
**   again.
*/
        FOR i = 1 TO FdrObjList.LastRow() DO
           RetCode = CALLPROC FMS_ObjStatIns
                  (Object = FdrObjList[i].Object,
                   StatusCount = 1,
                   TimeSet = DATE('now'), 
                   Status = Status$FGO);

           IF RetCode < 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Error setting FGO status for feeder.';
              RETURN (PU_CANCEL);
           ENDIF;
        ENDFOR;
        CALLPROC DDB_COMMIT;

        i = 1;
        PickupEquip.Clear();
        REPEATED
        SELECT DISTINCT 
               PickupEquip[i].Equip = O.Object,
               PickupEquip[i].EquipName = O.Name,
               PickupEquip[i].EquipClass = O.Type,
               PickupEquip[i].EquipClassName = O.TypeName,
               PickupEquip[i].Description = O.Description
        FROM   SOA_Job JJ,
               FMS_WorkPermitProtection WPP,
               Udb_Object O
        WHERE  WPP.PermitCardType = 0 AND  /* Non-TLS */
               WPP.PermitJobID = :JIP.Job AND
               WPP.ProtectionCardType = 0 AND
               WPP.ProtectionJobID = JJ.Job AND
               JJ.ActivityIdentifier = 'N' AND
               JJ.Equip = O.Object
        BEGIN
           i = i + 1;
        END;

        IF PickupEquip.LastRow() >= 1 THEN
           i = 1;
           k = 1;
           ISOMove.Clear();
           WHILE i <= PickupEquip.LastRow() DO
              ISOFeeder = '';
              REPEATED
              SELECT :ISOFeeder = O.Name
              FROM    Udb_ExtendedType ET,
                      Udb_Object O, 
                      Udb_Grouping G
              WHERE   ET.SuperType = :Type$Feeder AND
                      ET.Type = G.GroupingType AND
                      G.RelationShip = :Interaction$MemberOf AND
                      G.Member = :PickupEquip[i].Equip AND
                      G.Grouping = O.Object;
           
              IF ISOFeeder <> '' THEN
                 ISOMove[k] = PickupEquip[i].Duplicate();
                 ISOMove[k].FeederName = ISOFeeder;
                 k = k + 1;
                 PickupEquip.RemoveRow(rownumber = i); /* don't increment i */
              ELSE
                 i = i + 1;
              ENDIF;
           ENDWHILE;

           IF PickupEquip.LastRow() >= 1 THEN
              PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                      'Picked Up.  Equipment which should be Picked Up:'  + HC_NEWLINE;  
              i = 1;  
              WHILE i <= PickupEquip.LastRow() DO
                 PromptText = PromptText + '  ''  ' + PickupEquip[i].EquipClassName + 
                              '  ' + PickupEquip[i].EquipName + '  ''' + HC_NEWLINE;
                 i = i + 1;
              ENDWHILE;
              PromptText = PromptText + HC_NEWLINE +
                         'You should Pick Up the equipment at this time.';

              MESSAGE :PromptText;

              CALLFRAME ConfirmPickupEquip(C = C,
                                           ChosenEquip = PickupEquip
                                           );
              CALLPROC DDB_COMMIT;
           ENDIF;

           IF ISOMove.LastRow() >= 1 THEN

              PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                      'transferred to Feeder.  Equipment which should be transferred:'  + 
                       HC_NEWLINE;  
              i = 1;  
              WHILE i <= ISOMove.LastRow() DO
                 PromptText = PromptText + 'Feeder:  ' + ISOMove[i].FeederName + '    ' +
                             'Equipment:   ' + ISOMove[i].EquipClassName + 
                              '   ' + ISOMove[i].EquipName + HC_NEWLINE;
                 i = i + 1;
              ENDWHILE;
              PromptText = PromptText + HC_NEWLINE +
                         'You should transfer the equipment at this time.';

              MESSAGE :PromptText;
           ENDIF;
        ENDIF;   

     ELSEIF C.BackFromWork = 'Back temp' THEN
/*
**   Set BT status for this job
*/
        FOR i = 1 TO FdrObjList.LastRow() DO
           RetCode = CALLPROC FMS_FromWorkStatusIns
                  (JobClass = JIP.JobClass,
                   Equip = JIP.Equip,
                   Job = JIP.Job, 
                   Status = Status$BT,
                   Feeder = FdrObjList[i].Object);
           IF RetCode < 0 THEN
              CALLPROC DDB_ROLLBACK;
              MESSAGE 'Error setting Back Temp feeder status.';
              RETURN (PU_CANCEL);
           ENDIF;
        ENDFOR;
        CALLPROC DDB_COMMIT;

        NewJob = JIP.Duplicate();
        NewJob.TOOperator = NULL;
        NewJob.TOIssued = NULL;
        NewJob.RSComplete = NULL;
        NewJob.RSOperator = NULL;
        NewJob.Response = '';
        NewJob.WorkStatus = '';
        NewJob.Status = '';

        i = NewJob.InsertMove ( 
                  CardTypeOfCard = C.TypeOfCard,
                  KeepMoveText = TRUE);

        IF i <= 0 THEN
           MESSAGE 'Error creating new work permit to cover back temp.' +
                   'You will have to set up the new work permit manually.';
           RETURN(PU_CANCEL);
        ENDIF;  

        JobID = IFNULL(i,0);
/*
**        Copy WorkPermits and PhaseChecks from old work permit to new one.
*/
        RetCode = CALLPROC FMS_WorkPermitCopy
                 (Card = C.Card,
                  OldWorkPermit = JIP.Job,
                  NewWorkPermit = JobID);
        IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           Message 'Unable to copy protections and phase checks to new work permit.';
           RETURN (PU_CANCEL);
        ENDIF;
        CALLPROC DDB_COMMIT;
/*
**  Check if an FCR returned permit, if so, copy locations
**  and tags to new permit.
*/
#       INCLUDE FCRPermitBTCopy          
        
/*
**  Copy drop/pickup equipment to the new work permit if necessary
*/
      i = 0;
      SELECT :i = COUNT(*) 
      FROM   IR_WorkEquipment
      WHERE  WorkPermit = :JIP.Job;
  
      IF i > 0 THEN
         RetCode = CALLPROC FMS_CopyPermitEquip
                 (Card = C.Card,
                  OldWorkPermit = JIP.Job,
                  NewWorkPermit = JobID);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
         ELSE
            CALLPROC DDB_COMMIT;
            Message 'Equipment to drop or pick up was copied to the new work permit. ' + 
                    'Drop/Pick equipment can be modified on the Work Permit Detail screen.';
         ENDIF;
      ENDIF;
    ELSE
	
       FOR f = 1 TO FdrObjList.LastRow() DO
         i = 0;
         REPEATED
         SELECT :i = COUNT(*)
         FROM   FMS_FromWorkStatus
         WHERE  Feeder = :FdrObjList[f].Object AND
                Status = :Status$BT;
           
         k = 0;
         REPEATED
         SELECT :k = COUNT(*)
         FROM   FMS_ObjectStatus
         WHERE  Object = :FdrObjList[f].Object AND
                Status IN (:Status$OTW,:Status$FGO,:Status$BT) AND
                StatusCount > 0;

         IF k = 0 AND i = 0 THEN          /* No more OTW Statuses remain */

            RetCode = CALLPROC ForceStatus (Feeder = FdrObjList[f].Object,
                                  NewStatus = Status$Blank);
            IF RetCode = PU_CANCEL THEN
                CALLPROC DDB_ROLLBACK;
                RETURN (PU_CANCEL);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
       ENDFOR;

        PFS_Continue = TRUE;
        IF C.CardClass = Type$Auto OR C.CardClass = Type$CIOA THEN

           RetCode = CALLFRAME OAPlusCheckWPReturn (
                                Card = C,
                                PermitJob = JIP.Job);
                 
           IF RetCode = PU_CANCEL THEN
              PFS_Continue = FALSE;
           ENDIF;
        ENDIF;

        IF (C.BackFromWork = 'All work done' OR
            C.BackFromWork = 'No work done') AND PFS_Continue = TRUE THEN

           /*  
           **  See if there are any outstanding work permits 
           **  that prevent restoration
           */
           /*  
           **  See if there are any outstanding work permits 
           **  that prevent restoration
           */
           RemainOTWR = 0;
           REPEATED
           SELECT :RemainOTWR = count(*)
           FROM   SOA_Job J,
                  SOA_JobControl JC,
                  FMS_WorkPermit WP,
                  FMS_JobAction JA
           WHERE  JC.Card = :C.Card AND
                  JC.Job = J.Job AND
                 (J.RSComplete = '' OR
                  J.RSComplete IS NULL) AND
                  J.Status <> 'Del' AND
                  J.Job  = WP.PermitJobID AND
                  WP.Restoration = :FALSE AND  /* 0 = prevent restoration */
                  JA.JobClass = J.JobClass AND
                  JA.FeederEquip = 3 AND
                  JA.Status = :Type$OTWR AND
                  JA.TypeOfCard = :C.TypeOfCard;

           RemainOTWS = 0;
           REPEATED
           SELECT :RemainOTWS = count(*)
           FROM   SOA_Job J,
                  SOA_JobControl JC,
                  FMS_WorkPermit WP,
                  FMS_JobAction JA
           WHERE  JC.Card = :C.Card AND
                  JC.Job = J.Job AND
                 (J.RSComplete = '' OR
                  J.RSComplete IS NULL) AND
                  J.Status <> 'Del' AND
                  J.Job  = WP.PermitJobID AND
                  WP.Restoration = :FALSE AND  /* 0 = prevent restoration */
                  JA.JobClass = J.JobClass AND
                  JA.FeederEquip = 3 AND
                  JA.Status = :Type$OTWS AND
                  JA.TypeOfCard = :C.TypeOfCard;
           
           RemainBusSect = 0;
           SELECT :RemainBusSect = count(*)
           FROM    SOA_FMSSLCLink S,
                   SOA_Job J,
                   SOA_JobControl JC
           WHERE   S.FMSCard = :C.Card AND
                   S.SLCCard = JC.Card AND
                   S.SwitchingItem = JC.SwitchingItem AND
                   JC.StepPair = :StepHeading$WorkPermit AND
                   JC.Job = J.Job AND
                   J.Status <> 'Del' AND
                   J.EquipClass = :TypeName$BusSect AND
                   J.ToIssued IS NOT NULL AND 
                   J.RSComplete IS NULL;
                   

           IF RemainOTWR = 0 AND RemainOTWS = 0 AND RemainBusSect = 0 THEN 
/*
**         No return code processing on purpose. This only sets actual 
**         timecomplete.  No need to fail entire transaction.
*/
              CALLPROC FMS_EstTimeCompleteUpd (
                      Card = C.Card,
                      EstTimeComplete = date('now'));
                      
              CALLPROC FMS_CardGenericUpd
                     (FieldName = 'acttimecomplete',
                      NewValue  = varchar('now'),
                      MatchCard = C.Card);
/*
**         Update esttimeinservice to be 1 hours from now
*/   
              CALLPROC FMS_EstTimeInServiceUpd 
                     (Card = C.Card,
                      EstTimeInService = IFNULL(date('now') + '1 hours',''));
              CALLPROC DDB_COMMIT;
           ENDIF;

           IF (C.CutOut IS NOT NULL AND C.CutIn IS NULL) THEN
              /*
              **  Determine what step should be.
              */
              IF RemainOTWR <> 0 THEN
                 NewOpStep = Type$OTWR;
              ELSEIF RemainOTWS <> 0 OR RemainBusSect <> 0 THEN
                 NewOpStep = Type$OTWS;
              ELSE
                 /*
                 **  Look for TC Feeder status.  If feeder is currently
                 **  in TC we will go to TC instead of PFS.  
                 */
                 i = 0;
                 SELECT :i = COUNT(*) 
                 FROM    FMS_ObjectStatus
                 WHERE   Object = :CardDetails.Object[1].Object AND
                         Status = :Status$TC AND
                         StatusCount > 0;
                 IF i <> 0 THEN
                    NewOpStep = Type$TC;
                 ELSE
                    NewOpStep = Type$PFSS;
                 ENDIF;
              ENDIF;
              /* 
              ** look at the current operating step
              */
              CurOpStep = 0;
              SELECT :CurOpStep = OperatingStep
              FROM   FMS_OperatingStepStatus
              WHERE  Card = :C.Card AND
                     OperatingStep in (:Type$OTWS, :Type$OTWR) AND
                     EndTime = '';         

              IF NewOpStep > 0 AND
                 NewOpStep <> CurOpStep THEN
                  IF SimpleStep IS NULL THEN
                     SimpleStep = OperatingStep_ASE.Create();
                  ENDIF;    
                  SimpleStep.SO.BaseType = C.CardClass;
                  SimpleStep.SO.Object   = C.Card;
                  SimpleStep.SO.Name     = C.CardClassName;
                  SimpleStep.SO.Type     = C.Feeder;
                  SimpleStep.SO.TypeName = C.FeederName;
                  SimpleStep.Job         = 0;
                  /*
                  **  If CurOpStep is OTWR and NewOpStep is OTWS,
                  **  we need to clear OTWR first because setopstep
                  **  has logic to ignore OTWS if the current step
                  **  is OTWR. 
                  */
                  IF CurOpStep = Type$OTWR AND NewOpStep = Type$OTWS THEN
                     SimpleStep.OpStep = CurOpStep;
                     SimpleStep.ClearOpStep();
                  ENDIF;
                  SimpleStep.OpStep      = NewOpStep;
                  
                  SimpleStep.SetPFSNow = 2;  /* Forces PFSS to be set immediately */

                  SimpleStep.SetOpStep();
                  IF SimpleStep.ReturnCode <> 0 THEN
                     CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                                          TraceMessage =
                                              'Prompt:ProcFromWork; ' +
                                              'Error setting op step. ' +
                                              'Card=' + VARCHAR(C.Card) +
                                              ';Status=' + VARCHAR(NewOpStep) + '.'
                                          );
                      RETURN (PU_Cancel);
                  ENDIF; 
              ENDIF;  // NewOpStep
           ENDIF; // Cutout but not cutin.
        ENDIF;

        IF C.BackFromWork = 'All work done' THEN
                                                    
           C.PhaseChecks = TRUE;
/*
**         No retcode processing here on purpose. Only sets phase check
**         button highlight.
*/
           CALLPROC FMS_CardGenericUpd
                  (FieldName = 'phasechecks',
                   NewValue  = varchar(C.PhaseChecks),
                   MatchCard = C.Card);
           FCFrame.SendUserEvent (EventName = 'HandlePhaseChecks');
           CALLPROC DDB_COMMIT;
    
           i = 1;
           PickupEquip.Clear();
           REPEATED
           SELECT DISTINCT 
                  PickupEquip[i].Equip = O.Object,
                  PickupEquip[i].EquipName = O.Name,
                  PickupEquip[i].EquipClass = O.Type,
                  PickupEquip[i].EquipClassName = O.TypeName,
                  PickupEquip[i].Description = O.Description
           FROM   SOA_Job JJ,
                  FMS_WorkPermitProtection WPP,
                  Udb_Object O
           WHERE  WPP.PermitCardType = :Type$FMSApp AND
                  WPP.PermitJobID = :JIP.Job AND
                  WPP.ProtectionCardType = :Type$FMSApp AND
                  WPP.ProtectionJobID = JJ.Job AND
                  JJ.ActivityIdentifier = 'N' AND
                  JJ.Equip = O.Object
           BEGIN
              i = i + 1;
           END;
    
           IF PickupEquip.LastRow() >= 1 THEN
              i = 1;
              k = 1;
              ISOMove.Clear();
              WHILE i <= PickupEquip.LastRow() DO
                 ISOFeeder = '';
                 REPEATED
                 SELECT :ISOFeeder = O.Name
                 FROM    Udb_ExtendedType ET,
                         Udb_Object O, 
                         Udb_Grouping G
                 WHERE   ET.SuperType = :Type$Feeder AND
                         ET.Type = G.GroupingType AND
                         G.RelationShip = :Interaction$MemberOf AND
                         G.Member = :PickupEquip[i].Equip AND
                         G.Grouping = O.Object;
              
                 IF ISOFeeder <> '' THEN
                    ISOMove[k] = PickupEquip[i].Duplicate();
                    ISOMove[k].FeederName = ISOFeeder;
                    k = k + 1;
                    PickupEquip.RemoveRow(rownumber = i); /* don't increment i */
                 ELSE
                    i = i + 1;
                 ENDIF;
              ENDWHILE;
         
              IF PickupEquip.LastRow() >= 1 THEN
                 PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                         'Picked Up.  Equipment which should be Picked Up:'  + HC_NEWLINE;  
                 i = 1;  
                 WHILE i <= PickupEquip.LastRow() DO
                    PromptText = PromptText + '  ''  ' + PickupEquip[i].EquipClassName + 
                                 '  ' + PickupEquip[i].EquipName + '  ''' + HC_NEWLINE;
                    i = i + 1;
                 ENDWHILE;
                 PromptText = PromptText + HC_NEWLINE +
                            'You should Pick Up the equipment at this time.';
         
                 MESSAGE :PromptText;
         
                 CALLFRAME ConfirmPickupEquip(C = C,
                                              ChosenEquip = PickupEquip
                                              );
                 CALLPROC DDB_COMMIT;
              ENDIF;
         
              IF ISOMove.LastRow() >= 1 THEN
   
                 PromptText = 'Work Permit is complete, however,  equipment has not yet been ' +
                         'transferred to Feeder.  Equipment which should be transferred:'  + 
                          HC_NEWLINE;  
                 i = 1;  
                 WHILE i <= ISOMove.LastRow() DO
                    PromptText = PromptText + 'Feeder:  ' + ISOMove[i].FeederName + '    ' +
                                'Equipment:   ' + ISOMove[i].EquipClassName + 
                                 '   ' + ISOMove[i].EquipName + HC_NEWLINE;
                    i = i + 1;
                 ENDWHILE;
                 PromptText = PromptText + HC_NEWLINE +
                            'You should transfer the equipment at this time.';
   
                 MESSAGE :PromptText;
              ENDIF;
           ENDIF;   
        ENDIF;
   ENDIF;

   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);
END;

