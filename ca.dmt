	Name:            PromptVerifyPumpStatus

/*
**
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptVerifyPumpStatus
**
**  Modifications:
**  09/10/14   em  Created
**  10/29/21  em   Incorporate SSO return
*/
INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    Response = VARCHAR(40) NOT NULL WITH DEFAULT;
    retcode = INTEGER NOT NULL; /* return variable */
    Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
    StructureType = VARCHAR(40) NOT NULL WITH DEFAULT;
    PumpSt = VARCHAR(10) NOT NULL WITH DEFAULT;
    ACFeed = CHAR(3) NOT NULL WITH DEFAULT;
    ByPass = CHAR(3) NOT NULL WITH DEFAULT;
)=
BEGIN
   /*
   ** uncheck all radio buttons.
   */
   pmode = -1;
   
   SELECT :StructureType = StructureTypeName,
          :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;
   
   SELECT :PumpSt = PumpStatus,
          :ACFeed = ACFeedRemoved,
          :ByPass = ByPassOn
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF PumpSt <> '' THEN
      IF UPPER(PumpSt) = 'AUTO' THEN
         PMode = 1;
      ELSEIF UPPER(PumpSt) = 'HAND' THEN
         PMode = 2;
      ELSEIF UPPER(PumpSt) = 'CIRC SEND' THEN
         PMode = 3;
      ELSEIF UPPER(PumpSt) = 'CIRC RCV' THEN
         PMode = 4;
      ELSE /* Default */
         PMode = 0;
      ENDIF;
      
      IF ACFeed = 'YES' THEN
         ACFeedRemoved = 1;
      ELSE
         ACFeedRemoved = 0;
      ENDIF;

      IF ByPass = 'YES' THEN
         ByPassOn = 1;
      ELSE
         ByPassOn = 0;
      ENDIF;
      
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(PMode).CurBias = FB_VISIBLE;
      FIELD(ACFeedRemoved).CurBias = FB_VISIBLE;
      IF ByPass = 'YES' THEN
         FIELD(ByPassOn).ParentField.CurBias = FB_VISIBLE;
      ENDIF;
   ENDIF;

   FIELD(Heading).TextValue = 'Pump Status for ' + SQUEEZE(StructureType + ' ' + Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName);
END;

ON CLICK OK_btn = 
BEGIN
   IF pmode = -1 THEN
      MESSAGE 'Please select a status for the pump';
      RESUME;
   ENDIF;

      RetCode = CALLPROC Udb_PumpFieldUpd (
                Object = JIP.Equip,
                FieldName =  'status',
                FieldValue = pmode 
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Pump Status.',
                           TraceMessage =
               'PromptVerifyPumpStatus: Unable to set pump status  ' +
               'for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ENDIF; 
  
      RetCode = CALLPROC Udb_PumpFieldUpd (
                Object = JIP.Equip,
                FieldName =  'acfeedremoved',
                FieldValue = acfeedremoved 
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Pump AC Feed Removed.',
                           TraceMessage =
               'PromptVerifyPumpStatus: Unable to set pump AC Feed Removed  ' +
               'for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ENDIF;

      RetCode = CALLPROC Udb_PumpFieldUpd (
                Object = JIP.Equip,
                FieldName =  'ByPassOn',
                FieldValue = bypasson 
               );

      IF (RetCode <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
               'ERROR: Unable to set Pump VFD ByPass.',
                           TraceMessage =
               'PromptVerifyPumpStatus: Unable to set pump VFD ByPass  ' +
               'for object=' + VARCHAR(JIP.Equip) + '.'
                             );
          RETURN (PU_CANCEL);
      ENDIF;
      CALLPROC DDB_COMMIT;

   Response = 'Status:' + FIELD(Pmode).CurEnumText;
   IF ACFeedRemoved = 1 THEN
      Response = Response + '; ACFeedRemoved';
   ENDIF;
   IF ByPassOn = 1 THEN
      Response = Response + '; VFDByPass On';
   ENDIF;
   JIP.Response = Squeeze(Response + ' ' + JIP.Response);
   JIP.ResponseUpd();

      RETURN (PU_OK);

END;
				 *Default Item

					 *Default Item

					 *Default Item


