**  08/23/07    em       For Steam cards, add support for generic valves
**  10/03/07    em       Add Main to equipment selection list; make lock move work for steam
**  10/04/07    em       Change sort order for street valves; append main to move text
**  10/24/07    em       Street Valves are loaded into global array at Initialize time
**  12/11/07    em       Add DropBackValves Scenario for Steam Sole Auth
**  12/12/07    ysp      if the black scenario does not include any line, the first 
**                       substation will be used to load the equipment list.
**  01/10/08    ysp      itc 216: when work includes FMS card, prompt DO to select a 
**                       FMS card class.
**  01/24/08    em       Complete SDS Dropback Scenario
**  01/31/08    em       Confirm each Main to be added to a card.
**  02/13/08    em       Revise message for Adding Main to card; rfemove
**                       capability for combining two active Steam cards.  Once active with an
**                       MSO number, active cards should not be combined.
**  04/01/08  ysp        Enhanced for ITC 216: If the SLC work involves multiple feeders,
**                       prompt DO once for the first FMS card's class, then reuse
**                       the same card class.
**  04/21/08  ysp        ITC216: check if there is an active FMS card first before asking
**                       DO for open card class.
**  05/09/08  ysp        SLC 55: ADD Group Disconnect Scenario.
**  07/07/08  em         Check for Spare Bank Breaker Preload for Bus Section Scenario
**  07/25/08  em         Moved Scenario builder logic that removes Load Breaker moves from
**                       SLC to TFMS.  
**  02/02/09  em         Change label of Find button to Reset when Equipment is locked.
**  02/05/09  em         Load Steam Gen Stations if in a Macro
**  09/29/09  em         When inserted Boxed Valve move for Steam, ignore move rules when 
**                       establishing move text.
**  10/07/09  em         Boxed Valve step includes other moves, only change move text when 
**                       No TakeOut and No Restore
**  10/08/09  em         Add Station list to non-sole auth card.
**  08/27/10  em         Modify CreateFMSOpenCard calls to look for Network Feeder conditions.
**  12/10/10  em         For a Non-sole auth Station card, limit station list to card station.
**  03/03/11  em         FMSCardCreation moved to external procedure to be called from elsewhere.
**  04/05/11  em         3G Support
**  04/20/11  em         Extended AllEquipMoves/EquipSpecificMoves toggle from FMS to here
**  04/27/11  em         For TFMS, ignore OutService field when loading equipment.
**  06/03/11  em         For Steam, default AllOrEquip to All
**  06/07/11  em         Extend Steam AllorEquip change to Equip Select
**  12/16/11  em         Extend link to FMS to TFMS moves
**  06/08/12  em         Ignore Equipment when looking at Substation to get desk
**  11/02/12  em         When processing for FMS cards, include alternate source breaker feeders 
**  11/26/12  em         Don't automatically delete duplicate scenario move when the multiple
**                       preload flag is set.  When Multiple Preload is set ensure  
**                       two moves with no duplicate move warnings.
**  02/08/13  em         Display multikV stations in reference order.
**  02/27/13  em         Put an IFNULL wrapper around the MultikV G.Reference select
**  08/31/16  em         For transition period to new diagram editor, exclude ACLineSegments
**                       from equipment list that are not connected in Udb_Terminal. 
**  03/31/17  em         Use DSO_Connection to determine InService instead of Udb_Terminal and remove
**                       prior interim change to exclude ACLineSegments.
**                       Remove logic when selecting ACLineSegment to select substation since
**                       ACLineSegment can be selected specific to substation.
**  04/03/17  em         Load the ACLineSegments for a line together at the top of the list.
**  05/04/17  em         Reinsert option to select FIELD on ACLineSegment where substation attribute is blank.
**  08/28/17  ysp        Exclude Work Point scenario
**  10/25/17  em         Moved from SOA Application; modification to support ORTransformer parameter to auto-select
**                       Tap Changer Inspection scenario
**  11/09/17  em         Removed 10/25 enhancemenet
**  11/16/17  em         Show **No Restore** text, then blank it before insertion 
**  05/22/18  em         Automatic population for specific Drainage Verification move.
**  05/23/18  em         Copy MoveEquipClass to Drainage Verification move.
**  10/23/18  ysp        Add TargetEquipment parameter to automatically select the equipment and load moves
**  11/14/18  em         Implement Work Point Scenario Builder Demo.
**  06/12/19  em         On Find Reset, repopulate the equipname value to original find so that find can be repeated.
*/
INITIALIZE 
(
#  include StandardDeclarations
/*
** Passed variables
*/
   Card                	= INTEGER NOT NULL;   /* Card parameter */
   CardObject           = INTEGER NOT NULL;
   CardObjectName       = VARCHAR(40) NOT NULL WITH DEFAULT;
   CardStatus           = INTEGER NOT NULL WITH DEFAULT; /*Passed card status*/
   CardSwitchingItem    = INTEGER NOT NULL WITH DEFAULT; /*Passed switch item*/
   CardTypeofCard       = INTEGER NOT NULL WITH DEFAULT; /*Passed TypeofCard*/
   ScenarioWorkPoint       = INTEGER NOT NULL WITH DEFAULT; /*Passed WorkPoint Demo*/
   MultiplekVFlag    	= INTEGER NOT NULL WITH DEFAULT;  /* TRUE if Macro */
   Object               = INTEGER NOT NULL;   /* Load equip for this object - passed in for SLC */
   ObjectName           = VARCHAR(40) NOT NULL WITH DEFAULT;  /* Object Name - passed in for SLC */
   SwitchingItemMoveText = VARCHAR(160) NOT NULL WITH DEFAULT; /*Passed TOMove*/
   TargetEquipment      = ObjectSummaryClass DEFAULT NULL;   /* defective equipment for SLC */
/*
** Local variables
*/
   ACLSubstation        = INTEGER NOT NULL WITH DEFAULT; /*Selected Substation*/
   ACLSubstationName    = VARCHAR(40) NOT NULL WITH DEFAULT;/*Selected Subst*/
   ACLTypes             = ARRAY OF INTEGEROBJECT;
   BusSectionEquip      = Equipment DEFAULT NULL; /*For Generic Bus Section*/
   EquipBaseType        = INTEGER NOT NULL;  /*BOOLEAN - Is it a AC Line Seg */
   EquipConnected	= INTEGER NOT NULL WITH DEFAULT; /*Connected Flag*/
   EquipMoveFound = INTEGER NOT NULL WITH DEFAULT;
   MoveEquipList        = ARRAY OF IntegerObject; /*Track move equipment */
   EquipStatus		= CHAR(3) NOT NULL WITH DEFAULT; /*Blank or NIS*/
   EventText            = VARCHAR(256) NOT NULL WITH DEFAULT; /*DBEvent Text*/
   EquipFound		= INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   FindEquip            = VARCHAR(40) NOT NULL WITH DEFAULT; 
   FindRow		= INTEGER NOT NULL WITH DEFAULT; /*Enable repeat find*/
   FilteredEquipList    = ARRAY OF Equipment;   /*Storage to avoid reselect*/
   FullEquipList        = ARRAY OF Equipment;   /*Storage to avoid reselect*/
   Idx                  = ARRAY OF IntegerObject; /*Track impacted cards*/
   ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
   InsertionList        = ARRAY OF NewMoveCard; /*List of cards to insert move*/
   j                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   k                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   LockedMove           = JOB DEFAULT NULL;  /* Selected Move for Insertion*/
   m                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   Match		= VARCHAR(80) NOT NULL WITH DEFAULT; /*MatchingString*/
   MoveSelected         = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   n                    = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   OtherJobControlCard  = INTEGER NOT NULL WITH DEFAULT; /*Job control elsewhr*/
   OtherSwitchingItem   = INTEGER NOT NULL WITH DEFAULT; /*Switching Item*/
   OtherSWName          = VARCHAR(160) NOT NULL WITH DEFAULT; /*SW TO Move Text*/
   OutofControl         = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   PrefixMoveText       = VARCHAR(40) NOT NULL WITH DEFAULT; /*Text Holder*/
   ProtectionMoveList   = ARRAY OF Generic_Job; /*List of moves inserted*/
   RepeatMove       	= INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   ScenarioDate         = DATE NOT NULL; /*Scenario Timestamp table index*/
   ScenarioEquipList    = ARRAY OF ConnectedEquipClass; /*Equipment list*/
   ScenarioInserted     = INTEGER NOT NULL;     /*BOOLEAN*/
   ScenarioType 	= INTEGER NOT NULL; 	/*Selected Scenario*/
   ScenarioMoves        = ARRAY OF Job;         /*Moves to preload by Scenario*/
   ScenarioJobs         = ARRAY OF INTEGEROBJECT; /*Retention list for history*/
   ScenarioJobCount 	= INTEGER NOT NULL;  	/*COUNTER*/
   ScenarioName         = VARCHAR(40) NOT NULL; /*Selected Scenario*/  
   ScenarioStartPoint 	= INTEGER NOT NULL;  	/*Selected Scenario StartPoint*/
   ScenarioStopPoint 	= VARCHAR(24) NOT NULL; /*TracePoint based on Scenario*/
   SelectedMoveEquipClass = INTEGER NOT NULL WITH DEFAULT; /*For Lock Move*/
   Select_Equip         = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/ 
   Select_Node          = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/
   Select_Term          = INTEGER NOT NULL WITH DEFAULT;/*For Bus Section*/
   SpareJob             = Job DEFAULT NULL;
   SpareEquip           = ARRAY OF Equipment;
   Stepheading          = VARCHAR(60) NOT NULL WITH DEFAULT; /*Step Heading*/
   StepHeadingExist     = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   SteamStation         = INTEGER NOT NULL WITH DEFAULT;  
   SteamSoleAuth        = INTEGER NOT NULL WITH DEFAULT;  
   SteamStationName     = VARCHAR(40) NOT NULL WITH DEFAULT;  
   SubstationExist      = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   SuffixMoveText       = VARCHAR(40) NOT NULL WITH DEFAULT; /*Text Holder*/
   TempObject           = INTEGER NOT NULL WITH DEFAULT; /*Object*/
   TempRef              = INTEGER NOT NULL WITH DEFAULT; /*Reference*/
   TempName             = VARCHAR(40) NOT NULL WITH DEFAULT; /*Name*/
   TFMSCardClass        = INTEGER NOT NULL WITH DEFAULT;  
   TFMSObjRefList       = ARRAY OF ObjectSummaryClass; /*list of tfms object_ref */
) =
DECLARE
    FindDropBacks = PROCEDURE;
    LoadEquipData = PROCEDURE;
    ProcessFMSCards = PROCEDURE;
    ProcessSDSCards = PROCEDURE;  /*Look if another Main needs to be added to this card*/
ENDDECLARE 
BEGIN
   NewMoves.Clear();
   Selected.Equip = 0;
   FIELD(Object_Ref).ValueList.ChoiceItems.Clear();

/* ON SLC, Remember to  Pass  SwitchingItemMoveText */

   IF CurrentApplication = Application$SLC THEN
      sw.SwitchingItemMoveText = SwitchingItemMoveText;
      FIELD(sw).CurBias = FB_VISIBLE;
   ELSE
      FIELD(sw).CurBias = FB_INVISIBLE;
   ENDIF;

   FIELD(Scenario).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Scenario).ValueList.ChoiceItems[1].EnumText = ''; 
/* ON SLC, Pass  Multiple kV Flag */

   IF CurrentApplication = Application$SLC THEN 

      IF MultiplekVFlag = FALSE THEN

         FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumValue = Object;
         FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumText = ObjectName;
         FIELD(Object_Ref).CurBias = FB_VISIBLE;
      ELSE

         i = 1;        
         SELECT :TempObject = O.Object,
                :TempName = O.Description,
                :TempRef = IFNULL(G.Reference,0)
         FROM    Udb_Object O,
                 Udb_Grouping G
         WHERE   G.Grouping = :Object AND
                 G.Relationship = :Interaction$MemberOf AND
                 O.Object = G.Member AND
                 G.Reference > 0
         ORDER BY 3
         BEGIN
            IF i = 1 THEN
               Object = TempObject;
               ObjectName = TempName;
            ENDIF;  
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName; 
            i = i + 1;
         END;      
         FIELD(Object_Ref).CurBias = FB_CHANGEABLE;

      ENDIF;

      i = 2;        
      SELECT :TempObject = T.Type,
             :TempName = T.Name
      FROM    Udb_Type T,
              Udb_SuperType ST
      WHERE   ST.SuperType = :Scenarios$SLC AND
              ST.Type = T.Type AND
              T.Type <> :Scenario$WorkPoint
      ORDER BY 2
      BEGIN
         FIELD(Scenario).ValueList.ChoiceItems[i].EnumValue = TempObject;
         FIELD(Scenario).ValueList.ChoiceItems[i].EnumText = TempName; 
         i = i + 1;
      END;      
      FIELD(Scenario).CurBias = FB_CHANGEABLE;

   ELSEIF CurrentApplication = Application$TFMS THEN
      SELECT :TFMSCardClass = CardClass
      FROM   SOA_Card
      WHERE  Card = :Card;

      i = 1;
      SELECT  :TempObject = Object,
              :TempName = Name
      FROM    TFMS_CardToObject 
      WHERE   Card = :Card AND 
              Type = :Type$Line 
      BEGIN            
         IF i = 1 THEN
            Object = TempObject;
            ObjectName = TempName;
         ENDIF;
         FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
         FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName; 
         TFMSObjRefList[i].Object = TempObject;
         TFMSObjRefList[i].Type = Type$Line;
         i = i + 1;
      END;

      IF TFMSCardClass = Type$TFMSBLCK THEN
         /* continue from the previous counter i */
         k = i;
         SELECT  :TempObject = Object,
                 :TempName = Name
         FROM    TFMS_CardToObject 
         WHERE   Card = :Card AND 
                 Type = :Type$Substation
         BEGIN            
            IF Object = 0 AND i = k THEN
               /* if the black scenario does not include any line, the first 
               ** substation will be used to load the equipment list.
               */
               Object = TempObject;
               ObjectName = TempName;
            ENDIF;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName; 
            TFMSObjRefList[i].Object = TempObject;
            TFMSObjRefList[i].Type = Type$Substation;
            i = i + 1;
         END;
      ENDIF;

      IF i > 1 THEN
         FIELD(Object_Ref).CurBias = FB_CHANGEABLE;
      ENDIF;

      i = 2;        
      SELECT :TempObject = T.Type,
             :TempName = T.Name
      FROM    Udb_Type T,
              Udb_SuperType ST
      WHERE   ST.SuperType = :Scenarios$TFMS AND
              ST.Type = T.Type AND
              T.Type <> :Scenario$WorkPoint
      ORDER BY 2
      BEGIN
         FIELD(Scenario).ValueList.ChoiceItems[i].EnumValue = TempObject;
         FIELD(Scenario).ValueList.ChoiceItems[i].EnumText = TempName; 
         i = i + 1;
      END;      
      FIELD(Scenario).CurBias = FB_CHANGEABLE;

   ELSEIF CurrentApplication = Application$SDS THEN
      FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumValue = -1; /*Our indicator for Street Valves*/
      FIELD(Object_Ref).ValueList.ChoiceItems[1].EnumText = 'Street Valves'; 

      SELECT  :SteamStation = Station,
              :SteamStationName = StationName,
              :SteamSoleAuth = SoleAuthority
      FROM    SDS_Card 
      WHERE   Card = :Card;

      IF SteamSoleAuth = TRUE THEN
/*
** If EastRiver Gen, have to load substation members
*/
         i = 2;
         SELECT :TempObject = O.Object,
                :TempName = O.Name
         FROM   Udb_Grouping G,
                Udb_Object O
         WHERE  G.Grouping = :SteamStation AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$SteamGenStation AND
                G.Member = O.Object
         BEGIN    
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName;  
            i = i + 1;
         END;
         IF i = 2 THEN
            FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumValue = SteamStation;
            FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumText = SteamStationName; 
            i = i + 1;
         ENDIF;         
         SELECT :TempObject = Main,
                :TempName = MainName
         FROM   SDS_CardMain
         WHERE  Card = :Card
         ORDER BY 2
         BEGIN
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName + ' Main';  
            i = i + 1;
         END;
         FIELD(Object_Ref).CurBias = FB_CHANGEABLE;

         FIELD(Scenario).ValueList.ChoiceItems[2].EnumValue = 99;
         FIELD(Scenario).ValueList.ChoiceItems[2].EnumText = 'Drop Back Valve'; 
      ELSEIF SteamStation <> 0 THEN   /*non-sole auth Station Log card*/
/*
** If EastRiver Gen, have to load substation members
*/
         i = 2;
         SELECT :TempObject = O.Object,
                :TempName = O.Name
         FROM   Udb_Grouping G,
                Udb_Object O
         WHERE  G.Grouping = :SteamStation AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$SteamGenStation AND
                G.Member = O.Object
         BEGIN    
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName;  
            i = i + 1;
         END;
         IF i = 2 THEN
            FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumValue = SteamStation;
            FIELD(Object_Ref).ValueList.ChoiceItems[2].EnumText = SteamStationName; 
            i = i + 1;
         ENDIF;         
      ELSE
         i = 2;
         SELECT :TempObject = O.Object,
                :TempName = O.Name
         FROM   Udb_Object O
         WHERE  O.Type = :Type$SteamGenStation 
         BEGIN    
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumValue = TempObject;
            FIELD(Object_Ref).ValueList.ChoiceItems[i].EnumText = TempName;  
            i = i + 1;
         END;

      ENDIF;     
   ENDIF;   
   CALLPROC DDB_ROLLBACK;

   CurFrame.StatusText = 'Loading Equipment list...';
   ACLTypes.Clear();
   IF CurrentApplication = Application$SDS THEN
      AllOrEquip = 0;
      TypeExclusion = FALSE;
      Object = -1;
      FIELD(TypeExclusion).CurBias = FB_INVISIBLE;
   ELSE
      AllOrEquip = 1;
      TypeExclusion = TRUE;
      i = 1;
      SELECT :ACLTypes[i].Value = Type
      FROM   Udb_ExtendedType
      WHERE  SuperType = :Type$ACLineSegment
      ORDER BY 1
      BEGIN
         i = i + 1;
      END;
   ENDIF;

   IF TypeExclusion = FALSE THEN
      CALLPROC LoadEquipData(PassedInList = ByRef(FullEquipList),
                             Exclusion = TypeExclusion );
   ELSE
      CALLPROC LoadEquipData(PassedInList = ByRef(FilteredEquipList),
                             Exclusion = TypeExclusion );
   ENDIF;
   
   IF TargetEquipment IS NOT NULL THEN
      Selected.EquipclassName = TargetEquipment.TypeName;
      Selected.EquipName = TargetEquipment.Name;
      
      IF TargetEquipment.Object > 0 THEN      
         WHILE i <= SelectEquip.LastRow() DO
            IF SelectEquip[i].Equip = TargetEquipment.Object THEN
               Field(SelectEquip).ActiveRow = i;
               FIELD(SpecialNote).TextValue = 'Equipment match found...';
               FIELD(SpecialNote).CurBias = FB_VISIBLE;
               CurFrame.SendUserEvent(EventName = 'Select_Equip');
               Endloop;
            ENDIF;
            i = i + 1;
         ENDWHILE;
      ENDIF;
   ENDIF;
   
   IF ScenarioWorkPoint > 0 THEN
      Scenario = CALLFRAME SelectScenario (StartPoint = ScenarioWorkPoint,
                                           Application = CurrentApplication); 
      IF Scenario > 0 THEN
         ScenarioStartPoint = ScenarioWorkPoint; 
         ScenarioType = FIELD(Scenario).CurEnumValue;
         ScenarioName = FIELD(Scenario).CurEnumText;
         IF ScenarioType = 0 THEN
            MESSAGE 'DEBUG Message, No ScenarioType';
            RETURN PU_CANCEL;
         ENDIF;
         CurFrame.SendUserEvent (EventName = 'ContinueScenario');
      ELSE 
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;
END;


ON SetValue Scenario =
BEGIN
/**
 **  On selection of a Scenario
 **/
       ScenarioType = FIELD(Scenario).CurEnumValue;
       ScenarioName = FIELD(Scenario).CurEnumText;

       IF ScenarioType = 0 THEN 
          RESUME;
       ENDIF;

       IF ScenarioType = 99 AND CurrentApplication = Application$SDS THEN
          IF Selected.Equip = 0 THEN
             MESSAGE 'Please select an Isolation Valve in order to find Drop Backs.';
             Scenario = 1;
             RESUME;
          ENDIF;
/*
** Make sure valve is in a station.
*/
          i = 0;
          SELECT :i = Grouping
          FROM   Udb_Grouping
          WHERE  Member = :Selected.Equip AND
                 Relationship = :Interaction$MemberOf AND
                 GroupingType = :Type$SteamGenStation;

          IF i = 0 THEN
             MESSAGE 'Selected Valve is not in a Gen Station / cannot find Drop Backs.';
             Scenario = 1;
             RESUME;
          ENDIF;

          CALLPROC FindDropBacks (Valve = Selected.Equip);
    
          RESUME;
       ENDIF;

       CurFrame.StatusText = 'Select trace start point...';
       CurFrame.Flush();

       ScenarioStartPoint = CALLFRAME SelectScenarioStartPoint (
                               Scenario = ScenarioType,
                               ScenarioName = ScenarioName,
                               Card = Card,
                               Application = CurrentApplication);
       IF ScenarioStartPoint = 0 THEN
          RESUME;
       ENDIF;
       
       CurFrame.SendUserEvent (EventName = 'ContinueScenario');
END;

ON USEREVENT 'ContinueScenario' =
BEGIN 
/*
** Now we have the scenario and the trace startpoint.  Now we do the trace
** to build the equipment list.  First check if we selected the R/O Breaker
** for a Breaker Inspection.  If that is the case, we don't need to do the 
** trace.
*/
    ScenarioEquipList.Clear();
    ScenarioDate = 'now';

    IF ScenarioType = Scenario$BreakerInspection THEN
       REPEATED 
       SELECT   :ScenarioEquipList[1].Object = Object,
                :ScenarioEquipList[1].Type = Type
       FROM     Udb_Object
       WHERE    Object = :ScenarioStartPoint AND
                Type IN (SELECT Type FROM Udb_ExtendedType
                         WHERE  SuperType IN (:Type$BkrRO,:Type$BkrROspare) );  
       LastRow = 1;
    ENDIF;
  
    IF ScenarioEquipList.LastRow() = 0 THEN
/*
** If we are doing SLC Tap Changer Inspection, then we call the connectivity 
** trace twice.  First one gets the De-Energizing Breakers only.
*/    
       IF CurrentApplication = Application$SLC AND 
          ScenarioType = Scenario$TapChangerInspection THEN
       
          CurFrame.StatusText = 'Tracing to find De-Energizing Breakers...';
          CurFrame.Flush();

          RetCode = CALLPROC ScenarioTrace (
                      Card = Card,
                      StartPoint = ScenarioStartPoint,
                      StopPoint = 'DeEnBreaker',
                      Scenario = ScenarioType,
                      CollectedEquip = ScenarioEquipList);

          IF RetCode = PU_CANCEL THEN
             RESUME;
          ENDIF;

          LastRow = ScenarioEquipList.LastRow();
          IF LastRow < 2 THEN 
             MESSAGE 'Did not find at least two de-energizing breakers on ' +
                     'initial tap changer connectivity trace.';
             RESUME;
          ENDIF;

          FOR i = 1 TO LastRow DO
       
              RetCode = CALLPROC SOA_ScenarioEquipIns (
                      UserName = UserName,
                      ScenarioDate = ScenarioDate,
                      Equip = ScenarioEquipList[i].Object,
                      EquipClass = ScenarioEquipList[i].Type);
              IF RetCode <> 0 THEN
                 CALLPROC DDB_ROLLBACK;
                 MESSAGE 'Error inserting de-energizing breaker equipment ' +
                      'into database for Scenario Preload.';

                 RetCode = CALLPROC SOA_ScenarioEquipDel (
                     UserName = UserName,
                     ScenarioDate = ScenarioDate);
                 IF RetCode <> 0 THEN
                    CALLPROC DDB_ROLLBACK;
                    MESSAGE 'Warning - Unable to remove Scenario Equipment ' +
                            'from preload engine database table for UserName: ' + 
                            UserName + 
                            ', Scenario Date: ' + VARCHAR(ScenarioDate) +
                         '.  Please contact tech support so that the data can be ' +
                         'deleted manually.';
                 ELSE
                    CALLPROC DDB_COMMIT;
                 ENDIF;      
                 RESUME;
              ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;

       ENDIF;

       ScenarioEquipList.Clear();
/*
** Now do the big trace to build the full connected equipment list.
** Scenario Stop is based on the Scenario selected.
*/    
       IF ScenarioType = Scenario$TripCheck OR 
             ScenarioType = Scenario$BusSectionWork OR 
             ScenarioType = Scenario$EquipmentVerification OR
             ScenarioType = Scenario$ElectricalVerification THEN
          ScenarioStopPoint = 'OutboardDisc';

       ELSEIF ScenarioType = Scenario$DelugeTest THEN
          ScenarioStopPoint = 'DeEnBreaker';

       ELSEIF Scenario = Scenario$GroupDisconnect THEN
          ScenarioStopPoint = 'SourceBreaker';

       ELSE
          ScenarioStopPoint = 'VisibleBreak';
       ENDIF;

       CurFrame.StatusText = 'Tracing to build Equipment List...';
       CurFrame.Flush();

       RetCode = CALLPROC ScenarioTrace (
                      Card = Card,
                      StartPoint = ScenarioStartPoint,
                      StopPoint = ScenarioStopPoint,
                      Scenario = ScenarioType,
                      CollectedEquip = ScenarioEquipList);

       IF RetCode = PU_CANCEL THEN
          RESUME;
       ENDIF;

       LastRow = ScenarioEquipList.LastRow();
       IF LastRow <= 1 THEN 
          MESSAGE 'Scenario Connectivity Trace did not return any connected ' +
               'devices.';
          RESUME;
       ENDIF;
    ENDIF;

    FOR i = 1 TO LastRow DO
       
       RetCode = CALLPROC SOA_ScenarioEquipIns (
                      UserName = UserName,
                      ScenarioDate = ScenarioDate,
                      Equip = ScenarioEquipList[i].Object,
                      EquipClass = ScenarioEquipList[i].Type);
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error inserting equipment into database for Scenario ' +
                  'Preload.';

          RetCode = CALLPROC SOA_ScenarioEquipDel (
                UserName = UserName,
                ScenarioDate = ScenarioDate);
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Warning - Unable to remove Scenario Equipment from preload ' +
                     'engine database table for UserName: ' + UserName + 
                     ', Scenario Date: ' + VARCHAR(ScenarioDate) +
                     '.  Please contact tech support so that the data can be ' +
                     'deleted manually. ';
          ELSE
             CALLPROC DDB_COMMIT;
          ENDIF;      
          RESUME;
       ENDIF;
    ENDFOR;
    CALLPROC DDB_COMMIT;
/*
** Now call the Preload Engine to build a list of moves for the connected
** equipment.
*/
    CurFrame.StatusText = 'Find preload moves for equipment list...';
    CurFrame.Flush();

    ScenarioMoves.Clear();
    CALLPROC PreloadEngine (CardTypeOfCard = CardTypeOfCard,
                           ScenarioDate = ScenarioDate,
                           Scenario = ScenarioType,
                           UserName = UserName,
                           PreloadJobs = ScenarioMoves);

    CurFrame.StatusText = 'Process scenario preload moves...';
    CurFrame.Flush();
/*
** Now we need to add to the ScenarioMoves and then add them to the NewMoves
** Array. Data we need to add includes:
**   - Scenario, DeskName, Step, Line, Substation
** Data we need to check:
**   - If SLC, is equipment under control of another switching item?  Prompt
**     to transfer it here.
**   - Is it a duplicate move?  If so, and it is for an SLC De-En Breaker, then
**     we ignore, otherwise we prompt.
**   - Is the equip and ACLineSeg? If so, we prompt to select the substation
**     which is important if we have to do any subsequent tracing.
*/
    i = ScenarioMoves.LastRow();
    WHILE i >= 1 DO
/*
** First look for duplicate, if open switching item, only look on current
** sw item.  If active switching item, look at all active, excluding open.
*/
       j = 0;
       IF CardStatus = Card$Open THEN
          REPEATED 
          SELECT   :j = COUNT(*)
          FROM     SOA_Job J,
                   SOA_JobControl JC
          WHERE    JC.Card = :Card AND
                   JC.SwitchingItem = :CardSwitchingItem AND
                   JC.Job = J.Job AND
                   J.Equip = :ScenarioMoves[i].Equip AND
                   J.JobClass = :ScenarioMoves[i].JobClass AND
                   J.Status IN ('','NIS') AND
                  (J.TOComplete IS NULL OR J.RSComplete IS NULL);
       ELSE
          REPEATED 
          SELECT   :j = COUNT(*)
          FROM     SOA_Job J,
                   SOA_JobControl JC
          WHERE    JC.Card = :Card AND
                   JC.Job = J.Job AND
                   J.SwItemStatus IN (:Card$Active) AND
                   J.Equip = :ScenarioMoves[i].Equip AND
                   J.JobClass = :ScenarioMoves[i].JobClass AND
                   J.Status IN ('','NIS') AND
                  (J.TOComplete IS NULL OR J.RSComplete IS NULL);
       ENDIF;

       IF j = 0 AND ScenarioMoves[i].MultiplePreload = 1 THEN
/*
**  Insert duplicate if none exist.
*/       
          ScenarioMoves.InsertRow (RowNumber = i+1, RowObject = ScenarioMoves[i].Duplicate());

       ELSEIF j = 1 AND ScenarioMoves[i].MultiplePreload = 1 THEN
/*
**  Insert move with no prompt.  
*/       
       ELSEIF j > 1 AND ScenarioMoves[i].MultiplePreload = 1 THEN   
/*
**  Don't insert anymore than two.
*/
               ScenarioMoves.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;                                    
           
       ELSEIF j > 0 THEN   
       
         IF CurrentApplication = Application$TFMS THEN

            j = 0;
            SELECT :j = ET.Type
            FROM   Udb_ExtendedType ET
            WHERE  ET.SuperType = :Type$LoadBreaking AND
                   ET.Type = :ScenarioMoves[i].EquipClass;
 
            IF j = 0 THEN
               IF CurFrame.ConfirmPopup (MessageText = 
                  'A move in the scenario is a duplicate for one already ' +
                  'on the card. ' + ScenarioMoves[i].EquipClassName + '  ' +
                  ScenarioMoves[i].EquipName + ' "' + ScenarioMoves[i].TOMove +
                  '"   Click OK to insert a duplicate or CANCEL to ignore ' +
                  'it.') = PU_CANCEL THEN
                 
                     ScenarioMoves.RemoveRow (rownumber = i);
                     i = i - 1;
                     CONTINUE;                                    
               ENDIF;
            ELSE 
               /*Duplicate for a de-en breaker, we can ignore it.*/
               ScenarioMoves.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;                                    
            ENDIF;
         ELSE
               IF CurFrame.ConfirmPopup (MessageText = 
                  'A move in the scenario is a duplicate for one already ' +
                  'on the card. ' + ScenarioMoves[i].EquipClassName + '  ' +
                  ScenarioMoves[i].EquipName + ' "' + ScenarioMoves[i].TOMove +
                  '"   Click OK to insert a duplicate or CANCEL to ignore ' +
                  'it.') = PU_CANCEL THEN
                 
                     ScenarioMoves.RemoveRow (rownumber = i);
                     i = i - 1;
                     CONTINUE;                                    
               ENDIF;
         
         ENDIF;
       ENDIF;
/*
** Look for another sw item and who has control.
*/
       IF CardStatus <> Card$Open AND CurrentApplication = Application$SLC THEN         

         OtherSwitchingItem = 0;
         OtherSWName = '';
         OtherJobControlCard = 0;

         REPEATED
         SELECT :OtherSwitchingItem = J2.Job,
                :OtherSWName = J2.TOMove,
                :OtherJobControlCard = J1.ControlCard  /*might be a TFMS card*/
         FROM   SOA_Job J1,
                SOA_Job J2,
                SOA_JobControl JC
         WHERE  J1.Equip = :ScenarioMoves[i].Equip 
         AND    J1.Status IN ('',:JobStatus$NIS) 
         AND    J1.MoveCategory = :MoveCategory$Normal                         
         AND   (J1.TOComplete IS NULL OR J1.RSComplete IS NULL)
         AND    J1.Job = JC.Job 
         AND    JC.Card = :Card 
         AND    JC.SwitchingItem <> :CardSwitchingItem 
         AND    JC.SwitchingItem = J2.Job
         AND    J2.SWItemStatus = :Card$Active;
    
         IF OtherSwitchingItem <> 0 THEN  /*equip appears in other sw item*/   

            OutOfControl = 0;
            SELECT :OutofControl = COUNT(*)
            FROM   SOA_CardControl
            WHERE  Card = :Card AND
                   SwitchingItem = :OtherSwitchingItem AND
                   AccessType = 1;

            IF OutofControl = 0 THEN  /*no one has control we can try to xfer*/ 

               IF OtherJobControlCard = Card THEN  /*current card only*/

                  IF CurFrame.ConfirmPopUp (messagetext = 
                      'Equipment ' + ScenarioMoves[i].EquipClassName + '  ' +
                      ScenarioMoves[i].EquipName + ' has ' +
                      'moves in another switching item: ' + OtherSWName +
                      HC_NEWLINE + 'Do you want to transfer the equipment ' +
                      '(and the ' +
                      'equipment moves) to your current switching item?') 
                           = PU_OK THEN

                     RetCode = CALLPROC TransferSWItemEquip (
                          Card = Card,
                          NewSwitchingItem = CardSwitchingItem,
                          OldSwitchingItem = OtherSwitchingItem,
                          Equip = ScenarioMoves[i].Equip);
                  
                     IF RetCode = PU_CANCEL THEN
                        CALLPROC DDB_ROLLBACK;
                        MESSAGE 'Frame:NewMoves; ERROR: Unable to transfer ' +
                                'equipment control to the current switching ' +
                                'item.  Related move "' +
                                ScenarioMoves[i].TOMove + '"' +
                                ' will not be included in ' +
                                'this scenario.';
                        ScenarioMoves.RemoveRow (rownumber = i);
                        i = i - 1;
                        CONTINUE;                                    
                     ENDIF;
                     CALLPROC DDB_COMMIT;
                  ELSE
                     MESSAGE 'Move "' + ScenarioMoves[i].TOMove + '" ' +
                              ' will not be included in ' +
                             'this scenario.';
                     ScenarioMoves.RemoveRow (rownumber = i);
                     i = i - 1;
                     CONTINUE;  
                  ENDIF;

               ELSE   /*Equipment is probably in a shadow item*/ 
/*
** Check if something has control of other card - most likely a TFMS card.
** If so, don't allow transfer, otherwise do.
*/                                
                  OutOfControl = 0;
                  SELECT :OutofControl = COUNT(*)
                  FROM   SOA_CardControl
                  WHERE  Card = :OtherJobControlCard AND
                         AccessType = 1;

                  IF OutOfControl = 0 THEN

                     IF CurFrame.ConfirmPopUp (messagetext = 
                      'Equipment ' + ScenarioMoves[i].EquipClassName + '  ' +
                      ScenarioMoves[i].EquipName + ' has ' +
                      'moves in another switching item: ' + OtherSWName +
                      HC_NEWLINE + 'Do you want to transfer the equipment ' +
                      '(and the ' +
                      'equipment moves) to your current switching item?') 
                           = PU_OK THEN

                        RetCode = CALLPROC TransferSWItemEquip (
                          Card = Card,
                          NewSwitchingItem = CardSwitchingItem,
                          OldSwitchingItem = OtherSwitchingItem,
                          Equip = ScenarioMoves[i].Equip);
                  
                        IF RetCode = PU_CANCEL THEN
                           CALLPROC DDB_ROLLBACK;
                          MESSAGE 'Frame:NewMoves; ERROR: Unable to transfer ' +
                                'equipment control to the current switching ' +
                                'item.  Move "' +
                                ScenarioMoves[i].TOMove + '"' +
                                ' will not be included in ' +
                                'this scenario.';
                           ScenarioMoves.RemoveRow (rownumber = i);
                           i = i - 1;
                           CONTINUE;                                    
                        ENDIF;
                        CALLPROC DDB_COMMIT;

                     ELSE
                        MESSAGE 'Move "' + ScenarioMoves[i].TOMove + '" ' +
                              ' will not be included in ' +
                              'this scenario.';
                        ScenarioMoves.RemoveRow (rownumber = i);
                        i = i - 1;
                        CONTINUE;
                     ENDIF;  
              
                  ELSE   /* TFMS has control, don't allow insert. */     

                     MESSAGE 'Equipment ' + 
                       ScenarioMoves[i].EquipClassName + '  ' +
                       ScenarioMoves[i].EquipName + 
                       ' has moves on another card. ' +
                       HC_NEWLINE + 'The other card ' +
                       'is currently locked by another user. ' +
                       'You therefore may not insert ' +
                       'moves for the equipment in this sw item. ' + 
                       'Move "' + ScenarioMoves[i].TOMove + '" ' +
                       ' will not be included in ' +
                       'this scenario.';
                     ScenarioMoves.RemoveRow (rownumber = i);
                     i = i - 1;
                     CONTINUE;                                    

                  ENDIF;

               ENDIF; 

            ELSE  /* Another Sw item has control */
   
               MESSAGE 'Equipment ' + ScenarioMoves[i].EquipClassName + '  ' +
                       ScenarioMoves[i].EquipName + 
                       ' has moves in another switching item: ' +
                       OtherSWName + HC_NEWLINE + 'The other switching item ' +
                       'is currently locked by another user. ' +
                       'You therefore may not insert ' +
                       'moves for the equipment in this sw item. ' + 
                       'Move "' + ScenarioMoves[i].TOMove + '" ' +
                       ' will not be included in ' +
                       'this scenario.';
               ScenarioMoves.RemoveRow (rownumber = i);
               i = i - 1;
               CONTINUE;                                    

            ENDIF;

         ENDIF;
       ENDIF;
/*
**  Determine if we need to select a substation for an AC Line seg 
**  03/31/17 Not needed anymore since ACLineSegment is only in one substation.
*           
       EquipBaseType = FALSE;
       SELECT :EquipBaseType = :TRUE
       FROM Udb_ExtendedType
       WHERE Type = :ScenarioMoves[i].EquipClass AND
             SuperType = :Type$ACLineSegment;   
/*
**  Select Substation for ACLineSegment
*
       IF EquipBaseType = TRUE AND CurrentApplication = Application$TFMS THEN
          Retcode = CALLFRAME ACLSubselection(
                           CardObject = ScenarioMoves[i].Equip, 
                           ACLineSeg = ScenarioMoves[i].EquipName,
                           ACLineSegMove = ScenarioMoves[i].TOMove,
                           ACLSubstation = byref(ACLSubStation),
                           ACLSubstationName = byref(ACLSubstationName));
          IF RetCode = PU_CANCEL THEN          
             MESSAGE 'Move "' + ScenarioMoves[i].TOMove + '" ' +
                     ' will not be included in ' +
                     'this scenario.';
             ScenarioMoves.RemoveRow (rownumber = i);
             i = i - 1;
             CONTINUE;                                    
          ENDIF;
          ScenarioMoves[i].Response = ScenarioMoves[i].EquipName;  
          ScenarioMoves[i].Substation = ACLSubstation;
          ScenarioMoves[i].SubstationName = ACLSubstationName;
       ENDIF;
*/
       ScenarioMoves[i].Response = ScenarioMoves[i].EquipName; /*Line Name*/
/*
MESSAGE 'THIS AREA STILL NEEDS WORK (next two statements)';

       ScenarioMoves[i].Substation = ACLSubstation;
       ScenarioMoves[i].SubstationName = ACLSubstationName;
****************************************************************/
/*
** Add data that is still missing.
*/
       ScenarioMoves[i].Scenario = ScenarioType;
       SELECT :ScenarioMoves[i].StepPairName = SQUEEZE(Name)
       FROM   FMS_StepPair
       WHERE  TypeOfCard = :CardTypeOfCard AND
              StepPair = :ScenarioMoves[i].StepPair;

       IF ScenarioMoves[i].Substation = 0 OR 
            ScenarioMoves[i].SubstationName = '' THEN

          SELECT :ScenarioMoves[i].Substation = PrimaryGrouping,
                 :ScenarioMoves[i].SubstationName = PrimaryGroupingName
          FROM   Udb_Object
          WHERE  Object = :ScenarioMoves[i].Equip;
       ENDIF;     
 
       REPEATED
       SELECT :ScenarioMoves[i].DeskName = O.Name
       FROM Udb_Object O,
            Udb_Grouping G,
            Udb_Grouping GG
       WHERE O.Object = G.Grouping AND
             G.GroupingType = :Type$OperatorDesk AND
             G.Member = GG.Grouping AND
             GG.Member = :ScenarioMoves[i].Substation AND
             GG.Relationship = :Interaction$Memberof;
       i = i - 1;
    ENDWHILE;

    IF ScenarioMoves.LastRow() = 0 THEN
       MESSAGE 'No moves are being added by this scenario.';
       Scenario = 0;
       RESUME;
    ENDIF;

    j = NewMoves.LastRow();
    FOR i = 1 TO ScenarioMoves.LastRow() DO
       j = j + 1;
       NewMoves.InsertRow (rownumber = j, rowobject = ScenarioMoves[i]);
    ENDFOR;
/*
** For Bus Section Scenario, look for single Spare Bank Breaker.
*/
    IF ScenarioType = Scenario$BusSectionWork THEN
  
       SpareEquip.Clear();
       FOR i = 1 TO ScenarioMoves.LastRow() DO
          SpareEquip[i].Equip = ScenarioMoves[i].Equip;
       ENDFOR;

       SpareJob = Job.Create();
       SpareJob = SpareJob.SpareBankBkrPreload (
            Equip = SpareEquip,
            Substation = ScenarioMoves[1].Substation,
            SwitchingItem = CardSwitchingItem,
            TypeOfCard = CardTypeOfCard);
   
       IF SpareJob IS NOT NULL THEN
          SpareJob.Card = Card;
          NewMoves.InsertRow (rownumber = j+1, rowobject = SpareJob);
       ENDIF;
    ENDIF;
     
    FIELD(Scenario).CurBias = FB_VISIBLE;
    CurFrame.StatusText = 'Click OK to insert moves or add individual equipment/moves';
END;

ON CLICK TypeExclusion =
BEGIN
   IF TypeExclusion = FALSE THEN
      IF FullEquipList.LastRow = 0 THEN
         CALLPROC LoadEquipData(PassedInList = ByRef(FullEquipList),
                           Exclusion = TypeExclusion );
      ENDIF;
      SelectEquip = FullEquipList.Duplicate();
   ELSE
      IF FilteredEquipList.LastRow = 0 THEN
         CALLPROC LoadEquipData(PassedInList = ByRef(FilteredEquipList),
                           Exclusion = TypeExclusion );
      ENDIF;
      SelectEquip = FilteredEquipList.Duplicate();
   ENDIF;
END;

ON SetValue Object_Ref =
BEGIN
/**
 **  On selection of a Substation or T Line
 **/
    Object = FIELD(Object_Ref).CurEnumValue;
    ObjectName = FIELD(Object_Ref).CurEnumText;

    FullEquipList.Clear();
    FilteredEquipList.Clear();
    IF TypeExclusion = FALSE THEN
       CALLPROC LoadEquipData(PassedInList = ByRef(FullEquipList),
                             Exclusion = TypeExclusion );
    ELSE
       CALLPROC LoadEquipData(PassedInList = ByRef(FilteredEquipList),
                             Exclusion = TypeExclusion );
    ENDIF;
    IF LockMove = TRUE THEN
       LockMove = FALSE;
       FIELD(LockMove).CurBias = FB_INVISIBLE;
    ENDIF;

    CurFrame.StatusText = 'Select Equipment and Moves OR use a Scenario.'; 
    Scenario = 1;
END;

ON CLICK Find_Btn = 
BEGIN
/*  
** Find specific equipment.
** Refocus on the equipment name field 
*/
/*
**  Reset selection fields and 
**  move first found equipment to top of table
*/
    Selected.Equip = 0;
    Selected.SubstationName = '';
    Selected.Substation = 0;
    Selected.PrintId = '';
    Selected.EquipClassName = '';
    Selected.ObjectDescription = '';
    CurFrame.InputFocusField = FIELD(Selected.EquipName);
    FIELD(Selected.ObjectDescription).Curbias = FB_VISIBLE;
    FIELD(Selected.ObjectDescription).BgColor = CC_PALE_CYAN;
    FIELD(Selected.EquipName).Curbias = FB_CHANGEABLE;
    FIELD(Selected.EquipName).BgColor = CC_PALE_CYAN;
    FIELD(SpecialNote).TextValue = '';
    FIELD(SpecialNote).CurBias = FB_INVISIBLE;


    IF FIELD(find_btn).TextLabel = 'Reset' THEN
       IF FindEquip <> '' THEN
          Selected.EquipName = FindEquip;
       ELSE
          Selected.EquipName = '';
       ENDIF;
       FIELD(find_btn).TextLabel = 'Find';
       RESUME;
    ENDIF;
    
    IF Selected.EquipName = '' THEN
        Message 'Please enter the equipment name to find';
        FindEquip = '';
        RESUME;
    ENDIF;
    FindEquip = Selected.EquipName;
/*
** Start Find from currently displayed top row
*/
    IF EquipFound > 0 THEN
       FindRow = EquipFound;
    ELSE
       FindRow = FIELD(SelectEquip).TopRow;
    ENDIF;
    IF FindRow = 0 THEN
       MESSAGE 'Nothing to find.';
       RESUME;
    ENDIF;
 
    EquipFound = FALSE;
    i = FindRow + 1;
    Match = '%' + UpperCase(FindEquip) + '%';
    WHILE i <= SelectEquip.LastRow() DO
        IF UpperCase(SelectEquip[i].EquipName) like Match THEN
            EquipFound = i;
            Endloop;
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
** If not found, continue search from Top if we didn't already
*/
    IF EquipFound = FALSE THEN
       IF FindRow = 1 THEN
          FIELD(SpecialNote).CurBias = FB_INVISIBLE;
          Message 'Equipment not found';
          RESUME;
       ELSE
          i = 1;
          WHILE i <= FindRow DO
             IF UpperCase(SelectEquip[i].EquipName) like Match THEN
                EquipFound = i;
                Endloop;
             ENDIF;
             i = i + 1;
          ENDWHILE;
       ENDIF;
    ENDIF;

       IF EquipFound <> FALSE THEN 
          Field(SelectEquip).ActiveRow = EquipFound;
          FIELD(SpecialNote).TextValue = 'Equipment match found...';
          FIELD(SpecialNote).CurBias = FB_VISIBLE;
       ELSE        
          FIELD(SpecialNote).CurBias = FB_INVISIBLE;
          Message 'Equipment not found';
          RESUME;
       ENDIF;
END;


ON ChildEntry SelectEquip,
ON UserEvent 'Select_Equip' =
BEGIN
    IF CurFrame.ReasonCode = RC_MOUSECLICK THEN 
       FIELD(SpecialNote).CurBias = FB_INVISIBLE;
       EquipFound = FALSE;
    ENDIF;
/*
** Equipment has been selected.  Load moves for that equipment class.  
** If SLC, check to make sure this equipment does not have moves in another 
** switching item.  If it does, allow change control of equipment to this
** switching item (if other item is a shadow).
*/
    EquipStatus = '';
    EquipConnected = 0;
    Selected = SelectEquip[].Duplicate();

    IF Selected.Equip = 0 THEN

       IF LockMove = TRUE THEN
          Message 'May only select actual equip when move is locked.';
          RESUME;
       ENDIF; 

       IF CurrentApplication <> Application$SDS THEN
          FIELD(SpecialNote).TextValue = 
             'You may customize Equipment and Supplies fields...';
       ELSE
          FIELD(SpecialNote).TextValue = 
             'Please enter valve name in Equipment field...';
       ENDIF;
       FIELD(SpecialNote).CurBias = FB_VISIBLE; 
       FIELD(Selected.ObjectDescription).Curbias = FB_CHANGEABLE;
       FIELD(Selected.ObjectDescription).BgColor = CC_PALE_BLUE;
       FIELD(Selected.EquipName).Curbias = FB_CHANGEABLE;
       FIELD(Selected.EquipName).BgColor = CC_PALE_BLUE;
       CurFrame.InputFocusField = FIELD(Selected.EquipName);

    ELSE
       IF FIELD(SpecialNote).TextValue <> 'Equipment match found...' THEN
          FIELD(SpecialNote).CurBias = FB_INVISIBLE;
       ENDIF; 
       FIELD(Selected.ObjectDescription).Curbias = FB_VISIBLE;
       FIELD(Selected.ObjectDescription).BgColor = CC_PALE_CYAN;
       FIELD(Selected.EquipName).Curbias = FB_VISIBLE;
       FIELD(Selected.EquipName).BgColor = CC_PALE_CYAN;
/*
** Check substation field is not holding a line. If so, clear it.
*/
       i = 0;
       SELECT :i = Type
       FROM   Udb_Object 
       WHERE  Object = :Selected.Substation AND 
              Type = :Type$Line;
       IF i > 0 THEN
          Selected.Substation = 0;
          Selected.SubstationName = '';
       ENDIF;          
/*
** Connectivity Check
*/
       IF CurrentApplication = Application$SLC OR 
          CurrentApplication = Application$TFMS THEN

          SELECT :EquipConnected = COUNT(*)
          FROM   DSO_Connection
          WHERE  FromObj = :Selected.Equip OR
                 ToObj = :Selected.Equip;
          IF EquipConnected = 0 THEN
             EquipStatus = JobStatus$NIS;
          ENDIF;
       ENDIF;
/*
** Make sure selected equipment does not appear in another switching item.
** If it does not, continue with program.
** If it does, prompt user with automatic transfer query if transfer is 
** allowable.  If transfer is not allowable, do not continue process.
** 
** Allow transfer of the equip and moves to the current sw item if and 
** only if:
**     1) the other switching item is not controlled by someone else 
** AND 2) the equipment (moves) is controlled by the current card. 
*/
       IF CardStatus <> Card$Open AND CurrentApplication = Application$SLC THEN         

          OtherSwitchingItem = 0;
          OtherSWName = '';
          OtherJobControlCard = 0;
          
          REPEATED
          SELECT :OtherSwitchingItem = J2.Job,
                 :OtherSWName = J2.TOMove,
                 :OtherJobControlCard = J1.ControlCard
          FROM   SOA_Job J1,
                 SOA_Job J2,
                 SOA_JobControl JC
          WHERE  J1.Equip = :Selected.Equip 
          AND    J1.Status IN ('',:JobStatus$NIS) 
          AND    J1.MoveCategory = :MoveCategory$Normal                         
          AND   (J1.TOComplete IS NULL OR J1.RSComplete IS NULL)
          AND    J1.Job = JC.Job 
          AND    JC.Card = :Card 
          AND    JC.SwitchingItem <> :CardSwitchingItem 
          AND    JC.SwitchingItem = J2.Job
          AND    J2.SWItemStatus = :Card$Active;
    
          IF OtherSwitchingItem <> 0 THEN 
          
             OutOfControl = 0;
             REPEATED
             SELECT :OutofControl = COUNT(*)
             FROM   SOA_CardControl
             WHERE  Card = :Card AND
                    SwitchingItem = :OtherSwitchingItem AND
                    AccessType = 1;

             IF OutofControl = 0 AND OtherJobControlCard = Card THEN
             
                IF CurFrame.ConfirmPopUp (messagetext = 'This equipment has ' +
                      'moves in another switching item: ' + OtherSWName +
                      HC_NEWLINE + 'Do you want to transfer the equipment ' +
                      '(and the ' +
                      'equipment moves) to your current switching item?') 
                       = PU_OK THEN
             
                   RetCode = CALLPROC TransferSWItemEquip (
                           Card = Card,
                           NewSwitchingItem = CardSwitchingItem,
                           OldSwitchingItem = OtherSwitchingItem,
                           Equip = Selected.Equip);
                   
                   IF RetCode = PU_CANCEL THEN
                      CALLPROC DDB_ROLLBACK;
                      MESSAGE 'Frame:NewMoves; ERROR: Unable to transfer ' +
                              'equipment control to the current switching item.';
                      Selected.Equip = 0;
                      Selected.SubstationName = '';
                      Selected.Substation = 0;
                      Selected.PrintId = '';
                      Selected.EquipClassName = '';
                      Selected.EquipName = '';
                      Selected.ObjectDescription = '';
                      RESUME;                                    
                   ENDIF;
                   CALLPROC DDB_COMMIT;
             
                ELSE
                   Selected.Equip = 0;
                   Selected.SubstationName = '';
                   Selected.Substation = 0;
                   Selected.PrintId = '';
                   Selected.EquipClassName = '';
                   Selected.EquipName = '';
                   Selected.ObjectDescription = '';
                   RESUME;
                ENDIF; 
             
             ELSE
             
                MESSAGE 'This equipment is controlled by Switching Item: ' +
                        OtherSWName + HC_NEWLINE + 'You will need to transfer ' +
                        'control of the equipment to this item to insert new ' +
                        'moves here.';
                Selected.SubstationName = '';
                Selected.Substation = 0;
                Selected.PrintId = '';
                Selected.EquipClassName = '';
                Selected.EquipName = '';
                Selected.ObjectDescription = '';
                RESUME; 
             
             ENDIF;

          ENDIF;
          
       ELSEIF CardStatus <> Card$Open AND CurrentApplication = Application$TFMS THEN
          /* 
          ** When inserting AK moves, check if all AK moves on the card are RS completed. 
          ** - If they are all RS completed, the DO MUST create a transfer card if the card is already Cut In; 
          ** - If they are all RS completed, the DO SHOULD create a transfer card if the card is NOT cut in
          */
          IF Selected.Substation = 144060 OR Selected.Substation = 144231 THEN   // AK2 or AK3
          
             RetCode = NewMoves.Find(AttributeName = 'Substation', Value = Selected.Substation);
             IF RetCode = ER_ROWNOTFOUND THEN
                m = 0;
                SELECT :m = Count(*)
                FROM   SOA_JobControl JC,
                       SOA_Job J
                WHERE  JC.Card = :Card AND
                       JC.Job = J.Job AND
                       J.Substation = :Selected.Substation AND
                       J.Status = '' AND
                       J.MoveCategory = :MoveCategory$Normal AND
                       J.TOIssued IS NOT NULL AND
                       J.RSComplete IS NULL;
               IF m = 0 THEN        
                  /*
                  ** we are here either because there are no AK moves on the card (we will continue) or 
                  ** because all AK moves are Restore Complete (prompt DO to create a transfer card).
                  */
                  SELECT :m = Count(*)
                  FROM   SOA_JobControl JC,
                         SOA_Job J
                  WHERE  JC.Card = :Card AND
                         JC.Job = J.Job AND
                         J.Substation = :Selected.Substation AND
                         J.Status  IN ('', 'Hid') AND
                         J.MoveCategory = :MoveCategory$Normal AND
                         J.TOComplete IS NOT NULL AND
                         J.RSComplete IS NOT NULL;
                  IF m > 0 THEN
                     /* all AK moves are RS completed 
                     */
                     k = 0;
                     SELECT :k = 1
                     FROM   SOA_Card
                     WHERE  Card = :Card AND
                            CutIn IS NOT NULL;
                     IF k = 1 THEN
                        MESSAGE 'All moves at Arthur Kill have been restored. You must create a transfer card.';
                        RETURN PU_CANCEL;
                     ELSE
                        MESSAGE 'All moves at Arthur Kill have been restored. You should create a transfer card.';
                     ENDIF;
                  ENDIF;                  
               ENDIF;
             ENDIF;
          ENDIF;
       ENDIF;
    ENDIF;

    IF LockMove = TRUE THEN
       CurFrame.SendUserEvent (EventName = 'insertmove');
    ELSE
       IF CurrentApplication = Application$SDS THEN
          AllOrEquip = 0;
       ELSE
          AllOrEquip = 1;
       ENDIF;
       FIELD(AllOrEquip).CurBias = FB_CHANGEABLE;

       CurFrame.StatusText = 'Select Equipment and Moves OR use a Scenario.'; 
       CurFrame.SendUserEvent (EventName = 'load_moves');
       FIELD(find_btn).TextLabel = 'Reset'; 
    ENDIF;
    
END;

ON SETVALUE AllorEquip =
BEGIN
   IF Selected IS NULL THEN
      RESUME;
   ENDIF;
   CurFrame.SendUserEvent (EventName = 'load_moves');
END;


/**
 **  load moves/jobclasses for selected equipment type
 **  locknumber field in SLC_Job userclass will be used to hold the 
 **  the step heading temporarily on this screen.
 **/
ON UserEvent 'load_moves' =
BEGIN
   
    MoveSelected = FALSE;
    IF FIELD(Repeat_Btn).CurBias <> FB_INVISIBLE THEN
       FIELD(Repeat_Btn).CurBias = FB_INVISIBLE;
    ENDIF;
    IF FIELD(LockMove).CurBias <> FB_INVISIBLE THEN
       FIELD(LockMove).CurBias = FB_INVISIBLE;
    ENDIF;
    LockMove = FALSE;
    SelectMove.Clear();     /* Clear out storage */
    StepHeading = '';
/**
 **  Select the moveequipclassname for the moveequipclass within
 **  the select begin end to speed things up performance wise.
 **  (This will keep us from having to do a third join in the union.)
 **/
  EquipMoveFound = FALSE;
  IF AllorEquip = 0 THEN
    i = 1;
    REPEATED
    SELECT  :SelectMove[i].JobClass = 0,
            :SelectMove[i].TOMove = SP.Name,
            :SelectMove[i].MoveType = '',
            :SelectMove[i].RSMove = SP.Name,
            :SelectMove[i].TOMoveRules = 0,
            :SelectMove[i].RSMoveRules = 0,
            :SelectMove[i].StepPair = SP.StepPair,
            :SelectMove[i].MoveEquipClass = 0,
            :SelectMove[i].Seq = 0
    FROM    FMS_StepPair SP
    WHERE   SP.TypeOfCard = :CardTypeOfCard
    UNION
    SELECT  J.JobClass,
            J.TOMove,
            J.MoveType,
            J.RSMove,
            J.TOMoveRules,
            J.RSMoveRules,
            JCC.StepPair,
            JCC.EquipClass,
            JCC.Seq
    FROM    FMS_JobClass J, 
            FMS_JobClassControl JCC
    WHERE   J.JobClass = JCC.JobClass
    AND     JCC.TypeofCard = :CardTypeOfCard
    AND     JCC.EquipClass IN (
                    SELECT SuperType
                    FROM   Udb_ExtendedType 
                    WHERE  Type =  :Selected.EquipClass) 
    ORDER BY StepPair, Seq
    BEGIN
        IF (SelectMove[i].MoveEquipClass = 0) THEN
            SelectMove[i].MoveEquipClassName = '';
        ELSE
            SELECT  :SelectMove[i].MoveEquipClassName = Name
            FROM    Udb_Type
            WHERE   Type = :SelectMove[i].MoveEquipClass;
        ENDIF;

        IF SelectMove[i].TOMoveRules = MoveRule$None THEN
           SelectMove[i].TOMove = '***NO TAKEOUT***';
        ENDIF;
        IF SelectMove[i].RSMoveRules = MoveRule$None THEN
           SelectMove[i].RSMove = '***NO RESTORE***';
        ENDIF;

        IF SelectMove[i].JobClass = 0 THEN
           FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
           FIELD(SelectMove[i].RSMove).FgColor = CC_LIGHT_BLUE;
           StepHeading = SQUEEZE(SelectMove[i].TOMove); 
        ELSE
           FIELD(SelectMove[i].RSMove).FGColor = CC_LIGHT_GRAY;
        ENDIF;
        SelectMove[i].StepPairName = StepHeading;
        i = i + 1;
    END;
  ELSE
    i = 1;
    REPEATED
    SELECT  :SelectMove[i].JobClass = 0,
            :SelectMove[i].TOMove = SP.Name,
            :SelectMove[i].Seq = 0,
            :SelectMove[i].MoveType = '',
            :SelectMove[i].RSMove = SP.Name,
            :SelectMove[i].TOMoveRules = 0,
            :SelectMove[i].RSMoveRules = 0,
            :SelectMove[i].StepPair = SP.StepPair,
            :SelectMove[i].MoveEquipClass = 0
    FROM    FMS_StepPair SP
    WHERE   SP.TypeOfCard = :CardTypeOfCard
    UNION
    SELECT  J.JobClass,
            J.TOMove,
            JC.Seq,
            J.MoveType,
            J.RSMove,
            J.TOMoveRules,
            J.RSMoveRules,
            JC.StepPair,
            JC.EquipClass
    FROM    FMS_JobClass J, 
            FMS_JobClassControl JC
    WHERE   J.JobClass = JC.JobClass
    AND     JC.TypeofCard = :CardTypeOfCard
    AND     JC.EquipClass = :Selected.EquipClass 
    ORDER BY StepPair, Seq
    BEGIN
        IF (SelectMove[i].MoveEquipClass = 0) THEN
            SelectMove[i].MoveEquipClassName = '';
        ELSE
            SELECT  :SelectMove[i].MoveEquipClassName = Name
            FROM    Udb_Type
            WHERE   Type = :SelectMove[i].MoveEquipClass;
        ENDIF;

        IF SelectMove[i].TOMoveRules = MoveRule$None THEN
           SelectMove[i].TOMove = '***NO TAKEOUT***';
        ENDIF;
        IF SelectMove[i].RSMoveRules = MoveRule$None THEN
           SelectMove[i].RSMove = '***NO RESTORE***';
        ENDIF;

        IF SelectMove[i].JobClass = 0 THEN
           FIELD(SelectMove[i].TOMove).FgColor = CC_BLUE;
           FIELD(SelectMove[i].RSMove).FgColor = CC_LIGHT_BLUE;
           StepHeading = SQUEEZE(SelectMove[i].TOMove); 
        ELSE
           FIELD(SelectMove[i].RSMove).FGColor = CC_LIGHT_GRAY;
        ENDIF;
        SelectMove[i].StepPairName = StepHeading;
/*
**  When non-Step Heading move is found, turn EquipMoveFound flag on.
*/
        IF SelectMove[i].JobClass <> 0 AND EquipMoveFound = FALSE THEN
           EquipMoveFound = TRUE;
        ENDIF;
        i = i + 1;
    END;
    IF EquipMoveFound = FALSE THEN
       AllOrEquip = 0;
       FIELD(AllOrEquip).CurBias = FB_INVISIBLE;
       CurFrame.SendUserEvent (EventName = 'load_moves');
    ENDIF;
  ENDIF;
  CALLPROC DDB_ROLLBACK;
END;

/**
 **  Handle a job class selection from the list
 **/
ON ChildEntry SelectMove =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;
/*
**  Determine if High Pot Test move is selected
*/
    i = Field(SelectMove).CurRow;
           
    EquipBaseType = FALSE;
    SELECT :EquipBaseType = :TRUE
    FROM Udb_ExtendedType
    WHERE Type = :Selected.EquipClass AND
          SuperType = :Type$ACLineSegment;   
/*
**  Select Substation for ACLineSegment
*/
    IF EquipBaseType = TRUE AND CurrentApplication = Application$TFMS THEN
          ACLSubstation = Selected.Substation;
          ACLSubstationName = Selected.SubstationName;
          Retcode = CALLFRAME ACLSubselection(
                           CardObject = Selected.Equip, 
                           ACLineSeg = Selected.EquipName,
                           ACLineSegMove = SelectMove[i].TOMove,
                           ACLSubstation = byref(ACLSubStation),
                           ACLSubstationName = byref(ACLSubstationName));
       IF RetCode = PU_CANCEL THEN          
          RESUME;
       ENDIF;
       Selected.Substation = ACLSubstation;
       Selected.SubstationName = ACLSubstationName;      
    ENDIF;

    IF LockMove = TRUE  THEN
       Message 'The move is locked. You may not change it.';
       RESUME;
    ENDIF;    
/**
 **  Insert appropriate moves into new move list.
 **/
    IF SelectMove[].JobClass <> 0 THEN

        SelectMove[].TOIssued = NULL;
        SelectMove[].TOOperator = NULL;
        SelectMove[].TOComplete = NULL;
        SelectMove[].RSIssued = NULL;
        SelectMove[].RSOperator = NULL;
        SelectMove[].RSComplete = NULL;
        SelectMove[].GroundOn = NULL;
        SelectMove[].DeskName = '';

        LockedMove = SelectMove[].Duplicate();
        SelectedMoveEquipClass = SelectMove[].MoveEquipClass;
        MoveSelected = TRUE;
/* 
**  set on label to blank so repeat button isn't put way to the right,
**  only do when necessary,  since changing label causes screen to flash
*/
        IF LockMove = FALSE                 AND 
           FIELD(LockMove).OnTextLabel <> '' THEN       
            FIELD(LockMove).OnTextLabel = ''; 
        ENDIF;
        FIELD(Repeat_Btn).CurBias = FB_CHANGEABLE;
        FIELD(LockMove).CurBias = FB_CHANGEABLE;
        CurFrame.SendUserEvent (EventName = 'insertmove');
    ENDIF;
END;



ON UserEvent 'insertmove' =
BEGIN
    IF Selected.EquipClassName = '' THEN
        RESUME;
    ENDIF;
/*
**  If the piece of equipment is a generic bus section,
**  force them to enter a name for the generic piece of equipment
*/  
    IF (Selected.EquipClass = TypeName$BusSect) THEN 
        IF (Length(Selected.EquipName) <= 0) THEN  
            MESSAGE 'You must enter a name for this piece of equipment.';
            Curframe.InputFocusField = FIELD(Selected.EquipName);
            RESUME;
        ENDIF;
    ENDIF;
/*
**  If the piece of equipment is a generic bus section,
**  force them to enter a name for the generic piece of equipment
*/  
    IF (Selected.EquipClass = Type$StreetValve OR 
          Selected.EquipClass = Type$StationValve) THEN 
        IF (Length(Selected.EquipName) <= 0) THEN  
            MESSAGE 'You must enter a name for this generic valve.';
            Curframe.InputFocusField = FIELD(Selected.EquipName);
            RESUME;
        ENDIF;
    ENDIF;

    LockedMove.Equip = Selected.Equip;
    LockedMove.EquipName = Selected.EquipName;
    LockedMove.EquipClass = Selected.EquipClass;
    LockedMove.Substation = Selected.Substation;
    LockedMove.SubstationName = Selected.SubstationName;
    IF Selected.EquipClassName = 'NONE' THEN
       LockedMove.EquipClassName = '';
    ELSE
       LockedMove.EquipClassName = Selected.EquipClassName;
    ENDIF;
/*
**  Set Desk to current desk for "none" WP moves not assigned to a substation
*/
    IF LockedMove.Substation = 0 THEN

        LockedMove.DeskName = Usergroup;
/*
**  Else determine the desk from the substation
*/
    ELSE
        LockedMove.DeskName = '';
        REPEATED
        SELECT :LockedMove.DeskName = O.Name
        FROM   Udb_Object O,
               Udb_Grouping G,
               Udb_Grouping GG
        WHERE  O.Object = G.Grouping AND
               O.Name = :UserGroup AND
               G.GroupingType = :Type$OperatorDesk AND
               G.Member = GG.Grouping AND
               GG.Member = :LockedMove.Substation AND
               GG.Relationship = :Interaction$Memberof;
 
    ENDIF;

    IF LockedMove.DeskName = '' AND CurrentApplication <> Application$SDS THEN
       MESSAGE 'Your desk is not authorized to insert moves for this ' +
               'substation/equipment.';
       RESUME;
    ENDIF;

    i = 1;
    WHILE i <= NewMoves.LastRow() DO
         
        IF LockedMove.StepPair = NewMoves[i].StepPair THEN 

            IF LockedMove.JobClass = NewMoves[i].JobClass AND
               LockedMove.MoveEquipClass = NewMoves[i].MoveEquipClass AND
               LockedMove.Substation = NewMoves[i].Substation AND
               LockedMove.Equip = NewMoves[i].Equip AND
               LockedMove.EquipName = NewMoves[i].EquipName THEN
               /*
               **   If they selected repeat button don't check for duplicate move
               */
               IF RepeatMove = FALSE THEN

                  IF CurFrame.ConfirmPopup (messagetext = 'Move appears in List ' +
                    'of New Moves already. Insert it another time?') = PU_CANCEL THEN
                     i = 0;
                     ENDLOOP;
                     RESUME;
                  ENDIF;
                  i = i + 1;
               ENDIF;
               ENDLOOP;
            ENDIF;
        ELSEIF NewMoves[i].StepPair > LockedMove.StepPair THEN
            ENDLOOP;
        ENDIF;

        i = i + 1;
    ENDWHILE;
/*
** Check for duplicates on the card.  THis check was formerly done at a later 
** time.  Done here to simplify subsequent insert processing.
** Only check active cards if move being inserted on an active card.
*/
    IF RepeatMove = FALSE AND CardStatus = Card$Active THEN

      j = 0;
      REPEATED 
      SELECT   :j = COUNT(*)
      FROM     SOA_Job J,
               SOA_JobControl JC
      WHERE    JC.Card = :Card AND
               JC.Job = J.Job AND
               J.SwItemStatus IN (:Card$Active,0) AND
               J.Equip = :LockedMove.Equip AND
               J.Substation = :LockedMove.Substation AND
               J.JobClass = :LockedMove.JobClass AND
               J.Status IN ('','NIS') AND
               (J.TOComplete IS NULL OR J.RSComplete IS NULL);
      IF j > 0 THEN
         IF CurFrame.ConfirmPopup (MessageText = 
            'This move already exists for this equipment on this card.  ' +
            'Click OK to insert a duplicate or CANCEL insert.') = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;

    ENDIF;

    IF i > 0 THEN
/*
**  Use response attribute since it is not being used in InsertJobs method.
*/
        IF CurrentApplication = Application$TFMS THEN
           LockedMove.Response = FIELD(Object_Ref).CurEnumText;
        ENDIF;

        NewMoves.InsertRow (RowNumber = i, RowObject = LockedMove.Duplicate());
        PreFixMoveText = '';
        SuffixMoveText = '';
        IF Selected.ObjectDescription <> '' THEN
            PreFixMoveText = Selected.ObjectDescription + ' ';
        ENDIF;
        IF Selected.EquipName <> '' THEN
            SuffixMoveText = ' - ' + Selected.EquipName;
        ENDIF;
        IF Selected.EquipName = '' AND Selected.EquipClass = Type$Main THEN
           SuffixMoveText = ' - ' + Selected.SubstationName;
        ENDIF; 
        NewMoves[i].Status = EquipStatus;
        IF LockedMove.TOMoveRules = MoveRule$None THEN
            NewMoves[i].TOMove = '***NO TAKEOUT***';
        ELSE
            NewMoves[i].TOMove = 
              SQUEEZE (PrefixMoveText + LockedMove.TOMove
                      + SuffixMoveText);
        ENDIF;
        IF LockedMove.RSMoveRules = MoveRule$None THEN
            NewMoves[i].RSMove = '***NO RESTORE***';
        ELSE
          NewMoves[i].RSMove = 
              SQUEEZE (PrefixMoveText + LockedMove.RsMove
                      + SuffixMoveText);
        ENDIF;
        IF CurrentApplication = Application$SDS AND LockedMove.StepPair = StepHeading$BoxedValve AND
            LockedMove.TOMoveRules = MoveRule$None AND LockedMove.RSMoveRules = MoveRule$None THEN
           NewMoves[i].TOMove = 
              SQUEEZE (PrefixMoveText + 'Boxed' +
                      + SuffixMoveText);             
           NewMoves[i].RSMove = NewMoves[i].TOMove;
        ENDIF;
    ENDIF;
    
    IF CurrentApplication = Application$SDS AND LockedMove.JobClass = JobClass$DrainageCheck THEN
       i = SelectMove.LastRow; 
       WHILE i > 0 DO 
          IF SelectMove[i].JobClass = JobClass$VerifyDrainage THEN
             LockedMove.JobClass = SelectMove[i].JobClass;
             LockedMove.TOMove = SelectMove[i].TOMove;
             LockedMove.Seq = SelectMove[i].Seq;
             LockedMove.MoveType = SelectMove[i].MoveType;
             LockedMove.RSMove = SelectMove[i].RSMove;
             LockedMove.TOMoveRules = SelectMove[i].TOMoveRules;
             LockedMove.RSMoveRules = SelectMove[i].RSMoveRules;
             LockedMove.StepPair = SelectMove[i].StepPair;
             LockedMove.MoveEquipClass = SelectMove[i].MoveEquipClass; 
             RepeatMove = TRUE;
             SELECT :LockedMove.StepPairName = SQUEEZE(Name)
             FROM   FMS_StepPair
             WHERE  TypeOfCard = :CardTypeOfCard AND
                    StepPair = :SelectMove[i].StepPair;
             CurFrame.SendUserEvent (EventName = 'insertmove');
             ENDLOOP;
          ENDIF;
          i = i - 1;
       ENDWHILE;
    ENDIF;

    CurFrame.StatusText = 'Click okay to insert moves or select more equipment/moves.';
END;


/*
**  Add duplicate of previous move which will bypass warning messages
*/
ON CLICK Repeat_Btn =
BEGIN
    RepeatMove = TRUE;
    CurFrame.SendUserEvent (EventName = 'insertmove');
END;
 
/**
 **  Lock Move when toggled
 **/
ON CLICK LockMove =
BEGIN

    IF MoveSelected = FALSE THEN
       Message 'You do not have a move selected which can be locked.';
       LockMove = FALSE;
       FIELD(LockMove).CurBias = FB_INVISIBLE;
       RESUME;
    ENDIF;

    IF SelectedMoveEquipClass = 0 THEN
       Message 'This move may not be locked.  It is not specific to ' +
               'an equipment type.';
       LockMove = FALSE;
       FIELD(LockMove).CurBias = FB_INVISIBLE;
       RESUME;
    ENDIF;

    /*
    ** Make sure the Repeat button is not visible
    */
    IF FIELD(Repeat_Btn).CurBias <> FB_INVISIBLE THEN
       FIELD(Repeat_Btn).CurBias = FB_INVISIBLE;
    ENDIF;

    Selected.Equip = 0;
    Selected.SubstationName = '';
    Selected.Substation = 0;
    Selected.PrintId = '';
    Selected.EquipClassName = '';
    Selected.ObjectDescription = '';
    Selected.EquipName = '';
    SelectEquip.Clear();

    IF LockMove = FALSE THEN       

       IF TypeExclusion = FALSE THEN
          SelectEquip = FullEquipList.Duplicate();
       ELSE
          SelectEquip = FilteredEquipList.Duplicate();
       ENDIF;
       MoveSelected = FALSE;
       FIELD(LockMove).CurBias = FB_INVISIBLE;
       CurFrame.InputFocusField = NULL;

    ELSE            
/* 
** Locked, load valid equipment list for selected equipment class
*/
       FIELD(LockMove).OnTextLabel = 'Move Locked:  "' + 
                 SQUEEZE(LockedMove.TOMove) + '"';
       i =1;

       IF CurrentApplication = Application$SLC THEN
          IF TypeExclusion = FALSE THEN
             REPEATED
             SELECT  :SelectEquip[i].Equip = O.Object, 
                     :SelectEquip[i].EquipName = O.Name,
                     :SelectEquip[i].EquipClass  = O.Type,
                     :SelectEquip[i].EquipClassName  = O.TypeName,
                     :SelectEquip[i].ObjectDescription = O.Description
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E
             WHERE   G.Grouping = :Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     O.Object = G.Member AND
                     (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                     E.SuperType = :SelectedMoveEquipClass AND 
                     G.MemberType = E.Type
             ORDER BY EquipClassName, EquipName     
             BEGIN
                SelectEquip[i].SubstationName = ObjectName;
                SelectEquip[i].Substation = Object;
                i = i + 1;
             END;
          ELSE
             REPEATED
             SELECT  :SelectEquip[i].Equip = O.Object, 
                     :SelectEquip[i].EquipName = O.Name,
                     :SelectEquip[i].EquipClass  = O.Type,
                     :SelectEquip[i].EquipClassName  = O.TypeName,
                     :SelectEquip[i].ObjectDescription = O.Description
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E, 
                     SOA_TypeExclusion X
             WHERE   G.Grouping = :Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     O.Object = G.Member AND
                     (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                     E.SuperType = :SelectedMoveEquipClass AND 
                     G.MemberType = E.Type AND
                     O.Type = X.Type AND
                     X.Exclusion = 0
             ORDER BY EquipClassName, EquipName     
             BEGIN
                SelectEquip[i].SubstationName = ObjectName;
                SelectEquip[i].Substation = Object;
                i = i + 1;
             END;
          ENDIF;
          CALLPROC DDB_ROLLBACK;

       ELSEIF CurrentApplication = Application$TFMS THEN
          IF TypeExclusion = FALSE THEN
             REPEATED
             SELECT
                :SelectEquip[i].Equip = O.Object, 
                :SelectEquip[i].EquipName = O.Name,
                :SelectEquip[i].EquipClass  = O.Type,
                :SelectEquip[i].EquipClassName  = O.TypeName,
                :SelectEquip[i].ObjectDescription = O.Description,
                :SelectEquip[i].Substation = O.PrimaryGrouping,
                :SelectEquip[i].Substationname = O.PrimaryGroupingName
             FROM  Udb_Object O,
                   Udb_Grouping G,
                   Udb_ExtendedType ET
             WHERE G.Grouping = :Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type = ET.Type AND
/*                   (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                   ET.SuperType = :SelectedMoveEquipClass 
             ORDER BY SubstationName, EquipClassName, EquipName
             BEGIN
                i = i + 1;
             END;
          ELSE
             REPEATED
             SELECT
                :SelectEquip[i].Equip = O.Object, 
                :SelectEquip[i].EquipName = O.Name,
                :SelectEquip[i].EquipClass  = O.Type,
                :SelectEquip[i].EquipClassName  = O.TypeName,
                :SelectEquip[i].ObjectDescription = O.Description,
                :SelectEquip[i].Substation = O.PrimaryGrouping,
                :SelectEquip[i].Substationname = O.PrimaryGroupingName
             FROM  Udb_Object O,
                   Udb_Grouping G,
                   Udb_ExtendedType ET,
                   SOA_TypeExclusion X
             WHERE G.Grouping = :Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type = ET.Type AND
/*                   (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                   ET.SuperType = :SelectedMoveEquipClass AND
                   O.Type = X.Type AND
                   X.Exclusion = 0            
             ORDER BY SubstationName, EquipClassName, EquipName
             BEGIN
                i = i + 1;
             END;
          ENDIF;
          CALLPROC DDB_ROLLBACK;

       ELSEIF CurrentApplication = Application$SDS THEN

          IF Object = -1 THEN
             REPEATED
             SELECT  :SelectEquip[i].Equip = O.Object, 
                     :SelectEquip[i].EquipName = O.Name,
                     :SelectEquip[i].EquipClass  = O.Type,
                     :SelectEquip[i].EquipClassName  = O.TypeName,
                     :SelectEquip[i].ObjectDescription = O.Description,
                     :SelectEquip[i].Substation = O.PrimaryGrouping,
                     :SelectEquip[i].Substationname = O.PrimaryGroupingName
             FROM    Udb_Object O,
                     Udb_ExtendedType E 
             WHERE   E.SuperType = :Type$StreetValve AND
                     E.Type = O.Type AND
                     O.Object > 20000 /*avoid previously used generics*/
             ORDER BY EquipName, EquipClassName      
             BEGIN
                i = i + 1;
             END;

          ELSE 
  
             REPEATED
             SELECT  :SelectEquip[i].Equip = O.Object, 
                     :SelectEquip[i].EquipName = O.Name,
                     :SelectEquip[i].EquipClass  = O.Type,
                     :SelectEquip[i].EquipClassName  = O.TypeName,
                     :SelectEquip[i].ObjectDescription = O.Description,
                     :SelectEquip[i].Substation = O.PrimaryGrouping,
                     :SelectEquip[i].Substationname = O.PrimaryGroupingName
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E
             WHERE   G.Grouping = :Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     O.Object = G.Member AND
                     O.Type = E.Type AND
                     E.SuperType = :SelectedMoveEquipClass 
             ORDER BY EquipClassName, EquipName     
             BEGIN             
                i = i + 1;
             END;
          ENDIF;
       ENDIF;

       IF i = 1 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Cannot generate equipment list for this locked move. ' +
                    'System will unlock the move. Start again by selecting ' +
                    'Equipment first.';
            LockMove = FALSE;
            MoveSelected = FALSE; 
            FIELD(LockMove).CurBias = FB_INVISIBLE;
            SelectMove.Clear(); 
            IF TypeExclusion = FALSE THEN
               SelectEquip = FullEquipList.Duplicate();
            ELSE
               SelectEquip = FilteredEquipList.Duplicate();
            ENDIF;
       ENDIF;
       CALLPROC DDB_ROLLBACK;
    
    ENDIF;         
END;

/**
 **  Remove row from New Move List
 **/
ON CLICK Delete_Btn =
BEGIN
    NewMoves.RemoveRow(rownumber = FIELD(NewMoves).ActiveRow);
    IF NewMoves.LastRow() < 1 THEN
        IF LockMove = FALSE THEN
            FIELD(LockMove).CurBias = FB_INVISIBLE;
            FIELD(Repeat_Btn).CurBias = FB_INVISIBLE;
            RepeatMove = FALSE;
        ENDIF;
        CurFrame.InputFocusField = NULL;
    ENDIF;
/*
** Scroll through NewMoves, if none are for a scenario then enable Scenario.
*/
    i = 1;
    WHILE i <= NewMoves.LastRow() DO
       IF NewMoves[i].Scenario <> 0 THEN
          ENDLOOP;
       ENDIF;
       i = i + 1;
    ENDWHILE;
    IF i > NewMoves.LastRow() THEN
       Scenario = 0;
       FIELD(Scenario).CurBias = FB_CHANGEABLE;
    ENDIF;
END;

/**
 **  Clear New Move List
 **/
ON CLICK Clear_Btn =
BEGIN
    NewMoves.Clear();
    IF LockMove = FALSE THEN
        FIELD(LockMove).CurBias = FB_INVISIBLE;
        FIELD(Repeat_Btn).CurBias = FB_INVISIBLE;
        RepeatMove = FALSE;
    ENDIF;
    Scenario = 0;
    FIELD(Scenario).CurBias = FB_CHANGEABLE;
    CurFrame.InputFocusField = NULL;
END;



ON CLICK ok_btn =
BEGIN
    IF NewMoves.LastRow() = 0 THEN
       Message 'There are no new moves to insert.';
       RESUME;
    ENDIF;
/*
**  Build any necessary generic BusSection Objects.
*/
    FOR i = 1 TO NewMoves.LastRow() DO
/*
**  If Equipment is a bus section, we are going to grab the
**  next available bus section from the unused pool and attach
**  it to the feeder.  Bus sections are moved back to the unused pool
**  when the card is purged.
*/
       IF NewMoves[i].Equip = Object$NULL AND 
          (NewMoves[i].EquipClass = TypeName$BusSect)  THEN
/*
**  Based on type and name, make sure that this is not a duplicate generic
**  bus section.If so, use it.
*/
         TempObject = 0;
         j = 1;
         WHILE j <= i DO

             IF NewMoves[i].EquipClass = NewMoves[j].EquipClass AND
                NewMoves[i].EquipName = NewMoves[j].EquipName THEN

                TempObject = NewMoves[j].Equip;
                NewMoves[i].Equip = TempObject;            
                ENDLOOP;
             ENDIF;
             j = j + 1;
         ENDWHILE;

         IF TempObject = 0 THEN

            BusSectionEquip = NULL;
            BusSectionEquip = Equipment.Create();

            BusSectionEquip.Equip = 0;
            BusSectionEquip.EquipName = NewMoves[i].EquipName;
            BusSectionEquip.EquipClass = NewMoves[i].EquipClass;
            BusSectionEquip.EquipClassName = NewMoves[i].EquipClassName;
            BusSectionEquip.Substation = NewMoves[i].Substation;
            BusSectionEquip.SubstationName = NewMoves[i].SubstationName;
            BusSectionEquip.Description = Selected.ObjectDescription;

            IF CurrentApplication = Application$TFMS THEN            
               TempObject = BusSectionEquip.GenerateBusSection (Card = Card); 
            ELSE
               TempObject = BusSectionEquip.GenerateBusSection (); 
            ENDIF;

            IF TempObject = 0 THEN
               RESUME;
            ENDIF;
         ENDIF;    
         NewMoves[i].Equip = TempObject;            
      ENDIF;
/*
**  If Equipment is a generic valve, we are going to grab the
**  next available valve from the unused pool.  Valves are moved back to the 
**  unused pool when the card is closed/purged.
*/
      IF NewMoves[i].Equip = Object$NULL AND 
          (NewMoves[i].EquipClass = Type$StreetValve OR
               NewMoves[i].EquipClass = Type$StationValve)  THEN
/*
**  Based on type and name, make sure that this is not a duplicate generic
**  valve.  If so, use it.
*/
         TempObject = 0;
         j = 1;
         WHILE j <= i DO

             IF NewMoves[i].EquipClass = NewMoves[j].EquipClass AND
                NewMoves[i].EquipName = NewMoves[j].EquipName THEN

                TempObject = NewMoves[j].Equip;
                NewMoves[i].Equip = TempObject;            
                ENDLOOP;
             ENDIF;
             j = j + 1;
         ENDWHILE;

         IF TempObject = 0 THEN

            SELECT :TempObject = MIN(Object)
            FROM   Udb_Object 
            WHERE  Type = :Type$Valve AND
                   PrimaryGrouping = :Unused$EquipTypePool AND
                   Name = VARCHAR(Object);

            IF TempObject = 0 THEN      
               CALLPROC TraceError (UserMessage = 
                'ERROR: Generic Valve Pool ' +
                'is empty.  Unable to insert job for generica valve.', 
                           TraceMessage =
                'Frame NewMoves;  ' +
                'Generic Valve Pool ' +
                'is empty.'
                );
               CONTINUE;

            ELSE

               RetCode = CALLPROC Udb_ObjectUpdAll (
                         Object = TempObject,
                         Type = NewMoves[i].EquipClass,
                         TypeName = NewMoves[i].EquipClassName,
                         PrimaryGrouping = 0,                              
                         PrimaryGroupingName = '',
                         Name = NewMoves[i].EquipName,
                         Description = 'Generic Valve ' + NewMoves[i].EquipName,
                         Comment = '',
                         OwnerNumber = '',
                         SerialNumber = '',
                         SpecNumber = '',
                         Combination = '',
                         Validated = 'now',
                         ValidatedBy = 'SYSTEM',
                         LastChanged = 'now',
                         LastChangedBy = 'SYSTEM'); 
   
               IF RetCode < 0 THEN    
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
                    'ERROR: Unable to take generic valve object from the generic valve pool.', 
                           TraceMessage =
                    'NewMoves;  ' +
                    'Unable to take generic valve object from the generic valve Pool.'
                     );
                  CONTINUE;                 
               ENDIF;                   
               NewMoves[i].Equip = TempObject;  
          
               RetCode = CALLPROC Udb_GroupingDel (
                         Member = TempObject,
                         Relationship = Interaction$MemberOf,
                         Grouping = Unused$EquipTypePool);  
                
               IF RetCode < 0 THEN    
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to remove generic pool object from the unused Pool.', 
                           TraceMessage =
             'CardSDS;InsertCard; Card insert problem. ' +
             'Unable to remove generic pool object from the unused Pool.'
                  );
                  CONTINUE;
               ENDIF; 
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;   
      ENDIF;         
   ENDFOR;   
/*
** Compile a list of equipment which we will use later to determine the impacted feeders/mains.
*/
   MoveEquipList.Clear();
   FOR i = 1 TO NewMoves.LastRow() DO
      k = 1;
      WHILE k <= MoveEquipList.LastRow() DO
         IF NewMoves[i].Equip = MoveEquipList[k].Value THEN
            ENDLOOP;
         ELSE
            k = k + 1;
         ENDIF;
      ENDWHILE;

      IF k > MoveEquipList.LastRow() THEN      
         MoveEquipList[k].Value = NewMoves[i].Equip;
      ENDIF;
   ENDFOR; 
/*
** Scroll through moves in insertion list.  For each move, determine where it
** needs to go:
**          - if current card or switching item has status = OPEN, then
**            the move shall only be inserted into that card.  Otherwise, build
**            a list of cards that should receive the move, including the 
**            switching item (possibly a shadow) for SLC cards.  The Open card
**            list will only contain one row.
**          - Insert the move into the SOA_Job table.
**          - Insert the control entry for each card where the move is to appear
** Scroll through list of cards where move is to be inserted:
**          - does the move's step heading exist on the card (SLC, TMFS)?  If
**            not insert the step heading.
**          - does the move's substation heading (TFMS or SLC Multiple kV) exist
**            on the card?  If not insert the substation heading.
**          - Insert the SOA_JobControl entry for the move.
*/
   ScenarioInserted = FALSE;
   ScenarioJobs.Clear();
   ScenarioJobCount = 0;
   i = 1;
   m = 1;
   ProtectionMoveList.Clear();
   InsertionList.Clear();
   ImpactedCardList.Clear();
   ImpactedCardList[1].Value = Card;
   WHILE i <= NewMoves.LastRow() DO

      IF CardStatus = Card$Open THEN
         NewMoves[i].ControlCard = Card;
      ELSE
         NewMoves[i].ControlCard = 0;

         /*
         ** If this equipment is not already in the card, check to see if 
         ** moves for this equip exist on active FMS card which is not cut out
         */
         IF NewMoves[i].Equip <> 0 THEN
            k = 0;
            REPEATED
            SELECT :k = 1 
            FROM   SOA_Job J,
                   SOA_JobControl JC
            WHERE JC.Card = :Card AND
                  JC.SwitchingItem = :CardSwitchingItem AND
                  JC.Job = J.Job AND
                  J.Equip = :NewMoves[i].Equip AND
                  J.MoveCategory = :MoveCategory$Normal AND
                  J.Status IN (' ', :JobStatus$NIS);

            IF k = 0 THEN
               CurFrame.StatusText = 'Load outstanding moves from other cards...';
               CurFrame.Flush();
               RetCode = NewMoves[i].LoadOutstandingMoves
                       (Application = CurrentApplication,
                        Card = Card,
                        SwitchingItem = CardSwitchingItem,
                        TypeOfCard = CardTypeOfCard,
                        EquipList = '(' + VARCHAR(NewMoves[i].Equip) + ')' );

               IF RetCode = PU_Cancel THEN
                  Message 'Unable to insert outstanding moves from other cards.';
               ENDIF;            
            ENDIF;
         ENDIF; 
      ENDIF;

      CurFrame.StatusText = 'Insert move ' + VARCHAR(i) + '...';
      CurFrame.Flush();

      IF NewMoves[i].TOMoveRules = MoveRule$None THEN
         NewMoves[i].TOMove = NewMoves[i].RSMove;
      ENDIF;
      IF NewMoves[i].RSMoveRules = MoveRule$None THEN
         NewMoves[i].RSMove = '';
      ENDIF;

      IF NewMoves[i].EquipClass = Type$Main THEN
         NewMoves[i].EquipClassName = '';
         NewMoves[i].Equip = 0;
      ENDIF;

      NewMoves[i].Job = NewMoves[i].InsertJob (Card = Card);
      IF NewMoves[i].Job < 0 THEN      
         MESSAGE 'Frame:NewMoves; Job Insertion failed.';
         IF NewMoves[i].Equip < 2000 AND 
            (NewMoves[i].EquipClass = Type$StreetValve OR
               NewMoves[i].EquipClass = Type$StationValve)  THEN
            CALLPROC ReturnPoolObject (Object = NewMoves[i].Equip,ObjectType = Type$Valve);
         ENDIF;
         ENDLOOP;
         RESUME;
      ENDIF;

      InsertionList[1].Card = Card;
      InsertionList[1].SwitchingItem = CardSwitchingItem;
      InsertionList[1].Application = CurrentApplication;
      InsertionList[1].StepHeading = NewMoves[i].StepPair;
      InsertionList[1].TypeOfCard = CardTypeOfCard;
      Insertionlist[1].MoveEquipClass = NewMoves[i].MoveEquipClass;
      Insertionlist[1].StepLevel = 0;
      Insertionlist[1].PrintID = NewMoves[i].PrintID;

      IF NewMoves[i].StepPair <> StepHeading$TestPermit AND
         NewMoves[i].StepPair <> StepHeading$WorkPermit THEN
         ProtectionMoveList[m].Job = NewMoves[i].Job;
         ProtectionMoveList[m].DeskName = NewMoves[i].DeskName;
         ProtectionMoveList[m].Equip = NewMoves[i].Equip;
         ProtectionMoveList[m].EquipClass = NewMoves[i].EquipClass;
         ProtectionMoveList[m].EquipClassName = NewMoves[i].EquipClassName;
         ProtectionMoveList[m].EquipName = NewMoves[i].EquipName;
         ProtectionMoveList[m].JobClass = NewMoves[i].JobClass;
         ProtectionMoveList[m].MoveCategory = NewMoves[i].MoveCategory;
         ProtectionMoveList[m].PrintID = NewMoves[i].PrintID;
         ProtectionMoveList[m].TOComplete = NewMoves[i].TOComplete;
         ProtectionMoveList[m].RSComplete = NewMoves[i].RSComplete;
         ProtectionMoveList[m].TOIssued = NewMoves[i].TOIssued;
         ProtectionMoveList[m].RSIssued = NewMoves[i].RSIssued;
         ProtectionMoveList[m].TOMove = NewMoves[i].TOMove;
         ProtectionMoveList[m].RSMove = NewMoves[i].RSMove;
         ProtectionMoveList[m].Seq = NewMoves[i].Seq;
         ProtectionMoveList[m].Status = NewMoves[i].Status;
         ProtectionMoveList[m].StepPair = NewMoves[i].StepPair;
         ProtectionMoveList[m].Substation = NewMoves[i].Substation;
         ProtectionMoveList[m].CardTypeName = 'SOA';
         ProtectionMoveList[m].CardName = ObjectName;
         IF NewMoves[i].Substation = 0 THEN
            ProtectionMoveList[m].SubsOrDesk = NewMoves[i].DeskName;
         ELSE
            ProtectionMoveList[m].SubsOrDesk = NewMoves[i].SubstationName;
         ENDIF;
         m = m + 1;
      ENDIF;

      RetCode = NewMoves[i].InsertControl (
               ControlEntry = InsertionList[1],
               InitiatingCard = Card);
      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Frame:NewMoves; Error inserting control entries for a ' +
                 'move.';
         IF NewMoves[i].Equip < 2000 AND 
            (NewMoves[i].EquipClass = Type$StreetValve OR
               NewMoves[i].EquipClass = Type$StationValve)  THEN
            CALLPROC ReturnPoolObject (Object = NewMoves[i].Equip,ObjectType = Type$Valve);
         ENDIF;
         ENDLOOP;
         RESUME;
      ENDIF; 

      IF NewMoves[i].Scenario <> 0 THEN
         ScenarioInserted = TRUE;
      ENDIF;
/*
**  IF TFMS card and equip none for a substation, find substation card and 
**  insert into shadow.
*/
      IF CurrentApplication = Application$TFMS AND CardStatus <> Card$Open AND
            NewMoves[i].Equip = 0 AND NewMoves[i].Substation <> 0 THEN

         InsertionList.Clear();
         REPEATED 
         SELECT    
            :InsertionList[1].Card = AC.Card,
            :InsertionList[1].Application = AC.Application,
            :InsertionList[1].TypeOfCard = AC.TypeOfCard,
            :InsertionList[1].SwitchingItem = JC.SwitchingItem,
            :InsertionList[1].StepHeading = JCC.StepPair,
            :InsertionList[1].MoveEquipClass = JCC.EquipClass,
            :InsertionList[1].StepLevel = 0,
            :InsertionList[1].PrintID = ''
         FROM     
             SOA_ActiveCard AC,
             SOA_ActiveObject AO,
             FMS_JobClassControl JCC,
             SOA_JobControl JC,
             SOA_Job J 
         WHERE     
             AO.Object = :NewMoves[i].Substation AND
             AO.ObjectToCardLink = 1 AND 
             AO.Card = AC.Card AND
             AC.Application = :Application$SLC AND
             AC.TypeOfCard = JCC.TypeOfCard AND
             JCC.JobClass = :NewMoves[i].JobClass AND
             JCC.PreferredStep = :TRUE AND
             JCC.EquipClass = 0 AND
             AC.Card = JC.Card AND
             JC.Job = J.Job AND
             J.ShadowLink = :Card;
        
         IF iirowcount > 0 THEN         
            RetCode = NewMoves[i].InsertControl (
               ControlEntry = InsertionList[1],
               InitiatingCard = Card);
            IF RetCode = PU_CANCEL THEN
              MESSAGE 'Frame:NewMoves; Error inserting control entries for a ' +
                 'shadow move.';
              IF NewMoves[i].Equip < 2000 AND 
                 (NewMoves[i].EquipClass = Type$StreetValve OR
                  NewMoves[i].EquipClass = Type$StationValve)  THEN
                 CALLPROC ReturnPoolObject (Object = NewMoves[i].Equip,ObjectType = Type$Valve);
              ENDIF;
              ENDLOOP;
              RESUME;
            ENDIF; 
          ENDIF;           
      ENDIF;
/*
** If this move is a Scenario move, record it in our jobs array so that
** we can remember the Job key when we insert it into the Scenario history.
*/
      IF NewMoves[i].Scenario <> 0 THEN
         ScenarioJobCount = ScenarioJobCount + 1;
         ScenarioJobs.InsertRow (RowNumber = ScenarioJobCount); 
         ScenarioJobs[ScenarioJobCount].Value = NewMoves[i].Job;
      ENDIF;
/*
**  Cascade equipment moves to other possible cards
*/
      IF CardStatus <> Card$Open AND NewMoves[i].Equip <> 0 THEN

         Idx.Clear();
         Idx = CALLPROC CascadeMoves (Move = NewMoves[i],
                                      Card = Card
                                     );

#        include ManageImpactedCards

      ENDIF;
/*
** Never increment i counter, just remove first row until no more exist.
*/       
      NewMoves.RemoveRow(RowNumber = 1);
   ENDWHILE;

#  include NotifyImpactedCards
/*
** If a Scenario was used, record the scenario for historical purposes
*/
   IF ScenarioInserted = TRUE AND ScenarioType <> 0 AND ScenarioDate <> '' THEN
      CurFrame.StatusText = 'Recording Scenario History...';
      CurFrame.Flush();
      
      RetCode = CALLPROC SOA_ScenarioHistoryIns (
                  Card = Card,
                  SwitchingItem = CardSwitchingItem,
                  Scenario = ScenarioType,
                  ScenarioDate = ScenarioDate,
                  StartPoint = ScenarioStartPoint);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Frame:NewMoves; Unable to record scenario use in Scenario ' +
                 'History.';
      ELSE
         CALLPROC DDB_COMMIT;

         FOR i = 1 TO ScenarioJobs.LastRow() DO
               
               RetCode = CALLPROC SOA_ScenarioHistJobIns (
                  Card = Card,
                  SwitchingItem = CardSwitchingItem,
                  Scenario = ScenarioType,
                  ScenarioDate = ScenarioDate,
                  Job = ScenarioJobs[i].Value);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  MESSAGE 'Frame:NewMoves; Unable to include all jobs related' +
                          'to scenario in Scenario History.';
                  ENDLOOP;
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF;
         ENDFOR;
      ENDIF;  
   ENDIF; 

   IF CurrentApplication = Application$SLC OR CurrentApplication = Application$TFMS THEN
      IF MoveEquipList.LastRow() > 0 THEN
         CALLPROC ProcessFMSCards();
      ENDIF;
   ENDIF;
   IF CurrentApplication = Application$SDS THEN
      IF MoveEquipList.LastRow() > 0 THEN
         CALLPROC ProcessSDSCards();
      ENDIF;
   ENDIF;
   RETURN PU_OK;
END;


ON DBEvent 'soa_card_control_taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return PU_CANCEL;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    IF NewMoves.LastRow() <> 0 THEN
       IF CurFrame.ConfirmPopUp (messagetext = 'Are you sure you want to' +
             ' exit without inserting your new moves into the card?  Click' +
             ' OK to exit - or Cancel to stay.') = PU_CANCEL THEN
          RESUME;
       ENDIF;
    ENDIF;
    RETURN PU_CANCEL;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

PROCEDURE LoadEquipData (
   PassedInList = ARRAY OF Equipment;
   Exclusion = INTEGER NOT NULL WITH DEFAULT;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   TempEquip = ARRAY OF Equipment;
   ObjectType = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Load equipment based on passed object, or object selected on
**  screen.  Select statements are different depending on application.
*/
    Selected.Equip = 0;
    Selected.SubstationName = '';
    Selected.Substation= 0;
    Selected.PrintId = '';
    Selected.EquipClassName = '';
    Selected.EquipName = '';
    Selected.ObjectDescription = '';

    SelectEquip.Clear();        /* Clear out storage */
/*
** DEFAULT Equipment NONE
*/
    TempEquip[1].Equip = 0;   
    TempEquip[1].SubstationName = '';
    TempEquip[1].Substation = 0;
    TempEquip[1].PrintId = '';
    TempEquip[1].EquipName = '';
    TempEquip[1].EquipClass = 0;
    TempEquip[1].EquipClassName = 'NONE';
    TempEquip[1].ObjectDescription = '';       
    i = 2;
/*
** Bus Section commented out 03/08/07
**
    IF CurrentApplication <> Application$SDS THEN
       TempEquip[2].Equip = 0;   
       TempEquip[2].SubstationName = '';
       TempEquip[2].Substation = 0;
       TempEquip[2].PrintId = '';
       TempEquip[2].EquipName = '';
       TempEquip[2].EquipClass = :TypeName$BusSect;
       TempEquip[2].EquipClassName = 'BusSect';
       TempEquip[2].ObjectDescription = ''; 
       i = 3;
    ENDIF;
*/      
    IF CurrentApplication = Application$SLC THEN

       TempEquip[1].Substation = Object;
       TempEquip[1].SubstationName = ObjectName;
/*
** Bus Section commented out 03/08/07
**
       TempEquip[2].Substation = Object;
       TempEquip[2].SubstationName = ObjectName;
*/
       IF Exclusion = TRUE THEN
          REPEATED
          SELECT  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description
          FROM    Udb_Object O,
                  Udb_Grouping G,
                  Udb_ExtendedType E,
                  SOA_TypeExclusion X
          WHERE   G.Grouping = :Object AND
                  G.Relationship = :Interaction$MemberOf AND
                  O.Object = G.Member AND
                 (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                  E.SuperType = :Type$Conducting AND
                  E.Type NOT IN (SELECT Type
                                 FROM Udb_ExtendedType
                                 WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
                  G.MemberType = E.Type AND
                  O.Type = X.Type AND
                  X.Exclusion = 0
          ORDER BY EquipClassName, EquipName     
          BEGIN
             TempEquip[i].SubstationName = ObjectName;
             TempEquip[i].Substation = Object;
             i = i + 1;
          END;
       ELSE
          REPEATED
          SELECT  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description
          FROM    Udb_Object O,
                  Udb_Grouping G,
                  Udb_ExtendedType E
          WHERE   G.Grouping = :Object AND
                  G.Relationship = :Interaction$MemberOf AND
                  O.Object = G.Member AND
/* commented out: InService and OutService fields in DB are messed up
                  (O.Outservice IS NULL OR O.Outservice = '') AND	 Exclude dropped equip 
*/
                  E.SuperType = :Type$Conducting AND
                  E.Type NOT IN (SELECT Type
                                 FROM Udb_ExtendedType
                                 WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
                  G.MemberType = E.Type
          ORDER BY EquipClassName, EquipName     
          BEGIN
             TempEquip[i].SubstationName = ObjectName;
             TempEquip[i].Substation = Object;
             i = i + 1;
          END;
       ENDIF;
       CALLPROC DDB_ROLLBACK;

    ELSEIF CurrentApplication = Application$TFMS THEN
/*
** check if the selected object is Type$Line or Type$Substation
*/
       ObjectType = 0;
       FOR m = 1 TO TFMSObjRefList.LastRow DO
          IF TFMSObjRefList[m].Object = Object THEN
             ObjectType = TFMSObjRefList[m].Type;
             ENDLOOP;
          ENDIF;
       ENDFOR;
/*
** Load Substations First for Field Work
*/
       i = 2;
       REPEATED
       SELECT DISTINCT
          :TempEquip[i].Equip = 0,
          :TempEquip[i].EquipName = '',
          :TempEquip[i].EquipClass  = 0,
          :TempEquip[i].EquipClassName  = 'None',
          :TempEquip[i].ObjectDescription = '',
          :TempEquip[i].Substation = Object,
          :TempEquip[i].Substationname = Name
       FROM   TFMS_CardToObject 
       WHERE  Card = :Card AND 
              Type = :Type$Substation AND   
              Object IN 
                (SELECT  O.PrimaryGrouping              
                 FROM    Udb_Object O,
                         Udb_Grouping G,
                         Udb_ExtendedType ET
                 WHERE   G.Grouping = :Object AND
                         G.Relationship = :Interaction$MemberOf AND
                         G.Member = O.Object AND
                         O.Type = ET.Type AND
                         ET.SuperType = :Type$Conducting) 
       BEGIN
          i = i + 1;
       END;
/*
** Load ACLineSegments for each station for line
*/
             REPEATED
             SELECT
                  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description,
                  :TempEquip[i].Substation = O.PrimaryGrouping,
                  :TempEquip[i].Substationname = O.PrimaryGroupingName
             FROM  Udb_Object O,
                   Udb_Grouping G,
                   TFMS_CardToObject CTO
             WHERE G.Grouping = :Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type = :Type$ACLineSegment AND
                   O.PrimaryGrouping = CTO.Object AND
                   CTO.Card = :Card
             ORDER BY SubstationName, EquipClassName, EquipName
             BEGIN
                i = i + 1;
             END;
/*
** Load Substation for Bus Section
*/
/*
** Bus Section commented out 03/08/07
**
       REPEATED
       SELECT DISTINCT
          :TempEquip[i].Equip = 0,
          :TempEquip[i].EquipName = '',
          :TempEquip[i].EquipClass  = :TypeName$BusSect,
          :TempEquip[i].EquipClassName  = 'BusSect',
          :TempEquip[i].ObjectDescription = '',
          :TempEquip[i].Substation = Object,
          :TempEquip[i].Substationname = Name
       FROM    TFMS_CardToObject 
       WHERE   Card = :Card AND 
              Type = :Type$Substation AND   
              Object IN 
                (SELECT  O.PrimaryGrouping              
                 FROM    Udb_Object O,
                         Udb_Grouping G,
                         Udb_ExtendedType ET
                 WHERE   G.Grouping = :Object AND
                         G.Relationship = :Interaction$MemberOf AND
                         G.Member = O.Object AND
                         O.Type = ET.Type AND
                         ET.SuperType = :Type$Conducting) 
       BEGIN
          i = i + 1;
       END;
*/ 
       IF ObjectType = Type$Line THEN          
          IF Exclusion = TRUE THEN
             REPEATED
             SELECT
                  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description,
                  :TempEquip[i].Substation = O.PrimaryGrouping,
                  :TempEquip[i].Substationname = O.PrimaryGroupingName
             FROM  Udb_Object O,
                   Udb_Grouping G,
                   Udb_ExtendedType ET,
                   TFMS_CardToObject CTO,
                   SOA_TypeExclusion X
             WHERE G.Grouping = :Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type <> :Type$ACLineSegment AND
                   O.Type = ET.Type AND 
/*                   (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                   ET.SuperType = :Type$Conducting AND
                   O.PrimaryGrouping = CTO.Object AND
                   CTO.Card = :Card AND
                   O.Type = X.Type AND
                   X.Exclusion = 0
             ORDER BY SubstationName, EquipClassName, EquipName
             BEGIN
                i = i + 1;
             END;     
          ELSE
             REPEATED
             SELECT
                  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description,
                  :TempEquip[i].Substation = O.PrimaryGrouping,
                  :TempEquip[i].Substationname = O.PrimaryGroupingName
             FROM  Udb_Object O,
                   Udb_Grouping G,
                   Udb_ExtendedType ET,
                   TFMS_CardToObject CTO
             WHERE G.Grouping = :Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type <> :Type$ACLineSegment AND
                   O.Type = ET.Type AND
/* commented out: InService and OutService fiedls in DB are messed up
                     (O.Outservice IS NULL OR O.Outservice = '') AND	 Exclude dropped equip 
*/
                   ET.SuperType = :Type$Conducting AND
                   O.PrimaryGrouping = CTO.Object AND
                   CTO.Card = :Card
             ORDER BY SubstationName, EquipClassName, EquipName
             BEGIN
                i = i + 1;
             END;
          ENDIF;  

       ELSEIF ObjectType = Type$Substation THEN  /* substation equipment */
          IF Exclusion = TRUE THEN
             REPEATED
             SELECT  :TempEquip[i].Equip = O.Object, 
                     :TempEquip[i].EquipName = O.Name,
                     :TempEquip[i].EquipClass  = O.Type,
                     :TempEquip[i].EquipClassName  = O.TypeName,
                     :TempEquip[i].ObjectDescription = O.Description
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E,
                     SOA_TypeExclusion X
             WHERE   G.Grouping = :Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Member = O.Object AND
                     (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                     O.Type = E.Type AND
                     E.SuperType = :Type$Conducting AND
                     O.Type = X.Type AND
                     X.Exclusion = 0
             ORDER BY EquipClassName, EquipName     
             BEGIN
                TempEquip[i].SubstationName = ObjectName;
                TempEquip[i].Substation = Object;
                i = i + 1;
             END;
          ELSE
             REPEATED
             SELECT  :TempEquip[i].Equip = O.Object, 
                     :TempEquip[i].EquipName = O.Name,
                     :TempEquip[i].EquipClass  = O.Type,
                     :TempEquip[i].EquipClassName  = O.TypeName,
                     :TempEquip[i].ObjectDescription = O.Description
             FROM    Udb_Object O,
                     Udb_Grouping G,
                     Udb_ExtendedType E
             WHERE   G.Grouping = :Object AND
                     G.Relationship = :Interaction$MemberOf AND
                     G.Member = O.Object AND
                     O.Type = E.Type AND
                     E.SuperType = :Type$Conducting
             ORDER BY EquipClassName, EquipName     
             BEGIN
                TempEquip[i].SubstationName = ObjectName;
                TempEquip[i].Substation = Object;
                i = i + 1;
             END;
          ENDIF;
       ENDIF;
       CALLPROC DDB_ROLLBACK;

    ELSEIF CurrentApplication = Application$SDS THEN
       TempEquip[2].Equip = 0;   
       TempEquip[2].SubstationName = '';
       TempEquip[2].Substation = 0;
       TempEquip[2].PrintId = '';
       TempEquip[2].EquipName = '';
       TempEquip[2].EquipClass = :Type$StreetValve;
       TempEquip[2].EquipClassName = 'StreetValve';
       TempEquip[2].ObjectDescription = ''; 
       IF Object <> - 1 THEN
          TempEquip[3].Equip = 0;   
          TempEquip[3].SubstationName = '';
          TempEquip[3].Substation = 0;
          TempEquip[3].PrintId = '';
          TempEquip[3].EquipName = '';
          TempEquip[3].EquipClass = :Type$StationValve;
          TempEquip[3].EquipClassName = 'StationValve';
          TempEquip[3].ObjectDescription = ''; 
          i = 4;
       ELSE
          i = 3;
       ENDIF;
/*
** Add Mains 
*/       
       REPEATED
       SELECT  :TempEquip[i].Equip = CM.Main, 
               :TempEquip[i].EquipName = '',
               :TempEquip[i].EquipClass  = :Type$Main,
               :TempEquip[i].EquipClassName  = 'Main',
               :TempEquip[i].ObjectDescription = '',
               :TempEquip[i].Substation = CM.Main,
               :TempEquip[i].Substationname = CM.MainName
       FROM    SDS_CardMain CM
       WHERE   CM.Card = :Card
       BEGIN 
          IF TempEquip[i].Substation < 20000 THEN
             TempEquip[i].Substationname = 'Street Main';
          ENDIF;
          i = i + 1;
       END;
/*
** If Object = -1 then street valves has been selected.
*/
       IF Object = -1 THEN
          FOR m = 1 TO StreetValves.LastRow() DO
             TempEquip[i] = StreetValves[m];
             i = i + 1;
          ENDFOR;
       ELSE
          REPEATED
          SELECT  :TempEquip[i].Equip = O.Object, 
                  :TempEquip[i].EquipName = O.Name,
                  :TempEquip[i].EquipClass  = O.Type,
                  :TempEquip[i].EquipClassName  = O.TypeName,
                  :TempEquip[i].ObjectDescription = O.Description,
                  :TempEquip[i].Substation = O.PrimaryGrouping,
                  :TempEquip[i].Substationname = O.PrimaryGroupingName
          FROM    Udb_Object O,
                  Udb_Grouping G,
                  Udb_ExtendedType E
          WHERE   G.Grouping = :Object AND
                  G.Relationship = :Interaction$MemberOf AND
                  O.Object = G.Member AND
                  E.SuperType = :Type$Valve AND
                  G.MemberType = E.Type
          ORDER BY EquipClassName, EquipName     
          BEGIN             
             i = i + 1;
          END;
       ENDIF;
       CALLPROC DDB_ROLLBACK;
/*
** Still must add FMS Equip Select
*/
    ENDIF;  

    PassedInList =  TempEquip.Duplicate();  
    SelectEquip = TempEquip.Duplicate();  

    SelectMove.Clear();
    CurFrame.StatusText = 'Select Equipment and Moves OR use a Scenario.'; 
END;

PROCEDURE ProcessFMSCards(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   n = INTEGER NOT NULL WITH DEFAULT;

   ActiveIdx = INTEGER NOT NULL WITH DEFAULT;  
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT; 
   FeederList = ARRAY OF ObjectSummaryClass;
   FMSCard = INTEGER NOT NULL WITH DEFAULT;  
   NewCardClass = INTEGER NOT NULL WITH DEFAULT;  
   FMSList = ARRAY OF ListedCard;
   RetCode = INTEGER;
   SLCCardClass = INTEGER NOT NULL WITH DEFAULT; 
   Status = INTEGER NOT NULL WITH DEFAULT; 
   TextString = VARCHAR(1500) NOT NULL WITH DEFAULT; 

ENDDECLARE
BEGIN
/*
** ITC 154: If the equipment are feeder source breakers, FMS cards are impacted.
*/
   DynamicWhereClause = 'G.Relationship = ' + VARCHAR(Interaction$SourceBreaker) + ' AND ' +
                        'G.GroupingType = ' + VARCHAR(Type$Feeder) + ' AND ' + 
                        'G.Member IN (';
   FOR k = 1 TO MoveEquipList.LastRow() DO
      IF k > 1 THEN
         DynamicWhereClause = DynamicWhereClause + ',';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + VARCHAR(MoveEquipList[k].Value);
   ENDFOR;
   DynamicWhereClause = DynamicWhereClause + ') AND ' + 
                        ' G.Grouping = O.Object ';    
   i = 1;
   FeederList.Clear();
   SELECT DISTINCT 
          :FeederList[i].Object = G.Grouping,
          :FeederList[i].Name = O.Name
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  :DynamicWhereClause
   BEGIN
      i = i + 1;
   END;   
/*
** Look for alternate source breakers in equipment list. Add to same FeederList.
*/
   DynamicWhereClause = 'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                        'G.GroupingType = ' + VARCHAR(Type$Feeder) + ' AND ' + 
                        'G.MemberType = ' + VARCHAR(Type$SSRO) + ' AND ' + 
                        'G.Member IN (';
   FOR k = 1 TO MoveEquipList.LastRow() DO
      IF k > 1 THEN
         DynamicWhereClause = DynamicWhereClause + ',';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + VARCHAR(MoveEquipList[k].Value);
   ENDFOR;
   DynamicWhereClause = DynamicWhereClause + ') AND ' + 
                        ' G.Grouping = O.Object ';    

   SELECT DISTINCT 
          :FeederList[i].Object = G.Grouping,
          :FeederList[i].Name = O.Name
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  :DynamicWhereClause
   BEGIN
      i = i + 1;
   END;   

   IF i = 1 THEN
      RETURN;
   ENDIF;

   IF CurrentApplication = Application$SLC THEN 
      SELECT :SLCCardClass = CardClass
      FROM   SLC_InformationItem
      WHERE  Job = :CardSwitchingItem;
   ELSE
      SELECT :SLCCardClass = CardClass
      FROM   SOA_Card
      WHERE  Card = :Card;
   ENDIF;
   /*
   ** Create or activate the FMS cards 
   */
   NewCardClass = 0;
   FOR i = 1 TO FeederList.LastRow() DO
      CurFrame.StatusText = 'Process FMS card ' + FeederList[i].Name + '...';
      CurFrame.Flush();
      /*
      ** check if there is already an fms card linked to this switching item
      */
      FMSCard = 0;
      TextString = '';

      SELECT :FMSCard = C.Card
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             SOA_FMSSLCLink L
      WHERE  L.SLCCard = :Card AND
             L.SwitchingItem = :CardSwitchingItem AND
             L.FMSCard = C.Card AND
             C.Card = CTO.Card AND
             CTO.Object = :FeederList[i].Object;

/* OK to continue to the next card */
      IF FMSCard > 0 THEN
         CONTINUE;
      ENDIF;
      
/* Otherwise, see if there is an active card
*/
      k = 1;
      ActiveIdx = 0;
      FMSList.Clear();

      SELECT :FMSList[k].Card = SC.Card,
             :FMSList[k].FeederName = C.FeederName,
             :FMSList[k].FeederStatusName = C.FeederStatusName,
             :FMSList[k].CardClassName = SC.CardClassName,
             :FMSList[k].Opened = SC.Opened,
             :FMSList[k].CurrentNote = SC.Note,
             :FMSList[k].Status = SC.Status
      FROM   SOA_Card SC,
             TFMS_CardToObject CTO,
             FMS_Card C
      WHERE  CTO.Object = :FeederList[i].Object AND
             CTO.Card = C.Card AND
             C.Card = SC.Card AND
             SC.Status IN (:Card$Active, :Card$OutToWork, :Card$Idle)              
      BEGIN
         ActiveIdx = k; // equal to 1 only
         k = k + 1;
      END;
/*
** If New Move Scenarios are added to Open Switching Item. The system will:
** - generate an Open FMS card for each source breaker
** - populate the feedercard note with the switching item name and scenario description
** - create a hard link that relates the switching item to the open feedercard
*/
      IF CardStatus = Card$Open THEN
         IF ActiveIdx > 0 THEN
            /* there is already an active fms card, 
            */
            IF CurFrame.ConfirmPopup (messagetext = 'There is already an Active, OTW or Idle card on feeder ' + 
		         FeederList[i].Name + '.' + HC_NEWLINE + 
                         'Select ''OK'' to use this card for the source breaker work; Or' + HC_NEWLINE + 
                         'Select ''Cancel'' to create or use an open FMS card for future work.') = PU_OK THEN
           
               FMSCard = FMSList[ActiveIdx].Card;
            ELSE
               FMSList.Clear();
               FMSCard = 0;
            ENDIF;
         ENDIF;

         IF FMSCard = 0 THEN
            /*  Set the corresponding FMS card's class. */
            IF NewCardClass = 0 THEN
               NewCardClass = CALLFRAME SelectFMSTypeBySLC(
                                           FeederName = FeederList[i].Name,
                                           SLCCardClass = SLCCardClass );
            ENDIF;

            /* see if there are open cards
            */
            k = 1;
            FMSList.Clear();

            SELECT :FMSList[k].Card = SC.Card,
                   :FMSList[k].FeederName = C.FeederName,
                   :FMSList[k].FeederStatusName = C.FeederStatusName,
                   :FMSList[k].CardClassName = SC.CardClassName,
                   :FMSList[k].Opened = SC.Opened,
                   :FMSList[k].CurrentNote = SC.Note,
                   :FMSList[k].Status = SC.Status
            FROM   SOA_Card SC,
                   TFMS_CardToObject CTO,
                   FMS_Card C
            WHERE  CTO.Object = :FeederList[i].Object AND
                   CTO.Card = C.Card AND
                   C.Card = SC.Card AND
                   SC.Status = :Card$Open AND 
                   SC.CardClass = :NewCardClass            
            BEGIN
               k = k + 1;
            END;

            /* Ask DO to select an open card.
            */ 
            IF FMSList.LastRow() > 0 THEN
               FMSCard = CALLFRAME SelectFMSCard(CardList = FMSList,
                                              Title = 'Select an Open Card for Source Breaker work');
            ENDIF;
         ENDIF;

         IF FMSCard = 0 THEN
            CurFrame.StatusText = 'Create FMS card ' + FeederList[i].Name + '...';
            CurFrame.Flush();
            /* Create an FMS Open card 
            */
            FMSCard = CALLPROC CreateFMSCardSetUp (
                           Feeder = FeederList[i].Object,
                           CardClass = NewCardClass); 
 
           IF FMSCard <= 0 THEN
               CurFrame.Trace(VARCHAR(DATE('now')) + ': Error - NewMove failed to create an open feeder card ' + 
                            ' for Source Breaker work.' );
               CONTINUE;
            ENDIF;
         ENDIF;
/*
** If Adding New Move Scenarios to an Active Switching Item. The system will 
** - create a new active feeder card, or 
** - activate existing open card
** - populate the feedercard note with the switching item name and scenario description
** - create link from switching item to the fms card
*/
      ELSEIF CardStatus = Card$Active THEN
         IF ActiveIdx > 0 THEN
            /* there is already an active fms card, 
            */
            FMSCard = FMSList[ActiveIdx].Card;
         ELSE
            /*  Set the corresponding FMS card's class. */
            IF NewCardClass = 0 THEN
               NewCardClass = CALLFRAME SelectFMSTypeBySLC(
                                           FeederName = FeederList[i].Name,
                                           SLCCardClass = SLCCardClass );
            ENDIF;

            /* see if there are open cards
            */
            k = 1;
            FMSList.Clear();

            SELECT :FMSList[k].Card = SC.Card,
                   :FMSList[k].FeederName = C.FeederName,
                   :FMSList[k].FeederStatusName = C.FeederStatusName,
                   :FMSList[k].CardClassName = SC.CardClassName,
                   :FMSList[k].Opened = SC.Opened,
                   :FMSList[k].CurrentNote = SC.Note,
                   :FMSList[k].Status = SC.Status
            FROM   SOA_Card SC,
                   TFMS_CardToObject CTO,
                   FMS_Card C
            WHERE  CTO.Object = :FeederList[i].Object AND
                   CTO.Card = C.Card AND
                   C.Card = SC.Card AND
                   SC.Status = :Card$Open AND 
                   SC.CardClass = :NewCardClass            
            BEGIN
               k = k + 1;
            END;

            /* Ask DO to select an open card to activate.
            */ 
            IF FMSCard = 0 AND FMSList.LastRow() > 0 THEN
               FMSCard = CALLFRAME SelectFMSCard(CardList = FMSList,
                                                 Title = 'Select a Card to Activate');
            ENDIF;
                     
            /* Create an Open card because either there is none or D.O.
            ** decided to create a new one.
            */
            IF FMSCard = 0 THEN
               CurFrame.StatusText = 'Create FMS card ' + FeederList[i].Name + '...';
               CurFrame.Flush();
               FMSCard = CALLPROC CreateFMSCardSetup (
                              Feeder = FeederList[i].Object,
                              CardClass = NewCardClass); 
               IF FMSCard <= 0 THEN
                   CurFrame.Trace(VARCHAR(DATE('now')) + ': Error - Failed to create an open feeder card for source breaker work.' );
                  CONTINUE;
               ENDIF;
            ENDIF;
                 
            /*
            ** activate the open card 
            */
            CurFrame.StatusText = 'Activate FMS card ' + FeederList[i].Name + '...';
            CurFrame.Flush();
            RetCode = CALLFRAME ActivateFMSCard(
                              Card = FMSCard,
                              OldCardStatus = Card$Open); 
            IF RetCode = PU_CANCEL THEN
               CurFrame.Trace(VARCHAR(DATE('now')) + ': Error - NewMove failed to activate open feeder card =' + 
                             VARCHAR(FMSCard) + ' for source breaker work.');
               CONTINUE;
            ENDIF;  
         ENDIF;
      ENDIF;

      /* 
      **  Create a link between the switching item and the fms card
      */
      RetCode = CALLPROC SOA_FMSSLCLinkIns(
                                FMSCard = FMSCard,
                                SLCCard = Card,
                                SwitchingItem = CardSwitchingItem);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError(
                      UserMessage = 'Failed to link this switching item to the feeder card ' + FeederList[i].Name,
                      TraceMessage = 'Error - NewMove failed to link TOMS card ' + 
                      'to feeder card ' + VARCHAR(FMSCard));
         CONTINUE;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;

      /* append the feedercard note with the switching item name 
      */
      SELECT :TextString = Note
      FROM   SOA_Card
      WHERE  Card = :FMSCard; 

      IF TextString <> '' THEN
         TextString = TextString + HC_NEWLINE;
      ENDIF;
      IF CurrentApplication = Application$SLC THEN
         TextString = TextString + SW.SwitchingItemMoveText;
      ENDIF;

      RetCode = CALLPROC SOA_CardNoteUpd
		             (Card = FMSCard, 
                              Note = TextString);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError(
                      UserMessage = 'Failed to update feeder card note with the switching item ' +
                      'title.',
                      TraceMessage = 'Error - NewMove failed to update card note with' + 
                      '  switching item info for feeder card ' + VARCHAR(FMSCard));
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;
END;

PROCEDURE FindDropBacks (
   Valve	= INTEGER NOT NULL
) =
DECLARE
   Station   = INTEGER NOT NULL WITH DEFAULT;
   TempEquip = ARRAY OF Equipment;
   i         = INTEGER NOT NULL WITH DEFAULT;
   k         = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   SELECT  :Station = Station
   FROM    SDS_Card
   WHERE   Card = :Card;
/*
** Must trace both ways from selected valve, get immediate list of equipment.
** Ignore Source Position valves for mains on this card and valves outside the station.
*/
   i = 1;
   TempEquip.Clear();
   REPEATED
   SELECT  :TempEquip[i].Equip = O.Object, 
           :TempEquip[i].EquipName = O.Name,
           :TempEquip[i].EquipClass  = O.Type,
           :TempEquip[i].EquipClassName  = O.TypeName,
           :TempEquip[i].ObjectDescription = O.Description,
           :TempEquip[i].Substation = O.PrimaryGrouping,
           :TempEquip[i].Substationname = O.PrimaryGroupingName
   FROM    Udb_Object O,
           Udb_Terminal T1,
           Udb_Terminal T2,
           Udb_Grouping G
   WHERE   T1.Object = :Valve AND
           T1.Node >= 20000 AND
           T1.Node = T2.Node AND
           T2.Object = O.Object AND
           T1.Object <> T2.Object AND
           T2.Object = G.Member AND
           G.Relationship = :Interaction$MemberOf AND
           G.Grouping = :Station
   ORDER BY EquipClassName, EquipName     
   BEGIN             
      i = i + 1;
   END;
/*
** Eliminate any equipment that is a source position for a main on this card
*/
   i = TempEquip.LastRow();
   WHILE i > 0 DO
      k = 0;
      SELECT :k = G.Member
      FROM   Udb_Grouping G,
             SDS_CardMain CM
      WHERE  G.Member = :TempEquip[i].Equip AND
             G.Relationship = :Interaction$SourcePosition AND
             G.Grouping = CM.Main AND
             CM.Card = :Card;  
      IF k <> 0 THEN
         TempEquip.RemoveRow(RowNumber = i);
      ENDIF;
      i = i - 1;
   ENDWHILE;

   IF TempEquip.LastRow() = 0 THEN
      MESSAGE 'No Drop Back Valve connected to this valve.';
   ELSE
      SelectEquip.Clear();
      SelectEquip = TempEquip.Duplicate();  
      SelectMove.Clear();
      Selected.Equip = 0;
      Selected.SubstationName = '';
      Selected.Substation= 0;
      Selected.PrintId = '';
      Selected.EquipClassName = '';
      Selected.ObjectDescription = '';
      CurFrame.StatusText = 'Drop Back Valves for ' + Selected.EquipName;
      CurFrame.Flush();
      Selected.EquipName = '';
   ENDIF;
   Scenario = 0;   
END;


PROCEDURE ProcessSDSCards(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   n = INTEGER NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;

   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT; 
   CardMain = CardSDS;
   ActiveCardMain = CardSDS;
   ActiveCardName = VARCHAR(200) NOT NULL WITH DEFAULT;
   CardList = ARRAY OF INTEGEROBJECT;
   FMSCard = INTEGER NOT NULL WITH DEFAULT;  
   JobControlList       = ARRAY OF NewMoveCard;
   LastRow = INTEGER NOT NULL WITH DEFAULT; 
   NewCardClass = INTEGER NOT NULL WITH DEFAULT;  
   OutstandingMoves     = ARRAY OF Job;
   FMSList = ARRAY OF ListedCard;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SLCCardClass = INTEGER NOT NULL WITH DEFAULT; 
   Status = INTEGER NOT NULL WITH DEFAULT; 
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CardMain = NULL;
   CardMain = CardSDS.Create();
   CardMain.Card = Card;
   CardMain.TypeOfCard = TypeOfCard$Steam;  /*Must not be NSA card*/ 
   SELECT :CardMain.StationName =  StationName,
          :CardMain.Station =  Station,
          :CardMain.SoleAuthority = SoleAuthority,
          :CardMain.Status = Status,
          :CardMain.CardClass = CardClass
   FROM   SDS_Card 
   WHERE  Card = :Card;

   IF CardMain.SoleAuthority = FALSE THEN
      RETURN;
   ENDIF;
/*
** Look for Valves that are Source Positions for other Mains not already on this card.
*/
   DynamicWhereClause = 'G.Relationship = ' + VARCHAR(Interaction$SourcePosition) + ' AND ' +
                        'G.GroupingType = ' + VARCHAR(Type$Main) + ' AND ' + 
                        'G.Member IN (';
   FOR i = 1 TO MoveEquipList.LastRow() DO
      IF i > 1 THEN
         DynamicWhereClause = DynamicWhereClause + ',';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + VARCHAR(MoveEquipList[i].Value);
   ENDFOR;
   DynamicWhereClause = DynamicWhereClause + ') AND ' + 
                        ' G.Grouping = O.Object AND ' + 
                        ' G.Grouping NOT IN (SELECT Main FROM SDS_CardMain ' +
                        ' WHERE Card = ' + VARCHAR(:Card) + ')';    

   i = 1;
   CardMain.Main.Clear();
   SELECT DISTINCT 
          :CardMain.Main[i].Main = G.Grouping,
          :CardMain.Main[i].MainName = O.Name,
          :CardMain.Main[i].ISOValve = 0   /*Use as BOOLEAN temporarily */        
   FROM   Udb_Grouping G,
          Udb_Object O
   WHERE  :DynamicWhereClause
   BEGIN
      i = i + 1;
   END;   

   IF CardMain.Main.LastRow() = 0 THEN
      RETURN;
   ENDIF;

   CurFrame.StatusText = 'New Moves include additional Mains. Must add Mains to this card';
   CurFrame.Flush();
   CurFrame.ParentFrame.SendUserEvent (EventName = 'LoadActiveAndCard');
/*
** We have found other Main:
**   If current card is open, we simply add the other mains to this card and preload moves.
**   If current card is active, then we look at other mains for an active card.
**       If not on another activecard, must be added with preloads.  
**       If on another active card, cards must be combined.  
**   Use ISOValve field as BOOLEAN to mark if main is on another card. 
**   IN all cases when adding Main to card, end-user is prompted to confirm.
*/
   IF CardMain.Status = Card$Open THEN
/*
** Confirm each main to be added.
*/
      i = CardMain.Main.LastRow();
      WHILE i >= 1 DO
         IF Curframe.ConfirmPopup (MessageText = 'You have added a new move for an isolation valve on another Main. ' +
                     'Do you want to add this other Main ' +  CardMain.Main[i].MainName + ' to this card?' + HC_NEWLINE +
                     'OK= "YES, Add Main", CANCEL= "NO, Do not Add Main"') = PU_CANCEL THEN
            CardMain.Main.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;

      IF CardMain.Main.LastRow() = 0 THEN
         RETURN;
      ENDIF;

      RetCode = CardMain.AddMain();

      IF RetCode = PU_OK THEN
         CALLPROC DDB_COMMIT;
/*
** Preload moves for new mains
*/
         FOR i = 1 TO CardMain.Main.LastRow() DO
            RetCode = CALLPROC PreloadSDSMoves (Card = CardMain,
                                             NewMainOnly = CardMain.Main[i].Main,
                                             NewMainName = CardMain.Main[i].MainName);
            IF RetCode = PU_CANCEL THEN
               MESSAGE 'Main ' + CardMain.Main[i].MainName +
                    'was added, but moves were not preloaded.  ' +
                    'You will have to add moves manually.';
            ENDIF;
         ENDFOR;
      ENDIF;
      RETURN;  /*Done*/
   ENDIF;
/*
** Card is active
*/
   FOR i = 1 TO CardMain.Main.LastRow() DO
      SELECT :CardMain.Main[i].ISOValve = CM.Card   /*Set to Card ID if Main on an active card*/
      FROM   SDS_CardMain CM,
             SOA_ActiveCard C
      WHERE  CM.Card <> :Card AND
             CM.Main = :CardMain.Main[i].Main AND
             CM.Card = C.Card;
   ENDFOR;
/*
** Duplicate CardMain list and then filter lists so that one has new mains to be added and the other
** deals with active cards.
*/
   ActiveCardMain = CardMain.Duplicate();
   i = CardMain.Main.LastRow();
   WHILE i >= 1 DO
      IF CardMain.Main[i].ISOValve = 0 THEN  /* No Card */
         ActiveCardMain.Main.RemoveRow (RowNumber = i);
      ELSE   /*Active Card*/
         CardMain.Main.RemoveRow (RowNumber = i);
      ENDIF;
      i = i - 1;
   ENDWHILE;
/*
** Add Mains without active cards.
*/
   IF CardMain.Main.LastRow() > 0 THEN
/*
** Confirm each main to be added.
*/
      i = CardMain.Main.LastRow();
      WHILE i >= 1 DO
         IF Curframe.ConfirmPopup (MessageText = 'You have added a new move for an isolation valve on another Main. ' +
                     'Do you want to add this other Main ' +  CardMain.Main[i].MainName + ' to this card?' + HC_NEWLINE +
                     'OK= "YES, Add Main", CANCEL= "NO, Do not Add Main"') = PU_CANCEL THEN
            CardMain.Main.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;

      IF CardMain.Main.LastRow() > 0 THEN

         RetCode = CardMain.AddMain();

         IF RetCode = PU_OK THEN
            CALLPROC DDB_COMMIT;
/*
** Preload moves for new mains
*/
            FOR i = 1 TO CardMain.Main.LastRow() DO
               RetCode = CALLPROC PreloadSDSMoves (Card = CardMain,
                                             NewMainOnly = CardMain.Main[i].Main,
                                             NewMainName = CardMain.Main[i].MainName);
               IF RetCode = PU_CANCEL THEN
                  MESSAGE 'Main ' + CardMain.Main[i].MainName +
                    'was added, but moves were not preloaded.  ' +
                    'You will have to add moves manually.';
               ENDIF;
            ENDFOR;
         ENDIF;
      ENDIF;
   ENDIF;
/***
**** Procedure now ends here. Remainder is commented out and saved.
***/
END;    
/* 
** If Main is on an active card, then we combine cards and load outstanding moves.
** Card may be listed twice, need to include all mains on card.  Filter main list to a card list.
*
**** 02/13/08  This cability disabled because of concern over MSO numbers
****

   CardList.Clear();
   k = 0;
   IF ActiveCardMain.Main.LastRow() > 0 THEN
      FOR i = 1 TO ActiveCardMain.Main.LastRow() DO
         n = 1;
         WHILE n <= CardList.LastRow() DO 
            IF ActiveCardMain.Main[i].ISOValve = CardList[n].Value THEN
               ENDLOOP;
            ENDIF;
            n = n + 1;
         ENDWHILE;
         IF n > CardList.LastRow() THEN
            k = k + 1;
            CardList[k].Value = ActiveCardMain.Main[i].ISOValve;
         ENDIF;
      ENDFOR;
   ENDIF;

   i = CardList.LastRow();
   WHILE i >=1 DO
      ActiveCardName = '';
      SELECT :ActiveCardName = CardName
      FROM   SOA_ActiveCard 
      WHERE  Card = :CardList[i].Value;

      IF CurFrame.ConfirmPopup (MessageText = 
                  'You are adding a move for an isolation valve on another Main that has an active card. ' +
                  'Do you wish to combine Sole Authority card ' + 
                  ActiveCardName + ' with this card?  If not, cards will remain ' +
                  'separate with shared moves.') = PU_CANCEL THEN
         CardList.RemoveRow (RowNumber = i);
      ENDIF;       
      i = i - 1;
   ENDWHILE;

   ActiveCardMain = NULL;
   ActiveCardMain = CardSDS.Create();
   k = 1;
   FOR i = 1 TO CardList.LastRow() DO
       CurFrame.StatusText = 'Combining card ' + VARCHAR(i);
       CurFrame.Flush();
       ActiveCardMain.Card = Card;
       ActiveCardMain.SoleAuthority = TRUE;
       ActiveCardMain.Status = Card$Active;
     
       SELECT :ActiveCardMain.Main[k].Main = Main,       
              :ActiveCardMain.Main[k].MainName = MainName
       FROM   SDS_CardMain
       WHERE  Card = :CardList[i].Value
       BEGIN 
          k = k + 1;
       END;
/*
** Hide the card being transferred.
****
       RetCode = CALLPROC SOA_CardStatusUpd (Card = CardList[i].Value, Status = 99);

       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error cannot complete transfer of Card ' + VARCHAR(CardList[i].Value);
          CONTINUE;
       ELSE
          CALLPROC DDB_COMMIT;
       ENDIF;

       RetCode = ActiveCardMain.AddMain();
       IF RetCode = PU_OK THEN
          CALLPROC DDB_COMMIT;
/*
** Get all the outstanding jobs short of the work permit step for transfer to the current card.
****
          x = 1;
          SELECT DISTINCT
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Card = :Card,  
           OutstandingMoves[x].Substation = J.Substation,   
           JobControlList[x].Card = :Card,
           JobControlList[x].MoveEquipClass = JC.MoveEquipClass,
           JobControlList[x].StepHeading = JC.StepPair,
           JobControlList[x].StepLevel = 0,
           JobControlList[x].SwitchingItem = 0,
           JobControlList[x].PrintID = '',
           JobControlList[x].TypeOfCard = :TypeOfCard$Steam,
           JobControlList[x].Application = :Application$SDS
          FROM  SOA_Job J,
                SOA_JobControl JC
          WHERE JC.Card = :CardList[i].Value AND
                JC.StepPair < :StepHeading$WorkPermit AND
                JC.Job = J.Job AND
               (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
                J.Status IN ('','NIS') AND
                J.MoveCategory = :MoveCategory$Normal
          BEGIN 
             x = x + 1;
          END;

          FOR x = 1 TO OutstandingMoves.LastRow() DO         
/*
** Look for duplicate outstanding Job already on card.
****
             SELECT :OutstandingMoves[i].Job = -1
             FROM   SOA_JobControl JC,
                    SOA_Job J
             WHERE  JC.Card = :Card AND
                    JC.Job = J.Job AND
                    J.Equip = :OutstandingMoves[x].Equip AND
                    J.Substation = :OutstandingMoves[x].Substation AND  /*Main****
                    J.JobClass = :OutstandingMoves[x].JobClass AND
                   (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
                    J.Status = '' AND
                    J.MoveCategory = :MoveCategory$Normal;

             IF OutstandingMoves[i].Job = -1 THEN
                CONTINUE;
             ENDIF;

             RetCode = OutstandingMoves[x].InsertControl (
                  ControlEntry = JobControlList[x],
                  InitiatingCard = OutstandingMoves[x].Card,
                  SingleFeederOnly = TRUE);
             IF RetCode = PU_CANCEL THEN
                  CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert job control entry for outstanding move.' +
             '  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'NewMoves;  Unable to ' +
             'insert control entry for outstanding jobs.'
             );
             ENDIF; 
          ENDFOR;
          CALLPROC DDB_COMMIT;
/*
** Now formally close the old card.
****
          RetCode = CALLPROC SOA_CardStatusUpd(Card = CardList[i].Value,
                                           Status = Card$Closed, 
                                           TimeUpdate = 'now'
                                           );
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             Message 'Could not close old card ' + VARCHAR(CardList[i].Value);
          ENDIF;
/*
** Update SDS_Card also since we are not archiving Steam Cards, just using the active tables.
****
          RetCode = CALLPROC SDS_CardClosed (Card = CardList[i].Value,
                                    Status = Card$Closed, 
                                    Closed = 'now'
                                    );
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             CurFrame.Trace (Text = VARCHAR(Date('now')) + ': Warning- Unable to cascade card ' +
                                   'closure to SDS_Card ' + VARCHAR(CardList[i].Value));
          ENDIF;
          CALLPROC DDB_COMMIT;

          RetCode = SOA_ActivationControl (
                Card = CardList[i].Value,
                SwitchingItem = 0);
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Problem setting Control Card move values.';
          ELSE
             CALLPROC DDB_COMMIT;
          ENDIF;

          CONTINUE;
       ENDIF;
/*
** Only here due to an error.
****      
       RetCode = CALLPROC SOA_CardStatusUpd (Card = CardList[i].Value, Status = Card$Active);
       CALLPROC DDB_COMMIT;
       MESSAGE 'Error: Unable to combine cards.';
   ENDFOR;     

END;
***/

















							 *Default Item

							 *Default Item


