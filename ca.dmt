============================

	Name:            LoadCommonCard

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          LoadCommonCard
**
**  Date:       Author   Description
** ----------------------------------
**  O7/06/98	EM       Created
**  10/13/98	em	Added DisplayOnly parm so frame could be re-used from
**                      WorkPermitProtection frame.
**  11/20/98    em      Make sure switching item is active.
**  07/19/02    ysp     Merge: copied and modified from SOA
**  02/11/03    pkw	Send DB Event to Event Manager if move only exists on
**                      one active card.
**  03/17/03    em      Trace Window "J." error corrected.
**  09/10/03    pkw     Web-enable callup of common cards.
**  12/09/03    em      Display Control Card in Yellow. Set Control Card
**                      if necessary.
**  04/07/06    ysp     When setting the control to another card where 
**                      the equipment is controlled, make sure the switching item
**                      is active as well as the card.
**  09/21/07    em      For Steam, clear 'S' when we find it and it doesn't belong
**  07/25/14    em      For DSO, clear 'S' when we find it and it doesn't belong
**  06/14/18    em      Add Commit to Clear 'S' for Steam
*/
INITIALIZE 
(
   CommonJob		= INTEGER NOT NULL;  /*Passed Job*/
   DisplayOnly		= INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm*/

#  include StandardDeclarations
   ArchiveApp           = VARCHAR(4) NOT NULL; /*Job archived with this app*/
   ContrCard            = INTEGER NOT NULL WITH DEFAULT; /*Controlling Card*/
   ControlSet           = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   EquipJobList         = ARRAY OF INTEGEROBJECT;   /* Array of Job IDs */
   JobActivityID        = CHAR(1) NOT NULL WITH DEFAULT; /*Acitivity ID*/
   JobEquip             = INTEGER NOT NULL WITH DEFAULT; /*Job Equip*/
   NewCard              = INTEGER NOT NULL;  /*Return Card*/
   NewApplication       = VARCHAR(10) NOT NULL; /*Return Application*/
   OtherCard            = VARCHAR(200) NOT NULL;  /*Control Card name*/
   OtherApp             = VARCHAR(4) NOT NULL; /*Control Application*/
   SwitchingItem        = INTEGER NOT NULL; 
   SimpleAList          = ActiveList_ASE DEFAULT NULL;
) =
BEGIN
   IF DisplayOnly = TRUE THEN 
      FIELD(ActiveList_tf[*].CardName).Title = 'Card';
      FIELD(ActiveList_tf).CurBias = FB_VISIBLE;
   ELSE
      FIELD(ActiveList_tf[*].CardName).Title = 'Select Card to Load - Yellow has control';
      FIELD(ActiveList_tf).CurBias = FB_LANDABLE;
   ENDIF;

   IF SimpleAList IS NULL THEN
      SimpleAList = ActiveList_ASE.Create();
   ENDIF;   
 
   ContrCard = 0;
   ControlSet = FALSE; 
   SELECT :ContrCard = ControlCard,
          :JobEquip = Equip,
          :JobActivityID = ActivityIdentifier
   FROM   SOA_Job
   WHERE  Job = :CommonJob;  
    
   SimpleAList.Job = CommonJob;
   SimpleAList.CommonCard();
   
   IF SimpleAList.ReturnCode <> 0 THEN
      Message SimpleAList.ErrorMessage;
      RESUME NEXT;
   ENDIF;

   ActiveList_tf = SimpleAList.AL.Duplicate();
   SimpleAList = NULL;
/*
**  If only one card is shown, send DBEvent to Event Manager to clean up job.
*/   
   IF ActiveList_tf.LastRow() = 1 AND ArchiveCard = FALSE THEN

      IF JobActivityID = 'S' THEN

         IF CurrentApplication = Application$SDS OR CurrentApplication = Application$DSO THEN

            CALLPROC SOA_JobActivityIDUpd (Job = CommonJob, ActivityIdentifier = '');
            ControlText = UserName + ';' + VARCHAR(CommonJob) + ';';
            CALLPROC DDB_RAISEDBEVENT ( DBEventName = 'SOA_ReloadJob', 
                                        DBEventText = ControlText);
            CALLPROC DDB_COMMIT;
         ELSE

         SwitchingItem = 0;
         IF ActiveList_tf[1].Application = Application$SLC THEN
            REPEATED
            SELECT  :SwitchingItem = JC.SwitchingItem
            FROM     SOA_JobControl JC,
                     SOA_Job J 
            WHERE    JC.Job = :CommonJob AND
                     JC.Card = :ActiveList_tf[1].Card AND
                     JC.Job = J.Job AND
                     J.SwItemStatus = :Card$Active;
         ENDIF;

         ControlText = VARCHAR(ActiveList_tf[1].Card) + ';' +
                       VARCHAR(SwitchingItem) + ';';
         CALLPROC DDB_RaiseDBEvent (DBEventName = 'SOA_CheckSharedMoves',
                                    DBEventText = ControlText);
         CALLPROC DDB_COMMIT;

         ENDIF;
  
         MESSAGE 'This job only appears on one card.  ' +
                 'The ''S'' will be cleared.';
         
      ENDIF;
/*
** If Job not controlled by this card, then look to see if the card that 
** has it is active.  If it is active, then tell the user to go there to
** transfer control.
*/
      IF ContrCard <> ActiveList_tf[1].Card THEN

         i = 0;
         SELECT :i = AC.Card,
                :OtherApp = AC.Application,
                :OtherCard = AC.CardName
         FROM   SOA_ActiveCard AC
         WHERE  AC.Card = :ContrCard;

         IF i <> 0 THEN
            IF CurFrame.ConfirmPopUp (MessageText = 
                     'The equipment is controlled by ' + OtherApp +
                     ' ' + OtherCard + '.  You need to go to that card ' +
                     'to Transfer Control.  Go there now?') = PU_OK THEN 
 
               NewCard = ContrCard;
               NewApplication = OtherApp;
               RETURN PU_OK;
            ENDIF;
         ELSE
/*
** The card that has control is not active, so set the control to another 
** card where the equipment is controlled or to the current card.
*/
            i = 0;
            SELECT :i = J.ControlCard,
                   :OtherApp = AC.Application,
                   :OtherCard = AC.CardName
            FROM   SOA_Job J,
                   SOA_Job J2,
                   SOA_JobControl JC,
                   SOA_ActiveCard AC
            WHERE  J.Equip = :JobEquip AND
                  (J.RSComplete IS NULL OR
                   J.TOComplete IS NULL) AND
                   J.Status IN ('',:JobStatus$NIS) AND
                   J.MoveCategory = :MoveCategory$Normal AND
                   J.ControlCard <> :ContrCard AND
                   J.Job = JC.Job AND
                   JC.Card = AC.Card AND
                   AC.Card <> :ActiveList_tf[1].Card AND
                   AC.Card <> :ContrCard AND
                   AC.Card <> :NIS$Card AND
                   (JC.SwitchingItem = 0 OR 
                    (JC.SwitchingItem = J2.Job AND J2.SWItemStatus = :Card$Active));

            IF i <> 0 THEN
/*
** Set control to the other card and prompt user to go there.
*/          
               ContrCard = i;
               RetCode = CALLPROC SOA_JobControlCardUpd (
                          Job = CommonJob,
                          Card = ContrCard);
               IF RetCode = 0 THEN
                  CALLPROC DDB_COMMIT;
                  IF CurFrame.ConfirmPopUp (MessageText = 
                     'The equipment is controlled by ' + OtherApp +
                     ' ' + OtherCard + '.  You need to go to that card ' +
                     'to Transfer Control.  Go there now?') = PU_OK THEN 
 
                     NewCard = ContrCard;
                     NewApplication = OtherApp;
                     RETURN PU_OK;
                  ENDIF;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  MESSAGE 'Unable to reset card control for this move.  ' +
                       'Contact Tech Support to have them update Job=' +
                       VARCHAR(CommonJob) + ' to = ' +
                       VARCHAR(ContrCard);
               ENDIF;

            ELSE
/*
** Set the Control Card equal to the current card
*/            
               RetCode = CALLPROC SOA_JobControlCardUpd (
                          Job = CommonJob,
                          Card = ActiveList_tf[1].Card);
               IF RetCode = 0 THEN
                  CALLPROC DDB_COMMIT;
                  MESSAGE 'This card has been given control of this move.';
                  IF CurrentApplication = Application$FMS THEN
                     FCFrame.SendUserEvent (EventName = 'load_jobs');
                  ELSE
                     SOAFrame.SendUserEvent (EventName = 'LoadJobs');
                  ENDIF;
               ELSE
                  CALLPROC DDB_ROLLBACK;
                  MESSAGE 'Unable to reset card control for this move.  ' +
                       'Contact Tech Support to have them update Job=' +
                       VARCHAR(CommonJob) + ' to = ' +
                       VARCHAR(ActiveList_tf[1].Card);
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;
      RETURN PU_CANCEL;   
   ENDIF;
   
   IF ActiveList_tf.LastRow() = 0 THEN

      IF DisplayOnly = FALSE THEN
         MESSAGE 'This move no longer exists on any Active Cards.';
         RETURN PU_CANCEL;
      ELSE
/*
** Move may appear on closed cards.
*/
         i = 1;
         REPEATED
         SELECT  :ActiveList_tf[i].Application = J.Application,
                 :ActiveList_tf[i].CardName = TC.FeederNames
         FROM    SOA_ArchiveJob J,
                 TFMS_ArchiveCard TC
         WHERE   J.Job = :CommonJob AND
                 J.Card = TC.Card
         UNION
         SELECT  J.Application,
                 C.CardName
         FROM    SOA_ArchiveJob J,
                 SOA_Card C
         WHERE   J.Job = :CommonJob AND
                 J.Application = :Application$SLC AND
                 J.Card = C.Card
         UNION
         SELECT  J.Application,
                 FC.FeederName
         FROM    SOA_ArchiveJob J,
                 FMS_ArchiveCard FC
         WHERE   J.Job = :CommonJob AND
                 J.Card = FC.Card
         BEGIN
            i = i + 1;
         END;      
         CALLPROC DDB_ROLLBACK; 
         RESUME;
      ENDIF;

   ELSEIF ArchiveCard = FALSE THEN
/*
** Set the Control Card in the array 
*/
      FOR i = 1 TO ActiveList_tf.LastRow() DO
         IF ActiveList_tf[i].Card = ContrCard THEN
            FIELD(ActiveList_tf[i].CardName).BgColor = CC_YELLOW;
            ControlSet = TRUE;
         ENDIF;
      ENDFOR;
   ENDIF;
/*
** No Card has control.  So we pick one and set it.  Must set for all active
** moves on this equipment.
*/
   IF ControlSet = FALSE AND ArchiveCard = FALSE THEN
      ContrCard = 0;
      FOR i = 1 TO ActiveList_tf.LastRow() DO
         IF ActiveList_tf[i].Application <> Application$SLC THEN 
            FIELD(ActiveList_tf[i].CardName).BgColor = CC_YELLOW;
            ContrCard = ActiveList_tf[i].Card;
            ENDLOOP;
         ENDIF;
      ENDFOR;
      
      IF ContrCard = 0 THEN
         MESSAGE 'Unable to adequately reset card control for this move.  ' +
                 'Contact Tech Support to have them update Job=' +
                 VARCHAR(CommonJob) + '  value';
      ELSE
         i = 1;
         EquipJobList.Clear();
         SELECT :EquipJobList[i].Value = J.Job
         FROM   SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC
         WHERE  J.Equip = :JobEquip AND
               (J.RSComplete IS NULL OR
                J.TOComplete IS NULL) AND
                J.Status IN ('',:JobStatus$NIS) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.Job = JC.Job AND
                JC.Card = AC.Card AND
                AC.Card <> :ContrCard AND
                AC.Card <> :NIS$Card
         BEGIN
            i = i + 1;
         END;
          
         FOR i = 1 TO EquipJobList.LastRow() DO
            RetCode = CALLPROC SOA_JobControlCardUpd (
                          Job = EquipJobList[i].Value,
                          Card = ContrCard);
            IF RetCode = 0 THEN
               CALLPROC DDB_COMMIT;
            ELSE
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Unable to reset card control for this move.  ' +
                       'Contact Tech Support to have them update Job=' +
                       VARCHAR(EquipJobList[i].Value) + ' to = ' +
                       VARCHAR(ContrCard);
            ENDIF;
         ENDFOR;
      ENDIF;
   ENDIF;
END;            
 


ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'FMS_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return PU_CANCEL;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN

   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');

END;


ON CHILDENTRY ActiveList_tf =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   NewCard = ActiveList_tf[].Card;
   NewApplication = ActiveList_tf[].Application;
   RETURN PU_OK;
END;


ON CLICK Cancel_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN PU_CANCEL;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

