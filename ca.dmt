	Name:            UpdateAllCardEquip

/* 
**      Copyright c 1993 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  4GL Procedure:  UpdateAllCardEquip 
** 
**  Modification log: 
** 
**  Date:  	Version		Description 
** -------------------------------------------------- 
**  JAN 93      adl          author  
**  02/12/93    em           changed to handle all jobs regardless of card 
**  03/17/93    em           set groundon parm and colors so we don't
**                           have to look at colored jobs on dropped eqp
**  05/13/93    em           deal with jobs that increment dead move count 
**                           on takeout
**  06/17/94    mts          Added EquipClass to criteria for select from FMS_JobAction.
**  06/27/94    hlf          add criteria to select from fms_jobaction
**  07/07/94    mts          selections from fms_jobaction now look at equipclass heiarchy.
**  10/26/94    hlf          Modify checks/actions to look at moveequipclass
**  08/24/02    ysp          Merge: Use common job class. Pass back a list impacted cards.
**  01/16/03    em           Restructured and added deadmovecount procedure call
**  02/05/03    em           Was not passing all parms to SOA_UpdateJob
**  02/07/03    em           Don't pass zero to SOA_UpdateJob procedure
**  11/20/07    ysp          select to/rs operators from the job table so that they can be
**                           passed into SOA_UpdateJob
**  03/28/11    em           Updated for 3G
*/ 
PROCEDURE UpdateAllCardEquip 
(   
    Equip = INTEGER;      /* parameter = equipment */ 
    ImpactedCards = ARRAY OF IntegerObject; /* Passed back to calling frame*/

    CurrentJob = ARRAY OF Job;     /* current job record */ 
    CurrentCard = ARRAY OF FMS_Card;   /* card's where job resides */
    status = INTEGER;         /* return status of procedure call */ 
    i = INTEGER NOT NULL WITH DEFAULT; 
    j = INTEGER NOT NULL WITH DEFAULT; 
    SelectCount = INTEGER NOT NULL WITH DEFAULT;
    ProcessedJobs = ARRAY OF IntegerObject;
) = 
BEGIN 
    i = 1;
    SELECT 
       :CurrentJob[i].Job        = J.Job, 
       :CurrentJob[i].TOIssued   = J.TOIssued,
       :CurrentJob[i].TOComplete = J.TOComplete,
       :CurrentJob[i].TOOperator = J.TOOperator,
       :CurrentJob[i].RSIssued   = J.RSIssued,
       :CurrentJob[i].RSComplete = J.RSComplete,
       :CurrentJob[i].RSOperator = J.RSOperator,
       :CurrentJob[i].Grounds    = J.Grounds,
       :CurrentJob[i].JobClass   = J.JobClass,
       :CurrentJob[i].MoveType   = J.MoveType,
       :CurrentCard[i].Application= C.Application,
       :CurrentCard[i].TypeOfCard = C.TypeOfCard,
       :ImpactedCards[i].Value    = C.Card
    FROM
       SOA_Card C, 
       SOA_JobControl JC,
       SOA_Job  J 
    WHERE 
       C.Status < :Card$Closed  AND 
       C.Card   =  JC.Card       AND 
       JC.Job   =  J.Job  AND
       J.Equip  =  :Equip AND 
       J.Status = ''
    BEGIN 
       IF CurrentCard[i].Application = Application$FMS THEN
          j = 1;
          SELECT :CurrentCard[i].Object[j].Object = CTO.Object
          FROM    TFMS_CardToObject CTO
          WHERE   CTO.Card = :ImpactedCards[i].Value AND
                  CTO.Type = :Type$Feeder
          BEGIN
             j = j + 1;
          END;
       ENDIF;

       i = i + 1;
    END;

    FOR i = 1 TO CurrentJob.LastRow() DO 
       CurrentJob[i].Response = 'Equipment Dropped'; 
       /* Same jobs may show up in multiple cards. Once a job is processed, 
       ** we don't need to update it again.
       */ 
       j = 1;
       WHILE j <= ProcessedJobs.LastRow() DO
          IF CurrentJob[i].Job = ProcessedJobs[j].Value THEN
             ENDLOOP;
          ELSE
             j = j + 1;
          ENDIF;
       ENDWHILE;

       IF j > ProcessedJobs.LastRow() THEN
          ProcessedJobs[j].Value = CurrentJob[i].Job;
       ELSE
          CONTINUE;
       ENDIF;

       /* If time field is NULL, then set to blank: */ 
       IF (CurrentJob[i].TOIssued IS NULL) THEN 
          CurrentJob[i].TOIssued = ' '; 
       ENDIF; 
       IF (CurrentJob[i].TOComplete IS NULL) THEN 
          CurrentJob[i].TOComplete = ' '; 
       ENDIF; 
       IF (CurrentJob[i].RSIssued IS NULL) THEN 
          CurrentJob[i].RSIssued = ' '; 
       ENDIF; 
       IF (CurrentJob[i].RSComplete IS NULL) THEN 
          CurrentJob[i].RSComplete = ' '; 
       ENDIF; 
       CurrentJob[i].GroundOn = NULL;
       IF CurrentJob[i].Grounds = 0 THEN
          CurrentJob[i].Grounds = NULL;
       ENDIF;
       CurrentJob[i].MoveFGColor = CC_BLACK;

       /* Update the job on current card into the db: */ 
       status = CALLPROC SOA_UpdateJob 
                 ( Job        = CurrentJob[i].Job,  
                   Response   = CurrentJob[i].Response, 
                   Status     = Job$Xfer, 
                   TOIssued   = CurrentJob[i].TOIssued, 
                   TOComplete = CurrentJob[i].TOComplete, 
                   TOOperator = CurrentJob[i].TOOperator, 
                   RSIssued   = CurrentJob[i].RSIssued, 
                   RSComplete = CurrentJob[i].RSComplete,
                   RSOperator = CurrentJob[i].RSOperator,
                   GroundOn   = CurrentJob[i].GroundOn,
                   Grounds    = CurrentJob[i].Grounds,
                   MoveFGColor= CurrentJob[i].MoveFGColor
                 ); 
       IF (status <> 0) THEN 
          CALLPROC DDB_ROLLBACK; 
          MESSAGE 'Error removing jobs for dropped equipment.'; 
          RETURN(PU_CANCEL);
       ENDIF; 
       CALLPROC DDB_COMMIT;
       /*
       **   If this is an outstanding dead move, adjust dead move to count
       */
       IF CurrentJob[i].MoveType = 'Dead' THEN

          IF CurrentJob[i].TOComplete IS NOT NULL AND
               CurrentJob[i].RSComplete IS NULL         THEN

          /* did the job increment the Feeder Dead Move Status Count...*/
          SelectCount = 0;
          SELECT  :SelectCount = Count(*)
          FROM    FMS_JobAction J
          WHERE   J.JobClass = :CurrentJob[i].JobClass AND
                  J.EquipClass = :CurrentJob[i].MoveEquipClass AND
                  StepPair = :CurrentJob[i].StepPair AND
                  TypeofCard = :CurrentCard[i].TypeofCard AND
                  Action   = :JobAction$Increment AND
                  TORS     = 0 AND                        /*TakeOut*/
                  FeederEquip = 1 AND                     /*Feeder*/
                  Status   = :Status$DeadMove;

          IF SelectCount > 0 THEN
              /* It's necessary to do the dead move adjustment work for both feeders...*/
             FOR j = 1 TO CurrentCard[i].Object.LastRow() DO
               status = CALLPROC FMS_ObjStatTimeSetUpd(
                                Object = CurrentCard[i].Object[j].Object,
                                Status = Status$DeadMove,
                                increment = -1,
                                TimeSet = date('now'));
               IF status <> 0 THEN
                  CALLPROC DDB_ROLLBACK; 
                  MESSAGE 'Error setting Dead Move counts for feeder and card.';
               ENDIF; 
             ENDFOR;
          ENDIF;
/*
** Update Card Header if necessary
*/
          status = CALLPROC FMS_DeadMoveCount (Card = ImpactedCards[i].Value);
          IF status <> 0 THEN
                  CALLPROC DDB_ROLLBACK; 
                  MESSAGE 'Error setting Dead Move counts for feeder and card.';
          ENDIF; 
          CALLPROC DDB_COMMIT;

          ENDIF;
       ENDIF;
    ENDFOR; 
    
    FCFrame.SendUserEvent (EventName = 'load_jobs');
    RETURN(PU_OK);
END; 

