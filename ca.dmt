Application Component Report
============================

	Name:            PromptReturnRelays

/**
 **
 **  Copyright c 1996 Unified Information, Inc.  All rights reserved.
 **
 **  Unified Information, Inc. proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Unified Information, Inc.
 **
 **
 **  Application:    FeederCard
 **  Frame:          PromptReturnRelays
 **
 **  Modification log:
 **
 **  Date:     Version   Description 
 ** --------------------------------------------------        
 **  09/14/01  em    Created; screen based on FMS_RelaySummary
 **  10/09/01  em    Don't save other relays if 46T did not operate.
 **  11/01/02  em    Job to JIP. 
 **  12/23/02  ysp   Explicit soa_logins to log card relays update.
 **  02/20/04  em    During automatic execution, complete processing auto
 **  10/16/06  em    Added support for 67A/B/C/N Basler Relay Targets
 **  03/27/09  ysp   add download To feederboard (FSS)
 **  04/03/09  ysp   Call Relay Entry screen if no relay is returned.
 **  05/28/09  em    Use selected FMS Card instead of JIP.Card which may be an SLC card.
 **  08/08/19  em    Highlight 46T if operated.
 **  02/11/20  pkw   Update to support new format in fms_relaysummary
 **  04/22/22  em    Apparent bug in OtherDistributionRelay index found during test
 **/

INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    Card = INTEGER NOT NULL;                   /*Related FMS Card*/ 
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; /* Related Feeder */
    i = integer NOT NULL With DEFAULT;         /*Local: Temporary counter */  
    k = integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */
    RelayComment = VARCHAR(60) NOT NULL WITH DEFAULT; /* Card Relays Field */
    RetCode = INTEGER NOT NULL WITH DEFAULT;    /* Return Code */
    RR 	    = ReturnRelay;                      /* ReturnRelay Class*/
    SimpleCard = FMS_Card_ASE DEFAULT NULL; /* Enables use of class methods */
    TIDistributionRelays = ARRAY OF CAC_Relay;
    OtherDistributionRelays = ARRAY OF CAC_Relay;
) =
BEGIN
/*
** Check if ReturnRelays information is being sent back from a returned
** Operating Order. If so, prepare display.  Else RETURN.
*/
   Card = 0;
   REPEATED
   SELECT DISTINCT
          :Card = C.Card,
          :FeederName = C.FeederName
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;
   IF Card = 0 THEN
      CALLPROC TraceError (UserMessage =
                 'PromptReturnRelays called from a non-FMS card.',
                           TraceMessage =
                 'PromptReturnRelays called from a non-FMS card.'
                           );
      RETURN PU_OK;
   ENDIF;

   RR.Job = 0;
   SELECT  :RR.RelayComment = RelayComment
          ,:RR.Job = Job
          ,:RR.RT5051AI = RT5051AI
          ,:RR.RT5051AT = RT5051AT
          ,:RR.RT5051ATS = RT5051ATS
          ,:RR.RT5051BI = RT5051BI
          ,:RR.RT5051BT = RT5051BT
          ,:RR.RT5051BTS = RT5051BTS
          ,:RR.RT5051CI = RT5051CI
          ,:RR.RT5051CT = RT5051CT
          ,:RR.RT5051CTS = RT5051CTS
          ,:RR.RT5051NI = RT5051NI
          ,:RR.RT5051NT = RT5051NT
          ,:RR.RT5051NTS = RT5051NTS
          ,:RR.RT67AI = RT67AI
          ,:RR.RT67AT = RT67AT
          ,:RR.RT67ATS = RT67ATS
          ,:RR.RT67BI = RT67BI
          ,:RR.RT67BT = RT67BT
          ,:RR.RT67BTS = RT67BTS
          ,:RR.RT67CI = RT67CI
          ,:RR.RT67CT = RT67CT
          ,:RR.RT67CTS = RT67CTS
          ,:RR.RT67NI = RT67NI
          ,:RR.RT67NT = RT67NT
          ,:RR.RT67NTS = RT67NTS
          ,:RR.RT46TO = RT46TO
          ,:RR.RT46TTS = RT46TTS
   FROM    IR_ReturnRelay
   WHERE   Job = :JIP.Job;

   IF RR.Job = 0 THEN
/*
** No Relay Information Returned

      CALLPROC TraceError (UserMessage =
                 'No Relay Information has been returned from Rapid Restore.',
                           TraceMessage =
                 'PromptReturnRelays: No Relay Information has been returned ' +
                 'from the RR Interface.'
                           );
      RETURN (PU_OK);
*/
      IF SimpleCard IS NULL THEN
         SimpleCard = FMS_Card_ASE.Create();
      ENDIF;
    
      SimpleCard.Card = Card;
      SimpleCard.ArchiveCard = False;
    
      SimpleCard.LoadCard();
   
      IF SimpleCard.ReturnCode <> 0 THEN
         Message SimpleCard.ErrorMessage;
         RETURN (PU_OK);
      ENDIF;

      CALLFRAME FMS_RelaySummary(C = SimpleCard.C.Duplicate(), 
                                 ArchiveCard = False) WITH CurMode = FM_Update;
      SimpleCard = NULL;
      RETURN;
   ENDIF;
/*
** Build the relay arrays manually for display on the screen.
*/
   i = 0;
   k = 0;
   TIDistributionRelays.Clear(); 
   OtherDistributionRelays.Clear();
   relay_comment = RR.RelayComment;

   IF RR.RT5051AT = 'YES' OR RR.RT5051AI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$5051A;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT5051ATS;
      IF RR.RT5051AI = 'YES' AND RR.RT5051AT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT5051AT = 'YES' AND RR.RT5051AI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT5051AT = 'YES' AND RR.RT5051AI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT5051BT = 'YES' OR RR.RT5051BI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$5051B;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT5051BTS;
      IF RR.RT5051BI = 'YES' AND RR.RT5051BT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT5051BT = 'YES' AND RR.RT5051BI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT5051BT = 'YES' AND RR.RT5051BI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT5051CT = 'YES' OR RR.RT5051CI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$5051C;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT5051CTS;
      IF RR.RT5051CI = 'YES' AND RR.RT5051CT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT5051CT = 'YES' AND RR.RT5051CI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT5051CT = 'YES' AND RR.RT5051CI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT5051NT = 'YES' OR RR.RT5051NI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$5051N;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT5051NTS;
      IF RR.RT5051NI = 'YES' AND RR.RT5051NT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT5051NT = 'YES' AND RR.RT5051NI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT5051NT = 'YES' AND RR.RT5051NI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT67AT = 'YES' OR RR.RT67AI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$67A;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT67ATS;
      IF RR.RT67AI = 'YES' AND RR.RT67AT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT67AT = 'YES' AND RR.RT67AI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT67AT = 'YES' AND RR.RT67AI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT67BT = 'YES' OR RR.RT67BI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$67B;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT67BTS;
      IF RR.RT67BI = 'YES' AND RR.RT67BT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT67BT = 'YES' AND RR.RT67BI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT67BT = 'YES' AND RR.RT67BI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT67CT = 'YES' OR RR.RT67CI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$67C;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT67CTS;
      IF RR.RT67CI = 'YES' AND RR.RT67CT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT67CT = 'YES' AND RR.RT67CI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT67CT = 'YES' AND RR.RT67CI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT67NT = 'YES' OR RR.RT67NI = 'YES' THEN
      i = i + 1;
      TIDistributionRelays[i].RelayType = Relay$67N;
#INCLUDE BuildRelayArray
      TIDistributionRelays[i].TimeStamp = RR.RT67NTS;
      IF RR.RT67NI = 'YES' AND RR.RT67NT = 'NO' THEN
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Instantaneous;
      ELSEIF RR.RT67NT = 'YES' AND RR.RT67NI = 'NO' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].Operation = RelayOp$Time;
      ELSEIF RR.RT67NT = 'YES' AND RR.RT67NI = 'YES' THEN
         TIDistributionRelays[i].GenericInt2 = TRUE;
         TIDistributionRelays[i].GenericInt1 = TRUE;
         TIDistributionRelays[i].Operation = 
                                 RelayOp$Time + RelayOp$Instantaneous;
      ENDIF;
   ENDIF;

   IF RR.RT46TO <> 'NO' THEN
      k = k + 1;
      OtherDistributionRelays[k].RelayType = Relay$46T;
      OtherDistributionRelays[k].FeederName = FeederName;
      OtherDistributionRelays[k].Equip = JIP.Equip;
      OtherDistributionRelays[k].EquipName = JIP.EquipName;
      OtherDistributionRelays[k].EquipClass = JIP.EquipClass;
      OtherDistributionRelays[k].EquipClassName = JIP.EquipClassName;
      OtherDistributionRelays[k].RelayName = '';

      REPEATED
      SELECT :OtherDistributionRelays[k].RelayTypeName = RT.RelayTypeName,
             :OtherDistributionRelays[k].RelayClass = RT.Type,
             :OtherDistributionRelays[k].RelayClassName = T.Name
      FROM   CAC_RelayTypes RT,
             Udb_Type T
      WHERE  RT.RelayType = :OtherDistributionRelays[k].RelayType AND
             RT.Type = T.Type;

      OtherDistributionRelays[k].TimeStamp = RR.RT46TTS;
      OtherDistributionRelays[k].Operation = RelayOp$Normal;
      OtherDistributionRelays[k].Operated = TRUE;
   ENDIF;   
   /*
   **  Combine relays into tablefield
   */
   FeederRelays.Clear();
   FOR i = 1 TO TIDistributionRelays.LastRow DO
      FeederRelays[i] = TIDistributionRelays[i].Duplicate();
   ENDFOR;
   
   k = FeederRelays.LastRow;
   FOR i = 1 TO OtherDistributionRelays.LastRow DO
      k = k + 1;
      FeederRelays[k] = OtherDistributionRelays[i].Duplicate();
      FIELD(FeederRelays[k].TimeStamp).BgColor = CC_YELLOW;
      FIELD(FeederRelays[k].RelayTypeName).BgColor = CC_YELLOW;
      FIELD(FeederRelays[k].Operated).BgColor = CC_YELLOW;
   ENDFOR;
  
   IF AutomaticExecution = TRUE THEN
      Curframe.SendUserEvent (EventName = 'MakeInvisible');
   ENDIF;
END;


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;


ON USEREVENT 'CompleteProcessing',
ON CLICK OK_btn = 
BEGIN
/*
** Loop through the array and use existing procedures to insert the 
** Returned Relay information.
*/
   FOR i = 1 TO TIDistributionRelays.LastRow() DO

      RetCode = CALLPROC CAC_InsertRelayOpForAll( 
                   CardType = Type$FMSApp,
                   Card = Card,
                   Line = -1,
                   FeederName = TIDistributionRelays[i].FeederName,
                   Equip = TIDistributionRelays[i].Equip,
                   EquipName = TIDistributionRelays[i].EquipName,
                   EquipClass = TIDistributionRelays[i].EquipClass,
                   EquipClassName = TIDistributionRelays[i].EquipClassName,
                   RelayTypeName = TIDistributionRelays[i].RelayTypeName,
                   RelayType =  TIDistributionRelays[i].RelayType,
                   RelayClass = TIDistributionRelays[i].RelayClass,
                   RelayClassName = TIDistributionRelays[i].RelayClassName,
                   RelayName = TIDistributionRelays[i].RelayName,
                   Operation = TIDistributionRelays[i].Operation,
                   TimeStamp = TIDistributionRelays[i].TimeStamp
                   );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
                 'ERROR: Unable to completely save Returned Relay ' +
                 'Information.  Information may have to be entered manually.',
                              TraceMessage =
                 'PromptReturnRelays1: ' +
                 'Unable to completely save Returned Relay ' +
                 'Information.  ' 
                               );
      ENDIF;
     
   ENDFOR;
  
   IF RR.RT46TO <> 'NO' THEN 
      FOR i = 1 TO OtherDistributionRelays.LastRow() DO
         RetCode = CALLPROC CAC_InsertRelayOpForAll(
                   CardType = Type$FMSApp, 
                   Card = Card,
                   Line = -1,
                   FeederName = OtherDistributionRelays[i].FeederName,
                   Equip = OtherDistributionRelays[i].Equip,
                   EquipName = OtherDistributionRelays[i].EquipName,
                   EquipClass = OtherDistributionRelays[i].EquipClass,
                   EquipClassName = OtherDistributionRelays[i].EquipClassName,
                   RelayTypeName = OtherDistributionRelays[i].RelayTypeName,
                   RelayType =  OtherDistributionRelays[i].RelayType,
                   RelayClass = OtherDistributionRelays[i].RelayClass,
                   RelayClassName = OtherDistributionRelays[i].RelayClassName,
                   RelayName = OtherDistributionRelays[i].RelayName,
                   Operation = OtherDistributionRelays[i].Operation,
                   TimeStamp = OtherDistributionRelays[i].TimeStamp
                   );  
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
                 'ERROR: Unable to completely save Returned Relay ' +
                 'Information.  Information may have to be entered manually.',
                              TraceMessage =
                 'PromptReturnRelays2: ' +
                 'Unable to completely save Returned Relay ' +
                 'Information.  ' 
                                 );
         ENDIF;
      ENDFOR;
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
** Update Card Relay Comment field by concatenating new Realy Comment with 
** any old one.
*/
   IF RR.RelayComment <> '' THEN
      SELECT :RelayComment = C.Relays
      FROM   FMS_Card C
      WHERE  C.Card = :Card;

      CALLPROC FMS_CardRelaysUpd (
                NewRelays = SQUEEZE(RR.RelayComment + '; ' + RelayComment),
                Card = Card);
      CALLPROC DDB_COMMIT;
 
      CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = RelayComment,
                 New  = SQUEEZE(RR.RelayComment + '; ' + RelayComment));
       CALLPROC DDB_COMMIT;
   ENDIF;  
/*
** Delete Returned Relay information from the interface table before exiting.
*/
   RetCode = CALLPROC IR_ReturnRelayDel (Job = JIP.Job);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                 'ERROR: IR_ReturnRelayDel procedure failed.  ' +
                 'Contact tech support so that this procedure can ' +
                 'be executed for Job=' + VARCHAR(JIP.Job) + '.',
                              TraceMessage =
                 'PromptReturnRelays: ' +
                 'IR_ReturnRelayDel procedure failed.  ' +
                 'Contact tech support so that this procedure can ' +
                 'be executed for Job=' + VARCHAR(JIP.Job) + '.'
                                 );
   ENDIF;
/*
** download relay to feederboard (FSS)
*/   
   CALLPROC DownloadRelayToFSS(Card = Card, ArchiveCard = FALSE);

   RETURN(PU_OK);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

