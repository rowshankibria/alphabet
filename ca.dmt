/*
**  Application:    FeederCard
**  Frame:          UpdateTime
**
**  Modifications:
**   10/22/96  pkw   Created to support update of estimated times
**   07/11/00  pkw   Because we are not setting esttimecomplete anymore, it is 
**                   possible for blank time to be passed in here. If blank 
**                   time is passed in, default passed time to current time.
*/
INITIALIZE
(
    PassedTime = DATE;    
    PassedMessage = VARCHAR(60) NOT NULL WITH DEFAULT;
) =
BEGIN

    NewTime = PassedTime;

    IF NewTime = '' THEN
       NewTime = date('now');
    ENDIF;

    Field(Description).TextValue = PassedMessage;
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN
    IF NewTime = '' OR NewTime IS NULL THEN
       Message 'You may not clear an existing timestamp.';
       NewTime = PassedTime;

       IF NewTime = '' THEN
          NewTime = date('now');
       ENDIF;

       RESUME;
    ENDIF;
    PassedTime = NewTime;
    RETURN (PU_OK);
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =
BEGIN
	RETURN (PU_CANCEL);
END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

