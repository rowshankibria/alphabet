**  Date:    Version     Description 
** -------------------------------------------------- 
**  05/13/15  ysp        created
*/ 
INITIALIZE (   
   SelectedEquip = ARRAY OF Equipment;       // returned
   SelectedItems = ARRAY OF CardLog;         // returned
) = 
DECLARE
#   include StandardDeclarations	   
 
   k = INTEGER NOT NULL WITH DEFAULT;   
BEGIN 
   IF SelectEquip.LastRow = 0 THEN
      FIELD(SelectEquip).CurBias = FB_INVISIBLE;
   ENDIF;
   
   IF SelectItem.LastRow = 0 THEN
      FIELD(SelectItem).CurBias = FB_INVISIBLE;
   ENDIF;
END; 

ON ChildEntry SelectEquip = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
 
   i = FIELD(SelectEquip).CurRow;
   IF FIELD(SelectEquip[i].EquipName).IsReverse = FALSE THEN
      FIELD(SelectEquip[i].EquipClassName).IsReverse = TRUE;
      FIELD(SelectEquip[i].EquipName).IsReverse = TRUE;      
   ELSE
      FIELD(SelectEquip[i].EquipClassName).IsReverse = FALSE;
      FIELD(SelectEquip[i].EquipName).IsReverse = FALSE;
   ENDIF;
   CurFrame.InputFocusField = FIELD(OK_Btn);
END; 

ON ChildEntry SelectItem = 
BEGIN 
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
 
   i = FIELD(SelectItem).CurRow;
   IF FIELD(SelectItem[i].Item).IsReverse = FALSE THEN
      FIELD(SelectItem[i].Item).IsReverse = TRUE;
   ELSE
      FIELD(SelectItem[i].Item).IsReverse = FALSE;
   ENDIF;
   CurFrame.InputFocusField = FIELD(OK_Btn);
END; 

/* 
**  Handle OK click  
*/ 
ON Click OK_Btn = 
BEGIN 
   FOR i = 1 TO SelectEquip.LastRow DO
      IF FIELD(SelectEquip[i].EquipName).IsReverse = TRUE THEN
         SelectedEquip.InsertRow(RowObject = SelectEquip[i]);
      ENDIF;
   ENDFOR;
   
   FOR i = 1 TO SelectItem.LastRow DO
      IF FIELD(SelectItem[i].Item).IsReverse = TRUE THEN
         SelectedItems.InsertRow(RowObject = SelectItem[i]);
      ENDIF;
   ENDFOR;

   IF SelectedEquip.LastRow > 0 OR SelectedItems.LastRow > 0 THEN
      RETURN (PU_OK);
   ELSE
      RETURN (PU_CANCEL);
   ENDIF;
END;

/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
BEGIN 
   RETURN (PU_CANCEL); 
END;

