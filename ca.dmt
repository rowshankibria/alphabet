	Name:            ArraySearch

/*
**
**      Copyright c 1999 Alstom ESCA Corporation.  All rights reserved.
**
**      Alstom ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Alstom ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ArraySearch
**
**  Date:       Author   Description
** ----------------------------------
**  02/17/99	EM       Created
**                       Receives a sorted array of IntegerObject and a Target
**                       Object.  Does Bisection search until finding target.
**                       Returns TRUE (target object found) or FALSE (target
**                       object not found).
**
*/
PROCEDURE ArraySearch (
   SearchArray		= ARRAY OF INTEGEROBJECT; /*Parameter*/
   TargetObject		= INTEGER NOT NULL;  /*Parameter*/   

   FirstIndex           = INTEGER NOT NULL;  /*Beginning Index*/
   MidIndex		= INTEGER NOT NULL;  /*Middle Index*/
   LastIndex            = INTEGER NOT NULL;  /*End Index*/
   ContinueSearch       = INTEGER NOT NULL;  /*BOOLEAN*/
   ObjectFound          = INTEGER NOT NULL;  /*BOOLEAN*/
) =
BEGIN
   LastIndex = SearchArray.LastRow();
   IF LastIndex = 0 THEN
      RETURN FALSE;
   ELSEIF LastIndex = 1 THEN
      IF TargetObject = SearchArray[1].Value THEN
         RETURN TRUE;
      ELSE
         RETURN FALSE;
      ENDIF;
   ELSEIF LastIndex = 2 THEN
      IF TargetObject = SearchArray[1].Value OR 
         TargetObject = SearchArray[2].Value THEN
         RETURN TRUE;
      ELSE
         RETURN FALSE;
      ENDIF;
   ENDIF;

   FirstIndex = 1;
   ContinueSearch = TRUE;
   ObjectFound = FALSE;

   WHILE ContinueSearch = TRUE DO
      MidIndex = (FirstIndex + LastIndex) / 2;
      IF TargetObject = SearchArray[MidIndex].Value THEN
         ObjectFound = TRUE;
         ContinueSearch = FALSE;
      
      ELSEIF SearchArray[MidIndex].Value < TargetObject THEN
         IF LastIndex - MidIndex <= 1 THEN
            IF TargetObject = SearchArray[LastIndex].Value THEN
               ObjectFound = TRUE;
            ENDIF;
            ContinueSearch = FALSE;
         ELSE
            FirstIndex = MidIndex;
         ENDIF;

      ELSEIF SearchArray[MidIndex].Value > TargetObject THEN
         IF MidIndex - FirstIndex <= 1 THEN
            IF TargetObject = SearchArray[FirstIndex].Value THEN
               ObjectFound = TRUE;
            ENDIF;
            ContinueSearch = FALSE;
         ELSE
            LastIndex = MidIndex;
         ENDIF;
      ENDIF;
   ENDWHILE;

   IF ObjectFound = TRUE THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   ENDIF;
END;
        

