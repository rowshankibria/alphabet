	Name:            MTALineClass


���p�Xx��Component Method Scripts
���p�Xx��--------------------------
/*
**
**      Copyright c 2018 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          MTALineClass 
**
**  Date:       Version Description
** ----------------------------------
**  11/16/18 ysp Created
**  03/17/20 ysp Use HTV component's common grouper to determine they are in the same MTA station. 
*/
METHOD LoadHTVList (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   IdxIncrement = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN   
   CurObject.HTVList.Clear();
   
   k = 1;
   SELECT :CurObject.HTVList[k].OwnerNumber = G1.Reference,             // sequence
          :CurObject.HTVList[k].Equip = O1.Object,                      // HTV object 
          :CurObject.HTVList[k].EquipName = O1.Name,                    // HTV breaker name
          :CurObject.HTVList[k].EquipClass = G1.MemberType,             // Member Type
          :CurObject.HTVList[k].EquipTemplateObject = 0,                // 0 = this HTV is not fed by the searched feeder.
          :CurObject.HTVList[k].CurrentlyOpen = S.CurrentlyOpen,        // HTV status
          :CurObject.HTVList[k].PrimaryGrouping = G1.Grouping,          // MTA Line object                
          :CurObject.HTVList[k].PrimaryGroupingName = O1.Description,   // MTA station
          :CurObject.HTVList[k].LocationObject = O2.Object,        // Feeder object
          :CurObject.HTVList[k].LocationComment = O2.Name,         // Feeder name
          :CurObject.HTVList[k].NetworkType = O2.Type,             // Feeder type
          :CurObject.HTVList[k].LockNumber = '',               // O3.Name, source breaker
          :CurObject.HTVList[k].SubstationName = O2.PrimaryGroupingName,   // Substation,
          :CurObject.HTVList[k].SourceBkr = G3.Grouping                   // HTVGrouper
   FROM   UDB_Grouping G1,
          UDB_Grouping G2,
          UDB_Grouping G3,
          UDB_Object O1,
          UDB_Object O2,
          UDB_Switch S
   WHERE  G1.Grouping = :CurObject.Object AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.Member = O1.Object AND
          O1.Object = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.GroupingType IN (:Type$Feeder, :Type$ISOFeeder) AND
          G2.Grouping = O2.Object AND
          O1.Object = S.Object AND
          O1.Object = G3.Member AND
          G3.Relationship = :Interaction$MemberOf AND
          G3.GroupingType = :Type$AbstractHTV
   BEGIN
      CurObject.HTVList[k].Terminals = INT4(CurObject.HTVList[k].OwnerNumber);     // sequence number
      
      // feeder status
      CurObject.HTVList[k].VisibleBreak = 1;            // in-service
      
      SELECT :CurObject.HTVList[k].VisibleBreak = 0
      FROM FMS_ObjectStatus S
      WHERE S.Object = :CurObject.HTVList[k].LocationObject AND 
            S.Status = :Status$CO; 
      
      k = k + 1;
   END;
   CurObject.HTVList.Sort(Terminals = AS_ASC);
   
   /*
   ** Label HTV locations along the subway lines
   */   
   k = 1;
   WHILE k <= CurObject.HTVList.LastRow DO
      /*
      ** check whether or not this HTV is located in the same station as the next HTV
      */
      CurObject.HTVList[k].SourcePos = 1;
      IdxIncrement = 1;
      
      FOR i = (k+1) TO CurObject.HTVList.LastRow DO
         IF CurObject.HTVList[k].SourceBkr = CurObject.HTVList[i].SourceBkr THEN       // location comparision: UpperCase(CurObject.HTVList[k].PrimaryGroupingName) = UpperCase(CurObject.HTVList[i].PrimaryGroupingName)
            CurObject.HTVList[i].SourcePos = 0;
            IdxIncrement = i - k + 1;
         ELSE
            ENDLOOP;
         ENDIF;
      ENDFOR;
      
      k = k + IdxIncrement;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;
   
END;
   

