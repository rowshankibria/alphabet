   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].CopyRequest();
   ENDFOR;

   RETURN;
END;

METHOD LoadMgmtReport(
) = 
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;
   j  = INTEGER NOT NULL WITH DEFAULT;
   AllList = ARRAY OF InServicePermitClass;
   ReqList = ARRAY OF InServicePermitClass;
   SSMAllList = ARRAY OF InServicePermitClass;
   ECBAllList = ARRAY OF InServicePermitClass;
   PSTAllList = ARRAY OF InServicePermitClass;
   TMGAllList = ARRAY OF InServicePermitClass;
   CapCAllList = ARRAY OF InServicePermitClass;

   RetCode = INTEGER NOT NULL WITH DEFAULT;

   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** This method loads statistics of preissued and non-preissued requests by working groups.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;
/*
** get all permit counts
*/
   i = 1;
   SELECT :AllList[i].WorkGroup =  P.WorkGroup,
          :AllList[i].ShiftStartTime = R.StartDate,
          :AllList[i].Status = R.Emergent            // use Status attribute for Emergent
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** get all permit counts from SSM subgroups
*/
   i = 1;
   SELECT :SSMAllList[i].WorkGroup =  O.Name,
          :SSMAllList[i].ShiftStartTime = R.StartDate,
          :SSMAllList[i].Status = R.Emergent 
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R,
          Udb_Grouping G,
          Udb_Object O
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.WorkGroup = 'SSM' AND
          P.Substation = G.Member AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = 22648 AND
          G.Grouping = O.Object AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** get all permit counts from ECB subgroups
*/
   i = 1;
   SELECT :ECBAllList[i].WorkGroup =  O.Name,
          :ECBAllList[i].ShiftStartTime = R.StartDate,
          :ECBAllList[i].Status = R.Emergent
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R,
          Udb_Grouping G,
          Udb_Object O
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.WorkGroup = 'ECB' AND
          P.Division = G.Member AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = 22615 AND
          G.Grouping = O.Object AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** get all permit counts from PST subgroups
*/
   i = 1;
   SELECT :PSTAllList[i].WorkGroup =  O.Name,
          :PSTAllList[i].ShiftStartTime = R.StartDate,
          :PSTAllList[i].Status = R.Emergent
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R,
          Udb_Grouping G,
          Udb_Object O
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.WorkGroup = 'PST' AND
          P.Division = G.Member AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = 22619 AND
          G.Grouping = O.Object AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** get all permit counts from TMG subgroups
*/
   i = 1;
   SELECT :TMGAllList[i].WorkGroup =  O.Name,
          :TMGAllList[i].ShiftStartTime = R.StartDate,
          :TMGAllList[i].Status = R.Emergent
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R,
          Udb_Grouping G,
          Udb_Object O
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.WorkGroup = 'TMG' AND
          P.Division = G.Member AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = 22642 AND
          G.Grouping = O.Object AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1; 
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** get all permit counts from Cap_Const. subgroups
*/
   i = 1;
   SELECT :CapCAllList[i].WorkGroup =  O.Name,
          :CapCAllList[i].ShiftStartTime = R.StartDate,
          :CapCAllList[i].Status = R.Emergent
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R,
          Udb_Grouping G,
          Udb_Object O
   WHERE  P.ReportTime >= :StartDate AND
          P.ReportTime < :EndDate AND
          P.WorkGroup = 'Cap_Const.' AND
          P.Division = G.Member AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = 22901 AND
          G.Grouping = O.Object AND
          P.ISPermit = R.ISPermit
   ORDER BY 1
   BEGIN
      i = i + 1; 
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** create statistics of all permits by groups
*/
   FOR i = 1 TO AllList.LastRow() DO
      RetCode = CurObject.ARL.Find(Value = AllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL.LastRow + 1;
         CurObject.ARL[j].Name = AllList[i].WorkGroup;
         CurObject.ARL[j].Count1 = 0;
         CurObject.ARL[j].Count2 = 0;
         CurObject.ARL[j].Count3 = 0;
      ENDIF;

      IF AllList[i].ShiftStartTime <> '' OR AllList[i].Status <> 0 THEN
         CurObject.ARL[j].Count1 = CurObject.ARL[j].Count1 + 1;
      ELSE
         CurObject.ARL[j].Count2 = CurObject.ARL[j].Count2 + 1;
      ENDIF;

      IF AllList[i].Status <> 0 THEN
         CurObject.ARL[j].Count3 = CurObject.ARL[j].Count3 + 1;
	  ENDIF;
   ENDFOR;

   FOR i = 1 TO SSMAllList.LastRow() DO
      RetCode = CurObject.ARL_SSM.Find(Value = SSMAllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL_SSM.LastRow + 1;
         CurObject.ARL_SSM[j].Name = SSMAllList[i].WorkGroup;
         CurObject.ARL_SSM[j].Count1 = 0;
         CurObject.ARL_SSM[j].Count2 = 0;
         CurObject.ARL_SSM[j].Count3 = 0;
      ENDIF;

      IF SSMAllList[i].ShiftStartTime <> '' OR SSMAllList[i].Status <> 0 THEN
         CurObject.ARL_SSM[j].Count1 = CurObject.ARL_SSM[j].Count1 + 1;
      ELSE
         CurObject.ARL_SSM[j].Count2 = CurObject.ARL_SSM[j].Count2 + 1;
      ENDIF;
      
      IF SSMAllList[i].Status <> 0 THEN
         CurObject.ARL_SSM[j].Count3 = CurObject.ARL_SSM[j].Count3 + 1;
      ENDIF;
   ENDFOR;

   FOR i = 1 TO ECBAllList.LastRow() DO
      RetCode = CurObject.ARL_ECB.Find(Value = ECBAllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL_ECB.LastRow + 1;
         CurObject.ARL_ECB[j].Name = ECBAllList[i].WorkGroup;
         CurObject.ARL_ECB[j].Count1 = 0;
         CurObject.ARL_ECB[j].Count2 = 0;
         CurObject.ARL_ECB[j].Count3 = 0;
      ENDIF;

      IF ECBAllList[i].ShiftStartTime <> '' OR ECBAllList[i].Status <> 0 THEN
         CurObject.ARL_ECB[j].Count1 = CurObject.ARL_ECB[j].Count1 + 1;
      ELSE
         CurObject.ARL_ECB[j].Count2 = CurObject.ARL_ECB[j].Count2 + 1;
      ENDIF;
      
      IF ECBAllList[i].Status <> 0 THEN
         CurObject.ARL_ECB[j].Count3 = CurObject.ARL_ECB[j].Count3 + 1;
      ENDIF;
   ENDFOR;

   FOR i = 1 TO PSTAllList.LastRow() DO
      RetCode = CurObject.ARL_PST.Find(Value = PSTAllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL_PST.LastRow + 1;
         CurObject.ARL_PST[j].Name = PSTAllList[i].WorkGroup;
         CurObject.ARL_PST[j].Count1 = 0;
         CurObject.ARL_PST[j].Count2 = 0;
         CurObject.ARL_PST[j].Count3 = 0;
      ENDIF;

      IF PSTAllList[i].ShiftStartTime <> '' OR PSTAllList[i].Status <> 0 THEN
         CurObject.ARL_PST[j].Count1 = CurObject.ARL_PST[j].Count1 + 1;
      ELSE
         CurObject.ARL_PST[j].Count2 = CurObject.ARL_PST[j].Count2 + 1;
      ENDIF;
      
      IF PSTAllList[i].Status <> 0 THEN
         CurObject.ARL_PST[j].Count3 = CurObject.ARL_PST[j].Count3 + 1;
      ENDIF;
   ENDFOR;

   FOR i = 1 TO TMGAllList.LastRow() DO
      RetCode = CurObject.ARL_TMG.Find(Value = TMGAllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL_TMG.LastRow + 1;
         CurObject.ARL_TMG[j].Name = TMGAllList[i].WorkGroup;
         CurObject.ARL_TMG[j].Count1 = 0;
         CurObject.ARL_TMG[j].Count2 = 0;
         CurObject.ARL_TMG[j].Count3 = 0;
      ENDIF;

      IF TMGAllList[i].ShiftStartTime <> '' OR TMGAllList[i].Status <> 0 THEN
         CurObject.ARL_TMG[j].Count1 = CurObject.ARL_TMG[j].Count1 + 1;
      ELSE
         CurObject.ARL_TMG[j].Count2 = CurObject.ARL_TMG[j].Count2 + 1;
      ENDIF;
      
      IF TMGAllList[i].Status <> 0 THEN
         CurObject.ARL_TMG[j].Count3 = CurObject.ARL_TMG[j].Count3 + 1;
      ENDIF;
   ENDFOR;

   FOR i = 1 TO CapCAllList.LastRow() DO
      RetCode = CurObject.ARL_CapC.Find(Value = CapCAllList[i].WorkGroup,
                                   AttributeName = 'name',
                                   RowNumber = ByRef(j));
      IF RetCode = ER_ROWNOTFOUND THEN
         j = CurObject.ARL_CapC.LastRow + 1;
         CurObject.ARL_CapC[j].Name = CapCAllList[i].WorkGroup;
         CurObject.ARL_CapC[j].Count1 = 0;
         CurObject.ARL_CapC[j].Count2 = 0;
         CurObject.ARL_CapC[j].Count3 = 0;
      ENDIF;

      IF CapCAllList[i].ShiftStartTime <> '' OR CapCAllList[i].Status <> 0 THEN
         CurObject.ARL_CapC[j].Count1 = CurObject.ARL_CapC[j].Count1 + 1;
      ELSE
         CurObject.ARL_CapC[j].Count2 = CurObject.ARL_CapC[j].Count2 + 1;
      ENDIF;
      
      IF CapCAllList[i].Status <> 0 THEN
         CurObject.ARL_CapC[j].Count3 = CurObject.ARL_CapC[j].Count3 + 1;
      ENDIF;
   ENDFOR;

   RETURN;
END;

METHOD LoadDSORequestList (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   StatusClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   FilterClause1 = VARCHAR(400) NOT NULL WITH DEFAULT;
   FilterClause2 = VARCHAR(400) NOT NULL WITH DEFAULT;
   DynamicWhereClause1 = VARCHAR(800) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
   StartDate = '';
   EndDate = '';

   StatusClause = '';
   CurObject.PL.Clear();

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;

   IF UPPERCASE(CurObject.ApplicationFilter) <> 'ALL' THEN
      StatusClause = ' P.Application = ''' + UPPERCASE(CurObject.ApplicationFilter) + ''' AND ';
   ENDIF;

   IF CurObject.StatusFilter = ISPStatus$AllCurrent THEN	// all current
      StatusClause = StatusClause + 
                     ' P.Status >= ' + VARCHAR(ISPStatus$Request) +  ' AND ' + 
                     ' P.Status < ' + VARCHAR(ISPStatus$Archived) +  ' AND ' + 
                     ' P.Status <> ' + VARCHAR(ISPStatus$RequestDenied) +  ' AND ';

   ELSEIF CurObject.StatusFilter = ISPStatus$AllRequests THEN	// all requests
      StatusClause = StatusClause + 
                     ' P.Status IN (' + VARCHAR(ISPStatus$Request) + ',' + 
                                        VARCHAR(ISPStatus$RequestPending) + ') AND ';   

   ELSEIF CurObject.StatusFilter = ISPStatus$AllReviewed THEN	// all reviewed
      StatusClause = StatusClause + 
                     ' P.Status IN (' + VARCHAR(ISPStatus$Approved) + ',' +
                                        VARCHAR(ISPStatus$Denied) + ',' +
                                        VARCHAR(ISPStatus$Pending) + ') AND ';   

   ELSEIF CurObject.StatusFilter = ISPStatus$AllArchived THEN	// archived
       StatusClause = StatusClause + ' P.Status = ' + VARCHAR(ISPStatus$Archived) + ' AND ';

   ELSE 
       StatusClause = StatusClause  + ' P.Status = ' + VARCHAR(CurObject.StatusFilter ) + ' AND ';
   ENDIF;

   IF CurObject.DivisionFilter <> 0 AND CurObject.SubstationFilter = 0 THEN
      FilterClause1 = ' G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.Member = P.Substation AND ' +    
             'P.Substation = O.Object AND ' + 
             'P.ISPermit = R.ISPermit AND ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  

      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Job = P.Job, 
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			      
      FROM   SOA_InServicePermit P,
             UDB_Grouping G,
             UDB_Object O,
             SOA_ISPermitRequest R
      WHERE  :DynamicWhereClause1
      ORDER BY EnterTime 
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF CurObject.SubstationFilter <> 0 THEN
         FilterClause1 = ' P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
      ENDIF;
      FilterClause1 = FilterClause1 + ' P.Substation = O.Object AND ' + 
               'P.ISPermit = R.ISPermit ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  
      
      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Job = P.Job, 
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			      
      FROM   SOA_InServicePermit P,
             UDB_Object O,
             SOA_ISPermitRequest R
      WHERE  :DynamicWhereClause1 
      ORDER BY EnterTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;    
   CALLPROC DDB_ROLLBACK;

   /*
   ** work equipment 
   *
   FOR i = 1 TO CurObject.PL.LastRow() DO
      /*
      ** ISP Request's Equipment information is stored in SOA_ISPermitRequest table.
      ** In order to show the equipment on S.M.'s summary screen, we load all the equipment
      ** as a piece of equipment to the equipment list for the request.
      *
      IF CurObject.PL[i].Status = ISPStatus$Request OR 
         CurObject.PL[i].Status = ISPStatus$RequestPending THEN         
         SELECT :CurObject.PL[i].EL[1].Object = 0,
                :CurObject.PL[i].EL[1].TypeName = '',
                :CurObject.PL[i].EL[1].Name = Equipment,
                :CurObject.PL[i].EL[1].PrimaryEquip = 1
         FROM   SOA_ISPermitRequest 
         WHERE  ISPermit = :CurObject.PL[i].ISPermit;
      ELSE
         j = 1;
         SELECT :CurObject.PL[i].EL[j].Object = Object,
                :CurObject.PL[i].EL[j].TypeName = TypeName,
                :CurObject.PL[i].EL[j].Name = Name,
                :CurObject.PL[i].EL[j].PrimaryEquip = PrimaryEquip
         FROM   IR_OpOrderFeeders 
         WHERE  ISPermit = :CurObject.PL[i].ISPermit
         BEGIN
            j = j + 1;
         END;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No In-Service work permits match the filter criteria.';
   ENDIF;
*/
   RETURN; 
END;

METHOD LoadNYISOReport(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   FilterClause1 = VARCHAR(400) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  

   IF UPPERCASE(CurObject.DivisionName) = 'ALL' THEN
      DynamicWhereClause = '';
   ELSE
      DynamicWhereClause = 'P.Division IN (';
      i = 1;
      WHILE LENGTH(CurObject.DivisionName) > 0 DO
         IF i > 1 THEN
            DynamicWhereClause = DynamicWhereClause + ',';
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + LEFT(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1));   
         CurObject.DivisionName = SHIFT(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         i = i + 1;
      ENDWHILE;
      DynamicWhereClause = DynamicWhereClause + ') AND '; 
   ENDIF;  

   DynamicWhereClause = DynamicWhereClause + 
      ' P.Substation = O.Object AND ' +
      ' P.NYISONotified = 1 AND ' +
      ' P.NYISOTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
      ' P.NYISOTime < DATE(''' + VARCHAR(EndDate) + ''') AND ' +
      ' P.Job = J.Job ' ;

   CurObject.PL.Clear();

   i = 1;
   SELECT :CurObject.WPList[i].Job = P.Job,
          :CurObject.WPList[i].Division = P.Division, 
          :CurObject.WPList[i].SubstationName = O.Description, 
          :CurObject.WPList[i].RequestTitle = P.PermitMove,			    
          :CurObject.WPList[i].NotifiedBy = P.NYISOTOName,
          :CurObject.WPList[i].NotifiedTime = P.NYISOTime,
          :CurObject.WPList[i].IssueTime = IFNULL(J.TOIssued, ''),
          :CurObject.WPList[i].ReturnTime = IFNULL(J.RSComplete, '')
   FROM   SOA_InServicePermit P,
          UDB_Object O,
          SOA_Job J
   WHERE  :DynamicWhereClause
   UNION ALL
   SELECT P.Job,
          P.Division, 
          O.Description, 
          P.PermitMove,			    
          P.NYISOTOName,
          P.NYISOTime,
          J.TOIssued,
          J.RSComplete
   FROM   SOA_InServicePermit P,
          UDB_Object O,
          SOA_ArchiveJob J
   WHERE  :DynamicWhereClause
   ORDER BY 6    //NYISOTime
   BEGIN 
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;
METHOD LoadRCCRequestList (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   Division = INTEGER NOT NULL WITH DEFAULT;
   StatusClause = VARCHAR(600) NOT NULL WITH DEFAULT;
   FilterClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   DynamicWhereClause1 = VARCHAR(1200) NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.PL.Clear();
 
   StatusClause = ' P.ObjectType = ' + VARCHAR(Type$UnitSubstation) + ' AND ' + 
                  ' P.WorkGroup = ''PST'' AND ' + 
                  ' P.Division IN (' + VARCHAR(Division$Bronx) + ',' + VARCHAR(Division$Westchester) + ') AND ';
              
   StatusClause = StatusClause  + ' P.Status IN (' + VARCHAR(ISPStatus$RequestPending) + ',' + VARCHAR(ISPStatus$RequestToRCC) + ') AND ';
   
   IF CurObject.DivisionFilter <> 0 AND CurObject.SubstationFilter = 0 THEN
      FilterClause = ' G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.Member = P.Substation AND ' +    
             'P.Substation = O.Object AND ' + 
             'P.ISPermit = R.ISPermit ';
 
      DynamicWhereClause1 = StatusClause + FilterClause;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  

      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift, 
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             UDB_Grouping G,
             UDB_Object O,
             SOA_ISPermitRequest R  
      WHERE  :DynamicWhereClause1
      ORDER BY 23 					// R.EnterTime 
      BEGIN
         i = i + 1;
      END;
   ELSE
      /* no unit substation filter is supported at this time.
      IF CurObject.SubstationFilter <> 0 THEN
         FilterClause = ' P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
      ENDIF;
      */
      FilterClause = FilterClause + ' P.Substation = O.Object AND ' +
                      'P.ISPermit = R.ISPermit ';
       
      DynamicWhereClause1 = StatusClause + FilterClause;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  
      
      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift, 
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,			        
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             UDB_Object O,
             SOA_ISPermitRequest R  
      WHERE  :DynamicWhereClause1 
      ORDER BY 23 				// R.EnterTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;    
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No In-Service work permit requests match the filter criteria.';
   ENDIF;

   FOR i = 1 TO CurObject.PL.LastRow DO
      IF CurObject.PL[i].Status = ISPStatus$RequestPending THEN
         CurObject.PL[i].Jurisdiction = '';

      ELSEIF CurObject.PL[i].Status = ISPStatus$RequestToRCC THEN 
         CurObject.PL[i].Jurisdiction = 'RCC';

      ENDIF;  
   ENDFOR;

   RETURN; 
END;  

METHOD LoadRestrictions (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;

   DynamicWhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
   DynamicWhereClause2 = VARCHAR(800) NOT NULL WITH DEFAULT;
   PrevRestriction = INTEGER NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   TempRes = ISPRestriction;
   TempItem = ObjectClass;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.StatusFilter = 1 THEN      // outstanding restrictions
      DynamicWhereClause = '(R.Status = 1 OR ' + 
             'R.Status = 0 AND R.EndTime >= ''' + VARCHAR(DATE('NOW')) + ''') AND ';
   ELSE
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   
      DynamicWhereClause = 'R.Status IN (0, 50) AND ' +
            'R.StartTime < ''' + VARCHAR(EndDate) + ''' AND ' +
            '(R.EndTime IS NOT NULL AND R.EndTime >= ''' + VARCHAR(StartDate)  + ''' OR ' +
            ' R.EndTime IS NULL    AND R.LiftTime >= ''' + VARCHAR(StartDate) + ''') AND ';

   ENDIF;
   DynamicWhereClause = DynamicWhereClause + ' R.EnterBy = O1.Object ';
   DynamicWhereClause2 = DynamicWhereClause + ' AND ' + 
             'R.Restriction = I.Restriction AND ' +
             'I.Object = O2.Object';
   
   //CurMethod.Trace(Text = DynamicWhereClause2);
   
   CurObject.RL.Clear();
   PrevRestriction = 0;
   i = 0;
   SELECT DISTINCT
         :TempRes.Restriction  = R.Restriction  
       , :TempRes.HandsOff     = R.HandsOff       
       , :TempRes.Remark       = R.Remark       
       , :TempRes.StartTime    = R.StartTime    
       , :TempRes.EndTime      = R.EndTime      
       , :TempRes.Status       = R.Status       
       , :TempRes.EnterTime    = R.EnterTime    
       , :TempRes.LiftTime     = R.LiftTime
       , :TempRes.EnterByName  = O1.Description
       , :TempItem.Object      = 0
       , :TempItem.Name        = ''
       , :TempItem.Description = ''
       , :TempItem.Type        = 0
   FROM  SOA_ISPRestriction R,
         UDB_Object O1
   WHERE :DynamicWhereClause
   UNION ALL
   SELECT DISTINCT
         R.Restriction  
       , R.HandsOff  
       , R.Remark       
       , R.StartTime    
       , R.EndTime      
       , R.Status       
       , R.EnterTime    
       , R.LiftTime
       , O1.Description
       , O2.Object
       , O2.Name
       , O2.Description
       , O2.Type
   FROM  SOA_ISPRestriction R,
         SOA_ISPRestrictionItem I,
         UDB_Object O1,
         UDB_Object O2
   WHERE :DynamicWhereClause2
   ORDER BY Restriction DESC, Name ASC
   BEGIN
      IF PrevRestriction <> TempRes.Restriction THEN
         PrevRestriction = TempRes.Restriction;
         i = i + 1;
         k = 1;

         CurObject.RL[i].Restriction  = TempRes.Restriction;
         CurObject.RL[i].HandsOff     = TempRes.HandsOff;
         CurObject.RL[i].Remark       = TempRes.Remark;     
         CurObject.RL[i].StartTime    = TempRes.StartTime; 
         CurObject.RL[i].EndTime      = TempRes.EndTime;     
         CurObject.RL[i].Status       = TempRes.Status;     
         CurObject.RL[i].EnterTime    = TempRes.EnterTime;  
         CurObject.RL[i].EnterByName  = TempRes.EnterByName; 
         CurObject.RL[i].LiftTime     = TempRes.LiftTime;         
      ENDIF;

      IF TempItem.Object > 0 THEN
         CurObject.RL[i].AL[k].Object = TempItem.Object;
         CurObject.RL[i].AL[k].Type = TempItem.Type;
         
         IF TempItem.Type = Type$Substation THEN
            CurObject.RL[i].AL[k].TypeName = 'STN';
            CurObject.RL[i].AL[k].Name = TempItem.Description;
         
         ELSEIF TempItem.Type = Type$TransmissionFdr THEN
            CurObject.RL[i].AL[k].TypeName = 'FDR';
            CurObject.RL[i].AL[k].Name = TempItem.Name;

         ELSEIF TempItem.Type = Type$Capacitor THEN
            CurObject.RL[i].AL[k].TypeName = 'CAP';
            CurObject.RL[i].AL[k].Name = TempItem.Name;

         ELSE
            CurObject.RL[i].AL[k].TypeName = 'TRF';
            CurObject.RL[i].AL[k].Name = TempItem.Name;
         ENDIF;

         /* 
         ** if we are loading outstanding restrictions, we also want the list of restricted substations
         ** This list will be in CurObject.RL[i].DL.
         */
         IF CurObject.StatusFilter = 1 THEN 
            CurObject.RL[i].AddItemSubstation(ItemEquip = CurObject.RL[i].AL[k]);
         ENDIF;
         
         k = k + 1;
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;
END;

METHOD CheckRestrictionOnCircuit(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */

   TempRes = ISPRestriction;
   RestrictionItem = VARCHAR(40) NOT NULL WITH DEFAULT;
   EndText = VARCHAR(60) NOT NULL WITH DEFAULT;
   StartText = VARCHAR(60) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   /* See if the associated substation or transmission feeder is under restriction.
   */
   SELECT :TempRes.Restriction = R.Restriction,
          :TempRes.StartTime = R.StartTime,
          :TempRes.EndTime = R.EndTime,
          :TempRes.Status = R.Status,
          :TempRes.Remark = R.Remark, 
          :RestrictionItem = O.Name
   FROM  Udb_Grouping G1,
         SOA_ISPRestriction R,
         SOA_ISPRestrictionItem I,
         Udb_Object O
   WHERE G1.Member = :CurObject.IDFilter AND
         G1.Relationship = :Interaction$MemberOf AND
         G1.GroupingType IN (:Type$Substation, :Type$TransmissionFdr) AND
         G1.Grouping = O.Object AND
         G1.Grouping = I.Object AND
         I.Restriction = R.Restriction AND
         (R.Status = 1 OR 
          R.Status = 0 AND R.EndTime >= DATE('NOW')) AND 
         R.StartTime < (DATE('NOW') + '1 day');
   CALLPROC DDB_ROLLBACK;      
         
   IF TempRes.Restriction > 0 THEN
      /*
      IF TempRes.StartTime <= DATE('Now') THEN
			StartText = 'is currently placed';
      ELSE
         StartText = "will be placed on " + FormatDate(RawDate=IFNULL(TempRes.StartTime, ''), Format='DATE_ONLY');
      ENDIF;
      
      IF 0 = TempRes.Status THEN
         EndText = FormatDate(RawDate=IFNULL(TempRes.EndTime, ''), Format='DATE_ONLY');
      ELSE
         EndText = 'it is removed by Transmission Operators';
      ENDIF;
      */
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'In-service work permits at ' + RestrictionItem + 
				' are NOT being approved due to ' + TempRes.Remark;
   ENDIF;
END;

