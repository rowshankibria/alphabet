      RESUME;
   ENDIF;

   IF Card_SF.CL.LastRow = 1 THEN
      CALLPROC LoadCard(LoadApp = Card_SF.CL[1].Application,
                        LoadCard = Card_SF.CL[1].Card,
                        LoadItem = Card_SF.CL[1].SwitchingItem);
      RETURN 0;
   ELSE
      FIELD(Card_SF).CurBias = FB_Landable;
   ENDIF;
END;

ON CLICK Delay_Btn = 
BEGIN

   CALLFRAME RecordORDelay(ORNumber = SWP_TF[CurrentRow].ORNumber,
                           DelayType = ORDelay$Outage);
   RESUME;

   IF CurrentRow = 0 THEN
      MESSAGE 'Please select an SWP first.';
      RESUME;
   ENDIF;
