Application Component Report
============================

	Name:            Warning

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          Warning
**
**  06/04/02  ysp   Merge: combined from SOA and FeederCard.
**  02/18/03  pkw   Added code for Yellow Warning report.
**  11/14/03  ysp   ITC143: add code to save job data for Yellow Warning report.
**  02/06/04  em    If AutomaticExecution, then stop execution and send
**                         warning to incoming message
**  03/17/04  em    When stopping automation, check if there are any more outstanding
**                  blocks, set status to NO if there are none.
**                  If there are other ISSUED blocks, those go to MANUAL
**  03/31/04  em    When stopping automation, Cancel all other blocks.  For cancelled 
**                  blocks, update the order status.  
**  10/21/05  em    FMS 260: Outgoing Message change
**  12/14/05  ysp   Increase the size of TOMove to 160 chars
**  01/31/05  em    Two Operators must confirm warning if flag set 
**  03/09/06  ysp   Staff Support is not qualified to confirm warnings
**  03/18/08  pkw   Change message to Traceerror calls to help track duplicate error.
**  04/15/08  pkw   Add trace message when soa_warningins fails.
**  12/08/09  em    Removed DO sign-off - moving this feaure to the Override screen.
**                  Save warning in global Warning Buffer
**  09/08/10  ysp   ITC262: Add Card ID, Job ID and Equip ID 
**  03/28/11  em    Updated for 3G
**  07/13/15  em    If Automation stops due to warning, set warning type = 0 
**                  isntead of = 1.
**  08/12/15  em    Include TwoOpConfirmEvent parm when bypassing warning.
**  05/02/18  em    Add method call to record WarningBackout on Cancel.
*/
INITIALIZE
(
/* passed in */
    Card = INTEGER NOT NULL;
    SwitchingItem = INTEGER;           /*Nullable*/
    Job = INTEGER;                     /*Nullable*/
    Jobs = Array of JobInProgress;     /* for feederCard */
    Text = Varchar(512) NOT NULL;	   /* Warning text */
) =
DECLARE
    RetCode       = INTEGER NOT NULL WITH DEFAULT;
    i             = INTEGER NOT NULL;
    CardClass     = INTEGER NOT NULL;
    CardName      = VARCHAR(200) NOT NULL WITH DEFAULT;
    CardFeeder    = INTEGER NOT NULL WITH DEFAULT;
    MsgText       = VARCHAR(400) NOT NULL WITH DEFAULT;
    W             = WarningClass;
ENDDECLARE
BEGIN
   CardID = Card;
   MoveID = IFNULL(Job, 0);
   IF Job IS NOT NULL THEN
      SELECT :EquipID = Equip
      FROM   SOA_Job
      WHERE  Job = :Job;
   ENDIF;

   WarningText = Text;

   IF Jobs.LastRow() <> 0 THEN
      FIELD(Moves).CurBias = FB_CHANGEABLE;
      Moves = Jobs.Duplicate();
      IF Jobs.LastRow() <= 8 THEN
         FIELD(Moves).NumVisibleRows = Jobs.LastRow();
      ELSE
         FIELD(Moves).NumVisibleRows = 8;
         FIELD(Moves).HasScrollBar = TRUE;
      ENDIF;
   ENDIF;

   IF AutomaticExecution = TRUE THEN
      CurrentApplication = Application$FMS;
   ENDIF;
/*
** Get Card Name for Warning report
*/
   IF CurrentApplication = Application$FMS THEN
      SELECT :CardName = C.FeederName,
             :CardFeeder = CTO.Object
      FROM   FMS_Card C,
             TFMS_CardToObject CTO
      WHERE  C.Card = :Card AND
             C.Card = CTO.Card AND
             CTO.Type = :Type$Feeder;
      
   ELSEIF CurrentApplication = Application$TFMS THEN
      SELECT :CardName = FeederNames
      FROM   TFMS_Card
      WHERE  Card = :Card;

   ELSEIF CurrentApplication = Application$SLC THEN
      SELECT :CardName = SubstationName
      FROM   SLC_Card
      WHERE  Card = :Card;

   ENDIF;
/*
**  Get CardClass information for SOA_Warning insert.
*/
   IF SwitchingItem IS NULL OR
      SwitchingItem = 0 THEN
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SOA_Card
      WHERE   Card = :Card;
   ELSE
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SLC_InformationItem
      WHERE   Job = :SwitchingItem;
   ENDIF;
/*
** Must stop processing here if Automatic Execution is ON.
*/
   IF AutomaticExecution = TRUE THEN

      IF CardClass <> Type$CardClassTest THEN   
         RetCode = CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = 0,
                   OperatorName = 'Process Automation',
                   UserName = 'Automation',
                   WarningType = 0,
                   WarningText = WarningText,
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   Job = IFNULL(Job,0));
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace
             (   Text =  varchar(date('now')) + ' Error: Warning Screen '
             +           'unable to insert warning into SOA_Warning table '
             +           'for card ' + VARCHAR(Card) + ' Warning: ' + WarningText
             );
         ENDIF;
      ENDIF;

      RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Job,
                            Time = DATE('now'),
                            UserName = 'Automation',
			    Item = 'Warning',
			    Old = Text,
			    New = 'Automation is Stopped');
      IF RetCode = 0 THEN 
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to log warning stopping Automatic '
          +           'Execution for card ' + VARCHAR(Card)
          );
      ENDIF;

      RetCode = CALLPROC FMS_AutoBlockStopUpd (
                                Card = Card,
                                Block = AutomaticExecutionBlock,
                                BlockStatus = BlockStatus$Stopped,
                                BlockStopped = 'now',
                                StopReason = Text);
      IF RetCode = 0 THEN 
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to set Automatic Block status '
          +           'to Stopped for card ' + VARCHAR(Card)
          );
      ENDIF;
/*
** Decide whether to stop or No Go automation.
*/
      i = 0;
      SELECT :i = COUNT(*)
      FROM   FMS_AutomationBlock
      WHERE  Card = :Card AND
             BlockStatus < :BlockStatus$Complete;

      IF i = 0 THEN /* No more Automation */

         RetCode = CALLPROC FMS_CardAutoExecution (
                    Card = Card,
                    ProcessAutoExecution = Automation$No);
      ELSE
         CALLPROC CancelAutomation (Card = Card);

         RetCode = CALLPROC FMS_CardAutoExecution (
                    Card = Card,
                    ProcessAutoExecution = Automation$Stop);

      ENDIF;

      IF RetCode = 0 THEN 
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to turn off Auto Execution '
          +           'for card ' + VARCHAR(Card)
          );
      ENDIF;
/*
** Send Incoming MESSAGE HERE.  THE INCOMING MESSAGE SHOULD BE SET UP TO
** PROCESS THE ISSUED MOVES ON THE ORDER AS INCOMPLETE...
** We may also need to properly set the Order or Permit Status here.
** Exact implementation is still up in the air.
*/
      MsgText = 'AUTOMATION STOPPED ' +
                'Due to Warning: ' + HC_NEWLINE + '  ' + WarningText;

      RetCode = CALLPROC MSG_SendMsg (Card = Card,
                                   Action = Action$NoAction,
                                   OrderNumber = AutomaticExecutionBlock,
                                   Substation = CardFeeder,
                                   SubstationName = CardName,
                                   Msg = MsgText,
                                   FromOpName = 'Automation Monitor',
                                   SendDate = DATE('now'),
                                   ToApp = 'FMS',
                                   FromApp = 'AUTO',
                                   Priority = Priority$High
                                  );
      IF RetCode = -1 THEN 
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to insert Incoming Message to incomplete '
          +           'moves that failed during automation for Card  ' 
          +           VARCHAR(Card)
          );
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
                                
      RETURN (PU_CANCEL);
   ENDIF;
END;
/*
**	Handle a Yes click
*/
ON Click YesButton =
BEGIN
   IF FIELD(Moves).CurBias = FB_CHANGEABLE THEN
      FOR i = 1 TO Moves.LastRow() DO
         IF Moves[i].Incomplete_Btn = FALSE THEN
             MESSAGE 'You must confirm each move to continue.';
             RESUME;
         ENDIF;
      ENDFOR;
   ENDIF;

   IF CardClass <> Type$CardClassTest THEN   
      RetCode = CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 1,
                   WarningText = WarningText,
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   TwoOpConfirmEvent = TwoOpConfirmEvent,
                   Job = IFNULL(Job,0));
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to insert warning into SOA_Warning table '
          +           'for card ' + VARCHAR(Card) + ' Warning: ' + WarningText
          );
      ENDIF;
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Job,
                            Time = DATE('now'),
                            UserName = UserName,
			    Item = 'Warning',
			    Old = Text,
			    New = 'Elected to continue');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
/*
** Save Warning in Buffer
*/
      i = WarningBuffer.LastRow();
      W.WarningText = WarningText;
      WarningBuffer.InsertRow (RowNumber = i + 1, RowObject = W);
      
      RETURN (NULL);
   ELSE
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to Log Warning Bypass.  Transaction cancelled.',
             TraceMessage = 'Frame:Warning;Unable to Log Warning Bypass.  Transaction cancelled.');
      WarningBuffer.Clear();
      RETURN (PU_CANCEL);
   ENDIF;
   
END;
/*
**	Handle a No click
*/
ON Click NoButton =
BEGIN
   IF CardClass <> Type$CardClassTest THEN   
      RetCode = CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 0,
                   WarningText = WarningText,
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   Job = IFNULL(Job,0));
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace
          (   Text =  varchar(date('now')) + ' Error: Warning Screen '
          +           'unable to insert warning into SOA_Warning table '
          +           'for card ' + VARCHAR(Card) + ' Warning: ' + WarningText
          );
      ENDIF;
   ENDIF;
   
   DOp.RecordBackout (WarningText = WarningText);

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Job,
                            Time = DATE('now'),
                            UserName = UserName,
			    Item = 'Warning',
			    Old = Text,
			    New = 'Elected to cancel');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
      WarningBuffer.Clear();
      RETURN (PU_CANCEL);
   ELSE
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to Log Warning Cancel.',
             TraceMessage = 'Frame:Warning;Unable to Log Warning Cancel.');
      WarningBuffer.Clear();
      RETURN (PU_CANCEL);
   ENDIF;

END;

ON ChildClick Moves[*].Incomplete_Btn =
BEGIN
/*
**  Prevent from toggling to false when already toggled to TRUE
*/
    IF Moves[].InComplete_Btn = FALSE THEN 
        Moves[].InComplete_Btn = TRUE;
        RESUME;
    ENDIF;

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                            SwitchingItem = SwitchingItem,
			    Job = Moves[].Job,
                            Time = DATE('now'),
                            UserName = UserName,
			    Item = 'Acknowledge',
			    Old = '',
			    New = 'Outstanding Move');
   IF RetCode < 0 THEN 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to Log confirmation.  Please contact technical support.' + 
               HC_NEWLINE +
               'Card: ' + HC_TAB + varchar(card) + HC_NEWLINE + 
               'Job: '  + HC_TAB + varchar(Moves[].Job) + HC_NEWLINE +
               'Item: ' + HC_TAB + 'Confirm Issue' + HC_NEWLINE + 
               'Old: '  + HC_TAB + 'Confirmed' + HC_NEWLINE + 
               'New: '  + HC_TAB + 'UnConfirmed',
             TraceMessage = 'Frame:Warning;Unable to Log confirmation. ' + 
               'Card: ' + varchar(card) + ' Job: '  + varchar(Moves[].Job) +
               'Item: Confirm Issue Old: Confirmed New: UnConfirmed');
    Endif;
    CALLPROC DDB_COMMIT;

    Field(Moves[].InComplete_Btn).BGColor = CC_YELLOW;
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

