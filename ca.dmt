/*
**
**      Copyright c 2010 Pateric Software, LLC.  All rights reserved.
**
**      Pateric Software, LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software, LLC.
**
**  Application:    CAC
**  Class:          PermitRequest_ASE
**
**  Date:       Version Description
** ----------------------------------
**  10/18/10    pkw     Add Load_PermitRequestData method.
**  02/07/11    pkw     look at soa_archivejob table for union selects. 
**  10/24/11    ysp     Split ISWP and OSWP into separate reports.
**  01/20/15    ysp     Add WorkGroup attribute for ISWP report and methods for denied ISWP report
**  12/30/19    em      Add Cap Const. workgroup (22901)
**  03/25/21    em      Remove OS*WP code
**                 
*/       
METHOD Load_DeniedISWPByGroup (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   StatusClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   GroupClause = VARCHAR(500) NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   GroupObject = INTEGER NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load denied iswp request by working groups 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      /*
      **  Build effective division based on input parameters passed in.
      */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;

      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF;  
   ENDIF;

   GroupClause = '';
   IF CurObject.WorkGroup <> '' THEN
      IF CurObject.WorkGroup LIKE 'SSM_%' THEN
         GroupObject = 0;
         SELECT :GroupObject = Object
         FROM   UDB_Object
         WHERE  Type = 22648 AND               //SSM
                Name = :CurObject.WorkGroup;

         GroupClause = ' P.WorkGroup = ''SSM'' AND P.Substation IN ( ' + 
                ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
                ' AND Grouping = ' + VARCHAR(GroupObject) + 
                ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'ECB_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22615 AND               // ECB
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''ECB'' AND P.Division IN (' + GroupList + ') AND ';
         
      ELSEIF CurObject.WorkGroup LIKE 'PST_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22619 AND               // PST
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''PST'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'TMG_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22642 AND               // TMG
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''TMG'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'Cap_Const%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22901 AND               // Cap_Const.
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''Cap Const.'' AND P.Division IN (' + GroupList + ') AND ';
      ELSE
         GroupClause = ' P.WorkGroup = ''' + VARCHAR(CurObject.WorkGroup) + ''' AND ';
      ENDIF;
   ENDIF;
   
   StatusClause = '';
   IF CurObject.IDFilter > 0 THEN
      StatusClause  = ' P.ISPermit=' + VARCHAR(CurObject.IDFilter) + ' AND ';
   ENDIF;
   
   StatusClause = StatusClause + 
          ' P.ISPermit = R.ISPermit AND ' + 
          'R.CurrentStatus = ''DENIED'' AND ' + 
          '(P.StatusTime BETWEEN DATE(''' + VARCHAR(:CurObject.StartDate) +
             ''') AND DATE(''' + VARCHAR(:CurObject.EndDate) + ''')) AND ' + 
          'P.Division IN (';

   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         StatusClause = StatusClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         StatusClause = StatusClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   DynamicWhereClause = GroupClause + StatusClause;
   
   i = 1;
   CurObject.GrpList.Clear();
   SELECT :CurObject.GrpList[i].OperatorName = P.WorkGroup,
          :CurObject.GrpList[i].PrimaryGrouping = Count(P.WorkGroup)
   FROM  SOA_InServicePermit P,
         SOA_ISPermitRequest R
   WHERE :DynamicWhereClause
   GROUP BY P.WorkGroup
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.WorkGroup = '' OR CurObject.WorkGroup = 'SSM' THEN
      DynamicWhereClause = 'P.WorkGroup = ''SSM'' AND ' + 
             'P.Substation = G.Member AND ' + 
             'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.GroupingType = 22648 AND ' +
             'G.Grouping = O.Object AND ' + StatusClause;
             
      SELECT :CurObject.GrpList[i].OperatorName = O.Name,
             :CurObject.GrpList[i].PrimaryGrouping = Count(O.Name)
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R,
             Udb_Grouping G,
             Udb_Object O
      WHERE  :DynamicWhereClause
      GROUP BY O.Name
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   
   IF CurObject.WorkGroup = '' OR CurObject.WorkGroup = 'ECB' THEN
      DynamicWhereClause = 'P.WorkGroup = ''ECB'' AND ' + 
             'P.Division = G.Member AND ' + 
             'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.GroupingType = 22615 AND ' +
             'G.Grouping = O.Object AND ' + StatusClause;

      SELECT :CurObject.GrpList[i].OperatorName = O.Name,
             :CurObject.GrpList[i].PrimaryGrouping = Count(O.Name)
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R,
             Udb_Grouping G,
             Udb_Object O
      WHERE  :DynamicWhereClause
      GROUP BY O.Name
      BEGIN
         i = i + 1;
      END;
   ENDIF;   

   IF CurObject.WorkGroup = '' OR CurObject.WorkGroup = 'PST' THEN
      DynamicWhereClause = 'P.WorkGroup = ''PST'' AND ' + 
             'P.Division = G.Member AND ' + 
             'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.GroupingType = 22619 AND ' +
             'G.Grouping = O.Object AND ' + StatusClause;

      SELECT :CurObject.GrpList[i].OperatorName = O.Name,
             :CurObject.GrpList[i].PrimaryGrouping = Count(O.Name)
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R,
             Udb_Grouping G,
             Udb_Object O
      WHERE  :DynamicWhereClause
      GROUP BY O.Name
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   IF CurObject.WorkGroup = '' OR CurObject.WorkGroup = 'TMG' THEN
      DynamicWhereClause = 'P.WorkGroup = ''TMG'' AND ' + 
             'P.Division = G.Member AND ' + 
             'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.GroupingType = 22642 AND ' +
             'G.Grouping = O.Object AND ' + StatusClause;

      SELECT :CurObject.GrpList[i].OperatorName = O.Name,
             :CurObject.GrpList[i].PrimaryGrouping = Count(O.Name)
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R,
             Udb_Grouping G,
             Udb_Object O
      WHERE  :DynamicWhereClause
      GROUP BY O.Name
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   IF CurObject.WorkGroup = '' OR CurObject.WorkGroup = 'Cap_Const.' THEN
      DynamicWhereClause = 'P.WorkGroup = ''Cap_Const.'' AND ' + 
             'P.Division = G.Member AND ' + 
             'G.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.GroupingType = 22901 AND ' +
             'G.Grouping = O.Object AND ' + StatusClause;

      SELECT :CurObject.GrpList[i].OperatorName = O.Name,
             :CurObject.GrpList[i].PrimaryGrouping = Count(O.Name)
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R,
             Udb_Grouping G,
             Udb_Object O
      WHERE  :DynamicWhereClause
      GROUP BY O.Name
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   CurObject.GrpList.Sort(OperatorName = 1);
   RETURN;
END;

METHOD Load_DeniedISWPList (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   StatusClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   GroupClause = VARCHAR(500) NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   GroupObject = INTEGER NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load denied iswp request by working groups 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      /*
      **  Build effective division based on input parameters passed in.
      */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;

      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF;  
   ENDIF;

   GroupClause = '';
   IF CurObject.WorkGroup LIKE 'SSM_%' THEN
      GroupObject = 0;
      SELECT :GroupObject = Object
      FROM   UDB_Object
      WHERE  Type = 22648 AND               //SSM
             Name = :CurObject.WorkGroup;

      GroupClause = ' P.WorkGroup = ''SSM'' AND P.Substation IN ( ' + 
             ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
             ' AND Grouping = ' + VARCHAR(GroupObject) + 
             ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ') AND ';

   ELSEIF CurObject.WorkGroup LIKE 'ECB_%' THEN
      GroupList = '';
      SELECT :Division = G.Member
      FROM   UDB_Object O,
             UDB_Grouping G
      WHERE  O.Type = 22615 AND               // ECB
             O.Name = :CurObject.WorkGroup AND
             O.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Division
      BEGIN
         IF GroupList <> '' THEN
            GroupList = GroupList + ',';
         ENDIF;
         GroupList = GroupList + VARCHAR(Division);
      END;

      GroupClause = ' P.WorkGroup = ''ECB'' AND P.Division IN (' + GroupList + ') AND ';
      
   ELSEIF CurObject.WorkGroup LIKE 'PST_%' THEN
      GroupList = '';
      SELECT :Division = G.Member
      FROM   UDB_Object O,
             UDB_Grouping G
      WHERE  O.Type = 22619 AND               // PST
             O.Name = :CurObject.WorkGroup AND
             O.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Division
      BEGIN
         IF GroupList <> '' THEN
            GroupList = GroupList + ',';
         ENDIF;
         GroupList = GroupList + VARCHAR(Division);
      END;

      GroupClause = ' P.WorkGroup = ''PST'' AND P.Division IN (' + GroupList + ') AND ';

   ELSEIF CurObject.WorkGroup LIKE 'TMG_%' THEN
      GroupList = '';
      SELECT :Division = G.Member
      FROM   UDB_Object O,
             UDB_Grouping G
      WHERE  O.Type = 22642 AND               // TMG
             O.Name = :CurObject.WorkGroup AND
             O.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Division
      BEGIN
         IF GroupList <> '' THEN
            GroupList = GroupList + ',';
         ENDIF;
         GroupList = GroupList + VARCHAR(Division);
      END;

      GroupClause = ' P.WorkGroup = ''TMG'' AND P.Division IN (' + GroupList + ') AND ';
      
   ELSEIF CurObject.WorkGroup LIKE 'Cap_Const%' THEN
      GroupList = '';
      SELECT :Division = G.Member
      FROM   UDB_Object O,
             UDB_Grouping G
      WHERE  O.Type = 22901 AND               // Cap_Const.
             O.Name = :CurObject.WorkGroup AND
             O.Object = G.Grouping AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Division
      BEGIN
         IF GroupList <> '' THEN
            GroupList = GroupList + ',';
         ENDIF;
         GroupList = GroupList + VARCHAR(Division);
      END;

      GroupClause = ' P.WorkGroup = ''Cap_Const.'' AND P.Division IN (' + GroupList + ') AND ';
   ELSE
      GroupClause = ' P.WorkGroup = ''' + VARCHAR(CurObject.WorkGroup) + ''' AND ';
   ENDIF;
   
   StatusClause = '';
   IF CurObject.IDFilter > 0 THEN
      StatusClause = ' P.ISPermit=' + VARCHAR(CurObject.IDFilter) + ' AND ';
   ENDIF;
   
   StatusClause = StatusClause + 
          ' P.ISPermit = R.ISPermit AND ' + 
          ' R.CurrentStatus = ''DENIED'' AND ' +
          '(P.StatusTime BETWEEN DATE(''' + VARCHAR(:CurObject.StartDate) +
             ''') AND DATE(''' + VARCHAR(:CurObject.EndDate) + ''')) AND ' + 
          'P.Division IN (';

   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         StatusClause = StatusClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         StatusClause = StatusClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   StatusClause = StatusClause + 
      ' AND P.Division = OD.Object AND ' +
      ' P.Substation = OS.Object AND ' + 
      ' P.IsPermit = L.ISPermit AND ' + 
      ' P.StatusTime = L.LogTime AND ' + 
      ' L.LogText LIKE ''R%'' ';          // there are two log entries when a permit is denied. Only one when a request is denied

   DynamicWhereClause = GroupClause + StatusClause;
   
   i = 1;
   CurObject.PRList.Clear();
   SELECT :CurObject.PRList[i].RequestID = R.ISPermit,
          :CurObject.PRList[i].WorkGroup = P.WorkGroup,
          :CurObject.PRList[i].DivisionName = OD.Name,
          :CurObject.PRList[i].SubstationName = OS.Name,
          :CurObject.PRList[i].RequestTitle = R.PermitMove, 
          :CurObject.PRList[i].IsPreIssued = P.PreIssued,
          :CurObject.PRList[i].ShiftStartTime = P.ShiftStartTime,
          :CurObject.PRList[i].SubmitTime = R.SubmitTime,
          :CurObject.PRList[i].DelayReason = R.DelayReason,
          :CurObject.PRList[i].DOApprove = P.StatusTime,
          :CurObject.PRList[i].DenyReason = L.LogText
   FROM   SOA_ISPermitRequest R,
          SOA_InServicePermit P,
          Udb_Object OD,
          Udb_Object OS,
          SOA_ISPLog L
   WHERE :DynamicWhereClause
   ORDER BY 3, 4, 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;
      
METHOD Load_PermitRequestData (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;

   DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   DenyWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   GroupClause = VARCHAR(500) NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   GroupObject = INTEGER NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;

   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Permit Request Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      /*
      **  Build effective division based on input parameters passed in.
      */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;

      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF;  
   ENDIF;

   GroupClause = '';
   IF CurObject.WorkGroup <> '' THEN
      IF CurObject.WorkGroup LIKE 'SSM_%' THEN
         GroupObject = 0;
         SELECT :GroupObject = Object
         FROM   UDB_Object
         WHERE  Type = 22648 AND               //SSM
                Name = :CurObject.WorkGroup;

         GroupClause = ' P.WorkGroup = ''SSM'' AND P.Substation IN ( ' + 
                ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
                ' AND Grouping = ' + VARCHAR(GroupObject) + 
                ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'ECB_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22615 AND               // ECB
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''ECB'' AND P.Division IN (' + GroupList + ') AND ';
         
      ELSEIF CurObject.WorkGroup LIKE 'PST_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22619 AND               // PST
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''PST'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'TMG_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22642 AND               // TMG
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''TMG'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.WorkGroup LIKE 'Cap_Const_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22901 AND               // Cap_Const.
                O.Name = :CurObject.WorkGroup AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;

         GroupClause = ' P.WorkGroup = ''Cap_Const.'' AND P.Division IN (' + GroupList + ') AND ';
      ELSE
         GroupClause = ' P.WorkGroup = ''' + VARCHAR(CurObject.WorkGroup) + ''' AND ';
      ENDIF;
   ENDIF;
   
   IF CurObject.Application = 'ISWP' THEN
      DynamicWhereClause = GroupClause + 
             'R.ISPermit = P.ISPermit AND ' +
             'P.Job = J.Job AND ' +
             ' (J.TOIssued BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
                '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ' + 
             'P.Division = OD.Object AND ' +
             'P.Substation = OS.Object AND ' +
             'P.Division IN (';

      DenyWhereClause = GroupClause + 
             'R.CurrentStatus = ''DENIED'' AND ' + 
             'R.ISPermit = P.ISPermit AND ' +
             'P.Division = OD.Object AND ' +
             'P.Substation = OS.Object AND ' +
             '(P.StatusTime BETWEEN DATE(''' + VARCHAR(:CurObject.StartDate) +
                ''') AND DATE(''' + VARCHAR(:CurObject.EndDate) + ''')) AND ' + 
             'P.ISPermit = L.ISPermit AND ' +
             'P.StatusTime = L.LogTime AND ' +
             'L.LogText LIKE ''R%'' AND ' +
             'P.Division IN (';

      i = 1;
      WHILE i <= EffectiveDivisions.LastRow() DO

         IF i = EffectiveDivisions.LastRow() THEN
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';

            DenyWhereClause = DenyWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ')';
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';

            DenyWhereClause = DenyWhereClause + 
               VARCHAR(EffectiveDivisions[i].Object) + ',';       
         ENDIF;
         i = i + 1;
      ENDWHILE;

      IF CurObject.IDFilter > 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND P.ISPermit=' + VARCHAR(CurObject.IDFilter);
         DenyWhereClause = DenyWhereClause + ' AND P.ISPermit=' + VARCHAR(CurObject.IDFilter);
      ENDIF;
   
      i = 1;
      CurObject.PRList.Clear();
      
      REPEATED
      SELECT :CurObject.PRList[i].PermitTypeName = 'IS',
             :CurObject.PRList[i].PermitJobID = R.ISPermit,
             :CurObject.PRList[i].WorkGroup = P.WorkGroup,
             :CurObject.PRList[i].DivisionName = OD.Name,
             :CurObject.PRList[i].SubstationName = OS.Name,
             :CurObject.PRList[i].RequestTitle = R.PermitMove, 
             :CurObject.PRList[i].Description = R.Description,
             :CurObject.PRList[i].IsPreIssued = P.PreIssued,
             :CurObject.PRList[i].ShiftStartTime = P.ShiftStartTime,
             :CurObject.PRList[i].SubmitTime = R.SubmitTime,
             :CurObject.PRList[i].DelayReason = R.DelayReason,
             :CurObject.PRList[i].DOIssueTime = J.TOIssued,
             :CurObject.PRList[i].Job = J.Job,
             :CurObject.PRList[i].DOApprove = '',
             :CurObject.PRList[i].DenyReason = ''
      FROM   SOA_ISPermitRequest R,
             SOA_InServicePermit P,
             Udb_Object OD,
             Udb_Object OS,
             SOA_Job J
      WHERE :DynamicWhereClause
      UNION
      SELECT 'IS',
             R.ISPermit,
             P.WorkGroup,
             OD.Name,
             OS.Name,
             R.PermitMove, 
             R.Description,
             P.PreIssued,
             P.ShiftStartTime,
             R.SubmitTime,
             R.DelayReason,
             J.TOIssued,
             J.Job,
             '',
             ''
      FROM   SOA_ISPermitRequest R,
             SOA_InServicePermit P,
             Udb_Object OD,
             Udb_Object OS,
             SOA_ArchiveJob J
      WHERE :DynamicWhereClause
      UNION
      SELECT 'IS',
             R.ISPermit,
             P.WorkGroup,
             OD.Name,
             OS.Name,
             R.PermitMove, 
             R.Description,
             P.PreIssued,
             P.ShiftStartTime,
             R.SubmitTime,
             R.DelayReason,
             L.LogTime,  /* Help with sorting, will remove below */
             0,
             L.LogTime,
             L.LogText
      FROM   SOA_ISPermitRequest R,
             SOA_InServicePermit P,
             Udb_Object OD,
             Udb_Object OS,
             SOA_ISPLog L
      WHERE :DenyWhereClause
      ORDER BY DOIssueTime
      BEGIN
         i = i + 1;
      END;
   
   ELSEIF CurObject.Application = 'OSWP' THEN
      /* Should not be here*/
   ENDIF;
   
   FOR i = 1 TO CurObject.PRList.LastRow DO
      /*
      **  Merge permit type and id together.
      */
      CurObject.PRList[i].PermitName = CurObject.PRList[i].PermitTypeName + '-' + 
                                       varchar(CurObject.PRList[i].PermitJobID);             
      /*
      **  If Permit Move is blank we will show description field.
      */
      IF CurObject.PRList[i].RequestTitle = '' THEN
         CurObject.PRList[i].RequestTitle = 'DESCRIPTION: ' + CurObject.PRList[i].Description;
      ENDIF;
      /*
      **  Set the request time.  If pre-issued, use ShiftStartTime, otherwise use Submit time.
      */
      IF CurObject.PRList[i].IsPreIssued = 1 THEN
         CurObject.PRList[i].RequestTime = CurObject.PRList[i].ShiftStartTime;
      ELSE
         CurObject.PRList[i].RequestTime = CurObject.PRList[i].SubmitTime;
      ENDIF;
      /*
      **  Clean up TOIssued time for denied requests.  The denied time was put
      **  in to help sort by time. 
      */
      IF CurObject.PRList[i].DOApprove <> '' THEN
         CurObject.PRList[i].DOIssueTime = ''; 
      ENDIF;

      IF CurObject.PRList[i].PermitTypeName = 'IS' THEN
         /*
         **  Get DO Approve Time from SOA_ISPLog table.  
         */
         IF CurObject.PRList[i].DOApprove = '' THEN  
            /* 
            **  Look for APPROVED TIME 
            */
            SELECT :CurObject.PRList[i].DOApprove = L.LogTime
            FROM    SOA_ISPLog L
            WHERE   L.ISPermit = :CurObject.PRList[i].PermitJobID AND
                    lowercase(L.LogText) like 'permit status changed to issued%'; 
            CALLPROC DDB_ROLLBACK;
         ENDIF;
      ENDIF;
      /*
      **  Set the Issue Time - Permit must be issued to show this time i.e. toissued <> ''.
      **  If pre-issued, show the latest between shiftstarttime and ToIssued. 
      */
      IF CurObject.PRList[i].DOIssueTime <> '' THEN
         CurObject.PRList[i].IssueTime = CurObject.PRList[i].DOIssueTime;
         IF CurObject.PRList[i].IsPreIssued = 1 AND
            CurObject.PRList[i].ShiftStartTime > CurObject.PRList[i].DOIssueTime THEN
            CurObject.PRList[i].IssueTime = CurObject.PRList[i].ShiftStartTime;
         ENDIF;
      ENDIF;
      /*
      **  See if permit was issued electronically.  IF yes, get acknowledge time.
      */
      IF CurObject.PRList[i].Job <> 0 THEN
         SELECT :CurObject.PRList[i].SSOAcknowledge_BGColor = :CC_PALE_GREEN,
                :CurObject.PRList[i].SSOAcknowledge = O.AckRejectTime
         FROM    IR_OperatingOrder O,
                 IR_OpOrderJobs OJ
         WHERE   OJ.Job = :CurObject.PRList[i].Job AND
                 OJ.OrderNumber = O.OrderNumber;
         CALLPROC DDB_ROLLBACK;
      ENDIF;        
      /*
      **  Set up DO Ack Delay
      */
      IF CurObject.PRList[i].DOApprove = '' THEN
         CurObject.PRList[i].DOAckDelayColor = CC_BLUE;
         CurObject.PRList[i].DOAckDelayInt = INT4(interval('minute', DATE('NOW') - DATE(CurObject.PRList[i].RequestTime)));
      ELSE
         CurObject.PRList[i].DOAckDelayColor = CC_FOREGROUND;
         CurObject.PRList[i].DOAckDelayInt = INT4(interval('minute', DATE(CurObject.PRList[i].DOApprove) - DATE(CurObject.PRList[i].RequestTime)));
      ENDIF;
      IF CurObject.PRList[i].DOAckDelayInt < 0 THEN
         CurObject.PRList[i].DOAckDelayInt = 0;
      ENDIF;
      IF CurObject.PRList[i].DOAckDelayInt <> 0 THEN
         CurObject.PRList[i].DOAckDelay = CALLPROC ConvertHour(Tot_Min = CurObject.PRList[i].DOAckDelayInt);
      ENDIF;
      /*
      **  Set up Issue Delay, No delay for denied permit request
      */
      IF CurObject.PRList[i].DenyReason = '' THEN  
         IF CurObject.PRList[i].IssueTime = '' THEN
            CurObject.PRList[i].IssueDelayColor = CC_BLUE;
            CurObject.PRList[i].IssueDelayInt = INT4(interval('minute', DATE('NOW') - DATE(CurObject.PRList[i].RequestTime)));
         ELSE
            CurObject.PRList[i].IssueDelayColor = CC_FOREGROUND;
            CurObject.PRList[i].IssueDelayInt = INT4(interval('minute', DATE(CurObject.PRList[i].IssueTime) - DATE(CurObject.PRList[i].RequestTime)));
         ENDIF;
         IF CurObject.PRList[i].IssueDelayInt < 0 THEN
            CurObject.PRList[i].IssueDelayInt = 0;
         ENDIF;
         IF CurObject.PRList[i].IssueDelayInt <> 0 THEN
            CurObject.PRList[i].IssueDelay = CALLPROC ConvertHour(Tot_Min = CurObject.PRList[i].IssueDelayInt);
         ENDIF;
      ENDIF;
      /*
      **  Set up SSOAck Delay
      */
      IF CurObject.PRList[i].SSOAcknowledge = '' THEN
         CurObject.PRList[i].SSOAckDelayColor = CC_BLUE;
         CurObject.PRList[i].SSOAckDelayInt = INT4(interval('minute', DATE('NOW') - DATE(CurObject.PRList[i].IssueTime)));
      ELSE
         CurObject.PRList[i].SSOAckDelayColor = CC_FOREGROUND;
         CurObject.PRList[i].SSOAckDelayInt = INT4(interval('minute', DATE(CurObject.PRList[i].SSOAcknowledge) - DATE(CurObject.PRList[i].IssueTime)));
      ENDIF;
      IF CurObject.PRList[i].SSOAckDelayInt < 0 THEN
         CurObject.PRList[i].SSOAckDelayInt = 0;
      ENDIF;
      IF CurObject.PRList[i].SSOAckDelayInt <> 0 THEN
         CurObject.PRList[i].SSOAckDelay = CALLPROC ConvertHour(Tot_Min = CurObject.PRList[i].SSOAckDelayInt);
      ELSE
         CurObject.PRList[i].SSOAckDelayColor = CC_FOREGROUND;
      ENDIF;
   ENDFOR;

   RETURN;
END;


METHOD UpdateDelayReasons(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PRList.LastRow DO
      IF CurObject.PRList[i].PermitName LIKE 'IS_%' THEN
         CurObject.PRList[i].PermitTypeName = 'IS';
         CurObject.PRList[i].PermitJobID = INT4(SHIFT(CurObject.PRList[i].PermitName, -3));
         CurObject.PRList[i].UpdateDelayReason(UpdatePerson = CurObject.OperatorName);

      ELSEIF CurObject.PRList[i].PermitName LIKE 'OS_%' THEN
         CurObject.PRList[i].PermitTypeName = 'OS';
         CurObject.PRList[i].PermitJobID = INT4(SHIFT(CurObject.PRList[i].PermitName, -3));
         CurObject.PRList[i].UpdateDelayReason(UpdatePerson = CurObject.OperatorName);

      ENDIF; 
   ENDFOR;

   RETURN;
END;

Application Component Report
============================

	Name:            PickupEquipment

/*
**
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation.
**
**  Application:    CAC
**  Frame:          PickupEquipment
**
**  Date:           Version  Description
** --------------------------------------------------
**  JAN 93          adl      author
**  02/10/93        em       New equip defined as being member of division
**                           and not inservice AND not outofservice.
**  02/12/93        em       Must use EffectiveDivisions to delimit equipment
**                           list.
**  02/24/93       adl      Added call to ConfirmPickupEquip frame to confirm
**                          selection of equipment to pick up.
**  05/26/93       em       added call to originalcard to update feeder
**                          details.
**  11/24/93       em       use object type instead of member type
**  02/10/94       em       dynamic where clause used to help select
**                          performance
**  04/04/94	   hlf	    add search capability on equipment name
**							 and division qualifier
**  06/16/94       pw       Add NewEquipMove flag so that screen can be used to
**                          select new equip to add moves to a card
**  10/19/94       pw       preform search right away when division is selected and
**                           make ground button toggle.
**  12/14/94       bgh      Added copying of Equipclass field to ChosenEquip array.
**  12/15/94       pw       Force user to pick ground move when grounding equipment
**  03/10/95       pw       Show moves assigned to new equipment               
**  01/09/97       jfl      fms189: Handle set up of associations to groupers
**  03/17/97       jfl      Use MacroGrouper to exclude grouper types.
**  06/26/98       pkw      Improve select performance when excluding macrogrouper
**  08/02/02       pkw      Merge PickupNew and PickupDropped equipment screens.
**  08/26/02       ysp      Merge: use common job tables and classes. Remove Jobs from
**                           SelectGroundMove's parameter list.
**  03/18/04       ysp      ITC150:Added grouping history button
**  07/06/04       em       Disable Ground button for SICC users.
**  02/25/05       em       After selecting Ground move and inserting ground status
**                          call FGroundOnUpd procedure with Job = 0 just so it updates all
**                          moves with the ground count.
**  03/10/05       ysp      Update the ground counts after the user removes grounds from the
**                          Associated Move screen. The userevent name is "Update_Equip_Ground".
**  09/01/05       ysp      When the DO wants to remove the ground (by clicking the ground button),
**                          bring up the View Move screen for him to restore the ground move.
**                          In this way, the corresponding N move's time stamp is updated.
**  12/14/05       ysp      Increase the size of wp tomove to 160 chars
**  02/20/06       ysp      Show Out of Service timestamp for dropped equipment
**  05/15/06       ysp      Remove FCR entered pickup equipment info because it is always invisible.
**                          The data is actually displayed in FCR Return Option screen.
**  05/08/07       ysp      Add Issue Move button (invisible at this time, to be completed)
**  09/07/13       pkw      Pair selects of SD-VIS and SD-TRANSF.
**  07/14/15       em       IsPopup = TRUE
**                          Allow selection of ATS Grouper for purpose of adding moves.
**                          Don't allow ATS Grouper to be selected for Pickup.
**  08/22/15       pkw      Add FilterATS; Don't show ATSGrouper when picking up equipment
**  02/29/16       em       Consolidate method of managing moves, don't distinguish ground moves separately.
**  03/24/16       em       If selected equipment has a fake move on the current card, use that printid rather
**                          than prompting for another to eliminate duplicate prompt.
**  04/07/16       em       Display ViewMoves on any equip click when it has moves, not just 
**                          the checkmark click. Update Ground count following Issue Move.
**  05/23/16       em       Remove highlighted row when ViewMoves closed.
*/
INITIALIZE   
(
    C = FMS_Card;	    			       /* parameter - current card */ 
    EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* Available divisions*/
    NewEquipMove = INTEGER NOT NULL WITH DEFAULT;      /* passed in */ 
    NewEquip = FMS_Equip;                              /* passed in */ 

/* local variables */
    ChosenEquip = ARRAY of FMS_Equip; 	/* Equipment selected for pickup */ 
    AllEquip = ARRAY of FMS_Equip;		/* Array of all new equipment */
    i = integer;	    				/* Temporary counter */ 
    j = integer;	    				/* Temporary counter */ 
    k = integer;	    				/* Temporary counter */ 
    status = integer;   				/* return status variable */ 
    entrymade = integer;		/* logical to see if an entry was made */ 
    lastdivision = integer not null;	/* holder for last division */
    vequipname = VARCHAR(12) NOT NULL NOT DEFAULT;
    DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
    CurrentRow = INTEGER;
    IDText = varchar(2);    
    DetailsFrame = FrameExec;
    OrigCard = FrameExec;
    MoveCnt = INTEGER NOT NULL WITH DEFAULT;
    UpdatedEquip = INTEGER NOT NULL WITH DEFAULT;
    FilterATS = INTEGER NOT NULL WITH DEFAULT;     
) =
DECLARE
   SD_Link = PROCEDURE;
ENDDECLARE
/*
**  Load the data for the equipment selection from the database 
**  into the 4GL environment and set up the display: 
*/
BEGIN
   IF NewEquipMove = TRUE THEN
       NewEquip = NULL;
       CurFrame.WindowTitle = 'Add new move for selected equipment';
       Field(SelectEquip).Title = 'Add new move for selected equipment';
       Field(Done_Btn).TextLabel = 'OK';
       FilterATS = 0;
   ELSE
       FilterATS = 1;
   ENDIF;
   SelectEquip.Clear();	/* Clear out storage */ 
   entrymade = 0; /* initialize - no entry made yet */ 	

/*
**   Load up the division optionfield.
*/
    FIELD(division).ValueList.ChoiceItems[1].EnumValue = 0;	
    FIELD(division).ValueList.ChoiceItems[1].EnumText = '';	
    j = 1;
    WHILE (j <= EffectiveDivisions.LastRow()) DO
	FIELD(division).ValueList.ChoiceItems[j+1].EnumValue =
				EffectiveDivisions[j].Object;	
	FIELD(division).ValueList.ChoiceItems[j+1].EnumText =	
				EffectiveDivisions[j].Name;	
        j = j + 1;
    ENDWHILE;

    DetailsFrame = OPENFRAME ViewMoves (ParentFrame = CurFrame,
                                        C = C);
    IF NewEquipMove <> TRUE THEN
       OrigCard = OpenFrame OriginalCard (C = C);
    ENDIF;
END;

ON SetValue EquipType =
BEGIN
    Division = 0;
    SelectEquip.Clear();
END;


ON SetValue Division =
BEGIN
    IF (division != 0) THEN
        lastdivision = division;
        Curframe.SendUserEvent (Eventname = 'SelectEquip');
    ELSE
        message 'You must select a division.';
        division = lastdivision;
    ENDIF;
END;

ON USEREVENT 'SelectEquip' =
BEGIN
/*  Reset the entrymade flag each time equipment is selected. */
    entrymade = 0;

/*
**  Clear SelectEquip array,  because if the first row IsReverse then 
**  the entire array will be IsReverse when SelectEquip array is loaded
*/
    SelectEquip.Clear();
    AllEquip.Clear();
    i = 1; 
    IF EquipType = 1 THEN  /* new equipment */
       REPEATED SELECT 
               :AllEquip[i].Equip = O.Object, 
               :AllEquip[i].EquipName = O.Name, 
               :AllEquip[i].EquipClass  = O.Type,
               :AllEquip[i].EquipClassName  = O.TypeName,
               :AllEquip[i].Outservice  = O.Outservice, 
               :AllEquip[i].Description = O.Description
       FROM   Udb_Object O, 
              Udb_Grouping G 
       WHERE  G.Grouping = :Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType IN (:Type$AbstractHTV,
                                                                     :Type$ISOGrouper,
                                                                     :Type$Loop) OR
                                                      (1 = :FilterATS AND
                                                       SuperType = :Type$ATSGrouper)))
       AND    O.OutService IS NULL
       AND    O.InService IS NULL
       ORDER BY EquipName
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;
    ELSEIF EquipType = 2 THEN  /* dropped equipment */
       REPEATED SELECT 
           :AllEquip[i].Equip = O.Object, 
           :AllEquip[i].EquipName = O.Name, 
           :AllEquip[i].EquipClass  = O.Type,
           :AllEquip[i].EquipClassName  = O.TypeName,
           :AllEquip[i].Outservice  = O.Outservice, 
           :AllEquip[i].Description = O.Description
       FROM   Udb_Object O, 
              Udb_Grouping G 
       WHERE  G.Grouping = :Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object 
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType IN (:Type$AbstractHTV,
                                                                     :Type$ISOGrouper,
                                                                     :Type$Loop) OR
                                                      (1 = :FilterATS AND
                                                       SuperType = :Type$ATSGrouper)))
       AND    O.Outservice IS NOT NULL 
       AND    O.Outservice <> ''
       ORDER BY EquipName
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;
    ENDIF;

/*
**  Get ground count for equipment,
**  and see if there are any moves assigned to equipment
*/
    i = 1;
    WHILE i <= AllEquip.LastRow() DO
       SELECT  :AllEquip[i].G = O.StatusCount
       FROM    FMS_ObjectStatus O
       WHERE   O.Object = :AllEquip[i].Equip AND
               O.Status = :Status$Ground AND
                  O.StatusCount > 0;
       IF AllEquip[i].G = 0 THEN
          AllEquip[i].G = NULL;
       ENDIF;

       SELECT  :AllEquip[i].IsAssigned = Count(*)
       FROM    FMS_DroppedEquipJobs 
       WHERE   Equip = :AllEquip[i].Equip;

       i = i + 1;
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;    
/*
**	Put the equipment into an array that can be used for searching
**	for equiment names.  Save the number of equipment selected for
**	array access purposes.
*/
    IF (equip_filter <> '') THEN
       Curframe.SendUserEvent (Eventname = 'FilterList');
    ELSE
       SelectEquip = AllEquip.Duplicate();
    ENDIF;
END;
/*
**  Handle an equipment selection from the list: 
*/
ON ChildEntry SelectEquip =
BEGIN
    IF (CurFrame.ReasonCode <> RC_MOUSECLICK) THEN 
       RESUME; 
    ENDIF; 
    IF SelectEquip[].IsAssigned > 0 THEN
       DetailsFrame.SendUserEvent (EventName = 'load_moves',
                                   MessageInteger = SelectEquip[].Equip);
    ELSE 
       DetailsFrame.WindowVisibility = WV_INVISIBLE;
    ENDIF;

    entrymade = 1;
    IF NewEquipMove = TRUE THEN   /*  called from newmoves screen */
       /*  
       **  Only one row can be highlighted at a time
       */
       i = 1;
       WHILE i <= SelectEquip.LastRow() DO
          IF FIELD(SelectEquip[i].Description).IsReverse = TRUE THEN 
             FIELD(SelectEquip[i].Description).IsReverse = FALSE; 
             FIELD(SelectEquip[i].OutService).IsReverse = FALSE; 
             FIELD(SelectEquip[i].G).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipName).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipClassName).IsReverse = FALSE; 
             ENDLOOP;
          ENDIF; 
          i = i + 1;
       ENDWHILE;

       FIELD(SelectEquip[].Description).IsReverse = TRUE; 
       FIELD(SelectEquip[].G).IsReverse = TRUE; 
       FIELD(SelectEquip[].EquipName).IsReverse = TRUE;
       FIELD(SelectEquip[].EquipClassName).IsReverse = TRUE; 

    ELSE                         /*  called from menu at top of card */
       IF (FIELD(SelectEquip[].Description).IsReverse = FALSE) THEN 
          FIELD(SelectEquip[].Description).IsReverse = TRUE; 
          FIELD(SelectEquip[].OutService).IsReverse = TRUE; 
          FIELD(SelectEquip[].G).IsReverse = TRUE; 
          FIELD(SelectEquip[].EquipName).IsReverse = TRUE; 
          FIELD(SelectEquip[].EquipClassName).IsReverse = TRUE; 
          
          CALLPROC SD_Link(Object = SelectEquip[].Equip,
                       IsReverse = TRUE,
                       Type = SelectEquip[].EquipClass);
       ELSE 
          FIELD(SelectEquip[].Description).IsReverse = FALSE; 
          FIELD(SelectEquip[].OutService).IsReverse = FALSE; 
          FIELD(SelectEquip[].G).IsReverse = FALSE; 
          FIELD(SelectEquip[].EquipName).IsReverse = FALSE; 
          FIELD(SelectEquip[].EquipClassName).IsReverse = FALSE; 
          
          CALLPROC SD_Link(Object = SelectEquip[].Equip,
                       IsReverse = FALSE,
                       Type = SelectEquip[].EquipClass);
       ENDIF; 
    ENDIF;
END; 
/*
** Commenting Ground button logic to keep available pending testing for 
** possible ground handling changes.
ON CLICK GroundEquip_Btn =
BEGIN
   i = SelectEquip.FirstRow(); 
   j = 1; 
   WHILE (i <= SelectEquip.LastRow()) DO  
   
       IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN
          /*
          **  Close ViewMoves frame if it is up
          *
          DetailsFrame.WindowVisibility = WV_Invisible;

          /*
          ** 09/01/05 - if the DO wants to remove the ground in the new/drop bank,
          ** he has to restore the ground move because there is possible an N move
          ** whose time stamps need to be updated.
          *
          IF SelectEquip[i].IsAssigned > 0 AND
             SelectEquip[i].G >= 1 THEN
             DetailsFrame.SendUserEvent (EventName = 'load_moves',
                                         MessageInteger = SelectEquip[i].Equip);
            RESUME;

          ELSEIF SelectEquip[i].G >= 1 THEN  
             /*
             ** If we get here, we don't have a ground job in the bank and the equipment
             ** has a ground status. It is rare, but we keep the code here.
             *
             status = CALLPROC FMS_DroppedEquipJobsDel(
                                     Equip = SelectEquip[i].Equip);
             IF status < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to remove ground move for equipment: ' +
                        SelectEquip[i].EquipClassName + '  ' +
                        SelectEquip[i].EquipName;
                RESUME;
             ENDIF;                                               
             CALLPROC DDB_COMMIT; 

             status = CALLPROC FMS_ObjStatDel(
                                   Object = :SelectEquip[i].Equip,
                                   Status = Status$Ground);
             IF status < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to remove ground status for equipment: ' +
                        SelectEquip[i].EquipClassName + '  ' +
                        SelectEquip[i].EquipName;
                RESUME;
             ENDIF;                                               
             CALLPROC DDB_COMMIT; 

             status = CALLPROC SOA_GroundOnUpd (Job = 0,
                                          GroundOn = NULL,
                                          Equip = SelectEquip[i].Equip);
             IF status = 0 THEN
                CALLPROC DDB_COMMIT;
             ELSE
                CALLPROC DDB_ROLLBACK;
                MESSAGE 'Error occurred while setting G grounds count for moves ' +
                  'related to this equipment.';
             ENDIF;

             SelectEquip[i].G = NULL;
             /*
             ** Select here because there might be a non-ground 
             ** move still around
             *
             MoveCnt = 0;
             REPEATED
             SELECT  :MoveCnt = Count(*)
             FROM    FMS_DroppedEquipJobs 
             WHERE   Equip = :SelectEquip[i].Equip;
          
             SelectEquip[i].IsAssigned = MoveCnt;

             k = 1;
             WHILE k <= AllEquip.LastRow() DO
                IF SelectEquip[i].Equip = AllEquip[k].Equip THEN
                   AllEquip[k].G = NULL;
                   AllEquip[k].IsAssigned = MoveCnt;
                   ENDLOOP; /* only one ground will be added in this case *
                ENDIF;
                k = k + 1;
             ENDWHILE;

          ELSE 
             status = CALLFRAME SelectGroundMove(SelectEquip = SelectEquip[i],
                                                 C = C);
             IF status < 0 THEN
                RESUME;
             ENDIF;

             status = CALLPROC FMS_ObjStatIns(Object = :SelectEquip[i].Equip,
                                     Status = Status$Ground,
                                     StatusCount = 1,
                                     TimeSet = 'now');
             IF status < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to set ground status for equipment: ' +
                         SelectEquip[i].EquipClassName + '  ' +
                         SelectEquip[i].EquipName;
                RESUME;
             ENDIF;
             CALLPROC DDB_COMMIT; 

             status = CALLPROC SOA_GroundOnUpd (Job = 0,
                                          GroundOn = NULL,
                                          Equip = SelectEquip[i].Equip);
             IF status = 0 THEN
                CALLPROC DDB_COMMIT;
             ELSE
                CALLPROC DDB_ROLLBACK;
                MESSAGE 'Error occurred while setting G grounds count for moves ' +
                  'related to this equipment.';
             ENDIF;

             SelectEquip[i].G = 1;
             SelectEquip[i].IsAssigned = 1;
             k = 1;
             WHILE k <= AllEquip.LastRow() DO
                IF SelectEquip[i].Equip = AllEquip[k].Equip THEN
                   AllEquip[k].G = 1;
                   AllEquip[k].IsAssigned = 1;
                   ENDLOOP; /* only one ground will be added in this case *
                ENDIF;
                k = k + 1;
             ENDWHILE;
          ENDIF;                                               
       ENDIF;    
       i = i + 1; 
   ENDWHILE; 
    
END;
********************/

ON CLICK IssueMove_Btn =
BEGIN
   i = SelectEquip.FirstRow(); 
   j = 1; 
   WHILE (i <= SelectEquip.LastRow()) DO  
   
       IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN
          Status = CALLFRAME SelectGroundMove(SelectEquip = SelectEquip[i],
                                    C = C);
       ENDIF; 

       IF Status = PU_OK THEN
          MoveCnt = 0;
          SELECT  :MoveCnt = IFNULL(O.StatusCount,0)
          FROM    FMS_ObjectStatus O
          WHERE   O.Object = :SelectEquip[i].Equip AND
                  O.Status = :Status$Ground AND
                  O.StatusCount > 0;
          IF MoveCnt = 0 THEN
             SelectEquip[i].G = NULL;
          ELSE
             SelectEquip[i].G = MoveCnt;
          ENDIF;

          MoveCnt = 0;
          REPEATED
          SELECT  :MoveCnt = Count(*)
          FROM    FMS_DroppedEquipJobs 
          WHERE   Equip = :SelectEquip[i].Equip;
          
          SelectEquip[i].IsAssigned = MoveCnt;

          k = 1;
          WHILE k <= AllEquip.LastRow() DO
             IF SelectEquip[i].Equip = AllEquip[k].Equip THEN
                AllEquip[k].G = SelectEquip[i].G;
                AllEquip[k].IsAssigned = SelectEquip[i].IsAssigned;
                ENDLOOP; 
             ENDIF;
             k = k + 1;
          ENDWHILE;
          CurFrame.Flush();
       ENDIF;
       i = i + 1; 
   ENDWHILE;     
   Curframe.SendUserEvent (EventName = 'ViewMoves_Closed');
END;

/*
** Handle set up of associations to groupers
*/
ON CLICK SetGrouperLink_Btn =
BEGIN
    i = SelectEquip.FirstRow(); 
    WHILE i <= SelectEquip.LastRow() DO  
        IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN
            /*
            **  Allow to set associations with groupers
            */ 
            CALLFRAME SetGrouperLink (Equip = SelectEquip[i].Equip); 
        ENDIF;    
        i = i + 1; 
    ENDWHILE; 
END;

ON CLICK Grouping_Btn =
BEGIN
    i = SelectEquip.FirstRow(); 
    WHILE i <= SelectEquip.LastRow() DO  
        IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN
            /*
            **  Allow to set associations with groupers
            */ 
            CALLFRAME EquipGroupingHistory (Equip = SelectEquip[i].Equip); 
        ENDIF;    
        i = i + 1; 
    ENDWHILE; 
END;

ON USEREVENT 'FilterList',
ON CLICK Search_btn =
BEGIN
/*
**  Set entrymade back to zero because highlighting goes away
*/
    entrymade = 0;
/*
**	Set up the search filter for equipment.
*/
	IF (equip_filter != '') THEN
		vequipname = '%' + equip_filter + '%';
	ELSE
		vequipname = '%';
	ENDIF;
/*
**	Loop through the array to find all equipment that match the
**	search criteria.
*/
	i = 1;
	j = 1;
	SelectEquip.Clear();
	WHILE i <= AllEquip.LastRow() DO 
		IF (AllEquip[i].EquipName LIKE vequipname) THEN
		  	SelectEquip[j] = AllEquip[i].Duplicate();	
			j = j + 1;
		ENDIF;
		i = i + 1;
	ENDWHILE;
END;


ON USEREVENT 'ViewMoves_Closed' =
BEGIN
       i = 1;
       WHILE i <= SelectEquip.LastRow() DO
          IF FIELD(SelectEquip[i].Description).IsReverse = TRUE THEN 
             FIELD(SelectEquip[i].Description).IsReverse = FALSE; 
             FIELD(SelectEquip[i].OutService).IsReverse = FALSE; 
             FIELD(SelectEquip[i].G).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipName).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipClassName).IsReverse = FALSE; 
          ENDIF; 
          i = i + 1;
       ENDWHILE;
END;

ON Click Cancel_Btn,
ON Click Done_Btn =
BEGIN
/*
**  Check to see whether or not the original card data needs to be saved.
*/
    IF (Curframe.TriggerField = FIELD(Done_Btn)) THEN
        OrigCard.SendUserEvent (EventName = 'UpdateCard');
        Curframe.SendUserEvent (EventName = 'ContinueDone_Btn');
    ELSE
        OrigCard.SendUserEvent (EventName = 'ExitFrame');
        Curframe.SendUserEvent (EventName = 'ContinueCancel_Btn');
    ENDIF;
END;

/*
**  Handle a DONE click: 
*/
ON UserEvent 'ContinueDone_Btn' =
BEGIN
/*
**	Make them select a piece of equipment first.
*/
   IF (entrymade != 1) THEN
	   message 'You must first select a piece of equipment.';
	   RESUME;
   ENDIF;

   IF NewEquipMove = TRUE THEN
      i = 1;
      CurrentRow = 0;
      WHILE i <= SelectEquip.LastRow() DO
         IF FIELD(SelectEquip[i].Description).IsReverse = TRUE THEN 
            CurrentRow = i;
            ENDLOOP;
         ENDIF; 
         i = i + 1;
      ENDWHILE;

      IF CurrentRow = 0 THEN
         message 'Please select a piece of equipment';
      ELSE
         IF SelectEquip[i].PrintID = '' THEN
/*
** Check if this equipment has a fake move on the current card to prevent
** duplicate id prompt.
*/
            IDText = '';
            SELECT :IDText = IFNULL(JC.PrintID,'')
            FROM   SOA_Job J,
                   SOA_JobControl JC
            WHERE  JC.Card = :C.Card AND
                   JC.Job = J.Job AND
                   J.MoveCategory = :MoveCategory$Fake AND
                   J.Status = '' AND
                   J.Equip = :SelectEquip[i].Equip;
            IF IDText = '' THEN
               IDText = CALLFRAME GenericEntry ( 
                     PromptPhrase = 'Please enter ID for Equipment',
                     PhraseLength = 2);
            ENDIF;

            SelectEquip[CurrentRow].PrintID = IFNULL(IDText,'');
         ENDIF;

         NewEquip = SelectEquip[CurrentRow].Duplicate();
         Return;
      ENDIF;
   ELSE
      i = SelectEquip.FirstRow(); 
      j = 1; 
      WHILE (i <= SelectEquip.LastRow()) DO  
   
             IF (FIELD(SelectEquip[i].Description).IsReverse = TRUE) THEN
/*
** Check for and ignore ATS grouper if selected for pickup, only here for assigning N moves on card.
*/
               k = 0;
               SELECT :k = Type
               FROM   Udb_ExtendedType 
               WHERE  Type = :SelectEquip[i].EquipClass AND
                      SuperType = :Type$ATSGrouper;

               IF k = 0 THEN 
                  ChosenEquip[j].Description = SelectEquip[i].Description; 
                  ChosenEquip[j].EquipName = SelectEquip[i].EquipName; 
                  ChosenEquip[j].Equip = SelectEquip[i].Equip; 
                  ChosenEquip[j].EquipClassName = SelectEquip[i].EquipClassName; 
                  ChosenEquip[j].EquipClass = SelectEquip[i].EquipClass; 
                  j = j + 1;
               ENDIF; 
             ENDIF; 
   
             i = i + 1; 
      ENDWHILE; 
   
      CALLFRAME ConfirmPickupEquip( C = C, 
                                    ChosenEquip = ChosenEquip); 
      CALLPROC DDB_COMMIT; 
      RETURN; 
   ENDIF; 
END;

/*
**  Handle a Cancel click: 
*/
ON UserEvent 'ContinueCancel_Btn' =
BEGIN 
	IF (entrymade = 1) AND
        NewEquipMove <> TRUE THEN 
	  IF (CurFrame.ConfirmPopup(messagetext=
	      'Equipment will not be picked up.') = PU_OK 
	     ) THEN 
	    RETURN; 
	  ENDIF; 
	ELSE
	  RETURN; 
	ENDIF; 
END; 

ON UserEvent 'Update_Equip_Ground' = 
BEGIN
   UpdatedEquip = CurFrame.MessageInteger;

   i = SelectEquip.FirstRow(); 

   WHILE (i <= SelectEquip.LastRow()) DO  
   
      IF (SelectEquip[i].Equip = UpdatedEquip ) THEN   
          /*
          ** Select here because there might be a non-ground 
          ** move still around
          */
          SelectEquip[i].G = 0;

          REPEATED
          SELECT  :SelectEquip[i].G = O.StatusCount
          FROM    FMS_ObjectStatus O
          WHERE   O.Object = :SelectEquip[i].Equip AND
                  O.Status = :Status$Ground AND
                  O.StatusCount > 0;
          IF SelectEquip[i].G = 0 THEN
             SelectEquip[i].G = NULL;
          ENDIF;

          MoveCnt = 0;
          REPEATED
          SELECT  :MoveCnt = Count(*)
          FROM    FMS_DroppedEquipJobs 
          WHERE   Equip = :SelectEquip[i].Equip;
          
          SelectEquip[i].IsAssigned = MoveCnt;

          k = 1;
          WHILE k <= AllEquip.LastRow() DO
             IF SelectEquip[i].Equip = AllEquip[k].Equip THEN
                AllEquip[k].G = SelectEquip[i].G;
                AllEquip[k].IsAssigned = MoveCnt;
                ENDLOOP; /* only one ground will be added in this case */
             ENDIF;
             k = k + 1;
          ENDWHILE;

          CurFrame.Flush();
          ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;
END;

/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

PROCEDURE SD_Link (
   Object    = INTEGER NOT NULL WITH DEFAULT;
   IsReverse = INTEGER NOT NULL WITH DEFAULT;
   Type      = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   SDObject  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   /*
   **  Check to see if this is a type we are interested in.
   */
   SDObject = 0;
   IF Type = Type$StepDown THEN  /* SD-TRANSF */
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Member
      FROM    Udb_Grouping G
      WHERE   G.Grouping = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.MemberType = :Type$SDVIS;
   ELSEIF Type = Type$SDVIS THEN
      /*
      **  Find paired piece of equipment
      */
      SELECT :SDObject = G.Grouping
      FROM    Udb_Grouping G
      WHERE   G.Member = :Object AND
              G.Relationship = :Interaction$LocatedWith AND
              G.GroupingType = :Type$StepDown;
   ENDIF;
   
   IF SDObject <> 0 THEN 
      FOR i = 1 TO SelectEquip.LastRow DO
         IF SelectEquip[i].Equip = SDObject THEN
            FIELD(SelectEquip[].Description).IsReverse = IsReverse;
            FIELD(SelectEquip[].G).IsReverse = IsReverse;
            FIELD(SelectEquip[].EquipName).IsReverse = IsReverse;
            FIELD(SelectEquip[].EquipClassName).IsReverse = IsReverse;
 
            RETURN;
         ENDIF;
      ENDFOR;
   ENDIF;
          
   RETURN;
END;
