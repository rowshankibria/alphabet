         Compliance = CurObject.Compliance,
         RelayCalDetail  = CurObject.RelayCalDetail,    
         AlarmCircuits = CurObject.AlarmCircuits,    
         AlarmCktDetail = CurObject.AlarmCktDetail,   
         LossOfControl = CurObject.LossOfControl,     
         EquipAndDuration = CurObject.EquipAndDuration,  
         RemoveCtrlFeed = CurObject.RemoveCtrlFeed,    
         CtrlFeedEquip = CurObject.CtrlFeedEquip,     
         OwnIsolation = CurObject.OwnIsolation,      
         LiveConnections = CurObject.LiveConnections,    
         AsbestosRelated = CurObject.AsbestosRelated,         
         AsbAffectEquip = CurObject.AsbAffectEquip,    
         AsbestosWork = CurObject.AsbestosWork,      
         TripoutAccess = CurObject.TripoutAccess,
         AsbestosOperator = CurObject.AsbestosOperator,     
         TripoutPotential = CurObject.TripoutPotential,  
         TripoutComment = CurObject.TripoutComment,    
         Description = CurObject.Description,       
         GndLevelWork = CurObject.GndLevelWork,      
         GndLevelDetail = CurObject.GndLevelDetail);
    
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPRequestDetails.UpdateRequest; Error updating In Service Permit Request';
      CurMethod.Trace(Text = varchar(date('now')) + ':ISPRequestDetails.UpdateRequest. ERROR: ' + 
                'Unable to update In Service Permit Request.');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN;
END;

METHOD InsertAttachments (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.Attachments.LastRow DO
      CurObject.Attachments[i].InsertAttachment();

      CurObject.ReturnCode = CurObject.Attachments[i].ReturnCode;
      CurObject.ErrorMessage = CurObject.Attachments[i].ErrorMessage;
   
      IF CurObject.Attachments[i].ReturnCode = 0 AND 
         CurObject.Attachments[i].DBServer >= 0 THEN 
 
         RetCode = CALLPROC SOA_ISPAttachmentUpd(
                      ISPermit = CurObject.ISPermit,
                      FileID = CurObject.Attachments[i].FileID,
                      DBServer = CurObject.Attachments[i].DBServer);
         IF RetCode = 0 THEN
             CALLPROC DDB_COMMIT;
         ELSE
             CALLPROC DDB_ROLLBACK;
             CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Failed to set SOA_ISPAttachment.DBServer to ' + 
                       VARCHAR(CurObject.Attachments[i].DBServer) + ' for request ' + 
                       VARCHAR(CurObject.Attachments[i].ISPermit) + ', file ' + 
                       VARCHAR(CurObject.Attachments[i].FileID));
         ENDIF; 
         /*
         IF EventText <> '' THEN

            ** Use comma as the delimiter so that the monitor can take this straight in the
            ** dynamic whereclause. 
            
            EventText = EventText + ',';
         ENDIF;
         EventText = EventText + VARCHAR(CurObject.Attachments[i].FileID);
         */
      ENDIF; 
   ENDFOR;
 
   RETURN;   
END;

METHOD LoadAttachments (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 1;
   SELECT :CurObject.Attachments[i].FileID = FileID,
          :CurObject.Attachments[i].FileName = FileName
   FROM   SOA_ISPAttachment 
   WHERE  ISPermit = :CurObject.ISPermit 
   ORDER BY FileID
   BEGIN
      i = i + 1;
   END;

   CALLPROC DDB_ROLLBACK;
END;

