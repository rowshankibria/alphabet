Application Component Report
============================

	Name:            PromptAmmeterClearTrans

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptAmmeterClearTrans
**
**  Modifications:
**  01/18/00   em   Created
**  03/28/01   em   If downloaded to an operating order, test result will
**                  have been returned.
**  10/29/02   em   Job to JIP.
**  03/10/04   em   SOA Prompts are not supported in RR interfaces so Process
**                  Automation Execution will exit immediately.
**  07/17/05   em   Redesigned to support TOMS/SSO Interface and 
**                  Amm Clear criteria and test result retention.
**  08/19/05   em   Add Phase Criteria to move text for individual phases.
**  08/31/05   em   Correct Response for passed test.  Default to Phase A.
*/
INITIALIZE
(
    JIP = JobInProgress;   /*P: Job being processed */

    IssueCompl = INTEGER NOT NULL WITH DEFAULT; /*0=Issue;1=Complete*/
    PhaseAChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
    PhaseBChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
    PhaseCChar = VARCHAR(6) NOT NULL WITH DEFAULT;            /* Character version    */
    DecimalLocation = INTEGER NOT NULL WITH DEFAULT;          /* used to locate '.'   */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    TestResultText = VARCHAR(20) NOT NULL WITH DEFAULT;
 ) =
BEGIN
   IF AutomaticExecution = TRUE THEN
/*
** Should not be called from FMS during Automatic Execution
*/
      RETURN(PU_OK);
   ENDIF;

   SELECT :PhaseCriteria = PhaseCriteria,
          :PhaseAResult  = PhaseAResult, 
          :PhaseBResult  = PhaseBResult,
          :PhaseCResult  = PhaseCResult,
          :TestResult    = TestResult 
   FROM   SOA_AmmeterClearTest
   WHERE  Job = :JIP.Job;
/*
** If we are issuing, we don't display the result section.
** If we are completing, we look for results to determine if the
** results were from a returned Order.
** Test Result can only be recorded by the DO.
*/  
   IF JIP.Status = Job$TakeOut THEN
      IF JIP.TOComplete IS NOT NULL THEN
         IssueCompl = 1;
      ELSE
         IssueCompl = 0;
      ENDIF;
   ELSE
      IF JIP.RSComplete IS NOT NULL THEN
         IssueCompl = 1;
      ELSE
         IssueCompl = 0;
      ENDIF;
   ENDIF;
/*
** Prevent entry/display of inappropriate values
*/
   IF IssueCompl = 0 THEN
      FIELD(OpOrderEntry).ParentField.CurBias = FB_INVISIBLE;
   ELSE
      FIELD(PhaseCriteria).CurBias = FB_VISIBLE;
      IF PhaseAResult IS NOT NULL OR
           PhaseBResult IS NOT NULL OR
           PhaseCResult IS NOT NULL THEN
         FIELD(DOEntry).CurBias = FB_INVISIBLE;
         FIELD(OpOrderEntry).CurBias = FB_VISIBLE;
      ENDIF;     
      IF PhaseCriteria <> 'ALL' THEN
         FIELD(DOEntry).CurBias = FB_INVISIBLE;
         IF PhaseCriteria = 'A' THEN
            FIELD(PhaseBResult).CurBias = FB_VISIBLE;
            FIELD(PhaseCResult).CurBias = FB_VISIBLE;
         ELSEIF PhaseCriteria = 'B' THEN
            FIELD(PhaseAResult).CurBias = FB_VISIBLE;
            FIELD(PhaseCResult).CurBias = FB_VISIBLE;
         ELSE
            FIELD(PhaseAResult).CurBias = FB_VISIBLE;
            FIELD(PhaseBResult).CurBias = FB_VISIBLE;
         ENDIF;
      ENDIF;    
   ENDIF;
END;


ON CLICK doentry.Copy_Btn =
BEGIN
    PhaseAResult = doentry.AllPhases;
    PhaseBResult = doentry.AllPhases;
    PhaseCResult = doentry.AllPhases;
END;


ON Click OKButton =
BEGIN
   IF IssueCompl = 0 THEN  /*Issuing move; setting criteria*/
      RetCode = CALLPROC SOA_AmmeterClearIns (
                  Job = JIP.Job,
                  PhaseCriteria = PhaseCriteria);
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
/*
** Update Move Text if for individual Phase.
*/
         IF PhaseCriteria <> 'ALL' THEN
            RetCode = CALLPROC SOA_JobMoveTextUpd (
			TOMove = JIP.TOMove + ': ' + 
                                 PhaseCriteria + ' Phase Only',
			RSMove = JIP.RSMove + ': ' + 
                                 PhaseCriteria + ' Phase Only',
			Job    = JIP.Job);
            IF Retcode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Move text was not successfully updated with phase.';
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
              'ERROR: Test result criteria could not be saved. ' +
              'Try again.  Have tech support review trace log.',
                           TraceMessage = 
              'PromptAmmeterClearTrans: Unable to save test criteria ' +
              'for Job:' + VARCHAR(JIP.Job)
                          );
         RETURN (PU_CANCEL);
      ENDIF;

   ELSE
/*
** Test Result must be entered by DO.
*/
      IF FIELD(PhaseAResult).CurBias = FB_CHANGEABLE THEN
         IF PhaseAResult IS NULL THEN
            MESSAGE 'Must enter Phase A Result.';
            RESUME;
         ENDIF;
      ENDIF;
      IF FIELD(PhaseBResult).CurBias = FB_CHANGEABLE THEN
         IF PhaseBResult IS NULL THEN
            MESSAGE 'Must enter Phase B Result.';
            RESUME;
         ENDIF;
      ENDIF;
      IF FIELD(PhaseCResult).CurBias = FB_CHANGEABLE THEN
         IF PhaseCResult IS NULL THEN
            MESSAGE 'Must enter Phase C Result.';
            RESUME;
         ENDIF;
      ENDIF;
     
      IF TestResult = '' THEN
         MESSAGE 'Please select Test Result PASS or FAIL.';
         RESUME;
      ENDIF;

      RetCode = CALLPROC SOA_AmmeterClearUpd (
                   Job = JIP.Job,
                   PhaseAResult = PhaseAResult,
                   PhaseBResult = PhaseBResult,
                   PhaseCResult = PhaseCResult,
                   TestResult = TestResult);

 

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
         TestResultText = '';
/*
**   Convert to char and get rid of trailing 0
*/
         IF PhaseCriteria = 'ALL' OR PhaseCriteria = 'A' THEN
            PhaseAChar = pad(squeeze(VarChar(IFNULL(PhaseAResult,0))));
            DecimalLocation = locate(PhaseAChar,'.');
            PhaseAChar = squeeze(shift(PhaseAChar,(size(PhaseAChar) - 
                                               (DecimalLocation + 2))));
            TestResultText = ';A=' + PhaseAChar;
         ENDIF;

         IF PhaseCriteria = 'ALL' OR PhaseCriteria = 'B' THEN
            PhaseBChar = pad(squeeze(VarChar(IFNULL(PhaseBResult,0))));
            DecimalLocation = locate(PhaseBChar,'.');
            PhaseBChar = squeeze(shift(PhaseBChar,(size(PhaseBChar) - 
                                               (DecimalLocation + 2))));
            TestResultText = TestResultText + ';B=' + PhaseBChar;
         ENDIF;

         IF PhaseCriteria = 'ALL' OR PhaseCriteria = 'C' THEN
            PhaseCChar = pad(squeeze(VarChar(IFNULL(PhaseCResult,0))));
            DecimalLocation = locate(PhaseCChar,'.');
            PhaseCChar = squeeze(shift(PhaseCChar,(size(PhaseCChar) - 
                                               (DecimalLocation + 2))));
            TestResultText = TestResultText + ';C=' + PhaseCChar;
         ENDIF;

         JIP.Response = TestResult + TestResultText;
         JIP.ResponseUpd();
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
              'ERROR: Test result could not be saved. ' +
              'Try again.  Have tech support review trace log.',
                           TraceMessage = 
              'PromptAmmeterClearTrans: Unable to save test result ' +
              'for Job:' + VARCHAR(JIP.Job)
                          );
         RETURN (PU_CANCEL);
      ENDIF;
 
   ENDIF; 
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
	RESUME;
END;
