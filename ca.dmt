Application Component Report
============================

	Name:            CompletionPapers


/*
**
**	Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**	ALSTOM ESCA, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of ALSTOM ESCA, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CompletionPapers
**
**  05/02/01  em    Created, to display returned permit completion papers
**  11/01/01  em    Quick fix: if the return values for Caution, Urgent 
**                  Restore, or continuity are YES, highlight them with 
**                  color so that they stand out.
**  08/05/02  ysp   Show transferred location historic information.
**  08/14/02  em    Change Pickup/Drop Equipment display.
**  04/10/03  em    Add Return Comment
**  09/10/03  pkw   Web-enable location and tag callup for FMS Offline reports.
**  02/15/05  em    Added Rejected Return information
**  09/18/06  ysp   prompt DO if the returned equipment does not include all the equipment
**                  downloaded to FCR.
**  09/26/06  em    Modifications when returning different pick/drop lists
**  10/31/06  em    Add NYSE HighPot Waived indicator, set feeder status if not already set.
**  03/09/11  em    Add 3G Support for waived high pot status
**  12/14/16  ysp   increase the length of ReturnComment to varchar(1500)
**  01/24/22  em    Include Source attribute for pick/drop list display
*/

INITIALIZE
(
    WorkPermit = INTEGER NOT NULL;      /* Passed Permit ID*/
    PromptDO = INTEGER NOT NULL WITH DEFAULT;      /* passed in flag */
    Card = INTEGER NOT NULL WITH DEFAULT;  /*Passed in during completion processing*/
) =
DECLARE
    CardClassName = VARCHAR(40) NOT NULL WITH DEFAULT;
    CutOut = DATE;
    CutIn = DATE;
    DestCard = INTEGER NOT NULL;
    DestRFP = INTEGER NOT NULL;
    EquipDesc = VARCHAR(400) NOT NULL;
    Feeder = ARRAY OF INTEGEROBJECT;
    FeederName = VARCHAR(40) NOT NULL;
    i = integer NOT NULL;		/* Temporary counter */
    j = integer;			/* Temporary counter */
    NYSEHighPotWaiver = CHAR(3) NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    SimpleWP = WorkPermit_ASE DEFAULT NULL; /* Enables use of class methods */
    StatusCount = INTEGER NOT NULL WITH DEFAULT;

    LoadWPEquip = PROCEDURE;
ENDDECLARE
BEGIN
/*
** Select all the necessary data for display only.
*/
   SELECT :BackFromWorkStatus = BackFromWorkStatus
         ,:ReturnedTime = ReturnedTime
         ,:WP.Continuity = Continuity
         ,:WP.ContinuityEquipment = ContinuityEquipment
         ,:WP.Caution = Caution
         ,:WP.UrgentRestoration = UrgentRestoration
         ,:WP.HighPotType = HighPotType
         ,:WP.HighPotkV = HighPotkV
         ,:WP.HighPotDuration = HighPotDuration
         ,:WP.HighPotAuthorization = HighPotAuthorization
         ,:WP.EquipmentDropped = EquipmentDropped
         ,:WP.EquipmentPicked = EquipmentPicked
         ,:ReturnComment = Comment
         ,:Rej.DOName = ReturnRejectDO
         ,:Rej.RejectionTime = ReturnRejectTime
         ,:Rej.RejectionReason = ReturnRejectReason
         ,:NYSEHighPotWaiver = HighPotWaivedNYSE
   FROM   IR_WorkPermit
   WHERE  WorkPermit = :WorkPermit;

   IF BackFromWorkStatus = 'BT' THEN
      BackFromWorkStatus = 'YES';
      FIELD(WP).CurBias = FB_INVISIBLE;
   ELSE
      BackFromWorkStatus = 'NO';
   ENDIF;

   IF UPPERCASE(NYSEHighPotWaiver) = 'YES' THEN
      FIELD(WP.NYSEHighPotWaiver).CurBias = FB_VISIBLE;
/*
** Also check if NYSEWaivedHP feeder status exists for CutOut feeder, set it if not
** Card field should only be set when we are processing returned permit.
*/
      IF Card <> 0 THEN  /* only want to do this when returning permit */   
         CutOut = NULL; 
         CutIN = NULL;
         SELECT :CutOut = CutOut,
                :CutIn = CutIn
         FROM   FMS_Card
         WHERE  Card = :Card;

         IF CutOut IS NOT NULL AND CutIn IS NULL THEN 

            Feeder.Clear();
            i = 1;
            SELECT :Feeder[i].Value = Object
            FROM   TFMS_CardToObject
            WHERE  Card = :Card
            BEGIN
               i = i + 1;
            END;

            FOR i = 1 TO Feeder.LastRow() DO 
               RetCode = CALLPROC SetStatus (Object = Feeder[i].Value,
                                             Status = Status$NYSEWaivedHP);
               IF RetCode = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  MESSAGE 'Error setting Feeder Object Status NYSEWaivedHP.';
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDFOR;
         ENDIF; 
      ENDIF;
   ENDIF;

   IF Rej.RejectionTime <> '' THEN
      FIELD(Rej).CurBias = FB_LANDABLE;
   ELSE
      FIELD(Rej).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** Set the bg color so that YES values standout.
*/
   IF UPPERCASE(WP.Caution) = 'YES' THEN
      FIELD(WP.Caution).BgColor = CC_YELLOW;
   ENDIF;

   IF UPPERCASE(WP.Continuity) = 'YES' THEN
      FIELD(WP.Continuity).BgColor = CC_LIGHT_ORANGE;
   ENDIF;

   IF UPPERCASE(WP.UrgentRestoration) = 'YES' THEN
      FIELD(WP.UrgentRestoration).BgColor = CC_LIGHT_ORANGE;
   ENDIF;

   IF UPPERCASE(WP.EquipmentDropped) = 'YES' THEN
      FIELD(WP.EquipmentDropped).BgColor = CC_PALE_GREEN; 
      FIELD(WP.ViewInfo).CurBias = FB_VISIBLE;  
   ENDIF;
   
   IF UPPERCASE(WP.EquipmentPicked) = 'YES' THEN
      FIELD(WP.EquipmentPicked).BgColor = CC_PALE_GREEN;   
      FIELD(WP.ViewInfo).CurBias = FB_VISIBLE;  
   ENDIF;
/*
** IR_DownloadEquip table was added for FCR Drop/pick Equip enhancement. Old
** work permits did not have records in this table.
*/
   i = 0;
   SELECT :i = COUNT(*)
   FROM   IR_DownloadEquip
   WHERE  WorkPermit = :WorkPermit;

   IF i = 0 THEN
      FIELD(WP.EquipStatus).CurBias = FB_INVISIBLE; 
   ELSE
      i = 0;
      SELECT :i = COUNT(*)
      FROM   IR_DownloadEquip
      WHERE  WorkPermit = :WorkPermit AND
             ReturnFGO = 0 AND 
             ReturnPermit = 0;
      CALLPROC DDB_ROLLBACK;

      IF i > 0 THEN
         WP.EquipStatus.Returned = 'NO';
         FIELD(WP.EquipStatus.Returned).BgColor = CC_RED; 
         IF PromptDO = 1 THEN
            CurFrame.SendUserEvent (EventName = 'Equip_Mismatch');
         ENDIF;
      ELSE
         WP.EquipStatus.Returned = 'YES';
         FIELD(WP.EquipStatus.Returned).BgColor = CC_PALE_GREEN; 
      ENDIF;
   ENDIF;
   
/*
**  Read in the Location and Tags for the Work Permit
*/
   IF SimpleWP IS NULL THEN
      SimpleWP = WorkPermit_ASE.Create();
   ENDIF;
     
   SimpleWP.WorkPermit = WorkPermit;    
    
   SimpleWP.LoadWP_LocTags();
   
   IF SimpleWP.ReturnCode <> 0 THEN
      Message SimpleWP.ErrorMessage;
      RESUME NEXT;
   ENDIF;

   Location_tf = SimpleWP.LT.Duplicate();
   SimpleWP = NULL;

   FOR i = 1 TO Location_tf.LastRow() DO
       IF Location_tf[i].Xfer = 'X' THEN
          Field(Location_tf[i].Xfer).BgColor = CC_PALE_GREEN; 
       ENDIF;
   ENDFOR;
END;

On USEREVENT 'Equip_Mismatch' = 
BEGIN
   CALLPROC LoadWPEquip(Type = 4);

   FIELD(Equip_sf.StrFormat).CurBias = FB_INVISIBLE;
   
   FIELD(Equip_sf).AbsXLeft = (FIELD(Location_TF).Width - FIELD(Equip_sf).Width)/2; 
   FIELD(Equip_sf).AbsYTop = FIELD(Location_TF).AbsYTop;
   FIELD(Equip_sf).CurBias = FB_LANDABLE;

   IF Card <> 0 THEN
         CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = WorkPermit,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'FCR Permit Return',
                 Old  = 'Return Pick/Drop Equip List',
                 New  = 'Does Not Match Requested Pick/Drop List');
   ENDIF;
END;


ON ENTRY WP.EquipmentPicked =
BEGIN
   IF WP.EquipmentPicked <> 'YES' THEN
      RESUME;
   ENDIF;

   CALLPROC LoadWPEquip(Type = 1);

   IF Equip_sf.TblFormat.LastRow() > 0 THEN
      FIELD(Equip_sf.StrFormat).CurBias = FB_INVISIBLE;
   ELSE
      Equip_sf.StrFormat.EquipDesc = '';
      REPEATED 
      SELECT  :Equip_sf.StrFormat.EquipDesc = EquipmentPickedDesc
      FROM     IR_WorkPermit
      WHERE    WorkPermit = :WorkPermit;
      CALLPROC DDB_ROLLBACK; 
   
      FIELD(Equip_sf.StrFormat.EqTitle).TextValue = 'Pickup Equipment list entered by FCR:';
      IF Equip_sf.StrFormat.EquipDesc = '' THEN
         Equip_sf.StrFormat.EquipDesc = 'Nothing entered by FCR. See Work Permit Objective.';
      ENDIF;
   ENDIF;
      
   FIELD(Equip_sf).AbsXRight = FIELD(WP.EquipmentPicked).AbsXLeft; 
   FIELD(Equip_sf).AbsYTop = FIELD(WP.EquipmentPicked).AbsYTop;
   FIELD(Equip_sf).CurBias = FB_LANDABLE;

   CurFrame.Flush();
END;


ON ENTRY WP.EquipmentDropped =
BEGIN
   IF WP.EquipmentDropped <> 'YES' THEN
      RESUME;
   ENDIF;

   CALLPROC LoadWPEquip(Type = 0);

   IF Equip_sf.TblFormat.LastRow() > 0 THEN
      FIELD(Equip_sf.StrFormat).CurBias = FB_INVISIBLE;
   ELSE
      Equip_sf.StrFormat.EquipDesc = '';
      REPEATED 
      SELECT  :Equip_sf.StrFormat.EquipDesc = EquipmentDroppedDesc
      FROM     IR_WorkPermit
      WHERE    WorkPermit = :WorkPermit;
      CALLPROC DDB_ROLLBACK; 
   
      FIELD(Equip_sf.StrFormat.EqTitle).TextValue = 'Dropped Equipment list entered by FCR:';
      IF Equip_sf.StrFormat.EquipDesc = '' THEN
         Equip_sf.StrFormat.EquipDesc = 'Nothing entered by FCR. See Work Permit Objective.';
      ENDIF;
   ENDIF;
   
   FIELD(Equip_sf).AbsXRight = FIELD(WP.EquipmentDropped).AbsXLeft; 
   FIELD(Equip_sf).AbsYTop = FIELD(WP.EquipmentDropped).AbsYTop;
   FIELD(Equip_sf).CurBias = FB_LANDABLE;
END;

ON ENTRY WP.EquipStatus.Returned =
BEGIN
   IF WP.EquipStatus.Returned = 'NO' THEN
      CALLPROC LoadWPEquip(Type = 2);
   ELSE
      CALLPROC LoadWPEquip(Type = 3);
   ENDIF;

   FIELD(Equip_sf.StrFormat).CurBias = FB_INVISIBLE;
   
   FIELD(Equip_sf).AbsXRight = FIELD(WP.EquipStatus.Returned).AbsXLeft; 
   FIELD(Equip_sf).AbsYTop = FIELD(WP.EquipStatus.Returned).AbsYTop;
   FIELD(Equip_sf).CurBias = FB_LANDABLE;
END;

ON CLICK Equip_sf.Close_btn =
BEGIN
   FIELD(Equip_sf).CurBias = FB_INVISIBLE;
END;

/*
** Show tranferred location historic information
*/
ON ChildEntry Location_tf[*].Xfer = 
BEGIN
   i = Field(Location_tf).CurRow;
   IF i<= 0 THEN
      RESUME;
   ENDIF;

   IF Location_tf[i].Xfer <> 'X' THEN
      RESUME;
   ENDIF;

 /*
** find destination RFP
*/
   DestCard = 0;
   DestRFP = 0;

   SELECT :DestCard = RP.Card,
          :DestRFP = RL.RFP
   FROM   IR_RFPLocation RL,
          IR_RequestForPermit RP
   WHERE  RL.RFP = :Location_tf[i].XferToRFP AND
          RL.LocationStructure = :Location_tf[i].LocationStructure AND
          RP.RFP = :Location_tf[i].XferToRFP;
   
   IF DestRFP = 0 THEN    /* RFP doesn't exit  */

      Field(Transfer_sf.xfrRFP).TextValue = 'Xfr RFP has not yet been received.';

      IF Location_tf[i].XferToISO <> '' THEN
         Field(Transfer_sf.Extra.Label).TextValue = 'Xfer to ISO #:';
         Transfer_sf.Extra.Value = Location_tf[i].XferToISO;
         Field(Transfer_sf.Extra).CurBias = FB_VISIBLE;      
      ELSE
         Field(Transfer_sf.Extra).CurBias = FB_INVISIBLE;      
      ENDIF;
           
   ELSEIF DestCard = 0 THEN  /* RFP is not linked to card */

      Field(Transfer_sf.xfrRFP).TextValue = 'Xfr RFP is in pool waiting to be linked to a card.';

      IF Location_tf[i].XferToISO <> '' THEN
         Field(Transfer_sf.Extra.Label).TextValue = 'Xfer to ISO #:';
         Transfer_sf.Extra.Value = Location_tf[i].XferToISO;
         Field(Transfer_sf.Extra).CurBias = FB_VISIBLE;      
      ELSE
         Field(Transfer_sf.Extra).CurBias = FB_INVISIBLE;      
      ENDIF;
        
   ELSE
      FeederName = '';      
      SELECT :FeederName = C.FeederName,
             :CardClassName = C.CardClassName
      FROM   FMS_Card C
      WHERE  C.Card = :DestCard;
  
      IF FeederName = '' THEN
         SELECT :FeederName = C.FeederName,
                :CardClassName = C.CardClassName
         FROM   FMS_ArchiveCard C
         WHERE  C.Card = :DestCard;
      ENDIF;

      SELECT :Transfer_sf.Extra.Value = varchar(RequestForPermit) + '.' + VARCHAR(RevisionNumber)
      FROM    IR_RequestForPermit 
      WHERE   Card = :DestCard AND
              RFP = :DestRFP;

      Field(Transfer_sf.xfrRFP).TextValue = 'Xfr RFP is on card: ' + FeederName + ' ' + CardClassName;
      Field(Transfer_sf.Extra).CurBias = FB_VISIBLE;
      Field(Transfer_sf.Extra.Label).TextValue = 'RFP #:';

   ENDIF;

   FIELD(Transfer_sf).AbsYTop = FormField(CurFrame.TriggerField).AbsYBottom;
   FIELD(Transfer_sf).AbsXRight = FormField(CurFrame.TriggerField).AbsXLeft;

    /** Handle case where popup would go to low on the screen **/
   IF Field(Transfer_sf).AbsYBottom > Field(Location_tf).AbsYBottom THEN
      Field(Transfer_sf).AbsYBottom = Field(Location_tf).AbsYBottom;
   ENDIF;

   FIELD(Transfer_sf).CurBias = FB_LANDABLE;   
END;

ON Click Transfer_sf.Hide_Btn = 
BEGIN
   FIELD(Transfer_sf).CurBias = FB_INVISIBLE;
END;

/*
