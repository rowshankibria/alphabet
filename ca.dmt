Application Component Report
============================

	Name:            PortionFeederDiagram

/*
**  Copyright c 2016 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    FeederCard
**  Frame:          PortionFeederDiagram
**
**  Modification log:
**
**   04/11/16   ysp   Created; 
**   07/18/16   ysp   Add showing portion equipment list when right-click on the portions
**   11/15/16   ysp   Support any number switches for a feeder or source segment
**   05/14/20   ysp   Set LayerSequence for diagram fields and use FreeTrim for switch names
**   05/26/20   ysp   Shorten the vertical load segment line and give the load segment higher priority
**                    over outbound feeder segment when finding the longest path 
*/
INITIALIZE   
(
   MainFeeder = INTEGER NOT NULL WITH DEFAULT,  /* passed-in Parameter*/
   Title = VARCHAR(100) NOT NULL WITH DEFAULT;        
   ClickableList = ARRAY OF pas!ObjectSummaryClass;   /* optional */
   ShowPortionName = INTEGER NOT NULL WITH DEFAULT;   /* optional */
   
   SelectedPortion = INTEGER NOT NULL;  /* passed-out Parameter*/
) = 
DECLARE
#   include StandardDeclarations
   
   j = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
   k = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
   l = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
   m = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
   n = INTEGER NOT NULL WITH DEFAULT;            /* Temporary counter */
   
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipList = ARRAY OF ConnectedEquipClass;
   SourceSegment = INTEGER NOT NULL WITH DEFAULT;
   SourceBreaker = ConnectedEquipClass;
   Nav2NeighborOK = INTEGER NOT NULL WITH DEFAULT;
   NavHistory = ARRAY OF pas!ObjectSummaryClass;

   InitDiagramY = Integer Not Null;  
   InitDiagramX = Integer Not Null; 
    
   SelectedPortionWrap = RectangleShape DEFAULT NULL;   // rectangle around selected portion for processing (xtr & picked up to)
   EquipPortionWrap = RectangleShape DEFAULT NULL;   // rectangle around selected portion for displaying member equipment
   
   NetworkTrace = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
   MarkNextNode = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
   GetLongestPath = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
   SetFeederStatus = PROCEDURE;
   SetFeederEnergized = PROCEDURE;

   DisplayDiagram = PROCEDURE; 
   DrawSubTree = PROCEDURE;
   DrawOneEquipment = PROCEDURE;
   DrawFeeder = PROCEDURE;
   DrawSwitch = PROCEDURE;
   DrawLine = PROCEDURE RETURNING SegmentShape;
   ShowFeederAndNavigation = PROCEDURE;
   ResetViewport = PROCEDURE;
   CheckConfigurationChange = PROCEDURE;
   GetPortionName = PROCEDURE RETURNING VARCHAR(40) NOT NULL WITH DEFAULT;
   GetPortionRectangle = PROCEDURE;
   LoadPortionEquipment = PROCEDURE;
ENDDECLARE
BEGIN 
   FIELD(EquipStack).CurBias = FB_INVISIBLE;
   FIELD(ToFeeder).ParentField.CurBias = FB_INVISIBLE;
   IF Title <> '' THEN
      FIELD(Instruction).TextValue = Title;
      Nav2NeighborOK = FALSE;
   ELSE
      FIELD(Instruction).CurBias = FB_INVISIBLE;
      Nav2NeighborOK = TRUE;
   ENDIF;
   IF ClickableList.LastRow = 0  THEN
      FIELD(SelectedPortionName).ParentField.CurBias = FB_INVISIBLE;
      FIELD(Cancel_Btn).CurBias = FB_INVISIBLE;
   ENDIF;
   CurFrame.SendUserEvent(EventName = 'DisplayDiagram');
END;        

ON UserEvent 'DisplayDiagram' =
BEGIN 
   CALLPROC DisplayDiagram();
END;        

ON SETVALUE ToFeeder =
BEGIN
   IF CurFrame.ReasonCode = RC_MOUSECLICK THEN
      IF ToFeeder = 0 THEN
         RESUME;
      ENDIF;
      FIELD(EquipStack).CurBias = FB_INVISIBLE;
      MainFeeder = ToFeeder;
      CALLPROC ResetViewport();
      CALLPROC DisplayDiagram();
      CALLPROC CheckConfigurationChange();
   ENDIF;
END;

ON ChildClick VP = 
BEGIN
   IF SelectedPortionWrap IS NOT NULL THEN
      SelectedPortion = 0;
      SelectedPortionName = '';

      SelectedPortionWrap.CurBias = FB_INVISIBLE;
   ENDIF;
END;

ON ChildProperties VP = 
DECLARE
   Focus = FieldObject;
   CurEquip = ConnectedEquipClass;
   PortionName = VARCHAR(40) NOT NULL WITH DEFAULT;
   x1 = INTEGER NOT NULL WITH DEFAULT;
   x2 = INTEGER NOT NULL WITH DEFAULT;
   y1 = INTEGER NOT NULL WITH DEFAULT;
   y2 = INTEGER NOT NULL WITH DEFAULT;    
ENDDECLARE 
BEGIN
   Focus = CurFrame.TriggerField;
   IF Focus.ClientData IS NULL THEN
      RESUME;
   ENDIF;

   CurEquip = ConnectedEquipClass(Focus.ClientData);  
   //MESSAGE CurEquip.PrimaryGroupingName;  
   
   IF MainFeeder = CurEquip.PrimaryGrouping THEN
      /* A feeder segment is selected. Display its equipment list.
      */
      PortionName = CALLPROC GetPortionName(Portion = CurEquip);
      
      CALLPROC GetPortionRectangle(PortionField = Focus,
                                x1 = ByRef(x1),
                                x2 = ByRef(x2),
                                y1 = ByRef(y1),
                                y2 = ByRef(y2));   
      IF EquipPortionWrap IS NULL THEN
         EquipPortionWrap = RectangleShape.Create();
      ENDIF;
      
      EquipPortionWrap.LineWidth = LW_DEFAULT;
      EquipPortionWrap.LineStyle = LS_DOT;
      EquipPortionWrap.LineColor = CC_ORANGE;
      EquipPortionWrap.XLeft = x1 - 50;
      EquipPortionWrap.YTop = y1 - 50;
      EquipPortionWrap.Width = x2 - x1 + 100;
      EquipPortionWrap.Height = y2 - y1 + 100;
      EquipPortionWrap.ParentField = Field(VP.TemplateObj).ParentField; 
      EquipPortionWrap.CurBias = FB_VISIBLE;
      EquipPortionWrap.LayerSequence = 4;
   
      CALLPROC LoadPortionEquipment(Portion = CurEquip);      
         
      FIELD(EquipStack.PortionEquip).Title = 'Equipment on ' + PortionName;
      
      FIELD(EquipStack).AbsYTop = FIELD(VP).AbsYTop + 50;
      IF FIELD(EquipStack).OuterWidth < (x1 - 50) THEN
         FIELD(EquipStack).AbsXLeft = FIELD(VP).AbsXLeft + 50;
      ELSE
         FIELD(EquipStack).AbsXRight = FIELD(VP).AbsXRight - 50;      
      ENDIF;
      FIELD(EquipStack).CurBias = FB_MOVEABLE; // the whole statck field can be moved
   ELSE
      // a feeder name is selected
      FIELD(EquipStack).CurBias = FB_INVISIBLE;
      MainFeeder = CurEquip.PrimaryGrouping;
      CALLPROC ResetViewport();
      CALLPROC DisplayDiagram();
      CALLPROC CheckConfigurationChange();
   ENDIF;
END;

On ChildClickPoint VP = 
DECLARE
   Focus = FieldObject;
   CurEquip = ConnectedEquipClass;
   x1 = INTEGER NOT NULL WITH DEFAULT;
   x2 = INTEGER NOT NULL WITH DEFAULT;
   y1 = INTEGER NOT NULL WITH DEFAULT;
   y2 = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE 
BEGIN
   IF ClickableList.LastRow = 0 THEN
      RESUME;
   ENDIF;

   Focus = CurFrame.TriggerField;
   IF Focus.ClientData IS NULL THEN
      IF SelectedPortionWrap IS NOT NULL THEN
         SelectedPortion = 0;
         SelectedPortionName = '';

         SelectedPortionWrap.CurBias = FB_INVISIBLE;
      ENDIF;
      RESUME;
   ENDIF;

   CurEquip = ConnectedEquipClass(Focus.ClientData);

   RetCode = ClickableList.Find(AttributeName = 'Object', Value = CurEquip.Object);
   IF RetCode = ER_RowNotFound THEN
      MESSAGE 'This segment is not on the current card';
      RESUME;
   ENDIF;

   // selected segment
   SelectedPortion = CurEquip.Object;
   SelectedPortionName = CALLPROC GetPortionName(Portion = CurEquip);
      
   // get segment's space coordinates
   CALLPROC GetPortionRectangle(PortionField = Focus,
                                x1 = ByRef(x1),
                                x2 = ByRef(x2),
                                y1 = ByRef(y1),
                                y2 = ByRef(y2));
   IF SelectedPortionWrap IS NULL THEN
      SelectedPortionWrap = RectangleShape.Create();
   ENDIF;
   
   SelectedPortionWrap.LineWidth = LW_DEFAULT;
   SelectedPortionWrap.LineStyle = LS_DOT;
   SelectedPortionWrap.XLeft = x1 - 50;
   SelectedPortionWrap.YTop = y1 - 50;
   SelectedPortionWrap.Width = x2 - x1 + 100;
   SelectedPortionWrap.Height = y2 - y1 + 100;
   SelectedPortionWrap.ParentField = Field(VP.TemplateObj).ParentField; 
   SelectedPortionWrap.CurBias = FB_VISIBLE;                                   
   SelectedPortionWrap.LayerSequence = 4;
END;

ON CLICK EquipStack.OK_Btn = 
BEGIN
   FIELD(EquipStack).CurBias = FB_INVISIBLE;
   EquipPortionWrap.CurBias = FB_INVISIBLE;   
END;

ON CLICK OK_btn =
BEGIN
   RETURN(1);
END;

ON CLICK Cancel_btn =
BEGIN
   SelectedPortion = 0;
   SelectedPortionName = '';

   RETURN(0);
END;

