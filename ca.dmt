���p(--------------------------
/*
**
**      Copyright c 2021 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          DissFIle_ASE
**
**  Date:       Version Description
** ----------------------------------
**  12/29/21    em      Created
**  01/12/22    em      Removed DisseminationFile table from select, not needed
*/ 
METHOD LoadDissFileList (
) =
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;

ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';
   
   IF UPPERCASE(CurObject.FilterType) = 'DATE' THEN
      IF CurObject.StartDateFilter <> '' THEN 
         StartDate = DATE(CurObject.StartDateFilter); 
      ELSE
         CurObject.ReturnCode = -99;
         CurObject.ErrorMessage = 'LoadDissFileList method intiated with Date Filter but no start date.';
         RETURN;
      ENDIF;   
      IF CurObject.EndDateFilter <> '' THEN
         EndDate = DATE(CurObject.EndDateFilter) + '1 day';  
      ELSE  
         EndDate = DATE('now') + '1 day';  
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + 'LoadDate >= ''' + VARCHAR(StartDate) + ''' AND ' +
                                                'LoadDate < ''' + VARCHAR(EndDate) + '''';

   ELSEIF UPPERCASE(CurObject.FilterType) = 'ACTIVE' THEN
      DynamicWhereClause = DynamicWhereClause + 'DFR.Status = 1';
   
   ELSE
         CurObject.ReturnCode = -99;
         CurObject.ErrorMessage = 'LoadDissFileList method intiated with improper FilterType' + VARCHAR(CurObject.FilterType);
         RETURN;   
   ENDIF;
   
   i = 1;
   SELECT :CurObject.DF[i].FileID = DFR.FileID,
          :CurObject.DF[i].InactiveDate = DFR.InactiveDate,
          :CurObject.DF[i].LoadDate = DFR.LoadDate,
          :CurObject.DF[i].LoadUserName = DFR.LoadUserName,
          :CurObject.DF[i].Status = DFR.Status,
          :CurObject.DF[i].Title = DFR.Title
   FROM  FMS_DissFileRecord DFR   
   WHERE  :DynamicWhereClause
   ORDER BY 1 DESC
   BEGIN
      IF CurObject.DF[i].Status = 0 THEN
         CurObject.DF[i].StatusName = 'Inactive';
      ELSEIF CurObject.DF[i].Status = 1 THEN
         CurObject.DF[i].StatusName = 'Active';
      ELSE
         CurObject.DF[i].StatusName = 'Error';
      ENDIF;
      j = 1;
      SELECT :CurObject.DF[i].DOXRef[j].DOName = SQUEEZE(O.Description),
             :CurObject.DF[i].DOXRef[j].DOObjID = DFX.DOObjID,
             :CurObject.DF[i].DOXRef[j].ReviewDate = VARCHAR(DFX.ReviewDate),
             :CurObject.DF[i].DOXRef[j].Status = DFX.Status
      FROM   FMS_DissFileDOXRef DFX,
             Udb_Object O
      WHERE  DFX.FileID = :CurObject.DF[i].FileID AND
             DFX.DOObjID = O.Object
      ORDER BY 1 ASC
      BEGIN
         IF :CurObject.DF[i].Status = 0 THEN
            CurObject.DF[i].DOXRef[j].StatusName = 'Skipped';
         ELSEIF :CurObject.DF[i].Status = 1 THEN
            CurObject.DF[i].DOXRef[j].StatusName = 'Reviewed';
         ELSE
            CurObject.DF[i].DOXRef[j].StatusName = 'Error';
         ENDIF;
         j = j + 1;
      END;
      
      i = i + 1;
   END;
END;

