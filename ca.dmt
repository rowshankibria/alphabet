	Name:            RelayProtectionOverRide

/*
**	Copyright c 1995 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**
**  Application:    CAC
**  Frame:          RelayProtectionOverRide
**
**  04/04/05   pkw    created
**  01/20/10   ysp    TLS 50: Get route info from udb_circuitroute table
*/

INITIALIZE
(  CardObject = INTEGER NOT NULL WITH DEFAULT; /* passed */
   Grouping = INTEGER NOT NULL WITH DEFAULT; /* P: */
   CircuitList = ARRAY OF RelayStatusClass;
   ObjectList = ARRAY OF IntegerObject;
   FromTFMS = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   counter = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TempChar = VARCHAR(200) NOT NULL WITH DEFAULT;
   TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Validate array...
*/
   IF ObjectList.LastRow() = 0 THEN
      MESSAGE 'Frame called with invalid parameters.  ' + 
              'Please report to technical support.';
      RETURN;
   ENDIF;
/*
**  Either grouping or circuitlist will be passed in.
**  If Grouping is passed in, Feeders/circuits have already
**  been overridden and we will allow D.O. to remove the override.
**  If CircuitList is passed in we will link the Object list to 
*/
   
   IF Grouping <> 0 THEN
      FIELD(ClearOverride_btn).CurBias = FB_LANDABLE;
      FIELD(Override_btn).CurBias = FB_INVISIBLE;
      TempChar = 'Object(s) linked with Override: ';

      /* Get previous comment */
      SELECT :Comment = Comment
      FROM    CAC_Relay_Grouping
      WHERE   Grouping = :Grouping;
      CALLPROC DDB_ROLLBACK;
      FIELD(Comment).CurBias = FB_VISIBLE;
   ELSE
      FIELD(ClearOverride_btn).CurBias = FB_INVISIBLE;
      FIELD(Override_btn).CurBias = FB_LANDABLE;
      TempChar = 'Object(s) being overridden: ';
   ENDIF;  

   FOR i = 1 TO ObjectList.LastRow() DO
      SELECT :TempName = O.Name
      FROM    Udb_Object O
      WHERE   O.Object = :ObjectList[i].Value;
      
      TempChar = TempChar + '(' + TempName + ') ';
   ENDFOR;
   FIELD(ObjectTxt).TextValue = TempChar;
/*
**  Load Circuit list
*/
   IF CircuitList.LastRow() = 0 THEN
      FIELD(Circuit).CurBias = FB_INVISIBLE;
   ENDIF;
/*
**  If calling from ProtectionCompromised don't allow do clear.
*/
   IF CardObject = 0 THEN
      FIELD(ClearOverride_btn).CurBias = FB_INVISIBLE;
      FIELD(Override_btn).CurBias = FB_INVISIBLE;
      FIELD(Frame_HelpText).CurBias = FB_INVISIBLE;
   ENDIF;

   i = 1;
   Circuit.Clear();
   FOR i = 1 TO CircuitList.LastRow() DO
      SELECT :Circuit[i].Name = O.Name,
             :Circuit[i].TypeName = O.TypeName
      FROM   Udb_Object O
      WHERE  O.Object = :CircuitList[i].Circuit 
      BEGIN 
         SELECT :TempName = T.Name
         FROM   Udb_CircuitRoute TC,
                Udb_Type T
         WHERE  TC.Object = :CircuitList[i].Circuit AND
                TC.Route = T.Type
         BEGIN
            IF Circuit[i].RouteName  = '' THEN
               Circuit[i].RouteName = TempName;
            ELSE
               Circuit[i].RouteName = Circuit[i].RouteName + ';' + TempName;
            ENDIF;
         END;
         /*
         **  Get all of the substations and concatenate them into one field
         */
         TempChar = '';
         SELECT  :TempChar = O.Name
         FROM    Udb_Grouping G,
                 Udb_ExtendedType ET,
                 Udb_Object O
         WHERE   G.Member = :CircuitList[i].Circuit AND 
                 G.Relationship = :Interaction$MemberOf AND
                 G.Grouping = O.Object AND
                 G.GroupingType = ET.Type AND
                 ET.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
         BEGIN
            IF Circuit[i].SubstationNames = '' THEN
               Circuit[i].SubstationNames = TempChar;
            ELSE
               Circuit[i].SubstationNames = Circuit[i].SubstationNames + 
                                                 ', ' + TempChar;
            ENDIF;
         END;
      END;
      CALLPROC DDB_ROLLBACK;
      IF CircuitList[i].Status = 1 THEN
         Circuit[i].Comment = 'In Service';
      ELSE
         Circuit[i].Comment = 'Out of Service';
      ENDIF;
   ENDFOR;
END;

ON CLICK OverRide_btn =
BEGIN
   IF Comment = '' THEN
      message 'Please enter a reason why you are overriding ' + 
              'the protection to compromised.';
      CurFrame.InputFocusField = FIELD(Comment);
      RESUME;
   ENDIF;
/*
**  Create grouping, change to  and link objects to it.
*/
   Grouping = CALLPROC Udb_NextKey(KeyName = 'RelayGrouping');

   IF Grouping <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not generate a grouping, try again.';
      RESUME;    
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RetCode = CALLPROC CAC_Relay_GroupingIns (
                 Grouping = Grouping,
                 UserCheckOut = DOp.Description,
                 RevisionDate = date('now'),
                 Comment = Comment
                 );
   IF Retcode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                    ': Could not insert grouping information.');
      Message 'Could not insert grouping information. ' +
         'Please try again or contact technical support if ' + 
         'problem continues.';
      RESUME;    
   ENDIF;
   /* don't commit yet */

   RetCode = CAC_Relay_GroupingUpd
              (Grouping   = Grouping
              ,DOOverRide = RPM$OverRideToRed
              );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not set override flag.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Insert object based on fromTFMS flag.
*/
   IF FromTFMS = TRUE THEN
      FOR i = 1 to ObjectList.LastRow() DO
         RetCode = CALLPROC CAC_CO_FeederIns (
                  Grouping = Grouping,
                  Feeder = ObjectList[i].Value
                  );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert feeder information.');
            Message 'Could not insert feeder information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RESUME;    
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
      /*
      ** Log OverRide.
      */
      RetCode = CALLPROC SOA_LogIns (
               Card            = CardObject
              ,Job             = NULL
              ,SwitchingItem   = 0
              ,Time            = DATE('now')
              ,UserName        = UserName
              ,Item            = 'Matrix OverRide'
              ,New             = 'See Log'
              );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to insert log' +
                 ' entry indicating Matrix OverRide.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*  
      **  Insert a new log into the database: 
      */ 
      RetCode = SOA_CardLogIns (Card = CardObject, 
                                SwitchingItem = 0,
                                LogTime = date('now'), 
                                Log = Comment, 
                                LogStatus = 'COMPLETE' 
                               ); 
      IF (RetCode <> 0) THEN 
         CALLPROC DDB_ROLLBACK; 
         Message 'Could not insert Log message';
      ENDIF; 
      CALLPROC DDB_COMMIT; 
   ELSE
      FOR i = 1 to ObjectList.LastRow() DO
         RetCode = CALLPROC CAC_CO_CircuitIns (
                  Grouping = Grouping,
                  Circuit = ObjectList[i].Value,
                  Seq = i
                  );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert circuit information.');
            Message 'Could not insert feeder information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RESUME;    
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;   
      /*
      **  Log that they chose to continue
      */
      CALLPROC TC_LogChange (
              Card = CardObject,
              Job = NULL,
              Item = 'Matrix OverRide',
              Old = '',
              New = 'See Log');
      CALLPROC DDB_COMMIT;

      RetCode = TC_circuitsLogIns (Card = CardObject, 
	                          LogTime = date('now'), 
		                  Log = Comment, 
		                  LogStatus = 'COMPLETE' 
		                  ); 
      IF RetCode <> 0 THEN 
         CALLPROC DDB_ROLLBACK; 
         Message 'Could not insert into Circuit Log';
      ENDIF; 
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Log the event for historical purposes.
*/
   TempChar = Comment + HC_NEWLINE + FIELD(ObjectTxt).TextValue;
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = Grouping, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$OverRideToRed,
                   Comment = TempChar);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:RelayProtectionOverRide:Error logging OverRide to Red condition.');
   ENDIF;
   CALLPROC DDB_COMMIT;  

   FIELD(ClearOverride_btn).CurBias = FB_LANDABLE;
   FIELD(Override_btn).CurBias = FB_INVISIBLE;
END;

ON Click ClearOverRide_Btn = 
BEGIN 
   IF FromTFMS = TRUE THEN
      /*
      ** Log OverRide.
      */
      RetCode = CALLPROC SOA_LogIns (
               Card            = CardObject
              ,Job             = NULL
              ,SwitchingItem   = 0
              ,Time            = DATE('now')
              ,UserName        = UserName
              ,Item            = 'Matrix OverRide'
              ,New             = 'Cleared'
              );

      CALLPROC DDB_COMMIT;
   
   ELSE
      /*
      **  Log that they chose to continue
      */
      CALLPROC TC_LogChange (
              Card = CardObject,
              Job = NULL,
              Item = 'Matrix OverRide',
              Old = '',
              New = 'Cleared');
      CALLPROC DDB_COMMIT;

   ENDIF;
/*
**  Remove circuit/feeder info.
*/
   RetCode = CALLPROC CAC_CO_GroupingDel
              (Grouping   = Grouping);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not clear OverRide details.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Remove grouping info.
*/
   RetCode = CALLPROC CAC_Relay_GroupingDel
              (Grouping   = Grouping);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not clear OverRide.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Log the event for historical purposes.
*/
   TempChar = 'Cleared - ' + Comment + HC_NEWLINE + FIELD(ObjectTxt).TextValue;
   RetCode = CALLPROC CAC_Relay_GroupingHistoryIns (
                   Grouping = Grouping, 
                   UserName = DOp.Description,
                   LogDate = date('now'),
                   LogType = RPM$OverRideToRed,
                   Comment = TempChar);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace(Text = VARCHAR(DATE('now')) + 
         'FRAME:RelayProtectionOverRide:Error logging OverRide to Red condition.');
   ENDIF;
   CALLPROC DDB_COMMIT;  

   FIELD(ClearOverride_btn).CurBias = FB_INVISIBLE;
   FIELD(Override_btn).CurBias = FB_LANDABLE;

   Comment = '';
   FIELD(Comment).CurBias = FB_CHANGEABLE;
END; 



ON CLICK Close_Btn =
BEGIN  
   RETURN;
END;

ON WindowClose =
BEGIN
    RESUME;
END;

Application Component Report
============================

	Name:            RelayScadaLines

/*
**	Copyright c 1995 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
**
**  Application:    Telephonecard
**  Frame:          RelayScadaLines
**
**  10/23/96   pkw    created
**  01/20/10   ysp    TLS 50: Circuit Route info is now in udb_circuitroute.
*/

INITIALIZE
(
   i = INTEGER NOT NULL WITH DEFAULT;
   CurrentCircuit = INTEGER NOT NULL WITH DEFAULT;
   TempStationName = VARCHAR(40) NOT NULL;
) =
BEGIN
/*
**  Load Circuit list
*/
    i = 1;
    Circuit.Clear();
    REPEATED
    SELECT :Circuit[i].Card = C.Card,
           :Circuit[i].Circuit = O.Object,
           :Circuit[i].LineNumber = O.Name,
           :Circuit[i].LineTypeName = O.TypeName,
           :Circuit[i].RouteName = C.RouteName
    FROM   Udb_Object O,
           Udb_Object O1,
           TC_Card C,
           Udb_CircuitRoute TC
    WHERE  O1.Object = :CurrentCircuit AND
           O1.PrimaryGrouping = O.PrimaryGrouping AND
           O1.Type = O.Type AND
           O.Object = C.Circuit AND
           C.Status IN (:TC_Card$Active, :Card$PST, :Card$Telco) AND
           O.Object = TC.Object AND
           TC.Route IN (:Route$NumberOne,:Route$NumberTwo)
    ORDER BY LineNumber
    BEGIN
       /*
       **  Get all of the substations and concatenate them into one field
       */
       TempStationName = '';
       REPEATED
       SELECT  :TempStationName = O.Name
       FROM    Udb_Grouping G,
               Udb_ExtendedType ET,
               Udb_Object O
       WHERE   G.Member = :Circuit[i].Circuit
       AND     G.Relationship = :Interaction$MemberOf
       AND     G.Grouping = O.Object
       AND     G.GroupingType = ET.Type
       AND     ET.SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
       BEGIN
          IF (Circuit[i].SubstationNames = '') THEN
              Circuit[i].SubstationNames = TempStationName;
          ELSE
              Circuit[i].SubstationNames = Circuit[i].SubstationNames +', ' + TempStationName;
          ENDIF;
       END;
       CALLPROC DDB_ROLLBACK;
       /*
       **  Start out assuming the circuit is inservice and
       **  replace status if circuit is outservice.
       **  1 = inservice; 2 = outservice;
       */
       Circuit[i].Status = 1;
       REPEATED
       SELECT :Circuit[i].Status = 0
       FROM   TC_Job J
       WHERE  J.Circuit  = :Circuit[i].Circuit AND
              J.OutService IS NOT NULL AND
              J.InService IS NULL;  
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
/*
**  Go through each circuit and figure out which organization has control of 
**  the circuit.
*/
    i = 1;
    WHILE i <= Circuit.LastRow() DO
       REPEATED
       SELECT :Circuit[i].OrganizationName = RS.OrganizationName
       FROM   TC_ReportStats RS
       WHERE  RS.Card = :Circuit[i].Card AND
              RS.OutService IS NOT NULL AND
              RS.Inservice IS NULL AND
              RS.Circuit = :Circuit[i].Circuit;
       i = i + 1;
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    Field(Circuit).NumVisibleRows = Circuit.LastRow();
    IF Circuit.LastRow() = 0 THEN
       RETURN;
    ENDIF;
END;


