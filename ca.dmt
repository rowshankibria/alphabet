PROCEDURE CompleteBusSectWP(
   Card          = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   CardList = ARRAY OF FMS_Card;
   DelayList = ARRAY OF TypeClass;
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  See if there are any other outstanding workpermits for BusSect move.
**  If there is we don't need to continue with processing at this time.
*/
   i = 0;
   SELECT :i = count(*)
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :Card AND
          JC.SwitchingItem = :SwitchingItem AND
          JC.StepPair = :StepHeading$WorkPermit AND
          JC.Job = J.Job AND
          J.TOIssued IS NOT NULL AND
          J.RSComplete IS NULL AND
          J.Status <> 'Del' AND
          J.EquipClass = :TypeName$BusSect;
   IF i <> 0 THEN
      RETURN;
   ENDIF;
/*
**  Find all FMS_Cards linked to this SwitchingItem.
*/
   i = 1;
   CardList.Clear();
   SELECT :CardList[i].Card = S.FMSCard,
          :CardList[i].CardClass = C.CardClass,
          :CardList[i].CardClassName = C.CardClassName,
          :CardList[i].Feeder = C.Feeder,
          :CardList[i].FeederName = C.FeederName
   FROM    SOA_FMSSLCLink S,
           FMS_Card C
   WHERE   S.SLCCard = :Card AND
           S.SwitchingItem = :SwitchingItem AND
           S.FMSCard = C.Card
   BEGIN 
      i = i + 1;
   END;
/*
**  Now for each card we will look to see if OTWS is the 
**  current operating step.
*/ 
   FOR i = 1 TO CardList.LastRow DO
      j = 0;
      SELECT :j = COUNT(*) 
      FROM    FMS_OperatingStepStatus O
      WHERE   O.Card = :CardList[i].Card AND
              O.OperatingStep = :Type$OTWS AND
              O.EndTime = '';
      IF j <> 0 THEN
         /*
         **  Need to see if there are any outstanding permits on FMS card 
         **  that set OTWS.  If there were OTWR steps we wouldn't be in 
         **  this if statement.
         */
         j = 0;
         REPEATED
         SELECT :j = count(*)
         FROM   SOA_Job J,
                SOA_JobControl JC,
                FMS_WorkPermit WP,
                FMS_JobAction JA,
                SOA_ActiveCard AC
         WHERE  AC.Card = :CardList[i].Card AND
                JC.Card = AC.Card AND
                JC.Job = J.Job AND
                J.TOIssued IS NOT NULL AND
                J.RSComplete IS NULL AND
                J.Status <> 'Del' AND
                J.Job  = WP.PermitJobID AND
                WP.Restoration = :FALSE AND  /* 0 = prevent restoration */
                JA.JobClass = J.JobClass AND
                JA.FeederEquip = 3 AND
                JA.Status = :Type$OTWS AND
                JA.TypeOfCard = AC.TypeOfCard;
         IF j = 0 THEN
            IF SimpleStep IS NULL THEN
               SimpleStep = OperatingStep_ASE.Create();
            ENDIF;
            SimpleStep.SO.Object = CardList[i].Card;
            SimpleStep.OpStep    = Type$OTWS; 
   
            SimpleStep.ClearOpStep();
   
            IF SimpleStep.ReturnCode <> 0 THEN
               CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                  TraceMessage =
                   'FRAME:CompletePermits;Error clearing Operating Step. ' +
                   'Card=' + VARCHAR(CardList[i].Card) +
                   ';Status=' + VARCHAR(Type$OTWS) + '.'
                  );
            ENDIF; 
            /*
            **  See if cutin move is available to link BUSSECT delay.
            */
            j = 0;
            SELECT :j = J.Job
            FROM    SOA_ActiveCard AC,
                    SOA_Job J,
                    SOA_JobControl JC,
                    FMS_JobAction JA
            WHERE   AC.Card = :CardList[i].Card AND
                    JC.Card = AC.Card AND
                    JC.Job = J.Job AND
                    J.RSComplete IS NULL AND
                    J.JobClass = JA.JobClass AND
                    JA.EquipClass = JC.MoveEquipClass AND
                    JA.StepPair = JC.StepPair AND
                    JA.TypeOfCard = AC.TypeOfCard AND
                    J.Status IN ('','NIS') AND
                    JA.TORS = :Job$RestoreInt AND
                    JA.Action = :JobAction$Prompt AND
                    JA.Status = :JobAction$CutIn;
            IF j <> 0 THEN
               /*
               **  Insert BusSect Delay.
               */
               RetCode = CALLPROC FMS_OperatingStepIns
                   (Card = CardList[i].Card,
                    CardClassName = CardList[i].CardClassName,
                    Feeder = CardList[i].Feeder,
                    FeederName = CardList[i].FeederName,
                    OperatingStep = Delay$BusSect,
                    StartTime = 'NOW'); 
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Unable to add BUSSECT Delay to feeder: ' +
                       CardList[i].Feedername + ',  please add manually.';
               ENDIF; 

               RetCode = CALLPROC FMS_JobDelayLinkIns
                               (Job  = j,
                                Card = CardList[i].Card,
                                OperatingStep = Delay$BusSect);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                     'ERROR::CompletePermits;Unable to link jobs to BUSSECT Delay on card ' + 
                      varchar(CardList[i].Card) + '. Delay insert rolled back.');
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;  
      ENDIF;    
   ENDFOR;
   SimpleStep = NULL;
END;
			 *Default Item


Application Component Report
============================

	Name:            CompleteStatus

/*
**
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software LLC proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CompleteStatus
**
**  Modifications:
**  08/08/11   ysp  Copied from IncompleteStatus
**  03/13/18   em   Add OFSPhaseCheckIndicator parm to distinguish OFS permit with impacted equip
**  02/03/23   em   Add CPM Checklist
*/

INITIALIZE
(
    J = JobInProgress;     /* Job being processed */
    OFSPhaseCheckIndicator = INTEGER NOT NULL WITH DEFAULT;    /* Optional Passed*/ 
    ReturnPermit = INTEGER NOT NULL WITH DEFAULT;    /* Optional Passed*/ 
    Application = VARCHAR(20) NOT NULL WITH DEFAULT; /* Optional Passed*/
    CanReturnToService = CHAR(3) NOT NULL WITH DEFAULT; /* Optional Passed*/   

    i = INTEGER NOT NULL WITH DEFAULT;                /* Scratch integer */
    CPMPermit = INTEGER NOT NULL WITH DEFAULT;  
    CPMNote = INTEGER NOT NULL WITH DEFAULT;    /*  Passed Back as a ByRef parm */
    ISPermit = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER;
) =
BEGIN
   ISPermit = 0;
   SELECT :ISPermit = ISPermit
   FROM   SOA_InServicePermit
   WHERE  Job = :J.Job;

   IF ISPermit <> 0 AND OFSPhaseCheckIndicator = 0 THEN
      RETURN (PU_OK);
   ENDIF;
   
   CPMPermit = 0;
   SELECT :CPMPermit = JobClass
   FROM   FMS_JobAction 
   WHERE  JobClass = :J.JobClass AND
          Status = :Prompt$CPMCheckList;
          
   IF CPMPermit > 0 THEN
      FIELD(CPM).CurBias = FB_CHANGEABLE;
   ENDIF;

   Job[1] = J.Duplicate();
/*
** Figure out display of Restore to Service information.
*/
   IF ReturnPermit = FALSE THEN
      FIELD(VerbalCheck).CurBias = FB_CHANGEABLE;
      FIELD(Restore_stk).CurBias = FB_INVISIBLE;    
   ELSE
      FIELD(VerbalCheck).CurBias = FB_INVISIBLE;
      IF CanReturnToService = 'YES' THEN
         FIELD(Restore_stk.can_restore).CurBias = FB_VISIBLE;
         FIELD(Restore_stk.cannot_restore).CurBias = FB_INVISIBLE;
      ELSE
         FIELD(Restore_stk.can_restore).CurBias = FB_INVISIBLE;
         FIELD(Restore_stk.cannot_restore).CurBias = FB_VISIBLE;
      ENDIF;
   ENDIF;
END;


ON Click OK_Btn =
BEGIN 
   IF ReturnPermit = FALSE THEN
      IF VerbalCheck.RestoreEquip < 1 OR VerbalCheck.RestoreEquip > 3 THEN 
         MESSAGE 'Please indicate whether equipment can be returned to service';
         RESUME;
      ENDIF; 
   ENDIF;

#  INCLUDE ProcessCPMCheckList  

   RETURN (PU_OK);
END;

ON SETVALUE VerbalCheck.RestoreEquip =
BEGIN
   IF VerbalCheck.RestoreEquip = 1 THEN
      CanReturnToService = 'YES';
   ELSEIF VerbalCheck.RestoreEquip = 2 THEN
      CanReturnToService = 'NO';
   ELSE
      CanReturnToService = '';
   ENDIF;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
