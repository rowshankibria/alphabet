	Name:            CheckDownstreamHTVClear

/*
**
**	Copyright c 2012 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckDownstreamHTVClear  
**
**  Modifications:
**	03/05/18   pkw	Created 
*/
PROCEDURE  CheckDownstreamHTVClear
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    HTVWarning = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    FeederOut = INTEGER NOT NULL WITH DEFAULT;
    HTVTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
    HTVName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    RetCode = NULL;
/*
**  Only perform check if feeder is in-service and move is defined
**  as MTA Isolation switch of feeder.
*/
    i = 0;
    REPEATED
    SELECT DISTINCT
           :i = COUNT(*)
    FROM    SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C,
            Udb_Grouping G
    WHERE   J.Job = :JIP.Job AND
            J.Equip = G.Member AND
            G.Relationship = :Interaction$MTAIsolationFor AND
            G.GroupingType = :Type$Feeder AND
            J.Job = JC.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card AND
           (C.Cutout IS NULL OR
            C.CutIn IS NOT NULL);

    IF i <> 0 THEN
       HTVWarning = '';
       SELECT HTVTypeName = O.TypeName,
              HTVName = O.Name
       FROM   Udb_Switch S,
              Udb_Grouping G,
              Udb_ExtendedType ET,
              Udb_Object O
       WHERE  G.Grouping = :JIP.Equip AND
              G.Relationship = :Interaction$MTADownstreamOf AND
              G.MemberType = ET.Type AND
              ET.SuperType = :Type$HTVStd AND
              G.Member = S.Object AND
              S.CurrentlyOpen = 0 AND
              S.Object = O.Object
       BEGIN
          IF HTVWarning = '' THEN
             HTVWarning = HTVTypeName + ' ' + HTVName;          
          ELSE
             HTVWarning = HTVWarning + ', ' + HTVTypeName + ' ' + HTVName;
          ENDIF;
       END;
       
       IF HTVWarning <> '' THEN
    
           WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'Downstream ' + HTVWarning + 
                              ' not clear.');   
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;

        ENDIF;
   ENDIF;

   RETURN(RetCode);
END;

Application Component Report
============================

	Name:            CheckEnDeEn

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          CheckEnDeEn
**  OverView:       When the last cut out breaker move (as identified by moves 
**                  for breaker equipment which call PromptSetCurrentlyOpen) in
**                  the En-De-En substation is executed, we must check that all
**                  other cut out breaker in all substations on the card are 
**                  complete.
**                  Conversely, when breakers are being opened, we must make 
**                  sure that the first breaker opened on the card appears in
**                  the En-De-En substation.
**                   
**  Modifications:
**	02/01/96    jfl     Created 
**	06/21/96    jfl     Make this a standard precheck
**			    Implement check for restore moves: first
**			    closing breaker must be at EN-DE-EN substation
**      03/23/99    em      Incorporated into SOA.  Corrected bugs as identified
**                          in 4/24/98 email.  
**      05/03/99    em      Use Udb to determine Load Breaking equipment rather
**                          than jobs on the card, just in case a LoadBreaking
**                          device doesn't have a move on the card.
** �                        Look at PendingStatus if initial check fails.
**      05/10/99    em      Since job may appear on multiple TFMS cards,
**                          converted this program into a shell calling 
**                          EnDeEn 4GL Procedure for each card.
**      02/26/01    em      Ignore Spare Bank Breakers
**      11/26/02    pkw     Change Job to JIP for Merge.
**      02/28/03    pkw     Use DISTINCT against SOA_ActiveCard for feeder
**                          that span divisions.
*/
PROCEDURE CheckEnDeEn
(
    JIP = JobInProgress;                    /* Passed Job*/

    Cards = ARRAY OF INTEGEROBJECT;         /*TFMS Cards*/
    i = INTEGER NOT NULL WITH DEFAULT;      /*COUNTER*/
    RetCode = INTEGER NOT NULL;             /* Return Code */ 
) =
BEGIN
/*
**  Check that this a breaker move
*/
    i = 0;
    SELECT :i = Count(*)
    FROM   UDB_ExtendedType ET
    WHERE  ET.SuperType = :Type$LoadBreaking 
      AND  ET.Type = :JIP.EquipClass;

    IF i = 0 THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  IF this is a Spare Bank breaker, ignore it.
*/
    SELECT :i = COUNT(*) 
    FROM   UDB_ExtendedType ET
    WHERE  ET.SuperType IN (:Type$BkrSpare,:Type$BkrROSpare) 
      AND  ET.Type = :JIP.EquipClass;
   
    IF i > 0 THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  Now make sure we have a transmission card.  Procedure can be called
**  from SLC in SOA.
*/
    i = 1;
    Cards.Clear();
    REPEATED
    SELECT DISTINCT
          :Cards[i].Value = JC.Card 
    FROM   SOA_JobControl JC,
           SOA_ActiveCard AC
    WHERE  JC.Job = :JIP.Job AND
           JC.Card = AC.Card AND
           AC.Application = :Application$TFMS
    BEGIN
       i = i + 1;
    END;

    IF Cards.LastRow() = 0 THEN
       RETURN (PU_OK);
    ELSE

       FOR i = 1 TO Cards.LastRow() DO
          RetCode = CALLPROC EnDeEnCheck (Job = JIP, Card = Cards[i].Value); 
           
          IF RetCode <> PU_OK THEN
             RETURN (RetCode); 
          ENDIF;
       ENDFOR;

    ENDIF; 

    RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            CheckEquipGroundOnly

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckEquipGroundOnly  
**
**  Modifications:
**  11/03/92 em   Created 
**  11/19/02 ysp  Merge: removed passed-in C and Jobs
**  02/28/03 pkw  Use DISTINCT against SOA_ActiveCard for feeder
**                that span divisions.
**  02/14/13 pkw  Check for grounds on Step Down card.
**  08/10/16 ysp  For 33kv portion card, prepend main feeder name to the portion name in messages 
**  02/24/17 em   For No Ground on this Equip warning, look for pending status HVRSIP which will allow
**                THe RS side and TO side of a duplicate move be issued together without a warning.
*/
PROCEDURE  CheckEquipGroundOnly 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    SDObjects = FMS_Card;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER NOT NULL;
    j = INTEGER NOT NULL;
    HVRSIP = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   WarningStatus = PU_OK;

   i = 1;
   REPEATED
   SELECT DISTINCT 
          :CommonFeederCard[i].Card = C.Card,
          :CommonFeederCard[i].FeederName = C.FeederName,
          :CommonFeederCard[i].Feeder = C.Feeder,
          :CommonFeederCard[i].GroundsOn = C.GroundsOn,
          :CommonFeederCard[i].StationGround = C.StationGround,
          :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
          :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
          :CommonFeederCard[i].Status = 0     /* Used to signify Link 4kv card; 0 look for Station Ground, 1 = All grounds considered field ground */
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card
   BEGIN
      i = i + 1;
   END;
   /*
   **  For each feeder look for Step Down link to other feeder
   */
   FOR i = 1 TO CommonFeederCard.LastRow DO      
      /*
      **  Check to see if current feeder has a link to StepDown Feeder.
      **  If so look at 4kV feeder to see if SD-LoadElbow equipment type
      **  is closed.  If yes, then look for other linked cards
      **  and check ground status on those card.  
      **  For other linked cards, all grounds will be considered Field grounds.
      **  We will signify other linked cards by setting Status = 1 and in this case 
      **  the station checks will be ignored below.
      */
      IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV AND 
         CommonFeederCard[i].Status = 0 THEN
         
         SDObjects = NULL;
         SDObjects = FMS_Card.Create();
         REPEATED
         SELECT DISTINCT
               :SDObjects.Card = C.Card,
               :SDObjects.FeederName = C.FeederName,
               :SDObjects.Feeder = C.Feeder,
               :SDObjects.StationGround = C.StationGround,
               :SDObjects.GroundsOn = C.GroundsOn,
               :SDObjects.TypeOfCard = C.TypeOfCard,
               :SDObjects.Status = 1     
         FROM  FMS_StepDownLink L,
               Udb_Switch S,
               Udb_Grouping G,
               TFMS_CardToObject CTO,
               FMS_Card C
         WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
               L.Card = C.Card AND
               CTO.Card = L.StepDownCard AND
               CTO.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.MemberType = :Type$SDLoadElbow AND
               G.Member = S.Object AND
               S.CurrentlyOpen = 0
         BEGIN
            j = 1;
            WHILE j <= CommonFeederCard.LastRow DO
               IF CommonFeederCard[j].Card = SDObjects.Card THEN
                  ENDLOOP;
               ENDIF;
               j = j + 1;
            ENDWHILE;
            IF j > CommonFeederCard.LastRow THEN
               CommonFeederCard[j] = SDObjects.Duplicate();
            ENDIF;
         END;
          
      ELSEIF CommonFeederCard[i].Status = 0 THEN
         SDObjects = NULL;
         SDObjects = FMS_Card.Create();
         REPEATED
         SELECT DISTINCT
               :SDObjects.Card = C.Card,
               :SDObjects.FeederName = C.FeederName,
               :SDObjects.Feeder = C.Feeder,
               :SDObjects.StationGround = C.StationGround,
               :SDObjects.GroundsOn = C.GroundsOn,
               :SDObjects.TypeOfCard = C.TypeOfCard,
               :SDObjects.Status = 1     
         FROM    FMS_StepDownLink L,
                 Udb_Switch S,
                 Udb_Grouping G,
                 TFMS_CardToObject CTO,
                 FMS_Card C
         WHERE   L.Card = :CommonFeederCard[i].Card AND
                 L.StepDownCard = C.Card AND
                 C.Card = CTO.Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType = :Type$SDLoadElbow AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0
         BEGIN
            j = 1;
            WHILE j <= CommonFeederCard.LastRow DO
               IF CommonFeederCard[j].Card = SDObjects.Card THEN
                  ENDLOOP;
               ENDIF;
               j = j + 1;
            ENDWHILE;
            IF j > CommonFeederCard.LastRow THEN
               CommonFeederCard[j] = SDObjects.Duplicate();
            ENDIF;
         END;      
      ENDIF;  
   ENDFOR; 

   RetCode = NULL;

   FOR i = 1 TO CommonFeederCard.LastRow() DO
      FeederName = CommonFeederCard[i].GetGeneralCardName();

      IF CommonFeederCard[i].Status = 0 THEN  /* Perform usual check */

         IF JIP.Grounds IS NOT NULL AND JIP.Grounds > 0 AND 
            CommonFeederCard[i].GroundsOn = JIP.Grounds THEN 
            RetCode = NULL;

         ELSEIF CommonFeederCard[i].StationGround = 'On' THEN 
       
            WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'The feeder: ' + FeederName + ' is still grounded.');  
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden; 
            ENDIF;

         ELSEIF JIP.Grounds IS NULL OR JIP.Grounds = 0 THEN 
/*
** Check for Pending RS Move issued to same operator
*/
            HVRSIP = 0;
            SELECT :HVRSIP = PendingStatus 
            FROM   FMS_PendingStatus
            WHERE  Object = :JIP.Equip AND
                   IssuedOperator = :JIP.TOOperator AND
                   PendingStatus = :Status$HVRSIP AND
                   StatusCount = 0;

            IF HVRSIP = 0 THEN             
               WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'No ground on this equipment.');  
               IF WarningStatus = PU_CANCEL THEN
                  RETURN(PU_CANCEL);
               ELSE
                  RetCode = Warning$Overridden; 
               ENDIF;
            ENDIF;

         ELSE
          
            WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'There are other field grounds applied on feeder: '+ 
                              FeederName );
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden; 
            ENDIF;
         ENDIF;
      ELSE
         IF CommonFeederCard[i].GroundsOn <> 0 THEN
            WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = 'There are still field grounds applied on feeder: ' +
                                          FeederName + '.');
            IF WarningStatus = PU_CANCEL THEN
               RETURN(PU_CANCEL);
            ELSE
               RetCode = Warning$Overridden;
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;

   RETURN(RetCode); 

END;

Application Component Report
============================

	Name:            CheckFeederCutIn

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckFeederCutIn
**
**  Modifications:
**  11/25/92  em	  Created 
**  11/19/02  ysp  Merge: removed passed-in C and Jobs
**  02/28/03  pkw  Use DISTINCT against SOA_ActiveCard for feeder that span divisions.
**  08/10/16  ysp  For 33kv portion card, prepend main feeder name to the portion name in messages 
**  06/04/19  pkw  Remove code related to rapidrestore flag.
*/
PROCEDURE CheckFeederCutIn  
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
ENDDECLARE
BEGIN
/*
**  Find all feeder cards which this job is shared on.
*/
    RetCode = NULL;

    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,
           :CommonFeederCard[i].CutOut = C.CutOut,
           :CommonFeederCard[i].CutIn = C.CutIn,
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    FOR i = 1 to CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[i].GetGeneralCardName();
       
       IF CommonFeederCard[i].CutOut IS NOT NULL AND 
          CommonFeederCard[i].CutIn IS NULL THEN 
    
           WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'Feeder ' + FeederName + 
                              ' has not been cut in.');   
           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RetCode = Warning$Overridden;
           ENDIF;

        ENDIF;
   ENDFOR;

   RETURN(RetCode);
END; 

Application Component Report
============================

	Name:            CheckGroundElseWhere

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckGroundElseWhere 
**
**  Modifications:
**  11/03/92 em	    Created 
**  01/21/93 em     Instead of subtracting 1 from the GroundCount, subtract
**                      the number of Grounds on the particular piece of equipment.
**  11/19/02 ysp    Merge: removed passed-in C and Jobs
**  02/28/03 pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                  that span divisions.
**  02/15/13 pkw    Update for Stepdown to look for grounds across cards.
**  02/22/16 em     Evaluate equipment for ShortsOn status and exit if exists.
**  10/14/16 ysp    Merge: For 33kv portion card, prepend main feeder name to the portion name in messages 
**  03/06/18 pkw    Ignore check if MTAOpen = TRUE
**  11/13/18 pkw    Ignore check if MicroGrid and device is source pos for microgrid
*/
PROCEDURE CheckGroundElseWhere 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE
    i = INTEGER NOT NULL;
    k = INTEGER NOT NULL;
    CommonFeederCard = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    SkipWarning = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE    
BEGIN
/*
**  If MTA Isolation switch is open ignore check.
*/
    IF MTAOpen = TRUE THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  If Micro Grid is open and device is Source Position for Micro Grid ignore check.
*/
    IF MicroGridOpen = TRUE THEN
       SkipWarning = FALSE;
       SELECT :SkipWarning = :TRUE 
       FROM   Udb_Grouping G,
              Udb_Grouping G2,
              Udb_ExtendedType ET
       WHERE  G.Member = :JIP.Equip AND
              G.Relationship = :Interaction$MicroGridSourcePos AND
              G.Grouping = G2.Member AND
              G2.Relationship = :Interaction$MicroGridFor AND
              G2.Groupingtype = ET.Type AND
              ET.SuperType = :Type$Feeder;
       IF SkipWarning = TRUE THEN
          RETURN(PU_OK);   
       ENDIF;
    ENDIF;
/*
**  Look for ShortsOn on Job Equipment.
*/
    i = 0;
    SELECT :i = Status
    FROM   FMS_ObjectStatus 
    WHERE  Object = :JIP.Equip AND
           Status = :Status$ShortsOn AND
           StatusCount > 0;
    IF i > 0 THEN
       RETURN(PU_OK);
    ENDIF;
 
    WarningStatus = PU_OK;
/*
**  Find all feeder cards where this job is shared.
*/
    RetCode = NULL;

    i = 1;
    REPEATED
    SELECT DISTINCT
           :CommonFeederCard[i].Card = C.Card,
           :CommonFeederCard[i].FeederName = C.FeederName,
           :CommonFeederCard[i].Feeder = C.Feeder,
           :CommonFeederCard[i].NetworkFeeder = C.NetworkFeeder,
           :CommonFeederCard[i].TypeOfCard = C.TypeOfCard,
           :CommonFeederCard[i].GroundsOn = C.GroundsOn
    FROM    SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
    WHERE   JC.Job = :JIP.Job AND
            JC.Card = C.Card AND
            JC.Card = AC.Card
    BEGIN
       i = i + 1;
    END;

    FOR i = 1 to CommonFeederCard.LastRow() DO
       FeederName = CommonFeederCard[i].GetGeneralCardName();
       
       k = CommonFeederCard[i].GroundsOn;

       IF JIP.Grounds IS NOT NULL AND JIP.Grounds > 0 THEN
          k = k - JIP.Grounds;   /* Don't count grounds on this piece of equipment */ 
       ENDIF;

       IF k = 0 THEN 
          /*
          **  When looking for grounds, check if this card has a link 
          **  to 4kv StepDown cards and combine counts for both cards.
          **  Only check if SD-VIS AND SDLoadElbow are both closed.
          */
          SELECT :k = COUNT(*) 
          FROM    FMS_StepDownLink L,
                  Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE (L.Card = :CommonFeederCard[i].Card OR
                 L.StepDownCard = :CommonFeederCard[i].Card) AND
                 L.StepDownCard = CTO.Card AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.MemberType in (:Type$SDVIS,:Type$SDLoadElbow) AND
                 G.Member = S.Object AND
                 S.CurrentlyOpen = 0;
                  
          IF k = 2 THEN  
             /* 
             ** Both devices are closed.  Now check grounds on other feeders involved.
             */
             IF CommonFeederCard[i].TypeOfCard = TypeOfCard$4KV THEN
                /*
                **  Assume no ground will be placed on SD-VIS which is only
                **  common piece of equipment between 4kV and 13kV cards.
                */
                k = 0;
                SELECT :k = COUNT(*)
                FROM  FMS_StepDownLink L,
                      FMS_Card C
                WHERE L.StepDownCard = :CommonFeederCard[i].Card AND
                      L.Card = C.Card AND
                      C.GroundsOn > 0;
             ELSE
                k = 0;
                SELECT :k = COUNT(*)
                FROM  FMS_StepDownLink L,
                      FMS_Card C
                WHERE L.Card = :CommonFeederCard[i].Card AND
                      L.StepDownCard = C.Card AND
                      C.GroundsOn > 0;
             ENDIF;
             IF k > 0 THEN
                CONTINUE;
             ENDIF;
          ENDIF;

          WarningStatus = CALLFRAME Warning (
                              Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'There are no grounds elsewhere on feeder ' +
                                     FeederName);
          IF WarningStatus = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RetCode = Warning$Overridden; 
          ENDIF;
       ENDIF; 
    ENDFOR;

    RETURN(RetCode); 
END;

