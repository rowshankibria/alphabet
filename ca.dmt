Name:      ok_btn

					Fieldobject Script
					------------------



Application Component Report
============================

	Name:            SelectTerminal

/*
**  Application:	CAC
**  Frame:  		SelectTerminal
**
**  11/12/98    pkw    modified fms version.
**  05/20/99    em     Combined SelectTerminal and PhaseGround Selection
**  07/08/99    em     If one terminal is not connected, return the other
**                     terminal as the ground point if the Action is "placed".
**                     Don't display the
**                     screen when only one side connected.
**  09/29/99    em     Remove Ground was not properly returning if only
**                     one terminal was set.
**  05/31/00    em     Don't need PrintID for SOA in the select stmt.
**                     For Type BPD or CCPD single terminal devices, place the
**                     ground on terminal 0 so that connectivity trace will
**                     ignore the ground for open devices. 
**  11/04/02    em     Job to JIP. 
**  03/05/03    em     If Ground is being placed on a Source Position device,
**                     automatically place the ground on terminal 2, the feeder
**                     side.  Do not wish to see the Select Terminal screen
**                     displayed within FMS.
**  03/06/03    em     Add PrimaryGrouping, remove PrintID.  Should only be used
**                     from TOMS.
**  02/18/04    em     Default to terminal=0 during automatic execution 
**                     to avoid display of screen
**  09/26/05    ysp    update the text to support itc 181: select terminal at the time of issuance 
**  11/16/05    em     Pass in Move Text for update.
**  11/29/05    ysp    If Ground is being removed from a Source Position, automatically
**                     remove it from terminal 2. This change (by removing the code that checks
**                     the type of action) is symmetrical to the one made on 03/05/03. This will 
**                     fix the problem when a negavtive (-1) ground count is on terminal 0 and
**                     a positive ground count is on terminal 2.
**  01/31/07    ysp    When the move is ABOUT to remove a ground(at the moment of issuing a move), 
**                     check if another move has requested to do the same on a terminal. if so, 
**                     that terminal is dimmed out so that DO can't select that terminal again.
**  02/07/07    em     Revised logic in various areas:
**                     - When placing a ground and the object has a negative ground, place the ground 
**                       on the same Terminal.
**  02/19/09    ysp    If no terminals are grounded at the time when DO issues to remove a ground,
**                     check if a ground is to be placed. Sometimes, the DO issues the takeout 
**                     and restore move at the same time, when there is no ground status while a 
**                     removing ground is issued. 
**  09/06/11    em     With Source Connected enhancement, cannot rely on terminal 2 to be connected to the 
**                     feeder side.  Targeted grounds should be using Job Action Prompts Set/RemoveFeederSide.
**                     Will default to terminal = 0 for FMS Source Position.
**  04/21/16    em     If we are grounding an interrupter switch connected to a 33kV feeder segment, will 
**                     return terminal = 0, present message indicating ground should not be place
**  09/13/16    em     Add ForceAbort33kV global to pass Abort indicator back to PerformMoves.
**  03/28/17    ysp    1. Converted object terminal to QGis-based connection object. 2. Check equipment type
**                     if it is suitable for grounds on terminals.
**  04/05/17    em     Modifications to display and instructions.
**  05/04/17    ysp    Check for single terminal before checking equipment types
**  10/24/17    ysp    In case DO is removing a ground that does not exist. Return terminal 0.
**  10/18/18    em     Update move text length 80 to 160
**  01/14/19    em     When removing ground on Source Position or other auto RETURN 0 outcomes, 
**                     look for terminal with ground only on one terminal, 
**                     can't just return terminal=0
**  06/23/19    em     Correcting flaw when removing ground is picking terminal when ground was
**                     placed on terminal = 0. Added Attribute Connectable Device.
*/

INITIALIZE
(
   JIP           = JobInProgress;                  /* Passed Job */
   Action        = VARCHAR(20) NOT NULL WITH DEFAULT; /* Passed Action (place or remove)*/
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   gnd_check     = INTEGER NOT NULL;
   ConnectableDevice = INTEGER NOT NULL WITH DEFAULT;
   GroundTerminal = INTEGER NOT NULL WITH DEFAULT;
   Term1Node     = INTEGER NOT NULL WITH DEFAULT;
   Term2Node     = INTEGER NOT NULL WITH DEFAULT;
   EquipObj      = INTEGER NOT NULL WITH DEFAULT;
   IfBPDorCCPD   = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   Pos_Y1        = INTEGER NOT NULL WITH DEFAULT; 
   Pos_Y2        = INTEGER NOT NULL WITH DEFAULT; 
   RetCode       = INTEGER NOT NULL WITH DEFAULT;
   StatusCount   = INTEGER NOT NULL;
   SourcePosition = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/

   Term1Equip   = INTEGER NOT NULL WITH DEFAULT;
   Term2Equip   = INTEGER NOT NULL WITH DEFAULT;
   Term1QGis    = INTEGER NOT NULL WITH DEFAULT;
   Term2QGis    = INTEGER NOT NULL WITH DEFAULT;
   Term0Grounds  = INTEGER NOT NULL WITH DEFAULT;
   Term1Grounds  = INTEGER NOT NULL WITH DEFAULT;
   Term2Grounds  = INTEGER NOT NULL WITH DEFAULT;
   Term0Removes  = INTEGER NOT NULL WITH DEFAULT;
   Term1Removes  = INTEGER NOT NULL WITH DEFAULT;
   Term2Removes  = INTEGER NOT NULL WITH DEFAULT;
   Term1SuperType  = INTEGER NOT NULL WITH DEFAULT;
   Term2SuperType  = INTEGER NOT NULL WITH DEFAULT;
   
   
   TempQGis = INTEGER NOT NULL WITH DEFAULT;
   TempEquip = INTEGER NOT NULL WITH DEFAULT;
   TempEquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   TempPG = VARCHAR(40) NOT NULL WITH DEFAULT;
   TempSuperType = INTEGER NOT NULL WITH DEFAULT;
   TempTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   Terminal = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_AdjacentEquipment DEFAULT NULL;
   TraceResultList = ARRAY OF ConnectedEquipClass;
   TempResult = ConnectedEquipClass;
ENDDECLARE
BEGIN
   JIP_EquipName = JIP.EquipName;                              
   JIP_TypeName = JIP.EquipClassName;
   ConnectableDevice = FALSE;
            
   IF MoveText = '' THEN
      FIELD(MoveTrim).CurBias = FB_INVISIBLE;
      FIELD(MoveText).CurBias = FB_INVISIBLE;
   ENDIF;
   
   IF Action = 'placed' OR Action = 'removed' THEN
      Field(equip_prompt).TextValue = 'You have ' + Action + 
            ' a Ground on device:  ' + JIP.PrintID + '   ' +
            JIP.EquipClassName + '   ' + JIP.EquipName + '.';
   
      Field(term_prompt).TextValue = 'For Connectivity Tracing, it is ' +                   
            'important to know which side of the ' + HC_NEWLINE +
            'device the Ground has been ' + Action + '.';
   ELSEIF Action = 'placing' OR Action = 'removing' THEN
      Field(equip_prompt).TextValue = 'You will be ' + Action + 
            ' a Ground on device:  ' + JIP.PrintID + '   ' +
            JIP.EquipClassName + '   ' + JIP.EquipName + '.';
      IF Action = 'placing' THEN
         Field(term_prompt).TextValue = 'For Connectivity Tracing, it is ' +                   
            'important to know which side of the ' + HC_NEWLINE +
            'device the Ground will be placed.';
      ELSE
         Field(term_prompt).TextValue = 'For Connectivity Tracing, it is ' +                   
            'important to know which side of the ' + HC_NEWLINE +
            'device the Ground will be removed.';
      ENDIF;
   ENDIF;
   /*
   ** if a single terminal device, the ground is on the terminal
   */
   i = 0;
   SELECT :i = Terminals
   FROM   UDB_Object 
   WHERE  Object = :JIP.Equip;
          
   IF i = 1 THEN
      Terminal = 0;
      SELECT :Terminal = ToObj
      FROM   DSO_Connection
      WHERE  FromObj = :JIP.Equip;

      IF Terminal = 0 THEN
         SELECT :Terminal = FromObj
         FROM   DSO_Connection
         WHERE  ToObj = :JIP.Equip;
      ENDIF;
      
      IF Action = 'removed' OR Action = 'removing' THEN
         /* In case an data error that there is an ground on terminal = 0, return that terminal
         */
         k = 0;         
         SELECT :k = 1,
                :GroundTerminal = S.Terminal
         FROM   fms_objectstatus S
         WHERE S.object = :JIP.Equip AND
               S.status = :Status$Ground AND
               S.StatusCount > 0;
         IF k = 1 THEN
            RETURN (GroundTerminal);
         ENDIF;
      ENDIF;         
      RETURN (Terminal);
   ENDIF;

   /*
   ** Only these breaking devices can have grounds placed on their terminals. 
   ** Otherwise, grounds must be placed / removed from devices themselves (return terminal 0)
   ** If removing ground on a Source Position, check for ground only on one terminal.
   */   
   i = 0;
   SELECT :i = 1
   FROM   UDB_ExtendedType 
   WHERE  Type = :JIP.EquipClass AND
          SuperType IN (:Type$LoadBreaking, :Type$Disconnect, :Type$CktSwReac);
          
   IF i = 1 THEN 
      ConnectableDevice = TRUE; 
   ELSEIF i = 0 THEN
      IF Action = 'placed' OR Action = 'placing' THEN
         RETURN (0);
      ENDIF;   
   
      IF Action = 'removed' OR Action = 'removing' THEN
      /*
      ** find out which terminal has a ground status.
      */
         gnd_check = 0;
         Term0Grounds = 0;
         Term1Grounds = 0;
         Term2Grounds = 0;
      
         SELECT :GroundTerminal = S.Terminal,
                :StatusCount = S.StatusCount 
         FROM   fms_objectstatus S
         WHERE  S.object = :JIP.Equip AND
                S.status = :Status$Ground AND
                S.StatusCount > 0
         BEGIN
            gnd_check = gnd_check + 1;
         
            IF GroundTerminal = 0 THEN    
            /* just in case there is a ground on the equipment itself
            */
               Term0Grounds = StatusCount;
            ELSEIF GroundTerminal > 0 AND Term1Grounds = 0 THEN
               Term1Grounds = GroundTerminal;
            ELSEIF GroundTerminal > 0 AND Term2Grounds = 0 THEN
               Term2Grounds = GroundTerminal;
            ENDIF;
         END;
         /*
         ** If more than one terminal has a ground we will have to prompt, otherwise return that terminal
         */
         IF gnd_check = 1 THEN
            IF Term0Grounds > 0 THEN
               RETURN(0);
            ELSE
               RETURN(Term1Grounds);
            ENDIF;
         ENDIF;
      ENDIF; 
   ENDIF;

   /*
   ** If placing ground on a Source Position, automatically use Terminal 0.
   ** If removing ground on a Source Position, check for ground only on one terminal.
   */
   SourcePosition = 0;
   SELECT :SourcePosition = Grouping
   FROM   Udb_Grouping
   WHERE  Member = :JIP.Equip AND
          Relationship = :InterAction$SourcePosition;
   
   IF SourcePosition > 0 THEN
      IF Action = 'placed' OR Action = 'placing' THEN
         RETURN (0);
      ENDIF;   
   
      IF Action = 'removed' OR Action = 'removing' THEN
      /*
      ** find out which terminal has a ground status.
      */
         gnd_check = 0;
         Term0Grounds = 0;
         Term1Grounds = 0;
         Term2Grounds = 0;
      
         SELECT :GroundTerminal = S.Terminal,
                :StatusCount = S.StatusCount 
         FROM   fms_objectstatus S
         WHERE  S.object = :JIP.Equip AND
                S.status = :Status$Ground AND
                S.StatusCount > 0
         BEGIN
            gnd_check = gnd_check + 1;
         
            IF GroundTerminal = 0 THEN    
            /* just in case there is a ground on the equipment itself
            */
               Term0Grounds = StatusCount;
            ELSEIF GroundTerminal > 0 AND Term1Grounds = 0 THEN
               Term1Grounds = GroundTerminal;
            ELSEIF GroundTerminal > 0 AND Term2Grounds = 0 THEN
               Term2Grounds = GroundTerminal;
            ENDIF;
         END;
         /*
         ** If more than one terminal has a ground we will have to prompt, otherwise return that terminal
         */
         IF gnd_check = 1 THEN
            IF Term0Grounds > 0 THEN
               RETURN(0);
            ELSE
               RETURN(Term1Grounds);
            ENDIF;
         ENDIF;
      ENDIF; 
   ENDIF;
   /*
   ** Look for negative ground count when placing a ground, then
   ** place on that same terminal.
   */
   IF Action = 'placed' OR Action = 'placing' THEN
      SELECT :Terminal = S.Terminal
      FROM   fms_objectstatus S
      WHERE S.object = :JIP.Equip AND
            S.status = :Status$Ground AND
            S.StatusCount < 0;
      IF iirowcount > 0 THEN
         RETURN (Terminal);
      ENDIF;
   ENDIF;
/*
** Look at connectivity for each Terminal.
*/
   Trace = Trace_AdjacentEquipment.Create();
   RetCode = Trace.FindAdjacentEquipment(JobEquip = JIP.Equip);
   IF RetCode = TraceStatus$Isolated THEN
      RETURN (0);
   ENDIF;

   /*
   ** Display the adjacent equipment at relative positions based on their positions on the QGis diagram. 
   ** Because we are not able to access the class definitions in Qgis_Trace_Engine component
   ** we are using the local ConnectedEquipClass class to store connectivity information.
   */
   FOR i = 1 TO Trace.PathResultList.LastRow DO
      TraceResultList[i] = ConnectedEquipClass.Create();
            
      TraceResultList[i].PrevObject = Trace.PathResultList[i].FirstEquip.Object;    // terminal value for ground
      TraceResultList[i].Status = Trace.PathResultList[i].Status;

      k = Trace.PathResultList[i].TargetEquipList.LastRow;
      IF k = 0 THEN // this path is floating.
         TraceResultList[i].Object = 0;
         TraceResultList[i].PositionY = 0;
      ELSE
         TraceResultList[i].Object = Trace.PathResultList[i].TargetEquipList[k].Object;      // equip shown as connected
         TraceResultList[i].PositionY = Trace.PathResultList[i].TargetEquipList[k].Pos_Y;
      ENDIF;
   ENDFOR;
   
   IF Trace.PathResultList.LastRow = 2 THEN      
      IF TraceResultList[1].PositionY < TraceResultList[2].PositionY THEN
         TempResult = TraceResultList[1].Duplicate();
         TraceResultList[1] = TraceResultList[2].Duplicate();
         TraceResultList[2] = TempResult;
      ENDIF;
   ENDIF;
      
   FOR i = 1 TO TraceResultList.LastRow DO
      TempQGis = TraceResultList[i].PrevObject;
      TempEquip = TraceResultList[i].Object;

      IF TempEquip > 0 THEN
         TempPG = '';
         TempEquipName = '';                              
         TempTypeName = '';
         TempSuperType = 0;
         REPEATED
         SELECT :TempEquipName = O.name,
                :TempTypeName = O.typename,
                :TempPG = O.primarygroupingname,
                :TempSuperType = ST.SuperType      // for 33kv
         FROM  UDB_Object O,
               Udb_SuperType ST
         WHERE O.object = :TempEquip AND
               O.Type = ST.Type;
                        
         IF i = 1 THEN
            Term1QGis = TempQGis;
            Term1Equip = TempEquip;
            Term1SuperType = TempSuperType;     
            
            term1_PG = TempPG;
            Term1_EquipName = TempEquipName;                              
            term1_TypeName = TempTypeName;
            
         ELSEIF i = 2 THEN               
            Term2QGis = TempQGis;
            Term2Equip = TempEquip;
            Term2SuperType = TempSuperType;

            term2_PG = TempPG;
            Term2_EquipName = TempEquipName;                              
            term2_TypeName = TempTypeName;
         ENDIF;
      ELSE     // Floating 
         IF i = 1 THEN
            Term1_EquipName = 'Floating';                              
            field(term1_Selected).SetAttribute(CurBias=FB_DIMMED);
            field(Line1).LineColor = CC_PALE_GRAY;
         ELSEIF i = 2 THEN               
            Term2_EquipName = 'Floating'; 
            field(term2_Selected).SetAttribute(CurBias=FB_DIMMED);
            field(Line2).LineColor = CC_PALE_GRAY;
         ENDIF;
      ENDIF;
   ENDFOR;

   IF TraceResultList.LastRow = 1 AND ConnectableDevice = TRUE THEN
      /* if connected only on one side, the ground will be always on the terminal side.
      */
      RETURN (Term1QGis);
   ENDIF;
   
   /* 33kV Check */
   IF Term1SuperType = Type$33kVPortion OR 
      Term2SuperType = Type$33kVPortion THEN
      Message 'Ground should not be placed on 33kV feeder interrupter switches. ' +
            'Abort this move and reassign ground to the proper equipment.';
      ForceAbort33kV = TRUE;
      RETURN(0);
   ENDIF;
   
   IF Action = 'removed' OR Action = 'removing' THEN
      /*
      ** find out which terminal has a ground status.
      */
      gnd_check = 0;
      Term0Grounds = 0;
      Term1Grounds = 0;
      Term2Grounds = 0;
      
      SELECT :GroundTerminal = S.Terminal,
             :StatusCount = S.StatusCount 
      FROM   fms_objectstatus S
      WHERE S.object = :JIP.Equip AND
            S.status = :Status$Ground AND
            S.StatusCount > 0
      BEGIN
         gnd_check = gnd_check + 1;
         
         IF GroundTerminal = 0 THEN    
            /* just in case there is a ground on the equipment itself
            */
            Term0Grounds = StatusCount;
         ELSEIF GroundTerminal = Term1QGis THEN
            Term1Grounds = StatusCount;
         ELSEIF GroundTerminal = Term2QGis THEN
            Term2Grounds = StatusCount;
         ELSE
            /* this is rare case where the QGis diagram is modified 
            ** after a ground was placed on a terminal. Remove this ground
            */
            RETURN GroundTerminal;
         ENDIF;
      END;
            
      IF Term1Grounds = 0 THEN
         field(term1_Selected).SetAttribute(CurBias=FB_DIMMED);
         field(term1_PG).SetAttribute(CurBias=FB_DIMMED);
         field(Term1_EquipName).SetAttribute(CurBias=FB_DIMMED);
         field(term1_TypeName).SetAttribute(CurBias=FB_DIMMED);
      ENDIF;

      IF Term2Grounds = 0 THEN
         field(term2_Selected).SetAttribute(CurBias=FB_DIMMED);
         field(term2_PG).SetAttribute(CurBias=FB_DIMMED);
         field(Term2_EquipName).SetAttribute(CurBias=FB_DIMMED);
         field(term2_TypeName).SetAttribute(CurBias=FB_DIMMED);
      ENDIF;
      /* 
      ** if only one terminal is grounded, return that one.
      */
      IF gnd_check = 1 THEN
         RETURN (GroundTerminal);
      ENDIF;

      IF gnd_check = 0 THEN
         /*
         ** if no terminals are grounded, check if a ground is to be placed. Sometimes,
         ** the DO issues the takeout and restore move at the same time. We will look
         ** at SOA_GroungTerminal table to see if the DO has selected a terminal to place
         ** a ground.
         */
          Terminal = -99;
          SELECT :Terminal = Terminal
          FROM   SOA_GroundTerminal
          WHERE  Equip = :JIP.Equip AND
                 Action = 1;
 
         IF Terminal <> -99 THEN
            RETURN (Terminal);
         ELSE
            /*
            ** if no terminals are/to be grounded, return 0 and let ground count go negative.
            */
            RETURN (0);
         ENDIF;
      ENDIF;
   
      /*
      ** Now there are two grounds.
      ** when the move is about to remove a ground(at the moment of issuing a move), 
      ** check if another move has requested to do the same on a terminal. if so, 
      ** that terminal is dimmed out so that DO can't select that terminal again.
      */
      IF Action = 'removing' THEN
         /* check SOA_GroundTerminal table to see if other moves has requested to remove 
         ** the ground on terminal.
         */
         /* just in case there is a ground on the equipment itself
         */
         Term0Removes = 0;
         SELECT :Term0Removes = COUNT(*)
         FROM   SOA_GroundTerminal 
         WHERE  Equip = :JIP.Equip AND
                Terminal = 0 AND
                Action = -1;          /* removing */
         /*   
         IF Term0Grounds <= Term0Removes THEN
            field(equip_Selected).SetAttribute(CurBias=FB_DIMMED);
         ENDIF;
         */
         
         Term1Removes = 0;
         IF Term1QGis > 0 THEN
            SELECT :Term1Removes = COUNT(*)
            FROM   SOA_GroundTerminal 
            WHERE  Equip = :JIP.Equip AND
                   Terminal = :Term1QGis AND
                   Action = -1;          /* removing */
         ENDIF;
         IF Term1Grounds <= Term1Removes THEN
            field(term1_Selected).SetAttribute(CurBias=FB_DIMMED);
            field(term1_PG).SetAttribute(CurBias=FB_DIMMED);
            field(Term1_EquipName).SetAttribute(CurBias=FB_DIMMED);
            field(term1_TypeName).SetAttribute(CurBias=FB_DIMMED);
         ENDIF;
      
         Term2Removes = 0;
         IF Term2QGis > 0 THEN
            SELECT :Term2Removes = COUNT(*)
            FROM   SOA_GroundTerminal 
            WHERE  Equip = :JIP.Equip AND
                   Terminal = :Term2QGis AND
                   Action = -1;          /* removing */
         ENDIF;
         IF Term2Grounds <= Term2Removes THEN
            field(term2_Selected).SetAttribute(CurBias=FB_DIMMED);
            field(term2_PG).SetAttribute(CurBias=FB_DIMMED);
            field(Term2_EquipName).SetAttribute(CurBias=FB_DIMMED);
            field(term2_TypeName).SetAttribute(CurBias=FB_DIMMED);
         ENDIF;
         /*
         ** if only ground left to be removed, we can return that terminal.
         */   
         IF Term0Grounds > Term0Removes  AND 
            Term1Grounds <= Term1Removes  AND 
            Term2Grounds <= Term2Removes THEN
            RETURN 0;
         ELSEIF Term1Grounds > Term1Removes  AND 
            Term2Grounds <= Term2Removes THEN
            RETURN Term1QGis;
         ELSEIF Term1Grounds <= Term1Removes  AND 
            Term2Grounds > Term2Removes THEN
            RETURN Term2QGis; 
         ENDIF;
      ENDIF;
   ENDIF; /* Action = 'removed' or removing */
/*
** Default to terminal=0 for automatic execution 
*/
   IF AutomaticExecution = TRUE THEN
      RETURN(0);
   ENDIF;
END;

ON Click ok_btn =
BEGIN
   IF term1_Selected = TRUE THEN
      RETURN(Term1QGis);
   ELSEIF term2_Selected = TRUE THEN
