**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          Restrictions
**
**  Modifications:
**	10/03/94      pw        Frame Created.
**      03/24/00      em        disable edit capabilities for Division Role
**      06/05/00      em        enable edit capabilities for Division Role, but
**                              not manager
**      03/20/08      pkw       Convert to Tab display and add network restrictions.
**      04/01/08      pkw       Remove tree field and replace with table field since
**                              there will only be one network restriction at any time.
**      04/30/08      pkw       Make tab.net.log tablefield Landable always.
**      08/17/10      em        Change Feeder Parm to Card to support 3G
**      01/02/12      ysp       Add Lifted By Region column
**      06/18/12      em        Only allow the Lifted by Region column to be set for the card feeder.
**      03/09/15      pkw       Set TimeSeq when loading restrictions
**      04/21/15      em        Can't see reason why FeederRestriction table is accessed twice when
**                              loading engineering restrictions.  Have commented out one of them.
**                              Moving Restriction components to CAC so that Restrictions screen can
**                              be called from new Prompt with Display Only option. 
**                              Add DisplayFeederOnly parameter. 
**      05/05/15      pkw       Add extra call to feederrestriction back so that all restricted feeders
**                              show up when looking at resrtriction instead of just the current feeder.
**                              Also add Lifted Region update to main restrictions screen so email
**                              will not be sent when updating this information.
**      10/20/15      em        Adjustments for read mode.
*/
INITIALIZE (
   Card = INTEGER NOT NULL WITH DEFAULT;
   ViewOnlyFLG = INTEGER NOT NULL WITH DEFAULT;
   DisplayFeederOnly = INTEGER NOT NULL WITH DEFAULT;   /* Optional, To be used with ViewOnlyFLG=TRUE */
   FeederList = ARRAY OF ObjectSummaryClass;  /* List of available feeders */
   CurrentFeederName = VARCHAR(40) NOT NULL;
   LocalDivisions = ARRAY OF ObjectSummaryClass;  /* List of Local divisions */
/*
** End of Calling Parms
*/
   i = integer not null;
   j = integer not null;
   k = integer not null;
   MenuEntry = ChoiceItem;
   Division = integer not null;
   RetCode = integer not null;
   NewFeeder = integer not null;
   TempChar = VARCHAR(40) NOT NULL;
   FeederSequence = INTEGER NOT NULL WITH DEFAULT;
   TimeSequence = INTEGER NOT NULL WITH DEFAULT;
   OldFeeder = INTEGER NOT NULL WITH DEFAULT;
   OldRestriction = INTEGER NOT NULL WITH DEFAULT;
   TempRestriction = RestrictionClass;
   TR = ARRAY OF RestrictionClass;
   ChosenFeeder = ObjectSummaryClass;  
   ChosenEquip = FMS_Equip; 
   CurTypeObj    = ObjectSummaryClass;
   NetObj       = ARRAY OF ObjectSummaryClass;
   NetRow       = INTEGER NOT NULL WITH DEFAULT;
   SelectedType = INTEGER NOT NULL WITH DEFAULT;
   SelectedObject = INTEGER NOT NULL WITH DEFAULT;
   StatusList = ARRAY OF ObjectSummaryClass;
   LastIndex = INTEGER NOT NULL WITH DEFAULT;
   Status = ARRAY OF INTEGEROBJECT;
   CurRow = INTEGER NOT NULL WITH DEFAULT;
   CardFeeders = ARRAY OF INTEGEROBJECT;
) =
DECLARE
   LoadHistory = PROCEDURE;
   LoadNetworkFeeders = PROCEDURE;
ENDDECLARE
BEGIN
   IF ViewOnlyFLG = TRUE THEN
      Field(Menu.Division).CurBias = MB_Invisible; 
   ELSE
      Field(menu.division.Id).ValueList.ChoiceItems[1].EnumValue = 1;
      Field(menu.division.Id).ValueList.ChoiceItems[1].EnumText = 'All Divisions';
      i = 2;
      SELECT :MenuEntry.EnumText = Name,
             :MenuEntry.EnumValue = Object
      FROM   Udb_Object
      WHERE  Type = :Type$Division AND
             PrimaryGrouping <> 0
      BEGIN
         Field(menu.division.Id).ValueList.ChoiceItems[i].EnumValue = 
            MenuEntry.EnumValue;
         Field(menu.division.Id).ValueList.ChoiceItems[i].EnumText = 
            MenuEntry.EnumText;
         i = i + 1;
      END;

      Field(menu.division.Id).CurEnumText = 'All Divisions';
      Field(menu.division.Id).CurEnumValue = 1;
      Field(menu.division.Id).UpdChoiceList();
      Field(Menu.Division).CurBias = MB_ENABLED; 
   ENDIF;

   /*
   **  Find all network restriction statuses.
   */
   i = 1;
   Status.Clear();
   SELECT :Status[i].Value = S.Object
   FROM FMS_ObjectStatus S
   WHERE S.Status = :Type$Spear
   BEGIN 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   /*
   **  Build array for Network.
   */ 
   IF ViewOnlyFLG = TRUE THEN /* Only show Local Divisions */
/*
** Not sure how LocalDivisions and TempChar is used, but the field is
** not passed in when called from PromptViewFeederRestrictions
*/
      IF LocalDivisions.LastRow() > 0 THEN

         TempChar = LocalDivisions[1].Name;
         FOR i = 2 TO LocalDivisions.LastRow DO
            TempChar = TempChar + '/ ' + LocalDivisions[i].Name;
         ENDFOR;
      ENDIF;

      tab.net.tf.Clear();
      i = 1;
      SELECT DISTINCT 
          :tab.net.tf[i].Object = O.Object,
          :tab.net.tf[i].Name = O.Description,
          :tab.net.tf[i].Type = O.Type
      FROM Udb_Object O,
           Udb_Grouping G1,
           Udb_Grouping G2
      WHERE G1.Grouping = :UserDesk AND
            G1.Relationship = :Interaction$MemberOf AND
            G1.MemberType = :Type$Division AND
            G1.Member = G2.Grouping AND
            G2.Relationship = :Interaction$MemberOf AND
            G2.MemberType = :Type$Network AND
            G2.Member = O.Object
      ORDER BY Name
      BEGIN
         i = i + 1;
      END;
      CALLPROC LoadNetworkfeeders;
   ELSE
      CurFrame.SendUserEvent (EventName = 'Load Networks');      
   ENDIF;
   
   FOR i = 1 TO Status.LastRow DO
      FOR j = 1 to tab.net.tf.LastRow DO
         IF tab.net.tf[j].Object = Status[i].Value THEN
            FIELD(tab.net.tf[j].Name).BGColor = CC_PALE_RED;
            ENDLOOP;
         ENDIF; 
      ENDFOR;   
   ENDFOR;

   CurFrame.SendUserEvent (EventName = 'Load Restrictions');

   IF UserRole = Role$Manager THEN
      FIELD(tab.fdr.InsertRestriction_btn).CurBias = FB_DIMMED;
      FIELD(tab.fdr.UpdateRestriction_btn).CurBias = FB_DIMMED;
      FIELD(tab.fdr.DeleteRestriction_btn).CurBias = FB_DIMMED;
   ENDIF;
   IF DisplayFeederOnly = TRUE THEN
      FIELD(tab.fdr.UpdateRestriction_btn).CurBias = FB_INVISIBLE;
      FIELD(tab.net.Insert_Btn).CurBias = FB_INVISIBLE;
      FIELD(tab.net.Delete_Btn).CurBias = FB_INVISIBLE;
   ENDIF;
   CurFrame.WindowVisibility = WV_INVISIBLE;
END;

ON CHILDENTRY tab.fdr.Restriction[*].RestrictionNumber,
ON CHILDENTRY tab.fdr.Restriction[*].DefectiveFeederName,
ON CHILDENTRY tab.fdr.Restriction[*].DefectiveEquipName,
ON CHILDENTRY tab.fdr.Restriction[*].DefectiveNetworkName,
ON CHILDENTRY tab.fdr.Restriction[*].DefectiveEquipLocation,
ON CHILDENTRY tab.fdr.Restriction[*].Reason =
BEGIN
   IF ViewOnlyFLG = TRUE THEN
      Field(tab.fdr.UpdateRestriction_btn).CurBias = FB_LANDABLE;
   ENDIF;
END;

ON CHILDSETVALUE tab.fdr.Restriction[*].Feeder =
DECLARE
   LiftedFeeder = INTEGER NOT NULL WITH DEFAULT;
   WITBL = TableField;
   RSeq = INTEGER NOT NULL WITH DEFAULT;
   FSeq = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF lowercase(CurFrame.TriggerField.Name) <> 'lifted' THEN
      RESUME;
   ENDIF;

   IF ViewOnlyFLG = TRUE THEN
      Field(tab.fdr.UpdateRestriction_btn).CurBias = FB_DIMMED;
   ENDIF;
   
   RSeq = FIELD(tab.fdr.Restriction).CurRow;
   WITBL = curframe.TriggerField.whichtablefield();
   FSeq = WITBL.WhichRow (cellfield = CurFrame.TriggerField);
   
   IF Card = 0 THEN
      MESSAGE 'Card must be loaded in order to update ''Lifted By Region'' flag.';
      IF tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = TRUE THEN
         tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = FALSE;
      ELSE
         tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = FALSE;
      ENDIF;
      RESUME;
   ENDIF;
    
   IF CardFeeders.LastRow() = 0 THEN
      i = 1;
      SELECT :CardFeeders[i].Value = Object
      FROM   TFMS_CardToObject
      WHERE  Card = :Card
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   
   LiftedFeeder = tab.fdr.Restriction[RSeq].Feeder[FSeq].Feeder;
   i = 1;
   WHILE i <= CardFeeders.LastRow() DO
      IF LiftedFeeder = CardFeeders[i].Value THEN
         ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   IF i > CardFeeders.LastRow() THEN
      MESSAGE 'You may only lift feeders associated with currently loaded card.';
      IF tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = TRUE THEN
         tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = FALSE;
      ELSE
         tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted = TRUE;
      ENDIF;
      RESUME;
   ENDIF;


   RetCode = CALLPROC FMS_FeederRestrictionUpd(
                                RestrictionID = tab.fdr.Restriction[RSeq].RestrictionID,
                                FeederSeq = tab.fdr.Restriction[RSeq].Feeder[FSeq].FeederSeq,
                                Lifted = tab.fdr.Restriction[RSeq].Feeder[FSeq].Lifted);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to save Lifted By Region flag,  please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

END;

ON CLICK tab.net.Insert_Btn =
BEGIN
   RetCode = CALLPROC FMS_ObjStatIns(
                 Object = tab.net.tf[CurRow].Object,
                 Status = Type$Spear,
                 Terminal = 0,
                 StatusCount = 1,
                 TimeSet = date('now'));
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
        'Error applying Network Restriction.  Please try again.  ' +
        'If further attempts fail, Tech Support should be ' +
        'contacted to review your machine trace log',
       TraceMessage =
        'FRAME:Restrictions; ' +
        'Error applying Network Restriction to fms_objectstatus. ' +
        'Object=' + VARCHAR(CurTypeObj.Object) +
        ';Status=' + VARCHAR(CurTypeObj.Type) + '.'
      );
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   CALLPROC SOA_LogIns (
            Card = Type$Network,
            Job  = NULL,
            SwitchingItem = tab.net.tf[CurRow].Object,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Network Restriction',
            Old  = '',
            New  = 'Set');
   CALLPROC DDB_COMMIT;
   
   
   CALLPROC LoadHistory;
      
   FIELD(tab.net.tf[CurRow].Name).BGColor = CC_PALE_RED;
     
   FIELD(tab.net.Insert_Btn).CurBias = FB_DIMMED;
END;

ON CLICK tab.net.Delete_Btn =
BEGIN
   RetCode = CALLPROC FMS_ObjStatDel(Object = tab.net.tf[CurRow].Object,
                                     Terminal = 0, 
                                     Status = Type$Spear);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
          'Error removing a Network Restriction.  If problem continues, Tech Support should be ' +
               'contacted to review your machine trace log',
       TraceMessage =
          'Frame:Restrictions; ' +
               'Error removing a network restriction from fms_objectstatus. ' +
               'Object=' + VARCHAR(CurTypeObj.Object) +
               ';Status=' + VARCHAR(CurTypeObj.Type) + '.'
               );
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   CALLPROC SOA_LogIns (
            Card = Type$Network,
            Job  = NULL,
            SwitchingItem = tab.net.tf[CurRow].Object,
            Time = DATE('Now'), 
            UserName = UserName,
            Item = 'Network Restriction',
            Old  = '',
            New  = 'Clear');
   CALLPROC DDB_COMMIT;
   
   CALLPROC LoadHistory;

   FIELD(tab.net.tf[CurRow].Name).BGColor = CC_PALE_CYAN;

   FIELD(tab.net.Delete_Btn).CurBias = FB_DIMMED;
END;

ON ChildEntry tab.net.tf =
BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;  

   CurRow = FIELD(tab.net.tf).CurRow;

   IF DisplayFeederOnly = FALSE THEN  
      IF FIELD(tab.net.tf[CurRow].Name).BGColor = CC_PALE_RED THEN
         FIELD(tab.net.Insert_btn).CurBias = FB_DIMMED;
         FIELD(tab.net.Delete_btn).CurBias = FB_LANDABLE;   
      ELSE
         FIELD(tab.net.Insert_btn).CurBias = FB_LANDABLE;
         FIELD(tab.net.Delete_btn).CurBias = FB_DIMMED;
      ENDIF; 
   ENDIF; 
   CALLPROC LoadHistory;
END;

ON UserEvent 'Load Restrictions' = 
BEGIN
   IF ViewOnlyFLG = TRUE THEN
      Field(tab.fdr.Restriction_Title).TextValue = 'Engineering Restrictions for feeder: ' +
                                            CurrentFeederName;
      /* 
         Don't show division menu because you only see restrictions 
         for this feeder when restriction button on card is pressed
      */ 
      Field(Menu.Division).CurBias = MB_Invisible; 
      Field(tab.fdr.InsertRestriction_btn).CurBias = FB_Invisible;
      Field(tab.fdr.DeleteRestriction_btn).CurBias = FB_Invisible;
      Field(tab.fdr.UpdateRestriction_btn).CurBias = FB_DIMMED;

      OldRestriction = 0;
      OldFeeder = 0;
      i = 0;
      j = 1;
      k = 1;
      REPEATED
      SELECT   :TempRestriction.RestrictionId = R.RestrictionId,
               :TempRestriction.RestrictionNumber = R.RestrictionNumber,
               :TempRestriction.DefectiveFeeder = R.DefectiveFeeder,
               :TempRestriction.time[1].StartDay = TR.StartDay,
               :TempRestriction.time[1].EndDay = TR.EndDay,
               :TempRestriction.time[1].StartTime = TR.StartTime,
               :TempRestriction.time[1].EndTime = TR.EndTime,
               :TempRestriction.time[1].TimeSeq = TR.TimeSeq,
               :TempRestriction.DefectiveFeederName = R.DefectiveFeederName,          
               :TempRestriction.DefectiveEquip = R.DefectiveEquip,          
               :TempRestriction.DefectiveEquipName = R.DefectiveEquipName,          
               :TempRestriction.DefectiveNetworkName = R.DefectiveNetworkName,          
               :TempRestriction.DefectiveEquipLocation = R.DefectiveEquipLocation,          
               :TempRestriction.Feeder[1].Feeder = FR.Feeder,
               :TempRestriction.Feeder[1].FeederName = FR.FeederName,
               :TempRestriction.Feeder[1].FeederSeq = FR.FeederSeq,
               :TempRestriction.Feeder[1].Lifted = FR.Lifted,
               :TempRestriction.ExpirationDate = R.ExpirationDate,
               :TempRestriction.Reason = R.Reason,          
               :TempRestriction.Division = R.Division          
      FROM     FMS_Restriction R,
               FMS_TimeRestriction TR,
               FMS_FeederRestriction FR1,
               FMS_FeederRestriction FR,
               TFMS_CardToObject CTO
      WHERE    CTO.Card = :Card AND
               CTO.Object = FR1.Feeder AND
               FR1.RestrictionID = FR.RestrictionID AND
               FR1.RestrictionID = R.RestrictionId AND
               FR1.RestrictionID = TR.RestrictionID 
               
      ORDER BY RestrictionNumber,FeederSeq,TimeSeq
      BEGIN
         IF TempRestriction.RestrictionId <> OldRestriction THEN
            j = 1;
            k = 1;
            i = i + 1;
   
            OldFeeder = TempRestriction.Feeder[1].Feeder;
            FeederSequence = TempRestriction.Feeder[1].FeederSeq;
            TimeSequence = TempRestriction.Time[1].TimeSeq;
            OldRestriction = TempRestriction.RestrictionId;
   
            tab.fdr.Restriction[i] = TempRestriction.Duplicate();
            j = j + 1;
            k = k + 1;
         ELSE
            IF TempRestriction.Feeder[1].FeederSeq > FeederSequence THEN
               FeederSequence = TempRestriction.Feeder[1].FeederSeq;
               tab.fdr.Restriction[i].Feeder[k].Feeder     = TempRestriction.Feeder[1].Feeder;
               tab.fdr.Restriction[i].Feeder[k].FeederName = TempRestriction.Feeder[1].FeederName;
               tab.fdr.Restriction[i].Feeder[k].FeederSeq  = TempRestriction.Feeder[1].FeederSeq;
               tab.fdr.Restriction[i].Feeder[k].Lifted  = TempRestriction.Feeder[1].Lifted;
               k = k + 1;
            ENDIF;
   
            IF TempRestriction.Time[1].TimeSeq > TimeSequence THEN
               TimeSequence = TempRestriction.Time[1].TimeSeq;
               tab.fdr.Restriction[i].Time[j].StartDay  = TempRestriction.Time[1].StartDay;
               tab.fdr.Restriction[i].Time[j].EndDay    = TempRestriction.Time[1].EndDay;
               tab.fdr.Restriction[i].Time[j].StartTime = TempRestriction.Time[1].StartTime;
               tab.fdr.Restriction[i].Time[j].Endtime   = TempRestriction.Time[1].EndTime;
               tab.fdr.Restriction[i].Time[j].TimeSeq   = TempRestriction.Time[1].TimeSeq;
               j = j + 1;
            ENDIF;
         ENDIF;
      END;

   ELSE
      IF lowercase(FIELD(Tab).CurTabPage.Name) = 'fdr' THEN
         Field(Menu.Division).CurBias = MB_ENABLED; 
      ENDIF;

      Field(tab.fdr.Restriction_Title).TextValue = 'Engineering Restrictions for ' +
                                           'feeders in All Divisions';
      OldRestriction = 0;
      OldFeeder = 0;
      i = 0;
      j = 1;
      k = 1;
      REPEATED
      SELECT   :TempRestriction.RestrictionId = R.RestrictionId,
               :TempRestriction.RestrictionNumber = R.RestrictionNumber,
               :TempRestriction.DefectiveFeeder = R.DefectiveFeeder,
               :TempRestriction.time[1].StartDay = TR.StartDay,
               :TempRestriction.time[1].EndDay = TR.EndDay,
               :TempRestriction.time[1].StartTime = TR.StartTime,
               :TempRestriction.time[1].EndTime = TR.EndTime,
               :TempRestriction.time[1].TimeSeq = TR.TimeSeq,
               :TempRestriction.DefectiveFeederName = R.DefectiveFeederName,          
               :TempRestriction.DefectiveEquip = R.DefectiveEquip,          
               :TempRestriction.DefectiveEquipName = R.DefectiveEquipName,          
               :TempRestriction.DefectiveNetworkName = R.DefectiveNetworkName,          
               :TempRestriction.DefectiveEquipLocation = R.DefectiveEquipLocation,          
               :TempRestriction.Feeder[1].Feeder = FR.Feeder,
               :TempRestriction.Feeder[1].FeederName = FR.FeederName,
               :TempRestriction.Feeder[1].FeederSeq = FR.FeederSeq,
               :TempRestriction.Feeder[1].Lifted = FR.Lifted,
               :TempRestriction.ExpirationDate = R.ExpirationDate,
               :TempRestriction.Reason = R.Reason,          
               :TempRestriction.Division = R.Division          
      FROM     FMS_Restriction R,
               FMS_TimeRestriction TR,
               FMS_FeederRestriction FR
      WHERE    R.RestrictionId = TR.RestrictionID AND
               R.RestrictionId = FR.RestrictionID
      ORDER BY RestrictionNumber,FeederSeq,TimeSeq
      BEGIN
         IF TempRestriction.RestrictionId <> OldRestriction THEN
            j = 1;
            k = 1;
            i = i + 1;
   
            OldFeeder = TempRestriction.Feeder[1].Feeder;
            FeederSequence = TempRestriction.Feeder[1].FeederSeq;
            TimeSequence = TempRestriction.Time[1].TimeSeq;
            OldRestriction = TempRestriction.RestrictionId;
   
            tab.fdr.Restriction[i] = TempRestriction.Duplicate();
            j = j + 1;
            k = k + 1;
         ELSE
            IF TempRestriction.Feeder[1].FeederSeq > FeederSequence THEN
               FeederSequence = TempRestriction.Feeder[1].FeederSeq;
               tab.fdr.Restriction[i].Feeder[k].Feeder     = TempRestriction.Feeder[1].Feeder;
               tab.fdr.Restriction[i].Feeder[k].FeederName = TempRestriction.Feeder[1].FeederName;
               tab.fdr.Restriction[i].Feeder[k].FeederSeq  = TempRestriction.Feeder[1].FeederSeq;
               tab.fdr.Restriction[i].Feeder[k].Lifted  = TempRestriction.Feeder[1].Lifted;
               k = k + 1;
            ENDIF;
   
            IF TempRestriction.Time[1].TimeSeq > TimeSequence THEN
               TimeSequence = TempRestriction.Time[1].TimeSeq;
               tab.fdr.Restriction[i].Time[j].StartDay  = TempRestriction.Time[1].StartDay;
               tab.fdr.Restriction[i].Time[j].EndDay    = TempRestriction.Time[1].EndDay;
               tab.fdr.Restriction[i].Time[j].StartTime = TempRestriction.Time[1].StartTime;
               tab.fdr.Restriction[i].Time[j].Endtime   = TempRestriction.Time[1].EndTime;
               j = j + 1;
            ENDIF;
         ENDIF;
   
      END;
   ENDIF;

   IF tab.fdr.Restriction.LastRow() > 0 THEN
      Field(tab.fdr.Restriction).ActiveRow = 1; 
      IF DisplayFeederOnly = TRUE THEN
         FIELD(tab).CurPageIndex = 2;
      ENDIF;
   ELSEIF DisplayFeederOnly = TRUE THEN
      RETURN;
   ENDIF;
   CurFrame.WindowVisibility = WV_VISIBLE;
END;

ON Click Exit_Btn = 
BEGIN
   RETURN;
END;

ON Click tab.fdr.InsertRestriction_Btn = 
BEGIN
   i = tab.fdr.Restriction.LastRow() + 1;
   tab.fdr.Restriction.InsertRow(rownumber = i);
   CALLFRAME RestrictionsWorkArea(FeederList = FeederList,
                                  InsertRestrictionFLG = TRUE,
                                  WARestriction = ByRef(tab.fdr.Restriction[i]),
                                  Card = Card);
   IF tab.fdr.Restriction[i].RestrictionID = 0 THEN
      tab.fdr.Restriction.RemoveRow(rownumber = i);
   ENDIF;
END;

ON Click tab.fdr.UpdateRestriction_Btn = 
BEGIN
   i = Field(tab.fdr.Restriction).CurRow;
   IF i = 0 THEN
      message 'Please select a restriction.';
      RESUME;
   ENDIF;

   CALLFRAME RestrictionsWorkArea(FeederList = FeederList,
                                  UpdateRestrictionFLG = TRUE,
                                  UpdateRestriction = tab.fdr.Restriction[i],
                                  Card = Card);
END;

ON Click tab.fdr.DeleteRestriction_Btn = 
BEGIN
   i = Field(tab.fdr.Restriction).CurRow;
   IF i = 0 THEN
      message 'Please select a restriction.';
      RESUME;
   ENDIF;

   IF CurFrame.ConfirmPopup(messagetext = 'Restriction ' + 
                        tab.fdr.Restriction[i].RestrictionNumber +
                        ' will be deleted.') = PU_OK THEN
      RetCode = CALLPROC FMS_RestrictionDel(RestrictionID = tab.fdr.Restriction[i].RestrictionID);
   
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove restriction,  please try again.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;
      tab.fdr.Restriction.RemoveRow(rownumber = i);
   ELSE
      RESUME;
   ENDIF;
END;

ON UserEvent 'Load Networks',
ON SetValue Menu.Division.id =
BEGIN        
  IF lowercase(FIELD(Tab).CurTabPage.Name) = 'net' THEN
      /*
      **  Find all network restriction statuses.
      */
      i = 1;
      Status.Clear();
      SELECT :Status[i].Value = S.Object
      FROM FMS_ObjectStatus S
      WHERE S.Status = :Type$Spear
      BEGIN 
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      FIELD(tab.net.tf).Title = 'Networks in ' + Menu.Division.id;

      IF :Menu.Division.id = 'All Divisions' THEN
         tab.net.tf.Clear();
         i = 1;
         SELECT DISTINCT 
             :tab.net.tf[i].Object = O.Object,
             :tab.net.tf[i].Name = O.Description,
             :tab.net.tf[i].Type = O.Type
         FROM Udb_Object O,
              Udb_Object O1,
              Udb_Grouping G1
         WHERE O1.Type = :Type$Division AND
               O1.PrimaryGrouping <> 0 AND
               O1.Object = G1.Grouping AND
               G1.Relationship = :Interaction$MemberOf AND
               G1.MemberType = :Type$Network AND
               G1.Member = O.Object
         ORDER BY Name
         BEGIN
            i = i + 1;
         END;
      ELSE
         Division = Field(Menu.Division.ID).CurEnumValue;
         tab.net.tf.Clear();
         i = 1;
         SELECT DISTINCT 
             :tab.net.tf[i].Object = O.Object,
             :tab.net.tf[i].Name = O.Description,
             :tab.net.tf[i].Type = O.Type
         FROM Udb_Object O,
              Udb_Grouping G1
         WHERE G1.Grouping = :Division AND
               G1.Relationship = :Interaction$MemberOf AND
               G1.MemberType = :Type$Network AND
               G1.Member = O.Object
         ORDER BY Name
         BEGIN
            i = i + 1;
         END;
      ENDIF;
      FOR i = 1 TO Status.LastRow DO
         FOR j = 1 to tab.net.tf.LastRow DO
            IF tab.net.tf[j].Object = Status[i].Value THEN
               FIELD(tab.net.tf[j].Name).BGColor = CC_PALE_RED;
               ENDLOOP;
            ENDIF; 
         ENDFOR;   
      ENDFOR;
      CALLPROC LoadNetworkFeeders;
  ELSE

    IF :Menu.Division.id = 'All Divisions' THEN

       CurFrame.SendUserEvent (EventName = 'Load Restrictions');

    ELSE

       Field(tab.fdr.Restriction_Title).TextValue = 'Engineering Restrictions for feeders in ' +
                                            Menu.Division.ID + ' Division';

       Division = Field(Menu.Division.ID).CurEnumValue;
       TR.Clear();
       OldRestriction = 0;
       OldFeeder = 0;
       i = 0;
       j = 1;
       k = 1;
       REPEATED
       SELECT   :TempRestriction.RestrictionId = R.RestrictionId,
                :TempRestriction.RestrictionNumber = R.RestrictionNumber,
                :TempRestriction.DefectiveFeeder = R.DefectiveFeeder,
                :TempRestriction.time[1].StartDay = TR.StartDay,
                :TempRestriction.time[1].EndDay = TR.EndDay,
                :TempRestriction.time[1].StartTime = TR.StartTime,
                :TempRestriction.time[1].EndTime = TR.EndTime,
                :TempRestriction.time[1].TimeSeq = TR.TimeSeq,
                :TempRestriction.DefectiveFeederName = R.DefectiveFeederName,          
                :TempRestriction.DefectiveEquip = R.DefectiveEquip,          
                :TempRestriction.DefectiveEquipName = R.DefectiveEquipName,          
                :TempRestriction.DefectiveNetworkName = R.DefectiveNetworkName,          
                :TempRestriction.DefectiveEquipLocation = R.DefectiveEquipLocation,          
                :TempRestriction.Feeder[1].Feeder = FR.Feeder,
                :TempRestriction.Feeder[1].FeederName = FR.FeederName,
                :TempRestriction.Feeder[1].FeederSeq = FR.FeederSeq,
                :TempRestriction.Feeder[1].Lifted = FR.Lifted,
                :TempRestriction.ExpirationDate = R.ExpirationDate,
                :TempRestriction.Reason = R.Reason,          
                :TempRestriction.Division = R.Division          
       FROM     FMS_Restriction R,
                FMS_TimeRestriction TR,
                FMS_FeederRestriction FR1,
                FMS_FeederRestriction FR,
                Udb_Grouping G
       WHERE    G.Grouping = :Division AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Member = FR1.Feeder AND
                FR1.RestrictionID = FR.RestrictionID AND
                FR1.RestrictionID = R.RestrictionId AND
                FR1.RestrictionID = TR.RestrictionID 
               
       ORDER BY RestrictionNumber,FeederSeq,TimeSeq
       BEGIN
          IF TempRestriction.RestrictionId <> OldRestriction THEN
             j = 1;
             k = 1;
             i = i + 1;
    
             OldFeeder = TempRestriction.Feeder[1].Feeder;
             FeederSequence = TempRestriction.Feeder[1].FeederSeq;
             TimeSequence = TempRestriction.Time[1].TimeSeq;
             OldRestriction = TempRestriction.RestrictionId;
   
             TR[i] = TempRestriction.Duplicate();
             j = j + 1;
             k = k + 1;
          ELSE
             IF TempRestriction.Feeder[1].FeederSeq > FeederSequence THEN
                FeederSequence = TempRestriction.Feeder[1].FeederSeq;
                TR[i].Feeder[k].Feeder     = TempRestriction.Feeder[1].Feeder;
                TR[i].Feeder[k].FeederName = TempRestriction.Feeder[1].FeederName;
                TR[i].Feeder[k].FeederSeq  = TempRestriction.Feeder[1].FeederSeq;
                TR[i].Feeder[k].Lifted  = TempRestriction.Feeder[1].Lifted;
                k = k + 1;
             ENDIF;
   
             IF TempRestriction.Time[1].TimeSeq > TimeSequence THEN
                TimeSequence = TempRestriction.Time[1].TimeSeq;
                TR[i].Time[j].StartDay  = TempRestriction.Time[1].StartDay;
                TR[i].Time[j].EndDay    = TempRestriction.Time[1].EndDay;
                TR[i].Time[j].StartTime = TempRestriction.Time[1].StartTime;
                TR[i].Time[j].Endtime   = TempRestriction.Time[1].EndTime;
                j = j + 1;
             ENDIF;
          ENDIF;
       END;
       tab.fdr.Restriction.Clear();
       tab.fdr.Restriction = TR.Duplicate();
       IF tab.fdr.Restriction.LastRow() > 0 THEN
          Field(tab.fdr.Restriction).ActiveRow = 1;
       ENDIF;
    ENDIF; 
  ENDIF;
END;     

ON PageActivated tab.fdr =
BEGIN
   IF FIELD(tab.fdr.Restriction).Parentfield.Height + FIELD(Exit_btn).Height > FIELD(tab).Height THEN
      FIELD(tab).Height = FIELD(tab.fdr.Restriction).Parentfield.Height + FIELD(Exit_btn).Height;
      CurFrame.IsAutoSized = TRUE;
   ENDIF;
END;           

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE LoadHistory (
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   FIELD(tab.net.Log).Title = 'Restriction History for ' + tab.net.tf[CurRow].Name;

   i = 1;
   tab.net.Log.Clear();
   SELECT :tab.net.Log[i].Time = L.Time,
          :tab.net.Log[i].Name = L.OperatorName,
          :tab.net.Log[i].Action = L.New
   FROM    SOA_Log L
   WHERE   L.Card = :Type$NetWork AND
           L.SwitchingItem = :tab.net.tf[CurRow].Object
   BEGIN 
      i = i + 1;
   END;   
END;

PROCEDURE LoadNetworkFeeders (
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   TempChar = VARCHAR(20) NOT NULL;
   TypeList = ARRAY OF ObjectSummaryClass;
ENDDECLARE
BEGIN
   FOR m = 1 TO tab.net.tf.LastRow DO
      TypeList.Clear();
      SELECT :TempChar = UPPERCASE(O.Name)
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Grouping = :tab.net.tf[m].Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = :Type$Feeder AND
              G.Member = O.Object
      BEGIN
         FOR i = 1 TO Length(TempChar) DO
            IF LEFT(TempChar,i) like '%\[A-Z\]%' escape '\' THEN
               RetCode = TypeList.Find(AttributeName = 'name',
                                       Value = LEFT(TempChar,i));
               IF RetCode <> ER_OK THEN
                  TypeList[TypeList.LastRow + 1].Name = LEFT(TempChar,i);
               ENDIF;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      END;
      TempChar = '';
      FOR i = 1 TO TypeList.LastRow DO
         TempChar = TempChar + ' ' + TypeList[i].Name;
      ENDFOR;
      tab.net.tf[m].Description = TRIM(TempChar);
   ENDFOR;
END;

