*/
/*
**  Application:    SOA
**  Class:          CardSOA
**
**  Date:       Author   Description
** ----------------------------------
**  01/16/98    pkw      Created
**  01/24/98    pkw      added insert card method
**  08/26/98    em       added update card method
**  09/18/98    em       added archive card processing
**  11/23/98    pkw      add return code to update card method.
**  02/12/99    em       added log insert following card creation
**  07/11/02    em       Modified InsertCard to use Opened time if it exists
**                       (It will exist for FMS cards)
**  05/08/03    em       Removed ShowNote field from fms_card and from Class
**  02/16/03    em       Converted Message to TraceError Call
**  03/23/05    em       Load Archived SDS Cards from regular SDS_Card table.
**  10/02/07    em       Allow for NSA Steam card type.
**  12/31/08    ysp      add SDS card note in LoadCard method
**  06/30/14    em       added TraceCard to insertcard  method parameter list for DSO
**  06/30/14    em       added FacilityName to insertcard method parameter list for DSO
**  03/03/15    em       Need to add CreateCopy parm that was added to CardDSO InsertCard
**  06/30/17    ysp      Add IncidentReport attribute
*/
METHOD LoadCard (
   Card     = INTEGER NOT NULL;
)=
BEGIN
   IF Card = 0 THEN
      RETURN(CurObject);
   ENDIF;

   IF ArchiveCard = FALSE OR CurrentApplication = Application$SLC THEN

      SELECT 
          :CurObject.Card           = C.Card,
          :CurObject.Activated      = C.Activated,
          :CurObject.Application    = C.Application,
          :CurObject.CardClass      = C.CardClass,
          :CurObject.CardClassName  = C.CardClassName,
          :CurObject.Closed         = C.Closed,
          :CurObject.CutIn          = C.CutIn,
          :CurObject.CutOut         = C.CutOut,
          :CurObject.EstTimeComplete  = C.EstTimeComplete,
          :CurObject.EstTimeInService = C.EstTimeInService,
          :CurObject.NotifyFlag     = C.NotifyFlag,
          :CurObject.Notifications  = C.Notifications,
          :CurObject.Opened         = C.Opened,
          :CurObject.Note           = C.Note,
          :CurObject.Relays         = C.Relays,
          :CurObject.ShowNoteFlag   = C.ShowNoteFlag,
          :CurObject.Status         = C.Status,
          :CurObject.TypeOfCard     = C.TypeOfCard,
          :CurObject.Validated      = C.Validated,
          :CurObject.WorkPermitFlag = C.WorkPermitFlag
      FROM  SOA_Card C
      WHERE C.Card = :Card;

   ELSEIF CurrentApplication = Application$TFMS THEN

      SELECT 
          :CurObject.Card           = C.Card,
          :CurObject.Activated      = C.Activated,
          :CurObject.Application    = :Application$TFMS,
          :CurObject.CardClass      = C.CardClass,
          :CurObject.CardClassName  = C.CardClassName,
          :CurObject.Closed         = C.Closed,
          :CurObject.CutIn          = C.CutIn,
          :CurObject.CutOut         = C.CutOut,
          :CurObject.EstTimeComplete  = C.EstTimeComplete,
          :CurObject.EstTimeInService = C.EstTimeInService,
          :CurObject.Opened         = C.Opened,
          :CurObject.Relays         = C.Relays,
          :CurObject.Status         = C.Status,
          :CurObject.TypeOfCard     = :TypeOfCard$TFMS,
          :CurObject.Validated      = VARCHAR(C.Validated)
      FROM  TFMS_ArchiveCard C
      WHERE C.Card = :Card;
      
      IF CurObject.Validated = '1' THEN
         CurObject.Validated = 'YES';
      ELSE
         CurObject.Validated = 'NO';
      ENDIF;

   ELSEIF CurrentApplication = Application$SDS THEN

      SELECT 
          :CurObject.Card           = C.Card,
          :CurObject.Activated      = C.Activated,
          :CurObject.Application    = :Application$SDS,
          :CurObject.CardClass      = C.CardClass,
          :CurObject.CardClassName  = C.CardClassName,
          :CurObject.Closed         = C.Closed,
          :CurObject.Opened         = C.Opened,
          :CurObject.TypeOfCard     = S.TypeOfCard,
          :CurObject.Status         = C.Status,
          :CurObject.Note           = S.Note
      FROM  SDS_Card C, 
            SOA_Card S
      WHERE C.Card = :Card AND 
            C.Card = S.Card;

   ELSEIF CurrentApplication = Application$DSO THEN

      SELECT 
          :CurObject.Card           = C.Card,
          :CurObject.Activated      = C.Activated,
          :CurObject.Application    = :Application$DSO,
          :CurObject.CardClass      = C.CardClass,
          :CurObject.CardClassName  = C.CardClassName,
          :CurObject.Closed         = C.Closed,
          :CurObject.Opened         = C.Opened,
          :CurObject.TypeOfCard     = S.TypeOfCard,
          :CurObject.Status         = C.Status,
          :CurObject.Note           = S.Note
      FROM  SDS_Card C, 
            SOA_Card S
      WHERE C.Card = :Card AND 
            C.Card = S.Card;

   ELSE   /* Archived FMS Cards */
      CALLPROC TraceError (UserMessage = 
             'Archive FMS Cards are not part of SOA at this time.',
                           TraceMessage =
             'CardSOA;LoadCard; System made an unsupported attempt to load ' +
             'an FMS Archive Card from SOA.'
             );
      RETURN (CurObject);
   ENDIF;
   RETURN(CurObject);
END;

METHOD InsertCard (
   Objects = ARRAY OF DSO_trace_engine!Equipment;
   TracePath   = ARRAY OF DSO_trace_engine!PathTraceResult;
   FacilityName  = VARCHAR(40) NOT NULL WITH DEFAULT;
   ConnectedBreakers = ARRAY OF ConnectedEquipClass;
   ConnectedLineSegs = ARRAY OF ConnectedEquipClass;
   CreateCopy = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Insert card info into SOA_Card.  Set Opened time here 
** to avoid time problem with ddb recovery
*/
   IF CurObject.Opened IS NULL OR CurObject.Opened = '' THEN
      CurObject.Opened = DATE('now');
   ENDIF;
   RetCode = CALLPROC SOA_CardIns(Card = CurObject.Card
                                 ,Application = CurObject.Application
                                 ,CardClass = CurObject.CardClass
                                 ,Opened = CurObject.Opened
                                 ,Status = CurObject.Status
                                 ,TypeOfCard = CurObject.TypeOfCard
                                 ,Validated = CurObject.Validated
                                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert new card.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSOA;InsertCard; Card insertion failed.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_LogIns (
          Card            = CurObject.Card
        , Job             = NULL
        , SwitchingItem   = 0
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'New Card'
        , New             = 'Card Created'
        );

   IF RetCode <> 0 THEN
/*
** Not a fatal error
*/
         CALLPROC DDB_ROLLBACK;
   ELSE
         CALLPROC DDB_COMMIT;
   ENDIF;
END;

METHOD UpdateCard (
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(120) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Updates card fields
*/
   RetCode = CALLPROC SOA_CardUpd (Card = CurObject.Card
                                  ,Activated = CurObject.Activated
                                  ,Closed = CurObject.Closed
                                  ,CutIn = CurObject.CutIn
                                  ,CutOut = CurObject.CutOut
                                  ,EstTimeComplete = CurObject.EstTimeComplete
                                  ,EstTimeInService = CurObject.EstTimeInService
                                  ,Notifications = CurObject.Notifications
                                  ,Note = CurObject.Note
                                  ,Relays = CurObject.Relays
                                  ,ShowNoteFlag = CurObject.ShowNoteFlag
                                  ,Validated = CurObject.Validated
                                  ,WorkPermitFlag = CurObject.WorkPermitFlag
                                  );
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
      i = 0;
      SELECT :i = COUNT(*) 
      FROM   SOA_CardControl
      WHERE  Card = :CurObject.Card AND
             UserName <> :UserName;

      IF i > 0 THEN
         EventText = VARCHAR(CurObject.Card) + ';' + UserName + ';';
         CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_CardHeaderChange', 
                                     DBEventText = EventText); 
         CALLPROC DDB_COMMIT;
      ENDIF;

      SOAFrame.SendUserEvent (EventName = 'LoadCardInfo');
      RETURN PU_OK;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update SOA card.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardSOA;UpdateCard; Card update failed.'
             );
      RETURN PU_CANCEL;
   ENDIF;
END;

