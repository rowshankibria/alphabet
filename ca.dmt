METHOD IsDOOnDesk(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.Object = 0;
   SELECT :CurObject.Object = Object,
          :CurObject.Type = Type,
          :CurObject.Description = Description
   FROM   Udb_Object 
   WHERE  Name = :CurObject.Name AND
             Type IN (SELECT Type FROM Udb_ExtendedType
                      WHERE  SuperType = :Type$Person);

   IF CurObject.Object = 0 THEN
      MESSAGE 'Operator or manager with employee number ' +
               VARCHAR(CurObject.Name) +
              ' does not exist in the database.  Change is ' +
              'not confirmed.';
      RETURN PU_CANCEL;
   ENDIF;     

   IF CurObject.Object = Dop.Object THEN
      MESSAGE 'Change must be reviewed and confirmed by someone else.';
      CurObject.Name = '';
      RETURN PU_CANCEL;
   ENDIF;  

   IF CurObject.Object = Operator$StaffSupport THEN
      MESSAGE 'Staff Support is not qualified to confirm this change.';
      CurObject.Name = '';
      RETURN PU_CANCEL;
   ENDIF;  
/*
** If not a Manager then confirm that DO is logged in on another machine
*/      
   IF CurObject.Type <> Type$ECCManager THEN
      i = 0;
      SELECT :i = Operator
      FROM   SOA_DOLogin
      WHERE  Operator = :CurObject.Object AND
             LogOut IS NULL;

      IF i = 0 THEN
         MESSAGE 'Operator ' + VARCHAR(CurObject.Name) + ' - ' +
                  CurObject.Description + ' is not logged in at this time.  Must ' +
                 'be logged in on another machine to confirm this change.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;  

   RETURN PU_OK;
END;

