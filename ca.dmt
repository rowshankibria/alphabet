	Name:            RemoveValue

/*
**
**	Copyright c 1991 ESCA Corporation.  All rights reserved.
**
**	ESCA Corporation proprietary and trade secret information.
**	Do not copy or disclose to third parties  without  written 
**	permission from an officer of ESCA Corporation.
**
*/
/*
**  Application:    SubstationLogCard
**  Procedure       RemoveValue
**                  Remove a value from an array if it is in this array.
**
**  11/07/95  ysp   Initial version.
**                  
*/
Procedure RemoveValue
(
    ValueList  = ARRAY of IntegerObject;
    Value = INTEGER NOT NULL;
    IDX = INTEGER;
) =
BEGIN
    IDX = 1;
    WHILE IDX <= ValueList.LastRow() DO
       IF Value = ValueList[IDX].Value THEN
          ValueList.RemoveRow (RowNumber = IDX);
          RETURN;
       ELSE
          IDX = IDX + 1;
       ENDIF;
    ENDWHILE;

    RETURN;
END;


