	Name:            UpdateCardColor

/****************************************************************************

          Copyright � 1991, 1992 by Unified Information, Inc.
          All Rights Reserved.  Unpublished rights reserved under the
          copyright laws of the United States.

          The software contained on this media is proprietary to and
          embodies the confidential technology of Unified Information, Inc.
          Possession, use, duplication or dissemination of the software 
          and media is authorized only pursuant to a valid written license 
          from Unified Information, Inc.

          RESTRICTED RIGHTS LEGEND  Use, duplication, or disclosure by the
          U.S. Government is subject to restrictions as set forth in
          Subparagraph (c) (1) (ii) of DFARS 252.227-7013, or in FAR
          52.227-19, as applicable.

 ****************************************************************************/
/*
 *        Application:  FeederCard
 *        Frame:        UpdateCardColors
 *
 */
PROCEDURE UpdateCardColor
    (
    AF = ActiveField;                   /* Passed active field reference */
    BGColor = INTEGER NOT NULL;         /* passed desired background color */
    TriggerColor = INTEGER NOT NULL;    /* passed trigger background color */
    CF = CompositeField;                /* Scratch composite field reference */
    i = INTEGER;                        /* Scratch integer */
    )=
    BEGIN
        IF (AF.BGColor = TriggerColor) THEN
        /* Set the background color of the passed field */
            AF.BGColor = BGColor;
        ENDIF;  
/*
 *      If it is a composite field, set the Background color of
 *      any of the children that are active fields
 */
        IF AF.IsA(Class = CompositeField) = TRUE THEN
            CF = CompositeField(AF);
            i = 1;

            WHILE i <= CF.ChildFields.LastRow() DO

                IF CF.ChildFields[i].IsA(Class = ActiveField) = TRUE THEN
                    CALLPROC UpdateCardColor 
                    (AF = CF.ChildFields[i], 
                     BGColor = BGColor,
                     TriggerColor = TriggerColor);
                ENDIF;

                i = i + 1;
            ENDWHILE;

        ENDIF;

    END;

