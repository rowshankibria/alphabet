	Name:            OSS_Request_ASE


���p(�x��Component Method Scripts
���p(�x��--------------------------
/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OSS_Request_ASE
**
**  Date:       Version Description
** ----------------------------------
**  09/02/08    em  Created; 
*/ 
METHOD LoadOSSRequests(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;
   m  = INTEGER NOT NULL WITH DEFAULT;

   DynamicWhereClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeMapping = TypeClass_ASE;
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';

   DynamicWhereClause = '';
   CurObject.PL.Clear();

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;

   IF CurObject.GroupFilter > 0 THEN	
      DynamicWhereClause = ' P.WorkGroup = ' + VARCHAR(CurObject.GroupFilter) + ' AND ';
   ENDIF;

   IF CurObject.StatusFilter <> 0 THEN 
       DynamicWhereClause = DynamicWhereClause  + ' P.Status = ' + VARCHAR(CurObject.StatusFilter ) + ' AND ';
   ENDIF;

   IF StartDate <> '' AND EndDate <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND ((P.StartDateTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.StartDateTime < DATE(''' + VARCHAR(EndDate) + ''')' + ') OR ' + 
               '(P.ReturnDateTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.ReturnDateTime < DATE(''' + VARCHAR(EndDate) + ''')' + '))';
   ELSEIF StartDate <> '' AND EndDate = '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND P.StartDateTime >= DATE(''' + VARCHAR(StartDate) + ''') OR ' + 
               'P.ReturnDateTime >= DATE(''' + VARCHAR(StartDate) + ''')';
   ELSEIF StartDate = '' AND EndDate <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ' AND P.StartDateTime <= DATE(''' + VARCHAR(EndDate) + ''') OR ' + 
               'P.ReturnDateTime <= DATE(''' + VARCHAR(EndDate) + ''')';
   ENDIF;


   IF CurObject.DivisionFilter <> 0 THEN		
      DynamicWhereClause = DynamicWhereClause  + ' G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.Member = P.Substation AND ' +    
             'P.Substation = O.Object AND P.WorkGroup = T.Type';

 
//  CurMethod.Trace(Text = varchar(date('now')) + 'DynamicWhereClause: ' + DynamicWhereClause);
      i = 1;
      SELECT :CurObject.PL[i].RequestID = P.RequestID,
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].EnterByEmpID = P.EnterByEmpID,		      
             :CurObject.PL[i].EnterByName = P.EnterByName,		      
             :CurObject.PL[i].ModTime = P.ModTime,		    
             :CurObject.PL[i].ModByEmpID = P.ModByEmpID,		      
             :CurObject.PL[i].ModByName = P.ModByName,		      
             :CurObject.PL[i].Level1Time = P.Level1Time,		    
             :CurObject.PL[i].Level1ByEmpID = P.Level1ByEmpID,		      
             :CurObject.PL[i].Level1ByName = P.Level1ByName,		      
             :CurObject.PL[i].Level2Time = P.Level2Time,		    
             :CurObject.PL[i].Level2ByEmpID = P.Level2ByEmpID,		      
             :CurObject.PL[i].Level2ByName = P.Level2ByName,		      
             :CurObject.PL[i].Level3Time = P.Level3Time,		    
             :CurObject.PL[i].Level3ByEmpID = P.Level3ByEmpID,		      
             :CurObject.PL[i].Level3ByName = P.Level3ByName,		      
             :CurObject.PL[i].SWPTime = P.SWPTime,		    
             :CurObject.PL[i].SWPByEmpID = P.SWPByEmpID,		      
             :CurObject.PL[i].SWPByName = P.SWPByName,		      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].WorkGroupName = T.Name,        
             :CurObject.PL[i].Title = P.Title,			    
             :CurObject.PL[i].Description = P.Description,
             :CurObject.PL[i].ContinuousDaily = P.ContinuousDaily,
             :CurObject.PL[i].HoursPerDay = P.HoursPerDay,
             :CurObject.PL[i].DaysPerWeek = P.DaysPerWeek,
             :CurObject.PL[i].SWP = P.SWP,
             :CurObject.PL[i].OutageDateTime = P.OutageDateTime,
             :CurObject.PL[i].StartDateTime = P.StartDateTime,
             :CurObject.PL[i].ReturnDateTime = P.ReturnDateTime,
             :CurObject.PL[i].RecallTime = P.RecallTime,
             :CurObject.PL[i].RecallTerm = P.RecallTerm,
             :CurObject.PL[i].HTChange = P.HTChange,
             :CurObject.PL[i].EquipOutTwice = P.EquipOutTwice,
             :CurObject.PL[i].RescindDenyByEmpID = P.RescindDenyByEmpID,
             :CurObject.PL[i].RescindDenyTime = P.RescindDenyTime,
             :CurObject.PL[i].RescindDenyByName = P.RescindDenyByName,
             :CurObject.PL[i].RescindDenyReason = P.RescindDenyReason
      FROM   OSS_Request P,
             UDB_Grouping G,
             UDB_Object O,
             Udb_Type T 
      WHERE  :DynamicWhereClause 
      ORDER BY 4 					// P.EnterTime 
      BEGIN
         i = i + 1;
      END;
   ELSE
      DynamicWhereClause = DynamicWhereClause + ' P.Substation = O.Object AND P.WorkGroup = T.Type';
// CurMethod.Trace(Text = varchar(date('now')) + 'DynamicWhereClause: ' + DynamicWhereClause);
 
      i = 1;
      SELECT :CurObject.PL[i].RequestID = P.RequestID,
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].EnterByEmpID = P.EnterByEmpID,		      
             :CurObject.PL[i].EnterByName = P.EnterByName,		      
             :CurObject.PL[i].ModTime = P.ModTime,		    
             :CurObject.PL[i].ModByEmpID = P.ModByEmpID,		      
             :CurObject.PL[i].ModByName = P.ModByName,		      
             :CurObject.PL[i].Level1Time = P.Level1Time,		    
             :CurObject.PL[i].Level1ByEmpID = P.Level1ByEmpID,		      
             :CurObject.PL[i].Level1ByName = P.Level1ByName,		      
             :CurObject.PL[i].Level2Time = P.Level2Time,		    
             :CurObject.PL[i].Level2ByEmpID = P.Level2ByEmpID,		      
             :CurObject.PL[i].Level2ByName = P.Level2ByName,		      
             :CurObject.PL[i].Level3Time = P.Level3Time,		    
             :CurObject.PL[i].Level3ByEmpID = P.Level3ByEmpID,		      
             :CurObject.PL[i].Level3ByName = P.Level3ByName,		      
             :CurObject.PL[i].SWPTime = P.SWPTime,		    
             :CurObject.PL[i].SWPByEmpID = P.SWPByEmpID,		      
             :CurObject.PL[i].SWPByName = P.SWPByName,		      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].WorkGroupName = T.Name,        
             :CurObject.PL[i].Title = P.Title,			    
             :CurObject.PL[i].Description = P.Description,
             :CurObject.PL[i].ContinuousDaily = P.ContinuousDaily,
             :CurObject.PL[i].HoursPerDay = P.HoursPerDay,
             :CurObject.PL[i].DaysPerWeek = P.DaysPerWeek,
             :CurObject.PL[i].SWP = P.SWP,
             :CurObject.PL[i].OutageDateTime = P.OutageDateTime,
             :CurObject.PL[i].StartDateTime = P.StartDateTime,
             :CurObject.PL[i].ReturnDateTime = P.ReturnDateTime,
             :CurObject.PL[i].RecallTime = P.RecallTime,
             :CurObject.PL[i].RecallTerm = P.RecallTerm,
             :CurObject.PL[i].HTChange = P.HTChange,
             :CurObject.PL[i].EquipOutTwice = P.EquipOutTwice,
             :CurObject.PL[i].RescindDenyByEmpID = P.RescindDenyByEmpID,
             :CurObject.PL[i].RescindDenyTime = P.RescindDenyTime,
             :CurObject.PL[i].RescindDenyByName = P.RescindDenyByName,
             :CurObject.PL[i].RescindDenyReason = P.RescindDenyReason
      FROM   OSS_Request P,
             Udb_Object O, 
             Udb_Type T 
      WHERE  :DynamicWhereClause 
      ORDER BY 4 				// P.EnterTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;    
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No OSS Requests match the filter criteria.';
   ENDIF;
/*
** Convert Type to RR Types
*/
   TypeMapping.GetEquipTypeMapping();

   FOR i = 1 TO CurObject.PL.LastRow() DO
      j = 1;
      SELECT :CurObject.PL[i].WorkItem[j].RequestID = WI.RequestID,
             :CurObject.PL[i].WorkItem[j].WorkItem = WI.WorkItem,
             :CurObject.PL[i].WorkItem[j].PrimaryEquip = WI.PrimaryEquip,
             :CurObject.PL[i].WorkItem[j].PrimaryEquipName = O.Name,
             :CurObject.PL[i].WorkItem[j].PrimaryEquipType = O.Type,
             :CurObject.PL[i].WorkItem[j].PrimaryEquipTypeName = O.TypeName
      FROM   OSS_WorkItem WI,
             Udb_Object O
      WHERE  WI.RequestID = :CurObject.PL[i].RequestID AND
             WI.PrimaryEquip = O.Object
      ORDER BY 2
      BEGIN 
         IF TypeMapping.CList.LastRow > 0 THEN
            RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                            Value = CurObject.PL[i].WorkItem[j].PrimaryEquipType,
                                            RowNumber = ByRef(m));
            IF RetCode = ER_OK THEN
               CurObject.PL[i].WorkItem[j].PrimaryEquipTypeName = TypeMapping.CList[m].Description;
            ENDIF;
         ENDIF;
         k = 1;
         SELECT :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].RequestID = IE.RequestID,
                :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].WorkItem = IE.WorkItem,
                :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].Equip = IE.Equip,
                :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].EquipName = O.Name,
                :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].EquipType = O.Type,
                :CurObject.PL[i].WorkItem[j].ImpactedEquip[k].EquipTypeName = O.TypeName
         FROM   OSS_ImpactedEquip IE,
                Udb_Object O
         WHERE  IE.RequestID = :CurObject.PL[i].WorkItem[j].RequestID AND
                IE.WorkItem = :CurObject.PL[i].WorkItem[j].WorkItem AND
                IE.Equip = O.Object
         BEGIN 
            IF TypeMapping.CList.LastRow > 0 THEN
               RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                            Value = CurObject.PL[i].WorkItem[j].ImpactedEquip[k].EquipType,
                                            RowNumber = ByRef(m));
               IF RetCode = ER_OK THEN
                  CurObject.PL[i].WorkItem[j].ImpactedEquip[k].EquipTypeName = TypeMapping.CList[m].Description;
               ENDIF;
            ENDIF;
            k = k + 1;
         END;
         j = j + 1;
      END;
   ENDFOR;
   RETURN; 
END;

METHOD DeleteOSSRequests (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].DeleteRequest();
   ENDFOR;

   RETURN;
END;



