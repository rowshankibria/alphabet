**  11/08/17    ysp     Convert LinkToOutageRequest and DeleteFromOutageRequest methods
**  11/19/20    em      In SpareBankBkrPreload method, look for outstanding move on the equipment on
**                      another card/item before inserting new move
**  03/25/21    em      Remove call to OS*WP methods
**  11/07/23    em      To Method  LoadOutstandingMoves, add JobControl delete to remove from Secret ET card  
**                      just in case it exists there.  We don't want the move to be marked shared with the secret card.
**  01/31/24    em      If the Outstanding Move being loaded is an ET Stop Tag move, do not delete the preloaded
**                      stop tag move.
*/
METHOD InsertJob (
   Card			= INTEGER NOT NULL; /*Passed Card*/
   KeepJobID            = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm*/
) =
DECLARE
   JobID		= INTEGER NOT NULL WITH DEFAULT; /*Job Return Code*/
BEGIN
   IF KeepJobID = TRUE THEN    /* Set TRUE on ISWP insert */
      CurObject.Job = CurObject.Job;    
   ELSE
      CurObject.Job = -1;
   ENDIF;
/*
** Immediate insert into SOA_Job table.
*/
   JobID = CALLPROC SOA_JobIns (
	  Card            = Card 
	, Job             = CurObject.Job 
	, Equip           = CurObject.Equip
        , Status          = CurObject.Status
	, JobClass        = CurObject.JobClass
	, EquipName       = CurObject.EquipName
	, EquipClass      = CurObject.EquipClass
	, EquipClassName  = CurObject.EquipClassName
	, MoveType        = CurObject.MoveType
	, TOMove          = CurObject.TOMove
	, TOMoveRules     = CurObject.TOMoveRules
	, RSMove          = CurObject.RSMove
	, RSMoveRules     = CurObject.RSMoveRules
	, Substation      = CurObject.Substation
        , MoveCategory    = CurObject.MoveCategory
	, TypeGround      = Status$Ground
        , ActivityIdentifier = CurObject.ActivityIdentifier
        , ControlCard     = CurObject.ControlCard
        , DeskName        = CurObject.DeskName
	);

   IF JobID < 0 THEN 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert job.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertJob; SOA_Job Insert update failed.'
             );
      RETURN JobID;
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN JobID;
   ENDIF;
END;

METHOD LoadOutstandingMoves (
   Application          = VARCHAR(20) NOT NULL WITH DEFAULT;
   Card                 = INTEGER NOT NULL WITH DEFAULT; 
   SwitchingItem        = INTEGER NOT NULL WITH DEFAULT;
   TypeOfCard           = INTEGER NOT NULL WITH DEFAULT;
   Jobs                 = ARRAY OF Job;
   Feeder               = INTEGER NOT NULL WITH DEFAULT; /* FMS Card Feeder */
   SingleFeederOnly     = INTEGER NOT NULL WITH DEFAULT; /* For FMS JobActions*/
   EquipList            = VARCHAR(4000) NOT NULL WITH DEFAULT; /* for SLC NewMoves */ 
)=
DECLARE
   CardList             = VARCHAR(400) NOT NULL WITH DEFAULT;
   ControlText          = VARCHAR(256) NOT NULL WITH DEFAULT;
   DynamicWhereClause   = VARCHAR(6000) NOT NULL WITH DEFAULT;
   ETStopTagMove        = INTEGER      NOT NULL WITH DEFAULT;
   JobBankDynamClause   = VARCHAR(3000) NOT NULL WITH DEFAULT;
   i                    = INTEGER      NOT NULL WITH DEFAULT;
   k                    = INTEGER      NOT NULL WITH DEFAULT;
   x                    = INTEGER      NOT NULL WITH DEFAULT;
   ETSecretCard         = INTEGER      NOT NULL WITH DEFAULT;
   FeederEquip          = ARRAY OF FMS_Equip;
   GroundCount          = INTEGER NOT NULL WITH DEFAULT;
   JobLastRow           = INTEGER      NOT NULL WITH DEFAULT;
   JobsInBank           = ARRAY OF IntegerObject;
   JobControlList       = ARRAY OF NewMoveCard;
   LastRow              = INTEGER      NOT NULL WITH DEFAULT;
   OutstandingMoves     = ARRAY OF Job;
   PreviousJob          = INTEGER NOT NULL WITH DEFAULT;/*Duplicate Prevention*/
   RetCode              = INTEGER      NOT NULL WITH DEFAULT;
BEGIN
   IF Application = Application$SLC THEN
      IF EquipList = '' THEN
         /* 
         ** Create an equipment list for the switching Item.
         */
         i = 0;
         k = 0;
         EquipList = '';
         REPEATED
         SELECT DISTINCT :i = J.Equip
         FROM  SOA_Job J,
               SOA_JobControl JC
         WHERE JC.SwitchingItem = :SwitchingItem AND
               JC.Job = J.Job AND
               (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
               J.Equip > :Object$NULL AND
               J.MoveCategory = :MoveCategory$Normal AND  /*Ignore Item Headings*/
               J.Status IN ('', :JobStatus$NIS)
         BEGIN
           IF k = 0 THEN
              EquipList = '(' + varchar(i);
              k = 1;
           ELSE
              EquipList = EquipList + ',' + varchar(i);
           ENDIF;
         END;

         IF EquipList = '' THEN /* No equip on item */
            RETURN PU_OK;
         ELSE
            EquipList = EquipList + ')';
         ENDIF; 
      ENDIF; 
/* 
** Find all moves from FMS cards which are either cut out or cut in. 
*/
      DynamicWhereClause = 
         'J.Equip IN ' + EquipList + ' AND ' +
         '(J.ToComplete IS NULL OR ' +
         'J.RSComplete IS NULL) AND ' +
         'J.Status IN ('' '', ''NIS'') AND ' +
         'J.MoveCategory = ' + varchar(MoveCategory$Normal) + ' AND ' +
         'J.Job = JC.Job AND ' +
         'JC.Card = AC.Card AND ' +
         'JC.Card = C.Card AND ' +
         '(C.CutOut IS NULL OR C.CutIn IS NOT NULL) AND ' + 
         'JCC.TypeOfCard = ' + varchar(TypeOfCard) + ' AND ' +
         'JCC.JobClass = J.JobClass AND ' +
         'JCC.PreferredStep = 1 AND ' +
         'J.EquipClass IN (SELECT Type ' +
                           'FROM   Udb_ExtendedType ' +
                           'WHERE  SuperType = JCC.EquipClass)';
      x = 1;
      OutstandingMoves.Clear();
      JobControlList.Clear();
      SELECT DISTINCT
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Substation = J.Substation,   
           OutstandingMoves[x].Card = :Card,  /* We are not inserting into a shadow item */
           JobControlList[x].Card = :Card,
           JobControlList[x].MoveEquipClass = JCC.EquipClass,
           JobControlList[x].StepHeading = JCC.StepPair,
           JobControlList[x].StepLevel = 0,
           JobControlList[x].SwitchingItem = :SwitchingItem,
           JobControlList[x].PrintID = JC.PrintID,
           JobControlList[x].TypeOfCard = JCC.TypeOfCard,
           JobControlList[x].Application = :Application 
      FROM  FMS_JobClassControl JCC,
            SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard AC,
            FMS_Card C
      WHERE :DynamicWhereClause
      BEGIN 
         x = x + 1;
      END;
/*
** Dynamic where clause to get outstanding jobs from the job bank. 
** (Outstanding ground jobs are saved in the job bank when a switching
** item is closed).
*/
      JobBankDynamClause= 'DJ.Equip IN ' + EquipList + ' AND ' +
            'DJ.Job = J.Job AND ' +
            'J.JobClass = JCC.JobClass AND ' + 
            'JCC.TypeOfCard = ' + varchar(TypeOfCard) + ' AND ' +
            'JCC.PreferredStep = 1 AND ' + 
            'J.EquipClass IN (SELECT Type ' +  
                                ' FROM   Udb_ExtendedType ' + 
                                ' WHERE  SuperType = JCC.EquipClass)';
      k = 1;
      JobsInBank.Clear();

      SELECT DISTINCT
           JobsInBank[k].Value = DJ.Job,
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Card = :Card, 
           OutstandingMoves[x].Substation = J.Substation,   
           JobControlList[x].Card = :Card,
           JobControlList[x].MoveEquipClass = JCC.EquipClass,
           JobControlList[x].StepHeading = JCC.StepPair,
           JobControlList[x].StepLevel = 0,
           JobControlList[x].SwitchingItem = :SwitchingItem,
           JobControlList[x].PrintID = '',
           JobControlList[x].TypeOfCard = JCC.TypeOfCard,
           JobControlList[x].Application = :Application 
      FROM SOA_Job J,
           FMS_DroppedEquipJobs DJ,
           FMS_JobClassControl JCC
      WHERE :JobBankDynamClause 
      BEGIN
         x = x + 1;
         k = k + 1;
      END;

     /* get a list of jobs in the current switching item */
      IF Jobs.LastRow() = 0 THEN
         DynamicWhereClause = 
            'JC.Card = ' + VARCHAR(Card) + ' AND ' + 
            'JC.SwitchingItem = ' + VARCHAR(SwitchingItem) + ' AND ' + 
            'JC.Job = J.Job AND ' + 
            'J.Equip IN ' + EquipList + ' AND ' +
            'J.Status <> ''Del'' AND ' + 
            'J.MoveCategory = ' + VARCHAR(MoveCategory$Normal);  /*Ignore Item Headings*/
      
         k = 1;
         SELECT 
            :Jobs[k].Job = J.Job,
            :Jobs[k].JobClass = J.JobClass,
            :Jobs[k].Equip = J.Equip
         FROM SOA_JobControl JC,
               SOA_Job J
         WHERE :DynamicWhereClause
         BEGIN 
            k = k + 1;
         END;
      ENDIF;
/*
** TFMS/FMS/SDS Applications 
*/
   ELSE   
      x = 1;
      OutstandingMoves.Clear();
      JobControlList.Clear();
   
      IF Application = Application$TFMS THEN
         /* 
         ** get jobs from the job bank. (When a TFMS card is closed, its outstanding 
         ** ground moves are saved in the job bank.)
         */
         k = 1;
         JobsInBank.Clear();
   
         SELECT DISTINCT
            JobsInBank[k].Value = DJ.Job,
            OutstandingMoves[x].Job = J.Job,
            OutstandingMoves[x].Equip = J.Equip,
            OutstandingMoves[x].JobClass = J.JobClass,
            OutstandingMoves[x].TOIssued = J.TOIssued,
            OutstandingMoves[x].RSIssued = J.RSIssued,
            OutstandingMoves[x].TOComplete = J.TOComplete,
            OutstandingMoves[x].RSComplete = J.RSComplete,
            OutstandingMoves[x].Card = :Card,  
            OutstandingMoves[x].Substation = J.Substation,   
            JobControlList[x].Card = :Card,
            JobControlList[x].MoveEquipClass = JCC.EquipClass,
            JobControlList[x].StepHeading = JCC.StepPair,
            JobControlList[x].StepLevel = 0,
            JobControlList[x].SwitchingItem = 0,
            JobControlList[x].PrintID = G.Reference,
            JobControlList[x].TypeOfCard = JCC.TypeOfCard,
            JobControlList[x].Application = :Application 
         FROM SOA_ActiveObject AO,
               SOA_Job J,
               FMS_DroppedEquipJobs DJ,
               Udb_Grouping G,
               FMS_JobClassControl JCC
         WHERE AO.Card = :Card AND
               AO.ObjectToCardLink = 1 AND
               AO.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = J.Equip AND
               J.Equip > :Object$NULL AND     /* Potential performance gain */
               J.Equip = DJ.Equip AND
               J.Job = DJ.Job AND
               JCC.TypeOfCard = :TypeOfCard AND
               JCC.JobClass = J.JobClass AND
               JCC.PreferredStep = 1 AND  
               J.EquipClass IN (SELECT Type  
                              FROM   Udb_ExtendedType 
                              WHERE  SuperType = JCC.EquipClass)
         BEGIN 
            k = k + 1;
            x = x + 1;
         END;

         IF EquipList = '' THEN
            /*
            ** Create an equipment list for all objects linked to this card.
            */
            i = 0;
            k = 0;
            EquipList = '';
   
            REPEATED
            SELECT DISTINCT
               :i = G.Member
            FROM  Udb_Grouping G,
               SOA_ActiveObject AO,
               SOA_Job J
            WHERE AO.Card = :Card AND
                  AO.ObjectToCardLink = :TRUE AND
                  AO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType IN (SELECT Type
                              FROM   Udb_ExtendedType
                              WHERE  SuperType = :Type$Conducting) AND
                  G.Member = J.Equip
            BEGIN
               IF k = 0 THEN
                  EquipList = '(' + varchar(i);
                  k = 1;
               ELSE
                  EquipList = EquipList + ',' + varchar(i);
               ENDIF;
            END;
   
            IF EquipList = '' AND JobsInBank.LastRow() = 0 THEN /* No equip and not outstanding ground moves */
               RETURN PU_OK;
            ELSE
               EquipList = EquipList + ')';
            ENDIF; 
         ENDIF; 

      ELSEIF Application = Application$FMS THEN
/*
** Commented out pursuant to 3G
       IF Feeder = 0 THEN 
          CALLPROC TraceError (UserMessage = 
             'ERROR: Feeder ID not passed to LoadOutStanding moves. ' +
             'Have tech support review trace log.',
                           TraceMessage =
             'Job;LoadOutstandingMoves; Failed to pass in Feeder Obj ID.'
             );
         RETURN PU_CANCEL;
       ENDIF;
*/
         /*
         ** Add moves that may exist in the Dropped Equip Jobs bank for
         ** equipment on the feeder - in case the equipment was added to the feeder
         ** on the Udb screens and not on the Pickup equip screens. Also, outstanding
         ** ground moves are saved in the job bank when a card is closed.
         */
         k = 1;
         JobsInBank.Clear();
         SELECT DISTINCT
            JobsInBank[k].Value = DJ.Job,
            OutstandingMoves[x].Job = J.Job,
            OutstandingMoves[x].Equip = J.Equip,
            OutstandingMoves[x].JobClass = J.JobClass,
            OutstandingMoves[x].TOIssued = J.TOIssued,
            OutstandingMoves[x].RSIssued = J.RSIssued,
            OutstandingMoves[x].TOComplete = J.TOComplete,
            OutstandingMoves[x].RSComplete = J.RSComplete,
            OutstandingMoves[x].Card = :Card,  /* We are not inserting into a shadow item */
            OutstandingMoves[x].Substation = J.Substation,   /* so Initiating card is not important */
            JobControlList[x].Card = :Card,
            JobControlList[x].MoveEquipClass = JCC.EquipClass,
            JobControlList[x].StepHeading = JCC.StepPair,
            JobControlList[x].StepLevel = 0,
            JobControlList[x].SwitchingItem = 0,
            JobControlList[x].PrintID = G.Reference,
            JobControlList[x].TypeOfCard = JCC.TypeOfCard,
            JobControlList[x].Application = :Application 
         FROM SOA_Job J,
            FMS_DroppedEquipJobs DJ,
            Udb_Grouping G,
            FMS_JobClassControl JCC,
            TFMS_CardToObject AO
         WHERE    AO.Card = :Card AND
                  AO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.Member = J.Equip AND
                  J.Equip > :Object$NULL AND     /* Potential performance gain */
                  J.Equip = DJ.Equip AND
                  J.Job = DJ.Job AND
                  JCC.TypeOfCard = :TypeOfCard AND
                  JCC.JobClass = J.JobClass AND
                  JCC.PreferredStep = 1 AND  
                  J.EquipClass IN (SELECT Type  
                                 FROM   Udb_ExtendedType 
                                 WHERE  SuperType = JCC.EquipClass)
         BEGIN 
            k = k + 1;
            x = x + 1;
         END;
       
         /*
         ** Create an equipment list for the card feeder.
         */
         i = 1;
         k = 0;
         EquipList = '';
         FeederEquip.Clear();
   
         REPEATED
         SELECT DISTINCT
               :FeederEquip[i].Equip = G.Member,
               :FeederEquip[i].PrintID = G.Reference
         FROM  Udb_Grouping G,
               TFMS_CardToObject AO,
               SOA_Job J
         WHERE AO.Card = :Card AND
               AO.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.MemberType IN (SELECT Type
                              FROM   Udb_ExtendedType
                              WHERE  SuperType = :Type$Switch) 
         BEGIN
            IF k = 0 THEN
               EquipList = '(' + varchar(FeederEquip[i].Equip);
               k = 1;
            ELSE
               EquipList = EquipList + ',' + varchar(FeederEquip[i].Equip);
            ENDIF;
            i = i + 1;
         END;
         IF EquipList = '' AND JobsInBank.LastRow() = 0 THEN /* No equip on feeder and no outstanding ground moves*/
            RETURN PU_OK;
         ELSE
            EquipList = EquipList + ')';
         ENDIF;  

     ELSEIF Application = Application$SDS THEN 
      
         JobsInBank.Clear();
         IF EquipList = '' THEN
         /*
         ** Create an valve list for all objects linked to this card.
         ** First Valves that are common to more than one main, then street valves
         ** that have had moves added to the current card in case the valve appears
         ** on another card.  Some valves will appear in both lists.
         */
            i = 0;
            k = 0;
            EquipList = '';
   
            REPEATED
            SELECT DISTINCT
                  :i = G.Member
            FROM  Udb_Grouping G,
                  SOA_ActiveObject AO,
                  SOA_Job J
            WHERE AO.Card = :Card AND
                  AO.ObjectToCardLink = :TRUE AND
                  AO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType IN (SELECT Type
                              FROM   Udb_ExtendedType
                              WHERE  SuperType = :Type$Valve) AND
                  G.Member = J.Equip
            BEGIN
               IF k = 0 THEN
                  EquipList = '(' + varchar(i);
                  k = 1;
               ELSE
                  EquipList = EquipList + ',' + varchar(i);
               ENDIF;
            END;

            REPEATED
            SELECT DISTINCT :i = J.Equip
            FROM  SOA_Job J,
                  SOA_JobControl JC
            WHERE JC.Card = :Card AND
                  JC.Job = J.Job AND
               ((JC.StepPair = :StepHeading$BoxedValve) OR 
                  (J.TOComplete IS NULL OR J.RSComplete IS NULL)) AND
                  J.Equip > :Object$NULL AND
                  J.MoveCategory = :MoveCategory$Normal AND  /*Ignore Item Headings*/
                  J.Status IN ('', :JobStatus$NIS)
            BEGIN
            IF k = 0 THEN
               EquipList = '(' + varchar(i);
               k = 1;
            ELSE
               EquipList = EquipList + ',' + varchar(i);
            ENDIF;
            END;
   
            IF EquipList = '' THEN /* No equip moves */
               RETURN PU_OK;
            ELSE
               EquipList = EquipList + ')';
            ENDIF; 
         ENDIF;
      ELSEIF Application = Application$DSO THEN 

         IF EquipList = '' THEN
         /*
         ** Create an equipment list for all structures linked to this card.
         */
            i = 0;
            k = 0;
            EquipList = '';
   
            REPEATED
            SELECT DISTINCT
                  :i = G.Member
            FROM  Udb_Grouping G,
                  SOA_ActiveObject AO,
                  SOA_Job J
            WHERE AO.Card = :Card AND
                  AO.Object = G.Grouping AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType IN (SELECT Type
                              FROM   Udb_ExtendedType
                              WHERE  SuperType = :Type$DielectricEquipment) AND
                  G.Member = J.Equip
            BEGIN
               IF k = 0 THEN
                  EquipList = '(' + varchar(i);
                  k = 1;
               ELSE
                  EquipList = EquipList + ',' + varchar(i);
               ENDIF;
            END;
            IF EquipList = '' THEN /* No equip moves */
               RETURN PU_OK;
            ELSE
               EquipList = EquipList + ')';
            ENDIF; 
         ENDIF;
      ENDIF;
/* 
** Find all moves based on equipment list for current card type 
*/
      DynamicWhereClause = 
          'J.Equip IN ' + EquipList + ' AND ' +
          '(JC.SwitchingItem = 0 OR ' +
          '(JC.SwitchingItem <> 0 AND ' +
          'J.SWItemStatus = ' + varchar(Card$Active) + ')) AND ' +
          '((JC.StepPair = ' + varchar(StepHeading$BoxedValve)+ ') OR ' +
          '(J.ToComplete IS NULL OR ' +
          'J.RSComplete IS NULL)) AND ' +
          'J.Status IN ('' '', ''NIS'') AND ' +
          'J.MoveCategory = ' + varchar(MoveCategory$Normal) + ' AND ' +
          'J.Job = JC.Job AND ' +
          'JC.Card = AC.Card AND ' +
          'JC.Card <> ' + varchar(Card) + ' AND ' +
          'JC.Card <> ' + varchar(NIS$Card) + ' AND ' +
          'JCC.TypeOfCard = ' + varchar(TypeOfCard) + ' AND ' +
          'JCC.JobClass = J.JobClass AND ' +
          'JCC.PreferredStep = 1 AND ' +  
          'J.EquipClass IN (SELECT Type ' +
                           'FROM   Udb_ExtendedType ' +
                           'WHERE  SuperType = JCC.EquipClass)';
       
      SELECT DISTINCT
           OutstandingMoves[x].Seq = JC.Seq,
           OutstandingMoves[x].Job = J.Job,
           OutstandingMoves[x].Equip = J.Equip,
           OutstandingMoves[x].JobClass = J.JobClass,
           OutstandingMoves[x].TOIssued = J.TOIssued,
           OutstandingMoves[x].RSIssued = J.RSIssued,
           OutstandingMoves[x].TOComplete = J.TOComplete,
           OutstandingMoves[x].RSComplete = J.RSComplete,
           OutstandingMoves[x].Card = :Card,  /* We are not inserting into a shadow item */
           OutstandingMoves[x].Substation = J.Substation,   /* so Initiating card is not important */
           JobControlList[x].Card = :Card,
           JobControlList[x].MoveEquipClass = JCC.EquipClass,
           JobControlList[x].StepHeading = JCC.StepPair,
           JobControlList[x].StepLevel = 0,
           JobControlList[x].SwitchingItem = 0,
           JobControlList[x].PrintID = '',
           JobControlList[x].TypeOfCard = JCC.TypeOfCard,
           JobControlList[x].Application = :Application 
      FROM  FMS_JobClassControl JCC,
            SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard AC
      WHERE :DynamicWhereClause
      BEGIN 
         x = x + 1;
      END;
   ENDIF;
/* 
** There were outstanding moves to insert into the card / switching item
*/
   PreviousJob = 0;
   IF OutstandingMoves.LastRow() > 0 THEN  
      /*
      **  Insert Control entries on this card for outstanding 
      **  moves and remove any jobs that are duplicated.
      */  
      i = 1;
      LastRow = OutstandingMoves.LastRow();
      WHILE i <= LastRow DO
         k = 1;
         JobLastRow = Jobs.LastRow();
         WHILE k <= JobLastRow DO
            IF Jobs[k].JobClass = OutstandingMoves[i].JobClass AND
               Jobs[k].Equip = OutstandingMoves[i].Equip THEN   
/*  
** If this is an outstanding ET Stop Tag move, do not delete the loaded copy
*/                
               ETStopTagMove = 0;
               SELECT :ETStopTagMove = IFNULL(JA.Status,0)
               FROM   SOA_Job J,
                      Udb_ExtendedType ET,
                      FMS_JobAction JA
               WHERE  J.Job = :Jobs[k].Job AND
                      J.EquipClass = ET.Type AND
                      ET.SuperType = :Type$ET AND
                      J.JobClass = JA.JobClass AND
                      JA.Status = :Prompt$StopTag;  
               
               IF ETStopTagMove = 0 THEN
               RetCode = CALLPROC SOA_JobDel (Job = Jobs[k].Job);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
                               'ERROR: Unable to remove duplicate job. ' +
                               'Have tech support review ' +
                               'trace log.',
                           TraceMessage =
                               'Job;LoadOutstandingMoves;  Unable to remove ' +
                               'duplicate job:(' + varchar(Jobs[k].Job) + 
                               ').  Stray move left in SOA_Job and SOA_JobControl table.'
                                );
                  RETURN PU_CANCEL;
               ENDIF
               ENDIF;
               CALLPROC DDB_COMMIT;
               /* 
               **  Remove this row from array in case there are 
               **  multiple moves with the same jobclass.
               */
               Jobs.RemoveRow (RowNumber = k);
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
/*
** Scroll through FeederEquip to apply PrintID before control insertion.
*/
         FOR k = 1 TO FeederEquip.LastRow() DO
            IF OutstandingMoves[i].Equip = FeederEquip[k].Equip THEN
               JobControlList[i].PrintID = FeederEquip[k].PrintID;
            ENDIF;
         ENDFOR;
/*
** Since jobs may appear on more than one card, add final duplicate prevention
** step here
*/
         IF PreviousJob <> OutstandingMoves[i].Job THEN
            /* Is move on ET Secret Card? */
            ETSecretCard = 0;
            SELECT :ETSecretCard = Card
            FROM   SOA_JobControl
            WHERE  Card = 10001 AND
                   Job = :OutstandingMoves[i].Job;
                   
            RetCode = OutstandingMoves[i].InsertControl (
                  ControlEntry = JobControlList[i],
                  InitiatingCard = OutstandingMoves[i].Card,
                  SingleFeederOnly = SingleFeederOnly);
            IF RetCode = PU_CANCEL THEN
               CALLPROC TraceError (UserMessage = 
                               'ERROR: Unable to insert job control entry for outstanding move.' +
                               '  Have tech support review ' +
                               'trace log.',
                           TraceMessage =
                               'Job;LoadOutstandingMoves;  Unable to ' +
                               'insert control entry for outstanding jobs.'
                               );
               RETURN PU_CANCEL;
            ENDIF; 
            CALLPROC DDB_COMMIT;
            /* Delete move from Secret ET Card if it exists there, already have a lock on SOA_JobControl.
               Update Activity Identifier and Control Card. Send Reload Job event. */
            IF ETSecretCard > 0 THEN
               RetCode = CALLPROC SOA_JobControlDel (Card = ETSecretCard, Job = OutstandingMoves[i].Job);
               IF RetCode < 0 THEN 
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
                               'ERROR: Unable to delete saved ET move.' +
                               '  Report Bug for tech support to review ' +
                               'trace log so record can be manually deleted.',
                           TraceMessage =
                               'Job;LoadOutstandingMoves;  Unable to delete saved ET move ' +
                               'from SOA_JobControl.  Card=10001, Job=' + VARCHAR(OutstandingMoves[i].Job)
                               );
               ENDIF;
               
               RetCode = CALLPROC SOA_JobControlCardUpd (
                          Job = OutstandingMoves[i].Job,
                          Card = OutstandingMoves[i].Card);
               IF RetCode < 0 THEN /* Don't care, can be reset from front of card */
               ENDIF;
               
               RetCode = CALLPROC SOA_JobActivityIDUpd (Job = OutstandingMoves[i].Job, ActivityIdentifier = '');
               IF RetCode < 0 THEN /* Don't care, can be reset from front of card */
               ENDIF;
               
               ControlText = UserName + ';' + VARCHAR(OutstandingMoves[i].Job) + ';';
               CALLPROC DDB_RAISEDBEVENT ( DBEventName = 'SOA_ReloadJob', 
                                        DBEventText = ControlText);
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
         PreviousJob = OutstandingMoves[i].Job;
         i = i + 1;
      ENDWHILE;
/*
** Remove jobs from the job bank
*/
      FOR i = 1 to JobsInBank.LastRow() DO
         GroundCount = 0;
         SELECT :GroundCount = OS.StatusCount
         FROM   SOA_Job J,
                FMS_ObjectStatus OS
         WHERE  J.Job = :JobsInBank[i].Value AND
                J.Equip = OS.Object AND
                OS.Status = :Status$Ground;

         RetCode = CALLPROC FMS_PickupJob                       
                         (Job = JobsInBank[i].Value,
                          ReplacedJob = 0,
                          Card = Card,
                          GroundCount = GroundCount);
         IF RetCode < 0 THEN 
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
            'ERROR: Unable to delete outstanding job from dropped bank. ' +
            'Have tech support review ' +
            'trace log.',
                          TraceMessage =
            'Job;LoadOutstandingMoves; ' +
            'Error deleting outstanding job from the dropped job bank.'
            );
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;   
      ENDFOR;	
   ENDIF;
   RETURN PU_OK;
END;

METHOD InsertControl (
   ControlEntry         = NewMoveCard;          /*Job Control Entry*/
   InitiatingCard	= INTEGER NOT NULL;	/* Card ID */
   TransferFlag         = INTEGER NOT NULL WITH DEFAULT; /*Optional Flag*/
   SingleFeederOnly     = INTEGER NOT NULL WITH DEFAULT; /*Optional Flag*/
) =
DECLARE
   EquipBaseType        = INTEGER NOT NULL;     /*Looking for ACLineSeg*/
   i 			= INTEGER NOT NULL WITH DEFAULT; /* Counter */
   FeederAction         = INTEGER NOT NULL WITH DEFAULT; /*JobActions BOOLEAN*/
   ISWP                 = INTEGER NOT NULL WITH DEFAULT; 
   J                    = ARRAY OF Job;  /*Needed for conversion*/
   JIP			= JobInProgress; /*Needed for conversion*/
   JobControlExist     = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   LineAction           = INTEGER NOT NULL WITH DEFAULT; /*JobActions BOOLEAN*/
   MultikV              = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   Permits              = ARRAY OF INTEGEROBJECT;         /*Used to copy protection moves*/
   Permit               = WorkPermit DEFAULT NULL;        /*SDS Work Permit*/
   PermitStation        = SDS_Station DEFAULT NULL;       /*SDS Work Permit*/
   RetCode		= INTEGER NOT NULL WITH DEFAULT; /* Return Code */
   StepHeadingExist     = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   StepHeadingJob       = INTEGER NOT NULL WITH DEFAULT; /*Return Code*/
   StepHeadingText      = VARCHAR(80) NOT NULL WITH DEFAULT; /*Heading Text*/
   StationAction        = INTEGER NOT NULL WITH DEFAULT; /*JobActions BOOLEAN*/
   SubstationExist      = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   SubstationJob        = INTEGER NOT NULL WITH DEFAULT; /*Return Code*/
   SubstationText       = VARCHAR(60) NOT NULL WITH DEFAULT; /*Heading Text*/
BEGIN
/*
** Individual control entries inserted here:
**          - does the move's step heading exist on the card (SLC, TMFS)?  If
**            not insert the step heading.
**          - does the move's substation heading (TFMS or SLC Multiple kV) exist
**            on the card?  If not insert the substation heading.  For SDS Sole
**            Authority, insert Main step Heading
**          - Insert the SOA_JobControl entry for the move.
**
*/
   IF ControlEntry.SwitchingItem = 0 AND 
        ControlEntry.Application = Application$SLC THEN
/*
** ACLineSegment moves do not belong on every substation card.
** Is the device an ACLineSegment?
*/
      EquipBaseType = FALSE;
      SELECT :EquipBaseType = :TRUE
      FROM   Udb_ExtendedType  
      WHERE  Type = :CurObject.EquipClass AND
             SuperType = :Type$ACLineSegment;   

      IF EquipBaseType = TRUE THEN
/*
** Is the ACLineSeg move defined for this station?
*/
         EquipBaseType = FALSE;
         SELECT  :EquipBaseType = :TRUE
         FROM    SOA_ActiveObject
         WHERE   Object = :CurObject.Substation AND
                 ObjectToCardLink = 1 AND       
                 Card = :ControlEntry.Card;

         IF EquipBaseType = FALSE THEN
/*
** Move not intended for this substation, skip it and return
*/
            RETURN PU_OK;
         ENDIF;
      ENDIF;   
/*
** Now determine switching item where the move belongs if known.
** Look for move on this equipment in an existing and active switching item.         
*/
      REPEATED
      SELECT :ControlEntry.SwitchingItem = IFNULL(JC.SwitchingItem,0)
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :ControlEntry.Card AND               
             JC.Job = J.Job AND
             J.Equip = :CurObject.Equip AND
             J.Status IN ('', :JobStatus$NIS) AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.SwItemStatus = :Card$Active;
/*
** If still not known, move shall be added to Shadow Switching Item
*/
      IF ControlEntry.SwitchingItem = 0 THEN
         
         REPEATED
         SELECT  :ControlEntry.SwitchingItem =
                         IFNULL(JC.SwitchingItem,0)
         FROM   SOA_JobControl JC,
                SOA_Job J
         WHERE  JC.Card = :ControlEntry.Card AND
                JC.Job = J.Job AND
                J.ShadowLink = :InitiatingCard; 

         IF ControlEntry.SwitchingItem = 0 THEN
            CALLPROC DDB_ROLLBACK;
            RETURN PU_OK;
/*
** Stop printing this message.  In certain situations, a potential shared
** move should not be inserted into SLC (shadow item may not exist since
** card is not cutout). Found this issue during 3G development.
*
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to find switching item for common move. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to find ' +
             'switching item for common move ' + 
             'insertion.  New Move Insert failed.'
             );
            RETURN PU_CANCEL;
*/
         ENDIF;
      ENDIF;
   ENDIF;
/*
** Now see if step heading exists. Will have to insert if it does not.
** The Application is FMS/SDS, we may be inserting a Step Heading during Preload,
** so we check for that first.
*/             
   StepHeadingExist = FALSE;
   IF (ControlEntry.Application = Application$FMS OR 
       ControlEntry.Application = Application$SDS) AND 
       CurObject.MoveCategory = MoveCategory$StepHeading THEN
      StepHeadingExist = TRUE;
   ELSEIF ControlEntry.Application = Application$DSO THEN 
      StepHeadingExist = TRUE;
   ELSE
      SELECT :StepHeadingExist = 1 
      FROM   SOA_JobControl
      WHERE  Card = :ControlEntry.Card AND
             SwitchingItem = :ControlEntry.SwitchingItem AND
             StepPair = :ControlEntry.StepHeading;
   ENDIF;

   IF StepHeadingExist = FALSE THEN

      SELECT  :StepHeadingText = Name
      FROM    FMS_StepPair
      WHERE   StepPair = :ControlEntry.StepHeading AND
              TypeOfCard = :ControlEntry.TypeOfCard;

      IF StepHeadingText = '' THEN
         StepHeadingText = 'Job;InsertControl; ' + 
                       'Step Heading text not found.'; 
      ENDIF;

      StepHeadingJob = CALLPROC SOA_JobIns (
	  Card            = ControlEntry.Card 
	, Job             = -1
	, Equip           = 0
        , Status          = ''
	, JobClass        = 0
	, EquipName       = ''
	, EquipClass      = 0
	, EquipClassName  = ''
	, MoveType        = ''
	, TOMove          = StepHeadingText
	, TOMoveRules     = 0
        , RSMove          = StepHeadingText
        , RSMoveRules     = 0
	, Substation      = 0
        , MoveCategory    = MoveCategory$StepHeading
	, TypeGround      = Status$Ground
	);

      IF StepHeadingJob < 0 THEN
         CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert step heading. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to insert step heading ' +
             'for new move.  Stray move left in SOA_Job. ' 
             );
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RetCode = CALLPROC SOA_JobControlIns (
          Card            = ControlEntry.Card
        , Job             = StepHeadingJob
        , SwitchingItem   = ControlEntry.SwitchingItem
	, StepPair        = ControlEntry.StepHeading 
        );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert step heading control. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to insert step heading ' +
             'control for new move.  Stray move left in SOA_Job. ' 
             );
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;

   ENDIF;
/*
** IF SLC, Are we dealing with a multiple kV level substation.
** IF SDS, Are we dealing with a Sole Authoritymay have multiple Mains
*/
   IF ControlEntry.Application = Application$SLC THEN
      SELECT :MultikV = MultiplekVFlag
      FROM   SLC_Card
      WHERE  Card = :ControlEntry.Card;
   ENDIF;
/*
** Comment out to see what no substation headings looks like on Steam card 
** If we leave this commented out past 10/05/07, then all code related to substation
** headings for SDS type cards can be removed.
   IF ControlEntry.Application = Application$SDS THEN
      SELECT :MultikV = SoleAuthority
      FROM   SDS_Card
      WHERE  Card = :ControlEntry.Card;
   ENDIF;
*/
/*
** If Step Level not set for TFMS or SLC Multi kV, figure out what it should be.
** Then look on card, does the substation heading exist? 
** If not, insert it, just like the StepHeading.
*/
   IF ControlEntry.Application = Application$TFMS OR 
       (ControlEntry.Application = Application$SLC AND MultikV = TRUE ) OR 
       (ControlEntry.Application = Application$SDS AND MultikV = TRUE AND
        CurObject.MoveCategory = MoveCategory$Normal) THEN

      IF ControlEntry.StepLevel = 0 THEN

         IF ControlEntry.Application = Application$TFMS THEN

            IF CurObject.Substation <> 0 AND UserRole <> Role$DSO THEN
  
               REPEATED
               SELECT :ControlEntry.StepLevel = CTO.Seq,
                      :SubstationText = '      ' + O.Description + ' Substation'
               FROM   TFMS_CardToObject CTO, 
                      Udb_Object O
               WHERE  CTO.Card = :ControlEntry.Card AND
                      CTO.Object = :CurObject.Substation AND
                      CTO.Object = O.Object;
            ELSE
               IF UserRole = Role$DSO THEN 
                  ControlEntry.StepLevel = 0;
               ELSE
/*
** Force a new sequence number for moves not impacting 
** a particular substation
*/
                  SELECT :ControlEntry.StepLevel = MAX(Seq) + 1
                  FROM   TFMS_CardToObject 
                  WHERE  Card = :ControlEntry.Card;
                  SubstationText = '         FIELD WORK';
               ENDIF;
            ENDIF;

         ELSEIF ControlEntry.Application = Application$SLC THEN

            REPEATED
            SELECT :ControlEntry.StepLevel = INT4(G.Reference),
                   :SubstationText = '      ' + O.Description + ' Substation' 
            FROM   Udb_Grouping G,
                   Udb_Object O
            WHERE  G.Member = :CurObject.Substation AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.GroupingType = :Type$MacroSubstation AND
                   G.Member = O.Object;

         ELSEIF ControlEntry.Application = Application$SDS THEN

            IF CurObject.Substation <> 0 THEN

               ControlEntry.StepLevel = 0;
               SELECT :ControlEntry.StepLevel = Seq,
                      :SubstationText = '          ' + MainName + ' MAIN' 
               FROM   SDS_CardMain
               WHERE  Main = :CurObject.Substation AND
                      Card = :ControlEntry.Card;
/*
** If the main is not associated to the card, we are likely inserting a common valve move.
** We take the valve, associate it to a main on this card, and put it in that heading.
** The "S" will be inserted in the DB Procedure.
*/
               IF ControlEntry.StepLevel = 0 THEN
                  REPEATED
                  SELECT :ControlEntry.StepLevel = CM.Seq,
                         :SubstationText = '          ' + CM.MainName + ' MAIN' 
                  FROM   SDS_CardMain CM,
                         Udb_Grouping G
                  WHERE  G.Member = :CurObject.Equip AND
                         G.Relationship = :Interaction$MemberOf AND
                         G.Grouping = CM.Main AND
                         CM.Card = :ControlEntry.Card; 
               ENDIF;

            ENDIF;

            IF CurObject.Substation = 0 OR 
                    (CurObject.Substation <> 0 AND ControlEntry.StepLevel = 0) THEN
               ControlEntry.StepLevel = 20; /*Default to number higher than max existing mains*/
               SubstationText = '        Other Street or Station Work';
            ENDIF;

         ENDIF;

         IF ControlEntry.StepLevel = 0 AND UserRole <> Role$DSO THEN
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to establish proper substation heading ' +
             'sequencing.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to establish ' +
             'proper substation heading sequencing .  Move ' +
             'sequencing for card ' + VARCHAR(ControlEntry.Card) +
             ' is questionable.'
             );
         ENDIF;
      ENDIF;         

      SubstationExist = FALSE;
      SELECT :SubstationExist = 1 
      FROM   SOA_JobControl JC
      WHERE  Card = :ControlEntry.Card AND
             SwitchingItem = :ControlEntry.SwitchingItem AND
             StepPair = :ControlEntry.StepHeading AND
             StepLevel = :ControlEntry.StepLevel;
 
      IF SubstationExist = FALSE AND UserRole <> Role$DSO THEN

         IF SubstationText = '' THEN

            SELECT :SubstationText = '      ' + Description + ' Substation' 
            FROM   Udb_Object 
            WHERE  Object = :CurObject.Substation; 

         ENDIF;

         SubstationJob = CALLPROC SOA_JobIns (
	  Card            = ControlEntry.Card 
	, Job             = -1
	, Equip           = 0
        , Status          = ''
	, JobClass        = 0
	, EquipName       = ''
	, EquipClass      = 0
	, EquipClassName  = ''
	, MoveType        = ''
	, TOMove          = SubstationText
	, TOMoveRules     = 0
        , RSMove          = SubstationText
        , RSMoveRules     = 0
	, Substation      = CurObject.Substation
        , MoveCategory    = MoveCategory$SubstationHeading
	, TypeGround      = Status$Ground
	);

         IF SubstationJob < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert substation heading. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to insert ' +
             'substation heading for ' +
             VARCHAR(ControlEntry.Card) + '.'
             );
            RETURN PU_CANCEL;
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_JobControlIns (
          Card            = ControlEntry.Card
        , Job             = SubstationJob
        , SwitchingItem   = ControlEntry.SwitchingItem
	, StepPair        = ControlEntry.StepHeading 
        , StepLevel       = ControlEntry.StepLevel
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert substation heading control. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to insert ' +
             'substation heading job control for ' +
             VARCHAR(ControlEntry.Card) + '. Stray job in SOA_Job'
             );
            RETURN PU_CANCEL;
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

   ENDIF;
/*
** FINALLY - Now insert control entry for the move.
** Double check that move doesn't already exist on card, may exist on 3G
** If it exists, just do clean return.
*/ 
   JobControlExist = 0;
   SELECT :JobControlExist = Job
   FROM   SOA_JobControl
   WHERE  Card = :ControlEntry.Card AND
          Job = :CurObject.Job AND
          SwitchingItem = :ControlEntry.SwitchingItem;

   IF JobControlExist > 0 THEN
      RETURN PU_OK;
   ENDIF;

   RetCode = CALLPROC SOA_JobControlIns (
          Card            = ControlEntry.Card
        , Seq             = ControlEntry.Seq
        , Job             = CurObject.Job
        , PrintID         = ControlEntry.PrintID
        , SwitchingItem   = ControlEntry.SwitchingItem
	, StepPair        = ControlEntry.StepHeading 
        , StepLevel       = ControlEntry.StepLevel
        , MoveEquipClass  = ControlEntry.MoveEquipClass
        );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert job control. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to insert ' +
             'job control for ' +
             VARCHAR(ControlEntry.Card) + '. Stray job in SOA_Job'
             );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Now this move is part of the switchingitem.
*/
   CurObject.SwitchingItem = ControlEntry.SwitchingItem;
/* 
** IF Dead Move inserted into an FMS Card, update the Dead Move count.
*/
   IF ControlEntry.Application = Application$FMS AND
           CurObject.MoveType = 'Dead' THEN

      RetCode = CALLPROC FMS_DeadMoveCount (
                  Card = ControlEntry.Card);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'Warning: Unable to update dead move count. ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'Job;InsertControl; Unable to update dead move count for  ' +
             VARCHAR(ControlEntry.Card) + '.'
             );
      ENDIF;
      CALLPROC DDB_COMMIT;

   ENDIF;
/*
** Check if a duplicate of a protection move.  Ignore TLS.
** Don't copy protections to N moves.
*/
   i = 1;
   Permits.Clear();

   IF CurObject.MoveCategory <> MoveCategory$Fake AND CurObject.Equip <> 0 THEN
      REPEATED
      SELECT DISTINCT
              :Permits[i].Value = J2.Job
      FROM    SOA_Job J1,
              SOA_Job J2,
              FMS_WorkPermitProtection WPP
      WHERE   J1.Equip = :CurObject.Equip AND
              J1.Job <> :CurObject.Job AND
              J1.JobClass = :CurObject.JobClass AND
              J1.Job = WPP.ProtectionJobID AND
              WPP.PermitJobID = J2.Job AND
              J2.Status IN ('', :JobStatus$NIS) AND
              J2.RSComplete IS NULL
      BEGIN
         ISWP = 0;
         SELECT :ISWP = ISPermit
         FROM   SOA_InServicePermit
         WHERE  Job = :Permits[i].Value;
 
         IF ISWP = 0 THEN
            i = i + 1;
         ELSE
            Permits.RemoveRow (rownumber = i);  /* Exclude InService Permits */
         ENDIF;
      END;
   ENDIF;

   FOR i = 1 TO Permits.LastRow() DO
       RetCode = CALLPROC FMS_ApplyProtection (
                     PermitCardType = 0,
                     PermitCard = 0,
                     PermitJob = Permits[i].Value,
                     ProtectionCardType = 0,
                     ProtectionCard = 0,
                     ProtectJob = CurObject.Job);

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to copy make a copy of a protection move.  ' +
             'Evaluate your Permit protection move links.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'Unable to copy a work permit protection move link.' 
             );
      ENDIF;
   ENDFOR;
/*
** IF Work Permit inserted into an SDS Card, perform WP number generation process
*/
   IF ControlEntry.Application = Application$SDS AND
      ControlEntry.StepHeading = StepHeading$WorkPermit AND 
      CurObject.MoveCategory = MoveCategory$Normal THEN
 
      Permit = NULL;
      Permit = WorkPermit.Create();
      Permit.PermitJobID = CurObject.Job;

      PermitStation = NULL;
      PermitStation = SDS_Station.Create();

      SELECT :PermitStation.Station = Station
      FROM   SDS_Card
      WHERE  Card = :ControlEntry.Card;

      RetCode = PermitStation.GetPermitID();

      IF RetCode = 0 THEN
         Permit.Description = PermitStation.NextPermitID;
         Permit.ProtectionRequired = FALSE;
         
         RetCode = Permit.UpdateWorkPermit (PermitJobID = Permit.PermitJobID);
         /* Ignore RetCode */

         CurObject.Response = PermitStation.NextPermitID;
         CurObject.ResponseUpd(); 
      ENDIF;
   ENDIF;
/*
** If move has TO/RS issued/completed, then we need to perform outstanding  
** job actions for the card where it is being inserted.  
*/
   IF (CurObject.TOIssued IS NOT NULL AND CurObject.TOIssued <> '') OR
      (CurObject.RSIssued IS NOT NULL AND CurObject.RSIssued <> '') THEN

      StationAction = TRUE;
      FeederAction = TRUE;
      LineAction = TRUE;
      IF ControlEntry.Application = Application$SLC THEN
         StationAction = FALSE;
      ELSEIF ControlEntry.Application = Application$TFMS THEN
         LineAction = FALSE;
      ELSEIF ControlEntry.Application = Application$FMS OR ControlEntry.Application = Application$SDS THEN
         FeederAction = FALSE;
      ENDIF;

      i = 1;   
      J[i] = CurObject.Duplicate();
#     include ConvertSingleToJobIP
      
      IF CurObject.TOIssued IS NOT NULL AND CurObject.TOIssued <> '' THEN
         JIP.Status = Job$TakeOut;
         RetCode = JIP.JobActions (IssueCompl = JobClass$Issue,
                                   NoEquipSt = TRUE,
                                   NoPrompts = TRUE,
                                   NoOperSt  = TRUE,
                                   NoLineSt  = LineAction,
                                   NoFeederSt = FeederAction,
                                   NoStatSt  = StationAction,
                                   SingleFeederOnly = SingleFeederOnly); 
         IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage = 
             'WARNING: TakeOut Issue JobActions unsuccessful for ' +
             'outstanding move insertion.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'TakeOut Issue JobActions unsuccessful for ' +
             'outstanding move insertion.'
             );
         ENDIF;
      ENDIF;
                 
      IF CurObject.TOComplete IS NOT NULL AND CurObject.TOComplete <> '' THEN
         JIP.Status = Job$TakeOut;
         RetCode = JIP.JobActions (IssueCompl = JobClass$Complete,
                                   NoEquipSt = TRUE,
                                   NoPrompts = TRUE,
                                   NoOperSt  = TRUE,
                                   NoLineSt  = LineAction,
                                   NoFeederSt = FeederAction,
                                   NoStatSt  = StationAction,
                                   SingleFeederOnly = SingleFeederOnly); 
         IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage = 
             'WARNING: TakeOut Complete JobActions unsuccessful for ' +
             'outstanding move insertion.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'TakeOut Complete JobActions unsuccessful for ' +
             'outstanding move insertion.'
             );
         ENDIF;
      ENDIF;
                 
      IF CurObject.RSIssued IS NOT NULL AND CurObject.RSIssued <> '' THEN
         JIP.Status = Job$Restore;
         RetCode = JIP.JobActions (IssueCompl = JobClass$Issue,
                                   NoEquipSt = TRUE,
                                   NoPrompts = TRUE,
                                   NoOperSt  = TRUE,
                                   NoLineSt  = LineAction,
                                   NoFeederSt = FeederAction,
                                   NoStatSt  = StationAction,
                                   SingleFeederOnly = SingleFeederOnly); 
         IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage = 
             'WARNING: Restore Issue JobActions unsuccessful for ' +
             'outstanding move insertion.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'Restore Issue JobActions unsuccessful for ' +
             'outstanding move insertion.'
             );
         ENDIF;
      ENDIF;
                 
      IF CurObject.RSComplete IS NOT NULL AND CurObject.RSComplete <> '' THEN
         JIP.Status = Job$Restore;
         RetCode = JIP.JobActions (IssueCompl = JobClass$Complete,
                                   NoEquipSt = TRUE,
                                   NoPrompts = TRUE,
                                   NoOperSt  = TRUE,
                                   NoLineSt  = LineAction,
                                   NoFeederSt = FeederAction,
                                   NoStatSt  = StationAction,
                                   SingleFeederOnly = SingleFeederOnly); 
         IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage = 
             'WARNING: Restore Complete JobActions unsuccessful for ' +
             'outstanding move insertion.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'Restore Complete JobActions unsuccessful for ' +
             'outstanding move insertion.'
             );
         ENDIF;
      ENDIF;
                 
   ENDIF;
/*
** Record in log only if new move, not a transferred move.
*/
   IF TransferFlag = TRUE THEN
      RETURN PU_OK;
   ELSE
      RetCode = CALLPROC SOA_LogIns (
          Card            = ControlEntry.Card
        , Job             = CurObject.Job
        , SwitchingItem   = ControlEntry.SwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'New Move'
        , New             = 'Move Inserted'
        );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to insert log entry for new move.',
                           TraceMessage =
             'Job;InsertControl; ' +
             'Unable to insert log' +
             ' entry indicating new move had been inserted.'
             );
      ENDIF;
      CALLPROC DDB_COMMIT;

      RETURN PU_OK;
   ENDIF;
END;


METHOD DeleteJob (
   ImpactedCardList = ARRAY OF INTEGEROBJECT; /*List of cards for move */
) =
DECLARE
   CurApplication   = VARCHAR(10) NOT NULL WITH DEFAULT;
   RetCode          = INTEGER NOT NULL WITH DEFAULT;
   i                = INTEGER NOT NULL WITH DEFAULT;
   j                = INTEGER NOT NULL WITH DEFAULT;
   LogList          = ARRAY OF Job; /*List of cards where delete logged*/
BEGIN
/*
** Deletes the move by setting the status to 'Del'.  
*/   
   RetCode = CALLPROC SOA_JobStatusUpd (Job = CurObject.Job,
                                        Status = 'Del');
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to mark move as deleted.',
                           TraceMessage =
             'Job;DeleteJob1; ' +
             'Unable to set Job Status to deleted for Job=' +
             VARCHAR(CurObject.Job) + '.' 
             );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC SOA_LogIns (
                    Card            = CurObject.Card
                  , Job             = CurObject.Job
                  , SwitchingItem   = CurObject.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'Move Deleted'
                  , Old             = CurObject.TOMove + ' - ' +
                                      CurObject.RSMove
                  );

   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to insert log entry for deleted move.',
                           TraceMessage =
             'Job;DeleteJob2; ' +
             'Unable to insert log entry for deleted job =' +
             VARCHAR(CurObject.Job) + '.' 
             );
   ENDIF;
   CALLPROC DDB_COMMIT;
/* 
** IF Dead Move deleted from an FMS Card, update the Dead Move count.
*/
   CurApplication = '';
   SELECT  :CurApplication = Application
   FROM    SOA_Card 
   WHERE   Card = :CurObject.Card;

   IF CurApplication = Application$FMS AND
      CurObject.MoveType = 'Dead' THEN

      RetCode = CALLPROC FMS_DeadMoveCount (
                  Card = CurObject.Card);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'WARNING: Unable to update dead move count after deleted move.' +
             'Contact tech support for manual update',
                           TraceMessage =
             'Job;DeleteJob3; ' +
             'Unable to update dead move count for deleted move on Card=' +
             VARCHAR(CurObject.Card) + '.' 
             );
      ENDIF;
      CALLPROC DDB_COMMIT;

   ENDIF;
  
/* 
** delete from outage request report if a permit 
*/
   CurObject.DeleteFromOutageRequest();

/*
** Manage the Impacted Card List
*/
   LogList.Clear();
   i = 1;
   SELECT :LogList[i].Card = Card
         ,:LogList[i].SwitchingItem = SwitchingItem
   FROM   SOA_JobControl
   WHERE  Job = :CurObject.Job
   BEGIN
      j = 1;
      WHILE j<= ImpactedCardList.LastRow() DO
         IF LogList[i].Card = ImpactedCardList[j].Value THEN
               ENDLOOP;   
         ENDIF;
         j = j + 1;
      ENDWHILE;
/*
** Add Card if not already in the list.
*/
      IF j = (ImpactedCardList.LastRow() + 1) THEN
         ImpactedCardList.InsertRow (rownumber = j);
         ImpactedCardList[j].Value = LogList[i].Card;
      ENDIF; 
       
      i = i + 1;
   END;
              
   RETURN PU_OK;
   
END;


METHOD FilterJob (
   ImpactedCardList = ARRAY OF INTEGEROBJECT; /*List of cards for move */
   NewStatus = CHAR(3) NOT NULL WITH DEFAULT; /*New status for filtered jobs*/
) =
DECLARE
   RetCode          = INTEGER NOT NULL WITH DEFAULT;
   i                = INTEGER NOT NULL WITH DEFAULT;
   j                = INTEGER NOT NULL WITH DEFAULT;
   LogList          = ARRAY OF Job; /*List of cards where delete logged*/
BEGIN
/*
** Filter the move by setting the status.  
*/   
   RetCode = CALLPROC SOA_JobStatusUpd (Job = CurObject.Job,
                                        Status = NewStatus);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to mark move as filtered/unfiltered.',
                           TraceMessage =
             'Job;FilterJob; ' +
             'Unable to set Job Status to filtered/unfiltered for Job=' +
             VARCHAR(CurObject.Job) + '.' 
             );
      RETURN PU_CANCEL;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Manage  the Impacted Card List
*/
   LogList.Clear();
   i = 1;
   SELECT :LogList[i].Card = Card
         ,:LogList[i].SwitchingItem = SwitchingItem
   FROM   SOA_JobControl
   WHERE  Job = :CurObject.Job
   BEGIN
      i = i + 1;
   END;
/*
** Will not be logging Filter status changes.  They can be reversed.
*/              
   i = 1;    
   WHILE i <= LogList.LastRow() DO
      j = 1;
      WHILE j<= ImpactedCardList.LastRow() DO
         IF LogList[i].Card = ImpactedCardList[j].Value THEN
               ENDLOOP;   
         ENDIF;
         j = j + 1;
      ENDWHILE;
/*
** Add Card if not already in the list.
*/
      IF j = (ImpactedCardList.LastRow() + 1) THEN
         ImpactedCardList.InsertRow (rownumber = j);
         ImpactedCardList[j].Value = LogList[i].Card;
      ENDIF;        
                  
      i = i + 1;
   ENDWHILE;

   RETURN PU_OK;

END;



METHOD InsertMove (
   CardTypeOfCard    	= INTEGER NOT NULL; /*Passed TypeOfCard*/
   KeepMoveText         = INTEGER NOT NULL WITH DEFAULT; /*Optional Parm */
   KeepJobID 		= INTEGER NOT NULL WITH DEFAULT; /*Optional Parm */
) =
DECLARE
   CardStatus           = INTEGER NOT NULL WITH DEFAULT;
   EventText            = VARCHAR(255) NOT NULL WITH DEFAULT; /*DBEvent Text*/
   Idx          	= ARRAY OF INTEGEROBJECT; /* Track impacted cards */
   ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
   InsertionList        = ARRAY OF NewMoveCard; /*List of cards to insert move*/
   i 			= INTEGER NOT NULL; /*Counter*/
   k 			= INTEGER NOT NULL; /*Counter*/
   MoveTextTO           = VARCHAR(160) NOT NULL WITH DEFAULT;/*Replacement text*/
   MoveTextRS           = VARCHAR(160) NOT NULL WITH DEFAULT;/*Replacement text*/
   n 			= INTEGER NOT NULL; /*Counter*/
   PhaseMove            = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   RetCode 		= INTEGER NOT NULL; /*Return Code*/
BEGIN
/*
**  This method may or not share code with NewMoves frame.  Be wary when 
**  modifying - updates may be necessary in both places.
**  Job fields like deskname, substation, etc. must be filled in already.
*/
    IF CurObject.MoveType = MoveType$Phase THEN
       PhaseMove = TRUE;
    ELSE
       PhaseMove = FALSE;
    ENDIF;
/*
**  Optional Parm - KeepMoveText - If TRUE (default is FALSE), do not replace
**  Move Text from FMS_JobClass.
*/
    SELECT :CurObject.MoveType = MoveType, 
           :MoveTextTO = TOMove,
           :MoveTextRS = RSMove,
           :CurObject.TOMoveRules = TOMoveRules,
           :CurObject.RSMoveRules = RSMoveRules
    FROM   FMS_JobClass
    WHERE  JobClass = :CurObject.JobClass;
/*
**  Get Card/SwItem Status
*/
    IF CurObject.SwitchingItem = 0 THEN
       SELECT :CardStatus = Status
       FROM   SOA_Card 
       WHERE  Card = :CurObject.Card;
    ELSE
       SELECT :CardStatus = SwItemStatus
       FROM   SOA_Job
       WHERE  Job = :CurObject.SwitchingItem;
    ENDIF;

    IF PhaseMove = TRUE THEN
       CurObject.MoveType = MoveType$Phase;
    ENDIF;

    IF KeepMoveText = FALSE THEN
       IF CurObject.EquipName <> '' THEN
          CurObject.TOMove = MoveTextTO + ' - ' + CurObject.EquipName;
          CurObject.RSMove = MoveTextRS + ' - ' + CurObject.EquipName;
       ELSE
          CurObject.TOMove = MoveTextTO;
          CurObject.RSMove = MoveTextRS;
       ENDIF;
    ENDIF;

    CurObject.Job = CurObject.InsertJob (Card = CurObject.Card, KeepJobID = KeepJobID);

    IF CurObject.Job < 0 THEN
       RETURN CurObject.Job;
    ENDIF;
/*
**  In support of ISWP which may be created when a TFMS card is loaded,
**  we select the application here instead of using CurrentApplication.
**  This should prevent Substation heading error on insert of Job Control
**  since ISWP will go to SLC cards.
*/
    SELECT :InsertionList[1].Application = Application
    FROM   SOA_Card
    WHERE  Card = :CurObject.Card;
 
    InsertionList[1].Card = CurObject.Card;
    InsertionList[1].SwitchingItem = CurObject.SwitchingItem;
    InsertionList[1].TypeOfCard = CardTypeOfCard;
    Insertionlist[1].StepLevel = 0;
    Insertionlist[1].PrintID = CurObject.PrintID;

    REPEATED
    SELECT :InsertionList[1].StepHeading = JCC.StepPair,
           :InsertionList[1].MoveEquipClass = JCC.EquipClass
    FROM   FMS_JobClassControl JCC
    WHERE  JCC.JobClass = :CurObject.JobClass AND
      
           JCC.TypeOfCard = :CardTypeOfCard AND
           JCC.PreferredStep = :TRUE AND
           :CurObject.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                     WHERE  SuperType = JCC.EquipClass);
             
    RetCode = CurObject.InsertControl (
               ControlEntry = InsertionList[1],
               InitiatingCard = CurObject.Card);
            
    IF RetCode = PU_CANCEL THEN
       RETURN -1;
    ENDIF;      

    ImpactedCardList.Clear();  
    ImpactedCardList[1].Value = CurObject.Card; 
    IF CardStatus <> Card$Open AND CurObject.Equip <> 0 THEN
/*
**  Cascade to potential other cards
*/
      Idx.Clear();
      Idx = CALLPROC CascadeMoves (Move = CurObject,
                                      Card = CurObject.Card
                                     );

#     include ManageImpactedCards
   ENDIF;
   
#  include NotifyImpactedCards

   RETURN CurObject.Job;
END;


METHOD IssueSingleMove (

) =
DECLARE
   i		= INTEGER NOT NULL; /*Index*/
   J		= ARRAY OF Job;  /*Force into array to use convert script*/
   JIP		= ARRAY OF JobInProgress;  /*Force into array to use convert script*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT; /*Return Code*/
   SimpleJob    = JobInProgress; /*Used simply to call methods*/
BEGIN
   i = 1;
   J[i] = CurObject.Duplicate();
#  INCLUDE ConvertJobToJobInProgress

   RetCode = JIP[i].JobChecks(IssueCompl = JobClass$Issue);

   IF RetCode = PU_CANCEL THEN
      RETURN PU_CANCEL;
   ENDIF; 

   RetCode = SimpleJob.IssueMove(Job = JIP[i]);

   IF RetCode = PU_CANCEL THEN
      RETURN PU_CANCEL;
   ENDIF;

   RetCode = JIP[i].JobActions(IssueCompl = JobClass$Issue);

   IF RetCode = PU_CANCEL THEN

      RetCode = SimpleJob.CancelIssueMove(Job = JIP[i]);

      IF RetCode = PU_CANCEL THEN
         RETURN PU_CANCEL;
      ENDIF;

   ENDIF;
/*
**  If auto-complete, complete the job.
*/
   IF JIP[i].TOMoveRules = MoveRule$IAuto THEN

      RetCode = SimpleJob.CompleteMove(Job = JIP[i]);
      IF RetCode = PU_CANCEL THEN
      CALLPROC TraceError (UserMessage = 
             'AutoComplete failed, please manually complete the move.',
                           TraceMessage =
             'Job;IssueSingleMove; ' +
             'AutoComplete failed, manually complete move=' +
             VARCHAR(CurObject.Job) + '.' 
             );
         RETURN PU_CANCEL;
      ENDIF;
              
      RetCode = JIP[i].JobActions(IssueCompl = JobClass$Complete);
      IF RetCode = PU_CANCEL THEN
         
         RetCode = SimpleJob.InCompleteMove(Job = JIP[i]);
          
         IF RetCode = PU_CANCEL THEN
            CALLPROC TraceError (UserMessage = 
             'InComplete failed, please manually incomplete the move.',
                           TraceMessage =
             'Job;IssueSingleMove; ' +
             'InComplete failed, manually incomplete move=' +
             VARCHAR(CurObject.Job) + '.' 
             );
            RETURN PU_CANCEL;
         ENDIF;
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;
   RETURN PU_OK;
END;


METHOD ResponseUpd (
) =
DECLARE
   i		= INTEGER NOT NULL; /*Index*/
   OldResponse = VARCHAR(120) NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT; /*Return Code*/
BEGIN
   SELECT :OldResponse = Response
   FROM   SOA_Job 
   WHERE  Job = :CurObject.Job;
/*
** Update Job Response field and log for all cards.
*/
   RetCode = CALLPROC SOA_JobResponseUpd (
               Job = CurObject.Job,
               NewResponse = CurObject.Response);

   IF RetCode <> 0 THEN
      CALLPROC DDB_COMMIT;
/* reset value back to old response */
      CurObject.Response = OldResponse;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update move response.',
                           TraceMessage =
             'Job;ResponseUpd1; ' +
             'Unable to update move response for Job=' +
             VARCHAR(CurObject.Job) + '.' 
             );
      RETURN;
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (
                    Card            = CurObject.Card
                  , Job             = CurObject.Job
                  , SwitchingItem   = CurObject.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item            = 'Response Update'
                  , Old             = OldResponse
                  , New             = CurObject.Response
                  );

   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert log entry indicating job response ' +
             'update.',
                           TraceMessage =
             'Job;ResponseUpd2; ' +
             'Unable to insert log entry indicating move response update ' +
             'for Job=' +
             VARCHAR(CurObject.Job) + '.' 
             );
   ENDIF;

   CALLPROC DDB_COMMIT;
END;


METHOD SpareBankBkrPreload (
   Card 	= INTEGER NOT NULL
 , Equip        = ARRAY OF Equipment
 , Substation   = INTEGER NOT NULL
 , SwitchingItem = INTEGER NOT NULL WITH DEFAULT
 , TypeOfCard   = INTEGER NOT NULL WITH DEFAULT
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   CheckType    = INTEGER NOT NULL WITH DEFAULT;
   CheckLine    = INTEGER NOT NULL WITH DEFAULT;
   CheckSpareBank    = ARRAY OF INTEGEROBJECT;
   TOMove       = VARCHAR(160) NOT NULL WITH DEFAULT;
   RSMove       = VARCHAR(160) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Algorithm:
** Look for BREAKER type device in Equipment list.
** If exists, check for Line membership.
** If exists, count non-Cap Spare Bank Breaker equip in station.
** If one and only one Spare Bank Breaker device, then preload CutIn
** move for that device.
** 
** This method is called from SLC Add Open Auto and SOA New Moves when
** Bus Section work scenario is used.  When called from SLC Open Auto, it
** will automatically insert the move in the new Switching Item.  When
** called from New Moves, will pass back the move to insert.
*/
   i = 1;
   CheckSpareBank.Clear();
   WHILE i <= Equip.LastRow() DO
      CheckType = 0;
      SELECT :CheckType = ET.Type
      FROM   Udb_ExtendedType ET,
             Udb_Object O
      WHERE  O.Object = :Equip[i].Equip AND
             O.Type = ET.Type AND
             ET.SuperType = :Type$BREAKER;

      IF CheckType <> 0 THEN
         CheckLine = 0;
         SELECT :CheckLine = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Equip[i].Equip AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Line; 
 
         IF CheckLine <> 0 THEN
            j = 1;
            REPEATED
            SELECT :CheckSpareBank[j].VALUE = O.Object
            FROM   Udb_Object O,
                   Udb_Grouping G
            WHERE  G.Grouping = :Substation AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = O.Object AND
                   O.Type IN (SELECT Type FROM Udb_ExtendedType
                              WHERE SuperType IN (:Type$BkrSpare, :Type$BkrROSpare)) AND
                   O.Name NOT LIKE '%C%'
            BEGIN
               j = j + 1;
            END;
/*
** Only need to check in the station one time
*/
            ENDLOOP;
         ENDIF;
      ENDIF;     
      i = i + 1;   
   ENDWHILE;

   IF CheckSpareBank.LastRow() = 1 THEN  /* Now we are talking */
   /*
   ** Before adding move, verify that the equipment does not have 
   ** an outstanding move elsewhere.  If it does, we don't want to
   ** insert another.
   */
      i = 0;
      SELECT :i = J.Job
      FROM   SOA_Job J,
             SOA_JobControl JC,
             SOA_ActiveCard C
      WHERE  J.Equip = :CheckSpareBank[1].Value AND
             J.Status = '' AND
            (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Job = JC.Job AND
             JC.SwitchingItem <> :SwitchingItem AND    /* This should be sufficient */
             JC.Card = C.Card; 
      IF i > 0 THEN
         RETURN NULL;
      ENDIF;
   
      CurObject.Card = Card;
      CurObject.Job = -1;
      CurObject.Seq = -1;
      CurObject.SwitchingItem = SwitchingItem;
      CurObject.Status = '';
      CurObject.JobClass = JobClass$CutInBkrSpare;
      CurObject.Substation = Substation;
      CurObject.PrintID = '';
      CurObject.ControlCard = Card;
      CurObject.MoveCategory = MoveCategory$Normal;
      CurObject.Equip = CheckSpareBank[1].Value;

      SELECT :CurObject.EquipName = Name,
             :CurObject.EquipClass = Type,
             :CurObject.EquipClassName = TypeName,
             :CurObject.TOMove = Description,
             :CurObject.RSMove = Description,
             :CurObject.SubstationName = PrimaryGroupingName
      FROM   Udb_Object 
      WHERE  Object = :CurObject.Equip;

       REPEATED
       SELECT :CurObject.DeskName = O.Name
       FROM Udb_Object O,
            Udb_Grouping G,
            Udb_Grouping GG
       WHERE O.Object = G.Grouping AND
             G.GroupingType = :Type$OperatorDesk AND
             G.Member = GG.Grouping AND
             GG.Member = :Substation AND
             GG.Relationship = :Interaction$Memberof;

      REPEATED
      SELECT :CurObject.MoveType = JC.MoveType,
             :TOMove = JC.TOMove,
             :RSMove = JC.RSMove,
             :CurObject.TOMoveRules = JC.TOMoveRules,
             :CurObject.RSMoveRules = JC.RSMoveRules,
             :CurObject.StepPair = JCC.StepPair,
             :CurObject.StepPairName = SQUEEZE(SP.Name),
             :CurObject.MoveEquipClass = JCC.EquipClass
      FROM   FMS_JobClass JC,
             FMS_JobClassControl JCC,
             Udb_ExtendedType ET,
             FMS_StepPair SP
      WHERE  JC.JobClass = :JobClass$CutInBkrSpare AND
             JC.JobClass = JCC.JobClass AND
             JCC.TypeOfCard = :TypeOfCard AND
             :CurObject.EquipClass = ET.Type AND
             ET.SuperType = JCC.EquipClass AND
             SP.TypeOfCard = :TypeOfCard AND
             SP.StepPair = JCC.StepPair;

      IF CurObject.TOMove <> '' THEN
          CurObject.TOMove = SQUEEZE(CurObject.TOMove + ' ' +
                             TOMove + ' - ' + :CurObject.EquipName);
          CurObject.RSMove = SQUEEZE(CurObject.RSMove + ' ' +
                             RSMove + ' - ' + :CurObject.EquipName);
      ELSE
          CurObject.TOMove = TOMove + ' - ' + :CurObject.EquipName;
          CurObject.RSMove = RSMove + ' - ' + :CurObject.EquipName;
      ENDIF;

      IF Card <> 0 THEN
         CurObject.Job = CurObject.InsertMove (
                      CardTypeOfCard = TypeOfCard,
                      KeepMoveText = TRUE);
         RETURN NULL;
      ELSE
         RETURN CurObject;
      ENDIF;
      
   ENDIF;    
END;

METHOD LinkToOutageRequest(
)=
DECLARE
   i                    = INTEGER      NOT NULL WITH DEFAULT;
   RetCode              = INTEGER      NOT NULL WITH DEFAULT;
   SingleOR = OutageReport;
BEGIN
   RetCode = SingleOR.LinkPermitToReport(Move = CurObject);
   RETURN RetCode;       
END;

METHOD DeleteFromOutageRequest(
)=
DECLARE
   i                    = INTEGER      NOT NULL WITH DEFAULT;
   RetCode              = INTEGER      NOT NULL WITH DEFAULT;
   SingleOR = OutageReport DEFAULT NULL;
BEGIN
   IF CurObject.StepPair <> StepHeading$TestPermit AND
      CurObject.StepPair <> StepHeading$WorkPermit THEN
      RETURN PU_OK;
   ENDIF;

   SingleOR = OutageReport.Create();

   RetCode = SingleOR.DeletePermitFromReport(Move = CurObject);
   RETURN RetCode;
END; 

