METHOD LoadISOFeeders (
   Card = INTEGER NOT NULL;
   Feeder = INTEGER NOT NULL;
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load a list of active ISO feeder cards.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ISOList.Clear();

   i = 1;
   SELECT DISTINCT :CurObject.ISOList[i].Object = C.Feeder, 
          :CurObject.ISOList[i].Name = C.FeederName,
          :CurObject.ISOList[i].Terminal = C.Card
   FROM   Udb_Grouping G,
          TFMS_CardToObject CTO,
          FMS_Card C
   WHERE  CTO.Card = :Card AND
          G.Grouping = CTO.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.MemberType IN (:Type$ISOFeeder,:Type$KPSFeeder,:Type$SectionalFeeder) AND
          G.Member = C.Feeder AND
          C.Status < :Card$Closed
   BEGIN
           i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

METHOD LoadFeederLinks (
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
   Feeder = INTEGER NOT NULL;
   AllFeederList = ARRAY OF ConnectedEquipClass;           
   NetworkFeederList = ARRAY OF ConnectedEquipClass;          
   SwitchList = ARRAY OF ConnectedEquipClass;          
   TempLink = FeederObject;          
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load a list of feeders that are linked 
** to this card.  Candidates are 4kV StepDown, 3G, or Sectionalized
** feeders.
** 
** FeederStatus: 1 = 3G Load Address
**               2 = Other 3G card, StepDown or Sectionalized Feeder Load Card
** Status: Only used for 3G feeders to determine if Address should be grey or not.
**         True  = Address Foreground is black
**         False = Address Foreground is grey
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Default cardname, may get changed if 4kv.
   */
   CurObject.C.CardName = CurObject.C.FeederName;

   CurObject.C.FeederLink.Clear();
   i = 1;
   /* 
   **  Check for 3G first
   */ 
   IF CurObject.C.NetworkFeeder = NetworkFeeder$3G THEN
      /*
      **  Load Feeder Objects for sf_CardName so it wont display when selecting CardName Field.
      **  Also hide field if it is showing.
      */
      SELECT :CurObject.C.FeederLink[i].Name = O.Name,
             :CurObject.C.FeederLink[i].Object = O.Object,
             :CurObject.C.FeederLink[i].Card = CTO.Card,
             :CurObject.C.FeederLink[i].Type = 1    /* Load Address */
      FROM    Udb_Object O,
              TFMS_CardToObject CTO
      WHERE   CTO.Card = :CurObject.C.Card AND
              CTO.Object = O.Object
      BEGIN
         i = i + 1;
      END;
      /* Highlight row for source position which should be on card. */
      Feeder = 0;
      SELECT :Feeder = G.Grouping
      FROM   TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Grouping G
      WHERE  CTO.Card = :CurObject.C.Card AND
             CTO.Object = G.Grouping AND
             G.Relationship = :Interaction$SourceBreaker AND
             G.Member = O.Object AND
             O.Name = :CurObject.C.Position;
      FOR i = 1 TO CurObject.C.FeederLink.LastRow DO
         /*
         **  Load Address into each field
         */
         SELECT :CurObject.C.FeederLink[i].Address1 = L.L1,
                :CurObject.C.FeederLink[i].Address2 = L.L2,
                :CurObject.C.FeederLink[i].Address3 = L.L3,
                :CurObject.C.FeederLink[i].Address4 = L.L4,
                :CurObject.C.FeederLink[i].Comment = O.Description
         FROM    Udb_Grouping G,
                 Udb_Location L,
                 Udb_Object O
         WHERE   O.Object = :CurObject.C.FeederLink[i].Object AND
                 O.Object = G.Member AND
                 G.Relationship = :Interaction$LocatedWith AND
                 G.Grouping = L.Object;
          
         IF CurObject.C.FeederLink[i].Object = Feeder THEN 
            CurObject.C.FeederLink[i].SourcePos = TRUE;
         ENDIF;
      ENDFOR;
      /*  START OF REMOVE IF CONED DOESN'T LIKE
      **  Get all Feeders and 3G Switches associated to this 3G Network
      * /
      RetCode = CALLPROC NetworkFeederTrace (
               StartFeeder = CurObject.C.FeederLink[1].Object,  
               NetworkFeederList = AllFeederList,
               SwitchList = SwitchList,
               GetAll = TRUE);
      IF RetCode = PU_OK THEN
         NetworkFeederList = AllFeederList.Duplicate();  
         / *
         ** Remove Feeders that appear on current card.
         * /
         FOR i = 1 TO CurObject.C.FeederLink.LastRow() DO
            j = NetworkFeederList.LastRow();
            WHILE j >=1 DO
               IF CurObject.C.FeederLink[i].Object = NetworkFeederList[j].Object THEN
                  NetworkFeederList.RemoveRow (rownumber = j);
                  ENDLOOP;
               ENDIF;
               j = j - 1;
            ENDWHILE;
         ENDFOR;
         FOR i = 1 TO NetworkFeederList.LastRow DO
            SELECT :TempLink.Name = C.FeederName,
                   :TempLink.Card = C.Card,
                   :TempLink.Type = 2    / * Load Card * /
            FROM    FMS_Card C,
                    TFMS_CardToObject CTO
            WHERE   CTO.Object = :NetworkFeederList[i].Object AND
                    CTO.Card = C.Card AND
                    C.Status < :Card$Closed
            BEGIN 
               FOR j = 1 TO CurObject.C.FeederLink.LastRow DO
                  IF TempLink.Card = CurObject.C.FeederLink[j].Card THEN
                     ENDLOOP;
                  ENDIF;
               ENDFOR;
               IF j > CurObject.C.FeederLink.LastRow THEN
                  CurObject.C.FeederLink[j] = TempLink.Duplicate();
               ENDIF;
            END;
         ENDFOR;
      ENDIF; / * END OF REMOVE IF CONED DOESN'T LIKE */

   ELSEIF CurObject.C.NetworkFeeder = NetworkFeeder$33kv THEN
      IF CurObject.C.TypeOfCard = TypeOfCard$Portion THEN
         /*
         **  Always load 33kV first. Check for Portion links. Only 
         **  one 33kV row will exist in table.
         */          
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_PortionLink L
         WHERE   L.PortionCard = :CurObject.C.Card AND 
                 L.Card = C.Card;
      ELSE
         /*
         **  Check if card has Portion link
         */          
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_PortionLink L
         WHERE   L.Card = :CurObject.C.Card AND 
                 L.Card = C.Card;
      ENDIF;
   ELSEIF CurObject.C.SectionalFeeder > 0 THEN
      /*
      **  This is a Sectional Feeder, find other feeders related to it.
      **  Always load Main Feeder first.
      */
      IF CurObject.C.SectionalFeeder = 1 THEN  /* This Feeder has a Sectional Feeder */
         CurObject.C.FeederLink[1].Name = CurObject.C.FeederName;
         CurObject.C.FeederLink[1].Card = CurObject.C.Card;
         CurObject.C.FeederLink[1].Type = 2;
         /*
         **  Load sectional feeders
         */
         i = 2;
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 Udb_Grouping G,
                 TFMS_CardToObject CTO
         WHERE   G.Grouping = :CurObject.C.Feeder AND
                 G.RelationShip = :Interaction$MemberOf AND
                 G.MemberType = :Type$SectionalFeeder AND
                 G.Member = CTO.Object AND
                 CTO.Card = C.Card AND
                 C.Status < :Card$Closed
         BEGIN 
            i = i + 1;
         END;
      ELSEIF CurObject.C.SectionalFeeder = 2 THEN  /* This Feeder is a sectional feeder */
         /*
         **  Load main feeder first
         */
         SELECT :CurObject.C.FeederLink[1].Name = C.FeederName,
                :CurObject.C.FeederLink[1].Object = AO.Object,
                :CurObject.C.FeederLink[1].Card = C.Card,
                :CurObject.C.FeederLink[1].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   G.Member = :CurObject.C.Feeder AND
                 G.RelationShip = :Interaction$MemberOf AND
                 G.GroupingType = :Type$Feeder AND
                 G.Grouping = AO.Object AND
                 AO.Card = C.Card;
         /*
         **  Load sectional feeders
         */
         i = 2;
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   G.Grouping = :CurObject.C.FeederLink[1].Object AND
                 G.RelationShip = :Interaction$MemberOf AND
                 G.MemberType = :Type$SectionalFeeder AND
                 G.Member = AO.Object AND
                 AO.Card = C.Card
         BEGIN 
            i = i + 1;
         END;    
      ENDIF;
   ELSE
      /*  
      **  If this is a 4kV card change the cardname to  
      **  only reflect the feedername up to the underscore.  
      **  Otherwise make the cardname = feedername.
      */  
      IF CurObject.C.TypeOfCard = Type$4kVCard THEN
         CurObject.C.CardName = left(CurObject.C.FeederName,(locate(CurObject.C.FeederName,'_')-1));
         /*
         **  Always load 27kV first. Check for StepDown links. Only 
         **  one 27kV row will exist in table.
         */          
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_StepDownLink L
         WHERE   L.StepDownCard = :CurObject.C.Card AND 
                 L.Card = C.Card;
      ELSE
         /*
         **  Check if card has step down link
         */          
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_StepDownLink L
         WHERE   L.Card = :CurObject.C.Card AND 
                 L.Card = C.Card;
      ENDIF;
   ENDIF;   
   
   IF CurObject.C.FeederLink.LastRow >= 1 THEN
      i = CurObject.C.FeederLink.LastRow + 1;
      IF CurObject.C.NetworkFeeder = NetworkFeeder$33kv THEN
         /*
         **  Links exist, now load Portion cards
         */
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_PortionLink L
         WHERE   L.Card = :CurObject.C.FeederLink[1].Card AND  /* 33kV should be in index 1 */
                 L.PortionCard = C.Card
         ORDER BY FeederName
         BEGIN
            i = i + 1;
         END; 
      ELSE
         /*
         **  Links exist, now load 4kv cards
         */
         SELECT :CurObject.C.FeederLink[i].Name = C.FeederName,
                :CurObject.C.FeederLink[i].Card = C.Card,
                :CurObject.C.FeederLink[i].Type = 2    /* Load Card */
         FROM    FMS_Card C,
                 FMS_StepDownLink L
         WHERE   L.Card = :CurObject.C.FeederLink[1].Card AND  /* 3G or 27kV should be in index 1 */
                 L.StepDownCard = C.Card
         ORDER BY FeederName
         BEGIN
            i = i + 1;
         END; 
      ENDIF;
   ENDIF;
   IF CurObject.C.FeederLink.LastRow <= 1 THEN
      CurObject.C.FeederLink.Clear();
   ENDIF;

   RETURN;
END;

METHOD LoadFaultCorrelation(
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.FTC.Card = CurObject.Card;
   CurObject.FTC.GetFaultCorrelation();

   CurObject.ReturnCode = CurObject.FTC.ReturnCode;
   CurObject.ErrorMessage = CurObject.FTC.ErrorMessage;
END;

METHOD LoadMTALines(
)=
DECLARE
   i = INTEGER NOT NULL;
   j = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(800) NOT NULL WITH DEFAULT;
   FdrList = ARRAY OF INTEGEROBJECT;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** build a list of the main and its iso feeders
*/
   DynamicWhereClause = '';
  
   IF CurObject.C.NetworkFeeder > 0 THEN
      i = 1;
      SELECT :FdrList[i].Value = CTO.Object
      FROM   TFMS_CardToObject CTO
      WHERE  CTO.Card = :CurObject.C.Card
      UNION ALL
      SELECT G.Member
      FROM   TFMS_CardToObject CTO,
             UDB_Grouping G
      WHERE  CTO.Card = :CurObject.C.Card AND
             CTO.Object = G.Grouping AND
             G.RelationShip = :Interaction$MemberOf AND
             G.MemberType = :Type$ISOFeeder
      BEGIN
         i = i + 1;
      END;
      
   ELSEIF CurObject.C.Feeder > 0 THEN
      i = 1;
      SELECT :FdrList[i].Value = :CurObject.C.Feeder
      UNION ALL
      SELECT O.Object
      FROM   UDB_Grouping G,
             UDB_Object O
      WHERE  G.Grouping = :CurObject.C.Feeder AND
             G.RelationShip = :Interaction$MemberOf AND
             G.MemberType = :Type$ISOFeeder AND
             G.Member = O.Object
      BEGIN    
         i = i + 1;
      END;
      
   ELSEIF CurObject.FeederFilter <> '' THEN
      CurObject.FeederFilter = '%' + CurObject.FeederFilter + '%';
      
      i = 1;
      SELECT :FdrList[i].Value = O.Object
      FROM   UDB_Object O
      WHERE  O.Name LIKE :CurObject.FeederFilter AND
             O.Type IN (:Type$Feeder, :Type$ISOFeeder) AND
             UPPER(O.TypeName) NOT LIKE '%OBSOLETE%'
      BEGIN         
         i = i + 1;
      END;
   ELSE
      RETURN;
   ENDIF;
   
   DynamicWhereClause = '';
   FOR i = 1 TO FdrList.LastRow DO
      IF DynamicWhereClause <> '' THEN
         DynamicWhereClause = DynamicWhereClause + ',';
      ENDIF;
      DynamicWhereClause = DynamicWhereClause + VARCHAR(FdrList[i].Value);
   ENDFOR;
   
/*
** Query all MTA Lines
*/
   DynamicWhereClause = 'G1.Grouping IN (' +  DynamicWhereClause + ') AND ' +
          'G1.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
          'G1.MemberType = ET.Type AND ' +
          'ET.SuperType = ' + VARCHAR(Type$HTVStd) + ' AND ' +
          'G1.Member = G2.Member AND '+
          'G2.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
          'G2.GroupingType = ' + VARCHAR(Type$MTALine) + ' AND ' +          // 10475
          'G2.Grouping = O.Object';
          
   i = 1;
   CurObject.MTALines.Clear();
   SELECT  DISTINCT
           :CurObject.MTALines[i].Object = O.Object,
           :CurObject.MTALines[i].Name = O.Name,
           :CurObject.MTALines[i].Description = O.Description
   FROM   UDB_Grouping G1,
          UDB_Grouping G2,
          UDB_ExtendedType ET,
          UDB_Object O
   WHERE  :DynamicWhereClause
   ORDER BY Name
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   FOR i =1 TO CurObject.MTALines.LastRow DO
      CurObject.MTALines[i].LoadHTVList();
      
      /*
      ** Identify which HTV is fed by the current feeder or ISO feeder
      */
      FOR j = 1 TO CurObject.MTALines[i].HTVList.LastRow DO         
         RetCode = FdrList.Find(AttributeName = 'Value', Value = CurObject.MTALines[i].HTVList[j].LocationObject);
         IF RetCode = ER_OK THEN
            CurObject.MTALines[i].HTVList[j].EquipTemplateObject = 1;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDFOR;
END;

