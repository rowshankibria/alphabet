ON CLICK SUBSF.Search_btn =
BEGIN
   IF SubSF.SubstationList.LastRow() = 0 THEN
      CALLPROC ShowSubstations();
   ENDIF;  
   CALLPROC SubstationSearch();
END;

ON Click SubSF.OK_Btn =
BEGIN
   IF SubSF.Filter.Object = 0 THEN
      IF CurFrame.ConfirmPopup(messagetext = 
         'No Substation Selected. Exit mapping?') = PU_OK THEN        
         FIELD(SUBSF).CurBias = FB_INVISIBLE;
      ELSE
         RESUME;
      ENDIF;
   ELSE
      WorkItem.Substation = SubSF.Filter.Object;
      WorkItem.SubstationName = SubSF.Filter.Name; 
      FIELD(SUBSF).CurBias = FB_INVISIBLE;
      FIELD(WorkItem.Substation).TextLabel = 'Substation: ' + SubSF.Filter.Name;
      WorkItem.MapSubstation();
      IF WorkItem.ReturnCode <> 0 THEN
         MESSAGE WorkItem.ErrorMessage;
      ENDIF;
   ENDIF;
END;

