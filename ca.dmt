CurMethod.Trace(Text = 'i = ' + varchar(i) + ' after select 16 ' + varchar(date('now')));


      CurObject.SSO.Sort(Division = AS_ASC,
                         SubstationName = AS_ASC,
                         OrderNumber = AS_ASC,
                         IssueTime = AS_ASC,
                         Application = AS_ASC);


      FOR i = 1 TO CurObject.SSO.LastRow DO
         IF OldDivisionID <> CurObject.SSO[i].Division THEN
            /* The purpose of setting DivisionNames here is to avoid adding another
            ** UDB_Object table in the queries.
            */
            RetCode = SimpleDivision.DList.Find(AttributeName = 'division', 
                                                Value = CurObject.SSO[i].Division,
                                                RowNumber = ByRef(k));
            IF RetCode = ER_OK THEN
               CurObject.SSO[i].DivisionName = SimpleDivision.DList[k].DivisionName;
            ENDIF;
         ELSE
            CurObject.SSO[i].DivisionName = OldDivisionName;
         ENDIF;


         IF CurObject.SSO[i].TORS = 0 THEN
            CurObject.SSO[i].MoveText = CurObject.SSO[i].TOMove;
         ELSE
            CurObject.SSO[i].MoveText = CurObject.SSO[i].RSMove;
         ENDIF;
         IF CurObject.SSO[i].Application = 'TFMS' OR CurObject.SSO[i].Application = 'SLC' THEN
            CurObject.SSO[i].Application = 'TOMS';
         ENDIF;
         
         OldDivisionID = CurObject.SSO[i].Division;
         OldDivisionName = CurObject.SSO[i].DivisionName;
         
      ENDFOR;
      
      /*
      ** Remove duplicate moves that are caused by these cases:
      ** 1. Common moves have been archived. Unable to filter shadow moves because no way to tell 
      **    where the moves were controlled and issued originally.
      ** 2. Order moves in shadow switching items.
      */
      i = CurObject.SSO.LastRow;
      WHILE i >= 2 DO
         IF CurObject.SSO[i-1].OrderNumber = CurObject.SSO[i].OrderNumber AND
            CurObject.SSO[i-1].Job = CurObject.SSO[i].Job AND
            CurObject.SSO[i-1].TORS = CurObject.SSO[i].TORS THEN  
            
            CurObject.SSO.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
      
      /*
      ** Create summary
      */
      j = 0;
      OldOrder = 0;
      OldDivisionID = 0;
      
      FOR i = 1 TO CurObject.SSO.LastRow DO
         IF OldDivisionID <> CurObject.SSO[i].Division THEN
            j = j + 1;
            CurObject.SSO_Summary[j].Division = CurObject.SSO[i].Division;
            CurObject.SSO_Summary[j].DivisionName = CurObject.SSO[i].DivisionName;
            OldDivisionID = CurObject.SSO[i].Division;
         ENDIF;
         
         IF CurObject.SSO[i].OrderNumber > 0 THEN     
            // electronic orders
            IF OldOrder <> CurObject.SSO[i].OrderNumber THEN
               CurObject.SSO_Summary[j].Order_Regular_Total = CurObject.SSO_Summary[j].Order_Regular_Total + 1;
               
               IF CurObject.SSO[i].Application = 'FMS' THEN
                  CurObject.SSO_Summary[j].Order_Regular_FMS = CurObject.SSO_Summary[j].Order_Regular_FMS + 1;
               ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
                  CurObject.SSO_Summary[j].Order_Regular_TLS = CurObject.SSO_Summary[j].Order_Regular_TLS + 1;
               ELSE
                  CurObject.SSO_Summary[j].Order_Regular_TOMS = CurObject.SSO_Summary[j].Order_Regular_TOMS + 1; 
               ENDIF;
            ENDIF;
            
            CurObject.SSO_Summary[j].RR_Regular_Total = CurObject.SSO_Summary[j].RR_Regular_Total + 1;
            IF CurObject.SSO[i].Application = 'FMS' THEN
               CurObject.SSO_Summary[j].RR_Regular_FMS = CurObject.SSO_Summary[j].RR_Regular_FMS + 1;
            ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
               CurObject.SSO_Summary[j].RR_Regular_TLS = CurObject.SSO_Summary[j].RR_Regular_TLS + 1;
            ELSE
               CurObject.SSO_Summary[j].RR_Regular_TOMS = CurObject.SSO_Summary[j].RR_Regular_TOMS + 1; 
            ENDIF; 


            OldOrder = CurObject.SSO[i].OrderNumber;
         ELSE
            // verbal orders
            CurObject.SSO_Summary[j].Verbal_Regular_Total = CurObject.SSO_Summary[j].Verbal_Regular_Total + 1;
            IF CurObject.SSO[i].Application = 'FMS' THEN
               CurObject.SSO_Summary[j].Verbal_Regular_FMS = CurObject.SSO_Summary[j].Verbal_Regular_FMS + 1;
            ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
               CurObject.SSO_Summary[j].Verbal_Regular_TLS = CurObject.SSO_Summary[j].Verbal_Regular_TLS + 1;
            ELSE
               CurObject.SSO_Summary[j].Verbal_Regular_TOMS = CurObject.SSO_Summary[j].Verbal_Regular_TOMS + 1; 
            ENDIF;            
         ENDIF;
      ENDFOR;
      
   ELSE     // substation work permits
      RR_FMS_WP_WC = RR_FMS_WP_WC + DynamicWhereClause;
      RR_TOMS_WP_WC = RR_TOMS_WP_WC + DynamicWhereClause;
      RR_TLS_WP_WC = RR_TLS_WP_WC + DynamicWhereClause;


      V_Active_SOA_WP_WC = V_Active_SOA_WP_WC + DynamicWhereClause;
      V_Archive_FMS_WP_WC = V_Archive_FMS_WP_WC + DynamicWhereClause;
      V_Archive_TOMS_WP_WC = V_Archive_TOMS_WP_WC + DynamicWhereClause;
      V_TLS_WP_WC = V_TLS_WP_WC + DynamicWhereClause;


      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  IR_OperatingOrder OO,
            IR_OpOrderJobs OJ,  
            Udb_Grouping G,
            Udb_Object S,
            SOA_Job J 
      WHERE  :RR_FMS_WP_WC           // Active 
      BEGIN      
         i = i + 1;
      END;


      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  IR_OperatingOrder OO,
            IR_OpOrderJobs OJ,  
            Udb_Grouping G,
            Udb_Object S,
            FMS_ArchiveJob J 
      WHERE  :RR_FMS_WP_WC        // Archive
      BEGIN      
         i = i + 1;
      END;
   
      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'TOMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  IR_OperatingOrder OO,
            IR_OpOrderJobs OJ,  
            Udb_Grouping G,
            Udb_Object S,
            SOA_Job J 
      WHERE  :RR_TOMS_WP_WC        // Active
      BEGIN      
         i = i + 1;
      END;


      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'TOMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  IR_OperatingOrder OO,
            IR_OpOrderJobs OJ,  
            Udb_Grouping G,
            Udb_Object S,
            SOA_ArchiveJob J 
      WHERE  :RR_TOMS_WP_WC        // Archive
      BEGIN      
         i = i + 1;
      END;


      SELECT 
            :CurObject.SSO[i].Application = 'TLS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.CircuitClassName,
            :CurObject.SSO[i].EquipName = J.LineNumber
      FROM  IR_TelephoneOrder OO,
            IR_TLSOrderJob OJ,  
            Udb_Grouping G,
            Udb_Object S,
            TC_Job J 
      WHERE  :RR_TLS_WP_WC        // Active
      BEGIN      
         i = i + 1;
      END;


      SELECT 
            :CurObject.SSO[i].Application = 'TLS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = OO.OrderNumber,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = OJ.TORS,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.CircuitClassName,
            :CurObject.SSO[i].EquipName = J.LineNumber
      FROM  IR_TelephoneOrder OO,
            IR_TLSOrderJob OJ,  
            Udb_Grouping G,
            Udb_Object S,
            TC_ArchiveJob J 
      WHERE  :RR_TLS_WP_WC        // Archive
      BEGIN      
         i = i + 1;
      END;


      // verbal moves 
      SELECT DISTINCT
            :CurObject.SSO[i].Application = C.Application,
            :CurObject.SSO[i].IssueTime = J.TOIssued,
            :CurObject.SSO[i].OrderType = 'WORK PERMIT',
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = 0,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = 0,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  Udb_Grouping G,
            Udb_Object S,
            SOA_Job J,
            SOA_JobControl JC,
            SOA_Card C            
      WHERE  :V_Active_SOA_WP_WC           // from active fms, tfms 
      BEGIN      
         i = i + 1;
      END;


      SELECT 
            :CurObject.SSO[i].Application = 'FMS',
            :CurObject.SSO[i].IssueTime = J.TOIssued,
            :CurObject.SSO[i].OrderType = 'WORK PERMIT',
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = 0,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = 0,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  Session.StationEquip SE,   
            Udb_Grouping G,
            Udb_Object S,
            FMS_ArchiveJob J 
      WHERE  :V_Archive_FMS_WP_WC        // from archive fms
      BEGIN      
         i = i + 1;
      END;
      
      // verbal orders from toms
      SELECT DISTINCT      // DISTINCT filters out common jobs on other cards.                     
            :CurObject.SSO[i].Application = 'TOMS',
            :CurObject.SSO[i].IssueTime = J.TOIssued,
            :CurObject.SSO[i].OrderType = 'WORK PERMIT',
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = 0,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = 0,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.EquipClassName,
            :CurObject.SSO[i].EquipName = J.EquipName
      FROM  Udb_Grouping G,
            Udb_Object S,
            SOA_ArchiveJob J
      WHERE  :V_Archive_TOMS_WP_WC        // from archive toms
      BEGIN      
         i = i + 1;
      END;


      // verbal orders from tls
      SELECT                            
            :CurObject.SSO[i].Application = 'TLS',
            :CurObject.SSO[i].IssueTime = J.TOIssued,
            :CurObject.SSO[i].OrderType = 'WORK PERMIT',
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = 0,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = 0,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.CircuitClassName,
            :CurObject.SSO[i].EquipName = J.LineNumber
      FROM  Udb_Grouping G,
            Udb_Object S,
            TC_Job J 
      WHERE  :V_TLS_WP_WC        // from active tls
      BEGIN      
         i = i + 1;
      END;


      SELECT                            
            :CurObject.SSO[i].Application = 'TLS',
            :CurObject.SSO[i].IssueTime = J.TOIssued,
            :CurObject.SSO[i].OrderType = 'WORK PERMIT',
            :CurObject.SSO[i].Division = G.Grouping,
            :CurObject.SSO[i].DivisionName = '??',
            :CurObject.SSO[i].OrderNumber = 0,
            :CurObject.SSO[i].SubstationName = S.Name,
            :CurObject.SSO[i].Job = J.Job,
            :CurObject.SSO[i].TORS = 0,        
            :CurObject.SSO[i].TOMove = J.TOMove,
            :CurObject.SSO[i].RSMove = '',
            :CurObject.SSO[i].EquipClassName = J.CircuitClassName,
            :CurObject.SSO[i].EquipName = J.LineNumber
      FROM  Udb_Grouping G,
            Udb_Object S,
            TC_ArchiveJob J 
      WHERE  :V_TLS_WP_WC        // from archive tls
      BEGIN      
         i = i + 1;
      END;


      CurObject.SSO.Sort(Division = AS_DESC,
                         SubstationName = AS_DESC,
                         OrderNumber = AS_DESC,
                         Job = AS_DESC,
                         TORS = AS_DESC,
                         IssueTime = AS_DESC,
                         Application = AS_DESC);


      FOR i = 1 TO CurObject.SSO.LastRow DO
         IF OldDivisionID <> CurObject.SSO[i].Division THEN
            /* The purpose of setting DivisionNames here is to avoid adding another
            ** UDB_Object table in the queries.
            */
            RetCode = SimpleDivision.DList.Find(AttributeName = 'division', 
                                                Value = CurObject.SSO[i].Division,
                                                RowNumber = ByRef(k));
            IF RetCode = ER_OK THEN
               CurObject.SSO[i].DivisionName = SimpleDivision.DList[k].DivisionName;
            ENDIF;
         ELSE
            CurObject.SSO[i].DivisionName = OldDivisionName;
         ENDIF;


         CurObject.SSO[i].MoveText = CurObject.SSO[i].TOMove;
         IF CurObject.SSO[i].Application = 'TFMS' OR CurObject.SSO[i].Application = 'SLC' THEN
            CurObject.SSO[i].Application = 'TOMS';
         ENDIF;
               
         OldDivisionID = CurObject.SSO[i].Division;
         OldDivisionName = CurObject.SSO[i].DivisionName;       
      ENDFOR;
      
      /*
      ** Remove duplicate moves that are caused by these cases:
      ** 1. Common moves have been archived. Unable to filter shadow moves because no way to tell 
      **    where the moves were controlled and issued originally.
      ** 2. Order moves in shadow switching items.
      */
      i = CurObject.SSO.LastRow;
      WHILE i >= 2 DO
         IF CurObject.SSO[i-1].OrderNumber = CurObject.SSO[i].OrderNumber AND
            CurObject.SSO[i-1].Job = CurObject.SSO[i].Job AND
            CurObject.SSO[i-1].TORS = CurObject.SSO[i].TORS THEN  
            
            CurObject.SSO.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
      
      /*
      ** Create summary
      */
      j = 0;
      OldOrder = 0;
      OldDivisionID = 0;
      
      FOR i = 1 TO CurObject.SSO.LastRow DO
         IF OldDivisionID <> CurObject.SSO[i].Division THEN
            j = j + 1;
            CurObject.SSO_Summary[j].Division = CurObject.SSO[i].Division;
            CurObject.SSO_Summary[j].DivisionName = CurObject.SSO[i].DivisionName;
            OldDivisionID = CurObject.SSO[i].Division;
         ENDIF;
         
         IF CurObject.SSO[i].OrderNumber > 0 THEN     
            // electronic orders
            IF OldOrder <> CurObject.SSO[i].OrderNumber THEN
               CurObject.SSO_Summary[j].Order_WP_Total = CurObject.SSO_Summary[j].Order_WP_Total + 1;
               
               IF CurObject.SSO[i].Application = 'FMS' THEN
                  CurObject.SSO_Summary[j].Order_WP_FMS = CurObject.SSO_Summary[j].Order_WP_FMS + 1;
               ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
                  CurObject.SSO_Summary[j].Order_WP_TLS = CurObject.SSO_Summary[j].Order_WP_TLS + 1;
               ELSE
                  CurObject.SSO_Summary[j].Order_WP_TOMS = CurObject.SSO_Summary[j].Order_WP_TOMS + 1; 
               ENDIF;
            ENDIF;
            
            CurObject.SSO_Summary[j].RR_WP_Total = CurObject.SSO_Summary[j].RR_WP_Total + 1;
            IF CurObject.SSO[i].Application = 'FMS' THEN
               CurObject.SSO_Summary[j].RR_WP_FMS = CurObject.SSO_Summary[j].RR_WP_FMS + 1;
            ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
               CurObject.SSO_Summary[j].RR_WP_TLS = CurObject.SSO_Summary[j].RR_WP_TLS + 1;
            ELSE
               CurObject.SSO_Summary[j].RR_WP_TOMS = CurObject.SSO_Summary[j].RR_WP_TOMS + 1; 
            ENDIF; 


            OldOrder = CurObject.SSO[i].OrderNumber;
         ELSE
            // verbal orders
            CurObject.SSO_Summary[j].Verbal_WP_Total = CurObject.SSO_Summary[j].Verbal_WP_Total + 1;
            IF CurObject.SSO[i].Application = 'FMS' THEN
               CurObject.SSO_Summary[j].Verbal_WP_FMS = CurObject.SSO_Summary[j].Verbal_WP_FMS + 1;
            ELSEIF CurObject.SSO[i].Application = 'TLS' THEN
               CurObject.SSO_Summary[j].Verbal_WP_TLS = CurObject.SSO_Summary[j].Verbal_WP_TLS + 1;
            ELSE
               CurObject.SSO_Summary[j].Verbal_WP_TOMS = CurObject.SSO_Summary[j].Verbal_WP_TOMS + 1; 
            ENDIF;            
         ENDIF;
      ENDFOR;
   ENDIF;
   CALLPROC DDB_ROLLBACK;


   /*
   **  Drop temporary tables.  Don't need after rollback;
   DROP SESSION.stationequip; 
   */
  
   RETURN;
END;


METHOD Load_FailedHiPotFeeders(
) =
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load network feeders that have not had 
** a successful high pot test in the last three years (test passed, not failed).  
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


   i = 1;
   REPEATED
   SELECT :CurObject.OList[i].Object = O2.Object,
          :CurObject.OList[i].Name = O2.Name,
          :CurObject.OList[i].PrimaryGrouping = O3.PrimaryGrouping
   FROM   UDB_Grouping G1,
          UDB_Grouping G2,
          UDB_Object O1,
          UDB_Object O2,
          UDB_Object O3,
          UDB_Rating R
   WHERE  G1.MemberType = :Type$Feeder AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.GroupingType = :Type$Network AND
          G1.Grouping = O1.Object AND
          O1.PositionX >= 0.2 AND
          G1.Member = G2.Member AND
          G2.Relationship = :Interaction$RatedAs AND
          G2.Grouping = R.Object AND
         (R.Normal > 4 AND R.Normal < 33) AND
          O2.PrimaryGrouping = O3.Object AND
          O3.PrimaryGrouping <> :Company$ConEdison AND         // Exclude 3G feeders
          G1.Member = O2.Object AND
          O2.Object NOT IN (SELECT Feeder 
                           FROM   FMS_HighPotHistory
                           WHERE  FRATestFailed = 0 AND
                                  FailedDuration >= 5 AND
                                  TestDate > (Date('now') - '3 years'))
   ORDER BY 3, 2                        
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;


METHOD Load_MTALines (
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   CardObject = FMS_Card_ASE DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';


/*
** Query all MTA Lines
*/
   CurObject.MTALines.Clear();


   IF CurObject.SearchText <> '' THEN
      CardObject = FMS_Card_ASE.Create();
      
      CardObject.FeederFilter = CurObject.SearchText;
      CardObject.LoadMTALines();
      
      IF CurObject.ReturnCode = 0 THEN
         CurObject.MTALines = CardObject.MTALines;
      ELSE
         CurObject.ReturnCode = CardObject.ReturnCode;
         CurObject.ErrorMessage = CardObject.ErrorMessage;      
      ENDIF;
      
   ELSE   
      i = 1;
      SELECT  :CurObject.MTALines[i].Object = O.Object,
              :CurObject.MTALines[i].Name = O.Name,
              :CurObject.MTALines[i].Description = O.Description
      FROM   UDB_Object O
      WHERE  O.Type = :Type$MTALine AND
             O.Name NOT LIKE '%OBSOLETE%'
      ORDER BY Name
      BEGIN
         CurObject.MTALines[i].LoadHTVList();
         
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END;


METHOD Load_DOScheduledWorkData
( 
)=
DECLARE
   LastDate = DATE NOT NULL WITH DEFAULT;
   i       = INTEGER NOT NULL WITH DEFAULT;
   j       = INTEGER NOT NULL WITH DEFAULT;
   k       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TempSW  = SOA_ScheduledWork;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Get currant gap information
   */
   SELECT :CurObject.Gap_Limit = Gap_Limit,
          :CurObject.Gap_Update = Gap_Update
   FROM   SOA_Schd_Work_Gap;
   CALLPROC DDB_ROLLBACK; 
   
   LastDate = '';
   i = 0;
   CurObject.dsw.Clear();
   SELECT :TempSW.Application = SW.Application,
          :TempSW.Archive     = SW.Archive,
          :TempSW.Card        = SW.Card,
          :TempSW.SwitchingItem = SW.SwitchingItem,
          :TempSW.CardClass   = SW.CardClass,
          :TempSW.CardClassName = SW.CardClassName,
          :TempSW.CardName    = SW.CardName,
          :TempSW.Cutout      = SW.Cutout,
          :TempSW.DateValue   = SW.DateValue,
          :TempSW.DOName      = SW.DOName,
          :TempSW.DOObject    = SW.DOObject,
          :TempSW.Gap_Limit   = SW.Gap_Limit,
          :TempSW.Gap_Update  = SW.Gap_Update,
          :TempSW.Tot_Seconds = SW.Tot_Seconds
   FROM    SOA_Schd_Work_Rpt SW
   WHERE   SW.DateValue BETWEEN :CurObject.StartDate AND :CurObject.EndDate 
   ORDER BY DateValue, Card
   BEGIN
      IF LastDate <> TempSW.DateValue THEN
         LastDate = TempSW.DateValue;
         i = i + 1;
         CurObject.dsw[i].DateValue = TempSW.DateValue;
         CurObject.dsw[i].Tot_Seconds = CurObject.dsw[i].Tot_Seconds + TempSW.Tot_Seconds;
         CurObject.dsw[i].Gap_Limit = TempSW.Gap_Limit;
         CurObject.dsw[i].Gap_Update = TempSW.Gap_Update;
         j = 1;
         CurObject.dsw[i].clist[j].Application = TempSW.Application;
         CurObject.dsw[i].clist[j].Archive = TempSW.Archive;
         CurObject.dsw[i].clist[j].Card = TempSW.Card;
         CurObject.dsw[i].clist[j].SwitchingItem = TempSW.SwitchingItem;
         CurObject.dsw[i].clist[j].CardClass = TempSW.CardClass;
         CurObject.dsw[i].clist[j].CardClassName = TempSW.CardClassName;
         CurObject.dsw[i].clist[j].CardName = TempSW.CardName;
         CurObject.dsw[i].clist[j].Cutout = TempSW.CutOut;
         CurObject.dsw[i].clist[j].Tot_Seconds = TempSW.Tot_Seconds;
         k = 1;
         CurObject.dsw[i].clist[j].DOP[k].DoObject = TempSW.DOObject;
         CurObject.dsw[i].clist[j].DOP[k].DoName = TempSW.DoName;
         CurObject.dsw[i].clist[j].DOP[k].Tot_Seconds = CurObject.dsw[i].clist[j].DOP[k].Tot_Seconds + TempSW.Tot_Seconds;      
      ELSE
         CurObject.dsw[i].Tot_Seconds = CurObject.dsw[i].Tot_Seconds + TempSW.Tot_Seconds;
         /*
         ** Find Card/SwitchingItem, if not found append to card/switchingitem array
         */
         j = 0;
         IF TempSW.Application = Application$SLC THEN
            RetCode = CurObject.dsw[i].clist.Find(AttributeName = 'SwitchingItem',
                                               Value = TempSW.SwitchingItem,
                                               RowNumber = ByRef(j));                              
         ELSE
            RetCode = CurObject.dsw[i].clist.Find(AttributeName = 'Card',
                                               Value = TempSW.Card,
                                               RowNumber = ByRef(j));                              
         ENDIF;
         IF RetCode = ER_OK THEN
            /*
            **  Found Card update tot_seconds
            */
            CurObject.dsw[i].clist[j].Tot_Seconds = CurObject.dsw[i].clist[j].Tot_Seconds + TempSW.Tot_Seconds;            
         ELSE
            j = CurObject.dsw[i].clist.LastRow + 1;
            CurObject.dsw[i].clist[j].Application = TempSW.Application;
            CurObject.dsw[i].clist[j].Archive = TempSW.Archive;
            CurObject.dsw[i].clist[j].Card = TempSW.Card;
            CurObject.dsw[i].clist[j].SwitchingItem = TempSW.SwitchingItem;
            CurObject.dsw[i].clist[j].CardClass = TempSW.CardClass;
            CurObject.dsw[i].clist[j].CardClassName = TempSW.CardClassName;
            CurObject.dsw[i].clist[j].CardName = TempSW.CardName;
            CurObject.dsw[i].clist[j].Cutout = TempSW.CutOut;
            CurObject.dsw[i].clist[j].Tot_Seconds = TempSW.Tot_Seconds;
         ENDIF;
         
         /*
         ** Find DO, if not found append to DO array
         */
         k = 0;
         RetCode = CurObject.dsw[i].clist[j].DOP.Find(AttributeName = 'DoObject',
                                                      Value = TempSW.DoObject,
                                                      RowNumber = ByRef(k));                              
         IF RetCode = ER_OK THEN
            /*
            **  Found DO update tot_seconds
            */
            CurObject.dsw[i].clist[j].DOP[k].Tot_Seconds = CurObject.dsw[i].clist[j].DOP[k].Tot_Seconds + TempSW.Tot_Seconds;
         ELSE
            k = CurObject.dsw[i].clist[j].DOP.LastRow + 1;
            CurObject.dsw[i].clist[j].DOP[k].DoObject = TempSW.DOObject;
            CurObject.dsw[i].clist[j].DOP[k].DoName = TempSW.DoName;
            CurObject.dsw[i].clist[j].DOP[k].Tot_Seconds = TempSW.Tot_Seconds;
         ENDIF;         
      ENDIF;   
   END;


   RETURN;   
END;


METHOD Generate_DSW_Data  /* DoScheduledWork report data */
( 
)=
DECLARE
   LastDate = DATE NOT NULL WITH DEFAULT;
   i       = INTEGER NOT NULL WITH DEFAULT;
   j       = INTEGER NOT NULL WITH DEFAULT;
   k       = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TempSW  = SOA_ScheduledWork;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Get currant gap information
   */
   SELECT :CurObject.Gap_Limit = Gap_Limit,
          :CurObject.Gap_Update = Gap_Update
   FROM   SOA_Schd_Work_Gap;
   CALLPROC DDB_ROLLBACK; 
   /*
   **  Remove all data for timeperiod
   */
   RetCode = CALLPROC SOA_SCHD_Work_RptDel (DateStart = CurObject.StartDate
                                           ,DateEnd   = CurObject.EndDate
                                           );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'Error - Unable to remove current data for DO ' + 
                       'Scheduled Work Activity Report.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Unable to remove previous data';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /********************************************************************
                             Load FMS cards
   ********************************************************************/
   i = 1;
   CurObject.dsw.Clear();
   SELECT :CurObject.dsw[i].CardName = C.FeederName,
          :CurObject.dsw[i].Card     = C.Card,
          :CurObject.dsw[i].CardClass = C.CardClass,
          :CurObject.dsw[i].CardClassName = C.CardClassName,
          :CurObject.dsw[i].SwitchingItem = 0,
          :CurObject.dsw[i].Cutout = C.Cutout,
          :CurObject.dsw[i].Application = :Application$FMS,
          :CurObject.dsw[i].Archive = :FALSE
   FROM   FMS_Card C
   WHERE  C.Cutout BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          C.CardClass IN (:Type$SCHD,:Type$WR) AND
          C.Status < :Card$Closed
   UNION
   SELECT C.FeederName,
          C.Card,
          C.CardClass,
          C.CardClassName,
          0,
          C.Cutout,
         :Application$FMS,
         :TRUE
   FROM   FMS_ArchiveCard C
   WHERE  C.Cutout BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          C.CardClass IN (:Type$SCHD,:Type$WR)
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;   
   /********************************************************************
                             Load TFMS cards
   ********************************************************************/
   SELECT :CurObject.dsw[i].CardName = AC.CardName,
          :CurObject.dsw[i].Card     = AC.Card,
          :CurObject.dsw[i].CardClass = C.CardClass,
          :CurObject.dsw[i].CardClassName = AC.CardClassName,
          :CurObject.dsw[i].SwitchingItem = 0,
          :CurObject.dsw[i].Application = :Application$TFMS,
          :CurObject.dsw[i].Archive = :FALSE
   FROM   SOA_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC,
          SOA_Job J,
          FMS_JobAction JA
   WHERE  C.Application = :Application$TFMS AND
          C.Card = AC.Card AND
          AC.Card = JC.Card AND
          JC.Job = J.Job AND
          J.TOIssued BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          C.CardClass IN (:Type$TFMSSCHD,:Type$TFMSOOEM) AND
          J.JobClass = JA.JobClass AND
          JA.EquipClass = JC.MoveEquipClass AND
          JA.StepPair = JC.StepPair AND
          JA.TORS = :Job$TakeoutInt AND
          JA.Action = :JobAction$Prompt AND
          JA.Status = :Prompt$CheckCutout AND
          C.Status < :Card$Closed
   UNION
   SELECT C.FeederNames,
          C.Card,
          C.CardClass,
          C.CardClassName,
          0,
         :Application$TFMS,
         :TRUE
   FROM   TFMS_ArchiveCard C,
          SOA_ArchiveJob J,
          FMS_JobAction JA
   WHERE  C.Card = J.Card AND
          J.TOIssued BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          C.CardClass IN (:Type$TFMSSCHD,:Type$TFMSOOEM) AND
          J.JobClass = JA.JobClass AND
          JA.EquipClass = J.EquipClass AND
          JA.StepPair = J.StepPair AND
          JA.TORS = :Job$TakeoutInt AND
          JA.Action = :JobAction$Prompt AND
          JA.Status = :Prompt$CheckCutout
   BEGIN
      IF CurObject.dsw[i].Archive = FALSE THEN
         SELECT :CurObject.dsw[i].Cutout = MIN(J.TOIssued)
         FROM    SOA_JobControl JC,
                 SOA_Job J,
                 FMS_JobAction JA
         WHERE   JC.Card = :CurObject.dsw[i].Card AND
                 JC.Job = J.Job AND
                 J.TOIssued IS NOT NULL AND 
                 J.TOIssued <> '' AND
                 J.JobClass = JA.JobClass AND
                 JA.EquipClass = JC.MoveEquipClass AND
                 JA.StepPair = JC.StepPair AND
                 JA.TORS = :Job$TakeoutInt AND
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :Prompt$CheckCutout;
      ELSE
         SELECT :CurObject.dsw[i].Cutout = MIN(J.TOIssued)
         FROM    SOA_ArchiveJob J,
                 FMS_JobAction JA
         WHERE   J.Card = :CurObject.dsw[i].Card AND
                 J.TOIssued IS NOT NULL AND
                 J.TOIssued <> '' AND
                 J.JobClass = JA.JobClass AND
                 JA.EquipClass = J.EquipClass AND
                 JA.StepPair = J.StepPair AND
                 JA.TORS = :Job$TakeoutInt AND
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :Prompt$CheckCutout;


      ENDIF;
      IF CurObject.dsw[i].Cutout < CurObject.StartDate THEN
         CurObject.dsw.RemoveRow(Rownumber = i);
      ELSE
         i = i + 1;
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;
   /********************************************************************
                        Load SLC Switching Items
   ********************************************************************/
   SELECT :CurObject.dsw[i].CardName = I.Title,
          :CurObject.dsw[i].Card     = JC.Card,
          :CurObject.dsw[i].CardClass = I.CardClass,
          :CurObject.dsw[i].CardClassName = I.CardClassName,
          :CurObject.dsw[i].SwitchingItem = I.Job,
          :CurObject.dsw[i].Application = :Application$SLC,
          :CurObject.dsw[i].Archive = :FALSE
   FROM   SLC_InformationItem I,
          SOA_JobControl JC,
          SOA_Job J,
          Udb_ExtendedType ET,
          FMS_JobAction JA
   WHERE  I.Job = JC.SwitchingItem AND
          I.CardClass IN (:Type$SLCSCHD,:Type$SLCOOEM) AND
          JC.Job = J.Job AND
          J.EquipClass = ET.Type AND
          ET.SuperType = :Type$Breaker AND
          J.TOIssued BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          J.JobClass = JA.JobClass AND
          JA.EquipClass = JC.MoveEquipClass AND
          JA.StepPair = JC.StepPair AND
          JA.TORS = :Job$TakeoutInt AND
          JA.Action = :JobAction$Prompt AND
          JA.Status = :Prompt$SetCurrentlyOpen AND
          J.SwItemStatus < :Card$Closed
   UNION
   SELECT I.Title,
          J.Card,
          I.CardClass,
          I.CardClassName,
          I.Job,
         :Application$SLC,
         :TRUE
   FROM   SLC_ArchiveInfItem I,
          SOA_ArchiveJob J,
          Udb_ExtendedType ET,
          FMS_JobAction JA
   WHERE  I.Job = J.SwitchingItem AND
          I.CardClass IN (:Type$SLCSCHD,:Type$SLCOOEM) AND
          J.EquipClass = ET.Type AND
          ET.SuperType = :Type$Breaker AND
          J.TOIssued BETWEEN :CurObject.StartDate AND :CurObject.EndDate AND
          J.JobClass = JA.JobClass AND
          JA.TORS = :Job$TakeoutInt AND
          JA.Action = :JobAction$Prompt AND
          JA.Status = :Prompt$SetCurrentlyOpen
   BEGIN
      IF CurObject.dsw[i].Archive = FALSE THEN
         SELECT :CurObject.dsw[i].Cutout = MIN(J.TOIssued)
         FROM    SOA_JobControl JC,
                 SOA_Job J,
                 FMS_JobAction JA,
                 Udb_ExtendedType ET
         WHERE   JC.Card = :CurObject.dsw[i].Card AND
                 JC.SwitchingItem = :CurObject.dsw[i].SwitchingItem AND
                 JC.Job = J.Job AND
                 J.EquipClass = ET.Type AND
                 ET.SuperType = :Type$Breaker AND
                 J.TOIssued IS NOT NULL AND 
                 J.TOIssued <> '' AND
                 J.JobClass = JA.JobClass AND
                 JA.TORS = :Job$TakeoutInt AND
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :Prompt$SetCurrentlyOpen;
      ELSE
         SELECT :CurObject.dsw[i].Cutout = MIN(J.TOIssued)
         FROM    SOA_ArchiveJob J,
                 FMS_JobAction JA,
                 Udb_ExtendedType ET
         WHERE   J.Card = :CurObject.dsw[i].Card AND
                 J.SwitchingItem = :CurObject.dsw[i].SwitchingItem AND
                 J.TOIssued IS NOT NULL AND
                 J.TOIssued <> '' AND
                 J.EquipClass = ET.Type AND
                 ET.SuperType = :Type$Breaker AND
                 J.JobClass = JA.JobClass AND
                 JA.TORS = :Job$TakeoutInt AND
                 JA.Action = :JobAction$Prompt AND
                 JA.Status = :Prompt$SetCurrentlyOpen;


      ENDIF;
      IF CurObject.dsw[i].Cutout < CurObject.StartDate THEN
         CurObject.dsw.RemoveRow(Rownumber = i);
      ELSE
         i = i + 1;
      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;   
   FOR i = 1 TO CurObject.dsw.LastRow DO
      CurObject.Process_dsw_Logs(Card = CurObject.dsw[i].Duplicate());
      IF CurObject.ReturnCode <> 0 THEN
         RETURN;
      ENDIF;
   ENDFOR; 
  
   RETURN;


END;   
   
METHOD Process_dsw_Logs  /* DoScheduledWork report data */
( 
   Card = SOA_ScheduledWork;
)=
DECLARE
   DurationSec = INTEGER NOT NULL WITH DEFAULT;
   i   = INTEGER NOT NULL WITH DEFAULT;
   j   = INTEGER NOT NULL WITH DEFAULT;
   DOStart = DATE NOT NULL WITH DEFAULT;
   DOEnd = DATE NOT NULL WITH DEFAULT;
   LastDO   = INTEGER NOT NULL WITH DEFAULT;
   LastDOName = VARCHAR(40) NOT NULL WITH DEFAULT;
   LastTime = DATE NOT NULL WITH DEFAULT;
   Log      = ARRAY OF CardLog;
   LastDate = DATE NOT NULL WITH DEFAULT;
   LogDate = DATE NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF Card.Archive = FALSE THEN
      i = 1;
      Log.Clear();
      SELECT :Log[i].Time = L.Time,
             :Log[i].Operator = L.Operator,
             :Log[i].OperatorName = L.OperatorName
      FROM    SOA_Log L,
              Udb_Object O
      WHERE   L.Card = :Card.Card AND
              L.SwitchingItem = :Card.SwitchingItem AND
              L.Time <= :Card.Cutout AND
              L.Operator = O.Object AND
              O.Type = :Type$DistrictOperator
      ORDER BY Time ASC
      BEGIN
         i = i + 1;
      END; 


   ELSE
      IF Card.Application = Application$FMS THEN
         i = 1;
         Log.Clear();
         SELECT :Log[i].Time = L.Time,
                :Log[i].Operator = L.Operator,
                :Log[i].OperatorName = L.OperatorName
         FROM    FMS_ArchiveLog L,
                 Udb_Object O
         WHERE   L.Card = :Card.Card AND
                 L.Time <= :Card.Cutout AND
                 L.Operator = O.Object AND
                 O.Type = :Type$DistrictOperator
         ORDER BY Time ASC
         BEGIN
            i = i + 1;
         END; 
      ELSE
         i = 1;
         Log.Clear();
         SELECT :Log[i].Time = L.Time,
                :Log[i].Operator = L.Operator,
                :Log[i].OperatorName = L.OperatorName
         FROM    SOA_ArchiveLog L,
                 Udb_Object O
         WHERE   L.Card = :Card.Card AND
                 L.SwitchingItem = :Card.SwitchingItem AND
                 L.Time <= :Card.Cutout AND
                 L.Operator = O.Object AND
                 O.Type = :Type$DistrictOperator
         ORDER BY Time ASC
         BEGIN
            i = i + 1;
         END; 
      ENDIF;


   ENDIF;


   LastTime = '';
   LastDO = 0;
   DurationSec = 0;


   FOR i = 1 TO Log.LastRow DO
      LogDate = date_trunc('day',Log[i].Time);
      IF LastTime <> '' THEN
         j = interval('seconds', Log[i].Time - LastTime);
         IF j > CurObject.Gap_Limit THEN
            j = CurObject.Gap_Update;
         ENDIF;
      ELSE
         DOStart = Log[i].Time;
      ENDIF;
      DurationSec = DurationSec + j;
      IF LastDO <> 0 AND
        (LastDO <> Log[i].Operator OR
         LastDate <> LogDate) THEN
         DOEnd = Log[i].Time;
         /*
         **  Insert Row
         */
         RetCode = CALLPROC SOA_SCHD_Work_RptIns (
                                   DOName = LastDOName
                                  ,DOObject = LastDO
                                  ,DOStart = DOStart
                                  ,DOEnd = DOEnd
                                  ,DateValue = LastDate
                                  ,Tot_Seconds = DurationSec
                                  ,CardClassName = Card.CardClassName
                                  ,CardClass = Card.CardClass
                                  ,CutOut = Card.Cutout
                                  ,CardName = Card.CardName
                                  ,Card     = Card.Card
                                  ,SwitchingItem = Card.SwitchingItem
                                  ,Application = Card.Application
                                  ,Archive = Card.Archive
                                  ,Gap_Limit = CurObject.Gap_Limit
                                  ,Gap_Update = CurObject.Gap_Update
                                  );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'Error - Unable to insert data for ' + 
                        'Scheduled Work Activity Report.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Unable to insert data for time period';
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;
         DurationSec = 0;
         DOStart = Log[i].Time;
      ENDIF;
      LastTime = Log[i].Time;
      LastDate = LogDate;
      LastDO = Log[i].Operator;          
      LastDOName = Log[i].OperatorName;          
   ENDFOR;
   
   IF LastDO <> 0 AND
      DurationSec <> 0 THEN
      DOEnd = LastTime;
      /*
      **  Insert Last Row
      */
      RetCode = CALLPROC SOA_SCHD_Work_RptIns (
                                   DOName = LastDOName
                                  ,DOObject = LastDO
                                  ,DOStart = DOStart
                                  ,DOEnd = DOEnd
                                  ,DateValue = LastDate
                                  ,Tot_Seconds = DurationSec
                                  ,CardClassName = Card.CardClassName
                                  ,CardClass = Card.CardClass
                                  ,CutOut = Card.Cutout
                                  ,CardName = Card.CardName
                                  ,Card     = Card.Card
                                  ,SwitchingItem = Card.SwitchingItem
                                  ,Application = Card.Application
                                  ,Archive = Card.Archive
                                  ,Gap_Limit = CurObject.Gap_Limit
                                  ,Gap_Update = CurObject.Gap_Update
                                  );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: FMS_MgtReports_ASE ' +
                       'Error - Unable to insert data for ' + 
                        'Scheduled Work Activity Report.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Unable to insert data for time period';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;


   RETURN;
END;


METHOD Load_FCRProtectionResult(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = 1;
   CurObject.WPList.Clear();
   
   SELECT :CurObject.WPList[i].Operator = Operator,
          :CurObject.WPList[i].OperatorName = OperatorName,
          :CurObject.WPList[i].Card = Card,
          :CurObject.WPList[i].FeederName = FeederName,
          :CurObject.WPList[i].Workpermit = Workpermit,
          :CurObject.WPList[i].TOMove = TOMove,
          :CurObject.WPList[i].IssueDate = IssueDate,
          :CurObject.WPList[i].Result = ProtectionResult,
          :CurObject.WPList[i].DiffDistance = DiffDistance         
   FROM   FMS_WPProtectionResult  
   WHERE  IssueDate BETWEEN :CurObject.StartDate AND :CurObject.EndDate 
   ORDER BY OperatorName, IssueDate, FeederName 
   BEGIN
      CurObject.WPList[i].LoadProtections();


      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;


METHOD Load_HighPotHistory(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DivisionWhereClause = VARCHAR(60) NOT NULL WITH DEFAULT;
   
   DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   FN_Lookup = ARRAY OF ObjectSummaryClass;
   SimpleDivision = Division_ASE DEFAULT NULL; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
      
         SimpleDivision.LoadDivisions();
      
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
         
      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF;
   ENDIF;


   DivisionWhereClause = '(';
   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         DivisionWhereClause = DivisionWhereClause + VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DivisionWhereClause = DivisionWhereClause + VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;
   
   CurObject.HPList.Clear();


   IF CurObject.Filter = 1 THEN
      DynamicWhereClause = 'H.FRATestFailed = 0 AND ' +
                           'H.TestDate = (SELECT MAX(F.TestDate) ' +
                                       '  FROM   FMS_HighPotHistory F ' +
                                       '  WHERE  F.Feeder = H.Feeder AND ' +
                                       '         F.FRATestFailed = 0) AND ' +
                           'H.Feeder = SG.Member AND ' +
                           'SG.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                           'SG.GroupingType = ' + VARCHAR(Type$Substation) + ' AND ' + 
                           'SG.Grouping = S.Object AND ' +
                           'H.Feeder = NG.Member AND ' +
                           'NG.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                           'NG.GroupingType IN (' + VARCHAR(Type$Network) + ',' + VARCHAR(Interaction$NonNetworkMemberOf) + ') AND ' + 
                           'NG.Grouping = N.Object ';
   ELSE
      DynamicWhereClause = 'H.TestDate BETWEEN ''' + VARCHAR(CurObject.StartDate) + ''' AND ''' + VARCHAR(CurObject.EndDate) + ''' AND ' +
                        'H.Feeder = SG.Member AND ' +
                        'SG.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                        'SG.GroupingType = ' + VARCHAR(Type$Substation) + ' AND ' + 
                        'SG.Grouping = S.Object AND ' +
                        'H.Feeder = NG.Member AND ' +
                        'NG.RelationShip = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                        'NG.GroupingType IN (' + VARCHAR(Type$Network) + ',' + VARCHAR(Interaction$NonNetworkMemberOf) + ') AND ' + 
                        'NG.Grouping = N.Object ';
   ENDIF;
                           
   IF CurObject.Feeder > 0 THEN 
      DynamicWhereClause = 'H.Feeder = ' + VARCHAR(CurObject.Feeder) + ' AND ' + DynamicWhereClause;
      
   ELSE
      IF CurObject.Substation > 0 THEN
         DynamicWhereClause = DynamicWhereClause + 
                     ' AND S.Object = ' + VARCHAR(CurObject.Substation);
         
      ELSEIF CurObject.Network > 0 THEN
         DynamicWhereClause = DynamicWhereClause + 
                     ' AND N.Object = ' + VARCHAR(CurObject.Network) + 
                     ' AND S.PrimaryGrouping IN ' + DivisionWhereClause;
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
                     ' AND S.PrimaryGrouping IN ' + DivisionWhereClause;         
      ENDIF;
   ENDIF;    
   
   curmethod.trace(text = DynamicWhereClause);   
   i = 1;
   SELECT   :CurObject.HPList[i].DivisionName = S.PrimaryGroupingName,
            :CurObject.HPList[i].SubstationName = S.Description,
            :CurObject.HPList[i].NetworkName = N.Description,
            :CurObject.HPList[i].FeederName = H.FeederName,
            :CurObject.HPList[i].Feeder = H.Feeder,
            :CurObject.HPList[i].TestDate = H.testdate,
            :CurObject.HPList[i].CardType = H.CardType,
            :CurObject.HPList[i].HighPotType = H.HighPotType,
            :CurObject.HPList[i].TestSequence = H.testsequence,
            :CurObject.HPList[i].FeederKV = H.feederkv,
            :CurObject.HPList[i].TestTypeKV = H.testtypekv,
            :CurObject.HPList[i].Duration = H.duration,
            :CurObject.HPList[i].FailedTestTypeKV = H.failedtesttypekv,
            :CurObject.HPList[i].FailedDuration = H.failedduration,
            :CurObject.HPList[i].StartMA = H.startma,
            :CurObject.HPList[i].EndMA = H.endma,
            :CurObject.HPList[i].FRATestFailed = H.FRATestFailed,
            :CurObject.HPList[i].FailedTestReason = H.FailedTestReason
   FROM     FMS_HighPotHistory H,
            UDB_Grouping SG,
            UDB_Object S,
            UDB_Grouping NG,
            UDB_Object N
   WHERE    :DynamicWhereClause
   ORDER BY 1 ASC, 2 ASC, 3 ASC, 4 ASC, 6 DESC
   BEGIN
      IF CurObject.HPList[i].FeederName = '' THEN
         SELECT :CurObject.HPList[i].FeederName = Name
         FROM   UDB_Object
         WHERE  Object = :CurObject.HPList[i].Feeder;
      ENDIF;
      
      IF CurObject.HPList[i].HighPotType = 1 THEN
         CurObject.HPList[i].TempHighPotType = 'DC';           /* old value = Regular */
      ELSEIF CurObject.HPList[i].HighPotType = 2 THEN
         CurObject.HPList[i].TempHighPotType = 'Modified';
      ELSEIF CurObject.HPList[i].HighPotType = 3 THEN
         CurObject.HPList[i].TempHighPotType = 'AC';
      ELSEIF CurObject.HPList[i].HighPotType = 4 THEN
         CurObject.HPList[i].TempHighPotType = 'AC Modified';
      ENDIF;
      IF CurObject.HPList[i].FailedTestTypeKV = 0 THEN
         CurObject.HPList[i].FailedTestTypeKV = NULL;
      ENDIF;
      IF CurObject.HPList[i].FailedDuration = 0 THEN
         CurObject.HPList[i].FailedDuration = NULL;
      ENDIF;
      IF CurObject.HPList[i].FRATestFailed = 1 THEN
         CurObject.HPList[i].TempFRATestFailed = 'Failed';
      ELSE
         CurObject.HPList[i].TempFRATestFailed = 'Passed';
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;


   /* we have to sort it again because some FeederNames in 
   ** FMS_HighPotHistory are blank, which causes TestDate out of sequence
   */
   CurObject.HPList.Sort(DivisionName = AS_ASC, 
                         SubstationName = AS_ASC, 
                         NetworkName = AS_ASC, 
                         FeederName = AS_ASC, 
                         TestDate = AS_DESC);   
END;

