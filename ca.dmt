	Name:            NetworkFeederTrace

/* 
**      Copyright c 2010 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software LLC proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
*/
/*
**  Application:    Feedercard
**  Frame:          NetworkFeederTrace
**
**  Date:       Author   Description
** ----------------------------------
**  04/14/10	em       Created for 3G Network Feeder card creation.
**  04/16/10    em       Add GetAll option to get all feeders ignoring open devices
**  04/21/10    em       Add 3GSwitchList for return
**  06/21/10    em       Moved to CAC, using TraceError procedure since Job Action Prompts may call. 
**  01/13/11    em       Add SwitchClosing Parm to identify switch that should be considered closed.
**  01/24/11    em       Re-Order list before return so that substation feeder appears first.
**  03/30/11    pkw      Add validated field to selects.
*/
PROCEDURE NetworkFeederTrace
(
    StartFeeder = INTEGER NOT NULL;   /*Passed Feeder*/	
    GetAll      = INTEGER NOT NULL WITH DEFAULT;   /*Optional Parm*/
    SwitchClosing  = INTEGER NOT NULL WITH DEFAULT;   /*Optional Parm*/

    NetworkFeederList = ARRAY OF ConnectedEquipClass;	
    SwitchList = ARRAY OF ConnectedEquipClass;		         

    f = INTEGER;
    i = INTEGER;
    k = INTEGER;
    s = INTEGER;
    x = INTEGER;

    RetCode         = INTEGER;
    VisibleBreak    = INTEGER NOT NULL;

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(3000) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    BreakerTypeDevice = ConnectedEquipClass;
    TargetTypeDevice = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    TempFeeder = ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadObject  = INTEGER NOT NULL WITH DEFAULT;
    StatusDBF      = INTEGER NOT NULL WITH DEFAULT;

    BreakerTypes    = ARRAY OF INTEGEROBJECT; /*BREAKER device types*/
    LoadBreakingTypes    = ARRAY OF INTEGEROBJECT; /*Load breaking device types*/
    BreakerTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    ExistingBreaks = ARRAY OF INTEGEROBJECT; /*List of Objects with Breaks*/
    PendingBreaks  = ARRAY OF INTEGEROBJECT; /*Objects with Pending Breaks*/
    TargetTypes    = ARRAY OF INTEGEROBJECT; /*Types we don't want to see*/
    TargetTypeFound = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    LineSegFound   = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    o              = INTEGER NOT NULL;    /*OutBound counter*/
    ObjectCurOpen  = INTEGER NOT NULL;    /*Currently Open Status*/
    ExtendSubstation = INTEGER NOT NULL WITH DEFAULT; /* Set Scope of second trace*/
    MacroSubstation = INTEGER NOT NULL WITH DEFAULT; /* Set Scope of second trace*/
    OpenText       = VARCHAR(15) NOT NULL WITH DEFAULT; /*Blocked Open or Currently Open*/
) =
BEGIN

    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName,
           :ConnectedEquip[1].Validated = O.Validated,
           :ConnectedEquip[1].ValidatedBy = O.ValidatedBy
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :StartFeeder AND
           O.Object = T.Object AND
           T.Node > 0;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN (PU_CANCEL);
    ENDIF;

    f = 1;
    NetworkFeederList[f] = ConnectedEquip[1].Duplicate();

    ConnectedEquip[1].Used = FALSE;

    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';

    DynamicWhereClause = StaticWhereClause + 
                         'T1.Object = ' + VARCHAR(StartFeeder);
/*
** start search with this feeder and then branch out in all
** directions. For every connected 3G Switch, check for open close status.
** If open stop trace on this leg.  Keep trace of feeders encountered.
*/
    FloatEquip = NULL;
    ClosedOutBnd = NULL;

    i = 1;
    MoreObjects = TRUE;
    ClosedPaths = 0;
    s = 0;

    WHILE MoreObjects = TRUE DO

      PrevClosedPaths = ClosedPaths;
      ClosedPaths = 0;
      OpenedPaths = 0;

      /* find all connected equipment. Use NodeClause to avoid retrieving
      ** already-selected equipment.
      */

      ExcludedNodes.Clear();
      TempEquip.Clear();

      x = 1;
      SELECT :TempEquip[x].Object = T2.Object,
             :TempEquip[x].Terminal = T2.Terminal,
             :TempEquip[x].Node  = T2.Node,
             :TempEquip[x].Used = :FALSE, 
             :TempEquip[x].OutBound = :FALSE, 
             :TempEquip[x].OutBoundBreakerFound = :FALSE, 
             :TempEquip[x].OutBoundDepth = 0, 
             :TempEquip[x].Type = O.Type,
             :TempEquip[x].TypeName = O.TypeName,
             :TempEquip[x].Name = O.Name,
             :TempEquip[x].PrimaryGrouping = O.PrimaryGrouping,
             :TempEquip[x].PrimaryGroupingName = O.PrimaryGroupingName,
             :TempEquip[x].Terminals = O.Terminals,
             :TempEquip[x].PrevObject = T1.Object,
             :TempEquip[x].Validated = O.Validated,
             :TempEquip[x].ValidatedBy = O.ValidatedBy
      FROM   Udb_Terminal T1,
             Udb_Terminal T2,
             Udb_Object O
      WHERE  :DynamicWhereClause
      ORDER BY PrevObject
      BEGIN
          CALLPROC InsertValue (ValueList = ExcludedNodes, 
                                Value = TempEquip[x].Node);
          x = x + 1;
      END;            

      MoreObjects = FALSE;

      /* If nothing is connected to PrevObject, PrevObject must be floating.
      ** Also put a mark on every piece of equipment that has been checked. 
      */
      x = 1;
      WHILE x <= ConnectedEquip.LastRow() DO

        IF ConnectedEquip[x].Used = FALSE THEN
           FloatFound = TRUE;
           k = 1;
           WHILE k <= TempEquip.LastRow() DO
             IF TempEquip[k].PrevObject = ConnectedEquip[x].Object THEN
                FloatFound = FALSE;
                ENDLOOP;
             ENDIF;
             k = k + 1;
           ENDWHILE;

           IF FloatFound = TRUE THEN  /* OK if single terminal device */
              IF ConnectedEquip[x].Terminals = 1 THEN                 
                 OpenedPaths = OpenedPaths + 1;
              ELSE 
                 FloatEquip = ConnectedEquip[x].Duplicate();     
             ENDIF;
           ENDIF;
        ENDIF;

        ConnectedEquip[x].Used = TRUE;
        x = x + 1;
      ENDWHILE;

      /* use IncludedObjects to retrieve next round of equipment */
      IncludedObjects.Clear();     

      x = 1;
      WHILE x <= TempEquip.LastRow() DO
         /* eliminate same piece of equipment which has already been checked*/
         k = 1;
         WHILE k <= ConnectedEquip.LastRow() DO
            IF ConnectedEquip[k].Object = TempEquip[x].Object THEN
               ENDLOOP;
            ENDIF;
            k = k + 1;
         ENDWHILE;
         IF k <= ConnectedEquip.LastRow() THEN    /* same equipment found */
            IF TempEquip[x].Node <> ConnectedEquip[k].Node THEN
               ConnectedEquip[k].Used = TRUE;  
            ENDIF;  
         ELSE                                    /* new equip */
            i = i + 1;
            ConnectedEquip.InsertRow(Rownumber = i, 
                         RowObject = TempEquip[x].Duplicate());
/*
** If a 3G Switch check currently open status and stop trace in this direction
** if Open.
*/
            VisibleBreak = FALSE;
            IF TempEquip[x].Type = Type$3GSwitch THEN
                
               SELECT :VisibleBreak = CurrentlyOpen
               FROM   Udb_Switch
               WHERE  Object = :TempEquip[x].Object;

               s = s + 1;
               SwitchList[s] = TempEquip[x].Duplicate();
               SwitchList[s].CurrentlyOpen = VisibleBreak;

               IF VisibleBreak = TRUE AND GetAll = FALSE AND 
                    TempEquip[x].Object <> SwitchClosing THEN
                  ConnectedEquip[k].Used = TRUE;  
                  OpenedPaths = OpenedPaths + 1;
               ELSE
                  MoreObjects = TRUE;
                  ClosedPaths = ClosedPaths + 1;
               ENDIF;
                 /*
** If we've reached a Feeder, add it to list.
*/
            ELSEIF TempEquip[x].Type = Type$Feeder THEN
               f = f + 1;
               NetworkFeederList[f] = ConnectedEquip[i].Duplicate();
               ClosedPaths = ClosedPaths + 1;
               MoreObjects = TRUE;
            ENDIF;
      
            IF ConnectedEquip[i].Used = FALSE THEN
               CALLPROC InsertValue (ValueList = IncludedObjects, 
                                     Value = ConnectedEquip[i].Object);
            ENDIF;
         ENDIF;
         x = x + 1;
      ENDWHILE;            /* just retrieved equipments */

      /* build dynamic where-clause to prepare for the round of search */
      IF IncludedObjects.LastRow() > 0 THEN
         MoreObjects = TRUE;
      
         DynamicWhereClause = StaticWhereClause + ' T1.Node NOT IN (';
         x = 1;
         WHILE x <= ExcludedNodes.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(ExcludedNodes[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(ExcludedNodes[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;

         DynamicWhereClause =  DynamicWhereClause + ') AND T1.Object IN (';
         x = 1;
         WHILE x <= IncludedObjects.LastRow() DO  
           IF x = 1 THEN
              DynamicWhereClause = DynamicWhereClause + 
                                   VARCHAR(IncludedObjects[x].Value);
           ELSE
              DynamicWhereClause = DynamicWhereClause + 
                                   ',' + VARCHAR(IncludedObjects[x].Value);
           ENDIF;
           x = x + 1;
         ENDWHILE;
         DynamicWhereClause = DynamicWhereClause + ')';
      ENDIF;
/*
**  We stop search due to a Floating Equip connectivity error or if we have
**  found the TargetType.  We do not stop if we have a closed outbound 
**  because we want to continue searching for a target type on other paths.
**  The closed outbound is only a problem if we do not found a target type
**  within the scope of the current substation.
*/
      IF FloatEquip IS NOT NULL  THEN
         MoreObjects = FALSE;
      ENDIF;   
    ENDWHILE;
/* 
**  Give warning if Float equip found or if TargetType not found and
**  Closed OutBound is found
**  or if BreakerTypeFound.
*/
    IF FloatEquip IS NOT NULL THEN
       CALLPROC TraceError (UserMessage =
                       'ERROR: 3G Network Connectivity error at ' + 
                         FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' + FloatEquip.Name,
                            TraceMessage =
                       'NetworkFeederTrace: ' +
                       '3G Network Connectivity error at ' + 
                         FloatEquip.PrimaryGroupingName + '  ' +
                        FloatEquip.TypeName + '  ' + FloatEquip.Name
                                 );
       RETURN(PU_CANCEL);
    ELSE
/*
** Re-order list so that feeders associated to substation appear first.
*/
      s = 1;    /*Next Substation Feeder*/
      i = 1;
      WHILE i <= NetworkFeederList.LastRow() DO
         NetworkFeederList[i].PrimaryGrouping = 0;
         f = 0;
         SELECT :f = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :NetworkFeederList[i].Object AND
                Relationship = :Interaction$MemberOf AND
                GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                 WHERE  SuperType = :Type$Substation);
         IF f <> 0 THEN
            NetworkFeederList[i].PrimaryGrouping = f;

            IF i > s THEN      /*ReSequence*/
               TempFeeder = NetworkFeederList[s].Duplicate();
               NetworkFeederList[s] = NetworkFeederList[i].Duplicate();
               NetworkFeederList[i] = TempFeeder.Duplicate();
               s = s + 1;      /*It's possible we might have multiple feeders connected to stations in the list. */
            ENDIF;
         ENDIF;
         i = i + 1;
      ENDWHILE;

      RETURN(PU_OK);
    ENDIF;
END;


Application Component Report
============================

	Name:            NewItem

/**
 **
 **  Copyright c 1993 Unified Information, Inc.  All rights reserved.
 **
 **  Unified Information, Inc. proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Unified Information, Inc.
 **
 **/
/**
 **  Application:    SOA
 **  Frame:          NewItem
 **
 **  Modification log:
 **
 **  08/08/95    hlf Add a new information item
 **  09/13/95    vdh Added the switch item, info item toggle
 **  03/25/98    em  Copied from SLC for inclusion into SOA
 **  08/04/98    em  Activate Shadow item upon insertion
 **  10/19/98    em  Modified for SLC 39 to support specific information item
 **                  details.  No longer using WorkPermit table to store
 **                  sw/inf item details.  Screen also used to display details
 **                  in a MoveDetails kind of way based on the CardMode. 
 **  10/23/98    em  Add load from Archive tables.
 **  12/10/98	 em  Allow insertion of new item when transferring equipment 
 **                  control.  Added InsertOnly Flag.  Will not Display.
 **  12/14/98    em  present message if saving with no equipment.
 **  05/29/99    pkw If move category is passed in do not allow user
 **                  to change infoitem option.  This was done to give 
 **                  DO ability to create info items from TMFS. 
 **  12/01/99    pkw Add SLC Card type when creating info items.
 **  12/14/05    ysp increase the size of tomove to 160 chars
 **  04/10/06    em  On InsertOnly, Description might be passed so only
 **                  copy TOMove if description blank.
 **  01/15/08    pkw Prompt user for CTSEOS reason.
 **  01/22/08    pkw Edit out call to BuildCTSEOS Phrase.  Just comment out
 **                  in case users change mind.
 **  01/25/13    em  Add optional parameter for XA21 Time
 **  06/27/16    em  When activating InsertOnly item download to RR.
 **/
INITIALIZE   
(
#  include StandardDeclarations
   ArchiveItem          = INTEGER NOT NULL WITH DEFAULT;/*Passed Flag*/
   CardSubstation	= INTEGER NOT NULL;             /*Passed Substation*/
   CardClass    	= INTEGER NOT NULL;             /*Passed/Selected Card Class*/
   CardClassName    	= VARCHAR(40) NOT NULL;         /*Passed/Selected Card Class Name*/
   DisplayOnly 		= INTEGER NOT NULL WITH DEFAULT;/*Passed BOOLEAN*/
   EquipSubstation	= INTEGER NOT NULL;             /*Equipment List Subst*/
   InitiatingCard       = INTEGER NOT NULL WITH DEFAULT;/*Optional Parm*/
   InsertOnly           = INTEGER NOT NULL WITH DEFAULT;/*Passed BOOLEAN*/
   InsertShadow         = INTEGER NOT NULL WITH DEFAULT;/*Passed BOOLEAN*/
   Item                 = Job;                          /*Passed Job*/
   ItemDetails          = SwitchingItem;                /*Retrieval class*/
   j                    = INTEGER NOT NULL WITH DEFAULT; /*Variable*/
   MenuEntry		= CHOICEITEM DEFAULT NULL; /*Temporary Object*/  
   MoveCategory         = INTEGER NOT NULL WITH DEFAULT; /*Returned*/
   MultiplekVFlag 	= INTEGER NOT NULL WITH DEFAULT;/*Passed BOOLEAN*/
   NewItem 		= SwitchingItem;                /*New Item Reference */
   PassedMode           = INTEGER NOT NULL WITH DEFAULT;/*Passed Mode*/
   SubstationCard       = INTEGER NOT NULL;             /*Passed Card */
   SwItemTOMove         = VARCHAR(160) NOT NULL WITH DEFAULT;/*Move Text to Ret*/
   TempObject		= INTEGER NOT NULL;             /*Used to load list*/
   TempName  		= VARCHAR(40) NOT NULL WITH DEFAULT;/* LoadList*/
   CTSEOS_Reason        = VARCHAR(500) NOT NULL WITH DEFAULT;
   XATime               = DATE NOT NULL WITH DEFAULT;
) =
BEGIN
    CurFrame.WindowVisibility = WV_INVISIBLE;
    CurFrame.CurMode = PassedMode;
    FIELD(CatForm).CurBias = FB_INVISIBLE;
    FIELD(Sub).CurBias = FB_INVISIBLE;
    FIELD(CardClass_Opt).ValueList.ChoiceItems.Clear();
    CTSEOS_Reason = '';
/*
**   Raise Event to load card class. We will purge it if we will only
**   show info item information.
*/
    CurFrame.SendUserEvent (EventName = 'LoadCardClass');
/*
**  IF MoveCategory is passed in, do not give option to change
**  Categories.
*/
    IF MoveCategory = MoveCategory$SwitchingItem THEN
       InfoItem = FALSE;
       FIELD(InfoItem).CurBias = FB_INVISIBLE;
    ELSEIF MoveCategory = MoveCategory$InformationItem THEN
       InfoItem = TRUE;
       FIELD(InfoItem).CurBias = FB_INVISIBLE;
       FIELD(CardClass_Opt).CurBias = FB_INVISIBLE;
       CurFrame.PurgeUserEvent (EventName = 'LoadCardClass');
    ENDIF;
/*
**  If InsertShadow Flag is TRUE, this frame should just insert switching item
**  directly using the appropriate events and not display itself.
*/
    IF InsertOnly = TRUE OR InsertShadow = TRUE THEN
       CurFrame.WindowVisibility = WV_INVISIBLE;
       CurFrame.PurgeUserEvent (EventName = 'LoadCardClass');
       InfoItem = FALSE;
       IF Description = '' THEN
          Description = TOMove;
       ENDIF;
       IF InsertOnly = TRUE THEN
          NewItem.ShadowLink = 0;
       ELSE
          CardClass = Type$SLCShadow;
          CardClassName = 'SHADOW';
          NewItem.ShadowLink = InitiatingCard;
       ENDIF;
       CurFrame.SendUserEvent (EventName = 'Shadow');
    ELSE
       CurFrame.SendUserEvent (EventName = 'DisplayScreen');
    ENDIF;
END;

ON USEREVENT 'LoadCardClass' =
BEGIN
   IF DisplayOnly = TRUE THEN
      FIELD(CardClass_opt).ValueList.ChoiceItems.Clear();
      MenuEntry = ChoiceItem.Create();
      IF ArchiveCard = TRUE THEN
         SELECT  :MenuEntry.EnumText = I.CardClassName,
                 :MenuEntry.EnumValue = I.CardClass
         FROM    SLC_ArchiveInfItem I
         WHERE   I.Job = :Item.Job
         BEGIN
            FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumValue = 
               MenuEntry.EnumValue;
            FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumText = 
               MenuEntry.EnumText;
         END;
 
      ELSE
         SELECT  :MenuEntry.EnumText = I.CardClassName,
                 :MenuEntry.EnumValue = I.CardClass 
         FROM    SLC_InformationItem I
         WHERE   I.Job = :Item.Job
         BEGIN
            FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumValue = 
               MenuEntry.EnumValue;
            FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumText = 
               MenuEntry.EnumText;
         END;
      ENDIF;   
      CALLPROC DDB_ROLLBACK;  
      CardClass = MenuEntry.EnumValue;
      CardClassName = MenuEntry.EnumText;
   ELSEIF FIELD(CardClass_Opt).ValueList.ChoiceItems.LastRow() = 0 THEN
      /*
      **  Load the card class list
      */    
      FIELD(CardClass_Opt).ValueList.ChoiceItems.Clear();
      FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumValue = 0;
      FIELD(CardClass_Opt).ValueList.ChoiceItems[1].EnumText = '';

      i = 2;
      MenuEntry = ChoiceItem.Create();
      SELECT  :MenuEntry.EnumText = T.Name,
              :MenuEntry.EnumValue = T.Type 
      FROM    Udb_Type T,
              Udb_SuperType ST  
      WHERE   ST.SuperType = :Type$SLCCardClass and
              ST.Type = T.Type and
              ST.Type <> :Type$SLCShadow
      BEGIN
         FIELD(CardClass_Opt).ValueList.ChoiceItems[i].EnumValue = 
            MenuEntry.EnumValue;
         FIELD(CardClass_Opt).ValueList.ChoiceItems[i].EnumText = 
            MenuEntry.EnumText;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;  

   ENDIF;

   FIELD(CardClass_Opt).UpdChoiceList();
END;

ON USEREVENT 'DisplayScreen' =
BEGIN    
/*
**  Move Details function for a switching item will use this screen to 
**  display Switching Item Details.  DisplayOnly Flag will be set to TRUE.
*/
    IF Item.MoveCategory = MoveCategory$InformationItem THEN
       InfoItem = TRUE;
    ELSE
       InfoItem = FALSE;
    ENDIF;

    IF DisplayOnly = TRUE THEN

        FIELD(CardClass_Opt).CurBias = FB_VISIBLE;

        FIELD(InfoItem).CurBias = FB_INVISIBLE;
        TOMove = Item.TOMove;
        
        ItemDetails = ItemDetails.RetrieveItem (Job = Item.Job,
						ArchiveItem = ArchiveItem);

        IF ItemDetails IS NOT NULL THEN
           Description = ItemDetails.Description;
           Infostack.SelectedCat.Category = ItemDetails.Category;
           Infostack.SelectedCat.Name = ItemDetails.CategoryName;
           Infostack.SelectedCat.Severity = ItemDetails.Severity;
        ENDIF;     
/*
**  Load linked equipment for an information item.
*/          
        IF InfoItem = TRUE THEN

           IF ArchiveItem = FALSE THEN

              i = 1;
              REPEATED
              SELECT :InfoStack.LinkedEquip[i].Object = O.Object, 
                     :InfoStack.LinkedEquip[i].Name = O.Name,
                     :InfoStack.LinkedEquip[i].Type  = O.Type,
                     :InfoStack.LinkedEquip[i].TypeName  = O.TypeName,
                     :InfoStack.LinkedEquip[i].Description = O.Description
              FROM    Udb_Object O,
                      SLC_InformationItemEquip E
              WHERE   E.Job = :Item.Job AND
                      E.Equip = O.Object
              ORDER BY Description, Name
              BEGIN
                 i = i + 1;
              END;          
           ELSE

              i = 1;
              REPEATED
              SELECT :InfoStack.LinkedEquip[i].Object = O.Object, 
                     :InfoStack.LinkedEquip[i].Name = O.Name,
                     :InfoStack.LinkedEquip[i].Type  = O.Type,
                     :InfoStack.LinkedEquip[i].TypeName  = O.TypeName,
                     :InfoStack.LinkedEquip[i].Description = O.Description
              FROM    Udb_Object O,
                      SLC_ArchiveInfItemEquip E
              WHERE   E.Job = :Item.Job AND
                      E.Equip = O.Object
              ORDER BY Description, Name
              BEGIN
                 i = i + 1;
              END;          
           ENDIF;
        ENDIF;
    ENDIF;
   
    CurFrame.SendUserEvent( EventName = 'Setup');    
END;

/**
 **  Time to load equipment
 **/
ON Userevent 'LoadEquip' =
BEGIN
/**
 **  Load the data for the equipment selection from the database
 **  if they are going to be adding an info item
 **/
    Sub.SelectEquip.Clear();        /* Clear out storage */

    i = 1;
    REPEATED
    SELECT :Sub.SelectEquip[i].Object = O.Object, 
           :Sub.SelectEquip[i].Name = O.Name,
           :Sub.SelectEquip[i].Type  = O.Type,
           :Sub.SelectEquip[i].TypeName  = O.TypeName,
           :Sub.SelectEquip[i].Description = O.Description
    FROM    Udb_Object O,
            Udb_Grouping G,
            Udb_ExtendedType E
    WHERE   G.Grouping = :EquipSubstation AND
            G.Relationship = :Interaction$MemberOf AND             
	    O.Object = G.Member AND
            E.Type NOT IN (SELECT Type 
                           FROM Udb_ExtendedType
                           WHERE SuperType IN (:Type$Feeder, :Type$Line)) AND
            E.SuperType = :Type$Conducting AND
            G.MemberType = E.Type
    ORDER BY Description, Name
    BEGIN
       i = i + 1;
    END;          
END;                 

ON SetValue CardClass_opt = 
BEGIN
   CardClass = FIELD(CardClass_Opt).CurEnumValue;
   CardClassName = FIELD(CardClass_Opt).CurEnumText;
END;

ON ChildEntry Sub.SelectEquip =
BEGIN
/**
 **  Handle an equip selection from the list
 **/
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
    ENDIF;

    j = FIELD(Sub.SelectEquip).CurRow;    
/*
** Validate that equip not already in list
*/
    i = 1;
    WHILE i <= Infostack.LinkedEquip.LastRow() DO
       IF Infostack.LinkedEquip[i].Object = Sub.SelectEquip[j].Object THEN
          FIELD(Sub).CurBias = FB_INVISIBLE;
          FIELD(OK_Btn).CurBias = FB_LANDABLE;
          RESUME;
          ENDLOOP;
       ENDIF;
       i = i + 1;
    ENDWHILE;
/*
**  Insert into database
*/ 
    RetCode = ItemDetails.InsertEquipLink (
                  Equip = Sub.SelectEquip[j].Object,
                  Substation = CardSubstation);

    IF RetCode = PU_CANCEL THEN
       FIELD(Sub).CurBias = FB_INVISIBLE;
       FIELD(OK_Btn).CurBias = FB_LANDABLE;
       RESUME;
    ENDIF;

    i = Infostack.LinkedEquip.lastRow() + 1;
    Infostack.LinkedEquip.InsertRow(RowNumber = i);
    Infostack.LinkedEquip[i].Object = Sub.SelectEquip[j].Object;
    Infostack.LinkedEquip[i].Name = Sub.SelectEquip[j].Name;
    Infostack.LinkedEquip[i].Type = Sub.SelectEquip[j].Type;
    Infostack.LinkedEquip[i].TypeName = Sub.SelectEquip[j].TypeName;
    Infostack.LinkedEquip[i].Description = Sub.SelectEquip[j].Description; 
 
    FIELD(Sub).CurBias = FB_INVISIBLE;
    FIELD(OK_Btn).CurBias = FB_LANDABLE;
END;

ON CLICK Sub.Cancel_Btn =
BEGIN
/* 
** No Equipment Selected
*/
    FIELD(Sub).CurBias = FB_INVISIBLE;
    FIELD(OK_Btn).CurBias = FB_LANDABLE;
END;


ON CLICK Infostack.UnLinkBtn =
BEGIN
/*
** Remove information item equipment link.
*/ 
   i = 0;
   i = FIELD(Infostack.LinkedEquip).CurRow;
   IF i = 0 THEN
      MESSAGE 'No Equipment selected';
      RESUME;
   ENDIF;
/*
** Don't allow removal if move is linked to the equip.
*/
   IF Item.Equip = Infostack.LinkedEquip[i].Object THEN
      MESSAGE 'The Information Item Job is linked to this Equipment. ' +
              'The link may not be removed.';
      RESUME;
   ENDIF;

   RetCode = ItemDetails.RemoveEquipLink (
               Equip = Infostack.LinkedEquip[i].Object);
   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;

   Infostack.LinkedEquip.RemoveRow (rownumber = i);
END;


ON CLICK Infostack.LinkBtn =
BEGIN
/* 
**  Display equipment list for equip selection.
*/
   IF ItemDetails.Job = 0 THEN
      ItemDetails.Job = CALLPROC SOA_JobLastKey();

      IF ItemDetails.Job < 0 THEN
         CALLPROC DDB_ROLLBACK;
         ItemDetails.Job = 0;
         MESSAGE 'Unable to get job number for new information item';
         RESUME;
      ENDIF;
   ENDIF;
   CALLPROC DDB_COMMIT;

   FIELD(Sub).XRight = FIELD(Infostack).XRight;
   FIELD(Sub).YBottom = FIELD(Infostack).YBottom;
   FIELD(Sub).CurBias = FB_CHANGEABLE;
   FIELD(OK_Btn).CurBias = FB_DIMMED;
   CurFrame.Flush();
END;


ON CLICK PhraseBtn =
BEGIN
/*
**  Edit title and description using phrase builder.
*/
   CALLFRAME BuildInfItemPhrase (
        PassedTitle = BYREF(TOMove),
        PassedDescription = BYREF(Description),
        LinkedEquip = Infostack.LinkedEquip);
END;

/**
 **  Handle a change in the ItemType field "InfoItem"
 **/
ON UserEvent 'Setup',
ON SetValue InfoItem =
BEGIN     
/*
** Load information and visibility as appropriate for switching item or
** informational item
*/ 
    IF (InfoItem = FALSE) THEN
        FIELD(InfoStack).CurBias = FB_INVISIBLE;                                      
        FIELD(PhraseBtn).CurBias = FB_INVISIBLE;                                      
        FIELD(ItemTitleLabel).TextValue = 'Switching Item Title';
        FIELD(ItemDescriptionLabel).TextValue = 'Switching Item Description'; 
/*
**  IF Display only was set, we don't want them to be able to change it.
*/
        IF FIELD(CardClass_opt).CurBias <> FB_VISIBLE THEN
           FIELD(CardClass_opt).CurBias = FB_CHANGEABLE;
        ENDIF;
    ELSE
        IF PassedMode = FM_READ THEN
           FIELD(PhraseBtn).CurBias = FB_INVISIBLE;                                      
        ELSE
           FIELD(PhraseBtn).CurBias = FB_LANDABLE;                                      
        ENDIF;
        FIELD(CardClass_opt).CurBias = FB_INVISIBLE;
        FIELD(InfoStack).CurBias = FB_CHANGEABLE;
        FIELD(ItemTitleLabel).TextValue = 'Information Item Title';
        FIELD(ItemDescriptionLabel).TextValue = 'Information Item Description';
/*
**  Load category list
*/
        i = 1;
        SELECT :CatForm.Cat[i].Category = Category,
               :CatForm.Cat[i].Name = Name,
               :CatForm.Cat[i].Severity = Severity
        FROM   SLC_ItemCategory
        WHERE  Category > 0   /*Avoid PlaceHolder*/
        BEGIN
           i = i + 1;
        END;
/*
**  If Multiple kV Substation, load substation list for selection; else
**  just use the substation for the card.
*/
        IF ( MultiplekVFlag = TRUE) THEN
            FIELD(Sub.Substack).CurBias = FB_CHANGEABLE;
            FIELD(Sub.Substack.SubstationRef).CurBias = FB_CHANGEABLE;

            FIELD(Sub.SubStack.SubstationRef).ValueList.ChoiceItems.Clear();
 
            i = 1;        
            SELECT  :TempObject = O.Object,
	            :TempName = O.Description
            FROM    Udb_Object O,
                    Udb_Grouping G
            WHERE   G.Grouping = :CardSubstation
            AND     G.Relationship = :Interaction$MemberOf
            AND     O.Object = G.Member
            AND     G.Reference > 0
            ORDER BY 2
            BEGIN
                 IF i = 1 THEN
                    EquipSubstation = TempObject;
                    CurFrame.SendUserEvent( EventName = 'LoadEquip' );
                 ENDIF;
                    FIELD(Sub.Substack.SubstationRef).ValueList.ChoiceItems[i].EnumValue =
                 TempObject;
	      FIELD(Sub.Substack.SubstationRef).ValueList.ChoiceItems[i].EnumText =                   
                 TempName;
              i = i + 1;
            END;
           
            IF i = 1 THEN
               MESSAGE 'Unable to find member substations for multiple kV ' +
                       'Substation.';
               RETURN;
            ENDIF;
            FIELD(Sub.Substack.SubstationRef).UpdChoiceList(); 
                                                                     
        ELSE
            FIELD(Sub.Substack).CurBias = FB_INVISIBLE;
            EquipSubstation = CardSubstation;
            IF ArchiveItem = FALSE THEN 
               CurFrame.SendUserEvent( EventName = 'LoadEquip' );
            ENDIF;
        ENDIF;

    ENDIF;

    CurFrame.Flush();
    CurFrame.SetAttribute( 
       WindowWidth = STACKFIELD(FIELD(InfoItem).ParentField).OuterWidth+10,
       WindowHeight = STACKFIELD(FIELD(InfoItem).ParentField).OuterHeight+10);
    CurFrame.FLUSH();
    CurFrame.WindowVisibility = WV_VISIBLE;
END;


ON SetValue Sub.Substack.SubstationRef =
BEGIN
/**
 **  On selection of a kV substation Value
 **/
    EquipSubstation = Sub.Substack.SubstationRef;
    CurFrame.SendUserEvent( EventName = 'LoadEquip' );
END;


ON ENTRY InfoStack.SelectedCat.Name = 
BEGIN
/*
** Enable Category selection
*/ 
   FIELD(Catform).XLeft = FIELD(Infostack).XLeft;
   FIELD(Catform).YTop = FIELD(Infostack).YTop;
   FIELD(Catform).CurBias = FB_CHANGEABLE;
   FIELD(Infostack.LinkBtn).CurBias = FB_DIMMED;
   FIELD(Infostack.UnlinkBtn).CurBias = FB_DIMMED;
   FIELD(OK_Btn).CurBias = FB_DIMMED;
   CurFrame.Flush();
END;


ON ChildEntry Catform.Cat =
BEGIN
/**
 **  Handle a category selection from the list
 **/
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
   ENDIF;

   j = FIELD(Catform.Cat).CurRow;    

   Infostack.SelectedCat.Category = Catform.Cat[j].Category;
   Infostack.SelectedCat.Name = Catform.Cat[j].Name;
   Infostack.SelectedCat.Severity = Catform.Cat[j].Severity;

   FIELD(Catform).CurBias = FB_INVISIBLE;
   FIELD(Infostack.LinkBtn).CurBias = FB_LANDABLE;
   FIELD(Infostack.UnlinkBtn).CurBias = FB_LANDABLE;
   FIELD(OK_Btn).CurBias = FB_LANDABLE;
   CurFrame.Flush();
END;

ON SETVALUE Infostack.SelectedCat.Severity =
BEGIN
/*
** Validate Severity values since it can be modified by the user
*/    
    IF Infostack.SelectedCat.Severity < 1 OR 
       Infostack.SelectedCat.Severity > 3 THEN
       Message 'Severity must be 1, 2, or 3.';
       CurFrame.InputFocusField = FIELD(Infostack.SelectedCat.Severity);
       RESUME;
    ENDIF;  
END;

       
ON Click OK_Btn,
ON USEREVENT 'Shadow' =
BEGIN
/*
** Insert new switching item, or if it already exists, call update method.
*/
    IF TOMove = '' THEN
       MESSAGE 'Cannot save a blank switch or informational item.';
       RESUME;
    ENDIF;
/*
** Validate info item fields 
*/    
    IF InfoItem = TRUE AND 
        Infostack.SelectedCat.Category = 0 THEN 
       Message 'Please select a category for this information item';
       CurFrame.InputFocusField = FIELD(Infostack.SelectedCat.Name);
       RESUME;
    ENDIF; 
 
    IF InfoItem = TRUE AND 
        Infostack.LinkedEquip.LastRow() = 0 THEN
        IF CurFrame.ConfirmPopUp (messagetext = 'Save without linking ' +
              + 'to equipment?') = PU_CANCEL THEN
           RESUME;
        ENDIF;
    ENDIF; 
 
    IF InfoItem = TRUE AND 
       (Infostack.SelectedCat.Severity < 1 OR 
        Infostack.SelectedCat.Severity > 3) THEN
       Message 'Severity must be 1, 2, or 3.';
       CurFrame.InputFocusField = FIELD(Infostack.SelectedCat.Severity);
       RESUME;
    ENDIF;  

    IF InfoItem = FALSE AND
       CardClass = 0 THEN
       Message 'No Card Class was selected.';
       RESUME;
    ENDIF;

    IF DisplayOnly = TRUE THEN
       CurFrame.SendUserEvent (EventName = 'UpdateItem');
       RESUME;
    ENDIF;     
 
    IF ItemDetails.Job <> 0 THEN
       NewItem.Job = ItemDetails.Job;
    ELSE
       NewItem.Job = CALLPROC SOA_JobLastKey();
    ENDIF;

    IF NewItem.Job < 0 THEN
       CALLPROC DDB_ROLLBACK;
       IF InsertShadow = TRUE OR InsertOnly = TRUE THEN
          CurFrame.WindowVisibility = WV_VISIBLE;
          MESSAGE 'Error obtaining next job key.';
          RETURN;
       ELSE
          MESSAGE 'Error obtaining next job key.';
          RESUME;
       ENDIF;
    ENDIF;
    CALLPROC DDB_COMMIT;

    NewItem.TOMove = TOMove;
    NewItem.Category = Infostack.SelectedCat.Category;
    NewItem.Severity = Infostack.SelectedCat.Severity;
    NewItem.Description = Description;
    NewItem.CardClass = CardClass;
    NewItem.CardClassName = CardClassName;
    NewItem.SwitchingItem = NewItem.Job;
    NewItem.TOComplete = '';
    NewItem.RSIssued = '';
    IF InsertShadow = TRUE OR InsertOnly = TRUE THEN
       NewItem.SwItemStatus = Card$Active;
       IF XATime = '' THEN
          NewItem.TOIssued = DATE('now');
       ELSE
          NewItem.TOIssued = XATime;   
       ENDIF;
       NewItem.TOComplete = '';
       NewItem.Response = 'Active';
    ELSE
       NewItem.SwItemStatus = Card$Open;
       NewItem.Response = 'Open';
    ENDIF;
    NewItem.JobClass = 0;
    NewItem.Status = '';
    NewItem.Equip = 0;
    NewItem.EquipClass = 0;
    NewItem.EquipClassName = '';
    NewItem.EquipName = '';        
            
    IF ( InfoItem = TRUE ) THEN
        NewItem.MoveCategory = MoveCategory$InformationItem;
/*
** Force job equip to be first one in list.  Cannot subsequently be changed.
*/      
        IF Infostack.LinkedEquip.LastRow() > 0 THEN   

           IF Infostack.LinkedEquip.LastRow() > 1 THEN 
              IF CurFrame.ConfirmPopUp (messagetext = 'Equipment: ' +
                    Infostack.LinkedEquip[1].TypeName + '   ' + 
                    Infostack.LinkedEquip[1].Name + ' will be linked ' +
                    'to the move. ' +
                    'If you want a different piece of equipment linked, ' +                          'edit the equipment list so that it appears at the top.')
                         <> PU_OK THEN
                  RESUME;
              ENDIF;
           ENDIF;

           NewItem.Equip = Infostack.LinkedEquip[1].Object;
           NewItem.EquipClass = Infostack.LinkedEquip[1].Type;
           NewItem.EquipClassName = Infostack.LinkedEquip[1].TypeName;
           NewItem.EquipName = Infostack.LinkedEquip[1].Name; 
        ENDIF;       
    ELSE
        NewItem.MoveCategory = MoveCategory$SwitchingItem;
        IF InsertShadow <> TRUE AND InsertOnly <> TRUE THEN
           /*
           **  Prompt D.O. to enter reason for outage that will be downloaded to CTSEOS.
           */
           IF CardClass = Type$SLCAuto THEN
              CTSEOS_Reason = 'Under Investigation';
           ELSE
              /*
              **  Edit title and description using phrase builder.
              ************** USE Switching Item Title ************
              CALLFRAME BuildCTSEOSReason (
                 PassedCard = SubstationCard,
                 PassedApp = Application$SLC,             
                 PassedDescription = BYREF(CTSEOS_Reason));
              ****************************************************/
              CTSEOS_Reason = NewItem.TOMove;
           ENDIF;      
        ENDIF;
    ENDIF;
    MoveCategory = NewItem.MoveCategory; 
          
    RetCode = NewItem.InsertItem (Card = SubstationCard);

    IF RetCode = PU_OK THEN
       SwItemTOMove = NewItem.TOMove;
       /*
       **  If a CTSEOS Reason was entered. Update the field now.
       */
       RetCode = CALLPROC SOA_CTSEOSUpd
                  (Object = NewItem.Job,
                   Application = Application$SLC,
                   Reason = CTSEOS_Reason);
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          CurFrame.Trace (text = VARCHAR(DATE('now')) + ' : ' +
                  'Error setting CTSEOS Reason for SLC card ' +
                  varchar(SubstationCard) + ' Switching Item ' +
                  varchar(NewItem.Job));
       ENDIF;
       CALLPROC DDB_COMMIT;

       IF InsertOnly = TRUE AND CardClassName <> 'TEST' THEN
         ControlText = VARCHAR(SubstationCard) + ';' + VARCHAR(NewItem.Job);
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSActivateCard',
                     EventText = ControlText); 
       ENDIF;
 
       RETURN NewItem.Job;
    ELSE
       RESUME;
    ENDIF;
END;
 

ON USEREVENT 'UpdateItem' =
BEGIN
/*
**  Update Item Information
*/
    IF ItemDetails.Job = 0 THEN
       MESSAGE 'Information Item Job identifier not known';
       RESUME;
    ENDIF;

    ItemDetails.TOMove = TOMove;
    ItemDetails.Category = Infostack.SelectedCat.Category;
    ItemDetails.Severity = Infostack.SelectedCat.Severity;
    ItemDetails.Description = Description;
    ItemDetails.CardClass = CardClass;
    ItemDetails.CardClassName = CardClassName;

    RetCode = ItemDetails.ItemUpdate();

    IF RetCode = PU_OK THEN
       SwItemTOMove = TOMove;
       RETURN ItemDetails.Job;
    ELSE
       RESUME;
    ENDIF;
END;


ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return PU_OK;
END;


ON CLICK Cancel_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN PU_OK;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;



