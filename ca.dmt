	Name:            GetBusSection

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          GetBusSection         
**
**  Modifications:
**  01/17/13   em   Created from CAC Get ConnectedSourceBreakers 
**  09/06/13   em   Willing to find and return multiple Bus Sections,
**                  Special case in JAM_27 is hard-coded.
**  06/08/17   em   Transfer from FMS_XAMonitor, modify to use QGIS Trace algorithm
*/
PROCEDURE GetBusSection
(
   Substation       = INTEGER NOT NULL;     /* Parameter*/
   Equip            = INTEGER NOT NULL;     /* Parameter*/
   BusArray         = ARRAY OF INTEGEROBJECT;   /* Exit Parameter*/
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   k		= INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   BusSect      = INTEGER NOT NULL WITH DEFAULT;
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_ConnectedBusSection DEFAULT NULL;
ENDDECLARE
BEGIN
/*
** Now we trace starting from the passed equipment and trace looking for BusSect
** type Equip.  Trace should stop within a few devices in each direction - do not extend outside
** scope of substation.
*/
   Trace = Trace_ConnectedBusSection.Create();
   Trace.TraceEquip.Object = Equip;
   Trace.Substation = Substation;
   TraceStatus = 0;
   
   TraceStatus = Trace.StartTargetTrace();
      
   IF Trace.ReturnCode <> 0 THEN
      CALLPROC TraceError (
               UserMessage = 'ERROR: The connectivity trace ' + 
                  ' discovered database problem: ' + Trace.ErrorMessage,
               TraceMessage = 'GetConnectedSourceBreakers: The connectivity trace from ' + 
                  ' Object ' + VARCHAR(Equip) + ' discovered database problem: ' + Trace.ErrorMessage);
   ENDIF;

   /*
   ** Convert source breakers from QGis_Trace_Engine!Equipment to CAC!Equipment
   */
   IF Trace.BusSect = TRUE THEN
      BusArray = Trace.BusArray.Duplicate();
   ENDIF;

   RETURN (Trace.BusSect);
END;


Application Component Report
