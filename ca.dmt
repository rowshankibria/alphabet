#  include TM_AlertTableUpdates

/**************************************************************/
/**           Start of Out of Service Time                   **/
/**************************************************************/
/*
**  Load TM_BogeyAlert table with out of service data.
*/
   CurObject.DList.Clear();
   i = 1;
   REPEATED 
   SELECT CurObject.Dlist[i].Card = A.Card,
          CurObject.Dlist[i].Type = A.Type,
          CurObject.Dlist[i].StartTime = A.StartTime,
          CurObject.Dlist[i].Description = A.Description,
          CurObject.Dlist[i].Division = A.Division,
          CurObject.Dlist[i].Feeder = A.Feeder,
          CurObject.Dlist[i].FeederName = A.FeederName,
          CurObject.Dlist[i].AlertTime = A.AlertTime,
          CurObject.Dlist[i].Object = A.Object,
          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :TM$OtherType AND
          A.Status = :TM$StatusOutOfService
   ORDER BY Card
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   IF BogeyEnabled = TRUE THEN
      REPEATED 
      SELECT CurObject.clist[i].Card = C.Card,
             CurObject.clist[i].Type = :TM$OtherType,
             CurObject.clist[i].Description = 'Total duration that feeder has been out of service.',
             CurObject.clist[i].Division = OO.PrimaryGrouping,
             CurObject.clist[i].Feeder = C.Feeder,
             CurObject.clist[i].FeederName = C.FeederName,
             CurObject.clist[i].CardClass = C.CardClass,
             CurObject.clist[i].CardClassName = C.CardClassName,
             CurObject.clist[i].Object = 0,
             CurObject.clist[i].Status = :TM$StatusOutOfService,
             CurObject.clist[i].StartTime = C.CutOut
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object OO,
             Udb_ExtendedType ET
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey <= 0 AND  /* -1 means no fault info entered by cutin */
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
            (C.OpenAutoPlus IS NULL OR
             C.OpenAutoPlus = '') AND
             C.Card = CTO.Card AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = OO.Object AND
             OO.Type = ET.Type AND
             ET.SuperType = :Type$Substation 
      UNION
      SELECT C.Card,
             :TM$OtherType,
             'Total duration that feeder has been out of service.',
             OO.Object,
             C.Feeder,
             C.FeederName,
             C.CardClass,
             C.CardClassName,
             0,
             :TM$StatusOutOfService,
             C.CutOut
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object OO
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey <= 0 AND  /* -1 means no fault info entered by cutin */
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
            (C.OpenAutoPlus IS NULL OR
             C.OpenAutoPlus = '') AND
             C.Card = CTO.Card AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = OO.Object AND
             OO.Type = :Type$Division 
      ORDER BY Card
      BEGIN
         i = i + 1;
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

#  include TM_AlertTableUpdates

