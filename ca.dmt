Application Component Report
============================

	Name:            ReOrderMoves

/*
**
**      Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
** This frame takes as input, an array of jobs.
** The user graphically manipulates the order of the array. 
** The new order is reflected in an array of integers which is returned
** (byref) to the user.
**
**  Application: SOA
**  Frame:       ReOrderMoves
**
**  Date:       Version Description
** ----------------------------------
**  04/25/98 em  Copied SLC Version
**  12/15/05 ysp increase the size of tomove to 160 characters
**  11/17/14 em  Copied here from SOA to be able to reorder XA21 call-up sequence
*/
INITIALIZE (  
   
#  include StandardDeclarations
    Jobs = ARRAY of Job;
    Idx = ARRAY of IntegerObject;
    Title = varchar(80) not null;
    j = integer not null;
    k = integer not null;
    SortedFlag = INTEGER NOT NULL;
    Sptr = ARRAY of StackField;    /* used to keep track of each "row" */

    TmpStackPtr1 = StackField;      /* used for framesize manipulation, and scrollbar */   
    TmpStackPtr2 = StackField;      /* used for framesize manipulation, and scrollbar */   
    SizeFactor  = Integer not null;
    NO_OF_ROWS  = Integer not Null;  /* holds number of rows to show before putting up scrollbar */
    SCROLLBARWIDTH  = Integer not Null;  /* Represents width if scrollbar */
    
) =
BEGIN
    /* Set up Title info */
    NO_OF_ROWS = 20;
    CurFrame.WindowTitle = 'Re-order Moves';
    HVP.header.equipclassname = '  Type';
    HVP.header.equipname = ' Equipment';
    HVP.header.tomove = Title;

    /* set up index to match incoming data */
    Idx.Clear();
    i = 1;
    WHILE i <= Jobs.NumRows() do
        Idx[i].value = i;
        i = i + 1;
    ENDWHILE;

    /* Load Jobs onto screen */    
    j = Jobs.NumRows();
    i = 1;
    WHILE i <= j DO
	
        VP.Template.EquipClassName = Jobs[i].EquipClassName;
        VP.Template.EquipName      = Jobs[i].EquipName;
        VP.Template.ToMove         = Jobs[i].ToMove;

        Sptr[i] = Field(VP.Template).Duplicate();
        Sptr[i].ParentField = field(VP.Template).Parentfield;
        i = i + 1;
    ENDWHILE;

    /* Save pointer to templates parentfield */
    TmpStackPtr1 = field(VP.Template);
    TmpStackPtr2 = TmpStackPtr1.ParentField;

    /* Get Rid of the template */
    field(VP.Template).ParentField = NULL;

    /* set a Factor to be to be used in frame size manipulation later */
    IF TmpStackPtr2.ChildFields.LastRow() <= NO_OF_ROWS THEN
        SizeFactor = TmpStackPtr2.ChildFields.LastRow() + 2;
    ELSE
        SizeFactor = NO_OF_ROWS + 2;
    Endif;

    /* Call another userevent to force the frame to realize itself before I can get
       a true measurement
    */
    Curframe.SendUserevent(Eventname = 'init');
            
END; 

ON USEREVENT 'init' =
BEGIN
    CurFrame.Flush();
    field(VP).Height = tmpStackPtr1.Height * SizeFactor;
/* 
   Because of the different displays this will run on, and the nature of viewports
   on these displays, it is necessary to progromatically
   manipulate the width of the viewport eventhough the width is constant.           
   For centering purposes, there is also a viewport surrounding the
   "header" stack.  Its width is also manipulated.      
*/
    field(VP).Width  = tmpStackPtr2.Width + 550;
    field(HVP).Width  = tmpStackPtr2.Width + 550;
/*
    Now adjust the window height and width to accomodate the 
    size of encompassing fields.
    ("Sized to fit fields" does not work after the frame is initially realized)
*/
    CurFrame.Flush();

    CurFrame.WindowHeight = Field(VP).ParentField.ParentField.OuterHeight + 2*Curframe.GridY;
    CurFrame.WindowWidth = Field(VP).ParentField.ParentField.OuterWidth + 2*Curframe.GridX;
    CurFrame.Flush();

END;    


ON CLICK OK_BTN =
BEGIN
    SortedFlag = 0;
    /* use bubble sort to sort by Y position */
    i = 1;
    WHILE i <= Sptr.NumRows() DO
        j = i+1;
        WHILE j <= Sptr.NumRows() DO
           IF Sptr[idx[i].value].Ytop > Sptr[idx[j].value].Ytop THEN
                k = Idx[j].value;
                Idx[j].value = Idx[i].value;
                Idx[i].value = k;
                SortedFlag = 1;
           ENDIF;
           j = j + 1;
        ENDWHILE;
        i = i + 1;
    ENDWHILE;

    IF SortedFlag = 0 THEN
        RETURN PU_CANCEL;
    ELSE
        RETURN PU_OK;       
    ENDIF;
END;


ON CLICK Cancel_Btn =
BEGIN
    RETURN PU_CANCEL;
END; 


