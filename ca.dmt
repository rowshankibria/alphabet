**  12/04/08    em    Created
**  06/25/09    ysp   set archived permit's EstTimeComplete to blank because
**                    this field is not in the archive table.
*/ 

METHOD RetrieveWorkPermit (
   Job		= INTEGER NOT NULL
) =
DECLARE

ENDDECLARE
BEGIN
   IF ArchiveCard = FALSE THEN
      SELECT :CurObject.PermitJobID = PermitJobID
            ,:CurObject.Description = Description
            ,:CurObject.EstTimeComplete = EstTimeComplete
            ,:CurObject.PreIssued = PreIssued
            ,:CurObject.ShiftStartTime = ShiftStartTime
      FROM   TC_WorkPermit
      WHERE  PermitJobID = :Job;
   ELSE
      SELECT :CurObject.PermitJobID = PermitJobID
            ,:CurObject.Description = Description
            ,:CurObject.EstTimeComplete = ''
            ,:CurObject.PreIssued = PreIssued
            ,:CurObject.ShiftStartTime = ShiftStartTime
      FROM   TC_ArchiveWorkPermit
      WHERE  PermitJobID = :Job;
   ENDIF;

   IF iirowcount = 0 THEN
      RETURN NULL;
   ENDIF;
   RETURN :CurObject;
END;


METHOD UpdateWorkPermit (
   PermitJobID	= INTEGER NOT NULL
) =
DECLARE
   RetCode	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN

      RetCode = CALLPROC TC_WorkPermitJobUpd (
          Job 	= PermitJobID
         ,Description 	= :CurObject.Description
         ,TOMove = :CurObject.TOMove
         ,RSMove = :CurObject.RSMove
         ,PreIssued = :CurObject.PreIssued
         ,ShiftStartTime = :CurObject.ShiftStartTime
         );

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'Insert/Update into TLS_WorkPermit was not successful.',
                           TraceMessage =
             'WorkPermit:UpdateWorkPermit; Insert/update into SOA_WorkPermit was not successful.'
             );
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
         RETURN PU_OK;
      ENDIF;

END;

