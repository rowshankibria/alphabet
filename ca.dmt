** 07/06/10  ysp  add GetAllOutages for web service
** 07/10/12  ysp  Add new columns. New FBMPR replaces Backup Timer. But, for now, keep Backup Timer 
**                 attributes in the class because BFC web service still uses these attributes.
** 02/03/15  ysp  Change attribute BFCMatrix to BFCMatrices and method LoadBFCMatrix to LoadBFCMatrices 
**                to support "High Load" matrix.
**
*/
METHOD LoadBFCMatrices(
)=
BEGIN
   CurObject.BFCMatrices[1] = BusFaultCorrelation_ASE.Create();
   CurObject.BFCMatrices[1].MatrixType = 0;
   CurObject.BFCMatrices[1].LoadMatrix();
   
   CurObject.BFCMatrices[2] = BusFaultCorrelation_ASE.Create();
   CurObject.BFCMatrices[2].MatrixType = 1;
   CurObject.BFCMatrices[2].LoadMatrix();
END;

METHOD GetRecommendation(
   BFCCond = BusFaultOutageClass;
) = 
DECLARE
   MIdx = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';
   
   MIdx = 1;      // default
   IF BFCCond.GetMatrixType() = 1 THEN
      MIdx = 2;   // high load
   ENDIF;
   CurObject.BFCMatrices[MIdx].GetRecommendation(BFCCond = ByRef(BFCCond));
END;

METHOD LoadOutageList(
   ActiveOutage = INTEGER NOT NULL WITH DEFAULT,
   StartDate = DATE NOT NULL WITH DEFAULT,
   EndDate = DATE NOT NULL WITH DEFAULT
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   MIdx = INTEGER NOT NULL WITH DEFAULT;
   CondSum = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';

   CurObject.BFOList.Clear();
   i = 1;
   IF ActiveOutage = TRUE THEN
      IF CurObject.FilterType = 'SUBSTATION' OR CurObject.FilterType = 'BUS' THEN

         IF CurObject.FilterType = 'SUBSTATION' THEN
            DynamicWhereClause = 'B.Substation = ' + VARCHAR(CurObject.FilterObject) + ' AND ';
         ELSE
            DynamicWhereClause = 'B.BusSection = ' + VARCHAR(CurObject.FilterObject) + ' AND ';
         ENDIF;
         
         DynamicWhereClause = DynamicWhereClause + 
               'B.SwitchingItem = J.Job AND ' + 
               'J.SWItemStatus = ' + VARCHAR(Card$Active) + ' AND ' + 
               'B.Substation = O1.Object AND ' + 
               'B.BusSection = O2.Object';
               
         SELECT :CurObject.BFOList[i].Substation = B.Substation,
               :CurObject.BFOList[i].SubstationName = O1.Description,
               :CurObject.BFOList[i].SwitchingItem = B.SwitchingItem,
               :CurObject.BFOList[i].CreationTime = B.CreationTime,
               :CurObject.BFOList[i].BusSection = B.BusSection,
               :CurObject.BFOList[i].BusSectionName = O2.Name,
               :CurObject.BFOList[i].BDPhaseA = B.BDPhaseA,
               :CurObject.BFOList[i].BDPhaseB = B.BDPhaseB,
               :CurObject.BFOList[i].BDPhaseC = B.BDPhaseC,
               :CurObject.BFOList[i].BDRelayName = B.BDRelayName,
               :CurObject.BFOList[i].BDLastUpd = B.BDLastUpd,
               :CurObject.BFOList[i].BOCPhaseA = B.BOCPhaseA,
               :CurObject.BFOList[i].BOCPhaseB = B.BOCPhaseB,
               :CurObject.BFOList[i].BOCPhaseC = B.BOCPhaseC,
               :CurObject.BFOList[i].BOCPhaseN = B.BOCPhaseN,
               :CurObject.BFOList[i].BOCRelayName = B.BOCRelayName,
               :CurObject.BFOList[i].BOCLastUpd = B.BOCLastUpd,
/*
               :CurObject.BFOList[i].BUTOperated = B.BUTOperated,
               :CurObject.BFOList[i].BUTRelayName = B.BUTRelayName,
               :CurObject.BFOList[i].BUTLastUpd = B.BUTLastUpd,
*/
               :CurObject.BFOList[i].BUTOperated = B.FBMPR,
               :CurObject.BFOList[i].BUTRelayName = B.FBMPRValue,
               :CurObject.BFOList[i].BUTLastUpd = B.FBMPRTime,

               :CurObject.BFOList[i].ClFdrBkr = B.ClFdrBkr,
               :CurObject.BFOList[i].ClFdrBkrs = B.ClFdrBkrs,
               :CurObject.BFOList[i].ClFdrBkrLastUpd = B.ClFdrBkrLastUpd,
               :CurObject.BFOList[i].FTFeeder = B.FTFeeder,
               :CurObject.BFOList[i].FTPhaseA = B.FTPhaseA,
               :CurObject.BFOList[i].FTPhaseB = B.FTPhaseB,
               :CurObject.BFOList[i].FTPhaseC = B.FTPhaseC,
               :CurObject.BFOList[i].FTPhaseN = B.FTPhaseN,
               :CurObject.BFOList[i].FTRelayName = B.FTRelayName,
               :CurObject.BFOList[i].FTLastUpd = B.FTLastUpd,
               :CurObject.BFOList[i].PQFound = B.PQFound,
               :CurObject.BFOList[i].PQValue = B.PQValue,
               :CurObject.BFOList[i].PQTime = B.PQTime,
               :CurObject.BFOList[i].VBFault = B.VBFault,
               :CurObject.BFOList[i].VBFDescription = B.VBFDescription,
               :CurObject.BFOList[i].VBFLastUpd = B.VBFLastUpd,

               :CurObject.BFOList[i].FBMPR = B.FBMPR,
               :CurObject.BFOList[i].FBMPRValue = B.FBMPRValue,
               :CurObject.BFOList[i].FBMPRTime = B.FBMPRTime,
               :CurObject.BFOList[i].FBLOR = B.FBLOR,
               :CurObject.BFOList[i].FBLORValue = B.FBLORValue,
               :CurObject.BFOList[i].FBLORTime = B.FBLORTime,
               :CurObject.BFOList[i].BBMPR = B.BBMPR,
               :CurObject.BFOList[i].BBMPRValue = B.BBMPRValue,
               :CurObject.BFOList[i].BBMPRTime = B.BBMPRTime,
               :CurObject.BFOList[i].BBLOR = B.BBLOR,
               :CurObject.BFOList[i].BBLORValue = B.BBLORValue,
               :CurObject.BFOList[i].BBLORTime = B.BBLORTime,
               :CurObject.BFOList[i].PQRMSFound = B.PQRMSFound,
               :CurObject.BFOList[i].PQRMSValue = B.PQRMSValue,
               :CurObject.BFOList[i].PQRMSTime = B.PQRMSTime,
               :CurObject.BFOList[i].MHEvent = B.MHEvent,
               :CurObject.BFOList[i].MHDescription = B.MHDescription,
               :CurObject.BFOList[i].MHLastUpd = B.MHLastUpd,                   
               :CurObject.BFOList[i].VFFOD = B.VFFOD,
               :CurObject.BFOList[i].VFFDescription = B.VFFDescription,
               :CurObject.BFOList[i].VFFLastUpd = B.VFFLastUpd,
               :CurObject.BFOList[i].ImportStatus = B.ImportStatus,
               :CurObject.BFOList[i].Action = B.CorrelationAction
         FROM  SOA_BusFaultOutage B,
               Udb_Object O1,
               Udb_Object O2,
               SOA_Job J
         WHERE :DynamicWhereClause
         ORDER BY CreationTime
         BEGIN
            i = i + 1;
         END;
         
      ELSEIF CurObject.FilterType = 'NETWORK' THEN
         REPEATED
         SELECT :CurObject.BFOList[i].Substation = B.Substation,
               :CurObject.BFOList[i].SubstationName = O1.Description,
               :CurObject.BFOList[i].SwitchingItem = B.SwitchingItem,
               :CurObject.BFOList[i].CreationTime = B.CreationTime,
               :CurObject.BFOList[i].BusSection = B.BusSection,
               :CurObject.BFOList[i].BusSectionName = O2.Name,
               :CurObject.BFOList[i].BDPhaseA = B.BDPhaseA,
               :CurObject.BFOList[i].BDPhaseB = B.BDPhaseB,
               :CurObject.BFOList[i].BDPhaseC = B.BDPhaseC,
               :CurObject.BFOList[i].BDRelayName = B.BDRelayName,
               :CurObject.BFOList[i].BDLastUpd = B.BDLastUpd,
               :CurObject.BFOList[i].BOCPhaseA = B.BOCPhaseA,
               :CurObject.BFOList[i].BOCPhaseB = B.BOCPhaseB,
               :CurObject.BFOList[i].BOCPhaseC = B.BOCPhaseC,
               :CurObject.BFOList[i].BOCPhaseN = B.BOCPhaseN,
               :CurObject.BFOList[i].BOCRelayName = B.BOCRelayName,
               :CurObject.BFOList[i].BOCLastUpd = B.BOCLastUpd,
/*
               :CurObject.BFOList[i].BUTOperated = B.BUTOperated,
               :CurObject.BFOList[i].BUTRelayName = B.BUTRelayName,
               :CurObject.BFOList[i].BUTLastUpd = B.BUTLastUpd,
*/
               :CurObject.BFOList[i].BUTOperated = B.FBMPR,
               :CurObject.BFOList[i].BUTRelayName = B.FBMPRValue,
               :CurObject.BFOList[i].BUTLastUpd = B.FBMPRTime,

               :CurObject.BFOList[i].ClFdrBkr = B.ClFdrBkr,
               :CurObject.BFOList[i].ClFdrBkrs = B.ClFdrBkrs,
               :CurObject.BFOList[i].ClFdrBkrLastUpd = B.ClFdrBkrLastUpd,
               :CurObject.BFOList[i].FTFeeder = B.FTFeeder,
               :CurObject.BFOList[i].FTPhaseA = B.FTPhaseA,
               :CurObject.BFOList[i].FTPhaseB = B.FTPhaseB,
               :CurObject.BFOList[i].FTPhaseC = B.FTPhaseC,
               :CurObject.BFOList[i].FTPhaseN = B.FTPhaseN,
               :CurObject.BFOList[i].FTRelayName = B.FTRelayName,
               :CurObject.BFOList[i].FTLastUpd = B.FTLastUpd,
               :CurObject.BFOList[i].PQFound = B.PQFound,
               :CurObject.BFOList[i].PQValue = B.PQValue,
               :CurObject.BFOList[i].PQTime = B.PQTime,
               :CurObject.BFOList[i].VBFault = B.VBFault,
               :CurObject.BFOList[i].VBFDescription = B.VBFDescription,
               :CurObject.BFOList[i].VBFLastUpd = B.VBFLastUpd,

               :CurObject.BFOList[i].FBMPR = B.FBMPR,
