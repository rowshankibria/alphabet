**
**  Application:    CAC
**  Class:          ListedCard_ASE
**
**  Date:       Version Description
** ----------------------------------
**  09/15/01    pkw     Created; 
**  06/25/02    pkw     Added Load FeederStatus.
**  07/22/02    pkw     Change Operator$FOD to TM$FODOrder when figuring out 
**                      Bogey colors.  
**  11/11/02    ysp     Merge: get the card note from soa_card table.
**  05/09/03    em      Add OpenAutoPlus and FOT Count
**  08/01/03    pkw     Add RRDescription to LoadActiveFeeders
**  08/05/03    pkw     Add logic for DO Ack Delay9
**  09/18/03    em      Add logic to indicate pending FOD Fault messages.
**  02/23/05    pkw     Show estimated time complete in reverse video if within 1 hour.
**                      Put * next to feedername if feeder is running under Process automation.
**                      Separate Delay column and remove feederstatusname column.
**  03/18/05    ysp     Add network jeopardy colors.
**  04/15/05    ysp     Added loading of active iso cards for fms online
**  12/29/05    ysp     Add method LoadOutstandingRSMoves
**  01/17/06    ysp     add parameter SpecialGrouping to separate outstanding rs moves
**                      by either divsions or special groupings
**  05/18/06    pkw     Add TV logic.
**  06/29/06    pkw     Add fake delay for TV orders.
**  01/07/08    pkw     Add LoadTFMSFeeders method.
**  06/11/08    ysp     Add LoadOutstandingRFPs method
**  07/08/08    ysp     Add LoadOutstandingStations method for out-of-service 
**                      permit requests.
**  09/14/09    ysp     check the returned value of Locate function when parsing division string.
**  06/21/10    ysp     Add load idle FMS cards for fms online
**  08/18/10    em      3G Conversion
**  11/01/10    pkw     More 3G conversion.
**  03/28/11    pkw     3G upates.
**  06/30/11    ysp     Use LENGTH instead of SIZE function
**  08/29/13    em      Add Sectional and KPS Feeder types to where clause
**  09/26/13    pkw     Don't show 4kV StepDown feeders on active feeder list and 
**                      implement lookup table is LoadActiveFeeders Method.
**  06/18/14    pkw     Set Char_DurationInt so field can be sorted on ActiveFeederSummary.
**  09/23/14    pkw     Look at non-network feeders also when loading networks
**  12/09/14    pkw     Don't use fms_feederdiv in loadfeederstatus because
**                      KnownPointSplice don't show up.
**  12/17/14    pkw     Exclude ISO Card in LoadFeederStatus method.
**  03/24/16    pkw     Don't show portion feeders as part of 33kv upgrade.
**  01/10/17    ysp     Include Idle cards for outstanding restore moves.
**  06/08/21    pkw     Use opstarttime because value gets updated in activefeedersummary 
*/ 
METHOD LoadActiveFeeders (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   AAC                 = ARRAY OF ListedCard;  /* List of ALL active cards */
   BT                  = TM_Alert;
   DynamicWhereClause  = VARCHAR(400) NOT NULL;
   i                   = INTEGER NOT NULL;     /*Counter*/
   j                   = INTEGER NOT NULL;     /*Counter*/
   k                   = INTEGER NOT NULL;     /*Counter*/
   LastCard            = INTEGER NOT NULL;     
   SelectedStatus      = VARCHAR(20) NOT NULL;
   TimeNow             = DATE NOT NULL WITH DEFAULT;
   Tot_Min             = INTEGER NOT NULL;
   MinimumDODelayRecorded = INTEGER NOT NULL;
   FOTCount           = INTEGER NOT NULL WITH DEFAULT;
   TempChar  = VARCHAR(40) NOT NULL;
   TempRRDescription  = VARCHAR(100) NOT NULL;
   StepType           = INTEGER NOT NULL;   
   ProcessAutoExecution = INTEGER NOT NULL;
   DurationText       = VARCHAR(20) NOT NULL;
   NetworkList        = ARRAY OF INTEGEROBJECT;
   NetworkColors      = ARRAY OF INTEGEROBJECT;
   TVForecast         = FLOAT NOT NULL;
   TVDayAhead         = FLOAT NOT NULL;
   TV_Bogey           = INTEGER NOT NULL;
   OOSBogey           = INTEGER NOT NULL;
   OOSBogeyTV         = INTEGER NOT NULL;
   SD_Lookup = ARRAY OF INTEGEROBJECT;
   F_Lookup = ARRAY OF FMS_FaultClass;
   OP_Lookup = ARRAY OF ListedCard;
   FN_Lookup = ARRAY OF ObjectSummaryClass;
   BT_Lookup = ARRAY OF TM_Alert;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the active feeder data associated 
** with the specified filter criteria.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Use varchar since this is what PrintMovesReport uses anyway.  This
**  variable is only used when printing report.  Allows for filter by Out of service
*/

   IF CurObject.Filter = 1 THEN  /* Active */
      SelectedStatus = varchar(:Card$Active) + ',' + varchar(:Card$OutToWork);     

      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.Card = CTO.Card AND CTO.Object = G.Member AND G.MemberType IN (' + varchar(:Type$Feeder) +
               ',' + varchar(:Type$SubFeeder) + 
               ',' + varchar(:Type$KPSFeeder) + ',' + varchar(:Type$SectionalFeeder) + 
               ')  AND G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType IN (' + varchar(:Type$Division) + ',' + varchar(:Type$Special) +  
               ') AND C.Card = CN.Card';
   ELSEIF CurObject.Filter = 2 THEN   /* Out of service */
      SelectedStatus = varchar(:Card$Active) + ',' + varchar(:Card$OutToWork);     

      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.Cutout IS NOT NULL AND C.Cutin IS NULL AND ' +
               'C.Card = CTO.Card AND CTO.Object = G.Member AND G.MemberType IN (' + varchar(:Type$Feeder) +
               ',' + varchar(:Type$SubFeeder) + 
               ',' + varchar(:Type$KPSFeeder) + ',' + varchar(:Type$SectionalFeeder) + 
               ')  AND G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType IN (' + varchar(:Type$Division) + ',' + varchar(:Type$Special) +  
               ') AND C.Card = CN.Card';
   ELSEIF CurObject.Filter = 3 THEN /* OTW */
      SelectedStatus = varchar(:Card$OutToWork);  
   
      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.Card = CTO.Card AND CTO.Object = G.Member AND G.MemberType IN (' + varchar(:Type$Feeder) +
               ',' + varchar(:Type$SubFeeder) + 
               ',' + varchar(:Type$KPSFeeder) + ',' + varchar(:Type$SectionalFeeder) + 
               ')  AND G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType IN (' + varchar(:Type$Division) + ',' + varchar(:Type$Special) +  
               ') AND C.Card = CN.Card AND ' +
               'C.Card = CTO.Card AND CTO.Object = OS.Object AND OS.Status = ' + varchar(:Status$OTW) + ' AND ' +
               'StatusCount > 0';
   ELSE
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: No filter criteria entered.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No filter criteria entered.';
      RETURN;
   ENDIF;

   SELECT :CurObject.BogeyEnabled = TM_BogeyEnabled, 
          :MinimumDODelayRecorded = MinimumDODelayRecorded,
          :TimeNow = Date('now')
   FROM   FMS_SystemParameters;
   CALLPROC DDB_ROLLBACK; 
   /*
   **  IF BogeyEnabled is TRUE, then we need to figure out what the TV
   **  Forecast values are and build a text string.
   */
   IF CurObject.BogeyEnabled = TRUE THEN
      TVForecast = 0;
      SELECT :TVForecast = B.Forecast,
             :TVDayAhead = B.DayAhead
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory);
      CALLPROC DDB_ROLLBACK;
      
      IF TVForecast = 0 THEN
         CurObject.TV_Text = 'NOT ENTERED';     
      ELSE  
         CurObject.TV_Text = 'Today: ' + 
            left(varchar(TVForecast),(locate(varchar(TVForecast),'.')+2)) + 
            ' Tomorrow: ' + 
            left(varchar(TVDayAhead),(locate(varchar(TVDayAhead),'.')+2));
      ENDIF;

      SELECT :OOSBogey = T.BogeyAlert
      FROM    TM_BogeyType T
      WHERE   T.Type = :TM$OtherType AND
              T.Status = :TM$StatusOutOfService;
      CALLPROC DDB_ROLLBACK;

      SELECT :OOSBogeyTV = T.BogeyAlert
      FROM    TM_BogeyType T
      WHERE   T.Type = :TM$TVOtherType AND
              T.Status = :TM$StatusOutOfService;
      CALLPROC DDB_ROLLBACK;
   ENDIF;   
   

   IF CurObject.Filter = 3 THEN /* OTW */
      AAC.Clear();
      i = 1;
      SELECT DISTINCT
              :AAC[i].Card = C.Card,
              :AAC[i].Feeder = C.Feeder,
              :AAC[i].Status = C.Status,
              :AAC[i].TypeOfCard = C.TypeOfCard,
              :AAC[i].FeederName = C.FeederName,
              :AAC[i].RRDescription = C.FeederName,
              :AAC[i].FeederStatus = C.FeederStatus,
              :AAC[i].FeederStatusName  = C.FeederStatusName,
              :AAC[i].CardClass  = C.CardClass,
              :AAC[i].CardClassName  = C.CardClassName,
              :AAC[i].SubStationName  = C.SubStationName,
              :AAC[i].CutOut = IFNULL(C.CutOut,''),
              :AAC[i].OpenAutoPlus = IFNULL(C.OpenAutoPlus,''),
              :AAC[i].CutIn = IFNULL(C.CutIn,''),
              :AAC[i].ActTimeComplete = C.ActTimeComplete,
              :AAC[i].EstTimeComplete = C.EstTimeComplete,
              :AAC[i].EstTimeInService = C.EstTimeInService,
              :AAC[i].Division = G.Grouping,
              :AAC[i].CurrentNote = CN.Note,
              :ProcessAutoExecution = C.ProcessAutoExecution,
              :TV_Bogey = C.TV_Bogey
      FROM    FMS_Card C, 
              TFMS_CardToObject CTO,
              Udb_Grouping G,
              FMS_ObjectStatus OS,
              SOA_Card CN
      WHERE  :DynamicWhereClause
      ORDER BY SubStationName,FeederName
      BEGIN
         /*
         **  Show all TV Bogey Reason field in reverse video.
         */ 
         IF CurObject.BogeyEnabled = TRUE AND TV_Bogey > 0 THEN
            AAC[i].CardClass_Reverse = TRUE; 
            IF TV_Bogey = 1 OR TV_Bogey = 11 THEN
               AAC[i].TV_Reason = 'Triggered by Actual TV Forecast';
            ELSEIF TV_Bogey = 2 OR TV_Bogey = 12 THEN
               AAC[i].TV_Reason = 'Triggered by Current TV Forecast';            
            ELSEIF TV_Bogey = 3 OR TV_Bogey = 13 THEN
               AAC[i].TV_Reason = 'Triggered by Day Ahead TV Forecast';
            ENDIF;        
         ENDIF;
         /*
         **  Calculate OOS time and color.
         */
         IF AAC[i].CutOut = '' THEN
            AAC[i].Char_Duration = '';
         ELSE
            IF AAC[i].CutIn = '' THEN
               AAC[i].Char_DurationInt = IFNULL(INT4(interval('minute',TimeNow - DATE(AAC[i].CutOut))),0);
               AAC[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = AAC[i].Char_DurationInt);
            ELSE
               AAC[i].Char_DurationInt = IFNULL(INT4(interval('minute',DATE(AAC[i].CutIn) - DATE(AAC[i].CutOut))),0);
               AAC[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = AAC[i].Char_DurationInt);
            ENDIF;
         ENDIF;
/*
**  Look for open auto plus and FOT Count
*/  
         IF (AAC[i].CardClass = Type$Auto OR AAC[i].CardClass = Type$CIOA) AND
              AAC[i].OpenAutoPlus IS NOT NULL AND AAC[i].OpenAutoPlus <> '' THEN
            AAC[i].CardClassName = AAC[i].CardClassName + '+';
         ENDIF;
/*
**  If Process Automation is currently executing on feeder, 
**  color substation column CC_LIGHT_GREEN.
*/
         IF ProcessAutoExecution = Automation$Go THEN
            AAC[i].StationBGColor = CC_LIGHT_GREEN;
         ENDIF;

         IF AAC[i].CardClass = Type$FOT THEN
            FOTCount = 0;
            SELECT :FOTCount = FOTCount
            FROM   IR_FOTCount
            WHERE  Card = :AAC[i].Card;
    
            IF FOTCount <> 0 THEN
               AAC[i].CardClassName = AAC[i].CardClassName + VARCHAR(FOTCount);
            ENDIF;
         ENDIF;      
         i = i + 1;
      END;
   ELSE  /* Out of service or Active */
      AAC.Clear();
      i = 1;
      SELECT DISTINCT
             :AAC[i].Card = C.Card,
             :AAC[i].Feeder = C.Feeder,
             :AAC[i].Status = C.Status,
             :AAC[i].TypeOfCard = C.TypeOfCard,
             :AAC[i].FeederName = C.FeederName,
             :AAC[i].RRDescription = C.FeederName,
             :AAC[i].FeederStatus = C.FeederStatus,
             :AAC[i].FeederStatusName  = C.FeederStatusName,
             :AAC[i].CardClass  = C.CardClass,
             :AAC[i].CardClassName  = C.CardClassName,
             :AAC[i].SubStationName  = C.SubStationName,
             :AAC[i].CutOut = IFNULL(C.CutOut,''),
             :AAC[i].OpenAutoPlus = IFNULL(C.OpenAutoPlus,''),
             :AAC[i].CutIn = IFNULL(C.CutIn,''),
             :AAC[i].ActTimeComplete = C.ActTimeComplete,
             :AAC[i].EstTimeComplete = C.EstTimeComplete,
             :AAC[i].EstTimeInService = C.EstTimeInService,
             :AAC[i].Division = G.Grouping,
             :AAC[i].CurrentNote = CN.Note,
             :ProcessAutoExecution = C.ProcessAutoExecution,
             :TV_Bogey = C.TV_Bogey
      FROM    FMS_Card C, 
              TFMS_CardToObject CTO,
              Udb_Grouping G,
              SOA_Card CN
      WHERE  :DynamicWhereClause

      ORDER BY SubStationName,FeederName
      BEGIN
         /*
         **  Show all TV Bogey Reason field in reverse video.
         */ 
         IF CurObject.BogeyEnabled = TRUE AND TV_Bogey > 0 THEN
            AAC[i].CardClass_Reverse = TRUE; 
            IF TV_Bogey = 1 THEN
               AAC[i].TV_Reason = 'Triggered by Actual TV Forecast';
            ELSEIF TV_Bogey = 2 THEN
               AAC[i].TV_Reason = 'Triggered by Current TV Forecast';            
            ELSEIF TV_Bogey = 3 THEN
               AAC[i].TV_Reason = 'Triggered by Day Ahead TV Forecast';
            ENDIF;        
         ENDIF;
         /*
         **  Calculate OOS time and color.
         */
         IF AAC[i].CutOut = '' THEN
            AAC[i].Char_Duration = '';
         ELSE
            IF AAC[i].CutIn = '' THEN
               AAC[i].Char_DurationInt = IFNULL(INT4(interval('minute',TimeNow - DATE(AAC[i].CutOut))),0);
               AAC[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = AAC[i].Char_DurationInt);
            ELSE
               AAC[i].Char_DurationInt = IFNULL(INT4(interval('minute',DATE(AAC[i].CutIn) - DATE(AAC[i].CutOut))),0);
               AAC[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = AAC[i].Char_DurationInt);
            ENDIF;
         ENDIF;
/*
**  Look for open auto plus and FOT Count
*/  
         IF (AAC[i].CardClass = Type$Auto OR AAC[i].CardClass = Type$CIOA) AND
              AAC[i].OpenAutoPlus IS NOT NULL AND AAC[i].OpenAutoPlus <> '' THEN
            AAC[i].CardClassName = AAC[i].CardClassName + '+';
         ENDIF;
/*
**  If Process Automation is currently executing on feeder, 
**  color substation column CC_LIGHT_GREEN.
*/
         IF ProcessAutoExecution = Automation$Go THEN
            AAC[i].StationBGColor = CC_LIGHT_GREEN;
         ENDIF;

         IF AAC[i].CardClass = Type$FOT THEN
            FOTCount = 0;
            SELECT :FOTCount = FOTCount
            FROM   IR_FOTCount
            WHERE  Card = :AAC[i].Card;
    
            IF FOTCount <> 0 THEN
               AAC[i].CardClassName = AAC[i].CardClassName + VARCHAR(FOTCount);
            ENDIF;
         ENDIF;      
         i = i + 1;
      END;
   ENDIF; 
/*
**  Remove any linked 4kV StepDown Cards
*/
   i = 1;
   SD_Lookup.Clear();
   SELECT  :SD_Lookup[i].Value = StepDownCard
   FROM     FMS_StepDownLink
   BEGIN 
      i = i + 1;
   END;

   i = 1;
   WHILE i <= AAC.LastRow() DO
      FOR j = 1 TO SD_Lookup.LastRow DO
         IF AAC[i].Card = SD_Lookup[j].Value THEN
            AAC.RemoveRow (RowNumber = i);
            ENDLOOP;
         ENDIF;
      ENDFOR;      
      IF j > SD_Lookup.LastRow THEN
         i = i + 1;
      ENDIF;
   ENDWHILE; 

   i = 1;
   j = 1;
   LastCard = 0;
   CurObject.LC.Clear();
   IF lowercase(CurObject.DivisionText) like 'all%' THEN
       WHILE i <= AAC.LastRow() DO
          IF AAC[i].Card <> LastCard THEN
             CurObject.LC[j] = AAC[i];
             LastCard = AAC[i].Card;
             j = j + 1;
          ENDIF;
          i = i + 1;
       ENDWHILE;

   ELSEIF CurObject.DivisionText = 'Local' THEN
       WHILE i <= AAC.LastRow() DO
           k = 1;
           WHILE k <= EffectiveDivisions.LastRow() DO
               IF EffectiveDivisions[k].Object = AAC[i].Division THEN
                   ENDLOOP;
               ENDIF;
               k = k + 1;
           ENDWHILE;
           IF k <= EffectiveDivisions.LastRow() AND LastCard <> AAC[i].Card THEN
               CurObject.LC[j] = AAC[i];
               LastCard = AAC[i].Card;
               j = j + 1;
           ENDIF;
           i = i + 1;
       ENDWHILE;
                    
   ELSE
       /*
       **  If CurObject.Division is set we will use that, otherwise we will use
       **  the value in CurObject.DivisionText.  It should be in the format of 
       **  div1;div2;
       */
       EffectiveDivisions.Clear();
       IF CurObject.Division <> 0 THEN
          EffectiveDivisions[1].Object = CurObject.Division;
       ELSE
          i = 1;
          WHILE LENGTH(CurObject.DivisionText) > 0 DO
             k = locate(CurObject.DivisionText,';');
             IF k > LENGTH(CurObject.DivisionText) THEN
                CurObject.Division = int4(CurObject.DivisionText); 
                CurObject.DivisionText = '';  
             ELSE
                CurObject.Division = int4(left(CurObject.DivisionText, k-1));   
                CurObject.DivisionText = shift(CurObject.DivisionText,-k);
             ENDIF;

             EffectiveDivisions[i].Object = CurObject.Division;
             i = i + 1;
          ENDWHILE;
       ENDIF;

       i = 1;
       WHILE i <= AAC.LastRow() DO
           k = 1;
           WHILE k <= EffectiveDivisions.LastRow() DO
               IF EffectiveDivisions[k].Object = AAC[i].Division THEN
                   ENDLOOP;
               ENDIF;
               k = k + 1;
           ENDWHILE;
           IF k <= EffectiveDivisions.LastRow() AND LastCard <> AAC[i].Card THEN
               CurObject.LC[j] = AAC[i];
               LastCard = AAC[i].Card;
               j = j + 1;
           ENDIF;
           i = i + 1;
       ENDWHILE;
   ENDIF;

   i = 1;
   F_Lookup.Clear();
   SELECT :F_Lookup[i].Card = F.Card,
          :F_Lookup[i].FaultTypeName = F.FaultTypeName
   FROM    FMS_Card C,
           FMS_Fault F
   WHERE   C.Card = F.Card
   BEGIN 
      i = i + 1;
   END;

   j = 1;
   WHILE j <= CurObject.LC.LastRow() DO
      FOR i = 1 TO F_Lookup.LastRow DO
         IF CurObject.LC[j].Card = F_Lookup[i].Card THEN
            CurObject.LC[j].Fault = F_Lookup[i].FaultTypeName;
            ENDLOOP;
         ENDIF;
      ENDFOR;
      j = j + 1;
   ENDWHILE;
   
   i = 1;
   F_Lookup.Clear();
   SELECT :F_Lookup[i].Card = F.Card,
          :F_Lookup[i].FODFaultStatus = F.FODFaultStatus
   FROM    FMS_Card C,
           FMS_Fault F
   WHERE   C.Card = F.Card AND
           F.FODFaultStatus IN (:Fault$Received, :Fault$Rejected,
                                :Fault$ChangeRequested)
   BEGIN 
      i = i + 1;
   END;

   j = 1;
   WHILE j <= CurObject.LC.LastRow() DO
      FOR i = 1 TO F_Lookup.LastRow DO
         IF CurObject.LC[j].Card = F_Lookup[i].Card THEN
            CurObject.LC[j].FaultStatus = F_Lookup[i].FODFaultStatus;
            /*
            ** Set Feeder Color based on Fault Status
            */
            IF CurObject.LC[j].FaultStatus = Fault$Received THEN
               CurObject.LC[j].FeederFGColor = CC_PALE_GRAY;
               CurObject.LC[j].FeederBGColor = 0;  /* reset bg color */                 
               CurObject.LC[j].RRDescription = 'FOD Fault Pending DO Ack';
            ELSEIF CurObject.LC[j].FaultStatus = Fault$Rejected THEN
               CurObject.LC[j].FeederFGColor = CC_PALE_GRAY;
               CurObject.LC[j].FeederBGColor = 0;  /* reset bg color */                 
               CurObject.LC[j].RRDescription = 'FOD Fault Reject Pending FOD Ack';
            ELSEIF CurObject.LC[j].FaultStatus = Fault$ChangeRequested THEN
               CurObject.LC[j].FeederFGColor = CC_PALE_GRAY;
               CurObject.LC[j].FeederBGColor = 0;  /* reset bg color */                 
               CurObject.LC[j].RRDescription = 'FOD Fault Change Req Pending FOD Ack';
            ENDIF; 
            ENDLOOP;
         ENDIF;
      ENDFOR;
      j = j + 1;
   ENDWHILE;
/*
** select all the network colors to our local arrays. We
** then match them up.
** note: don't try to merge this select with the next network name
** query  because not all networks are defined in the network 
** jeopardy model table.
*/
   NetworkList.Clear();
   NetworkColors.Clear();
   j = 1;
   REPEATED
   SELECT :NetworkList[j].Value = N.Object,
          :NetworkColors[j].Value = C.RankColor
   FROM   FMS_NetworkJeopardy N,
          FMS_NetworkRankColor C
   WHERE  N.Rank >= C.LowValue AND
          N.Rank <= C.HighValue
   BEGIN
      j = j + 1;
   END;
   
   i = 1;
   FN_Lookup.Clear();
   SELECT  :FN_Lookup[i].Object = G.Member,
           :FN_Lookup[i].Type   = G.Grouping,
           :FN_Lookup[i].TypeName = O.Name
   FROM     Udb_Object O,
            Udb_Grouping G 
   WHERE    G.MemberType = :Type$Feeder AND
            G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) AND
            G.GroupingType = :Type$Network AND
            G.Grouping = O.Object
   BEGIN 
      i = i + 1;
   END;
   
   j = 1;
   WHILE j <= CurObject.LC.LastRow() DO
      IF CurObject.LC[j].Feeder <> -1 THEN
         FOR i = 1 TO FN_Lookup.LastRow DO
            IF CurObject.LC[j].Feeder = FN_Lookup[i].Object THEN
               CurObject.LC[j].NetWork = FN_Lookup[i].TypeName;

               /* Match network jeopardy color */
               FOR k = 1 TO NetworkList.LastRow() DO
                  IF FN_Lookup[i].Type = NetworkList[k].Value THEN
                     CurObject.LC[j].NetWorkBGColor = NetworkColors[k].Value;
                     ENDLOOP;
                  ENDIF;
               ENDFOR;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      ELSE
         k = 0;
         REPEATED
         SELECT :k = O.Object,
                :CurObject.LC[j].NetWork = O.Name
         FROM   UDB_OBJECT O,
                TFMS_CardToObject CTO,
                UDB_GROUPING G
         WHERE  CTO.Card = :CurObject.LC[j].Card AND
                G.Member = CTO.Object and
                G.Relationship IN (:Interaction$MemberOf,:Interaction$NonNetworkMemberOf) and
                G.GroupingType = :Type$Network and
                O.Object = G.Grouping;

         /* Match network jeopardy color */
         FOR i = 1 TO NetworkList.LastRow() DO
            IF k = NetworkList[i].Value THEN
               CurObject.LC[j].NetWorkBGColor = NetworkColors[i].Value;
               ENDLOOP;
            ENDIF;
         ENDFOR;
      ENDIF;
      j = j + 1;
   ENDWHILE; 
   CALLPROC DDB_ROLLBACK;    
/*
**  Load Current Delay and OperatingStep
*/
   /*
   **  Get Current Operating Steps ================================
   */
   i = 1;
   OP_Lookup.Clear();
   SELECT :OP_Lookup[i].Card = OS.Card,
          :OP_Lookup[i].OperatingStepName = OS.OperatingStepName, 
          :OP_Lookup[i].OperatingStep = IFNULL(OS.OperatingStep,0),  
          :OP_Lookup[i].StartTime = OS.StartTime
   FROM   FMS_OPERATINGSTEPSTATUS OS,
          FMS_Card C
   WHERE  C.Card = OS.Card AND
          EndTime = '' AND
          OperatingStep <> :Type$OperatingStepCount AND
          StartTime = (SELECT   MAX(StartTime)
                       FROM     FMS_OperatingStepStatus OS2,
                                Udb_SuperType S
                       WHERE    OS2.Card = C.Card AND
                                OS2.EndTime = '' AND
                                OS2.OperatingStep <> :Type$OperatingStepCount AND
                                OS2.OperatingStep = S.Type AND
                                S.SuperType = :Type$OperatingStepStatus)
   BEGIN
      i = i + 1;
   END;
     
   i = 1;
   WHILE i <= CurObject.LC.LastRow() DO
      FOR j = 1 TO OP_Lookup.LastRow DO
         IF CurObject.LC[i].Card = OP_Lookup[j].Card THEN
            CurObject.LC[i].OperatingStepName = OP_Lookup[j].OperatingStepName; 
            CurObject.LC[i].OperatingStep = OP_Lookup[j].OperatingStep;
            CurObject.LC[i].OpStartTime = OP_Lookup[j].StartTime;
            
            IF CurObject.LC[i].OperatingStepName <> '' THEN
               DurationText = CALLPROC ConvertHour(Tot_Min = 
                 INT4(interval('minute', TimeNow - DATE(CurObject.LC[i].OpStartTime))));
               CurObject.LC[i].OperatingStepName = CurObject.LC[i].OperatingStepName + 
                                                ' (' + DurationText + ')';
            ENDIF;
            
            OP_Lookup.RemoveRow (RowNumber = j);
            ENDLOOP;
         ENDIF;
      ENDFOR;

      i = i + 1;
   ENDWHILE;
   /*
   **  Get Current Delays ==========================================
   */
   i = 1;
   OP_Lookup.Clear();
   SELECT :OP_Lookup[i].Card = OS.Card,
          :OP_Lookup[i].DelayName = OS.OperatingStepName, 
          :OP_Lookup[i].Delay = IFNULL(OS.OperatingStep,0),  
          :OP_Lookup[i].StartTime = OS.StartTime
   FROM   FMS_OPERATINGSTEPSTATUS OS,
          FMS_Card C
   WHERE  C.Card = OS.Card AND
          EndTime = '' AND
          OperatingStep <> :Type$OperatingStepCount AND
          StartTime = (SELECT   MAX(StartTime)
                       FROM     FMS_OperatingStepStatus OS2,
                                Udb_SuperType S
                       WHERE    OS2.Card = C.Card AND
                                OS2.EndTime = '' AND
                                OS2.OperatingStep <> :Type$OperatingStepCount AND
                                OS2.OperatingStep = S.Type AND
                                S.SuperType = :Type$Delay)
   BEGIN
      i = i + 1;
   END;
     
   i = 1;
   WHILE i <= CurObject.LC.LastRow() DO
      FOR j = 1 TO OP_Lookup.LastRow DO
         IF CurObject.LC[i].Card = OP_Lookup[j].Card THEN
            
            CurObject.LC[i].DelayName = OP_Lookup[j].DelayName; 
            CurObject.LC[i].Delay = OP_Lookup[j].Delay;
            CurObject.LC[i].StartTime = OP_Lookup[j].StartTime;
            
            IF CurObject.LC[i].DelayName <> '' THEN
               CurObject.LC[i].Duration = INT4(interval('minute', TimeNow - DATE(CurObject.LC[i].StartTime)));
               DurationText = CALLPROC ConvertHour(Tot_Min = 
                    INT4(interval('minute', TimeNow - DATE(CurObject.LC[i].StartTime))));
               CurObject.LC[i].DelayName = CurObject.LC[i].DelayName + 
                                             ' (' + DurationText + ')';

               IF CurObject.LC[i].Delay = Type$DODelay OR
                  CurObject.LC[i].Delay = Type$DOAckDelay THEN
                  IF CurObject.LC[i].Duration <= MinimumDODelayRecorded THEN
                     CurObject.LC[i].DelayBgColor = CC_PALE_BLUE;
                  ELSE
                     CurObject.LC[i].DelayBgColor = CC_RED;
                  ENDIF;
               ENDIF;
            ENDIF;
            
            OP_Lookup.RemoveRow (RowNumber = j);
            ENDLOOP;
         ENDIF;
      ENDFOR;

      i = i + 1;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;    
/*
**  Update colors for Task Manager.
*/
   i = 1;
   BT_Lookup.Clear();
   SELECT :BT_Lookup[i].Card = B.Card,
          :BT_Lookup[i].Type = B.Type,
          :BT_Lookup[i].StartTime = B.StartTime,
          :BT_Lookup[i].AlertTime = B.AlertTime,
          :BT_Lookup[i].InitialAlert = B.InitialAlert,
          :BT_Lookup[i].Status = B.Status,
          :BT_Lookup[i].StatusName = T.StatusName,
          :BT_Lookup[i].BogeyAlert = T.BogeyAlert
   FROM    FMS_Card C,
           TM_BogeyAlert B,
           TM_BogeyType T
   WHERE   C.Card = B.Card AND
           B.Type = T.Type AND
           B.Status = T.Status
   BEGIN 
      i = i + 1;
   END;

   j = 1;
   WHILE j <= CurObject.LC.LastRow() DO
      IF CurObject.LC[j].CutIn = '' AND
         CurObject.LC[j].EstTimeInService <> '' THEN
         CurObject.LC[j].InserviceFgColor = CC_LIGHT_BLUE;
         CurObject.LC[j].CutIn = CurObject.LC[j].EstTimeInService;
      ENDIF;   

      IF CurObject.LC[j].ActTimeComplete = '' AND
         CurObject.LC[j].EstTimeComplete <> '' THEN 

         CurObject.LC[j].CompleteFGColor = CC_LIGHT_BLUE;
         CurObject.LC[j].ActTimeComplete = CurObject.LC[j].EstTimeComplete;
         /*
         ** Highlight in reverse video if within 1 hour of esttime complete 
         */ 
         IF CurObject.LC[j].EstTimeComplete > TimeNow AND
            CurObject.LC[j].EstTimeComplete < DATE(TimeNow + '1 hour') THEN

            CurObject.LC[j].CompleteBGColor = CC_LIGHT_BLUE;
            CurObject.LC[j].CompleteFGColor = CC_PALE_CYAN;
         ENDIF;
      ENDIF;   
      
      i = 1;
      WHILE i <= BT_Lookup.LastRow DO
         IF CurObject.LC[j].Card = BT_Lookup[i].Card THEN
            BT = BT_Lookup[i].Duplicate();
            BT_Lookup.RemoveRow (RowNumber = i);

            IF BT.Type = Operator$OpOrder OR BT.Type = TM$TVOpOrder OR
               BT.Type = Operator$FCR OR BT.Type = TM$TVFCRPermit OR
               BT.Type = TM$FODOrder OR BT.Type = TM$TVFODOrder THEN
               /* 
               **  Only update RRDescription if we are setting a higher priority.
               */
               TempChar = CALLPROC ConvertHour(Tot_Min = 
                       INT4(interval('minute',TimeNow - BT.StartTime)));
               TempRRDescription = BT.StatusName + ' - Elapsed (' + TempChar + ') Bogey (';
               TempChar = CALLPROC ConvertHour(Tot_Min = BT.BogeyAlert);
               TempRRDescription = TempRRDescription + TempChar + ')';

               IF BT.AlertTime < TimeNow THEN
                  CurObject.LC[j].FeederBGColor = CC_RED;
                  CurObject.LC[j].FeederFGColor = 0;  /* reset fg color */  
                  CurObject.LC[j].RRDescription = TempRRDescription;
               ELSEIF BT.InitialAlert = FALSE AND
                      CurObject.LC[j].FeederBGColor <> CC_RED THEN
                  CurObject.LC[j].FeederBGColor = CC_YELLOW;                              
                  CurObject.LC[j].FeederFGColor = 0;  /* reset fg color */              
                  CurObject.LC[j].RRDescription = TempRRDescription;
               ENDIF;
            
               IF CurObject.LC[j].FeederBGColor <> CC_RED AND
                  CurObject.LC[j].FeederBGColor <> CC_YELLOW THEN
                  IF BT.Status = Order$Closed OR
                     BT.Status = Order$Rescinded OR
                     BT.Status = Permit$Returned OR  
                     BT.Status = Permit$Rejected OR 
                     BT.Status = Order$Downloaded OR
                     BT.Status = Order$Opened OR 
                     BT.Status = Permit$Downloaded OR
                     BT.Status = Permit$Issued THEN
                     CurObject.LC[j].FeederFGColor = CC_PALE_GRAY;
                     CurObject.LC[j].FeederBGColor = 0;  /* reset bg color */                 
                     CurObject.LC[j].RRDescription = TempRRDescription;
                     /*
                     **  IF Permit or order is downloaded for TV feeder and 
                     **  Bogey time has not been exceeded (ie not red or yellow)
                     **  we will apply a 'fake' delay that will appear only on 
                     **  FMS and FMS_Online.  
                     */
                     IF  CurObject.LC[j].CardClass_Reverse = TRUE AND /* TV Outage */
                        (BT.Status = Order$Downloaded OR
                         BT.Status = Permit$Downloaded) THEN
                        CurObject.LC[j].DelayBgColor = CC_PALE_GRAY;
                        TempChar = CALLPROC ConvertHour(Tot_Min = 
                            INT4(interval('minute',TimeNow - BT.StartTime)));
                        CurObject.LC[j].DelayName = BT.StatusName + ' (' + TempChar + ')';
                     ENDIF;
                  ENDIF;
                  
                  IF CurObject.LC[j].FeederFGColor <> CC_PALE_GRAY THEN
                     IF BT.Status = Permit$Initialized THEN
                        CurObject.LC[j].FeederBGColor = CC_PALE_RED;
                        CurObject.LC[j].RRDescription = TempRRDescription;
                     ENDIF;
                  
                     IF CurObject.LC[j].FeederBGColor <> CC_PALE_RED THEN
                        IF BT.Status = Order$Acknowledged OR
                           BT.Status = Permit$Acknowledged THEN
                           CurObject.LC[j].FeederBGColor = CC_PALE_GREEN;
                           CurObject.LC[j].RRDescription = TempRRDescription;
                        ELSE
                           CurObject.LC[j].FeederBGColor = 0;                 
                        ENDIF;
                     ENDIF;               
                  ENDIF;
               ENDIF;
            ELSEIF BT.Type = TM$OtherType OR
                   BT.Type = TM$TVOtherType THEN
               IF BT.Status = TM$StatusEstInservice THEN
                  IF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].InserviceBGColor = CC_RED;
                     CurObject.LC[j].InserviceFGColor = CC_PALE_BLUE;
                  ELSEIF BT.StartTime < TimeNow THEN
                     CurObject.LC[j].InserviceBGColor = CC_YELLOW;                              
                  ENDIF;
               ENDIF;   
                  
               IF BT.Status = TM$StatusEstComplete THEN 
                  IF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].CompleteBGColor = CC_RED;
                     CurObject.LC[j].CompleteFGColor = CC_PALE_BLUE;
                  ELSEIF BT.StartTime < TimeNow THEN
                     CurObject.LC[j].CompleteBGColor = CC_YELLOW;                              
                  ENDIF;
               ENDIF;  
            
               IF CurObject.BogeyEnabled = TRUE AND
                  BT.Status = TM$StatusOutOfService THEN
                  IF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].Char_DurationBGColor = CC_RED;
                  ELSEIF BT.InitialAlert = FALSE THEN
                     CurObject.LC[j].Char_DurationBGColor = CC_YELLOW;                              
                  ENDIF;
               ENDIF;
            ELSEIF BT.Status = :CurObject.LC[j].OperatingStep OR
                   BT.Status = :CurObject.LC[j].Delay THEN
               IF CurObject.BogeyEnabled = TRUE AND
                  BT.Type = Type$OperatingStepStatus THEN 
                  
                  IF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].StepBGColor = CC_RED;               
                  ELSEIF BT.InitialAlert = FALSE THEN
                     CurObject.LC[j].StepBGColor = CC_YELLOW;                              
                  ENDIF;
               ELSEIF CurObject.BogeyEnabled = TRUE AND
                  BT.Type = TM$TVBogey THEN 
                  
                  IF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].StepBGColor = CC_RED;               
                  ELSEIF BT.InitialAlert = FALSE THEN
                     CurObject.LC[j].StepBGColor = CC_YELLOW;                              
                  ENDIF;
               ELSEIF BT.Type = Type$Delay THEN
                  IF CurObject.LC[j].OperatingStep = Type$DODelay OR
                     CurObject.LC[j].OperatingStep = Type$DOAckDelay THEN
                     /* Do nothing. Leave color as set above. */
                  ELSEIF BT.AlertTime < TimeNow THEN
                     CurObject.LC[j].DelayBGColor = CC_RED;                                
                  ELSEIF BT.InitialAlert = FALSE THEN
                     CurObject.LC[j].DelayBGColor = CC_YELLOW;                              
                  ENDIF;
               ENDIF;
            ENDIF;
         ELSE
            i = i + 1;
         ENDIF;
      ENDWHILE;
      j = j + 1;
   ENDWHILE;
   RETURN;
END;

METHOD LoadTFMSFeeders (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   TempLC              = ListedCard; 
   DynamicWhereClause  = VARCHAR(400) NOT NULL;
   i                   = INTEGER NOT NULL;     /*Counter*/
   k                   = INTEGER NOT NULL;     /*Counter*/
   LastCard            = INTEGER NOT NULL;     
   TimeNow             = DATE NOT NULL WITH DEFAULT;
   Tot_Min             = INTEGER NOT NULL;
   TempChar  = VARCHAR(40) NOT NULL;
   TempRRDescription  = VARCHAR(100) NOT NULL;
   DurationText       = VARCHAR(20) NOT NULL;
   SimpleDivision     = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the active feeder data associated 
** with the specified filter criteria for TFMS application.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Filter = 1 THEN  /* All Active cards */

      DynamicWhereClause = 
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = AC.Card AND ' +
           'C.Card = T.Card AND ' +
           'AC.TypeOfCard = ' + VARCHAR(:TypeOfCard$TFMS) + ' AND ' +
           'AC.Card = AO.Card AND ' +
           'AO.Object = O.Object AND ' +
           'AC.Division IN ( ';
   ELSEIF CurObject.Filter = 2 THEN   /* Out of service */

      DynamicWhereClause = 
           'C.CutOut IS NOT NULL AND ' + 
           'C.Cutout <> '' '' AND ' +
           'C.Cutin IS NULL AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = AC.Card AND ' +
           'C.Card = T.Card AND ' +
           'AC.TypeOfCard = ' + VARCHAR(:TypeOfCard$TFMS) + ' AND ' +
           'AC.Card = AO.Card AND ' +
           'AO.Object = O.Object AND ' +
           'AC.Division IN ( ';
   ELSEIF CurObject.Filter = 3 THEN /* Active In Service */
   
      DynamicWhereClause = 
           'C.CutIn IS NOT NULL AND ' + 
           'C.CutIn <> '' '' AND ' +
           'C.Status < ' + VARCHAR(:Card$Closed) + ' AND ' +
           'C.Card = AC.Card AND ' +
           'C.Card = T.Card AND ' +
           'AC.TypeOfCard = ' + VARCHAR(:TypeOfCard$TFMS) + ' AND ' +
           'AC.Card = AO.Card AND ' +
           'AO.Object = O.Object AND ' +
           'AC.Division IN ( ';
   ELSE
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: No filter criteria entered.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'VALIDATION ERROR: Filter attribute must be ' +
          'equal to 1) All Active Cards 2) Active Out of Service or 3) Active InService. ' + 
          'Please report error to Technical Support.';
      RETURN;
   ENDIF;

   If lowercase(CurObject.DivisionText) like 'all%' THEN
      /*
      **  Load Division table
      */
      IF SimpleDivision IS NULL THEN
         SimpleDivision = Division_ASE.Create();
      ENDIF;
         
      SimpleDivision.LoadDivisions();
         
      IF SimpleDivision.ReturnCode = 0 THEN
         i = 1;
         EffectiveDivisions.Clear();
         WHILE i <= SimpleDivision.Dlist.LastRow() DO
            EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            i = i + 1;
         ENDWHILE;
      ELSE
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
         SimpleDivision = NULL;
         RETURN;
      ENDIF;
      SimpleDivision = NULL;
            
   ELSEIF lowercase(CurObject.DivisionText) like 'local%' THEN
      /*  do nothing use effective division passed in. */
   ELSE
      EffectiveDivisions.Clear();
      IF CurObject.Division <> 0 THEN
         EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionText) > 0 DO
             k = locate(CurObject.DivisionText,';');
             IF k > LENGTH(CurObject.DivisionText) THEN
                CurObject.Division = int4(CurObject.DivisionText); 
                CurObject.DivisionText = '';  
             ELSE
                CurObject.Division = int4(left(CurObject.DivisionText, k-1));   
                CurObject.DivisionText = shift(CurObject.DivisionText, -k);
             ENDIF;
            EffectiveDivisions[i].Object = CurObject.Division;
            i = i + 1;
         ENDWHILE;
      ENDIF;             
   ENDIF;

   i = 1;
   WHILE i <= EffectiveDivisions.LastRow() DO
 
      IF i = EffectiveDivisions.LastRow() THEN
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DynamicWhereClause = DynamicWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
      i = i + 1;
   ENDWHILE;

   /*
   **  Get current time from database.
   */
   SELECT :TimeNow = Date('now');
   CALLPROC DDB_ROLLBACK; 

   CurObject.LC.Clear();
   i = 0;
   LastCard = 0;
   SELECT DISTINCT
           :TempLC.Card = C.Card,
           :TempLC.CardName = AC.CardName,
           :TempLC.Name = O.Name,
           :TempLC.Description = O.Description,
           :TempLC.Status = AO.ObjectToCardLink,   /* 1 = Line, 0 = Substation */
           :TempLC.Cutout = IFNULL(C.Cutout,''),
           :TempLC.Cutin = IFNULL(C.Cutin,''),
           :TempLC.EstTimeInservice = C.EstTimeInservice,
           :TempLC.CardClass = C.CardClass,
           :TempLC.CardClassName = C.CardClassName,
           :TempLC.CurrentNote = C.Note,
           :TempLC.CTSEOS_Reason = T.Ctseos_Reason
   FROM    SOA_ActiveCard AC,
           SOA_ActiveObject AO,
           SOA_Card C,
           TFMS_Card T,
           Udb_Object O
   WHERE   :DynamicWhereClause
   ORDER BY CardName, Name, Description
   BEGIN
      IF LastCard <> TempLC.Card THEN
         i = i + 1;

         CurObject.LC[i].Card = TempLC.Card;
         CurObject.LC[i].CardName = TempLC.CardName;
         CurObject.LC[i].Cutout = TempLC.Cutout;
         CurObject.LC[i].Cutin = TempLC.Cutin;
         CurObject.LC[i].CardClass = TempLC.CardClass;
         CurObject.LC[i].CardClassName = TempLC.CardClassName;
         CurObject.LC[i].CurrentNote = TempLC.CurrentNote;
         CurObject.LC[i].CTSEOS_Reason = TempLC.CTSEOS_Reason;
         
         IF TempLC.Cutin = '' AND
            TempLC.EstTimeInservice <> '' THEN
            
            CurObject.LC[i].CutIn = TempLC.EstTimeInservice;
            CurObject.LC[i].InServiceFGColor = CC_LIGHT_BLUE;
         ENDIF;
         /*
         **  Calculate OOS time.
         */
         IF TempLC.CutOut = '' THEN
            CurObject.LC[i].Char_Duration = '';
         ELSE
            IF TempLC.CutIn = '' THEN
               CurObject.LC[i].Char_DurationInt = IFNULL(INT4(interval('minute',TimeNow - DATE(TempLC.CutOut))),0);
            ELSE
               CurObject.LC[i].Char_DurationInt = IFNULL(INT4(interval('minute',DATE(TempLC.CutIn) - DATE(TempLC.CutOut))),0);
            ENDIF;
            CurObject.LC[i].Char_Duration = CALLPROC ConvertHour(Tot_Min = CurObject.LC[i].Char_DurationInt);
         ENDIF;
      ENDIF;

      IF TempLC.Status = 1 THEN 
         IF CurObject.LC[i].FeederName = '' THEN
            CurObject.LC[i].FeederName = TempLC.Name;
         ELSE
            CurObject.LC[i].FeederName = CurObject.LC[i].FeederName +
                                         HC_NEWLINE + TempLC.Name;             
         ENDIF;
      ELSEIF TempLC.Status = 0 THEN
         IF CurObject.LC[i].SubstationName = '' THEN
            CurObject.LC[i].SubstationName = TempLC.Description;
         ELSE
            CurObject.LC[i].SubstationName = CurObject.LC[i].SubstationName +
                                             HC_NEWLINE + TempLC.Description;             
         ENDIF;          
      ELSE
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': VALIDATION MESSAGE: Unknown ObjectToCardLink in SOA_ActiveObject ' +
                    'table: ' + varchar(TempLC.Status));
      ENDIF;

      LastCard = TempLC.Card;
   END;
   CALLPROC DDB_ROLLBACK;
   
   i = 1;
   FOR i = 1 TO CurObject.LC.LastRow() DO
      /*
      **  Get Current Operating Step
      */
      SELECT :CurObject.LC[i].OperatingStepName = OS.OperatingStepName, 
             :CurObject.LC[i].OperatingStep = OS.OperatingStep,  
             :CurObject.LC[i].StartTime = OS.StartTime
      FROM   TFMS_OperatingStep OS
      WHERE  OS.Card = :CurObject.LC[i].Card AND
             EndTime = '';

      IF CurObject.LC[i].OperatingStepName <> '' THEN
         DurationText = CALLPROC ConvertHour(Tot_Min = 
              INT4(interval('minute', TimeNow - DATE(CurObject.LC[i].StartTime))));
         CurObject.LC[i].OperatingStepName = CurObject.LC[i].OperatingStepName + 
                                             ' (' + DurationText + ')';
      ENDIF;
      /*
      **  See if there are any outstanding orders from RR
      */
      SELECT :CurObject.LC[i].Status = O.OrderStatus
      FROM    IR_OperatingOrder O
      WHERE   O.Card = :CurObject.LC[i].Card AND
              O.OrderStatus < :Order$Rescinded
      BEGIN
         IF CurObject.LC[i].Status = Order$Closed OR
            CurObject.LC[i].Status = Order$Rescinded OR
            CurObject.LC[i].Status = Order$Downloaded OR
            CurObject.LC[i].Status = Order$Opened THEN

            CurObject.LC[i].FeederFGColor = CC_PALE_GRAY;
            CurObject.LC[i].FeederBGColor = 0;  /* reset bg color */                 
         ENDIF; 
              
         IF CurObject.LC[i].FeederFGColor <> CC_PALE_GRAY THEN  
            IF CurObject.LC[i].Status = Order$Acknowledged THEN
               CurObject.LC[i].FeederBGColor = CC_PALE_GREEN;
            ELSE
               CurObject.LC[i].FeederBGColor = 0;                 
            ENDIF;
         ENDIF;
      END;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;  
  
   RETURN;
END;

METHOD LoadFeederStatus (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   AAC                 = ARRAY OF ListedCard;  /* List of ALL active cards */
   BT                  = TM_Alert;
   DynamicWhereClause  = VARCHAR(400) NOT NULL;
   i                   = INTEGER NOT NULL;     /*Counter*/
   j                   = INTEGER NOT NULL;     /*Counter*/
   k                   = INTEGER NOT NULL;     /*Counter*/
   LastCard            = INTEGER NOT NULL;     
   SelectedStatus      = VARCHAR(20) NOT NULL;
   TimeNow             = DATE NOT NULL WITH DEFAULT;
   Tot_Min             = INTEGER NOT NULL;
   MinimumDODelayRecorded = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the active feeder data associated 
** with the specified filter criteria.  This method is for the feederlist
** located on the top of the card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Use varchar since this is what PrintMovesReport uses anyway.  This
**  variable is only used when printing report.  Allows for filter by Out of service
*/

   IF CurObject.Filter = 1 THEN  /* Active */
      SelectedStatus = varchar(:Card$Active) + ',' + varchar(:Card$OutToWork);     

      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.TypeOfCard <> ' + varchar(Type$ISOCard) + ' AND ' +
               'C.TypeOfCard <> ' + varchar(TypeOfCard$Portion) + ' AND ' +                
               'C.Card = CTO.Card AND CTO.Object = ' +
               'G.Member AND G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType = ' + VARCHAR(:Type$Division);
   ELSEIF CurObject.Filter = 2 THEN   /* Out of service */
      SelectedStatus = varchar(:Card$Active) + ',' + varchar(:Card$OutToWork);     

      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.TypeOfCard <> ' + varchar(Type$ISOCard) + ' AND ' +
               'C.TypeOfCard <> ' + varchar(TypeOfCard$Portion) + ' AND ' + 
               'C.Cutout IS NOT NULL AND C.Cutin IS NULL AND ' +
               'C.Card = CTO.Card AND CTO.Object = ' +
               'G.Member AND G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType = ' + VARCHAR(:Type$Division);
   ELSEIF CurObject.Filter = 3 THEN /* OTW */
      SelectedStatus = varchar(:Card$OutToWork);  
   
      DynamicWhereClause = 'C.Status IN (' + SelectedStatus + ') AND ' +
               'C.TypeOfCard <> ' + varchar(Type$ISOCard) + ' AND ' +
               'C.TypeOfCard <> ' + varchar(TypeOfCard$Portion) + ' AND ' + 
               'C.Card = CTO.Card AND CTO.Object =  ' +
               'G.Member AND G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType = ' + VARCHAR(:Type$Division) + ' AND ' +
               'CTO.Object = OS.Object AND OS.Status = ' + varchar(:Status$OTW) + ' AND ' +
               'StatusCount > 0';
   ELSEIF CurObject.Filter = 4 THEN  /* Idle */
      DynamicWhereClause = 'C.Status = ' + varchar(Card$Idle) + ' AND ' +
               'C.TypeOfCard <> ' + varchar(Type$ISOCard) + ' AND ' +
               'C.TypeOfCard <> ' + varchar(TypeOfCard$Portion) + ' AND ' + 
               'C.Card = CTO.Card AND CTO.Object = ' +
               'G.Member AND G.Relationship = ' + VARCHAR(:Interaction$MemberOf) + ' AND ' +
               'G.GroupingType = ' + VARCHAR(:Type$Division);
   ELSEIF CurObject.Filter = 100 THEN /* ISO */
      /* no dynamic where clause to be used */
   ELSE
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: No filter criteria entered.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No filter criteria entered.';
      RETURN;
   ENDIF;

   IF CurObject.Filter = 3 THEN /* OTW */
      AAC.Clear();
      i = 1;
      SELECT DISTINCT
              :AAC[i].Card = C.Card,
              :AAC[i].Feeder = C.Feeder,
              :AAC[i].Status = C.Status,
              :AAC[i].TypeOfCard = C.TypeOfCard,
              :AAC[i].FeederName = C.FeederName,
              :AAC[i].RRDescription = C.FeederName,
              :AAC[i].FeederStatus = C.FeederStatus,
              :AAC[i].FeederStatusName  = C.FeederStatusName,
              :AAC[i].CardClassName  = C.CardClassName,
              :AAC[i].SubStationName  = C.SubStationName,
              :AAC[i].Division = G.Grouping
      FROM    FMS_Card C, 
              TFMS_CardToObject CTO,
              Udb_Grouping G,
              FMS_ObjectStatus OS
      WHERE  :DynamicWhereClause
      ORDER BY SubStationName,FeederName
      BEGIN
         i = i + 1;
     END;
   
   ELSEIF CurObject.Filter = 100 THEN /* ISO */
      /*
      **  FMS Online uses all divisions to show ISO's
      **  FMS uses desk to determine which iso's to show.
      */
      AAC.Clear();
      i = 1;
      SELECT  :AAC[i].Card = C.Card,
              :AAC[i].Feeder = C.Feeder,
              :AAC[i].Status = C.Status,
              :AAC[i].TypeOfCard = C.TypeOfCard,
              :AAC[i].FeederName = C.FeederName,
              :AAC[i].RRDescription = C.FeederName,
              :AAC[i].FeederStatus = C.FeederStatus,
              :AAC[i].FeederStatusName  = C.FeederStatusName,
              :AAC[i].CardClassName  = C.CardClassName,
              :AAC[i].SubStationName  = C.SubStationName,
              :AAC[i].Division = G.Grouping
      FROM   Udb_Object O, 
             Udb_Grouping G, 
             FMS_Card C,
             TFMS_CardToObject CTO
      WHERE (O.Type = :Type$ISOFeeder OR
             O.Type = :Type$KPSFeeder) AND
             G.Member = O.Object AND
             G.RelationShip = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division AND
             O.Object = CTO.Object AND
             CTO.Card = C.Card AND
             C.Status = :Card$Active
      ORDER BY SubStationName,FeederName
      BEGIN
           i = i + 1;
      END;

   ELSE  /* Out of service or Active */
      AAC.Clear();
      i = 1;
      SELECT DISTINCT
             :AAC[i].Card = C.Card,
             :AAC[i].Feeder = C.Feeder,
             :AAC[i].Status = C.Status,
             :AAC[i].TypeOfCard = C.TypeOfCard,
             :AAC[i].FeederName = C.FeederName,
             :AAC[i].RRDescription = C.FeederName,
             :AAC[i].FeederStatus = C.FeederStatus,
             :AAC[i].FeederStatusName  = C.FeederStatusName,
             :AAC[i].CardClassName  = C.CardClassName,
             :AAC[i].SubStationName  = C.SubStationName,
             :AAC[i].Division = G.Grouping
      FROM    FMS_Card C, 
              TFMS_CardToObject CTO,
              Udb_Grouping G
      WHERE  :DynamicWhereClause

      ORDER BY SubStationName,FeederName
      BEGIN
         i = i + 1;
      END;
   ENDIF; 

   i = 1;
   j = 1;
   LastCard = 0;
   CurObject.LC.Clear();
   IF lowercase(CurObject.DivisionText) like 'all%' THEN
       WHILE i <= AAC.LastRow() DO
          IF AAC[i].Card <> LastCard THEN
             CurObject.LC[j] = AAC[i];
             LastCard = AAC[i].Card;
             j = j + 1;
          ENDIF;
          i = i + 1;
       ENDWHILE;

   ELSEIF lowercase(CurObject.DivisionText) like 'local%' THEN
       WHILE i <= AAC.LastRow() DO
           k = 1;
           WHILE k <= EffectiveDivisions.LastRow() DO
               IF EffectiveDivisions[k].Object = AAC[i].Division THEN
                   ENDLOOP;
               ENDIF;
               k = k + 1;
           ENDWHILE;
           IF k <= EffectiveDivisions.LastRow() AND LastCard <> AAC[i].Card THEN
               CurObject.LC[j] = AAC[i];
               LastCard = AAC[i].Card;
               j = j + 1;
           ENDIF;
           i = i + 1;
       ENDWHILE;
                    
   ELSE
       /*
       **  If CurObject.Division is set we will use that, otherwise we will use
       **  the value in CurObject.DivisionText.  It should be in the format of 
       **  div1;div2;
       */
       EffectiveDivisions.Clear();
       IF CurObject.Division <> 0 THEN
          EffectiveDivisions[1].Object = CurObject.Division;
       ELSE
          i = 1;
          WHILE LENGTH(CurObject.DivisionText) > 0 DO
             k = locate(CurObject.DivisionText,';');
             IF k > LENGTH(CurObject.DivisionText) THEN
                CurObject.Division = int4(CurObject.DivisionText); 
                CurObject.DivisionText = '';  
             ELSE
                CurObject.Division = int4(left(CurObject.DivisionText, k-1));   
                CurObject.DivisionText = shift(CurObject.DivisionText, -k);
             ENDIF;
             EffectiveDivisions[i].Object = CurObject.Division;
             i = i + 1;
          ENDWHILE;
       ENDIF;

       i = 1;
       WHILE i <= AAC.LastRow() DO
           k = 1;
           WHILE k <= EffectiveDivisions.LastRow() DO
               IF EffectiveDivisions[k].Object = AAC[i].Division THEN
                   ENDLOOP;
               ENDIF;
               k = k + 1;
           ENDWHILE;
           IF k <= EffectiveDivisions.LastRow() AND LastCard <> AAC[i].Card THEN
               CurObject.LC[j] = AAC[i];
               LastCard = AAC[i].Card;
               j = j + 1;
           ENDIF;
           i = i + 1;
       ENDWHILE;
   ENDIF;

   RETURN;
END;

Method LoadOutstandingRSMoves(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
   SpecialGrouping = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   RSL         = ARRAY OF Job;         /* List of outstanding RS moves */
   i           = INTEGER NOT NULL;     /*Counter*/
   j           = INTEGER NOT NULL;     /*Counter*/
   k           = INTEGER NOT NULL;     /*Counter*/
   LastCard    = INTEGER NOT NULL;     
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all the outstanding FMS restore moves
** within the specified divisions.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF SpecialGrouping = TRUE THEN
      i = 1;
      REPEATED
      SELECT  :RSL[i].MoveEquipClass = G.Grouping,        /* Hide Division Object*/
              :RSL[i].MoveEquipClassName = C.FeederName,  /*Hide Feeder Name*/
              :RSL[i].Card = C.Card,
              :RSL[i].Seq = JC.Seq,
              :RSL[i].Job = J.Job,
              :RSL[i].TOIssued = J.TOIssued,
              :RSL[i].TOComplete = J.TOComplete,
              :RSL[i].PrintId  = JC.PrintId,
              :RSL[i].EquipClassName  = J.EquipClassName,
              :RSL[i].EquipName  = J.EquipName,
              :RSL[i].Grounds  = J.Grounds,
              :RSL[i].TOMove = J.TOMove,
              :RSL[i].RSIssued = J.RSIssued,
              :RSL[i].RSComplete = J.RSComplete
      FROM    FMS_CARD C,
              SOA_JOB J,
              TFMS_CardToObject CTO,
              SOA_JobControl JC,
              UDB_Grouping G
      WHERE   C.Status >= :Card$Active AND C.Status < :Card$Closed AND
              C.CutIn IS NOT NULL AND
              C.Card = JC.Card AND
              JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
              JC.Job = J.Job AND
              J.JobClass <> 0 AND
              J.Status = '' AND
              J.RSComplete IS NULL AND
              C.Card = CTO.Card AND
              CTO.Object = G.Member AND
              G.MemberType = :Type$Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType =:Type$Special
      ORDER BY MoveEquipClass, MoveEquipClassName, Seq
      BEGIN
        i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSE
      i = 1;
      REPEATED
      SELECT  :RSL[i].MoveEquipClass = G.Grouping,        /* Hide Division Object*/
              :RSL[i].MoveEquipClassName = C.FeederName,  /*Hide Feeder Name*/
              :RSL[i].Card = C.Card,
              :RSL[i].Seq = JC.Seq,
              :RSL[i].Job = J.Job,
              :RSL[i].TOIssued = J.TOIssued,
              :RSL[i].TOComplete = J.TOComplete,
              :RSL[i].PrintId  = JC.PrintId,
              :RSL[i].EquipClassName  = J.EquipClassName,
              :RSL[i].EquipName  = J.EquipName,
              :RSL[i].Grounds  = J.Grounds,
              :RSL[i].TOMove = J.TOMove,
              :RSL[i].RSIssued = J.RSIssued,
              :RSL[i].RSComplete = J.RSComplete
      FROM    FMS_CARD C,
              SOA_JOB J,
              TFMS_CardToObject CTO,
              SOA_JobControl JC,
              UDB_Grouping G
      WHERE   C.Status >= :Card$Active AND C.Status < :Card$Closed AND
              C.CutIn IS NOT NULL AND
              C.Card = JC.Card AND
              JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
              JC.Job = J.Job AND
              J.JobClass <> 0 AND
              J.Status = '' AND
              J.RSComplete IS NULL AND
              C.Card = CTO.Card AND
              CTO.Object = G.Member AND
              G.MemberType = :Type$Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType =:Type$Division
      ORDER BY MoveEquipClass, MoveEquipClassName, Seq
      BEGIN
        i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
  
   /*
   ** filter moves by divisions
   */
   CurObject.LJ.Clear();        /* listed restore jobs */

   IF lowercase(CurObject.DivisionText) like 'all%' THEN
      /* nothing */

   ELSEIF CurObject.DivisionText = 'Local' THEN
      CurObject.FilterMovesByDivisions(
                     EffectiveDivisions = EffectiveDivisions,
                     JobList = BYREF(RSL));

   ELSE
      /*
      **  If CurObject.Division is set we will use that, otherwise we will use
      **  the value in CurObject.DivisionText.  It should be in the format of 
      **  div1;div2;
      */
      EffectiveDivisions.Clear();
      IF CurObject.Division <> 0 THEN
          EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
          i = 1;
          WHILE LENGTH(CurObject.DivisionText) > 0 DO
             k = locate(CurObject.DivisionText,';');
             IF k > LENGTH(CurObject.DivisionText) THEN
                CurObject.Division = int4(CurObject.DivisionText); 
                CurObject.DivisionText = '';  
             ELSE
                CurObject.Division = int4(left(CurObject.DivisionText, k-1));   
                CurObject.DivisionText = shift(CurObject.DivisionText, -k);
             ENDIF;

             EffectiveDivisions[i].Object = CurObject.Division;
             i = i + 1;
          ENDWHILE;
      ENDIF;

      CurObject.FilterMovesByDivisions(
                     EffectiveDivisions = EffectiveDivisions,
                     JobList = BYREF(RSL));
   ENDIF;

   CurObject.LJ = RSL;

   RETURN;
END;

/*
** A Private helper method for LoadOutstandingRSMoves
*/
Method FilterMovesByDivisions(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
   JobList = ARRAY OF Job;         /* List of outstanding RS moves */
) =
DECLARE
   i           = INTEGER NOT NULL;     /*Counter*/
   j           = INTEGER NOT NULL;     /*Counter*/
   k           = INTEGER NOT NULL;     /*Counter*/
   DivToRemove = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   i = 1;
   WHILE i <= JobList.LastRow() DO
       k = 1;
       WHILE k <= EffectiveDivisions.LastRow() DO
           IF EffectiveDivisions[k].Object = JobList[i].MoveEquipClass THEN
               ENDLOOP;
           ENDIF;
           k = k + 1;
       ENDWHILE;

       IF k <= EffectiveDivisions.LastRow() THEN
          /* jump to the next division */
          j = i + 1;
          WHILE j <= JobList.LastRow() DO
              IF JobList[i].MoveEquipClass = JobList[j].MoveEquipClass THEN
                 j = j + 1;
              ELSE
                 ENDLOOP;
              ENDIF;
          ENDWHILE;
          i = j;    /* i points to a new division */
       ELSE 
          /* delete all jobs in this division */
          DivToRemove = JobList[i].MoveEquipClass;

          j = i;
          WHILE j <= JobList.LastRow() DO
              IF DivToRemove = JobList[j].MoveEquipClass THEN
                 JobList.RemoveRow (RowNumber = j);
              ELSE
                 ENDLOOP;
              ENDIF;
          ENDWHILE;
       ENDIF;
   ENDWHILE;
END;

METHOD LoadOutstandingRFPs (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
   SpecialGrouping = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   RFPList     = ARRAY OF IR_RequestForPermit;         /* List of outstanding RS moves */
   i           = INTEGER NOT NULL;     /*Counter*/
   j           = INTEGER NOT NULL;     /*Counter*/
   k           = INTEGER NOT NULL;     /*Counter*/
   LastCard    = INTEGER NOT NULL;     
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all the outstanding FMS restore moves
** within the specified divisions.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RFPList.Clear();
   i = 1;
   IF SpecialGrouping = TRUE THEN
      SELECT :RFPList[i].Division = D.Division,
             :RFPList[i].Feeder = C.Feeder,
             :RFPList[i].FeederName = C.FeederName,
             :RFPList[i].Card = C.Card,
             :RFPList[i].RFP = R.RFP,
             :RFPList[i].RevisionNumber = R.RevisionNumber,
             :RFPList[i].RevisionChar = VARCHAR(R.RequestForPermit) + '.' + VARCHAR(R.RevisionNumber),
             :RFPList[i].FCRName = R.FCRName,
             :RFPList[i].TimeStamp = R.TimeStamp,
             :RFPList[i].Objective = R.Objective,
             :RFPList[i].AcknowledgedByDO = R.AcknowledgedByDO,
             :RFPList[i].LinkedByDO = R.LinkedByDO,
             :RFPList[i].OutageType = R.OutageType
      FROM   IR_RequestForPermit R,
             FMS_Card C,
             TFMS_CardToObject CTO,
             FMS_FeederDiv D,
             UDB_Object O
      WHERE  R.RFPStatus = 0 AND
             R.RejectedByDO = 0 AND
             R.Card <> 0 AND
             R.Card = C.Card AND
             C.Card = CTO.Card AND
             CTO.Object = D.Feeder AND
             D.Division = O.Object AND
             O.Type = :Type$Special
      UNION
      SELECT D.Division,
             R.Feeder,
             R.FeederName,
             R.Card,
             R.RFP,
             R.RevisionNumber,
             VARCHAR(R.RequestForPermit) + '.' + VARCHAR(R.RevisionNumber),
             R.FCRName,
             R.TimeStamp,
             R.Objective,
             R.AcknowledgedByDO,
             R.LinkedByDO,
             R.OutageType
      FROM   IR_RequestForPermit R,
             FMS_FeederDiv D, 
             UDB_Object O
      WHERE  R.RFPStatus = 0 AND
             R.RejectedByDO = 0 AND
             R.Card = 0 AND
             R.Feeder = D.Feeder AND
             D.Division = O.Object AND
             O.Type = :Type$Special
      ORDER BY 1, 3, 9 ASC
      BEGIN
         IF RFPList[i].Card = 0 THEN
            RFPList[i].RevisionChar = RFPList[i].OutageType;
            RFPList[i].LinkedBy = '';
         ELSE
            IF RFPList[i].LinkedByDO = 0 THEN
               RFPList[i].LinkedBy = 'FCR';
            ELSE
               RFPList[i].LinkedBy = 'D.O.';
            ENDIF;
         ENDIF;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;  
   ELSE
      SELECT :RFPList[i].Division = D.Division,
             :RFPList[i].Feeder = C.Feeder,
             :RFPList[i].FeederName = C.FeederName,
             :RFPList[i].Card = C.Card,
             :RFPList[i].RFP = R.RFP,
             :RFPList[i].RevisionNumber = R.RevisionNumber,
             :RFPList[i].RevisionChar = VARCHAR(R.RequestForPermit) + '.' + VARCHAR(R.RevisionNumber),
             :RFPList[i].FCRName = R.FCRName,
             :RFPList[i].TimeStamp = R.TimeStamp,
             :RFPList[i].Objective = R.Objective,
             :RFPList[i].AcknowledgedByDO = R.AcknowledgedByDO,
             :RFPList[i].LinkedByDO = R.LinkedByDO,
             :RFPList[i].OutageType = R.OutageType
      FROM   IR_RequestForPermit R,
             FMS_Card C,
             TFMS_CardToObject CTO,
             FMS_FeederDiv D,
             UDB_Object O
      WHERE  R.RFPStatus = 0 AND
             R.RejectedByDO = 0 AND
             R.Card <> 0 AND
             R.Card = C.Card AND
             C.Card = CTO.Card AND
             CTO.Object = D.Feeder AND
             D.Division = O.Object AND
             O.Type = :Type$Division
      UNION
      SELECT D.Division,
             R.Feeder,
             R.FeederName,
             R.Card,
             R.RFP,
             R.RevisionNumber,
             VARCHAR(R.RequestForPermit) + '.' + VARCHAR(R.RevisionNumber),
             R.FCRName,
             R.TimeStamp,
             R.Objective,
             R.AcknowledgedByDO,
             R.LinkedByDO,
             R.OutageType
      FROM   IR_RequestForPermit R,
             FMS_FeederDiv D, 
             UDB_Object O
      WHERE  R.RFPStatus = 0 AND
             R.RejectedByDO = 0 AND
             R.Card = 0 AND
             R.Feeder = D.Feeder AND
             D.Division = O.Object AND
             O.Type = :Type$Division
      ORDER BY 1, 3, 9 ASC
      BEGIN
         IF RFPList[i].Card = 0 THEN
            RFPList[i].RevisionChar = RFPList[i].OutageType;
            RFPList[i].LinkedBy = '';
         ELSE
            IF RFPList[i].LinkedByDO = 0 THEN
               RFPList[i].LinkedBy = 'FCR';
            ELSE
               RFPList[i].LinkedBy = 'D.O.';
            ENDIF;
         ENDIF;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;  
   ENDIF;

   /*
   ** filter moves by divisions
   */
   CurObject.LR.Clear();        /* listed RFPs */

   IF lowercase(CurObject.DivisionText) like 'all%' THEN
      /* nothing */

   ELSEIF CurObject.DivisionText = 'Local' THEN
      CurObject.FilterRFPsByDivisions(
                     EffectiveDivisions = EffectiveDivisions,
                     RFPList = BYREF(RFPList));

   ELSE
      /*
      **  If CurObject.Division is set we will use that, otherwise we will use
      **  the value in CurObject.DivisionText.  It should be in the format of 
      **  div1;div2;
      */
      EffectiveDivisions.Clear();
      IF CurObject.Division <> 0 THEN
          EffectiveDivisions[1].Object = CurObject.Division;
      ELSE
          i = 1;
          WHILE LENGTH(CurObject.DivisionText) > 0 DO
             k = locate(CurObject.DivisionText,';');
             IF k > LENGTH(CurObject.DivisionText) THEN
                CurObject.Division = int4(CurObject.DivisionText); 
                CurObject.DivisionText = '';  
             ELSE
                CurObject.Division = int4(left(CurObject.DivisionText, k-1));   
                CurObject.DivisionText = shift(CurObject.DivisionText, -k);
             ENDIF;

             EffectiveDivisions[i].Object = CurObject.Division;
             i = i + 1;
          ENDWHILE;
      ENDIF;

      CurObject.FilterRFPsByDivisions(
                     EffectiveDivisions = EffectiveDivisions,
                     RFPList = BYREF(RFPList));
   ENDIF;

   CurObject.LR = RFPList;

   RETURN;
END;

/*
** A Private helper method for LoadOutstandingRFPs
*/
Method FilterRFPsByDivisions(
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
   RFPList = ARRAY OF IR_RequestForPermit;         /* List of outstanding Request for Permits */
) =
DECLARE
   i           = INTEGER NOT NULL;     /*Counter*/
   j           = INTEGER NOT NULL;     /*Counter*/
   DivToRemove = INTEGER NOT NULL WITH DEFAULT; 
   RetCode     = INTEGER NOT NULL;     
ENDDECLARE
BEGIN
   i = 1;
   WHILE i <= RFPList.LastRow() DO
       RetCode = EffectiveDivisions.Find(AttributeName = 'object',
                                         Value = RFPList[i].Division);
       
       IF RetCode = ER_OK THEN
          /* jump to the next division */
          j = i + 1;
          WHILE j <= RFPList.LastRow() DO
              IF RFPList[i].Division = RFPList[j].Division THEN
                 j = j + 1;
              ELSE
                 ENDLOOP;
              ENDIF;
          ENDWHILE;
          i = j;    /* i points to a new division */
       ELSE 
          /* delete all RFPs in this division */
          DivToRemove = RFPList[i].Division;

          j = i;
          WHILE j <= RFPList.LastRow() DO
              IF DivToRemove = RFPList[j].Division THEN
                 RFPList.RemoveRow (RowNumber = j);
              ELSE
                 ENDLOOP;
              ENDIF;
          ENDWHILE;
       ENDIF;
   ENDWHILE;
END;

METHOD LoadOutstandingStations(
)=
DECLARE
   i           = INTEGER NOT NULL;     /*Counter*/
   j           = INTEGER NOT NULL;     /*Counter*/
   PrevStation     = INTEGER NOT NULL WITH DEFAULT;
   Substation      = INTEGER NOT NULL WITH DEFAULT;
   SubstationName  = VARCHAR(40) NOT NULL WITH DEFAULT;     
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all the outstanding substations
** within the specified division that have active FMS and TFMS cards or
** active SLC switching items.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.LC.Clear();

   i = 1;
   PrevStation = 0;
   SELECT DISTINCT
         :Substation = O.Object,
         :SubstationName = O.Description 
   FROM  SOA_ActiveObject AO,
         UDB_Grouping G,
         UDB_Object O
   WHERE AO.ObjectToCardLink = 0 AND
         AO.Object = G.Member AND
         G.Grouping = :CurObject.Division AND
         G.Relationship = :Interaction$MemberOf AND
         G.Member = O.Object
   UNION ALL
   SELECT C.Substation,
          C.SubstationName
   FROM   SOA_Job J,
          SOA_JobControl JC,
          SLC_Card C,
          UDB_Grouping G
   WHERE  J.SWItemStatus = :Card$Active AND
          J.MoveCategory = :MoveCategory$SwitchingItem AND
          J.ShadowLink = 0 AND          
          J.Job = JC.Job AND
          JC.Job = JC.SwitchingItem AND
          JC.Card = C.Card AND
          C.Substation = G.Member AND
          G.Grouping = :CurObject.Division AND
          G.Relationship = :Interaction$MemberOf
   ORDER BY 1           
   BEGIN
      IF PrevStation <> Substation THEN
         CurObject.LC[i].Substation = Substation;
         CurObject.LC[i].SubstationName = SubstationName;
         PrevStation = Substation;
         i = i + 1;
      ENDIF;
   END;
   RETURN;
END;

Application Component Report
============================

	Name:            LoadAssociatedFeeders

/*
**
**      Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Proc:           LoadAssociatedFeeders
**
**  This procedure returns an array of associated feeders
**  which are associated to the passed in feeder.  
**
**  The association is based on the following criteria:
**      1) Feeders with Loop-Type Equipment 
**      2) Feeders with ATS Equipment 
**      3) Feeders feeding an HTV which is also fed by this feeder.
**      4) ISO Feeders
**      5) Feeders In the same network with a certain "degree" of 
**         inter-relationship with this feeder
**
**   This routine also determines the total number of feeders involved
**   and the number of feeders that are out. It returns a color for the
**   buttons on the main screen that indicates the higher percentage of
**   non-supplying feeders among the potential supplying feeders for
**   each category of Grouper Association.
**   
**  Modification:
**	
**      05/11/94 mts    Original
**      08/30/94 mts    Added secondary sort of feeder name (primary is color )
**      04/11/96 wc     Rewrite HTV codes
**      04/22/96 wc     Corrected HTV equipment open logic 
**      06/18/96 em     Ignore currently Open if switch is Normally Open
**                      on an HTV.  
**      10/31/96 jfl    Use class GrouperInfo instead of HTVInfo.
**      11/13/96 jfl    Remove former Loop and ISO calculation and implement 
**                      new calculation for LOOP, ISO and ATS.
**      03/31/97 jfl    Force code to avoid dividing by 0 but log the
**                      unexpected condition to keep track of the problem.
**      04/16/97 jfl    Fix the pb that led to a division by 0: use Type$Feeder
**                      as supertype instead of type. Add missing rollbacks.
**      04/29/97 jfl    fms206: new requirements for LOOP/ATS/HTV/ISO
**                      Do not calculate button color if ISOFeeder.
**                      Associated ISOFeeders are always OutOfService
**      05/21/97 jfl    fms207d: Support call from precheck routine
**      06/24/97 jfl    Add REPEATED statements
**      09/12/97 jfl    Pass GrouperId in RED_xxx grouper objects when
**                      called by precheck
**      10/17/97 jfl    Support for ATSP and ATSU
**      11/18/02 ysp    Merge: removed passed-in Card. Use CardDetails for data.
**      07/28/09 pkw    Multiple fixes:
**                      1) Remove Udb_Type from ATS select which was returning a
**                         count of 1072 each time a row was found. This was not
**                         that big of an error because w & w2 are just looking 
**                         for non-zero values.
**                      2) When selecting ATSList feeders, add Interaction$MemberOf
**                         relationship so we don't process the ATSLoad feeder
**                         three times due to the Source Breaker and Source Position
**                         relationships.
**                      3) Update ATSLoad feeder filters to include: Type$ATSLoadP,
**                         Object$ATSLoad13kv, Object$ATSLoad33kv, Object$ATSLoadBronx.
**                         If this had been implemented, #2 wouldn't be a problem
**                         but we will fix anyway.
**     01/06/11 em      Modifications in support of 3G to use cardtoobject instead of card feeder.
**     03/29/11 em      Touch-ups related to CardDetails.   CardDetails must be established by calling frame.
**     06/18/12 em      Changed SuperType to ExtendedType for ATS Grouper selection.
*/
Procedure LoadAssociatedFeeders 
(    
    Loop_Color = INTEGER NOT NULL;   /** Passed byref, color determined locally **/
    ATS_Color  = INTEGER NOT NULL;   /** Passed byref, color determined locally **/
    HTV_Color  = INTEGER NOT NULL;   /** Passed byref, color determined locally **/
    ISO_Color  = INTEGER NOT NULL;   /** Passed byref, color determined locally **/

    RED_Loop = Array of GrouperInfo; /** Opt.Passed byref **/
    RED_ATS  = Array of GrouperInfo; /** Opt.Passed byref **/
    RED_HTV  = Array of GrouperInfo; /** Opt.Passed byref **/
    RED_ISO  = Array of GrouperInfo; /** Opt.Passed byref **/

    PreCheck   = INTEGER NOT NULL;   /* Passed: TRUE = current feeder must be forced */
                                     /* outofservice in the projected calculation    */

    AssFeeders = Array of IntegerObject; /* Passed byref, list of all feeders that are associated */

    f   = INTEGER NOT NULL WITH DEFAULT;                   /* Temporary counter */
    i   = INTEGER;                   /* Temporary counter */
    j   = INTEGER;                   /* Temporary counter */
    k   = INTEGER;                   /* Temporary counter */
    j2  = INTEGER;                   /* Temporary counter */
    k2  = INTEGER;                   /* Temporary counter */
    w   = INTEGER;                   /* Temporary counter */
    w2  = INTEGER;                   /* Temporary counter */
    x   = INTEGER;                   /* Temporary counter */
    Pos = INTEGER;                   /* Temporary counter */
    ISOFeeder = INTEGER NOT NULL;    /* boolean */
    ETEquip   = INTEGER NOT NULL;    /* boolean */
    NetworkedFeeders   = ARRAY of AssociatedFeeder; /* Holds array of associated feeders to return */
    tmpAssociatedFeeder = AssociatedFeeder;         /* used to sort class */
    Percentage = float8 NOT NULL;    
    Total  = Array of IntegerObject;  /* keeps count of no.feeders for each HTV,ATS,Loop or ISO */
    Outage = Array of IntegerObject;  /* keeps count of "cutout" feeders for each HTV,ATS,Loop or ISO */

    LoopList = Array of GrouperInfo;  /*  keeps count of no. Loop, percentage for current feeder */
    ATSList  = Array of GrouperInfo;  /*  keeps count of no. ATS,  percentage for current feeder */
    HTVList  = Array of GrouperInfo;  /*  keeps count of no. HTV,  percentage for current feeder */
    ISOList  = Array of GrouperInfo;  /*  keeps count of no. ISO,  percentage for current feeder */

    cntr     = INTEGER NOT NULL;
    status   = INTEGER NOT NULL;
    VRSOpenStatus = INTEGER NOT NULL;  /* Open Status for VRS type equipment */
) =

BEGIN
/*
**  3G Sanity Check
*/
    IF CardDetails.Card = 0 THEN
       MESSAGE 'Technical Error, LoadAssociatedFeeders procedure called with CardDetails.Card=0';
       RETURN;
    ENDIF;
/*
**  Default button color to normal
*/
    Loop_Color = -1;
    ATS_Color = -1;
    HTV_Color = -1;
    ISO_Color = -1;

    RED_Loop.Clear();
    RED_ATS.Clear();
    RED_HTV.Clear();
    RED_ISO.Clear();

    cntr = 1;
    AssFeeders.Clear();
/*
** Determine if the feeder is an ISO
*/
    ISOFeeder = FALSE;
    SELECT :ISOFeeder = :TRUE
    FROM Udb_Object O
    WHERE O.Object = :CardDetails.Feeder   /*OK for 3G*/
      AND O.Type = :Type$ISOFeeder;
    CALLPROC DDB_ROLLBACK;
/*
** Determine associated feeder thru Loop-Type
*/
    LoopList.Clear();
    i = 1;
    REPEATED 
    SELECT DISTINCT
         :LoopList[i].GrouperID = G2.Grouping,
         :LoopList[i].GrouperName = O.Name 
    FROM Udb_Grouping G1,
         Udb_Grouping G2,
         Udb_Object O,
         TFMS_CardToObject CTO
    WHERE CTO.Card = :CardDetails.Card 
      AND CTO.Object = G1.Grouping 
      AND G1.RelationShip = :Interaction$MemberOf 
      AND G1.Member = G2.Member 
      AND G2.RelationShip = :Interaction$MemberOf  
      AND G2.GroupingType = :Type$Loop
      AND G2.Grouping = O.Object
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    /*
    ** Get Feeders sharing those Loop-Type Groupers with current Feeder
    */
    Pos = LoopList.LastRow();
    i = 1;
    
    WHILE i <= Pos DO
        LoopList[i].FeederCards.Clear();
        j = 1;   
        REPEATED
        SELECT DISTINCT
            :LoopList[i].FeederCards[j].FeederID = G1.Grouping,
            :LoopList[i].FeederCards[j].FeederType = G1.GroupingType,
            :AssFeeders[cntr].value = G1.Grouping
        FROM Udb_Grouping G1,
             Udb_Grouping G2
        WHERE G1.Groupingtype IN (SELECT Type 
                                 FROM Udb_ExtendedType
                                 WHERE Supertype = :Type$Feeder)
          AND G1.RelationShip = :Interaction$MemberOf 
          AND G1.Member = G2.Member 
          AND G2.Groupingtype = :Type$Loop
          AND G2.RelationShip = :Interaction$MemberOf 
          AND G2.Grouping = :LoopList[i].GrouperID
        BEGIN
            LoopList[i].FeederCards[j].FeederStatus = FdrStatus$Supply;
            LoopList[i].FeederCards[j].ETID = 0;
            REPEATED
            SELECT :LoopList[i].FeederCards[j].FeederStatus = :FdrStatus$NoSupply
            FROM   FMS_ObjectStatus S
            WHERE  S.Object = :LoopList[i].FeederCards[j].FeederID 
            AND    S.Status = :Status$CO;              
            /* force CUTOUT status for ISOFeeder */
            IF LoopList[i].FeederCards[j].FeederType = Type$ISOFeeder THEN
                LoopList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
            ENDIF;
            j = j + 1;
            cntr = cntr + 1;
        END;
        i = i + 1;       
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    /*
    ** For each Feeder, Get Equipment(s) on Loop
    */
    i = LoopList.LastRow();

    WHILE i > 0 DO
        j = LoopList[i].FeederCards.LastRow();
        WHILE j > 0 DO
            k = 1;
            REPEATED
            SELECT 
                 :LoopList[i].FeederCards[j].Equipments[k].EquipID  = G1.Member,
                 :LoopList[i].FeederCards[j].Equipments[k].EquipType = G1.MemberType
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :LoopList[i].GrouperID
              AND G1.RelationShip  = :Interaction$MemberOf 
              AND G1.MemberType <> :Type$Loop
              AND G2.Member = G1.Member
              AND G2.Grouping = :LoopList[i].FeederCards[j].FeederID
              AND G2.Relationship = :Interaction$MemberOf
            BEGIN
                /* 
                ** For each piece of equipment, see if it is open,
                ** and if it is normally open 
                */    
                REPEATED 
                SELECT :LoopList[i].FeederCards[j].Equipments[k].EquipStatus = CurrentlyOpen,
                       :LoopList[i].FeederCards[j].Equipments[k].NormalStatus = NormalOpen  
                FROM   UDB_Switch S
                WHERE  S.Object = :LoopList[i].FeederCards[j].Equipments[k].EquipID
                BEGIN
                /*
                ** Set ETID for the feeder if the piece of equipment is an ET
                */
                    ETEquip = FALSE;
                    REPEATED 
                    SELECT 
                        :LoopList[i].FeederCards[j].ETID = 
                            :LoopList[i].FeederCards[j].Equipments[k].EquipID,
                        :ETEquip = :TRUE
                    FROM Udb_ExtendedType ET
                    WHERE ET.Type = :LoopList[i].FeederCards[j].Equipments[k].EquipType
                      AND ET.SuperType = :Type$ET;
                /*
                ** Set status to FdrStatus$Ignore to ignore that feeder in the algorithm if switch
                ** is open and normal open and feeder is in service. This
                ** is an alternate supply feeder working fine.
                ** For other feeders, set status to FdrStatus$NoSupply if switch is opened
                ** NOTE that we do not consider ET equipment which is shared by 
                ** two feeders: only one of them must be ignored if it is open 
                ** and normally open. ET will be considered later. 
                */
                    IF ETEquip = FALSE THEN
                        IF LoopList[i].FeederCards[j].Equipments[k].EquipStatus = 1 AND
                           LoopList[i].FeederCards[j].Equipments[k].NormalStatus = 1 AND
                           LoopList[i].FeederCards[j].FeederStatus <> FdrStatus$NoSupply THEN
                            LoopList[i].FeederCards[j].FeederStatus = FdrStatus$Ignore;
                        ELSEIF LoopList[i].FeederCards[j].Equipments[k].EquipStatus = 1 THEN
                            LoopList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                        ENDIF;
                    ENDIF;
                    k = k + 1;
                END;
            END;
            j = j - 1;
        ENDWHILE;
        i = i - 1;  
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    /*
    ** Special processing for alternate feeder that provide
    ** supply if the ET is closed
    */
    i = LoopList.LastRow();

    WHILE i > 0 DO
        j = LoopList[i].FeederCards.LastRow();
        WHILE j > 0 DO
            /*
            ** When the single equipment on the feeder is an ET,
            ** we must decide whether we ignore the feeder or if
            ** we include it in the color button calculation
            */
            IF LoopList[i].FeederCards[j].ETID <> 0 AND
               LoopList[i].FeederCards[j].Equipments.LastRow() = 1 THEN
                k = LoopList[i].FeederCards[j].Equipments.LastRow();
                WHILE k > 0 DO
                    IF LoopList[i].FeederCards[j].ETID = 
                       LoopList[i].FeederCards[j].Equipments[k].EquipID THEN
                        ENDLOOP;
                    ENDIF;
                    k = k - 1;
                ENDWHILE;
                /* 
                ** IF ET is open and normally open and Feeder CUTIN, 
                ** ignore the feeder
                */
                IF LoopList[i].FeederCards[j].Equipments[k].EquipStatus = 1 AND
                   LoopList[i].FeederCards[j].Equipments[k].NormalStatus = 1 AND
                   LoopList[i].FeederCards[j].FeederStatus <> FdrStatus$NoSupply THEN
                    LoopList[i].FeederCards[j].FeederStatus = FdrStatus$Ignore;
                /*
                ** IF feeder is CUTOUT or ET is OPEN and normally closed
                ** Feeder gives no supply
                */
                ELSEIF LoopList[i].FeederCards[j].Equipments[k].EquipStatus = 1 THEN
                    LoopList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                ELSE
                /*
                ** Determine the status of the VRS for the feeder that
                ** shares this ET
                */
                    j2 = LoopList[i].FeederCards.LastRow();
                    WHILE j2 > 0 DO
                    /* identify the other feeder */
                        IF LoopList[i].FeederCards[j].ETID = 
                           LoopList[i].FeederCards[j2].ETID 
                           AND j <> j2 THEN
                            k2 = LoopList[i].FeederCards[j2].Equipments.LastRow();
                            WHILE k2 > 0 DO
                            /* check VRS status: feeder gives no supply if VRS is open */
                                REPEATED 
                                SELECT :VRSOpenStatus = 
                                  :LoopList[i].FeederCards[j2].Equipments[k2].EquipStatus 
                                FROM Udb_ExtendedType ET
                                WHERE ET.Type = 
                                   :LoopList[i].FeederCards[j2].Equipments[k2].EquipType 
                                  AND ET.SuperType = :Type$VRS
                                BEGIN
                                    IF VRSOpenStatus = 1 THEN
                                        LoopList[i].FeederCards[j].FeederStatus = 
                                            FdrStatus$NoSupply;
                                    ENDIF;
                                END;
                                k2 = k2 - 1;
                            ENDWHILE;
                            CALLPROC DDB_ROLLBACK;
                        ENDIF;
                        j2 = j2 - 1;
                    ENDWHILE;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;
        i = i - 1;  
    ENDWHILE;

    /**
        If 100% of the associated feeders due to LOOP's
        are out of service, set color to RED.

        If 50 thru 99% are out of service, set to yellow.
        If 1-49% set to White    
        If 0% (Use default color)    

        Since there may be more than 1 LOOP for this feeder, 
        we need to tally for each LOOP.  The one with the highest percentage
        will be used to determine color.
    **/
    IF ISOFeeder = FALSE THEN
      Outage.Clear();
      Total.Clear();

      Pos = LoopList.LastRow();    
    
      i = 1;
      x = 1;
      WHILE Pos > 0 DO
        j = LoopList[Pos].FeederCards.LastRow();       
        Total[i].Value = 0;
        Outage[i].Value = 0;
 
        WHILE j > 0 DO
            /*
            ** Do not include alternate feeders in service in the 
            ** calculation  (FeederStatus = FdrStatus$Ignore)
            */
            IF LoopList[Pos].FeederCards[j].FeederStatus <> FdrStatus$Ignore THEN
                Total[i].Value = Total[i].Value + 1;
                /* 
                ** FdrStatus$Supply   means CUTIN  and Closed switch 
                ** FdrStatus$NoSupply means CUTOUT or  abnormal Closed switch 
                */
/*
                IF LoopList[Pos].FeederCards[j].FeederStatus = FdrStatus$NoSupply OR
                (PreCheck = TRUE  AND LoopList[Pos].FeederCards[j].FeederID = CardDetails.Feeder) THEN
                    Outage[i].Value = Outage[i].Value + 1;
                ENDIF;
*/
                IF LoopList[Pos].FeederCards[j].FeederStatus = FdrStatus$NoSupply OR
                (PreCheck = TRUE  AND 
                 CardDetails.Object.Find(AttributeName = 'Object', Value = LoopList[Pos].FeederCards[j].FeederID) = ER_OK) THEN
                    Outage[i].Value = Outage[i].Value + 1;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;
/*
**  Update the list of RED Loops if called by precheck routine
*/
        IF PreCheck = TRUE  THEN
            IF (Total[i].Value = Outage[i].Value) AND (Total[i].Value <> 0) THEN
                RED_Loop[x].GrouperId = LoopList[Pos].GrouperId;
                RED_Loop[x].GrouperName = LoopList[Pos].GrouperName;
                 x = x + 1;
            ENDIF;
        ENDIF;

        Pos = Pos - 1;
        i = i + 1;
      ENDWHILE;
/*
** Determine higher percentage 
*/
      Percentage = 0;
      IF LoopList.LastRow() > 0 THEN
        j = Total.LastRow();
        WHILE j > 0 DO
            IF Total[j].Value <> 0 THEN
                IF Percentage < float8(Outage[j].Value) / float8(Total[j].Value) * 100.0 THEN
                    Percentage = float8(Outage[j].Value) / float8(Total[j].Value) * 100.0;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;                      
      ELSE
        Percentage = 0;
      ENDIF;

      IF Percentage = 0 THEN
        Loop_Color = -1;
      ELSEIF Percentage < 50 THEN
        Loop_Color = CC_WHITE;
      ELSEIF Percentage < 100 THEN
        Loop_Color = CC_YELLOW;
      ELSEIF Percentage > 99 THEN
        Loop_Color = CC_RED;
      ENDIF;
    ENDIF;
/*
** Determine associated feeder thru ATS
*/
    ATSList.Clear();
    i = 1;
    REPEATED 
    SELECT DISTINCT
          :ATSList[i].GrouperID = G.Member,
          :ATSList[i].GrouperName = O.Name, 
          :ATSList[i].GrouperType = G.MemberType
    FROM  Udb_Grouping G,
          Udb_Object O,
          TFMS_CardToObject CTO
    WHERE CTO.Card = :CardDetails.Card 
      AND CTO.Object = G.Grouping 
      AND G.RelationShip = :Interaction$MemberOf  
      AND G.MemberType IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$ATSGrouper)
      AND G.Member = O.Object
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    /*
    ** Get Feeders sharing an ATS with current Feeder
    ** But do not include LoadSide Feeders
    */
    Pos = ATSList.LastRow();
    i = 1;
    
    WHILE i <= Pos DO
        ATSList[i].FeederCards.Clear();
        j = 1;   
        REPEATED
        SELECT :ATSList[i].FeederCards[j].FeederID = G.Grouping,
               :ATSList[i].FeederCards[j].FeederType = G.GroupingType,
               :AssFeeders[cntr].value = G.Grouping
        FROM    Udb_Grouping G 
        WHERE   G.Relationship = :Interaction$MemberOf AND
                G.Groupingtype IN (SELECT Type 
                                   FROM Udb_ExtendedType
                                   WHERE Supertype = :Type$Feeder) AND 
                G.Member = :ATSList[i].GrouperID
        BEGIN
            /*
            ** Do not count Loadside feeders
            */
            w = 0;
            REPEATED 
            SELECT w = COUNT(*) 
            FROM Udb_ExtendedType ET,
                 Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Relationship = :Interaction$MemberOf
              AND G1.Grouping = :ATSList[i].FeederCards[j].FeederID
              AND G1.MemberType = ET.Type
              AND ET.SuperType IN (:Type$ATSLoad, 
                                   :Type$ATSLoadP,
                                   :Object$ATSLoad13KV,
                                   :Object$ATSLoad33KV,
                                   :Object$ATSLoadBronx)
              AND G1.Member = G2.Member
              AND G2.Relationship = :Interaction$MemberOf
              AND G2.Grouping = :ATSList[i].GrouperID;
            /*
            ** Do not let configuration error spoil us
            ** Remove feeder from the list if no piece of equipment 
            ** is found under the ATS for this feeder
            */
            IF w = 0 THEN
                w2 = 0;
                REPEATED 
                SELECT w2 = COUNT(*) 
                FROM Udb_ExtendedType ET,
                     Udb_Grouping G1,
                     Udb_Grouping G2
                WHERE G1.Relationship = :Interaction$MemberOf
                  AND G1.Grouping = :ATSList[i].FeederCards[j].FeederID
                  AND G1.MemberType = ET.Type
                  AND ET.SuperType = :Type$ATSGeneric
                  AND G1.Member = G2.Member
                  AND G2.Relationship = :Interaction$MemberOf
                  AND G2.Grouping = :ATSList[i].GrouperID;
            ENDIF;

            IF w = 0 AND w2 <> 0 THEN
                /* store feeder status: FdrStatus$Supply / FdrStatus$NoSupply */
                ATSList[i].FeederCards[j].FeederStatus = FdrStatus$Supply;
                REPEATED
                SELECT :ATSList[i].FeederCards[j].FeederStatus = :FdrStatus$NoSupply
                FROM   FMS_ObjectStatus S
                WHERE  S.Object = :ATSList[i].FeederCards[j].FeederID 
                AND    S.Status = :Status$CO AND
                       S.StatusCount > 0;              
                /* force CUTOUT status for ISOFeeder */
                IF ATSList[i].FeederCards[j].FeederType = Type$ISOFeeder THEN
                    ATSList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                ENDIF;
                j = j + 1;
                cntr = cntr + 1;
            ELSE
                ATSList[i].FeederCards.RemoveRow(rownumber=j);
            ENDIF;           
        END;
        i = i + 1;       
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    IF ISOFeeder = FALSE THEN
    /*
    ** For each Feeder, Get Equipment(s) on ATS
    */
      i = ATSList.LastRow();

      WHILE i > 0 DO
        j = ATSList[i].FeederCards.LastRow();
        WHILE j > 0 DO
            k = 1;
            REPEATED
            SELECT 
                 :ATSList[i].FeederCards[j].Equipments[k].EquipID  = G1.Member
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :ATSList[i].GrouperID
              AND G1.RelationShip  = :Interaction$MemberOf 
              AND G1.MemberType IN (SELECT Type 
                                    FROM Udb_ExtendedType 
                                    WHERE SuperType = :Type$ATSGeneric)
              AND G2.Member = G1.Member
              AND G2.Grouping = :ATSList[i].FeederCards[j].FeederID
              AND G2.Relationship = :Interaction$MemberOf
            BEGIN
      
                /** For each ATS piece of equipment, see if it is open,
                       but ignore it if it is normally open **/    
                REPEATED 
                SELECT :ATSList[i].FeederCards[j].Equipments[k].EquipStatus = CurrentlyOpen,
                       :ATSList[i].FeederCards[j].Equipments[k].NormalStatus = NormalOpen  
                FROM   UDB_Switch S
                WHERE  S.Object = :ATSList[i].FeederCards[j].Equipments[k].EquipID
                BEGIN
                /*
                ** Set status to FdrStatus$Ignore to ignore that feeder in the algorithm if switch
                ** is open and normal open and feeder is in service. This
                ** is an alternate supply feeder working fine.
                ** For other feeders, set status to FdrStatus$NoSupply if switch is opened
                */
                    IF ATSList[i].FeederCards[j].Equipments[k].EquipStatus = 1 AND
                       ATSList[i].FeederCards[j].Equipments[k].NormalStatus = 1 AND
                       ATSList[i].FeederCards[j].FeederStatus <> FdrStatus$NoSupply THEN
                        ATSList[i].FeederCards[j].FeederStatus = FdrStatus$Ignore;
                    ELSEIF ATSList[i].FeederCards[j].Equipments[k].EquipStatus = 1 THEN
                        ATSList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                    ENDIF;
                    k = k + 1;
                END;
            END;
            j = j - 1;
        ENDWHILE;
        i = i - 1;  
      ENDWHILE;
      CALLPROC DDB_ROLLBACK;
    
    /**
        If 100% of the associated feeders supplying to ATS's
        are out of service, set color to RED.

        If 50 thru 99% are out of service, set to yellow.
        If 1-49% set to White    
        If 0% (Use default color)    

        Since there may be more than 1 ATS for this feeder, 
        we need to tally for each ATS.  The one with the highest percentage
        will be used to determine color.
    **/

      Outage.Clear();
      Total.Clear();

      Pos = ATSList.LastRow();    
      i = 1;
      x = 1;
      WHILE Pos > 0 DO
        j = ATSList[Pos].FeederCards.LastRow();       
        Total[i].Value = 0;
        Outage[i].Value = 0;
        WHILE j > 0 DO
            /*
            ** Do not include alternate feeders in service in the 
            ** calculation  (FeederStatus = FdrStatus$Ignore)
            */
            IF ATSList[Pos].FeederCards[j].FeederStatus <> FdrStatus$Ignore THEN
                Total[i].Value = Total[i].Value + 1;
                /* 
                ** FdrStatus$Supply   means CUTIN  and Closed switch 
                ** FdrStatus$NoSupply means CUTOUT or  abnormal Closed switch 
                */
                IF ATSList[Pos].FeederCards[j].FeederStatus = FdrStatus$NoSupply OR
                (PreCheck = TRUE  AND 
                 CardDetails.Object.Find(AttributeName = 'Object', Value = ATSList[Pos].FeederCards[j].FeederID) = ER_OK) THEN
                    Outage[i].Value = Outage[i].Value + 1;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;
/*
**  Update the list of RED ATSs if called by precheck routine
*/
        IF PreCheck = TRUE  THEN
            IF (Total[i].Value = Outage[i].Value) AND (Total[i].Value <> 0) THEN
                RED_ATS[x].GrouperId = ATSList[Pos].GrouperId;
                RED_ATS[x].GrouperName = ATSList[Pos].GrouperName;
                RED_ATS[x].GrouperType = ATSList[Pos].GrouperType;
                x = x + 1;
            ENDIF;
        ENDIF;

        Pos = Pos - 1;
        i = i + 1;
      ENDWHILE;
/*
** Determine higher percentage 
*/
      Percentage = 0;
      IF ATSList.LastRow() > 0 THEN
        j = Total.LastRow();
        WHILE j > 0 DO
            IF Total[j].Value <> 0 THEN
                IF Percentage < float8(Outage[j].Value) / float8(Total[j].Value) * 100.0 THEN
                    Percentage = float8(Outage[j].Value) / float8(Total[j].Value) * 100.0;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;                      
      ELSE
        Percentage = 0;
      ENDIF;

      IF Percentage = 0 THEN
        ATS_Color = -1;
      ELSEIF Percentage < 50 THEN
        ATS_Color = CC_WHITE;
      ELSEIF Percentage < 100 THEN
        ATS_Color = CC_YELLOW;
      ELSEIF Percentage > 99 THEN
        ATS_Color = CC_RED;
      ENDIF;
    ENDIF;
/*
** Determine associated feeders thru HTV
*/
    HTVList.Clear();
    i = 1;
    REPEATED 
     SELECT DISTINCT
            :HTVList[i].GrouperID = G.Member,
            :HTVList[i].GrouperName = O.Name 
     FROM   Udb_Grouping G,
            Udb_Object O,
            TFMS_CardToObject CTO
     WHERE  CTO.Card = :CardDetails.Card 
        AND CTO.Object = G.Grouping   
        AND G.RelationShip = :Interaction$MemberOf  
        AND G.MemberType = :Type$AbstractHTV
        AND G.Member = O.Object
    BEGIN
            i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    /*
    ** Get Feeders sharing a HTV with current Feeder
    */
    i = HTVList.LastRow();
    WHILE i > 0 DO
       HTVList[i].FeederCards.Clear();
       j = 1;
       SELECT DISTINCT
           :HTVList[i].FeederCards[j].FeederID = Grouping,
           :HTVList[i].FeederCards[j].FeederType = GroupingType,
           :AssFeeders[cntr].value = Grouping
       FROM Udb_Grouping
       WHERE Groupingtype IN (SELECT Type 
                              FROM Udb_ExtendedType
                              WHERE Supertype = :Type$Feeder)
         AND Member = :HTVList[i].GrouperID
       BEGIN
           /* store feeder status: FdrStatus$Supply / FdrStatus$NoSupply */
           HTVList[i].FeederCards[j].FeederStatus = FdrStatus$Supply;
           SELECT :HTVList[i].FeederCards[j].FeederStatus = :FdrStatus$NoSupply
           FROM   FMS_ObjectStatus S
           WHERE  S.Object = :HTVList[i].FeederCards[j].FeederID 
           AND    S.Status = :Status$CO AND
                  S.StatusCount > 0;         
           /* force CUTOUT status for ISOFeeder */
           IF HTVList[i].FeederCards[j].FeederType = Type$ISOFeeder THEN
               HTVList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
           ENDIF;
           j = j + 1;
           cntr = cntr + 1;
       END;
       i = i - 1;       
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    IF ISOFeeder = FALSE THEN
    /*
    ** For each Feeder, Get Equipment(s) on HTV
    ** Only select HTV-Fdr switch that participate
    ** to the button color determination algorithm
    */
      i = HTVList.LastRow();

      WHILE i > 0 DO
        j = HTVList[i].FeederCards.LastRow();
        WHILE j > 0 DO
            k = 1;
            REPEATED
            SELECT 
                 :HTVList[i].FeederCards[j].Equipments[k].EquipID  = G1.Member
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :HTVList[i].GrouperID
              AND G1.RelationShip  = :Interaction$MemberOf 
              AND G1.MemberType IN (SELECT Type 
                                    FROM Udb_ExtendedType 
                                    WHERE SuperType = :Type$HTVFdr)
              AND G2.Member = G1.Member
              AND G2.Grouping = :HTVList[i].FeederCards[j].FeederID
              AND G2.Relationship = :Interaction$MemberOf
            BEGIN
                /** For each HTV-Fdr piece of equipment, see if it is open,
                       but ignore it if it is normally open **/    
                REPEATED 
                SELECT :HTVList[i].FeederCards[j].Equipments[k].EquipStatus = CurrentlyOpen,
                       :HTVList[i].FeederCards[j].Equipments[k].NormalStatus = NormalOpen  
                FROM   UDB_Switch S
                WHERE  S.Object = :HTVList[i].FeederCards[j].Equipments[k].EquipID
                BEGIN
                /*
                ** Set status to FdrStatus$Ignore to ignore that feeder in the algorithm if switch
                ** is open and normal open and feeder is in service. This
                ** is an alternate supply feeder working fine.
                ** For other feeders, set status to FdrStatus$NoSupply if switch is opened
                */
                    IF HTVList[i].FeederCards[j].Equipments[k].EquipStatus = 1 AND
                       HTVList[i].FeederCards[j].Equipments[k].NormalStatus = 1 AND
                       HTVList[i].FeederCards[j].FeederStatus <> FdrStatus$NoSupply THEN
                        HTVList[i].FeederCards[j].FeederStatus = FdrStatus$Ignore;
                    ELSEIF HTVList[i].FeederCards[j].Equipments[k].EquipStatus = 1 THEN
                        HTVList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                    ENDIF;
                    k = k + 1;
                END;
            END;
            j = j - 1;
        ENDWHILE;
        i = i - 1;  
      ENDWHILE;
      CALLPROC DDB_ROLLBACK;
    
    /**
        If 100% of the associated supply feeders due to HTV's
        are out of service, set color to RED.

        If 50 thru 99% are out of service, set to yellow.
        If 1-49% set to White    
        If 0% (Use default color)    

        Since there may be more than 1 HTV for this feeder, 
        we need to tally for each HTV.  The one with the highest percentage
        will be used to determine color.
    **/

      Outage.Clear();
      Total.Clear();

      Pos = HTVList.LastRow();    
      i = 1;
      x = 1;
      WHILE Pos > 0 DO
        j = HTVList[Pos].FeederCards.LastRow();       
        Total[i].Value = 0;
        Outage[i].Value = 0;
 
        WHILE j > 0 DO
            /*
            ** Do not include alternate feeders in service in the 
            ** calculation  (FeederStatus = FdrStatus$Ignore)
            ** Also only consider Supply Feeders (where there is
            ** an HTV-Fdr equipment)
            */
            IF HTVList[Pos].FeederCards[j].FeederStatus <> FdrStatus$Ignore AND
               HTVList[Pos].FeederCards[j].Equipments.LastRow() > 0 THEN
                Total[i].Value = Total[i].Value + 1;
                /* 
                ** FdrStatus$Supply   means CUTIN  and Closed switch 
                ** FdrStatus$NoSupply means CUTOUT or  abnormal Closed switch 
                */
                IF HTVList[Pos].FeederCards[j].FeederStatus = FdrStatus$NoSupply OR
                (PreCheck = TRUE  AND 
                 CardDetails.Object.Find(AttributeName = 'Object', Value = HTVList[Pos].FeederCards[j].FeederID) = ER_OK) THEN
                    Outage[i].Value = Outage[i].Value + 1;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;
/*
**  Update the list of RED HTVs if called by precheck routine
*/
        IF PreCheck = TRUE  THEN
            IF (Total[i].Value = Outage[i].Value) AND (Total[i].Value <> 0) THEN
               RED_HTV[x].GrouperId = HTVList[Pos].GrouperId;
               RED_HTV[x].GrouperName = HTVList[Pos].GrouperName;
               x = x + 1;
            ENDIF;
        ENDIF;

        Pos = Pos - 1;
        i = i + 1;
      ENDWHILE;
/*
** Determine higher percentage 
*/
      Percentage = 0;
      IF HTVList.LastRow() > 0 THEN
        j = Total.LastRow();
        WHILE j > 0 DO
            IF Total[j].Value <> 0 THEN
                IF Percentage < float8(Outage[j].Value) / float8(Total[j].Value) * 100.0 THEN
                    Percentage = float8(Outage[j].Value) / float8(Total[j].Value) * 100.0;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;                      
      ELSE
        Percentage = 0;
      ENDIF;

      IF Percentage = 0 THEN
        HTV_Color = -1;
      ELSEIF Percentage < 50 THEN
        HTV_Color = CC_WHITE;
      ELSEIF Percentage < 100 THEN
        HTV_Color = CC_YELLOW;
      ELSEIF Percentage > 99 THEN
        HTV_Color = CC_RED;
      ENDIF;
    ENDIF;
/**
    Get Feeders sharing an ISO situation with this Feeder

    Criteria:
        - Equipments member of a common ISONET-Grouper

    NOTE: Formerly, we used the following criteria:
        - A piece of Equipment on both feeders must be co-located.
        - Both pieces of equipment must have typws of "S", "S-T", or "I"
        - Both pieces of equipment must have networktypes of "ISO Network", 
                                 "460 Isolated Network", or "480 Isolated Netork".
**/
/*
** Determine associated feeder thru ISONET-Grouper
*/
    ISOList.Clear();
    i = 1;

    REPEATED 
    SELECT DISTINCT
         :ISOList[i].GrouperID = G2.Grouping,
         :ISOList[i].GrouperName = O.Name 
    FROM Udb_Grouping G1,
         Udb_Grouping G2,
         Udb_Object O,
         TFMS_CardToObject CTO
    WHERE CTO.Card = :CardDetails.Card 
      AND CTO.Object = G1.Grouping 
      AND G1.RelationShip = :Interaction$MemberOf 
      AND G1.Member = G2.Member 
      AND G2.RelationShip = :Interaction$MemberOf  
      AND G2.GroupingType = :Type$ISOGrouper
      AND G2.Grouping = O.Object
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    /*
    ** Get Feeders sharing those ISONET-Groupers with current Feeder
    */
    Pos = ISOList.LastRow();
    i = 1;
    
    WHILE i <= Pos DO
        ISOList[i].FeederCards.Clear();
        j = 1;   
        REPEATED
        SELECT DISTINCT
            :ISOList[i].FeederCards[j].FeederID = G1.Grouping,
            :ISOList[i].FeederCards[j].FeederType = G1.GroupingType,
            :AssFeeders[cntr].value = G1.Grouping
        FROM Udb_Grouping G1,
             Udb_Grouping G2
        WHERE G1.Groupingtype IN (SELECT Type 
                                 FROM Udb_ExtendedType
                                 WHERE Supertype = :Type$Feeder)
          AND G1.RelationShip = :Interaction$MemberOf 
          AND G1.Member = G2.Member 
          AND G2.Groupingtype = :Type$ISOGrouper
          AND G2.RelationShip = :Interaction$MemberOf 
          AND G2.Grouping = :ISOList[i].GrouperID
        BEGIN
            /* store feeder status: FdrStatus$Supply / FdrStatus$NoSupply */
            ISOList[i].FeederCards[j].FeederStatus = FdrStatus$Supply;
            SELECT :ISOList[i].FeederCards[j].FeederStatus = :FdrStatus$NoSupply
            FROM   FMS_ObjectStatus S
            WHERE  S.Object = :ISOList[i].FeederCards[j].FeederID 
            AND    S.Status = :Status$CO AND
                   S.StatusCount > 0;    
            /* force CUTOUT status for ISOFeeder */
            IF ISOList[i].FeederCards[j].FeederType = Type$ISOFeeder THEN
                ISOList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
            ENDIF;
            j = j + 1;
            cntr = cntr + 1;
        END;
        i = i + 1;       
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;
    /*
    ** For each Feeder, Get Equipment(s) on ISO
    */
    i = ISOList.LastRow();

    WHILE i > 0 DO
        j = ISOList[i].FeederCards.LastRow();
        WHILE j > 0 DO
            k = 1;
            REPEATED
            SELECT 
                 :ISOList[i].FeederCards[j].Equipments[k].EquipID  = G1.Member
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :ISOList[i].GrouperID
              AND G1.RelationShip  = :Interaction$MemberOf 
              AND G2.Member = G1.Member
              AND G2.Grouping = :ISOList[i].FeederCards[j].FeederID
              AND G2.Relationship = :Interaction$MemberOf
            BEGIN
                /** For each ISONET piece of equipment, see if it is open,
                       but ignore it if it is normally open **/    
                REPEATED 
                SELECT :ISOList[i].FeederCards[j].Equipments[k].EquipStatus = CurrentlyOpen,
                       :ISOList[i].FeederCards[j].Equipments[k].NormalStatus = NormalOpen  
                FROM   UDB_Switch S
                WHERE  S.Object = :ISOList[i].FeederCards[j].Equipments[k].EquipID
                BEGIN
                /*
                ** Set status to FdrStatus$Ignore to ignore that feeder in the algorithm if switch
                ** is open and normal open and feeder is in service. This
                ** is an alternate supply feeder working fine.
                ** For other feeders, set status to FdrStatus$NoSupply if switch is opened
                */
                    IF ISOList[i].FeederCards[j].Equipments[k].EquipStatus = 1 AND
                       ISOList[i].FeederCards[j].Equipments[k].NormalStatus = 1 AND
                       ISOList[i].FeederCards[j].FeederStatus <> FdrStatus$NoSupply THEN
                        ISOList[i].FeederCards[j].FeederStatus = FdrStatus$Ignore;
                    ELSEIF ISOList[i].FeederCards[j].Equipments[k].EquipStatus = 1 THEN
                        ISOList[i].FeederCards[j].FeederStatus = FdrStatus$NoSupply;
                    ENDIF;
                    k = k + 1;
                END;
            END;
            j = j - 1;
        ENDWHILE;
        i = i - 1;  
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;
    
    /**
        If 100% of the associated feeders supplying ISONET-Groupers
        are out of service, set color to RED.

        If 50 thru 99% are out of service, set to yellow.
        If 1-49% set to White    
        If 0% (Use default color)    

        Since there may be more than 1 ISONET-Grouper for this feeder, 
        we need to tally for each ISONET-Grouper. The one with the highest 
        percentage will be used to determine color.
    **/
    IF ISOFeeder = FALSE THEN

      Outage.Clear();
      Total.Clear();

      Pos = ISOList.LastRow();    
      i = 1;
      x = 1;
      WHILE Pos > 0 DO
        j = ISOList[Pos].FeederCards.LastRow();       
        Total[i].Value = 0;
        Outage[i].Value = 0;
        WHILE j > 0 DO
            /*
            ** Do not include alternate feeders in service in the 
            ** calculation  (FeederStatus = FdrStatus$Ignore)
            */
            IF ISOList[Pos].FeederCards[j].FeederStatus <> FdrStatus$Ignore THEN
                Total[i].Value = Total[i].Value + 1;
                /* 
                ** FdrStatus$Supply   means CUTIN  and Closed switch 
                ** FdrStatus$NoSupply means CUTOUT or  abnormal Closed switch 
                */
                IF ISOList[Pos].FeederCards[j].FeederStatus = FdrStatus$NoSupply OR
                (PreCheck = TRUE  AND 
                 CardDetails.Object.Find(AttributeName = 'Object', Value = ISOList[Pos].FeederCards[j].FeederID) = ER_OK) THEN
                    Outage[i].Value = Outage[i].Value + 1;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;
/*
**  Update the list of RED ISONETs if called by precheck routine
*/
        IF PreCheck = TRUE  THEN
            IF (Total[i].Value = Outage[i].Value) AND (Total[i].Value <> 0) THEN
                RED_ISO[x].GrouperId = ISOList[Pos].GrouperId;
                RED_ISO[x].GrouperName = ISOList[Pos].GrouperName;
                x = x + 1;
            ENDIF;
        ENDIF;

        Pos = Pos - 1;
        i = i + 1;
      ENDWHILE;
/*
** Determine higher percentage 
*/
      Percentage = 0;
      IF ISOList.LastRow() > 0 THEN
        j = Total.LastRow();
        WHILE j > 0 DO
            IF Total[j].Value <> 0 THEN
                IF Percentage < float8(Outage[j].Value) / float8(Total[j].Value) * 100.0 THEN
                    Percentage = float8(Outage[j].Value) / float8(Total[j].Value) * 100.0;
                ENDIF;
            ENDIF;
            j = j - 1;
        ENDWHILE;                      
      ELSE
        Percentage = 0;
      ENDIF;

      IF Percentage = 0 THEN
        ISO_Color = -1;
      ELSEIF Percentage < 50 THEN
        ISO_Color = CC_WHITE;
      ELSEIF Percentage < 100 THEN
        ISO_Color = CC_YELLOW;
      ELSEIF Percentage > 99 THEN
        ISO_Color = CC_RED;
      ENDIF;
    ENDIF;
/**
    Feeders networked with this feeder 
**/
 
    NetworkedFeeders.Clear();
    i = 1;
    REPEATED SELECT DISTINCT 
          :NetworkedFeeders[i].Feeder      = O.Object, 
          :AssFeeders[cntr].Value = O.Object,
          :NetworkedFeeders[i].FeederName  = O.Name,
          :NetworkedFeeders[i].Reference   = G.Reference
    FROM  
        Udb_Object O, 
        Udb_Grouping G,
        TFMS_CardToObject CTO
    WHERE CTO.Card = :CardDetails.Card 
    AND CTO.Object = G.Grouping 
    AND O.Object        = G.Member
    AND G.RelationShip  in (:Networked$With208, :Networked$With4kv)
    AND squeeze(G.Reference) in ('2','3','4')
    AND G.MemberType in
        ( Select Type from UDB_ExtendedType where SuperType = :Type$Feeder)

    BEGIN
        REPEATED SELECT  
            :NetworkedFeeders[i].Status = :Status$CO
        FROM        
            FMS_ObjectStatus S
        WHERE       
            S.Object = :NetworkedFeeders[i].Feeder 
        AND S.Status = :Status$CO; 

        cntr = cntr + 1;
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;

    i = NetworkedFeeders.LastRow();
    While i > 0 Do
        If NetworkedFeeders[i].Status = Status$CO Then        /** Networked Feeders (association matrix) **/
                If NetworkedFeeders[i].Reference = '2' Then
                    NetworkedFeeders[i].Color = CC_WHITE;  
                    NetworkedFeeders[i].Seq   = 3;
                ElseIf NetworkedFeeders[i].Reference = '3' Then
                    NetworkedFeeders[i].Color = CC_YELLOW;  
                    NetworkedFeeders[i].Seq   = 2;
                ElseIf NetworkedFeeders[i].Reference = '4' Then
                    NetworkedFeeders[i].Color = CC_RED;
                    NetworkedFeeders[i].Seq   = 1;
                Endif;
        Else
                NetworkedFeeders[i].Color = -1;
                NetworkedFeeders[i].Seq   = 99;
        Endif;  
        
        i = i - 1;
    Endwhile;
    

    /** 
        Sort the stuff by Seq this will cause the Feeders to be ordered by color
        (Red, Yellow, White, Then Black)
        (bubble sort) 

        - secondary sort is feedername
    **/        

    i = 1;
    WHILE i <= NetworkedFeeders.LastRow() DO
        j = i+1;
        WHILE j <= NetworkedFeeders.LastRow() DO
           IF varchar(NetworkedFeeders[i].Seq) + NetworkedFeeders[i].FeederName > 
              Varchar(NetworkedFeeders[j].Seq) + NetworkedFeeders[j].FeederName THEN
                TmpAssociatedFeeder = NetworkedFeeders[j].Duplicate();
                NetworkedFeeders[j] = NetworkedFeeders[i];
                NetworkedFeeders[i] = TmpAssociatedFeeder;
           ENDIF;
           j = j + 1;
        ENDWHILE;
        i = i + 1;
    ENDWHILE;

    /** 
        Make sure that current feeder is in associated feeder list.  This will insure
        that the colors are reset if the status for the current feeder changes.
    **/
    FOR f = 1 TO CardDetails.Object.LastRow() DO
       AssFeeders[cntr].value = CardDetails.Object[f].Object;
       cntr = cntr + 1;
    ENDFOR;
/*
** return networked feeders
*/
    return(NetworkedFeeders);

END;

