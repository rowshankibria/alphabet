Application Component Report
============================

	Name:            PromptATSRestoreToNormal

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    cac
**  Frame:          PromptATSRestoreToNormal         
**
**  Modifications:
**  04/20/15   em   Combine elements from PromptClearATSManualFromMacro and
**                  PromptCutIn to set ATS 101/102 back to normal status when
**                  ATSManual status is removed from "ATS"-only type macro.
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    ATS = ObjectSummaryClass;
    ATS102 = ObjectSummaryClass;
    ATS101 = ObjectSummaryClass;
    FeederCutOut = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Confirm the move equipment is an "ATS" type device.
*/ 
   ATS.Object = 0;
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS);

   IF ATS.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'PromptATSRestoreToNormal:  ' +
               'Job Action should only be performed from "ATS"-only type grouper. ' +
               'JobClass:' + VARCHAR(JIP.JobClass) + '; EquipType:' + JIP.EquipClassName
               );
      RETURN (PU_OK);
   ENDIF;
/*
** Hide Normally Open status in BaseType field
*/
   ATS101.Object = 0;
   REPEATED
   SELECT :ATS101.Object = O.Object,
          :ATS101.TypeName = O.TypeName,
          :ATS101.Name = O.Name,
          :ATS101.BaseType = S.NormalOpen 
   FROM   Udb_Object O,
          Udb_Grouping G,
          Udb_Switch S
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Object = S.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS101);

   IF ATS101.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptATSRestoreToNormal:  ATS setup problem. ' +
               'Unable to find ATS 101 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_OK);
   ENDIF;

   ATS102.Object = 0;
   REPEATED
   SELECT :ATS102.Object = O.Object,
          :ATS102.TypeName = O.TypeName,
          :ATS102.Name = O.Name,
          :ATS102.BaseType = S.NormalOpen  
   FROM   Udb_Object O,
          Udb_Grouping G,
          Udb_Switch S
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Object = S.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATS102);

   IF ATS102.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'Error::PromptATSRestoreToNormal:  ATS setup problem. ' +
               'Unable to find ATS 102 device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      RETURN (PU_OK);
   ENDIF;
/*
** IF 101 is normally closed then look for feeder C/O status.
*/
   FeederCutOut = 0;
   IF ATS101.BaseType = 0 THEN
            REPEATED
            SELECT :FeederCutOut = 1
            FROM Udb_Grouping G,
                 FMS_ObjectStatus OS
            WHERE G.Grouping = OS.Object AND 
                  OS.Status = :Status$CO AND
                  G.RelationShip = :Interaction$MemberOf AND
                  G.Member = :ATS101.Object AND
                  G.GroupingType IN (SELECT Type 
                                      FROM Udb_ExtendedType
                                      WHERE SuperType = :Type$Feeder);
/*
** If is in service then set ATS back to normal status
*/
            IF FeederCutOut = 0 THEN   
                   RetCode = CALLPROC SetStatus (Object = ATS101.Object,
                                                Status = Status$Closed);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS101.Object,
                                                Status = Status$Open);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC SetStatus (Object = ATS102.Object,
                                                Status = Status$Open);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS102.Object,
                                                Status = Status$Closed);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = ATS101.Object,
                                           CurrentlyOpen = 0); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to clear ATS open switch status for ATS ' +
                          JIP.EquipName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to clear ATS open switch ' +
                          'status for ATS ' + JIP.EquipName + '.'
                            );
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = ATS102.Object,
                                           CurrentlyOpen = 1); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to set ATS switch open status for ATS ' +
                          JIP.EquipName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to set ATS switch open ' +
                          'status for ATS ' + JIP.EquipName + '.'
                           );
                   ENDIF;
            ENDIF;
 
   ELSEIF ATS102.BaseType = 0 THEN
            REPEATED
            SELECT :FeederCutOut = 1
            FROM Udb_Grouping G,
                 FMS_ObjectStatus OS
            WHERE G.Grouping = OS.Object AND 
                  OS.Status = :Status$CO AND
                  G.RelationShip = :Interaction$MemberOf AND
                  G.Member = :ATS102.Object AND
                  G.GroupingType IN (SELECT Type 
                                      FROM Udb_ExtendedType
                                      WHERE SuperType = :Type$Feeder);
/*
** If is in service then set ATS back to normal status
*/
            IF FeederCutOut = 0 THEN   
                   RetCode = CALLPROC SetStatus (Object = ATS102.Object,
                                                Status = Status$Closed);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS102.Object,
                                                Status = Status$Open);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC SetStatus (Object = ATS101.Object,
                                                Status = Status$Open);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = ATS101.Object,
                                                Status = Status$Closed);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = ATS102.Object,
                                           CurrentlyOpen = 0); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to clear ATS open switch status for ATS ' +
                          JIP.EquipName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to clear ATS open switch ' +
                          'status for ATS ' + JIP.EquipName + '.'
                            );
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = ATS101.Object,
                                           CurrentlyOpen = 1); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to set ATS switch open status for ATS ' +
                          JIP.EquipName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to set ATS switch open ' +
                          'status for ATS ' + JIP.EquipName + '.'
                           );
                   ENDIF;
            ENDIF;

   ENDIF;

   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptCallSOCCSX

/*
**	Copyright c 1993 ESCA Corporation.  All rights reserved.
**
**	ESCA Corporation proprietary and trade secret information.
**	Do not copy or disclose to third parties without written 
**	permission from an officer of ESCA Corporation.
** 
**  Application:    FeederCard
**  Frame:          PromptCallSOCCSX 
**
**  September 1993  ADL   Frame created  
**  05/01/02        em    Modified table and procedure structure.           
**  11/01/02  em    Job to JIP. 
**  11/19/02  em    Adjust setting of Global Pending Variable
**                  Delete SOCCSX Messages for the user before inserting
**                  a new one.
**  02/18/04  em    Convert Message to TraceError
**  03/01/04  em    Exit when called during automation setup mode
**  05/23/05  em    Don't call SOCCSX Display if System Parameter has it
**                  disabled.  
**  10/13/08  ysp   Changed to check for Operator$XA21.
**  01/07/11  em    Updated to support 3G
**  12/13/12  em    Convert User Name to FMS Operator Name for XA21 Display Reference in case
**                  exceuted from TOMS.
**                  Change Delete Procedure to only delete older entries, older than ten minutes,
**                  to allow for records to come back for multiple breakers.
**  12/19/12  em    Modify parameters to SoccsxMessageIns
**  02/06/13  em    Use the Job Card ID when saving message not the FMS Card ID
**  03/17/15  em    When move is issued/controlled by a TOMS card, let TOMS XA21 
**                  Display Controller handle it so it doesn't leapfrog other
**                  issued moves in the station.  Use ControlCard field and compare to FMS Card.
**  09/21/22  em    SQUEEZE Position on database insert (2 of them) to remove leading or trailing blank
*/

INITIALIZE
(
    JIP = JobInProgress;    	/* PARAMETER - Job being processed */

    Card = INTEGER NOT NULL;    /* Card Number for related FMS card */
    Feeder = INTEGER NOT NULL;  /* Feeder for related FMS card */
    Position = VARCHAR(20) NOT NULL WITH DEFAULT; /*Station Source Breaker*/ 
    NetworkFeeder = INTEGER NOT NULL WITH DEFAULT; 
    status = INTEGER NOT NULL WITH DEFAULT; 
    FMSOperatorName = VARCHAR(5) NOT NULL WITH DEFAULT;
    Operator = INTEGER;
    Substn = VARCHAR(8) NOT NULL WITH DEFAULT; 
    SOCCSXDisplayCallUp = INTEGER NOT NULL WITH DEFAULT; 
    TORS = INTEGER NOT NULL WITH DEFAULT;
) = 
BEGIN 
   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;

   SELECT :SoccsxDisplayCallup = SOCCSXDisplayCallUp
   FROM   FMS_SystemParameters;

   IF SoccsxDisplayCallup = FALSE THEN
      RETURN (PU_OK);
   ENDIF;
 
   /* Find out the operator: */ 
   IF ((JIP.TOIssued IS NOT NULL) AND (JIP.TOComplete IS NULL)) THEN
      Operator = JIP.TOOperator;
      TORS = Job$TakeOutInt;
   ELSE
      Operator = JIP.RSOperator;
      TORS = Job$RestoreInt;
   ENDIF;
/*
** Process if the operator is assigned SOCCSX: 
*/ 
   IF (Operator = Operator$XA21) THEN

      Feeder = 0;
      NetworkFeeder = FALSE;
      REPEATED
      SELECT
      DISTINCT 
          :Feeder = C.Feeder,
          :Position = C.Position,
          :Card = C.Card,
          :NetworkFeeder = C.NetworkFeeder 
      FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
      WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;
/*
** IF the Job is not controlled by the FMS card, we are not going to call a display
** at this time.  Let TOMS XA21 Display Controller handle it.
*/
      IF JIP.ControlCard <> Card THEN
         RETURN(PU_OK);
      ENDIF;

      IF Feeder = 0 THEN    /* OK for 3G which is -1 */
          CALLPROC TraceError (UserMessage =
                 'ERROR: Prompt CallSOCCSX not related to FMS Card.',
                           TraceMessage =
                 'PromptCallSOCCSX: Move is not related properly to ' +
                 'an FMS Card.'
                           );
         RETURN (PU_CANCEL);
      ENDIF;  
/*
** If 3G, must obtain valid feeder with substation relationship.
** PrimaryGrouping for Feeder must be substation and source breaker
** must have same name as top of card.
** If we cannot ascertain Substation/Source Breaker relationship, then
** we don't have a valid call to SOCCSX.
*/
      IF NetworkFeeder = TRUE THEN
         Feeder = 0;
         REPEATED
         SELECT  :Feeder = G.Grouping,
                 :Substn = O3.Name
         FROM   TFMS_CardToObject CTO,
                Udb_Grouping G,
                Udb_Object O1,
                Udb_Object O2,
                Udb_Object O3,
                Udb_ExtendedType ET
         WHERE  CTO.Card = :Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$SourceBreaker AND
                G.Member = O1.Object AND
                O1.Name = :Position AND
                G.Grouping = O2.Object AND
                O2.PrimaryGrouping = O3.Object AND
                O3.Type = ET.Type AND
                ET.SuperType = :Type$Substation;

         IF Feeder = 0 THEN
            CALLPROC TraceError (UserMessage =
                   'ERROR: 3G Feeder, cannot determine source substation for call to XA21.',
                             TraceMessage =
                   'PromptCallSOCCSX: Cannot determine source substation for 3G feeder card. ');
            RETURN(PU_OK);
         ENDIF;
      ELSE

      /* Get SCADA version of substation name: */ 
         SELECT :Substn = O.PrimaryGroupingName 
         FROM   Udb_Object O 
         WHERE  O.Object = :Feeder; 

      ENDIF;

      FMSOperatorName = Left(UserName, 2) + '2' + Right(UserName,2);

      /* Send a message to XA21: */ 
      status = CALLPROC SendRapportInstruction 
            ( Substation = Substn, 
              Device     = SQUEEZE(Position) ); 

      IF (status <> 0) THEN 
          CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to send message to XA21.',
                             TraceMessage =
                   'PromptCallSOCCSX: Unable to send message to XA21. ');
         RETURN (status); 
      ENDIF; 
/*
** Delete any other Soccsx Messages this user has before inserting a new one.
*/
      status = CALLPROC FMS_SoccsxMessageDel
                     ( UserName = UserName );
      IF (status <> 0) THEN
          CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to delete old XA21 messages.',
                             TraceMessage =
                   'PromptCallSOCCSX: Unable to delete old XA21 messages.' 
                             );
      ELSE
/* 
** Store data about the message, as a reference when XA21
** sends a return message      
*/ 
         status = CALLPROC FMS_SoccsxMessageIns 
                  ( Card       = JIP.Card, 
                    Job        = JIP.Job,
                    TORS       = TORS,
                    Application = CurrentApplication,
                    UserName   = UserName,
                    DisplayUserName   = FMSOperatorName, 
                    Substation = Substn, 
                    Device     = SQUEEZE(Position), 
                    MessageTime = 'now' 
                   ); 
         IF (status <> 0) THEN 
             CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to insert new XA21 messages.',
                             TraceMessage =
                   'PromptCallSOCCSX: Unable to insert new XA21 messages.' 
                             );
         ENDIF;
      ENDIF; 
   ENDIF;

   IF (status = 0) THEN 
     RETURN (PU_OK); 
   ELSE 
     RETURN (PU_CANCEL); 
   ENDIF; 
END; 

Application Component Report
============================

	Name:            PromptCapBankOpenMsg

/*
**
**	Copyright c 2016 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptCapBankOpenMsg
**
**  Modifications:
**   12/08/16   em  Created to send email to ACDO during summer period.
**   12/12/16   em  Added Open Timestamp
**   02/13/17   em  Removed temporary code.
**   06/24/21   em  Add OOEM SLC Card Class
*/
INITIALIZE
(
    JIP = JobInProgress;		/* Job being processed */

    CapBankBkr = INTEGER NOT NULL WITH DEFAULT;
    DBEventText = VARCHAR(200) NOT NULL WITH DEFAULT;
    EventID = INTEGER NOT NULL WITH DEFAULT;
    JIPMonth = INTEGER NOT NULL WITH DEFAULT;
    Message1 = VARCHAR(200) NOT NULL WITH DEFAULT;
    RequestID = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
    SwItemCardClass = INTEGER NOT NULL WITH DEFAULT;
    SwItemCardClassName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
** Prompt should be called only when move exists on an SLC card.
** Controlled by SLC Job Action.  During summer period for an 
** SLC Auto,OOE1,OOE2 item, send ACDO notification email when Cap 
** Bank Breaker is racked out.
** Assume RackOut happens on TOComplete.
*/
   JIPMonth = MONTH(JIP.TOComplete);
   IF JIPMonth < 6 OR JIPMonth > 8 THEN 
/* MESSAGE 'We are running outside summer scope in month ' + VARCHAR(JIPMonth); */
      RETURN(PU_OK);
   ENDIF;        

   SwItemCardClass = 0;
   SELECT :SwItemCardClass = CardClass,
          :SwItemCardClassName = CardClassName
   FROM   SLC_InformationItem
   WHERE  Job = :JIP.SwitchingItem AND
          CardClass IN (:Type$SLCAuto, :Type$SLCOOE1, :Type$SLCOOE2, :Type$SLCOOEM);

   IF SwItemCardClass = 0 THEN
      RETURN(PU_OK);
   ENDIF;        

   CapBankBkr = FALSE;
   REPEATED
   SELECT :CapBankBkr = Object
   FROM   Udb_Object 
   WHERE  Object = :JIP.Equip AND
          Type IN (SELECT Type FROM Udb_ExtendedType 
                   WHERE  SuperType = :Type$BREAKER) AND
          Name LIKE '%C%';
/*
** E179ST 54 is a cap bank
*/
   IF JIP.Equip = 173590 THEN
      CapBankBkr = TRUE;
   ENDIF;

   IF CapBankBkr = FALSE THEN   
      RETURN(PU_OK);
   ENDIF;        
/* 
** If code hasn't exited yet, then we have an outage to report
*/
   SubstationName = '';
   SELECT :SubstationName = Name
   FROM   Udb_Object 
   WHERE  Object = :JIP.Substation;

   IF SubstationName = '' THEN
      SubstationName = 'Unidentified Substation Obj = ' + VARCHAR(JIP.Substation);
   ENDIF;
/*
** Remainder of code cut, paste, modified from BugReport app
** get the next email notification id
*/
   RequestID = 0;
   SELECT :RequestID = MAX(RequestID) + 1
   FROM   FMS_EmailNotification;
/*
** save report to the database
*/
   Message1 = 'Substation=' + SubstationName + ';;' +
              'Breaker=' + JIP.EquipName + ';;' + 
              'CardClass=' + SwItemCardClassName + ';;' +
              'OpenTime=' + VARCHAR(JIP.TOComplete) + ';;';

   RetCode = CALLPROC FMS_EmailNotificationIns(
                            RequestID = RequestID,
                            RequestTime = DATE('now'),
                            EmailType = 16,
                            Sender = DOP.Description,
                            Recipient = 'ACDO',
                            Subject = SubstationName + ' Cap Bank ' +
                                      JIP.EquipName + ' opened ' + SwItemCardClassName +
                                      ' at ' + VARCHAR(JIP.TOComplete),
                            Message1 = Message1,
                            Message2 = '',
                            Template = 'CapBankOpenToCDO.html');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to save Cap Bank Open message to ACDO.',
                           TraceMessage =
                  'PromptCapBankOpenMsg: Unable to save Cap Bank Open message to ACDO ' +
                  'for Job=' + VARCHAR(JIP.Job) );
      RETURN(PU_CANCEL);
   ENDIF;
/*
** Raise a db event to CSD Monitor
*/
   EventID = CALLPROC FMS_DBEventQueueIns(
                 Time = DATE('NOW'),
                 Name = 'FMS_EmailNotification',
                 Text = VARCHAR(RequestID),
                 ToApp = 'CSD',
                 FromApp = CurrentApplication);
   IF EventID < 0 THEN
      CALLPROC DDB_ROLLBACK;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;  
  
   DBEventText = VARCHAR(EventID) + ';' + CurrentApplication + ';' + VARCHAR(RequestID);
   CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_EmailDBEvent',
                             DBEventText = DBEventText);
   CALLPROC DDB_COMMIT;
 
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
	RESUME;
END;


Application Component Report
============================

	Name:            PromptCheckCutin

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptCheckCutIn
**
**  Modifications:
**  02/02/96    jfl     Created
**  04/17/96    jfl     Prompt for confirmation of Cutin Move
**  03/26/99    em      Incorporated into SOA
**  06/04/99    em      Make sure move is in EnDeEn Substation
**  10/12/99    em      Don't set CutIn if not CutOut
**  06/06/00    em      Ignore EnDeEn, set CutIn time for first device closed
**  06/30/01    em      Don't prompt for CutIn if the device is Isolated.
**                      Re-Use IsolationTrace developed for EnDeEnCheck.
**  10/29/02    em      Job to JIP
**  01/16/04    em      Card selection bug, need controlcard from SOA_Job
**  02/18/04    em      If automatic execution, use current time.
**  07/22/05    ysp     Download TFMS cutin to Rapid Restore
**  01/11/05    pkw     Clear all operating steps.
**  05/03/06    em      Since multiple cards may be involved, this frame
**                      turns into CutIn Manager frame - does not display.
**  04/23/07    ysp     ITC210: Insert IR interface event in DB event queue
**  05/09/07    ysp     Add Notification to CIG of CutIn
**  07/27/07    ysp     Not to download CutIn if it is TFMS Black Start card type
**  12/04/07    pkw     Add LogAppend to SimpleTFMS call.
**  11/13/14    em      Use Job RSCompletion timestamp if it exists when in Automatic Execution
**  08/27/18    em      When in AutomaticExecution, Set ActualInserviceDate to cover XA21 completion.
**
**
**  ANY CHANGES MADE IN THIS FRAME MUST ALSO BE MADE IN TFMSCutIn!!!!!!!!!!
*/

INITIALIZE
(
    JIP = JobInProgress;          /* Passed Job */

    Card = INTEGER NOT NULL;      /* TFMS card */
    CardDetails = CardTFMS;        /* Card Class */
    Cards = ARRAY OF INTEGEROBJECT;  /*May have to process multiple cards*/

    EventText = VARCHAR(80) NOT NULL WITH DEFAULT;
    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL;       
    k = INTEGER NOT NULL;       
    SingleSWP = OutageReport DEFAULT NULL;
) =
DECLARE
    ClearOperatingSteps = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    RetCode = PU_OK;
    IF JIP.Substation = 0 THEN
       RETURN(PU_OK);
    ENDIF;
/*
**  Make sure we have a transmission card.  Procedure can be called
**  from SLC in SOA.
*/
   Cards.Clear();
   i = 1;
   REPEATED
   SELECT
   DISTINCT
          :Cards[i].Value = JC.Card 
   FROM   SOA_JobControl JC,
          SOA_Job J,
          SOA_ActiveCard AC
   WHERE  J.Job = :JIP.Job AND
          J.Job = JC.Job AND
          JC.Card = AC.Card AND
          AC.Application = :Application$TFMS
   BEGIN
      i = i + 1;
   END;

   IF Cards.LastRow() = 0 THEN
      RETURN(PU_OK);
   ENDIF; 
 
   FOR k = 1 TO Cards.LastRow() DO
      Card = Cards[k].Value; 
      CardDetails = CardDetails.LoadCard (Card = Card);
/*
** Only consider situation if cutin time is unknown
** Don't worry if cutin time is already set
*/
      IF CardDetails.CutOut = '' OR CardDetails.CutOut IS NULL THEN
         CONTINUE;
      ENDIF;

      IF CardDetails.CutIn <> '' AND CardDetails.CutIn IS NOT NULL THEN
         CONTINUE;
      ENDIF;
/* 
**  Perform a connectivity trace here to check if the current device is isolated
**  from an ACLineSegment on the Card.  
**  If it is, we don't need to prompt for CutIn
*/
      RetCode = CALLPROC IsolationTrace (
                          Equip = JIP.Equip,
                          Card = Card,
                          IsolatedFromType = Type$ACLineSegment);
      IF RetCode = PU_CANCEL THEN  /*Cancel = Isolated*/
         CONTINUE;
      ENDIF;
/*
**  Assume CutIn if automatic execution
*/
      IF AutomaticExecution = TRUE THEN
         IF JIP.RSComplete <> '' AND JIP.RSComplete IS NOT NULL THEN
            CardDetails.CutIn = JIP.RSComplete;
         ELSE
            CardDetails.CutIn = 'now';
         ENDIF;
         RetCode = CardDetails.UpdateCard(); 

         IF RetCode = PU_OK THEN
            RetCode = CALLPROC ClearOperatingSteps;
         ENDIF;

         IF CardDetails.CardClassName <> 'TEST' AND
            CardDetails.CardClass <> Type$TFMSBLCK THEN
            EventText = VARCHAR(Card) + ';0;CUTIN;';
            CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSCloseCard',
                     EventText = EventText);
            /*
            ** Notify CIG of CutIn
            */
            CardDetails.NotifyCutIn();
         ENDIF;
         /*
         ** Cover card cutin update for XA21 completion..  
         **/
         SingleSWP = OutageReport.Create();
         SingleSWP.SetActualInServiceDate(JIP = JIP);

         IF RetCode <> PU_OK THEN
           RETURN (RetCode);
         ENDIF;
      ELSE
         Retcode = CALLFRAME TFMSCutIn (Card = Card,
                              JIP = JIP,
                              CardDetails = CardDetails);
      ENDIF;
      
   
   ENDFOR;
   RETURN(RetCode);
END;

PROCEDURE ClearOperatingSteps (
) =
DECLARE
   PFSCleared       = INTEGER NOT NULL WITH DEFAULT;
   TFMSStep         = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
ENDDECLARE
BEGIN
   /*
   **  Start Operating Steps if card was cutout ok.
   */
   IF TFMSStep IS NULL THEN
      TFMSStep = TFMSOpStep_ASE.Create();
   ENDIF; 
   SELECT DISTINCT
        :TFMSStep.SO.Object   = C.Card,
        :TFMSStep.SO.BaseType = C.CardClass,
        :TFMSStep.SO.Name     = C.CardClassName,
        :TFMSStep.SO.Type     = J.ControlCard,
        :TFMSStep.SO.TypeName = AC.CardName
   FROM  SOA_Job J,
         SOA_ActiveCard AC,
         SOA_Card C
   WHERE J.Job = :JIP.Job AND
         C.Card = :Card AND
         C.Card = AC.Card; 
   CALLPROC DDB_ROLLBACK;

   TFMSStep.Job       = JIP.Job;
   TFMSStep.LogAppend = 'Cutin';
   TFMSStep.EndTime   = IFNULL(CardDetails.CutIn,'');
   /*
   **  Find all outstanding operatingstep and clear them all out.
   */
   PFSCleared = FALSE;
   SELECT :TFMSStep.OpStep    = D.OperatingStep
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :TFMSStep.SO.Object AND
           D.EndTime = ''
   BEGIN 
      /*
      **  This will clear detail AND any summary table if needed.
      */
      TFMSStep.ClearOpStep(NoSummaryIns = TRUE);

      IF TFMSStep.ReturnCode <> 0 THEN
         CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
           TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
           'Prompt:PromptCheckCutIn; ' +
           'Error clearing a TFMS Operating Step. ' +
           'Card=' + VARCHAR(Card) +
           ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
           );
         TFMSStep = NULL;
         RETURN (PU_Cancel);
      ENDIF; 
      IF TFMSStep.OpStep = OpSt$PFS THEN
         PFSCleared = TRUE;
      ENDIF;
   END;
   /*
   **  
   */
   IF PFSCleared = FALSE THEN
      TFMSStep.BackTrackPFS();
   ENDIF;
   /*
   **  Now set the R/S step.
   */
   TFMSStep.StartTime = IFNULL(CardDetails.CutIn,'');
   TFMSSTep.OpStep    = OpSt$RS;

   TFMSStep.SetOpStep();

   IF TFMSStep.ReturnCode <> 0 THEN
      CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
        TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
        'Prompt:PromptCheckCutIn; ' +
        'Error setting a R/S TFMS Operating Step. ' +
        'Card=' + VARCHAR(Card) +
        ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
        );
      TFMSStep = NULL;
      RETURN (PU_Cancel);
   ENDIF; 
   
   TFMSStep = NULL;
   
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptCheckCutOut

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          PromptCheckCutOut
**
**  Modifications:
**  02/02/96 jfl        Created
**  04/17/96 jfl        Enable selection of move as Cutout Move
**  06/20/96 jfl        Add column tocomplete
**  03/25/99 em         Incorporated into SOA
**  06/04/99 em         Present cutout option if this is the last device
**                      in the EnDeEn Station.
**  06/06/00 em         Don't care about EnDeEn station.  If it is the last
**                      CutOut on the card, use it.
**  11/15/00 em         Don't load CutOut moves that are not complete.
**  02/26/01 em         Ignore Spare Bank Breakers.
**  05/17/01 em         Ignore Circuit Switcher (Type$CktSwer)
**  06/30/01 em         Don't prompt for CutOut if the device is Isolated.
**                      Re-Use IsolationTrace developed for EnDeEnCheck.
**                      Finally a TRACE is reused!!!
**  10/04/02 em         Add CktInterrupt to excluded CutOut types.
**  10/29/02 em         Job to JIP
**  01/19/04 em         Card selection bug, need controlcard from SOA_Job
**  02/18/04 em         If automatic execution, use timestamp from current
**                      move.
**  06/21/05 ysp        Download tfms card cutout to RR
**  01/11/05 pkw        Set C/O or INVS operating step.
**  05/03/06 em         Since multiple cards may be involved, this frame
**                      turns into CutOut Manager frame - does not display.
**  04/16/07 ysp        ITC210: Insert IR interface event in DB event queue
**  05/09/07 ysp        Add Notification to CIG of CutOut
**  07/27/07 ysp        Not to download CutOut if it is TFMS Black Start card type
**  08/09/07 em         Fixed screen appearance issues -
**  08/29/07 ysp        For Open Auto, check closed breakers on the card to determine
**                      cutout time prompt. For other type of cards, use the line 
**                      memebership.
**  12/04/07 pkw        Add LogAppend to SimpleTFMS call.
**  09/17/15 em         Modify CutOut determination process for non-AUTO/OOE1 cards.
**                      Use connectivity trace.
**  10/01/15 em         Default CutOutTrace call to ClosedBreakers = 1
**  03/23/17 em         Passing back PU_CANCEL from CutOut trace producing unnecessary trace
**                      message from Job Actions, Modify CutOutTrace to have three return values
**                      Return value = -1 means not CutOut.
**  04/24/18 em         When in AutomaticExecution, Set ActualOutageDate to cover XA21 completion.
**
**
**  ANY CHANGES MADE IN HERE SHOULD ALSO BE MADE IN TFMSCutOut which is called from here.
*/

INITIALIZE
(
    JIP = JobInProgress;          /* Passed Job */

    Card = INTEGER NOT NULL;      /* TFMS card */
    CardDetails = CardTFMS;        /* Card Class */
    Cards = ARRAY OF INTEGEROBJECT;  /*May have to process multiple cards*/
 
    SelectRow = INTEGER NOT NULL; /* Clicked RowNumber */
    retcode = INTEGER NOT NULL;   /* return variable */
    i = INTEGER NOT NULL;       
    k = INTEGER NOT NULL;       
    ClosedBreakers = INTEGER NOT NULL;
    BreakerType = INTEGER NOT NULL; /*Compare Bkr Type to Spare Bank Types*/
    ACLineSegFound = INTEGER NOT NULL;  /*Starting point for second trace*/
    SingleSWP = OutageReport DEFAULT NULL;
) =
DECLARE
    StartOperatingSteps = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Make sure we have a transmission card.  Procedure can be called
**  from SLC in SOA.
*/
   RetCode = PU_OK;
   Cards.Clear();
   i = 1;
   REPEATED
   SELECT
   DISTINCT
          :Cards[i].Value = JC.Card 
   FROM   SOA_JobControl JC,
          SOA_Job J,
          SOA_ActiveCard AC
   WHERE  J.Job = :JIP.Job AND
          J.Job = JC.Job AND
          JC.Card = AC.Card AND
          AC.Application = :Application$TFMS
   BEGIN
      i = i + 1;
   END;

   IF Cards.LastRow() = 0 THEN
      RETURN(PU_OK);
   ENDIF; 
 
   FOR k = 1 TO Cards.LastRow() DO
      Card = Cards[k].Value; 
      CardDetails = CardDetails.LoadCard (Card = Card);
/*
** Only consider situation if cutout time is unknown
*/
      IF CardDetails.CutOut = '' OR CardDetails.CutOut IS NULL THEN
/*
**  Perform a connectivity trace here to check if the current device is isolated
**  from an ACLineSegment on the Card.
**  If it is, we don't need to prompt for CutOut
*/
         ACLineSegFound = 0;
         RetCode = CALLPROC IsolationTrace (
                          Equip = JIP.Equip,
                          Card = Card,
                          IsolatedFromType = Type$ACLineSegment,
                          IsolatedFromEquip = BYREF(ACLineSegFound) );
         IF RetCode = PU_CANCEL THEN  /*Cancel = Isolated*/
            RetCode = PU_OK;  /*Reset*/
            CONTINUE;
         ENDIF;
/* 
** For Open Auto and OOE1, count all closed breakers on the card.  
** For other type of cards, count all closed breakers on the lines 
** on the card. 
** In both cases, we exclude the one we are on, because of timing 
** it may not yet be open.
*/
         IF CardDetails.CardClass = Type$TFMSAuto OR CardDetails.CardClass = Type$TFMSOOE1 THEN
            ClosedBreakers = 0;
            REPEATED
            SELECT :BreakerType = J.EquipClass
            FROM   SOA_Job J,
                   SOA_JobControl JC,
                   Udb_ExtendedType ET,
                   Udb_Switch S
            WHERE  JC.Card = :Card AND
                   JC.Job <> :JIP.Job AND
                   JC.Job = J.Job AND
                   J.Status = '' AND
                   J.EquipClass = ET.Type AND
                   ET.SuperType = :Type$LoadBreaking AND
                   J.Equip = S.Object AND
                   S.CurrentlyOpen = :FALSE
            BEGIN
               i = 0;
               /*
               ** To avoid NOT IN, we put our exclusions here
               */
               SELECT :i = COUNT(*) 
               FROM   Udb_ExtendedType 
               WHERE  Type = :BreakerType AND
                      SuperType IN 
                        (:Type$BkrSpare, 
                         :Type$BkrROSpare, 
                         :Type$CktSwer,
                         :Type$CktInterrupt);

               IF i = 0 THEN     
                  /*
                  **  We must count this closed breaker since it is not a spare
                  */            
                   ClosedBreakers = ClosedBreakers + 1;
               ENDIF;
             END;
         ELSE
            ClosedBreakers = 0;
/********
**  Work for sep 2015 TFMS Cutout Enhancement.  Old Code is commented out.
*
            REPEATED
            SELECT :BreakerType = G.MemberType
            FROM   Udb_Grouping G,
                   TFMS_CardToObject CTO,
                   Udb_ExtendedType ET,
                   Udb_Switch S
            WHERE  CTO.Card = :Card AND
                   CTO.Object = G.Grouping AND
                   G.GroupingType = :Type$Line AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = ET.Type AND
                   ET.SuperType = :Type$LoadBreaking AND
                   G.Member <> :JIP.Equip AND
                   G.Member = S.Object AND
                   S.CurrentlyOpen = :FALSE
            BEGIN
               i = 0;
               /*
               ** To avoid NOT IN, we put our exclusions here
               *
               SELECT :i = COUNT(*) 
               FROM   Udb_ExtendedType 
               WHERE  Type = :BreakerType AND
                      SuperType IN 
                        (:Type$BkrSpare, 
                         :Type$BkrROSpare, 
                         :Type$CktSwer,
                         :Type$CktInterrupt);

               IF i = 0 THEN     
                  /*
                  **  We must count this closed breaker since it is not a spare
                  *            
                   ClosedBreakers = ClosedBreakers + 1;
               ENDIF;
             END;
*******/
/*
** Initiate connectivity trace that looks past ACLineSegment going to the first breaker only.
** All must be open to consider card CutOut.  If all breakers not open will return pu_cancel.
*/
             retcode = CALLPROC CutOutTrace (
                          MoveEquip = JIP.Equip,
                          Card = Card,
                          TraceStartEquip = ACLineSegFound);
             IF retcode = PU_CANCEL THEN
                RETURN(retcode);     /*Error Condition*/
             ELSEIF retcode = PU_OK THEN
                ClosedBreakers = 0;
             ELSE
                ClosedBreakers = -1;  /*Not CutOut*/
                RetCode = PU_OK;  /*Reset*/
             ENDIF;

         ENDIF;
/*
**  Prompt for selection of cutout move only when last breaker has been opened
**  If Automatic Execution, don't display screen, just use current move
*/
          IF ClosedBreakers = 0 THEN

             IF AutomaticExecution = TRUE THEN 
                IF JIP.TOComplete IS NULL OR JIP.TOComplete = '' THEN
                   CardDetails.CutOut = 'now';
                ELSE 
                   CardDetails.CutOut = JIP.TOComplete;
                ENDIF;
                RetCode = CardDetails.UpdateCard(); 
      
                IF RetCode = PU_OK THEN
                   RetCode = CALLPROC StartOperatingSteps;
                ELSE
                   RETURN (RetCode);    
                ENDIF;

                IF CardDetails.CardClassName <> 'TEST' AND
                   CardDetails.CardClass <> Type$TFMSBLCK THEN
                   CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSCutout',
                     EventText = VARCHAR(Card));
                /*
                ** Notify CIG of CutOut
                */
                   CardDetails.NotifyCutOut();
                ENDIF;
                /*
                ** Cover card cutout update for XA21 completion.
                */
                SingleSWP = OutageReport.Create();
                SingleSWP.UpdateActualOutageDate(JIP = JIP,
									 Card=Card,
                                     CutOut=CardDetails.CutOut);
             ELSE
                RetCode = CALLFRAME TFMSCutOut (Card = Card,
                                   JIP = JIP,
                                   CardDetails = CardDetails);
                IF RetCode <> PU_OK THEN
                   RETURN (RetCode);
                ENDIF;
             ENDIF; 
          ELSE
             CONTINUE;
          ENDIF;
      ENDIF;  
   ENDFOR;
   RETURN (RetCode);     
END;


ON WindowClose =
BEGIN
    RESUME;
END;


PROCEDURE StartOperatingSteps (
) =
DECLARE
   TFMSStep = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
ENDDECLARE
BEGIN
   /*
   **  Start Operating Steps if card was cutout ok.
   */
   IF TFMSStep IS NULL THEN
      TFMSStep = TFMSOpStep_ASE.Create();
   ENDIF; 
   SELECT DISTINCT
        :TFMSStep.SO.Object   = C.Card,
        :TFMSStep.SO.BaseType = C.CardClass,
        :TFMSStep.SO.Name     = C.CardClassName,
        :TFMSStep.SO.Type     = J.ControlCard,
        :TFMSStep.SO.TypeName = AC.CardName
   FROM  SOA_Job J,
         SOA_ActiveCard AC,
         SOA_Card C
   WHERE J.Job = :JIP.Job AND
         C.Card = :Card AND
         C.Card = AC.Card; 
   IF TFMSStep.SO.BaseType = Type$TFMSAuto THEN
      TFMSStep.OpStep = OpSt$INVS;
   ELSE
      TFMSStep.OpStep = OpSt$CO; 
   ENDIF;
   /* 
   **  Set start time of operating step.
   */
   TFMSStep.StartTime = IFNULL(CardDetails.CutOut,'');
   TFMSStep.Job       = JIP.Job;
   TFMSStep.LogAppend = 'Cutout';

   TFMSStep.SetOpStep();
   
   IF TFMSStep.ReturnCode <> 0 THEN
      CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
        TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
        'Prompt:PromptCheckCutout; ' +
        'Error setting a TFMS Operating Step. ' +
        'Card=' + VARCHAR(Card) +
        ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
        );
      TFMSStep = NULL;
      RETURN (PU_Cancel);
   ENDIF; 
   TFMSStep = NULL;
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            PromptCheckDBF

/*
**
**	Copyright c 1991 Unified Information, Inc. All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptCheckDBF
**
**  Modifications:
**	07/27/92 em	set feeder status according to response. ml #18. 
** 08/19/92 em     (ON-SITE) Insert new move when alive on backfeed.
** 10/22/92 em     modified per integer/udb 
** 11/09/92 em     added call to force status. 
** 12/05/92 mts    Updated db calls to use dbprocs for dual database
** 12/20/92 gjc     added window close logic to fix bug 6.
** 02/05/93 em     removed logic concerned with card deadonbackfeed field.
** 12/08/93 em     added bypass parameter
** 02/12/01 my     get BackFeedCheckResult from ir_downloadmove table,
**                 if the value of BackFeedCheckResult is not blank, then
**                 disable cancelbutton.
** 02/23/01 em     Code Review
** 04/05/01 em     Force GroundOn to NULL for NewJob
** 09/04/01 pkw    If we can't resolve message from SO, tell D.O. and
**                 allow them to change it.  We will log what we were 
**                 trying to resolve to help track down the error.
** 09/09/02 pkw    If feeder is ABF, put delay on feeder.  IF DBF, clear delay
**                 from feeder.  This delay will not be linked to any jobs.  It
**                 is a feeder delay and the only ways for it to be removed is 
**                 for this prompt to be returned DBF or the DO must remove 
**                 it manually.
** 09/26/02 pkw    Send message to DCC.
** 01/06/03 em     Job to JIP
** 03/05/03 ysp    Retrieve BackFeed result from ir_BackFeed table
** 03/21/03 pkw    Set status = '' when inserting new DBF move.
** 02/20/04 em     Convert Message to TraceError Call.  Handle Alive/Dead
**                 response during process automation.
** 04/22/04 pkw    Add support for Operating Step process.
** 04/29/04 em     Call ClearABFStep method directly
** 08/31/05 ysp    Application specific code if ABF processed in SLC
** 05/30/06 pkw    Set Delay$ABF starttime to Cutout time.
** 07/20/06 pkw    Make sure there wasn't a previous ABF delay.  We will get
**                 a duplicate error if we try to re-insert.
** 08/09/07 pkw    Added a DDB_commit after operating steps are inserted AND 
**                 avoided going to SOA_ActiveCard on select.
** 11/01/10 em     Set status for all feeders on 3G card.
** 02/14/13 pkw    When card is linked to 4kV stepdown and SD-VIS is closed 
**                 and feeder is DEAD set status on both feeders.
** 04/25/16 em     Extended Feeder select to extended grouping to include 33kV Feeders
** 05/06/16 em     33kV Exclude feeder segments fed by another feeder
** 08/25/16 ysp    For 33kv, set DBF status on segments on this card and exclude segments
**                 fed by other feeders.
** 12/02/16 em     Not incrementing counter for 33kV
** 01/16/20 em     This prompt has been applied to the Check Alive on Backfeed move on 4kv Cards.
**                 The expected response for this move is ABF - and we don't want a new move 
**                 inserted.  Code adjustment will look at move text and not insert new move 
**                 if text includes phrase "check alive".
*/

INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */

    C = FMS_Card;				/* Card details */
    BackFeedCheckResult = VARCHAR(3) not null;/* IR_DOWNLOADMOVE table column */
    PT = Varchar(20);			/* Prompt text */
    NewJob = JobInProgress;                       /* NewJob */
    NetworkFeeders = ARRAY OF INTEGEROBJECT;
    SDFeeders = INTEGEROBJECT;
    i = INTEGER;
    x = INTEGER NOT NULL WITH DEFAULT;
    StepCount = integer not null;
    RetCode = Integer not null;
    DccMsg = VARCHAR(500) NOT NULL; 
    DccRegion = VARCHAR(20) NOT NULL;
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
/*
** Get needed FMS Card information
*/
   C.Feeder = 0;
   REPEATED
   SELECT DISTINCT
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.Card = C.Card,
          :C.CutOut = C.CutOut,
          :C.CutIn = C.CutIn,
          :C.TypeOfCard = C.TypeOfCard,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.NetworkFeeder = C.NetworkFeeder
   FROM   FMS_Card C,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card;

   IF C.Feeder = 0 THEN
      CALLPROC TraceError (UserMessage =
                 'Check DBF move is not properly related to an FMS card.',
                           TraceMessage =
                 'PromptCheckDBF: Move is not related properly to an FMS ' +
                 'Card.'
                           );
      RETURN (PU_CANCEL);
   ENDIF;  
/*
** If there is a back feed check result then the move was downloaded to
** an operating order and we will display the result that the SSO returned.
** The DO cannot change the data if the SSO entered it.
*/
   BackFeedCheckResult = '';
   SELECT :BackFeedCheckResult = Status 
   FROM   IR_BackFeed
   WHERE  Job = :JIP.Job;

   IF BackFeedCheckResult <> '' THEN

      FIELD(text1).Curbias = FB_INVISIBLE;
      FIELD(text2).Curbias = FB_VISIBLE;
      FIELD(cancelbutton).CurBias = FB_DIMMED;
      FIELD(DeadOnBackFeed).Curbias  = FB_VISIBLE;

      IF BackFeedCheckResult = 'ABF' THEN
         DeadOnBackFeed = FALSE;
      ELSEIF BackFeedCheckResult = 'DBF' THEN
         DeadOnBackFeed = TRUE;
      ELSE 
         CALLPROC TraceError (UserMessage = 
                 'Could not confirm how Substation Operator ' +
                 'marked the feeder - dead or alive.  Please call and verify ' +
                 'to correct response',
                              TraceMessage =
                 'PromptCheckDBF: Alive/Dead DBF status could not be ' +
                 'resolved on move return. Value=' + BackFeedCheckResult + 
                 ' was returned.'
                              ); 
         IF AutomaticExecution = TRUE THEN
            RETURN PU_CANCEL;
         ELSE
            FIELD(text1).Curbias = FB_VISIBLE;
            FIELD(text2).Curbias = FB_INVISIBLE;
            FIELD(DeadOnBackFeed).Curbias  = FB_CHANGEABLE;
            CurFrame.FLUSH();
         ENDIF;
      ENDIF;
   ENDIF; 
/*
** We must complete processing here if we are in automatic execution
*/
   IF AutomaticExecution = TRUE THEN
      IF BackFeedCheckResult = '' THEN
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                 'PromptCheckDBF: Alive/Dead DBF status could not be ' +
                 'resolved on move return. SSO returned blank value.'
                              ); 
         RETURN PU_CANCEL;
      ELSEIF BackFeedCheckResult = 'DBF' THEN
         DeadOnBackFeed = TRUE;
         Curframe.SendUserEvent (EventName = 'MakeInvisible');
      ELSE
         DeadOnBackFeed = FALSE;
         Curframe.SendUserEvent (EventName = 'MakeInvisible');
      ENDIF;
   ENDIF;
END;


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;


ON Click OKButton,
ON USEREVENT 'CompleteProcessing' =
DECLARE
   FedBy = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   NetworkFeeders.Clear();
   IF C.NetworkFeeder > 0 THEN
      x = 1;
      SELECT :NetworkFeeders[x].Value = CTO.Object
      FROM   TFMS_CardToObject CTO,
             Udb_ExtendedType ET
      WHERE  CTO.Card = :C.Card AND
             CTO.Type = ET.Type AND
             ET.SuperType = :Type$Feeder
      BEGIN
         IF C.NetworkFeeder = NetworkFeeder$33kV THEN
            /*
            **  Include segments fed by this feeder and exclude segments fed by 
            ** another feeder when setting feeder status
            */
            FedBy = 0;    
            SELECT :FedBy = G.Grouping
            FROM   Udb_Grouping G
            WHERE  G.Member = :NetworkFeeders[x].Value AND
                   G.Relationship = :Interaction$FedBy;
            IF FedBy > 0 THEN
               NetworkFeeders.RemoveRow (rownumber = x);
            ELSE
               x = x + 1;
            ENDIF;
         ELSE
            x = x + 1;
         ENDIF;
      END;
   ELSE
      NetworkFeeders[1].Value = C.Feeder;
   ENDIF;
   /*
   ** If card is linked to 4kV StepDown feeder, add other card to list
   ** so status gets updated on both cards.  Only add card if SD-VIS is
   ** closed.
   */
   IF C.TypeOfCard = TypeOfCard$4KV THEN
      
      SDFeeders = NULL;
      SDFeeders = IntegerObject.Create();
      REPEATED
      SELECT DISTINCT
           :SDFeeders.Value = CTO.Object
      FROM  FMS_StepDownLink L,
            Udb_Switch S,
            Udb_Grouping G,
            TFMS_CardToObject CTO,
            FMS_Card C
      WHERE L.StepDownCard = :C.Card AND
            L.Card = C.Card AND
            C.Card = CTO.Card AND
            CTO.Object = G.Grouping AND
            G.Relationship = :Interaction$MemberOf AND
            G.MemberType = :Type$SDVIS AND
            G.Member = S.Object AND
            S.CurrentlyOpen = 0
      BEGIN
         x = 1;
         WHILE x <= NetworkFeeders.LastRow DO
            IF NetworkFeeders[x].Value = SDFeeders.Value THEN
               ENDLOOP;
            ENDIF;
            x = x + 1;
         ENDWHILE;
         IF x > NetworkFeeders.LastRow THEN
            NetworkFeeders[x] = SDFeeders.Duplicate();
         ENDIF;
      END;
          
   ELSE
      SDFeeders = NULL;
      SDFeeders = IntegerObject.Create();
      REPEATED
      SELECT DISTINCT
             :SDFeeders.Value = CTO.Object
      FROM    FMS_StepDownLink L,
              Udb_Switch S,
              Udb_Grouping G,
              TFMS_CardToObject CTO,
              FMS_Card C
      WHERE   L.Card = :C.Card AND
              L.StepDownCard = C.Card AND
              C.Card = CTO.Card AND
              CTO.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = :Type$SDVIS AND
              G.Member = S.Object AND
              S.CurrentlyOpen = 0
      BEGIN
         x = 1;
         WHILE x <= NetworkFeeders.LastRow DO
            IF NetworkFeeders[x].Value = SDFeeders.Value THEN
               ENDLOOP;
            ENDIF;
            x = x + 1;
         ENDWHILE;
         IF x > NetworkFeeders.LastRow THEN
            NetworkFeeders[x] = SDFeeders.Duplicate();
         ENDIF;
      END;      
   ENDIF;  

   IF DeadOnBackFeed = TRUE THEN
      DCCMsg = C.FeederName + ' is Dead on Backfeed.';

      JIP.Response = Squeeze (JIP.Response + ' Dead');
      JIP.ResponseUpd();

      FOR x = 1 TO NetworkFeeders.LastRow() DO     
         CALLPROC ForceStatus (Feeder = NetworkFeeders[x].Value,
                            NewStatus = Status$DBF);
      ENDFOR;
/*
**  Only do if feeder is out of service.
*/
      IF C.CutOut IS NOT NULL and C.CutIn IS NULL THEN
         /*
         **  Clear ABF delay if it exists.  Procedure checks to see
         **  if delay is currently active before trying to update 
         **  endtime.   
         */      
         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    
         SimpleStep.CutOut      = C.CutOut;
         SimpleStep.CutIn       = C.CutIn;
         SimpleStep.SO.Object   = C.Card;
         SimpleStep.SO.Type     = C.Feeder;
         SimpleStep.SO.TypeName = C.FeederName;
         SimpleStep.SO.Name     = C.CardClassName;
         SimpleStep.OpStep      = Delay$ABF;

         SimpleStep.ClearOpStep();
   
         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
               TraceMessage =
                  'Prompt:CheckDBF; ' +
                  'Error clearing ABF Delay. ' +
                  'Card=' + VARCHAR(C.Card) +
                  ';Status=' + VARCHAR(Delay$ABF) + '.'
                  );
         ENDIF; 
         /*
         **  If there are no outstanding moves and no delays, put feeder in 
         **  PENDING delay.
         */
         SimpleStep.ApplyPendingDelay();
   
         IF SimpleStep.ReturnCode <> 0 THEN
           CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
              TraceMessage =
               'Prompt:CheckDBF; ' +
               'Error Applying PENDING Delay. ' +
               'Card=' + VARCHAR(C.Card) +
               ';Status=' + VARCHAR(Type$DODelay) + '.'
               );
         ENDIF; 
         /*
         **  Clear ABF OperatingStep.  Procedure checks to see
         **  if OperatingStep is currently active before trying to update 
         **  endtime.   
         */      
         SimpleStep.OpStep      = Type$ABF; /* ABF Operating Step */

         SimpleStep.ClearABFStep();
   
         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
               TraceMessage =
                  'Prompt:CheckDBF; ' +
                  'Error clearing ABF OperatingStep. ' +
                  'Card=' + VARCHAR(C.Card) +
                  ';Status=' + VARCHAR(Type$ABF) + '.'
                  );
         ENDIF; 
         SimpleStep = NULL;
      ENDIF;
   ELSE

      DCCMsg = C.FeederName + ' is Alive on Backfeed.';
      JIP.Response = Squeeze (JIP.Response + ' Alive');
      JIP.ResponseUpd();

      FOR x = 1 TO NetworkFeeders.LastRow() DO     
         CALLPROC ForceStatus (Feeder = NetworkFeeders[x].Value,
                            NewStatus = Status$ABF);
      ENDFOR;

      IF LOWERCASE(JIP.TOMove) LIKE '%check alive%' THEN
      /* We don't insert new move */
      ELSE
      
      NewJob = JIP.Duplicate();
      NewJob.TOIssued = NULL;
      NewJob.TOComplete = NULL;
      NewJob.TOOperator = NULL;
      NewJob.RSISsued = NULL;
      NewJob.RSComplete = NULL;
      NewJob.RSOperator = NULL;
      NewJob.Response = '';
      NewJob.GroundOn = NULL;
      NewJob.Status = '';

      IF CurrentApplication = Application$SLC THEN
         i = NewJob.InsertMove ( 
                  CardTypeOfCard = Type$SLCCard,
                  KeepMoveText = TRUE);
      ELSE 
         i = NewJob.InsertMove ( 
                  CardTypeOfCard = C.TypeOfCard,
                  KeepMoveText = TRUE);
      ENDIF;

      IF i <= 0 THEN
         CALLPROC TraceError (UserMessage = 
                   'ERROR: Unable to insert new Check DBF move.  ' +
                   'Please insert a Check Dead on BackFeed move manually.  ',
                              TraceMessage =
                   'PromptCheckDBF: Unable to insert new Check DBF move ' +
                   'following Alive Check for card=' + VARCHAR(C.Card) + '.'
                              );
      ENDIF;  
      
      ENDIF;  /* don't insert move on check alive */
/*
**  Only do if feeder is out of service.
*/
      IF C.CutOut IS NOT NULL and C.CutIn IS NULL THEN
         /*
         **  Set ABF delay.  If one exists, the step count will just get incremented.
         **  we will commit after ins/upd to avoid possible deadlocks.
         */
         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    
         SimpleStep.SO.BaseType = C.CardClass;
         SimpleStep.SO.Object   = C.Card;
         SimpleStep.SO.Name     = C.CardClassName;
         SimpleStep.SO.Type     = C.Feeder;
         SimpleStep.SO.TypeName = C.FeederName;
         SimpleStep.OpStep      = Delay$ABF; 
         SimpleStep.StartTime   = C.Cutout;
         SimpleStep.Job         = 0;

         /*
         **  See if this feeder has already been ABF.  If yes, then 
         **  we just want to update the delay endtime to blank again.
         */
         i = 0;
         SELECT :i = COUNT(*)
         FROM    FMS_OperatingStepStatus
         WHERE   Card = :C.Card AND
                 OperatingStep = :Delay$ABF AND
                 StartTime = :C.Cutout AND
                 EndTime <> '';
         IF i <> 0 THEN
            RetCode = CALLPROC FMS_OpStepEndTimeUpd ( 
                             Card = C.Card,
                             OperatingStep = Delay$ABF,
                             StartTime = IFNULL(C.Cutout,''),
                             EndTime = '');
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = '',
                  TraceMessage =
                     'Prompt:CheckDBF; ' +
                     'Error updating endtime of ABF Delay. ' +
                     'Card=' + VARCHAR(C.Card) +
                     ';Status=' + VARCHAR(Delay$ABF) + '.'
                   );
            ENDIF;
            CALLPROC DDB_COMMIT;
         ELSE
            SimpleStep.SetOpStep();
            IF SimpleStep.ReturnCode <> 0 THEN
               CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                  TraceMessage =
                   'Prompt:CheckDBF; ' +
                   'Error setting ABF Delay. ' +
                   'Card=' + VARCHAR(C.Card) +
                   ';Status=' + VARCHAR(Delay$ABF) + '.'
                   );
            ENDIF; 
         ENDIF;
         /*
         **  Set ABF OperatingStep. This will delete all previous
         */
         SimpleStep.OpStep     = Type$ABF; /* ABF Operating Step */

         SimpleStep.SetOpStep();
  
         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
              TraceMessage =
                   'Prompt:CheckDBF; ' +
                   'Error setting ABF OperatingStep. ' +
                   'Card=' + VARCHAR(C.Card) +
                   ';Status=' + VARCHAR(Type$ABF) + '.'
                );
         ENDIF; 
         SimpleStep = NULL;
      ENDIF;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF CurrentApplication = Application$FMS THEN
      FCFrame.SendUserEvent (EventName = 'UpdateDelayButton');
   ENDIF;
   /*
   **  Determine which regions to send message.
   */
   DccRegion = '';
   /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
          :DccRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :C.Feeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                       ,MessageText = DccMsg
                                       ,Time = date('now')
                                       ,Priority = 0
                                       ,MessageType = 0
                                       ,Card = C.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage =
                   'PromptCheckDBF: Automated DCC message ' + 
                   'not sent for ' + C.FeederName + ' regarding: ' + DccMsg);
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;

   RETURN (PU_OK);
END;

ON Click CancelButton =
BEGIN
   RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
				 *Default Item


