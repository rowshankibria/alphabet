**      Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC
**
**  Application:    CAC
**  Class:          SubstationClass
**
**  Date:       Version Description
** ----------------------------------
**  07/19/04  ysp  Created; 
**  03/02/07  ysp  Add LoadEquipment method to load equipment within the substation.
**  01/07/08  ysp  add LoadISWPEquipment
**  07/11/08  ysp  when loading iswp equipment, check if the substation is a
**                 macro substation.
**  09/18/08  ysp  Add option to LoadEquipment to convert equip types to RR types
**  12/09/08  ysp  Add SpecNumber to the details.
**  06/17/10  ysp  add LoadAllLines and LoadCircuitsByLine
**  09/08/11  ysp  modify LoadCircuitsByLine to load circuit routes
**  11/18/11  ysp  add loading of equipment for Dielectric system ISWP
**  06/20/12  pkw  Use Udb_CircuitRoute table if line not in matrix.
**  06/11/13  ysp  Retrieve KV rating for iswp online
**  09/10/18  ysp  Don't use protection matrix to get circuits by lines
**  08/06/18  ysp  Add LoadEquipForRestriction
**  03/25/21  em   Remove Method LoadOS*WPEquipment
*/
METHOD LoadDetails (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the substation access details
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Substation <= 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please specify a substation.';
      RETURN;
   ENDIF;
  
   SELECT :CurObject.SubstationName = O1.Name,
          :CurObject.SubstationDescription = O1.Description,
          :CurObject.Division = O2.Object,
          :CurObject.DivisionName = O2.Name,
          :CurObject.SpecNumber = O1.SpecNumber
   FROM   UDB_Object O1,
          UDB_Object O2,
          UDB_Grouping G
   WHERE  O1.Object = :CurObject.Substation AND
          G.Member = :CurObject.Substation AND
          G.RelationShip = :Interaction$MemberOf AND
          G.GroupingType = :Type$Division AND
          G.Grouping = O2.Object;

   SELECT :CurObject.Address = S.Address,
          :CurObject.City = S.City,
          :CurObject.State = S.State,
          :CurObject.Zip = S.Zip,
          :CurObject.Contact = S.Contact,
          :CurObject.Phone = S.Phone,
          :CurObject.Access = S.Access
   FROM   SOA_Substation S
   WHERE  S.Substation = :CurObject.Substation;

   CALLPROC DDB_ROLLBACK;
   RETURN;
END;

METHOD LoadKVRating(
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the substation kv rating 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Substation <= 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please specify a substation.';
      RETURN;
   ENDIF;
  
   SELECT :CurObject.Rating = R.Normal
   FROM   UDB_Rating R,
          UDB_Grouping G
   WHERE  G.Member = :CurObject.Substation AND
          G.RelationShip = :Interaction$RatedAs AND
          G.Grouping = R.Object;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD UpdateDetails (
)=
DECLARE
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC SOA_SubstationIns(
                             Substation = CurObject.Substation,
                             Address = CurObject.Address,                 
                             City = CurObject.City,                 
                             State = CurObject.State ,                 
                             Zip = CurObject.Zip ,                 
                             Contact = CurObject.Contact ,                 
                             Phone = CurObject.Phone ,                 
                             Access = CurObject.Access);                
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Failed to save the substation details in the database.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN;
END;

METHOD UpdateMapNumber(
   MapNumber = VARCHAR(40) NOT NULL WITH DEFAULT
)=
DECLARE
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC UDB_SpecNumberUpd(
                  Object = CurObject.Substation,
                  SpecNumber = MapNumber);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Unable to update the substation map number. ' +
                               'Please report to the technical support.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

METHOD LoadEquipment(
   Exclusion = INTEGER NOT NULL WITH DEFAULT;
   WithRRTypes = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   PrevType = INTEGER NOT NULL WITH DEFAULT;
   PrevName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeMapping = TypeClass_ASE;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.Application = Application$SLC THEN
      IF Exclusion = TRUE THEN
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 Udb_ExtendedType E,
                 SOA_TypeExclusion X
         WHERE   G.Grouping = :CurObject.Substation AND
                 G.Relationship = :Interaction$MemberOf AND
                 O.Object = G.Member AND
                 (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                 E.SuperType = :Type$Conducting AND
                 E.Type NOT IN (SELECT Type
                                    FROM Udb_ExtendedType
                                    WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
                 G.MemberType = E.Type AND
                 O.Type = X.Type AND
                 X.Exclusion = 0
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
      ELSE
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 Udb_ExtendedType E
         WHERE   G.Grouping = :CurObject.Substation AND
                 G.Relationship = :Interaction$MemberOf AND
                 O.Object = G.Member AND
                 E.SuperType = :Type$Conducting AND
                 E.Type NOT IN (SELECT Type
                                    FROM Udb_ExtendedType
                                    WHERE SuperType IN (:Type$Line, :Type$Feeder)) AND 
                 G.MemberType = E.Type
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;  
      ENDIF;  
   ELSEIF CurObject.Application = Application$TLS THEN
      i = 1;
      REPEATED
      SELECT DISTINCT
                :CurObject.EList[i].Equip  = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClass = O.Type,
                :CurObject.EList[i].EquipClassName = O.TypeName,
                :CurObject.EList[i].ObjectDescription = O.Description
      FROM    Udb_Object O,                      /* circuit */
              Udb_Grouping G                     /* circuit grouped to station */
      WHERE   O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :Type$TelCircuit) AND
              O.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment) AND
              O.Object = G.Member AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType IN ( SELECT  Type
                                    FROM    Udb_ExtendedType
                                    WHERE   Supertype = :Type$Substation) AND
              G.Grouping = :CurObject.Substation
      ORDER BY EquipClassName, EquipName     
      BEGIN
         i = i + 1;
      END;  
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.EList.LastRow = 0 THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'No equipment found in the substation.';
   ENDIF;

   IF WithRRTypes = TRUE THEN
      /*
      ** Translate the fms equip type names to RR type names. Because equip list is sorted
      ** by EquipClassName, we really don't have to look up the RR types for every piece of
      ** equipment.
      */
      TypeMapping.GetEquipTypeMapping();
      IF TypeMapping.CList.LastRow = 0 THEN
         RETURN;
      ENDIF;

      PrevType = 0;
      PrevName = '';
      FOR i = 1 TO CurObject.EList.LastRow DO
         IF PrevType <> CurObject.EList[i].EquipClass THEN

            RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                               Value = CurObject.EList[i].EquipClass,
                                               RowNumber = ByRef(m));
            IF RetCode = ER_OK THEN
               CurObject.EList[i].EquipClassName = TypeMapping.CList[m].Description;
            ENDIF;
            PrevType = CurObject.EList[i].EquipClass;
            PrevName = CurObject.EList[i].EquipClassName;
         ELSE
            CurObject.EList[i].EquipClassName = PrevName;
         ENDIF;
      ENDFOR;
   ENDIF;

   RETURN;
END;

METHOD LoadAssoLines(
   Exclusion = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.EList.Clear();

      i = 1;
      REPEATED
      SELECT  :CurObject.EList[i].Equip = O.Object, 
              :CurObject.EList[i].EquipName = O.Name,
              :CurObject.EList[i].EquipClass  = O.Type,
              :CurObject.EList[i].EquipClassName  = O.TypeName,
              :CurObject.EList[i].ObjectDescription = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.Equip AND
              G.Relationship = :Interaction$MemberOf AND
              G.Grouping = O.Object AND
              G.GroupingType  IN (:Type$Line, :Type$Feeder)
      ORDER BY EquipClassName, EquipName     
      BEGIN
         i = i + 1;
      END;  

   RETURN;
END;

METHOD LoadISWPEquipment(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   PrevType = INTEGER NOT NULL WITH DEFAULT;
   PrevName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeMapping = TypeClass_ASE;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   /*
   ** check if this is a macro substation
   */
   m = 0;
   SELECT :m = 1 
   FROM   UDB_Object
   WHERE  Object = :CurObject.Substation AND
          Type = :Type$MacroSubstation;

   IF CurObject.Application = Application$SLC THEN
      IF m = 0 THEN
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 Udb_ExtendedType E,
                 SOA_ISWPEquipType W
         WHERE   G.Grouping = :CurObject.Substation AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                 E.SuperType = :Type$Conducting AND
                 G.MemberType = E.Type AND
                 O.Type = W.Type 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
      ELSE
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G1,
                 Udb_Grouping G2,
                 Udb_ExtendedType E,
                 SOA_ISWPEquipType W
         WHERE   G1.Grouping = :CurObject.Substation AND
                 G1.Relationship = :Interaction$MemberOf AND
                 G1.MemberType = :Type$Substation AND
                 G1.Member = G2.Grouping AND
                 G2.Relationship = :Interaction$MemberOf AND
                 G2.Member = O.Object AND
                 (O.Outservice IS NULL OR O.Outservice = '') AND			/* Exclude dropped equip */
                 E.SuperType = :Type$Conducting AND
                 G2.MemberType = E.Type AND
                 O.Type = W.Type 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ELSEIF CurObject.Application = Application$TLS THEN
      IF m = 0 THEN
         i = 1;
         REPEATED
         SELECT DISTINCT
                :CurObject.EList[i].Equip  = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClass = O.Type,
                :CurObject.EList[i].EquipClassName = O.TypeName,
                :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,                      /* circuit */
                 Udb_Grouping G                     /* circuit grouped to station */
         WHERE   G.Grouping = :CurObject.Substation AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND 
                 O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :Type$TelCircuit) AND
                 O.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)                 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;  
      ELSE
         i = 1;
         REPEATED
         SELECT DISTINCT
                :CurObject.EList[i].Equip  = O.Object,
                :CurObject.EList[i].EquipName = O.Name,
                :CurObject.EList[i].EquipClass = O.Type,
                :CurObject.EList[i].EquipClassName = O.TypeName,
                :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,                      /* circuit */
                 Udb_Grouping G1,                     /* circuit grouped to station */
                 Udb_Grouping G2                     /* circuit grouped to station */
         WHERE   G1.Grouping = :CurObject.Substation AND
                 G1.Relationship = :Interaction$MemberOf AND
                 G1.MemberType = :Type$Substation AND
                 G1.Member = G2.Grouping AND
                 G2.Relationship = :Interaction$MemberOf AND
                 G2.Member = O.Object AND
                 O.Type IN ( SELECT  Type
                            FROM    Udb_ExtendedType
                            WHERE   SuperType = :Type$TelCircuit) AND
                 O.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)                 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;  
      ENDIF;
   ELSEIF CurObject.Application = Application$DSO THEN
      IF m = 0 THEN
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G
         WHERE   G.Grouping = :CurObject.Substation AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type = 22079                // STA-PH
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
      ELSE
         i = 1;
         REPEATED
         SELECT  :CurObject.EList[i].Equip = O.Object, 
                 :CurObject.EList[i].EquipName = O.Name,
                 :CurObject.EList[i].EquipClass  = O.Type,
                 :CurObject.EList[i].EquipClassName  = O.TypeName,
                 :CurObject.EList[i].ObjectDescription = O.Description
         FROM    Udb_Object O,
                 Udb_Grouping G1,
                 Udb_Grouping G2
         WHERE   G1.Grouping = :CurObject.Substation AND
                 G1.Relationship = :Interaction$MemberOf AND
                 G1.MemberType = :Type$Substation AND
                 G1.Member = G2.Grouping AND
                 G2.Relationship = :Interaction$MemberOf AND
                 G2.Member = O.Object AND
                 O.Type = 22079                // STA-PH
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.EList.LastRow = 0 THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'No equipment found in the substation.';
      RETURN;
   ENDIF;

/*
** Translate the fms equip type names to RR type names. Because equip list is sorted
** by EquipClassName, we really don't have to look up the RR types for every piece of
** equipment.
*/
   TypeMapping.GetEquipTypeMapping();
   IF TypeMapping.CList.LastRow = 0 THEN
      RETURN;
   ENDIF;

   PrevType = 0;
   PrevName = '';
   FOR i = 1 TO CurObject.EList.LastRow DO
      IF PrevType <> CurObject.EList[i].EquipClass THEN

         RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                            Value = CurObject.EList[i].EquipClass,
                                            RowNumber = ByRef(m));
         IF RetCode = ER_OK THEN
            CurObject.EList[i].EquipClassName = TypeMapping.CList[m].Description;
         ENDIF;
         PrevType = CurObject.EList[i].EquipClass;
         PrevName = CurObject.EList[i].EquipClassName;
      ELSE
         CurObject.EList[i].EquipClassName = PrevName;
      ENDIF;
   ENDFOR;

   RETURN;
END;


METHOD LoadAllLines(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
    
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.EList[i].Equip = O.Object, 
          :CurObject.EList[i].EquipName = O.Name,
          :CurObject.EList[i].EquipClass = O.Type,
          :CurObject.EList[i].EquipClassName = O.TypeName,
          :CurObject.EList[i].ObjectDescription = O.Description
   FROM   UDB_Grouping G1,
          Udb_Grouping G2,
          Udb_Object O
   WHERE  G1.Grouping = :CurObject.Substation AND
          G1.RelationShip = :Interaction$MemberOf AND
          G1.MemberType = :Type$ACLineSegment AND
          G1.Member = G2.Member AND
          G2.RelationShip = :Interaction$MemberOf AND
          G2.GroupingType = :Type$Line AND
          G2.Grouping = O.Object
   ORDER BY 2
   BEGIN
      CurObject.EList[i].EquipTemplateName = 'FDR';
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadCircuitsByLine(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   MatrixGrouping = ARRAY OF INTEGEROBJECT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.EList.Clear();

/*
** load protection circuits and routes for a transmission feeder.
** (save Route name in the Relay attribute)
**
   
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.EList[i].Equip = O.Object, 
          :CurObject.EList[i].EquipName = O.Name,
          :CurObject.EList[i].ObjectDescription = O.Description,
          :CurObject.EList[i].Relay = T.Name
   FROM   CAC_Relay_Feeder F,
          CAC_Relay_Circuit C,
          Udb_Grouping G2,
          Udb_Object O,
          Udb_Type T
   WHERE  F.Feeder = :CurObject.Equip AND
          F.Grouping = C.Grouping AND
          C.Circuit = O.Object AND
          C.Route = T.Type AND
          C.Circuit = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND 
          G2.Grouping = :CurObject.Substation 
   ORDER BY 2
   BEGIN
      i = i + 1;
   END;
*/
   IF CurObject.EList.LastRow = 0 THEN
      /*
      ** Feeders on current card don't have a matrix.  
      ** See if the feeder has Protection Circuits grouped with it.
      */
      i = 1;
      SELECT DISTINCT
          :CurObject.EList[i].Equip = O.Object, 
          :CurObject.EList[i].EquipName = O.Name,
          :CurObject.EList[i].ObjectDescription = O.Description,
          :CurObject.EList[i].Relay = T.Name
      FROM  Udb_Grouping G1,
            Udb_CircuitRoute C,
            Udb_Grouping G2,
            Udb_Object O,
            Udb_Type T  
      WHERE G1.Grouping = :CurObject.Equip AND
            G1.Relationship = :Interaction$MemberOf AND
            G1.Member = C.Object AND
            C.Object = O.Object AND
            C.Route = T.Type AND
            C.Object = G2.Member AND
            G2.Relationship = :Interaction$MemberOf AND 
            G2.Grouping = :CurObject.Substation 
      ORDER BY 2
      BEGIN
         i = i + 1;
      END;
   ENDIF;
/*    
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.EList[i].Equip = O.Object, 
          :CurObject.EList[i].EquipName = O.Name,
          :CurObject.EList[i].ObjectDescription = O.Description
   FROM   Udb_Grouping G1,
          Udb_Grouping G2,
          Udb_Object O
   WHERE  G1.Grouping = :CurObject.Equip AND
          G1.Relationship = :Interaction$MemberOf AND 
          G1.MemberType IN (SELECT  Type
                           FROM    Udb_ExtendedType
                           WHERE   SuperType = :Type$TelCircuit) AND
          G1.Member = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND 
          G2.Grouping = :CurObject.Substation AND 
          G2.Member = O.Object
   ORDER BY 2
   BEGIN
      i = i + 1;
   END;
*/
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadEquipForRestriction(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.EList.Clear();
   
   // first of all, get all the lines in the substation
   CurObject.LoadAllLines();
 
   // then, get the capbanks and transformers 
   i = CurObject.EList.LastRow + 1;
   
   REPEATED
   SELECT :CurObject.EList[i].Equip = O.Object, 
          :CurObject.EList[i].EquipName = O.Name,
          :CurObject.EList[i].EquipClass = O.Type,
          :CurObject.EList[i].EquipClassName = O.TypeName,
          :CurObject.EList[i].ObjectDescription = O.Description
   FROM   UDB_Grouping G1,
		  UDB_ExtendedType ET,
          Udb_Object O
   WHERE  G1.Grouping = :CurObject.Substation AND
          G1.RelationShip = :Interaction$MemberOf AND
          G1.Member = O.Object AND
          G1.MemberType = ET.Type AND
          ET.SuperType IN (:Type$Capacitor, :Type$PowerTransformer)
   ORDER BY 3, 2
   BEGIN
      IF CurObject.EList[i].EquipClass = Type$Capacitor THEN
         CurObject.EList[i].EquipTemplateName = 'CAP';
      ELSE
         CurObject.EList[i].EquipTemplateName = 'TRF';
      ENDIF;
      
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

