	Name:            PromptRelayTargetsFromSSO

/**
 **
 **  Copyright c 1996 Unified Information, Inc.  All rights reserved.
 **
 **  Unified Information, Inc. proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Unified Information, Inc.
 **
 **
 **  Application:    CAC
 **  Frame:          PromptRelayTargetFromSSO
 **
 **  Modification log:
 **
 **  Date:     Version   Description 
 ** --------------------------------------------------        
 **  08/18/05  em    Created
 **  08/31/05  em    Corrected Display.
 **  05/02/09  pkw   Added Bus Section Relay Targets section.
 **  05/11/09  pkw   Change ftfeederlist to ftfeeder to match class.
 **  07/10/12  ysp   Replace internal field names for Backup Timer with FBMPRxxx.
 **  12/17/15  ysp   Add substation name to the title of the top table.
 **  05/13/16  pkw   If TFMS and no targets returned call RelaySummary instead 
 **                  of dis_relaysummary
 **  10/04/16  ysp   Rename RelaySummary to TFMS_RelaySummary and dis_RelaySummary to SLC_RelaySummary
 **/

INITIALIZE
(
    JIP = JobInProgress;			/* Job being processed */
    
    SimpleSLCCard = CardSLC_ASE DEFAULT NULL;
    Relays = SSO_Relays_ASE DEFAULT NULL;
    BSRelays = BusFaultOutageClass DEFAULT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;    /* Return Code */
) =
DECLARE
   Validate_BusSectionRelays = PROCEDURE RETURNING INTEGER NOT NULL;
ENDDECLARE
BEGIN
   FIELD(Title).TextValue = 'Relay Targets Returned Electronically from the SSO at ' + JIP.SubstationName;
/*
** Get the return Relays, if there are none we return immediately.
*/
   Relays = SSO_Relays_ASE.Create();
   Relays.Job = JIP.Job;
   RetCode = Relays.GetSSORelaysbyJob();

   RT.Clear();
   RT = Relays.RT.Duplicate();
   IF RetCode = 0 THEN
      IF CurrentApplication = Application$TFMS THEN
         CALLFRAME TFMS_RelaySummary(Card = JIP.Card,
                                DefaultStation = JIP.Substation);
      ELSE
         SimpleSLCCard = CardSLC_ASE.Create();
         SimpleSLCCard.Card = JIP.Card;    
         SimpleSLCCard.LoadCard();

         CALLFRAME SLC_RelaySummary(
                 C = SimpleSLCCard.C.Duplicate(),
                 SwitchingItem = JIP.SwitchingItem,
                 InsertRelay = TRUE);
      ENDIF;
      RETURN(PU_OK);
   ENDIF;
/*
**  See if we should show Bus Section relay targets
*/
   BSRelays = BusFaultOutageClass.Create();
   RetCode = BSRelays.LoadRelays(SwitchingItem = JIP.SwitchingItem);
   IF RetCode <> 0 THEN
      BS = BSRelays.Duplicate();
      FIELD(BS.FTFeeder).ValueList = BSRelays.FTList.Duplicate();
      FIELD(BS.FTFeeder).CurEnumValue = BSRelays.FTFeeder;
   ELSE
      FIELD(BS).ParentField.ParentField.CurBias = FB_INVISIBLE;
   ENDIF;
END;

ON SetValue bs.BDPhaseA,
ON SetValue bs.BDPhaseB,
ON SetValue bs.BDPhaseC,
ON SetValue bs.BDRelayName =
BEGIN
   bs.BDLastUpd = date('now');
   bs.BDLastUpdBy = Dop.Description;
   bs.BDHasDataChanged = TRUE;
END;

ON SetValue bs.BOCPhaseA,
ON SetValue bs.BOCPhaseB,
ON SetValue bs.BOCPhaseC,
ON SetValue bs.BOCPhaseN,
ON SetValue bs.BOCRelayName =
BEGIN
   bs.BOCLastUpd = date('now');
   bs.BOCLastUpdBy = Dop.Description;
   bs.BOCHasDataChanged = TRUE;
END;

/* This block is replaced by bs.FBMPR event block.
ON SetValue bs.BUTOperated,
ON SetValue bs.BUTRelayName =
BEGIN
   bs.BUTLastUpd = date('now');
   bs.BUTLastUpdBy = Dop.Description;
   bs.BUTHasDataChanged = TRUE;
END;
*/
ON SetValue bs.FBMPR,
ON SetValue bs.FBMPRValue =
BEGIN
   bs.FBMPRTime = date('now');
   bs.FBMPRUpdBy = Dop.Description;
   bs.FBMPRHasDataChanged = TRUE;
END;

ON SetValue bs.FTPhaseA,
ON SetValue bs.FTPhaseB,
ON SetValue bs.FTPhaseC,
ON SetValue bs.FTPhaseN,
ON SetValue bs.FTRelayName,
ON SetValue bs.FTFeeder =
BEGIN
   bs.FTLastUpd = date('now');
   bs.FTLastUpdBy = Dop.Description;
   bs.FTHasDataChanged = TRUE;
END;

 
ON CLICK OK_btn =
BEGIN   
   RetCode = CALLPROC Validate_BusSectionRelays();
   IF RetCode <> 0 THEN
      RESUME;
   ENDIF;
/*
**  Update Bus Section Relay Targets
*/
   IF bs.BDHasDataChanged = TRUE THEN
      IF bs.BDLastUpd = '' THEN
         bs.BDLastUpd = date('now');
         bs.BDLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBusDiffUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BDPhaseA = bs.BDPhaseA,
                       BDPhaseB = bs.BDPhaseB,
                       BDPhaseC = bs.BDPhaseC,
                       BDRelayName = bs.BDRelayName,
                       BDLastUpd = bs.BDLastUpd,
                       BDLastUpdBy = bs.BDLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Bus Differential information.',
                  TraceMessage =
            'PromptRelayTargetsFromSSO frame: ' +
            'Unable to update Bus Differential information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   IF bs.BOCHasDataChanged = TRUE THEN
      IF bs.BOCLastUpd = '' THEN
         bs.BOCLastUpd = date('now');
         bs.BOCLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBusOCUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BOCPhaseA = bs.BOCPhaseA,
                       BOCPhaseB = bs.BOCPhaseB,
                       BOCPhaseC = bs.BOCPhaseC,
                       BOCPhaseN = bs.BOCPhaseN,
                       BOCRelayName = bs.BOCRelayName,
                       BOCLastUpd = bs.BOCLastUpd,
                       BOCLastUpdBy = bs.BOCLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Bus Over Current information.',
                  TraceMessage =
            'PromptRelayTargetsFromSSO frame: ' +
            'Unable to update Bus Over Current information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;    
   ENDIF;
   
   IF bs.FBMPRHasDataChanged  = TRUE THEN
      /*
      IF bs.BUTLastUpd = '' THEN
         bs.BUTLastUpd = date('now');
         bs.BUTLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBackupTimerUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BUTOperated = bs.BUTOperated,
                       BUTRelayName = bs.BUTRelayName,
                       BUTLastUpd = bs.BUTLastUpd,
                       BUTLastUpdBy = bs.BUTLastUpdBy
                       );
      */
      IF bs.FBMPRTime = '' THEN
         bs.FBMPRTime = date('now');
         bs.FBMPRUpdBy = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFFBMPRUpd(
                       SwitchingItem = bs.SwitchingItem,
                       FBMPR = bs.FBMPR,
                       FBMPRValue = bs.FBMPRValue,
                       FBMPRTime = bs.FBMPRTime,
                       FBMPRUpdBy = bs.FBMPRUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Backup Timer information.',
                  TraceMessage =
            'PromptRelayTargetsFromSSO frame: ' +
            'Unable to update Backup Timer information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;   
   ENDIF;
   
   IF bs.FTHasDataChanged = TRUE THEN
      IF bs.FTLastUpd = '' THEN
         bs.FTLastUpd = date('now');
         bs.FTLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFFeederTargetUpd(
                       SwitchingItem = bs.SwitchingItem,
                       FTFeeder = bs.FTFeeder,
                       FTPhaseA = bs.FTPhaseA,
                       FTPhaseB = bs.FTPhaseB,
                       FTPhaseC = bs.FTPhaseC,
                       FTPhaseN = bs.FTPhaseN,
                       FTRelayName = bs.FTRelayName,
                       FTLastUpd = bs.FTLastUpd,
                       FTLastUpdBy = bs.FTLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Feeder Target information.',
                  TraceMessage =
            'PromptRelayTargetsFromSSO frame: ' +
            'Unable to update Feeder Target information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   RETURN(PU_OK);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;


PROCEDURE Validate_BusSectionRelays(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ContinueCheck = INTEGER NOT NULL WITH DEFAULT;
   FCRPermit = INTEGER NOT NULL WITH DEFAULT;
   p = INTEGER NOT NULL WITH DEFAULT;
   WG = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF bs.BDHasDataChanged = TRUE THEN
      IF bs.BDRelayName <> '' AND
        (bs.BDPhaseA = 0 AND
         bs.BDPhaseB = 0 AND
         bs.BDPhaseC = 0) THEN
         MESSAGE 'Bus Differential Relay Name ''' + bs.BDRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.BOCHasDataChanged = TRUE THEN
      IF bs.BOCRelayName <> '' AND
        (bs.BOCPhaseA = 0 AND
         bs.BOCPhaseB = 0 AND
         bs.BOCPhaseC = 0 AND
         bs.BOCPhaseN = 0) THEN
         MESSAGE 'Bus Over Current Relay Name ''' + bs.BOCRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FBMPRHasDataChanged = TRUE THEN
      /*
      IF bs.BUTRelayName <> '' AND
         bs.BUTOperated = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.BUTRelayName + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
      */
      IF bs.FBMPRValue <> '' AND
         bs.FBMPR = 0 THEN
         MESSAGE 'Backup Timer Relay Name ''' + bs.FBMPRValue + 
                 ''' was entered but the relay had not Operated.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
   ENDIF;
   
   IF bs.FTHasDataChanged = TRUE THEN
      IF bs.FTRelayName <> '' AND
        (bs.FTPhaseA = 0 AND
         bs.FTPhaseB = 0 AND
         bs.FTPhaseC = 0 AND
         bs.FTPhaseN = 0 AND
         bs.FTFeeder = 0) THEN
         MESSAGE 'Feeder Target Relay Name ''' + bs.FTRelayName + 
                 ''' was entered and no Relay targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);
      ENDIF;
       
      IF (bs.FTPhaseA = 0 AND
          bs.FTPhaseB = 0 AND
          bs.FTPhaseC = 0 AND
          bs.FTPhaseN = 0) AND
          bs.FTFeeder <> 0 THEN

         MESSAGE 'A Feeder was chosen but no Feeder Relay Targets were selected.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

      IF (bs.FTPhaseA <> 0 OR
          bs.FTPhaseB <> 0 OR
          bs.FTPhaseC <> 0 OR
          bs.FTPhaseN <> 0) AND
          bs.FTFeeder = 0 THEN

         MESSAGE 'Feeder Relay Targets were selected but no Feeder was chosen.  ' +
                 'Please correct before saving data.';
         RETURN(-1);      
      ENDIF;

   ENDIF;
   RETURN(0);
END;
