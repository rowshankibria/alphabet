      END;


CurMethod.Trace(Text = 'i = ' + varchar(i) + ' after select 2 ' + varchar(date('now')));
  
      SELECT DISTINCT   // DISTINCT filters out common jobs on other cards.
            :CurObject.SSO[i].Application = 'TOMS',
            :CurObject.SSO[i].IssueTime = OO.IssueTime,
            :CurObject.SSO[i].OrderType = OO.OrderType,
