                                Object = :ATS101.Object, 
                                IssuedOperator = :IssuedOperator,
                                PendingStatus = :Status$Open,
                                increment = 1);
   ENDIF; 

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
   ELSE
      CALLPROC DDB_COMMIT;
      RETURN (PU_OK);
   ENDIF;
END;

