Application Component Report
============================

	Name:            ClearObjectStatus

/*
**
**      Copyright c 1999 Alstom ESCA Corporation.  All rights reserved.
**
**      Alstom ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Alstom ESCA Corporation.
**
*/
/*
**  Application:    CAC
**  Frame:          ClearObjectStatus
**
**  Date:    Author Description
** ----------------------------------
**  05/03/99	EM  Created
**  05/11/99   em  Clear pending statuses also.
**  04/17/00   em  If a TFMS card, clear line statuses also.
**  03/24/05   em  If a SDS card, clear valve statuses also.
**  11/18/10   em  Fix bug that deletes equip status when closing sw item
**                 after equip transferred to another active sw item
**  12/21/16  ysp  Extend to the FMS application. Moved to CAC.
**
*/
PROCEDURE ClearObjectStatus
(
   Card         = INTEGER NOT NULL;  /*Passed Card*/
   SwitchingItem	= INTEGER NOT NULL WITH DEFAULT; /*Passed Sw Item*/
) =
DECLARE
   FoundCommon  = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   i = INTEGER NOT NULL;  /*Counter*/
   LastRow = INTEGER NOT NULL;  /*Counter*/
   ObjectList = ARRAY OF ObjectStatus;  /*Device Statuses to delete*/
   RetCode = INTEGER NOT NULL;  /*Return Code*/
ENDDECLARE
BEGIN
/*
** Targeted for Equipment statuses related to TFMS and SLC,  will need to add 
** Feeder status when merging FMS.  Do not delete Equipment Grounds or 
** equipment statuses that appear on equipment that remains on another 
** active card or switching item.
*/
   i = 1;
   ObjectList.Clear();
   REPEATED
   SELECT 
   DISTINCT :ObjectList[i].Object = OS.Object,
            :ObjectList[i].Status = OS.Status
   FROM     FMS_ObjectStatus OS,
            SOA_JobControl JC,
            SOA_Job J
   WHERE    JC.Card = :Card AND            
            JC.SwitchingItem = :SwitchingItem AND
            JC.Job = J.Job AND
            J.Equip = OS.Object AND
            J.ControlCard = :Card AND
            OS.Status <> :Status$Ground
   BEGIN
      i = i + 1;
   END;

   LastRow = ObjectList.LastRow();
   FOR i = 1 TO LastRow DO  
      FoundCommon = FALSE;
      
      SELECT  :FoundCommon = :TRUE
      FROM    SOA_JobControl JC,
              SOA_Job J,
              SOA_ActiveCard AC
      WHERE   J.Equip = :ObjectList[i].Object AND
              J.Job = JC.Job AND               
             (JC.Card <> :Card OR 
              (JC.Card = :Card AND JC.SwitchingItem <> :SwitchingItem)) AND
              JC.Card = AC.Card AND
              ((J.SwItemStatus >= :Card$Active AND 
                J.SwItemStatus < :Card$Closed) OR
               (AC.Application <> :Application$SLC));
      
      IF FoundCommon = FALSE THEN  /*Go ahead delete*/
         RetCode = CALLPROC FMS_ObjStatDel (
                    Object = ObjectList[i].Object,
                    Terminal = 0,
                    Status = ObjectList[i].Status);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Warning: Unable to clear all equip statuses set by card.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF; 
      ENDIF;   
   ENDFOR;
/*
** Now do Pending Statuses.  Hide the IssuedOperator in the Terminal field.
*/
   i = 1;
   ObjectList.Clear();
   REPEATED
   SELECT 
   DISTINCT :ObjectList[i].Object = PS.Object,
            :ObjectList[i].Status = PS.PendingStatus,
            :ObjectList[i].Terminal = PS.IssuedOperator
   FROM     FMS_PendingStatus PS,
            SOA_JobControl JC,
            SOA_Job J
   WHERE    JC.Card = :Card AND            
            JC.SwitchingItem = :SwitchingItem AND
            JC.Job = J.Job AND
            J.Equip = PS.Object AND
            J.ControlCard = :Card AND
            PS.PendingStatus <> :Status$Ground
   BEGIN
      i = i + 1;
   END;

   LastRow = ObjectList.LastRow();
   FOR i = 1 TO LastRow DO
       FoundCommon = FALSE;

       SELECT :FoundCommon = :TRUE
       FROM   SOA_JobControl JC,
              SOA_Job J,
              SOA_ActiveCard AC
       WHERE  J.Equip = :ObjectList[i].Object AND
              J.Job = JC.Job AND               
             (JC.Card <> :Card OR 
              (JC.Card = :Card AND JC.SwitchingItem <> :SwitchingItem)) AND
              JC.Card = AC.Card AND
              ((J.SwItemStatus >= :Card$Active AND 
                J.SwItemStatus < :Card$Closed) OR
               (AC.Application <> :Application$SLC));

      IF FoundCommon = FALSE THEN  /*Go ahead delete*/
         RetCode = CALLPROC FMS_PendingStatDel (
                    Object = ObjectList[i].Object,
                    IssuedOperator = ObjectList[i].Terminal,
                    PendingStatus = ObjectList[i].Status);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Warning: Unable to clear all pending statuses set by card.';
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF; 
      ENDIF;   
   ENDFOR;

   IF CurrentApplication = Application$FMS OR
      CurrentApplication = Application$TFMS OR 
      CurrentApplication = Application$SDS THEN

      i = 1;
      ObjectList.Clear();
      REPEATED
      SELECT
      DISTINCT :ObjectList[i].Object = OS.Object,
               :ObjectList[i].Status = OS.Status
      FROM     FMS_ObjectStatus OS,
               SOA_ActiveObject AO
      WHERE    AO.Card = :Card AND
               AO.ObjectToCardLink = 1 AND
               AO.Object = OS.Object
      BEGIN
         i = i + 1;
      END;

      FOR i = 1 TO ObjectList.LastRow() DO
          RetCode = CALLPROC FMS_ObjStatDel (
                     Object = ObjectList[i].Object,
                     Terminal = 0,
                     Status = ObjectList[i].Status);

          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Warning: Unable to clear line/valve statuses set by card.';
          ELSE
             CALLPROC DDB_COMMIT;
          ENDIF;
      ENDFOR; 

      i = 1;
      ObjectList.Clear();
      REPEATED
      SELECT 
      DISTINCT :ObjectList[i].Object = PS.Object,
               :ObjectList[i].Status = PS.PendingStatus,
               :ObjectList[i].Terminal = PS.IssuedOperator
      FROM     FMS_PendingStatus PS,
               SOA_ActiveObject AO
      WHERE    AO.Card = :Card AND
               AO.ObjectToCardLink = 1 AND
               AO.Object = PS.Object
      BEGIN
         i = i + 1;
      END;

      FOR i = 1 TO ObjectList.LastRow() DO
          RetCode = CALLPROC FMS_PendingStatDel (
                     Object = ObjectList[i].Object,
                     IssuedOperator = ObjectList[i].Terminal,
                     PendingStatus = ObjectList[i].Status);
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Warning: Unable to clear line/valve pending statuses set by card.';
          ELSE
             CALLPROC DDB_COMMIT;
          ENDIF;
      ENDFOR; 
   ENDIF;      
END;





Application Component Report
============================

	Name:            ClearSLCCautions

/* 
**      Copyright c 2004 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software. 
** 
**  Application:    CAC 
**  4GL Procedure:  ClearSLCCautions 
** 
**  Modification log: 
** 
**  Date:  	Version		Description 
** -------------------------------------------------- 
** 01/22/04     ysp     creation
** 02/16/04     em      converted message to TraceError call
** 08/15/19     ysp     Add 'Xfr' status and RSComplete = '' to the outstanding caution moves query because
**                      these moves in shadow items have "Xfr" status and blanked-out restore side when 
**                      they were transferred to new items as a result of TFMS card transfer.
*/ 
PROCEDURE ClearSLCCautions
(
    SwitchingItem = INTEGER NOT NULL; /* passed in */
    Card          = INTEGER NOT NULL;
    i             = INTEGER NOT NULL WITH DEFAULT;
    j             = INTEGER NOT NULL WITH DEFAULT;
    StatusObjects   = ARRAY OF INTEGEROBJECT;
    StatusCounts    = ARRAY OF INTEGEROBJECT;
    OutStandingJobs = ARRAY OF INTEGEROBJECT;
    Substations     = ARRAY OF INTEGEROBJECT;
    ReturnStatus    = INTEGER NOT NULL WITH DEFAULT;
    RetCode         = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   ReturnStatus = PU_OK;
/*
** Get the Substations' Caution counts
*/
   i = 1;
   SELECT DISTINCT
          :StatusCounts[i].Value = OS.StatusCount,
          :StatusObjects[i].Value = OS.Object
   FROM   SOA_Job J,
          SOA_JobControl JC,
          SOA_ActiveObject AO,
          FMS_ObjectStatus OS
   WHERE  J.Job = :SwitchingItem AND
          J.SWItemStatus = :Card$Active AND
          JC.Job = :SwitchingItem AND
          JC.SwitchingItem = :SwitchingItem AND
          JC.Card = AO.Card AND
          AO.ObjectToCardLink = 1 AND
          AO.Object = OS.Object AND
          OS.Status = :Status$Caution
   BEGIN
      i = i + 1
   END;
   CALLPROC DDB_ROLLBACK;

   IF i = 1 THEN
      RETURN PU_OK;
   ENDIF;
/*
** See if there are outstanding caution moves within the (shadow) 
** switching Item.
*/
   i = 1;
   REPEATED
   SELECT DISTINCT
         :OutStandingJobs[i].Value = J.Job,
         :Substations[i].Value = J.Substation
   FROM  SOA_Job J,
         SOA_JobControl JC,
         FMS_JobAction JA
   WHERE JC.SwitchingItem = :SwitchingItem AND
         JC.Job = J.Job AND
         J.TOComplete IS NOT NULL AND
         (J.RSComplete IS NULL OR J.RSComplete = '') AND
         J.Status IN ('', 'Xfr') AND
         J.MoveCategory = :MoveCategory$Normal AND
         J.JobClass = JA.JobClass AND
         JA.TypeOfCard = :Type$SLCApp AND
         JA.Status = :Status$Caution AND
         JA.EquipClass = JC.MoveEquipClass
   BEGIN
      i = i + 1;
   END; 
/*
** Because we are closing this item, we are going to decrease the 
** caution counts for the substations.
*/
   FOR i = 1 TO Substations.LastRow() DO
      j = 1;
      WHILE j <= StatusObjects.LastRow() DO
         IF StatusObjects[j].Value = Substations[i].Value THEN
            ENDLOOP;
         ENDIF;
         j = j + 1;
      ENDWHILE;
      
      IF j > StatusObjects.LastRow() THEN
         CONTINUE;
      ENDIF;

      IF StatusCounts[j].Value = 1 THEN  /* Decrementing will remove status*/
         RetCode = CALLPROC FMS_ObjStatDel(
                       Object = Substations[i].Value, 
                       Terminal = 0,
                       Status = Status$Caution);

      ELSEIF StatusCounts[j].Value > 1 OR StatusCounts[j].Value < 0 THEN
         RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                       Object = Substations[i].Value, 
                       Status = Status$Caution,
                       Terminal = 0,
                       increment = -1,
                       TimeSet = date('now'));
 
      ENDIF;

      IF RetCode < 0 THEN 
         CALLPROC DDB_ROLLBACK;
         ReturnStatus = PU_CANCEL;
         CALLPROC TraceError (UserMessage = 'ERROR: Unable to clear ' +
                 'substation Caution status.  Have tech support review ' +
                 'trace log.',
                              TraceMessage = 'Unable to decrement ' +
                 'Caution Status(' + VARCHAR(Status$Caution) + ') for ' +
                 'Substation=' + VARCHAR(Substations[i].Value) + '.'
                              );
      ELSE
         CALLPROC DDB_COMMIT;
         StatusCounts[j].Value = StatusCounts[j].Value - 1;
      ENDIF;
   ENDFOR;

   RETURN ReturnStatus;
END;

Application Component Report
============================

	Name:            CommonManhole


Application Component Report
============================

	Name:            CommonManholes

/*
**
**	Copyright c 2008 Pateric Software.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software
**
*/
/*
**  Application:    FeederCard
**  Frame:          CommonManholes
**
**  05/05/08   em   Initial
**  05/12/08   em   Appearance changes based on DO review
**  05/22/08   em   Redeveloped into a Matrix to include TC and individual cell attributes.
**                  TC Feeders will be FG red, Feeders with RFP Loc will be BG yellow.
**  07/21/08   em   Modified display colors and greenie text
**  07/24/08   em   Include Current Feeder in table in first slot
**  08/14/08   em   Include TCIP status with TC check
**  09/08/08   em   Removed TCIP status lookup
**  03/24/11   ysp  FMS 397: Replacing Messages with TraceError
**  05/10/11   em   Use Card input parameter for feeder selection due to 3G
**  07/15/16   em   Enhance Manhole select to include UNION for possible KPS card main feeder.
**  07/19/16   em   Extend TC Feeder List to include main feeder for a KPS Feeder.
*/
INITIALIZE 
(  Card 	= INTEGER NOT NULL,       /*Parameter*/
   Feeder 	= INTEGER NOT NULL,       /*Parameter*/
   FeederName   = VARCHAR(40) NOT NULL,   /*Parameter*/

#  include StandardDeclarations
   
   Feeder1      = INTEGER NOT NULL,
   Feeder2      = INTEGER NOT NULL,
   FeederName1  = VARCHAR(40) NOT NULL,    
   FeederName2  = VARCHAR(40) NOT NULL,    
   MaxJ         = INTEGER NOT NULL WITH DEFAULT,
   MH 		= ARRAY OF CommonManhole,
   TCFeederList   = ARRAY OF INTEGEROBJECT;
   j = INTEGER NOT NULL WITH DEFAULT;
   LastManhole  = VARCHAR(20) NOT NULL WITH DEFAULT;
   x = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF Card = 0 THEN
      CALLPROC TraceError(
              UserMessage = 'No Card Selected.',
              TraceMessage = 'CommonManholes screen is called up without card selected.');
      RETURN;
   ENDIF;

   FIELD(title).TextValue = '      List of Shared Manholes for Feeder ' + FeederName +
                            HC_NEWLINE + 'Feeder List shows only active out-of-service feeders';
/*
** Get TC FeederList
*/
   i = 1;
   TCFeederList.Clear();
   SELECT :TCFeederList[i].Value = Object
   FROM   FMS_ObjectStatus
   WHERE  Status = :Status$TC AND
          StatusCount > 0
   BEGIN
      SELECT :TCFeederList[i].Value = G.Grouping
      FROM   Udb_Grouping G
      WHERE  G.Member = :TCFeederList[i].Value AND
             G.MemberType = :Type$KPSFeeder AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Feeder;
      i = i + 1;
   END;
/*
** Get Cust locations
*/
   i = 1;
   MH.Clear();
   SELECT DISTINCT 
          :MH[i].Structure = RL.LocationStructure
   FROM   IR_RequestForPermit RFP,
          IR_RFPLocation RL
   WHERE  RFP.Card = :Card AND
          RFP.RFP = RL.RFP AND
         (UPPERCASE(RL.LocationStructure) LIKE 'CM%' OR
          UPPERCASE(RL.LocationStructure) LIKE 'CUST%')
   BEGIN
 /*     FIELD(MH[i].Name).BgColor = CC_YELLOW; */
      i = i + 1;
   END;
/*
** Select common manholes and build shared feeder list.
** Put feeder on current card in Feeder1 position.
** Potential problems on 3G feeder if more than one feeder on card runs through
** same manhole.
*/
   j = 1;
   MaxJ = 0;
   LastManhole = '';
   REPEATED
   SELECT  :MH[i].Structure = CM.Manhole,
           :Feeder1 = CTO.Object,
           :Feeder2 = CM.Feeder2,
           :FeederName1 = CTO.Name,
           :FeederName2 = O2.Name
   FROM    FMS_CommonManhole CM,
           TFMS_CardToObject CTO,
           Udb_Object O2
   WHERE   CTO.Card = :Card AND
           CTO.Object = CM.Feeder1 AND
           CM.Feeder2 = O2.Object
   UNION
   SELECT  CM.Manhole,
           CTO.Object,
           CM.Feeder1,
           CTO.Name,
           O1.Name
   FROM    FMS_CommonManhole CM,
           TFMS_CardToObject CTO,
           Udb_Object O1
   WHERE   CTO.Card = :Card AND
           CTO.Object = CM.Feeder2 AND
           CM.Feeder1 = O1.Object
   UNION
   SELECT  CM.Manhole,
           CM.Feeder1,
           CM.Feeder2,
           O1.Name,
           O2.Name
   FROM    FMS_CommonManhole CM,
           Udb_Object O1,
           Udb_Object O2
   WHERE   CM.Feeder1 = :Feeder AND
           CM.Feeder2 = O2.Object AND
           CM.Feeder1 = O1.Object
   UNION
   SELECT  CM.Manhole,
           CM.Feeder2,
           CM.Feeder1,
           O2.Name,
           O1.Name
   FROM    FMS_CommonManhole CM,
           Udb_Object O1,
           Udb_Object O2
   WHERE   CM.Feeder2 = :Feeder AND
           CM.Feeder1 = O1.Object AND
           CM.Feeder2 = O2.Object
   ORDER BY Structure, Feeder1
   BEGIN
      IF LastManHole <> '' AND LastManHole <> MH[i].Structure THEN
         j = 1;
      ELSEIF LastManHole = MH[i].Structure THEN
         MH.RemoveRow (RowNumber = i);
         i = i - 1;  /* Let's not go to the next one */
      ENDIF;
/*
** Put current feeder in first slot
*/
      IF j = 1 THEN
         MH[i].Feeder[j].Object = Feeder1;
         MH[i].Feeder[j].Name = FeederName1;
      ENDIF; 
           
      j = j + 1;
      IF Feeder1 = MH[i].Feeder[1].Object THEN
         MH[i].Feeder[j].Object = Feeder2;
         MH[i].Feeder[j].Name = FeederName2;
      ELSE
         MH[i].Feeder[j].Object = Feeder1;
         MH[i].Feeder[j].Name = FeederName1;
      ENDIF;
      IF j > MaxJ THEN
         MaxJ = j;   /* Will determine right most edge of Matrix */
      ENDIF;
      LastManHole = MH[i].Structure;
      i = i + 1;
   END;

   IF i = 1 THEN
      CALLPROC TraceError(
              UserMessage = 'No other feeder with a common manhole is out-of-service',
              TraceMessage = 'No other feeder with a common manhole is out-of-service');
      RETURN;
   ENDIF;

   FIELD(cell_template).ClientData = EntryField.Create();
/*
**  Set the matrix field to be able to contain the rows
**  returned from the select, as well as room for titles
**  on both the x-axis and y-axis of the matrix.
*/
   FIELD(matrix).Columns = MaxJ + 1;
   FIELD(matrix).Rows = MH.LastRow() + 1;
/*
**  Insert a child field into the matrix for each row that
**  was selected.  Also insert a field for each column and row 
**  title.
*/
    FOR i = 0 TO MH.LastRow() DO        /* rows */
        FOR j = 0 TO MaxJ DO    /* columns */
          /* 
          ** If we are in the first row, insert the column title template. 
          */
            IF (i = 0) AND (j = 0) THEN
                cell_template = 'Manhole';
                FIELD(cell_template).BgColor = CC_PALE_PINK;
                FIELD(matrix).InsertChild(fieldtoinsert = 
                    FIELD(cell_template).duplicate(),row=i+1,column=j+1);
            ELSEIF (i = 0) AND (j > 0) THEN
                cell_template = 'Feeder' + VARCHAR(j);
                FIELD(cell_template).BgColor = CC_PALE_PINK;
                FIELD(matrix).InsertChild(fieldtoinsert = 
                    FIELD(cell_template).duplicate(),row=i+1,column=j+1);
            ELSEIF (i > 0) AND (j = 0) THEN
                cell_template = MH[i].Structure;
                FIELD(cell_template).FgColor = CC_BLACK;
                IF (
                        UPPERCASE(MH[i].Structure) LIKE 'CM%' OR
                        UPPERCASE(MH[i].Structure) LIKE 'CUST%') THEN
                   FIELD(cell_template).BgColor = CC_ORANGE;
                ELSE
                   FIELD(cell_template).BgColor = CC_PALE_BLUE;
                ENDIF;
                FIELD(matrix).InsertChild(fieldtoinsert = 
                    FIELD(cell_template).duplicate(),row=i+1,column=j+1);
            ELSE
                IF j <= MH[i].Feeder.LastRow() THEN
                   cell_template = MH[i].Feeder[j].Name;
                   x = 0;
                   SELECT :x = Feeder
                   FROM   FMS_ManholeRFP
                   WHERE  Feeder = :MH[i].Feeder[j].Object AND
                          Manhole = :MH[i].Structure;
                   IF x > 0 THEN
                      FIELD(cell_template).BgColor = CC_ORANGE;
/*                      FIELD(Matrix[i+1,1]).BgColor = CC_ORANGE;*/
                   ELSE
                      FIELD(cell_template).BgColor = CC_PALE_BLUE;
                   ENDIF;
  
                   x = TCFeederList.Find (AttributeName = 'value',
                                       Value = MH[i].Feeder[j].Object);
                   IF x = ER_OK THEN
                      FIELD(cell_template).FgColor = CC_RED;
                   ELSE
                      FIELD(cell_template).FgColor = CC_BLACK;
                   ENDIF;
                   FIELD(matrix).InsertChild(fieldtoinsert = 
                        FIELD(cell_template).duplicate(),row=i+1,column=j+1);
                ENDIF;
            ENDIF;
        ENDFOR;
    ENDFOR;

    Curframe.Flush();

    IF (FIELD(matrix).Columns >= 12 AND FIELD(matrix).Rows >= 26) THEN   /* viewport becomes standard*/
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterWidth = 14000;
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterHeight = 8000;        
    ELSEIF (FIELD(matrix).Columns >= 12) THEN
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterWidth = 14000;
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterHeight = 
              FIELD(matrix).OuterHeight + 300;
    ELSEIF FIELD(matrix).Rows >= 26 THEN   /* viewport becomes standard*/
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterWidth = 
              FIELD(matrix).OuterWidth + 300;
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterHeight = 8000;        
    ELSE                                    /* viewport & frame sized to matrix*/
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterWidth = 
              FIELD(matrix).OuterWidth + 300;
        VIEWPORTFIELD(FIELD(matrix).ParentField.ParentField).OuterHeight = 
              FIELD(matrix).OuterHeight + 300;
    ENDIF;    

    Curframe.Flush();
    Curframe.WindowWidth = 
             FIELD(matrix).ParentField.ParentField.ParentField.OuterWidth + 10;
    Curframe.WindowHeight = 
             FIELD(matrix).ParentField.ParentField.ParentField.OuterHeight + 10;


END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;


ON CLICK OK_btn =
BEGIN
   RETURN PU_OK;
END;      

Application Component Report
============================

	Name:            CompletePermits

