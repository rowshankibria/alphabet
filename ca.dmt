*/

INITIALIZE
(
    pBtn1Text = VARCHAR(60) NOT NULL WITH DEFAULT;
    pBtn2Text = VARCHAR(60) NOT NULL WITH DEFAULT;
    pBtn3Text = VARCHAR(60) NOT NULL WITH DEFAULT;
    pLine     = INTEGER     NOT NULL WITH DEFAULT;
    pBGColor  = INTEGER     NOT NULL WITH DEFAULT;
    pFGColor  = INTEGER     NOT NULL WITH DEFAULT;

    pConfirmText = Varchar(1000) NOT NULL;	/* Confirm text */
    pTitle = Varchar(60) NOT NULL;		/* Optional::Title of window */
) =
BEGIN
   IF pTitle <> '' THEN
      CurFrame.WindowTitle = pTitle;
   ENDIF;
   
   IF pBGColor <> 0 THEN
      FIELD(ConfirmText).BGColor = pBGColor;
      FIELD(ConfirmText).OutLineWidth = LW_EXTRATHIN;
   ENDIF;
   
   IF pFGColor <> 0 THEN
      FIELD(ConfirmText).FGColor = pFGColor;
   ENDIF;

   ConfirmText = pConfirmText;
   IF pLine <> 0 THEN
      FIELD(ConfirmText).Lines = pLine;
   ELSE
      FIELD(ConfirmText).Lines = FIELD(ConfirmText).TextLength/55 + 3;
   ENDIF;
   
   IF pBtn1Text <> '' THEN
      FIELD(One_btn).TextLabel = pBtn1Text; 
   ELSE
      FIELD(One_btn).CurBias = FB_INVISIBLE;
   ENDIF;
   
   IF pBtn2Text <> '' THEN
      FIELD(Two_btn).TextLabel = pBtn2Text; 
   ELSE
      FIELD(Two_btn).CurBias = FB_INVISIBLE;
   ENDIF;
   
   IF pBtn3Text <> '' THEN
      FIELD(Three_btn).TextLabel = pBtn3Text; 
   ELSE
      FIELD(Three_btn).CurBias = FB_INVISIBLE;
   ENDIF;
END;

