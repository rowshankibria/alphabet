	Name:            PromptVerifyValveState

/*
**
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptVerifyValveState
**
**  Modifications:
**  06/12/14   ysp  Created
**  06/30/14   em   Changed logic to present screen
**  07/29/14   em   Correct Cracked status setting
**  10/29/21  em   Incorporate SSO return
*/
INITIALIZE 
(
   JIP = JobInProgress;			/* Job being processed */
) =
DECLARE
   RetCode = INTEGER;
   MoveText = VARCHAR(160) NOT NULL WITH DEFAULT;
   Structure = VARCHAR(40) NOT NULL WITH DEFAULT;
   StructureType = VARCHAR(40) NOT NULL WITH DEFAULT;
   ValveState = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   ** uncheck all radio buttons.
   */
   Result = -1;
   
   SELECT :StructureType = StructureTypeName,
          :Structure = StructureName
   FROM   DSO_Object
   WHERE  Object = :JIP.Equip;
   
   SELECT :ValveState = ValveState
   FROM   IR_DSODownloadMove
   WHERE  Job = :JIP.Job AND
          OrderNumber = :JIP.OrderNumber AND
          TORS = :JIP.TORS;
   
   IF ValveState <> '' THEN
      IF UPPER(ValveState) LIKE '%CRACKED' THEN
         Result = 2;
      ELSEIF UPPER(ValveState) LIKE '%CLOSED' THEN
         Result = 0;
      ELSE /* Default */
         Result = 1;
      ENDIF;
      FIELD(SSO_Result).CurBias = FB_VISIBLE;
      FIELD(Result).CurBias = FB_VISIBLE;
   ENDIF;

   FIELD(Heading).TextValue = 'Valve State for ' + SQUEEZE(StructureType + ' ' + Structure + ' ' + JIP.EquipClassName + ' ' + JIP.EquipName);
END;
   
ON CLICK OK_btn = 
DECLARE
   Cracked = INTEGER NOT NULL WITH DEFAULT;
   CurrentlyOpen = INTEGER NOT NULL WITH DEFAULT;
   Response = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Result = -1 THEN
      MESSAGE 'Please select a state for the valve';
      RESUME;
   ENDIF;
   
   IF Result = 2 THEN      /* cracked */
      CurrentlyOpen = 1;
      Cracked = 1;
   ELSE
      CurrentlyOpen = Result;  /* open or closed */
      Cracked = 0;
   ENDIF;

   RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName = 'currentlyopen',
                FieldValue = CurrentlyOpen);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to record valve state due to an error!';
      RETURN (PU_CANCEL);
   ENDIF;
                
   IF RetCode = 0 THEN
      RetCode = CALLPROC Udb_DSOValveFieldUpd (
                Object = JIP.Equip,
                FieldName = 'cracked',
                FieldValue = Cracked);
   ENDIF;
   
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to record valve cracked state due to an error!';
      RETURN (PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   Response = FIELD(Result).CurEnumText;
   Response = SHIFT(Response, -6);   // Remove "Valve "
   JIP.Response = Squeeze(Response + ' ' + JIP.Response);
   JIP.ResponseUpd();
   
   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
				 *Default Item


