METHOD UpdateDelayReason(
   UpdatePerson = VARCHAR(40) NOT NULL WITH DEFAULT;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.PermitTypeName = 'IS' THEN
      RetCode = CALLPROC SOA_ISPDelayReasonUpd(
                             ISPermit = CurObject.PermitJobID,
                             DelayReason = CurObject.DelayReason);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'PermitRequest.UpdateDelayReason; Error saving ISWP Delay Reason';
         CurMethod.Trace(Text = varchar(date('now')) + ' : PermitRequest.UpdateDelayReason; ' + 
                'Error saving  ISWP Delay Reason');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RetCode = CALLPROC SOA_ISPLogIns(
                             ISPermit = CurObject.PermitJobID,
                             LogTime = DATE('NOW'),
                             LogUpdateBy = 0, 
                             LogItem = 'Delay Reason',
                             LogText = 'Updated by ' + UpdatePerson + ': ' + CurObject.DelayReason,
                             LogType = 2);  
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.PermitTypeName = 'OS' THEN
         CurMethod.Trace(Text = varchar(date('now')) + ' : PermitRequest.UpdateDelayReason; ' + 
                'Somehow still using OutOfService WP program code');
   ENDIF; 
 
   RETURN;
END;

