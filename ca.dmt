	Name:            SelectHipotCriteria

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard_DBM
**  Frame:          TestHistoryLoad
**
**  Date:       Version Description
** ----------------------------------
**  01/17/93    mts     Initial creation: Frame to select hipot test criteria from table       
*/

INITIALIZE
(
    
    FeederKv = INTEGER NOT NULL;               /* Holds Feeder Kv */
    HipotType = INTEGER NOT NULL;              /* Indicates whether high pot or modified high pot */
    TestTypeKv = INTEGER NOT NULL;             /* Holds TestType Kv */                        
    Duration   = INTEGER NOT NULL;             /* Holds test duration */                  
    MaxMA      = INTEGER NOT NULL;             /* Holds maximum mA for test */                     

    i = INTEGER NOT NULL;                      /* index */

) =
    BEGIN

        i = 1;
        SELECT :HiPotTable[i].TestTypeKv = TestTypeKv, 
               :HiPotTable[i].Duration   = Duration, 
               :HiPotTable[i].MaxMA      = MaxMA
        FROM   
               FMS_HiPotTest
        WHERE  
               FeederKv = :FeederKv AND
               Type = :HiPotType 
        ORDER BY 
               TestTypeKv Asc
        BEGIN
           i = i + 1;
        END;

        CALLPROC DDB_ROLLBACK;

        IF HiPotTable.Numrows() = 0 THEN
            message 'There is no existing test criteria for this Feeder.';
            RETURN;
        ENDIF;

    END;

ON CLICK OK_btn =            

    BEGIN
        i = Field(HiPotTable).CurRow;
        TestTypeKv = HiPotTable[i].TestTypeKv;
        Duration   = HiPotTable[i].Duration;
        MaxMA      = HiPotTable[i].MaxMA;

        RETURN;
    END; 

ON CLICK Menu.File.FCLose =
    BEGIN
        RETURN;
    END;

ON WINDOWCLOSE =
    BEGIN
        RESUME;
    END;

