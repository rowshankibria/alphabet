	Name:            RenameDroppedEquipment

/* 
**      Copyright c 2008 Pateric Software LLC  All rights reserved. 
** 
**      Pateric Software proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Pateric Software LLC. 
** 
**  Application:    CAC 
**  Frame:          RenameDroppedEquipment 
** 
**  Modification log: 
** 
**  Date:     Version   Description 
** -------------------------------------------------- 
** 05/15/08    ysp      FMS 386 
*/ 
INITIALIZE   
(
/* passed-in */
    Equip = INTEGER NOT NULL;		    /* parameter */ 

/* local variables */
#   include StandardDeclarations
   OrigName = VARCHAR(40) NOT NULL WITH DEFAULT;
) = 
DECLARE

ENDDECLARE
BEGIN 
   SELECT  :SelectEquip[1].Equip = O.Object,  
           :SelectEquip[1].EquipName = O.Name, 
           :SelectEquip[1].EquipClass  = O.Type, 
           :SelectEquip[1].EquipClassName  = O.TypeName, 
           :SelectEquip[1].Origin = O.OwnerNumber, 
           :SelectEquip[1].Description = O.Description,
           :SelectEquip[1].G = O.PrimaryGrouping
   FROM    Udb_Object O
   WHERE   O.Object = :Equip;
   CALLPROC DDB_ROLLBACK;
  
   OrigName = SelectEquip[1].EquipName;

//   FIELD(Cancel_Btn).TextLabel = 'Keep ' + OrigName + ' on Feeder';
END; 


ON Click OK_Btn =
BEGIN
   IF OrigName = SelectEquip[1].EquipName THEN
      MESSAGE 'You need to change the equipment name.';
      RESUME;
   ELSE
      i = 0;
      SELECT :i = Object
      FROM   Udb_Object
      WHERE  Type = :SelectEquip[1].EquipClass AND
             PrimaryGrouping = :SelectEquip[1].G AND
             Name = :SelectEquip[1].EquipName;

      IF i > 0 THEN
         MESSAGE 'The drop bank already has a piece of equipment with this name. Change again.';
         RESUME;
      ENDIF;
   ENDIF;

   RetCode = CALLPROC Udb_ObjectUpd (
                  Object = SelectEquip[1].Equip,
                  PrimaryGrouping = SelectEquip[1].G,
                  Type = SelectEquip[1].EquipClass,
                  Name = SelectEquip[1].EquipName);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
      RETURN PU_OK;
   ELSE
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to rename equipment name due to Ingres error. Contact FMS Administrator.';
   ENDIF;
END;

ON Click Cancel_Btn =
BEGIN
   RETURN PU_CANCEL;
END;

