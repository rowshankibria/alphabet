	Name:            AcknowledgeRFP

/*
**
**	Copyright c 2001 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          AcknowledgeRFP
**
**  12/10/01  em    Created using SelectOperator as a base.
**  12/11/01  pkw   Create outgoing message when rejecting or requesting
**                  a revision to RFP.
**  12/12/01  em    Call SelectOperator from this screen, if DO wishes to
**                  select another.
**  01/05/02  pkw   Delete previous messages if they haven't been acknowledged
**                  by the FCR.
**  02/19/02  em    Card Value not passed when called from ReviewRFP screen.
**                  That means that Msg_Message table interaction will 
**                  be avoided.
**  02/27/02  em    Need to send Message using RFP ID not card, to support msg 
**                  deletion upon Reject or Change Request Acknowledgment.
**  03/04/02  em    Added LinkAck to auto acknowledge when pending RFP is linked
**                  to a card.
**  07/16/02  ysp   Merge: Use include script to handle card control.
**  08/15/02  em    Don't present Acknowledgement confirmation message.
**  12/01/02  pkw   Don't pass OfferSelection to selectoperator anymore.
**  01/06/03  ysp   ITC 114: Use DoLogin to select a DO.
**  10/20/05  em    FMS 260: Outgoing Message Changes
**  04/13/07  ysp   ITC210: Insert IR interface event in DB event queue
**  11/16/07  em    Since FCR does not acknowleddge RFP Rejection, don't
**                  insert outgoing message for RFP Rejection.
**  07/25/16  ysp   if 33kv portion card, show the main feeder name for messages
*/
INITIALIZE
(
   /* passed in */
    Card = FMS_Card;   			/* passed in card */
    ResponseType = VARCHAR(40) NOT NULL;/* Passed; Ack;Reject;RevisonReq */
    RFP = IR_RequestForPermit; 		/* Passed RFP */
) =
DECLARE
   /* local variables */
#   include StandardDeclarations

    j = integer;			/* Temporary counter */

    AckType = VARCHAR(40) NOT NULL WITH DEFAULT;
    AckMsg = VARCHAR(400) NOT NULL WITH DEFAULT;
    CurDOMsg = VARCHAR(400) NOT NULL WITH DEFAULT;
    RFPFeeder = INTEGER NOT NULL WITH DEFAULT; 
    FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
    AckBy = INTEGER NOT NULL WITH DEFAULT;  /* Acknowledgment BOOLEAN */
    RejBy = INTEGER NOT NULL WITH DEFAULT;  /* Rejection BOOLEAN */
    RevBy = INTEGER NOT NULL WITH DEFAULT;  /* Revision Request BOOLEAN */
  
    MsgKey = INTEGER NOT NULL WITH DEFAULT;  
ENDDECLARE
BEGIN
   DistrictOperator = DOp.Description;
/*
** Set up for type of acknowledgment: Acknowledge, Reject, Request Revision
*/
   AckBy = RFP.AcknowledgedByDO;
   RejBy = RFP.RejectedByDO;
   RevBy = RFP.RevisionRequestedByDO;
   
   IF ResponseType = 'ACKNOWLEDGE' THEN
      AckTitle = 'Acknowledge RFP';
      AckType = 'Acknowledging receipt of this RFP.';
      AckBy = TRUE;
      FIELD(RevRequest).CurBias = FB_INVISIBLE;
   ELSEIF ResponseType = 'REJECT' THEN
      AckTitle = 'Reject RFP';
      AckType ='Rejecting this RFP.';
      RejBy = TRUE;
      AckBy = TRUE;
      FIELD(RevRequest).CurBias = FB_CHANGEABLE;
   ELSEIF ResponseType = 'REQUEST_FOR_CHANGE' THEN
      AckTitle = 'Request RFP Revision';
      AckType = 'Requesting a Revision on this RFP.';
      RevBy = TRUE;
      AckBy = TRUE;
      FIELD(RevRequest).CurBias = FB_CHANGEABLE;
   ELSEIF ResponseType = 'LINKACK' THEN
      AckTitle = 'Automatically Acknowledging RFP';
      AckType = 'Automatically Acknowledging RFP.';
      AckBy = TRUE;
      FIELD(RevRequest).CurBias = FB_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'AutoAcknowledge');
   ELSE
      MESSAGE 'ERROR: Unknown Acknowledgment ResponseType Parameter.';
      RETURN (PU_CANCEL);
   ENDIF; 
   
   IF Card.NetworkFeeder = NetworkFeeder$33KV AND Card.TypeOfCard = TypeOfCard$Portion THEN
      SELECT :RFPFeeder = C.Feeder,
             :FeederName = C.FeederName
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :Card.Card AND
             L.Card = C.Card;
      CALLPROC DDB_ROLLBACK;
   ELSE
      RFPFeeder = Card.Feeder;
      FeederName = Card.FeederName;
   ENDIF;
END;


ON ENTRY DistrictOperator =
BEGIN
    RetCode = CALLFRAME DOLogIn (NoLogOut = TRUE);
    IF RetCode = 0 THEN
        RESUME;
    ELSE
        IF DOp.Description = '' THEN
           MESSAGE 'Please select a DO.';
           RESUME;
        ELSE 
           DistrictOperator = DOp.Description;
        ENDIF;
    ENDIF;                 
END;
/*
**	Handle an OK click
*/
ON USEREVENT 'AutoAcknowledge',
ON Click OK_Btn =
BEGIN
/*
**  Keep current message to put in outgoing message.
*/
   CurDOMsg = RevRequest.DOComment;
  
/*
** If not an acknowledgment, a reason is required. Will be appended to the front
** of the DO Comment with a timestamp.
*/
   IF ResponseType <> 'ACKNOWLEDGE' AND ResponseType <> 'LINKACK' THEN
      IF RevRequest.DOComment = '' THEN
         MESSAGE 'You must enter a reason.';
         RESUME;
      ELSEIF ResponseType = 'REJECT' THEN
         RevRequest.DOComment = VARCHAR(DATE('now')) + ':' + HC_NEWLINE +
                                RevRequest.DOComment;
      ELSE	 
         RevRequest.DOComment = VARCHAR(DATE('now')) + ':' + HC_NEWLINE +
                                RevRequest.DOComment + HC_NEWLINE +
                                RFP.DOComment;
      ENDIF;
   ENDIF;

   IF DistrictOperator = '' THEN
      Message 'You have not selected your name.';
      RESUME;
   ENDIF;

   IF ResponseType = 'LINKACK' OR ResponseType = 'ACKNOWLEDGE' THEN
/*  Skip  */
   ELSEIF RFP.ManualInsertByDO = FALSE THEN
      IF CurFrame.ConfirmPopup (MessageText = 'You, ' + DistrictOperator +
              ', are ' + AckType + HC_NEWLINE +
              'Confirmation of this action will be sent to the FCR.') 
                  = PU_CANCEL  THEN
         RESUME;
      ENDIF;
   ELSE
      IF CurFrame.ConfirmPopup (MessageText = 'You, ' + DistrictOperator +
              ', are ' + AckType + HC_NEWLINE + 'The RFP was manually ' +
              'entered from a FAX, no notification is sent to the FCR.')
                  = PU_CANCEL  THEN
         RESUME;
      ENDIF;
   ENDIF;  

   IF ResponseType = 'REJECT' THEN
      AckMsg = 'RFP Rejected ' +
               'on Feeder ' + FeederName +
               '.  This message will remain in the outgoing messages ' +
               'until the FCR has acknowledged the rejection.' + HC_NEWLINE +
               'Rejection Reason entered by ' + DistrictOperator + ': ' +
               HC_NEWLINE + CurDOMsg;

   ELSEIF ResponseType = 'REQUEST_FOR_CHANGE' THEN
      AckMsg = 'Request for a Change on an RFP ' +
               ' for Feeder ' + FeederName +
               '.  This message will remain in ' +
               'the outgoing messages until the FCR has acknowledged the ' +
               'revision request.' + HC_NEWLINE +
               'The Change Request comment entered by ' + DistrictOperator + ': ' +
               HC_NEWLINE + CurDOMsg;
   ENDIF;

   MsgKey = 0;
   IF (ResponseType = 'REJECT' OR
       ResponseType = 'REQUEST_FOR_CHANGE') AND
       RFP.ManualInsertByDO = FALSE THEN
/*
**  See if any previous messages have not been acknowledged.
**  If so, we will remove the outgoing message.
*/
      i = 0;
      SELECT :i = M.MsgKey
      FROM    IR_RequestForPermit R,
              Msg_Message M
      WHERE   R.Card = :Card.Card AND
              R.RequestForPermit = :RFP.RequestForPermit AND
              R.MsgKey = M.MsgKey AND
              M.DelByOpName = '';
      CALLPROC DDB_ROLLBACK;
      
      If i <> 0 THEN  /* delete message */
         RetCode = CALLPROC Msg_UpdateMsg (Card = Card.Card,
                        Ack = Ack$Delete,
                        MsgKey = i,
                        AckByOpName = 'FCRInterface',
                        AckDate = date('now'),
                        DelByOpName = 'FCRInterface',
                        DelDate = date('now'),
                        Substation = RFPFeeder);
         CALLPROC DDB_COMMIT;
/*
** Log in trace window if this failed.  Not that big of deal.
** D.O. will just have to do it manually.
*/
         IF RetCode < 0 THEN
            CurFrame.Trace (Text = VARCHAR(date('now')) +
                    ': Error - System was not able to ' +
                    'automatically delete previous outgoing ' + 
                    'message from AcknowledgeRFP screen.');
         ENDIF; 
      ENDIF;
/*
**  Insert message for tracking purposes.
*/
      IF ResponseType <> 'REJECT' THEN

         MsgKey = CALLPROC MSG_SendMsg (Card = Card.Card,
                                  Action = 0,
                                  OrderNumber = RFP.RFP,
                                  Substation = RFPFeeder,
                                  SubstationName = FeederName,
                                  Msg = AckMsg,
                                  FromOpName = DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FCR',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
         IF MsgKey < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Not able to create an outgoing message.  ' +
                 'Please try again.  If you continue to have problems, contact ' +
                 'technical support.';
            RESUME;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF;
/*
** Save values for the RFP
*/
   RetCode = CALLPROC IR_AcknowledgeRFP (
                   RFP = RFP.RFP,
                   RevisionNumber = RFP.RevisionNumber,
                   MsgKey = MsgKey,
                   AcknowledgedByDO = AckBy,
                   RejectedByDO = RejBy,
                   RevisionRequestedByDO = RevBy,
                   DOComment = RevRequest.DOComment);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
/*
** Only send message to FCR if RFP not manually entered by DO AND not LINKACK.
*/
      IF RFP.ManualInsertByDO = FALSE AND ResponseType <> 'LINKACK' THEN
          RFP.AcknowledgedByDO = AckBy;
          RFP.RejectedByDO = RejBy;
          RFP.RevisionRequestedByDO = RevBy;
          RFP.DOComment = RevRequest.DOComment;
          
          ControlText = VARCHAR(RFP.RFP) + ';' +
                        VARCHAR(RFP.RevisionNumber) + ';' +
                        ResponseType + ';' +
                        VARCHAR(DATE('now')) + ';' +
                        DistrictOperator + ';';           

          CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_AcknowledgeFCR',
                     EventText = ControlText);   
      ENDIF;
   ELSE
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error updating a Request for Permit.  Try again or ' +
                  'contact tech support.';
          RESUME;
   ENDIF;
	       
   RETURN (PU_OK);
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =

    BEGIN
	    RETURN (PU_CANCEL);
    END;


ON WINDOWCLOSE =

   BEGIN
	RESUME;
   END;

/*
**      Another desk wants control of the card.  parse dbevent text, 
**      present message, and file card.
*/
ON DBEvent 'fms_card_control_taken' =
BEGIN
#  include Card_Control

   RETURN (PU_CANCEL);
END;

