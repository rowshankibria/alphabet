METHOD SendNYISOEmail(
   EmailType = VARCHAR(20) NOT NULL WITH DEFAULT 
) = 
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   EmailClass = EmailNotificationClass;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.LastUpdatebyName = Description
   FROM   Udb_Object
   WHERE  Object = :CurObject.LastUpdateBy;
      
   EmailClass.EmailType = 9;                        // NYISO
   EmailClass.Sender = CurObject.LastUpdatebyName;
   EmailClass.Recipient = 'NYISO Distribution List';
   IF EmailType = 'APPROVED' THEN   
      EmailClass.Subject = 'In-Service Work Permit Requiring NYISO Notification is APPROVED'; 
   ELSEIF EmailType = 'PULLED' THEN   
      EmailClass.Subject = 'In-Service Work Permit Requiring NYISO Notification is PULLED'; 
   ELSEIF EmailType = 'COMPLETED' THEN   
      EmailClass.Subject = 'In-Service Work Permit Requiring NYISO Notification is COMPLETED'; 
   ELSEIF EmailType = 'INCOMPLETED' THEN   
      EmailClass.Subject = 'In-Service Work Permit Requiring NYISO Notification is INCOMPLETED'; 
   ENDIF;
   
   EmailClass.Message1 = 'TargetName=' + CurObject.SubstationName + ';;' +
              'Operator=' + CurObject.LastUpdatebyName + ';;' + 
              'Status=' + EmailType + ';;'; 
   EmailClass.Message2 = 'Permit=' + CurObject.PermitMove + ';;';
   EmailClass.Template = 'ISWPNYISO.html';                      
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.SendNYISOEmail. ERROR: ' + 
             'Unable to send NYISO email.');
   ENDIF;

   IF EmailType = 'APPROVED' THEN   
      RETURN;
   ENDIF;

   /*
   ** remind T.O. to notify NYISO
   */ 
   MsgText = 'ISWP "' + CurObject.PermitMove + '"';
   
   IF EmailType = 'PULLED' THEN   
      MsgText = MsgText + ' PULLED '; 
   ELSEIF EmailType = 'COMPLETED' THEN   
      MsgText = MsgText + ' returned COMPLETE '; 
   ELSEIF EmailType = 'INCOMPLETED' THEN   
      MsgText = MsgText + ' returned INCOMPLETE '; 
   ENDIF;
   MsgText = MsgText + ' from ' + CurObject.SubstationName + '. Please notify NYISO if needed.';

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = varchar(date('now')) + ': InServicePermitClass.SendNYISOEmail. ' + 
                'Error sending notification message to TO.');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;      

   RETURN;   
END;
/* ============================================================================================
** DSO related methods.
*/
METHOD TOReviewDSOPermit(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   OldStatus = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
   Response = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.UpdateStatus();
   IF CurObject.ReturnCode <> 0 THEN
      RETURN;
   ENDIF;
/*
** Change the jurisdiction if TO approves or denies a DSO permit. 
*/
   IF CurObject.Status = ISPStatus$Approved OR CurObject.Status = ISPStatus$RequestDenied THEN
      IF CurObject.Status = ISPStatus$Approved THEN
         CurObject.Jurisdiction = 'SM';
      ELSE
         CurObject.Jurisdiction = '';
      ENDIF;

      RetCode = CALLPROC SOA_ISPJurisdictionUpd(
                    ISPermit = CurObject.ISPermit,
                    Jurisdiction = CurObject.Jurisdiction,
                    UpdateTime = DATE('NOW'),		    
                    UpdateBy = CurObject.LastUpdateBy);

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'InServicePermitClass.TOReviewDSOPermit; Error in processing In Service Permit request';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.TOReviewDSOPermit. ERROR: ' + 
                'Unable to change jurisdiction for In Service Permit request.');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF CurObject.Status = ISPStatus$Approved THEN
      MsgText = 'T.O. approved dielectric <a target="fms" href="<%type=sm_isp&status=' + VARCHAR(ISPStatus$AllCurrent) + '%>">' + 
                'In-Service Work Permit </a>: "' + CurObject.PermitMove + '"';

   ELSEIF CurObject.Status = ISPStatus$RequestPending THEN
      MsgText = 'T.O. set pending on dielectric <a target="fms" href="<%type=sm_isp&status=' + VARCHAR(ISPStatus$AllCurrent) + '%>">' + 
                'In-Service Work Permit </a>: "' + CurObject.PermitMove + '"';

   ELSEIF CurObject.Status = ISPStatus$Denied THEN
      MsgText = 'T.O. denied dielectric In-Service Work Permit: "' + CurObject.PermitMove + '". Request returned to working group.';
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.TOReviewDSOPermit; ' + 
                'Error sending dielectric iswp notification message to SM.');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN;
END;

METHOD SMReviewDSOPermit(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.UpdateStatus();
   IF CurObject.ReturnCode <> 0 THEN
      RETURN;
   ENDIF;
/*
** Change the jurisdiction if SM sends the permit to TO for approval
*/
   IF CurObject.Status = ISPStatus$PendingTO THEN
      CurObject.Jurisdiction = 'TO';
      RetCode = CALLPROC SOA_ISPJurisdictionUpd(
                    ISPermit = CurObject.ISPermit,
                    Jurisdiction = CurObject.Jurisdiction,
                    UpdateTime = DATE('NOW'),		    
                    UpdateBy = CurObject.LastUpdateBy);

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'InServicePermitClass.SMReviewDSOPermit; Error in processing In Service Permit request';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.SMReviewDSOPermit. ERROR: ' + 
                'Unable to change jurisdiction for In Service Permit request.');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

      MsgText = 'New <a target="fms" href="<%type=to_isp&status=' + VARCHAR(ISPStatus$PendingTO) + '%>">' + 
                'Dielectric In-Service Work Permit</a> requested by Shift Manager for approval';

      RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SMReviewDSOPermit; ' + 
                'Error sending notification message to TO.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
   ENDIF;

   RETURN;
END;

METHOD IssueDSOPermit (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.Object = P.Object,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.Job = P.Job,        
          :CurObject.Status = P.Status,			      
          :CurObject.EnterBy = P.EnterBy		    
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   CurObject.ISP_Job.ISPermit = :CurObject.ISPermit;
   CurObject.ISP_Job.IssueMove();
   IF CurObject.ISP_Job.ReturnCode < 0 THEN
      CurObject.ReturnCode = CurObject.ISP_Job.ReturnCode;
      CurObject.ErrorMessage = CurObject.ISP_Job.ErrorMessage;
      RETURN;
   ENDIF;

   CurObject.PrevStatus = 0;
   CurObject.Status = ISPStatus$Issued;
   CurObject.UpdateStatus();
   IF CurObject.ReturnCode < 0 THEN
       RETURN;
   ENDIF;

   RetCode = CALLPROC SOA_ISPLogIns(
                      ISPermit = CurObject.ISPermit, 
                      LogTime = DATE('NOW'),
                      LogUpdateBy = CurObject.LastUpdateBy, 
                      LogItem = 'TOIssue',
                      LogText = 'Permit issued to ' + CurObject.ISP_Job.TOOperatorName,
                      LogType = 0); // TO and DO only
   CALLPROC DDB_COMMIT;

   RETURN;
END;

METHOD CompleteDSOPermit (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.Object = P.Object,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.Job = P.Job,        
          :CurObject.Status = P.Status,			      
          :CurObject.EnterBy = P.EnterBy		    
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   CurObject.ISP_Job.ISPermit = :CurObject.ISPermit;
   CurObject.ISP_Job.CompleteMove();
   IF CurObject.ISP_Job.ReturnCode < 0 THEN
      CurObject.ReturnCode = CurObject.ISP_Job.ReturnCode;
      CurObject.ErrorMessage = CurObject.ISP_Job.ErrorMessage;
      RETURN;
   ENDIF;

   CurObject.PrevStatus = 0;
   IF CurObject.ISP_Job.ReturnStatus = 'COMPLETE' THEN
      CurObject.Status = ISPStatus$Complete;
   ELSE
      CurObject.Status = ISPStatus$InComplete;
   ENDIF;

   CurObject.UpdateStatus();
   IF CurObject.ReturnCode < 0 THEN
       RETURN;
   ENDIF;

   RetCode = CALLPROC SOA_ISPLogIns(
                      ISPermit = CurObject.ISPermit, 
                      LogTime = DATE('NOW'),
                      LogUpdateBy = CurObject.LastUpdateBy, 
                      LogItem = 'RSComplete',
                      LogText = 'Permit returned ' + CurObject.ISP_Job.ReturnStatus + ' by ' + CurObject.ISP_Job.RSOperatorName,
                      LogType = 0); // TO and DO only
   CALLPROC DDB_COMMIT;

   RETURN;
END;

METHOD WithdrawDSOPermit (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   WithdrawTime = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.Object = P.Object,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.Job = P.Job,        
          :CurObject.Status = P.Status,			      
          :CurObject.EnterBy = P.EnterBy		    
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   CurObject.ISP_Job.ISPermit = CurObject.ISPermit;
   CurObject.ISP_Job.InCompleteMove();
   IF CurObject.ISP_Job.ReturnCode < 0 THEN
      CurObject.ReturnCode = CurObject.ISP_Job.ReturnCode;
      CurObject.ErrorMessage = CurObject.ISP_Job.ErrorMessage;
      RETURN;
   ENDIF;

   CurObject.PrevStatus = 0;
   CurObject.Status = ISPStatus$Withdrawn;
   CurObject.UpdateStatus();
   IF CurObject.ReturnCode < 0 THEN
       RETURN;
   ENDIF;

/*
** Create a withdrawal event
*/
   WithdrawTime = DATE('NOW');
   RetCode = CALLPROC SOA_ISPWithdrawEventIns (
                 WithdrawEvent = 0,
                 WithdrawReason = CurObject.SODenyReason,
                 WithdrawBy = CurObject.LastUpdateBy, 
                 WithdrawTime = WithdrawTime,
                 WithDrawGroupType = 'ALL',
                 WithdrawGroup = CurObject.Substation);
   IF RetCode < 0  THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to save withdrawal reason.';
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermitClass.WithdrawDSOPermit; ' +
                   'Failed to save withdrawal reason.');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT; 
   ENDIF;

   RetCode = CALLPROC SOA_ISPWithdrawPermitIns (
                    WithdrawEvent = 0,
                    WithdrawTime = WithdrawTime,
                    ISPermit = CurObject.ISPermit);
  IF RetCode <> 0  THEN
     CALLPROC DDB_ROLLBACK;
     CurObject.ReturnCode = -1;
     CurObject.ErrorMessage = 'Failed to save withdrawal reason.';
     CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermitClass.WithdrawDSOPermit; ' +
                   'Failed to save permit ' + VARCHAR(CurObject.ISPermit) + ' in SOA_ISPWithdrawPermit table');
     RETURN;
   ELSE
     CALLPROC DDB_COMMIT; 
   ENDIF;

   RETURN;
END;

