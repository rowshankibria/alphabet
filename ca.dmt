METHOD ImportData(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   Equip = INTEGER NOT NULL WITH DEFAULT;
   SearchString = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.Received = Date(CurObject.ReceivedChar);
   CurObject.ApprovalDate = Date(CurObject.ApprovalDateChar);
   CurObject.InstallDate = Date(CurObject.InstallDateChar);
     
   // feeder
   IF CurObject.Feeder = 0 AND CurObject.FeederName <> '' THEN
      SELECT :CurObject.Feeder = O.Object
      FROM   UDB_Grouping G,
             Udb_Object O
      WHERE  G.Grouping = :CurObject.Division AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Feeder AND
             G.Member = O.Object AND
             O.Name = :CurObject.FeederName;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   /*
   ** identify the equipment in the Transform lock card.
   ** we don't do this for Disconnect Manhole because the locks will be 
   ** copied to two pieces of equipment DM-VAC and Cam_Disc, which will be
   ** decided by DO.
   */
   IF CurObject.FormID = 0 THEN
      Equip = 0;
      IF CurObject.Feeder > 0 AND CurObject.EquipName <> '' THEN
         SearchString = '%' + CurObject.EquipName;
         i = 1;
         SELECT :Equip = O.Object
         FROM   UDB_Grouping G,
                Udb_Object O
         WHERE  (G.Grouping = :CurObject.Feeder OR 
                 G.Grouping IN (SELECT Member 
                                FROM   UDB_Grouping 
                                WHERE  Grouping = :CurObject.Feeder AND
                                       Relationship = :Interaction$MemberOf AND
                                       MemberType IN (:Type$ISOFeeder, :Type$PortionFeeder, :Type$SubFeeder))) AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = O.Object AND
                O.Name LIKE :SearchString
         BEGIN
            i = i + 1;
         END;
         CALLPROC DDB_ROLLBACK;
         
         IF i = 2 THEN  // one match only
            CurObject.Equip  = Equip;
         ENDIF;
      ENDIF;
   ENDIF;
   
   CurObject.FormID = CALLPROC Udb_NextKey (KeyName = 'SesameLock');
   IF CurObject.FormID < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Error in creating a new form number.';
       RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RetCode = CALLPROC FMS_SesameLockCardIns(
                FormID = CurObject.FormID
               ,FormType = CurObject.FormType
               ,Received = CurObject.Received
               ,EnteredBy = CurObject.EnteredBy
               ,Division = CurObject.Division       
               ,Feeder = CurObject.Feeder         
               ,Equip = CurObject.Equip
               ,ComboNo = CurObject.ComboNo          
               ,FDRAndStruct = CurObject.FDRAndStruct   
               ,Location = CurObject.Location       
               ,InstalledBy = CurObject.InstalledBy    
               ,InstallDate = CurObject.InstallDate    
               ,Supervisor = CurObject.Supervisor     
               ,ApprovalDate = CurObject.ApprovalDate   
               ,SerialNo = CurObject.SerialNo          
               ,LockNo = CurObject.LockNo            
               ,PhaseA = CurObject.PhaseA            
               ,PhaseASerial = CurObject.PhaseASerial      
               ,PhaseALock = CurObject.PhaseALock        
               ,PhaseB = CurObject.PhaseB            
               ,PhaseBSerial = CurObject.PhaseBSerial      
               ,PhaseBLock = CurObject.PhaseBLock        
               ,PhaseC = CurObject.PhaseC            
               ,PhaseCSerial = CurObject.PhaseCSerial      
               ,PhaseCLock = CurObject.PhaseCLock
               ,KV = CurObject.KV
               ,KVA = CurObject.KVA
               ,KV2 = CurObject.KV2
               ,Remarks = CurObject.Remarks
               
               ,NWTrans = CurObject.NWTrans  
               ,Radial = CurObject.Radial   
               ,Reactor = CurObject.Reactor  
               ,GroundSW = CurObject.GroundSW 
               ,FDRAndVault = CurObject.FDRAndVault       
               ,SesameLock = CurObject.SesameLock        
               ,UnitLocked = CurObject.UnitLocked        
               ,NeutralInstalled = CurObject.NeutralInstalled  
               ,AnodesInstalled = CurObject.AnodesInstalled
               
               ,PowerSupplySerial = CurObject.PowerSupplySerial 
               ,PowerSupplyLock   = CurObject.PowerSupplyLock   
               ,PowerSupplyCombo   = CurObject.PowerSupplyCombo   
               ,HandHeldSerial = CurObject.HandHeldSerial
               ,HandHeldLock   = CurObject.HandHeldLock  
               ,HandHeldCombo   = CurObject.HandHeldCombo
               ,SCADASerial   = CurObject.SCADASerial  
               ,SCADALock     = CurObject.SCADALock    
               ,SCADACombo     = CurObject.SCADACombo    
               ,ManualSerial  = CurObject.ManualSerial 
               ,ManualLock    = CurObject.ManualLock   
               ,ManualCombo    = CurObject.ManualCombo  
               ,CamASerial = CurObject.CamASerial
               ,CamALock   = CurObject.CamALock  
               ,CamACombo   = CurObject.CamACombo
               ,CamBSerial = CurObject.CamBSerial
               ,CamBLock   = CurObject.CamBLock  
               ,CamBCombo   = CurObject.CamBCombo
               ,CamCSerial = CurObject.CamCSerial
               ,CamCLock   = CurObject.CamCLock
               ,CamCCombo   = CurObject.CamCCombo
               ,DMBadging = CurObject.DMBadging
               ,SwitchLocked = CurObject.SwitchLocked
               ,CamOpsLocked = CurObject.CamOpsLocked
            );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to save Lock Card data in the FMS database';
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - SesameLockCard.ImportEmailData; Failed to save Lock Card data');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;   
END;

METHOD UpdateStatus(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
   UpdateTime = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   UpdateTime = DATE('NOW');
   RetCode = CALLPROC FMS_SesameLockCardUpd(
                          FormID = CurObject.FormID,
                          Equip = CurObject.Equip,
                          UpdateTime = UpdateTime,
                          ByDO = DOp.Description);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to set process status for this lock card record';
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - SesameLockCard.UpdateStatus; ' + 
                      'Failed to set process status for sesame lock card record');
   ELSE
      CALLPROC DDB_COMMIT;
      CurObject.Processed = 1;
      CurObject.UpdateTime = UpdateTime;
      CurObject.ByDO = DOp.Description;
   ENDIF;
END;

METHOD DeleteRecord(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_SesameLockCardDel(FormID = CurObject.FormID);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to delete this lock card record';
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - SesameLockCard.DeleteRecord; ' + 
                      'Failed to delete the lock card record');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

/*
** this method will be replaced by ImportData 
*/
METHOD ImportEmailData(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   Equip = INTEGER NOT NULL WITH DEFAULT;
   SearchString = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.Received = Date(CurObject.ReceivedChar);
   CurObject.ApprovalDate = Date(CurObject.ApprovalDateChar);
   CurObject.InstallDate = Date(CurObject.InstallDateChar);
    
   // division 
   CurObject.DivisionName = UPPERCASE(CurObject.DivisionName);

   IF CurObject.DivisionName = 'M' THEN
      CurObject.Division = Division$Manhattan;
   ELSEIF CurObject.DivisionName = 'X' THEN
      CurObject.Division = Division$Bronx;
   ELSEIF CurObject.DivisionName = 'B' THEN
      CurObject.Division = Division$Brooklyn;
   ELSEIF CurObject.DivisionName = 'Q' THEN
      CurObject.Division = Division$Queens;
   ELSEIF CurObject.DivisionName = 'S' THEN
      CurObject.Division = Division$StatenIsland;
   ELSEIF CurObject.DivisionName = 'W' THEN
      CurObject.Division = Division$Westchester;   
   ELSE
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Invalid Division name - ' + CurObject.DivisionName;
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - SesameLockCard.ImportEmailData; Invalid Division name - ' + 
                CurObject.DivisionName);
      RETURN;
   ENDIF;

   // feeder
   IF CurObject.FeederName <> '' THEN
      SELECT :CurObject.Feeder = O.Object
      FROM   UDB_Grouping G,
             Udb_Object O
      WHERE  G.Grouping = :CurObject.Division AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$Feeder AND
             G.Member = O.Object AND
             O.Name = :CurObject.FeederName;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   // equipment
   Equip = 0;
   IF CurObject.Feeder > 0 AND CurObject.EquipName <> '' THEN
      SearchString = '%' + CurObject.EquipName;
      i = 1;
      SELECT :Equip = O.Object
      FROM   UDB_Grouping G,
             Udb_Object O
      WHERE  (G.Grouping = :CurObject.Feeder OR 
              G.Grouping IN (SELECT Member 
                             FROM   UDB_Grouping 
                             WHERE  Grouping = :CurObject.Feeder AND
                                    Relationship = :Interaction$MemberOf AND
                                    MemberType IN (:Type$ISOFeeder, :Type$PortionFeeder, :Type$SubFeeder))) AND
             G.Relationship = :Interaction$MemberOf AND
             G.Member = O.Object AND
             O.Name LIKE :SearchString
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      
      IF i = 2 THEN  // one match only
         CurObject.Equip  = Equip;
      ENDIF;
   ENDIF;

   CurObject.FormID = CALLPROC Udb_NextKey (KeyName = 'SesameLock');
   IF CurObject.FormID < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Error in creating a new form number.';
       RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RetCode = CALLPROC FMS_SesameLockCardIns(
             FormID = CurObject.FormID
            ,FormType = 0
            ,Received = CurObject.Received
            ,EnteredBy = 'EmailImport'
            ,Division = CurObject.Division       
            ,Feeder = CurObject.Feeder         
            ,Equip = CurObject.Equip
            ,ComboNo = CurObject.ComboNo          
            ,FDRAndStruct = CurObject.FDRAndStruct   
            ,Location = CurObject.Location       
            ,InstalledBy = CurObject.InstalledBy    
            ,InstallDate = CurObject.InstallDate    
            ,Supervisor = CurObject.Supervisor     
            ,ApprovalDate = CurObject.ApprovalDate   
            ,SerialNo = CurObject.SerialNo          
            ,LockNo = CurObject.LockNo            
            ,PhaseA = CurObject.PhaseA            
            ,PhaseASerial = CurObject.PhaseASerial      
            ,PhaseALock = CurObject.PhaseALock        
            ,PhaseB = CurObject.PhaseB            
            ,PhaseBSerial = CurObject.PhaseBSerial      
            ,PhaseBLock = CurObject.PhaseBLock        
            ,PhaseC = CurObject.PhaseC            
            ,PhaseCSerial = CurObject.PhaseCSerial      
            ,PhaseCLock = CurObject.PhaseCLock        
            ,NWTrans = CurObject.NWTrans  
            ,Radial = CurObject.Radial   
            ,Reactor = CurObject.Reactor  
            ,GroundSW = CurObject.GroundSW 
            ,FDRAndVault = CurObject.FDRAndVault       
            ,SesameLock = CurObject.SesameLock        
            ,UnitLocked = CurObject.UnitLocked        
            ,NeutralInstalled = CurObject.NeutralInstalled  
            ,AnodesInstalled = CurObject.AnodesInstalled   
            ,Remarks = CurObject.Remarks);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to save Lock Card data in the FMS database';
      CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Error - SesameLockCard.ImportEmailData; Failed to save Lock Card data');
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;   
END;

METHOD LoadDetail(
) = 
DECLARE

ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT CurObject.FormID = S.FormID
         ,CurObject.FormType = S.FormType
         ,CurObject.Received = S.Received
         ,CurObject.EnteredBy = S.EnteredBy
