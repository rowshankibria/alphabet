/*
**
**      Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OperatorClass_ASE
**
**  Date:       Version Description
** ----------------------------------
**  09/20/05    YSP  Created.
**  03/02/07    ysp  Add LoadByType
**  12/23/08    ehm  Load By skill for passed JobClass
**  06/17/10    ysp  use sql DISTINCT to fix duplicator operators in loadbyskill
**  03/28/13    em   Order By Name for each method
**  03/18/16    em   Include type in operator load
*/ 
METHOD Load (
   OPList = ARRAY OF OperatorClass;
   TypeOfOperator = INTEGER NOT NULL;
   Application = VARCHAR(20) NOT NULL WITH DEFAULT;
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   OPList.Clear();
   i = 1;
   SELECT  :OPList[i].Name  = Name,      
           :OPList[i].Description  = Description,
           :OPList[i].Type = Type, 
           :OPList[i].Object = Object 
   FROM    Udb_Object
   WHERE   Type IN (                   
                   SELECT  Type
                   FROM    Udb_ExtendedType
                   WHERE   SuperType = :TypeOfOperator) 
   ORDER BY Name
   BEGIN
       IF OPList[i].Object = Operator$FCR OR
          OPList[i].Object = Operator$FOD OR
          OPList[i].Object = Operator$NO9 OR
          OPList[i].Object = Operator$OpOrder THEN
          IF Application = Application$FMS THEN
             OPList[i].Electronic = 1;
             i = i + 1;
          ELSEIF Application = 'SOA' AND
             OPList[i].Object = Operator$OpOrder THEN
             OPList[i].Electronic = 1;
             i = i + 1;
          ELSE
             OPList.RemoveRow (RowNumber = i);
          ENDIF;
       ELSEIF OPList[i].Object = Operator$VerizonTA THEN
          OPList.RemoveRow (RowNumber = i);
       ELSE
          i = i + 1;
       ENDIF;
   END;
END;

METHOD LoadByType (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.OL.Clear();
   i = 1;
   SELECT :CurObject.OL[i].Name = O.Name,
          :CurObject.OL[i].Object = O.Object,
          :CurObject.OL[i].Description = O.Description
   FROM   UDB_Object O
   WHERE  O.Type = :CurObject.Type
   ORDER BY Name
   BEGIN
      i = i + 1;
   END;

   RETURN;
END;

METHOD LoadBySkill (
   JobClass    	= INTEGER NOT NULL;  /*Passed JobClass*/
) =
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Check if JobClass has a skill requirement.  If it doesn't then Return Code -1.
*/
   i = 0; 
   SELECT :i = JobClass
   FROM   FMS_JobToSkill
   WHERE  JobClass = :JobClass;
   
   IF i = 0 THEN
      RETURN -1;
   ENDIF;

   CurObject.OL.Clear();
   i = 1;
   REPEATED
   SELECT DISTINCT
          :CurObject.OL[i].Name = O.Name,
          :CurObject.OL[i].Object = O.Object,
          :CurObject.OL[i].Description = O.Description
   FROM   UDB_Object O,
          FMS_PersonToSkill PS,
          Udb_ExtendedType ET,
          FMS_JobToSkill JS
   WHERE  O.Object = PS.Operator AND
          PS.Skill = ET.SuperType AND
          ET.Type = JS.Skill AND
          JS.JobClass = :JobClass
   ORDER BY Name
   BEGIN
      i = i + 1;
   END;

   IF i = 1 THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'No Operator possesses the required skill group ' +
                               'to perform this Job.';
      RETURN -2;
   ELSE
      RETURN 0;
   ENDIF;
END;

