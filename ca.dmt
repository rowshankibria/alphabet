	Name:            PromptCutIn

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptCutIn
**
**  08/17/92  em    (ON-SITE) Set Feeder Status to RS on CutIN
**  10/22/92  em    modified per integer/udb 
**  11/09/92  em    do cutin for all cards with this equip.  relegate feeder
**                  status processing to jobclass jobactions. 
**  11/16/92  em    (ON-SITE) Set Notification button color flash here.
**  11/27/92  em    force status to RS.                                  
**  12/20/92 gjc    added window close logic to fix bug 6.
**  01/04/93  em    removed RS status setting - use jobactions to set this status.
**  02/09/93  em    Jobstatus parm added to callproc
**  04/26/94 hlf    DuplicateSeq parm added to callproc
**  04/27/94 hlf    Make CutIn time be the same as the completion time and set
**                  SOCCSX Message flag
**  05/28/94  pw    clear pfs status and update D.O. delay endtime
**  10/19/94  em    only cutin feeder if equip is source for feeder
**  11/11/94  em    use source breaker instead of source position
**  05/05/95  pw    Add check to see if hi-pot was preformed on FOT & O/A cards
**  10/17/97  jfl   Update ATS switch status when conditions are met
**  04/17/00  pkw   update 05/28/94 fix to clear any operating step status
**  10/20/00  em    Remove NOT IN from Where clause for performance reasons.
**                  Check for Barrier in Begin-End loop.
**  11/19/01  pkw   Add endtime to fms_closecardopstepupd procedure call.
**  02/01/02  pkw   Add code for CIG popups.
**  02/12/02  em    Add CutIn DBEvent for RR FCR; Restructure While LOOP
**  03/22/02  pkw   Add code for DCC popups.
**  05/03/02  pkw   Modify CSD message text.
**  05/14/02  em    Add Scheduled work on Auto card, Bus Section Outage 
**                  questions that were asked at Card close to the end of this 
**                  program.  Disabled Cancel option.
**  08/28/02  em    Add Call to Flip ATS to manage ATS statuses.
**                  Discovered that ATS FlipFlop logic already exists in partial
**                  form.  Will modify code in this frame to fill requirement.
**  11/05/02  em    Job to JIP. Close Shadow Item at CutIn time.
**  11/21/02  em    Remove expectation for return soccsx message when Pending
**                  flag is cleared.
**  12/23/02  ysp   explicit soa_logins to log card cutin update.
**  01/18/03  em    Add DBEvent to reload card header
**  02/05/03  em    Don't call CloseSwitchingItem if no switching item was
**                  found
**  02/07/03  em    In Card select, don't select cards that are already CutIn.
**  05/06/03  em    Add support for CIOA card type
**  11/10/03  ysp   Send a message to CIG if the feeder is an OEM supply feeder.
**  01/23/04  ysp   SLC 51: clear slc caution counts when closing a shadow item.
**  02/19/04  em    Converted Message to TraceError call
**  07/13/05  pkw   Add Westchester OEM message by select object
**                  type into message.
** 02/23/06   em    If we are passing in a Feeder parameter, that means
**                  the feeder is CutIn via our new Connected Source
**                  connectivity trace logic.  CutIn processing is
**                  initiated slightly differently in this case for the feeder.
** 05/23/06   pkw   Add TV Bogey logic.
** 02/20/07   pkw   Add PFS Operating step if no Operating Step found on card.
** 03/15/07   pkw   Use JIP.RSComplete when clearing operating steps.
** 04/16/07   ysp   ITC210: Insert IR interface event in DB event queue
** 05/06/08   ysp   remove common manholes shared by this feeder when feeder is cut in
** 07/08/08   pkw   Add check for ATS load feeders.
** 07/23/08   pkw   Add FOT cards to list of valid tv bogey types.
** 04/14/09   em    Add Check for KPS card to cutout with ATSLOad loop
** 04/21/09   em    Only CutOut KPS type subfeeder card. 
** 08/31/09   em    Add SF6 and FastSwitch, all KPS cards Cards cutout the same
** 06/16/10   em    Updated for 3G Feeders to not use C.Feeder
** 06/21/10   em    Update Feeder parameter to support single 3G feeder
** 11/01/10   em    Set R/S status for each feeder on 3G card.
** 11/17/10   em    For 3G, if JIP.RSComplete is NULL, look at JIP.TOComplete.
**                  If card not marked as being CutOut, don't CutIn - possible on
**                  on 3G cards that could be sourced from multiple sides.
** 05/09/11   em    Common Manhole removal for 3G.
** 05/11/11   em    Add Vacuum Switch type device to KP ISO list
** 06/20/12   pkw   Use Udb_Extendedtype when selecting ATS equipment
** 06/29/12   em    Don't distinguish between Grouper types when Restoring to normal
** 11/29/12   pkw   If cutin 13kv card and link exists to step down card then cut in 
**                  step down card if SD-VIS switch is closed.
** 12/26/12   em    Exclude ISO Feeder from Network Feeder count
** 01/17/12   em    Exclude 3G feeders that are not primary grouped to the substation
** 01/09/13   em    Remove Reference to PendingSoccsxMessage
** 02/14/13   pkw   initialize while loop variable that wasn't set.
** 08/13/13   em    Differentiate KPS Feeder and Sectional feeder by looking at specific type
** 11/26/13   pkw   Don't exclude from TV Bogey if feeder had otwr/s or HV
**                  and no fault entered.
** 02/25/16   em    If the card has more than one KPS Feeder, only one is being processed for
**                  cutout and it is not the last one.  Problem happens if SOA_ArchiveMonitor is
**                  not running. Making corredction to look at each one
** 07/14/16   em    Before deleting common manholes, make sure feeder doesn't have a Known Point ISO. 
** 10/18/16   ysp   Merge from EM: Include 33kV feeder segments when updating statuses
** 02/16/17   ysp   Use IFNULL in MsgText to avoid Null value compile warnings  
** 01/13/19   pkw   Update total outage for TV KPI if more than one fault was entered.
** 09/03/19   pkw   Send CIG notification when last feeder in network is returned to service.
** 09/06/19   ysp   Add CIG notification railroad feeder restored to service
** 11/06/19   pkw   Add mis-operation message if no known point iso was created
** 12/30/19   em	Include DMEaton in DMSF6 type list
** 02/18/20   pkw   Don't send mis-operation email for 4kv feeders or bus section outages
** 06/21/21   em    Increased message length for rail.
** 06/24/21   pkw   Don't send mis-operation email for ATSLoad feeders
*/

INITIALIZE
(
    JIP = JobInProgress;		 /* Job being processed */
    Feeder = INTEGER NOT NULL WITH DEFAULT; /* Optional; special processing */
    NoATSLoad = INTEGER NOT NULL WITH DEFAULT; /* Optional; See ATSLoad class */

    PT = Varchar(20);			/* Prompt text */
    i = INTEGER NOT NULL;       /* counter variable */  
    k = INTEGER NOT NULL;       /* counter variable */  
    n = INTEGER NOT NULL;       /* counter variable */  
    x = INTEGER NOT NULL;       /* return variable */
    ActiveSourceCards = ARRAY OF FMS_Card; /* Active cards where equip is the source*/  
    ATSList  = Array of GrouperInfo;  /*  List of ATS for current feeder */
    ATSStatus = INTEGER NOT NULL WITH DEFAULT;
    ManATSList  = Array of GrouperInfo;  /*  List of manual ATS for current feeder */
    RetCode = INTEGER NOT NULL;
    LocSwitch = INTEGER NOT NULL;
    AltSwitch = INTEGER NOT NULL;
    AltFeeder = INTEGER NOT NULL;
    AltFeederStatus = INTEGER NOT NULL;
    NormalOpen = INTEGER NOT NULL;
    CurrentlyOpen = INTEGER NOT NULL;
    CurOperatingStep = INTEGER NOT NULL;
    CutInTime = DATE;
    BarrierOnFeeder = INTEGER NOT NULL WITH DEFAULT;
    OtherCards = ARRAY OF FMS_Card; /* Other cards that are out of service */  
    m = INTEGER NOT NULL;       /* counter variable */  
    MsgTxt = Varchar(2000) NOT NULL;     /* CIG text */
    NetworkFeeders = ARRAY OF INTEGEROBJECT;
    NetWorkObject = INTEGER NOT NULL; 
    NetWorkName = VARCHAR(40) NOT NULL; 
    ControlText = Varchar(256) NOT NULL WITH DEFAULT;
    TempChar = VARCHAR(20) NOT NULL;  
    TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
    DccMsg = VARCHAR(400) NOT NULL; 
    DccRegion = VARCHAR(20) NOT NULL;
    ShadowItem = NewMoveCard;    /* Shadow Items related to a card */
    SubstationCard = INTEGER NOT NULL;  /*Related Substation Card*/
    OEMTypeName = VARCHAR(200) NOT NULL WITH DEFAULT;
    ConnectedSource = INTEGER NOT NULL WITH DEFAULT;
    OpStepCheck = INTEGER NOT NULL WITH DEFAULT;
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
    ATS = ATSLoad; 
    StepDownCard = ARRAY OF FMS_Card;
    KPSFeeder = INTEGER NOT NULL WITH DEFAULT;
    KPSCreated = INTEGER NOT NULL WITH DEFAULT;
    CheckCardOut = INTEGER NOT NULL WITH DEFAULT;
    TotFeeders = INTEGER NOT NULL WITH DEFAULT;
    RailCustomer = VARCHAR(2000) NOT NULL WITH DEFAULT;
    EmailClass = EmailNotificationClass DEFAULT NULL;
) =
DECLARE
    TV_BogeyCheck = PROCEDURE;
ENDDECLARE
BEGIN
/*
**  Initialize KPSCreated
*/
    KPSCreated = FALSE;
/*
**  Evaluate Feeder Parm - if set process single card.
*/
    IF Feeder <> 0 THEN
       ActiveSourceCards.Clear();
       BarrierOnFeeder = 0;
       SELECT  :BarrierOnFeeder = Object
       FROM    FMS_ObjectStatus
       WHERE   Object = :Feeder AND
               Status = :Status$Barrier;

       IF BarrierOnFeeder = 0 THEN
          i = 1;
          REPEATED 
          SELECT DISTINCT
             :ActiveSourceCards[i].Card = C.Card,
             :ActiveSourceCards[i].Feeder = CTO.Object,
             :ActiveSourceCards[i].FeederName = C.FeederName,
             :ActiveSourceCards[i].CutOut = C.CutOut,
             :ActiveSourceCards[i].CardClass = C.CardClass,
             :ActiveSourceCards[i].CardClassName = C.CardClassName,
             :ActiveSourceCards[i].NetworkFeeder = C.NetworkFeeder,
             :ActiveSourceCards[i].TypeOfCard = C.TypeOfCard
          FROM     FMS_Card C,
                   SOA_ActiveCard AC,
                   TFMS_CardToObject CTO
          WHERE    AC.Card = C.Card AND
                   C.CutIn IS NULL AND
                   C.CutOut IS NOT NULL AND
                   C.Card = CTO.Card AND
                   CTO.Object = :Feeder;
       ENDIF;
 
       IF ActiveSourceCards.LastRow() = 0 THEN
          RETURN (PU_OK);
       ENDIF;
  
    ELSE
/*
**  Select all active cards where the equipment is the source for the feeder,
**  don't include feeders that have a Barrier status.
*/  
       i = 1;
       REPEATED 
       SELECT DISTINCT 
             :ActiveSourceCards[i].Card = C.Card,
             :ActiveSourceCards[i].Feeder = G.Grouping,
             :ActiveSourceCards[i].FeederName = C.FeederName,
             :ActiveSourceCards[i].CutOut = C.CutOut,
             :ActiveSourceCards[i].CardClass = C.CardClass,
             :ActiveSourceCards[i].CardClassName = C.CardClassName,
             :ActiveSourceCards[i].NetworkFeeder = C.NetworkFeeder,
             :ActiveSourceCards[i].TypeOfCard = C.TypeOfCard
       FROM     FMS_Card C,
                SOA_ActiveCard AC,
                TFMS_CardToObject CTO,
                Udb_Grouping G
       WHERE    AC.Card = C.Card AND
                C.CutIn IS NULL AND
                C.CutOut IS NOT NULL AND
                C.Card = CTO.Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$SourceBreaker AND
                G.Member = :JIP.Equip 
       BEGIN
           BarrierOnFeeder = 0;
           REPEATED
           SELECT  :BarrierOnFeeder = Object
           FROM    FMS_ObjectStatus
           WHERE   Object = :ActiveSourceCards[i].Feeder AND
                   Status = :Status$Barrier;
/*
** Don't process CutIn for this feeder if ConnectedSource flag is set.
*/
           ConnectedSource = 0;
           SELECT :ConnectedSource = Feeder
           FROM   FMS_ConnectedSource
           WHERE  Feeder = :ActiveSourceCards[i].Feeder;

           IF BarrierOnFeeder = 0 AND ConnectedSource = 0 THEN
              i = i + 1;
           ELSE   /* remove feeders that have the barrier on it */
              ActiveSourceCards.RemoveRow (rownumber = i);
           ENDIF;
       END;
    ENDIF;
/*
**  Remove 4kv cards that have related 13kv card that is still out of service.
*/
    i = 1;
    WHILE i <= ActiveSourceCards.LastRow DO
       IF ActiveSourceCards[i].TypeOfCard = TypeOfCard$4KV THEN
          /*
          **  Check to see if current 4KV feeder has a Step Down Link. If
          **  yes then look to see if 13kv card is out of service. If
          **  13kv card in out of service then remove this row from 
          **  ActiveSourceCards.
          */
          CheckCardOut = 0;
          SELECT :CheckCardOut = COUNT(*)
          FROM    FMS_StepDownLink L,
                  FMS_Card C
          WHERE   L.StepDownCard = :ActiveSourceCards[i].Card AND
                  L.Card = C.Card AND
                  C.Cutout IS NOT NULL AND
                  C.Cutin IS NULL;
          IF CheckCardOut <> 0 THEN
             ActiveSourceCards.RemoveRow (RowNumber = i);
          ELSE
             i = i + 1;
          ENDIF;
       ELSE
          i = 1 + 1;
       ENDIF;   
    ENDWHILE;

/*
**  First while loop performs critical functions which will cause move
**  to be undone if any fail.
**  Set cutout date and feeder status for each card.
*/
    i = 1;
    WHILE i <= ActiveSourceCards.Lastrow() DO
    
        NetworkFeeders.Clear();
        CutInTime = JIP.RSComplete;
        IF ActiveSourceCards[i].NetworkFeeder > 0 THEN
           n = 1;
           SELECT :NetworkFeeders[n].Value = CTO.Object
           FROM   TFMS_CardToObject CTO, 
                  Udb_ExtendedType ET 
           WHERE  CTO.Card = :ActiveSourceCards[i].Card AND
                  CTO.Type = ET.Type AND
                  ET.SuperType = :Type$Feeder
           BEGIN
              IF ActiveSourceCards[i].NetworkFeeder = NetworkFeeder$33kV THEN
/*
** Ignore feeder segment fed by another
*/
                 m = 0;    
                 SELECT :m = G.Relationship
                 FROM   Udb_Grouping G
                 WHERE  G.Member = :NetworkFeeders[n].Value AND
                        G.Relationship = :Interaction$FedBy;
                 IF m = Interaction$FedBy THEN
                    NetworkFeeders.RemoveRow (rownumber = n);
                    n = n - 1;
                 ENDIF;
              ENDIF;
              n = n + 1;
           END;
/*
** On a 3G Feeder, it may be possible that CutIn is occurring as result of closing
** a 3G switch at TakeOut completion.
*/
           IF JIP.RSComplete IS NULL THEN
              IF JIP.TOComplete IS NOT NULL THEN
                 CutInTime = JIP.TOComplete;
              ENDIF;
           ENDIF;
        ELSE
           NetworkFeeders[1].Value = ActiveSourceCards[i].Feeder;
        ENDIF;

        FOR n = 1 TO NetworkFeeders.LastRow() DO     
           x = CALLPROC ForceStatus (
                Feeder = NetworkFeeders[n].Value,
                NewStatus = Status$RS );
 
           IF x = PU_CANCEL THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
                       'ERROR: Unable to set RS Feeder Status.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Unable to set RS Feeder Status for ' +
                       ActiveSourceCards[i].FeederName + '.'
                                 );
            RETURN (PU_CANCEL);
           ENDIF;
        ENDFOR;
  
        x = CALLPROC FMS_CardCut (
                CutIn  = CutInTime,
                CutOut = ActiveSourceCards[i].CutOut,
                Card = ActiveSourceCards[i].Card );
        IF (x <> 0) THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
                       'ERROR: Unable to set Card CutIn time.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Unable to set Card CutIn time for ' +
                       ActiveSourceCards[i].FeederName + '.'
                                 );
            RETURN (PU_CANCEL);
        ELSE
            CALLPROC SOA_LogIns (
                 Card = ActiveSourceCards[i].Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'CutIn',
                 Old  = NULL,
                 New  = IFNULL(CutInTime,''));
        ENDIF;
        /*
        **  If OA/CIOA, we need to determine if this should be a  
        **  Temperature Variable Bogey outage.  
        */
        IF ActiveSourceCards[i].CardClass = Type$Auto OR
           ActiveSourceCards[i].CardClass = Type$CIOA OR
           ActiveSourceCards[i].CardClass = Type$FOT THEN
           CALLPROC TV_BogeyCheck(Card = ActiveSourceCards[i].Card,
                                  CutOut = ActiveSourceCards[i].CutOut);
        ENDIF;
        
        i = i + 1;
    ENDWHILE; 
    CALLPROC DDB_COMMIT;
/*
** Second while LOOP produces Warning messages only if any non-critical
** function fails.
*/
    i = 1;
    WHILE i <= ActiveSourceCards.Lastrow() DO
/*
** Raise DBEvent when all card types are cutin except 'TEST'
*/
        IF ActiveSourceCards[i].CardClass <> Type$CardClassTest THEN
            ControlText = VARCHAR(ActiveSourceCards[i].Card);
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_CutInFeeder',
                     EventText = ControlText);  
        ENDIF;
        CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ReloadCardHeader',
                                  DBEventText = ControlText);
        CALLPROC DDB_COMMIT;
/*
** Close Related Shadow Item
*/
         ShadowItem.SwitchingItem = 0;
         REPEATED 
         SELECT   :ShadowItem.Card = JC.Card, 
                  :ShadowItem.SwitchingItem = JC.Job
         FROM     SOA_Job J,
                  SOA_JobControl JC,
                  SOA_ActiveObject AO1,
                  SOA_ActiveObject AO2
         WHERE    AO1.Card = :ActiveSourceCards[i].Card AND
                  AO1.ObjectToCardLink = 0 AND  /*Would be a Substation*/
                  AO1.Object = AO2.Object AND
                  AO2.ObjectToCardLink = 1 AND  /*Primary Substation Card*/
                  AO2.Card = JC.Card AND
                  JC.Job = J.Job AND
                  J.ShadowLink = :ActiveSourceCards[i].Card AND
                  J.MoveCategory = :MoveCategory$SwitchingItem AND
                  J.RSComplete IS NULL;

        IF ShadowItem.SwitchingItem <> 0 THEN
           RetCode = CALLPROC ClearSLCCautions(
                         SwitchingItem = ShadowItem.SwitchingItem);

           RetCode = CALLPROC SOA_CloseSwitchItem (
                         SwitchingItem = ShadowItem.SwitchingItem,
                                       ClosureTime = DATE('now'),
                                       ClosureStatus = Card$Closed,
                                       ClosureRemark = 'Closed');

           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage =
                       'WARNING: Unable to successfully close a substation ' +
                       'shadow item.  Have tech support review trace log.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Unable to close a shadow item=' +
                       VARCHAR(ShadowItem.SwitchingItem) + '.'
                                 );
           ELSE
              CALLPROC DDB_COMMIT;
              ControlText = Application$SLC + ';' + VARCHAR(ShadowItem.Card) +
                     ';' + VARCHAR(ShadowItem.SwitchingItem) + ';';
              CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_ArchiveTrigger', 
                                          DBEventText = ControlText); 
              CALLPROC DDB_COMMIT;
              
           ENDIF;
        ENDIF;
        /*
        **  See if card has any Operating Steps on it.
        */ 
        OpStepCheck = 0;
        SELECT :OpStepCheck = COUNT(*) 
        FROM    FMS_OperatingStepStatus O,
                Udb_SuperType S
        WHERE   O.Card = :ActiveSourceCards[i].Card AND
                O.OperatingStep = S.Type AND
                S.SuperType = :Type$OperatingStepStatus;
         
        IF OpStepCheck = 0 THEN
           /*
           **  Insert PFS Operating Step
           */
           IF SimpleStep IS NULL THEN
              SimpleStep = OperatingStep_ASE.Create();
           ENDIF;    
           SimpleStep.SO.BaseType = ActiveSourceCards[i].CardClass;
           SimpleStep.SO.Object   = ActiveSourceCards[i].Card;
           SimpleStep.SO.Name     = ActiveSourceCards[i].CardClassName;
           SimpleStep.SO.Type     = ActiveSourceCards[i].Feeder;
           SimpleStep.SO.TypeName = ActiveSourceCards[i].FeederName;
           SimpleStep.OpStep      = Type$PFS; 
           SimpleStep.StartTime   = IFNULL(ActiveSourceCards[i].Cutout,'');
           SimpleStep.Job         = 0;

           SimpleStep.SetOpStep();
           IF SimpleStep.ReturnCode <> 0 THEN
              CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                 TraceMessage =
                  'Prompt:CutIn; ' +
                  'Error setting PFS Operating Step. ' +
                  'Card=' + VARCHAR(ActiveSourceCards[i].Card) +
                  ';Status=' + VARCHAR(Type$PFS) + '.'
                  );
           ENDIF;            
        ENDIF;
        /*
        **  End all operatingsteps and delays at this time.  
        */
        RetCode = CALLPROC FMS_CloseCardOpStepUpd ( 
                                        Card = ActiveSourceCards[i].Card,
                                        EndTime = IFNULL(CutInTime,''));
       
        IF (RetCode <> 0) THEN
           CALLPROC DDB_ROLLBACK;
           CALLPROC TraceError (UserMessage =
                   'WARNING: Unable to successfully complete all card ' +
                   'operating steps.  Have tech support review trace log.',
                              TraceMessage =
                   'PromptCutIn: ' +
                   'Unable to complete all operating steps for card=' +
                   VARCHAR(ActiveSourceCards[i].Card) + '.'
                             );
        ENDIF;        
        CALLPROC DDB_COMMIT;

        IF ActiveSourceCards[i].CardClass = Type$FOT   OR
           ActiveSourceCards[i].CardClass = Type$Auto  OR
           ActiveSourceCards[i].CardClass = Type$CIOA  THEN
            x = 0;
            SELECT :x = count(*)
            FROM   FMS_HighPotHistory HP
            WHERE  HP.Card = :ActiveSourceCards[i].Card;
            IF x = 0 THEN
               x = CALLPROC FMS_WaivedHiPotIns(
                             Feeder = ActiveSourceCards[i].Feeder,
                             FeederName = ActiveSourceCards[i].FeederName,
                             CardType = ActiveSourceCards[i].CardClassName,
                             CutOut = IFNULL(ActiveSourceCards[i].CutOut,''),
                             CutIn = IFNULL(CutInTime,''),
                             Increment = 1);
               IF x < 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   CALLPROC TraceError (UserMessage =
                       'WARNING: Unable to record waived hi pot information.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Unable to record waived hi pot information for card=' +
                       VARCHAR(ActiveSourceCards[i].FeederName) + '.'
                                 );
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
        ENDIF;
/*
**  Send CSD message to CIG if condition exists
*/
        IF date_part('min',CutInTime) < 10 THEN
           TempChar = '0';
        ELSE
           TempChar = '';
        ENDIF;

        /* See if feeder part of network, feeder must be primary grouped to a substation */
        NetWorkObject = 0;
        REPEATED
        SELECT :NetWorkName = O.Name,
               :NetWorkObject = O.Object
        FROM   UDB_OBJECT O,      /*Network*/
               UDB_GROUPING G,
               Udb_Object O2,     /*Feeder*/
               Udb_Object O3      /*Feeder Primary Grouping = Substation?*/
        WHERE  G.Member = :ActiveSourceCards[i].Feeder and
               G.Relationship = :Interaction$MemberOf and
               G.GroupingType = :Type$Network and
               O.Object = G.Grouping AND               
               O2.Object = G.Member AND
               O2.PrimaryGrouping = O3.Object AND
               O3.Type IN (SELECT Type FROM Udb_ExtendedType 
                           WHERE  SuperType = :Type$Substation);
            
        IF NetworkObject <> 0 THEN
           /* Get the names of other feeders that are out, only ones that are primary grouped to substation */
           m = 1;
           OtherCards.Clear();
           SELECT :OtherCards[m].FeederName = O.Name,
                  :OtherCards[m].CardClassName = C.CardClassName,
                  :OtherCards[m].CutOut = C.Cutout
           FROM   Udb_Object O,      /*Feeder*/
                  Udb_Object O2,     /*Feeder Primary Grouping = Substation?*/
                  Udb_Grouping G,
                  FMS_Card C,
                  TFMS_CardToObject CTO
           WHERE  G.Grouping = :NetWorkObject AND
                  G.Relationship= :Interaction$MemberOf AND
                  G.MemberType = :Type$Feeder AND
                  G.Member = CTO.Object AND
                  CTO.Card = C.Card AND
                  C.Status < :Card$Closed AND
                  C.Card <> :ActiveSourceCards[i].Card AND
                  C.Cutout IS NOT NULL AND C.Cutin IS NULL AND
                  CTO.Object = O.Object AND
                  O.PrimaryGrouping = O2.Object AND
                  O2.Type IN (SELECT Type FROM Udb_ExtendedType 
                               WHERE  SuperType = :Type$Substation)
           BEGIN
              IF date_part('min',OtherCards[m].CutOut) < 10 THEN
                 OtherCards[m].Position = '0';
              ELSE
                 OtherCards[m].Position = '';
              ENDIF;
              
              m = m + 1;
           END;
             
           /* Get number of feeders in Network that are primary grouped to substation */
           TotFeeders = 0;
           SELECT :TotFeeders = COUNT(*) 
           FROM   Udb_Object O,      /*Feeder*/
                  Udb_Object O2,     /*Feeder Primary Grouping = Substation?*/
                  Udb_Grouping G
           WHERE  G.Grouping = :NetWorkObject AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$Feeder AND
                  G.Member = O.Object AND
                  O.PrimaryGrouping = O2.Object AND
                  O2.Type IN (SELECT Type FROM Udb_ExtendedType 
                              WHERE  SuperType = :Type$Substation);
                              
           IF OtherCards.LastRow() <> 0 THEN
           
              MsgTxt = VARCHAR(OtherCards.LastRow()) + ' of ' + VARCHAR(TotFeeders) + 
                        ' Feeders in ' + NetworkName + ' are out. Feeder ' + 
                        ActiveSourceCards[i].FeederName +
                        ' was returned to service at ' +                               
                         VARCHAR(date_part('month',IFNULL(CutInTime,''))) + '/' +
                         VARCHAR(date_part('day',IFNULL(CutInTime,''))) + ' ' +
                         VARCHAR(date_part('Hour',IFNULL(CutInTime,''))) + ':' + TempChar + 
                         VARCHAR(date_part('min',IFNULL(CutInTime,''))) + 
                        '. Other feeders that are out: ';
              FOR m = 1 to OtherCards.LastRow() DO
                 MsgTxt = MsgTxt + '(' + OtherCards[m].FeederName + '-' +
                                   OtherCards[m].CardClassName + '-' + 
                                   VARCHAR(date_part('month',IFNULL(OtherCards[m].Cutout, ''))) + '/' +
                                   VARCHAR(date_part('day',IFNULL(OtherCards[m].Cutout, ''))) + ' ' +
                                   VARCHAR(date_part('Hour',IFNULL(OtherCards[m].Cutout, ''))) + ':' + 
                                   OtherCards[m].Position + 
                                   VARCHAR(date_part('min',IFNULL(OtherCards[m].Cutout, ''))) + ') ';
              ENDFOR;
/*
**  Send message to CIG 
*/            
              RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                         ,MessageText = MsgTxt
                         ,Time = date('now')
                         ,Priority = 0
                         ,MessageType = 0
                         ,Card = ActiveSourceCards[i].Card);
              IF RetCode <> 0 THEN
                 CALLPROC DDB_ROLLBACK;
                 CALLPROC TraceError (UserMessage =
                       'WARNING: Could not send automated message to CIG. ' +
                       'Please contact CIG verbally to inform them of ' +
                       'network contingency status.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Could not send automated message to CIG ' +
                       'regarding network contingency status.'
                                 );
              ENDIF;
              CALLPROC DDB_COMMIT;
           ELSE
              /*
              **  See if this was part of a multiple feeder outage.  If it was send message to CIG 
              **  letting them know all feeders are now back.  
              */
              m = 0;
              SELECT :m = COUNT(*) 
              FROM   FMS_NetworkOutage N
              WHERE  N.Network = :NetWorkObject;
              IF m <> 0 THEN
                 /* This was part of a multifeeder outage */
                 MsgTxt = VARCHAR(OtherCards.LastRow()) + ' of ' + VARCHAR(TotFeeders) + 
                        ' Feeders in ' + NetworkName + ' are out. Feeder ' + 
                        ActiveSourceCards[i].FeederName +
                        ' was returned to service at ' +                               
                         VARCHAR(date_part('month',IFNULL(CutInTime,''))) + '/' +
                         VARCHAR(date_part('day',IFNULL(CutInTime,''))) + ' ' +
                         VARCHAR(date_part('Hour',IFNULL(CutInTime,''))) + ':' + TempChar + 
                         VARCHAR(date_part('min',IFNULL(CutInTime,'')));
                 /*
                 **  Send message to CIG 
                 */            
                 RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                         ,MessageText = MsgTxt
                         ,Time = date('now')
                         ,Priority = 0
                         ,MessageType = 0
                         ,Card = ActiveSourceCards[i].Card);
                 IF RetCode <> 0 THEN
                    CALLPROC DDB_ROLLBACK;
                    CALLPROC TraceError (UserMessage =
                       'WARNING: Could not send automated message to CIG. ' +
                       'Please contact CIG verbally to inform them of ' +
                       'network status.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Could not send automated message to CIG ' +
                       'regarding network status.'
                                 );
                 ENDIF;
                 CALLPROC DDB_COMMIT;
                 /*
                 **  Remove row from fms_networkoutage table
                 */
                 RetCode = CALLPROC FMS_NetworkOutageDel(Network = NetworkObject);
                 IF RetCode <> 0 THEN
                    CALLPROC DDB_ROLLBACK;
                    CALLPROC TraceError (UserMessage =
                       'WARNING: Could not clear network outage table.  Please inform staff to remove ' +
                       varchar(NetworkObject) + ' from the fms_networkobject table.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Could not clear network outage table.  Please remove ' +
                       varchar(NetworkObject) + ' from the fms_networkobject table.'
                                 );
                 ENDIF;
                 CALLPROC DDB_COMMIT;
                 
              ENDIF;
           ENDIF;
        ENDIF;
        
/*
**  Send a message to EDCC to notify of cutout.
*/
        DccMsg = 'Feeder ' + ActiveSourceCards[i].FeederName + ' cutin at ' + 
                      VARCHAR(date_part('month',IFNULL(CutInTime,''))) + '/' +
                      VARCHAR(date_part('day',IFNULL(CutInTime,''))) + ' ' +
                      VARCHAR(date_part('Hour',IFNULL(CutInTime,''))) + ':' + TempChar +
                      VARCHAR(date_part('min',IFNULL(CutInTime,'')));
        /*
        **  Determine which regions to send message.
        */
        DccRegion = '';
        /* shift 1 char to get rid of d in division user. */
        SELECT DISTINCT
               :DccRegion = shift(O.Name,-1)
        FROM    Udb_Object O,
                Udb_Grouping G,
                Udb_Grouping GG
        WHERE   G.Member = :ActiveSourceCards[i].Feeder AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Division AND
                G.Grouping = GG.Member AND
                GG.Relationship = :Interaction$MemberOf AND
                GG.GroupingType = :Type$Region AND
                GG.Grouping = O.Object
        BEGIN
           RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                            ,MessageText = DccMsg
                                            ,Time = date('now')
                                            ,Priority = 0
                                            ,MessageType = 0
                                            ,Card = ActiveSourceCards[i].Card);
           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage = '',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Failure sending automated DCC message for Feeder ' +
                       VARCHAR(ActiveSourceCards[i].FeederName) + 
                       ' regarding ' + DccMsg
                                 );
           ENDIF;
           CALLPROC DDB_COMMIT;
        END;  
                
/*
**  Send a message to CIG if the feeder is an OEM supply feeder.
*/
        OEMTypeName = '';
        REPEATED
        SELECT :OEMTypeName = O.Description
        FROM   UDB_GROUPING G,
               Udb_Object O
        WHERE  G.Member = :ActiveSourceCards[i].Feeder and
               G.Relationship = :Interaction$MemberOf and
               G.GroupingType = :Type$OEMFeeder AND
               G.Grouping = O.Object;
        IF OEMTypeName <> '' THEN
           MsgTxt = OEMTypeName + ' ' + ActiveSourceCards[i].FeederName + 
                    ' cutin at ' + 
                    VARCHAR(date_part('month',IFNULL(CutInTime,''))) + '/' +
                    VARCHAR(date_part('day',IFNULL(CutInTime,''))) + ' ' +
                    VARCHAR(date_part('Hour',IFNULL(CutInTime,''))) + ':' + TempChar +
                    VARCHAR(date_part('min',IFNULL(CutInTime,'')));

           RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = ActiveSourceCards[i].Card);
           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (UserMessage =
                       'WARNING: Could not send automated message to CIG. ' +
                       'Please contact CIG verbally to inform them that ' +
                       'OEM supply feeder is cutin.',
                                 TraceMessage =
                       'PromptCutIn: ' +
                       'Could not send automated message to CIG ' +
                       'informing them OEM supply feeder is cutin.'
                                 );
           ENDIF;
           CALLPROC DDB_COMMIT;
        ENDIF;
        
/*
** if a feeder supplies MTA, LIRR, MetroNorth or Amtrack
*/
        RailCustomer = '';
        SELECT DISTINCT 
              :TempName = O.Name
        FROM   UDB_Grouping G1,
              UDB_Grouping G2,
              UDB_ExtendedType ET,
              UDB_Object O
        WHERE  G1.Grouping = :ActiveSourceCards[i].Feeder AND 
              G1.RelationShip = :Interaction$MemberOf AND 
              G1.MemberType = ET.Type AND 
              ET.SuperType = :Type$HTVStd AND
              G1.Member = G2.Member AND
              G2.RelationShip = :Interaction$MemberOf AND 
              G2.GroupingType = :Type$MTALine AND           // 10475
              G2.Grouping = O.Object
        ORDER BY Name
        BEGIN
           IF RailCustomer <> '' THEN
              RailCustomer = RailCustomer + ', ';
           ENDIF;
           RailCustomer = RailCustomer + TempName;
        END;
        CALLPROC DDB_ROLLBACK;
        
        IF RailCustomer <> '' THEN
           RailCustomer = 'subway ' + RailCustomer;   
        ELSE
           SELECT DISTINCT 
                 :TempName = UPPERCASE(O.Description)
           FROM   UDB_Grouping G,
                 UDB_Object O
           WHERE  G.Grouping = :ActiveSourceCards[i].Feeder AND 
                 G.RelationShip = :Interaction$MemberOf AND 
                 G.Member = O.Object AND 
                 (UPPERCASE(O.Description) LIKE '%LIRR%' OR
                 UPPERCASE(O.Description) LIKE '%METRO NO%' OR
                 UPPERCASE(O.Description) LIKE '%AMTRACK%')
           BEGIN
              IF TempName LIKE '%LIRR%' THEN
                 RailCustomer = 'LIRR';
              ELSEIF TempName LIKE '%METRO%' THEN
                 RailCustomer = 'Metro North';
              ELSEIF TempName LIKE '%AMTRACK%' THEN
                 RailCustomer = 'Amtrack';
              ENDIF;
           END;
        ENDIF;
        
        IF RailCustomer <> '' THEN
           MsgTxt = 'Feeder ' + ActiveSourceCards[i].FeederName + ' supplying ' + RailCustomer +
                    ' restored to service at ' + 
                    VARCHAR(date_part('month',IFNULL(CutInTime,''))) + '/' +
                    VARCHAR(date_part('day',IFNULL(CutInTime,''))) + ' ' +
                    VARCHAR(date_part('Hour',IFNULL(CutInTime,''))) + ':' + TempChar +
                    VARCHAR(date_part('min',IFNULL(CutInTime,'')));
        
           RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = ActiveSourceCards[i].Card);
        
           IF RetCode <> 0 THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (
                          UserMessage = 'ERROR: Could not send automated ' +
                       'message to CIG.  Please contact CIG verbally to let ' +
                       'them know feeder ' + ActiveSourceCards[i].FeederName + ' supplying ' + RailCustomer + ' is cutin.',
                          TraceMessage = 'Could not send automated cutin message to CIG for ' +
                       'feeder supplying railroad customer.' 
                       );
           ENDIF;
           CALLPROC DDB_COMMIT;
        ENDIF;        

        FCFrame.SendUSerEvent (EventName = 'SetNotifications');
/*
** Delete all messages from the FMS_SOCCSXMESSAGE table
*/
        RetCode = CALLPROC FMS_SoccsxMessageDel
                        ( UserName = UserName );
        CALLPROC DDB_COMMIT;
/*
** Set ATS CurrentlyOpen status to Close for local switches 
** and to Open for the other switch when one of 
** the following conditions are met:
** - ATS is in automatic mode + 
**   the other feeder is Out of service
** - ATS is not in manual mode +
**   the other feeder is In service + 
**   this is a regular ATS (non Parallel) +
**   the switch on the feeder to be cutin is open 
**   and normally closed
*/
/*
** Determine list of ATS
*/
        ATSList.Clear();
        x = 1;
        REPEATED 
        SELECT DISTINCT
          :ATSList[x].GrouperID = G.Member,
          :ATSList[x].GrouperName = O.Name,
          :ATSList[x].GrouperType = G.MemberType 
        FROM  Udb_Grouping G,
          Udb_Object O
        WHERE G.Grouping = :ActiveSourceCards[i].Feeder 
          AND G.RelationShip = :Interaction$MemberOf  
          AND G.MemberType IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$ATSGrouper)
          AND G.Member = O.Object
        BEGIN
           ATSStatus = 0;
           SELECT :ATSStatus = Status
           FROM   FMS_ObjectStatus 
           WHERE  Object = :ATSList[x].GrouperID AND
                  Status = :Status$ATSManual;
           IF ATSStatus = Status$ATSManual THEN
              ATSList.RemoveRow (RowNumber = x);
           ELSE 
              x = x + 1;
           ENDIF;    
        END;
/*
** For each Auto ATS, check status of local supplying switch
*/ 
        FOR x = 1 TO ATSList.LastRow() DO
        /*
        ** Identify ATS supplying switch on current feeder
        */
            LocSwitch = 0;
            REPEATED
            SELECT 
              :LocSwitch = G1.Member,
              :NormalOpen = S.NormalOpen,
              :CurrentlyOpen = S.CurrentlyOpen
            FROM Udb_Grouping G1,
              Udb_Grouping G2,
              Udb_Switch S
            WHERE G1.Grouping = :ATSList[x].GrouperID 
              AND G1.RelationShip = :Interaction$MemberOf
              AND G1.Member = G2.Member
              AND G1.MemberType IN (SELECT Type
                                FROM Udb_ExtendedType
                                WHERE SuperType = :Type$ATSSupply)
              AND G2.Grouping = :ActiveSourceCards[i].Feeder
              AND G2.RelationShip = :Interaction$MemberOf
          AND S.Object = G1.Member;

        /*
        ** Identify alternate feeder and ATS switch
        */
        IF LocSwitch <> 0 THEN
            AltSwitch = 0;
            AltFeeder = 0;
            REPEATED
            SELECT
                :AltSwitch = G1.Member,
                :AltFeeder = G2.Grouping
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :ATSList[x].GrouperID 
              AND G1.RelationShip = :Interaction$MemberOf
              AND G1.Member = G2.Member
              AND G1.MemberType IN (SELECT Type
                                    FROM Udb_ExtendedType
                                    WHERE SuperType = :Type$ATSSupply)
              AND G2.Grouping <> :ActiveSourceCards[i].Feeder
              AND G2.GroupingType IN (SELECT Type 
                                      FROM Udb_ExtendedType
                                      WHERE SuperType = :Type$Feeder)
              AND G2.RelationShip = :Interaction$MemberOf;

            IF AltSwitch <> 0 AND AltFeeder <> 0 THEN
                /*
                ** Get the status of the alternate feeder
                */
                AltFeederstatus = 1;
                REPEATED
                SELECT :AltFeederStatus = 0
                FROM  FMS_ObjectStatus OS
                WHERE OS.Object = :AltFeeder
                  AND OS.Status = :Status$CO; 
                /*
                ** Change switch status for local and alternate
                ** supplying switches when the conditions are met 
                */
                IF AltFeederStatus = 0 OR
                   (AltFeederStatus = 1 AND NormalOpen = 0) THEN
/* Removed 6/29/12    
                    AND (ATSList[x].GrouperType = Type$ATS 
                      OR ATSList[x].GrouperType = Type$ATSU)) THEN 
*/
/*
** Flip the statuses
*/                  
                   RetCode = CALLPROC SetStatus (Object = LocSwitch,
                                                Status = Status$Closed);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = LocSwitch,
                                                Status = Status$Open);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC SetStatus (Object = AltSwitch,
                                                Status = Status$Open);
                   IF RetCode = PU_CANCEL THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC FMS_ObjStatDel(Object = AltSwitch,
                                                Status = Status$Closed);
                   IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = LocSwitch,
                                           CurrentlyOpen = 0); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to clear ATS switch status for ATS ' +
                          ATSList[i].GrouperName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to clear ATS switch ' +
                          'status for ATS ' + ATSList[i].GrouperName + '.'
                            );
                   ENDIF;

                   RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = AltSwitch,
                                           CurrentlyOpen = 1); 
                   IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to set ATS switch status for ATS ' +
                          ATSList[i].GrouperName + '. Try again.',
                              TraceMessage = 
                          'PromptCutIn: ' +
                          'Unable to set ATS switch ' +
                          'status for ATS ' + ATSList[i].GrouperName + '.'
                           );
                   ENDIF;
                   CALLPROC DDB_COMMIT;
                ENDIF;
             ENDIF;
           ENDIF;
         ENDFOR; 

        CALLFRAME RecordCardForReportFilter (Card = ActiveSourceCards[i].Card);
/*
** remove common manholes shared by this feeder
*/
        NetworkFeeders.Clear();
        IF ActiveSourceCards[i].NetworkFeeder = TRUE THEN
           n = 1;
           SELECT :NetworkFeeders[n].Value = Object
           FROM   TFMS_CardToObject 
           WHERE  Card = :ActiveSourceCards[i].Card AND
                  Type = :Type$Feeder
           BEGIN
              n = n + 1;
           END;
        ELSE
           NetworkFeeders[1].Value = ActiveSourceCards[i].Feeder;
        ENDIF;

        FOR n = 1 TO NetworkFeeders.LastRow() DO     
/*
** Don't delete if Known Point ISO is associated to this feeder.
*/
           KPSFeeder = 0;
           SELECT :KPSFeeder = COUNT(*) 
           FROM   Udb_Grouping 
           WHERE  Grouping = :NetworkFeeders[n].Value AND
                  Relationship = :Interaction$MemberOf AND
                  MemberType = :Type$KPSFeeder;

           IF KPSFeeder > 0 THEN
              CONTINUE;
           ENDIF;

           RetCode = CALLPROC FMS_CommonManholeDel(Feeder = NetworkFeeders[n].Value);
           IF RetCode  <> 0 THEN
              CurFrame.Trace(Text = varchar(Date('now')) + ': PromptCutIn; Card ' + VARCHAR(ActiveSourceCards[i].Card) + 
                              ' is CutIn. Failed to delete common manholes.');
              CALLPROC DDB_ROLLBACK;
           ENDIF;
        ENDFOR;
        CALLPROC DDB_COMMIT;

        i = i + 1;
    ENDWHILE;
/*
**  Check to see if any ATS load feeders should be cutout.
**  Check to see if any KPS ISO should be cutout.
*/
    FOR x = 1 TO ActiveSourceCards.LastRow DO
       IF NoATSLoad = FALSE THEN
          ATS.CheckATSLoad(Object = ActiveSourceCards[x].Feeder,
                           IsFeeder = TRUE);
       ENDIF;
/*
**  Modified in case there is more than one KPSFeeder found
*/        
       KPSFeeder = 0;
       REPEATED
       SELECT :KPSFeeder = G.Member
       FROM   Udb_Grouping G,
              Udb_Grouping G2
       WHERE  G.Grouping = :ActiveSourceCards[x].Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType = :Type$KPSFeeder AND
              G.Member = G2.Grouping AND
              G2.Relationship = :Interaction$SourceBreaker AND
              G2.MemberType IN (SELECT Type FROM Udb_ExtendedType 
                                WHERE SuperType IN (
                                   :Type$DMSF6, :Type$DMEaton, :Type$FastSw, :Type$KPS, :Type$DMVac))
       BEGIN
          IF KPSFeeder <> 0 THEN 
             CALLFRAME PromptCutOut (JIP = JIP,
                                 Feeder = KPSFeeder,
                                 KPSFeeder = TRUE);
             KPSCreated = TRUE;
          ENDIF;
       END;
    ENDFOR;
/*
**  For each card look to see if there is a link to Step Down 4kv feeder.
**  If there is, then cutout that feeder also.
*/
    FOR i = 1 to ActiveSourceCards.LastRow DO
       IF ActiveSourceCards[i].TypeOfCard <> TypeOfCard$4KV THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other linked cards
          **  and confirm Isolation is complete for all cards.
          */
          k = 1;
          StepDownCard.Clear();
          SELECT DISTINCT
                 :StepDownCard[k].Feeder = CTO.Object
          FROM    FMS_StepDownLink L,
                  Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   L.Card = :ActiveSourceCards[i].Card AND
                  L.StepDownCard = CTO.Card AND
                  CTO.Object = G.Grouping AND
                  G.GroupingType = :Type$Feeder AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0
          BEGIN
             k = k + 1;
          END;
          FOR k = 1 TO StepDownCard.LastRow DO
             CALLFRAME PromptCutIn(Feeder = StepDownCard[k].Feeder,
                                   JIP = JIP);     
          ENDFOR;	
       ENDIF;    
    ENDFOR;
    /*
    **  Send message for potential Distribution Feeder Mis-Operation
    **  Ignore ATSLoad feeders too
    */
    IF KPSCreated = FALSE THEN
       FOR i = 1 TO ActiveSourceCards.LastRow DO
          IF ActiveSourceCards[i].TypeOfCard <> TypeOfCard$4KV AND
             ActiveSourceCards[i].TypeOfCard <> TypeOfCard$ATSLoad AND
            (ActiveSourceCards[i].CardClass = Type$Auto OR
             ActiveSourceCards[i].CardClass = Type$CIOA) THEN
             /*
             **  Look for fault 
             */
             x = 0;
             SELECT :x = COUNT(*)
             FROM    FMS_Fault 
             WHERE   Card = :ActiveSourceCards[i].Card;

             IF x = 0 THEN
                /*
                **  No fault info entered. Check for OTWR/S or EST step.
                **  Would like to look if HV was applied to feeder but
                **  HV is a Feeder Status that gets removed once move is 
                **  completed so look for EST which gets set at same time.
                */
                SELECT :x = COUNT(*)
                FROM    FMS_OperatingStepStatus
                WHERE   Card = :ActiveSourceCards[i].Card AND
                        OperatingStep IN (:Type$OTWR,:Type$OTWS,:Type$EST);
                IF x = 0 THEN
                   /*
                   **  Check to see if feeder is part of bus section outage.  If yes,
                   **  then don't send email.
                   */
                   SELECT :x = COUNT(*)
                   FROM    FMS_BusSectionOutage
                   WHERE   Card = :ActiveSourceCards[i].Card;
                   IF x = 0 THEN
                      /*
                      **  Send out message for potential Distribution mis-operation.
                      */
                      IF EmailClass IS NULL THEN
                         EmailClass = EmailNotificationClass.Create();
                      ENDIF;
                      EmailClass.EmailType = 23;
                      EmailClass.Sender = DOp.Description;
                      EmailClass.Recipient = 'RelayMisOperation';
                      EmailClass.Subject = 'Mis-Operation Email ' + 
                                 ActiveSourceCards[i].FeederName + ' ' +
                                 ActiveSourceCards[i].CardClassName + ' ' +
                                 VARCHAR(IFNULL(date_trunc('day',ActiveSourceCards[i].CutOut),''));
                      EmailClass.Message1 = '';
                      EmailClass.Message2 = '';
                      EmailClass.Template = 'MisOperation.html';
                      EmailClass.InsertRequest();

                      IF EmailClass.ReturnCode <> 0 THEN 
                         Message 'Unable to notify region of possible relay mis-operation';
                      ENDIF;
                   ENDIF;
                ENDIF;
             ENDIF;
         ENDIF;
       ENDFOR;
    ENDIF;
   
    RETURN (PU_OK);
	
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

PROCEDURE TV_BogeyCheck (
   Card       = INTEGER     NOT NULL WITH DEFAULT;
   CutOut     = DATE;
) =
DECLARE
   TV_BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
   TV_FaultCheck   = INTEGER NOT NULL WITH DEFAULT;
   Tot_Min         = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   **  NO ROLLBACKS OR COMMITS IN HERE SINCE IT IS 
   **  PART OF CRITICAL WORK IN PROMPT.
   ** 
   **  See if TV_BogeyEnabled = TRUE. 
   */
   TV_BogeyEnabled = FALSE;
   SELECT :TV_BogeyEnabled = TM_BogeyEnabled
   FROM    FMS_SystemParameters;
   
   IF TV_BogeyEnabled = FALSE THEN
      RETURN;
   ENDIF;
   
   TV_FaultCheck = 0;
   SELECT :TV_FaultCheck = COUNT(*)
   FROM    FMS_Fault 
   WHERE   Card = :Card;

   IF TV_FaultCheck = 0 THEN
      /*
      **  No fault info entered. Check for OTWR/S or EST step.
      **  Would like to look if HV was applied to feeder but
      **  HV is a Feeder Status that gets removed once move is 
      **  completed so look for EST which gets set at same time.
      */
      SELECT :TV_FaultCheck = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card = :Card AND
              OperatingStep IN (:Type$OTWR,:Type$OTWS,:Type$EST);
      IF TV_FaultCheck = 0 THEN
         CALLPROC FMS_CardTVUpd (
             Card = Card,
             Type = 0,  /* Active card */
             TV_Bogey = -1);
      ENDIF;
   ELSEIF TV_FaultCheck > 1 THEN
      /*
      **  Find Total mins of outage time and divide number by
      **  Number of faults entered.
      */
      Tot_Min = IFNULL(INT4(interval('minute',DATE(CutInTime) - DATE(CutOut))),0);
      Tot_Min = INT4(Tot_Min/TV_FaultCheck);
      
      CALLPROC SOA_LogIns (
           Card = Card,
           Job  = NULL,
           SwitchingItem = 0,
           Time = DATE('Now'), 
           UserName = UserName,
           Item = 'TV Update Duration',
           Old  = VARCHAR(TV_FaultCheck) + ' faults entered as part of outage',
           New  = VARCHAR(Tot_Min));
      
   ENDIF;
   RETURN;
END;

