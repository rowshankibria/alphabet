	Name:            GetORDelayGracePeriod

/*
**
**      Copyright c 2017 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          GetORDelayGracePeriod
**
**  Date:       Version Description
** ----------------------------------
**  10/27/17 em Created
*/
procedure GetORDelayGracePeriod
(

) =
declare
   TypeDescription = VARCHAR(60) NOT NULL WITH DEFAULT;
   GraceValue = INTEGER NOT NULL WITH DEFAULT;
enddeclare
BEGIN
   ORDelay$GraceMinutes = 0;
   SELECT :TypeDescription = Description
   FROM   Udb_Type 
   WHERE  Type = :ORDelay$GracePeriod;

   IF TypeDescription = '' OR TypeDescription = '0' THEN
      RETURN;
   ELSE
      GraceValue = 0;
      GraceValue = INT4(TypeDescription);
      IF GraceValue <= 0 THEN
         MESSAGE 'Outage Request Delay Grace Period value is not a POSITIVE INTEGER. ' +
                 'Please have Core Group DO fix in DBM Type Hierarchy.';
         RETURN;
      ELSE
         ORDelay$GraceMinutes = GraceValue;
         RETURN;
      ENDIF;
   ENDIF;
END;      

