Application Component Report
============================

	Name:            ConfirmGrouper

/* 
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    CAC
**  Frame:          ConfirmGrouper 
** 
**  Modification log: 
** 
**  Date:   Version     Description 
** -------------------------------------------------- 
**  10/16/94    hlf     Creation   
**  01/23/07    em      Modification to prevent duplicates     
*/ 
INITIALIZE   
(   MacroType = INTEGER NOT NULL;
    MacroName = VARCHAR(40) NOT NULL;
    MacroObj =  INTEGER NOT NULL;
    i = INTEGER NOT NULL;
    Division = INTEGER NOT NULL;
    FoundStart = INTEGER NOT NULL WITH DEFAULT;
    WordLength = INTEGER NOT NULL WITH DEFAULT;
    Word = VARCHAR(40) NOT NULL WITH DEFAULT;
    WordNumbers = VARCHAR(40) NOT NULL WITH DEFAULT;
    SingleChar = CHAR(1) NOT NULL WITH DEFAULT;
)=
BEGIN
/*
**  Place a title at the top of the frame.
*/
    IF (MacroObj = 0) THEN
        FIELD(Grouper_stmt).TextValue = 'Create a new HTV Grouper with Selected Grouper Name or use one from the list.';
    ELSE
        FIELD(Grouper_stmt).TextValue = 'The system will link the equipment to this existing HTV Grouper.';
    ENDIF;             

    TheDefault.Object = MacroObj;
    TheDefault.Name = MacroName;

    Selected = TheDefault.Duplicate();

    i = 1;
    REPEATED 
    SELECT  DISTINCT
            :Grp[i].Name = O.Name,
            :Grp[i].Object = O.Object
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   O.Type = :Type$AbstractHTV
    AND     O.Object = G.Member
    AND     G.Grouping = :Division
    AND     G.Relationship = :Interaction$MemberOf
    BEGIN
        i = i + 1;
    END;
END;

ON Entry TheDefault.Name =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    Selected.Name = TheDefault.Name;
    Selected.Object = TheDefault.Object;
END;

ON ChildEntry Grp[*].Name =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    Selected.Name = Grp[].Name;
    Selected.Object = Grp[].Object;
END;

ON SetValue Selected.Name =
BEGIN
    Selected.Object = 0;

    SELECT  :Selected.Object = O.Object
    FROM    Udb_Object O,
            Udb_Grouping G
    WHERE   O.Type = :Type$AbstractHTV
    AND     O.Object = G.Member
    AND     G.Grouping = :Division
    AND     G.Relationship = :Interaction$MemberOf
    AND     O.Name = :Selected.Name;
END;

ON CLICK Save_btn =
BEGIN

    IF (Length(Selected.Name) <= 0) THEN
        Message 'You must enter a name for this HTV Grouper.';
        RESUME;
    ENDIF;

    IF Selected.Object = 0 THEN
/*
** Parse for numbers in the name, then compare to existing list.
*/     
       WordLength = LENGTH(Selected.Name);
       Word = Selected.Name;
       WordNumbers = '';
       FoundStart = FALSE;
       FOR i = 1 TO WordLength DO
          SingleChar = LEFT(Word,1);
          Word = SHIFT(Word,-1);
          IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
             FoundStart = TRUE;
             WordNumbers = WordNumbers + SingleChar;
          ELSEIF FoundStart = TRUE THEN
             ENDLOOP;
          ENDIF;
       ENDFOR;

       IF WordNumbers <> '' AND LENGTH(WordNumbers) > 2 THEN
          WordNumbers = '%' + WordNumbers + '%'; 
          FOR i = 1 TO Grp.LastRow() DO
             IF Grp[i].Name LIKE WordNumbers THEN
                IF CurFrame.ConfirmPopup (MessageText = 'There is a similar HTV Grouper with name = ' + Grp[i].Name +
                             '.  Would you rather use that than creating a new possible duplicate HTV Grouper?') = PU_OK THEN
                   RESUME;
                   ENDLOOP;
                ENDIF;
             ENDIF;
          ENDFOR;      
       ENDIF;
    ENDIF;

    MacroObj = Selected.Object;
    MacroName = Selected.Name;
    RETURN (PU_OK);
END;

ON CLICK Cancel_btn =
BEGIN
    RETURN (PU_CANCEL);
END;


Application Component Report
============================

	Name:            ConfirmPickupEquip

/*
**
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation.
**
**  Application:    FeederCard
**  Frame:          ConfirmPickupEquip
**
**  Date:           Version  Description
** --------------------------------------------------
**  FEB 93      adl      author
**  03/03/93    em       log picking up of equipment
**  12/14/94    bgh      Added ability to modify type relationship and
**                       preloaded preserved types if they exists.
**  12/22/94    em       For some reason, Preserved is spelled correctly in
**                       this program, have to go back to incorrect
**                       spelling "perserv" because that's the way it is in the database.
**  01/12/95    pkw      add equip to connectivity if needed
**  04/13/95    pkw      make type clickpoint event
**  04/13/95    pw       comment out connectivity editor
**  08/10/95    em       Check for MacroEquipment, Pick it up also
**  08/16/02    ysp      Removed commented out connectivity related code.
**  04/28/06    ysp      FMS322: Check if there are open cards on this feeder. 
**                       If so, send an incoming message for DO to delete the cards.
**                       This feature has been replaced by db rule FMS_CloseOpenCards1 
**  05/15/06    ysp      This frame now returns pu_cancel or pu_ok.    
**  08/20/10    em       Add Feeder for selection when 3G
**  09/07/13    pkw      Create SD Link if SD-VIS is picked up.
**  09/01/15    pkw      Update ATS Grouper Member type when picked up.
**  10/13/15    pkw      Copy common moves from other cards for macro ATS
**  04/20/16    ysp      For 33kv, prompt DO to select a segment from the current card
**  06/23/16    em       Remove remaining Connectivity code that is not being used
**  08/22/17    em       If feeder has SF6 type equipment, will prompt for each equip to
**                       insert DownstreamFrom relationship.
**  10/03/17    em       Temporarily Disable KP ISO prompt until follow-on enhancement complete.
**  02/21/18    em       Re-enable KP ISO Prompt
**  12/30/19	em		 Include DMEaton in DMSF6 type list
**  03/24/20    em       Add calls to InsertKPSException and MarkDiagramInvalid
**  01/17/22    em       Check equipment being picked for KPS type to include in SF6 downstream from array
**  01/26/22    em       Enable KPS for both SF6 selection and downstream from DM
*/

INITIALIZE (
   C = FMS_Card; /* parameter - current card */ 
   SelectedPortion = INTEGER NOT NULL WITH DEFAULT;   /* optional: 33kv segment */
) = 
DECLARE
   i = integer NOT NULL WITH DEFAULT;	    /* Temporary counter */ 
   j = integer NOT NULL WITH DEFAULT;	    /* Temporary counter */ 
   k = integer;	    /* Temporary counter */
   EquipCnt = integer not null;
   FeederObj = INTEGER NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; 
   GroundCnt = integer not null;
   status = integer;   /* return status variable */ 
   OriginalEquip = ARRAY of FMS_Equip;
   MacroEquip = FMS_Equip;
   MainFeeder = INTEGER NOT NULL WITH DEFAULT;
   SF6 = ARRAY OF ObjectClass;
   
   SD_Pickup = PROCEDURE;
ENDDECLARE
BEGIN 
   OriginalEquip = ChosenEquip.Duplicate();

   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      FeederObj = C.Object[1].Object;
      FeederName = C.Object[1].Name; 
      // CurFrame.SendUserEvent (EventName = 'LoadDisplay');

      IF C.Object.LastRow() > 1 THEN
         FIELD(NetworkFeeder).ValueList.ChoiceItems.Clear();
         FOR i = 1 TO C.Object.LastRow() DO
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumValue = C.Object[i].Object;
            FIELD(NetworkFeeder).ValueList.ChoiceItems[i].EnumText = C.Object[i].Name;
         ENDFOR;
         FIELD(NetworkFeeder).CurBias = FB_CHANGEABLE;
         /* OR5.1 FIELD(NetworkFeeder).ColumnWidthCompressed = TRUE; */
         FIELD(NetworkFeeder).UpdChoiceList();
      ENDIF;
         
   ELSEIF C.NetworkFeeder = NetworkFeeder$33KV THEN
      IF SelectedPortion > 0 THEN
         FeederObj = SelectedPortion;
         
         SELECT :FeederName = O.Name
         FROM   UDB_Grouping G,
                UDB_Object O
         WHERE  G.Member = :FeederObj AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Feeder AND
                G.Grouping = O.Object;
         CALLPROC DDB_ROLLBACK;
      ELSE
         IF C.TypeOfCard = TypeOfCard$Portion THEN
            SELECT :MainFeeder = C.Feeder,
                   :FeederName = C.FeederName
            FROM   FMS_PortionLink L,
                   FMS_Card C
            WHERE  L.PortionCard = :C.Card AND
                   L.Card = C.Card;
            CALLPROC DDB_ROLLBACK;
         ELSE
            MainFeeder = C.Feeder;
         ENDIF;
         CALLFRAME PortionFeederDiagram(MainFeeder = MainFeeder,
                                       ClickableList = C.Object,
                                       SelectedPortion =  BYREF(FeederObj),
                                       Title = 'Select a Segment that Equipment will be Picked up to');
         IF FeederObj = 0 THEN
            RETURN;
         ENDIF;
      ENDIF;
   ELSE
      FeederObj = C.Feeder;
      FeederName = C.FeederName;
   ENDIF;

   SF6.Clear();
   i = 1;
   REPEATED
   SELECT :SF6[i].PrimaryGrouping = O1.Object,
          :SF6[i].PrimaryGroupingName = O1.Name,
          :SF6[i].Object = O2.Object,
          :SF6[i].Name = O2.Name,
          :SF6[i].TypeName = O2.TypeName,
          :SF6[i].Description = O2.Description
   FROM   Udb_Object O1,
          Udb_Object O2,
          Udb_Grouping G
   WHERE  O2.Type IN       (SELECT Type
                            FROM  Udb_ExtendedType
                            WHERE  SuperType IN (:Type$DMSF6Switch,
                                                 :Type$DMEaton,
                                                 :Type$KPS,   
                                                 :Type$FastSw,
                                                 :Type$DMVac) ) AND
          O2.Object = G.Member AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = :FeederObj AND
          G.Grouping = O1.Object
   ORDER BY 2,5,4
   BEGIN 
      i = i + 1;
   END;
/* 
** Add any SF6 equip that is being picked up.
*/
   FOR j = 1 TO ChosenEquip.LastRow DO
      k = 0;
      SELECT :k = Type
      FROM   Udb_ExtendedType
      WHERE  SuperType IN (                      :Type$DMSF6Switch,
                                                 :Type$DMEaton,
                                                 :Type$KPS,  
                                                 :Type$FastSw,
                                                 :Type$DMVac)  AND 
             Type = :ChosenEquip[j].EquipClass;
      IF k > 0 THEN
          SF6.InsertRow (rownumber = i);
          SF6[i].PrimaryGrouping = 0;
          SF6[i].PrimaryGroupingName = FeederName;
          SF6[i].Object = ChosenEquip[j].Equip;
          SF6[i].Name = ChosenEquip[j].EquipName;
          SF6[i].TypeName = ChosenEquip[j].EquipClassName;
          SF6[i].Description = ChosenEquip[j].Description;
          i = i + 1;
      ENDIF;
   ENDFOR;   

   CurFrame.SendUserEvent (EventName = 'LoadDisplay');
END;

ON USEREVENT 'LoadDisplay' =
BEGIN
/*
**  Loop through the chosen equipment list and check if there is
**  a preserved equipment type as related to the current feeder.
*/
    i = 1;
    WHILE i <= ChosenEquip.LastRow() DO

       REPEATED
       SELECT :ChosenEquip[i].EquipClass = P.MemberType,
              :ChosenEquip[i].EquipClassName = T.Name
       FROM Udb_Type T,
            FMS_PreservedType P
       WHERE P.Equip = :ChosenEquip[i].Equip AND
             P.Feeder = :FeederObj AND
             P.MemberType = T.Type;

       IF iirowcount <= 0 THEN
           ChosenEquip[i].EquipClass = OriginalEquip[i].EquipClass;
           ChosenEquip[i].EquipClassName = OriginalEquip[i].EquipClassName;
       ENDIF;   
       i = i + 1;
    ENDWHILE;        
    CALLPROC DDB_ROLLBACK;

END;

ON SETVALUE NetWorkFeeder =
BEGIN
   FeederObj = FIELD(NetworkFeeder).CurEnumValue;
   FeederName = FIELD(NetworkFeeder).CurEnumText;
   CurFrame.SendUserEvent (EventName = 'LoadDisplay');
END;

/*
**  Handle the modification of the equipment type as related to
**  the current feeder.
*/
ON ChildClickPoint ChosenEquip[*].EquipClassName =
BEGIN

    i = FIELD(ChosenEquip).CurRow;
    CALLFRAME SelectType (TypeName = BYREF(ChosenEquip[].EquipClassName),
                         Type     = BYREF(ChosenEquip[].EquipClass),
                         SuperType = OriginalEquip[i].EquipClass,
                         CardType = CardDetails.TypeOfCard);
    RESUME;

END;

/* 
**  Handle a DONE click: 
*/ 
ON Click DONE_Btn = 
DECLARE
   IsATS = INTEGER NOT NULL WITH DEFAULT;
   Is101 = INTEGER NOT NULL WITH DEFAULT;
   IsNC  = INTEGER NOT NULL WITH DEFAULT;
   TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
   cFeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   cTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   cFeeder = INTEGER NOT NULL WITH DEFAULT;
   ATSLoadDesc = VARCHAR(40) NOT NULL WITH DEFAULT;
   FdrObj  = INTEGER NOT NULL WITH DEFAULT;
   x  = INTEGER NOT NULL WITH DEFAULT;
   j  = INTEGER NOT NULL WITH DEFAULT;
   CopyOfObject = ObjectClass;       /* Copy of Object*/
   CommonJobs = ARRAY OF JOB;
   ControlEntry = NewMoveCard;
ENDDECLARE
BEGIN 
       /* Update the database: */ 
   i = 1; 
   WHILE (i <= ChosenEquip.LastRow()) DO  
      status = CALLPROC PU_Equip
                      (SelectedEquip = ChosenEquip[i].Duplicate(),
                       C = C,
                       FeederObj = FeederObj);
                                        
      IF status = PU_CANCEL THEN
         RETURN PU_CANCEL;
      ENDIF;
/*
**   Check if equipment is attached to a macro equipment.  If it is, we will
**   have to pickup moves for that equip as well.
*/
      MacroEquip.Equip = 0;
      REPEATED 
      SELECT :MacroEquip.Equip = G.Grouping,
             :MacroEquip.EquipClass = G.GroupingType,
             :MacroEquip.EquipClassName = T.Name
      FROM   Udb_Grouping G,
             Udb_ExtendedType ET,
             Udb_Type T
      WHERE  G.GroupingType  = ET.Type AND
             ET.SuperType    = :Type$Switch AND
             G.GroupingType  = T.Type AND
             G.Relationship  = :Interaction$MemberOf AND
             G.Member        = :ChosenEquip[i].Equip; 

      IF MacroEquip.Equip > 0 THEN
         /*
         **  Tack on a space if only one character entered.
         **  Need to do this to maintain sort order.  If they choose not 
         **  to enter one - FINE.
         */ 
         IF (Length(ChosenEquip[i].PrintID) = 1) THEN
            ChosenEquip[i].PrintID = ' ' + ChosenEquip[i].PrintID;
         ENDIF;
         MacroEquip.PrintID = ChosenEquip[i].PrintID;
         /*
         ** If ATS macro, update membertype
         */
         IsATS = 0;
         SELECT :IsATS = COUNT(*) 
         FROM    Udb_ExtendedType ET
         WHERE   ET.SuperType = :Type$ATSGrouper AND
                 ET.Type = :MacroEquip.EquipClass;
         IF IsATS > 0 THEN
            Is101 = 0;
            SELECT :Is101 = COUNT(*) 
            FROM    Udb_ExtendedType ET
            WHERE   ET.SuperType = :Type$ATS101 AND
                    ET.Type = :ChosenEquip[i].EquipClass;
                 
            IsNC = 0;
            SELECT :IsNC = COUNT(*) 
            FROM    Udb_Type T
            WHERE   T.Type = :ChosenEquip[i].EquipClass AND
                    lowercase(name) like '%nc%';
                 
            TempName = lowercase(MacroEquip.EquipClassName) + '-';
            IF IsNC <> 0 THEN
               TempName = TempName + 'nc10';
            ELSE
               TempName = TempName + 'no10';
            ENDIF;
            IF Is101 <> 0 THEN
               TempName = TempName + '1';
            ELSE
               TempName = TempName + '2';                 
            ENDIF;
                 
            SELECT :MacroEquip.EquipClass = T.Type
            FROM    Udb_Type T,
                    Udb_ExtendedType ET
            WHERE   ET.SuperType = :MacroEquip.EquipClass AND
                    ET.Type = T.Type AND
                    lowercase(T.Name) = :TempName;
         ENDIF;
              
         status = CALLPROC Udb_GroupingUpd (
                   Grouping = FeederObj,
                   Relationship = Interaction$MemberOf,
                   Member = MacroEquip.Equip,
                   MemberType = MacroEquip.EquipClass,
                   Reference = MacroEquip.PrintID);
         IF status < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Problem setting PrintID for macro equipment. ' +
                    'Correct via Udb Access.';
         ENDIF;
         CALLPROC DDB_COMMIT;
         status = CALLPROC PU_Equip
                      (SelectedEquip = MacroEquip.Duplicate(),
                       MacroEquipFlag = TRUE,
                       C = C,
                       FeederObj = FeederObj);
         IF status = PU_CANCEL THEN
            RETURN PU_CANCEL;
         ENDIF;
         IF  IsATS > 0 THEN /* check after pickup so that type is updated. */
            /*
            **  Update description of Load Side Feeder
            */
            ATSLoadDesc = '';
            x = 1;
            FdrObj = 0;
            SELECT :cFeeder = O.Object,
                   :cFeederName = O.Name,
                   :cTypeName = T.Name
            FROM    Udb_Grouping G,
                    Udb_Object O,
                    Udb_Type T
            WHERE   G.Member = :MacroEquip.Equip AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType = :Type$Feeder AND
                    G.Grouping = O.Object AND
                    G.MemberType = T.Type
            BEGIN
               j = LOCATE(cTypeName,'-');
               IF j <= LENGTH(cTypeName) THEN
                  cTypeName = RIGHT(cTypeName, j); 
               ENDIF;
               IF lowercase(cTypeName) like '%load%' THEN
                  FdrObj = cFeeder;
               ELSEIF x = 1 THEN
                  ATSLoadDesc = cFeederName + ' ' + cTypeName + ' <--A--> ';
                  x = x + 1;
               ELSE 
                  ATSLoadDesc = ATSLoadDesc + ' ' + cFeederName + ' ' + cTypeName;
               ENDIF;
            END;
            IF FdrObj <> 0 THEN
               /*
               **  Found Load Side Feeder.  Update description.
               */
               /*
               ** Select everything from object table for the equipment
               */
               SELECT  :CopyOfObject.Object      = O.Object,
                       :CopyOfObject.Name        = O.Name,
                       :CopyOfObject.Description = O.Description,
                       :CopyOfObject.Type        = O.Type,
                       :CopyOfObject.TypeName    = O.TypeName,
                       :CopyOfObject.PrimaryGrouping = O.PrimaryGrouping,
                       :CopyOfObject.PrimaryGroupingName = O.PrimaryGroupingName,
                       :CopyOfObject.Comment     = O.Comment,
                       :CopyOfObject.Validated   = O.Validated,
                       :CopyOfObject.ValidatedBy = O.ValidatedBy,
                       :CopyOfObject.Inservice   = O.Inservice,
                       :CopyOfObject.Outservice  = O.Outservice,
                       :CopyOfObject.PositionX   = O.PositionX,
                       :CopyOfObject.PositionY   = O.PositionY,
                       :CopyOfObject.OwnerNumber = O.OwnerNumber,
                       :CopyOfObject.SerialNumber = O.SerialNumber,
                       :CopyOfObject.SpecNumber  = O.SpecNumber,
                       :CopyOfObject.Combination = O.Combination,
                       :CopyOfObject.LockNumber  = O.LockNumber,
                       :CopyOfObject.LastChanged = O.LastChanged,
                       :CopyOfObject.LastChangedBy = O.LastChangedBy
               FROM Udb_Object O
               WHERE O.Object = :FdrObj;
               CALLPROC DDB_ROLLBACK;
               /*
               ** Update the type for this object
               */
               status = CALLPROC Udb_ObjectUpdAll(
                          Object          = CopyOfObject.Object,
                          Type            = CopyOfObject.Type,
                          PrimaryGrouping = CopyOfObject.PrimaryGrouping,
                          TypeName        = CopyOfObject.TypeName,
                          PrimaryGroupingName = CopyOfObject.PrimaryGroupingName,
                          Name            = CopyOfObject.Name,
                          Description     = ATSLoadDesc,
                          Comment         = CopyOfObject.Comment,
                          Inservice       = CopyOfObject.Inservice,
                          Outservice      = CopyOfObject.Outservice,
                          PositionX       = CopyOfObject.PositionX,
                          PositionY       = CopyOfObject.PositionY,
                          OwnerNumber     = CopyOfObject.OwnerNumber,
                          SerialNumber    = CopyOfObject.SerialNumber,
                          SpecNumber      = CopyOfObject.SpecNumber,
                          Combination     = CopyOfObject.Combination,
                          LockNumber      = CopyOfObject.LockNumber,
                          Validated       = CopyOfObject.Validated,
                          ValidatedBy     = CopyOfObject.ValidatedBy,
                          LastChanged     = CopyOfObject.LastChanged,
                          LastChangedBy   = CopyOfObject.LastChangedBy);
               IF status <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Error occurred while updating Equipment Load Side Feeder Description. ' +
                          'Correct via Udb Access.';
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF; 
            ENDIF;
            /*
            ** Pick up common jobs
            */
            j = 1;
            REPEATED
            SELECT :CommonJobs[j].Job = J.Job, 
                   :CommonJobs[j].Status = J.Status,
                   :CommonJobs[j].JobClass = J.JobClass,
                   :CommonJobs[j].Equip = J.Equip,
                   :CommonJobs[j].EquipClass = J.EquipClass,  
                   :CommonJobs[j].EquipClassName = J.EquipClassName,
                   :CommonJobs[j].MoveEquipClass = JCC.EquipClass,   
                   :CommonJobs[j].EquipName = J.EquipName,
                   :CommonJobs[j].StepPair = JCC.StepPair,
                   :CommonJobs[j].Grounds = J.Grounds,
                   :CommonJobs[j].MoveType = J.MoveType,
                   :CommonJobs[j].TOMove = J.TOMove,
                   :CommonJobs[j].TOOperator = J.TOOperator,
                   :CommonJobs[j].TOIssued = J.TOIssued,
                   :CommonJobs[j].TOComplete = J.TOComplete,
                   :CommonJobs[j].GroundOn = J.GroundOn,
                   :CommonJobs[j].RSMove = J.RSMove,
                   :CommonJobs[j].RSOperator = J.RSOperator,
                   :CommonJobs[j].RSIssued = J.RSIssued,
                   :CommonJobs[j].RSComplete = J.RSComplete,
                   :CommonJobs[j].TOMoveRules = J.TOMoveRules,
                   :CommonJobs[j].RSMoveRules = J.RSMoveRules,
                   :CommonJobs[j].Response = J.Response,
                   :CommonJobs[j].MoveFGColor = J.MoveFGColor,
                   :CommonJobs[j].MoveBGColor = J.MoveBGColor,
                   :CommonJobs[j].ControlCard = J.ControlCard,
                   :CommonJobs[j].Substation = J.Substation,
                   :CommonJobs[j].MoveCategory = J.MoveCategory,
                   :CommonJobs[j].ActivityIdentifier = J.ActivityIdentifier
            FROM   SOA_Job J,
            SOA_JobControl JC,
            SOA_ActiveCard C,
            FMS_JobClassControl JCC
            WHERE  :MacroEquip.Equip = J.Equip AND
                    J.Status = '' AND
                   (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
                    J.Job = JC.Job AND
                    JC.Card = C.Card AND
                    JCC.TypeOfCard = :CardDetails.TypeOfCard AND
                    JCC.JobClass = J.JobClass AND
                    JCC.StepPair = JC.StepPair
            BEGIN
               j = j + 1;
            END;                       
            j = 1;
            WHILE j <= CommonJobs.LastRow() DO
               ControlEntry.Card = C.Card;
               ControlEntry.Seq = 0;
               ControlEntry.SwitchingItem = 0;
               ControlEntry.Application = Application$FMS;
               ControlEntry.StepHeading = CommonJobs[j].StepPair;
               ControlEntry.TypeOfCard = C.TypeOfCard;
               ControlEntry.MoveEquipClass = CommonJobs[j].MoveEquipClass;
               ControlEntry.StepLevel = 0;
               ControlEntry.PrintID = MacroEquip.PrintID;

               status = CommonJobs[j].InsertControl (
                        ControlEntry = ControlEntry,
                        InitiatingCard = C.Card);

               IF status = PU_CANCEL THEN
                  CALLPROC DDB_ROLLBACK;
                  Message 'Error occurred while copying common moves of macro equipment to ' +
                          'current card.';
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF; 
               j = j + 1;
            ENDWHILE;   
         ENDIF;
      ENDIF; 
      /*
      **  Prompt to add DownStreamFrom relationship 
      */
      IF SF6.LastRow > 0 THEN
         CALLFRAME KPISOSectionPrompt (Feeder = FeederObj, 
                                       FeederName = FeederName,
                                       SF6 = SF6,
                                       Equip = ChosenEquip[i].Equip,
                                       EquipName = ChosenEquip[i].EquipName,
                                       EquipPrintID = ChosenEquip[i].PrintID,
                                       EquipTypeName = ChosenEquip[i].EquipClassName
                                      );
      ENDIF;
      /*
      **  Establish SD Link if necessary.
      */
      CALLPROC SD_Pickup (SE = ChosenEquip[i].Duplicate());
      /*
      ** Handle feeder diagram if needed
      */
      ChosenEquip[i].Feeder = FeederObj;
      ChosenEquip[i].FeederName = FeederName;
      CALLPROC InsertKPSException (Equip = ChosenEquip[i]);
      i = i + 1; 
   ENDWHILE;
   CALLPROC MarkDiagramInvalid (Feeder = FeederObj);

   RETURN PU_OK; 
END; 

/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
    BEGIN 
        RETURN PU_CANCEL; 
    END; 

/* 
**  Handle the Close Window Command: 
*/ 
ON WINDOWCLOSE = 
   BEGIN  
	RESUME; 
   END; 

PROCEDURE SD_Pickup (
   SE = FMS_Equip;
) =
DECLARE
   SDCard  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN 
   /*
   **  Only check when SDVIS device is being transferred.
   */
   IF SE.EquipClass <> Type$SDVIS THEN
      RETURN;
   ENDIF;
   /*
   **  Only establish links for 27kV cards.
   */
   IF C.TypeOfCard = TypeOfCard$4KV THEN
      RETURN;
   ENDIF;
   /*
   **  Find the StepDown card that this equipment is on.
   */
   SDCard = 0;
   SELECT :SDCard = AO.Card
   FROM    Udb_Grouping G,
           SOA_ActiveObject AO,
           FMS_StepDownLink L
   WHERE   G.Member = :SE.Equip AND
           G.Relationship = :Interaction$SourceBreaker AND
           G.Grouping = AO.Object;

   IF SDCard <> 0 THEN
      /*
      **  Add link to Step Down link table. 
      */
      CALLPROC FMS_StepDownLinkIns
              (Card = C.Card,
               StepDownCard = SDCard);
      CALLPROC DDB_COMMIT;
      FCFrame.SendUserEvent (EventName = 'RefreshCardLinks');
   ENDIF;         
          
   RETURN;
END;


