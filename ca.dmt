	Name:            PromptDropCheckIssue

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptDropCheckIssue
**
**  10/20/21  pkw  Created
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE

   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   **  Hard code values
   */
   Low_Pressure = 10;
   High_Pressure = 100;
   Interval1 = 1;
   Duration1 = 5;
   Interval2 = 5;
   Duration2 = 120;
END;

ON Click OKButton =
DECLARE
   Reading = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Low_Pressure IS NULL THEN
      MESSAGE 'Please enter the Low Pressure PSI';
      RESUME;
   ENDIF;
   IF High_Pressure IS NULL THEN
      MESSAGE 'Please enter the High Pressure PSI';
      RESUME;
   ENDIF;
   IF Interval1 IS NULL OR
      Interval2 IS NULL OR
      Duration1 IS NULL OR
      Duration2 IS NULL THEN

      MESSAGE 'Please enter all pressure check variables.';
      RESUME;
   ENDIF;
  
      
   RetCode = CALLPROC DSO_DropCheckIssueIns(
      Job = JIP.Job,
      LowPressure = ifnull(Low_Pressure,0),
      HighPressure = ifnull(High_Pressure,0),
      Stage1Interval = ifnull(Interval1,0),
      Stage1Duration = ifnull(Duration1,0),
      Stage2Interval = ifnull(Interval2,0),
      Stage2Duration = ifnull(Duration2,0));

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to record Drop Check Issue parameters.',
                           TraceMessage =
                  'PromptDropCheckIssue: Unable to record parameters for ' +
                  'job=' + VARCHAR(JIP.Job));
      RETURN (PU_Cancel);
   ENDIF;        
   CALLPROC DDB_COMMIT;
   

   RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            PromptEmergencyWorkComplete

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptEmergencyWorkComplete
**
**  10/20/21  pkw  Created
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   DSOCard = CardDSO;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   RetCode = CALLPROC DSO_CardStatusUpd(Card = JIP.Card,
                              Status = Card$DSOReview
                              );
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace (Text = VARCHAR(Date('now')) + 
                   ': Could not update DSO Card Status.');
   ENDIF;
   CALLPROC DDB_COMMIT;  

   RetCode = CALLPROC FMS_ObjStatDel(Object = JIP.Card, Status = Status$Emergency);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace (Text = VARCHAR(Date('now')) + 
                   ': Could not clear Emergency status from card.');
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   **  Clear flag
   */
   DSOEmergency = FALSE;
 
   /*
   **  Get current card values
   */
   SELECT :DSOCard.CCNumber = C.CCNumber,
          :DSOCard.OpNumber = C.OpNumber,
          :DSOCard.ScopeOfWork = C.ScopeofWork,
          :DSOCard.CheckedBy = C.CheckedBy,
          :DSOCard.CheckedBy2 = C.CheckedBy2  
   FROM   DSO_Card C
   WHERE  C.Card = :JIP.Card;
   CALLPROC DDB_ROLLBACK;
   
   RetCode = CALLPROC DSO_CardUpd
                      (Card = JIP.Card,  
                       CCNumber = DSOCard.CCNumber,
                       OpNumber = DSOCard.OpNumber,
                       ScopeofWork = DSOCard.ScopeOfWork,
                       PreparedBy = DOp.Description,
                       CheckedBy = '',
                       CheckedBy2 = '');

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Could not update CheckedBy Fields, please try again.';
      RETURN (PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF DSOCard.PreparedBy <> DOp.Description THEN
      CALLPROC SOA_LogIns (
           Card = JIP.Card,
           Job  = NULL,
           SwitchingItem = 0,
           Time = DATE('Now'),
           UserName = UserName,
           Item = 'PreparedBy',
           Old  = DSOCard.PreparedBy,
           New  = DOp.Description);
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   IF DSOCard.CheckedBy <> '' THEN
      CALLPROC SOA_LogIns (
           Card = JIP.Card,
           Job  = NULL,
           SwitchingItem = 0,
           Time = DATE('Now'),
           UserName = UserName,
           Item = 'CheckedBy',
           Old  = DSOCard.CheckedBy,
           New  = '');
      CALLPROC DDB_COMMIT;
   ENDIF;
   IF DSOCard.CheckedBy2 <> '' THEN
      CALLPROC SOA_LogIns (
           Card = JIP.Card,
           Job  = NULL,
           SwitchingItem = 0,
           Time = DATE('Now'),
           UserName = UserName,
           Item = '2nd CheckedBy',
           Old  = DSOCard.CheckedBy2,
           New  = '');
      CALLPROC DDB_COMMIT;
   ENDIF;

   SOAFrame.SendUserEvent (EventName = 'LoadCard');

   RETURN (PU_OK);

END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            PromptEnterETR

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptEnterETR
**
**  Modifications:
**  01/05/95    hlf     Allow addition of estimated time of restore
**  11/21/95    ysp     Imported from SLC.
**  04/11/01    my      added returned DO name who issued these moves and        
**                      display the list of all DO, the user can select one of   
**                      them.
**  04/12/01    my      added FCRTarget option list. For the choosed feeder,if   
**                      it connect to one division, then the user will not be
**                      able to choose other division, otherwise they can choose
**                      different target division.When the user click the OK
**                      button, execute DB procedure IR_IssueFCRWorkPermit and
**                      Raise DBEvent IR_FCRPermitIssued.
**  04/19/01    em      Screen changes, set FCR Target at OK click not on
**                      setvalue since if only one Division there will not
**                      be a set value. Put Return stmt outside of IF ENDIF.
**                      Use another method to determine if a FCR permit.
**                      Division Selection doesn't work for more than one.
**  04/25/01    em      After permit issued to FCR, send message and update
**                      message key so that the issuance can be acknowledged.
**  05/08/01    em      Force DO name to be entered if an FCR permit.
**  06/04/01    em      IF more than one potential target division, display a
**                      a blank field to force them to select one.
**  01/01/02    em      Modified to support issued Permit Updates
**  01/04/02    em      Added log entry when permit issued electronically
**  01/06/02    pkw     If multiple revisions are sent down delete previous 
**                      unacknowledged message.
**  01/07/02    em      Add ProtectionMoveCount and Permits Status to Issued
**                      FCR permit.
**  01/15/02    em      Added capability for DO to review and add to the
**                      Revision Comment.
**  01/24/02    em      Set the Permit Status to Issued when the FCR permit
**                      issued message is sent to the FCR Monitor.
**  07/01/02    ysp     Merge: Remove passed-in C (type of FMS_Card) and change 
**                      J to Job (type of JobInProgress).
**  01/06/03    ysp     ITC 114: Use DoLogin to select a DO.
**  01/06/03    em      Convert Job to JIP and Merge SOA and FMS versions of this 
**                      screen.
**  01/17/03    ysp     change fms_job to soa_job.
**  02/26/03    em      Adjusted WorkPermitProtection select
**  03/07/03    em      When retrieving WorkPermit, if not in existence already
**                      in SOA, will default to NULL, need to default
**                      ProtectionRequired to TRUE.
**  01/15/04    em      Added Process Automation components.
**  01/30/04    em      Set permit status to initialized instead of issued
**                      when calling procedure IR_IssueFCRWorkPermit
**  03/02/04    em      Display Screen during Process Auto setup even though
**                      move not issued to FOD.
**  02/16/05    em      Improperly passing Feeder to Outgoing Message
**  09/01/05    em      Added Operator parameter for TOMS orders to SSO.
**                      Automatic activity.
**  09/14/05    em      Set WPSeqChanged = TRUE when OpOrder permit to force save.
**  10/21/05    em      FMS 260: Modified Outging Message
**  10/31/05    em      Make frame invisible for SOA Operating Orders.
**  12/13/05    ysp     increase TempMove to varchar(160)
**  09/27/06    em      Remove Outgoing Informational message
**  10/23/06    em      For work permit operating orders from FMS, also update the
**                      move text with the Sequence umber (Job ID).  Make sure to
**                      create a row in the SOA_WorkPermit table for these permits
**                      also.
**  12/21/06    em      Don't set WPSeq if it exists already as it would for a copy
**                      of a suspended permit.
**  04/16/07   ysp      ITC210: Insert IR interface event in DB event queue
**  10/02/07    em      Immediate Exit if called from Steam
**  03/25/11    em      Modify for 3G
**  05/19/11    em      Production problem using SOA_ActiveObject to find single feeder.
**  12/14/16   ysp      Increase RevisionComment field to varchar(1500)
**  09/14/22   ysp      Move DBEvent IR_FCRPermitIssued codes after work permit status set Issued.
*/
INITIALIZE
(
    JIP = JobInProgress;			      /*P: Job being processed */
    PermitUpdate = INTEGER NOT NULL WITH DEFAULT;     /*Optional Parameter*/
    Operator = INTEGER NOT NULL WITH DEFAULT;         /*Optional Parameter*/
  
    C = FMS_Card;                                     /* Load Card Info */
    MessageField = VARCHAR(400) NOT NULL WITH DEFAULT; /*FCR permit Message*/
    MsgMessage = VARCHAR(200) NOT NULL;                /*For message Insertion*/
    MoveSeq = VARCHAR(10) NOT NULL WITH DEFAULT;
    MoveText = VARCHAR(40) NOT NULL;                /*For message Insertion*/
    MsgKey = INTEGER NOT NULL;                        /*Outgoing Msg ID*/
    ObjectID = INTEGER NOT NULL;
    ObjectName = VARCHAR(40) NOT NULL;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    OrigTime = DATE NOT NULL WITH DEFAULT;
    TempMove = VARCHAR(160) NOT NULL WITH DEFAULT;
    TimeSet =  DATE NOT NULL;
    i = INTEGER NOT NULL;
    IssuedOperator = INTEGER;                        /*permit issued to*/
    PMC = INTEGER NOT NULL WITH DEFAULT;   /*ProtectionMoveCount*/
    CONTROLTEXT = VARCHAR(256) NOT NULL WITH DEFAULT;
    
    RevisionDate = DATE NOT NULL WITH DEFAULT;       /* Date Revision entered */
    SimpleWP = WorkPermit;
    SkipDisplay = INTEGER NOT NULL WITH DEFAULT;     /*BOOLEAN*/
    FMSProtectionRequired = INTEGER NOT NULL WITH DEFAULT;
    FMSPermitDescription = VARCHAR(1500) NOT NULL WITH DEFAULT;
) =
BEGIN
   IF CurrentApplication = Application$SDS THEN
      RETURN(PU_OK);
   ENDIF;

   IF CurrentApplication = Application$FMS THEN

    C.Feeder = 0;
    REPEATED
    SELECT
    DISTINCT
           :C.Feeder = AO.Object,  /*Just need one to support 3G*/
           :C.FeederName = C.FeederName,
           :C.Card = C.Card,
           :C.CardClassName = C.CardClassName
    FROM   FMS_Card C,
           SOA_ActiveObject AO,
           SOA_JobControl JC
    WHERE  JC.Job = :JIP.Job AND
           JC.Card = AO.Card AND
           AO.ObjectToCardLink = 1 AND
           AO.Card = C.Card;
   
    IF C.Feeder = 0 THEN
       CALLPROC TraceError(UserMessage = 'PromptEnterETR not called properly from an FMS card', 
                TraceMessage = 'PromptEnterETR not called properly from an FMS card');
       RETURN (PU_CANCEL);
    ENDIF;    

    MessageField = '';
    SELECT :ETC = EstTimeComplete,
           :Warning = Warning,
           :FMSProtectionRequired = ProtectionRequired,  /* will need for FMS Op Order Permits */
           :FMSPermitDescription = Description
    FROM   FMS_WorkPermit
    WHERE  PermitJobID = :JIP.Job;

    OrigTime = ETC;
    SELECT :IssuedOperator = TOOperator,
           :MoveText = TOMove
    FROM   SOA_Job
    WHERE  Job = :JIP.Job;

    IF IssuedOperator = Operator$FCR OR ProcessAutoMode = TRUE THEN
       FIELD(FCR).CurBias = FB_CHANGEABLE; 
       FCR.DistrictOperator = DOp.Description;
       FIELD(FCR.Target).ValueList.ChoiceItems[1].EnumValue = 0;
       FIELD(FCR.Target).ValueList.ChoiceItems[1].EnumText = '';

       i = 2;
       SELECT :ObjectID = O.Object,	
              :ObjectName = UPPERCASE(O.Name)
       FROM   Udb_Grouping G,
              Udb_Object O
       WHERE  G.Grouping = O.Object AND
              G.GroupingType = :Type$Division AND
              G.RelationShip = :Interaction$MemberOf AND
              G.Member = :C.Feeder
       BEGIN
          FIELD(FCR.Target).ValueList.ChoiceItems[i].EnumValue = ObjectID;
          FIELD(FCR.Target).ValueList.ChoiceItems[i].EnumText = ObjectName;
          i = i + 1;
       END;

       IF i = 2 THEN
          MESSAGE 'There is an error.  This feeder is not a member of ' +
                  'any divisions.  Cannot issue the permit to an FCR.';
          RETURN (PU_CANCEL);
       
       ELSEIF i = 3 THEN  /* Only one choice, force it. */
          FIELD(FCR.Target).CurBias = FB_VISIBLE; 
          FCR.Target = FIELD(FCR.Target).ValueList.ChoiceItems[2].EnumText;
       ELSE
          FIELD(FCR.Target).CurBias = FB_CHANGEABLE; 
          FCR.Target = FIELD(FCR.Target).ValueList.ChoiceItems[1].EnumText;
       ENDIF;
/*
** Display Revision information fields if this is a permit revision. 
*/
       SELECT :RevisionDate = RevisionDate,
              :FCR.RP.RevisionNumber = RevisionNumber,
              :FCR.RP.RevisionComment = RevisionComment
       FROM   IR_WorkPermit
       WHERE  WorkPermit = :JIP.Job;

       IF FCR.RP.RevisionNumber > 0 THEN
          FIELD(FCR.RP).CurBias = FB_CHANGEABLE;
       ENDIF;
    ENDIF;
   ENDIF;
/*
** SOA permits or OpOrder permits from FMS
*/
   IF CurrentApplication <> Application$FMS OR (CurrentApplication = Application$FMS AND
        Operator = Operator$OpOrder) THEN
 
    SimpleWP = SimpleWP.RetrieveWorkPermit(Job = JIP.Job);
    IF SimpleWP IS NULL THEN
       SimpleWP = WorkPermit.Create();
       IF CurrentApplication <> Application$FMS THEN
          SimpleWP.ProtectionRequired = TRUE;  /* Default value */
       ELSE
          SimpleWP.ProtectionRequired = FMSProtectionRequired;
          SimpleWP.Description = FMSPermitDescription;
       ENDIF;
    ELSE
       ETC = SimpleWP.EstTimeComplete;
       Warning = SimpleWP.Warning;
       WPSeq.Sequence = SimpleWP.Sequence;
    ENDIF;

    OrigTime = ETC; 
    FIELD(WPSeq).CurBias = FB_CHANGEABLE; 

    IF Operator = Operator$OpOrder THEN
       SkipDisplay = TRUE;
       CurFrame.WindowVisibility = WV_INVISIBLE;
       IF WPSeq.Sequence = 0 THEN
          WPSeq.Sequence = JIP.Job;
       ENDIF;
       CurFrame.SendUserEvent(EventName = 'MakeInvisible');
    ENDIF;
   ENDIF;
END;


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'WPSeq');
END;


ON ENTRY FCR.DistrictOperator =
BEGIN
    RetCode = CALLFRAME DOLogIn (NoLogOut = TRUE);
    IF RetCode = 0 THEN
        RESUME;
    ELSE
        IF DOp.Description = '' THEN
           MESSAGE 'Please select a DO.';
           RESUME;
        ELSE 
           FCR.DistrictOperator = DOp.Description;
        ENDIF;
    ENDIF;                 
END;

/*
**   Handle updating estimated time in service
*/
ON SetValue Day =
BEGIN
    TimeSet = 'NOW';
    IF Day = 0 THEN
       ETC = OrigTime;
    ELSEIF Day = 1 THEN
       ETC = TimeSet + '30 min';
    ELSEIF Day = 2 THEN
       ETC = TimeSet + '1 hour';
    ELSEIF Day = 3 THEN
       ETC = TimeSet + '2 hours';
    ELSEIF Day = 4 THEN
       ETC = TimeSet + '4 hours';
    ELSEIF Day = 5 THEN
       ETC = TimeSet + '8 hours';
    ELSEIF Day = 6 THEN
       ETC = TimeSet + '12 hours';
    ELSEIF Day = 7 THEN
       ETC = TimeSet + '16 hours';
    ELSEIF Day = 8 THEN
       ETC = TimeSet + '24 hours';
    ELSEIF Day = 9 THEN
       ETC = TimeSet + '2 days';
    ELSEIF Day = 10 THEN
       ETC = TimeSet + '3 days';
    ELSEIF Day = 11 THEN
       ETC = TimeSet + '7 days';
    ELSEIF Day = 12 THEN
       ETC = TimeSet + '1 month';
    ENDIF;
END;

ON USEREVENT 'WPSeq',
ON SetValue WPSeq.Sequence =
BEGIN
/*
**  See if the sequence already exists in the move
*/
      MoveSeq = Squeeze(Left(JIP.TOMove,Locate(JIP.TOMove,'-')-1));
      RetCode = ParseTextForInteger(ParseText = MoveSeq);
      IF (RetCode = TRUE) THEN
         TempMove = Right(JIP.TOMove,(Length(JIP.TOMove)-Locate(JIP.TOMove,'-')));
         JIP.TOMove = Varchar(WPSeq.Sequence) + '-' + TempMove;  
         TempMove = Right(JIP.RSMove,(Length(JIP.RSMove)-Locate(JIP.RSMove,'-')));
         JIP.RSMove = varchar(WPSeq.Sequence) + '-' + TempMove;
      ELSE
         TempMove = JIP.TOMove;
         JIP.TOMove = Varchar(WPSeq.Sequence) + '-' + TempMove;  
         TempMove = JIP.RSMove;            
         JIP.RSMove = Varchar(WPSeq.Sequence) + '-' + TempMove;  
      ENDIF;

   IF Operator = Operator$OpOrder THEN
       SkipDisplay = TRUE;
       IF WPSeq.Sequence = 0 THEN
          WPSeq.Sequence = JIP.Job;
       ENDIF;
       CurFrame.SendUserEvent(EventName = 'FinishOK');
   ENDIF;

END;

ON USEREVENT 'FinishOK',
ON Click OKButton =
BEGIN
   IF CurrentApplication = Application$FMS THEN

   IF IssuedOperator = Operator$FCR OR ProcessAutoMode = TRUE THEN
      IF FCR.DistrictOperator = '' THEN 
         MESSAGE 'Please select a District Operator to issue to FCR.';
         RESUME;
      ENDIF;

      IF FCR.Target = '' THEN
         MESSAGE 'More than one divisional target FCR is possible, ' +
                 'please select the division.';
         RESUME;
      ENDIF;

      IF FCR.Target LIKE 'WEST%' THEN
         FCR.Target = 'W';
       ELSEIF FCR.Target LIKE 'STAT%' THEN
         FCR.Target = 'R';  
       ELSEIF FCR.Target LIKE 'BRON%' THEN
         FCR.Target = 'X';  
       ELSEIF FCR.Target LIKE 'MANH%' THEN 
         FCR.Target = 'M';  
       ELSEIF FCR.Target LIKE 'BROO%' THEN 
         FCR.Target = 'B';  
       ELSEIF FCR.Target LIKE 'QUEE%' THEN
         FCR.Target = 'Q' ;
       ELSE
         MESSAGE 'Division ' + FCR.Target + ' is not valid.  Unable to ' +
                 'issue permit to a proper Target FCR.';
         RETURN (PU_CANCEL);    
       ENDIF;
    ENDIF;

    RetCode = CALLPROC FMS_WPEstRestoreTimeUpd(
                Job = JIP.Job,
                EstTimeComplete = ETC,
                Warning = Warning);
    IF RetCode <> 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Unable to save Estimated Time of restore,  ' +
                'Please try again.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;

    IF IssuedOperator = Operator$FCR OR ProcessAutoMode = TRUE THEN
/*
** Save DO Comment to database if there is one.
*/
       IF FCR.RP.DOComment <> '' THEN
          RetCode = CALLPROC IR_WPRevisionUpd (
                      WorkPermit = JIP.Job,
                      RevisionDate = RevisionDate,
                      RevisionNumber = FCR.RP.RevisionNumber,
                      RevisionComment = FCR.RP.DOComment + '; ' +
                                        FCR.RP.RevisionComment);
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Unable to save additional DO Comment to send to FCR.';
             RESUME;
          ENDIF;
       ENDIF;
/*
** Count linked Protection Moves at Issue.
*/
       PMC = 0;
       SELECT :PMC = COUNT(*)
       FROM   FMS_WorkPermitProtection
       WHERE  PermitCardType = 0 AND  /* non-TLS */
              PermitJobID = :JIP.Job;

       RetCode = IR_IssueFCRWorkPermit (TargetFCR = FCR.Target, 
					DOName =   FCR.DistrictOperator,
                                        Workpermit = JIP.Job,
                                        PermitStatus = Permit$Initialized,
                                        ProtectionMoveCount = PMC);
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Error electronically issuing permit to FCR.';
          RETURN (PU_CANCEL);
       ENDIF;
       CALLPROC DDB_COMMIT;
       MessageField = 'The Permit was electronically issued to the FCR.';
/*
**  Delete any previous unacknowledged messages to FCR for this permit.
*/
       i = 0;
       SELECT :i = M.MsgKey
       FROM    IR_WorkPermit P,
               Msg_Message M
       WHERE   P.WorkPermit = :JIP.Job AND
               P.MsgKey = M.MsgKey AND
               M.DelByOpName = '';
       CALLPROC DDB_ROLLBACK;
       
       If i <> 0 THEN  /* delete message */
          RetCode = Msg_UpdateMsg (Card = C.Card,
                        Ack = Ack$Delete,
                        MsgKey = i,
                        AckByOpName = 'FCRInterface',
                        AckDate = date('now'),
                        DelByOpName = 'FCRInterface',
                        DelDate = date('now'),
                        Substation = C.Feeder);
          CALLPROC DDB_COMMIT;
/*
** Log in trace window if this failed.  Not that big of deal.
** D.O. will just have to do it manually.
*/
          IF RetCode < 0 THEN
             CALLPROC DDB_ROLLBACK;
             CurFrame.Trace (Text = VARCHAR(date('now')) +
                    ': Error - System was not able to ' +
                    'automatically delete previous outgoing ' + 
                    'message from PromptEnterETR screen.');
          ENDIF; 
       ENDIF;
/*
** Now insert message for tracking purposes.
*/
       IF PermitUpdate = FALSE THEN
          MsgMessage = 'Work Permit Issued to FCR.' + HC_NEWLINE +
                       'Permit that was issued:' + HC_NEWLINE +
                       MoveText;
       ELSE
          MsgMessage = 'Issued Permit Revision sent to FCR.' + HC_NEWLINE +
                       'Permit that was revised:' + HC_NEWLINE +
                       MoveText;
       ENDIF;
     
       IF ProcessAutoMode = FALSE THEN
          MsgKey = CALLPROC MSG_SendMsg (Card = C.Card,
                                  Action = 0,
                                  OrderNumber = IFNULL(JIP.Job,0),  
                              	  Substation = C.Feeder,
                                  SubstationName = C.FeederName,
                                  Msg = MsgMessage,
                                  FromOpName = FCR.DistrictOperator,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FCR',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
          IF MsgKey < 0 THEN
             CALLPROC DDB_ROLLBACK;
             MessageField = MessageField + '  The system was, however, ' +
              'unable to record the outgoing message.' + 
              '  You might want to contact the FCR to ' +
              'confirm that he has received the permit.  He will not be ' +
              'able to acknowledge receipt of the permit electronically';

             MESSAGE :MessageField;
          ELSE
             CALLPROC DDB_COMMIT;
             RetCode = CALLPROC IR_IssuePermitMsgUpd (MsgKey = MsgKey,
                                        WorkPermit = JIP.Job);
             IF Retcode = 0 THEN
                CALLPROC DDB_COMMIT;
/*
** This message no longer being displayed to streamline user interface.
*/
                MessageField = MessageField + '  An outgoing message was created. ' +
                         'If the FCR has not acknowledged ' +
                         'the permit in ten minutes, you may have to contact ' +
                         'him to confirm receipt of the permit.';
             ELSE
                CALLPROC DDB_ROLLBACK;
                MessageField = MessageField + '  The system was, however, ' +
                 'unable to record the outgoing message id.' + 
                 '  You might want to contact the FCR to ' +
                 'confirm that he has received the permit.  He will not be ' +
                 'able to acknowledge receipt of the permit electronically';

                 MESSAGE :MessageField;
             ENDIF;
          ENDIF;

/*
** Set the FCR Permit Status to ISSUED.
*/
          RetCode = CALLPROC IR_WorkPermitStatusUpd (
                      WorkPermit = JIP.Job,
                      PermitStatus = Permit$Issued);
          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Warning: Permit Status update failed.  Permit will be ' +
                  'sent to the FCR but the Issued timestamp on the front ' +
                  'of the card cannot be dimmed.  Watch your Outgoing ' +
                  'Messages for FCR Acknowledgment';
          ENDIF;
          CALLPROC DDB_COMMIT;

          ControlText = VARCHAR(JIP.Job);
          CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_FCRPermitIssued',
                     EventText = ControlText);  
                     
          IF PermitUpdate = FALSE THEN
             CALLPROC SOA_LogIns (Card = C.Card,
                        SwitchingItem = 0,
                        Job  = JIP.Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Rapid Restore',
                        New  = 'Permit Issued to FCR',
                        Old  = '');
             CALLPROC DDB_COMMIT;
          ELSE
             CALLPROC SOA_LogIns (Card = C.Card,
                        SwitchingItem = 0,
                        Job  = JIP.Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Rapid Restore',
                        New  = 'Permit Update sent to FCR',
                        Old  = '');
             CALLPROC DDB_COMMIT;       
          ENDIF;

       ELSE
/* 
** Save order for Process Automation Execution.
*/    
          CALLFRAME DefineAutoBlock (
                  Card = C.Card,
                  Block = JIP.Job,
                  SendTo = 'FCR',
                  Title = JIP.TOMove);

          IF PermitUpdate = FALSE THEN
             CALLPROC SOA_LogIns (Card = C.Card,
                        SwitchingItem = 0,
                        Job  = JIP.Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Rapid Restore',
                        New  = 'Permit Issued to FCR',
                        Old  = 'via Automation');
             CALLPROC DDB_COMMIT;
          ELSE
             CALLPROC SOA_LogIns (Card = C.Card,
                        SwitchingItem = 0,
                        Job  = JIP.Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Rapid Restore',
                        New  = 'Permit Update sent to FCR',
                        Old  = 'via Automation');
             CALLPROC DDB_COMMIT;       
          ENDIF;

       ENDIF;
    ENDIF;
   ENDIF;
/*
** SOA permits or OpOrder permits from FMS
*/
   IF CurrentApplication <> Application$FMS OR (CurrentApplication = Application$FMS AND
        Operator = Operator$OpOrder) THEN

       RetCode = CALLPROC SOA_JobMoveTextUpd (
                  Job = JIP.Job,
                  RSMove = JIP.RSMove,
                  TOMove = JIP.TOMove);

       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Unable to save permit move text changes.  Try again.';
          RESUME;
       ELSE
          CALLPROC DDB_COMMIT;
       ENDIF;
      
    SimpleWP.EstTimeComplete = ETC;
    SimpleWP.Warning = Warning;
    SimpleWP.Sequence = WPSeq.Sequence;
     
    RetCode = SimpleWP.UpdateWorkPermit(PermitJobID = JIP.Job);
      
    IF RetCode = PU_CANCEL THEN
        RESUME;
    ENDIF;

   ENDIF;
   RETURN (PU_OK);
END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;



					 *Default Item

						 *Default Item

					 *Default Item


Application Component Report
============================

	Name:            PromptEnterFault

/*
**  Application:    FMS FeederCard
**  Frame:          PromptEnterFault
**
**  Modifications: 
**   03/11/94	 pw	created
**   06/04/94	 pw	changes at con_ed to add phrases
**   11/08/94	 em	exclude abstract htv; add repeatedf
**   07/25/98   em   made Grouper exclusion consistent
**   11/10/00   pkw  send message to CSD monitor.
**   04/10/01   my   Raise DBEvent.
**   05/10/01   my   If the card type is trouble card, then raise dbevent.
**   11/01/01   em	Only raise the fault event to IR if the move is issued.
**                   Also raise the fault event on exit if the move is
**                   issued so that if the DO entered the Fault, before
**                   issuing the move, the fault still gets downloaded when
**                   the screen is diplayed.
**   01/03/02   pkw  Download faults for all card types.
**   01/06/02   pkw  Don't download fault info if card not cutout.
**   05/03/02   pkw  Modify csd message text.
**   09/30/02   ysp  Merge:use soa db proc to save the move text.
**   11/04/02   ysp  Log Fault updates in card transaction log. 
**   11/07/02   em   Job to JIP
**   04/10/03   em   Remove use of CardDetails global; Add Fault Change
**                   Request Comment display capability.
**   04/14/03   em   Remove Load_Data event to build screen size once only.
**   04/15/03   em   Changed select to get card data to avoid card=0 problem
**   05/09/03   em   Add support for CIOA
**   09/16/03   em   Added support for FOD Faults
**                   FODResponseType will be returned as a BYREF.
**   09/25/03   em   Don't allow Rejection or Change Request if Fault
**                   is an update.  Don't download Fault to FCR if it
**                   is rejected or change requested. 
**   11/11/03   em   Don't copy PrintID or Equip Type to move text.
**   12/18/03   em   Exit if in Process Auto Setup Mode.
**   12/14/05   ysp  increase the size of FaultJOb to 160 chars
**   01/04/06   em   Corrected bug where it was possible to exit without
**                   acknowledging FOD Fault
**   04/13/07   ysp  ITC210: Insert IR interface event in DB event queue
**   04/04/08   em   Adding FOD Fault Phases
**   04/29/08   em   Add timestamp to CAC_RelayOps select.
**   01/07/11   em   Modifications in support of 3G
**   01/09/12   em   Removed SOA_ActiveCard from first select because it was not returning row
**                   when called on Open Card.
**   09/09/16  ysp   For 33kv portion cards, use the main feeder names for outgoing and CSD messages. 
**   12/09/16  ysp   increase the length of description and fod.faultdescription fields.  
*/
INITIALIZE
(
   JIP = JobInProgress;		        /* Passed job */

   Card = FMS_Card;
   ParentFrame = FrameExec;
   i = integer not null;
   RetCode = INTEGER NOT NULL;

   FODAckEmployeeObj = INTEGER NOT NULL WITH DEFAULT;
   FODEmployeeObj = INTEGER NOT NULL WITH DEFAULT;
   FODResponseType = VARCHAR(20) NOT NULL WITH DEFAULT;
   FODTentativeorActual = VARCHAR(20) NOT NULL WITH DEFAULT;
   FODPhaseA = CHAR(3) NOT NULL WITH DEFAULT;
   FODPhaseB = CHAR(3) NOT NULL WITH DEFAULT;
   FODPhaseC = CHAR(3) NOT NULL WITH DEFAULT;
   FODPhaseNV = CHAR(3) NOT NULL WITH DEFAULT; 
   MainFeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   MustSave = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   MsgKey = INTEGER NOT NULL;
   S = FMS_FaultClass;
   S1 = FMS_FaultClass;
   S2 = FMS_FaultClass; 
   SA = Job;
   SB = Job;
   ControlText = Varchar(256) NOT NULL WITH DEFAULT;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods*/
   TargetTypeName       = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**   Only cast parentframe if not called from procedure JobActions
*/   
   MustSave = FALSE;
   IF CurFrame.ParentFrame.ObjectSource.Name = 'MoveDetails' OR 
        CurFrame.ParentFrame.ObjectSource.Name = 'ReturnOperatorMoves' THEN
      ParentFrame = FrameExec(CurFrame.ParentFrame); 
   ENDIF;

   IF ProcessAutoMode = TRUE THEN
      RETURN (PU_OK);
   ENDIF;

   Card.Card = 0;
   REPEATED
   SELECT :Card.Card = C.Card,
          :Card.Feeder = C.Feeder,
          :Card.FeederName = C.FeederName,
          :Card.CardClass = C.CardClass,
          :Card.CardClassName = C.CardClassName,
          :Card.CutOut = C.CutOut,
          :Card.NetworkFeeder = C.NetworkFeeder,
          :Card.TypeOfCard = C.TypeOfCard
   FROM   FMS_Card C,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = C.Card;

   IF Card.Card = 0 THEN
      MESSAGE 'Error on PromptEnterFault.  Unable to select card information ' +
              'related to this Job.  Contact Technical support.';
      RETURN(PU_CANCEL);
   ENDIF;  
   
   MainFeederName = Card.FeederName;  
   IF Card.NetworkFeeder = NetworkFeeder$3G THEN
      Card.Feeder = CardDetails.Object[1].Object;
      
   ELSEIF Card.NetworkFeeder = NetworkFeeder$33KV AND Card.TypeOfCard = TypeOfCard$Portion THEN
      /* use the main feeder name
      */
      SELECT :MainFeederName = C.FeederName
      FROM   FMS_PortionLink L,
             FMS_Card C
      WHERE  L.PortionCard = :Card.Card AND
             L.Card = C.Card;
   ENDIF;
   Field(FeederName).TextValue = MainFeederName; 
/*
** Get the Data for screen display.
*/
   ELA.Clear(); 

   ELA[1].PrintID = '';
   ELA[1].Equip = :Object$Null; 
   ELA[1].EquipName = '';
   ELA[1].EquipClassName  = 'MH';

   ELA[2].PrintID = '';
   ELA[2].Equip = :Object$Null; 
   ELA[2].EquipName = '';
   ELA[2].EquipClassName  = 'P';

   i = 3;
   REPEATED
   SELECT
   DISTINCT
         :ELA[i].PrintID = G.Reference,
         :ELA[i].Equip = O.Object, 
         :ELA[i].EquipName = O.Name,
         :ELA[i].EquipClassName  = O.TypeName
   FROM  Udb_Object O,
         Udb_Grouping G,
         Udb_ExtendedType ET,
         TFMS_CardToObject CTO
   WHERE CTO.Card = :Card.Card AND
         CTO.Object = G.Grouping AND
         G.Relationship = :Interaction$MemberOf AND
         G.Member = O.Object AND
         O.Type = ET.Type AND
         O.Type NOT IN (:Type$AbstractHTV,
                        :Type$ISOGrouper,
                        :Type$Loop) AND 
         ET.SuperType = :Type$Switch
   ORDER BY PrintID, EquipName
   BEGIN
	   i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   ELB = ELA.Duplicate();

   i = 1;
   SELECT :FL[i].FaultType = T.Type,
          :FL[i].FaultTypeName = T.Name
   FROM   Udb_Type T,
          Udb_Supertype S
   WHERE  S.Supertype = :Type$Fault and
          S.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   SELECT :P1[i].FaultPhrase1 = T.Type,
          :P1[i].FaultPhrase1Name = T.Name
   FROM   Udb_Type T,
          Udb_Supertype S
   WHERE  S.Supertype = :Type$FaultPhrase1 and
          S.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   i = 1;
   SELECT :P2[i].FaultPhrase2 = T.Type,
          :P2[i].FaultPhrase2Name = T.Name
   FROM   Udb_Type T,
          Udb_Supertype S
   WHERE  S.Supertype = :Type$FaultPhrase2 and
          S.Type = T.Type
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** Load Fault
*/
   FCR.FaultChangeRequest = '';
   FODEmployeeObj = 0;
   FOD.FODFaultStatus = 0;
   SELECT :S.FaultTypeName = F.FaultTypeName,
          :S.FaultType = F.FaultType,
          :SA.Equip = F.BetweenEquipA,
          :SB.Equip = F.BetweenEquipB,
          :Description = F.FaultDescription,
          :FCR.FaultChangeRequest = F.FCRChangeRequest,
          :FOD.FaultTypeName = F.FaultTypeName,
          :FOD.FODEquipA = F.FODEquipA,
          :FOD.FODEquipB = F.FODEquipB,
          :FOD.FODFaultStatus = F.FODFaultStatus,
          :FOD.FODFaultSent = F.FODFaultSent,
          :FOD.FODContactInfo = F.FODContactInfo,
          :FODEmployeeObj = F.FODEmpObject,
          :FODTentativeorActual = F.FODTentativeOrActual,
          :FODPhaseA = F.FODPhaseA,
          :FODPhaseB = F.FODPhaseB,
          :FODPhaseC = F.FODPhaseC,
          :FODPhaseNV = F.FODPhaseNotVisible,  /*Field in Table should have been named PhaseNotVisible*/
          :FOD.ActualFault.PhaseComment = F.FODPhaseComment
   FROM   FMS_FAULT F
   WHERE  F.Job = :JIP.Job AND
          F.Card = :Card.Card;
   CALLPROC DDB_ROLLBACK;

   IF FODTentativeorActual = 'TENTATIVE' THEN
      FIELD(FOD.TentorAct).TextValue = 'TENTATIVE FAULT';
      FIELD(FOD.ActualFault).CurBias = FB_INVISIBLE;
   ELSEIF FODTentativeorActual = 'ACTUAL' THEN
      FIELD(FOD.TentorAct).TextValue = 'ACTUAL FAULT';
      IF FODPhaseA = 'YES' THEN
         FOD.ActualFault.PhaseA = 1;
      ELSE
         FOD.ActualFault.PhaseA = 0;
      ENDIF;
      IF FODPhaseB = 'YES' THEN
         FOD.ActualFault.PhaseB = 1;
      ELSE
         FOD.ActualFault.PhaseB = 0;
      ENDIF;
      IF FODPhaseC = 'YES' THEN
         FOD.ActualFault.PhaseC = 1;
      ELSE
         FOD.ActualFault.PhaseC = 0;
      ENDIF;
      IF FODPhaseNV = 'YES' THEN
         FOD.ActualFault.PhaseNV = 1;
      ELSE
         FOD.ActualFault.PhaseNV = 0;
      ENDIF;
      FIELD(FOD.ActualFault).CurBias = FB_LANDABLE;
   ELSE
      FIELD(FOD.TentorAct).TextValue = '';
      FIELD(FOD.ActualFault).CurBias = FB_INVISIBLE;
   ENDIF;
/*
** Load Relay Targets
*/
            TargetTypeName = '';
            FOD.Relay.PhaseA = 0;
            FOD.Relay.PhaseB = 0;
            FOD.Relay.PhaseB = 0;
            FOD.Relay.NoPhases = 1;
            SELECT :TargetTypeName = RO.RelayTypeName
            FROM   CAC_RelayOpsControl ROC,
                   CAC_RelayOps RO
            WHERE  ROC.Card = :Card.Card AND
                   ROC.RelayOp = RO.RelayOp AND
                   (RO.Timestamp IS NOT NULL AND RO.Timestamp <> '')
            BEGIN
               /* Look for target that starts with a number and has a Phase letter in it */
               IF TargetTypeName LIKE '\[0-9\]%A%' ESCAPE '\' THEN
                  FOD.Relay.PhaseA = 1;
                  FOD.Relay.NoPhases = 0;
               ELSEIF TargetTypeName LIKE '\[0-9\]%B%' ESCAPE '\' THEN
                  FOD.Relay.PhaseB = 1;
                  FOD.Relay.NoPhases = 0;
               ELSEIF TargetTypeName LIKE '\[0-9\]%C%' ESCAPE '\' THEN
                  FOD.Relay.PhaseC = 1;
                  FOD.Relay.NoPhases = 0;
               ENDIF;
            END;
     
   IF FODTentativeorActual = 'ACTUAL' THEN
      IF FOD.Relay.PhaseA <> FOD.ActualFault.PhaseA THEN
         FIELD(FOD.ActualFault.PhaseA).ParentField.BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseA).BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseATrim).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseA).ParentField.BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseA).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseATrim).BgColor = CC_RED;
      ENDIF;
      IF FOD.Relay.PhaseB <> FOD.ActualFault.PhaseB THEN
         FIELD(FOD.ActualFault.PhaseB).ParentField.BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseB).BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseBTrim).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseB).ParentField.BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseB).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseBTrim).BgColor = CC_RED;
      ENDIF;
      IF FOD.Relay.PhaseC <> FOD.ActualFault.PhaseC THEN
         FIELD(FOD.ActualFault.PhaseC).ParentField.BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseC).BgColor = CC_RED;
         FIELD(FOD.ActualFault.PhaseCTrim).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseC).ParentField.BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseC).BgColor = CC_RED;
         FIELD(FOD.Relay.PhaseCTrim).BgColor = CC_RED;
      ENDIF;
   ENDIF;
/*
** Prepare other fields on screen
*/
   FaultJob = JIP.TOMove;
   FOD.FaultText = JIP.TOMove;
   FOD.FaultDescription = Description;

   IF FODEmployeeObj <> 0 THEN
      SELECT :FOD.FODName = Description
      FROM   Udb_Object
      WHERE  Object = :FODEmployeeObj;
   ENDIF;
/*
** If fault already processed, don't show any buttons.
** If fault already complete, this is an update, don't allow reject or
** change request.
*/
   IF FOD.FODFaultStatus > Fault$Received THEN
      FIELD(FOD.DOResponse).Curbias = FB_INVISIBLE;
   ELSEIF JIP.TOComplete IS NOT NULL THEN
      FIELD(FOD.DOResponse.Reject_btn).Curbias = FB_INVISIBLE;
      FIELD(FOD.DOResponse.Change_btn).Curbias = FB_INVISIBLE;
   ENDIF;
/*
** Load optional Fault Change
*/
   FODAckEmployeeObj = 0;
   SELECT :DOAck.DOResponseType = ResponseType,
          :DOAck.DOResponseTime = ResponseTime,
          :DOAck.DOComments = DOComments,
          :DOAck.DOName = DOName,
          :FODAckEmployeeObj = FODAckEmpObj,
          :FODAck.FODAckTime = FODAckTime,
          :FODAck.FODAckComments = FODAckComments
   FROM   IR_FaultChange
   WHERE  Job = :JIP.Job;

   IF FODAckEmployeeObj <> 0 THEN
      SELECT :FODAck.FODAckName = Description
      FROM   Udb_Object
      WHERE  Object = :FODAckEmployeeObj;
   ENDIF;
          
   IF FOD.FODFaultStatus > 0 THEN
      FIELD(FOD).CurBias = FB_LANDABLE;
      IF FOD.FODFaultStatus > Fault$Received THEN
         FIELD(FOD.DOResponse).Curbias = FB_INVISIBLE;
      ELSE
         FIELD(FOD.DOResponse).Curbias = FB_LANDABLE;
      ENDIF;
   ENDIF;

   IF DOAck.DOResponseTime <> '' THEN
      FIELD(DOAck).CurBias = FB_LANDABLE;
   ENDIF;

   IF FODAck.FODAckTime <> '' THEN
      FIELD(FODAck).CurBias = FB_LANDABLE;
   ENDIF;
   
   IF FCR.FaultChangeRequest <> '' THEN
      FIELD(FCR).CurBias = FB_LANDABLE;
   ENDIF;
/*
**  Load Division table
*/
   IF SimpleDivision IS NULL THEN
      SimpleDivision = Division_ASE.Create();
   ENDIF;
   
   SimpleDivision.LoadDivisions();
   
   IF SimpleDivision.ReturnCode = 0 THEN
      fd.Clear();
      fd = SimpleDivision.DList.Duplicate();
   ELSE
      Message SimpleDivision.ErrorMessage;
   ENDIF;
   SimpleDivision = NULL;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;


ON CLICK FOD.DOResponse.Acknowledge_btn =
BEGIN
/*
** Send acknowledgement to FOD Monitor.
*/
   FIELD(FOD.DOResponse).Curbias = FB_INVISIBLE;
   CurFrame.Flush();
   MustSave = TRUE;
   FOD.FODFaultStatus = Fault$Reviewed;
   FODResponseType = 'ACKNOWLEDGE';
   ControlText = VARCHAR(JIP.Job) + ';' + DOp.Description + ';' + 
                 FODResponseType + ';';
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_FaultResponse',
                     EventText = ControlText);  

   CALLPROC SOA_LogIns (Card = Card.Card,
                        Job  = JIP.Job,
                        Item = 'FOD Fault',
                        Old  = 'Fault Acknowledged',
                        New  = 'DO ' + DOp.Description,
                        Time = Date('now'),
                        UserName = UserName);   
   CALLPROC DDB_COMMIT;  
END;


ON CLICK FOD.DOResponse.Reject_btn =
BEGIN
/*
** Prompt DO for Rejection reason
*/
   FIELD(RejectPopup).XLeft = FIELD(FOD).XLeft;
   FIELD(RejectPopup).YBottom = FIELD(FOD).YBottom;
   FIELD(RejectPopup).CurBias = FB_CHANGEABLE;
   FIELD(FOD.DOResponse).Curbias = FB_INVISIBLE;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
   MustSave = TRUE;
   FOD.FODFaultStatus = Fault$Rejected;
   FODResponseType = 'REJECT';
END;


ON CLICK FOD.DOResponse.Change_btn =
BEGIN
/*
** Prompt DO for Change Request reason
*/
   FIELD(RejectPopup).XLeft = FIELD(FOD).XLeft;
   FIELD(RejectPopup).YBottom = FIELD(FOD).YBottom;
   FIELD(RejectPopup).CurBias = FB_CHANGEABLE;
   FIELD(FOD.DOResponse).Curbias = FB_INVISIBLE;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
   MustSave = TRUE;
   FOD.FODFaultStatus = Fault$ChangeRequested;
   FODResponseType = 'REQUEST_FOR_CHANGE';
END;


ON CLICK RejectPopup.OK_btn =
BEGIN
/*
** Confirm Reason entered and continue.
*/
   IF RejectPopup.DOComment = '' THEN
      MESSAGE 'Please enter reason for Fault Rejection or Fault Change Request.';
      RESUME;
   ENDIF;
   FIELD(RejectPopup).CurBias = FB_INVISIBLE;
   CurFrame.SendUserEvent (EventName = 'CompleteFODResponse');
END;


ON CLICK RejectPopup.Cancel_btn =
BEGIN
/*
** Not completing rejection or cancel, make them do acknowledgement again
*/
   MustSave = FALSE;
   FOD.FODFaultStatus = Fault$Received;
   FODResponseType = '';
   FIELD(RejectPopup).CurBias = FB_INVISIBLE;
   FIELD(FOD.DOResponse).Curbias = FB_CHANGEABLE;
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;


ON USEREVENT 'CompleteFODResponse' = 
BEGIN
/* 
** Save Fault Change info and process FOD response.
*/
   RetCode = CALLPROC IR_FaultChangeIns (
                            Job = JIP.Job,
                            ResponseType = FODResponseType,
                            DOName = DOp.Description,
                            ResponseTime = 'now',
                            DOComments = RejectPopup.DOComment);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Critical Error: Unable to save Fault Response.';
      MustSave = FALSE;
      FOD.FODFaultStatus = Fault$Received;
      FODResponseType = '';
      FIELD(RejectPopup).CurBias = FB_INVISIBLE;
      FIELD(FOD.DOResponse).Curbias = FB_CHANGEABLE;
      CurFrame.IsAutoSized = TRUE;
      CurFrame.Flush();
      RESUME;
   ENDIF;

   ControlText = VARCHAR(JIP.Job) + ';' + DOp.Description + ';' + 
                 FODResponseType + ';';
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FOD',
                     EventName = 'IR_FaultResponse',
                     EventText = ControlText);  

   CALLPROC SOA_LogIns (Card = Card.Card,
                        Job  = JIP.Job,
                        Item = 'FOD Fault',
                        Old  = 'Fault ' + FODResponseType,
                        New  = 'DO ' + DOp.Description,
                        Time = Date('now'),
                        UserName = UserName);   
   CALLPROC DDB_COMMIT;  
/*
** Send Outgoing Message and Record MsgKey
*/
   MsgKey = 0;
   MsgKey = CALLPROC MSG_SendMsg (Card = Card.Card,
                                  Action = 0,
                                  OrderNumber = JIP.Job,
                                  Substation = Card.Feeder,
                                  SubstationName = MainFeederName,
                                  Msg = 'DO has rejected or requested a ' +
                                        'change on an FOD Fault for Feeder ' +
                                        MainFeederName + '.  Contact FOD ' +
                                        'verbally if no response within ten ' +
                                        'minutes.  ' + HC_NEWLINE + 'FOD: ' +
                                        FOD.FODName + HC_NEWLINE +  
                                        'Contact Info: ' + FOD.FODContactInfo,
                                  FromOpName = DOp.Description,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FOD',
                                  FromApp = 'FMS',
                                  Priority = 0
                                  );
   IF MsgKey < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Not able to create an outgoing message.  Followup with FOD ' +
              'verbally to ensure receipt of Fault Rejection or Change Request.';
   ENDIF;

   RetCode = CALLPROC IR_FaultChangeMsgKeyUpd (
                Job = JIP.Job,
                MsgKey = MsgKey);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Not able to save outgoing message reference.  Followup with FOD ' +
              'verbally to ensure receipt of Fault Rejection or Change Request.';
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END;


ON CHILDENTRY ELA = 
BEGIN
   IF S.FaultTypeName = '' THEN
      MESSAGE 'You must select a fault type first.';
      RESUME;
   ENDIF;
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(ELA).CurRow;
      SA.PrintID = ELA[i].PrintID;
      SA.Equip = ELA[i].Equip;
      SA.EquipName = ELA[i].EquipName;
      SA.EquipClassName = ELA[i].EquipClassName;
      FaultJob = FaultJob + SA.EquipName + ' ';

   ENDIF;
END;

ON CHILDENTRY ELB = 
BEGIN
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(ELB).CurRow;
      SB.PrintID = ELB[i].PrintID;
      SB.Equip = ELB[i].Equip;
      SB.EquipName = ELB[i].EquipName;
      SB.EquipClassName = ELB[i].EquipClassName;
      FaultJob = FaultJob + ' and  ' + SB.EquipName + ' ';
   ENDIF;
END;

ON CHILDENTRY FL = 
BEGIN
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(FL).CurRow;
      S.FaultTypeName = FL[i].FaultTypeName;
      S.FaultType = FL[i].FaultType;
      FaultJob = FaultJob + S.FaultTypeName + ' ';
   ENDIF;
END;

ON CHILDENTRY P1 = 
BEGIN
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(P1).CurRow;
      S1.FaultPhrase1Name = P1[i].FaultPhrase1Name;
      S1.FaultPhrase1 = P1[i].FaultPhrase1;
      FaultJob = FaultJob + S1.FaultPhrase1Name + ' ';
   ENDIF;
END;

ON CHILDENTRY P2 = 
BEGIN
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(P2).CurRow;
      S2.FaultPhrase2Name = P2[i].FaultPhrase2Name;
      S2.FaultPhrase2 = P2[i].FaultPhrase2;
      FaultJob = FaultJob + S2.FaultPhrase2Name + ' ';
   ENDIF;
END;

ON CHILDENTRY FD = 
BEGIN
   IF CurFrame.ReasonCode = RC_MouseClick THEN
      i = Field(FD).CurRow;
      IF FD[i].DivisionName <> '' THEN
         FaultJob = FaultJob + 'in ' + FD[i].DivisionName + ' ';
      ENDIF;
   ENDIF;
END;


ON CLICK Save_Btn =
BEGIN
   IF FIELD(RejectPopup).CurBias <> FB_INVISIBLE THEN
      MESSAGE 'Please enter Fault Rejection or Change Request Reason and ' +
              'click OK';
      RESUME;
   ENDIF;

   IF FIELD(FOD.DOResponse).Curbias = FB_LANDABLE AND 
        FIELD(FOD).Curbias = FB_LANDABLE THEN
      MESSAGE 'You must process the incoming FOD Fault.  Please ' +
              'Acknowledge, Reject, or Request Change.';
      RESUME;
   ENDIF;

   IF FOD.FODFaultStatus = Fault$Received THEN
      IF CurFrame.ConfirmPopup (MessageText = 'You have not acknowledged the ' +
              'Fault sent from the FOD.  Please initiate Fault Review from ' +
              'Incoming Message screen.') = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;
      
   RetCode = CallProc SOA_JobMoveTextUpd(
  			             TOMove = FaultJob,
   			          RSMove = FaultJob,
   			          Job = JIP.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to update job,  please try again.';
      RESUME;
   ENDIF; 
   CALLPROC DDB_COMMIT;
   
   IF FaultJob <> JIP.RSMove THEN
      FCFrame.SendUserEvent (EventName = 'load_jobs');
   ENDIF;
   JIP.RSMove = FaultJob;
   JIP.TOMove = FaultJob;

   IF S.FaultTypeName = '' THEN
      Message 'You have not selected a Fault Type,  ' +
              'please try again.';
      RESUME;
   ENDIF;
   RetCode = CALLPROC FMS_FaultIns
            (Card = Card.Card,
             Job = JIP.Job,
             Feeder = Card.Feeder,
             FaultType = S.FaultType,
             FaultTypeName = S.FaultTypeName,
             BetweenEquipA = SA.Equip,
             BetweenEquipB = SB.Equip,
             FaultDescription = Description,
             FODFaultStatus = FOD.FODFaultStatus
             );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to enter fault,  please try again.';
      RESUME;
   ENDIF; 
   CALLPROC DDB_COMMIT;
/*
** Raise DBEvent to FCR
*/
   IF Card.CardClassName <> 'TEST' AND 
      JIP.TOIssued IS NOT NULL AND
      FOD.FODFaultStatus <> Fault$Rejected AND
      FOD.FODFaultStatus <> Fault$ChangeRequested AND
      Card.Cutout IS NOT NULL THEN

      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_FaultIdentification',
                     EventText = VARCHAR(JIP.Job));  
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                     ,MessageText = 'Feeder ' + MainFeederName + 
                     ' Fault identified - Verify SSO preparing to remove test'
                     ,Time = date('now')
                     ,Priority = 0
                     ,MessageType = 0
                     ,Card = Card.Card);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      message 'Could not send automated message to CSD. You may ' +
                 'want to tell CSD to verify SSO preparing to remove test.';
   ENDIF;
   CALLPROC DDB_COMMIT;

/* log fault update */
   CALLPROC SOA_LogIns (Card = Card.Card,
                        Job  = JIP.Job,
                        Item = 'Fault',
                        Old  = 'Fault Info Inserted or Updated',
                        New  = JIP.TOMove,
                        Time = Date('now'),
                        UserName = UserName);   
   CALLPROC DDB_COMMIT;

   ParentFrame.SendUserEvent (EventName = 'UpdateMoves');
   RETURN PU_OK;
END;


ON CLICK Exit_Btn =
BEGIN
/*
** Cannot leave if FOD Fault has not been processed.
*/
   IF FIELD(RejectPopup).CurBias <> FB_INVISIBLE THEN
      MESSAGE 'Please enter Fault Rejection or Change Request Reason and ' +
              'click OK';
      RESUME;
   ENDIF;

   IF MustSave = TRUE THEN
      MESSAGE 'Please use OK button to record status change for the FOD Fault.';
      RESUME;
   ENDIF;
 
   IF FOD.FODFaultStatus = Fault$Received THEN
      MESSAGE 'You must complete processing of the Incoming Fault.';
      RESUME;
   ENDIF;
/*
** Raise DBEvent to FCR
*/
   IF (Card.CardClass = Type$OOE1 OR 
       Card.CardClass = Type$Auto OR 
       Card.CardClass = Type$CIOA OR 
       Card.CardClass = Type$FOT) AND 
       JIP.TOIssued IS NOT NULL AND
       FOD.FODFaultStatus <> Fault$Rejected AND
       FOD.FODFaultStatus <> Fault$ChangeRequested THEN

      ControlText = VARCHAR(JIP.Job);
      CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_FaultIdentification',
                     EventText = ControlText);  
   ENDIF;

   RETURN PU_OK;
END;


ON WindowClose =                                              
BEGIN
   RESUME;
END;
								 *Default Item


