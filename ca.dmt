Application Component Report
============================

	Name:            PromptNetWProt

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptNetWProt
**
**  Modifications:
**  08/18/92  em    (ON-SITE) Added completion statuses.
**  10/22/92  em    modified per integer/udb 
**  11/09/92  em    modified all 'companion' cards at once 
**  12/20/92 gjc    added window close logic to fix bug 6.
**  01/05/92  em    removed the setting of the netwprotect status. 
**  02/05/93  em    removed networkprotector from Card table.
**  11/04/02  em    Job to JIP. 
**  02/20/04  em    During Automatic Execution, will default to check ok
**  06/03/16  em    NetworkProtection feeder status removal is moved into frame because
**                  for 33kV we prompt for segment.
**  06/28/16  em    Add radiofield per segment 
**  09/14/16  em    Mods to message text at Con Ed
**  11/15/16  pkw   Show status selected for previous network protection
*/

INITIALIZE
(
    JIP = JobInProgress;		/* Job being processed */

    CardObject = FMS_Card DEFAULT NULL;     /* Enables use of class methods */
    FMSCardASE = FMS_Card_ASE DEFAULT NULL; /* Enables use of class methods */
    J = Job;                            /* For Use of Method */
    i = INTEGER NOT NULL WITH DEFAULT;
    k = INTEGER NOT NULL WITH DEFAULT;
    NWPCount = INTEGER NOT NULL WITH DEFAULT;
    NWPJob  = Job;
    NWPState = VARCHAR(10) NOT NULL WITH DEFAULT;
    RetCode = INTEGER;
    STObj = Equipment;
    TempDate = DATE WITH NULL;
) =
BEGIN
   FIELD(Segs).CurBias = FB_INVISIBLE;
/*  
** Read in the card data
*/  
   FMSCardASE = FMS_Card_ASE.Create();		    
   FMSCardASE.Card = JIP.Card;    
   FMSCardASE.ArchiveCard = FALSE;		    
   FMSCardASE.LoadCard();
		   
   IF FMSCardASE.ReturnCode <> 0 THEN
       CALLPROC TraceError(UserMessage = FMSCardASE.ErrorMessage, 
                TraceMessage = 'Error - PromptNetWProt failed to load FMS card ' + 
                VARCHAR(JIP.Card));
       RETURN PU_CANCEL;
   ENDIF;

   CardObject = FMSCardASE.C.Duplicate();
   FMSCardASE = NULL;

   IF CardObject.NetworkFeeder = NetworkFeeder$33kV AND AutomaticExecution = FALSE THEN 
/*
** Check if more than one feeder segment has NetworkProtection status
*/
      Segs.Clear();
      FOR i = 1 TO CardObject.Object.LastRow() DO
         IF CardObject.Object[i].Type <> Type$Feeder THEN
            NWPCount = 0;
            SELECT :NWPCount = Status
            FROM   FMS_ObjectStatus
            WHERE  Object = :CardObject.Object[i].Object AND
                   Status = :Status$NetWProt AND
                   StatusCount >= 1;
            IF NWPCount <> 0 THEN
               Segs.InsertRow (RowNumber=1);
               Segs[1].Object = CardObject.Object[i].Object;
               Segs[1].BaseType = 3;
            ELSE
               TempDate = NULL;
               SELECT :TempDate = L.Time,
                      :k = INT4(L.New)
               FROM   SOA_Log L
               WHERE  L.Card = :JIP.Card AND
                      L.Old = VARCHAR(:CardObject.Object[i].Object) AND
                      lowercase(L.Item) = 'nwp result' AND
                      L.Time IN (SELECT MAX(Time) 
                                 FROM   SOA_Log L2 
                                 WHERE  L2.Card = :JIP.Card AND
                                        lowercase(L2.Item) = 'nwp result' AND
                                        L2.Old = VARCHAR(:CardObject.Object[i].Object));
               IF  TempDate IS NOT NULL THEN   
                  Segs.InsertRow (RowNumber=1);
                  Segs[1].Object = CardObject.Object[i].Object;
                  Segs[1].Inservice = TempDate;
                  Segs[1].NWP = k;
                  Segs[1].BaseType = k;
               ENDIF;            
            ENDIF;
         ENDIF;
      ENDFOR;

      IF Segs.LastRow > 0 THEN
/*
** Build selection display, even if only one seg
*/
         FOR i = 1 TO Segs.LastRow() DO

            SELECT :Segs[i].Description = TypeName + ' '
            FROM   Udb_Object 
            WHERE  Object = :Segs[i].Object;
            k = 1;
            REPEATED
            SELECT :STObj.PrintID = SQUEEZE(G.Reference),
                   :STObj.EquipClassName = O.TypeName,
                   :STObj.EquipName = O.Name
            FROM   Udb_Grouping G,
                   Udb_Object O,
                   Udb_ExtendedType ET
            WHERE  G.Grouping = :Segs[i].Object AND
                   G.Relationship = :Interaction$MemberOf AND  
                   G.MemberType = ET.Type AND 
                   ET.SuperType = :Type$ISOSwitch AND
                   G.Member = O.Object
            ORDER BY 1
            BEGIN
               IF k > 1 THEN
                  Segs[i].Description = Segs[i].Description + '-'; 
               ENDIF;
               Segs[i].Description = Segs[i].Description + STObj.PrintID; 
               k = k + 1;
            END;

            k = 1;
            REPEATED
            SELECT :STObj.PrintID = G.Reference,
                   :STObj.EquipClassName = O.TypeName,
                   :STObj.EquipName = O.Name
            FROM   Udb_Grouping G,
                   Udb_Object O,
                   Udb_ExtendedType ET
            WHERE  G.Grouping = :Segs[i].Object AND
                   G.Relationship = :Interaction$MemberOf AND  
                   G.MemberType = ET.Type AND 
                   ET.SuperType = :TypeName$ST AND
                   G.Member = O.Object
            BEGIN
               IF k = 1 THEN
                  Segs[i].Description = Segs[i].Description + ' with '; 
               ELSE
                  Segs[i].Description = Segs[i].Description + ', '; 
               ENDIF;
               Segs[i].Description = SQUEEZE(Segs[i].Description + ' ' + STObj.PrintID + ' ' + 
                                             STObj.EquipName); 
               k = k + 1;
            END;
         ENDFOR;
         FIELD(Segs).CurBias = FB_CHANGEABLE;
         FIELD(Reg_NWP).CurBias = FB_INVISIBLE;
      ENDIF; 
   ENDIF;

   IF AutomaticExecution = TRUE THEN
      CurFrame.WindowVisibility = WV_INVISIBLE;
      CurFrame.SendUserEvent (EventName = 'CompleteWithDefault');
   ENDIF;
END;

ON ChildSetValue Segs[*].NWP = 
BEGIN
   IF Segs[].BaseType < 3 AND Segs[].NWP = 3 THEN
      MESSAGE 'You can not set status back to ''Incomplete''';
      Segs[].NWP = Segs[].BaseType;
   ENDIF;
END;

ON Click ok_btn,
ON USEREVENT 'CompleteWithDefault' = 
DECLARE
   NetWProtRemains = INTEGER NOT NULL WITH DEFAULT;                              
BEGIN
/*
** Evaluate 33kV Segment selection, At least one row must be selected.
*/
   NetWProtRemains = FALSE;  
   IF FIELD(Segs).CurBias = FB_CHANGEABLE THEN
      i = 1;
      WHILE i <= Segs.LastRow() DO
         IF Segs[i].NWP < 3 THEN
            IF Segs[i].NWP = 1 THEN
               NWPState = 'Waived';
            ELSEIF Segs[i].NWP = 2 THEN
               NWPState = 'Check OK';
            ENDIF;
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;

      IF i > Segs.LastRow() THEN
         MESSAGE 'Please mark 33kV segments where Network Protection Check was performed.';
         RESUME;
      ENDIF;
/*
** Is there an outstanding NWP remaining?  remove from array
*/
      i = 1;
      WHILE i <= Segs.LastRow() DO
         IF Segs[i].NWP = 3 THEN
            NetWProtRemains = TRUE; 
            k = CardObject.Object.LastRow;
            WHILE k >= 1 DO
               IF Segs[i].Object = CardObject.Object[k].Object THEN
                  CardObject.Object.RemoveRow (RowNumber = k);
               ENDIF;
               k = k - 1;
            ENDWHILE;
         ELSE
            /*
            ** Log all Segment that are ok or waived
            */
            IF Segs[i].BaseType <> Segs[i].NWP THEN
               CALLPROC SOA_LogIns (
                    Card = JIP.Card,
                    Job  = JIP.Job,
                    SwitchingItem = 0,
                    Time = DATE('Now'), 
                    UserName = UserName,
                    Item = 'NWP Result',
                    Old  = varchar(Segs[i].Object),
                    New  = VARCHAR(Segs[i].NWP));
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
         i = i + 1;
      ENDWHILE;
/*
** Insert new Network if segments remain
*/
      IF NetWProtRemains = TRUE THEN
         SELECT DISTINCT
           :NWPJob.StepPair = JCC.StepPair, 
           :NWPJob.Seq = JCC.Seq,
           :NWPJob.MoveEquipClass = JCC.EquipClass, 
           :NWPJob.JobClass = JC.JobClass, 
           :NWPJob.MoveType = JC.MoveType, 
           :NWPJob.TOMove = JC.TOMove, 
           :NWPJob.RSMove = JC.RSMove, 
           :NWPJob.TOMoveRules = JC.TOMoveRules,
           :NWPJob.RSMoveRules = JC.RSMoveRules
         FROM    FMS_JobClass JC, 
                 FMS_JobClassControl JCC
         WHERE   JC.JobClass = :Move$NetworkProtectionCheck AND
                 JC.JobClass = JCC.JobClass AND
                 JCC.TypeOfCard = :CardObject.TypeOfCard; 

         NWPJob.Equip = 0; 
         NWPJob.Card = CardObject.Card;
         RetCode = CALLPROC InsertJobsRow (
                      NewJob = NWPJob,
                      C = CardObject,
                      ByPassDuplicateMessage = TRUE,
                      SingleCardInsertion = TRUE);

         IF RetCode IS NULL THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 'Replacement Network Protector Check move insertion failure',
                         TraceMessage = 'Error - PromptNetWProt ' +                         
                         'failed to insert replacement Network Protector Check move for card ' + 
                         VARCHAR(CardObject.Card) );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

   ENDIF;
/*
** Network Protection Feeder Status Removal
*/
   FOR i = 1 TO CardObject.Object.LastRow() DO
      RetCode = CALLPROC FMS_ObjStatDel (
                        Object = CardObject.Object[i].Object,
                        Status = Status$NetWProt);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Network Protector Check status did not get removed for ' +
                        'Feeder ' + CardObject.Object[i].Name + '.' + 
                        'Warnings related to network protector check move will ' +
                        'be received because of this error.',
                        TraceMessage = 'Error - PromptNetWProt ' +                         
                        'failed to remove Network Protector Check status for feeder ' + 
                        VARCHAR(CardObject.Object[i].Object) );
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;

   IF FIELD(Reg_NWP).CurBias = FB_CHANGEABLE THEN
      NWPState = FIELD(Reg_NWP.nwpcheck).CurEnumText;
   ENDIF;

   JIP.Response = Squeeze (JIP.Response + ' ' + NWPState);
   J.Job = JIP.Job;
   J.Response = JIP.Response;
   J.ResponseUpd();

   RETURN (PU_OK);	
END;

