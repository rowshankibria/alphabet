METHOD UpdateRestriction(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;

   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ReplaceRestriction = '' THEN
      CurObject.ReplaceRestriction = 'Replace';
   ENDIF;

   RetCode = CALLPROC FMS_ReplaceRestriction(RestrictionID = CurObject.RestrictionID,
                                     ReplaceRestriction = CurObject.ReplaceRestriction);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurMethod.Trace(Text = VARCHAR(DATE('Now')) + ': Failed to update restriction ' + VARCHAR(CurObject.RestrictionID));
      CurObject.ErrorMessage = 'Failed to update restriction number with new value: ' + CurObject.ReplaceRestriction;                               
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RETURN;
END;

