METHOD LoadPocket(
   Pocket = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE

BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CALLPROC NetworkTraceProcs(
                    ProcName = 'LoadNetwork',
                    Pocket = Pocket); 
END;

METHOD GetPocketEquipment(
   Pocket = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CALLPROC NetworkTraceProcs(
                    ProcName = 'GetPocketEquipment',
                    Pocket = Pocket,
                    EquipList = ByRef(CurObject.EquipList),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));
END;

/* ===================================================================================
** Input:
** 1. StartEquip - list of equipment (ID and pocket) in each pothead structure of 
**    the feeder
** Output:
** 1. TracedPathResults - list of paths from the start equipment with
**    equipment collected along the path.
** 2. TracedStructures - list of all distinct structures found during the trace.
*/
METHOD TraceForNewCard(
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForNewCard',
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    TracedStructures = byref(CurObject.TracedStructures),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

/* ===================================================================================
** Input:
** 1. PumpPlant - ID of the pump plant
** 2. StartEquip - for header valves trace, a feeder flange (ID & pocket) in the pump 
**    plant; for ladder valves trace, a pump (ID & Pocket). The equip must be in the 1st 
**    element of the array (note: only the ID & pocket are used to trace)
** Output:
** 1. TracedPathResults - list of valves in the header or ladder - open or closed - 
**    in the pump plant.
** 2. TracedStructures - list of all distinct structures found during the trace.
*/
METHOD TraceForPumpPlantValves(
   Pumpplant = INTEGER NOT NULL,
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForPumpPlantValves',
                    PumpPlant = Pumpplant,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    TracedStructures = byref(CurObject.TracedStructures),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

/* ===================================================================================
** Input:
** 1. Feeder - ID of the feeder to be isolated
** 2. StartEquip - list of equipment (ID & pocket) in each pothead structure of the feeder
** Output:
** 1. TracedPathResults - list of valves that are common among feeders in the pump 
**    plant headers  .
** 2. TracedStructures - list of pump plants and pot head structures found during the trace.
*/
METHOD TraceForFeederIsolation(
   Feeder = INTEGER NOT NULL,
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForFeederIsolation',
                    Feeder = Feeder,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    TracedStructures = byref(CurObject.TracedStructures),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

/* ===================================================================================
** Input:
** 1. StartEquip - the pump (ID & Pocket) in the 1st element of the array
** 2. IssuedOperator - ID of operator to whom a move is issued to
** Output:
** 1. Method returns an integer:
**    - TRUE - there is a open line betwen a tank and the pump 
**    - FALSE - there is NOT a open line betwen a tank and the pump.
*/
METHOD TraceForOpenLineToTank(
   StartEquip = ARRAY OF DSO_trace_engine!Equipment,
   IssuedOperator = INTEGER NOT NULL
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CheckStatus = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CheckStatus = FALSE;

   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForOpenLineToTank',
                    IssuedOperator = IssuedOperator,
                    StartEquip = StartEquip,
                    CheckStatus = byref(CheckStatus),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

   RETURN CheckStatus;  
END;

/* ===================================================================================
** Input:
** 1. StartEquip - the pump (ID & Pocket) in the 1st element of the array
** 2. IssuedOperator - ID of operator to whom a move is issued to
** Output:
** 1. TracedPathResults - list of relief valves that have open paths to tanks.
**    Based on the valve types and the number of valves in this list to determine
**    if there is a safety relief line or other relief lines.
*/
METHOD TraceForReliefLine(
   StartEquip = ARRAY OF DSO_trace_engine!Equipment,
   IssuedOperator = INTEGER NOT NULL
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForReliefLine',
                    IssuedOperator = IssuedOperator,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

/* ===================================================================================
** Input:
** 1. Feeder - ID of the feeder 
** 2. StartEquip - list of equipment (ID & Pocket) in each pothead structure of the 
**    feeder
** Output:
** 1. TracedPathResults - the pressuring pump that is reached when a trace from a
**    feeder potheads is taken through open valves. The pressurization source
**    is identified as the not-off pump with the lowest reference relationship 
**    to the feeder. TracedPathResults[1].TargetEquip[1] is the pressuring pump.
*/
METHOD TraceForPressureSource(
   Feeder = INTEGER NOT NULL,
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForPressureSource',
                    Feeder = Feeder,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

/* ===================================================================================
** Input:
** 1. PumpPlant - ID of the pump plant
** 2. StartEquip - the pressurizing pump (ID & Pocket). The pump must be in the 1st 
**    element of the array (note: only ID & Pocket are used to trace)
** Output:
** 1. TracedPathResults:
**    -Element [1]: list of valves in the ladder section
**    -Element [2]: the closed valve that connects directly to the reduced pressure 
**     relief valve 
*/
METHOD TraceForReducedPressure(
   Pumpplant = INTEGER NOT NULL,
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ReliefValveTypes = ARRAY OF INTEGEROBJECT;
   ReliefType = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Status = INTEGER NOT NULL WITH DEFAULT;
   TempStartEquip = ARRAY OF DSO_trace_engine!Equipment
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   /*
   ** get all valves in the ladder 
   */   
   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForPumpPlantValves',
                    PumpPlant = Pumpplant,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

   /*
   ** Identify the reduced pressure relief valve as the Start equipment
   ** for the next trace
   */
   ReliefValveTypes.Clear();
   i = 1;
   SELECT :ReliefValveTypes[i].Value = ET.Type
   FROM   UDB_ExtendedType ET
   WHERE  ET.SuperType = :Type$ReliefValve
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;   
   
   TempStartEquip.Clear();
   FOR i = 1 TO CurObject.TracedPathResults[1].TargetEquip.LastRow DO
      RetCode = ReliefValveTypes.Find(AttributeName = 'value',
                  Value = CurObject.TracedPathResults[1].TargetEquip[i].Type);
      IF RetCode = ER_OK THEN
         ReliefType = 0;
         SELECT :ReliefType = ReliefValveType
         FROM   Udb_ReliefValve
         WHERE  Object = :CurObject.TracedPathResults[1].TargetEquip[i].Object;
            
         IF ReliefType = Type$ReliefValve_Reduced THEN
            TempStartEquip[1].Object = CurObject.TracedPathResults[1].TargetEquip[i].Object;
            TempStartEquip[1].Pocket = CurObject.TracedPathResults[1].TargetEquip[i].Pocket;
            ENDLOOP;
         ENDIF;
      ENDIF;
   ENDFOR;

   IF TempStartEquip.LastRow = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Connectivity trace fails to identify the Reduced Pressure ' + 
              'Relief Valve in the pump ladder';
      RETURN;
   ENDIF;

   /*
   ** get the closed valve that connects directly to the reduced pressure 
   ** relief valve
   */
   CurObject.TempPathResults.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForReducedPressure',
                    PumpPlant = Pumpplant,
                    StartEquip = TempStartEquip,
                    TracedPathList = byref(CurObject.TempPathResults),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

   IF CurObject.ReturnCode = 0 AND
      CurObject.TempPathResults[1].TargetEquip.LastRow = 1 THEN 
      /* remove the closed valve from the first trace result
      */
      Status = CurObject.TracedPathResults[1].TargetEquip.Find(
                           AttributeName = 'object',
                           Value = CurObject.TempPathResults[1].TargetEquip[1].Object,
                           RowNumber = ByRef(i));
      IF Status = ER_OK THEN
         CurObject.TracedPathResults[1].TargetEquip.RemoveRow(RowNumber = i);
      ENDIF;
      
      /* add the closed valve to the TracedPathResults in the 2nd element of the array
      */
      CurObject.TracedPathResults[2] = dso_trace_engine!PathTraceResult.Create();
      CurObject.TracedPathResults[2].TargetEquip[1] = DSO_trace_engine!Equipment.Create();
      CurObject.TracedPathResults[2].TargetEquip[1] = CurObject.TempPathResults[1].TargetEquip[1];
   ENDIF;
END;
/* ===================================================================================
** Input:
** 1. Plant - ID of the dielectric facility where Readings to be performed
** 2. StartEquip - list of tanks and nitro nodes in the Plant
** Output:
** 1. TracedPathResults - list of equipment within Plant to include gauges where readings will take place.
** 2. Must add tank compartments manually.
*/
METHOD TraceForFullReadings(
   Plant = INTEGER NOT NULL,
   StartEquip = ARRAY OF DSO_trace_engine!Equipment
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.TracedPathResults.Clear();
   CurObject.TracedStructures.Clear();

   CALLPROC NetworkTraceProcs( 
                    ProcName = 'TraceForFullReadings',
                    Plant = Plant,
                    StartEquip = StartEquip,
                    TracedPathList = byref(CurObject.TracedPathResults),
                    ReturnCode = ByRef(CurObject.ReturnCode),
                    ErrorMessage = ByRef(CurObject.ErrorMessage));

END;

Application Component Report
============================

	Name:            DSOOperatingOrder

/*
**
**      Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
**  Application:    CAC
**  Frame:          DSOOperatingOrder
**
**  Date:       Version Description
** ----------------------------------
** 10/27/21       em    DSO version copied from Original
*/ 
INITIALIZE
(
/*
**  Passed Parameters
*/
    Card = INTEGER NOT NULL WITH DEFAULT; /* Passed from TOMS to Limit Substation list */
    LoadOrder = INTEGER NOT NULL WITH DEFAULT;   /*Optional*/
    StatusComplete  = CHAR(1) NOT NULL;
    Substation  = INTEGER NOT NULL WITH DEFAULT;
    
/*
**  Internal Variables
*/
    FO              = ObjectClass;    
    i               = Integer NOT NULL WITH DEFAULT;
    k               = Integer NOT NULL WITH DEFAULT;
    OrderNumber     = Integer NOT NULL WITH DEFAULT;
    LastRow         = INTEGER NOT NULL;
    CurStatus       = Integer NOT NULL;
    TOOperator      = INTEGER WITH NULL;
    RSOperator      = INTEGER WITH NULL;
    OldLog         = VARCHAR(100) NOT NULL;
    RetCode 	   = INTEGER NOT NULL;
    TORS           = CHAR(2) NOT NULL;
    ControlText    = VARCHAR(256) NOT NULL /* For DBEVENT */;
) =
BEGIN
    CurFrame.CurMode = FrameExec(CurFrame.ParentFrame).CurMode;    
/* 
** Set up the Search Area 
*/
    FIELD(S).XLeft = (CurFrame.WindowWidth - FIELD(S).Width)/2;
    FIELD(S).YTop = FIELD(O.IssuedByDO).YTop;

    FIELD(menu.oo.download_order).CurBias = MB_DISABLED;
    FIELD(Confirm_btn).CurBias = FB_DIMMED;

    IF LoadOrder = 0 THEN
       CurFrame.SendUserEvent(EventName = 'display selection');
    ELSE

       FIELD(S).CurBias = FB_INVISIBLE;
       OrderNumber = LoadOrder;

       SELECT :Substation = O.Substation
       FROM    IR_DSOOrder O
       WHERE   O.OrderNumber = :OrderNumber;

       CurFrame.SendUserEvent( eventname = 'load_data' );
    ENDIF;   
END;

ON USEREVENT 'display selection' =
BEGIN
/*
** Load Operating orders for desired card.  
*/
   S.Orders.Clear();
   i = 1;
   IF StatusComplete = 'Y' THEN

      IF Substation <> 0 THEN

        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = Application$DSO
        FROM   IR_DSOOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus > :Order$Closed AND
               OO.OrderStatus <> :Order$Cancelled
        ORDER BY
                IssueTime DESC
        BEGIN
           i = i + 1;
        END;

      ELSEIF Card <> 0 THEN

             REPEATED
             SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                     :S.Orders[i].OrderNumber = OO.OrderNumber,
                     :S.Orders[i].SubstationName = O.Name,
                     :S.Orders[i].Substation = OO.Substation,
                     :S.Orders[i].OrderStatus = OO.OrderStatus,
                     :S.Orders[i].Application = Application$DSO
             FROM   IR_DSOOrder OO,
                    Udb_Object O,
                    SOA_ActiveObject AO
             WHERE  AO.Card = :Card AND
                    AO.Object = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
             ORDER BY
                    IssueTime DESC
             BEGIN
                i = i + 1;
             END;
   
      ENDIF;

   ELSEIF StatusComplete = 'N' THEN

      IF Substation <> 0 THEN

        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = Application$DSO
        FROM   IR_DSOOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;

      ELSEIF Card <> 0 THEN

        REPEATED
        SELECT  DISTINCT
                :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = Application$DSO
        FROM   IR_DSOOrder OO,
               Udb_Object O,
               SOA_JobControl JC,
               IR_DSOOrderJob JTS
        WHERE  JC.Card = :Card AND
               JC.Job = JTS.Job AND
               JTS.OrderNumber = OO.OrderNumber AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed 
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;

      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
    
   IF i = 1 THEN
      MESSAGE 'No orders found.  Sometimes it helps to load any ' +
              'type of order then ' +
              'try again for that substation.'; 
      RESUME;
   ELSE
       FOR i = 1 to S.Orders.LastRow() DO

           IF S.Orders[i].OrderStatus = Order$Opened THEN
              S.Orders[i].OrderStatusName = 'Opened';

           ELSEIF S.Orders[i].OrderStatus = Order$Downloaded THEN
              S.Orders[i].OrderStatusName = 'Downloaded';

           ELSEIF S.Orders[i].OrderStatus = Order$Acknowledged THEN
              S.Orders[i].OrderStatusName = 'Acknowledged';

           ELSEIF S.Orders[i].OrderStatus = Order$Rejected THEN
              S.Orders[i].OrderStatusName = 'Rejected';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmRejected THEN
              S.Orders[i].OrderStatusName = 'Confirm Rejected';

           ELSEIF S.Orders[i].OrderStatus = Order$Rescinded THEN
              S.Orders[i].OrderStatusName = 'Rescinded';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmRescinded THEN
              S.Orders[i].OrderStatusName = 'Confirm Rescinded';

           ELSEIF S.Orders[i].OrderStatus = Order$Closed THEN
              S.Orders[i].OrderStatusName = 'Closed';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmClosed THEN
              S.Orders[i].OrderStatusName = 'Confirm Closed';

           ELSEIF S.Orders[i].OrderStatus = Order$Cancelled THEN
              S.Orders[i].OrderStatusName = 'Cancelled';

           ENDIF; 
       ENDFOR;
   ENDIF;

   FIELD(S).ParentField.CurBias = FB_VISIBLE;
   CurFrame.CurMode = FM_QUERY;
   FIELD(S).CurBias = FB_CHANGEABLE;
END;


ON CHILDENTRY S.Orders =
BEGIN
/*
** Load a specific order.
*/     i = 1;
       FIELD(S).CurBias = FB_INVISIBLE;
       CurFrame.CurMode = FM_UPDATE;
       i = FIELD(S.Orders).CurRow;
       IF S.Orders[i].OrderNumber > 0 THEN
           OrderNumber = S.Orders[i].OrderNumber;
           Substation = S.Orders[i].Substation;
           CurFrame.SendUserEvent( eventname = 'load_data' );
       ELSE
           RESUME;
       ENDIF;
END;


ON USEREVENT 'load_data' =
BEGIN       
   FIELD(Confirm_btn).CurBias = FB_DIMMED;
                          
/*
**  Load the operating order data into the frame user classes 
*/
   IF OrderNumber = 0 THEN
      MESSAGE 'No Operating Order Selected.';
      RESUME;
   ENDIF;
/*
**  Select the operating order header information.
*/
   FIELD(O).SetToDefault();

   SELECT       :O.OrderNumber = O.OrderNumber,
                :O.OrderStatus = O.OrderStatus,
                :O.SubstationName = OB.Name,
                :O.IssueTime = O.IssueTime,
                :O.IssuedByDO = O.IssuedByDO,
                :O.AckRejectBySSO = O.AckRejectBySSO,
                :O.AckRejectTime = O.AckRejectTime,
                :O.AckRejectComment = O.AckRejectComment,
                :O.RescindTime = O.RescindTime,
                :O.RescindDO = O.RescindDO,
                :O.RescindType = O.RescindType,
                :O.RescindReasonTypeName = O.RescindReasonTypeName,
                :O.RescindComment = O.RescindComment,
                :O.ReturnTime = O.ReturnTime,
                :O.ReturnBySSO = O.ReturnBySSO,
                :O.ReturnComment = O.ReturnComment
   FROM    IR_DSOOrder O,
                Udb_Object OB
   WHERE   O.OrderNumber = :OrderNumber
   AND     O.Substation = OB.Object;

   i = 1;
   O.InConnectionWith.Clear();
   SELECT :O.InConnectionWith[i].Object = Object,
          :O.InConnectionWith[i].Name = SQUEEZE('Feeder' + ' ' + FeederName)
   FROM   IR_DSOOrderFeeder 
   WHERE  OrderNumber = :OrderNumber 
   BEGIN
       i = i + 1;  
   END;
/*
**  Get the Work Tasks from the Job table.  This is a UNION of the
**  TakeOut(TO) and the Restore(RS) moves from active and archive tables.
*/
        i = 1;
        WL.Clear();
        SELECT  
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].TOIssued = J.TOIssued
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_DSOOrderJob JTS,
                Udb_Object O
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object
        UNION 
        SELECT  J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.RSIssued
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_DSOOrderJob JTS,
                Udb_Object O
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object
        ORDER BY Seq
        BEGIN
        /*
           IF WL[i].ReturnRemark <> '' THEN
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_CYAN;
           ENDIF;
           IF WL[i].BaseKey <> 0 THEN
              FIELD(WL[i].PrintID).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].EquipClassName).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].EquipName).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].LockNumber).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].Combination).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].TOMove).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_GRAY;
           ENDIF;
        */
           i = i + 1;    
        END;
/* 
** Query was too complex, had to separate Archive portion.  
** If previous select returned nothing, then we try to find
** order details in the archive tables.
*  
        IF WL.LastRow() = 0 THEN
           SELECT  
                :WL[i].Printid = J.printid,
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].LockNumber = O.LockNumber,
                :WL[i].Combination = O.Combination,
                :WL[i].TOIssued = J.TOIssued,
                :WL[i].BaseKey = JTS.ParentJob,
                :WL[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark)
        FROM    FMS_ArchiveJob J,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                OO.OrderNumber = JTS.OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                OO.Card = J.Card AND
                J.Equip = O.Object
        UNION 
        SELECT  J.Printid,
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    FMS_ArchiveJob J,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                OO.OrderNumber = JTS.OrderNumber AND
                OO.Card = J.Card AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object
        UNION
        SELECT  
                '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.TOMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.TOIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_ArchiveJob J,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object
        UNION 
        SELECT  '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_ArchiveJob J,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object        
        ORDER BY Seq
        BEGIN
           IF WL[i].ReturnRemark <> '' THEN
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_CYAN;
           ENDIF;
           IF WL[i].BaseKey <> 0 THEN
              FIELD(WL[i].TOMove).BgColor = CC_PALE_GRAY;
           ENDIF;
           i = i + 1;    
        END;

        ENDIF;  /*Archive Select*/
    CALLPROC DDB_ROLLBACK;
 
/*
** IF this order is pending DO's confirmation, enable the Confirmation button.
** if there is not an incoming RETURN message.
*/
   IF O.OrderStatus = Order$Rejected OR
      O.OrderStatus = Order$Closed OR
      (O.OrderStatus = Order$Rescinded AND O.RescindType = 'REQUEST') THEN

      i = 0;
      SELECT :i = Count(*)
      FROM   MSG_Message 
      WHERE  OrderNumber = :OrderNumber AND
             (UpperCase(Msg) Like 'SSO RETURNED ORDER%' OR
              UpperCase(Msg) Like 'SSO RESCINDED ORDER%' OR
              UpperCase(Msg) Like 'SSO REJECTED ORDER%');

      IF i = 0 THEN
         FIELD(Confirm_btn).CurBias = FB_LANDABLE;
      ENDIF;
   ENDIF;      
   CurFrame.SendUserEvent(EventName = 'change_mode');
END;


ON CHILDENTRY WL[*].ReturnRemark =
BEGIN
/*
** Display remark if there is one.
*/
   i = FIELD(WL).WhichRow (cellfield = CurFrame.TriggerField);
   IF i > 0 THEN
      IF WL[i].ReturnRemark <> '' THEN
         FIELD(rmstack).AbsXLeft = FIELD(close_btn).AbsXLeft;
         FIELD(rmstack).AbsYBottom = FIELD(close_btn).AbsYBottom;
         rmstack.ReturnRemark = WL[i].ReturnRemark;
           
         FIELD(rmstack).Curbias = FB_LANDABLE;
         RESUME;
      ENDIF;
   ENDIF;
END;

ON CLICK O.MessageHistory_btn = 
BEGIN
   IF CurrentApplication = Application$FMS THEN
      CALLFRAME MessageHistory(Card = FMS_NewCardGlobal,
                               LoadObject = O.OrderNumber);  
   ELSE
      CALLFRAME MessageHistory(Card = NewCard,
                               LoadObject = O.OrderNumber);
   ENDIF;
END;

ON CLICK rmstack.okbtn = 
BEGIN
   FIELD(rmstack).curbias = FB_INVISIBLE;
END;
/*
**  Change the form mode
*/
ON USEREVENT 'change_mode' =
BEGIN                                      
   IF O.OrderStatus = :Order$Opened THEN
        FIELD(menu.oo.download_order).CurBias = MB_ENABLED;
   ELSE
        FIELD(menu.oo.download_order).CurBias = MB_DISABLED;
   ENDIF;

END;



ON CLICK O.Outstanding_Btn,
ON CLICK O.Closed_Btn =
BEGIN
    IF LOWERCASE(CurFrame.TriggerField.Name) = 'outstanding_btn' THEN
        StatusComplete = 'N';
    ELSEIF LOWERCASE(CurFrame.TriggerField.Name) = 'closed_btn' THEN
        StatusComplete = 'Y';
    ELSE
        StatusComplete = 'F';
    ENDIF;
    CurFrame.SendUserEvent(EventName = 'display selection');
END;



ON CLICK Close_Btn =
BEGIN
        RETURN;
END;

ON CLICK Confirm_Btn = 
BEGIN
   IF CurFrame.ConfirmPopup (MessageText = 
      'Please check that there is no ''SSO RETURNED'', ''SSO REJECTED'' or ''SSO RESCINDED'' ' +
      'incoming message for this order. If no incoming message exists, select OK to continue.') = PU_OK THEN   
      ControlText = UserName + ';' + VARCHAR(OrderNumber) + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnOrders', 
                               DBEventText = ControlText); 
      CALLPROC DDB_COMMIT;
      RETURN;
   ELSE
      RESUME;
   ENDIF;
END;


ON CLICK S.Cancel_Btn =
   BEGIN
       FIELD(S).CurBias = FB_INVISIBLE;
       CurFrame.CurMode = FM_UPDATE;
       IF OrderNumber = 0 THEN
           RESUME;
       ENDIF;
   END;


ON Click Menu.OO.download_Order = 
BEGIN

    IF (Curframe.ConfirmPopup(messagetext = 
              'Downloading Operating Order ' +  
              varchar(O.OrderNumber) + ' for substation ' +
              O.SubstationName + '?')= PU_CANCEL) THEN
        RESUME;
    ENDIF;         
    Controltext = varchar(ordernumber);
    CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_NewOpOrder',
                     EventText = ControlText);  

   FIELD(menu.oo.download_order).CurBias = MB_DISABLED;   
END;





							 *Default Item


Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

