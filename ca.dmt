**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          TV_ASE
**
**  Date:       Version Description
** ----------------------------------
**  05/24/06    pkw     Created.
**  07/23/08    pkw     Only update Auto/CIOA/FOT card types.
**  07/26/11    pkw     Don't track TV on weekends or July 4th
**  07/16/13    pkw     Stop tracking TV at 15:00 on Friday and
**                      Look back 3 days to determine if we should
**                      set flag to limit bogeys.
**  07/26/13    pkw     After talking with Associate Chief, it would be 
**                      helpful to determine whether bogey need to be limited
**                      sooner than waiting for two days so we will use 
**                      forecast and day ahead to limit values earlier.
**  02/05/15    ysp     Add peakload forecast.
**  01/22/19    pkw     Add CERC date logic
**  01/30/19    pkw     Update 4th of July logic
**  01/30/19    pkw     Don't track TV for 4kv cards
*/ 
METHOD TV_Load (
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with 
** Temperature Variabale Forecast History
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
/*
**  IF elist_upd = TRUE we will load current days data.
*/
   IF CurObject.Elist_Upd = TRUE THEN
      SELECT :CurObject.Elist.LogDate = B.LogDate,
             :CurObject.Elist.Actual = B.Actual,
             :CurObject.Elist.Forecast = B.Forecast,
             :CurObject.Elist.DayAhead = B.DayAhead,
             :CurObject.Elist.PeakLoad = B.PeakLoad
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory);
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   CurObject.DList.Clear();
   i = 1;
   SELECT :CurObject.Dlist[i].LogDate      = B.LogDate,
          :CurObject.Dlist[i].Actual       = B.Actual,
          :CurObject.Dlist[i].Forecast     = B.Forecast,
          :CurObject.Dlist[i].DayAhead     = B.DayAhead,
          :CurObject.Dlist[i].TV_Threshold = B.TV_Threshold,
          :CurObject.Dlist[i].PeakLoad = B.PeakLoad
   FROM    TV_BogeyHistory B
   WHERE   B.LogDate >= :CurObject.StartDate AND
           B.LogDate < :CurObject.EndDate
   ORDER BY LogDate DESC
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.Dlist.LastRow() = 0 AND
      CurObject.eList_Upd <> TRUE   THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for specified dates...';
   ENDIF;

   RETURN;
END;

METHOD TV_Insert (
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;  
   TV_BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
   TV_Threshold = FLOAT NOT NULL WITH DEFAULT; 
   TV_Actual = FLOAT NOT NULL WITH DEFAULT;
   TV_Today = DATE NOT NULL WITH DEFAULT;   
   TV_Yesterday = DATE NOT NULL WITH DEFAULT;   
   TV_TwoDayAgo = DATE NOT NULL WITH DEFAULT;   
   IsCERC = INTEGER NOT NULL WITH DEFAULT;
   IsSatCERC = INTEGER NOT NULL WITH DEFAULT;
   IsSunCERC = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Insert Temperature Variabale 
** Forecast History and update any cards based on the values 
** input.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
/*
**  Make sure we have a non-zero value for Yesterdays Actual.
*/
   IF CurObject.Elist.Actual = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Invalid value for Yesterday Actual entered...';
      RETURN;
   ENDIF;
/*
**  Find out the TV_Threshold value.
*/
   TV_BogeyEnabled = FALSE;
   SELECT :TV_BogeyEnabled = TM_BogeyEnabled,
          :TV_Threshold = TV_Threshold
   FROM    FMS_SystemParameters;
   CALLPROC DDB_ROLLBACK;
/*
**  Insert row into table.
*/
   RetCode = CALLPROC TV_BogeyHistoryIns (
                          LogDate = date('now'),
                          Actual  = CurObject.Elist.Actual,
                          Forecast = CurObject.Elist.Forecast,
                          DayAhead = CurObject.Elist.DayAhead,
                          TV_Threshold = TV_Threshold,
                          PeakLoad = CurObject.Elist.PeakLoad);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Unable to insert data.  Please try again...';
      RETURN;   
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  Don't do anything else if TV_BogeyEnabled is false.
*/
   IF TV_BogeyEnabled = FALSE THEN
      RETURN;
   ENDIF;
/*
**  Now update all cards in FMS_Card and FMS_ArchiveCard 
**  that need their bogey status changed.
*/
   /****************************************************************************
   ***********      Update based on Actual value first...      *****************
   ****************************************************************************/

   CurObject.StartDate = date_trunc('day',date('now')) - '30 hours'; /* 6pm two days ago */
   CurObject.EndDate   = date_trunc('day',date('now')) - '6 hours';  /* 6pm prior day */

   i = 1;
   CurObject.cList.Clear();
   IF CurObject.Elist.Actual >= TV_Threshold THEN
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = 1   /* Triggered by Actual */
      FROM   FMS_Card C
      WHERE  C.TV_Bogey = 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             1   
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey = 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         i = i + 1;
      END;
   ELSE
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = 0    /* No Bogey outage */
      FROM   FMS_Card C
      WHERE  C.TV_Bogey > 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             0
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey > 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         i = i + 1;
      END;
   ENDIF;   
   
   IF CurObject.cList.LastRow() > 0 THEN
      CurObject.TV_Update();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   /****************************************************************************
   ***********      Update based on Forecast value next...     *****************
   ****************************************************************************/

   CurObject.StartDate = date_trunc('day',date('now')) - '6 hours'; /* 6pm prior day */
   CurObject.EndDate   = date_trunc('day',date('now')) + '1 day';  /* Get everything from current day */

   i = 1;
   CurObject.cList.Clear();
   IF CurObject.Elist.Forecast >= TV_Threshold THEN
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = 2   /* Triggered by Forecast */
      FROM   FMS_Card C
      WHERE  C.TV_Bogey = 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             2
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey = 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         i = i + 1;
      END;
   ELSE
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = 0   /* Non-bogey outage */
      FROM   FMS_Card C
      WHERE  C.TV_Bogey > 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             0
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey > 0 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         i = i + 1;
      END;
   ENDIF;   
   
   IF CurObject.cList.LastRow() > 0 THEN
      CurObject.TV_Update();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;
   ENDIF;

   /****************************************************************************
   ***********   Limit Bogey Times based on DayAhead values...   ***************
   ****************************************************************************/

   /*
   **  Bogey times are limited when two non-bogey days follow a bogey day.
   **  When this happens the TV_Bogey flag will be updated to be + 10 from 
   **  its original value.  This will trigger the Feeder History/Restoration
   **  reports to limit the total outage time based on the cutout time.
   **
   **  In this first section we will limit bogeys based on future values.  That
   **  is tomorrows forecast and todays forcast are non bogey and yesterdays 
   **  actual value it bogey.
   */
   /*
   **  If today is SAT and yesterday's actual > TV_Threshold. Look for CERC day on SAT or 
   **  SUN.  If yes, then compare that day with Forecast or DayAhead to confirm there will 
   **  be two non-bogey days after a bogey day. 
   */
   IsCERC = 0;
   IsSatCERC = 0;
   IsSunCERC = 0;
   IF UPPERCASE(dow(date('now'))) = 'SAT' THEN
      SELECT :IsSatCERC = 1
      FROM    FMS_CercDay C
      WHERE   C.DateValue = DATE_TRUNC('day',date('now'));
      
      SELECT :IsSunCERC = 1
      FROM    FMS_CercDay C
      WHERE   C.DateValue = DATE_TRUNC('day',date('now') + '1 day');
      
      IF (CurObject.Elist.Forecast > TV_Threshold AND IsSatCERC = TRUE) OR
         (CurObject.Elist.DayAhead > TV_Threshold AND IsSunCERC = TRUE) THEN
         IsCERC = 1;
      ENDIF;
   ENDIF;
   
   
   CurObject.cList.Clear();
   IF (CurObject.Elist.Actual > TV_Threshold AND
      CurObject.Elist.Forecast < TV_Threshold AND
      CurObject.Elist.DayAhead < TV_Threshold) OR
      (UPPERCASE(dow(date('now'))) = 'SAT' AND
      CurObject.Elist.Actual > TV_Threshold AND
      IsCERC = FALSE) THEN
      /*
      ** Yesterday was a Bogey, today and tomorrow aren't so we will update
      ** yesterdays values to be limited based on these numbers. Increase all TV_Bogey values
      ** by + 10. 
      */
      CurObject.StartDate = date_trunc('day',date('now')) - '30 hours'; /* 6pm one day ago */
      CurObject.EndDate   = date_trunc('day',date('now')) - '6 hours';  /* 6pm prior day */

      i = 1;
      CurObject.cList.Clear();
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = C.TV_Bogey
      FROM   FMS_Card C
      WHERE  C.TV_Bogey > 0 AND
             C.TV_Bogey < 10 AND            /* don't want to increment twice */
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             C.TV_Bogey
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey > 0 AND
             C.TV_Bogey < 10 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         CurObject.cList[i].TV_Bogey = CurObject.cList[i].TV_Bogey + 10;
         i = i + 1;
      END;
   ELSE
      /*
      **  No need to do anything since bogey will be cleared above.
      */
      CurObject.cList.Clear();
   ENDIF;

   IF CurObject.cList.LastRow() > 0 THEN
      CurObject.TV_Update();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;
   ENDIF;

   /****************************************************************************
   ***********   Limit Bogey Times based on Forecast values... *****************
   ****************************************************************************/

   /*
   **  Bogey times are limited when two non-bogey days follow a bogey day.
   **  When this happens the TV_Bogey flag will be updated to be + 10 from 
   **  its original value.  This will trigger the Feeder History/Restoration
   **  reports to limit the total outage time based on the cutout time.
   */
   /*
   **  Get Yesterdays actual from todays values.
   */
   TV_Today = date_trunc('day',date('NOW'));

   CurObject.cList.Clear();
   IF CurObject.Elist.Actual < TV_Threshold AND
      CurObject.Elist.Forecast < TV_Threshold AND
      CurObject.Elist.Actual > 0 THEN
      /*
      **  Today and Yesterday are non-bogey days, now look at previous day.
      */
      TV_Actual = 0;
      TV_Yesterday = date_trunc('day',date('NOW') - '1 day');
      SELECT :TV_Actual = B.Actual
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= :TV_Yesterday AND
              B.LogDate < :TV_Today AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory
                           WHERE  LogDate < :TV_Today);
      IF TV_Actual > TV_Threshold THEN
         /*
         ** Previous Day was a bogey so lets limit those values since it looks like
         ** there will be a two non-bogey days following a bogey day. 
         **
         ** Increase all TV_Bogey values by + 10. 
         */
         CurObject.StartDate = date_trunc('day',TV_Yesterday) - '30 hours'; /* 6pm two days ago */
         CurObject.EndDate   = date_trunc('day',TV_Yesterday) - '6 hours';  /* 6pm prior day */
            
         i = 1;
         CurObject.cList.Clear();
         SELECT CurObject.cList[i].Card     = C.Card,
                CurObject.cList[i].CardType = 0,
                CurObject.cList[i].Cutout   = C.Cutout,
                CurObject.cList[i].TV_Bogey = C.TV_Bogey
         FROM   FMS_Card C
         WHERE  C.TV_Bogey > 0 AND
                C.TV_Bogey < 10 AND            /* don't want to increment twice */
                C.TypeOfCard <> :TypeOfCard$4KV AND
                C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
                C.Status <= :Card$Closed AND
                C.CutOut >= :CurObject.StartDate AND
                C.Cutout < :CurObject.EndDate
         UNION ALL
         SELECT C.Card,
                1,
                C.Cutout,
                C.TV_Bogey
         FROM   FMS_ArchiveCard C
         WHERE  C.TV_Bogey > 0 AND
                C.TV_Bogey < 10 AND
                C.TypeOfCard <> :TypeOfCard$4KV AND
                C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
                C.CutOut >= :CurObject.StartDate AND
                C.Cutout < :CurObject.EndDate
         BEGIN
            CurObject.cList[i].TV_Bogey = CurObject.cList[i].TV_Bogey + 10;
            i = i + 1;
         END;
      ENDIF;  
   ELSEIF UPPERCASE(dow(date('now'))) <> 'SUN' THEN
      /*
      **  Don't do this check on Sunday.  Because we don't want to clear 
      **  limits that may have been set on Friday due to entries on SAT
      **  that showed FRI actual value as a TV Bogey.
      **
      **  Either today or Yesterday was a TV Bogey day so look back one more day
      **  to make sure no Bogeys were > 10.  
      */
      TV_Yesterday = date_trunc('day',date('NOW') - '1 day');
      CurObject.StartDate = date_trunc('day',TV_Yesterday) - '30 hours'; /* 6pm two days ago */
      CurObject.EndDate   = date_trunc('day',TV_Yesterday) - '6 hours';  /* 6pm prior day */

      i = 1;
      CurObject.cList.Clear();
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = C.TV_Bogey
      FROM   FMS_Card C
      WHERE  C.TV_Bogey > 10 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             C.TV_Bogey
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey > 10 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         CurObject.cList[i].TV_Bogey = CurObject.cList[i].TV_Bogey - 10;
         i = i + 1;
      END;
   ENDIF;
   
   IF CurObject.cList.LastRow() > 0 THEN
      CurObject.TV_Update();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;
   ENDIF;

   /****************************************************************************
   ***********   Limit Bogey Times based on Actual values...   *****************
   ****************************************************************************/

   /*
   **  Bogey times are limited when two non-bogey days follow a bogey day.
   **  When this happens the TV_Bogey flag will be updated to be + 10 from 
   **  its original value.  This will trigger the Feeder History/Restoration
   **  reports to limit the total outage time based on the cutout time.
   */
   /*
   **  Get Yesterdays actual from todays values.
   */
   TV_Actual = 0;
   TV_Today = date_trunc('day',date('NOW'));
   SELECT :TV_Actual = B.Actual
   FROM    TV_BogeyHistory B
   WHERE   B.LogDate >= :TV_Today AND
           B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                        FROM   TV_BogeyHistory);

   CurObject.cList.Clear();
   IF TV_Actual < TV_Threshold AND
      TV_Actual > 0 THEN
      /*
      **  Yesterday was a non-bogey day, now look at previous day.
      */
      TV_Actual = 0;
      TV_Yesterday = date_trunc('day',date('NOW') - '1 day');
      SELECT :TV_Actual = B.Actual
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= :TV_Yesterday AND
              B.LogDate < :TV_Today AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory
                           WHERE  LogDate < :TV_Today);
      IF TV_Actual < TV_Threshold AND
         TV_Actual > 0 THEN
         /*
         ** Prior two days are non-bogey.  Now lets see if 3rd day back is bogey. 
         */
         TV_Actual = 0;
         TV_TwoDayAgo = date_trunc('day',date('NOW') - '2 day');
         SELECT :TV_Actual = B.Actual
         FROM    TV_BogeyHistory B
         WHERE   B.LogDate >= :TV_TwoDayAgo AND
                 B.LogDate < :TV_Yesterday AND
                 B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                              FROM   TV_BogeyHistory
                              WHERE  LogDate < :TV_Yesterday);
         IF TV_Actual > TV_Threshold THEN
            /*
            ** Prior two days are non-bogey and third day ago was bogey.  Increase all TV_Bogey values
            ** by + 10. 
            */
            CurObject.StartDate = date_trunc('day',TV_TwoDayAgo) - '30 hours'; /* 6pm two days ago */
            CurObject.EndDate   = date_trunc('day',TV_TwoDayAgo) - '6 hours';  /* 6pm prior day */

            i = 1;
            CurObject.cList.Clear();
            SELECT CurObject.cList[i].Card     = C.Card,
                   CurObject.cList[i].CardType = 0,
                   CurObject.cList[i].Cutout   = C.Cutout,
                   CurObject.cList[i].TV_Bogey = C.TV_Bogey
            FROM   FMS_Card C
            WHERE  C.TV_Bogey > 0 AND
                   C.TV_Bogey < 10 AND            /* don't want to increment twice */
                   C.TypeOfCard <> :TypeOfCard$4KV AND
                   C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
                   C.Status <= :Card$Closed AND
                   C.CutOut >= :CurObject.StartDate AND
                   C.Cutout < :CurObject.EndDate
            UNION ALL
            SELECT C.Card,
                   1,
                   C.Cutout,
                   C.TV_Bogey
            FROM   FMS_ArchiveCard C
            WHERE  C.TV_Bogey > 0 AND
                   C.TV_Bogey < 10 AND
                   C.TypeOfCard <> :TypeOfCard$4KV AND
                   C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
                   C.CutOut >= :CurObject.StartDate AND
                   C.Cutout < :CurObject.EndDate
            BEGIN
               CurObject.cList[i].TV_Bogey = CurObject.cList[i].TV_Bogey + 10;
               i = i + 1;
            END;
         ENDIF;
      ENDIF;  
   ELSEIF UPPERCASE(dow(date('now'))) <> 'MON' THEN
      /*
      **  Don't do this check on Sunday.  Because we don't want to clear 
      **  limits that may have been set on Friday due to entries on SAT
      **  that showed FRI actual value as a TV Bogey.
      **
      **  Yesterday was a TV Bogey day so look back two days and make sure 
      **    no Bogeys were > 10.  
      **  This could happen if an email was sent out with actual for yesterday
      **    showning non-bogey which might cause two days ago to get updated 
      **    to limit bogeys.  Now if a correction was sent out where that isn't 
      **    the case we need to set those bogeys to not be limited. 
      */
      TV_TwoDayAgo = date_trunc('day',date('NOW') - '2 day');
      CurObject.StartDate = date_trunc('day',TV_TwoDayAgo) - '30 hours'; /* 6pm two days ago */
      CurObject.EndDate   = date_trunc('day',TV_TwoDayAgo) - '6 hours';  /* 6pm prior day */

      i = 1;
      CurObject.cList.Clear();
      SELECT CurObject.cList[i].Card     = C.Card,
             CurObject.cList[i].CardType = 0,
             CurObject.cList[i].Cutout   = C.Cutout,
             CurObject.cList[i].TV_Bogey = C.TV_Bogey
      FROM   FMS_Card C
      WHERE  C.TV_Bogey > 10 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.Status <= :Card$Closed AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      UNION ALL
      SELECT C.Card,
             1,
             C.Cutout,
             C.TV_Bogey
      FROM   FMS_ArchiveCard C
      WHERE  C.TV_Bogey > 10 AND
             C.TypeOfCard <> :TypeOfCard$4KV AND
             C.CardClass IN (:Type$Auto,:Type$CIOA,:Type$FOT) AND
             C.CutOut >= :CurObject.StartDate AND
             C.Cutout < :CurObject.EndDate
      BEGIN
         CurObject.cList[i].TV_Bogey = CurObject.cList[i].TV_Bogey - 10;
         i = i + 1;
      END;
   ENDIF;
   
   IF CurObject.cList.LastRow() > 0 THEN
      CurObject.TV_Update();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   RETURN;
END;

METHOD TV_Update (
)=
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;  
   IsCERC       = INTEGER NOT NULL WITH DEFAULT;  
   TempCutout   = DATE;
   July4Start   = DATE NOT NULL WITH DEFAULT;
   July4End     = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update all Temperature Variabale 
** values in fms_card and fms_archivecard when the forecast has 
** changed.  
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
   
   FOR i = 1 to CurObject.cList.LastRow() DO
      /*
      **  See if today is a CERC day.  If yes then today can be tracked as 
      **  a TV day if the TV Threshold has been met.
      */
      IsCerc = 0;
      IF date_part('hour',CurObject.cList[i].Cutout) < 18 THEN
         SELECT :IsCERC = 1
         FROM    FMS_CercDay C
         WHERE   C.DateValue = DATE_TRUNC('day',date(:CurObject.cList[i].Cutout));
      ELSE  /* After 6pm check tomorrow */
         SELECT :IsCERC = 1
         FROM    FMS_CercDay C
         WHERE   C.DateValue = DATE_TRUNC('day',date(:CurObject.cList[i].Cutout) + '1 day');   
      ENDIF;
      /*
      **  Set up July 4 date
      */
      July4Start = date('03-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');
      July4End   = date('04-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');

      /*
      **  Don't track TV on weekends or July 4th
      */
      IF IsCERC = 0 AND
        (UPPERCASE(dow(CurObject.cList[i].Cutout)) = 'SAT' OR
        (UPPERCASE(dow(CurObject.cList[i].Cutout)) = 'FRI' AND
         date_part('hour',CurObject.cList[i].Cutout) >= 15) OR 
        (UPPERCASE(dow(CurObject.cList[i].Cutout)) = 'SUN' AND
         date_part('hour',CurObject.cList[i].Cutout) < 18) OR
        (CurObject.cList[i].Cutout >= July4Start AND
         CurObject.cList[i].Cutout < July4End)) THEN
         /* 
         ** Do Nothing - 
         **   NOTE::ANY CHANGE MADE HERE SHOULD ALSO BE MADE IN PromptCutOut 
         */
      ELSE
         /*
         **  Update TV_Bogey
         */
         RetCode = CALLPROC FMS_CardTVUpd (
                          Card = CurObject.cList[i].Card,
                          Type = CurObject.cList[i].CardType,
                          TV_Bogey = CurObject.cList[i].TV_Bogey);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = '',
              TraceMessage = 'Class:TV_ASE;Method:TV_Update; ' +
              'Unable to update TV_Bogey on card: ' + VARCHAR(CurObject.cList[i].Card) + 
              ' to: ' + VARCHAR(CurObject.cList[i].CardType)
              );   
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Unable to update data.  Please try again...';
            RETURN;   
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDFOR;

   RETURN;
END;

METHOD TV_Error (
)=
DECLARE
   RetCode = INTEGER NOT NULL;   
   TV_BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to notify the watch engineer that there
** was an error trying to acquire TV data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = ''; 
/*
**  Find out the TV_Threshold value.
*/
   TV_BogeyEnabled = FALSE;
   SELECT :TV_BogeyEnabled = TM_BogeyEnabled
   FROM    FMS_SystemParameters;
   CALLPROC DDB_ROLLBACK;
/*
**  Don't do anything else if TV_BogeyEnabled is false.
*/
   IF TV_BogeyEnabled = FALSE THEN
      RETURN;
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'pgm_online'
                                    ,MessageText = CurObject.WarningText
                                    ,MessageType = 0
                                    ,Card = 0
                                    ,Priority = 0  /* High Priority */ 
                                    ,Time = date('now'));
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
           TraceMessage = 'Class:TV_ASE;Method:TV_Error; ' +
                               'Unable to send notification message to PGM_Online regarding: ' 
                               + HC_NEWLINE + CurObject.WarningText
           );   
   ENDIF;
   CALLPROC DDB_COMMIT;

   RETURN;
END;

