Application Component Report
============================

	Name:            AddAreaStationFeeder

/*
**
**	Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          AddAreaStationFeeder
**
**  Modifications:
**   10/27/09 em     Created
**   11/23/09 ysp    notify ECC FMS Staff of new feeder by email
**   12/16/09 em     Limit stations by rating 
**   01/27/10 ysp    Add email subject and template to class
**   03/15/11 em     Fix ADivision problem where inserting blank division grouping
*/
INITIALIZE
(
   SendEmail = INTEGER NOT NULL WITH DEFAULT;   /* Optional Parameter */

   i     = integer NOT NULL;			/* Temporary counter */
   j     = integer NOT NULL;			/* Temporary counter */
   match = varchar(40);  
   RetCode     = integer NOT NULL WITH DEFAULT;			/* Return Code */

   EmailClass = EmailNotificationClass DEFAULT NULL;
   Equip = ARRAY OF Equipment;
   Fdr   = FeederObject DEFAULT NULL; 
   FeederAdded = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(256) NOT NULL WITH DEFAULT;
   SelectedDivision = INTEGER NOT NULL WITH DEFAULT;
   SelectedEquipment = Equipment DEFAULT NULL;
   TempObject = INTEGER NOT NULL WITH DEFAULT;
   TempName   = VARCHAR(40) NOT NULL WITH DEFAULT;    
   TempRating = FLOAT; 
) =
BEGIN
   FeederAdded = FALSE;

   FIELD(Division).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Division).ValueList.ChoiceItems[1].EnumText = '';
   FIELD(ADivision).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(ADivision).ValueList.ChoiceItems[1].EnumText = 'No';
   IF EffectiveDivisions.LastRow() > 0 THEN         
      FOR i = 1 TO EffectiveDivisions.LastRow() DO
          FIELD(Division).ValueList.ChoiceItems[i+1].EnumValue = EffectiveDivisions[i].Object;
          FIELD(Division).ValueList.ChoiceItems[i+1].EnumText = EffectiveDivisions[i].Name;
      ENDFOR;
   ENDIF;
/*
** If EffectiveDivision empty then show all divisions.  Must show all divisions for AnotherDivision Choicelist.
*/
   i = 1;
   SELECT :TempObject = Object,
          :TempName = Name
   FROM   Udb_Object 
   WHERE  Type = :Type$Division 
   ORDER BY Name
   BEGIN
      i = i + 1;
      IF EffectiveDivisions.LastRow() = 0 THEN
         FIELD(Division).ValueList.ChoiceItems[i].EnumValue = TempObject;
         FIELD(Division).ValueList.ChoiceItems[i].EnumText = TempName;
      ENDIF;

      FIELD(ADivision).ValueList.ChoiceItems[i].EnumValue = TempObject;
      FIELD(ADivision).ValueList.ChoiceItems[i].EnumText = TempName;
   END;

   FIELD(Rating).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Rating).ValueList.ChoiceItems[1].EnumText = '';
   i = 1;
   SELECT :TempObject = O.Object,
          :TempName = O.Name,
          :TempRating = R.Normal
   FROM   Udb_Object O,
          Udb_Rating R
   WHERE  O.Type = :Type$RatingFamily AND
          O.Object = R.Object AND
          R.Normal > 13 AND R.Normal < 96 AND
          O.Name <> 'Template'
   ORDER BY 3
   BEGIN
      i = i + 1;
      FIELD(Rating).ValueList.ChoiceItems[i].EnumValue = TempObject;
      FIELD(Rating).ValueList.ChoiceItems[i].EnumText = TempName;
   END;

   FIELD(FS.SourceType).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(FS.SourceType).ValueList.ChoiceItems[1].EnumText = '';
   i = 1;
   SELECT :TempObject = T.Type,
          :TempName = T.Name
   FROM   Udb_Type T,
          Udb_ExtendedType ET
   WHERE  ET.SuperType = :Type$Source AND
          ET.Type = T.Type 
   ORDER BY Name
   BEGIN
      i = i + 1;
      FIELD(FS.SourceType).ValueList.ChoiceItems[i].EnumValue = TempObject;
      FIELD(FS.SourceType).ValueList.ChoiceItems[i].EnumText = TempName;
   END;

   FIELD(Network).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Network).ValueList.ChoiceItems[1].EnumText = '';
END;


ON SETVALUE Division =   
BEGIN
   IF FIELD(Division).CurEnumValue = 0 THEN
      MESSAGE 'Please select a division to load the substation list';
   ENDIF;

   SelectedDivision = FIELD(Division).CurEnumValue;
   SelectStation.Clear();
   i = 1;
   SELECT  :SelectStation[i].Object = O.Object,
           :SelectStation[i].Name = O.Name,
           :SelectStation[i].Description = O.Description
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping G2,
           Udb_Rating R
   WHERE   O.Type = :Type$Substation AND
           O.Object = G.Member AND
           G.Relationship = :Interaction$MemberOf AND
           G.Grouping = :SelectedDivision AND
           G.Member = G2.Member AND
           G2.Relationship = :Interaction$RatedAs AND
           G2.Grouping = R.Object AND
           R.Normal < 34
   ORDER BY Description
   BEGIN
      i = i + 1;
   END; 
           
   Selected.Object = 0;
   Selected.Name = '';
   Selected.Description = '';

   FIELD(Network).ValueList.ChoiceItems.Clear();
   FIELD(Network).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Network).ValueList.ChoiceItems[1].EnumText = '';

   i = 1;
   SELECT :TempObject = O.Object,
          :TempName = O.Name
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  O.Type = :Type$Network AND
          O.Object = G.Member AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = :SelectedDivision
   ORDER BY Name
   BEGIN
      i = i + 1;
      FIELD(Network).ValueList.ChoiceItems[i].EnumValue = TempObject;
      FIELD(Network).ValueList.ChoiceItems[i].EnumText = TempName;
   END;
   FIELD(Network).UpdChoiceList();
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;

ON SETVALUE ADivision =   
BEGIN
   IF FIELD(ADivision).CurEnumValue = 0 THEN
      RESUME;
   ENDIF;

   IF FIELD(Division).CurEnumValue = 0 THEN
      MESSAGE 'First select substation division for new feeder.';
      FIELD(ADivision).CurEnumValue = 0;
      RESUME;
   ENDIF;           
  
   IF FIELD(ADivision).CurEnumValue = FIELD(Division).CurEnumValue THEN
      MESSAGE 'That is the same division.';
      FIELD(ADivision).CurEnumValue = 0;
      RESUME;
   ENDIF;           
END;


/*
**	Handle a feeder selection from the list
*/
ON ChildEntry SelectStation =
BEGIN
   Selected.Object = SelectStation[].Object;
   Selected.Name = SelectStation[].Name;
   Selected.Description = SelectStation[].Description;
END;


ON Click OK_Btn =
BEGIN
   IF Selected.Object = 0 THEN 
      MESSAGE 'Must select the source Area Substation.';
      RESUME;
   ENDIF;

   IF FeederName = '' THEN
      MESSAGE 'Must enter a new feeder name.';
      RESUME;
   ENDIF;

   IF Rating = 0 THEN
      MESSAGE 'Please enter a kV Rating.'; 
      RESUME;
   ENDIF; 

   IF Legs = 0 THEN
      MESSAGE 'Please identify if feeder should be built with one or two legs.';
      RESUME;
   ENDIF;  
  
   IF Network = 0 THEN
      IF CurFrame.ConfirmPopup (MessageText =
             'No Network selected.  Continue without assigning feeder to a network?') =
               PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;   

   i = 0;
   SELECT :i = Object
   FROM   Udb_Object
   WHERE  Type = :Type$Feeder AND
          Name = :FeederName;

   IF i > 0 THEN
      MESSAGE 'A feeder with this name already exists.';
      RESUME;
   ENDIF;
/*
** Build FeederObject class
*/
   Fdr = NULL;
   Fdr = FeederObject.Create();
   
   Fdr.Object = 0;
   Fdr.Address1 = l1;
   Fdr.Address2 = l2;
   Fdr.Address3 = l3;
   Fdr.Address4 = l4;
   Fdr.Comment = Comment;
   Fdr.Description = Description;
   Fdr.Division = Division;
   Fdr.Legs = Legs;
   Fdr.LocationComment = '';
   Fdr.Name = FeederName;
   Fdr.Network = Network;
   Fdr.OtherDivision = FIELD(ADivision).CurEnumValue;
   Fdr.Rating = Rating;
   Fdr.Substation = Selected.Object;
   Fdr.SubstationName = Selected.Name;
/*
** Handle Feeder Source; 1=New Feeder Source, 2=New Source station only, 3=Existing Source, 4=No Source
*/
   IF Source = 1 THEN
      SelectedEquipment = NULL;
      SelectedEquipment = Equipment.Create();
      SelectedEquipment.Equip = -1;
      SelectedEquipment.EquipClass = FS.SourceType;
      SelectedEquipment.EquipClassName = FIELD(FS.SourceType).CurEnumText;
      SelectedEquipment.EquipName = FS.SourceName;
      SelectedEquipment.Description = '(' + Selected.Name + ',' + FeederName + ')-';
   ELSEIF Source = 2 THEN
      SelectedEquipment = NULL;
      SelectedEquipment = Equipment.Create();
      SelectedEquipment.Equip = -2;
      SelectedEquipment.EquipClass = FS.SourceType;
      SelectedEquipment.EquipClassName = FIELD(FS.SourceType).CurEnumText;
      SelectedEquipment.EquipName = FS.SourceName;
      SelectedEquipment.Description = '(' + Selected.Name + ',XXXXX)-';
   ELSEIF Source = 3 THEN
/*
** Use Selected Equipment as is
*/
      SelectedEquipment.Description = '(' + Selected.Name + ',' + FeederName + ')-';
   ELSEIF Source = 4 THEN
      SelectedEquipment = NULL;
      SelectedEquipment = Equipment.Create();
      SelectedEquipment.Equip = 0;
   ENDIF;

   FIELD(SaveFeeder).CurBias = FB_VISIBLE;
   FIELD(OK_btn).CurBias = FB_DIMMED;
   FIELD(Cancel_btn).CurBias = FB_DIMMED;
   CurFrame.Flush();
 
   Fdr.GenerateFeeder(Source = SelectedEquipment);

   IF Fdr.ReturnCode < 0 THEN
      MESSAGE :Fdr.ErrorMessage;
      MESSAGE 'Please review Feeder and correct any problems using Udb screens.';

   ELSEIF SendEmail = TRUE THEN
    FeederAdded = TRUE;    /* Triggers reload of FeederList on exit. */
/*
** Email to be sent to ECC Staff to alert them of a new feeder added online by DO.
*/
      IF EmailClass IS NULL THEN
         EmailClass = EmailNotificationClass.Create();
      ENDIF;

      EmailClass.EmailType = 4;           // New feeder email to Staff
      EmailClass.Sender = DOp.Description;
      EmailClass.Recipient = 'STAFF';
      EmailClass.Subject = 'New Feeder Notification for ' + FeederName;
      EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                                       'Feeder=' + VARCHAR(Fdr.Object) + ';;' + 
                                       'FeederName=' + FeederName + ';;' + 
                                       'SubstationName=' + Selected.Description + ';;' + 
                                       'Legs=' + Field(Legs).CurEnumText + ';;';
      EmailClass.Message2 = '';
      EmailClass.Template = 'NewFeederToStaff.html';
      EmailClass.InsertRequest();

      IF EmailClass.ReturnCode <> 0 THEN 
         Message 'Unable to notify ECC FMS Staff of this feeder by email.';
      ENDIF;
   ENDIF;

   MsgText = 'Feeder ' + FeederName + ' was successfully created.  You may create another feeder or Cancel to exit.';
   IF Source = 1 OR Source = 3 THEN
      MsgText = MsgText + HC_NEWLINE + 'Please be aware that a "New Feeder" Notification Email will be sent when ' +
                'the first card on this feeder is activated.';
   ENDIF;
   MsgText = MsgText + HC_NEWLINE + 'The new feeder is not yet connected to the substation bus.';
   MESSAGE :MsgText;

   FIELD(SaveFeeder).CurBias = FB_INVISIBLE;
   FIELD(OK_btn).CurBias = FB_LANDABLE;
   FIELD(Cancel_btn).CurBias = FB_LANDABLE;
   CurFrame.Flush(); 
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =
BEGIN
   IF FeederAdded = TRUE THEN
/*
**  Reload FeederList to include new feeder.
*/
      IF UserGroup <> '' AND UserGroup <> Group$sicc THEN
       FeederList.Clear();
       i = 1;

        SELECT  :FeederList[i].Object = O.Object,
                :FeederList[i].Name = O.Name
        FROM    Udb_Object O,
                Udb_Grouping G 
        WHERE   G.Relationship = :Interaction$ControlledBy AND 
                G.Grouping = :UserDesk AND
                G.Member = O.Object AND
                O.Type = :Type$Feeder                 
        ORDER BY Name
        BEGIN
            i = i + 1;
        END; 

      ELSEIF UserGroup = Group$sicc THEN
/*
** Can't add 4kV feeder
*/
      ELSEIF UserRole = Role$Tester THEN  /* All Divisions */
       FeederList.Clear();
       i = 1;

        SELECT  :FeederList[i].Object = O.Object,
                :FeederList[i].Name = O.Name
        FROM    Udb_Object O,
                Udb_Grouping G 
        WHERE   O.Type = :Type$Feeder AND 
                G.Relationship = :Interaction$ControlledBy AND 
                G.Member = O.Object 
        ORDER BY Name
        BEGIN
              i = i + 1;
        END; 

      ENDIF; 
   ENDIF;

   RETURN;
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

ON CLICK FindButton =
BEGIN
    i = 1;
    WHILE i <= SelectStation.LastRow() Do
        match = uppercase(Selected.Description) + '%';
        IF Uppercase(SelectStation[i].Description) like match THEN
            Endloop;
        Endif;

        i = i + 1;

    ENDWHILE;

    If i <= SelectStation.LastRow() Then
        Field(SelectStation).ActiveRow = i;
    Else
		MESSAGE 'Substation does not exist.';
		Selected.Name = '';
                Selected.Description = '';
                Selected.Object = 0;
		RESUME;
    ENDIF;
END;

On Entry Selected.Description =
{
    Selected.Object = 0;
};

ON SETVALUE Source =
BEGIN
/*
** Provide pup-up for source entry or get 
** list of unused source equipment in the station to pass into SelectEquipment.
*/
   IF Selected.Object = 0 THEN
      MESSAGE 'Please select a Substation.';
      RESUME;
   ENDIF;

   IF Source = 1 OR Source = 2 THEN
      FIELD(FS.SourceEnter).CurBias = FB_VISIBLE;
      FIELD(FS).CurBias = FB_CHANGEABLE;
      FS.SourceType = 1;
      FS.SourceName = '';

   ELSEIF Source = 3 THEN
       FIELD(FS).CurBias = FB_VISIBLE;
       FIELD(FS.SourceEnter).CurBias = FB_INVISIBLE;
       FS.SourceType = 1;
       FS.SourceName = '';

       i = 1;
       Equip.Clear();
       REPEATED
       SELECT :Equip[i].Equip = O.Object,
              :Equip[i].EquipClassName = O.TypeName,
              :Equip[i].EquipClass = O.Type,
              :Equip[i].EquipName = O.Name
       FROM   Udb_Object O,
              Udb_ExtendedType ET,
              Udb_Grouping G 
       WHERE  G.Grouping = :Selected.Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              O.Type = ET.Type AND
              ET.SuperType = :Type$Source
       BEGIN
/*
** Exclude if already a member of a feeder
*/
          j = 0;
          SELECT :j = Grouping
          FROM   Udb_Grouping
          WHERE  GroupingType = :Type$Feeder AND
                 Relationship = :Interaction$MemberOf AND
                 Member = :Equip[i].Equip;
          IF j = 0 THEN 
             i = i + 1;
          ELSE
             Equip.RemoveRow (rownumber = i);
          ENDIF; 
       END;

       IF Equip.LastRow() = 0 THEN
          MESSAGE 'There is no unused source type equipment in this substation.';
          Source = 4;
          RESUME;
       ENDIF;

       SelectedEquipment = NULL;
       SelectedEquipment = Equipment.Create();
       RetCode = CALLFRAME SelectEquipment (SelectEquip = Equip, Selected = BYREF(SelectedEquipment));

       IF RetCode <> PU_OK THEN
          MESSAGE 'A Feeder Source was not selected.';
          Source = 4;
          RESUME;
       ELSE
          FS.SourceType = SelectedEquipment.EquipClass;
          FS.SourceName = SelectedEquipment.EquipName;
       ENDIF;
   
   ELSEIF Source = 4 THEN
       FIELD(FS).CurBias = FB_VISIBLE;
       FIELD(FS.SourceEnter).CurBias = FB_INVISIBLE;
       SelectedEquipment = NULL;
       FS.SourceType = 1;
       FS.SourceName = '';
   ENDIF;

END;
							 *Default Item

										 *Default Item

										 *Default Item

										 *Default Item

										 *Default Item

									 *Default Item

