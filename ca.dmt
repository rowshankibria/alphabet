ON CLICK PDF_Btn =
DECLARE
    WorkDir = Varchar(100);  
    PDFCommand = Varchar(600);
BEGIN

    WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
/*
** 09/09/22: replaced by powershell script that displays reports from FMS_ReportService web site.
**   
    PDFCommand = 'wscript ' + WorkDir + '\relay_report.vbs "SLC" ' + 
                                        varchar(ArchiveCard) + ' ' +
                                        varchar(C.Card) + ' ' +
                                        varchar(CurrentSwitchingItem) + ' ' +
                                        '1 ' + /* Always call in update from from OpenROAD *
                                        '"' + PDFTitle + '" '; 
*/
   PDFCommand = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File ';
   
   PDFCommand = PDFCommand + '"' + WorkDir + '\PrintReport.ps1" RELAY SLC ' + 
                                        varchar(ArchiveCard) + ' ' +
                                        varchar(C.Card) + ' ' +
                                        varchar(CurrentSwitchingItem) + ' ' +
                                        '1 ' + /* Always call in update from from OpenROAD */
                                        '"' + PDFTitle + '" '; 
    
   IF Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_1%' escape '\' OR
      Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_2%' escape '\' THEN
      PDFCommand = PDFCommand + DDB_Global.Session.Cur.Database;
   ELSE
      PDFCommand = PDFCommand + '""';    // blank for prod and test database 
   ENDIF;
    
    CurFrame.Trace (PDFCommand);
    CALL System PDFCommand;   
END;

