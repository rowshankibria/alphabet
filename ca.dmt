	Name:            SelectObject

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CommonAppComponents
**  Frame:          SelectObject
**
**  Modifications:
**      09/06/96 pkw    modify from feedercard
*/

INITIALIZE
(
    i     = integer not null;			/* Temporary counter */
    match = varchar(40);        
    ObjectName = varchar(20) not null with default;        
) =
BEGIN
    CurFrame.WindowTitle = 'Select ' + ObjectName;
    Field(SelectObject).Title = 'Select ' + ObjectName;
    CurFrame.SendUserEvent (eventname = 'load_data');
END;

/*
**	 set up the display
*/                       
ON UserEvent 'load_data' =
BEGIN
  	Selected.Object = 0;
	Selected.Name = '';
END;

/*
**	Handle a feeder selection from the list
*/
ON ChildEntry SelectObject =
BEGIN
	Selected.Object = SelectObject[].Object;
	Selected.Name = SelectObject[].Name;
END;


ON Click OK_Btn =
BEGIN
    IF Selected.Object = 0 THEN 
        IF Selected.Name <> '' THEN
            i = 1;
            WHILE i <= SelectObject.LastRow() Do
                match = uppercase(Selected.Name);
                IF Uppercase(SelectObject[i].Name) like match THEN
                    Endloop;
                Endif;

                i = i + 1;
            ENDWHILE;

            If i <= SelectObject.LastRow() Then
                Field(SelectObject).ActiveRow = i;    
                Selected.Object = SelectObject[].Object;
	            Selected.Name = SelectObject[].Name;
                RETURN (Selected.Object);
            Else
     	        Message 'You have not selected a Feeder.';
		        Selected.Name = '';
                Selected.Object = 0;
		        RESUME;
            ENDIF;
        ELSE
     	    Message 'You have not selected a Feeder.';
		    Selected.Name = '';
            Selected.Object = 0;
		    RESUME;
        ENDIF;
    ELSE 
	    RETURN (Selected.Object);
    ENDIF; 
END;
/*
**	Handle an Cancel click
*/
ON Click Cancel_Btn =
BEGIN
	RETURN (0);
END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

ON CLICK FindButton =
BEGIN
    i = 1;
    WHILE i <= SelectObject.LastRow() Do
        match = uppercase(Selected.Name) + '%';
        IF Uppercase(SelectObject[i].Name) like match THEN
            Endloop;
        Endif;

        i = i + 1;

    ENDWHILE;

    If i <= SelectObject.LastRow() Then
        Field(SelectObject).ActiveRow = i;
    Else
		MESSAGE 'Feeder does not exist or is not available to you.';
		Selected.Name = '';
        Selected.Object = 0;
		RESUME;
    ENDIF;
END;

On Entry Selected.Name =
BEGIN
    Selected.Object = 0;
END;

