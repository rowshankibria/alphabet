METHOD LoadISPJob(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.TOOperator = TOOperator,
          :CurObject.TOOperatorName = TOOperatorName,
          :CurObject.TOIssued = TOIssued,
          :CurObject.RSOperator = RSOperator,
          :CurObject.RSOperatorName = RSOperatorName,
          :CurObject.RSComplete = RSComplete,
          :CurObject.ReturnStatus = ReturnStatus,
          :CurObject.Note = Note,
          :CurObject.Description = Description
    FROM   SOA_ISPJob
    WHERE  ISPermit = :CurObject.ISPermit;     
    CALLPROC DDB_ROLLBACK;
END;


METHOD UpdateJob(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC SOA_ISPJobUpd(
                      ISPermit = CurObject.ISPermit,
                      Description = CurObject.Description);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPJob.UpdateJob; Error in updating In Service Permit Job description ';
      CurMethod.Trace(Text = varchar(date('now')) + ':ISPJob.UpdateJob; ERROR: ' + 
                'Unable to updating In Service Permit Job description for ISPermit ' + VARCHAR(CurObject.ISPermit));
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RETURN;
END;

