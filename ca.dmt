	Name:            ReviewRFPs

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
*/
/*
**  Application:    FeederCard
**  Frame:          ReviewRFPs 
**
**  Modifications:
**  11/21/02  em    Created to allow DO to unlink unused RFPs before losing
**                  them as they close a card or create a transfer card. 
**  11/27/02  ysp   Merge: convert to soa job and jobcontrol tables.
**  12/2/02   em    Included "NOWOUT" Outage Type in the Where Clause.
**  03/10/03  em    If the IR Work Permit can no longer be associated to a
**                  RFP linked to the current card - which is often the case
**                  with a transfer card, then can exit immediately.
**  06/10/03  em    Change Mode passed to RequestForPermit to USER1 since 
**                  QUERY is used on Open Cards.
**  04/06/04  ysp   Changed the warning message on the screen. Add RFP to
**                  ir_worklocation table.
**  04/16/04  em    Changed warning message.  RFPs linked by the FCR cannot
**                  be withdrawn by the FCR.  The FCR will need to copy/
**                  recreate.
**  05/24/05  em    On a XFER card, we will clean up any Work Permit Locations
**                  that have not been unlinked from the card for outstanding
**                  permits that will be transferred.
**  04/19/06  em    Changed appearance of message on screen, changed SELECT to use
**                  LinkedByDO field instead of outage type.
*/
INITIALIZE
(
    Card = FMS_Card;                    /* Passed Card */
    XferOrClose = CHAR(5) NOT NULL;     /* Passed Parameter for button text */

    i = Integer NOT NULL;			/* Scratch counter */
    j = Integer NOT NULL;			/* Scratch counter */
    RetCode = INTEGER NOT NULL WITH DEFAULT;    /* Return Code */
    RRIssues = INTEGER NOT NULL WITH DEFAULT;  /* BOOLEAN */
    RFP = ARRAY OF INTEGEROBJECT;              /* RFP IDs */
    WorkPermits = ARRAY OF INTEGEROBJECT;      /* WPs to Clean */
) =
BEGIN
/*
**  Set button text
*/
   IF XferOrClose = 'CLOSE' THEN
      FIELD(ok_btn).TextLabel = 'Continue' + HC_NEWLINE + 'Close Card' + 
                                HC_NEWLINE + 'Process';
   ELSEIF XferOrClose = 'XFER' THEN
      FIELD(ok_btn).TextLabel = 'Continue' + HC_NEWLINE + 'Transfer Card' + 
                                HC_NEWLINE + 'Process';
   ELSEIF XferOrClose = 'PURGE' THEN
      FIELD(ok_btn).TextLabel = 'Continue' + HC_NEWLINE + 'Purge Card' + 
                                HC_NEWLINE + 'Process';
   ELSE
      MESSAGE 'Bad Parameter passed to ReviewRFPs frame.  Contact Tech ' +
              'Support.';
      RETURN(PU_CANCEL);
   ENDIF;
/*
** Find RFPs linked by DO on this card.
*/
   RRIssues = FALSE;
   i = 1;
   RFP.Clear();
   SELECT :RFP[i].Value = RFP
   FROM   IR_RequestForPermit
   WHERE  LinkedByDO = 1 AND
          Card = :Card.Card
   BEGIN
      i = i + 1;
   END;
/*
** Now look to see if any of the RFPs have NOT been linked to a Work Permit.
** If one has not, then we might want to keep the RFP.
*/
   FOR i = 1 TO RFP.LastRow() DO
      j = 0;
      REPEATED 
      SELECT :j = COUNT(*)
      FROM   IR_RequestForPermit RFP,
             IR_RFPLocation RL,
             SOA_JobControl J,
             IR_WorkLocation WL
      WHERE  RFP.RFP = :RFP[i].Value AND
             RFP.RFP = RL.RFP AND
             RFP.RFP = WL.RFP AND
             RFP.RequestForPermit = WL.RequestForPermit AND
             WL.RFPLocation = RL.RFPLocation AND
             WL.WorkPermit = J.Job AND
             J.Card = :Card.Card;
      IF j = 0 THEN
         RRIssues = TRUE;
         ENDLOOP;
      ENDIF;
   ENDFOR;
/*
** Now just check for IR Work Permits associated to this card that may have been
** linked to an RFP.
*/
   IF RFP.LastRow() > 0 AND RRIssues = FALSE THEN

      REPEATED
      SELECT :RRIssues = 1
      FROM   SOA_Job J,
             SOA_JobControl JC,
             IR_WorkPermit WP
      WHERE  JC.Card = :Card.Card AND
             JC.Job = J.Job AND
             J.Status = '' AND
             J.RSComplete IS NULL AND
             J.Job = WP.WorkPermit;
   ENDIF;

   IF RRIssues = TRUE THEN
      OpenFrame RequestForPermit (Card = Card, 
                                  ParentFrame = CurFrame,
                                  CurFrameMode = FM_USER1);
/*
** For XFER card, let's clean up work locations for permits that are 
** still linked if the DO is too lazy.
*/
      IF XferOrClose = 'XFER' THEN
         i = 1;
         REPEATED
         SELECT :WorkPermits[i].Value = WP.WorkPermit
         FROM   SOA_Job J,
                SOA_JobControl JC,
                IR_WorkPermit WP
         WHERE  JC.Card = :Card.Card AND
                JC.Job = J.Job AND
                J.Status = '' AND
                J.RSComplete IS NULL AND
                J.Job = WP.WorkPermit
         BEGIN 
            i = i + 1;
         END;
    
         FOR i = 1 TO WorkPermits.LastRow() DO
             RetCode = CALLPROC IR_WorkLocationDel (
                            WorkPermit = WorkPermits[i].Value,
                            WPLocation = -1);
             IF RetCode = 0 THEN
                CALLPROC DDB_COMMIT;
             ELSE
                CALLPROC DDB_ROLLBACK;
                Message 'Due to an error, there may be stray work locations ' +
                        'on transferred work permits that cannot be deleted.';
             ENDIF;
         ENDFOR;
      ENDIF;
   ELSE
      RETURN(PU_OK);
   ENDIF;
END;


ON USEREVENT 'BringToFront' =
BEGIN
   CurFrame.BringToFront();
END;  


ON USEREVENT 'OKToContinue' =
BEGIN      
   RETURN(PU_OK);
END;


ON CLICK ok_btn =
BEGIN   
   RETURN(PU_OK);
END;


ON CLICK cancel_btn =
BEGIN    
   IF XferOrClose = 'XFER' THEN
      SELECT :i = COUNT(RFP)
      FROM   IR_RequestForPermit
      WHERE  LinkedByDO = 1 AND
             Card = :Card.Card;
   
      IF i > 0 THEN
         IF CurFrame.ConfirmPopup (MessageText = 
                 'You still have RFPs linked to an FMS card. ' +
                 'Click OK to Stay Here and Unlink. ' + HC_NEWLINE + HC_NEWLINE + 
                 'Clicking Cancel will stop the FMS Card Transfer, but ' +
                 'will not stop any processing triggered from a Substation ' +
                 'Log Card.  If you are working in SLC, you ' +
                 'should Unlink now then Continue.') = PU_OK THEN
            RESUME;
         ENDIF;
      ENDIF;   
   ENDIF;  
   RETURN(PU_CANCEL);
END;


ON WindowClose =
BEGIN
   RESUME;
END;


