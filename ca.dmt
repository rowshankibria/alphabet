	Name:            CheckAmmClearInProgress33kV


/*
**      Copyright c 2016 Pateric Software LLC  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckAmmClearInProgress33kV
**
**  Date:     Version  Description
** --------------------------------------------------
**  08/20/16  em       Created
**  07/19/18  em       Name Changed to differentiate from similar named Check
*/
PROCEDURE CheckAmmClearInProgress33kV
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    AmmClear = INTEGER NOT NULL WITH DEFAULT; 
    DeadMove = INTEGER NOT NULL WITH DEFAULT; 
    SourcePosCheck = INTEGER NOT NULL WITH DEFAULT;

    RetCode = INTEGER;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
)= 
BEGIN 
   RetCode = NULL;
/*
** Is move equipment defined as a Source Position?
*/
   SourcePosCheck = FALSE;
   SELECT :SourcePosCheck = Relationship
   FROM   Udb_Grouping 
   WHERE  Member = :JIP.Equip AND
          Relationship = :Interaction$SourcePosition;

   IF SourcePosCheck = FALSE THEN
      RETURN (RetCode);
   ENDIF;
/*
** Make sure AmmClearInProgress status exists
*/
   AmmClear = FALSE; 
   SELECT  :AmmClear = Status
   FROM    FMS_ObjectStatus 
   WHERE   Object = :JIP.Equip AND
           Status = :Status$AmmClearInProgress AND
           StatusCount > 0;

   IF AmmClear = FALSE THEN 
   
      WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'The Source Position Equipment does not have an ' +
                                 'Ammeter Clear In Progress.'
                        ); 
      IF (WarningStatus = PU_CANCEL) THEN
         RetCode = PU_CANCEL;
         RETURN (RetCode);
      ELSE
         RetCode = Warning$Overridden;
      ENDIF;
   ENDIF;
/*
** Make sure DeadMove status does not exist
*/
   DeadMove = FALSE;
   REPEATED 
   SELECT  :DeadMove = OS.Status
   FROM    FMS_ObjectStatus OS,
           TFMS_CardToObject CTO 
   WHERE   CTO.Card = :JIP.Card AND
           CTO.Object = OS.Object AND
           OS.Status = :Status$DeadMove AND
           OS.StatusCount > 0;

   IF DeadMove <> FALSE THEN 
   
      WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'A Feeder Segment on this card has a Dead Move status.'
                        ); 
      IF (WarningStatus = PU_CANCEL) THEN
         RetCode = PU_CANCEL;
       ELSE
         RetCode = Warning$Overridden;
      ENDIF;
   ENDIF;

   RETURN (RetCode);    
END;

Application Component Report
============================

	Name:            CheckAmmClearInProgressPHLink


/*
**      Copyright c 2016 Pateric Software LLC  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckAmmClearInProgressPHLInk
**
**  Date:     Version  Description
** --------------------------------------------------
**  07/19/18  em       Created
*/
PROCEDURE CheckAmmClearInProgressPHLink
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    AmmClear = INTEGER NOT NULL WITH DEFAULT; 
    LinkPH = INTEGER NOT NULL WITH DEFAULT; 
    VisibleBreak = INTEGER NOT NULL WITH DEFAULT; 
    VB = INTEGER NOT NULL WITH DEFAULT;

    RetCode = INTEGER;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
)= 
BEGIN 
   RetCode = NULL;
/*
** Get each Link-PH associated to the card feeder and check for visible break status
*/
   VisibleBreak = TRUE;
   LinkPH = 0;
   SELECT DISTINCT :LinkPH = G.Member
   FROM   Udb_GroupinG G,
          TFMS_CardToObject CTO,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = CTO.Card AND
          CTO.Type = :Type$Feeder AND
          CTO.Object = G.Grouping AND
          G.Relationship = :Interaction$MemberOf AND
          G.MemberType = :Type$LinkPH
   BEGIN
      VB = 0;
      SELECT :VB = Status
      FROM   FMS_ObjectStatus 
      WHERE  Object = :LinkPH AND
             StatusCount > 0 AND
             Status = :Status$VisibleBreak;
             
      IF VB = 0 THEN
         VisibleBreak = FALSE;
      ENDIF
   END;
   
   IF LinkPH = 0 THEN
      VisibleBreak = FALSE;
   ENDIF;
/* 
** Don't check AmmClearInProg if all LINK-PH have a Visible Break status  
*/ 
   IF VisibleBreak = FALSE THEN
      AmmClear = FALSE; 
      SELECT  :AmmClear = Status
      FROM    FMS_ObjectStatus 
      WHERE   Object = :JIP.Equip AND
              Status = :Status$AmmClearInProgress AND
              StatusCount > 0;

      IF AmmClear = FALSE THEN 
   
         WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'Equipment does not have an ' +
                                 'Ammeter Clear In Progress.'
                        ); 
         IF (WarningStatus = PU_CANCEL) THEN
            RetCode = PU_CANCEL;
         ELSE
            RetCode = Warning$Overridden;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN (RetCode);    
END;

Application Component Report
============================

	Name:            CheckAssociatedFeeders


/*
** Copyright c 1997 ESCA Corporation. All Rights Reserved.
** 
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          CheckAssociatedFeeders
**
**  Modifications:
**  05/21/97  jfl   Created 
**  10/17/97  jfl   Don't panic if ATS can pickup
**                  customers on the other side.
**  08/26/02  em    On ATS, if current feeder 101/102 is open, ignore ATS Manual
**                  status, don't present warning if the ATS device on the 
**                  current feeder is open.
**  11/18/02  ysp   Merge: removed C and Jobs as passed-ins.
**  02/28/03  pkw   Use DISTINCT against SOA_ActiveCard for feeder
**                  that span divisions.
**  11/13/07  em    Set CardDetails.Feeder so that subsequent processing can use it. 
**  01/06/11  em    3G reduce use of CardDetails.Feeder
**  03/30/11  em    Establish CardDetails if necessary before call to LoadAssociatedFeeders
**  06/21/12  em    ATS Grouper use ExtendedType instead of SuperType
**  08/24/16  ysp   Add FedBy variable used in ConfirmCardDetails
**  09/07/16  pkw   Validate for 33kv feeders
*/
PROCEDURE  CheckAssociatedFeeders
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    i = INTEGER NOT NULL WITH DEFAULT;
    RED_ISO  = ARRAY OF GrouperInfo;
    RED_HTV  = ARRAY OF GrouperInfo;
    RED_Loop = ARRAY OF GrouperInfo;
    RED_ATS  = ARRAY OF GrouperInfo;
    REDString = VARCHAR(400) NOT NULL;
    ISO_Color= Integer NOT NULL;
    HTV_Color= Integer NOT NULL;
    Loop_Color= Integer NOT NULL;
    ATS_Color  = Integer NOT NULL;
    AssFeeders = Array of IntegerObject;
    PreCheck = INTEGER NOT NULL;
    OverRide = INTEGER NOT NULL;

    ManualATS  = INTEGER NOT NULL;     /*  Boolean 1 if ATS in manual mode */
    RetCode = INTEGER NOT NULL;
    LocSwitch = INTEGER NOT NULL;
    AltSwitch = INTEGER NOT NULL;
    AltSwitchCurOpen = INTEGER NOT NULL;
    AltFeeder = INTEGER NOT NULL;
    AltFeederStatus = INTEGER NOT NULL;
    NormalOpen = INTEGER NOT NULL;
    CurrentlyOpen = INTEGER NOT NULL;
    Feeder = INTEGER NOT NULL;
    FedBy = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    OverRide = FALSE; 
    WarningStatus = PU_OK;
#INCLUDE ConfirmCardDetails
/*
** Determine the current button colors
** and the projected button colors if
** cutout move is performed
*/
    CALLPROC LoadAssociatedFeeders( AssFeeders = byref(AssFeeders),
                                    HTV_Color  = Byref(HTV_Color),
                                    ISO_Color  = Byref(ISO_Color),
                                    Loop_Color = Byref(Loop_Color),
                                    ATS_Color  = Byref(ATS_Color),
                                    RED_HTV    = Byref(RED_HTV),
                                    RED_ISO    = Byref(RED_ISO),
                                    RED_Loop   = Byref(RED_Loop),
                                    RED_ATS    = Byref(RED_ATS),
                                    PreCheck   = TRUE
                                    );
/*
**   Give warnings for all buttons that would turn RED
*/
    IF HTV_Color = CC_RED THEN 
        i = 1;
        REDString = '';
        WHILE i <= RED_HTV.LastRow() DO
            IF i = 1 THEN
                REDString = RED_HTV[i].GrouperName;
            ELSE
                REDString = REDString + ', ' + RED_HTV[i].GrouperName;
            ENDIF;
            i = i + 1;
        ENDWHILE;
                
        WarningStatus = CALLFRAME Warning 
                                  (Card = JIP.Card, 
                                   Job = JIP.Job,
                                   SwitchingItem = JIP.SwitchingItem,
                                   Text = ' Feeder Cutout will cause loss of customers ' + 
                                  ' fed from HTV: ' + REDString);
        IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            OverRide = TRUE;
        ENDIF;
    ENDIF;

/*
** for ATS, we must temper the RED result
** if the alternate feeder can automatically pickup the
** customer when this feeder is cutout.
*/
    IF ATS_Color = CC_RED THEN 
/*
** For each ATS with potential RED condition,
** determine whether the ATS is in manual/auto mode, 
** the position of the alternate switch and 
** the "in service" status of the alternate feeder
*/ 
        i = RED_ATS.LastRow();
        WHILE i >= 1 DO
            /*
            ** determine manual/auto mode
            */
            ManualATS = 0;
            REPEATED 
            SELECT ManualATS = 1
            FROM  Udb_Grouping G,
                  FMS_ObjectStatus OS,
                  TFMS_CardToObject CTO
            WHERE CTO.Card = :CardDetails.Card 
              AND CTO.Object = G.Grouping 
              AND G.RelationShip = :Interaction$MemberOf 
              AND G.Member = :RED_ATS[i].GrouperId 
              AND G.MemberType IN (SELECT Type
                                   FROM Udb_ExtendedType
                                   WHERE SuperType = :Type$ATSGrouper)
              AND G.Member = OS.Object
              AND OS.Status = :Status$ATSManual;
            CALLPROC DDB_ROLLBACK;
            /*
            ** Identify ATS supplying switch on current feeder
            */
            LocSwitch = 0;
            REPEATED
            SELECT 
                :LocSwitch = G1.Member,
                :NormalOpen = S.NormalOpen,
                :CurrentlyOpen = S.CurrentlyOpen
            FROM Udb_Grouping G1,
                 Udb_Grouping G2,
                 Udb_Switch S,
                 TFMS_CardToObject CTO
            WHERE G1.Grouping = :RED_ATS[i].GrouperID 
              AND G1.RelationShip = :Interaction$MemberOf
              AND G1.Member = G2.Member
              AND G1.MemberType IN (SELECT Type
                                    FROM Udb_ExtendedType
                                    WHERE SuperType = :Type$ATSSupply)
              AND G2.Grouping = CTO.Object 
              AND CTO.Card = :CardDetails.Card
              AND G2.RelationShip = :Interaction$MemberOf
              AND S.Object = G1.Member;
            CALLPROC DDB_ROLLBACK;
/*
** If Current Feeder device Currently open, not necessary to look at other
** feeder - should not present potential loss of service warning.
*/
            IF CurrentlyOpen = 1 THEN
               RED_ATS.RemoveRow (RowNumber = i);
            ELSE
            /*
            ** identify alternate switch and feeder for this ATS
            */
              IF LocSwitch <> 0 THEN
                AltSwitch = 0;
                AltFeeder = 0;
                REPEATED
                SELECT
                    :AltSwitch = G1.Member,
                    :AltFeeder = G2.Grouping,
                    :AltSwitchCurOpen = S.CurrentlyOpen
                FROM Udb_Grouping G1,
                     Udb_Grouping G2,
                     Udb_Switch S
                WHERE G1.Grouping = :RED_ATS[i].GrouperID 
                  AND G1.RelationShip = :Interaction$MemberOf
                  AND G1.Member = G2.Member
                  AND G1.MemberType IN (SELECT Type
                                        FROM Udb_ExtendedType
                                        WHERE SuperType = :Type$ATSSupply)
                  AND G2.Grouping NOT IN (SELECT Object FROM TFMS_CardToObject
                                          WHERE  Card = :CardDetails.Card)
                  AND G2.GroupingType IN (SELECT Type 
                                          FROM Udb_ExtendedType
                                          WHERE SuperType = :Type$Feeder)
                  AND G2.RelationShip = :Interaction$MemberOf
                  AND S.Object = G1.Member;

                IF AltSwitch <> 0 AND AltFeeder <> 0 THEN

                    AltFeederStatus = 1;
                    REPEATED
                    SELECT :AltFeederStatus = 0
                    FROM FMS_ObjectStatus OS
                    WHERE OS.Object = :AltFeeder
                      AND OS.Status = :Status$CO;
                    /*
                    ** If (ATS auto and alternate feeder is in service) or
                    ** (ATS manual and alt feeder in service and 
                    **  alt switch closed), no warning is necessary: remove
                    ** the ATS from the RED list
                    */                 
                    IF (ManualATS = 0 AND AltFeederStatus = 1) OR
                       (ManualATS = 1 AND AltFeederStatus = 1 AND
                        AltSwitchCurOpen = 0) THEN
                       RED_ATS.RemoveRow (RowNumber = i);
                    ENDIF;
                ENDIF;
              ENDIF;
            ENDIF;;
            i = i - 1;       
        ENDWHILE;

        IF RED_ATS.LastRow() > 0 THEN
            i = 1;
            REDString = '';
            WHILE i <= RED_ATS.LastRow() DO
                IF i = 1 THEN
                    REDString = RED_ATS[i].GrouperName;
                ELSE
                    REDString = REDString + ', ' + RED_ATS[i].GrouperName;
                ENDIF;
                i = i + 1;
            ENDWHILE;
                
            WarningStatus = CALLFRAME Warning 
                            (Card = JIP.Card, 
                             Job = JIP.Job,
                             SwitchingItem = JIP.SwitchingItem,
                             Text = ' Feeder Cutout will cause loss of customers ' + 
                             ' fed from ATS: ' + REDString);
            IF WarningStatus = PU_CANCEL THEN
                RETURN(PU_CANCEL);
            ELSE
                OverRide = TRUE;
            ENDIF;
        ENDIF;
    ENDIF;

    IF Loop_Color = CC_RED THEN 
        i = 1;
        REDString = '';
        WHILE i <= RED_Loop.LastRow() DO
            IF i = 1 THEN
                REDString = RED_Loop[i].GrouperName;
            ELSE
                REDString = REDString + ', ' + RED_Loop[i].GrouperName;
            ENDIF;
            i = i + 1;
        ENDWHILE;
                
        WarningStatus = CALLFRAME Warning 
                           (Card = JIP.Card, 
                            Job = JIP.Job,
                            SwitchingItem = JIP.SwitchingItem,
                            Text = ' Feeder Cutout will cause loss of customers ' + 
                       ' fed from LOOP: ' + REDString);
        IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            OverRide = TRUE;
        ENDIF;
    ENDIF;

    IF ISO_Color = CC_RED THEN 
        i = 1;
        REDString = '';
        WHILE i <= RED_ISO.LastRow() DO
            IF i = 1 THEN
                REDString = RED_ISO[i].GrouperName;
            ELSE
                REDString = REDString + ', ' + RED_ISO[i].GrouperName;
            ENDIF;
            i = i + 1;
        ENDWHILE;
                
        WarningStatus = CALLFRAME Warning 
                           (Card = JIP.Card, 
                            Job = JIP.Job,
                            SwitchingItem = JIP.SwitchingItem,
                            Text = ' Feeder Cutout will cause loss of customers ' + 
                            ' fed from ISONET: ' + REDString);
        IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            OverRide = TRUE;
        ENDIF;
    ENDIF;
/*
**  Check to see if they overrode a warning 
*/
    IF OverRide = FALSE THEN
       RETURN(NULL); 
    ELSE
       RETURN(Warning$Overridden);
    ENDIF;
END;

Application Component Report
============================

	Name:            CheckATS101And102Open

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckATS101And102Open  
**
**  Modifications:
**  06/03/93 em	  Created 
**  11/15/02 ysp  Merge: removed C and Jobs as passed-ins.

*/
PROCEDURE  CheckATS101And102Open 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    ATSSourceEquip = ARRAY OF ObjectSummaryClass;  
    FeederOut = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Using connectivity in Database, make sure the 101 and 102 Feeders
**  are cutout or grounded.
**  First get Feeders
*/ 
  i = 1;
  SELECT :ATSSourceEquip[i].Object = O.Object,
         :ATSSourceEquip[i].Name = O.Name
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O 
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 1 AND      /* Terminal 1 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND      /* Terminal 2 */
         T2.Object = O.Object
  BEGIN
     i = i + 1;
  END;
  CALLPROC DDB_ROLLBACK;

  
  WarningStatus = PU_OK;
  
  IF i < 3 THEN
    
    WarningStatus = CALLFRAME Warning 
                             (Card = JIP.Card, 
                              Job = JIP.Job,
                              SwitchingItem = JIP.SwitchingItem,
                              Text = 'Insufficient connectivity data to verify if ATS Source ' +
                'Feeders are open.');  
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
 
  ELSE

    i = 1;
    WHILE i <= ATSSourceEquip.LastRow() DO

        SELECT  :FeederOut = ifnull(Sum(StatusCount),0)
        FROM    FMS_ObjectStatus
        WHERE   Object = :ATSSourceEquip[i].Object AND
                Status = :Status$Open;
        IF FeederOut = 0 THEN 

           WarningStatus = CALLFRAME Warning 
                                     (Card = JIP.Card, 
                                      Job = JIP.Job,
                                      SwitchingItem = JIP.SwitchingItem,
                                      Text = 'Cannot confirm that ATS Source Equip ' + 
                        varchar(:ATSSourceEquip[i].Name) + ' is open.');

           IF WarningStatus = PU_CANCEL THEN
              RETURN(PU_CANCEL);
           ELSE
              RETURN(Warning$Overridden);
           ENDIF;

        ENDIF;
        FeederOut = 0;
        i = i + 1;

    ENDWHILE;

  ENDIF;

  RETURN(NULL); 

END;

Application Component Report
============================

	Name:            CheckATSAssocFdr

/*
** Copyright c 1997 ESCA Corporation. All Rights Reserved.
** 
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          CheckATSAssocFdr
**
**  Modifications:
**  10/14/97  jfl  Created 
**  11/15/02  ysp  Merge: removed C and Jobs as passed-ins.
**  02/28/03  pkw  Use DISTINCT against SOA_ActiveCard for feeder
**                 that span divisions.
**  12/31/10  em   For 3G, must consider all feeders on card that controls move
**                 Does not appear that this check is in use currently.
*/
PROCEDURE  CheckATSAssocFdr
(
    JIP = JobInProgress;				/* Job being processed */

    ATSEquip = GrouperInfo;
    ManualATS = INTEGER NOT NULL;
    AltSwitch = INTEGER NOT NULL;
    AltSwitchCurOpen = INTEGER NOT NULL;
    AltFeeder = INTEGER NOT NULL;
    AltFeederStatus = INTEGER NOT NULL;
    Feeder = INTEGER NOT NULL;
    WarningStatus = INTEGER;
    OverRide = INTEGER NOT NULL;
) =
BEGIN
    OverRide = FALSE; 
    WarningStatus = PU_OK;
    IF JIP.Equip <> 0 THEN
        /*
        ** identify ATS
        */
        ATSEquip.GrouperID = 0;
        REPEATED
        SELECT 
            :ATSEquip.GrouperId = O.Object,
            :ATSEquip.GrouperName = O.Name
        FROM Udb_Grouping G,
             Udb_Object O
        WHERE G.Member = :JIP.Equip
          AND G.RelationShip = :Interaction$MemberOf
          AND G.GroupingType IN (:Type$ATS, :Type$ATSP, :Type$ATSU)
          AND O.Object = G.Grouping;
        CALLPROC DDB_ROLLBACK;

        IF ATSEquip.GrouperID = 0 THEN  /*If we are not on ATS, then exit*/
           RETURN(NULL);
        ENDIF;

        Feeder = 0;
        REPEATED
        SELECT DISTINCT
              :Feeder = G.Grouping
        FROM   SOA_JobControl JC,
               SOA_ActiveObject AC,
               Udb_Grouping G
        WHERE JC.Job = :JIP.Job AND
              JC.Card = AC.Card AND
              AC.Object = G.Grouping AND
              G.GroupingType = :Type$Feeder AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = :JIP.Equip;
        CALLPROC DDB_ROLLBACK;
        /*
        ** determine manual/auto mode
        */
        ManualATS = 0;
        REPEATED 
        SELECT ManualATS = 1
        FROM  FMS_ObjectStatus OS
        WHERE OS.Object = :ATSEquip.GrouperId
          AND OS.Status = :Status$ATSManual;
        CALLPROC DDB_ROLLBACK;
        /*
        ** identify alternate switch and feeder for this ATS
        */
        AltSwitch = 0;
        AltFeeder = 0;
        REPEATED
        SELECT
            :AltSwitch = G1.Member,
            :AltFeeder = G2.Grouping,
            :AltSwitchCurOpen = S.CurrentlyOpen
        FROM Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Switch S
        WHERE G1.Grouping = :ATSEquip.GrouperID 
          AND G1.RelationShip = :Interaction$MemberOf
          AND G1.Member = G2.Member
          AND G1.MemberType IN (SELECT Type
                                FROM Udb_ExtendedType
                                WHERE SuperType = :Type$ATSSupply)
          AND G2.Grouping <> :Feeder
          AND G2.GroupingType IN (SELECT Type 
                                  FROM Udb_ExtendedType
                                  WHERE SuperType = :Type$Feeder)
          AND G2.RelationShip = :Interaction$MemberOf
          AND S.Object = G1.Member;

        IF AltSwitch <> 0 AND AltFeeder <> 0 THEN
            AltFeederStatus = 1;
            REPEATED
            SELECT :AltFeederStatus = 0
            FROM FMS_ObjectStatus OS
            WHERE OS.Object = :AltFeeder
              AND OS.Status = :Status$CO;
            /*
            ** If (ATS auto and alternate feeder is out of service) or
            ** (ATS manual and (alt feeder out of service or 
            **  alt switch open), generate a warning
            */                 
            IF (ManualATS = 0 AND AltFeederStatus = 0) OR
               (ManualATS = 1 AND (AltFeederStatus = 0 OR
                AltSwitchCurOpen = 1)) THEN
                WarningStatus = CALLFRAME Warning 
                                     (Card = JIP.Card, 
                                      Job = JIP.Job,
                                      SwitchingItem = JIP.SwitchingItem,
                                      Text = ' Open ATS switch will cause loss of customers ' + 
                           ' fed from ATS: ' + ATSEquip.GrouperName);
                IF WarningStatus = PU_CANCEL THEN
                    RETURN(PU_CANCEL);
                ELSE
                    OverRide = TRUE;
                ENDIF;
            ENDIF;
        ENDIF;
    ENDIF;
/*
**  Check to see if they overrode a warning 
*/
    IF OverRide = FALSE THEN
       RETURN(NULL); 
    ELSE
       RETURN(Warning$Overridden);
    ENDIF;
END;

