	Name:            OSS_WorkItem


Component Method Scripts
--------------------------
/*
**
**      Copyright c 2008 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OSS_WorkItem
**
**  Date:       Version Description
** ----------------------------------
**  09/02/08    em      OutageSchedulingSystem prototype.
*/
METHOD SaveWorkItem (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m  = INTEGER NOT NULL WITH DEFAULT;
   NextWorkItem = INTEGER NOT NULL WITH DEFAULT;
   ScenarioEquipList = ARRAY OF ConnectedEquipClass;  /*Return Equip List*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeMapping = TypeClass_ASE;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Will determine WorkItem number, save work item and call Scenario
** for the PrimaryEquip to return list of Impacted Equipment.
*/
   SELECT :NextWorkItem = IFNULL(MAX(WorkItem),0) 
   FROM   OSS_WorkItem
   WHERE  RequestID = :CurObject.RequestID;

   NextWorkItem = NextWorkItem  + 1;

   CurObject.ReturnCode = CALLPROC OSS_WorkItemIns (
           RequestID = CurObject.RequestID
         , WorkItem = NextWorkItem
         , PrimaryEquip = CurObject.PrimaryEquip);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_WorkItem.SaveWorkItem; Error saving OSS Work Item';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_WorkItem.SaveWorkItem; ' + 
                'Error saving OSS Work Item');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Invoke Scenario Trace to build list of Impacted Equipment.
*/  

   RetCode = CALLPROC OSS_ScenarioTrace (
                      StartPoint = CurObject.PrimaryEquip,
                      CollectedEquip = ScenarioEquipList);

   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;

   IF ScenarioEquipList.LastRow() <= 1 THEN 
      CurObject.ErrorMessage = 'OSS_WorkItem.SaveWorkItem; Scenario Trace did not return any equipment';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_WorkItem.SaveWorkItem; ' + 
                'ScenarioTrace did not return any equipment');
      RETURN;
   ENDIF;

   TypeMapping.GetEquipTypeMapping();

   FOR i = 1 TO ScenarioEquipList.LastRow() DO
      CurObject.ReturnCode = CALLPROC OSS_ImpactedEquipIns (
           RequestID = CurObject.RequestID
         , WorkItem = NextWorkItem
         , Equip = ScenarioEquipList[i].Object);

      IF CurObject.ReturnCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ErrorMessage = 'OSS_WorkItem.SaveWorkItem; Error saving OSS Work Item Impacted equipment';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_WorkItem.SaveWorkItem; ' + 
                'Error saving OSS Work Item Impacted equipment');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
  
      CurObject.ImpactedEquip[i].Equip =  ScenarioEquipList[i].Object;     
      CurObject.ImpactedEquip[i].EquipName =  ScenarioEquipList[i].Name;     
      CurObject.ImpactedEquip[i].EquipType =  ScenarioEquipList[i].Type;     
      CurObject.ImpactedEquip[i].EquipTypeName =  ScenarioEquipList[i].TypeName;     
         IF TypeMapping.CList.LastRow > 0 THEN
            RetCode = TypeMapping.CList.Find(AttributeName = 'Type',
                                            Value = CurObject.ImpactedEquip[i].EquipType,
                                            RowNumber = ByRef(m));
            IF RetCode = ER_OK THEN
               CurObject.ImpactedEquip[i].EquipTypeName = TypeMapping.CList[m].Description;
            ENDIF;
         ENDIF;
   ENDFOR;

   CurObject.WorkItem = NextWorkItem;
   RETURN;
END;


METHOD RemoveWorkItem (
) =
DECLARE
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC OSS_WorkItemDel (
                 RequestID = CurObject.RequestID
               , WorkItem = CurObject.WorkItem);

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'OSS_WorkItem.RemoveWorkItem; Error deleting OSS Work Item';
      CurMethod.Trace(Text = varchar(date('now')) + ' : OSS_WorkItem.RemoveWorkItem; ' + 
                'Error deleting OSS Work Item');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
END; 

