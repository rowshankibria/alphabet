	Name:            cac_insertrelayopforall

/*
** Copyright c 1995 ESCA Corporation. All Rights Reserved.
**
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
**
** 12/11/96   ysp    Parameter changed for call to udb_nextkey
** 01/06/2000 em     Removed reference to slc_job, converted to soa_job
*/

PROCEDURE cac_insertrelayopforall
(    CardType = INTEGER NOT NULL          /* PARAMETER */
,    Card = INTEGER NOT NULL          /* PARAMETER */
,    SwitchingItem = INTEGER WITH NULL          /* PARAMETER */
,    Line = SMALLINT WITH NULL          /* PARAMETER */
,    FeederName = VARCHAR(40) WITH NULL          /* PARAMETER */
,    Equip = INTEGER WITH NULL          /* PARAMETER */
,    EquipName = VARCHAR(40) WITH NULL          /* PARAMETER */
,    EquipClass = INTEGER WITH NULL          /* PARAMETER */
,    EquipClassName = VARCHAR(40) WITH NULL          /* PARAMETER */
,    RelayType = INTEGER WITH NULL          /* PARAMETER */
,    RelayTypeName = VARCHAR(20) WITH NULL          /* PARAMETER */
,    RelayClass = INTEGER WITH NULL          /* PARAMETER */
,    RelayClassName = VARCHAR(40) WITH NULL          /* PARAMETER */
,    RelayName = VARCHAR(40) WITH NULL          /* PARAMETER */
,    Operation = SMALLINT WITH NULL          /* PARAMETER */
,    TimeStamp = DATE WITH NULL          /* PARAMETER */
,    Trip = INTEGER WITH NULL          /* PARAMETER */
,    OutOfService = INTEGER WITH NULL          /* PARAMETER */
,    Compromised = INTEGER WITH NULL          /* PARAMETER */
,    CardList = ARRAY OF CAC_Card              /* local */
,    RelayOp = INTEGER NOT NULL               /* local */
,    RetCode = INTEGER                         /* local */
,    i = INTEGER                               /* local */
,    sw = INTEGER WITH NULL                    /* local */
)=
BEGIN
    RelayOp = CALLPROC Udb_NextKey (KeyName = 'RelayGrouping');
    IF RelayOp < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'error in getting relay operation key.';
       RETURN RelayOp;
    ENDIF;
    CALLPROC DDB_COMMIT;
     
    RetCode = CALLPROC cac_insertrelayop
        (    CardType = CardType
        ,    Card = Card
        ,    RelayOp = RelayOP
        ,    SwitchingItem = SwitchingItem
        ,    Line = Line
        ,    FeederName = FeederName
        ,    Equip = Equip
        ,    EquipName = EquipName
        ,    EquipClass = EquipClass
        ,    EquipClassName = EquipClassName
        ,    RelayType = RelayType
        ,    RelayTypeName = RelayTypeName
        ,    RelayClass = RelayClass
        ,    RelayClassName = RelayClassName
        ,    RelayName = RelayName
        ,    Operation = Operation
        ,    TimeStamp = TimeStamp
        ,    Trip = Trip
        ,    OutOfService = OutOfService
        ,    Compromised = Compromised
    );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'error in insert relay operation entry.';
       RETURN Retcode;
    ENDIF;
    CALLPROC DDB_COMMIT;

    RetCode = CALLPROC CAC_FindRelatedCards (CardType = CardType,
                                             Card     = Card,
                                             RelayOp  = RelayOp,
                                             Equip    = Equip,
                                             CardList = byref(CardList));
    IF CardList.LastRow() > 0 THEN
       /* insert entries in RelayOpControl table */
       i = 1;
       WHILE i <= CardList.LastRow() DO
          /*
          ** for a SLC card, we need to find the appropriate switching item.
          */
          IF CardList[i].CardType = Type$SLCApp THEN
             sw = NULL;
             SELECT DISTINCT :sw = JC.SwitchingItem
             FROM   SOA_JobControl JC,
                    SOA_Job J
             WHERE  JC.Card = :CardList[i].Card
               AND  JC.Job = J.Job 
               AND  J.Equip = :Equip
               AND  J.MoveCategory = 0 /*Normal*/
               AND  (J.SwItemStatus >= 20 AND J.SwItemStatus < 50)
               AND  J.Status IN ('','NIS'); 
             CALLPROC DDB_ROLLBACK;

             IF SW IS NULL THEN
                CardList.RemoveRow (RowNumber = i);
                i = i - 1;
             ELSE
                RetCode = CALLPROC CAC_AddRelayOpControl (
                                             CardType = CardList[i].CardType,
                                             Card     = CardList[i].Card,
                                             Switchingitem = SW,
                                             RelayOp  = RelayOp);
                IF RetCode < 0 THEN
                   CALLPROC DDB_ROLLBACK;
                   Message 'error in add a relay operation control entry.';
                ENDIF;
                CALLPROC DDB_COMMIT;
             ENDIF;
          ELSE
             RetCode = CALLPROC CAC_AddRelayOpControl (
                                             CardType = CardList[i].CardType,
                                             Card     = CardList[i].Card,
                                             Switchingitem = NULL,
                                             RelayOp  = RelayOp);
             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'error in add a relay operation control entry.';
             ENDIF;
             CALLPROC DDB_COMMIT;
          ENDIF;

          i = i + 1;   
       ENDWHILE;
    ENDIF;

    IF CardList.LastRow() > 0 THEN
       RetCode = CALLPROC CAC_RaiseRelayUpdate (
                                        RelayOp = RelayOp, 
                                        Action   = 'INSERT',
                                        CardList = CardList);
    ENDIF;

    RETURN RetCode;
END;

Application Component Report
