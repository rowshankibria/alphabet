**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Date   Initials    
** --------------------------------------------------------
**
**  12/08/04  ysp  Created
**  06/26/06  ysp  If the circuit is a RTU Circuit type, the move category
**                 is set to RTU_Circuit. This logic supercedes the step heading
**                 except for work permits.
**  11/28/08  em   Include ISWP moves in WP category
**  01/20/10  ysp  TLS 50: Get Route info from udb_circuitRoute table. Remove route attribute.
*/

METHOD GetMoveCategory
(
)=
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;
    MoveCategory = INTEGER NOT NULL WITH DEFAULT;
BEGIN
    IF CurObject.StepPair IS NULL OR CurObject.StepPair = 0 THEN
       CurObject.StepPair = 0;
       
       SELECT :CurObject.StepPair = StepPair
       FROM   TC_Job
       WHERE  Job = :CurObject.Job;
       CALLPROC DDB_ROLLBACK;
    ENDIF;

    CurObject.Category = 0;

    IF CurObject.StepPair = Step$WorkPermit OR 
         CurObject.StepPair = StepHeading$TLS_ISWP THEN
       i = 0;
       REPEATED
       SELECT :i = COUNT(*)
       FROM   FMS_JobAction JA,
              TC_Job J
       WHERE  J.Job = :CurObject.Job AND
              JA.JobClass  = J.JobClass AND
              JA.EquipClass IN (SELECT SuperType
                                FROM   Udb_ExtendedType
                                WHERE  Type = J.CircuitClass) AND
              JA.StepPair  = :Step$WorkPermit AND  
              JA.TypeofCard = :Type$TelCard AND
              JA.Action = :JobAction$Set  AND                             /* SET */
              JA.Status IN (:Status$ATT, :Status$Verizon);                        /* ATT and Verizon */
       CALLPROC DDB_ROLLBACK;

       IF i = 0 THEN
          CurObject.Category = MoveCategory$NonTelco;
       ELSE
          CurObject.Category = MoveCategory$Telco;
       ENDIF;
    ELSE
       i = 0;
       SELECT :i = 1
       FROM   UDB_ExtendedType 
       WHERE  SuperType = :Type$RTUCircuit AND
              Type = :CurObject.CircuitClass;

       IF i = 1 THEN
          CurObject.Category = MoveCategory$RTUCircuit;
       ELSE       
          IF CurObject.StepPair = Step$Alarms THEN
             CurObject.Category = MoveCategory$Alarms;

          ELSEIF CurObject.StepPair = Step$SwitchOperation THEN
             CurObject.Category = MoveCategory$SwitchOperation;

          ELSEIF CurObject.StepPair = Step$Notification THEN
             CurObject.Category = MoveCategory$Notification;
          ENDIF;
       ENDIF;
    ENDIF;

    CurObject.CategoryName = GetCategoryName(CategoryID = CurObject.Category);
END;

METHOD GetRoute(
)=
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;
    RouteName = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
    CurObject.RouteName = '';

    SELECT :RouteName = T.Name
    FROM   Udb_CircuitRoute TC,
           Udb_Type T
    WHERE  TC.Object = :CurObject.Circuit AND
           TC.Route = T.Type
    BEGIN
       IF CurObject.RouteName  = '' THEN
          CurObject.RouteName = RouteName;
       ELSE
          CurObject.RouteName = CurObject.RouteName + ';' + RouteName;
       ENDIF;
    END;
    CALLPROC DDB_ROLLBACK;
END;

