   SELECT :Delay_SF.Reason = DelayReason,
          :Delay_SF.NewOutageDate = NewOutageDate
   FROM   SOA_OutageRequest
   WHERE  SWPNumber = :swp_tf[CurrentRow].ORNumber;
   CALLPROC DDB_ROLLBACK;
*/   
