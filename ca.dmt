METHOD GrouperColor
( Grouper = GrouperClass)
= 
DECLARE 
    Percentage = INTEGER NOT NULL;
ENDDECLARE

BEGIN
    IF (Grouper.NumSupply + Grouper.NumNoSupply = 0 ) THEN
        RETURN (CC_BLUE);
    ELSE
        Percentage = (Grouper.NumNosupply * 100) /
                     (Grouper.NumSupply + Grouper.NumNoSupply);
        IF Percentage = 0 THEN
            RETURN (CC_BLUE);
        ELSEIF Percentage < 50 THEN
            RETURN (CC_WHITE);
        ELSEIF Percentage < 100 THEN
            RETURN (CC_YELLOW);
        ELSE 
            RETURN (CC_RED);
        ENDIF;
    ENDIF;
END;

