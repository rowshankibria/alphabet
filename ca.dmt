	Name:            FODOrder

/*
**
**      Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
**  Application:    FMS
**  Frame:          FODOrder
**
**  Date:    Version Description
** ----------------------------------
** 03/04/03   pkw   Created(Started with OperatingOrder for template).
** 04/14/03   em    Default end date is incorrectly excluding today's orders.
** 07/14/03   ysp   Add Confirm button if any FOD job is pending D.O's confirmation.
**                  This will allow DO to confirm rejected/rescinded/returned jobs 
**                  even if there is no incoming return message.
** 01/30/04   em    Load Specific order if ordernumber is passed.
** 03/31/04   em    If Order Status Cancelled from Process Automation Stoppage,
**                  don't show order on this screen.
** 11/25/04   pkw   Modify for #9.
** 11/05/05   pkw   Added Message History button
** 12/14/05   ysp   Increase the size of tomove to 160 chars
** 03/13/07   em    Show Confirm Rescind/Reject status
** 09/15/10   em    Replaced incoming parameter feeder with card.  Update for 3G.
** 07/13/15   em    Add Union to ArchiveCardtoObject table when loading orders based on time to
**                  get closed card orders
** 04/11/16   em    Include car when accessing FMS_ArchiveJob to prevent common equipment
**                  moves from being selected on each feeder whent he printid is different
** 12/09/16   ysp   Increase length of move return remark (d.returnremark field)
*/ 
INITIALIZE
(
/*
**  Passed Parameters
*/
    Card     = INTEGER NOT NULL WITH DEFAULT;   
    Job      = INTEGER NOT NULL WITH DEFAULT;   /*Used only when called from ShowJobDetails*/
    TORS     = INTEGER NOT NULL WITH DEFAULT;   /*Used only when called from ShowJobDetails*/
    LoadOrder = INTEGER NOT NULL WITH DEFAULT;  /*Optional*/
/*
**  Internal Variables
*/
    i               = Integer NOT NULL WITH DEFAULT;
    k               = Integer NOT NULL WITH DEFAULT;
    HighestPriority = INTEGER NOT NULL;
    LastRow         = INTEGER NOT NULL;
    PendingFlag     = INTEGER NOT NULL WITH DEFAULT;
    CurStatus       = Integer NOT NULL;
    SelectedRow     = INTEGER WITH NULL;
    TOOperator      = INTEGER WITH NULL;
    RSOperator      = INTEGER WITH NULL;
    OldLog         = VARCHAR(100) NOT NULL;
    OrderSequence  = VARCHAR(20)  NOT NULL;
    OrderTarget    = VARCHAR(20)  NOT NULL;
    RetCode 	   = INTEGER NOT NULL;
    RescindType    = VARCHAR(20) NOT NULL;
    ControlText    = VARCHAR(256) NOT NULL /* For DBEVENT */;
    EventText      = VARCHAR(256) NOT NULL; /* DB Event Message Text */
) =
BEGIN
/* 
** Set up the Search Area 
*/
    IF Job <> 0 THEN
       REPEATED
       SELECT DISTINCT
               :FeederName = O.Name
       FROM     IR_FODOrderJobs OJ,
                IR_FODOrder FO,
                Udb_Object O
       WHERE    OJ.Job = :Job AND
                OJ.OrderNumber = FO.OrderNumber AND 
                FO.Feeder = O.Object;
    ENDIF;
    CALLPROC DDB_ROLLBACK;
    
    FIELD(S.Description).TextValue = 'Select Order to Load';
    
    S.StartDate = DATE('TODAY') - '6 months';
    S.EndDate   = DATE('TODAY') + '1 day';

    FIELD(S).AbsXLeft = (CurFrame.WindowWidth - FIELD(S).Width)/2;
    FIELD(S).AbsYBottom = FIELD(Close_btn).AbsYBottom;

    FIELD(Confirm_btn).CurBias = FB_DIMMED;
     
    CurFrame.SendUserEvent(EventName = 'display selection'); 
END;


ON USEREVENT 'display selection' =
BEGIN
/*
** Load Operating orders for desired card.  
*/
   S.Orders.Clear();
   i = 1;
   
   IF Job <> 0 THEN
      REPEATED
      SELECT DISTINCT
            :S.Orders[i].IssueTime = FO.IssueTime,
            :S.Orders[i].OrderNumber = FO.OrderNumber,
            :S.Orders[i].Priority = FO.Priority,
            :S.Orders[i].IssuedByDO = FO.IssuedByDO,
            :S.Orders[i].OrderComment = FO.OrderComment
      FROM   IR_FODOrder FO,
             IR_FODOrderJobs J
      WHERE  J.Job = :Job AND
             J.TORS = :TORS AND
             J.OrderNumber = FO.OrderNumber AND
             FO.OrderStatus <> :Order$Cancelled
      ORDER BY IssueTime DESC
      BEGIN
         IF S.Orders[i].Priority = '' THEN
            S.Orders[i].Priority = 'Normal';
         ENDIF;
         i = i + 1;
      END;
   ELSE
      REPEATED
      SELECT DISTINCT
            :S.Orders[i].IssueTime = FO.IssueTime,
            :S.Orders[i].OrderNumber = FO.OrderNumber,
            :S.Orders[i].Priority = FO.Priority,
            :S.Orders[i].IssuedByDO = FO.IssuedByDO,
            :S.Orders[i].OrderComment = FO.OrderComment
      FROM   IR_FODOrder FO,
             TFMS_CardToObject CTO
      WHERE  CTO.Card = :Card AND
             CTO.Object = FO.Feeder AND
             FO.IssueTime > :S.StartDate AND
             FO.IssueTime <= :S.EndDate AND
             FO.OrderStatus <> :Order$Cancelled
      UNION
      SELECT DISTINCT
            FO.IssueTime,
            FO.OrderNumber,
            FO.Priority,
            FO.IssuedByDO,
            FO.OrderComment
      FROM   IR_FODOrder FO,
             TFMS_ArchiveCardToObject CTO
      WHERE  CTO.Card = :Card AND
             CTO.Object = FO.Feeder AND
             FO.IssueTime > :S.StartDate AND
             FO.IssueTime <= :S.EndDate AND
             FO.OrderStatus <> :Order$Cancelled
      ORDER BY IssueTime DESC
      BEGIN
         IF S.Orders[i].Priority = '' THEN
            S.Orders[i].Priority = 'Normal';
         ENDIF;
/* 
** Set row to selected if going directly to an order.
*/
         IF LoadOrder = S.Orders[i].OrderNumber THEN
            SelectedRow = i;
         ENDIF;
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
    
   IF i = 1 THEN
      MESSAGE 'No orders found ' +
              ' during selected time period.';
   ENDIF;
   
   IF LoadOrder <> 0 AND SelectedRow <> 0 THEN
      CurFrame.SendUserEvent (EventName = 'load_data');
   ELSEIF S.Orders.LastRow() = 1 THEN
      SelectedRow = 1;
      CurFrame.SendUserEvent (EventName = 'load_data');
   ELSE   
      FIELD(Close_btn).ParentField.ParentField.CurBias = FB_DIMMED;
      FIELD(S).CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON CLICK MessageHistory_btn = 
BEGIN
   CALLFRAME MessageHistory(Card = FMS_NewCardGlobal,
                            LoadObject = IFNULL(OrderNumber,0));  
END;

ON CHILDENTRY S.Orders =
BEGIN
/*
** Load a specific order.
*/
   OrderNumber = 0;
   SelectedRow = FIELD(S.Orders).CurRow;

   IF S.Orders[SelectedRow].OrderNumber > 0 THEN
      CurFrame.SendUserEvent( eventname = 'load_data' );
   ELSE
      MESSAGE 'Please re-select order.';
      RESUME;
   ENDIF;
   FIELD(S).CurBias = FB_INVISIBLE;
   FIELD(Close_btn).ParentField.ParentField.CurBias = FB_CHANGEABLE;
END;


ON USEREVENT 'load_data' =
BEGIN                                      
   FIELD(O).SetToDefault();
   OrderNumber    = S.Orders[SelectedRow].OrderNumber;
   Priority       = S.Orders[SelectedRow].Priority;
   O.IssuedByDO   = S.Orders[SelectedRow].IssuedByDO;
   O.IssueTime    = S.Orders[SelectedRow].IssueTime;
   O.OrderComment = S.Orders[SelectedRow].OrderComment;

   FIELD(Confirm_btn).CurBias = FB_DIMMED;
   PendingFlag = FALSE;
/*
**  Load the operating order data into the frame user classes 
*/
   IF OrderNumber = 0 THEN
      MESSAGE 'No Order Selected.';
      RESUME;
   ENDIF;
/*
**  Select the operating order header information.
*/
   SELECT  :OrderSequence = F.SequenceType,
           :O.FODEmployeeName = O.Description,
           :FeederName = O2.Name
   FROM    IR_FODOrder F,
           Udb_Object O,
           Udb_Object O2
   WHERE   F.OrderNumber = :OrderNumber AND
           F.FODEmployeeObject = O.Object AND
           F.Feeder = O2.Object;
   CALLPROC DDB_ROLLBACK;
   
   IF UPPERCASE(OrderSequence) = 'SEQUENCED' THEN
      Sequenced = TRUE;
   ELSE
      Sequenced = FALSE;
   ENDIF;
/*
**  Get the Work Tasks from the SOA_Job table.  This is a UNION of the
**  TakeOut(TO) and the Restore(RS) moves from active and archive tables.
*/
   i = 1;
   WL.Clear();
   SELECT  :WL[i].Printid = JC.printid,
           :WL[i].Job = J.Job,
           :WL[i].JobClass = J.JobClass,
           :WL[i].Equip = J.Equip,
           :WL[i].EquipClassName = J.EquipClassName,
           :WL[i].EquipName = J.EquipName,
           :WL[i].TOMove = J.TOMove,
           :WL[i].TOOperator = J.TOOperator,
           :WL[i].RSOperator = J.RSOperator,
           :WL[i].Seq = JTS.Seq,
           :WL[i].LockNumber = O.LockNumber,
           :WL[i].Combination = O.Combination,
           :WL[i].TOIssued = J.TOIssued,
           :WL[i].TOComplete = J.TOComplete,
           :WL[i].TORS = JTS.TORS,
           :WL[i].WorkStatusInt = JTS.JobStatus,
           :RescindType = JTS.RescindType
   FROM    SOA_Job J,
           SOA_JobControl JC,
           IR_FODOrder OO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   OO.OrderNumber = :OrderNumber AND
           OO.Card = JC.Card AND
           JC.Job = J.Job AND
           JTS.OrderNumber = :OrderNumber AND
           JTS.TORS = :Job$TakeOutInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   UNION 
   SELECT  JC.Printid,
           J.Job,
           J.JobClass,
           J.Equip,
           J.EquipClassName,
           J.EquipName,
           J.RSMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           O.LockNumber,
           O.Combination,
           J.RSIssued,
           J.RSComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    SOA_Job J,
           SOA_JobControl JC,
           IR_FODOrder OO,
           IR_FODOrderJobs JTS,
           Udb_Object O
   WHERE   OO.OrderNumber = :OrderNumber AND
           OO.Card = JC.Card AND
           JC.Job = J.Job AND
           JTS.OrderNumber = :OrderNumber AND
           JTS.TORS = :Job$RestoreInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   UNION
   SELECT  
           J.printid,
           J.Job,
           J.JobClass,
           J.Equip,
           J.EquipClassName,
           J.EquipName,
           J.TOMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           O.LockNumber,
           O.Combination,
           J.TOIssued,
           J.TOComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    FMS_ArchiveJob J,
           IR_FODOrderJobs JTS,
           IR_FODOrder OO,
           Udb_Object O
   WHERE   JTS.OrderNumber = :OrderNumber AND
           OO.OrderNumber = JTS.OrderNumber AND 
           OO.Card = J.Card AND
           JTS.TORS = :Job$TakeOutInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   UNION 
   SELECT  J.Printid,
           J.Job,
           J.JobClass,
           J.Equip,
           J.EquipClassName,
           J.EquipName,
           J.RSMove,
           J.TOOperator,
           J.RSOperator,
           JTS.Seq,
           O.LockNumber,
           O.Combination,
           J.RSIssued,
           J.RSComplete,
           JTS.TORS,
           JTS.JobStatus,
           JTS.RescindType
   FROM    FMS_ArchiveJob J,
           IR_FODOrderJobs JTS,
           IR_FODOrder OO,
           Udb_Object O
   WHERE   JTS.OrderNumber = :OrderNumber AND
           OO.OrderNumber = JTS.OrderNumber AND 
           OO.Card = J.Card AND
           JTS.TORS = :Job$RestoreInt AND
           JTS.Job = J.Job AND
           J.Equip = O.Object
   ORDER BY Seq
   BEGIN
      IF WL[i].WorkStatusInt = Order$Opened THEN
         WL[i].Response = 'Issued'; 
 
      ELSEIF WL[i].WorkStatusInt = Order$Rejected THEN
         WL[i].Response = 'Rejected';
         PendingFlag = TRUE;
 
      ELSEIF WL[i].WorkStatusInt = Order$Downloaded THEN
         WL[i].Response = 'Downloaded'; 

      ELSEIF WL[i].WorkStatusInt = Order$Acknowledged THEN
         WL[i].Response = 'Acknowledged'; 

      ELSEIF WL[i].WorkStatusInt = Order$Closed THEN
         WL[i].Response = 'Closed'; 
         PendingFlag = TRUE;

      ELSEIF WL[i].WorkStatusInt = Order$Rescinded THEN
         WL[i].Response = 'Rescinded';
         IF Trim(RescindType) = 'REQUEST' THEN
            PendingFlag = TRUE;
         ENDIF; 

      ELSEIF WL[i].WorkStatusInt = Order$ConfirmClosed THEN
         WL[i].Response = 'Confirm Closed'; 
      ELSEIF WL[i].WorkStatusInt = Order$ConfirmRejected THEN
         WL[i].Response = 'Confirm Rejected'; 
      ELSEIF WL[i].WorkStatusInt = Order$ConfirmRescinded THEN
         WL[i].Response = 'Confirm Rescinded'; 
      ELSE
         WL[i].Response = 'Unknown';         
      ENDIF; 
      i = i + 1;
   END;

/*
** IF There are completed jobs pending DO's confirmation, enable the Confirmation button.
** if there is not an incoming RETURN message.
*/
   IF PendingFlag = TRUE THEN
      i = 0;
      SELECT :i = Count(*)
      FROM   MSG_Message 
      WHERE  OrderNumber = :OrderNumber AND
             ToApp = 'FMS' AND
             (UpperCase(Msg) Like 'FOD RETURNED MOVE%' OR
              UpperCase(Msg) Like 'FOD RETURNED ORDER%' OR
              UpperCase(Msg) Like 'FOD REJECTED ORDER%' OR
              UpperCase(Msg) Like '#9 RETURNED MOVE%' OR
              UpperCase(Msg) Like '#9 RETURNED ORDER%' OR
              UpperCase(Msg) Like '#9 REJECTED ORDER%');

      If i = 0 THEN
         FIELD(Confirm_btn).CurBias = FB_LANDABLE;
      ENDIF;
   ENDIF;      
END;

/*
** Show FOD Move details 
*/
ON ChildProperties  WL[*].PrintID,
ON ChildProperties  WL[*].EquipClassName,
ON ChildProperties  WL[*].EquipName,
ON ChildProperties  WL[*].LockNumber,
ON ChildProperties  WL[*].Combination,
ON ChildProperties  WL[*].TOMove,
ON ChildProperties  WL[*].Response =
BEGIN
/*
** Go to Move Details unless this is a work permit.
*/
   i = 0;
   i = FIELD(WL).CurRow;
   IF i > 0 THEN 
      d.PrintId = WL[i].PrintId;
      d.EquipClassName = WL[i].EquipClassName;
      d.EquipName = WL[i].EquipName;
      d.LockNumber = WL[i].LockNumber;
      d.Combination = WL[i].Combination;
      d.TOMove = WL[i].TOMove;
      d.Response = WL[i].Response;
      
      REPEATED 
      SELECT  :d.ContactInfo = F.ContactInfo,
              :d.ReturnRemark = F.ReturnRemark,
              :d.Ack_sf.AckRejectTime = F.AckRejectTime,
              :d.Ack_sf.AckRejectedComment = F.AckRejectedComment,
              :d.Rescind_sf.RescindTime = F.RescindTime,
              :d.Rescind_sf.RescindType = F.RescindType,
              :d.Rescind_sf.RescindDo = F.RescindDO,
              :d.Rescind_sf.RescindReasonTypeName = F.RescindReasonTypeName,
              :d.Rescind_sf.RescindComment = F.RescindComment
      FROM     IR_FODOrderJobs F
      WHERE    F.Job = :WL[i].Job AND
               F.OrderNumber = :OrderNumber AND
               F.TORS = :WL[i].TORS;
      CALLPROC DDB_ROLLBACK;
/*
**  Adjust ReturnRemark to save space.
*/
      IF length(d.ReturnRemark) < 70 THEN
         FIELD(d.ReturnRemark).Rows = 1;
      ELSEIF length(d.ReturnRemark) < 140 THEN
         FIELD(d.ReturnRemark).Rows = 2;
      ELSE
         FIELD(d.ReturnRemark).Rows = 3;  
      ENDIF;
       
      IF WL[i].TORS = Job$TakeOutInt THEN
         REPEATED 
         SELECT  :d.FODOperatorName = O.Description
         FROM    Udb_Object O
         WHERE   O.Object = :WL[i].TOOperator;
      ELSE
         REPEATED 
         SELECT  :d.FODOperatorName = O.Description
         FROM    Udb_Object O
         WHERE   O.Object = :WL[i].RSOperator;
      ENDIF;
      CALLPROC DDB_ROLLBACK;
/*
**  Don't show ack stackfield if timestamp is blank.
*/
      IF d.ack_sf.AckRejectTime = '' THEN
         FIELD(d.ack_sf).CurBias = FB_INVISIBLE;
      ELSE
         FIELD(d.ack_sf).CurBias = FB_LANDABLE;   
         IF length(d.ack_sf.AckRejectedComment) < 70 THEN
            FIELD(d.ack_sf.AckRejectedComment).Rows = 1;
         ELSEIF length(d.ack_sf.AckRejectedComment) < 140 THEN
            FIELD(d.ack_sf.AckRejectedComment).Rows = 2;
         ELSE
            FIELD(d.ack_sf.AckRejectedComment).Rows = 3;  
         ENDIF;
      ENDIF;
/*
**  Don't show Rescind stackfield if timestamp is blank.
*/
      IF d.rescind_sf.RescindTime = '' THEN
         FIELD(d.rescind_sf).CurBias = FB_INVISIBLE;
      ELSE
         FIELD(d.rescind_sf).CurBias = FB_LANDABLE;   
         IF length(d.rescind_sf.RescindComment) < 70 THEN
            FIELD(d.rescind_sf.RescindComment).Rows = 1;
         ELSEIF length(d.rescind_sf.RescindComment) < 140 THEN
            FIELD(d.rescind_sf.RescindComment).Rows = 2;
         ELSE
            FIELD(d.rescind_sf.RescindComment).Rows = 3;  
         ENDIF;
      ENDIF;          

      Curframe.Flush();
      FIELD(d).AbsXLeft = (CurFrame.WindowWidth - FIELD(S).Width)/2;
      FIELD(d).AbsYBottom = FIELD(Close_btn).AbsYBottom;

      FIELD(Close_btn).ParentField.ParentField.CurBias = FB_DIMMED;
      FIELD(d).CurBias = FB_CHANGEABLE;

      
   ELSE
      RESUME;
   ENDIF; 
END;

ON CLICK S.Refresh_Btn,
ON CLICK LoadOrders_btn =
BEGIN
   CurFrame.SendUserEvent(EventName = 'display selection');
END;


ON CLICK Close_Btn =
BEGIN
   RETURN (PU_CANCEL);
END;

ON CLICK Confirm_Btn = 
BEGIN
   IF CurFrame.ConfirmPopup (MessageText = 
      'Please check that there is no ''FOD/#9 RETURNED'' or ''FOD/#9 REJECTED'' incoming message for ' +
      'this order. If no incoming message exists, select OK to continue.') = PU_OK THEN   
      EventText = UserName + ';' + VARCHAR(OrderNumber) + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnFODOrders', 
                               DBEventText = EventText); 
      CALLPROC DDB_COMMIT;
      RETURN (PU_OK);
   ELSE
      RESUME;
   ENDIF;
END;

ON CLICK d.OK_Btn =
BEGIN
   FIELD(d).CurBias = FB_INVISIBLE;
   FIELD(Close_btn).ParentField.ParentField.CurBias = FB_CHANGEABLE;
END;

ON CLICK S.Cancel_Btn =
BEGIN
   FIELD(S).CurBias = FB_INVISIBLE;
   FIELD(Close_btn).ParentField.ParentField.CurBias = FB_CHANGEABLE;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

