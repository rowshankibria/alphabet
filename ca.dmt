Application Component Report
============================

	Name:            PromptFullSetOfReadings

/*
**	Copyright c Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptFullSetofReadings
**
**  06/29/22  em   Created
*/

INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   NextSeq = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   RMoves = ARRAY OF JobInProgress;
   SimpleJob = JobInProgress;
   JobSubstation = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Get the first Job Seq after the Readings step
*/
   NextSeq = -1;
   REPEATED
   SELECT :NextSeq = IFNULL(MIN(Seq),-1)
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :JIP.Card AND
          JC.Job = J.Job AND
          JC.Seq > :JIP.Seq AND
          J.Status = '' AND
          JC.StepPair > :StepHeading$Readings;
/*
** Get the last Readings Seq in this step
*/  
   IF NextSeq = -1 THEN
      SELECT :NextSeq = IFNULL(MAX(Seq),-1)
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :JIP.Card AND
          JC.Job = J.Job AND
          JC.Seq > :JIP.Seq AND
          J.Status = '' AND
          JC.StepPair = :StepHeading$Readings;
      IF NextSeq > 0 THEN 
         NextSeq = NextSeq + 1;
      ENDIF;
   ENDIF;
   
   IF NextSeq = -1 THEN
      Message 'Did not identify any outstanding detail Reading moves.';
      RETURN (PU_OK);    /* There are no readings defined*/
   ENDIF;
/*
** Reselect the Heading move substation since it likely has been translated
** to the Electric substation for order download.
*/    
   SELECT :JobSubstation = Substation 
   FROM   SOA_Job
   WHERE  Job = :JIP.Job;
       
   i = 1;
   RMoves.Clear();
   REPEATED
   SELECT  :RMoves[i].Card = JC.Card,
           :RMoves[i].Job = J.Job,
           :RMoves[i].Equip = J.Equip,
           :RMoves[i].EquipClass = J.EquipClass,
           :RMoves[i].EquipClassName = J.EquipClassName,
           :RMoves[i].EquipName = J.EquipName,
           :RMoves[i].JobClass = J.JobClass,
           :RMoves[i].MoveEquipClass = JC.MoveEquipClass,
           :RMoves[i].MoveType = J.MoveType,
           :RMoves[i].Response = J.Response,
           :RMoves[i].RSComplete = J.RSComplete,
           :RMoves[i].RSIssued = J.RSIssued,
           :RMoves[i].RSMove = J.RSMove,
           :RMoves[i].RSMoveRules = J.RSMoveRules,
           :RMoves[i].RSOperator = J.RSOperator,
           :RMoves[i].Seq = JC.Seq,
           :RMoves[i].Status = J.Status,
           :RMoves[i].StepPair = JC.StepPair,
           :RMoves[i].Substation = J.Substation,
           :RMoves[i].SwitchingItem = JC.SwitchingItem,
           :RMoves[i].TOComplete = J.TOComplete,
           :RMoves[i].TOIssued = J.TOIssued,
           :RMoves[i].TOMove = J.TOMove,
           :RMoves[i].TOMoveRules = J.TOMoveRules,
           :RMoves[i].TOOperator = J.TOOperator
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :JIP.Card AND
          JC.Job = J.Job AND
          JC.Seq > :JIP.Seq AND
          JC.Seq < :NextSeq AND
          J.Status = '' AND
          JC.StepPair = :StepHeading$Readings AND
          J.Substation = :JobSubstation AND
          J.TOIssued IS NULL
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO RMoves.LastRow DO
      RMoves[i].Status = Job$TakeOut;
      RetCode = SimpleJob.IssueMove(Job = RMoves[i],
                                 SetTime = JIP.TOIssued);

      IF RetCode = PU_CANCEL THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to issue all Heading moves.',
                           TraceMessage =
                  'PromptFullSetOfReadings: Unable issue all Heading Moves associated with ' +
                  'job=' + VARCHAR(JIP.Job));
         RETURN (PU_CANCEL);
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
   
   RETURN (PU_OK);
END;

 

