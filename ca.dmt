	Name:            SelectScenarioStartPoint

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          SelectScenarioStartPoint
**
**  Date:       Author   Description
** ----------------------------------
**  10/11/00	EM       Created
**  01/18/00    em       Added Equipment Verification Scenario
**  01/19/00    em       Added Electrical Verification Scenario
**  06/07/06    em       Added Deluge Test Scenario
**  04/21/08    ysp      Add SLC Group Disconnect scenario
**  08/31/16    em       For scenario with ACLineSeg startpoint, make sure
**                       AC LineSeg is connected in Udb model.
**  04/03/17    em       Remove Udb_Terminal lookup for ACLineSegment presentation,
**                       increase number of displayed rows.
**
*/
INITIALIZE 
(
#  include StandardDeclarations

   Application 	= VARCHAR(20) NOT NULL;  /*Passed Application*/
   Card		= INTEGER NOT NULL;  /*Passed Card*/
   Scenario	= INTEGER NOT NULL;  /*Passed Scenario*/

   SelectedObject = INTEGER NOT NULL;
) =
BEGIN
   SelectedObject = 0;
   ObjectArray.Clear();
/*
** Based on the Scenario and the Application, we present different objects
** for trace startpoint selection.  The card may not yet be active, so to find
** the objects used on the card we use TFMS_CardToObject for the TFMS
** application and SOA_ActiveObjects for SLC, since SLC cards are always active.
*/
   i = 1;
   IF Application = Application$SLC THEN   /*SLC Scenarios*/
 
      IF Scenario = Scenario$TripCheck OR
            Scenario = Scenario$EquipmentVerification OR
            Scenario = Scenario$ElectricalVerification THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType IN (
                                     :Type$Transformer,:TypeName$BusSect) )
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$BusSectionWork THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :TypeName$BusSect) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$BreakerInspection THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$BREAKER) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$TapChangerInspection THEN
  
         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$Transformer) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$DelugeTest THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType IN (
                                     :Type$PowerTransformer,
                                     :Type$PhaseShifter,
                                     :Type$Reactor) )
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$GroupDisconnect THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 SOA_ActiveObject AO
         WHERE   AO.Card = :Card AND
                 AO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$ManDiscBus) 
         BEGIN
            i = i + 1;
         END;
      ELSE
         MESSAGE 'Invalid Scenario.';
         RETURN 0;
      ENDIF;
   ELSE                                    /*TFMS Scenarios*/
 
      IF Scenario = Scenario$TripCheck OR 
            Scenario = Scenario$FeederWork OR
            Scenario = Scenario$EquipmentVerification OR
            Scenario = Scenario$ElectricalVerification THEN
  
         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 TFMS_CardtoObject CTO
         WHERE   CTO.Card = :Card AND
                 CTO.Type = :Type$Line AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$ACLineSegment) 
         BEGIN
            i = i + 1;
         END;
         IF i = 2 THEN /* Only one line found, go ahead and return it */
            RETURN ObjectArray[1].Object;
         ENDIF;

      ELSEIF Scenario = Scenario$BusSectionWork THEN
  
         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 TFMS_CardtoObject CTO
         WHERE   CTO.Card = :Card AND
                 CTO.Type = :Type$Line AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :TypeName$BusSect) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$BreakerInspection THEN
  
         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 TFMS_CardtoObject CTO
         WHERE   CTO.Card = :Card AND
                 CTO.Type = :Type$Line AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$BREAKER) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$TapChangerInspection THEN
  
         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 TFMS_CardtoObject CTO
         WHERE   CTO.Card = :Card AND
                 CTO.Type = :Type$Line AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$Transformer) 
         BEGIN
            i = i + 1;
         END;

      ELSEIF Scenario = Scenario$DelugeTest THEN

         REPEATED
         SELECT   
         DISTINCT :ObjectArray[i].PrimaryGroupingName = O.PrimaryGroupingName
                 ,:ObjectArray[i].TypeName = O.TypeName
                 ,:ObjectArray[i].Name = O.Name
                 ,:ObjectArray[i].Object = O.Object
         FROM    Udb_Object O,
                 Udb_Grouping G,
                 TFMS_CardtoObject CTO
         WHERE   CTO.Card = :Card AND
                 CTO.Type = :Type$Line AND
                 CTO.Object = G.Grouping AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.Member = O.Object AND
                 O.Type IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType IN (
                                     :Type$PowerTransformer,
                                     :Type$PhaseShifter,
                                     :Type$Reactor) )
         BEGIN
            i = i + 1;
         END;
  
      ELSE
         MESSAGE 'Invalid Scenario.';
         RETURN 0;
      ENDIF;
   ENDIF;  

   IF i = 1 THEN
      MESSAGE 'No possible trace start points found on this card for ' +
              'scenario ' + ScenarioName;
      RETURN 0;
   ENDIF;
/*
   IF ObjectArray.LastRow() = 1 THEN
      RETURN ObjectArray[1].Object;
   ENDIF;
*/
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CHILDENTRY ObjectArray =
BEGIN
   SelectedObject = ObjectArray[].Object;
END;

ON CLICK OK_btn =
BEGIN
/*
** Save or Select/Return Operation.
*/
   RETURN SelectedObject;
END;


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN 0;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

