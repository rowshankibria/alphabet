    IF RetCode = 0 THEN
        RESUME;
    ELSE
        DistrictOperator = DOp.Description;
    ENDIF;                 
END;

ON ENTRY FCROperator.Name =
BEGIN
    RetCode = CALLFRAME SelectOperator (AnyName = TRUE);
    IF RetCode = PU_Cancel THEN
       CALLPROC DDB_ROLLBACK;
       RESUME;
    ELSE
       FCROperator.Name = FO.Description;
    ENDIF;             
END;


/*
**  Handle an OK click
*/
ON Click OKButton =
BEGIN
/*
** Validate entry fields
*/
    IF Lowercase (Reason) LIKE '%fuck%' OR 
       Lowercase (Reason) LIKE '%shit%' OR 
       Lowercase (Reason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        Reason = '';
	RESUME;

    ELSEIF Presel = 0 OR Length( Squeeze (Reason)) <= 6 THEN
        MESSAGE 'You must select a reason or enter more explanation.';
        Reason = '';
        RESUME;

    ELSEIF DistrictOperator = '' THEN 
        MESSAGE 'Please enter your name.';
        RESUME;

    ELSEIF FCROperator.Name = '' THEN
        MESSAGE 'Please select the FCR Operator you have contacted verbally.';
        RESUME;
    ENDIF;

    RetCode = CALLPROC SOA_LogIns (
              Card           = Job.Card
            , Job            = Job.Job
            , SwitchingItem  = Job.SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'Force Completion of FCR Caution'
            , New            = 'FCR contacted: ' + FCROperator.Name + 
                               '. Reason: ' + Reason
            );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to log the reason. You can continue to complete the FCR caution. ' + 
               'Please report the issue to technical support later.'
    ENDIF;
    CALLPROC DDB_COMMIT;

    RETURN(PU_OK);
END;
/*
**  Handle a Cancel click
*/
ON Click CancelButton =
BEGIN
    RETURN (PU_CANCEL);
END;
