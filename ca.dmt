	Name:            EETC_cardlist

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    all applications (FMS,SLC,TFMS)
**  Frame:          EETC_CardList
**
**  Modifications:
**  02/29/96    jfl     Created
**  06/10/96    jfl     Use Pale grey - Support Load card button
**  09/26/97    jfl     Only show work permits for user desk
*/
INITIALIZE
(
    Application = VARCHAR (8) NOT NULL;  /* P: Application (FMS,SLC,TFMS) */
    Desk        = INTEGER NOT NULL;      /* P: User Desk */
    i           = integer NOT NULL WITH DEFAULT;     /* Temporary counter */
    SelectRow   = INTEGER NOT NULL;                  /* Clicked RowNumber */
    Card        = ARRAY OF IntegerObject;            /* card numbers */
) =
BEGIN
    SelectRow = 0;
    CurFrame.SendUserEvent(EventName = 'load_data');
END;

ON UserEvent 'load_data' =
BEGIN
    WP.Clear();
    Card.Clear();

    i = 1;
    REPEATED
    SELECT DISTINCT
           :WP[i].CardType = CardType,
           :Card[i].Value = Card,
           :WP[i].CardName = CardName,
           :WP[i].Id = Id,
           :WP[i].Type = Type,
           :WP[i].Equipment = Equipment,
           :WP[i].WPMove = WPMove,
           :WP[i].ETC = ETC
    FROM   ITC_EETCCard
    WHERE Desk = :Desk
    ORDER BY CardType, ETC
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;

    CurFrame.SendUserEvent(EventName = 'UpdateWPMoveColor');
END;

ON USEREVENT 'UpdateWPMoveColor' =
BEGIN
   i = 1;
/*
** Make Alarm WPmoves darker 
** Also make WPmoves for other applications non-selectable
*/
   WHILE i <= WP.LastRow() DO
      IF WP[i].ETC < date ('now') THEN
         FIELD(WP[i].CardType).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].CardName).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].Id).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].Type).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].Equipment).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].WPMove).BgColor = CC_PALE_BLUE;
         FIELD(WP[i].ETC).BgColor = CC_PALE_BLUE;
      ENDIF;
      IF WP[i].CardType NOT LIKE Application THEN
         FIELD(WP[i].CardType).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].CardName).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].Id).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].Type).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].Equipment).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].WPMove).BgColor = CC_PALE_GRAY;
         FIELD(WP[i].ETC).BgColor = CC_PALE_GRAY;
      ENDIF;
      i = i + 1;
   ENDWHILE; 
END;

/*
**   Build SelectList for selected rows.
*/
ON ChildEntry WP =
BEGIN

    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Grayed fields make the row unselectable
*/
    IF (FIELD(WP[FIELD(WP).CurRow].CardType).BgColor = CC_PALE_GRAY) THEN
        Message 'You must select a Work Permit Move for ' +
                 Application + ' system. Please try again.';
        RESUME;
    ENDIF;
/*
**  Deselect eventual selected row
*/
    IF (SelectRow <> 0 ) THEN
        FIELD(WP[SelectRow].CardType).IsReverse = FALSE;
        FIELD(WP[SelectRow].CardName).IsReverse = FALSE;
        FIELD(WP[SelectRow].Id).IsReverse = FALSE;
        FIELD(WP[SelectRow].Type).IsReverse = FALSE;
        FIELD(WP[SelectRow].Equipment).IsReverse = FALSE;
        FIELD(WP[SelectRow].WPMove).IsReverse = FALSE;
        FIELD(WP[SelectRow].ETC).IsReverse = FALSE;
    ENDIF;
/*
**  Update row selected
*/
    SelectRow = FIELD(WP).CurRow;
    FIELD(WP[SelectRow].CardType).IsReverse = TRUE;
    FIELD(WP[SelectRow].CardName).IsReverse = TRUE;
    FIELD(WP[SelectRow].Id).IsReverse = TRUE;
    FIELD(WP[SelectRow].Type).IsReverse = TRUE;
    FIELD(WP[SelectRow].Equipment).IsReverse = TRUE;
    FIELD(WP[SelectRow].WPMove).IsReverse = TRUE;
    FIELD(WP[SelectRow].ETC).IsReverse = TRUE;

END;

/* 
**   Handle Termination Events
*/
ON Click Cancel_Btn =
BEGIN
    Return 0;
END;

ON ChildProperties WP, ON Click Load_Card =
BEGIN
    IF SelectRow = 0 THEN
        Message 'You must select a Work Permit Move. ' +
                'Please try again.';
        RESUME;
    ENDIF;
    Return Card[SelectRow].Value;
END;

ON WindowClose =
BEGIN
    RESUME;
END;


