**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          GreenSheetFile 
**
**  Date:       Version Description
** ----------------------------------
**  01/08/20 ysp Created
*/
METHOD InsertFile (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SaveDate = DATE NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_GreenSheetFileIns(
           RequestID = CurObject.RequestID,
           FileID = CurObject.FileID,
           FileName = SQUEEZE(CurObject.FileName)
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'GreenSheetFile.InsertFile; Error inserting Green Sheet';
       CurMethod.Trace(Text = varchar(date('now')) + ' : GreenSheetFile.InsertFile; ' + 
                'Error inserting Green Sheet ' + CurObject.FileName);
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    SaveDate = DATE('NOW');
    UpdateSql = ' UPDATE FMS_GreenSheetFile SET DataStream ' + 
                ' WHERE  RequestID = ' + VARCHAR(CurObject.RequestID) + 
                ' AND   FileID = ' + VARCHAR(CurObject.FileID);

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If CurObject.DataStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If CurObject.DataStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;

/*
** make it ddb compliant again. ???
*/
    CurMethod.DBSession = DDB_Global.Session.Cur;
    
    IF DBSession1Status = -1 AND DBSession2Status = -1 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'GreenSheetFile.InsertFile; Error saving file binary in database.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : GreenSheetFile.InsertFile; Error saving file binary in database.');
       RetCode = CALLPROC FMS_GreenSheetFileDel(
                              RequestID = CurObject.RequestID,
                              FileID = CurObject.FileID);
       CALLPROC DDB_COMMIT;
       RETURN;
    ELSEIF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       CurObject.DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       CurObject.DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       CurObject.DBServer = 2;

    ELSE
       CurObject.DBServer = -1;
    ENDIF;

    RETURN;
END;

METHOD GetDataStream (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SelectSql  = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.DBServer = DBServer,
          :CurObject.FileName = FileName
   FROM   FMS_GreenSheetFile 
   WHERE  RequestID = :CurObject.RequestID AND
          FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;
/*
** Read binary data from the database
*/
   SelectSql = 'SELECT DataStream FROM FMS_GreenSheetFile WHERE ' + 
               'RequestID = ' + VARCHAR(CurObject.RequestID) + ' AND ' +
               'FileID = ' + VARCHAR(CurObject.FileID);

   IF CurObject.DBServer = 0 THEN
      CurMethod.DBSession = DDB_Global.Session.Cur;
 
   ELSEIF CurObject.DBServer = 1 AND DDB_Global.Session.One.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.One;

   ELSEIF CurObject.DBServer = 2 AND DDB_Global.Session.Two.State = DS_CONNECTED THEN   
      CurMethod.DBSession = DDB_Global.Session.Two;

   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to load Green Sheet from the FMS database';
      RETURN;
   ENDIF;

   If CurObject.DataStream.FetchFromDB(Query = SelectSql) <> ER_OK THEN
      CurMethod.Trace(Text= varchar(date('now')) + 'GreenSheetFile: failed to read binary from db for ' + CurObject.FileName);
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to load Green Sheet from the FMS database. Please try again.';
   ENDIF;
   ROLLBACK;
END;

METHOD ShowGreenSheet (
) =
DECLARE
   Command = Varchar(260) NOT NULL WITH DEFAULT;
   WorkDir = Varchar(100) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');

   CurObject.GetDataStream();
   IF CurObject.ReturnCode  <> 0 THEN
      MESSAGE CurObject.ErrorMessage;
      RETURN;
   ENDIF;
   
   RetCode = CurSession.DirectoryExists(Directory = WorkDir + '\report');
   IF RetCode <> TRUE THEN
      CurSession.CreateDirectory(Directory = WorkDir + '\report');
   ENDIF;

   IF CurObject.DataStream.WriteToFile(Filename = WorkDir + '\report\' + CurObject.FileName) <> ER_OK Then
      IF CurSession.FileExists(Filename = WorkDir + '\report\' + CurObject.FileName) = FALSE THEN
         MESSAGE 'Faile to show the file from the database';
         RETURN;
      ENDIF;
   ENDIF;
   
   Command = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + WorkDir + '\green_sheet.ps1" "' + CurObject.FileName + '"';                         
           
	CurMethod.Trace (Command);
	CALL System Command;
END;

