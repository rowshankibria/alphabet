*/
/*
**  Application:    CAC
**  Frame:          DisplayHelpText
**
**  Date:       Version Description
** ----------------------------------
**  11/04/93   em  created
**  11/11/93   em  using framename instead of entityid.  images
**                 don't know anything about entity ids
**  06/09/11  ysp  Display context sensitive webhelp page if available.
**  08/11/22  ysp  Add WebHelp for DSO application.
**  12/18/24  ysp  use powershell script to display webhelp pages
*/
INITIALIZE 
(   i	            = INTEGER NOT NULL WITH DEFAULT; 
    HelpTextArray   = ARRAY OF HelpTextClass;
    FrameName       = VARCHAR(32) NOT NULL;
    StringFound     = INTEGER NOT NULL WITH DEFAULT;
    WorkDir         = VARCHAR(80) NOT NULL WITH DEFAULT;
    TopicID         = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF CurSession.OperatingSystem = SY_NT THEN
      WorkDir = CurSession.GetEnv(Name = 'FMS_Misc');
   ELSE
      WorkDir = CurSession.GetEnv(Name = 'HOME');
   ENDIF;

   Curframe.SendUserEvent (EventName = 'MakeInvisible');
END; 

ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
END;


ON USEREVENT 'DisplayText' =
BEGIN
   CurSession.ProcessWindow = FALSE;
/*
** if a webhelp page is defined for this frame, call up the webhelp page
*/
    FrameWindowTitle = HelpTextObject.WindowTitle;
    FrameName = HelpTextObject.FrameName;

    TopicID = -1;
    SELECT :TopicID = TopicID
    FROM   FMS_WebHelp
    WHERE  FrameName = :FrameName AND
           Application = :CurrentApplication;

    IF TopicID <= 0 THEN
       /* call up the default main screen page of the application 
       */
       IF CurrentApplication = Application$FMS THEN
          FrameName = 'FeederCard';
       ELSEIF CurrentApplication = Application$TFMS OR CurrentApplication = Application$SLC THEN
          FrameName = 'SOA_Main';
       ELSEIF CurrentApplication = Application$TLS THEN
          FrameName = 'TelCard';
       ELSEIF CurrentApplication = Application$DSO THEN
          FrameName = 'DSO_Main';
       ENDIF;

       SELECT :TopicID = TopicID
       FROM   FMS_WebHelp
       WHERE  FrameName = :FrameName AND
              Application = :CurrentApplication;
    ENDIF;

    IF TopicID > 0 THEN
       CALL SYSTEM 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + WorkDir + '\cshwindow.ps1" "' + CurrentApplication + '" ' + VARCHAR(TopicID);                         
	
	   /* 12/18/24 Replaced by a Powershell
       IF CurrentApplication = Application$DSO THEN
         CALL SYSTEM 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + WorkDir + '\cshwindow.ps1" "DSO" ' + VARCHAR(TopicID);                         
       ELSE
         CALL SYSTEM 'wscript ' + WorkDir + '\cshhelper.vbs ' + VARCHAR(TopicID);
       ENDIF;
       */
       RESUME;
    ELSE
       FrameName = HelpTextObject.FrameName;
    ENDIF; 

/*
** Otherwise, display the old help text. (For SDS and other applications)
*/    
    CurFrame.WindowVisibility = WV_VISIBLE;

    HelpText.Value = '';
    i = 1;
    SELECT :HelpTextArray[i].FrameName = FrameName,
           :HelpTextArray[i].Seq = Seq,
           :HelpTextArray[i].TextLength = TextLength,
           :HelpTextArray[i].HelpText = HelpText
    FROM   FMS_HelpText
    WHERE  FrameName = :FrameName
    ORDER BY Seq
    BEGIN
        HelpText = HelpText.ConcatVarchar(text = HelpTextArray[i].HelpText);
        i = i + 1; 
    END;
/*
**  Give nice message if no help found.
*/
    IF i = 1 THEN
       HelpText.Value = 'Sorry.  At this time, no help has been provided for this screen.';
    ENDIF;     

    FIELD(HelpText).UpdField(); 
    StringFound = 0; 
    search_string = '';
END;

ON CLICK search_btn =
BEGIN
    IF search_string = '' THEN
       Message 'Please enter search text then click the Search button.';
       RESUME;
    ENDIF;

    FIELD(HelpText).UnmarkAllText();

    StringFound = HelpText.LocateString (match = :search_string,
                                 startposition = StringFound + 1);

    IF StringFound = 0 THEN
       RESUME;
    ENDIF;

    FIELD(HelpText).MarkSubText (startposition = StringFound,
             endposition = FIELD(search_string).TextLength + StringFound);
        
END;

ON CLICK ok_btn =
BEGIN
    CurFrame.WindowVisibility = WV_INVISIBLE;
END;

ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

