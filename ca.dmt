Application Component Report
============================

	Name:            OpenAutoMoves

/*
**
**	Copyright c 2003 Pateric Software LLC. All rights reserved.
**
**	This program is the property of PaterIc Software. It contains valuable
**      proprietary  trade  secret  information  and  is  only for use by duly
**      licensed customers. This  program  may not be copied or transferred to 
**      any third party without the written permission of PaterIc Software.
**
*/
/*
**  Application:    CAC
**  Frame:          OpenAutoMoves
**
**  Modifications:
**  01/13/03  ysp   Created to auto issue/complete Open Auto moves.
**  01/17/03  em    Added NoAction parm for call from CreateXferCard -
**                  issue/complete move only, don't do any JobActions.
**  02/05/03  em    Remove NoAction parm, we want Job Actions to occur,
**                  especially PromptCutOut.
**  02/16/07  ysp   Return PU_OK if an Open Auto move is successfully 
**                  issued and completed.
**  05/18/07  em    Add optional card type parm, if OOE1 then look for 
**                  PromptCutOut instead of OpenAuto move. 
**  04/07/17  pkw   Only get cutout for source breaker equip
*/
PROCEDURE OpenAutoMoves (
/*
**  Passed variables
*/
   Card        = INTEGER NOT NULL;
   CutOut      = DATE;
   CardType    = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm*/
/*
**  Local variables
*/
   i           = INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   OAJobs      = ARRAY OF JobInProgress; 
   RetCode     = INTEGER;
   SourceBreakerEquip = INTEGER NOT NULL WITH DEFAULT;
)= 
BEGIN 
   IF CutOut IS NULL THEN
      CutOut = DATE('now');
   ENDIF;
/*
** get all the cutout or open auto moves in this card 
*/
   IF CardType = Type$OOE1 THEN
      /*
      **    Make sure feeder has a source breaker
      */
      SourceBreakerEquip = 0;
      REPEATED 
      SELECT  :SourceBreakerEquip = G.Member
      FROM    Udb_Grouping G,
              SOA_ActiveObject AO
      WHERE   AO.Card = :Card AND
              AO.Object = G.Grouping AND
              G.Relationship = :Interaction$SourceBreaker;

      OAJobs.Clear();
      i = 1;
      REPEATED
      SELECT DISTINCT
             :OAJobs[i].Job = J.Job, 
             :OAJobs[i].Status = J.Status,
             :OAJobs[i].JobClass = J.JobClass,
             :OAJobs[i].Card = SJ.Card,   
             :OAJobs[i].Seq = SJ.Seq,
             :OAJobs[i].Equip = J.Equip,
             :OAJobs[i].EquipClass = J.EquipClass,  
             :OAJobs[i].MoveEquipClass = SJ.MoveEquipClass,  
             :OAJobs[i].EquipClassName = J.EquipClassName,  
             :OAJobs[i].PrintID = SJ.PrintID,
             :OAJobs[i].EquipName = J.EquipName,
             :OAJobs[i].StepPair = SJ.StepPair,
             :OAJobs[i].Grounds = J.Grounds,
             :OAJobs[i].MoveType = J.MoveType,
             :OAJobs[i].TOMove = J.TOMove,
             :OAJobs[i].TOOperator = J.TOOperator,
             :OAJobs[i].TOIssued = J.TOIssued,
             :OAJobs[i].TOComplete = J.TOComplete,
             :OAJobs[i].GroundOn = J.GroundOn,
             :OAJobs[i].RSMove = J.RSMove,
             :OAJobs[i].RSOperator = J.RSOperator,
             :OAJobs[i].RSIssued = J.RSIssued,
             :OAJobs[i].RSComplete = J.RSComplete,
             :OAJobs[i].TOMoveRules = J.TOMoveRules,
             :OAJobs[i].RSMoveRules = J.RSMoveRules,
             :OAJobs[i].Response = J.Response,
             :OAJobs[i].MoveFGColor = J.MoveFGColor,
             :OAJobs[i].MoveBGColor = J.MoveBGColor,
             :OAJobs[i].ControlCard = J.ControlCard,
             :OAJobs[i].Substation = J.Substation,
             :OAJobs[i].MoveCategory = J.MoveCategory,
             :OAJobs[i].ActivityIdentifier = J.ActivityIdentifier
      FROM   SOA_JobControl SJ,
             SOA_Job J,
             FMS_JobAction JA
      WHERE  SJ.Card = :Card AND 
             SJ.Job = J.Job AND
             J.TOIssued IS NULL AND
             J.TOComplete IS NULL AND
             J.Equip = :SourceBreakerEquip AND
             J.JobClass = JA.JobClass AND
             JA.EquipClass = SJ.MoveEquipClass AND
             JA.StepPair = SJ.StepPair AND
             J.Status = '' AND
             JA.TORS = :Job$TakeoutInt AND
             JA.Action = :JobAction$Prompt AND
             JA.Status =  :JobAction$CutOut
      ORDER BY Seq
      BEGIN
          i = i + 1;
      END;
   
      IF i = 1 THEN
         MESSAGE 'No Cut Out move was found on the OOE1 card.  Either ' +                   
                 'the feeder does not have a source defined or the move is not ' +
                 'properly setup in Job Class Maintenance.';
         RETURN PU_CANCEL;
      ENDIF;
   ELSE
      OAJobs.Clear();
      i = 1;
      REPEATED
      SELECT :OAJobs[i].Job = J.Job, 
             :OAJobs[i].Status = J.Status,
             :OAJobs[i].JobClass = J.JobClass,
             :OAJobs[i].Card = SJ.Card,   
             :OAJobs[i].Seq = SJ.Seq,
             :OAJobs[i].Equip = J.Equip,
             :OAJobs[i].EquipClass = J.EquipClass,  
             :OAJobs[i].MoveEquipClass = SJ.MoveEquipClass,  
             :OAJobs[i].EquipClassName = J.EquipClassName,  
             :OAJobs[i].PrintID = SJ.PrintID,
             :OAJobs[i].EquipName = J.EquipName,
             :OAJobs[i].StepPair = SJ.StepPair,
             :OAJobs[i].Grounds = J.Grounds,
             :OAJobs[i].MoveType = J.MoveType,
             :OAJobs[i].TOMove = J.TOMove,
             :OAJobs[i].TOOperator = J.TOOperator,
             :OAJobs[i].TOIssued = J.TOIssued,
             :OAJobs[i].TOComplete = J.TOComplete,
             :OAJobs[i].GroundOn = J.GroundOn,
             :OAJobs[i].RSMove = J.RSMove,
             :OAJobs[i].RSOperator = J.RSOperator,
             :OAJobs[i].RSIssued = J.RSIssued,
             :OAJobs[i].RSComplete = J.RSComplete,
             :OAJobs[i].TOMoveRules = J.TOMoveRules,
             :OAJobs[i].RSMoveRules = J.RSMoveRules,
             :OAJobs[i].Response = J.Response,
             :OAJobs[i].MoveFGColor = J.MoveFGColor,
             :OAJobs[i].MoveBGColor = J.MoveBGColor,
             :OAJobs[i].ControlCard = J.ControlCard,
             :OAJobs[i].Substation = J.Substation,
             :OAJobs[i].MoveCategory = J.MoveCategory,
             :OAJobs[i].ActivityIdentifier = J.ActivityIdentifier
      FROM   SOA_JobControl SJ,
             SOA_Job J
      WHERE  SJ.Card = :Card AND
             SJ.Job = J.Job AND
             J.JobClass = :JobClass$OpenAuto AND
             J.Status <> 'Del'
      ORDER BY Seq
      BEGIN
          i = i + 1;
      END;
   
      IF i = 1 THEN
         MESSAGE 'No Open Auto move was found on the Auto card.  Either ' +                   
                 'the feeder does not have a source defined or the move is not ' +
                 'properly setup in Job Class Maintenance.';
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;

/*
** Automatically issue/complete the TakeOut side of the Open Auto moves
*/
   FOR i = 1 TO OAJobs.LastRow() DO
      /*
      **  Set FO = to be SOCCSX Operator
      */
      FO.Object  = Operator$XA21;
      /*
      **  Set Status field to Job$TakeOut for IssueMove method
      **  and issue move
      */ 
      OAJobs[i].Status = Job$TakeOut;
      RetCode = OAJobs[i].IssueMove(Job = OAJobs[i],
                                    SetTime = CutOut);
      IF RetCode = PU_CANCEL THEN
         Message 'Procedure:OpenAutoMoves not able to issue the TakeOut of the Open Auto. ' +
                 'Please maunally issue the move.'; 
         RETURN PU_CANCEL;
      ENDIF;

      /*
      **  Perform JobActions
      */
      RetCode = OAJobs[i].JobActions(IssueCompl = JobClass$Issue);               
      IF RetCode = PU_CANCEL THEN

         RetCode = OAJobs[i].CancelIssueMove(Job = OAJobs[i]);             
         IF RetCode = PU_CANCEL THEN
            Message 'Please issue Open Auto move manually';
         ENDIF;
         RETURN PU_CANCEL;
      ENDIF;
      /*
      **  Complete the move.
      */
      RetCode = OAJobs[i].CompleteMove(Job = OAJobs[i],
                                      SetTime = CutOut);
      IF RetCode = PU_CANCEL THEN
         Message 'Procedure:OpenAutoMoves not able to complete the TakeOut of the Open Auto. ' +
                 'Please manually complete the move.';
         RETURN PU_CANCEL;
      ENDIF;

      /*
      **  Perform complete move job actions 
      */              
      RetCode = OAJobs[i].JobActions(IssueCompl = JobClass$Complete);
      IF RetCode = PU_CANCEL THEN
         
         RetCode = OAJobs[i].InCompleteMove(Job = OAJobs[i]);
          
         IF RetCode = PU_CANCEL THEN
            Message 'Please complete Open Auto move manually';
         ENDIF;
         RETURN PU_CANCEL;
      ENDIF;
   ENDFOR;

   CALLPROC SOA_LogIns (
                        Card = Card,
                        Job  = NULL,
                        SwitchingItem = 0,
                        Time = DATE('Now'), 
                        UserName = UserName,
                        Item = 'CutOut',
                        Old  = '',
                        New  = IFNULL(CutOut,''));
   CALLPROC DDB_COMMIT;

   RETURN PU_OK;
END;



Application Component Report
============================

	Name:            OperatingOrder

/*
**
**      Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
**  Application:    FMS
**  Frame:          OperatingOrder
**
**  Date:       Version Description
** ----------------------------------
** 01/26/01       my    Created
** 02/23/01       em    Code Review.  Don't set priority when orders are loaded.
** 03/02/01       em    Sort order list in descneding issue time sequence
** 03/27/01       em    Rescinded orders have had their jobs deleted - no reason
**                      to include rescinded orders in the closed list.
** 04/03/01       em    Added Order Objective to selection list.
** 06/08/01       em    After user has used Download or Rescind Menu Item
**                      successfully, disable it forcing them to reload to
**                      get the new status.
** 09/12/01       pkw   Add Order$ConfirmClosed to select
** 10/05/01       em    Record Reason when rescinding order
** 08/09/02       pkw   Load jobs from archivejob table when card is closed.
** 09/24/02       ysp   Merge: use soa_job table and cac's JobInprogress.
** 03/10/03       em    Because transfer cards keep outstanding moves with the
**                      new card, the OpOrder card link will not find the jobs
**                      on the old card (the historical job number will be
**                      a new job number).  So we change the Job load to
**                      exclude Operating order table and get the card from
**                      Job Control.
** 04/10/03       em    Add access to Return Remark for <MB3> move.
** 01/30/04       em    Add parameter to load a specific order if the order
**                      number is passed.
** 02/12/04       ysp   SSO Enhancement: Show more processing information 
** 03/18/04       ysp   Remove passing card to manualorderrescind frame. Remove
**                      Rescind and Change Priority menu items.
** 03/31/04       em    Added Order Status = Cancelled for Process Automatin Stoppage
** 05/16/04       ysp   Add Confirm button if the order is pending D.O's confirmation.
**                      This will allow DO to confirm rejected/rescinded/returned orders 
**                      even if there is no incoming return message.
** 03/11/05       em    Added Auto SetUp to Choicelist
** 07/17/05       em    Removed Priority; Reviewed per TOMS/SSO Interface;
**                      If Substation is not passed in then we use card.
** 07/20/05       em    Avoid duplicate moves (for shared moves) including ControlCard
**                      in the WHERE clause.
** 08/12/05       em    Update Priority Button added
** 08/30/05       em    Trying to correct problems loading old orders
** 11/05/05       pkw   Added Message History button
** 11/17/05       ysp   add feeders/lines for TOMS order
** 12/14/05       ysp   Increase the size of tomove to 160 chars
** 08/03/06       em    Show submoves on active orders.  When order is closed
**                      and submoves were put on card, they should show 
**                      automatically.  They won't show on closed cards
**                      fi they were not used because they get deleted.
** 04/03/07       em    Display "Confirm" Rescinded or Rejected status when
**                      status has been confirmed
** 04/16/07       ysp   ITC210: Insert IR interface event in DB event queue
** 12/04/07       pkw   Use MacroStation when looking for closed orders from TFMS.
** 01/08/08       ysp   Combine "In Connection With" type name and equipment name.
** 07/21/08       em    Added scroll bar to multi-line remark fields
** 03/19/09       ysp   display returned orders (status=order$closed) as outstanding orders.
** 04/11/16       em    Include Card when accessing FMS_ArchiveJob
** 06/21/19       em    Remove REPEATED from job selection. Must not be working with UNION statement.
** 11/01/21       em    Updated to Support DSO
*/ 
INITIALIZE
(
/*
**  Passed Parameters
*/
    Card = INTEGER NOT NULL WITH DEFAULT; /* Passed from TOMS to Limit Substation list */
    LoadOrder = INTEGER NOT NULL WITH DEFAULT;   /*Optional*/
    StatusComplete  = CHAR(1) NOT NULL;
    Substation  = INTEGER NOT NULL WITH DEFAULT;
    
/*
**  Internal Variables
*/
    FO              = ObjectClass;    
    i               = Integer NOT NULL WITH DEFAULT;
    k               = Integer NOT NULL WITH DEFAULT;
    OrderNumber     = Integer NOT NULL WITH DEFAULT;
    LastRow         = INTEGER NOT NULL;
    CurStatus       = Integer NOT NULL;
    TOOperator      = INTEGER WITH NULL;
    RSOperator      = INTEGER WITH NULL;
    OldLog         = VARCHAR(100) NOT NULL;
    RetCode 	   = INTEGER NOT NULL;
    TORS           = CHAR(2) NOT NULL;
    ControlText    = VARCHAR(256) NOT NULL /* For DBEVENT */;
) =
BEGIN
    CurFrame.CurMode = FrameExec(CurFrame.ParentFrame).CurMode;    
/* 
** Set up the Search Area 
*/
    FIELD(S).XLeft = (CurFrame.WindowWidth - FIELD(S).Width)/2;
    FIELD(S).YTop = FIELD(O.IssuedByDO).YTop;

    FIELD(menu.oo.download_order).CurBias = MB_DISABLED;
    FIELD(Confirm_btn).CurBias = FB_DIMMED;
    
    IF CurrentApplication = Application$DSO THEN
       FIELD(O.Priority_btn).CurBias = FB_INVISIBLE;
    ENDIF;

    IF LoadOrder = 0 THEN
       CurFrame.SendUserEvent(EventName = 'display selection');
    ELSE

       FIELD(S).CurBias = FB_INVISIBLE;
       OrderNumber = LoadOrder;

       SELECT :Substation = O.Substation
       FROM    IR_OperatingOrder O
       WHERE   O.OrderNumber = :OrderNumber;

       CurFrame.SendUserEvent( eventname = 'load_data' );
    ENDIF;   
END;

ON USEREVENT 'display selection' =
BEGIN
/*
** Load Operating orders for desired card.  
*/
   S.Orders.Clear();
   i = 1;
   IF StatusComplete = 'Y' THEN

      IF Substation <> 0 THEN

       IF CurrentApplication = Application$DSO THEN
        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = 'DSO'
        FROM   IR_DSOOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus > :Order$Closed AND
               OO.OrderStatus <> :Order$Cancelled
        ORDER BY
                IssueTime DESC
        BEGIN
           i = i + 1;
        END;
       
       ELSE
       
        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = OO.Application
        FROM   IR_OperatingOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus > :Order$Closed AND
               OO.OrderStatus <> :Order$Cancelled
        ORDER BY
                IssueTime DESC
        BEGIN
           i = i + 1;
        END;
       ENDIF;

      ELSEIF Card <> 0 THEN

         IF CurrentApplication = Application$SLC THEN

             REPEATED
             SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                     :S.Orders[i].OrderNumber = OO.OrderNumber,
                     :S.Orders[i].SubstationName = O.Name,
                     :S.Orders[i].Substation = OO.Substation,
                     :S.Orders[i].OrderStatus = OO.OrderStatus,
                     :S.Orders[i].Application = OO.Application
             FROM   IR_OperatingOrder OO,
                    Udb_Object O,
                    SOA_ActiveObject AO
             WHERE  AO.Card = :Card AND
                    AO.Object = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
             ORDER BY
                    IssueTime DESC
             BEGIN
                i = i + 1;
             END;

         ELSEIF CurrentApplication = Application$TFMS THEN

             SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                     :S.Orders[i].OrderNumber = OO.OrderNumber,
                     :S.Orders[i].SubstationName = O.Name,
                     :S.Orders[i].Substation = OO.Substation,
                     :S.Orders[i].OrderStatus = OO.OrderStatus,
                     :S.Orders[i].Application = OO.Application
             FROM   IR_OperatingOrder OO,
                    Udb_Object O,
                    TFMS_CardToObject AO
             WHERE  AO.Card = :Card AND
                    AO.Object = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
             UNION
             SELECT  OO.IssueTime,
                     OO.OrderNumber,
                     O.Name,
                     OO.Substation,
                     OO.OrderStatus,
                     OO.Application
             FROM   IR_OperatingOrder OO,
                    Udb_Object O,
                    TFMS_CardToObject AO,
                    Udb_Grouping G
             WHERE  AO.Card = :Card AND
                    AO.Object = G.Member AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType = :Type$MacroSubstation AND
                    G.Grouping = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
     
             ORDER BY
                    IssueTime DESC
             BEGIN
                i = i + 1;
             END;   
             
         ELSEIF CurrentApplication = Application$DSO THEN

             SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                     :S.Orders[i].OrderNumber = OO.OrderNumber,
                     :S.Orders[i].SubstationName = O.Name,
                     :S.Orders[i].Substation = OO.Substation,
                     :S.Orders[i].OrderStatus = OO.OrderStatus,
                     :S.Orders[i].Application = 'DSO'
             FROM   IR_DSOOrder OO,
                    Udb_Object O,
                    TFMS_CardToObject AO
             WHERE  AO.Card = :Card AND
                    AO.Object = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
             UNION
             SELECT  OO.IssueTime,
                     OO.OrderNumber,
                     O.Name,
                     OO.Substation,
                     OO.OrderStatus,
                     'DSO'
             FROM   IR_DSOOrder OO,
                    Udb_Object O,
                    TFMS_CardToObject AO,
                    Udb_Grouping G
             WHERE  AO.Card = :Card AND
                    AO.Object = G.Member AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.GroupingType = :Type$MacroSubstation AND
                    G.Grouping = OO.Substation AND
                    O.Object = OO.Substation AND
                    OO.OrderStatus > :Order$Closed AND
                    OO.OrderStatus <> :Order$Cancelled
     
             ORDER BY
                    IssueTime DESC
             BEGIN
                i = i + 1;
             END;   

         ENDIF;           
      ENDIF;

   ELSEIF StatusComplete = 'N' THEN

      IF Substation <> 0 THEN

       IF CurrentApplication = Application$DSO THEN
        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = 'DSO'
        FROM   IR_DSOOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;
       
       ELSE
       
        REPEATED
        SELECT  :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = OO.Application
        FROM   IR_OperatingOrder OO,
               Udb_Object O
        WHERE  OO.Substation = :Substation AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;
       ENDIF;

      ELSEIF Card <> 0 THEN

       IF CurrentApplication = Application$DSO THEN
        REPEATED
        SELECT  DISTINCT
                :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = 'DSO'
        FROM   IR_DSOOrder OO,
               Udb_Object O,
               SOA_JobControl JC,
               IR_DSOOrderJob JTS
        WHERE  JC.Card = :Card AND
               JC.Job = JTS.Job AND
               JTS.OrderNumber = OO.OrderNumber AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed 
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;
       
       ELSE
       
        REPEATED
        SELECT  DISTINCT
                :S.Orders[i].IssueTime = OO.IssueTime,
                :S.Orders[i].OrderNumber = OO.OrderNumber,
                :S.Orders[i].SubstationName = O.Name,
                :S.Orders[i].Substation = OO.Substation,
                :S.Orders[i].OrderStatus = OO.OrderStatus,
                :S.Orders[i].Application = OO.Application
        FROM   IR_OperatingOrder OO,
               Udb_Object O,
               SOA_JobControl JC,
               IR_OpOrderJobs JTS
        WHERE  JC.Card = :Card AND
               JC.Job = JTS.Job AND
               JTS.OrderNumber = OO.OrderNumber AND
               O.Object = OO.Substation AND
               OO.OrderStatus <= :Order$Closed 
        ORDER BY
                 OrderStatus, IssueTime DESC 
        BEGIN
           i = i + 1;
        END;
       ENDIF;

      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
    
   IF i = 1 THEN
      MESSAGE 'No orders found.  Sometimes it helps to load any ' +
              'type of order then ' +
              'try again for that substation.'; 
      RESUME;
   ELSE
       FOR i = 1 to S.Orders.LastRow() DO

           IF S.Orders[i].OrderStatus = Order$Opened THEN
              S.Orders[i].OrderStatusName = 'Opened';

           ELSEIF S.Orders[i].OrderStatus = Order$Downloaded THEN
              S.Orders[i].OrderStatusName = 'Downloaded';

           ELSEIF S.Orders[i].OrderStatus = Order$Acknowledged THEN
              S.Orders[i].OrderStatusName = 'Acknowledged';

           ELSEIF S.Orders[i].OrderStatus = Order$Rejected THEN
              S.Orders[i].OrderStatusName = 'Rejected';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmRejected THEN
              S.Orders[i].OrderStatusName = 'Confirm Rejected';

           ELSEIF S.Orders[i].OrderStatus = Order$Rescinded THEN
              S.Orders[i].OrderStatusName = 'Rescinded';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmRescinded THEN
              S.Orders[i].OrderStatusName = 'Confirm Rescinded';

           ELSEIF S.Orders[i].OrderStatus = Order$Closed THEN
              S.Orders[i].OrderStatusName = 'Closed';

           ELSEIF S.Orders[i].OrderStatus = Order$ConfirmClosed THEN
              S.Orders[i].OrderStatusName = 'Confirm Closed';

           ELSEIF S.Orders[i].OrderStatus = Order$Cancelled THEN
              S.Orders[i].OrderStatusName = 'Cancelled';

           ENDIF; 
       ENDFOR;
   ENDIF;

   FIELD(S).ParentField.CurBias = FB_VISIBLE;
   CurFrame.CurMode = FM_QUERY;
   FIELD(S).CurBias = FB_CHANGEABLE;
END;


ON CHILDENTRY S.Orders =
BEGIN
/*
** Load a specific order.
*/     i = 1;
       FIELD(S).CurBias = FB_INVISIBLE;
       CurFrame.CurMode = FM_UPDATE;
       i = FIELD(S.Orders).CurRow;
       IF S.Orders[i].OrderNumber > 0 THEN
           OrderNumber = S.Orders[i].OrderNumber;
           Substation = S.Orders[i].Substation;
           CurFrame.SendUserEvent( eventname = 'load_data' );
       ELSE
           RESUME;
       ENDIF;
END;


ON USEREVENT 'load_data' =
BEGIN       
   FIELD(Confirm_btn).CurBias = FB_DIMMED;
                          
/*
**  Load the operating order data into the frame user classes 
*/
   IF OrderNumber = 0 THEN
      MESSAGE 'No Operating Order Selected.';
      RESUME;
   ENDIF;
/*
**  Select the operating order header information.
*/
   FIELD(O).SetToDefault();

  IF CurrentApplication = Application$DSO THEN
   SELECT       :O.OrderNumber = O.OrderNumber,
                :O.OrderStatus = O.OrderStatus,
                :O.SubstationName = OB.Name,
                :O.IssueTime = O.IssueTime,
                :O.IssuedByDO = O.IssuedBySM,
                :O.AckRejectBySSO = O.AckRejectBySSO,
                :O.AckRejectTime = O.AckRejectTime,
                :O.AckRejectComment = O.AckRejectComment,
                :O.RescindTime = O.RescindTime,
                :O.RescindDO = O.RescindDO,
                :O.RescindType = O.RescindType,
                :O.RescindReasonTypeName = O.RescindReasonTypeName,
                :O.RescindComment = O.RescindComment,
                :O.ReturnTime = O.ReturnTime,
                :O.ReturnBySSO = O.ReturnBySSO,
                :O.ReturnComment = O.ReturnComment
   FROM    IR_DSOOrder O,
                Udb_Object OB
   WHERE   O.OrderNumber = :OrderNumber
   AND     O.Substation = OB.Object;

   i = 1;
   O.InConnectionWith.Clear();
   SELECT :O.InConnectionWith[i].Object = Feeder,
          :O.InConnectionWith[i].Name = FeederName
   FROM   IR_DSOOrderFeeder 
   WHERE  OrderNumber = :OrderNumber 
   BEGIN
       i = i + 1;  
   END;
  
  ELSE
  
   SELECT       :O.OrderNumber = O.OrderNumber,
                :O.OrderStatus = O.OrderStatus,
                :O.SubstationName = OB.Name,
                :O.BusConfiguration = O.BusConfiguration,
                :O.BusConfigurationName = '',
                :O.Priority = O.Priority,
                :O.IssueTime = O.IssueTime,
                :O.IssuedByDO = O.IssuedByDO,
                :O.ByDesk = O.ByDesk,
                :O.AckRejectBySSO = O.AckRejectBySSO,
                :O.AckRejectTime = O.AckRejectTime,
                :O.AckRejectComment = O.AckRejectComment,
                :O.RescindTime = O.RescindTime,
                :O.RescindDO = O.RescindDO,
                :O.RescindType = O.RescindType,
                :O.RescindReasonTypeName = O.RescindReasonTypeName,
                :O.RescindComment = O.RescindComment,
                :O.ReturnTime = O.ReturnTime,
                :O.ReturnBySSO = O.ReturnBySSO,
                :O.ReturnComment = O.ReturnComment
   FROM    IR_OperatingOrder O,
                Udb_Object OB
   WHERE   O.OrderNumber = :OrderNumber
   AND     O.Substation = OB.Object;

   IF O.BusConfiguration > 0 THEN
           SELECT :O.BusConfigurationName = Name
           FROM   UDB_Type
           WHERE  Type = :O.BusConfiguration;
   ENDIF;

   i = 1;
   O.Steps.Clear();
   SELECT :O.Steps[i].Type = Type,
          :O.Steps[i].OperatingStepName = OperatingStepName,
          :O.Steps[i].StartTime = StartTime
   FROM   IR_OpOrderSteps
   WHERE  OrderNumber = :OrderNumber
   ORDER BY Type
   BEGIN
      i = i + 1;
   END;

   i = 1;
   O.Objectives.Clear();
   SELECT :O.Objectives[i].Seq = Seq,
          :O.Objectives[i].ID = Objective,
          :O.Objectives[i].Description = Description,
          :O.Objectives[i].Comment = Comment
   FROM   IR_OpOrderObjectives
   WHERE  OrderNumber = :OrderNumber
   ORDER BY Seq
   BEGIN
      i = i + 1;
   END;

   i = 1;
   O.InConnectionWith.Clear();
   SELECT :O.InConnectionWith[i].Object = Object,
          :O.InConnectionWith[i].Name = SQUEEZE(TypeName + ' ' + Name)
   FROM   IR_OpOrderFeeders 
   WHERE  OrderNumber = :OrderNumber 
   BEGIN
       i = i + 1;  
   END;
  ENDIF;
/*
**  Get the Work Tasks from the Job table.  This is a UNION of the
**  TakeOut(TO) and the Restore(RS) moves from active and archive tables.
*/
       IF CurrentApplication = Application$DSO THEN
        i = 1;
        WL.Clear();
        SELECT  
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].TOIssued = J.TOIssued
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_DSOOrderJob JTS
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card
        UNION 
        SELECT  J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.RSIssued
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_DSOOrderJob JTS
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card 
        ORDER BY Seq
        BEGIN
           i = i + 1;    
        END;
/* 
** Query was too complex, had to separate Archive portion.  
** If previous select returned nothing, then we try to find
** order details in the archive tables.
*/  
        IF WL.LastRow() = 0 THEN
        SELECT  
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].TOIssued = J.TOIssued
        FROM    SOA_ArchiveJob J,
                IR_DSOOrderJob JTS
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job
        UNION 
        SELECT  J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                J.RSIssued
        FROM    SOA_ArchiveJob J,
                IR_DSOOrderJob JTS
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job       
        ORDER BY Seq
        BEGIN
           i = i + 1;    
        END;

        ENDIF;  /*Archive Select*/
       
       ELSE /* Not DSO */
       
        i = 1;
        WL.Clear();
        SELECT  
                :WL[i].Printid = JC.printid,
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].LockNumber = O.LockNumber,
                :WL[i].Combination = O.Combination,
                :WL[i].TOIssued = J.TOIssued,
                :WL[i].BaseKey = JTS.ParentJob,    /*Will hold parent job ID*/
                :WL[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object
        UNION 
        SELECT  JC.Printid,
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_Job J,
                SOA_JobControl JC,
                SOA_ActiveCard AC,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   AC.Card = JC.Card AND
                JC.Job = J.Job AND
                JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object
        UNION
        SELECT  '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.TOMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.TOIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_Job J,
                SOA_ActiveCard AC,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.ParentJob <> 0 AND   /* This gets submoves */
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object 
        UNION 
        SELECT  '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_Job J,
                SOA_ActiveCard AC,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.ParentJob <> 0 AND  /* This gets submoves */
                JTS.Job = J.Job AND
                J.ControlCard = AC.Card AND
                J.Equip = O.Object  
        ORDER BY Seq
        BEGIN
           IF WL[i].ReturnRemark <> '' THEN
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_CYAN;
           ENDIF;
           IF WL[i].BaseKey <> 0 THEN
              FIELD(WL[i].PrintID).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].EquipClassName).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].EquipName).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].LockNumber).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].Combination).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].TOMove).BgColor = CC_PALE_GRAY;
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_GRAY;
           ENDIF;
           i = i + 1;    
        END;
/* 
** Query was too complex, had to separate Archive portion.  
** If previous select returned nothing, then we try to find
** order details in the archive tables.
*/  
        IF WL.LastRow() = 0 THEN
           SELECT  
                :WL[i].Printid = J.printid,
                :WL[i].Job = J.Job,
                :WL[i].JobClass = J.JobClass,
                :WL[i].Equip = J.Equip,
                :WL[i].EquipClassName = J.EquipClassName,
                :WL[i].EquipName = J.EquipName,
                :WL[i].TOMove = J.TOMove,
                :WL[i].TOOperator = J.TOOperator,
                :WL[i].RSOperator = J.RSOperator,
                :WL[i].Seq = JTS.Seq,
                :WL[i].LockNumber = O.LockNumber,
                :WL[i].Combination = O.Combination,
                :WL[i].TOIssued = J.TOIssued,
                :WL[i].BaseKey = JTS.ParentJob,
                :WL[i].ReturnRemark = SQUEEZE(JTS.ReturnRemark)
        FROM    FMS_ArchiveJob J,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                OO.OrderNumber = JTS.OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                OO.Card = J.Card AND
                J.Equip = O.Object
        UNION 
        SELECT  J.Printid,
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    FMS_ArchiveJob J,
                IR_OpOrderJobs JTS,
                IR_OperatingOrder OO,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                OO.OrderNumber = JTS.OrderNumber AND
                OO.Card = J.Card AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object
        UNION
        SELECT  
                '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.TOMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.TOIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_ArchiveJob J,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$TakeOutInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object
        UNION 
        SELECT  '',
                J.Job,
                J.JobClass,
                J.Equip,
                J.EquipClassName,
                J.EquipName,
                J.RSMove,
                J.TOOperator,
                J.RSOperator,
                JTS.Seq,
                O.LockNumber,
                O.Combination,
                J.RSIssued,
                JTS.ParentJob,
                SQUEEZE(JTS.ReturnRemark)
        FROM    SOA_ArchiveJob J,
                IR_OpOrderJobs JTS,
                Udb_Object O
        WHERE   JTS.OrderNumber = :OrderNumber AND
                JTS.TORS = :Job$RestoreInt AND
                JTS.Job = J.Job AND
                J.Equip = O.Object        
        ORDER BY Seq
        BEGIN
           IF WL[i].ReturnRemark <> '' THEN
              FIELD(WL[i].ReturnRemark).BgColor = CC_PALE_CYAN;
           ENDIF;
           IF WL[i].BaseKey <> 0 THEN
              FIELD(WL[i].TOMove).BgColor = CC_PALE_GRAY;
           ENDIF;
           i = i + 1;    
        END;

        ENDIF;  /*Archive Select*/
       ENDIF;
    CALLPROC DDB_ROLLBACK;
 
/*
** IF this order is pending DO's confirmation, enable the Confirmation button.
** if there is not an incoming RETURN message.
*/
   IF O.OrderStatus = Order$Rejected OR
      O.OrderStatus = Order$Closed OR
      (O.OrderStatus = Order$Rescinded AND O.RescindType = 'REQUEST') THEN

      i = 0;
      SELECT :i = Count(*)
      FROM   MSG_Message 
      WHERE  OrderNumber = :OrderNumber AND
             (UpperCase(Msg) Like 'SSO RETURNED ORDER%' OR
              UpperCase(Msg) Like 'SSO RESCINDED ORDER%' OR
              UpperCase(Msg) Like 'SSO REJECTED ORDER%');

      IF i = 0 THEN
         FIELD(Confirm_btn).CurBias = FB_LANDABLE;
      ENDIF;
   ENDIF;      
   CurFrame.SendUserEvent(EventName = 'change_mode');
END;


ON CHILDENTRY WL[*].ReturnRemark =
BEGIN
/*
** Display remark if there is one.
*/
   i = FIELD(WL).WhichRow (cellfield = CurFrame.TriggerField);
   IF i > 0 THEN
      IF WL[i].ReturnRemark <> '' THEN
         FIELD(rmstack).AbsXLeft = FIELD(close_btn).AbsXLeft;
         FIELD(rmstack).AbsYBottom = FIELD(close_btn).AbsYBottom;
         rmstack.ReturnRemark = WL[i].ReturnRemark;
           
         FIELD(rmstack).Curbias = FB_LANDABLE;
         RESUME;
      ENDIF;
   ENDIF;
END;

ON CLICK O.MessageHistory_btn = 
BEGIN
   IF CurrentApplication = Application$FMS THEN
      CALLFRAME MessageHistory(Card = FMS_NewCardGlobal,
                               LoadObject = O.OrderNumber);  
   ELSE
      CALLFRAME MessageHistory(Card = NewCard,
                               LoadObject = O.OrderNumber);
   ENDIF;
END;

ON CLICK rmstack.okbtn = 
BEGIN
   FIELD(rmstack).curbias = FB_INVISIBLE;
END;
/*
**  Change the form mode
*/
ON USEREVENT 'change_mode' =
BEGIN                                      
   IF O.OrderStatus = :Order$Opened THEN
        FIELD(menu.oo.download_order).CurBias = MB_ENABLED;
   ELSE
        FIELD(menu.oo.download_order).CurBias = MB_DISABLED;
   ENDIF;

END;


ON CLICK O.Priority_btn =
BEGIN
   IF Substation = 0 THEN
      MESSAGE 'Please load an outstanding order so that I know what ' +
              'Substation I need to go to to find unacknowledged orders.';
      RESUME;
   ENDIF;

   RetCode = CALLFRAME ChangeOrderPriority (OrderSubstation = Substation);

   IF RetCode = PU_CANCEL THEN
      MESSAGE 'Need two or more unacknowledged orders before you can ' +
              'adjust priorities.';
   ENDIF;
END;


ON CLICK O.Outstanding_Btn,
ON CLICK O.Closed_Btn =
BEGIN
    IF LOWERCASE(CurFrame.TriggerField.Name) = 'outstanding_btn' THEN
        StatusComplete = 'N';
    ELSEIF LOWERCASE(CurFrame.TriggerField.Name) = 'closed_btn' THEN
        StatusComplete = 'Y';
    ELSE
        StatusComplete = 'F';
    ENDIF;
    CurFrame.SendUserEvent(EventName = 'display selection');
END;



ON CLICK Close_Btn =
BEGIN
        RETURN;
END;

ON CLICK Confirm_Btn = 
BEGIN
   IF CurFrame.ConfirmPopup (MessageText = 
      'Please check that there is no ''SSO RETURNED'', ''SSO REJECTED'' or ''SSO RESCINDED'' ' +
      'incoming message for this order. If no incoming message exists, select OK to continue.') = PU_OK THEN   
      ControlText = UserName + ';' + VARCHAR(OrderNumber) + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_ReturnOrders', 
                               DBEventText = ControlText); 
      CALLPROC DDB_COMMIT;
      RETURN;
   ELSE
      RESUME;
   ENDIF;
END;


ON CLICK S.Cancel_Btn =
   BEGIN
       FIELD(S).CurBias = FB_INVISIBLE;
       CurFrame.CurMode = FM_UPDATE;
       IF OrderNumber = 0 THEN
           RESUME;
       ENDIF;
   END;


ON Click Menu.OO.download_Order = 
BEGIN

    IF (Curframe.ConfirmPopup(messagetext = 
              'Downloading Operating Order ' +  
              varchar(O.OrderNumber) + ' for substation ' +
              O.SubstationName + '?')= PU_CANCEL) THEN
        RESUME;
    ENDIF;         
    Controltext = varchar(ordernumber);
    CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_NewOpOrder',
                     EventText = ControlText);  

   FIELD(menu.oo.download_order).CurBias = MB_DISABLED;   
END;





							 *Default Item


Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            OperatingStep_ASE


���pX�|��Component Method Scripts
���pX�|��--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          OperatingStep_ASE
**
**  Date:       Version Description
** ----------------------------------
**  04/14/04    pkw     Created to have on point of source code for 
**                      Operating Steps.
**  04/29/04    em      Add ISO check to PendingDelayMgt
**  05/14/04    pkw     Don't set pending delay if we are in INSP operatingstep.
**  05/18/04    ysp     When updating start time, loop through from the first 
**                      returned step to the last step. 
**  07/05/04    pkw     Use IncompleteFlag to set ByPassOpCheck flag.  We don't want to 
**                      mess with operating steps when incompleting a move.
**  08/09/07    pkw     Make sure there are both ABF delay AND Operating Steps 
**                      before preventing another Operating step to be set.
**  11/10/10    pkw     3g modifications.
**  10/25/11    pkw     If clearing/decrementing PFSF, set PFSS if needed.
**  01/05/12    pkw     Always set PFSS even if PFS was passed in.
**  06/21/12    em      If in Automation, don't call OpStepStartTime frame
**  09/25/13    pkw     In SetOpStep don't track OpSteps or Delays for 4kV StepDown Feeders.
**  11/20/13    pkw     Don't set PFSS is feeders station is area substation.
**  11/24/13    pkw     Fill in opentime with PFW when setting TC
**  12/04/13    pkw     Set TG when clear/decrement DM
**  07/09/14    pkw     When clearing/decrementing PFSF, only set PFSS if PFSF
**                      is the current operating step.
**  01/06/15    em      PendingDelayMgt StepPair parameter might be from SLC/TFMS so need 
**                      to replace with FMS steppair to be more specific when evaluation step.
**  02/03/16    pkw     Change CheckIsolationMoves to only look at moves that haven't been
**                      completed instead of outstanding Deload/ISO moves.
**  07/18/19    em      Bug fix where operatingstep status could be isnerted with Feeder = 0
*/ 
METHOD PendingDelayMgt (
   MoveType 	= CHAR(4) NOT NULL WITH DEFAULT;
   StepPair     = INTEGER NOT NULL WITH DEFAULT; /* No longer used by this method 01/06/15 */
)=
DECLARE
   CurrentOpStep = INTEGER NOT NULL WITH DEFAULT; /*CurrentOperatingStep*/
   FC = ARRAY OF FMS_Card;
   i = INTEGER NOT NULL;     /*Counter*/
   ISOCount = INTEGER NOT NULL WITH DEFAULT; /*Count of Isolation moves*/
   OpStep = INTEGER NOT NULL WITH DEFAULT;
   OpStepName = VARCHAR(20) NOT NULL WITH DEFAULT;
   OpStepStartTime = DATE NOT NULL WITH DEFAULT;
   OpStepIncrement = INTEGER NOT NULL;
   PendingCheck = ARRAY OF PendingOpStepClass;
   PrevStep = PendingOpStepClass;
   RetCode = INTEGER NOT NULL;
   SimpleStep = OperatingStep_ASE DEFAULT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to manage the Generic Operating Step
** and clear any jobs while issuing moves.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 1;
   FC.Clear();
   REPEATED
   SELECT :FC[i].Card = C.Card,
          :FC[i].Cutout = C.Cutout,
          :FC[i].Cutin  = C.CutIn,
          :FC[i].CardClassName = C.CardClassName,
          :FC[i].CardClass = C.CardClass,
          :FC[i].Feeder = C.Feeder,
          :FC[i].FeederName = C.FeederName,
          :FC[i].TypeOfCard = C.TypeOfCard,
          :FC[i].XferFlag = JC.StepPair  /*Hiding FMS StepPair in this field because passed in StepPair may be from SLC*/
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC,
          FMS_Card C
   WHERE  JC.Job = :CurObject.Job AND
          JC.Card = C.Card AND
          JC.Card = AC.Card AND
          C.CutOut IS NOT NULL AND
          C.CutIn IS NULL
   BEGIN 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   FOR i = 1 TO FC.LastRow() DO
/*
**  We will clear delays on any action done on a CurObject.  If delay 
**  clearing fails, just display a message and let them continue with issuing move. 
*/
      RetCode = CALLPROC FMS_JobDelayCheck(
                          Job = CurObject.Job,
                          Card = FC[i].Card,
                          TORS = IFNULL(CurObject.TORS,0),
                          TypeOfCard = FC[i].TypeOfCard,
                          CurrentTime = date('now'),
                          ByPassOpCheck = CurObject.IncompleteFlag,
                          IssueComplete = IFNULL(CurObject.IssueCompl,0));
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
            'WARNING:  Delays associated with this job were ' +
            'not cleared.  You will need to clear them manually on the ' +
            'Delay screen.',
                        TraceMessage =
            'Class:OperatingStep_ASE;Method:PendingDelayMgt; ' +
            'Delays associated with a job were ' +
            'not cleared.  Warning presented to User for Card ' +
            VARCHAR(FC[i].Card) + '.'
            );
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;   

      IF CurObject.IssueCompl = JobClass$Issue THEN
         IF CurObject.IncompleteFlag = TRUE THEN
            OpStepIncrement = -1;
            /*
            ** We don't set PendingOpStep when on return moves screen 
            ** so clear these values now.
            */
            PendingOpStep.SetFlag = FALSE;
            PendingOpStep.Job     = 0;
         ELSE  
            OpStepIncrement = 1;
         ENDIF;
      ELSE
         OpStepIncrement = -1;
         /*
         ** We don't set PendingOpStep when on return moves screen 
         ** so clear these values now.
         */
         PendingOpStep.SetFlag = FALSE;
         PendingOpStep.Job     = 0;
      ENDIF;
          
      RetCode = CALLPROC FMS_StepCountUpd(
                Card = FC[i].Card,
                OperatingStep = Type$OperatingStepCount,  
                Increment = OpStepIncrement);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                         TraceMessage =
            'Class:OperatingStep_ASE;Method:PendingDelayMgt; ' +
            'This is the famous DO Delay Out of Whack Message. ' +
            'Something wacky has happened on card ' + 
            VARCHAR(FC[i].Card) + ' attempting Pending Delay increment ' +
            'of ' + VARCHAR(OpStepIncrement) + '.'
            );
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;  
/*
** Look to see if ISO operating step should be invoked.
** FMS StepPair hidden in FMS_Card class XferFlag field
*/
      IF (FC[i].XferFlag = StepHeading$Deload OR FC[i].XferFlag = StepHeading$ISO) AND
          CurObject.TORS = Job$TakeOutInt AND
         (MoveType = MoveType$ISL OR MoveType = MoveType$DLD OR MoveType = '') THEN
/*
** Set Fields to make object methods work
*/
         CurObject.SO.Object = FC[i].Card;
         CurObject.SO.BaseType = FC[i].CardClass;
         CurObject.SO.Name = FC[i].CardClassName;
         CurObject.SO.Type = FC[i].Feeder;
         CurObject.SO.TypeName = FC[i].FeederName;
         CurObject.CutIn = FC[i].Cutin;
         CurObject.CutOut = FC[i].Cutout;
   
         CurrentOpStep = 0;
         REPEATED
         SELECT :CurrentOpStep = OS.OperatingStep
         FROM   FMS_OperatingStepStatus OS,
                Udb_SuperType ST 
         WHERE  OS.Card = :FC[i].Card AND
                OS.OperatingStep = ST.Type AND
                ST.SuperType = :Type$OperatingStepStatus AND
                ST.Type <> :Type$Delay AND
                OS.EndTime = '';
/*
** Different Operating Step to be set at Issue vs. Completion
*/
         CurObject.ReturnCode = 0;
         IF CurObject.IssueCompl = JobClass$Issue THEN
            IF CurObject.IncompleteFlag = TRUE THEN
/*
** Count number of outstanding isolation moves.
*/
               CurObject.ReturnCount = 0;
               ISOCount = 0;
               CurObject.CountIsolationMoves();
               ISOCount = CurObject.ReturnCount;

               IF CurrentOpStep = Type$ISTA AND 
                  ISOCount = 0 THEN          
                   CurObject.OpStep = Type$STA;
                   CurObject.SetOpStep();     
               ELSEIF CurrentOpStep = Type$ISOStep AND
                  ISOCount = 0 THEN
                  CurObject.OpStep = Type$ISOStep;
                  CurObject.ClearOpStep();     
               ENDIF;

            ELSE

               IF CurrentOpStep = Type$STA THEN          
                  CurObject.OpStep = Type$ISTA;
                  CurObject.SetOpStep();     
               ELSEIF CurrentOpStep = 0 THEN
                  CurObject.OpStep = Type$ISOStep;
                  CurObject.SetOpStep();     
               ENDIF;

            ENDIF;

         ELSE  /* Move being completed */
               
            IF CurrentOpStep = Type$ISTA OR CurrentOpStep = Type$ISOStep THEN
/*
** Count number of outstanding isolation moves.
*/
               CurObject.ReturnCount = 0;
               ISOCount = 0;
               CurObject.CountIsolationMoves();
               ISOCount = CurObject.ReturnCount;
                        
               IF ISOCount = 0 THEN
                  IF CurrentOpStep = Type$ISTA THEN
                     CurObject.OpStep = Type$STA;
                     CurObject.SetOpStep();     
                  ELSEIF CurrentOpStep = Type$ISOStep THEN
                     CurObject.OpStep = Type$ISOStep;
                     CurObject.ClearOpStep();     
                  ENDIF;
               ENDIF;
            ENDIF;
         ENDIF;  
/*
** Check for and process operating step error.
*/                  
         IF CurObject.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = CurObject.ErrorMessage,
            TraceMessage =
             'Method:PendingDelayMgt; ' +
             'Error adjusting operating step following Isolation Move Update. ' +
             'Card=' + VARCHAR(CurObject.SO.Object) +
             ';Status=' + VARCHAR(CurObject.OpStep) + '.'
            );
         ENDIF; 
      ENDIF;
   ENDFOR;   
/*
** See if there are any entries in FMS_PendingOpStep table for this job.
*/             
   i = 1;
   PendingCheck.Clear();
   SELECT :PendingCheck[i].Card   = O.Card,
          :PendingCheck[i].CardClass = C.CardClass,
          :PendingCheck[i].CardClassName = C.CardClassName,
          :PendingCheck[i].Feeder = C.Feeder,
          :PendingCheck[i].FeederName = C.FeederName,
          :OpStep                 = T.Type,
          :OpStepName             = T.Name
   FROM    FMS_PendingOpStep O,
           FMS_Card C,
           Udb_Type T
   WHERE   O.Job  = :CurObject.Job AND
           O.TORS = :CurObject.TORS AND
           O.OperatingStep = T.Type AND
           O.Card = C.Card
   BEGIN
      i = i + 1;
   END;
         
   IF PendingCheck.LastRow() <> 0 THEN
      IF CurObject.IncompleteFlag <> TRUE THEN  
         OpStepStartTime = date('now');
         /*
         **  See if job is part of an operating order.  If it is 
         **  we don't need to prompt for the time.  The soo interface 
         **  should give us the updated start time for any pending operating
         **  steps.
         */
         i = 0;
         SELECT :i = COUNT(*) 
         FROM    IR_OpOrderJobs J,
                 IR_OperatingOrder O
         WHERE   J.Job = :CurObject.Job AND
                 J.TORS = :CurObject.TORS AND
                 J.OrderNumber = O.OrderNumber AND
                 O.OrderStatus <= :Order$Closed;   
            
         IF i = 0 AND AutomaticExecution = FALSE THEN
            CALLFRAME OpStepStartTimeUpdate(
                    Job        = CurObject.Job,
                    TORS       = CurObject.TORS,
                    OpStepName = OpStepName,
                    PassedTime = ByRef(OpStepStartTime)
                    );
         ENDIF;

         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    

         SimpleStep.StartTime   = OpStepStartTime;
         SimpleStep.OpStep      = OpStep;
         SimpleStep.Job         = CurObject.Job;

         FOR i = 1 TO PendingCheck.LastRow() DO
            PrevStep.OpStep = 0;
            SELECT :PrevStep.OpStep = OS.OperatingStep,
                   :PrevStep.StartTime = OS.StartTime,
                   :PrevStep.EndTime = OS.EndTime
            FROM   FMS_OperatingStepStatus OS
            WHERE  OS.Card = :PendingCheck[i].Card AND
                   OS.OperatingStep <> :Type$OperatingStepCount AND
	           OS.StartTime = (SELECT MAX(StartTime)
	                           FROM   FMS_OperatingStepStatus OS2,
	                                  Udb_SuperType S
	                           WHERE  OS2.Card = :PendingCheck[i].Card AND
	                                  OS2.OperatingStep <> :Type$OperatingStepCount AND
	                                  OS2.OperatingStep = S.Type AND
	                                  S.SuperType = :Type$OperatingStepStatus);
            CALLPROC DDB_ROLLBACK;
  
            IF PrevStep.OpStep <> 0 AND PrevStep.EndTime <> '' THEN
	       /* 
               ** update the previous operating step's end time 
               */	       

               RetCode = CALLPROC FMS_OpStepEndTimeUpd ( 
                                Card = PendingCheck[i].Card,
                                OperatingStep = PrevStep.OpStep,
                                StartTime = PrevStep.StartTime,
                                EndTime = OpStepStartTime);

               IF RetCode <> 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = '',
                     TraceMessage =
                        'Class:OperatingStep_ASE;Method:PendingDelayMgt; ' +
                        'Error updating endtime of Operating step. ' +
                        'Card=' + VARCHAR(PendingCheck[i].Card) +
                        ';Status=' + OpStepName + '.'
                      );
               ELSE
                  CALLPROC DDB_COMMIT;
               ENDIF;
            ENDIF;

            SimpleStep.SO.Object   = PendingCheck[i].Card;
            SimpleStep.SO.BaseType = PendingCheck[i].CardClass;
            SimpleStep.SO.Name     = PendingCheck[i].CardClassName;
            SimpleStep.SO.Type     = PendingCheck[i].Feeder;
            SimpleStep.SO.TypeName = PendingCheck[i].FeederName;
 
            SimpleStep.SetOpStep();
   
            IF SimpleStep.ReturnCode <> 0 THEN
               CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                  TraceMessage =
                   'Class:OperatingStep_ASE;Method:PendingDelayMgt; ' +
                   'Error setting a Pending Operating Step. ' +
                   'Card=' + VARCHAR(PendingCheck[i].Card) +
                   ';Status=' + OpStepName + '.'
                   );
            ENDIF; 
         ENDFOR;
         SimpleStep = NULL;

      ENDIF;     
      /*
      **  Remove any pending operating steps tied to the move.
      **  Don't check return code, this is not critical.
      */
      CALLPROC FMS_PendingOpStepDel (
         Job = CurObject.Job,
         ToRs = CurObject.TORS);
      CALLPROC DDB_COMMIT;
   ENDIF;


   RETURN;
END;


METHOD CountIsolationMoves (
) =
DECLARE
   IsolationMoveCount = INTEGER NOT NULL;  /*Our Return Value*/
ENDDECLARE
BEGIN
/* 
** Count the number of Isolation Moves that are outstanding on the current card.
** These moves will be in the Deload or Isolation Step and will have Move Type of
** DLD, ISL, or blank (both).  The moves will be takeout issued but not completed.
** 02/03/16 pkw Sometimes the DO's can not download an order to the station until
**              a person is present. When STA is completed (feeder is grounded)
**              there may be moves that should cause the feeder to go to ISO OpStep.
**              Per request from Mike Sanito, we will change logic to look for 
**              Deload/ISO moves that haven't been completed instead of outstanding.
*/
   IsolationMoveCount = 0;
   SELECT :IsolationMoveCount = COUNT(J.Job)
   FROM   SOA_Job J,
          SOA_JobControl JC
   WHERE  JC.Card = :CurObject.SO.Object AND  /*CARD*/
          JC.StepPair IN (:StepHeading$Deload, :StepHeading$ISO) AND
          JC.Job = J.Job AND
          J.MoveType IN ('', :MoveType$ISL, :MoveType$DLD) AND
          J.Status = '' AND
       /* J.TOIssued IS NOT NULL AND * remove on 02/03/16 */
          J.TOComplete IS NULL; 
   
   CurObject.ReturnCount = IsolationMoveCount;
   RETURN;
END;

METHOD CountCompletedTGMoves (
)=
DECLARE
   IssuedTGMoves = INTEGER NOT NULL WITH DEFAULT;
   CompletedTGMoves = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Find out the number of issued and comleted TG moves.  
**   If Issued > 0 and Completed = 0 then return 0
**   If Issued = 0 return -1
**   If Completed > 0, return number of completed.
*/
   CurObject.ReturnCount = 0;

   IssuedTGMoves = 0;
   REPEATED 
   SELECT  :IssuedTGMoves = COUNT(*)
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.TOIssued IS NOT NULL AND  /* Just look at issue */
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 3 AND   /*OperatingStep*/
           JA.TORS = :Job$TakeOutInt AND
           JA.IssueCompl = 0 AND    /*Issue*/
           JA.Action IN (:JobAction$Set,:JobAction$Increment) AND
           JA.Status = :Type$TG;

   CompletedTGMoves = 0;  
   REPEATED 
   SELECT  :CompletedTGMoves = COUNT(*)
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.TOComplete IS NOT NULL AND  /* Just look at complete */
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 3 AND   /*OperatingStep*/
           JA.TORS = :Job$TakeOutInt AND
           JA.IssueCompl = 0 AND    /*Issue*/
           JA.Action IN (:JobAction$Set,:JobAction$Increment) AND
           JA.Status = :Type$TG;
   
   IF IssuedTGMoves > 0 AND CompletedTGMoves = 0 THEN
      CurObject.ReturnCount = 0;
   ELSEIF IssuedTGMoves = 0 THEN
      CurObject.ReturnCount = -1;
   ELSE
      CurObject.ReturnCount = CompletedTGMoves;
   ENDIF;

   RETURN;
END;

METHOD CheckOutstandingSTA (
)=
DECLARE
   STAMove = INTEGER NOT NULL;  /*Our Return Value*/
ENDDECLARE
BEGIN
/*
** Find if the Card has an outstanding STA move and return the Job number
** if it does.
*/
   CurObject.ReturnCount = 0;
   STAMove = 0;
   REPEATED 
   SELECT  :STAMove = J.Job
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.TOIssued IS NOT NULL AND
           J.TOComplete IS NULL AND
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 3 AND   /*OperatingStep*/
           JA.TORS = :Job$TakeOutInt AND
           JA.IssueCompl = 0 AND    /*Issue*/
           JA.Action = :JobAction$Set AND
           JA.Status = :Type$STA;

   CurObject.ReturnCount = STAMove;
   RETURN;
END;

METHOD CheckOutstandingOTW (
)=
DECLARE
   OTWType = INTEGER NOT NULL;  /*Our Return Value*/
ENDDECLARE
BEGIN
/*
** Find if the Card has an outstanding OTW moves and return the OTW
** correct Operating Type if it does if it does.
*/
   CurObject.ReturnCount = 0;
   OTWType = 0;
   REPEATED 
   SELECT  :OTWType = JA.Status
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.TOIssued IS NOT NULL AND
           J.RSComplete IS NULL AND
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 3 AND   /*OperatingStep*/
           JA.TORS = :Job$TakeOutInt AND
           JA.IssueCompl = 0 AND    /*Issue*/
           JA.Status IN (:Type$OTWR,:Type$OTWS)
   BEGIN
      /*
      **  OTWR has priority over OTWS.  If we find OTWR, we are done.
      */
      IF OTWType = Type$OTWR THEN
         CurObject.ReturnCount = OTWType;
         RETURN;
      ENDIF;
   END;

   CurObject.ReturnCount = OTWType;
   RETURN;
END;

METHOD CheckIssuedPFW (
)=
DECLARE
   PFWCount = INTEGER NOT NULL;  /*Our Return Value*/
ENDDECLARE
BEGIN
/*
** Find out if the issued move sets PFW.  IF it does return non zero result.
*/
   CurObject.ReturnCount = 0;
   PFWCount = 0;
   REPEATED 
   SELECT  :PFWCount = JA.Status
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Job = :CurObject.Job AND /* Issued Job */
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 3 AND   /*OperatingStep*/
           JA.Status = :Type$PFW;

   CurObject.ReturnCount = PFWCount;
   RETURN;
END;


METHOD ApplyPendingDelay (
)=
DECLARE
   i = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
   StepCount = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to Apply a Pending Delay to a feeder
** if appropriate.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.CutOut IS NOT NULL AND CurObject.CutIn IS NULL THEN

      i = 0;
      SELECT :i = J.Job
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :CurObject.SO.Object AND
             JC.Job = J.Job AND
             J.Status = '' AND
             J.TOIssued IS NOT NULL AND
             J.TOComplete IS NULL;

      IF i = 0 THEN
         SELECT :i = J.Job
         FROM   SOA_JobControl JC,
                SOA_Job J
         WHERE  JC.Card = :CurObject.SO.Object AND
                JC.Job = J.Job AND
                J.Status = '' AND
                J.RSIssued IS NOT NULL AND
                J.RSIssued <> '' AND
                J.RSComplete IS NULL;
      ENDIF;

      IF i = 0 THEN
         SELECT :i = J.Job
         FROM   SOA_JobControl JC,
                SOA_Job J
         WHERE  JC.Card = :CurObject.SO.Object AND
                JC.Job = J.Job AND
                J.Status = '' AND
                J.TOIssued IS NOT NULL AND
                J.TOComplete = '' AND
                J.RSIssued = '' AND
                J.RSComplete IS NULL;
      ENDIF;

      IF i = 0 THEN
         /*
         **   Confirm that Generic Operating Step is at 0.
         */
         StepCount = 0;
         REPEATED 
         SELECT  :StepCount = OS.StepCount
         FROM     FMS_OperatingStepStatus OS
         WHERE    OS.Card = :CurObject.SO.Object AND
                  OS.OperatingStep = :Type$OperatingStepCount;
/*
**  If StepCount <> 0 then adjust it.  For some reason it got out of whack.
**  A rule should then trigger DO Delay to get started.  If StepCount = 0,
**  then we need to insert a DO Delay manually.  If this fails we won't 
**  display a message.
*/
         IF StepCount <> 0 THEN 
            CALLPROC FMS_OperatingStepUpd (
                   Card = CurObject.SO.Object,
                   OperatingStep = Type$OperatingStepCount,
                   EndTime = '');
            CALLPROC DDB_COMMIT;
         ELSE
/*
**  Don't apply delay if certain conditions exist.  Check to see if 
**  specific feeder statuses exist for feeder.
*/
            i = 0;
            SELECT :i = COUNT(*) 
            FROM    FMS_ObjectStatus OS,
                    TFMS_CardToObject CTO
            WHERE   CTO.Card = :CurObject.SO.Object AND
                    CTO.Object = OS.Object AND
                    OS.Status IN 
                       (:TypeName$HV,:TypeName$TC,:TypeName$OJ_To_OGS) AND 
                    OS.StatusCount > 0; 
            CALLPROC DDB_ROLLBACK;
/*
**  Make sure feederstatus not in LOC or INSP
*/         
            IF i = 0 THEN
               SELECT :i = COUNT(*) 
               FROM    FMS_OperatingStepStatus
               WHERE   Card = :CurObject.SO.Object AND
                       OperatingStep IN (:Type$LOC,:Type$INSP) AND 
                       EndTime = '';
               CALLPROC DDB_ROLLBACK;
            ENDIF;
 
            IF i = 0 THEN
               RetCode = CALLPROC FMS_OperatingStepIns(
                            Card = CurObject.SO.Object,
                            CardClassName = CurObject.SO.Name,
                            Feeder = CurObject.SO.Type,
                            FeederName = CurObject.SO.TypeName,
                            OperatingStep = Type$DODelay,
                            StartTime = 'now');
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Error setting an Operating Step.  ' +
                          'Tech Support should be contacted to review your ' +
                          'machine trace log.';
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;
   
   RETURN;
END;

METHOD UndoOpStep (
   IssueTime = DATE;
   Action    = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   CheckTime = DATE NOT NULL WITH DEFAULT;
   i        = INTEGER NOT NULL;
   PrevOperatingStep = INTEGER NOT NULL;
   PrevStartTime     = DATE NOT NULL WITH DEFAULT;
   PrevEndTime       = DATE NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL;
   StepCount  = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set Operating Steps Status
**
** Values that need to be passed in:
** CurObject.SO.Object    = Card
** CurObject.SO.BaseType  = CardClass (Only needed if setting OTW* step)
** CurObject.SO.Name      = CardClassName
** CurObject.SO.Type      = Feeder
** CurObject.SO.TypeName  = FeederName
** CurObject.OpStep       = OperatingStep
** CurObject.StartTime    = OpStep StartTime (optional: default 'now')
** CurObject.Job          = Job being issued.(Only needed if setting OTW* step)
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Find out if this step is the current operating step.  If not we are done.
*/
   CheckTime = '';
   SELECT :StepCount = O.StepCount,
          :CheckTime = O.StartTime
   FROM    FMS_OperatingStepStatus O
   WHERE   O.Card = :CurObject.SO.Object AND
           O.OperatingStep = :CurObject.OpStep AND
           O.EndTime = '';
   IF CheckTime = '' THEN
      RETURN;
   ENDIF;
   /*
   **  If Action = JobAction$Increment, then we have to see what is the stepcount. 
   **  If stepcount > 1, we will just decrement the current step.
   */
   IF Action = JobAction$Increment AND 
      StepCount > 1 THEN
      CurObject.DecrementOpStep();
      RETURN;
   ENDIF;
   /*
   **  Remove Current Operating Step.
   */
   RetCode = CALLPROC FMS_OperatingStepDel(
              Card          = CurObject.SO.Object,
              OperatingStep = CurObject.OpStep,
              StartTime     = CheckTime);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error removing Operating Step.  ' +
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
      CALLPROC TraceError (UserMessage = '',
           TraceMessage = 'Class:OperatingStep_ASE;Method:UndoOpStep; ' +
           'Unable to remove operatingstep:' + VARCHAR(CurObject.OpStep) + 
           ' for card:' + VARCHAR(CurObject.SO.Object)
            );   
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   IF CheckTime >= IssueTime THEN
      /*
      **  Set Endtime of previous OperatingStep 
      */
      PrevOperatingStep = 0;
      SELECT :PrevOperatingStep = OS.OperatingStep,
             :PrevStartTime = OS.StartTime,
             :PrevEndTime = OS.EndTime
      FROM   FMS_OperatingStepStatus OS
      WHERE  OS.Card = :CurObject.SO.Object AND
             OS.OperatingStep <> :Type$OperatingStepCount AND
             OS.StartTime = (SELECT MAX(StartTime)
	                     FROM   FMS_OperatingStepStatus OS2,
	                            Udb_SuperType S
	                     WHERE  OS2.Card = :CurObject.SO.Object AND
	                            OS2.OperatingStep <> :Type$OperatingStepCount AND
	                            OS2.OperatingStep = S.Type AND
                                    S.SuperType = :Type$OperatingStepStatus);
      CALLPROC DDB_ROLLBACK;
  
      IF PrevOperatingStep <> 0 THEN
         /* 
         ** update the previous operating step's end time 
         */	       
         RetCode = CALLPROC FMS_OpStepEndTimeUpd ( 
                          Card = CurObject.SO.Object,
                          OperatingStep = PrevOperatingStep,
                          StartTime = PrevStartTime,
                          EndTime = '');
         
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = '',
                 TraceMessage =
                     'Class:OperatingStep_ASE;Method:UndoOpStep; ' +
                     'Error updating endtime of Operating step. ' +
                     'Card=' + VARCHAR(CurObject.SO.Object) +
                     ';Status=' + varchar(PrevOperatingStep) + '.'
                 );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
   RETURN;
END;

METHOD SetOpStep (
)=
DECLARE
   i        = INTEGER NOT NULL;
   IsOpStep = INTEGER NOT NULL;
   OpStepName = VARCHAR(40) NOT NULL;
   RetCode  = INTEGER NOT NULL;
   SaveStep = INTEGER NOT NULL;
   SkipOTWStuff = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set Operating Steps Status
**
** Values that need to be passed in:
** CurObject.SO.Object    = Card
** CurObject.SO.BaseType  = CardClass (Only needed if setting OTW* step)
** CurObject.SO.Name      = CardClassName
** CurObject.SO.Type      = Feeder
** CurObject.SO.TypeName  = FeederName
** CurObject.OpStep       = OperatingStep
** CurObject.StartTime    = OpStep StartTime (optional: default 'now')
** CurObject.Job          = Job being issued.(Only needed if setting OTW* step)
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   SkipOTWStuff = FALSE;
/*
**  If this is a linked 4kV StepDown Feeder we don't want to track operating steps.
*/
   i = 0;
   SELECT :i = COUNT(*)
   FROM    FMS_StepDownLink
   WHERE   StepDownCard = :CurObject.SO.Object;
   IF i > 0 THEN
      RETURN;
   ENDIF;
/*
**  If no StartTime was passed in set = now.
*/
   IF CurObject.StartTime = '' THEN
      CurObject.StartTime = date('now');
   ENDIF;
/*
**  Set IsOpStep flag to true or FALSE. 
*/
   IsOpStep = FALSE;
   SELECT :IsOpStep = :TRUE,
          :OpStepName = T.Name
   FROM    Udb_SuperType ST,
           Udb_Type T
   WHERE   ST.SuperType = :Type$OperatingStepStatus AND
           ST.Type      = :CurObject.OpStep AND
           ST.Type      = T.Type;
/*
**  First check. If current step is ABF AND there is an ABF Delay, 
**  we won't set any other operating step. We expect to get at least
**  two rows back from this select if both ABF delay and operating step
**  exists.
*/
   IF IsOpStep = TRUE THEN
      i = 0;
      SELECT :i = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card = :CurObject.SO.Object AND
              OperatingStep IN (:Type$ABF,:Delay$ABF) AND
              EndTime = '';
    
      IF i >= 2 THEN
         RETURN;
      ENDIF;
   ENDIF;
/*
**  If the current move sets PFW, we will look to see if there are 
**  outstanding moves that set OTWR or OTWS.  If there are, we will 
**  switch the CurObject.OpStep to OTWR or OTWS.  Combine with the OTW 
**  statement so we don't inadvertantly get into an infinate loop.
*/
   IF CurObject.OpStep = Type$PFW THEN
      /*
      ** Did the issued move set PFW or was it set to fill in space
      ** by the OTW step.
      */
      CurObject.ReturnCount = 0;
      CurObject.CheckIssuedPFW();
      IF CurObject.ReturnCount <> 0 THEN
         /*
         ** Is OTW move outstanding?
         */
         CurObject.ReturnCount = 0;
         CurObject.CheckOutstandingOTW();
         IF CurObject.ReturnCount <> 0 THEN
            CurObject.OpStep = CurObject.ReturnCount;
            SkipOTWStuff = TRUE;
         ENDIF;
      ENDIF;
   ELSEIF CurObject.OpStep = Type$OTW OR
          CurObject.OpStep = Type$OTWS OR
          CurObject.OpStep = Type$OTWR OR
          CurObject.OpStep = Type$TC THEN
      
/*
**  If we are setting any OTW step or TC step, look to see if we have a current
**  operating step. If there isn't a current operating step we will 
**  insert a PFW step to fill in the gap of between the last completion
**  time and this starttime.  If the last step was completed within one
**  minute we will avoid the PFW step.  This solves the problem when 
**  a FCR permit is completed and OTWS is being set.  In PromptProcFromWorkFCR
**  the OTWR step is cleared before calling setopstep so that the OTWS step
**  is not ignored on set.
*/
      i = 0;
      SELECT :i = COUNT(*) 
      FROM    FMS_OperatingStepStatus O
      WHERE   O.Card = :CurObject.SO.Object AND
             (O.EndTime = '' OR
              O.EndTime > date('now') - '1 minute') AND
              O.OperatingStep IN (SELECT Type
                                  FROM   Udb_SuperType
                                  WHERE  SuperType = :Type$OperatingStepStatus AND
                                         Type <> :Type$Delay AND
                                         Type <> :Type$OperatingStepCount AND
                                         Type <> :Type$DODelay);
      IF i = 0 THEN /* No current OperatingStep */
         /* Save current step and call setopstep recursively */
         SaveStep = CurObject.OpStep;
         CurObject.OpStep = Type$PFW;
         CurObject.SetOpStep();
         /* Now set back to original step and continue */
         CurObject.OpStep = SaveStep;
         /* Reset Pending Flags */
         PendingOpStep.SetFlag = FALSE;
         PendingOpStep.Job = 0; 
      ENDIF;
   ENDIF;
/*
** Do not set DM if the current step is OTW, ID, FG
*/
   IF  CurObject.OpStep = Type$DM THEN
      i = 0;
      SELECT :i = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card = :CurObject.SO.Object AND
              OperatingStep IN (:Type$OTW,:Type$OTWS,:Type$OTWR,:Type$FG,:Type$ID) AND
              EndTime = '';
      IF i <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
/*
** IF we are seting STA, look for outstanding isolation moves.  If they exist,
** go to ISTA.
*/
   IF CurObject.OpStep = Type$STA THEN
      CurObject.ReturnCount = 0;
      CurObject.CountIsolationMoves();
      IF CurObject.ReturnCount > 0 THEN
         CurObject.OpStep = Type$ISTA;
      ENDIF;
   ENDIF;
/*
**  There can only be one target ground.  If this is a TG Operating Step,
**  we will check to make sure there are no TG steps for this card.  It
**  doesn't matter if it is completed or not. If it is outstanding we want
**  to return also because we don't want to be setting pending operating steps.
*/
   IF CurObject.OpStep = Type$TG AND
      CurObject.BypassTGCheck <> 1 THEN
      i = 0;
      SELECT :i = COUNT(*) 
      FROM    FMS_OperatingStepStatus OS
      WHERE   OS.Card = :CurObject.SO.Object AND
              OS.OperatingStep = :Type$TG;
      IF i <> 0 THEN
         RETURN;
      ENDIF;
      /*
      **  Send message to CSD 
      */            
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                       ,MessageText = 'Feeder ' + CurObject.SO.TypeName +
                           ' Target Ground ordered on - ' +
                           'Verify SSO applying T.C. leads'
                       ,Time = date('now')
                       ,Priority = 0
                       ,MessageType = 0
                       ,Card = CurObject.SO.Object);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Could not send automated ' +
                 'message to CSD. You may want to tell him that the ' +
                 'Target Ground has been ordered on.',
              TraceMessage = 'Class:OperatingStep_ASE;Method:SetOpStep; ' +
              'Unable to send automated message regarding Target Ground ' + 
              'being ordered on card:' + VARCHAR(CurObject.SO.Object)
              );   
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** If Auto or CIOA card type (selected into BaseType field) and OTW op step
** being inserted, then make sure card is not already OpenAutoPlus/OTW+
** PU_CANCEL return = OTW+; PU_OK return = OTW
*/
   IF (CurObject.SO.BaseType = Type$Auto OR
       CurObject.SO.BaseType = Type$CIOA) AND
      (CurObject.OpStep = Type$OTW OR
       CurObject.OpStep = Type$OTWS OR
       CurObject.OpStep = Type$OTWR) AND
       SkipOTWStuff = FALSE THEN

      RetCode = CALLFRAME OAPlusCheckWPIssue (
                   Card = CurObject.SO.Object,
                   PermitJob = CurObject.Job);
                 
      IF RetCode = PU_CANCEL THEN
         /*
         ** Change to OTW+
         */
         CurObject.OpStep = Type$OTWPlus;
      ENDIF;
   ENDIF;      
/*
** If operating step is OTWS then we want to make sure there isn't a 
** current OTWR. If there is this step will be ignored.   
*/   
   IF CurObject.OpStep = Type$OTWS THEN
      i = 0;
      SELECT :i = COUNT(*) 
      FROM    FMS_OperatingStepStatus O
      WHERE   O.Card = :CurObject.SO.Object AND
              O.OperatingStep = :Type$OTWR AND
              O.EndTime = '';
      IF i <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
/*
**  If we are setting ABF, we need to clear out all previous operatingsteps.
*/
   IF CurObject.OpStep = Type$ABF THEN
      CurObject.SetABFStep();
   ENDIF;
/*
**  If we are setting PFSS, check to see if there are field grounds on the
**  feeder.  If yes, we will go into FG instead.
**  01/05/12 - Always set PFSS even if PFS was passed in.
*/
   IF CurObject.OpStep = Type$PFSS OR 
      CurObject.OpStep = Type$PFS THEN

      /* Force PFSS, PFS is obsolete */
      CurObject.OpStep = Type$PFSS;

      RetCode = CurObject.CheckPFSSet();
      
      IF RetCode = 1 THEN
         /* 
         **  Send Event back to main frame
         */
         IF AutomaticExecution = TRUE THEN
            FCAutoFrame.SendUserEvent (EventName = 'SetPFSStep',
                                   MessageInteger = CurObject.SO.Object);
         ELSE
            FCFrame.SendUserEvent (EventName = 'SetPFSStep',
                                   MessageInteger = CurObject.SO.Object);
         ENDIF;
         RETURN;
      ENDIF;
   ENDIF;
/*
**  If PendingOpStep.SetFlag is true, it means an operating step has already
**  been set while issuing a block of moves.  In this case we will set this 
**  step as a pending operating step and it will get started when the previously
**  issued job is completed.  
*/   
   IF PendingOpStep.SetFlag = TRUE AND
      PendingOpStep.Job <> 0 AND
      IsOpStep = TRUE THEN
      RetCode = CALLPROC FMS_PendingOpStepIns(
               Card = CurObject.SO.Object,
               Job  = PendingOpStep.Job,
               TORS = PendingOpStep.TORS,
               OperatingStep = CurObject.OpStep);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error setting Pending Operating Step.  ' +
              'Tech Support should be contacted to review your ' +
              'machine trace log.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      /* insert a transaction log */
      CALLPROC SOA_LogIns (Card = CurObject.SO.Object,
                           Job = PendingOpStep.Job,
                           Item = 'Pending Op Step',
                           Old = 'Operating Step ' + VARCHAR(OpStepName),
                           New = 'Completion of this job will set operating step',
                           Time = Date('now'),
                           UserName = UserName); 
      CALLPROC DDB_COMMIT;

   ELSE
      RetCode = CALLPROC FMS_OperatingStepIns(
               Card = CurObject.SO.Object,
               CardClassName = CurObject.SO.Name,
               Feeder = CurObject.SO.Type,
               FeederName = CurObject.SO.TypeName,
               OperatingStep = CurObject.OpStep,
               StartTime = CurObject.StartTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error setting an Operating Step.  ' +
              'Tech Support should be contacted to review your ' +
              'machine trace log.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*
      **  Confirm that this was an operating step before setting 
      **  PendingOpStep.SetFlag to TRUE. 
      */
      IF IsOpStep = TRUE THEN
         PendingOpStep.SetFlag = TRUE;
      ENDIF;
   ENDIF;

   RETURN;

END;

METHOD ClearOpStep (
)=
DECLARE
   i       = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to clear Operating Steps Status
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  If no endtime was passed in set = now.
*/
   IF CurObject.Endtime = '' THEN
      CurObject.Endtime = date('now');
   ENDIF;
/*
**  If clearing DM, look to see if target ground has been placed.
**  If not, start up TG step.
*/
   IF CurObject.OpStep = Type$DM THEN
      CurObject.ReturnCount = 0;
      CurObject.CountCompletedTGMoves();
      IF CurObject.ReturnCount = 0 THEN
         CurObject.BypassTGCheck = 1;
         SELECT :CurObject.SO.BaseType = CardClass,
                :CurObject.SO.Name     = CardClassName,
                :CurObject.SO.Type     = Feeder,
                :CurObject.SO.TypeName = FeederName
         FROM    FMS_Card
         WHERE   Card = :CurObject.SO.Object;
      
         CurObject.OpStep = Type$TG;
         CurObject.SetOpStep();
         /* No need to clear step */
         RETURN;
      ENDIF;
   ENDIF;
/*
**  If clearing STA, look for outstanding isolation moves.  If they exist,
**  go to ISO.
*/
   IF CurObject.OpStep = Type$STA THEN
      CurObject.ReturnCount = 0;
      CurObject.CountIsolationMoves();
      IF CurObject.ReturnCount > 0 THEN
         SELECT :CurObject.SO.BaseType = CardClass,
                :CurObject.SO.Name     = CardClassName,
                :CurObject.SO.Type     = Feeder,
                :CurObject.SO.TypeName = FeederName
         FROM    FMS_Card
         WHERE   Card = :CurObject.SO.Object;
      
         CurObject.OpStep = Type$ISOStep;
         CurObject.SetOpStep();
         /* No need to clear step */
         RETURN;
      ENDIF;
      /*
      **  If we are currently in ISTA, then we need to clear
      **  that step so we will make a quick check.
      */
      i = 0;
      SELECT :i = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card          = :CurObject.SO.Object AND
              OperatingStep = :Type$ISTA AND
              EndTime       = '';
      IF i <> 0 THEN
         CurObject.OpStep = Type$ISTA;
      ENDIF;
   ENDIF;
/*
**  If clearing PFSF start up PFSS. 
*/
   IF CurObject.OpStep = Type$PFSF THEN
      /*
      **  If PFSF isn't the current operating step do not set PFSS.
      **  An OTW move may have been issued and we want to stay on thay step.
      */
      i = 0;
      SELECT :i = COUNT(*) 
      FROM    FMS_OperatingStepStatus O
      WHERE   O.Card = :CurObject.SO.Object AND
              O.OperatingStep = :Type$PFSF AND
              O.EndTime = '';
      
      IF i <> 0 THEN /* No current OperatingStep */
         SELECT :CurObject.SO.BaseType = CardClass,
                :CurObject.SO.Name     = CardClassName,
                :CurObject.SO.Type     = Feeder,
                :CurObject.SO.TypeName = FeederName
         FROM    FMS_Card
         WHERE   Card = :CurObject.SO.Object;
      
         CurObject.OpStep = Type$PFSS;
         CurObject.SetOpStep();
         RETURN;
      ENDIF;
   ENDIF;
   
   RetCode = CALLPROC FMS_OperatingStepUpd(
               Card = CurObject.SO.Object,
               OperatingStep = CurObject.OpStep,
               EndTime = CurObject.EndTime);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error clearing an Operating Step.  ' +
              'Tech Support should be contacted to review your ' +
              'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RETURN;
END;

METHOD DecrementOpStep (
)=
DECLARE
   i       = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to clear Operating Steps Status
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC FMS_StepCountUpd(
          Card = CurObject.SO.Object,
          OperatingStep = CurObject.OpStep,  
          Increment = -1);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error decrementing an Operating Step.  ' +
              'Tech Support should be contacted to review your ' +
              'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  If decrementing DM, see if endtime was set. If so look to see if 
**  target ground has been placed.  If not, start up TG step.
*/
   IF CurObject.OpStep = Type$DM THEN
      i = 0;
      SELECT :i = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card          = :CurObject.SO.Object AND
              OperatingStep = :Type$DM AND
              EndTime       = '';
      IF i = 0 THEN
         CurObject.ReturnCount = 0;
         CurObject.CountCompletedTGMoves();
         IF CurObject.ReturnCount = 0 THEN
            CurObject.BypassTGCheck = 1;
            SELECT :CurObject.SO.BaseType = CardClass,
                   :CurObject.SO.Name     = CardClassName,
                   :CurObject.SO.Type     = Feeder,
                   :CurObject.SO.TypeName = FeederName
            FROM    FMS_Card
            WHERE   Card = :CurObject.SO.Object;
      
            CurObject.OpStep = Type$TG;
            CurObject.SetOpStep();
            /* No need to clear step */
            RETURN;
         ENDIF;
      ENDIF;
   ENDIF;
/*
**  If decrementing PFSF, see if endtime was set.  If so start up PFSS. 
*/
   IF CurObject.OpStep = Type$PFSF THEN
      i = 0;
      SELECT :i = COUNT(*)
      FROM    FMS_OperatingStepStatus
      WHERE   Card          = :CurObject.SO.Object AND
              OperatingStep = :Type$PFSF AND
              EndTime       = '';
      IF i = 0 THEN
         /*
         **  Before setting PFSS, make sure there isn't another
         **  current operating step like OTWR etc...  Do not set
         **  PFSS if there is another active Operating Step.
         */
         i = 0;
         SELECT :i = COUNT(*) 
         FROM    FMS_OperatingStepStatus O
         WHERE   O.Card = :CurObject.SO.Object AND
                 O.EndTime = '' AND
                 O.OperatingStep IN (SELECT Type
                                     FROM   Udb_SuperType
                                     WHERE  SuperType = :Type$OperatingStepStatus AND
                                            Type <> :Type$Delay AND
                                            Type <> :Type$OperatingStepCount AND
                                            Type <> :Type$DODelay);
         IF i = 0 THEN /* No current OperatingStep */

            SELECT :CurObject.SO.BaseType = CardClass,
                   :CurObject.SO.Name     = CardClassName,
                   :CurObject.SO.Type     = Feeder,
                   :CurObject.SO.TypeName = FeederName
            FROM    FMS_Card
            WHERE   Card = :CurObject.SO.Object;
      
            CurObject.OpStep = Type$PFSS;
            CurObject.SetOpStep();
            RETURN;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN;
END;

METHOD SetABFStep (
)=
DECLARE
   i       = INTEGER NOT NULL;
   OS      = ARRAY OF OperatingStepStatusClass;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to remove all operating steps from 
** FMS_OperatingStepStatus and insert RemoveRow records into
** FRA_OperatingStepStatus for each Operating Step deleted.  Both
** of these tasks are performed in the FMS_OperatingStepDel procedure.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   OS.Clear();
   i = 1;
   SELECT :OS[i].Card          = O.Card,
          :OS[i].OperatingStep = O.OperatingStep,
          :OS[i].StartTime     = O.StartTime
   FROM    FMS_OperatingStepStatus O
   WHERE   O.Card = :CurObject.SO.Object AND
           O.OperatingStep IN (SELECT Type
                               FROM   Udb_SuperType
                               WHERE  SuperType = :Type$OperatingStepStatus AND
                                      Type <> :Type$Delay AND
                                      Type <> :Type$OperatingStepCount AND
                                      Type <> :Type$DODelay)
   BEGIN
     i = i + 1;
   END;
/*
**  Now remove all rows from FMS_OperatingStepStatus.
*/
   FOR i = 1 TO OS.LastRow() DO
      RetCode = CALLPROC FMS_OperatingStepDel(
                 Card          = OS[i].Card,
                 OperatingStep = OS[i].OperatingStep,
                 StartTime     = OS[i].StartTime);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error removing Operating Step.  ' +
              'Tech Support should be contacted to review your ' +
              'machine trace log.';
         CALLPROC TraceError (UserMessage = '',
              TraceMessage = 'Class:OperatingStep_ASE;Method:SetABFStep; ' +
              'Unable to remove operatingstep:' + VARCHAR(OS[i].OperatingStep) + 
              ' for card:' + VARCHAR(OS[i].Card)
              );   
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDFOR;

   RETURN;
END;

METHOD ClearABFStep (
)=
DECLARE
   ABFExists = INTEGER NOT NULL WITH DEFAULT; /* Current OpStep is ABF */
   ISOCount = INTEGER NOT NULL WITH DEFAULT;  /* # of Isolation Moves */
   STAMove = INTEGER NOT NULL WITH DEFAULT;   /* StationGround Move Outstanding */
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to determine which Operating Step
** the feeder should be in when clearing the ABF step.
** We can assume the Feeder is CutOut/Out of Service, ABF/DBF check
** only happens after cutout.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   IF CurObject.SO.Object = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ClearABFStep OperatingStep_ASE Method was called ' +
                               'with no Card parameter.  This a programming error ' +
                               'that must be corrected.  Contact Tech Support.';
      RETURN;
   ENDIF;
/*
** Make sure ABF operating exists, no need to do anything
*/
   ABFExists = 0;
   SELECT :ABFExists = COUNT(*)
   FROM   FMS_OperatingStepStatus OS
   WHERE  OS.Card = :CurObject.SO.Object AND
          OS.OperatingStep = :Type$ABF AND
          OS.EndTime = '';
   IF ABFExists = 0 THEN
      RETURN;
   ELSE
/*
**  This step must be cleared because SetOpStep will ignore any steps 
**  if current operating step is ABF.
*/
      CurObject.OpStep = Type$ABF;
      CurObject.ClearOpStep();
   ENDIF;
/*
** Count number of outstanding isolation moves.
*/
   CurObject.ReturnCount = 0;
   ISOCount = 0;
   CurObject.CountIsolationMoves();
   ISOCount = CurObject.ReturnCount;
/*
** Is Station Ground move outstanding?
*/
   CurObject.ReturnCount = 0;
   STAMove = 0;
   CurObject.CheckOutstandingSTA();
   STAMove = CurObject.ReturnCount;
/*
** Set Operating Step based on ISOCount and STAMove values.
*/
   IF ISOCount > 0 AND STAMove <> 0 THEN
      CurObject.OpStep = Type$ISTA;
      CurObject.SetOpStep();
   ELSEIF ISOCount > 0 AND STAMove = 0 THEN
      CurObject.OpStep = Type$ISOStep;
      CurObject.SetOpStep();
   ELSEIF ISOCount = 0 AND STAMove <> 0 THEN
      CurObject.OpStep = Type$STA;
      CurObject.SetOpStep();
   ELSEIF ISOCount = 0 AND STAMove = 0 THEN
      CurObject.OpStep = Type$ABF;
      CurObject.ClearOpStep();
   ENDIF;

   IF CurObject.ReturnCode <> 0 THEN
      CALLPROC TraceError (UserMessage = CurObject.ErrorMessage,
               TraceMessage =
                'Method:ClearABFStep; ' +
                'Error clearing operating step ABF when feeder marked Dead. ' +
                'Card=' + VARCHAR(CurObject.SO.Object) 
               );

   ENDIF;

   RETURN;
END;

METHOD CheckPFSSet (
)=
DECLARE
   i       = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to see if feeder should go into FG
** OperatingStep instead of PFS.  If there are field grounds we 
** will go into FG instead of PFS.
*/
   /* 
   **  See how many ground are on Feeder.
   */
   i = 0;
   SELECT :i = GroundsOn
   FROM   FMS_Card
   WHERE  Card = :CurObject.SO.Object;
          
   IF i > 1 THEN
      /*
      **  Change OpStep from PFS to FG.   
      */      
      CurObject.OpStep      = Type$FG; /* FG Operating Step */
      RETURN 0;
   ENDIF;
/*
** If Setting PFSS make sure station is Type$Substation. Area substations
** should set PFSF.
*/
   IF CurObject.OpStep = Type$PFSS THEN
      i = 0;
      SELECT :i = COUNT(*) 
      FROM   Udb_Grouping G
      WHERE  G.Member = :CurObject.SO.Type AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Substation;
      IF i = 0 THEN
         /*
         ** Change OpStep from PFSS to PFSF since regular station wasn't found.
         */
         CurObject.OpStep = Type$PFSF;
         RETURN 0;
      ENDIF;
   ENDIF;
   /*
   **  When setting PFS we need to look at outstanding jobs and set TEST if only 
   **  Test moves have been issued.
   **  SetPFSNow = 0; Send event back to AutomationMonitor or Feedercard to 
   **                 trigger after all moves are completed.
   **  SetPFSNow = 1; Look for outstanding DeEnergize moves, set TEST if none.
   **  SetPFSNow = 2; Completing move that sets PFSS.  Just set it.  May also 
   **                 be called from PromptProcFromWork or DCCMoveReturn.
   */
   IF CurObject.OpStep = Type$PFSS AND
      CurObject.SetPFSNow = 1 THEN   /* TRUE or 1 */

      i = 0;
      SELECT :i = COUNT(*) 
      FROM    SOA_Job J,
              SOA_JobControl JC
      WHERE   JC.Card = :CurObject.SO.Object AND
              JC.StepPair = :StepPair$DeEnergize AND
              JC.Job = J.Job AND
             (J.RSIssued IS NOT NULL AND
              J.RSIssued <> '' AND
              J.RSComplete IS NULL);
      IF i = 0 THEN
         /*
         **  No Energize moves have been issued.  Before
         **  setting TEST make sure there still are outstanding
         **  Test moves.
         */
         SELECT :i = COUNT(*) 
         FROM    SOA_Job J,
                 SOA_JobControl JC
         WHERE   JC.Card = :CurObject.SO.Object AND
                 JC.StepPair = :StepHeading$Test AND
                 JC.Job = J.Job AND
                (J.RSIssued IS NOT NULL AND
                 J.RSIssued <> '' AND
                 J.RSComplete IS NULL);
         IF i <> 0 THEN
            CurObject.OpStep = Type$TEST;
         ENDIF;
      ENDIF;
   ELSEIF CurObject.SetPFSNow = 2 THEN
      RETURN 0;
   ELSEIF CurObject.OpStep = Type$PFSS THEN
      /*
      **  Delay checking of PFSS until after all move have been issued.
      */
      RETURN 1;                      
   ENDIF;
   
   RETURN 0;
END;

METHOD StartTimeUpd (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;

   FirstJobIssueTime = DATE NOT NULL WITH DEFAULT;

   ErrorMsg          = VARCHAR(500) NOT NULL WITH DEFAULT;
   OldStartTime      = DATE NOT NULL WITH DEFAULT;

   PrevOperatingStep = INTEGER NOT NULL;
   PrevStartTime     = DATE NOT NULL WITH DEFAULT;
   PrevEndTime       = DATE NOT NULL WITH DEFAULT;
   
   StepExists        = INTEGER NOT NULL WITH DEFAULT;
   TOIssued          = DATE WITH DEFAULT;
   RSIssued          = DATE WITH DEFAULT;
   TORS              = INTEGER NOT NULL WITH DEFAULT;
   Retcode           = integer not null,
   SortedSteps       = ARRAY OF OrderOpStepClass;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update the starttime of an operating
** step. If call fails because new start time is greater than 
** endtime we will log message.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.OrderNumber <= 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Class:OperatingStep_ASE;Method:StartTimeUpd; ' +
          'A valid ordernumber was not into method.';
      RETURN;
   ENDIF;

   SELECT :CurObject.SO.Object = C.Card,
          :CurObject.SO.Name = C.CardClassName,
          :CurObject.SO.Type = C.Feeder,
          :CurObject.SO.TypeName = C.FeederName
   FROM   FMS_Card C,
          IR_OperatingOrder O
   WHERE  O.OrderNumber = :CurObject.OrderNumber AND
          O.Card = C.Card;

   SELECT :TORS = OJ.TORS,
          :TOIssued = J.TOIssued,
          :RSIssued = J.RSIssued
   FROM   IR_OpOrderJobs OJ,
          SOA_Job J
   WHERE  OJ.OrderNumber = :CurObject.OrderNumber AND
          OJ.Seq = 1 AND
          OJ.Job = J.Job;

   IF TORS = 0 THEN                      /* TakeOut */
      FirstJobIssueTime = IFNULL(TOIssued,'');
   ELSE                                  /* Restore */
      FirstJobIssueTime = IFNULL(RSIssued,'');
   ENDIF;

/*
** get the returned start times for the order's operating steps.
*/
   i = 1;
   SELECT :SortedSteps[i].OperatingStep = OperatingStep,
          :SortedSteps[i].StartTime = StartTime
   FROM   IR_OpOrderSteps
   WHERE  OrderNumber = :CurObject.OrderNumber AND
          Type = 'NEW' AND
          StartTime <> ''
   ORDER By StartTime ASC
   BEGIN
      i = i + 1;
   END;

   CALLPROC DDB_ROLLBACK;

/*
** We have to start from the first operating step and work forward to the last step
** in order to avoid a negative duration when we adjust the start time of a step. The 
** reason is that we will shift the start time to the past.
** here is logic: 
** If the step already exists, we update its start time and then move the end time of 
** the previous operating step.
** If the step doesn't exist, we move the end time of the previous operating step and 
** then insert the new step. 
*/      
   FOR i = 1 TO SortedSteps.LastRow() DO
    
      ErrorMsg = '';

      /* check if the operating step already exists in the table */
      StepExists = 0;
      OldStartTime = '';

      SELECT :StepExists = 1,
             :OldStartTime = OS.StartTime
      FROM   FMS_OperatingStepStatus OS
      WHERE  OS.Card = :CurObject.SO.Object AND
             OS.OperatingStep = :SortedSteps[i].OperatingStep AND
             OS.StartTime >= :FirstJobIssueTime;
       
      IF StepExists = 1 THEN  

         /* update the start time */
         RetCode = CALLPROC FMS_OperatingStartUpd ( 
                            Card = CurObject.SO.Object,
                            OperatingStep = SortedSteps[i].OperatingStep,
                            StartTime = SortedSteps[i].StartTime,
                            Old_StartTime = OldStartTime);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            ErrorMsg = 'Message for order '+ VARCHAR(CurObject.OrderNumber) + 
                      '. Failed to update operating step ' + VARCHAR(PrevOperatingStep) + 
                      ' with StartTime ' + VARCHAR(SortedSteps[i].StartTime);

         ELSEIF RetCode = 1 THEN
            /* insert a transaction log */
            CALLPROC SOA_LogIns (Card = CurObject.SO.Object,
                                 Job = NULL,
                             	 Item = 'Validation Error',
                             	 Old = 'Op Step StartTime Not Updated From: ' + 
                                       VARCHAR(OldStartTime),
                             	 New = 'To: ' + VARCHAR(SortedSteps[i].StartTime),
                                 Time = Date('now'),
                                 UserName = 'SSO Interface'); 
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ELSE 
         /* 
         ** this secenario should not happen before the Operating Step enhancement, 
         ** we will try to handle it here. 
         */

         PrevOperatingStep = 0;
         SELECT :PrevOperatingStep = OS.OperatingStep,
                :PrevStartTime = OS.StartTime,
                :PrevEndTime = OS.EndTime
         FROM   FMS_OperatingStepStatus OS
         WHERE  OS.Card = :CurObject.SO.Object AND
                OS.OperatingStep <> :Type$OperatingStepCount AND
	        OS.StartTime = (SELECT MAX(StartTime)
	                        FROM   FMS_OperatingStepStatus OS2,
	                               Udb_SuperType S
	                        WHERE  OS2.Card = :CurObject.SO.Object AND
                                       OS2.StartTime < :SortedSteps[i].StartTime AND
	                               OS2.OperatingStep <> :Type$OperatingStepCount AND
	                               OS2.OperatingStep = S.Type AND
	                               S.SuperType = :Type$OperatingStepStatus);
         CALLPROC DDB_ROLLBACK;

         IF PrevOperatingStep <> 0 AND PrevEndTime <> '' THEN
	    /* 
            ** update the previous operating step's end time 
            */	       

            RetCode = CALLPROC FMS_OpStepEndTimeUpd ( 
                                Card = CurObject.SO.Object,
                                OperatingStep = PrevOperatingStep,
                                StartTime = PrevStartTime,
                                EndTime = SortedSteps[i].StartTime);

      	    IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               ErrorMsg = 'Message for order '+ VARCHAR(CurObject.OrderNumber) + 
                      '. Failed to set EndTime to ' + VARCHAR(SortedSteps[i].StartTime) +
                      ' for operating step ' + VARCHAR(PrevOperatingStep);
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;

         CurObject.StartTime  = SortedSteps[i].StartTime;
         CurObject.OpStep     = SortedSteps[i].OperatingStep;

         /* insert a new operating step */
         CurObject.SetOpStep();
   
         IF CurObject.ReturnCode <> 0 THEN
            ErrorMsg = 'Message for order '+ VARCHAR(CurObject.OrderNumber) + 
                      '. Failed to set insert operating step ' + VARCHAR(PrevOperatingStep) + 
                      ' with StartTime ' + VARCHAR(SortedSteps[i].StartTime);
         ENDIF; 
      ENDIF;

      IF ErrorMsg <> '' THEN
         CALLPROC TraceError (UserMessage = ErrorMsg,
                              TraceMessage  = VARCHAR(DATE('now')) + ': ' +  ErrorMsg);
      ENDIF;

   ENDFOR;

   RETURN;
END;

