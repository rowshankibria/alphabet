END;

ON CLICK Tracking.Selected.Track_Btn =
DECLARE
    n = INTEGER NOT NULL WITH DEFAULT;
    CurNode	= TreeNode;
    CurTypeObj = ObjectSummaryClass; 
ENDDECLARE
BEGIN
   CurNode = TV.CurNode;

   IF CurNode IS NULL THEN
      MESSAGE 'Please Select a udb equipment Type.';
      RESUME;
   ENDIF;

   CurTypeObj = ObjectSummaryClass(CurNode.ClientData);
   IF CurTypeObj.Terminal = 1 THEN /* Delete */
      SELECT :N = COUNT(*) 
      FROM    SOA_OutageSummary
      WHERE   Type IN (SELECT Type
                       FROM   Udb_ExtendedType
                       WHERE  SuperType = :CurTypeObj.Type);
      IF N <> 0 THEN
         Message 'There are currently rows in ' +
                 'the SOA_OutageSummary table related to the equipment type(s) ' +
                 'you are attempting to remove from tracking.  Please issue the ' +
                 'following command to remove the rows from the SOA_OutageSummary table.' + 
                 HC_NEWLINE + HC_NEWLINE +
                 'delete from soa_outagesummary ' + HC_NEWLINE +
                 'where type in (select type' + HC_NEWLINE +
                 '               FROM   Udb_ExtendedType ' + HC_NEWLINE +
                 '               WHERE  SuperType = ' + varchar(CurTypeObj.Type) + ' );';
         RESUME;
      ENDIF;
      RetCode = CALLPROC SOA_OutageEquipTypeDel (Type = CurTypeObj.Type);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Error occurred while deleting the Target Type.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;

      n = CurTypeObj.BaseType; 	/* index of parent node */
      IF n = 0 THEN			/* CurNode is the root */
         CurTypeObj.Terminal = 0;
      ELSE
          IF ObjectSummaryClass(TVNodes[n].ClientData).Terminal = 0 THEN
             CurTypeObj.Terminal = 0;		/* NOT DEFINED */
          ELSE
             CurTypeObj.Terminal = 2;           /* INHERITATED */
             CurTypeObj.PrimaryGrouping = ObjectSummaryClass(TVNodes[n].ClientData).PrimaryGrouping;
             CurTypeObj.PrimaryGroupingName = ObjectSummaryClass(TVNodes[n].ClientData).PrimaryGroupingName;
          ENDIF;
       ENDIF;
   ELSE  /* Insert */
      RetCode = CALLPROC SOA_OutageEquipTypeIns(Type = CurTypeObj.Type);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Error occurred while inserting the Target type.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;

      CurTypeObj.Terminal = 1;
   
   ENDIF;

   HasChanged = TRUE;
/* 
** update subtree
*/
   CALLPROC UpdateSubTreeMapping (ParentNode = CurNode,
                                  RRMapFlag = CurTypeObj.Terminal,
                                  RRValue = CurTypeObj.PrimaryGrouping,
                                  RRName = CurTypeObj.PrimaryGroupingName);
   CurNode.IsSelected = TRUE;
END;

/*
** Procedure: AddTypeNode
**
** Attributes of the node's client data object:
**   BaseType: A super type (parent)'s index in the TVNodes array
**   Type, Name: a type's id and name
**   TypeName: a type's description
**   PrimaryGrouping, Primarygroupingname: the corresponding rr type and name
**   Object: a type's index in the TVNodes array
**   terminal: the translation flag: 1 - direct map, 2 - inherited from the parent. 0 - not defined. 
*/
PROCEDURE AddTypeNode
(
    TypeTree	= Tree,
    TypeObject	= ObjectSummaryClass,
    ParentNode	= TreeNode
) =
DECLARE
    CurTypeNode	= TreeNode;
    i		= integer not null;
    n		= integer not null;
    NodeText	= varchar(255) not null;
ENDDECLARE
{
   NodeText = TypeObject.Name + ' (' + TypeObject.TypeName + ')';

   CurTypeNode = TypeTree.AddNode(
        Name		= NodeText;
        Relative	= ParentNode,
        Relation	= TN_LASTCHILD);

   IF (CurTypeNode IS NULL) THEN
      Message 'The AddNode method failed.';
      RETURN NULL;
   ENDIF;

   /* Determine the color of mapping icon 
   */
   IF ShowTracking = 1 THEN
      CALLPROC SetMappingIcon(TypeObject = BYREF(TypeObject),
                              CurNode = BYREF(CurTypeNode));
   ENDIF;

   /* save data */
   CurTypeNode.ClientData = TypeObject;
   CurTypeNode.HasChildren = TRUE;
   CurTypeNode.IsExpanded = FALSE;
   CurTypeNode.IsVisible = TRUE;

   RETURN CurTypeNode;
}

PROCEDURE ExpandTreeNode (
   ParentNode = TreeNode;
) = 
DECLARE
    i  = INTEGER NOT NULL WITH DEFAULT;
    j  = INTEGER NOT NULL WITH DEFAULT;
    CurTypeObj = ObjectSummaryClass;
ENDDECLARE
{
    IF ParentNode.Children = 0 THEN
       TypeASE.Type = ObjectSummaryClass(ParentNode.ClientData).Type;
       TypeASE.GetChildren();

       FOR i = 1 To TypeASE.CList.LastRow() DO
          j = TVNodes.LastRow() + 1;
          CurTypeObj.BaseType = ObjectSummaryClass(ParentNode.ClientData).Object;
          CurTypeObj.Name = TypeASE.CList[i].Name;
          CurTypeObj.TypeName = TypeASE.CList[i].Description;
          CurTypeObj.Type = TypeASE.CList[i].Type;
          CurTypeObj.Object = j;

          /* Find direct RR mapping */
          IF ShowTracking = 1 THEN
             CALLPROC GetDirectMapping(TypeObject = BYREF(CurTypeObj));
          ENDIF;

          TVNodes[j] = CALLPROC AddTypeNode 
                                 ( TypeTree = TV.Tree,
                                   TypeObject = CurTypeObj.Duplicate(),
                                   ParentNode = ParentNode);
       ENDFOR;
       CALLPROC DDB_ROLLBACK;
  
       IF TypeASE.CList.LastRow = 0 THEN
          ParentNode.HasChildren = FALSE;
       ENDIF;
    ENDIF;
}

PROCEDURE FindNextMatch() =
DECLARE
    i		= integer not null with default;
    j		= integer not null with default;
    CurTypeNode	= TreeNode;
    TypeTree	= Tree,
    TypeObject	= ObjectSummaryClass,
    AncestorList = ARRAY OF TypeClass;
    AncestorNode = TreeNode default null;
    AncestorIdx  = integer not null with default;
ENDDECLARE
{
/*
** Treat the match list as a circular list.
*/
   NextMatchIdx = NextMatchIdx + 1;
   IF NextMatchIdx > MatchList.LastRow THEN
      NextMatchIdx = 1;
   ENDIF;
/*
** Let's see if the match is already on the tree. If so, we just make it visible.
*/
   FOR i = 1 TO TVNodes.LastRow() DO
      IF MatchList[NextMatchIdx].Type = ObjectSummaryClass(TVNodes[i].ClientData).Type THEN
         TVNodes[i].IsSelected = TRUE;
         TVNodes[i].IsVisible = TRUE;
         RETURN;
      ENDIF; 
   ENDFOR;
/*
** The match is not on the tree. We need to get a list of its ancestors to
** a tree path.
*/
   IF TypeASE IS NULL THEN
      TypeASE = TypeClass_ASE.Create();
   ENDIF;
   
   TypeASE.Type = MatchList[NextMatchIdx].Type;
   TypeASE.GetSuperTypes(RootType = SearchRootType);
   AncestorList = TypeASE.CList.Duplicate();

   IF AncestorList.LastRow = 1 THEN
      MESSAGE MatchList[NextMatchIdx].Name + ' matches the search string. ' + 
              'But it is not defined in the type hierarchy. ' + 
              'You can continue to find the next match or contact FMS Administrator.';
      RETURN;
   ENDIF;
/*
** find the most close ancestor on the tree. note: the first element in the
** ancestor list is the match type itself.
*/
   FOR i = 2 to AncestorList.LastRow DO
      FOR j = TVNodes.LastRow DOWNTO 1 DO
         IF AncestorList[i].Type = ObjectSummaryClass(TVNodes[j].ClientData).Type THEN
            AncestorNode = TVNodes[j];
            AncestorIdx = i;
            ENDLOOP;
         ENDIF;
      ENDFOR;
      IF AncestorNode IS NOT NULL THEN
         ENDLOOP;
      ENDIF;
   ENDFOR;

   IF AncestorNode IS NULL THEN
      /*
      ** THIS SHOULD NOT HAPPEN. BUT IF IT DOES, QUIT.
      */
      MESSAGE 'Failed to locate the parent node for the matched type.';
      RETURN;
   ENDIF;
/*
** We need to expand the tree starting from AncestorNode to the matched type.
*/
   FOR i = AncestorIdx DOWNTO 2 DO
      IF i <> AncestorIdx THEN
         AncestorNode = NULL;
         FOR j = TVNodes.LastRow DOWNTO 1 DO
            IF AncestorList[i].Type = ObjectSummaryClass(TVNodes[j].ClientData).Type THEN
               AncestorNode = TVNodes[j];
               ENDLOOP;
            ENDIF;
         ENDFOR;

         IF AncestorNode IS NULL THEN
            MESSAGE 'Failed to locate the parent node for the matched type.';
            RETURN;
         ENDIF;    
      ENDIF; 

      CALLPROC ExpandTreeNode(ParentNode = AncestorNode);
   ENDFOR; 
/*
** Show the matched type
*/
   FOR j = TVNodes.LastRow DOWNTO 1 DO
      IF MatchList[NextMatchIdx].Type = ObjectSummaryClass(TVNodes[j].ClientData).Type THEN
         TVNodes[j].IsSelected = TRUE;
         TVNodes[j].IsVisible = TRUE;
         RETURN;
      ENDIF;
   ENDFOR;  
}

/* ================================================================================
** The following procedures are for processing UDB-RR type mapping.
** ================================================================================ */
PROCEDURE UpdateSubTreeMapping
(
    ParentNode	= TreeNode,
    RRMapFlag     = INTEGER NOT NULL WITH DEFAULT;
    RRValue       = INTEGER NOT NULL WITH DEFAULT;
    RRName        = VARCHAR(80) NOT NULL WITH DEFAULT;
) =
DECLARE
    i		= integer not null;
    n		= integer not null;
    NodeText	= varchar(255) not null;
    CurTypeObj	= ObjectSummaryClass,
    SubRRMapFlag     = INTEGER NOT NULL WITH DEFAULT;
    CurTypeNode	= TreeNode;
ENDDECLARE
{
   CurTypeObj = ObjectSummaryClass(ParentNode.ClientData);   
   CurTypeObj.Terminal = RRMapFlag;
   CurTypeObj.PrimaryGrouping = RRValue;
   CurTypeObj.PrimaryGroupingName = RRName;

   NodeText = CurTypeObj.Name + ' (' + CurTypeObj.TypeName + ')';

   IF CurTypeObj.Terminal = 1 THEN		/* DIRECTLY MAPPED */
       NodeText = NodeText + ' --> ' + CurTypeObj.PrimaryGroupingName;
       ParentNode.BmpLblIndx  = BlueIdx; 
       ParentNode.SelBmpLblIndx = BlueIdx; 

       SubRRMapFlag = 2;

   ELSEIF CurTypeObj.Terminal = 2 THEN		/* INHERITATED */
       ParentNode.BmpLblIndx    = GrayIdx; 
       ParentNode.SelBmpLblIndx = GrayIdx; 

       SubRRMapFlag = 2;

   ELSE
       ParentNode.BmpLblIndx = RedIdx;
       ParentNode.SelBmpLblIndx = RedIdx;

       SubRRMapFlag = 0;
   ENDIF;

   ParentNode.TextLabel = NodeText;
   ParentNode.IsSelected = TRUE;   
/* 
** update subtree
*/
   CurTypeNode = ParentNode.FirstChild;
   WHILE CurTypeNode IS NOT NULL DO
      IF ObjectSummaryClass(CurTypeNode.ClientData).Terminal <> 1 THEN
         CALLPROC UpdateSubTreeMapping (ParentNode = CurTypeNode,
                                        RRMapFlag = SubRRMapFlag,
                                        RRValue = RRValue,
                                        RRName = RRName);
      ENDIF;
      CurTypeNode = CurTypeNode.NextSibling;
   ENDWHILE;
}

PROCEDURE SetupBitmaps() =
DECLARE
    i		= integer not null;
    io		= integerobject default NULL;
    ios		= integerobject default NULL;
    k		= integer not null;
ENDDECLARE
{
    TV.Imagelist.clear();

    IF ShowTracking = 1 THEN
       TV.Imagelist[1] = field(tracking.legend.red_bmp).image.Duplicate();
       TV.Imagelist[2] = field(tracking.legend.gray_bmp).image.Duplicate();
       TV.Imagelist[3] = field(tracking.legend.blue_bmp).image.Duplicate();

       RedIdx = 1;
       GrayIdx = 2;
       BlueIdx = 3;
    ENDIF;

//    STACKFIELD(FIELD(gray_bmp).ParentField).AllBias = FB_INVISIBLE;
}  

PROCEDURE GetDirectMapping(
    TypeObject = ObjectSummaryClass;
) = 
DECLARE
    i		= integer not null;
ENDDECLARE
{
   /* get the direct mapping 
   */
   TypeObject.PrimaryGrouping = 0; 
   TypeObject.PrimaryGroupingName = '';
   TypeObject.Terminal = 0;
   i = 1;
   WHILE i <= TypeTranslation.LastRow() DO
      IF TypeObject.Type = TypeTranslation[i].BaseType THEN
         TypeObject.PrimaryGrouping = TypeTranslation[i].Type;
         TypeObject.PrimaryGroupingName = TypeTranslation[i].Name;
         TypeObject.Terminal = 1;				/* 1: direct, 2-inherited */
         ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;       
}

PROCEDURE SetMappingIcon(
    TypeObject	= ObjectSummaryClass,
    CurNode	= TreeNode;
) = 
DECLARE
    n	= integer not null;
ENDDECLARE
{
   IF TypeObject.Terminal = 0 THEN		
      n = TypeObject.BaseType; 	/* index of parent node */
      IF n = 0 THEN			/* CurTypeNode is the root */
         TypeObject.Terminal = 0;
      ELSE
         IF ObjectSummaryClass(TVNodes[n].ClientData).Terminal = 0 THEN
            TypeObject.Terminal = 0;		/* NOT DEFINED */
         ELSE
            TypeObject.Terminal = 2;      /* INHERITATED */
            TypeObject.PrimaryGrouping = ObjectSummaryClass(TVNodes[n].ClientData).PrimaryGrouping;
            TypeObject.PrimaryGroupingName = ObjectSummaryClass(TVNodes[n].ClientData).PrimaryGroupingName;
         ENDIF;
      ENDIF;
   ENDIF;

   IF TypeObject.Terminal = 1 THEN		   /* DIRECTLY MAPPED */
      CurNode.BmpLblIndx	 = BlueIdx; 
      CurNode.SelBmpLblIndx = BlueIdx; 
   ELSEIF TypeObject.Terminal = 2 THEN		/* INHERITATED */
      CurNode.BmpLblIndx	 = GrayIdx; 
      CurNode.SelBmpLblIndx = GrayIdx; 
   ELSE
      CurNode.BmpLblIndx	 = RedIdx; 
      CurNode.SelBmpLblIndx = RedIdx; 
   ENDIF;
   
   RETURN;
}

