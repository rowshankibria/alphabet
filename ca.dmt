/*===============================================================================================
** internal procedures
**===============================================================================================
*/
PROCEDURE ShowSWPReports(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CutOffReturnTime = DATE NOT NULL;
   LocalDivisions = VARCHAR(100) NOT NULL WITH DEFAULT;
   Now = DATE NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1024) NOT NULL WITH DEFAULT;
   SubstationFilter = VARCHAR(100) NOT NULL WITH DEFAULT;
   SubstationID = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** Filter out requests whose scheduled return date is more than two weeks old
** Note: make sure the number of days used here is the same as in SOA_Main
*/
   SELECT :CutOffReturnTime = DATE('NOW') - '14 Days';
/* 
** Load Array of Permits for Display
*/
   CurrentRow = 0;
   swp_tf.Clear();
   SWP_TF.Clear();

   Div_Title = 'Outage Requests for Division "' +  
      field(menu.division_list.division).CurEnumText + '"'; 
   FIELD(div_title).ParentField.CurBias = FB_CHANGEABLE;
   
   /* Effective Divisions Only */ 
   FOR i = 1 TO EffectiveDivisions.LastRow() DO
      IF i = 1 THEN
         LocalDivisions = VARCHAR(EffectiveDivisions[i].Object);
      ELSE
         LocalDivisions = LocalDivisions + ', ' + VARCHAR(EffectiveDivisions[i].Object);
      ENDIF;
   ENDFOR;
   LocalDivisions = '(' + LocalDivisions + ')';
   
   // Only imported and active
   DynamicWhereClause = ' R.Status >= ' + VARCHAR(Order$Opened) + 
                        ' AND R.Status < ' + VARCHAR(Order$Closed) + 
                        ' AND (R.SkedReturnDate IS NULL OR R.SkedReturnDate > ''' + VARCHAR(CutOffReturnTime) + ''')' + 
                        ' AND R.ORNumber = W.ORNumber ';
                           
   // filter by division and substations
   IF FilterByDivision = 1 THEN
      IF field(menu.division_list.division).CurEnumValue = 1 THEN 
         DynamicWhereClause = DynamicWhereClause + ' AND W.Division IN ' + LocalDivisions;

      ELSEIF field(menu.division_list.division).CurEnumValue > 2 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND W.Division = ' + 
               VARCHAR(field(menu.division_list.division).CurEnumValue);
      ENDIF;

      IF MappingOption = 1 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND W.Substation > 0';
      ELSE
         DynamicWhereClause = DynamicWhereClause + ' AND W.Substation = 0';
      ENDIF;
   ELSE
      // by default, always filter to the local divisions.
      DynamicWhereClause = DynamicWhereClause + ' AND W.Division IN ' + LocalDivisions;
      
      IF CurrentApplication = Application$FMS THEN
         IF FMSCard IS NOT NULL THEN
            SELECT :SubstationID = PrimaryGrouping
            FROM UDB_Object
            WHERE Object = :FMSCard.Object[1].Object;
            
            SubstationFilter = '(' + VARCHAR(SubstationID) + ')';
         ENDIF;
      ELSEIF CurrentApplication = Application$TFMS THEN
         IF TFMSCard IS NOT NULL THEN
            IF TFMSCard.Status = Card$Closed THEN
               SELECT :SubstationID = Object
               FROM   TFMS_ArchiveCardToObject
               WHERE  Card = :TFMSCard.Card AND
                      Status = 0
               BEGIN
                  IF SubstationFilter <> '' THEN
                     SubstationFilter = SubstationFilter + ',';
                  ENDIF;
                  SubstationFilter =  SubstationFilter + VARCHAR(SubstationID);
               END;
            ELSE
               SELECT :SubstationID = Object
               FROM   TFMS_CardToObject
               WHERE  Card = :TFMSCard.Card AND
                      Status = 0
               BEGIN
                  IF SubstationFilter <> '' THEN
                     SubstationFilter = SubstationFilter + ',';
                  ENDIF;
                  SubstationFilter =  SubstationFilter + VARCHAR(SubstationID);
               END;
            ENDIF;
            IF SubstationFilter <> '' THEN
               SubstationFilter = '(' + SubstationFilter + ')';
            ENDIF;
         ENDIF;
      ELSEIF CurrentApplication = Application$SLC THEN
         IF SLCCard IS NOT NULL THEN
            IF SLCCard.MultipleKVFlag = FALSE THEN
               SubstationFilter = '(' + VARCHAR(SLCCard.Substation) + ')';
            ELSE
               SELECT :SubstationID = Member
               FROM   UDB_Grouping G,
                      Udb_ExtendedType ET
               WHERE  G.Grouping = :SLCCard.Substation AND
                      G.RelationShip = :Interaction$MemberOf AND
                      G.MemberType = ET.Type AND
                      ET.SuperType = :Type$Substation
               BEGIN
                  IF SubstationFilter <> '' THEN
                     SubstationFilter = SubstationFilter + ',';
                  ENDIF;
                  SubstationFilter =  SubstationFilter + VARCHAR(SubstationID);
               END;
               SubstationFilter = '(' + SubstationFilter + ')';
            ENDIF;
         ENDIF;
      ENDIF;
      CALLPROC DDB_ROLLBACK;

      IF MappingOption = 1 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND W.Substation > 0';
         IF SubstationFilter <> '' THEN
            DynamicWhereClause = DynamicWhereClause + ' AND W.Substation IN ' + SubstationFilter;
         ENDIF;
      ELSE
         DynamicWhereClause = DynamicWhereClause + ' AND W.Substation = 0';
      ENDIF;
   ENDIF;
      
   // Different queries for Distribution and TOMS
   IF CurrentApplication = Application$FMS THEN
      DynamicWhereClause = DynamicWhereClause + ' AND UPPER(Jurisdiction) = ' + '''' + 'DISTRIBUTION' + ''''; 
      i = 1;
      SELECT DISTINCT 
            :SWP_TF[i].Division       = W.Division,  
            :SWP_TF[i].ORNumber      = R.ORNumber,
            :SWP_TF[i].Title      = R.Title,
            :SWP_TF[i].Instruction = R.Instruction,
            :SWP_TF[i].Status         = R.Status,
            :SWP_TF[i].OSSStatus      = R.OSSStatus,
            :SWP_TF[i].Location       = R.Location,
            :SWP_TF[i].SkedOutageDate = R.SkedOutageDate,
            :SWP_TF[i].SkedStartDate  = R.SkedStartDate,
            :SWP_TF[i].SkedReturnDate = R.SkedReturnDate,
            :SWP_TF[i].CurrentStatus   = R.CurrentStatus
      FROM  SOA_OutageRequest R,
            SOA_ORWorkItem W
      WHERE  :DynamicWhereClause
      ORDER BY SkedOutageDate, Division
      BEGIN
         i = i + 1;
      END;
   ELSE
      DynamicWhereClause = DynamicWhereClause + ' AND UPPER(Jurisdiction) <> ' + '''' + 'DISTRIBUTION' + ''''; 
      i = 1;
      SELECT DISTINCT 
            :SWP_TF[i].Division       = W.Division,  
            :SWP_TF[i].ORNumber       = R.ORNumber,
            :SWP_TF[i].Title      = R.Title,
            :SWP_TF[i].Status         = R.Status,
            :SWP_TF[i].OSSStatus      = R.OSSStatus,
            :SWP_TF[i].Location       = R.Location,
            :SWP_TF[i].SkedOutageDate = R.SkedOutageDate,
            :SWP_TF[i].SkedStartDate  = R.SkedStartDate,
            :SWP_TF[i].SkedReturnDate = R.SkedReturnDate,
            :SWP_TF[i].Instruction     = R.Instruction,
            :SWP_TF[i].CurrentStatus   = R.CurrentStatus
      FROM  SOA_OutageRequest R,
            SOA_ORWorkItem W
      WHERE  :DynamicWhereClause
      ORDER BY SkedOutageDate, Division
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   Now = DATE('NOW');
   
   FOR i = 1 TO SWP_TF.LastRow DO
      IF SWP_TF[i].OSSStatus = 'AS' THEN
         SWP_TF[i].OSSStatus = 'Apprvd & Sched';
      ELSEIF SWP_TF[i].OSSStatus = 'APPROVED - ND' THEN
         SWP_TF[i].OSSStatus = 'Apprd - New Date';
      ENDIF;
   ENDFOR;   
     
/*   FIELD(Delay_Btn).CurBias = FB_DIMMED; */
   FIELD(LoadCard_Btn).CurBias = FB_DIMMED;
END;

PROCEDURE HighlightSWP(
   SelectRow = INTEGER NOT NULL WITH DEFAULT
) = 
BEGIN
   FOR i = 1 TO SWP_TF.LastRow() DO
      IF SelectRow = i THEN
         FIELD(SWP_TF[i].ORNumber).IsReverse = TRUE;
         FIELD(SWP_TF[i].OSSStatus).IsReverse = TRUE;
         FIELD(SWP_TF[i].CurrentStatus).IsReverse = TRUE;
         FIELD(SWP_TF[i].Title).IsReverse = TRUE;
         FIELD(SWP_TF[i].SkedOutageDate).IsReverse = TRUE;
         FIELD(SWP_TF[i].SkedStartDate).IsReverse = TRUE;         
      ELSE 
         FIELD(SWP_TF[i].ORNumber).IsReverse = FALSE;
         FIELD(SWP_TF[i].OSSStatus).IsReverse = FALSE;
         FIELD(SWP_TF[i].CurrentStatus).IsReverse = FALSE;
         FIELD(SWP_TF[i].Title).IsReverse = FALSE;
         FIELD(SWP_TF[i].SkedOutageDate).IsReverse = FALSE;
         FIELD(SWP_TF[i].SkedStartDate).IsReverse = FALSE;         
      ENDIF;
   ENDFOR; 
   
   IF SelectRow > 0 THEN
/*      FIELD(Delay_Btn).CurBias = FB_LANDABLE; */
   ENDIF;
END;

PROCEDURE UpdateSWPStatus(
) =
DECLARE
   ORStack = StackField;
ENDDECLARE
BEGIN
   SWP.UpdateAfterNewPermit();
   
   IF SWP.ReturnCode <> 0 THEN
      MESSAGE SWP.ErrorMessage;
   ENDIF;
   
   SWP_TF[CurrentRow] = SWP;
   FIELD(SWP_TF).UpdField();   
   
   /*
   ORList[ORIdx].WIList[WIIdx] = WorkItem;
   ORStack = Curframe.TopForm.FieldByFullName(fullname = 'ORSF_' + varchar(ORIdx) );
   ORStack.SetFieldValue(Value = byref(ORList[ORIdx]));
   ORStack.UpdField();
   */
END;

PROCEDURE LoadCard(
   LoadApp = CHAR(4) NOT NULL WITH DEFAULT;
   LoadCard = INTEGER NOT NULL WITH DEFAULT;
) = 
BEGIN
   IF LoadApp = Application$FMS THEN
      TempChar = Left(UserName,Length(UserName) - 3) + VARCHAR(Application$FMSInt) + Right(UserName, 2);         

      ControlText = TempChar + ';';
      ControlText = ControlText + varchar(LoadCard) + ';';
      ControlText = ControlText + Application$FMS + ';'; 
      ControlText = ControlText + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'FMS_LoadCommonCard', 
                                        DBEventText = ControlText); 
   ELSE
      ControlText = UserName + ';';
      ControlText = ControlText + varchar(LoadCard) + ';';
      ControlText = ControlText + LoadApp + ';'; 
      ControlText = ControlText + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_LoadCommonCard', 
                                     DBEventText = ControlText);                 
   ENDIF;
   RETURN;
END;

PROCEDURE EnableSWPLoadCard(
   SelectRow = INTEGER NOT NULL WITH DEFAULT
) =
BEGIN
   Card_SF.CL.Clear();
   IF SelectRow = 0 THEN
      FIELD(LoadCard_Btn).CurBias = FB_DIMMED;
      RETURN;
   ENDIF;
   
   i = 1;
   REPEATED
   SELECT DISTINCT
          :Card_SF.CL[i].Application = C.Application,
          :Card_SF.CL[i].Card = C.Card,
          :Card_SF.CL[i].TOMove = J.TOMove
   FROM   SOA_OutageRequestPermit W,
          SOA_Job J,
          SOA_JobControl JC,
          SOA_Card C
   WHERE  W.ORNumber = :swp_tf[SelectRow].ORNumber AND
          W.PermitJobID = J.Job and
          J.Job = JC.Job AND
          JC.Card = C.Card
   ORDER BY Application
   BEGIN 
      IF Card_SF.CL[i].Application = Application$FMS THEN
         SELECT :Card_SF.CL[i].CardName = C.FeederName
         FROM   FMS_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ELSEIF Card_SF.CL[i].Application = Application$TFMS THEN
         SELECT :Card_SF.CL[i].CardName = C.FeederNames
         FROM   TFMS_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ELSEIF Card_SF.CL[i].Application = Application$SLC THEN
         SELECT :Card_SF.CL[i].CardName = C.SubstationName
         FROM   SLC_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ENDIF; 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF Card_SF.CL.LastRow > 0 THEN
      FIELD(LoadCard_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(LoadCard_Btn).CurBias = FB_DIMMED;
   ENDIF;
END;

PROCEDURE ShowSWPDetails(
   SelectRow = INTEGER NOT NULL WITH DEFAULT
) =
DECLARE
   k = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ORStack = StackField;
   ORVar = SWPOutageClass;
ENDDECLARE
BEGIN
   ORList.Clear();
   
   IF SelectRow = 0 THEN
      SWP = OutageReport.Create();   
   ELSE
      SWP = swp_tf[SelectRow];
   
      i = 1;
      SELECT :ORList[i].ORNumber        = ORNumber  
            ,:ORList[i].Title		= Title		
            ,:ORList[i].Location        = Location 
            ,:ORList[i].Instruction     = Instruction
            ,:ORList[i].SkedOutageDate  = SkedOutageDate 
            ,:ORList[i].SkedStartDate   = SkedStartDate  
            ,:ORList[i].SkedReturnDate  = SkedReturnDate 
      FROM  SOA_OutageRequest
      WHERE ORNumber = :SWP.ORNumber
      ORDER BY ORNumber ASC
      BEGIN
         j = 1;
         SELECT :ORList[i].WIList[j].WorkItem        = W.WorkItem
               ,:ORList[i].WIList[j].WINumber        = W.WINumber
               ,:ORList[i].WIList[j].Location        = W.Location
               ,:ORList[i].WIList[j].Substation      = W.Substation
               ,:ORList[i].WIList[j].SubstationName  = O.Name
               ,:ORList[i].WIList[j].EquipName       = W.EquipName
               ,:ORList[i].WIList[j].Network         = W.Network
               ,:ORList[i].WIList[j].WorkGroup       = W.WorkGroup
               ,:ORList[i].WIList[j].Description     = W.Description
         FROM  SOA_ORWorkItem W,
               Udb_Object O
         WHERE W.ORNumber = :SWP.ORNumber AND
               W.Substation = O.Object
         BEGIN
            ORList[i].WIList[j].ORNumber = ORList[i].ORNumber;
/*            
            ORList[i].WIList[j].Item = VARCHAR(ORList[i].WIList[j].SWPWorkItem) + 
               '-' + VARCHAR(ORList[i].WIList[j].ORWorkItem);
*/
            j = j + 1;
         END;
         i = i + 1;
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
   
   FOR i = 1 TO ORList.LastRow DO
      FOR j = 1 TO ORList[i].WIList.LastRow DO
         // get permit jobs
         ORList[i].WIList[j].LoadJobs();
      ENDFOR;
   ENDFOR;
   
   FOR i = 1 TO ORList.LastRow DO
      IF i < TemplateParent.ChildFields.LastRow THEN
         TemplateParent.ChildFields[i].SetFieldValue(Value = byref(ORList[i]));
      ELSE
         ORStack = Field(Template).Duplicate();
         ORStack.Name = 'ORSF_' + varchar(i);
         TemplateParent.InsertChild(FieldToInsert=ORStack, Position=i);
         ORStack.DeclareData(Result = ByRef(ORVar), UserClass = SWPOutageClass);
         ORStack.SetFieldValue(Value = byref(ORList[i]));
         ORStack.UpdField();
      ENDIF;
      TemplateParent.ChildFields[i].CurBias = FB_CHANGEABLE;
   ENDFOR;
   
   FOR i = (ORList.LastRow + 1) TO TemplateParent.ChildFields.LastRow DO
      TemplateParent.ChildFields[i].CurBias = FB_INVISIBLE;
   ENDFOR;
   
   IF ORList.LastRow = 0 THEN
      // Show template if there are no outage requests.
      field(Template).CurBias = FB_VISIBLE;
   ENDIF;
   
   //CurFrame.Flush();
   //ORViewPort.OuterWidth  = SWP.OuterWidth + 300;
   
   /*
   ** if there is only one work item, select the work item. Otherwise, reset.
   */
   ORIdx = 0;
   WIIdx = 0;
   IF ORList.LastRow = 1 THEN
      IF ORList[1].WIList.LastRow = 1 THEN
         ORIdx = 1;
         WIIdx = 1;
         RetCode = CALLPROC ValidateSubstation (Substation = ORList[ORIdx].WIList[WIIdx].Substation);
         IF RetCode = PU_OK THEN
            CALLPROC ShowWorkItem();
         ELSE
            ORIdx = 0;
            WIIdx = 0;
         ENDIF;
      ENDIF;
   ENDIF;
   CALLPROC HighlightWorkItem();
END;

PROCEDURE ShowWorkItem(
) = 
DECLARE
   
BEGIN  
   WorkItem = SWPOutageWorkItemClass.Create();
   SelectEquip.Clear();
   Card_TF.Clear();
   Permit_SF.Job_TF.Clear();
   TOMove = '';
   FIELD(WorkItem.Substation).TextLabel = 'Substation';

   IF ORIdx = 0 OR WIIdx = 0 THEN
      RETURN;
   ENDIF;
   
   WorkItem = ORList[ORIdx].WIList[WIIdx];
   
   IF WorkItem.Substation = 0 THEN
      // try to map substation by HTOD number by system
      CALLPROC MapStationByHTOD();
   ENDIF;

   IF WorkItem.Substation = 0 THEN
      CALLPROC EnableAddPermit(Enabled = TRUE);
      CurFrame.SendUserEvent(EventName = 'Map_Substation');
   ELSE
      FIELD(WorkItem.Substation).TextLabel = 'Substation: ' + WorkItem.SubstationName;
      CALLPROC ShowEquipment();
      CardOption = 2;   // Open
   ENDIF;
END;

PROCEDURE HighlightWorkItem(
) = 
DECLARE
   DExp = DynExpr DEFAULT NULL;   
BEGIN  
   /*
   ** Reset highlighted row 
   */
   FOR i = 1 TO ORList.LastRow DO
      FOR j = 1 TO ORList[i].WIList.LastRow DO
         DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(i) + '.WIList[' + VARCHAR(j) + '].WINumber).IsReverse');
         DExp.SetValue(Value = FALSE);
         DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(i) + '.WIList[' + VARCHAR(j) + '].Location).IsReverse');
         DExp.SetValue(Value = FALSE);
         DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(i) + '.WIList[' + VARCHAR(j) + '].EquipName).IsReverse');
         DExp.SetValue(Value = FALSE);
         DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(i) + '.WIList[' + VARCHAR(j) + '].WorkGroup).IsReverse');
         DExp.SetValue(Value = FALSE);
         DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(i) + '.WIList[' + VARCHAR(j) + '].Description).IsReverse');
         DExp.SetValue(Value = FALSE);      
      ENDFOR;
   ENDFOR;
   /*
   ** highlight the selected work item row 
   */
   IF ORIdx <> 0 AND WIIdx <> 0 THEN
      DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(ORIdx) + '.WIList[' + VARCHAR(WIIdx) + '].WINumber).IsReverse');
      DExp.SetValue(Value = TRUE);
      DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(ORIdx) + '.WIList[' + VARCHAR(WIIdx) + '].Location).IsReverse');
      DExp.SetValue(Value = TRUE);
      DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(ORIdx) + '.WIList[' + VARCHAR(WIIdx) + '].EquipName).IsReverse');
      DExp.SetValue(Value = TRUE);
      DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(ORIdx) + '.WIList[' + VARCHAR(WIIdx) + '].WorkGroup).IsReverse');
      DExp.SetValue(Value = TRUE);
      DExp = CurFrame.Scope.CreateDynExpr(String = 'FIELD(ORSF_' + VARCHAR(ORIdx) + '.WIList[' + VARCHAR(WIIdx) + '].Description).IsReverse');
      DExp.SetValue(Value = TRUE);
   ENDIF;
END;
   
PROCEDURE EnableAddPermit(
   Enabled = INTEGER NOT NULL
) = 
DECLARE
   
ENDDECLARE
BEGIN
   IF Enabled = TRUE THEN
      FIELD(SelectEquip).CurBias = FB_LANDABLE;
      FIELD(Card_TF).CurBias = FB_LANDABLE;
      FIELD(TOMove).CurBias = FB_CHANGEABLE;
      
      FIELD(Insert_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(SelectEquip).CurBias = FB_VIEWABLE;
      FIELD(Card_TF).CurBias = FB_VIEWABLE;
      FIELD(Permit_SF).CurBias = FB_INVISIBLE;
      FIELD(TOMove).CurBias = FB_LANDABLE;

      FIELD(Insert_Btn).CurBias = FB_Invisible;
   ENDIF;   
END;

PROCEDURE ShowEquipment(
) =
DECLARE
   Feeder = INTEGER NOT NULL WITH DEFAULT;
   TempString = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Selected.Equip = 0;
   Selected.SubstationName = '';
   Selected.Substation= 0;
   Selected.PrintId = '';
   Selected.EquipClassName = '';
   Selected.EquipName = '';
   Selected.Description = '';

   SelectEquip.Clear();

   SelectEquip[1].Equip = 0;   
   SelectEquip[1].SubstationName = '';
   SelectEquip[1].Substation = 0;
   SelectEquip[1].PrintId = '';
   SelectEquip[1].EquipName = '';
   SelectEquip[1].EquipClass = 0;
   SelectEquip[1].EquipClassName = 'NONE';
   SelectEquip[1].Description = '';       

   IF CurrentApplication = Application$FMS THEN
      IF FMSCard IS NULL THEN
         Feeder = SWP.Feeder;
      ELSE
         Feeder = FMSCard.Object[1].Object;
      ENDIF;
      
      SelectEquip[2].Equip = 0;   
      SelectEquip[2].SubstationName = '';
      SelectEquip[2].Substation = 0;
      SelectEquip[2].PrintId = '';
      SelectEquip[2].EquipName = '';
      SelectEquip[2].EquipClass = TypeName$MH;
      SelectEquip[2].EquipClassName = 'MH';
      SelectEquip[2].Description = '';       

      SelectEquip[3].Equip = 0;   
      SelectEquip[3].SubstationName = '';
      SelectEquip[3].Substation = 0;
      SelectEquip[3].PrintId = '';
      SelectEquip[3].EquipName = '';
      SelectEquip[3].EquipClass = TypeName$Pole;
      SelectEquip[3].EquipClassName = 'POLE-Std';
      SelectEquip[3].Description = '';       

      i = 4;
      REPEATED
      SELECT DISTINCT
          :SelectEquip[i].Equip = O.Object, 
          :SelectEquip[i].EquipName = O.Name,
          :SelectEquip[i].EquipClass  = O.Type,
          :SelectEquip[i].EquipClassName  = O.TypeName,
          :SelectEquip[i].PrintID = G.Reference,
          :SelectEquip[i].Description = O.Description
      FROM  Udb_Object O,
            Udb_Grouping G,
            Udb_ExtendedType ET
      WHERE G.Grouping = :Feeder AND
            G.Relationship = :Interaction$MemberOf AND
            G.Member = O.Object AND
            O.Type NOT IN (:Type$AbstractHTV,
                              :Type$ISOGrouper,
                              :Type$Loop,
                              :Type$FdrLoad) AND 
            O.Type = ET.Type AND
            ET.SuperType = :Type$Switch
      ORDER BY PrintID, Description, EquipName
      BEGIN
         i = i + 1;
      END;
      
      SELECT :TempString = Name
      FROM   UDB_Object
      WHERE  Object = :Feeder;
      
      FIELD(Equip_Title).TextValue = 'Select Equipment on ' + TempString + ' to Create Permit';
      
   ELSEIF CurrentApplication = Application$TFMS THEN
      IF TFMSCard IS NULL THEN
         // just show the equipment in the work location
         i = 2;   
         REPEATED
         SELECT DISTINCT  
               :SelectEquip[i].Equip = O.Object, 
               :SelectEquip[i].EquipName = O.Name,
               :SelectEquip[i].EquipClass  = O.Type,
               :SelectEquip[i].EquipClassName  = O.TypeName,
               :SelectEquip[i].Description = O.Description,
               :SelectEquip[i].PrintID = '',
               SelectEquip[i].Substation = G.Grouping,
               SelectEquip[i].SubstationName = O.PrimaryGroupingName
         FROM  Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType E
         WHERE G.Grouping = :WorkItem.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = O.Object AND
               (O.Outservice IS NULL OR O.Outservice = '') AND	
               O.Type = E.Type AND
               E.SuperType = :Type$Conducting 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
         
         FIELD(Equip_Title).TextValue = 'Select Equipment in ' + WorkItem.SubstationName + ' to Create Permit';
      ELSE
         i = 2;
         REPEATED
         SELECT DISTINCT
            :SelectEquip[i].Equip = O.Object, 
            :SelectEquip[i].EquipName = O.Name,
            :SelectEquip[i].EquipClass  = O.Type,
            :SelectEquip[i].EquipClassName  = O.TypeName,
            :SelectEquip[i].PrintID = '',
            :SelectEquip[i].Description = O.Description,
            :SelectEquip[i].Substation = O.PrimaryGrouping,
            :SelectEquip[i].Substationname = O.PrimaryGroupingName
         FROM  TFMS_CardToObject CTO1,
               Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType ET,
               TFMS_CardToObject CTO2
         WHERE CTO1.Card = :TFMSCard.Card AND
               CTO1.Type = :Type$Line AND
               CTO1.Object = G.Grouping AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = O.Object AND
               O.Type = ET.Type AND
               ET.SuperType = :Type$Conducting AND
               O.PrimaryGrouping = :WorkItem.Substation
         ORDER BY SubstationName, EquipClassName, EquipName
         BEGIN
            i = i + 1;
         END;
         
         FIELD(Equip_Title).TextValue = 'Select Equipment on ' + TFMSCard.FeederNames + ' to Create Permit';
      ENDIF;
   ELSEIF CurrentApplication = Application$SLC THEN
      IF SLCCard IS NULL THEN
         i = 2;   
         REPEATED
         SELECT DISTINCT  
               :SelectEquip[i].Equip = O.Object, 
               :SelectEquip[i].EquipName = O.Name,
               :SelectEquip[i].EquipClass  = O.Type,
               :SelectEquip[i].EquipClassName  = O.TypeName,
               :SelectEquip[i].Description = O.Description,
               :SelectEquip[i].PrintID = '',
               SelectEquip[i].Substation = G.Grouping,
               SelectEquip[i].SubstationName = O.PrimaryGroupingName
         FROM  Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType E
         WHERE G.Grouping = :WorkItem.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = O.Object AND
               (O.Outservice IS NULL OR O.Outservice = '') AND	
               O.Type = E.Type AND
               E.SuperType = :Type$Conducting 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
         FIELD(Equip_Title).TextValue = 'Select Equipment in ' + WorkItem.SubstationName + ' to be associated with Permit Move';
         
      ELSEIF SLCCard.MultiplekVFlag = TRUE THEN
         i = 2;   
         REPEATED
         SELECT DISTINCT  
               :SelectEquip[i].Equip = O.Object, 
               :SelectEquip[i].EquipName = O.Name,
               :SelectEquip[i].EquipClass  = O.Type,
               :SelectEquip[i].EquipClassName  = O.TypeName,
               :SelectEquip[i].Description = O.Description,
               :SelectEquip[i].PrintID = '',
               :SelectEquip[i].Substation = G1.Member,
               :SelectEquip[i].SubstationName = O.PrimaryGroupingName
         FROM  Udb_Grouping G1,
               Udb_Object O,
               Udb_Grouping G2,
               Udb_ExtendedType E
         WHERE G1.Grouping = :SLCCard.Substation AND
               G1.Relationship = :Interaction$MemberOf AND
               G1.Reference > 0 AND
               G2.Grouping = G1.Member AND
               G2.Relationship = :Interaction$MemberOf AND
               G2.Member = O.Object AND
               (O.Outservice IS NULL OR O.Outservice = '') AND	
               O.Type = E.Type AND
               E.SuperType = :Type$Conducting 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
         FIELD(Equip_Title).TextValue = 'Select Equipment in ' + SLCCard.SubstationName + ' to be associated with Permit Move';
      ELSE      
         i = 2;   
         REPEATED
         SELECT DISTINCT  
               :SelectEquip[i].Equip = O.Object, 
               :SelectEquip[i].EquipName = O.Name,
               :SelectEquip[i].EquipClass  = O.Type,
               :SelectEquip[i].EquipClassName  = O.TypeName,
               :SelectEquip[i].Description = O.Description,
               :SelectEquip[i].PrintID = '',
               SelectEquip[i].Substation = G.Grouping,
               SelectEquip[i].SubstationName = O.PrimaryGroupingName
         FROM  Udb_Object O,
               Udb_Grouping G,
               Udb_ExtendedType E
         WHERE G.Grouping = :SLCCard.Substation AND
               G.Relationship = :Interaction$MemberOf AND
               G.Member = O.Object AND
               (O.Outservice IS NULL OR O.Outservice = '') AND	
               O.Type = E.Type AND
               E.SuperType = :Type$Conducting 
         ORDER BY EquipClassName, EquipName     
         BEGIN
            i = i + 1;
         END;
         FIELD(Equip_Title).TextValue = 'Select Equipment in ' + SLCCard.SubstationName + ' to be associated with Permit Move';
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;   
END;

PROCEDURE MapStationByHTOD(
)=
DECLARE
   i = integer not null with default;
   Segments = array of stringobject;
   HTOD = varchar(10) not null with default;
   HTODWithRevision = varchar(10) not null with default;
ENDDECLARE
BEGIN
   // example of work item location X-SC13-003C-S 
   Segments = CALLPROC SplitString(delimiter = '-', splittext = WorkItem.Location);

   i = Segments.lastrow;
   IF i > 1 THEN
      HTOD  = Segments[i-1].Value;
      // remove leading zeroes
      WHILE HTOD <> '' DO
         if left(HTOD, 1) = '0' then
            HTOD = SHIFT(HTOD, -1);
         ELSE
            ENDLOOP;
         ENDIF;
      ENDWHILE;
      
      HTODWithRevision = HTOD + ' %';

      SELECT :WorkItem.Substation = O.Object,
             :WorkItem.SubstationName = O.Name
      FROM   Udb_Grouping G,
             Udb_Object O,
             Udb_ExtendedType ET
      WHERE  G.Grouping = :SWP.Division AND
             G.RelationShip = :Interaction$MemberOf AND
             G.MemberType = ET.Type AND
             ET.SuperType = :Type$Substation AND
             G.Member = O.Object AND
             (O.SpecNumber = :HTOD OR O.SpecNumber LIKE :HTODWithRevision) AND
             O.PrimaryGrouping <> 0;

     IF WorkItem.Substation > 0 THEN
        WorkItem.MapSubstation();
        IF WorkItem.ReturnCode <> 0 THEN
           MESSAGE WorkItem.ErrorMessage;
        ENDIF;
     ENDIF;
   ENDIF;
END;

PROCEDURE ShowSubstations(
) = 
BEGIN
   i = 1;
   SELECT  :SubSF.SubstationList[i].Object = O.Object,
           :SubSF.SubstationList[i].Type = O.Type,
           :SubSF.SubstationList[i].Name = O.Name,
           :SubSF.SubstationList[i].Description = O.Description
   FROM     Udb_Grouping G,
            Udb_Object O,
            Udb_ExtendedType ET
   WHERE    G.Grouping = :SWP.Division AND
            G.RelationShip = :Interaction$MemberOf AND
            G.MemberType = ET.Type AND
            ET.SuperType = :Type$Substation AND
            G.Member = O.Object AND
            O.PrimaryGrouping <> 0
   ORDER BY Description
   BEGIN
      IF VARCHAR(SubSF.SubstationList[i].Object) <> SubSF.SubstationList[i].Name THEN
         i = i + 1;
      ENDIF;
   END;
END;

PROCEDURE SubstationSearch =
DECLARE
   SearchName = VARCHAR(40) NOT NULL WITH DEFAULT;
   SearchList = ARRAY OF ObjectClass;
ENDDECLARE
BEGIN
   /*
   **	Set up the search filter for Object.
   */
   IF (SUBSF.Filter.Description = '') THEN
      CALLPROC ShowSubstations();
   ELSE
      SearchName = '%' + SUBSF.Filter.Description + '%';
      /*
      **	Loop through each array to find all equipment that match the
      **	search criteria. Note: there is no guarantee that all the 
      **   lists are loaded prior to the search happening.  Will only search
      **   loaded rows.
      */
      j = 1;
      SearchList.Clear();

      i = 1;
      FOR i = 1 TO SUBSF.SubstationList.LastRow DO 
         IF (UPPERCASE(SUBSF.SubstationList[i].Description) LIKE SearchName) THEN
            SearchList[j] = SUBSF.SubstationList[i];	
            j = j + 1;
         ENDIF;
      ENDFOR;
  
      SUBSF.SubstationList.Clear();
      SUBSF.SubstationList = SearchList.Duplicate(); 
      CurFrame.InputFocusField = FIELD(SUBSF.Filter.Description);
   ENDIF;
END;

PROCEDURE ShowCardsByEquip(
) =
DECLARE
   DynamicWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Load card list...
** 1) Where equipment is associated to distribution feeder card
** 2) Where equipment is associated to a transmission line card
** 3) All switching items associated to the SLC card 
*/
   Card_TF.Clear();
   
   IF CurrentApplication = Application$FMS THEN
      IF FMSCard IS NOT NULL THEN
         Card_TF[1].Application = Application$FMS;
         Card_TF[1].CardClassName = FMSCard.CardClassName;
         Card_TF[1].CardName = FMSCard.FeederName;
         Card_TF[1].Card = FMSCard.Card;
         Card_TF[1].CardStatus = FMSCard.Status;
         Card_TF[1].TypeOfCard = FMSCard.TypeOfCard;
         Card_TF[1].FeederStatusName = '';
         Card_TF[1].SwitchingItem = 0;
      ELSE
         DynamicWhereClause = ' G.Member = ' + VARCHAR(Selected.Equip) + ' AND' +
                ' G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND' +
                ' G.Grouping = CTO.Object AND' + 
                ' CTO.Card = C.Card AND';
         IF CardOption = 1 THEN
            DynamicWhereClause = DynamicWhereClause + ' C.Status >' + VARCHAR(Card$Open) + 
                     ' AND C.Status < ' + VARCHAR(Card$Closed);
         ELSE
            DynamicWhereClause = DynamicWhereClause + ' C.Status = ' + VARCHAR(Card$Open);
         ENDIF;
         
         i = 1;
         
         SELECT DISTINCT
                :Card_TF[i].Application = :Application$FMS,
                :Card_TF[i].CardClassName = C.CardClassName,
                :Card_TF[i].CardName = C.FeederName,
                :Card_TF[i].Card = C.Card,
                :Card_TF[i].CardStatus = C.Status,
                :Card_TF[i].TypeOfCard = C.TypeOfCard,
                :Card_TF[i].FeederStatusName = '',   
                :Card_TF[i].SwitchingItem = 0       
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO,
                FMS_Card C
         WHERE  :DynamicWhereClause
         BEGIN
            i = i + 1;
         END; 
      ENDIF;
             
   ELSEIF CurrentApplication = Application$TFMS THEN
      IF TFMSCard IS NOT NULL THEN
         Card_TF[1].Application = Application$TFMS;
         Card_TF[1].CardClassName = TFMSCard.CardClassName;
         Card_TF[1].CardName = TFMSCard.FeederNames;
         Card_TF[1].Card = TFMSCard.Card;
         Card_TF[1].CardStatus = TFMSCard.Status;
         Card_TF[1].TypeOfCard = TFMSCard.TypeOfCard;
         Card_TF[1].FeederStatusName = '';
         Card_TF[1].SwitchingItem = 0;
      ELSE
         DynamicWhereClause = ' G.Member = ' + VARCHAR(Selected.Equip) + ' AND' +
               ' G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND' +
               ' G.Grouping = CTO.Object AND' + 
               ' CTO.Type = ' + VARCHAR(Type$Line) + ' AND' +
               ' CTO.Card = C.Card AND' +
               ' C.Card = SC.Card AND';
          
         IF CardOption = 1 THEN
            DynamicWhereClause = DynamicWhereClause + ' SC.Status >' + VARCHAR(Card$Open) + 
                     ' AND SC.Status < ' + VARCHAR(Card$Closed);
         ELSE
            DynamicWhereClause = DynamicWhereClause + ' SC.Status = ' + VARCHAR(Card$Open);
         ENDIF;
         
         i = 1;
         SELECT DISTINCT
                :Card_TF[i].Application = SC.Application,
                :Card_TF[i].CardClassName = SC.CardClassName,
                :Card_TF[i].CardName = C.FeederNames,
                :Card_TF[i].Card = C.Card,
                :Card_TF[i].CardStatus = SC.Status,
                :Card_TF[i].TypeOfCard = SC.TypeOfCard,
                :Card_TF[i].FeederStatusName = '',   
                :Card_TF[i].SwitchingItem = 0       
         FROM   Udb_Grouping G,
                SOA_Card SC,
                TFMS_CardToObject CTO,
                TFMS_Card C
         WHERE  :DynamicWhereClause
         BEGIN
            i = i + 1;
         END; 
      ENDIF;
   ELSEIF CurrentApplication = Application$SLC THEN 
      IF SLCCard IS NOT NULL THEN
         DynamicWhereClause = ' C.Card = ' + VARCHAR(SLCCard.Card) + ' AND' +
                ' C.Card = JC.Card AND' +
                ' JC.Job = J.Job AND' +
                ' JC.Job = JC.SwitchingItem AND' +
                ' J.ShadowLink = 0 AND' +
                ' J.MoveCategory = ' + VARCHAR(MoveCategory$SwitchingItem) + ' AND';
                
         IF SWItem > 0 THEN
            DynamicWhereClause = DynamicWhereClause + ' JC.Job = ' + VARCHAR(SWItem) + ' AND';
         ENDIF;

         IF CardOption = 1 THEN
            DynamicWhereClause = DynamicWhereClause + ' J.SwItemStatus >' + VARCHAR(Card$Open) + 
                     ' AND J.SwItemStatus < ' + VARCHAR(Card$Closed);
         ELSE
            DynamicWhereClause = DynamicWhereClause + ' J.SwItemStatus = ' + VARCHAR(Card$Open);
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + ' AND J.Job = I.Job';
         
         i = 1;
         SELECT DISTINCT
                :Card_TF[i].Application = C.Application,
                :Card_TF[i].CardClassName = I.CardClassName,
                :Card_TF[i].CardName = :SLCCard.SubstationName,
                :Card_TF[i].Card = :SLCCard.Card,
                :Card_TF[i].CardStatus = J.SwItemStatus,
                :Card_TF[i].TypeOfCard = C.TypeOfCard,
                :Card_TF[i].FeederStatusName = J.TOMove,
                :Card_TF[i].SwitchingItem = JC.SwitchingItem          
         FROM   SOA_Card C,
                SOA_JobControl JC,
                SOA_Job J,
                SLC_InformationItem I
         WHERE  :DynamicWhereClause
         BEGIN 
            i = i + 1;
         END;
         
      ELSE
         DynamicWhereClause = ' AO.Object = ' + VARCHAR(Selected.Substation) + ' AND' + 
                ' AO.ObjectToCardLink = 1 AND' +
                ' AO.Card = C.Card AND' +
                ' AO.Card = S.Card AND' +
                ' AO.Card = JC.Card AND' + 
                ' JC.Job = J.Job AND' + 
                ' JC.Job = JC.SwitchingItem AND' + 
                ' J.ShadowLink = 0 AND' + 
                ' J.MoveCategory = ' + VARCHAR(MoveCategory$SwitchingItem) + ' AND';
          
         IF CardOption = 1 THEN
            DynamicWhereClause = DynamicWhereClause + ' J.SwItemStatus >' + VARCHAR(Card$Open) + 
                     ' AND J.SwItemStatus < ' + VARCHAR(Card$Closed);
         ELSE
            DynamicWhereClause = DynamicWhereClause + ' J.SwItemStatus = ' + VARCHAR(Card$Open);
         ENDIF;
         DynamicWhereClause = DynamicWhereClause + ' AND J.Job = I.Job';
         
         i = 1;
         SELECT DISTINCT
                :Card_TF[i].Application = C.Application,
                :Card_TF[i].CardClassName = I.CardClassName,
                :Card_TF[i].CardName = S.SubstationName,
                :Card_TF[i].Card = C.Card,
                :Card_TF[i].CardStatus = J.SwItemStatus,
                :Card_TF[i].TypeOfCard = C.TypeOfCard,
                :Card_TF[i].FeederStatusName = J.TOMove,
                :Card_TF[i].SwitchingItem = JC.SwitchingItem          
         FROM   SOA_ActiveObject AO,
                SOA_Card C,
                SLC_Card S,
                SOA_JobControl JC,
                SOA_Job J,
                SLC_InformationItem I
         WHERE  :DynamicWhereClause
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   FOR i=1 TO Card_TF.LastRow DO
      IF Card_TF[i].CardStatus = Card$Open THEN
         Card_TF[i].CardStatusChar = 'Open';
      ELSE
         Card_TF[i].CardStatusChar = 'Active';
      ENDIF;
   ENDFOR;
END;

PROCEDURE HighlightCard(
   SelectRow = INTEGER NOT NULL WITH DEFAULT;
) = 
BEGIN
   FOR j = 1 TO Card_TF.LastRow() DO
      IF SelectRow = j THEN
         FIELD(Card_TF[j].Application).IsReverse = TRUE;
         FIELD(Card_TF[j].CardStatusChar).IsReverse = TRUE;
         FIELD(Card_TF[j].CardClassName).IsReverse = TRUE;
         FIELD(Card_TF[j].CardName).IsReverse = TRUE;
         FIELD(Card_TF[j].FeederStatusName).IsReverse = TRUE;
      ELSE
         FIELD(Card_TF[j].Application).IsReverse = FALSE;
         FIELD(Card_TF[j].CardStatusChar).IsReverse = FALSE;
         FIELD(Card_TF[j].CardClassName).IsReverse = FALSE;
         FIELD(Card_TF[j].CardName).IsReverse = FALSE;
         FIELD(Card_TF[j].FeederStatusName).IsReverse = FALSE;
      ENDIF;
   ENDFOR;

   SelectedTypeofCard = Card_TF[SelectRow].TypeOfCard;
   SelectedCard = Card_TF[SelectRow].Card;
   SelectedCardStatus = Card_TF[SelectRow].CardStatus;
   SelectedSwitchingItem = Card_TF[SelectRow].SwitchingItem;
   SelectedApplication = Card_TF[SelectRow].Application;
   SelectedEquip = Selected.Equip;
   SelectedJobClass = 0;
   SelectedEquipClass = 0;
   SelectedStepPair = 0;
END;

PROCEDURE ShowJobsByCard(
) = 
DECLARE
   StepHeading = VARCHAR(160) NOT NULL WITH DEFAULT;
BEGIN
   Permit_SF.Job_TF.Clear();

   j = 1;
   SELECT :Permit_SF.Job_TF[j].StepPairName = SQUEEZE(SP.Name),
          :Permit_SF.Job_TF[j].StepPair = SP.StepPair,
          :Permit_SF.Job_TF[j].EquipClass = 0,
          :Permit_SF.Job_TF[j].EquipClassName = '',
          :Permit_SF.Job_TF[j].EquipName = '',
          :Permit_SF.Job_TF[j].TOMove = SP.Name,
          :Permit_SF.Job_TF[j].RSMove = SP.Name,
          :Permit_SF.Job_TF[j].JobClass = 0,
          :Permit_SF.Job_TF[j].Seq = 0
   FROM   FMS_StepPair SP
   WHERE  SP.TypeOfCard = :SelectedTypeOfCard AND
          SP.StepPair IN (:StepHeading$WorkPermit, :StepHeading$TestPermit)
   UNION
   SELECT '',
          JCC.StepPair,
          JCC.EquipClass,
          '',
          '',
          JC.TOMove,
          JC.RSMove,
          JC.JobClass,
          JCC.Seq
   FROM   FMS_JobClass JC,
          FMS_JobClassControl JCC
   WHERE  JCC.TypeOfCard = :SelectedTypeOfCard AND
          JCC.StepPair IN (:StepHeading$WorkPermit, :StepHeading$TestPermit) AND
          :Selected.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                       WHERE  SuperType = JCC.EquipClass) AND
          JCC.JobClass = JC.JobClass 
   ORDER BY StepPair, Seq
   BEGIN
      IF Permit_SF.Job_TF[j].JobClass = 0 THEN
         FIELD(Permit_SF.Job_TF[j].TOMove).FgColor = CC_BLUE;
         StepHeading = SQUEEZE(Permit_SF.Job_TF[j].TOMove);
      ENDIF;
      Permit_SF.Job_TF[j].StepPairName = StepHeading;

      j = j + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   FIELD(Permit_SF).CurBias = FB_LANDABLE;
   FIELD(Insert_btn).CurBias = FB_LANDABLE;
END;

PROCEDURE ReloadCard(
)=
DECLARE
   TempChar = VARCHAR(5) NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
BEGIN
   IF SelectedApplication = Application$FMS THEN
      TempChar = Left(UserName, 2) + VARCHAR(Application$FMSInt) + Right(UserName, 2);
      ControlText = TempChar + ';' + VARCHAR(SelectedCard) + '; ;';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'LoadFMSCard', 
                               DBEventText = ControlText); 
      CALLPROC DDB_COMMIT;
   ELSE
      TempChar = Left(UserName, 2) + VARCHAR(Application$TFMSInt) + Right(UserName, 2);
      ControlText = TempChar + ';';
      ControlText = ControlText + varchar(SelectedCard) + ';';
      ControlText = ControlText + SelectedApplication + ';'; 
      ControlText = ControlText + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_LoadCommonCard', 
                                     DBEventText = ControlText);      
      CALLPROC DDB_COMMIT;           
   ENDIF;
END;

PROCEDURE ValidateSubstation (
   Substation = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN 
   IF Substation = 0 THEN
      RETURN PU_OK;
   ENDIF;
   
   i = 0;
   SELECT :i = G2.Member 
   FROM   Udb_Grouping G1,
          Udb_Grouping G2
   WHERE  G1.Member = :Substation AND
          G1.Relationship = :Interaction$MemberOf AND
          G1.GroupingType = :Type$Division AND
          G1.Grouping = G2.Member AND
          G2.Relationship = :Interaction$MemberOf AND
          G2.Grouping = :UserDesk;
   IF i = 0 THEN
      RETURN PU_CANCEL;
   ELSE
      RETURN PU_OK;
   ENDIF;
END;
