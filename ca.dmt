METHOD LoadClosedCards (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
   Filter        = VARCHAR(40);        /* Feeder name filter */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Filter = 1 THEN
/*
** Search for most restrictive field - the card number - first
*/
 
      i = 1;
      SELECT	:CurObject.CList[i].Card = C.Card,
		:CurObject.CList[i].FeederNames = C.FeederNames,
		:CurObject.CList[i].ScopeOfWork = C.ScopeOfWork,
		:CurObject.CList[i].CardNumber = C.Card,
                :CurObject.CList[i].CardClassName  = C.CardClassName,
                :CurObject.CList[i].TemplateName  = C.TemplateName,
	        :CurObject.CList[i].Closed = C.Closed
      FROM	DSO_Card C
      WHERE     C.Card = :CurObject.CardFilter AND
                C.Status = :Card$Closed
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that card number was found.';
         RETURN;
      ENDIF;

   ELSEIF CurObject.Filter = 2 THEN

      Filter = '%' + Uppercase(CurObject.LineFilter) + '%';

      i = 1;
      REPEATED
      SELECT	DISTINCT
                :CurObject.CList[i].Card = C.Card,
	        :CurObject.CList[i].FeederNames = C.FeederNames,
		:CurObject.CList[i].ScopeOfWork = C.ScopeOfWork,
	        :CurObject.CList[i].CardNumber = C.Card,
                :CurObject.CList[i].CardClassName  = C.CardClassName,
                :CurObject.CList[i].TemplateName  = C.TemplateName,
	        :CurObject.CList[i].Closed = C.Closed
      FROM	DSO_Card C,
                TFMS_CardToObject CTO
      WHERE     CTO.Name LIKE :Filter AND
                CTO.Card = C.Card AND
                C.Status = :Card$Closed
      ORDER BY  Closed desc, FeederNames 
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that name was found.';
         RETURN;
      ENDIF;

   ELSEIF CurObject.Filter = 3 THEN

      Filter = '%' + Uppercase(CurObject.TemplateFilter) + '%';

      i = 1;
      REPEATED
      SELECT	DISTINCT
                :CurObject.CList[i].Card = C.Card,
	        :CurObject.CList[i].FeederNames = C.FeederNames,
		:CurObject.CList[i].ScopeOfWork = C.ScopeOfWork,
	        :CurObject.CList[i].CardNumber = C.Card,
                :CurObject.CList[i].CardClassName  = C.CardClassName,
                :CurObject.CList[i].TemplateName  = C.TemplateName,
	        :CurObject.CList[i].Closed = C.Closed
      FROM	DSO_Card C
      WHERE     UPPER(C.TemplateName) LIKE :Filter AND             
                C.Status = :Card$Closed
      ORDER BY  TemplateName, Closed desc
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that template name was found.';
         RETURN;
      ENDIF;
      
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please enter a search filter.';
      RETURN;
   ENDIF;

   RETURN;
END;


