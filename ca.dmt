**
**  Date:       Version Description
** ----------------------------------
**  10/28/20    em      Created 
*/ 
METHOD LoadContingency (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = 1;
   j = 0;
   SELECT :CurObject.Card = Card,
          :CurObject.Contingency = Contingency,
          :CurObject.ContingencyName = ContingencyName,
          :CurObject.DOComment = DOComment,
          :CurObject.Line = Line,
          :CurObject.LineName = LineName,
          :CurObject.AlleviationStatus = AlleviationStatus,
          :CurObject.NotAlleviatedComment = NotAlleviatedComment        
   FROM   FMS_MTAContingency
   WHERE  Card = :CurObject.Card AND
          Line = :CurObject.Line 
   ORDER BY LineName
   BEGIN
      j = j + 1;
      SELECT :CurObject.Feeders[j].Object = Feeder,
             :CurObject.Feeders[j].Name = FeederName
      FROM   FMS_MTAContingencyFeeder
      WHERE  Card = :CurObject.Card AND
             Line = :CurObject.Line
      ORDER BY 2
      BEGIN
         J = j + 1;
      END;
   END;
END;

