	Name:            FeederSetup


���p(Component Method Scripts
���p(--------------------------
/*
**
**	Copyright c 2013 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
*/
/*
**  Application:    CAC
**  Class:          FeederSetup
**
**  Modifications: 
**   08/23/13  ysp  Created.
**   01/30/17  ysp  Use QGis-based connectivity trace to check equipment membership.
**   09/13/19  em   Change to load detail method, perform fdrload trace only if source connected = TRUE
**   03/09/23  em   Remove previous change since it appears to be preventing a connected feeder from being
**                  marked source connected.
*/
METHOD IsValidFeeder (
   SkipConnectedSource = INTEGER NOT NULL WITH DEFAULT; /* optional: called from DBM.ConnectedSource */
   WhenSourceOnly = INTEGER NOT NULL WITH DEFAULT; /* optional: called from Feedercard.Feedercard */
   CriticalOnly = INTEGER NOT NULL WITH DEFAULT;        /* optional: called from Feedercard.Feedercard and DBM.ConnectedSource */
) = 
DECLARE
   
ENDDECLARE
BEGIN
   CurObject.ErrorMessage = '';

   /* when WhenSourceOnly is set, validate only feeders that have connected sources.
   ** Otherwise, do not give warning
   */
   IF WhenSourceOnly = TRUE AND CurObject.SourceEnabled = FALSE THEN
      /* skip source related validations */
   ELSE
      IF CurObject.ConnectedBus = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Source not connected to a bus' + HC_NEWLINE;
      ENDIF;
      IF CurObject.ConnectedFdr = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Source not connected to a Fdr-Load device' + HC_NEWLINE;
      ENDIF;
      IF SkipConnectedSource = FALSE AND CurObject.SourceEnabled = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Connected source flag is not enabled' + HC_NEWLINE;
      ENDIF;
      IF CurObject.FdrLoadMemberships = FALSE THEN
         /* Not even important if no source breaker */
         IF CurObject.SourceBreaker = TRUE THEN 
            CurObject.ErrorMessage = CurObject.ErrorMessage + '- ' + CurObject.LoadsideTypeName + ' ' + CurObject.LoadsideEquipName +
                                  ' is not a member of a substation or this feeder' + HC_NEWLINE;
         ENDIF;
      ENDIF;
   ENDIF;

   // non-critical
   IF CriticalOnly = FALSE THEN
      // Source related validations   
      IF CurObject.SourcePosition = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- No source position' + HC_NEWLINE;
      ENDIF;
      IF CurObject.SourceBreaker = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- No source breaker' + HC_NEWLINE;
      ENDIF;

      IF CurObject.DivisionGrouping = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Not a member of a division' + HC_NEWLINE;
      ENDIF;
      IF CurObject.RatedAsGrouping = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- No KV rating' + HC_NEWLINE;
      ENDIF;
      IF CurObject.ControlledGrouping = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Not controlled by a desk' + HC_NEWLINE;
      ENDIF;
      IF CurObject.LocatedGrouping = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- No "Located With" grouping' + HC_NEWLINE;
      ENDIF;

      IF CurObject.InserviceFlag = FALSE THEN
         CurObject.ErrorMessage = '- Blank Inservice Time Stamp' + HC_NEWLINE;
      ENDIF;
      IF CurObject.ValidatedFlag = FALSE THEN
         CurObject.ErrorMessage = CurObject.ErrorMessage + '- Not Yet Validated By DO' + HC_NEWLINE;
      ENDIF;
   ENDIF;
   
   IF CurObject.ErrorMessage = '' THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   ENDIF;
END;

METHOD LoadDetail (
   SkipVIRFlags = INTEGER NOT NULL WITH DEFAULT;
) = 
DECLARE
   GroupingType = INTEGER NOT NULL WITH DEFAULT;
   Relationship = INTEGER NOT NULL WITH DEFAULT;
   Grouping = INTEGER NOT NULL WITH DEFAULT;
   SourceBreaker = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :CurObject.PrimaryGrouping = O.PrimaryGrouping,
          :CurObject.FeederName = O.Name
   FROM  Udb_Object O
   WHERE O.Object = :CurObject.Feeder;
   CALLPROC DDB_ROLLBACK;

   IF SkipVIRFlags = FALSE THEN
      CurObject.ValidatedFlag = FALSE;
      CurObject.InserviceFlag = FALSE;
      CurObject.RatedAsGrouping = FALSE;

      SELECT :CurObject.FeederName = O.Name,
             :CurObject.InService = O.InService,
             :CurObject.Validated   = O.Validated 
      FROM  Udb_Object O
      WHERE O.Object = :CurObject.Feeder;
      CALLPROC DDB_ROLLBACK;
      
      IF CurObject.Validated IS NOT NULL THEN
         CurObject.ValidatedFlag = TRUE;
      ENDIF;
      IF CurObject.Inservice IS NOT NULL THEN
         CurObject.InserviceFlag = TRUE;
      ENDIF;

      // RatedAsGrouping
      CurObject.Rating = 0;
      SELECT :CurObject.Rating = R.Normal
      FROM  Udb_Grouping G,
            Udb_Rating R
      WHERE G.Member = :CurObject.Feeder AND
            G.Relationship = :Interaction$RatedAs AND
            G.Grouping = R.Object;
      IF CurObject.Rating > 0 THEN
         CurObject.RatedAsGrouping = TRUE;
      ENDIF; 
   ENDIF;

   /*
   ** Get detail for the feeder
   */   
   CurObject.SourcePosition = FALSE;
   CurObject.SourceBreaker = FALSE;
   CurObject.ConnectedBus = FALSE;  
   CurObject.ConnectedFdr = FALSE;
   CurObject.SourceEnabled = FALSE;
   CurObject.FdrLoadMemberships = TRUE; 
   CurObject.DivisionGrouping = FALSE;
   CurObject.ControlledGrouping = FALSE;
   CurObject.LocatedGrouping = FALSE;

   // SourcePosition
   SELECT :CurObject.SourcePosition = Member
   FROM   Udb_Grouping 
   WHERE  Grouping = :CurObject.Feeder AND
          Relationship = :Interaction$SourcePosition;

   IF CurObject.SourcePosition <> FALSE THEN
      CurObject.SourcePosition = TRUE;
   ENDIF;

   // Relationship
   SELECT :GroupingType = GroupingType,
          :Relationship = Relationship,
          :Grouping = Grouping
   FROM   Udb_Grouping 
   WHERE  Member = :CurObject.Feeder 
   BEGIN
      IF Relationship = Interaction$MemberOf AND
         GroupingType = Type$Division THEN
         CurObject.DivisionGrouping = TRUE;

      ELSEIF Relationship = Interaction$LocatedWith AND
          Grouping = CurObject.Feeder THEN
         CurObject.LocatedGrouping = TRUE;

      ELSEIF Relationship = Interaction$ControlledBy AND
             GroupingType = Type$OperatorDesk THEN
         CurObject.ControlledGrouping = TRUE;
      ENDIF;
   END;

   // SourceBreaker
   SourceBreaker = 0;
   SELECT :SourceBreaker = Member
   FROM   Udb_Grouping 
   WHERE  Grouping = :CurObject.Feeder AND
          Relationship = :Interaction$SourceBreaker;

   IF SourceBreaker <> 0 THEN
      CurObject.SourceBreaker = TRUE;
      /*
      ** Now get the connectivity stuff related to the Source Breaker
      */
      SELECT :CurObject.SourceEnabled = Feeder
      FROM   FMS_ConnectedSource
      WHERE  Feeder = :CurObject.Feeder;
      
      IF CurObject.SourceEnabled <> FALSE THEN
         CurObject.SourceEnabled = TRUE;
      ENDIF;
      CurObject.CheckFdrLoad (Equip = SourceBreaker);   /* allow this trace to happen because it is part of marking feeder connected*/
   ELSE
      CurObject.FdrLoadMemberships = FALSE;   /* Not even important if no source breaker */      
   ENDIF;
END;

METHOD CheckFdrLoad (
   Equip = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   Trace = Trace_FeederEquipMembership;
ENDDECLARE
BEGIN
   Trace.SourceBreaker.Object = Equip;
   Trace.Feeder.Object = CurObject.Feeder;
   Trace.Feeder.PrimaryGrouping = CurObject.PrimaryGrouping;
   Trace.FdrLoadMemberships = CurObject.FdrLoadMemberships;
   
   RetCode = Trace.StartMembershipTrace();
   IF RetCode = TraceStatus$Isolated THEN
      CurMethod.Trace(Text = 'Source breaker ' + VARCHAR(Equip) + ' is not connected');
      RETURN;
   ENDIF;
   CurObject.ConnectedBus = Trace.ConnectedBus;
   CurObject.ConnectedFdr = Trace.ConnectedFdr;
   CurObject.FdrLoadMemberships = Trace.FdrLoadMemberships;   
   CurObject.LoadsideEquipName = Trace.LoadsideEquip.Name;
   CurObject.LoadsideTypeName = Trace.LoadsideEquip.TypeName;
END;

METHOD ReportToStaff (
) = 
DECLARE
   DBEventText = VARCHAR(80) NOT NULL WITH DEFAULT;
   EmailAddress = VARCHAR(60) NOT NULL WITH DEFAULT;
   EventID = INTEGER NOT NULL WITH DEFAULT;
   RequestID = INTEGER NOT NULL WITH DEFAULT;
   Message1 = VARCHAR(200) NOT NULL WITH DEFAULT;
   Message2 = VARCHAR(200) NOT NULL WITH DEFAULT; 
   RetCode = INTEGER NOT NULL WITH DEFAULT;  
ENDDECLARE
BEGIN
/*
** get the next email notification id
*/
   RequestID = 0;
   SELECT :RequestID = MAX(RequestID)
   FROM   FMS_EmailNotification;
   
   RequestID = RequestID + 1;
/*
** save report to the database
*/
   Message1 = 'Application=FMS;;' +
              'Priority=High;;' + 
              'ReportedBy=FMS;;' + 
              'UserEmail=rringres@coned.com;;' + 
              'Subject=Feeder ' + CurObject.FeederName + ' failed to pass validation;;';
   Message2 = 'Description=Please fix validation error(s):' + HC_NEWLINE + CurObject.ErrorMessage +
              'You may contact DO ' + DOp.Description + ' for guidance.;;';

   RetCode = CALLPROC FMS_EmailNotificationIns(
                            RequestID = RequestID,
                            RequestTime = DATE('now'),
                            EmailType = 8,
                            Sender = 'FMS',
                            Recipient = 'SupportEmail',		// CSD Monitor will get the actual address
                            Subject = 'FMS Feeder ' + CurObject.FeederName + ' Validation Error',
                            Message1 = Message1,
                            Message2 = Message2,
                            Template = 'DOSProblemReport.html');
   IF RetCode = 0 THEN 
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = 'Error: FeederSetup.ReportToStaff; Failed to save problem report to the database.');
      RETURN;
   ENDIF;
/*
** Raise a db event to CSD Monitor
*/
   EventID = CALLPROC FMS_DBEventQueueIns(
                 Time = DATE('NOW'),
                 Name = 'FMS_EmailNotification',
                 Text = VARCHAR(RequestID),
                 ToApp = 'CSD',
                 FromApp = 'BugReport');
   IF EventID < 0 THEN
      CALLPROC DDB_ROLLBACK;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;  
  
   DBEventText = VARCHAR(EventID) + ';FMS_BugReport;' + VARCHAR(RequestID);
   CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_EmailDBEvent',
                             DBEventText = DBEventText);
   CALLPROC DDB_COMMIT;

   RETURN;
END;

METHOD DisableConnectedSource(
) = 
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   RetCode = CALLPROC FMS_ConnectedSourceDel(Feeder = CurObject.Feeder);
   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = 'Error: FeederSetup.DisableConnectedSource; Failed to disable connected source flag for' +  CurObject.FeederName);
   ENDIF;
END;

