**  from an officer of Unified Information, Inc.
**
**
**  Application:    CAC
**  Frame:          TFMS_RelaySummary
**
**  Modification log:
**
**  Date:     Version   Description 
** --------------------------------------------------        
**  10/25/96   pkw  Created for tfms relays
**  11/21/96   ysp  itc19: use common relay operation tables and handle relay
**                  update events
**  01/15/97   jfl  tfms23: Support for archived card
**  03/28/97   jfl  itc39: Official support for archived card
**  04/29/99   pkw  bring over from TFMS
**  08/12/99   em   CardType field will not be populated for Archived Relays
**                  from SOA - and can disappear entirely when FMS is merged
**  08/18/05   em   Add Relay Targets returned from SSO
**  09/01/05   em   Remove Toggle Indicator; 
**  08/11/08   ysp  add CurFrame.Flush after loading SSO return Relays
**  04/17/09   ysp  Prompt DO to select the SSO who returns the relay infor and insert log.
**  12/23/11   pkw  Add Substation Column to Relays and use classes to load data to be 
**                  consistent with TOMS Online.
**  05/13/15   pkw  Pass archive database if necessary
**  12/16/15   ysp  1. Pass blank for prod and test database to relay_report script
**                  2. Add Substation Name to tables and Email to TO button
**  03/29/16   ysp  Send in email only relays from substations controlled by DO desk. 
**  05/23/16   pkw  Limit Equipment list (hard code to make sure Mike is ok, put in constants 
**                  if he is satisfied), Insert if they select blank row.
**  06/02/16   pkw  Update hardcoded constants with real constants.
**  10/05/16   ysp  Reverse the change made on 03/29/16
**  09/09/22   ysp  replace vb script by powershell script that displays reports from FMS_ReportService web site.
*/

INITIALIZE   
(
#   include StandardDeclarations
    Card = INTEGER NOT NULL;     /*P: Passed card */
    DefaultStation = INTEGER NOT NULL;  /*P: Passed station from promptRelayTargetsFromSSO */
) =
DECLARE
    Activated = DATE;
    EquipList = ARRAY OF CAC_Relay;
    FeederNames = VARCHAR(200) NOT NULL WITH DEFAULT;
    RowNum     = INTEGER NOT NULL WITH DEFAULT;   
    DataUpd    = INTEGER NOT NULL WITH DEFAULT;   
    NewID      = INTEGER NOT NULL WITH DEFAULT;   
    j          = INTEGER NOT NULL WITH DEFAULT;   
    k          = INTEGER NOT NULL WITH DEFAULT;   
    ModifyFlag = VARCHAR(10) NOT NULL WITH DEFAULT;
    CL         = ChoiceList;                       
    RelayClass = ARRAY OF CAC_RelayClass;

    TgtRelayOp    = CAC_Relay;
    ControlAppInt = INTEGER NOT NULL WITH DEFAULT;
    ControlActionName = VARCHAR(10) NOT NULL WITH DEFAULT;
    RelayOp       = INTEGER NOT NULL WITH DEFAULT;
    Foundit       = INTEGER NOT NULL WITH DEFAULT;
    Relays 	  = SSO_Relays_ASE DEFAULT NULL;
    SimpleRelay = Relay_ASE DEFAULT NULL; /* Enables use of class methods */
    PDFTitle = VARCHAR(100) NOT NULL WITH DEFAULT;
    PDFLocation = Varchar(120) NOT NULL WITH DEFAULT;

    GeneratePDFFile = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF ArchiveCard = FALSE THEN
      SELECT :FeederNames = T.FeederNames,
             :Activated = C.Activated
      FROM   TFMS_Card T,
             SOA_Card C
      WHERE  T.Card = :Card AND
             T.Card = C.Card;
   ELSE
      SELECT :FeederNames = T.FeederNames,
             :Activated = T.Activated
      FROM   TFMS_ArchiveCard T
      WHERE  T.Card = :Card;   
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   PDFTitle = 'Relay Targets for Feeder ' + FeederNames + 
              ' Open Auto on ' +  FormatDate (RawDate = IFNULL(Activated, ''), Format = 'DEFAULT');
/*
** Get the SSO return Relays, 
*/
   Relays = SSO_Relays_ASE.Create();
   Relays.Card = Card;
   Relays.ArchiveCard = ArchiveCard;
   Relays.SwitchingItem = 0;
   RetCode = Relays.GetSSORelaysbyCard();

   IF RetCode = 0 THEN
      FIELD(RT).CurBias = FB_INVISIBLE;
   ELSE
      RT.Clear();
      VRT.Clear();
      j = 1;
      k = 1;
      FOR i = 1 TO Relays.RT.LastRow DO
         IF Relays.RT[i].IsVerbal = TRUE THEN
            VRT[j] = Relays.RT[i].Duplicate();
            j = j + 1;
         ELSE
            RT[k] = Relays.RT[i].Duplicate();
            k = k + 1;
         ENDIF;
      ENDFOR;
      IF k = 1 THEN
         FIELD(RT).CurBias = FB_INVISIBLE;
      ENDIF;
   ENDIF;
   CurFrame.Flush();

/*
**  Load relay info
*/
   IF SimpleRelay IS NULL THEN
      SimpleRelay = Relay_ASE.Create();
   ENDIF;
     
   SimpleRelay.Card = Card;    
   SimpleRelay.ArchiveCard = ArchiveCard;
   SimpleRelay.CardType = Type$TFMSApp;
   SimpleRelay.SwitchingItem = 0;
   SimpleRelay.UpdateMode = 1;  /* Always load all data */
    
   SimpleRelay.LoadRelaySummary();
   
   IF SimpleRelay.ReturnCode <> 0 THEN
      Message SimpleRelay.ErrorMessage;
      RETURN;
   ENDIF;

   /*
   **  Show old style of relay if user is looking at pre-2016 summer card.
   */
   Relay.Clear();
   Relay = SimpleRelay.ROpList.Duplicate();
   IF Relay.LastRow = 0 THEN
      FIELD(Relay).CurBias = FB_INVISIBLE;
   ENDIF;

   RelayClass.Clear();
   RelayClass = SimpleRelay.RClasses.Duplicate();

/*
**  Select all of the relay classes into the
**  choicelist.
*/
    CL.ChoiceItems.Clear();
    CL.ChoiceItems[1].EnumText = '';
    CL.ChoiceItems[1].EnumValue = 0;

/*
**   Load equip arrays for feeders
*/      
    EquipList.Clear();

    EquipList[1].SubstationName = '';
    EquipList[1].Substation = 0;
    EquipList[1].EquipName = '';
    EquipList[1].EquipClass = 0;
    EquipList[1].EquipClassName = '';
    i = 2;
    IF ArchiveCard = FALSE THEN
      REPEATED
      SELECT DISTINCT
            :EquipList[i].SubstationName = OS.Description,
            :EquipList[i].Substation = OS.Object,
            :EquipList[i].Equip = O.Object,
            :EquipList[i].EquipName = O.Name,
            :EquipList[i].EquipClass = O.type,
            :EquipList[i].EquipClassName = O.TypeName
      FROM    Udb_Object O,
              Udb_Object OS,
              Udb_Grouping G,
              Udb_Grouping G1,
              Udb_ExtendedType ET1,
              TFMS_CardToObject T,
              Udb_ExtendedType ET
      WHERE   T.Card = :Card AND
              T.Type = :Type$TransmissionFdr AND
              T.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              O.Type = ET.Type AND
              ET.SuperType IN (:Type$Generator,
                               :Type$Reactor,
                               :Type$Transformer,
                               :Type$ACLineSegment,
                               :Type$LoadBreaking) AND 
              O.Object = G1.Member AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.GroupingType = ET1.Type AND
              ET1.SuperType = :Type$Substation AND
              G1.Grouping = OS.Object
      ORDER BY EquipName
      BEGIN
         i = i + 1; 
      END;
      CALLPROC DDB_ROLLBACK;
/*
** Archived Card
*/
    ELSE
      REPEATED
      SELECT DISTINCT
            :EquipList[i].SubstationName = OS.Description,
            :EquipList[i].Substation = OS.Object,
            :EquipList[i].Equip = O.Object,
            :EquipList[i].EquipName = O.Name,
            :EquipList[i].EquipClass = O.type,
            :EquipList[i].EquipClassName = O.TypeName
      FROM    Udb_Object O,
              Udb_Object OS,
              Udb_Grouping G,
              Udb_Grouping G1,
              Udb_ExtendedType ET1,
              TFMS_ArchiveCardToObject T,
              Udb_ExtendedType ET
      WHERE   T.Card = :Card AND
              T.Type = :Type$TransmissionFdr AND
              T.Object = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              O.Type = ET.Type AND
              ET.SuperType IN (:Type$Generator,
                               :Type$Reactor,
                               :Type$Transformer,
                               :Type$ACLineSegment,
                               :Type$LoadBreaking) AND /* = :Type$Conducting AND */
              O.Object = G1.Member AND
              G1.Relationship = :Interaction$MemberOf AND
              G1.GroupingType = ET1.Type AND
              ET1.SuperType = :Type$Substation AND
              G1.Grouping = OS.Object
      ORDER BY EquipName
      BEGIN
          i = i + 1; 
      END;
      CALLPROC DDB_ROLLBACK;
      FIELD(Insert_Relay_Btn).CurBias = FB_DIMMED;
      FIELD(Update_Relay_Btn).CurBias = FB_DIMMED;
      FIELD(Delete_Relay_Btn).CurBias = FB_DIMMED;

    ENDIF;
  
    StationList.Clear();
    i = 1;
    IF DefaultStation <> 0 THEN
       CurFrame.SendUserEvent(Eventname = 'InsertRelay');

       SELECT DISTINCT
            :StationList[i].SubstationName = O.Description,
            :StationList[i].Substation = O.Object
       FROM  Udb_Object O
       WHERE O.Object = :DefaultStation;

    ELSE
       SELECT DISTINCT
            :StationList[i].SubstationName = O.Description,
            :StationList[i].Substation = O.Object
       FROM  TFMS_CardToObject T,
             Udb_Object O
       WHERE T.Card = :Card AND
             T.Type = :Type$Substation AND
             T.Object = O.Object
       BEGIN
          i = i + 1;
       END;
       
    ENDIF;
    FIELD(StationList).NumVisibleRows = StationList.LastRow;
/*
**  Place popup items in proper place.  Use i to figure out width of border.
*/
    i = (Field(StationList).OuterWidth -Field(StationList).Width)/2;
    Field(WA).AbsYBottom = Field(Delete_Relay_Btn).AbsYBottom;
    Field(WA).AbsXLeft = Field(VRT).AbsXLeft - StackField(Field(wa)).ChildLeftMargin - i;

    Field(StationList).AbsYTop = Field(WA.TF).TableHeader.AbsYBottom;
    Field(StationList).AbsXLeft = Field(WA.TF).TableHeader.ChildFields[1].AbsXLeft - i;

    Field(StationEquipList).AbsYTop = Field(WA.TF).TableHeader.AbsYBottom;
    Field(StationEquipList).AbsXLeft = Field(WA.TF).TableHeader.ChildFields[4].AbsXLeft - i;

    DataUpd = FALSE;
    CurFrame.Flush();
END;

ON InsertRow VRT,
ON UserEvent 'InsertRelay',
ON Click Insert_Relay_Btn =
BEGIN
    IF CurFrame.TriggerField IS NOT NULL THEN
       IF lowercase(Curframe.Triggerfield.Name) <> 'insert_relay_btn' THEN
          VRT.RemoveRow(RowNumber = VRT.LastRow);
       ENDIF;
    ENDIF;
/*
**  Clear table and insert new row
*/
    WA.TF.Clear();
    WA.TF.InsertRow(RowNumber = 1);
    WA.TF[1].TimeStamp = 'now';
    WA.TF[1].Job = Card;
/*
**  Only allow them work in workarea
*/
    Field(Close_btn).ParentField.CurBias = FB_VISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;
    
    IF DefaultStation <> 0 THEN
       WA.TF[1].Substation = StationList[1].Substation;
       WA.TF[1].SubstationName = StationList[1].SubstationName;
       StationEquipList.Clear();
       j = 1;
       FOR i = 1 TO EquipList.LastRow DO
          IF EquipList[i].Substation = WA.TF[1].Substation THEN
             StationEquipList[j] = EquipList[i].Duplicate();
             j = j + 1;
          ENDIF;
       ENDFOR;
    ELSE
       CurFrame.SendUserEvent(EventName = 'PickStation');
    ENDIF;

    ModifyFlag = 'Insert';

END;

ON Click Update_Relay_Btn =
BEGIN
/*
**  Find which row we are updating
*/
    RowNum = 0;
    RowNum = Field(VRT).CurRow;
    IF RowNum = 0 THEN
       message 'You must select which relay you want to modify.';
       RESUME;
    ENDIF;
/*
**  Clear table and insert new row
*/
    WA.TF.Clear();
    WA.TF.InsertRow(RowNumber = 1, RowObject = VRT[RowNum].Duplicate());
    WA.TF[1].TimeStamp = 'now';
/*
**  Only allow them work in workarea
*/
    Field(Close_btn).ParentField.CurBias = FB_Visible;
    CurFrame.Flush();
    Field(WA).Curbias = FB_CHANGEABLE;

    ModifyFlag = 'Update';

END;

ON Click Delete_Relay_Btn =
BEGIN
/*
**  Find which row we are deleting
*/
    RowNum = 0;
    RowNum = Field(VRT).CurRow;
    IF RowNum = 0 THEN
       message 'You must select which relay you want to delete.';
       RESUME;
    ENDIF;
/*
**  Delete row from table and database.
*/
    IF CurFrame.ConfirmPopup (MessageText = 'Deleting Relay:  ' +
                VRT[RowNum].RelayName) = PU_OK THEN

       RetCode = CALLPROC IR_RelayTargetDel(
                                    Job = VRT[RowNum].Job,
                                    Sequence = VRT[RowNum].Sequence);
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Not able to remove relay.  Please try again.';
          RESUME;
       ENDIF;
       CALLPROC DDB_COMMIT;
       VRT.RemoveRow(rownumber = RowNum);
       DataUpd = TRUE;
    ENDIF;
END;

ON Click WA.OK_Btn =
BEGIN
    IF WA.TF[1].RelayName = '' THEN
       message 'You must enter a Relay name.';
       RESUME;
    ENDIF;
    IF WA.TF[1].Sequence = 0 THEN
       SELECT WA.TF[1].Sequence = IFNULL(Max(Sequence),0) + 1
       FROM   IR_RelayTargets RT,
              SOA_JobControl JC
       WHERE  JC.Card = :Card AND
             (JC.Job = RT.Job OR
              JC.Card = RT.Job);
    ENDIF;
/*
**  Insert/Update row in DB
*/
    RetCode = CALLPROC IR_RelayTargetIns (
                                     Job = WA.TF[1].Job
                                    ,Substation = WA.TF[1].Substation          
                                    ,SubstationName = WA.TF[1].SubstationName          
                                    ,RelayName = WA.TF[1].RelayName     
                                    ,Line = WA.TF[1].Line          
                                    ,TypeA = WA.TF[1].TypeA
                                    ,TypeB = WA.TF[1].TypeB
                                    ,TypeC = WA.TF[1].TypeC
                                    ,TypeTime = WA.TF[1].TypeTime
                                    ,TypeInst = WA.TF[1].TypeInst
                                    ,TypeText = WA.TF[1].TypeText 
                                    ,Equipment = WA.TF[1].Equipment         
                                    ,isVerbal = TRUE 
                                    ,Sequence = WA.TF[1].Sequence     
                                    ,Comment = WA.TF[1].Comment   
                                    ,TimeStamp = WA.TF[1].TimeStamp);
    IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Failed to Insert/Update Relay Target, please try again.';
       RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;

    IF ModifyFlag = 'Insert' THEN

       i = VRT.LastRow() + 1;
       VRT.InsertRow(RowNumber = i, RowObject = WA.TF[1].Duplicate());

    ELSEIF ModifyFlag = 'Update' THEN

       VRT[RowNum] = WA.TF[1].Duplicate();
    ENDIF;

    Field(Close_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
    DataUpd = TRUE;
END;

ON Click WA.Cancel_Btn =
BEGIN
    Field(Close_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
END;

ON ChildEntry WA.TF[*].Line = 
BEGIN
   IF WA.TF[1].Line = '' THEN
      WA.TF[1].Line = '1ST';
   ELSEIF WA.TF[1].Line = '1ST' THEN
      WA.TF[1].Line = '2ND';
   ELSEIF WA.TF[1].Line = '2ND' THEN
      WA.TF[1].Line = '';
   ENDIF;
   CurFrame.InputFocusField = FIELD(WA.Cancel_btn);
END;

ON UserEvent 'PickStation',
ON ChildEntry WA.TF[*].SubstationName =
BEGIN
    Field(StationList).CurBias = FB_LANDABLE;
    Field(WA).Curbias = FB_VISIBLE;
END;

ON ChildEntry WA.TF[*].Equipment = 
BEGIN
    IF WA.TF[1].Substation = 0 THEN
       CurFrame.SendUserEvent(EventName = 'PickStation');
       RESUME NEXT;
    ENDIF;
    Field(StationEquipList).CurBias = FB_LANDABLE;
    Field(WA).Curbias = FB_VISIBLE;
END;

ON ChildEntry StationList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;
    i = Field(StationList).CurRow;
   
    Field(StationList).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;

    WA.TF[1].SubstationName = StationList[i].SubstationName;
    WA.TF[1].Substation = StationList[i].Substation;
    WA.TF[1].Equipment = '';
    StationEquipList.Clear();
    j = 1;
    FOR i = 1 TO EquipList.LastRow DO
       IF EquipList[i].Substation = WA.TF[1].Substation THEN
          StationEquipList[j] = EquipList[i].Duplicate();
          j = j + 1;
       ENDIF;
    ENDFOR;
END;

ON ChildEntry StationEquipList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;
    i = Field(StationEquipList).CurRow;
   
    Field(StationEquipList).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;

    WA.TF[1].Equipment = StationEquipList[i].EquipName;
END;

ON CLICK Menu.File.Close_btn,
ON Click Close_Btn =
BEGIN
    IF DataUpd = TRUE AND DefaultStation = 0 THEN
       RetCode = CALLFRAME SelectOperator (AnyName = TRUE, 
                                        Title = 'Select Substation Operator who Reports Relay Targets');
       IF RetCode = PU_OK THEN
          CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = NULL,
                 SwitchingItem = null,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = '',
                 New  = FO.Description + ' returned relay information');   
       ENDIF;

       SOAFrame.SendUserEvent( eventname = 'CheckRelayStatus' );
       SOAFrame.SendUserEvent( eventname = 'UpdateProtectionButton' );
    ENDIF;
    RETURN;
END;

ON DBEvent 'CAC_RelayOp_Update' =
BEGIN
/*
**  Parse out the necessary information from the event text.
**  The event text is separated by ';' and may contain Action 
**  description (insert, update, delete), RelayOp index and
**  a list of cards.
*/
   ControlText = CurFrame.DBEvent.DBEventText;

   ControlActionName = left(controltext,(locate(controltext,';')-1));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   RelayOp = int4(left(controltext,(locate(controltext,';')-1)));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   Foundit = FALSE;
   i = locate(ControlText,';');
   WHILE i <= size(ControlText) DO
       ControlCard = int4(left(ControlText,(locate(controltext,':')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,':'))));

       ControlAppInt  = int4(left(ControlText,(locate(controltext,';')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

       IF ControlCard = Card AND ControlAppInt = Type$TFMSApp THEN
          Foundit = TRUE;
          ENDLOOP;
       ELSE
          i = locate(ControlText,';');
       ENDIF;
   ENDWHILE;
/*
** If our card is not in the card list, it has nothing to do with us or this
** event originated from this card. Quit.
*/
   IF Foundit = FALSE THEN
      RESUME;
   ENDIF;
/* 
** As long as the request is not to delete, retrieve new data from database 
*/
   IF ControlActionName not like 'DELETE' THEN
      REPEATED
      SELECT :TgtRelayOp.RelayOp = R.RelayOp,
             :TgtRelayOp.Trip = R.Trip,
             :TgtRelayOp.Line = R.Line,
             :TgtRelayOp.FeederName = R.FeederName,
             :TgtRelayOp.Equip = R.Equip,
             :TgtRelayOp.EquipName = R.EquipName,
             :TgtRelayOp.EquipClass = R.EquipClass,
             :TgtRelayOp.EquipClassName = R.EquipClassName,
             :TgtRelayOp.RelayType = R.RelayType,
             :TgtRelayOp.RelayTypeName = R.RelayTypeName,
             :TgtRelayOp.RelayClass = R.RelayClass,
             :TgtRelayOp.RelayClassName = R.RelayClassName,
             :TgtRelayOp.RelayName = R.RelayName,
             :TgtRelayOp.Operation = R.Operation,
             :TgtRelayOp.TimeStamp = R.TimeStamp,
             :TgtRelayOp.OutOfService = R.OutOfService,
             :TgtRelayOp.Compromised = R.Compromised,
             :TgtRelayOp.Status = ''
      FROM    CAC_RelayOps R
      WHERE   R.RelayOp = :RelayOp;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

/* update the relay summary table */

   IF ControlActionName like 'INSERT' THEN   
      i = Relay.LastRow() + 1;
      Relay.InsertRow (RowNumber = i,
                       RowObject = TgtRelayOp.Duplicate());

   ELSEIF ControlActionName like 'UPDATE' THEN 
      Foundit = FALSE;
      i = 1; 
      WHILE i <= Relay.LastRow() DO
         IF Relay[i].RelayOp = RelayOp THEN
            Foundit = TRUE;
            ENDLOOP;
         ELSE
            i = i + 1;
         ENDIF;
      ENDWHILE;

      IF Foundit = TRUE THEN
         Relay[i] = TgtRelayOp.Duplicate();
      ELSE
         CurFrame.Trace (messageText = 'missing relay entry for update.');
      ENDIF

   ELSEIF ControlActionName like 'DELETE' THEN   
      Foundit = FALSE;
      i = 1; 
      WHILE i <= Relay.LastRow() DO
         IF Relay[i].RelayOp = RelayOp THEN
            Foundit = TRUE;
            ENDLOOP;
         ELSE
            i = i + 1;
         ENDIF;
      ENDWHILE;

      IF Foundit = TRUE THEN
         Relay.RemoveRow (RowNumber = i);
      ELSE
         CurFrame.Trace (messageText = 'missing relay entry for deletion.');
      ENDIF
   ENDIF;
END;


ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;

ON CLICK PDF_Btn =
BEGIN
   CALLPROC GeneratePDFFile(ShowFlag = 1);
END;

ON CLICK EMAIL_Btn =
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurSession.ProcessWindow = FALSE;
   CurSession.ProcessWait = TRUE;
   
   RetCode = CALLPROC GeneratePDFFile(ShowFlag = 0);
   CurSession.ProcessWait = FALSE;

   IF RetCode <> TRUE THEN
      Message 'Unable to generate relay report to email to Transmission Operator';
      RESUME;
   ENDIF;
/*
** Send email to TO
*/
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 15;
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'TO';
   EmailClass.Subject = 'Relay Targets for Feeder ' + FeederNames;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                         'App=TFMS;;' + 
                         'CardID=' + VARCHAR(Card) + ';;' + 
                         'Equipment=feeder ' + FeederNames + ';;';
   EmailClass.Message2 = 'Title=' + PDFTitle + ';;';
   EmailClass.Template = 'RelaySummaryToTO.html';
   
   EmailClass.Attachments[1].FileName = 'relay_' + VARCHAR(Card) + '.pdf';
   EmailClass.Attachments[1].Location = PDFLocation;
   
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      Message 'Unable to send relay information to Transmission Operator by email';
   ELSE
      Message 'Relay targets sent sucessfully';
   ENDIF;
END;

ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

PROCEDURE GeneratePDFFile(
   ShowFlag = INTEGER NOT NULL,
   ShowByDesk = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE
   PDFDir = Varchar(100) NOT NULL WITH DEFAULT;   
   PDFCommand = Varchar(600) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   PDFDir = CurSession.GetEnv(Name = 'FMS_Misc');
   
/*
** 09/09/22: replaced by powershell script that displays reports from FMS_ReportService web site.
**  
   PDFCommand = 'wscript ' + PDFDir + '\relay_report.vbs "TFMS" ' + 
                                       varchar(ArchiveCard) + ' ' +
                                       varchar(Card) + ' ' +
                                       varchar(0) + ' ' +      /* Switching Item *
                                       '1 ' +                  /* Always call in update from TFMS *
                                       '"' + PDFTitle + '" '; 
*/

   PDFCommand = 'powershell.exe -ExecutionPolicy ByPass -WindowStyle Hidden -File "' + 
                                       PDFDir + '\PrintReport.ps1" RELAY TFMS ' +
                                       varchar(ArchiveCard) + ' ' +
                                       varchar(Card) + ' ' +
                                       varchar(0) + ' ' +      /* Switching Item */
                                       '1 ' +                  /* Always call in update from TFMS */
                                       '"' + PDFTitle + '" '; 

   IF Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_1%' escape '\' OR
      Lowercase(DDB_Global.Session.Cur.Database) like '%fms\_2%' escape '\' THEN
      PDFCommand = PDFCommand + DDB_Global.Session.Cur.Database;
   ELSE
      PDFCommand = PDFCommand + '""';
   ENDIF;
   
   PDFCommand = PDFCommand + ' ' + VARCHAR(ShowFlag);

   IF ShowByDesk = 1 THEN
      PDFCommand = PDFCommand + ' ' + VARCHAR(UserDesk);
   ENDIF;
      
   CurFrame.Trace (PDFCommand);
   CALL System PDFCommand; 

   IF ShowFlag = 0 THEN
      // check if the pdf file is generated
      PDFLocation = PDFDir + '\report\relay_' + VARCHAR(Card) + '.pdf';
      RetCode = CurSession.FileExists(FileName = PDFLocation);
      RETURN RetCode;
   ELSE
      RETURN FALSE;        // pdf was deleted
   ENDIF;   
END;

