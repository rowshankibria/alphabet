**                  are initiated.
** 07/08/08  pkw    Add check for ATS load feeders.
** 07/23/08  pkw    Add FOT cards to list of valid tv bogey types.
** 04/14/09  em     Add KPSFeeder parm, if set will prevent certain action.
** 08/13/09  em     For KPSFeeder, if source breaker is already open, use TOCompletion
**                  timestamp for KPSFeeder CutOut time.
** 09/03/09  em     Removed 8/13 Enhancement, all KPS to be CutOut at CutIn of main feeder  
** 06/16/10  em     Updated for 3G Feeders to not use C.Feeder
** 07/05/10  em     If on a Network feeder make sure it is not sourced from the other 
**                  station.
** 11/01/10  em     Set C/O status for each feeder on 3G card.
** 11/17/10  em     Added parameter specific to 3G Feeder Cutout.
** 11/18/10  em     Certain 3G Feeders will cutout but not require shadow item.  Look for Substation first.
** 03/08/11  em     When looking for 3G alternate source, use connectivity if source connected.
** 07/26/11  pkw    Don't track TV on weekends or July 4th.
** 01/03/12  em     Restore feeder restrictions that may have been lifted prior to CutOut
** 06/20/12  em     Restore KP ISO process for JIP = NULL
** 06/20/12  pkw    Use Udb_Extendedtype when selecting ATS equipment
** 11/29/12  pkw    If cutout 13kv card and link exists to step down card then cut out 
**                  step down card if SD-VIS is closed.
** 01/09/12  em     Remove reference to PendingSoccsxMessage
** 02/07/13  em     Remove warning for 4KV Shadow Item placement since StepDown 4kV
**                  Stations don't have cards. Will impact Unit Substations also but we
**                  don't care about those.  
** 07/18/13  pkw    Stop checking for TV Bogeys at 3pm Friday instead of 6 pm.
** 08/15/13  em     Re-Use KPSFeeder and Feeder3GCutOut parms for Sectional Feeder
** 09/04/15  em     When Cutting Out ATSLoadP feeder, automatically set DBF feeder Status
** 02/08/16  em     Must look for JIP NULL before evaluating ATSLoadP
** 04/21/16  em     Modified selection of network feeders.
** 05/06/16  em     Ignore feeder sections fed by another feeder when setting C/O
** 07/14/16  ysp    Send incoming message to DO when a feeder feeding other feeders are cut out
** 07/24/18  em     Auto Issue to FOD Verify L&P Swapped move when cutting out feeder with L&P Unit ATS equip
** 09/12/18  em     Apply L&P Swapped move to each L&P Unit ATS on feeder
** 11/26/18  em     Send CIG the latest CutOut timestamp second cutout.
** 01/23/19  pkw    Check to see if the Cutout time is a CERC day when processing TV_Bogey
** 01/30/19  pkw    Update 4th of July logic
** 01/30/19  pkw    Don't track TV for 4kv cards
** 07/22/19  pkw    Make sure to track CERC outages from 1500 to 1800 on Friday night.
** 07/16/20  em     Exclude auto fod issue on 3G network feeder card.
** 02/01/23  em     New Auto FOD Order for Verify DM Eaton Switch Closed, copy Verify L&P Swapped logic and apply to Auto/OOE1 cards only.
** 04/20/23  em     Extend DM Eaton to CIOA card and limit select to switch with name ending in '-101'
*/

INITIALIZE
(
    JIP = JobInProgress;        /* Job being processed */
    Feeder = INTEGER NOT NULL WITH DEFAULT; /* Optional; special processing */
    NoATSLoad = INTEGER NOT NULL WITH DEFAULT; /* Optional; See ATSLoad class */
    KPSFeeder = INTEGER NOT NULL WITH DEFAULT; /* Optional;  */
    Feeder3GCutOut = DATE DEFAULT NULL; /* Optional; supports 3G reconfiguration leading to cutout card.*/

    PT = Varchar(20);           /* Prompt text */
    i = INTEGER NOT NULL;       /* counter variable */  
    k = INTEGER NOT NULL;       /* counter variable */  
    m = INTEGER NOT NULL;       /* counter variable */  
    n = INTEGER NOT NULL;       /* counter variable */  
    p = INTEGER NOT NULL;       /* counter variable */  
    x = INTEGER NOT NULL;       /* return variable */
    RetCode = INTEGER NOT NULL;       /* return variable */

    ActiveSourceCards = ARRAY OF FMS_Card; /* Active cards where equip is the source*/  
    ATSList  = Array of GrouperInfo;  /*  List of ATS for current feeder */
    ATSStatus = INTEGER NOT NULL WITH DEFAULT;
    ManATSList  = Array of GrouperInfo;  /*  List of manual ATS for current feeder */
    LocSwitch = INTEGER NOT NULL;
    AltSwitch = INTEGER NOT NULL;
    AltFeeder = INTEGER NOT NULL;
    AltFeederStatus = INTEGER NOT NULL;
    NormalOpen = INTEGER NOT NULL;
    CurrentlyOpen = INTEGER NOT NULL;
    BarrierOnFeeder = INTEGER NOT NULL WITH DEFAULT;
    ControlText = Varchar(256) NOT NULL WITH DEFAULT;

    DynamicWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
    Equip = INTEGER NOT NULL;
    EquipItem = INTEGER NOT NULL;   
    EquipList = VARCHAR(800) NOT NULL WITH DEFAULT; /*Common Equipment*/
    EventText = Varchar(256) NOT NULL WITH DEFAULT;
    ImpactedCardList = ARRAY OF INTEGEROBJECT;  
    InsertShItem = NewMoveCard;                   /*Insert move into shadow item*/
    ISOCount = INTEGER NOT NULL WITH DEFAULT;     /*Count of isolation moves*/
    LastEquip = INTEGER NOT NULL;   
    LPUnitATS  = Array OF FMS_Equip;
    NetworkFeeders = ARRAY OF INTEGEROBJECT;
    NewItem = SwitchingItem;                    /*Used to build Shadow Item*/
    SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
    SItem = ARRAY OF Job;                       /*Propagate moves*/
    STAMove = INTEGER NOT NULL WITH DEFAULT;    /*Outstanding STA Move existence*/
    SubstationCard = INTEGER NOT NULL WITH DEFAULT;
    CutOut = DATE;                              /* CutOut Time */
    CIGCutOut = DATE;
    ConnectedSource = INTEGER NOT NULL WITH DEFAULT;
    ATS = ATSLoad; 
) =
DECLARE
    StepDownCard = ARRAY OF FMS_Card;
    FedByList = ARRAY OF FMS_Card;    /* cards fed by feeders where equip is the source*/  
    TV_BogeyCheck = PROCEDURE;
    CheckForOther3GSource = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Evaluate Feeder Parm - if set process single card.
*/
    IF Feeder <> 0 THEN
       ActiveSourceCards.Clear();
       BarrierOnFeeder = 0;
       SELECT  :BarrierOnFeeder = Object
       FROM    FMS_ObjectStatus
       WHERE   Object = :Feeder AND
               Status = :Status$Barrier;

       IF BarrierOnFeeder = 0 THEN
          i = 1;
          REPEATED 
          SELECT DISTINCT
             :ActiveSourceCards[i].Card = C.Card,
             :ActiveSourceCards[i].Feeder = CTO.Object,
             :ActiveSourceCards[i].FeederName = C.FeederName,
             :ActiveSourceCards[i].SubstationName = C.SubstationName,
             :ActiveSourceCards[i].Position = C.Position,
             :ActiveSourceCards[i].EstTimeComplete = C.EstTimeComplete,
             :ActiveSourceCards[i].EstTimeInService = C.EstTimeInService,
             :ActiveSourceCards[i].CutOut = C.CutOut,
             :ActiveSourceCards[i].CardClass = C.CardClass,
             :ActiveSourceCards[i].CardClassName = C.CardClassName,
             :ActiveSourceCards[i].NetworkFeeder = C.NetworkFeeder,
             :ActiveSourceCards[i].TypeOfCard = C.TypeOfCard
          FROM     FMS_Card C,
                   SOA_ActiveCard AC,
                   TFMS_CardToObject CTO
          WHERE    AC.Card = C.Card AND
                  (C.CutOut IS NULL OR
                   C.CutIn IS NOT NULL) AND
                   C.Card = CTO.Card AND
                   CTO.Object = :Feeder;
       ENDIF;
 
       IF ActiveSourceCards.LastRow() = 0 THEN
          RETURN (PU_OK);
       ENDIF;
/*
** If we have network feeder, then we look for another substation source
** before allowing CutOut.  Only one card will be selected for this feeder.
*/
       IF ActiveSourceCards[1].NetworkFeeder = NetworkFeeder$3G THEN
          RetCode = CALLPROC CheckForOther3GSource (
                           Feeder = IFNULL(ActiveSourceCards[1].Feeder, 0),
                           Card = IFNULL(ActiveSourceCards[1].Card, 0));
          IF RetCode = PU_CANCEL THEN
             RETURN(PU_OK);
          ENDIF;
       ENDIF; 
  
    ELSE
/*
**  Select all active cards where the equipment is the source for the feeder,
**  don't include feeders that have a Barrier status.
*/  
       i = 1;
       REPEATED 
       SELECT DISTINCT 
             :ActiveSourceCards[i].Card = C.Card,
             :ActiveSourceCards[i].Feeder = G.Grouping,
             :ActiveSourceCards[i].FeederName = C.FeederName,
             :ActiveSourceCards[i].SubstationName = C.SubstationName,
             :ActiveSourceCards[i].Position = C.Position,
             :ActiveSourceCards[i].EstTimeComplete = C.EstTimeComplete,
             :ActiveSourceCards[i].EstTimeInService = C.EstTimeInService,
             :ActiveSourceCards[i].CutOut = C.CutOut,
             :ActiveSourceCards[i].CardClass = C.CardClass,
             :ActiveSourceCards[i].CardClassName = C.CardClassName,
             :ActiveSourceCards[i].NetworkFeeder = C.NetworkFeeder,
             :ActiveSourceCards[i].TypeOfCard = C.TypeOfCard
       FROM   FMS_Card C,
              TFMS_CardToObject CTO,
              SOA_ActiveCard AC,
              Udb_Grouping G
       WHERE  AC.Card = C.Card AND
              (C.CutOut IS NULL OR
              C.CutIn IS NOT NULL) AND
              C.Card = CTO.Card AND
              CTO.Object = G.Grouping AND
              G.Relationship = :Interaction$SourceBreaker AND
              G.Member = :JIP.Equip 
       BEGIN
           BarrierOnFeeder = 0;
           SELECT  :BarrierOnFeeder = Object
           FROM    FMS_ObjectStatus
           WHERE   Object = :ActiveSourceCards[i].Feeder AND
                   Status = :Status$Barrier;
/*
** Don't process CutOut for this feeder if ConnectedSource flag is set.
*/
           ConnectedSource = 0;
           SELECT :ConnectedSource = Feeder
           FROM   FMS_ConnectedSource
           WHERE  Feeder = :ActiveSourceCards[i].Feeder;
           
           IF BarrierOnFeeder = 0 AND ConnectedSource = 0 THEN
/*
** If we have network feeder, then we look for another substation source
** before allowing CutOut.
*/
              IF ActiveSourceCards[i].NetworkFeeder = NetworkFeeder$3G THEN
                 RetCode = CALLPROC CheckForOther3GSource (
                              Feeder = IFNULL(ActiveSourceCards[i].Feeder,0),
                              Card = IFNULL(ActiveSourceCards[i].Card,0));
                 IF RetCode = PU_CANCEL THEN
                    ActiveSourceCards.RemoveRow (rownumber = i);
                 ELSE
                    i = i + 1;
                 ENDIF;
              ELSE
                 i = i + 1;
              ENDIF;
           ELSE   /* remove feeders that have the barrier on it */
              ActiveSourceCards.RemoveRow (rownumber = i);
           ENDIF;
       END;
    ENDIF;
/*
**  All critical functions are performed in first loop; those that would 
**  cause move to be undone.
**  Set cutout date and feeder status for each card.
*/
    i = 1;
    WHILE i <= ActiveSourceCards.Lastrow() DO

        NetworkFeeders.Clear();
/*
** Select 33kV and 3G Feeders
*/
        IF ActiveSourceCards[i].NetworkFeeder <> 0 THEN
           x = 1;
           SELECT :NetworkFeeders[x].Value = CTO.Object
           FROM   TFMS_CardToObject CTO,
                  Udb_ExtendedType ET 
           WHERE  CTO.Card = :ActiveSourceCards[i].Card AND
                  CTO.Type = ET.Type AND
                  ET.SuperType = :Type$Feeder
           BEGIN
              IF ActiveSourceCards[i].NetworkFeeder = NetworkFeeder$33kV THEN
/*
** Ignore feeder segment fed by another
*/
                 m = 0;    
                 SELECT :m = G.Relationship
                 FROM   Udb_Grouping G
                 WHERE  G.Member = :NetworkFeeders[x].Value AND
                        G.Relationship = :Interaction$FedBy;
                 IF m = Interaction$FedBy THEN
                    NetworkFeeders.RemoveRow (rownumber = x);
                    x = x - 1;
                 ENDIF;
              ENDIF;
              x = x + 1;
           END;
        ELSE
           NetworkFeeders[1].Value = ActiveSourceCards[i].Feeder;
        ENDIF;

        FOR x = 1 TO NetworkFeeders.LastRow() DO     
           RetCode = CALLPROC ForceStatus (
                Feeder = NetworkFeeders[x].Value,
                NewStatus = Status$CO);
 
           IF RetCode = PU_CANCEL THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Unable to set C/O feeder status ' +
                       'for ' + ActiveSourceCards[i].FeederName,
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to set C/O feeder status ' +
                       'for ' + ActiveSourceCards[i].FeederName + '.'
                     );
            RETURN (PU_CANCEL);
           ENDIF;
        ENDFOR;
/*
**  Only set CutOut if not already set.
*/  
        IF ActiveSourceCards[i].CutOut IS NOT NULL AND
           ActiveSourceCards[i].CutOut <> '' THEN
           CutOut = ActiveSourceCards[i].CutOut;
           IF JIP.TOComplete IS NOT NULL AND JIP.TOComplete <> '' THEN
              CIGCutOut = JIP.TOComplete;
           ELSE
              CIGCutOut = CutOut;   /* Leaving this as a possibility in case CutOut is performed by something other than move completion. */
           ENDIF; 
        ELSE
           IF KPSFeeder <> 0 AND Feeder3GCutOut IS NULL THEN
              IF JIP IS NULL THEN
/*
**  Look for move that opened source breaker
*/
                 CutOut = '';
                 SELECT  :CutOut = J.TOComplete
                 FROM    SOA_Job J,
                         Udb_Grouping G,
                         FMS_JobAction JA
                 WHERE   G.Grouping = :ActiveSourceCards[i].Feeder AND
                         G.Relationship = :Interaction$SourceBreaker AND
                         G.Member = J.Equip AND
                         J.TOComplete IS NOT NULL AND J.RSComplete IS NULL AND
                         J.JobClass = JA.JobClass AND
                         JA.TORS = 0 AND
                         JA.IssueCompl = 1 AND
                         JA.Status = :Prompt$SetCurrentlyOpen;

                 IF CutOut IS NULL OR CutOut = '' THEN
                    CutOut = 'now';
                 ENDIF;
              ELSE
                 CutOut = JIP.RSComplete;
              ENDIF;

           ELSEIF Feeder3GCutOut IS NOT NULL THEN
              CutOut = Feeder3GCutOut;
           ELSE 
              CutOut = JIP.TOComplete;
           ENDIF;
           /*
           **  If OA/CIOA, we need to determine if this is a 
           **  Temperature Variable Bogey outage.  
           */
           IF ActiveSourceCards[i].TypeOfCard <> TypeOfCard$4KV AND
             (ActiveSourceCards[i].CardClass = Type$Auto OR
              ActiveSourceCards[i].CardClass = Type$CIOA OR
              ActiveSourceCards[i].CardClass = Type$FOT) THEN
              CALLPROC TV_BogeyCheck(Card       = ActiveSourceCards[i].Card,
                                     FeederName = ActiveSourceCards[i].FeederName);
           ENDIF;
           CIGCutOut = CutOut;
        ENDIF;
/*
**  Force DBF status for ATSLoadP source
*/ 
        IF JIP IS NOT NULL THEN
           IF JIP.EquipClass = Type$ATSLoadP THEN
             RetCode = CALLPROC ForceStatus (
                  Feeder = ActiveSourceCards[i].Feeder,
                  NewStatus = Status$DBF);
           
             IF RetCode = PU_CANCEL THEN
              CALLPROC DDB_ROLLBACK;
              CALLPROC TraceError (
                       UserMessage = 'ERROR: Unable to set DBF feeder status ' +
                         'for ' + ActiveSourceCards[i].FeederName,
                       TraceMessage = 
                         'PromptCutOut: ' +
                         'Unable to set DBF feeder status ' +
                         'for ' + ActiveSourceCards[i].FeederName + '.'
                       );
              RETURN (PU_CANCEL);
             ENDIF;
           ENDIF;
        ENDIF;
           
        RetCode = CALLPROC FMS_CardCut (
                CutIn  = NULL,
                CutOut = CutOut,
                Card = ActiveSourceCards[i].Card );

        IF (RetCode <> 0) THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Unable to set C/O time ' +
                       'for ' + ActiveSourceCards[i].FeederName,
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to set C/O time ' +
                       'for ' + ActiveSourceCards[i].FeederName + '.'
                     );
            RETURN (PU_CANCEL);
        ELSE

            CALLPROC SOA_LogIns (
                 Card = ActiveSourceCards[i].Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'CutOut',
                 Old  = VARCHAR(IFNULL(ActiveSourceCards[i].CutOut,'')),
                 New  = IFNULL(CutOut,''));
        ENDIF;
/*
** Set both ETC and ETIS to blank as per ConEd Request. 07/11/00
*/
        IF ActiveSourceCards[i].EstTimeComplete <> '' THEN
           CALLPROC FMS_EstTimeCompleteUpd (
                      Card = ActiveSourceCards[i].Card,
                      EstTimeComplete = '');
         
        ENDIF;

        IF ActiveSourceCards[i].EstTimeInService <> '' THEN
           CALLPROC FMS_EstTimeInServiceUpd 
                     (Card = ActiveSourceCards[i].Card,
                      EstTimeInService = '');
        ENDIF;
        i = i + 1;
    ENDWHILE;
    CALLPROC DDB_COMMIT;
/*
**  Non-critical functions are performed in second loop with failure
**  warnings only.
*/
    x = 1;
    WHILE x <= ActiveSourceCards.Lastrow() DO
/*
** Raise DBEvent when all card types are cutout except 'TEST'
*/ 
       IF ActiveSourceCards[x].CardClass <> Type$CardClassTest THEN
          ControlText = VARCHAR(ActiveSourceCards[x].Card);
          CALLPROC InsertDBEventQueue(
                    ToApp = 'FCR',
                    EventName = 'IR_TroubleCard',
                    EventText = ControlText);  
       ENDIF;
       CALLPROC DDB_RaiseDBEvent(DBEventName = 'FMS_ReloadCardHeader',
                                 DBEventText = ControlText);
       CALLPROC DDB_COMMIT;
/*
** Insert Shadow Switching item into SLC Card.
** Get the substation card id for the substation, includes members of a
** macro substation.  C.Substation does not yet have a value:
*/
       ActiveSourceCards[x].Substation = 0;
       REPEATED 
       SELECT  DISTINCT
               :ActiveSourceCards[x].Substation = O.Object,
               :ActiveSourceCards[x].SubstationName = O.Name
       FROM    SOA_ActiveObject AO,
               Udb_Object O,
               Udb_ExtendedType ET
       WHERE   AO.Card = :ActiveSourceCards[x].Card AND
               AO.Object = O.Object AND
               O.Type = ET.Type AND
               ET.SuperType = :Type$Substation;
         
       IF ActiveSourceCards[x].Substation = 0 AND KPSFeeder = 0 AND
             ActiveSourceCards[x].NetworkFeeder = 0 THEN
          CALLPROC TraceError (
                     UserMessage = 'WARNING: Unable to find substation  ' +
                       'related to card ' + VARCHAR(ActiveSourceCards[x].Card),
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to find Substation ' +
                       'related to card ' + VARCHAR(ActiveSourceCards[x].Card) + '.'
                     );
       ENDIF;          

       SubstationCard = 0;
       SELECT  :SubstationCard = Card
       FROM    SOA_ActiveObject
       WHERE   Object = :ActiveSourceCards[x].Substation AND
               ObjectToCardLink = 1;

       IF SubstationCard = 0 AND KPSFeeder = 0 AND ActiveSourceCards[x].NetworkFeeder = 0 THEN
          IF ActiveSourceCards[x].TypeOfCard <> TypeOfCard$4KV THEN
             CALLPROC TraceError (
                     UserMessage = 'WARNING: Unable to insert shadow ' +
                       'switching item for substation ' +
                       ActiveSourceCards[x].SubstationName + ' because a card ' +
                       'does not exist for this substation',
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to insert shadow ' +
                       'switching item for substation ' +
                       ActiveSourceCards[x].SubstationName + ' because a card ' +
                       'does not exist for this substation'
                     );
          ENDIF;

       ELSEIF KPSFeeder = 0 AND SubstationCard <> 0 THEN
/*
** Check for existence of an active Shadow item already linked to the FMS card.
*/ 
          NewItem.SwitchingItem = 0;
          REPEATED 
          SELECT   :NewItem.SwitchingItem = JC.Job
          FROM     SOA_Job J,
                   SOA_JobControl JC,
                   SOA_ActiveObject AO1,
                   SOA_ActiveObject AO2
          WHERE    AO1.Card = :ActiveSourceCards[x].Card AND
                   AO1.ObjectToCardLink = 0 AND  /*Would be a Substation*/
                   AO1.Object = AO2.Object AND
                   AO2.ObjectToCardLink = 1 AND  /*Primary Substation Card*/
                   AO2.Card = JC.Card AND
                   JC.Job = J.Job AND
                   J.ShadowLink = :ActiveSourceCards[x].Card AND
                   J.MoveCategory = :MoveCategory$SwitchingItem AND
                   J.SwItemStatus = :Card$Active;

          IF NewItem.SwitchingItem = 0 THEN
/*
** Only insert shadow if we did not find one.
*/
          NewItem.Job = 0;
          NewItem.TOMove = 'Shadow for FMS ' + 
                        VARCHAR(ActiveSourceCards[x].FeederName) +
                        ' - ' + ActiveSourceCards[x].CardClassName;
          NewItem.Category = 0;
          NewItem.Severity = 0;
          NewItem.Description = '';
          NewItem.CardClass = ActiveSourceCards[x].CardClass;
          NewItem.CardClassName = ActiveSourceCards[x].CardClassName;
          NewItem.TOIssued = CutOut;
          NewItem.TOComplete = '';
          NewItem.RSIssued = '';
          NewItem.SwItemStatus = Card$Active;
          NewItem.ShadowLink = ActiveSourceCards[x].Card;
          NewItem.Response = 'Active';
          NewItem.JobClass = 0;
          NewItem.Status = '';
          NewItem.Equip = 0;
          NewItem.EquipClass = 0;
          NewItem.EquipClassName = '';
          NewItem.EquipName = '';                    
          NewItem.MoveCategory = MoveCategory$SwitchingItem;
          
          RetCode = NewItem.InsertItem (Card = SubstationCard);

          EquipList = '';
          IF RetCode = PU_CANCEL THEN
             CALLPROC TraceError (
                     UserMessage = 'ERROR: Unable to insert shadow ' +
                       'switching item for substation ' +
                       ActiveSourceCards[x].SubstationName,
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to insert shadow ' +
                       'switching item for substation ' +
                       ActiveSourceCards[x].SubstationName + '.'
                     );
          ELSE
             ImpactedCardList.Clear();
             ImpactedCardList.InsertRow (rownumber = 1);
             ImpactedCardList[1].Value = SubstationCard;
/*
** Time to propagate substation moves if not already shared with an actual
** Switching Item.
** Get a list of common equipment which appears in the substation.
*/          
             Equip = 0;         
             k = 0;
             REPEATED 
             SELECT    
             DISTINCT  :Equip = G1.Member
             FROM      Udb_Grouping G1,
                       Udb_Grouping G2
             WHERE     G1.Grouping = :ActiveSourceCards[x].Feeder AND
                       G1.Relationship = :Interaction$MemberOf AND
                       G1.Member = G2.Member AND
                       G2.Relationship = :Interaction$MemberOf AND
                       G2.Grouping = :ActiveSourceCards[x].Substation
             BEGIN
                IF k = 0 THEN
                   EquipList = '(' + varchar(Equip);
                   k = 1;
                ELSE
                   EquipList = EquipList + ',' + varchar(Equip);
                ENDIF;
             END;
          ENDIF;

          ENDIF;   /* End Prevention of duplicate shadow insertion. */
       ENDIF;
/*
** Now look for moves on that equipment that should be shared elsewhere.
*/
       IF EquipList <> '' THEN 
            EquipList = EquipList + ')';

            DynamicWhereClause = '';
            DynamicWhereClause = 'J.Equip IN ' + EquipList + ' AND ' +
               'J.MoveCategory = ' + VARCHAR(MoveCategory$Normal) + ' AND ' +
               'J.Status IN (' + '''' + '''' + ',' + '''' + 
               VARCHAR(JobStatus$NIS) + '''' +
               ') AND ' +
               'JC.Card = ' + varchar(ActiveSourceCards[x].Card) + ' AND ' +
               'JC.Job = J.Job AND (J.TOComplete IS NULL OR ' + 
               'J.RSComplete IS NULL)';

            m = 1;
            SItem.Clear();
            SELECT DISTINCT
               :SItem[m].Equip       = J.Equip,
               :SItem[m].Job         = J.Job,
               :SItem[m].EquipClass  = J.EquipClass,
               :SItem[m].JobClass    = J.JobClass,
               :SItem[m].TOIssued    = J.TOIssued,
               :SItem[m].TOComplete  = J.TOComplete,
               :SItem[m].RSIssued    = J.RSIssued,
               :SItem[m].RSComplete  = J.RSComplete,
               :SItem[m].Substation  = J.Substation,
               :SItem[m].MoveEquipClass = JC.MoveEquipClass,
               :SItem[m].PrintID        = JC.PrintID,
               :SItem[m].StepLevel      = JC.StepLevel,
               :SItem[m].StepPair       = JC.StepPair
            FROM     SOA_Job J,
                     SOA_JobControl JC
            WHERE   :DynamicWhereClause
/*            ORDER BY Equip   SELECT DISTINCT with Equip listed first enforces Sort by Equip */
            BEGIN               
               m = m + 1;
            END;
/*
**  Propagate moves from this card to the item if the move is not already
**  there.
*/
            LastEquip = 0;
            i = 1;
            WHILE i <= SItem.LastRow() DO
               /* See if equipment is in a Active Switching Item */
               IF LastEquip <> SItem[i].Equip THEN
                  EquipItem = 0;
                  REPEATED
                  SELECT :EquipItem = JC.SwitchingItem
                  FROM    SOA_Job J,
                          SOA_JobControl JC
                  WHERE   J.Equip = :SItem[i].Equip AND
                          J.SwItemStatus >= :Card$Active AND
                          J.SwItemStatus < :Card$Closed AND
                          J.Status IN ('', :JobStatus$NIS) AND
                          J.Job = JC.Job AND
                          JC.Card = :SubstationCard;
                  IF EquipItem = 0 THEN
                     EquipItem = NewItem.Job;
                  ENDIF;

                  LastEquip = SItem[i].Equip;
               ENDIF;
/*
** Look for move existence on a active sw item
*/
               m = 0;
               REPEATED
               SELECT :m = JC.Job
               FROM   SOA_JobControl JC,
                      SOA_Job J
               WHERE  JC.Card = :SubstationCard AND
                      JC.Job  = :SItem[i].Job AND
                      JC.Job = J.Job AND
                      J.SwItemStatus = :Card$Active;
/*
**  Don't insert move if it already exists on Item.
*/
               IF m = 0 THEN
/*
** Insert the move into the Active/Shadow item
*/
                  InsertShItem.Card = SubstationCard;
                  InsertShItem.Application = Application$SLC;
                  InsertShItem.TypeOfCard = Type$SLCCard;
                  InsertShItem.SwitchingItem = EquipItem;
                  InsertShItem.StepLevel = 0;
                  InsertShItem.PrintID = '';
                  InsertShItem.StepHeading = 0;

                  SELECT    
                    :InsertShItem.StepHeading = JCC.StepPair,
                    :InsertShItem.MoveEquipClass = JCC.EquipClass
                  FROM      FMS_JobClassControl JCC
                  WHERE     JCC.TypeOfCard = :Type$SLCCard AND
                            JCC.JobClass = :SItem[i].JobClass AND
                            JCC.PreferredStep = :TRUE AND
                            :SItem[i].EquipClass IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = JCC.EquipClass);
/*
** Only insert move if JCC entry exists
*/
                  IF InsertShItem.StepHeading <> 0 THEN
                     RetCode = SItem[i].InsertControl (
                       ControlEntry = InsertShItem,
                       InitiatingCard = ActiveSourceCards[x].Card);

                     IF RetCode = PU_CANCEL THEN
                        CALLPROC TraceError (
                     UserMessage = 'ERROR: Unable to insert shadow ' +
                       'move control entry. ',
                     TraceMessage = 
                       'PromptCutOut: ' +
                       'Unable to insert shadow move control.'
                     );
                     ENDIF;
                  ENDIF; 
               ENDIF;
               i = i + 1;
            ENDWHILE;

#           include NotifyImpactedCards
       ENDIF;
/*
** Insert Operating Step ISO or STA if appropriate except for FOT card
*/
       IF ActiveSourceCards[x].CardClass <> Type$FOT  THEN
       
          IF SimpleStep IS NULL THEN
             SimpleStep = OperatingStep_ASE.Create();
          ENDIF;    
          SimpleStep.CutOut      = ActiveSourceCards[x].CutOut;
          SimpleStep.CutIn       = NULL;
          SimpleStep.SO.Object   = ActiveSourceCards[x].Card;
          SimpleStep.SO.Type     = ActiveSourceCards[x].Feeder;
          SimpleStep.SO.TypeName = ActiveSourceCards[x].FeederName;
          SimpleStep.SO.Name     = ActiveSourceCards[x].CardClassName;
          SimpleStep.Job         = 0;
/*
** Is STA move outstanding?
*/
          SimpleStep.ReturnCount = 0;
          STAMove = 0;
          SimpleStep.CheckOutstandingSTA();
          STAMove = SimpleStep.ReturnCount;
/*
** Are the any outstanding Isolation moves?
*/
          SimpleStep.ReturnCount = 0;
          ISOCount = 0;
          SimpleStep.CountIsolationMoves();
          ISOCount = SimpleStep.ReturnCount;
/*
** Set proper operating step if one can be set.
*/
          SimpleStep.ReturnCode = 0;
          IF STAMove <> 0 AND ISOCount > 0 THEN
             SimpleStep.OpStep = Type$ISTA;
             SimpleStep.SetOpStep();
          ELSEIF STAMove <> 0 AND ISOCount = 0 THEN
             SimpleStep.OpStep = Type$STA;
             SimpleStep.SetOpStep();
          ELSEIF STAMove = 0 AND ISOCount > 0 THEN
             SimpleStep.OpStep = Type$ISOStep;
             SimpleStep.SetOpStep();
          ENDIF;
       
          IF SimpleStep.ReturnCode <> 0 THEN
             CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
                                  TraceMessage =
            'Prompt:CheckCutOut; ' +
            'Error setting OperatingStep at Card Cutout. ' +
            'Card=' + VARCHAR(ActiveSourceCards[x].Card) +
            ';Status=' + VARCHAR(SimpleStep.OpStep) + '.'
            );
          ENDIF; 
          SimpleStep = NULL;
       ENDIF;
       CALLPROC DDB_COMMIT;
/* 
**  restore feeder restrictions that may have been lifted.
*/
       RetCode = CALLPROC FMS_RestoreFeederRestriction (
                     Feeder = ActiveSourceCards[x].Feeder);
       
       IF RetCode < 0 THEN
                       CALLPROC DDB_ROLLBACK;
                       CALLPROC TraceError (UserMessage = 
                         'ERROR: Unable to restore feeder restrictions that ' +
                         'may have been lifted for feeder ' +
                         ActiveSourceCards[x].FeederName,
                             TraceMessage = 
                         'PromptCutOut: ' +
                         'Unable to restore feeder restrictions that ' +
                         'may have been lifted for feeder ' +
                         ActiveSourceCards[x].FeederName
                          );
       ELSE
          CALLPROC DDB_COMMIT;   
          FCFrame.SendUserEvent (EventName = 'UpdateRestrictionBtn');     
       ENDIF;
/*
**  Make sure OperatingStepCount(10147) is set correctly.
*/
       CALLPROC CheckOpStepCount(Card = ActiveSourceCards[x].Card);

/*
**  Send cutout notifications
*/        
       CALLPROC NotificationCutout (pCard = ActiveSourceCards[x].Card,
                                     pCardClass = ActiveSourceCards[x].CardClass,
                                     pCardClassName = ActiveSourceCards[x].CardClassName,
                                     pCutout = CIGCutOut,
                                     pFeeder = ActiveSourceCards[x].Feeder,
                                     pFeederName = ActiveSourceCards[x].FeederName);
/*
** For non-3G feeders and card types other than test, if feeder has L&P Unit ATS equip then Issue Verify L&P Swapped move
*/      
      IF ActiveSourceCards[x].CardClass <> Type$CardClassTest AND
          ActiveSourceCards[x].NetworkFeeder <> NetworkFeeder$3G THEN
         LPUnitATS.Clear();
         p = 1;
         SELECT :LPUnitATS[p].PrintID = G.Reference,
                :LPUnitATS[p].Equip = G.Member,
                :LPUnitATS[p].EquipClass = O.Type,
                :LPUnitATS[p].EquipClassName = O.TypeName,
                :LPUnitATS[p].EquipName = O.Name
         FROM   Udb_Grouping G,
                TFMS_CardToObject CTO,
                Udb_Object O
         WHERE  CTO.Card = :ActiveSourceCards[x].Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$LPUnitATS AND
                G.Member = O.Object
         BEGIN
            p = p + 1;
         END;
                
         FOR p = 1 TO LPUnitATS.LastROW DO
            CALLPROC AutoFODIssue (Card = ActiveSourceCards[x].Card,
                                FODJobClass = JobClass$VerifyLPSwapped,
                                TypeOfCard = ActiveSourceCards[x].TypeOfCard,
                                Equip = LPUnitATS[p],
                                OrderComment = '');
         ENDFOR;
         /* Re-use LPUnit array for DMEaton equipment */
         IF ActiveSourceCards[x].CardClass = Type$Auto OR ActiveSourceCards[x].CardClass = Type$CIOA THEN
            LPUnitATS.Clear();
            p = 1;
            SELECT :LPUnitATS[p].PrintID = G.Reference,
                :LPUnitATS[p].Equip = G.Member,
                :LPUnitATS[p].EquipClass = O.Type,
                :LPUnitATS[p].EquipClassName = O.TypeName,
                :LPUnitATS[p].EquipName = O.Name
            FROM   Udb_Grouping G,
                TFMS_CardToObject CTO,
                Udb_Object O
            WHERE  CTO.Card = :ActiveSourceCards[x].Card AND
                CTO.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$DMEaton AND
                G.Member = O.Object AND
                O.Name LIKE '%-101'
            BEGIN
                p = p + 1;
            END;
                
            FOR p = 1 TO LPUnitATS.LastROW DO
               CALLPROC AutoFODIssue (Card = ActiveSourceCards[x].Card,
                                FODJobClass = JobClass$DMEatonClosed,
                                TypeOfCard = ActiveSourceCards[x].TypeOfCard,
                                Equip = LPUnitATS[p],
                                OrderComment = '');
            ENDFOR;
         ENDIF;         
      ENDIF;
/*
** Set ATS CurrentlyOpen status for ATS switches when the
** ATS are in automatic mode, when the 
** associated feeder is in service
*/
/*
** Determine list of ATS
*/
       ATSList.Clear();
       i = 1;
       REPEATED 
       SELECT DISTINCT
             :ATSList[i].GrouperID = O.Object,
             :ATSList[i].GrouperName = O.Name, 
             :ATSList[i].GrouperType = O.Type
       FROM  Udb_Grouping G,
             Udb_Object O
       WHERE G.Grouping = :ActiveSourceCards[x].Feeder 
         AND G.RelationShip = :Interaction$MemberOf  
         AND G.Member = O.Object
         AND O.Type IN (SELECT Type
                     FROM Udb_ExtendedType
                     WHERE SuperType = :Type$ATSGrouper)
       BEGIN
/*
** Exclude ATS if it is in manual
*/
          ATSStatus = 0;
          SELECT :ATSStatus = Status
          FROM   FMS_ObjectStatus 
          WHERE  Object = :ATSList[i].GrouperID AND
                 Status = :Status$ATSManual;
          IF ATSStatus = Status$ATSManual THEN
             ATSList.RemoveRow (RowNumber = i);
          ELSE 
             i = i + 1;
          ENDIF;    
       END;
/*
** For each Auto ATS, check status of local supplying switch
** and in service status of the alternate feeder
*/ 
       FOR i = 1 TO ATSList.LastRow() DO
        /*
        ** Identify ATS supplying switch on current feeder
        */
           LocSwitch = 0;
           REPEATED
           SELECT 
               :LocSwitch = G1.Member,
               :NormalOpen = S.NormalOpen,
               :CurrentlyOpen = S.CurrentlyOpen
           FROM Udb_Grouping G1,
                Udb_Grouping G2,
                Udb_Switch S
           WHERE G1.Grouping = :ATSList[i].GrouperID 
             AND G1.RelationShip = :Interaction$MemberOf
             AND G1.Member = G2.Member
             AND G1.MemberType IN (SELECT Type
                                FROM Udb_ExtendedType
                                WHERE SuperType = :Type$ATSSupply)
             AND G2.Grouping = :ActiveSourceCards[x].Feeder
             AND G2.RelationShip = :Interaction$MemberOf
             AND S.Object = G1.Member;
        /*
        ** Identify alternate feeder and ATS switch
        */
           IF LocSwitch <> 0 THEN

              AltSwitch = 0;
              AltFeeder = 0;

              REPEATED
              SELECT
                :AltSwitch = G1.Member,
                :AltFeeder = G2.Grouping
              FROM Udb_Grouping G1,
                   Udb_Grouping G2
              WHERE G1.Grouping = :ATSList[i].GrouperID 
                AND G1.RelationShip = :Interaction$MemberOf
                AND G1.Member = G2.Member
                AND G1.MemberType IN (SELECT Type
                                    FROM Udb_ExtendedType
                                    WHERE SuperType = :Type$ATSSupply)
                AND G2.Grouping <> :ActiveSourceCards[x].Feeder
                AND G2.GroupingType IN (SELECT Type 
                                      FROM Udb_ExtendedType
                                      WHERE SuperType = :Type$Feeder)
                AND G2.RelationShip = :Interaction$MemberOf;

              IF AltSwitch <> 0 AND AltFeeder <> 0 THEN
                 AltFeederStatus = 1;
                 REPEATED
                 SELECT :AltFeederStatus = 0
                 FROM FMS_ObjectStatus OS
                 WHERE OS.Object = :AltFeeder
                   AND OS.Status = :Status$CO;
                /*
                ** Change switch status for local and alternate
                ** supplying switches if alternate feeder
                ** is in service
                */
                 IF AltFeederStatus = 1 THEN
/*
** Flip the statuses
*/                  
                    RetCode = CALLPROC SetStatus (Object = LocSwitch,
                                                  Status = Status$Open);
                    IF RetCode = PU_CANCEL THEN
                       CALLPROC DDB_ROLLBACK;
                    ENDIF;

                    RetCode = CALLPROC FMS_ObjStatDel(Object = LocSwitch,
                                                      Status = Status$Closed);
                    IF RetCode < 0 THEN
                       CALLPROC DDB_ROLLBACK;
                    ENDIF;

                    RetCode = CALLPROC SetStatus (Object = AltSwitch,
                                                  Status = Status$Closed);
                    IF RetCode = PU_CANCEL THEN
                       CALLPROC DDB_ROLLBACK;
                    ENDIF;

                    RetCode = CALLPROC FMS_ObjStatDel(Object = AltSwitch,
                                                      Status = Status$Open);
                    IF RetCode < 0 THEN
                       CALLPROC DDB_ROLLBACK;
                    ENDIF;

                    RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = LocSwitch,
                                           CurrentlyOpen = 1); 
                    IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to set ATS switch status for ATS ' +
                          ATSList[i].GrouperName + '. Try again.',
                              TraceMessage = 
                          'PromptCutOut: ' +
                          'Unable to set ATS switch ' +
                          'status for ATS ' + ATSList[i].GrouperName + '.'
                           );
                    ENDIF;

                    RetCode = CALLPROC Udb_SwitchCurrentUpd (
                                           Object = AltSwitch,
                                           CurrentlyOpen = 0); 
                    IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        CALLPROC TraceError (UserMessage = 
                          'ERROR: Unable to clear ATS switch status for ATS ' +
                          ATSList[i].GrouperName + '. Try again.',
                              TraceMessage = 
                          'PromptCutOut: ' +
                          'Unable to clear ATS switch ' +
                          'status for ATS ' + ATSList[i].GrouperName + '.'
                           );
                    ENDIF;
                    CALLPROC DDB_COMMIT;
                 ENDIF;
              ENDIF;
           ENDIF;
        ENDFOR;
                
        x = x + 1;
    ENDWHILE;
/*
**  Check to see if any ATS load feeders should be cutout.
*/
    IF NoATSLoad = FALSE THEN
       FOR x = 1 TO ActiveSourceCards.LastRow DO
          ATS.CheckATSLoad(Object = ActiveSourceCards[x].Feeder,
                           IsFeeder = TRUE);
       ENDFOR;
    ENDIF;

    IF KPSFeeder = 0 THEN
/*
** Delete all messages from the FMS_SOCCSXMESSAGE table
*/
       RetCode = CALLPROC FMS_SoccsxMessageDel
                        ( UserName = UserName );
       IF RetCode <> 0 THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage = '',
                TraceMessage = 
                     'PromptCutOut: ' +
                     'Unable to delete message to Call XA21 screen. ' +
                     'XA21 Interface will have problems ' +
                     'for device ' + JIP.EquipName + ' if not corrected.' 
                      );
       ELSE
          CALLPROC DDB_COMMIT;
       ENDIF;
    ENDIF;
    
    FOR i = 1 to ActiveSourceCards.LastRow DO
/*
**  For each card look to see if there is a link to Step Down 4kv feeder.
**  If there is, then cutout that feeder also.
*/
       IF ActiveSourceCards[i].TypeOfCard <> TypeOfCard$4KV THEN
          /*
          **  Check to see if current feeder has an SD-VIS equipment type
          **  that is closed.  If yes, then look for other 4kv linked cards
          **  and cut those out also.
          */
          k = 1;
          StepDownCard.Clear();
          SELECT DISTINCT
                 :StepDownCard[k].Feeder = CTO.Object
          FROM    FMS_StepDownLink L,
                  Udb_Switch S,
                  Udb_Grouping G,
                  TFMS_CardToObject CTO
          WHERE   L.Card = :ActiveSourceCards[i].Card AND
                  L.StepDownCard = CTO.Card AND
                  CTO.Object = G.Grouping AND
                  G.GroupingType = :Type$Feeder AND
                  G.Relationship = :Interaction$MemberOf AND
                  G.MemberType = :Type$SDVIS AND
                  G.Member = S.Object AND
                  S.CurrentlyOpen = 0
          BEGIN
             k = k + 1;
          END;
          FOR k = 1 TO StepDownCard.LastRow DO
             CALLFRAME PromptCutout(Feeder = StepDownCard[k].Feeder,
                                    JIP = JIP);     
          ENDFOR;	
       ENDIF; 
/*
** For each card look to see if the feeder is feeding other feeders. If so, send an incoming message
*/     
       IF ActiveSourceCards[i].NetworkFeeder = NetworkFeeder$33kV THEN 
          FedByList.Clear();
          k = 1;
          SELECT DISTINCT
                 :FedByList[k].Card = C.Card,
                 :FedByList[k].Feeder = C.Feeder,
                 :FedByList[k].FeederName = C.FeederName
          FROM   UDB_Grouping G,
                 TFMS_CardToObject CTO,
                 SOA_ActiveCard AC, 
                 FMS_Card C
          WHERE  G.Grouping = :ActiveSourceCards[i].Feeder AND
                 G.Relationship = :Interaction$FedBy AND
                 G.Member = CTO.Object AND
                 CTO.Card = AC.Card AND
                 AC.Card = C.Card
          BEGIN
             k = k + 1;
          END;
          CALLPROC DDB_ROLLBACK;
          
          FOR k = 1 TO FedByList.LastRow DO
             RetCode = CALLPROC MSG_SendMsg (Card = FedByList[k].Card,
                                  Action = 0,
                                  OrderNumber = 0,
                       		       Substation = FedByList[k].Feeder,
                                  SubstationName = FedByList[k].FeederName,
                                  Msg = 'FEEDER SUPPLYING PORTION C/O' + HC_NEWLINE + 
                                       ActiveSourceCards[i].FeederName + ' was cutout and was feeding '+ FedByList[k].FeederName + 
                                       '.  Equipment on ' + FedByList[k].FeederName + ' may have been de-energized due to cutout ' + 
                                       'of feeder ' + ActiveSourceCards[i].FeederName,
                                  FromOpName = 'FMS',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'FMS',
                                  FromApp = 'FMS',
                                  Priority = 1
                                  );

             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (
                  UserMessage = '',
                  TraceMessage = 'PromptCutOut: Failed to notify DO of Fed By relationship');
             ELSE
                CALLPROC DDB_COMMIT; 
             ENDIF;
          ENDFOR;
       ENDIF;
    ENDFOR;

    RETURN (PU_OK);
END;

ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

PROCEDURE TV_BogeyCheck (
   Card       = INTEGER     NOT NULL WITH DEFAULT;
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
DECLARE
   IsCERC          = INTEGER NOT NULL WITH DEFAULT;
   TV_BogeyEnabled = INTEGER NOT NULL WITH DEFAULT;
   TV_Bogey        = INTEGER NOT NULL WITH DEFAULT;
   TV_Threshold    = FLOAT   NOT NULL WITH DEFAULT;
   TV_ForeCast     = FLOAT   NOT NULL WITH DEFAULT;
   WarningTxt      = VARCHAR(400) NOT NULL WITH DEFAULT;
   July4Start      = DATE NOT NULL WITH DEFAULT;
   July4End        = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   **  NO ROLLBACKS OR COMMITS IN HERE SINCE IT IS 
   **  PART OF CRITICAL WORK IN PROMPT.
   ** 
   **  See if TV_BogeyEnabled = TRUE. 
   */
   TV_BogeyEnabled = FALSE;
   SELECT :TV_BogeyEnabled = TM_BogeyEnabled,
          :TV_Threshold = TV_Threshold
   FROM    FMS_SystemParameters;
   
   IF TV_BogeyEnabled = FALSE THEN
      RETURN;
   ENDIF;
   /*
   **  See if today is a CERC day.  If yes then today can be tracked as 
   **  a TV day if the TV Threshold has been met.
   */
   IsCerc = 0;
   IF UPPERCASE(dow(CutOut)) = 'FRI' AND
      date_part('hour',CutOut) >= 15 THEN 
      /* On Friday after 3pm check tomorrow */
      SELECT :IsCERC = 1
      FROM    FMS_CercDay C
      WHERE   C.DateValue = DATE_TRUNC('day',date(:CutOut) + '1 day');   
   ELSEIF date_part('hour',CutOut) < 18 THEN
      SELECT :IsCERC = 1
      FROM    FMS_CercDay C
      WHERE   C.DateValue = DATE_TRUNC('day',date(:CutOut));
   ELSE  /* After 6pm check tomorrow */
      SELECT :IsCERC = 1
      FROM    FMS_CercDay C
      WHERE   C.DateValue = DATE_TRUNC('day',date(:CutOut) + '1 day');   
   ENDIF;
   /*
   **  Set up July 4 date
   */
   July4Start = date('03-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');
   July4End   = date('04-jul-' + varchar(date_part('year',date('now'))) + ' 18:00:00');
   /*
   **  Don't track TV on weekends or July 4th.
   */
   IF IsCERC = 0 AND
     (UPPERCASE(dow(CutOut)) = 'SAT' OR
     (UPPERCASE(dow(CutOut)) = 'FRI' AND
      date_part('hour',CutOut) >= 15) OR 
     (UPPERCASE(dow(CutOut)) = 'SUN' AND
      date_part('hour',CutOut) < 18) OR
     (Cutout >= July4Start AND
      Cutout < July4End)) THEN
      
      RETURN;
   ENDIF;
   
   TV_Forecast = 0;
   IF date_part('hour',CutOut) < 18 THEN
      /*  Get Today's Forecast */
      SELECT :TV_Forecast = B.Forecast
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory);

      IF TV_Forecast = 0 THEN
         /* Get Yesterdays 'day ahead' forecast */
         SELECT :TV_Forecast = B.DayAhead
         FROM    TV_BogeyHistory B
         WHERE   B.LogDate >= date_trunc('day',date('NOW')) - '1 day' AND
                 B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                              FROM   TV_BogeyHistory);
      ENDIF;
      TV_Bogey = 2;
   ELSE
      /*  Get Tomorrows Forecast */
      SELECT :TV_Forecast = B.DayAhead
      FROM    TV_BogeyHistory B
      WHERE   B.LogDate >= date_trunc('day',date('NOW')) AND
              B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                           FROM   TV_BogeyHistory);
      TV_Bogey = 3;
   ENDIF;

   IF TV_Forecast = 0 THEN
      WarningTxt = 'Feeder ' + FeederName + ' has been cutout and ' + 
                   'no Forecasted Temperature Variables have been entered ' +
                   'for today.  Please enter the Forecasted Temperature Variables ' +
                   'using FMS_Online.'; 
      CALLPROC CSD_MessageIns(DeskType = 'pgm_online'
                             ,MessageText = WarningTxt
                             ,MessageType = 0
                             ,Card = 0
                             ,Priority = 0  /* High Priority */ 
                             ,Time = date('now'));
      CALLPROC TraceError (
            UserMessage = '',
            TraceMessage = 'PromptCutOut: No Temperature Variable values ' +
                           'are in the database for today.');
      RETURN;
   ENDIF;

   IF TV_Forecast >= TV_Threshold THEN
      CALLPROC FMS_CardTVUpd 
          (Card = Card,
           Type = 0, /* Active card */
           TV_Bogey = TV_Bogey);      
   ENDIF;
   RETURN;
END;

PROCEDURE CheckForOther3GSource (
   Feeder = INTEGER NOT NULL,
   Card = INTEGER NOT NULL
) =
DECLARE
   AlternateSource = INTEGER NOT NULL WITH DEFAULT;
   AlternateFeeder = INTEGER NOT NULL WITH DEFAULT;
   AlternateSourceStatus = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TraceEnabled = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Look at other feeder on 3G card to see if there is another source associated with
** a substation.  If there is, and the source is closed, then we should not CutOut this
** feedercard.
*/
   AlternateSource = 0;
   AlternateSourceStatus = FALSE;
   SELECT :AlternateSource = S.Object,
          :AlternateFeeder = G.Grouping,
          :AlternateSourceStatus = S.CurrentlyOpen
   FROM   TFMS_CardToObject CTO,
          Udb_Grouping G,
          Udb_Switch S
   WHERE  CTO.Card = :Card AND
          CTO.Object <> :Feeder AND
          CTO.Object = G.Grouping AND
          G.Relationship = :Interaction$SourceBreaker AND
          G.Member = S.Object;

  IF AlternateSource = 0 THEN
     RETURN PU_OK;
  ELSE
     TraceEnabled = 0;
     SELECT :TraceEnabled = Feeder
     FROM   FMS_ConnectedSource
     WHERE  Feeder = :AlternateFeeder;

     IF TraceEnabled > 0 THEN    
        RetCode = CALLPROC Confirm3GOutofService (
                   Feeder = AlternateFeeder,
                   SkipFeeder = Feeder);  

        IF RetCode = PU_CANCEL THEN
           RETURN PU_CANCEL;  /* 3G Network Feeder cutin from alternate connected source */
        ELSEIF AlternateSourceStatus = TRUE THEN
           RETURN PU_OK;
        ELSE 
           RETURN PU_CANCEL;
        ENDIF;
     ENDIF;
  ENDIF;
  RETURN PU_CANCEL;
END;

