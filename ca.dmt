   ConfirmText = Text;
END;
/*
**  Handle a Yes click
*/
ON Click YesButton =

BEGIN
   CALLPROC SOA_LogIns (Card = Card,
                        SwitchingItem = SwitchingItem,
                        Job = Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Confirm',
                        Old = Text,
                        New = 'Confirmed statement');   
   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);
END;

/*
**  Handle a No click
*/
ON Click NoButton =
BEGIN
   CALLPROC SOA_LogIns (Card = Card,
                        SwitchingItem = SwitchingItem,
                        Job = Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Confirm',
                        Old = Text,
                        New = 'Did not confirm statement');   
   CALLPROC DDB_COMMIT;
   RETURN (PU_Cancel);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

