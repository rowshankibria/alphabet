/*
**  Application:    SOA
**  Method:         ActiveList.Refresh
**
**  Date:       Author   Description
** ----------------------------------
**  01/12/98	EM       Created
**  01/14/98    em       adding additional methods
**  04/28/00    em       RunTime error for users with no jurisdiction (like
**                       -umgr.  During Refresh make sure, DynamicWhereClause
**                       has a closed parentheses.
**  06/29/03    pkw      Refresh method has been moved to ActiveList_ASE and is
**                       now called LoadActiveList.
**
*/

/*
** Scan Active Card List to see if Card is in the list.
*/
METHOD IsCardInList (
   AC 			= ARRAY OF ActiveList;
   Card			= INTEGER NOT NULL;
)=
DECLARE
   Found		= INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   i			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   LastRow       	= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
ENDDECLARE
BEGIN
   Found = FALSE;
   LastRow = AC.LastRow();
   FOR i = 1 TO LastRow DO
      IF Card = AC[i].Card THEN
         Found = TRUE;
         ENDLOOP;
      ENDIF;
   ENDFOR;

   RETURN :Found;
END;

/*
** Update FeederStatus if Card exists in Active List
*/
Method UpdateFeederStatus (   
   AC 			= ARRAY OF ActiveList;
   Card			= INTEGER NOT NULL;
   FeederStatus         = INTEGER;
   FeederStatusName     = VARCHAR(40) NOT NULL WITH DEFAULT;
)=
DECLARE
   Found		= INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   i			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   LastRow       	= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
ENDDECLARE
BEGIN
   Found = FALSE;
   LastRow = AC.LastRow();
   FOR i = 1 TO LastRow DO
      IF Card = AC[i].Card THEN
         Found = TRUE;
         AC[i].CardNumber = FeederStatus;
         AC[i].FeederStatusName = FeederStatusName;
         ENDLOOP;
      ENDIF;
   ENDFOR;

   RETURN :Found;
END;    

