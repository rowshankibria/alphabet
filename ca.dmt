Application Component Report
============================

	Name:            SOA_LogIns

/*
**
**      Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    SOA
**  Proc            SOA_LogIns
**
**  Date:       Author   Description
** ----------------------------------
**  01/07/03	ysp       Created
**  11/14/05    em        Move Select Loop from DB Procedure to this level
**                        so that log entries are inserted one at a time 
**                        to avoid SOA_Log$1 deadlocks in replicated environment
**  03/03/06    em        Edited log insert error message
**  05/04/06    em        Corrected run-time trace error
**  04/12/07    pkw       Use IFNULL(XXX,0) when dealing with Integers to 
**                        avoid $ xxx.00 in trace message.
**
*/
PROCEDURE SOA_LogIns
(
    Card = INTEGER NOT NULL;         
    SwitchingItem = INTEGER WITH NULL;         
    Job = INTEGER WITH NULL;          
    Time = DATE NOT NULL;          
    UserName = VARCHAR(24) NOT NULL;          
    Item = VARCHAR(32) NOT NULL;         
    Old = VARCHAR(80);          
    New = VARCHAR(80);          

/* local variables */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL;
    Cards = ARRAY OF INTEGEROBJECT;
    SwitchingItems = ARRAY OF INTEGEROBJECT;
)=
BEGIN
/*
** For Job Log Entries that are not New Moves, do a select to find all possible
** locations so that they can be inserted one at a time.
*/
   IF Item <> 'New Move' AND Job > 0 AND Job IS NOT NULL THEN

      i = 1;
      SELECT :Cards[i].Value = JC.Card,
             :SwitchingItems[i].Value = JC.SwitchingItem
      FROM   SOA_JobControl JC,
             SOA_ActiveCard AC
      WHERE  JC.Job = :Job AND
             JC.Card = AC.Card
      BEGIN  
         i = i + 1;
      END;

      FOR i = 1 TO Cards.LastRow() DO
          RetCode = CALLPROC SOA_LogInsert(
             Card = Cards[i].Value
        ,    SwitchingItem = SwitchingItems[i].Value
        ,    Job = Job
        ,    Time = Time
        ,    UserName = UserName
        ,    Item = Item
        ,    Old = IFNULL(Old, '')
        ,    New = IFNULL(New, '')
        ,    Operator = DOp.Object
        ,    OperatorName = DOp.Description
        );

         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = '',
                              TraceMessage = 'Unable to insert transaction log entry for ' +
                                             HC_NEWLINE + 'Card:' + VARCHAR(Cards[i].Value) +
                                             '; SwitchingItem:' + 
                                             VARCHAR(IFNULL(SwitchingItems[i].Value,0)) +
                                             '; Job:' + VARCHAR(IFNULL(Job,0)) + HC_NEWLINE +
                                             Item + ': ' + IFNULL(Old,'') );
         ENDIF;
      ENDFOR;

   ELSE

      RetCode = CALLPROC SOA_LogInsert(
             Card = Card
        ,    SwitchingItem = SwitchingItem
        ,    Job = Job
        ,    Time = Time
        ,    UserName = UserName
        ,    Item = Item
        ,    Old = IFNULL(Old, '')
        ,    New = IFNULL(New, '')
        ,    Operator = DOp.Object
        ,    OperatorName = DOp.Description
        );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',
                              TraceMessage = 'Unable to insert transaction log entry for ' +
                                             HC_NEWLINE + 'Card:' + VARCHAR(Card) +
                                             '; SwitchingItem:' + 
                                             VARCHAR(IFNULL(SwitchingItem,0)) +
                                             '; Job:' + VARCHAR(IFNULL(Job,0)) + HC_NEWLINE +
                                             Item + ': ' + IFNULL(Old,'') );
      ENDIF;
   ENDIF;

   CALLPROC SOA_DOActivityUpd (
             Machine = UserMachine,
             LastUpdate = Date('now'));
   CALLPROC DDB_COMMIT;

   RETURN(RetCode);
END;

