INITIALIZE
(
#  include StandardDeclarations

   AbortMoves = ARRAY OF JobInProgress;  /* Moves that can be aborted*/
   AllSteamStreet = INTEGER NOT NULL WITH DEFAULT;  /*1=If all moves are in street heading*/
   AllSteamStreetEligible = INTEGER NOT NULL WITH DEFAULT;  /*1=If all moves are in street heading*/
   AutoReturn = INTEGER NOT NULL WITH DEFAULT;  /*1=If moves aborted; 2=If moves issued*/
   AutoTarget = CHAR(3) NOT NULL WITH DEFAULT; /*OptionalParm*/
   BlankJD = EquipInProgress;         /* blank class */
   Block  = INTEGER NOT NULL WITH DEFAULT;  /*OptionalParm*/
   BusConfig = INTEGER NOT NULL WITH DEFAULT;
   BypassAbortPrompt = INTEGER NOT NULL WITH DEFAULT;
   CallXA21Moves = ARRAY OF Job; /*Moves to pass back for XA21 display*/
   CardClass = INTEGER NOT NULL WITH DEFAULT;
   Complete = DATE;
   CrewsAvailable = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   CustomerCrewRequest = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   DateNow = DATE NOT NULL WITH DEFAULT;        /*Date for Crew where clause*/
   DefaultOperator = INTEGER;          /*Default Operator*/
   DefaultOpRow = INTEGER NOT NULL WITH DEFAULT;
   DefaultOpTbl = VARCHAR(1) NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(500) NOT NULL WITH DEFAULT;
   Enable3GConfigChange = INTEGER NOT NULL WITH DEFAULT; /*Optional Input Parm*/
   FODRegion = VARCHAR(20) NOT NULL WITH DEFAULT;
   FoundOperator = INTEGER NOT NULL;   /*BOOLEAN*/
   G_Count = INTEGER NOT NULL;
   G_Total = INTEGER NOT NULL;
   GenOpName = STRINGOBJECT;
   GetOut = INTEGER NOT NULL WITH DEFAULT;
   GroundFeeder = INTEGER NOT NULL WITH DEFAULT;
   GroundObjective = INTEGER NOT NULL WITH DEFAULT;
   InServicePermit = INTEGER NOT NULL WITH DEFAULT;
   IssuedMoves = ARRAY OF JobInProgress;   /*DownLoad these jobs*/
   J = ARRAY OF Job;                /* Passed jobs */
   JIP = ARRAY OF JobInProgress;
   k = INTEGER NOT NULL;                  /* INDEX*/
   m = INTEGER NOT NULL;		/* Scratch counter */
   MacroStation = INTEGER NOT NULL;       /* BOOLEAN */
   HybridStation = INTEGER NOT NULL;       /* BOOLEAN */
   MoveRow = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
   OOSCheck = INTEGER NOT NULL WITH DEFAULT;  
   OpASE = OperatorClass_ASE DEFAULT NULL;  
   OpOrderSubstation = INTEGER NOT NULL;  /*Used by include script*/
   OpOrderSubstationName = VARCHAR(40) NOT NULL;  /*Used by include script*/
   OutstandingPhaseCheck = INTEGER NOT NULL;
   OverrideRC = VARCHAR(60);
   p = INTEGER NOT NULL WITH DEFAULT; /*PerformMovesArray Index*/
   PC = FMS_PhaseCheckEquip;
   PhaseCheckRqd = INTEGER NOT NULL WITH DEFAULT;/*Flag signaling phase check*/
   PhaseCheckWP = INTEGER NOT NULL;
   Row = INTEGER NOT NULL WITH DEFAULT;
   ReducedList = ARRAY OF OperatorClass;  /* Reduced list of operators */
   SameHybrid = INTEGER NOT NULL WITH DEFAULT;
   SavedElectronicList = ARRAY OF OperatorClass;  /* copy of initial list */
   SavedVerbalList = ARRAY OF OperatorClass;  /* copy of initial list */
   ScenarioList = ARRAY OF ScenarioHistory; /*List of scenarios to download*/
   ScenarioName = VARCHAR(40) NOT NULL;   /* From Udb_Type */
   ScenarioObject = VARCHAR(80) NOT NULL;   /* From Udb_Object */
   ShiftTime = INTEGER NOT NULL WITH DEFAULT;
   SimpleCard = CardSOA;
   SimpleEquip = EquipInProgress;          /*Enables use of class methods */
   SimpleJob = JobInProgress;             /*Enables use of class methods */
   SingleSWP = OutageReport DEFAULT NULL;
   StreetMove = INTEGER NOT NULL WITH DEFAULT;
   TempObjective = VARCHAR(400) NOT NULL; /*Temporary until scenario builder */
   ToRs = INTEGER NOT NULL WITH DEFAULT;
   TypeOfDay = INTEGER NOT NULL WITH DEFAULT;
   WirelessCrew = INTEGER NOT NULL WITH DEFAULT;    /*BOOLEAN*/ 
) =
DECLARE
/*
** local procedures
*/
    FilterElectronicOperators = PROCEDURE;
    IssueBusSectWP = PROCEDURE;
    ResetTwoOpGlobalVariables = PROCEDURE;
    TwoOpReview = PROCEDURE RETURNING INTEGER;
ENDDECLARE
BEGIN
/*
**  Initialize PendingOpStep.SetFlag to FALSE and Job = 0.  This is set to true
**  in the OperatingStep_ASE when an operating step is set. Job is set after
**  performing jobactions.  
**  Any other operating steps that are set from the moves being issued 
**  are entered into the FMS_PendingOpStep table.  
*/
   CallXA21Moves.Clear();
   PendingOpStep.SetFlag = FALSE;
   PendingOpStep.Job     = 0;
   PortableGroundConditionisON = FALSE;
   EnhancedTwoOpReview = FALSE;
   TwoOpConfirmEvent = 'now';
   ForceAbort33kV = FALSE;   
/*
** Delay JobCheck to determine if electronic op selected and for enhanced two op warning 
*/ 
   IF UserGroup = Group$SICC THEN
      FIELD(Menu.File.Operator).CurBias = MB_ENABLED;
   ENDIF;
/*
** Default Steam card to all street = yes, then change if needed during move evaluation
*/
   IF CurrentApplication = Application$SDS THEN
      AllSteamStreet = TRUE;
      AllSteamStreetEligible = TRUE;
      StreetMove = 0;
   ENDIF;
   FoundOperator = FALSE;
   SimpleCard = NULL;
   FIELD(JD).SetToDefault();
   BlankJD = JD.Duplicate();
   FIELD(Crew).CurBias = FB_INVISIBLE;
   GenOpName.Value = '';
   JIP.Clear();
   WarningBuffer.Clear();
   i = 1;
   WHILE i <= J.LastRow() DO

#     include ConvertJobToJobInProgress

      SELECT  :JIP[i].LockNumber = O.LockNumber,
              :JIP[i].Combination = O.Combination
      FROM    Udb_Object O
      WHERE   O.Object = :JIP[i].Equip;

      Moves[i] = JIP[i].Duplicate();

      /* fix the colors of the moves */
      IF Moves[i].TOIssued = '' THEN
         FIELD(Moves[i].TOIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;
      IF Moves[i].RSIssued = '' THEN
         FIELD(Moves[i].RSIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;
/*
**  If we are issuing a restore move,  show rsmove text
*/
      IF Moves[i].Status = Job$Restore THEN
         Moves[i].TOMove = Moves[i].RSMove;
      ENDIF;
/*
**  Set TORS field since it doesn't appear to be set but is starting
**  to get used.
*/
      IF Moves[i].Status = Job$Restore THEN
         Moves[i].TORS = Job$RestoreInt;
      ELSEIF Moves[i].Status = Job$TakeOut THEN
         Moves[i].TORS = Job$TakeoutInt;
      ENDIF;
/*
**  If not a street valve move, then clear All Street Flag
*/
      IF AllSteamStreet = TRUE AND J[i].StepPair <> StepHeading$Street THEN
         AllSteamStreet = FALSE;
         AllSteamStreetEligible = FALSE;
      ENDIF;

      i = i + 1;
   ENDWHILE;
   IF Moves.LastRow() = 1 THEN
      AllSteamStreet = FALSE;
      AllSteamStreetEligible = FALSE;
   ENDIF;
   PerformMovesArray = Moves.Duplicate();
/*
** If this is a automation warning review, Block will be non-zero and certain functions 
** must be disabled on this screen.  We also force the scroll to the move that is
** "next" (not issued).  Some moves may have been issued during automation execution.
** DO will review warnings, then be forced to Abort.
*/
   i = 1;  /*Index for first move to highlight*/
   IF Block <> 0 THEN
/*
** Find the first non-issued move.
*/
      FOR k = 1 TO Moves.LastRow() DO
         IF Moves[k].Status = Job$TakeOut AND Moves[k].TOIssued IS NULL THEN
            i = k;
            MoveRow = k - 1;  /*Set this for HighlightMove event*/
            ENDLOOP;
         ELSEIF Moves[k].Status = Job$Restore AND Moves[k].RSIssued IS NULL THEN
            i = k;
            MoveRow = k - 1;  /*Set this for HighlightMove event*/
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDIF;   
/*
**  Load data for first move in the list prior to operator selection.
**  Keeps screen from looking blank.
*/
   JD = SimpleEquip.LoadEquipDetails(Equip = Moves[i].Equip);
   IF Moves[i].Equip = 0 THEN
      JD.EquipComment = '';
   ENDIF; 
/*
**  Load Data that wasn't selected.
*/
   JD.PrintID = Moves[i].PrintID;
   JD.EquipName = Moves[i].EquipName;
   JD.Response = Moves[i].Response; 
   JD.MoveText = Moves[i].TOMove;
/*
**  Position Operator List to last selected operator, or other
**  defaults as may be the case
*/
   IF CurrentApplication = Application$TFMS OR 
      CurrentApplication = Application$SLC THEN
/*      DefaultOperator = Operator$XA21; */
       DefaultOperator = FO.Object;
    ELSEIF Block <> 0 AND AutoTarget <> '' THEN
      IF AutoTarget = 'FCR' THEN  
         DefaultOperator = Operator$FCR;
      ELSEIF AutoTarget = 'FOD' THEN 
         DefaultOperator = Operator$FOD;
         WirelessCrew = TRUE;
      ELSEIF AutoTarget = '#9' THEN 
         DefaultOperator = Operator$NO9;
         WirelessCrew = TRUE;
      ELSEIF AutoTarget = 'SSO' THEN
         DefaultOperator = Operator$OpOrder;
      ENDIF;
   ELSEIF FO.Object <> Operator$SOCCSX THEN
      DefaultOperator = FO.Object;
   ENDIF;

   Selected.Description = '';
   Selected.Name = '';
   Selected.Object = 0;
/*
** If in Process Auto Setup Mode, then only three operators are available.
** If first move is an enabled substation then only choice is SSO, otherwise FOD or NO9.
*/
   IF ProcessAutoMode = TRUE THEN
      m = 0;
      SELECT :m = 1
      FROM   Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  G.Member = :Moves[i].Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation;

      IF m > 0 THEN
/*
** Consider macro or hybrid substation
*/
         MacroStation = FALSE;
         SELECT :MacroStation = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Moves[i].Substation AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$MacroSubstation;

         HybridStation = FALSE;
         SELECT :HybridStation = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Moves[i].Substation AND
                G.Relationship = :Interaction$ShareControlRoom AND
                G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                   WHERE  SuperType = :Type$Substation);

         IF MacroStation <> FALSE THEN
            OpOrderSubstation = MacroStation;
         ELSEIF HybridStation <> FALSE THEN
            OpOrderSubstation = HybridStation;
         ELSE
            OpOrderSubstation = Moves[i].Substation;           
         ENDIF;

         m = 0;
         SELECT :m = SOA_To_SOO
         FROM   SOO_Communication
         WHERE  Substation = :OpOrderSubstation;
      ENDIF;

      FOR i = 1 TO OperatorList.LastRow() DO
/*
** Find proper SSO or FOD operator from list.
*/
         IF OperatorList[i].Object = Operator$OpOrder AND m = 1 THEN
            ElectronicOperator[1] = OperatorList[i].Duplicate();
         ELSEIF (OperatorList[i].Object = Operator$FOD OR
                 OperatorList[i].Object = Operator$NO9) AND m = 0 THEN
            LastRow = ElectronicOperator.LastRow() + 1;
            ElectronicOperator[LastRow] = OperatorList[i].Duplicate();
         ENDIF;
      ENDFOR;
/*
** If reviewing warning, then set operator and highlight move
*/             
   ELSEIF Block <> 0 THEN

      FOR i = 1 TO OperatorList.LastRow() DO
         IF OperatorList[i].Object = DefaultOperator THEN
            ElectronicOperator[1] = OperatorList[i].Duplicate();
            Selected.Object = ElectronicOperator[1].Object;
            Selected.Name = ElectronicOperator[1].Name;
            Selected.Description = ElectronicOperator[1].Description;
            FO.Object = ElectronicOperator[1].Object;
            FO.Name = ElectronicOperator[1].Name;
            FO.Description = ElectronicOperator[1].Description;
            ENDLOOP;
         ENDIF;
      ENDFOR;
    
      FIELD(Issue_Btn).CurBias = FB_DIMMED;
      FIELD(Download_Btn).CurBias = FB_DIMMED;
      FIELD(Skip_Btn).CurBias = FB_DIMMED;
      FIELD(Cancel_Btn).CurBias = FB_DIMMED;
      FIELD(Abort_Btn).CurBias = FB_LANDABLE;
      CurFrame.SendUserEvent (EventName = 'HighlightMove');
 
   ELSE   
      DefaultOpTbl = '';
      DefaultOpRow = 0;
      i = 1;
      k = 0;
      m = 0;
      WHILE i <= OperatorList.LastRow() DO
         IF OperatorList[i].Electronic = 1 THEN
            k = k + 1;
            ElectronicOperator[k] = OperatorList[i].Duplicate();
            IF ElectronicOperator[k].Object = DefaultOperator THEN
               DefaultOpTbl = 'E';
               DefaultOpRow = k;
             ENDIF;
         ELSE
            m = m + 1;
            VerbalOperator[m] = OperatorList[i].Duplicate();
            IF VerbalOperator[m].Object = DefaultOperator THEN
               DefaultOpTbl = 'V';
               DefaultOpRow = m;
            ENDIF;
         ENDIF;         
         i = i + 1;
      ENDWHILE;
      IF DefaultOpTbl = 'E' THEN
         FIELD(ElectronicOperator).ActiveRow = DefaultOpRow;
      ELSE
         FIELD(VerbalOperator).ActiveRow = DefaultOpRow;
      ENDIF;
      /*FMS330: if all the moves are associated to equipment in a substation that is enabled 
      ** for electronic communication, these moves should not be issued to the FOD or to #9.   
      */
      CALLPROC FilterElectronicOperators ();
  ENDIF;
  SavedElectronicList = ElectronicOperator.Duplicate();
  SavedVerbalList = VerbalOperator.Duplicate();
/*
**  Very strange.  Curframe.Flush needs to happen after the substation
**  field is made invisible or not and before positioning the frame.  IF 
**  Curframe.flush is not done in the middle frame won't look right.  It
**  will get pushed down to the lower right corner of the screen.
*/
   IF CurrentApplication = Application$FMS THEN
      FIELD(Moves[*].SubstationName).CurBias = FB_INVISIBLE;
   ELSE
      FIELD(Moves[*].SubstationName).CurBias = FB_LANDABLE;
   ENDIF;
   CurFrame.Flush();
/*
**  Position Frame
*/
   IF CurrentApplication = Application$FMS THEN
      CurFrame.WindowYTop = FCFrame.WindowYTop + 1500;
/*      CurFrame.WindowYTop = FCFrame.WindowYTop + FCFrame.WindowHeight -
                            CurFrame.WindowHeight + 250;*/
      CurFrame.WindowXLeft = FCFrame.WindowXLeft + (FCFrame.WindowWidth - 
                             CurFrame.WindowWidth)/2;
   ELSE
      CurFrame.WindowYTop = SOAFrame.WindowYTop + 1500;
/*      CurFrame.WindowYTop = SOAFrame.WindowYTop + SOAFrame.WindowHeight -
                            CurFrame.WindowHeight + 250;*/
      CurFrame.WindowXLeft = SOAFrame.WindowXLeft + (SOAFrame.WindowWidth - 
                             CurFrame.WindowWidth)/2;
   ENDIF;

   IF Block = 0 THEN
/*
**  Set input focus on something, otherwise an operator will get selected
**  and we want them to have to select which operator they want.
*/
      CurFrame.InputFocusField = FIELD(Selected.Description);
      CurFrame.StatusText = 'Must first select an operator before issuing moves...';
      CurFrame.Flush();
   ENDIF;
/*
**  Do JobChecks for first row unless we are process auto setup or review warnings 
****Delaying JobChecks for all apps for Two Op Override
   IF ProcessAutoMode = FALSE AND Block = 0 THEN
      FO.Object = 0;
      RetCode = Moves[1].JobChecks(IssueCompl = JobClass$Issue);

      IF RetCode = PU_CANCEL THEN
         RETURN PU_CANCEL;
      ENDIF;
   ENDIF;
*/   
   IF UserRole = Role$Steam THEN
      IF OpASE IS NULL THEN
         OpASE = OperatorClass_ASE.Create();
      ENDIF;

      RetCode = OpASE.LoadBySkill(JobClass = Moves[1].JobClass);
    
      IF RetCode = -1 THEN    /*Job Does not require skill, proceed normally*/
      ELSEIF RetCode = -2 THEN    /*No operators possess required skill, proceed normally*/
         MESSAGE 'The Move has a skill requirement, but no operators have this skill, so ' +
                 'select any verbal operator';
      ELSE
         VerbalOperator.Clear(); 
         VerbalOperator = OpASE.OL.Duplicate();
         SavedVerbalList = VerbalOperator.Duplicate();
      ENDIF;
   ENDIF;
END;

/*
** show equipment details for the current job row.
*/
ON ChildProperties Moves =
BEGIN
   i = FIELD(moves).WhichRow (cellfield = CurFrame.TriggerField);
   IF (i > 0) THEN

      CALLFRAME ShowJobDetails (J = Moves[i]);
   ENDIF;
END;
/*
** Allow selection of Steam Street moves
*/
ON ChildEntry Moves =
BEGIN
   
   IF AllSteamStreet = FALSE THEN
      RESUME NEXT;
   ENDIF;
   i = FIELD(moves).WhichRow (cellfield = CurFrame.TriggerField);
   IF Field(Moves[i].Confirm).BGColor = CC_PALE_CYAN AND 
       CurFrame.TriggerField.Name LIKE '%confirm%' THEN
      RESUME NEXT;
   ENDIF;
   IF (i > 0) THEN
      IF Moves[i].TORS = Job$TakeoutInt AND Moves[i].TOIssued IS NOT NULL THEN
         MESSAGE 'TakeOut move has already been issued.';
         RESUME;
      ELSEIF Moves[i].TORS = Job$RestoreInt AND Moves[i].RSIssued IS NOT NULL THEN
         MESSAGE 'Restore move has already been issued.';
         RESUME;
      ENDIF;
      IF Field(Moves[i].TOMove).BGColor = CC_LIGHT_GRAY THEN
         RESUME;
      ENDIF;
      StreetMove = i;
      CurFrame.SendUserEvent (EventName = 'HighlightMove');
   ENDIF;
END;


ON UserEvent 'SkipAllMoves' = 
BEGIN
/*
**  See if any moves have been issued yet
*/
   i = 1;
   WHILE i < MoveRow DO
      IF Moves[i].Status = Job$TakeOut THEN
         IF (Moves[i].TOIssued IS NOT NULL AND Moves[i].TOIssued <> '') AND
            (Moves[i].TOComplete IS NULL OR Moves[i].TOComplete = '') THEN 
             ENDLOOP;
         ENDIF;
      ELSEIF Moves[i].Status = Job$Restore THEN
         IF (Moves[i].RSIssued IS NOT NULL AND Moves[i].RSIssued <> '') AND
            (Moves[i].RSComplete IS NULL OR Moves[i].RSComplete = '') THEN 
             ENDLOOP;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  Set IsReverse = False here BGColor turn gray 
*/
   IF MoveRow <> 0 THEN
      Field(Moves[MoveRow].TOMove).ISReverse = FALSE;
      FIELD(Skip_Btn).CurBias = FB_DIMMED;
      FIELD(Issue_Btn).CurBias = FB_DIMMED;
   ENDIF;

   IF i = MoveRow OR 
      MoveRow = 0 THEN /* No moves were issued */
      AutoReturn = 1;
      CALLPROC ResetTwoOpGlobalVariables();

      RETURN PU_CANCEL;
/*
**  If issuing all street moves, they might be issued in any order, we
**  gray out all the non-issued ones.
*/
   ELSEIF AllSteamStreet = TRUE THEN
      MoveRow = 1;
      WHILE MoveRow <= Moves.LastRow() DO
        IF (Moves[MoveRow].Status = Job$TakeOut AND Moves[MoveRow].TOIssued IS NULL) OR
           (Moves[MoveRow].Status = Job$Restore AND Moves[MoveRow].RSIssued IS NULL) THEN
         Field(Moves[MoveRow].TOIssued).BGColor  = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].SubstationName).BGColor  = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].PrintID).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].EquipClassName).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].EquipName).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].TOMove).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Response).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].LockNumber).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Combination).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].RSIssued).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Confirm).BGColor = CC_LIGHT_GRAY;
        ENDIF;
        MoveRow = MoveRow + 1;
      ENDWHILE;
   ELSE
      WHILE MoveRow <= Moves.LastRow() DO
         Field(Moves[MoveRow].TOIssued).BGColor  = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].SubstationName).BGColor  = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].PrintID).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].EquipClassName).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].EquipName).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].TOMove).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Response).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].LockNumber).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Combination).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].RSIssued).BGColor = CC_LIGHT_GRAY;
         Field(Moves[MoveRow].Confirm).BGColor = CC_LIGHT_GRAY;
         MoveRow = MoveRow + 1;
      ENDWHILE;

      FIELD(Issue_Btn).CurBias = FB_Dimmed;
      FIELD(Skip_Btn).CurBias = FB_Dimmed;
      IF Selected.Object <> Operator$FCR THEN
         FIELD(Abort_btn).CurBias = FB_LANDABLE;
      ENDIF;
/*
** Don't enable download if Automation Warning Review 
*/
      IF (Selected.Object = Operator$OpOrder OR
          WirelessCrew = TRUE) AND Block = 0 THEN
         CurFrame.SendUserEvent (EventName = 'EnableDownload');
      ENDIF;
   ENDIF;
END;

/*
**  Update MoveRow Visual characteristics
*/
ON UserEvent 'HighlightMove' = 
DECLARE
   GroundCount = INTEGER NOT NULL WITH DEFAULT;
   GroundMove = INTEGER NOT NULL WITH DEFAULT;
   SourcePosition = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
**  Check to see if user selected an operator
*/
   IF Selected.Object <= 0 THEN
      message 'You must select an operator before issuing a move.';
      RESUME;
   ENDIF;
/*
**  Highlight current row
*/
   IF StreetMove > 0 THEN
      MoveRow = StreetMove;
      FOR i = 1 TO Moves.LastRow() DO
         IF i <> MoveRow THEN
            Field(Moves[i].TOMove).ISReverse = FALSE;
         ENDIF;
      ENDFOR;
      FIELD(Skip_Btn).CurBias = FB_LANDABLE;
      FIELD(Issue_Btn).CurBias = FB_LANDABLE;
   ELSEIF MoveRow >= Moves.LastRow() THEN
      MESSAGE 'Issue button was clicked too fast, will need to exit screen and retry if necessary to issue ' +
              'any remaining moves.';
      RESUME;
   ELSE
      MoveRow = MoveRow + 1;
   ENDIF;
   Field(Moves[MoveRow].TOMove).ISReverse = TRUE;
/*
**  Do this so table field will scroll automatically if the are 
**  a lot of moves being issued
*/
   Field(Moves).ActiveRow = MoveRow;

   FIELD(JD).SetToDefault();
/*
**  Initialize the stack field for Phase Checks and common manhole. It will be displayed later if needed.
*/
   IF FIELD(JD.PhaseCheck).ParentField.CurBias = FB_LANDABLE THEN
      FIELD(JD.PhaseCheck).ParentField.CurBias = FB_INVISIBLE;
      CurFrame.Flush();
      CurFrame.WindowHeight =
          STACKFIELD(FIELD(JD).ParentField.ParentField.ParentField).Height;
   ENDIF;
      
   WarningBuffer.Clear();
   CurFrame.StatusText = 'Performing Checks...';
   CurFrame.Flush();

   JD = SimpleEquip.LoadEquipDetails(Equip = Moves[MoveRow].Equip);
   IF Moves[MoveRow].Equip = 0 THEN
      JD.EquipComment = '';
   ENDIF;
/*
**  Look for Two Position Switch based on equip comment!  Temporary!!
*/
   IF Selected.Object = Operator$OpOrder OR
      Selected.Object = Operator$FOD OR
      Selected.Object = Operator$NO9 OR
      Selected.Object = Operator$FCR THEN

      IF JD.EquipComment LIKE '%MUST ACCOMPANY%' THEN
         MESSAGE '2-position switch that opens to ground cannot be downloaded to RapidRestore, process verbally.';
         CurFrame.SendUserEvent (EventName = 'SkipAllMoves');
         RESUME NEXT;
      ENDIF;
   ENDIF;
/*
**  Load Data that wasn't selected.
*/
   JD.PrintID = Moves[MoveRow].PrintID;
   JD.EquipName = Moves[MoveRow].EquipName;
   JD.Response = Moves[MoveRow].Response; 
   JD.MoveText = Moves[MoveRow].TOMove;

   IF Moves[MoveRow].Status = Job$Restore THEN
      Moves[MoveRow].RSOperator = Selected.Object;
   ELSE
      Moves[MoveRow].TOOperator = Selected.Object;
   ENDIF;
/*
**  Perform JobCheck on highlighted move.
**  If we are reviewing warning, okay to do checks but we will skip all remaining moves
   IF (MoveRow > 1 OR Block <> 0) AND ProcessAutoMode = FALSE THEN
*/
   IF ProcessAutoMode = FALSE THEN
      RetCode = Moves[MoveRow].JobChecks(IssueCompl = JobClass$Issue);

      IF Block <> 0 THEN
         CurFrame.StatusText = 'Abort Required after review of Process Automation Warning...';
         CurFrame.Flush();
         CurFrame.SendUserEvent (EventName = 'SkipAllMoves');
         RESUME NEXT;
      ENDIF;

      IF RetCode = PU_CANCEL THEN
         CurFrame.SendUserEvent (EventName = 'SkipAllMoves');
         RESUME NEXT;
      ENDIF;
   ENDIF;
/*
**  Check to see if operator possesses required skills for move
*/
   RetCode = CALLPROC OperatorChecks(JIP = BYRef(Moves[MoveRow]),
                                     IssuedOperator = IFNULL(Selected.Object,0));
   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;

   IF Selected.Object = Operator$FCR AND EnhancedTwoOpReview = TRUE THEN
           RetCode = CALLPROC TwoOpReview(Card = Moves[MoveRow].Card,
                                       SwitchingItem = Moves[MoveRow].SwitchingItem,
                                       Job = Moves[MoveRow].Job);
           IF RetCode = PU_CANCEL THEN
              CurFrame.SendUserEvent (EventName = 'AbortIssuedMoves');
              RESUME NEXT;
           ENDIF;
   ENDIF;

   IF CurrentApplication = Application$FMS THEN
/*
**  Check to see if Phase Check is required.
*/
      IF Moves[MoveRow].Status = Job$Restore AND 
        (Moves[MoveRow].StepPair = StepHeading$DeLoad OR 
         Moves[MoveRow].StepPair = StepHeading$Iso) THEN

         CustomerCrewRequest = FALSE;
         SELECT :CustomerCrewRequest = Status
         FROM   FMS_JobAction          
         WHERE  TypeOfCard = :CardDetails.TypeOfCard AND                 
                JobClass = :Moves[MoveRow].JobClass AND
                EquipClass = :Moves[MoveRow].MoveEquipClass AND
                StepPair = :Moves[MoveRow].StepPair AND
                TORS = :Moves[MoveRow].TORS AND
                Status = :Prompt$RequestCustomerCrew;
                                
        IF CustomerCrewRequest = FALSE THEN                 
         PhaseCheckRqd = 0;
         SELECT :PhaseCheckRqd = COUNT(*)
         FROM   FMS_PhaseCheck
         WHERE  Card = :Moves[MoveRow].Card AND
                SatisfyEquip = :Moves[MoveRow].Equip AND
                CompletionTime IS NULL
         UNION
         SELECT P.SatisfyEquip
         FROM   FMS_PhaseCheck P,
                FMS_PortionLink L
         WHERE ((L.Card = :Moves[MoveRow].Card AND
                 L.PortionCard = P.Card) OR
                (L.PortionCard = :Moves[MoveRow].Card AND
                 L.Card = P.Card)) AND
                 P.SatisfyEquip = :Moves[MoveRow].Equip AND
                 P.CompletionTime IS NULL;       
/*
**  Only prompt user about phase check if feeder is in service.
**  PhaseCheckRqd will be used later to see if a new job needs to 
**  be inserted if all phase check moves were completed prior to cutout.
*/
         IF PhaseCheckRqd > 0 THEN

         OOSCheck = 0;
         SELECT  OOSCheck = 1
         FROM    FMS_Card
         WHERE   Card = :Moves[].Card AND 
                (CutOut IS NULL OR 
                 CutIn IS NOT NULL);

         IF OOSCheck = 1 AND ProcessAutoMode = FALSE THEN

            RetCode = CALLPROC SOA_LogIns (
                Card           = Moves[].Card
               ,Job            = Moves[].Job
               ,SwitchingItem  = Moves[].SwitchingItem
               ,Time           = DATE('now')
               ,UserName       = UserName
               ,Item           = 'Phase Check'
               ,Old            = 'Phase Check Issued on:'
               ,New            = JD.PrintID + '  ' + 
                                 trim(left(JD.EquipClassName,10)) + '  ' +
                                 trim(left(JD.EquipName,14))
               );
         
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 'Unable to Log confirmation.  Please contact technical support.' + 
                         HC_NEWLINE +
                        'Card: ' + HC_TAB + varchar(Moves[].Card) + HC_NEWLINE + 
                        'Job: '  + HC_TAB + varchar(Moves[].Job) + HC_NEWLINE +
                        'Item: ' + HC_TAB + 'Phase Check' + HC_NEWLINE + 
                        'Old: '  + HC_TAB + 'Phase Check Issued on:' + HC_NEWLINE + 
                        'New: '  + HC_TAB + JD.PrintID + '  ' + 
                                 trim(left(JD.EquipClassName,10)) + '  ' +
                                 trim(left(JD.EquipName,14)),
                  TraceMessage = 'Frame:PerformMoves;Unable to Log confirmation. ' +  HC_NEWLINE +
                        'Card: ' + varchar(Moves[].Card) + ' Job: '  + varchar(Moves[].Job) +
                        'Item: ' + 'Phase Check' + 'Old: '  + 'Phase Check Issued on:' + 'New: '  + JD.PrintID + '  ' + 
                                 trim(left(JD.EquipClassName,10)) + '  ' +
                                 trim(left(JD.EquipName,14)));
            ENDIF;
            CALLPROC DDB_COMMIT;

            FIELD(JD.PhaseCheck).CurBias = FB_VISIBLE;
            FIELD(JD.PhaseCheck).ParentField.CurBias = FB_LANDABLE; 
            JD.PhaseCheck = 'PHASE CHECK';            
         ENDIF;
         ENDIF;
        ENDIF; 
      ENDIF;
/*
**  Establish whether we should prompt for Grounds on verbal order
*/ 
      IF Selected.Object <> Operator$OpOrder AND
         Selected.Object <> Operator$FOD AND
         Selected.Object <> Operator$NO9 AND
         Selected.Object <> Operator$FCR THEN
/*
**  Is there a Ground objective tied to this move?
*/
         GroundObjective = 0;
         SELECT :GroundObjective = JO.Objective 
         FROM   FMS_JobObjective JO
         WHERE  JO.JobClass = :Moves[MoveRow].JobClass 
           AND  JO.TORS = :Moves[MoveRow].TORS
           AND  JO.Objective IN (:Objective$BkrOpenApplyGnd, :Objective$RemoveIATCApplyGnd, :Objective$ApplyFdrGnd);
/*
**  Does the feeder source have a Test Bus?
*/       
         IF GroundObjective > 0 THEN
/*
** find the source equipment bus type of the feeder
*/
            BusConfig  = 0;
            GroundFeeder = 0;
            SELECT :BusConfig = BC.BusType,
                   :GroundFeeder = O1.Object   
            FROM   Udb_Object O1,
                   Udb_Object O2,
                   Udb_Grouping G,
                   FMS_BusConfiguration BC,
                   TFMS_CardToObject CTO
            WHERE  CTO.Card = :Moves[MoveRow].Card 
              AND  CTO.Object = O1.Object 
              AND  G.Grouping = O1.Object 
              AND  G.RelationShip = :Interaction$SourceBreaker
              AND  G.Member = O2.Object 
              AND  O2.PrimaryGrouping = O1.PrimaryGrouping 
              AND  O2.Type = BC.EquipClass 
              AND  BC.BusType IN (:BusConfig$ROBkrTestBus, 
                                  :BusConfig$ROBkrTestBusJamaica, 
                                  :BusConfig$FixBkrTestBus); 

            IF BusConfig >  0 AND GroundFeeder > 0  THEN

               RetCode = -1;
               IF GroundObjective <> Objective$ApplyFdrGnd THEN
                  RetCode = CALLFRAME SSOOrderGround();
               ELSE
                  RetCode = 1; /* Force Feeder Ground Logic */
               ENDIF;
/*
** Set or Remove G&T or Feeder Ground status for the feeder.
*/
               IF RetCode = 0 THEN     /* Test Bus Ground */

                  RetCode = CALLPROC FMS_ObjStatDel (Object = GroundFeeder,
                                                     Status = Status$GTGnd);
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to clear G&T Gnd status for the current feeder. ' +
                            'Please contact technical support.';
                  ELSE
                     CALLPROC DDB_COMMIT;
                  ENDIF;

                  RetCode = CALLPROC FMS_ObjStatDel (Object = GroundFeeder,
                                                     Status = Status$FdrG);
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to clear Feeder Gnd status for the current feeder. ' +
                             'Please contact technical support.';
                  ELSE
                     CALLPROC DDB_COMMIT;
                  ENDIF;

               ELSEIF RetCode = 1 THEN /* Feeder Ground */

                  RetCode = CALLPROC SetStatus (Object = GroundFeeder,
                                                Status = Status$FdrG);
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to set Feeder Ground status for the current feeder. ' +
                             'Please contact technical support.';
                  ELSE 
                     RetCode = CALLPROC FMS_ObjStatDel (Object = GroundFeeder,
                                                        Status = Status$GTGnd);
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        MESSAGE  'Unable to set Feeder Ground status and clear G&T Gnd status for the current feeder. ' +
                                 'Please contact technical support.';
                     ELSE
                        CALLPROC DDB_COMMIT;
                     ENDIF;
                  ENDIF;
               ELSEIF RetCode = 2 THEN /* G&T Ground */

                  RetCode = CALLPROC SetStatus (Object = GroundFeeder,
                                                Status =  Status$GTGnd);
                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to set G&T Ground status for the current feeder. ' +
                             'Please contact technical support.';
                  ELSE 
                     RetCode = CALLPROC FMS_ObjStatDel (Object = GroundFeeder,
                                                        Status = Status$FdrG);
                     IF RetCode < 0 THEN
                        CALLPROC DDB_ROLLBACK;
                        MESSAGE 'Unable to set G&T Ground status and clear Feeder Gnd status for the current feeder. ' +
                                'Please contact technical support.';
                     ELSE
                        CALLPROC DDB_COMMIT;
                     ENDIF;
                  ENDIF;
               ENDIF;
            ENDIF;
         ENDIF;
      ENDIF;   
/*
** Check if first ground on portion 33kV card
*/    
      IF CardDetails.NetworkFeeder = NetworkFeeder$33kV AND CardDetails.TypeOfCard = TypeOfCard$Portion THEN
         GroundMove = 0;
         SELECT :GroundMove = Status
         FROM   FMS_JobAction          
         WHERE  TypeOfCard = :CardDetails.TypeOfCard AND                 
                JobClass = :Moves[MoveRow].JobClass AND
                EquipClass = :Moves[MoveRow].MoveEquipClass AND
                StepPair = :Moves[MoveRow].StepPair AND
                TORS = :Moves[MoveRow].TORS AND
                Action = :JobAction$Increment AND
                FeederEquip = 2 AND
                Status = :Status$Ground;

         IF GroundMove = Status$Ground THEN
/*
**          Look for Source Position and Ground Count
*/          
            GroundCount = 0;
            SourcePosition = 0;
            SELECT :GroundCount = C.GroundsOn
            FROM   FMS_Card C
            WHERE  C.Card = :CardDetails.Card;
 
            REPEATED
            SELECT :SourcePosition = G.Member 
            FROM   TFMS_CardToObject CTO,
                   Udb_Grouping G
            WHERE  CTO.Card = :CardDetails.Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$SourcePosition; 

            IF GroundCount = 0 AND SourcePosition = 0 THEN
               RetCode = CALLFRAME Confirm (
                           Card = CardDetails.Card, 
                           Job = Moves[MoveRow].Job,
                           SwitchingItem = 0,
                           Text = 'This equipment will be used as the Station Ground. Is this your intent?');
               IF RetCode = PU_CANCEL THEN
                  CurFrame.SendUserEvent (EventName = 'SkipMove');
                  RESUME NEXT;
               ENDIF;
            ENDIF;
         ENDIF; 
      ENDIF;
   ENDIF;

   IF FIELD(JD.PhaseCheck).ParentField.CurBias = FB_LANDABLE THEN
      CurFrame.Flush();
      CurFrame.WindowHeight = 
               STACKFIELD(FIELD(JD).ParentField.ParentField.ParentField).Height;
   ENDIF;         

   CurFrame.StatusText = 'Okay to continue with moves...';
   CurFrame.Flush();
END;
   
/*
**  Handle Issue_btn click
*/
ON CLICK Issue_Btn =
DECLARE
   ISP = InServicePermitClass DEFAULT NULL;
   ISWorkPermit = INTEGER NOT NULL WITH DEFAULT;
   AKx = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   JobSubstation = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Check to see if user selected an operator
*/
   IF Selected.Object <= 0 THEN
      message 'You must select an operator before issuing a move.';
      RESUME;
   ENDIF;
   IF MoveRow = 0 THEN
      MESSAGE 'Please reselect your moves to issue.';
      RESUME;
   ENDIF;
/*
** Look for AK2/AK3 Block Condition, Card must be Cutin
*/
   IF Moves[MoveRow].Status = Job$TakeOut AND 
      (Moves[MoveRow].Substation = 144060 OR Moves[MoveRow].Substation = 144231) THEN   // AK2 or AK3  
                     
      AKx = 0;
      SELECT :AKx = 1
      FROM   SOA_Card
      WHERE  Card = :Moves[MoveRow].Card AND
             CutIn IS NOT NULL;
      IF AKx = 1 THEN
         MESSAGE 'You may not issue new Arthur Kill takeout moves after Card CutIn. ' +
                 'You will need to create a transfer card to issue this move.'; 
         CurFrame.SendUserEvent (EventName = 'SkipMove');
         RESUME NEXT;
      ENDIF;
   ENDIF;   
/*
** Check for double click/quick click to avoid MoveRow getting out of bounds in Highlight Move
** If move issue processing is already done then get out.
*/
   IF Moves[MoveRow].Status = Job$TakeOut AND Moves[MoveRow].TOIssued IS NOT NULL THEN
      RESUME NEXT;
   ELSEIF Moves[MoveRow].Status = Job$Restore AND Moves[MoveRow].RSIssued IS NOT NULL THEN
      RESUME NEXT;
   ENDIF;
/*
**  Don't allow to change selected operator again, try to avoid flickering
*/
   IF STACKFIELD(FIELD(Selected).ParentField.ParentField).CurBias <> FB_Visible THEN
      STACKFIELD(FIELD(Selected).ParentField.ParentField).CurBias = FB_Visible;
   ENDIF;
/*
**  Set FO = Current Field Operator selected
*/
   FO.Object  = Selected.Object; 
   FO.Name = Selected.Name;
   FO.Description = Selected.Description;
/*
** If the highlighted move is FCR Caution, prompt DO to enter explanation.
*/
   IF Moves[MoveRow].JobClass = JobClass$FCRCaution AND
      Moves[MoveRow].Status = Job$Restore THEN
      RetCode = CALLFRAME ManualLiftFCRCaution(Job = Moves[MoveRow]);

      IF RetCode = PU_CANCEL THEN
         CurFrame.SendUserEvent (EventName = 'SkipMove');
         RESUME NEXT;
      ENDIF;
   ENDIF;
/*
** For first move, check PortableGround flag and perform check post-operator selection.
*/
   IF MoveRow = 1 AND PortableGroundConditionisON = TRUE THEN

      RetCode = CALLPROC CheckPortableGround (JIP = Moves[1]);

      IF RetCode = Warning$Overridden THEN
         OverrideRC = CALLFRAME Override (
                     Card = Moves[1].Card,
                     Job = Moves[1].Job,
                     SwitchingItem = Moves[1].SwitchingItem);
      ENDIF;
      IF RetCode = PU_CANCEL OR OverrideRC IS NULL THEN
         CALLPROC ResetTwoOpGlobalVariables();
        
         RETURN (PU_CANCEL);
      ENDIF;
   ENDIF;  

   Complete = 'now';
/*
** If manual entry mode is true, allow them to change the complete time
*/
   IF ManualEntryModeFlag = TRUE THEN
      IF Moves[MoveRow].Status = Job$TakeOut THEN
         Moves[MoveRow].TOIssued = Complete;
         CALLFRAME ManualTimeEntry 
                (Move = Moves[MoveRow],
                 MessageText = 'TO Issue');
         Complete = Moves[MoveRow].TOIssued
      ELSE
         Moves[MoveRow].RSIssued = Complete;
         CALLFRAME ManualTimeEntry 
                (Move = Moves[MoveRow],
                 MessageText = 'RS Issue');
         Complete = Moves[MoveRow].RSIssued
      ENDIF;
   ENDIF;

   IF ProcessAutoMode = FALSE THEN

      RetCode = SimpleJob.IssueMove(Job = Moves[MoveRow],
                                 SetTime = Complete);

      IF RetCode = PU_CANCEL THEN
         CurFrame.SendUserEvent (EventName = 'SkipMove');
         RESUME NEXT;
      ELSE
/*
**   Log generic Steam Operator.
*/
         IF GenOpName.Value <> '' THEN
            IF Moves[MoveRow].Status = Job$TakeOut THEN
               CALLPROC SOA_LogIns (
              Card           = Moves[].Card
            , Job            = Moves[].Job
            , SwitchingItem  = Moves[].SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'GENERIC OP'
            , Old            = 'ShutOff Operator'
            , New            = GenOpName.Value
            );
            ELSE
               CALLPROC SOA_LogIns (
              Card           = Moves[].Card
            , Job            = Moves[].Job
            , SwitchingItem  = Moves[].SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'GENERIC OP'
            , Old            = 'TurnOn Operator'
            , New            = GenOpName.Value
            );
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
/*
**   Change confirm box color to allow/remind user to confirm move 
**   Moves issued to FCR/Substation/FOD don't need to be confirmed. 
*/
         IF Selected.Object <> Operator$FCR AND 
            Selected.Object <> Operator$OpOrder AND
            WirelessCrew = FALSE THEN
            Field(Moves[MoveRow].Confirm).BGColor = CC_PALE_CYAN;
         ENDIF;
         Field(Moves[MoveRow].TOMove).ISReverse = FALSE;
         IF AllSteamStreet = TRUE THEN
            FIELD(Skip_Btn).CurBias = FB_DIMMED;
            FIELD(Issue_Btn).CurBias = FB_DIMMED;
            FIELD(anyorder_toggle).CurBias = FB_DIMMED; 
         ENDIF;
         IF AllSteamStreetEligible = TRUE THEN
            FIELD(anyorder_toggle).CurBias = FB_DIMMED;
         ENDIF;
/*
**   Issue the phase check if necessary
*/
         IF CurrentApplication = Application$FMS THEN
          IF FIELD(JD.PhaseCheck).CurBias = FB_VISIBLE THEN
            FIELD(Moves[MoveRow].Confirm).BgColor = CC_RED;   
    
            RetCode = CALLPROC FMS_IssuePhaseCheck (
                      Card = CardDetails.Card,
                      SatisfyEquip = Moves[MoveRow].Equip,
                      IssueTime = date('now'));
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
            ELSE
               CALLPROC DDB_COMMIT;  
            ENDIF;
          ELSEIF PhaseCheckRqd <> 0 THEN
/*
**  If this move required a phase check, but the feeder is not out of 
**  service, we need to look and see if this was the last move on the 
**  card that satified the phase check requirment.  If it was, we need 
**  to insert a new move.
**  Get the WorkPermit that the phase check is assigned to.  We want to make 
**  sure that this permit still has a phase check move assigned to it.
*/        
            PhaseCheckWP = 0;
            REPEATED 
            SELECT :PhaseCheckWP = P.WorkPermit,
                   :PC.Equip = P.PhaseCheckEquip,
                   :PC.EquipName = O.Name,
                   :PC.EquipClass = O.Type,
                   :PC.EquipClassName = O.TypeName,
                   :PC.PrintID = G.Reference  
            FROM    FMS_PhaseCheck P,
                    Udb_Object O,
                    Udb_Grouping G,
                    SOA_ActiveObject AO
            WHERE   P.SatisfyEquip = :Moves[MoveRow].Equip AND
                    P.Card = :CardDetails.Card AND
                    P.PhaseCheckEquip = O.Object AND
                    P.PhaseCheckEquip = G.Member AND
                    G.Relationship = :Interaction$MemberOf AND
                    G.Grouping = AO.Object AND
                    AO.Card = :CardDetails.Card;
            IF PhaseCheckWP <> 0 THEN
               OutstandingPhaseCheck = 0;
               REPEATED 
               SELECT :OutstandingPhaseCheck = COUNT(*) 
               FROM    FMS_PhaseCheck P,
                       SOA_Job J,
                       SOA_JobControl JC
               WHERE   JC.Card = :CardDetails.Card AND
                       JC.StepPair IN (:StepHeading$Deload,:StepHeading$Iso) AND
                       JC.Job = J.Job AND
                       J.Status = '' AND
                       J.RSComplete IS NULL AND
                       J.Job <> :Moves[MoveRow].Job AND  /* ignore current job */
                       J.Equip = P.SatisfyEquip AND
                       P.WorkPermit = :PhaseCheckWP AND
                       P.Card = :CardDetails.Card;  

               IF OutstandingPhaseCheck = 0 THEN
                  /* Insert Move */
                  PhaseCheckJob.Card           = CardDetails.Card;
                  PhaseCheckJob.Equip          = PC.Equip;
                  PhaseCheckJob.EquipName      = PC.EquipName;
                  PhaseCheckJob.EquipClass     = PC.EquipClass;  
                  PhaseCheckJob.EquipClassName = PC.EquipClassName;  
                  PhaseCheckJob.PrintID        = PC.PrintID;
                  PhaseCheckJob.Grounds        = NULL;
                  PhaseCheckJob.GroundOn       = NULL;
                  PhaseCheckJob.StepPair       = StepHeading$Deload;
                  PhaseCheckJob.Substation     = Moves[MoveRow].Substation;
                  PhaseCheckJob.DeskName       = Moves[MoveRow].DeskName;
                  PhaseCheckJob.ControlCard    = Moves[MoveRow].ControlCard;    
                   
                  RetCode = PhaseCheckJob.InsertMove (
                              CardTypeOfCard = CardDetails.TypeOfCard);                 

                  IF (RetCode < 0 ) THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 'Unable to insert Phase Check Move into Card.',
                              TraceMessage = 'Frame:PerformMoves;Unable to insert Phase Check Move into Card.');
                  ELSE
                     CALLPROC DDB_COMMIT; 
                     FCFrame.SendUserEvent (EventName = 'LoadPhaseCheckMoves');
                  ENDIF;  
               ENDIF;                   
            ENDIF;
          ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;
   
   RetCode = Moves[MoveRow].JobActions(IssueCompl = JobClass$Issue);

   IF RetCode = PU_CANCEL AND ProcessAutoMode = FALSE THEN

      RetCode = SimpleJob.CancelIssueMove(Job = Moves[MoveRow]);

      IF RetCode = PU_CANCEL THEN
         Message 'Please update move manually';
      ENDIF;

      CurFrame.SendUserEvent (EventName = 'SkipAllMoves');
      RESUME NEXT;
   ENDIF;
/*
**  If Issuing WorkPermit from SLC on a BusSect equipment type.  Check to see if 
**  OTWS should be inserted on FMS cards.
*/
   IF CurrentApplication = Application$SLC AND
      Moves[MoveRow].StepPair = StepHeading$WorkPermit AND
      Moves[MoveRow].EquipClass = TypeName$BusSect THEN
      CALLPROC IssueBusSectWP(Card = Moves[MoveRow].Card,
                              SwitchingItem = Moves[MoveRow].SwitchingItem);
   ENDIF;
/*
**  Set PendingOpStep values so we can set pending operating steps if needed.
*/
   PendingOpStep.Job  = Moves[MoveRow].Job;
   IF Moves[MoveRow].Status = Job$TakeOut THEN
      PendingOpStep.TORS = Job$TakeOutInt;
   ELSEIF Moves[MoveRow].Status = Job$Restore THEN
      PendingOpStep.TORS = Job$RestoreInt;
   ENDIF;
/*
**  Get CardClass information for SOA_Activity insert.
*/
   IF CardClass = 0 THEN
      IF Moves[MoveRow].SwitchingItem IS NULL OR
         Moves[MoveRow].SwitchingItem = 0 THEN
         SELECT :CardClass = CardClass
         FROM    SOA_Card
         WHERE   Card = :Moves[MoveRow].Card;
      ELSE
         SELECT :CardClass = CardClass
         FROM    SLC_InformationItem
         WHERE   Job = :Moves[MoveRow].SwitchingItem;
      ENDIF;
   ENDIF;
/*
**  Find Division for job.
*/
   Division = 0;
   IF Moves[MoveRow].Substation <> 0 THEN
      SELECT :Division = G.Grouping 
      FROM   Udb_Grouping G
      WHERE  G.Member = :Moves[MoveRow].Substation AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division;

   ELSEIF CurrentApplication = Application$TFMS AND 
          Moves[MoveRow].Substation = 0 AND
          Moves[MoveRow].Equip <> 0 THEN

      REPEATED
      SELECT :Division = GG.Grouping 
      FROM   Udb_Grouping G,
             Udb_Grouping GG
      WHERE  G.Member = :Moves[MoveRow].Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Line AND
             G.Grouping = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.GroupingType = :Type$Division;

   ELSEIF CurrentApplication = Application$FMS THEN
      REPEATED
      SELECT :Division = GG.Grouping 
      FROM   Udb_Grouping G,
             Udb_Grouping GG
      WHERE  G.Member = :CardDetails.Object[1].Object AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Substation AND
             G.Grouping = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.GroupingType = :Type$Division;

      IF Division = 0 THEN
         SELECT :Division = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :CardDetails.Object[1].Object AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Division;
      ENDIF;

   ELSEIF CurrentApplication <> Application$SDS AND
          Moves[MoveRow].Equip <> 0 THEN
          CALLPROC TraceError (UserMessage = 'Warning::(PerformMoves) Equipment ' + 
                      Moves[MoveRow].EquipClassName + ' ' + Moves[MoveRow].Equipname + 
                      ' does not appear to be set up correctly in the database.  Please notify ' +
                      'technical support of this problem.',
              TraceMessage = 'Frame:PerformMoves;Equipment ' + Moves[MoveRow].EquipClassName + ' ' + 
                      Moves[MoveRow].Equipname + 
                      ' does not appear to be set up correctly in the database.');
   ENDIF;

   IF CardClass <> Type$CardClassTest AND Division <> 0 THEN   
      IF Uppercase(dow(date('now'))) = 'SAT' OR 
         Uppercase(dow(date('now'))) = 'SUN' THEN
         TypeOfDay = 1;
      ELSE
         TypeOfDay = 2;
      ENDIF;
 
      IF date_part('hour',date('now')) < 8 THEN
         ShiftTime = 1;
      ELSEIF date_part('hour',date('now')) >= 8 AND
             date_part('hour',date('now')) < 16 THEN
         ShiftTime = 2;
      ELSE
         ShiftTime = 3;
      ENDIF;
      
      IsWorkPermit = FALSE;
      IF Moves[MoveRow].StepPair = StepHeading$TestPermit OR
            Moves[MoveRow].StepPair = StepHeading$WorkPermit THEN
         IsWorkPermit = TRUE;
      ENDIF;
          
      CALLPROC SOA_ActivityIns(
                   Application = CurrentApplication,
                   Division = Division,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   ShiftTime = ShiftTime,
                   TypeOfDay = TypeOfDay,
                   IssueComplete = 1,
                   WorkPermit = IsWorkPermit,
                   ShiftID = DOp.ShiftID);
      CALLPROC DDB_COMMIT;
      
   ENDIF;

   IF Moves[MoveRow].StepPair = StepHeading$TestPermit OR
      Moves[MoveRow].StepPair = StepHeading$WorkPermit THEN
/*
** Check if this is an ISWP, must set the status for it
*/
      InServicePermit = 0;
      SELECT :InServicePermit = ISPermit
      FROM   SOA_InServicePermit
      WHERE  Application = :Application$SLC AND
             Job = :Moves[MoveRow].Job; 

      IF InServicePermit <> 0 THEN
         ISP = InServicePermitClass.Create();

         ISP.ISPermit = InServicePermit;
         ISP.LastUpdateBy = DOp.Object;
         ISP.SODenyReason = 'Manually Issued';

         ISP.IssuePermit(IssuedBy = 'REGULAR');
         IF ISP.ReturnCode < 0 THEN
            MESSAGE ISP.ErrorMessage;
         ENDIF;
      ENDIF;
/*
**  For Work and test permits take-out moves, Prompt for ETC
*/
      IF CurrentApplication <> Application$DSO THEN
         CALLFRAME PromptEnterETR(JIP = Moves[MoveRow],
			       Operator= Selected.Object);
      ENDIF;
/*
**  If a workpermit has already been completed and the ActTimeComplete 
**  is set, we clear that time now so that the new EsttimeComplete can 
**  be updated. 
*/
      IF CurrentApplication = Application$FMS AND ProcessAutoMode = FALSE THEN
         IF CardDetails.ActTimeComplete <> '' THEN
            CALLPROC FMS_EstTimeCompleteUpd (
                    Card = CardDetails.Card,
                    EstTimeComplete = '');
                      
            CALLPROC FMS_CardGenericUpd
                   (FieldName = 'acttimecomplete',
                    NewValue  = '',
                    MatchCard = CardDetails.Card);
            CALLPROC DDB_COMMIT;
         ENDIF;

         CALLPROC FMS_CardGenericUpd
              (FieldName = 'workpermitflag',     
               NewValue = '1',
               MatchCard = CardDetails.Card);
         
         CALLPROC DDB_COMMIT;
/*
**   Remove any BT statuses
**   related to this Jobclass and equip
*/
         FOR i = 1 TO CardDetails.Object.LastRow() DO
            RetCode = CALLPROC FMS_FromWorkStatusDel
               (JobClass = Moves[MoveRow].JobClass,
                Equip = Moves[MoveRow].Equip,
                Job = 0,
                Status = Status$BT,
                Feeder = CardDetails.Object[i].Object);

            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 'Unable to clear BT feeder status.  ' +
                    'Feeder Status List may be incorrect.',
                                 TraceMessage = 'Frame:PerformMoves;Unable to clear BT feeder status.  ' +
                    'Feeder Status List may be incorrect.');
               ENDLOOP;
            ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
**  Set workpermitflag is this is a workpermit
*/
   IF Moves[MoveRow].StepPair = StepHeading$WorkPermit AND
        ProcessAutoMode = FALSE THEN
      IF SimpleCard IS NULL THEN
         SimpleCard = CardSOA.Create();
         /*
         ** Should only have to do this once since all moves were
         ** selected from one card.
         */
         SimpleCard = SimpleCard.LoadCard(Card = Moves[MoveRow].Card);
         SimpleCard.WorkPermitFlag = TRUE;

         RetCode = SimpleCard.UpdateCard();
         IF RetCode = PU_CANCEL THEN
            SimpleCard = NULL;
            message 'Workpermit flag not updated for card: ' + 
                     varchar(Moves[MoveRow].Card);
         ENDIF;

      ENDIF;
   ENDIF;
/*
**  If auto-complete, complete the job.
*/
   IF (Moves[MoveRow].Status = Job$TakeOut AND  Moves[MoveRow].TOMoveRules = MoveRule$IAuto) OR
         (Moves[MoveRow].Status = Job$Restore AND Moves[MoveRow].RSMoveRules = MoveRule$IAuto) THEN

      RetCode = SimpleJob.CompleteMove(Job = Moves[MoveRow]);
      IF RetCode = PU_CANCEL THEN
         Message 'Please manually complete the move.';
      ENDIF;
              
      RetCode = Moves[MoveRow].JobActions(IssueCompl = JobClass$Complete);
      IF RetCode = PU_CANCEL THEN
         
         RetCode = SimpleJob.InCompleteMove(Job = Moves[MoveRow]);
          
         IF RetCode = PU_CANCEL THEN
            Message 'Please update move manually';
         ENDIF;

         CurFrame.SendUserEvent (EventName = 'SkipAllMoves');
         RESUME NEXT;
      ENDIF;
      /*
      **  IF this move was issued to FOD Notify operator then we will
      **  send a message to the FOD.
      */  
      IF Selected.Object = Operator$FODNotify THEN 
         /*
         **  Determine which regions to send message.
         */
         FODRegion = '';

         /* shift 1 char to get rid of d in division user. */
         SELECT DISTINCT
               :FODRegion = shift(O.Name,-1)
         FROM  Udb_Object O,
               Udb_Grouping G,
               Udb_Grouping GG
         WHERE G.Member = :CardDetails.Object[1].Object AND
               G.RelationShip = :Interaction$MemberOf AND
               G.GroupingType = :Type$Division AND
               G.Grouping = GG.Member AND
               GG.RelationShip = :Interaction$MemberOf AND
               GG.GroupingType = :Type$Region AND
               GG.Grouping = O.Object
         BEGIN
            RetCode = CALLPROC CSD_MessageIns(DeskType = 'fod_' + FODRegion
                                             ,MessageText = dop.Description + ' has issued ''' + 
                                                 Moves[MoveRow].TOMove + 
                                                 ''' on feeder ' + CardDetails.FeederName
                                             ,MessageType = 0
                                             ,Card = CardDetails.Card
                                             ,Priority = 0  /* High Priority */ 
                                             ,Time = date('now'));
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 'Popup notification message was not sent to ' +
                     Selected.Description,
                                    TraceMessage = 'Frame:PerformMoves;Unable to sent notification ' +
                     'message for user ' + Selected.Description + ' on card ' + VARCHAR(CardDetails.Card));
            ENDIF;
            CALLPROC DDB_COMMIT;
         END;    
      ENDIF;
   ELSEIF ProcessAutoMode = FALSE THEN
/*
**  No Special MoveRules - Set the pending statuses for this operator
*/
      Moves[MoveRow].SetPendingActions();
   ENDIF;
/*
**  If this is the lastrow grey out exit button.
**  Enable Download button also if necessary.
*/
   IF Selected.Object <> Operator$FCR AND ProcessAutoMode = FALSE THEN
      FIELD(Abort_btn).CurBias = FB_LANDABLE;
   ENDIF;
/*
** Set Process Auto SetUp Mode Color for issued move.
*/
   IF ProcessAutoMode = TRUE THEN
      IF Moves[MoveRow].Status = Job$TakeOut THEN
         FIELD(Moves[MoveRow].TOIssued).BgColor = CC_LIGHT_BROWN;
      ELSE
         FIELD(Moves[MoveRow].RSIssued).BgColor = CC_LIGHT_BROWN;
      ENDIF;
   ENDIF;
/* 
** Check if move issued a DSO Full Readings move, if so load detail moves.
*/
   IF CurrentApplication = Application$DSO AND 
             Moves[MoveRow].JobClass = JobClass$FullReadings THEN
/*
** Reselect the Heading move substation since it likely has been translated
** to the Electric substation for order download.
*/    
      SELECT :JobSubstation = Substation 
      FROM   SOA_Job
      WHERE  Job = :Moves[MoveRow].Job;
      
      k = 1;
      m = MoveRow;
      IssuedMoves.Clear();
      REPEATED
      SELECT  :IssuedMoves[k].Card = JC.Card,
           :IssuedMoves[k].Job = J.Job,
           :IssuedMoves[k].Equip = J.Equip,
           :IssuedMoves[k].EquipClass = J.EquipClass,
           :IssuedMoves[k].EquipClassName = J.EquipClassName,
           :IssuedMoves[k].EquipName = J.EquipName,
           :IssuedMoves[k].JobClass = J.JobClass,
           :IssuedMoves[k].MoveEquipClass = JC.MoveEquipClass,
           :IssuedMoves[k].MoveType = J.MoveType,
           :IssuedMoves[k].Response = J.Response,
           :IssuedMoves[k].RSComplete = J.RSComplete,
           :IssuedMoves[k].RSIssued = J.RSIssued,
           :IssuedMoves[k].RSMove = J.RSMove,
           :IssuedMoves[k].RSMoveRules = J.RSMoveRules,
           :IssuedMoves[k].RSOperator = J.RSOperator,
           :IssuedMoves[k].Seq = JC.Seq,
           :IssuedMoves[k].Status = J.Status,
           :IssuedMoves[k].StepPair = JC.StepPair,
           :IssuedMoves[k].Substation = J.Substation,
           :IssuedMoves[k].SwitchingItem = JC.SwitchingItem,
           :IssuedMoves[k].TOComplete = J.TOComplete,
           :IssuedMoves[k].TOIssued = J.TOIssued,
           :IssuedMoves[k].TOMove = J.TOMove,
           :IssuedMoves[k].TOMoveRules = J.TOMoveRules,
           :IssuedMoves[k].TOOperator = J.TOOperator
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :Moves[MoveRow].Card AND
             JC.Job = J.Job AND
             JC.Seq > :Moves[MoveRow].Seq AND
             J.Status = '' AND
             JC.StepPair = :StepHeading$Readings AND
             J.Substation = :JobSubstation AND
             J.TOIssued = :Moves[MoveRow].TOIssued AND
             J.TOComplete IS NULL
      ORDER BY Seq
      BEGIN
              IssuedMoves[k].Status = Job$TakeOut;
              IssuedMoves[k].Substation = Moves[MoveRow].Substation; /*Electric Station*/
              k = k + 1;
      END; 

      FOR k = 1 TO IssuedMoves.LastRow DO
         m = m + 1;
         Moves.InsertRow (RowNumber=m, RowObject=IssuedMoves[k]);
         IF Selected.Object <> Operator$OpOrder THEN
            Field(Moves[m].Confirm).BGColor = CC_PALE_CYAN;
         ENDIF;
      ENDFOR;                    
      MoveRow = m;
   ENDIF;        

   IF AllSteamStreet = TRUE THEN
      StreetMove = 0;
   ELSEIF MoveRow = Moves.LastRow() THEN
      FIELD(Issue_Btn).CurBias = FB_Dimmed;
      FIELD(Skip_Btn).CurBias = FB_Dimmed;
      IF Selected.Object = Operator$OpOrder OR 
         WirelessCrew = TRUE THEN
            CurFrame.SendUserEvent (EventName = 'EnableDownload');
      ENDIF;
/*
**  If operator FCR we can exit now...
*/
      IF Selected.Object = Operator$FCR THEN
         RETURN(PU_OK);
      ENDIF;
/*
**  Request Customer Crew, exit now 
*/
     IF UPPERCASE(Moves[MoveRow].TOMove) LIKE '%REQUEST CUSTOMER CREW' THEN
        RETURN(PU_OK);
     ENDIF;
   ELSE
      CurFrame.SendUserEvent (EventName = 'HighlightMove');
   ENDIF;
END;

ON UserEvent 'SkipMove',
ON CLICK Skip_btn =
BEGIN
   IF MoveRow = 0 THEN
      RESUME;
   ENDIF;
/*
**  Don't allow to change selected operator again, try to avoid flickering
*/
   IF STACKFIELD(FIELD(Selected).ParentField.ParentField).CurBias <> FB_Visible THEN
      STACKFIELD(FIELD(Selected).ParentField.ParentField).CurBias = FB_Visible;
   ENDIF;
/*
** Set IsReverse = False here BGColor will turn gray 
*/
   Field(Moves[MoveRow].TOMove).ISReverse = FALSE;

   Field(Moves[MoveRow].TOIssued).BGColor  = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].SubstationName).BGColor  = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].PrintID).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].EquipClassName).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].EquipName).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].TOMove).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].Response).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].LockNumber).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].Combination).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].RSIssued).BGColor = CC_LIGHT_GRAY;
   Field(Moves[MoveRow].Confirm).BGColor = CC_LIGHT_GRAY;
/*
** Remove This row from the PerformMovesArray
*/
   p = PerformMovesArray.LastRow();
   WHILE p >= 1 DO
      IF PerformMovesArray[p].JobClass = Moves[MoveRow].JobClass AND
           PerformMovesArray[p].Equip = Moves[MoveRow].Equip AND
           PerformMovesArray[p].TORS = Moves[MoveRow].TORS THEN
         PerformMovesArray.RemoveRow (rownumber = p);
      ENDIF;
      p = p - 1;
   ENDWHILE;
/*
**  If this is the lastrow,  grey out issue and skip button
**  Enable Download button also if necessary.
*/
   IF MoveRow = Moves.LastRow() THEN
      FIELD(Issue_Btn).CurBias = FB_Dimmed;
      FIELD(Skip_Btn).CurBias = FB_Dimmed;
      IF Selected.Object = Operator$OpOrder OR 
         WirelessCrew = TRUE THEN
/*
** Enable Download OR if reviewing Warning, then Check CSD and AutoReturn
*/
         IF Block <> 0 THEN
            CurFrame.SendUserEvent (EventName = 'CheckCSD');
         ELSE          
            CurFrame.SendUserEvent (EventName = 'EnableDownload');
         ENDIF;
      ENDIF;
   ELSE
      IF AllSteamStreet = FALSE THEN
         CurFrame.SendUserEvent (EventName = 'HighlightMove');
      ENDIF;
   ENDIF;
END;

ON USEREVENT 'EnableDownload' = 
BEGIN
   IF ForceAbort33kV = TRUE THEN
      MESSAGE 'You must ABORT and reissue ground move to equipment other than a 33kV interrupter switch.';
      RESUME;
   ENDIF; 
/*
**  Scroll through move list to make sure moves were issued, as opposed
**  to skipped.  If any have been issued, then we enable the Download button.
*/
   FOR i = 1 TO Moves.LastRow() DO
      IF FIELD(Moves[i].ToMove).BGColor <> CC_LIGHT_GRAY THEN
/*
**  Check if Two Op Review is required    
**  If so, save issued moves and initiate two op review
*/
        FIELD(DownLoad_btn).CurBias = FB_LANDABLE;
        IF EnhancedTwoOpReview = TRUE THEN
           RetCode = CALLPROC TwoOpReview(Card = Moves[i].Card,
                                       SwitchingItem = Moves[i].SwitchingItem,
                                       Job = Moves[i].Job);
           IF RetCode = PU_CANCEL THEN
              CurFrame.SendUserEvent (EventName = 'AbortIssuedMoves');
              ENDLOOP;
           ELSE 
              CurFrame.SendUserEvent (EventName =  'InitiateDownload');
              ENDLOOP;
           ENDIF;
         ENDIF;
         IF ProcessAutoMode = TRUE THEN
            FIELD(Cancel_btn).CurBias = FB_LANDABLE;
         ENDIF; 
         ENDLOOP;
      ENDIF;
   ENDFOR;
END; 

ON CLICK DownLoad_btn,
ON USEREVENT 'InitiateDownload' =
BEGIN
/*
**  Build a list of moves that have been issued, ignoring skipped ones.
**  Send this list to the Generate Operating Order function.
**  Check if the Issued Move was created as part of a scenario.
*/
   IssuedMoves.Clear();
   k = 1;
   DynamicWhereClause = '(';
   FOR i = 1 TO Moves.LastRow() DO
      IF FIELD(Moves[i].ToMove).BGColor <> CC_LIGHT_GRAY THEN
         IssuedMoves.InsertRow (RowNumber = k);
         IssuedMoves[k] = Moves[i].Duplicate();

         IF k > 1 THEN
            DynamicWhereClause = DynamicWhereClause + 
                                 ',' + VARCHAR(IssuedMoves[k].Job);
         ELSE         
            DynamicWhereClause = DynamicWhereClause + 
                                 VARCHAR(IssuedMoves[k].Job);
         ENDIF;
         k = k + 1;
      ENDIF;
   ENDFOR;
   DynamicWhereClause = DynamicWhereClause + ')'; 

   IF IssuedMoves.LastRow() = 0 THEN
      MESSAGE 'No moves to be sent to an operating order.';
      RESUME;
   ENDIF;
   
   IF CurrentApplication = Application$FMS THEN
      TempObjective = CardDetails.CardName + ' ' + CardDetails.CardClassName;
   ELSE
/*
** Get purpose/objective for the op order.  Tie the objective to all scenarios
** used to create the issued moves.  If no scenarios, use the switching item
** title or the tfms line list to initialize the field.
*/
      DynamicWhereClause = 'SHJ.Job IN ' + DynamicWhereClause + ' AND ' +
                        'SHJ.Card = SH.Card AND ' +
                        'SHJ.SwitchingItem = SH.SwitchingItem AND ' +
                        'SHJ.Scenario = SH.Scenario AND ' + 
                        'SHJ.ScenarioDate = SH.ScenarioDate'; 

      ScenarioList.Clear();
      i = 1;
      SELECT
      DISTINCT :ScenarioList[i].Scenario = SH.Scenario 
              ,:ScenarioList[i].StartPoint = SH.StartPoint
      FROM   SOA_ScenarioHistory SH,
             SOA_ScenarioHistoryJobs SHJ
      WHERE  :DynamicWhereClause
      BEGIN
         i = i + 1;
      END;
        
      TempObjective = '';
      LastRow = ScenarioList.LastRow();
   
      IF LastRow = 0 THEN  /* No scenarios to use for objective, use defaults */

         IF CurrentApplication = Application$SLC THEN
            SELECT :TempObjective = TOMove
            FROM   SOA_Job
            WHERE  Job = :IssuedMoves[1].SwitchingItem;
         ENDIF;
      ELSE
/*
** Use the scenario list to built appropriate objective text.
*/
         FOR i = 1 TO LastRow DO
            SELECT :ScenarioName = Name 
            FROM   Udb_Type 
            WHERE  Type = :ScenarioList[i].Scenario;

            SELECT :ScenarioObject = TypeName + '  ' + Name
            FROM   Udb_Object
            WHERE  Object = :ScenarioList[i].StartPoint;

            IF i > 1 THEN
               TempObjective = TempObjective + ', and ' + 
                            ScenarioName + ' on ' + ScenarioObject;
            ELSE
               TempObjective = ScenarioName + ' on ' + ScenarioObject;
            ENDIF;
         ENDFOR;          

      ENDIF;
   ENDIF;

   IF Block = 0 THEN   
      IF WirelessCrew = TRUE THEN
         RetCode = CALLFRAME GenerateFODOrder (
             IssuedMoves = IssuedMoves,
             Card = CardDetails,
             FODEmployee = Selected.Object,
             FODName = Selected.Description);   
      ELSE
         IF CurrentApplication = Application$DSO THEN
           RetCode = CALLFRAME GenerateOperatingOrderDSO (
             IssuedMoves = IssuedMoves,
             Substation = OpOrderSubstation,
             SubstationName = OpOrderSubstationName);        
         ELSE
           RetCode = CALLFRAME GenerateOperatingOrder (
             IssuedMoves = IssuedMoves,
             Substation = OpOrderSubstation,
             SubstationName = OpOrderSubstationName,
             Objective = TempObjective);
         ENDIF;    
      ENDIF;

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Moves could not be downloaded to an Operating Order.  ' +
                 'You will need to abort the order or try to resend it.';
         RESUME;
      ENDIF;
   ENDIF;
/*
**  See if we need to send a DCC popup for moves issued.  
*/
   IF CurrentApplication = Application$FMS AND 
      CardDetails.TypeOfCard = Type$13kVCard AND
      ProcessAutoMode = FALSE THEN
       CurFrame.SendUserEvent (EventName = 'CheckCSD');
   ELSE
      CALLPROC ResetTwoOpGlobalVariables();
      DOp.CheckActivity(Move = Moves[1].Duplicate());

      RETURN PU_OK;
   ENDIF; 
END;

/*
**  Make sure all issued moves are confirmed.
*/
ON CLICK Menu.File.Close_btn,
ON CLICK Cancel_Btn =
BEGIN
   IF ForceAbort33kV = TRUE THEN
      MESSAGE 'You must ABORT and reissue ground move to equipment other than a 33kV interrupter switch.';
      RESUME;
   ENDIF; 
/*
** Make sure all issued moves are confirmed and that the DownLoad Button
** is not enabled.
*/
   i = 1;
   WHILE i <= Moves.LastRow() DO
    /*  Check to see if all issued moves have been confirmed */
      IF Field(Moves[i].Confirm).BGColor = CC_PALE_CYAN OR 
         (Field(Moves[i].Confirm).BGColor = CC_RED AND
          Moves[i].Confirm = 0) THEN
         MESSAGE 'You must Check Off all of your issued moves ' +
                 'before continuing.';
         RESUME;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   IF FIELD(DownLoad_btn).CurBias = FB_LANDABLE AND ProcessAutoMode = FALSE THEN
      MESSAGE 'The issued moves are part of an order and must either be ' +
              'Downloaded or Aborted.';   
      RESUME; 
   ELSE
      CALLPROC ResetTwoOpGlobalVariables();

      DOp.CheckActivity(Move = Moves[1].Duplicate());

      RETURN PU_OK;
   ENDIF;
END;


ON UserEvent 'CheckCSD' =
BEGIN
/*
**  Reselect non-static fields from database since values may have changed since last
**  loading of card.
*/
   SELECT :CardDetails.GroundsOn = GroundsOn,
          :CardDetails.CutOut = CutOut,
          :CardDetails.CutIn = CutIn
   FROM   FMS_Card
   WHERE  Card = :CardDetails.Card;

   i = 1;
   G_Count = 0;
   G_Total = 0;
   WHILE i <= Moves.LastRow() DO

      IF FIELD(Moves[i].Confirm).BGColor <> CC_LIGHT_GRAY THEN /* move hasn't been skipped */
/*
** DCC Message
*/
         CALLPROC DCCChecksForMoveIssue (Move = Moves[i],
                          FeederName = CardDetails.FeederName,
                          Feeder = CardDetails.Object[1].Object,
                          Card = CardDetails.Card);
/*
**  On restore issue, we will check and see if any moves are removing grounds.  
**  we will send a message to CSD monitor. Ignore Station Ground using Card Position field 
*/
         IF Moves[i].Status = Job$Restore AND
             Moves[i].EquipName <> CardDetails.Position THEN 

            SELECT :G_Count = COUNT(*) 
            FROM    FMS_JobAction JA 
            WHERE   JA.JobClass = :Moves[i].JobClass AND
                    JA.EquipClass = :Moves[i].MoveEquipClass AND
                    JA.StepPair = :Moves[i].StepPair AND
                    JA.TypeofCard = :Type$13kVCard AND
                    JA.FeederEquip = 2 AND  /* Equip */
                    JA.TORS = :Job$RestoreInt AND
                    JA.IssueCompl = :JobClass$Complete AND
                   (JA.Action = :JobAction$Clear OR
                    JA.Action = :JobAction$Decrement) AND
                    JA.Status = :Status$Ground;
            G_Total = G_Total + G_Count;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**  C.GroundsOn should be total number of Grounds on feeder(including Station Ground).
**  If the number of Grounds being taken off are equal to all Field grounds on the feeder
**  then send message to CSD.  We have <= 1 in case ground count is not correct.  
*/
   IF CardDetails.GroundsOn - G_Total <= 1 AND 
      G_Total > 0 AND
      CardDetails.Cutout IS NOT NULL AND
      CardDetails.Cutin IS NULL  THEN
/*
**  Send message to CSD 
*/            
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                       ,MessageText = 'Feeder ' + CardDetails.FeederName + 
                           ' has last ' + varchar(G_Total) + ' Field Ground(s) ordered ' +
                           'off - Verify SSO preparing for Ammeter Clear and attach leads'
                       ,Time = date('now')
                       ,Priority = 0
                       ,MessageType = 0
                       ,Card = CardDetails.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Could not send automated message to CSD. You may ' +
                 'want to tell him to prepare for Ammeter Clear Test.',
                              TraceMessage = 'Frame:PerformMoves;Could not send automated message ' +
                 'to CSD. You may want to tell him to prepare for Ammeter Clear Test.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;     

   IF Block <> 0 THEN
      AutoReturn = 2;
   ENDIF;
   CALLPROC ResetTwoOpGlobalVariables();

   DOp.CheckActivity(Move = Moves[1].Duplicate());

   RETURN PU_OK;
END;


/*
**  Handle confirm button click.
*/
ON ChildClick Moves[*].Confirm =
BEGIN
   IF ForceAbort33kV = TRUE THEN
      MESSAGE 'You must ABORT and reissue ground move to equipment other than a 33kV interrupter switch.';
      RESUME;
   ENDIF; 
/*
**  Prevent from toggling to false when already toggled to TRUE
*/
   IF Moves[].Confirm = FALSE THEN 
      Moves[].Confirm = TRUE;
      RESUME;
   ENDIF;

   IF Selected.Object = Operator$OpOrder  OR 
       WirelessCrew = TRUE THEN
      MESSAGE 'Moves that are being issued to the Operating Order must be ' +
              'DownLoaded and should not be confirmed.';
      Moves[].Confirm = FALSE;
      RESUME;
   ENDIF;
/*
**  IF move has not been issued don't allow to toggle to TRUE
*/
   IF Field(Moves[].Confirm).BGColor <> CC_PALE_CYAN AND 
       Field(Moves[].Confirm).BGColor <> CC_RED     THEN 
      Moves[].Confirm = FALSE;
      RESUME;
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (
              Card           = Moves[].Card
            , Job            = Moves[].Job
            , SwitchingItem  = Moves[].SwitchingItem
            , Time           = DATE('now')
            , UserName       = UserName
            , Item           = 'Confirm Issue'
            , New            = 'Confirmed'
            );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 'Unable to Log confirmation.  Please contact technical support.' + 
                           HC_NEWLINE +
                          'Card: ' + HC_TAB + varchar(Moves[].Card) + HC_NEWLINE + 
                          'Job: '  + HC_TAB + varchar(Moves[].Job) + HC_NEWLINE +
                          'Item: ' + HC_TAB + 'Confirm Issue' + HC_NEWLINE + 
                          'Old: '  + HC_TAB + 'Confirmed' + HC_NEWLINE + 
                          'New: '  + HC_TAB + 'UnConfirmed',
               TraceMessage = 'Frame:PerformMoves;Unable to Log confirmation. ' +
                          'Card: ' + varchar(Moves[].Card) + ' Job: ' + varchar(Moves[].Job) + 
                          'Item: ' + ' Confirm Issue Old: Confirmed New: UnConfirmed');
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
** If this is a job at substation AK2/AK3, save the holdoff number in the response column
** which is set in OperatorChecks
*/
   IF CurrentApplication = Application$TFMS AND 
      Moves[].Status = Job$TakeOut AND Moves[].Response <> '' AND
      (Moves[].Substation = 144060 OR Moves[].Substation = 144231) THEN
      Moves[].ResponseUpd();
   ENDIF;         
   
   IF Field(Moves[].Confirm).BGColor <> CC_RED THEN
      Field(Moves[].Confirm).BGColor = CC_PALE_BLUE;
   ENDIF;
/*
** check to update SWP outage report's actual work permit issue time
*/
   IF Moves[].StepPair = StepHeading$TestPermit OR
      Moves[].StepPair = StepHeading$WorkPermit THEN
      IF SingleSWP IS NULL THEN
         SingleSWP = OutageReport.Create();
      ENDIF;
      SingleSWP.SetActualWorkIssueDate(JIP = Moves[]);
      SingleSWP.SetActualStartDate(JIP = Moves[]);
   ENDIF;
/*
**  If this is the last confirmation, exit from the frame
*/
   i = 1;
   GetOut = TRUE;
   WHILE i <= Moves.LastRow() DO
      IF FIELD(Moves[i].Confirm).BGColor <> CC_LIGHT_GRAY THEN 
         /* move hasn't been skipped */
         IF Moves[i].Confirm = FALSE THEN
            GetOut = FALSE;
            ENDLOOP;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
** Don't get out if DownLoad button is highlighted.  Ask user if they intend
** to download.
*/
   IF GetOut = TRUE THEN
      IF CurrentApplication = Application$FMS AND
           CardDetails.TypeOfCard = Type$13kvCard AND
           ProcessAutoMode = FALSE THEN
         CurFrame.SendUserEvent (EventName = 'CheckCSD');

      ELSEIF (CurrentApplication = Application$TFMS OR 
              CurrentApplication = Application$SLC) AND 
             FO.Object = Operator$XA21 THEN
/*
** Initiate XA21 Display Call control screen
*/
         CallXA21Moves = Moves.Duplicate(); 
         CALLPROC ResetTwoOpGlobalVariables();
   
         DOp.CheckActivity(Move = Moves[1].Duplicate());
         
         RETURN PU_OK;
      ELSE
         CALLPROC ResetTwoOpGlobalVariables();
         DOp.CheckActivity(Move = Moves[1].Duplicate());
         RETURN PU_OK;
      ENDIF;
   ENDIF;

END;


ON USEREVENT 'AbortIssuedMoves',
ON CLICK Abort_btn = 
BEGIN
/*
** Incomplete all issued moves that have not been confirmed.
*/
   AbortMoves.Clear();
   FOR i = 1 TO Moves.LastRow() DO
      IF Moves[i].Status = Job$TakeOut THEN
         IF (Moves[i].TOIssued IS NOT NULL AND Moves[i].TOIssued <> '') AND
            (Moves[i].TOComplete IS NULL OR Moves[i].TOComplete = '') THEN 
             /* can abort */
         ELSE
             Field(Moves[i].Confirm).BGColor = CC_LIGHT_GRAY;
         ENDIF;
      ENDIF;
      IF Moves[i].Status = Job$Restore THEN
         IF (Moves[i].RSIssued IS NOT NULL AND Moves[i].RSIssued <> '') AND
            (Moves[i].RSComplete IS NULL OR Moves[i].RSComplete = '') THEN 
             /* can abort */
         ELSE
             Field(Moves[i].Confirm).BGColor = CC_LIGHT_GRAY;
         ENDIF;
      ENDIF;
      IF  ((Field(Moves[i].Confirm).BGColor = CC_PALE_CYAN OR 
            Field(Moves[i].Confirm).BGColor = CC_RED) OR 
           (Selected.Object = Operator$FCR OR 
           Selected.Object = Operator$OpOrder OR
           WirelessCrew = TRUE))  AND
           Moves[i].Confirm = FALSE AND
           FIELD(Moves[i].TOMove).BGColor = CC_PALE_BLUE THEN
          AbortMoves.InsertRow (RowNumber = 1,RowObject = Moves[i].Duplicate());
      ENDIF;      
   ENDFOR;
/*
** Don't display Abort prompt when in Automation Warning Review.
*/
   LastRow = AbortMoves.LastRow();
   IF LastRow > 0 THEN
         IF Block = 0 AND ByPassAbortPrompt = FALSE THEN
            IF CurFrame.ConfirmPopUp (messagetext = VARCHAR(LastRow) + ' Move(s) ' + 
               'that have been issued but not yet confirmed ' +
               'will be aborted.  Are you sure you want to do this?') = PU_CANCEL THEN
              RESUME;
            ENDIF;
         ENDIF;
         ByPassAbortPrompt = FALSE;
/*
** Incomplete the moves, reverse actions, remove pending statuses, etc.
*/
         i = 1;
         WHILE i <= AbortMoves.LastRow() DO
            RetCode = AbortMoves[i].UndoJobActions(IssueCompl = JobClass$Issue);
      
            IF RetCode = PU_CANCEL THEN
               ENDLOOP;
            ENDIF;

            AbortMoves[i].ClearPendingActions();

            RetCode = SimpleJob.CancelIssueMove(Job = AbortMoves[i]);

            IF RetCode = PU_CANCEL THEN
               ENDLOOP;
            ENDIF;
            i = i + 1;
         ENDWHILE;
/*
** If all abort moves processed, then leave screen.
*/
         IF i > AbortMoves.LastRow() THEN
            AutoReturn = 1;  
            CALLPROC ResetTwoOpGlobalVariables();

            DOp.CheckActivity(Move = Moves[1].Duplicate());

            RETURN PU_OK;
         ENDIF; 

   ELSEIF Block <> 0 THEN
         AutoReturn = 1;
         CALLPROC ResetTwoOpGlobalVariables();
         
         RETURN PU_OK;
   ELSE
         Message 'Nothing to Abort.  Only moves that have been issued and ' +
                 'not yet confirmed can be aborted.';
   ENDIF;
END; 


ON CHILDENTRY Crew.FODCrew_tf =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;   
/*
** Highlight the selected crew.
*/
   i = 0;
   i = FIELD(Crew.FODCrew_tf).CurRow;
   IF i = 0 THEN
      MESSAGE 'No crew selected';
      RESUME;
   ENDIF;

   SELECT :DateNow = DATE('now');

   WirelessCrew = FALSE;

   FOR m = 1 TO Crew.FODCrew_tf.LastRow() DO
      IF i = m THEN
/*
** Check to make sure selected crew is available at the present time.
*/
         IF Crew.FODCrew_tf[m].EmployeeObjectID <> Operator$FOD AND 
            Crew.FODCrew_tf[m].EndTime < DateNow THEN
            MESSAGE 'This crew is no longer available based on the ' +
                    'availability time.';
            RESUME;
         ENDIF;

         IF Crew.FODCrew_tf[m].CommMethod <> 'VERBAL' THEN
            WirelessCrew = TRUE;
         ENDIF;
 
         FIELD(Crew.FODCrew_tf[m].EmployeeNumber).IsReverse = TRUE;
         FIELD(Crew.FODCrew_tf[m].CrewName).IsReverse = TRUE;
         FIELD(Crew.FODCrew_tf[m].ContactInfo).IsReverse = TRUE;
         FIELD(Crew.FODCrew_tf[m].EndTime).IsReverse = TRUE;
         FIELD(Crew.FODCrew_tf[m].CommMethod).IsReverse = TRUE;

         Selected.Object = Crew.FODCrew_tf[m].EmployeeObjectID;
         Selected.Name = Crew.FODCrew_tf[m].EmployeeNumber;
         Selected.Description = Crew.FODCrew_tf[m].CrewName;

         FO.Object = Selected.Object;
         FO.Name = Selected.Name;
         FO.Description = Selected.Description;
      ELSE         
         FIELD(Crew.FODCrew_tf[m].EmployeeNumber).IsReverse = FALSE;
         FIELD(Crew.FODCrew_tf[m].CrewName).IsReverse = FALSE;
         FIELD(Crew.FODCrew_tf[m].ContactInfo).IsReverse = FALSE;
         FIELD(Crew.FODCrew_tf[m].EndTime).IsReverse = FALSE;
         FIELD(Crew.FODCrew_tf[m].CommMethod).IsReverse = FALSE;
      ENDIF;
   ENDFOR;

/*
** display the moves that were rejected by the selected crew and requested
** to be issued to that crew
*/ 
   Crew.FODMoves.Clear();
   IF Selected.Object = Operator$FOD THEN
      RESUME;
   ENDIF;

   IF Crew.FODCrew_tf[i].CommMethod = 'VERBAL' THEN
      DynamicWhereClause = 'FJ.VerbalEmployeeObject = ' +
                           VARCHAR(Selected.Object) + ' AND ';

   ELSEIF Selected.Object = Operator$FOD THEN
      DynamicWhereClause =  'FJ.SendBackType = ''SEND_BACK_TO_DESK'' AND ';

   ELSE
     DynamicWhereClause = 'FJ.SendBackType = ''SEND_BACK_TO_SELF'' AND ' +
            'FJ.FODEmployeeObject = ' + 
            VARCHAR(Selected.Object) + ' AND ';
   ENDIF;
   
   DynamicWhereClause = DynamicWhereClause +
            'FJ.Job = J.Job AND ' + 
            'J.Status <> ''Del'' AND ' +
            '((FJ.TORS = 0 AND J.TOIssued IS NULL) OR (FJ.TORS = 1 AND J.RSIssued IS NULL)) AND ' +
            'J.Job = JC.Job AND ' + 
            'JC.Card = ' + varchar(Moves[1].Card); 
   m = 1;
   SELECT DISTINCT 
       :Crew.FODMoves[m].PrintID = JC.PrintID,
       :Crew.FODMoves[m].EquipClassName = J.EquipClassName,
       :Crew.FODMoves[m].EquipName = J.EquipName,
       :Crew.FODMoves[m].TOMove = J.TOMove,
       :Crew.FODMoves[m].RSMove = J.RSMove,
       :Crew.FODMoves[m].TORS = FJ.TORS
   FROM SOA_Job J,
        SOA_JobControl JC,
        IR_FODOrderJobs FJ
   WHERE :DynamicWhereClause
   BEGIN
      IF Crew.FODMoves[m].TORS = 1 THEN
         Crew.FODMoves[m].TOMove = Crew.FODMoves[m].RSMove;
      ENDIF;
      m = m + 1;   
   END;   
   CALLPROC DDB_ROLLBACK;
END; 


ON CLICK Crew.Ok_btn = 
BEGIN
/*
** A crew must be selected 
*/
   IF Selected.Object = 0 THEN
      MESSAGE 'No Crew has been selected.';
      RESUME;
   ENDIF;

   FIELD(Crew).CurBias = FB_INVISIBLE;
   FIELD(Issue_Btn).CurBias = FB_LANDABLE;
   FIELD(Skip_Btn).CurBias = FB_LANDABLE;
   FIELD(Download_btn).CurBias = FB_DIMMED;
   MoveRow = 0;
   CurFrame.SendUserEvent (EventName = 'HighlightMove');
END;


ON CLICK Crew.Cancel_btn,
ON USEREVENT 'CancelCrew' = 
BEGIN
/*
** No crew was selected 
*/
   Selected.Object = 0;
   Selected.Name = '';
   Selected.Description = '';

   FIELD(Crew).CurBias = FB_INVISIBLE;
   FIELD(Issue_Btn).CurBias = FB_LANDABLE;
   FIELD(Skip_Btn).CurBias = FB_LANDABLE;
   FIELD(Download_btn).CurBias = FB_DIMMED;
END;

/*
**  Handle an operator selection from the list
*/
ON ChildEntry VerbalOperator,
ON ChildEntry ElectronicOperator =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK AND FoundOperator = FALSE THEN
      RESUME;
   ENDIF;

   FoundOperator = FALSE;
   WirelessCrew = FALSE;

   IF lowercase(CurFrame.TriggerField.FullName) like 'verbaloperator%' THEN
      Selected.Object = VerbalOperator[].Object;
      Selected.Name = VerbalOperator[].Name;
      Selected.Description = VerbalOperator[].Description;
      ElectronicOrder = FALSE;
   ELSE
      Selected.Object = ElectronicOperator[].Object;
      Selected.Name = ElectronicOperator[].Name;
      Selected.Description = ElectronicOperator[].Description;
      ElectronicOrder = TRUE;
   ENDIF;
/*
** No auto-complete moves are allowed to be downloaded electronically 
*/
   IF Selected.Object = Operator$OpOrder OR
      Selected.Object = Operator$FOD OR
      Selected.Object = Operator$NO9 OR
      Selected.Object = Operator$FCR THEN
      FOR i = 1 TO Moves.LastRow() DO
         IF (Moves[i].Status = Job$TakeOut AND  Moves[i].TOMoveRules = MoveRule$IAuto) OR
               (Moves[i].Status = Job$Restore AND Moves[i].RSMoveRules = MoveRule$IAuto) THEN

            MESSAGE 'Auto complete moves cannot be issued via Rapid Restore. ' + HC_NEWLINE +
                    '''' + Moves[i].TOMove + ''' is defined as an auto complete move.';
            RESUME;
         ENDIF;
/*
** Evaluate moves to exclude certain moves from being downloaded.
*/
         IF Selected.Object = Operator$OpOrder AND CurrentApplication <> Application$FMS THEN
            /*
            ** determine the move type and prevent move from being issue
            ** if any of these prompts are called.  
            */
            IF Moves[i].Status = Job$Restore THEN
               TORS = 1;
            ELSEIF Moves[i].Status = Job$TakeOut THEN
               TORS = 0;
            ENDIF;

            k = 0;
            SELECT :k = Status
            FROM    FMS_JobAction
            WHERE   JobClass = :Moves[i].JobClass AND
                    EquipClass = :Moves[i].MoveEquipClass AND
                    StepPair = :Moves[i].StepPair AND
                    TypeOfCard = :CardDetails.TypeOfCard AND
                    TORS = :TORS AND
                    IssueCompl = 1 AND                 /* look for prompts at move completion time */
                    Action = :JobAction$Prompt AND
                    Status IN(:Prompt$HighPotDist,:Prompt$ModHighPotDist,
                              :Prompt$AmmeterClearDist);

            IF k <> 0 THEN
               MESSAGE '---VALIDATION MESSAGE---' + HC_NEWLINE +
                       'Move: ''' + Moves[i].TOMove + '''' + HC_NEWLINE +
                       'can not be issued from TOMS to SSO; must issue from FMS to SSO.';
               FIELD(Issue_Btn).CurBias = FB_DIMMED;
               FIELD(Skip_Btn).CurBias = FB_DIMMED;
               RESUME;
            ENDIF;
         ENDIF;         

         IF Selected.Object = Operator$NO9 THEN
            /*
            ** determine the move type and prevent move from being issue
            ** if any of these prompts are called.  
            */
            IF Moves[i].Status = Job$Restore THEN
               TORS = 1;
            ELSEIF Moves[i].Status = Job$TakeOut THEN
               TORS = 0;
            ENDIF;

            k = 0;
            SELECT :k = Status
            FROM    FMS_JobAction
            WHERE   JobClass = :Moves[i].JobClass AND
                    EquipClass = :Moves[i].MoveEquipClass AND
                    StepPair = :Moves[i].StepPair AND
                    TypeOfCard = :CardDetails.TypeOfCard AND
                    TORS = :TORS AND
                    IssueCompl = 1 AND                 /* look for prompts at move completion time */
                    Action = :JobAction$Prompt AND
                    Status IN(:Prompt$CheckDBF,
                              :Prompt$HighPotDist,:Prompt$ModHighPotDist,
                              :Prompt$AmmeterClearDist,
                              :Prompt$Phases,
                              :Prompt$Relay);

            IF k <> 0 THEN
               MESSAGE '---VALIDATION MESSAGE---' + HC_NEWLINE +
                       'Move: ''' + Moves[i].TOMove + '''' + HC_NEWLINE +
                       'can not be issued to #9.';
               FIELD(Issue_Btn).CurBias = FB_DIMMED;
               FIELD(Skip_Btn).CurBias = FB_DIMMED;
               RESUME;
            ENDIF;
         ENDIF;         
      ENDFOR;

   ELSEIF Selected.Object = Operator$FODNotify THEN
      FOR i = 1 TO Moves.LastRow() DO
          IF (Moves[i].Status = Job$TakeOut AND Moves[i].TOMoveRules <> MoveRule$IAuto) OR
              (Moves[i].Status = Job$Restore AND Moves[i].RSMoveRules <> MoveRule$IAuto) THEN
            MESSAGE 'Only auto-complete moves can be issued to FOD Notify. ' +
                    'Please select another operator.';
            RESUME;
         ENDIF;
      ENDFOR;
      
   ENDIF;

#  include EnsureMovesAreInSameStation

   IF Selected.Object = Operator$FCR THEN
/*
** Make sure all moves have been set up with Work Locations.  If they have
** not, then it probably isn't a valid FCR work permit.
*/
      FOR i = 1 TO Moves.LastRow() DO
         /*
         ** Make sure at least the work permit has at least one location
         */
         k = 0;
         SELECT :k = COUNT(*)
         FROM   IR_WorkLocation
         WHERE  WorkPermit = :Moves[i].Job;
         
         IF k < 1 THEN
            MESSAGE 'Only FCR Work Permits with established Work Locations ' +
                    'may be issued electronically to the FCR. ' +
                    'Use the Request For Permit (RFP) function to ' +
                    'establish Work Locations for your FCR Work Permits.'; 
            FIELD(Issue_Btn).CurBias = FB_DIMMED;
            FIELD(Skip_Btn).CurBias = FB_DIMMED;
            RESUME;
         ENDIF;
/*
** Make sure Work Locations are properly tagged.
*/
         m = 0;
         SELECT :m = COUNT(*)
         FROM   IR_WorkLocation WL,
                IR_RequestForPermit RFP
         WHERE  WL.WorkPermit =:Moves[i].Job AND
                WL.LocationStatus = 'Tag Needed' AND
                WL.RFP = RFP.RFP AND
                WL.RequestForPermit = RFP.RequestForPermit;

         IF m <> 0 THEN
            MESSAGE 'Your Work Locations have not been properly tagged ' +
                    'for permit: ' + Moves[i].TOMove + '. ' +
                    'Please evaluate the Location Status for this permit.';
            FIELD(Issue_Btn).CurBias = FB_DIMMED;
            FIELD(Skip_Btn).CurBias = FB_DIMMED;
            RESUME;
         ENDIF;
      ENDFOR;
       
      SELECT :DateNow = DATE('now');
      m = 0;
      SELECT :m = COUNT(*)
      FROM   FMS_RegTag RT,
             SOA_ActiveObject AO
      WHERE  :DateNow > RT.ExpirationDate AND
             RT.Feeder = AO.Object AND
             AO.Card = :CardDetails.Card;
 
      IF m > 0 THEN
         MESSAGE 'A Registered Tag for this feedercard has expired. ' +
                 'Please evaluate your Registered Tags on this feedercard ' +
                 'before issuing the permit.';
         FIELD(Issue_Btn).CurBias = FB_DIMMED;
         FIELD(Skip_Btn).CurBias = FB_DIMMED;
         RESUME;
      ENDIF;
   ENDIF;
/*
** If an FOD Operator, evaluate Crew availability for selection.
*/
   IF Selected.Object = Operator$FOD OR 
      Selected.Object = Operator$NO9 THEN
      CrewsAvailable = FALSE;
/*
**  Get time from database to avoid timing issued with auto-reject in send app server
**  after order is issued.  Time is retrieved from DB in there also.
*/ 
      SELECT :DateNow = DATE('now');
      m = 1;
      REPEATED
      SELECT DISTINCT
             :Crew.FODCrew_tf[m].EmployeeNumber = O.Name         
            ,:Crew.FODCrew_tf[m].CrewName = O.Description         
            ,:Crew.FODCrew_tf[m].CommMethod = C.Communication        
            ,:Crew.FODCrew_tf[m].ContactInfo = C.ContactInfo        
            ,:Crew.FODCrew_tf[m].EmployeeObjectID = O.Object        
            ,:Crew.FODCrew_tf[m].EndTime = C.EndTime        
      FROM   Udb_Object O,
             IR_FODCrewAssign C,
             SOA_ActiveObject AO
      WHERE  C.Feeder = AO.Object AND
             AO.Card = :CardDetails.Card AND
             C.EndTime > :DateNow AND
             C.EmpObject = O.Object
      BEGIN
         m = m + 1;
         CrewsAvailable = TRUE;
      END;
 
      /* and FOD desk */
      Crew.FODCrew_tf[m].EmployeeNumber = Selected.Name;        
      Crew.FODCrew_tf[m].CrewName = 'FOD Desk';        
      Crew.FODCrew_tf[m].CommMethod = 'Download';        
      Crew.FODCrew_tf[m].ContactInfo = '';       
      Crew.FODCrew_tf[m].EmployeeObjectID = Operator$FOD;       
/*      Crew.FODCrew_tf[m].EndTime = Date('now') + '1 day';       */
           
      IF CrewsAvailable = TRUE AND
         Selected.Object = Operator$FOD THEN /* Only display if FOD was selected */

         Selected.Object = 0;
         
         FIELD(Crew).AbsXLeft = FIELD(ElectronicOperator).AbsXLeft;
         FIELD(Crew).AbsYTop = FIELD(ElectronicOperator).AbsYTop;
         FIELD(Crew).CurBias = FB_LANDABLE;
         FIELD(Issue_Btn).CurBias = FB_DIMMED;
         FIELD(Skip_Btn).CurBias = FB_DIMMED;
         FIELD(Download_btn).CurBias = FB_DIMMED;
      ELSE
        
         FIELD(Crew).CurBias = FB_INVISIBLE;

         /* Issue moves to FOD Desk */
         WirelessCrew = TRUE;

         /* why do we need to do this again ?
         Selected.Object = ElectronicOperator[].Object;
         Selected.Name = ElectronicOperator[].Name;
         Selected.Description = ElectronicOperator[].Description;
         */
         FIELD(Issue_Btn).CurBias = FB_LANDABLE;
         FIELD(Skip_Btn).CurBias = FB_LANDABLE;
         FIELD(Download_Btn).CurBias = FB_DIMMED;
         CurFrame.SendUserEvent (EventName = 'HighlightMove');
      ENDIF;

   ELSE
/*
** Fill out object classes from selected operator.
*/
      /* why do we need to do this again ?
      Selected.Name = VerbalOperator[].Name;
      Selected.Description = VerbalOperator[].Description;
      */

      FO.Object = Selected.Object;
      FO.Name = Selected.Name;
      FO.Description = Selected.Description;
    
      FIELD(Issue_Btn).CurBias = FB_LANDABLE;
      FIELD(Skip_Btn).CurBias = FB_LANDABLE;
      FIELD(Download_Btn).CurBias = FB_DIMMED;
      CurFrame.SendUserEvent (EventName = 'HighlightMove');
   ENDIF;
/*
** Generic Steam Op logic
*/
   IF Selected.Object = Operator$SteamDistribMechanic OR
      Selected.Object = Operator$StationOperator OR
      Selected.Object = Operator$StationSupervisor OR
      Selected.Object = Operator$GasSupervisor OR
      Selected.Object = Operator$SequenceEngineer OR 
      Selected.Object = Operator$SteamDistribSupervisor THEN

      IF CurFrame.ReplyPopUp (MessageText = 'Please enter the name of the ' +
           'operator being issued the move(s).', Reply = GenOpName) = PU_OK THEN
         Selected.Description = GenOpName.Value;
      ELSE
         Selected.Object = 0;
         Selected.Name = '';
         Selected.Description = '';
      ENDIF;
   ENDIF;

   MoveRow = 0;
   IF AllSteamStreetEligible = TRUE THEN
      AllSteamStreet = FALSE;
      FIELD(anyorder_toggle).CurBias = FB_CHANGEABLE; 
      anyorder_toggle = 0;
   ENDIF;
END;

ON SETVALUE anyorder_toggle =
BEGIN
   IF anyorder_toggle = 1 AND MoveRow = 1 THEN
      AllSteamStreet = TRUE;
      FIELD(anyorder_toggle).CurBias = FB_VISIBLE; 
      Field(Moves[1].TOMove).ISReverse = FALSE;
      MoveRow = 0;
   ENDIF;
END;   

ON SetValue Selected.Name =
BEGIN
/*
**  Pick out everyone on the list with a similar name
*/
   FoundOperator = FALSE;
   TempChar  = Trim(Lowercase(Selected.Name)) + '%';
   Selected.Description  = '';
   Selected.Object = 0;
/*
** if there is something in the electronic list, show it 
*/
   ReducedList.Clear();
   i = 1;
   Row = 0;
   WHILE i <= SavedElectronicList.LastRow() DO
      IF Lowercase(SavedElectronicList[i].Name) LIKE TempChar THEN   
         Row = Row + 1;
         ReducedList[Row] = SavedElectronicList[i];
      ENDIF;                        
      i = i + 1;
   ENDWHILE;
   IF (Row > 0) THEN
      ElectronicOperator = ReducedList.Duplicate();
   ENDIF;
/*
** if there is something in the verbal list, show it 
*/
   ReducedList.Clear();
   i = 1;
   Row = 0;
   WHILE i <= SavedVerbalList.LastRow() DO
      IF Lowercase(SavedVerbalList[i].Name) LIKE TempChar THEN   
         Row = Row + 1;
         ReducedList[Row] = SavedVerbalList[i];
      ENDIF;                        
      i = i + 1;
   ENDWHILE;
   IF (Row > 0) THEN
      VerbalOperator = ReducedList.Duplicate();
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   Row = ElectronicOperator.LastRow() + VerbalOperator.LastRow();
   IF (Row = 1) THEN
      IF ElectronicOperator.LastRow() = 1 THEN
         Selected.Object = ElectronicOperator[1].Object;
         Selected.Name = ElectronicOperator[1].Name;
         Selected.Description  = ElectronicOperator[1].Description;
         FIELD(ElectronicOperator).ActiveRow = Row;
      ELSE
         Selected.Object = VerbalOperator[1].Object;
         Selected.Name = VerbalOperator[1].Name;
         Selected.Description  = VerbalOperator[1].Description;
         FIELD(VerbalOperator).ActiveRow = Row;
      ENDIF;
#     include EnsureMovesAreInSameStation

      FIELD(Issue_Btn).CurBias = FB_LANDABLE;
      FIELD(Skip_Btn).CurBias = FB_LANDABLE;

      FoundOperator = TRUE;
   ENDIF;
END;

/*
**  Handle operator selection by partial name
*/
ON SetValue Selected.Description,
ON CLICK Find_Btn  =
BEGIN
/*
**  Pick out everyone on the list with a similar name
*/
   FoundOperator = FALSE;
   TempChar  = Trim(Lowercase(Selected.Description)) + '%';
   Selected.Name  = '';
   Selected.Object = 0;
/*
** if there is something in the electronic list, show it 
*/
   ReducedList.Clear();
   i = 1;
   Row = 0;
   WHILE i <= SavedElectronicList.LastRow() DO
      IF Lowercase(SavedElectronicList[i].Description) LIKE TempChar THEN   
         Row = Row + 1;
         ReducedList[Row] = SavedElectronicList[i];
      ENDIF;                        
      i = i + 1;
   ENDWHILE;
   IF (Row > 0) THEN
      ElectronicOperator = ReducedList.Duplicate();
   ENDIF;
/*
** if there is something in the verbal list, show it 
*/
   ReducedList.Clear();
   i = 1;
   Row = 0;
   WHILE i <= SavedVerbalList.LastRow() DO
      IF Lowercase(SavedVerbalList[i].Description) LIKE TempChar THEN   
         Row = Row + 1;
         ReducedList[Row] = SavedVerbalList[i];
      ENDIF;                        
      i = i + 1;
   ENDWHILE;
   IF (Row > 0) THEN
      VerbalOperator = ReducedList.Duplicate();
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   Row = ElectronicOperator.LastRow() + VerbalOperator.LastRow();
   IF (Row = 1) THEN
      IF ElectronicOperator.LastRow() = 1 THEN
         Selected.Object = ElectronicOperator[1].Object;
         Selected.Name = ElectronicOperator[1].Name;
         Selected.Description  = ElectronicOperator[1].Description;
   /*      FIELD(ElectronicOperator).ActiveRow = Row;  */
      ELSE
         Selected.Object = VerbalOperator[1].Object;
         Selected.Name = VerbalOperator[1].Name;
         Selected.Description  = VerbalOperator[1].Description;
   /*      FIELD(VerbalOperator).ActiveRow = Row;    */
      ENDIF;
#     include EnsureMovesAreInSameStation

      FIELD(Issue_Btn).CurBias = FB_LANDABLE;
      FIELD(Skip_Btn).CurBias = FB_LANDABLE;

      FoundOperator = TRUE;
   ENDIF;
END;

ON CLICK Menu.File.Operator =
BEGIN
/*
** If enabled, access operator editor screen.
** Reload Operator List upon return.
*/
   CALLFRAME OperatorEditor;

   IF OpASE IS NULL THEN
      OpASE = OperatorClass_ASE.Create();
   ENDIF;

   OpASE.Load(OPList = ByRef(OperatorList),
              TypeOfOperator = Type$Person);
   
   VerbalOperator.Clear();
   ElectronicOperator.Clear();
   i = 1;
   k = 0;
   m = 0;
   WHILE i <= OperatorList.LastRow() DO
      IF OperatorList[i].Electronic = 1 THEN
         k = k + 1;
         ElectronicOperator[k] = OperatorList[i].Duplicate();
         IF ElectronicOperator[k].Object = DefaultOperator THEN
            FIELD(ElectronicOperator).ActiveRow = k;
            ENDLOOP;
         ENDIF;
      ELSE
         m = m + 1;
         VerbalOperator[m] = OperatorList[i].Duplicate();
         IF VerbalOperator[m].Object = DefaultOperator THEN
            FIELD(VerbalOperator).ActiveRow = m;
            ENDLOOP;
         ENDIF;
      ENDIF;   
      i = i + 1;
   ENDWHILE;
END; 


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'fms_card_control_taken' =
BEGIN
#  include Card_KeepControl
/*
**  All frames except for Main screen will return.
**  Main screen will have an event to clear the screen.
*/ 
   PhaseTerminal = 0; 
   CALLPROC ResetTwoOpGlobalVariables();

   RETURN PU_CANCEL;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
   RESUME;
END;

PROCEDURE IssueBusSectWP(
   Card          = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   CardList = ARRAY OF FMS_Card;
   DelayList = ARRAY OF TypeClass;
   SimpleStep = OperatingStep_ASE DEFAULT NULL; /* Enables use of class methods */
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
**  Find all FMS_Cards linked to this SwitchingItem.
*/
   i = 1;
   CardList.Clear();
   SELECT :CardList[i].Card = S.FMSCard,
          :CardList[i].CardClass = C.CardClass,
          :CardList[i].CardClassName = C.CardClassName,
          :CardList[i].Feeder = C.Feeder,   /*OK for 3G*/
          :CardList[i].FeederName = C.FeederName
   FROM    SOA_FMSSLCLink S,
           FMS_Card C
   WHERE   S.SLCCard = :Card AND
           S.SwitchingItem = :SwitchingItem AND
           S.FMSCard = C.Card AND
           C.CutOut IS NOT NULL AND 
           C.CutIn IS NULL
   BEGIN 
      i = i + 1;
   END;
/*
**  Now for each card we will clear all delays.
*/ 
   IF SimpleStep IS NULL THEN
      SimpleStep = OperatingStep_ASE.Create();
   ENDIF;    
   FOR i = 1 TO CardList.LastRow DO
      j = 1;
      DelayList.Clear();
      SELECT :DelayList[j].Name = S.OperatingStepName,
             :DelayList[j].Type = S.OperatingStep
      FROM    FMS_OperatingStepStatus S,
              Udb_ExtendedType ET
      WHERE   S.Card = :CardList[i].Card and
              S.EndTime = '' and
              S.OperatingStep = ET.Type and
              ET.SuperType = :Type$Delay and
              ET.Type <> ET.SuperType              
      ORDER BY Name     
      BEGIN
         j = j + 1;
      END;
      
      SimpleStep.SO.Object = CardList[i].Card;
      FOR j = 1 TO DelayList.LastRow DO 
         SimpleStep.OpStep    = DelayList[j].Type; 
   
         SimpleStep.ClearOpStep();
   
         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = SimpleStep.ErrorMessage,
               TraceMessage =
                'FRAME:PerformMoves;Error clearing delay. ' +
                'Card=' + VARCHAR(CardList[i].Card) +
                ';Status=' + VARCHAR(DelayList[j].Type) + '.'
               );
         ENDIF; 
      ENDFOR;
      /*
      **  After delays are cleared. Add OTWS Operating Step for each card.
      ** Values that need to be passed in:
      ** CurObject.SO.Object    = Card
      ** CurObject.SO.BaseType  = CardClass (Only needed if setting OTW* step)
      ** CurObject.SO.Name      = CardClassName
      ** CurObject.SO.Type      = Feeder
      ** CurObject.SO.TypeName  = FeederName
      ** CurObject.OpStep       = OperatingStep
      ** CurObject.StartTime    = OpStep StartTime (optional: default 'now')
      ** CurObject.Job          = Job being issued.(Only needed if setting OTW* step)
      */
      SimpleStep.SO.BaseType  = CardList[i].CardClass;
      SimpleStep.SO.Name      = CardList[i].CardClassName;
      SimpleStep.SO.Type      = CardList[i].Feeder;
      SimpleStep.SO.TypeName  = CardList[i].FeederName;
      SimpleStep.OpStep       = Type$OTWS;
      SimpleStep.Job          = Moves[MoveRow].Job;
      
      SimpleStep.SetOpStep();      
   ENDFOR;
   SimpleStep = NULL;
   RETURN;
END;

PROCEDURE FilterElectronicOperators(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   ContinueCheck = INTEGER NOT NULL WITH DEFAULT;
   ExcludedTypes = ARRAY OF INTEGEROBJECT;
   FCRPermit = INTEGER NOT NULL WITH DEFAULT;
   p = INTEGER NOT NULL WITH DEFAULT;
   WG = INTEGER NOT NULL WITH DEFAULT;
   ESub = INTEGER NOT NULL WITH DEFAULT;
   ElectSub = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** For TFMS Black Start and FMS/SLC Test cards, disable all electronic operators.
*/
   CardClass = 0;
   NetworkFeeder = 0;
   IF Moves[1].SwitchingItem IS NULL OR
      Moves[1].SwitchingItem = 0 THEN
      SELECT :CardClass = CardClass
      FROM    SOA_Card
      WHERE   Card = :Moves[1].Card;

      SELECT :NetworkFeeder = NetworkFeeder 
      FROM    FMS_Card 
      WHERE   Card = :Moves[1].Card;    
   ELSE
      SELECT :CardClass = CardClass
      FROM    SLC_InformationItem
      WHERE   Job = :Moves[1].SwitchingItem;
   ENDIF;

   IF CardClass = Type$CardClassTest OR 
      CardClass = Type$SLCTest OR
      CardClass = Type$TFMSBLCK 
    /* OR NetworkFeeder = TRUE */ THEN
      ElectronicOperator.Clear();
      RETURN;
   ENDIF;
/*
** Load Excluded Equipment Types
*/
   i = 1;
   ExcludedTypes.Clear();
   SELECT :ExcludedTypes[i].Value = EquipClass
   FROM   SOA_ElectronicOrderExcl
   BEGIN
      i = i + 1;
   END;
/*
** For DSO, convert substation attribute from dielectric facility to electric substation where possible
*/   
   IF CurrentApplication = Application$DSO THEN
      i = 1;
      ElectSub = 0;
      WHILE i <= Moves.LastRow DO
         IF Moves[i].Substation = 0 THEN
            IF ElectSub > 0 THEN
               Moves[i].Substation = ElectSub;
            ENDIF;            
            //ElectronicOperator.Clear();
            //RETURN;
         ENDIF;
         
         ESub = 0;
         SELECT :ESub = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Moves[i].Substation AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType IN (:Type$Substation,:Type$MacroSubstation)
         UNION    /* some structures have to be member of dielectric facility */
         SELECT G2.Grouping
         FROM   Udb_Grouping G1,
                Udb_Grouping G2
         WHERE  G1.Member = :Moves[i].Substation AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.Grouping = G2.Member AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.GroupingType  IN (:Type$Substation,:Type$MacroSubstation);
                
         IF ESub > 0 THEN
            Moves[i].Substation = ESub;
            ElectSub = ESub;
         ELSE
            IF ElectSub > 0 THEN
               Moves[i].Substation = ElectSub;
            ELSE 
               Moves[i].Substation = 0;   /* For purpose of enabling an OpOrder */
            ENDIF;            
            //ElectronicOperator.Clear();
            //RETURN;
         ENDIF;
         i = i + 1;
      ENDWHILE;   
/* 
** If an electric sub move exists, mark all still zero substation moves with that substation 
** Subsequent evaluation will make sure all moves are in same substation to enable OpOrder.
*/    
      IF ElectSub = 0 THEN
         ElectronicOperator.Clear();
         RETURN;
      ELSE
         FOR i = 1 TO Moves.LastRow DO
            IF Moves[i].Substation = 0 THEN
               Moves[i].Substation = ElectSub;
            ENDIF;            
         ENDFOR;               
      ENDIF;      
   ENDIF;
   
   ContinueCheck = TRUE;  /*For Substation*/
   OpOrderSubstation = 0;
/*
** If this is an FMS Work Permit not associated with an RFP, then we want to assign
** a substation to the move if it does not have one and enable the Operating Order
** operator.
*/
   IF Moves[1].Substation = 0 THEN
      IF Moves[1].StepPair = StepHeading$WorkPermit AND 
         CurrentApplication = Application$FMS THEN
         FCRPermit = 0;
         SELECT :FCRPermit = COUNT(*)
         FROM   IR_WorkLocation
         WHERE  WorkPermit = :Moves[1].Job;

         IF FCRPermit <> 0 THEN
            ContinueCheck = FALSE;
         ELSE
            SELECT :Moves[1].Substation = O.PrimaryGrouping
            FROM   TFMS_CardToObject CTO,
                   UDB_Grouping G,
                   Udb_Object O
            WHERE  CTO.Card = :Moves[1].Card AND
                   CTO.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.Member = :Moves[1].Equip AND
                   G.Grouping = O.Object;
            /*
               SELECT :Moves[1].Substation = O.PrimaryGrouping
               FROM   Udb_Object O,
                      FMS_Card C
               WHERE  C.Card = :Moves[1].Card AND 
                      C.Feeder = O.Object;
            */
            OpOrderSubstation = Moves[1].Substation; 
         ENDIF;
      ELSE
         ContinueCheck = FALSE;         
      ENDIF;
   ELSE
      OpOrderSubstation = Moves[1].Substation;
   ENDIF;
   
   IF ContinueCheck = TRUE THEN
      i = 1;
      WHILE i <= Moves.LastRow DO
/*
** If the move equipment type is excluded, then disable the electronic operator list
*/
         p = ExcludedTypes.Find (AttributeName = 'value',
                                 Value = Moves[i].EquipClass);
         IF p = ER_OK THEN
            ElectronicOperator.Clear();
            RETURN;
         ENDIF;
/*
** Put a station on each move if it is an FMS WorkPermit
*/
         IF Moves[i].Substation = 0 AND
             Moves[i].StepPair = StepHeading$WorkPermit AND 
             CurrentApplication = Application$FMS THEN

            FCRPermit = 0;
            SELECT :FCRPermit = COUNT(*)
            FROM   IR_WorkLocation
            WHERE  WorkPermit = :Moves[i].Job;

            IF FCRPermit = 0 THEN
               SELECT :Moves[i].Substation = O.PrimaryGrouping
               FROM   TFMS_CardToObject CTO,
                      UDB_Grouping G,
                      Udb_Object O
               WHERE  CTO.Card = :Moves[i].Card AND
                      CTO.Object = G.Grouping AND
                      G.Relationship = :Interaction$MemberOf AND
                      G.Member = :Moves[i].Equip AND
                      G.Grouping = O.Object;
               /*  
                  SELECT :Moves[i].Substation = O.PrimaryGrouping
                  FROM   Udb_Object O,
                         FMS_Card C
                  WHERE  C.Card = :Moves[i].Card AND
                         C.Feeder = O.Object;
               */
            ENDIF;
         ENDIF;
 
         MacroStation = FALSE;
         SELECT :MacroStation = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Moves[i].Substation AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$MacroSubstation;

         HybridStation = FALSE;
         SELECT :HybridStation = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :Moves[i].Substation AND
                G.Relationship = :Interaction$ShareControlRoom AND
                G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                   WHERE  SuperType = :Type$Substation);

         IF i = 1 AND MacroStation <> FALSE THEN
            OpOrderSubstation = MacroStation;
         ELSEIF i = 1 AND HybridStation <> FALSE THEN
            OpOrderSubstation = HybridStation;
         ELSEIF MacroStation <> FALSE THEN
            IF MacroStation <> OpOrderSubstation THEN
               ContinueCheck = FALSE;
               ENDLOOP;
            ENDIF;
         ELSEIF HybridStation <> FALSE THEN
            IF HybridStation <> OpOrderSubstation THEN
               ContinueCheck = FALSE;
               ENDLOOP;
            ENDIF;
         ELSEIF Moves[i].Substation <> OpOrderSubstation THEN
            ContinueCheck = FALSE;
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE; 
   ENDIF;

   i = FALSE;
   IF ContinueCheck = TRUE THEN
      SELECT :i = SOA_To_SOO
      FROM   SOO_Communication
      WHERE  Substation = :OpOrderSubstation;
   ENDIF;

   IF i = TRUE THEN
      /* 
      ** If the move is going to a substation, then remove FOD and No9
      */
      i = ElectronicOperator.LastRow;
      WHILE i >= 1 DO
         IF ElectronicOperator[i].Object = Operator$FOD OR
            ElectronicOperator[i].Object = Operator$NO9 THEN
            ElectronicOperator.RemoveRow (RowNumber = i );
         ENDIF;
         i = i - 1;
      ENDWHILE;

   ELSE
      /* 
      ** If the move is not going to an enabled substation, then remove OpOrder
      */
      i = ElectronicOperator.LastRow;
      WHILE i >= 1 DO
         IF ElectronicOperator[i].Object = Operator$OpOrder THEN
            ElectronicOperator.RemoveRow (RowNumber = i );
            ENDLOOP;
         ENDIF;
         i = i - 1;
      ENDWHILE;
   ENDIF;  
   /*
   ** Additional criteria to remove Electronic Operators from Selection List.
   */
   IF CurrentApplication = Application$FMS THEN
      IF Moves[1].StepPair = StepHeading$WorkPermit THEN
/*
** Issuing FMS Work Permit - will not go to FOD or #9.
*/
         i = ElectronicOperator.LastRow;
         WHILE i >= 1 DO
            IF ElectronicOperator[i].Object = Operator$FOD OR
                  ElectronicOperator[i].Object = Operator$NO9 THEN
               ElectronicOperator.RemoveRow (RowNumber = i );
/*
** Will not go to OpOrder if it is not in a substation.
*/
            ELSEIF Moves[1].Substation = 0 AND
                 ElectronicOperator[i].Object = Operator$OpOrder THEN
               ElectronicOperator.RemoveRow (RowNumber = i );
/*
** Delete FCR if the move is associated to substation.
*/
            ELSEIF Moves[1].Substation <> 0 AND
                 ElectronicOperator[i].Object = Operator$FCR THEN
               ElectronicOperator.RemoveRow (RowNumber = i );
/*
** Beyond this, we have FMS Permit in a station.  Look at Working Group of JobClass
** If no Working Group, then delete OpOrder.
*/
            ELSEIF Moves[1].Substation <> 0 AND
                 ElectronicOperator[i].Object = Operator$OpOrder THEN

               p = 1;
               WG = 1;
               WHILE p <= Moves.LastRow() AND WG <> 0 DO 
                  WG = 0;
                  SELECT :WG = JobClass
                  FROM   IR_WorkingGroup
                  WHERE  JobClass = :Moves[p].JobClass;
                  p = p + 1;
               ENDWHILE;
               IF WG = 0 THEN
                  ElectronicOperator.RemoveRow (RowNumber = i );
               ENDIF;
            ENDIF;
            i = i - 1;
         ENDWHILE;
/*
** Take FCR away for FMS non-work permits.
*/
      ELSE
         i = ElectronicOperator.LastRow;
         WHILE i >= 1 DO
            IF ElectronicOperator[i].Object = Operator$FCR THEN
               ElectronicOperator.RemoveRow (RowNumber = i );
               ENDLOOP;
            ENDIF;
            i = i - 1;
         ENDWHILE;
      ENDIF;
      /*
      ** disable FCR and FOD for 3G enabled feeders 
      */
      IF NetworkFeeder = NetworkFeeder$3G AND Enable3GConfigChange = TRUE THEN
         i = ElectronicOperator.LastRow;
         WHILE i >= 1 DO
            IF ElectronicOperator[i].Object = Operator$FCR OR
               ElectronicOperator[i].Object = Operator$FOD OR
               ElectronicOperator[i].Object = Operator$NO9 THEN
               ElectronicOperator.RemoveRow (RowNumber = i );
            ENDIF;
            i = i - 1;
         ENDWHILE;
      ENDIF;
    
   ELSE
/*
** For non-FMS Work Permits, take away Op Order if permit does
** not have a working group.
*/
      IF Moves[1].StepPair = StepHeading$WorkPermit THEN
         i = ElectronicOperator.LastRow;
         WHILE i >= 1 DO
            IF ElectronicOperator[i].Object = Operator$OpOrder THEN
               p = 1;
               WG = 1;
               WHILE p <= Moves.LastRow() AND WG <> 0 DO 
                  WG = 0;
                  SELECT :WG = JobClass
                  FROM   IR_WorkingGroup
                  WHERE  JobClass = :Moves[p].JobClass;
                  p = p + 1;
               ENDWHILE;
               IF WG = 0 THEN
                  ElectronicOperator.RemoveRow (RowNumber = i );
               ENDIF;
            ENDIF;
            i = i - 1;
         ENDWHILE;
      ENDIF;
   ENDIF;
   RETURN;    
END;

PROCEDURE ResetTwoOpGlobalVariables (
) =
BEGIN
   EnhancedTwoOpReview = FALSE;
   TwoOpConfirmEvent = '';
   ElectronicOrder = FALSE;
END;


PROCEDURE TwoOpReview (
   Card = INTEGER NOT NULL
  ,SwitchingItem = INTEGER NOT NULL WITH DEFAULT
  ,Job = INTEGER NOT NULL WITH DEFAULT
) =
DECLARE
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   AllWarningText = VARCHAR(1000) NOT NULL WITH DEFAULT;
   CardClass = INTEGER NOT NULL;
   CardName = VARCHAR(200) NOT NULL WITH DEFAULT;
   EmailClass = EmailNotificationClass DEFAULT NULL;
   SwItemTitle = VARCHAR(160) NOT NULL WITH DEFAULT;
BEGIN
   k = 1;
   BypassAbortPrompt = FALSE;
   FOR j = 1 TO Moves.LastRow() DO
      IF FIELD(Moves[j].ToMove).BGColor <> CC_LIGHT_GRAY THEN
         RetCode = CALLPROC SOA_WarningOverrideIns (
              Operator = DOp.Object,
              Job = Moves[j].Job,
              TORS = Moves[j].TORS,
              Seq = k,
              TwoOpConfirmEvent = TwoOpConfirmEvent);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to save moves for second operator review. Must Abort.';
            RETURN PU_CANCEL;
         ELSE
            k = k + 1;
         ENDIF;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
   /*
   ** Establish AllWarningText before needing it.  Not clear how WarningBuffer is losing contents.
   */   
      AllWarningText = '';
      IF WarningBuffer.LastRow = 1 THEN
         ALLWarningText = WarningBuffer[1].WarningText;
      ELSEIF WarningBuffer.LastRow > 1 THEN
         FOR j = 1 TO WarningBuffer.LastRow DO
            AllWarningText = AllWarningText + 'Warning #' + VARCHAR(j) + ': ' + 
                          WarningBuffer[j].WarningText + ';';
         ENDFOR;
      ENDIF;   

   RetCode = CALLFRAME WarningOverrideReview (Card = Card,
                                    SwitchingItem = SwitchingItem,
                                    ReviewStage = 'Op1',
                                    TwoOpConfirmEvent = TwoOpConfirmEvent); 
   IF RetCode = PU_CANCEL THEN
/*
**  Get CardClass and CardName information for SOA_Warning insert.
*/
      SwItemTitle = '';
      IF SwitchingItem = 0 THEN 
         SELECT :CardClass = CardClass
         FROM    SOA_Card
         WHERE   Card = :Card;
      ELSE
         SELECT :CardClass = CardClass
         FROM    SLC_InformationItem
         WHERE   Job = :SwitchingItem;
         SELECT :SwItemTitle = TOMove
         FROM   SOA_Job
         WHERE  Job = :SwitchingItem;
      ENDIF;

      IF CardClass <> Type$CardClassTest THEN   
      
         IF CurrentApplication = Application$FMS THEN
            SELECT :CardName = FeederName
            FROM   FMS_Card
            WHERE  Card = :Card;    
         ELSEIF CurrentApplication = Application$TFMS THEN
            SELECT :CardName = FeederNames
            FROM   TFMS_Card
            WHERE  Card = :Card;
         ELSEIF CurrentApplication = Application$SLC THEN
            SELECT :CardName = SubstationName
            FROM   SLC_Card
            WHERE  Card = :Card;
         ENDIF;
      
         CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 3,
                   WarningText = 'Warning not overridden after Two Op Review',
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   TwoOpConfirmEvent = TwoOpConfirmEvent,
                   Job = IFNULL(Job,0));
         CALLPROC DDB_COMMIT;
/*
** Send Warning Backout Cancelled email to SystemOpsCloseCalls if AllWarningText is not blank.
*/       
        IF AllWarningText <> '' THEN
         
         IF EmailClass IS NULL THEN
            EmailClass = EmailNotificationClass.Create();
         ENDIF;
         EmailClass.EmailType = 25;
         EmailClass.Sender = DOp.Description;
         EmailClass.Recipient = 'SysOpsCloseCalls';
         EmailClass.Subject  = 'Two Op Override Rejected. Initiated by ' + DOp.Description;
         IF SwItemTitle = '' THEN
            EmailClass.Message1 = 'Text1=' + CurrentApplication + ' Card ' + CardName + ';;';
         ELSE
            EmailClass.Message1 = 'Text1=' + CurrentApplication + ' Card ' + CardName + ' ' +
                                             SQUEEZE(SwItemTitle) + ';;';
         ENDIF;
         EmailClass.Message2 = 'Text2=' + 'Warning: ' + AllWarningText + ';;';
         EmailClass.Template = 'TwoOpOverrideCancel.html';
         EmailClass.InsertRequest();

         IF EmailClass.ReturnCode <> 0 THEN 
            CALLPROC TraceError (UserMessage =
                  'ERROR: Unable to save Two Op Override Review Rejection Close Call email.',
                           TraceMessage =
                  'DistrictOperatorClass Method RecordBackout: Unable to save Two Op Override Review Rejection Close Call email ' +
                  'for Operator:' + DOp.Description );
         ENDIF;
         
         DOp.RecordBackout (WarningText = AllWarningText);
        ELSE
            CALLPROC TraceError (TraceMessage =
                  'ERROR: WarningBuffer in Two Op Review is empty, no rejection email sent. This is an odd bug.',
                           UserMessage =  '' );
        ENDIF;
      ENDIF;

      WarningBuffer.Clear();
      BypassAbortPrompt = TRUE;
   ENDIF;
   RETURN :RetCode;
END;

