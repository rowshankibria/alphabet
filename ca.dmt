*/ 
METHOD InsertRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.CurrentStatus = 'OPEN';

   RetCode = CALLPROC SOA_ISPermitRequestIns(
         ISPermit =  CurObject.ISPermit,
         EnterTime = Date('Now'),
         EnterBy =  CurObject.EnterBy,
         EnterByName =  CurObject.EnterByName,
         Email = CurObject.Email,
         CurrentStatus =  CurObject.CurrentStatus,
         PermitMove = CurObject.PermitMove,
         StartDate = CurObject.StartDate, 
         WorkShift = CurObject.WorkShift, 
         Emergent = CurObject.Emergent,
         Equipment = CurObject.Equipment,         
         RelayCalibration = CurObject.RelayCalibration,
         Compliance = CurObject.Compliance,
         RelayCalDetail  = CurObject.RelayCalDetail,    
         AlarmCircuits = CurObject.AlarmCircuits,    
         AlarmCktDetail = CurObject.AlarmCktDetail,   
         LossOfControl = CurObject.LossOfControl,     
         EquipAndDuration = CurObject.EquipAndDuration,  
         RemoveCtrlFeed = CurObject.RemoveCtrlFeed,    
         CtrlFeedEquip = CurObject.CtrlFeedEquip,     
         OwnIsolation = CurObject.OwnIsolation,      
         LiveConnections = CurObject.LiveConnections,    
         AsbestosRelated = CurObject.AsbestosRelated,         
         AsbAffectEquip = CurObject.AsbAffectEquip,    
         AsbestosWork = CurObject.AsbestosWork,      
         TripoutAccess = CurObject.TripoutAccess,
         AsbestosOperator = CurObject.AsbestosOperator,     
         TripoutPotential = CurObject.TripoutPotential,  
         TripoutComment = CurObject.TripoutComment,    
         Description = CurObject.Description,       
         GndLevelWork = CurObject.GndLevelWork,      
         GndLevelDetail = CurObject.GndLevelDetail);
    
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPRequestDetails.InsertRequest; Error inserting In Service Permit Request';
      CurMethod.Trace(Text = varchar(date('now')) + ':ISPRequestDetails.InsertRequest. ERROR: ' + 
                'Unable to insert In Service Permit Request.');
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

METHOD DeleteRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC SOA_ISPermitRequestDel(
        ISPermit =  CurObject.ISPermit);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ISPRequestDetails.DeleteRequest; Error deleting In Service Permit Request';
      CurMethod.Trace(Text = varchar(date('now')) + ':ISPRequestDetails.DeleteRequest. ERROR: ' + 
                'Unable to delete In Service Permit Request.');
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

METHOD LoadDetail (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.ISPermit = R.ISPermit,
         :CurObject.EnterBy = R.EnterBy,
         :CurObject.EnterByName = R.EnterByName,
         :CurObject.Email = R.Email,
         :CurObject.Status = P.Status,
         :CurObject.CurrentStatus = R.CurrentStatus,
         :CurObject.PermitMove = R.PermitMove,
         :CurObject.StartDate = R.StartDate,
         :CurObject.WorkShift = R.WorkShift,
         :CurObject.Emergent = R.Emergent,
         :CurObject.Equipment = R.Equipment,         
         :CurObject.NYISOEquip = R.NYISOEquip,         
         :CurObject.RelayCalibration = R.RelayCalibration,
         :CurObject.Compliance = R.Compliance,
         :CurObject.RelayCalDetail = R.RelayCalDetail,    
         :CurObject.AlarmCircuits = R.AlarmCircuits,    
         :CurObject.AlarmCktDetail = R.AlarmCktDetail,   
         :CurObject.LossOfControl = R.LossOfControl,     
         :CurObject.EquipAndDuration = R.EquipAndDuration,  
         :CurObject.RemoveCtrlFeed = R.RemoveCtrlFeed,    
         :CurObject.CtrlFeedEquip = R.CtrlFeedEquip,     
         :CurObject.OwnIsolation = R.OwnIsolation,      
         :CurObject.LiveConnections = R.LiveConnections,    
         :CurObject.AsbestosRelated = R.AsbestosRelated,         
         :CurObject.AsbAffectEquip = R.AsbAffectEquip,    
         :CurObject.AsbestosWork = R.AsbestosWork,      
         :CurObject.TripoutAccess = R.TripoutAccess,
         :CurObject.AsbestosOperator = R.AsbestosOperator,     
         :CurObject.TripoutPotential = R.TripoutPotential,  
         :CurObject.TripoutComment = R.TripoutComment,    
         :CurObject.Description = R.Description,       
         :CurObject.GndLevelWork = R.GndLevelWork,      
         :CurObject.GndLevelDetail = R.GndLevelDetail,
         :CurObject.ProcessByName = R.ProcessByName,
         :CurObject.Remark = R.Remark			        
   FROM   SOA_ISPermitRequest R, 
          SOA_InServicePermit P  
   WHERE  R.ISPermit = :CurObject.ISPermit AND
          R.ISPermit = P.ISPermit;

   i = 1;
   SELECT :CurObject.Attachments[i].FileID = FileID,
          :CurObject.Attachments[i].FileName = FileName
   FROM   SOA_ISPAttachment 
   WHERE  ISPermit = :CurObject.ISPermit 
   BEGIN
      i = i + 1;
   END;

   CALLPROC DDB_ROLLBACK;
END;

