	Name:            BuildEquipTransferList

/* 
**      Copyright c 2000 ESCA  All rights reserved. 
** 
**      ESCA proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
*/
/*
**  Application:    CAC
**  Frame:          BuildEquipTransferList
**
**  Date:       Author   Description
** ----------------------------------
**  06/01/00    em       Created to properly establish equip control during 
**                       Switch to Release transfer.  Uses connectivity
**                       trace around already determined opend device.
**                       We perform trace in one direction from Open device, 
**                       keeping track of equipment as we find it.  If
**                       we hit a target line seg, then we return the equipment
**                       list.  IF we hit an ignore line seg, we have gone the
**                       wrong way and we restart our trace pointed the other
**                       direction until we hit a target line seg.
**  06/09/00    em       Not returninging complete target equipment list. Extend
**                       search to include all objects within scope once target
**                       is found.
**  04/20/17    ysp      Moved from SOA. Converted to use QGis_based connectivity trace
**
*/
PROCEDURE BuildEquipTransferList
(
   Card = INTEGER NOT NULL;  /*Passed Card*/
   OpenDevice = INTEGER NOT NULL;  /*Passed OpenDevice*/
   TargetLineSegs = ARRAY OF INTEGEROBJECT; /*Passed list of include LineSeg*/
   IgnoreLineSegs = ARRAY OF INTEGEROBJECT; /*Passed list of exclude LineSeg*/

   ReturnEquip = ARRAY OF INTEGEROBJECT; /*Return list of included equip*/
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;

   CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
   ConnectedObjects = ARRAY OF INTEGEROBJECT;
   RetCode         = INTEGER;
   TerminalSearch  = INTEGER NOT NULL;  /*Terminal path we are tracing*/
   EndSearch       = INTEGER NOT NULL;  /*BOOLEAN*/
   TargetFound     = INTEGER NOT NULL;  /*BOOLEAN*/
   
   Trace = Trace_ControlTransfer DEFAULT NULL;
ENDDECLARE
BEGIN
   ReturnEquip.Clear();
   
   i = 1;
   SELECT  :CardObjects[i].Value = Object
   FROM    SOA_ActiveObject
   WHERE   Card = :Card
   ORDER BY 1
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** get the two objects the open device is connected to
*/
   i = 1;
   SELECT :ConnectedObjects[i].Value = ToObj
   FROM   DSO_Connection
   WHERE  FromObj = :OpenDevice
   UNION ALL
   SELECT FromObj 
   FROM   DSO_Connection
   WHERE  ToObj = :OpenDevice
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*   
** Start trace from one terminal. If the trace hits an ignore line seg (Trace.TargetFound = false) 
** we have gone the wrong way and we restart our trace pointed the other
** direction until we hit a target line seg (Trace.TargetFound = true).
*/ 
   FOR i = 1 TO ConnectedObjects.LastRow DO
      // start with a fresh class object
      Trace = Trace_ControlTransfer.Create();
      Trace.TraceFromEquip = ConnectedObjects[i].Value;
      Trace.TraceStartEquip = OpenDevice;
      FOR k = 1 TO TargetLineSegs.LastRow DO
         Trace.TargetLineSegments[k].Object = TargetLineSegs[k].Value;
         SELECT :Trace.TargetLineSegments[k].PrimaryGrouping = Grouping
         FROM   UDB_Grouping
         WHERE  Member = :Trace.TargetLineSegments[k].Object AND
                Relationship = :Interaction$MemberOf AND
                GroupingType = :Type$Line;
      ENDFOR;
      FOR k = 1 TO IgnoreLineSegs.LastRow DO
         Trace.IgnoreLineSegments[k].Object = IgnoreLineSegs[k].Value;
         SELECT :Trace.IgnoreLineSegments[k].PrimaryGrouping = Grouping
         FROM   UDB_Grouping
         WHERE  Member = :Trace.IgnoreLineSegments[k].Object AND
                Relationship = :Interaction$MemberOf AND
                GroupingType = :Type$Line;
      ENDFOR;
      Trace.CardObjectList = CardObjects;

      Trace.StartTargetTrace();
      
      IF Trace.ReturnCode <> 0 THEN
         MESSAGE Trace.ErrorMessage + HC_NEWLINE +
                 'Please report this problem to FMS Support';
         ENDLOOP;      
      ELSEIF Trace.TargetFound = TRUE THEN
         ReturnEquip = Trace.ReturnEquipList.Duplicate();
         ENDLOOP;
      ENDIF;
   ENDFOR;

   RETURN(PU_OK);
END;

