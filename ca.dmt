	Name:            GetCategoryName

/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Date   Initials    
** --------------------------------------------------------
**
**  12/08/04  ysp  Created
**  05/26/06  ysp  added RTU_CIRCUIT move category;
*/
PROCEDURE GetCategoryName
(
    CategoryID = INTEGER NOT NULL WITH DEFAULT; /* passed in */

    CategoryName = VARCHAR(20) NOT NULL WITH DEFAULT;
)=
BEGIN

    IF CategoryID = MoveCategory$Alarms THEN
       CategoryName = 'ALARMS';
 
    ELSEIF CategoryID = MoveCategory$SwitchOperation THEN
       CategoryName = 'SWITCH_OPS';

    ELSEIF CategoryID = MoveCategory$NonTelco THEN
       CategoryName = 'NON_TELCO_PERMIT';

    ELSEIF CategoryID = MoveCategory$Telco THEN
       CategoryName = 'TELCO_PERMIT';

    ELSEIF CategoryID = MoveCategory$Notification THEN
       CategoryName = 'NOTIFICATION';

    ELSEIF CategoryID = MoveCategory$RTUCircuit THEN
       CategoryName = 'RTU_CIRCUIT';
    ENDIF;

    RETURN CategoryName; 
END;

Application Component Report
============================

	Name:            GetCircuitReportCategory

/*
**
**      Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    TLS_OrderMonitor
**  Class:          GetCircuitReportCategory
**
**  Date:   Version Description
** ----------------------------------
**  06/22/09  ysp   Created
*/
procedure GetCircuitReportCategory
(
   CircuitType = INTEGER NOT NULL
) =
declare   
   CategoryName = varchar(40) not null with default;
   Counter = integer not null with default;
   TempType = INTEGER NOT NULL with default;
   ReportName = VARCHAR(40) NOT NULL; 
   ReportType = INTEGER NOT NULL WITH DEFAULT;
enddeclare
{
/*
** circuit type high level category
*/
   CategoryName = '';
   Counter = 1;
   TempType = CircuitType;
   ReportType = 0;

   WHILE TempType <> 0 AND Counter < 50 DO
      SELECT :ReportType = T.Type,
             :ReportName = T.Name             
      FROM   TC_CircuitToReportMapping TT,
             Udb_Type T
      WHERE  TT.CircuitType = :TempType AND
             TT.ReportType = T.Type;
   
      IF ReportType <> 0 THEN
         CategoryName = ReportName;
         ENDLOOP;
      ELSE
         SELECT :TempType = SuperType
         FROM   Udb_SuperType 
         WHERE  Type = :TempType;
      ENDIF;
      Counter = Counter + 1;
   ENDWHILE;
   CALLPROC DDB_ROLLBACK;

   RETURN CategoryName;
}

Application Component Report
============================

	Name:            GetConnectedSourceBreakers

/*
**
**	Copyright c 2006 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          GetConnectedSourceBreaker          
**
**  Modifications:
**  03/30/06   em   Created 
**                  Returns Source Breakers connected to a Bus Section
**  04/19/06   em   Need to get breakers in station also on each leg of trace,
**                  not just the Feeder Source Breakers.
**  11/05/12   em   Include Alternate Source Type
**  11/26/12   em   Set SourcePos for regular breaker
**  09/20/13   em   Special for Jamaica 27, look through Breaker BT550 and BT660 if closed;
**                  new optional to support when they are open via XA21
**  02/20/17   ysp  Converted to use QGis trace class Trace_ConnectedSourceBreakers
*/
PROCEDURE GetConnectedSourceBreakers
(
   Substation       = INTEGER NOT NULL;     /* Parameter*/
   BusSection       = INTEGER NOT NULL;     /* Parameter*/
   SourceBreakers   = ARRAY OF Equipment;   /* Exit Parameter*/
   XA21BT550Open    = INTEGER NOT NULL  WITH DEFAULT; /*Optional Parm*/
   XA21BT660Open    = INTEGER NOT NULL  WITH DEFAULT; /*Optional Parm*/
) =
DECLARE
   i		= INTEGER NOT NULL WITH DEFAULT;
   j		= INTEGER NOT NULL WITH DEFAULT;
   k		= INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SourceBreaker = Equipment; 
   TraceStatus = INTEGER NOT NULL WITH DEFAULT;
   
   Trace = Trace_ConnectedSourceBreakers DEFAULT NULL;
ENDDECLARE
BEGIN
/*
** Now we trace starting from the BusSection and trace each leg looking for Source or BREAKER
** type Equip.  Trace should stop within a few devices in each direction - do not extend outside
** scope of substation.
** We evaluate each equipment to see if it is a source breaker for a feeder.  If it is we add it
** to the list for return.  Bifurcated feeders, a source breakers serving two feeders, are not 
** supported - only a single feeder will be returned.
*/
   Trace = Trace_ConnectedSourceBreakers.Create();
   Trace.BSEquip.Object = BusSection;
   Trace.Substation = Substation;
   Trace.XA21BT550Open = XA21BT550Open;
   Trace.XA21BT660Open = XA21BT660Open;
   
   TraceStatus = Trace.StartTargetTrace();
      
   IF Trace.ReturnCode <> 0 THEN
      CALLPROC TraceError (
               UserMessage = 'ERROR: The connectivity trace from ' + 
                  ' Bus Section discovered database problem: ' + Trace.ErrorMessage,
               TraceMessage = 'GetConnectedSourceBreakers: The connectivity trace from ' + 
                  ' Bus Section ' + VARCHAR(BusSection) + ' discovered database problem: ' + Trace.ErrorMessage);
   ENDIF;

   /*
   ** Convert source breakers from QGis_Trace_Engine!Equipment to CAC!Equipment
   */
   FOR i = 1 TO Trace.SourceBreakerList.LastRow DO
      SourceBreaker = Equipment.Create();

      SourceBreaker.Equip = Trace.SourceBreakerList[i].Object;
      SourceBreaker.EquipName = Trace.SourceBreakerList[i].Name;
      SourceBreaker.EquipClass = Trace.SourceBreakerList[i].Type;
      SourceBreaker.EquipClassName = Trace.SourceBreakerList[i].TypeName;
      SourceBreaker.Description = Trace.SourceBreakerList[i].Description;
      SourceBreaker.CurrentlyOpen = Trace.SourceBreakerList[i].CurrentlyOpen;
      SourceBreaker.Substation = Trace.SourceBreakerList[i].Substation;
      SourceBreaker.PrimaryGrouping = Trace.SourceBreakerList[i].PrimaryGrouping;
      SourceBreaker.PrimaryGroupingName = Trace.SourceBreakerList[i].PrimaryGroupingName;
      SourceBreaker.SourceBkr = BusSection;    
      SourceBreaker.SourcePos = Trace.SourceBreakerList[i].SpareInteger;

      SourceBreakers.InsertRow(RowObject = SourceBreaker);
   ENDFOR;

   RETURN (PU_OK);
END;



Application Component Report
============================

	Name:            GetLinesAndFeeders

/*
**
**      Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC & IR_SendAppServer
**  Procedure:      GetLinesAndFeeders
**
**  Date:   Version Description
** ----------------------------------
**  07/19/05  em    Created
**
** =======================================================
**  NOTE: A copy of this procedure is in IR_SendAppServer 
** =======================================================
*/ 
PROCEDURE GetLinesAndFeeders
(
   Device		= INTEGER NOT NULL; /* Equip or Circuit Object */
   Substation           = INTEGER NOT NULL; /* Immediate Substation Parent */
   ObjectList		= ARRAY OF ObjectClass; /* Lines and Feeders Go Back */
) =
DECLARE
   i 			= INTEGER NOT NULL WITH DEFAULT; /* Index */
   MacroStation         = INTEGER NOT NULL WITH DEFAULT; /* If Macro Exists */
ENDDECLARE
BEGIN
/*
** Is the Station part of a Macro?
*/
   MacroStation = 0;
   SELECT :MacroStation = Grouping
   FROM   Udb_Grouping
   WHERE  Member = :Substation AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$MacroSubstation;
/*
** Circuits are associated "member of" feeder and lines. Feeders are associated 
** "member of" substations, while transmission lines' ACLineSegments are associated 
** "member of" substations.  It is important that only feeders and lines associated 
** to the substation where the order is being sent are included.  The order might 
** be sent to a Macro Substation, while the feeders and lines are associated to 
** substations that are part of the Macro Station.
*/
   ObjectList.Clear();
   IF MacroStation = 0 THEN
      i = 1;
      REPEATED
      SELECT DISTINCT 
             :ObjectList[i].Object = O.Object,
             :ObjectList[i].Name = O.Name
      FROM   Udb_Object O,
             Udb_Grouping G1,
             Udb_Grouping G2
      WHERE  G1.Member = :Device AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.GroupingType IN (SELECT Type 
                             FROM   Udb_ExtendedType 
                             WHERE  SuperType = :Type$Feeder) AND
             G1.Grouping = O.Object AND
             G1.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = :Substation  
      UNION
      SELECT DISTINCT 
             O.Object,
             O.Name
      FROM   Udb_Object O,
             Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Grouping G3
      WHERE  G1.Member = :Device AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.GroupingType IN (SELECT Type 
                             FROM   Udb_ExtendedType 
                             WHERE  SuperType = :Type$Line) AND
             G1.Grouping = O.Object AND
             G1.Grouping = G2.Grouping AND
             G2.MemberType = :Type$ACLineSegment AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Member = G3.Member AND
             G3.Relationship = :Interaction$MemberOf AND
             G3.Grouping = :Substation  
      BEGIN 
         i = i + 1;
      END;
   ELSE
      i = 1;
      REPEATED
      SELECT DISTINCT 
             :ObjectList[i].Object = O.Object,
             :ObjectList[i].Name = O.Name
      FROM   Udb_Object O,
             Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Grouping G3
      WHERE  G1.Member = :Device AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.GroupingType IN (SELECT Type 
                             FROM   Udb_ExtendedType 
                             WHERE  SuperType = :Type$Feeder) AND
             G1.Grouping = O.Object AND
             G1.Grouping = G2.Member AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Grouping = G3.Member AND
             G3.MemberType = :Type$Substation AND
             G3.Relationship = :Interaction$MemberOf AND
             G3.Grouping = :MacroStation
      UNION
      SELECT DISTINCT 
             O.Object,
             O.Name
      FROM   Udb_Object O,
             Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Grouping G3,
             Udb_Grouping G4
      WHERE  G1.Member = :Device AND
             G1.Relationship = :Interaction$MemberOf AND
             G1.GroupingType IN (SELECT Type 
                             FROM   Udb_ExtendedType 
                             WHERE  SuperType = :Type$Line) AND
             G1.Grouping = O.Object AND
             G1.Grouping = G2.Grouping AND
             G2.MemberType = :Type$ACLineSegment AND
             G2.Relationship = :Interaction$MemberOf AND
             G2.Member = G3.Member AND
             G3.Relationship = :Interaction$MemberOf AND
             G3.Grouping = G4.Member AND
             G4.MemberType = :Type$Substation AND
             G4.Relationship = :Interaction$MemberOf AND
             G4.Grouping = :MacroStation
      BEGIN 
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
END;

