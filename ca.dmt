============================

	Name:            ShowJobDetails

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          ShowJobDetails
**
**  Modifications:
**  04/01/99  em    Converted FMS ShowJobDetails
**  06/01/00  py    Make lock and combo field invisible for UserRole as Manager
**  11/05/02  pkw   Merge with FMS version of ShowJobDetails.
**  04/08/03  pkw   Link to FOD order screen if move part of FOD order.
**  07/15/03  ysp   Check the return code from FODOrder frame to close this
**                  frame automatically.  This allows DO to confirm returned
**                  FOD moves.
**  01/12/07  pkw   Add CurrentApplication when calling loadJobDetails. Fixes
**                  problem with closed cards.
**  12/30/08  em    Add Display of Generic Steam Operators
**  12/31/08  em    Add Display of different return by operator
*/

INITIALIZE
(
#  include StandardDeclarations
   J = Job;			/* Passed job */
   SimpleJob = Job_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
/*
** Use Steam Headings if appropriate
*/
   IF CurrentApplication = Application$SDS THEN
      FIELD(JD.TOMoveTitle).TextValue = 'ShutOff Move:';
      FIELD(JD.RSMoveTitle).TextValue = 'TurnOn Move:';
      FIELD(JD.TOOpTitle).TextValue = 'ShutOff Operator:';
      FIELD(JD.RSOpTitle).TextValue = 'TurnOn Operator:';
   ENDIF;
   
   FIELD(JD).SetToDefault();
/*
**  Read in the Job Details
*/
   IF SimpleJob IS NULL THEN
      SimpleJob = Job_ASE.Create();
   ENDIF;
     
   SimpleJob.Card = J.Card;
   SimpleJob.JD.Job = J.Job;
   SimpleJob.ArchiveCard = ArchiveCard;
   SimpleJob.Application = CurrentApplication;
    
   SimpleJob.LoadJobDetails();
   
   IF SimpleJob.ReturnCode <> 0 THEN
      Message SimpleJob.ErrorMessage;
   ENDIF;

   JD = SimpleJob.JD.Duplicate();
   SimpleJob = NULL;

   IF JD.AcknowledgedByFCR <> '' THEN
      FIELD(JD.AcknowledgedByFCR).ParentField.ParentField.CurBias = FB_LANDABLE;
      CurFrame.Flush();
      CurFrame.WindowHeight = 
                        STACKFIELD(FIELD(JD).ParentField).Height;
   ENDIF;

   IF JD.ShutOffOp <> '' THEN
      FIELD(JD.ShutOffOp).ParentField.CurBias = FB_LANDABLE;
   ENDIF;
   IF JD.TurnOnOp <> '' THEN
      FIELD(JD.TurnOnOp).ParentField.CurBias = FB_LANDABLE;
   ENDIF;
   IF JD.DiffShutOffOp <> '' THEN
      FIELD(JD.DiffShutOffOp).ParentField.CurBias = FB_LANDABLE;
   ENDIF;
   IF JD.DiffTurnOnOp <> '' THEN
      FIELD(JD.DiffTurnOnOp).ParentField.CurBias = FB_LANDABLE;
   ENDIF;
   
   i = 0;
   REPEATED
   SELECT :i = COUNT(*) 
   FROM    IR_FODOrderJobs
   WHERE   Job = :J.Job AND
           TORS = :Job$TakeOutInt;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      FIELD(JD.TOFOD_btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(JD.TOFOD_btn).CurBias = FB_INVISIBLE;
   ENDIF;
   
   i = 0;
   REPEATED
   SELECT :i = COUNT(*) 
   FROM    IR_FODOrderJobs
   WHERE   Job = :J.Job AND
           TORS = :Job$RestoreInt;
   CALLPROC DDB_ROLLBACK;
   
   IF i <> 0 THEN
      FIELD(JD.RSFOD_btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(JD.RSFOD_btn).CurBias = FB_INVISIBLE;
   ENDIF;

   IF UserRole = Role$Manager OR 
      UserRole = Role$Division THEN
      FIELD(JD.Combination).ParentField.CurBias = FB_INVISIBLE;
   ENDIF;   
   
   IF CurrentApplication = Application$FMS THEN
      FIELD(JD.EquipTemplateName).ParentField.CurBias = FB_INVISIBLE;  
   ENDIF;
END;


ON Entry JD.EquipTemplateName = 
BEGIN
    IF JD.EquipTemplateObject <> 0 THEN
       CALLFRAME EquipTemplates (ViewOnly = TRUE
                             ,SelectedTemplate = JD.EquipTemplateObject
                             ,SelectedTemplateName = JD.EquipTemplateName
                             );
    ENDIF;
END;

ON CLICK JD.TOFOD_btn =
BEGIN
   RetCode = CALLFRAME FODOrder(Job = J.Job,
                      TORS = Job$TakeoutInt);
   IF RetCode = PU_OK THEN
      RETURN;
   ENDIF;
END;

ON CLICK JD.RSFOD_btn =
BEGIN
   RetCode = CALLFRAME FODOrder(Job = J.Job,
                      TORS = Job$RestoreInt);
   IF RetCode = PU_OK THEN
      RETURN;
   ENDIF;
END;


ON CLICK Cancel =
BEGIN
   RETURN;
END;

ON DBEvent 'FMS_Card_Control_Taken',
ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Name:      item1

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            SkillClass


Application Component Report
============================

	Name:            SLC_RelaySummary

/*
**
**  Copyright c 1996 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
**
**  Application:    CAC
**  Frame:          SLC_RelaySummary
**
**  Modification log:
**
**  Date:     Version   Description 
** --------------------------------------------------        
**  11/10/96  ysp   Initial Version: modified for SLC          
**  04/02/97  jfl   itc39: Support for archived item
**                  Expected Mode for Archive Item is FM_READ
**  05/06/99  pkw   modified from SLC version
**  08/12/99  em    CardType field will not be populated for Archived Relays
**                  from SOA - and can disappear entirely when FMS is merged
**  09/10/03  pkw   Web-enable frame to load relay information.
**  08/18/05  em    Add Relay Targets returned from SSO
**  08/07/08  em    Add Card to Archive Job select
**  04/17/09  ysp   Prompt DO to select the SSO who returns the relay infor and insert log.
**  05/02/09  pkw   Added Bus Section Relay Targets section.
**  07/10/12  ysp   Replace internal field names for Backup Timer with FBMPRxxx.
**  05/13/15  pkw   Pass archive database if necessary
**  12/17/15  ysp   Pass blank for prod and test database to relay_report script
**  10/06/16  ysp   Enter the verbally returned relays in the same format as electronically returned relays.
**                  Add emailing reports to Transmission Operators.
**  11/21/16  ysp   Fix equipment list popup problem. And allow DO to type in equipment names.
**  09/09/22  ysp   replace vb script by powershell script that displays reports from FMS_ReportService web site.
*/

INITIALIZE   
(
   C = CardSLC;                                    /*P: Passed card */
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;  /*P:switching item */
   InsertRelay = INTEGER NOT NULL WITH DEFAULT;  /*P: set by PromptRelayTargetFromSSO */
) = 
DECLARE
#  include StandardDeclarations

   j = integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */
   k = integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */

   Activated = DATE;
   BSRelays = BusFaultOutageClass DEFAULT NULL;
   CurRelayEquip = CAC_Relay;  
   DataUpd = INTEGER NOT NULL WITH DEFAULT;
   ModifyFlag = VARCHAR(10) NOT NULL WITH DEFAULT;
   PDFTitle = VARCHAR(100) NOT NULL WITH DEFAULT;
   PDFLocation = Varchar(120) NOT NULL WITH DEFAULT;
   RowNum = INTEGER NOT NULL WITH DEFAULT;    /* Row Number */ 
   RelayOpList = ARRAY OF CAC_Relay; /*Array of existing relay operations */
   Relays = SSO_Relays_ASE DEFAULT NULL;
   SWMoveText = VARCHAR(160) NOT NULL WITH DEFAULT;
   
   Validate_BusSectionRelays = PROCEDURE RETURNING INTEGER;
   LoadStationEquipList = PROCEDURE;
   GeneratePDFFile = PROCEDURE RETURNING INTEGER NOT NULL;
ENDDECLARE
BEGIN
   IF ArchiveCard = FALSE THEN
      SELECT :SWMoveText = J.TOMove,
             :Activated = J.TOIssued
      FROM   SOA_Job J
      WHERE  J.Job = :SwitchingItem;
   ELSE
      SELECT :SWMoveText = J.TOMove,
             :Activated = J.TOIssued
      FROM   SOA_ArchiveJob J
      WHERE  J.Job = :SwitchingItem;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   PDFTitle = 'Relay Targets for ' + C.SubstationName + ' ' + SWMoveText + 
              ' on ' +  FormatDate (RawDate = IFNULL(Activated, ''), Format = 'DEFAULT');
   
   DataUpd = FALSE;
/*
** Get the SSO return Relays, 
*/
   Relays = SSO_Relays_ASE.Create();
   Relays.Card = C.Card;    
   Relays.ArchiveCard = ArchiveCard;
   Relays.SwitchingItem = SwitchingItem;
   RetCode = Relays.GetSSORelaysbyCard ();

   IF RetCode = 0 THEN
      FIELD(RT).CurBias = FB_INVISIBLE;
   ELSE
      RT.Clear();
      VRT.Clear();
      j = 1;
      k = 1;
      FOR i = 1 TO Relays.RT.LastRow DO
         IF Relays.RT[i].IsVerbal = TRUE THEN
            VRT[j] = Relays.RT[i].Duplicate();
            j = j + 1;
         ELSE
            RT[k] = Relays.RT[i].Duplicate();
            k = k + 1;
         ENDIF;
      ENDFOR;
      IF k = 1 THEN
         FIELD(RT).CurBias = FB_INVISIBLE;
      ENDIF;
   ENDIF;
/*
**  See if we should show Bus Section relay targets
*/
   BSRelays = BusFaultOutageClass.Create();
   RetCode = BSRelays.LoadRelays(SwitchingItem = SwitchingItem);
   IF RetCode <> 0 THEN
      BS = BSRelays.Duplicate();
      FIELD(BS.FTFeeder).ValueList = BSRelays.FTList.Duplicate();
      FIELD(BS.FTFeeder).CurEnumValue = BSRelays.FTFeeder;
      FIELD(BS.BDLastUpd).MouseMoveText = BS.BDLastUpdBy;
      /* Backup Timer fields replaced by FB Bkr MPR fields 
      FIELD(BS.BUTLastUpd).MouseMoveText = BS.BUTLastUpdBy;
      */
      FIELD(BS.FBMPRTime).MouseMoveText = BS.FBMPRUpdBy;      
      FIELD(BS.BOCLastUpd).MouseMoveText = BS.BOCLastUpdBy;
      FIELD(BS.FTLastUpd).MouseMoveText = BS.FTLastUpdBy;

      /*  Don't show Other Relays */
      FIELD(OtherRelays).CurBias = FB_INVISIBLE;
      IF ArchiveCard = TRUE THEN 
         FIELD(BS).ParentField.ParentField.CurBias = FB_VISIBLE;       
      ENDIF;
   ELSE
      FIELD(BS).ParentField.ParentField.CurBias = FB_INVISIBLE;
   ENDIF;

/* load the equip table which allow users to enter verbally returned relays */
   CALLPROC LoadStationEquipList();

   CurFrame.SendUserEvent (EventName = 'load_old_data');
   CurFrame.SendUserEvent (EventName = 'position_popup');
   IF InsertRelay = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'InsertRelay');
   ENDIF;
END;

ON UserEvent 'load_old_data' =
DECLARE
   SimpleRelay = Relay_ASE DEFAULT NULL; /* Enables use of class methods */
ENDDECLARE
BEGIN
/* clear the list of relays which operated. */
    RelayOpList.Clear(); 

/* clear the three user-interface tables: 1) TIME & INST., 2) Other Dist., 
** 3) Other Relay
*/
    TIDistributionRelays.Clear(); 
    OtherDistributionRelays.Clear();
    OtherRelays.Clear();

   /*
   **  Show old style of relay if user is looking at pre-2016 winter card.
   */
   IF SimpleRelay IS NULL THEN
      SimpleRelay = Relay_ASE.Create();
   ENDIF;
     
   SimpleRelay.Card = C.Card;    
   SimpleRelay.ArchiveCard = ArchiveCard;
   SimpleRelay.CardType = Type$SLCApp;
   SimpleRelay.SwitchingItem = SwitchingItem;
   SimpleRelay.UpdateMode = 1;  /* Always load all data */
    
   SimpleRelay.LoadRelaySummary();
   
   IF SimpleRelay.ReturnCode <> 0 THEN
      Message SimpleRelay.ErrorMessage;
      RESUME;
   ENDIF;

   RelayOpList  = SimpleRelay.ROpList.Duplicate();

   TIDistributionRelays = SimpleRelay.RSDist.Duplicate();   
   OtherDistributionRelays = SimpleRelay.RSOtherDist.Duplicate();
   OtherRelays = SimpleRelay.RSOther.Duplicate();

   SimpleRelay = NULL;

   IF TIDistributionRelays.LastRow = 0 THEN
      FIELD(TIDistributionRelays).CurBias = FB_INVISIBLE;
   ENDIF;
   IF OtherDistributionRelays.LastRow = 0 THEN
      FIELD(OtherDistributionRelays).CurBias = FB_INVISIBLE;
   ENDIF;
   IF OtherRelays.LastRow = 0 THEN
      FIELD(OtherRelays).CurBias = FB_INVISIBLE;
   ENDIF;
   
   CurFrame.BringToFront();
   CurFrame.Flush();   
   CurFrame.IsAutoSized = TRUE;
   CurFrame.Flush();
END;

ON USEREVENT 'position_popup' = 
BEGIN
   i = (Field(WA).OuterWidth -Field(WA).Width)/2;
   Field(WA).AbsYBottom = Field(Delete_Relay_Btn).AbsYBottom;
   Field(WA).AbsXLeft = Field(VRT).AbsXLeft - StackField(Field(wa)).ChildLeftMargin - i;

   Field(Equip_SF).AbsYTop = Field(WA.TF).TableHeader.AbsYBottom;
   Field(Equip_SF).AbsXLeft = Field(WA.TF).TableHeader.ChildFields[3].AbsXLeft - i;
END;

/* =========================================================================== */
ON InsertRow VRT,
ON UserEvent 'InsertRelay',
ON Click Insert_Relay_Btn =
BEGIN
   IF CurFrame.TriggerField IS NOT NULL THEN
      IF lowercase(Curframe.Triggerfield.Name) <> 'insert_relay_btn' THEN
         VRT.RemoveRow(RowNumber = VRT.LastRow);
      ENDIF;
   ENDIF;   
/*
** Clear table and insert new row
*/
   WA.TF.Clear();
   WA.TF.InsertRow(RowNumber = 1);
   WA.TF[1].TimeStamp = 'now';
   WA.TF[1].Job = SwitchingItem;
/*
** Only allow them work in workarea
*/
   Field(OK_btn).ParentField.CurBias = FB_VISIBLE;
   Field(WA).Curbias = FB_CHANGEABLE;
   
   WA.TF[1].Substation = C.Substation;
   WA.TF[1].SubstationName = C.SubstationName;

   ModifyFlag = 'Insert';
END;

ON Click Update_Relay_Btn =
BEGIN
/*
** Find which row we are updating
*/ 
   RowNum = 0;
   RowNum = Field(VRT).CurRow;
   IF RowNum = 0 THEN
      message 'You must select which relay you want to modify.';
      RESUME;
   ENDIF;

/* 
** Clear table and insert new row
*/ 
   WA.TF.Clear();
   WA.TF.InsertRow(RowNumber = 1, RowObject = VRT[RowNum].Duplicate());
   WA.TF[1].TimeStamp = 'now';
/* 
** Only allow them work in workarea
*/ 
   Field(OK_btn).ParentField.CurBias = FB_Visible;
   CurFrame.Flush();
   Field(WA).Curbias = FB_CHANGEABLE;
   
   ModifyFlag = 'Update';
END;

ON Click Delete_Relay_Btn =
BEGIN
/*
** Find which row we are deleting
*/
   RowNum = 0;
   RowNum = Field(VRT).CurRow;
   IF RowNum = 0 THEN
      message 'You must select which relay you want to delete.';
      RESUME;
   ENDIF;
/*
** Delete row from table and database.
*/
   IF CurFrame.ConfirmPopup (MessageText = 'Deleting Relay:  ' +
               VRT[RowNum].RelayName) = PU_OK THEN

      RetCode = CALLPROC IR_RelayTargetDel(
                                   Job = VRT[RowNum].Job,
                                   Sequence = VRT[RowNum].Sequence);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Not able to remove relay.  Please try again.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;
      VRT.RemoveRow(rownumber = RowNum);
   ENDIF;
END;

ON Click WA.OK_Btn =
BEGIN
   IF WA.TF[1].RelayName = '' THEN
      message 'You must enter a Relay name.';
      RESUME;
   ENDIF;
   IF WA.TF[1].Sequence = 0 THEN
      SELECT WA.TF[1].Sequence = IFNULL(Max(Sequence),0) + 1
      FROM   IR_RelayTargets RT,
             SOA_JobControl JC
      WHERE  JC.Card = :C.Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.Job = RT.Job;
   ENDIF;
/* 
** Insert/Update row in DB
*/ 
   RetCode = CALLPROC IR_RelayTargetIns (
                                     Job = WA.TF[1].Job
                                    ,Substation = WA.TF[1].Substation          
                                    ,SubstationName = WA.TF[1].SubstationName          
                                    ,RelayName = WA.TF[1].RelayName     
                                    ,Line = WA.TF[1].Line          
                                    ,TypeA = WA.TF[1].TypeA
                                    ,TypeB = WA.TF[1].TypeB
                                    ,TypeC = WA.TF[1].TypeC
                                    ,TypeTime = WA.TF[1].TypeTime
                                    ,TypeInst = WA.TF[1].TypeInst
                                    ,TypeText = WA.TF[1].TypeText 
                                    ,Equipment = WA.TF[1].Equipment         
                                    ,isVerbal = TRUE 
                                    ,Sequence = WA.TF[1].Sequence     
                                    ,Comment = WA.TF[1].Comment   
                                    ,TimeStamp = WA.TF[1].TimeStamp);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Failed to Insert/Update Relay Target, please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   IF ModifyFlag = 'Insert' THEN
      i = VRT.LastRow() + 1;
      VRT.InsertRow(RowNumber = i, RowObject = WA.TF[1].Duplicate());
      DataUpd = TRUE;
   
   ELSEIF ModifyFlag = 'Update' THEN
      VRT[RowNum] = WA.TF[1].Duplicate();
   ENDIF;

    Field(OK_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
END;

ON Click WA.Cancel_Btn =
BEGIN
    Field(OK_btn).ParentField.CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_INVISIBLE;
END;

ON ChildEntry WA.TF[*].Line = 
BEGIN
   IF WA.TF[1].Line = '' THEN
      WA.TF[1].Line = '1ST';
   ELSEIF WA.TF[1].Line = '1ST' THEN
      WA.TF[1].Line = '2ND';
   ELSEIF WA.TF[1].Line = '2ND' THEN
      WA.TF[1].Line = '';
   ENDIF;
   CurFrame.InputFocusField = FIELD(WA.Cancel_btn);
END;

ON ChildEntry WA.TF[*].Equipment = 
BEGIN    
    Field(Equip_SF).CurBias = FB_CHANGEABLE;
    Field(WA).Curbias = FB_VISIBLE;
    Equip_SF.EquipName = WA.TF[1].Equipment;
END;

ON ChildEntry Equip_SF.StationEquipList =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;
    i = Field(Equip_SF.StationEquipList).CurRow;
   
    Equip_SF.EquipName = Equip_SF.StationEquipList[i].EquipName;
END;

ON Click Equip_SF.OK_Btn = 
BEGIN    
    Field(Equip_SF).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;

    WA.TF[1].Equipment = Equip_SF.EquipName;
END;

ON Click Equip_SF.Cancel_Btn = 
BEGIN
    Field(Equip_SF).CurBias = FB_INVISIBLE;
    Field(WA).Curbias = FB_CHANGEABLE;
END;
/* =========================================================================== */      

ON SetValue bs.BDPhaseA,
ON SetValue bs.BDPhaseB,
ON SetValue bs.BDPhaseC,
ON SetValue bs.BDRelayName =
BEGIN
   bs.BDLastUpd = date('now');
   FIELD(bs.BDLastUpd).MouseMoveText = Dop.Description;
   bs.BDLastUpdBy = Dop.Description;
   bs.BDHasDataChanged = TRUE;
END;

ON SetValue bs.BOCPhaseA,
ON SetValue bs.BOCPhaseB,
ON SetValue bs.BOCPhaseC,
ON SetValue bs.BOCPhaseN,
ON SetValue bs.BOCRelayName =
BEGIN
   bs.BOCLastUpd = date('now');
   FIELD(bs.BOCLastUpd).MouseMoveText = Dop.Description;
   bs.BOCLastUpdBy = Dop.Description;
   bs.BOCHasDataChanged = TRUE;
END;

ON SetValue bs.FBMPR,
ON SetValue bs.FBMPRValue =
BEGIN
   bs.FBMPRTime = date('now');
   FIELD(bs.FBMPRTime).MouseMoveText = Dop.Description;
   bs.FBMPRUpdBy = Dop.Description;
   bs.FBMPRHasDataChanged = TRUE;
END;

ON SetValue bs.FTPhaseA,
ON SetValue bs.FTPhaseB,
ON SetValue bs.FTPhaseC,
ON SetValue bs.FTPhaseN,
ON SetValue bs.FTRelayName,
ON SetValue bs.FTFeeder =
BEGIN
   bs.FTLastUpd = date('now');
   FIELD(bs.FTLastUpd).MouseMoveText = Dop.Description;
   bs.FTLastUpdBy = Dop.Description;
   bs.FTHasDataChanged = TRUE;
END;

ON CLICK Menu.File.Close_btn,
ON Click OK_Btn =
BEGIN
   RetCode = CALLPROC Validate_BusSectionRelays();
   IF RetCode <> 0 THEN
      RESUME;
   ENDIF;

/*
**  Update Bus Section Relay Targets
*/
   IF bs.BDHasDataChanged = TRUE THEN
      IF bs.BDLastUpd = '' THEN
         bs.BDLastUpd = date('now');
         bs.BDLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBusDiffUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BDPhaseA = bs.BDPhaseA,
                       BDPhaseB = bs.BDPhaseB,
                       BDPhaseC = bs.BDPhaseC,
                       BDRelayName = bs.BDRelayName,
                       BDLastUpd = bs.BDLastUpd,
                       BDLastUpdBy = bs.BDLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Bus Differential information.',
                  TraceMessage =
            'DIS_RelaySummary frame: ' +
            'Unable to update Bus Differential information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
   
   IF bs.BOCHasDataChanged = TRUE THEN
      IF bs.BOCLastUpd = '' THEN
         bs.BOCLastUpd = date('now');
         bs.BOCLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBusOCUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BOCPhaseA = bs.BOCPhaseA,
                       BOCPhaseB = bs.BOCPhaseB,
                       BOCPhaseC = bs.BOCPhaseC,
                       BOCPhaseN = bs.BOCPhaseN,
                       BOCRelayName = bs.BOCRelayName,
                       BOCLastUpd = bs.BOCLastUpd,
                       BOCLastUpdBy = bs.BOCLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Bus Over Current information.',
                  TraceMessage =
            'DIS_RelaySummary frame: ' +
            'Unable to update Bus Over Current information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;    
   ENDIF;
   
   IF bs.FBMPRHasDataChanged = TRUE THEN
      /*
      IF bs.BUTLastUpd = '' THEN
         bs.BUTLastUpd = date('now');
         bs.BUTLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFBackupTimerUpd(
                       SwitchingItem = bs.SwitchingItem,
                       BUTOperated = bs.BUTOperated,
                       BUTRelayName = bs.BUTRelayName,
                       BUTLastUpd = bs.BUTLastUpd,
                       BUTLastUpdBy = bs.BUTLastUpdBy
                       );
      */                 
      IF bs.FBMPRTime = '' THEN
         bs.FBMPRTime = date('now');
         bs.FBMPRUpdBy = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFFBMPRUpd(
                       SwitchingItem = bs.SwitchingItem,
                       FBMPR = bs.FBMPR,
                       FBMPRValue = bs.FBMPRValue,
                       FBMPRTime = bs.FBMPRTime,
                       FBMPRUpdBy = bs.FBMPRUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Backup Timer information.',
                  TraceMessage =
            'DIS_RelaySummary frame: ' +
            'Unable to update Backup Timer information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;   
   ENDIF;
   
   IF bs.FTHasDataChanged = TRUE THEN
      IF bs.FTLastUpd = '' THEN
         bs.FTLastUpd = date('now');
         bs.FTLastUpdby = DOP.Description;
      ENDIF;
      RetCode = CALLPROC SOA_BFFeederTargetUpd(
                       SwitchingItem = bs.SwitchingItem,
                       FTFeeder = bs.FTFeeder,
                       FTPhaseA = bs.FTPhaseA,
                       FTPhaseB = bs.FTPhaseB,
                       FTPhaseC = bs.FTPhaseC,
                       FTPhaseN = bs.FTPhaseN,
                       FTRelayName = bs.FTRelayName,
                       FTLastUpd = bs.FTLastUpd,
                       FTLastUpdBy = bs.FTLastUpdBy
                       );
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
            'ERROR: Unable to update Feeder Target information.',
                  TraceMessage =
            'DIS_RelaySummary frame: ' +
            'Unable to update Feeder Target information for Bus Section ' +
             bs.BusSectionName + '.');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

/*
** log the substation operator
*/
   IF DataUpd = TRUE THEN
      RetCode = CALLFRAME SelectOperator (AnyName = TRUE, 
                                       Title = 'Select Substation Operator who Reports Relay Targets');
      IF RetCode = PU_OK THEN
         CALLPROC SOA_LogIns (
                Card = C.Card,
                Job  = NULL,
                SwitchingItem = SwitchingItem,
                Time = DATE('Now'), 
                UserName = UserName,
                Item = 'Relays',
                Old  = '',
                New  = FO.Description + ' returned relay information');   
      ENDIF;
   ENDIF;
   RETURN;
END;

ON DBEvent 'CAC_RelayOp_Update' =
DECLARE
   FoundIt = SMALLINT NOT NULL WITH DEFAULT;
   x = integer NOT NULL WITH DEFAULT;
   y = integer NOT NULL WITH DEFAULT;
   TempString = VARCHAR(40);  
ENDDECLARE
BEGIN
/*
**  Parse out the necessary information from the event text.
**  The event text is separated by ';' and may contain Action 
**  description (insert, update, delete), RelayOp index and
**  a list of cards.
*/
   ControlText = CurFrame.DBEvent.DBEventText;

   TempString = left(controltext,(locate(controltext,';')-1));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   x = int4(left(controltext,(locate(controltext,';')-1)));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   Foundit = FALSE;
   i = locate(ControlText,';');
   WHILE i <= size(ControlText) DO
       ControlCard = int4(left(ControlText,(locate(controltext,':')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,':'))));

       y = int4(left(ControlText,(locate(controltext,';')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

       IF ControlCard = C.Card AND y = Type$SLCApp THEN
          Foundit = TRUE;
          ENDLOOP;
       ELSE
          i = locate(ControlText,';');
       ENDIF;
   ENDWHILE;
/*
** If our card is not in the card list or the relay is not in our
** switchingitem,  it has nothing to do with us. Quit.
*/
   IF Foundit = FALSE THEN
      RESUME;
   ENDIF;

   i = 0;
   SELECT :i = Count(*)
   FROM   CAC_RelayOpsControl RC
   WHERE  RC.RelayOp = :x
     AND  RC.CardType = :Type$SLCApp
     AND  RC.Card = :C.Card
     AND  RC.SwitchingItem = :SwitchingItem;
   CALLPROC DDB_ROLLBACK;

   IF i = 0 THEN
      RESUME;
   ENDIF;
/* 
** As long as the request is not to delete, retrieve new data from database 
*/
   IF TempString not like 'DELETE' THEN
      REPEATED
      SELECT :CurRelayEquip.RelayOp = R.RelayOp,
             :CurRelayEquip.Trip = R.Trip,
             :CurRelayEquip.Line = R.Line,
             :CurRelayEquip.FeederName = R.FeederName,
             :CurRelayEquip.Equip = R.Equip,
             :CurRelayEquip.EquipName = R.EquipName,
             :CurRelayEquip.EquipClass = R.EquipClass,
             :CurRelayEquip.EquipClassName = R.EquipClassName,
             :CurRelayEquip.RelayType = R.RelayType,
             :CurRelayEquip.RelayTypeName = R.RelayTypeName,
             :CurRelayEquip.RelayClass = R.RelayClass,
             :CurRelayEquip.RelayClassName = R.RelayClassName,
             :CurRelayEquip.RelayName = R.RelayName,
             :CurRelayEquip.Operation = R.Operation,
             :CurRelayEquip.TimeStamp = R.TimeStamp,
             :CurRelayEquip.OutOfService = R.OutOfService,
             :CurRelayEquip.Compromised = R.Compromised,
             :CurRelayEquip.Status = ''
      FROM    CAC_RelayOps R
      WHERE   R.RelayOp = :x;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   Foundit = FALSE;
   i = 1; 
   WHILE i <= RelayOpList.LastRow() DO
      IF RelayOpList[i].RelayOp = x THEN
         Foundit = TRUE;
         ENDLOOP;
      ELSE
         i = i + 1;
      ENDIF;
   ENDWHILE;
/*
** Find out which table needs to be updated. y points to the table.
*/
   y = 0;
   IF Foundit = TRUE THEN
      IF RelayOpList[i].GenericInt1 = 1 THEN
         y = 1;
      ELSEIF RelayOpList[i].GenericInt1 = 2 THEN
         y = 2;
      ELSEIF RelayOpList[i].GenericInt1 = 3 THEN
         y = 3;
      ENDIF;
   ELSEIF CurRelayEquip.Line <> -1 THEN
      y = 3;
   ELSEIF CurRelayEquip.Line = -1 AND
          CurRelayEquip.Operation = RelayOp$Normal THEN
      y = 2;
   ELSEIF CurRelayEquip.Line = -1 THEN
      y = 1;
   ENDIF;

/* Update list RelayOpList */
   IF TempString like 'INSERT' THEN   
      i = RelayOpList.LastRow() + 1;
      RelayOpList.InsertRow( RowNumber = i,
                          RowObject = CurRelayEquip.Duplicate());
      RelayOpList[i].Status = 'Upd';   /* already updated in one table */
      RelayOpList[i].GenericInt1 = y;

   ELSEIF TempString like 'UPDATE' THEN 
      RelayOpList[i] = CurRelayEquip.Duplicate();
      RelayOpList[i].GenericInt1 = y;
      RelayOpList[i].Status = 'Upd';   /* already updated in one table */

   ELSEIF TempString like 'DELETE' THEN   
      RelayOpList.RemoveRow (RowNumber = i);
   ENDIF;
/*
** Now we can work on each table per request.
*/
/*--------------------------------- table 1 ---------------------------------*/
   IF y = 1 THEN
      /* update visual table */
      i = 1;
      WHILE i <= TIDistributionRelays.LastRow() DO
         IF (CurRelayEquip.FeederName = TIDistributionRelays[i].FeederName AND
             CurRelayEquip.Equip = TIDistributionRelays[i].Equip AND
             CurRelayEquip.RelayType = TIDistributionRelays[i].RelayType ) THEN
             ENDLOOP;
         ELSE
             i = i + 1;
         ENDIF;
      ENDWHILE; 
      
      IF i > TIDistributionRelays.LastRow() THEN
         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            i = TIDistributionRelays.LastRow() + 1;
            TIDistributionRelays.InsertRow( 
                                    RowNumber = i,
                                    RowObject = CurRelayEquip.Duplicate());
            TIDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            TIDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            TIDistributionRelays[i].Operation = CurRelayEquip.Operation;

            IF CurRelayEquip.Operation = RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = FALSE;
               TIDistributionRelays[i].GenericInt2 = TRUE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = FALSE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous + RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = TRUE;
            ENDIF;
         ELSEIF TempString like 'DELETE' THEN
         ENDIF;
      ELSE
         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            TIDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            TIDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            TIDistributionRelays[i].Operation = CurRelayEquip.Operation;

            IF CurRelayEquip.Operation = RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = FALSE;
               TIDistributionRelays[i].GenericInt2 = TRUE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = FALSE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous + RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = TRUE;
            ENDIF;
         ELSEIF TempString like 'DELETE' THEN
            TIDistributionRelays[i].RelayOp = -1;
            TIDistributionRelays[i].TimeStamp = '';
            TIDistributionRelays[i].Operation = RelayOp$None;
            TIDistributionRelays[i].GenericInt1 = FALSE;
            TIDistributionRelays[i].GenericInt2 = FALSE;
         ENDIF;
      ENDIF;
/*------------------------------ table 2 ---------------------------------*/
   ELSEIF y = 2 THEN
      /* update visual table */
      i = 1;
      WHILE i <= OtherDistributionRelays.LastRow() DO
         IF (CurRelayEquip.FeederName = OtherDistributionRelays[i].FeederName AND
             CurRelayEquip.Equip = OtherDistributionRelays[i].Equip AND
             CurRelayEquip.RelayType = OtherDistributionRelays[i].RelayType ) THEN

             ENDLOOP;
         ELSE
             i = i + 1;
         ENDIF;
      ENDWHILE; 
      
      IF i > OtherDistributionRelays.LastRow() THEN
         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            i = OtherDistributionRelays.LastRow() + 1;
            OtherDistributionRelays.InsertRow(RowNumber = i,
                                              RowObject = CurRelayEquip.Duplicate());
            OtherDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            OtherDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            OtherDistributionRelays[i].Operation = CurRelayEquip.Operation;
            OtherDistributionRelays[i].GenericInt1 = TRUE;
            OtherDistributionRelays[i].GenericInt2 = FALSE;

         ELSEIF TempString like 'DELETE' THEN
         ENDIF;
      ELSE
         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            OtherDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            OtherDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            OtherDistributionRelays[i].Operation = CurRelayEquip.Operation;
            OtherDistributionRelays[i].GenericInt1 = TRUE;
            OtherDistributionRelays[i].GenericInt2 = FALSE;

         ELSEIF TempString like 'DELETE' THEN
            OtherDistributionRelays[i].RelayOp = -1;
            OtherDistributionRelays[i].TimeStamp = '';
            OtherDistributionRelays[i].Operation = RelayOp$None;
            OtherDistributionRelays[i].GenericInt1 = FALSE;
            OtherDistributionRelays[i].GenericInt2 = FALSE;
         ENDIF;
      ENDIF;
/*------------------------------ table 3 ---------------------------------*/
   ELSEIF y = 3 THEN
      IF TempString like 'UPDATE' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherRelays[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i > OtherRelays.LastRow() THEN
            Message 'A relay entry not found in Other table.';
            RESUME;
         ELSE
            OtherRelays[i] = CurRelayEquip.Duplicate();
         ENDIF;

      ELSEIF TempString like 'INSERT' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.Line = OtherRelays[i].Line AND
                CurRelayEquip.RelayType = OtherRelays[i].RelayType AND
                CurRelayEquip.RelayName = OtherRelays[i].RelayName )THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i <= OtherRelays.LastRow() THEN
         ELSE
            OtherRelays.InsertRow (RowNumber = i, 
                                   RowObject = CurRelayEquip.Duplicate());
         ENDIF;   

      ELSEIF TempString like 'DELETE' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherRelays[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i <= OtherRelays.LastRow() THEN
            OtherRelays.RemoveRow (RowNumber = i);
         ENDIF;
      ENDIF;
   ENDIF;

   RESUME;
END;


