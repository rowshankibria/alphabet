Application Component Report
============================

	Name:            SuspectTest

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          SuspectTest
**
**  01/16/93  mts   Frame created             
**  01/17/93  gjc   Added accept button & logic to activate it if Ammeter
**                  Clear Test.
**  05/09/94  mts   Removed logic that differentiates between ammeterclear & Hipot tests.
**  06/04/94  mts   Added flag to hide accept button if failed at lower level
**  06/27/01  em    If an OpOrder Failure, then disable Cancel button
**  01/14/02  em    Added Rapid Restore Discontinue capability (temporary until
**                  RR data transferred to FOT.
**  08/16/02  em    Add "No FOT" button to continue processing without creating
**                  an FOT and without inserting results into test history.
**  08/03/08  ysp   FMS 382: if there are outstanding operating orders, prevent 
**                  the DO from creating an FOT card.
**  12/06/10  em    If on a KPSFeeder, want to disable ability to create FOT
**  01/03/13  ysp   there are still returned moves to confirm, notify DO that FOT card will be created 
**                  after all moves are confirmed
*/

INITIALIZE
(
    C = FMS_Card;                      /*passed card info*/
    text = varchar(100) NOT NULL WITH DEFAULT; /* informational text can be passed to this frame */
    FailedAtLowerLevel = Integer not null;  /* passed flag */
    OpOrderFailure = INTEGER NOT NULL WITH DEFAULT; /*Passed BOOLEAN*/
    KPSFeeder = INTEGER NOT NULL WITH DEFAULT; /*Passed BOOLEAN*/

    OpOrders = INTEGER NOT NULL WITH DEFAULT;        
    RRIssues = INTEGER NOT NULL WITH DEFAULT; 
) =
BEGIN
/*
** Check if there are any Rapid Restore issues before we allow a FOT card to
** be generated.
*/
    RRIssues = 0;
    REPEATED
    SELECT :RRIssues = 1
    FROM   SOA_Job J,
           SOA_JobControl JC,
           IR_WorkPermit WP
    WHERE  JC.Card = :C.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.RSComplete IS NULL AND
           J.Job = WP.WorkPermit;
/*
** check if there are outstanding operating orders on this card. We don't
** need to check for FOD orders because the codes that create FOT transfer card 
** handle the transfer of FOD orders to the new card.
*/
    OpOrders  = 0;	
    REPEATED
    SELECT :OpOrders = COUNT(O.OrderNumber)
    FROM   IR_OperatingOrder O
    WHERE  O.Card = :C.Card AND
           O.OrderStatus < :Order$Closed;
    CALLPROC DDB_ROLLBACK;

    If FailedAtLowerLevel = TRUE Then
         FIELD(Accept_Btn).CurBias = FB_INVISIBLE;
    Endif;

    IF OpOrderFailure = TRUE THEN
       FIELD(cancel_btn).CurBias = FB_INVISIBLE;
    ENDIF;  

    IF text is NULL or text = '' THEN
       FIELD(MessageText).CurBias = FB_INVISIBLE;
    ELSE
       MessageText = Text;
    ENDIF;
 
    IF OpOrders > 0 THEN
       FIELD(OpOrder_text).CurBias = FB_VISIBLE;
       FIELD(RR_text).CurBias = FB_INVISIBLE;
       FIELD(CreateFOT).CurBias = FB_INVISIBLE;
       FIELD(RRConsiderations).CurBias = FB_LANDABLE;

    ELSEIF RRIssues = 1 THEN
       FIELD(OpOrder_text).CurBias = FB_INVISIBLE;
       FIELD(RR_text).CurBias = FB_VISIBLE;
       FIELD(CreateFOT).CurBias = FB_LANDABLE;
       FIELD(RRConsiderations).CurBias = FB_LANDABLE;

    ELSE
       FIELD(OpOrder_text).CurBias = FB_INVISIBLE;
       FIELD(RR_text).CurBias = FB_INVISIBLE;
       FIELD(RRConsiderations).CurBias = FB_INVISIBLE;
    ENDIF;       

    IF KPSFeeder = TRUE THEN
       FIELD(CreateFOT).CurBias = FB_INVISIBLE;
    ENDIF;
END;

ON CLICK Accept_Btn =
   BEGIN
       RETURN(FailTest$Accept);
   END;

ON Click CreateFOT = 
BEGIN
   /*
   ** if there are still returned moves to confirm, notify DO that
   ** FOT card will be created after all moves are confirmed.
   */
   IF OrderReturnStatus IS NOT NULL THEN
      IF OrderReturnStatus.MovesToConfirm() = TRUE THEN
         OrderReturnStatus.DelayFOT = TRUE;
 
         CALLPROC TraceError (UserMessage =
          'You still have outstanding moves in this order to confirm. The transfer to an FOT card ' + 
          'will be postponed until all moves are confirmed. It will be initiated automatically when ' + 
          'exiting the Return Moves screen.',
          TraceMessage = 
          'SuspectTest: transfer to a FOT card ' + 
          'is delayed for operating order: ' + VARCHAR(OpOrderFailure));
      ENDIF;
   ENDIF; 

   RETURN(PU_OK);
END;

ON Click NoFOT = 
   BEGIN
       RETURN(FailTest$NoFOT);
   END;

ON CLICK CANCEL_BTN =
   BEGIN
       RETURN(PU_CANCEL);
   END;

ON CLICK RRConsiderations =
   BEGIN
       RETURN(FailTest$RRConsideration);
   END;

ON WindowClose = 
BEGIN
   RESUME;
END;

