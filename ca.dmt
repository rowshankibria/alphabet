	Name:            CheckHighVoltageOK

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckHighVoltageOK 
**
**  Modifications:
**  11/03/92 em	    Created 
**  02/05/93 em     removed call to check cautiononfeeder.
**  11/19/02 ysp    Merge: removed passed-in C and Jobs
**  01/22/03 ysp    Remove CardDetails. Instead get all cards from the database.
**  02/28/03 pkw    Use DISTINCT against SOA_ActiveCard for feeder
**                  that span divisions.
**  03/03/03 ysp    check for Override return code from DeadMoveTakeOut proc.
**  08/10/16 ysp    For 33kv portion card, prepend main feeder name to the portion name in messages 
**  03/12/18 pkw    If MTAOpen = TRUE and equip is downstream of MTA Iso switch don't display warning.
**  11/07/18 pkw    If MicroGridOpen = TRUE and equip is downstreamfrom MicroGrid Line switch don't 
**                  display warning.
*/
PROCEDURE CheckHighVoltageOK 
(
    JIP = JobInProgress;				/* Job being processed */
) =
DECLARE    
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;
    WarningStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    ActiveCards = ARRAY OF FMS_Card;
    i = INTEGER NOT NULL;
    SkipWarning = INTEGER NOT NULL;
    FirstTime = INTEGER NOT NULL;
ENDDECLARE
BEGIN
 
  WarningStatus = PU_OK;
  RetCode = NULL;

  i = 1;
  REPEATED 
  SELECT DISTINCT
         :ActiveCards[i].Card = C.Card,
         :ActiveCards[i].Feeder = C.Feeder,
         :ActiveCards[i].FeederName = C.FeederName,
         :ActiveCards[i].StationGround = C.StationGround,
         :ActiveCards[i].GroundsOn = C.GroundsOn,
         :ActiveCards[i].NetworkFeeder = C.NetworkFeeder,
         :ActiveCards[i].TypeOfCard = C.TypeOfCard
  FROM   FMS_Card C,
         SOA_ActiveCard AC,
         SOA_JobControl JC
  WHERE  JC.Job = :JIP.Job AND
         JC.Card = AC.Card AND
         AC.Card = C.Card
  BEGIN
     i = i + 1;
  END;

  i = 1;
  FirstTime = TRUE;

  WHILE i <= ActiveCards.LastRow() DO
    FeederName = ActiveCards[i].GetGeneralCardName();    
/*  
**  If station ground is only ground and dead moves taken out, all okay.
*/
    IF ActiveCards[i].StationGround = 'On' AND ActiveCards[i].GroundsOn = 1 THEN
    
       /* To avoid duplicate warnings from the called procedure 
       */
       IF FirstTime = TRUE THEN
          WarningStatus = CALLPROC CheckDeadMovesTakenOut (JIP = JIP);
          IF WarningStatus = PU_CANCEL THEN
             RETURN(PU_Cancel);
          ELSEIF WarningStatus = Warning$Overridden THEN
             RetCode = WarningStatus;
          ENDIF;
          FirstTime = FALSE;
       ENDIF;
 
    ELSEIF ActiveCards[i].StationGround <> 'On' THEN
       /*
       **  Don't display warning if MTAOpen = TRUE and equipment is downstream
       **  of MTA Isolation switch.
       */
       IF MTAOpen = TRUE THEN
          SkipWarning = FALSE;
          SELECT :SkipWarning = :TRUE 
          FROM   Udb_Grouping G,
                 Udb_ExtendedType ET
          WHERE  G.Member = :JIP.Equip AND
                 G.Relationship = :Interaction$MTADownstreamOf AND
                 G.Groupingtype = ET.Type AND
                 ET.SuperType = :Type$Switch;
       /*
       **  Don't display warning if MicroGridOpen = TRUE and equipment is downstreamfrom
       **  Micro Grid Line switch.
       */
       ELSEIF MicroGridOpen = TRUE THEN
          SkipWarning = FALSE;
          SELECT :SkipWarning = :TRUE 
          FROM   Udb_Grouping G,
                 Udb_Grouping G2,
                 Udb_ExtendedType ET
          WHERE  G.Member = :JIP.Equip AND
                 G.Relationship = :Interaction$DownstreamFrom AND
                 G.Grouping = G2.Member AND
                 G2.Relationship = :Interaction$MicroGridFor AND
                 G2.GroupingType = ET.Type AND
                 ET.SuperType = :Type$Feeder;
       ENDIF;
       IF SkipWarning = TRUE THEN
          /* do nothing */
       ELSE
          WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
                                          Job = JIP.Job,
                                          SwitchingItem = JIP.SwitchingItem,
                                          Text = 'Feeder ' + FeederName + 
                                                 ' is NOT grounded.');
          IF WarningStatus = PU_CANCEL THEN
             RETURN(PU_CANCEL);
          ELSE
             RetCode = Warning$Overridden;
          ENDIF;
       ENDIF;
    ELSE
       WarningStatus = CALLFRAME Warning (Card = JIP.Card, 
                                          Job = JIP.Job,
                                          SwitchingItem = JIP.SwitchingItem,
                                          Text = 'There are still field grounds ' +
                                          'applied on feeder ' + FeederName + '.');
       IF WarningStatus = PU_CANCEL THEN
          RETURN(PU_CANCEL);
       ELSE
          RetCode = Warning$Overridden;
       ENDIF;

    ENDIF; 
    
    i = i + 1;
  ENDWHILE;

  RETURN(RetCode);
END;

