	Name:            SelectHighPotNode

/* 
**      Copyright c 1993 Unified Information  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    SOA
**  Frame:          SelectHighPotNode
** 
**  Modification log: 
** 
**  Date:     Version     Description 
** -------------------------------------------------- 
**  05/02/00    py        Select terminal for connectivity trace
**                        Specify terminal of equipment, if two terminals
**  02/18/04    em        Removed Take Control logic
**  02/27/17    ysp       Converted for QGis
*/ 
INITIALIZE   
(   
   SelectedEquip       = INTEGER NOT NULL WITH DEFAULT;
   SelectedEquipName 		= VARCHAR(40) NOT NULL;
   SelectedEquipClassName 		= VARCHAR(40) NOT NULL;
 ) = 
DECLARE 
   i = INTEGER NOT NULL WITH DEFAULT;
   
   ConnectedEquipList = ARRAY OF Equipment;
   SelectedConnection = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE   
BEGIN 
   SelectedEquipment = SQUEEZE(SelectedEquipClassName + ' ' + SelectedEquipName);
/*
** Determine the connecting objects of the selected equipment.
*/ 
   i = 1;
   SELECT :ConnectedEquipList[i].Equip = C.ToObj,
          :ConnectedEquipList[i].EquipName = O.Name,
          :ConnectedEquipList[i].EquipClassName = O.TypeName          
   FROM   DSO_Connection C,
          DSO_Object O
   WHERE  C.FromObj = :SelectedEquip AND
          C.ToObj = O.Object
   UNION ALL
   SELECT C.FromObj,
          O.Name,
          O.TypeName          
   FROM   DSO_Connection C,
          DSO_Object O
   WHERE  C.ToObj = :SelectedEquip AND
          C.FromObj = O.Object
   BEGIN
      IF i = 1 THEN
         Term1_Equip = ConnectedEquipList[i].EquipName;
         Term1_Type = ConnectedEquipList[i].EquipClassName;
      ELSEIF i = 2 THEN
         Term2_Equip = ConnectedEquipList[i].EquipName;
         Term2_Type = ConnectedEquipList[i].EquipClassName;
      ELSEIF i = 3 THEN
         Term3_stack.Term3_Equip = ConnectedEquipList[i].EquipName;
         Term3_stack.Term3_Type = ConnectedEquipList[i].EquipClassName;
      ENDIF;

      i = i + 1;
   END;
   
   IF ConnectedEquipList.LastRow = 0 THEN
      MESSAGE 'Error: High Pot Equipment is not connected.';
      RETURN (PU_CANCEL);

   ELSEIF ConnectedEquipList.LastRow = 1 THEN
      RETURN (ConnectedEquipList[1].Equip);
  
   ELSEIF ConnectedEquipList.LastRow = 2 THEN
      FIELD(term3_stack).CurBias = FB_INVISIBLE;

   ELSEIF ConnectedEquipList.LastRow = 3 THEN
      FIELD(term3_stack).CurBias = FB_CHANGEABLE; 
      
   ELSE 
      MESSAGE 'Error: Selected Object has too many terminals (more than three), ' +
              'we do not know what to do.';
      RETURN (PU_CANCEL); 
   ENDIF;
END;
 
ON Click term1_selected =
BEGIN
   term1_selected = TRUE;
   term2_selected = FALSE;
   term3_stack.term3_selected = FALSE;
   SelectedConnection = ConnectedEquipList[1].Equip; 
END;

ON Click term2_selected =
BEGIN
   term2_selected = TRUE;
   term1_selected = FALSE;
   term3_stack.term3_selected = FALSE;
   SelectedConnection = ConnectedEquipList[2].Equip; 
END;

ON Click term3_stack.term3_selected =
BEGIN
   term1_selected = FALSE;
   term2_selected = FALSE;
   term3_stack.term3_selected = TRUE;
   SelectedConnection = ConnectedEquipList[3].Equip; 
END;

/* 
**  Handle OK click  
*/ 
ON Click OK_Btn = 
BEGIN 
   IF SelectedConnection = 0 THEN
      MESSAGE 'Please select the adjacent device where we can start a trace.';
   ELSE
      RETURN (SelectedConnection);
   ENDIF; 
END;

/* 
**  Handle a Cancel click:  
*/ 
ON Click Cancel_Btn = 
BEGIN 
   RETURN (PU_CANCEL); 
END;


/*
**  Handle the Close Window Command:
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

