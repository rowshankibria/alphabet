**
**  Date:       Version Description
** ----------------------------------
**  05/27/03    ysp     Created; 
**  04/23/07    pkw     Added LoadArchivedCards method.
**  07/31/07    ysp     Add filtering closed cards by Black Start Scenario names
**  11/15/07    ysp     Add IsArchivedCard method
**  12/04/07    ysp     fix black start search
*/

METHOD LoadClosedCards (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
   Filter        = VARCHAR(40);        /* Feeder name filter */
   BlackStartObject = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Filter = 1 THEN
/*
** Search for most restrictive field - the card number - first
*/
      i = 1;
      SELECT	:CurObject.CList[i].Card = C.Card,
               :CurObject.CList[i].FeederNames = CTO.Name,
               :CurObject.CList[i].CardNumber = C.CardNumber,
               :CurObject.CList[i].CardClassName  = C.CardClassName,
               :CurObject.CList[i].CutOut = C.CutOut,
               :CurObject.CList[i].CutIn = C.CutIn,
               :CurObject.CList[i].Closed = C.Closed
      FROM	TFMS_ArchiveCard C,
            TFMS_ArchiveCardToObject CTO
      WHERE     CTO.Type = :Type$TransmissionFdr AND
                CTO.Card = C.Card AND
                CTO.Card = :CurObject.CardFilter
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that card number was found.';
         RETURN;
      ENDIF;

   ELSEIF CurObject.Filter = 2 THEN

      Filter = '%' + Uppercase(CurObject.LineFilter) + '%';

      i = 1;
      REPEATED
      SELECT	:CurObject.CList[i].Card = C.Card,
	        :CurObject.CList[i].FeederNames = CTO.Name,
	        :CurObject.CList[i].CardNumber = C.CardNumber,
	        :CurObject.CList[i].CardClassName  = C.CardClassName,
	        :CurObject.CList[i].CutOut = C.CutOut,
	        :CurObject.CList[i].CutIn = C.CutIn,
	        :CurObject.CList[i].Closed = C.Closed
      FROM	TFMS_ArchiveCard C,
                TFMS_ArchiveCardToObject CTO
      WHERE     CTO.Type = :Type$TransmissionFdr AND
                CTO.Name LIKE :Filter AND
                CTO.Card = C.Card
      ORDER BY  FeederNames, Closed desc
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that line name was found.';
         RETURN;
      ENDIF;

   ELSEIF CurObject.Filter = 3 THEN
      Filter = '%' + Uppercase(CurObject.ScenarioFilter) + '%';
      BlackStartObject = 0;

      SELECT :BlackStartObject = Object
      FROM   UDB_Object
      WHERE  Type = :Type$BlackStartScenario AND
             Uppercase(Name) LIKE :Filter;

      IF BlackStartObject = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No Black Start scenario was found.';
         RETURN;
      ENDIF;

      i = 1;
      REPEATED
      SELECT	:CurObject.CList[i].Card = C.Card,
	        :CurObject.CList[i].FeederNames = CTO.Name,
	        :CurObject.CList[i].CardNumber = C.CardNumber,
	        :CurObject.CList[i].CardClassName  = C.CardClassName,
	        :CurObject.CList[i].CutOut = C.CutOut,
	        :CurObject.CList[i].CutIn = C.CutIn,
	        :CurObject.CList[i].Closed = C.Closed
      FROM	TFMS_ArchiveCard C,
                TFMS_ArchiveCardToObject CTO
      WHERE     CTO.Object = :BlackStartObject AND
                CTO.Card = C.Card
      ORDER BY  FeederNames, Closed desc
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No closed card with that scenario was found.';
         RETURN;
      ENDIF;
      
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please enter a line name or card number.';
      RETURN;
   ENDIF;

   RETURN;
END;

METHOD LoadArchivedCards (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
   Filter        = VARCHAR(40);        /* Feeder name filter */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Filter = 1 THEN
/*
** Search for most restrictive field - the card number - first
*/
      i = 1;
      SELECT	:CurObject.CList[i].Card = OA.Card,
		:CurObject.CList[i].FeederNames = OA.FeederNames,
		:CurObject.CList[i].CardNumber = OA.CardNumber,
                :CurObject.CList[i].CardClassName  = OA.CardClassName,
	        :CurObject.CList[i].CutOut = OA.CutOut,
	        :CurObject.CList[i].CutIn = OA.CutIn,
	        :CurObject.CList[i].Closed = OA.Closed,
	        :CurObject.CList[i].ArchiveYear = OA.ArchiveYear        
      FROM	OA_TFMSCardIndex OA
      WHERE     OA.Card = :CurObject.CardFilter
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No archived card with that card number was found.';
         RETURN;
      ENDIF;

   ELSEIF CurObject.Filter = 2 THEN

      Filter = '%' + Uppercase(CurObject.LineFilter) + '%';

      i = 1;
      SELECT	:CurObject.CList[i].Card = OA.Card,
		:CurObject.CList[i].FeederNames = OA.FeederNames,
		:CurObject.CList[i].CardNumber = OA.CardNumber,
                :CurObject.CList[i].CardClassName  = OA.CardClassName,
	        :CurObject.CList[i].CutOut = OA.CutOut,
	        :CurObject.CList[i].CutIn = OA.CutIn,
	        :CurObject.CList[i].Closed = OA.Closed,
	        :CurObject.CList[i].ArchiveYear = OA.ArchiveYear        
      FROM	OA_TFMSCardIndex OA
      WHERE     Uppercase(OA.FeederNames) LIKE :Filter
      ORDER BY  FeederNames, Closed desc
      BEGIN
         i = i + 1;
      END;

      IF iirowcount = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'No archived card with that line name was found.';
         RETURN;
      ENDIF;

   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please enter a line name or card number.';
      RETURN;
   ENDIF;

   RETURN;
END;

METHOD LoadCard (
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.C = CurObject.C.LoadCard(Card = CurObject.Card);   
      
   RETURN;
END;

METHOD IsArchivedCard(
)=
DECLARE
   i             = INTEGER;           /* Temporary counter  */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Card header data.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ArchiveCard = 1;

   SELECT :CurObject.ArchiveCard = 0
   FROM   TFMS_Card
   WHERE  Card = :CurObject.Card;

   RETURN;
END;

