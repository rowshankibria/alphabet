**  09/21/04    pkw     Change references for center consoles.
**  04/28/05    ysp     Add support for 12 hour shift.
**  06/02/10    ysp     Retrieve 2nd operator data for warning details.
**  11/13/14    ysp     Modified the sql in loaddo to order by operator.
**  10/23/15    ysp     Update usernames of new DO machines
**  12/19/16    ysp     Add loading of details for daily totals and grand total. 
**  02/22/18    YSP     Add support of report by D.O.
**  05/15/18    YSP     Add LoadBackouts method
**  05/24/18    em      Implement WarningType=3 for red cancel
**  05/24/18    ysp     Add LoadBackoutWarnings
**  06/14/18    ysp     Add desk info to the Backouts summary.
**  05/22/19    ysp     Modified the warning query in LoadBackoutWarnings method to include all warning types.
**                      The logic here should be the same as in DistrictOperatorClass.RecordBackOut.
**  09/05/22    pkw     Load threshold values in loaddo
**  01/20/26    ysp     Fix starttime and endtime in LoadBackoutWarnings
*/ 
METHOD LoadYellow (
)=
DECLARE
   CurrentDate = DATE NOT NULL WITH DEFAULT;
   CurrentDateTotal = INTEGER NOT NULL;
   TotalWarnings = INTEGER NOT NULL;
   TempWarning  = ARRAY OF Warning_Rpt;  
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   LogHour      = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(600) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   IF CurObject.ShiftType = 1 THEN
      /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
      ** don't count the first 6 hours of the start day and the last 6 hours 
      ** of the end date spill over to the following day. 
      */      
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.EndDate + '6 hours';
   ENDIF;
/*
**  Load Warnings
*/
   DynamicWhereClause = 'LogDate < ''' + VARCHAR(CurObject.EndDate) + ''' AND ' +
			  ' LogDate >= ''' + VARCHAR(CurObject.StartDate) + ''' AND ' +
			  ' WarningType = ' + VARCHAR(CurObject.OverRide); /*0=Cancelled*/
   IF CurObject.Operator > 0 THEN
	  DynamicWhereClause = DynamicWhereClause + ' AND Operator = ' + VARCHAR(CurObject.Operator);
   ENDIF;
			  
   CurObject.DList.Clear();
   TempWarning.Clear();
   i = 1;
   SELECT :TempWarning[i].UserName = UserName,
		  :TempWarning[i].LogDate = LogDate
   FROM   SOA_Warning
   WHERE  :DynamicWhereClause
   ORDER BY LogDate
   BEGIN
	  i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF TempWarning.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: Warning_ASE(LoadYellow): ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate) + HC_NEWLINE +
                  '   OverRide  = ' + VARCHAR(CurObject.OverRide));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for the selected time period.';
      RETURN;
   ENDIF; 
   
   j = 1;
   CurrentDateTotal = 0;
   TotalWarnings = 0;
   CurrentDate = CurObject.StartDate;
   CurObject.DList[j].LogDate = Date_Trunc('day',CurrentDate);
/*
**  Go through each warning found.
*/
   FOR i = 1 TO TempWarning.LastRow() DO
      IF CurrentDate + '1 day' < TempWarning[i].LogDate THEN
/*
**  There were no warnings on this day.  We must increment
**  logdate until we get to the day of the next warning.
*/
         WHILE CurrentDate + '1 day' < TempWarning[i].LogDate DO
            CurObject.DList[j].Total = CurrentDateTotal;
            CurrentDateTotal = 0;
            
            CurrentDate = CurrentDate + '1 day';
            j = j + 1;
            CurObject.DList[j].LogDate = Date_Trunc('day',CurrentDate);
         ENDWHILE;
      ENDIF;

      CurrentDateTotal = CurrentDateTotal + 1;
      TotalWarnings = TotalWarnings + 1;
/*     
** These are the user ids for the machines up stairs.  They
** are define in the st_application on startup.  These values
** should not change.
**     
**  e-dows2-fms = 30
**  e-dows3-fms = 31
**  e-domb2-fms = 24
**  e-domb3-fms = 25
**  e-dobq2-fms = 21
**  e-dobq1-fms = 20
*/    
      LogHour = date_part('hour',TempWarning[i].LogDate);

      IF CurObject.ShiftType = 0 THEN   /* ========= 8 hour shift ========= */

         IF Right(TempWarning[i].UserName,2) = '30' THEN /* e-dows2-fms */
            IF LogHour <= 7 THEN /*00:00-07:59*/
               CurObject.DList[j].wsa1 = IFNULL(CurObject.DList[j].wsa1,0) + 1;
               CurObject.TList.wsa1 = IFNULL(CurObject.TList.wsa1,0) + 1;
            ELSEIF LogHour <= 15 THEN /*08:00-15:59*/
               CurObject.DList[j].wsa2 = IFNULL(CurObject.DList[j].wsa2,0) + 1;
               CurObject.TList.wsa2 = IFNULL(CurObject.TList.wsa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].wsa3 = IFNULL(CurObject.DList[j].wsa3,0) + 1;
               CurObject.TList.wsa3 = IFNULL(CurObject.TList.wsa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '31' THEN /* e-dows3-fms */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].wsb1 = IFNULL(CurObject.DList[j].wsb1,0) + 1;
               CurObject.TList.wsb1 = IFNULL(CurObject.TList.wsb1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].wsb2 = IFNULL(CurObject.DList[j].wsb2,0) + 1;
               CurObject.TList.wsb2 = IFNULL(CurObject.TList.wsb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].wsb3 = IFNULL(CurObject.DList[j].wsb3,0) + 1;
               CurObject.TList.wsb3 = IFNULL(CurObject.TList.wsb3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '24' THEN /* e-domb2-fms */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].mxa1 = IFNULL(CurObject.DList[j].mxa1,0) + 1;
               CurObject.TList.mxa1 = IFNULL(CurObject.TList.mxa1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].mxa2 = IFNULL(CurObject.DList[j].mxa2,0) + 1;
               CurObject.TList.mxa2 = IFNULL(CurObject.TList.mxa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].mxa3 = IFNULL(CurObject.DList[j].mxa3,0) + 1;
               CurObject.TList.mxa3 = IFNULL(CurObject.TList.mxa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '25' THEN /* e-domb3-fms */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].mxb1 = IFNULL(CurObject.DList[j].mxb1,0) + 1;
               CurObject.TList.mxb1 = IFNULL(CurObject.TList.mxb1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].mxb2 = IFNULL(CurObject.DList[j].mxb2,0) + 1;
               CurObject.TList.mxb2 = IFNULL(CurObject.TList.mxb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].mxb3 = IFNULL(CurObject.DList[j].mxb3,0) + 1;
               CurObject.TList.mxb3 = IFNULL(CurObject.TList.mxb3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '21' THEN /* e-dobq2-fms */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].bqa1 = IFNULL(CurObject.DList[j].bqa1,0) + 1;
               CurObject.TList.bqa1 = IFNULL(CurObject.TList.bqa1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].bqa2 = IFNULL(CurObject.DList[j].bqa2,0) + 1;
               CurObject.TList.bqa2 = IFNULL(CurObject.TList.bqa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].bqa3 = IFNULL(CurObject.DList[j].bqa3,0) + 1;
               CurObject.TList.bqa3 = IFNULL(CurObject.TList.bqa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '20' THEN /* e-dobq1-fms */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].bqb1 = IFNULL(CurObject.DList[j].bqb1,0) + 1;
               CurObject.TList.bqb1 = IFNULL(CurObject.TList.bqb1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].bqb2 = IFNULL(CurObject.DList[j].bqb2,0) + 1;
               CurObject.TList.bqb2 = IFNULL(CurObject.TList.bqb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].bqb3 = IFNULL(CurObject.DList[j].bqb3,0) + 1;
               CurObject.TList.bqb3 = IFNULL(CurObject.TList.bqb3,0) + 1;
            ENDIF;

         ELSE /* OTHER */
            IF LogHour <= 7 THEN /* 00:00 - 07:59 */
               CurObject.DList[j].other1 = IFNULL(CurObject.DList[j].other1,0) + 1;
               CurObject.TList.other1 = IFNULL(CurObject.TList.other1,0) + 1;
            ELSEIF LogHour <= 15 THEN /* 08:00 - 15:59 */
               CurObject.DList[j].other2 = IFNULL(CurObject.DList[j].other2,0) + 1;
               CurObject.TList.other2 = IFNULL(CurObject.TList.other2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 16:00 - 23:59 */
               CurObject.DList[j].other3 = IFNULL(CurObject.DList[j].other3,0) + 1;
               CurObject.TList.other3 = IFNULL(CurObject.TList.other3,0) + 1;
            ENDIF;
         ENDIF;
      ELSE       /* ========= 12 hour shift ========= */

         IF Right(TempWarning[i].UserName,2) = '30' THEN /* e-dows2-fms */
            IF LogHour <= 5 THEN /*00:00-05:59*/
               CurObject.DList[j].wsa3 = IFNULL(CurObject.DList[j].wsa3,0) + 1;
               CurObject.TList.wsa3 = IFNULL(CurObject.TList.wsa3,0) + 1;
            ELSEIF LogHour <= 17 THEN /*06:00-17:59*/
               CurObject.DList[j].wsa2 = IFNULL(CurObject.DList[j].wsa2,0) + 1;
               CurObject.TList.wsa2 = IFNULL(CurObject.TList.wsa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].wsa3 = IFNULL(CurObject.DList[j].wsa3,0) + 1;
               CurObject.TList.wsa3 = IFNULL(CurObject.TList.wsa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '31' THEN /* e-dows3-fms */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].wsb3 = IFNULL(CurObject.DList[j].wsb3,0) + 1;
               CurObject.TList.wsb3 = IFNULL(CurObject.TList.wsb3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].wsb2 = IFNULL(CurObject.DList[j].wsb2,0) + 1;
               CurObject.TList.wsb2 = IFNULL(CurObject.TList.wsb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].wsb3 = IFNULL(CurObject.DList[j].wsb3,0) + 1;
               CurObject.TList.wsb3 = IFNULL(CurObject.TList.wsb3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '24' THEN /* e-domb2-fms */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].mxa3 = IFNULL(CurObject.DList[j].mxa3,0) + 1;
               CurObject.TList.mxa3 = IFNULL(CurObject.TList.mxa3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].mxa2 = IFNULL(CurObject.DList[j].mxa2,0) + 1;
               CurObject.TList.mxa2 = IFNULL(CurObject.TList.mxa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].mxa3 = IFNULL(CurObject.DList[j].mxa3,0) + 1;
               CurObject.TList.mxa3 = IFNULL(CurObject.TList.mxa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '25' THEN /* e-domb3-fms */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].mxb3 = IFNULL(CurObject.DList[j].mxb3,0) + 1;
               CurObject.TList.mxb3 = IFNULL(CurObject.TList.mxb3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].mxb2 = IFNULL(CurObject.DList[j].mxb2,0) + 1;
               CurObject.TList.mxb2 = IFNULL(CurObject.TList.mxb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].mxb3 = IFNULL(CurObject.DList[j].mxb3,0) + 1;
               CurObject.TList.mxb3 = IFNULL(CurObject.TList.mxb3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '21' THEN /* e-dobq2-fms */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].bqa3 = IFNULL(CurObject.DList[j].bqa3,0) + 1;
               CurObject.TList.bqa3 = IFNULL(CurObject.TList.bqa3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].bqa2 = IFNULL(CurObject.DList[j].bqa2,0) + 1;
               CurObject.TList.bqa2 = IFNULL(CurObject.TList.bqa2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].bqa3 = IFNULL(CurObject.DList[j].bqa3,0) + 1;
               CurObject.TList.bqa3 = IFNULL(CurObject.TList.bqa3,0) + 1;
            ENDIF;

         ELSEIF Right(TempWarning[i].UserName,2) = '20' THEN /* e-dobq1-fms */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].bqb3 = IFNULL(CurObject.DList[j].bqb3,0) + 1;
               CurObject.TList.bqb3 = IFNULL(CurObject.TList.bqb3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].bqb2 = IFNULL(CurObject.DList[j].bqb2,0) + 1;
               CurObject.TList.bqb2 = IFNULL(CurObject.TList.bqb2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].bqb3 = IFNULL(CurObject.DList[j].bqb3,0) + 1;
               CurObject.TList.bqb3 = IFNULL(CurObject.TList.bqb3,0) + 1;
            ENDIF;

         ELSE /* OTHER */
            IF LogHour <= 5 THEN /* 00:00 - 05:59 */
               CurObject.DList[j].other3 = IFNULL(CurObject.DList[j].other3,0) + 1;
               CurObject.TList.other3 = IFNULL(CurObject.TList.other3,0) + 1;
            ELSEIF LogHour <= 17 THEN /* 06:00 - 17:59 */
               CurObject.DList[j].other2 = IFNULL(CurObject.DList[j].other2,0) + 1;
               CurObject.TList.other2 = IFNULL(CurObject.TList.other2,0) + 1;
            ELSEIF LogHour <= 24 THEN /* 18:00 - 23:59 */
               CurObject.DList[j].other3 = IFNULL(CurObject.DList[j].other3,0) + 1;
               CurObject.TList.other3 = IFNULL(CurObject.TList.other3,0) + 1;
            ENDIF;
         ENDIF;      
      ENDIF;
   ENDFOR; 
   CurObject.DList[j].Total = CurrentDateTotal;
   CurObject.TList.Total = TotalWarnings;
   RETURN;
END;

METHOD LoadDO (
)=
DECLARE
   OldOperator = INTEGER NOT NULL;
   TempWarning  = ARRAY OF Warning_Rpt;  
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   k            = INTEGER NOT NULL;     /*Counter*/
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load warning statistics for a 
** particular time period and group them by DO.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.ShiftType = 1 THEN
      /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
      ** don't count the first 6 hours of the start day and the last 6 hours 
      ** of the end date spill over to the following day. 
      */      
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.EndDate + '6 hours';
   ENDIF;

/*
**  Load Warnings
*/
   TempWarning.Clear();
   i = 1;
   SELECT TempWarning[i].Operator = Operator,
          TempWarning[i].OperatorName = OperatorName,
          TempWarning[i].WarningType = WarningType,
          TempWarning[i].Total = Count(WarningType)
   FROM   SOA_Warning
   WHERE  LogDate <= :CurObject.EndDate AND
          LogDate >= :CurObject.StartDate AND
          Operator > 0 AND
         (WarningType < 2 OR             /* We don't want red descriptions(2) */
         (WarningType = 3 AND
          TwoOpConfirmEvent <> ''))
   GROUP BY Operator, OperatorName, WarningType
   ORDER BY Operator
   BEGIN
      i = i + 1;
   END; 
   
   IF TempWarning.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: Warning_ASE(LoadDO): ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for the selected time period.';
      RETURN;
   ENDIF; 
/*
**  Fill in Details array.
*/ 
   CurObject.DList.Clear();
/*
**  Using -1 since it is possible for a warning to get inserted into
**  the table with operator = 0 (not logged in).
*/
   OldOperator = -1; 
   j = 0;
   FOR i = 1 TO TempWarning.LastRow() DO
      IF OldOperator <> TempWarning[i].Operator THEN
         j = j + 1;
         OldOperator = TempWarning[i].Operator;
         CurObject.DList[j].Operator = TempWarning[i].Operator;
         CurObject.DList[j].OperatorName = TempWarning[i].OperatorName;
         
         k = 1;
         SELECT :CurObject.DList[j].Threshold[k].LastUpdate = S.WarningTime 
         FROM   FMS_SpeedbumpCnt S
         WHERE  S.Object = :CurObject.DList[j].Operator AND
                S.WarningTime <= :CurObject.EndDate AND
                S.WarningTime >= :CurObject.StartDate
         BEGIN
            k = k +1;
         END;
           
      ENDIF;
      IF TempWarning[i].WarningType = 0 THEN
         CurObject.DList[j].Other1 = TempWarning[i].Total;
      ELSEIF TempWarning[i].WarningType = 1 THEN
         CurObject.DList[j].Other2 = TempWarning[i].Total;     
      ELSEIF TempWarning[i].WarningType = 3 THEN
         CurObject.DList[j].Other3 = TempWarning[i].Total;     
      ENDIF;
   ENDFOR;
   RETURN;
END;

METHOD LoadDetails (
)=
DECLARE
   Position      = VARCHAR(10) NOT NULL;
   PositionMatch = VARCHAR(10) NOT NULL;
   TempWarning   = ARRAY OF Warning_Rpt;  
   i             = INTEGER NOT NULL;     /*Counter*/
   j             = INTEGER NOT NULL;     /*Counter*/
   PrevCard      = INTEGER NOT NULL WITH DEFAULT;
   PrevSW        = INTEGER NOT NULL WITH DEFAULT;
   PrevArch      = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(600) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load details for a particular cell
** that was selected on the yellow warning report.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';  
/*
**  Load Warnings
*/
   TempWarning.Clear();
   
   IF Lowercase(CurObject.DetailType) = 'total' THEN  /* Selecting details for the grand total */
      IF CurObject.ShiftType = 1 THEN
         /* For 12 hour shift, shift the StartDate and EndDate by 6 hours because we
         ** don't count the first 6 hours of the start day and the last 6 hours 
         ** of the end date spill over to the following day. 
         */      
         CurObject.StartDate = CurObject.StartDate + '6 hours';
         CurObject.EndDate = CurObject.EndDate + '6 hours';
      ENDIF;   
      
      DynamicWhereClause = 'LogDate < ''' + VARCHAR(CurObject.EndDate) + ''' AND ' +
			  ' LogDate >= ''' + VARCHAR(CurObject.StartDate) + '''';
      
      IF CurObject.OverRide = 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND WarningType = ' + VARCHAR(CurObject.OverRide); /*0=Cancelled*/
      ELSEIF CurObject.OverRide = 3 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND WarningType = 3 AND TwoOpConfirmEvent <> '''' ';  /*3=red cancel*/ 
      ELSE
         DynamicWhereClause = DynamicWhereClause + ' AND WarningType IN (1,2,3)';  /*1=Overridden,2=red ok,3=red cancel*/ 
      ENDIF;
      
      IF CurObject.Operator > 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND Operator = ' + VARCHAR(CurObject.Operator);
      ENDIF;
   
      CurObject.DList.Clear();
      i = 1;

      SELECT :CurObject.DList[i].LogDate = LogDate,
             :CurObject.DList[i].UserName = UserName,
             :CurObject.DList[i].Application = Application,
             :CurObject.DList[i].Operator = Operator,
             :CurObject.DList[i].OperatorName = OperatorName,
             :CurObject.DList[i].Operator2 = Operator2,
             :CurObject.DList[i].Operator2Name = Operator2Name,
             :CurObject.DList[i].WarningType = WarningType,
             :CurObject.DList[i].WarningText = WarningText,
             :CurObject.DList[i].Card = Card,
             :CurObject.DList[i].CardName = CardName,
             :CurObject.DList[i].SwitchingItem = SwitchingItem,
             :CurObject.DList[i].TwoOpConfirmEvent = TwoOpConfirmEvent,
             :CurObject.DList[i].Job = Job
      FROM   SOA_Warning
      WHERE  :DynamicWhereClause
      ORDER BY LogDate
      BEGIN
         i = i + 1;
      END; 
      
      IF CurObject.OverRide = 3 THEN
         i = 1;
         TempWarning.Clear();
         FOR j = 1 TO CurObject.DList.Lastrow() DO
            SELECT :TempWarning[i].LogDate = LogDate,
                   :TempWarning[i].UserName = UserName,
                   :TempWarning[i].Application = Application,
                   :TempWarning[i].Operator = Operator,
                   :TempWarning[i].OperatorName = OperatorName,
                   :TempWarning[i].Operator2 = Operator2,
                   :TempWarning[i].Operator2Name = Operator2Name,
                   :TempWarning[i].WarningType = WarningType,
                   :TempWarning[i].WarningText = WarningText,
                   :TempWarning[i].Card = Card,
                   :TempWarning[i].CardName = CardName,
                   :TempWarning[i].SwitchingItem = SwitchingItem,
                   :TempWarning[i].TwoOpConfirmEvent = TwoOpConfirmEvent,
                   :TempWarning[i].Job = Job
            FROM   SOA_Warning
            WHERE  TwoOpConfirmEvent = :CurObject.Dlist[j].TwoOpConfirmEvent  
            ORDER BY LogDate
            BEGIN
               i = i + 1;
            END;
         ENDFOR;
         CurObject.DList.Clear();
         CurObject.DList = TempWarning.Duplicate();
      ENDIF;
      
   ELSE /* Selecting details for a day */
      /*
      **  Parse shift information.
      */
      IF CurObject.ShiftType = 0 THEN	/* 8 Hour Shift */
         IF CurObject.Shift = 0 THEN   // daily total
            CurObject.EndDate = CurObject.StartDate + '1 day';         
         ELSEIF CurObject.Shift = 1 THEN
            CurObject.EndDate = CurObject.StartDate + '8 hours';
         ELSEIF CurObject.Shift = 2 THEN
            CurObject.StartDate = CurObject.StartDate + '8 hours';
            CurObject.EndDate = CurObject.StartDate + '8 hours';
         ELSEIF CurObject.Shift = 3 THEN
            CurObject.StartDate = CurObject.StartDate + '16 hours';
            CurObject.EndDate = CurObject.StartDate + '8 hours';
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                 ': Error: Warning_ASE(LoadDetails) ' +
                 'had invalid shift value passed.(' +
                 VARCHAR(CurObject.Shift) + ')');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Invalid report parameters passed. ' +
                        'Please report error to technical support.';
            RETURN;
         ENDIF;
      ELSE	/* 12 hour shift */
         IF CurObject.Shift = 0 THEN   // daily total
            CurObject.StartDate = CurObject.StartDate + '6 hours';
            CurObject.EndDate = CurObject.StartDate + '1 day';         
         ELSEIF CurObject.Shift = 1 THEN
            CurObject.StartDate = CurObject.StartDate + '6 hours';
            CurObject.EndDate = CurObject.StartDate + '12 hours';
         ELSEIF CurObject.Shift = 2 THEN
            CurObject.StartDate = CurObject.StartDate + '18 hours';
            CurObject.EndDate = CurObject.StartDate + '12 hours';
         ELSE
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                 ': Error: Warning_ASE(LoadDetails) ' +
                 'had invalid shift value passed.(' +
                 VARCHAR(CurObject.Shift) + ')');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Invalid report parameters passed. ' +
                        'Please report error to technical support.';
            RETURN;
         ENDIF;
      ENDIF;
      
      DynamicWhereClause = 'LogDate < ''' + VARCHAR(CurObject.EndDate) + ''' AND ' +
			  ' LogDate >= ''' + VARCHAR(CurObject.StartDate) + '''';
      
      IF CurObject.OverRide = 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND WarningType = ' + VARCHAR(CurObject.OverRide); /*0=Cancelled*/
      ELSE
         DynamicWhereClause = DynamicWhereClause + ' AND WarningType IN (1,2,3)';  /*1=Overridden,2=red ok, 3= red cancel*/ 
      ENDIF;
      
      IF CurObject.Operator > 0 THEN
         DynamicWhereClause = DynamicWhereClause + ' AND Operator = ' + VARCHAR(CurObject.Operator);
      ENDIF;

      /*
      **  Parse Desk information.
      **  e-dows2-fms = 30
      **  e-dows3-fms = 31
      **  e-domb2-fms = 24
      **  e-domb3-fms = 25
      **  e-dobq2-fms = 21
      **  e-dobq1-fms = 20
      */
      IF lowercase(CurObject.Desk) = 'wsa' THEN
         Position = '30';
      ELSEIF lowercase(CurObject.Desk) = 'wsb' THEN
         Position = '31';
      ELSEIF lowercase(CurObject.Desk) = 'mxa' THEN
         Position = '24';
      ELSEIF lowercase(CurObject.Desk) = 'mxb' THEN
         Position = '25';
      ELSEIF lowercase(CurObject.Desk) = 'bqa' THEN
         Position = '21';
      ELSEIF lowercase(CurObject.Desk) = 'bqb' THEN
         Position = '20';
      ELSEIF lowercase(CurObject.Desk) = 'other' THEN
         Position = 'other';
      ELSEIF lowercase(CurObject.Desk) = 'total' THEN
         Position = 'total';
      ENDIF;
      
      i = 1;
      SELECT :TempWarning[i].LogDate = LogDate,
             :TempWarning[i].UserName = UserName,
             :TempWarning[i].Application = Application,
             :TempWarning[i].Operator = Operator,
             :TempWarning[i].OperatorName = OperatorName,
             :TempWarning[i].Operator2 = Operator2,
             :TempWarning[i].Operator2Name = Operator2Name,
             :TempWarning[i].WarningType = WarningType,
             :TempWarning[i].WarningText = WarningText,
             :TempWarning[i].Card = Card,
             :TempWarning[i].CardName = CardName,
             :TempWarning[i].SwitchingItem = SwitchingItem,
             :TempWarning[i].Job = Job
      FROM   SOA_Warning
      WHERE  :DynamicWhereClause
      ORDER BY LogDate
      BEGIN
         i = i + 1;
      END; 
      
      CurObject.DList.Clear();
      j = 0;
      FOR i = 1 TO TempWarning.LastRow() DO
         IF Position = 'total'  THEN      // daily details
            CurObject.DList[i] = TempWarning[i].Duplicate();
         ELSE                             // desk daily details
            IF Right(TempWarning[i].UserName,2) = '30' THEN
               PositionMatch = '30'; 
            ELSEIF Right(TempWarning[i].UserName,2) = '31' THEN
               PositionMatch = '31'; 
            ELSEIF Right(TempWarning[i].UserName,2) = '24' THEN
               PositionMatch = '24'; 
            ELSEIF Right(TempWarning[i].UserName,2) = '25' THEN
               PositionMatch = '25'; 
            ELSEIF Right(TempWarning[i].UserName,2) = '21' THEN
               PositionMatch = '21'; 
            ELSEIF Right(TempWarning[i].UserName,2) = '20' THEN
               PositionMatch = '20'; 
            ELSE
               PositionMatch = 'other';
            ENDIF;
            IF Position = PositionMatch THEN
               j = j + 1;
               CurObject.DList[j] = TempWarning[i].Duplicate();
            ENDIF;
         ENDIF;
      ENDFOR;
   ENDIF;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.DList.LastRow() = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                  ': MESSAGE: Warning_ASE(LoadDetails): ' +
                  'No data found. Values passed in:' + HC_NEWLINE +
                  '   StartDate = ' + VARCHAR(CurObject.StartDate) + HC_NEWLINE +
                  '   EndDate   = ' + VARCHAR(CurObject.EndDate) + HC_NEWLINE +
                  '   OverRide  = ' + VARCHAR(CurObject.OverRide) + HC_NEWLINE +
                  '   Desk      = ' + CurObject.Desk + HC_NEWLINE +
                  '   Shift     = ' + VARCHAR(CurObject.Shift) + HC_NEWLINE +
                  '   Operator  = ' + VARCHAR(CurObject.Operator));
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No data found for selected field.';
   ELSE
      /* 
      ** Find out if the card or switching item is already archived. 
      */
      FOR i = 1 TO CurObject.DList.LastRow() DO
          IF CurObject.DList[i].Card <> 0 THEN
             IF CurObject.DList[i].Card <> PrevCard OR
                CurObject.DList[i].SwitchingItem <> PrevSW THEN
              
                CurObject.DList[i].ArchiveCard = 1;

                REPEATED
                SELECT :CurObject.DList[i].ArchiveCard = 0
                FROM   SOA_JobControl
                WHERE  Card = :CurObject.DList[i].Card AND
                       SwitchingItem = :CurObject.DList[i].SwitchingItem;
                CALLPROC DDB_ROLLBACK;
  
                PrevArch = CurObject.DList[i].ArchiveCard;
                PrevCard = CurObject.DList[i].Card;
                PrevSW = CurObject.DList[i].SwitchingItem;
             ELSE
                CurObject.DList[i].ArchiveCard = PrevArch;
             ENDIF;
          ENDIF;
      ENDFOR;
   ENDIF;   
 
   RETURN;
END;

METHOD LoadBackouts(
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;     /*Counter*/
   idx = INTEGER NOT NULL;
   IssueCounts  = ARRAY OF Warning_Rpt;  
   UserName = VARCHAR(20) NOT NULL WITH DEFAULT;
   UserNumber = VARCHAR(2) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load DO backouts for a particular time period.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   /* This report is built for 12 hour shift. Shifts are recorded between 4:30-6:30AM (Day shift value = 1) 
   ** or 4:30-6:30PM (Night shift value = 2).
   ** So out query starts at (StartDate + 4:30) and ends at EndDate.
   */      
   CurObject.StartDate = CurObject.StartDate + '4 hours';
   CurObject.StartDate = CurObject.StartDate + '30 minutes';
   CurObject.EndDate = CurObject.EndDate;

/*
**  Load backouts
*/
   CurObject.DList.Clear();
   /* this query works only when DO has issued moves
   **
   SELECT :CurObject.DList[i].Operator = a.Operator,
          :CurObject.DList[i].OperatorName = a.OperatorName,
          :CurObject.DList[i].LogDate = b.LoginDate, 
          :CurObject.DList[i].Other1 = b.Shift,          // 1= day 2= night
          :CurObject.DList[i].Other2 = a.ShiftID,        // unique ID
          :CurObject.DList[i].Other3 = b.WarningBackoutCount, 
          :CurObject.DList[i].Total = count(a.ShiftID)
   FROM SOA_WarningBackout b,
        SOA_Activity a
   WHERE b.ShiftID = a.ShiftID
   GROUP BY a.Operator, a.OperatorName, b.LoginDate, b.Shift, a.ShiftID, b.WarningBackoutCount
   ORDER BY 2, 3, 4
   BEGIN
      i = i + 1;
   END;
   */
   i = 1;
   SELECT :CurObject.DList[i].Operator = b.Operator,
          :CurObject.DList[i].Other2 = b.ShiftID,        // unique ID
          :CurObject.DList[i].LogDate = b.LoginDate, 
          :CurObject.DList[i].Other1 = b.Shift,          // 1= day 2= night
          :CurObject.DList[i].Other3 = b.WarningBackoutCount,
          :CurObject.DList[i].OperatorName = O.Description,
          :UserName = b.UserName
   FROM  SOA_WarningBackout b,
         UDB_Object O
   WHERE b.LoginDate >= :CurObject.StartDate AND
         b.LoginDate < :CurObject.EndDate AND
         b.Operator = O.Object AND
         O.Type = :Type$DistrictOperator
   ORDER BY 1, 2
   BEGIN
      /*
      **  e-dows2-fms = 30
      **  e-dows3-fms = 31
      **  e-domb2-fms = 24
      **  e-domb3-fms = 25
      **  e-dobq2-fms = 21
      **  e-dobq1-fms = 20
      */
      UserNumber = Right(UserName,2);
      IF UserNumber = '30' THEN
         CurObject.DList[i].UserName = 'A(W/S)';
      ELSEIF UserNumber = '31' THEN
         CurObject.DList[i].UserName = 'B(W/S)';
      ELSEIF UserNumber = '24' THEN
         CurObject.DList[i].UserName = 'A(M/X)';
      ELSEIF UserNumber = '25' THEN
         CurObject.DList[i].UserName = 'B(M/X)';
      ELSEIF UserNumber = '21' THEN
         CurObject.DList[i].UserName = 'A(B/Q)';
      ELSEIF UserNumber = '20' THEN
         CurObject.DList[i].UserName = 'B(B/Q)';
      ELSE
         CurObject.DList[i].UserName = 'Other';
      ENDIF;
      i = i + 1;
   END;
       
   i = 1;
   SELECT :IssueCounts[i].Operator = a.Operator,
          :IssueCounts[i].Other2 = a.ShiftID,        // unique ID
          :IssueCounts[i].Total = count(a.ShiftID)
   FROM  SOA_WarningBackout b,
         SOA_Activity a
   WHERE b.LoginDate >= :CurObject.StartDate AND
         b.LoginDate < :CurObject.EndDate AND
         b.ShiftID = a.ShiftID
   GROUP BY a.Operator, a.ShiftID
   ORDER BY 1, 2
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   /*
   ** Mash CurObject.DList and IssueCounts together.
   ** DList is shorter than IssueCounts because IssueCounts may contains moves issued by Staff or
   ** retired DO.
   */
   idx = 1;
   
   FOR i = 1 TO IssueCounts.LastRow DO
      FOR j = idx TO CurObject.DList.LastRow DO
        IF IssueCounts[i].Operator < CurObject.DList[j].Operator THEN
			ENDLOOP;
		ELSEIF IssueCounts[i].Operator = CurObject.DList[j].Operator AND
            IssueCounts[i].Other2 = CurObject.DList[j].Other2 THEN
            CurObject.DList[j].Total = IssueCounts[i].Total;  
            idx = j + 1;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDFOR;   
   
   /*
   CurMethod.Trace(Text = 'CurObject.DList=' + varchar(CurObject.DList.LastRow) + 
                          ', IssueCounts=' + varchar(IssueCounts.LastRow));
   */
END;

METHOD LoadBackoutWarnings (
)=
DECLARE
   i             = INTEGER NOT NULL;     /*Counter*/
   j             = INTEGER NOT NULL;     /*Counter*/
   RedOverride = INTEGER NOT NULL WITH DEFAULT;
   TempWarning = ARRAY OF Warning_Rpt;  
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load backout warning details for an operator during a shift
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';  

   IF CurObject.Shift = 1 THEN
      CurObject.StartDate = CurObject.StartDate + '6 hours';
      CurObject.EndDate = CurObject.StartDate + '18 hours';
   ELSEIF CurObject.Shift = 2 THEN
      CurObject.StartDate = CurObject.StartDate + '18 hours';
      CurObject.EndDate = CurObject.StartDate + '30 hours';
   ENDIF;

   TempWarning.Clear();
   i = 1;
   SELECT :TempWarning[i].LogDate = LogDate,
          :TempWarning[i].UserName = UserName,
          :TempWarning[i].Application = Application,
          :TempWarning[i].Operator = Operator,
          :TempWarning[i].OperatorName = OperatorName,
          :TempWarning[i].Operator2 = Operator2,
          :TempWarning[i].Operator2Name = Operator2Name,
          :TempWarning[i].WarningType = WarningType,
          :TempWarning[i].WarningText = WarningText,
          :TempWarning[i].Card = Card,
          :TempWarning[i].CardName = CardName,
          :TempWarning[i].SwitchingItem = SwitchingItem,
          :TempWarning[i].Job = Job
   FROM   SOA_Warning
   WHERE  LogDate < :CurObject.EndDate AND 
          LogDate >= :CurObject.StartDate AND
          /* WarningType IN (0,1,3) AND                 1=cancelled,2=overridden, 3=red cancelled */ 
          Operator = :CurObject.Operator
   ORDER BY LogDate DESC
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   CurObject.DList.Clear(); 
   RedOverride = FALSE;
   j = 1;
   FOR i = 1 TO TempWarning.LastRow DO
      IF TempWarning[i].WarningType = 0 THEN
         CurObject.DList[j] = TempWarning[i];
         j = j + 1;
         RedOverride = FALSE;
      
      ELSEIF TempWarning[i].WarningType = 1 AND RedOverride = TRUE THEN
         CurObject.DList[j] = TempWarning[i];
         j = j + 1;
     
      ELSEIF TempWarning[i].WarningType = 3 THEN
         CurObject.DList[j] = TempWarning[i];
         j = j + 1;
         RedOverride = TRUE;
         
      ELSE
         RedOverride = FALSE;
      ENDIF;
   ENDFOR;
   
   CurObject.DList.Sort(LogDate = AS_ASC);
END;

