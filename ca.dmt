Application Component Report
============================

	Name:            SOA_ActivationControl

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**
**  Application:    CAC
**  Frame:          SOA_ActivationControl
**
**  01/18/03   em   Replacing inefficient database procedure of same name
**                  with a 4gl proc to more effectively drive the setting
**                  of the ControlCard value for jobs on the newly activated
**                  card or switching item.   
**                  Parameters left the same so that changes to calling
**                  programs are not necessary.
**  02/04/03   em   Add condition to set ControlCard if ControlCard = 0 for
**                  any moves on this card.  This covers any new/dropped
**                  equipment moves that may have been picked up during 
**                  LoadOutstandingMoves.
**  03/29/06   ysp  Remove SLCApplication parameter
**  04/07/11   em   Confirm J.ControlCard refers to an ActiveCard.
*/
PROCEDURE SOA_ActivationControl (
   Card           = INTEGER NOT NULL;               /* Parm */
   SwitchingItem  = INTEGER NOT NULL WITH DEFAULT;  /* Parm */

   i              = INTEGER NOT NULL WITH DEFAULT;              
   Equip          = ARRAY OF INTEGEROBJECT;         /* Job Equip List */
   ControlCard    = INTEGER NOT NULL;               /* Equip Control Card */
   RetCode        = INTEGER NOT NULL WITH DEFAULT;              
) =
BEGIN
/*
** Get a list of Equipment on jobs on the card
*/
   i = 1;
   Equip.Clear();
   REPEATED
   SELECT DISTINCT
             :Equip[i].Value = J.Equip
   FROM      SOA_Job J,
             SOA_JobControl JC
   WHERE     JC.Card = :Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('', :JobStatus$NIS) AND
             J.Equip <> 0
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Equip.LastRow() DO
      ControlCard = 0;
      SELECT  :ControlCard = J.ControlCard 
      FROM    SOA_ActiveCard C,
              SOA_ActiveCard AC2,
              SOA_JobControl JC, 
              SOA_Job J 
      WHERE   J.Equip = :Equip[i].Value AND 
              J.Status IN ('', :JobStatus$NIS) AND 
             (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND 
              J.MoveCategory = :MoveCategory$Normal AND  
              J.Job = JC.Job AND
              JC.Card = C.Card AND
              C.Card <> :Card AND 
              C.Card <> :NIS$Card AND  
             (C.Application <> :Application$SLC OR
             (J.SWItemStatus >= :Card$Active AND 
              J.SWItemStatus < :Card$Closed) ) AND 
              J.ControlCard = AC2.Card;

      IF ControlCard <> 0 THEN
         
         RetCode = CALLPROC SOA_JobEquipControlUpd (
                     Equip = Equip[i].Value,
                     Card  = Card,
                     SwitchingItem  = SwitchingItem,
                     ControlCard = ControlCard,
                     NormalMoveCategory = MoveCategory$Normal);
         IF RetCode <> 0 THEN
            RETURN -1;
         ENDIF;
      ENDIF;
   ENDFOR;
/*
** Get a list of Equipment on jobs where ControlCard = 0
*/
   i = 1;
   Equip.Clear();
   REPEATED
   SELECT DISTINCT
             :Equip[i].Value = J.Equip
   FROM      SOA_Job J,
             SOA_JobControl JC
   WHERE     JC.Card = :Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.Job = J.Job AND
             J.MoveCategory = :MoveCategory$Normal AND
             J.Status IN ('', :JobStatus$NIS) AND
             J.Equip <> 0 AND
             J.ControlCard = 0
   BEGIN
      i = i + 1;
   END;
/*
** Set ControlCard on this equipment to the Current Card.
*/
   FOR i = 1 TO Equip.LastRow() DO
         
         RetCode = CALLPROC SOA_JobEquipControlUpd (
                     Equip = Equip[i].Value,
                     Card  = Card,
                     SwitchingItem  = SwitchingItem,
                     ControlCard = Card,
                     NormalMoveCategory = MoveCategory$Normal);
         IF RetCode <> 0 THEN
            RETURN -1;
         ENDIF;
   ENDFOR; 
   RETURN 0;
END;

