    RESUME;
END;

PROCEDURE DeterminePhase(
   RowNumber = INTEGER NOT NULL
)=
DECLARE
   i = INTEGER NOT NULL;
   NISMove = INTEGER NOT NULL;	/*BOOLEAN*/
ENDDECLARE
BEGIN
   i = RowNumber;
/*
** Check whether this move appropriately is a move that can return Phases.
** If it is already a Phase move, then it cannot be split into phases again.
** If it is NIS move (must check DB since status field in array is being
** used to determine if a TO or RS), don't allow phase.
*/
   IF Moves[i].MoveType = MoveType$Phase THEN
      RETURN;
   ENDIF;

   NISMove = FALSE; 
   BreakMove = FALSE; 
   GroundMove = FALSE; 

   SELECT  :NISMove = :TRUE
   FROM    SOA_Job 
   WHERE   Job = :Moves[i].Job AND
           Status = :JobStatus$NIS;

   IF NISMove = TRUE THEN
      RETURN;
   ENDIF;
/*
**  Check to make sure this is a Visible Break or a Ground Move
**  i is retained from previous event as the current row number.
*/
   SELECT  :GroundMove = :TRUE
   FROM    FMS_JobAction 
   WHERE   JobClass = :Moves[i].JobClass AND
           EquipClass = :Moves[i].MoveEquipClass AND
           Status = :Status$Ground;

   IF GroundMove = FALSE THEN 
/*
** Call function to determine if move is a Phase Break move
*/
      BreakMove = FALSE;
      BreakMove = CALLPROC DeterminePhaseBreak (
                   JobClass = Moves[i].JobClass,
                   EquipClass = Moves[i].EquipClass,
                   StepPair = Moves[i].StepPair,
                   TORS = TORS);
   ENDIF;

   IF BreakMove = TRUE OR GroundMove = TRUE THEN
      FIELD(Moves[i].Phase_btn).FgCOLOR = CC_BLACK;
   ENDIF;

   RETURN;
END;

PROCEDURE CreateDelayedFOTCard(
) = 
DECLARE
   NewCard = INTEGER NOT NULL WITH DEFAULT;
   Reason = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /* 
   **  Create FOT card if card is not ISO
   **  else create another ISO 
   **  (the substitution to ISO is done in the called frame) 
   */ 
   RetCode = CALLFRAME CreateXferCard
            (OldCardID    = Card, 
            XferCardKey = byref(NewCard),
            XferCardClass = Type$FOT, 
            TestType = OrderReturnStatus.TestType,
            TestDate = OrderReturnStatus.TestDate);

   IF (RetCode = PU_OK) THEN 
      CALLPROC DDB_COMMIT;
      /*
      ** Log the creation of a transfer ISO card due to FOT
      */
      IF CardDetails.CardClass = Type$ISO THEN
         IF OrderReturnStatus.TestType = 'A' THEN
            Reason = 'Reason: AmmClear FOT';
         ELSEIF OrderReturnStatus.TestType = 'H' THEN
            Reason = 'Reason: HiPot FOT';
         ENDIF;
         
         CALLPROC SOA_LogIns (Card = NewCard,
                       SwitchingItem = 0,
                       Job  = NULL,
                       Time = DATE('now'),
                       UserName = UserName,
                       Item = 'Xfer Card Created',
                       Old  = '',
                       New  = Reason);
           CALLPROC DDB_COMMIT;
      ENDIF;
      /* 
      **   Load the new FOT card into the frame:   
      */ 
      FCFrame.SendUserEvent(EventName = 'update_xfer', 
                            messageinteger = NewCard);
   ENDIF;
END;

PROCEDURE UpdateOpOrderStatus(
) = 
DECLARE
   Feeder = INTEGER NOT NULL WITH DEFAULT;
   FdrList = ARRAY OF INTEGEROBJECT;
ENDDECLARE
BEGIN
   IF OrderStatus = Order$Rejected THEN
      Status = Order$ConfirmRejected;

   ELSEIF OrderStatus = Order$Rescinded THEN
      Status = Order$ConfirmRescinded;

   ELSEIF OrderStatus = Order$Closed THEN
      Status = Order$ConfirmClosed;
   ELSE
      /*
      **  Make sure status has a value.  We should not get into
      **  this else, but we have seen orderstatus with orderstatus
      **  of 0, so we will look here first.
      */
      Status = Order$ConfirmClosed;
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              ': WARNING - Order Status ' + 
              'unknown for order: ' + varchar(oporder) +
              ' setting to ' + varchar(Order$ConfirmClosed));
      CALLPROC SOA_LogIns (Card = Card,
                 Job  = NULL,
                 SwitchingItem  = IFNULL(Moves[1].SwitchingItem,0),
                 UserName = UserName,
                 Time = 'now',
                 Item = 'Order Return',
                 Old  = 'OrderStatus not known for order ' + VARCHAR(:OpOrder), 
                 New = 'Setting to: ' + varchar(Order$ConfirmClosed));
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF CurrentApplication = Application$DSO THEN
      RetCode = CALLPROC IR_DSOOrderStatusUpd
                (OrderNumber = OpOrder,
                 OrderStatus = IFNULL(Status,0));

   ELSE
      RetCode = CALLPROC IR_OrderStatusUpd
                (OrderNumber = OpOrder,
                 OrderStatus = IFNULL(Status,0));
   ENDIF;
   
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
              ': WARNING - Order Status ' + 
              'not updated to: ' + varchar(Status) + 
              ' for order: ' + varchar(oporder));
      Message 'Unable to update Operating Order status. ' + 
              'Please report problem to ' +
              'technical support.' + HC_NEWLINE + 'Order Status ' + 
              'not updated to: ' + varchar(Status) + 
              ' for order: ' + varchar(oporder);
   ENDIF;
   CALLPROC DDB_COMMIT; 

   IF OrderStatus = Order$Closed THEN
      ControlText = VARCHAR(OpOrder) + ';';
      ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
      ControlText = ControlText + AckDO + ';'; 
      CALLPROC InsertDBEventQueue(
               ToApp = 'SOO',
               EventName = 'IR_AckOpOrderReturn',
               EventText = ControlText);  

      IF CurrentApplication = Application$FMS THEN
         /*
         ** If SSO return start times for the operating steps, we need to adjust 
         ** the start time here.
         */
         IF SimpleStep IS NULL THEN
            SimpleStep = OperatingStep_ASE.Create();
         ENDIF;    
         SimpleStep.OrderNumber = OpOrder;

         SimpleStep.StartTimeUpd();

         IF SimpleStep.ReturnCode <> 0 THEN
            CALLPROC TraceError (UserMessage = '',
               TraceMessage = SimpleStep.ErrorMessage);
         ENDIF; 
         SimpleStep = NULL;         
      ENDIF;
   ELSE
      IF OrderStatus = Order$Rejected THEN
         ControlText = VARCHAR(OpOrder) + ';';
         ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
         ControlText = ControlText + AckDO + ';'; 
         CALLPROC InsertDBEventQueue(
               ToApp = 'SOO',
               EventName = 'IR_AckOpOrderRejection', 
               EventText = ControlText);  
      ENDIF;

      IF CurrentApplication = Application$FMS THEN
         /*
         ** If this order sets the Feeder Ground status, we should reset it.
         ** check if there is a Apply Feeder Ground objective in the order
         */
         x = 0;
         SELECT :x = 1,
                :OrderCard = C.Card,
                :Feeder = C.Feeder
         FROM   IR_OperatingOrder OP,
                FMS_Card C
         WHERE  OP.OrderNumber = :OpOrder AND
                OP.Application = 'FMS' AND
                OP.Card = C.Card;
         CALLPROC DDB_ROLLBACK;

         IF x = 1 THEN     
            x = 0;
            SELECT :x = Objective
            FROM   IR_OpOrderObjectives
            WHERE  OrderNumber = :OpOrder AND
                   Objective = :Objective$ApplyFdrGnd;

                   
            IF x > 0 THEN
               IF Feeder = -1 THEN
                  i = 1;
                  SELECT :FdrList[i].Value = Object
                  FROM   TFMS_CardToObject
                  WHERE  Card = :OrderCard
                  BEGIN
                     i = i + 1;
                  END;
                  CALLPROC DDB_ROLLBACK;
               ELSE
                  FdrList[1].Value = Feeder; 
               ENDIF;

               FOR i = 1 TO FdrList.LASTROW DO
                  x = 0;
                  SELECT :x = StatusCount
                  FROM   FMS_ObjectStatus
                  WHERE  Object = :FdrList[i].Value 
                    AND  Status = :Status$FdrG
                    AND  StatusCount > 0;

                  IF x = 1 THEN
                     RetCode = CALLPROC FMS_ObjStatDel (
                         Object = FdrList[i].Value,
                         Terminal = 0,
                         Status = Status$FdrG);
                  ELSEIF x > 1 THEN
                     RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
                         Object = FdrList[i].Value,
                         Status = Status$FdrG,
                         Increment = -1,
                         TimeSet = Date('now'));
                  ELSE
                     RetCode = 0;
                  ENDIF;

                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     MESSAGE 'Unable to reset Feeder Ground status for the current feeder. ' +
                        'Please reset the status manually.';
                  ELSE
                     CALLPROC DDB_COMMIT;
                  ENDIF;
               ENDFOR;
            ENDIF;
         ENDIF;
      ENDIF;   // FMS app
   ENDIF; 
END;

Application Component Report
============================

	Name:            ReturnPhases

/*
**
**      Copyright c 1999 Alstom ESCA Corporation.  All rights reserved.
**
**      Alstom ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Alstom ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ReturnPhases
**
**  Date:       Author   Description
** ----------------------------------
**  05/21/99	EM       Combined TFMS_NewPhaseMoves with
**                       ability to define incomplete visible break moves
**  05/26/99    em       Restore Ground Moves are blocked in ReturnOperatorMoves
**                       Function only applicable to T/O Ground and T/O or R/S
**                       Break Moves.  R/S Break Moves are T/O blank stamped.
**  06/07/99    em       Re-enable Restore Ground moves, auto issue/complete the
**                       TakEOut side.  Copy Work Permit Protection Links.
**  09/27/99    em       For Phase split ground moves, Automatically insert
**                       ground moves for each of the three phases (original
**                       move becomes the phase A move.
**  10/21/99    em       Removed NewMoves tablefield from screen
**  03/02/00    em       Attempt to placate Visible Break Response problem for
**                       Takeout side by inserting the work "TakeOut" in 
**                       front of the Phases.
**  11/06/00    em       Don't mark Response for completed ground moves.  Don't
**                       use new move for multiple completed phases.  Reuse
**                       original move for second complete phase. 
**                       Use PhaseTerminal Global when calling jobactions
**                       for Phase move.
**  01/31/01    em       For Visible Break moves, update TO/RS Move Text on 
**                       original move.  In Response column, indicate Restore 
**                       on T/O, completed phases on Restore.
**                       Don't Reset Visible Break status on restore.  Visible
**                       Break is removed if one phase has been removed.
**  03/20/01    my       If the return operating order is already downloaded,
**                       check phase ground, phase break for this order. 
**                       If one of them is anything but all,
**                       the user will not be able to modify the retrun phase
**                       screen.
**  03/28/01    em       Completed Phases are passed in on a Returned Order.                     
**  02/26/03    em       Modified WorkPermitProtection Select
**  09/01/05    em       Screen tuning; If phases are returned from order, then don't 
**                       allow cancel.  Tuning of Phase text for move and response.
**  09/15/05    ysp      Fix phase text for the replacement move.
**  12/14/05    ysp      increase the size of move texts to 160 chars
**  06/07/06    pkw      Add NoOperSt = TRUE when undojobactions.
**  07/21/06    em       Add Support for CurrentlyOpen.  
**                       Like VisibleBreak, if Setting Currently Open,
**                       and device is already listed as open, then it should be closed
**                       until all phases are marked open.  If Clearing Currently Open (closing),
**                       and device is already closed, then it should be closed (not considered open).
**                       The existing Phase Break UndoJobActions logic should take care of this scenario.
**  07/31/06    em       Load Moves logic had to be adjusted for Ground Moves.
**                       
**
*/
INITIALIZE 
(
#  include StandardDeclarations
   BreakMove                    = INTEGER NOT NULL; /*Passed BOOLEAN*/
   GroundMove                   = INTEGER NOT NULL; /*Passed BOOLEAN*/
   CompletedPhases              = CHAR(3) NOT NULL WITH DEFAULT; /*Ret Order*/
   
   BreakOrGroundStatus		= INTEGER NOT NULL; /*SQL Status Parm*/
   BreakOrCurOpen		= INTEGER NOT NULL WITH DEFAULT;  /*VisibleBreak & CurrentlyOpen*/
   CardTypeOfCard               = INTEGER NOT NULL; /*TypeOfCard*/
   CompletePhaseMove            = JobInProgress DEFAULT NULL; /*Compl Phase 2*/
   EquipDescription             = VARCHAR(50) NOT NULL; /*Object Description*/
   NewMoves 			= ARRAY OF JobInProgress; /*Replacement moves*/
   PhaseCharOld                 = VARCHAR(20) NOT NULL;/*List phases complete*/
   PhaseCharNew                 = VARCHAR(20) NOT NULL;/*List phase incomplete*/
   Protections                  = ARRAY OF WorkPermitProtection; /* Copy Prot*/
   p                            = INTEGER NOT NULL; /* Index */  
   SecondCompleteGroundMove     = INTEGER NOT NULL; /* Used only if two phases
                                                       are complete*/
) =
BEGIN 
/*
** If CompletedPhases contains data, then the move has been returned on an 
** order.  The returned phases are marked and user chooses replacement moves.
*/
   IF CompletedPhases <> '' THEN
/* 
** CASE Stmt for valid values: A, B, C, AB, AC, BC
*/
      IF CompletedPhases = 'A' THEN
          Phase.PhaseA = 0;
          Phase.PhaseB = 1;
          Phase.Phasec = 1;
      ELSEIF CompletedPhases = 'B' THEN
          Phase.PhaseA = 1;
          Phase.PhaseB = 0;
          Phase.Phasec = 1;
      ELSEIF CompletedPhases = 'C' THEN
          Phase.PhaseA = 1;
          Phase.PhaseB = 1;
          Phase.Phasec = 0;
      ELSEIF CompletedPhases = 'AB' THEN
          Phase.PhaseA = 0;
          Phase.PhaseB = 0;
          Phase.Phasec = 1;
      ELSEIF CompletedPhases = 'AC' THEN
          Phase.PhaseA = 0;
          Phase.PhaseB = 1;
          Phase.Phasec = 0;
      ELSEIF CompletedPhases = 'BC' THEN
          Phase.PhaseA = 1;
          Phase.PhaseB = 0;
          Phase.Phasec = 0;
      ELSE
/*
** Should not happen since ReceiveAppServer handles data validation.
*/
          MESSAGE 'ERROR: Completed Phases contains invalid data ' +
                  CompletedPhases;
          RETURN PU_CANCEL;
      ENDIF;
      Field(phase).CurBias = FB_VISIBLE;
      FIELD(load_btn).CurBias = FB_LANDABLE;
      FIELD(cancel_btn).CurBias = FB_INVISIBLE;
   ENDIF;            

/*
** BreakMove or GroundMove must be TRUE, but not both
*/
   IF BreakMove = TRUE AND GroundMove = TRUE THEN
      MESSAGE 'Return Operator Moves has incorrectly passed both ' +
              'BreakMove and GroundMove to be TRUE.';
      RETURN PU_CANCEL;
   ENDIF;

   IF GroundMove = TRUE THEN  
      FIELD(MoveTrim).TextValue = 'Ground';
   ELSEIF BreakMove = TRUE THEN
/*
** Need to figure out if this is a VisBreak move or a CurrentlyOpen move.
** Visible Break takes precedence.
*/
      BreakOrCurOpen = 0;
      SELECT :BreakOrCurOpen = 1
      FROM    FMS_JobAction JA
      WHERE   JA.JobClass = :PhaseMove.JobClass AND
              :PhaseMove.EquipClass IN 
                 (SELECT  Type FROM Udb_ExtendedType
                  WHERE   SuperType = JA.EquipClass) AND
              JA.IssueCompl = 1 AND            /*At Move Completion Time*/
              JA.Status = :Status$VisibleBreak; 

      IF BreakOrCurOpen = 0 THEN
         FIELD(MoveTrim).TextValue = 'Currently Open';      
      ELSE
         FIELD(MoveTrim).TextValue = 'Visible Break';
      ENDIF;
   ELSE
      MESSAGE 'Return Operator Moves has incorrectly passed both ' +
              'BreakMove and GroundMove to be FALSE.';
      RETURN PU_CANCEL;
   ENDIF;
/*
** Type of card for new move selection
*/
   CardTypeOfCard = 0;
   SELECT :CardTypeOfCard = TypeOfCard 
   FROM   SOA_ActiveCard
   WHERE  Card = :PhaseMove.Card;

   IF CardTypeOfCard = 0 THEN
      MESSAGE 'Problem determining type of card from card on move.';
      RETURN (PU_CANCEL);
   ENDIF;
/*
** Copy Phase Move in the event we have two phases complete.
*/
   CompletePhaseMove = JobInProgress.Create();
   CompletePhaseMove.JobClass = PhaseMove.JobClass;
   CompletePhaseMove.TOMove = PhaseMove.TOMove;
   CompletePhaseMove.MoveType = PhaseMove.MoveType;
   CompletePhaseMove.TOMoveRules = PhaseMove.TOMoveRules;
   CompletePhaseMove.RSMove = PhaseMove.RSMove;
   CompletePhaseMove.RSMoveRules = PhaseMove.RSMoveRules;
   CompletePhaseMove.MoveEquipClass = PhaseMove.EquipClass;
/*   CompletePhaseMove.StepPair = PhaseMove.StepPair; */
   CompletePhaseMove.Equip = PhaseMove.Equip;
   CompletePhaseMove.EquipClass = PhaseMove.EquipClass;
   CompletePhaseMove.EquipName = PhaseMove.EquipName;
   CompletePhaseMove.EquipClassName = PhaseMove.EquipClassName;
   CompletePhaseMove.DeskName = PhaseMove.DeskName;
   CompletePhaseMove.Substation = PhaseMove.Substation;
   CompletePhaseMove.SwItemStatus = PhaseMove.SwItemStatus;
   CompletePhaseMove.SwitchingItem = PhaseMove.SwitchingItem;
   CompletePhaseMove.MoveCategory = PhaseMove.MoveCategory;
   CompletePhaseMove.ControlCard = PhaseMove.ControlCard;
   CompletePhaseMove.Card = PhaseMove.Card;
   
   IF CompletedPhases = '' THEN
     FIELD(load_btn).CurBias = FB_DIMMED;
   ENDIF;
   FIELD(clear_btn).CurBias = FB_DIMMED;
   FIELD(ok_btn).CurBias = FB_DIMMED;
   CurFrame.StatusText = 'Mark which phases are incomplete...';
END;


ON SETVALUE Phase.PhaseA,
ON SETVALUE Phase.PhaseB,
ON SETVALUE Phase.PhaseC = 
BEGIN
   FIELD(load_btn).CurBias = FB_LANDABLE;
   CurFrame.StatusText = 'When Phases are marked incomplete, click "Load...Moves" button...';
END;


ON CLICK Load_btn =
BEGIN
   SelectMove.Clear();
   NewMoves.Clear();  

   IF Phase.PhaseA = 1 AND Phase.PhaseB = 1 AND Phase.PhaseC = 1 THEN
      MESSAGE 'All Phases cannot be incomplete.';
      RESUME;
   ENDIF;
   IF Phase.PhaseA = 0 AND Phase.PhaseB = 0 AND Phase.PhaseC = 0 THEN
      MESSAGE 'No phases have been marked incomplete.';
      RESUME;
   ENDIF;
/*
**  Load applicable replacement moves for Ground or Break move
**  Moves will be in same step.
*/ 
   IF BreakMove = TRUE THEN
      CurFrame.StatusText = 'Select move to complete the visible break...';
      BreakOrGroundStatus = Status$VisibleBreak;
   ELSE
      CurFrame.StatusText = 'Select move to complete the ground...';
      BreakOrGroundStatus = Status$Ground;
   ENDIF;
   
   IF BreakOrCurOpen = 0 AND BreakMove = TRUE THEN  /* Look for Set or Clear Currently Open Moves */

      i = 1;
      SELECT
      DISTINCT   :SelectMove[i].JobClass = JC.JobClass,
              :SelectMove[i].TOMove = JC.TOMove,
              :SelectMove[i].MoveType = JC.MoveType,
              :SelectMove[i].TOMoveRules = JC.TOMoveRules,
              :SelectMove[i].RSMove = JC.RSMove,
              :SelectMove[i].RSMoveRules = JC.RSMoveRules,
              :SelectMove[i].MoveEquipClass = JCC.EquipClass,
 /*           :SelectMove[i].StepPair = :PhaseMove.StepPair, */
              :SelectMove[i].Equip = :PhaseMove.Equip,
              :SelectMove[i].EquipClass = :PhaseMove.EquipClass,
              :SelectMove[i].EquipName = :PhaseMove.EquipName,
              :SelectMove[i].EquipClassName = :PhaseMove.EquipClassName,
              :SelectMove[i].DeskName = :PhaseMove.DeskName,
              :SelectMove[i].Substation = :PhaseMove.Substation,
              :SelectMove[i].SwItemStatus = :PhaseMove.SwItemStatus,
              :SelectMove[i].SwitchingItem = :PhaseMove.SwitchingItem,
              :SelectMove[i].MoveCategory = :PhaseMove.MoveCategory,
              :SelectMove[i].ControlCard = :PhaseMove.ControlCard,
              :SelectMove[i].Card = :PhaseMove.Card
      FROM    FMS_JobClass JC,
              FMS_JobClassControl JCC,
              FMS_JobAction JA
      WHERE   JCC.JobClass = JC.JobClass AND
              :PhaseMove.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                        WHERE  SuperType = JCC.EquipClass) AND
/*              JCC.StepPair = :PhaseMove.StepPair AND      */
              JCC.TypeOfCard = :CardTypeOfCard AND
              JCC.JobClass = JA.JobClass AND
              JCC.EquipClass = JA.EquipClass AND
/*              JCC.StepPair = JA.StepPair AND
             */       
              JCC.TypeOfCard = JA.TypeOfCard AND
              JA.Status IN (:Prompt$SetCurrentlyOpen, :Prompt$ClearCurrentlyOpen) AND
              JA.IssueCompl = 1    /*Completion*/
      BEGIN
         i = i + 1;
      END;
   ELSE
      i = 1;
      SELECT
      DISTINCT   :SelectMove[i].JobClass = JC.JobClass,
              :SelectMove[i].TOMove = JC.TOMove,
              :SelectMove[i].MoveType = JC.MoveType,
              :SelectMove[i].TOMoveRules = JC.TOMoveRules,
              :SelectMove[i].RSMove = JC.RSMove,
              :SelectMove[i].RSMoveRules = JC.RSMoveRules,
              :SelectMove[i].MoveEquipClass = JCC.EquipClass,
 /*           :SelectMove[i].StepPair = :PhaseMove.StepPair, */
              :SelectMove[i].Equip = :PhaseMove.Equip,
              :SelectMove[i].EquipClass = :PhaseMove.EquipClass,
              :SelectMove[i].EquipName = :PhaseMove.EquipName,
              :SelectMove[i].EquipClassName = :PhaseMove.EquipClassName,
              :SelectMove[i].DeskName = :PhaseMove.DeskName,
              :SelectMove[i].Substation = :PhaseMove.Substation,
              :SelectMove[i].SwItemStatus = :PhaseMove.SwItemStatus,
              :SelectMove[i].SwitchingItem = :PhaseMove.SwitchingItem,
              :SelectMove[i].MoveCategory = :PhaseMove.MoveCategory,
              :SelectMove[i].ControlCard = :PhaseMove.ControlCard,
              :SelectMove[i].Card = :PhaseMove.Card
      FROM    FMS_JobClass JC,
              FMS_JobClassControl JCC,
              FMS_JobAction JA
      WHERE   JCC.JobClass = JC.JobClass AND
              :PhaseMove.EquipClass IN (SELECT Type FROM Udb_ExtendedType
                                        WHERE  SuperType = JCC.EquipClass) AND
/*              JCC.StepPair = :PhaseMove.StepPair AND      */
              JCC.TypeOfCard = :CardTypeOfCard AND
              JCC.JobClass = JA.JobClass AND
              JCC.EquipClass = JA.EquipClass AND
/*              JCC.StepPair = JA.StepPair AND
             */       
              JCC.TypeOfCard = JA.TypeOfCard AND
              JA.Status = :BreakOrGroundStatus AND
              JA.IssueCompl = 1    /*Completion*/
      BEGIN
         i = i + 1;
      END;
   ENDIF;
  
   IF i = 1 THEN
      MESSAGE 'Error - Could not find any replacement moves.';
      RESUME;
   ENDIF;

   FIELD(load_btn).CurBias = FB_DIMMED;
   FIELD(clear_btn).CurBias = FB_LANDABLE;
   FIELD(Phase).CurBias = FB_VISIBLE;
/*
** Build Phase Text to add to move or insert into response
*/
   PhaseCharOld = '';
   PhaseCharNew = '';

   IF Phase.PhaseA = 0 THEN
      PhaseCharOld = 'A';
   ELSE
      PhaseCharNew = 'A';
   ENDIF;
   IF Phase.PhaseB = 0 THEN
      IF Length(PhaseCharOld) = 0 THEN
         PhaseCharOld = 'B';
      ELSE
         PhaseCharOld = PhaseCharOld + ',B';
      ENDIF;
   ELSE
      IF PhaseCharNew = '' THEN
         PhaseCharNew = 'B';
      ELSE
         PhaseCharNew = PhaseCharNew + ',B';
      ENDIF;
   ENDIF;
   IF Phase.PhaseC = 0 THEN
      IF Length(PhaseCharOld) = 0 THEN
         PhaseCharOld = PhaseCharOld + 'C';
      ELSE
         PhaseCharOld = PhaseCharOld + ',C';
      ENDIF;
   ELSE
      IF PhaseCharNew = '' THEN
         PhaseCharNew = 'C';
      ELSE
         PhaseCharNew = PhaseCharNew + ',C';
      ENDIF;
   ENDIF;
   IF PhaseCharNew <> '' THEN
      PhaseCharNew = PhaseCharNew + ' Phase';
   ENDIF;
END;


ON ChildEntry SelectMove =
BEGIN
/*
** Capture replacement move
*/
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN 
       RESUME;
   ENDIF;

   EquipDescription = '';
   SELECT :EquipDescription = SQUEEZE(Description)
   FROM   Udb_Object
   WHERE  Object = :PhaseMove.Equip;

   IF EquipDescription <> '' THEN
      EquipDescription = EquipDescription + ' ';
   ENDIF;
   
   NewMoves.Clear();
   IF BreakMove = TRUE THEN
      NewMoves[1] = SelectMove[].Duplicate();     
      NewMoves[1].TOMove = EquipDescription + NewMoves[1].TOMove + ' - ' +
                           PhaseMove.EquipName + ' - ' + PhaseCharNew;
      NewMoves[1].RSMove = EquipDescription + NewMoves[1].RSMove + ' - ' +
                           PhaseMove.EquipName + ' - ' + PhaseCharNew;
   ELSE
/*
** Force one move for each phase for TakeOut moves; 
** original move gets tabbed for first complete phase.  
** At least one phase is complete.  The first of A,B,C that is complete
** will be applied to current move. 
** Only add moves on Restore side if the Phase was incomplete.
*/
      IF PhaseMove.Status = Job$TakeOut THEN
         SecondCompleteGroundMove = 0;
         PhaseCharOld = '';  /*Start over for grounds moves*/
      ENDIF;

      i = 0;
      IF Phase.PhaseA = 1 THEN
         i = i + 1;
         NewMoves[i] = SelectMove[].Duplicate();     
         NewMoves[i].TOMove = EquipDescription + NewMoves[i].TOMove + ' - ' +
                              PhaseMove.EquipName +  ' - A Phase';
         NewMoves[i].RSMove = EquipDescription + NewMoves[i].RSMove + ' - ' +          
                              PhaseMove.EquipName +  ' - A Phase';
         NewMoves[i].MoveType = MoveType$Phase;
      ELSEIF PhaseMove.Status = Job$TakeOut THEN
         PhaseCharOld = 'A Phase';  /*Phase A was complete*/
      ENDIF;

      IF Phase.PhaseB = 1 THEN 
         i = i + 1;
         NewMoves[i] = SelectMove[].Duplicate();     
         NewMoves[i].TOMove = EquipDescription + NewMoves[i].TOMove + ' - ' +
                              PhaseMove.EquipName +  ' - B Phase';
         NewMoves[i].RSMove = EquipDescription + NewMoves[i].RSMove + ' - ' +         
                              PhaseMove.EquipName +  ' - B Phase';
         NewMoves[i].MoveType = MoveType$Phase;
/*
** Use original move if this is second complete phase
*/ 
      ELSEIF (PhaseCharOld <> '' AND PhaseMove.Status = Job$TakeOut) THEN
         i = i + 1;
         NewMoves[i] = CompletePhaseMove.Duplicate();     
         NewMoves[i].TOMove = NewMoves[i].TOMove +  ' - B Phase';
         NewMoves[i].RSMove = NewMoves[i].RSMove +  ' - B Phase';
         NewMoves[i].MoveType = MoveType$Phase;
         SecondCompleteGroundMove = i;

      ELSEIF PhaseMove.Status = Job$TakeOut THEN
         PhaseCharOld = 'B Phase';  /*Phase B was complete and phase A was not*/
      ENDIF;

      IF Phase.PhaseC = 1 THEN
         i = i + 1;
         NewMoves[i] = SelectMove[].Duplicate();     
         NewMoves[i].TOMove = EquipDescription + NewMoves[i].TOMove + ' - ' +
                              PhaseMove.EquipName +  ' - C Phase';
         NewMoves[i].RSMove = EquipDescription + NewMoves[i].RSMove + ' - ' +          
                              PhaseMove.EquipName +  ' - C Phase';
         NewMoves[i].MoveType = MoveType$Phase;
/*
** Use original move if this is second complete phase
*/ 
      ELSEIF (PhaseCharOld <> '' AND PhaseMove.Status = Job$TakeOut) THEN
         i = i + 1;
         NewMoves[i] = CompletePhaseMove.Duplicate();     
         NewMoves[i].TOMove = NewMoves[i].TOMove +  ' - C Phase';
         NewMoves[i].RSMove = NewMoves[i].RSMove +  ' - C Phase';
         NewMoves[i].MoveType = MoveType$Phase;
         SecondCompleteGroundMove = i;

      ELSEIF PhaseMove.Status = Job$TakeOut THEN
         PhaseCharOld = 'C Phase';  /*Phase C was only complete phase*/
      ENDIF;
   ENDIF;

   IF PhaseMove.Status = Job$Restore THEN
      FOR i = 1 TO NewMoves.LastRow() DO
          NewMoves[i].TOMove = NewMoves[i].RSMove;
      ENDFOR;
   ENDIF;

   IF NewMoves.LastRow() = 0 THEN
      CurFrame.StatusText = 'Please select a replacement move for the ' +
                            'incomplete phases...';
   ELSE    
       CurFrame.StatusText = 'Confirm replacement move and "OK" to insert or ' +
                             '"Clear" to change...';
   ENDIF;        
   FIELD(ok_btn).CurBias = FB_LANDABLE;

END;


ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return(PU_CANCEL);
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
/*
** Update response for old job, insert replacement moves. 
*/
   RetCode = 0;
   FOR i = 1 TO NewMoves.LastRow() DO
       NewMoves[i].Job = NewMoves[i].InsertMove (
                    CardTypeOfCard = CardTypeOfCard,
                    KeepMoveText = TRUE);

       IF NewMoves[i].Job < 0 THEN
          MESSAGE 'Insertion of replacement move ' + VARCHAR(i) + ' failed.';
          RESUME;
       ENDIF;
   ENDFOR;
/*
** For Break Move, Update Response and Move Text.
*/ 
   IF BreakMove = TRUE THEN

      IF PhaseMove.Status = Job$TakeOut THEN
         RetCode = CALLPROC SOA_JobMoveTextUpd (
               Job = PhaseMove.Job,
               TOMove = PhaseMove.TOMove + ' - ' + PhaseCharOld + ' Phase Only',
               RSMove = PhaseMove.RSMove);
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to change move text for old move.';
         ENDIF;

         IF PhaseMove.TOMove NOT LIKE '% Phase %' THEN

            RetCode = CALLPROC SOA_JobResponseUpd (
               Job = PhaseMove.Job,
               NewResponse = 'Restore All Phases');
         ENDIF;
      ELSE
/*
** Get TO Move text from database since display is showing RS move in TO move
** field.
*/
         SELECT :PhaseMove.TOMove = TOMove
         FROM   SOA_Job
         WHERE  Job = :PhaseMove.Job;            
         RetCode = CALLPROC SOA_JobMoveTextUpd (
               Job = PhaseMove.Job,
               TOMove = PhaseMove.TOMove,
               RSMove = PhaseMove.RSMove + ' - ' + PhaseCharOld + ' Phase Only');
         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to change move text for old move.';
         ENDIF;

         RetCode = CALLPROC SOA_JobResponseUpd (
               Job = PhaseMove.Job,
               NewResponse = 'Only ' + PhaseCharOld + ' Restored');
      ENDIF;
   ENDIF;

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to mark completed phases in Response column of old move.';
   ENDIF;
/*
** If a Ground Move, update MoveType for original move
*/   
   IF GroundMove = TRUE THEN
      RetCode = CALLPROC SOA_JobMoveTextUpd (
               Job = PhaseMove.Job,
               TOMove = PhaseMove.TOMove + ' - ' + PhaseCharOld,
               RSMove = PhaseMove.RSMove + ' - ' + PhaseCharOld);
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to change move text for old move.';
      ENDIF;

      RetCode = CALLPROC SOA_JobMoveTypeUpd (
               Job = PhaseMove.Job,
               MoveType = MoveType$Phase);
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to mark move type as Phased for old move.';
      ENDIF;
   ENDIF;    
/*
**  If visible break, clear statuses that were set at completion by using
**  UndoJobActions method.
**  If we are on Restore side, blank out Newmove TakeOut.  If we
**  are on TakeOut side, blank out NewMove Restore.
*/
   IF BreakMove = TRUE THEN  

      IF PhaseMove.Status = Job$TakeOut THEN

         NewMoves[1].Status = Job$TakeOut;
         RetCode = NewMoves[1].UndoJobActions(IssueCompl = JobClass$Complete,
                                              NoOperSt = TRUE);
      
         IF RetCode = PU_CANCEL THEN
            MESSAGE 'Replacement move inserted, but visible break status ' +
                    'could not be removed.  Use Caution on this card.';
         ENDIF;

         RetCode = CALLPROC SOA_IssueMove(Job = NewMoves[1].Job,
                                    Issued = '',
                                    Operator = Operator$SOCCSX,
                                    Status = Job$Restore
                                   );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but Restore could not be ' +
                    'auto-issued.  Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_CompleteMove(Job = NewMoves[1].Job,
                                       Complete = '',
                                       Status = Job$Restore
                                       );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but Restore could not be ' +
                    'auto-completed.  Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;

      ELSE

         NewMoves[1].Status = Job$Restore;
/*
** Don't undo job actions at Restore.  We want the Visible Break to clear
** if any phase is complete.
*
         RetCode = NewMoves[1].UndoJobActions(IssueCompl = JobClass$Complete,
                                              NoOperSt = TRUE);
      
         IF RetCode = PU_CANCEL THEN
            MESSAGE 'Replacement move inserted, but visible break status ' +
                    'could not be reset.  Use Caution on this card.';
            RESUME;
         ENDIF;
*/
         RetCode = CALLPROC SOA_IssueMove(Job = NewMoves[1].Job,
                                    Issued = '',
                                    Operator = Operator$SOCCSX,
                                    Status = Job$TakeOut
                                   );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                    'auto-issued.  Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_CompleteMove(Job = NewMoves[1].Job,
                                       Complete = '',
                                       Status = Job$TakeOut
                                       );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                    'auto-completed.  Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;
  
      ENDIF;

   ELSE
/*
** This is a Ground Move, if Restore or if SecondCompleteGroundMove <> 0, 
** Auto issue complete takeout side for 
** replacement moves and perform jobactions.
*/
      IF PhaseMove.Status = Job$Restore THEN
         NewMoves[1].Status = Job$TakeOut;
         RetCode = NewMoves[1].JobActions(IssueCompl = JobClass$Complete,
				          InTerminal = PhaseTerminal);
         IF RetCode = PU_CANCEL THEN
            MESSAGE 'Replacement move inserted, but ground status ' +
                    'could not be reset.  Must Issue and Complete manually.';
            RESUME;
         ENDIF;

         RetCode = CALLPROC SOA_IssueMove(Job = NewMoves[1].Job,
                                    Issued = 'now',
                                    Operator = Operator$SOCCSX,
                                    Status = Job$TakeOut
                                   );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                    'auto-issued. Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         RetCode = CALLPROC SOA_CompleteMove(Job = NewMoves[1].Job,
                                       Complete = 'now',
                                       Status = Job$TakeOut
                                       );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                    'auto-completed. Use Caution on this card.';
         ENDIF;
         CALLPROC DDB_COMMIT;
/*
** Check if we have two rows; cannot have more than two
*/
         IF NewMoves.LastRow() > 1 THEN
            NewMoves[2].Status = Job$TakeOut;
            RetCode = NewMoves[2].JobActions(IssueCompl = JobClass$Complete,
                                             InTerminal = PhaseTerminal);
            IF RetCode = PU_CANCEL THEN
               MESSAGE 'Replacement move two inserted, but ground status ' +
                       'could not be reset.  Must issue and complete manually.';
               RESUME;
            ENDIF;

            RetCode = CALLPROC SOA_IssueMove(Job = NewMoves[2].Job,
                                    Issued = 'now',
                                    Operator = Operator$SOCCSX,
                                    Status = Job$TakeOut
                                   );
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                       'auto-issued.  Use Caution on this card.';
            ENDIF;
            CALLPROC DDB_COMMIT;

            RetCode = CALLPROC SOA_CompleteMove(Job = NewMoves[2].Job,
                                       Complete = 'now',
                                       Status = Job$TakeOut
                                       );
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                       'auto-completed.  Use Caution on this card.';
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;

      ELSE    /* TakeOut side, check for second move and auto issue if there*/ 

         IF SecondCompleteGroundMove <> 0 THEN
            i = SecondCompleteGroundMove;
            NewMoves[i].Status = Job$TakeOut;
            RetCode = NewMoves[i].JobActions(IssueCompl = JobClass$Complete,
                                             InTerminal = PhaseTerminal);
            IF RetCode = PU_CANCEL THEN
               MESSAGE 'Replacement move two inserted, but ground status ' +
                       'could not be reset.  Must issue and complete manually.';
               RESUME;
            ENDIF;

            RetCode = CALLPROC SOA_IssueMove(Job = NewMoves[i].Job,
                                    Issued = 'now',
                                    Operator = Operator$SOCCSX,
                                    Status = Job$TakeOut
                                   );
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                       'auto-issued.  Use Caution on this card.';
            ENDIF;
            CALLPROC DDB_COMMIT;

            RetCode = CALLPROC SOA_CompleteMove(Job = NewMoves[i].Job,
                                       Complete = 'now',
                                       Status = Job$TakeOut
                                       );
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Replacement move inserted, but TakeOut could not be ' +
                       'auto-completed.  Use Caution on this card.';
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF;
/*
** Copy any existing protection links to the new move.
*/
   i = 1;
   SELECT   :Protections[i].PermitCardType = PermitCardType, 
            :Protections[i].PermitCard = PermitCard, 
            :Protections[i].PermitJobId = PermitJobId, 
            :Protections[i].ProtectionCardType = ProtectionCardType, 
            :Protections[i].ProtectionCard = ProtectionCard 
   FROM     FMS_WorkPermitProtection
   WHERE    ProtectionJobId = :PhaseMove.Job AND
            ProtectionCardType = 0   /*Non-TLS*/
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO Protections.LastRow() DO
      FOR p = 1 TO NewMoves.LastRow() DO
             RetCode = CALLPROC FMS_ApplyProtection (
                     PermitCardType = Protections[i].PermitCardType,
                     PermitCard = Protections[i].PermitCard,
                     PermitJob = Protections[i].PermitJobId,
                     ProtectionCardType = Protections[i].ProtectionCardType,
                     ProtectionCard = Protections[i].ProtectionCard,
                     ProtectJob = NewMoves[p].Job);
              IF RetCode <> 0 THEN
                 CALLPROC DDB_ROLLBACK;
                 Message 'Error occurred copying protection links. ' +
                         'You will need to manually verify protection links ' +
                         'for the new phase moves';
              ENDIF;
              CALLPROC DDB_COMMIT;
      ENDFOR;
   ENDFOR;

   RETURN (PU_OK);
END;


ON CLICK Cancel_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    IF CurFrame.ConfirmPopUp (messagetext = 'Exit without marking phases incomplete?') =
        PU_OK THEN
       RETURN (PU_CANCEL);
    ENDIF; 
END;


ON CLICK Clear_btn =
BEGIN
/*
** Set screen back to defaults
*/
   Phase.PhaseA = 0;
   Phase.PhaseB = 0;
   Phase.PhaseC = 0;
   SelectMove.Clear();
   NewMoves.Clear();  
   FIELD(ok_btn).CurBias = FB_DIMMED;
   FIELD(load_btn).CurBias = FB_DIMMED;
   FIELD(clear_btn).CurBias = FB_DIMMED;
   FIELD(Phase).CurBias = FB_CHANGEABLE;
   CurFrame.StatusText = 'Mark which phases are incomplete...';
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;
