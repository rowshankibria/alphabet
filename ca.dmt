/*
**
**      Copyright c 2009 Pateric Software, LLC.  All rights reserved.
**
**      Pateric Software, LLC. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software, LLC.
**
**  Application:    CAC
**  Class:          WorkGroupRequest_ASE
**
**  Date:       Version Description
** ----------------------------------
**  05/27/09  ysp  Created.
**  06/23/09  ysp  Use report category for line type
**  05/04/18  ysp  Add Priority attribute in the request
**  05/11/18  em   Add LoadAckList method
**  05/21/18  em   Add Responders to LoadAckList
*/ 
METHOD LoadRequestList (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/

   BackTrackTime = DATE NOT NULL WITH DEFAULT;
   CardObject   = TLSCard_ASE;
   DynamicWhereClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   EndDate   = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   CurObject.GroupFilter = UPPERCASE(CurObject.GroupFilter);

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;

   IF CurObject.Application = 'ONLINE' THEN
      IF LowerCase(CurObject.StatusFilter) = 'issued' then
         DynamicWhereClause = ' R.Status =' + VARCHAR(Order$Downloaded) + ' AND ';   

      ELSEIF LowerCase(CurObject.StatusFilter) = 'responded' then
         DynamicWhereClause = ' R.Status IN (' + VARCHAR(Order$Closed) + ',' +  VARCHAR(Order$ConfirmClosed) + ') AND ' + 
                        ' R.DownloadTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
                        ' R.DownloadTime < DATE(''' + VARCHAR(EndDate) + ''') AND ';
      ENDIF;            
      DynamicWhereClause = DynamicWhereClause  + 
                           ' R.WorkGroup = ''' + CurObject.GroupFilter + ''' AND ' + 
                           ' R.Card = C.Card AND ' + 
                           ' R.Job  = J.Job AND ' + 
                           ' J.JobClass = JC.JobClass ';
   ELSE
      IF LowerCase(CurObject.StatusFilter) = 'overdue' then
         SELECT :BackTrackTime = Date('now') - '4 HOURS';

         DynamicWhereClause = ' R.Status =' + VARCHAR(Order$Downloaded) + ' AND ' +   
                              ' R.IssueTime <= DATE(''' + VARCHAR(BackTrackTime) + ''') AND ';

      ELSEIF LowerCase(CurObject.StatusFilter) = 'active' then
         DynamicWhereClause = ' R.Status BETWEEN ' + VARCHAR(Order$Opened) + 
                                         ' AND ' + VARCHAR(Order$Closed) + ' AND ';

      ELSEIF LowerCase(CurObject.StatusFilter) = 'closed' then
         DynamicWhereClause = ' R.Status >= ' + VARCHAR(Order$Rescinded) + ' AND ' + 
                        ' R.IssueTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
                        ' R.IssueTime < DATE(''' + VARCHAR(EndDate) + ''') AND ';

      ENDIF;
      DynamicWhereClause = DynamicWhereClause  + 
                              ' R.Card = C.Card AND ' + 
                              ' R.Job  = J.Job AND ' + 
                              ' J.JobClass = JC.JobClass ';
   ENDIF;
 
// CurMethod.Trace(Text = 'dynamic where clause: ' + DynamicWhereClause);
 

   i = 1;
   SELECT :CurObject.ReqList[i].RequestID = R.RequestID,
          :CurObject.ReqList[i].Status = R.Status,
          :CurObject.ReqList[i].Card = R.Card,
          :CurObject.ReqList[i].Job = R.Job,
          :CurObject.ReqList[i].TORS = R.TORS,
          :CurObject.ReqList[i].JobClass = J.JobClass,
          :CurObject.ReqList[i].RequestType = JC.TOMove,
          :CurObject.ReqList[i].WorkGroup = R.WorkGroup,
          :CurObject.ReqList[i].Circuit = R.Circuit,
          :CurObject.ReqList[i].RouteName = C.RouteName,
          :CurObject.ReqList[i].LineNumber = C.Linenumber,
          :CurObject.ReqList[i].LineType = C.LineType,
          :CurObject.ReqList[i].Priority = C.Priority,
          :CurObject.ReqList[i].MeetTime = R.MeetTime,
          :CurObject.ReqList[i].Location = R.Location,
          :CurObject.ReqList[i].DOComment = R.DOComment,
          :CurObject.ReqList[i].IssuedByDO = R.IssuedByDO,
          :CurObject.ReqList[i].IssueTime = R.IssueTime,
          :CurObject.ReqList[i].DownloadTime = R.DownloadTime,
          :CurObject.ReqList[i].RescindTime = R.RescindTime,
          :CurObject.ReqList[i].RescindDO = R.RescindDO,
          :CurObject.ReqList[i].RescindType = R.RescindType,
          :CurObject.ReqList[i].RescindReasonTypeName = R.RescindReasonTypeName,
          :CurObject.ReqList[i].RescindComment = R.RescindComment
   FROM   TC_WorkGroupRequest R,
          TC_Card C,
          TC_Job J,
          FMS_JobClass JC
   WHERE  :DynamicWhereClause
   UNION
   SELECT R.RequestID,
          R.Status,
          R.Card,
          R.Job,
          R.TORS,
          J.JobClass,
          JC.TOMove,
          R.WorkGroup,
          R.Circuit,
          C.RouteName,
          C.Linenumber,
          C.LineType,
          '',
          R.MeetTime,
          R.Location,
          R.DOComment,
          R.IssuedByDO,
          R.IssueTime,
          R.DownloadTime,
          R.RescindTime,
          R.RescindDO,
          R.RescindType,
          R.RescindReasonTypeName,
          R.RescindComment
   FROM   TC_WorkGroupRequest R,
          TC_ArchiveCard C,
          TC_ArchiveJob J,
          FMS_JobClass JC
   WHERE  :DynamicWhereClause
   ORDER BY 1
   BEGIN
      IF CurObject.ReqList[i].Status = Order$Opened THEN
         CurObject.ReqList[i].StatusName = 'OPENED';
      ELSEIF CurObject.ReqList[i].Status = Order$Downloaded THEN
         CurObject.ReqList[i].StatusName = 'ISSUED';
      ELSEIF CurObject.ReqList[i].Status = Order$Closed THEN
         CurObject.ReqList[i].StatusName = 'RESPONDED';
      ELSEIF CurObject.ReqList[i].Status = Order$ConfirmClosed THEN
         CurObject.ReqList[i].StatusName = 'COMPLETED';
      ELSEIF CurObject.ReqList[i].Status = Order$Rescinded THEN
         CurObject.ReqList[i].StatusName = 'RESCINDED';
      ELSEIF CurObject.ReqList[i].Status = Order$ConfirmRescinded THEN
         CurObject.ReqList[i].StatusName = 'RESCINDED';
      ENDIF;

      CurObject.ReqList[i].LineTypeName = CALLPROC GetCircuitReportCategory(
                                CircuitType = CurObject.ReqList[i].LineType);

      /*
      ** load email recipients
      */
      j = 1;
      SELECT :CurObject.ReqList[i].Recipients[j].Name = Name,
             :CurObject.ReqList[i].Recipients[j].RecipientID = RecipientID,
             :CurObject.ReqList[i].Recipients[j].Grouping = Grouping,
             :CurObject.ReqList[i].Recipients[j].ResponseTime = ResponseTime,
             :CurObject.ReqList[i].Recipients[j].RespondedBy = RespondedBy,
             :CurObject.ReqList[i].Recipients[j].ResponseText = ResponseText,
             :CurObject.ReqList[i].Recipients[j].ResponseComment = ResponseComment
      FROM   TC_WGRequestRecipient
      WHERE  RequestID = :CurObject.ReqList[i].RequestID
      ORDER BY ResponseTime ASC
      BEGIN
         j = j + 1;
      END;

      /*
      ** load substations and feeders
      */
      IF CurObject.Application = 'ONLINE' THEN
         CardObject.Circuit = CurObject.ReqList[i].Circuit;
         CardObject.C.Feeders.Clear();
         CardObject.C.Stations.Clear();
         CardObject.LoadFeedersAndStations();

         CurObject.ReqList[i].Feeders = CardObject.C.Feeders.Duplicate();
         CurObject.ReqList[i].Stations = CardObject.C.Stations.Duplicate();
      ENDIF;
      i = i + 1;
   END;       
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadAckList (
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/

   CardObject   = TLSCard_ASE;
   DynamicWhereClause = VARCHAR(400) NOT NULL WITH DEFAULT;
   EndDate   = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   i = 1;
   SELECT :CurObject.AckList[i].RequestID = R.RequestID,
          :CurObject.AckList[i].Status = R.Status,
          :CurObject.AckList[i].Card = R.Card,
          :CurObject.AckList[i].Job = R.Job,
          :CurObject.AckList[i].TORS = R.TORS,
          :CurObject.AckList[i].JobClass = J.JobClass,
          :CurObject.AckList[i].RequestType = JC.TOMove,
          :CurObject.AckList[i].WorkGroup = R.WorkGroup,
          :CurObject.AckList[i].Circuit = R.Circuit,
          :CurObject.AckList[i].RouteName = C.RouteName,
          :CurObject.AckList[i].LineNumber = C.Linenumber,
          :CurObject.AckList[i].LineType = C.LineType,
          :CurObject.AckList[i].Priority = C.Priority,
          :CurObject.AckList[i].MeetTime = R.MeetTime,
          :CurObject.AckList[i].Location = R.Location,
          :CurObject.AckList[i].DOComment = R.DOComment,
          :CurObject.AckList[i].IssuedByDO = R.IssuedByDO,
          :CurObject.AckList[i].IssueTime = R.IssueTime,
          :CurObject.AckList[i].DownloadTime = R.DownloadTime,
          :CurObject.AckList[i].RescindTime = R.RescindTime,
          :CurObject.AckList[i].RescindDO = R.RescindDO,
          :CurObject.AckList[i].RescindType = R.RescindType,
          :CurObject.AckList[i].RescindReasonTypeName = R.RescindReasonTypeName,
          :CurObject.AckList[i].RescindComment = R.RescindComment
   FROM   TC_WorkGroupRequest R,
          TC_WGRequestAck A,
          TC_Card C,
          TC_Job J,
          FMS_JobClass JC
   WHERE  R.RequestID = A.RequestID AND 
          R.Card = C.Card AND 
          R.Job  = J.Job AND 
          J.JobClass = JC.JobClass 
   UNION
   SELECT R.RequestID,
          R.Status,
          R.Card,
          R.Job,
          R.TORS,
          J.JobClass,
          JC.TOMove,
          R.WorkGroup,
          R.Circuit,
          C.RouteName,
          C.Linenumber,
          C.LineType,
          '',
          R.MeetTime,
          R.Location,
          R.DOComment,
          R.IssuedByDO,
          R.IssueTime,
          R.DownloadTime,
          R.RescindTime,
          R.RescindDO,
          R.RescindType,
          R.RescindReasonTypeName,
          R.RescindComment
   FROM   TC_WorkGroupRequest R,
          TC_WGRequestAck A,
          TC_ArchiveCard C,
          TC_ArchiveJob J,
          FMS_JobClass JC
   WHERE  R.RequestID = A.RequestID AND 
          R.Card = C.Card AND 
          R.Job  = J.Job AND 
          J.JobClass = JC.JobClass 
   ORDER BY 1
   BEGIN
      IF CurObject.AckList[i].Status = Order$Opened THEN
         CurObject.AckList[i].StatusName = 'OPENED';
      ELSEIF CurObject.AckList[i].Status = Order$Downloaded THEN
         CurObject.AckList[i].StatusName = 'ISSUED';
      ELSEIF CurObject.AckList[i].Status = Order$Closed THEN
         CurObject.AckList[i].StatusName = 'RESPONDED';
      ELSEIF CurObject.AckList[i].Status = Order$ConfirmClosed THEN
         CurObject.AckList[i].StatusName = 'COMPLETED';
      ELSEIF CurObject.AckList[i].Status = Order$Rescinded THEN
         CurObject.AckList[i].StatusName = 'RESCINDED';
      ELSEIF CurObject.AckList[i].Status = Order$ConfirmRescinded THEN
         CurObject.AckList[i].StatusName = 'RESCINDED';
      ENDIF;
      /*
      ** load email recipients
      */
      j = 1;
      SELECT :CurObject.AckList[i].Recipients[j].Name = Name,
             :CurObject.AckList[i].Recipients[j].RecipientID = RecipientID,
             :CurObject.AckList[i].Recipients[j].Grouping = Grouping,
             :CurObject.AckList[i].Recipients[j].ResponseTime = ResponseTime,
             :CurObject.AckList[i].Recipients[j].RespondedBy = RespondedBy,
             :CurObject.AckList[i].Recipients[j].ResponseText = ResponseText,
             :CurObject.AckList[i].Recipients[j].ResponseComment = ResponseComment
      FROM   TC_WGRequestRecipient
      WHERE  RequestID = :CurObject.AckList[i].RequestID
      ORDER BY ResponseTime ASC
      BEGIN
         j = j + 1;
      END;
      i = i + 1;
   END;       

   CALLPROC DDB_ROLLBACK;
END;

