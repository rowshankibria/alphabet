Application Component Report
============================

	Name:            ParseTextForInteger

/*
**
**      Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
**  Application:    SLC
**  Frame:          TextParser
**
**  Date:       Version Description
** ----------------------------------
**  07/18/95    hlf     parse text to determine if text is integer
*/
PROCEDURE ParseTextForInteger(
    ParseText = VARCHAR(15);                /* text to parse */
/*
**  Local Parameters
*/
    i = INTEGER NOT NULL WITH DEFAULT;      /* counter variable */
    k = INTEGER NOT NULL WITH DEFAULT;      /* counter variable */
    SetArray = ARRAY OF INTEGEROBJECT;            /* set of integers */
    CharSet = CHAR(1);                      /* parsed character */
    Text = VARCHAR(15);                     /* duplicate of parsetext */
) =
BEGIN
    Text = ParseText;
/*
**  Load up the array of integers
*/
    i = 1;
    WHILE (i <= 10) DO
        k = i - 1;
        SetArray[i].Value = k;
        i = i + 1;
    ENDWHILE;


    i = 1;
    WHILE (i <= Length(Text)) DO
        CharSet = CharExtract(Text,i);
        k = 1;
        WHILE (k <= SetArray.LastRow()) DO
        /*
        **  If the value matches, go to the next value
        */
            IF (CharSet = VARCHAR(SetArray[k].Value)) THEN
                ENDLOOP;
            ELSEIF (k = SetArray.LastRow()) THEN
        /*
        ** If the value didn't match, then the whole thing isn't an integer 
        **  so return false
        */
                RETURN (FALSE);
            ENDIF;
            k = k + 1;
        ENDWHILE;
        i = i + 1;
    ENDWHILE;
    RETURN (TRUE);
END;

