	Name:            SelectMove

/*
**      Copyright c 1997 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    CAC
**  Frame:          SelectMove
**
**  Modifications:
**  03/23/97 jfl    Created
**  09/16/02 ysp    Merge: use SOA common job tables.
**  12/14/05 ysp    Increase the size of tomove to 160 chars
**  07/23/13 ysp    Moved from FeederCard
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;                    /* Optional: passed card       */
    Title = VARCHAR(80) NOT NULL WITH DEFAULT;  /* optional: passed screen title */
    
    i = INTEGER NOT NULL;           /* Counter              */
    SelectRow = INTEGER NOT NULL;   /* Clicked RowNumber    */
) =
BEGIN
   IF Title <> '' THEN
      FIELD(SelectMove).Title = Title;
   ENDIF;

   /*
**  Load Moves for the passed card
*/
   IF Card > 0 THEN      
      SelectMove.Clear();
      i = 1;
      SELECT
        :SelectMove[i].Job = J.Job,
        :SelectMove[i].ToMove = J.ToMove,
        :SelectMove[i].Seq = JC.Seq
      FROM SOA_Job J,
         SOA_JobControl JC
      WHERE JC.Card = :Card
      AND JC.Job = J.Job
      AND J.JobClass <> 0
      AND J.Status <> 'Del'
      ORDER BY Seq
      BEGIN
        i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;


On Childentry SelectMove =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Deselect eventual selected row
*/
    SelectedMove = NULL;
/*
**  Update row selected
*/
    SelectRow = FIELD(SelectMove).CurRow;
    SelectedMove = SelectMove[SelectRow].Duplicate();
END;


ON Click Exit_Btn =
BEGIN
    RETURN SelectedMove.Job;
END;

ON Click Cancel_Btn =
BEGIN
    RETURN 0;
END;


ON WindowClose =
BEGIN
    RESUME;
END;


