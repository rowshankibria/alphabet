METHOD NewMatrix (
)=
DECLARE
   i          = INTEGER NOT NULL;
   j          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Note name filter */
   COUserName = VARCHAR(40) NOT NULL;
   RetCode    = INTEGER NOT NULL;
   DynamicWhereClause = VARCHAR(400) NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to create a new matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.fList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No feeders were selected.  Please try again.';
      RETURN;
   ENDIF;

   IF CurObject.cList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No circuits were selected.  Please try again.';
      RETURN;
   ENDIF;

   IF CurObject.sList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No status were entered.  Please try again.';
      RETURN;
   ENDIF;
/*
**  get new grouping ID
*/
   CurObject.Grouping = 0;
   CurObject.Grouping = CALLPROC Udb_NextKey(KeyName = 'RelayGrouping');

   IF (CurObject.Grouping <= 0) THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Could not generate a grouping, try again.';
      RETURN;    
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RetCode = CALLPROC CAC_Relay_GroupingIns (
                 Grouping = CurObject.Grouping,
                 UserCheckOut = CurObject.UserName,
                 RevisionDate = date('now'),
                 Comment = 'New Matrix'
                 );
   IF Retcode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                    ': Could not insert feeder information.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Could not insert feeder information. ' +
         'Please try again or contact technical support if ' + 
         'problem continues.';
      RETURN;    
   ENDIF;
   CALLPROC DDB_COMMIT;

   FOR i = 1 to CurObject.fList.LastRow() DO
      RetCode = CALLPROC CAC_CO_FeederIns (
                  Grouping = CurObject.Grouping,
                  Feeder = CurObject.fList[i].Object
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.fList.Clear();
         CurObject.cList.Clear();
         CurObject.sList.Clear();
         CurObject.nList.Clear();
         CurObject.iList.Clear();
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert feeder information.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not insert feeder information. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   FOR i = 1 to CurObject.cList.LastRow() DO
      RetCode = CALLPROC CAC_CO_CircuitIns (
                  Grouping = CurObject.Grouping,
                  Circuit = CurObject.cList[i].Object,
                  Route = CurObject.cList[i].Route,
                  Seq = CurObject.cList[i].Seq
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.cList.Clear();
         CurObject.sList.Clear();
         CurObject.nList.Clear();
         CurObject.iList.Clear();
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert Circuit information.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not insert Circuit information. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   FOR i = 1 to CurObject.sList.LastRow() DO
      RetCode = CALLPROC CAC_CO_StatusIns (
                  Grouping = CurObject.Grouping,
                  Circuit = CurObject.sList[i].Circuit,
                  Route = CurObject.sList[i].Route,
                  Seq = CurObject.sList[i].Seq,
                  Status = CurObject.sList[i].Status
                  );
      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.sList.Clear();
         CurObject.nList.Clear();
         CurObject.iList.Clear();
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Matrix ' + varchar(CurObject.Grouping) +
                       ' status could not be updated.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not update status. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;

      FOR j = 1 to CurObject.sList[i].Note.LastRow() DO
         RetCode = CALLPROC CAC_CO_Note_LinkIns (
                  Grouping = CurObject.Grouping,
                  Seq = CurObject.Slist[i].Seq,
                  Note_ID = CurObject.sList[i].Note[j].Note_Id
                  );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.sList.Clear();
            CurObject.nList.Clear();
            CurObject.iList.Clear();
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Could not insert Note_Link information.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not insert Note_Link information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
      ENDFOR;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   FOR i = 1 to CurObject.nList.LastRow() DO
      RetCode = CALLPROC CAC_CO_NoteIns (
                  Grouping = CurObject.Grouping,
                  Note_Id = CurObject.nList[i].Note_Id,
                  Note_Seq = CurObject.nList[i].Note_Seq,
                  Note = CurObject.nList[i].Note
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.nList.Clear();
         CurObject.iList.Clear();
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert Note information.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not insert Note information. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   FOR i = 1 to CurObject.iList.LastRow() DO
      RetCode = CALLPROC CAC_CO_Info_Upd (
                  MatchGrouping = CurObject.Grouping,
                  FieldName = CurObject.iList[i].FieldName,
                  Sequence = CurObject.iList[i].Sequence,
                  NewValue = CurObject.iList[i].Name
                  );

      IF Retcode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.iList.Clear();
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Could not insert/update relay information.');
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Could not insert/update relay information. ' +
            'Please try again or contact technical support if ' + 
            'problem continues.';
         RETURN;    
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   RETURN;
END;

METHOD AttachmentIns (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;

ENDDECLARE
BEGIN
/* 
** insert matrix's attached diagrams
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was specifed.';
      RETURN;     
   ENDIF;

   FOR i = 1 TO CurObject.DList.LastRow DO
      CurObject.DList[i].InsertAttachment();
      CurObject.ReturnCode = CurObject.DList[i].ReturnCode;
      IF CurObject.ErrorMessage = '' THEN
         CurObject.ErrorMessage = 'Failed to save file(s) ' + CurObject.DList[i].FileName;
      ELSE
         CurObject.ErrorMessage = CurObject.ErrorMessage + ', ' + CurObject.DList[i].FileName;
      ENDIF;
   ENDFOR;
END;

METHOD LoadAttachments (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;

ENDDECLARE
BEGIN
/* 
** load a matrix's attached diagram
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Grouping = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No matrix was selected, please try again.';
      RETURN;     
   ENDIF;

   CurObject.DList.Clear();
   IF CurObject.ViewMode = 1 THEN
      i = 1;
      SELECT :CurObject.DList[i].Grouping = Grouping,
             :CurObject.DList[i].FileID = FileID,
             :CurObject.DList[i].FileName = FileName
      FROM   CAC_CO_Attachment
      WHERE  Grouping = :CurObject.Grouping
      BEGIN
         CurObject.DList[i].TableName = 'CAC_CO_ATTACHMENT';
         i = i + 1;
      END;
   ELSE
      i = 1;
      SELECT :CurObject.DList[i].Grouping = Grouping,
             :CurObject.DList[i].FileID = FileID,
             :CurObject.DList[i].FileName = FileName
      FROM   CAC_Relay_Attachment
      WHERE  Grouping = :CurObject.Grouping
      BEGIN
         CurObject.DList[i].TableName = 'CAC_RELAY_ATTACHMENT';
         i = i + 1;
      END;
   ENDif;

   FOR i = 1 TO CurObject.DList.LastRow DO
      CurObject.DList[i].LoadBinaryData();

      IF CurObject.DList[i].ReturnCode <> 0 THEN
         CurObject.ReturnCode = CurObject.DList[i].ReturnCode;
         IF CurObject.ErrorMessage = '' THEN
            CurObject.ErrorMessage = 'Failed to load file(s) ' + CurObject.DList[i].FileName;
         ELSE
            CurObject.ErrorMessage = CurObject.ErrorMessage + ', ' + CurObject.DList[i].FileName;
         ENDIF;
      ENDIF;
   ENDFOR;

   RETURN;
END;

METHOD GetStationsAndFeeders(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   GroupingInfo = ARRAY of RelayGrouping;              /* grouping info for circuit */
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SubTypeofSub = INTEGER NOT NULL;                    /* subtype of substation flag */
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Get all of the grouping info and concatenate it into 
   **  the substation and feeder fields
   */
   FOR i = 1 TO CurObject.Clist.LastRow() DO
      /*
      **  Get all of the grouping info and concatenate it into 
      **  the substation and feeder fields
      */
      GroupingInfo.Clear();
      j = 1;
      REPEATED
      SELECT  :GroupingInfo[j].Object = G.Grouping,
              :GroupingInfo[j].Type = G.GroupingType,
              :GroupingInfo[j].Name = O.Name
      FROM    Udb_Grouping G,
              Udb_Object O
      WHERE   G.Member = :CurObject.Clist[i].Object
      AND     G.Relationship = :Interaction$MemberOf
      AND     G.GroupingType <> :Type$TelCardGrouper
      AND     G.GroupingType <> :Type$Division
      AND     G.Grouping = O.Object
      BEGIN
         j = j + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      j = 1;
      WHILE j <= GroupingInfo.LastRow() DO
         SubTypeofSub = 0;
         REPEATED
         SELECT SubTypeofSub = 1
         FROM   Udb_ExtendedType
         WHERE  SuperType IN (:Type$Substation,:Type$TelCircuitTerminal)
         AND    Type = :GroupingInfo[j].Type;
         CALLPROC DDB_ROLLBACK;

         IF SubTypeofSub = 1 THEN
            IF CurObject.Clist[i].SubstationNames = '' THEN
               CurObject.Clist[i].SubstationNames = GroupingInfo[j].Name;
            ELSE
               CurObject.Clist[i].SubstationNames = CurObject.Clist[i].SubstationNames + 
                                                    ', ' + GroupingInfo[j].Name;
            ENDIF;
         ELSE
            IF CurObject.Clist[i].FeederNames = '' THEN
               CurObject.Clist[i].FeederNames = GroupingInfo[j].Name;
            ELSE
               CurObject.Clist[i].FeederNames = CurObject.Clist[i].FeederNames + 
                                                  ', '+GroupingInfo[j].Name;
            ENDIF;
         ENDIF;
         j = j + 1;
      ENDWHILE;
   ENDFOR;
END;

Application Component Report
============================

	Name:            RPM_CheckBlankStatus

/*
**
**      Copyright c 2012 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          RPM_CheckBlankStatus
**
**  Date:       Author   Description
** ----------------------------------
**  06/12/12    pkw      Created
*/
PROCEDURE RPM_CheckBlankStatus (
   pRow                 = INTEGER NOT NULL;            /*Parameter*/   
   pList                = ARRAY OF  RelayStatusClass;  /*Parameter*/   
   pCheck               = ARRAY OF INTEGEROBJECT;      /*Parameter*/
   
   i                    = INTEGER NOT NULL;  
   k                    = INTEGER NOT NULL;  
) =
BEGIN
   FOR i = 1 to pCheck.LastRow DO
      k = pRow + pCheck[i].Value - 1;
      IF k <= pList.LastRow THEN
         IF pList[k].Status <> Relay$StatusBlank THEN
            RETURN (1);  /* Found non-blank status */
         ENDIF;
      ELSE
         RETURN -1;  /* End of matrix */
      ENDIF;
   ENDFOR;
   /*
   **  If we get here, all status for this row was blank.
   **  Return 0 to try next row.
   */
   RETURN 0;
END;
        

