	Name:            FeederObject


���p(Component Method Scripts
���p(--------------------------
/*
**
**      Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**      Pateric SOftware LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          FeederObject
**
**  Date:       Author   Description
** ----------------------------------
**  11/11/09    em       Supports Creation of a new Feeder object.
**  11/23/09    em       Add Create Source Method
**  12/16/09    em       One Grd-Stud only even if two legs
**  04/13/10    ysp      add GetSubstation method
**  04/28/10    ysp      add LoadEquipment method
**  07/28/10    ysp      change LoadEquipment to load ALL or ISWP equipment
**  02/01/11    em       When adding Fdr-Ld equipment, check if substation is
**                       member of itself or another (Macro).  Conditions where
**                       it is member of Macro are failing and need fix.
**  09/12/15    pkw      Only set Rating if it is passed in.
**  06/14/17    em       Modify connectivity setup to support QGIS Model.
**/
METHOD GenerateFeeder (
   Source  = Equipment;      /* Parameter */
)=
DECLARE
   i       = INTEGER NOT NULL;
   j       = INTEGER NOT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
  
   BaseX = INTEGER NOT NULL WITH DEFAULT;
   BaseY = INTEGER NOT NULL WITH DEFAULT;
   Desks    = ARRAY OF INTEGEROBJECT; 
   Desk     = INTEGER NOT NULL;
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipObject = INTEGER NOT NULL WITH DEFAULT;
   LastObj = INTEGER NOT NULL WITH DEFAULT;
   LocatedWithSub = INTEGER NOT NULL WITH DEFAULT;
   LocatedWithSubType = INTEGER NOT NULL WITH DEFAULT;
   LoggedInOp = VARCHAR(40) NOT NULL WITH DEFAULT;
   NewX = INTEGER NOT NULL WITH DEFAULT;
   NewY = INTEGER NOT NULL WITH DEFAULT;
   ObjectTerminals = INTEGER NOT NULL WITH DEFAULT;
   ObjectType = INTEGER NOT NULL WITH DEFAULT;
   ObjectTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   ObjectDescription = VARCHAR(200) NOT NULL WITH DEFAULT;
   PocketDiagram = INTEGER NOT NULL WITH DEFAULT;
   SourceNode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF DBMOperator.Description <> '' THEN
      LoggedInOp = DBMOperator.Description;
   ELSEIF DOp.Description <> '' THEN
      LoggedInOp = DOp.Description;
   ELSE
      LoggedInOp = 'Unknown';
   ENDIF;
/*
** Insert Feeder Object
*/
   RetCode = CALLPROC Udb_ObjectIns (
                 Object = -1
                ,Name = CurObject.Name
                ,Type = Type$Feeder
                ,TypeName = 'Feeder'
                ,PrimaryGrouping = CurObject.Substation
                ,PrimaryGroupingName = CurObject.SubstationName
                ,Terminals = 0
                );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Insert of Feeder Object Failed.';
      RETURN;
   ENDIF;
/*
** Get Feeder Object ID
*/
   SELECT  :CurObject.Object = Value
   FROM    Udb_LastKey 
   WHERE   LastKey = 'Object';
/*
** Update Feeder Object Details
*/
   RetCode = CALLPROC Udb_ObjectUpdAll (
                  Object = CurObject.Object
                 ,Type = Type$Feeder
                 ,PrimaryGrouping = CurObject.Substation
                 ,TypeName = 'Feeder'
                 ,PrimaryGroupingName = CurObject.SubstationName
                 ,Name = CurObject.Name
                 ,Description = CurObject.Description
                 ,Comment = CurObject.Comment
                 ,InService = NULL
                 ,OutService = NULL
                 ,LockNumber = ''
                 ,Combination = ''
                 ,PositionX = NULL
                 ,PositionY = NULL
                 ,OwnerNumber = ''
                 ,SerialNumber = ''
                 ,SpecNumber = ''
                 ,Validated = NULL
                 ,ValidatedBy = ''
                 ,LastChanged = Date ('now')
                 ,LastChangedBy = LoggedInOp
                 );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Update of Feeder Object Failed.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Insert Location Information
*/
   RetCode = CALLPROC Udb_LocationUpd(
                        Object = CurObject.Object,
                        L_Object = 0,
                        Object$Null = Object$Null,
                        Combination = '',
                        Phone = '',
                        Contact = '',
                        L1 = CurObject.Address1,
                        L2 = CurObject.Address2,
                        L3 = CurObject.Address3,
                        L4 = CurObject.Address4,
                        Comment = CurObject.LocationComment
                  );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Feeder Object saved, error saving Location information.  No Groupings saved.';
      RETURN;
   ENDIF;
/*
** Insert Located With Grouping
*/
   RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Object
                    ,GroupingType = Type$Feeder
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$LocatedWith
                    ,Reference = ''
                    );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Feeder Object saved, error saving Located With information.  No Groupings saved.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Determine control by desks based on divisions.
*/   
   Desks.Clear();
   SELECT :Desk = Grouping
   FROM   Udb_Grouping
   WHERE  Member = :CurObject.Division AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$OperatorDesk;

   Desks[1].Value = Desk;
   IF CurObject.OtherDivision <> 0 THEN
      SELECT :Desk = Grouping
      FROM   Udb_Grouping
      WHERE  Member = :CurObject.OtherDivision AND
             Relationship = :Interaction$MemberOf AND
             GroupingType = :Type$OperatorDesk;

      IF Desk <> Desks[1].Value THEN
         Desks[2].Value = Desk;
      ENDIF;
   ENDIF;
/*
** Insert Network Grouping
*/
   IF CurObject.Network <> 0 THEN
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Network
                    ,GroupingType = Type$Network
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$MemberOf
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving Network.  Review Feeder Groupings.';
         RETURN;
      ENDIF;
   ENDIF;
/*
** Insert Feeder Rating
*/
   IF CurObject.Rating <> 0 THEN
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Rating
                    ,GroupingType = Type$RatingFamily
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$RatedAs
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving Rating.  Review Feeder Groupings.';
         RETURN;
      ENDIF;
   ENDIF;
/*
** Insert Division relationship.
*/
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Division
                    ,GroupingType = Type$Division
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$MemberOf
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving Division.  Review Feeder Groupings.';
         RETURN;
      ENDIF;
/*
** Insert secondary Division relationship.
*/
   IF CurObject.OtherDivision <> 0 THEN

      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.OtherDivision
                    ,GroupingType = Type$Division
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$MemberOf
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving other Division.  Review Feeder Groupings.';
         RETURN;
      ENDIF;
   ENDIF;

   FOR i = 1 TO Desks.LastRow() DO
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = Desks[i].Value
                    ,GroupingType = Type$OperatorDesk
                    ,Member = CurObject.Object
                    ,MemberType = Type$Feeder
                    ,Relationship = Interaction$ControlledBy
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving control desk.  Review Feeder Groupings.';
         RETURN;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** For connectivity to be created, Substation must have a Diagram.
*/
   SELECT :PocketDiagram = G.Grouping
   FROM   Udb_Grouping G,
          DSO_Object O
   WHERE  G.Member = :CurObject.Substation AND
          G.Relationship = :Interaction$ShownOn AND
          G.Grouping = O.Pocket; 

   IF PocketDiagram > 0 THEN
      SourceNode = 0;
      SourceNode = CALLPROC Udb_NextKey (KeyName = 'Object');
      IF SourceNode <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Unable to get Source Node ID.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** For Leg Object located with substation, use substation located with just in case
** we need to locate with the Macro.  Should prevent error establishing located with relationship.
*/
   LocatedWithSub = CurObject.Substation;
   LocatedWithSubType = Type$Substation;
   SELECT :LocatedWithSub = Grouping,
          :LocatedWithSubType = GroupingType
   FROM   Udb_Grouping
   WHERE  Member = :CurObject.Substation AND
          Relationship = :Interaction$LocatedWith;
/*
** Insert connected legs.
*/
   LastObj = 0;
   FOR i = 1 TO CurObject.Legs DO

      IF CurObject.Legs = 1 THEN
         EquipName = CurObject.Name;
      ELSEIF i = 1 THEN
         EquipName = CurObject.Name + '_L';
      ELSE
         EquipName = CurObject.Name + '_M';
      ENDIF;
/*
** Loop as follows: 1=Fdr-Load, 2=Fdr-PH, 3=Link-PH, 4=Grd-Stud 
** Skip loop 4 if leg = 2.
*/
      FOR j = 1 TO 4 DO
         
         ObjectTypeName = '';
         ObjectDescription = ''; 
         EquipObject = 0;
         ObjectTerminals = 2;
         IF j = 1 THEN
            ObjectType = Type$FdrLoad;
            ObjectDescription = SQUEEZE( '(' + CurObject.SubstationName +
                                ',' + EquipName + ') - ' );
            ObjectTerminals = 1;
         ELSEIF j = 2 THEN
            ObjectType = Type$FdrPH;
            ObjectDescription = SQUEEZE( '(' + CurObject.SubstationName +
                                ',' + EquipName + ') Fdr Side - ' );
         ELSEIF j = 3 THEN
            ObjectType = Type$LinkPH;
            ObjectDescription = SQUEEZE( '(' + CurObject.SubstationName +
                                ',' + EquipName + ') - ' );
         ELSEIF j = 4 THEN
            IF i > 1 THEN
               ENDLOOP;   /* Only one GrdStud per feeder */
            ENDIF;
            ObjectType = Type$GrdStud;
            ObjectDescription = SQUEEZE( '(' + CurObject.SubstationName +
                                ',' + EquipName + ') Fdr Side - ' );
            ObjectTerminals = 1;
         ENDIF;

         SELECT :ObjectTypeName = Name
         FROM   Udb_Type 
         WHERE  Type = :ObjectType;

         RetCode = CALLPROC Udb_ObjectIns (
                 Object = -1
                ,Name = EquipName
                ,Type = ObjectType
                ,TypeName = ObjectTypeName
                ,PrimaryGrouping = CurObject.Substation
                ,PrimaryGroupingName = CurObject.SubstationName
                ,Terminals = ObjectTerminals
                );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder created, error inserting ' +
                                    ObjectTypeName + ' ' + EquipName;
            RETURN;
         ENDIF;
/*
** Get Equip Object ID
*/
         SELECT  :EquipObject = Value
         FROM    Udb_LastKey 
         WHERE   LastKey = 'Object';
/*
** Update Equip Object Details
*/
         RetCode = CALLPROC Udb_ObjectUpdAll (
                  Object = EquipObject
                 ,Type = ObjectType
                 ,PrimaryGrouping = CurObject.Substation
                 ,TypeName = ObjectTypeName
                 ,PrimaryGroupingName = CurObject.SubstationName
                 ,Name = EquipName
                 ,Description = ObjectDescription
                 ,Comment = ''
                 ,InService = NULL
                 ,OutService = NULL
                 ,LockNumber = ''
                 ,Combination = ''
                 ,PositionX = NULL
                 ,PositionY = NULL
                 ,OwnerNumber = ''
                 ,SerialNumber = ''
                 ,SpecNumber = ''
                 ,Validated = NULL
                 ,ValidatedBy = ''
                 ,LastChanged = Date ('now')
                 ,LastChangedBy = LoggedInOp
                 );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder created, error updating ' +
                                    ObjectTypeName + ' ' + EquipName;
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;
/*
** Insert Member of Feeder and Located With Grouping
*/
         RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = LocatedWithSub
                    ,GroupingType = LocatedWithSubType
                    ,Member = EquipObject
                    ,MemberType = ObjectType
                    ,Relationship = Interaction$LocatedWith
                    ,Reference = ''
                    );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder Object saved, error saving Located With for ' +
                                     ObjectTypeName + ' ' + EquipName;
            RETURN;
         ENDIF;

         RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Object
                    ,GroupingType = Type$Feeder
                    ,Member = EquipObject
                    ,MemberType = ObjectType
                    ,Relationship = Interaction$MemberOf
                    ,Reference = ''
                    );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder Object saved, error saving member of Feeder for ' +
                                     ObjectTypeName + ' ' + EquipName;
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;
/*
** And now we handle connectivity if PocketDiagram exists
*/
         IF PocketDiagram > 0 THEN

         IF j = 1 THEN
            LastObj = EquipObject;
/*
** Set Base x,y      
*/
            IF i = 1 THEN
               SELECT :BaseX = pos_x,
                      :BaseY = pos_y
               FROM   DSO_Object 
               WHERE  Object = :EquipObject;
            ELSE
               Retcode = CALLPROC DSO_ObjPositionUpd (
                              Object = EquipObject,
                              Pos_x = BaseX + 50,
                              Pos_y = BaseY);
               IF Retcode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Feeder Object saved, error positioning ' +
                                     ObjectTypeName + ' ' + EquipName;
                  RETURN;
               ENDIF;
            ENDIF;

         ELSEIF j = 2 OR j = 3 THEN

            Retcode = CALLPROC DSO_ConnectionIns(
                  Obj1 = LastObj,
                  Obj2 = EquipObject, 
                  PipeType = Type$OilPipe,
                  OID = -1);

            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Feeder Object saved, error connecting ' +
                                     ObjectTypeName + ' ' + EquipName;
               RETURN;
            ENDIF;
            LastObj = EquipObject;
/*
** Connect M Leg to SourceNode
*/
            IF i = 2 AND j = 3 THEN
               Retcode = CALLPROC DSO_ConnectionIns(
                  Obj1 = EquipObject,
                  Obj2 = SourceNode, 
                  PipeType = Type$OilPipe,
                  OID = -1);

               IF Retcode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Feeder Object saved, error connecting ' +
                                     ObjectTypeName + ' ' + EquipName;
                  RETURN;
               ENDIF;
            ENDIF;
/*
** Positioning
*/
            IF i = 1 THEN
               NewX = BaseX;
            ELSE
               NewX = BaseX + 50;
            ENDIF;
 
            IF j = 2 THEN
               NewY = BaseY + 50;
            ELSE
               NewY = BaseY + 100;
            ENDIF;

            Retcode = CALLPROC DSO_ObjPositionUpd (
                              Object = EquipObject,
                              Pos_x = NewX,
                              Pos_y = NewY,
                              Rotation = 90);
            IF Retcode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Feeder Object saved, error positioning ' +
                                     ObjectTypeName + ' ' + EquipName;
                  RETURN;
            ENDIF;
         
         ELSEIF j = 4 THEN  /* Only create Source Node for L Leg */
 
            Retcode = CALLPROC DSO_ObjectIns (
                  Pocket = PocketDiagram,
                  Object = SourceNode, 
                  Type = 17054,     /*Elbow*/
                  StructureType = Type$Substation,
                  StructureObj = CurObject.Substation,
                  Pos_x = BaseX,
                  Pos_y = BaseY + 150,
                  Rotation = 0,
                  PocketName = CurObject.SubstationName,
                  Name = '',
                  StructureTypeName = 'Substation',
                  StructureName = CurObject.SubstationName);          
                  
            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Feeder Object saved, error trying to create Node Elbow for L Leg for ' +
                                     ObjectTypeName + ' ' + EquipName;
               RETURN;
            ENDIF;

            Retcode = CALLPROC DSO_ConnectionIns(
                  Obj1 = LastObj,
                  Obj2 = SourceNode, 
                  PipeType = Type$OilPipe,
                  OID = -1);

            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Feeder Object saved, error connecting ' +
                                     ObjectTypeName + ' ' + EquipName;
               RETURN;
            ENDIF;

            Retcode = CALLPROC DSO_ObjPositionUpd (
                              Object = EquipObject,
                              Pos_x = BaseX - 25,
                              Pos_y = BaseY + 150,
                              Rotation = 270);

            IF Retcode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurObject.ReturnCode = -1;
                  CurObject.ErrorMessage = 'Feeder Object saved, error positioning ' +
                                     ObjectTypeName + ' ' + EquipName;
                  RETURN;
            ENDIF;

            Retcode = CALLPROC DSO_ConnectionIns(
                  Obj1 = SourceNode,
                  Obj2 = EquipObject, 
                  PipeType = Type$OilPipe,
                  OID = -1);

            IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Feeder Object saved, error connecting ' +
                                     ObjectTypeName + ' ' + EquipName;
               RETURN;
            ENDIF;
 
         ENDIF;      

         ENDIF;  /*PocketDiagram*/
         CALLPROC DDB_COMMIT;

      ENDFOR;
   ENDFOR;
/*
** Now handle the Source parameter, IF Equip=0, then there is no source and we are done.  If >0 then we take an existing
** source equip and make it the source for the feeder.  If = -1, new source for feeder, =-2, new source in substation only.
*/
   IF Source.Equip = 0 THEN
      RETURN;
   ELSE 
      CurObject.CreateSource (Source = Source,
                              SourceNode = SourceNode);
   ENDIF;

END;


METHOD CreateSource  (     
   Source  = Equipment;      /* Parameter */
   SourceNode = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   GroundStud = INTEGER NOT NULL WITH DEFAULT;
   EquipObject = INTEGER NOT NULL WITH DEFAULT;
   LoggedInOp = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Method might be called from GenerateFeeder method where SourceNode would be known or from Feedercard when creating
** card on feeder for first time and SourceNode would have to be determined.
*/
   IF SourceNode = 0 THEN
      CurObject.ReturnCode = 0;
      CurObject.ErrorMessage = '';

      SELECT :GroundStud = T.Object
      FROM   DSO_Object T,
             Udb_Grouping G
      WHERE  G.Grouping = :CurObject.Object AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType = :Type$GrdStud AND
             G.Member = T.Object;

      SELECT :SourceNode = ToObj 
      FROM   DSO_Connection 
      WHERE  FromObj = :GroundStud;

      IF SourceNode = 0 THEN
         SELECT :SourceNode = FromObj 
         FROM   DSO_Connection 
         WHERE  ToObj = :GroundStud;
      ENDIF;
   ENDIF;

   IF LoggedInOp = '' THEN
      LoggedInOp = DOp.Description;
   ENDIF;

   IF Source.Equip < 0 THEN
  
      RetCode = CALLPROC Udb_ObjectIns (
                 Object = -1
                ,Name = Source.EquipName
                ,Type = Source.EquipClass
                ,TypeName = Source.EquipClassName
                ,PrimaryGrouping = CurObject.Substation
                ,PrimaryGroupingName = CurObject.SubstationName
                ,Terminals = 2
                );

      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder created, error inserting Source' +
                                    Source.EquipClassName + ' ' + Source.EquipName;
            RETURN;
      ENDIF;
/*
** Get Source Object ID
*/
      SELECT  :EquipObject = Value
      FROM    Udb_LastKey 
      WHERE   LastKey = 'Object';
/*
** Update Source Object Details
*/
      RetCode = CALLPROC Udb_ObjectUpdAll (
                  Object = EquipObject
                 ,Type = Source.EquipClass
                 ,PrimaryGrouping = CurObject.Substation
                 ,TypeName = Source.EquipClassName
                 ,PrimaryGroupingName = CurObject.SubstationName
                 ,Name = Source.EquipName
                 ,Description = Source.Description
                 ,Comment = ''
                 ,InService = NULL
                 ,OutService = NULL
                 ,LockNumber = ''
                 ,Combination = ''
                 ,PositionX = NULL
                 ,PositionY = NULL
                 ,OwnerNumber = ''
                 ,SerialNumber = ''
                 ,SpecNumber = ''
                 ,Validated = NULL
                 ,ValidatedBy = ''
                 ,LastChanged = Date ('now')
                 ,LastChangedBy = LoggedInOp
                 );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Update of Source Object Failed.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
/*
** Insert Located With Grouping
*/
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Substation
                    ,GroupingType = Type$Substation
                    ,Member = EquipObject
                    ,MemberType = Source.EquipClass
                    ,Relationship = Interaction$LocatedWith
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object saved, error saving Source Located With information.';  
         RETURN;
      ENDIF;
/*
** Insert Division Membership Grouping
*/
      IF CurObject.Division <> 0 THEN
         RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Division
                    ,GroupingType = Type$Division
                    ,Member = EquipObject
                    ,MemberType = Source.EquipClass
                    ,Relationship = Interaction$MemberOf
                    ,Reference = ''
                    );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Feeder Object and Location saved, error saving Division.  Review Feeder Groupings.';
            RETURN;
         ENDIF;
      ENDIF;
      CALLPROC DDB_COMMIT;

   ELSEIF Source.Equip > 0 THEN
/*
** We just need to update the Description.
*/
      EquipObject = Source.Equip;
      RetCode = CALLPROC Udb_ObjectUpdAll (
                  Object = EquipObject
                 ,Type = Source.EquipClass
                 ,PrimaryGrouping = CurObject.Substation
                 ,TypeName = Source.EquipClassName
                 ,PrimaryGroupingName = CurObject.SubstationName
                 ,Name = Source.EquipName
                 ,Description = Source.Description
                 ,Comment = ''
                 ,InService = NULL
                 ,OutService = NULL
                 ,LockNumber = ''
                 ,Combination = ''
                 ,PositionX = NULL
                 ,PositionY = NULL
                 ,OwnerNumber = ''
                 ,SerialNumber = ''
                 ,SpecNumber = ''
                 ,Validated = NULL
                 ,ValidatedBy = ''
                 ,LastChanged = Date ('now')
                 ,LastChangedBy = LoggedInOp
                 );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Update of Source Object Failed.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF Source.Equip = -2 THEN
      RETURN;
   ENDIF;
/*
** Haven't returned yet? Attach to Feeder
*/
   RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Object
                    ,GroupingType = Type$Feeder
                    ,Member = EquipObject
                    ,MemberType = Source.EquipClass
                    ,Relationship = Interaction$MemberOf
                    ,Reference = 'A'
                    );
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error attaching Source to Feeder.';
         RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Source Groupings
*/
      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Object
                    ,GroupingType = Type$Feeder
                    ,Member = EquipObject
                    ,MemberType = Source.EquipClass
                    ,Relationship = Interaction$SourceBreaker
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error insert Source Breaker grouping.';
         RETURN;
      ENDIF;

      RetCode = CALLPROC Udb_GroupingIns
                    (SystemVersion = 0
                    ,Grouping = CurObject.Object
                    ,GroupingType = Type$Feeder
                    ,Member = EquipObject
                    ,MemberType = Source.EquipClass
                    ,Relationship = Interaction$SourcePosition
                    ,Reference = ''
                    );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Feeder Object and Location saved, error insert Source Position grouping.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
/*
** Connect source to L&M Leg
*/
      IF SourceNode = 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Not able to find a connected load to connect the Feeder Source to the Feeder Load.';
         RETURN;
      ENDIF;

      Retcode = CALLPROC DSO_ConnectionIns(
                  Obj1 = EquipObject,
                  Obj2 = SourceNode, 
                  PipeType = Type$OilPipe,
                  OID = -1);

      IF Retcode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Feeder Object saved, error connecting Source to Fdr Load';
               RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
END;  

METHOD GetSubstation(     
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Method called from fms online
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 0;
   SELECT :CurObject.Substation = O.PrimaryGrouping,
          :CurObject.SubstationName = O.PrimaryGroupingName
   FROM   Udb_Object O,
          Udb_Grouping G1,
          Udb_Object G2  
   WHERE  O.Object = :CurObject.Object AND
          O.Object = G1.Grouping AND
          G1.Relationship = :Interaction$SourceBreaker AND     
          G1.Member = G2.Object AND 
          G2.PrimaryGrouping = O.PrimaryGrouping
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
       
   IF i = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Source Breaker is defined for this feeder or ' + 
                 'no substation is defined for the Source Breaker';
   ELSEIF i > 1 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Multiple equipment defined as the Source Breaker for this feeder.';
   ENDIF;

   RETURN;
END;

METHOD LoadEquipment(
   FilterType = VARCHAR(10) NOT NULL WITH DEFAULT;
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   m = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF UPPERCASE(FilterType) = 'ALL' THEN
      i = 1;
      REPEATED
      SELECT  :CurObject.EList[i].Equip = O.Object, 
              :CurObject.EList[i].EquipName = O.Name,
              :CurObject.EList[i].EquipClass  = O.Type,
              :CurObject.EList[i].EquipClassName  = O.TypeName,
              :CurObject.EList[i].ObjectDescription = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_ExtendedType E
      WHERE   G.Grouping = :CurObject.Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              G.MemberType = E.Type AND
              E.SuperType = :Type$Conducting
      ORDER BY EquipClassName, EquipName     
      BEGIN
         i = i + 1;
      END;
   ELSEIF UPPERCASE(FilterType) = 'ISWP' THEN
      i = 1;
      REPEATED
      SELECT  :CurObject.EList[i].Equip = O.Object, 
              :CurObject.EList[i].EquipName = O.Name,
              :CurObject.EList[i].EquipClass  = O.Type,
              :CurObject.EList[i].EquipClassName  = O.TypeName,
              :CurObject.EList[i].ObjectDescription = O.Description
      FROM    Udb_Object O,
              Udb_Grouping G,
              Udb_ExtendedType E
      WHERE   G.Grouping = :CurObject.Object AND
              G.Relationship = :Interaction$MemberOf AND
              G.Member = O.Object AND
              G.MemberType = E.Type AND
              E.SuperType = :Type$Conducting AND
              O.Object NOT IN (SELECT G1.Member 
                            FROM Udb_Grouping G1,
                                 Udb_Grouping G2
                            WHERE G1.Grouping = :CurObject.Object AND
                                  G1.Relationship = :Interaction$MemberOf AND
                                  G1.Member = G2.Member AND
                                  G2.Relationship = :Interaction$MemberOf AND
                                  G2.GroupingType IN (:Type$Substation, :Type$UnitSubstation))
      ORDER BY EquipClassName, EquipName     
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;  

   RETURN;
END;

