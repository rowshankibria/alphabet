	Name:            ChangeOrderPriority

/*
**
**      Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**      Unified Information, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Unified Information, Inc.
**
** This frame takes as input, an array of order.
** The user graphically manipulates the order of the array. 
** The new order is reflected in an array of integers which is returned
** (byref) to the user.
**
**  Application  CAC
**  Frame        ChangeOrderPriority
**
**  Date:       Version Description
** ----------------------------------
**  08/11/05 em  Modified Re-Order Moves to support Order Priority Changes
**  08/25/05 em  Correction for TLS Job load
**  09/22/05 em  Don't display "orders not downloaded" warning if work permits
**               are involved. 
**  11/03/05 em  Separate the permit type orders.
**  04/16/07 yp  ITC210: Insert IR interface event in DB event queue
**  06/30/09 em  TLS Orders were not distinguishing Work Permit orders, so prioritization
**               failed since RR rejected it.
**  11/11/23 em  Not applicable to show this screen if under Manual Order conditions.
**               
*/
INITIALIZE (  
    OrderSubstation = INTEGER NOT NULL;   /*Station Parameter*/
   
#  include StandardDeclarations
    
    Orders = ARRAY of SubstationOrderClass;
    IssuedOrders = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    TempString = VARCHAR(250) NOT NULL WITH DEFAULT;
    DBEventText = VARCHAR(256) NOT NULL WITH DEFAULT;
    FirstJob = INTEGER NOT NULL WITH DEFAULT;
    FirstJobTORS = INTEGER NOT NULL WITH DEFAULT;
    WorkPermit = INTEGER NOT NULL WITH DEFAULT;  
    
    Idx = ARRAY of IntegerObject;
    Title = varchar(80) not null;
    j = integer not null;
    k = integer not null;
    SortedFlag = INTEGER NOT NULL;
    Sptr = ARRAY of StackField;    /* used to keep track of each "row" */

    TmpStackPtr1 = StackField;      /* used for framesize manipulation, and scrollbar */   
    TmpStackPtr2 = StackField;      /* used for framesize manipulation, and scrollbar */   
    SizeFactor  = Integer not null;
    NO_OF_ROWS  = Integer not Null;  /* holds number of rows to show before putting up scrollbar */
    SCROLLBARWIDTH  = Integer not Null;  /* Represents width if scrollbar */
    
) =
BEGIN
/*
** Exit Immediately if in an Manual Order mode, can't download order priority changes
*/
   IF ManualOrderToggle = TRUE THEN
      RETURN(PU_OK);
   ENDIF;
/*
** Query all existing substation operating orders
*/
   WorkPermit = 0;
   IssuedOrders = 0;
   i = 1;
   Orders.Clear();
   REPEATED
   SELECT  :Orders[i].Application = OO.Application,
           :Orders[i].Card = OO.Card,
           :Orders[i].OrderNumber = OO.OrderNumber,
           :Orders[i].IssueTime = OO.IssueTime,
           :Orders[i].IssuedByDO = OO.IssuedByDO,
           :Orders[i].IssueComment = '',
           :Orders[i].OrderStatus = OO.OrderStatus,
           :Orders[i].OrderType = OO.OrderType,
           :Orders[i].Priority = OO.Priority
   FROM   IR_OperatingOrder OO
   WHERE  OO.Substation = :OrderSubstation AND
          OO.OrderStatus < :Order$Acknowledged AND
          OO.OrderStatus > :Order$SetUp AND
          OO.OrderStatus <> :Order$Rejected
   UNION ALL
   SELECT  'TLS',
           OO.Card,
           OO.OrderNumber,
           OO.IssueTime,
           OO.IssuedByDO,
           OO.IssueComment,
           OO.OrderStatus,
           OO.OrderType,
           OO.Priority
   FROM   IR_TelephoneOrder OO
   WHERE  OO.Substation = :OrderSubstation AND
          OO.OrderStatus < :Order$Acknowledged AND
          OO.OrderStatus <> :Order$Rejected
   ORDER BY Priority, IssueTime ASC
   BEGIN
/*
** Let's make sure we don't have too many orders with Issued Status.
*/
      IF Orders[i].OrderStatus = Order$Opened AND Orders[i].OrderType <> 'WORK PERMIT' THEN
         IssuedOrders = IssuedOrders + 1;
      ENDIF;
      IF Orders[i].OrderType = 'WORK PERMIT' THEN
         WorkPermit = WorkPermit + 1;
      ENDIF;
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** If there is only one outstanding non work permit order, there is nothing to prioritize.
*/
   IF (Orders.LastRow() - WorkPermit) <= 1 THEN
      RETURN PU_CANCEL;  /*Only condition with a PU_CANCEL retcode*/
   ENDIF;
/*
** If there is more than one issued but not yet downloaded order, then
** prompt the DO.  
*/
   IF IssuedOrders > 1 THEN
      MESSAGE 'There may be a problem with the SSO Order Download Process. ' +
              HC_NEWLINE +
              'There are other orders for this substation that have not been ' +
              'downloaded to the SSO.  Try the Update ' +
              'Priority function on the Order screen ' +
              'to see if you get this message again before ' +
              'reporting a problem to Technical Support.';
      RETURN PU_OK;
   ENDIF;
/*
** Get detailed information about the orders and set up the screen.
*/
   FOR i = 1 to Orders.LastRow() DO

      IF Orders[i].Application = Application$TLS THEN
            SELECT :Orders[i].CardName = LineNumber
            FROM   TC_Card
            WHERE  Card = :Orders[i].Card;

            SELECT  :FirstJob = Job,
                    :FirstJobTORS = TORS
            FROM    IR_TLSOrderJob
            WHERE   OrderNumber = :Orders[i].OrderNumber AND
                    Seq = 1;
            IF FirstJob <> 0 AND FirstJobTORS = 0 THEN
               SELECT :Orders[i].IssueComment = TOMove
               FROM   TC_Job 
               WHERE  Job = :FirstJob;
            ELSEIF FirstJob <> 0 AND FirstJobTORS = 1 THEN
               SELECT :Orders[i].IssueComment = RSMove
               FROM   TC_Job 
               WHERE  Job = :FirstJob;
            ENDIF;
      ELSE
         IF Orders[i].Application = Application$FMS THEN
            REPEATED
            SELECT :Orders[i].CardName = FeederName
            FROM   FMS_Card
            WHERE  Card = :Orders[i].Card;

         ELSEIF Orders[i].Application = Application$SLC THEN
            REPEATED
            SELECT :Orders[i].CardName = SubstationName
            FROM   SLC_Card
            WHERE  Card = :Orders[i].Card;

         ELSEIF Orders[i].Application = Application$TFMS THEN
            REPEATED
            SELECT :Orders[i].CardName = FeederNames
            FROM   TFMS_Card
            WHERE  Card = :Orders[i].Card;
         ENDIF;
         /* 
         ** Get first job
         */
         FirstJob = 0;
         SELECT  :FirstJob = Job,
                 :FirstJobTORS = TORS
         FROM    IR_OpOrderJobs
         WHERE   OrderNumber = :Orders[i].OrderNumber AND
                 Seq = 1;
         IF FirstJob <> 0 AND FirstJobTORS = 0 THEN
            SELECT :Orders[i].IssueComment = TOMove
            FROM   SOA_Job 
            WHERE  Job = :FirstJob;
         ELSEIF FirstJob <> 0 AND FirstJobTORS = 1 THEN
            SELECT :Orders[i].IssueComment = RSMove
            FROM   SOA_Job 
            WHERE  Job = :FirstJob;
         ENDIF;
      ENDIF; 

   ENDFOR;

   i = Orders.LastRow();
   j = 0;
   Permits.Clear();
   WHILE i > 0 DO
      IF Orders[i].OrderType = 'WORK PERMIT' THEN
/*
** Move the permits into a display array.
*/
         j = j + 1;
         Permits.InsertRow (rownumber = j, rowobject = Orders[i].Duplicate());
         Orders.RemoveRow (rownumber = i);
      ENDIF;
      i = i - 1;
   ENDWHILE;

   IF Permits.LastRow() > 0 THEN
      FIELD(wp_text).CurBias = FB_VISIBLE;
      FIELD(Permits).CurBias = FB_LANDABLE;
   ENDIF;

    /* Set up Title info */
    NO_OF_ROWS = 15;
    CurFrame.WindowTitle = 'Change Order Priority';
    HVP.header.Application = 'App';
    HVP.header.CardName = '    Card   ';
    HVP.header.OrderNumber = 'Order';
    HVP.header.IssueTime = '  Issue Time  ';
    HVP.header.IssuedBy = '  Issued By  ';
    HVP.header.IssueComment = '  First Job on the Order      ';

    /* set up index to match incoming data */
    Idx.Clear();
    i = 1;
    WHILE i <= Orders.NumRows() do
        Idx[i].value = i;
        i = i + 1;
    ENDWHILE;

    /* Load Orders onto screen */    
    j = Orders.NumRows();
    i = 1;
    WHILE i <= j DO
	
        VP.Template.Application    = Orders[i].Application;
        VP.Template.CardName       = Orders[i].CardName;
        VP.Template.OrderNumber    = Orders[i].OrderNumber;
        VP.Template.IssueTime      = Orders[i].IssueTime;
        VP.Template.IssuedBy       = Orders[i].IssuedByDO;
        VP.Template.IssueComment   = Orders[i].IssueComment;

        Sptr[i] = Field(VP.Template).Duplicate();
        Sptr[i].ParentField = field(VP.Template).Parentfield;
        i = i + 1;
    ENDWHILE;

    /* Save pointer to templates parentfield */
    TmpStackPtr1 = field(VP.Template);
    TmpStackPtr2 = TmpStackPtr1.ParentField;

    /* Get Rid of the template */
    field(VP.Template).ParentField = NULL;

    /* set a Factor to be to be used in frame size manipulation later */
    IF TmpStackPtr2.ChildFields.LastRow() <= NO_OF_ROWS THEN
        SizeFactor = TmpStackPtr2.ChildFields.LastRow() + 2;
    ELSE
        SizeFactor = NO_OF_ROWS + 2;
    Endif;

    /* Call another userevent to force the frame to realize itself before I can get
       a true measurement
    */
    Curframe.SendUserevent(Eventname = 'init');
            
END; 


ON USEREVENT 'init' =
BEGIN
    CurFrame.Flush();
    field(VP).Height = tmpStackPtr1.Height * SizeFactor;
/* 
   Because of the different displays this will run on, and the nature of viewports
   on these displays, it is necessary to progromatically
   manipulate the width of the viewport eventhough the width is constant.           
   For centering purposes, there is also a viewport surrounding the
   "header" stack.  Its width is also manipulated.      
*/
    field(VP).Width  = tmpStackPtr2.Width + 550;
    field(HVP).Width  = tmpStackPtr2.Width + 550;
/*
    Now adjust the window height and width to accomodate the 
    size of encompassing fields.
    ("Sized to fit fields" does not work after the frame is initially realized)
*/
    CurFrame.Flush();

    CurFrame.WindowHeight = Field(VP).ParentField.ParentField.OuterHeight + 2*Curframe.GridY;
    CurFrame.WindowWidth = Field(VP).ParentField.ParentField.OuterWidth + 2*Curframe.GridX;
    CurFrame.Flush();

END;    


ON CLICK OK_BTN =
BEGIN
    SortedFlag = 0;
    /* use bubble sort to sort by Y position */
    i = 1;
    WHILE i <= Sptr.NumRows() DO
        j = i+1;
        WHILE j <= Sptr.NumRows() DO
           IF Sptr[idx[i].value].Ytop > Sptr[idx[j].value].Ytop THEN
                k = Idx[j].value;
                Idx[j].value = Idx[i].value;
                Idx[i].value = k;
                SortedFlag = 1;
           ENDIF;
           j = j + 1;
        ENDWHILE;
        i = i + 1;
    ENDWHILE;

    IF SortedFlag = 0 THEN
        RETURN PU_OK;
    ELSE
/*
** Update all order priorities and send event to SSO Monitor
*/
       FOR i = 1 TO Orders.LastRow() DO
           IF Orders[Idx[i].Value].Application = Application$TLS THEN
  
              RetCode = CALLPROC IR_TLSOrderPriorityUpd (
                           OrderNumber = Orders[Idx[i].Value].OrderNumber,
                           Priority = i);

              IF RetCode <> 0 THEN
                 CALLPROC DDB_ROLLBACK;
                 MESSAGE 'Unable to update order priorities due to an error.';
                 RESUME;
              ENDIF;
          ELSE
              RetCode = CALLPROC IR_OpOrderPriorityUpd (
                           OrderNumber = Orders[Idx[i].Value].OrderNumber,
                           Priority = i);
              IF RetCode <> 0 THEN
                 CALLPROC DDB_ROLLBACK;
                 MESSAGE 'Unable to update order priorities due to an error.';
                 RESUME;
              ENDIF;
          ENDIF;
       ENDFOR;     
       CALLPROC DDB_COMMIT;

       DBEventText = VARCHAR(OrderSubstation) + ';' + DOp.Description + ';';
       CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_OrderPriorityUpdate',
                     EventText = DBEventText);        
       RETURN PU_OK;         
    ENDIF;
END;



ON WINDOWCLOSE =
BEGIN
	RESUME;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


