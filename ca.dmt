Application Component Report
============================

	Name:            HiPotComplete

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          HiPotComplete
**
**  01/16/93  mts   Frame created. 
**  02/11/93  adl   Added call to create FOT card. 
**  03/05/93  em    removed ROLLBACKs and COMMITs and changed return codes
**                  appropriately.  This procedure is part of a larger
**                  transaction.
**  06/23/93  gjc   Changed call to FOT to the more general CreateXferCard
**                  routine.
**  03/28/94  pw    Added code for high pot history.
**  04/09/94  mts   handles a forced complete from the "SuspectTest Frame".
**                  Added code to log test failures.
**  05/27/94  em    clear HV status when creating FOT
**  06/03/94  mts   Pass flag to suspect test indicating not to show
**                  accept button.
**  06/04/94  pw    added two failed on test fields
**  06/06/94  em    return FOT with different retcode to cancel processing
**                  and avoid T/C side effects.
**  07/07/94  em    added return code processing
**  08/14/95  pw    change callproc createxfercard to callframe createxfercard
**  04/11/97  jfl   fms205: Log the creation of an ISO due to FOT if card was
**                  ISO 
**  11/06/00  em    Default Test Type and Duration to Criteria
**  02/20/01  ym    If the return order is downloaded into IR_HighPotTestResult,
**                  then make the entry fields visible only.
**  02/23/01  em    Code Review
**  04/03/01  em    Load IR test results after loading test criteria.
**  04/09/01  my    The information will be recorded in the IR_FOTCount table
**                  when a high Pot Test has failed and the user creates a 
**                  Fail on test card when completing the High Pot move and 
**                  recording the failed test results.
**  05/03/01  em    Changes to FOT Count processing.
**  06/15/01  pkw   remove trouble card dbevent call.
**  06/27/01  em    modify return from Operating Order.  Pass value to 
**                  SuspectTest to disable Cancel button.
**  07/19/01  em    Passing Parms and letting CreateXferCard process insert
**                  FOTCount info.
**  10/25/01  em    If test duration or kV level is less then the test criteria
**                  then fail the test also. 
**  01/14/02  em    Before allowing FOT card to be created, check for any RR
**                  issues.
**  07/29/02  em    Added test pass/fail info and "AC" High Pot type for 
**                  download to FRA.
**  08/16/02  em    Handle new FailedTest No FOR return from Suspect Test
**  10/31/02  em    Job to JIP. Select card data.
**  03/10/04  em    Don't display screen during Automatic Execution.
**                  If Automatic Execution makes it to here, the test will
**                  have passed and will be forced through.
**  01/29/05  em    Corrected longstanding problem with Failed Other - was not
**                  going into failed test logic because tempvc field was being 
**                  cleared.
**  04/03/05  pkw   Change Event from clickprocessing to completeprocessing.
**  03/01/06  ysp   FMS335: Send a notification if the test failed and DO selects 
**                  "Failed Other", "Create FOT" or "No FOT" button; 
**                  or High Pot passes normally or when DO selects "Accept".
**  07/18/06  ysp   support AC High pot test type (3). The old way of seaching "AC" in
**                  the move text is obsolete.
**  08/31/07  em    Zero test values are being returned from RR, when we look at test results
**                  to determine version of screen to display, we must look at rowcount returned rather
**                  than non-zero test result values. 
**  09/07/07  em    Added Julia's Greenie
**  11/06/07  ysp   FMS 373: if RR returns text in Failed Test Reason field, the test is considered
**                  as failed. Save Failed Test Reason in FMS_HighPotHistory.
**  05/15/08  em    If DO enters failed test reason, force them into Failed
**                  test processing.  Now both RR and verbal process is the same -
**                  go to fail test processing if a reason is entered.
**  08/04/08  ysp   FMS 382: pass FMS card object to SuspectTest frame so that it
**                  can checks for outstanding operating orders.
**  03/25/09  ysp   Support DO's adjustment of test results.
**  04/21/09  ysp   Temporarily turn off DO's adjustment of results
**  05/11/09  ysp   Add second DO confirmation.
**  12/08/09  ysp   support AC Modified High pot test type (4)
**  01/27/10  ysp   add Subject and template to email class
**  01/06/11  em    Updated for 3G, save test results for each feeder
**  08/03/11  ysp   Determine AC High Pot test by evaluating the failed test reason.
**  09/08/11  ysp   Change FailedTestReason field's label to "Test Result" for AC high pot.
**  10/12/11  em    Removed Requirement for DO to enter pass or fail for AC Hi Pot on verbal return
**  01/03/13  ysp   Delay FOT card transfer if there are outstanding moves to confirm.
**  07/19/16  ysp   Record the test result on the main feeder if the job is completed on a 33KV portion card.
**  02/14/23  em    Alter label for test type = 1 to indicate "DC".  Test types 2 and 4 will no longer be used.
*/

INITIALIZE
(
   JIP = JobInProgress;			  /* Job being processed */
   HiPotType = Integer NOT NULL;          /* Reflects whether hi pot or modified hi pot */

   i = INTEGER NOT NULL;             
 
   ACTest = INTEGER NOT NULL WITH DEFAULT;             /*BOOLEAN*/
   C = FMS_Card;			  /* Card details selected here */
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;       /* DBEventText */
   Failed = INTEGER NOT NULL;            /* Flag to determine failed test */
   FTestDate = DATE NOT NULL WITH DEFAULT;
   HiPotLimit = Integer;                 /* Holds hi pot limit */
   HiPotTestValues = VARCHAR(200) NOT NULL WITH DEFAULT;
   Jobs = ARRAY OF Job;              /* Jobs tablefield array */
   rc = INTEGER NOT NULL;                /* Holds return code from db procs */  
   HiPotFeeders = ARRAY OF pas!ObjectSummaryClass;  /* for recording test results */
   NewCard = INTEGER NOT NULL; 
   DOObject = OperatorClass;
   ReturnedByRR = INTEGER NOT NULL WITH DEFAULT;           /* BOOLEAN */
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   status = INTEGER; 
   Tempvc = varchar(100) not null;       /* Temporary varchar holder */
   TempStr = StringObject;               /* used for string manipulation */ 
   vTestkv = INTEGER NOT NULL WITH DEFAULT;
   vTestDuration = INTEGER NOT NULL WITH DEFAULT;
   vStartMA = FLOAT NOT NULL WITH DEFAULT;
   vEndMA = FLOAT NOT NULL WITH DEFAULT;
   vFailedTestReason = VARCHAR(500) NOT NULL WITH DEFAULT;
) =
DECLARE
   NotifyFailedTest = PROCEDURE;
   NotifyPassedTest = PROCEDURE;
   NotifyTestResult = PROCEDURE;

ENDDECLARE
BEGIN
/*
** set up titles
*/
   title_feederkv   = 'Feeder kV';
   title_testtypekv = 'TestType kV'; 
   title_duration   = 'Duration';
   title_maxma      = 'Max mA';
   Failed = FALSE;
   ReturnedByRR = FALSE;
/*
** Get needed FMS Card information
*/
   C.Feeder = 0;
   REPEATED
   SELECT 
   DISTINCT
          :C.Feeder = C.Feeder,
          :C.FeederName = C.FeederName,
          :C.Card = C.Card,
          :C.CardClass = C.CardClass,
          :C.CardClassName = C.CardClassName,
          :C.NetworkFeeder = C.NetworkFeeder,
          :C.TypeOfCard = C.TypeOfCard
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card;

   IF C.Feeder = 0 THEN    /* OK for 3G since = -1 */
      CALLPROC TraceError (UserMessage =
              'ERROR: Move is not related properly to an FMS Card.',
                           TraceMessage = 
              'HiPotComplete: Move is not related properly to an FMS Card'
                          );
      RETURN (PU_CANCEL);
   ENDIF;  

   IF C.NetworkFeeder > 0 THEN
      i = 1;
      SELECT C.Object[i].Object = Object,
             C.Object[i].Name = Name
      FROM   TFMS_CardToObject 
      WHERE  Card = :C.Card
      BEGIN
         i = i + 1;
      END;      
   ELSE
      C.Object[1].Object = C.Feeder;
      C.Object[1].Name = C.FeederName;
   ENDIF;
   
   /*
   ** decide where the test results will be recorded 
   */
   IF C.NetworkFeeder = NetworkFeeder$3G THEN
      HiPotFeeders = C.Object.Duplicate();
      FOR i = 1 TO HiPotFeeders.LastRow DO
         HiPotFeeders[i].Name = C.FeederName;   // use card name
      ENDFOR;
   
   ELSEIF C.NetworkFeeder = NetworkFeeder$33KV THEN
      IF C.TypeOfCard = TypeOfCard$Portion THEN
         /* Hi Pot test applied to the main feeder only
         */
         SELECT  :HiPotFeeders[1].Object = C.Feeder,
                 :HiPotFeeders[1].Name = C.FeederName
         FROM    FMS_PortionLink L,
                 FMS_Card C
         WHERE   L.PortionCard = :C.Card AND
                 L.Card = C.Card;
         /* 
         ** append portion feeder name to the main feeder name
         */         
         HiPotFeeders[1].Name = HiPotFeeders[1].Name + ' ' + C.FeederName
      ELSE
         HiPotFeeders[1].Object  = C.Feeder;
         HiPotFeeders[1].Name  = C.FeederName;
      ENDIF;
   ELSE
      HiPotFeeders = C.Object.Duplicate();
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   ACTest = 0;
   IF HiPotType = 1 THEN 
      field(Title).TextLabel = 'DC High Pot Test Criteria for Feeder ' + C.FeederName;
   ELSEIF HiPotType = 2 THEN
      field(Title).TextLabel = 'Modified High Pot Test Criteria for Feeder ' + C.FeederName;
   ELSEIF HiPotType = 3 THEN 
      field(Title).TextLabel = 'AC High Pot Test Criteria for Feeder ' + C.FeederName;
      ACTest = 1;
   ELSEIF HiPotType = 4 THEN 
      field(Title).TextLabel = 'AC Modified High Pot Test Criteria for Feeder ' + C.FeederName;
      ACTest = 1;
   ELSE
      CALLPROC TraceError (UserMessage =
              'ERROR: Unknown High Pot Test Type.',
                           TraceMessage = 
              'HiPotComplete: Unknown test type.'
                          );
      RETURN (PU_CANCEL);
   ENDIF;
/*
** Load Test Criteria
*/
   SELECT :FeederKv   = FeederKv,
          :TestTypeKv = TestTypeKv,
          :Duration   = Duration, 
          :MaxMa      = MaxMa
   FROM   FMS_HiPotTestCriteria
   WHERE  Type = :HiPotType AND
          Job  = :JIP.Job;

   FailedTest.FailedDuration = Duration;
   FailedTest.FailedTestTypekV = TestTypekV;
/*
** Check if high pot test results exist for the job in an IR interface table.
** IF they do it means the move was downloaded to an operating order and
** the substation operating has already entered the test results.  We display
** them here for DO confirmation.
*/
   vTestkV = 0;
   vTestDuration = 0;
   vStartMA = 0;
   vEndMA = 0;
   vFailedTestReason = '';
   SELECT :vTestkv = Testkv,
          :vTestDuration = TestDuration,
          :vStartMA = StartMA,
          :vEndMA = EndMA,
          :vFailedTestReason = FailedTestReason
   FROM IR_HighPotTestResults
   WHERE Job = :JIP.Job;
   
/*   IF vTestkv <> 0 OR vTestDuration <> 0 OR vStartMA <> 0 OR vEndMA <> 0 THEN 
*/
   IF iirowcount > 0 THEN
      Field(text1).Curbias = FB_VISIBLE;
      FIELD(text).CurBias = FB_INVISIBLE;

      failedtest.failedtesttypekv = vTestkv;
      failedtest.failedDuration = vTestDuration;
      startresult = vStartMA;
      endresult = vEndMA;
      FailedTestReason = vFailedTestReason;
/*
** Set default bg color for the test results.
*/
      FIELD(failedtest.failedtesttypekv).BGColor = CC_PALE_BLUE;
      FIELD(failedtest.failedDuration).BGColor = CC_PALE_BLUE;
      FIELD(startresult).BGColor = CC_PALE_BLUE; 
      FIELD(endresult).BGColor = CC_PALE_BLUE;
      FIELD(FailedTestReason).BGColor = CC_PALE_BLUE;

      Field(failedtest).CurBias = FB_VISIBLE;
      FIELD(startresult).CurBias = FB_VISIBLE;
      FIELD(endresult).CurBias = FB_VISIBLE;
      FIELD(FailedTestReason).CurBias = FB_VISIBLE;

      Field(Adjust_Btn).CurBias = FB_LANDABLE;   
/*
** Some quirky screen adjustment makes the following two fields invisible
** so we force make them visible.
*/
      Field(Label1).CurBias = FB_VISIBLE;      
      Field(Label2).CurBias = FB_VISIBLE;
      Field(Cancelbutton).CurBias = FB_DIMMED;
      ReturnedByRR = TRUE;   /* Use as a BOOLEAN for SuspectTest call */

      IF HiPotType = 3 OR HiPotType = 4 THEN 
         FIELD(FailedReason).TextValue = 'Test Result:';
      ENDIF;
   ENDIF;  

   IF AutomaticExecution = TRUE THEN
      CurFrame.SendUserEvent (EventName = 'MakeInvisible');
   ENDIF;
END; 


ON USEREVENT 'MakeInvisible' =
BEGIN
/*
**  This statement is put into it's own userevent so that the frame will
**  be invisible.  (If it is placed in the initialize block, W4GL will make
**  it iconified, but it will not be invisible; therefore, placing it in a
**  userevent will correct this problem.)
*/
    Curframe.WindowVisibility = WV_INVISIBLE;
    CurFrame.SendUserEvent (EventName = 'CompleteProcessing');
END;


ON Click Adjust_btn =
BEGIN
   IF FIELD(Adjust_Btn).TextLabel = 'Adjust Result' THEN
      FIELD(failedtest.failedtesttypekv).BGColor = CC_PALE_CYAN;
      FIELD(failedtest.failedDuration).BGColor = CC_PALE_CYAN;
      FIELD(startresult).BGColor = CC_PALE_CYAN;
      FIELD(endresult).BGColor = CC_PALE_CYAN;
      FIELD(FailedTestReason).BGColor = CC_PALE_CYAN;

      Field(failedtest).CurBias = FB_CHANGEABLE;
      FIELD(startresult).CurBias = FB_CHANGEABLE;
      FIELD(endresult).CurBias = FB_CHANGEABLE;
      FIELD(FailedTestReason).CurBias = FB_CHANGEABLE;

      FIELD(Adjust_Btn).TextLabel = 'Save Result';
   ELSE 
      DetStack.OpConfirm.Operator1 = Dop.Description;

      FIELD(DetStack).AbsXLeft = (FIELD(Adjust_Btn).ParentField.ParentField.Width - FIELD(DetStack).Width)/2;
      FIELD(DetStack).AbsYBottom = FIELD(Adjust_BTN).ParentField.AbsYBottom;
      FIELD(DetStack).CurBias = FB_CHANGEABLE;
   ENDIF;
END;

ON CLICK DetStack.OK_Btn = 
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;

   NewValues = VARCHAR(80) NOT NULL WITH DEFAULT;
   OldValues = VARCHAR(80) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   FIELD(failedtest.failedtesttypekv).BGColor = CC_PALE_BLUE;
   FIELD(failedtest.failedDuration).BGColor = CC_PALE_BLUE;
   FIELD(startresult).BGColor = CC_PALE_BLUE; 
   FIELD(endresult).BGColor = CC_PALE_BLUE;
   FIELD(FailedTestReason).BGColor = CC_PALE_BLUE;

   Field(failedtest).CurBias = FB_VISIBLE;
   FIELD(startresult).CurBias = FB_VISIBLE;
   FIELD(endresult).CurBias = FB_VISIBLE;
   FIELD(FailedTestReason).CurBias = FB_VISIBLE;

   FIELD(Adjust_Btn).TextLabel = 'Adjust Result';

   IF failedtest.failedtesttypekv = vTestkv AND
      failedtest.failedDuration = vTestDuration AND
      startresult = vStartMA AND
      endresult = vEndMA AND
      FailedTestReason = vFailedTestReason THEN
      MESSAGE 'You did not change the test results.';

      FIELD(DetStack).CurBias = FB_INVISIBLE;
      RESUME;
   ENDIF;

   IF DetStack.OpConfirm.Operator2 = '' THEN
       MESSAGE 'A second operator or manager must confirm this change!';
       RESUME;
   ENDIF;
/*
** Evaluate entered employee number
*/
   DOObject.Name = DetStack.OpConfirm.Operator2;
   RetCode = DOObject.IsDOOnDesk();
   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;
      
   RetCode = CALLPROC IR_HighPotTestUpd (
           Job = JIP.Job,
           TestKV = failedtest.failedtesttypekv,
           TestDuration = failedtest.failedDuration,
           StartmA = startresult,
           EndmA = endresult,
           FailedTestReason = FailedTestReason);

   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 'Failed to save adjustments due to database error. Try again.',
                     TraceMessage = 'HiPotComplete; Failed to save adjustments due to database error');

         failedtest.failedtesttypekv = vTestkv;
         failedtest.failedDuration = vTestDuration;
         startresult = vStartMA;
         endresult = vEndMA;
         FailedTestReason = vFailedTestReason;

         FIELD(DetStack).CurBias = FB_INVISIBLE;
         RESUME;
   ELSE
        CALLPROC DDB_COMMIT; 
   ENDIF;

   OldValues = 'kV:' + VARCHAR(vTestkv) +
               ' /Dur:' + VARCHAR(vTestDuration) +
               ' /St mA:' + varchar(vStartMA) + 
               ' /End mA:' + Varchar(vEndMA) + 
               ' /Rea:' + vFailedTestReason;
   NewValues = 'kV:' + VARCHAR(failedtest.failedtesttypekv) +
               ' /Dur:' + VARCHAR(failedtest.failedDuration) +
               ' /St mA:' + varchar(StartResult) + 
               ' /End mA:' + Varchar(EndResult) + 
               ' /Rea:' + FailedTestReason; 
      
   CALLPROC SOA_LogIns (
                 Card = JIP.Card,
                 Job  = JIP.Job,
                 SwitchingItem = JIP.SwitchingItem,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Adjust HighPot',
                 Old = OldValues, 
                 New = NewValues);

   vTestkv = failedtest.failedtesttypekv;
   vTestDuration = failedtest.failedDuration;
   vStartMA = StartResult;
   vEndMA = EndResult;
   vFailedTestReason = FailedTestReason;
/*
** Send email to Chief DO
*/
   IF EmailClass IS NULL THEN
        EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 2;            // hipot update
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'CDO';
   EmailClass.Subject = 'HiPot Test Result on ' + C.FeederName + ' adjusted by ' + DOp.Description + ' and ' + DOObject.Description;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ' and ' + DOObject.Description + ';;' + 
                            'CardID=' + VARCHAR(JIP.Card) + ';;' + 
                            'CardName=' + C.FeederName + ';;' + 
                            'TestDate=' + VARCHAR(Date('Now')) + ';;';                         
   EmailClass.Message2 = 'OldValue=' + OldValues + ';;' + 
                            'NewValue=' + NewValues + ';;';
   EmailClass.Template = 'HipotUpdateToCDO.html';
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
         Message 'Unable to notify Chief D.O. by email';
   ENDIF;
   FIELD(DetStack).CurBias = FB_INVISIBLE;
END;

ON Click DetStack.Cancel_Btn = 
BEGIN
   failedtest.failedtesttypekv = vTestkv;
   failedtest.failedDuration = vTestDuration;
   startresult = vStartMA;
   endresult = vEndMA;
   FailedTestReason = vFailedTestReason;

   FIELD(failedtest.failedtesttypekv).BGColor = CC_PALE_BLUE;
   FIELD(failedtest.failedDuration).BGColor = CC_PALE_BLUE;
   FIELD(startresult).BGColor = CC_PALE_BLUE; 
   FIELD(endresult).BGColor = CC_PALE_BLUE;
   FIELD(FailedTestReason).BGColor = CC_PALE_BLUE;

   Field(failedtest).CurBias = FB_VISIBLE;
   FIELD(startresult).CurBias = FB_VISIBLE;
   FIELD(endresult).CurBias = FB_VISIBLE;
   FIELD(FailedTestReason).CurBias = FB_VISIBLE;

   FIELD(DetStack).CurBias = FB_INVISIBLE;
   FIELD(Adjust_Btn).TextLabel = 'Adjust Result';
END;

ON Click Failed_btn =
BEGIN
   Field(Failed_btn).CurBias = FB_INVISIBLE;
   Field(FailedTest).CurBias = FB_CHANGEABLE;
   Field(Text).TextValue = 'Please Enter FAILED Test Results and Click OK';
   Field(Text).BgColor = CC_PALE_PINK;
   FIELD(JuliaGreenie).CurBias = FB_INVISIBLE;
   Curframe.InputFocusField = Field(FailedTest.FailedTestTypeKV);
   Failed = TRUE;
   tempvc = 'Test Failed';
   Curframe.Flush();
   Curframe.WindowHeight = Curframe.TopForm.ChildFields[1].OuterHeight + 200;
END;


ON USEREVENT 'CompleteProcessing', 
ON Click OK_btn =
DECLARE
   DelayFOTCard = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE 
BEGIN
/*  
** Determine if test passed or failed 
*/
   IF Failed = FALSE AND AutomaticExecution = FALSE THEN
      IF Field(StartResult).ParentField.ParentField.HasDataChanged = FALSE AND 
         Field(text1).CurBias = FB_INVISIBLE THEN
         IF CurFrame.ConfirmPopup(messagetext = 'You have not changed any ' +
               'data,  do you still want to continue?') = PU_CANCEL THEN
            RESUME;
         ENDIF;
      ENDIF;
 
      IF HiPotType =1 OR HiPotType = 2 THEN
         IF StartResult > MaxMA THEN
            tempvc = 'Test Failed: Start Result is greater than Maximum mA value';
         ELSEIF EndResult > MaxMA THEN 
            tempvc = 'Test Failed: End Result is greater than Maximum mA value';
         ELSEIF EndResult > StartResult THEN  
            tempvc = 'Test Failed: End Result is greater than Start Result';
         ELSEIF ReturnedByRR = TRUE AND vTestkV < TestTypekV THEN
            tempvc = 'Test Failed: Test kV was too low';
         ELSEIF ReturnedByRR = TRUE AND vTestDuration < Duration THEN
            tempvc = 'Test Failed: Test duration was too short';
         ELSEIF SQUEEZE(FailedTestReason) <> '' THEN
            tempvc = 'Test Failed: ' + FailedTestReason;
         ELSE 
            Tempvc = ''; 
         ENDIF;

         HiPotTestValues = 'kV=' +
		      VARCHAR(failedtest.failedtesttypekv) +
                     ' /Dur=' +
		      VARCHAR(failedtest.failedDuration) +
                     ' /St mA=' + varchar(StartResult) + 
                     ' /End mA=' + Varchar(EndResult);

      ELSEIF HiPotType = 3 OR HiPotType = 4 THEN
         FailedTestReason = UPPERCASE(SQUEEZE(FailedTestReason));

         IF ReturnedByRR = TRUE AND vTestkV < TestTypekV THEN
            tempvc = 'Test Failed: Test kV was too low';
         ELSEIF ReturnedByRR = TRUE AND vTestDuration < Duration THEN
            tempvc = 'Test Failed: Test duration was too short';
         ELSEIF ReturnedByRR = TRUE AND FailedTestReason = 'TEST_FAILED' THEN
            tempvc = 'Test Failed as indicated by Substation Operator';
         ELSEIF ReturnedByRR = TRUE AND FailedTestReason = 'TEST_PASSED' THEN
            Tempvc = '';
         ELSEIF FailedTestReason <> '' THEN
            tempvc = 'Test Failed: ' + FailedTestReason;
         ELSE
            Tempvc = '';         
         ENDIF;

         HiPotTestValues = 'kV=' +
		      VARCHAR(failedtest.failedtesttypekv) +
                     ' /Dur=' +
		      VARCHAR(failedtest.failedDuration) +
                     ' /Result=' + FailedTestReason;
      ENDIF;
   ENDIF;
/* 
** Test failed 
*/
   IF tempvc <> '' THEN 
      IF Failed = TRUE THEN 
         /* DO selected "Failed Other" button */
         CALLPROC NotifyFailedTest(TestResult = HiPotTestValues);
      ENDIF;
/*
** take a record of the time of the test failed.
*/
      FTestDate = Date('Now');        

/*  Log the failure */
      CALLPROC SOA_LogIns (Card = C.Card,
                        SwitchingItem = 0,
                        Job  = JIP.Job,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'TEST FAILED',
                        Old  = 'Criteria: Test kV: ' + Varchar(TestTypekV) + 
                                    '/Dur: ' + VarChar(Duration) + 
                                    '/Max: ' + VarChar(MaxMA),
                        New  = 'Result: ' + HiPotTestValues);

      CALLPROC DDB_COMMIT;

      rc =  CALLFRAME SuspectTest(C = C,
                                  text = Tempvc, 
                                  FailedAtLowerLevel = Failed,
                                  OpOrderFailure = ReturnedByRR);
      IF rc = PU_CANCEL THEN

         RETURN(PU_CANCEL);

      ELSEIF (rc = PU_OK) THEN
         /* 
         ** DO selects "Create FOT", send a notification.
         ** Check Failed flag to avoid sending duplication notification message.
         */
         IF Failed = FALSE THEN 
            CALLPROC NotifyFailedTest(TestResult = HiPotTestValues);
         ENDIF;
/*
**  Clear high voltage status before creating transfer card.
*/
         JIP.Response = 'Test Failed - FOT';
      
         FOR i = 1 TO C.Object.LastRow() DO
            RetCode = CALLPROC FMS_ObjStatDel (Object = C.Object[i].Object, 
                                  Status = TypeName$HV);
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               RETURN (PU_CANCEL);
            ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;
         JIP.ResponseUpd();
         
         /*
         ** Save high pot test results.
         */ 
         CALLPROC FMS_HiPotTestCriteriaDel(Job = JIP.Job, Type = HiPotType);

         FOR i = 1 TO HiPotFeeders.LastRow() DO
            rc = CALLPROC FMS_HighPotHistoryIns ( 
                 Card = C.Card,
                 CardType = C.CardClassName,
                 Feeder = HiPotFeeders[i].Object,
                 FeederName = HiPotFeeders[i].Name,
                 HighPotType = HiPotType,
                 TestDate = FTestDate,
                 FeederKV = FeederKv,
                 TestTypeKV = TestTypeKV,
                 Duration = Duration,
                 FailedTestTypeKV = FailedTest.FailedTestTypeKV,
                 FailedDuration = FailedTest.FailedDuration,
                 FailedTestReason = FailedTestReason,
                 StartmA = StartResult,
                 EndmA = EndResult,
                 FRAACTest = ACTest, 
                 FRATestFailed = 1);  /*Test Failed*/
            IF rc < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
               'WARNING: High Pot Failure results could not be saved. ' +
               'Processing will continue.',
               TraceMessage = 
               'HiPotComplete: High Pot Failure results could not be saved.'
                       );
            ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;             

         DelayFOTCard = FALSE;
         IF OrderReturnStatus IS NOT NULL THEN
            IF OrderReturnStatus.DelayFOT = TRUE THEN
               DelayFOTCard = TRUE;
               OrderReturnStatus.TestType = 'H';
               OrderReturnStatus.TestDate = FTestDate;
               RETURN(PU_OK);
            ENDIF;
         ENDIF;

         IF DelayFOTCard = FALSE THEN
            /* 
            **  Create FOT card if card is not ISO
            **  else create another ISO 
            **  (the substitution to ISO is done in the called frame) 
            */ 
            status = CALLFRAME CreateXferCard
                     (OldCardID    = C.Card, 
                     XferCardKey = byref(NewCard),
                     XferCardClass = Type$FOT, 
                     TestType = 'H',
                     TestDate = FTestDate
                     );

            IF (status = PU_OK) THEN 
               CALLPROC DDB_COMMIT;
               /*
               ** Log the creation of a transfer ISO card due to FOT
               */
               IF C.CardClass = Type$ISO THEN
                   CALLPROC SOA_LogIns (Card = NewCard,
                                SwitchingItem = 0,
                                Job  = NULL,
                                Time = DATE('now'),
                                UserName = UserName,
                                Item = 'Xfer Card Created',
                                Old  = '',
                                New  = 'Reason: HiPot FOT');
                    CALLPROC DDB_COMMIT;
               ENDIF;
               /* 
               **   Load the new FOT card into the frame:   
               */ 
               FCFrame.SendUserEvent(EventName = 'update_xfer', 
                                     messageinteger = NewCard);
               /*
               **   Return special code to stop processing of current card.
               */
               RETURN(Type$FOT);
            ELSE 
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage =
                 'ERROR: Unable to Create FOT Card.',
                 TraceMessage = 
                 'HiPotComplete: Unable to create FOT Card.');
               RETURN(PU_CANCEL);
            ENDIF; 
         ENDIF;
         
      ELSEIF RC = FailTest$Accept Then
	
         CALLPROC SOA_LogIns (Card = C.Card,
                             SwitchingItem = 0,
                             Job  = JIP.Job,
                             Time = DATE('now'),
                             UserName = UserName,
                             Item = 'ACCEPTED FAILURE',
                             Old  = 'Criteria: Test kV: ' + 
                                     Varchar(TestTypekV) + 
                                    '/Dur: ' + VarChar(Duration) + 
                                    '/Max: ' + VarChar(MaxMA),
                             New  = 'Results: kV: ' +
			            VARCHAR(failedtest.failedtesttypekv) +
                                    '/Dur: ' +
				    VARCHAR(failedtest.failedDuration) +
                                    '/St mA: ' + varchar(StartResult) + 
                                    '/End mA: ' + Varchar(EndResult));
         CALLPROC DDB_COMMIT;

      ELSEIF RC = FailTest$RRConsideration Then

         CALLPROC SOA_LogIns (Card = C.Card,
                             SwitchingItem = 0,
                             Job  = JIP.Job,
                             Time = DATE('now'),
                             UserName = UserName,
                             Item = 'Test Failed',
                             Old  = 'RR Consideration',
                             New  = 'Did not Create FOT');
         CALLPROC DDB_COMMIT;
         CALLPROC FMS_HiPotTestCriteriaDel( Job = JIP.Job, Type = HiPotType);
         CALLPROC DDB_COMMIT;

         IF HiPotType = 1 OR HiPotType = 2 THEN
            JIP.Response = 'Fail: ' + Varchar(StartResult) + 'mA - ' + varchar(EndResult) + 'mA';
         ELSEIF HiPotType = 3 OR HiPotType = 4 THEN
            JIP.Response = 'Test Failed';
         ENDIF;
 
         JIP.ResponseUpd();
         RETURN(PU_OK);

      ELSEIF RC = FailTest$NoFOT Then
         /* 
         ** DO selects "No FOT", send a notification.
         ** Check Failed flag to avoid sending duplication notification message.
         */
         IF Failed = FALSE THEN 
            CALLPROC NotifyFailedTest(TestResult = HiPotTestValues);
         ENDIF;

         CALLPROC SOA_LogIns (Card = C.Card,
                             SwitchingItem = 0,
                             Job  = JIP.Job,
                             Time = DATE('now'),
                             UserName = UserName,
                             Item = 'Test Failed',
                             Old  = '',
                             New  = 'Clicked "No FOT"');
         CALLPROC DDB_COMMIT;
         CALLPROC FMS_HiPotTestCriteriaDel( Job = JIP.Job, Type = HiPotType);
         CALLPROC DDB_COMMIT;

         IF HiPotType = 1 OR HiPotType = 2 THEN
            JIP.Response = 'Fail: ' + Varchar(StartResult) + 'mA - ' + varchar(EndResult) + 'mA';
         ELSEIF HiPotType = 3 OR HiPotType = 4 THEN
            JIP.Response = 'Test Failed';
         ENDIF;

         JIP.ResponseUpd();
         RETURN(PU_OK);
      ENDIF;
   ENDIF;
/* 
**  If I get here, the Test Passed (or user has forced it to pass).
*/
   CALLPROC NotifyPassedTest(TestResult = HiPotTestValues);

   FTestDate = Date('Now');
   CALLPROC FMS_HiPotTestCriteriaDel( Job = JIP.Job, Type = HiPotType);

   FOR i = 1 TO HiPotFeeders.LastRow() DO
      rc = CALLPROC FMS_HighPotHistoryIns ( 
                    Card = C.Card,
                    CardType = C.CardClassName,
                    Feeder = HiPotFeeders[i].Object,
                    FeederName = HiPotFeeders[i].Name,
                    HighPotType = HiPotType,
                    TestDate = FTestDate,
                    FeederKV = FeederKv,
                    TestTypeKV = TestTypeKV,
                    Duration = Duration,
                    FailedTestTypeKV = FailedTest.FailedTestTypeKV,
                    FailedDuration = FailedTest.FailedDuration,
                    FailedTestReason = FailedTestReason,
                    StartmA = StartResult,
                    EndmA = EndResult,
                    FRAACTest = ACTest, 
                    FRATestFailed = 0);  /* Test Passed, or was accepted */
      IF rc < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage =
              'ERROR: Unable to update high pot test history.',
                           TraceMessage = 
              'HiPotComplete: Unable to update high pot test history.'
                          );
         RETURN(PU_CANCEL);
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;

   IF HiPotType = 1 OR HiPotType = 2 THEN 
      JIP.Response = Varchar(StartResult) + 'mA - ' + varchar(EndResult) + 'mA';
   ELSEIF HiPotType = 3 OR HiPotType = 4 THEN
      JIP.Response = 'Test Passed';
   ENDIF;

   JIP.ResponseUpd();
   RETURN(PU_OK);
END;
 
           
ON Click CancelButton =
BEGIN
   RETURN (PU_Cancel);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Procedure NotifyFailedTest(
   TestResult = VARCHAR(200) NOT NULL WITH DEFAULT;
)=
DECLARE
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   MsgText = 'Feeder ' + C.FeederName + 
             ' - High Pot Test Failed with Result: ' + TestResult + '.';

   CALLPROC NotifyTestResult(MsgText = MsgText);
END;

Procedure NotifyPassedTest(
   TestResult = VARCHAR(200) NOT NULL WITH DEFAULT;
)=
DECLARE
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   MsgText = 'Feeder ' + C.FeederName + 
             ' - High Pot Test Passed or Accepted with Result:' + TestResult + '.';

   CALLPROC NotifyTestResult(MsgText = MsgText);
END;

Procedure NotifyTestResult(
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
)=
DECLARE
   DCCRegion = VARCHAR(20) NOT NULL WITH DEFAULT;
   RetCode = INTEGER;
ENDDECLARE
BEGIN
   DccRegion = '';

   /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
          :DccRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :C.Object[1].Object AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                      ,MessageText = MsgText 
                                      ,Time = date('now')
                                      ,Priority = 0
                                      ,MessageType = 0
                                      ,Card = C.Card);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurFrame.Trace (Text = 'Automated DCC message ' + 
              'not sent for ' + C.FeederName + ' regarding: ' + 
              MsgText);
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;
END;  

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            HipotIssue

 /*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          HiPotIssue    
**
**  01/16/93  mts   Frame created             
**  03/03/93  em    modifications following ph3 trip to meet con ed requirements.
**  03/05/93  em    removed rollbacks and commits; part of larger transaction.
**  10/29/03  em    Job to JIP. Select card data.
**  05/02/03  em    Made Cancel Button invisible on front of screen.  Need to 
**                  prevent cancel during issue process to prevent HV status 
**                  from getting out of whack.
**  10/05/05  em    Add Conditional High Pot Criteria Check
**  07/17/06  ysp   Add AC High Pot Criteria Check
**  09/05/06  em    Adding Status Count to Object Status select
**  12/08/09  ysp   Add AC Modified High Pot Criteria
**  01/06/11  em    For 3G use first feeder on card, they should all have same kV
**  10/15/14  em    Operating Error Response, add Confirmation check to confirm test
**                  values following OK click
**  12/11/14  em    Zero values to force to enter test values. Response to operating error.
**  09/29/15  em    When cancelling from conditional high pot warning, add message that DO
**                  must manually abort issued move.  Sannito preference would be to automatically 
**                  abort, but since we are embedded in JobInProgress Job Action method, we can't
**                  adequately handle automatic abort without adding a special return code with 
**                  additional programming to handle return code as it is passed back through the 
**                  issue move job action chain. 
**  07/22/16  ysp   if 33kv portion card, Hi Pot test should be applied to the main feeder. 
**  01/17/17  em    Changed maxMa from Float to Integer since it is saved as an integer.
**  03/12/18  pkw   Limit TestTypeKV based on existance of MTAIsolationFor relationship
**  03/14/18  pkw   After popup when limiting TestTypeKv, clear out field and set focus to that field.
**  02/14/23  em    Alter label for test type = 1 to indicate "DC".  Test types 2 and 4 will no longer be used.
**                  Change ConfirmMessage to on screen stackfield for better visibility.
*/

INITIALIZE
(
   JIP = Job;			          /* Job being processed */
   HiPotType = Integer NOT NULL;         /* Reflects hi pot or mod hi pot*/
   
   Feeder = INTEGER NOT NULL;            /* Card Feeder */
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; /*Card Feeder*/
   i = INTEGER NOT NULL;              
   rc = INTEGER NOT NULL;                /* Holds return code from db procs */    
   RetCode = INTEGER NOT NULL;           /* Also Holds return code from db procs */ 
   TempStr = StringObject;                /* used for string manipulation */
   HiPotLimit = Integer;                 /* Holds hi pot limit */
   
   MaxkVLevel = INTEGER NOT NULL WITH DEFAULT;   /*Conditional Values*/
   MaxDuration = INTEGER NOT NULL WITH DEFAULT; 
   FeederGroupName = VARCHAR(40) NOT NULL WITH DEFAULT;
   WarningMessage = VARCHAR(160) NOT NULL WITH DEFAULT;
   Conditional = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   ConditionalMsg = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardID = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeeder  = INTEGER NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   LimitTestKV = INTEGER NOT NULL WITH DEFAULT;
   MTAIsoSwitch = INTEGER NOT NULL WITH DEFAULT;   
) =
BEGIN
/*
** Get Feeder info assuming Job is on FMS card.
*/
   NetworkFeeder = 0;
   TypeOfCard = 0;
   Feeder = 0;
   REPEATED
   SELECT  :Feeder = CTO.Object,
           :FeederName = C.FeederName,
           :CardID = C.Card,
           :NetworkFeeder = C.NetworkFeeder,
           :TypeOfCard = C.TypeOfCard
   FROM    FMS_Card C,
           TFMS_CardToObject CTO,
           SOA_JobControl JC
   WHERE   JC.Job = :JIP.Job AND
           JC.Card = C.Card AND
           C.Card = CTO.Card ;

   IF Feeder = 0 THEN
      MESSAGE 'Feeder HiPotIssue Program called from a non-FMS Job... ' +
              'Unable to continue.';
      RETURN (PU_CANCEL);
   ENDIF;

   IF NetworkFeeder = NetworkFeeder$33KV AND TypeOfCard = TypeOfCard$Portion THEN
      // Hi Pot test applied to the main feeder only
      SELECT  :Feeder = C.Feeder,
              :FeederName = C.FeederName
      FROM    FMS_PortionLink L,
              FMS_Card C
      WHERE   L.PortionCard = :CardID AND
              L.Card = C.Card;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
/*
** Set up titles
*/
   title_feederkv   = 'Feeder Kv';
   title_testtypekv = 'TestType Kv'; 
   title_duration   = 'Duration';
   title_maxma      = 'Max mA';
/*
** Determine High Pot Type
*/
   IF HiPotType = 1 THEN
      field(Title).TextLabel = 'DC High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 2 THEN 
      field(Title).TextLabel = 'Modified High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 3 THEN 
      field(Title).TextLabel = 'AC High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 4 THEN 
      field(Title).TextLabel = 'AC Modified High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSE
      MESSAGE 'Feeder HiPotIssue Program called with ' +
              'unknown High Pot Test Type parameter... Unable to continue.';
      RETURN (PU_CANCEL);
   ENDIF;
/*
** Get FeederKv value for this feeder
*/
   feederkv = 0;
   SELECT :feederkv = R.Normal
   FROM   Udb_Rating R, 
          Udb_Grouping G
   WHERE  R.Object = G.Grouping AND
          G.Member = :Feeder AND
          G.Relationship = :Type$Rated_as;

   WHILE feederkv = 0  OR  feederkv IS NULL DO 

      feederKv = CALLFRAME ProvideFeederkV(Feeder = FeederName);
      
      IF feederkv = 0 OR feederkv IS NULL THEN
         Message 'Please enter a Feeder kV other than 0.';
      ENDIF;

   ENDWHILE;
/***********************
***********************
***Remainder is commented out because we are zeroing out test values forcing
***manual entry
***********************/
TestTypeKv = 0;
Duration = 0; 
MaxMA = 0;          
MessageArea = 'You are now required to manually enter test values for all High Pot Tests.';
/* 
** Get Hi Pot limit for this feeder
*
   HiPotLimit = 0;
   SELECT :HiPotLimit = MIN(R.Normal) 
   FROM   Udb_Rating R, 
          Udb_Grouping G1, 
          Udb_Grouping G2
   WHERE  R.Object = G1.Grouping 
          AND G1.Relationship = :Type$Rated_as
          AND G1.Member = G2.Member
          AND G2.Relationship = :Interaction$MemberOf
          AND G2.Grouping = :Feeder;
/*
**  If high pot limit exists and is less than the feederkv, use it instead.
*
   IF HiPotLimit IS NOT NULL AND HiPotLimit <> 0 AND HiPotLimit < feederkv THEN
  
      Message 'This Feeder has voltage limiting Equipment.  The voltage level ' +
              'used to determine the test criteria is ' + varchar(HiPotLimit);
      feederkv = HiPotLimit;

   ENDIF;
/*
** Determine if FeederKv exists in limits table
*
   SELECT  :TestTypeKv = TestTypeKv,
           :Duration   = Duration, 
           :MaxMa      = MaxMa
   FROM    FMS_HiPotTest
   WHERE   Type = :HiPotType AND
           FeederKv = :feederkv AND
           TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederkV = :feederkv
                        );

   IF iirowcount = 0 THEN
/* 
**  Case where FeederKv does not exist in limits table 
*
        MessageArea = 'No test criteria for this Feeder kV was found. ' + 
                      'Criteria for next highest Feeder kV chosen.';
        MaxMA = -999;
        SELECT  :TestTypeKv = TestTypeKv,
                :Duration   = Duration, 
                :MaxMa      = MaxMa
        FROM    FMS_HiPotTest
        WHERE   Type = :HiPotType AND
           FeederKv = (
                            SELECT MIN(FeederKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType 
                            AND   FeederKv > :feederkv
                      ) AND 
           TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederKv = (
                                        SELECT MIN(FeederKv) FROM FMS_HiPotTest
                                        WHERE Type = :HiPotType 
                                        AND   FeederKv > :feederkv
                                        )
                        );
/* 
**  Case where There is no next highest feederkv, take the max 
*
        IF MaxMA = -999 THEN

            SELECT  :TestTypeKv = TestTypeKv,
                    :Duration   = Duration, 
                    :MaxMa      = MaxMa
            FROM    FMS_HiPotTest
            WHERE   Type = :HiPotType AND
               FeederKv = (
                            SELECT MAX(FeederKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType 
                      ) AND 
               TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederKv = (
                                        SELECT MAX(FeederKv) FROM FMS_HiPotTest
                                        WHERE Type = :HiPotType 
                                        )
                        );
        ENDIF;

   ENDIF;
/*
** Look for conditional high pot test criteria and prepare message.
*/
   Conditional = FALSE;
   FeederGroupName = '';
   SELECT  :FeederGroupName = HPM.FeederGroupName,
           :MaxkVLevel = HPM.MaxkVLevel,
           :MaxDuration = HPM.MaxDuration,
           :WarningMessage = HPM.WarningMessage
   FROM    FMS_HighPotMaxCriteria HPM,
           FMS_HighPotMaxFeeder HPF
   WHERE   HPF.Feeder = :Feeder AND
           HPF.FeederGroupName = HPM.FeederGroupName;

   IF FeederGroupName <> '' THEN  /* look if status is set or pending */
  
      i = 0;
      SELECT :i = Object
      FROM   FMS_ObjectStatus 
      WHERE  Object = :Feeder AND
             StatusCount > 0 AND
             Status = :Status$NoHPMax;

      IF i = 0 THEN
         SELECT :i = Object
         FROM   FMS_PendingStatus 
         WHERE  Object = :Feeder AND
                StatusCount > 0 AND
                PendingStatus = :Status$NoHPMax AND
                IssuedOperator = :FO.Object;

         IF i = 0 THEN
            Conditional = TRUE;
            ConditionalMsg = 'Conditional High Pot per Feeder Group ' +
               FeederGroupName + '.' + HC_NEWLINE + 'Criteria should not exceed test kV = ' +
               VARCHAR(MaxkVLevel); 
            IF MaxDuration = 0 THEN
               ConditionalMsg = ConditionalMsg + '.';
            ELSE
               ConditionalMsg = ConditionalMsg +
                                ' or duration = ' + VARCHAR(MaxDuration) + '.';
            ENDIF;
            FIELD(ConditionalText).TextValue = ConditionalMsg; 
            FIELD(ConditionalText).Curbias = FB_VISIBLE;
         ENDIF;
      ENDIF;
   ENDIF;
   /*
   **  Hipots should be limited if there are LA equipment on feeder and hipot is being done on the 
   **  same side of MTA Isolation Switch.  
   */
   LimitTestKV = FALSE;
   MTAIsoSwitch = 0;   
   SELECT :MTAIsoSwitch = G.Member
   FROM    Udb_Grouping G,
           Udb_ExtendedType ET
   WHERE   G.Grouping = :Feeder AND
           G.Relationship = :Interaction$MTAIsolationFor AND
           G.MemberType = ET.Type AND
           ET.SuperType = :Type$Switch;
   IF MTAIsoSwitch <> 0 THEN
      IF MTAOpen = TRUE THEN  /* Global variable */
         /*
         **  See if equip is downstream of MTA ISO. If it is then
         **  limit kv.
         */
         i = 0;
         SELECT :i = COUNT(*)
         FROM   Udb_Grouping G,
                Udb_ExtendedType ET
         WHERE  G.Grouping = :MTAIsoSwitch AND
                G.Relationship = :Interaction$MTADownstreamOf AND
                G.Member = :JIP.Equip;
         IF i <> 0 THEN
            /*
            **  MTA Iso is open and equip is downstream, limit kv.
            */
            LimitTestKV = TRUE;
         ENDIF;
      ELSE
         /*
         **  MTA iso switch exists and it is closed.  Limit KV.
         */
         LimitTestKV = TRUE;
      ENDIF;
   ENDIF;
END;


ON Click OK_Btn =
BEGIN
   IF LimitTestKV = TRUE AND TestTypeKv > 10 THEN
      Message 'High Pot Limited to 10Kv due to lightning arrester on feeder.  Please update TestType Kv.';
      TestTypeKV = 0;
      Curframe.InputFocusField = FIELD(TestTypeKV);
      RESUME;
   ENDIF;  

/*
** If this is a conditional high pot, check entered criteria vs max values
** and produce warning if necessary.
*/
   IF Conditional = TRUE THEN
      IF TestTypekV > MaxkVLevel OR (Duration > MaxDuration AND MaxDuration > 0) THEN

         ConditionalMsg = 'Do not High Pot above ' + VARCHAR(MaxkVLevel) + 
                        'kV ';
         IF MaxDuration > 0 THEN
            ConditionalMsg = ConditionalMsg + 'or ' +
                        VARCHAR(MaxDuration) + ' mins ';
         ENDIF;
         ConditionalMsg = ConditionalMsg + 'without ' + WarningMessage;
         rc = CALLPROC WarningOverride (
                Card = JIP.Card,
                SwitchingItem = JIP.SwitchingItem,
                Job = JIP.Job,
                WarningText = ConditionalMsg);

         IF rc = PU_CANCEL THEN
            Message 'You must manually abort the issued high pot move.';
            RETURN(PU_CANCEL);
         ENDIF;
      ENDIF;
   ENDIF;
/* 
** Post Operating Error Confirmation step
*/
   Confirm_Stk.MessageArea = 'Please confirm you are issuing the high pot test ' +
                     'with the following values: '  + HC_NEWLINE  + HC_NEWLINE +
                     '  FeederKV = ' + VARCHAR(FeederKv) + HC_NEWLINE +
                     '  TestTypeKV = ' + VARCHAR(TestTypeKv) + HC_NEWLINE +
                     '  Duration = ' + VARCHAR(Duration) + HC_NEWLINE +
                     '  MaxMA = ' + VARCHAR(MaxMa) + HC_NEWLINE + HC_NEWLINE +
                     'Click Cancel if you need to change any of these values.';
   FIELD(Confirm_Stk).AbsYBottom = FIELD(ok_btn).PARENTFIELD.PARENTFIELD.AbsYBottom;
   FIELD(Confirm_Stk).AbsXLeft = FIELD(ok_btn).ParentField.ParentField.AbsXLeft;
   FIELD(Confirm_Stk).CurBias = FB_LANDABLE;
END;   

ON CLICK Confirm_Stk.Cancel_btn =
BEGIN
   FIELD(Confirm_Stk).CurBias = FB_INVISIBLE;
   RESUME;
END;

ON CLICK Confirm_Stk.Ok_btn =
BEGIN
/*
**  To avoid inserting duplicates, perform a delete first.
*/
   rc = CALLPROC FMS_HiPotTestCriteriaDel( Job = JIP.Job, 
                                           Type = HiPotType);

   IF rc < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to save test criteria due a delete error.';
       RETURN (PU_Cancel);
   ENDIF;
/* 
**  Save criteria in table to compare when job is completed
*/
   rc = CALLPROC FMS_HiPotTestCriteriaIns( 
                              Job        = JIP.Job,
                              Type       = HiPotType,
                              FeederKv   = FeederKv,
                              TestTypeKv = TestTypeKv,
                              Duration   = Duration,
                              MaxMa      = MaxMa
                          );
   IF rc < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to save test criteria.';
       RETURN (PU_Cancel);
   ENDIF;
   
	RETURN (PU_OK);
END;

ON CLICK Menu.File.ShowList =
BEGIN
    CallFrame SelectHipotCriteria(
                       FeederKv   = FeederKv,
                       HiPotType  = HiPotType,
                       TestTypeKv = Byref(TestTypeKv), 
                       Duration = Byref(Duration), 
                       MaxMA    = Byref(MaxMA));
END;

ON Click CancelButton =
BEGIN
	RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            HipotIssueConfirm

 /*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          HiPotIssue    
**
**  01/16/93  mts   Frame created             
**  03/03/93  em    modifications following ph3 trip to meet con ed requirements.
**  03/05/93  em    removed rollbacks and commits; part of larger transaction.
**  10/29/03  em    Job to JIP. Select card data.
**  05/02/03  em    Made Cancel Button invisible on front of screen.  Need to 
**                  prevent cancel during issue process to prevent HV status 
**                  from getting out of whack.
**  10/05/05  em    Add Conditional High Pot Criteria Check
**  07/17/06  ysp   Add AC High Pot Criteria Check
**  09/05/06  em    Adding Status Count to Object Status select
**  12/08/09  ysp   Add AC Modified High Pot Criteria
**  01/06/11  em    For 3G use first feeder on card, they should all have same kV
**  10/15/14  em    Operating Error Response, add Confirmation check to confirm test
**                  values following OK click
**  12/11/14  em    Zero values to force to enter test values. Response to operating error.
**  09/29/15  em    When cancelling from conditional high pot warning, add message that DO
**                  must manually abort issued move.  Sannito preference would be to automatically 
**                  abort, but since we are embedded in JobInProgress Job Action method, we can't
**                  adequately handle automatic abort without adding a special return code with 
**                  additional programming to handle return code as it is passed back through the 
**                  issue move job action chain. 
**  07/22/16  ysp   if 33kv portion card, Hi Pot test should be applied to the main feeder. 
**  01/17/17  em    Changed maxMa from Float to Integer since it is saved as an integer.
**  03/12/18  pkw   Limit TestTypeKV based on existance of MTAIsolationFor relationship
**  03/14/18  pkw   After popup when limiting TestTypeKv, clear out field and set focus to that field.
**  02/14/23  em    Alter label for test type = 1 to indicate "DC".  Test types 2 and 4 will no longer be used.
*/

INITIALIZE
(
   JIP = Job;			          /* Job being processed */
   HiPotType = Integer NOT NULL;         /* Reflects hi pot or mod hi pot*/
   
   Feeder = INTEGER NOT NULL;            /* Card Feeder */
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT; /*Card Feeder*/
   i = INTEGER NOT NULL;              
   rc = INTEGER NOT NULL;                /* Holds return code from db procs */    
   RetCode = INTEGER NOT NULL;           /* Also Holds return code from db procs */ 
   TempStr = StringObject;                /* used for string manipulation */
   HiPotLimit = Integer;                 /* Holds hi pot limit */
   
   MaxkVLevel = INTEGER NOT NULL WITH DEFAULT;   /*Conditional Values*/
   MaxDuration = INTEGER NOT NULL WITH DEFAULT; 
   FeederGroupName = VARCHAR(40) NOT NULL WITH DEFAULT;
   WarningMessage = VARCHAR(160) NOT NULL WITH DEFAULT;
   Conditional = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   ConditionalMsg = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardID = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeeder  = INTEGER NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   LimitTestKV = INTEGER NOT NULL WITH DEFAULT;
   MTAIsoSwitch = INTEGER NOT NULL WITH DEFAULT;   
) =
BEGIN
/*
** Get Feeder info assuming Job is on FMS card.
*/
   NetworkFeeder = 0;
   TypeOfCard = 0;
   Feeder = 0;
   REPEATED
   SELECT  :Feeder = CTO.Object,
           :FeederName = C.FeederName,
           :CardID = C.Card,
           :NetworkFeeder = C.NetworkFeeder,
           :TypeOfCard = C.TypeOfCard
   FROM    FMS_Card C,
           TFMS_CardToObject CTO,
           SOA_JobControl JC
   WHERE   JC.Job = :JIP.Job AND
           JC.Card = C.Card AND
           C.Card = CTO.Card ;

   IF Feeder = 0 THEN
      MESSAGE 'Feeder HiPotIssue Program called from a non-FMS Job... ' +
              'Unable to continue.';
      RETURN (PU_CANCEL);
   ENDIF;

   IF NetworkFeeder = NetworkFeeder$33KV AND TypeOfCard = TypeOfCard$Portion THEN
      // Hi Pot test applied to the main feeder only
      SELECT  :Feeder = C.Feeder,
              :FeederName = C.FeederName
      FROM    FMS_PortionLink L,
              FMS_Card C
      WHERE   L.PortionCard = :CardID AND
              L.Card = C.Card;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
/*
** Set up titles
*/
   title_feederkv   = 'Feeder Kv';
   title_testtypekv = 'TestType Kv'; 
   title_duration   = 'Duration';
   title_maxma      = 'Max mA';
/*
** Determine High Pot Type
*/
   IF HiPotType = 1 THEN
      field(Title).TextLabel = 'DC High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 2 THEN 
      field(Title).TextLabel = 'Modified High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 3 THEN 
      field(Title).TextLabel = 'AC High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSEIF HiPotType = 4 THEN 
      field(Title).TextLabel = 'AC Modified High Pot Test Criteria for Feeder ' + 
                               FeederName;
   ELSE
      MESSAGE 'Feeder HiPotIssue Program called with ' +
              'unknown High Pot Test Type parameter... Unable to continue.';
      RETURN (PU_CANCEL);
   ENDIF;
/*
** Get FeederKv value for this feeder
*/
   feederkv = 0;
   SELECT :feederkv = R.Normal
   FROM   Udb_Rating R, 
          Udb_Grouping G
   WHERE  R.Object = G.Grouping AND
          G.Member = :Feeder AND
          G.Relationship = :Type$Rated_as;

   WHILE feederkv = 0  OR  feederkv IS NULL DO 

      feederKv = CALLFRAME ProvideFeederkV(Feeder = FeederName);
      
      IF feederkv = 0 OR feederkv IS NULL THEN
         Message 'Please enter a Feeder kV other than 0.';
      ENDIF;

   ENDWHILE;
/***********************
***********************
***Remainder is commented out because we are zeroing out test values forcing
***manual entry
***********************/
TestTypeKv = 0;
Duration = 0; 
MaxMA = 0;          
MessageArea = 'You are now required to manually enter test values for all High Pot Tests.';
/* 
** Get Hi Pot limit for this feeder
*
   HiPotLimit = 0;
   SELECT :HiPotLimit = MIN(R.Normal) 
   FROM   Udb_Rating R, 
          Udb_Grouping G1, 
          Udb_Grouping G2
   WHERE  R.Object = G1.Grouping 
          AND G1.Relationship = :Type$Rated_as
          AND G1.Member = G2.Member
          AND G2.Relationship = :Interaction$MemberOf
          AND G2.Grouping = :Feeder;
/*
**  If high pot limit exists and is less than the feederkv, use it instead.
*
   IF HiPotLimit IS NOT NULL AND HiPotLimit <> 0 AND HiPotLimit < feederkv THEN
  
      Message 'This Feeder has voltage limiting Equipment.  The voltage level ' +
              'used to determine the test criteria is ' + varchar(HiPotLimit);
      feederkv = HiPotLimit;

   ENDIF;
/*
** Determine if FeederKv exists in limits table
*
   SELECT  :TestTypeKv = TestTypeKv,
           :Duration   = Duration, 
           :MaxMa      = MaxMa
   FROM    FMS_HiPotTest
   WHERE   Type = :HiPotType AND
           FeederKv = :feederkv AND
           TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederkV = :feederkv
                        );

   IF iirowcount = 0 THEN
/* 
**  Case where FeederKv does not exist in limits table 
*
        MessageArea = 'No test criteria for this Feeder kV was found. ' + 
                      'Criteria for next highest Feeder kV chosen.';
        MaxMA = -999;
        SELECT  :TestTypeKv = TestTypeKv,
                :Duration   = Duration, 
                :MaxMa      = MaxMa
        FROM    FMS_HiPotTest
        WHERE   Type = :HiPotType AND
           FeederKv = (
                            SELECT MIN(FeederKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType 
                            AND   FeederKv > :feederkv
                      ) AND 
           TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederKv = (
                                        SELECT MIN(FeederKv) FROM FMS_HiPotTest
                                        WHERE Type = :HiPotType 
                                        AND   FeederKv > :feederkv
                                        )
                        );
/* 
**  Case where There is no next highest feederkv, take the max 
*
        IF MaxMA = -999 THEN

            SELECT  :TestTypeKv = TestTypeKv,
                    :Duration   = Duration, 
                    :MaxMa      = MaxMa
            FROM    FMS_HiPotTest
            WHERE   Type = :HiPotType AND
               FeederKv = (
                            SELECT MAX(FeederKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType 
                      ) AND 
               TestTypeKv = (         
                            SELECT MAX(TestTypeKv) FROM FMS_HiPotTest
                            WHERE Type = :HiPotType AND
                            FeederKv = (
                                        SELECT MAX(FeederKv) FROM FMS_HiPotTest
                                        WHERE Type = :HiPotType 
                                        )
                        );
        ENDIF;

   ENDIF;
/*
** Look for conditional high pot test criteria and prepare message.
*/
   Conditional = FALSE;
   FeederGroupName = '';
   SELECT  :FeederGroupName = HPM.FeederGroupName,
           :MaxkVLevel = HPM.MaxkVLevel,
           :MaxDuration = HPM.MaxDuration,
           :WarningMessage = HPM.WarningMessage
   FROM    FMS_HighPotMaxCriteria HPM,
           FMS_HighPotMaxFeeder HPF
   WHERE   HPF.Feeder = :Feeder AND
           HPF.FeederGroupName = HPM.FeederGroupName;

   IF FeederGroupName <> '' THEN  /* look if status is set or pending */
  
      i = 0;
      SELECT :i = Object
      FROM   FMS_ObjectStatus 
      WHERE  Object = :Feeder AND
             StatusCount > 0 AND
             Status = :Status$NoHPMax;

      IF i = 0 THEN
         SELECT :i = Object
         FROM   FMS_PendingStatus 
         WHERE  Object = :Feeder AND
                StatusCount > 0 AND
                PendingStatus = :Status$NoHPMax AND
                IssuedOperator = :FO.Object;

         IF i = 0 THEN
            Conditional = TRUE;
            ConditionalMsg = 'Conditional High Pot per Feeder Group ' +
               FeederGroupName + '.' + HC_NEWLINE + 'Criteria should not exceed test kV = ' +
               VARCHAR(MaxkVLevel); 
            IF MaxDuration = 0 THEN
               ConditionalMsg = ConditionalMsg + '.';
            ELSE
               ConditionalMsg = ConditionalMsg +
                                ' or duration = ' + VARCHAR(MaxDuration) + '.';
            ENDIF;
            FIELD(ConditionalText).TextValue = ConditionalMsg; 
            FIELD(ConditionalText).Curbias = FB_VISIBLE;
         ENDIF;
      ENDIF;
   ENDIF;
   /*
   **  Hipots should be limited if there are LA equipment on feeder and hipot is being done on the 
   **  same side of MTA Isolation Switch.  
   */
   LimitTestKV = FALSE;
   MTAIsoSwitch = 0;   
   SELECT :MTAIsoSwitch = G.Member
   FROM    Udb_Grouping G,
           Udb_ExtendedType ET
   WHERE   G.Grouping = :Feeder AND
           G.Relationship = :Interaction$MTAIsolationFor AND
           G.MemberType = ET.Type AND
           ET.SuperType = :Type$Switch;
   IF MTAIsoSwitch <> 0 THEN
      IF MTAOpen = TRUE THEN  /* Global variable */
         /*
         **  See if equip is downstream of MTA ISO. If it is then
         **  limit kv.
         */
         i = 0;
         SELECT :i = COUNT(*)
         FROM   Udb_Grouping G,
                Udb_ExtendedType ET
         WHERE  G.Grouping = :MTAIsoSwitch AND
                G.Relationship = :Interaction$MTADownstreamOf AND
                G.Member = :JIP.Equip;
         IF i <> 0 THEN
            /*
            **  MTA Iso is open and equip is downstream, limit kv.
            */
            LimitTestKV = TRUE;
         ENDIF;
      ELSE
         /*
         **  MTA iso switch exists and it is closed.  Limit KV.
         */
         LimitTestKV = TRUE;
      ENDIF;
   ENDIF;
END;


ON Click OK_Btn =
BEGIN
   IF LimitTestKV = TRUE AND TestTypeKv > 10 THEN
      Message 'High Pot Limited to 10Kv due to lightning arrester on feeder.  Please update TestType Kv.';
      TestTypeKV = 0;
      Curframe.InputFocusField = FIELD(TestTypeKV);
      RESUME;
   ENDIF;  

/*
** If this is a conditional high pot, check entered criteria vs max values
** and produce warning if necessary.
*/
   IF Conditional = TRUE THEN
      IF TestTypekV > MaxkVLevel OR (Duration > MaxDuration AND MaxDuration > 0) THEN

         ConditionalMsg = 'Do not High Pot above ' + VARCHAR(MaxkVLevel) + 
                        'kV ';
         IF MaxDuration > 0 THEN
            ConditionalMsg = ConditionalMsg + 'or ' +
                        VARCHAR(MaxDuration) + ' mins ';
         ENDIF;
         ConditionalMsg = ConditionalMsg + 'without ' + WarningMessage;
         rc = CALLPROC WarningOverride (
                Card = JIP.Card,
                SwitchingItem = JIP.SwitchingItem,
                Job = JIP.Job,
                WarningText = ConditionalMsg);

         IF rc = PU_CANCEL THEN
            Message 'You must manually abort the issued high pot move.';
            RETURN(PU_CANCEL);
         ENDIF;
      ENDIF;
   ENDIF;
/* 
** Post Operating Error Confirmation step
*/
   IF CurFrame.ConfirmPopup (MessageText = 'Please confirm you are issuing the high pot test ' +
                     ' with the following values: '  + HC_NEWLINE  + HC_NEWLINE +
                     '  FeederKV = ' + VARCHAR(FeederKv) + HC_NEWLINE +
                     '  TestTypeKV = ' + VARCHAR(TestTypeKv) + HC_NEWLINE +
                     '  Duration = ' + VARCHAR(Duration) + HC_NEWLINE +
                     '  MaxMA = ' + VARCHAR(MaxMa) + HC_NEWLINE + HC_NEWLINE +
                     'Click Cancel if you need to change any of these values.') = PU_CANCEL THEN
      RESUME;
   ENDIF;  
/*
**  To avoid inserting duplicates, perform a delete first.
*/
   rc = CALLPROC FMS_HiPotTestCriteriaDel( Job = JIP.Job, 
                                           Type = HiPotType);

   IF rc < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to save test criteria due a delete error.';
       RETURN (PU_Cancel);
   ENDIF;
/* 
**  Save criteria in table to compare when job is completed
*/
   rc = CALLPROC FMS_HiPotTestCriteriaIns( 
                              Job        = JIP.Job,
                              Type       = HiPotType,
                              FeederKv   = FeederKv,
                              TestTypeKv = TestTypeKv,
                              Duration   = Duration,
                              MaxMa      = MaxMa
                          );
   IF rc < 0 THEN
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to save test criteria.';
       RETURN (PU_Cancel);
   ENDIF;
   
	RETURN (PU_OK);
END;

ON CLICK Menu.File.ShowList =
BEGIN
    CallFrame SelectHipotCriteria(
                       FeederKv   = FeederKv,
                       HiPotType  = HiPotType,
                       TestTypeKv = Byref(TestTypeKv), 
                       Duration = Byref(Duration), 
                       MaxMA    = Byref(MaxMA));
END;

ON Click CancelButton =
BEGIN
	RETURN (PU_Cancel);
END;


ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

