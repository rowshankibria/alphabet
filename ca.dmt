	Name:            MessageHistory

/****************************************************************************

          Copyright � 1991, 1992 by ESCA Corporation
          All Rights Reserved.  Unpublished rights reserved under the
          copyright laws of the United States.


****************************************************************************/
/*
**          Application:  CAC
**          Frame:        MessageHistory
**
**  Date                Version Description
**  --------------------------------------------------
**  11/04/05    pkw     Created
*/
INITIALIZE
 (  
    Card       = INTEGER NOT NULL WITH DEFAULT;
    LoadObject = INTEGER NOT NULL WITH DEFAULT;

    i = Integer NOT NULL WITH DEFAULT;  /* Temporary counter */
)=
BEGIN
/*
**  Load Messages
*/
    tf_msg.Clear();
    i = 1;        
    REPEATED
    SELECT 
    DISTINCT
           :tf_msg[i].SubstationName = M.SubstationName,
           :tf_msg[i].FromApp        = M.FromApp,
           :tf_msg[i].ToApp          = M.ToApp,
           :tf_msg[i].FromOpName     = M.Fromopname,
           :tf_msg[i].SendDate       = M.Senddate,
           :tf_msg[i].Msg            = M.Msg,
           :tf_msg[i].OrderNumber    = M.Ordernumber,
           :tf_msg[i].Priority       = M.Priority,
           :tf_msg[i].AckByOpName    = M.AckByOpName,
           :tf_msg[i].AckDate        = M.AckDate,
           :tf_msg[i].DelByOpName    = M.AckByOpName,
           :tf_msg[i].DelDate        = M.AckDate
    FROM    MSG_Message M
    WHERE   M.Card = :Card
    UNION
    SELECT 
           M.SubstationName,
           M.FromApp,
           M.ToApp,
           M.Fromopname,
           M.Senddate,
           M.Msg,
           M.Ordernumber,
           M.Priority,
           M.AckByOpName,
           M.AckDate,
           M.DelByOpName,
           M.DelDate
    FROM   MSG_ArchiveMessage M
    WHERE  M.Card = :Card
    ORDER BY SendDate
    BEGIN
       IF UPPERCASE(tf_msg[i].ToApp) = 'FMS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'SLC' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TFMS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'DO' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TLS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'DSO' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TOMS' THEN

          FIELD(tf_msg[i].FromApp).BGColor = CC_LIGHT_GREEN;
          FIELD(tf_msg[i].ToApp).BGColor   = CC_LIGHT_GREEN;
       ENDIF;
       
       IF tf_msg[i].Priority = 0 THEN
          tf_msg[i].Priority = NULL;
       ENDIF;
       
       IF tf_msg[i].OrderNumber = LoadObject THEN
          FIELD(tf_msg[i].OrderNumber).BGColor = CC_YELLOW;
       ENDIF;
      
       i = i + 1;
    END;
/*
**  For backward compatibility, if we get no rows from previous select
**  we will use the LoadObject for the Card field.  This will be the 
**  case for all orders before Nov 2005.  At some point this code can
**  be removed.
*/
  IF tf_msg.LastRow() = 0 THEN
    i = 1;        
    REPEATED
    SELECT 
    DISTINCT
           :tf_msg[i].SubstationName = M.SubstationName,
           :tf_msg[i].FromApp        = M.FromApp,
           :tf_msg[i].ToApp          = M.ToApp,
           :tf_msg[i].FromOpName     = M.Fromopname,
           :tf_msg[i].SendDate       = M.Senddate,
           :tf_msg[i].Msg            = M.Msg,
           :tf_msg[i].OrderNumber    = M.Ordernumber,
           :tf_msg[i].Priority       = M.Priority,
           :tf_msg[i].AckByOpName    = M.AckByOpName,
           :tf_msg[i].AckDate        = M.AckDate,
           :tf_msg[i].DelByOpName    = M.AckByOpName,
           :tf_msg[i].DelDate        = M.AckDate
    FROM    MSG_Message M
    WHERE   M.Card = :LoadObject
    UNION
    SELECT 
           M.SubstationName,
           M.FromApp,
           M.ToApp,
           M.Fromopname,
           M.Senddate,
           M.Msg,
           M.Ordernumber,
           M.Priority,
           M.AckByOpName,
           M.AckDate,
           M.DelByOpName,
           M.DelDate
    FROM   MSG_ArchiveMessage M
    WHERE  M.Card = :LoadObject
    ORDER BY SendDate
    BEGIN
       IF UPPERCASE(tf_msg[i].ToApp) = 'FMS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'SLC' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TFMS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'DO' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TLS' OR
          UPPERCASE(tf_msg[i].ToApp) = 'TOMS' THEN

          FIELD(tf_msg[i].FromApp).BGColor = CC_LIGHT_GREEN;
          FIELD(tf_msg[i].ToApp).BGColor   = CC_LIGHT_GREEN;
       ENDIF;
       
       IF tf_msg[i].Priority = 0 THEN
          tf_msg[i].Priority = NULL;
       ENDIF;
       
       IF tf_msg[i].OrderNumber = LoadObject THEN
          FIELD(tf_msg[i].OrderNumber).BGColor = CC_YELLOW;
       ENDIF;
      
       i = i + 1;
    END;
  ENDIF;
END;

ON ChildEntry tf_msg[*].SubstationName,
ON ChildEntry tf_msg[*].FromApp,
ON ChildEntry tf_msg[*].ToApp,
ON ChildEntry tf_msg[*].FromOpName,
ON ChildEntry tf_msg[*].SendDate,
ON ChildEntry tf_msg[*].Msg,
ON ChildEntry tf_msg[*].OrderNumber,
ON ChildEntry tf_msg[*].Priority,
ON ChildEntry tf_msg[*].DelbyOpName,
ON ChildEntry tf_msg[*].DelDate =
BEGIN
    i = Field(tf_msg).CurRow;

    msg.SubstationName = tf_msg[i].SubstationName;
    msg.FromApp = tf_msg[i].FromApp;
    msg.ToApp = tf_msg[i].ToApp;
    msg.FromOpName = tf_msg[i].FromOpName;
    msg.SendDate = tf_msg[i].SendDate;
    msg.Msg = tf_msg[i].Msg;
    msg.OrderNumber = tf_msg[i].OrderNumber;
    msg.Priority = tf_msg[i].Priority;
    msg.DelbyOpName = tf_msg[i].DelbyOpName;
    msg.DelDate = tf_msg[i].DelDate;
    msg.AckbyOpName = tf_msg[i].AckbyOpName;
    msg.AckDate = tf_msg[i].AckDate;
END;
 
