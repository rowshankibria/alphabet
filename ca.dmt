	Name:            XA21_DisplayControl

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          XA21_DisplayControl
**
**  Modifications:
**  10/22/14  em    Created
**                  If the frame is called with the Moves parameter, we are completing the Issue Move process.  If moves array is
**                  blank, then we have called the frame from the SOA_Main screen and must select the outstanding XA21 moves for this desk.
**  11/14/14  em    Starting work on Mike's requested mods, starting with pulling out the substation list for selection.
**  11/28/14  em    Not switching back to substation list when we started with more than one and only one is left.
**  12/01/14  em    Correction when displaying Reorder button
**  12/03/14  em    Temporarily disable display call unless connected to test database.
**  12/04/14  em    Fully re-enabled display call-up
**  03/08/15  em    List Substations in order issued
**  04/13/15  em    Show Restore Move text when issuing RS side.
**  10/10/17  em    Fixed Row out of range trace error on Line 253
**  10/04/19  em    Saved Reordered move sequence and re-use when it exists for the card.
**  09/21/22  em    SQUEEZE EquipName on database insert to remove leading or trailing blank
**  10/17/22  em    Check CurrentRowID is not 0 on Complete Manual
*/
INITIALIZE
(
   Card	= INTEGER NOT NULL WITH DEFAULT;  /*Optional Parameter*/
#  include StandardDeclarations

   CurrentRowID = INTEGER NOT NULL WITH DEFAULT;
   FirstPass = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   JobToReload  = INTEGER NOT NULL WITH DEFAULT;
   SOCCSXDisplayCallUp = INTEGER NOT NULL WITH DEFAULT; 
   StationRating = FLOAT NOT  NULL WITH DEFAULT;
   AllMoves = ARRAY OF JobInProgress;
   MovesReordered = INTEGER NOT NULL WITH DEFAULT;
   
) = 
DECLARE
   CallDisplay  = PROCEDURE RETURNING INTEGER;
BEGIN 
/*
** Disabled Temporarily
*
IF Lowercase(DDB_Global.Session.Cur.Database) like '%_test' THEN
ELSE
RETURN;
ENDIF;
/*
**  End Comment here means Fully Enabled
*/
   SELECT :SoccsxDisplayCallup = SOCCSXDisplayCallUp
   FROM   FMS_SystemParameters;

   IF SoccsxDisplayCallup = FALSE THEN
      MESSAGE 'XA21 Display Call-up is Disabled for the System.  Administrator must Enable in DBM System Parameters.';
      RETURN;
   ENDIF;

   FIELD(Manual_btn).CurBias = FB_DIMMED;
   FIELD(Moves).IsHighlighted = FALSE;
   FirstPass = TRUE;
   CurrentRowID = 0;
   MovesReordered = FALSE;

   LastRow = Moves.LastRow();
   IF LastRow = 0 THEN 
/*
** Select outstanding XA21 operator moves for this desk.
** Exclude non-substation breaker Open/Close moves.
*/
      IF Card = 0 THEN
         MESSAGE 'No Card parameter to limit move selection.';
         RETURN;
      ENDIF;

      i = 1;
      SELECT        :Moves[i].GroundOn = J.TOIssued,
                    :Moves[i].Job = J.Job,
                    :Moves[i].Card = JC.Card,
                    :Moves[i].Substation = J.Substation,
                    :Moves[i].SubstationName = O.Name,
                    :Moves[i].Equip = J.Equip,
                    :Moves[i].EquipName = J.EquipName,
                    :Moves[i].JobClass = J.JobClass,
                    :Moves[i].TOMove = J.TOMove,
                    :Moves[i].TOOperator = J.TOOperator,
                    :Moves[i].TOIssued = J.TOIssued,
                    :Moves[i].TOComplete = J.TOComplete,
                    :Moves[i].GroundOn = J.GroundOn,
                    :Moves[i].RSMove = J.RSMove,
                    :Moves[i].RSOperator = J.RSOperator,
                    :Moves[i].RSIssued = J.RSIssued,
                    :Moves[i].RSComplete = J.RSComplete,
                    :Moves[i].Response = J.Response,
                    :Moves[i].ControlCard = J.ControlCard,
                    :Moves[i].ActivityIdentifier = J.ActivityIdentifier,
                    :Moves[i].TORS = 0
      FROM  SOA_JobControl JC,
            SOA_Job J,
            Udb_Object O,
            FMS_JobAction JA,
            Udb_Grouping G1,
            Udb_Grouping G2
      WHERE JC.Card = :Card AND 
            JC.Job = J.Job AND
            J.Substation <> 0 AND
            J.Substation = O.Object AND
            J.Substation = G1.Member AND
            G1.Relationship = :Interaction$MemberOf AND
            G1.GroupingType = :Type$Division AND
            G1.Grouping = G2.Member AND
            G2.Relationship = :Interaction$MemberOf AND
            G2.Grouping = :UserDesk AND
            J.TOIssued IS NOT NULL AND
            J.TOComplete IS NULL AND
            J.TOOperator = :Operator$XA21 AND
            J.JobClass = JA.JobClass AND
            JA.TORS = 0 AND
            JA.Status IN (:Prompt$SetCurrentlyOpen, :Prompt$ClearCurrentlyOpen)

      UNION
      SELECT        J.RSIssued,
                    J.Job,
                    JC.Card,
                    J.Substation,
                    O.Name,
                    J.Equip,
                    J.EquipName,
                    J.JobClass,
                    J.TOMove,
                    J.TOOperator,
                    J.TOIssued,
                    J.TOComplete,
                    J.GroundOn,
                    J.RSMove,
                    J.RSOperator,
                    J.RSIssued,
                    J.RSComplete,
                    J.Response,
                    J.ControlCard,
                    J.ActivityIdentifier,
                    1
      FROM  SOA_JobControl JC,
            SOA_Job J,
            Udb_Object O,
            FMS_JobAction JA,
            Udb_Grouping G1,
            Udb_Grouping G2
      WHERE JC.Card = :Card AND 
            JC.Job = J.Job AND
            J.Substation <> 0 AND
            J.Substation = O.Object AND
            J.Substation = G1.Member AND
            G1.Relationship = :Interaction$MemberOf AND
            G1.GroupingType = :Type$Division AND
            G1.Grouping = G2.Member AND
            G2.Relationship = :Interaction$MemberOf AND
            G2.Grouping = :UserDesk AND
            J.RSIssued IS NOT NULL AND
            J.RSComplete IS NULL AND
            J.RSOperator = :Operator$XA21 AND
            J.JobClass = JA.JobClass AND
            JA.TORS = 1 AND
            JA.Status IN (:Prompt$SetCurrentlyOpen, :Prompt$ClearCurrentlyOpen)
      ORDER BY 1
      BEGIN
         IF Moves[i].TORS = 1 THEN
            Moves[i].TOMove = Moves[i].RSMove;  /*Show restore move on RS issue */
         ENDIF;
         i = i + 1;
      END;

      IF i = 1 THEN
         MESSAGE 'There are no outstanding XA21 moves on this card.';
         RETURN;
      ENDIF;
   ELSE
/*
** Filter issued moves to exclude non-substation breaker Open/Close moves.
*/
      i = LastRow;
      WHILE i > 0 DO
         IF Moves[i].Substation = 0 THEN
            Moves.RemoveRow (RowNumber = i);
         ELSE         
            k = 0;
            SELECT :k = JobClass
            FROM   FMS_JobAction
            WHERE  JobClass = :Moves[i].JobClass AND
                   TORS = :Moves[i].TORS AND
                   Status IN (:Prompt$SetCurrentlyOpen, :Prompt$ClearCurrentlyOpen);
            IF k = 0 THEN
               Moves.RemoveRow (RowNumber = i);
            ENDIF;
         ENDIF;
         i = i - 1;
      ENDWHILE;
/* 
** If only one move then Call Display immediately
*/
      IF Moves.LastRow() = 1 THEN
         CALLPROC CallDisplay (RowID = 1);
         RETURN;
      ENDIF;
   ENDIF;
   /*
   ** Check for previously saved sequenced moves
   */
   AllMoves.Clear();
   i = 1;
   SELECT :AllMoves[i].Job = Job,
          :AllMoves[i].TORS = TORS,
          :AllMoves[i].Seq = Seq
   FROM   SOA_XA21Sequence
   WHERE  Card = :Moves[1].Card
   ORDER BY Seq
   BEGIN
      i = i + 1;
   END;
   
   IF AllMoves.LastRow = 0 THEN   /* No Sequence */
      AllMoves = Moves.Duplicate();
   ELSEIF Moves.LastRow > AllMoves.LastRow THEN   /* Sequence is out of whack, delete it move one */
      CALLPROC SOA_XA21SeqDel (Card = Moves[1].Card);  /* Delete saved sequence */
      CALLPROC DDB_COMMIT; 
      AllMoves = Moves.Duplicate();
   ELSE                           /* Match XA21 Moves to Saved Sequence */
      i = AllMoves.LastRow;
      WHILE i >= 1 DO
         AllMoves[i].Card = 0;  /* Use this to remove if not found in XA21 move list */
         k = Moves.LastRow;
         WHILE k >= 1 DO
            IF AllMoves[i].Job = Moves[k].Job AND AllMoves[i].TORS = Moves[k].TORS THEN
               AllMoves[i] = Moves[k].Duplicate();
               Moves.RemoveRow (rownumber = k);
            ENDIF;
            k = k - 1;
         ENDWHILE;
         IF AllMoves[i].Card = 0 THEN   /* Move lists don't match */
            CALLPROC SOA_XA21SeqDel (Card = Moves[1].Card);  /* Delete saved sequence */
            CALLPROC DDB_COMMIT; 
            AllMoves.RemoveRow (rownumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
      /* If we still have Moves left add them to end of list, then rebalance lists. */
      IF Moves.LastRow > 0 THEN
         i = AllMoves.LastRow + 1;
         FOR k = 1 TO Moves.LastRow DO
            AllMoves[i] = Moves[k].Duplicate();
            i = i + 1;
         ENDFOR;
      ENDIF;
   ENDIF;
   Moves.Clear();
   Moves = AllMoves.Duplicate();
   CurFrame.SendUserEvent (EventName = 'LoadSubstationList');
END;

ON CLICK Substation_btn,
ON USEREVENT 'LoadSubstationList' =
BEGIN
/*
** Build list of substations
*/
   SubList.SubstationList.Clear();
   FOR i = 1 TO AllMoves.LastRow() DO
      k = 1;
      WHILE k <= SubList.SubstationList.LastRow() DO
         IF AllMoves[i].Substation = SubList.SubstationList[k].Object THEN
            ENDLOOP;
         ENDIF;
         k = k + 1;
      ENDWHILE;
      IF k > SubList.SubstationList.LastRow() THEN
         SubList.SubstationList.InsertRow (RowNumber = k);
         SubList.SubstationList[k].Object = AllMoves[i].Substation;
         SubList.SubstationList[k].Name = AllMoves[i].SubstationName;
      ENDIF;
   ENDFOR;

   FIELD(Substation_btn).CurBias = FB_INVISIBLE; 
   FIELD(Reorder_btn).CurBias = FB_DIMMED;
   FIELD(SubList).CurBias = FB_INVISIBLE;
   IF SubList.SubstationList.LastRow() > 1 OR FirstPass = FALSE THEN
      FIELD(SubList).CurBias = FB_LANDABLE;
      FIELD(Substation_btn).CurBias = FB_LANDABLE; 
      CurrentRowID = 0;
   ELSEIF SubList.SubstationList.LastRow = 1 THEN
    StationRating = 0;
    SELECT :StationRating = R.Normal
    FROM   Udb_Rating R,
           Udb_Grouping G
    WHERE  G.Member = :SubList.SubstationList[1].Object AND
           G.Relationship = :Interaction$RatedAs AND
           G.Grouping = R.Object;

    IF StationRating < 35 THEN
       FIELD(Reorder_btn).CurBias = FB_DIMMED;
    ELSE
       FIELD(Reorder_btn).CurBias = FB_LANDABLE;
    ENDIF;
   ENDIF;  
   FirstPass = FALSE;
END;

ON CHILDENTRY SubList.SubstationList =
DECLARE
   m = INTEGER NOT NULL WITH DEFAULT;
BEGIN
    k = FIELD(SubList.SubstationList).CurRow;
    IF k = 0 THEN
       MESSAGE 'Please select a Substation.';
       RESUME;
    ENDIF;
    
    StationRating = 0;
    SELECT :StationRating = R.Normal
    FROM   Udb_Rating R,
           Udb_Grouping G
    WHERE  G.Member = :SubList.SubstationList[k].Object AND
           G.Relationship = :Interaction$RatedAs AND
           G.Grouping = R.Object;

    IF StationRating < 35 THEN
       FIELD(Reorder_btn).CurBias = FB_DIMMED;
    ELSE
       FIELD(Reorder_btn).CurBias = FB_LANDABLE;
    ENDIF;

    Moves.Clear();
    m = 0;
    FOR i = 1 TO AllMoves.LastRow() DO
       IF AllMoves[i].Substation = SubList.SubstationList[k].Object THEN   
          m = m + 1;
          Moves[m] = AllMoves[i].Duplicate();
       ENDIF; 
    ENDFOR;
    FIELD(Sublist).CurBias = FB_INVISIBLE; 
END;


ON CLICK Reorder_btn = 
DECLARE 
   Idx = ARRAY OF INTEGEROBJECT; /*Index array for reordering*/
   TempJobs = ARRAY OF Job;
   AM = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   TempJobs.Clear();
   TempJobs = Moves.Duplicate();
   RetCode = CALLFRAME  ReOrderMoves (Jobs = TempJobs, 
                                      Idx = byref(Idx),
                                      Title = 'Adjust XA21 Display Call-Up Sequence');
   IF RetCode = PU_OK THEN
      MovesReordered = TRUE;
      Moves.Clear();
      FOR i = 1 TO Idx.LastRow() DO
         Moves[i] = TempJobs[Idx[i].Value].Duplicate();
      ENDFOR;
      /*Reset position in AllMoves array in case user clicks through substation list*/
      i = 1;
      FOR AM = 1 TO AllMoves.LastRow DO
         IF i <= Moves.LastRow THEN
            IF AllMoves[AM].Substation = Moves[i].Substation THEN
               AllMoves[AM] = Moves[i].Duplicate();
               i = i + 1;
            ENDIF;
         ENDIF;
      ENDFOR;
   ENDIF;
END;

ON CLICK Start_btn =
BEGIN
   IF FIELD(Start_btn).BgColor = CC_GREEN THEN
      Message 'No action.';
      RESUME;
   ENDIF;

   FIELD(Moves).IsHighlighted = TRUE;
   FIELD(Start_btn).BgColor = CC_GREEN;
   FIELD(Manual_btn).CurBias = FB_LANDABLE;
   FIELD(Reorder_btn).CurBias = FB_DIMMED;
   FIELD(Substation_btn).CurBias = FB_INVISIBLE; 
   CurrentRowID = CurrentRowID + 1;
   FIELD(Moves).CurRow = CurrentRowID;
   CurFrame.StatusText = 'Waiting for XA21 Response #' + VARCHAR(CurrentRowID);
   RetCode = CALLPROC CallDisplay (RowID = CurrentRowID);
   IF RetCode = PU_CANCEL THEN
      MESSAGE 'XA21 Display Call-up stopped due to an error.';
      CurFrame.StatusText = 'XA21 Processing Stopped';
      CurrentRowID = CurrentRowID - 1;
      FIELD(Manual_btn).CurBias = FB_DIMMED;
      FIELD(Start_btn).BgColor = CC_PALE_YELLOW;
   ENDIF;  
END;


ON DBEVENT 'SOA_ReloadJob' =
BEGIN
/*
** If this event is targeted to this user, then reload the specific move
*/
   ControlText = CurFrame.DBEvent.DBEventText;

   ControlUser = left(ControlText,(locate(ControlText,';')-1));   

   IF ControlUser  = UserName THEN
   
      ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));
      JobToReload = int4(left(ControlText,(locate(ControlText,';')-1)));
      
      LastRow = AllMoves.LastRow();    
      i = LastRow;
      WHILE i > 0 DO 
         IF AllMoves[i].Job = JobToReload THEN
            AllMoves.RemoveRow (RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;

      i = 1;
      LastRow = Moves.LastRow();    
      WHILE i <= LastRow DO

         IF Moves[i].Job = JobToReload THEN
            CurFrame.PurgeDBEvent (DBEventName = 'SOA_ReloadJob');
            REPEATED
            SELECT  :Moves[i].Grounds = J.Grounds,
                    :Moves[i].TOOperator = J.TOOperator,
                    :Moves[i].TOIssued = J.TOIssued,
                    :Moves[i].TOComplete = J.TOComplete,
                    :Moves[i].GroundOn = J.GroundOn,
                    :Moves[i].RSOperator = J.RSOperator,
                    :Moves[i].RSIssued = J.RSIssued,
                    :Moves[i].RSComplete = J.RSComplete,
                    :Moves[i].Response = J.Response,
                    :Moves[i].ControlCard = J.ControlCard,
                    :Moves[i].ActivityIdentifier = J.ActivityIdentifier
            FROM    SOA_Job J
            WHERE   Job = :JobToReload;
/*
** Initiate Display call for next move
*/
            IF i < LastRow THEN
                  CurrentRowID = i + 1;
                  FIELD(Moves).CurRow = CurrentRowID;
                  CurFrame.StatusText = 'Waiting for XA21 Response for Move in position ' + VARCHAR(CurrentRowID);
                  RetCode = CALLPROC CallDisplay (RowID = CurrentRowID);
                  IF RetCode = PU_CANCEL THEN
                     MESSAGE 'XA21 Display Call-up stopped due to an error.';
                     CurFrame.StatusText = 'XA21 Processing Stopped';
                     CurrentRowID = CurrentRowID - 1;
                     FIELD(Manual_btn).CurBias = FB_DIMMED;
                     FIELD(Start_btn).BgColor = CC_PALE_YELLOW;
                  ENDIF;  
            ELSE
/*
** All moves complete, go back to Substation list if moves still outstanding.
*/   
               CurFrame.StatusText = ' ';
               IF AllMoves.LastRow() = 0 THEN
                  CALLPROC SOA_XA21SeqDel (Card = Moves[1].Card);  /* Delete saved sequence */
                  CALLPROC DDB_COMMIT; 
                  RETURN;
               ELSE
                  FIELD(Moves).CurRow = 0;
                  FIELD(Start_btn).BgColor = CC_PALE_YELLOW;
                  CurFrame.SendUserEvent (EventName = 'LoadSubstationList');
               ENDIF;
            ENDIF;  
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;    
      IF i > LastRow THEN
         MESSAGE 'ERROR: Received a completion message from XA21 but was not able to identify move.';
         FIELD(Start_btn).BgColor = CC_PALE_YELLOW;
      ENDIF; 
   ENDIF;
END;


ON CLICK Manual_btn =
BEGIN
   IF CurrentRowID = 0 THEN
      MESSAGE 'Error: CurrentRowID counter = 0. Please Report Bug with screen capture and add comment indicating what happened with XA21 Display.';
      RESUME;
   ENDIF; 
   FIELD(Start_btn).BgColor = CC_PALE_YELLOW;
   FIELD(Manual_btn).CurBias = FB_DIMMED;
   CALLFRAME ReturnOperatorMoves (XA21Job = Moves[CurrentRowID].Job); 
   CurFrame.ParentFrame.SendUserEvent (EventName = 'LoadJobs');
   CALLPROC FMS_SoccsxMessageDel
                     ( Job = Moves[CurrentRowID].Job);
   CALLPROC DDB_COMMIT;
   RETURN; 
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

ON CLICK Exit_Btn, 
ON WINDOWCLOSE =
BEGIN
   IF FIELD(Start_btn).BgColor = CC_GREEN THEN
      MESSAGE 'XA21 Processing is Active.';
      RESUME;
   ENDIF;
   /* Save move sequence if exiting with unprocessed moves */
   IF MovesReordered = TRUE THEN
      RetCode = CALLPROC SOA_XA21SeqDel (Card = Moves[1].Card);  /* Delete any prior saved sequence */
      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
      ENDIF;
      
      FOR i = 1 TO AllMoves.LastRow DO
         RetCode = CALLPROC SOA_XA21SeqIns (
                        Card = AllMoves[i].Card,
                        Job = AllMoves[i].Job,
                        TORS = AllMOves[i].TORS,
                        Seq = i);
         IF RetCode <> 0 THEN
            CALLPROC DBB_ROLLBACK;
            MESSAGE 'ERROR: Unable to save XA21 Reordered Sequence';
            ENDLOOP;
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT; 
   ENDIF;
   RETURN;
END;



PROCEDURE CallDisplay (
   RowID = INTEGER NOT NULL
) =
DECLARE
   FMSOperatorName = VARCHAR(5) NOT NULL WITH DEFAULT;
   Substn = VARCHAR(40) NOT NULL WITH DEFAULT;
   status = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/* 
** Get SCADA version of substation name
*/ 
   Substn = '';
   SELECT :Substn = O.Name 
   FROM   Udb_Object O 
   WHERE  O.Object = :Moves[RowID].Substation; 

   IF Substn = '' THEN
          CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to send message to XA21.',
                             TraceMessage =
                   'XA21_DisplayControl: Move is not associated with a valid substation. ');
   ENDIF;

   DDB_Global.TopFrame.Trace
          (   Text =  varchar(date('now')) + ':XA21 Display Call=' + Substn + ':' + Moves[RowID].EquipName + '.'  
          );

      /* Send a message to XA21: */ 
   status = CALLPROC SendRapportInstruction 
            ( Substation = Substn, 
              Device     = Moves[RowID].EquipName ); 

   IF (status <> 0) THEN 
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to send message to XA21.',
                             TraceMessage =
                   'XA21_DisplayControl: Unable to send message to XA21. ');
         RETURN PU_CANCEL; 
   ENDIF; 
/*
** Delete any other Soccsx Messages this user has before inserting a new one.
*/
   status = CALLPROC FMS_SoccsxMessageDel
                     ( UserName = UserName );
   IF (status <> 0) THEN
          CALLPROC DDB_ROLLBACK;
          CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to delete old XA21 messages.',
                             TraceMessage =
                   'XA21_DisplayControl: Unable to delete old XA21 messages.' 
                             );
         RETURN PU_CANCEL; 
   ELSE
/* 
** Store data about the message, as a reference when XA21
** sends a return message      
*/ 
      FMSOperatorName = Left(UserName, 2) + '2' + Right(UserName,2);
      status = CALLPROC FMS_SoccsxMessageIns 
                  ( Card       = Moves[RowID].Card, 
                    Job        = Moves[RowID].Job,
                    TORS       = Moves[RowID].TORS,
                    Application = CurrentApplication,
                    UserName   = UserName,
                    DisplayUserName   = FMSOperatorName, 
                    Substation = Substn, 
                    Device     = SQUEEZE(Moves[RowID].EquipName), 
                    MessageTime = 'now' 
                   ); 
      IF (status <> 0) THEN 
             CALLPROC DDB_ROLLBACK;
             CALLPROC TraceError (UserMessage =
                   'ERROR: Unable to insert new XA21 messages.',
                             TraceMessage =
                   'XA21_DisplayControl: Unable to insert new XA21 messages.' 
                             );
         RETURN PU_CANCEL; 
      ENDIF;
   ENDIF;
   CALLPROC DDB_COMMIT;
   RETURN PU_OK;
END;

