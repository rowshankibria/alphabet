	Name:            cac_raiserelayupdate

/*
** Copyright c 1995 ESCA Corporation. All Rights Reserved.
**
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
**
*/

PROCEDURE CAC_RaiseRelayUpdate
(
     RelayOp  = INTEGER NOT NULL,           /* PARAMETER */
     Action   = VARCHAR(8) WITH NULL,       /* PARAMETER */
     CardList = ARRAY OF CAC_Card,          /* PARAMETER */
                                           
     i = INTEGER NOT NULL,
     RetCode = INTEGER,
     ControlText = VARCHAR(256) NOT NULL
)=
BEGIN
    RetCode = 0;

    IF CardList.LastRow () > 0 THEN
       ControlText = IFNULL(Action,'') + ';' + varchar(RelayOp) + ';';
       i = 1;
       WHILE i <= CardList.LastRow() DO
          ControlText = ControlText + varchar(CardList[i].Card) + ':';
          ControlText = ControlText + varchar(CardList[i].CardType) + ';';
          i = i + 1;
       ENDWHILE;
       CALLPROC DDB_RaiseDBEvent (DBEventName = 'CAC_RelayOp_Update',
                                  DBEventText = ControlText);
       CALLPROC DDB_COMMIT; 
    ENDIF;

    RETURN RetCode;   
END;

