	Name:            TFMSCutin

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    CAC
**  Frame:          TFMSCutIn
**
**  Modifications:
**  02/02/96    jfl     Created
**  04/17/96    jfl     Prompt for confirmation of Cutin Move
**  03/26/99    em      Incorporated into SOA
**  06/04/99    em      Make sure move is in EnDeEn Substation
**  10/12/99    em      Don't set CutIn if not CutOut
**  06/06/00    em      Ignore EnDeEn, set CutIn time for first device closed
**  06/30/01    em      Don't prompt for CutIn if the device is Isolated.
**                      Re-Use IsolationTrace developed for EnDeEnCheck.
**  10/29/02    em      Job to JIP
**  01/16/04    em      Card selection bug, need controlcard from SOA_Job
**  02/18/04    em      If automatic execution, use current time.
**  07/22/05    ysp     Download TFMS cutin to Rapid Restore
**  01/11/05    pkw     Clear all operating steps.
**  05/03/06    em      PromptCheckCutIn morphed into this frame so that it could be 
**                      called by the Prompt for mulitple TFMS cards.
**  04/16/07    ysp     ITC210: Insert IR interface event in DB event queue
**  05/09/07    ysp     Add Notification to CIG of CutIn
**  07/27/07    ysp     Not to download CutIn if it is TFMS Black Start card type
**  12/04/07    pkw     Add LogAppend to SimpleTFMS call.    
**  02/20/18    em      Add call to Set Actual Inservice time with TFMS CutIn.     
*/

INITIALIZE
(
    JIP = JobInProgress;          /* Passed Job */
    Card = INTEGER NOT NULL;      /* Passed TFMS card */
    CardDetails = CardTFMS;        /* Passed Card Class */

    EventText = VARCHAR(80) NOT NULL WITH DEFAULT;
    retcode = INTEGER NOT NULL; /* return variable */
    i = INTEGER NOT NULL;       
    SingleSWP = OutageReport DEFAULT NULL;
) =
DECLARE
    ClearOperatingSteps = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Card_ID = CardDetails.Card;
   FeederNames = CardDetails.FeederNames;
END;


On Click yes_btn =
BEGIN            
/*
**  Update cutin time now that the operator confirmed it
*/
    CardDetails.CutIn = 'now';
    RetCode = CardDetails.UpdateCard(); 
    
    IF RetCode = PU_OK THEN
       RetCode = CALLPROC ClearOperatingSteps;
    ENDIF;

    IF CardDetails.CardClassName <> 'TEST' AND
       CardDetails.CardClass <> Type$TFMSBLCK THEN
       EventText = VARCHAR(Card) + ';0;CUTIN;';
       CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSCloseCard',
                     EventText = EventText);
       /*
       ** Notify CIG of CutIn
       */
       CardDetails.NotifyCutIn();
    ENDIF;
      /*
      ** this breaker may be on a card where a scheduled outage is being managed.  
      **/
      SingleSWP = OutageReport.Create();
      SingleSWP.SetActualInServiceDate(JIP = JIP);

    RETURN (RetCode);
END;

On Click no_btn =
BEGIN            
    RETURN (PU_OK);
END;

PROCEDURE ClearOperatingSteps (
) =
DECLARE
   PFSCleared       = INTEGER NOT NULL WITH DEFAULT;
   TFMSStep         = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
ENDDECLARE
BEGIN
   /*
   **  Start Operating Steps if card was cutout ok.
   */
   IF TFMSStep IS NULL THEN
      TFMSStep = TFMSOpStep_ASE.Create();
   ENDIF; 
   SELECT DISTINCT
        :TFMSStep.SO.Object   = C.Card,
        :TFMSStep.SO.BaseType = C.CardClass,
        :TFMSStep.SO.Name     = C.CardClassName,
        :TFMSStep.SO.Type     = J.ControlCard,
        :TFMSStep.SO.TypeName = AC.CardName
   FROM  SOA_Job J,
         SOA_ActiveCard AC,
         SOA_Card C
   WHERE J.Job = :JIP.Job AND
         C.Card = :Card AND
         C.Card = AC.Card; 
   CALLPROC DDB_ROLLBACK;

   TFMSStep.Job       = JIP.Job;
   TFMSStep.LogAppend = 'Cutin';
   TFMSStep.EndTime   = IFNULL(CardDetails.CutIn,'');
   /*
   **  Find all outstanding operatingstep and clear them all out.
   */
   PFSCleared = FALSE;
   SELECT :TFMSStep.OpStep    = D.OperatingStep
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :TFMSStep.SO.Object AND
           D.EndTime = ''
   BEGIN 
      /*
      **  This will clear detail AND any summary table if needed.
      */
      TFMSStep.ClearOpStep(NoSummaryIns = TRUE);

      IF TFMSStep.ReturnCode <> 0 THEN
         CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
           TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
           'Prompt:PromptCheckCutIn; ' +
           'Error clearing a TFMS Operating Step. ' +
           'Card=' + VARCHAR(Card) +
           ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
           );
         TFMSStep = NULL;
         RETURN (PU_Cancel);
      ENDIF; 
      IF TFMSStep.OpStep = OpSt$PFS THEN
         PFSCleared = TRUE;
      ENDIF;
   END;
   /*
   **  
   */
   IF PFSCleared = FALSE THEN
      TFMSStep.BackTrackPFS();
   ENDIF;
   /*
   **  Now set the R/S step.
   */
   TFMSStep.StartTime = IFNULL(CardDetails.CutIn,'');
   TFMSSTep.OpStep    = OpSt$RS;

   TFMSStep.SetOpStep();

   IF TFMSStep.ReturnCode <> 0 THEN
      CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
        TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
        'Prompt:PromptCheckCutIn; ' +
        'Error setting a R/S TFMS Operating Step. ' +
        'Card=' + VARCHAR(Card) +
        ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
        );
      TFMSStep = NULL;
      RETURN (PU_Cancel);
   ENDIF; 
   
   TFMSStep = NULL;
   
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            TFMSCutOut

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          TFMSCutOut
**
**  Modifications:
**  02/02/96 jfl        Created
**  04/17/96 jfl        Enable selection of move as Cutout Move
**  06/20/96 jfl        Add column tocomplete
**  03/25/99 em         Incorporated into SOA
**  06/04/99 em         Present cutout option if this is the last device
**                      in the EnDeEn Station.
**  06/06/00 em         Don't care about EnDeEn station.  If it is the last
**                      CutOut on the card, use it.
**  11/15/00 em         Don't load CutOut moves that are not complete.
**  02/26/01 em         Ignore Spare Bank Breakers.
**  05/17/01 em         Ignore Circuit Switcher (Type$CktSwer)
**  06/30/01 em         Don't prompt for CutOut if the device is Isolated.
**                      Re-Use IsolationTrace developed for EnDeEnCheck.
**                      Finally a TRACE is reused!!!
**  10/04/02 em         Add CktInterrupt to excluded CutOut types.
**  10/29/02 em         Job to JIP
**  01/19/04 em         Card selection bug, need controlcard from SOA_Job
**  02/18/04 em         If automatic execution, use timestamp from current
**                      move.
**  06/21/05 ysp        Download tfms card cutout to RR
**  01/11/05 pkw        Set C/O or INVS operating step.
**  05/03/06 em         Morphed from PromptCheckCutOut so that it could be
**                      called if necessary for multiple TFMS cards.
**  04/23/07 ysp        ITC210: Insert IR interface event in DB event queue
**  05/09/07 ysp        Add Notification to CIG of CutOut
**  07/27/07 ysp        Not to download CutOut if it is TFMS Black Start card type
**  08/15/07 em         Appearance Changes
**  12/04/07 pkw        Add LogAppend to SimpleTFMS call.
**  10/30/14 em         Load moves in order completed.  Default to last one.
**  10/30/17 em         Call OutReport method to update OR outage time if there
**                      is an associated permit on this card
**  03/02/18 em         Add JIP parameter to UpdateOutageDate method call.
*/

INITIALIZE
(
    JIP = JobInProgress;          /* Passed Job */
    Card = INTEGER NOT NULL;      /* Passed TFMS card */
    CardDetails = CardTFMS;        /* Passed Card Class */
 
    SelectRow = INTEGER NOT NULL; /* Clicked RowNumber */
    retcode = INTEGER NOT NULL;   /* return variable */
    i = INTEGER NOT NULL;       
    k = INTEGER NOT NULL;       
    ClosedBreakers = INTEGER NOT NULL;
    BreakerType = INTEGER NOT NULL; /*Compare Bkr Type to Spare Bank Types*/
    SingleSWP = OutageReport DEFAULT NULL;
) =
DECLARE
    StartOperatingSteps = PROCEDURE RETURNING INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   Card_ID = Card;
   FeederNames = CardDetails.FeederNames;

            J.Clear();
            i = 1;
            REPEATED
            SELECT DISTINCT  
                :J[i].Job = J.Job, 
                :J[i].SubstationName = O.Name,  
                :J[i].EquipClassName = J.EquipClassName,  
                :J[i].EquipClass = J.EquipClass,
                :J[i].EquipName = J.EquipName,
                :J[i].TOMove = J.TOMove,
                :J[i].TOComplete = J.TOComplete
            FROM SOA_Job J, 
                 SOA_JobControl JC,
                 FMS_JobAction JA,
                 Udb_ExtendedType ET,
                 Udb_Object O 
            WHERE
                JC.Card = :Card AND
                JC.Job = J.Job AND
                J.Status = '' AND
               (J.TOComplete IS NOT NULL AND J.TOComplete <> '') AND
                J.Substation = O.Object AND
                J.EquipClass = ET.Type AND
                J.EquipClass <> :Type$CktSwer AND  /*Ignore Ckt Swer*/
                J.EquipClass <> :Type$CktInterrupt AND  /*Ignore Ckt Interrupt*/
                ET.SuperType = :Type$LoadBreaking AND                
                J.JobClass = JA.JobClass AND
                JA.Status = :Prompt$CheckCutOut
            ORDER BY TOComplete 
            BEGIN
                i = i + 1;
            END;
/*
**          Default the selection to current move
**          and wait for operator entries
*/
            IF i > 1 THEN
               Selected = J[i-1].Duplicate();
            ELSE
               Selected = JIP.Duplicate();
            ENDIF;
   CurFrame.BringToFront();
END;

On Childentry J =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Deselect eventual selected row
*/
    IF (SelectRow <> 0 ) THEN
        FIELD(J[SelectRow].SubstationName).IsReverse = FALSE;
        FIELD(J[SelectRow].EquipClassName).IsReverse = FALSE;
        FIELD(J[SelectRow].EquipName).IsReverse = FALSE;
        FIELD(J[SelectRow].ToMove).IsReverse = FALSE;
        FIELD(J[SelectRow].ToComplete).IsReverse = FALSE;
    ENDIF;
/*
**  Update row selected
*/
    SelectRow = FIELD(J).CurRow;
    FIELD(J[SelectRow].SubstationName).IsReverse = TRUE;
    FIELD(J[SelectRow].EquipClassName).IsReverse = TRUE;
    FIELD(J[SelectRow].EquipName).IsReverse = TRUE;
    FIELD(J[SelectRow].ToMove).IsReverse = TRUE;
    FIELD(J[SelectRow].ToComplete).IsReverse = TRUE;
    Selected.SubstationName = J[SelectRow].SubstationName;
    Selected.EquipClassName = J[SelectRow].EquipClassName;
    Selected.EquipName = J[SelectRow].EquipName;
    Selected.ToMove = J[SelectRow].ToMove;
    Selected.ToComplete = J[SelectRow].ToComplete;
END;

On Click Ok_btn = 
BEGIN
/*
**  Update the Card cutout time
*/
    CardDetails.CutOut = Selected.TOComplete;
    RetCode = CardDetails.UpdateCard(); 

    IF RetCode = PU_OK THEN
       RetCode = CALLPROC StartOperatingSteps;
    ENDIF;

    IF CardDetails.CardClassName <> 'TEST' AND
       CardDetails.CardClass <> Type$TFMSBLCK THEN
       CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_TOMSCutout',
                     EventText = VARCHAR(Card));
       /*
       ** Notify CIG of CutOut
       */
       CardDetails.NotifyCutOut(); 
    ENDIF;

    SingleSWP = OutageReport.Create();
    SingleSWP.UpdateActualOutageDate(JIP = JIP,
									 Card=Card,
                                     CutOut=Selected.TOComplete);

    RETURN (RetCode);
END;

ON WindowClose =
BEGIN
    RESUME;
END;

PROCEDURE StartOperatingSteps (
) =
DECLARE
   TFMSStep = TFMSOpStep_ASE DEFAULT NULL; /* Enables use of class methods */
ENDDECLARE
BEGIN
   /*
   **  Start Operating Steps if card was cutout ok.
   */
   IF TFMSStep IS NULL THEN
      TFMSStep = TFMSOpStep_ASE.Create();
   ENDIF; 
   SELECT DISTINCT
        :TFMSStep.SO.Object   = C.Card,
        :TFMSStep.SO.BaseType = C.CardClass,
        :TFMSStep.SO.Name     = C.CardClassName,
        :TFMSStep.SO.Type     = J.ControlCard,
        :TFMSStep.SO.TypeName = AC.CardName
   FROM  SOA_Job J,
         SOA_ActiveCard AC,
         SOA_Card C
   WHERE J.Job = :JIP.Job AND
         C.Card = :Card AND
         C.Card = AC.Card; 
   IF TFMSStep.SO.BaseType = Type$TFMSAuto THEN
      TFMSStep.OpStep = OpSt$INVS;
   ELSE
      TFMSStep.OpStep = OpSt$CO; 
   ENDIF;
   /* 
   **  Set start time of operating step.
   */
   TFMSStep.StartTime = IFNULL(CardDetails.CutOut,'');
   TFMSStep.Job       = JIP.Job;
   TFMSStep.LogAppend = 'Cutout';

   TFMSStep.SetOpStep();
   
   IF TFMSStep.ReturnCode <> 0 THEN
      CALLPROC TraceError (UserMessage = TFMSStep.ErrorMessage,
        TraceMessage = TFMSStep.ErrorMessage + HC_NEWLINE +
        'Prompt:PromptCheckCutout; ' +
        'Error setting a TFMS Operating Step. ' +
        'Card=' + VARCHAR(Card) +
        ';Status=' + VARCHAR(TFMSSTep.OpStep) + '.'
        );
      TFMSStep = NULL;
      RETURN (PU_Cancel);
   ENDIF; 
   TFMSStep = NULL;
   RETURN (PU_OK);
END;

Application Component Report
============================

	Name:            TFMSOpStep_ASE


���p(Component Method Scripts
���p(--------------------------
/*
**
**      Copyright c 2001 ALSTOM ESCA, Inc.  All rights reserved.
**
**      ALSTOM ESCA, Inc. proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA, Inc.
**
**  Application:    CAC
**  Class:          OperatingStep_ASE
**
**  Date:       Version Description
** ----------------------------------
**  12/05/05    pkw     Created.
**  03/08/06    pkw     Fix typo in CombineOpSteps
**  03/29/06    pkw     Update select error when backtracking PFS and
**                      table reference error.
**  12/04/07    pkw     Append TO/RS Issue/Compl to end of log message on insertlog.
**  02/22/08    pkw     Use RSComplete when checking to see if PFS should be started.
**                      Had a problem with undoing work permits because toissued is 
**                      updated after jobactions when incompleting a move.
*/ 
METHOD CombineOpSteps (
   Card1 = INTEGER NOT NULL WITH DEFAULT;
   Card2 = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i          = INTEGER      NOT NULL;
   SimpleStep = TFMSOpStep_ASE DEFAULT NULL;
   SortTime   = DATE NOT NULL WITH DEFAULT;
   StepCount  = INTEGER      NOT NULL;
   RetCode    = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to figure out the current operating
** step for a given time.  This is used when recreating operating
** step summary information after the fact.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Create a list of timestamps from both cards that has all start 
**  and end times for each operating step.  We will then process 
**  through this list to build the detail and summary information
**  for the new card.  
*/
   SELECT :CurObject.OpStep      = O.OperatingStep,
          :SortTime              = O.StartTime,
          :CurObject.StartTime   = O.StartTime,
          :CurObject.EndTime     = O.EndTime,
          :StepCount             = O.StepCount,
          :CurObject.SO.Type     = O.ControlCard, /* Not set in SwitchToRestore */
          :CurObject.ReturnCount = 1      /* increment */
   FROM    TFMS_OpStepDetail O
   WHERE   O.Card = :Card1
   UNION
   SELECT  O2.OperatingStep,
           O2.EndTime,
           O2.StartTime,
           O2.EndTime,
           O2.StepCount,
           O2.ControlCard,
           2                               /* decrement */
   FROM    TFMS_OpStepDetail O2
   WHERE   O2.Card = :Card1
   UNION
   SELECT  O3.OperatingStep,
           O3.StartTime,
           O3.StartTime,
           O3.EndTime,
           O3.StepCount,
           O3.ControlCard,
           1                               /* increment */
   FROM    TFMS_OpStepDetail O3
   WHERE   O3.Card = :Card2
   UNION
   SELECT  O4.OperatingStep,
           O4.EndTime,
           O4.StartTime,
           O4.EndTime,
           O4.StepCount,
           O4.ControlCard,
           2                               /* decrement */
   FROM    TFMS_OpStepDetail O4
   WHERE   O4.Card = :Card2
   ORDER BY SortTime, ReturnCount
   BEGIN
      /*
      **  Go through list and insert/update OpStepdetail information. 
      */
      IF CurObject.ReturnCount = 1 THEN
         IF StepCount = 0 THEN
            /*
            ** Endtime has been set and we just need to call it once.
            */
            CurObject.SetOpStep(NoSummaryIns = TRUE);
         ELSE
            /*
            ** Need to call method multiple times to get correct step count.
            */
            FOR i = 1 TO StepCount DO
               CurObject.SetOpStep(NoSummaryIns = TRUE);
            ENDFOR;
         ENDIF;
      ELSEIF CurObject.ReturnCount = 2 THEN
         CurObject.DecrementOpStep(NoSummaryIns = TRUE);
      ENDIF;
   END;
   /*
   **  Select each timestamps that an operating step was inserted
   **  or cleared.  At each timestamp we will evaluate 
   **  what the current step should be and build the summary table.
   */
   SELECT :CurObject.StartTime = O.StartTime
   FROM    TFMS_OperatingStep O
   WHERE   O.Card = :CurObject.SO.Object
   UNION
   SELECT  O2.EndTime
   FROM    TFMS_OperatingStep O2
   WHERE   O2.Card = :CurObject.SO.Object 
   ORDER BY StartTime
   BEGIN
      CurObject.GetCurrentStep();
      IF CurObject.OpStep <> 0 THEN
         CurObject.SetOpStep(NoDetailIns = TRUE);
      ENDIF;
   END;

   RETURN;
END;

METHOD GetCurrentStep (
)=
DECLARE
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to figure out the current operating
** step for a given time.  This is used when recreating operating
** step summary information after the fact.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Find the current operating step using the CurObject.StartTime.
*/
   CurObject.OpStep = 0;
   SELECT :CurObject.OpStep = D.OperatingStep
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :CurObject.SO.Object AND
           D.StartTime <= :CurObject.StartTime AND
           D.EndTime > :CurObject.StartTime AND
           D.Priority = (SELECT D2.Priority
                         FROM   TFMS_OpStepDetail D2
                         WHERE  D2.Card = :CurObject.SO.Object AND
                                D2.StartTime <= :CurObject.StartTime AND
                                D2.EndTime > :CurObject.StartTime);
   RETURN;
END;

METHOD CheckPDNXStep (
)=
DECLARE
   CheckCount   = INTEGER NOT NULL WITH DEFAULT;
   PrevEndTime       = DATE NOT NULL WITH DEFAULT;
   PrevOperatingStep = INTEGER NOT NULL;
   PrevStartTime     = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to determine if CO or INVS has 
** already been set on this card.  If yes we will change 
** the Current operating step to be OpSt$PDNX.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  See if step was set already.
*/
   CheckCount = 0;
   SELECT :CheckCount = COUNT(*) 
   FROM    TFMS_OperatingStep O
   WHERE   O.Card = :CurObject.SO.Object AND
           O.OperatingStep = :CurObject.OpStep;

   IF CheckCount > 0 THEN
      /* Change step to Pending Next Step */
      CurObject.OpStep = OpSt$PDNX;
      SELECT :CurObject.OpStepName = T.Name
      FROM    Udb_Type T
      WHERE   T.Type = :OpSt$PDNX;
   ENDIF;
/*
**  See if previous step was OpSt$PDNX.  If so we will delete
**  previous step and set start time back to previous start time.
**  The OperatingStepIns Method will then insert a new PDNX step
**  with a starttime of the previous PDNX step.
*/
   SELECT :PrevOperatingStep = OS.OperatingStep,
          :PrevStartTime = OS.StartTime
   FROM   TFMS_OperatingStep OS
   WHERE  OS.Card = :CurObject.SO.Object AND
          OS.EndTime <> '' AND
          OS.EndTime = (SELECT ifnull(Max(EndTime),'')
                        FROM   TFMS_OperatingStep OOS
                        WHERE  OOS.Card = :CurObject.SO.Object);
   IF PrevOperatingStep = OpSt$PDNX THEN
      CurObject.OpStepDel(OpStep = PrevOperatingStep,
                          StartTime = PrevStartTime);
      /* Now update starttime to fill in the gap. */
      CurObject.StartTime = PrevStartTime;
   ENDIF;
   RETURN;
END;

METHOD InsertLog (
   pOld = VARCHAR(80) NOT NULL WITH DEFAULT;
   LogStep = INTEGER NOT NULL WITH DEFAULT; 
)=
DECLARE
   NewVarChar   = VARCHAR(80)  NOT NULL;
   LogJob       = INTEGER;
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
   SELECT :NewVarChar = Name
   FROM    Udb_Type 
   WHERE   Type = :LogStep;

   IF CurObject.Job = 0 THEN
      /* If LogJob is 0, it won't show up in transaction log */
      LogJob = NULL;
   ELSE
      LogJob = CurObject.Job;
   ENDIF;
   
   IF CurObject.LogAppend <> '' THEN
      pOld = pOld + ' on ' + CurObject.LogAppend;
   ENDIF;
 
   /* insert a transaction log */
   CALLPROC SOA_LogIns (Card = CurObject.SO.Object,
                        Job = LogJob,
                        Item = 'OpStep',
                        Old = pOld,
                        New = NewVarChar,
                        Time = Date('now'),
                        UserName = UserName); 
   CALLPROC DDB_COMMIT;

   RETURN;
END;


METHOD SetPFSStep (
)=
DECLARE
   i      = INTEGER      NOT NULL;
   SimpleStep = TFMSOpStep_ASE DEFAULT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to determine if there are any other
** non-issued OTW moves on the card.  If there are none, we should
** insert a PFS step into the detail table.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Find if the Card has a non-issued OTW move.
*/
   i = 0;
   SELECT  :i = COUNT(*)
   FROM    SOA_JobControl JC,
           SOA_Job J,
           SOA_ActiveCard AC,
           FMS_JobAction JA
   WHERE   AC.Card = :CurObject.SO.Object AND   /*Card*/
           AC.Card = JC.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.RSComplete IS NULL AND
           J.JobClass = JA.JobClass AND
           JC.StepPair = JA.StepPair AND
           JC.MoveEquipClass = JA.EquipClass AND
           AC.TypeOfCard = JA.TypeOfCard AND
           JA.FeederEquip = 9 AND   /*TFMS OperatingStep*/
           JA.TORS = :Job$TakeOutInt AND
           JA.IssueCompl = 0 AND    /*Issue*/
           JA.Status IN (:OpSt$OTWR,:OpSt$OTWS);
   CALLPROC DDB_ROLLBACK;
   
   IF i = 0 THEN
      IF SimpleStep IS NULL THEN
         SimpleStep = TFMSOpStep_ASE.Create();
      ENDIF;    

      SimpleStep = CurObject.Duplicate();
      SimpleStep.OpStep = OpSt$PFS;
      SimpleStep.StartTime = CurObject.EndTime;
      
      SimpleStep.SetOpStep(NoSummaryIns = TRUE);

      SimpleStep = NULL;
   ENDIF;

   RETURN;
END;


METHOD BackTrackPFS (
)=
DECLARE
   CurStartTime = DATE         NOT NULL;
   CurOpStep    = INTEGER      NOT NULL;
   OTWEndTime   = DATE         NOT NULL;
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to rebuild all operating Steps since 
** the last endtime of the OTW Operating Step.  If there was no
** OTW operating step we do not have to do anything.  CurObject.Endtime
** should be equal to the cutin time of the card.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Find the greatest OTW endtime
*/
   OTWEndTime = '';
   SELECT :OTWEndTime = ifnull(max(O.EndTime),'')
   FROM    TFMS_OperatingStep O
   WHERE   O.Card = :CurObject.SO.Object AND
           O.OperatingStep IN (:OpSt$OTWR,:OpSt$OTWS);
   CALLPROC DDB_ROLLBACK;
   
   IF OTWEndTime = '' THEN
      CurObject.OpStepName = 'PFS';
      CurObject.InsertLog(pOld = 'No OTW step found for card;PFS insert skipped',
                          LogStep = OpSt$PFS);
      /*
      **  There was no OTW step.  We are done.
      */
      RETURN;
   ENDIF;
   /*
   **  Insert PFS Operating Step with starttime = OTWEndTime and
   **  endtime = Cutin (which is the current endtime of CurObject.
   */
   CurObject.OpStep = OpSt$PFS;
   CurObject.StartTime = OTWEndTime;
   CurObject.SetOpStep(NoSummaryIns = TRUE);

   IF CurObject.ReturnCode <> 0 THEN
      RETURN;
   ENDIF; 
   /*
   **  Now set the endtime.
   */
   CurObject.ClearOpStep(NoSummaryIns = TRUE);
   
   IF CurObject.ReturnCode <> 0 THEN
      RETURN;
   ENDIF; 
   /*
   **  Now we need to clear out all Operating Step that happened after OTW.
   */
   SELECT :CurOpStep = O.OperatingStep,
          :CurStartTime = O.StartTime
   FROM    TFMS_OperatingStep O
   WHERE   O.StartTime >= :OTWEndTime AND
           O.Card = :CurObject.SO.Object
   BEGIN
      CurObject.OpStepDel(OpStep = CurOpStep,
                          StartTime = CurStartTime);
   END;
   /*
   **  Select each timestamps that an operating step was inserted
   **  since the OTW step.  At each timestamp we will evaluate 
   **  what the current step should be and rebuild the summary table.
   */
   SELECT :CurObject.StartTime = O.StartTime
   FROM    TFMS_OpStepDetail O
   WHERE   O.Card = :CurObject.SO.Object AND
           O.StartTime >= :OTWEndTime
   UNION
   SELECT  O2.EndTime
   FROM    TFMS_OpStepDetail O2
   WHERE   O2.Card = :CurObject.SO.Object AND
           O2.EndTime > :OTWEndTime
   ORDER BY StartTime
   BEGIN
      CurObject.GetCurrentStep();
      IF CurObject.OpStep <> 0 THEN
         CurObject.SetOpStep(NoDetailIns = TRUE);
      ENDIF;
   END;

   RETURN;
END;


METHOD SetOpStep (
   NoSummaryIns = INTEGER NOT NULL WITH DEFAULT;
   NoDetailIns = INTEGER NOT NULL WITH DEFAULT;
   PDNXStepDel = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   CardCutOut        = DATE NOT NULL WITH DEFAULT;
   CurStepCount      = INTEGER NOT NULL;
   i                 = INTEGER NOT NULL;
   MaxPriority       = INTEGER NOT NULL;
   PrevDurationMins  = INTEGER NOT NULL;
   PrevEndTime       = DATE NOT NULL WITH DEFAULT;
   PrevOperatingStep = INTEGER NOT NULL;
   PrevStartTime     = DATE NOT NULL WITH DEFAULT;
   RetCode           = INTEGER NOT NULL;
   SaveStep          = INTEGER NOT NULL;
   SkipOTWStuff      = INTEGER NOT NULL;
   SummaryIns        = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to set Operating Steps Status
**
** Values that need to be passed in:
** CurObject.SO.Object    = Card
** CurObject.SO.BaseType  = CardClass (Only needed if setting OTW* step)
** CurObject.SO.Name      = CardClassName
** CurObject.SO.Type      = ControlCard - from soa_job
** CurObject.SO.TypeName  = CardName    - from soa_activecard
** CurObject.OpStep       = OperatingStep
** CurObject.StartTime    = OpStep StartTime (optional: default 'now')
** CurObject.Job          = Job being issued.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  If no StartTime was passed in set = now.
*/
   IF CurObject.StartTime = '' THEN
      SELECT :CurObject.StartTime = date('now');
   ENDIF;
/*
**  Get Current Operatingstep Name
*/
   SELECT :CurObject.OpStepName = T.Name
   FROM    Udb_Type T
   WHERE   T.Type = :CurObject.OpStep;
   CALLPROC DDB_ROLLBACK;
/*
**  Find Current Priority of step being set. 
*/
   CurObject.Priority = 0;
   SELECT :CurObject.Priority = P.Priority
   FROM    TFMS_OpStepPriority P
   WHERE   P.Type = :CurObject.OpStep;
   CALLPROC DDB_ROLLBACK;
/*
**  Find Highest Priority Operating Step that has no 
**  endtime(lower = higher priority). 
*/
   MaxPriority = 0;
   SELECT :MaxPriority = IFNULL(min(D.Priority),0)
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :CurObject.SO.Object AND
           D.EndTime = '';
   CALLPROC DDB_ROLLBACK;
/*
**  Now determine if we update the current operating step or not.
*/   
   IF (MaxPriority > CurObject.Priority OR
       MaxPriority = 0 OR
       PDNXStepDel = TRUE) AND
       NoSummaryIns = FALSE THEN
      SummaryIns = TRUE;
   ELSE
      SummaryIns = FALSE;
   ENDIF;
/*
**  Make updates to the Detail table.
*/
   IF NoDetailIns = FALSE THEN
      CurStepCount = 0;
      SELECT :CurStepCount = D.StepCount
      FROM    TFMS_OpStepDetail D
      WHERE   D.Card = :CurObject.SO.Object AND
              D.OperatingStep = :CurObject.OpStep AND
              D.EndTime = '';
      CALLPROC DDB_ROLLBACK;
   
      IF CurStepCount = 0 THEN
         CurObject.OpStepDetailIns();
      ELSE
         CurStepCount = CurStepCount + 1;
         CurObject.StepCountUpd(StepCount = CurStepCount);
      ENDIF;
   ENDIF;
/*
**  Make updates to the Summary table if necessary.
*/
   IF SummaryIns = TRUE THEN
      /*
      **  See if there are any incompleted Operatingsteps
      */
      PrevOperatingStep = 0;
      SELECT :PrevOperatingStep = OS.OperatingStep,
             :PrevStartTime =  OS.StartTime,
             :PrevEndTime =  OS.EndTime
      FROM   TFMS_OperatingStep OS
      WHERE  OS.Card = :CurObject.SO.Object AND
             OS.EndTime = '';
      /*
      **  If there were no open ended operatingsteps
      **  look for last completed operatingstep
      */      
      IF PrevOperatingStep = 0 THEN
         SELECT :PrevOperatingStep = OS.OperatingStep,
                :PrevStartTime = OS.StartTime,
                :PrevEndTime = OS.EndTime
         FROM   TFMS_OperatingStep OS
         WHERE  OS.Card = :CurObject.SO.Object AND
                OS.EndTime <> '' AND
                OS.EndTime = (SELECT ifnull(Max(EndTime),'')
                              FROM   TFMS_OperatingStep OOS
                              WHERE  OOS.Card = :CurObject.SO.Object);
      ENDIF;
      
      IF PrevOperatingStep <> 0 THEN
         IF PrevOperatingStep = CurObject.OpStep THEN
            /*
            **  Update Endtime to blank if not already
            */
            IF PrevEndTime <> '' THEN
               CurObject.OpStepEndTimeUpd(
                     OpStep = PrevOperatingStep,
                     StartTime = PrevStartTime,
                     EndTime = '',
                     DurationMins = 0);
            ENDIF;
         ELSE
            IF PrevEndTime = '' THEN
               /*
               **  Set endtime of old operating step to starttime
               **  of current operating step.
               */
               PrevDurationMins = INT4(interval('minute',DATE(CurObject.StartTime) - DATE(PrevStartTime)));
               /*
               **  Check to see if we are clearing OpSt$PDNX.  IF less than 
               **  ten minutes we will remove it and call SetOpStep recursively 
               **  with NoDetailIns since the details have been updated already.
               **  If greater than ten minutes we will just update the time like normal.  
               */
               IF PrevOperatingStep = OpSt$PDNX AND
                  PrevDurationMins < 10 THEN
                  CurObject.OpStepDel(OpStep = PrevOperatingStep,
                                      StartTime = PrevStartTime);
                  CurObject.SetOpStep(NoDetailIns = TRUE,
                                      PDNXStepDel = TRUE);
                  RETURN;
               ENDIF;
 
               CurObject.OpStepEndTimeUpd(
                     OpStep = PrevOperatingStep,
                     StartTime = PrevStartTime,
                     EndTime = CurObject.StartTime,
                     DurationMins = PrevDurationMins);
               /*
               **  Insert new step with current starttime.
               */
               CurObject.OperatingStepIns(StartTime = CurObject.StartTime);                
            ELSE
               /*
               **  Insert new step with current starttime equal to previous
               **  OpStep endtime.
               */
               CurObject.OperatingStepIns(StartTime = PrevEndTime);                
            ENDIF;
         ENDIF;
      ELSE  
/*
** There is not any previous step. That is, the just inserted operating step is 
** the first step. We will update the starttime back to the card's cutout time.
*/
         CardCutout = '';
         SELECT :CardCutout = IFNULL(C.Cutout,'')
         FROM    SOA_Card C
         WHERE   C.Card = :CurObject.SO.Object;
         CALLPROC DDB_ROLLBACK;
         
         IF CardCutout <> '' THEN
            CurObject.OperatingStepIns(StartTime = CardCutOut);                
         ENDIF;
      ENDIF;
   ENDIF;
   
   RETURN;
END;

METHOD ClearOpStep (
   NoSummaryIns = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   CurStartTime = DATE         NOT NULL;
   CurStepCount = INTEGER      NOT NULL;
   NewOpStep    = INTEGER      NOT NULL;
   NewOpStepName = VARCHAR(40) NOT NULL;
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to clear Operating Steps Status
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Get the current time.
*/
   IF CurObject.EndTime = '' THEN
      SELECT :CurObject.EndTime = DATE('NOW');
   ENDIF;
/*
** Get the starttime of the operating step in the TFMS_OpStepDetail table.
*/  
   CurStepCount = 0; 
   SELECT :CurStepCount = D.StepCount,
          :CurStartTime = D.StartTime
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :CurObject.SO.Object AND
           D.OperatingStep = :CurObject.OpStep AND
           D.EndTime = '';
   CALLPROC DDB_ROLLBACK;
   
   IF CurStepCount <> 0 THEN
      /*
      **  Set endtime in Detail table of current operating step
      */
      CurObject.OpStepDetailEndUpd(
            OpStep = CurObject.OpStep,
            StartTime = CurStartTime,
            EndTime = CurObject.EndTime,
            DurationMins = INT4(interval('minute',CurObject.EndTime - DATE(CurStartTime))));
      /*
      **  Now see if this was the current operating step.
      */
      CurStartTime = '';
      SELECT :CurStartTime = OS.StartTime
      FROM    TFMS_OperatingStep OS
      WHERE   OS.Card = :CurObject.SO.Object AND
              OS.OperatingStep = :CurObject.OpStep AND
              Endtime = '';
      CALLPROC DDB_ROLLBACK;
      
      IF CurStartTime = '' THEN
         RETURN;
      ELSE
         /*
         **  Set endtime for current step in summary table
         */
         CurObject.OpStepEndTimeUpd(
               OpStep = CurObject.OpStep,
               StartTime = CurStartTime,
               EndTime = CurObject.EndTime,
               DurationMins = INT4(interval('minute',CurObject.EndTime - DATE(CurStartTime))));
         /*
         **  NoSummaryIns is set when called from PromptCheckCutin.  In this case
         **  we don't want to insert next highest priority because we are
         **  clearing all steps.
         */
         IF NoSummaryIns = FALSE THEN
            /*
            **  Now find highest priority in Detail table and set the starttime based on 
            **  operating step with highest priority(lower = higher priority).
            */
            NewOpStep = 0;
            SELECT :NewOpStep = D.OperatingStep,
                   :NewOpStepName = D.OperatingStepName
            FROM    TFMS_OpStepDetail D
            WHERE   D.Card = :CurObject.SO.Object AND
                    D.EndTime = '' AND
                    D.Priority = (SELECT IFNULL(min(DD.Priority),0)
                                  FROM    TFMS_OpStepDetail DD
                                  WHERE   DD.Card = :CurObject.SO.Object AND
                                  DD.EndTime = '');
            CALLPROC DDB_ROLLBACK;
         
            IF NewOpStep <> 0 THEN
               /*
               **  Set this as the new Operating Step in the Summary table.
               */
               CurObject.OpStep = NewOpStep;
               CurObject.OpStepName = NewOpStepName;
               CurObject.OperatingStepIns(StartTime = CurObject.EndTime);
            ENDIF;
         ENDIF;
      ENDIF;
   ENDIF;
   
   RETURN;
END;


METHOD DecrementOpStep (
   NoSummaryIns = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   CurStartTime = DATE         NOT NULL;
   CurStepCount = INTEGER      NOT NULL;
   NewOpStep    = INTEGER      NOT NULL;
   NewOpStepName = VARCHAR(40) NOT NULL;
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to decrement/clear Operating Steps Status
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
**  Get the current time.
*/
   IF CurObject.EndTime = '' THEN
      SELECT :CurObject.EndTime = DATE('NOW');
   ENDIF;
/*
** Find the StepCount in the TFMS_OpStepDetail table.
*/  
   CurStepCount = 0; 
   SELECT :CurStepCount = D.StepCount,
          :CurStartTime = D.StartTime
   FROM    TFMS_OpStepDetail D
   WHERE   D.Card = :CurObject.SO.Object AND
           D.OperatingStep = :CurObject.OpStep AND
           D.EndTime = '';
   CALLPROC DDB_ROLLBACK;
   
   IF CurStepCount > 1 THEN
      CurStepCount = CurStepCount - 1;
      CurObject.StepCountUpd(StepCount = CurStepCount);
   ELSEIF CurStepCount = 1 THEN
      /*
      **  Set endtime in Detail table of current operating step
      */
      CurObject.OpStepDetailEndUpd(
            OpStep = CurObject.OpStep,
            StartTime = CurStartTime,
            EndTime = CurObject.EndTime,
            DurationMins = INT4(interval('minute',CurObject.EndTime - DATE(CurStartTime))));
      /*
      **  See if this was an OTWR/OTWS step. If yes we need to do some checking to see
      **  if we need to insert a PFS step.
      */
      IF NoSummaryIns = FALSE AND
        (CurObject.OpStep = OpSt$OTWR OR
         CurObject.OpStep = OpSt$OTWS) THEN
         CurObject.SetPFSStep();
      ENDIF;
      /*
      **  Now see if this was the current operating step.
      */
      CurStartTime = '';
      SELECT :CurStartTime = OS.StartTime
      FROM    TFMS_OperatingStep OS
      WHERE   OS.Card = :CurObject.SO.Object AND
              OS.OperatingStep = :CurObject.OpStep AND
              Endtime = '';
      CALLPROC DDB_ROLLBACK;
      
      IF CurStartTime = '' THEN
         RETURN;
      ELSE
         /*
         **  Set endtime for current step in summary table
         */
         CurObject.OpStepEndTimeUpd(
               OpStep = CurObject.OpStep,
               StartTime = CurStartTime,
               EndTime = CurObject.EndTime,
               DurationMins = INT4(interval('minute',CurObject.EndTime - DATE(CurStartTime))));
         IF NoSummaryIns = FALSE THEN
            /*
            **  Now find highest priority in Detail table and set the starttime based on 
            **  operating step with highest priority(lower = higher priority).
            */
            NewOpStep = 0;
            SELECT :NewOpStep = D.OperatingStep,
                   :NewOpStepName = D.OperatingStepName
            FROM    TFMS_OpStepDetail D
            WHERE   D.Card = :CurObject.SO.Object AND
                    D.EndTime = '' AND
                    D.Priority = (SELECT IFNULL(min(DD.Priority),0)
                                  FROM    TFMS_OpStepDetail DD
                                  WHERE   DD.Card = :CurObject.SO.Object AND
                                  DD.EndTime = '');
            CALLPROC DDB_ROLLBACK;
         
            IF NewOpStep <> 0 THEN
               /*
               **  Set this as the new Operating Step in the Summary table.
               */
               CurObject.OpStep = NewOpStep;
               CurObject.OpStepName = NewOpStepName;
               CurObject.OperatingStepIns(StartTime = CurObject.EndTime);
            ENDIF;
         ENDIF;
      ENDIF;
   ELSEIF CurStepCount = 0 THEN
      RETURN;
   ENDIF;
   
   RETURN;
END;


Method OpStepDetailIns(   
) = 
DECLARE
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
   CurObject.InsertLog(pOld = 'Insert (1) - Detail',
                       LogStep = CurObject.OpStep);

   RetCode = CALLPROC TFMS_OpStepDetailIns(
            Card = CurObject.SO.Object,
            CardClassName = CurObject.SO.Name,
            CardName = CurObject.SO.TypeName,
            ControlCard = CurObject.SO.Type,
            JobID = CurObject.Job,
            OperatingStep = CurObject.OpStep,
            OperatingStepName = CurObject.OpStepName,
            StepCount = 1,
            StartTime = CurObject.StartTime,
            Priority = CurObject.Priority);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error inserting an Operating Step status ' + 
           'in the TFMS_OpStepDetail table.  ' +
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

Method StepCountUpd(
   StepCount = INTEGER NOT NULL;   
) = 
DECLARE
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
   CurObject.InsertLog(pOld = 'Update step count (' + varchar(StepCount) + ') - Detail',
                       LogStep = CurObject.OpStep);

   RetCode = CALLPROC TFMS_StepCountUpd(
            Card = CurObject.SO.Object,
            OperatingStep = CurObject.OpStep,
            StepCount = StepCount);
   
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error incrementing an Operating Step status ' + 
           'in the TFMS_OpStepDetail table.  ' +
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

Method OpStepDetailEndUpd(
   OpStep       = INTEGER NOT NULL;
   StartTime    = DATE    NOT NULL;
   EndTime      = DATE    NOT NULL;
   DurationMins = INTEGER NOT NULL;   
) = 
DECLARE
   CheckCutOut  = DATE NOT NULL WITH DEFAULT;
   CheckCutIn   = DATE NOT NULL WITH DEFAULT;
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN

   IF DurationMins < 0 THEN
      CurObject.InsertLog(pOld = 'DurationMins is negative',
                          LogStep = OpStep);
      CurObject.OpStepDetailDel(OpStep = OpStep,StartTime = StartTime);
      RETURN;
   ELSEIF OpStep <> OpSt$RS THEN
      /*
      **  All Step should fall within the out of service time.
      **  Give 5 second window on each side of out of service times.
      */
      SELECT :CheckCutOut = IFNULL(DATE(CutOut - '5 seconds'),''),
             :CheckCutIn  = IFNULL(DATE(CutIn + '5 seconds'),'')
      FROM   SOA_Card
      WHERE  Card = :CurObject.SO.Object;
      CALLPROC DDB_ROLLBACK;

      IF CheckCutout = '' THEN
         CurObject.InsertLog(pOld = 'Cutout is blank',
                             LogStep = OpStep);
         CurObject.OpStepDetailDel(OpStep = OpStep,StartTime = StartTime);
         RETURN;
      ELSEIF CheckCutIn = '' THEN
         IF StartTime < CheckCutOut THEN
            CurObject.InsertLog(pOld = 'Start time is less than cutout',
                                LogStep = OpStep);
            CurObject.OpStepDetailDel(OpStep = OpStep,StartTime = StartTime);
            RETURN;
         ENDIF;
      ELSE
         IF StartTime < CheckCutout OR 
             StartTime > CheckCutin OR
             EndTime > CheckCutIn THEN
            CurObject.InsertLog(pOld = 'Start or end time outside out of service time',
                                LogStep = OpStep);
            CurObject.OpStepDetailDel(OpStep = OpStep,StartTime = StartTime);
            RETURN;
         ENDIF;
      ENDIF;
   ENDIF;
   IF DurationMins < 0 THEN
      CurObject.InsertLog(pOld = 'DurationMins is negative',
                          LogStep = OpStep);
      /*
      **  Remove detail info if for some reason we have a negative 
      **  DurationMins.
      */
      CurObject.OpStepDetailDel(OpStep = OpStep,StartTime = StartTime);
      RETURN;
   ENDIF;

   CurObject.InsertLog(pOld = 'Set end time (0) - Detail',
                       LogStep = OpStep);

   RetCode = CALLPROC TFMS_OpStepDetailEndUpd(
         Card = CurObject.SO.Object,
         OperatingStep = OpStep,
         StartTime = StartTime,
         EndTime = EndTime,
         DurationMins = DurationMins);
               
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error updating endtime of ' + 
           'Operating Step in the TFMS_OpStepDetail table. ' + 
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

Method OpStepEndTimeUpd(
   OpStep       = INTEGER NOT NULL;
   StartTime    = DATE    NOT NULL;
   EndTime      = DATE    NOT NULL;
   DurationMins = INTEGER NOT NULL;   
) = 
DECLARE
   RetCode      = INTEGER      NOT NULL;
   CheckCutOut  = DATE NOT NULL WITH DEFAULT;
   CheckCutIn   = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN

   IF EndTime = '' THEN
      CurObject.InsertLog(pOld = 'Clear end time - Summary',
                       LogStep = OpStep);
   ELSE
      CurObject.InsertLog(pOld = 'Set end time - Summary',
                       LogStep = OpStep);
   ENDIF;
   
   IF DurationMins < 0 THEN
      CurObject.InsertLog(pOld = 'DurationMins is negative',
                          LogStep = OpStep);
      CurObject.OpStepDel(OpStep = OpStep,StartTime = StartTime);
      RETURN;
   ELSEIF OpStep <> OpSt$RS THEN
      /*
      **  All Step should fall within the out of service time.
      **  Give 5 second window on each side of out of service times.
      */
      SELECT :CheckCutOut = IFNULL(DATE(CutOut - '5 seconds'),''),
             :CheckCutIn  = IFNULL(DATE(CutIn + '5 seconds'),'')
      FROM   SOA_Card
      WHERE  Card = :CurObject.SO.Object;
      CALLPROC DDB_ROLLBACK;

      IF CheckCutout = '' THEN
         CurObject.InsertLog(pOld = 'Cutout is blank',
                             LogStep = OpStep);
         CurObject.OpStepDel(OpStep = OpStep,StartTime = StartTime);
         RETURN;
      ELSEIF CheckCutIn = '' THEN
         IF StartTime < CheckCutOut THEN
            CurObject.InsertLog(pOld = 'Start time is less than cutout',
                                LogStep = OpStep);
            CurObject.OpStepDel(OpStep = OpStep,StartTime = StartTime);
            RETURN;
         ENDIF;
      ELSE
         IF StartTime < CheckCutout OR 
             StartTime > CheckCutin OR
             EndTime > CheckCutIn THEN
            CurObject.InsertLog(pOld = 'Start or end time outside out of service time',
                                LogStep = OpStep);
            CurObject.OpStepDel(OpStep = OpStep,StartTime = StartTime);
            RETURN;
         ENDIF;
      ENDIF;
   ENDIF;

   RetCode = CALLPROC TFMS_OpStepEndTimeUpd(
         Card = CurObject.SO.Object,
         OperatingStep = OpStep,
         StartTime = StartTime,
         EndTime = EndTime,
         DurationMins = DurationMins);
               
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error updating endtime of ' + 
           'Operating Step in the TFMS_OperatingStep table. ' + 
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

Method OperatingStepIns(
   StartTime    = DATE    NOT NULL;
) = 
DECLARE
   RetCode      = INTEGER      NOT NULL;
ENDDECLARE
BEGIN
   IF CurObject.OpStep = OpSt$CO OR
      CurObject.OpStep = OpSt$INVS THEN
      /*
      **  Check to see if these steps have already been set
      */
      CurObject.CheckPDNXStep();
   ENDIF;

   CurObject.InsertLog(pOld = 'Insert - Summary',
                       LogStep = CurObject.OpStep);
   RetCode = CALLPROC TFMS_OperatingStepIns(
         Card = CurObject.SO.Object,
         CardClassName = CurObject.SO.Name,
         CardName = CurObject.SO.TypeName,
         OperatingStep = CurObject.OpStep,
         OperatingStepName = CurObject.OpStepName,
         StartTime = StartTime);
               
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error inserting ' + 
           'Operating Step ' + CurObject.OpStepName + ' for card: ' +
            varchar(CurObject.SO.Object) + 
           'in the TFMS_OperatingStep table. ' + 
           'Tech Support should be contacted to review your ' +
           'machine trace log.';
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

