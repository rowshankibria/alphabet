	Name:            CheckATSGrouperMoveControl

/*
**
**	Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          CheckATSGrouperMoveControl  
**
**  Modifications:
**  09/27/11  em   Created - look for JobControl equipclass level and
**                 compare to equipment to feeder member type.
**  10/04/11  em   Preferred Step is not required.

*/
PROCEDURE  CheckATSGrouperMoveControl 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    IsControlled = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IsControlled = 0;
   SELECT :IsControlled = AC.Card
   FROM   FMS_JobClassControl JCC,
          SOA_ActiveCard AC,
          Udb_Grouping G,
          SOA_ActiveObject AO
   WHERE  JCC.JobClass = :JIP.JobClass AND
          JCC.TypeOfCard = AC.TypeOfCard AND
          AC.Card = :JIP.Card AND
          G.Member = :JIP.Equip AND
          JCC.EquipClass = G.MemberType AND
          G.Relationship = :Interaction$MemberOf AND
          G.Grouping = AO.Object AND
          AO.Card = :JIP.Card;

   IF IsControlled = 0 THEN
      MESSAGE 'This shared ATS Grouper move may not be issued from this card.' + HC_NEWLINE +
              'You must transfer control of the shared equipment to the other card to issue this move.';
      RETURN (PU_CANCEL);
   ELSE
      RETURN NULL;
   ENDIF;
END; 

Application Component Report
============================

	Name:            CheckATSLoadNotGFrMacro

/*
**
**	Copyright c 2002 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckATSLoadNotGFrMacro  
**
**  Modifications:
**  06/27/02 em	    Created, from CheckATSLoadSideNotGround, to look at load
**                  side from ATS Macro Device. 
**  09/19/02 em     Added Checks to look at load-side feeder statuses: Grounds,
**                  HV status, and Amm Clear In Progress.
**  11/15/02 ysp    Merge: removed C and Jobs as passed-ins.
**  02/13/04 em     Replace messages with TraceError calls
**  04/27/04 em     Corrected ATS Load Side Select
**  10/28/11 em     Implemented Kip's enhancement to add BT status to list
**  11/28/11 em     Added Pending Ground check
**  06/18/12 em     Fixed Pending Status select
**
*/
PROCEDURE  CheckATSLoadNotGFrMacro 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    ATS = ObjectSummaryClass;
    ATSLoad = ObjectSummaryClass;
    LoadSideFeeder = INTEGER NOT NULL WITH DEFAULT;
    LoadSideStatus = INTEGER NOT NULL WITH DEFAULT;
    StatusOrder = INTEGER NOT NULL WITH DEFAULT;
    StatusName = VARCHAR(200);
) =
BEGIN
/*
**  Confirm the move equipment is an ATS-Grouper type device.
*/ 
   ATS.Object = 0;
   SELECT :ATS.Object = O.Object,
          :ATS.TypeName = O.TypeName,
          :ATS.Name = O.Name 
   FROM   Udb_Object O
   WHERE  O.Object = :JIP.Equip AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSGrouper);

   IF ATS.Object = 0 THEN
      REPEATED
      SELECT :ATS.Object = O.Object,
             :ATS.TypeName = O.TypeName,
             :ATS.Name = O.Name 
      FROM   Udb_Object O,
             Udb_Grouping G
      WHERE  G.Member = :JIP.Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = O.Object AND
             O.Type IN (SELECT Type
                        FROM   Udb_ExtendedType
                        WHERE  SuperType = :Type$ATSGrouper);

      IF ATS.Object = 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
               'JobClass Maintenance Setup Error: ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  ' + 
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckATLSLoadNotGrFrMacro:  JobClass Maint problem. ' +
               'Move is being performed incorrectly ' +
               'on a non-ATS Grouper type device.  '
               );
         IF AutomaticExecution = TRUE THEN
            CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'Improper action on non-ATS device.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
         ENDIF;
         RETURN(PU_CANCEL);
      ENDIF;
   ENDIF;
/*
**  Find the related ATS Load device.
*/ 
   ATSLoad.Object = 0;
   REPEATED
   SELECT :ATSLoad.Object = O.Object,
          :ATSLoad.TypeName = O.TypeName,
          :ATSLoad.Name = O.Name 
   FROM   Udb_Object O,
          Udb_Grouping G
   WHERE  G.Grouping = :ATS.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.Member = O.Object AND
          O.Type IN (SELECT Type
                     FROM   Udb_ExtendedType
                     WHERE  SuperType = :Type$ATSLoad);

   IF ATSLoad.Object = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS Load device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckATLSLoadNotGrFrMacro:  ATS setup problem. ' +
               'Unable to find ATS Load device for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS device is not setup correctly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
      ENDIF;
      RETURN (PU_CANCEL);
   ENDIF;
/*
**  Find the related Load Side Feeder.
*/ 
   LoadSideFeeder = 0;
   SELECT :LoadSideFeeder = G.Grouping
   FROM   Udb_Grouping G
   WHERE  G.Member = :ATSLoad.Object AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType IN (SELECT Type
                             FROM   Udb_ExtendedType
                             WHERE  SuperType = :Type$Feeder);

   IF LoadSideFeeder = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
               'ATS Setup Error: ' +
               'Unable to find ATS Load Side feeder for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '. ' +
               'Contact your Adminstrative DO.',
                           TraceMessage =
               'CheckATSLoadNotGFrMacro:  ATS setup problem. ' +
               'Unable to find ATS Load Side feeder for ' +
               'ATS Grouper ' + ATS.TypeName + ' ' + ATS.Name + '.'
               );
      IF AutomaticExecution = TRUE THEN
         CALLFRAME Warning
                    ( Card = JIP.Card, 
                      Job = JIP.Job, 
                      SwitchingItem = JIP.SwitchingItem,
                      Text = 'ATS device is not setup correctly.  ' +
                             'Tech Support should review Automation Monitor ' +
                             'trace log for specific error.'
                    ); 
      ENDIF;
      RETURN (PU_CANCEL);
   ENDIF;
/*
**  Determine if load-side is grounded and look for other feeder grounds, 
**  HV status, or Amm Clear in Progress.
*/
   LoadSideStatus = 0;
   WarningStatus = 0;

   SELECT :StatusOrder = 1,
          :LoadSideStatus = S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :ATSLoad.Object AND
          S.Status = :Status$Ground
   UNION
   SELECT 2,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :Status$FeederGround
   UNION
   SELECT 3,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :TypeName$HV
   UNION
   SELECT 4,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :TypeName$ACClrInProg
   UNION
   SELECT 5,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :Status$OTW
   UNION
   SELECT 6,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :Status$BT
   UNION
   SELECT 7,
          S.StatusCount
   FROM   FMS_ObjectStatus S
   WHERE  S.Object = :LoadSideFeeder AND
          S.Status = :Status$TC
   UNION
   SELECT 8,
          S.StatusCount
   FROM   FMS_PendingStatus S
   WHERE  S.Object = :ATSLoad.Object AND
          S.PendingStatus = :Status$Ground AND
          S.StatusCount > 0
   ORDER BY StatusOrder
   BEGIN
      IF StatusOrder = 1 THEN
         StatusName = 'is Grounded';
      ELSEIF StatusOrder = 2 THEN
         StatusName = 'has Field Grounds';
      ELSEIF StatusOrder = 3 THEN
         StatusName = 'has High Voltage Applied';
      ELSEIF StatusOrder = 4 THEN
         StatusName = 'has Ammeter Clear In Progress';
      ELSEIF StatusOrder = 5 THEN
         StatusName = 'has OTW Status';
      ELSEIF StatusOrder = 6 THEN
         StatusName = 'has BT Status';
      ELSEIF StatusOrder = 7 THEN
         StatusName = 'has TC Applied';
      ELSEIF StatusOrder = 8 THEN
         StatusName = 'has a pending Ground';
      ENDIF;
      RetCode = CALLFRAME Warning 
                          (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem,
                           Text = 'The Load-Side Feeder ' + StatusName);  
      IF RetCode = PU_CANCEL THEN
         RETURN(PU_CANCEL);
      ELSE
         WarningStatus = Warning$Overridden;
      ENDIF;
   END;
   
   IF WarningStatus = Warning$Overridden THEN
      RETURN(Warning$Overridden);
   ELSE
      RETURN(NULL); 
   ENDIF;
END;

Application Component Report
============================

	Name:            CheckATSLoadSideNoGround

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          CheckATSLoadSideNoGround  
**
**  Modifications:
**  06/02/93  em   Created 
**  06/25/93  em   reverse the check, give warning if load side grounded
**  02/07/94  em   renamed from CheckATSLoadSideGround
**  11/15/02  ysp  Merge: removed C and Jobs as passed-ins.
*/
PROCEDURE  CheckATSLoadSideNoGround 
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    ConfirmStatus = INTEGER;
    OverrideReason = VARCHAR(60);
    RetCode = INTEGER;
    i = INTEGER;
    LoadSideGrounded = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Determine if load-side is grounded using connectivity in database.
**  Assumption is that object at connection is at source position for
**  the load-side feeder.
*/ 
  SELECT :LoadSideGrounded = Count(S.StatusCount)
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         FMS_ObjectStatus S
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 2 AND      /* Terminal 2 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 1 AND      /* Terminal 1 */
         T2.Object = S.Object AND
         S.Status = :Status$Ground;

  WarningStatus = PU_OK;

  IF LoadSideGrounded > 0 THEN
    
    WarningStatus = CALLFRAME Warning 
                              (Card = JIP.Card, 
                               Job = JIP.Job, 
                               SwitchingItem = JIP.SwitchingItem,
                               Text = 'The Load-Side Feeder is grounded.');  
    IF WarningStatus = PU_CANCEL THEN
      RETURN(PU_CANCEL);
    ELSE
      RETURN(Warning$Overridden);
    ENDIF;
 
  ENDIF;

  RETURN(NULL); 

END;

Application Component Report
============================

	Name:            CheckATSManual


/*
** Copyright c 1997 ESCA Corporation. All Rights Reserved.
** 
** ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
** DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
** PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          CheckATSManual
**
**  Modifications:
**  05/02/97  jfl   Created 
**  05/07/97  jfl   Improve performance
**  10/17/97  jfl   Support for ATSP and ATSU
**  11/18/02  ysp   Merge: removed C and Jobs as passed-ins. Get feeder id
**                  from the database.
**  02/28/03  pkw  Use DISTINCT against SOA_ActiveCard for feeder
**                 that span divisions.
**  01/03/11  em   Remove use of C.Feeder for 3G support.
**  10/28/11  em   Implement code changes made by Kip to use extended type
**                 instead of super type
*/
PROCEDURE  CheckATSManual
(
    JIP = JobInProgress;				/* Job being processed */
    WarningStatus = INTEGER;
    i = INTEGER;
    m = INTEGER;
    OverRide = INTEGER NOT NULL;
    GType = INTEGER NOT NULL;
    ATSList  = Array of GrouperInfo;  /*  List of ATS for current feeder */
    ExcludeType = Array of IntegerObject;
) =
BEGIN
    OverRide = FALSE;
    WarningStatus = PU_OK;
/*
** Determine the list of ATS for this feeder 
** where an ATSManual Status has been set
*/
    ATSList.Clear();
    i = 1;
    REPEATED 
    SELECT DISTINCT
        :ATSList[i].GrouperId = O.Object,
        :ATSList[i].GrouperName = O.Name
    FROM  Udb_Grouping G,
          SOA_ActiveObject AO,
          FMS_ObjectStatus OS,
          Udb_Object O
    WHERE AO.Card = :JIP.Card AND
          AO.Object = G.Grouping AND
          G.GroupingType = :Type$Feeder 
      AND G.RelationShip = :Interaction$MemberOf  
      AND G.MemberType IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$ATSGrouper)
      AND O.Object = G.Member
      AND G.Member = OS.Object
      AND OS.Status = :Status$ATSManual
    BEGIN
        i = i + 1;
    END;
    IF ATSList.LastRow() = 0 THEN
       /* no ATS Groupers */
       return(NULL);
    ENDIF;
/*
**  Get list of ATSload equipment types that need to be 
**  excluded.
*/
    i = 1;
    ExcludeType.Clear();
    REPEATED
    SELECT :ExcludeType[i].Value = ET.Type
    FROM   Udb_ExtendedType ET
    WHERE  ET.SuperType = :Type$ATSLoad
    BEGIN
       i = i + 1;
    END;
/*
** Identify Closed ATS switch on this feeder 
** for ATS where an ATSManual status has been set
*/
    i = 1;
    WHILE i <= ATSList.LastRow() DO
        GType = 0;
        REPEATED
        SELECT :GType = G1.MemberType
        FROM Udb_Grouping G1,
             Udb_Grouping G2,
             Udb_Switch S,
             SOA_ActiveObject AO
        WHERE G1.Grouping = :ATSList[i].GrouperID
          AND G1.RelationShip  = :Interaction$MemberOf 
          AND G1.MemberType IN (SELECT Type 
                                FROM Udb_ExtendedType 
                                WHERE SuperType = :Type$ATSGeneric)
          AND G1.Member = G2.Member
          AND AO.Card = :JIP.Card 
          AND AO.Object = G2.Grouping
          AND G2.GroupingType = :Type$Feeder
          AND G2.Relationship = :Interaction$MemberOf
          AND G1.Member = S.Object
          AND S.CurrentlyOpen = 0;

        IF GType = 0 THEN /* Equipment is Open */
           ATSList.RemoveRow(RowNumber = i);
        ELSE              /* Equipment is Closed */
           /* Filter out Load side equipment */
           m = 1;
           WHILE m <= ExcludeType.LastRow() DO
              IF ExcludeType[m].Value = GType THEN
                 ENDLOOP;
              ENDIF;
              m = m + 1;
           ENDWHILE;
           IF m <= ExcludeType.LastRow() THEN
              ATSList.RemoveRow(RowNumber = i);
           ELSE
              i = i + 1;
           ENDIF;
        ENDIF;

    ENDWHILE;
/*
**   Give warnings for all ATS equipment in manual mode
*/
    i = 1;
    WHILE i <= ATSList.LastRow() DO
        WarningStatus = CALLFRAME Warning 
                          (Card = JIP.Card, 
                           Job = JIP.Job,
                           SwitchingItem = JIP.SwitchingItem,
                Text = ' ATS ' + ATSList[i].GrouperName + ' is in manual mode.');

        IF WarningStatus = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            OverRide = TRUE;
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
**  Check to see if they overrode a warning 
*/
    IF OverRide = FALSE THEN
       RETURN(NULL); 
    ELSE
       RETURN(Warning$Overridden);
    ENDIF;
END;

Application Component Report
============================

	Name:            CheckBowlingGreenHiPot


/*
**      Copyright c 2006 Pateric Software LLC  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC. 
**
**  Application:    CAC 
**  4GL Procedure:  CheckBowlingGreenHiPot
**
**  Date:     Version  Description
** --------------------------------------------------
**  11/01/06  em       Created
**  01/03/11  em       Added 3G support
*/
PROCEDURE CheckBowlingGreenHiPot
(
    JIP = JobInProgress;			  /* parameter - Job being processed */

    Card = INTEGER NOT NULL WITH DEFAULT;
    CurrentTime = DATE NOT NULL WITH DEFAULT;
    DayTime = INTEGER NOT NULL WITH DEFAULT;
    DayWeek = CHAR(3) NOT NULL WITH DEFAULT;
    Feeder = INTEGER NOT NULL WITH DEFAULT;
    FeederStatus = INTEGER NOT NULL WITH DEFAULT; 
    HighPotComplete = INTEGER NOT NULL WITH DEFAULT;

    RetCode = INTEGER;
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
)= 
BEGIN 
   RetCode = NULL;
   CurrentTime = 'now';
   DayTime = date_part('hour', CurrentTime);
   DayWeek = UPPERCASE(dow(CurrentTime));
/*
** Must be week day between 0700 and 1800.
*/
   IF DayWeek = 'SAT' OR DayWeek = 'SUN' THEN
      RETURN(RetCode);
   ENDIF;

   IF DayTime < 7 OR DayTime >= 18 THEN
      RETURN(RetCode);
   ENDIF;
/*
** Get Feeder, is it in BowlingGreen network?  All 3G Feeders should have same statuses.
*/
   Feeder = 0;
   Card = 0;
   REPEATED 
   SELECT   :Feeder = AO.Object,
            :Card = AO.Card
   FROM     SOA_JobControl JC,
            SOA_ActiveObject AO,
            Udb_Grouping G
   WHERE    JC.Job = :JIP.Job AND
            JC.Card = AO.Card AND
            AO.Object = G.Member AND
            G.MemberType = :Type$Feeder AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = :Network$BowlingGreen;

   IF Feeder = 0 THEN
      RETURN(RetCode);
   ENDIF;
/*
** Does feeder have waived high pot NYSE status?
*/
   FeederStatus = 0;
   SELECT  :FeederStatus = Status
   FROM    FMS_ObjectStatus
   WHERE   Object = :Feeder AND
           StatusCount > 0 AND
           Status = :Status$NYSEWaivedHP;

   IF FeederStatus = Status$NYSEWaivedHP THEN
      RETURN(RetCode);
   ENDIF;
/*
** Has a High Pot Move been performed on this card?
*/
   HighPotComplete = 0;
   REPEATED
   SELECT   :HighPotComplete = J.Job
   FROM     SOA_JobControl JC,
            SOA_Job J,
            FMS_JobAction JA
   WHERE    JC.Card = :Card AND
            JC.Job = J.Job AND
           (J.RSComplete IS NOT NULL AND J.RSComplete <> '') AND
            J.JobClass = JA.JobClass AND
            JA.Status IN (:Prompt$HighPotDist, :Prompt$ModHighPotDist,
                         :Prompt$ACHighPotDist);

   IF HighPotComplete = 0 THEN 
   
      WarningStatus = CALLFRAME Warning
                        ( Card = JIP.Card, 
                          Job = JIP.Job,
                          SwitchingItem = JIP.SwitchingItem, 
                          Text = 'This feeder provides service to the New York Stock Exchange.  ' +
                                 'It cannot be restored until a Modified High Pot has been performed.  ' +
                                 'The Shift Manager must inform the NYSE rep in order to waive the high pot.'
                        ); 
      IF (WarningStatus = PU_CANCEL) THEN
         RetCode = PU_CANCEL;
      ELSE
         RetCode = Warning$Overridden;
      ENDIF;
   ENDIF;

   RETURN (RetCode);    
END; 

Application Component Report
============================

	Name:            CheckCheckListReview

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          CheckCheckListReview
**                   
**  Modifications:
**      02/14/01    em      Created to call new CheckListReview Precheck.
**      02/28/03    pkw     Use DISTINCT against SOA_ActiveCard for feeder
**                          that span divisions.
*/
PROCEDURE CheckCheckListReview
(
    JIP = JobInProgress;                    /* Passed Job*/

    Cards = ARRAY OF INTEGEROBJECT;   /*TFMS Cards*/
    i = INTEGER NOT NULL WITH DEFAULT;     /*COUNTER*/
    RetCode = INTEGER NOT NULL;             /* Return Code */ 
) =
BEGIN
/*
**  Now make sure we have a transmission card.  Procedure can be called
**  from SLC in SOA.
*/
    i = 1;
    Cards.Clear();
    REPEATED
    SELECT DISTINCT
          :Cards[i].Value = JC.Card 
    FROM   SOA_JobControl JC,
           SOA_ActiveCard AC
    WHERE  JC.Job = :JIP.Job AND
           JC.Card = AC.Card AND
           AC.Application = :Application$TFMS
    BEGIN
       i = i + 1;
    END;

    IF Cards.LastRow() = 0 THEN
       RETURN (PU_OK);
    ELSE
       FOR i = 1 TO Cards.LastRow() DO
          RetCode = CALLPROC CheckListReview (Job = JIP, Card = Cards[i].Value); 
           
          IF RetCode <> PU_OK THEN
             RETURN (RetCode); 
          ENDIF;
       ENDFOR;
    ENDIF; 

    RETURN (PU_OK);
END;

