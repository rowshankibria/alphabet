	Name:            ProtectionCompromised

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    TelephoneCard
**  Frame:          ProtectionCompromised
**
**  Modifications:
**
**  01/13/97        pkw     created
**  08/28/97        pkw     add process indicator
**  07/20/04        pkw     Allow frame to be called up from TFMS and TC
**  02/10/05        pkw     Add MatrixGrouping.  If array is not empty
**                          we will load data for each matrix in array.
**  04/25/05        pkw     Show DO override to Red.
**  05/18/05        pkw     When called up with MatrixGrouping not empty
**                          show which matrix have red condition.
**  01/20/10        ysp     TLS 50: Get route info from udb_circuitroute table
**  06/05/12        pkw     Modify to handle sub matrix (i.e. more than two)
*/

INITIALIZE
(
    i = integer not null;               /* Temporary counter */
    j = integer not null;               /* Temporary counter */
    m = integer not null;               /* Temporary counter */
    LoadCard = integer;                        /* Temporary counter */
    CircuitRow = integer;                        /* Temporary counter */
    FoundStatus = integer;                        /* Temporary counter */
    MaxCircuits = integer not null;
    MaxFeeders = integer not null;
    CurrentCircuit = integer not null;
    CurrentFeeder = integer not null;
    MatrixSelected = integer not null;
    FromTFMS = integer not null;
    FromTC   = integer not null;
    RTUCount = integer;
    EquipmentStatus = integer;
    FeederStatus = integer;                        /* Temporary counter */
    RelayList = ARRAY OF RelayStatusClass;
    RTULine = ARRAY OF CardClass;
    StatusColor = INTEGER NOT NULL WITH DEFAULT;
    ParentFrame = FrameExec;
    gCheck = INTEGER NOT NULL WITH DEFAULT; 
    gReset = INTEGER NOT NULL WITH DEFAULT; 
    gIn    = INTEGER NOT NULL WITH DEFAULT; 
    gOut   = INTEGER NOT NULL WITH DEFAULT; 
    CompStatus  = INTEGER NOT NULL WITH DEFAULT; 
    CountStatus = INTEGER NOT NULL WITH DEFAULT; 
    CktStatus   = INTEGER NOT NULL WITH DEFAULT; 
    OverRide_Flag = INTEGER NOT NULL WITH DEFAULT; 
    OR_Matrix   = ARRAY OF RPM_ASE;
    MatrixGrouping = ARRAY OF INTEGEROBJECT;
    RetCode = INTEGER NOT NULL WITH DEFAULT; 
    MultiCheck = ARRAY OF INTEGEROBJECT;
    k = INTEGER NOT NULL WITH DEFAULT; 
) =
BEGIN
   ParentFrame = FrameExec(CurFrame.ParentFrame);
   MaxCircuits = 4; /* at least show four rows */
   MaxFeeders = 1; /* at least show one row */
/*
**  If MatrixGrouping is not empty we will load just the matrices for the 
**  groupings that were passed in.
*/
   IF MatrixGrouping.LastRow() <> 0 THEN
      /*
      **  Populate Matrix array with data passed into frame in MatrixGrouping.
      */
      Matrix.Clear();
      FOR i = 1 TO MatrixGrouping.LastRow() DO
         Matrix[i].Object = MatrixGrouping[i].Value;
      ENDFOR;
      /*
      **  Now build protection matrix list 
      */
      i = 1;
      WHILE i <= Matrix.LastRow() DO
         OverRide_Flag = 0;
         /* default color */
         StatusColor = CC_PALE_YELLOW;
         /*
         **  Select circuits ordered by circuit
         */
         Matrix[i].sf.CircuitStatus.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].sf.CircuitStatus[m].Object = RC.Circuit,
                :Matrix[i].sf.CircuitStatus[m].Name = O.Name
         FROM   CAC_Relay_Circuit RC,
                Udb_Object O
         WHERE  RC.Grouping = :Matrix[i].Object AND
                RC.Circuit = O.Object
         ORDER BY Object
         BEGIN
            /*
            **  Start out assuming the circuit is inservice and
            **  replace status if circuit is outservice.
            **  1 = inservice; 0 = outservice;
            */
            Matrix[i].sf.CircuitStatus[m].Status = 1;
            SELECT :Matrix[i].sf.CircuitStatus[m].Status = 0
            FROM   TC_Job J,
                   TC_Card C
            WHERE  J.Circuit  = :Matrix[i].sf.CircuitStatus[m].Object AND
                   J.OutService IS NOT NULL AND
                   J.InService IS NULL AND 
                   J.Card = C.Card AND
                   C.Status < :TC_Card$Closed;  
            m = m + 1;
         END;
         /*
         **  Select feeders ordered by feeder
         */
         Matrix[i].fl.Feeder.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].fl.Feeder[m].Object = RF.Feeder,
                :Matrix[i].fl.Feeder[m].Name = O.Name
         FROM   CAC_Relay_Feeder RF,
                Udb_Object O
         WHERE  RF.Grouping = :Matrix[i].Object AND
                RF.Feeder = O.Object
         ORDER BY Object
         BEGIN
            m = m + 1;
         END;
         /*
         **  Get information about matrix to figure out which row 
         **  to highlight.
         */
         m = 1;
         REPEATED 
         SELECT :RelayList[m].Circuit = RS.Circuit,
                :RelayList[m].Seq = RS.Seq,
                :RelayList[m].Status = RS.Status
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :Matrix[i].Object AND
                RS.Circuit > 0
         ORDER BY Seq,Circuit
         BEGIN
            m = m + 1;
         END; 
      
         m = 1;
         MultiCheck.Clear();
         MultiCheck[1].Value = -1;
      WHILE m <= RelayList.LastRow AND Multicheck.LastRow <> 0 DO
         /*
         **  Set MultiCheck = FALSE so check only happens one time.
         */
         MultiCheck.Clear();
         
         gCheck = FALSE;
         gReset = FALSE;
         gIn = 0;
         gOut = 0;
         CircuitRow = 1;
         j = Matrix[i].sf.CircuitStatus.LastRow();
         FoundStatus = FALSE;
         WHILE CircuitRow <= Matrix[i].sf.CircuitStatus.LastRow() DO
            IF Matrix[i].sf.CircuitStatus[CircuitRow].Object = RelayList[m].Circuit AND
              (Matrix[i].sf.CircuitStatus[CircuitRow].Status = RelayList[m].Status OR
               RelayList[m].Status = Relay$Either OR
               RelayList[m].Status = Relay$GrpCriteria OR 
               RelayList[m].Status = Relay$StatusBlank)  THEN
/*
**  IF this circuit is part of a grouping, we will set the gCheck Flag 
**  and increment gIn or gOut counts.
*/
               IF RelayList[m].Status = Relay$GrpCriteria THEN
                  gCheck = TRUE;
                  IF Matrix[i].sf.CircuitStatus[CircuitRow].Status = Relay$InService THEN
                     gIn = gIn + 1;
                  ELSE
                     gOut = gOut + 1;
                  ENDIF;
               ENDIF;
               /*
               **   If this circuit has a blank relay status then we will continue to search
               **   until we find another match for this circuit.
               */ 
               IF RelayList[m].Status = Relay$StatusBlank THEN
                  MultiCheck[Multicheck.LastRow + 1].Value = CircuitRow;
               ENDIF;
/*
**  IF this was the last circuit needed to be checked in this row and
**  gCheck = TRUE, that means all I,O and * passed and now we just need 
**  to see if the comparison operator checked out ok.  If not we will 
**  reset and continue with the loop.
*/
               IF CircuitRow = Matrix[i].sf.CircuitStatus.LastRow() AND
                  gCheck = TRUE THEN
                  /* 
                  ** Get Comparison operator
                  **   0 = ''; 1 = '>='; 2 = '='; 3 = '<'
                  */
                  SELECT :CompStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$Comparison;
                  CALLPROC DDB_ROLLBACK;
         
                  SELECT :CountStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$Count;
                  CALLPROC DDB_ROLLBACK;

                  SELECT :CktStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$CktStatus;
                  CALLPROC DDB_ROLLBACK;

                  IF CompStatus = Relay$GreaterThan THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck >= CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ELSEIF CompStatus = Relay$Equal THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck = CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ELSEIF CompStatus = Relay$LessThan THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck < CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ENDIF;
         
                  IF gReset = TRUE THEN
                     MultiCheck.Clear();
                     gCheck = FALSE;
                     gReset = FALSE;
                     gIn = 0;
                     gOut = 0;
                     CircuitRow = 1;
                     m = m + j;
                     j = Matrix[i].sf.CircuitStatus.LastRow();
                     CONTINUE;
                  ENDIF;
               ENDIF;
      
               CircuitRow = CircuitRow + 1;
               m = m + 1;
               j = j - 1;
            ELSE
               MultiCheck.Clear();
               gCheck = FALSE;
               gReset = FALSE;
               gIn = 0;
               gOut = 0;
               CircuitRow = 1;
               m = m + j;
               j = Matrix[i].sf.CircuitStatus.LastRow();
            ENDIF;
            /* Do this to prevent error in loop */
            IF m > RelayList.LastRow() THEN
               ENDLOOP;
            ENDIF;
         ENDWHILE;
         /* If CircuitRow is > Matrix[i].sf.CircuitStatus.Lastrow then we found a status */
         IF CircuitRow > Matrix[i].sf.CircuitStatus.LastRow() THEN
            /* 
            **  Use FoundStatus to get correct feederstatus.
            **  decrement 1 since i was incremented above.
            */
            FoundStatus = RelayList[m -1].Seq; 
         ENDIF;
      
         IF FoundStatus <> FALSE THEN
/*
**  If DOOverRide <> 0 THEN we will not show red status.
*/
            OverRide_Flag = 0;
            SELECT :OverRide_Flag = DOOverRide
            FROM    CAC_Relay_Grouping
            WHERE   Grouping = :Matrix[i].Object;
   
            IF OverRide_Flag = 0 THEN
               REPEATED 
               SELECT :FeederStatus = RS.Status
               FROM   CAC_Relay_Status RS
               WHERE  RS.Grouping = :Matrix[i].Object AND
                      RS.Seq = :FoundStatus AND
                      RS.Circuit = :Relay$Feeder;
               CALLPROC DDB_ROLLBACK;
               IF FeederStatus <> Relay$Yes AND
                  FeederStatus <> Relay$Blank THEN
                  StatusColor = CC_RED;
               ELSE
                  /* If the feeder = 'y', then see if equipment is */
                  REPEATED 
                  SELECT :EquipmentStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :FoundStatus AND
                         RS.Circuit = :Relay$Equipment;
                  IF EquipmentStatus <> Relay$Yes AND
                     EquipmentStatus <> Relay$Blank THEN
                     StatusColor = CC_RED;
                  ENDIF;
               ENDIF;
            ENDIF;   
         ENDIF;
         /*
         **  This is to see how many rows need to be shown
         */
         IF MaxCircuits < Matrix[i].sf.CircuitStatus.LastRow() THEN
            MaxCircuits = Matrix[i].sf.CircuitStatus.LastRow();
         ENDIF;

         IF MaxFeeders < Matrix[i].fl.Feeder.LastRow() THEN
            MaxFeeders = Matrix[i].fl.Feeder.LastRow();
         ENDIF;

         Matrix[i].Name = 'Matrix ' + varchar(i);
         IF OverRide_Flag <> 0 THEN
            FIELD(Matrix[i].Name).BGColor = CC_YELLOW;
         ENDIF;
         
         IF StatusColor = CC_RED THEN
            FIELD(Matrix[i].Name).BGColor = StatusColor;     
         ENDIF;

         IF MultiCheck.LastRow <> 0 AND StatusColor <> CC_RED THEN
            /*
            **  'm' should be equal to the first row of the next RPM status
            **  list.  MultiCheck[].Value should be equal to the column(s) that 
            **  had a blank status.  We will go through each row in the Matrix 
            **  until the status that was blank is no longer blank and then we 
            **  will search again.
            */
            WHILE m <= RelayList.LastRow() DO
               RetCode = CALLPROC RPM_CheckBlankStatus(pRow = m,
                                             pList  = RelayList.Duplicate(),
                                             pCheck = Multicheck.Duplicate()
                                             );
               IF RetCode = 1 THEN
                  /*  Found non-blank status in this row. */
                  ENDLOOP;
               ELSEIF RetCode = 0 THEN
                  /*
                  **  All Multicheck Circuits were still blank for this row.
                  */
                  m = m + Matrix[i].sf.CircuitStatus.LastRow();
               ELSEIF RetCode = -1 THEN
                  /* 
                  **  Reached end of matrix 
                  */
                  Multicheck.Clear();
                  ENDLOOP;
               ENDIF;
            ENDWHILE; 
         ENDIF;

      ENDWHILE;

         m = 1;
         WHILE m <= Matrix[i].sf.CircuitStatus.LastRow() DO
            IF Matrix[i].sf.CircuitStatus[m].Status = 0 THEN
               Matrix[i].sf.CircuitStatus[m].Name = '(' + Matrix[i].sf.CircuitStatus[m].Name + ')'; 
            ENDIF;
            m = m + 1;
         ENDWHILE;
         i = i + 1;
      ENDWHILE;
   ELSE
      RTUCount = 1;
      /*
      **  First load in all matrices
      **  Figure out how many matrices and rtulines there are now so that 
      **  we can show the process indicator to them.
      */
      Matrix.Clear();
      i = 1;
      SELECT DISTINCT :Matrix[i].Object = RC.Grouping
      FROM   CAC_Relay_Circuit RC
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;

      RTULine.Clear();
      i = 1;
      SELECT DISTINCT 
            RTULine[i].LineType = C.LineType,
            RTULine[i].LineNumber = C.LineNumber,
            RTULine[i].Circuit = C.Circuit,
            RTULine[i].Carrier = O.Primarygrouping,
            RTULine[i].CarrierName = O.Primarygroupingname
      FROM  TC_Card C,
            Udb_ExtendedType ET,
            Udb_Object O,
            Udb_CircuitRoute TC
      WHERE ET.SuperType = :Type$SCADA AND 
            ET.Type = C.LineType AND 
            C.Status IN (:TC_Card$Active,:Card$Telco,:Card$PST) AND 
            C.Circuit = O.Object AND 
            O.Object = TC.Object AND 
            TC.Route IN (:Route$NumberOne,:Route$NumberTwo)
      ORDER BY LineType, Carrier
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK; 

      /*
      **  Now build protection matrix list 
      */
      i = 1;
      WHILE i <= Matrix.LastRow() DO
         OverRide_Flag = 0;
         /* default color */
         StatusColor = CC_PALE_YELLOW;
         /*
         **  Select circuits ordered by circuit
         */
         Matrix[i].sf.CircuitStatus.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].sf.CircuitStatus[m].Object = RC.Circuit,
                :Matrix[i].sf.CircuitStatus[m].Name = O.Name
         FROM   CAC_Relay_Circuit RC,
                Udb_Object O
         WHERE  RC.Grouping = :Matrix[i].Object AND
                RC.Circuit = O.Object
         ORDER BY Object
         BEGIN
            /*
            **  Start out assuming the circuit is inservice and
            **  replace status if circuit is outservice.
            **  1 = inservice; 0 = outservice;
            */
            Matrix[i].sf.CircuitStatus[m].Status = 1;
            SELECT :Matrix[i].sf.CircuitStatus[m].Status = 0
            FROM   TC_Job J,
                   TC_Card C
            WHERE  J.Circuit  = :Matrix[i].sf.CircuitStatus[m].Object AND
                   J.OutService IS NOT NULL AND
                   J.InService IS NULL AND 
                   J.Card = C.Card AND
                   C.Status < :TC_Card$Closed;  
            m = m + 1;
         END;
         /*
         **  Select feeders ordered by feeder
         */
         Matrix[i].fl.Feeder.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].fl.Feeder[m].Object = RF.Feeder,
                :Matrix[i].fl.Feeder[m].Name = O.Name
         FROM   CAC_Relay_Feeder RF,
                Udb_Object O
         WHERE  RF.Grouping = :Matrix[i].Object AND
                RF.Feeder = O.Object
         ORDER BY Object
         BEGIN
            m = m + 1;
         END;
         /*
         **  Get information about matrix to figure out which row 
         **  to highlight.
         */
         m = 1;
         REPEATED 
         SELECT :RelayList[m].Circuit = RS.Circuit,
                :RelayList[m].Seq = RS.Seq,
                :RelayList[m].Status = RS.Status
         FROM   CAC_Relay_Status RS
         WHERE  RS.Grouping = :Matrix[i].Object AND
                RS.Circuit > 0
         ORDER BY Seq,Circuit
         BEGIN
            m = m + 1;
         END; 
      
         m = 1;
         MultiCheck.Clear();
         MultiCheck[1].Value = -1;
      WHILE m <= RelayList.LastRow AND MultiCheck.LastRow <> 0 DO
         /*
         **  Set MultiCheck = FALSE so check only happens one time.
         */
         MultiCheck.Clear();

         gCheck = FALSE;
         gReset = FALSE;
         gIn = 0;
         gOut = 0;
         CircuitRow = 1;
         j = Matrix[i].sf.CircuitStatus.LastRow();
         FoundStatus = FALSE;
         WHILE CircuitRow <= Matrix[i].sf.CircuitStatus.LastRow() DO
            IF Matrix[i].sf.CircuitStatus[CircuitRow].Object = RelayList[m].Circuit AND
              (Matrix[i].sf.CircuitStatus[CircuitRow].Status = RelayList[m].Status OR
               RelayList[m].Status = Relay$Either OR
               RelayList[m].Status = Relay$GrpCriteria OR 
               RelayList[m].Status = Relay$StatusBlank)  THEN
/*
**  IF this circuit is part of a grouping, we will set the gCheck Flag 
**  and increment gIn or gOut counts.
*/
               IF RelayList[m].Status = Relay$GrpCriteria THEN
                  gCheck = TRUE;
                  IF Matrix[i].sf.CircuitStatus[CircuitRow].Status = Relay$InService THEN
                     gIn = gIn + 1;
                  ELSE
                     gOut = gOut + 1;
                  ENDIF;
               ENDIF;
               /*
               **   If this circuit has a blank relay status then we will continue to search
               **   until we find another match for this circuit.
               */ 
               IF RelayList[m].Status = Relay$StatusBlank THEN
                  MultiCheck[Multicheck.LastRow + 1].Value = CircuitRow;
               ENDIF;
/*
**  IF this was the last circuit needed to be checked in this row and
**  gCheck = TRUE, that means all I,O and * passed and now we just need 
**  to see if the comparison operator checked out ok.  If not we will 
**  reset and continue with the loop.
*/
               IF CircuitRow = Matrix[i].sf.CircuitStatus.LastRow() AND
                  gCheck = TRUE THEN
                  /* 
                  ** Get Comparison operator
                  **   0 = ''; 1 = '>='; 2 = '='; 3 = '<'
                  */
                  SELECT :CompStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$Comparison;
                  CALLPROC DDB_ROLLBACK;
         
                  SELECT :CountStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$Count;
                  CALLPROC DDB_ROLLBACK;

                  SELECT :CktStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :RelayList[m].Seq AND
                         RS.Circuit = :Relay$CktStatus;
                  CALLPROC DDB_ROLLBACK;

                  IF CompStatus = Relay$GreaterThan THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck >= CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ELSEIF CompStatus = Relay$Equal THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck = CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ELSEIF CompStatus = Relay$LessThan THEN
                     IF CktStatus = Relay$Inservice THEN
                        gCheck = gIn;
                     ELSE
                        gCheck = gOut;
                     ENDIF;

                     IF gCheck < CountStatus THEN
                       /* do nothing and let code exit loop */
                     ELSE
                        gReset = TRUE;
                     ENDIF;
                  ENDIF;
         
                  IF gReset = TRUE THEN
                     MultiCheck.Clear();
                     gCheck = FALSE;
                     gReset = FALSE;
                     gIn = 0;
                     gOut = 0;
                     CircuitRow = 1;
                     m = m + j;
                     j = Matrix[i].sf.CircuitStatus.LastRow();
                     CONTINUE;
                  ENDIF;
               ENDIF;
      
               CircuitRow = CircuitRow + 1;
               m = m + 1;
               j = j - 1;
            ELSE
               MultiCheck.Clear();
               gCheck = FALSE;
               gReset = FALSE;
               gIn = 0;
               gOut = 0;
               CircuitRow = 1;
               m = m + j;
               j = Matrix[i].sf.CircuitStatus.LastRow();
            ENDIF;
            /* Do this to prevent error in loop */
            IF m > RelayList.LastRow() THEN
               ENDLOOP;
            ENDIF;
         ENDWHILE;
         /* If CircuitRow is > Matrix[i].sf.CircuitStatus.Lastrow then we found a status */
         IF CircuitRow > Matrix[i].sf.CircuitStatus.LastRow() THEN
            /* 
            **  Use FoundStatus to get correct feederstatus.
            **  decrement 1 since i was incremented above.
            */
            FoundStatus = RelayList[m -1].Seq; 
         ENDIF;
      
         IF FoundStatus <> FALSE THEN
/*
**  If DOOverRide <> 0 THEN we will not show red status.
*/
            OverRide_Flag = 0;
            SELECT :OverRide_Flag = DOOverRide
            FROM    CAC_Relay_Grouping
            WHERE   Grouping = :Matrix[i].Object;
   
            IF OverRide_Flag = 0 THEN
               REPEATED 
               SELECT :FeederStatus = RS.Status
               FROM   CAC_Relay_Status RS
               WHERE  RS.Grouping = :Matrix[i].Object AND
                      RS.Seq = :FoundStatus AND
                      RS.Circuit = :Relay$Feeder;
               CALLPROC DDB_ROLLBACK;
               IF FeederStatus <> Relay$Yes AND
                  FeederStatus <> Relay$Blank THEN
                  StatusColor = CC_RED;
               ELSE
                  /* If the feeder = 'y', then see if equipment is */
                  REPEATED 
                  SELECT :EquipmentStatus = RS.Status
                  FROM   CAC_Relay_Status RS
                  WHERE  RS.Grouping = :Matrix[i].Object AND
                         RS.Seq = :FoundStatus AND
                         RS.Circuit = :Relay$Equipment;
                  IF EquipmentStatus <> Relay$Yes AND
                     EquipmentStatus <> Relay$Blank THEN
                     StatusColor = CC_RED;
                  ENDIF;
               ENDIF;
            ENDIF;   
         ENDIF;
         IF MultiCheck.LastRow <> 0 AND StatusColor <> CC_RED THEN
            /*
            **  'm' should be equal to the first row of the next RPM status
            **  list.  MultiCheck[].Value should be equal to the column(s) that 
            **  had a blank status.  We will go through each row in the Matrix 
            **  until the status that was blank is no longer blank and then we 
            **  will search again.
            */
            WHILE m <= RelayList.LastRow() DO
               RetCode = CALLPROC RPM_CheckBlankStatus(pRow = m,
                                             pList  = RelayList.Duplicate(),
                                             pCheck = Multicheck.Duplicate()
                                             );
               IF RetCode = 1 THEN
                  /*  Found non-blank status in this row. */
                  ENDLOOP;
               ELSEIF RetCode = 0 THEN
                  /*
                  **  All Multicheck Circuits were still blank for this row.
                  */
                  m = m + Matrix[i].sf.CircuitStatus.LastRow();
               ELSEIF RetCode = -1 THEN
                  /* 
                  **  Reached end of matrix 
                  */
                  Multicheck.Clear();
                  ENDLOOP;
               ENDIF;
            ENDWHILE; 
         ENDIF;

      ENDWHILE;


         /*
         ** If StatusColor = CC_RED then show this row, else remove it
         */
         IF StatusColor = CC_RED OR OverRide_Flag <> 0 THEN
            /*
            **  This is to see how many rows need to be shown
            */
            IF MaxCircuits < Matrix[i].sf.CircuitStatus.LastRow() THEN
               MaxCircuits = Matrix[i].sf.CircuitStatus.LastRow();
            ENDIF;

            IF MaxFeeders < Matrix[i].fl.Feeder.LastRow() THEN
               MaxFeeders = Matrix[i].fl.Feeder.LastRow();
            ENDIF;

            Matrix[i].Name = 'Matrix ' + varchar(i);
            IF OverRide_Flag <> 0 THEN
               FIELD(Matrix[i].Name).BGColor = CC_YELLOW;
            ENDIF;

            m = 1;
            WHILE m <= Matrix[i].sf.CircuitStatus.LastRow() DO
               IF Matrix[i].sf.CircuitStatus[m].Status = 0 THEN
                  Matrix[i].sf.CircuitStatus[m].Name = '(' + Matrix[i].sf.CircuitStatus[m].Name + ')'; 
               ENDIF;
               m = m + 1;
            ENDWHILE;
            i = i + 1;
         ELSE
            Matrix.RemoveRow(RowNumber = i);
         ENDIF;
      ENDWHILE;
/*
**  Now add SCADA RTU lines to the list.
*/
/*
**  If there are no more than 1 line, we don't need to do anything
*/ 
      IF RTULine.LastRow() >= 2 THEN
         /*
         ** This will filter the list to only get pairs of lines
         */
         i = 1;
         j = 2;
         WHILE j <= RTULine.LastRow() DO
            IF RTULine[i].Carrier = RTULine[j].Carrier AND
               RTULine[i].LineType = RTULine[j].LineType THEN
               /*
               **  Start out assuming the circuit is inservice and
               **  replace status if circuit is outservice.
               **  1 = inservice; 2 = outservice;
               **  do the i subscript first
               */
               RTULine[i].Status = 1;
               REPEATED
               SELECT :RTULine[i].Status = 0
               FROM   TC_Job J,
                      TC_Card C
               WHERE  J.Circuit  = :RTULine[i].Circuit AND
                      J.OutService IS NOT NULL AND
                      J.InService IS NULL AND 
                      J.Card = C.Card AND
                      C.Status < :TC_Card$Closed;   
               /*
               ** Now do the same for j subscript
               */
               RTULine[j].Status = 1;
               REPEATED
               SELECT :RTULine[j].Status = 0
               FROM   TC_Job J,
                      TC_Card C
               WHERE  J.Circuit  = :RTULine[j].Circuit AND
                      J.OutService IS NOT NULL AND
                      J.InService IS NULL AND 
                      J.Card = C.Card AND
                      C.Status < :TC_Card$Closed;    
               /*
               ** IF both lines are outofservice, put them in matrix table.
               */
               IF RTULine[i].Status = 0 AND
                  RTULine[j].Status = 0 THEN

                  RTULine[i].LineNumber = '(' + RTULine[i].LineNumber + ')'; 
                  RTULine[j].LineNumber = '(' + RTULine[j].LineNumber + ')'; 
                  m = Matrix.LastRow() + 1;
                  Matrix.InsertRow(RowNumber = m);
                  Matrix[m].Object = RTULine[i].Circuit;
                  Matrix[m].Name = 'SCADA/RTU ' + varchar(RTUCount);
                  Matrix[m].sf.CircuitStatus[1].Object = RTULine[i].Circuit;
                  Matrix[m].sf.CircuitStatus[1].Name = RTULine[i].LineNumber;
                  Matrix[m].sf.CircuitStatus[2].Object = RTULine[j].Circuit;
                  Matrix[m].sf.CircuitStatus[2].Name = RTULine[j].LineNumber;
                  RTUCount = RTUCount + 1;
                  /* Remove both circuits from array */
                  RTULine.RemoveRow(RowNumber = 1);
                  RTULine.RemoveRow(RowNumber = 1);
               ELSE
                  /* Just remove one circuit from array */
                  RTULine.RemoveRow(RowNumber = 1);
               ENDIF;
            ELSE
               RTULine.RemoveRow(RowNumber = 1);
            ENDIF;
/*
**  IF only one circuit is left in the list it can't be paired with anything
*/
            IF j > RTULine.LastRow() AND
               i = RTULine.LastRow() THEN
               RTULine.RemoveRow(RowNumber = 1);
            ENDIF;
         ENDWHILE;
      ENDIF;
/*
**  Now get all manually overridden feeders and circuits.
*/
      MatrixSelected = Matrix.LastRow() + 1;
      i = Matrix.LastRow() + 1;
      m = 1;
      SELECT DISTINCT :Matrix[i].Object = G.Grouping
      FROM   CAC_Relay_Grouping G
      WHERE  DOOverRide = :RPM$OverrideToRed
      BEGIN
         Matrix[i].Name = 'DO Override ' + varchar(m);
         m = m + 1;
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
      
      FOR i = MatrixSelected TO Matrix.LastRow() DO
         /*
         **  Select circuits ordered by circuit
         */
         Matrix[i].sf.CircuitStatus.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].sf.CircuitStatus[m].Object = RC.Circuit,
                :Matrix[i].sf.CircuitStatus[m].Name = O.Name
         FROM   CAC_CO_Circuit RC,
                Udb_Object O
         WHERE  RC.Grouping = :Matrix[i].Object AND
                RC.Circuit = O.Object
         ORDER BY Object
         BEGIN
            /*
            **  Start out assuming the circuit is inservice and
            **  replace status if circuit is outservice.
            **  1 = inservice; 0 = outservice;
            */
            Matrix[i].sf.CircuitStatus[m].Status = 1;
            SELECT :Matrix[i].sf.CircuitStatus[m].Status = 0
            FROM   TC_Job J,
                   TC_Card C
            WHERE  J.Circuit  = :Matrix[i].sf.CircuitStatus[m].Object AND
                   J.OutService IS NOT NULL AND
                   J.InService IS NULL AND 
                   J.Card = C.Card AND
                   C.Status < :TC_Card$Closed;   
            IF Matrix[i].sf.CircuitStatus[m].Status = 0 THEN
               Matrix[i].sf.CircuitStatus[m].Name = '(' + 
                                Matrix[i].sf.CircuitStatus[m].Name + ')';
            ENDIF;
            m = m + 1;
         END;
         /*
         **  Select feeders ordered by feeder
         */
         Matrix[i].fl.Feeder.Clear();
         m = 1;
         REPEATED 
         SELECT :Matrix[i].fl.Feeder[m].Object = RF.Feeder,
                :Matrix[i].fl.Feeder[m].Name = O.Name
         FROM   CAC_CO_Feeder RF,
                Udb_Object O
         WHERE  RF.Grouping = :Matrix[i].Object AND
                RF.Feeder = O.Object
         ORDER BY Object
         BEGIN
            m = m + 1;
         END;
         /*
         **  This is to see how many rows need to be shown
         */
         IF MaxCircuits < Matrix[i].sf.CircuitStatus.LastRow() THEN
            MaxCircuits = Matrix[i].sf.CircuitStatus.LastRow();
         ENDIF;

         IF MaxFeeders < Matrix[i].fl.Feeder.LastRow() THEN
            MaxFeeders = Matrix[i].fl.Feeder.LastRow();
         ENDIF;
         
      ENDFOR;
   ENDIF;
   
   /* set number of columns to max number of circuits in any matrix */
   Field(Matrix[*].sf.CircuitStatus).NumVisibleRows = MaxCircuits;
   Field(Matrix[*].fl.Feeder).NumVisibleRows = MaxFeeders;

   CurrentCircuit = 0;
   CurFrame.WindowWidth = CurFrame.TopForm.ChildFields[1].Width;
END;

ON ChildEntry Matrix = 
BEGIN
   i = 1;
   WHILE i <= Matrix.LastRow() DO
      Field(Matrix[i].Name).IsReverse = FALSE;
      i = i + 1;
   ENDWHILE;

   IF lowercase(CurFrame.TriggerField.FullName) = 'matrix[*].name' THEN
      m = Field(Matrix).CurRow;
      Field(Matrix[m].Name).IsReverse = TRUE;
      CurrentCircuit = 0;
      CurrentFeeder  = 0;
      MatrixSelected = TRUE;
   ELSE
      MatrixSelected = FALSE;
      IF lowercase(CurFrame.TriggerField.FullName) = 'matrix[*].fl.feeder[*].name' AND
         FromTFMS = FALSE THEN
         message 'You must call frame from TOMS to select a feeder.';
         CurrentCircuit = 0;
         CurrentFeeder  = 0;
         RESUME NEXT; /* put next so previous select gets unhighlighted */
      ELSEIF lowercase(CurFrame.TriggerField.FullName) = 'matrix[*].sf.circuitstatus[*].name' AND
         FromTC = FALSE THEN
         message 'You must call frame from Telephone Card to select a Circuit.';
         CurrentCircuit = 0;
         CurrentFeeder  = 0;
         RESUME NEXT; /* put next so previous select gets unhighlighted */
      ENDIF;
      IF FromTFMS = TRUE THEN
         CurrentFeeder = FormField(CurFrame.TriggerField).LayerSequence;
         CurrentCircuit = 0;
      ELSEIF FromTC = TRUE THEN
         CurrentCircuit = FormField(CurFrame.TriggerField).LayerSequence;
         CurrentFeeder = 0;
      ENDIF;
   ENDIF;
END;

ON Click Close_btn =
BEGIN
   RETURN;
END;

ON Click Load_btn =
BEGIN
   i = Field(Matrix).CurRow;
   IF i = 0 THEN
      message 'You must select an item to load.';
      RESUME;
   ENDIF;

   IF MatrixSelected = TRUE THEN  /* We will load matrix  */
       /* 
       **  M stands for Matrix #,  otherwise we load scada line
       */
       IF left(Matrix[i].Name,1) = 'M' THEN  
          RetCode = CALLFRAME RelayProtectionMatrix(CurrentGrouping = Matrix[i].Object);
          IF RetCode <> No$Value THEN
             RETURN(RetCode);
          ENDIF;
       ELSEIF left(Matrix[i].Name,1) = 'D' THEN 
          MatrixGrouping.Clear();
          IF Matrix[i].fl.Feeder.LastRow() <> 0 THEN
             FOR m = 1 TO Matrix[i].fl.Feeder.LastRow() DO
                MatrixGrouping[m].Value = Matrix[i].fl.Feeder[m].Object;
             ENDFOR;
          ELSEIF Matrix[i].sf.CircuitStatus.LastRow() <> 0 THEN
             FOR m = 1 TO Matrix[i].sf.CircuitStatus.LastRow() DO
                MatrixGrouping[m].Value = Matrix[i].sf.CircuitStatus[m].Object;
             ENDFOR;
          ENDIF;

          CALLFRAME RelayProtectionOverRide (FromTFMS = FromTFMS,
                                             CardObject = 0,
                                             Grouping = Matrix[i].Object, 
                                             ObjectList = MatrixGrouping.Duplicate());  

       ELSE
          CALLFRAME RelayScadaLines(CurrentCircuit = Matrix[i].Object);
       ENDIF;
   ELSE 
      IF CurrentCircuit <> 0 THEN     /* We will load circuit */
         LoadCard = 0;
         SELECT :LoadCard = C.Card
         FROM   TC_Card C
         WHERE  C.Circuit = :Matrix[i].sf.CircuitStatus[CurrentCircuit].Object AND
                C.Status IN (:TC_Card$Active,:Card$Telco,:Card$PST);
         IF LoadCard = 0 THEN
            /*
            **  See if circuit is on a grouper circuit card and load that instead.
            */
            SELECT :LoadCard = C.Card
            FROM   TC_Card C,
                   Udb_Grouping G,
                   Udb_ExtendedType ET
            WHERE  G.Member = :Matrix[i].sf.CircuitStatus[CurrentCircuit].Object AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.GroupingType = ET.Type AND
                   ET.SuperType = :Type$TelCardGrouper AND
                   G.Grouping = C.Circuit AND
                   C.Status IN (:TC_Card$Active,:Card$Telco,:Card$PST);
            IF LoadCard = 0 THEN
               message 'There are no Active/Telco/PST cards for this circuit.';
               RESUME;
            ENDIF;
         ENDIF;

         TC_CardGlobal = LoadCard;
         ParentFrame.SendUserEvent (EventName = 'loadcard');
         RETURN;

      ELSEIF CurrentFeeder <> 0 THEN  /* We will load feeder */
         LoadCard = 0;
         SELECT :LoadCard = Card
         FROM    SOA_ActiveObject
         WHERE   Object = :Matrix[i].fl.Feeder[CurrentFeeder].Object;
         IF LoadCard = 0 THEN
            message 'There are no active cards for this feeder.';
            RESUME;
         ELSE
            NewCard = LoadCard;
            ParentFrame.SendUserEvent (EventName = 'loadcard');
            RETURN;
         ENDIF;
      ELSE
         message 'No valid object is selected.';
      ENDIF;
   ENDIF;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            ProtectionMoveClearCheck

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          ProtectionMoveClearCheck
**
**  Date:       Author   Description
** ----------------------------------
**  11/02/98	EM       Based on previous versions.
**  05/26/00    em       Old reference to slc_archivejob changed
**  06/19/01    my       If the Protection Check is required and no protection
**                       moves have linked to the permit, the Warning/Overrid
**                       process will be trigged.
**  06/20/01    my       The warning message for a workpermit when all
**                       protection moves have not been cleared will contain
**                       a card reference to the card containing the linked
**                       protection move.
**  09/06/01    em       Complete Work Permit Protections Enhancement
**  11/05/02    pkw      Merge with FMS_OTWRestoreCheck
**  02/24/03    em       Remove PermitCard/PermitCardType - post-Merge
**  03/06/03    em       Closed card protection move check also needs to look
**                       at FMS_ArchiveJob
**  03/21/03    em       Modified structure of procedure.  Select all 
**                       protection links and review them individually, looking
**                       at active cards first.  This way we don't get
**                       a closed card warning if the protection move was
**                       and picked up again.
**  04/14/03    em       Protection Moves may have been archived on another/card
**                       item even if they still exist on an active card.  
**                       Don't present the "Closed card" warning if the move
**                       is still controlled by an active card.
**  11/13/03    ysp      FMS307: add check for protection moves in New/Drop Bank.
**  11/19/03    ysp      ITC143: pass switchingitem to the warning frame. 
**  02/10/05    em       Add an additional check at the bottom after not finding
**                       the move anymore including the dropped bank.
**                       If the move is a *fake* protection move, it must be grounded.
**                       This covers the situation where the fake move is added onto
**                       the card and then the equipment is grounded later in modifydb.
**  02/24/05    em       Excluded type from equipment name for last warning message
**  03/14/06    ysp      eliminate warning for protection move restored 
**                       when there is a duplicate linked protection move 
**                       that has been Takeout issued and so would satisfy the protection requirement.
**  09/25/06    em       When looking at restored moves, include filtered moves. 
**  03/16/07    ysp      Include protection moves with "NIS" status. 
**  03/27/07    em       Present message differently if an ISWP permit
**                       with Conditions.
**  04/10/07    ysp      ITC203: Remove Move$Filtered as a job status.
**  09/27/07    em       On Steam card, look at all moves in ShutOff and Depressurize steps
**  10/04/07    em       Added additional step heading to support SDS
**  02/01/08    em       Removed SDS ShutOff/Depressurize step check; allow normal protection
**                       move check to happen, although Steam UIDs default to No Protection Required
**  03/13/08    em       Handling of ISPConditions has changed.
**  12/08/08    em       ProtectionCard field should = 0 for SOA moves - should not be used when looking
**                       for restored protection move duplicate
**  06/15/09    em       Removed some REPEATED while trying to determine why protection move on closed
**                       card msg appears; exclude deleted moves from close card select to reduce
**                       warnings
**  07/14/09    em       Removed incorrect reference to MoveCategory attribute in FMS_ArchiveJob select
**  02/20/15    em       Add PrePost parameter for DSO which by default will be zero for all other cards.
**  03/20/17    em       If In-Service Equipment Permit, then don't count ISWP
**  09/15/23    em       Include Switching Item Title in Proection Move Restored warning (for ACDO email)
*/
PROCEDURE ProtectionMoveClearCheck
(
    Job 	= INTEGER NOT NULL;  /* Passed Job - Permit Move */ 
    Card        = INTEGER NOT NULL;  /* Passed Card - for Warning*/
    SwitchingItem = INTEGER NOT NULL WITH DEFAULT; /*Passed Item for warning*/

    i = INTEGER;                           /* scratch counter */
    w = INTEGER NOT NULL WITH DEFAULT;     /* scratch counter */
   
    DuplicateProtJob = INTEGER NOT NULL WITH DEFAULT;
    Equip = INTEGER NOT NULL WITH DEFAULT;
    JobClass = INTEGER NOT NULL WITH DEFAULT;
    Total = INTEGER;                 /* scratch counter */
    Online = INTEGER;                /* scratch counter */
    RetCode = INTEGER;               /* Return Code*/
    ProcRetCode = INTEGER NOT NULL;  /* Return Code */ 
    ProtectionRequired = INTEGER NOT NULL;
    InServicePermitEquip = INTEGER NOT NULL;
    Name = VARCHAR(200) NOT NULL WITH DEFAULT; 
    WPP = ARRAY OF WorkPermitProtection;   /* Protection moves for the permit */
    TOComplete = DATE;                       /* Select this Job field */
    RSIssued = DATE;                       /* Select this Job field */
    RSComplete = DATE;                     /* Select this Job field */
    MoveCategory = INTEGER NOT NULL;       /* New Field to evaluate */
    MsgText = VARCHAR(256) NOT NULL WITH DEFAULT; /* Build ISWP appropriate msg*/
    ISPermit = INTEGER NOT NULL WITH DEFAULT;  /*If it is an ISWP */
    ISPConditions = INTEGER NOT NULL WITH DEFAULT; /*Look for outstanding Conditions*/
    JCSwitchingItem = INTEGER NOT NULL WITH DEFAULT;  
    SwitchingItemTitle = VARCHAR(160) NOT NULL WITH DEFAULT;
) =
BEGIN
    ProcRetCode = PU_OK;
/*
** Do not need to do this check if permit does not require protection.
** Work permit move shouldn't be issued if the take-out side of
** a protection move has not been completed yet or if the restore side has
** been started.
** Look specifically at TLS if a TLS ProtectionMove
** Logic for each type of card:
**             Check if any are incomplete on the T/O side.
**                    Warning if true (No Protection).
**             Check if any have been complete on the R/S side.
**                    Warning if true (No Protection).
**             Check if any linked protection moves have been archived.
**     
*/
    ISPermit = 0;
    InServicePermitEquip = 0;
    ProtectionRequired = TRUE;
    IF CurrentApplication = Application$FMS THEN
       SELECT :ProtectionRequired = ProtectionRequired
       FROM   FMS_WorkPermit
       WHERE  PermitJobID = :Job;
    ELSE    /*IF CurrentApplication <> Application$SDS THEN */
       SELECT :ProtectionRequired = ProtectionRequired,
              :InServicePermitEquip = PhaseCheckIndicator
       FROM   SOA_WorkPermit
       WHERE  PermitJobId = :Job;

       IF InServicePermitEquip = 0 THEN 
          SELECT :ISPermit = ISPermit
          FROM   SOA_InServicePermit
          WHERE  Job = :Job;
   
          ISPConditions = 0;
          SELECT :ISPConditions = COUNT(*)
          FROM   SOA_ISPCondition
          WHERE  ISPermit = :ISPermit AND
                 TimeMet IS NULL;
       
          IF ISPConditions > 0 THEN
             MESSAGE 'Conditions have not been met to issue this In-Service Work Permit.  Conditions ' +
                  'must be checked off on the ISWP Summary screen.';
             RETURN (PU_CANCEL);
          ENDIF;
       ENDIF;
    ENDIF;
    CALLPROC DDB_ROLLBACK;

    IF ProtectionRequired = FALSE /*AND CurrentApplication <> Application$SDS*/ THEN
       RETURN(PU_OK);
    ENDIF; 
/*
** For Steam, look for outstanding moves in ShutOff and DePressurize steps
** Removed 02/01/08
*
    IF CurrentApplication = Application$SDS THEN  
       ProtectionRequired = 0;
       REPEATED
       SELECT :ProtectionRequired = COUNT(J.Job)
       FROM   SOA_Job J,
              SOA_JobControl JC
       WHERE  JC.Card = :Card AND
              JC.StepPair IN (:StepHeading$Deload, 
                              :StepPair$DeEnergize,
                              :StepHeading$ISO) AND /*Same as ShutOff/DePressurize*
              JC.Job = J.Job AND
              J.Status = '' AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.TOComplete IS NULL;

       IF ProtectionRequired > 0 THEN
                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'UID should not be issued until all Shut-Off and De-Pressurize moves are ' +
                               'complete.');
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   RETURN(Warning$Overridden);
                ENDIF;
       ELSE          
          RETURN(PU_OK);
       ENDIF;  
    ENDIF;
/*
** Load the list of protection moves
*/      
    w = 1;
    WPP.Clear();
    SELECT :WPP[w].ProtectionCard = WPP.ProtectionCard,
           :WPP[w].ProtectionCardType = WPP.ProtectionCardType,
           :WPP[w].ProtectionJobID = WPP.ProtectionJobID
    FROM   FMS_WorkPermitProtection WPP
    WHERE  WPP.PermitCardType = 0
      AND  WPP.PermitCard = 0
      AND  WPP.PermitJobID= :Job
      AND  WPP.PrePost = 0
    BEGIN
       w = w + 1;
    END;          
    CALLPROC DDB_ROLLBACK;
/*
** If the protection check is required and no protection moves have linked
** to the permit, show the warning message.
*/
    IF WPP.LastRow() = 0 THEN
        RetCode = CALLFRAME Notice(Card = Card, 
                                   Job = Job,
                                   SwitchingItem = SwitchingItem,
                    TEXT = 'This Permit requires protection but no ' +
                              'Protection Moves have been linked to the ' +
                              'permit.');
        RETURN(PU_CANCEL);

        /*
        RetCode = CALLFRAME Warning(Card = Card, Job = Job,
                                    SwitchingItem = SwitchingItem,
                    TEXT = 'This Permit requires protection but no ' +
                              'Protection Moves have been linked to the ' +
                              'permit.');
        IF RetCode = PU_CANCEL THEN
           RETURN(PU_CANCEL);
        ELSE
           ProcRetCode = Warning$Overridden;
        ENDIF;
        */
    ENDIF;

    FOR w = 1 TO WPP.LastRow() DO           
/*
** Work permit move shouldn't be issued if the take-out side of
** a protection move has not been completed yet.
*/
/*
** Check if on TLS
*/
       IF WPP[w].ProtectionCardType = Type$TLSApp THEN

          /* check to complete */
          Name = '';
          REPEATED
          SELECT :Name = C.LineNumber
          FROM   TC_Job J,
                 TC_Card C
          WHERE  C.Card = :WPP[w].PermitCard
            AND  C.Status < 4
            AND  C.Card = J.Card
            AND  J.Job = :WPP[w].PermitJobID
            AND  J.Status = '' 
            AND  J.TOComplete IS NULL;
      
          IF Name <> '' THEN
             RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                       Text = 'TLS Protection moves have not been completed' +
                              ' on Card: ' + Name);
             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                ProcRetCode = Warning$Overridden;
             ENDIF;
             CONTINUE;
          ENDIF;

          /* check restore */
          Name = '';
          REPEATED
          SELECT :Name = C.LineNumber
          FROM   TC_Job J,
                 TC_Card C,
                 FMS_WorkPermitProtection WPP
          WHERE  C.Card = :WPP[w].PermitCard     
            AND  C.Status < 4
            AND  C.Card = J.Card
            AND  J.Job = :WPP[w].PermitJobID
            AND  J.Status = '' 
            AND  ((J.RSComplete IS NOT NULL 
               AND J.RSComplete <> '') 
               OR (J.RSIssued IS NOT NULL 
               AND J.RSIssued <> ''));
      
          IF Name <> '' THEN
             RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'TLS protection moves have been restored' +
                               ' on Card: ' + Name);
             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                ProcRetCode = Warning$Overridden;
             ENDIF;
             CONTINUE;
          ENDIF;

          i = 0;
          SELECT :i = J.Job
          FROM   TC_ArchiveJob J
          WHERE  J.Job = :WPP[w].PermitJobID
            AND  J.Status = ''; 

          IF i <> 0 THEN
             RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                       Text = 'A TLS protection moves is on a Closed' +
                              ' Card.');

             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                ProcRetCode = Warning$Overridden;
             ENDIF;
             CONTINUE;
          ENDIF;

       ELSE
/*
** Not TLS, look at SOA
*/       
          Name = '';
          Equip = 0;
          JobClass = 0;
          TOComplete = NULL;
          RSIssued = NULL;
          RSComplete = NULL;
          SwitchingItem = 0;
    
          REPEATED
          SELECT :Name = AC.Application + ' ' + AC.CardName,
                 :TOComplete = J.TOComplete,
                 :RSIssued = J.RSIssued,
                 :RSComplete = J.RSComplete,
                 :Equip = J.Equip,    
                 :JobClass = J.JobClass,
                 :JCSwitchingItem = JC.SwitchingItem
          FROM   SOA_Job J,
                 SOA_JobControl JC,
                 SOA_ActiveCard AC
          WHERE  J.Job = :WPP[w].ProtectionJobID
            AND  J.Status IN ('', :JobStatus$NIS)
            AND  J.MoveCategory = :MoveCategory$Normal 
            AND  J.ControlCard = AC.Card 
            AND  J.SwItemStatus < :Card$Closed
            AND  JC.Job = J.Job 
            AND  JC.Card = AC.Card;
    
          IF Name <> '' THEN
/*
** Add the SwitchingItemTitle if it exists.
*/
             IF JCSwitchingItem <> 0 THEN
                SwitchingItemTitle = '';
                SELECT :SwitchingItemTitle = TOMove
                FROM   SOA_Job
                WHERE  Job = :JCSwitchingItem;

                Name = SQUEEZE(Name + ' ' + SwitchingItemTitle);
             ENDIF;           
/*
** Has this move been Taken Out? Custom message for ISWP
*/    
             IF ISPermit = 0 THEN
                MsgText =  'Permit Protection Move has not been completed ' +
                           'on card: ' + Name + '.';
             ELSE
                MsgText = 'In-Service Work Permit Condition has not been ' +
                          'satisfied.';
             ENDIF; 

             IF TOComplete IS NULL THEN

                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                         Job = Job,
                         SwitchingItem = SwitchingItem,
                         Text = MsgText);
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   ProcRetCode = Warning$Overridden;
                ENDIF;            
/*
** Has this move been Restored?
*/       
             ELSEIF  (RSComplete IS NOT NULL AND RSComplete <> '') OR 
                     (RSIssued IS NOT NULL AND RSIssued <> '') THEN
                /*
                ** eliminate warning for protection move restored 
                ** when there is a duplicate linked protection move 
                ** that has been Takeout issued and so would satisfy the protection requirement.
                */ 

                IF Equip <> 0 THEN
                   DuplicateProtJob = 0;

                   REPEATED
                   SELECT :DuplicateProtJob = J.Job
                   FROM   SOA_Job J,
                          FMS_WorkPermitProtection WPP
                   WHERE  J.Equip = :Equip 
                     AND  J.JobClass = :JobClass
                     AND  J.TOComplete IS NOT NULL
                     AND  J.TOComplete <> ''
                     AND  J.RSIssued IS NULL 
                     AND  J.RSComplete IS NULL
                     AND  J.Status IN ('', :JobStatus$NIS)
                     AND  J.MoveCategory = :MoveCategory$Normal 
                     AND  J.SwItemStatus < :Card$Closed
                     AND  J.Job <> :WPP[w].ProtectionJobID
                     AND  J.Job = WPP.ProtectionJobID 
                     AND  WPP.PermitJobID= :Job;

                   IF DuplicateProtJob > 0 THEN
                      CONTINUE;
                   ENDIF;
                ENDIF;

                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'Permit Protection Move has already been ' +
                               'restored on card: ' + Name);
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   ProcRetCode = Warning$Overridden;
                ENDIF;

             ENDIF;
/* 
** If the move was controlled on an active card, we are done checking.
*/                             
             CONTINUE;    
          ENDIF;

         /* check for archived SLC/TFMS*/
          i = 0;
          SELECT :i = J.Job
          FROM   SOA_ArchiveJob J
          WHERE  J.Job = :WPP[w].ProtectionJobID  
            AND  J.Status IN ('', :JobStatus$NIS)
            AND  J.MoveCategory = :MoveCategory$Normal 
            AND (J.TOComplete IS NULL OR J.TOComplete = '');
       
          IF i > 0 THEN
             RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'A Permit Protection Move is on a closed ' +
                               'SLC Item or a closed TFMS card.');
             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                ProcRetCode = Warning$Overridden;
             ENDIF;
             CONTINUE;
          ENDIF;

         /* check for archived FMS*/
          i = 0;
          SELECT :i = J.Job
          FROM   FMS_ArchiveJob J
          WHERE  J.Job = :WPP[w].ProtectionJobID 
            AND  J.Status IN ('', :JobStatus$NIS)
            AND (J.TOComplete IS NULL OR J.TOComplete = '');
      
          IF i > 0 THEN
             RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'A Permit Protection Move is on a closed ' +
                               'FMS card.');
             IF RetCode = PU_CANCEL THEN
                RETURN(PU_CANCEL);
             ELSE
                ProcRetCode = Warning$Overridden;
             ENDIF;
             CONTINUE;
          ENDIF;
          
          /* check for protection moves in New/Drop Bank */
          Name = '';
          TOComplete = NULL;
          RSIssued = NULL;
          RSComplete = NULL;
    
          REPEATED
          SELECT :Name = J.EquipName,
                 :TOComplete = J.TOComplete,
                 :RSIssued = J.RSIssued,
                 :RSComplete = J.RSComplete    
          FROM   SOA_Job J,
                 FMS_DroppedEquipJobs D
          WHERE  D.Job = :WPP[w].ProtectionJobID
            AND  J.Job = :WPP[w].ProtectionJobID
            AND  J.Status IN ('', 'NIS')
            AND  J.MoveCategory = :MoveCategory$Normal
            AND  J.SwItemStatus < :Card$Closed;
    
          IF Name <> '' THEN
             /* Has this move been Taken Out? */       
             IF TOComplete IS NULL THEN

                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                         Job = Job,
                         SwitchingItem = SwitchingItem,
                         Text = 'Permit Protection Move in Job Bank for ' + Name + 
                                ' has not been completed.');
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   ProcRetCode = Warning$Overridden;
                ENDIF;            
                
                /* Has this move been Restored? */       
             ELSEIF  (RSComplete IS NOT NULL AND RSComplete <> '') OR 
                     (RSIssued IS NOT NULL AND RSIssued <> '') THEN

                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'Permit Protection Move in Job Bank for ' + Name + 
                                ' has already been restored.');
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   ProcRetCode = Warning$Overridden;
                ENDIF;
             ENDIF;
             CONTINUE;
          ENDIF;
/*
**  Check for fake move, equip must be grounded if we reach this check.
*/
          MoveCategory = 0;
          Equip = 0;
          Name = '';
          SELECT  :MoveCategory = MoveCategory,
                  :Name = EquipName,
                  :Equip = Equip
          FROM    SOA_Job
          WHERE   Job = :WPP[w].ProtectionJobID;
 
          IF MoveCategory = MoveCategory$Fake THEN

             i = 0; 
             SELECT :i = StatusCount
             FROM   FMS_ObjectStatus 
             WHERE  Object = :Equip AND
                    StatusCount > 0 AND
                    Status = :Status$Ground;

             IF i = 0 THEN
                RetCode  = CALLFRAME Warning 
                        (Card = Card, 
                        Job = Job,
                        SwitchingItem = SwitchingItem,
                        Text = 'Protective Ground for device ' + Name + 
                               ' is missing.');
                IF RetCode = PU_CANCEL THEN
                   RETURN(PU_CANCEL);
                ELSE
                   ProcRetCode = Warning$Overridden;
                ENDIF;
 
             ENDIF;
             CONTINUE;
          ENDIF;          
       ENDIF;
    ENDFOR;

    RETURN (ProcRetCode);
END;




Application Component Report
============================

	Name:            ProvideFeederkV

/*
**
**	Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptResponse
**
**  01/18/93  mts   Frame created             
*/

INITIALIZE
(
    Feeder = Varchar(40) NOT NULL WITH DEFAULT;  /* Holds the feeder name */
) =

    BEGIN
        TextField = 'Feeder ' + Feeder + ' does not have a ' +
                    'feeder kV rating "Rated As" grouping set up in the ' +
                    'database.  Please enter a kv rating here to continue ' +
                    'with the current test:';
    END;

ON CLICK OK_BTN =
    BEGIN
        RETURN(FeederKv);
    END;

ON WINDOWCLOSE = 
    BEGIN
        RESUME;
    END;

Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;

Application Component Report
============================

	Name:            PU_Equip

/*
**
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation.
**
**  Application:    FeederCard
**  Frame:          PickupDropEquipment
**
**  Date:           Version  Description
** --------------------------------------------------
**  01/23/95        pkw      created so that equipment is picked up one piece 
**                           at a time to prevent locking
**  04/03/95        pkw      split fms_pickupequip into three procedures
**  08/10/95        em       if macroequip, don't need to attach to feeder.
**  12/13/96        em       Call FMS_ManageCardHeader if equip is grounded
**  08/29/02        ysp      Merge: Use Job class' InsertControl method to 
**                           pick up dropped jobs and a new db procedure
**                           FMS_UpdateEquipJobs to update these jobs.
**  03/17/03        em       Need to handle dropped equipjobs separately from
**                           NewMove jobs.  Rewrite FMS_UpdateEquipJobs DB
**                           Procedure.  Preserved Type not properly being
**                           used to reset the equip member type to feeder.
**  03/31/03        em       SELECT DISTINCT on pickup Jobs
**  01/16/04        ysp      Pass Ground Count to FMS_PickupJob procedure when
**                           replacing other N moves.
**  08/20/10        em       Add FeederObj parm for 3G
**  03/05/13        pkw      Add calls to FMS_DeadMoveCount so that count is 
**                           updated when picking up equipment.
**  12/26/13        em       addressing Mike Sannito problem when move was
**                           inserted on SLC card and linked to FMS work Permit then picked
**                           up on feeder.
**  01/16/14        em       Set controlcard for the Picked Up equipment to current card.
**  01/21/15        em       Implementing logic for feeder position established from SLC
**  03/16/15        em       Ground count needs to be reselected after calling PromptFeederSideGround
**  05/24/16        em       Trying to eliminate duplicate "Picked Up" response
*/
PROCEDURE PU_Equip
(   C = FMS_Card; /* parameter - current card */ 
    MacroEquipFlag = INTEGER NOT NULL WITH DEFAULT;
    SelectedEquip = FMS_Equip;
    FeederObj = INTEGER NOT NULL WITH DEFAULT;

    i = integer NOT NULL WITH DEFAULT;	    /* Temporary counter */ 
    RowExists = INTEGER NOT NULL WITH DEFAULT;
    EquipCnt = integer not null;
    status = integer;   /* return status variable */ 
    GroundCount = integer not null;   /* return status variable */ 
    GroundFeederSide = integer not null;    
    GroundSet = DATE;
    MoveCount = integer not null;   /* return status variable */ 
    InsertedJob = INTEGER NOT NULL WITH DEFAULT;
    Division = INTEGER NOT NULL;
    InService = DATE;
    OutService = DATE;
    DropJobs = ARRAY OF JOB;
    JIP = JobInProgress;
    ControlEntry = NewMoveCard;
    RetCode = INTEGER;   /*NULLABLE Return Code */
) = 
BEGIN 
/*
**  Tack on a space if only one character entered.
**  Need to do this to maintain sort order.  If they choose not 
**  to enter one - FINE.
*/ 
   IF (Length(SelectedEquip.PrintID) = 1) THEN
         SelectedEquip.PrintID = ' ' + SelectedEquip.PrintID;
   ENDIF;
/*
**  Select inservice,outservice,division for equipment so that if
**  picking up jobs for equipment fails we can put equipment back
**  in the right new or dropped bank
*/
   REPEATED
   SELECT :InService = O.InService,
          :OutService = O.OutService,
          :Division = O.PrimaryGrouping
   FROM   Udb_Object O
   WHERE  O.Object = :SelectedEquip.Equip;
   CALLPROC DDB_ROLLBACK;
/*
**  Set Equip InService and group equipment to feeder
*/ 
   IF MacroEquipFlag = FALSE THEN 
/*
** See if a preserved type has been saved.  Use it if it exists.
*/
      RowExists = 0;
      SELECT :RowExists = MemberType
      FROM   FMS_PreservedType
      WHERE  Feeder = :FeederObj AND
             Equip = :SelectedEquip.Equip; 

      IF RowExists <> 0 THEN
         SelectedEquip.EquipClass = RowExists;
      ENDIF;
     
      status = CALLPROC FMS_PickupEquip 
                       (Feeder = FeederObj,	
            	        CurrentTime = date('now'),  
            	        Equip = SelectedEquip.Equip, 
                        Reference = SelectedEquip.PrintID, 
                        Relation = Interaction$MemberOf,
                        EquipClass = SelectedEquip.EquipClass
                       ); 
      IF (status < 0) THEN 
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'Error picking up equipment.';
             RETURN (PU_CANCEL);
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
**  Pickup any jobs that are associated with Equipment
*/
   MoveCount = 1;
   DropJobs.Clear();

   REPEATED
   SELECT DISTINCT
         :DropJobs[MoveCount].Job = J.Job, 
         :DropJobs[MoveCount].Status = J.Status,
         :DropJobs[MoveCount].JobClass = J.JobClass,
         :DropJobs[MoveCount].Equip = J.Equip,
         :DropJobs[MoveCount].EquipClass = J.EquipClass,  
         :DropJobs[MoveCount].EquipClassName = J.EquipClassName,
         :DropJobs[MoveCount].MoveEquipClass = JC.EquipClass,   
         :DropJobs[MoveCount].EquipName = J.EquipName,
         :DropJobs[MoveCount].StepPair = JC.StepPair,
         :DropJobs[MoveCount].Grounds = J.Grounds,
         :DropJobs[MoveCount].MoveType = J.MoveType,
         :DropJobs[MoveCount].TOMove = J.TOMove,
         :DropJobs[MoveCount].TOOperator = J.TOOperator,
         :DropJobs[MoveCount].TOIssued = J.TOIssued,
         :DropJobs[MoveCount].TOComplete = J.TOComplete,
         :DropJobs[MoveCount].GroundOn = J.GroundOn,
         :DropJobs[MoveCount].RSMove = J.RSMove,
         :DropJobs[MoveCount].RSOperator = J.RSOperator,
         :DropJobs[MoveCount].RSIssued = J.RSIssued,
         :DropJobs[MoveCount].RSComplete = J.RSComplete,
         :DropJobs[MoveCount].TOMoveRules = J.TOMoveRules,
         :DropJobs[MoveCount].RSMoveRules = J.RSMoveRules,
         :DropJobs[MoveCount].Response = J.Response,
         :DropJobs[MoveCount].MoveFGColor = J.MoveFGColor,
         :DropJobs[MoveCount].MoveBGColor = J.MoveBGColor,
         :DropJobs[MoveCount].ControlCard = J.ControlCard,
         :DropJobs[MoveCount].Substation = J.Substation,
         :DropJobs[MoveCount].MoveCategory = J.MoveCategory,
         :DropJobs[MoveCount].ActivityIdentifier = J.ActivityIdentifier
   FROM   FMS_DroppedEquipJobs DJ,
          SOA_Job J,
          FMS_JobClassControl JC
   WHERE  DJ.Equip = :SelectedEquip.Equip AND
          DJ.Job = J.Job AND
          J.JobClass = JC.JobClass AND
          JC.TypeOfCard = :C.TypeOfCard AND
          JC.EquipClass IN (
                    SELECT SuperType
                    FROM   Udb_ExtendedType 
                    WHERE  Type = :SelectedEquip.EquipClass) 
   BEGIN
      IF MoveCount > 1 THEN
         IF DropJobs[MoveCount].Job = DropJobs[MoveCount-1].Job THEN
            DropJobs.RemoveRow (RowNumber = MoveCount);
            MoveCount = MoveCount - 1;
         ENDIF;
      ENDIF;
      MoveCount = MoveCount + 1;
   END;
/*
** Get equipment's ground count
*/
   GroundCount = 0;
   GroundSet = NULL;
   SELECT :GroundCount = StatusCount,
          :GroundSet = TimeSet
   FROM   FMS_ObjectStatus
   WHERE  Object = :SelectedEquip.Equip AND
          Status = :Status$Ground;

   IF MoveCount > 1 THEN         
      /* pickup jobs from the drop bank */
      i = 1;
      WHILE i <= DropJobs.LastRow() DO
         ControlEntry.Card = C.Card;
         ControlEntry.Seq = 0;
         ControlEntry.SwitchingItem = 0;
         ControlEntry.Application = Application$FMS;
         ControlEntry.StepHeading = DropJobs[i].StepPair;
         ControlEntry.TypeOfCard = C.TypeOfCard;
         ControlEntry.MoveEquipClass = DropJobs[i].MoveEquipClass;
         ControlEntry.StepLevel = 0;
         ControlEntry.PrintID = SelectedEquip.PrintID;

         status = DropJobs[i].InsertControl (
                    ControlEntry = ControlEntry,
                    InitiatingCard = C.Card);

         IF status = PU_CANCEL THEN
            MESSAGE 'Procedure:PU_Equip; Error inserting control entry for ' +
                    'job of equipment: ' + SelectedEquip.PrintID + ' ' +
                     SelectedEquip.EquipClassName + ' ' + 
                     SelectedEquip.EquipName + '  ' +
                     DropJobs[i].TOMove + ' into the current card.';

            status = CALLPROC FMS_RestoreService 
               (Inservice = InService,
                OutService = OutService,
                Division = Division,
                Feeder = FeederObj,	
                Equip = SelectedEquip.Equip, 
                Relation = Interaction$MemberOf
               ); 
            IF (status < 0) THEN 
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Error picking up moves for equipment.  Equipment is ' + 
                    'on feeder,  but moves were not picked up properly.  ' +
                    'Please contact technical support.';
               RETURN (PU_CANCEL);
            ENDIF;
            CALLPROC DDB_COMMIT;

            MESSAGE 'Error picking up equipment.';
            RETURN (PU_CANCEL);

         ELSE
            /*
            ** If an "N" move exists on this feeder for this equipment and jobclass, delete it now.
            ** Also Transfer Work Permit Protections.
            */
            RowExists = 0;
            REPEATED
            SELECT :RowExists = J.Job
            FROM   SOA_JobControl JC,
                   SOA_Job J
            WHERE  JC.Card = :C.Card AND
                   JC.Job = J.Job AND
                   J.Status <> 'Del' AND
                   J.Equip = :SelectedEquip.Equip AND
                   J.JobClass = :DropJobs[i].JobClass AND
                   J.MoveCategory = :MoveCategory$Fake;

            status = CALLPROC FMS_PickupJob                       
                       (Job = DropJobs[i].Job,
                        ReplacedJob = RowExists,
                        Card = C.Card,
                        GroundCount = GroundCount);

            IF status < 0 THEN 
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Error updating picked-up moves for equipment.  Equipment is ' + 
                    'on feeder, Moves were picked up, but were not updated properly.  ' +
                    'Please contact technical support.';
               RETURN (PU_CANCEL);
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF; 
            
            IF CurrentApplication = Application$FMS AND
               lowercase(DropJobs[i].MoveType) = 'dead' THEN
          
               RetCode = CALLPROC FMS_DeadMoveCount (
                           Card = C.Card);
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
                      'WARNING: Unable to confirm dead move count on top of card is correct ' +
                      'after picking up equipment.' +
                      'Please confirm value is correct.',
                              TraceMessage =
                      'PU_Equip; ' +
                      'Unable to update dead move count on Card=' +
                      VARCHAR(C.Card) + '.' 
                      );
               ENDIF;
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
         i = i + 1;
      ENDWHILE;
   ENDIF;
/*
**   Check to see if there are any other N moves on the current Card. 
**   If there are, we insert a new version and get rid of the old.
*/
   DropJobs.Clear();     /* Clear out storage */
   i = 1;
   REPEATED
   SELECT DISTINCT
            :DropJobs[i].JobClass = J.JobClass,
            :DropJobs[i].Job = J.Job,
            :DropJobs[i].Card = JC.Card,
            :DropJobs[i].Equip = J.Equip,
            :DropJobs[i].EquipName = J.EquipName,
            :DropJobs[i].EquipClass = J.EquipClass,
            :DropJobs[i].EquipClassName = J.EquipClassName,
            :DropJobs[i].TOMove = J.TOMove,
            :DropJobs[i].TOOperator = J.TOOperator,
            :DropJobs[i].TOIssued = J.TOIssued,
            :DropJobs[i].TOComplete = J.TOComplete,
            :DropJobs[i].RSIssued = J.RSIssued,
            :DropJobs[i].RSComplete = J.RSComplete,
            :DropJobs[i].RSOperator = J.RSOperator,
            :DropJobs[i].MoveType = J.MoveType,
            :DropJobs[i].RSMove = J.RSMove,
            :DropJobs[i].TOMoveRules = J.TOMoveRules,
            :DropJobs[i].RSMoveRules = J.RSMoveRules,
            :DropJobs[i].Grounds = J.Grounds,
            :DropJobs[i].GroundOn = J.GroundOn,
            :DropJobs[i].MoveFGColor = J.MoveFGColor,
            :DropJobs[i].StepPair = JC.StepPair,
            :DropJobs[i].Substation = J.Substation,
            :DropJobs[i].MoveEquipClass = JC.MoveEquipClass
   FROM    SOA_Job J,
           SOA_JobControl JC
   WHERE   JC.Card = :C.Card AND
           JC.Job = J.Job AND
           J.Equip = :SelectedEquip.Equip AND
           J.MoveCategory = :MoveCategory$Fake AND
           J.Status <> 'Del' 
   BEGIN
/* 
** Reset blanks to NULLs
*/
        IF DropJobs[i].RSComplete = '' THEN
           DropJobs[i].RSComplete = NULL;
        ENDIF;
        IF DropJobs[i].RSIssued = '' THEN
           DropJobs[i].RSIssued = NULL;
           DropJobs[i].RSOperator = NULL;
        ENDIF;
        IF DropJobs[i].TOComplete = '' THEN
           DropJobs[i].TOComplete = NULL;
        ENDIF;
        IF DropJobs[i].TOIssued = '' THEN
           DropJobs[i].TOIssued = NULL;
           DropJobs[i].TOOperator = NULL;
        ENDIF;
        i = i + 1;
   END;

   FOR i = 1 TO DropJobs.LastRow() DO

          DropJobs[i].PrintID = SelectedEquip.PrintID;
/*          DropJobs[i].GroundOn = NULL; */
          DropJobs[i].MoveCategory = MoveCategory$Normal;  
          DropJobs[i].ActivityIdentifier = '';
/*
** Check for active version of move on TOMS, if it exists insert control entry
** otherwise insert whole move.
*/
          RowExists = DropJobs[i].Job;  /* Save old Job ID */
          InsertedJob = 0;
          JIP  = NULL;
          JIP = JobInProgress.Create();
          REPEATED
          SELECT :InsertedJob = J.Job,
                 :JIP.JobClass = J.JobClass,
                 :JIP.Equip = J.Equip,
                 :JIP.EquipClass = J.EquipClass,
                 :JIP.TOComplete = J.TOComplete,
                 :JIP.RSComplete  = J.RSComplete,
                 :JIP.Grounds = J.Grounds,
                 :JIP.Job = J.Job 
          FROM    SOA_Job J,
                  SOA_JobControl JC,
                  SOA_ActiveCard AC
          WHERE   J.JobClass = :DropJobs[i].JobClass AND
                  J.Equip = :DropJobs[i].Equip AND
                  J.Status IN ('',:JobStatus$NIS) AND
                  J.MoveCategory = :MoveCategory$Normal AND
                 (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
                  J.Job <> :DropJobs[i].Job AND
                  J.Job = JC.Job AND
                  JC.Card <> :DropJobs[i].Card AND
                  JC.Card = AC.Card;
          
          IF InsertedJob <> 0 THEN
             DropJobs[i].Job = InsertedJob;
             ControlEntry.Card = C.Card;
             ControlEntry.Seq = 0;
             ControlEntry.SwitchingItem = 0;
             ControlEntry.Application = Application$FMS;
             ControlEntry.StepHeading = DropJobs[i].StepPair;
             ControlEntry.TypeOfCard = C.TypeOfCard;
             ControlEntry.MoveEquipClass = DropJobs[i].MoveEquipClass;
             ControlEntry.StepLevel = 0;
             ControlEntry.PrintID = SelectedEquip.PrintID;

             status = DropJobs[i].InsertControl (
                    ControlEntry = ControlEntry,
                    InitiatingCard = C.Card);

             IF status = PU_CANCEL THEN
                MESSAGE 'Procedure:PU_Equip; Error inserting control entry for ' +
                    'job of equipment: ' + SelectedEquip.PrintID + ' ' +
                     DropJobs[i].EquipClassName + ' ' + 
                     DropJobs[i].EquipName + '  ' +
                     DropJobs[i].TOMove + ' into the current card.';
             ELSE
                CALLPROC DDB_COMMIT;
/*
** Look for Prompt Set Ground Feeder Side
*/              
                IF JIP.Grounds IS NULL AND 
                    JIP.TOComplete IS NOT NULL AND 
                    JIP.RSComplete IS NULL THEN
                       
                   JIP.ToRs = Job$TakeOutInt;
                   GroundFeederSide = 0;
                   SELECT :GroundFeederSide = JobClass
                   FROM   FMS_JobAction JA,
                          Udb_ExtendedType ET
                   WHERE  JA.Status = :Prompt$SetGroundFeederSide AND
                          JA.Action = :JobAction$Prompt AND 
                          JA.JobClass = :JIP.JobClass AND
                          JA.EquipClass = ET.SuperType AND
                          ET.Type = :JIP.EquipClass AND
                          JA.TypeOfCard = :C.TypeofCard AND
                          JA.StepPair = :DropJobs[i].StepPair AND
                          JA.TORS = :JIP.ToRs;

                   IF GroundFeederSide > 0 THEN
                      status = CALLFRAME PromptSetGroundFeederSide (JIP = JIP);
                      IF status = PU_CANCEL THEN
                         MESSAGE 'Procedure:PU_Equip; Error setting Ground status ' +
                            'for equipment: ' + SelectedEquip.PrintID + ' ' +
                             DropJobs[i].EquipClassName + ' ' + 
                             DropJobs[i].EquipName + '.';
                      ENDIF;
                      SELECT :GroundCount = StatusCount,
                             :GroundSet = TimeSet
                      FROM   FMS_ObjectStatus
                      WHERE  Object = :JIP.Equip AND
                             Status = :Status$Ground;
                   ENDIF;
                ENDIF;
             ENDIF;
          ELSE
             RetCode = CALLPROC InsertJobsRow
                   (C = C, NewJob = DropJobs[i], 
                    ByPassDuplicateMessage = TRUE);
 
             IF RetCode IS NULL THEN
                CALLPROC DDB_ROLLBACK;
                message 'Could not insert N move replacement:  ' +
                        DropJobs[i].TOMove +
                        '  into current card.';
                RESUME;
             ELSE
                CALLPROC DDB_COMMIT;
             ENDIF;
             InsertedJob = IFNULL(RetCode,0);
          ENDIF;

          status = CALLPROC FMS_PickupJob                       
                          (Job = InsertedJob,
                           ReplacedJob = RowExists,
                           Card = C.Card,
                           GroundCount = GroundCount);

          IF status < 0 THEN 
                 CALLPROC DDB_ROLLBACK;
                 MESSAGE 'Error replacing N moves for equipment.  Equipment is ' + 
                      'on feeder, Moves were picked up, but were not updated properly.  ' +
                      'Please contact technical support.';
                 RETURN (PU_CANCEL);
          ELSE
                 CALLPROC DDB_COMMIT;
          ENDIF;   
          IF CurrentApplication = Application$FMS AND
             lowercase(DropJobs[i].MoveType) = 'dead' THEN
        
             RetCode = CALLPROC FMS_DeadMoveCount (
                         Card = C.Card);
             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                CALLPROC TraceError (UserMessage = 
                    'WARNING: Unable to confirm dead move count on top of card is correct ' +
                    'after picking up equipment.' +
                    'Please confirm value is correct.',
                            TraceMessage =
                    'PU_Equip; ' +
                    'Unable to update dead move count on Card=' +
                    VARCHAR(C.Card) + '.' 
                    );
             ENDIF;
             CALLPROC DDB_COMMIT;
          ENDIF;
   ENDFOR;
/*
** Update card header if equipment is grounded
*/
   IF GroundCount > 0 THEN
      CALLPROC FMS_ManageCardHeader (Equip = SelectedEquip.Equip);
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** Set Control Card for all moves where this equip appears.
*/
   RetCode = CALLPROC SOA_TransferEquipControl (
                                 Equip = SelectedEquip.Equip,
                                 ControlCard = C.Card);
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
                    'WARNING: Unable to set proper card control for all moves on this equipment.  ' +
                    'Please confirm shared equipment moves have proper card control.',
                           TraceMessage =
                    'PU_Equip; ' +
                    'Unable to update card control for Equipment=' + VARCHAR(SelectedEquip.Equip) +
                    ' on Card=' + VARCHAR(C.Card) + '.' 
                    );
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   FCFrame.SendUserEvent (EventName = 'load_jobs');

  /* Log the picking up of equipment */
   CALLPROC SOA_LogIns
                ( Card = C.Card,
                  Job  = NULL,
                  Time = Date('now'),
                  UserName = UserName,
                  Item = 'PickUp Equip',
                  Old  = SelectedEquip.PrintID + '  ' +
                         SelectedEquip.EquipName + '  ' +
                         SelectedEquip.EquipClassName,
                  New  = '');
   CALLPROC DDB_COMMIT;

   RETURN (PU_OK);
END;

