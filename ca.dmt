/*
** Remove prefix "M[H-. ]" etc. from the manhole name. Assuming a structure name is 
** a prefix plus a numeric string. Ignore trailing characters.
*/
PROCEDURE ExtractRFPLocNumber(
   NameString = VARCHAR(20) NOT NULL WITH DEFAULT;
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   NumFound = INTEGER NOT NULL WITH DEFAULT;
   NameLength = INTEGER NOT NULL WITH DEFAULT;
   NameNumOnly = VARCHAR(20) NOT NULL WITH DEFAULT;
   SingleChar = CHAR(1) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   NumFound = FALSE;
   NameNumOnly = '';
   NameLength = LENGTH(NameString);
   i = 1;
   WHILE i <= NameLength DO
      SingleChar = CHAREXTRACT(NameString, i);
      IF SingleChar >= '1' AND SingleChar <= '9' AND NumFound = FALSE THEN
         NameNumOnly = SingleChar;
         NumFound = TRUE;
      ELSEIF SingleChar >= '0' AND SingleChar <= '9' AND NumFound = TRUE THEN
         NameNumOnly = NameNumOnly + SingleChar;
      ELSEIF NumFound = TRUE THEN /*Reached the end of consecutive numerics*/
         ENDLOOP;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   RETURN NameNumOnly;
END;





