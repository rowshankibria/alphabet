**  Class:          OSWPAttachment
**
**  Date:       Version Description
** ----------------------------------
**  01/08/09    ysp     Prototype 2
**  07/17/09    em      Updated terminology to OSWP
**  06/30/10    ysp     comment out dbevent to Task Monitor
*/
METHOD DeleteAttachment (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
  
   SELECT :FileName = FileName
   FROM   SOA_OSWPAttachment 
   WHERE  PermitJobID = :CurObject.PermitJobID AND
          FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;

   RetCode = CALLPROC SOA_OSWPAttachmentDel (
           PermitJobID = CurObject.PermitJobID,
           FileID = CurObject.FileID
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPAttachment.DeleteAttachment; Error deleting OSWP Request attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPAttachment.DeleteAttachment; ' + 
                'Error deleting OSWP Request attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
    EventText = VARCHAR(CurObject.PermitJobID) + ';' + FileName;
    CALLPROC InsertDBEventQueue(
                     ToApp = 'TASK',
                     EventName = 'FMS_DeleteOSWPFile',
                     EventText = EventText);
*/
    RETURN;
END;

METHOD InsertAttachment (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SaveDate = DATE NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 0;
   SELECT :i = IFNULL(max(FileID), 0)
   FROM   SOA_OSWPAttachment
   WHERE  PermitJobID = :CurObject.PermitJobID;

   CurObject.FileID = i + 1;

   RetCode = CALLPROC SOA_OSWPAttachmentIns(
           PermitJobID = CurObject.PermitJobID,
           FileID = CurObject.FileID,
           FileName = VARCHAR(CurObject.PermitJobID) + '_' + SQUEEZE(CurObject.FileName),
           BAFlag = CurObject.BAFlag
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPAttachment.InsertAttachment; Error inserting OSWP Request attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPAttachment.InsertAttachment; ' + 
                'Error inserting OSWP Request attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    SaveDate = DATE('NOW');
    UpdateSql = ' UPDATE SOA_OSWPBinaryFile SET DataStream ' + 
                ' WHERE  PermitJobID = ' + VARCHAR(CurObject.PermitJobID) + 
                ' AND   FileID = ' + VARCHAR(CurObject.FileID);

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;

/*
** make it ddb compliant again.
*/
//    CurMethod.DBSession = DDB_Global.Session.Cur;
    
    IF DBSession1Status = -1 AND DBSession2Status = -1 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPAttachment.InsertAttachment; Error saving file binary in database.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPAttachment.InsertAttachment; Error saving file binary in database.');
       RetCode = CALLPROC SOA_OSWPAttachmentDel(
                              PermitJobID = CurObject.PermitJobID,
                              FileID = CurObject.FileID);
       CALLPROC DDB_COMMIT;
       RETURN;
    ELSEIF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       CurObject.DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       CurObject.DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       CurObject.DBServer = 2;

    ELSE
       CurObject.DBServer = -1;
    ENDIF;

    RETURN;
END;

