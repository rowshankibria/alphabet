/*
**  Application:    CAC
**  Class:          CardDSO
**
**  Date:       Author   Description
** ----------------------------------
**  03/12/10    em       Created
**  03/01/11    pkw      Merged with demo version.
**  03/11/11    em       temporarily added loadclosed cards here
**  07/10/11    em       Modify AddFeeder to support open card validation
**  07/28/14    em       Add FacilityName parameter for InsertCard method in 
**                       case trace does not yield any feeders.
**  02/25/15    em       Add TemplateName attribute and update method
**  03/03/15    em       Add Create Copy parameter to Insert Card method
**  04/13/15    em       In AddFeeder method, move selection of MaxEnDeEn outside of loop so
**                       all structures get the same sequence.
**  04/14/15    em       Changing procedure call to save equipment snapshot at card creation and
**                       feeder addition. Add EnDeEn parm to AddFeeder call to insert equip status.
**  04/27/15    em       Add LastEdit attribute using Max timestamp from Log.
**  10/28/21    pkw      Add checkedby2 attribute
**  05/18/22    em       Use DSO_Trace_Engine components
*/
METHOD LoadCard(
   Card	= INTEGER NOT NULL
)=
DECLARE
   j          = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF Card = 0 THEN
       CurObject.Card = 0;
       RETURN(CurObject);
   ENDIF;

   CurMethod.SendSuperClass();
/*
** Read the card in
*/ 
   CurObject.Object.Clear();
  
   IF CurObject.ArchiveCard = FALSE THEN  
      SELECT  
           :CurObject.CCNumber = DC.CCNumber,
           :CurObject.OpNumber = DC.OpNumber,
           :CurObject.CardClass = DC.CardClass,
           :CurObject.CardClassName = DC.CardClassName,
           :CurObject.Status = DC.Status,
           :CurObject.ScopeofWork = DC.ScopeofWork,
           :CurObject.Opened = DC.Opened,
           :CurObject.Activated = DC.Activated,
           :CurObject.Closed = DC.Closed,
           :CurObject.Card = DC.Card,
           :CurObject.FeederNames = DC.FeederNames,
           :CurObject.PreparedBy = DC.PreparedBy,
           :CurObject.CheckedBy = DC.CheckedBy,
           :CurObject.CheckedBy2 = DC.CheckedBy2,
           :CurObject.TemplateName = DC.TemplateName
      FROM    DSO_Card DC
      WHERE   DC.Card = :Card;

      j = 1;
      SELECT  
           :CurObject.Object[j].Object = Object,
           :CurObject.Object[j].Type = Type,
           :CurObject.Object[j].Name = Name
      FROM  TFMS_CardToObject CTO
      WHERE CTO.Card = :Card 
      ORDER BY Name
      BEGIN
         j = j + 1;
      END;
      
      DSOEmergency = FALSE;
      SELECT :DSOEmergency = :TRUE
      FROM    FMS_ObjectStatus OS
      WHERE   OS.Object = :Card AND
              OS.Status = :Status$Emergency;

   ELSE
      SELECT  
           :CurObject.CCNumber = DC.CCNumber,
           :CurObject.OpNumber = DC.OpNumber,
           :CurObject.CardClass = DC.CardClass,
           :CurObject.CardClassName = DC.CardClassName,
           :CurObject.Status = DC.Status,
           :CurObject.ScopeofWork = DC.ScopeofWork,
           :CurObject.Opened = DC.Opened,
           :CurObject.Activated = DC.Activated,
           :CurObject.Closed = DC.Closed,
           :CurObject.Card = DC.Card,
           :CurObject.FeederNames = DC.FeederNames,
           :CurObject.PreparedBy = DC.PreparedBy,
           :CurObject.CheckedBy = DC.CheckedBy,
           :CurObject.CheckedBy2 = DC.CheckedBy2
      FROM    DSO_Card DC
      WHERE   DC.Card = :Card;

      j = 1;
      SELECT  
           :CurObject.Object[j].Object = Object,
           :CurObject.Object[j].Type = Type,
           :CurObject.Object[j].Name = Name
      FROM  TFMS_CardToObject CTO
      WHERE CTO.Card = :Card 
      ORDER BY Name
      BEGIN
         j = j + 1;
      END;
   ENDIF;

   SELECT :CurObject.LastEdit = MAX(Time)
   FROM   SOA_Log 
   WHERE  Card = :CurObject.Card;

   RETURN(CurObject);
END;


METHOD InsertCard(
   Objects = ARRAY OF DSO_trace_engine!Equipment,
   TracePath   = ARRAY OF DSO_trace_engine!PathTraceResult;
   FacilityName = VARCHAR(40) NOT NULL WITH DEFAULT;
   CreateCopy = INTEGER NOT NULL WITH DEFAULT;  /*Option for Copy Closed Card Template*/
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   j          = INTEGER NOT NULL WITH DEFAULT;
   ObjectType = INTEGER NOT NULL;
   ObjectName = VARCHAR(40) NOT NULL;
   Feeders    = ARRAY OF ObjectSummaryClass;
   FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   PoolObject = INTEGER NOT NULL WITH DEFAULT;
   PumpType   = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
   SubstationList = ARRAY of ObjectSummaryClass;
   MiscWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(2000) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Create the Card
*/
   CurObject.TypeOfCard = TypeofCard$DSO;
   CurObject.Application = Application$DSO;
   CurObject.Card = CALLPROC Udb_NextKey(KeyName = 'Card');
   IF CurObject.Card <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to generate card key.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardDSO;InsertCard; Unable to generate card key.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF CreateCopy = TRUE THEN
/*
**  Copy CardToObject rows for the new card.
*/
      FOR i = 1 TO CurObject.Object.LastRow() DO
/*
** Line objects are inserted with Status value = 1
*/
         IF CurObject.Object[i].Type = Type$Line THEN
            j = 1;
         ELSE
            j  = 0;
         ENDIF;
         RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = CurObject.Object[i].Object
                                   ,CardObjectName = CurObject.Object[i].Name
                                   ,ObjectType = CurObject.Object[i].Type
                                   ,Status = j
                                   ,Seq = 0
                                   ,ValidatedBy = 'DSO');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not create the card.  A database error ' +
                    ' occurred while inserting the Card To Object links.';
            CurObject.Card = 0;
            RETURN CurObject;
         ENDIF;          
      ENDFOR;  
      CALLPROC DDB_COMMIT; 

   ELSE 
/*
**  Insert a row in the CardToObject table for each structure
**  associated with the card.
*/
   FOR i = 1 TO Objects.LastRow() DO
      SELECT :ObjectType = Type,
             :ObjectName = Name
      FROM   Udb_Object
      WHERE  Object = :Objects[i].Object;

      RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = Objects[i].Object
                                   ,CardObjectName = ObjectName
                                   ,ObjectType = ObjectType
                                   ,Status = 0
                                   ,Seq = 0
                                   ,ValidatedBy = 'DSO');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not create the card.  A database error ' +
                    ' occurred while inserting the Card To Object links.';
            CurObject.Card = 0;
            RETURN CurObject;
         ENDIF;          
   ENDFOR;  
/*
**  Insert a row in the CardToObject table for each pump
**  associated with the card.
*/
   FOR i = 1 TO TracePath.LastRow() DO
      FOR j = 1 TO  TracePath[i].TargetEquip.LastRow() DO

         PumpType = FALSE;
         SELECT :PumpType = Type
         FROM   Udb_ExtendedType 
         WHERE  Type = :TracePath[i].TargetEquip[j].Type AND
                SuperType = :Type$Pump;
 
         IF PumpType <> FALSE THEN    
            RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = TracePath[i].TargetEquip[j].Object
                                   ,CardObjectName = TracePath[i].TargetEquip[j].Name
                                   ,ObjectType = TracePath[i].TargetEquip[j].Type
                                   ,Status = 0
                                   ,Seq = 0
                                   ,ValidatedBy = 'DSO');
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'Could not create the card.  A database error ' +
                    ' occurred while inserting pump in the Card To Object links.';
               CurObject.Card = 0;
               RETURN CurObject;
            ENDIF;
         ENDIF;   
      ENDFOR;       
   ENDFOR;  
/*
** Get list of Feeders associated with inserted objects
*/
   Feeders.Clear();
   FeederNames = '';
   i = 1;
   REPEATED
   SELECT 
   DISTINCT :Feeders[i].Name = O.Name,
            :Feeders[i].Object = O.Object
   FROM     Udb_Object O,
            TFMS_CardToObject CTO,
            Udb_Grouping G
   WHERE    CTO.Card = :CurObject.Card AND
            CTO.Object = G.Member AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = O.Object AND
            O.Type = :Type$Line
   BEGIN
      IF i = 1 THEN
         FeederNames = Feeders[i].Name;
      ELSE
         FeederNames = FeederNames + ',' + Feeders[i].Name;
      ENDIF;
      i = i + 1;
   END;
/*
** Use Facility Name if no Feeders are found
*/
   IF FeederNames= ''  THEN
      FeederNames = FacilityName;
   ENDIF;
   CurObject.FeederNames = FeederNames;
 
   FOR i = 1 TO Feeders.LastRow() DO
      RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = Feeders[i].Object
                                   ,CardObjectName = Feeders[i].Name
                                   ,ObjectType = Type$Line
                                   ,Status = 1
                                   ,Seq = 0
                                   ,ValidatedBy = 'DSO');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not create the card.  A database error ' +
                    ' occurred while inserting feeder links.';
            CurObject.Card = 0;
            RETURN CurObject;
         ENDIF;          
   ENDFOR;  
   CALLPROC DDB_COMMIT;  

   ENDIF;   /* End CreateCopy IF THE ELSE */
/* 
** Insert card info into DSO_Card. No commit is done until
** card info has been inserted into SOA_Card.
*/
   CurObject.Opened = 'now';
   CurObject.PreparedBy = DOp.Description;
   CurObject.Status = Card$Open;

   RetCode = CALLPROC DSO_CardIns   (Card = CurObject.Card,
                                     CardClass = CurObject.CardClass,
                                     CardClassName = CurObject.CardClassName, 
                                     FeederNames = CurObject.FeederNames,
                                     Status = CurObject.Status,
                                     Opened = CurObject.Opened,
                                     ScopeofWork = CurObject.ScopeofWork,
                                     PreparedBy = CurObject.PreparedBy
                                     );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert DSO card.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardDSO;InsertCard; Card insert failed.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;

   CurMethod.SendSuperClass();

   RetCode = CurObject.CardHeaderUpd();
   IF RetCode = PU_CANCEL THEN
         CurObject.Card = 0;
         RETURN CurObject;
   ENDIF;

   RetCode = CALLPROC DSO_CardEquipStatusIns (
              Card = CurObject.Card,
              CardStatus = CurObject.Status);
   IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
             'Warning: Unable to insert equipment status snapshot for card open.',
                           TraceMessage =
             'CardDSO;InsertCard; Unable to insert equipment status snapshot for Card ' + 
             VARCHAR(CurObject.Card)
             );
   ELSE
      CALLPROC DDB_COMMIT;  
   ENDIF;     
      
   CurObject.ArchiveCard = FALSE;
   ArchiveCard = FALSE;
   RETURN CurObject;
END;

METHOD AddFeeder(
   Objects = ARRAY OF DSO_trace_engine!Equipment;
   TracePath   = ARRAY OF DSO_trace_engine!PathTraceResult;
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   j          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(200) NOT NULL WITH DEFAULT;
   Feeders    = ARRAY OF ObjectSummaryClass;
   FeederNames = VARCHAR(80) NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   MaxEnDeEn  = INTEGER NOT NULL WITH DEFAULT;
   ObjectType = INTEGER NOT NULL WITH DEFAULT;
   ObjectName = VARCHAR(40) NOT NULL WITH DEFAULT;
   PumpType   = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Generate next seq so all rows inserted get same number
*/
      SELECT :MaxEnDeEn = MAX(EnDeEn)
      FROM   TFMS_CardToObject
      WHERE  Card = :CurObject.Card;
      MaxEnDeEn = MaxEnDeEn + 1;
/*
** Insert object if not a duplicate, remove from list if it is.
*/
   i = Objects.LastRow();
   WHILE i >= 1 DO
      j = 1;
      LastRow = CurObject.Object.LastRow();
      WHILE j <= LastRow DO
         IF Objects[i].Object  = CurObject.Object[j].Object THEN
            ENDLOOP;
         ENDIF;
         j = j + 1;
      ENDWHILE;
      IF j <= LastRow THEN
         Objects.RemoveRow (rownumber = i);
         i = i - 1;
         CONTINUE;
      ENDIF;

      SELECT :ObjectType = Type,
             :ObjectName = Name
      FROM   Udb_Object
      WHERE  Object = :Objects[i].Object;

      RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = Objects[i].Object
                                   ,CardObjectName = ObjectName
                                   ,ObjectType = ObjectType
                                   ,Status = 0
                                   ,Seq = 0
                                   ,EnDeEn = MaxEnDeEn    /*Indicates object added after card creation*/
                                   ,ValidatedBy = 'DSO');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not add object to card during Add Feeder process. ';
            RETURN PU_CANCEL;
         ENDIF;      

      IF CurObject.Status = Card$Active THEN

         RetCode = CALLPROC SOA_ActiveObjectIns
                (Card = CurObject.Card
                ,Object = Objects[i].Object
                ,ObjectToCardLink = 0);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not add object to ActiveObject during Add Feeder process. ';
            RETURN PU_CANCEL;
         ENDIF;      

      ENDIF; 
      i = i  - 1;   
   ENDWHILE;  
/*
**  Insert a row in the CardToObject table for each pump
**  associated with the card.
*/
   FOR i = 1 TO TracePath.LastRow() DO
      FOR j = 1 TO  TracePath[i].TargetEquip.LastRow() DO

         PumpType = FALSE;
         SELECT :PumpType = Type
         FROM   Udb_ExtendedType 
         WHERE  Type = :TracePath[i].TargetEquip[j].Type AND
                SuperType = :Type$Pump;
 
         IF PumpType <> FALSE THEN    
            RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = TracePath[i].TargetEquip[j].Object
                                   ,CardObjectName = TracePath[i].TargetEquip[j].Name
                                   ,ObjectType = TracePath[i].TargetEquip[j].Type
                                   ,Status = 0
                                   ,Seq = 0
                                   ,EnDeEn = MaxEnDeEn
                                   ,ValidatedBy = 'DSO');
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               Message 'A database error ' +
                    ' occurred while inserting pump in the Card To Object links.';
               RETURN PU_CANCEL;
            ENDIF;
         ENDIF;   
      ENDFOR;       
   ENDFOR;  
/*
** Get list of Feeders associated with inserted objects
*/
   Feeders.Clear();
   i = 1;
   REPEATED
   SELECT 
   DISTINCT :Feeders[i].Name = O.Name,
            :Feeders[i].Object = O.Object
   FROM     Udb_Object O,
            TFMS_CardToObject CTO,
            Udb_Grouping G
   WHERE    CTO.Card = :CurObject.Card AND
            CTO.Object = G.Member AND
            CTO.EnDeEn = 1 AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = O.Object AND
            O.Type = :Type$Line AND 
            O.Object NOT IN  (SELECT Object FROM TFMS_CardToObject
                              WHERE  Card = :CurObject.Card AND Type = :Type$Line)
   BEGIN
      i = i + 1;
   END;   

   FOR i = 1 TO Feeders.LastRow() DO
      RetCode = CALLPROC TFMS_InsertCardToObject(
                                    CardKey = CurObject.Card
                                   ,CardObject = Feeders[i].Object
                                   ,CardObjectName = Feeders[i].Name
                                   ,ObjectType = Type$Line
                                   ,Status = 1
                                   ,Seq = 0
                                   ,EnDeEn = MaxEnDeEn     /*Indicates object added after card creation*/
                                   ,ValidatedBy = 'DSO');
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not add the feeder.  A database error ' +
                    ' occurred while inserting feeder links.';
            RETURN PU_CANCEL;
      ENDIF;   
       
      IF CurObject.Status = Card$Active THEN

         RetCode = CALLPROC SOA_ActiveObjectIns
                (Card = CurObject.Card
                ,Object = Feeders[i].Object
                ,ObjectToCardLink = 1);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not add feeder to ActiveObject during Add Feeder process. ';
            RETURN PU_CANCEL;
         ENDIF;      

      ENDIF; 

      RetCode = CALLPROC SOA_LogIns (
                  Card = CurObject.Card,
                  SwitchingItem = 0,
                  Job = NULL,
                  Time = DATE('now'),
                  UserName = UserName,
                  Item = 'AddFeeder',
                  Old = 'Feeder added to card:',
                  New = Feeders[i].Name);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not log adding the feeder.  A database error ' +
                    ' occurred while inserting feeder links.';
            RETURN PU_CANCEL;
      ENDIF;          
   ENDFOR;  
/*
** Need to update card header with feeder names
*/
   FeederNames = '';
   i = 1;
   REPEATED
   SELECT 
   DISTINCT :Feeders[i].Name = O.Name,
            :Feeders[i].Object = O.Object
   FROM     Udb_Object O,
            TFMS_CardToObject CTO,
            Udb_Grouping G
   WHERE    CTO.Card = :CurObject.Card AND
            CTO.Object = G.Member AND
            G.Relationship = :Interaction$MemberOf AND
            G.Grouping = O.Object AND
            O.Type = :Type$Line 
   ORDER BY Name
   BEGIN
      IF i =  1 THEN
         FeederNames = Feeders[i].Name;
      ELSE
         FeederNames = FeederNames + ',' + Feeders[i].Name;
      ENDIF;
      i = i + 1;
   END;   

   RetCode = CALLPROC DSO_CardNameUpd (
              Card = CurObject.Card,
              FeederNames  = FeederNames);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not update card name.  A database error ' +
                    ' occurred while adding feeder to the card.';
            RETURN PU_CANCEL;
      ENDIF;     

   RetCode = CALLPROC DSO_CardEquipStatusIns (
              Card = CurObject.Card,
              CardStatus = CurObject.Status,
              EnDeEn = MaxEnDeEn);
   IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Could not insert additional objects for card validation.  A database error ' +
                    ' occurred while adding feeder to the card.';
            RETURN PU_CANCEL;  
   ENDIF;     

   CALLPROC DDB_COMMIT;
   RETURN PU_OK;
END;

METHOD CardHeaderUpd (
)=
DECLARE
   j          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(200) NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   MainName   = VARCHAR(40) NOT NULL WITH DEFAULT;
   PoolObject = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN

      RetCode = CALLPROC DSO_CardUpd   (
				Card = CurObject.Card,
				CCNumber = CurObject.CCNumber,
				OpNumber = CurObject.OpNumber,
				ScopeofWork = CurObject.ScopeofWork,
                                CheckedBy = CurObject.CheckedBy,
                                CheckedBy2 = CurObject.CheckedBy2,
                                PreparedBy = CurObject.PreparedBy
                                     );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update DSO card header.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardDSO;CardHeaderUpd; Card header update failed.'
             );
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RETURN PU_OK;
END;

METHOD TemplateNameUpd (
)=
DECLARE
   j          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   CardName   = VARCHAR(200) NOT NULL WITH DEFAULT;
   LastRow    = INTEGER NOT NULL WITH DEFAULT;
   MainName   = VARCHAR(40) NOT NULL WITH DEFAULT;
   PoolObject = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN

      RetCode = CALLPROC DSO_CardTemplateUpd   (
				Card = CurObject.Card,
				TemplateName = CurObject.TemplateName
                                     );
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to update DSO card template name.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardDSO;CardTemplateUpd; Card template name update.'
             );
         RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;

      RETURN PU_OK;
END;

