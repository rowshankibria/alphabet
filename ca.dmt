*/ 
METHOD LoadDivisions (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load all division types.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Load Division table
*/
   CurObject.DList.Clear();
   i = 1;
   SELECT CurObject.Dlist[i].DivisionName = O.Name,
          CurObject.Dlist[i].Division     = O.Object
   FROM   Udb_Object O
   WHERE  O.Type = :Type$Division AND
          O.PrimaryGrouping <> 0
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.Dlist.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No division objects found in database.';
   ENDIF;
   RETURN;
END;

