**
**  12/30/2003   ysp  Created 
**  07/30/2004   em   For SICC load RCC Operators
**  01/30/2008   ysp  Order operator list by description
*/   

INITIALIZE
(
   NoLogOut = INTEGER;

/* Local Vars */
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   NewDO = DistrictOperatorClass;
) =
BEGIN

   IF DOp.IsLoggedIn() = TRUE THEN
      CurrentDO.OperatorName  = DOp.Description;

      SELECT :CurrentDO.OperatorName = OperatorName,
             :CurrentDO.Login = Login,
             :CurrentDO.Machine  = Machine
      FROM   SOA_DOLogIn
      WHERE  Machine= :UserMachine AND
             Operator = :DOp.Object AND
             Logout IS NULL;
   ELSE
      FIELD(CurrentDO).CurBias = FB_INVISIBLE;
      FIELD(LogOut_btn).CurBias = FB_DIMMED;
   ENDIF;
   
   IF NoLogOut IS NOT NULL AND NoLogOut = TRUE THEN
      FIELD(LogOut_btn).CurBias = FB_DIMMED;
   ENDIF;
   FIELD(LogIn_btn).CurBias = FB_DIMMED;
/*
**  Load Operators
*/
   IF UserGroup = Group$SICC THEN
      i = 1;
      SELECT  :OperatorChoices[i].Object      = Object, 
              :OperatorChoices[i].Name        = Name, 
              :OperatorChoices[i].Description = Description
      FROM    Udb_Object
      WHERE   Type IN (
                    SELECT  Type
                    FROM    Udb_ExtendedType
                    WHERE   SuperType = :Type$RCCOperator)
      ORDER BY Description
      BEGIN
         i = i + 1;
      END; 
   ELSEIF UserRole = Role$Steam THEN
     i = 1;
      SELECT  :OperatorChoices[i].Object      = Object, 
              :OperatorChoices[i].Name        = Name, 
              :OperatorChoices[i].Description = Description
      FROM    Udb_Object
      WHERE   Type IN (
                    SELECT  Type
                    FROM    Udb_ExtendedType
                    WHERE   SuperType = :Type$SteamDispatcher)
      ORDER BY Description
      BEGIN
         i = i + 1;
      END; 

   ELSE
      i = 1;
      SELECT  :OperatorChoices[i].Object      = Object, 
              :OperatorChoices[i].Name        = Name, 
              :OperatorChoices[i].Description = Description
      FROM    Udb_Object
      WHERE   Type IN (
                    SELECT  Type
                    FROM    Udb_ExtendedType
                    WHERE   SuperType = :Type$DistrictOperator)
      ORDER BY Description
      BEGIN
         i = i + 1;
      END; 
   ENDIF;

   CALLPROC DDB_ROLLBACK; 
END;


ON CHILDENTRY OperatorChoices[*].Description,
ON CHILDENTRY OperatorChoices[*].Name =
BEGIN
   Selected.Object = OperatorChoices[].Object;
   Selected.Name = OperatorChoices[].Name;
   Selected.Description = OperatorChoices[].Description;

   FIELD(LogIn_btn).CurBias = FB_LANDABLE;
END; 
     
ON CLICK LogOut_Btn = 
BEGIN
   IF DOp.IsLoggedIn() = TRUE THEN

      RetCode = DOP.LogOut (RaiseEvent = TRUE);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Failed to LogOut the current operator. Please try again.';
         RESUME;
      ENDIF;
   ENDIF;    
   RETURN (-1);   /* Log out */
END;

ON CLICK LogIn_Btn =
BEGIN
   IF Selected.Description = '' THEN
       MESSAGE 'You must select an Operator to LogIn.';
       RESUME;
   ELSEIF DOp.Object = OperatorChoices[].Object THEN
      RETURN (0);  /* not changed */
   ENDIF;
/*
** Check if the new DO already logged in another machine.
** If so, log out the DO from that machine.
*/
   NewDO.Object = 0;
   SELECT :NewDO.Object  = Operator,
          :NewDO.Description = OperatorName,
          :NewDO.Machine = Machine
   FROM   SOA_DOLogIn
   WHERE  Operator = :Selected.Object AND
          Machine <> :UserMachine AND
          LogOut IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF NewDO.Object <> 0 THEN
      RetCode = NewDO.LogOut (RaiseEvent = TRUE);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Failed to LogOut the selected Operator from another Desk. Please try again.';
         RESUME;
      ENDIF;
   ENDIF;
/*
** log out the current operator before logging in the new opeartor.
*/
   IF DOp.IsLoggedIn() = TRUE THEN

      RetCode = DOP.LogOut (RaiseEvent = FALSE);

      IF RetCode = PU_CANCEL THEN
         MESSAGE 'Failed to LogOut the current operator. Please try again.';
         RESUME;
      ENDIF;
   ENDIF;      
/*
** Log in the new opeartor
*/
   RetCode = DOp.LogIn (Operator = Selected.Object,
                        Name = Selected.Name,
                        Description = Selected.Description);

   IF RetCode = PU_OK THEN
      RETURN (1);  /* log in */
   ELSE        
      Message 'Unable to LogIn due to an error. Please try again.';
      RETURN (-1);  /* log out */
   ENDIF;
END;


ON CLICK Cancel_Btn=
BEGIN
   IF DOp.IsLoggedIn() = FALSE THEN
      RetCode = CurFrame.ConfirmPopUp (
                         MessageText = 'You did not LogIn.');

      IF RetCode != PU_OK THEN
         RESUME;
      ENDIF;
   ENDIF;
	
   RETURN (0);   /* not changed */
END;


Application Component Report
============================

	Name:            DownloadRelayToFSS

/**
 **
 **  Copyright c 2009 Pateric Software LLC.  All rights reserved.
 **
 **  Pateric Software LLC proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Pateric Software LLC.
 **
 **
 **  Application:    CAC
 **  Procedure:      DownloadRelayToFSS
 **
 **  Modification log:
 **
 **  Date:     Version   Description 
 ** --------------------------------------------------        
 **  03/27/09  ysp  Initial Version     
 **  06/18/09  em   Made Card Parm NOT NULL to get past run time trace error   
 **
 **/

procedure DownloadRelayToFSS
(
    Card = INTEGER NOT NULL WITH DEFAULT;         /*P: Passed card */
    ArchiveCard = INTEGER NOT NULL WITH DEFAULT;  /*P: Passed boolean */
) =
declare
    i= integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    RelayOpList = ARRAY OF CAC_Relay;          /*Local: Array of existing relay operations */
    RR = ReturnRelay;                      /* ReturnRelay Class*/

enddeclare
begin
/**
 **  Select all of the existing relays for this card
 **/
    i = 1;
    IF ArchiveCard = FALSE THEN
        REPEATED
        SELECT  RelayOpList[i].RelayOp = R.RelayOp,
                RelayOpList[i].Trip = R.Trip,
                RelayOpList[i].Line = R.Line,
                RelayOpList[i].FeederName = R.FeederName,
                RelayOpList[i].Equip = R.Equip,
                RelayOpList[i].EquipName = R.EquipName,
                RelayOpList[i].EquipClass = R.EquipClass,
                RelayOpList[i].EquipClassName = R.EquipClassName,
                RelayOpList[i].RelayType = R.RelayType,
                RelayOpList[i].RelayTypeName = R.RelayTypeName,
                RelayOpList[i].RelayClass = R.RelayClass,
                RelayOpList[i].RelayClassName = R.RelayClassName,
                RelayOpList[i].RelayName = R.RelayName,
                RelayOpList[i].Operation = R.Operation,
                RelayOpList[i].TimeStamp = R.TimeStamp,
                RelayOpList[i].OutOfService = R.OutOfService,
                RelayOpList[i].Compromised = R.Compromised,
                RelayOpList[i].Status = ''
        FROM    CAC_RelayOps R,
                CAC_RelayOpsControl C
        WHERE   C.CardType = :Type$FMSApp
          AND   C.Card = :Card
          AND   R.RelayOp = C.RelayOp
        ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
        BEGIN
            i = i + 1;
        END; 
    ELSE
        REPEATED
        SELECT  RelayOpList[i].RelayOp = R.RelayOp,
                RelayOpList[i].Trip = R.Trip,
                RelayOpList[i].Line = R.Line,
                RelayOpList[i].FeederName = R.FeederName,
                RelayOpList[i].Equip = R.Equip,
                RelayOpList[i].EquipName = R.EquipName,
                RelayOpList[i].EquipClass = R.EquipClass,
                RelayOpList[i].EquipClassName = R.EquipClassName,
                RelayOpList[i].RelayType = R.RelayType,
                RelayOpList[i].RelayTypeName = R.RelayTypeName,
                RelayOpList[i].RelayClass = R.RelayClass,
                RelayOpList[i].RelayClassName = R.RelayClassName,
                RelayOpList[i].RelayName = R.RelayName,
                RelayOpList[i].Operation = R.Operation,
                RelayOpList[i].TimeStamp = R.TimeStamp,
                RelayOpList[i].OutOfService = R.OutOfService,
                RelayOpList[i].Compromised = R.Compromised,
                RelayOpList[i].Status = ''
        FROM    CAC_ArchiveRelayOps R,
                CAC_ArchiveROControl C
        WHERE   C.CardType = :Type$FMSApp
          AND   C.Card = :Card
          AND   R.RelayOp = C.RelayOp
        ORDER BY Line,  RelayClassName, RelayTypeName, EquipName, Operation
        BEGIN
            i = i + 1;
        END; 
    ENDIF;
    CALLPROC DDB_ROLLBACK;
                  
    FOR i = 1 TO RelayOpList.LastRow DO
      IF RelayOpList[i].RelayType = Relay$5051A THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT5051AI = 'NO';
            RR.RT5051AT = 'NO';
            RR.RT5051ATS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT5051AI = 'YES';
               RR.RT5051AT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT5051AI = 'NO';
               RR.RT5051AT = 'YES';
            ELSE
               RR.RT5051AT = 'YES';
               RR.RT5051AI = 'YES';
            ENDIF;
            RR.RT5051ATS = RelayOpList[i].TimeStamp;
         ENDIF;
         
      ELSEIF RelayOpList[i].RelayType = Relay$5051B THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT5051BI = 'NO';
            RR.RT5051BT = 'NO';
            RR.RT5051BTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT5051BI = 'YES';
               RR.RT5051BT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT5051BI = 'NO';
               RR.RT5051BT = 'YES';
            ELSE
               RR.RT5051BT = 'YES';
               RR.RT5051BI = 'YES';
            ENDIF;
            RR.RT5051BTS = RelayOpList[i].TimeStamp;
         ENDIF;
         
      ELSEIF RelayOpList[i].RelayType = Relay$5051C THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT5051CI = 'NO';
            RR.RT5051CT = 'NO';
            RR.RT5051CTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT5051CI = 'YES';
               RR.RT5051CT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT5051CI = 'NO';
               RR.RT5051CT = 'YES';
            ELSE
               RR.RT5051CT = 'YES';
               RR.RT5051CI = 'YES';
            ENDIF;
            RR.RT5051CTS = RelayOpList[i].TimeStamp;
         ENDIF;

      ELSEIF RelayOpList[i].RelayType = Relay$5051N THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT5051NI = 'NO';
            RR.RT5051NT = 'NO';
            RR.RT5051NTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT5051NI = 'YES';
               RR.RT5051NT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT5051NI = 'NO';
               RR.RT5051NT = 'YES';
            ELSE
               RR.RT5051NT = 'YES';
               RR.RT5051NI = 'YES';
            ENDIF;
            RR.RT5051NTS = RelayOpList[i].TimeStamp;
         ENDIF;

      ELSEIF RelayOpList[i].RelayType = Relay$67A THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT67AI = 'NO';
            RR.RT67AT = 'NO';
            RR.RT67ATS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT67AI = 'YES';
               RR.RT67AT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT67AI = 'NO';
               RR.RT67AT = 'YES';
            ELSE
               RR.RT67AT = 'YES';
               RR.RT67AI = 'YES';
            ENDIF;
            RR.RT67ATS = RelayOpList[i].TimeStamp;
         ENDIF;
         
      ELSEIF RelayOpList[i].RelayType = Relay$67B THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT67BI = 'NO';
            RR.RT67BT = 'NO';
            RR.RT67BTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT67BI = 'YES';
               RR.RT67BT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT67BI = 'NO';
               RR.RT67BT = 'YES';
            ELSE
               RR.RT67BT = 'YES';
               RR.RT67BI = 'YES';
            ENDIF;
            RR.RT67BTS = RelayOpList[i].TimeStamp;
         ENDIF;
         
      ELSEIF RelayOpList[i].RelayType = Relay$67C THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT67CI = 'NO';
            RR.RT67CT = 'NO';
            RR.RT67CTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT67CI = 'YES';
               RR.RT67CT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT67CI = 'NO';
               RR.RT67CT = 'YES';
            ELSE
               RR.RT67CT = 'YES';
               RR.RT67CI = 'YES';
            ENDIF;
            RR.RT67CTS = RelayOpList[i].TimeStamp;
         ENDIF;

      ELSEIF RelayOpList[i].RelayType = Relay$67N THEN
         IF RelayOpList[i].TimeStamp = '' THEN
            RR.RT67NI = 'NO';
            RR.RT67NT = 'NO';
            RR.RT67NTS = '';
         ELSE
            IF RelayOpList[i].Operation = RelayOp$Instantaneous THEN
               RR.RT67NI = 'YES';
               RR.RT67NT = 'NO';
            ELSEIF RelayOpList[i].Operation = RelayOp$Time THEN
               RR.RT67NI = 'NO';
               RR.RT67NT = 'YES';
            ELSE
               RR.RT67NT = 'YES';
               RR.RT67NI = 'YES';
            ENDIF;
            RR.RT67NTS = RelayOpList[i].TimeStamp;
         ENDIF;  

      ELSEIF RelayOpList[i].RelayType = Relay$46T THEN 
         IF RelayOpList[i].Operation = RelayOp$None THEN
            RR.RT46TO = 'NO';
            RR.RT46TTS = '';
         ELSE
            RR.RT46TO = 'YES';
            RR.RT46TTS = RelayOpList[i].TimeStamp;
         ENDIF;      
      ENDIF;
   ENDFOR;

         
   RetCode = CALLPROC FRA_RelayIns  (
              Card = Card,
              Job = 0,
              RT5051AI = RR.RT5051AI,
              RT5051AT = RR.RT5051AT,
              RT5051ATS = RR.RT5051ATS,
              RT5051BI = RR.RT5051BI,
              RT5051BT = RR.RT5051BT,
              RT5051BTS = RR.RT5051BTS,
              RT5051CI = RR.RT5051CI,
              RT5051CT = RR.RT5051CT,
              RT5051CTS = RR.RT5051CTS,
              RT5051NI = RR.RT5051NI,
              RT5051NT = RR.RT5051NT,
              RT5051NTS = RR.RT5051NTS,
              RT67AI = RR.RT67AI,
              RT67AT = RR.RT67AT,
              RT67ATS = RR.RT67ATS,
              RT67BI = RR.RT67BI,
              RT67BT = RR.RT67BT,
              RT67BTS = RR.RT67BTS,
              RT67CI = RR.RT67CI,
              RT67CT = RR.RT67CT,
              RT67CTS = RR.RT67CTS,
              RT67NI = RR.RT67NI,
              RT67NT = RR.RT67NT,
              RT67NTS = RR.RT67NTS,
              RT46TO = RR.RT46TO,
              RT46TTS = RR.RT46TTS);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurProcedure.Trace (Text = VARCHAR(DATE('now')) + ': Failed to insert into FRA_Relay table.');
   ENDIF;   
end;


Application Component Report
============================

	Name:            DropCommonEquipment

/* 
**      Copyright c 1993 Unified Information,Inc.  All rights reserved. 
** 
**      Unified Information proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of Unified Information. 
** 
**  Application:    CAC
**  4GL Procedure:  DropCommonEquipment 
** 
**  Modification log: 
** 
**  Date:  	    Version       Description 
** -------------------------------------------------- 
**  07/31/93      em          created  
**  11/24/93      em          implemented new dropsingleequip dbproc
**  06/14/94      pw          drop feeder statuses associated w/dropped equipment
**  06/17/94      mts         Added EquipClass to criteria for select from FMS_JobAction.
**  06/27/94      hlf         Add criteria to select from fms_jobaction
**  07/07/94      mts         selections from fms_jobaction now look at equipclass heiarchy.
**  10/26/94      hlf         Modify checks/actions to look at moveequipclass
**  12/14/94      bgh         Added Equipclass to parameter list to FMS_DropSingleEquip proc.
**  01/11/95      pkw         drop from connectivity if needed
**  04/20/96      wc          Modify return status
**  12/13/96      em          Manage Card Header if Equipment Grounded
**  08/21/02      ysp         Merge: use CAC's FMS_Card class. Modified the 
**                            logic for dropping common jobs. 
**  01/31/02      em          Fixed error on return code when blanking job.
**  02/04/03      ysp         Change FeederStatusUpd to FeederStatusUndo
**  03/17/06      ysp         New return status: 0-cancelled, 1-single, 2-all
**  03/28/11      pkw         Convert for 3G
**  07/25/13      ysp         drop equip phase check when the equip is droped from feeder.
**  06/13/17      em          Remove logic dealing with connectivity for Drop Single.  Will leave
**                            connected.
*/ 
Initialize 
(   
    Jobs = ARRAY OF Job;                /* Parameter */
    FeederObj = INTEGER NOT NULL WITH DEFAULT; 
    C = FMS_Card DEFAULT NULL;

    i = INTEGER NOT NULL WITH DEFAULT; 
    retcode = INTEGER NOT NULL WITH DEFAULT;
    EquipMemberType = INTEGER NOT NULL;
    SelectCount = INTEGER NOT NULL WITH DEFAULT; 
) = 
BEGIN 
   IF FeederObj = 0 THEN
      FeederObj = C.Feeder;
      FeederName = C.FeederName
   ENDIF;
END; 
/*
**  IF dropping single, handle entire drop here, then return cancel so
**  no further processing occurs.
*/
ON Click single_btn =
BEGIN
/*
** See if the card has the control of the equipment to be dropped.
** If so, ask D.O. to transfer the control to another card.
*/
   i = 0;
   SELECT :i = 1
   FROM    SOA_Job J,
           SOA_JobControl JC1,
           SOA_JobControl JC2,
           SOA_ActiveCard AC
   WHERE   JC1.Card = :C.Card AND
           JC1.Job = J.Job AND
           J.ControlCard = :C.Card AND
           J.Equip = :EquipToDrop.Equip AND
           JC1.Job = JC2.Job AND
           JC2.Card = AC.Card AND
           JC2.Card <> :C.Card AND
           JC2.Card <> :NIS$Card;

   IF i <> 0 THEN
      RetCode = CALLFRAME TransferControl( Card = C.Card, 
                                 Equip = EquipToDrop.Equip);
  
      IF RetCode = PU_CANCEL THEN
         /* D.O. decided not to drop the equipment */
         RETURN 0;
      ENDIF;
   ENDIF;
  
   retcode = CALLPROC FeederStatusUndo(Equip = EquipToDrop.Equip,
                                     SourceCard = C,
                                     J = Jobs,
                                     Action = 'DropSingle');
   IF (retcode = PU_CANCEL) THEN 
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Unable to drop feeder statuses from current card';
      RETURN 0;
   ENDIF;
/*
** remove appropriate grouping relationship
*/
   retcode = CALLPROC FMS_DropSingleEquip
       (Feeder = FeederObj,
        Equip = EquipToDrop.Equip,
        CurrentTime = Date('now'),
        InteractionSourcePos = Interaction$SourcePosition,
        InteractionMemberOf = Interaction$MemberOf,
        StatusGround = Status$Ground,
        StatusFeederGround = Status$FeederGround,
        StatusStationGround = Status$StationGround,
        ActiveCard = Card$Active,
        EquipClass = EquipToDrop.EquipClass);
   
   IF retcode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Dropping from current feeder failed.';
      RETURN 0;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
**  If Grounded, Manage Card Header for old equipment
*/
   REPEATED
   SELECT   :i = StatusCount
   FROM     FMS_ObjectStatus
   WHERE    Object = :EquipToDrop.Equip AND
            Status = :Status$Ground;
   IF i > 0 THEN
      CALLPROC FMS_ManageCardHeader (OptionalFeeder = FeederObj, Equip = 0);
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** drop the equipment phase check.
*/
   CALLPROC TransferPhaseCheckEquipment(
                     Equip = EquipToDrop.Equip,
                     EquipName = EquipToDrop.EquipName,
                     OldFeeder = FeederObj,
                     OldFeederName = FeederName,  
                     NewFeeder = 0,
                     NewFeederName = '');           
/*
** log the change on the current card
*/
   CALLPROC SOA_LogIns (Card = C.Card,
                        Job = NULL,
                        UserName = UserName, 
                        Time = DATE('Now'),
                        Item = 'Dropped Equip',
                        Old = EquipToDrop.PrintID + '  ' +
                              EquipToDrop.EquipClassName + ' ' +
                              EquipToDrop.EquipName,
                        New = 'From current feeder only' );
/*
** For history purpose, make copies of jobs for the dropped equipment with 
** blanked-out fields. Replace the original jobs with these jobs for the 
** current card.  Also adjust deadmove count
*/
   i = 1;
   WHILE i <= Jobs.LastRow() DO
    
       IF Jobs[i].Equip = EquipToDrop.Equip THEN
/*
**   If this is an outstanding dead move, adjust dead move taken out count
*/
          IF Jobs[i].MoveType = 'Dead' AND 
             Jobs[i].TOComplete IS NOT NULL          AND
             Jobs[i].RSComplete IS NULL         THEN
/*
**  did the job increment the Feeder Dead Move Status Count...
*/
                SelectCount = 0;
                SELECT  :SelectCount = Count(*)
                FROM    FMS_JobAction J
                WHERE   J.JobClass   = :Jobs[i].JobClass AND
                        J.EquipClass = :Jobs[i].MoveEquipClass AND
                        J.StepPair = :Jobs[i].StepPair AND
                        J.TypeofCard = :C.TypeofCard AND
                        J.Action   = :JobAction$Increment AND
                        J.TORS     = 0 AND                        /*TakeOut*/
                        J.FeederEquip = 1 AND                     /*Feeder*/
                        J.Status   = :Status$DeadMove;

                IF SelectCount > 0 THEN
/*
**  It's necessary so do the dead move adjustment work for the feeder...
*/
                    CALLPROC FMS_ObjStatTimeSetUpd(
                                Object = FeederObj,
                                Status = Status$DeadMove,
                                increment = -1,
                                TimeSet = date('now'));
                ENDIF;
          ENDIF;

          /* Use SOA_TransferEquipJob procedure to make a blanked-out copy and
          ** link the current card to the new job.
          */
          Jobs[i].Response = 'Equipment Dropped'; 
          Jobs[i].GroundOn = NULL;
          Jobs[i].MoveFGColor = CC_BLACK;
          Jobs[i].Status = Job$Xfer;

          /* If time field is NULL, then set to blank: */ 
          IF (Jobs[i].TOIssued IS NULL) THEN 
             Jobs[i].TOIssued = ' '; 
          ENDIF; 
          IF (Jobs[i].TOComplete IS NULL) THEN 
             Jobs[i].TOComplete = ' '; 
          ENDIF; 
          IF (Jobs[i].RSIssued IS NULL) THEN 
             Jobs[i].RSIssued = ' '; 
          ENDIF; 
          IF (Jobs[i].RSComplete IS NULL) THEN 
             Jobs[i].RSComplete = ' '; 
          ENDIF; 
          
          RetCode = CALLPROC SOA_TransferEquipJob 
                    ( Card       = C.Card,
                      Job        = Jobs[i].Job, 
                      Response   = Jobs[i].Response, 
                      Status     = Jobs[i].Status, 
                      TOIssued   = Jobs[i].TOIssued, 
                      TOComplete = Jobs[i].TOComplete, 
                      RSIssued   = Jobs[i].RSIssued, 
                      RSComplete = Jobs[i].RSComplete,
                      GroundOn   = Jobs[i].GroundOn,
                      MoveFGColor= Jobs[i].MoveFGColor
                    ); 

          IF RetCode <> 0 THEN
             CALLPROC DDB_ROLLBACK;
             MESSAGE 'PROCEDURE:DropCommonEquipment; ' +  
                     'Error adding blanked-out jobs into the current card .';
             RETURN 0;
          ENDIF;  
       ENDIF;
       i = i + 1;
   ENDWHILE;
   CALLPROC DDB_COMMIT;
   
   FCFrame.SendUserEvent(EventName = 'load_jobs');   
   RETURN 1;
END;
/*
**  IF drop from all, let DropEquipment frame handle
*/
ON Click all_btn =
BEGIN
   RETURN 2;
END;
/*
**  IF cancelled, we won't drop anything
*/
ON Click cancel_btn =
BEGIN
   RETURN 0;
END;


