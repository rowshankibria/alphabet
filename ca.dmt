	Name:            IsHoliday

PROCEDURE IsHoliday (
   Today = DATE NOT NULL;
) =
DECLARE
   DateString = VARCHAR(10) NOT NULL WITH DEFAULT;
   Result = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   DateString = FormatDate(RawDate = Today, FORMAT = 'DATE_ONLY');  // MONTH(Today) + '/' + DAY(Today) + '/' + YEAR(Today);
   
   SELECT :Result = 1 
   FROM   FMS_Holiday
   WHERE  DateValue = :DateString;
   
   IF Result = 1 THEN
      RETURN TRUE;
   ELSE
      RETURN FALSE;
   ENDIF;
END;

Application Component Report
============================

	Name:            IsNumber

PROCEDURE IsNumber(
    value = varchar(100) NOT NULL
)=
DECLARE
    dexp = DynExpr DEFAULT NULL;
    f = float8 DEFAULT NULL;
ENDDECLARE
BEGIN
    dexp = CurProcedure.Scope.CreateDynExpr(string = 'float8('+value+')');
    IF dexp IS NULL THEN
         RETURN FALSE;
    ENDIF;
    dexp.GetValue(value = byref(f));
    IF f IS NULL THEN
         RETURN FALSE;
    ENDIF;
    RETURN TRUE;
END

Application Component Report
============================

	Name:            IsolationTrace

/*
**
**      Copyright c 2001 ALSTOM ESCA Corporation.  All rights reserved.
**
**      ALSTOM ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ALSTOM ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          IsolationTrace
**
**  Date:       Author   Description
** ----------------------------------
**  06/30/01    em       Created.
**                       Hopefully can be used generically, pass in an equipment
**                       object id and an Isolated From Type, perform
**                       connectivity trace to ensure the equip is isolated from 
**                       devices of that type.  Added Card Parameter, 
**                       if non-Zero limit scope to passed card.
**  01/29/02    em       Prevent duplicates from entering the Excluded Node
**                       list in the selection where clause.
**  02/16/04    em       Convert Message to TraceError Call
**  09/18/05    em       Return the IsolatedFromTarget equipment ID
**  01/24/17    em       Conversion to QGIS trace
**  05/01/17    em       Include ObjectToCardLink=1 in trace scope 
**  05/01/17    em       Modify card scope to equipment associated to card line objects
**
*/
PROCEDURE IsolationTrace (
    Equip		= INTEGER NOT NULL;  /*Passed Equipment ID*/
    IsolatedFromType    = INTEGER NOT NULL;  /*Passed Device Type*/
    IsolatedFromEquip   = INTEGER NOT NULL WITH DEFAULT;  /*Return paramenter equip ID*/
    Card	 	= INTEGER NOT NULL WITH DEFAULT;	

    CardScope = INTEGER NOT NULL;          /*BOOLEAN*/ 
    ConnectedEquip = ARRAY OF ConnectedEquipClass;  /*Trace equip loop*/
    DeviceOpen = INTEGER NOT NULL;          /*BOOLEAN*/ 
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;
    ExcludedNodes   = Array of IntegerObject;
    FirstObject = INTEGER NOT NULL WITH DEFAULT;                            
    i = INTEGER;                            
    j = INTEGER;
    k = INTEGER;                            
    m = INTEGER;          
    n = INTEGER NOT NULL;
    LastRow = INTEGER NOT NULL;
    MoreObjects = INTEGER NOT NULL WITH DEFAULT;    /*Loop control*/                            
    OpenDevices = ARRAY OF INTEGEROBJECT;           /*Electrical Verification*/
    RetCode = INTEGER NOT NULL;                     /*return variable */
    StartEquip = ConnectedEquipClass;               /*Start Object*/
    StaticWhereClause = VARCHAR(300) NOT NULL WITH DEFAULT;
    LineEquipScope   = ARRAY OF INTEGEROBJECT;  
    TempEquip = ARRAY OF ConnectedEquipClass;       /*Next connected object*/
    Trace = Trace_IsolationTrace;
    TraceStatus = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
    IsolatedFromEquip = 0;
/*
**  Trace ends as soon as we find isolated from trace type (PU_OK) or as soon
**  as all paths are deemed open (PU_CANCEL).  If indeterminate, we return
**  (PU_OK) so other processing as if we determined the device was not isolated.
*/ 
    REPEATED
    SELECT  :StartEquip.Object = O.Object,
            :StartEquip.Type = O.Type,
            :StartEquip.Name = O.Name,
            :StartEquip.PrimaryGrouping = O.PrimaryGrouping,
            :StartEquip.PrimaryGroupingName = O.PrimaryGroupingName
    FROM    Udb_Object O
    WHERE   O.Object = :Equip;

    IF iirowcount <= 0 THEN
       CALLPROC TraceError (UserMessage = 
               'ERROR: Isolation Trace Equipment not found in database',
                            TraceMessage =
               'IsolationTrace: Equip Object ' + 
               VARCHAR(Equip) + ' not found in database.' 
                            );
       RETURN (PU_OK);
    ENDIF;
/*
** TFMS Isolation trace requires card to limit scope
*/
    IF Card = 0 THEN
       CALLPROC TraceError (UserMessage = 
               'ERROR: TFMS Isolation Trace called without passing Card ID.  CALL TECH SUPPORT.',
                            TraceMessage =
               'IsolationTrace Error: TFMS Card parameter is zero.' 
                            );
       RETURN (PU_OK);
    ENDIF;
/*
** Limit scope to card line objects
*/
    i = 1;
    REPEATED
    SELECT :LineEquipScope[i].Value = G.Member
    FROM   SOA_ActiveObject AO,
           Udb_Grouping G
    WHERE  AO.Card = :Card AND
           AO.ObjectToCardLink = 1 AND
           AO.Object = G.Grouping AND
           G.Relationship = :Interaction$MemberOf 
    BEGIN
       i = i + 1;
    END;
/*
** Prepare the trace loop
*/
   Trace.JCEquip.Object = Equip;
   Trace.TargetTypeList[1].Value = IsolatedFromType;
   
   Trace.UsePendingStatus = FALSE;
   
   Trace.LineEquipScope = LineEquipScope;
   TraceStatus = Trace.StartTargetTrace(StartEquipObject = StartEquip.Object,
                                        StartEquipSubstation = StartEquip.PrimaryGrouping);

   IF TraceStatus = TraceStatus$TargetFound THEN
      IsolatedFromEquip = Trace.TargetEquip.Object;
      RETURN(PU_OK);
   ELSE
      RETURN(PU_CANCEL);
   ENDIF; 
END;  

