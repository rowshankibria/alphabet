                  'for username ' + UserName + ' if not manually ' +
                  'cleared.'
                  );
      ENDIF;

   RETURN (PU_OK); 
END; 

Application Component Report
============================

	Name:            PromptClose101FromLoad

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptClose101FromLoad         
**
**  Modifications:
**        07/30/93 em	Created
**        07/07/94 em   added return code processing 
**        11/04/02 em   J to JIP
*/
INITIALIZE                         
(
    JIP = JobInProgress;		        /* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER;
    ATS = ObjectSummaryClass;
) =
BEGIN
/*
**  Using connectivity in Database, find ATS 101 object from load side
*/ 
  SELECT :ATS.Object = T2.Object
  FROM   Udb_Terminal T1,
         Udb_Terminal T2,
         Udb_Object O
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 1 AND      /* Terminal 1 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND          /* Terminal 2 */
         T2.Object = O.Object AND
         O.Type IN (SELECT Type
                    FROM   Udb_ExtendedType
                    WHERE  SuperType = :Type$ATS101);

  RetCode = CALLPROC FMS_ObjStatDel(Object = ATS.Object,
                          Status = Status$Open);
  IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      RETURN (PU_CANCEL);
  ENDIF;

  RETURN (PU_OK);

END;

