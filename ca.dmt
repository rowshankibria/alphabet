	Name:            CalculateTotal

/*
**  Copyright c 1993 ESCA Corporation  All rights reserved.
**
**  ESCA Corporation proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of ESCA Corporation. 
*/
/*
**  Application:    FeederCard
**  Procedure:      CalculateTotal
**
**  Modifications:
**  06/12/00   pkw  Initial
*/
PROCEDURE CalculateTotal
(
   CT = ARRAY OF INTEGEROBJECT;  
   Total = INTEGER NOT NULL;  
   i = INTEGER NOT NULL;                                          
) =
BEGIN
/*
**  Find total Value for array or integerobject passed in.
*/
   Total = 0;

   i = 1;
   WHILE i <= CT.LastRow() DO
      Total = Total + CT[i].Value;
      i = i + 1;
   ENDWHILE;

   RETURN Total;
END;

Application Component Report
============================

	Name:            CancelAutomation

/*
**
**	Copyright c 2004 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software.
**
**  Application:    CAC
**  Frame:          CancelAutomation
**
**  03/31/04  em    Created
**  11/16/05  em    Delete the Outgoing message when stopping automation.
*/
PROCEDURE CancelAutomation
(
   Card   	= INTEGER NOT NULL		/*Parameter*/   
) =
DECLARE
   Block       	= INTEGER NOT NULL WITH DEFAULT;
   MsgKey       = INTEGER NOT NULL WITH DEFAULT;
   Object       = INTEGER NOT NULL WITH DEFAULT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   SendTo       = CHAR(3) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** For each other outstanding ISSUED block, Change status to MANUAL
*/       
   SELECT :Block = Block,
          :SendTo = SendTo
   FROM   FMS_AutomationBlock
   WHERE  Card = :Card AND
          BlockStatus = :BlockStatus$Issued
   BEGIN
      RetCode = CALLPROC FMS_AutoBlockStopUpd (
                                Card = Card,
                                Block = Block,
                                BlockStatus = BlockStatus$Manual,
                                BlockStopped = 'now',
                                StopReason = 'Process Automation Stopped - ' +
                                              'This block goes Manual.');
      IF RetCode = 0 THEN 
         CALLPROC DDB_COMMIT;
         
         MsgKey = 0;
         IF SendTo = 'SSO' THEN
            SELECT :MsgKey = MsgKey,
                   :Object = Substation
            FROM    IR_OperatingOrder
            WHERE   OrderNumber = :Block;
         ELSE
            SELECT :MsgKey = MsgKey,
                   :Object = Feeder
            FROM    IR_FODOrder
            WHERE   OrderNumber = :Block;
         ENDIF;
             
         IF MsgKey <> 0 THEN
            RetCode = CALLPROC MSG_UpdateMsg (Card = Card,
                                  Ack = Ack$Delete,
                                  MsgKey = MsgKey,
                                  AckByOpName = 'Automation Stopped',
                                  AckDate = date('now'),
                                  DelByOpName = 'Automation Stopped',
                                  DelDate = date('now'),
                                  Substation = Object
                                  );
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = '',TraceMessage =
                      ' Automation '
          +           'stopped but unable to delete outgoing message '  
          +           VARCHAR(MsgKey)
          );
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;

      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',TraceMessage =
                      ' Cancel Automation '
          +           'unable to set Automatic Block status '
          +           'to Manual for card ' + VARCHAR(Card)
          );
         RETURN(PU_CANCEL);  
      ENDIF;
   END;

   SELECT :Block = Block,
          :SendTo = SendTo
   FROM   FMS_AutomationBlock
   WHERE  Card = :Card AND
          BlockStatus IN (:BlockStatus$SetUp,:BlockStatus$Wait)
   BEGIN
      RetCode = CALLPROC FMS_AutoBlockDel (
                          Card = Card,
                          OrderNumber = Block,
                          OrderType = SendTo,
                          CancelStatus = BlockStatus$Cancelled);
      IF RetCode = 0 THEN 
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = '',TraceMessage =
                      'Cancel Automation: '
          +           'Unable to set Automatic Block ' + VARCHAR(Block) 
          +           'to Cancelled and delete related order for ' + SendTo + '.'
          );
         RETURN(PU_CANCEL);  
      ENDIF;
   END;

   RETURN (PU_OK);
END;


