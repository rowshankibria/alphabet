Application Component Report
============================

	Name:            FMS_RelaySummary_09102019

/**
 **
 **  Copyright c 1996 Unified Information, Inc.  All rights reserved.
 **
 **  Unified Information, Inc. proprietary and trade secret information.
 **  Do not copy or disclose to third parties without written permission
 **  from an officer of Unified Information, Inc.
 **
 **
 **  Application:    CAC
 **  Frame:          FMS_RelaySummary
 **
 **  Modification log:
 **
 **  Date:     Version   Description 
 ** --------------------------------------------------        
 **  10/29/96    ysp     Initial Version: modified from SLC          
 **  04/02/97    jfl     itc39: Support for archived item
 **                      Expected Mode for Archived Card is FM_READ
 **  07/25/98    em      Exclude Groupers from Equipment list
 **  05/01/00    em      card control change
 **  09/18/01    em      Minor adjustment to better support returned relays
 **  07/16/02    ysp     Merge: use an include script to handle card control.
 **  12/23/02    ysp     Explicitly call soa_logins to log card relays update.
 **  03/30/09    ysp     Downlad relay to Feederboard
 **  04/03/09    ysp     Moved from the FeederCard app. Prompt DO to select the
 **                      SSO who returns the relay infor and insert log.
 **  08/24/10    em      Updates for 3G Card
 **  12/22/11    pkw     Use Relay classes to load data to be consistent with FMS Online.
 **                      Update class to use update mode and allow PDF report callup.
 **  12/27/16    ysp     query equipment from the archive card to object table for archived cards.
 **  11/15/18    ysp     Add seventh parameter for pdf script
 **  08/08/19    em      Highlight 46T if operated
**/

INITIALIZE   
(
/* passed in */
    C = FMS_Card;                                 /*P: Passed card */
    ArchiveCard = INTEGER NOT NULL WITH DEFAULT;  /*P: Passed boolean */
 
/* local variables */
#   include StandardDeclarations

    j = integer NOT NULL WITH DEFAULT;         /*Local: Temporary counter */
    x = integer NOT NULL WITH DEFAULT;
    y = integer NOT NULL WITH DEFAULT;
    ChangeMade = integer NOT NULL WITH DEFAULT;

    RowNum = INTEGER NOT NULL WITH DEFAULT;    /* Row Number */ 
    FoundIt = SMALLINT NOT NULL WITH DEFAULT;
    RelayOpList = ARRAY OF CAC_Relay;          /*Local: Array of existing relay operations */
    RelayTypes = Array of CAC_RelayType;       /*Local: List of RelayTypes */ 
    RelayClasses = ARRAY of CAC_RelayClass;    /*Local: RelayClass Hierarchy */

    FeederRelayEquip = ARRAY OF CAC_Relay;  
    CurRelay = CAC_RelayType;
    CurRelayClass = CAC_RelayClass;
    CurRelayEquip = CAC_Relay;  
    TempString = VARCHAR(40);  

    RelayClassChoiceList = ChoiceList  NOT NULL WITH DEFAULT;    /*Local: ChoiceList of RelayClasses */
    ProcessWindow = FrameExec;

    OpenAutoEquip = ARRAY OF CAC_Relay;
    AllEquip = ARRAY OF CAC_Relay;

    TIDistBack = ARRAY OF CAC_Relay;
    OtherDistBack = ARRAY OF CAC_Relay;   
    OtherBack = ARRAY OF CAC_Relay;   
    SimpleRelay = Relay_ASE DEFAULT NULL; /* Enables use of class methods */
) =
BEGIN
/**
 **  Ahem!
 **  Clear your arrays.
 **/
/* clear equip tables which allow users to select for "Other Relays" */
    Equip.Clear();
    OpenAutoEquip.Clear();
    AllEquip.Clear();

/* clear the list of relays which operated. */
    RelayOpList.Clear(); 

/* clear the three user-interface tables: 1) TIME & INST., 2) Other Dist., 
** 3) Other Relay
*/
    TIDistributionRelays.Clear(); 
    OtherDistributionRelays.Clear();
    OtherRelays.Clear();

    TIDistBack.Clear(); 
    OtherDistBack.Clear();
/**
 **  Open the process indicator window
 **/
    ProcessWindow = OPENFRAME ProcessIndicator
                                (ParentFrame = CurFrame,
                                 Pct_Title = 'Building Relay List...',
                                 MaxValue = 100);
    ProcessWindow.SendUserEvent(EventName = 'Update_Percent',
                                MessageInteger = 1);
    CurFrame.WaitFor(EventName = 'Received');

/*  retrieve card relay information. */
    IF ArchiveCard = FALSE THEN
        SELECT Relays = C.Relays
        FROM   FMS_Card C
        WHERE  C.Card = :C.Card;
    ELSE
        SELECT Relays = C.Relays
        FROM   FMS_ArchiveCard C
        WHERE  C.Card = :C.Card;
    ENDIF;
    CALLPROC DDB_ROLLBACK;
/*
**  Load relay info
*/
    IF SimpleRelay IS NULL THEN
       SimpleRelay = Relay_ASE.Create();
    ENDIF;
     
    SimpleRelay.Card = C.Card;    
    SimpleRelay.ArchiveCard = ArchiveCard;
    SimpleRelay.CardType = Type$FMSApp;
    SimpleRelay.SwitchingItem = 0;
    SimpleRelay.UpdateMode = 1;  /* Always load all data */
    
    SimpleRelay.LoadRelaySummary();
   
    IF SimpleRelay.ReturnCode <> 0 THEN
       Message SimpleRelay.ErrorMessage;
       RETURN;
    ENDIF;
   
    RelayClasses = SimpleRelay.RClasses.Duplicate();
    RelayTypes   = SimpleRelay.RTypes.Duplicate();
    RelayOpList  = SimpleRelay.ROpList.Duplicate();
/*
**  Select all of the relay types into the choicelist.  Do this before 
**  duplicating other relay list so that .relayclass field is not overwritten.
*/
    RelayClassChoiceList.ChoiceItems.Clear();
    RelayClassChoiceList.ChoiceItems[1].EnumText = '';
    RelayClassChoiceList.ChoiceItems[1].EnumValue = 0;
/**
 **  Insert the relay types into the class hierarchy.
 **/
    i = 1;
    WHILE i <= RelayClasses.LastRow() DO
       RelayClassChoiceList.ChoiceItems[i+1].EnumText = RelayClasses[i].RelayClassName;
       RelayClassChoiceList.ChoiceItems[i+1].EnumValue = RelayClasses[i].RelayClass;

       j = 1;
       WHILE j <= RelayTypes.LastRow() DO
          IF RelayClasses[i].RelayClass = RelayTypes[j].Type THEN
              RelayClasses[i].RelayList.InsertRow( RowNumber = RelayClasses[i].RelayList.LastRow() + 1,
                                                   RowObject = RelayTypes[j] );
          ENDIF;
          j = j + 1;
       ENDWHILE;
       i = i + 1;
    ENDWHILE;
    ENUMFIELD(FIELD(OtherRelays[*].RelayClass).ProtoField).ValueList = RelayClassChoiceList;

    TIDistributionRelays = SimpleRelay.RSDist.Duplicate();   
    OtherDistributionRelays = SimpleRelay.RSOtherDist.Duplicate();
    OtherRelays = SimpleRelay.RSOther.Duplicate();

    SimpleRelay = NULL;
/*
** Highlight 46T
*/
    FOR i = 1 TO OtherDistributionRelays.LastRow DO
       IF OtherDistributionRelays[i].RelayTypeName = '46T' AND 
          OtherDistributionRelays[i].GenericInt1 = TRUE THEN
          FIELD(OtherDistributionRelays[i].RelayTypeName).BgColor = CC_YELLOW;
          FIELD(OtherDistributionRelays[i].GenericInt1).BgColor = CC_YELLOW;
          FIELD(OtherDistributionRelays[i].TimeStamp).BgColor = CC_YELLOW;
      ENDIF;
    ENDFOR;
/*
**   Load both equip arrays: openauto and All
*/      
    i = 1;
    IF ArchiveCard = FALSE THEN
        REPEATED
        SELECT DISTINCT
                :OpenAutoEquip[i].Equip = J.Equip,
                :OpenAutoEquip[i].EquipName = J.EquipName,
                :OpenAutoEquip[i].EquipClass = J.EquipClass,
                :OpenAutoEquip[i].EquipClassName = J.EquipClassName,
                :OpenAutoEquip[i].Description = O.Description  
        FROM    SOA_JobControl JC,
                SOA_Job J,
                Udb_Grouping G,
                Udb_Object O,
                TFMS_CardToObject CTO
        WHERE   JC.Card = :C.Card AND
                JC.Job = J.Job AND
                J.Status != 'Pur' AND
                J.Status != 'Del' AND
                J.EquipClass IN (SELECT EquipClass
                                 FROM FMS_OpenAutoEquip)  AND
                J.Equip = G.Member AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                J.Equip = O.Object           
        BEGIN
            i = i + 1; 
        END;
        CALLPROC DDB_ROLLBACK;

        /**
        **  Select all of the equipment that are members of the feeder.
        **/
        i = 1;                                                       
        REPEATED
        SELECT  :AllEquip[i].Equip = O.Object, 
                :AllEquip[i].EquipName = O.Name,
                :AllEquip[i].EquipClass  = O.Type,
                :AllEquip[i].EquipClassName  = O.TypeName,
                :AllEquip[i].Description = O.Description
        FROM    Udb_Object O,
                Udb_Grouping G,
                Udb_ExtendedType E,
                TFMS_CardToObject CTO
        WHERE   G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = O.Object AND 
                O.Type NOT IN (:Type$AbstractHTV,
                               :Type$ISOGrouper,
                               :Type$Loop) AND 
                G.MemberType = E.Type AND
                E.SuperType = :Type$Switch 
        ORDER BY Description, EquipName 
        BEGIN
                i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;
 
    ELSE
        REPEATED
        SELECT DISTINCT
                :OpenAutoEquip[i].Equip = J.Equip,
                :OpenAutoEquip[i].EquipName = J.EquipName,
                :OpenAutoEquip[i].EquipClass = J.EquipClass,
                :OpenAutoEquip[i].EquipClassName = J.EquipClassName,
                :OpenAutoEquip[i].Description = O.Description  
        FROM    FMS_ArchiveJob J,
                Udb_Grouping G,
                Udb_Object O,
                TFMS_ArchiveCardToObject CTO
        WHERE   J.Card = :C.Card AND
                J.Status != 'Pur' AND
                J.Status != 'Del' AND
                J.EquipClass IN (SELECT EquipClass
                                 FROM FMS_OpenAutoEquip)  AND
                J.Equip = G.Member AND
                G.RelationShip = :Interaction$MemberOf AND
                G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                J.Equip = O.Object           
        BEGIN
            i = i + 1; 
        END;
        CALLPROC DDB_ROLLBACK;

        /**
        **  Select all of the equipment that are members of the feeder.
        **/
        i = 1;                                                       
        REPEATED
        SELECT  :AllEquip[i].Equip = O.Object, 
                :AllEquip[i].EquipName = O.Name,
                :AllEquip[i].EquipClass  = O.Type,
                :AllEquip[i].EquipClassName  = O.TypeName,
                :AllEquip[i].Description = O.Description
        FROM    Udb_Object O,
                Udb_Grouping G,
                Udb_ExtendedType E,
                TFMS_ArchiveCardToObject CTO
        WHERE   G.Grouping = CTO.Object AND
                CTO.Card = :C.Card AND
                G.Relationship = :Interaction$MemberOf AND
                G.Member = O.Object AND 
                O.Type NOT IN (:Type$AbstractHTV,
                               :Type$ISOGrouper,
                               :Type$Loop) AND 
                G.MemberType = E.Type AND
                E.SuperType = :Type$Switch 
        ORDER BY Description, EquipName 
        BEGIN
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;        
    ENDIF;

    ProcessWindow.SendUserEvent(EventName = 'Update_Percent',
                                MessageInteger = 25);
    CurFrame.WaitFor(EventName = 'Received');
/*
**  Default Equip to OpenAuto
*/
    IF OpenAutoEquip.LastRow() > 0 THEN
        Equip = OpenAutoEquip.Duplicate();
    ELSE 
        IF AllEquip.LastRow() > 0 THEN
            Message 'No Open Auto Equip.  Equip List defaults to All Equip.';
            Equip = AllEquip.Duplicate();
            Equip_choice = 2;
        ELSE
            CurFrame.InfoPopup(MessageText =
                            'No Eligible Equipment Found', 
                            MessageType = MT_WARNING);
            RETURN;
        ENDIF; 
    ENDIF;

    ProcessWindow.SendUserEvent(EventName = 'Update_Percent',
                                MessageInteger = 100);
    CurFrame.WaitFor(EventName = 'Received');
    ProcessWindow.Terminate();

    CurFrame.BringToFront();
    CurFrame.Flush();   

/* save current setting for table 1 and table 2, we will use it 
** for REVIEW/UPDATE option 
*/
    TIDistBack = TIDistributionRelays.Duplicate();
    OtherDistBack = OtherDistributionRelays.Duplicate();
    OtherBack = OtherRelays.Duplicate();

    CurFrame.IsAutoSized = TRUE;
    CurFrame.Flush();
/*
** for archived card, force display review only mode
** of Time/Instantaneous Distribution Feeder Relays
*/
    IF ArchiveCard = TRUE THEN
        Relay_View = 2;
        CurFrame.SendUserEvent( eventname = 'ForceReviewOnly' );
    ENDIF;
END;


/**
 **  Color the selected Relay
 **/
ON ChildSetValue OtherRelays[*].RelayClass = 
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
       RESUME;
    ENDIF;

    RowNum = FIELD(OtherRelays).CurRow;
    i = 1;
    WHILE i <= RelayClassChoiceList.ChoiceItems.LastRow() DO
       IF RelayClassChoiceList.ChoiceItems[i].EnumValue =
          OtherRelays[RowNum].RelayClass THEN
          OtherRelays[RowNum].RelayClassName = RelayClassChoiceList.ChoiceItems[i].EnumText;
          ENDLOOP;
       ELSE
          i = i + 1;
       ENDIF;
    ENDWHILE;
END;

ON ChildEntry OtherRelays[*].EquipName,
ON ChildEntry OtherRelays[*].EquipClassName,
ON ChildEntry OtherRelays[*].TimeStamp =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;

    RowNum = FIELD(OtherRelays).CurRow;
    
    IF (FIELD(OtherRelays[RowNum].EquipClassName).IsReverse = FALSE) THEN
        FIELD(OtherRelays[RowNum].EquipClassName).IsReverse = TRUE;
        FIELD(OtherRelays[RowNum].EquipName).IsReverse = TRUE;     
        FIELD(OtherRelays[RowNum].TimeStamp).IsReverse = TRUE;        
    ELSE
        FIELD(OtherRelays[RowNum].EquipClassName).IsReverse = FALSE;
        FIELD(OtherRelays[RowNum].EquipName).IsReverse = FALSE;
        FIELD(OtherRelays[RowNum].TimeStamp).IsReverse = FALSE;     
    ENDIF;

    CurFrame.Flush();
END;


/**
 **  Handle selection of Time and instantanious
 **  in Time Instantaneous Distribution Relays
 **/
ON ChildEntry TIDistributionRelays[*].GenericInt1,
ON ChildEntry TIDistributionRelays[*].GenericInt2 =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;
    
    RowNum = FIELD(TIDistributionRelays).CurRow;

    IF (CurFrame.TriggerField.name like '%genericint1%') THEN
       IF ( TIDistributionRelays[RowNum].GenericInt1 = TRUE ) THEN

          TIDistributionRelays[RowNum].GenericInt1 = FALSE; 

          IF ( TIDistributionRelays[RowNum].GenericInt2 = FALSE ) THEN  
             TIDistributionRelays[RowNum].TimeStamp = Date(' ');
          ENDIF;
       ELSE
          TIDistributionRelays[RowNum].GenericInt1 = TRUE; 
          TIDistributionRelays[RowNum].TimeStamp = Date('now');
       ENDIF;
    ELSE
       IF ( TIDistributionRelays[RowNum].GenericInt2 = TRUE ) THEN

          TIDistributionRelays[RowNum].GenericInt2 = FALSE;

          IF ( TIDistributionRelays[RowNum].GenericInt1 = FALSE ) THEN  
             TIDistributionRelays[RowNum].TimeStamp = Date(' ');
          ENDIF;
       ELSE
          TIDistributionRelays[RowNum].GenericInt2 = TRUE;
          TIDistributionRelays[RowNum].TimeStamp = Date('now');
       ENDIF;
    ENDIF;
/** 
 **  Remember False = 0, True = 1
 **/
    TIDistributionRelays[RowNum].Operation =
        ( ( TIDistributionRelays[RowNum].GenericInt1 * RelayOp$Instantaneous ) +
          ( TIDistributionRelays[RowNum].GenericInt2 * RelayOp$Time ) );   

    TIDistBack[RowNum].Status = 'Chg';          /* changed */

    RESUME; /* you need this, otherwise, you won't be able to toggle it */
END;

/**
 **  Handle selection of Operation
 **/
ON ChildEntry OtherDistributionRelays[*].GenericInt1 =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;

    RowNum = FIELD(OtherDistributionRelays).CurRow;

    IF ( OtherDistributionRelays[RowNum].GenericInt1 = TRUE ) THEN
        OtherDistributionRelays[RowNum].GenericInt1 = FALSE; 
        OtherDistributionRelays[RowNum].TimeStamp = Date(' ');
        OtherDistributionRelays[RowNum].Operation = RelayOp$None;
    ELSE
        OtherDistributionRelays[RowNum].GenericInt1 = TRUE;     
        OtherDistributionRelays[RowNum].TimeStamp = Date('now');
        OtherDistributionRelays[RowNum].Operation = RelayOp$Normal;
    ENDIF;

    OtherDistBack[RowNum].Status = 'Chg';

    RESUME;  /* you need this, otherwise, you won't be able to toggle it */
END;


/**
 **  Color the selected equip
 **/
ON ChildEntry Equip =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK 
       OR ArchiveCard = TRUE THEN
        RESUME;
    ENDIF;

    RowNum = FIELD(Equip).CurRow;

    OtherRelays.InsertRow( RowNumber = OtherRelays.LastRow() + 1,
                           RowObject = Equip[RowNum].Duplicate());
    OtherRelays[OtherRelays.LastRow()].TimeStamp = DATE('now');
END;

/**
 **  Delete the selected row from the list
 **/
ON CLICK RemoveSelectedRelays =
BEGIN
    i = 1;
    WHILE i <= OtherRelays.LastRow() DO

       IF (FIELD(OtherRelays[i].EquipName).IsReverse = TRUE ) THEN
          OtherRelays.RemoveRow( RowNumber = i );
       ENDIF;

       i = i + 1;
    ENDWHILE;
END;

      
/**
 **  Handle an OK click, Insert new moves into card
 **/
ON Click OK_Btn =
BEGIN
    IF (FIELD(Relays).HasDataChanged = TRUE) THEN
       CALLPROC FMS_CardRelaysUpd (NewRelays = Relays,
                                   Card = C.Card);
       CALLPROC DDB_COMMIT;

       CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = C.Relays,
                 New  = Relays);
       CALLPROC DDB_COMMIT;
    ENDIF;

/*
**  Loop through the backup copy (TIDistBack) of the first table 
**  (TIDistributionRelays):
**  delete, update or insert an entry accordingly in the CAC_RelayOps 
**  db table.
*/
    ChangeMade = FALSE;

    i = 1;
    WHILE i <= TIDistBack.LastRow() DO
       /* we are interested in those changed */
       IF TIDistBack[i].Status = 'Chg' THEN     
          ChangeMade = TRUE;

          Foundit = FALSE;
          j = 1;
          WHILE (Foundit = FALSE AND j <= TIDistributionRelays.LastRow()) DO
             IF TIDistributionRelays[j].Status = '' THEN
                IF (TIDistBack[i].FeederName = TIDistributionRelays[j].FeederName  AND
                   TIDistBack[i].Equip = TIDistributionRelays[j].Equip AND
                   TIDistBack[i].RelayType = TIDistributionRelays[j].RelayType) THEN

                   Foundit = TRUE;
                ELSE
                   j = j + 1;
                ENDIF
             ELSE
                j = j + 1;
             ENDIF;
          ENDWHILE;

          IF Foundit = TRUE then
             IF (TIDistBack[i].Operation <> RelayOp$None  AND  
                 TIDistributionRelays[j].Operation = RelayOp$None ) THEN
                
                RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                             CardType = Type$FMSApp,
                                             Card     = C.Card,
                                             RelayOp = TIDistBack[i].RelayOp );
                
             ELSEIF (TIDistBack[i].Operation = RelayOp$None  AND  
                     TIDistributionRelays[j].Operation <> RelayOp$None ) THEN

                RetCode = CALLPROC CAC_InsertRelayOpForAll( 
                                       CardType = Type$FMSApp,
                                       Card = C.Card,
                                       Line = -1,
                                       FeederName = TIDistributionRelays[j].FeederName,
                                       Equip = TIDistributionRelays[j].Equip,
                                       EquipName = TIDistributionRelays[j].EquipName,
                                       EquipClass = TIDistributionRelays[j].EquipClass,
                                       EquipClassName = TIDistributionRelays[j].EquipClassName,
                                       RelayTypeName = TIDistributionRelays[j].RelayTypeName,
                                       RelayType =  TIDistributionRelays[j].RelayType,
                                       RelayClass = TIDistributionRelays[j].RelayClass,
                                       RelayClassName = TIDistributionRelays[j].RelayClassName,
                                       RelayName = TIDistributionRelays[j].RelayName,
                                       Operation = TIDistributionRelays[j].Operation,
                                       TimeStamp = TIDistributionRelays[j].TimeStamp
                                       );  
                 
             ELSEIF (TIDistBack[i].Operation <> TIDistributionRelays[j].Operation) THEN

                RetCode = CALLPROC CAC_UpdateRelayOpForAll( 
                                       CardType = Type$FMSApp,
                                       Card     = C.Card,
                                       RelayOp = TIDistBack[i].RelayOp,
                                       Line = -1,
                                       FeederName = TIDistributionRelays[j].FeederName,
                                       Equip = TIDistributionRelays[j].Equip,
                                       EquipName = TIDistributionRelays[j].EquipName,
                                       EquipClass = TIDistributionRelays[j].EquipClass,
                                       EquipClassName = TIDistributionRelays[j].EquipClassName,
                                       RelayTypeName = TIDistributionRelays[j].RelayTypeName,
                                       RelayType =  TIDistributionRelays[j].RelayType,
                                       RelayClass = TIDistributionRelays[j].RelayClass,
                                       RelayClassName = TIDistributionRelays[j].RelayClassName,
                                       RelayName = TIDistributionRelays[j].RelayName,
                                       Operation = TIDistributionRelays[j].Operation,
                                       TimeStamp = TIDistributionRelays[j].TimeStamp
                                       );
             ENDIF;

             /* we don't need to check with this entry again */
             TIDistributionRelays.RemoveRow (RowNumber = j); 

          ELSEIF Foundit = FALSE THEN    /* the table must be in review mode now */
             IF TIDistBack[i].Operation <> RelayOp$None THEN
                RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                             CardType = Type$FMSApp,
                                             Card     = C.Card,
                                             RelayOp = TIDistBack[i].RelayOp );
             ENDIF;
          ENDIF;
       ENDIF;            /* changed entry */
       i = i + 1;
    ENDWHILE;            /* TIDistBack loop */

/*
**  Loop through the backup copy (OtherDistBack) of the second table 
**  (OtherDistributionRelays):
**  delete or insert an entry accordingly in the CAC_RelayOps 
**  db table.
*/
    i = 1;
    WHILE i <= OtherDistBack.LastRow() DO
       /* we are interested in those changed */
       IF OtherDistBack[i].Status = 'Chg' THEN     
          ChangeMade = TRUE;

          Foundit = FALSE;
          j = 1;
          WHILE (Foundit = FALSE AND j <= OtherDistributionRelays.LastRow()) DO
             IF OtherDistributionRelays[j].Status = '' THEN
                IF (OtherDistBack[i].FeederName = OtherDistributionRelays[j].FeederName  AND
                    OtherDistBack[i].Equip = OtherDistributionRelays[j].Equip AND
                    OtherDistBack[i].RelayType = OtherDistributionRelays[j].RelayType) THEN

                   Foundit = TRUE;
                ELSE
                   j = j + 1;
                ENDIF
             ELSE
                j = j + 1;
             ENDIF;
          ENDWHILE;

          IF Foundit = TRUE then
            IF (OtherDistBack[i].Operation <> RelayOp$None and 
                OtherDistributionRelays[j].Operation = RelayOp$None ) THEN
               
                RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                             CardType = Type$FMSApp,
                                             Card     = C.Card,
                                             RelayOp = OtherDistBack[i].RelayOp );
            ELSEIF (OtherDistBack[i].Operation = RelayOp$None and 
                    OtherDistributionRelays[j].Operation <> RelayOp$None ) THEN

                RetCode = CALLPROC CAC_InsertRelayOpForAll(
                                       CardType = Type$FMSApp, 
                                       Card = C.Card,
                                       Line = -1,
                                       FeederName = OtherDistributionRelays[j].FeederName,
                                       Equip = OtherDistributionRelays[j].Equip,
                                       EquipName = OtherDistributionRelays[j].EquipName,
                                       EquipClass = OtherDistributionRelays[j].EquipClass,
                                       EquipClassName = OtherDistributionRelays[j].EquipClassName,
                                       RelayTypeName = OtherDistributionRelays[j].RelayTypeName,
                                       RelayType =  OtherDistributionRelays[j].RelayType,
                                       RelayClass = OtherDistributionRelays[j].RelayClass,
                                       RelayClassName = OtherDistributionRelays[j].RelayClassName,
                                       RelayName = OtherDistributionRelays[j].RelayName,
                                       Operation = OtherDistributionRelays[j].Operation,
                                       TimeStamp = OtherDistributionRelays[j].TimeStamp
                                       );  
            ENDIF;

            /* we don't need to check with this entry again */
            OtherDistributionRelays.RemoveRow (RowNumber = j); 

          ELSEIF Foundit = FALSE THEN    /* the table must be in review mode now */
             IF OtherDistBack[i].Operation <> RelayOp$None THEN
                RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                             CardType = Type$FMSApp,
                                             Card     = C.Card,
                                             RelayOp = OtherDistBack[i].RelayOp );
             ENDIF;
          ENDIF;
       ENDIF;          /* changed entry */
       i = i + 1;
    ENDWHILE;          /* OtherDistBack loop */

/*
**  Loop through the backup copy (OtherBack) of the third table 
**  (OtherRelays):
**  delete or update an entry accordingly in the CAC_RelayOps 
**  db table.
*/
    i = 1;
    WHILE i <= OtherBack.LastRow() DO
       Foundit = FALSE;
       j = 1;
       WHILE (Foundit = FALSE AND j <= OtherRelays.LastRow()) DO
          IF OtherBack[i].RelayOp = OtherRelays[j].RelayOp THEN

             Foundit = TRUE;
          ELSE
             j = j + 1;
          ENDIF
       ENDWHILE;

       IF Foundit = TRUE then
          IF (OtherBack[i].Line <> OtherRelays[j].Line OR
              OtherBack[i].RelayName <> OtherRelays[j].RelayName OR
              OtherBack[i].RelayClass <> OtherRelays[j].RelayClass) THEN
          
              RetCode = CALLPROC CAC_UpdateRelayOpForAll( 
                                    CardType = Type$FMSApp,
                                    Card     = C.Card,
                                    RelayOp = OtherBack[i].RelayOp,
                                    Line = OtherRelays[j].Line,
                                    FeederName = OtherRelays[j].FeederName,
                                    Equip = OtherRelays[j].Equip,
                                    EquipName= OtherRelays[j].EquipName,
                                    EquipClass = OtherRelays[j].EquipClass,
                                    EquipClassName = OtherRelays[j].EquipClassName,
                                    RelayTypeName = OtherRelays[j].RelayTypeName,
                                    RelayType =  OtherRelays[j].RelayType,
                                    RelayClass = OtherRelays[j].RelayClass,
                                    RelayClassName = OtherRelays[j].RelayClassName,
                                    RelayName = OtherRelays[j].RelayName,
                                    Operation = OtherRelays[j].Operation,
                                    TimeStamp = OtherRelays[j].TimeStamp
                                    );
          ENDIF;
          /* we don't need to check with this entry again */
          OtherRelays.RemoveRow(RowNumber = j);

       ELSEIF Foundit = FALSE THEN    
          RetCode = CALLPROC CAC_DeleteRelayOpForAll( 
                                             CardType = Type$FMSApp,
                                             Card     = C.Card,
                                             RelayOp = OtherBack[i].RelayOp );
       ENDIF;
       i = i + 1;
    ENDWHILE;            /* OtherRelay loop */

/*
**  Then loop through the third table and insert each into the table with
**  operation = RelayOp$Normal 
*/
    i = 1;
    WHILE i <= OtherRelays.LastRow() DO
       RetCode = CALLPROC CAC_InsertRelayOpForAll(
                              CardType = Type$FMSApp, 
                              Card = C.Card,
                              Line = OtherRelays[i].Line,
                              FeederName = OtherRelays[i].FeederName,
                              Equip = OtherRelays[i].Equip,
                              EquipName = OtherRelays[i].EquipName,
                              EquipClass = OtherRelays[i].EquipClass,
                              EquipClassName = OtherRelays[i].EquipClassName,
                              RelayTypeName = OtherRelays[i].RelayTypeName,
                              RelayType =  OtherRelays[i].RelayType,
                              RelayClass = OtherRelays[i].RelayClass,
                              RelayClassName = OtherRelays[i].RelayClassName,
                              RelayName = OtherRelays[i].RelayName,
                              Operation = OtherRelays[i].Operation,
                              TimeStamp = OtherRelays[i].TimeStamp
                              );  
       i = i + 1;
    ENDWHILE;  
/*
** download relay to feederboard (FSS)
*/    
    IF ChangeMade = TRUE THEN
       IF ArchiveCard = FALSE THEN
          CALLPROC DownloadRelayToFSS(Card = C.Card, ArchiveCard = ArchiveCard );
       ENDIF;
/*
** log the substation operator
*/
      RetCode = CALLFRAME SelectOperator (AnyName = TRUE, 
                                        Title = 'Select SSO that reported the Relay Targets');
       IF RetCode = PU_OK THEN
          CALLPROC SOA_LogIns (
                 Card = C.Card,
                 Job  = NULL,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Relays',
                 Old  = '',
                 New  = FO.Description + ' returned relay information');    
       ENDIF;
    ENDIF;

    RETURN;
END;

/*
**  Handle Review Mode Toggle
*/
On USEREVENT 'ForceReviewOnly',
ON CLICK Relay_View =
BEGIN

  IF Relay_View = 1 THEN      /* update mode */

     TIDistributionRelays.Clear();
     TIDistributionRelays = TIDistBack.Duplicate();
     ToggleField(FIELD(TIDistributionRelays[*].GenericInt1).ProtoField).CurBias = FB_CHANGEABLE;
     ToggleField(FIELD(TIDistributionRelays[*].GenericInt2).ProtoField).CurBias = FB_CHANGEABLE;

     OtherDistributionRelays.Clear();
     OtherDistributionRelays = OtherDistBack.Duplicate();
     ToggleField(FIELD(OtherDistributionRelays[*].GenericInt1).ProtoField).CurBias = FB_CHANGEABLE;

  ELSE                        /* review only */
     i = TIDistributionRelays.LastRow;
     WHILE i > 0 DO
        IF TIDistributionRelays[i].GenericInt1 = FALSE AND
           TIDistributionRelays[i].GenericInt2 = FALSE THEN
            TIDistributionRelays.RemoveRow (RowNumber = i);
        ENDIF;
        i = i - 1;
     ENDWHILE;

     ToggleField(FIELD(TIDistributionRelays[*].GenericInt1).ProtoField).CurBias = FB_VISIBLE;
     ToggleField(FIELD(TIDistributionRelays[*].GenericInt2).ProtoField).CurBias = FB_VISIBLE;

     i = OtherDistributionRelays.LastRow;
     WHILE i > 0 DO
        IF OtherDistributionRelays[i].GenericInt1 = FALSE AND
           OtherDistributionRelays[i].GenericInt2 = FALSE THEN
            OtherDistributionRelays.RemoveRow (RowNumber = i);
        ENDIF;
        i = i - 1;
     ENDWHILE;
       
     ToggleField(FIELD(OtherDistributionRelays[*].GenericInt1).ProtoField).CurBias = FB_VISIBLE;
  ENDIF;
END
/*
**  Handle Equipment choice toggle
*/
ON CLICK Equip_Choice =
BEGIN

  Equip.Clear();
  IF Equip_choice = 1 THEN

    IF OpenAutoEquip.LastRow() > 0 THEN
        Equip = OpenAutoEquip.Duplicate();
    ELSE 
        Message 'No Open Auto Equip.  Equip List defaults to All Equip.';
        Equip = AllEquip.Duplicate();
        Equip_choice = 2;
    ENDIF;

  ELSE
    Equip = AllEquip.Duplicate();
  ENDIF;
END;

/**  Handle an Cancel button click
 **  the user has chosen to postpone action.
 **/
ON Click Cancel_Btn =
BEGIN
    RETURN;
END;

/**
 **  Another desk has taken control of the card.  Parse dbevent text, 
 **  present message, and file card.
 **/
ON DBEvent 'fms_card_control_taken' =
BEGIN
#  include Card_Control

   RETURN;
END;

ON DBEvent 'CAC_RelayOp_Update' =
BEGIN
/*
**  Parse out the necessary information from the event text.
**  The event text is separated by ';' and may contain Action 
**  description (insert, update, delete), RelayOp index and
**  a list of cards.
*/
   ControlText = CurFrame.DBEvent.DBEventText;

   TempString = left(controltext,(locate(controltext,';')-1));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   x = int4(left(controltext,(locate(controltext,';')-1)));
   ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

   Foundit = FALSE;
   i = locate(ControlText,';');
   WHILE i <= size(ControlText) DO
       ControlCard = int4(left(ControlText,(locate(controltext,':')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,':'))));

       y = int4(left(ControlText,(locate(controltext,';')-1)));
       ControlText = shift(ControlText,(-1*(locate(ControlText,';'))));

       IF ControlCard = C.Card AND y = Type$FMSApp THEN
          Foundit = TRUE;
          ENDLOOP;
       ELSE
          i = locate(ControlText,';');
       ENDIF;
   ENDWHILE;
/*
** If our card is not in the card list, it has nothing to do with us. Quit.
*/
   IF Foundit = FALSE THEN
      RESUME;
   ENDIF;
/* 
** As long as the request is not to delete, retrieve new data from database 
*/
   IF TempString not like 'DELETE' THEN
      REPEATED
      SELECT :CurRelayEquip.RelayOp = R.RelayOp,
             :CurRelayEquip.Trip = R.Trip,
             :CurRelayEquip.Line = R.Line,
             :CurRelayEquip.FeederName = R.FeederName,
             :CurRelayEquip.Equip = R.Equip,
             :CurRelayEquip.EquipName = R.EquipName,
             :CurRelayEquip.EquipClass = R.EquipClass,
             :CurRelayEquip.EquipClassName = R.EquipClassName,
             :CurRelayEquip.RelayType = R.RelayType,
             :CurRelayEquip.RelayTypeName = R.RelayTypeName,
             :CurRelayEquip.RelayClass = R.RelayClass,
             :CurRelayEquip.RelayClassName = R.RelayClassName,
             :CurRelayEquip.RelayName = R.RelayName,
             :CurRelayEquip.Operation = R.Operation,
             :CurRelayEquip.TimeStamp = R.TimeStamp,
             :CurRelayEquip.OutOfService = R.OutOfService,
             :CurRelayEquip.Compromised = R.Compromised,
             :CurRelayEquip.Status = ''
      FROM    CAC_RelayOps R
      WHERE   R.RelayOp = :x;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   Foundit = FALSE;
   i = 1; 
   WHILE i <= RelayOpList.LastRow() DO
      IF RelayOpList[i].RelayOp = x THEN
         Foundit = TRUE;
         ENDLOOP;
      ELSE
         i = i + 1;
      ENDIF;
   ENDWHILE;
/*
** Find out which table needs to be updated. y points to the table.
*/
   y = 0;
   IF Foundit = TRUE THEN
      IF RelayOpList[i].GenericInt1 = 1 THEN
         y = 1;
      ELSEIF RelayOpList[i].GenericInt1 = 2 THEN
         y = 2;
      ELSEIF RelayOpList[i].GenericInt1 = 3 THEN
         y = 3;
      ENDIF;
   ELSEIF CurRelayEquip.Line <> -1 THEN
      y = 3;
   ELSEIF CurRelayEquip.Line = -1 AND
          CurRelayEquip.Operation = RelayOp$Normal THEN
      y = 2;
   ELSEIF CurRelayEquip.Line = -1 THEN
      y = 1;
   ENDIF;

/* Update list RelayOpList */
   IF TempString like 'INSERT' THEN   
      i = RelayOpList.LastRow() + 1;
      RelayOpList.InsertRow( RowNumber = i,
                          RowObject = CurRelayEquip.Duplicate());
      RelayOpList[i].Status = 'Upd';   /* already updated in one table */
      RelayOpList[i].GenericInt1 = y;

   ELSEIF TempString like 'UPDATE' THEN 
      RelayOpList[i] = CurRelayEquip.Duplicate();
      RelayOpList[i].GenericInt1 = y;
      RelayOpList[i].Status = 'Upd';   /* already updated in one table */

   ELSEIF TempString like 'DELETE' THEN   
      RelayOpList.RemoveRow (RowNumber = i);
   ENDIF;
/*
** Now we can work on each table per request.
*/
/*--------------------------------- table 1 ---------------------------------*/
   IF y = 1 THEN
      /* update visual table */
      IF Relay_View = 1 THEN      /* update mode */
         i = 1;
         WHILE i <= TIDistributionRelays.LastRow() DO
            IF (CurRelayEquip.FeederName = TIDistributionRelays[i].FeederName AND
                CurRelayEquip.Equip = TIDistributionRelays[i].Equip AND
                CurRelayEquip.RelayType = TIDistributionRelays[i].RelayType ) THEN

                ENDLOOP;
            ELSE
                i = i + 1;
            ENDIF;
         ENDWHILE; 
         
         IF i > TIDistributionRelays.LastRow() THEN
            Message 'A relay entry not found in T & I table.';
            RESUME;
         ENDIF;

         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            TIDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            TIDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            TIDistributionRelays[i].Operation = CurRelayEquip.Operation;

            IF CurRelayEquip.Operation = RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = FALSE;
               TIDistributionRelays[i].GenericInt2 = TRUE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = FALSE;

            ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous + RelayOp$Time THEN
               TIDistributionRelays[i].GenericInt1 = TRUE;
               TIDistributionRelays[i].GenericInt2 = TRUE;
            ENDIF;
         ELSE  /* DELETE */
            TIDistributionRelays[i].RelayOp = -1;
            TIDistributionRelays[i].TimeStamp = '';
            TIDistributionRelays[i].Operation = RelayOp$None;
            TIDistributionRelays[i].GenericInt1 = FALSE;
            TIDistributionRelays[i].GenericInt2 = FALSE;
         ENDIF;
      ELSE  /* review mode */    
         i = 1;
         WHILE i <= TIDistributionRelays.LastRow() DO
            IF (CurRelayEquip.FeederName = TIDistributionRelays[i].FeederName AND
                CurRelayEquip.Equip = TIDistributionRelays[i].Equip AND
                CurRelayEquip.RelayType = TIDistributionRelays[i].RelayType ) THEN

                ENDLOOP;
            ELSE
                i = i + 1;
            ENDIF;
         ENDWHILE; 
         
         IF i > TIDistributionRelays.LastRow() THEN
            IF TempString like 'INSERT' OR
               TempString like 'UPDATE' THEN

               i = TIDistributionRelays.LastRow() + 1;
               TIDistributionRelays.InsertRow( 
                                       RowNumber = i,
                                       RowObject = CurRelayEquip.Duplicate());
               TIDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
               TIDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
               TIDistributionRelays[i].Operation = CurRelayEquip.Operation;
   
               IF CurRelayEquip.Operation = RelayOp$Time THEN
                  TIDistributionRelays[i].GenericInt1 = FALSE;
                  TIDistributionRelays[i].GenericInt2 = TRUE;

               ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous THEN
                  TIDistributionRelays[i].GenericInt1 = TRUE;
                  TIDistributionRelays[i].GenericInt2 = FALSE;

               ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous + RelayOp$Time THEN
                  TIDistributionRelays[i].GenericInt1 = TRUE;
                  TIDistributionRelays[i].GenericInt2 = TRUE;
               ENDIF;
            ELSEIF TempString like 'DELETE' THEN
            ENDIF;
         ELSE
            IF TempString like 'INSERT' OR
               TempString like 'UPDATE' THEN
 
               TIDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
               TIDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
               TIDistributionRelays[i].Operation = CurRelayEquip.Operation;
   
               IF CurRelayEquip.Operation = RelayOp$Time THEN
                  TIDistributionRelays[i].GenericInt1 = FALSE;
                  TIDistributionRelays[i].GenericInt2 = TRUE;

               ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous THEN
                  TIDistributionRelays[i].GenericInt1 = TRUE;
                  TIDistributionRelays[i].GenericInt2 = FALSE;

               ELSEIF CurRelayEquip.Operation = RelayOp$Instantaneous + RelayOp$Time THEN
                  TIDistributionRelays[i].GenericInt1 = TRUE;
                  TIDistributionRelays[i].GenericInt2 = TRUE;
               ENDIF;
            ELSEIF TempString like 'DELETE' THEN
               TIDistributionRelays[i].RelayOp = -1;
               TIDistributionRelays[i].TimeStamp = '';
               TIDistributionRelays[i].Operation = RelayOp$None;
               TIDistributionRelays[i].GenericInt1 = FALSE;
               TIDistributionRelays[i].GenericInt2 = FALSE;
            ENDIF;
         ENDIF;
      ENDIF;

      /* update backup copy of the visual table */
      i = 1;
      WHILE i <= TIDistBack.LastRow() DO
         IF (CurRelayEquip.FeederName = TIDistBack[i].FeederName AND
             CurRelayEquip.Equip = TIDistBack[i].Equip AND
             CurRelayEquip.RelayType = TIDistBack[i].RelayType ) THEN

             ENDLOOP;
         ELSE
             i = i + 1;
         ENDIF;
      ENDWHILE; 

      IF i > TIDistBack.LastRow() THEN
         Message 'A relay entry not found in T & I back table.';
         RESUME;
      ENDIF;

      IF TempString like 'INSERT' OR
         TempString like 'UPDATE' THEN

         TIDistBack[i].RelayOp = CurRelayEquip.RelayOp;
         TIDistBack[i].TimeStamp = CurRelayEquip.TimeStamp;
         TIDistBack[i].Operation = CurRelayEquip.Operation;

         IF TIDistBack[i].Operation = RelayOp$Time THEN
            TIDistBack[i].GenericInt1 = FALSE;
            TIDistBack[i].GenericInt2 = TRUE;
         
         ELSEIF TIDistBack[i].Operation = RelayOp$Instantaneous THEN
            TIDistBack[i].GenericInt1 = TRUE;
            TIDistBack[i].GenericInt2 = FALSE;

         ELSEIF TIDistBack[i].Operation = RelayOp$Instantaneous + RelayOp$Time THEN
            TIDistBack[i].GenericInt1 = TRUE;
            TIDistBack[i].GenericInt2 = TRUE;
         ENDIF;

      ELSEIF TempString like 'DELETE' THEN
         TIDistBack[i].RelayOp = -1;
         TIDistBack[i].TimeStamp = '';
         TIDistBack[i].Operation = RelayOp$None;
         TIDistBack[i].GenericInt1 = FALSE;
         TIDistBack[i].GenericInt2 = FALSE;
      ENDIF;

/*------------------------------ table 2 ---------------------------------*/
   ELSEIF y = 2 THEN
      /* update visual table */
      IF Relay_View = 1 THEN      /* update mode */
         i = 1;
         WHILE i <= OtherDistributionRelays.LastRow() DO
            IF (CurRelayEquip.FeederName = OtherDistributionRelays[i].FeederName AND
                CurRelayEquip.Equip = OtherDistributionRelays[i].Equip AND
                CurRelayEquip.RelayType = OtherDistributionRelays[i].RelayType ) THEN

                ENDLOOP;
            ELSE
                i = i + 1;
            ENDIF;
         ENDWHILE; 
         
         IF i > OtherDistributionRelays.LastRow() THEN
            Message 'A relay entry not found in Other Dist table.';
            RESUME;
         ENDIF;

         IF TempString like 'INSERT' OR
            TempString like 'UPDATE' THEN

            OtherDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
            OtherDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
            OtherDistributionRelays[i].Operation = CurRelayEquip.Operation;
            OtherDistributionRelays[i].GenericInt1 = TRUE;
            OtherDistributionRelays[i].GenericInt2 = FALSE;

         ELSE  /* DELETE */
            OtherDistributionRelays[i].RelayOp = -1;
            OtherDistributionRelays[i].TimeStamp = '';
            OtherDistributionRelays[i].Operation = RelayOp$None;
            OtherDistributionRelays[i].GenericInt1 = FALSE;
            OtherDistributionRelays[i].GenericInt2 = FALSE;
         ENDIF;
      ELSE  /* review mode */    
         i = 1;
         WHILE i <= OtherDistributionRelays.LastRow() DO
            IF (CurRelayEquip.FeederName = OtherDistributionRelays[i].FeederName AND
                CurRelayEquip.Equip = OtherDistributionRelays[i].Equip AND
                CurRelayEquip.RelayType = OtherDistributionRelays[i].RelayType ) THEN

                ENDLOOP;
            ELSE
                i = i + 1;
            ENDIF;
         ENDWHILE; 
         
         IF i > OtherDistributionRelays.LastRow() THEN
            IF TempString like 'INSERT' OR
               TempString like 'UPDATE' THEN

               i = OtherDistributionRelays.LastRow() + 1;
               OtherDistributionRelays.InsertRow(RowNumber = i,
                                                 RowObject = CurRelayEquip.Duplicate());
               OtherDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
               OtherDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
               OtherDistributionRelays[i].Operation = CurRelayEquip.Operation;
               OtherDistributionRelays[i].GenericInt1 = TRUE;
               OtherDistributionRelays[i].GenericInt2 = FALSE;

            ELSEIF TempString like 'DELETE' THEN
            ENDIF;
         ELSE
            IF TempString like 'INSERT' OR
               TempString like 'UPDATE' THEN
 
               OtherDistributionRelays[i].RelayOp = CurRelayEquip.RelayOp;
               OtherDistributionRelays[i].TimeStamp = CurRelayEquip.TimeStamp;
               OtherDistributionRelays[i].Operation = CurRelayEquip.Operation;
               OtherDistributionRelays[i].GenericInt1 = TRUE;
               OtherDistributionRelays[i].GenericInt2 = FALSE;

            ELSEIF TempString like 'DELETE' THEN
               OtherDistributionRelays[i].RelayOp = -1;
               OtherDistributionRelays[i].TimeStamp = '';
               OtherDistributionRelays[i].Operation = RelayOp$None;
               OtherDistributionRelays[i].GenericInt1 = FALSE;
               OtherDistributionRelays[i].GenericInt2 = FALSE;
            ENDIF;
         ENDIF;
      ENDIF;

      /* update backup copy of the visual table */
      i = 1;
      WHILE i <= OtherDistBack.LastRow() DO
         IF (CurRelayEquip.FeederName = OtherDistBack[i].FeederName AND
             CurRelayEquip.Equip = OtherDistBack[i].Equip AND
             CurRelayEquip.RelayType = OtherDistBack[i].RelayType ) THEN

             ENDLOOP;
         ELSE
             i = i + 1;
         ENDIF;
      ENDWHILE; 

      IF i > OtherDistBack.LastRow() THEN
         Message 'A relay entry not found in Other back table.';
         RESUME;
      ENDIF;

      IF TempString like 'INSERT' OR
         TempString like 'UPDATE' THEN

         OtherDistBack[i].RelayOp = CurRelayEquip.RelayOp;
         OtherDistBack[i].TimeStamp = CurRelayEquip.TimeStamp;
         OtherDistBack[i].Operation = CurRelayEquip.Operation;
         OtherDistBack[i].GenericInt1 = TRUE;
         OtherDistBack[i].GenericInt2 = FALSE;

      ELSEIF TempString like 'DELETE' THEN
         OtherDistBack[i].RelayOp = -1;
         OtherDistBack[i].TimeStamp = '';
         OtherDistBack[i].Operation = RelayOp$None;
         OtherDistBack[i].GenericInt1 = FALSE;
         OtherDistBack[i].GenericInt2 = FALSE;
      ENDIF;

/*------------------------------ table 3 ---------------------------------*/
   ELSEIF y = 3 THEN
      IF TempString like 'UPDATE' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherRelays[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i > OtherRelays.LastRow() THEN
            Message 'A relay entry not found in Other table.';
            RESUME;
         ELSE
            OtherRelays[i] = CurRelayEquip.Duplicate();
         ENDIF;

         /* backup table */
         i = 1;
         WHILE i <= OtherBack.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherBack[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i > OtherBack.LastRow() THEN
            Message 'A relay entry not found in Other back table.';
            RESUME;
         ELSE
            OtherBack[i] = CurRelayEquip.Duplicate();
         ENDIF;

      ELSEIF TempString like 'INSERT' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.Line = OtherBack[i].Line AND
                CurRelayEquip.RelayType = OtherBack[i].RelayType AND
                CurRelayEquip.RelayName = OtherBack[i].RelayName )THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i <= OtherRelays.LastRow() THEN
         ELSE
            OtherRelays.InsertRow (RowNumber = i, 
                                   RowObject = CurRelayEquip.Duplicate());
         ENDIF;
   
         /* backup copy */
         i = OtherBack.LastRow() + 1;
         OtherBack.InsertRow (RowNumber = i, RowObject = CurRelayEquip.Duplicate());

      ELSEIF TempString like 'DELETE' THEN
         /* visual table */
         i = 1;
         WHILE i <= OtherRelays.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherRelays[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i <= OtherRelays.LastRow() THEN
            OtherRelays.RemoveRow (RowNumber = i);
         ENDIF;

         /* backup table */
         i = 1;
         WHILE i <= OtherBack.LastRow() DO
            IF (CurRelayEquip.RelayOp = OtherBack[i].RelayOp) THEN
               ENDLOOP;
            ELSE
               i = i + 1;
            ENDIF;
         ENDWHILE; 

         IF i > OtherBack.LastRow() THEN
            Message 'A relay entry not found in Other back table.';
            RESUME;
         ELSE
            OtherBack.RemoveRow (RowNumber = i);
         ENDIF;
      ENDIF;
   ENDIF;

   RESUME;
END;

ON CLICK PDF_Btn =
DECLARE
