ON CHILDENTRY Card_TF = 
DECLARE

BEGIN
   IF CURFRAME.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
   
   TOMove = '';

   i = FIELD(Card_TF).CurRow;

   /* 
   ** For SLC, validate that the equip is not part of another switching
   ** item on the Card_TF.
   */
   IF Card_TF[i].Application = Application$SLC AND 
      Card_TF[i].CardStatus = Card$Active AND
      Selected.Equip > 0 THEN
      j = 0;
      REPEATED
      SELECT :j = JC.SwitchingItem
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :Card_TF[i].Card AND
             JC.SwitchingItem <> :Card_TF[i].SwitchingItem AND
             JC.Job = J.Job AND
             J.Equip = :Selected.Equip AND
            (J.TOComplete IS NULL OR J.RSComplete IS NULL) AND
             J.Status = '' AND
             J.SwItemStatus = :Card$Active AND
             J.MoveCategory = :MoveCategory$Normal;

      IF j <> 0 THEN
         MESSAGE 'This Equipment is part of another active switching item.';
         RESUME;
      ENDIF;
   ENDIF;

   CALLPROC HighlightCard(SelectRow = i);
   
   CALLPROC ShowJobsByCard();
END; 

