**  12/11/03    ysp     Add LoadOutOfService
**  04/25/05    pkw     Flag circuits that are members of Grouper circuits 
**                      with (PEND T1).
**  06/23/09    ysp     Exclude SOCCSX F RTU from out-of-service report because
**                      they are no longer used.
**  11/20/09    ysp     change the status values in the dynamic where clause to integers
**  02/19/10    ysp     add loadcircuits by division.
**  07/29/10    ysp     add Carrier to loadcircuits method.
**  01/14/12    pkw     Exclude SOCCS F RTU from out-of-service report because
**                      they are no longer used.
**  05/02/18    ysp     Add Priority to Out-of-Service report.
**  05/07/18    pkw     Add OperatingStep to Out-of-Service report
**  09/04/18    em      Exclude DirectLine type circuit from LOS report.
*/ 
METHOD LoadOutOfService (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   i = INTEGER NOT NULL;     /*Counter*/
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;
   x = INTEGER NOT NULL;
   CurrentTime = DATE;
   DynamicWhereClause = VARCHAR(1500);
   FdrList = ARRAY OF ObjectClass;  /* list of feeders for circuit */
   HrsOut = INTEGER;
   MinsOut = INTEGER;
   StatusList = VARCHAR(50) NOT NULL;
   OSCards = ARRAY OF TLS_MgtReport;
   Reference = VARCHAR(4) NOT NULL;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load data associated with Feeder Milestone Report
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
/*
**  Set up total column
*/
   CurObject.TList.Clear();
 
   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      /*
      **  Build effective division based on input parameters passed in.
      */      
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            i = 1;
            WHILE i <= SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
               i = i + 1;
            ENDWHILE;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;

      ELSE
         IF CurObject.Division <> 0 THEN
            EffectiveDivisions[1].Object = CurObject.Division;
         ELSE
            i = 1;
            WHILE LENGTH(CurObject.DivisionName) > 0 DO
               CurObject.Division = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
               EffectiveDivisions[i].Object = CurObject.Division;
               i = i + 1;
               CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
            ENDWHILE;
         ENDIF;  
      ENDIF; 
 
      /* build card status list for ASP*/
      IF CurObject.CardStatus = 0 THEN
         StatusList = '1,2,3';
      ELSEIF CurObject.CardStatus = 1 THEN
         StatusList = '1';          /* active */
      ELSEIF CurObject.CardStatus = 2 THEN
         StatusList = '2';          /* Telco */
      ELSEIF CurObject.CardStatus = 3 THEN
         StatusList = '3';          /* Pst */
      ENDIF;  
   ELSE  /* TLS app */                                     
      StatusList = CurObject.StatusName;    
   ENDIF;

/*
** Load OOS Report
*/
    CurrentTime = 'now';
    DynamicWhereClause = 
                  'J.OutService IS NOT NULL AND J.Inservice IS NULL AND ' +
                  'J.Card = C.Card AND C.Status IN (' + StatusList + ')' + ' AND ' +
                  'C.LineType <> ' + VARCHAR(Type$SOCCSXFRTU) + ' AND ' +  
                  'C.LineType <> ' + VARCHAR(Type$SOCCSFRTU) + ' AND ' +  
                  'C.LineType <> ' + VARCHAR(Type$DirectLine) + ' AND ' +  
                  'C.Circuit = G.Member AND G.Relationship = ' + 
                  VARCHAR(:Interaction$MemberOf) + ' AND ' + 'G.Grouping IN ( '; 

    i = 1;
    WHILE i <= EffectiveDivisions.LastRow() DO

        IF i = EffectiveDivisions.LastRow() THEN
           DynamicWhereClause = DynamicWhereClause + 
                 VARCHAR(EffectiveDivisions[i].Object) + ')';
        ELSE
           DynamicWhereClause = DynamicWhereClause + 
                 VARCHAR(EffectiveDivisions[i].Object) + ',';
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
**  Select OOS Circuits and Outservice times
*/
    i = 1;
    OSCards.Clear();
    SELECT DISTINCT :OSCards[i].Card = J.Card,
                    :OSCards[i].Circuit = J.Circuit,
                    :OSCards[i].LineNumber = J.LineNumber,
                    :OSCards[i].Priority = C.Priority
    FROM  TC_Job J,
          TC_Card C,
          Udb_Grouping G
    WHERE :DynamicWhereClause
    ORDER BY Priority, LineNumber
    BEGIN
       REPEATED
       SELECT :OSCards[i].TotOutService = MIN(J.OutService)
       FROM   TC_Job J
       WHERE  J.Card = :OSCards[i].Card AND
              J.Circuit = :OSCards[i].Circuit;
       
       SELECT :x = C.Circuit
       FROM    TC_Card C 
       WHERE   C.Card = :OSCards[i].Card;
       IF x <> OSCards[i].Circuit THEN
          OSCards[i].LineNumber = OSCards[i].LineNumber + ' (PEND T1)';
       ENDIF;

       HrsOut = interval('Hours', CurrentTime - OSCards[i].TotOutService);
       MinsOut = interval('Minutes', CurrentTime - OSCards[i].TotOutService);
       OSCards[i].TotHoursOut = HrsOut + ((MinsOut - (HrsOut * 60))/60.0);
       i = i + 1;
    END;
/*
**  Select organization that currently has control of circuit
*/
    i = 1;
    WHILE i <= OSCards.LastRow() DO
       SELECT  :OSCards[i].FeederNames = RS.FeederNames,
               :OSCards[i].SubstationName = RS.SubstationName,
               :OSCards[i].LineTypeName = RS.LineTypeName,
               :OSCards[i].OrganizationName = RS.OrganizationName,
               :OSCards[i].Outservice = RS.Outservice
       FROM    TC_ReportStats RS
       WHERE   RS.Card = :OSCards[i].Card AND
               RS.Circuit = :OSCards[i].Circuit AND
               RS.OutService IS NOT NULL AND
               RS.InService IS NULL;
       CALLPROC DDB_ROLLBACK;

       SELECT :OSCards[i].OperatingStep = O.OperatingStep,
              :OSCards[i].OperatingStepName = O.OperatingStepName
       FROM   TC_OperatingStepStatus O
       WHERE  O.Card = :OSCards[i].Card AND
              O.EndTime = '' AND
              O.StartTime = (SELECT MAX(StartTime)
                             FROM   TC_OperatingStepStatus O2
                             WHERE  O2.Card = :OSCards[i].Card AND
                                    O2.EndTime = '');
       CALLPROC DDB_ROLLBACK;
       
       IF OSCards[i].OrganizationName = '' THEN
/*
**  Must be out to SO
*/
          OSCards[i].OrganizationName = Default$OrgName;

          FdrList.Clear();
          j = 1;
          REPEATED
          SELECT :FdrList[j].Name = SQUEEZE(O.Name)
          FROM    Udb_Object O,
                  Udb_Grouping G
          WHERE   G.Grouping = O.Object
          AND     G.GroupingType IN ( SELECT Type
                                      FROM   Udb_ExtendedType
                                      WHERE  Supertype IN(:Type$Feeder,:Type$Line))
          AND     G.Relationship = :Interaction$MemberOf
          AND     G.Member = :OSCards[i].Circuit
          BEGIN
              IF (j = 1) THEN
                  OSCards[i].FeederNames = FdrList[j].Name;
              ELSE
                  OSCards[i].FeederNames = OSCards[i].FeederNames + ', ' + FdrList[j].Name;
              ENDIF;
              j = j + 1;
          END;
          CALLPROC DDB_ROLLBACK;

          REPEATED
          SELECT :OSCards[i].SubstationName = O.Name,
                 :Reference = G.Reference
          FROM   Udb_Object O,
                 Udb_Grouping G
          WHERE  G.Member = :OSCards[i].Circuit AND
                 G.RelationShip = :Interaction$MemberOf AND  
                 G.GroupingType IN  (SELECT  Type
                                     FROM    Udb_ExtendedType
                                     WHERE   Supertype = :Type$Substation) AND
                 G.Grouping = O.Object
          ORDER BY Reference DESC;
          CALLPROC DDB_ROLLBACK;

          REPEATED
          SELECT :OSCards[i].Outservice = MAX(InService)
          FROM   TC_ReportStats RS
          WHERE  RS.Card = :OSCards[i].Card AND
                 RS.Circuit = :OSCards[i].Circuit AND
                 RS.InService IS NOT NULL;
          CALLPROC DDB_ROLLBACK;

          IF OSCards[i].Outservice IS NULL THEN
             OSCards[i].Outservice = OSCards[i].TotOutservice;
          ENDIF; 

          REPEATED
          SELECT :OSCards[i].LineTypeName = O.TypeName
          FROM   Udb_Object O
          WHERE  O.Object = :OSCards[i].Circuit;
          CALLPROC DDB_ROLLBACK;
       ENDIF; 
       i = i + 1;
    ENDWHILE;

    CurObject.TList= OSCards.Duplicate();
    RETURN;
END;

METHOD LoadCircuits (
   Carrier = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   DivCheck = INTEGER NOT NULL;
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load Networks associated with a division.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   DivCheck = 0;
   SELECT :DivCheck = COUNT(*) 
   FROM    Udb_Object 
   WHERE   Object = :CurObject.Division AND
           Type = :Type$Division;

   IF DivCheck = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Please select a valid division.';
      RETURN;
   ENDIF;
   
   CurObject.Olist.Clear();
   IF Carrier = 0 THEN      // all carriers
      i = 1;
      REPEATED
      SELECT  :CurObject.Olist[i].Object = O.Object,
              :CurObject.Olist[i].Name = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G 
      WHERE   G.MemberType IN (SELECT  Type
                               FROM    Udb_ExtendedType
                               WHERE   SuperType = :Type$TelCircuit) AND
              G.Relationship = :Interaction$MemberOf AND 
              G.Grouping = :CurObject.Division AND
              G.Member = O.Object
      ORDER BY Name
      BEGIN
         i = i + 1;
      END;
   ELSE
      i = 1;
      REPEATED
      SELECT  :CurObject.Olist[i].Object = O.Object,
              :CurObject.Olist[i].Name = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G1,
              Udb_Grouping G2 
      WHERE   G1.MemberType IN (SELECT  Type
                                FROM    Udb_ExtendedType
                                WHERE   SuperType = :Type$TelCircuit) AND
              G1.Relationship = :Interaction$MemberOf AND 
              G1.Grouping = :CurObject.Division AND
              G1.Member = O.Object AND
              G1.Member = G2.Member AND
              G2.Relationship = :Interaction$ProvidedBy AND 
              G2.Grouping = :Carrier
      ORDER BY Name
      BEGIN
         i = i + 1;
      END;
   ENDIF; 
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;

