	Name:            SelectFeederForTransfer

/*
**	Copyright c 1993 ESCA Corporation, Inc.  All rights reserved.
**
**	ESCA Corporation, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of ESCA Corporation, Inc.
**
**  Application:    FeederCard 
**  Frame:          SelectFeederForTransfer 
** 
*  Date:    Version  Description 
** -------------------------------------------------- 
** JAN 93   adl      author 
** 02/08/93  em      modified to handle ISO length feeders.
**                   list feeders controlled by desk.
** 03/09/93  em      use for both from/to transfers - modify title.
** 04/07/93  em      removed repeated select
** 08/23/10  em      Select Distinct
** 03/28/11  em      Updated for 3G
** 10/01/13  ysp     Add find button.
** 04/21/16  ysp     1. filter out 33kv portion cards from selection list. 2 If Do is selecting a feeder to 
**                   tranfer equipment to (Action = "To") and a 33kv feeder is selected, prompt DO to select 
**                   a portion of that feeder.
*/
INITIALIZE
(
    Action = Varchar(4) NOT NULL WITH DEFAULT;    /* Passed From/To Action */
) =
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;     		/* index variable */
ENDDECLARE
BEGIN
   FIELD(SelectCard).Title = 'Select Feeder to Transfer ' + :Action + ':';
	Selected.Feeder = 0; 

   /* Load active cards into local array for display: 
   */ 
   SelectCard.Clear(); 
   i = 1; 
	SELECT DISTINCT
         :SelectCard[i].Card          = C.Card, 
         :SelectCard[i].Feeder        = CTO.Object, 
         :SelectCard[i].FeederName    = CTO.Name, 
         :SelectCard[i].CardName      = C.FeederName, 
         :SelectCard[i].Position      = C.Position, 
         :SelectCard[i].CardClassName = C.CardClassName,
         :SelectCard[i].NetworkFeeder = C.NetworkFeeder
	FROM	FMS_Card C, 
         SOA_ActiveObject AO,
         TFMS_CardToObject CTO,
         Udb_Grouping G,
         Udb_Object O
	WHERE	AO.Card = C.Card AND
         C.TypeOfCard <> :TypeOfCard$Portion AND            // filter out 33kv portion cards.
         C.Card = CTO.Card AND  
         CTO.Object = G.Member AND  
         G.Relationship = :Interaction$ControlledBy AND 
         G.Grouping = O.Object AND 
         O.Name = :UserGroup
	ORDER BY FeederName 
	BEGIN 
	   i = i + 1; 
	END; 
   CALLPROC DDB_ROLLBACK;
END; 

/*
**	Handle a card selection from the list: 
*/
ON ChildEntry SelectCard =
BEGIN
   IF (CurFrame.ReasonCode <> RC_MOUSECLICK) THEN 
      RESUME; 
   ENDIF; 

   Selected = SelectCard[].Duplicate();
END; 

ON CLICK FindButton =
DECLARE
   CardMatch = VARCHAR(40) NOT NULL WITH DEFAULT;
   FeederMatch = VARCHAR(40) NOT NULL WITH DEFAULT;
   PosMatch = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
    CardMatch = '%' + uppercase(SQUEEZE(Selected.CardName)) + '%';
    FeederMatch = '%' +uppercase(SQUEEZE(Selected.FeederName)) + '%';
    PosMatch = '%' + uppercase(SQUEEZE(Selected.Position)) + '%';

    i = 1;
    WHILE i <= SelectCard.LastRow() Do
       IF Uppercase(SelectCard[i].CardName) like CardMatch  AND
          Uppercase(SelectCard[i].FeederName) like FeederMatch AND
          Uppercase(SelectCard[i].Position) like PosMatch THEN
          Endloop;
       Endif;
       i = i + 1;
    ENDWHILE;

    If i <= SelectCard.LastRow() Then
      Field(SelectCard).ActiveRow = i;

      Selected = SelectCard[i].Duplicate();
    Else
       Selected.Feeder = 0; 
       MESSAGE 'No feeder matches your search criteria.';
       RESUME;
    ENDIF;
END;

/*
**	Handle an OK click: 
*/
ON Click OK_Btn =
DECLARE
   ClickableList = ARRAY OF ObjectSummaryClass;
   SelectedPortion = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF Selected.Feeder = 0 THEN
      MESSAGE 'You have not selected a feeder.';
      RESUME;
   ENDIF;
   
   IF UPPERCASE(Action) = 'TO' AND Selected.NetworkFeeder = NetworkFeeder$33KV THEN
      i = 1;
      SELECT :ClickableList[i].Object = G.Member,
             :ClickableList[i].Name = O.Name
      FROM   UDB_Grouping G,
             UDB_Object O
      WHERE  G.Grouping = :Selected.Feeder AND
             G.Relationship = :Interaction$MemberOf AND
             G.MemberType IN (SELECT Type 
                              FROM   UDB_ExtendedType
                              WHERE  SuperType = :Type$33KVPortion) AND
             G.Member = O.Object
      BEGIN
         i = i + 1;
      END;
      
      CALLFRAME PortionFeederDiagram(MainFeeder = Selected.Feeder,
                              ClickableList = ClickableList,
                              SelectedPortion =  BYREF(SelectedPortion),
                              Title = 'Select a Segment that Equipment will be Transferred to');
      IF SelectedPortion = 0 THEN
         MESSAGE 'You have not selected a portion feeder.';
         RESUME;
      ELSE
         RETURN SelectedPortion;
      ENDIF;
   ELSE
      RETURN (Selected.Feeder);
   ENDIF;
END;

/* 
**	Handle a Cancel click: 
*/ 
ON Click Cancel_Btn = 
BEGIN 
   RETURN (PU_CANCEL); 
END; 

/*
**	Handle a Window Close click: 
*/
ON WINDOWCLOSE =
BEGIN
	RESUME;
END;

