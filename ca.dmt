	Name:            RecordORDelay

/*
**	Copyright c 2017 Pateric Software.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software.
**
**  Application:    CAC 
**  Frame:          RecordORDelay 
** 
*  Date:    Version  Description 
** -------------------------------------------------- 
** 10/27/17	em   Created
** 08/23/18 em   Add subcategory for Outage Delay and remove Working Group
*/
INITIALIZE
(
    ORNumber = VARCHAR(20) NOT NULL;	/* Passed in */
    DelayType = INTEGER NOT NULL;       /* Passed in */ 
    i = INTEGER;     		/* index variable */

    DelayTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;   
    SelectType = INTEGER NOT NULL WITH DEFAULT;
    TempType = INTEGER NOT NULL WITH DEFAULT;
    TempName = VARCHAR(40) NOT NULL WITH DEFAULT;
    ThereIsADivision = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   SELECT :DelayTypeName = Name
   FROM   Udb_Type
   WHERE  Type = :DelayType;

   FIELD(DelayTitle).TextValue = 'Enter Reason for Delayed ' + DelayTypeName +
                                 ' Time';
   
   IF DelayType = ORDelay$Outage THEN
      SelectType = ORDelay$OutCategory;
      FIELD(WorkingGroup).ParentField.CurBias = FB_INVISIBLE;
      WorkingGroup = 0;
   ELSEIF DelayType = ORDelay$WorkIssued THEN
      SelectType = ORDelay$WICategory;
      FIELD(DelaySubCategory).ParentField.CurBias = FB_INVISIBLE;
      DelaySubCategory = 0;
   ELSE
      CALLPROC TraceError (UserMessage = 
                'ERROR: Unknown Delay Type ' + VARCHAR(DelayType) +
                ' parameter.  Program error, please report bug' , 
                           TraceMessage =
                'Error in Frame RecordORDelay;  ' +
                'Unknown Delay Type ' + VARCHAR(DelayType) +
                ' parameter.'
                );
      RETURN;
   ENDIF;

   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_ORDelay
   WHERE  ORNumber = :ORNUmber AND
          DelayType = :DelayTypeName;

   IF i > 0 THEN
      CALLPROC TraceError (UserMessage = 
                'NOTE: ' + DelayTypeName + ' Delay has already been recorded ' +
                ' for Outage Request ' + ORNumber,
                           TraceMessage =
                VARCHAR(DATE('now')) + ' :Warning: ' + DelayTypeName + ' Delay has already been recorded ' +
                ' for Outage Request ' + ORNumber
                );
      RETURN;

   ENDIF;

   FIELD(DelayCategory).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(DelayCategory).ValueList.ChoiceItems[1].EnumText = ''; 
   FIELD(DelaySubCategory).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(DelaySubCategory).ValueList.ChoiceItems[1].EnumText = ''; 

   i = 1;        
   SELECT :TempType = T.Type,
          :TempName = T.Name
   FROM   Udb_Type T,
          Udb_SuperType ST
   WHERE  ST.SuperType = :SelectType AND
          ST.Type = T.Type
   ORDER BY 2
   BEGIN
      i = i + 1;
      FIELD(DelayCategory).ValueList.ChoiceItems[i].EnumValue = TempType;
      FIELD(DelayCategory).ValueList.ChoiceItems[i].EnumText = TempName; 
   END;      
   FIELD(DelayCategory).CurBias = FB_CHANGEABLE;

   IF DelayType = ORDelay$Outage THEN
      SelectType = ORDelay$OutWorkGrp;
   ELSEIF DelayType = ORDelay$WorkIssued THEN
      SelectType = ORDelay$WIWorkGrp;
   ENDIF;

   FIELD(WorkingGroup).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(WorkingGroup).ValueList.ChoiceItems[1].EnumText = ''; 

   IF SelectType = ORDelay$WIWorkGrp THEN
      i = 1;        
      SELECT :TempType = T.Type,
             :TempName = T.Name
      FROM   Udb_Type T,
             Udb_SuperType ST
      WHERE  ST.SuperType = :SelectType AND
             ST.Type = T.Type
      ORDER BY 2
      BEGIN
         i = i + 1;
         FIELD(WorkingGroup).ValueList.ChoiceItems[i].EnumValue = TempType;
         FIELD(WorkingGroup).ValueList.ChoiceItems[i].EnumText = TempName; 
      END;      
      FIELD(WorkingGroup).CurBias = FB_CHANGEABLE;
   ENDIF;

   FIELD(Division).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(Division).ValueList.ChoiceItems[1].EnumText = ''; 

   i = 1;        
   SELECT DISTINCT
          :TempType = O.Object,
          :TempName = O.Name
   FROM   Udb_Object O,
          SOA_ORWorkItem WI
   WHERE  WI.ORNumber = :ORNumber AND 
          WI.Division = O.Object
   ORDER BY 2
   BEGIN
      i = i + 1;
      FIELD(Division).ValueList.ChoiceItems[i].EnumValue = TempType;
      FIELD(Division).ValueList.ChoiceItems[i].EnumText = TempName; 
   END;      

   IF i = 1 THEN
      Division = 0;
      FIELD(Division).ParentField.CurBias = FB_INVISIBLE;
   ELSEIF i = 2 THEN
      Division = FIELD(Division).ValueList.ChoiceItems[2].EnumValue;
      FIELD(Division).ParentField.CurBias = FB_INVISIBLE;
   ELSE
      ThereIsADivision = TRUE;
      FIELD(Division).CurBias = FB_CHANGEABLE;
   ENDIF;

END;

ON SETVALUE DelayCategory =
BEGIN
   DelayCategory = FIELD(DelayCategory).CurEnumValue;
   FIELD(DelaySubCategory).SetToDefault();
   FIELD(DelaySubCategory).ValueList.ChoiceItems[1].EnumValue = 0;
   FIELD(DelaySubCategory).ValueList.ChoiceItems[1].EnumText = ''; 
   
   i = 1;        
   SELECT :TempType = T.Type,
          :TempName = T.Name
   FROM   Udb_Type T,
          Udb_SuperType ST
   WHERE  ST.SuperType = :DelayCategory AND
          ST.Type = T.Type
   ORDER BY 2
   BEGIN
      i = i + 1;
      FIELD(DelaySubCategory).ValueList.ChoiceItems[i].EnumValue = TempType;
      FIELD(DelaySubCategory).ValueList.ChoiceItems[i].EnumText = TempName; 
   END;      
   FIELD(DelaySubCategory).CurBias = FB_CHANGEABLE;
   FIELD(DelaySubCategory).UpdChoiceList();
END;

ON SETVALUE DelaySubCategory =
BEGIN
   DelaySubCategory = FIELD(DelaySubCategory).CurEnumValue;
END;

ON SETVALUE WorkingGroup =
BEGIN
   WorkingGroup = FIELD(WorkingGroup).CurEnumValue;
END;

ON SETVALUE Division =
BEGIN
   Division = FIELD(Division).CurEnumValue;
END;

/*
**	Handle an OK click: 
*/
ON Click OK_Btn =
BEGIN
    IF DelayCategory = 0 THEN
       Message 'Please select a Delay Category.';
       RESUME;
    ENDIF;

    IF DelayType = ORDelay$Outage THEN   
       IF DelaySubCategory = 0 THEN
          Message 'Please select a Delay SubCategory.';
          RESUME;
       ENDIF;
    ELSE
       IF WorkingGroup = 0 THEN
          Message 'Please select a Working Group.';
          RESUME;
       ENDIF;
    ENDIF;

    IF Division = 0 AND ThereIsADivision = TRUE THEN
       Message 'Please select a Division.';
       RESUME;
    ENDIF;

    IF DelayReason = '' THEN
       Message 'Please enter a reason for the delay.';
       RESUME;
    ENDIF;

    IF Lowercase (DelayReason) LIKE '%fuck%' OR 
       Lowercase (DelayReason) LIKE '%shit%' OR 
       Lowercase (DelayReason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        DelayReason = '';
	RESUME;

   ELSEIF Length( Squeeze (DelayReason)) <= 6 THEN

        MESSAGE 'You can do better than that!';
        DelayReason = '';
       RESUME;
   ENDIF;
/*
**  Save Delay to Database.
*/
   RetCode = CALLPROC SOA_ORDelayIns (
          ORNumber = ORNumber,
          DelayType = DelayTypeName,
          DelayCategory = DelayCategory,
          DelaySubCategory = DelaySubCategory,
          WorkingGroup = WorkingGroup,
          DelayReason = DelayReason,
          Division = Division,
          DelayDate = DATE('now'));
           
    IF RetCode <> 0 THEN
       CALLPROC DDB_ROLLBACK;
       CALLPROC TraceError (UserMessage = 
                'ERROR: Unable to save Delay due to an program error.  Please report bug' , 
                           TraceMessage =
                'Error in Frame RecordORDelay;  ' +
                'Error saving ' + DelayTypeName + ' delay for OR ' + VARCHAR(ORNumber) +
                '.'
                );
       RETURN;
    ELSE               
       CALLPROC DDB_COMMIT;
    ENDIF;

    RETURN;
END;

/*
**	Handle a Window Close click: 
*/
ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

						 *Default Item

						 *Default Item

						 *Default Item

						 *Default Item


