          CurObject.Dlist[i].Status = A.Status
   FROM   TM_BogeyAlert A
   WHERE  A.Type = :TM$TVOtherType AND
          A.Status = :TM$StatusOutOfService
   ORDER BY Card
   BEGIN
      i = i + 1;
   END; 
   CALLPROC DDB_ROLLBACK;   
/*
**  Load Current data 
*/
   CurObject.CList.Clear();
   i = 1;
   IF BogeyEnabled = TRUE THEN
      REPEATED 
      SELECT CurObject.clist[i].Card = C.Card,
             CurObject.clist[i].Type = :TM$TVOtherType,
             CurObject.clist[i].Description = 'Total duration that feeder has been out of service.',
             CurObject.clist[i].Division = OO.PrimaryGrouping,
             CurObject.clist[i].Feeder = C.Feeder,
             CurObject.clist[i].FeederName = C.FeederName,
             CurObject.clist[i].CardClass = C.CardClass,
             CurObject.clist[i].CardClassName = C.CardClassName,
             CurObject.clist[i].Object = 0,
             CurObject.clist[i].Status = :TM$StatusOutOfService,
             CurObject.clist[i].StartTime = C.CutOut
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object OO,
             Udb_ExtendedType ET
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey > 0 AND  
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
            (C.OpenAutoPlus IS NULL OR
             C.OpenAutoPlus = '') AND
             C.Card = CTO.Card AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = OO.Object AND
             OO.Type = ET.Type AND
             ET.SuperType = :Type$Substation 
      UNION
      SELECT C.Card,
             :TM$TVOtherType,
             'Total duration that feeder has been out of service.',
             OO.Object,
             C.Feeder,
             C.FeederName,
             C.CardClass,
             C.CardClassName,
             0,
             :TM$StatusOutOfService,
             C.CutOut
      FROM   FMS_Card C,
             TFMS_CardToObject CTO,
             Udb_Object O,
             Udb_Object OO
      WHERE  C.Status < :Card$Closed AND
             C.CardClass IN (:Type$AUTO, :Type$CIOA) AND
             C.TV_Bogey > 0 AND  
             C.CutOut IS NOT NULL AND
             C.CutIn IS NULL AND
            (C.OpenAutoPlus IS NULL OR
             C.OpenAutoPlus = '') AND
             C.Card = CTO.Card AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = OO.Object AND
             OO.Type = :Type$Division
      ORDER BY Card
      BEGIN
         i = i + 1;
      END; 
      CALLPROC DDB_ROLLBACK;
   ENDIF;
/*
**  Filter data
*/   
   i = 1;
   WHILE i <= CurObject.dlist.LastRow() DO
      j = 1;
      WHILE j <= CurObject.clist.LastRow() DO
         IF CurObject.dlist[i].Card = CurObject.clist[j].Card AND
            CurObject.dlist[i].StartTime = CurObject.clist[j].StartTime THEN
            CurObject.dlist.RemoveRow (RowNumber = i);
            CurObject.clist.RemoveRow (RowNumber = j);
            IF i > CurObject.dlist.LastRow() THEN /* avoid error */
               ENDLOOP;
            ENDIF;
         ELSE
            j = j + 1;
         ENDIF;          
      ENDWHILE;
      i = i + 1;
   ENDWHILE; 

#  include TM_AlertTableUpdates

   FOR m = 1 TO UpdatedDiv.LastRow() DO
      ControlText = VARCHAR(UpdatedDiv[m].Value) + ';';
      CALLPROC DDB_RaiseDBEvent (DBEventName = 'TM_BogeyAlertUpd',
                                 DBEventText = ControlText);
      CALLPROC DDB_COMMIT;
   ENDFOR;
   
   RETURN;
END;

METHOD OpStepBogeyTime (
   Card = INTEGER NOT NULL;
   OpStepType = INTEGER NOT NULL;
   OpStep = INTEGER NOT NULL;
)=
DECLARE
   SingleStep = INTEGER NOT NULL;

   BogeyTime = INTEGER NOT NULL WITH DEFAULT;
   TotalStep = INTEGER NOT NULL WITH DEFAULT;
   
   IntSTA = INTEGER NOT NULL WITH DEFAULT;
   IntISO = INTEGER NOT NULL WITH DEFAULT;
   IntISTA = INTEGER NOT NULL WITH DEFAULT;
   IntABF  = INTEGER NOT NULL WITH DEFAULT;
   IntOTW  = INTEGER NOT NULL WITH DEFAULT;
   IntOTWPlus  = INTEGER NOT NULL WITH DEFAULT;
   IntOTWR = INTEGER NOT NULL WITH DEFAULT;
   IntOTWS = INTEGER NOT NULL WITH DEFAULT;
   IntFG = INTEGER NOT NULL WITH DEFAULT;
   IntILOC = INTEGER NOT NULL WITH DEFAULT;
   IntINSP = INTEGER NOT NULL WITH DEFAULT;
   IntLOC = INTEGER NOT NULL WITH DEFAULT;
   IntTEST = INTEGER NOT NULL WITH DEFAULT;
   IntPFS = INTEGER NOT NULL WITH DEFAULT;
   IntPFSS = INTEGER NOT NULL WITH DEFAULT;
   IntPFSF = INTEGER NOT NULL WITH DEFAULT;
   
   TempStep = INTEGER NOT NULL;
   TempDuration = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   BogeyTime = 0;
/*
** Get the bogey time for the combined total
*/
   IF OpStep = Type$ISOStep OR OpStep = Type$STA OR OpStep = Type$ISTA OR OpStep = Type$ABF THEN
      TotalStep = Type$ISTA;                
   ELSEIF OpStep = Type$OTWR OR OpStep = Type$OTWS OR OpStep = Type$OTW OR OpStep = Type$OTWPlus THEN
      TotalStep = Type$OTW;
   ELSEIF OpStep = Type$ILOC OR OpStep = Type$INSP OR OpStep = Type$LOC THEN
      TotalStep = Type$ILOC;
   ELSEIF OpStep = Type$FG OR OpStep = Type$TEST OR OpStep = Type$PFS OR OpStep = Type$PFSS OR OpStep = Type$PFSF THEN
      TotalStep = Type$PFS;
   ELSE
      TotalStep = OpStep;
      SingleStep = TRUE;
   ENDIF;
  
   REPEATED
   SELECT :BogeyTime = T.BogeyAlert
   FROM   TM_BogeyType T
   WHERE  T.Type = :OpStepType AND
          T.Status = :TotalStep;
   CALLPROC DDB_ROLLBACK;         

   IF SingleStep = TRUE THEN  
      RETURN (BogeyTime);
   ENDIF;
/*
** Get the durations of other steps
*/ 
   IntSTA = 0;
   IntISO = 0;
   IntISTA = 0;
   IntABF = 0;
   IntOTW = 0;
   IntOTWPlus = 0;
   IntOTWR = 0;
   IntOTWS = 0;
   IntFG = 0;
   IntILOC = 0;
   IntINSP = 0;
   IntLOC = 0;
   IntTEST = 0;
   IntPFS = 0;
   IntPFSS = 0;
   IntPFSF = 0;
   
   REPEATED
   SELECT :TempStep = OS.OperatingStep,
          :TempDuration = OS.DurationMins
   FROM   FMS_OperatingStepStatus OS
   WHERE  OS.Card = :Card AND
          OS.EndTime <> '' AND
          OS.OperatingStep IN (:Type$ISOStep, :Type$STA, :Type$ISTA, :Type$ABF,
                               :Type$OTW, :Type$OTWR, :Type$OTWS, :Type$OTWPlus,
                               :Type$FG, :Type$ILOC, :Type$INSP, :Type$LOC, 
                               :Type$TEST, :Type$PFS, :Type$PFSS, :Type$PFSF)
   BEGIN
      IF TempStep = Type$STA THEN
         IntSTA = IntSTA + TempDuration;
 
      ELSEIF TempStep = Type$ISOStep THEN
         IntISO = IntISO + TempDuration;

      ELSEIF TempStep = Type$ISTA THEN
         IntISTA = IntISTA + TempDuration;

      ELSEIF TempStep = Type$ABF THEN
         IntABF = IntABF + TempDuration;

      ELSEIF TempStep = Type$OTW THEN
         IntOTW = IntOTW + TempDuration;

      ELSEIF TempStep = Type$OTWPlus THEN
         IntOTWPlus = IntOTWPlus + TempDuration;

      ELSEIF TempStep = Type$OTWR THEN
         IntOTWR = IntOTWR + TempDuration;

      ELSEIF TempStep = Type$OTWS THEN
         IntOTWS = IntOTWS + TempDuration;

      ELSEIF TempStep = Type$FG THEN
         IntFG = IntFG + TempDuration;

      ELSEIF TempStep = Type$ILOC THEN
         IntILOC = IntILOC + TempDuration;

      ELSEIF TempStep = Type$INSP THEN
         IntINSP = IntINSP + TempDuration;

      ELSEIF TempStep = Type$LOC THEN
         IntLOC = IntLOC + TempDuration;

      ELSEIF TempStep = Type$TEST THEN
         IntTEST = IntTEST + TempDuration;

      ELSEIF TempStep = Type$PFS THEN
         IntPFS = IntPFS + TempDuration;

      ELSEIF TempStep = Type$PFSS THEN
         IntPFSS = IntPFSS + TempDuration;

      ELSEIF TempStep = Type$PFSF THEN
         IntPFSF = IntPFSF + TempDuration;

      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;         
/* 
** Subtract the other steps from the total bogey time.
*/
   IF OpStep = Type$ISOStep OR OpStep = Type$STA OR OpStep = Type$ISTA OR OpStep = Type$ABF THEN
      BogeyTime = BogeyTime - IntISO - IntSTA - IntISTA - IntABF;             

   ELSEIF OpStep = Type$OTWR OR OpStep = Type$OTWS OR OpStep = Type$OTW OR OpStep = Type$OTWPlus THEN
      BogeyTime = BogeyTime - IntOTW - IntOTWR - IntOTWS - IntOTWPlus;

   ELSEIF OpStep = Type$ILOC OR OpStep = Type$INSP OR OpStep = Type$LOC THEN
      BogeyTime = BogeyTime - IntILOC - IntINSP - IntLOC;

   ELSEIF OpStep = Type$FG OR OpStep = Type$TEST OR OpStep = Type$PFS OR OpStep = Type$PFSS OR OpStep = Type$PFSF THEN
      BogeyTime = BogeyTime - IntFG - IntTEST - IntPFS - IntPFSS - IntPFSF;
   ENDIF;

   IF BogeyTime < 0 THEN
      BogeyTime = 0;
   ENDIF;

   RETURN (BogeyTime);
END;

METHOD CompositeMessage (
   Card          = INTEGER NOT NULL WITH DEFAULT;
   OpStep        = INTEGER NOT NULL WITH DEFAULT;
   StartTime     = DATE NOT NULL;
   StatusName    = VARCHAR(40) NOT NULL;
   FeederName    = VARCHAR(40) NOT NULL;
   CardClassName = VARCHAR(40) NOT NULL;
)=
DECLARE
   SingleStep = INTEGER NOT NULL;

   TotalTime = INTEGER NOT NULL WITH DEFAULT;
   TotalStep = INTEGER NOT NULL WITH DEFAULT;
   
   IntSTA = INTEGER NOT NULL WITH DEFAULT;
   IntISO = INTEGER NOT NULL WITH DEFAULT;
   IntISTA = INTEGER NOT NULL WITH DEFAULT;
   IntABF  = INTEGER NOT NULL WITH DEFAULT;
   IntOTW  = INTEGER NOT NULL WITH DEFAULT;
   IntOTWPlus  = INTEGER NOT NULL WITH DEFAULT;
   IntOTWR = INTEGER NOT NULL WITH DEFAULT;
   IntOTWS = INTEGER NOT NULL WITH DEFAULT;
   IntFG = INTEGER NOT NULL WITH DEFAULT;
   IntILOC = INTEGER NOT NULL WITH DEFAULT;
   IntINSP = INTEGER NOT NULL WITH DEFAULT;
   IntLOC = INTEGER NOT NULL WITH DEFAULT;
   IntTEST = INTEGER NOT NULL WITH DEFAULT;
   IntPFS = INTEGER NOT NULL WITH DEFAULT;
   IntPFSS = INTEGER NOT NULL WITH DEFAULT;
   IntPFSF = INTEGER NOT NULL WITH DEFAULT;

   MsgTxt = VARCHAR(400) NOT NULL;   
   TempStep = INTEGER NOT NULL;
   TempDuration = INTEGER NOT NULL WITH DEFAULT;
   TempStartTime = DATE NOT NULL;
   TempEndTime   = DATE NOT NULL;
BEGIN
   TotalTime = 0;
/*
** Get the bogey time for the combined total
*/
   IF OpStep = Type$ISOStep OR OpStep = Type$STA OR OpStep = Type$ISTA OR OpStep = Type$ABF THEN
      
      TotalStep = Type$ISTA;                
   ELSEIF OpStep = Type$OTWR OR OpStep = Type$OTWS OR OpStep = Type$OTW OR OpStep = Type$OTWPlus THEN
      
      TotalStep = Type$OTW;
   ELSEIF OpStep = Type$ILOC OR OpStep = Type$INSP OR OpStep = Type$LOC THEN
      
      TotalStep = Type$ILOC;
   ELSEIF OpStep = Type$FG OR OpStep = Type$TEST OR OpStep = Type$PFS OR OpStep = Type$PFSS OR 
      OpStep = Type$PFSF THEN
      
      TotalStep = Type$PFS;
   ELSE
      TotalStep = OpStep;
      SingleStep = TRUE;
   ENDIF;
  

   IF SingleStep = TRUE THEN  
      TotalTime = interval('minute',date('now') - StartTime);
      Msgtxt = StatusName + ' on feeder ' + 
               FeederName + ' (' + 
               CardClassName + 
               ') has exceeded bogey time.  Feeder has been in ' +
               StatusName + 
               ' for ' + VARCHAR(TotalTime) + ' minutes.';     

      RETURN (Msgtxt);
   ENDIF;
/*
** Get the durations of other steps
*/ 
   IntSTA = 0;
   IntISO = 0;
   IntISTA = 0;
   IntABF = 0;
   IntOTW = 0;
   IntOTWPlus = 0;
   IntOTWR = 0;
   IntOTWS = 0;
   IntFG = 0;
   IntILOC = 0;
   IntINSP = 0;
   IntLOC = 0;
   IntTEST = 0;
   IntPFS = 0;
   IntPFSS = 0;
   IntPFSF = 0;
   
   REPEATED
   SELECT :TempStep = OS.OperatingStep,
          :TempDuration = OS.DurationMins,
          :TempStartTime = OS.StartTime,
          :TempEndTime = OS.EndTime
   FROM   FMS_OperatingStepStatus OS
   WHERE  OS.Card = :Card AND
          OS.OperatingStep IN (:Type$ISOStep, :Type$STA, :Type$ISTA, :Type$ABF,
                               :Type$OTW, :Type$OTWR, :Type$OTWS, :Type$OTWPlus,
                               :Type$FG, :Type$ILOC, :Type$INSP, :Type$LOC, 
                               :Type$TEST, :Type$PFS, :Type$PFSS, :Type$PFSF)
   BEGIN
      /* 
      ** Current op step
      */
      IF TempEndTime = '' THEN
         TempDuration = interval('minute',date('now') - TempStartTime);         
      ENDIF;
      
      IF TempStep = Type$STA THEN
         IntSTA = IntSTA + TempDuration;
 
      ELSEIF TempStep = Type$ISOStep THEN
         IntISO = IntISO + TempDuration;

      ELSEIF TempStep = Type$ISTA THEN
         IntISTA = IntISTA + TempDuration;

      ELSEIF TempStep = Type$ABF THEN
         IntABF = IntABF + TempDuration;

      ELSEIF TempStep = Type$OTW THEN
         IntOTW = IntOTW + TempDuration;

      ELSEIF TempStep = Type$OTWPlus THEN
         IntOTWPlus = IntOTWPlus + TempDuration;

      ELSEIF TempStep = Type$OTWR THEN
         IntOTWR = IntOTWR + TempDuration;

      ELSEIF TempStep = Type$OTWS THEN
         IntOTWS = IntOTWS + TempDuration;

      ELSEIF TempStep = Type$FG THEN
         IntFG = IntFG + TempDuration;

      ELSEIF TempStep = Type$ILOC THEN
         IntILOC = IntILOC + TempDuration;

      ELSEIF TempStep = Type$INSP THEN
         IntINSP = IntINSP + TempDuration;

      ELSEIF TempStep = Type$LOC THEN
         IntLOC = IntLOC + TempDuration;

      ELSEIF TempStep = Type$TEST THEN
         IntTEST = IntTEST + TempDuration;

      ELSEIF TempStep = Type$PFS THEN
         IntPFS = IntPFS + TempDuration;

      ELSEIF TempStep = Type$PFSS THEN
         IntPFSS = IntPFSS + TempDuration;

      ELSEIF TempStep = Type$PFSF THEN
         IntPFSF = IntPFSF + TempDuration;

      ENDIF;
   END;
   CALLPROC DDB_ROLLBACK;         
/* 
** Add all steps together
*/
   IF OpStep = Type$ISOStep OR OpStep = Type$STA OR OpStep = Type$ISTA OR OpStep = Type$ABF THEN
      TotalTime = IntISO + IntSTA + IntISTA + IntABF;             
      Msgtxt = StatusName + ' on feeder ' + FeederName + ' (' + CardClassName + 
               ') has exceeded bogey time. ' + StatusName + ' is part of the ISTA ' +
               'composite step which includes: ISO, STA, ISTA & ABF. ' + 
               'Feeder has been in ISTA for ' +
               VARCHAR(TotalTime) + ' minutes. (';
      IF IntISO <> 0 THEN
         Msgtxt = Msgtxt + 'ISO=' + varchar(IntISO) + ' minutes ';
      ENDIF;     

      IF Intsta <> 0 THEN
         Msgtxt = Msgtxt + 'STA=' + varchar(IntSTA) + ' minutes ';
      ENDIF;     

      IF IntISTA <> 0 THEN
         Msgtxt = Msgtxt + 'ISTA=' + varchar(IntISTA) + ' minutes ';
      ENDIF;     

      IF IntABF <> 0 THEN
         Msgtxt = Msgtxt + 'ABF=' + varchar(IntABF) + ' minutes ';
      ENDIF;     
      Msgtxt = Msgtxt + ')';

   ELSEIF OpStep = Type$OTWR OR OpStep = Type$OTWS OR OpStep = Type$OTW OR OpStep = Type$OTWPlus THEN
      TotalTime = IntOTW + IntOTWR + IntOTWS + IntOTWPlus;

      Msgtxt = StatusName + ' on feeder ' + FeederName + ' (' + CardClassName + 
               ') has exceeded bogey time. ' + StatusName + ' is part of the OTW ' +
               'composite step which includes: OTWR, OTWS & OTW+. ' + 
               'Feeder has been in OTW for ' +
               VARCHAR(TotalTime) + ' minutes. (';
      /*
      **  First two should be 0 most of the time so we won't alwasy show them.
      */
      IF IntOTW <> 0 THEN
         Msgtxt = Msgtxt + 'OTW=' + varchar(IntOTW) + ' minutes ';
      ENDIF;     

      IF IntOTWPlus <> 0 THEN
         Msgtxt = Msgtxt + 'OTW+=' + varchar(IntOTWPlus) + ' minutes ';
      ENDIF;     

      Msgtxt = Msgtxt + 'OTWR=' + varchar(IntOTWR) + ' minutes, ';

      Msgtxt = Msgtxt + 'OTWS=' + varchar(IntOTWS) + ' minutes)';    

   ELSEIF OpStep = Type$ILOC OR OpStep = Type$INSP OR OpStep = Type$LOC THEN
      TotalTime = IntILOC + IntINSP + IntLOC;

      Msgtxt = StatusName + ' on feeder ' + FeederName + ' (' + CardClassName + 
               ') has exceeded bogey time. ' + StatusName + ' is part of the I/LOC ' +
               'composite step which includes: INSP & LOC. ' + 
               'Feeder has been in I/LOC for ' +
               VARCHAR(TotalTime) + ' minutes. (';
      Msgtxt = Msgtxt + 'INSP=' + varchar(IntINSP) + ' minutes, ';

      Msgtxt = Msgtxt + 'LOC=' + varchar(IntLOC) + ' minutes)';

   ELSEIF OpStep = Type$FG OR OpStep = Type$TEST OR OpStep = Type$PFS OR OpStep = Type$PFSS OR OpStep = Type$PFSF THEN
      TotalTime = IntFG + IntTEST + IntPFS + IntPFSS + IntPFSF;
   
      Msgtxt = StatusName + ' on feeder ' + FeederName + ' (' + CardClassName + 
               ') has exceeded bogey time. ' + StatusName + ' is part of the PFS ' +
               'composite step which includes: FG, TEST, PFSS & PFSF. ' + 
               'Feeder has been in PFS for ' +
               VARCHAR(TotalTime) + ' minutes. (';
      IF IntFG <> 0 THEN
         Msgtxt = Msgtxt + 'FG=' + varchar(IntFG) + ' minutes ';
      ENDIF;     

      IF IntTEST <> 0 THEN
         Msgtxt = Msgtxt + 'TEST=' + varchar(IntTEST) + ' minutes ';
      ENDIF;     

      IF IntPFSS <> 0 THEN
         Msgtxt = Msgtxt + 'PFSS=' + varchar(IntPFSS) + ' minutes ';
      ENDIF;     

      IF IntPFSF <> 0 THEN
         Msgtxt = Msgtxt + 'PFSF=' + varchar(IntPFSF) + ' minutes ';
      ENDIF;     
      Msgtxt = Msgtxt + ')';
   ENDIF;


   RETURN (MsgTxt);
END;

