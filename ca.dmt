**               a subset of requests in that work group because a work group may correspond to multile JobClasses 
**  10/22/13 ysp filter out Locally Authorized requests. 
**  10/29/13 ysp 1. support filter by ECB subgroups 
**  12/02/13 ysp Fix report queries of ECB subgroups
**  01/02/15 ysp 1. Add Compliance attribute 2. Filter by ID (ISWP or Work Permit), 3. add PIFilter used in
**               LoadRequestList. 4. Fix queries in LoadMgmtReport
**  03/11/15 pkw Change Loadmgmtreport to use ReportTime instead of CloseTime
**  07/29/15 ysp Add loading of requests submitted to RCC
**  05/23/16 ysp Fix LoadMgmtReport & LoadRequestList - use Request's StartDate to determine 
**               if the request is submitted as pre-issued.
**  03/03/17 em  Extend SLC specific code to TFMS for new link to TOMS WP 
**  02/15/18 ysp Add request Emergent attribute
**  05/07/18 ysp Count emergent tickets towards the pre-issue bucket. 
**  10/23/18 ysp replace RetrieveWorkPermit calls in LoadISPList with querys to the work permit tables.
**  06/03/19 ysp Modified LoadRequestList method to support special Westchester substations grouped to PST_X grouping
**  07/01/19 ysp Add LoadRestrictions and CheckRestrictionOnCircuit methods
**  10/09/19 ysp Add impacted substations in LoadRestrictions
**  12/09/19 ysp Add HandsOff attribute
**  12/30/19 em  Add Work Group Cap_Const. (22901)
**  12/07/23 ysp Modify LoadISPList for ISWP summary for Substation Shift Manager
*/ 
METHOD LoadISPList (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;
   x  = INTEGER NOT NULL WITH DEFAULT;
   
   Division = INTEGER NOT NULL WITH DEFAULT;
   StatusClause = VARCHAR(600) NOT NULL WITH DEFAULT;
   FilterClause1 = VARCHAR(400) NOT NULL WITH DEFAULT;
   FilterClause2 = VARCHAR(400) NOT NULL WITH DEFAULT;
   DynamicWhereClause1 = VARCHAR(1200) NOT NULL WITH DEFAULT;
   DynamicWhereClause2 = VARCHAR(1200) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   GroupObject = INTEGER NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
   RouteList = VARCHAR(80) NOT NULL WITH DEFAULT;
   ObjectList = ARRAY OF ObjectClass; /* Lines and Feeders */
   RouteName = VARCHAR(40) NOT NULL WITH DEFAULT;
   FoundFeeder = INTEGER NOT NULL WITH DEFAULT;
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';
   StatusClause = '';
   CurObject.PL.Clear();

   IF CurObject.FilterType = 'ONLINE' THEN
      IF CurObject.StartDateFilter <> '' THEN 
         StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
      ENDIF;
      IF CurObject.EndDateFilter <> '' THEN
         EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
      ENDIF;

      IF UPPERCASE(CurObject.ApplicationFilter) <> 'ALL' THEN
         StatusClause = ' P.Application = ''' + UPPERCASE(CurObject.ApplicationFilter) + ''' AND ';
      ENDIF;

      IF CurObject.GroupFilter <> '' THEN
         IF CurObject.GroupFilter LIKE 'SSM_%' THEN
            GroupObject = 0;
            SELECT :GroupObject = Object
            FROM   UDB_Object
            WHERE  Type = 22648 AND               //SSM
                   Name = :CurObject.GroupFilter;

            StatusClause = StatusClause  + ' P.WorkGroup = ''SSM'' AND P.Substation IN ( ' + 
                   ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
                   ' AND Grouping = ' + VARCHAR(GroupObject) + 
                   ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ') AND ';

         ELSEIF CurObject.GroupFilter LIKE 'ECB_%' THEN
            GroupList = '';
            SELECT :Division = G.Member
            FROM   UDB_Object O,
                   UDB_Grouping G
            WHERE  O.Type = 22615 AND               // ECB
                   O.Name = :CurObject.GroupFilter AND
                   O.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = :Type$Division
            BEGIN
               IF GroupList <> '' THEN
                  GroupList = GroupList + ',';
               ENDIF;
               GroupList = GroupList + VARCHAR(Division);
            END;

            StatusClause = StatusClause  + ' P.WorkGroup = ''ECB'' AND P.Division IN (' + GroupList + ') AND ';
            
         ELSEIF CurObject.GroupFilter LIKE 'PST_%' THEN
            GroupList = '';
            SELECT :Division = G.Member
            FROM   UDB_Object O,
                   UDB_Grouping G
            WHERE  O.Type = 22619 AND               // PST
                   O.Name = :CurObject.GroupFilter AND
                   O.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = :Type$Division
            BEGIN
               IF GroupList <> '' THEN
                  GroupList = GroupList + ',';
               ENDIF;
               GroupList = GroupList + VARCHAR(Division);
            END;

            StatusClause = StatusClause  + ' P.WorkGroup = ''PST'' AND P.Division IN (' + GroupList + ') AND ';

         ELSEIF CurObject.GroupFilter LIKE 'TMG_%' THEN
            GroupList = '';
            SELECT :Division = G.Member
            FROM   UDB_Object O,
                   UDB_Grouping G
            WHERE  O.Type = 22642 AND               // TMG
                   O.Name = :CurObject.GroupFilter AND
                   O.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = :Type$Division
            BEGIN
               IF GroupList <> '' THEN
                  GroupList = GroupList + ',';
               ENDIF;
               GroupList = GroupList + VARCHAR(Division);
            END;

            StatusClause = StatusClause  + ' P.WorkGroup = ''TMG'' AND P.Division IN (' + GroupList + ') AND ';

         ELSEIF CurObject.GroupFilter LIKE 'Cap_Const%' THEN
            GroupList = '';
            SELECT :Division = G.Member
            FROM   UDB_Object O,
                   UDB_Grouping G
            WHERE  O.Type = 22901 AND               // Cap_Const.
                   O.Name = :CurObject.GroupFilter AND
                   O.Object = G.Grouping AND
                   G.Relationship = :Interaction$MemberOf AND
                   G.MemberType = :Type$Division
            BEGIN
               IF GroupList <> '' THEN
                  GroupList = GroupList + ',';
               ENDIF;
               GroupList = GroupList + VARCHAR(Division);
            END;

            StatusClause = StatusClause  + ' P.WorkGroup = ''Cap_Const.'' AND P.Division IN (' + GroupList + ') AND ';
         ELSE
            StatusClause = StatusClause  + ' P.WorkGroup = ''' + VARCHAR(CurObject.GroupFilter) + ''' AND ';
         ENDIF;
      ENDIF;

      IF CurObject.StatusFilter = ISPStatus$AllCurrent THEN	// all current
         StatusClause = StatusClause + 
                        ' P.Status >= ' + VARCHAR(ISPStatus$Request) +  ' AND ' + 
                        ' P.Status < ' + VARCHAR(ISPStatus$Archived) +  ' AND ' + 
                        ' P.Status <> ' + VARCHAR(ISPStatus$RequestDenied) +  ' AND ' + 
                        ' NOT (P.Status =' + VARCHAR(ISPStatus$Open) + ' AND P.CreatedBy = ''DO'') AND ';

      ELSEIF CurObject.StatusFilter = ISPStatus$AllRequests THEN	// including pending requests
          StatusClause = StatusClause + 
                         ' P.Status IN (' + VARCHAR(ISPStatus$Request) + ',' +
                                            VARCHAR(ISPStatus$RequestPending) + ') AND ';   

      ELSEIF CurObject.StatusFilter = ISPStatus$AllReviewed THEN	// all reviewed
          StatusClause = StatusClause + 
                         ' P.Status IN (' + VARCHAR(ISPStatus$Approved) + ',' +
                                            VARCHAR(ISPStatus$CondApproved) + ',' + 
                                            VARCHAR(ISPStatus$Denied) + ',' +
                                            VARCHAR(ISPStatus$Pending) + ') AND ';   
 
      ELSEIF CurObject.StatusFilter = ISPStatus$AllApproved THEN	// all approved
          StatusClause = StatusClause + 
                         ' P.Status IN (' + VARCHAR(ISPStatus$Approved) + ',' +
                                            VARCHAR(ISPStatus$CondApproved) + ') AND ';    

      ELSEIF CurObject.StatusFilter = ISPStatus$AllIssued THEN		// all issued from T.O. perspective
          StatusClause = StatusClause + 
                         ' P.Status IN (' + VARCHAR(ISPStatus$Submitted) + ',' +
                                            VARCHAR(ISPStatus$Issued) + ') AND ';    

      ELSEIF CurObject.StatusFilter = ISPStatus$AllPulled THEN		// all pulled by T.O.
          StatusClause = StatusClause + 
                         ' P.Status IN (' + VARCHAR(ISPStatus$Withdrawn) + ',' +
                                            VARCHAR(ISPStatus$WithdrawRequest) + ') AND ';    

      ELSEIF CurObject.StatusFilter = ISPStatus$Open THEN		// opened by T.O. or S.M.
          IF CurObject.UserName = 'TO' THEN
             StatusClause = StatusClause + 
                         ' P.Status = ' + VARCHAR(ISPStatus$Open) + ' AND ' + 
                         ' P.CreatedBy = ''TO'' AND ';
          ELSEIF CurObject.UserName = 'SM' THEN
             StatusClause = StatusClause + 
                         ' P.Status = ' + VARCHAR(ISPStatus$Open) + ' AND ' + 
                         ' P.CreatedBy = ''SM'' AND ';
          ENDIF;

      ELSEIF CurObject.StatusFilter = ISPStatus$AllDO THEN		// DO created permits 
          StatusClause = StatusClause + 
                         ' P.Status < ' + VARCHAR(ISPStatus$Archived) +  ' AND ';

      ElseIf CurObject.StatusFilter = ISPStatus$SSMCurrent Then		// all current for SSM screen
		  StatusClause = StatusClause + 
						 ' P.Status >= ' + VARCHAR(ISPStatus$Issued) + ' AND ' +
						 ' P.Status < ' + VARCHAR(ISPStatus$Archived) + ' AND ' +
						 ' P.Status <> ' + VARCHAR(ISPStatus$Local) + ' AND ';

      ELSEIF CurObject.StatusFilter <> 0 THEN	// other
          StatusClause = StatusClause + 
                         ' P.Status = ' + VARCHAR(CurObject.StatusFilter) + ' AND ';
      ENDIF;

      IF CurObject.StatusFilter = ISPStatus$AllDO THEN
         StatusClause = StatusClause + ' P.Jurisdiction IN (''DO'',''DV'') AND ';

      ELSEIF CurObject.UserName = 'TO' THEN
         /* TO don't want to see requests on DO's desk, but want to see dielectric requests (where jurisdiction = 'SM')
         */
         StatusClause = StatusClause + ' (P.Jurisdiction = ''TO'' OR ' +
                     ' (P.Jurisdiction = ''SM'' AND P.Status >= ' + VARCHAR(ISPStatus$CondApproved) + ')) AND ';
      ENDIF;
      
      /*
      ** exclude feeder and unit substation permits from T.O. and SM
      */
      StatusClause = StatusClause + 
             ' P.LocalAuthorization = 0 AND ' +
             ' P.ObjectType NOT IN (' + VARCHAR(Type$Feeder) + ',' + 
                                        VARCHAR(Type$UnitSubstation) + ') AND ';

      FilterClause1 = '';
      FilterClause2 = '';

      IF CurObject.DivisionFilter = 10001 THEN		// CCTN and Others
         StatusClause = StatusClause + ' P.ISPermit = R.ISPermit AND ';

         FilterClause1 = ' P.ObjectType IN (0, 1) ';
 
         IF StartDate <> '' AND EndDate <> '' THEN
            FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
                  'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
         ENDIF;
         IF CurObject.IDTypeFilter = 1 THEN
            FilterClause2 = FilterClause2 + ' AND P.ISPermit=' + VARCHAR(CurObject.IDFilter);
         ELSEIF CurObject.IDTypeFilter = 2 THEN
            FilterClause2 = FilterClause2 + ' AND P.Job=' + VARCHAR(CurObject.IDFilter);
         ENDIF;

         /* DO NOT CHANGE FilterClause1/2 HERE because they may be used in the second SELECT.
         */  
         DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
         // CurMethod.Trace(Text = varchar(date('now')) + ' DynamicWhereClause1: ' + DynamicWhereClause1 );  
         
         i = 1;
         SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                :CurObject.PL[i].Job = P.Job, 
                :CurObject.PL[i].Division = P.Division, 
                :CurObject.PL[i].Substation = P.Substation, 
                :CurObject.PL[i].SubstationName = '',
                :CurObject.PL[i].SubstationRating = P.SubstationRating,
                :CurObject.PL[i].Application = P.Application,    
                :CurObject.PL[i].ObjectType = P.ObjectType,    
                :CurObject.PL[i].Object = P.Object,    
                :CurObject.PL[i].ObjectName = P.ObjectName,    
                :CurObject.PL[i].JobClass = P.JobClass,        
                :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                :CurObject.PL[i].PermitMove = P.PermitMove,			    
                :CurObject.PL[i].PreIssued = P.PreIssued,		    
                :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,
                :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
                :CurObject.PL[i].NYISONotified = P.NYISONotified,
                :CurObject.PL[i].Compliance = P.Compliance,
                :CurObject.PL[i].EnterTime = P.EnterTime,		    
                :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                :CurObject.PL[i].EnterBy = P.EnterBy,		      
                :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                :CurObject.PL[i].Status = P.Status,			      
                :CurObject.PL[i].StatusTime = P.StatusTime,			      
                :CurObject.PL[i].CloseTime = P.CloseTime,			        
                :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			      
         FROM   SOA_InServicePermit P,
                SOA_ISPermitRequest R
         WHERE  :DynamicWhereClause1
         ORDER BY EnterTime
         BEGIN
            i = i + 1;
         END;
         
         /* if TO is using Pending TO filter, load non-pre-issued requests as well 
         */ 
         IF CurObject.UserName = 'TO' AND CurObject.StatusFilter = ISPStatus$PendingTO THEN	// Pending TO
            StatusClause = ' P.Status = ' + VARCHAR(ISPStatus$Request) + ' AND ' +
                           ' P.Jurisdiction = ''TO'' AND ' + 
                           ' P.ISPermit = R.ISPermit AND ';

            DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;

            SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                   :CurObject.PL[i].Job = P.Job, 
                   :CurObject.PL[i].Division = P.Division, 
                   :CurObject.PL[i].Substation = P.Substation, 
                   :CurObject.PL[i].SubstationName = '', 
                   :CurObject.PL[i].SubstationRating = P.SubstationRating,
                   :CurObject.PL[i].Application = P.Application,
                   :CurObject.PL[i].ObjectType = P.ObjectType,    
                   :CurObject.PL[i].Object = P.Object,    
                   :CurObject.PL[i].ObjectName = P.ObjectName,        
                   :CurObject.PL[i].JobClass = P.JobClass,        
                   :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                   :CurObject.PL[i].PermitMove = P.PermitMove,			    
                   :CurObject.PL[i].PreIssued = P.PreIssued,		    
                   :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
                   :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,  
                   :CurObject.PL[i].NYISONotified = P.NYISONotified,
                   :CurObject.PL[i].Compliance = P.Compliance,
                   :CurObject.PL[i].EnterTime = P.EnterTime,		    
                   :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                   :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                   :CurObject.PL[i].EnterBy = P.EnterBy,		      
                   :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                   :CurObject.PL[i].Status = P.Status,			      
                   :CurObject.PL[i].StatusTime = P.StatusTime,			      
                   :CurObject.PL[i].CloseTime = P.CloseTime,			        
                   :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			      
            FROM   SOA_InServicePermit P,
                   SOA_ISPermitRequest R
            WHERE  :DynamicWhereClause1 
            ORDER BY EnterTime
            BEGIN
               i = i + 1;
            END;
         ENDIF;                  

      ELSEIF CurObject.DivisionFilter <> 0 AND CurObject.SubstationFilter = 0 THEN		         
         // filter by division
         FilterClause1 = 'G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
                'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
                'G.Member = P.Substation AND ' +    
                'P.Substation = O.Object ';
 
         IF StartDate <> '' AND EndDate <> '' THEN
            FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
                  'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
         ENDIF;
         IF CurObject.IDTypeFilter = 1 THEN
            FilterClause2 = FilterClause2 + ' AND P.ISPermit=' + VARCHAR(CurObject.IDFilter);
         ELSEIF CurObject.IDTypeFilter = 2 THEN
            FilterClause2 = FilterClause2 + ' AND P.Job=' + VARCHAR(CurObject.IDFilter);
         ENDIF;

         DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
         // CurMethod.Trace(Text = varchar(date('now')) + ' DynamicWhereClause1: ' + DynamicWhereClause1 );  
         
         i = 1;
         SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                :CurObject.PL[i].Job = P.Job, 
                :CurObject.PL[i].Division = P.Division, 
                :CurObject.PL[i].Substation = P.Substation, 
                :CurObject.PL[i].SubstationName = O.Description, 
                :CurObject.PL[i].SubstationRating = P.SubstationRating,
                :CurObject.PL[i].Application = P.Application,    
                :CurObject.PL[i].ObjectType = P.ObjectType,    
                :CurObject.PL[i].Object = P.Object,    
                :CurObject.PL[i].ObjectName = P.ObjectName,    
                :CurObject.PL[i].JobClass = P.JobClass,        
                :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                :CurObject.PL[i].PermitMove = P.PermitMove,			    
                :CurObject.PL[i].PreIssued = P.PreIssued,		    
                :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
                :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,  
                :CurObject.PL[i].NYISONotified = P.NYISONotified,
                :CurObject.PL[i].Compliance = P.Compliance,
                :CurObject.PL[i].EnterTime = P.EnterTime,		    
                :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                :CurObject.PL[i].EnterBy = P.EnterBy,		      
                :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                :CurObject.PL[i].Status = P.Status,			      
                :CurObject.PL[i].StatusTime = P.StatusTime,			      
                :CurObject.PL[i].CloseTime = P.CloseTime        
         FROM   SOA_InServicePermit P,
                UDB_Grouping G,
                UDB_Object O
         WHERE  :DynamicWhereClause1
         ORDER BY EnterTime
         BEGIN
            IF CurObject.UserName = 'SM' THEN
               // wish Openroad will support outer join someday
               SELECT :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName
               FROM   SOA_ISPermitRequest R
               WHERE  R.ISPermit = :CurObject.PL[i].ISPermit;
            ENDIF;
            i = i + 1;
         END;

         /* if TO is using Pending TO filter, load non-pre-issued requests as well 
         */ 
         IF CurObject.UserName = 'TO' AND CurObject.StatusFilter = ISPStatus$PendingTO THEN	// Pending TO
            StatusClause = ' P.Status = ' + VARCHAR(ISPStatus$Request) + ' AND ' +
                           ' P.Jurisdiction = ''TO'' AND ' +
                           ' P.ISPermit = R.ISPermit AND ';

            //Obsolete:     ' R.StartDate = '''' AND ';   
            DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
            // CurMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  

            SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                   :CurObject.PL[i].Job = P.Job, 
                   :CurObject.PL[i].Division = P.Division, 
                   :CurObject.PL[i].Substation = P.Substation, 
                   :CurObject.PL[i].SubstationName = O.Description,
                   :CurObject.PL[i].SubstationRating = P.SubstationRating, 
                   :CurObject.PL[i].Application = P.Application,
                   :CurObject.PL[i].ObjectType = P.ObjectType,    
                   :CurObject.PL[i].Object = P.Object,    
                   :CurObject.PL[i].ObjectName = P.ObjectName,        
                   :CurObject.PL[i].JobClass = P.JobClass,        
                   :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                   :CurObject.PL[i].PermitMove = P.PermitMove,			    
                   :CurObject.PL[i].PreIssued = P.PreIssued,		    
                   :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
                   :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,  
                   :CurObject.PL[i].NYISONotified = P.NYISONotified,
                   :CurObject.PL[i].Compliance = P.Compliance,
                   :CurObject.PL[i].EnterTime = P.EnterTime,		    
                   :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                   :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                   :CurObject.PL[i].EnterBy = P.EnterBy,		      
                   :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                   :CurObject.PL[i].Status = P.Status,			      
                   :CurObject.PL[i].StatusTime = P.StatusTime,			      
                   :CurObject.PL[i].CloseTime = P.CloseTime,
                   :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			        
            FROM   SOA_InServicePermit P,
                   SOA_ISPermitRequest R,
                   UDB_Grouping G,
                   UDB_Object O 
            WHERE  :DynamicWhereClause1 
            ORDER BY EnterTime
            BEGIN
               i = i + 1;
            END;
         ENDIF;
      ELSE
         // filter by substation
         IF CurObject.SubstationFilter <> 0 THEN
            FilterClause1 = 'P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
         ENDIF;
         FilterClause1 = FilterClause1 + ' P.Substation = O.Object ';
 
         IF StartDate <> '' AND EndDate <> '' THEN
            FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
                  'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
         ENDIF;
         IF CurObject.IDTypeFilter = 1 THEN
            FilterClause2 = FilterClause2 + ' AND P.ISPermit=' + VARCHAR(CurObject.IDFilter);
         ELSEIF CurObject.IDTypeFilter = 2 THEN
            FilterClause2 = FilterClause2 + ' AND P.Job=' + VARCHAR(CurObject.IDFilter);
         ENDIF;

         DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
         //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 ); 

         i = 1;
         SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                :CurObject.PL[i].Job = P.Job, 
                :CurObject.PL[i].Division = P.Division, 
                :CurObject.PL[i].Substation = P.Substation, 
                :CurObject.PL[i].SubstationName = O.Description,
                :CurObject.PL[i].SubstationRating = P.SubstationRating, 
                :CurObject.PL[i].Application = P.Application,
                :CurObject.PL[i].ObjectType = P.ObjectType,    
                :CurObject.PL[i].Object = P.Object,    
                :CurObject.PL[i].ObjectName = P.ObjectName,        
                :CurObject.PL[i].JobClass = P.JobClass,        
                :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                :CurObject.PL[i].PermitMove = P.PermitMove,			    
                :CurObject.PL[i].PreIssued = P.PreIssued,		    
                :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
                :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
                :CurObject.PL[i].NYISONotified = P.NYISONotified,  
                :CurObject.PL[i].Compliance = P.Compliance,
                :CurObject.PL[i].EnterTime = P.EnterTime,		    
                :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                :CurObject.PL[i].EnterBy = P.EnterBy,		      
                :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                :CurObject.PL[i].Status = P.Status,			      
                :CurObject.PL[i].StatusTime = P.StatusTime,			      
                :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                :CurObject.PL[i].CloseTime = P.CloseTime		        
         FROM   SOA_InServicePermit P,
                UDB_Object O
         WHERE  :DynamicWhereClause1 
         ORDER BY EnterTime
         BEGIN
            IF CurObject.UserName = 'SM' THEN
               // wish Openroad will support outer join someday
               SELECT :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName
               FROM   SOA_ISPermitRequest R
               WHERE  R.ISPermit = :CurObject.PL[i].ISPermit;
            ENDIF;
            i = i + 1;
         END;

         /* if TO is using Pending TO filter, load non-pre-issued requests as well 
         */ 
         IF CurObject.UserName = 'TO' AND CurObject.StatusFilter = ISPStatus$PendingTO THEN	// Pending TO
            StatusClause = ' P.Status = ' + VARCHAR(ISPStatus$Request) + ' AND ' +
                           ' P.Jurisdiction = ''TO'' AND ' +
                           ' P.ISPermit = R.ISPermit AND '; 
 
            //Obsolete:                ' R.StartDate = '''' AND ';   
            DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
            //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 ); 

            SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
                   :CurObject.PL[i].Job = P.Job, 
                   :CurObject.PL[i].Division = P.Division, 
                   :CurObject.PL[i].Substation = P.Substation, 
                   :CurObject.PL[i].SubstationName = O.Description,
                   :CurObject.PL[i].SubstationRating = P.SubstationRating, 
                   :CurObject.PL[i].Application = P.Application,
                   :CurObject.PL[i].ObjectType = P.ObjectType,    
                   :CurObject.PL[i].Object = P.Object,    
                   :CurObject.PL[i].ObjectName = P.ObjectName,    
                   :CurObject.PL[i].JobClass = P.JobClass,        
                   :CurObject.PL[i].WorkGroup = P.WorkGroup,        
                   :CurObject.PL[i].PermitMove = P.PermitMove,			    
                   :CurObject.PL[i].PreIssued = P.PreIssued,		    
                   :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
                   :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
                   :CurObject.PL[i].NYISONotified = P.NYISONotified,  
                   :CurObject.PL[i].Compliance = P.Compliance,
                   :CurObject.PL[i].EnterTime = P.EnterTime,		    
                   :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
                   :CurObject.PL[i].EnterBy = P.EnterBy,		      
                   :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
                   :CurObject.PL[i].Status = P.Status,			      
                   :CurObject.PL[i].StatusTime = P.StatusTime,			      
                   :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
                   :CurObject.PL[i].CloseTime = P.CloseTime,
                   :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName			        
            FROM   SOA_InServicePermit P,
                   SOA_ISPermitRequest R,
                   UDB_Object O
            WHERE  :DynamicWhereClause1 
            ORDER BY EnterTime
            BEGIN
               i = i + 1;
            END;
         ENDIF;
      ENDIF;           
/* 
** if this order has been issued, we want the SSO order status.
*/
      FOR i = 1 TO CurObject.PL.LastRow() DO
         IF CurObject.PL[i].Status = ISPStatus$Submitted THEN
            CurObject.PL[i].SSO_Status_Name = 'DO Cond';

         ELSEIF CurObject.PL[i].Status >= ISPStatus$Issued THEN
            /* 
            ** Default SSO Status to Verbal for Issued orders,
            */
            CurObject.PL[i].SSO_Status_Name = 'Verbal';

            OrderNumber = 0;
            IF CurObject.PL[i].Application = Application$SLC OR CurObject.PL[i].Application = Application$TFMS THEN
               REPEATED
               SELECT :OrderNumber = O.OrderNumber,
                      :CurObject.PL[i].SSO_Status = O.OrderStatus
               FROM   IR_OperatingOrder O
               WHERE  O.OrderNumber = (SELECT MAX(OJ.OrderNumber) 
                                       FROM IR_OpOrderJobs OJ 
                                       WHERE OJ.Job = :CurObject.PL[i].Job);
            ELSEIF CurObject.PL[i].Application = Application$TLS THEN
               REPEATED
               SELECT :OrderNumber = O.OrderNumber,
                      :CurObject.PL[i].SSO_Status = O.OrderStatus
               FROM   IR_TelephoneOrder O
               WHERE  O.OrderNumber = (SELECT MAX(OJ.OrderNumber) 
                                       FROM   IR_TLSOrderJob OJ 
                                       WHERE OJ.Job = :CurObject.PL[i].Job);
            ENDIF;

            IF OrderNumber > 0 THEN
               IF CurObject.PL[i].SSO_Status = Order$Opened THEN
                  CurObject.PL[i].SSO_Status_Name = 'Opened';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Downloaded THEN
                  CurObject.PL[i].SSO_Status_Name = 'Downloaded';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Acknowledged THEN
                  CurObject.PL[i].SSO_Status_Name = 'Acknowledged';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Rejected THEN
                  CurObject.PL[i].SSO_Status_Name = 'Rejected';

               ELSEIF CurObject.PL[i].SSO_Status = Order$ConfirmRejected THEN
                  CurObject.PL[i].SSO_Status_Name = 'Rejected';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Rescinded THEN
                  CurObject.PL[i].SSO_Status_Name = 'Rescinded';

               ELSEIF CurObject.PL[i].SSO_Status = Order$ConfirmRescinded THEN
                  CurObject.PL[i].SSO_Status_Name = 'Rescinded';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Closed THEN
                  CurObject.PL[i].SSO_Status_Name = 'Closed';

               ELSEIF CurObject.PL[i].SSO_Status = Order$ConfirmClosed THEN
                  CurObject.PL[i].SSO_Status_Name = 'Closed';

               ELSEIF CurObject.PL[i].SSO_Status = Order$Cancelled THEN
                  CurObject.PL[i].SSO_Status_Name = 'Cancelled';
               ENDIF; 
            ENDIF;
         ENDIF;
      ENDFOR;
   ENDIF;

   /*
   ** work equipment and conditions and permit description
   */
   FOR i = 1 TO CurObject.PL.LastRow() DO
      /*
      ** ISP Request's Equipment information is stored in SOA_InServicePermit table.
      ** In order to show the equipment on T.O.'s summary screen, we load all the equipment
      ** as a piece of equipment to the equipment list for the request.
      */
      IF CurObject.PL[i].Status = ISPStatus$Request OR 
         CurObject.PL[i].Status = ISPStatus$RequestPending THEN         
         SELECT :CurObject.PL[i].EL[1].Object = 0,
                :CurObject.PL[i].EL[1].TypeName = '',
                :CurObject.PL[i].EL[1].Name = Equipment,
                :CurObject.PL[i].EL[1].PrimaryEquip = 1
         FROM   SOA_ISPermitRequest 
         WHERE  ISPermit = :CurObject.PL[i].ISPermit;
      ELSE
         j = 1;
         SELECT :CurObject.PL[i].EL[j].Object = Object,
                :CurObject.PL[i].EL[j].TypeName = TypeName,
                :CurObject.PL[i].EL[j].Name = Name,
                :CurObject.PL[i].EL[j].PrimaryEquip = PrimaryEquip
         FROM   IR_OpOrderFeeders 
         WHERE  ISPermit = :CurObject.PL[i].ISPermit
         BEGIN
            j = j + 1;
         END;
      ENDIF;

      j = 1;
      SELECT :CurObject.PL[i].CL[j].JobClass = JobClass,
             :CurObject.PL[i].CL[j].MoveText = MoveText
      FROM   SOA_ISPCondition 
      WHERE  ISPermit = :CurObject.PL[i].ISPermit
      BEGIN
         j = j + 1;
      END;

      IF CurObject.PL[i].Application = Application$SLC OR CurObject.PL[i].Application = Application$TFMS THEN
         /* CurObject.PL[i].SOA_WP.RetrieveWorkPermit (Job = CurObject.PL[i].Job);  */

         x = 0;
         SELECT :x = PermitJobID,
                :CurObject.PL[i].SOA_WP.Description = Description,
                :CurObject.PL[i].SOA_WP.PhaseCheckIndicator = PhaseCheckIndicator,
                :CurObject.PL[i].SOA_WP.AllRelaysNormal = AllRelaysNormal,
                :CurObject.PL[i].SOA_WP.DefectRelayComment = DefectRelayComment
         FROM   SOA_WorkPermit
         WHERE  PermitJobID = :CurObject.PL[i].Job;
         
         IF x = 0 THEN
            SELECT :x = PermitJobID,
                   :CurObject.PL[i].SOA_WP.Description = Description,
                   :CurObject.PL[i].SOA_WP.PhaseCheckIndicator = PhaseCheckIndicator,
                   :CurObject.PL[i].SOA_WP.AllRelaysNormal = AllRelaysNormal,
                   :CurObject.PL[i].SOA_WP.DefectRelayComment = DefectRelayComment
            FROM   SOA_ArchiveWorkPermit
            WHERE  PermitJobID = :CurObject.PL[i].Job;
         ENDIF;
         
         CurObject.PL[i].LockedPermit = CurObject.PL[i].SOA_WP.PhaseCheckIndicator;
         
      ELSEIF CurObject.PL[i].Application = Application$TLS THEN
         /* CurObject.PL[i].TLS_WP.RetrieveWorkPermit (Job = CurObject.PL[i].Job); */

         x = 0;
         SELECT :x = PermitJobID,
                :CurObject.PL[i].TLS_WP.Description = Description
         FROM   TC_WorkPermit
         WHERE  PermitJobID = :CurObject.PL[i].Job;
         
         IF x = 0 THEN
            SELECT :x = PermitJobID,
                   :CurObject.PL[i].TLS_WP.Description = Description
            FROM   TC_ArchiveWorkPermit
            WHERE  PermitJobID = :CurObject.PL[i].Job;
         ENDIF;          
                  
         CurObject.PL[i].SOA_WP.Description = CurObject.PL[i].TLS_WP.Description;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'No In-Service work permits match the filter criteria.';
   ENDIF;

   RETURN;
END;

METHOD SendForReview (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   OneUpdated = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   OneUpdated = FALSE;

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].UpdateStatus();
      IF CurObject.PL[i].ReturnCode = 0 THEN
         OneUpdated = TRUE;
      ENDIF;
   ENDFOR;

   /*
   ** notify S.O. of work permits to review
   */
   IF OneUpdated = TRUE THEN
      // 20 = PendSO
      MsgText = 'In-Service work permits sent by T.O. for <a target="fms" href="<%type=so_isp&status=' + 
                VARCHAR(ISPStatus$PendingSO) + '%>">Review</a>';

      RetCode = CALLPROC CSD_MessageIns(DeskType = 'so'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Permit status updated. But error notifying S.O.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.ISendForReview; ' + 
                'Error sending notification message.');
      ENDIF;
      CALLPROC DDB_COMMIT;

   ELSEIF CurObject.PL.LastRow = 1 THEN
      CurObject.ReturnCode = CurObject.PL[1].ReturnCode;
      CurObject.ErrorMessage = CurObject.PL[1].ErrorMessage;
   ENDIF;

   RETURN;   
END;


METHOD SOCompleteReview (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   // 40 = approved
   MsgText = 'S.O completed review of <a target="fms" href="<%type=to_isp&status=' + 
             VARCHAR(ISPStatus$AllReviewed) + '%>">In-Service work permits</a>';

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error notifying T.O. of reviewed permits';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.SOCompleteReview ; ' + 
                'Error notifying T.O.');
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   RETURN;
END;


METHOD DeletePermits (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      j = 1;
      SELECT :CurObject.PL[i].CL[j].Job = Job
      FROM   SOA_ISPCondition
      WHERE  ISPermit = :CurObject.PL[i].ISPermit
      BEGIN
         j = j + 1;
      END;
      CurObject.PL[i].DeleteISP();
   ENDFOR;

   RETURN;
END;

METHOD ClearPermits (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].ClearISP();
   ENDFOR;

   RETURN;
END;

METHOD PermitIssuedNotification (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   Card = INTEGER NOT NULL;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   DeskMessage = ARRAY OF ISPDeskMessage;
   DeskName = VARCHAR(10) NOT NULL WITH DEFAULT;
   MsgKey = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   CardNames = VARCHAR(100) NOT NULL WITH DEFAULT;
   NotifySSO = INTEGER NOT NULL WITH DEFAULT;
   OperatorName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SubstationName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Pre-set Array with error codes.
*/
   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].ReturnCode = -1;
      CurObject.PL[i].ErrorMessage = 'DEFAULT ERROR - DID NOT PROCESS THIS PERMIT';
   ENDFOR;
/*
** Create list of desks which will control distribution of incoming messages to the DO.
*/
   i = 1;
   DeskMessage.Clear();
   SELECT  :DeskMessage[i].DeskName = Name,
           :DeskMessage[i].Substation = 0,
           :DeskMessage[i].ConditionalPermit = 0,
           :DeskMessage[i].UnconditionalPermit = 0,
           :DeskMessage[i].TLSConditionalPermit = 0,
           :DeskMessage[i].TLSUnconditionalPermit = 0
   FROM    Udb_Object 
   WHERE   Type = :Type$OperatorDesk AND
           PrimaryGrouping <> 0
   BEGIN
      i = i + 1;
   END;

   FOR i = 1 TO CurObject.PL.LastRow() DO
/*
** Clear error code for this iteration.
*/
      CurObject.PL[i].ReturnCode = 0;
      CurObject.PL[i].ErrorMessage = '';

      REPEATED
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,
             :CurObject.PL[i].Job = P.Job,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime		    
      FROM   SOA_InServicePermit P,
             FMS_JobClass JC,
             Udb_Object O
      WHERE  P.ISPermit = :CurObject.PL[i].ISPermit AND
             P.JobClass = JC.JobClass AND
             P.Substation = O.Object;
/*
** Get deskname using division
*/
      DeskName = '';
      REPEATED 
      SELECT  :DeskName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.PL[i].Division AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = :Type$OperatorDesk AND
              G.Grouping = O.Object;
  
      RetCode = DeskMessage.Find(AttributeName = 'deskname',
                                    Value = DeskName,
                                    RowNumber = ByRef(j));
      IF RetCode = ER_OK THEN
         IF DeskMessage[j].Substation = 0 THEN 
            DeskMessage[j].Substation = CurObject.PL[i].Substation;  /* Set once for each desk*/
         ENDIF;

         IF CurObject.PL[i].Status = ISPStatus$Submitted THEN
/*
** Record DO conditional permits
*/
            IF CurObject.PL[i].Application = Application$SLC THEN
               DeskMessage[j].ConditionalPermit = DeskMessage[j].ConditionalPermit + 1;
            ELSE
               DeskMessage[j].TLSConditionalPermit = DeskMessage[j].TLSConditionalPermit + 1;
               /*
               ** check if a new TLS card is needed for this circuit.
               */
               CurObject.PL[i].GetTLSCard();
               IF CurObject.PL[i].Card = 0 THEN
                  DeskMessage[j].NewTLSCardList[DeskMessage[j].NewTLSCardList.LastRow+1].Value = CurObject.PL[i].ObjectName;
               ENDIF;
            ENDIF;
         ELSE
/*
** Record issued permits
*/
            IF CurObject.PL[i].Application = Application$SLC THEN
              DeskMessage[j].UnConditionalPermit = DeskMessage[j].UnConditionalPermit + 1;
            ELSE
              DeskMessage[j].TLSUnConditionalPermit = DeskMessage[j].TLSUnConditionalPermit + 1;
            ENDIF;
         ENDIF;
      ENDIF;  
   ENDFOR;
/*
** Will have to send Incoming Message to DO by desk
*/ 
   NotifySSO = FALSE;

   FOR j = 1 TO DeskMessage.LastRow() DO
/* Obsolete 04/07/09
      IF DeskMessage[j].UnconditionalPermit > 0 OR DeskMessage[j].TLSUnconditionalPermit > 0 THEN
            NotifySSO = TRUE;
      ENDIF; 
*/
     IF DeskMessage[j].ConditionalPermit > 0 THEN  /* Only send msg if conditional permits exist */
         MsgText = 'IN-SERVICE WORK PERMITS have been submitted by the Transmission Operator. ' + 
                   HC_NEWLINE + HC_NEWLINE;
         IF DeskMessage[j].UnconditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].UnconditionalPermit) + ' Permit(s) have been issued directly to the SSO. ' + 
                   HC_NEWLINE;
         ENDIF; 
         MsgText = MsgText +
                   VARCHAR(DeskMessage[j].ConditionalPermit) + ' SLC Permit(s) are conditional requiring DO Action. ' + 
                   HC_NEWLINE;
         MsgText = MsgText + HC_NEWLINE +
                   'Please review the In-Service Work Permit Summary and take action where necessary';                   

         MsgKey = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = DeskMessage[j].Substation,
                                  SubstationName = 'In-Service WP',
                                  Msg = MsgText,
                                  FromOpName = 'TO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SLC',
                                  FromApp = 'TOMS Online',
                                  Priority = 0
                                  );
         IF MsgKey <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.IssuePermits ; ' + 
                 'Unable to send incoming message to DO for ISWP on desk ' + 
                 VARCHAR(DeskMessage[j].DeskName));
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
     ENDIF;

     IF DeskMessage[j].TLSConditionalPermit > 0 THEN
         MsgText = 'IN-SERVICE WORK PERMITS for TLS desk ' + DeskMessage[j].DeskName +
                   ' have been submitted by the Transmission Operator. ' + 
                   HC_NEWLINE + HC_NEWLINE;
         IF DeskMessage[j].TLSUnconditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].TLSUnconditionalPermit) + ' TLS Permit(s) have been issued directly to the SSO. ' + 
                   HC_NEWLINE;
         ENDIF; 
         MsgText = MsgText +
                   VARCHAR(DeskMessage[j].TLSConditionalPermit) + ' TLS Permit(s) are conditional requiring DO Action. ' + 
                   HC_NEWLINE;

         IF DeskMessage[j].NewTLSCardList.LastRow > 0 THEN
            CardNames = '';
            FOR I = 1 TO DeskMessage[j].NewTLSCardList.LastRow DO
               IF CardNames <> '' THEN
                  CardNames = CardNames + ', ';
               ENDIF;
               CardNames = CardNames + DeskMessage[j].NewTLSCardList[i].Value;
            ENDFOR;
            MsgText = MsgText + 'New TLS card(s) need to be created for circuit(s) ' +  CardNames + HC_NEWLINE;
         ENDIF; 

         MsgText = MsgText + HC_NEWLINE +
                   'Please review the In-Service Work Permit Summary and take action where necessary';                   

         MsgKey = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = DeskMessage[j].Substation,
                                  SubstationName = 'In-Service WP',
                                  Msg = MsgText,
                                  FromOpName = 'TO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'TLS',
                                  FromApp = 'TOMS Online',
                                  Priority = 0
                                  );
         IF MsgKey <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.IssuePermits ; ' + 
                 'Unable to send incoming message to DO for ISWP on desk ' + 
                 VARCHAR(DeskMessage[j].DeskName));
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
     ENDIF;
   ENDFOR;
/*
** If in-service permits have been downloaded directly, send a message to SSM.
** Obsolete 04/07/09: The logics to notify SSM is now handled by Monitors.
**
   IF NotifySSO = TRUE THEN
      MsgText = '<a target="fms" href="<%type=isp&status=' + VARCHAR(ISPStatus$Issued) + '%>">In-Service Permits</a> ' +
                   'downloaded to substations by Transmission Operator';

      RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                       ,MessageText = MsgText 
                       ,MessageType = 0
                       ,Card = Card
                       ,Priority = 0
                       ,Time = date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermit_ASE.IssuePermits ;' +
                   'Failed to send notification to SSM');
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
*/
   RETURN;
END;

METHOD WithdrawPermits(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   DeskMessage = ARRAY OF ISPDeskMessage;
   DeskName = VARCHAR(10) NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   OperatorName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   VerbalIssue = DATE WITH NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Pre-set Array with error codes.
*/
   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].ReturnCode = -1;
      CurObject.PL[i].ErrorMessage = 'DEFAULT ERROR - DID NOT PROCESS THIS PERMIT';
   ENDFOR;

/*
** Create list of desks which will control distribution of incoming messages to the DO.
** Use ConditionalPermit for the number of permits to be REQUEST RESCINDED and 
** UnconditionalPermit for the number of permits to be FORCE RESCINDED
*/
   i = 1;
   DeskMessage.Clear();
   SELECT  :DeskMessage[i].DeskName = Name,
           :DeskMessage[i].Substation = 0,
           :DeskMessage[i].ConditionalPermit = 0,
           :DeskMessage[i].UnconditionalPermit = 0,
           :DeskMessage[i].TLSConditionalPermit = 0,
           :DeskMessage[i].TLSUnconditionalPermit = 0
   FROM    Udb_Object 
   WHERE   Type = :Type$OperatorDesk AND
           PrimaryGrouping <> 0
   BEGIN
      i = i + 1;
   END;
/*
** Create a withdrawal event
*/
   CurObject.WithdrawInfo.RequestTime = DATE('NOW');
   CurObject.WithdrawInfo.Reason = CurObject.WithdrawInfo.ReasonTypeName + '. ' + CurObject.WithdrawInfo.Reason;

   RetCode = CALLPROC SOA_ISPWithdrawEventIns (
                 WithdrawEvent = CurObject.WithdrawInfo.ReasonType,
                 WithdrawReason = CurObject.WithdrawInfo.Reason,
                 WithdrawBy = CurObject.WithdrawInfo.RequestBy,
                 WithdrawTime = CurObject.WithdrawInfo.RequestTime,
                 WithDrawGroupType = 'ALL',
                 WithdrawGroup = 0);
   IF RetCode <> 0  THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to save withdrawal request.';
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermit_ASE.WithdrawPermits; ' +
                   'Failed to save withdrawal request event.');
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT; 
   ENDIF;

/*
** Set each permit's status to PULL REQUEST. Then
** if the permit is not downloaded or acknowledged, tell SOO Monitor to rescind the order.
** if there are permits that have been acknowledged, send incoming message to D.O. to
** FORCE Rescind orders.
*/
   OperatorName = '';
   SELECT  :OperatorName = Description
   FROM    Udb_Object 
   WHERE   Object = :CurObject.WithdrawInfo.RequestBy;

   FOR i = 1 TO CurObject.PL.LastRow() DO
      /*
      ** Save it in the SOA_ISPWithdrawPermit table.
      */
      RetCode = CALLPROC SOA_ISPWithdrawPermitIns (
                    WithdrawEvent = CurObject.WithdrawInfo.ReasonType,
                    WithdrawTime = CurObject.WithdrawInfo.RequestTime,
                    ISPermit = CurObject.PL[i].ISPermit);
      IF RetCode <> 0  THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.PL[i].ReturnCode = -1;
         CurObject.PL[i].ErrorMessage = 'Failed to process withdrawal request.';
         CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermit_ASE.WithdrawPermits; ' +
                   'Failed to save permit ' + 
                   VARCHAR(CurObject.PL[i].ISPermit) + ' in SOA_ISPWithdrawPermit table');
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT; 
      ENDIF;

      /*
      ** get ISP information
      */
      REPEATED
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description, 
             :CurObject.PL[i].Application = P.Application, 
             :CurObject.PL[i].Job = P.Job        
      FROM   SOA_InServicePermit P,
             Udb_Object O
      WHERE  P.ISPermit = :CurObject.PL[i].ISPermit AND
             P.Substation = O.Object;

      IF CurObject.PL[i].Application = Application$SLC THEN
         /*
         ** Get operating order information
         */
         CurObject.PL[i].OrderInfo.OrderStatus = 0;

         SELECT :CurObject.PL[i].OrderInfo.OrderNumber = OO.OrderNumber,
                :CurObject.PL[i].OrderInfo.OrderStatus = OO.OrderStatus
         FROM   IR_OperatingOrder OO
         WHERE  OO.OrderNumber = (SELECT MAX(J.OrderNumber) 
                                  FROM IR_OpOrderJobs J
                                  WHERE J.Job = :CurObject.PL[i].Job);
 
         IF CurObject.PL[i].OrderInfo.OrderStatus = Order$Rejected OR
            CurObject.PL[i].OrderInfo.OrderStatus >= Order$Closed THEN
            /*
            ** The ISP status on the T.O. screen was not in synch with the database. 
            ** We won't process withdrawal for it. Just return the last status.
            */
            SELECT :CurObject.PL[i].CurrentStatus = CurrentStatus,
                   :CurObject.PL[i].StatusTime = StatusTime
            FROM   SOA_InServicePermit
            WHERE  ISPermit = :CurObject.PL[i].ISPermit;

            /* process the next one */
            CurObject.PL[i].ReturnCode = 0;
            CurObject.PL[i].ErrorMessage = '';

            CONTINUE;
         ENDIF;

         /*
         ** Get deskname using division
         */
         DeskName = '';
         REPEATED 
         SELECT  :DeskName = O.Name
         FROM    Udb_Object O,
                 Udb_Grouping G
         WHERE   G.Member = :CurObject.PL[i].Division AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.GroupingType = :Type$OperatorDesk AND
                 G.Grouping = O.Object;
         /*
         ** If work permit order has not been issued (conditional permit), set
         ** the status to PULLED. If it has been issued, Set PULL REQUEST status
         ** If work permit issued verbally...i.e. no order but Job issued, then
         ** then proceed as if an acknowledged order
         */
         IF CurObject.PL[i].OrderInfo.OrderStatus = 0 THEN

            VerbalIssue = NULL;
            SELECT :VerbalIssue = TOIssued
            FROM   SOA_Job 
            WHERE  Job = :CurObject.PL[i].Job;

            IF VerbalIssue IS NULL THEN
               CurObject.PL[i].WithdrawIssuedISP(NewISPStatus = ISPStatus$WithDrawn,
                                      WithdrawnBy = CurObject.WithdrawInfo.RequestBy,
                                      WithdrawReason = CurObject.WithdrawInfo.Reason,
                                      JobResponse = 'PULLED');
               /* no message to D.O. */
               CONTINUE;
            ENDIF;
         ENDIF;
        
         CurObject.PL[i].PrevStatus = 0;
         CurObject.PL[i].Status = ISPStatus$WithdrawRequest;
         CurObject.PL[i].LastUpdateBy = CurObject.WithdrawInfo.RequestBy;
         CurObject.PL[i].SODenyReason = CurObject.WithdrawInfo.Reason;
         CurObject.PL[i].UpdateStatus();
         IF CurObject.PL[i].ReturnCode < 0 THEN
            RETURN;
         ENDIF;
         /*
         ** If we reach here with order status = 0 it means permit was issued
         ** verbally and we want to drop to the DO to handle. Otherwise,
         ** Try to rescind the operating order. Once it is rescinded, the SOO
         ** monitor will set the ISP status to PULLED. 
         */       
         IF CurObject.PL[i].OrderInfo.OrderStatus < Order$Acknowledged  AND
            CurObject.PL[i].OrderInfo.OrderStatus <> 0 THEN

            /*  Request Rescind
            */
            RetCode = CALLPROC IR_OpOrderRescindUpd (
                      OrderNumber = CurObject.PL[i].OrderInfo.OrderNumber,
                      OrderStatus = CurObject.PL[i].OrderInfo.OrderStatus,
                      RescindType = 'REQUEST',
                      RescindComment = CurObject.WithdrawInfo.Reason,
                      RescindTime = CurObject.WithdrawInfo.RequestTime,
                      RescindReasonType = CurObject.WithdrawInfo.ReasonType,
                      RescindReasonTypeName = CurObject.WithdrawInfo.ReasonTypeName,
                      RescindDO = OperatorName);

            IF RetCode <> 0  THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.PL[i].ReturnCode = -1;
                CurObject.PL[i].ErrorMessage = 'Failed to process withdrawal request.';
                CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermit_ASE.WithdrawPermits; ' +
                     'Unable to Request Rescind ISPermit ' + 
                     VARCHAR(CurObject.PL[i].ISPermit));
                RETURN;
            ELSE
                CALLPROC DDB_COMMIT; 
           
                ControlText = VARCHAR(CurObject.PL[i].OrderInfo.OrderNumber);
                CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_RescindOrder',
                     EventText = ControlText);
            ENDIF;

            /*  Permits being Request Rescinded
            */
            FOR j = 1 TO DeskMessage.LastRow() DO
               IF DeskName = DeskMessage[j].DeskName THEN
                  IF DeskMessage[j].Substation = 0 THEN 
                     DeskMessage[j].Substation = CurObject.PL[i].Substation;  /* Set once for each desk*/
                  ENDIF;
                  DeskMessage[j].ConditionalPermit = DeskMessage[j].ConditionalPermit + 1;
               ENDIF;
            ENDFOR;
         ELSE
             // acknowledged permit

            /* Request permits to be Force Rescinded
            */
            FOR j = 1 TO DeskMessage.LastRow() DO
               IF DeskName = DeskMessage[j].DeskName THEN
                  IF DeskMessage[j].Substation = 0 THEN 
                     DeskMessage[j].Substation = CurObject.PL[i].Substation;  /* Set once for each desk*/
                  ENDIF;
                  DeskMessage[j].UnconditionalPermit = DeskMessage[j].UnconditionalPermit + 1;
               ENDIF;
            ENDFOR;
         ENDIF;
      ELSE
         // telephone order
         /*
         ** Get operating order information
         */
         CurObject.PL[i].OrderInfo.OrderStatus = 0;

         SELECT :CurObject.PL[i].OrderInfo.OrderNumber = OO.OrderNumber,
                :CurObject.PL[i].OrderInfo.OrderStatus = OO.OrderStatus
         FROM   IR_TelephoneOrder OO
         WHERE  OO.OrderNumber = (SELECT MAX(J.OrderNumber) 
                                  FROM IR_TLSOrderJob J
                                  WHERE J.Job = :CurObject.PL[i].Job);
 
         IF CurObject.PL[i].OrderInfo.OrderStatus = Order$Rejected OR
            CurObject.PL[i].OrderInfo.OrderStatus >= Order$Closed THEN
            /*
            ** The ISP status on the T.O. screen was not in synch with the database. 
            ** We won't process withdrawal for it. Just return the last status.
            */
            SELECT :CurObject.PL[i].CurrentStatus = CurrentStatus,
                   :CurObject.PL[i].StatusTime = StatusTime
            FROM   SOA_InServicePermit
            WHERE  ISPermit = :CurObject.PL[i].ISPermit;

            /* process the next one */
            CurObject.PL[i].ReturnCode = 0;
            CurObject.PL[i].ErrorMessage = '';

            CONTINUE;
         ENDIF;

         /*
         ** Get deskname using division
         */
         DeskName = '';
         REPEATED 
         SELECT  :DeskName = O.Name
         FROM    Udb_Object O,
                 Udb_Grouping G
         WHERE   G.Member = :CurObject.PL[i].Division AND
                 G.Relationship = :Interaction$MemberOf AND
                 G.GroupingType = :Type$OperatorDesk AND
                 G.Grouping = O.Object;
         /*
         ** If work permit order has not been issued (conditional permit), set
         ** the status to PULLED. If it has been issued, Set PULL REQUEST status
         ** If work permit issued verbally...i.e. no order but Job issued, then
         ** then proceed as if an acknowledged order
         */
         IF CurObject.PL[i].OrderInfo.OrderStatus = 0 THEN
            VerbalIssue = NULL;
            SELECT :VerbalIssue = TOIssued
            FROM   TC_Job 
            WHERE  Job = :CurObject.PL[i].Job;

            IF VerbalIssue IS NULL THEN
               CurObject.PL[i].WithdrawIssuedISP(NewISPStatus = ISPStatus$WithDrawn,
                                      WithdrawnBy = CurObject.WithdrawInfo.RequestBy,
                                      WithdrawReason = CurObject.WithdrawInfo.Reason,
                                      JobResponse = 'PULLED');
               /* no message to D.O. */
               CONTINUE;
            ENDIF;
         ENDIF;
        
         CurObject.PL[i].PrevStatus = 0;
         CurObject.PL[i].Status = ISPStatus$WithdrawRequest;
         CurObject.PL[i].LastUpdateBy = CurObject.WithdrawInfo.RequestBy;
         CurObject.PL[i].SODenyReason = CurObject.WithdrawInfo.Reason;
         CurObject.PL[i].UpdateStatus();
         IF CurObject.PL[i].ReturnCode < 0 THEN
            RETURN;
         ENDIF;
         /*
         ** If we reach here with order status = 0 it means permit was issued
         ** verbally and we want to drop to the DO to handle. Otherwise,
         ** Try to rescind the operating order. Once it is rescinded, the SOO
         ** monitor will set the ISP status to PULLED. 
         */       
         IF CurObject.PL[i].OrderInfo.OrderStatus < Order$Acknowledged  AND
            CurObject.PL[i].OrderInfo.OrderStatus <> 0 THEN

            /*  Request Rescind
            */
            RetCode = CALLPROC IR_TLSOrderRescindUpd (
                      OrderNumber = CurObject.PL[i].OrderInfo.OrderNumber,
                      OrderStatus = CurObject.PL[i].OrderInfo.OrderStatus,
                      RescindType = 'REQUEST',
                      RescindComment = CurObject.WithdrawInfo.Reason,
                      RescindTime = CurObject.WithdrawInfo.RequestTime,
                      RescindReasonType = CurObject.WithdrawInfo.ReasonType,
                      RescindReasonTypeName = CurObject.WithdrawInfo.ReasonTypeName,
                      RescindDO = OperatorName);

            IF RetCode <> 0  THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.PL[i].ReturnCode = -1;
                CurObject.PL[i].ErrorMessage = 'Failed to process withdrawal request.';
                CurMethod.Trace(Text = VARCHAR(DATE('now')) + ': InServicePermit_ASE.WithdrawPermits; ' +
                     'Unable to Request Rescind ISPermit ' + 
                     VARCHAR(CurObject.PL[i].ISPermit));
                RETURN;
            ELSE
                CALLPROC DDB_COMMIT; 
           
                ControlText = VARCHAR(CurObject.PL[i].OrderInfo.OrderNumber);
                CALLPROC InsertDBEventQueue(
                     ToApp = 'TLS',
                     EventName = 'IR_TLSRescindOrder',
                     EventText = ControlText);
            ENDIF;

            /*  Permits being Request Rescinded
            */
            FOR j = 1 TO DeskMessage.LastRow() DO
               IF DeskName = DeskMessage[j].DeskName THEN
                  IF DeskMessage[j].Substation = 0 THEN 
                     DeskMessage[j].Substation = CurObject.PL[i].Substation;  /* Set once for each desk*/
                  ENDIF;
                  DeskMessage[j].TLSConditionalPermit = DeskMessage[j].TLSConditionalPermit + 1;
               ENDIF;
            ENDFOR;
         ELSE
             // acknowledged permit

            /* Request permits to be Force Rescinded
            */
            FOR j = 1 TO DeskMessage.LastRow() DO
               IF DeskName = DeskMessage[j].DeskName THEN
                  IF DeskMessage[j].Substation = 0 THEN 
                     DeskMessage[j].Substation = CurObject.PL[i].Substation;  /* Set once for each desk*/
                  ENDIF;
                  DeskMessage[j].TLSUnconditionalPermit = DeskMessage[j].TLSUnconditionalPermit + 1;
               ENDIF;
            ENDFOR;
         ENDIF;
      ENDIF;
/*
** Clear error code for this iteration.
*/
      CurObject.PL[i].ReturnCode = 0;
      CurObject.PL[i].ErrorMessage = '';
   ENDFOR;

/*
** Will have to send Incoming Message to DO by desk
*/ 
   FOR j = 1 TO DeskMessage.LastRow() DO
      IF DeskMessage[j].Substation <> 0 THEN

       IF DeskMessage[j].ConditionalPermit > 0 OR DeskMessage[j].UnconditionalPermit > 0 THEN
         MsgText = 'IN-SERVICE WORK PERMITS Withdrawn by the Transmission Operator with reason: ' + 
                   HC_NEWLINE + 
                   CurObject.WithdrawInfo.Reason + HC_NEWLINE + HC_NEWLINE;
         IF DeskMessage[j].ConditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].ConditionalPermit) + ' Permit(s) have been Request Rescinded by Rapid Restore Interface.' + 
                   HC_NEWLINE;
         ENDIF;
         IF DeskMessage[j].UnconditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].UnconditionalPermit) + ' Permit(s) must be manually Incompleted by D.O.' + 
                   HC_NEWLINE;
         ENDIF; 
         MsgText = MsgText + HC_NEWLINE +
                   'Please review the In-Service Work Permit Summary and take action where necessary';                   

         RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = DeskMessage[j].Substation,
                                  SubstationName = 'In-Service WP',
                                  Msg = MsgText,
                                  FromOpName = 'TO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SLC',
                                  FromApp = 'TOMS Online',
                                  Priority = 0
                                  );
         IF RetCode <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.WithdrawPermits; ' + 
                    'Unable to send incoming message to DO for ISWP on desk ' + 
                    VARCHAR(DeskMessage[j].DeskName));
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
       ENDIF;

       IF DeskMessage[j].TLSConditionalPermit > 0 OR DeskMessage[j].TLSUnconditionalPermit > 0 THEN
         MsgText = 'IN-SERVICE WORK PERMITS for TLS ' + DeskMessage[j].DeskName + 
                   ' Withdrawn by the Transmission Operator with reason: ' + 
                   HC_NEWLINE + 
                   CurObject.WithdrawInfo.Reason + HC_NEWLINE + HC_NEWLINE;
         IF DeskMessage[j].TLSConditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].TLSConditionalPermit) + ' TLS Permit(s) have been Request Rescinded by Rapid Restore Interface.' + 
                   HC_NEWLINE;
         ENDIF;
         IF DeskMessage[j].TLSUnconditionalPermit > 0 THEN
            MsgText = MsgText +
                   VARCHAR(DeskMessage[j].TLSUnconditionalPermit) + ' TLS Permit(s) must be manually Incompleted by D.O.' + 
                   HC_NEWLINE;
         ENDIF; 
         MsgText = MsgText + HC_NEWLINE +
                   'Please review the TLS In-Service Work Permit Summary and take action where necessary';                   

         RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = DeskMessage[j].Substation,
                                  SubstationName = 'In-Service WP',
                                  Msg = MsgText,
                                  FromOpName = 'TO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'TLS',
                                  FromApp = 'TOMS Online',
                                  Priority = 0
                                  );
         IF RetCode <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermit_ASE.WithdrawPermits; ' + 
                    'Unable to send incoming message to DO for TLS ISWP on desk ' + 
                    VARCHAR(DeskMessage[j].DeskName));
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
       ENDIF;
      ENDIF;
   ENDFOR;

   RETURN;
END;

METHOD LoadRequestList (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   Division = INTEGER NOT NULL WITH DEFAULT;
   StatusClause = VARCHAR(600) NOT NULL WITH DEFAULT;
   FilterClause1 = VARCHAR(400) NOT NULL WITH DEFAULT;
   FilterClause2 = VARCHAR(400) NOT NULL WITH DEFAULT;
   DynamicWhereClause1 = VARCHAR(1200) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   GroupObject = INTEGER NOT NULL WITH DEFAULT;
   GroupList = VARCHAR(80) NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = '';
   EndDate = '';

   StatusClause = '';
   CurObject.PL.Clear();

   IF CurObject.StartDateFilter <> '' THEN 
      StartDate = DATE(CurObject.StartDateFilter);   // 02/22/2007 
   ENDIF;
   IF CurObject.EndDateFilter <> '' THEN
      EndDate = DATE(CurObject.EndDateFilter) + '1 day';   // 02/23/2007  
   ENDIF;

   IF CurObject.GroupFilter <> '' THEN
      IF CurObject.GroupFilter LIKE 'SSM_%' THEN
         GroupObject = 0;
         SELECT :GroupObject = Object
         FROM   UDB_Object
         WHERE  Type = 22648 AND
                Name = :CurObject.GroupFilter;

         StatusClause = StatusClause  + ' P.WorkGroup = ''SSM'' AND P.Substation IN ( ' + 
                   ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
                   ' AND Grouping = ' + VARCHAR(GroupObject) + 
                   ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ') AND ';
      ELSEIF CurObject.GroupFilter LIKE 'ECB_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22615 AND               // ECB
                O.Name = :CurObject.GroupFilter AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;
         StatusClause = StatusClause  + ' P.WorkGroup = ''ECB'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.GroupFilter LIKE 'PST_%' THEN
         GroupObject = 0;
         GroupList = '';
         SELECT :GroupObject = O.Object, 
                :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22619 AND               // pst
                O.Name = :CurObject.GroupFilter AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;
         StatusClause = StatusClause  + ' P.WorkGroup = ''PST'' AND (P.Division IN (' + GroupList + ') OR ' + 
                      ' P.Substation IN ( ' + 
                      ' SELECT Member FROM UDB_Grouping WHERE MemberType = ' + VARCHAR(Type$Substation) + 
                      ' AND Grouping = ' + VARCHAR(GroupObject) + 
                      ' AND Relationship = ' + VARCHAR(Interaction$MemberOf) + ')) AND ';

      ELSEIF CurObject.GroupFilter LIKE 'TMG_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22642 AND               // TMG
                O.Name = :CurObject.GroupFilter AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;
         StatusClause = StatusClause  + ' P.WorkGroup = ''TMG'' AND P.Division IN (' + GroupList + ') AND ';

      ELSEIF CurObject.GroupFilter LIKE 'Cap_Const_%' THEN
         GroupList = '';
         SELECT :Division = G.Member
         FROM   UDB_Object O,
                UDB_Grouping G
         WHERE  O.Type = 22901 AND               // Cap_Const.
                O.Name = :CurObject.GroupFilter AND
                O.Object = G.Grouping AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Division
         BEGIN
            IF GroupList <> '' THEN
               GroupList = GroupList + ',';
            ENDIF;
            GroupList = GroupList + VARCHAR(Division);
         END;
         StatusClause = StatusClause  + ' P.WorkGroup = ''Cap_Const.'' AND P.Division IN (' + GroupList + ') AND ';

      ELSE
         StatusClause = StatusClause  + ' P.WorkGroup = ''' + VARCHAR(CurObject.GroupFilter) + ''' AND ';
      ENDIF;
   ENDIF;

   /* obsolete 10/16/13
   IF CurObject.GroupFilter > 0 THEN
      IF CurObject.GroupFilter = JobClass$PSTPermit_SLC THEN 	
         StatusClause = ' P.JobClass IN (' + VARCHAR(JobClass$PSTPermit_SLC) + ',' + VARCHAR(JobClass$PSTPermit_TLS) + ') AND ';
      ELSEIF CurObject.GroupFilter = JobClass$IRPermit_SLC THEN 	
         StatusClause = ' P.JobClass IN (' + VARCHAR(JobClass$IRPermit_SLC) + ',' + VARCHAR(JobClass$IRPermit_TLS) + ') AND ';
      ELSE
         StatusClause = ' P.JobClass = ' + VARCHAR(CurObject.GroupFilter) + ' AND ';
      ENDIF;
   */

   IF CurObject.StatusFilter = ISPStatus$AllCurrent THEN	// all current
      StatusClause = StatusClause + ' P.Status <> ' + VARCHAR(ISPStatus$Archived) + ' AND ';

   ELSEIF CurObject.StatusFilter = ISPStatus$AllArchived THEN	// archived
       StatusClause = StatusClause + ' P.Status = ' + VARCHAR(ISPStatus$Archived) + ' AND ';

   ELSEIF CurObject.StatusFilter = ISPStatus$RequestAccepted THEN		// acknowledged by T.O. or D.O.
       StatusClause = StatusClause  + ' P.Status >= ' + VARCHAR(ISPStatus$Open) + ' AND ' +
              ' P.Status < ' + VARCHAR(ISPStatus$Archived) + ' AND ';              
              
   ELSEIF CurObject.StatusFilter = ISPStatus$Request THEN
       StatusClause = StatusClause  + ' P.Status IN (' + VARCHAR(ISPStatus$Request) + ',' + VARCHAR(ISPStatus$RequestToRCC) + ') AND ';

   ELSEIF CurObject.StatusFilter <> 0 THEN
       StatusClause = StatusClause  + ' P.Status = ' + VARCHAR(CurObject.StatusFilter ) + ' AND ';
   ENDIF;

   IF NOT CurObject.PIFilter IS NULL THEN
      IF CurObject.PIFilter = 2 THEN      // Emergent
         StatusClause = StatusClause  + ' R.Emergent = 1 AND '; 
      ELSEIF CurObject.PIFilter = 1 THEN
         StatusClause = StatusClause  + ' R.StartDate <> '''' AND '; 
      ELSE
         StatusClause = StatusClause  + ' R.StartDate = '''' AND '; 
      ENDIF;

      IF CurObject.SubstationFilter <> 0 THEN
         FilterClause1 = ' P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
      ENDIF;
      FilterClause1 = FilterClause1 + ' P.Substation = O.Object AND ' +
                      'P.ISPermit = R.ISPermit ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.ReportTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.ReportTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  
      
      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift,
             :CurObject.PL[i].ReqInfo.Emergent = R.Emergent, 
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,			        
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             UDB_Object O,
             SOA_ISPermitRequest R  
      WHERE  :DynamicWhereClause1 
      ORDER BY 23 				// R.EnterTime
      BEGIN
         i = i + 1;
      END;   
   ELSEIF CurObject.DivisionFilter = 10001 THEN    // CCTN & Other
      FilterClause1 = ' P.ObjectType IN (0,1) AND ' + 
                      ' P.ISPermit = R.ISPermit ';

      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  

      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = '',
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift,
             :CurObject.PL[i].ReqInfo.Emergent = R.Emergent,             
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             SOA_ISPermitRequest R         
      WHERE  :DynamicWhereClause1
      ORDER BY 23 					// R.EnterTime 
      BEGIN
         i = i + 1;
      END;
      
   ELSEIF CurObject.DivisionFilter <> 0 AND CurObject.SubstationFilter = 0 THEN
      FilterClause1 = ' G.Grouping = ' +  VARCHAR(CurObject.DivisionFilter) + ' AND ' + 
             'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' + 
             'G.Member = P.Substation AND ' +    
             'P.Substation = O.Object AND ' + 
             'P.ISPermit = R.ISPermit ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  

      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift,
             :CurObject.PL[i].ReqInfo.Emergent = R.Emergent,
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             UDB_Grouping G,
             UDB_Object O,
             SOA_ISPermitRequest R  
      WHERE  :DynamicWhereClause1
      ORDER BY 23 					// R.EnterTime 
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF CurObject.SubstationFilter <> 0 THEN
         FilterClause1 = ' P.Substation = ' + VARCHAR(CurObject.SubstationFilter) + ' AND ';
      ENDIF;
      FilterClause1 = FilterClause1 + ' P.Substation = O.Object AND ' +
                      'P.ISPermit = R.ISPermit ';
 
      IF StartDate <> '' AND EndDate <> '' THEN
         FilterClause2 = ' AND P.CloseTime >= DATE(''' + VARCHAR(StartDate) + ''') AND ' + 
               'P.CloseTime < DATE(''' + VARCHAR(EndDate) + ''')';
      ENDIF;
      
      DynamicWhereClause1 = StatusClause + FilterClause1 + FilterClause2;
      //curMethod.Trace(Text = varchar(date('now')) + ': ' + DynamicWhereClause1 );  
      
      i = 1;
      SELECT :CurObject.PL[i].ISPermit = P.ISPermit,
             :CurObject.PL[i].Division = P.Division, 
             :CurObject.PL[i].Substation = P.Substation, 
             :CurObject.PL[i].SubstationName = O.Description,
             :CurObject.PL[i].SubstationRating = P.SubstationRating, 
             :CurObject.PL[i].Application = P.Application,
             :CurObject.PL[i].ObjectType = P.ObjectType,    
             :CurObject.PL[i].Object = P.Object,    
             :CurObject.PL[i].ObjectName = P.ObjectName,        
             :CurObject.PL[i].JobClass = P.JobClass,        
             :CurObject.PL[i].WorkGroup = P.WorkGroup,        
             :CurObject.PL[i].PermitMove = P.PermitMove,			    
             :CurObject.PL[i].PreIssued = P.PreIssued,		    
             :CurObject.PL[i].ShiftStartTime = P.ShiftStartTime,  
             :CurObject.PL[i].NotifyWhenCompleted = P.NotifyWhenCompleted,
             :CurObject.PL[i].NYISONotified = P.NYISONotified,  
             :CurObject.PL[i].Compliance = P.Compliance,
             :CurObject.PL[i].EnterTime = P.EnterTime,		    
             :CurObject.PL[i].CreatedBy = P.CreatedBy,		    
             :CurObject.PL[i].EnterBy = P.EnterBy,		      
             :CurObject.PL[i].CurrentStatus = P.CurrentStatus,			      
             :CurObject.PL[i].Status = P.Status,			      
             :CurObject.PL[i].StatusTime = P.StatusTime,			      
             :CurObject.PL[i].Jurisdiction = P.Jurisdiction,		    
             :CurObject.PL[i].CloseTime = P.CloseTime,
             :CurObject.PL[i].ReqInfo.ISPermit = R.ISPermit,
             :CurObject.PL[i].ReqInfo.EnterTime = R.EnterTime,
             :CurObject.PL[i].ReqInfo.EnterBy = R.EnterBy,
             :CurObject.PL[i].ReqInfo.EnterByName = R.EnterByName,
             :CurObject.PL[i].ReqInfo.Email = R.Email,
             :CurObject.PL[i].ReqInfo.CurrentStatus = R.CurrentStatus,
             :CurObject.PL[i].ReqInfo.PermitMove = R.PermitMove,
             :CurObject.PL[i].ReqInfo.StartDate = R.StartDate,
             :CurObject.PL[i].ReqInfo.WorkShift = R.WorkShift,
             :CurObject.PL[i].ReqInfo.Emergent = R.Emergent,
             :CurObject.PL[i].ReqInfo.Equipment = R.Equipment,         
             :CurObject.PL[i].ReqInfo.RelayCalibration = R.RelayCalibration,
             :CurObject.PL[i].ReqInfo.RelayCalDetail = R.RelayCalDetail,    
             :CurObject.PL[i].ReqInfo.AlarmCircuits = R.AlarmCircuits,    
             :CurObject.PL[i].ReqInfo.AlarmCktDetail = R.AlarmCktDetail,   
             :CurObject.PL[i].ReqInfo.LossOfControl = R.LossOfControl,     
             :CurObject.PL[i].ReqInfo.EquipAndDuration = R.EquipAndDuration,  
             :CurObject.PL[i].ReqInfo.RemoveCtrlFeed = R.RemoveCtrlFeed,    
             :CurObject.PL[i].ReqInfo.CtrlFeedEquip = R.CtrlFeedEquip,     
             :CurObject.PL[i].ReqInfo.OwnIsolation = R.OwnIsolation,      
             :CurObject.PL[i].ReqInfo.LiveConnections = R.LiveConnections,    
             :CurObject.PL[i].ReqInfo.AsbestosRelated = R.AsbestosRelated,         
             :CurObject.PL[i].ReqInfo.AsbAffectEquip = R.AsbAffectEquip,    
             :CurObject.PL[i].ReqInfo.AsbestosWork = R.AsbestosWork,      
             :CurObject.PL[i].ReqInfo.TripoutAccess = R.TripoutAccess,
             :CurObject.PL[i].ReqInfo.AsbestosOperator = R.AsbestosOperator,     
             :CurObject.PL[i].ReqInfo.TripoutPotential = R.TripoutPotential,  
             :CurObject.PL[i].ReqInfo.TripoutComment = R.TripoutComment,    
             :CurObject.PL[i].ReqInfo.Description = R.Description,       
             :CurObject.PL[i].ReqInfo.GndLevelWork = R.GndLevelWork,      
             :CurObject.PL[i].ReqInfo.GndLevelDetail = R.GndLevelDetail,			        
             :CurObject.PL[i].ReqInfo.ProcessByName = R.ProcessByName,      
             :CurObject.PL[i].ReqInfo.Remark = R.Remark
      FROM   SOA_InServicePermit P,
             UDB_Object O,
             SOA_ISPermitRequest R  
      WHERE  :DynamicWhereClause1 
      ORDER BY 23 				// R.EnterTime
      BEGIN
         i = i + 1;
      END;
   ENDIF;    
   CALLPROC DDB_ROLLBACK;

   IF CurObject.PL.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No In-Service work permit requests match the filter criteria.';
   ENDIF;

   FOR i = 1 TO CurObject.PL.LastRow DO
      IF CurObject.PL[i].Status = ISPStatus$RequestToRCC THEN
         CurObject.PL[i].Jurisdiction = 'RCC';

      ELSEIF CurObject.PL[i].Status > ISPStatus$Request AND CurObject.PL[i].Status < ISPStatus$Open THEN
         CurObject.PL[i].Jurisdiction = '';

      ELSEIF CurObject.PL[i].Status = ISPStatus$Denied THEN 
         CurObject.PL[i].Jurisdiction = '';

      ELSEIF CurObject.PL[i].Status = ISPStatus$Submitted THEN 
         CurObject.PL[i].Jurisdiction = 'DO';

      ELSEIF CurObject.PL[i].Status >= ISPStatus$Issued THEN 
         CurObject.PL[i].Jurisdiction = '';
      ENDIF;  
   ENDFOR;

   RETURN; 
END;


METHOD DeleteRequests (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.PL.LastRow() DO
      CurObject.PL[i].DeleteRequest();
   ENDFOR;

   RETURN;
END;

METHOD CopyRequests (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
 
