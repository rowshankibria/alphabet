**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          OutageReport
**
**  Date:       Version Description
** ----------------------------------
**  09/15/14  ysp Created. 
**  04/10/15  ysp Add UpdateAfterNewPermit method
**  09/08/17  ysp replaced obsolete table OSS_WorkPermit with SOA_SWPPermit
**  10/16/17  em  Renaming OutageReport for new OSS interface
**  10/30/17  em  Modifications for handling OutageTime and Delays; Add methods for
**                updating Actual Outage and setting Inservice
**  11/08/17  em  Added SELECT DISTINCT to avoid multiple row returned run-time error.
**                Only prompt for OutageDelay once, apply delay as needed to each OR in loop.
**  11/09/17  em  When setting Inservice time, update actual return to last returned permit in 
**                same substation.
**  12/04/17  em  When Outage Delay exists, if InhibitMessages is TRUE (like for XA21 Monitor)
**                then record OTHER delay temporarily until true solution can be provided.
**  12/07/17  em  Replace temporary outage delay fix with insertion into new table following by incoming
**                that will drive DO to record delay information.
**  12/28/17  ysp Add WorkGroups attribute
**  03/02/18  em  Add LogEntry when recording actual timestamps.
**                Set ActualOutage if it doesn't exist when issuing work permit.
**  03/02/18  ysp Add LoadLog method
**  03/05/18  em  Add second SetActualInsertDate method to be used when closing a switching item
**  04/24/18  em  Appears grace period was applied incorrectly.  Subtract grace period from actual when
**                comparing to scheduled.
**  04/26/18  em  Evaluate CurrentApplication value before inserting ORLog entry. When XA21 is setting an
**                outage time the value is blank, we validate here and get CurrentApplication value to cover all cases.  
**  05/24/18  em  Don't set Actual Inservice unless ActualReturnDate is set.
**  08/27/18  ysp Insert a log entry for the card even when the Actual Outage time was set by the card's cutout time, not set by a Job.
**  08/28/18  em  At Con Ed's request, remove/comment out logic that sets actual out when actual outservice is set.
**  09/12/18  ysp Allow CADO to override actual times to NULL.
*/
METHOD UpdateAfterNewPermit(
) =
DECLARE
   ActualReturnDate = DATE DEFAULT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.Status = Order$Opened THEN
      CurObject.Status = Order$Acknowledged;
      CurObject.UpdateStatus();
      IF CurObject.ReturnCode <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   
   SELECT :ActualReturnDate = ActualReturnDate 
   FROM   SOA_OutageRequest
   WHERE  ORNumber = :CurObject.ORNumber;
   CALLPROC DDB_ROLLBACK;

   IF ActualReturnDate IS NOT NULL THEN
      /*
      ** Once the OR's last permit is returned and if a new work permit is 
      ** created for the same OR number, the application 
      ** will re-open the actual outage end time and link the new work 
      ** permit to the existing outage.
      */
      CurObject.ResetActualReturnDate();
      CurObject.Status = Order$Acknowledged;
      CurObject.UpdateStatus();
      IF CurObject.ReturnCode <> 0 THEN
         RETURN;
      ENDIF;
   ENDIF;
   
   RETURN;
END;
   
METHOD LinkPermitToReport(
   Move = Job
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
   WorkItem  = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** This method is called when a new permit is added to a card by DO
*/
   /*
   ** Use work permits primary equipment as the key to mapping multiple work permits 
   ** to the same outage:
   ** if the equipment of this new work permit is associated with a scheduled outage (OR),
   ** the permit will be linked to this scheduled outage and inserted into the OR/WP Reference table.
   */
   CurObject.ORNumber = '';
   WorkItem = 0;
   SELECT :CurObject.ORNumber = R.ORNumber,
          :WorkItem = P.WorkItem
   FROM   SOA_Job J,
          SOA_JobControl JC,
          SOA_OutageRequestPermit P,
          SOA_OutageRequest R   
   WHERE  J.Equip = :Move.Equip AND
          J.Job <> :Move.Job AND
          J.Job = JC.Job AND
          JC.StepPair IN (:StepHeading$TestPermit, :StepHeading$WorkPermit) AND
          JC.Job = P.PermitJobID AND
          P.ORNumber = R.ORNumber AND
          R.ActualReturnDate IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.ORNumber <> '' THEN
      RetCode = CALLPROC SOA_ORPermitIns (
                         ORNumber = CurObject.ORNumber,
                         WorkItem = WorkItem,
                         PermitJobID = Move.Job);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.LinkPermitToReport;' + 
                  ' ERROR: Failed to save OR ' + CurObject.ORNumber + 
                  ' and PermitJobID ' + VARCHAR(Move.Job) + ' in OR/WP reference table');
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;          
   RETURN PU_OK;       
END;

METHOD DeletePermitFromReport(
   Move = Job
)=
DECLARE
   i        = INTEGER NOT NULL WITH DEFAULT;
   k        = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** This method is called when a permit is deleted from a card.
*/
   IF Move.StepPair <> StepHeading$TestPermit AND
      Move.StepPair <> StepHeading$WorkPermit THEN
      RETURN PU_OK;
   ENDIF;

   RetCode = CALLPROC SOA_ORPermitDel(PermitJobID = Move.Job);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.DeletePermitFromReport;' + 
               ' ERROR: Failed to delete PermitJobID ' + VARCHAR(Move.Job) + ' from OR/WP reference table');
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;          

   RETURN PU_OK;       
END;

METHOD SetActualOutageDate(
   JIP = JobInProgress                /* Job being processed in PromptSetCurrentlyOpen */
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   CompareVC = VARCHAR(24) NOT NULL WITH DEFAULT;
   CompareDate = DATE NOT NULL WITH DEFAULT;
   OutageDate = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
   DelayTypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   DelayCategory = INTEGER NOT NULL WITH DEFAULT;
   WorkingGroup = INTEGER NOT NULL WITH DEFAULT;
   DelayReason = VARCHAR(1000) NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(400) NOT NULL WITH DEFAULT;
BEGIN
   IF JIP.Equip = 0 THEN
      RETURN;
   ENDIF;
/*
** Check Equipment Type, make sure it is a valid type of breaker
*/
   i = 0;
   SELECT :i = ET.Type
   FROM   Udb_ExtendedType ET
   WHERE  ET.Type = :JIP.EquipClass AND
          ET.SuperType IN (:Type$BREAKER,
                           :Type$Source,
                           :Type$SOURCE_SBFKS,
                           :Type$SOURCE_Bifur,
                           :Type$SOURCE_VISY,
                           :Type$SSRO);
   IF i = 0 THEN
      RETURN;
   ENDIF;
/*
** Exclude Spare Bank
*/
   k = 0;
   SELECT :k = COUNT(*) 
   FROM   Udb_ExtendedType 
   WHERE  Type = :i AND
          SuperType IN  (:Type$BkrSpare, 
                         :Type$BkrROSpare);
   IF k > 0 THEN
      RETURN;
   ENDIF; 
/*
** Compute OutageDate applying Grace Minutes
*/
   IF JIP.Status = Job$TakeOut THEN
      OutageDate = IFNULL(JIP.TOComplete, DATE('NOW'));
   ELSEIF JIP.Status = Job$Restore THEN
      OutageDate = IFNULL(JIP.RSComplete, DATE('NOW'));
   ENDIF;
   CompareVC = VARCHAR(ORDelay$GraceMinutes) + ' minutes';
   CompareDate = OutageDate - CompareVC; 
/*
** check if this job is on a card where a scheduled outage is being managed. 
** If so, and if this is the first breaker to open (the Actual Outage Date = NULL), 
** the takeout restore time is set as the Actual Outage Date for the associated OR.
** Put in a loop in case there is more than one, handle delays.
*/
   CurObject.ORNumber = '';
   REPEATED
   SELECT DISTINCT
          :CurObject.ORNumber = R.ORNumber,
          :CurObject.SkedOutageDate = R.SkedOutageDate
   FROM   SOA_JobControl JC1,
          SOA_JobControl JC2,
          SOA_OutageRequestPermit P,
          SOA_OutageRequest R
   WHERE  JC1.Job = :JIP.Job AND
          JC1.Card = JC2.Card AND
          JC1.SwitchingItem = JC2.SwitchingItem AND
          JC2.Job = P.PermitJobID AND
          P.ORNumber = R.ORNumber AND
          R.ActualOutageDate IS NULL
   BEGIN
      IF CompareDate > CurObject.SkedOutageDate THEN
/*
** If delay has already been recorded then copy to this OR
*/     
         IF DelayTypeName <> '' THEN
            RetCode = CALLPROC SOA_ORDelayIns (
               ORNumber = CurObject.ORNumber,
               DelayType = DelayTypeName,
               DelayCategory = DelayCategory,
               WorkingGroup = WorkingGroup,
               DelayReason = DelayReason,
               Division = Division,
               DelayDate = DATE('now'));
           
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CALLPROC TraceError (UserMessage = 
                'ERROR: Unable to save Delay due to an program error.  Please report bug' , 
                           TraceMessage =
                'Error in Class OutageReport;  ' +
                'Error saving ' + DelayTypeName + ' delay for OR ' + VARCHAR(CurObject.ORNumber) +
                '.'
                );
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ELSE
/*
** If being processed from XA21 we can't do a call frame to Record an Outage Delay.
** Instead we insert a pending delay and an incoming message for DO to record the Delay.
*/          
            IF DDB_Global.InhibitMessages = TRUE THEN  /*XA21 Completion*/
 
               RetCode = CALLPROC SOA_PendingORDelayIns (
                  ORNumber = CurObject.ORNumber,
                  Card = JIP.Card,
                  Substation = JIP.Substation);
/* 
** RetCode = 1 means pending delay already exists and we don't need to insert incoming.
*/           
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CALLPROC TraceError (UserMessage = 
                    '' , 
                           TraceMessage =
                    'Error in Class OutageReport;  ' +
                    'Error saving XA21 pending OUTAGE delay for OR ' + VARCHAR(CurObject.ORNumber) +
                    '.'
                     );
               ELSEIF RetCode = 1 THEN
                  CALLPROC DDB_COMMIT;
               ELSE
                  CALLPROC DDB_COMMIT;
/*
** Look for existing message for this card and substation
*/                
                  i = 0;
                  SELECT :i = COUNT(*) 
                  FROM   Msg_Message 
                  WHERE  Card = :JIP.Card AND
                         Substation = :JIP.Substation AND
                         DelDate IS NULL AND
                         Msg LIKE 'SCHEDULED OUTAGE SWITCHING DELAY%';
                          
                  IF i = 0 THEN    
                     IF JIP.SubstationName = '' AND JIP.Substation > 0 THEN
                        SELECT :JIP.SubstationName = Description
                        FROM   Udb_Object 
                        WHERE  Object = :JIP.Substation;
                     ENDIF;               
                     MsgText = 'SCHEDULED OUTAGE SWITCHING DELAY ' + HC_NEWLINE + HC_NEWLINE +
                               'A scheduled outage switching delay has been identified. Click Process Delay to enter Delay detail.';        
                     RetCode = CALLPROC MSG_SendMsg (
                               Card = JIP.Card,
                               Action = 0,
                               OrderNumber = 0,
                               Substation = JIP.Substation,
                               SubstationName = JIP.SubstationName,
                               Msg = MsgText,
                               FromOpName = CurObject.ORNumber,
                               SendDate = IFNULL(DATE('now'),''),
                               ToApp = 'DO',
                               FromApp = 'XA',
                               Priority = 1
                               );
                     IF RetCode < 0 THEN
                         CALLPROC DDB_ROLLBACK;
                         CALLPROC TraceError (UserMessage = 
                            '' , 
                           TraceMessage =
                            'Error in Class OutageReport;  ' +
                            'Error saving incoming message for pending OUTAGE delay for OR ' + VARCHAR(CurObject.ORNumber) +
                             '.'
                              );
                     ELSE
                        CALLPROC DDB_COMMIT;
                     ENDIF;
                  ENDIF;   
               ENDIF;

            ELSE    
               CALLFRAME RecordORDelay (         
                          ORNumber = CurObject.ORNumber,
                          DelayType = ORDelay$Outage,
                          DelayTypeName = BYREF(DelayTypeName),
                          DelayCategory = BYREF(DelayCategory),
                          WorkingGroup = BYREF(WorkingGroup),
                          DelayReason = BYREF(DelayReason),
                          Division = BYREF(Division) 
                          );
            ENDIF;
         ENDIF;
      ENDIF;

      RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualOutageDate',
                      FieldValue = OutageDate);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualOutageDate;' + 
               ' ERROR: Failed to set Actual Outage Date ' + VARCHAR(OutageDate) + ' for OR ' + CurObject.ORNumber);
            RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;

      RetCode = CALLPROC SOA_ORLogIns (
                  ORNumber = CurObject.ORNumber,
                  Item = 'ActualOutageDate',
                  Application = CurrentApplication,
                  Card = JIP.Card,
                  SwitchingItem = JIP.SwitchingItem,
                  Job = JIP.Job,
                  LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualOutageDate;' + 
               ' ERROR: Failed to record log entry for Actual Outage Date ' + VARCHAR(OutageDate) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
					
   END;
END;


METHOD UpdateActualOutageDate(
   JIP = JobInProgress,                
   Card = INTEGER NOT NULL,
   CutOut = DATE 
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** check if this card has a permit where a scheduled outage is being managed. 
** Put in a loop in case there is more than one.
*/
   CurObject.ORNumber = '';
   REPEATED
   SELECT DISTINCT
          :CurObject.ORNumber = R.ORNumber
   FROM   SOA_JobControl JC,
          SOA_OutageRequestPermit P,
          SOA_OutageRequest R
   WHERE  JC.Card = :Card AND
          JC.Job = P.PermitJobID AND
          P.ORNumber = R.ORNumber
   BEGIN
      RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualOutageDate',
                      FieldValue = CutOut);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualOutageDate;' + 
               ' ERROR: Failed to set Actual Outage Date ' + VARCHAR(CutOut) + ' for OR ' + CurObject.ORNumber);
            RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;     
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :Card;
      ENDIF;
 
      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualOutageDate',
                     Application = CurrentApplication,
                     Card = Card,
                     SwitchingItem = 0,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.UpdateActualOutageDate;' + 
               ' ERROR: Failed to record log entry for update of Actual Outage Date ' + VARCHAR(CutOut) + ' for OR ' + CurObject.ORNumber);
            RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
   END;
END;

METHOD SetActualInServiceDate(
   JIP = JobInProgress                /* Job being processed in PromptClearCurrentlyOpen */
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   Card          = INTEGER NOT NULL WITH DEFAULT;
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT;
   Substation = INTEGER NOT NULL WITH DEFAULT;
   InServiceDate = DATE NOT NULL WITH DEFAULT;
   LastPermitReturn = DATE;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF JIP.Equip = 0 THEN
      RETURN;
   ENDIF;
/*
** Check Equipment Type, make sure it is a valid type of breaker
*/
   i = 0;
   SELECT :i = ET.Type
   FROM   Udb_ExtendedType ET
   WHERE  ET.Type = :JIP.EquipClass AND
          ET.SuperType IN (:Type$BREAKER,
                           :Type$Source,
                           :Type$SOURCE_SBFKS,
                           :Type$SOURCE_Bifur,
                           :Type$SOURCE_VISY,
                           :Type$SSRO);
   IF i = 0 THEN
      RETURN;
   ENDIF;
/*
** Exclude Spare Bank
*/
   k = 0;
   SELECT :k = COUNT(*) 
   FROM   Udb_ExtendedType 
   WHERE  Type = :i AND
          SuperType IN  (:Type$BkrSpare, 
                         :Type$BkrROSpare);
   IF k > 0 THEN
      RETURN;
   ENDIF; 

   IF JIP.Status = Job$TakeOut THEN
      InServiceDate = IFNULL(JIP.TOComplete, DATE('NOW'));
   ELSEIF JIP.Status = Job$Restore THEN
      InServiceDate = IFNULL(JIP.RSComplete, DATE('NOW'));
   ENDIF;
/*
** check if this job is on a card where a scheduled outage is being managed. 
** If so, and if this is the first breaker to close (the Actual Outage Date is not null), 
** the takeout restore time is set as the Actual InService Date for the associated OR.
** Put in a loop in case there is more than one, handle delays.
*/
   CurObject.ORNumber = '';
   REPEATED
   SELECT DISTINCT
          :CurObject.ORNumber = R.ORNumber,
          :Card = JC2.Card,
          :SwitchingItem = JC2.SwitchingItem,
          :Substation = J.Substation
   FROM   SOA_JobControl JC1,
          SOA_JobControl JC2,
          SOA_Job J,
          SOA_OutageRequestPermit P,
          SOA_OutageRequest R
   WHERE  JC1.Job = :JIP.Job AND
          JC1.Card = JC2.Card AND
          JC1.SwitchingItem = JC2.SwitchingItem AND
          JC2.Job = P.PermitJobID AND
          JC2.Job = J.Job AND
          P.ORNumber = R.ORNumber AND
          R.ActualOutageDate IS NOT NULL AND
          R.ActualReturnDate IS NOT NULL AND
          R.ActualInServiceDate IS NULL
   BEGIN

      RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualInserviceDate',
                      FieldValue = InServiceDate);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualInServiceDate;' + 
               ' ERROR: Failed to set Actual InService Date ' + VARCHAR(InServiceDate) + ' for OR ' + CurObject.ORNumber);
            RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;

      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualInserviceDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = JIP.SwitchingItem,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualInserviceDate;' + 
               ' ERROR: Failed to record log entry for Actual Inservice Date ' + VARCHAR(InserviceDate) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
/*      
** Get last permit completion to update actual return date
*/    
      LastPermitReturn = NULL;
      SELECT :LastPermitReturn = MAX(J.RSComplete)
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.StepPair IN (:StepHeading$WorkPermit,:StepHeading$TestPermit) AND
             JC.Job = J.Job AND
             J.TOIssued IS NOT NULL AND
             J.RSComplete IS NOT NULL AND
             J.Substation = :Substation;
       
      IF LastPermitReturn IS NOT NULL THEN
         RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualReturnDate',
                      FieldValue = LastPermitReturn);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to set Actual Return Date ' + VARCHAR(LastPermitReturn) + ' for OR ' + CurObject.ORNumber);
            RETURN;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;      
      ENDIF;
            
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;

      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualReturnDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = JIP.SwitchingItem,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to record log entry for Actual Return Date ' + VARCHAR(LastPermitReturn) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
   END;
/* 
** set the OR status to closed 
*/
    CurObject.Status = Order$Closed;
    CurObject.UpdateStatus();
END;


METHOD ResetActualReturnDate(
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   OutageDate = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ReturnCode = CALLPROC SOA_ORActualDateUpd (
                                 ORNumber = CurObject.ORNumber,
                                 FieldName = 'ACTUALRETURNDATE',
                                 FieldValue = NULL);
   IF CurObject.ReturnCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ErrorMessage = 'Failed to reset the OR actual return date due to database error'; 
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': OutageRequest; Error - failed to reset ' + 
                'actual return date for OR ' + CurObject.ORNumber);
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;    
/*
** Log entry will already exist, but should not be accessed from the report.  Will be updated with next
** return date
*/      
   RETURN;
END;

METHOD SetActualWorkIssueDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   ISWP       = INTEGER NOT NULL WITH DEFAULT;
   CardCutOut = DATE;
   CompareDate = DATE NOT NULL WITH DEFAULT;
   CompareVC = VARCHAR(24) NOT NULL WITH DEFAULT;
   IssueDate  = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** The Actual Work Issue Time is set to the date/time when the first work permit 
** is issued by the DO.  This work permit may be rejected and re-issued, but the initial 
** issuance will remain as the work issue time to avoid the District Operator from 
** being charged with Delay. 
** In the case where the first work permit for the outage is a pre-issued permit, 
** the pre-issue shift start time will be used as the actual Work Issue Time.
*/
   CurObject.FirstIssuedPermit = 0;
   CurObject.ORNumber = '';

   SELECT DISTINCT
          :CurObject.ORNumber = P.ORNumber,
          :CurObject.SkedStartDate = R.SkedStartDate,
          :CurObject.SkedOutageDate = R.SkedOutageDate,
          :CurObject.ActualOutageDate = R.ActualOutageDate
   FROM   SOA_OutageRequestPermit P,
          SOA_OutageRequest R
   WHERE  P.PermitJobID = :JIP.Job AND
          P.ORNumber = R.ORNumber AND
          R.ActualWorkIssueDate IS NULL;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.ORNumber = '' THEN
      RETURN;
   ENDIF;
/*
** Check if this is an ISWP, must set the status for it
*/
   ISWP = 0;
   SELECT :ISWP = ISPermit,
          :IssueDate = ShiftStartTime 
   FROM   SOA_InServicePermit
   WHERE  Application = :Application$SLC AND
          Job = :JIP.Job AND
          PreIssued = 1;
   CALLPROC DDB_ROLLBACK;

   IF ISWP = 0 THEN
      IssueDate = IFNULL(JIP.TOIssued, DATE('NOW')); 
   ENDIF;
/* 
** Compute Adjusted times as needed to check for a delay
*/
   CompareVC = VARCHAR(ORDelay$GraceMinutes) + ' minutes';
   CompareDate = IssueDate - CompareVC; 
   IF CompareDate > CurObject.SkedStartDate THEN
      IF CurObject.ActualOutageDate > CurObject.SkedOutageDate THEN
         IF CompareDate > (CurObject.ActualOutageDate + (CurObject.SkedStartDate - CurObject.SkedOutageDate)) THEN
   
            CALLFRAME RecordORDelay (
                          ORNumber = CurObject.ORNumber,
                          DelayType = ORDelay$WorkIssued);
         ENDIF;
      ELSE
            CALLFRAME RecordORDelay (
                          ORNumber = CurObject.ORNumber,
                          DelayType = ORDelay$WorkIssued);
      ENDIF;
   ENDIF;
 
   RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualWorkIssueDate',
                      FieldValue = IssueDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualWorkIssueDate;' + 
               ' ERROR: Failed to Actual Work Issue Date ' + VARCHAR(IssueDate) + ' for OR ' + CurObject.ORNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
      
   IF CurrentApplication = '' THEN
      SELECT :CurrentApplication = Application
      FROM   SOA_Card
      WHERE  Card = :JIP.Card;
   ENDIF;

   RetCode = CALLPROC SOA_ORLogIns (
                  ORNumber = CurObject.ORNumber,
                  Item = 'ActualWorkIssueDate',
                  Application = CurrentApplication,
                  Card = JIP.Card,
                  SwitchingItem = JIP.SwitchingItem,
                  Job = JIP.Job,
                  LogTime = DATE('now') );
            
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualWorkIssueDate;' + 
            ' ERROR: Failed to record log entry for Actual Work Issue Date ' + VARCHAR(IssueDate) + ' for OR ' + CurObject.ORNumber);
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** If ActualOutageDate is NULL, we are compelled to set it here, to the later of the Card Cutout or Scheduled Outage time. 
** Commented out 08/28/18
*    
   IF CurObject.ActualOutageDate IS NULL THEN
      CardCutOut = NULL;
      IF CurrentApplication = Application$TFMS THEN
         SELECT :CardCutOut = CutOut
         FROM   SOA_Card 
         WHERE  Card = :JIP.Card;
      ELSEIF CurrentApplication = Application$FMS THEN
         SELECT :CardCutOut = CutOut
         FROM   FMS_Card 
         WHERE  Card = :JIP.Card;
      ENDIF;
      IF CardCutOut IS NULL THEN
         CardCutOut = CurObject.SkedOutageDate;
      ELSEIF CurObject.SkedOutageDate > CardCutOut THEN
         CardCutOut = CurObject.SkedOutageDate;
      ENDIF;   
   
      RetCode = CALLPROC SOA_ORActualDateUpd(
                     ORNumber	= CurObject.ORNumber,
                     FieldName = 'ActualOutageDate',
                     FieldValue = CardCutOut);
      IF RetCode < 0 THEN
           CALLPROC DDB_ROLLBACK;
           CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualWorkIssueDate;' + 
              ' ERROR: Failed to set Actual Outage Date ' + VARCHAR(CardCutOut) + ' for OR ' + CurObject.ORNumber);
           RETURN;
      ELSE
          CALLPROC DDB_COMMIT;
      ENDIF;  
       
       /*
       ** Since Actual Outage was not set by a Job, will just insert a log entry for the card.
       *
      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualOutageDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = 0,
                     Job = 0,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualWorkIssueDate;' + 
               ' ERROR: Failed to record log entry for Actual Outage Date ' + VARCHAR(CardCutOut) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF; 
   ENDIF;
/*
** FirstIssuedPermit attribute is useful only when this permit is issued verbally. It is
** used to set Actual Start Date.
*/
   CurObject.FirstIssuedPermit = JIP.Job;
END;

METHOD SetActualStartDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   StartDate  = DATE NOT NULL WITH DEFAULT;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   IF CurObject.FirstIssuedPermit = JIP.Job THEN
      /* do nothing. Use the existing ORNumber value */
   ELSE
      CurObject.ORNumber = '';
      SELECT DISTINCT 
            :CurObject.ORNumber = P.ORNumber
      FROM   SOA_OutageRequestPermit P,
             SOA_OutageRequest R
      WHERE  P.PermitJobID = :JIP.Job AND
             P.ORNumber = R.ORNumber AND
             R.ActualStartDate IS NULL;
      CALLPROC DDB_ROLLBACK;       
   ENDIF;

   IF CurObject.ORNumber = '' THEN
      RETURN;
   ENDIF;

   StartDate = IFNULL(JIP.TOIssued, DATE('NOW')); 
   RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualStartDate',
                      FieldValue = StartDate);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualStartDate;' + 
               ' ERROR: Failed to Actual Start Date ' + VARCHAR(StartDate) + ' for OR ' + CurObject.ORNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;
   
      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualStartDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = JIP.SwitchingItem,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualStartDate;' + 
               ' ERROR: Failed to record log entry for Actual Start Date ' + VARCHAR(StartDate) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
END;

METHOD SetActualReturnDate(
   JIP = JobInProgress
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   IssueDate  = DATE DEFAULT NULL;
   StartDate  = DATE DEFAULT NULL;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/*
** As work permits are returned Complete, the OR/WP Reference table will be evaluated 
** to check if it is the last work permit. If so, the OR's Actual Return Date is set 
** to the date/time when the last work permit is returned Complete.
*/
   /*
   ** At first, check if this permit is in an outstanding OR.
   */
   CurObject.ORNumber = '';
   SELECT DISTINCT
          :CurObject.ORNumber = P.ORNumber,
          :IssueDate = R.ActualWorkIssueDate,
          :StartDate = R.ActualStartDate
   FROM   SOA_OutageRequestPermit P,
          SOA_OutageRequest R
   WHERE  P.PermitJobID = :JIP.Job AND
          P.ORNumber = R.ORNumber AND
          R.ActualReturnDate IS NULL;
   CALLPROC DDB_ROLLBACK;       
   
   IF CurObject.ORNumber = '' THEN
      RETURN;
   ENDIF;
   
   /*
   ** then, check if all permits have been returned.
   */
   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_OutageRequestPermit P,
          SOA_Job J
   WHERE  P.ORNumber = :CurObject.ORNumber AND
          P.PermitJobID = J.Job AND
          J.RSComplete IS NULL;
   CALLPROC DDB_ROLLBACK;       

   IF i > 0 THEN
      RETURN;      // there are still outstanding permits.
   ENDIF;

   RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualReturnDate',
                      FieldValue = JIP.RSComplete);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OROutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to Actual Return Date ' + VARCHAR(JIP.RSComplete) + ' for OR ' + CurObject.ORNumber);
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
         
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;

      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualReturnDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = JIP.SwitchingItem,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to record log entry for Actual Return Date ' + VARCHAR(JIP.RSComplete) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    

   /*
   ** Just in case the working group did not acknowledge any issued permit and simply 
   ** starts the work and return the permits (just like we do using the simulator),
   ** set the start date the same as the issue date.
   */
   IF StartDate IS NULL THEN
      RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualStartDate',
                      FieldValue = IssueDate);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OROutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to Actual Start Date ' + VARCHAR(IssueDate) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :JIP.Card;
      ENDIF;
      
      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualStartDate',
                     Application = CurrentApplication,
                     Card = JIP.Card,
                     SwitchingItem = JIP.SwitchingItem,
                     Job = JIP.Job,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualReturnDate;' + 
               ' ERROR: Failed to record log entry for Actual Start Date ' + VARCHAR(IssueDate) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
   ENDIF;
   
   RETURN;
END;

METHOD UpdateStatus(
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ReturnCode = CALLPROC SOA_ORStatusUpd(
               ORNumber = CurObject.ORNumber,
               Status = CurObject.Status,
               StatusTime = Date('Now'));

   IF CurObject.ReturnCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ErrorMessage = 'Failed to update OR status due to database errror';
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport;' + 
            ' ERROR: Failed to update OR status for ' + CurObject.ORNumber);
      CALLPROC DDB_ROLLBACK;
   ENDIF;
END;

METHOD OverrideActualDate(
   TimeField = VARCHAR(20) NOT NULL WITH DEFAULT,
   ActualTime = DATE,
   LogBy = VARCHAR(40) NOT NULL WITH DEFAULT,
   Remark = VARCHAR(1000) NOT NULL WITH DEFAULT
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   Item = VARCHAR(20) NOT NULL WITH DEFAULT;
   LogText = VARCHAR(256) NOT NULL WITH DEFAULT;
   OldTime = DATE DEFAULT NULL;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
      
   IF TimeField = 'ActualOutageDate' THEN
      SELECT :OldTime = ActualOutageDate
      FROM   SOA_OutageRequest
      WHERE  ORNumber = :CurObject.ORNumber;
      
      Item = 'UpdateOutageDate';
   
   ELSEIF TimeField = 'ActualWorkIssueDate' THEN
      SELECT :OldTime = ActualWorkIssueDate
      FROM   SOA_OutageRequest
      WHERE  ORNumber = :CurObject.ORNumber;
      
      Item = 'UpdateWorkIssueDate';

   ELSEIF TimeField = 'ActualStartDate' THEN
      SELECT :OldTime = ActualStartDate
      FROM   SOA_OutageRequest
      WHERE  ORNumber = :CurObject.ORNumber;
      
      Item = 'UpdateStartDate';

   ELSEIF TimeField = 'ActualReturnDate' THEN
      SELECT :OldTime = ActualReturnDate
      FROM   SOA_OutageRequest
      WHERE  ORNumber = :CurObject.ORNumber;
      
      Item = 'UpdateReturnDate';

   ELSEIF TimeField = 'ActualInserviceDate' THEN
      SELECT :OldTime = ActualInserviceDate
      FROM   SOA_OutageRequest
      WHERE  ORNumber = :CurObject.ORNumber;
      
      Item = 'UpdateInserviceDate';
   ENDIF;

   LogText = 'Changed ';
   IF OldTime IS NULL OR  OldTime = '' THEN
      LogText = LogText + ' from NULL';
   ELSE
      LogText = LogText + ' from ' + FormatDate(RawDate = OldTime, Format = 'DEFAULT');
   ENDIF;
   IF ActualTime IS NULL THEN
	  LogText = LogText + ' to NULL';
   ELSE
	  LogText = LogText + ' to ' + FormatDate(RawDate = ActualTime, Format = 'DEFAULT');
   ENDIF;
   
   // Update the time now
   RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = TimeField,
                      FieldValue = ActualTime);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to update due to database errors.';

      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OROutageReport.OverrideActualDate;' + 
            ' ERROR: Failed to override ' + TimeField + ' for OR ' + CurObject.ORNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;      

   // log the update
   RetCode = CALLPROC SOA_ORLogIns(
                      ORNumber	= CurObject.ORNumber,
                      Item = Item,
                      LogText = LogText,
                      LogBy = LogBy,
                      Remark = Remark,
                      LogTime = DATE('now'));

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OROutageReport.OverrideActualDate;' + 
            ' ERROR: Failed to log override of ' + TimeField + ' for OR ' + CurObject.ORNumber);
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
      
      // return the log entry back to FMS Online
      CurObject.Logs[1].ORNumber	= CurObject.ORNumber;
      CurObject.Logs[1].Item = Item;
      CurObject.Logs[1].LogText = LogText;
      CurObject.Logs[1].LogBy = LogBy;
      CurObject.Logs[1].Remark = Remark;
      CurObject.Logs[1].LogTime = DATE('now');
   ENDIF;      
END;


METHOD LoadLog(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   PrevCard      = INTEGER NOT NULL WITH DEFAULT;
   PrevSW        = INTEGER NOT NULL WITH DEFAULT;
   PrevArch      = INTEGER NOT NULL WITH DEFAULT;

   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   i = 1;
   CurObject.Logs.Clear();
   
   SELECT :CurObject.Logs[i].Application = Application,
          :CurObject.Logs[i].Card = Card,
          :CurObject.Logs[i].SwitchingItem = SwitchingItem,
          :CurObject.Logs[i].Job = Job,
          :CurObject.Logs[i].Item = Item,
          :CurObject.Logs[i].LogBy = LogBy,
          :CurObject.Logs[i].LogText = LogText,
          :CurObject.Logs[i].Remark = Remark,
          :CurObject.Logs[i].LogTime = LogTime
   FROM   SOA_ORLog
   WHERE  ORNumber = :CurObject.ORNumber
   ORDER BY Application, Card, SwitchingItem
   BEGIN
      i = i + 1;
   END;

   PrevArch = 0;
   PrevCard = 0;
   PrevSW = 0;
   
   FOR i = 1 TO CurObject.Logs.LastRow() DO
      IF CurObject.Logs[i].Application <> '' THEN
         IF CurObject.Logs[i].Card <> PrevCard OR
            CurObject.Logs[i].SwitchingItem <> PrevSW THEN
          
            CurObject.Logs[i].ArchiveCard = 1;

            REPEATED
            SELECT :CurObject.Logs[i].ArchiveCard = 0
            FROM   SOA_JobControl
            WHERE  Card = :CurObject.Logs[i].Card AND
                   SwitchingItem = :CurObject.Logs[i].SwitchingItem;
            CALLPROC DDB_ROLLBACK;

            PrevArch = CurObject.Logs[i].ArchiveCard;
            PrevCard = CurObject.Logs[i].Card;
            PrevSW = CurObject.Logs[i].SwitchingItem;
         ELSE
            CurObject.Logs[i].ArchiveCard = PrevArch;
         ENDIF;
      ENDIF;
   ENDFOR;  
   CALLPROC DDB_ROLLBACK;
END;

METHOD SetActualInServiceDate2(
   Card = INTEGER NOT NULL,
   SwitchingItem = INTEGER NOT NULL,
   ClosureTime = DATE NOT NULL
)=
DECLARE
   i          = INTEGER NOT NULL WITH DEFAULT;
   k          = INTEGER NOT NULL WITH DEFAULT;
   FoundJob   = INTEGER NOT NULL WITH DEFAULT;
   RSComplete = DATE;
   LastPermitReturn = DATE;
   RetCode    = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   SELECT :RSComplete = J.RSComplete,
          :FoundJob = J.Job
   FROM   SOA_ORLog L,
          SOA_Job J
   WHERE  L.ORNumber = :CurObject.ORNumber AND
          L.Item = 'ActualOutageDate' AND
          L.Job = J.Job;
          
   IF RSComplete IS NOT NULL AND RSComplete <> '' THEN
      ClosureTime = RSComplete;
   ENDIF;

   RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualInserviceDate',
                      FieldValue = ClosureTime);
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualInServiceDate2;' + 
               ' ERROR: Failed to set Actual InService Date ' + VARCHAR(ClosureTime) + ' for OR ' + CurObject.ORNumber);
            RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      

   IF FoundJob = 0 THEN
      FoundJOb = SwitchingItem;
   ENDIF;
         
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :Card;
      ENDIF;

   RetCode = CALLPROC SOA_ORLogIns (
                  ORNumber = CurObject.ORNumber,
                  Item = 'ActualInserviceDate',
                  Application = CurrentApplication,
                  Card = Card,
                  SwitchingItem = SwitchingItem,
                  Job = FoundJob,
                  LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualInserviceDate2;' + 
               ' ERROR: Failed to record log entry for Actual Inservice Date ' + VARCHAR(ClosureTime) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
/*      
** Get last permit completion to update actual return date
*/    
      LastPermitReturn = NULL;
      SELECT :LastPermitReturn = MAX(J.RSComplete)
      FROM   SOA_Job J,
             SOA_JobControl JC
      WHERE  JC.Card = :Card AND
             JC.SwitchingItem = :SwitchingItem AND
             JC.StepPair IN (:StepHeading$WorkPermit,:StepHeading$TestPermit) AND
             JC.Job = J.Job AND
             J.TOIssued IS NOT NULL AND
             J.RSComplete IS NOT NULL AND
             J.Substation = :CurObject.Substation;
       
      IF LastPermitReturn IS NOT NULL THEN
         RetCode = CALLPROC SOA_ORActualDateUpd(
                      ORNumber	= CurObject.ORNumber,
                      FieldName = 'ActualReturnDate',
                      FieldValue = LastPermitReturn);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + 'OutageReport.SetActualReturnDate2;' + 
               ' ERROR: Failed to set Actual Return Date ' + VARCHAR(LastPermitReturn) + ' for OR ' + CurObject.ORNumber);
            RETURN;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;      
      ENDIF;
      
      IF CurrentApplication = '' THEN
         SELECT :CurrentApplication = Application
         FROM   SOA_Card
         WHERE  Card = :Card;
      ENDIF;
      
      RetCode = CALLPROC SOA_ORLogIns (
                     ORNumber = CurObject.ORNumber,
                     Item = 'ActualReturnDate',
                     Application = CurrentApplication,
                     Card = Card,
                     SwitchingItem = SwitchingItem,
                     Job = FoundJob,
                     LogTime = DATE('now') );
					
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = VARCHAR(DATE('NOW')) + ' OutageReport.SetActualReturnDate2;' + 
               ' ERROR: Failed to record log entry for Actual Return Date ' + VARCHAR(LastPermitReturn) + ' for OR ' + CurObject.ORNumber);
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;    
/* 
** set the OR status to closed 
*/
    CurObject.Status = Order$Closed;
    CurObject.UpdateStatus();
END;

