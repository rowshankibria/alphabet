**  04/28/10 ysp itc253 - support unit substation and feeder requests
**  05/05/10 ysp 1. Check previous status in UpdateStatus. 2.when the TO sets a permit pending, 
**               check if this permit is from a working group's request. if so, send the status 
**               to REQ_PEND, so that the working group can rescind it, edit it and send back to the TO
**  05/14/10 ysp itc253 Ext: support TLS ISWP requests. Add GetTLSCard method.
**  06/15/10 ysp Not to refresh equipment in ir_oporderfeeders table when UpdateISP for 
**               TLS permits because only the circuit is saved in this table.
**  07/19/10 ysp Add Transmission Feeders outside Substation permits.
**  08/23/10 ysp 1. Set SSO_Status_Name in UpdateStatus method when permit is issued or submitted.
**               2. Redesign of requests' StartDate and Workshift: StartDate includes the time and 
**               Workshift is the number of hours.
**  07/15/11 ysp Send email to working groups when a request is acknowledged and issued.
**  11/18/11 ysp 1. Save dielectric iswp request. 2. send notification to SM when an request is 
**               submitted to SM.
**  12/02/11 ysp When a new ISWP request of type "Transmission Feeder outside of Substation" is submitted, 
**               notify the shift manager automatically.
**  12/14/11 ysp support Conditions for Dielectric ISWPs
**  07/16/12 ysp Add column NotifyWhenCompleted and method CompletePermit
**  08/23/12 ysp Update completion messages to include substation and equipment.
**  02/28/13 ysp Add UpdateNotifyMeFlag method
**  07/02/13 ysp add UpdateNYISOFlag and SendNYISOEmail methods
**  07/22/13 ysp working group can now edit and save a PENDING request.
**  07/30/13 ysp always notified TO when NYISO notification required permit is returned. Allow NYISO
**               flag after permit issued.
**  10/24/13 ysp 1. Process of Local Authorization requests. 2. allow designated crew to update requests.
**  01/02/15 ysp 1. Add Compliance attribute. 2. Add SkipOther parameter in LoadDetail method 
**               3. Add iswp return confirmation email. 4. add loading of conditions in LoadDetail method
**               for PDF report.
**  03/10/15 em  Update Process Request Method to include Deny Category and Set Report time. Also set
**               report time when permit verbally issued.
**  07/28/15 ysp Process requests submitted to RCC and approval by RCC. Notify RCC shift manage when iswp is
**               issued.
**  09/30/15 ysp set the jurisdiction to DO/Verbal after DO acks a unit substation iswp request.
**  04/06/16 ysp send an email to the working group when TO approves the request on conditions
**  05/24/16 ysp Fix updating email addresses in IsActionAllowed
**  03/07/17 em  Add LockedPermit attribute; in InsertISP method, add attribute to indicate Job ID exists
**  05/02/17 em  Add ApprovedByTOName attribute with log insertion if value is set for ISP insert
**  07/26/17 em  Change ApprovedByTOName to TOApproved
**  09/19/17 pkw Pass time into tc_loginsert procedure
**  10/23/18 ysp replace RetrieveWorkPermit calls in LoadDetail with querys to the work permit tables.
**  02/10/23 ysp Extra caution is added in CreateOrder to prevent issuing an ISWP twice.
**  02/06/24 em  Add NYPA Notified, similar to NYISO Notified.
**  02/12/24 ysp add parsing of associated feeders in ProcessRequest method.
*/
METHOD IsActionAllowed(
   UpdateByName = VARCHAR(40) NOT NULL WITH DEFAULT
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   EmailList = VARCHAR(200) NOT NULL WITH DEFAULT;
   EnterByName = VARCHAR(40) NOT NULL WITH DEFAULT;
   TempString  = VARCHAR(40) NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   IF CurObject.Login = '' THEN
      /* the action is taken by DO */
      RETURN TRUE;
   ELSE
      SELECT :EnterByName = R.EnterByName,
             :EmailList = R.Email
      FROM   SOA_ISPermitRequest R
      WHERE  R.ISPermit = :CurObject.ISPermit;
      CALLPROC DDB_ROLLBACK;

      IF UPPERCASE(EnterByName) = UPPERCASE(UpdateByName) THEN
         RETURN TRUE;
      ELSE
         TempString = '%' + UPPERCASE(CurObject.Login) + '@%';
         IF UPPERCASE(EmailList) LIKE TempString THEN
            RETURN TRUE;
         ENDIF;
      ENDIF;
   ENDIF;

   RETURN FALSE;
END;

METHOD InsertISP (
   ExistingJob = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ISPermit = 0;

   IF ExistingJob = 0 THEN
      CurObject.Job = 0;
      IF CurObject.Application = Application$SLC THEN
         CurObject.Job = CALLPROC SOA_JobLastKey;
      ELSEIF CurObject.Application = Application$TLS THEN
         CurObject.Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
      ENDIF;
   ENDIF;    

   IF CurObject.Job <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'InServicePermitClass.InsertISP; Error generating next Job key';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertISP; ' + 
                'Error generating next Job key');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
      
   CurObject.EnterTime = Date('now');
   CurObject.StatusTime = Date('now');
   CurObject.CurrentStatus = 'OPEN';

   CurObject.ISPermit = CALLPROC SOA_InServicePermitIns(
                Division = CurObject.Division, 
                Substation = CurObject.Substation,
                ObjectType = CurObject.ObjectType,
                Object = CurObject.Object,
                ObjectName = CurObject.ObjectName,
                Application = CurObject.Application, 
                JobClass = CurObject.JobClass,    
                WorkGroup = CurObject.WorkGroup,        
                PermitMove = CurObject.PermitMove,			    
                PreIssued = CurObject.PreIssued,		    
                ShiftStartTime = CurObject.ShiftStartTime,
                NotifyWhenCompleted = CurObject.NotifyWhenCompleted,
                Compliance = CurObject.Compliance,                
                EnterTime = CurObject.EnterTime,		    
                EnterBy = CurObject.EnterBy,
                CreatedBy = CurObject.CreatedBy,
                Jurisdiction = CurObject.Jurisdiction,
                Status = CurObject.Status,			      
                Job = CurObject.Job);

   IF CurObject.ISPermit <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = CurObject.ISPermit;
      CurObject.ErrorMessage = 'InServicePermitClass.InsertISP; Error inserting In Service Permit';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.InsertISP. ERROR: ' + 
                'Unable to insert In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF CurObject.NYISONotified <> 0 THEN
      CurObject.LastUpdateBy = CurObject.EnterBy;
      CurObject.UpdateNYISOFlag(SkipStatusQuery = TRUE);
   ENDIF;

   IF CurObject.NYPANotified <> 0 THEN
      CurObject.LastUpdateBy = CurObject.EnterBy;
      CurObject.UpdateNYPAFlag(SkipStatusQuery = TRUE);
   ENDIF;

/*
** insert permit equipment
*/
   IF CurObject.ObjectType = Type$TelCircuit THEN
      CurObject.BuildCktEquipList();
   ENDIF;

   FOR i = 1 TO CurObject.EL.LastRow() DO
      RetCode = CALLPROC IR_OpOrderFeedersIns(
                    OrderNumber = 0,
                    ISPermit = CurObject.ISPermit,
                    Object = CurObject.EL[i].Object,
                    Name = CurObject.EL[i].Name,
                    TypeName = CurObject.EL[i].TypeName,
                    PrimaryEquip = CurObject.EL[i].PrimaryEquip);
                    
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.InsertISP; Error inserting ISP Equipment';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.InsertISP. ERROR: ' + 
                  'Unable to insert ISP Equipment.');
         RETURN;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** insert conditions.
*/
   FOR i = 1 TO CurObject.CL.LastRow() DO  
      CurObject.CL[i].Job = 0;
      IF CurObject.Application = Application$SLC THEN
         CurObject.CL[i].Job = CALLPROC SOA_JobLastKey;
      ELSEIF CurObject.Application = Application$TLS THEN
         CurObject.CL[i].Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
      ENDIF;    

      IF CurObject.CL[i].Job <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'InServicePermitClass.InsertISP; Error generating next SOA_Job key for a Condition';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertISP; ' + 
                'Error generating next SOA_Job key for a Condition');
         RETURN;
      ENDIF;

      RetCode = CALLPROC SOA_ISPConditionIns(
                    ISPermit = CurObject.ISPermit,
                    Job = CurObject.CL[i].Job,
                    JobClass = CurObject.CL[i].JobClass,
                    MoveText = CurObject.CL[i].MoveText);
                    
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.InsertISP; Error inserting ISP Condition';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertISP; ' + 
                'Error inserting ISP Condition.');
         RETURN;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** Insert Approval Log Entry
*/
   IF CurObject.TOApproved = 1 THEN
               RetCode = CALLPROC SOA_ISPLogIns(
                                       ISPermit = CurObject.ISPermit, 
                                       LogTime = DATE('NOW'),
                                       LogUpdateBy = CurObject.EnterBy, 
                                       LogItem = 'Approval',
                                       LogText = 'DO confirmed approval from Bulk Power',
                                       LogType = 0); // TO and DO only
               CALLPROC DDB_COMMIT;
   ENDIF;
/*
** insert SOA Work Permit, adjust protection required only when PhaseCheckIndicator is not set. 
** If set, this is a regular permit linked to a DO ISWP and the work permit row already exists.  
*/
   IF CurObject.Application = Application$SLC THEN
      IF CurObject.SOA_WP.PhaseCheckIndicator = 0 THEN
         CurObject.SOA_WP.ProtectionRequired = 0;
         RetCode = CurObject.SOA_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);
      ENDIF;
   ELSEIF CurObject.Application = Application$TLS THEN
      RetCode = CurObject.TLS_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);
   ENDIF;
END;


METHOD UpdateISP (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.LastUpdateTime = Date('now');

   SELECT :CurObject.Application = P.Application,
          :CurObject.Status = P.Status,
          :CurObject.CurrentStatus = P.CurrentStatus,
          :CurObject.StatusTime = P.StatusTime,
          :CurObject.Job = P.Job			        
   FROM  SOA_InServicePermit P
   WHERE ISPERMIT = :CurObject.ISPermit;
/*
** IF ISP status is greater than Open, it may have been updated by the TO.  We
** manipulate the data to set up the TLS WP fields.
*/
   IF CurObject.Application = Application$TLS AND CurObject.Status >= ISPStatus$PendingTO THEN
      CurObject.TLS_WP.ShiftStartTime = CurObject.ShiftStartTime;
      CurObject.TLS_WP.PreIssued = CurObject.PreIssued;
      SELECT :CurObject.TLS_WP.TOMove = SQUEEZE(LEFT(JC.TOMove, LOCATE(JC.TOMove,':')) + ' ' + :CurObject.PermitMove),	
             :CurObject.TLS_WP.RSMove = SQUEEZE(LEFT(JC.RSMove, LOCATE(JC.RSMove,':')) + ' ' + :CurObject.PermitMove)
      FROM   FMS_JobClass JC, 
             TC_Job J
      WHERE  J.Job = :CurObject.Job AND
             J.JobClass = JC.JobClass;
   ENDIF;

   RetCode = CALLPROC SOA_InServicePermitUpd(
                ISPermit = CurObject.ISPermit, 
                PermitMove = CurObject.PermitMove,			    
                PreIssued = CurObject.PreIssued,	
                Jurisdiction = CurObject.Jurisdiction,	    
                ShiftStartTime = CurObject.ShiftStartTime,
                Compliance = CurObject.Compliance,
                NotifyWhenCompleted = CurObject.NotifyWhenCompleted,
                LastUpdateTime = CurObject.LastUpdateTime,		    
                LastUpdateBy = CurObject.LastUpdateBy);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = CurObject.ISPermit;
      CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error updating In Service Permit';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateISP. ERROR: ' + 
                'Unable to update In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   
   IF CurObject.NYISONotified <> 0 THEN      
      CurObject.UpdateNYISOFlag(SkipStatusQuery = TRUE);
   ENDIF;
   IF CurObject.NYPANotified <> 0 THEN      
      CurObject.UpdateNYPAFlag(SkipStatusQuery = TRUE);
   ENDIF;

/*
** delete and re-insert permit equipment
*/
   IF CurObject.Application = Application$SLC OR 
      CurObject.Application = Application$DSO THEN

      RetCode = CALLPROC IR_OpOrderFeedersDel(              
                    ISPermit = CurObject.ISPermit);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error removing ISP Equipment for update';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateISP. ERROR: ' + 
                  'Unable to remove ISP Equipment for Update.');
         RETURN;
      ENDIF;

      FOR i = 1 TO CurObject.EL.LastRow() DO
         RetCode = CALLPROC IR_OpOrderFeedersIns(
                    OrderNumber = 0,
                    ISPermit = CurObject.ISPermit,
                    Object = CurObject.EL[i].Object,
                    Name = CurObject.EL[i].Name,
                    TypeName = CurObject.EL[i].TypeName,
                    PrimaryEquip = CurObject.EL[i].PrimaryEquip);
                    
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = RetCode;
            CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error updating ISP Equipment';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateISP. ERROR: ' + 
                  'Unable to update ISP Equipment.');
            RETURN;
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ENDIF;
/*
** delete existing conditions.
*/
   RetCode = CALLPROC SOA_ISPConditionDel(
                    ISPermit = CurObject.ISPermit,
                    Job = 0);
                    
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = RetCode;
      CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error deleting ISP Conditions';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateISP; ' + 
                'Error deleting ISP Conditions.');
      RETURN;
   ENDIF;
/*
** insert or update conditions.
*/
   FOR i = 1 TO CurObject.CL.LastRow() DO

/* CurObject.SOA_WP.ProtectionRequired = 1;  
*/
      IF CurObject.CL[i].Job = 0 THEN
         IF CurObject.Application = Application$SLC THEN
            CurObject.CL[i].Job = CALLPROC SOA_JobLastKey;
         ELSEIF CurObject.Application = Application$TLS THEN
            CurObject.CL[i].Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
         ELSEIF CurObject.Application = Application$DSO THEN
            /* For now, we use SOA Job ID */
            CurObject.CL[i].Job = CALLPROC SOA_JobLastKey;
         ENDIF;

         IF CurObject.CL[i].Job <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error generating next SOA_Job key for a Condition';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateISP; ' + 
                 'Error generating next SOA_Job key for a Condition');
            RETURN;
         ENDIF;
      ENDIF;

      RetCode = CALLPROC SOA_ISPConditionIns(
                    ISPermit = CurObject.ISPermit,
                    Job = CurObject.CL[i].Job,
                    JobClass = CurObject.CL[i].JobClass,
                    MoveText = CurObject.CL[i].MoveText);
                    
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.UpdateISP; Error updating ISP Condition';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateISP; ' + 
                'Error updating ISP Condition.');
         RETURN;
      ENDIF;
   ENDFOR;
   CALLPROC DDB_COMMIT;
/*
** update SOA Work Permit, adjust protection required only when PhaseCheckIndicator is not set. 
** If set, this is a regular permit linked to a DO ISWP.  
*/
   IF CurObject.Application = Application$SLC THEN
      IF CurObject.SOA_WP.PhaseCheckIndicator = 0 THEN
         CurObject.SOA_WP.ProtectionRequired = 0;
      ENDIF;
      RetCode = CurObject.SOA_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);
   ELSEIF CurObject.Application = Application$TLS THEN
      RetCode = CurObject.TLS_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);
   ELSEIF  CurObject.Application = Application$DSO THEN
      CurObject.ISP_Job.ISPermit = CurObject.ISPermit;
      CurObject.ISP_Job.UpdateJob();
   ENDIF;
/*
** If an approved ISP is updated with a new condition, the status should be changed to A/COND.
** Vice versa for ISP with A/COND
*/
   IF CurObject.Status = ISPStatus$Approved AND
      CurObject.CL.LastRow > 0 THEN
      CurObject.PrevStatus = 0;
      CurObject.Status = ISPStatus$CondApproved;
      CurObject.UpdateStatus();

   ELSEIF CurObject.Status = ISPStatus$CondApproved AND
      CurObject.CL.LastRow = 0 THEN
      CurObject.PrevStatus = 0;
      CurObject.Status =  ISPStatus$Approved;
      CurObject.UpdateStatus();
   ENDIF;

   RETURN;
END;


METHOD DeleteISP (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';     
/*
** delete and permit equipment
*/
   RetCode = CALLPROC IR_OpOrderFeedersDel(              
                    ISPermit = CurObject.ISPermit);
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.DeleteISP; Error removing ISP Equipment for delete';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.InsertISP. ERROR: ' + 
                  'Unable to remove ISP Equipment.');
         RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Job = 0 will delete all conditions.
*/
   RetCode = CALLPROC SOA_ISPConditionDel(
                    ISPermit = CurObject.ISPermit,
                    Job = 0);
                    
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.DeleteISP; Error deleting ISP Conditions.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertISP; ' + 
                'Error deleting ISP Conditions.');
         RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** check if this permit is created from a request
*/
   i = 0;
   SELECT :i = 1
   FROM   SOA_ISPermitRequest
   WHERE  ISPermit = :CurObject.ISPermit;

   IF i = 1 THEN
      /*
      ** Reset the permit record
      */
      CurObject.Status = ISPStatus$Request;
      CurObject.StatusTime = DATE('NOW');

      RetCode = CALLPROC SOA_ISPResetToRequest (
                ISPermit = CurObject.ISPermit,
                Status = CurObject.Status,
                StatusTime = CurObject.StatusTime,
                StatusUpdateBy = CurObject.LastUpdateBy);

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = CurObject.ISPermit;
         CurObject.ErrorMessage = 'InServicePermitClass.DeleteISP; Error deleting In Service Permit';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.DeleteISP. ERROR: ' + 
                'Unable to reseting In Service Permit.');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

   ELSE
      RetCode = CALLPROC SOA_InServicePermitDel(
                ISPermit = CurObject.ISPermit);
 
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = CurObject.ISPermit;
         CurObject.ErrorMessage = 'InServicePermitClass.DeleteISP; Error deleting In Service Permit';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.DeleteISP. ERROR: ' + 
                'Unable to delete In Service Permit.');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;
END;

METHOD ClearISP (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';     
/*
** update permit status
*/
   RetCode = CALLPROC SOA_ISPStatusUpd(              
                    ISPermit = CurObject.ISPermit,
                    Status = ISPStatus$Archived,
                    StatusTime = DATE('now'),
                    StatusUpdateBy =  CurObject.LastUpdateBy,
                    StatusReason = 'Permit Cleared');
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = RetCode;
      CurObject.ErrorMessage = 'InServicePermitClass.ClearISP; Error clearing ISP.';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ClearISP; ERROR: ' + 
                'Unable to update ISP status');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** we need the current status in the class to pass back to ISP Online
*/   
   SELECT :CurObject.CurrentStatus = CurrentStatus,
          :CurObject.CloseTime = CloseTime,
          :CurObject.Status = Status
   FROM   SOA_InServicePermit
   WHERE  ISPermit = :CurObject.ISPermit;
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadDetail(
   SkipOther = INTEGER NOT NULL WITH DEFAULT
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   
   x  = INTEGER NOT NULL WITH DEFAULT;
   
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   OpName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   /* this query should select all fields in SOA_InServicePermit table
   */
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.Job = P.Job, 
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.SubstationRating = P.SubstationRating,
          :CurObject.Application = P.Application,    
          :CurObject.ObjectType = P.ObjectType,    
          :CurObject.Object = P.Object,    
          :CurObject.ObjectName = P.ObjectName,    
          :CurObject.JobClass = P.JobClass,        
          :CurObject.WorkGroup = P.WorkGroup,        
          :CurObject.PermitMove = P.PermitMove,			    
          :CurObject.PreIssued = P.PreIssued,		    
          :CurObject.ShiftStartTime = P.ShiftStartTime,  
          :CurObject.NotifyWhenCompleted = P.NotifyWhenCompleted,  
          :CurObject.NYISONotified = P.NYISONotified,
          :CurObject.NYPANotified = P.NYPANotified,
          :CurObject.Compliance = P.Compliance,
          :CurObject.EnterTime = P.EnterTime,		    
          :CurObject.CreatedBy = P.CreatedBy,		    
          :CurObject.Jurisdiction = P.Jurisdiction,		    
          :CurObject.EnterBy = P.EnterBy,		      
          :CurObject.CurrentStatus = P.CurrentStatus,			      
          :CurObject.Status = P.Status,			      
          :CurObject.StatusTime = P.StatusTime,			      
          :CurObject.CloseTime = P.CloseTime    
   FROM  SOA_InServicePermit P,
         UDB_Object O
   WHERE P.ISPERMIT = :CurObject.ISPermit AND
         P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;
   
   IF SkipOther = 1 THEN
      RETURN;
   ENDIF;
   
   IF CurObject.Application = Application$SLC THEN
       /*CurObject.SOA_WP.RetrieveWorkPermit (Job = CurObject.Job);  */
       x = 0;
       SELECT :x = PermitJobID,
              :CurObject.SOA_WP.Description = Description,
              :CurObject.SOA_WP.PhaseCheckIndicator = PhaseCheckIndicator,
              :CurObject.SOA_WP.AllRelaysNormal = AllRelaysNormal,
              :CurObject.SOA_WP.DefectRelayComment = DefectRelayComment
       FROM   SOA_WorkPermit
       WHERE  PermitJobID = :CurObject.Job;
         
       IF x = 0 THEN
          SELECT :x = PermitJobID,
                 :CurObject.SOA_WP.Description = Description,
                 :CurObject.SOA_WP.PhaseCheckIndicator = PhaseCheckIndicator,
                 :CurObject.SOA_WP.AllRelaysNormal = AllRelaysNormal,
                 :CurObject.SOA_WP.DefectRelayComment = DefectRelayComment
          FROM   SOA_ArchiveWorkPermit
          WHERE  PermitJobID = :CurObject.Job;
       ENDIF;
         
   ELSEIF CurObject.Application = Application$TLS THEN
       /* CurObject.TLS_WP.RetrieveWorkPermit (Job = CurObject.Job); */
       x = 0;
       SELECT :x = PermitJobID,
              :CurObject.TLS_WP.Description = Description
       FROM   TC_WorkPermit
       WHERE  PermitJobID = :CurObject.Job;
         
       IF x = 0 THEN
          SELECT :x = PermitJobID,
                 :CurObject.TLS_WP.Description = Description
          FROM   TC_ArchiveWorkPermit
          WHERE  PermitJobID = :CurObject.Job;
       ENDIF;          

       /* the online page has access to SOA_WP.Description only 
       */
       CurObject.SOA_WP.Description = CurObject.TLS_WP.Description;	
   ELSEIF CurObject.Application = Application$DSO THEN
       CurObject.ISP_Job.ISPermit = CurObject.ISPermit;
       CurObject.ISP_Job.LoadISPJob();
   ENDIF;
          
   i = 1;
   SELECT :CurObject.LL[i].LogTime = L.LogTime,
          :CurObject.LL[i].LogUpdateByName = O.Description,
          :CurObject.LL[i].LogText = L.LogText
   FROM   SOA_ISPLog L,
          UDB_Object O
   WHERE  L.ISPermit = :CurObject.ISPermit AND
          L.LogUpdateby = O.Object AND
          L.LogType IN (0, 2)                            /* FOR TO and DO */
   ORDER BY LogTime
   BEGIN
      i = i + 1;
   END;

/* Operating order status 
*/
   IF CurObject.Status = ISPStatus$Submitted THEN
      CurObject.SSO_Status_Name = 'DO Cond';

   ELSEIF CurObject.Status >= ISPStatus$Issued THEN
      // Default SSO Status to Verbal for Issued orders,
      CurObject.SSO_Status_Name = 'Verbal';

      OrderNumber = 0;
      IF CurObject.Application = Application$SLC THEN
        REPEATED
        SELECT :OrderNumber = O.OrderNumber,
               :CurObject.SSO_Status = O.OrderStatus
        FROM   IR_OperatingOrder O
        WHERE  O.OrderNumber = (SELECT MAX(OJ.OrderNumber) 
                                FROM IR_OpOrderJobs OJ 
                                WHERE OJ.Job = :CurObject.Job);
      ELSEIF CurObject.Application = Application$TLS THEN
        REPEATED
        SELECT :OrderNumber = O.OrderNumber,
               :CurObject.SSO_Status = O.OrderStatus
        FROM   IR_TelephoneOrder O
        WHERE  O.OrderNumber = (SELECT MAX(OJ.OrderNumber) 
                                FROM   IR_TLSOrderJob OJ 
                                WHERE OJ.Job = :CurObject.Job);
      ENDIF;
      
      IF OrderNumber > 0 THEN
         IF CurObject.SSO_Status = Order$Opened THEN
            CurObject.SSO_Status_Name = 'Opened';

         ELSEIF CurObject.SSO_Status = Order$Downloaded THEN
            CurObject.SSO_Status_Name = 'Downloaded';

         ELSEIF CurObject.SSO_Status = Order$Acknowledged THEN
            CurObject.SSO_Status_Name = 'Acknowledged';

         ELSEIF CurObject.SSO_Status = Order$Rejected THEN
            CurObject.SSO_Status_Name = 'Rejected';

         ELSEIF CurObject.SSO_Status = Order$ConfirmRejected THEN
            CurObject.SSO_Status_Name = 'Rejected';

         ELSEIF CurObject.SSO_Status = Order$Rescinded THEN
            CurObject.SSO_Status_Name = 'Rescinded';

         ELSEIF CurObject.SSO_Status = Order$ConfirmRescinded THEN
            CurObject.SSO_Status_Name = 'Rescinded';

         ELSEIF CurObject.SSO_Status = Order$Closed THEN
            CurObject.SSO_Status_Name = 'Closed';

         ELSEIF CurObject.SSO_Status = Order$ConfirmClosed THEN
            CurObject.SSO_Status_Name = 'Closed';

         ELSEIF CurObject.SSO_Status = Order$Cancelled THEN
            CurObject.SSO_Status_Name = 'Cancelled';
         ENDIF; 
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
/*
** is this permit created from a request
*/
   CurObject.RequestID = 0;
   SELECT :CurObject.RequestID = ISPermit
   FROM   SOA_ISPermitRequest
   WHERE  ISPermit = :CurObject.ISPermit;

   CurObject.EL.Clear();  
   i = 1;
   SELECT :CurObject.EL[i].Object = Object,
          :CurObject.EL[i].TypeName = TypeName,
          :CurObject.EL[i].Name = Name,
          :CurObject.EL[i].PrimaryEquip = PrimaryEquip
   FROM   IR_OpOrderFeeders 
   WHERE  ISPermit = :CurObject.ISPermit
   BEGIN
      i = i + 1;
   END;

   CurObject.CL.Clear();
   i = 1;
   SELECT :CurObject.CL[i].JobClass = JobClass,
          :CurObject.CL[i].MoveText = MoveText
   FROM   SOA_ISPCondition
   WHERE  ISPermit = :CurObject.ISPermit
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;
END;


METHOD UpdateStatus(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   EmailClass = EmailNotificationClass DEFAULT NULL;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   NewJob = INTEGER NOT NULL WITH DEFAULT;
   OldJob = INTEGER NOT NULL WITH DEFAULT;
   OldStatus = INTEGER NOT NULL WITH DEFAULT;
   OldCurrentStatus = VARCHAR(10) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
   TOIssued = DATE DEFAULT NULL;
   TOComplete = DATE DEFAULT NULL;
   RSIssued = DATE DEFAULT NULL;
   RSComplete = DATE DEFAULT NULL;
   Response = VARCHAR(20) NOT NULL WITH DEFAULT;
   TargetName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Get the current (old) permit status from the db 
** and the permitJob ID in case we need it.
*/
   SELECT :OldStatus = P.Status,
          :OldCurrentStatus = P.CurrentStatus,
          :OldJob = P.Job,
          :CurObject.SubstationName = O.Description,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.PermitMove = P.PermitMove
   FROM   SOA_InServicePermit P,
          UDB_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object; 
/*
** if PrevStatus is passed in, check it against the status in the database.
** This is to resolve timing issue where the other party changed the status 
** just before we change the status. 
*/
   IF CurObject.PrevStatus <> 0 AND CurObject.PrevStatus <> OldStatus THEN
      /*
      ** return the latest status back
      */
      CurObject.Status = OldStatus;
      CurObject.CurrentStatus = OldCurrentStatus;
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'The permit has been changed to ' + OldCurrentStatus + ' by other party';
      RETURN; 
   ENDIF;
/*
** update permit status
*/
   RetCode = CALLPROC SOA_ISPStatusUpd(              
                    ISPermit = CurObject.ISPermit,
                    Status = CurObject.Status,
                    StatusTime = DATE('now'),
                    StatusUpdateBy =  CurObject.LastUpdateBy,
                    StatusReason = CurObject.SODenyReason);
   IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = RetCode;
         CurObject.ErrorMessage = 'InServicePermitClass.UpdateStatus; Error updating ISP status.';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateStatus. ERROR: ' + 
                  'Unable to update ISP status');
         RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
** when the TO sets a permit pending, check if this permit is from a working group's request.
** if so, set the status to REQ_PEND instead of PEND so that the working group can rescind it, 
** edit it and send it back to the TO. Otherwise, the working group still see the status as
** ACKED.
** If the TO denies a permit created from a request, set the request status to REQ_DENIED, so an 
** email is sent to the working group.
*/
   IF CurObject.Status = ISPStatus$Pending OR CurObject.Status = ISPStatus$Denied THEN
      i = 0;
      SELECT :i = 1
      FROM   SOA_ISPermitRequest
      WHERE  ISPermit = :CurObject.ISPermit;
      CALLPROC DDB_ROLLBACK;
    
      IF i = 1 THEN
         IF CurObject.Status = ISPStatus$Pending THEN
            CurObject.Status = ISPStatus$RequestPending;
         ELSEIF CurObject.Status = ISPStatus$Denied THEN
            CurObject.Status = ISPStatus$RequestDenied;
         ENDIF;

         /* get the TO's name in order to update the request status
         */
         SELECT :CurObject.LastUpdatebyName = Description
         FROM   Udb_Object
         WHERE  Object = :CurObject.LastUpdateBy;

         /*
         ** delete permit equipment
         */
         RetCode = CALLPROC IR_OpOrderFeedersDel(              
                    ISPermit = CurObject.ISPermit);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Unable to send the request status to pending';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateStatus. ERROR: ' + 
                  'Unable to remove ISP Equipment for request pending.');
            RETURN;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
         
         CurObject.ProcessRequest();
         RETURN;
      ENDIF;
   ENDIF;
/*
** we need the current status in the class to pass back to ISP Online
*/   
   SELECT :CurObject.CurrentStatus = CurrentStatus,
          :CurObject.StatusTime = StatusTime,
          :CurObject.CreatedBy = CreatedBy,
          :CurObject.Application = Application,
          :CurObject.Job = Job, 
          :CurObject.Substation = Substation,
          :CurObject.Jurisdiction = Jurisdiction
   FROM   SOA_InServicePermit
   WHERE  ISPermit = :CurObject.ISPermit;

   IF CurObject.Status = ISPStatus$Issued THEN
      CurObject.SSO_Status_Name = 'Opened';
   ELSEIF CurObject.Status = ISPStatus$Submitted THEN
      CurObject.SSO_Status_Name = 'DO Cond';
   ENDIF;
/*
** if a D.O. entered ISP is either Denied or Pending by TO/SO, send an incoming message to D.O.
*/
   IF (CurObject.Status = ISPStatus$Denied OR CurObject.Status = ISPStatus$Pending) AND
      CurObject.CreatedBy = 'DO' THEN

      IF CurObject.Status = ISPStatus$Denied THEN
         MsgText = 'IN-SERVICE WORK PERMIT DENIED ';
      ELSE
         MsgText = 'IN-SERVICE WORK PERMIT PENDING ';
      ENDIF;
      MsgText = MsgText + HC_NEWLINE +
         'Please review the In-Service Work Permit Summary and take action where necessary'; 
    
      RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = CurObject.Substation,
                                  SubstationName = 'In-Service WP',
                                  Msg = MsgText, 
                                  FromOpName = 'TO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = CurObject.Application,
                                  FromApp = 'ISP Online',
                                  Priority = 0
                                  );
      IF RetCode <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                   'Unable to send incoming message to DO for denied/pending ISWP.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
** If we are changing a pulled status to approved, we need to update the Job Id's for the permit
** and the conditions to prevent duplicate insertions.
**
** 05/05/10 YSP Comment - The code below is used to handle the situation where an ISSUED permit was 
** WITHDRAWN(pulled) by the TO due to system conditions, and later approved by the TO again to
** prepare to issue again. This is not about a PEND permit that is withdrawn by the DO. 
*/
   IF (CurObject.Application = Application$SLC OR CurObject.Application = Application$TLS) AND
       OldStatus = ISPStatus$Withdrawn AND 
      (CurObject.Status = ISPStatus$Approved OR CurObject.Status = ISPStatus$CondApproved) THEN

      IF CurObject.Application = Application$SLC THEN
         NewJob = CALLPROC SOA_JobLastKey;
      ELSEIF CurObject.Application = Application$TLS THEN
         NewJob = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
      ENDIF;

      IF NewJob <= 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'InServicePermitClass.UpdateStatus; Error generating next Job key';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                'Error generating next SOA/TLS Job key, for re-approved permit');
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;

      /*
      ** Gray out the old job if it was rescinded before using the new job ID.
      */
      IF CurObject.Application = Application$SLC THEN
         SELECT :TOIssued = TOIssued,
                :TOComplete = TOComplete,
                :RSIssued = RSIssued,
                :RSComplete = RSComplete,
                :Response = Response
         FROM   SOA_Job
         WHERE  Job = :CurObject.Job;
      ELSEIF CurObject.Application = Application$TLS THEN
         SELECT :TOIssued = TOIssued,
                :TOComplete = TOComplete,
                :RSIssued = RSIssued,
                :RSComplete = RSComplete,
                :Response = Results
         FROM   TC_Job
         WHERE  Job = :CurObject.Job;
      ENDIF;

      IF (TOIssued IS NULL) THEN 
          TOIssued = ' '; 
      ENDIF; 
      IF (TOComplete IS NULL) THEN 
          TOComplete = ' '; 
      ENDIF; 
      IF (RSIssued IS NULL) THEN 
          RSIssued = ' '; 
      ENDIF; 
      IF (RSComplete IS NULL) THEN 
          RSComplete = ' '; 
      ENDIF; 

      IF TOIssued = ' ' THEN 
         IF CurObject.Application = Application$SLC THEN
            IF Response = '' THEN
               Response = 'WITHDRAWN';
            ENDIF;
            RetCode = CALLPROC SOA_JobTimeUpd(
                     Job = CurObject.Job,  
		      Response   = Response, 
		      TOIssued   = TOIssued, 
		      TOComplete = TOComplete, 
		      RSIssued   = RSIssued, 
		      RSComplete = RSComplete);
         ELSEIF CurObject.Application = Application$TLS THEN
            IF Response = '' THEN
               Response = 'WITHDRAWN';
            ENDIF;
            RetCode = CALLPROC TC_JobTimeUpd(
                     Job = CurObject.Job,  
		      Results = Response, 
		      TOIssued   = TOIssued, 
		      TOComplete = TOComplete, 
		      RSIssued   = RSIssued, 
		      RSComplete = RSComplete);
         ENDIF;

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus ; ' + 
                    'Failed to gray out work permit move: ' + 
                    VARCHAR(CurObject.Job));
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;

      /* replace job id in the iswp table and in the soa_workpermit or tc_workpermit table
      */
      RetCode = CALLPROC SOA_ISPWithdrawJob (
                     ISPermit = CurObject.ISPermit,
                     NewJob = NewJob);

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Failed to replace old permit job ID.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                    'Failed to replace old permit job ID:' + 
                    VARCHAR(CurObject.Job));
         RETURN;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** If approval status is conditional, conditions must be reinserted with new Job Ids.
*/
      IF CurObject.Status = ISPStatus$CondApproved THEN
         i = 1;
         CurObject.CL.Clear();
         SELECT :CurObject.CL[i].JobClass = JobClass,
                :CurObject.CL[i].MoveText = MoveText
         FROM   SOA_ISPCondition
         WHERE  ISPermit = :CurObject.ISPermit
         BEGIN
            i = i + 1;
         END;
/*
** delete existing conditions.
*/
         RetCode = CALLPROC SOA_ISPConditionDel(
                    ISPermit = CurObject.ISPermit,
                    Job = 0);
                    
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = RetCode;
            CurObject.ErrorMessage = 'InServicePermitClass.UpdateStatus; Error deleting ISP Conditions';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                'Error deleting ISP Conditions.');
            RETURN;
         ENDIF;
/*
** insert or update conditions.
*/
         FOR i = 1 TO CurObject.CL.LastRow() DO
            IF CurObject.Application = Application$SLC THEN
               CurObject.CL[i].Job = CALLPROC SOA_JobLastKey;
            ELSEIF CurObject.Application = Application$TLS THEN
                CurObject.CL[i].Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
            ENDIF;

            IF CurObject.CL[i].Job <= 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'InServicePermitClass.UpdateStatus; Error generating next Job key for a Condition';
               CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                     'Error generating next SOA/TLS Job key for a Condition');
               RETURN;
            ENDIF;

            RetCode = CALLPROC SOA_ISPConditionIns(
                    ISPermit = CurObject.ISPermit,
                    Job = CurObject.CL[i].Job,
                    JobClass = CurObject.CL[i].JobClass,
                    MoveText = CurObject.CL[i].MoveText);
                    
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = RetCode;
               CurObject.ErrorMessage = 'InServicePermitClass.UpdateStatus; Error updating ISP Condition';
               CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateStatus; ' + 
                   'Error updating ISP Condition.');
               RETURN;
            ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
** send email to notify of an issued permit
** 1. A regular permit is issued
** 2. an Tel Circuits Outside Substation permit or Transmission Feeders 
**    Outside Substation permit is approved.
*/
   IF CurObject.Status = ISPStatus$Issued OR
      CurObject.Status = ISPStatus$Submitted OR   
      ((CurObject.ObjectType = ISPType$CCTNWork OR CurObject.ObjectType = ISPType$LineWork) AND 
       (CurObject.Status = ISPStatus$Approved OR CurObject.Status = ISPStatus$CondApproved)) THEN
      /* 
      ** send a notification to the working group
      */
      SELECT :CurObject.ReqInfo.Email = Email
      FROM   SOA_ISPermitRequest
      WHERE  ISPermit = :CurObject.ISPermit;
  
      IF SQUEEZE(CurObject.ReqInfo.Email) <> '' THEN
         SELECT :CurObject.LastUpdatebyName = Description
         FROM   Udb_Object
         WHERE  Object = :CurObject.LastUpdateBy;

         TargetName = CurObject.SubstationName;
         IF TargetName = '' THEN
            TargetName = CurObject.ObjectName;
         ENDIF;

         IF EmailClass IS NULL THEN
            EmailClass = EmailNotificationClass.Create();
         ENDIF;

         EmailClass.EmailType = 7;                        // Approved permit
         EmailClass.Sender = CurObject.LastUpdatebyName;
         EmailClass.Recipient = CurObject.ReqInfo.Email;     

         EmailClass.Subject = 'In-Service Work Permit request for ' + TargetName;       
         EmailClass.Message1 = 'TargetName=' + TargetName + ';;' +
                    'Operator=' + CurObject.LastUpdatebyName + ';;';

         IF CurObject.Status = ISPStatus$Issued THEN
            EmailClass.Subject = EmailClass.Subject + ' is ISSUED';       
            EmailClass.Message1 = EmailClass.Message1 + 'Status=APPROVED;;'; 
         ELSEIF CurObject.Status = ISPStatus$Submitted THEN
            EmailClass.Subject = EmailClass.Subject + ' is CONDITIONALLY APPROVED';       
            EmailClass.Message1 = EmailClass.Message1 + 'Status=CONDITIONALLY APPROVED;;';          
         ELSE
            EmailClass.Subject = EmailClass.Subject + ' is APPROVED';
            EmailClass.Message1 = EmailClass.Message1 + 'Status=APPROVED;;'; 
         ENDIF;

         EmailClass.Message2 = 'Request=' + CurObject.PermitMove + ';;';
         EmailClass.Template = 'ISWPRequestApproved.html';                      
         EmailClass.InsertRequest();

         IF EmailClass.ReturnCode <> 0 THEN 
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.UpdateStatus. ERROR: ' + 
                   'Unable to notify work group of approved ISWP request.');
         ENDIF;
      ENDIF;
   ENDIF;
END;

METHOD IssuePermit (
   IssuedBy = VARCHAR(10) NOT NULL WITH DEFAULT;      /* - "ONLINE" if passed in from FMS_ONLINE;
                                                         - "SUMMARY" if passed in from ISWP_Summary screen;
                                                         - "REGULAR" if passed in from PerformMoves screen */
   FieldOperator = INTEGER NOT NULL WITH DEFAULT;     /* FO.Object if passed in from ISWP_Summary screen 
                                                         on SOA and TLS for DO/RR and DO/Verbal */
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   EmailClass = EmailNotificationClass DEFAULT NULL;
   IsSOOEnabled = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.LastUpdateBy = 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Validation problem - Unknown Operator in LastUpdateBy.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.IssuePermit ; ' + 
           'Validation problem - Unknown Operator in LastUpdateBy for Permit ' + 
           VARCHAR(:CurObject.Job));
      RETURN;
   ENDIF;
/*
** Method was modified to operate on a single permit instead of an array due to
** concern over performance of issuing an array.
*/
   j = 1;
   CurObject.CL.Clear();
   SELECT :CurObject.CL[j].Job = Job,
          :CurObject.CL[j].JobClass = JobClass,
          :CurObject.CL[j].MoveText = MoveText
   FROM   SOA_ISPCondition
   WHERE  ISPermit = :CurObject.ISPermit AND
          TimeMet IS NULL  /* Only count unmet conditions */
   BEGIN
      j = j + 1;
   END;

   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.Object = P.Object,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.Job = P.Job,        
          :CurObject.Status = P.Status,			      
          :CurObject.EnterBy = P.EnterBy,
          :CurObject.NYISONotified = P.NYISONotified,
          :CurObject.NYPANotified = P.NYPANotified
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

/*
** check if the substation is enabled for Operating Order.
*/ 
   IF IssuedBy = 'ONLINE' THEN      
      /*
      ** When the iswp is issued for a circuit that does not have a tls card, the permit's status
      ** will be changed "DO Conditional" so that it is passed to DO where DO will create a card 
      ** and issued.
      */
      IF CurObject.ObjectType = Type$TelCircuit THEN
         CurObject.GetTLSCard();
         IF CurObject.Card = 0 THEN
               CurObject.PrevStatus = 0;
               CurObject.Status = ISPStatus$Submitted; 
               CurObject.UpdateStatus();

               RetCode = CALLPROC SOA_ISPLogIns(
                                       ISPermit = CurObject.ISPermit, 
                                       LogTime = DATE('NOW'),
                                       LogUpdateBy = CurObject.LastUpdateBy, 
                                       LogItem = 'Update Reason',
                                       LogText = 'Status set to DO Conditional. No TLS card exists when permit is issued',
                                       LogType = 0); // TO and DO only
               CALLPROC DDB_COMMIT;
               RETURN;
         ENDIF;
      ENDIF;

      /*
      ** insert the permit move into the card.
      */
      RetCode = CurObject.InsertMove();
      IF RetCode = PU_CANCEL THEN
         RETURN;
      ENDIF;

      /*
      ** set the status to DO Conditional so that DO can issue it verbally. 
      ** But insert the job to the card anyway.
      */
      IsSOOEnabled = CurObject.IsSOOEnabled();
      IF IsSOOEnabled = FALSE THEN
         CurObject.PrevStatus = 0;
         CurObject.Status = ISPStatus$Submitted; 
         CurObject.UpdateStatus();   

         RetCode = CALLPROC SOA_ISPLogIns(
                                       ISPermit = CurObject.ISPermit, 
                                       LogTime = DATE('NOW'),
                                       LogUpdateBy = CurObject.LastUpdateBy, 
                                       LogItem = 'Update Reason',
                                       LogText = 'Status set to DO Conditional. Electronic order to staiton not enabled',
                                       LogType = 0); // TO and DO only
         CALLPROC DDB_COMMIT;
         RETURN;
      ENDIF;      

   ELSEIF IssuedBy = 'SUMMARY' THEN
      IF CurObject.Jurisdiction = 'DO' THEN
         IsSOOEnabled = CurObject.IsSOOEnabled();
         IF IsSOOEnabled = FALSE THEN
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Only DO Verbal Orders may be sent to this station...it is not enabled for electronic communication';
            RETURN;
         ENDIF;
      ENDIF;

      /*
      ** insert the permit move into the card.
      */
      RetCode = CurObject.InsertMove();
      IF RetCode = PU_CANCEL THEN
         RETURN;
      ENDIF;
   ENDIF;

/*
** Set status appropriately based on existence of conditional moves.
*/          
   IF CurObject.CL.LastRow() > 0 THEN
      CurObject.PrevStatus = 0;
      CurObject.Status = ISPStatus$Submitted; 
      CurObject.UpdateStatus();   
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;

   ELSE
      CurObject.PrevStatus = 0;
      CurObject.Status = ISPStatus$Issued;
      CurObject.UpdateStatus();
      IF CurObject.ReturnCode < 0 THEN
         RETURN;
      ENDIF;

      IF IssuedBy = 'ONLINE' OR IssuedBy = 'SUMMARY' THEN
         CurObject.CreateOrder(FieldOperator = FieldOperator);
      ELSEIF CurObject.SODenyReason = 'Manually Issued' THEN
/*
** Set Report Time when Denied unless Operator Jurisdiction
*/
            RetCode = CALLPROC SOA_ISPReportTimeUpd(
                       ISPermit = CurObject.ISPermit,
                       ReportTime = DATE('NOW'));
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'InServicePermitClass.IssuePermit; Error in processing In Service Permit request';
               CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to set report time for verbal permit issue.');
               RETURN;
            ENDIF;
            CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   IF CurObject.Status = ISPStatus$Issued THEN
      IF CurObject.NYISONotified = 1 THEN
         /*
         ** if NYISO notification is required, send an email to a distribution list
         */
         CurObject.SendNYISOEmail(EmailType = 'APPROVED');
      ENDIF;
      
      IF CurObject.WorkGroup = 'PST' AND
         CurObject.ObjectType = Type$UnitSubstation AND
         (CurObject.Division = Division$Bronx OR CurObject.Division = Division$Westchester) THEN
         /*
         ** Send a notification message to RCC Shift Manager 
         */
         MsgText = 'In-Service Work Permit issued by DO to PST for relay calibrations at ' +
            CurObject.SubstationName + ' Unit S/S';
         IF CurObject.ShiftStartTime <> '' THEN
            MsgText = MsgText + ' on ' + FormatDate(RawDate = CurObject.ShiftStartTime, Format = 'DEFAULT');
         ENDIF;
         
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_wx'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));         
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.IssuePermit; ' + 
                    'Unable to notify RCC Shift Manager of unit substation ISWP');
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
   ENDIF; 
END;

METHOD InsertMove (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipObject = INTEGER NOT NULL;
   EquipClassName = VARCHAR(40) NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   NewItem = SwitchingItem;                /*New Item Reference */
   NewMove = Job;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TLSMove = TLSJob;
ENDDECLARE
BEGIN
   CurObject.RSMove = '';
   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.Object = P.Object,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.Division = P.Division, 
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.Job = P.Job,        
          :CurObject.JobClass = P.JobClass,        
          :CurObject.PermitMove = SQUEEZE(LEFT(JC.TOMove, LOCATE(JC.TOMove,':')) + ' ' + P.PermitMove),	
          :CurObject.RSMove = SQUEEZE(LEFT(JC.RSMove, LOCATE(JC.RSMove,':')) + ' ' + P.PermitMove),        // For adding move to card
          :CurObject.Status = P.Status,			      
          :CurObject.StatusTime = P.StatusTime	    
   FROM   SOA_InServicePermit P,
          FMS_JobClass JC,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.JobClass = JC.JobClass AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Application = Application$SLC THEN
/*
** Does the SLC card have an active In Service Permit Switching Item.
*/
      CurObject.Card = 0;
      SELECT :CurObject.Card = Card
      FROM   SOA_ActiveObject 
      WHERE  Object = :CurObject.Substation AND
             ObjectToCardLink = 1;

      IF CurObject.Card = 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Invalid Substation - No related Substation Log Card';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; ' + 
                 'No SLC Card for Substation Object ' + VARCHAR(:CurObject.Substation));
         RETURN PU_CANCEL;
      ENDIF;
/*
** check if job is already in the table - SHOULD NOT, but just in case.
*/
      i = 0;
      SELECT :i = 1
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Job = :CurObject.Job AND
             JC.Card = :CurObject.Card AND
             JC.Job = J.Job;
      IF i = 1 THEN
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; Job ' + 
                  VARCHAR(CurObject.Job) + ' is already in the soa_job table');
         RETURN PU_OK;
      ENDIF;
/*
** Get deskname using division
*/
      CurObject.DeskName = '';
      REPEATED 
      SELECT  :CurObject.DeskName = O.Name
      FROM    Udb_Object O,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.Division AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = :Type$OperatorDesk AND
              G.Grouping = O.Object;
/*
** Get primary equipment for display on Job.
*/
      EquipName = '';
      EquipClassName = '';
      EquipObject = 0;
      SELECT  :EquipName = Name,
              :EquipObject = Object
      FROM    IR_OpOrderFeeders 
      WHERE   ISPermit = :CurObject.ISPermit AND
              PrimaryEquip = 1;

      IF EquipObject <> 0 THEN  /*Get real equip type and name */
         SELECT  :EquipName = Name,
                 :EquipClassName = TypeName
         FROM    Udb_Object 
         WHERE   Object = :EquipObject;
      ENDIF;
            
      CurObject.SwitchingItem = 0;
      REPEATED
      SELECT :CurObject.SwitchingItem = IFNULL(MAX(JC.SwitchingItem),0)
      FROM   SOA_JobControl JC,
             SOA_Job J
      WHERE  JC.Card = :CurObject.Card AND
             JC.SwitchingItem = JC.Job AND
             JC.Job = J.Job AND 
             J.SwItemStatus = :Card$Active AND
             J.MoveCategory = :MoveCategory$InServiceWP;

      IF CurObject.SwitchingItem = 0 THEN
/*
** Must Insert and Activate In Service Permit Sw Item
*/
         NewItem.ShadowLink = 0;
         NewItem.Job = 0;                    
         NewItem.TOMove = 'In-Service Work Permits';
         NewItem.Category = 0;
         NewItem.Severity = 0;
         NewItem.Description = 'In-Service Work Permits';
         NewItem.CardClass = Type$SLCSchd;
         NewItem.CardClassName = 'SCHD';  /* for download to SSO */
         NewItem.SwitchingItem = NewItem.Job;
         NewItem.TOComplete = '';
         NewItem.RSIssued = '';
         NewItem.SwItemStatus = Card$Active;
         NewItem.TOIssued = DATE('now');
         NewItem.Response = 'Active';
         NewItem.JobClass = 0;
         NewItem.Status = '';
         NewItem.Equip = 0;
         NewItem.EquipClass = 0;
         NewItem.EquipClassName = '';
         NewItem.EquipName = '';        
         NewItem.MoveCategory = MoveCategory$InServiceWP;
            
         RetCode = NewItem.InsertItem (Card = CurObject.Card);

         IF RetCode = PU_OK THEN
            CALLPROC DDB_COMMIT;

            CurObject.SwitchingItem = NewItem.Job;
            MsgText = VARCHAR(CurObject.Card) + ';' + VARCHAR(CurObject.SwitchingItem) + ';';
            CALLPROC InsertDBEventQueue(
                  ToApp = 'SOO',
                  EventName = 'IR_TOMSActivateCard',
                  EventText = MsgText);
         ELSE
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to insert new In-Service Work Permit item';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; ' + 
                 'Not able to insert new In-Service Work Permit item for Substation ' + 
                 VARCHAR(:CurObject.Substation));
            RETURN PU_CANCEL;
         ENDIF;
      ENDIF;
/*
** Now insert move.  Step Headings should be taken care of by the methods.
** The EquipClass is not important for Job Checks/Actions, but we need a valid one for the 
** step heading. 
*/
      NewMove = NULL;
      NewMove = Job.Create();

      NewMove.EquipClass = 0;
      SELECT  :NewMove.EquipClass = JCC.EquipClass
      FROM    FMS_JobClassControl JCC,
              IR_WorkingGroup WG
      WHERE   JCC.JobClass = :CurObject.JobClass AND
              JCC.TypeOfCard = :TypeOfCard$SLC AND
              JCC.StepPair = :StepHeading$WorkPermit AND
              JCC.JobClass = WG.JobClass;

      NewMove.Card = CurObject.Card;
      NewMove.Job = CurObject.Job;
      NewMove.JobClass = CurObject.JobClass;
      NewMove.Equip = 0;
      NewMove.EquipName = EquipName;
      NewMove.EquipClassName = EquipClassName;
      NewMove.Grounds = NULL;
      NewMove.GroundOn = NULL;
      NewMove.StepPair = StepHeading$WorkPermit;
      NewMove.Substation = CurObject.Substation;
      NewMove.DeskName = CurObject.DeskName;
      NewMove.ControlCard = CurObject.Card;
      IF CurObject.Jurisdiction = 'DV' THEN
         NewMove.TOMove = VARCHAR(CurObject.VerbalID) + ' - ' + CurObject.PermitMove;
         NewMove.RSMove = VARCHAR(CurObject.VerbalID) + ' - ' + CurObject.RSMove;
      ELSE
         NewMove.TOMove = VARCHAR(CurObject.Job) + ' - ' + CurObject.PermitMove;
         NewMove.RSMove = VARCHAR(CurObject.Job) + ' - ' + CurObject.RSMove;            
      ENDIF;
      NewMove.SwitchingItem = CurObject.SwitchingItem;
      NewMove.PrintId = '';
         
      RetCode = NewMove.InsertMove (CardTypeOfCard = TypeOfCard$SLC, 
                                    KeepMoveText = TRUE,
                                    KeepJobID = TRUE);

      IF RetCode > 0 THEN
         CALLPROC DDB_COMMIT;
      ELSE
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Not able to insert new In-Service Work Permit move';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.IssuePermit ; ' + 
                'Not able to insert new In-Service Work Permit move for Permit ' + 
                 VARCHAR(:CurObject.Job));
         RETURN PU_CANCEL;
      ENDIF;
   ELSEIF CurObject.Application = Application$TLS THEN  
/* -------------------------------------------------------------------
** TLS Permit 
** -------------------------------------------------------------------
*/
      /*
      ** Check to see if a card already exists for a related circuit...
      */
      CurObject.GetTLSCard();

      IF CurObject.Card = 0 THEN
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'No active TLS card for circuit ' + CurObject.ObjectName;
           CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; ' + 
              'No active TLS card for circuit: ' + CurObject.ObjectName);
           RETURN PU_CANCEL;
      ENDIF;

/*
** check if job is already in the table - SHOULD NOT, but just in case.
*/
      i = 0;
      SELECT :i = 1
      FROM   TC_Job
      WHERE  Job = :CurObject.Job AND
             Card = :CurObject.Card;
      IF i = 1 THEN
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; Job ' + 
                  VARCHAR(CurObject.Job) + ' is already in the tc_job table');
         RETURN PU_OK;
      ENDIF;

      IF CurObject.Jurisdiction = 'DV' THEN       /* DO Verbal */
         TLSMove.TOOperator = FO.Object;
         TLSMove.TOIssued = 'now';
      ELSEIF CurObject.Jurisdiction = 'DO' THEN   /* DO Operating Order */
         TLSMove.TOIssued = 'now';
         TLSMove.TOOperator = Operator$OpOrder;
      ELSE                                        /* Intend for TO */ 
         TLSMove.TOIssued = NULL;
         TLSMove.TOOperator = NULL;
      ENDIF;

      TLSMove.TOMove = CurObject.PermitMove;
      TLSMove.RSMove = CurObject.RSMove;

      SELECT  :TLSMove.CircuitClass = Type,
              :TLSMove.CircuitClassName = TypeName
      FROM    Udb_Object
      WHERE   Object = :CurObject.Object;
      
      SELECT  :TLSMove.Seq = MAX(Seq) + 1000
      FROM    TC_Job
      WHERE   Card = :CurObject.Card AND
              StepPair = :StepHeading$TLS_ISWP;
   /*  
   **  Load it into the database and update the object key in the array.
   */
      RetCode = CALLPROC TC_InsertJob
          (Job             = CurObject.Job,   
           JobClass        = CurObject.JobClass,
           JobClassSeq     = 0,                   /* Not Important */
           Card            = CurObject.Card,
           Seq             = TLSMove.Seq, 
           Circuit         = CurObject.Object,
           CircuitClass    = TLSMove.CircuitClass,
           CircuitClassName = TLSMove.CircuitClassName,
           Linenumber      = CurObject.ObjectName,
           Substation      = CurObject.Substation,
           SubstationName  = CurObject.SubstationName,
           StepPair        = StepHeading$TLS_ISWP,
           MoveType        = '',
           TOMove          = TLSMove.TOMove,
           TOStep          = 0,
           TOOperator      = TLSMove.TOOperator,
           TOIssued        = TLSMove.TOIssued,
           TOComplete      = '',
           RSMove          = TLSMove.RSMove,
           RSStep          = 0,
           RSOperator      = NULL,
           RSIssued        = '',
           RSComplete      = NULL,
           TOMoveRules     = MoveRule$Issue,
           RSMoveRules     = MoveRule$Complete,
           Results         = ''
           );    

      IF RetCode < 0 THEN     /* Error Occurred */
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'Error while inserting New In-Service Permit Move.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertMove; ' + 
             'Error while inserting New In-Service Permit Move. Job: ' + VARCHAR(:CurObject.Job));
         RETURN PU_CANCEL;
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   RETURN PU_OK;
END;

METHOD CreateOrder (
   FieldOperator = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
 
   ControlText = VARCHAR(256) NOT NULL WITH DEFAULT;
   IssueTime = DATE NOT NULL WITH DEFAULT;
   MsgKey = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   NotifySSO = INTEGER NOT NULL WITH DEFAULT;
   OperatorName = VARCHAR(40) NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL;
   OpOrderSubstation = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   OperatorName = '';
   SELECT  :OperatorName = Description
   FROM    Udb_Object 
   WHERE   Object = :CurObject.EnterBy;
       
   IF iirowcount = 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'Validation problem - Invalid Operator in EnterBy.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
            'Validation problem - Invalid Operator in EnterBy for Permit ' + 
            VARCHAR(:CurObject.Job));
       RETURN PU_CANCEL;
   ENDIF;

   IF CurObject.Application = Application$SLC THEN
      IF CurObject.SwitchingItem = 0 THEN
         /* this should not happen: this permit is already in an operating order. Skip it 
         */
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + ': In-Server Work Permit ' + VARCHAR(CurObject.ISPermit) + 
                     ' has been issued in an Operating Order. This order is skipped.');
         RETURN PU_OK;
      ENDIF;      
      
/*
** Now create and issue Operating Order
** The following code has been copied from Generate Operating Order
** Only create the order if not issuing verbally.
*/
      IssueTime = DATE('now');
      IF FieldOperator = 0 THEN
         FieldOperator = Operator$OpOrder;

         OrderNumber = 0;
         OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
         IF (OrderNumber <= 0) THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to get next Order number.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
               'Not able to get next Operating Order number for Permit ' + 
               VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
              
         /* Check if there is a macro or hybrid station for the permit 
         */
         OpOrderSubstation = 0;
         SELECT :OpOrderSubstation = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :CurObject.Substation AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$MacroSubstation;
              
         IF OpOrderSubstation = 0 THEN
            SELECT :OpOrderSubstation = G.Grouping
            FROM   Udb_Grouping G
            WHERE  G.Member = :CurObject.Substation AND
                   G.Relationship = :Interaction$ShareControlRoom AND
                   G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                      WHERE  SuperType = :Type$Substation);

            IF OpOrderSubstation = 0 THEN
               OpOrderSubstation = CurObject.Substation;
            ENDIF;
         ENDIF;

         RetCode = CALLPROC IR_OperatingOrderIns (
                                   OrderNumber = OrderNumber,
                                   Application = Application$SLC,
                                   Card = CurObject.Card,
                                   SwitchingItem = CurObject.SwitchingItem,
                                   OrderStatus = Order$Opened,
                                   OrderTarget = 'TOMS',
                                   OrderComment = '',
                                   OrderType = 'WORK PERMIT',
                                   Substation = OpOrderSubstation,
                                   BusConfiguration = 0,
                                   IssuedByDO = OperatorName,
                                   ByDesk = CurObject.DeskName,
                                   IssueTime = IssueTime);
             
         IF RetCode < 0 THEN                            
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to insert new Operating Order.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
               'Not able to insert new Operating Order for Permit ' + 
               VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;

         RetCode = CALLPROC IR_InsertOpOrderJobs (
                                   OrderNumber = OrderNumber,
                                   Seq = 1,
                                   TORS = 0,
                                   Job = CurObject.Job);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to insert new Operating Order permit job.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
               'Not able to insert new Operating Order permit job for Permit ' + 
               VARCHAR(:CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;

         RetCode = CALLPROC IR_OpOrderFeedersUpd (
                                   OrderNumber = OrderNumber,
                                   ISPermit = CurObject.ISPermit);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to apply Operating Order number to equipment links.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
               'Not able to apply Operating Order number to equipment links for Permit ' + 
               VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
**  Issue the permit move, no outgoing message necessary, raise the dbevent to download.
*/
      RetCode = CALLPROC SOA_IssueMove(Job = CurObject.Job,
                               Issued = IssueTime,
                               Operator = FieldOperator,
                               Status = 'TO');
      IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Permit Order has been built but move was not issued.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
               'Permit Order has been built but move was not issued for Permit ' + 
               VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;

      IF FieldOperator = Operator$OpOrder THEN
         RetCode = CALLPROC SOA_LogIns (
                       Card              = CurObject.Card
                       , Job             = CurObject.Job
                       , SwitchingItem   = CurObject.SwitchingItem

                       , Time            = IssueTime
                       , UserName        = OperatorName
                       , Item            = 'ISWP Order Issued'
                       , Old             = 'For SSO at ' + CurObject.SubstationName
                       , New             = 'Order Number: ' + Varchar(OrderNumber));
         CALLPROC DDB_COMMIT;

         ControlText = varchar(ordernumber); 
         CALLPROC InsertDBEventQueue(
                ToApp = 'SOO',
                EventName = 'IR_NewOpOrder', 
                EventText = ControlText); 
              
         CurObject.SSO_Status = Order$Opened;
         CurObject.SSO_Status_Name = 'Opened';
      ELSE
         RetCode = CALLPROC SOA_LogIns (
                       Card              = CurObject.Card
                       , Job             = CurObject.Job
                       , SwitchingItem   = CurObject.SwitchingItem

                       , Time            = IssueTime
                       , UserName        = OperatorName
                       , Item            = 'ISWP Issued'
                       , Old             = 'Issued Verbally'
                       , New             = 'By DO');
         CALLPROC DDB_COMMIT;
      ENDIF;
   ELSEIF CurObject.Application = Application$TLS THEN
/* -------------------------------------------------------------------
** TLS Permit 
** -------------------------------------------------------------------
*/
      IF FieldOperator = 0 THEN
         FieldOperator = Operator$OpOrder;

         OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
         IF (OrderNumber < 0) THEN
             CALLPROC DDB_ROLLBACK;
             CurObject.ReturnCode = -1;
             CurObject.ErrorMessage = 'Not able to get next Order number.';
             CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
                     'Not able to get next Operating Order number for Permit ' + 
                     VARCHAR(CurObject.Job));
         ELSE
             CALLPROC DDB_COMMIT;
         ENDIF;

         RetCode = CALLPROC IR_TelephoneOrderIns (
                                              OrderNumber = OrderNumber,
                                              Card = CurObject.Card,
                                              Circuit = CurObject.Object,
                                              Substation = CurObject.Substation,
                                              OrderTarget = 'TLS',
                                              OrderType = 'WORK PERMIT',
                                              OrderStatus = Order$Opened,
                                              IssueComment = '',
                                              IssuedByDO = OperatorName,
                                              IssueTime = 'now');
                                             
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to insert new Operating Order.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
                     'Not able to insert new Operating Order for Permit ' + 
                     VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;

         RetCode = CALLPROC IR_TLSOrderJobIns (
                                              OrderNumber = OrderNumber,
                                              Seq = 1,
                                              TORS = 0,
                                              Job = CurObject.Job,
                                              Category = MoveCategory$NonTelco);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to insert new Operating Order permit job.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
                     'Not able to insert new Operating Order permit job for Permit ' + 
                     VARCHAR(:CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;

         RetCode = CALLPROC IR_OpOrderFeedersUpd (
                                   OrderNumber = OrderNumber,
                                   ISPermit = CurObject.ISPermit);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Not able to apply Operating Order number to equipment links.';
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
                  'Not able to apply Operating Order number to equipment links for Permit ' + 
                  VARCHAR(CurObject.Job));
            RETURN PU_CANCEL;
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

      RetCode = CALLPROC TC_IssueJob
         (Issued = 'now',
          Operator = FieldOperator,
          OperatorName = OperatorName,
          Organization = Default$Org,
          OrganizationName = Default$OrgName,
          Job = CurObject.Job,
          DuplicateSeq = 0,
          TORS = 0);

      IF (RetCode <> 0) THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Permit Order has been built but move was not issued.';
           CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
              'Permit Order has been built but move was not issued for Permit ' + 
              VARCHAR(CurObject.Job));
           RETURN PU_CANCEL;
      ENDIF;
      CALLPROC DDB_COMMIT;
      
      CALLPROC TC_LogChange (
              Card = CurObject.Card,
              Job = CurObject.Job,
              Item = 'TOIssued',
              Old = '',
              New = date('now'));
      CALLPROC DDB_COMMIT;

 
      IF CurObject.Jurisdiction = 'DV' THEN
   	 RETURN PU_OK;
      ENDIF;

/* ??? itc 253						
      MsgText = 'TLS Operating Order ' + varchar(ordernumber) + 
                ' has been created for ' + CurObject.SubstationName; 

      RetCode = CALLPROC IR_TLSOrderStatusUpd (
                        OrderNumber     = OrderNumber
                      , OrderStatus     = Order$Opened);

      IF (RetCode <> 0) THEN
           CALLPROC DDB_ROLLBACK;
           CurObject.ReturnCode = -1;
           CurObject.ErrorMessage = 'Permit Order issue failed.  Card move is issued with no order.';
           CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CreateOrder; ' + 
              'Permit Order issue failed.  Card move is issued with no order for Permit ' + 
              VARCHAR(:CurObject.Job));
           RETURN PU_CANCEL;
      ELSE
          CALLPROC DDB_COMMIT;
      ENDIF;
*/     
      RetCode = CALLPROC TC_LogInsert (
                      Card              = CurObject.Card
                      , Job             = CurObject.Job
                      , Time            = Date('now')
                      , Operator        = FieldOperator
                      , OperatorName    = OperatorName
                      , Item            = 'Generate Order'
                      , Old             = 'For SSO at ' + CurObject.SubstationName
                      , New             = 'Order Number: ' + Varchar(OrderNumber));

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
      ELSE   
         CALLPROC DDB_COMMIT;
      ENDIF; 
/*
** No outgoing order message.
*/
      ControlText = varchar(ordernumber);
      CALLPROC InsertDBEventQueue(
               ToApp = 'TLS',
               EventName = 'IR_TLSNewOrder', 
               EventText = ControlText);  
   ENDIF;                

   RETURN PU_OK;
END;

METHOD WithdrawIssuedISP(
   WithDrawnBy = INTEGER NOT NULL WITH DEFAULT;
   WithdrawReason = VARCHAR(20) NOT NULL WITH DEFAULT;
   NewISPStatus = INTEGER NOT NULL WITH DEFAULT;
   JobResponse = VARCHAR(20) NOT NULL WITH DEFAULT;
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   JobID = INTEGER NOT NULL WITH DEFAULT;  
   RetCode  = INTEGER NOT NULL WITH DEFAULT;  
ENDDECLARE
BEGIN
/*
** this method is called from TO to withdraw an submitted/issued permit. Or,
** DO processes incompletion of an ISWP permit on CompletePermit screen. 
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   SELECT :CurObject.Application = P.Application,
          :CurObject.NYISONotified = P.NYISONotified,
          :CurObject.NYPANotified = P.NYPANotified
   FROM   SOA_InServicePermit P
   WHERE  P.ISPermit = :CurObject.ISPermit;
/*
** Update permit move
*/
   IF CurObject.Application = Application$SLC THEN
      RetCode = CALLPROC SOA_JobTimeUpd(
                     Job = CurObject.Job,  
		     Response   = JobResponse, 
		     TOIssued   = '', 
		     TOComplete = '', 
		     RSIssued   = '', 
		     RSComplete = '');
   ELSEIF CurObject.Application = Application$TLS THEN
      RetCode = CALLPROC TC_JobTimeUpd(
                     Job = CurObject.Job,  
		     Results = JobResponse, 
		     TOIssued   = '', 
		     TOComplete = '', 
		     RSIssued   = '', 
		     RSComplete = '');
   ENDIF;

   IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.WithdrawIssuedISP ; ' + 
                    'Failed to gray out permit move: ' + 
                    VARCHAR(CurObject.Job));
   ELSE
       CALLPROC DDB_COMMIT;
   ENDIF;
/*
** update isp status to the passed-in new status
*/
   CurObject.PrevStatus = 0;
   CurObject.Status = NewISPStatus;
   CurObject.LastUpdateBy = WithDrawnBy;
   CurObject.SODenyReason = WithdrawReason;
   CurObject.UpdateStatus();

   IF CurObject.NYISONotified = 1 THEN
      CurObject.SendNYISOEmail(EmailType = 'PULLED');
   ENDIF;
   RETURN;
END;

METHOD WithdrawOpenISP(
   WithDrawnBy = INTEGER NOT NULL WITH DEFAULT;
   WithdrawReason = VARCHAR(200) NOT NULL WITH DEFAULT;
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   JobID = INTEGER NOT NULL WITH DEFAULT;  
   RetCode  = INTEGER NOT NULL WITH DEFAULT;  
   WithdrawResponse = VARCHAR(20) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** this method is called from DO's ISWP Summary to withdraw a pending permit from TO.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   
/*
** update isp status to open
*/
   CurObject.Status = ISPStatus$Open;
   CurObject.LastUpdateBy = WithDrawnBy;
   CurObject.SODenyReason = WithdrawReason;

   CurObject.UpdateStatus();

   RETURN;
END;

METHOD LoadISPLog (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';   

   SELECT :CurObject.Application = P.Application,
          :CurObject.CurrentStatus = P.CurrentStatus,			      
          :CurObject.Status = P.Status,	
          :CurObject.StatusTime = StatusTime, 		      
          :CurObject.Job = P.Job,			        
          :CurObject.CloseTime = P.CloseTime			        
    FROM  SOA_InServicePermit P
    WHERE ISPERMIT = :CurObject.ISPermit;
        
    i = 1;
    IF CurObject.LogFilter = 0 THEN
       SELECT :CurObject.LL[i].LogTime = L.LogTime,
              :CurObject.LL[i].LogUpdateByName = O.Description,
              :CurObject.LL[i].LogText = L.LogText
       FROM   SOA_ISPLog L,
              UDB_Object O
       WHERE  L.ISPermit = :CurObject.ISPermit AND
              L.LogUpdateby = O.Object AND
              L.LogType IN (0, 2)                            /* FOR TO and DO */
       ORDER BY LogTime
       BEGIN
          i = i + 1;
       END;
    ELSE
       SELECT :CurObject.LL[i].LogTime = L.LogTime,
              :CurObject.LL[i].LogUpdateByName = O.Description,
              :CurObject.LL[i].LogText = L.LogText
       FROM   SOA_ISPLog L,
              UDB_Object O
       WHERE  L.ISPermit = :CurObject.ISPermit AND
              L.LogUpdateby = O.Object AND
              L.LogType IN (1, 2)                            /* FOR Working Groups */
       ORDER BY LogTime
       BEGIN
          i = i + 1;
       END;
    ENDIF;
    CALLPROC DDB_COMMIT;

   RETURN;
END;

METHOD InsertRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
   CheckTime = DATE NOT NULL WITH DEFAULT;  
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.ISPermit = 0;
   CurObject.Job = 0;

   IF CurObject.Application = Application$SLC THEN
      CurObject.Job = CALLPROC SOA_JobLastKey;
   ELSEIF CurObject.Application = Application$TLS THEN
      CurObject.Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
   ELSEIF CurObject.Application = Application$DSO THEN
      // We don't need to create a job. So, any number GREATER THAN zero will do.
      CurObject.Job = 99;
   ENDIF;      

   IF CurObject.Job <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'InServicePermitClass.InsertRequest; Error generating next Job key';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.InsertRequest; ' + 
                'Error generating next Job key');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
      
   CurObject.ISPermit = CALLPROC SOA_InServicePermitIns(
                Division = CurObject.Division, 
                Substation = CurObject.Substation, 
                ObjectType = CurObject.ObjectType,
                Object = CurObject.Object,
                ObjectName = CurObject.ObjectName,
                Application = CurObject.Application, 
                JobClass = CurObject.JobClass,    
                WorkGroup = CurObject.WorkGroup, 
                PermitMove = '',			    
                PreIssued = 0,		    
                ShiftStartTime = '',
                NotifyWhenCompleted = 0,
                Compliance = 0,
                EnterTime = '',		    
                EnterBy = 0,
                CreatedBy = '',
                Jurisdiction = '',
                Status = CurObject.Status,			      
                Job = CurObject.Job);

   IF CurObject.ISPermit <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = CurObject.ISPermit;
      CurObject.ErrorMessage = 'InServicePermitClass.InsertRequest,; Error inserting In Service Permit';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.InsertRequest. ERROR: ' + 
                'Unable to insert In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** insert request information
*/
   CurObject.ReqInfo.ISPermit = CurObject.ISPermit;
   CurObject.ReqInfo.InsertRequest();
   CurObject.ReturnCode = CurObject.ReqInfo.ReturnCode;
   CurObject.ErrorMessage = CurObject.ReqInfo.ErrorMessage;

   RETURN;
END;

METHOD UpdateRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   OldStatus = INTEGER NOT NULL WITH DEFAULT;   
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.IsActionAllowed(UpdateByName = CurObject.ReqInfo.EnterByName) = FALSE THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You do not have permission to update this request';
      RETURN;
   ENDIF;

   CurObject.ReqInfo.ISPermit = CurObject.ISPermit;
   CurObject.ReqInfo.UpdateRequest();

   CurObject.ReturnCode = CurObject.ReqInfo.ReturnCode;
   CurObject.ErrorMessage = CurObject.ReqInfo.ErrorMessage;

   IF CurObject.ReturnCode <> 0 THEN
      RETURN;
   ENDIF;
	
   /* now the working group is allowed to edit and save a PENDING request.
   ** we need to change the status from PENDING to OPEN. 
   */
   IF CurObject.Status = ISPStatus$RequestPending THEN
      CurObject.LastUpdateBy = 0;
      CurObject.LastUpdatebyName = CurObject.ReqInfo.EnterByName;
      // Hardcoded reason. If changed, update db procedure SOA_ISPRequestStatusUpd too.
      CurObject.SODenyReason = 'UPDATE PENDING REQUEST';  
      CurObject.RescindRequest();
   ENDIF;

   RETURN;
END;

METHOD SubmitRequest(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   
   EmailClass = EmailNotificationClass DEFAULT NULL;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   CurObject.ReqInfo.ISPermit = CurObject.ISPermit;
   CurObject.ReqInfo.LoadDetail();

   IF CurObject.IsActionAllowed(UpdateByName = CurObject.LastUpdateByName) = FALSE THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You do not have permission to submit this request';
      RETURN;
   ENDIF;

   IF CurObject.Jurisdiction = 'LA' THEN  //Local Authorization
      CurObject.IssueLocalRequest();
      RETURN;
   ENDIF;

   SELECT :CurObject.Division = Division,
          :CurObject.WorkGroup = WorkGroup,
          :CurObject.ObjectType = ObjectType
   FROM   SOA_InServicePermit 
   WHERE  ISPermit = :CurObject.ISPermit;
   CALLPROC DDB_ROLLBACK;
   
   CurObject.EnterTime = Date('now');
   IF CurObject.WorkGroup = 'PST' AND
      CurObject.ObjectType = Type$UnitSubstation AND
      (CurObject.Division = Division$Bronx OR CurObject.Division = Division$Westchester) THEN
      CurObject.Status = ISPStatus$RequestToRCC;
   ELSE    
      CurObject.Status = ISPStatus$Request;
   ENDIF;
   CurObject.PermitMove = CurObject.ReqInfo.PermitMove;

   CurObject.PreIssued = 0;
   CurObject.ShiftStartTime = ''; 
   IF CurObject.ReqInfo.StartDate <> '' THEN
      CurObject.ShiftStartTime = CurObject.ReqInfo.StartDate;
      CurObject.PreIssued = 1;
   ENDIF;
  
   CurObject.Compliance = CurObject.ReqInfo.Compliance;
   
   RetCode = CALLPROC SOA_ISPRequestSubmit (
                ISPermit = CurObject.ISPermit,
                PermitMove = CurObject.PermitMove,			    
                PreIssued = CurObject.PreIssued,		    
                ShiftStartTime = CurObject.ShiftStartTime,
                Compliance = CurObject.Compliance,
                EnterTime = CurObject.EnterTime,		    
                Jurisdiction = CurObject.Jurisdiction,
                Status = CurObject.Status,
                SubmitByName = CurObject.LastUpdateByName);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'InServicePermitClass.SubmitRequest; Error in submitting In Service Permit request';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.SubmitRequest. ERROR: ' + 
                'Unable to submit In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** return new status
*/
   SELECT :CurObject.Substation = P.Substation,
          :CurObject.Object = P.Object,
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.ObjectName = P.ObjectName,
          :CurObject.CurrentStatus = P.CurrentStatus,
          :CurObject.ReqInfo.CurrentStatus = R.CurrentStatus
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE P.ISPermit = :CurObject.ISPermit AND
         R.ISPermit = P.ISPermit;
   CALLPROC DDB_ROLLBACK;
/*
** If the request is NOT Pre_Issued, notify DO or TO
*/
   IF CurObject.Jurisdiction = 'DO' THEN
      IF CurObject.PreIssued = 0 THEN
         RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = CurObject.Substation,
                                  SubstationName = 'ISWP Request',
                                  Msg = 'IN-SERVICE PERMIT REQUEST has been submitted by ' + 
                                        CurObject.LastUpdateByName + 
                                        HC_NEWLINE + HC_NEWLINE + 
                                        'Please review the In-Service Work Permit Summary and take action where necessary',
                                  FromOpName = CurObject.LastUpdateByName,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SLC',
                                  FromApp = 'ISP Online',
                                  Priority = 0
                                  );
         IF RetCode <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SubmitRequest ; ' + 
                    'Unable to send incoming message to DO for the request submitted by ' + 
                    CurObject.LastUpdateByName);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;
      /*
      ** Always send an incoming message to the Telephone Coordinator when
      ** a Substation Telephone Circuit request is submitted
      */
      IF CurObject.ObjectType = Type$TelCircuit THEN
         RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = 0,
                                  SubstationName = 'ISWP Request',
                                  Msg = 'IN-SERVICE PERMIT REQUEST has been submitted by ' + 
                                        CurObject.LastUpdateByName + ' for circuit ' + CurObject.ObjectName +
                                        HC_NEWLINE + HC_NEWLINE + 
                                        'Please review the In-Service Work Permit Summary and take action where necessary',
                                  FromOpName = CurObject.LastUpdateByName,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'TLS',
                                  FromApp = 'ISP Online',
                                  Priority = 0
                                  );
         IF RetCode <= 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SubmitRequest ; ' + 
                    'Unable to send incoming message to TC for the request submitted by ' + 
                    CurObject.LastUpdateByName);
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;
      ENDIF;

   ELSEIF CurObject.Jurisdiction = 'TO' THEN
         MsgText = 'New <a target="fms" href="<%type=to_isp&status=' + VARCHAR(ISPStatus$AllRequests) + '%>">' + 
                'Request</a> for In-Service Work Permit received from ' + CurObject.LastUpdateByName;

         RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SubmitRequest; ' + 
                'Error sending notification message to TO.');
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;      
   ELSEIF CurObject.Jurisdiction = 'SM' THEN
         MsgText = 'New <a target="fms" href="<%type=sm_isp&status=' + VARCHAR(ISPStatus$AllRequests) + '%>">' + 
                'Dielectric In-Service Work Permit Request</a> received from ' + CurObject.LastUpdateByName;

         RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SubmitRequest; ' + 
                'Error sending dielectric iswp notification message to SM.');
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;  
   ELSEIF CurObject.Jurisdiction = 'RC' THEN
      /* send an email to the BX/W Engineering Group (distribution list: “dl – BX/W Operational Engineering (Union/MGMT)”. 
      ** The email subject will be: “PST Relay Calibration Request”. The email body will include an HTML link to the 
      ** ISWP Detail screen. The email body text will read: 
      ** “PST is requesting to perform relay calibrations at Station Name - ### Unit S/S on DD/MM/YY @ 07:00. 
      **  Please analyze then click the link below to approve or deny the request.”
      */
      SELECT :CurObject.SubstationName = O.Description
      FROM   UDB_Object O
      WHERE  O.Object = :CurObject.Substation;
      CALLPROC DDB_ROLLBACK;

      IF EmailClass IS NULL THEN
         EmailClass = EmailNotificationClass.Create();
      ENDIF;

      EmailClass.EmailType = 14;                        // REQUEST TO RCC. See cas!EmailNotificationClass
      EmailClass.Sender = CurObject.LastUpdatebyName;
      EmailClass.Recipient = 'dl - BX/W Operational Engineering (Union/MGMT)';   
      EmailClass.Subject = 'Request for PST Relay Calibration at ' + CurObject.SubstationName; 
   
      MsgText = 'RequestID=' + VARCHAR(CurObject.ISPermit) + ';;' + 
                'TargetName=' + CurObject.SubstationName + ';;';
      IF CurObject.ReqInfo.StartDate = '' THEN                   
         MsgText = MsgText + 'SkedDate= ;;';
      ELSE
         MsgText = MsgText + 'SkedDate= on ' + FormatDate(RawDate = CurObject.ReqInfo.StartDate, Format = 'DEFAULT') + ';;';
      ENDIF;
      
      EmailClass.Template = 'ISWPRequestToRCC.html';                      
      EmailClass.Message1 = MsgText;
      EmailClass.Message2 = 'Request=' + CurObject.ReqInfo.PermitMove + ';;';
      EmailClass.InsertRequest();

      IF EmailClass.ReturnCode <> 0 THEN 
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.SubmitRequest. ERROR: ' + 
                'Unable to notify RCC of In Service Permit request.');
      ENDIF;
   ENDIF;

   /*
   ** When any new ISWP request of type "Transmission Feeder outside of Substation" is submitted, 
   ** notify the shift manager automatically
   */
   IF CurObject.ObjectType = 1 THEN
         MsgText = 'New <a target="fms" href="<%type=sm_isp&type=all&status=' + VARCHAR(ISPStatus$AllCurrent) + '%>">' + 
                'Trans. Fdr. outside of Substation In-Service Work Permit Request</a> - "' + CurObject.PermitMove + 
                '" at ' + CurObject.ObjectName + '" - was sent to T.O. from ' + CurObject.LastUpdateByName;

         RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.SubmitRequest; ' + 
                'Error sending Trans. Fdr. outside of Substation iswp request notification message to SM.');
         ELSE
            CALLPROC DDB_COMMIT;
         ENDIF;             
   ENDIF;

   RETURN;
END;

METHOD IssueLocalRequest(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */

   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipType = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipList = VARCHAR(200) NOT NULL WITH DEFAULT;
   EquipString = VARCHAR(40) NOT NULL WITH DEFAULT;
   Primary = INTEGER NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   OpOrderSubstation = INTEGER NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   ** check if the substation is SOO enabled
   */
   SELECT :CurObject.Substation = P.Substation,
          :CurObject.SubstationName = O.Description
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE P.ISPermit = :CurObject.ISPermit AND
         P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.IsSOOEnabled() = FALSE THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No electronic orders can be issued to substation ' + 
                CurObject.SubstationName + '. Contact substation directly.';
      RETURN;
   ENDIF;      

   /*
   ** Set request status to Local
   */
   CurObject.StatusTime = Date('Now');
   CurObject.Status = ISPStatus$Local;
   
   RetCode = CALLPROC SOA_ISPLocalRequest(
      ISPermit = CurObject.ISPermit,
      Status = CurObject.Status,
      StatusTime = CurObject.StatusTime,
      StatusUpdateBy = CurObject.LastUpdateBy,
      UpdateByName = CurObject.LastUpdateByName);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Error in setting request status';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.IssueLocalRequest. ERROR: ' + 
                'Unable to set request status.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
   /*
   ** Find the pseudo ISWP switching item
   */
   CurObject.Card = 0;
   SELECT :CurObject.Card = C.Card,
          :CurObject.SwitchingItem = C.LocalISWPItem
   FROM   SOA_ActiveObject A,
          SLC_Card C   
   WHERE  A.Object = :CurObject.Substation AND
          A.ObjectToCardLink = 1 AND
          A.Card = C.Card;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Card = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Invalid substation. No electronic orders can be issued to substation' + 
                CurObject.SubstationName;
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.IssueLocalRequest; ' + 
              'No SLC Card for Substation ' + CurObject.SubstationName);
      RETURN;
   ENDIF;    

   /* 
   ** create an operating order 
   */
   OrderNumber = 0;
   OrderNumber = CALLPROC Udb_NextKey(KeyName = 'OperatingOrder');
   IF (OrderNumber <= 0) THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Not able to get next Operating Order number';
      CurMethod.Trace(Text = varchar(date('now')) + ': InServicePermit.IssueLocalRequest; ' + 
         'Error: Not able to get next Operating Order number for ISWP request ' + 
         VARCHAR(CurObject.ISPermit));
      RETURN;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;
              
   /* Check if there is a macro or hybrid station for the permit 
   */
   OpOrderSubstation = 0;
   SELECT :OpOrderSubstation = G.Grouping
   FROM   Udb_Grouping G
   WHERE  G.Member = :CurObject.Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$MacroSubstation;
        
   IF OpOrderSubstation = 0 THEN
      SELECT :OpOrderSubstation = G.Grouping
      FROM   Udb_Grouping G
      WHERE  G.Member = :CurObject.Substation AND
             G.Relationship = :Interaction$ShareControlRoom AND
             G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                WHERE  SuperType = :Type$Substation);

      IF OpOrderSubstation = 0 THEN
         OpOrderSubstation = CurObject.Substation;
      ENDIF;
   ENDIF;

   RetCode = CALLPROC IR_OperatingOrderIns (
                             OrderNumber = OrderNumber,
                             Application = Application$SLC,
                             Card = CurObject.Card,
                             SwitchingItem = CurObject.SwitchingItem, 
                             OrderStatus = Order$Opened,
                             OrderTarget = 'TOMS',
                             OrderComment = 'Locally Authorized In-Service Work Permit',
                             OrderType = 'WORK PERMIT',
                             Substation = OpOrderSubstation,
                             BusConfiguration = 0,
                             IssuedByDO = CurObject.LastUpdateByName,
                             ByDesk = 'LA',		// this value is used in Receive App Server to identify this type of requests	
                             IssueTime = DATE('now'));
       
   IF RetCode < 0 THEN                            
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Not able to save new Operating Order in database.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.IssueLocalRequest; ' + 
         'Not able to insert new Operating Order for Permit ' + VARCHAR(CurObject.ISPermit));
      RETURN;
   ENDIF;

   /* use the MsgKey column to store ISWP Request ID 
   */  
   RetCode = CALLPROC IR_MsgKeyUpd (MsgKey = CurObject.ISPermit,
                                   OrderNumber = OrderNumber);
   IF Retcode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   /*
   ** issue request
   */
   MsgText = VARCHAR(OrderNumber);
   CALLPROC InsertDBEventQueue(
               ToApp = 'SOO',
               EventName = 'IR_IssueLocalISWP',
               EventText = MsgText);

/*
** return new status
*/
   SELECT :CurObject.CurrentStatus = P.CurrentStatus,
          :CurObject.Jurisdiction = P.Jurisdiction,
          :CurObject.ReqInfo.CurrentStatus = R.CurrentStatus
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE P.ISPermit = :CurObject.ISPermit AND
         R.ISPermit = P.ISPermit;
   CALLPROC DDB_ROLLBACK;
   
   RETURN;   
END;

METHOD ProcessRequest(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   IdxList = ARRAY OF INTEGEROBJECT;
   
   EmailClass = EmailNotificationClass DEFAULT NULL;
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipType = VARCHAR(40) NOT NULL WITH DEFAULT;
   EquipList = VARCHAR(200) NOT NULL WITH DEFAULT;
   EquipString = VARCHAR(40) NOT NULL WITH DEFAULT;
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT;
   OrigStatus = INTEGER NOT NULL WITH DEFAULT;
   Primary = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.Application = P.Application,
          :CurObject.Division = P.Division,
          :CurObject.Substation = P.Substation,
          :CurObject.Object = P.Object,			        
          :CurObject.ObjectType = P.ObjectType,
          :CurObject.WorkGroup = P.WorkGroup,
          :CurObject.PreIssued = P.PreIssued,
          :OrigStatus = P.Status
   FROM  SOA_InServicePermit P
   WHERE P.ISPermit = :CurObject.ISPermit;
   CALLPROC DDB_ROLLBACK;
      
   CurObject.ReqInfo.ISPermit = CurObject.ISPermit;
   CurObject.ReqInfo.LoadDetail();

   CurObject.EnterTime = Date('now');
   CurObject.EnterBy = CurObject.LastUpdateBy;

   /*
   ** If a request is being processed by RCC (LastUpdateBy = 0), make sure the request has not been 
   ** processed by other RCC. If it is already processed, return with an error
   */
   IF CurObject.WorkGroup = 'PST' AND
      CurObject.ObjectType = Type$UnitSubstation AND
      (CurObject.Division = Division$Bronx OR CurObject.Division = Division$Westchester) AND
      CurObject.LastUpdateByType = 'RCC' THEN 
      
      IF OrigStatus <> ISPStatus$RequestToRCC AND OrigStatus <> ISPStatus$RequestPending THEN
         CurObject.ReturnCode = -2;
         IF OrigStatus = ISPStatus$RequestDenied THEN
            CurObject.ErrorMessage = 'Request was already denied by ' + CurObject.ReqInfo.ProcessByName + 
               ' with reason - ' + CurObject.ReqInfo.Remark;
         ELSEIF OrigStatus = ISPStatus$RequestOpen THEN
            CurObject.ErrorMessage = 'Request was rescinded by ' + CurObject.ReqInfo.ProcessByName + 
               ' with reason - ' + CurObject.ReqInfo.Remark;
         ELSE
            CurObject.ErrorMessage = 'Request was already approved by RCC';
         ENDIF;
         RETURN;

      ELSEIF OrigStatus = ISPStatus$RequestPending AND CurObject.Status = ISPStatus$RequestPending THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Request was already set to Pending by ' + CurObject.ReqInfo.ProcessByName + 
               ' with reason - ' + CurObject.ReqInfo.Remark;
         RETURN;
      ENDIF;
   ENDIF;   
    
   IF CurObject.Status = ISPStatus$Local THEN  //Local Authorization
      CurObject.IssueLocalRequest();
      RETURN;

   ELSEIF CurObject.Status = ISPStatus$Request THEN	// request is passed between DO and TO or RCC approves the request
      IF CurObject.WorkGroup = 'PST' AND
         CurObject.ObjectType = Type$UnitSubstation AND
         (CurObject.Division = Division$Bronx OR CurObject.Division = Division$Westchester) AND
         CurObject.LastUpdateByType = 'RCC' THEN
         /* 
         ** The status is set to Request after RCC approves the request (old status is ISPStatus$RequestToRCC).
         */
         RetCode = CALLPROC SOA_ISPRequestStatusUpd(
                       ISPermit = CurObject.ISPermit,
                       Status = CurObject.Status,
                       StatusTime = DATE('NOW'),
                       StatusUpdateBy = CurObject.LastUpdateBy,
                       UpdateByName = CurObject.LastUpdatebyName,
                       DenyCategory = 0,
                       StatusReason = 'Approved');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error in processing In Service Permit request';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to approve In Service Permit request.');
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;         
      ELSE
         RetCode = CALLPROC SOA_ISPJurisdictionUpd(
                       ISPermit = CurObject.ISPermit,
                       Jurisdiction = CurObject.Jurisdiction,
                       UpdateTime = DATE('NOW'),		    
                       UpdateBy = CurObject.EnterBy);

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error in processing In Service Permit request';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to process In Service Permit request.');
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;
      
         IF OrigStatus <> ISPStatus$Request THEN
            /*
            ** we will set the status back to Request if TO/DO sends a pending request to each other.
            */
            CurObject.UpdateStatus();
         ENDIF;
      ENDIF;

      /*
      ** if the request is passed to DO from TO or approved by RCC, send an incoming message to DO
      */
      IF CurObject.Jurisdiction = 'DO' THEN
         IF CurObject.PreIssued = 0 THEN
            RetCode = CALLPROC MSG_SendMsg (Card = 0,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = CurObject.Substation,
                                  SubstationName = 'ISWP Request',
                                  Msg = 'IN-SERVICE PERMIT REQUEST has been submitted by ' + 
                                        CurObject.ReqInfo.EnterByName + 
                                        HC_NEWLINE + HC_NEWLINE + 
                                        'Please review the In-Service Work Permit Summary and take action where necessary',
                                  FromOpName = CurObject.ReqInfo.EnterByName,
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'SLC',
                                  FromApp = 'ISP Online',
                                  Priority = 0
                                  );
            IF RetCode <= 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.ProcessRequest; ' + 
                    'Unable to send incoming message to DO for the request submitted by ' + 
                    CurObject.ReqInfo.EnterByName);
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;
         ENDIF;
      ELSE
            MsgText = 'New <a target="fms" href="<%type=to_isp&status=' + VARCHAR(ISPStatus$AllRequests) + '%>">' + 
                'Request</a> for In-Service Work Permit received from ' + CurObject.ReqInfo.EnterByName;

            RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MsgText 
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.ProcessRequest; ' + 
                               'Error sending notification message to TO.');
            ELSE
               CALLPROC DDB_COMMIT;
            ENDIF;      
      ENDIF;

   ELSE /* ACK, PENDING OR DENIED */
      IF CurObject.Status = ISPStatus$Open THEN			// Accept Request 
         IF CurObject.ObjectType = Type$UnitSubstation THEN
            /*
            ** after DO acknowledges a unit substation ISWP request, set the jurisdiction to 
            ** DO/Verbal so that DO can issue the permit on the summary screen right away.
            */
            CurObject.Jurisdiction = 'DV';
         ENDIF;

         RetCode = CALLPROC SOA_ISPRequestAccept(
                   ISPermit = CurObject.ISPermit,
                   EnterTime = CurObject.EnterTime,		    
                   EnterBy = CurObject.EnterBy,
                   CreatedBy = CurObject.CreatedBy,
                   Jurisdiction = CurObject.Jurisdiction,
                   Status = CurObject.Status);

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error in processing In Service Permit request';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to acknowledge In Service Permit request.');
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;

      ELSEIF CurObject.Status = ISPStatus$RequestPending OR	// Deny or Pending
             CurObject.Status = ISPStatus$RequestDenied THEN
         RetCode = CALLPROC SOA_ISPRequestStatusUpd(
                       ISPermit = CurObject.ISPermit,
                       Status = CurObject.Status,
                       StatusTime = DATE('NOW'),
                       StatusUpdateBy = CurObject.LastUpdateBy,
                       UpdateByName = CurObject.LastUpdatebyName,
                       DenyCategory = CurObject.DenyCategory,
                       StatusReason = CurObject.SODenyReason);
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error in processing In Service Permit request';
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to deny/pend In Service Permit request.');
            RETURN;
         ENDIF;
/*
** Set Report Time when Denied unless Operator Jurisdiction
*/
         IF CurObject.Status = ISPStatus$RequestDenied AND 
            CurObject.DenyCategory <> ISPReqDeny$OpJurisdiction THEN

            RetCode = CALLPROC SOA_ISPReportTimeUpd(
                       ISPermit = CurObject.ISPermit,
                       ReportTime = DATE('NOW'));
            IF RetCode < 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error in processing In Service Permit request';
               CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to set report time for denial of Service Permit request.');
               RETURN;
            ENDIF;
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;

      /*
      ** Send email to the working group that the request is acknowledged, pending or denied.
      */
      IF SQUEEZE(CurObject.ReqInfo.Email) <> '' THEN
         SELECT :CurObject.ObjectType = P.ObjectType,
                :CurObject.ObjectName = P.ObjectName,
                :CurObject.SubstationName = O.Name
         FROM   SOA_InServicePermit P,
                Udb_Object O
         WHERE  P.ISPermit = :CurObject.ISPermit AND
                P.Substation = O.Object;
         CALLPROC DDB_ROLLBACK;

         IF EmailClass IS NULL THEN
            EmailClass = EmailNotificationClass.Create();
         ENDIF;

         EmailClass.EmailType = 6;                        // denied or pending ISP request. See ECC_EmailService
         EmailClass.Sender = CurObject.LastUpdatebyName;
         EmailClass.Recipient = CurObject.ReqInfo.Email;
      
         IF Type$Dielectric = CurObject.ObjectType THEN
            EmailClass.Subject = 'Dielectric In-Service Work Permit request for ' + CurObject.SubstationName; 
         ELSEIF Type$Substation = CurObject.ObjectType OR Type$UnitSubstation = CurObject.ObjectType THEN
            EmailClass.Subject = 'In-Service Work Permit request for ' + CurObject.SubstationName + ' substation'; 
         ELSEIF Type$Feeder = CurObject.ObjectType THEN
            EmailClass.Subject = 'In-Service Work Permit request for feeder ' + CurObject.ObjectName; 
         ELSEIF Type$TelCircuit = CurObject.ObjectType THEN
            EmailClass.Subject = 'In-Service Work Permit request for circuit ' + CurObject.ObjectName; 
         ELSE
            EmailClass.Subject = 'In-Service Work Permit request for ' + CurObject.ObjectName; 
         ENDIF;

         IF CurObject.Status = ISPStatus$Open THEN
            EmailClass.Subject = EmailClass.Subject + ' is ACKNOWLEDGED'; 
         ELSEIF CurObject.Status = ISPStatus$RequestDenied THEN
            EmailClass.Subject = EmailClass.Subject + ' is DENIED'; 
         ELSE
            EmailClass.Subject = EmailClass.Subject + ' is set to PENDING'; 
         ENDIF;
      
         IF Type$Dielectric = CurObject.ObjectType THEN
            MsgText = 'TargetName=' + CurObject.SubstationName + ';;';
         ELSEIF Type$Substation = CurObject.ObjectType OR Type$UnitSubstation = CurObject.ObjectType THEN
            MsgText = 'TargetName=' + CurObject.SubstationName + ' substation;;';
         ELSEIF Type$Feeder = CurObject.ObjectType THEN
            MsgText = 'TargetName=' + CurObject.ObjectName + ' feeder;;';
         ELSEIF Type$TelCircuit = CurObject.ObjectType THEN
            MsgText = 'TargetName=' + CurObject.ObjectName + ' circuit;;';
         ELSE
            MsgText = 'TargetName=' + CurObject.ObjectName + ';;';
         ENDIF;
         MsgText = MsgText + 
                   'Operator=' + CurObject.LastUpdatebyName + ';;' + 
                   'Equip=' + CurObject.ReqInfo.Equipment + ';;';
            
         IF CurObject.Status = ISPStatus$Open THEN
            MsgText = MsgText + 'Status=ACKNOWLEDGED;;'; 
            EmailClass.Template = 'ISWPRequestAcked.html';                      
         ELSEIF CurObject.Status = ISPStatus$RequestDenied THEN
            MsgText = MsgText + 'Status=DENIED;;'; 
            EmailClass.Template = 'ISWPRequestDenied.html';                      
         ELSE
            MsgText = MsgText + 'Status=set to PENDING;;'; 
            EmailClass.Template = 'ISWPRequestDenied.html';                      
         ENDIF;
         EmailClass.Message1 = MsgText;
         EmailClass.Message2 = 'Request=' + CurObject.ReqInfo.PermitMove + ';;' + 
                                'Reason=' + CurObject.SODenyReason+ ';;';
         EmailClass.InsertRequest();

         IF EmailClass.ReturnCode <> 0 THEN 
            CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                   'Unable to notify work group of denied/pending In Service Permit request.');
         ENDIF;
      ENDIF;
   ENDIF;

/*
** insert permit equipment
*/
   IF CurObject.Status = ISPStatus$Open THEN
      IF CurObject.ObjectType = Type$TelCircuit THEN
         CurObject.BuildCktEquipList();

         FOR i = 1 TO CurObject.EL.LastRow() DO
             RetCode = CALLPROC IR_OpOrderFeedersIns(
                    OrderNumber = 0,
                    ISPermit = CurObject.ISPermit,
                    Object = CurObject.EL[i].Object,
                    Name = CurObject.EL[i].Name,
                    TypeName = CurObject.EL[i].TypeName,
                    PrimaryEquip = CurObject.EL[i].PrimaryEquip);
                    
             IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                CurObject.ReturnCode = RetCode;
                CurObject.ErrorMessage = 'InServicePermitClass.ProcessRequest; Error inserting ISP Equipment';
                CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.ProcessRequest. ERROR: ' + 
                               'Unable to insert ISP Equipment.');
             ENDIF;
         ENDFOR;
         CALLPROC DDB_COMMIT;

      ELSE
         Primary = 1;
         EquipList = SQUEEZE(CurObject.ReqInfo.Equipment);

         WHILE EquipList <> '' DO   
			IdxList[1].Value = locate(EquipList, ' - ');
			IdxList[2].Value = locate(EquipList, ';');
			IdxList[3].Value = locate(EquipList, ',');
			
			i = IdxList[1].Value;
			IdxList.Sort(Value = AS_ASC);
			k = IdxList[1].Value;
	 
			IF k = (size(EquipList) + 1) THEN        
			   EquipString = EquipList;
			   EquipList = '';		
			ELSE                                      
			   EquipString = left(EquipList, k-1);
			   
			   IF i = k then
				  EquipList = SHIFT(EquipList, -1 * (k+2));
			   ELSE 
				  EquipList = SHIFT(EquipList, -1 * k);
			   ENDIF;
			ENDIF;
         /*
            k = locate(EquipList, ';');
            IF k = (size(EquipList) + 1) THEN        /* ';' not found *
               k = locate(EquipList, ',');

               IF k = (size(EquipList) + 1) THEN        /* ',' not found *
                  EquipString = EquipList;
                  EquipList = '';
               ELSE                                     
                  EquipString = left(EquipList, k-1);
                  EquipList = SHIFT(EquipList, -1 * k);
               ENDIF;
            ELSE                                     
               EquipString = left(EquipList, k-1);
               EquipList = SHIFT(EquipList, -1 * k);
            ENDIF;
        */    
            EquipString = SQUEEZE(EquipString);
            IF EquipString <> '' THEN
               /* parse equip type and name 
               */
               IF CurObject.ObjectType = Type$Substation OR 
                  CurObject.ObjectType = Type$UnitSubstation OR 
                  CurObject.ObjectType = Type$Feeder THEN		
                  k = locate(EquipString, ' ');
                  IF k = (size(EquipString) + 1) THEN        /* ' '(space) not found */
                     EquipType = '';
                     EquipName = EquipString;
                  ELSE
                     EquipType = LEFT(EquipString, k-1);
                     EquipName = SHIFT(EquipString, -1 * k);
                  ENDIF;
               ELSE
                  EquipType = '';
                  EquipName = EquipString;                  
               ENDIF;
   /*
   ** Duplicate prevention check
   */
               IF Primary = 0 THEN
                  k = 0;
                  SELECT :k = 1
                  FROM   IR_OpOrderFeeders
                  WHERE  OrderNumber = 0 AND
                         ISPermit = :CurObject.ISPermit AND
                         Object = 0 AND
                         Name = :EquipName;
                  
                  IF k = 1 THEN
                     /* Skip this one */
                     CONTINUE;
                  ENDIF;
               ENDIF;

               RetCode = CALLPROC IR_OpOrderFeedersIns(
                          OrderNumber = 0,
                          ISPermit = CurObject.ISPermit,
                          Object = 0,
                          Name = EquipName,
                          TypeName = EquipType,
                          PrimaryEquip = Primary);
                          
               IF RetCode < 0 THEN
                  CALLPROC DDB_ROLLBACK;
                  CurMethod.Trace(Text = varchar(date('now')) + 'InServicePermitClass.SubmitRequest; ERROR: ' + 
                        'Unable to save ISP Equipment.');
               ENDIF;
               CALLPROC DDB_COMMIT;

               Primary = 0;
            ENDIF;
         ENDWHILE;
      ENDIF;

      /*
      ** insert work Permit in case TO/DO accepts the request without modifying it.
      */
      SELECT :CurObject.Job = Job
      FROM   SOA_InServicePermit
      WHERE  ISPermit = :CurObject.ISPermit;

      IF CurObject.Application = Application$SLC THEN
         RetCode = CurObject.SOA_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);

      ELSEIF CurObject.Application = Application$TLS THEN

         SELECT :CurObject.TLS_WP.TOMove = SQUEEZE(LEFT(JC.TOMove, LOCATE(JC.TOMove,':')) + ' ' +
                          :CurObject.PermitMove),
                :CurObject.TLS_WP.RSMove = SQUEEZE(LEFT(JC.RSMove, LOCATE(JC.RSMove,':')) + ' ' +
                          :CurObject.PermitMove)
         FROM   FMS_JobClass JC 
         WHERE  JC.JobClass = :CurObject.JobClass;

         RetCode = CurObject.TLS_WP.UpdateWorkPermit(PermitJobID = CurObject.Job);
      ENDIF;
   ENDIF;
 
   SELECT :CurObject.CurrentStatus = P.CurrentStatus,
          :CurObject.ReqInfo.CurrentStatus = R.CurrentStatus
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE P.ISPermit = :CurObject.ISPermit AND
         R.ISPermit = P.ISPermit;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD DeleteRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';     

   IF CurObject.IsActionAllowed(UpdateByName = CurObject.LastUpdateByName) = FALSE THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You do not have permission to delete this request';
      RETURN;
   ENDIF;

/*
** delete in-service permit request
*/
   CurObject.ReqInfo.ISPermit = CurObject.ISPermit;
   CurObject.ReqInfo.DeleteRequest();

   CurObject.ReturnCode = CurObject.ReqInfo.ReturnCode;
   CurObject.ErrorMessage = CurObject.ReqInfo.ErrorMessage;
   IF CurObject.ReturnCode < 0 THEN
      RETURN;
   ENDIF;
/*
** delete in-service permit
*/
   RetCode = CALLPROC SOA_InServicePermitDel(
                ISPermit = CurObject.ISPermit);
 
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = CurObject.ISPermit;
      CurObject.ErrorMessage = 'InServicePermitClass.DeleteRequest; Error deleting In Service Permit';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.DeleteRequest. ERROR: ' + 
                'Unable to delete In Service Permit.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

METHOD CopyRequest (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = ''; 
/*
** check if the user wants to copy to the same object (substation, feeder or circuit). 
** The web page passes in -1 as the objecttype value if the user wants to copy
** to the same object.
*/  
   IF CurObject.ObjectType = -1 THEN
      SELECT :CurObject.Application = Application,
             :CurObject.Division = Division,
             :CurObject.Substation = Substation,
             :CurObject.ObjectType = ObjectType,
             :CurObject.Object = Object,
             :CurObject.ObjectName = ObjectName
      FROM   SOA_InServicePermit
      WHERE  ISPermit = :CurObject.ISPermit;
   ENDIF;
/*
** create a new job id
*/    
   IF CurObject.Application = Application$SLC THEN
      CurObject.Job = CALLPROC SOA_JobLastKey;
   ELSEIF CurObject.Application = Application$TLS THEN   
      CurObject.Job = CALLPROC TC_LastKeyUpd (TableName = 'tc_job');
   ELSEIF CurObject.Application = Application$DSO THEN 
      CurObject.Job = 99;  
   ENDIF;

   IF CurObject.Job <= 0 THEN
      CALLPROC DDB_COMMIT;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'InServicePermitClass.CopyRequest; Error generating next SOA_Job key';
      CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CopyRequest; ' + 
                'Error generating next SOA_Job key');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** copy in-service permit request
*/
   CurObject.Status = ISPStatus$RequestOpen;
   CurObject.EnterTime = DATE('NOW');

   RetCode = CALLPROC SOA_ISPRequestCopy(
                ISPermit = CurObject.ISPermit,
                NewJob = CurObject.Job,
                Application = CurObject.Application,
                Division = CurObject.Division,
                Substation = CurObject.Substation,
                ObjectType = CurObject.ObjectType,
                Object = CurObject.Object,
                ObjectName = CurObject.ObjectName,
                Status = CurObject.Status,
                EnterTime = CurObject.EnterTime,
                EnterBy = CurObject.EnterBy,
                EnterByName = CurObject.EnterByName,
                Email = CurObject.ReqInfo.Email);
 
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = CurObject.ISPermit;
      CurObject.ErrorMessage = 'InServicePermitClass.CopyRequest; Error copying In Service Permit Request';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.CopyRequest. ERROR: ' + 
                'Unable to copy In Service Permit Request.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   CurObject.ISPermit = RetCode;

   RETURN;
END;

METHOD RescindRequest(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   MsgText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   ProcessByName = VARCHAR(40) NOT NULL WITH DEFAULT; 
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.IsActionAllowed(UpdateByName = CurObject.LastUpdateByName) = FALSE THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'You do not have permission to rescind this request';
      RETURN;
   ENDIF;

/*
** make sure the request status is still "REQUEST" or "PENDING"
*/
   i = 0;
   SELECT :CurObject.Status = P.Status,
          :ProcessByName = R.ProcessByName 
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          R.ISPermit = P.ISPermit;

   IF CurObject.Status = ISPStatus$Request OR
      CurObject.Status = ISPStatus$RequestToRCC OR
      CurObject.Status = ISPStatus$RequestPending THEN
      /* OK */
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'The request has been processed by ' + ProcessByName + '. Please contact the operator';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.RescindRequest. ERROR: ' + 
                'Request status is not either REQUEST or PENDING.');
      RETURN;
   ENDIF;

   RetCode = CALLPROC SOA_ISPRequestStatusUpd(
                    ISPermit = CurObject.ISPermit,
                    Status = ISPStatus$RequestOpen,
                    StatusTime = DATE('NOW'),
                    StatusUpdateBy = CurObject.LastUpdateBy,
                    UpdateByName = CurObject.LastUpdatebyName,
                    StatusReason = CurObject.SODenyReason);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'InServicePermitClass.RescindRequest; Error in submitting In Service Permit request';
      CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.RescindRequest. ERROR: ' + 
                'Unable to rescind In Service Permit request.');
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** return new status
*/
   SELECT :CurObject.Status = P.Status,
          :CurObject.CurrentStatus = P.CurrentStatus,
          :CurObject.ReqInfo.CurrentStatus = R.CurrentStatus
   FROM   SOA_InServicePermit P,
          SOA_ISPermitRequest R
   WHERE P.ISPermit = :CurObject.ISPermit AND
         R.ISPermit = P.ISPermit;
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD GetTLSCard(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /*
   ** Check to see if a card already exists for a related circuit...
   ** (i.e. If this is a grouper, and there are cards for its' circuits OR
   **  this is a circuit and there is a card for the grouper.)
   */
   CurObject.Card = 0;

   SELECT  :CurObject.Card = Card
   FROM    TC_Card
   WHERE   Status < :TC_Card$Closed AND
           Circuit = :CurObject.Object;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Card > 0 THEN
      RETURN;
   ENDIF;

   SELECT :CurObject.Card = C.Card
   FROM   TC_Card C,
          Udb_Grouping G
   WHERE  (G.Grouping = :CurObject.Object AND
           G.Relationship = :Interaction$MemberOf AND
           G.Member = C.Circuit AND
           C.Status < :TC_Card$Closed) OR
          (G.Member = :CurObject.Object AND
           G.Relationship = :Interaction$MemberOf AND
           G.Grouping = C.Circuit AND
           C.Status < :TC_Card$Closed);
   CALLPROC DDB_ROLLBACK;

   RETURN;
END;

METHOD IsSOOEnabled(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   OpOrderSubstation = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   /* Check if there is a macro or hybrid station for the permit 
   */
   OpOrderSubstation = 0;
   SELECT :OpOrderSubstation = G.Grouping
   FROM   Udb_Grouping G
   WHERE  G.Member = :CurObject.Substation AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$MacroSubstation;
                 
   IF OpOrderSubstation = 0 THEN
      SELECT :OpOrderSubstation = G.Grouping
      FROM   Udb_Grouping G
      WHERE  G.Member = :CurObject.Substation AND
             G.Relationship = :Interaction$ShareControlRoom AND
             G.GroupingType IN (SELECT Type FROM Udb_ExtendedType
                                WHERE  SuperType = :Type$Substation);

      IF OpOrderSubstation = 0 THEN
         OpOrderSubstation = CurObject.Substation;
      ENDIF;
   ENDIF;

   i = FALSE;
   SELECT :i = SOA_To_SOO
   FROM   SOO_Communication
   WHERE  Substation = :OpOrderSubstation;

   IF i = FALSE THEN
      RETURN FALSE;
   ELSE
      RETURN TRUE;
   ENDIF;
END;

METHOD BuildCktEquipList(
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   k  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */

   RouteList = VARCHAR(80) NOT NULL WITH DEFAULT;
   ObjectList = ARRAY OF ObjectClass; /* Lines and Feeders */
   RouteName = VARCHAR(40) NOT NULL WITH DEFAULT;
   FoundFeeder = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.EL.Clear();

   CurObject.EL[1].Object = CurObject.Object;
   CurObject.EL[1].PrimaryEquip = TRUE;

   SELECT :CurObject.EL[1].Name = Name,
          :CurObject.EL[1].TypeName = TypeName
   FROM   Udb_Object
   WHERE  Object = :CurObject.Object;

   i = 2;

   RouteList = '';
   SELECT :RouteName = T.Name
   FROM   UDB_CircuitRoute R,
          Udb_Type T
   WHERE  R.Object = :CurObject.Object AND
          R.Route = T.Type
   BEGIN
      IF RouteList <> '' THEN
         RouteList = RouteList + ',';
      ENDIF;
      RouteList = RouteList + RouteName;
   END;

   IF RouteName <> '' THEN
      CurObject.EL[i].Object = -99;
      CurObject.EL[i].TypeName = 'ROUTE';
      CurObject.EL[i].Name = RouteList;
      CurObject.EL[i].PrimaryEquip = 0;
      i = i + 1;
   ENDIF;

   ObjectList.Clear();
   CALLPROC GetLinesAndFeeders (
                     Device = CurObject.Object,
                     Substation =  CurObject.Substation,
                     ObjectList = ObjectList);

   FoundFeeder = FALSE;
   FOR k = 1 TO ObjectList.LastRow() DO 
       CurObject.EL[i].Object = ObjectList[k].Object;
       CurObject.EL[i].TypeName = 'FDR';
       CurObject.EL[i].Name = ObjectList[k].Name;

       IF FoundFeeder = FALSE THEN
          CurObject.EL[1].PrimaryEquip = 0;
          CurObject.EL[i].PrimaryEquip = 1;
          FoundFeeder = TRUE;
       ELSE
          CurObject.EL[i].PrimaryEquip = 0;
       ENDIF;
       i = i + 1;
   ENDFOR;
END; 


METHOD CompletePermit(
   PermitStatus = INTEGER NOT NULL WITH DEFAULT,
   StatusUpdateBy = INTEGER NOT NULL WITH DEFAULT,
   StatusReason = VARCHAR(200) NOT NULL WITH DEFAULT
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   j  = INTEGER NOT NULL WITH DEFAULT;
   
   EmailClass = EmailNotificationClass DEFAULT NULL;
   EquipList = VARCHAR(100) NOT NULL WITH DEFAULT;
   EquipName = VARCHAR(40) NOT NULL WITH DEFAULT;
   TypeName = VARCHAR(40) NOT NULL WITH DEFAULT;
   MessageText = VARCHAR(500) NOT NULL WITH DEFAULT; 
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   ReturnStatus = VARCHAR(20) NOT NULL WITH DEFAULT;
   TargetName = VARCHAR(40) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   REPEATED
   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.Status = P.Status,
          :CurObject.Substation = P.Substation, 
          :CurObject.SubstationName = O.Description, 
          :CurObject.Application = P.Application,    
          :CurObject.ObjectType = P.ObjectType,    
          :CurObject.Object = P.Object,    
          :CurObject.ObjectName = P.ObjectName,    
          :CurObject.WorkGroup = P.WorkGroup,        
          :CurObject.PermitMove = P.PermitMove,
          :CurObject.NotifyWhenCompleted = P.NotifyWhenCompleted,
          :CurObject.NYISONotified = P.NYISONotified,		    
          :CurObject.NYPANotified = P.NYPANotified		    
   FROM   SOA_InServicePermit P,
          Udb_Object O
   WHERE  P.ISPermit = :CurObject.ISPermit AND
          P.Substation = O.Object;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Status = ISPStatus$Issued OR CurObject.Status = ISPStatus$WithdrawRequest THEN
      RetCode = CALLPROC SOA_ISPStatusUpd(              
                 ISPermit = CurObject.ISPermit,
                 Status = PermitStatus,
                 StatusTime = DATE('now'),
                 StatusUpdateBy =  StatusUpdateBy,
                 StatusReason = StatusReason);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'InServicePermitClass.CompletePermit; Error in processing In Service Permit';
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.CompletePermit. ERROR: ' + 
                'Unable to mark In Service Permit complete.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;

   CurObject.LastUpdateBy = StatusUpdateBy;
   
   IF CurObject.NYISONotified = 1 THEN   
      IF PermitStatus = ISPStatus$Complete THEN
         CurObject.SendNYISOEmail(EmailType = 'COMPLETED');
      ELSE
         CurObject.SendNYISOEmail(EmailType = 'INCOMPLETED');
      ENDIF;

   ELSEIF CurObject.NotifyWhenCompleted = 1 THEN
      /*
      ** The values of NYISONotified and NotifyWhenCompleted are not correlated to
      ** each other. However, if NYISONotified = 1, T.O. will get a notification
      ** when the permit is returned. So, this is the reason why "ELSEIF" logic is 
      ** used here instead of independant "IF".
      */

      MessageText = 'ISWP "' + CurObject.PermitMove + '"';

      IF CurObject.ObjectType = Type$Substation THEN
         EquipList = '';
         SELECT :TypeName = TypeName,
                :EquipName = Name
         FROM   IR_OpOrderFeeders 
         WHERE  ISPermit = :CurObject.ISPermit AND
                PrimaryEquip = 1
         BEGIN
            EquipList = EquipList + TypeName + ' ' + EquipName;
         END;

         MessageText = MessageText + ' on ' + EquipList;
         IF PermitStatus = ISPStatus$Complete THEN
            MessageText = MessageText + ' returned COMPLETE ';
         ELSE
            MessageText = MessageText + ' returned INCOMPLETE ';
         ENDIF;
         MessageText = MessageText + 'from ' + CurObject.SubstationName;

      ELSEIF CurObject.ObjectType = Type$TelCircuit THEN
         EquipList = '';
         SELECT :TypeName = TypeName,
                :EquipName = Name
         FROM   IR_OpOrderFeeders 
         WHERE  ISPermit = :CurObject.ISPermit
         BEGIN
            IF EquipList <> '' THEN
               EquipList = EquipList + ',';
            ENDIF;
            IF TypeName = 'FDR' OR TypeName = 'ROUTE' THEN
               EquipList = EquipList + TypeName + ' ' + EquipName;
            ELSE
               // TO not interested in the circuit type/name. but show the circuit id
               EquipList = EquipList + EquipName;
            ENDIF;
         END;

         MessageText = MessageText + ' on ' + EquipList;
         IF PermitStatus = ISPStatus$Complete THEN
            MessageText = MessageText + ' returned COMPLETE ';
         ELSE
            MessageText = MessageText + ' returned INCOMPLETE ';
         ENDIF;
         MessageText = MessageText + 'from ' + CurObject.SubstationName;
      ENDIF;

      RetCode = CALLPROC CSD_MessageIns(DeskType = 'to'
                           ,MessageText = MessageText
                           ,MessageType = 0
                           ,Card = 0
                           ,Priority = 0  
                           ,Time = date('now'));
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.CompletePermit; ' + 
                'Error sending notification message to TO.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;      
   ENDIF;

   /*
   ** Send email to requestor when permit is returned
   */
   SELECT :CurObject.ReqInfo.Email = Email,
          :CurObject.ReqInfo.Equipment = Equipment
   FROM   SOA_ISPermitRequest
   WHERE  ISPermit = :CurObject.ISPermit;

   IF SQUEEZE(CurObject.ReqInfo.Email) <> '' THEN   
      IF EmailClass IS NULL THEN
         EmailClass = EmailNotificationClass.Create();
      ENDIF;
      
      SELECT :CurObject.LastUpdatebyName = Description
      FROM   Udb_Object
      WHERE  Object = :CurObject.LastUpdateBy;

      TargetName = CurObject.SubstationName;
      IF TargetName = '' THEN
         TargetName = CurObject.ObjectName;
      ENDIF;

      EmailClass.EmailType = 11;
      EmailClass.Sender = CurObject.LastUpdatebyName;
      EmailClass.Recipient = CurObject.ReqInfo.Email;
      IF PermitStatus = ISPStatus$Complete THEN
         ReturnStatus = 'COMPLETE ';
         EmailClass.Subject = 'In-Service Work Permit Returned COMPLETE'; 
      ELSE
         ReturnStatus = 'INCOMPLETE ';
         EmailClass.Subject = 'In-Service Work Permit Returned INCOMPLETE'; 
      ENDIF;
      
      EmailClass.Message1 = 'ID=' + VARCHAR(CurObject.ISPermit) + ';;' + 
                 'TargetName=' + CurObject.SubstationName + ';;' +
                 'Operator=' + CurObject.LastUpdatebyName + ';;' + 
                 'Status=' + ReturnStatus + ';;'; 
      EmailClass.Message2 = 'Permit=' + CurObject.PermitMove + ';;' +
                 'Equip=' + CurObject.ReqInfo.Equipment + ';;';
      EmailClass.Template = 'ISWPReturn.html';                      
      EmailClass.InsertRequest();

      IF EmailClass.ReturnCode <> 0 THEN 
         CurMethod.Trace(Text = varchar(date('now')) + ':InServicePermitClass.CompletePermit. ERROR: ' + 
                'Unable to send permit return confirmation email.');
      ENDIF;
   ENDIF;
   
   RETURN;
END;

METHOD UpdateNotifyMeFlag(
) = 
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   SELECT :CurObject.ISPermit = P.ISPermit,
          :CurObject.Status = P.Status,
          :CurObject.Application = P.Application,    
          :CurObject.ObjectType = P.ObjectType
   FROM   SOA_InServicePermit P
   WHERE  P.ISPermit = :CurObject.ISPermit;
   CALLPROC DDB_ROLLBACK;

   IF CurObject.Status <= ISPStatus$Issued THEN
      RetCode = CALLPROC SOA_ISPNotifyMeUpd(              
                 ISPermit = CurObject.ISPermit,
                 NotifyWhenCompleted = CurObject.NotifyWhenCompleted);

      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Failed to update database. Please try again.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateNotifyMeFlag; ' + 
                'Error updating NotifyWhenCompleted flag.');
      ELSE
         CALLPROC DDB_COMMIT;
      ENDIF;  
   ELSE
      CurObject.ReturnCode = -1;
      IF CurObject.Status = ISPStatus$Complete THEN
         CurObject.ErrorMessage = 'Work permit was already returned Completed';
      ELSEIF CurObject.Status = ISPStatus$InComplete THEN
         CurObject.ErrorMessage = 'Work permit was already returned InComplete';
      ELSE
         CurObject.ErrorMessage = 'Work permit was already closed';
      ENDIF
   ENDIF;

   RETURN;   
END;

METHOD UpdateNYISOFlag(
   SkipStatusQuery = INTEGER NOT NULL WITH DEFAULT; 
) = 
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */
   RetCode  = INTEGER NOT NULL WITH DEFAULT; 
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF SkipStatusQuery = FALSE THEN
      SELECT :CurObject.ISPermit = P.ISPermit,
             :CurObject.Status = P.Status
      FROM   SOA_InServicePermit P
      WHERE  P.ISPermit = :CurObject.ISPermit;
      CALLPROC DDB_ROLLBACK;
   ENDIF;
   
   /* get the TO's name in order to update the request status
   */
   SELECT :CurObject.LastUpdatebyName = Description
   FROM   Udb_Object
   WHERE  Object = :CurObject.LastUpdateBy;

   RetCode = CALLPROC SOA_ISPNYISONotifiedUpd(              
                 ISPermit = CurObject.ISPermit,
                 Notified = CurObject.NYISONotified,
                 UpdateBy = CurObject.LastUpdateBy,
                 UpdateByName = CurObject.LastUpdatebyName,
                 UpdateTime = DATE('NOW'));

   IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Failed to update database. Please try again.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : InServicePermitClass.UpdateNYISOFlag; ' + 
                'Error updating NYISONotified flag.');
   ELSE
         CALLPROC DDB_COMMIT;
   ENDIF;  

   RETURN;   
END;

