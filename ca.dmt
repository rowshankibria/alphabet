METHOD LoadTxLogDetails (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the details of a log entry in the transaction log.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.FCLog.LastRow() <> 1 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Invalid input passed in.  Please try again.';  
      RETURN; 
   ENDIF;

   SELECT :CurObject.FCLog[1].TOOperatorName = Description
   FROM   UDB_OBJECT
   WHERE  Object = :CurObject.FCLog[1].TOOperator;
   CALLPROC DDB_ROLLBACK;

   SELECT :CurObject.FCLog[1].RSOperatorName = Description
   FROM   UDB_OBJECT
   WHERE  Object = :CurObject.FCLog[1].RSOperator;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

METHOD UpdateETC =
DECLARE
   i                    = INTEGER NOT NULL;     /*Counter*/
   j                    = INTEGER NOT NULL;     /*Counter*/
   RetCode              = INTEGER NOT NULL WITH DEFAULT; /*Return Code*/  
   MsgKey               = INTEGER NOT NULL WITH DEFAULT;   
   CardETC              = DATE NOT NULL;        /*ETC for the FMS Card*/
   OrigETC              = DATE;                 /*Original ETC for the FMS Card*/  
   ActCom              = DATE;                 /*Actual Complete Time */
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update estimated completion time of a
** fms card
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
**  Validate that there is an active card for the returned feeder.
*/   
   ActCom = '';
   SELECT :OrigETC = C.EstTimeComplete,
          :ActCom = C.ActTimeComplete
   FROM   FMS_Card C,
          SOA_ActiveCard AC
   WHERE  AC.Card = :CurObject.Card AND
          AC.Card = C.Card AND
          C.Cutout IS NOT NULL AND
          C.CutIn IS NULL AND
          C.Status < :Card$Closed;

   IF iirowcount = 0 THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: Card ID parameter ' + 
                       VARCHAR(CurObject.Card) +
                       ' is not out of service.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'The Estimate Completion Time can only be updated ' +
                        ' when the feeder is out of service.';
      RETURN;      
   ENDIF;

   IF ActCom <> '' THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': DEBUGGING MESSAGE: Feeder ETC update' + 
                        ' is not allowed.  Feeder is already complete.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'ETC Update for feeder ' +
                        ' is not allowed.  Feeder is already complete.';
      RETURN;      
   ENDIF;

/*
**  Validate ETC
*/   
   IF CurObject.TimeString = '' THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: Feeder ETC update' +
                       ' does not contain valid TimeString.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Feeder ETC Update does not contain valid TimeString.';
      RETURN;
   ENDIF;  

   CardETC = '';
   CardETC = DATE(CurObject.TimeString); 
   
   IF CardETC = '' THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: Feeder ETC Update failed. ' +
                       CurObject.TimeString +
                       ' is not a valid date format.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Feeder ETC Update failed. ' + 
                         CurObject.TimeString +
                        ' is not a valid date format.';
      RETURN;
   ELSEIF CardETC < Date('now') THEN
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': VALIDATION MESSAGE: Feeder ETC failed. ' + 
                       CurObject.TimeString +
                       ' is in the past.');
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Feeder ETC Update failed. ' + 
                        CurObject.TimeString +
                        ' is in the past.';
      RETURN;
   ENDIF;  
/*
** Update the ETC of the card.
*/          
   IF CardETC IS NOT NULL THEN
      RetCode = CALLPROC FMS_EstTimeCompleteUpd
			 (Card = CurObject.Card,
                          EstTimeComplete = CardETC
                         );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': FMS Card ' + 
                       VARCHAR(CurObject.Card) +
                       ' Estimated Time of Completion Update failed.');
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'ETC could not be updated due to an Ingres Error.' +
                        ' Please contact D.O. verbally.';
         RETURN;
      ELSE
         /* update the Estimated Time In Service for the card  */
         RetCode = CALLPROC FMS_EstTimeInserviceUpd
			 (Card = CurObject.Card,
                          EstTimeInservice = CardETC + '1 hours'
                         );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': FMS Card ' + 
                       VARCHAR(CurObject.Card) +
                       ' Estimated Time Inservice Update failed.');
            CurObject.ReturnCode = -2;
            CurObject.ErrorMessage = 'ETC could not be updated due to an Ingres Error.' +
                        ' Please contact D.O. verbally.';
            RETURN;
         ENDIF;
         CALLPROC DDB_COMMIT;

         IF OrigETC <> CardETC THEN
            CALLPROC SOA_LogIns 
			(Card = CurObject.Card,
                         Job = NULL,
                         Item = 'Estimated Time Complete',
                         Old = IFNULL(OrigETC,''),
                         New = IFNULL(CardETC,''),
                         Time = Date('now'),
                         UserName = CurObject.OperatorName);
            CALLPROC DDB_COMMIT;   
         ENDIF;

         CurObject.CutIn = CardETC + '1 hours';
      ENDIF;
   ENDIF;
 
   RETURN;   
END;

METHOD LoadTxLogItem (
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to load the equipment associated with a transaction log.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.FCLog.Clear();
   i = 1;
   IF CurObject.ArchiveCard = FALSE THEN
      REPEATED
      SELECT DISTINCT
              :CurObject.FCLog[i].Item = L.Item
      FROM     SOA_Log L
      WHERE    L.Card = :CurObject.Card AND
               L.SwitchingItem = :CurObject.SwitchingItem
      ORDER BY 1
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF CurrentApplication = Application$FMS THEN
         REPEATED
         SELECT DISTINCT
              :CurObject.FCLog[i].Item = L.Item
         FROM  FMS_ArchiveLog L
         WHERE L.Card = :CurObject.Card 
         ORDER BY 1
         BEGIN
            i = i + 1;
         END;
      ELSE
         REPEATED
         SELECT DISTINCT
              :CurObject.FCLog[i].Item = L.Item
         FROM  SOA_ArchiveLog L
         WHERE L.Card = :CurObject.Card AND
               L.SwitchingItem = :CurObject.SwitchingItem 
         ORDER BY 1
         BEGIN
            i = i + 1;
         END;
      ENDIF;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
      
   RETURN;
END;

