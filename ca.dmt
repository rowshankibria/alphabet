	Name:            PromptOpenNCHTV

/*
**
**	Copyright c 2017 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptOpenNCHTV         
**
**  Modifications:
**  04/27/17 em	    Created
**  05/02/17 em     Look at Job Card only when looking for Auto/OOE1
*/
INITIALIZE                         
(
    JIP = JobInProgress;		        /* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER;
    HTVGrouper = INTEGER NOT NULL WITH DEFAULT;
    AutoCard = INTEGER NOT NULL WITH DEFAULT;
    SelectCount = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
/*
**  Don't do anything unless this move is on an Auo/OOE1 card
*/
   AutoCard = 0;
   SELECT :AutoCard = C.Card
   FROM   FMS_Card C
   WHERE  C.Card = :JIP.Card AND
          C.CardClass IN (:Type$Auto, :Type$OOE1);
   IF AutoCard = 0 THEN
      RETURN(PU_OK);
   ENDIF;
/*
** Equipment must be a normally closed HTV equipment
*/ 
   HTVGrouper = 0;
   REPEATED
   SELECT :HTVGrouper = G.Grouping
   FROM   Udb_Grouping G,
          Udb_Switch S,
          Udb_ExtendedType ET
   WHERE  G.Member = :JIP.Equip AND
          G.Member = S.Object AND
          S.NormalOpen = 0 AND
          G.MemberType = ET.Type AND
          ET.SuperType = :Type$HTVStd AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = :Type$AbstractHTV;
   IF HTVGrouper = 0 THEN
      RETURN(PU_OK);
   ENDIF;
/*
** Increment NCHTVOpen Status on the HTV Grouper
*/
                  SelectCount = 0;       /* Set Status if not already set */
                  SELECT :SelectCount = Count(*)
                  FROM   FMS_ObjectStatus 
                  WHERE  Object = :HTVGrouper AND
                         Status = :Status$NCHTVOpen; 
       
                  IF SelectCount = 0 THEN
                     RetCode = CALLPROC FMS_ObjStatIns(  
                                    Object = HTVGrouper,
                                    Status = Status$NCHTVOpen,
                     	            StatusCount = 1,
                                    Terminal = 0,
                                    TimeSet = date('now'));       
                  ELSE             
       	             RetCode = CALLPROC FMS_ObjStatTimeSetUpd(
	   	              Object = HTVGrouper, 
	   	              Status = Status$NCHTVOpen,
                              Terminal = 0,
	                      increment = 1,
	   	              TimeSet = date('now'));
                  ENDIF; 

                  IF RetCode < 0 THEN
                     CALLPROC DDB_ROLLBACK;
                     CALLPROC TraceError (UserMessage = 
                           'Error setting NCHTVOpen status for an HTVGrouper.  Tech Support should be ' +
                           'contacted to review your machine trace log',
                        TraceMessage = DATE('now') + ': ' +
                           'PromptOpenNCHTV ' +
                           'Error setting Status NCHTVOpen for HTVGrouper ' +
                           VARCHAR(JIP.Equip) 
                           );
                     RETURN (PU_Cancel);
                  ENDIF;
          
   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);

END;

