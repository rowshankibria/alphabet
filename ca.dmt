	Name:            Check229VisibleBreaks

/*
**
**	Copyright c 1992 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Procedure:      Check229VisibleBreaks               
**
**  Modifications:
**  10/20/94        bgh     Created 
**  01/25/96        ysp     Added check for all 229 visible break checks.
**  03/29/99        em      Incorporated into SOA
**  11/26/02        pkw     Change Job to JIP for Merge.
*/
PROCEDURE Check229VisibleBreaks 
(
    JIP = JobInProgress;	  		/* Job being processed */

    RetCode = INTEGER;
    i = INTEGER;
) =
BEGIN
/*
**  This checks for "Continue Ground Move"
*/ 
    IF JIP.JobClass  <>  JobClass$229C THEN
        RETURN(PU_OK);
    ENDIF;
/*
**  Make sure all "Visible Breaks Verified Open" have been completed
**  from all substations.
*/        
    i = 0;
    REPEATED
    SELECT :i = Count(*)
    FROM   SOA_JobControl JC,
           SOA_Job J
    WHERE  JC.Card = :JIP.Card AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.TOComplete IS NULL AND
           J.JobClass = :JobClass$229B;

    IF i > 0 THEN
       RetCode = CALLFRAME Warning (Card = JIP.Card, Job = JIP.Job, 
                                    SwitchingItem = JIP.SwitchingItem,
             Text = 
                 'Not all 229 "Visible Breaks Verified Open" moves have been completed.');
        IF RetCode = PU_CANCEL THEN
            RETURN(PU_CANCEL);
        ELSE
            RETURN(Warning$Overridden);
        ENDIF;
   ELSE
       RETURN (PU_OK);
   ENDIF;
END; 

