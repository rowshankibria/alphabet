Application Component Report
============================

	Name:            PromptRemoveSpearMHGround

/*
**
**	Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          PromptRemoveSpearMHGround          
**
**  Modifications:
**  09/14/15   em   Created 
**  10/01/15   em   Spear UG modified to be the ground move for the MH, 
**                  will be TakeOut Issue/Complete with open Restore.
**                  This prompt will mark the Restore Issue/Complete.
**                  Only proceed if All work done.
**  10/19/15   em   Modify manhaole name mapping logic.
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    i		    = INTEGER NOT NULL WITH DEFAULT;     
    j		    = INTEGER NOT NULL WITH DEFAULT;     
    IssuedDate      = DATE;   
    LocationName    = VARCHAR(40) NOT NULL WITH DEFAULT; 
    RetCode         = INTEGER;
    SingleChar      = CHAR(1) NOT NULL WITH DEFAULT;
    UGSpearMove     = ARRAY OF Job;
    Word            = VARCHAR(40) NOT NULL WITH DEFAULT;
    WordLength      = INTEGER NOT NULL WITH DEFAULT;     
    WordNumbers     = VARCHAR(40) NOT NULL WITH DEFAULT;
    WordNumbers1    = VARCHAR(40) NOT NULL WITH DEFAULT;
) =
BEGIN
   IF JIP.WorkStatus <> 'All work done' THEN
      RETURN (PU_OK);
   ENDIF;
/*
** Look for UG Spear permit move with grounded MH on Job Card.
*/
   UGSpearMove.Clear();
   i = 1;
   REPEATED 
   SELECT  :UGSpearMove[i].Job = J.Job,
           :UGSpearMove[i].Equip = J.Equip,
           :UGSpearMove[i].EquipClass = J.EquipClass,
           :UGSpearMove[i].EquipName = J.EquipName
   FROM    SOA_Job J,
           SOA_JobControl JC,
           FMS_ObjectStatus OS   
   WHERE   JC.Card = :JIP.Card AND
           JC.Job = J.Job AND
           J.JobClass = :JobClass$UGSpear AND
           J.EquipClass = :TypeName$MH AND 
           J.Status = '' AND
           J.GroundOn IS NOT NULL AND
           J.Equip = OS.Object AND
           OS.Status = :Status$Ground AND
           OS.StatusCount > 0
   BEGIN
      i = i + 1;
   END;
/*
** Compare equipname to work location, if there is a match then remove the ground
*/
   FOR i = 1 TO UGSpearMove.LastRow() DO
      WordLength = LENGTH(UGSpearMove[i].EquipName);
      Word = UGSpearMove[i].EquipName;
      WordNumbers = '';
      FOR j = 1 TO WordLength DO
          SingleChar = LEFT(Word,1);
          Word = SHIFT(Word,-1);
          IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
             WordNumbers = Word;
             ENDLOOP;
          ENDIF;
      ENDFOR;

      IF WordNumbers = '' THEN
         CONTINUE;
      ENDIF;

      WordNumbers1 = WordNumbers; 
      WordNumbers = '%' + WordNumbers;  /* Looking for strong match */
      j = 0;
      SELECT :LocationName = LocationStructure
      FROM   IR_WorkLocation
      WHERE  WorkPermit = :JIP.Job AND
             LocationStructure LIKE :WordNumbers
      BEGIN 
/*
**  Scroll through candidate matches and look at whole number.
*/
         WordLength = LENGTH(LocationName);
         Word = LocationName;
         WordNumbers = '';
         FOR j = 1 TO WordLength DO
            SingleChar = LEFT(Word,1);
            Word = SHIFT(Word,-1);
            IF SingleChar LIKE '\[0-9\]%' escape '\' THEN
               WordNumbers = Word;
               ENDLOOP;
            ENDIF;
         ENDFOR;
          
         IF WordNumbers1 = WordNumbers THEN
            j = 1;   /*We have a match*/
         ENDIF;
      END;

      IF j = 1 THEN
/*
** Issue and complete RS side of UG Spear move
*/
         IssuedDate = 'now';
         RetCode = CALLPROC SOA_IssueMove(Job = UGSpearMove[i].Job,
                                    Issued = IssuedDate,
                                    Operator = DOp.Object,
                                    Status = 'RS'
                                   );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                       'Error issuing UG Spear Restore.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptRemoveSpearMHGround; ' +
                       'Error issuing UG Spear Restore. ' +
                       'Job=' + VARCHAR(UGSpearMove[i].Job)  + '.'
                       );
         ENDIF;

         RetCode = CALLPROC SOA_CompleteMove(Job = UGSpearMove[i].Job,
                                    Complete = IssuedDate,
                                    Status = 'RS'
                                   );
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                       'Error completing UG Spear Restore.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptRemoveSpearMHGround; ' +
                       'Error completing UG Spear Restore. ' +
                       'Job=' + VARCHAR(UGSpearMove[i].Job)  + '.'
                       );
         ENDIF;
         CALLPROC DDB_COMMIT;
   
         RetCode = CALLPROC FMS_ObjStatDel(
                                       Object = UGSpearMove[i].Equip, 
                                       Terminal = 0,
                                       Status = Status$Ground);                 
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                       'Error removing Spear MH Ground Status.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptRemoveSpearMHGround; ' +
                       'Error deleting an Object Status. ' +
                       'Object=' + VARCHAR(UGSpearMove[i].Equip) +
                       ';Ground Status=' + VARCHAR(Status$Ground) + '.'
                       );
         ENDIF;
/*
** Don't know the ground move id, just using Spear Job.  Need to clear ground 
** count for all the equipment moves.
*/   
         RetCode = CALLPROC SOA_GroundOnUpd (
                                GroundOn = NULL,
                                Job      = UGSpearMove[i].Job,
                                Equip    = UGSpearMove[i].Equip
                              );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage = 
                       'Error removing Equip Ground from moves.  Tech Support should be ' +
                       'contacted to review your machine trace log',
                           TraceMessage =
                       'PromptRemoveSpearMHGround; ' +
                       'Error updating equipment move ground count for ' +
                       'Object=' + VARCHAR(UGSpearMove[i].Equip) 
                       );
         ENDIF;
         CALLPROC DDB_COMMIT;

         CALLPROC FMS_ManageCardHeader (Equip = UGSpearMove[i].Equip);
      ENDIF;   
   ENDFOR;

   RETURN (PU_OK);
END;

