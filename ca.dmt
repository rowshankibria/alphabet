/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    CAC
**  Class:          TFMS_Card
**
**  Date:       Author   Description
** ----------------------------------
**  01/14/98    pkw      Created
**  01/25/98    pkw      Added Insert Card method
**  02/16/03    em       Replace Message with TraceError Call
**  05/16/07    ysp      Add NotifyCutOut and NotifyCutIn methods. Include
**                       CardClassName in the cutout messages.
**  07/31/07    ysp      Support of Black Start: 1. the card name is the Black Start
**                       scenario name. 2. When loading card's object, load Black Start 
**                       scenario object as well. 3. if a Black Start card has no 
**                       associated lines, add the desks that are responsible for the scenario 
**                       to the checklist table
**  02/23/10   em        Prepby and Checkby loaded into array by desk
**  01/13/15   em        Copy CIG notification and send to SSM also
**  03/11/15   em        Change Notification message text
**  07/25/17   ysp       add loading of incident reports flag
**  08/19/19   ysp       add CheckORLink
*/
METHOD LoadCard(
   Card = INTEGER NOT NULL;
)=
DECLARE
   i = INTEGER NOT NULL;
ENDDECLARE
BEGIN
   IF Card = 0 THEN
       RETURN(CurObject);
   ENDIF;

   CurMethod.SendSuperClass();
/*
** Read the card in
*/                                  
   IF ArchiveCard = FALSE THEN
      SELECT  :CurObject.CardNumber = C.CardNumber,
              :CurObject.Description = C.Description,
              :CurObject.FeederNames = C.FeederNames
      FROM    TFMS_Card C
      WHERE   C.Card = :Card;
 
      SELECT  :CurObject.CL.Card = CL.Card,
              :CurObject.CL.Desk = CL.Desk,
              :CurObject.CL.PermitsReturned = CL.PermitsReturned,
              :CurObject.CL.GroundsRemoved = CL.GroundsRemoved,
              :CurObject.CL.DisconnectsClosed = CL.DisconnectsClosed,
              :CurObject.CL.HSGSReset = CL.HSGSReset,
              :CurObject.CL.RelaySysNormal = CL.RelaySysNormal,
              :CurObject.CL.OilPresNormal = CL.OilPresNormal,
              :CurObject.CL.EquipCanBeEnerg = CL.EquipCanBeEnerg,
              :CurObject.CL.EquipPrepForServ = CL.EquipPrepForServ,
              :CurObject.CL.CheckedStnLogCrd = CL.CheckedStnLogCrd,
              :CurObject.CL.AmmeterClearPerf = CL.AmmeterClearPerf,
              :CurObject.CL.AcceptanceLetter = CL.AcceptanceLetter 
      FROM    TFMS_CheckList CL
      WHERE   CL.Card = :Card AND
              CL.Desk = :UserDesk;      
      CALLPROC DDB_ROLLBACK; 
 
      i = 1;
      SELECT  :CurObject.CPBy[i].Desk = CP.Desk,
              :CurObject.CPBy[i].DeskName = O.Name,
              :CurObject.CPBy[i].PreparedBy = CP.PreparedBy,
              :CurObject.CPBy[i].CheckedBy = CP.CheckedBy
      FROM    TFMS_CardPrepBy CP,
              Udb_Object O
      WHERE   CP.Card = :Card AND
              CP.Desk = O.Object
      UNION
      SELECT  CP.Desk,
              'OldDataNoDesk',
              CP.PreparedBy,
              CP.CheckedBy
      FROM    TFMS_CardPrepBy CP
      WHERE   CP.Card = :Card AND
              CP.Desk = 1
      BEGIN
         i = i + 1;
      END;

      i = 1;
      SELECT  :CurObject.CTO[i].Object = CTO.Object,
              :CurObject.CTO[i].Name = CTO.Name,
              :CurObject.CTO[i].Status = CTO.Status,
              :CurObject.CTO[i].ValidatedBy = CTO.ValidatedBy,
              :CurObject.Object[i].Object = CTO.Object,
              :CurObject.Object[i].Name = CTO.Name,
              :CurObject.Object[i].Type = O.Type,
              :CurObject.Object[i].TypeName = O.TypeName
      FROM    TFMS_CardToObject CTO,
              Udb_Object O
      WHERE   CTO.Card = :Card AND
              CTO.Type IN (:Type$TransmissionFdr, :Type$BlackStartScenario) AND
              CTO.Object = O.Object
      BEGIN
         i = i + 1;
      END;

      /* incident reports
      */
      SELECT :CurObject.IncidentReport = COUNT(*)
      FROM   TFMS_CardToObject CTO,
             SOA_IncidentReportLink L
      WHERE  CTO.Card = :Card AND
             CTO.Status = 1 AND
             CTO.Object = L.Object;       
/*
** Archived cards
*/
   ELSE
      SELECT  :CurObject.CardNumber = C.CardNumber,
              :CurObject.Description = C.Description,
              :CurObject.FeederNames = C.FeederNames
      FROM    TFMS_ArchiveCard C
      WHERE   C.Card = :Card;

      SELECT  :CurObject.CL.Card = CL.Card,
              :CurObject.CL.Desk = CL.Desk,
              :CurObject.CL.PermitsReturned = CL.PermitsReturned,
              :CurObject.CL.GroundsRemoved = CL.GroundsRemoved,
              :CurObject.CL.DisconnectsClosed = CL.DisconnectsClosed,
              :CurObject.CL.HSGSReset = CL.HSGSReset,
              :CurObject.CL.RelaySysNormal = CL.RelaySysNormal,
              :CurObject.CL.OilPresNormal = CL.OilPresNormal,
              :CurObject.CL.EquipCanBeEnerg = CL.EquipCanBeEnerg,
              :CurObject.CL.EquipPrepForServ = CL.EquipPrepForServ,
              :CurObject.CL.CheckedStnLogCrd = CL.CheckedStnLogCrd,
              :CurObject.CL.AmmeterClearPerf = CL.AmmeterClearPerf,
              :CurObject.CL.AcceptanceLetter = CL.AcceptanceLetter 
      FROM    TFMS_ArchiveCheckList CL
      WHERE   CL.Card = :Card AND
              CL.Desk = :UserDesk;      
      CALLPROC DDB_ROLLBACK; 

      i = 1;
      SELECT  :CurObject.CPBy[i].Desk = CP.Desk,
              :CurObject.CPBy[i].DeskName = O.Name,
              :CurObject.CPBy[i].PreparedBy = CP.PreparedBy,
              :CurObject.CPBy[i].CheckedBy = CP.CheckedBy
      FROM    TFMS_ArchiveCardPrepBy CP,
              Udb_Object O
      WHERE   CP.Card = :Card AND
              CP.Desk = O.Object
      UNION
      SELECT  CP.Desk,
              'OldDataNoDesk',
              CP.PreparedBy,
              CP.CheckedBy
      FROM    TFMS_ArchiveCardPrepBy CP
      WHERE   CP.Card = :Card AND
              CP.Desk = 1
      BEGIN
         i = i + 1;
      END;

      i = 1;
      SELECT  :CurObject.CTO[i].Object = CTO.Object,
              :CurObject.CTO[i].Name = CTO.Name,
              :CurObject.CTO[i].Status = CTO.Status,
              :CurObject.CTO[i].ValidatedBy = CTO.ValidatedBy,
              :CurObject.Object[i].Object = CTO.Object,
              :CurObject.Object[i].Name = CTO.Name,
              :CurObject.Object[i].Type = O.Type,
              :CurObject.Object[i].TypeName = O.TypeName
      FROM    TFMS_ArchiveCardToObject CTO,
              Udb_Object O
      WHERE   CTO.Card = :Card AND
              CTO.Type IN (:Type$TransmissionFdr, :Type$BlackStartScenario) AND
              CTO.Object = O.Object
      BEGIN
         i = i + 1;
      END;

      /* incident reports
      */
      SELECT :CurObject.IncidentReport = COUNT(*)
      FROM   TFMS_ArchiveCardToObject CTO,
             SOA_IncidentReportLink L
      WHERE  CTO.Card = :Card AND
             CTO.Status = 1 AND
             CTO.Object = L.Object;       
   ENDIF;
   RETURN(CurObject);
END;

METHOD InsertCard(
   ConnectedBreakers = ARRAY OF ConnectedEquipClass
 , ConnectedLineSegs = ARRAY OF ConnectedEquipClass
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   LastRow   = INTEGER NOT NULL WITH DEFAULT;
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
   CheckList = ARRAY OF CardChecklist;
ENDDECLARE
BEGIN
/*
** Create the Card
*/
   CurObject.Card = CALLPROC Udb_NextKey(KeyName = 'Card');
   IF CurObject.Card <= 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to generic card key.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardTFMS;InsertCard; Unable to generic card key.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
** Link card to feeder/substation objects
*/
   RetCode = CALLPROC InsertObjectLink 
                         (CardDetails = CurObject
                         ,ConnectedBreakers = ConnectedBreakers
                         ,ConnectedLineSegs = ConnectedLineSegs
                         ); 
   IF RetCode <> PU_OK THEN
/* 
** Message should have been produced in InsertObjectLink.
*/
      CALLPROC DDB_ROLLBACK;
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;

   REPEATED
   SELECT :i = COUNT(*)
   FROM   TFMS_CardToObject
   WHERE  Type = :Type$TransmissionFdr AND
          Card = :CurObject.Card AND
          ValidatedBy = '';

   IF i = 0 THEN
      CurObject.Validated = 'Yes';
   ELSE
      CurObject.Validated = 'No';
   ENDIF; 
/*
** Determine desks involved by Card and create appropriate
** Cheklist records for them
*/
   i = 1;
   REPEATED
   SELECT DISTINCT :CheckList[i].Desk = G.Grouping
   FROM TFMS_CardToObject CTO,
        UDB_Grouping G
   WHERE CTO.Card = :CurObject.Card AND
         CTO.Type = :Type$TransmissionFdr AND
         G.Member = CTO.Object AND
         G.Relationship = :Interaction$ControlledBy
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
/*
** if this is a Black Start card and has no associated lines. 
** Use the division relationship to determine the desks
*/  
   IF CheckList.LastRow = 0 AND CurObject.CardClass = Type$TFMSBLCK THEN 
      i = 1;
      REPEATED
      SELECT DISTINCT :CheckList[i].Desk = G2.Grouping
      FROM   UDB_Grouping G1,
             UDB_Grouping G2
      WHERE G1.Member = :CurObject.BlackStart AND
            G1.Relationship = :Interaction$MemberOf AND
            G1.GroupingType = :Type$Division AND
            G1.Grouping = G2.Member AND
            G2.Relationship = :Interaction$MemberOf AND
            G2.GroupingType = :Type$OperatorDesk
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ENDIF;

   i = 1;
   LastRow = CheckList.LastRow();
   WHILE i <= LastRow DO
      RetCode = TFMS_CardCheckListInsert (
                        Card = CurObject.Card,
                        Desk = CheckList[i].Desk);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert checklist entry.  ' +
             'Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardTFMS;InsertCard; Unable to insert checklist entry.'
             );
          CurObject.Card = 0;
         RETURN CurObject;
      ENDIF;
      i = i + 1;
   ENDWHILE;
   CALLPROC DDB_COMMIT;
/*
** Insert card info into TFMS_Card. No commit is done until
** card info has been inserted into SOA_Card.
*/
   IF CurObject.CardClass = Type$TFMSBLCK THEN
      CurObject.FeederNames = CurObject.BlackStartName;
   ENDIF;

   RetCode = CALLPROC SOA_TFMSCardIns(Card = CurObject.Card
                                     ,FeederNames = CurObject.FeederNames
                                     ,Description = CurObject.Description
                                     );
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
             'ERROR: Unable to insert TFMS card.  Have tech support review ' +
             'trace log.',
                           TraceMessage =
             'CardTFMS;InsertCard; Card insert failed.'
             );
      CurObject.Card = 0;
      RETURN CurObject;
   ENDIF;

   CurObject.Application = Application$TFMS;
   CurObject.Status = Card$Open;
   CurObject.TypeOfCard = Type$TransmissionCard;

   CurMethod.SendSuperClass();

   ArchiveCard = FALSE;
   RETURN CurObject;
END;

METHOD NotifyCutOut(
   TimeUpdate = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   MsgTxt = Varchar(500) NOT NULL;     

   RetCode   = INTEGER NOT NULL WITH DEFAULT;
   TempChar = VARCHAR(20) NOT NULL; 
ENDDECLARE
BEGIN
/*
** Open Auto, OOE1 and OOE2
*/
   IF CurObject.CardClass <> Type$TFMSOOE1 AND
      CurObject.CardClass <> Type$TFMSOOE2 AND
      CurObject.CardClass <> Type$TFMSAuto THEN
      RETURN PU_OK;
   ENDIF;
 
   IF date_part('min',CurObject.CutOut) < 10 THEN
      TempChar = '0';
   ELSE
      TempChar = '';
   ENDIF;

   IF TimeUpdate = TRUE THEN
      MsgTxt = 'Transmission Feeder ' + 
               '<a target="fms" href="<%type=card&app=' + CurrentApplication + 
               '&card=' + VARCHAR(CurObject.Card) + '%>">' + CurObject.FeederNames + '</a>  ' + 
                        CurObject.CardClassName +
                        ' Cut Out time has been updated to ' +
                   	VARCHAR(date_part('month',CurObject.CutOut)) + '/' +
                    	VARCHAR(date_part('day',CurObject.CutOut)) + ' ' +
                   	VARCHAR(date_part('Hour',CurObject.CutOut)) + ':' + TempChar +
                    	VARCHAR(date_part('min',CurObject.CutOut)) + '.';
 
   ELSE
      IF CurObject.CardClass = Type$TFMSAuto THEN
         MsgTxt = 'Transmission Feeder ' + 
               '<a target="fms" href="<%type=card&app=' + CurrentApplication + 
               '&card=' + VARCHAR(CurObject.Card) + '%>">' + CurObject.FeederNames + '</a>  ' + 
               ' Opened Auto at ' + 
               VARCHAR(date_part('month',CurObject.CutOut)) + '/' +
               VARCHAR(date_part('day',CurObject.CutOut)) + ' ' +
               VARCHAR(date_part('Hour',CurObject.CutOut)) + ':' + TempChar +
               VARCHAR(date_part('min',CurObject.CutOut));
      ELSE
         MsgTxt = 'Transmission Feeder ' + 
               '<a target="fms" href="<%type=card&app=' + CurrentApplication + 
               '&card=' + VARCHAR(CurObject.Card) + '%>">' + CurObject.FeederNames + '</a>  ' + 
               CurObject.CardClassName + ' Cut Out at ' + 
               VARCHAR(date_part('month',CurObject.CutOut)) + '/' +
               VARCHAR(date_part('day',CurObject.CutOut)) + ' ' +
               VARCHAR(date_part('Hour',CurObject.CutOut)) + ':' + TempChar +
               VARCHAR(date_part('min',CurObject.CutOut));
      ENDIF;
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = CurObject.Card);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ' : ' +
                      'CardTFMS.NotifyCutOut; Could not send CutOut notification to CIG ' +
                      'for card ' + VARCHAR(CurObject.Card)); 
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = CurObject.Card);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ' : ' +
                      'CardTFMS.NotifyCutOut; Could not send CutOut notification to SSM ' +
                      'for card ' + VARCHAR(CurObject.Card)); 
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN PU_OK;
END;

METHOD NotifyCutIn(
   TimeUpdate = INTEGER NOT NULL WITH DEFAULT;
)=
DECLARE
   i         = INTEGER NOT NULL WITH DEFAULT;
   MsgTxt = Varchar(500) NOT NULL;     
   RetCode   = INTEGER NOT NULL WITH DEFAULT;
   TempChar = VARCHAR(20) NOT NULL; 
ENDDECLARE
BEGIN
/*
** Open Auto, OOE1 and OOE2
*/
   IF CurObject.CardClass <> Type$TFMSOOE1 AND
      CurObject.CardClass <> Type$TFMSOOE2 AND
      CurObject.CardClass <> Type$TFMSAuto THEN
      RETURN PU_OK;
   ENDIF;
 
   IF date_part('min',CurObject.CutIn) < 10 THEN
      TempChar = '0';
   ELSE
      TempChar = '';
   ENDIF;

   IF TimeUpdate = TRUE THEN
      MsgTxt = 'Transmission Feeder ' + 
               '<a target="fms" href="<%type=card&app=' + CurrentApplication + 
               '&card=' + VARCHAR(CurObject.Card) + '%>">' + CurObject.FeederNames + '</a>  ' + 
                        ' Cut In time has been updated to ' +
                   	VARCHAR(date_part('month',CurObject.CutIn)) + '/' +
                    	VARCHAR(date_part('day',CurObject.CutIn)) + ' ' +
                   	VARCHAR(date_part('Hour',CurObject.CutIn)) + ':' + TempChar +
                    	VARCHAR(date_part('min',CurObject.CutIn)) + '.';
 
   ELSE
      MsgTxt = 'Transmission Feeder ' + 
               '<a target="fms" href="<%type=card&app=' + CurrentApplication + 
               '&card=' + VARCHAR(CurObject.Card) + '%>">' + CurObject.FeederNames + '</a>  ' + 
               ' Cut In at ' + 
               VARCHAR(date_part('month',CurObject.CutIn)) + '/' +
               VARCHAR(date_part('day',CurObject.CutIn)) + ' ' +
               VARCHAR(date_part('Hour',CurObject.CutIn)) + ':' + TempChar +
               VARCHAR(date_part('min',CurObject.CutIn));
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = CurObject.Card);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ' : ' +
                      'CardTFMS.NotifyCutIn; Could not send CutIn notification to CIG ' +
                      'for card ' + VARCHAR(CurObject.Card)); 
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RetCode = CALLPROC CSD_MessageIns(DeskType = 'csd'
                    ,MessageText = MsgTxt
                    ,Time = date('now')
                    ,Priority = 1
                    ,MessageType = 0
                    ,Card = CurObject.Card);

   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = VARCHAR(DATE('now')) + ' : ' +
                      'CardTFMS.NotifyCutIn; Could not send CutIn notification to SSM ' +
                      'for card ' + VARCHAR(CurObject.Card)); 
      RETURN PU_CANCEL;
   ELSE
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN PU_OK;
END;

METHOD IsLinkedToOutageRequest (
) = 
DECLARE
   x = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CurObject.CardClass = Type$TFMSSchd THEN
      /* 
      ** Is there a work permit on the card ?
      */
      x = 0;
      SELECT :x = COUNT(*)
      FROM   SOA_JobControl JC
      WHERE  JC.Card = :CurObject.Card AND
             JC.StepPair IN (:StepHeading$WorkPermit, :StepHeading$TestPermit);
      CALLPROC DDB_ROLLBACK;
      
      IF x = 0 THEN
         RETURN TRUE;
      ENDIF;

      x = 0;
      SELECT :x = 1 
      FROM   SOA_JobControl JC,
             SOA_OutageRequestPermit P
      WHERE JC.Card = :CurObject.Card AND
            JC.Job = P.PermitJobID;
      CALLPROC DDB_ROLLBACK;

      IF x = 0 THEN
         MESSAGE 'No work permit on this card is linked to an Outage Request. ' + 
                 'A SCHD card cannot be activated until at least one work permit ' + 
                 'is linked to an Outage Request';
         RETURN FALSE;     
      ENDIF;
   ENDIF;
   
   RETURN TRUE;
END;

