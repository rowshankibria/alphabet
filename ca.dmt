/**-------------------------------------------------------------------------
** Card and work permit processing
**--------------------------------------------------------------------------*/
ON SETVALUE Selected.EquipName, 
ON CLICK Find_Btn = 
DECLARE
   EquipFound = INTEGER NOT NULL WITH DEFAULT;
   FindRow = INTEGER NOT NULL WITH DEFAULT;
   Match = VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
   IF CurFrame.ReasonCode <> RC_RETURN AND
      CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
/*  
** Find specific equipment.
** Refocus on the equipment name field 
*/
/*
**  Reset selection fields and 
**  move first found equipment to top of table
*/
   Selected.Equip = 0;
   Selected.SubstationName = '';
   Selected.Substation = 0;
   Selected.PrintId = '';
   Selected.EquipClassName = '';
   Selected.Description = '';
   
   CurFrame.InputFocusField = FIELD(Exit_Btn);

   EquipFound = FALSE;
   IF Selected.EquipName = '' THEN
      Message 'Please enter the equipment name to find';
      RESUME;
   ENDIF;
/*
** Start Find from currently displayed top row
*/
   FindRow = FIELD(SelectEquip).TopRow;
   IF FindRow = 0 THEN
      MESSAGE 'Equipment list is empty. Nothing to find.';
      RESUME;
   ENDIF;
 
   i = FindRow + 1;
   Match = '%' + UpperCase (Selected.EquipName) + '%';
   WHILE i <= SelectEquip.LastRow() DO
       IF UpperCase(SelectEquip[i].EquipName) like Match THEN
           EquipFound = TRUE;
           Endloop;
       ENDIF;
       i = i + 1;
   ENDWHILE;
/*
** If not found, continue search from Top if we didn't already
*/
   IF EquipFound = FALSE THEN
      IF FindRow = 1 THEN
         Message 'Equipment not found';
         RESUME;
      ELSE
         i = 1;
         WHILE i <= FindRow DO
            IF UpperCase(SelectEquip[i].EquipName) like Match THEN
               EquipFound = TRUE;
               Endloop;
            ENDIF;
            i = i + 1;
         ENDWHILE;
      ENDIF;
   ENDIF;

   IF EquipFound = TRUE THEN 
      Field(SelectEquip).ActiveRow = i;
   ELSE        
      Message 'Equipment not found';
   ENDIF;
   RESUME;
END;

