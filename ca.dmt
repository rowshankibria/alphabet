**  Application:    CAC
**  Frame:          BusFaultOutage
**
**  Date:       Version Description
** ----------------------------------
** 05/02/09  pkw  Added LoadRelays
** 05/12/09  ysp  Delete feeders associated with bus section outage after switchingitem is closed.
** 05/13/09  em   Addd ClosedFeederBreakers attribute 
** 06/10/10  ysp  Add NWList attribute for associated networks
** 07/02/10  ysp  delete the bus section from the web service when Bus Section outage switching 
**                item is closed.
** 06/22/12  ysp  Add more columns for the new matrix. The old Backup Timer column is replaced by
**                Fdr Bkr Backup Timer (aka FBMPR). But, for now, keep Backup Timer 
**                attributes in the class because BFC web service still uses these attributes.
** 11/05/12  em   On GetConnected... call, SourcePos attribute will contain Alternate Source Boolean
**                if TRUE can be ignored here. 
** 02/03/15  ysp  Support of "high load" matrix. Add GetMatrixType method.
** 03/04/15  ysp  Return default matrix type from GetMatrixType method. ConEd scraps the requirement.
*/
METHOD CloseSwitchingItem(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   BFCMatrix = BusFaultCorrelation_ASE;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :CurObject.Substation = B.Substation,
          :CurObject.SwitchingItem = B.SwitchingItem,
          :CurObject.CreationTime = B.CreationTime,
          :CurObject.BusSection = B.BusSection,
          :CurObject.ClFdrBkr = B.ClFdrBkr,
          :CurObject.ClFdrBkrs = B.ClFdrBkrs,
          :CurObject.ClFdrBkrLastUpd = B.ClFdrBkrLastUpd,
          :CurObject.BDPhaseA = B.BDPhaseA,
          :CurObject.BDPhaseB = B.BDPhaseB,
          :CurObject.BDPhaseC = B.BDPhaseC,
          :CurObject.BDRelayName = B.BDRelayName,
          :CurObject.BDLastUpd = B.BDLastUpd,
          :CurObject.BOCPhaseA = B.BOCPhaseA,
          :CurObject.BOCPhaseB = B.BOCPhaseB,
          :CurObject.BOCPhaseC = B.BOCPhaseC,
          :CurObject.BOCPhaseN = B.BOCPhaseN,
          :CurObject.BOCRelayName = B.BOCRelayName,
          :CurObject.BOCLastUpd = B.BOCLastUpd,
/*
          :CurObject.BUTOperated = B.BUTOperated,
          :CurObject.BUTRelayName = B.BUTRelayName,
          :CurObject.BUTLastUpd = B.BUTLastUpd,   
*/ 
          :CurObject.BUTOperated = B.FBMPR,
          :CurObject.BUTRelayName = B.FBMPRValue,
          :CurObject.BUTLastUpd = B.FBMPRTime,   

          :CurObject.FTFeeder = B.FTFeeder,
          :CurObject.FTPhaseA = B.FTPhaseA,
          :CurObject.FTPhaseB = B.FTPhaseB,
          :CurObject.FTPhaseC = B.FTPhaseC,
          :CurObject.FTPhaseN = B.FTPhaseN,
          :CurObject.FTRelayName = B.FTRelayName,
          :CurObject.FTLastUpd = B.FTLastUpd,
          :CurObject.VBFault = B.VBFault,
          :CurObject.VBFDescription = B.VBFDescription,
          :CurObject.VBFLastUpd = B.VBFLastUpd,
          :CurObject.PQFound = B.PQFound,
          :CurObject.PQValue = B.PQValue,
          :CurObject.PQTime = B.PQTime,

          :CurObject.PQRMSFound = B.PQRMSFound, 
          :CurObject.PQRMSValue = B.PQRMSValue,     
          :CurObject.PQRMSTime = B.PQRMSTime,

          :CurObject.FBMPR = B.FBMPR,          
          :CurObject.FBMPRValue = B.FBMPRValue,     
          :CurObject.FBMPRTime = B.FBMPRTime,      
          :CurObject.FBLOR = B.FBLOR,          
          :CurObject.FBLORValue = B.FBLORValue,     
          :CurObject.FBLORTime = B.FBLORTime,      
          :CurObject.BBMPR = B.BBMPR,          
          :CurObject.BBMPRValue = B.BBMPRValue,     
          :CurObject.BBMPRTime = B.BBMPRTime,      
          :CurObject.BBLOR = B.BBLOR,          
          :CurObject.BBLORValue = B.BBLORValue,     
          :CurObject.BBLORTime = B.BBLORTime,      
      
          :CurObject.MHEvent = B.MHEvent,        
          :CurObject.MHDescription = B.MHDescription, 
          :CurObject.MHLastUpd = B.MHLastUpd,     
          :CurObject.VFFOD = B.VFFOD,          
          :CurObject.VFFDescription = B.VFFDescription, 
          :CurObject.VFFLastUpd = B.VFFLastUpd,     
          
          :CurObject.Action = B.CorrelationAction
   FROM   SOA_BusFaultOutage B
   WHERE  B.SwitchingItem = :CurObject.SwitchingItem;
   CALLPROC DDB_ROLLBACK;
   
   SELECT :CurObject.FTFeederName = O.Name
   FROM   UDB_Object O
   WHERE  O.Object = :CurObject.FTFeeder;

/*
** save the final recommendation with the bus fault outage
*/
   BFCMatrix.MatrixType = CurObject.GetMatrixType(); 
   BFCMatrix.LoadMatrix();

   CurObject.EvaluateCondition();
   BFCMatrix.GetRecommendation(BFCCond = ByRef(CurObject));

   RetCode = CALLPROC SOA_BFCorrActionUpd(
                          SwitchingItem = CurObject.SwitchingItem,
                          CorrelationAction = CurObject.Action);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'BusFaultOutageClass.CloseSwitchingItem; Error closing Bus Fault Correlation.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : BusFaultOutageClass.CloseSwitchingItem; ' + 
                'Error executing SOA_BFCorrActionUpd for switching item: ' + VARCHAR(CurObject.SwitchingItem));
   ENDIF;

   RetCode = CALLPROC SOA_BusFaultFeederDel (SwitchingItem = CurObject.SwitchingItem);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'BusFaultOutageClass.CloseSwitchingItem; Error deleting feeders associated with Bus section outage.';
      CurMethod.Trace(Text = varchar(date('now')) + ' : BusFaultOutageClass.CloseSwitchingItem; ' + 
                'Error executing SOA_BusFaultFeederDel for switching item: ' + VARCHAR(CurObject.SwitchingItem));
   ENDIF;
/*
** Remove the bus section from the web service
*/
   RetCode = CALLPROC SOA_NetworkBusDel(BusSection = CurObject.BusSection);

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace(Text = varchar(date('now')) + ' : BusFaultOutageClass.CloseSwitchingItem; ' + 
                'Error deleting bus section from BFC web service for switching item: ' + VARCHAR(CurObject.SwitchingItem));
   ENDIF;
END;

METHOD EvaluateCondition(
)= 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   CondSum = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;   
   CurObject.ErrorMessage = '';

// Fdr Bkr Failure Timer MPR
   IF CurObject.FBMPR = -1 THEN
      CurObject.FBMPRText = '';
   ELSEIF CurObject.FBMPR = 0 THEN
      CurObject.FBMPRText = 'No';
   ELSE
      CurObject.FBMPRText = 'Yes';
   ENDIF; 

// Fdr Bkr Failure Timer LOR
   IF CurObject.FBLOR = -1 THEN
      CurObject.FBLORText = '';
   ELSEIF CurObject.FBLOR = 0 THEN
      CurObject.FBLORText = 'No';
   ELSE
      CurObject.FBLORText = 'Yes';
   ENDIF; 

// Bus Bkr Failure Timer MPR
   IF CurObject.BBMPR = -1 THEN
      CurObject.BBMPRText = '';
   ELSEIF CurObject.BBMPR = 0 THEN
      CurObject.BBMPRText = 'No';
   ELSE
      CurObject.BBMPRText = 'Yes';
   ENDIF; 
   
// BUS Bkr Failure Timer LOR
   IF CurObject.BBLOR = -1 THEN
      CurObject.BBLORText = '';
   ELSEIF CurObject.BBLOR = 0 THEN
      CurObject.BBLORText = 'No';
   ELSE
      CurObject.BBLORText = 'Yes';
   ENDIF; 

   // Bus Differential
   IF CurObject.BDPhaseA = 1 THEN
      CurObject.BDText = 'A';
   ENDIF;
   IF CurObject.BDPhaseB = 1 THEN
      CurObject.BDText = CurObject.BDText + 'B';
   ENDIF;
   IF CurObject.BDPhaseC = 1 THEN
      CurObject.BDText = CurObject.BDText + 'C';
   ENDIF;
   IF CurObject.BDText <> '' THEN
      CurObject.BDText = 'PH:' + CurObject.BDText;
   ENDIF;
   CondSum = CurObject.BDPhaseA + CurObject.BDPhaseB + CurObject.BDPhaseC;

   IF CondSum = -3 THEN
      CurObject.BDFound = -1;
   ELSEIF CondSum = 0 THEN
      CurObject.BDFound = 0;
   ELSE
      CurObject.BDFound = 1;
   ENDIF;

// Bus Overcurrent
   IF CurObject.BOCPhaseA = 1 THEN
      CurObject.BOCText = 'A';
   ENDIF;
   IF CurObject.BOCPhaseB = 1 THEN
      CurObject.BOCText = CurObject.BOCText + 'B';
   ENDIF;
   IF CurObject.BOCPhaseC = 1 THEN
      CurObject.BOCText = CurObject.BOCText + 'C';
   ENDIF;
   IF CurObject.BOCPhaseN = 1 THEN
      CurObject.BOCText = CurObject.BOCText + 'N';
   ENDIF;
   IF CurObject.BOCText <> '' THEN
      CurObject.BOCText = 'PH:' + CurObject.BOCText;
   ENDIF;
   CondSum = CurObject.BOCPhaseA + CurObject.BOCPhaseB + CurObject.BOCPhaseC + CurObject.BOCPhaseN;

   IF CondSum = -4 THEN
      CurObject.BOCFound = -1;
   ELSEIF CondSum = 0 THEN
      CurObject.BOCFound = 0;
   ELSE
      CurObject.BOCFound = 1;
   ENDIF;

// Backup Timer 
   IF CurObject.BUTOperated = -1 THEN
      CurObject.BUTText = '';
   ELSEIF CurObject.BUTOperated = 0 THEN
      CurObject.BUTText = 'No';
   ELSE
      CurObject.BUTText = 'Yes';
   ENDIF;

// Feeder Target
   IF CurObject.FTPhaseA = 1 THEN
      CurObject.FTText = 'A';
   ENDIF;
   IF CurObject.FTPhaseB = 1 THEN
      CurObject.FTText = CurObject.FTText + 'B';
   ENDIF;
   IF CurObject.FTPhaseC = 1 THEN
      CurObject.FTText = CurObject.FTText + 'C';
   ENDIF;
   IF CurObject.FTPhaseN = 1 THEN
      CurObject.FTText = CurObject.FTText + 'N';
   ENDIF;
   IF CurObject.FTText <> '' THEN
      CurObject.FTText = 'PH:' + CurObject.FTText;
   ENDIF;
   CondSum = CurObject.FTPhaseA + CurObject.FTPhaseB + CurObject.FTPhaseC + CurObject.FTPhaseN;

   IF CondSum = -4 THEN
      CurObject.FTFound = -1;
   ELSEIF CondSum = 0 THEN
      CurObject.FTFound = 0;
   ELSE
      CurObject.FTFound = 1;
   ENDIF;

// Closed Feeder Breaker
   IF CurObject.ClFdrBkr = 0 THEN
      CurObject.ClFdrBkrText = 'No';
   ELSE
      CurObject.ClFdrBkrText = 'Yes';
   ENDIF; 
      
// visible bus fault
   IF CurObject.VBFault = -1 THEN
      CurObject.VBFText = '';
   ELSEIF CurObject.VBFault = 0 THEN
      CurObject.VBFText = 'No';
   ELSE
      CurObject.VBFText = 'Yes';
   ENDIF; 

// PQ RTF
   IF CurObject.PQFound = -1 THEN
      CurObject.PQText = '';
   ELSEIF CurObject.PQFound = 0 THEN
      CurObject.PQText = 'No';
   ELSE
      CurObject.PQText = 'Yes';
   ENDIF; 

// PQ RMS
   IF CurObject.PQRMSFound = -1 THEN
      CurObject.PQRMSText = '';
   ELSEIF CurObject.PQRMSFound = 0 THEN
      CurObject.PQRMSText = 'No';
   ELSE
      CurObject.PQRMSText = 'Yes';
   ENDIF; 

   // Manhole Event/Damage
   IF CurObject.MHEvent = -1 THEN
      CurObject.MHText = '';
   ELSEIF CurObject.MHEvent = 0 THEN
      CurObject.MHText = 'No';
   ELSE
      CurObject.MHText = 'Yes';
   ENDIF; 
   
   // Visible Fault FOD
   IF CurObject.VFFOD = -1 THEN
      CurObject.VFFODText = '';
   ELSEIF CurObject.VFFOD = 0 THEN
      CurObject.VFFODText = 'No';
   ELSE
      CurObject.VFFODText = 'Yes';
   ENDIF; 
END;


METHOD LoadRelays(
   SwitchingItem = INTEGER NOT NULL WITH DEFAULT
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   j = INTEGER NOT NULL WITH DEFAULT;
   SourceBreakers   = ARRAY OF Equipment;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN

   CurObject.BusSection = 0;
   i = 1;
   SELECT :CurObject.SwitchingItem = B.SwitchingItem,
          :CurObject.CreationTime = B.CreationTime,
          :CurObject.BusSection = B.BusSection,
          :CurObject.BusSectionName = O.Name,
          :CurObject.BDPhaseA = B.BDPhaseA,
          :CurObject.BDPhaseB = B.BDPhaseB,
          :CurObject.BDPhaseC = B.BDPhaseC,
          :CurObject.BDRelayName = B.BDRelayName,
          :CurObject.BDLastUpd = B.BDLastUpd,
          :CurObject.BDLastUpdBy = B.BDLastUpdBy,
          :CurObject.BOCPhaseA = B.BOCPhaseA,
          :CurObject.BOCPhaseB = B.BOCPhaseB,
          :CurObject.BOCPhaseC = B.BOCPhaseC,
          :CurObject.BOCPhaseN = B.BOCPhaseN,
          :CurObject.BOCRelayName = B.BOCRelayName,
          :CurObject.BOCLastUpd = B.BOCLastUpd,
          :CurObject.BOCLastUpdBy = B.BOCLastUpdBy,

/*        :CurObject.BUTOperated = B.BUTOperated,
          :CurObject.BUTRelayName = B.BUTRelayName,
          :CurObject.BUTLastUpd = B.BUTLastUpd,
          :CurObject.BUTLastUpdBy = B.BUTLastUpdBy,
*/         
          :CurObject.FBMPR = B.FBMPR,
          :CurObject.FBMPRValue = B.FBMPRValue,
          :CurObject.FBMPRTime = B.FBMPRTime,
          :CurObject.FBMPRUpdBy = B.FBMPRUpdBy,
          
          :CurObject.FTFeeder = B.FTFeeder,
          :CurObject.FTPhaseA = B.FTPhaseA,
          :CurObject.FTPhaseB = B.FTPhaseB,
          :CurObject.FTPhaseC = B.FTPhaseC,
          :CurObject.FTPhaseN = B.FTPhaseN,
          :CurObject.FTRelayName = B.FTRelayName,
          :CurObject.FTLastUpd = B.FTLastUpd,
          :CurObject.FTLastUpdBy = B.FTLastUpdBy
   FROM   SOA_BusFaultOutage B,
          Udb_Object O
   WHERE  B.SwitchingItem = :SwitchingItem AND
          B.BusSection = O.Object;
   CALLPROC DDB_ROLLBACK;
   
   IF CurObject.BusSection <> 0 THEN
      /*
      **  Default values are -1 which cause togglefields to show as true when 
      **  the toggle fields should show as false by default.  Values will be 
      **  changed here and the ..hasdatachanged attribute will be set so the 
      **  frame knows to update the values.
      */
      IF CurObject.BDPhaseA = -1 THEN
         CurObject.BDPhaseA = 0;
         CurObject.BDHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BDPhaseB = -1 THEN
         CurObject.BDPhaseB = 0;
         CurObject.BDHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BDPhaseC = -1 THEN
         CurObject.BDPhaseC = 0;
         CurObject.BDHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BOCPhaseA = -1 THEN
         CurObject.BOCPhaseA = 0;
         CurObject.BOCHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BOCPhaseB = -1 THEN
         CurObject.BOCPhaseB = 0;
         CurObject.BOCHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BOCPhaseC = -1 THEN
         CurObject.BOCPhaseC = 0;
         CurObject.BOCHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.BOCPhaseN = -1 THEN
         CurObject.BOCPhaseN = 0;
         CurObject.BOCHasDataChanged = TRUE;
      ENDIF;
/*      
      IF CurObject.BUTOperated = -1 THEN
         CurObject.BUTOperated = 0;
         CurObject.BUTHasDataChanged = TRUE;
      ENDIF;
*/
      IF CurObject.FBMPR = -1 THEN
         CurObject.FBMPR = 0;
         CurObject.FBMPRHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.FTPhaseA = -1 THEN
         CurObject.FTPhaseA = 0;
         CurObject.FTHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.FTPhaseB = -1 THEN
         CurObject.FTPhaseB = 0;
         CurObject.FTHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.FTPhaseC = -1 THEN
         CurObject.FTPhaseC = 0;
         CurObject.FTHasDataChanged = TRUE;
      ENDIF;
      IF CurObject.FTPhaseN = -1 THEN
         CurObject.FTPhaseN = 0;
         CurObject.FTHasDataChanged = TRUE;
      ENDIF;
      /*
      ** The substation in the table is the card substation so it can't be used here 
      ** because it will be the macro station and not the station that is on the 
      ** card.  
      */
      SELECT :CurObject.Substation = G.Grouping
      FROM    Udb_Grouping G,
              Udb_ExtendedType ET
      WHERE   G.Member = :CurObject.BusSection AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = ET.Type AND
              ET.SuperType = :Type$Substation;
      /* 
      ** For feeder source breakers connected to the Bus Section, the Equipment Class PrimaryGrouping
      ** field will contain the Feeder Object and the SourceBkr field will contain the Bus Section Object.
      */
      RetCode = CALLPROC GetConnectedSourceBreakers (BusSection = CurObject.BusSection,
                                          Substation = CurObject.Substation,
                                          SourceBreakers = BYREF(SourceBreakers));

      IF SourceBreakers.LastRow() = 0 THEN
         MESSAGE 'No Feeder Source Breakers are connected to Bus Section: ' + CurObject.BusSectionName;
      ELSE
         j = 1;
         CurObject.FTList.ChoiceItems.Clear();
         CurObject.FTList.ChoiceItems[1].EnumValue = 0;
         CurObject.FTList.ChoiceItems[1].EnumText = '           none';
         j = 2;
         FOR i = 1 TO SourceBreakers.LastRow DO
            IF SourceBreakers[i].PrimaryGrouping <> 0 AND SourceBreakers[i].SourcePos = 0 THEN
               CurObject.FTList.ChoiceItems[j].EnumValue = SourceBreakers[i].PrimaryGrouping;
               CurObject.FTList.ChoiceItems[j].EnumText  = SourceBreakers[i].PrimaryGroupingName;
               j = j + 1;
            ENDIF;
         ENDFOR;
         IF CurObject.FTList.ChoiceItems.LastRow = 0 THEN
            MESSAGE 'No Feeder Source Breakers are connected to Bus Section: ' + CurObject.BusSectionName;
         ENDIF;
      ENDIF;     
   ENDIF;
   RETURN (CurObject.BusSection);
END;

/*
** Return values: 0 - Default Matrix, 1 = Peak Load
*/
METHOD GetMatrixType(
) = 
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   
   LocalSubstation = INTEGER NOT NULL WITH DEFAULT;
   OtherCards = ARRAY OF FMS_Card;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   SourceBreakers = ARRAY OF Equipment;
   PeakLoadForecast = FLOAT NOT NULL WITH DEFAULT;
   PeakLoadThreshold = FLOAT NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
 
   RETURN 0;
   
   
   /* ======================= The following logic becomes obsolete ================================================
   */
   /* The high load matrix will be used when certain peak conditions exist. Peak conditions are currently defined as: 
   ** 1) Peak Load exceeding 10K MW, 
   ** 2) A Bus Outage with other feeders out in the same station.  The Bus Outage must consist of minimum of 
   **    three feeders with at least one other feeder out-of-service in the same station. 
   ** 3) Two or more bus outages in the same station.
   */
   /* 1. is the Peak Load forecast exceeding the threshold?
   */
   SELECT :PeakLoadThreshold = PeakLoadThreshold
   FROM   AllApp_SYSTEMPARAMETERS;
   
   SELECT :PeakLoadForecast = PeakLoad
   FROM   TV_BogeyHistory B
   WHERE  B.LogDate >= date_trunc('day',date('NOW')) AND
          B.LogDate = (SELECT IFNULL(MAX(LogDate),'') 
                       FROM   TV_BogeyHistory);
                       
   IF PeakLoadForecast > PeakLoadThreshold THEN
      RETURN 1;
   ENDIF;
   
   /* 2. Bus Outage with minimum of three feeders and at least one other feeder out-of-service 
   ** in the same station?
   ** Note: the value of the substation field is the SLC card substation. It may be a macro substation.
   ** To do the trace for the connected source breakers, we need to pass the bussection's local substation
   ** which is its primary grouping
   */
   SELECT :LocalSubstation = PrimaryGrouping
   FROM   UDB_Object
   WHERE  Object = :CurObject.BusSection;
   
   RetCode = CALLPROC GetConnectedSourceBreakers (BusSection = CurObject.BusSection,
                                          Substation = LocalSubstation,
                                          SourceBreakers = BYREF(SourceBreakers));
   /* 
   ** Remove non-source breakers (PrimaryGrouping = 0). Source breaker's PrimaryGrouping is the feeder object.
   */
   i = SourceBreakers.LastRow;
   WHILE i >= 1 DO
      IF SourceBreakers[i].PrimaryGrouping = 0 THEN  
         SourceBreakers.RemoveRow(RowNumber = i);
      ENDIF;
      i = i - 1;
   ENDWHILE;
   
   IF SourceBreakers.LastRow >= 3 THEN
      i = 1;
      REPEATED
      SELECT :OtherCards[i].Feeder = O.Object,
             :OtherCards[i].FeederName = O.Name,
             :OtherCards[i].CardClassName = C.CardClassName,
             :OtherCards[i].CutOut = C.Cutout
      FROM   Udb_Grouping G,
             Udb_Object O, 
             TFMS_CardToObject CTO,
             FMS_Card C
      WHERE  G.Grouping = :LocalSubstation AND
             G.Relationship= :Interaction$MemberOf AND
             G.MemberType = :Type$Feeder AND
             G.Member = O.Object AND
             O.Object = CTO.Object AND
             CTO.Card = C.Card AND
             C.Status < :Card$Closed AND
             C.Cutout IS NOT NULL AND C.Cutin IS NULL
      BEGIN
         i = i + 1;
      END;
      
      // remove the feeders that are connected to the bus section.
      FOR i = 1 TO SourceBreakers.LastRow DO
         RetCode = OtherCards.Find(AttributeName = 'feeder', 
                                   Value = SourceBreakers[i].PrimaryGrouping,
                                   RowNumber = ByRef(k));
         IF RetCode = ER_OK THEN
            OtherCards.RemoveRow(RowNumber = k);
         ENDIF;            
      ENDFOR;
      
      // at least one other feeder out-of-service
      IF OtherCards.LastRow >= 1 THEN
         RETURN 1;
      ENDIF;
   ENDIF;
   
   /* 3) Two or more bus outages in the same station?
   */
   k = 0;
         
   SELECT :k = COUNT(B.BusSection)
   FROM  SOA_BusFaultOutage B,
         SOA_Job J, 
         Udb_Object O
   WHERE B.Substation = :CurObject.Substation AND        // need to use CurObject.Substation instead of LocalSubstation.
         B.BusSection <> :CurObject.BusSection AND
         B.BusSection = O.Object AND
         O.PrimaryGrouping = :LocalSubstation AND
         B.SwitchingItem = J.Job AND
         J.SWItemStatus = :Card$Active;
   CALLPROC DDB_ROLLBACK;
   
   IF k >= 1 THEN
      RETURN 1;
   ENDIF;
   
   // Otherwise, default matrix.
   RETURN 0;
END;

Application Component Report
============================

	Name:            BusSectionOutage

/*
**
**	Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software.
**
**  Application:    CAC
**  Frame:          BusSectionOutage
**
**  03/28/03  em    Created
*/

INITIALIZE
(
    ActiveCards = ARRAY OF FMS_Card;

    i	  	= INTEGER NOT NULL WITH DEFAULT;
    RetCode	= INTEGER NOT NULL WITH DEFAULT;
    Substation  = INTEGER NOT NULL WITH DEFAULT;
    Division    = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
END;
/*
**  Handle a Yes click
*/
ON Click YesButton =
BEGIN
/*
** For each card get relevant information to record in DB.
*/
   FOR i = 1 TO ActiveCards.LastRow() DO

      Substation = 0;
      Division = 0;
      REPEATED 
      SELECT  :Substation = AO.Object, 
              :Division = G.Grouping
      FROM    Udb_Grouping G,
              SOA_ActiveObject AO
      WHERE   AO.Card = :ActiveCards[i].Card AND
              AO.ObjectToCardLink = 0 AND    /*This gets the Substation */
              AO.Object = G.Member AND
              G.Relationship = :Interaction$MemberOf AND
              G.GroupingType = :Type$Division;

      IF Substation = 0 OR Division = 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Bus Section Outage could not be recorded for Card ' +
                 VARCHAR(ActiveCards[i].Card) + ':' + 
                 ActiveCards[i].FeederName + ' because a substation or ' +
                 'division is not properly establish in Udb for this feeder.';
      ELSE   

         RetCode = CALLPROC FMS_BusSectionOutageIns (
                     Card = ActiveCards[i].Card,
                     Feeder = ActiveCards[i].Feeder,
                     FeederName = ActiveCards[i].FeederName,
                     Division = Division,
                     Substation = Substation,
                     SubstationName = ActiveCards[i].SubstationName,
                     Position = ActiveCards[i].Position,
                     CardClass = ActiveCards[i].CardClass,
                     CardClassName = ActiveCards[i].CardClassName);

         IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
         ELSE
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'ERROR: Bus Section Outage could not be recorded for ' +
                 'Card ' + VARCHAR(ActiveCards[i].Card) + ':' + 
                  ActiveCards[i].FeederName + ' due to a transaction error.';
         ENDIF;
      ENDIF;
                        
      CALLPROC SOA_LogIns (Card = ActiveCards[i].Card,
                        SwitchingItem = 0,
                        Job = NULL,
                        Time = DATE('now'),
                        UserName = UserName,
                        Item = 'Bus Section',
                        Old = 'Outage recorded as a Bus Section Outage',
                        New = '');   
      CALLPROC DDB_COMMIT;
   ENDFOR;
   
   RETURN;
END;

/*
**  Handle a No click
*/
ON Click NoButton =
BEGIN
   RETURN;
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

