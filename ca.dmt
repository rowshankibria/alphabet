Application Component Report
============================

	Name:            IncompleteStatus

/*
**
**  Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          IncompleteStatus
**
**  Modifications:
**  11/27/98   pkw  modified slc version
**  08/15/05   ysp  Use this frame to create a copy of the return suspended 
**                  work permit.
**  08/30/05   em   Changed outward appearance of screen
**  12/13/05   ysp  Increase local move text variables to varchar(160)
**  03/27/07   em   Will not give option to copy incomplete ISWP
**  01/11/08   em   For a suspended permit, don't parse away the job id. 
**  05/12/08   em   Add KeepPermitID parameter because SuspendedOrder may be 0
**                  for verbal permit completion.
**  05/13/08   em   Enhance WPCopy to include WP Sequence when Keeping Permit ID
**  08/18/08   em   New parameters added to support CanReturnToService information display.
**  10/15/08   em   Enable Copy option for FMS permits so that FMS is consistent with TOMS
**  10/19/08   em   Remove N/A option
**  03/13/18   em   Add OFSPhaseCheckIndicator parm to distinguish OFS permit with impacted equip
**  03/25/21   em   Remove OS*WP code
**  02/03/23   em   Add CPM Checklist
**  02/09/23   em   Need to Process CPM on No click
*/

INITIALIZE
(
    J = JobInProgress;     /* Job being processed */
    OFSPhaseCheckIndicator = INTEGER NOT NULL WITH DEFAULT;    /* Optional Passed*/ 
    SuspendedOrder = INTEGER NOT NULL WITH DEFAULT;  /* Optional Passed: returned suspended Operating Order*/ 
    InhibitScreen = INTEGER NOT NULL WITH DEFAULT;   /* Optional Passed*/ 
    KeepPermitID = INTEGER NOT NULL WITH DEFAULT;    /* Optional Passed*/ 
    Application = VARCHAR(20) NOT NULL WITH DEFAULT; /* Optional Passed*/
    CanReturnToService = CHAR(3) NOT NULL WITH DEFAULT; /* Optional Passed*/   

    EventText            = VARCHAR(256) NOT NULL WITH DEFAULT; /*Includescr*/
    CPMPermit = INTEGER NOT NULL WITH DEFAULT;  
    CPMNote = INTEGER NOT NULL WITH DEFAULT;  /* Also Passed Back as a ByRef parm */
    Idx                  = ARRAY OF IntegerObject; /*Track impacted cards*/
    ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
    InsertionList        = ARRAY OF NewMoveCard;/*List of cards to insert move*/
    ISPermit    	= INTEGER NOT NULL WITH DEFAULT; /* If a ISWP */
    i = INTEGER;                /* Scratch integer */
    k = INTEGER;                /* Scratch integer */
    KeepSeq = INTEGER NOT NULL WITH DEFAULT;
    OldTOMove = Varchar(160) NOT NULL WITH DEFAULT;
    OldRSMove = Varchar(160) NOT NULL WITH DEFAULT;
    MoveSeq = VARCHAR(11);
    n = INTEGER;                /* Scratch integer */
    NewJob = JobInProgress;     /* New job to be added */
    RetCode = INTEGER;
    Seq = INTEGER NOT NULL WITH DEFAULT;
    TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   IF InhibitScreen = TRUE THEN
       CurFrame.WindowVisibility = WV_INVISIBLE;
   ENDIF;

   ISPermit = 0;
   SELECT :ISPermit = ISPermit
   FROM   SOA_InServicePermit
   WHERE  Job = :J.Job;

   IF ISPermit <> 0 AND OFSPhaseCheckIndicator = 0 THEN
      RETURN (PU_OK);
   ENDIF;
   
   CPMPermit = 0;
   SELECT :CPMPermit = JobClass
   FROM   FMS_JobAction 
   WHERE  JobClass = :J.JobClass AND
          Status = :Prompt$CPMCheckList;
          
   IF CPMPermit > 0 THEN
      FIELD(CPM).CurBias = FB_CHANGEABLE;
   ENDIF;

   Job[1] = J.Duplicate();
/*
**  Figure out what the sequence of the permit is as well as if the sequence
**  is displayed at the front of the move
*/
   Seq = 0;
   SELECT  :Seq = Sequence
   FROM    SOA_WorkPermit
   WHERE   PermitJobID = :J.Job;

   MoveSeq = Squeeze(Left(J.TOMove,Locate(J.TOMove,'-')-1));

/*
**  Initialize Old(TO/RS)Move fields
*/
   OldTOMove = J.TOMove;
   OldRSMove = J.RSMove;

   RetCode = ParseTextForInteger(ParseText = MoveSeq);
   IF (RetCode = TRUE) AND KeepPermitID = FALSE THEN
      IF (Int4(MoveSeq) = Seq) THEN
         OldTOMove = Right(J.TOMove,Length(J.TOMove)-Locate(J.TOMove,'-'));
         OldRSMove = Right(J.RSMove,Length(J.RSMove)-Locate(J.RSMove,'-'));
      ENDIF;
   ENDIF;

   IF KeepPermitID = TRUE THEN
      KeepSeq = Seq;
   ELSE 
      KeepSeq = 0;
   ENDIF;
/*
** Figure out display of Restore to Service information.
*/
   IF CanReturnToService = '' THEN
      FIELD(VerbalCheck).CurBias = FB_CHANGEABLE;
      FIELD(Restore_stk).CurBias = FB_INVISIBLE;    
   ELSE
      FIELD(VerbalCheck).CurBias = FB_INVISIBLE;
      IF CanReturnToService = 'YES' THEN
         FIELD(Restore_stk.can_restore).CurBias = FB_VISIBLE;
         FIELD(Restore_stk.cannot_restore).CurBias = FB_INVISIBLE;
      ELSE
         FIELD(Restore_stk.can_restore).CurBias = FB_INVISIBLE;
         FIELD(Restore_stk.cannot_restore).CurBias = FB_VISIBLE;
      ENDIF;
   ENDIF;

   IF InhibitScreen = TRUE THEN
       FIELD(VerbalCheck).CurBias = FB_INVISIBLE;
       CurFrame.SendUserEvent (EventName = 'Generate_A_Copy');
   ENDIF;
END;

ON UserEvent 'Generate_A_Copy',
ON Click Copy_stk.OK_Btn =
BEGIN
   IF FIELD(VerbalCheck).CurBias = FB_CHANGEABLE THEN
      IF VerbalCheck.RestoreEquip < 1 OR VerbalCheck.RestoreEquip > 3 THEN 
         MESSAGE 'Please indicate whether equipment can be returned to service';
         RESUME;
      ENDIF; 
   ENDIF;

#  INCLUDE ProcessCPMCheckList  
/*
**  Copy and create job
*/
   NewJob = J.Duplicate();
   NewJob.TOMove = OldTOMove;
   NewJob.RSMove = OldRSMove;
   NewJob.TOOperator = NULL;
   NewJob.TOIssued = NULL;
   NewJob.RSComplete = NULL;
   NewJob.RSOperator = NULL;
   NewJob.Response = '';
   NewJob.WorkStatus = '';
   NewJob.Status = '';
   NewJob.Job = -1;

   NewJob.Job = NewJob.InsertJob (Card = NewJob.Card);
   IF NewJob.Job < 0 THEN      
      MESSAGE 'Frame:IncompleteStatus; Job Insertion failed.';
      RETURN PU_CANCEL;
   ENDIF;
/*
**  Get typeofcard
*/
   SELECT :TypeOfCard = TypeOfCard
   FROM   SOA_ActiveCard AC
   WHERE  Card = :NewJob.Card;
   CALLPROC DDB_ROLLBACK;
/*
**  Insert Control entries for move
*/
   InsertionList[1].Card = NewJob.Card;
   InsertionList[1].SwitchingItem = NewJob.SwitchingItem;
   InsertionList[1].Application = CurrentApplication;
   InsertionList[1].StepHeading = NewJob.StepPair;
   InsertionList[1].TypeOfCard = TypeOfCard;
   Insertionlist[1].MoveEquipClass = NewJob.MoveEquipClass;
   Insertionlist[1].StepLevel = 0;
   Insertionlist[1].PrintID = NewJob.PrintID;

   RetCode = NewJob.InsertControl (
            ControlEntry = InsertionList[1],
            InitiatingCard = NewJob.Card);
   IF RetCode = PU_CANCEL THEN
      MESSAGE 'Frame:IncompleteStatus; Error inserting control entries for a ' +
              'move.';
      RESUME;
   ENDIF; 

   IF NewJob.Equip <> 0 THEN

      Idx.Clear();
      Idx = CALLPROC CascadeMoves (Move = NewJob,
                                   Card = NewJob.Card
                                   );

#     include ManageImpactedCards

   ENDIF;

#  include NotifyImpactedCards
  
/*
**  Copy WorkPermits from old work permit to new one.
*/
   IF CurrentApplication = Application$FMS THEN
      RetCode = CALLPROC FMS_WorkPermitCopy
                 (Card = J.Card,
                  OldWorkPermit = J.Job,
                  NewWorkPermit = NewJob.Job);
   ELSE
      RetCode = CALLPROC SOA_WorkPermitCopy
            (Card = J.Card,
             OldWorkPermit = J.Job,
             NewWorkPermit = NewJob.Job,
             PermitSeq = KeepSeq);
   ENDIF;

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to copy permit detail and protections to new work permit.';
      RETURN (PU_CANCEL);
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF SuspendedOrder > 0 THEN
      RetCode = CALLPROC  SOA_SetSuspendedPermit ( 
                       PermitJobID = NewJob.Job, 
                       SuspendedPermit = J.Job,         /* Original TOMS Permit that was Suspended */
                       SuspendedOrder = SuspendedOrder  /* Order number for suspended permit */  
                       );
      CALLPROC DDB_COMMIT;
      IF RetCode < 0 THEN
         Message 'A new work permit has been created. But the reference to the suspended permit ' + 
                 'is not set. Please report this problem to FMS staff.';
      ENDIF;
   ENDIF;
   RETURN (PU_OK);
END;

ON SETVALUE VerbalCheck.RestoreEquip =
BEGIN
   IF VerbalCheck.RestoreEquip = 1 THEN
      CanReturnToService = 'YES';
   ELSEIF VerbalCheck.RestoreEquip = 2 THEN
      CanReturnToService = 'NO';
   ELSE
      CanReturnToService = '';
   ENDIF;
END;



ON Click Copy_stk.Cancel_Btn =
BEGIN
   IF FIELD(VerbalCheck).CurBias = FB_CHANGEABLE THEN
      IF VerbalCheck.RestoreEquip < 1 OR VerbalCheck.RestoreEquip > 3 THEN 
         MESSAGE 'Please indicate whether equipment can be returned to service';
         RESUME;
      ENDIF; 
   ENDIF;
#  INCLUDE ProcessCPMCheckList  
   RETURN (PU_OK);
END;


ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
