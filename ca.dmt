Application Component Report
============================

	Name:            ProcessIndicator

/*
**
**      Copyright c 1993 ESCA Corporation  All rights reserved.
**
**      ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of ESCA Corporation.
**
**  Application:    Feedercard
**  Frame:          ProcessIndicator
**
**  Date:           Version  Description
** --------------------------------------------------
**  07/31/95        pkw      created to show how much of process has been completed
**  07/20/06        em       Added Curframe.Flush() to try to fix the refresh.
**  03/12/07        pkw      Use float number to address sp3 problem.
**  05/14/13        pkw      Update expression for Pct_Bar due to upgrade to 
**                           OpenROAD 6.0.1.
**  05/03/15        pkw      Add Delay event called from CreateKnownPointSplice
*/
INITIALIZE
(
    ParentFrame = FrameExec;		/* Calling frame */
    MaxValue = INTEGER NOT NULL;
    CurrentValue = INTEGER NOT NULL;
    CurDelay = INTEGER NOT NULL;
    Pct_Title = VARCHAR(100) NOT NULL;
) = 
BEGIN 
    FIELD(Title).TextValue = Pct_Title;
    Pct_Bar = int4(100.00/MaxValue);
    Pct_Value = varchar(Pct_Bar) + '%';
    StackField(Field(Pct_Value).ParentField).AbsYBottom = Field(Pct_Template).AbsYBottom;
    StackField(Field(Pct_Value).ParentField).AbsXLeft = Field(Pct_Bar).AbsXLeft + 
                                   (Field(Pct_Bar).Width * 1.00/MaxValue) - 
                                    Field(Pct_Value).Width/2;
    CurFrame.SendUserEvent (EventName = 'Send_Event');
END;

ON USEREVENT 'Send_Event' = 
BEGIN
    ParentFrame.SendUserEvent (EventName = 'Received');
END;

ON USEREVENT 'Update_Delayed' = 
BEGIN
    CurDelay = CurFrame.MessageInteger;
    CurFrame.SendUserEvent (EventName = 'Update_Percent',
                                        MessageInteger = CurrentValue + 1,
                                        Delay = CurDelay);
                            
END;

ON USEREVENT 'Update_Percent' = 
BEGIN
	CurrentValue = CurFrame.MessageInteger;

    IF CurrentValue >= MaxValue THEN
/*
**  If this is the last thing than show as 99% done.
*/
        Pct_Bar = 99;
        Pct_Value = varchar(Pct_Bar) + '%';
        StackField(Field(Pct_Value).ParentField).AbsYBottom = Field(Pct_Template).AbsYBottom;
        StackField(Field(Pct_Value).ParentField).AbsXLeft = Field(Pct_Bar).AbsXLeft + 
                                       (Field(Pct_Bar).Width * .99) - Field(Pct_Value).Width/2;

        ParentFrame.SendUserEvent (EventName = 'Received');
        RESUME;
    ENDIF;

    Pct_Bar = int4(Float8(CurrentValue)/MaxValue * 100);
    Pct_Value = varchar(Pct_Bar) + '%';
    StackField(Field(Pct_Value).ParentField).AbsYBottom = Field(Pct_Template).AbsYBottom;
    StackField(Field(Pct_Value).ParentField).AbsXLeft = Field(Pct_Bar).AbsXLeft + 
                                   (Field(Pct_Bar).Width * Float8(CurrentValue)/MaxValue) - 
                                    Field(Pct_Value).Width/2;
    ParentFrame.SendUserEvent (EventName = 'Received');
    CurFrame.Flush();
END;

ON WINDOWCLOSE =
BEGIN
    RESUME;
END;

Application Component Report
============================

	Name:            Prompt229Completion

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Cegelec ESCA Corporation proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    Transmission Card
**  Frame:          Prompt229Completion
**
**  Modifications:
**  1/24/96    ysp  Initial version
**  10/31/02  em    Job to JIP. 
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    Cnt = INTEGER;  
    CardStr = VARCHAR(10) NOT NULL WITH DEFAULT;
    TFMSCard = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   TFMSCard = 0;
   SELECT :TFMSCard = AC.Card
   FROM   SOA_JobControl JC,
          SOA_ActiveCard AC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Application = :Application$TFMS;
  
   IF TFMSCard = 0 THEN
      RETURN(PU_OK);
   ENDIF;

   Cnt = 0;
   REPEATED
   SELECT :Cnt = Count(*)
   FROM   SOA_JobControl JC,
          SOA_Job J 
   WHERE  JC.Card = :TFMSCard
     AND  JC.Job = J.Job
     AND  J.Status = ''
     AND  J.TOComplete IS NULL
     AND  J.JobClass = :JobClass$229B;

   IF Cnt = 0 THEN
      CardStr = VarChar(TFMSCard);
      RAISE DBEVENT TFMS_229_Completion :CardStr;
      CALLPROC DDB_COMMIT;
   ENDIF;

   RETURN (PU_OK);
END;

