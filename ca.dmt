          C.Card = CTO.Card AND
          CTO.Object = O.Object AND
          O.PrimaryGrouping = OO.Object AND
          OO.Type = ET.Type AND
          ET.SuperType = :Type$Substation 
   UNION
   SELECT C.Card,
          :TM$TVDelay,
          T.Description,
          OO.Object,
          C.Feeder,
          C.FeederName,
          C.CardClass,
          C.CardClassName,
          0,
          OSS.OperatingStep,
          OSS.StartTime
   FROM   FMS_Card C,
          TFMS_CardToObject CTO,
          FMS_OperatingStepStatus OSS,
          Udb_SuperType ST,
          Udb_Type T,
          Udb_Object O,
          Udb_Object OO
   WHERE  C.Status < :Card$Closed AND
          C.TV_Bogey > 0 AND 
          C.CutOut IS NOT NULL AND
