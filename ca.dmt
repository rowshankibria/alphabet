	Name:            DetermineLineScope

/*
**
**	Copyright c 1999 ALSTOM ESCA, Inc.  All rights reserved.
**
**	ALSTOM ESCA, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of ALSTOM ESCA, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          DetermineLineScope
**
**  Modifications:
**   11/11/99   em   Created
**   09/21/00   em   If CardClass = AUTO, then we can't allow line segs that
**                   are on an active card since the Auto card will be activated
**                   in a short while.
**   11/15/00   em   Corrected errors clearing LineList array.
*/
INITIALIZE
(
#  include StandardDeclarations
   
   CardClass = INTEGER NOT NULL;       /*Passed CardClass*/  
   j = INTEGER NOT NULL WITH DEFAULT;  /*Index*/ 
) =
BEGIN
/*
** BaseType field has been used to show whether line is on another card.
*/
   j = 0;
   FOR i = 1 TO LineList.LastRow() DO
      IF LineList[i].BaseType = TRUE THEN
         j = j + 1;
         ActiveLines.InsertRow (RowNumber = j, 
                                RowObject = LineList[i].Duplicate());
      ENDIF;
   ENDFOR;    
   IF j = 0 THEN
      RETURN;
   ENDIF;   
END;


ON CHILDSETVALUE ActiveLines[*].BaseType =
BEGIN
/* 
** Manipulate Line List based on RadioField changes
*/
   IF ActiveLines[].BaseType = TRUE THEN
      LineList.InsertRow (RowNumber = 1,
                          RowObject = ActiveLines[].Duplicate());
   ELSE
      FOR i = 1 TO LineList.LastRow() DO
         IF ActiveLines[].Object = LineList[i].Object THEN
 
            LineList.RemoveRow (RowNumber = i);
         ENDIF;
      ENDFOR;
   ENDIF;
   CurFrame.Flush();
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN
/*
** If cardclass = AUTO, don't let any active lines remain on the new card.
*/
    IF CardClass = Type$TFMSAuto THEN
       FOR i = 1 TO ActiveLines.LastRow() DO
          IF ActiveLines[i].BaseType = TRUE THEN
             MESSAGE 'Since this is an Open Auto card, you will have to mark ' +
                     'all currently active lines as "NO".';
             ActiveLines[i].BaseType = FALSE;
             FOR j = 1 TO LineList.LastRow() DO
                 IF ActiveLines[i].Object = LineList[j].Object THEN 
                    LineList.RemoveRow (RowNumber = j);
                 ENDIF;
             ENDFOR;
             RESUME;
             ENDLOOP;
          ENDIF;
       ENDFOR;    
    ENDIF;
    RETURN;
END;




ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

