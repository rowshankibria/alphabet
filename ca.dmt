PROCEDURE TraceError (
   TraceMessage		= VARCHAR(1000) NOT NULL WITH DEFAULT;
   UserMessage		= VARCHAR(1000) NOT NULL WITH DEFAULT; /*Optional*/
) =
BEGIN
   IF  AutomaticExecution = FALSE AND 
       DDB_Global.InhibitMessages = FALSE AND
          UserMessage <> '' THEN
       CALLFRAME DDB_Message(MessageText = UserMessage);
   ENDIF;

   DDB_Global.TopFrame.Trace
          (   Text =  varchar(date('now')) + ':ERROR: ' + TraceMessage 
          );
END;

Application Component Report
============================

	Name:            TransferControl

/*
**
**      Copyright c 2002 Pateric Software LLC,  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software.
**
*/
/*
**  Application:    FMS
**  Frame:          TransferControl
**
**  Date:       Author   Description
**
**  07/22/02    ysp      Merge: Copied from SOA. Add FMS Card Control 
**                       event handler. 
**  08/26/02    ysp      Added control tranfer for dropped equipment.
**  01/14/03    pkw      MERGE with soa version.
**  01/18/03    pkw      No longer look for shared moves since SLC could
**                       have control of equipment and not be common with
**                       FMS.  
**  02/03/03    em	 Changed Item 'Transfer Control' to 'Xfer Control'
**  02/13/03    pkw      Make sure we don't allow transfer to closed 
**                       switching items and select printid of control card
**                       separately since value can be different on different
**                       job control entries.
**  05/12/05    em       Changed operating order check and message that validates
**                       control transfer.
**  07/07/06    ysp      ITC 184: Make sure equipment does not have moves on an outstanding
**                       order.
**  07/25/14    em       Add PrimaryGroupingName column for DSO
**  09/12/18    em       Don't allow control transfer of MicroGrid Equipment
*/
INITIALIZE 
(
#  include StandardDeclarations

/* passed in */
   Card  		= INTEGER NOT NULL;  /*Passed Card*/
   NoShadowOption	= INTEGER NOT NULL WITH DEFAULT; /*Don't display shadow items as valid transfer options */
   Equip                = INTEGER NOT NULL;      /* optional */
   SwitchingItem        = INTEGER NOT NULL WITH DEFAULT; /* optional */

/* Local variables */
   ConfirmTransferFlag  = INTEGER NOT NULL WITH DEFAULT; /*Select/Confirm Mode*/
   ControlledEquip      = ARRAY OF ControlEquip; /*Default List*/
   EquipList            = ARRAY OF ControlEquip;
   EventText            = VARCHAR(100) NOT NULL WITH DEFAULT; /* DBEvent text*/
   ExcludeRow           = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   ImpactedCardList     = ARRAY OF INTEGEROBJECT; /*Other cards to reload */
   j   			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   k  			= INTEGER NOT NULL WITH DEFAULT; /*Counter*/
   MicroGrid            = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   SelectedEquip        = ARRAY OF ControlEquip;          /*SelectedList*/
   ShadowItem           = INTEGER NOT NULL WITH DEFAULT;  /*BOOLEAN*/
   SourceApp            = CHAR(4) NOT NULL WITH DEFAULT;  /*Source Card Appl*/
   TargetApp            = CHAR(4) NOT NULL WITH DEFAULT;  /*Source Card Appl*/
) =
BEGIN
   ConfirmTransferFlag = FALSE;
   IF CurrentApplication <> Application$DSO THEN
      FIELD(ControlledEquip_tf[*].PrimaryGroupingName).CurBias = FB_INVISIBLE;
   ENDIF;

   EquipList.Clear();
   IF Equip = 0 THEN
      /*
      ** SwitchingItem for the current card included for logging purposes only.
      */
      i = 1;
      REPEATED
      SELECT DISTINCT
              :EquipList[i].PrimaryGroupingName = O.PrimaryGroupingName
             ,:EquipList[i].EquipClassName = J.EquipClassName
             ,:EquipList[i].EquipName = J.EquipName
             ,:EquipList[i].Equip = J.Equip    
      FROM    SOA_Job J,
              SOA_JobControl JC,
              Udb_Object O 
      WHERE   JC.Card = :Card AND
              JC.SwitchingItem = :SwitchingItem AND
              JC.Job = J.Job AND
              J.ControlCard = :Card AND
              J.Equip <> 0 AND
              J.Equip = O.Object
      ORDER BY 1,2,3
      BEGIN
         i = i + 1;
      END;
   ELSE
      i = 1;
      REPEATED
      SELECT DISTINCT
              :EquipList[i].Equip = J.Equip
      FROM    SOA_Job J,
              SOA_JobControl JC
      WHERE   JC.Card = :Card AND
              JC.SwitchingItem = :SwitchingItem AND
              JC.Job = J.Job AND
              J.Equip = :Equip AND
              J.ControlCard = :Card 
      BEGIN
      
         i = i + 1;
      END;
   ENDIF;

   i = 1;
   ControlledEquip.Clear();
   FOR k = 1 TO EquipList.LastRow() DO
      REPEATED
      SELECT DISTINCT  
              :ControlledEquip[i].PrimaryGroupingName = O.PrimaryGroupingName
             ,:ControlledEquip[i].EquipClassName = J.EquipClassName
             ,:ControlledEquip[i].EquipName = J.EquipName
             ,:ControlledEquip[i].Equip = J.Equip
             ,:ControlledEquip[i].CardName = AC.Application + ' - ' +
                                             AC.CardName
             ,:ControlledEquip[i].Card = AC.Card
             ,:ControlledEquip[i].SwitchingItem = :SwitchingItem
             ,:ControlledEquip[i].NewSwitchingItem = JC.SwitchingItem
      FROM    SOA_Job J,
              SOA_JobControl JC,
              SOA_ActiveCard AC,
              Udb_Object O
      WHERE   JC.Job = J.Job AND
              J.ControlCard = :Card AND
              J.Equip = :EquipList[k].Equip AND
              J.SwItemStatus < :Card$Closed AND
              JC.Card = AC.Card AND
              JC.Card <> :Card AND
              JC.Card <> :NIS$Card AND
             (J.TOComplete IS NULL OR
              J.RSComplete IS NULL) AND
              J.Status IN ('',:JobStatus$NIS) AND
              J.MoveCategory = :MoveCategory$Normal AND
              J.Equip = O.Object
      BEGIN
         ExcludeRow = FALSE;

         IF NoShadowOption = TRUE THEN

            ShadowItem = FALSE;
            SELECT  :ShadowItem = :TRUE
            FROM    SOA_Job
            WHERE   Job = :ControlledEquip[i].NewSwitchingItem AND
                    ShadowLink = :Card;

            IF ShadowItem = TRUE THEN
               ExcludeRow = TRUE;
            ENDIF;
         ENDIF;
         /* Look for MicroGrid relationship */
         MicroGrid = 0;
         SELECT :MicroGrid = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :EquipList[k].Equip AND
                Relationship = :Interaction$MicroGridFor;
         IF MicroGrid > 0 THEN
            ExcludeRow = TRUE;
         ENDIF;

         IF ExcludeRow = TRUE THEN
            ControlledEquip.RemoveRow (rownumber = i);
         ELSE
/*
**  Get PrintID of card with control.  This is not in select above 
**  since SLC and FMS can have different printid for the equipment.
*/
            REPEATED 
            SELECT DISTINCT
                   :ControlledEquip[i].PrintID = JC.PrintID
            FROM    SOA_Job J,
                    SOA_JobControl JC
            WHERE   JC.Card = :Card AND
                    JC.Job = J.Job AND
                    J.ControlCard = :Card AND
                    J.Equip = :EquipList[k].Equip AND
                   (J.TOComplete IS NULL OR
                    J.RSComplete IS NULL) AND
                    J.Status IN ('',:JobStatus$NIS) AND
                    J.MoveCategory = :MoveCategory$Normal;
                    
            i = i + 1;
         ENDIF;
      END;

   ENDFOR;
  
   IF i = 1 THEN
      MESSAGE 'Card does not have control of any shared equipment where control can be transferred.';
      RETURN PU_CANCEL;
   ENDIF;
            
   ControlledEquip_tf = ControlledEquip.Duplicate();
   FIELD(Confirm_Btn).CurBias = FB_INVISIBLE;
   FIELD(ControlledEquip_tf).Title = 'Transfer Control for Selected Equipment';
   CurFrame.Flush();
END;


ON CHILDENTRY ControlledEquip_tf =
BEGIN
/* 
**  Set row highlight or remove highlight
*/
    IF CurFrame.ReasonCode = RC_PROGRAM OR 
            CurFrame.ReasonCode = RC_TFSCROLL OR
            ConfirmTransferFlag = TRUE THEN
        RESUME;
    ENDIF;

    j = FIELD(ControlledEquip_tf).CurRow;
    IF FIELD(ControlledEquip_tf[j].CardName).IsReverse = FALSE THEN
       /*
       **  Make sure equipment has not been selected for transfer already.
       */
       i = 1;
       WHILE i <= ControlledEquip_tf.LastRow() DO
          IF FIELD(ControlledEquip_tf[i].CardName).IsReverse = TRUE AND
               ControlledEquip_tf[i].Equip <> 0 AND
               ControlledEquip_tf[i].Equip = ControlledEquip_tf[j].Equip THEN
             MESSAGE 'Equipment appears for transfer more than once.  ' +
                     'Select only one card to transfer to.';
             RESUME;
          ENDIF;
          i = i + 1;
       ENDWHILE;

       /*
       ** Check if equip has a move that was downloaded to an Operating Order or FOD Order
       */
       RetCode = CALLPROC CheckOutstandingEquip(Equip = ControlledEquip_tf[j].Equip);

       IF RetCode = PU_CANCEL THEN
          MESSAGE 'Equipment ' +
                ControlledEquip_tf[j].EquipClassName + '  ' +
                ControlledEquip_tf[j].EquipName +
               ' has a move or moves that were downloaded to an order. ' + 
               ' Control of this equipment cannot be transferred ' +
               'until the order processing is complete and confirmed.';
          RESUME;
       ENDIF;

       FIELD(ControlledEquip_tf[j].CardName).IsReverse = TRUE;
       FIELD(ControlledEquip_tf[j].EquipName).IsReverse = TRUE;
       FIELD(ControlledEquip_tf[j].EquipClassName).IsReverse = TRUE;
       FIELD(ControlledEquip_tf[j].PrintID).IsReverse = TRUE;
    ELSE
       FIELD(ControlledEquip_tf[j].CardName).IsReverse = FALSE;
       FIELD(ControlledEquip_tf[j].EquipName).IsReverse = FALSE;
       FIELD(ControlledEquip_tf[j].EquipClassName).IsReverse = FALSE;
       FIELD(ControlledEquip_tf[j].PrintID).IsReverse = FALSE;
    ENDIF; 
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
/*
** Save or Select/Return Operation.
*/
   i = 1;
   j = 1;
   SelectedEquip.Clear();
   WHILE i <= ControlledEquip_tf.LastRow() DO
      IF FIELD(ControlledEquip_tf[i].CardName).IsReverse = TRUE THEN 

         ShadowItem = 0;
         REPEATED
         SELECT    :ShadowItem = ShadowLink
         FROM      SOA_Job
         WHERE     Job = :ControlledEquip_tf[i].NewSwitchingItem;

         IF ShadowItem = 0 THEN
            SelectedEquip[j] = ControlledEquip_tf[i];
            j = j + 1;
         ELSE
/*
** Equipment moves appear in a shadow switching item. We must transfer the 
** equipment to a real switching, which means we either create a new switching
** item and transfer equipment to it, or we transfer equipment to an existing 
** non-shadow sw item.
*/
            ShadowItem = ControlledEquip_tf[i].NewSwitchingItem;
            RetCode = CALLFRAME TransferControlToSwItem (
                   Card = ControlledEquip_tf[i].Card
                 , Equipment = ControlledEquip_tf[i].EquipClassName + '  ' +
                               ControlledEquip_tf[i].EquipName
                 , Equip = ControlledEquip_tf[i].Equip
                 , NewSwitchingItem =
                        BYREF(ControlledEquip_tf[i].NewSwitchingItem)
                 , CardInitiator = Card              
                 );

            IF RetCode = PU_CANCEL THEN
               ControlledEquip_tf[i].NewSwitchingItem = ShadowItem;
               RESUME;
            ELSE
               SelectedEquip[j] = ControlledEquip_tf[i];
               j = j + 1;
            ENDIF;
         ENDIF;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   IF j = 1 THEN
      MESSAGE 'No Equipment selected for transfer.';
      RESUME;
   ELSE
      ControlledEquip_tf.Clear();
      ControlledEquip_tf = SelectedEquip.Duplicate();
      FIELD(Confirm_Btn).CurBias = FB_LANDABLE;
      FIELD(OK_Btn).CurBias = FB_INVISIBLE;
      FIELD(ControlledEquip_tf).Title = 'Confirm Equipment Transfer';
      ConfirmTransferFlag = TRUE;
      CurFrame.Flush();
   ENDIF;
END;


ON CLICK Confirm_Btn =
BEGIN
/* 
** Transfer Control in the Database
*/
   i = 1;
   WHILE i <= ControlledEquip_tf.LastRow() DO
      
      RetCode = CALLPROC SOA_TransferEquipControl (
                  Equip = ControlledEquip_tf[i].Equip,
                  ControlCard = ControlledEquip_tf[i].Card );
 
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Unable to Transfer Control for equipment: ' +
                 ControlledEquip_tf[i].PrintID + '   ' +
                 ControlledEquip_tf[i].EquipClassName + '   ' +
                 ControlledEquip_tf[i].EquipName + '.';
      ELSE
         CALLPROC DDB_COMMIT;   

         RetCode = CALLPROC SOA_LogIns (
          Card            = Card
        , Job             = NULL
        , SwitchingItem   = ControlledEquip_tf[i].SwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'Xfer Control'
        , New             = 'To: ' + ControlledEquip_tf[i].CardName
        , Old             = ControlledEquip_tf[i].PrintID + '   ' +
                            ControlledEquip_tf[i].EquipClassName + '   ' +
                            ControlledEquip_tf[i].EquipName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 1 indicating equip control transferred.';
         ENDIF;
         CALLPROC DDB_COMMIT;        

         RetCode = CALLPROC SOA_LogIns (
          Card            = ControlledEquip_tf[i].Card
        , Job             = NULL
        , SwitchingItem   = ControlledEquip_tf[i].NewSwitchingItem
        , Time            = DATE('now')
        , UserName        = UserName
        , Item            = 'Xfer Control'
        , New             = 'Received Equip Control'
        , Old             = ControlledEquip_tf[i].PrintID + '   ' +
                            ControlledEquip_tf[i].EquipClassName + '   ' +
                            ControlledEquip_tf[i].EquipName
        );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Unable to insert log' +
                  ' entry 2 indicating equip control transferred.';
         ENDIF;
         CALLPROC DDB_COMMIT;        
/*
** If we are transferring between TFMS cards, then we may need to 
** transfer moves between shadow sw items.
*/       
         SELECT :SourceApp = Application
         FROM   SOA_ActiveCard
         WHERE  Card = :Card;

         SELECT :TargetApp = Application
         FROM   SOA_ActiveCard
         WHERE  Card = :ControlledEquip_tf[i].Card;

         IF SourceApp = Application$TFMS AND TargetApp = Application$TFMS THEN
           
            CALLPROC TransferShadowItemMoves (
                 SourceCard = Card,
                 TargetCard = ControlledEquip_tf[i].Card,
                 Equip = ControlledEquip_tf[i].Equip);
         ENDIF;

         IF i = 1 THEN
            ImpactedCardList[1].Value = Card;
            ImpactedCardList[2].Value = ControlledEquip_tf[i].Card;
         ELSE
            j = 1;
            LastRow = ImpactedCardList.LastRow();
            WHILE j <= LastRow DO
               IF ImpactedCardList[j].Value = ControlledEquip_tf[i].Card THEN
                  ENDLOOP;
               ENDIF;
               j = j + 1;
            ENDWHILE;

            IF j = (LastRow + 1) THEN
               ImpactedCardList[j].Value = ControlledEquip_tf[i].Card; 
            ENDIF;
         ENDIF;
      ENDIF;

      i = i + 1;
   ENDWHILE;
/*
** Inform other cards of control change (including current card for
** view only users).
*/
   k = 1;
   WHILE k <= ImpactedCardList.LastRow() DO
 
      IF ImpactedCardList[k].Value = Card THEN
         EventText = VARCHAR(ImpactedCardList[k].Value) + ';' +
                     UserName + ';';
      ELSE    
         EventText = VARCHAR(ImpactedCardList[k].Value) + ';';
      ENDIF;
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_NewJobOnCard', 
                                  DBEventText = EventText); 
      CALLPROC DDB_COMMIT;
      k = k + 1;              
   ENDWHILE;
/*
** OK Return means reload moves for the card; CANCEL return will not
*/  
   IF i > 1 THEN 
      RETURN PU_OK;
   ELSE
      RETURN PU_CANCEL;
   ENDIF;

END; 


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation or reutrn to select mode if on Confirm.
*/
   IF ConfirmTransferFlag = TRUE THEN
      
      ControlledEquip_tf.Clear();
      ControlledEquip_tf = ControlledEquip.Duplicate();
      FIELD(Confirm_Btn).CurBias = FB_INVISIBLE;
      FIELD(OK_Btn).CurBias = FB_Landable;   
      FIELD(ControlledEquip_tf).Title = 'Transfer Control for Selected ' +
           'Equipment';
      ConfirmTransferFlag = FALSE;
      CurFrame.Flush();
      RESUME;
   ELSE
      RETURN PU_CANCEL;
   ENDIF;
END;


ON DBEvent 'FMS_Card_Control_Taken',
ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control

   RETURN PU_CANCEL;
END;

ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;

Name:      controlledequip_tf

				Fieldobject Script
