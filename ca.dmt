Application Component Report
============================

	Name:            SplitString

procedure SplitString
(
   Delimiter = VARCHAR(10) NOT NULL;
   SplitText = VARCHAR(256) NOT NULL;
) =
declare
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   DLen = INTEGER NOT NULL WITH DEFAULT;

   ReturnArray = ARRAY OF STRINGOBJECT;
   TempText = VARCHAR(256) NOT NULL;
enddeclare
{
   DLen = LENGTH(Delimiter);
   TempText = SQUEEZE(SplitText);
   k = 1;

   WHILE TempText <> '' DO
      i = LOCATE(TempText, Delimiter);
      IF i = (SIZE(TempText) +1) THEN              /* NOT FOUND */
         ReturnArray[k].Value = TempText;
         TempText = '';
      ELSE
         ReturnArray[k].Value = LEFT(TempText, i-1);
         TempText = SHIFT(TempText, -1 * (i + DLen -1));
      ENDIF;
      k = k + 1;
   ENDWHILE;
          
   RETURN ReturnArray;
}

