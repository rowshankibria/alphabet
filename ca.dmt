         ,CurObject.SesameLock = S.SesameLock        
         ,CurObject.UnitLocked = S.UnitLocked        
         ,CurObject.NeutralInstalled = S.NeutralInstalled  
         ,CurObject.AnodesInstalled = S.AnodesInstalled

         ,CurObject.PowerSupplySerial = S.PowerSupplySerial 
         ,CurObject.PowerSupplyLock   = S.PowerSupplyLock   
         ,CurObject.PowerSupplyCombo  = S.PowerSupplyCombo   
         ,CurObject.HandHeldSerial = S.HandHeldSerial
         ,CurObject.HandHeldLock   = S.HandHeldLock  
         ,CurObject.HandHeldCombo  = S.HandHeldCombo
         ,CurObject.SCADASerial   = S.SCADASerial  
         ,CurObject.SCADALock     = S.SCADALock    
         ,CurObject.SCADACombo    = S.SCADACombo    
         ,CurObject.ManualSerial  = S.ManualSerial 
         ,CurObject.ManualLock    = S.ManualLock   
         ,CurObject.ManualCombo   = S.ManualCombo  
         ,CurObject.CamASerial = S.CamASerial
         ,CurObject.CamALock   = S.CamALock  
         ,CurObject.CamACombo  = S.CamACombo
         ,CurObject.CamBSerial = S.CamBSerial
         ,CurObject.CamBLock   = S.CamBLock  
         ,CurObject.CamBCombo  = S.CamBCombo
         ,CurObject.CamCSerial = S.CamCSerial
         ,CurObject.CamCLock   = S.CamCLock
         ,CurObject.CamCCombo  = S.CamCCombo
         ,CurObject.DMBadging = S.DMBadging
         ,CurObject.SwitchLocked = S.SwitchLocked
         ,CurObject.CamOpsLocked = S.CamOpsLocked
         
         ,CurObject.Processed = S.Processed
         ,CurObject.UpdateTime = S.UpdateTime
         ,CurObject.ByDO = S.ByDO
   FROM FMS_SesameLockCard S,
        UDB_Object F
   WHERE S.FormID = :CurObject.FormID AND
         S.Feeder = F.Object;
   
   IF iirowcount = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No lock card with that ID was found.';
   ENDIF;
      
   CALLPROC DDB_ROLLBACK;
END;

Application Component Report
============================

	Name:            SetGrouperLink

/* 
**      Copyright c 1997 ESCA Corporation  All rights reserved. 
** 
**      ESCA Corporation proprietary and trade secret information. 
**      Do not copy or disclose to third parties without written permission 
**      from an officer of ESCA Corporation. 
** 
**  Application:    FeederCard 
**  Frame:          SetGrouperLink
** 
**  Modification log: 
**  -----------------------------------
**
**  01/08/97   jfl   Created
**  02/20/97   jfl   Do not allow two members of an ISONET
**                   to have different locations
**  03/23/97   jfl   Allow above condition with warning. 
**                   Display Equipment under selected Grouper.
**  10/17/97   jfl   Changes due to new macro ATS-Grouper.
**  07/06/04   em    Disable Update capabilities for SICC user.
**  01/22/07   em    Allow associations to HTV Grouper
*/
INITIALIZE
(
    Equip      = INTEGER NOT NULL;              /* P: Equipment */
    EquipType  = INTEGER NOT NULL;              /* Equipment Type */
    EquipName  = VARCHAR(40) NOT NULL;          /* Equipment Name */
    i          = INTEGER NOT NULL;              /* Temporary counter */
    Match      = VARCHAR(40);                   /* temporary for Find_Btn */ 
    Found      = SMALLINT;                      /* temporary boolean */
    RetCode    = INTEGER NOT NULL WITH DEFAULT; /* Return Code */
    IsoCount   = INTEGER NOT NULL;              /* temp: counter of eqpt under ISONET */
    IsoLocation   = INTEGER NOT NULL;           /* temp: ISONET location */
    EquipLocation = INTEGER NOT NULL;           /* temp: Equipment location */
) =
BEGIN
    Grpr.Clear();
	SelectedGprType.Name = '';
    SelectedGprType.Object = 0;
	SelectedGpr.Name = '';
    SelectedGpr.Object = 0;
    /*
    ** Pass Parameter information to the frame
    */
    IF Equip = 0 THEN
        RESUME;
    ENDIF;

    SELECT EquipType = O.Type,
           EquipName = O.Name
    FROM Udb_Object O
    WHERE O.Object = :Equip;
    CALLPROC DDB_ROLLBACK;
    
    FIELD(TheTitle).TextValue = FIELD(TheTitle).TextValue + EquipName;
    /*
    ** Load the current associations to groupers for the Equipment
    */
    i = 1;
    SELECT DISTINCT
          :Grpr[i].GrouperType = G.GroupingType,
          :Grpr[i].GrouperTypeName = T.Name,
          :Grpr[i].Grouper = G.Grouping,
          :Grpr[i].GrouperName = O.Name
    FROM Udb_Grouping G,
         Udb_Type T,
         Udb_Object O,
         Udb_SuperType ST
    WHERE G.Member = :Equip
      AND G.RelationShip = :Interaction$MemberOf
      AND G.GroupingType = ST.Type
      AND ST.SuperType = :Type$Grouper
      AND ST.Type <> (:Type$ATSGrouper)
      AND G.Grouping = O.Object
      AND G.GroupingType = T.Type
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    
    /*
    ** Load the list of grouper types
    ** Do not include ATS which have their own functions
    */
    SelectGprType.Clear();
    i = 1;
    SELECT DISTINCT
          :SelectGprType[i].Object = T.Type,
          :SelectGprType[i].Name   = T.Name
    FROM Udb_Type T,
         Udb_SuperType ST
    WHERE T.Type = ST.Type
      AND ST.SuperType = :Type$Grouper
      AND ST.Type <> (:Type$ATSGrouper)
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;

    IF UserGroup = Group$SICC THEN
       FIELD(Create_btn).CurBias = FB_INVISIBLE;
       FIELD(Remove_btn).Curbias = FB_INVISIBLE;
    ENDIF;
END;

/*
**	Handle a grouper type selection from the list
*/
ON ChildEntry SelectGprType =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
    SelectGpr.Clear();
    SEquipment.Clear();
    SelectedGprType = SelectGprType[].Duplicate();
    /*
    ** Load the list of Groupers
    */
    i = 1;
    SELECT 
         :SelectGpr[i].Object = O.Object,
         :SelectGpr[i].Name   = O.Name
    FROM Udb_Object O
    WHERE O.Type = :SelectedGprType.Object
      AND O.Name <> ''
    ORDER BY Name
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
END;

/*
**	Handle a grouper selection from the list
*/
ON ChildEntry SelectGpr =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
    /*
    ** Set the selected field
    */
    SelectedGpr = SelectGpr[].Duplicate();
/*
** Display the list of equipment for the selected grouper
*/
    SEquipment.Clear();
    i = 1;
    SELECT :SEquipment[i].PrintId = G2.Reference,
           :SEquipment[i].EquipClassName = O.TypeName, 
           :SEquipment[i].EquipName = O.Name 
    FROM Udb_Grouping G1,
         Udb_Grouping G2,
         Udb_Object O
    WHERE G1.Grouping = :SelectedGpr.Object
      AND G1.RelationShip = :Interaction$MemberOf
      AND G1.Member = O.Object
      AND G1.MemberType <> :Type$LoopEquipType
      AND G2.Member = G1.Member
      AND G2.RelationShip = :Interaction$MemberOf
      AND G2.GroupingType IN (SELECT Type 
                              FROM Udb_ExtendedType
                              WHERE SuperType = :Type$Feeder)
      AND G2.Grouping <> G1.Grouping
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
        
    CurFrame.InputFocusField = NULL;
END;

/*
** Handle Grouper selection via the Find button 
*/
ON CLICK Find_Btn =
BEGIN
    i = 1;
    WHILE i <= SelectGpr.LastRow() Do
        Match = '%' + uppercase(SelectedGpr.Name) + '%';
        IF uppercase(SelectGpr[i].Name) like Match THEN
            Endloop;
        Endif;
        i = i + 1;
    ENDWHILE;

    If i <= SelectGpr.LastRow() Then
        Field(SelectGpr).ActiveRow = i;
    Else
		MESSAGE 'Grouper does not exist or is not available to you.';
		SelectedGpr.Name = '';
        SelectedGpr.Object = 0;
		RESUME;
    ENDIF;
	SelectedGpr.Name = '';
    SelectedGpr.Object = 0;
END;

/*
** Handle selection of an association
*/
ON ChildEntry Grpr =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;

    IF FIELD(Grpr[].GrouperName).IsReverse = FALSE THEN
         FIELD(Grpr[].GrouperTypeName).IsReverse = TRUE;
         FIELD(Grpr[].GrouperName).IsReverse = TRUE;
    ELSE
         FIELD(Grpr[].GrouperTypeName).IsReverse = FALSE;
         FIELD(Grpr[].GrouperName).IsReverse = FALSE;
    ENDIF;
    CurFrame.InputFocusField = NULL;
END;

/*
** Handle creation of an association with the selected grouper
*/
ON Click Create_Btn =
BEGIN
    /*
    ** Make sure a grouper was selected
    */
    IF (SelectedGprType.Object = 0) OR
       (SelectedGpr.Object = 0) THEN
        Message 'Please, select a grouper type and a grouper name.';
        RESUME;
    ENDIF;
    /*
    ** For ISONET-Grouper, make sure that the location of the equipment
    ** is the same as existing equipments under that grouper
    */
    IF (SelectedGprType.Object = Type$ISOGrouper) THEN
        IsoCount = 0;
        SELECT :IsoCount = COUNT(*)
        FROM Udb_Grouping G
        WHERE G.Grouping = :SelectedGpr.Object
          AND G.RelationShip = :Interaction$MemberOf;
        CALLPROC DDB_ROLLBACK;
        IF IsoCount > 0 THEN
        /*
        ** Compare location
        */
            IsoLocation = 0;
            EquipLocation = 0;
            SELECT :IsoLocation = G2.Grouping
            FROM Udb_Grouping G1,
                 Udb_Grouping G2
            WHERE G1.Grouping = :SelectedGpr.Object
              AND G1.RelationShip = :Interaction$MemberOf
              AND G2.Member = G1.Member
              AND G2.RelationShip = :Interaction$LocatedWith;

            SELECT :EquipLocation = G.Grouping
            FROM Udb_Grouping G
            WHERE G.Member = :Equip
              AND G.RelationShip = :Interaction$LocatedWith;
            CALLPROC DDB_ROLLBACK;
            /*
            ** Warn the operator, but let him go ahead
            ** until the data base is fixed if he wants it
            */
            IF EquipLocation <> IsoLocation THEN

                IF (Curframe.ConfirmPopup(MessageText = 
                     'Equipment location is different from'
                         +  ' this ISONET location.') = PU_CANCEL) THEN
                    /*
                    ** Reset selection fields
                    */
                    SelectGpr.Clear();
                    SEquipment.Clear();
                    SelectedGprType.Object = 0;
                    SelectedGprType.Name = '';
                    SelectedGpr.Object = 0;
                    SelectedGpr.Name = '';
                    RESUME;
                ENDIF;
            ENDIF;
        ENDIF;
    ENDIF;
 
    /*
    ** Insert an association between Equipment and selected grouper
    */
    RetCode = CALLPROC Udb_GroupingIns (
                  SystemVersion = 0,
                  Grouping = SelectedGpr.Object,
                  GroupingType = SelectedGprType.Object,
                  Member = Equip,
                  MemberType = EquipType,
                  Relationship = Interaction$MemberOf);
    IF RetCode < 0 THEN
        CALLPROC DDB_ROLLBACK;
        Message 'Unable to associate equipment to grouper.';
        RESUME;
    ENDIF;
    CALLPROC DDB_COMMIT;

    /*
    ** Insert the new association in the list
    */
    Grpr.InsertRow (rownumber = 1);
    Grpr[1].GrouperType     = SelectedGprType.Object;
    Grpr[1].GrouperTypeName = SelectedGprType.Name;
    Grpr[1].Grouper         = SelectedGpr.Object;
    Grpr[1].GrouperName     = SelectedGpr.Name;

    /*
    ** Reset other fields
    */
    SelectGpr.Clear();
    SEquipment.Clear();
    SelectedGprType.Object = 0;
    SelectedGprType.Name = '';
    SelectedGpr.Object = 0;
    SelectedGpr.Name = '';
END;

/*
** Handle deletion of an association
*/
ON Click Remove_Btn =
BEGIN
    /*
    ** Make sure at least one row was selected
    */
    Found = FALSE;
    i = Grpr.LastRow();
    WHILE i >= 1 DO
        IF FIELD(Grpr[i].GrouperName).IsReverse = TRUE THEN
            Found = TRUE;
        ENDIF;
        i = i - 1;
    ENDWHILE;
    IF Found = FALSE THEN
        Message 'Please, Select an association to remove ';
        RESUME;
    ENDIF;

    /*
    ** Delete highlighted rows
    */
    i = Grpr.LastRow();
    WHILE i >= 1 DO
        IF FIELD(Grpr[i].GrouperName).IsReverse = TRUE THEN
            RetCode = CALLPROC Udb_GroupingDel (
                                   Grouping = Grpr[i].Grouper,
                                   Member = Equip,
                                   Relationship = Interaction$MemberOf);
            IF RetCode < 0 THEN
                CALLPROC DDB_ROLLBACK;
                Message 'Unable to remove equipment from source position.';
                RESUME;
            ENDIF;
            CALLPROC DDB_COMMIT;
            Grpr.RemoveRow (rownumber = i);
        ENDIF;
        i = i - 1;
    ENDWHILE;
    CurFrame.InputFocusField = NULL;
END;


/*
**	Handle an Exit click
*/
ON Click Exit_Btn =

BEGIN
	RETURN;
END;


ON WINDOWCLOSE =

BEGIN
	RESUME;
END;


Name:      close_menu

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
	return;
END

