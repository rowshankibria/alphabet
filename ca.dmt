METHOD NoteIns (
)=
DECLARE
   i          = INTEGER NOT NULL;
   Filter     = VARCHAR(40);        /* Note name filter */
   COUserName = VARCHAR(40) NOT NULL;
   RetCode    = INTEGER NOT NULL;
ENDDECLARE
BEGIN
/* 
** Purpose of this method is to update a status of a matrix.
*/
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.nList.LastRow() = 0 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No Note inserts/updates were made.  Please try again.';
      RETURN;
   ENDIF;

/*
**  See if matrix is checked out to this user.
*/
   COUserName = '';
   SELECT :COUserName = UserCheckOut
   FROM    CAC_Relay_Grouping
   WHERE   Grouping = :CurObject.Grouping;
   CALLPROC DDB_ROLLBACK;
   
   IF COUserName = CurObject.UserName THEN
      FOR i = 1 to CurObject.nList.LastRow() DO

         IF CurObject.nList[i].Note_Id = 0 THEN
            CurObject.nList[i].Note_Id = CALLPROC Udb_NextKey(KeyName = 'RelayGrouping');
  
            IF CurObject.nList[i].Note_Id <= 0 THEN
               CALLPROC DDB_ROLLBACK;
               CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Could not generate a note key.');
               CurObject.ReturnCode = -1;
               CurObject.ErrorMessage = 'Could not generate a note key, try again.  ' +
                  'Contact technical support if problem continues.';
               RETURN;
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
       
         RetCode = CALLPROC CAC_CO_NoteIns (
                     Grouping = CurObject.Grouping,
                     Note_Id = CurObject.nList[i].Note_Id,
                     Note_Seq = CurObject.nList[i].Note_Seq,
                     Note = CurObject.nList[i].Note
                     );

         IF Retcode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                          ': Could not insert Note information.');
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'Could not insert Note information. ' +
               'Please try again or contact technical support if ' + 
               'problem continues.';
            RETURN;    
         ENDIF;
      ENDFOR;
      CALLPROC DDB_COMMIT;
   ELSE
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'You are not the user who has this matrix ' +
                'checked out and cannot make updates to it.';
      RETURN;
   ENDIF;
   RETURN;
END;



