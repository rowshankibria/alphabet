	Name:            Override_old

/*
**
**  Copyright c 1991 Unified Information, Inc.  All rights reserved.
**
**  Unified Information, Inc. proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          Override
**
**  08/24/98 em     Copied and modified for SOA.
**  02/18/03 pkw    Added code for Yellow Warning report.
**  11/14/03 ysp    ITC143: add code to save job data for Yellow Warning report.
**  05/24/05 em     Extended Reason field to 80 chars from 60
**  12/08/09 em     Adding second operator confirmation of warnings
**  02/17/12 em     Modified second operator validation to be tight
**                  on District Operator and ECC Manager
**  11/28/12 em     Only validate second operator when connected to production database
*/

INITIALIZE
(
    Card = INTEGER NOT NULL;
    Job = INTEGER;  /*Nullable*/
    SwitchingItem = INTEGER; /*Nullable*/
    i = integer NOT NULL WITH DEFAULT;
    PreSel = integer ;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    CardClass = INTEGER NOT NULL;
    CardName = VARCHAR(200) NOT NULL WITH DEFAULT;
    ConfirmWarning = INTEGER NOT NULL WITH DEFAULT;
    EmployeeName   = VARCHAR(40) NOT NULL WITH DEFAULT;
    EmployeeObject = INTEGER NOT NULL WITH DEFAULT;
    EmployeeType   = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   PreSel = 1;
   IF CurrentApplication = Application$FMS THEN
      SELECT :CardName = FeederName
      FROM   FMS_Card
      WHERE  Card = :Card;    
   ELSEIF CurrentApplication = Application$TFMS THEN
      SELECT :CardName = FeederNames
      FROM   TFMS_Card
      WHERE  Card = :Card;
   ELSEIF CurrentApplication = Application$SLC THEN
      SELECT :CardName = SubstationName
      FROM   SLC_Card
      WHERE  Card = :Card;
   ENDIF;
/*
**  Get CardClass information for SOA_Warning insert.
*/
   IF SwitchingItem IS NULL OR
      SwitchingItem = 0 THEN
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SOA_Card
      WHERE   Card = :Card;
   ELSE
      REPEATED
      SELECT :CardClass = CardClass
      FROM    SLC_InformationItem
      WHERE   Job = :SwitchingItem;
   ENDIF;
/*
** Decide whether to present Two Operator confirmation.
*/
   SELECT :ConfirmWarning = ConfirmWarning
   FROM   AllApp_SystemParameters;
   CALLPROC DDB_ROLLBACK;

   IF ConfirmWarning = TRUE THEN
      OpConfirm.Operator1 = Dop.Description;
      FIELD(OpConfirm).CurBias = FB_CHANGEABLE;
   ELSE
      FIELD(OpConfirm).CurBias = FB_INVISIBLE;
      FIELD(W[*].Op1).CurBias = FB_INVISIBLE;
      FIELD(W[*].Op2).CurBias = FB_INVISIBLE;
   ENDIF; 

   IF WarningBuffer.LastRow() = 0 THEN
      MESSAGE 'Error presenting override screen with no warnings in buffer. Contact technical support.';
      CurFrame.SendUserEvent (EventName = 'NoWarning');
      RESUME;
   ENDIF;

   FOR i = 1 TO WarningBuffer.LastRow() DO
      W[i].WarningText = WarningBuffer[i].WarningText;
   ENDFOR;
   Curframe.InputFocusField = FIELD(Reason);
END;
/*
**  Handle the childclick 
*/
ON ChildSetValue W[*].Op2  =
BEGIN
    IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
/*
**  Reset the highlight for the frame
*/
    Presel = FIELD(W).CurRow;
    IF OpConfirm.Operator2 = '' THEN
       MESSAGE 'Must enter DO#2 Employee number.';
       W[Presel].Op2 = 0;
    ENDIF;
END;
/*
**  Handle an OK click
*/
ON Click OKButton =
BEGIN

    IF Lowercase (Reason) LIKE '%fuck%' OR 
       Lowercase (Reason) LIKE '%shit%' OR 
       Lowercase (Reason) LIKE '%jerk%' THEN
        MESSAGE 'Watch your language!';
        Reason = '';
	RESUME;

   ELSEIF Length( Squeeze (Reason)) <= 6 THEN

        MESSAGE 'You must enter more explanation ';
        Reason = '';
       RESUME;

   ELSEIF ConfirmWarning = TRUE THEN

      IF OpConfirm.Operator2 = '' THEN
         MESSAGE 'A second operator or manager must confirm this Warning!';
         RESUME;
      ENDIF;

      FOR i = 1 TO W.LastRow() DO
         IF W[i].Op1 = 0 OR W[i].Op2 = 0 THEN
            MESSAGE 'Each warning must be confirmed and marked by two District Operators.';
            RESUME;
            ENDLOOP;
         ENDIF;
      ENDFOR;
   ENDIF;

    IF CardClass <> Type$CardClassTest THEN   
       CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   Operator2 = EmployeeObject,
                   Operator2Name = EmployeeName,
                   UserName = UserName,
                   WarningType = 2,
                   WarningText = Reason,
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   Job = IFNULL(Job,0));
       CALLPROC DDB_COMMIT;
    ENDIF;

    RetCode = CALLPROC SOA_LogIns (Card = Card,
                Job = Job,
                SwitchingItem = SwitchingItem,
                Time = DATE('now'),
                UserName = UserName,
                Item = 'Override',
                Old = Reason,
                New = 'DO #2: ' + EmployeeName);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
       WarningBuffer.Clear();
        RETURN (Reason);
    ELSE
        CALLPROC DDB_ROLLBACK;
        MESSAGE 'Unable to log that a warning was overridden. Transaction cancelled'; 
       WarningBuffer.Clear();
        RETURN (NULL);
    ENDIF;
END;
/*
**  Handle a Cancel click
*/
ON USEREVENT 'NoWarning',
ON Click CancelButton =
BEGIN
   IF CardClass <> Type$CardClassTest THEN   
      CALLPROC SOA_WarningIns(
                   Application = CurrentApplication,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   UserName = UserName,
                   WarningType = 2,
                   WarningText = 'Warning not overridden',
                   Card = Card,
                   CardClass = CardClass,
                   CardName = CardName,
                   SwitchingItem = IFNULL(SwitchingItem,0),
                   Job = IFNULL(Job,0));
      CALLPROC DDB_COMMIT;
   ENDIF;

   RetCode = CALLPROC SOA_LogIns (Card = Card,
                Job = Job,
                SwitchingItem = SwitchingItem,
                Time = DATE('now'),
                UserName = UserName,
                Item = 'Warning',
                Old = Reason,
                New = 'Warning not overridden');
   IF RetCode = 0 THEN
       CALLPROC DDB_COMMIT;
       WarningBuffer.Clear();
       RETURN (NULL);
   ELSE
       CALLPROC DDB_ROLLBACK;
       MESSAGE 'Unable to log that a warning was not overridden.';
       WarningBuffer.Clear();
       RETURN (NULL);
   ENDIF;
END;


ON WINDOWCLOSE =

   BEGIN
    RESUME;
   END;


ON SETVALUE Opconfirm.Operator2 =
BEGIN
/*
** If not connected to production fms server, then we don't validate second operator
*/
   IF uppercase(right(CurSession.GetEnv(name='DDB_SessionCur'),3)) = DB$ProductionDB THEN
/*
** Evaluate entered employee number
*/
      EmployeeObject = 0;
      SELECT :EmployeeObject = Object,
             :EmployeeType = Type,
             :EmployeeName = Description
      FROM   Udb_Object 
      WHERE  Name = :OpConfirm.Operator2 AND
             Type IN (SELECT Type FROM Udb_ExtendedType
                      WHERE  SuperType IN (:Type$DistrictOperator,
                                           :Type$ECCManager));

      IF EmployeeObject = 0 THEN
         MESSAGE 'Operator or manager with employee number ' +
                 VARCHAR(OpConfirm.Operator2) +
                 ' does not exist in the database.  Warning is ' +
                 'not confirmed.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF;     

      IF EmployeeObject = Dop.Object THEN
         MESSAGE 'Warning must be reviewed and confirmed by someone else.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF;  

      IF EmployeeObject = Operator$StaffSupport OR EmployeeType = Type$Staff THEN
         MESSAGE 'Staff Support is not qualified to confirm this Warning.';
         OpConfirm.Operator2 = '';
         RESUME;
      ENDIF; 
/*
** If not a Manager then confirm that DO is logged in on another machine
*/      
      IF EmployeeType <> Type$ECCManager THEN
         i = 0;
         SELECT :i = Operator
         FROM   SOA_DOLogin
         WHERE  Operator = :EmployeeObject AND
                LogOut IS NULL;

         IF i = 0 THEN
            MESSAGE 'Second Operator ' + VARCHAR(OpConfirm.Operator2) + ' - ' +
                    EmployeeName + ' is not logged in at this time.  Must ' +
                    'be logged in on another machine to confirm a warning.';
            OpConfirm.Operator2 = '';
            RESUME;
         ENDIF;
      ENDIF;
   ENDIF;
END;

