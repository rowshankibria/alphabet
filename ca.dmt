	Name:            HolidayASE


���p�]A��Component Method Scripts
���p�]A��--------------------------
/*
**
**      Copyright c 2015 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Class:          HolidayASE
**
**  Date:       Version Description
** ----------------------------------
**  04/01/15 ysp Created; 
**
*/
METHOD GetHolidays(
   CheckLastHoliday = INTEGER NOT NULL WITH DEFAULT
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /* Counter */

   EmailClass = EmailNotificationClass DEFAULT NULL;
   EndDate = DATE NOT NULL WITH DEFAULT;
   StartDate = DATE NOT NULL WITH DEFAULT; 
   SendEmail = INTEGER NOT NULL WITH DEFAULT;    
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   StartDate = DATE(CurObject.StartDateChar);   // 02/22/2015
   EndDate = DATE(CurObject.EndDateChar) + '1 day';   // 01/01/2017

   CurObject.DList.Clear();
   i = 1;
   SELECT :CurObject.DList[i].Name = Name,
          :CurObject.DList[i].DateValue = DateValue
   FROM   FMS_Holiday
   WHERE  DateValue BETWEEN :StartDate AND :EndDate
   ORDER BY DateValue ASC
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   IF CheckLastHoliday = TRUE THEN
      SendEmail = FALSE;
      
      IF CurObject.DList.LastRow = 0 THEN
         SendEmail = TRUE;
      ELSE
         StartDate = DATE('NOW');
         EndDate = CurObject.DList[CurObject.DList.LastRow].DateValue;
         
         IF (StartDate + '1 month') > EndDate THEN
            SendEmail = TRUE;
         ENDIF;
      ENDIF;
   
      IF SendEmail = TRUE THEN
         IF EmailClass IS NULL THEN
            EmailClass = EmailNotificationClass.Create();
         ENDIF;

         EmailClass.EmailType = 13;
         EmailClass.Sender = 'FMS Administrator';
         EmailClass.Recipient = 'SupportEmail';     
         EmailClass.Subject = 'Holiday dates to be entered in FMS DBM'; 
      
         EmailClass.Message1 = ''; 
         EmailClass.Message2 = '';
         EmailClass.Template = 'HolidayDates.html';                      
         EmailClass.InsertRequest();

         IF EmailClass.ReturnCode <> 0 THEN 
            CurMethod.Trace(Text = varchar(date('now')) + ':HolidayASE.GetHolidays. ERROR: ' + 
                   'Unable to notify support of warning regarding holiday dates.');
         ENDIF;
      ENDIF;
   ENDIF;
END;

