	Name:            CascadeMoves

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Procedure:      CascadeMoves
**
**  Date:       Author   Description
** ----------------------------------
**  08/12/98    pkw       Created
**  09/06/02    em        Added optional NotShadowItem parameter used from FMS
**                        which will prevent insert of a substation equipment
**                        on SLC card unless the move equipment is already
**                        involved with a active Switching Item on the card.
**  01/31/03    em        Because of the way this frame is being used, 
**                        particularly after LoadOutstandingMoves, it appears
**                        that an attempt is being made to insert a move
**                        on a card where the move already exists (Common
**                        moves between Feedercards).  To avoid this problem,
**                        we add a check before calling the InsertControl
**                        method to ensure the move is not already there.
**  10/14/05    em        Use TraceMerror to present message.
**  12/06/05    ysp       When looking for an active switching item, ignore hidden
**                        moves.
**  02/15/07    em        Bug fix on Impacted Card list index
**  09/05/07    em        Cascade SDS moves
**  07/25/14    em        DSO requires different select where object to card link is not important
*/
PROCEDURE CascadeMoves (
   Card       = INTEGER NOT NULL WITH DEFAULT;  /* Passed Parameter */
   Move       = Job;                            /* Passed Parameter */
   NotShadowItem = INTEGER NOT NULL WITH DEFAULT; /* Repress shadow insert */

   ActiveItem = INTEGER NOT NULL;               /* Active Switching Item */
   i          = INTEGER NOT NULL WITH DEFAULT;  /* Temporary Counter */
   InsertionList        = ARRAY OF NewMoveCard; /* List of cards to insert move*/
   ImpactedCardList     = ARRAY OF IntegerObject; /*Track impacted cards*/
   k          = INTEGER NOT NULL WITH DEFAULT;  /* Temporary Counter */
   LastRow    = INTEGER NOT NULL WITH DEFAULT;  /* Temporary Counter */   
   Objects    = ARRAY OF ObjectSummaryClass;    /* Input Parameter */
   RetCode    = INTEGER NOT NULL WITH DEFAULT;  
)=
BEGIN
   InsertionList.Clear();
   i = 1;
   IF CurrentApplication = Application$DSO THEN
      REPEATED 
      SELECT  DISTINCT  
            :InsertionList[i].Card = AC.Card,
            :InsertionList[i].Application = AC.Application,
            :InsertionList[i].TypeOfCard = AC.TypeOfCard,
            :InsertionList[i].SwitchingItem = 0,
            :InsertionList[i].StepHeading = JCC.StepPair,
            :InsertionList[i].MoveEquipClass = JCC.EquipClass,
            :InsertionList[i].StepLevel = 0,
            :InsertionList[i].PrintID = ''
      FROM      Udb_Grouping G,
             SOA_ActiveCard AC,
             SOA_ActiveObject AO,
             FMS_JobClassControl JCC
      WHERE     G.Member = :Move.Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = AO.Object AND
             AO.Card = AC.Card AND
             AC.Card <> :Card AND
             AC.TypeOfCard = JCC.TypeOfCard AND
             JCC.JobClass = :Move.JobClass AND
             JCC.PreferredStep = :TRUE AND
            :Move.EquipClass IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = JCC.EquipClass)
      BEGIN
         i = i + 1;
      END;

   ELSE
      REPEATED 
      SELECT  DISTINCT  
            :InsertionList[i].Card = AC.Card,
            :InsertionList[i].Application = AC.Application,
            :InsertionList[i].TypeOfCard = AC.TypeOfCard,
            :InsertionList[i].SwitchingItem = 0,
            :InsertionList[i].StepHeading = JCC.StepPair,
            :InsertionList[i].MoveEquipClass = JCC.EquipClass,
            :InsertionList[i].StepLevel = 0,
            :InsertionList[i].PrintID = G.Reference
      FROM      Udb_Grouping G,
             SOA_ActiveCard AC,
             SOA_ActiveObject AO,
             FMS_JobClassControl JCC
      WHERE     G.Member = :Move.Equip AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = AO.Object AND
             AO.ObjectToCardLink = 1 AND /*Ignore substations for TFMS*/
             AO.Card = AC.Card AND
             AC.Card <> :Card AND
             AC.TypeOfCard = JCC.TypeOfCard AND
             JCC.JobClass = :Move.JobClass AND
             JCC.PreferredStep = :TRUE AND
            :Move.EquipClass IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = JCC.EquipClass)
      BEGIN
         i = i + 1;
      END;
   ENDIF;  
/*
** If application is Steam, there may be street valves that are common to both cards, so we
** to see if the other card has a move on the equipment.
*/
   IF CurrentApplication = Application$SDS THEN
      REPEATED 
      SELECT  DISTINCT  
            :InsertionList[i].Card = AC.Card,
            :InsertionList[i].Application = AC.Application,
            :InsertionList[i].TypeOfCard = AC.TypeOfCard,
            :InsertionList[i].SwitchingItem = 0,
            :InsertionList[i].StepHeading = JCC.StepPair,
            :InsertionList[i].MoveEquipClass = JCC.EquipClass,
            :InsertionList[i].StepLevel = 0,
            :InsertionList[i].PrintID = ''
      FROM   SOA_ActiveCard AC,
             SOA_JobControl JC,
             SOA_Job J,
             FMS_JobClassControl JCC
      WHERE  J.Equip = :Move.Equip AND
             J.Job <> :Move.Job AND
             J.Status = '' AND
             J.Job = JC.Job AND
             JC.Card = AC.Card AND
             AC.Card <> :Card AND
             AC.TypeOfCard = JCC.TypeOfCard AND
             JCC.JobClass = :Move.JobClass AND
             JCC.PreferredStep = :TRUE AND
            :Move.EquipClass IN (SELECT Type
                                 FROM   Udb_ExtendedType
                                 WHERE  SuperType = JCC.EquipClass)
      BEGIN
         i = i + 1;
      END;  
   ENDIF;

   ImpactedCardList.Clear();
   k = 1;
   FOR i = 1 TO InsertionList.LastRow() DO
/*
**  IF NotShadowItem = TRUE then make sure the insertion will only take place into
**  an active switching item with the equipment.
*/
      IF NotShadowItem = TRUE AND InsertionList[i].Application = Application$SLC THEN

         ActiveItem = 0;
         REPEATED 
         SELECT :ActiveItem = JC.SwitchingItem
         FROM   SOA_JobControl JC,
                SOA_Job J
         WHERE  JC.Card = :InsertionList[i].Card AND
                JC.Job = J.Job AND
                J.Equip = :Move.Equip AND
                J.Status IN ('',:JobStatus$NIS) AND
                J.MoveCategory = :MoveCategory$Normal AND
                J.SwItemStatus = :Card$Active;
      
         IF ActiveItem = 0 THEN
            CONTINUE;
         ENDIF;        
      ENDIF;
/*
** Check to make sure move is not already there.
*/
      ActiveItem = 0;
      SELECT  :ActiveItem = Card
      FROM    SOA_JobControl 
      WHERE   Card = :InsertionList[i].Card AND
              Job = :Move.Job;

      IF ActiveItem <> 0 THEN
         CONTINUE;
      ENDIF;

      RetCode = Move.InsertControl (
                       ControlEntry = InsertionList[i],
                       InitiatingCard = Card);
      IF RetCode = PU_CANCEL THEN
         CALLPROC TraceError (UserMessage =        
                 'Procedure:CascadeMoves; Error inserting control entries for a ' +
                 'move.',
                              TraceMessage = 
                 'Procedure:CascadeMoves; Error inserting control entries for a ' +
                 'move.');
         ENDLOOP;
      ENDIF; 
/*
**  Send back a list of all cards impacted.
*/
      ImpactedCardList[k].Value = InsertionList[i].Card;
      k = k + 1;
   ENDFOR;

   RETURN ImpactedCardList.Duplicate();
END;

