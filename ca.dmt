	Name:            EquipmentSearch

/*
**
**      Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          EquipmentSearch
**
**  Date:    Version Description
** ----------------------------------
**  03/25/05  ysp    created
**  04/06/05  ysp    modify field's BG colors to blue.
**  08/17/10  ysp    Return selected equipment to caller.
**  03/07/19  ysp    Add MembershipGrouping parameter
**  11/11/21  ysp    add MembershipDivision parameter
*/
INITIALIZE (
   MembershipGrouping = INTEGER NOT NULL WITH DEFAULT;
   MembershipDivision = INTEGER NOT NULL WITH DEFAULT;
) = 
DECLARE
    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    RRList = ChoiceList;
    TypeASE = TypeClass_ASE;
    EquipASE = EquipClass_ASE DEFAULT NULL;
    SelectedEquip = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** load a list of Rapid Restore equipment types
*/
    RRList.ChoiceItems.Clear();
    RRList.ChoiceItems[1].EnumValue = 0;     
    RRList.ChoiceItems[1].EnumText  = 'All ';   

    TypeASE.GetRREquipTypes();

    FOR i = 1 TO TypeASE.CList.LastRow() DO
       RRList.ChoiceItems[i+1].EnumValue = TypeASE.CList[i].Type;     
       RRList.ChoiceItems[i+1].EnumText  = TypeASE.CList[i].Name + '-'+ TypeASE.CList[i].Description;   
    ENDFOR;

    FIELD(EquipTypeFilter).ValueList = RRList.Duplicate();
    FIELD(EquipTypeFilter).UpdChoiceList();

/*
** call a 4gl in PSM to load the relationships for the grouping details
    CALLPROC LoadTypeList
            (EF = EnumField(FIELD(ED.GList[*].Relationship).ProtoField),
             StartType = Type$Interaction);
*/
   FIELD(GroupingHist).CurBias = FB_INVISIBLE;
END;

ON CLICK Find_Btn = 
BEGIN
   IF TRIM(EquipNameFilter) = '' THEN
      MESSAGE 'Please enter the equipment name to search.';
      RESUME;
   ENDIF;

   SelectedEquip = 0;
   SelectEquip.Clear();

   IF EquipASE IS NULL THEN
      EquipASE = EquipClass_ASE.Create();
   ENDIF;

   EquipASE.GroupingFilter = MembershipGrouping;
   EquipASE.GroupingFilter2 = MembershipDivision;
   EquipASE.EquipFilter = TRIM(UpperCase(EquipNameFilter));
   EquipASE.SearchOption = SearchOption;
   EquipASE.TypeFilter = EquipTypeFilter;

   EquipASE.LoadEquipByFilters();

   IF EquipASE.ReturnCode < 0 THEN
      MESSAGE EquipASE.ErrorMessage;
      RESUME;
   ENDIF;

   SelectEquip = EquipASE.EList.Duplicate();
   EquipASE = NULL;

   FIELD(GroupingHist).CurBias = FB_INVISIBLE;
   FIELD(ED.GH_Btn).CurBias = FB_DIMMED;
   FIELD(Close_Btn).TextLabel = 'Close';
END;

ON ChildEntry SelectEquip =
BEGIN
    IF (CurFrame.ReasonCode <> RC_MOUSECLICK) THEN 
       RESUME; 
    ENDIF; 

    i = 1;
    WHILE i <= SelectEquip.LastRow() DO
          IF FIELD(SelectEquip[i].Equip).IsReverse = TRUE THEN 
             FIELD(SelectEquip[i].Equip).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipName).IsReverse = FALSE; 
             FIELD(SelectEquip[i].EquipClassName).IsReverse = FALSE; 
             FIELD(SelectEquip[i].PrimaryGroupingName).IsReverse = FALSE; 
             FIELD(SelectEquip[i].OwnerNumber).IsReverse = FALSE; 
             ENDLOOP;
          ENDIF; 
          i = i + 1;
    ENDWHILE;

    FIELD(SelectEquip[].Equip).IsReverse = TRUE;
    FIELD(SelectEquip[].EquipName).IsReverse = TRUE;
    FIELD(SelectEquip[].EquipClassName).IsReverse = TRUE;
    FIELD(SelectEquip[].PrimaryGroupingName).IsReverse = TRUE;
    FIELD(SelectEquip[].OwnerNumber).IsReverse = TRUE;

    IF EquipASE IS NULL THEN
       EquipASE = EquipClass_ASE.Create();
    ENDIF;

    EquipASE.Object = SelectEquip[].Equip;
    EquipASE.LoadEquipDetails();

    IF EquipASE.ReturnCode < 0 THEN
       MESSAGE EquipASE.ErrorMessage;
       RESUME;
    ENDIF;

    IF EquipASE.EList.LastRow = 0 THEN
       MESSAGE 'No equipment details available.';
       RESUME;
    ENDIF;

    ED = EquipASE.EList[1].Duplicate();
    SelectedEquip = ED.Equip;
    FIELD(ED.GH_Btn).CurBias = FB_LANDABLE;
    FIELD(Close_Btn).TextLabel = 'OK';
END;

ON CLICK ED.GH_Btn = 
BEGIN
   IF EquipASE IS NULL THEN
      EquipASE = EquipClass_ASE.Create();
   ENDIF;

   EquipASE.Object = ED.Equip;

   EquipASE.LoadGroupingHistory();

   IF EquipASE.ReturnCode < 0 THEN
      MESSAGE EquipASE.ErrorMessage;
      RESUME;
   ENDIF;
   IF EquipASE.EList.LastRow = 0 THEN
      MESSAGE 'No grouping history data.';
      RESUME;
   ENDIF;
   GroupingHist.GH =  EquipASE.EList[1].HList.Duplicate();

   FIELD(GroupingHist).AbsXLeft = FIELD(ED).AbsXLeft;
   FIELD(GroupingHist).AbsYBottom = FIELD(ED.LocationComment).AbsYBottom;
   FIELD(GroupingHist).CurBias = FB_LANDABLE;  
END;

ON CLICK GroupingHist.Close_Btn = 
BEGIN
   FIELD(GroupingHist).CurBias = FB_INVISIBLE;  
END;   

ON CLICK Close_Btn = 
BEGIN
   RETURN SelectedEquip;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;
