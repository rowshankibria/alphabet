**  Class:          InServicePermit_ASE
**
**  Date:       Version Description
** ----------------------------------
**  11/05/07    pkw     Created; 
**  12/05/07    pkw     Fix Duration problem on History report.
**  12/05/07    pkw     Add Cardlines arrays.
**  02/11/08    pkw     Modify select of CardName.
*/
METHOD LoadOutageSummary (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   EquipWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   LineWhereClause = VARCHAR(1000) NOT NULL WITH DEFAULT;
   KVWhereClause = VARCHAR(100) NOT NULL WITH DEFAULT;
   DivisionWhereClause = VARCHAR(100) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   CurrentTime = DATE NOT NULL WITH DEFAULT;
   TempDivision = INTEGER NOT NULL WITH DEFAULT;
   TempMinute = INTEGER NOT NULL WITH DEFAULT;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Get Current time from Database.
   */
   SELECT :CurrentTime = DATE('now');
   
   CurObject.LastLoad = CurrentTime;

   IF CurObject.KV = 1 THEN
      KVWhereClause = ' OS.Voltage <= 33 AND ';   
   ELSEIF CurObject.KV = 2 THEN
      KVWhereClause = ' OS.Voltage > 33 AND ';
   ELSE
      KVWhereClause = '';
   ENDIF;

   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            FOR i = 1 TO SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            ENDFOR;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
            
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            TempDivision = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = TempDivision;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;
   ENDIF;

   FOR i = 1 TO EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         DivisionWhereClause = DivisionWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DivisionWhereClause = DivisionWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
   ENDFOR;
   
   EquipWhereClause = KVWhereClause + 
      'OS.Type <> ' + varchar(:Type$Line) + ' AND ' +
      'OS.Object = G.Member AND ' +
      'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G.GroupingType IN (SELECT Type ' +
                         'FROM   Udb_ExtendedType ' + 
                         'WHERE  SuperType = ' + varchar(:Type$Substation) + ') AND ' + 
      'G.Grouping = O.Object AND ' +
      'O.primarygrouping IN (' + DivisionWhereClause;


   LineWhereClause = KVWhereClause + 
      'OS.Type = ' + varchar(:Type$Line) + ' AND ' + 
      'OS.Object = G.Grouping AND ' +
      'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G.MemberType IN (SELECT Type ' + 
                       'FROM   Udb_ExtendedType ' + 
                       'WHERE  SuperType = ' + varchar(:Type$ACLineSegment) + ') AND ' +
      'G.Member = G2.Member AND ' +  
      'G2.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G2.GroupingType IN (SELECT Type ' + 
                          'FROM   Udb_ExtendedType ' + 
                          'WHERE  SuperType = ' + varchar(:Type$Substation) + ') AND ' + 
      'G2.Grouping = O.Object AND ' + 
      'O.primarygrouping IN (' + DivisionWhereClause;
   
   i = 1;
   CurObject.Equip.Clear();
   SELECT DISTINCT
          :CurObject.Equip[i].Card = OS.Card,
          :CurObject.Equip[i].Division = O.PrimaryGrouping,
          :CurObject.Equip[i].CardClassName = OS.CardClassName,
          :CurObject.Equip[i].EndTime = OS.OutServiceEnd,
          :CurObject.Equip[i].EstCompletion = OS.EstCompletion,
          :CurObject.Equip[i].EstInService = OS.EstInService,
          :CurObject.Equip[i].Job = OS.Job,
          :CurObject.Equip[i].LatentFlag = OS.LatentFlag,
          :CurObject.Equip[i].Name = OS.Name,
          :CurObject.Equip[i].Object = OS.Object,
          :CurObject.Equip[i].OutageKey = OS.OutageKey,
          :CurObject.Equip[i].OutageType = OS.OutageType,
          :CurObject.Equip[i].Reason = OS.Reason,
          :CurObject.Equip[i].Remarks = OS.Remarks,
          :CurObject.Equip[i].StartTime = OS.OutServiceStart,
          :CurObject.Equip[i].SubstationName = OS.SubstationName,
          :CurObject.Equip[i].SwitchingItem = OS.SwitchingItem,
          :CurObject.Equip[i].Type = OS.Type,
          :CurObject.Equip[i].TypeName = OS.TypeName,
          :CurObject.Equip[i].Voltage = OS.Voltage
   FROM    SOA_OutageSummary OS,
           Udb_Grouping G,
           Udb_Object O
   WHERE  :EquipWhereClause
   ORDER BY Division,Card,SwitchingItem
   BEGIN
      TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Equip[i].StartTime)));
      CurObject.Equip[i].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);

      IF CurObject.Equip[i].OutageKey <> 0 THEN
         j = 1;
         SELECT :CurObject.Equip[i].IsoLink[j].StartTime = L.IsolatedStart,
                :CurObject.Equip[i].IsoLink[j].EndTime = L.IsolatedEnd
         FROM    SOA_OutageIsoLink L
         WHERE   L.OutageKey = :CurObject.Equip[i].OutageKey
         BEGIN
            IF CurObject.Equip[i].IsoLink[j].EndTime = '' THEN
               TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ELSE
               TempMinute = INT4(interval('minute', DATE(CurObject.Equip[i].IsoLink[j].EndTime) - 
                                                    DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ENDIF;
            CurObject.Equip[i].IsoLink[j].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);
            j = j + 1;
         END;
      ENDIF;
      i = i + 1;
   END;

   i = 1;
   CurObject.Lines.Clear();
   SELECT DISTINCT
          :CurObject.Lines[i].Card = OS.Card,
          :CurObject.Lines[i].Division = O.PrimaryGrouping,
          :CurObject.Lines[i].CardClassName = OS.CardClassName,
          :CurObject.Lines[i].EndTime = OS.OutServiceEnd,
          :CurObject.Lines[i].EstCompletion = OS.EstCompletion,
          :CurObject.Lines[i].EstInService = OS.EstInService,
          :CurObject.Lines[i].Job = OS.Job,
          :CurObject.Lines[i].LatentFlag = OS.LatentFlag,
          :CurObject.Lines[i].Name = OS.Name,
          :CurObject.Lines[i].Object = OS.Object,
          :CurObject.Lines[i].OutageKey = OS.OutageKey,
          :CurObject.Lines[i].OutageType = OS.OutageType,
          :CurObject.Lines[i].Reason = OS.Reason,
          :CurObject.Lines[i].Remarks = OS.Remarks,
          :CurObject.Lines[i].StartTime = OS.OutServiceStart,
          :CurObject.Lines[i].SubstationName = OS.SubstationName,
          :CurObject.Lines[i].SwitchingItem = OS.SwitchingItem,
          :CurObject.Lines[i].Type = OS.Type,
          :CurObject.Lines[i].TypeName = OS.TypeName,
          :CurObject.Lines[i].Voltage = OS.Voltage
   FROM    SOA_OutageSummary OS,
           Udb_Grouping G,
           Udb_Grouping G2,
           Udb_Object O
   WHERE  :LineWhereClause
   ORDER BY Division,Card,SwitchingItem
   BEGIN
      TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Lines[i].StartTime)));
      CurObject.Lines[i].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);

      IF CurObject.Lines[i].OutageKey <> 0 THEN
         j = 1;
         SELECT :CurObject.Lines[i].IsoLink[j].StartTime = L.IsolatedStart,
                :CurObject.Lines[i].IsoLink[j].EndTime = L.IsolatedEnd
         FROM    SOA_OutageIsoLink L
         WHERE   L.OutageKey = :CurObject.Lines[i].OutageKey
         BEGIN
            IF CurObject.Lines[i].IsoLink[j].EndTime = '' THEN
               TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Lines[i].IsoLink[j].StartTime)));
            ELSE
               TempMinute = INT4(interval('minute', DATE(CurObject.Lines[i].IsoLink[j].EndTime) - 
                                                    DATE(CurObject.Lines[i].IsoLink[j].StartTime)));
            ENDIF;
            CurObject.Lines[i].IsoLink[j].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);
            j = j + 1;
         END;
      ENDIF;
      i = i + 1;
   END;

   CurObject.BuildCardsArray();

   RETURN;
END;
   
METHOD LoadOutageHistory (
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* List of divisions */
)=
DECLARE
   ArchiveFlag  = INTEGER NOT NULL WITH DEFAULT; 
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   k  = INTEGER NOT NULL WITH DEFAULT;

   EquipWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   LineWhereClause = VARCHAR(1500) NOT NULL WITH DEFAULT;
   KVWhereClause = VARCHAR(100) NOT NULL WITH DEFAULT;
   DivisionWhereClause = VARCHAR(100) NOT NULL WITH DEFAULT;
   OutageWhereClause = VARCHAR(200) NOT NULL WITH DEFAULT;
   EndDate = DATE NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   CurrentTime = DATE NOT NULL WITH DEFAULT;
   TempDivision = INTEGER NOT NULL WITH DEFAULT;
   TempMinute = INTEGER NOT NULL WITH DEFAULT;
   SimpleDivision = Division_ASE DEFAULT NULL; /* enables use of class methods */
   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   /*
   **  Get Current time from Database.
   */
   SELECT :CurrentTime = DATE('now');
   
   CurObject.LastLoad = CurrentTime;
   
   IF CurObject.OutageFlag = 1 THEN /* Taken out of service */
      OutageWhereClause = ' (OS.OutServiceStart BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ';
   ELSEIF CurObject.OutageFlag = 2 THEN  /* Out of Service */
      OutageWhereClause = ' OS.OutServiceStart IS NOT NULL AND ' +
         'OS.OutServiceStart <= ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' AND ' +
         '(OS.OutServiceEnd >= ' + '''' + VARCHAR(:CurObject.StartDate) + '''' + ' OR ' +
         'OS.OutServiceEnd = ' + '''' + '''' + ') AND ';
   
   ELSEIF CurObject.OutageFlag = 3 THEN  /* Restored to Service */
      OutageWhereClause = ' (OS.OutServiceEnd BETWEEN ' + '''' + VARCHAR(:CurObject.StartDate) +
          '''' + ' AND ' + '''' + VARCHAR(:CurObject.EndDate) + '''' + ' ) AND ';
   ENDIF;

   IF CurObject.KV = 1 THEN
      KVWhereClause = ' OS.Voltage <= 33 AND ';   
   ELSEIF CurObject.KV = 2 THEN
      KVWhereClause = ' OS.Voltage > 33 AND ';
   ELSE
      KVWhereClause = '';
   ENDIF;

   IF CurObject.OutageType = 1 THEN  /* Only show isolated outages */
      KVWhereClause = KVWhereClause + ' OS.OutageKey <> 0 AND ';   
   ENDIF;

   IF EffectiveDivisions.LastRow() = 0 THEN /* Called from ASP */
      If lowercase(CurObject.DivisionName) like 'all%' THEN
         /*
         **  Load Division table
         */
         IF SimpleDivision IS NULL THEN
            SimpleDivision = Division_ASE.Create();
         ENDIF;
         
         SimpleDivision.LoadDivisions();
         
         IF SimpleDivision.ReturnCode = 0 THEN
            FOR i = 1 TO SimpleDivision.Dlist.LastRow() DO
               EffectiveDivisions[i].Object = SimpleDivision.Dlist[i].Division;
            ENDFOR;
         ELSE
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = SimpleDivision.ErrorMessage;
            SimpleDivision = NULL;
            RETURN;
         ENDIF;
         SimpleDivision = NULL;
            
      ELSE
         i = 1;
         WHILE LENGTH(CurObject.DivisionName) > 0 DO
            TempDivision = int4(left(CurObject.DivisionName,(locate(CurObject.DivisionName,';')-1)));   
            EffectiveDivisions[i].Object = TempDivision;
            i = i + 1;
            CurObject.DivisionName = shift(CurObject.DivisionName,(-1*(locate(CurObject.DivisionName,';'))));
         ENDWHILE;
      ENDIF;
   ENDIF;

   FOR i = 1 TO EffectiveDivisions.LastRow() DO
      IF i = EffectiveDivisions.LastRow() THEN
         DivisionWhereClause = DivisionWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ')';
      ELSE
         DivisionWhereClause = DivisionWhereClause + 
            VARCHAR(EffectiveDivisions[i].Object) + ',';
      ENDIF;
   ENDFOR;
   
   EquipWhereClause = OutageWhereClause + KVWhereClause + 
      'OS.Type <> ' + varchar(:Type$Line) + ' AND ' +
      'OS.Object = G.Member AND ' +
      'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G.GroupingType IN (SELECT Type ' +
                         'FROM   Udb_ExtendedType ' + 
                         'WHERE  SuperType = ' + varchar(:Type$Substation) + ') AND ' + 
      'G.Grouping = O.Object AND ' +
      'O.primarygrouping IN (' + DivisionWhereClause;


   LineWhereClause = OutageWhereClause + KVWhereClause + 
      'OS.Type = ' + varchar(:Type$Line) + ' AND ' + 
      'OS.Object = G.Grouping AND ' +
      'G.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G.MemberType IN (SELECT Type ' + 
                       'FROM   Udb_ExtendedType ' + 
                       'WHERE  SuperType = ' + varchar(:Type$ACLineSegment) + ') AND ' +
      'G.Member = G2.Member AND ' +  
      'G2.Relationship = ' + varchar(:Interaction$MemberOf) + ' AND ' + 
      'G2.GroupingType IN (SELECT Type ' + 
                          'FROM   Udb_ExtendedType ' + 
                          'WHERE  SuperType = ' + varchar(:Type$Substation) + ') AND ' + 
      'G2.Grouping = O.Object AND ' + 
      'O.primarygrouping IN (' + DivisionWhereClause;
   
   i = 1;
   CurObject.Equip.Clear();
   SELECT DISTINCT
          :CurObject.Equip[i].Card = OS.Card,
          :CurObject.Equip[i].Division = O.PrimaryGrouping,
          :CurObject.Equip[i].CardClassName = OS.CardClassName,
          :CurObject.Equip[i].EndTime = OS.OutServiceEnd,
          :CurObject.Equip[i].EstCompletion = OS.EstCompletion,
          :CurObject.Equip[i].EstInService = OS.EstInService,
          :CurObject.Equip[i].Job = OS.Job,
          :CurObject.Equip[i].LatentFlag = OS.LatentFlag,
          :CurObject.Equip[i].Name = OS.Name,
          :CurObject.Equip[i].Object = OS.Object,
          :CurObject.Equip[i].OutageKey = OS.OutageKey,
          :CurObject.Equip[i].OutageType = OS.OutageType,
          :CurObject.Equip[i].Reason = OS.Reason,
          :CurObject.Equip[i].Remarks = OS.Remarks,
          :CurObject.Equip[i].StartTime = OS.OutServiceStart,
          :CurObject.Equip[i].SubstationName = OS.SubstationName,
          :CurObject.Equip[i].SwitchingItem = OS.SwitchingItem,
          :CurObject.Equip[i].Type = OS.Type,
          :CurObject.Equip[i].TypeName = OS.TypeName,
          :CurObject.Equip[i].Voltage = OS.Voltage,
          :ArchiveFlag = 0
   FROM    SOA_OutageSummary OS,
           Udb_Grouping G,
           Udb_Object O
   WHERE  :EquipWhereClause
   UNION
   SELECT OS.Card,
          O.PrimaryGrouping,
          OS.CardClassName,
          OS.OutServiceEnd,
          OS.EstCompletion,
          OS.EstInService,
          OS.Job,
          OS.LatentFlag,
          OS.Name,
          OS.Object,
          OS.OutageKey,
          OS.OutageType,
          OS.Reason,
          OS.Remarks,
          OS.OutServiceStart,
          OS.SubstationName,
          OS.SwitchingItem,
          OS.Type,
          OS.TypeName,
          OS.Voltage,
          1
   FROM    SOA_ArchiveOutage OS,
           Udb_Grouping G,
           Udb_Object O
   WHERE  :EquipWhereClause
   ORDER BY Division,Card,SwitchingItem
   BEGIN
      IF CurObject.Equip[i].EndTime = '' THEN
         TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Equip[i].StartTime)));
      ELSE
         TempMinute = INT4(interval('minute', DATE(CurObject.Equip[i].EndTime) - 
                                           DATE(CurObject.Equip[i].StartTime)));
      ENDIF;
      CurObject.Equip[i].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);

      IF CurObject.Equip[i].OutageKey <> 0 THEN
         j = 1;
         IF ArchiveFlag = 0 THEN
            SELECT :CurObject.Equip[i].IsoLink[j].StartTime = L.IsolatedStart,
                   :CurObject.Equip[i].IsoLink[j].EndTime = L.IsolatedEnd
            FROM    SOA_OutageIsoLink L
            WHERE   L.OutageKey = :CurObject.Equip[i].OutageKey
            BEGIN
               j = j + 1;
            END;
         ELSE 
            SELECT :CurObject.Equip[i].IsoLink[j].StartTime = L.IsolatedStart,
                   :CurObject.Equip[i].IsoLink[j].EndTime = L.IsolatedEnd
            FROM    SOA_ArchiveIsoLink L
            WHERE   L.OutageKey = :CurObject.Equip[i].OutageKey
            BEGIN
               j = j + 1;
            END;
         ENDIF;

         FOR j = 1 TO CurObject.Equip[i].IsoLink.LastROW DO
            IF CurObject.Equip[i].IsoLink[j].EndTime = '' THEN
               TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ELSE
               TempMinute = INT4(interval('minute', DATE(CurObject.Equip[i].IsoLink[j].EndTime) - 
                                                 DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ENDIF;
            CurObject.Equip[i].IsoLink[j].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);
         ENDFOR;

      ENDIF;
      i = i + 1;
   END;

   i = 1;
   CurObject.Lines.Clear();
   SELECT DISTINCT
          :CurObject.Lines[i].Card = OS.Card,
          :CurObject.Lines[i].Division = O.PrimaryGrouping,
          :CurObject.Lines[i].CardClassName = OS.CardClassName,
          :CurObject.Lines[i].EndTime = OS.OutServiceEnd,
          :CurObject.Lines[i].EstCompletion = OS.EstCompletion,
          :CurObject.Lines[i].EstInService = OS.EstInService,
          :CurObject.Lines[i].Job = OS.Job,
          :CurObject.Lines[i].LatentFlag = OS.LatentFlag,
          :CurObject.Lines[i].Name = OS.Name,
          :CurObject.Lines[i].Object = OS.Object,
          :CurObject.Lines[i].OutageKey = OS.OutageKey,
          :CurObject.Lines[i].OutageType = OS.OutageType,
          :CurObject.Lines[i].Reason = OS.Reason,
          :CurObject.Lines[i].Remarks = OS.Remarks,
          :CurObject.Lines[i].StartTime = OS.OutServiceStart,
          :CurObject.Lines[i].SubstationName = OS.SubstationName,
          :CurObject.Lines[i].SwitchingItem = OS.SwitchingItem,
          :CurObject.Lines[i].Type = OS.Type,
          :CurObject.Lines[i].TypeName = OS.TypeName,
          :CurObject.Lines[i].Voltage = OS.Voltage,
          :ArchiveFlag = 0
   FROM    SOA_OutageSummary OS,
           Udb_Grouping G,
           Udb_Grouping G2,
           Udb_Object O
   WHERE  :LineWhereClause
   UNION
   SELECT OS.Card,
          O.PrimaryGrouping,
          OS.CardClassName,
          OS.OutServiceEnd,
          OS.EstCompletion,
          OS.EstInService,
          OS.Job,
          OS.LatentFlag,
          OS.Name,
          OS.Object,
          OS.OutageKey,
          OS.OutageType,
          OS.Reason,
          OS.Remarks,
          OS.OutServiceStart,
          OS.SubstationName,
          OS.SwitchingItem,
          OS.Type,
          OS.TypeName,
          OS.Voltage,
          1
   FROM    SOA_ArchiveOutage OS,
           Udb_Grouping G,
           Udb_Grouping G2,
           Udb_Object O
   WHERE  :LineWhereClause
   ORDER BY Division,Card,SwitchingItem
   BEGIN
      TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Lines[i].StartTime)));
      CurObject.Lines[i].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);

      IF CurObject.Lines[i].OutageKey <> 0 THEN
         j = 1;
         IF ArchiveFlag = 0 THEN
            SELECT :CurObject.Equip[i].IsoLink[j].StartTime = L.IsolatedStart,
                   :CurObject.Equip[i].IsoLink[j].EndTime = L.IsolatedEnd
            FROM    SOA_OutageIsoLink L
            WHERE   L.OutageKey = :CurObject.Equip[i].OutageKey
            BEGIN
               j = j + 1;
            END;
         ELSE 
            SELECT :CurObject.Equip[i].IsoLink[j].StartTime = L.IsolatedStart,
                   :CurObject.Equip[i].IsoLink[j].EndTime = L.IsolatedEnd
            FROM    SOA_ArchiveIsoLink L
            WHERE   L.OutageKey = :CurObject.Equip[i].OutageKey
            BEGIN
               j = j + 1;
            END;
         ENDIF;

         FOR j = 1 TO CurObject.Equip[i].IsoLink.LastROW DO
            IF CurObject.Equip[i].IsoLink[j].EndTime = '' THEN
               TempMinute = INT4(interval('minute', CurrentTime - DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ELSE
               TempMinute = INT4(interval('minute', DATE(CurObject.Equip[i].IsoLink[j].EndTime) - 
                                                 DATE(CurObject.Equip[i].IsoLink[j].StartTime)));
            ENDIF;
            CurObject.Equip[i].IsoLink[j].TotalOut = CALLPROC ConvertHour(Tot_Min = TempMinute);
         ENDFOR;
      ENDIF;
      i = i + 1;
   END;

   CurObject.BuildCardsArray();

   RETURN;
END;

METHOD TimeDataUpd (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   FOR i = 1 TO CurObject.Upd.Outage.LastROW DO
      CurObject.Upd.Outage[i].StartTime = DATE(CurObject.Upd.Outage[i].StartTimeChar);
      CurObject.Upd.Outage[i].NewStartTime = DATE(CurObject.Upd.Outage[i].NewStartTimeChar);
      CurObject.Upd.Outage[i].NewEndTime = DATE(CurObject.Upd.Outage[i].NewEndTimeChar);
      
      RetCode = CALLPROC SOA_OutageTimeUpd
			 (Card      = CurObject.Upd.Card,
                          Object    = CurObject.Upd.Object,
                          OutageKey = CurObject.Upd.OutageKey,
                          StartTime = CurObject.Upd.Outage[i].StartTime,
                          Action    = CurObject.Upd.Outage[i].Action,
                          NewStartTime = CurObject.Upd.Outage[i].NewStartTime,
                          NewEndTime   = CurObject.Upd.Outage[i].NewEndTime
                         );

      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Toms_Outage_ASE ' + 
                       VARCHAR(CurObject.Upd.Object) +
                       ' Object update failed.');
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'Could not update object due to an Ingres Error.' +
                        ' Please try again.';
         RETURN;
      ELSEIF RetCode = 1 THEN
         CALLPROC DDB_COMMIT;
         CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Toms_Outage_ASE:TimeDataUpd: Archive ' + 
                       VARCHAR(CurObject.Upd.Object) +
                       ' since endtime was set.');

         RetCode = CALLPROC SOA_OutageSummaryDel(
                               Object = CurObject.Upd.Object,
                               StatusTime = CurObject.Upd.Outage[i].NewEndTime);

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurMethod.Trace (Text = varchar(date('now')) + ': Error archiving object.');
            CurObject.ReturnCode = -2;
            CurObject.ErrorMessage = 'Endtime was updated but could not archive object.  Please try again.';
            RETURN;
         ENDIF;        
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDFOR;

   RETURN;
END;
   
METHOD UserDataUpd (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.Upd.EstCompletion = DATE(CurObject.Upd.EstCompletionChar);
   CurObject.Upd.EstInService  = DATE(CurObject.Upd.EstInServiceChar);
      
   RetCode = CALLPROC SOA_OutageUserUpd
			 (Object        = CurObject.Upd.Object,
                          EstCompletion = CurObject.Upd.EstCompletion,
                          EstInService  = CurObject.Upd.EstInService,
                          Remarks       = CurObject.Upd.Remarks,
                          Reason        = CurObject.Upd.Reason
                         );

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = VARCHAR(DATE('now')) + 
                       ': Toms_Outage_ASE ' + 
                       VARCHAR(CurObject.Upd.Object) +
                       ' Object update failed.');
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'Could not update object due to an Ingres Error.' +
                     ' Please try again.';
      RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;

   RETURN;
END;
   
METHOD BuildCardsArray (
)=
DECLARE
   i  = INTEGER NOT NULL WITH DEFAULT;   /*Counter*/
   j  = INTEGER NOT NULL WITH DEFAULT;
   OldCard   = INTEGER NOT NULL WITH DEFAULT;
   OldSwitch = INTEGER NOT NULL WITH DEFAULT;
   CTSEOS = VARCHAR(500) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   j = 1;
   OldCard = 0;
   CurObject.EquipCards.Clear();
   FOR i = 1 TO CurObject.Equip.LastRow DO
      IF CurObject.Equip[i].Card <> OldCard OR
         CurObject.Equip[i].SwitchingItem <> OldSwitch THEN
         OldCard = CurObject.Equip[i].Card;
         OldSwitch = CurObject.Equip[i].SwitchingItem;

         CurObject.EquipCards[j].Card = CurObject.Equip[i].Card; 
         CurObject.EquipCards[j].SwitchingItem = CurObject.Equip[i].SwitchingItem;
         CurObject.EquipCards[j].Division = CurObject.Equip[i].Division;
         IF CurObject.EquipCards[j].SwitchingItem = 0 THEN
            SELECT :CurObject.EquipCards[j].CardName = T.FeederNames,
                   :CTSEOS = T.CTSEOS_Reason
            FROM    TFMS_Card T
            WHERE   T.Card = :CurObject.Equip[i].Card;

            IF CurObject.EquipCards[j].CardName = '' THEN
               /* Look in Archive table for card */
               SELECT :CurObject.EquipCards[j].CardName = T.FeederNames,
                      :CTSEOS = T.CTSEOS_Reason
               FROM    TFMS_ArchiveCard T
               WHERE   T.Card = :CurObject.Equip[i].Card;
            ENDIF;
            CurObject.EquipCards[j].CardName = CurObject.EquipCards[j].CardName +  
                     ' (' + CurObject.Equip[i].CardClassName + ')' + 
                     ' - ' + CTSEOS;            
         ELSE
            SELECT :CurObject.EquipCards[j].CardName = S.Title
            FROM    SLC_InformationItem S
            WHERE   S.Job = :CurObject.Equip[i].SwitchingItem;
            
            IF CurObject.EquipCards[j].CardName = '' THEN
               /* Look in Archive table for Switching Item */
               SELECT :CurObject.EquipCards[j].CardName = S.Title
               FROM    SLC_ArchiveInfItem S
               WHERE   S.Job = :CurObject.Equip[i].SwitchingItem;               
            ENDIF;
            CurObject.EquipCards[j].CardName = CurObject.Equip[i].SubstationName + 
                     ' (' + CurObject.Equip[i].CardClassName + ')' + 
                     ' - ' + CurObject.EquipCards[j].CardName;
         ENDIF;
         j = j + 1;
      ENDIF;
   ENDFOR;

   j = 1;
   OldCard = 0;
   CurObject.LineCards.Clear();
   FOR i = 1 TO CurObject.Lines.LastRow DO
      IF CurObject.Lines[i].Card <> OldCard OR
         CurObject.Lines[i].SwitchingItem <> OldSwitch THEN
         OldCard = CurObject.Lines[i].Card;
         OldSwitch = CurObject.Lines[i].SwitchingItem;

         CurObject.LineCards[j].Card = CurObject.Lines[i].Card; 
         CurObject.LineCards[j].SwitchingItem = CurObject.Lines[i].SwitchingItem;
         CurObject.LineCards[j].Division = CurObject.Lines[i].Division;
         IF CurObject.LineCards[j].SwitchingItem = 0 THEN
            SELECT :CurObject.LineCards[j].CardName = T.FeederNames,
                   :CTSEOS = T.CTSEOS_Reason                 
            FROM    TFMS_Card T
            WHERE   T.Card = :CurObject.Lines[i].Card;

            IF CurObject.LineCards[j].CardName = '' THEN
               /* Look in Archive table for card */
               SELECT :CurObject.LineCards[j].CardName = T.FeederNames,
                      :CTSEOS = T.CTSEOS_Reason
               FROM    TFMS_ArchiveCard T
               WHERE   T.Card = :CurObject.Lines[i].Card;
            ENDIF;
            CurObject.LineCards[j].CardName = CurObject.LineCards[j].CardName +  
                     ' (' + CurObject.Lines[i].CardClassName + ')' + 
                     ' - ' + CTSEOS;            
         ELSE
            SELECT :CurObject.LineCards[j].CardName = S.Title
            FROM    SLC_InformationItem S
            WHERE   S.Job = :CurObject.Lines[i].SwitchingItem;
            
            IF CurObject.LineCards[j].CardName = '' THEN
               /* Look in Archive table for Switching Item */
               SELECT :CurObject.LineCards[j].CardName = S.Title
               FROM    SLC_ArchiveInfItem S
               WHERE   S.Job = :CurObject.Lines[i].SwitchingItem;               
            ENDIF;
            CurObject.LineCards[j].CardName = CurObject.Lines[i].SubstationName + 
                     ' (' + CurObject.Lines[i].CardClassName + ')' + 
                     ' - ' + CurObject.LineCards[j].CardName;
         ENDIF;
         j = j + 1;
      ENDIF;
   ENDFOR;
END;

