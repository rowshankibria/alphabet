/*
**  Application:    CAC
**  Frame:          CompletePermits
**
**  Modifications:
**  11/20/98   pkw  modified fms/slc versions
**  08/02/99   em   Force call to ManageEquip, let it determine if we
**                  can complete.
**  01/08/03   pkw  Merge:  see note below...Note has been taken away
**                  since frame is no longer in two applications.
**  01/13/03   pkw  Select Jobactions when select workstatus in FMS.
**  02/26/03   pkw  Add code related to SOA_ActivityIns.
**  03/11/03   pkw  Don't pass jobs to FCR_ReturnOptions.  We will select
**                  in that frame now.
**  04/10/03   em   Add return comment when completing permit.
**  06/19/03   pkw  Include Card_KeepControl instead of Card_Control.
**  11/17/03   em   Log Permit being tabled or picked up.
**  08/06/04   em   Exit immediately when returning FCR permits to hopefully
**                  prevent double click error. Don't show
**                  confirm screen for SICC.
**  11/05/04   em   On force complete of an FCR permit, check status of permit
**                  to see if the permit has been downloaded.  If not, then
**                  the DO will be instructed to use Force Withdraw.
**  11/16/04   ysp  If the work permit has not been downloaded to fcr, process
**                  permit withdrawal when the DO selects withdraw.
**  02/10/05   em   Enhancement to support Rejection of a returned FCR Permit.
**                  Need to be careful since existing "Reject" logic supports
**                  acknowledgment of an FCR rejection of a DO issued permit which
**                  is different than a DO Rejection of a returned permit.  Don't 
**                  confuse the two types of Reject.
**  03/25/05   em   Ignore SOA_ActivityIns for Steam
**  03/30/05  em    Ignore ConfirmWP Completion for Steam
**  04/09/05  ysp   Fix the bug in the code that determines whether to display
**                  the work status popup when handling click on work status column. 
**  08/15/05  ysp   Modified to support toms-sso interface. The logic to create a copy
**                  of suspended work permit is handled in IncompleteStatus frame.
**  12/02/05  wf    Any combination of "COMPLETE", "NO WORK DONE", "XFER TO ISO' (location status) 
**                  returnd by FCR generate a status of "All work done".
**  12/14/05  ysp   Increase the size of tomove to 160 chars
**  04/21/06  ysp   When processing a returned fcr permit, send back 'IR_PermitComplete' event before
**                  a lengthy transfer process starts. 
**  05/19/06  ysp   FCR Enhancement: support detailed drop/pickup equipment 
**  09/01/06  ysp   Log the FCR rejection comment in the transaction log.
**  09/18/06  ysp   Add PromptDO to CompletionPaper frame.
**  09/26/06  em    Remove call to Confirm WP Completion
**  09/27/06  em    Remove informational message when returned work status is known
**  10/26/06  em    Added logic to support return of FMS substation orders.  Suspended FMS permits
**                  are treated as Back Temp.
**  12/21/06  em    Corrected a case sensitivity error with Back temp 
**  12/22/06  em    Adjusted back from work SSO permit comment; Pass SuspendOrder into PromptProcs so
**                  they can handle SOA_WorkPermit - don't call IncompleteStatus from FMS.
**  01/30/07  em    Remove outgoing message when withdrawing FCR Permit.
**  04/03/07  ysp   Process withdrawal of ISP after request rescind is confirmed, or 
**                  force rescind is performed by D.O.
**  04/16/07  ysp   ITC210: Insert IR interface event in DB event queue
**  09/11/07  em    If manually completing/incompleting an ISSUED ISWP, must update ISWP status.
**  09/20/07  em    Corrected parameter error on SOA_ActivityIns
**  10/03/07  em    Don't allow Table for Steam
**  11/07/07  em    On incomplete permit, pass new parm to WithdrawISP
**  12/04/07  ysp   Show the operator that the TOMS permit was issued to. 
**  01/10/08  em    Change term "tabled" to "suspended"
**  03/21/08  em    For ISWP, don't allow Suspended manual selection.
**                  When permit tabled/suspended, don't set status to 'tbl',
**                  instead mark complete and insert copy of permit (like when
**                  returned electronically to make manual consistent with 
**                  electronic.
**                  For backward compatibility, any currently tabled permits can
**                  still be picked up.
**  04/02/08  em    Look for ISP WithdrawRequest status along with Issued status when DO manually completes.
**  04/02/08  em    Handle "TABLED_TO_DO" SSO return status, convert Suspended to Tabled.
**  04/14/08  em    Don't update "tabled" response unless completion confirmed
**  04/29/08  pkw   Add procedure to handle issuing bussect move from SLC
**  05/12/08  em    Add parameter KeepPermitID when calling Incomplete Status for tabled permit.
**  05/15/08  em    If RR permit returned tabled, show "tabled" status even on FMS. 
**  08/18/08  em    Added CanReturnToService parameter processing for Incomplete Permits.
**  10/15/08  em    Make Can Return To Service parm by reference so a verbal permit can get it recorded.
**  10/19/08  em    Adjust call to IncompleteStatus so that is not called for verbal FCR permit.
**  05/27/10  ysp   Use in service permit object to set Withdraw status
**  03/23/11  pkw   Check for 3G updates needed in CompleteBusSectWP section.
**  08/08/11  ysp   Show Can Return To Service indicator for returned complete permits.
**  12/15/11  ysp   if the permit is the last in an SWP and the status is All Work Done,
**                  update the actual return date  
**  07/16/12  ysp   Use ISWP object to handle completed/incompleted permits.
**  02/12/13  em    Change color of work status field.
**  07/08/13  ysp   check incompleted ISWP to handle NYISO notification email
**  09/19/14  ysp   Use SWPOutageReport class to handle swp updates
**  02/19/15  em    For DSO, skip display of other screens related to permit completion.
**  09/18/15  em    Process new return codes from SelectRescindType, 0=Cancel, 1=Request, 
**                  2=Force.  Don't present yellow warning any longer.
**  09/23/15  em    Remove yellow warning calls when force completing/incompleting FCR permit.
**  09/28/15  em    Add additional confirm prompt when force withdrawing FCR permit.
**  08/20/16  ysp   For FMS, use feeder (3G, 33kv, ISO or KPS) grouping to get its division 
**                  for recording activity
**  12/15/16  ysp   increase the length of ReturnComment to varchar(1500) and bias to landable.
**  02/12/17  em    Change FORCE COMPL term to FORCERETURN
**  05/04/17  em    get rid of warning for ACL move with no Substation
**  10/30/17  em    Change SWPOutageReport to OutageReport.
**  03/13/18  em    Remove OS*WP Request related code
**                  Add selection of OFSPhaseCheckIndicator to pass into CompleteStatus
**  04/06/18  em    Add IssueComplete attribute to SOA_ActivityIns procedure call.
**  05/01/18  em    Add ShiftID attribute to SOA_ActivityIns procedure call.
**  10/03/18  ysp   Show/prompt DO of relay information when PST ISWP is returned.
**  11/15/19  pkw   Check DO activity Threshold
**  11/21/19  pkw   move check activity to file close event
**  01/21/20  ysp   Show Defective relay for PST In servier permit only. Exclude ISWP
**                  created for impacted equipment
**  10/27/21  em    Modified to support DSO orders
**  08/24/22  em    Log confirmation of order rejection or rescission
**  04/19/23  em    Modifidy CPM See Checklist Response update
*/
INITIALIZE
(
#  include StandardDeclarations
   J = ARRAY OF Job;  /* Passed jobs */
   LocalDivisions = ARRAY OF ObjectSummaryClass;    /* Optional List of Local divisions */
   OpOrder = INTEGER NOT NULL WITH DEFAULT;         /* Optional Passed for TOMS Interface */
   PermitRejected = INTEGER NOT NULL WITH DEFAULT;  /* Optional BOOLEAN parm*/
   ReturnPermit = INTEGER NOT NULL WITH DEFAULT;    /* Optional BOOLEAN parm*/

   m = Integer;			

   AssumeWithdraw = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
   BFWStatus = VARCHAR(20) NOT NULL WITH DEFAULT;  /*Back From Work preset*/
   CanReturnToService = CHAR(3) NOT NULL WITH DEFAULT;  /*Incomplete Permit only*/
   CardClass = INTEGER NOT NULL WITH DEFAULT;
   cl = ChoiceList;
   Complete = Date;
   Connected = INTEGER NOT NULL;   /*Equipment connected flag */			
   cr = INTEGER NOT NULL;
   CPMPermit = INTEGER NOT NULL WITH DEFAULT;
   Division = INTEGER NOT NULL WITH DEFAULT;
   EquipReturned = INTEGER NOT NULL WITH DEFAULT;  
   FCRName = VARCHAR(40) NOT NULL WITH DEFAULT;
   FMSPermitOrder = INTEGER NOT NULL WITH DEFAULT; /* BOOLEAN */
   FGOExists = INTEGER NOT NULL WITH DEFAULT;      /* BOOLEAN */
   ForceRescinded = INTEGER NOT NULL WITH DEFAULT;
   ImpactEquipPermit = INTEGER NOT NULL WITH DEFAULT;
   InServicePermit = INTEGER NOT NULL WITH DEFAULT;
   ISWPObject = InServicePermitClass DEFAULT NULL;
   ISPStatus = INTEGER NOT NULL WITH DEFAULT;
   ISWP = INTEGER NOT NULL WITH DEFAULT;
   JIP = ARRAY OF JobInProgress;
   LocationNum = INTEGER NOT NULL WITH DEFAULT;   /*Number of Locs for permit*/
   LocStatusCount = INTEGER NOT NULL WITH DEFAULT; /*# of locs of st */
   LocStatusCountForComp = INTEGER NOT NULL WITH DEFAULT; /*# of locs of complete */
   LocStatusCountForNoWork = INTEGER NOT NULL WITH DEFAULT; /* # of locs of no work done */
   LocStatusCountForXferToISO = INTEGER NOT NULL WITH DEFAULT; /*# of locs of Xfer to ISO */
   LocStatusCountForInComp = INTEGER NOT NULL WITH DEFAULT; /*# of locs of Incomplete */
   MoveRow = INTEGER NOT NULL WITH DEFAULT;
   MsgKey = INTEGER NOT NULL WITH DEFAULT;
   NewOrderStatus = INTEGER NOT NULL WITH DEFAULT;
   NullableRetCode = INTEGER;
   OFSPhaseCheckIndicator = INTEGER NOT NULL WITH DEFAULT;
   OldJob = JobInProgress;	 
   OrderCard = INTEGER NOT NULL WITH DEFAULT; /* op order card */
   OrderNumber = INTEGER NOT NULL WITH DEFAULT; /* op order number */
   OrderStatus = INTEGER NOT NULL WITH DEFAULT; /* op order status */
   OrderTarget = VARCHAR(20) NOT NULL WITH DEFAULT;
   OverrideReason = VARCHAR(60);       /*TextString*/
   PermitStatus = INTEGER NOT NULL WITH DEFAULT;   /*IR WP Status */
   PromptProc = VARCHAR(40) NOT NULL WITH DEFAULT;
   ReducedList = ARRAY OF OperatorClass; 
   RevisionNumber = INTEGER NOT NULL WITH DEFAULT;   /*IR WP Rev # */
   ReturnComment = VARCHAR(1500) NOT NULL WITH DEFAULT;	
   Row = INTEGER NOT NULL WITH DEFAULT;
   ShiftTime = INTEGER NOT NULL WITH DEFAULT;
   SimpleJob = JobInProgress;             /*Enables use of class methods */
   Status = VARCHAR(3) NOT NULL WITH DEFAULT;
   SuspendedOrder = INTEGER NOT NULL WITH DEFAULT;
   SingleSWP = OutageReport DEFAULT NULL;
   TempResponse = VARCHAR(40) NOT NULL WITH DEFAULT;
   TypeOfDay = INTEGER NOT NULL WITH DEFAULT;
   WarningText = VARCHAR(256) NOT NULL WITH DEFAULT;
   WorkGroup = VARCHAR(20) NOT NULL WITH DEFAULT;
) =
DECLARE
   CompleteBusSectWP = PROCEDURE;
ENDDECLARE
BEGIN
   CALLPROC DDB_ROLLBACK;
   AssumeWithdraw = FALSE;
   FMSPermitOrder = FALSE;
   FIELD(Popup).CurBias = FB_INVISIBLE;

   JIP.Clear();
   i = 1;
   WHILE i <= J.LastRow() DO

#     include ConvertJobToJobInProgress

      REPEATED
      SELECT  :JIP[i].LockNumber = O.LockNumber,
              :JIP[i].Combination = O.Combination
      FROM    Udb_Object O
      WHERE   O.Object = :JIP[i].Equip;
      CALLPROC DDB_ROLLBACK;

      Moves[i] = JIP[i].Duplicate();
/*
** If an FCR Returned Permit, only one row will exist in the Moves array.
** The move will already have been completed
*/
      IF PermitRejected = TRUE THEN
         FIELD(Moves[i].Complete_Btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
         FIELD(Moves[i].Complete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
      ELSE
         FIELD(Moves[i].Complete_Btn).BGColor = CC_PALE_CYAN;
      ENDIF;
      IF ReturnPermit = FALSE OR
         PermitRejected = TRUE THEN  
         FIELD(Moves[i].InComplete_Btn).BGColor = CC_PALE_CYAN;
      ENDIF;
      /* Move takeout move text to display if RSMove is blank (DSO) */
      IF Moves[i].RSMove = '' THEN
         Moves[i].RSMove = Moves[i].TOMove;
      ENDIF;

      /* fix the colors of the moves */
      IF Moves[i].TOIssued = '' THEN
         FIELD(Moves[i].TOIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;
      IF Moves[i].TOComplete = '' THEN
         FIELD(Moves[i].TOComplete).BgColor = CC_LIGHT_GRAY;
      ENDIF;
      IF Moves[i].RSIssued = '' THEN
         FIELD(Moves[i].RSIssued).BgColor = CC_LIGHT_GRAY;
      ENDIF;
      IF Moves[i].RSComplete = '' THEN
         FIELD(Moves[i].RSComplete).BgColor = CC_LIGHT_GRAY;
      ENDIF;
/*
**  If the move has been tabled, don't allow them to 
**  complete/incomplete the move.
*/
      IF (Moves[i].Status = 'tbl') THEN
          Moves[i].WorkStatus = 'Tabled';
          FIELD(Moves[i].Complete_Btn).BGColor = FIELD(Moves[i].RSMove).BGColor;
          FIELD(Moves[i].Complete_Btn).FGColor = FIELD(Moves[i].RSMove).BGColor;
          FIELD(Moves[i].Incomplete_Btn).BGColor = FIELD(Moves[i].RSMove).BGColor;
          FIELD(Moves[i].Incomplete_Btn).FGColor = FIELD(Moves[i].RSMove).BGColor;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   IF PermitRejected = FALSE THEN
      /*
      **  Select Operator Info
      */
      Selected.Description = '';
      Selected.Name = '';
      Row = 1;
      SelectOperator = OperatorList;
      WHILE (Row <= SelectOperator.LastRow()) DO

         IF ReturnPermit = TRUE THEN  /* Default to RS Operator sent from FCR or SSO*/
            IF SelectOperator[Row].Object = Moves[1].RSOperator THEN
               FIELD(SelectOperator).ActiveRow = Row;
               Selected.Object = SelectOperator[Row].Object;
               Selected.Name = SelectOperator[Row].Name;
               Selected.Description = SelectOperator[Row].Description;
               FIELD(Selected).CurBias = FB_VISIBLE;
               FIELD(SelectOperator).CurBias = FB_VISIBLE;
               FIELD(find_btn).CurBias = FB_DIMMED;
               ENDLOOP;
            ENDIF;

         ELSEIF SelectOperator[Row].Object = FO.Object THEN
            FIELD(SelectOperator).ActiveRow = Row;
            ENDLOOP;
         ENDIF;
         Row = Row + 1;
      ENDWHILE;
      IF ReturnPermit = TRUE AND Selected.Name = '' AND 
           Selected.Description = '' THEN
         MESSAGE 'Attempting to Return a Permit from the Rapid Restore Interface.  There ' +
                 'is an error determining the returning Operator Name.  You will not' +
                 ' be able to continue - contact tech support so that the ' +
                 'interface error can be analyzed.';
         RETURN PU_CANCEL;

      ELSEIF ReturnPermit = TRUE THEN
         Moves[1].WorkStatus = '';
         IF CurrentApplication <> Application$FMS THEN
            CurFrame.SendUserEvent (EventName = 'LoadSSOReturnedPermit');
         ELSEIF OpOrder <> 0 THEN  /*FMS Substation Permit Order*/
            FMSPermitOrder = TRUE;
            CurFrame.SendUserEvent (EventName = 'LoadSSOReturnedPermit');
         ELSE
            CurFrame.SendUserEvent (EventName = 'LoadFCRReturnedPermit');
         ENDIF;
      ENDIF; 
   ELSE
      IF ReturnPermit = TRUE AND CurrentApplication = Application$FMS AND OpOrder <> 0 THEN
         FMSPermitOrder = TRUE;
      ENDIF;

      CurFrame.SendUserEvent (EventName = 'ShowRejectionComment');
   ENDIF;
  
   MoveRow = 0;  /* Initialize */
   CurFrame.InputFocusField = FIELD(Selected.Description);
END;

ON USEREVENT 'ShowRejectionComment' =
BEGIN
   ReturnComment = '';
   IF CurrentApplication = Application$FMS AND FMSPermitOrder = FALSE THEN
   /*
   **  Display comment from IR_Workpermit only if it exists. If no comment, that
   **  means we are probably processing an approved DO Withdrawal.
   */
      PermitStatus = 0;
      RevisionNumber = 0;
      SELECT  :ReturnComment = Comment,
              :PermitStatus = PermitStatus,
              :RevisionNumber = RevisionNumber
      FROM    IR_WorkPermit
      WHERE   WorkPermit = :Moves[1].Job;
   
   ELSE
     IF CurrentApplication = Application$DSO THEN
      SELECT :OrderStatus = OrderStatus,
             :ReturnComment = AckRejectComment
      FROM   IR_DSOOrder
      WHERE  OrderNumber = :OpOrder;     
     ELSE
      SELECT :OrderStatus = OrderStatus,
             :ReturnComment = AckRejectComment
      FROM   IR_OperatingOrder
      WHERE  OrderNumber = :OpOrder;
     ENDIF;
      /* 
      **  Show the operator that the permit was issued to. 
      */
      SelectOperator.Clear();
      SELECT  DISTINCT 
          :SelectOperator[1].Object = Object,
          :selectOperator[1].Name = Name,
          :SelectOperator[1].Description = Description
      FROM   UDB_Object 
      WHERE  Object = :Operator$OpOrder;

      IF SelectOperator.LastRow = 1 THEN
         Selected.Object  = SelectOperator[1].Object; 
         Selected.Name = SelectOperator[1].Name;
         Selected.Description = SelectOperator[1].Description;
      ENDIF;
   ENDIF;

   IF ReturnComment <> '' THEN
      WPStack.ReturnComment = ReturnComment;
      FIELD(WPStack).CurBias = FB_LANDABLE;
      AssumeWithdraw = FALSE;
   ELSE 
      AssumeWithdraw = TRUE;
   ENDIF;
END;


ON USEREVENT 'LoadSSOReturnedPermit' =
BEGIN
   Moves[1].WorkStatus = '';
   Moves[1].WorkStatusInt = Prompt$FromWork;  /*Force this for FMS Op Order Permits*/
   ReturnComment = '';
   BFWStatus = '';
/*
** Set work status
*/ 
   SELECT :BFWStatus = ReturnStatus,
          :CanReturnToService = ReturnToService,
          :OFSPhaseCheckIndicator = PhaseCheckIndicator
   FROM   SOA_WorkPermit
   WHERE  PermitJobID = :Moves[1].Job AND
          ReturnStatus <> ''; 

   IF BFWStatus = 'COMPLETE' THEN      
      Moves[1].WorkStatus = 'All work done';
   ELSEIF BFWStatus = 'INCOMPLETE' THEN      
      Moves[1].WorkStatus = 'Incomplete';
   ELSEIF BFWStatus = 'TABLED' OR BFWStatus = 'TABLED_TO_DO' OR BFWStatus = 'SUSPENDED' THEN  
      IF CurrentApplication = Application$FMS THEN
         Moves[1].WorkStatus = 'Tabled';
         SuspendedOrder = OpOrder;
      ELSE    
         Moves[1].WorkStatus = 'Tabled';
      ENDIF;
   ENDIF;
   FIELD(Moves[*].WorkStatus).CurBias = FB_Visible;
/*
** display returned remark
*/
   IF CurrentApplication = Application$DSO THEN
    SELECT :OrderStatus = OO.OrderStatus,
          :ReturnComment = OO.ReturnComment
    FROM   IR_DSOOrder OO,
          IR_DSOOrderJob JTS
    WHERE  OO.OrderNumber = :OpOrder AND
          JTS.OrderNumber = OO.OrderNumber AND
          JTS.Job = :Moves[1].Job;   
   ELSE   
    SELECT :OrderStatus = OO.OrderStatus,
          :ReturnComment = SQUEEZE(OO.ReturnComment + :HC_NEWLINE +  JTS.ReturnRemark)
    FROM   IR_OperatingOrder OO,
          IR_OpOrderJobs JTS
    WHERE  OO.OrderNumber = :OpOrder AND
          JTS.OrderNumber = OO.OrderNumber AND
          JTS.Job = :Moves[1].Job;
   ENDIF;

   IF ReturnComment <> ''  THEN
      WPStack.ReturnComment = /* 'SSO has returned the permit ' + BFWStatus + ':' + 
                              HC_NEWLINE + */
                              ReturnComment; 
      FIELD(WPStack).CurBias = FB_LANDABLE;
   ENDIF;
   FIELD(Moves[*].Incomplete_Btn).CurBias = FB_INVISIBLE;

/*
**  Select jobactions for this job if not done already.
*/
   IF Moves[1].Jobaction.LastRow() = 0 THEN
      i = 1;
      REPEATED
      SELECT DISTINCT
             :Moves[1].JobAction[i].JobClass = JA.JobClass,
             :Moves[1].JobAction[i].FeederEquip = JA.FeederEquip,
             :Moves[1].JobAction[i].ToRs = JA.ToRs,
             :Moves[1].JobAction[i].IssueCompl = JA.IssueCompl,
             :Moves[1].JobAction[i].Action = JA.Action,
             :Moves[1].JobAction[i].Status = JA.Status
      FROM   FMS_JobAction JA,
             SOA_JobControl J,
             SOA_ActiveCard AC
      WHERE  J.Job = :Moves[1].Job AND
             J.Card = AC.Card AND
             AC.TypeofCard = JA.TypeofCard AND
             JA.JobClass = :Moves[1].JobClass AND
             JA.EquipClass = J.MoveEquipClass AND
             JA.StepPair  = J.StepPair  
      ORDER BY FeederEquip DESC
      BEGIN
         i = i + 1;
      END;                     
   ENDIF;
END;

ON USEREVENT 'LoadFCRReturnedPermit' =
BEGIN
/*
** Load and display details related to FCR returned permit.  
** Check if Back Temp. Check if all location statuses are known.
** If not then call Completion Papers frame.
*/
   Moves[1].WorkStatus = '';
   ReturnComment = '';
   BFWStatus = '';

   SELECT :ReturnComment = Comment,
          :BFWStatus = BackFromWorkStatus
   FROM   IR_WorkPermit
   WHERE  WorkPermit = :Moves[1].Job;
   
   IF ReturnComment <> '' THEN
      WPStack.ReturnComment = ReturnComment;
      FIELD(WPStack).CurBias = FB_LANDABLE;
   ENDIF;

   IF BFWStatus = 'BT' THEN   
      BFWStatus = 'Back temp';
   ELSE
/*
** Check if all returned location statuses are one of the three statuses 
** we can handle.  If not, display Completion Papers and ask the
** DO to select one.
*/   
      BFWStatus = '';
      LocationNum = 0; 
      LocStatusCountForComp = 0;
      LocStatusCountForNoWork = 0;
      LocStatusCountForXferToISO = 0;
      LocStatusCountForInComp = 0;
  
      SELECT :BFWStatus = LocationStatus
      FROM   IR_WorkLocation
      WHERE  WorkPermit = :Moves[1].Job
      BEGIN
         LocationNum = LocationNum + 1;

         IF BFWStatus LIKE 'COMPLETE%' THEN
            LocStatusCountForComp = LocStatusCountForComp + 1;

         ELSEIF BFWStatus LIKE 'INCOMPLETE%' THEN
            LocStatusCountForInComp = LocStatusCountForInComp + 1;

         ELSEIF BFWStatus LIKE 'NO WORK DONE%' THEN
            LocStatusCountForNoWork = LocStatusCountForNoWork + 1;

         ELSEIF BFWStatus LIKE 'XFER TO ISO%' THEN
            LocStatusCountForXferToISO = LocStatusCountForXferToISO + 1;
         ENDIF;
      END;

      BFWStatus = '';      
      IF LocationNum =  LocStatusCountForNoWork THEN
         BFWStatus = 'No work done';
      ELSE
         IF LocationNum = LocStatusCountForInComp THEN
            BFWStatus = 'Incomplete';
         ELSE
            IF LocationNum = LocStatusCountForComp + LocStatusCountForNoWork + LocStatusCountForXferToISO THEN
               BFWStatus = 'All work done';
            ENDIF;
         ENDIF;
      ENDIF;
    ENDIF;  /* End Back Temp*/


   FIELD(Moves[*].Incomplete_Btn).CurBias = FB_INVISIBLE;
   IF BFWStatus <> '' THEN
/*
** Back Temp may not be rejected
*/
      IF BFWStatus = 'Back temp' THEN
         MESSAGE 'FCR has returned the permit: ' + BFWStatus + HC_NEWLINE +
                 'Please review the completion papers and confirm.  You cannot reject a Back Temp permit';
      ELSE
/*
** Let's not display this additional unnecessary informational message.
**
         MESSAGE 'FCR has returned the permit: ' + BFWStatus + HC_NEWLINE +
                 'Please review the completion papers, then confirm or reject the permit.';
*/
         FIELD(Moves[*].Reject_Btn).CurBias = FB_LANDABLE;
      ENDIF;
      Moves[1].WorkStatus = BFWStatus;
      FIELD(Moves[*].WorkStatus).CurBias = FB_Visible;

   ELSE
      MESSAGE 'Unable to determine the completion status of the permit ' +
              'returned by the FCR.  Please review the Completion ' +
              'Papers and select the Back From Work Status when you Confirm ' +
              'the permit.';
      FIELD(Moves[*].Reject_Btn).CurBias = FB_LANDABLE;
   ENDIF;

   CALLFRAME CompletionPapers (
                    WorkPermit = Moves[1].Job,
                    FCR = Selected.Description,
                    CardFeederName = CardDetails.FeederName,
                    Card = CardDetails.Card,
                    PromptDO = 1);

   FIELD(Menu.File.Completion_Papers).CurBias = MB_ENABLED;

   IF Moves[1].WorkStatus <> '' THEN  
/*
**  Select jobactions for this job if not done already.
*/
      IF Moves[1].Jobaction.LastRow() = 0 THEN
         i = 1;
         REPEATED
         SELECT DISTINCT
                :Moves[1].JobAction[i].JobClass = JA.JobClass,
                :Moves[1].JobAction[i].FeederEquip = JA.FeederEquip,
                :Moves[1].JobAction[i].ToRs = JA.ToRs,
                :Moves[1].JobAction[i].IssueCompl = JA.IssueCompl,
                :Moves[1].JobAction[i].Action = JA.Action,
                :Moves[1].JobAction[i].Status = JA.Status
         FROM   FMS_JobAction JA,
                SOA_JobControl J,
                SOA_ActiveCard AC
         WHERE  J.Job = :Moves[1].Job AND
                J.Card = AC.Card AND
                AC.TypeofCard = JA.TypeofCard AND
                JA.JobClass = :Moves[1].JobClass AND
                JA.EquipClass = J.MoveEquipClass AND
                JA.StepPair  = J.StepPair  
         ORDER BY FeederEquip DESC
         BEGIN
            i = i + 1;
         END;                     
      ENDIF;

/*
** We have set the status, no work status change so we have to set our
** procprompt variable here.
*/ 
      i = 1;
      WHILE i <= Moves[1].Jobaction.LastRow() DO
        IF Moves[1].Jobaction[i].TORS = Job$RestoreInt AND
           Moves[1].Jobaction[i].IssueCompl = JobClass$Complete AND
           Moves[1].Jobaction[i].Action = JobAction$Prompt AND
          (Moves[1].Jobaction[i].Status = Prompt$FromWork OR
           Moves[1].Jobaction[i].Status = Prompt$FromWorkFCRNoFGO OR
           Moves[1].Jobaction[i].Status = Prompt$FromWorkFCR)  THEN
    
           ENDLOOP;
        ENDIF;
        i = i + 1;
      ENDWHILE;

      IF Moves[1].JobAction[i].Status = Prompt$FromWorkFCR THEN      
         Moves[1].WorkStatusInt = Prompt$FromWorkFCR;
      ELSE
         Moves[1].WorkStatusInt = Prompt$FromWork;
      ENDIF;
   ENDIF;
END;


ON ChildEntry Moves[*].WorkStatus =
BEGIN
/*
**   Do a simple check to see if move selected was an OTW move before
**   changing cr counter.
*/
   cr = FIELD(Moves).WhichRow(Cellfield = Curframe.TriggerField);
   IF PermitRejected = TRUE THEN
      RESUME;
   ENDIF;
/*
**  Don't let them change the workstatus if the move has already been
**  completed/incompleted and the status is not tabled.
*/
   IF (FIELD(Moves[cr].Complete_Btn).BGColor <> CC_PALE_CYAN OR
       FIELD(Moves[cr].InComplete_Btn).BGColor <> CC_PALE_CYAN) AND
      (Moves[cr].Status <> 'tbl' AND
      (ReturnPermit = FALSE AND
       PermitRejected = FALSE)) THEN
      RESUME;
   ENDIF;

   cl.ChoiceItems.Clear();
   IF CurrentApplication = Application$FMS THEN
/* 
**   Clear work status to make sure they select from popup before completing
**   move
*/
      IF ReturnPermit = FALSE THEN
         Moves[cr].WorkStatus = '';
      ENDIF; 

      cl.ChoiceItems.Clear();
/*
** Check for FGO status on the feeder.  If it exists, it can't be picked again.
*/    
      FGOExists = FALSE;
      SELECT  :FGOExists = :TRUE
      FROM    FMS_ObjectStatus 
      WHERE   Object = :CardDetails.Object[1].Object AND
              Status = :Status$FGO;
/*
**  Select jobactions for this job if not done already.
*/
      IF Moves[cr].Jobaction.LastRow() = 0 THEN
         i = 1;
         REPEATED
         SELECT DISTINCT
                :Moves[cr].JobAction[i].JobClass = JA.JobClass,
                :Moves[cr].JobAction[i].FeederEquip = JA.FeederEquip,
                :Moves[cr].JobAction[i].ToRs = JA.ToRs,
                :Moves[cr].JobAction[i].IssueCompl = JA.IssueCompl,
                :Moves[cr].JobAction[i].Action = JA.Action,
                :Moves[cr].JobAction[i].Status = JA.Status
         FROM   FMS_JobAction JA,
                SOA_JobControl J,
                SOA_ActiveCard AC
         WHERE  J.Job = :Moves[cr].Job AND
                J.Card = AC.Card AND
                AC.TypeofCard = JA.TypeofCard AND
                JA.JobClass = :Moves[cr].JobClass AND
                JA.EquipClass = J.MoveEquipClass AND
                JA.StepPair  = J.StepPair  
         ORDER BY FeederEquip DESC
         BEGIN
            i = i + 1;
         END;            
         
      ENDIF;
/*
**  Show the proper choices for PromptFromWork and PromptFromWorkFCR   
*/
      i = 1;
      WHILE i <= Moves[cr].Jobaction.LastRow() DO
         IF Moves[cr].Jobaction[i].TORS = Job$RestoreInt AND
            Moves[cr].Jobaction[i].IssueCompl = JobClass$Complete AND
            Moves[cr].Jobaction[i].Action = JobAction$Prompt AND
           (Moves[cr].Jobaction[i].Status = Prompt$FromWork OR
            Moves[cr].Jobaction[i].Status = Prompt$FromWorkFCRNoFGO OR
            Moves[cr].Jobaction[i].Status = Prompt$FromWorkFCR)  THEN
    
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;

      IF i > Moves[cr].Jobaction.LastRow() THEN
         MESSAGE 'Move not set up to call FromWork Prompt.  ' +
                 'Must be fixed in DBM Job Class Maintenance.  ' +
                 'Please correct then try again.';
         RESUME;

      ELSEIF ReturnPermit = TRUE THEN
/*
** For FCR returned permits, FGO is managed separately. IF returned BT, we
** control and don't allow change, otherwise we allow only three choices.
*/
         IF Moves[cr].JobAction[i].Status = Prompt$FromWorkFCR THEN      
            Moves[cr].WorkStatusInt = Prompt$FromWorkFCR;
         ELSE
            Moves[cr].WorkStatusInt = Prompt$FromWork;
         ENDIF;

         cl.ChoiceItems[1].EnumText = 'All work done';
         cl.ChoiceItems[1].EnumValue = 1;
         cl.ChoiceItems[2].EnumText = 'Incomplete';
         cl.ChoiceItems[2].EnumValue = 2;
         cl.ChoiceItems[3].EnumText = 'No work done';
         cl.ChoiceItems[3].EnumValue = 3;          

      ELSEIF Moves[cr].JobAction[i].Status = Prompt$FromWork OR 
           Moves[cr].Jobaction[i].Status = Prompt$FromWorkFCRNoFGO THEN
         Moves[cr].WorkStatusInt = Prompt$FromWork;
    
         cl.ChoiceItems[1].EnumText = 'All work done';
         cl.ChoiceItems[1].EnumValue = 1;
         cl.ChoiceItems[2].EnumText = 'Back temp';
         cl.ChoiceItems[2].EnumValue = 2;
         cl.ChoiceItems[3].EnumText = 'Incomplete';
         cl.ChoiceItems[3].EnumValue = 3;
         cl.ChoiceItems[4].EnumText = 'No work done';
         cl.ChoiceItems[4].EnumValue = 4;

      ELSEIF Moves[cr].JobAction[i].Status = Prompt$FromWorkFCR THEN      
         Moves[cr].WorkStatusInt = Prompt$FromWorkFCR;
    
         cl.ChoiceItems[1].EnumText = 'All work done';
         cl.ChoiceItems[1].EnumValue = 1;
         cl.ChoiceItems[2].EnumText = 'Back temp';
         cl.ChoiceItems[2].EnumValue = 2;
         cl.ChoiceItems[3].EnumText = 'Incomplete';
         cl.ChoiceItems[3].EnumValue = 3;
         cl.ChoiceItems[4].EnumText = 'No work done';
         cl.ChoiceItems[4].EnumValue = 4;
         IF FGOExists = FALSE THEN
            cl.ChoiceItems[5].EnumText = 'Field grds only';
            cl.ChoiceItems[5].EnumValue = 5;
         ENDIF;
      ENDIF;

   ELSEIF CurrentApplication = Application$SDS THEN

         cl.ChoiceItems[1].EnumText = 'All work done';
         cl.ChoiceItems[1].EnumValue = 1;
         cl.ChoiceItems[2].EnumText = 'Incomplete';
         cl.ChoiceItems[2].EnumValue = 2;
         cl.ChoiceItems[3].EnumText = 'No work done';
         cl.ChoiceItems[3].EnumValue = 3;          

   ELSE   /* TOMS permit return */
/*
**  If this is a WorkPermit, show the workpermit stuff.
**  If this is a TestPermit, show the testpermit stuff.
*/
      IF Moves[cr].StepPair = StepHeading$WorkPermit THEN

/*
** ISWP?
*/
         ISWP = 0;
         SELECT :ISWP = ISPermit
         FROM   SOA_InServicePermit
         WHERE  Job = :Moves[cr].Job;

         IF (Moves[cr].Status = 'tbl') THEN
            cl.ChoiceItems[1].EnumText = 'Picked Up';
            cl.ChoiceItems[1].EnumValue = 7;
/* 
** Take this away with other 3/21/08 changes
            cl.ChoiceItems[2].EnumText = 'Tabled';
            cl.ChoiceItems[2].EnumValue = 6;
*/
         ELSE    
            cl.ChoiceItems[1].EnumText = 'All work done';
            cl.ChoiceItems[1].EnumValue = 1;
            cl.ChoiceItems[2].EnumText = 'Incomplete';
            cl.ChoiceItems[2].EnumValue = 4;
            cl.ChoiceItems[3].EnumText = 'No work done';
            cl.ChoiceItems[3].EnumValue = 5;
            IF ISWP = 0 AND CurrentApplication <> Application$DSO THEN
               cl.ChoiceItems[4].EnumText = 'Tabled';
               cl.ChoiceItems[4].EnumValue = 6;
               cl.ChoiceItems[5].EnumText = '      ';
               cl.ChoiceItems[5].EnumValue = 0;
            ELSE
               cl.ChoiceItems[4].EnumText = '      ';
               cl.ChoiceItems[4].EnumValue = 0;
            ENDIF;
         ENDIF;
      ELSEIF Moves[cr].StepPair = StepHeading$TestPermit THEN
         cl.ChoiceItems[1].EnumText = 'All work done';
         cl.ChoiceItems[1].EnumValue = 1;
         cl.ChoiceItems[2].EnumText = 'Test Complete';
         cl.ChoiceItems[2].EnumValue = 5;
         cl.ChoiceItems[3].EnumText = 'Test Incomplete';
         cl.ChoiceItems[3].EnumValue = 4;
         cl.ChoiceItems[4].EnumText = '      ';
         cl.ChoiceItems[4].EnumValue = 0;
      ELSE
         /*
         ** this should never happen since all moves are 
         ** either work or test permits
         */
         RESUME;
      ENDIF;
   ENDIF;

   FIELD(Popup).ValueList = cl;
   FIELD(Popup).UpdChoiceList();    
/*
**  Place the popup field on the tablefield.
*/
   FIELD(Popup).CurBias = FB_CHANGEABLE;
   Field(Popup).AbsXLeft = FormField(CurFrame.TriggerField).AbsXLeft;
   Field(Popup).AbsYTop = FormField(CurFrame.TriggerField).AbsYBottom;

   /** Handle case where popup would go to low on the screen */
   IF Field(Popup).AbsYBottom > field(Moves).AbsYBottom THEN
      Field(Popup).AbsYBottom = field(Moves).AbsYBottom;
   ENDIF;
   CurFrame.Flush();
END;

ON Click Popup =
BEGIN
   IF Curframe.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;
/*
**  If they picked a NEW (non-blank) value, place it in the workstatus column
*/
   IF FIELD(PopUp).CurEnumValue <> 0 AND
      FIELD(PopUp).CurEnumText <> Moves[cr].WorkStatus THEN

      Moves[cr].WorkStatus = FIELD(Popup).CurEnumText;
   ELSE
      FIELD(Popup).CurBias = FB_INVISIBLE;
      RESUME;
   ENDIF;
/*
**  Deal with a tabled/pickedup workstatus
*/
   IF FIELD(Popup).CurEnumText Like 'Tabled%' OR           /* tabled */
      FIELD(Popup).CurEnumText Like 'Picked Up%' THEN         /* picked up */
      /*
      **  Set the workstatus stuff
      */
      IF Moves[cr].Response like 'Tabled%' OR
         Moves[cr].Response like 'Picked Up%' OR
         Moves[cr].Response like '' THEN    
        /*
        **  Add the date to the end...since we want to format the date
        **  like 7/1 14:04, we need to do it ourselves
        */
         TempResponse = Moves[cr].WorkStatus + ' ' 
                + varchar(date_part('month',date('now'))) + '/'
                + varchar(date_part('day',date('now'))) + ' ';
         IF date_part('hour',date('now')) < 10 THEN
            TempResponse = TempResponse + '0';
         ENDIF;
         TempResponse = TempResponse + 
                        varchar(date_part('hour',date('now'))) + ':';
         IF date_part('minutes',date('now')) < 10 THEN
            TempResponse = TempResponse + '0';
         ENDIF;
         TempResponse = TempResponse + 
                        varchar(date_part('minutes',date('now')));            
      ELSE
         TempResponse = Squeeze(Moves[cr].Response + ' ' + Moves[cr].WorkStatus);
      ENDIF;

      IF Moves[cr].WorkStatus = 'Tabled' THEN
/*
**********************THIS IS BEING CHANGED
         RetCode = CALLPROC SOA_JobStatusUpd
                        (Job = Moves[cr].Job,
                         Status = 'tbl');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to suspend this move.';
            RESUME;
         ENDIF;
         Status = 'tbl';

         CALLPROC SOA_LogIns (
                 Card = Moves[cr].Card,
                 Job  = Moves[cr].Job,
                 SwitchingItem = Moves[cr].SwitchingItem,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Permit',
                 Old  = '',
                 New  = 'Permit Suspended');
***********************************************************/
      ELSEIF Moves[cr].WorkStatus = 'Picked Up' THEN

/*
**  Update response and status fields for job.
*/
      IF CPMPermit > 0 THEN
         TempResponse = 'See Checklist - ' + TempResponse;
      ENDIF;
      Moves[cr].Response = TempResponse;
      Moves[cr].ResponseUpd();

         RetCode = CALLPROC SOA_JobStatusUpd
                        (Job = Moves[cr].Job,
                         Status = '');
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            Message 'Unable to pickup this move.';
            RESUME;
         ENDIF;
         Status = '';

         CALLPROC SOA_LogIns (
                 Card = Moves[cr].Card,
                 Job  = Moves[cr].Job,
                 SwitchingItem = Moves[cr].SwitchingItem,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'Permit',
                 Old  = '',
                 New  = 'Permit Picked Up');
      ENDIF;
      CALLPROC DDB_COMMIT;
/*
**  Loop through the moves and update the fields for all occurrences of this job.
*/
      m = 1;
      WHILE m <= Moves.LastRow() DO
         IF Moves[cr].Job = Moves[m].Job THEN
            Moves[cr].Response = TempResponse;    
            Moves[cr].Status = Status;
         ENDIF;
         m = m + 1;
      ENDWHILE;        
/*
**  If the move has been tabled, don't allow them to complete/incomplete the move.
*/
      IF Moves[cr].Status = 'tbl' OR 
         Moves[cr].Response like 'Pick%' THEN

         FIELD(Moves[cr].Complete_Btn).BGColor = FIELD(Moves[cr].RSMove).BGColor;
         FIELD(Moves[cr].Complete_Btn).FGColor = FIELD(Moves[cr].RSMove).BGColor;
         FIELD(Moves[cr].InComplete_Btn).BGColor = FIELD(Moves[cr].RSMove).BGColor;
         FIELD(Moves[cr].InComplete_Btn).FGColor = FIELD(Moves[cr].RSMove).BGColor;
      ENDIF;
   ENDIF;

   FIELD(Popup).CurBias = FB_INVISIBLE;    
/*  Take focus away from workstatus field so user can re-select */
   CurFrame.InputFocusField = Field(exit_btn);
END;


ON ChildEntry Moves[*].Complete_Btn =
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   i = FIELD(Moves).CurRow;  
/*
**  Make sure the move is able to be completed.
*/
   IF FIELD(Moves[i].Complete_Btn).BGColor <> CC_PALE_CYAN THEN
      RESUME;
   ENDIF;
/*
**  Make sure an operator has been selected.
*/
   IF (Selected.Object <= 0) THEN
      Message 'You must select an operator from the list.';
      RESUME;
   ENDIF;
/*
** if the permit was issued to SSO using the TOMS-SSO interface. The DO 
** will have to use Rescind Request or Force Rescind to manually complete
** or incomplete the permit.
*/ 

# include CheckForSSOPermit

/*
** Check for Issued ISWP
** - If DO is manually completing a permit, we need to set the ISWP status to Complete.
** - If this permit is returned Complete from RR, ISWP status is now Complete, we may need to 
**   notify T.O. of the completion.
** - If this permit was requested to be withdrawn and is returned from RR, we will set the ISWP
**   status to Complete as well.
*/
   InServicePermit = 0;
   WorkGroup = '';
   SELECT :InServicePermit = ISPermit,
          :WorkGroup = WorkGroup
   FROM   SOA_InServicePermit
   WHERE  Job = :Moves[i].Job AND
          Status IN (:ISPStatus$Issued, 
                     :ISPStatus$Complete, 
                     :ISPStatus$InComplete, 
                     :ISPStatus$WithdrawRequest);
/*
**  Make sure they have picked a workstatus 
*/
   IF Moves[i].WorkStatus = '' THEN
      Message 'You must choose a work status.';
      RESUME;
   ENDIF;
/*
** If the Permit was issued to the FCR it was downloaded using the FCR
** interface.  The DO will have to Override the warning if they want to 
** continue because things may get screwed up if the DO completes an FCR
** permit and then the FCR returns it through the Interface.
*/
    IF Moves[i].TOOperator = Operator$FCR AND ReturnPermit = FALSE THEN
/*
** Don't allow Force Complete if permit is not yet downloaded.
*/     
       PermitStatus = -1;
       SELECT :PermitStatus = PermitStatus
       FROM   IR_WorkPermit
       WHERE  WorkPermit = :Moves[i].Job;

       IF PermitStatus = Permit$Issued THEN
          MESSAGE 'The FCR Permit has not been sent to the FCR possibly due ' +
                  'to technical problems.  You must Force Withdraw it.';
          RESUME;
       ENDIF;

       IF CurFrame.ConfirmPopUp (MessageText = 
                       'Permit was sent to the FCR electronically. Have you informed the FCR? ' +
                       'Are you sure you want to complete it manually?') = PU_CANCEL THEN
          RESUME;
       ENDIF;       
    ENDIF;
/*
**  Check to see if operator pocesses required skills for move
*/
   IF ReturnPermit = FALSE THEN
      RetCode = CALLPROC OperatorChecks(JIP = Moves[i],
                                        IssuedOperator = IFNULL(Selected.Object,0));
      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;

   IF CurrentApplication <> Application$FMS AND 
        CurrentApplication <> Application$SDS AND 
         CurrentApplication <> Application$DSO THEN
      RetCode = CALLFRAME ManageEquipment (
                                    Card = Moves[i].Card,
                                    Function = PermitObjective$Completion,
                                    PermitJob = Moves[i].Job,
                                    PermitSwItem = Moves[i].SwitchingItem,
                                    TPermitMove = Moves[i].TOMove,
                                    TPermitStatus = Moves[i].WorkStatus);

      IF Retcode = PU_CANCEL THEN
         RESUME;
 
      ELSEIF RetCode = PU_OK THEN
         SOAFrame.SendUserEvent (EventName = 'CheckConnectivity');
         SOAFrame.SendUserEvent (EventName = 'CheckForMissingDocuments');
      ENDIF;
   ENDIF;
/*
**  Set up response column
*/
   IF Moves[i].Response like 'Tabled%' OR
      Moves[i].Response like 'Picked Up%' THEN    
      TempResponse = Moves[i].WorkStatus;
   ELSE
      TempResponse = Squeeze(Moves[i].Response + ' ' + Moves[i].WorkStatus);
   ENDIF;
/*
** Don't display confirm on an FCR completion or SICC permit.
*
   IF ReturnPermit = FALSE AND 
         (UserGroup <> Group$SICC AND CurrentApplication <> Application$SDS) THEN 
      RetCode = CALLFRAME ConfirmWPCompletion (Job = Moves[i].Job, 
                                            SwitchingItem = Moves[i].SwitchingItem,
                                            Card = Moves[i].Card);

      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;
/*
**  Do this so that timestamp shows up correctly on feedercard screen.
*/
   CurFrame.InputFocusField = Field(exit_btn);

/*
**  Set status attribute for JobInProgress methods 
*/
   Moves[i].Status = Job$Restore;
/*
**  Perform JobChecks on move
*/
   IF ReturnPermit = FALSE THEN
      RetCode = Moves[i].JobChecks(IssueCompl = JobClass$Complete);
   
      IF RetCode = PU_CANCEL THEN
         RESUME;
      ENDIF;
   ENDIF;
/*
**  Record the state of things
*/
   Complete = 'now';
/*
** If manual entry mode is true, allow them to change the complete time
*/
   IF ReturnPermit = FALSE THEN
      IF ManualEntryModeFlag = TRUE THEN
         CALLFRAME ManualTimeEntry 
               (PassedTime = byref(Complete),
                MoveText = Moves[i].RSMove,
                MessageText = 'RS Complete');
      ENDIF;
/*
**  Complete the move
*/
      RetCode = SimpleJob.CompleteMove(Job = Moves[i],
                                    ReturnOp = Selected.Object,
                                    SetTime = Complete);
      IF RetCode = PU_CANCEL THEN
         Message 'Please manually complete the move.';
      ENDIF;
      
   ELSEIF CurrentApplication = Application$DSO THEN  /* Mark TOComplete for Display */
         RetCode = CALLPROC SOA_CompleteMove(Job = Moves[i].Job,
                                       Complete = Complete,
                                       Status = Job$TakeOut
                                       );
   ENDIF;
/*
**  Perform JobActions for move
*/
   RetCode = Moves[i].JobActions(IssueCompl = JobClass$Complete);
   IF RetCode = PU_CANCEL THEN
      
      RetCode = SimpleJob.InCompleteMove(Job = Moves[i]);
       
      IF RetCode = PU_CANCEL THEN
         Message 'Please update move manually';
      ENDIF;

      RESUME NEXT;
   ENDIF;
/*
**  If Completing WorkPermit from SLC on a BusSect equipment type.  Check to see if 
**  OTWS should be cleared on FMS cards.
*/
   IF CurrentApplication = Application$SLC AND
      Moves[i].StepPair = StepHeading$WorkPermit AND
      Moves[i].EquipClass = TypeName$BusSect THEN
      CALLPROC CompleteBusSectWP(Card = Moves[i].Card,
                              SwitchingItem = Moves[i].SwitchingItem);
   ENDIF;
/*
**   Perform workstatus prompts
*/
   IF CurrentApplication = Application$FMS THEN
      OldJob = Moves[i].Duplicate();
      IF Moves[i].StepPair = StepHeading$WorkPermit THEN 
         REPEATED
         SELECT :PromptProc = T.Name
         FROM   Udb_Type T
         WHERE  Type = :Moves[i].WorkStatusInt;

         PromptProc = Squeeze('PromptProc' + :PromptProc);
         RetCode = CALLPROC :PromptProc (JIP = Moves[i], SuspendedOrder = SuspendedOrder);
    
         IF RetCode = PU_CANCEL THEN
            CALLPROC DDB_ROLLBACK;
            message 'Error performing work status jobaction.';

            Moves[i].RSComplete = NULL;
            Moves[i].GroundOn = OldJob.GroundOn;
            Moves[i].Response = OldJob.Response;
            
            RetCode = SimpleJob.InCompleteMove(Job = Moves[i]);
       
            IF RetCode = PU_CANCEL THEN
               Message 'Please update move manually';
            ENDIF;

            RESUME NEXT;
         ENDIF;
      ENDIF;
/*
** IF a returned FCR Permit, now tell the incoming message monitor to delete the message.
** This, hopefully, reduce the chance that DO would shutdown the applications before
** this process is complete and leave the incoming message in the monitor.
*/
      IF ReturnPermit = TRUE THEN 
         ControlText = UserName + ';' + VARCHAR(Moves[1].Job) + ';';
         CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_PermitComplete', 
                                     DBEventText = ControlText); 
         CALLPROC DDB_COMMIT; 
      ENDIF; 
   ENDIF;
/*
**  Remove any pending statuses
*/
   Moves[i].ClearPendingActions();

/*
**  If this move has a workstatus of incomplete, call the incomplete status frame.
*/  
   CPMPermit = 0;
   IF Moves[i].WorkStatus = 'Tabled' THEN
  
      RetCode  = CALLFRAME IncompleteStatus (J = Moves[i],
                                  SuspendedOrder = OpOrder,
                                  OFSPhaseCheckIndicator = OFSPhaseCheckIndicator,
                                  KeepPermitID = TRUE,
                                  InhibitScreen = TRUE);

   ELSEIF Moves[i].WorkStatus = 'Incomplete'  OR
      Moves[i].WorkStatus = 'Test Incomplete' THEN

      IF CurrentApplication <>  Application$DSO AND
         ((Moves[i].WorkStatusInt <> Prompt$FromWorkFCR AND    /* Not FCR permit */  
          ReturnPermit = FALSE) OR (ReturnPermit = TRUE AND OpOrder <> 0)) THEN
         RetCode = CALLFRAME IncompleteStatus (J = Moves[i],
                                            OFSPhaseCheckIndicator = OFSPhaseCheckIndicator,
                                            Application = CurrentApplication,
                                            CPMNote = BYREF(CPMPermit),
                                            CanReturnToService = BYREF(CanReturnToService));
      ENDIF;
/*
** Log Display of Return to Service parameter.
*/
      IF CanReturnToService <> '' THEN
         IF CanReturnToService = 'YES' THEN
            WarningText = 'Equipment CAN be returned to service';
         ELSE
            WarningText = 'Equipment CANNOT be returned to service';
         ENDIF;
         CALLPROC SOA_LogIns 
			(Card = Moves[i].Card,
                         Job = Moves[i].Job,
                         Item = 'WP Incomplete',
                         Old = 'Substation Operator indicates',
                         New = WarningText,
                         Time = Date('now'),
                         UserName = UserName);
         CALLPROC DDB_COMMIT;
         WarningText = '';
     ENDIF;
/*
**  Otherwise, if it has a workstatus of Test Complete then call the test complete
**  status frame
*/
   ELSEIF Moves[i].WorkStatus = 'Test Complete' THEN

      CALLFRAME TestCompleteStatus (J = Moves[i]);
      TempResponse = Moves[i].Response;

   ELSEIF Moves[i].WorkStatus = 'All work done' THEN

      IF CurrentApplication <>  Application$DSO AND
         ((Moves[i].WorkStatusInt <> Prompt$FromWorkFCR AND ReturnPermit = FALSE) OR    /* verbally issued non-FCR permit */  
         (ReturnPermit = TRUE AND OpOrder <> 0)) THEN

         RetCode = CALLFRAME CompleteStatus(J = Moves[i],
                                            OFSPhaseCheckIndicator = OFSPhaseCheckIndicator,
                                            Application = CurrentApplication,
                                            ReturnPermit = ReturnPermit,
                                            CPMNote = BYREF(CPMPermit),
                                            CanReturnToService = BYREF(CanReturnToService));
         /*
         ** Log Display of Return to Service parameter.
         */
         IF CanReturnToService <> '' THEN
            IF CanReturnToService = 'YES' THEN
               WarningText = 'Equipment CAN be returned to service';
            ELSE
               WarningText = 'Equipment CANNOT be returned to service';
            ENDIF;
            CALLPROC SOA_LogIns 
			(Card = Moves[i].Card,
                         Job = Moves[i].Job,
                         Item = 'WP Complete',
                         Old = 'Substation Operator indicates',
                         New = WarningText,
                         Time = Date('now'),
                         UserName = UserName);
            CALLPROC DDB_COMMIT;
            WarningText = '';
         ENDIF;
      ENDIF;
   ENDIF;
/*
**  Loop through the moves and update the fields for all occurrences of this job.
*/
   m = 1;
   WHILE m <= Moves.LastRow() DO
      IF Moves[i].Job = Moves[m].Job THEN
         Moves[i].RSComplete = Complete;
         Moves[i].Response = TempResponse;    
      ENDIF;
      m = m + 1;
   ENDWHILE;        
/*
** Update Response
*/   
   IF CPMPermit > 0 THEN
      TempResponse = TempResponse + ' - SeeChecklist';
   ENDIF;
   Moves[i].Response = TempResponse;
   Moves[i].ResponseUpd();

   FIELD(Moves[i].InComplete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].InComplete_Btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Complete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
/*
** If manually handling ISWP, update its status
*/
   IF InservicePermit <> 0 THEN
      IF ISWPObject IS NULL THEN
         ISWPObject = InServicePermitClass.Create();
      ENDIF;
      ISWPObject.ISPermit = InServicePermit;

      IF Moves[i].WorkStatus = 'All work done' THEN
         ISWPObject.CompletePermit(
                 PermitStatus = ISPStatus$Complete, 
                 StatusUpdateBy = DOp.Object,
                 StatusReason = 'Manually returned');
      ELSE
         ISWPObject.CompletePermit(
                 PermitStatus = ISPStatus$Incomplete, 
                 StatusUpdateBy = DOp.Object,
                 StatusReason = 'Manually returned');
      ENDIF;
      
      IF WorkGroup = 'PST' THEN
         /* Exclude ISWP created for impacted equipment 
         */
         ImpactEquipPermit = 0;
         SELECT :ImpactEquipPermit = PhaseCheckIndicator
         FROM   SOA_WorkPermit
         WHERE  PermitJobID = :Moves[i].Job;
         
         IF ImpactEquipPermit = 0 THEN
            CALLFRAME PromptDefectiveRelay(JIP = Moves[i]);
         ENDIF;
      ENDIF;
   ENDIF;
/*
** if the last permit in an SWP, update the actual return date
*/
   IF Moves[i].TOOperator <> Operator$FCR AND 
      Moves[i].WorkStatus = 'All work done' THEN
      // No an FCR permit
      IF SingleSWP IS NULL THEN
         SingleSWP = OutageReport.Create();
      ENDIF;
      SingleSWP.SetActualReturnDate(JIP = Moves[i]); 
   ENDIF;
/*
**  Get CardClass information for SOA_Activity insert.
*/
   IF CardClass = 0 THEN
      IF Moves[i].SwitchingItem IS NULL OR
         Moves[i].SwitchingItem = 0 THEN
         REPEATED
         SELECT :CardClass = CardClass
         FROM    SOA_Card
         WHERE   Card = :Moves[i].Card;
      ELSE
         REPEATED
         SELECT :CardClass = CardClass
         FROM    SLC_InformationItem
         WHERE   Job = :Moves[i].SwitchingItem;
      ENDIF;
   ENDIF;
/*
**  Find Division for job.
*/
   Division = 0;
   IF Moves[i].Substation <> 0 THEN
      REPEATED
      SELECT :Division = G.Grouping 
      FROM   Udb_Grouping G
      WHERE  G.Member = :Moves[i].Substation AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Division;

   ELSEIF CurrentApplication = Application$FMS THEN
      REPEATED
      SELECT :Division = GG.Grouping 
      FROM   Udb_Grouping G,
             Udb_Grouping GG
      WHERE  G.Member = :CardDetails.Object[1].Object AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = :Type$Substation AND
             G.Grouping = GG.Member AND
             GG.Relationship = :Interaction$MemberOf AND
             GG.GroupingType = :Type$Division;

      IF Division = 0 THEN
         SELECT :Division = G.Grouping
         FROM   Udb_Grouping G
         WHERE  G.Member = :CardDetails.Object[1].Object AND
                G.Relationship = :Interaction$MemberOf AND
                G.GroupingType = :Type$Division;
      ENDIF;

   ELSEIF CurrentApplication <> Application$SDS AND
          Moves[i].Equip <> 0 AND Moves[i].EquipClass <> Type$ACLineSegment THEN
      Message 'Warning::(CompletePermits) Equipment ' + Moves[i].EquipClassName + 
              ' ' + Moves[i].Equipname + ' does not appear to ' +
              'be set up correctly in the database.  Please notify ' +
              'technical support of this problem.';
      CurFrame.Trace (Text = VARCHAR(DATE('now')) + 'Warning::(CompletePermits) ' +
              'Equipment ' + Moves[i].EquipClassName + ' ' + 
              Moves[i].Equipname + 
              ' does not appear to be set up correctly in the database.');
   ENDIF;

   IF CardClass <> Type$CardClassTest AND Division <> 0 THEN   
      IF Uppercase(dow(date('now'))) = 'SAT' OR 
         Uppercase(dow(date('now'))) = 'SUN' THEN
         TypeOfDay = 1;
      ELSE
         TypeOfDay = 2;
      ENDIF;

      IF date_part('hour',date('now')) < 8 THEN
         ShiftTime = 1;
      ELSEIF date_part('hour',date('now')) >= 8 AND
             date_part('hour',date('now')) < 16 THEN
         ShiftTime = 2;
      ELSE
         ShiftTime = 3;
      ENDIF;
          
      CALLPROC SOA_ActivityIns(
                   Application = CurrentApplication,
                   Division = Division,
                   LogDate = DATE('now'),
                   Operator = DOp.Object,
                   OperatorName = DOp.Description,
                   ShiftTime = ShiftTime,
                   TypeOfDay = TypeOfDay,
                   IssueComplete = 2,
                   ShiftID = DOp.ShiftID);
      CALLPROC DDB_COMMIT;

   ENDIF;
/*
**  Validate IssueComplete for OTW moves since, FGO
**  forward completes additional OTW moves.
*/
   IF Moves[i].WorkStatus = 'Field grds only' THEN       

      m = 1;
      WHILE m <= Moves.LastRow() DO
         IF Moves[m].JobClass = Moves[i].JobClass AND
            Moves[m].Equip = Moves[i].Equip AND
            Moves[m].RSComplete IS NULL  AND  i <> m THEN
            REPEATED
            SELECT :Moves[m].RSComplete = J.RSComplete,
                   :Moves[m].Response = J.Response
            FROM   SOA_Job J 
            WHERE  J.Job = :Moves[m].Job;

            Moves[m].WorkStatus = Moves[i].WorkStatus;

            FIELD(Moves[m].InComplete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
            FIELD(Moves[m].InComplete_Btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
            FIELD(Moves[m].Complete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
         ENDIF;
         m = m + 1;
      ENDWHILE;
   ENDIF;
/*
** If we have force completed an FCR permit, update the work location status.
** Check for Equip to pickup or drop.
*/   
   IF Moves[i].TOOperator = Operator$FCR AND ReturnPermit = FALSE THEN
      RetCode = CALLPROC IR_WorkPermitAck (
                  WorkPermit = Moves[i].Job,
                  WPLocation = 0,
                  LocationStatus = 'FORCERETURN');
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Warning: Permit Force Complete, however, unable to set Work ' +
                 'Location statuses.';
      ENDIF;
      CALLPROC DDB_COMMIT;
      /*
      **  See if there was equipment that might have been dropped or picked up.
      */
      EquipReturned = 0;
      SELECT :EquipReturned = COUNT(*)
      FROM   IR_DownloadEquip
      WHERE  WorkPermit = :Moves[i].Job;

      IF EquipReturned <> 0 THEN
         CALLFRAME FCR_ReturnOptions(
                     C = CardDetails,
                     ControlPermit = Moves[1].Job, 
                     ControlMsg = 0,
                     ForceComplete = TRUE,
                     LocalDivisions = LocalDivisions);
      ENDIF;
   ENDIF;

   IF CurrentApplication = Application$FMS AND FMSPermitOrder = FALSE THEN
      /*
      ** IF FCR Permit, update permit status and send acknowledgement to interface.
      */
      IF ReturnPermit = TRUE THEN 
         RetCode = IR_WorkPermitStatusUpd (WorkPermit = Moves[1].Job,
                                           PermitStatus = Permit$ReturnConfirmed);

         IF RetCode <> 0 THEN
            CALLPROC DDB_COMMIT;
            MESSAGE 'Error updating FCR Permit Status (Job=' + 
                     VARCHAR(Moves[1].Job) + ').  Restore Complete ' +
                    'will remain dimmed incorrectly until the status is ' +
                    'fixed.  Contact tech support to update the PermitStatus ' +
                    'to 60 for the above Job ID.';
         ENDIF;
         CALLPROC DDB_COMMIT;
         /*
         **  See if any locations have a status of TRANSFER TO ISO or 
         **  TRANSFER TO LIVE.
         */
         i = 0;
         REPEATED
         SELECT :i = COUNT(*)
         FROM    IR_WorkLocation
         WHERE   WorkPermit = :Moves[1].Job AND
                (LocationStatus = 'XFER TO ISO' OR
                 LocationStatus = 'XFER TO LIVE');

         If i <> 0 THEN
            CALLFRAME FCR_ReturnOptions(
                           C = CardDetails,
                           ControlPermit = Moves[1].Job, 
                           ControlMsg = 0,
                           LocalDivisions = LocalDivisions);
         ELSE
         /*
         **  See if equipment has been dropped or picked up.
         */
            EquipReturned = 0;
            SELECT :EquipReturned = 1
            FROM   IR_DownloadEquip
            WHERE  WorkPermit = :Moves[1].Job AND
                   ReturnPermit = :Moves[1].Job;
            CALLPROC DDB_ROLLBACK;

            IF EquipReturned = 1 THEN
               CALLFRAME FCR_ReturnOptions(
                           C = CardDetails,
                           ControlPermit = Moves[1].Job, 
                           ControlMsg = 0,
                           LocalDivisions = LocalDivisions);
            ENDIF;
         ENDIF;


         ControlText = VARCHAR(Moves[1].Job) + ';' + VARCHAR(DATE('now')) + ';' +
                       DOp.Description + ';';
         CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_AckPermitReturn',
                     EventText = ControlText);  
         /*
         ** Exit if processing a single permit return.
         */
         RETURN PU_OK;      
      ENDIF;

   ELSEIF CurrentApplication = Application$SLC OR
          CurrentApplication = Application$TFMS OR
          CurrentApplication = Application$DSO OR
          FMSPermitOrder = TRUE THEN

      IF ReturnPermit = TRUE THEN
      
         IF CurrentApplication = Application$DSO THEN
            RetCode = CALLPROC IR_DSOOrderStatusUpd
                      (OrderNumber = OpOrder,
                       OrderStatus = Order$ConfirmClosed);         
         ELSE
            RetCode = CALLPROC IR_OrderStatusUpd
                      (OrderNumber = OpOrder,
                       OrderStatus = Order$ConfirmClosed);
         ENDIF;
         
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                    ': WARNING - Order Status for this permit ' + 
                    'not updated to: ' + varchar(Status) + 
                    ' for order: ' + varchar(oporder));
            Message 'Unable to update Operating Order status. ' + 
                    'Please report problem to ' +
                    'technical support.' + HC_NEWLINE + 'Order Status ' + 
                    'not updated to: ' + varchar(Status) + 
                    ' for order: ' + varchar(oporder);
         ENDIF;
         CALLPROC DDB_COMMIT; 

         ControlText = VARCHAR(OpOrder) + ';';
         ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
         ControlText = ControlText + DOp.Description + ';'; 
         CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_AckOpOrderReturn', 
                     EventText = ControlText);  
         RETURN PU_OK;  
      ENDIF;
   ENDIF;
/*
**  Once they have completed a move, they can no longer change the operator.
*/
   StackField(Field(Selected).ParentField.ParentField).CurBias = FB_VISIBLE;
END;


ON ChildEntry Moves[*].InComplete_Btn =
DECLARE
   WithdrawReason = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   i = FIELD(Moves).CurRow;
/*
**  Make sure they can incomplete the job.
*/
   IF (FIELD(Moves[i].InComplete_Btn).BGColor <> CC_PALE_CYAN) THEN
      RESUME;
   ENDIF;

/*
**  Check the moverules to see if this is a two-sided move.  
**  (It should be since only two-sided moves should get to this frame,
**   but it doesn't hurt to check!!) If it is, then make the tors be Takeout.
*/
   IF (Moves[i].RSMoveRules <> MoveRule$Complete) THEN
      Message 'Error incompleting move.  See technical support.';
      RESUME;
   ENDIF;
/*
** if the permit was issued to SSO using the TOMS-SSO interface. The DO 
** will have to use Rescind Request or Force Rescind to manually complete
** or incomplete the permit.
*/ 

# include CheckForSSOPermit

/*
** Check for Issued ISWP
*/
   InServicePermit = 0;
   ISPStatus = 0;
   SELECT :InServicePermit = ISPermit,
          :ISPStatus = Status
   FROM   SOA_InServicePermit
   WHERE  Job = :Moves[i].Job AND
          Status IN (:ISPStatus$Issued, :ISPStatus$WithdrawRequest);
/*
** If the Permit was issued to the FCR it was downloaded using the FCR
** interface.  The DO will have to Override the warning if they want to 
** continue because things may get screwed up if the DO completes an FCR
** permit and then the FCR returns it through the Interface.
*/
   IF Moves[i].TOOperator = Operator$FCR AND
      PermitRejected = FALSE THEN
/*
** Get PermitStatus now - if a Withdraw Request we won't have it.
*/
      PermitStatus = 0;
      MsgKey = 0;
      SELECT  :PermitStatus = PermitStatus,
              :MsgKey = MsgKey
      FROM    IR_WorkPermit
      WHERE   WorkPermit = :Moves[i].Job;

      IF PermitStatus = Permit$Issued THEN
         IF CurFrame.ConfirmPopup (MessageText = 'Are you sure you want to withdraw this permit?')
            = PU_CANCEL THEN
            RESUME;
         ENDIF;

      ELSEIF PermitStatus = Permit$Downloaded THEN   
         RetCode = CALLFRAME SelectRescindType (RRType = 'FCR');
         IF RetCode = 0 THEN
            RESUME;
         ELSEIF RetCode = 1 THEN

            IF DOp.Description = '' THEN
               DOp.Description = UserName;
            ENDIF;

            ControlText = VARCHAR(CardDetails.Card) + ';' +
                          VARCHAR(Moves[i].Job) + ';' + 
                          VARCHAR(RevisionNumber) + ';' +
                          DOp.Description + ';';
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_WithdrawPermitRequest',
                     EventText = ControlText);  
            MESSAGE 'Watch your Incoming Messages for Permit Withdrawal ' +
                    'Approval.';
            RETURN PU_CANCEL;
         ELSE
         IF CurFrame.ConfirmPopUp (MessageText = 
                       'The Permit was sent to the FCR via Rapid Restore. ' +
                       'Have you informed the FCR that you are force withdrawing the Permit?') = PU_CANCEL THEN
            RESUME;
         ENDIF;  
         ENDIF;
      ELSE
         IF CurFrame.ConfirmPopUp (MessageText = 
                       'The Permit has been acknowledged by FCR via Rapid Restore. ' +
                       'Have you informed the FCR that you are force withdrawing the Permit?') = PU_CANCEL THEN
            RESUME;
         ENDIF;  
      ENDIF;
/*
**  If we found a msgkey, clear outgoing flag.
*/   
      IF MsgKey <> 0 THEN
         RetCode = CALLPROC MSG_UpdateMsg (Card = CardDetails.Card,
                                  Ack = Ack$Delete,
                                  MsgKey = MsgKey,
                                  AckByOpName = DOp.Description,
                                  AckDate = 'now',
                                  DelByOpName = DOp.Description,
                                  DelDate = date('now'),
                                  Substation = CardDetails.Object[1].Object
                                  ); 
         CALLPROC DDB_COMMIT;
      ENDIF;
/*
** The only way to be right here in the code is a Force Withdrawal.
** We set flags appropriately so that other actions may take place.
*/
      PermitRejected = TRUE;
      AssumeWithdraw = TRUE;
   ENDIF;
/*
**  Set status attribute for JobInProgress methods 
*/
   Moves[i].Status = Job$Takeout;
/*
**  Reverse any JobActions that may have taken place at issue time.
*/
   RetCode = Moves[i].UndoJobActions(IssueCompl = JobClass$Issue);
     
   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;

/*
**  Remove any pending statuses
*/
   Moves[i].ClearPendingActions();

/*
**  Clear issued move.
*/
   RetCode = SimpleJob.CancelIssueMove(Job = Moves[i]);

   IF RetCode = PU_CANCEL THEN
      Message 'Please update move manually';
      RESUME;
   ENDIF;
/*
** If manually handling ISWP, update its status. The new status is depending on \
** whether a withdraw was requested or not
*/
   IF InServicePermit <> 0 THEN
      ISWPObject = NULL;
      ISWPObject = InServicePermitClass.Create();
      ISWPObject.ISPermit = InServicePermit;
      ISWPObject.Status = ISPStatus;
      ISWPObject.Job = Moves[i].Job;

      IF ISPStatus = ISPStatus$Issued THEN
         IF OrderStatus = Order$Rejected THEN
            WithdrawReason = 'REJECTED';
         ELSEIF OrderStatus = Order$Rescinded THEN 
            WithdrawReason = 'RESCINDED';
         ELSEIF ForceRescinded = TRUE THEN
            WithdrawReason = 'FORCE RESCIND';
         ELSE 
            WithdrawReason = 'VERBAL WITHDRAW';
         ENDIF;

         ISWPObject.WithdrawIssuedISP(NewISPStatus = ISPStatus$Incomplete,
                                      WithdrawnBy = DOp.Object,
                                      WithdrawReason = WithdrawReason,
                                      JobResponse = WithdrawReason);

      ELSEIF ISPStatus = ISPStatus$WithdrawRequest THEN
         ISWPObject.WithdrawIssuedISP(NewISPStatus = ISPStatus$Withdrawn,
                                      WithdrawnBy = DOp.Object,
                                      WithdrawReason = 'Manually Withdrawn',
                                      JobResponse = 'PULLED');
      ENDIF;

      IF ISWPObject.ReturnCode <> 0 THEN
         MESSAGE ISWPObject.ErrorMessage;
      ENDIF;
   ENDIF;

   IF CurrentApplication = Application$FMS AND FMSPermitOrder = FALSE THEN
   /*
   ** If FCR Permit, update Permit Status and send acknowledgement to interface
   ** unless it is a withdrawal.
   */
      IF PermitRejected = TRUE THEN
         RetCode = IR_WorkPermitStatusUpd (WorkPermit = Moves[1].Job,
                                           PermitStatus = Permit$Initialized);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'Error updating FCR Permit Status (Job=' + 
                     VARCHAR(Moves[1].Job) + ').  TakeOut Issue ' +
                    'will remain dimmed incorrectly until the status is ' +
                    'fixed.  Contact tech support to update the PermitStatus ' +
                    'to 0 for the above Job ID.';
         ENDIF;
         CALLPROC DDB_COMMIT;

         /*
         ** log the rejection comment in the transaction log because the comment
         ** field can be overridden. 
         */
         FCRName = '';
         SELECT :FCRName = AcknowledgedByFCR 
         FROM   FMS_WorkPermit
         WHERE  PermitJobID = :Moves[1].Job;

         CALLPROC SOA_LogIns 
			(Card = Moves[1].Card,
                         Job = Moves[1].Job,
                         Item = 'Rejected',
                         Old = 'By ' + FCRName,
                         New = wpstack.ReturnComment,
                         Time = Date('now'),
                         UserName = UserName);
         CALLPROC DDB_COMMIT;
 
  /*
   ** Don't raise ack dbevent if this is confirmation of an approved DO 
   ** Withdraw Request.
   */     
         IF AssumeWithdraw = FALSE THEN     
   /*
   ** Deduct one from Revision Number since revision number was automatically
   ** increased when the Permit was rejected to allow the DO to immediately be
   ** able to re-issue the rejected permit if he so desired.  Needed a new
   ** rev number to avoid duplicate key errors.
   */ 
            CALLPROC DDB_COMMIT;
            ControlText = VARCHAR(Moves[1].Job) + ';' + 
                       VARCHAR(RevisionNumber - 1) + ';' +
                       VARCHAR(DATE('now')) + ';' +
                       DOp.Description + ';';
            CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_AckPermitReject', 
                     EventText = ControlText);  
         ELSE
   /*
   ** Won't have Revision Number on a Force Withdrawal, get it here.
   */
            SELECT :RevisionNumber = RevisionNumber
            FROM   IR_WorkPermit
            WHERE  WorkPermit = :Moves[1].Job;
   /* 
   ** On a Withdrawal Request Confirmation or a Force Withdrawal, we update the
   ** Revision Number and the Work Location Status so that the permit can be
   ** cleanely downloaded on a subsequent Issuance. This code similar to what
   ** happens in a Work Permit Rejection in the Receive App Server.  That code
   ** could be eliminated and this code could be adjusted to handle both.
   */      
            RetCode = CALLPROC IR_WorkPermitAck (
                        WorkPermit = Moves[1].Job,
                        WPLocation = 0,
                        LocationStatus = 'Tag Needed');
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Warning: Permit Withdrawn, however, unable to set Work ' +
                       'Location statuses back to "Tag Needed".';
            ENDIF;

            RetCode = CALLPROC IR_WPRevisionUpd (
                        WorkPermit = Moves[1].Job,
                        RevisionNumber = RevisionNumber + 1, 
                        RevisionDate = '',
                        RevisionComment = 'DO is reissuing a previously ' +
                                          'withdrawn permit.');
            IF RetCode <> 0 THEN
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'Warning: Permit Withdrawn, however, unable to update ' +
                       'permit revision number.';
            ENDIF;
            CALLPROC DDB_COMMIT;                      
         ENDIF;

         /*
         ** delete downloaded equipment
         */
         RetCode = IR_DownloadEquipDel (WorkPermit = Moves[1].Job);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                    ': Failed to delete from ir_downloadequip for wp ' + varchar(Moves[1].Job));
         ENDIF;
         CALLPROC DDB_COMMIT;

   /*
   ** Message back to Incoming Messages
   */
         ControlText = UserName + ';' + VARCHAR(Moves[1].Job) + ';';
         CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_PermitComplete', 
                                     DBEventText = ControlText); 
         CALLPROC DDB_COMMIT;   
   /*
   ** Exit if processing a single permit return.
   */
         RETURN PU_OK;  
      ENDIF;

   ELSEIF CurrentApplication = Application$SLC OR
          CurrentApplication = Application$TFMS OR 
          CurrentApplication = Application$DSO OR 
          FMSPermitOrder = TRUE THEN

      IF ReturnPermit = TRUE THEN
         IF OrderStatus = Order$Rejected THEN
            NewOrderStatus = Order$ConfirmRejected;
            
            CALLPROC SOA_LogIns 
			 (Card = Moves[1].Card,
                         Job = Moves[1].Job,
                         Item = 'Rejected',
                         Old = 'Permit Rejected',
                         New = '',
                         Time = Date('now'),
                         UserName = UserName);
            CALLPROC DDB_COMMIT;

         ELSEIF OrderStatus = Order$Rescinded THEN
            NewOrderStatus = Order$ConfirmRescinded;

            CALLPROC SOA_LogIns 
			 (Card = Moves[1].Card,
                         Job = Moves[1].Job,
                         Item = 'Rescinded',
                         Old = 'Permit Rescinded',
                         New = '',
                         Time = Date('now'),
                         UserName = UserName);
            CALLPROC DDB_COMMIT;

         ELSEIF OrderStatus = Order$Closed THEN
            NewOrderStatus = Order$ConfirmClosed;
         ENDIF;

         IF CurrentApplication = Application$DSO THEN      
            RetCode = CALLPROC IR_DSOOrderStatusUpd
                      (OrderNumber = OpOrder,
                       OrderStatus = IFNULL(NewOrderStatus,0));
         ELSE
            RetCode = CALLPROC IR_OrderStatusUpd
                      (OrderNumber = OpOrder,
                       OrderStatus = IFNULL(NewOrderStatus,0));
         ENDIF;

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurFrame.Trace (Text = VARCHAR(DATE('now')) + 
                    ': WARNING - Order Status for this permit ' + 
                    'not updated to: ' + varchar(Status) + 
                    ' for order: ' + varchar(oporder));
            Message 'Unable to update Operating Order status. ' + 
                    'Please report problem to ' +
                    'technical support.' + HC_NEWLINE + 'Order Status ' + 
                    'not updated to: ' + varchar(Status) + 
                    ' for order: ' + varchar(oporder);
         ENDIF;
         CALLPROC DDB_COMMIT; 

         IF OrderStatus = Order$Closed OR OrderStatus = Order$Rejected THEN
            ControlText = VARCHAR(OpOrder) + ';';
            ControlText = ControlText + VARCHAR(DATE('now')) + ';'; 
            ControlText = ControlText + DOp.Description + ';'; 

            IF OrderStatus = Order$Closed THEN
               CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_AckOpOrderReturn',
                     EventText = ControlText);  
            ELSEIF OrderStatus = Order$Rejected THEN
               CALLPROC InsertDBEventQueue(
                     ToApp = 'SOO',
                     EventName = 'IR_AckOpOrderRejection',
                     EventText = ControlText);  
            ENDIF;
            CALLPROC DDB_COMMIT;
         ENDIF;
         RETURN PU_OK;
      ENDIF;
   ENDIF;
/*
**  Loop through the moves and update the fields for all occurrences of this job.
*/
   m = 1;
   WHILE m <= Moves.LastRow() DO
      IF Moves[i].Job = Moves[m].Job THEN
         Moves[i].TOIssued = NULL;
         Moves[i].TOOperator = NULL;
      ENDIF;
      m = m + 1;
   ENDWHILE;        
    
   FIELD(Moves[i].InComplete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Complete_Btn).FgCOLOR = field(Moves[*].ToIssued).BgColor;
   FIELD(Moves[i].Complete_Btn).BgCOLOR = field(Moves[*].ToIssued).BgColor;
END;


ON ChildEntry Moves[*].Reject_Btn =
BEGIN
/*
** Support rejection of FCR Permit
*/
   IF (Curframe.ReasonCode <> RC_MOUSECLICK) THEN
      RESUME;
   ENDIF;

   i = FIELD(Moves).CurRow;
/*
**  Check the moverules to see if this is a two-sided move.  
**  (It should be since only two-sided moves should get to this frame,
**   but it doesn't hurt to check!!) If it is, then make the tors be Takeout.
*/
   IF (Moves[i].RSMoveRules <> MoveRule$Complete) THEN
      Message 'Error incompleting move.  See technical support.';
      RESUME;
   ENDIF; 
/*
** All rejection processing is encapsulated in RejectPermit frame.
*/
   RetCode = CALLFRAME RejectPermit(
               Card = Moves[i].Card,
               WorkPermit = Moves[i].Job);

   IF RetCode = PU_CANCEL THEN
      RESUME;
   ENDIF;
/*
** Message back to Incoming Messages
*/
   ControlText = UserName + ';' + VARCHAR(Moves[1].Job) + ';';
   CALLPROC DDB_RaiseDBEvent ( DBEventName = 'IR_PermitComplete', 
                               DBEventText = ControlText); 
   CALLPROC DDB_COMMIT;   
/*
** Exit if processing a single permit return.
*/
   RETURN PU_OK;  
END;


ON CLICK Menu.File.Completion_Papers =
BEGIN
    IF CurrentApplication = Application$DSO THEN
       MESSAGE 'Completion Papers not applicable to Dielectric System';
       RESUME;
    ENDIF;
    
    CALLFRAME CompletionPapers (
                   WorkPermit = Moves[1].Job,
                   FCR = Selected.Description);
END;


ON Click Exit_Btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
**  Don't allow exit if RR Returned Permit has not been processed.
*/
   IF ReturnPermit = TRUE AND 
       FIELD(Moves[1].Complete_Btn).BGColor = CC_PALE_CYAN THEN
      MESSAGE 'You must confirm the permit returned from the Rapid Restore.  If ' +
              'another error has occurred and you are unable, then contact ' +
              'tech support.  To continue you will likely have to kill and ' +
              'restart FMS';
      RESUME;
   ENDIF;
/*
**  Don't allow exit if FCR Rejected Permit has not been processed.
*/
   IF PermitRejected = TRUE AND 
         FIELD(Moves[1].InComplete_Btn).BGColor = CC_PALE_CYAN THEN
      MESSAGE 'You must withdraw the permit rejected by the FCR.  If ' +
              'another error has occurred and you are unable, then contact ' +
              'tech support.  To continue you will likely have to kill and ' +
              'restart FMS';
      RESUME;
   ENDIF;

   DOp.CheckActivity(Move = Moves[1].Duplicate());

   RETURN PU_OK;
END;


/*
**  Handle an operator selection by operator number
*/
ON SetValue Selected.Name =
BEGIN
/*
**	Pick out everyone on the list with a similar "ctrl number"
*/
   TempChar  = Trim(Lowercase(Selected.Name)) + '%';
   Selected.Description  = '';
   Selected.Object = -1;
   ReducedList.Clear();
   i = 1;
   Row = 0;
   WHILE i <= OperatorList.LastRow() DO
      IF Lowercase(OperatorList[i].Name) LIKE TempChar THEN   
         Row = Row + 1;
         ReducedList[Row] = OperatorList[i];
      ENDIF;                        
      i = i + 1;
   ENDWHILE;
/*
**  If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      SelectOperator = ReducedList;
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   IF (Row = 1) THEN
      Selected.Object  = SelectOperator[1].Object;
      Selected.Name = SelectOperator[1].Name;
      Selected.Description  = SelectOperator[1].Description;
   ENDIF;
END;

/*
**  Handle an operator selection from the list
*/
ON ChildEntry SelectOperator =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   Selected.Object = SelectOperator[].Object;
   Selected.Name = SelectOperator[].Name;
   Selected.Description = SelectOperator[].Description;
   
   FO.Object = Selected.Object;
   FO.Name = Selected.Name;
   FO.Description = Selected.Description;
END;
/*
**  Handle operator selection by partial name
*/
ON SetValue Selected.Description,
ON CLICK Find_Btn  =
BEGIN
/*
**  Pick out everyone on the list with a similar name
*/
   TempChar  = Trim(Lowercase(Selected.Description)) + '%';
   Selected.Name  = '';
   Selected.Object = -1;
   ReducedList.Clear();
   i = 1;
   Row = 0;
    
   WHILE i <= OperatorList.LastRow() DO
      IF (Lowercase(OperatorList[i].Description) 
            LIKE TempChar) THEN
         Row = Row + 1;
         ReducedList[Row] = OperatorList[i];
      ENDIF;
      i = i + 1;
   ENDWHILE;
/*
**	If there is something in the reduced list, show it
*/
   IF (Row > 0) THEN
      SelectOperator = ReducedList;
   ENDIF;
/*
**  If there is only one in the list, make it the default
*/
   IF (Row = 1) THEN
      Selected.Object = SelectOperator[1].Object;
      Selected.Name = SelectOperator[1].Name;
      Selected.Description  = SelectOperator[1].Description;
   ENDIF;
END;


ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'fms_card_control_taken' =
