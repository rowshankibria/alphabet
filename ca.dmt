METHOD LoadWorkingGroups(
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   PrevGroup    = VARCHAR(40) NOT NULL WITH DEFAULT;
   PrevMove     = VARCHAR(160) NOT NULL WITH DEFAULT;
   TempList     = ARRAY OF TypeClass;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Purpose of this method is to load the Rapid Restore
** Working groups by card type.
*/
   CurObject.CList.Clear();
   IF CurObject.Type = Type$TelCard THEN
      i = 1;
      SELECT DISTINCT
          :TempList[i].Type = T.Type, 
          :TempList[i].BaseType = J.JobClass, 
          :TempList[i].Name = SQUEEZE(T.Name), 
          :TempList[i].Description = SQUEEZE(J.TOMove)
      FROM IR_WorkingGroup G,
           UDB_Type T,
           FMS_JobClassControl JC,
           FMS_JobClass J
      WHERE G.WorkingGroup = T.Type and
            G.JobClass = JC.JobClass and
            JC.TypeOfCard = :CurObject.Type AND
            JC.StepPair = :StepHeading$TLS_ISWP AND
            JC.JobClass = J.JobClass
      ORDER BY 3,4
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
   ELSEIF CurObject.Type = Type$SLCCard THEN
      i = 1;
      SELECT DISTINCT
          :TempList[i].Type = T.Type, 
          :TempList[i].BaseType = J.JobClass, 
          :TempList[i].Name = SQUEEZE(T.Name), 
          :TempList[i].Description = SQUEEZE(J.TOMove)
      FROM IR_WorkingGroup G,
           UDB_Type T,
           FMS_JobClassControl JC,
           FMS_JobClass J
      WHERE G.WorkingGroup = T.Type and
            G.JobClass = JC.JobClass and
            JC.TypeOfCard = :CurObject.Type AND
            JC.JobClass = J.JobClass
      ORDER BY 3, 4
      BEGIN
         i = i + 1;
      END;
      CALLPROC DDB_ROLLBACK;
/*
** remove permits where the TakeOut move text contains 
** additional text after the "To xxx:".
*/
      i = TempList.LastRow;
      WHILE i >= 1 DO
         IF RIGHT(TempList[i].Description, 1) <> ':' THEN
            TempList.RemoveRow(RowNumber = i);
         ENDIF;
         i = i - 1;
      ENDWHILE;
   ENDIF;
/*
** Remove duplicate permits
*/
   PrevGroup = '';
   PrevMove = '';
   j = 1;
   FOR i = 1 TO TempList.LastRow DO
       IF PrevGroup <> TempList[i].Name OR
          PrevMove <> TempList[i].Description THEN
          CurObject.CList[j] = TempList[i].Duplicate();
          PrevGroup = TempList[i].Name;
          PrevMove = TempList[i].Description;
          j = j + 1;
       ENDIF;
   ENDFOR;

   IF j = 1 THEN
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'No working groups defined';
   ENDIF;   
   RETURN;
END;

METHOD LoadISWPGroupFilter(
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
   TempList     = ARRAY OF TypeClass;   
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** The ISWP Group filter list consists of 2 sub-lists:
** 1. working groups that are assigned to permits on SLC
** 2. sub-groups.
*/
   CurObject.Type = Type$SLCCard;
   CurObject.LoadWorkingGroups();

   /*
   ** now get the SSM, ECB, PST, TMG and Cap_Const. sub groups 
   */
   i = CurObject.CList.LastRow + 1;
   SELECT DISTINCT
          :CurObject.CList[i].Type = Type, 
          :CurObject.CList[i].BaseType = Object,
          :CurObject.CList[i].Name = SQUEEZE(Name), 
          :CurObject.CList[i].Description = SQUEEZE(Description)
   FROM  UDB_Object 
   WHERE Type IN (22615, 22619, 22642, 22648, 22901)
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   CurObject.CList.Sort(Name = AS_ASC);
END;

METHOD LoadSkillList(
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Purpose of this method is to load all skill list.
*/
   CurObject.CList.Clear();
   i = 1;
   REPEATED
   SELECT   :CurObject.CList[i].name    = name,
            :CurObject.CList[i].type    = type
   FROM     UDB_Type
   WHERE    Type IN (SELECT Type
                      FROM   Udb_ExtendedType E
                      WHERE  E.SuperType = :Type$Skill
                      AND    E.Type <> :Type$Skill)
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
END;

METHOD LoadCircuitTypes(
)=
DECLARE
   i            = INTEGER NOT NULL;     /*Counter*/
   j            = INTEGER NOT NULL;     /*Counter*/
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Purpose of this method is to load all skill list.
*/
   CurObject.CList.Clear();
   CurObject.CList[1].Type = Type$TelCircuit;
   CurObject.CList[1].Name = '';

   i = 2;
   SELECT  :CurObject.CList[i].Type = T.Type,
           :CurObject.CList[i].Name = T.Name
   FROM    Udb_Type T,
           Udb_ExtendedType E
   WHERE   T.Type = E.Type
     AND   E.SuperType = :Type$TelCircuit
     AND   E.Type <> :Type$TelCircuit
     AND   E.Type NOT IN (SELECT Type
                           FROM Udb_ExtendedType
                           WHERE SuperType = :Type$TCEquipment)
    ORDER BY Name
    BEGIN
       i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
END;

METHOD LoadCFGEquipTypes(
) = 
DECLARE
   i            = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   k            = INTEGER NOT NULL WITH DEFAULT;     /*Counter*/
   CFGEList     = ARRAY OF INTEGEROBJECT;
   RetCode      = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
   
   IF CurObject.MaxLevel > 1 THEN
      CurObject.GetTree();
   ELSE
      CurObject.GetChildren();
   ENDIF;
   
   i = 1;
   SELECT :CFGEList[i].Value = C.Type
   FROM   UDB_ExtendedType E,
          SOA_CFGEquipType C
   WHERE  E.SuperType = :CurObject.Type AND
          E.Type = C.Type
   ORDER BY 1 ASC
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
   
   FOR i=1 TO CurObject.CList.LastRow DO
      CurObject.DList[i] = CFGEquipTypeClass.Create();
      
      CurObject.DList[i].SuperType = CurObject.CList[i].SuperType;
      CurObject.DList[i].Type = CurObject.CList[i].Type;
      CurObject.DList[i].Name = CurObject.CList[i].Name;
      CurObject.DList[i].Description = CurObject.CList[i].Description;
      CurObject.DList[i].Level = CurObject.CList[i].Level;
      CurObject.DList[i].BaseType = CurObject.CList[i].BaseType;

      RetCode = CFGEList.Find(AttributeName = 'Value',
                              Value = CurObject.DList[i].Type,
                              RowNumber = ByRef(k));
      IF RetCode = ER_OK THEN                              
         CurObject.DList[i].Included = 1;
         CFGEList.RemoveRow(RowNumber = k);
      ENDIF;
   ENDFOR;
END;

