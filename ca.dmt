	Name:            TC_LogChange

/*
**
**      Copyright c 2003 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    Telephone
**  Proc            TC_LogChange
**
**  Date:       Author   Description
** ----------------------------------
**  01/07/03	ysp       Created
**  09/12/17    pkw       Set time in 4gl instead of dbproc
**
*/
PROCEDURE TC_LogChange
(
/* PARAMETER */
    Card = INTEGER;         
    Job = INTEGER;          
    Time = DATE NOT NULL WITH DEFAULT;          
    Item = CHAR(32);         
    Old = VARCHAR(80);         
    New = VARCHAR(80);      

/* local variables */
    RetCode = INTEGER NOT NULL WITH DEFAULT;
)=
BEGIN
     IF Time = '' THEN
        Time = Date('now');
     ENDIF;
     RetCode = CALLPROC TC_LogInsert(
             Card = Card
        ,    Job = Job
        ,    Time = Time
        ,    Item = Item
        ,    Old = Old
        ,    New = New
        ,    Operator = DOp.Object
        ,    OperatorName = DOp.Description
        );
     CALLPROC DDB_COMMIT;

     CALLPROC SOA_DOActivityUpd (
             Machine = UserMachine,
             LastUpdate = Date('now'));
     CALLPROC DDB_COMMIT;  

     RETURN(RetCode);
END;

