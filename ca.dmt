	Name:            OSWP_And_SWP_Obsolete

/*
**
**      Copyright c 2009 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permissio
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          OSWP_Summary
**
**  Date:       Version Description
** ----------------------------------
** 08/14/09  em   Initial Development 
** 08/31/09  em   Revised screen search and filter options.
** 09/02/09  em   Removed Card parameter
** 10/02/14  ysp  Add SWP summary
** 12/04/14  YSP  Right mouse click to bring up SWP detail screen 
*/ 
INITIALIZE
(
) =
DECLARE
#   include StandardDeclarations
   j = INTEGER NOT NULL;
   k = INTEGER NOT NULL;

   DivisionList = ChoiceList;         /* All divisions    */
   Division = INTEGER NOT NULL;     /* Substation Division */
   FindName = VARCHAR(40) NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL;     /* Order # */
   Temposwp = OSWPRequestClass;  /*for sort */

   CurrentRow = INTEGER NOT NULL WITH DEFAULT;

   OSWP_LastColumn = varchar(32) not null;
   OSWP_SortOrder = integer not null;
   OSWPLoadApp = CHAR(4) NOT NULL WITH DEFAULT;
   OSWPLoadCard = INTEGER NOT NULL WITH DEFAULT;

   SWP_LastColumn = varchar(32) not null;
   SWP_SortOrder = integer not null;

   LoadCard = PROCEDURE;
   LoadOSWPRequests = PROCEDURE;
   SetOSWPColors = PROCEDURE;
   LoadSWPReports = PROCEDURE;
   EnableSWPLoadCard = PROCEDURE;
BEGIN
   DivisionList.ChoiceItems.Clear();
   DivisionList.ChoiceItems[1].EnumValue = 1;
   DivisionList.ChoiceItems[1].EnumText = 'Local';
   DivisionList.ChoiceItems[2].EnumValue = 2;
   DivisionList.ChoiceItems[2].EnumText = 'All';

   i = 3;
   SELECT  :DivisionList.ChoiceItems[i].EnumText = Name,
           :DivisionList.ChoiceItems[i].EnumValue = Object 
   FROM    Udb_Object  
   WHERE   Type = :Type$Division and
           PrimaryGrouping <> 0  
   ORDER BY 1
   BEGIN
       i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   field(menu.division_list.division).ValueList = CHOICELIST(DivisionList);
   field(menu.division_list.division).UpdChoiceList();
   field(menu.division_list.division).CurEnumValue = 1;
   field(menu.division_list.division).CurEnumText = 'Local';
   field(menu.division_list.division).UpdChoiceList();  

   FIELD(WP_Tab).CurPageIndex = 1;
   
   IF FIELD(WP_Tab).CurPageIndex = 1 THEN
      CALLPROC LoadSWPReports();
   ELSE
      CALLPROC LoadOSWPRequests();
   ENDIF;
END;

ON PageChanged WP_Tab =
BEGIN
   IF FIELD(WP_Tab).TargetPageIndex = 1 THEN      // TargetPageIndex
      IF wp_tab.swp.swp_tf.LastRow = 0 THEN
         CALLPROC LoadSWPReports();
      ENDIF;
   ELSE
      IF wp_tab.oswp.oswp_tf.LastRow = 0 THEN
         CALLPROC LoadOSWPRequests();
      ENDIF;
   ENDIF;
END;

ON SETVALUE menu.division_list.division =
BEGIN
   IF FIELD(WP_Tab).CurPageIndex = 1 THEN
      CALLPROC LoadSWPReports();
      IF wp_tab.swp.swp_tf.LastRow() = 0 THEN
         MESSAGE 'No Scheduling Work Packages.';
      ENDIF;
   ELSE
      CALLPROC LoadOSWPRequests();
   ENDIF;
END;

/* ----------------------------------------------------------------------------
** related to OSWP requests
** ----------------------------------------------------------------------------
*/        
ON CHILDENTRY wp_tab.oswp.oswp_tf =
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   CurrentRow = 0;
   CurrentRow = FIELD(wp_tab.oswp.oswp_tf).CurRow;

   RetCode = CALLFRAME OSWPRequest (OSWPRequest = wp_tab.oswp.oswp_tf[CurrentRow].PermitJobID);

   OSWPLoadCard = 0;
   OSWPLoadApp = '';
   REPEATED
   SELECT :OSWPLoadCard = JC.Card,
          :OSWPLoadApp = C.Application
   FROM   SOA_JobControl JC,
          SOA_Card C
   WHERE  JC.Job = :wp_tab.oswp.oswp_tf[CurrentRow].PermitJobID AND
          JC.Card = C.Card;

   IF OSWPLoadCard <> 0 THEN
      FIELD(wp_tab.oswp.LoadCard_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(wp_tab.oswp.LoadCard_Btn).CurBias = FB_INVISIBLE;
   ENDIF;

   /* refresh only when request was changed
   */
   IF RetCode = PU_OK THEN
      CALLPROC LoadOSWPRequests();
   ENDIF;
END;

ON CLICK wp_tab.oswp.LoadCard_Btn =
BEGIN
   IF OSWPLoadCard = 0 THEN
      MESSAGE 'Request is not linked to a Work Permit on a Card.';
      RESUME;
   ENDIF;

   CALLPROC LoadCard(LoadApp = OSWPLoadApp,
                     LoadCard = OSWPLoadCard);
   RETURN;
END;

ON CLICK wp_tab.oswp.find_btn =
BEGIN
   IF wp_tab.oswp.search_field = '' THEN
      MESSAGE 'Please enter number to search for.';
   ENDIF;

   IF wp_tab.oswp.search_for = 0 THEN
      MESSAGE 'Please select type of number to search for.';
   ENDIF;
  
   CALLPROC LoadOSWPRequests();   
END;

ON CLICK wp_tab.oswp.Reload =
BEGIN
   wp_tab.oswp.search_for = 0;
   wp_tab.oswp.search_field = '';
   CALLPROC LoadOSWPRequests();
END;

/* ----------------------------------------------------------------------------
** related to SWP
** ----------------------------------------------------------------------------
*/
ON CLICK WP_Tab.OSWP.OSWP_TF.WorkGroupName_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.SubstationName_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.EquipName_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.CurrentStatus_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.SSO_Status_Name_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.Title_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.PreIssue_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.EnterByName_hdr,
ON CLICK WP_Tab.OSWP.OSWP_TF.EnterTime_hdr,

ON CLICK WP_Tab.SWP.SWP_TF.SWPNumber_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.Location_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.OSSStatus_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.CurrentStatus_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.SWPDescription_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.SkedOutageDate_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.SkedStartDate_hdr,
ON CLICK WP_Tab.SWP.SWP_TF.SkedReturnDate_hdr =
DECLARE
   table_field = TableField default null;
   tf_array = ArrayObject default null;
   col_name = varchar(32) not null;
ENDDECLARE
BEGIN
   /* Find out what table and column we are in,
   ** if any. 
   */   
   table_field = CurFrame.TriggerField.WhichTableField();
   IF table_field is null THEN
      MESSAGE 'You must be in a table field to sort it. ';
      RESUME;
   ENDIF;
   /*
   **  Strip off the '_hdr' to match column name
   */
   col_name = Left(CurFrame.TriggerField.Name,LENGTH(CurFrame.TriggerField.Name) -4);
   /* 
   ** Point tf_array to the array underlying
   ** the tablefield 
   */
   table_field.GetFieldValue(value = byref(tf_array));
   /*
   ** Use CurEnumValue to specify sort order.
   ** Note that the first item in the menu list
   ** is labeled sort in ascending order, and the
   ** second item to sort in descending order.
   */
   IF table_field.Name = 'swp_tf' THEN
      IF SWP_SortOrder = AS_ASC AND SWP_LastColumn = col_name  THEN 
         SWP_SortOrder = AS_DESC;
      ELSE
         SWP_SortOrder = AS_ASC;
      ENDIF;
      SWP_LastColumn = col_name;

      /* Note the colon in front of col_name is required
      ** to indicate that col_name is a variable, not the
      ** literal column name.*/
      tf_array.sort(:col_name = SWP_SortOrder);
   ELSE
      IF OSWP_SortOrder = AS_ASC AND OSWP_LastColumn = col_name  THEN 
         OSWP_SortOrder = AS_DESC;
      ELSE
         OSWP_SortOrder = AS_ASC;
      ENDIF;
      OSWP_LastColumn = col_name;   
      tf_array.sort(:col_name = OSWP_SortOrder);
   ENDIF   
END;

ON CLICK wp_tab.swp.find_btn =
BEGIN
   IF wp_tab.swp.search_field = '' THEN
      MESSAGE 'Please enter number to search for.';
   ENDIF;

   IF wp_tab.swp.search_for = 0 THEN
      MESSAGE 'Please select type of number to search for.';
   ENDIF;
  
   CALLPROC LoadSWPReports();  
   IF wp_tab.swp.swp_tf.LastRow() = 0 THEN
      MESSAGE 'No Scheduling Work Packages found.';
   ENDIF; 
END;

ON CHILDENTRY wp_tab.swp.swp_tf =
DECLARE
   
ENDDECLARE
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   CurrentRow = 0;
   CurrentRow = FIELD(wp_tab.swp.swp_tf).CurRow;

   CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
END;

ON CHILDPROPERTIES wp_tab.swp.swp_tf =
DECLARE
   
ENDDECLARE
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   CurrentRow = 0;
   CurrentRow = FIELD(wp_tab.swp.swp_tf).CurRow;

   RetCode = CALLFRAME SWPDetails(SWP = wp_tab.swp.swp_tf[CurrentRow]);

   CALLPROC EnableSWPLoadCard(SelectRow = CurrentRow);
END;

ON CLICK wp_tab.swp.LoadCard_Btn =
BEGIN
   IF Card_SF.CL.LastRow = 0 THEN
      MESSAGE 'SWP is not linked to a Work Permit on a Card.';
      RESUME;
   ENDIF;

   IF Card_SF.CL.LastRow = 1 THEN
      CALLPROC LoadCard(LoadApp = Card_SF.CL[1].Application,
                        LoadCard = Card_SF.CL[1].Card);
      RETURN;
   ELSE
      FIELD(Card_SF).CurBias = FB_Landable;
      FIELD(Card_SF).AbsYTop = FIELD(WP_Tab.SWP.SWP_TF).AbsYBottom;
      FIELD(Card_SF).AbsXLeft = (FIELD(WP_Tab.SWP.SWP_TF).Width - FIELD(Card_SF).Width)/2 ;      
   ENDIF;
END;

ON CLICK wp_tab.swp.Reload =
BEGIN
   wp_tab.swp.search_for = 0;
   wp_tab.swp.search_field = '';
   FIELD(Card_SF).CurBias = FB_INVISIBLE;
   CALLPROC LoadSWPReports();
   IF wp_tab.swp.swp_tf.LastRow() = 0 THEN
      MESSAGE 'No Scheduling Work Packages.';
   ENDIF;
END;

ON ChildEntry Card_SF.CL =
BEGIN
   i = FIELD(Card_SF.CL).CurRow;

   CALLPROC LoadCard(LoadApp = Card_SF.CL[i].Application,
                     LoadCard = Card_SF.CL[i].Card);
   FIELD(Card_SF).CurBias = FB_INVISIBLE;
   RETURN;
END;

ON CLICK wp_tab.oswp.exit_btn,
ON CLICK wp_tab.swp.exit_btn =
BEGIN
   RETURN;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

/*===============================================================================================
** internal procedures
**===============================================================================================
*/
PROCEDURE LoadOSWPRequests (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1024) NOT NULL WITH DEFAULT; 
   oswpList = ARRAY OF OSWPRequestClass;  /* List of displayed permits */
BEGIN
/* 
** Load Array of Permits for Display
*/
   wp_tab.oswp.oswp_tf.Clear();

   DynamicWhereClause = '';
   IF wp_tab.oswp.search_for = 1 THEN
      DynamicWhereClause = 'P.OutageRequest LIKE ''%' + VARCHAR(wp_tab.oswp.search_field) + '%'' AND ';

   ELSEIF wp_tab.oswp.search_for = 2 THEN
      DynamicWhereClause = 'P.SWP LIKE ''%' + VARCHAR(wp_tab.oswp.search_field) + '%'' AND ';    
   ENDIF;

   DynamicWhereClause = DynamicWhereClause +
                        'P.Substation = O.Object AND ' +
                        'P.WorkGroup = T.Type AND ' +
                        'P.Status < ' + VARCHAR(OSPStatus$Archived) + ' AND ' +
                        'P.Status > ' + VARCHAR(OSPStatus$Open) + ' AND ' +
                        'P.Status <> ' + VARCHAR(OSPStatus$Denied);
      FIELD(wp_tab.oswp.Reload).CurBias = FB_LANDABLE;
      wp_tab.oswp.Div_Title = 'Out-of-Service Permit Requests for Division "' +  
                field(menu.division_list.division).CurEnumText + '"'; 

   IF field(menu.division_list.division).CurEnumValue = 1 THEN /* Effective Divisions Only */ 
      DynamicWhereClause = DynamicWhereClause + ' AND P.Substation = G.Member AND ' +
                           'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                           'G.Grouping IN (';

      FOR i = 1 TO EffectiveDivisions.LastRow() DO
         IF i > 1 THEN
            DynamicWhereClause = DynamicWhereClause + ', ' + 
                                 VARCHAR(EffectiveDivisions[i].Object);
         ELSE
            DynamicWhereClause = DynamicWhereClause + 
                                 VARCHAR(EffectiveDivisions[i].Object);
         ENDIF;
      ENDFOR;
      DynamicWhereClause = DynamicWhereClause + ')';

   ELSEIF field(menu.division_list.division).CurEnumValue > 2 THEN
      DynamicWhereClause = DynamicWhereClause + ' AND P.Substation = G.Member AND ' +
                           'G.Relationship = ' + VARCHAR(Interaction$MemberOf) + ' AND ' +
                           'G.Grouping = ' + VARCHAR(field(menu.division_list.division).CurEnumValue);
   ENDIF;

   i = 1;
   oswpList.Clear();
   IF field(menu.division_list.division).CurEnumValue = 2 THEN   /* All Divisions */
      SELECT 
          :oswpList[i].PermitJobID = P.PermitJobID,
          :oswpList[i].Substation = P.Substation, 
          :oswpList[i].SubstationName = O.Description, 
          :oswpList[i].WorkGroup = P.WorkGroup,        
          :oswpList[i].WorkGroupName = T.Name,        
          :oswpList[i].Equip = P.Equip, 
          :oswpList[i].EquipName = P.EquipName, 
          :oswpList[i].Title = P.Title,			    
          :oswpList[i].PreIssue = P.PreIssue,		    
          :oswpList[i].ShiftStartTime = P.ShiftStartTime,  
          :oswpList[i].EnterTime = P.EnterTime,		    
          :oswpList[i].EnterByName = P.EnterByName,		      
          :oswpList[i].SSO_Status = 0,			      
          :oswpList[i].SSO_Status_Name = '',			      
          :oswpList[i].CurrentStatus = P.CurrentStatus,			      
          :oswpList[i].Status = P.Status			      
      FROM  SOA_OSWPRequest P,
            Udb_Object O,
            Udb_Type T 
      WHERE  :DynamicWhereClause
      ORDER BY SubstationName
      BEGIN
         i = i + 1;
      END;
   ELSE
      SELECT :oswpList[i].PermitJobID = P.PermitJobID,
          :oswpList[i].Substation = P.Substation, 
          :oswpList[i].SubstationName = O.Description, 
          :oswpList[i].WorkGroup = P.WorkGroup,        
          :oswpList[i].WorkGroupName = T.Name,        
          :oswpList[i].Equip = P.Equip, 
          :oswpList[i].EquipName = P.EquipName, 
          :oswpList[i].Title = P.Title,			    
          :oswpList[i].PreIssue = P.PreIssue,		    
          :oswpList[i].ShiftStartTime = P.ShiftStartTime,  
          :oswpList[i].EnterTime = P.EnterTime,		    
          :oswpList[i].EnterByName = P.EnterByName,		      
          :oswpList[i].SSO_Status = 0,			      
          :oswpList[i].SSO_Status_Name = '',			      
          :oswpList[i].CurrentStatus = P.CurrentStatus,			      
          :oswpList[i].Status = P.Status			      
      FROM   SOA_OSWPRequest P,
          Udb_Object O,
          Udb_Type T,
          Udb_Grouping G 
      WHERE  :DynamicWhereClause
      ORDER BY SubstationName
      BEGIN
         i = i + 1;
      END;
   ENDIF;

   IF oswpList.LastRow() = 0 THEN
      MESSAGE 'No Out-of-Service Permit Requests found.';
   ENDIF;
/*
** Set Order Status 
*/
   FIELD(wp_tab.oswp.div_title).ParentField.CurBias = FB_CHANGEABLE;
   FIELD(wp_tab.oswp.oswp_tf).NumVisibleRows = 16;
   
   FOR i = 1 TO oswpList.LastRow() DO  

      OrderNumber = 0;

         SELECT  :OrderNumber = IFNULL(MAX(OrderNumber),0)
         FROM    IR_OpOrderJobs
         WHERE   Job = :oswpList[i].PermitJobID;

         IF OrderNumber > 0 THEN
            SELECT :oswpList[i].SSO_Status = OrderStatus
            FROM   IR_OperatingOrder
            WHERE  OrderNumber = :OrderNumber;
         
           IF oswpList[i].SSO_Status = Order$Opened THEN
              oswpList[i].SSO_Status_Name = 'Opened';

           ELSEIF oswpList[i].SSO_Status = Order$Downloaded THEN
              oswpList[i].SSO_Status_Name = 'Downloaded';

           ELSEIF oswpList[i].SSO_Status = Order$Acknowledged THEN
              oswpList[i].SSO_Status_Name = 'Acknowledged';

           ELSEIF oswpList[i].SSO_Status = Order$Rejected THEN
              oswpList[i].SSO_Status_Name = 'Rejected';

           ELSEIF oswpList[i].SSO_Status = Order$ConfirmRejected THEN
              oswpList[i].SSO_Status_Name = 'Confirm Rejected';

           ELSEIF oswpList[i].SSO_Status = Order$Rescinded THEN
              oswpList[i].SSO_Status_Name = 'Rescinded';

           ELSEIF oswpList[i].SSO_Status = Order$ConfirmRescinded THEN
              oswpList[i].SSO_Status_Name = 'Confirm Rescinded';

           ELSEIF oswpList[i].SSO_Status = Order$Closed THEN
              oswpList[i].SSO_Status_Name = 'Closed';

           ELSEIF oswpList[i].SSO_Status = Order$ConfirmClosed THEN
              oswpList[i].SSO_Status_Name = 'Confirm Closed';

           ELSEIF oswpList[i].SSO_Status = Order$Cancelled THEN
              oswpList[i].SSO_Status_Name = 'Cancelled';

           ENDIF;

        ELSE
           IF oswpList[i].Status >= ISPStatus$Issued THEN
              oswpList[i].SSO_Status_Name = 'Verbal';              
           ENDIF;
        ENDIF;
   ENDFOR;

   wp_tab.oswp.oswp_tf = oswpList.Duplicate();

   CALLPROC SetOSWPColors();
END;

PROCEDURE SetOSWPColors (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN     
/*
** Set field colors
*/
   FOR i = 1 TO wp_tab.oswp.oswp_tf.LastRow() DO
      IF wp_tab.oswp.oswp_tf[i].Status = OSPStatus$Request THEN
         FIELD(wp_tab.oswp.oswp_tf[i].CurrentStatus).BgColor = CC_LIGHT_YELLOW;
      ENDIF;
   ENDFOR;
END;

PROCEDURE LoadSWPReports(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DynamicWhereClause = VARCHAR(1024) NOT NULL WITH DEFAULT;
   SWPList = ARRAY OF SWPOutageReport;
BEGIN
/* 
** Load Array of Permits for Display
*/
   wp_tab.swp.swp_tf.Clear();
   FIELD(wp_tab.swp.swp_tf).NumVisibleRows = 16;

   wp_tab.swp.Div_Title = 'Scheduling Work Packages for Division "' +  
      field(menu.division_list.division).CurEnumText + '"'; 
   FIELD(wp_tab.swp.div_title).ParentField.CurBias = FB_CHANGEABLE;

   FIELD(wp_tab.swp.Reload).CurBias = FB_LANDABLE;
   
   DynamicWhereClause = ' R.Status >= ' + VARCHAR(Order$Opened) + 
                        ' AND R.Status < ' + VARCHAR(OSPStatus$Archived) + ' AND ';
   
   IF CurrentApplication = Application$FMS THEN
      DynamicWhereClause = DynamicWhereClause + ' R.Distribution = 1';
   ELSE
      DynamicWhereClause = DynamicWhereClause + ' R.Distribution = 0';
   ENDIF;
   
   IF field(menu.division_list.division).CurEnumValue = 1 THEN 
      /* Effective Divisions Only */ 
      DynamicWhereClause = DynamicWhereClause + ' AND R.Division IN (';

      FOR i = 1 TO EffectiveDivisions.LastRow() DO
         IF i > 1 THEN
            DynamicWhereClause = DynamicWhereClause + ', ' + VARCHAR(EffectiveDivisions[i].Object);
         ELSE
            DynamicWhereClause = DynamicWhereClause + VARCHAR(EffectiveDivisions[i].Object);
         ENDIF;
      ENDFOR;
      DynamicWhereClause = DynamicWhereClause + ')';

   ELSEIF field(menu.division_list.division).CurEnumValue > 2 THEN
      DynamicWhereClause = DynamicWhereClause + ' AND R.Division = ' + VARCHAR(field(menu.division_list.division).CurEnumValue);
   ENDIF;

   IF wp_tab.swp.search_for = 1 THEN
      DynamicWhereClause = ' O.ORNumber LIKE ''%' + VARCHAR(wp_tab.swp.search_field) + '%'' AND ' +
         ' O.SWPNumber = R.SWPNumber AND ' + DynamicWhereClause;
      i = 1;
      SWPList.Clear();
      SELECT 
            :SWPList[i].Division       = R.Division,  
            :SWPList[i].SWPNumber      = R.SWPNumber,
            :SWPList[i].SWPDescription = R.SWPDescription,
            :SWPList[i].Status         = R.Status,
            :SWPList[i].OSSStatus      = R.OSSStatus,
            :SWPList[i].Location       = R.Location,
            :SWPList[i].SkedOutageDate = R.SkedOutageDate,
            :SWPList[i].SkedStartDate  = R.SkedStartDate,
            :SWPList[i].SkedReturnDate = R.SkedReturnDate,
            :SWPList[i].ContinuousDaily = R.ContinuousDaily,
            :SWPList[i].HoursPerDay     = R.HoursPerDay,
            :SWPList[i].DaysPerWeek     = R.DaysPerWeek,   
            :SWPList[i].RecallTime      = R.RecallTime,   
            :SWPList[i].RestorationTime = R.RestorationTime,
            :SWPList[i].Instruction     = R.Instruction
      FROM  OSS_OutageRequest O,
            SOA_SWPOutageReport R
      WHERE  :DynamicWhereClause
      ORDER BY SkedOutageDate, Division
      BEGIN
         i = i + 1;
      END;
   ELSE
      IF wp_tab.swp.search_for = 2 THEN
         DynamicWhereClause = DynamicWhereClause + 
            ' AND R.SWPNumber LIKE ''%' + VARCHAR(wp_tab.swp.search_field) + '%''';    
      ENDIF;
      i = 1;
      SWPList.Clear();
      SELECT 
            :SWPList[i].Division       = R.Division,  
            :SWPList[i].SWPNumber      = R.SWPNumber,
            :SWPList[i].SWPDescription = R.SWPDescription,
            :SWPList[i].Status         = R.Status,
            :SWPList[i].OSSStatus      = R.OSSStatus,
            :SWPList[i].Location       = R.Location,
            :SWPList[i].SkedOutageDate = R.SkedOutageDate,
            :SWPList[i].SkedStartDate  = R.SkedStartDate,
            :SWPList[i].SkedReturnDate = R.SkedReturnDate,
            :SWPList[i].ContinuousDaily = R.ContinuousDaily,
            :SWPList[i].HoursPerDay     = R.HoursPerDay,
            :SWPList[i].DaysPerWeek     = R.DaysPerWeek,   
            :SWPList[i].RecallTime      = R.RecallTime,   
            :SWPList[i].RestorationTime = R.RestorationTime,
            :SWPList[i].Instruction     = R.Instruction,
            :SWPList[i].CurrentStatus   = R.CurrentStatus
      FROM  SOA_SWPOutageReport R
      WHERE  :DynamicWhereClause
      ORDER BY SkedOutageDate, Division
      BEGIN
         i = i + 1;
      END;
   ENDIF;
   CALLPROC DDB_ROLLBACK;
   
   FOR i = 1 TO SWPList.LastRow DO
      IF SWPList[i].OSSStatus = 'AS' THEN
         SWPList[i].OSSStatus = 'Apprd & Sched';

      ELSEIF SWPList[i].OSSStatus = 'APPROVED - ND' THEN
         SWPList[i].OSSStatus = 'Apprd - New Date';

      ENDIF;
   ENDFOR;   
   wp_tab.swp.swp_tf = SWPList.Duplicate();
END;

PROCEDURE LoadCard(
   LoadApp = CHAR(4) NOT NULL WITH DEFAULT;
   LoadCard = INTEGER NOT NULL WITH DEFAULT;
) = 
BEGIN
   IF LoadApp = Application$FMS THEN
      TempChar = Left(UserName,Length(UserName) - 3) + VARCHAR(Application$FMSInt) + Right(UserName, 2);         

      ControlText = TempChar + ';';
      ControlText = ControlText + varchar(LoadCard) + ';';
      ControlText = ControlText + Application$FMS + ';'; 
      ControlText = ControlText + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'FMS_LoadCommonCard', 
                                        DBEventText = ControlText); 
   ELSE
      ControlText = UserName + ';';
      ControlText = ControlText + varchar(LoadCard) + ';';
      ControlText = ControlText + LoadApp + ';'; 
      ControlText = ControlText + UserName + ';';
      CALLPROC DDB_RaiseDBEvent ( DBEventName = 'SOA_LoadCommonCard', 
                                     DBEventText = ControlText);                 
   ENDIF;
   RETURN;
END;

PROCEDURE EnableSWPLoadCard(
   SelectRow = INTEGER NOT NULL WITH DEFAULT
) =
BEGIN
   i = 1;
   REPEATED
   SELECT DISTINCT
          :Card_SF.CL[i].Application = C.Application,
          :Card_SF.CL[i].Card = C.Card,
          :Card_SF.CL[i].TOMove = J.TOMove
   FROM   SOA_SWPPermit W,
          SOA_Job J,
          SOA_JobControl JC,
          SOA_Card C
   WHERE  W.SWPNumber = :wp_tab.swp.swp_tf[SelectRow].SWPNumber AND
          W.PermitJobID = J.Job and
          J.Job = JC.Job AND
          JC.Card = C.Card
   ORDER BY Application
   BEGIN 
      IF Card_SF.CL[i].Application = Application$FMS THEN
         SELECT :Card_SF.CL[i].CardName = C.FeederName
         FROM   FMS_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ELSEIF Card_SF.CL[i].Application = Application$TFMS THEN
         SELECT :Card_SF.CL[i].CardName = C.FeederNames
         FROM   TFMS_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ELSEIF Card_SF.CL[i].Application = Application$SLC THEN
         SELECT :Card_SF.CL[i].CardName = C.SubstationName
         FROM   SLC_Card C
         WHERE  C.Card = :Card_SF.CL[i].Card;
      ENDIF; 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;

   IF Card_SF.CL.LastRow > 0 THEN
      FIELD(wp_tab.swp.LoadCard_Btn).CurBias = FB_LANDABLE;
   ELSE
      FIELD(wp_tab.swp.LoadCard_Btn).CurBias = FB_INVISIBLE;
   ENDIF;

   /* refresh only when request was changed
   */
   IF RetCode = PU_OK THEN
      CALLPROC LoadSWPReports();
   ENDIF;
END;

