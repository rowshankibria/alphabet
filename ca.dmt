METHOD LoadBinaryData (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SelectSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF UPPERCASE(CurObject.TableName) = 'CAC_CO_ATTACHMENT' THEN 
      SelectSql = 'SELECT DataStream FROM CAC_CO_ATTACHMENT WHERE ' + 
                'Grouping = ' + VARCHAR(CurObject.Grouping) + ' AND ' +
                'FileID = ' + VARCHAR(CurObject.FileID);
   ELSE
      SelectSql = 'SELECT DataStream FROM CAC_RELAY_ATTACHMENT WHERE ' + 
                'Grouping = ' + VARCHAR(CurObject.Grouping) + ' AND ' +
                'FileID = ' + VARCHAR(CurObject.FileID);
   ENDIF;
/*
** Read binary data from one database
*/
   CurMethod.DBSession = DDB_Global.Session.Cur;

   If CurObject.BinaryStream.FetchFromDB(Query = SelectSql) <> ER_OK THEN
      ROLLBACK;
      CurObject.ReturnCode = -1;
      CurObject.ErrorMessage = 'Failed to read binary file ' + CurObject.FileName + ' from ' + CurObject.TableName;
      CurMethod.Trace(Text= varchar(date('now')) + ': BinaryFileClass.LoadBinaryData; Failed to read binary file ' + CurObject.FileName + 
                         ' from ' + CurObject.TableName);
      RETURN;
   ELSE
      ROLLBACK;
   ENDIF;
END;

METHOD DeleteAttachment (
) =
DECLARE
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   FileName = VARCHAR(80) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
  
   SELECT :FileName = FileName
   FROM   CAC_CO_Attachment 
   WHERE  Grouping = :CurObject.Grouping AND
          FileID = :CurObject.FileID;
   CALLPROC DDB_ROLLBACK;

   RetCode = CALLPROC CAC_CO_AttachmentDel (
           Grouping = CurObject.Grouping,
           FileID = CurObject.FileID
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'RPMAttachment.DeleteAttachment; Error deleting RPM attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : RPMAttachment.DeleteAttachment; ' + 
                'Error deleting RPM attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
    EventText = VARCHAR(CurObject.Grouping) + ';' + FileName;
    CALLPROC InsertDBEventQueue(
                     ToApp = 'TASK',
                     EventName = 'TLS_DeleteRPMPFile',
                     EventText = EventText);
*/
    RETURN;
END;

METHOD InsertAttachment (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   DBSession1Status = INTEGER NOT NULL WITH DEFAULT;
   DBSession2Status = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(80) NOT NULL WITH DEFAULT;
   RetCode  = INTEGER NOT NULL WITH DEFAULT;
   SaveDate = DATE NOT NULL WITH DEFAULT;
   UpdateSql = VARCHAR(200) NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   i = 0;
   SELECT :i = IFNULL(max(FileID), 0)
   FROM   CAC_CO_Attachment
   WHERE  Grouping = :CurObject.Grouping;

   CurObject.FileID = i + 1;

   RetCode = CALLPROC CAC_CO_AttachmentIns(
           Grouping = CurObject.Grouping,
           FileID = CurObject.FileID,
           FileName = SQUEEZE(CurObject.FileName)
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'RPMAttachment.InsertAttachment; Error inserting attachment';
       CurMethod.Trace(Text = varchar(date('now')) + ' : RPMAttachment.InsertAttachment; ' + 
                'Error inserting attachment');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
** Save file binary in the database. 
*/
    DBSession1Status = 0;
    DBSession2Status = 0;

    SaveDate = DATE('NOW');
    UpdateSql = ' UPDATE CAC_CO_Attachment SET DataStream ' + 
                ' WHERE  Grouping = ' + VARCHAR(CurObject.Grouping) + 
                ' AND   FileID = ' + VARCHAR(CurObject.FileID);

    IF DDB_Global.Session.One.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.One;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession1Status = -1;       
       ELSE
          COMMIT;
          DBSession1Status = 1;
       ENDIF;
    ENDIF;

    IF DDB_Global.Session.Two.State = DS_CONNECTED THEN
       CurMethod.DBSession = DDB_Global.Session.Two;
       If CurObject.BinaryStream.UpdateInDB(Query = UpdateSql) <> ER_OK Then  
          ROLLBACK;
          DBSession2Status = -1;       
       ELSE
          COMMIT;
          DBSession2Status = 1; 
       ENDIF;
    ENDIF;

/*
** make it ddb compliant again.
*/
//    CurMethod.DBSession = DDB_Global.Session.Cur;
    
    IF DBSession1Status = -1 AND DBSession2Status = -1 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'RPMAttachment.InsertAttachment; Error saving file binary in database.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : RPMAttachment.InsertAttachment; Error saving file binary in database.');
       RetCode = CALLPROC CAC_CO_AttachmentDel(
                              Grouping = CurObject.Grouping,
                              FileID = CurObject.FileID);
       CALLPROC DDB_COMMIT;
       RETURN;
    ELSEIF DBSession1Status = 1 AND DBSession2Status = 1 THEN
       CurObject.DBServer = 0;

    ELSEIF DBSession1Status = 1 THEN
       CurObject.DBServer = 1;

    ELSEIF DBSession2Status = 1 THEN
       CurObject.DBServer = 2;

    ELSE
       CurObject.DBServer = -1;
    ENDIF;

 
    RetCode = CALLPROC CAC_CO_AttachmentUpd(
                      Grouping = CurObject.Grouping,
                      FileID = CurObject.FileID,
                      DBServer = CurObject.DBServer);
    IF RetCode = 0 THEN
       CALLPROC DDB_COMMIT;
    ELSE
       CALLPROC DDB_ROLLBACK;
       CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Failed to set CAC_CO_Attachment.DBServer to ' + 
                       VARCHAR(CurObject.DBServer) + ' for grouping ' + 
                       VARCHAR(CurObject.Grouping) + ', file ' + 
                       VARCHAR(CurObject.FileID));
    ENDIF; 
 /*
    IF CurrentApplication = '' THEN
       CurrentApplication = 'FMS Online';
    ENDIF;
    EventText = VARCHAR(CurObject.Grouping) + ';' + EventText;
    CALLPROC InsertDBEventQueue(
                     ToApp = 'TASK',
                     EventName = 'TLS_NewRPMPFile',
                     EventText = EventText);
*/
    RETURN;
END;

