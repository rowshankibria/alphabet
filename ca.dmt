	Name:            EquipmentDocuments

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          EquipmentCheckList
**
**  Date:       Author   Description
** ----------------------------------
**  11/24/98	EM       Incorporated into SOA
**  12/03/98    em       If Goal is Missing Documents, then use 
**                       PlaceInService document type.
**  04/17/00    em       Add documents for Insert/Remove Bus Link
**
*/
INITIALIZE 
(
#  include StandardDeclarations

    Goal = INTEGER NOT NULL;                /*P: Objective of Document  */
    Object = INTEGER NOT NULL;              /*P:    equipment object    */
    RetVal = INTEGER NOT NULL;              /*Local: Return Value       */
    DocType = INTEGER NOT NULL;             /*Local: Document Type      */

) =
BEGIN

    IF Goal = Goal$PlaceInService OR Goal = Goal$Document THEN
       DocType = Type$PlaceInServiceDocument;
    ELSEIF Goal = Goal$RemoveFromService THEN
       DocType = Type$RemoveFromServiceDocument;
    ELSEIF Goal = Goal$RemoveBusLink THEN
       DocType = Type$RemoveBusLinkDocument;
    ELSEIF Goal = Goal$InsertBusLink THEN
       DocType = Type$InsertBusLinkDocument;
    ENDIF;
/** 
 **  Get the Equipment information
 **/
    Doc.Clear();

    i = 1;

    REPEATED
    SELECT      :Equipment.Type = TypeName,
                :Equipment.Equip = Name,
                :Equipment.supplies = Description
    FROM    Udb_Object
    WHERE   Object = :Object

    BEGIN
    END;

/**
 **  Attempt to get existing document information.
 **  The document information may not exist, 
 **  do to the equipment that is in service
 **  before the document table existed or
 **  if the equipment is just being placed in service.
 **/
    i = 1;

    REPEATED
    SELECT      :Doc[i].Equip = O.Object,
                :Doc[i].DocumentType = D.DocumentType,
                :Doc[i].Status = D.Status,
                :Doc[i].DocumentName = T.Name
        FROM    Udb_Object O,
                SLC_Document D,
                Udb_Type T
        WHERE   O.Object = :Object AND
                O.Object = D.Equip AND
                T.Type = D.DocumentType
        /*ORDER BY Name*/

    BEGIN 
        i = i + 1;
    END;

/**
 **  If no existing document information was found
 **  new document information must be created.
 **  Load the frame with the document types.
 **  
 **/             
    IF Doc.AllRows() = 0 THEN

        i = 1;

        REPEATED
        SELECT      :Doc[i].DocumentType = T.Type,
                    :Doc[i].DocumentName = T.Name
            FROM    Udb_Type T, 
                    Udb_ExtendedType S
            WHERE   S.SuperType = :DocType AND
                    T.Type = S.Type AND
                    T.Type <> :DocType
            /*ORDER BY Name */

        BEGIN
            Doc[i].Equip = Object;
            Doc[i].Status = Document$Missing;
            i = i + 1;
        End;
        
        IF Doc.AllRows() = 0 THEN
            CurFrame.InfoPopup(MessageText =
                        'No Documents were found for this objective.', 
                        MessageType = MT_WARNING);
            RETURN;                     
        ENDIF;    

    ENDIF;
                 
    CALLPROC DDB_Rollback;
END;
 
ON CLICK ok_btn =
BEGIN
    i = 1;
/**
 **  Update the SLC_Document table
 **/
    WHILE i <= Doc.LastRow() DO
        RetVal = CALLPROC SLC_DocumentUpdate (
                        Equip = Doc[i].Equip,
                        DocumentType = Doc[i].DocumentType,
                        Status = Doc[i].Status); 

        IF RetVal <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            RESUME;
        ELSE
            CALLPROC DDB_COMMIT;
        ENDIF;

        i = i + 1;
    ENDWHILE;

    SOAFrame.SendUserEvent (EventName = 'CheckForMissingDocuments');
    RETURN;
END;


