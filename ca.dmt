/*
**  Application:    CAC
**  Class:          SSO_Relays_ASE
**
**  Date:       Author   Description
** ----------------------------------
**  08/18/05  em  Created
**  12/16/15  ysp Add query of SubstationNames
**  03/29/16  ysp Add support of queries by User Desk
**  05/11/16  pkw Also load verbal relays when loading by Card
**  05/23/16  pkw Sort by substation first, then sequence
**  09/29/16  ysp Load operating order comments returned from SSO.
**  11/14/16  ysp Remove "Macro" from substation names.
*/
METHOD GetSSORelaysbyJob (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
BEGIN
   i = 1;
   SELECT  :CurObject.RT[i].Comment = Comment
          ,:CurObject.RT[i].Equipment = Equipment
          ,:CurObject.RT[i].Job = Job
          ,:CurObject.RT[i].Line = Line
          ,:CurObject.RT[i].RelayName = RelayName
          ,:CurObject.RT[i].TimeStamp = TimeStamp
          ,:CurObject.RT[i].TypeA = TypeA
          ,:CurObject.RT[i].TypeB = TypeB
          ,:CurObject.RT[i].TypeC = TypeC
          ,:CurObject.RT[i].TypeInst = TypeInst
          ,:CurObject.RT[i].TypeText = TypeText
          ,:CurObject.RT[i].TypeTime = TypeTime
          ,:CurObject.RT[i].SubstationName = SubstationName
          ,:CurObject.RT[i].Substation = Substation
          ,:CurObject.RT[i].Sequence = Sequence
          ,:CurObject.RT[i].IsVerbal = IsVerbal
   FROM   IR_RelayTargets
   WHERE  Job = :CurObject.Job
   BEGIN 
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
 
   RETURN (CurObject.RT.LastRow());
END;


METHOD GetSSORelaysbyCard (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   iPos = INTEGER NOT NULL WITH DEFAULT;
   SuperType = INTEGER NOT NULL WITH DEFAULT;
   RRTypeName = VARCHAR(40) NOT NULL;
   TempStation =  VARCHAR(40) NOT NULL WITH DEFAULT;
BEGIN
   IF CurObject.UserDesk = 0 THEN
      IF CurObject.ArchiveCard = FALSE THEN
         i = 1;
         SELECT  :CurObject.RT[i].Comment = RT.Comment
                ,:CurObject.RT[i].Equipment = RT.Equipment
                ,:CurObject.RT[i].Job = RT.Job
                ,:CurObject.RT[i].Line = RT.Line
                ,:CurObject.RT[i].RelayName = RT.RelayName
                ,:CurObject.RT[i].TimeStamp = RT.TimeStamp
                ,:CurObject.RT[i].TypeA = RT.TypeA
                ,:CurObject.RT[i].TypeB = RT.TypeB
                ,:CurObject.RT[i].TypeC = RT.TypeC
                ,:CurObject.RT[i].TypeInst = RT.TypeInst
                ,:CurObject.RT[i].TypeText = RT.TypeText
                ,:CurObject.RT[i].TypeTime = RT.TypeTime
                ,:CurObject.RT[i].SubstationName = RT.SubstationName
                ,:CurObject.RT[i].Substation = RT.Substation
                ,:CurObject.RT[i].Sequence = RT.Sequence
                ,:CurObject.RT[i].IsVerbal = RT.IsVerbal
         FROM   IR_RelayTargets RT,
                SOA_JobControl JC
         WHERE  JC.Card = :CurObject.Card AND
                JC.SwitchingItem = :CurObject.SwitchingItem AND
                JC.Job = RT.Job
         UNION
         SELECT  RT.Comment
                ,RT.Equipment
                ,RT.Job
                ,RT.Line
                ,RT.RelayName
                ,RT.TimeStamp
                ,RT.TypeA
                ,RT.TypeB
                ,RT.TypeC
                ,RT.TypeInst
                ,RT.TypeText
                ,RT.TypeTime
                ,RT.SubstationName
                ,RT.Substation
                ,RT.Sequence
                ,RT.IsVerbal
         FROM   IR_RelayTargets RT
         WHERE  RT.Job = :CurObject.Card
         ORDER BY SubstationName, Sequence, TimeStamp
         BEGIN  
             i = i + 1;
         END;
         CALLPROC DDB_ROLLBACK;
      ELSE
         i = 1;
         SELECT  :CurObject.RT[i].Comment = RT.Comment
                ,:CurObject.RT[i].Equipment = RT.Equipment
                ,:CurObject.RT[i].Job = RT.Job
                ,:CurObject.RT[i].Line = RT.Line
                ,:CurObject.RT[i].RelayName = RT.RelayName
                ,:CurObject.RT[i].TimeStamp = RT.TimeStamp
                ,:CurObject.RT[i].TypeA = RT.TypeA
                ,:CurObject.RT[i].TypeB = RT.TypeB
                ,:CurObject.RT[i].TypeC = RT.TypeC
                ,:CurObject.RT[i].TypeInst = RT.TypeInst
                ,:CurObject.RT[i].TypeText = RT.TypeText
                ,:CurObject.RT[i].TypeTime = RT.TypeTime
                ,:CurObject.RT[i].SubstationName = RT.SubstationName
                ,:CurObject.RT[i].Substation = RT.Substation
                ,:CurObject.RT[i].Sequence = RT.Sequence
                ,:CurObject.RT[i].IsVerbal = RT.IsVerbal
         FROM   IR_RelayTargets RT,
                SOA_ArchiveJob J
         WHERE  J.Card = :CurObject.Card AND
                J.SwitchingItem = :CurObject.SwitchingItem AND
                J.Job = RT.Job
         UNION
         SELECT  RT.Comment
                ,RT.Equipment
                ,RT.Job
                ,RT.Line
                ,RT.RelayName
                ,RT.TimeStamp
                ,RT.TypeA
                ,RT.TypeB
                ,RT.TypeC
                ,RT.TypeInst
                ,RT.TypeText
                ,RT.TypeTime
                ,RT.SubstationName
                ,RT.Substation
                ,RT.Sequence
                ,RT.IsVerbal
         FROM   IR_RelayTargets RT
         WHERE  RT.Job = :CurObject.Card
         ORDER BY SubstationName, Sequence, TimeStamp
         BEGIN  
             i = i + 1;
         END;
         CALLPROC DDB_ROLLBACK;
      ENDIF;
   ELSE
      IF CurObject.ArchiveCard = FALSE THEN
         i = 1;
         SELECT  :CurObject.RT[i].Comment = RT.Comment
                ,:CurObject.RT[i].Equipment = RT.Equipment
                ,:CurObject.RT[i].Job = RT.Job
                ,:CurObject.RT[i].Line = RT.Line
                ,:CurObject.RT[i].RelayName = RT.RelayName
                ,:CurObject.RT[i].TimeStamp = RT.TimeStamp
                ,:CurObject.RT[i].TypeA = RT.TypeA
                ,:CurObject.RT[i].TypeB = RT.TypeB
                ,:CurObject.RT[i].TypeC = RT.TypeC
                ,:CurObject.RT[i].TypeInst = RT.TypeInst
                ,:CurObject.RT[i].TypeText = RT.TypeText
                ,:CurObject.RT[i].TypeTime = RT.TypeTime
                ,:CurObject.RT[i].SubstationName = RT.SubstationName
                ,:CurObject.RT[i].Substation = RT.Substation
                ,:CurObject.RT[i].Sequence = RT.Sequence
                ,:CurObject.RT[i].IsVerbal = RT.IsVerbal
         FROM   IR_RelayTargets RT,
                SOA_JobControl JC,
                UDB_Grouping G1,
                UDB_Grouping G2
         WHERE  JC.Card = :CurObject.Card AND
                JC.SwitchingItem = :CurObject.SwitchingItem AND
                JC.Job = RT.Job AND
                RT.Substation = G1.Member AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.Grouping = G2.Member AND
                G2.MemberType = :Type$Division AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.Grouping = :CurObject.UserDesk
         UNION
         SELECT  RT.Comment
                ,RT.Equipment
                ,RT.Job
                ,RT.Line
                ,RT.RelayName
                ,RT.TimeStamp
                ,RT.TypeA
                ,RT.TypeB
                ,RT.TypeC
                ,RT.TypeInst
                ,RT.TypeText
                ,RT.TypeTime
                ,RT.SubstationName
                ,RT.Substation
                ,RT.Sequence
                ,RT.IsVerbal
         FROM   IR_RelayTargets RT,
                UDB_Grouping G1,
                UDB_Grouping G2
         WHERE  RT.Job = :CurObject.Card AND
                RT.Substation = G1.Member AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.Grouping = G2.Member AND
                G2.MemberType = :Type$Division AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.Grouping = :CurObject.UserDesk
         ORDER BY SubstationName, Sequence, TimeStamp
         BEGIN  
             i = i + 1;
         END;
         CALLPROC DDB_ROLLBACK;
      ELSE
         i = 1;
         SELECT  :CurObject.RT[i].Comment = RT.Comment
                ,:CurObject.RT[i].Equipment = RT.Equipment
                ,:CurObject.RT[i].Job = RT.Job
                ,:CurObject.RT[i].Line = RT.Line
                ,:CurObject.RT[i].RelayName = RT.RelayName
                ,:CurObject.RT[i].TimeStamp = RT.TimeStamp
                ,:CurObject.RT[i].TypeA = RT.TypeA
                ,:CurObject.RT[i].TypeB = RT.TypeB
                ,:CurObject.RT[i].TypeC = RT.TypeC
                ,:CurObject.RT[i].TypeInst = RT.TypeInst
                ,:CurObject.RT[i].TypeText = RT.TypeText
                ,:CurObject.RT[i].TypeTime = RT.TypeTime
                ,:CurObject.RT[i].SubstationName = RT.SubstationName
                ,:CurObject.RT[i].Substation = RT.Substation
                ,:CurObject.RT[i].Sequence = RT.Sequence
                ,:CurObject.RT[i].IsVerbal = RT.IsVerbal
         FROM   IR_RelayTargets RT,
                SOA_ArchiveJob J,
                UDB_Grouping G1,
                UDB_Grouping G2
         WHERE  J.Card = :CurObject.Card AND
                J.SwitchingItem = :CurObject.SwitchingItem AND
                J.Job = RT.Job AND
                RT.Substation = G1.Member AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.Grouping = G2.Member AND
                G2.MemberType = :Type$Division AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.Grouping = :CurObject.UserDesk
         UNION
         SELECT  RT.Comment
                ,RT.Equipment
                ,RT.Job
                ,RT.Line
                ,RT.RelayName
                ,RT.TimeStamp
                ,RT.TypeA
                ,RT.TypeB
                ,RT.TypeC
                ,RT.TypeInst
                ,RT.TypeText
                ,RT.TypeTime
                ,RT.SubstationName
                ,RT.Substation
                ,RT.Sequence
                ,RT.IsVerbal
         FROM   IR_RelayTargets RT,
                UDB_Grouping G1,
                UDB_Grouping G2
         WHERE  RT.Job = :CurObject.Card AND
                RT.Substation = G1.Member AND
                G1.Relationship = :Interaction$MemberOf AND
                G1.Grouping = G2.Member AND
                G2.MemberType = :Type$Division AND
                G2.Relationship = :Interaction$MemberOf AND
                G2.Grouping = :CurObject.UserDesk
         ORDER BY SubstationName, Sequence, TimeStamp
         BEGIN  
             i = i + 1;
         END;
         CALLPROC DDB_ROLLBACK;
      ENDIF;
   ENDIF;
   /*
   **  Load list of breakers that tripped as part of Open Auto
   */
   i = 1;
   IF CurObject.ArchiveCard = FALSE THEN
      SELECT  :CurObject.BL[i].SubstationName = O1.Description
             ,:CurObject.BL[i].TypeText = O.TypeName
             ,:CurObject.BL[i].TypeInst = O.Type
             ,:CurObject.BL[i].Equipment = O.Name
      FROM   SOA_Log L,
             Udb_Object O,
             Udb_Object O1,
             UDB_Grouping G,
             UDB_ExtendedType ET
      WHERE  L.Card = :CurObject.Card AND
             L.SwitchingItem = :CurObject.SwitchingItem AND
             lowercase(L.Item) = 'breaker trip' AND
             Int4(L.Old) = O.Object AND
             O.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation AND
             G.Grouping = O1.Object
      ORDER BY SubstationName, Equipment
      BEGIN  
         i = i + 1;
      END;
   ELSE
      SELECT  :CurObject.BL[i].SubstationName = O1.Description
             ,:CurObject.BL[i].TypeText = O.TypeName
             ,:CurObject.BL[i].TypeInst = O.Type
             ,:CurObject.BL[i].Equipment = O.Name
      FROM   SOA_ArchiveLog L,
             Udb_Object O,
             Udb_Object O1,
             UDB_Grouping G,
             Udb_ExtendedType ET
      WHERE  L.Card = :CurObject.Card AND
             L.SwitchingItem = :CurObject.SwitchingItem AND
             lowercase(L.Item) = 'breaker trip' AND
             Int4(L.Old) = O.Object AND
             O.Object = G.Member AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation AND
             G.Grouping = O1.Object   
      ORDER BY SubstationName, Equipment
      BEGIN  
         i = i + 1;
      END;
   ENDIF;
   
/* SLC Relays (using Open Auto moves)
      IF CurObject.ArchiveCard = FALSE THEN
         SELECT  :CurObject.BL[i].SubstationName = O.Description
                ,:CurObject.BL[i].TypeText = J.EquipClassName
                ,:CurObject.BL[i].TypeInst = J.EquipClass
                ,:CurObject.BL[i].Equipment = J.EquipName
         FROM   SOA_JobControl JC,
                SOA_Job J,
                Udb_Object O
         WHERE  JC.Card = :CurObject.Card AND
                JC.SwitchingItem = :CurObject.SwitchingItem AND
                JC.Job = J.Job AND
                J.JobClass = :JobClass$OpenAuto AND
                J.TOComplete IS NOT NULL AND
                J.Substation = O.Object
         ORDER BY SubstationName, Equipment
         BEGIN  
            i = i + 1;
         END;
      ELSE
         SELECT  :CurObject.BL[i].SubstationName = O.Description
                ,:CurObject.BL[i].TypeText = J.EquipClassName
                ,:CurObject.BL[i].TypeInst = J.EquipClass
                ,:CurObject.BL[i].Equipment = J.EquipName
         FROM   SOA_ArchiveJob J,
                Udb_Object O
         WHERE  J.Card = :CurObject.Card AND
                J.SwitchingItem = :CurObject.SwitchingItem AND
                J.JobClass = :JobClass$OpenAuto AND
                J.TOComplete IS NOT NULL AND
                J.Substation = O.Object
         ORDER BY SubstationName, Equipment
         BEGIN  
            i = i + 1;
         END;
      ENDIF; 
*/      
   CALLPROC DDB_ROLLBACK;
   
   i = 1;
   WHILE i <= CurObject.BL.LastRow DO 
      RRTypeName = '';
      SELECT :RRTypeName = T.Name
      FROM    Udb_Type T,
              IR_TypeTranslation IR
      WHERE   IR.Type = :CurObject.BL[i].TypeInst AND
              IR.RRType = T.Type;
      IF RRTypeName <> '' THEN
         CurObject.BL[i].TypeText = RRTypeName;
         i = i + 1;
      ELSE
         SuperType = -1;
         SELECT :SuperType = ST.SuperType
         FROM    Udb_SuperType ST
         WHERE   ST.Type = :CurObject.BL[i].TypeInst;
         IF SuperType = -1 THEN
            i = i + 1;
         ELSE
            CurObject.BL[i].TypeInst = SuperType;
         ENDIF;
      ENDIF;
   ENDWHILE;
   
   /*
   **  Load list of SSO returned remarks.
   */
   i = 1;
   IF CurObject.ArchiveCard = FALSE THEN
      SELECT :CurObject.CL[i].SubstationName = O.Description,
             :CurObject.CL[i].ReturnBySSO = OO.ReturnBySSO,
             :CurObject.CL[i].ReturnComment = OO.ReturnComment,
             :CurObject.CL[i].ReturnTime = OO.ReturnTime
      FROM   IR_OperatingOrder OO,
             IR_OpOrderJobs OJ,
             SOA_JobControl JC,
             SOA_Job J,
             FMS_JobAction JA,
             Udb_Object O
      WHERE  OO.Card = :CurObject.Card AND
             OO.SwitchingItem = :CurObject.SwitchingItem AND
             OO.OrderStatus IN (:Order$Closed, :Order$ConfirmClosed) AND 
             OO.OrderNumber = OJ.OrderNumber AND
             OJ.Job = JC.Job AND
             JC.Card = :CurObject.Card AND
             JC.Job = J.Job AND
             J.JobClass = JA.JobClass AND
             JC.MoveEquipClass = JA.EquipClass AND
             JC.StepPair = JA.StepPair AND
             JA.IssueCompl = 1 AND
             JA.Action = :JobAction$Prompt AND
             JA.Status = :Prompt$RelayTargetsFromSSO AND
             OO.Substation = O.Object
      ORDER BY ReturnTime ASC
      BEGIN
         i = i + 1;
      END;   
   ELSE
      SELECT :CurObject.CL[i].SubstationName = O.Description,
             :CurObject.CL[i].ReturnBySSO = OO.ReturnBySSO,
             :CurObject.CL[i].ReturnComment = OO.ReturnComment,
             :CurObject.CL[i].ReturnTime = OO.ReturnTime
      FROM   IR_OperatingOrder OO,
             IR_OpOrderJobs OJ,
             SOA_ArchiveJob J,
             FMS_JobAction JA,
             Udb_Object O
      WHERE  OO.Card = :CurObject.Card AND
             OO.SwitchingItem = :CurObject.SwitchingItem AND
             OO.OrderStatus IN (:Order$Closed, :Order$ConfirmClosed) AND 
             OO.OrderNumber = OJ.OrderNumber AND
             OJ.Job = J.Job AND
             J.Card = :CurObject.Card AND
             J.SwitchingItem = :CurObject.SwitchingItem AND
             J.JobClass = JA.JobClass AND
             J.EquipClass = JA.EquipClass AND
             J.StepPair = JA.StepPair AND
             JA.IssueCompl = 1 AND
             JA.Action = :JobAction$Prompt AND
             JA.Status = :Prompt$RelayTargetsFromSSO AND
             OO.Substation = O.Object
      ORDER BY ReturnTime ASC
      BEGIN
         i = i + 1;
      END;   
   ENDIF;
   CALLPROC DDB_ROLLBACK;

/*
** Remove "MACRO" string from the substation names
*/
   FOR i = 1 TO CurObject.CL.LastRow DO
      iPos = LOCATE(UPPERCASE(CurObject.CL[i].SubstationName), 'MACRO');
      IF iPos < SIZE(CurObject.CL[i].SubstationName) THEN
         // Macro found
         TempStation = LEFT(CurObject.CL[i].SubstationName, iPos -1);
         CurObject.CL[i].SubstationName = SHIFT(CurObject.CL[i].SubstationName, -1*(iPos+5));
         CurObject.CL[i].SubstationName = TempStation + CurObject.CL[i].SubstationName;
      ENDIF;
   ENDFOR;
   
   RETURN (CurObject.RT.LastRow());
END;

