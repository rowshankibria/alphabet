	Name:            ManualTimeEntry

/*
**
**	Copyright c 1994 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    SOA
**  Frame:          ManualTimeEntry
**
**  Modifications:
**   04/20/99  pkw   Modified FMS Frame
**   05/26/00  em    Don't let new time be set in the future.
**   12/14/05  ysp   Increase the size of movetext to 160 chars
**   02/12/09  pkw   Allow seconds to be updated.
**   11/24/09  ysp   Add Move as the passed-in parameter
**   01/08/10  ysp   Use SendOpenToSSL & SendCloseToSSL prompts to determine whether
**                   to send breaker status timestamp update to SSL
**   01/26/10  em    Add NoAudit flag to prevent SSL Update from being inserted when move
**                   completed in ManualENtryMode
*/
INITIALIZE
(
   Move = Job;          /* passed in by reference */
   NoAudit = INTEGER NOT NULL WITH DEFAULT; /*Optional*/

#  include StandardDeclarations
   PassedTime = DATE;    
   NowTime = DATE;      /* Must be less than this time */
) =
DECLARE
   LogBreakerUpdate = PROCEDURE;
ENDDECLARE
BEGIN
    IF MessageText = 'TO Issue' THEN
       MoveText = Move.TOMove;
       PassedTime = Move.TOIssued;
    ELSEIF MessageText = 'TO Complete' THEN
       MoveText = Move.TOMove;
       PassedTime = Move.TOComplete;
    ELSEIF MessageText = 'RS Issue' THEN
       MoveText = Move.RSMove;
       PassedTime = Move.RSIssued;
    ELSEIF MessageText = 'RS Complete' THEN
       MoveText = Move.RSMove;
       PassedTime = Move.RSComplete;
    ENDIF;

    NewTime = PassedTime;
    NowTime = DATE('now') + '10 minutes';
END;
/*
**	Handle an OK click
*/
ON Click OK_Btn =
BEGIN

    IF NewTime = '' OR NewTime IS NULL THEN
       Message 'You may not clear an existing timestamp.';
       NewTime = PassedTime;
       RESUME;
    ENDIF;

    IF NewTime > NowTime THEN
       MESSAGE 'Sorry, you are not allowed to use this feature to ' +
               'set future times.';
       NewTime = PassedTime;
       RESUME;
    ENDIF;

    IF MessageText = 'TO Issue' THEN
       Move.TOIssued = NewTime;
    ELSEIF MessageText = 'TO Complete' THEN
       Move.TOComplete = NewTime;
       CALLPROC LogBreakerUpdate();
    ELSEIF MessageText = 'RS Issue' THEN
       Move.RSIssued = NewTime;
    ELSEIF MessageText = 'RS Complete' THEN
       Move.RSComplete = NewTime;
       CALLPROC LogBreakerUpdate();
    ENDIF;

    
    RETURN (PU_OK);
END;


ON CLICK Cancel_btn,
ON CLICK Menu.File.Close_btn =
BEGIN
/*
** Exit without performing an operation.
*/
    RETURN (PU_CANCEL);
END;


ON DBEvent 'SOA_Card_Control_Taken',
ON DBEvent 'FMS_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
