**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          SDS_Station
**
**  10/26/07    em  Updated to prevent station prefix from being reused;
**                  If no station prefix exists, look for grouping to another 
**                  "Macro" station and use it.
*/
METHOD StationUpd (
)=
DECLARE
   CurrentCounter 	= INTEGER NOT NULL;
   CurrentDate  	= DATE NOT NULL;
   CurrentYear 		= INTEGER NOT NULL;
   MacroExists          = INTEGER NOT NULL WITH DEFAULT;
   RetCode              = INTEGER NOT NULL;
   StationName          = VARCHAR(40) NOT NULL WITH DEFAULT;
   Station              = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/* 
** Call database procedure to update or insert Station information.
** Year must equal current year.  If current year exists in table, 
** then confirm new counter is greater than or equal to existing counter.
*/
   CurrentDate = 'now';
   CurrentYear = DATE_PART('year',CurrentDate);

   IF CurObject.PermitYear <> CurrentYear THEN
      CurMethod.Trace (Text =  'Class: SDS_Station; Method: StationUpd; ' + 
              'PermitYear parameter must match current year.');
      CurObject.ErrorText = 'PermitYear parameter must match current year.';
      RETURN -1;
   ENDIF;
/*
** If station part of Macro, use macro.
*/ 
   Station = 0;
   SELECT :Station = G.Grouping
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET
   WHERE  G.Member = :CurObject.Station AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = ET.Type AND
          ET.SuperType = :Type$SteamGenStation; 

   IF Station <> 0 THEN
      CurObject.Station = Station;
   ENDIF;

   StationName = '';
   Station = 0;
   SELECT :StationName = O.Name,
          :Station = O.Object
   FROM   SDS_Station S,
          Udb_Object O
   WHERE  S.Station = O.Object AND
          S.Station <> :CurObject.Station AND
          S.StationID = :CurObject.StationID;

   IF StationName <> '' THEN
/*
** Check if station is a member of station where ID is used.
*/
      MacroExists = 0;
      SELECT :MacroExists = 1
      FROM   Udb_Grouping G
      WHERE  G.Member = :CurObject.Station AND
             G.Relationship = :Interaction$MemberOf AND
             G.Grouping = :Station; 

      IF MacroExists = 1 THEN
         CurObject.Station = Station;
      ELSE
         CurMethod.Trace (Text = 'Class: SDS_Station; Method: StationUpd; ' + 
                                 'Station ID already in use.');
         CurObject.ErrorText = 'Station ID "' + CurObject.StationID + 
                   '" is already in use for station ' + StationName + '.';
         RETURN -1;
      ENDIF;
   ENDIF;

   SELECT :CurrentCounter = PermitCounter
   FROM   SDS_Station
   WHERE  Station = :CurObject.Station;

   IF CurObject.PermitCounter < CurrentCounter THEN
      CurMethod.Trace (Text = 'Class: SDS_Station; Method: StationUpd; ' + 
              'PermitCounter cannot be rolled back.');
      CurObject.ErrorText = 'PermitCounter cannot be rolled back.';
      RETURN -1;
   ENDIF;

   RetCode = CALLPROC SDS_StationUpd (
                PermitCounter = CurObject.PermitCounter,
                PermitYear = CurObject.PermitYear,
                Station = CurObject.Station,
                StationID = CurObject.StationID );

   IF RetCode = 0 THEN
      CALLPROC DDB_COMMIT;
      RETURN 0;
   ELSE
      CALLPROC DDB_ROLLBACK;
      CurMethod.Trace (Text = 'Class: SDS_Station; Method: StationUpd; ' + 
              'Station Update Failed.');
      CurObject.ErrorText = 'Station Update Failed';
   ENDIF;
END;         
      
   
METHOD GetPermitID (
)=
DECLARE
   CurrentCounter 	= INTEGER NOT NULL;
   CurrentDate  	= DATE NOT NULL;
   CurrentYear 		= INTEGER NOT NULL;
   PermitYear           = INTEGER NOT NULL;
   Year2                = CHAR(2) NOT NULL;
   RetCode              = INTEGER NOT NULL;
   Station              = INTEGER NOT NULL WITH DEFAULT;
BEGIN
/* 
** Build Work Permit ID and pass it back.  If Current is not the
** same as the one in the database, then update database for the next year.
*/
   CurrentDate = 'now';
   CurrentYear = DATE_PART('year',CurrentDate);

   CurObject.StationID = '';
   CurObject.PermitYear = 0;
/*
** If station part of Macro, use macro.
*/ 
   Station = 0;
   SELECT :Station = G.Grouping
   FROM   Udb_Grouping G,
          Udb_ExtendedType ET
   WHERE  G.Member = :CurObject.Station AND
          G.Relationship = :Interaction$MemberOf AND
          G.GroupingType = ET.Type AND
          ET.SuperType = :Type$SteamGenStation; 

   IF Station <> 0 THEN
      CurObject.Station = Station;
   ENDIF;

   SELECT  :CurObject.StationID = StationID,
           :CurObject.PermitYear = PermitYear,
           :CurObject.PermitCounter = PermitCounter
   FROM    SDS_Station
   WHERE   Station = :CurObject.Station;

   IF CurObject.StationID = '' THEN  
         MESSAGE 'Class: SDS_Station; Method: GetPermitID; ' + 
                 'Station Information has not yet been entered for Station ' +
                 VARCHAR(CurObject.Station);
         RETURN -1;
   ENDIF;

   IF CurObject.PermitYear < CurrentYear THEN
/*
** Update to this year, start counter at one.
*/
      RetCode = CALLPROC SDS_StationUpd (
                PermitCounter = 1,
                PermitYear = CurrentYear,
                Station = CurObject.Station,
                StationID = CurObject.StationID );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
         Year2 = RIGHT(VARCHAR(CurrentYear),2);
         CurObject.NextPermitID = CurObject.StationID + '-' + Year2 + '-1';
         RETURN 0;
      ELSE
          CALLPROC DDB_ROLLBACK;
          MESSAGE 'Class: SDS_Station; Method: GetPermitID; ' + 
              'Station Permit Year Update Failed.';
         RETURN -1;
      ENDIF;

   ELSE

      CurObject.PermitCounter = CurObject.PermitCounter + 1;

      RetCode = CALLPROC SDS_StationUpd (
                PermitCounter = CurObject.PermitCounter,
                PermitYear = CurObject.PermitYear,
                Station = CurObject.Station,
                StationID = CurObject.StationID );

      IF RetCode = 0 THEN
         CALLPROC DDB_COMMIT;
         Year2 = RIGHT(VARCHAR(CurObject.PermitYear),2);
         CurObject.NextPermitID = CurObject.StationID + '-' + Year2 + '-' + 
                                  VARCHAR(CurObject.PermitCounter);
         RETURN 0;
      ELSE
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Class: SDS_Station; Method: GetPermitID; ' + 
              'Station Permit Counter Update Failed.';
         RETURN -1;
      ENDIF;
   ENDIF;
      
END;         


METHOD SelectStation (
) =
BEGIN
   CurObject.StationID = '';
   SELECT  :CurObject.StationID = StationID,
           :CurObject.PermitCounter = PermitCounter,
           :CurObject.PermitYear = PermitYear
   FROM    SDS_Station
   WHERE   Station = :CurObject.Station;

   IF CurObject.StationID = '' THEN
/*
** Check if member of another.
*/
      SELECT  :CurObject.StationID = S.StationID,
              :CurObject.PermitYear = S.PermitYear,
              :CurObject.PermitCounter = S.PermitCounter
      FROM    SDS_Station S,
              Udb_Grouping G
      WHERE   G.Member = :CurObject.Station AND
              G.Relationship = :Interaction$MemberOf AND
              G.Grouping = S.Station;

      IF CurObject.StationID = '' THEN
/*
** Station Details Do Not Exist
*/    
         RETURN -1;
      ENDIF;
   ELSE
      RETURN 0;
   ENDIF;
END;      

