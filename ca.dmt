Application Component Report
============================

	Name:            PromptOpenConnectedATS

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          PromptOpenConnectedATS          
**
**  Modifications:
**	06/10/93 em	Created 
**  07/07/94 em added return code processing
**  11/07/02 em     J to JIP
*/
INITIALIZE                         
(
    JIP = JobInProgress;			/* Job being processed */

    RetCode = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER;
    ATS = ARRAY OF ObjectSummaryClass;
) =
BEGIN
/*
**  Using connectivity in Database, find object(s) on same side
*/ 
  i = 1;
  SELECT :ATS[i].Object = T2.Object
  FROM   Udb_Terminal T1,
         Udb_Terminal T2
  WHERE  T1.Object = :JIP.Equip AND
         T1.Terminal = 2 AND      /* Terminal 2 */
         T1.Node >= 20000 AND         /* Included for performance */
         T1.Node = T2.Node AND
         T2.Node >= 20000 AND         /* Included for performance */
         T2.Terminal = 2 AND          /* Terminal 2 */
         T2.Object <> T1.Object
  BEGIN
     i = i + 1;
  END;

  i = 1;
  WHILE i <= ATS.LastRow() DO

    RetCode = CALLPROC SetStatus (Object = ATS[i].Object,
                        Status = Status$Open);
    IF RetCode = PU_CANCEL THEN
        CALLPROC DDB_ROLLBACK;
        RETURN (PU_CANCEL);
    ENDIF;
    i = i + 1;
  ENDWHILE;

  RETURN (PU_OK);

END;

Application Component Report
============================

	Name:            PromptOpenISOValve

/*
**
**	Copyright c 2007 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:   Steam
**  Frame:         PromptOpenISOValve
**
**  Modifications:
**  01/22/08   em  Created from PromptCloseISOValve
**  01/23/08   em  Change Street trace to go one deep only.  The Primary Isolation
**                 valve must be directly connected to a Street Valve.  Any street valves
**                 found after the first connected select will be ignored.
**  02/11/08   em  Remove message when terminal 2 not connected.
**  06/23/09   em  Implement changes made in CloseISOValve in support of ER Macro.
**  02/12/13   em  Use ExtendedType to capture Tunnel Main
*/

INITIALIZE
(
    JIP = JobInProgress;                /* Job being processed */
    Cnt = INTEGER;  
    GenStation = INTEGER NOT NULL WITH DEFAULT;
    i = INTEGER NOT NULL WITH DEFAULT;
    j = INTEGER NOT NULL WITH DEFAULT;
    MacroStation = INTEGER NOT NULL WITH DEFAULT;
    Mains = ARRAY OF Main; 
    MainClosed = INTEGER NOT NULL WITH DEFAULT;
    MainStillOpen = INTEGER NOT NULL WITH DEFAULT;
    ClosedMainExists = INTEGER NOT NULL WITH DEFAULT;
    RetCode = INTEGER NOT NULL WITH DEFAULT;
    StationValves = ARRAY OF Valve;
) =
DECLARE
   ConnectivityTrace  =	PROCEDURE RETURNING INTEGER;
   ScopeCheck	      = PROCEDURE;
ENDDECLARE
BEGIN
/* 
** Is the valve in a station?
*/
   ClosedMainExists = FALSE;
   GenStation = 0;
   REPEATED
   SELECT  :GenStation = Grouping
   FROM    Udb_Grouping
   WHERE   GroupingType IN (SELECT Type FROM Udb_ExtendedType
                            WHERE  SuperType = :Type$SteamGenStation) AND
           Relationship = :Interaction$MemberOf AND
           Member = :JIP.Equip;

   IF GenStation = 0 THEN
      RETURN PU_OK;
   ENDIF;
/*
** If in East River, get Macro Station before looking for Mains.
*/
   MacroStation = 0;
   SELECT :MacroStation = Grouping
   FROM    Udb_Grouping 
   WHERE   Member = :GenStation AND
           Relationship = :Interaction$MemberOf AND
           GroupingType = :Type$SteamGenStation;

   IF MacroStation <> 0 THEN
      GenStation = MacroStation;
   ENDIF;  
/*
** Select all Mains in this station
*/
   Mains.Clear();
   i = 1;
   SELECT  :Mains[i].Object = Member
   FROM    Udb_Grouping 
   WHERE   Grouping = :GenStation AND
           Relationship = :Interaction$MemberOf AND
           MemberType IN (SELECT Type FROM Udb_ExtendedType
                          WHERE  SuperType = :Type$Main)
   BEGIN
      i = i + 1;
   END;
/*
** For each main, get the ISOValve status
** For closed mains, get list of ISO Valve and their status
*/
   FOR i = 1 TO Mains.LastRow() DO
      Mains[i].ISOValveStatus = 0;  /* MAIN: 0=Open, 1=Closed */
      SELECT :Mains[i].ISOValveStatus = 1
      FROM   FMS_ObjectStatus
      WHERE  Object = :Mains[i].Object AND
             Status = :Status$ISOValveClosed AND
             StatusCount > 0;

      IF Mains[i].ISOValveStatus = 1 THEN
         ClosedMainExists = TRUE;
         j = 1;
         REPEATED
         SELECT  :Mains[i].ISOValve[j].Object = G.Member,
                 :Mains[i].ISOValve[j].ValveStatus = S.CurrentlyOpen
         FROM    Udb_Grouping G,
                 Udb_Switch S
         WHERE   G.Grouping = :Mains[i].Object AND
                 G.Relationship = :Interaction$SourcePosition AND
                 G.Member = S.Object
         BEGIN 
            j = j + 1;
         END;
      ENDIF;    
   ENDFOR;
/*
** Select list of valves in the station with each valve's status,
** To be used for trace scope and open/closed checks.
*/
   IF ClosedMainExists = FALSE THEN
      RETURN PU_OK;
   ENDIF;

   StationValves.Clear();
   j = 1;
   IF MacroStation = 0 THEN
      REPEATED             
      SELECT
      DISTINCT  :StationValves[j].Object = G.Member,
                :StationValves[j].ValveStatus = S.CurrentlyOpen  /*VALVE: 0=Closed, 1=Open*/
      FROM    Udb_Grouping G,
              Udb_Switch S
      WHERE   G.Grouping = :GenStation AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE  SuperType = :Type$Valve) AND
              G.Member = S.Object
      ORDER BY 1
      BEGIN 
         j = j + 1;
      END;
   ELSE
      REPEATED             
      SELECT
      DISTINCT  :StationValves[j].Object = G.Member,
                :StationValves[j].ValveStatus = S.CurrentlyOpen  /*VALVE: 0=Closed, 1=Open*/
      FROM    Udb_Grouping G,
              Udb_Grouping G2,
              Udb_Switch S
      WHERE   G2.Grouping = :MacroStation AND
              G2.Relationship = :Interaction$MemberOf AND
              G2.MemberType = :Type$SteamGenStation AND
              G2.Member = G.Grouping AND
              G.Relationship = :Interaction$MemberOf AND
              G.MemberType IN (SELECT Type FROM Udb_ExtendedType
                               WHERE  SuperType = :Type$Valve) AND
              G.Member = S.Object
      ORDER BY 1
      BEGIN 
         j = j + 1;
      END;
   ENDIF;
/*
** For each closed Main, look at valve status of each ISO valve, if open
** commence trace from that valve looking for closed valves on each path.
*/
   FOR i = 1 TO Mains.LastRow() DO
      IF Mains[i].ISOValveStatus = 1 THEN  /*Main Closed */
         MainClosed = TRUE; 
         FOR j = 1 TO Mains[i].ISOValve.LastRow() DO  
            IF Mains[i].ISOValve[j].ValveStatus = 0 THEN  /*ISO Closed*/
               MainClosed = TRUE;
            ELSE 
               MainClosed = FALSE;
               RetCode = CALLPROC ConnectivityTrace (
                                       StartValve = Mains[i].ISOValve[j].Object);
               IF RetCode = PU_OK THEN 
                  MainClosed = TRUE;
               ELSE
                  ENDLOOP;
               ENDIF;
            ENDIF;
         ENDFOR;

         IF MainClosed = FALSE THEN
            RetCode = CALLPROC FMS_ObjStatDel (
                        Object = Mains[i].Object,
                        Status = Status$ISOValveClosed);
            IF RetCode = 0 THEN
               CALLPROC DDB_COMMIT;
            ELSE
               CALLPROC DDB_ROLLBACK;
               MESSAGE 'ERROR removing ISO Valve Status for Main ' + VARCHAR(Mains[i].Object);
            ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;

   RETURN(PU_OK);
END;
/*
** Connectivity Trace Procedure.  If street side is found, ignore that entire terminal.
** If any path ends Open, then Main is Open.  RETURN PU_OK if all paths closed.
*/
PROCEDURE ConnectivityTrace (
   StartValve 	= INTEGER NOT NULL
)=
DECLARE
    x              = INTEGER NOT NULL;    /*counter*/
    k              = INTEGER NOT NULL;    /*counter*/
    o              = INTEGER NOT NULL;    /*counter*/

    OpenedPaths     = INTEGER NOT NULL;
    ClosedPaths     = INTEGER NOT NULL;
    PrevClosedPaths = INTEGER NOT NULL;

    Operator         = INTEGER;  /*Operator to use for pending status check*/
    MoreObjects      = INTEGER NOT NULL WITH DEFAULT;                            
    FloatFound       = INTEGER NOT NULL WITH DEFAULT; 
    StreetFound       = INTEGER NOT NULL WITH DEFAULT; 

    StaticWhereClause  = VARCHAR(300) NOT NULL WITH DEFAULT;
    DynamicWhereClause = VARCHAR(1300) NOT NULL WITH DEFAULT;

    ExcludedNodes   = Array of IntegerObject;
    IncludedObjects = Array of IntegerObject;

    FloatEquip     = ConnectedEquipClass;
    ClosedOutBnd   = ConnectedEquipClass;
    TempEquip      = ARRAY OF ConnectedEquipClass;
    ConnectedEquip = ARRAY OF ConnectedEquipClass;
    FdrLoadFeeder  = VARCHAR(40) NOT NULL WITH DEFAULT;
    FdrLoadObject  = INTEGER NOT NULL WITH DEFAULT;
    StatusDBF      = INTEGER NOT NULL WITH DEFAULT;

    CardObjects    = ARRAY OF INTEGEROBJECT; /*Scope of Card*/
    ConnectedScope = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
    StreetDepth    = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
/*
** Make sure start device is connected.
*/
    ConnectedEquip.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :StartValve AND
           O.Object = T.Object AND
           T.Node > 0;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN(PU_CANCEL);
    ENDIF;

    ConnectedEquip[1].Used = FALSE;

    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';

    DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(StartValve) + 
                         ') AND T1.Terminal = 1' ;

#INCLUDE ValveIsolationTrace
/*
** If street found on this side, then we turn to other terminal.  If no Street Found,
** then we assume we went into the station and return the current ISO Valve status.
*/
    IF StreetFound = FALSE THEN
       IF OpenedPaths > 0 THEN
          RETURN (PU_CANCEL);
       ELSE
          RETURN (PU_OK);
       ENDIF;
    ENDIF; 
/*
** Start over for terminal 2.
*/
    ConnectedEquip.Clear();
    IncludedObjects.Clear();
    ExcludedNodes.Clear();
    REPEATED
    SELECT :ConnectedEquip[1].Object = O.Object,
           :ConnectedEquip[1].Type = O.Type,
           :ConnectedEquip[1].Name = O.Name,
           :ConnectedEquip[1].PrimaryGrouping = O.PrimaryGrouping,
           :ConnectedEquip[1].PrimaryGroupingName = O.PrimaryGroupingName
    FROM   Udb_Object O,
           Udb_Terminal T
    WHERE  O.Object = :StartValve AND
           O.Object = T.Object AND
           T.Node > 0 AND
           T.Terminal = 2;
/* 
** if equipment is not connected, then no need to do a connectivity check 
*/
    IF ConnectedEquip.LastRow() = 0 THEN
       RETURN(PU_CANCEL);
    ENDIF;

    ConnectedEquip[1].Used = FALSE;

    StaticWhereClause = 'T2.Object = O.Object AND ' +
                        'T2.Object <> T1.Object AND ' +
                        'T2.Node > 20000 AND ' +
                        'T1.Node = T2.Node AND ' +
                        'T1.Node > 20000 AND ';

    DynamicWhereClause = StaticWhereClause + 
                         'T1.Object IN (' + VARCHAR(StartValve) + 
                         ') AND T1.Terminal = 2' ;

#INCLUDE ValveIsolationTrace
/*
** If street found on this side, then we turn to other terminal.  If no Street Found,
** then we assume we went into the station and return the current ISO Valve status.
*/
    IF StreetFound = FALSE THEN
       IF OpenedPaths > 0 THEN
          RETURN (PU_CANCEL);
       ELSE
          RETURN (PU_OK);
       ENDIF;
    ELSE
       MESSAGE 'Error in connectivity Trace, found Street Valve on both sides of Isolation Valve.';
       RETURN (PU_CANCEL);
    ENDIF; 
END;


PROCEDURE ScopeCheck (
   Valve 	= INTEGER NOT NULL,
   InScope      = INTEGER NOT NULL WITH DEFAULT;
   CurrentlyOpen  = INTEGER NOT NULL WITH DEFAULT;
) =
DECLARE
   z 	= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   InScope = FALSE;
   CurrentlyOpen = TRUE;

   FOR z = 1 TO StationValves.LastRow() DO

      IF Valve = StationValves[z].Object THEN
         InScope = TRUE;
         CurrentlyOpen = StationValves[z].ValveStatus;
         ENDLOOP;
      ENDIF;

   ENDFOR;
END;   
  

