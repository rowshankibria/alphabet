	Name:            NoteClass


Application Component Report
============================

	Name:            Notice

/*
**
**	Copyright c 2020 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software LLC. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          Notice
**
**  03/05/20  ysp   Created from Warning
*/
INITIALIZE
(
/* passed in */
    Card = INTEGER NOT NULL;
    SwitchingItem = INTEGER;           /*Nullable*/
    Job = INTEGER;                     /*Nullable*/
    Text = Varchar(512) NOT NULL;	   /* Warning text */
) =
DECLARE
    i             = INTEGER NOT NULL;
    RetCode       = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CardID = Card;
   MoveID = IFNULL(Job, 0);
   IF Job IS NOT NULL THEN
      SELECT :EquipID = Equip
      FROM   SOA_Job
      WHERE  Job = :Job;
   ENDIF;

   WarningText = Text;
END;

/*
**	Handle a No click
*/
ON Click NoButton =
BEGIN
   RETURN (PU_CANCEL);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            NotificationCutout

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          NotificationCutOut 
**
**  Modifications:
**   05/21/02   pkw   Created 
**   11/10/03   ysp   If an OEM supply feeder, send a message to CIG.
**   02/18/04   em    Convert Message to TraceError Call
**   07/13/05   pkw   Add Westchester OEM message by select object
**                    type into message.
**   02/16/07   em    Add Update message for when CutOut timestamp is updated
**   03/24/11   em    Converted for 3G
**   12/20/12   em    Changed feeder count to only include actual feeders, exclude subtypes.
**   01/17/12   em    Exclude 3G feeders that are not primary grouped to the substation
**   02/03/15   em    Add card class name to CIG and DCC messages     
**   09/04/19   pkw   Keep track on multi-feeder outages in network   
**   09/06/19   ysp   Add CIG notification railroad feeder outage
**   10/15/19   ysp   Add DB event FMS_MTAAnalysis to Task Monitor if a feeder supplying a  
**                    subway line is cut out.
**   10/29/20   em    Add MTA Contingency comment to CIG rail outage note.
**   11/04/20   em    Modify style of CIG rail outage note so lines appear once only.
*/
PROCEDURE  NotificationCutOut 
(   /* Passed parameters */
    pCard          = INTEGER     NOT NULL;
    pCardClass     = INTEGER     NOT NULL;
    pCardClassName = VARCHAR(40) NOT NULL;
    pCutOut        = DATE;
    pFeeder        = INTEGER     NOT NULL;
    pFeederName    = VARCHAR(40) NOT NULL;
    IsThisAnUpdate = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm sent from Feedercard*/

    /* Local parameters */    
    DccMsg = VARCHAR(500) NOT NULL; 
    DccRegion = VARCHAR(20) NOT NULL;
    m = INTEGER NOT NULL;       /* counter variable */  
    MsgTxt = Varchar(2000) NOT NULL;     /* CIG text */
    MTAMsg = MTAContingency_ASE;
    MTACutOut = INTEGER NOT NULL WITH DEFAULT;
    NetWorkObject = INTEGER NOT NULL; 
    NetWorkName = VARCHAR(40) NOT NULL; 
    OEMTypeName = VARCHAR(200) NOT NULL WITH DEFAULT;
    OtherCards = ARRAY OF FMS_Card; /* Other cards that are out of service */  
    RetCode = INTEGER NOT NULL;
    RailCustomer = VARCHAR(2000) NOT NULL WITH DEFAULT;
    TempChar = VARCHAR(20) NOT NULL; 
    TempName = VARCHAR(40) NOT NULL; 
) =
BEGIN
/*
**  Send CSD message to CIG if condition exists.  
*/
   /* Don't send if cardtype FOT */
   IF pCardClass = Type$FOT THEN
      RETURN;
   ENDIF;
   
   /* Set TempChar to use for CIG and DCC popups */
   IF date_part('min',pCutOut) < 10 THEN
      TempChar = '0';
   ELSE
      TempChar = '';
   ENDIF;

   IF IsThisAnUpdate = TRUE THEN
      MsgTxt = 'Feeder ' + pFeederName + 
               ' CutOut time has been updated to ' +
            VARCHAR(date_part('month',pCutOut)) + '/' +
            VARCHAR(date_part('day',pCutOut)) + ' ' +
            VARCHAR(date_part('Hour',pCutOut)) + ':' + TempChar +
            VARCHAR(date_part('min',pCutOut)) + '.';
   ENDIF;

   /* See if feeder part of network */
   NetWorkObject = 0;
   REPEATED
   SELECT :NetWorkName = O.Name,
          :NetWorkObject = O.Object
   FROM   UDB_OBJECT O,      /*Network*/
          UDB_GROUPING G,
          Udb_Object O2,     /*Feeder*/
          Udb_Object O3      /*Feeder Primary Grouping = Substation?*/
   WHERE  G.Member = :pFeeder and
          G.Relationship = :Interaction$MemberOf and
          G.GroupingType = :Type$Network and
          O.Object = G.Grouping AND               
          O2.Object = G.Member AND
          O2.PrimaryGrouping = O3.Object AND
          O3.Type IN (SELECT Type FROM Udb_ExtendedType 
                      WHERE  SuperType = :Type$Substation);
         
   IF NetworkObject <> 0 THEN
      /* Get the names of other feeders that are out, only ones that are primary grouped to substation */
      m = 1;
      OtherCards.Clear();
      REPEATED
      SELECT :OtherCards[m].FeederName = O.Name,
             :OtherCards[m].CardClassName = C.CardClassName,
             :OtherCards[m].CutOut = C.Cutout
      FROM   Udb_Object O,      /*Feeder*/
             Udb_Object O2,     /*Feeder Primary Grouping = Substation?*/
             Udb_Grouping G,
             TFMS_CardToObject CTO,
             FMS_Card C
      WHERE  G.Grouping = :NetWorkObject AND
             G.Relationship= :Interaction$MemberOf AND
             G.MemberType = :Type$Feeder AND
             G.Member = CTO.Object AND
             CTO.Card = C.Card AND
             C.Status < :Card$Closed AND
             CTO.Object <> :pFeeder AND
             C.Cutout IS NOT NULL AND C.Cutin IS NULL AND
             CTO.Object = O.Object AND
             O.PrimaryGrouping = O2.Object AND
             O2.Type IN (SELECT Type FROM Udb_ExtendedType 
                         WHERE  SuperType = :Type$Substation)
      BEGIN
         IF date_part('min',OtherCards[m].CutOut) < 10 THEN
            OtherCards[m].Position = '0';
         ELSE
            OtherCards[m].Position = '';
         ENDIF;
         m = m + 1;
      END;
         
      IF OtherCards.LastRow() <> 0 THEN
         /* Get number of feeders in Network that are primary grouped to substation */
         REPEATED
         SELECT :m = COUNT(*) 
         FROM   Udb_Object O,      /*Feeder*/
                Udb_Object O2,     /*Feeder Primary Grouping = Substation?*/
                Udb_Grouping G
         WHERE  G.Grouping = :NetWorkObject AND
                G.Relationship = :Interaction$MemberOf AND
                G.MemberType = :Type$Feeder AND
                G.Member = O.Object AND
                O.PrimaryGrouping = O2.Object AND
                O2.Type IN (SELECT Type FROM Udb_ExtendedType 
                            WHERE  SuperType = :Type$Substation);

         IF IsThisAnUpdate = FALSE THEN
            MsgTxt = VARCHAR(OtherCards.LastRow() + 1) + ' of ' + VARCHAR(m) + 
                 ' Feeders in ' + NetworkName + ' are out. Feeder ' + 
                 pFeederName + ' just went out of service at ' + 
                 VARCHAR(date_part('month',pCutOut)) + '/' +
                 VARCHAR(date_part('day',pCutOut)) + ' ' +
                 VARCHAR(date_part('Hour',pCutOut)) + ':' + TempChar +
                 VARCHAR(date_part('min',pCutOut)) +
                 ' for reason ' + pCardClassName + 
                 '. Other feeders that are out: ';

            FOR m = 1 to OtherCards.LastRow() DO
              MsgTxt = MsgTxt + '(' + OtherCards[m].FeederName + '-' +
                OtherCards[m].CardClassName + '-' + 
                VARCHAR(date_part('month',OtherCards[m].Cutout)) + '/' +
                VARCHAR(date_part('day',OtherCards[m].Cutout)) + ' ' +
                VARCHAR(date_part('Hour',OtherCards[m].Cutout)) + ':' + 
                OtherCards[m].Position + 
                VARCHAR(date_part('min',OtherCards[m].Cutout)) + ') ';
            ENDFOR;
         ENDIF;
/*
**  Send message to CIG 
*/            
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                 ,MessageText = MsgTxt
                 ,Time = date('now')
                 ,Priority = 1
                 ,MessageType = 0
                 ,Card = pCard);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Could not send automated ' +
                  'message to CIG.  Please contact CIG verbally to let ' +
                  'them know a network contingency exists.',
                     TraceMessage = 'Could not send automated ' +
                  'network contingency message to CIG.' 
                  );
         ENDIF;
         CALLPROC DDB_COMMIT;
         /*
         **  Insert row in fms_networkoutage table to track multiple feeder outages.
         */
         RetCode = CALLPROC FMS_NetworkOutageIns(Network = NetworkObject);
         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (UserMessage =
               'WARNING: Could not insert row into network outage table to track multiple feeder outage in ' +
                NetworkName + '.  Please inform staff to insert ' +
               varchar(NetworkObject) + ' into the fms_networkobject table.',
                         TraceMessage =
               'NotificationCutout: ' +
               'Could not insert row into network outage table to track multiple feeder outage in ' +
                NetworkName + '.  Please insert ' +
               varchar(NetworkObject) + ' into the fms_networkobject table.'
                         );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
**  Send a message to DCC to notify of cutout. 
*/
   IF IsThisAnUpdate = FALSE THEN
      DccMsg = 'Feeder ' + pFeederName + ' cutout ' + 
               pCardClassName + ' at ' + 
            VARCHAR(date_part('month',pCutOut)) + '/' +
            VARCHAR(date_part('day',pCutOut)) + ' ' +
            VARCHAR(date_part('Hour',pCutOut)) + ':' + TempChar +
            VARCHAR(date_part('min',pCutOut));
   ELSE
      DccMsg = MsgTxt;
   ENDIF;
   /*
   **  Determine which regions to send message.
   */
   DccRegion = '';
   /* shift 1 char to get rid of d in division user. */
   SELECT DISTINCT
          :DccRegion = shift(O.Name,-1)
   FROM    Udb_Object O,
           Udb_Grouping G,
           Udb_Grouping GG
   WHERE   G.Member = :pFeeder AND
           G.Relationship = :Interaction$MemberOf AND
           G.GroupingType = :Type$Division AND
           G.Grouping = GG.Member AND
           GG.Relationship = :Interaction$MemberOf AND
           GG.GroupingType = :Type$Region AND
           GG.Grouping = O.Object
   BEGIN
      RetCode = CALLPROC CSD_MessageIns(DeskType = 'dcc_' + DccRegion
                                       ,MessageText = DccMsg
                                       ,Time = date('now')
                                       ,Priority = 0
                                       ,MessageType = 0
                                       ,Card = pCard);
      IF RetCode <> 0 THEN
         CALLPROC DDB_ROLLBACK;
         CALLPROC TraceError (
                     UserMessage = '',
                     TraceMessage = 'Automated DCC message ' +
                  'not sent for ' + pFeederName + ' regarding: ' + DccMsg
                  );
      ENDIF;
      CALLPROC DDB_COMMIT;
   END;  
/*
** If the feeder is a supply feeder from OEM, send a message to CIG
*/
   OEMTypeName = '';
   REPEATED
   SELECT :OEMTypeName = O.Description
   FROM   UDB_GROUPING G,
          Udb_Object O
   WHERE  G.Member = :pFeeder and
          G.Relationship = :Interaction$MemberOf and
          G.GroupingType = :Type$OEMFeeder AND
          G.Grouping = O.Object;

   IF OEMTypeName <> '' THEN
      IF IsThisAnUpdate = FALSE THEN

         MsgTxt = OEMTypeName + ' ' + pFeederName + 
            ' cutout ' + pCardClassName + ' at ' + 
            VARCHAR(date_part('month',pCutOut)) + '/' +
            VARCHAR(date_part('day',pCutOut)) + ' ' +
            VARCHAR(date_part('Hour',pCutOut)) + ':' + TempChar +
            VARCHAR(date_part('min',pCutOut));
            
         RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                 ,MessageText = MsgTxt
                 ,Time = date('now')
                 ,Priority = 1
                 ,MessageType = 0
                 ,Card = pCard);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Could not send automated ' +
                  'message to CIG.  Please contact CIG verbally to let ' +
                  'them know a OEM supply feeder is cutout.',
                     TraceMessage = 'Could not send automated ' +
                  'OEM supply out message to CIG.' 
                  );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
/*
** if a feeder supplies MTA, LIRR, MetroNorth or Amtrack
*/
   MTACutOut = FALSE;
   RailCustomer = '';
   SELECT DISTINCT 
          :TempName = O.Name
   FROM   UDB_Grouping G1,
          UDB_Grouping G2,
          UDB_ExtendedType ET,
          UDB_Object O
   WHERE  G1.Grouping = :pFeeder AND 
          G1.RelationShip = :Interaction$MemberOf AND 
          G1.MemberType = ET.Type AND 
          ET.SuperType = :Type$HTVStd AND
          G1.Member = G2.Member AND
          G2.RelationShip = :Interaction$MemberOf AND 
          G2.GroupingType = :Type$MTALine AND           // 10475
          G2.Grouping = O.Object
   ORDER BY Name
   BEGIN
      IF RailCustomer <> '' THEN
         RailCustomer = RailCustomer + ', ';
      ENDIF;
      RailCustomer = RailCustomer + TempName;

      MTACutOut = TRUE;
   END;
   CALLPROC DDB_ROLLBACK;

   IF RailCustomer <> '' THEN
/* This is the 11/04/20 change to not repeat MTA line names unless MTA Contingeny
   has not been saved (like for an Uto card */   
      MTAMsg.Card = pCard;
      MTAMsg.CIGMessage = '';
      MTAMsg.LoadCIGMessage();
      IF MTAMsg.CIGMessage = '' THEN
         RailCustomer = 'subway ' + RailCustomer;
      ELSE
         RailCustomer = 'subway'; 
      ENDIF;  
   ELSE
      SELECT DISTINCT 
             :TempName = UPPERCASE(O.Description)
      FROM   UDB_Grouping G,
             UDB_Object O
      WHERE  G.Grouping = :pFeeder AND 
             G.RelationShip = :Interaction$MemberOf AND 
             G.Member = O.Object AND 
             (UPPERCASE(O.Description) LIKE '%LIRR%' OR
              UPPERCASE(O.Description) LIKE '%METRO NO%' OR
              UPPERCASE(O.Description) LIKE '%AMTRACK%')
      BEGIN
         IF TempName LIKE '%LIRR%' THEN
            RailCustomer = 'LIRR';
         ELSEIF TempName LIKE '%METRO%' THEN
            RailCustomer = 'Metro North';
         ELSEIF TempName LIKE '%AMTRACK%' THEN
            RailCustomer = 'Amtrack';
         ENDIF;
      END;
   ENDIF;
   
   IF RailCustomer <> '' THEN
      IF IsThisAnUpdate = FALSE THEN
         MsgTxt = 'Feeder ' + pFeederName + ' supplying ' + RailCustomer +
            ' cutout ' + pCardClassName + ' at ' + 
            VARCHAR(date_part('month',pCutOut)) + '/' +
            VARCHAR(date_part('day',pCutOut)) + ' ' +
            VARCHAR(date_part('Hour',pCutOut)) + ':' + TempChar +
            VARCHAR(date_part('min',pCutOut));

         IF MTAMsg.CIGMessage <> '' THEN
            MsgTxt = MsgTxt + MTAMsg.CIGMessage;
         ENDIF;

         RetCode = CALLPROC CSD_MessageIns(DeskType = 'cig'
                 ,MessageText = MsgTxt
                 ,Time = date('now')
                 ,Priority = 1
                 ,MessageType = 0
                 ,Card = pCard);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            CALLPROC TraceError (
                     UserMessage = 'ERROR: Could not send automated ' +
                  'message to CIG.  Please contact CIG verbally to let ' +
                  'them know feeder ' + pFeederName + ' supplying ' + RailCustomer + ' is cutout.',
                     TraceMessage = 'Could not send automated cutout message to CIG for ' +
                  'feeder supplying railroad customer.' 
                  );
         ENDIF;
         CALLPROC DDB_COMMIT;
      ENDIF;
   ENDIF;
   
   IF MTACutOut = TRUE THEN
      CALLPROC InsertDBEventQueue(
                    ToApp = 'TASK',
                    EventName = 'FMS_MTAAnalysis',
                    EventText = VARCHAR(pFeeder));  
   ENDIF;
   
   RETURN; 
END;

Application Component Report
============================

	Name:            NotificationsPrompt

/*
**      Copyright c 1996 ESCA Corporation. All Rights Reserved.
**
**      ESCA CORPORATION PROPRIETARY AND TRADE-SECRET INFORMATION.
**      DO NOT COPY OR DISCLOSE TO THIRD PARTIES WITHOUT WRITTEN 
**      PERMISSION FROM AN OFFICER OF ESCA CORPORATION.
*/
/*
**  Application:    FeederCard
**  Frame:          NotificationsPrompt
**
**  Modifications:
**  10/07/96 jfl    Created
**  10/10/96 jfl    Don't allow dynamic insertion of Person-type object
**  10/30/96 jfl    Use Name for department objects instead of description
**  12/03/96 jfl    Display Name and description for Person.
**  01/08/97 jfl    Don't specify RowObject=NULL when inserting a row. 
**                  This fails on Unix systems.
**  03/12/97 jfl    fms202: do not require person name at record creation
**                  time. Allow MB3 on person field to select a person name.
**                  Determine notification state.
**  08/27/97 jfl    fms202: New requirements determined at Con Ed:
**                  - record is created when the frame shows up
**                  - allow deletion of records thru NotRequired button
**                  - exit button: to leave without completing the notification
**                  - automatically exit when completing the last incomplete
**                    notification.
**                  - create button to create additional notifications
**                  - selection fields(dept/person) are now used to update 
**                    the selected notification
** 11/05/02  pkw    Update for FMS Merge.
** 01/13/03  em     Convert LogChange to SOA_LogIns
*/

INITIALIZE
(
    JIP = JobInProgress;          /* P: Job being processed */
    Card = INTEGER NOT NULL;      /* P: Card details */
    ToRs = INTEGER NOT NULL;      /* P: takeout/restore move */
    PrePost = INTEGER NOT NULL;   /* P: jobcheck precheck or job action prompt */
    SelectRow = INTEGER NOT NULL; /* Clicked RowNumber */
    SelectedNotif = INTEGER NOT NULL; /* selected notification record */
    NotifRow = INTEGER NOT NULL;  /* Index of next row for a notification */
    RetCode = INTEGER NOT NULL;   /* local return variable */
    i = INTEGER NOT NULL;        
    k = INTEGER NOT NULL;       
    OldActivity = VARCHAR(60) NOT NULL; /* logged information */
    Match = VARCHAR(40);          /* temporary for Find button */
) =
BEGIN
/*
** Load the department list
*/
    SelectedPerson.Object = -1;
    SelectedPerson.Name = '';
    SelectedPerson.Description = '';
    i = 1;
    SELECT
        SelectDepartment[i].Object = Object,
        SelectDepartment[i].Description = Name
    FROM Udb_Object
    WHERE Type = :Type$Department
    ORDER BY Description
    BEGIN
        i = i + 1;
    END; 
         
/*
** Load the move text into the appropriate field
*/
    IF ToRs = Job$Restore AND JIP.RsMove <> '' THEN
        SelectedMove = JIP.RsMove;
    ELSE
        SelectedMove = JIP.ToMove;
    ENDIF;
/*
** load the pre-existing notifications for that move
*/
    NotifRow = 1;
    SELECT 
        Notification[NotifRow].Card           = :Card,
        Notification[NotifRow].Job            = :JIP.Job,
        Notification[NotifRow].Seq            = N.Seq,
        Notification[NotifRow].ToRs           = :ToRs,
        Notification[NotifRow].PrePost        = :PrePost,
        Notification[NotifRow].Department     = N.Department,
        Notification[NotifRow].Person         = N.Person,
        Notification[NotifRow].Notification   = N.Notification,
        Notification[NotifRow].NotifState     = N.Issued,
        Notification[NotifRow].Compl          = 0,
        Notification[NotifRow].Timestamp      = N.Timestamp
    FROM FMS_Notifications N
    WHERE N.Card = :Card
      AND N.Job  = :JIP.Job
      AND N.PrePost = :PrePost
      AND N.ToRs = :ToRs
      AND N.Issued <> :Notif$Issued

    BEGIN
        IF Notification[NotifRow].Department = -1 THEN
            Notification[NotifRow].Notification = SelectedMove;
        ELSE
            REPEATED
            SELECT Notification[NotifRow].DepartmentName = O.Name
            FROM Udb_Object O  
            WHERE O.Object = :Notification[NotifRow].Department;
        ENDIF;
        IF PrePost = JobCheck$Precheck THEN
            Notification[NotifRow].PrePostText = 'Before';
        ELSE
            Notification[NotifRow].PrePostText = 'After';
        ENDIF;
        IF Notification[NotifRow].TimeStamp IS NOT NULL THEN
            Notification[NotifRow].Compl = 1;
        ENDIF;
        NotifRow = NotifRow + 1;
    END;
    CALLPROC DDB_ROLLBACK;
/*
** update pre-defined notifications to "Pending"
*/
    i = 1;
    WHILE i <= Notification.LastRow() DO
        IF Notification[i].NotifState <> Notif$Pending THEN
            Notification[i].NotifState = Notif$Pending;
            RetCode = CALLPROC FMS_NotificationsUpd(
                          Card = Notification[i].Card,
                          Job = Notification[i].Job,
                          Seq = Notification[i].Seq,
                          PrePost = Notification[i].PrePost,
                          ToRs = Notification[i].ToRs,
                          Department = Notification[i].Department,
                          Person = Notification[i].Person,
                          Notification = Notification[i].Notification,
                          Issued = Notification[i].NotifState,
                          Timestamp = Notification[i].Timestamp);
            IF RetCode = 0 THEN
                CALLPROC DDB_COMMIT;
            ELSE
                CALLPROC DDB_ROLLBACK;
                Message 'Error: Could not update a notification record.';
            ENDIF;
        ENDIF;
        i = i + 1;
    ENDWHILE;
/*
** Highlight first notification in the list 
*/
    SelectedNotif = 1;
    FIELD(Notification[SelectedNotif].DepartmentName).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].PrePostText).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].TimeStamp).IsReverse = TRUE;

END;


On Childentry SelectDepartment =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Deselect eventual selected row
*/
    SelectedPerson.Object = -1;
    SelectedPerson.Name = '';
    SelectedPerson.Description = '';
/*
**  Update row selected
*/
    SelectRow = FIELD(SelectDepartment).CurRow;
    Notification[SelectedNotif].Department = 
                               SelectDepartment[SelectRow].Object; 
    Notification[SelectedNotif].DepartmentName = 
                               SelectDepartment[SelectRow].Description;

/*
** Update the selected notification
*/
    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Card,
                      Job = JIP.Job,
                      Seq = Notification[SelectedNotif].Seq,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = SelectDepartment[SelectRow].Object,
                      Person = Notification[SelectedNotif].Person,
                      Notification = Notification[SelectedNotif].Notification,
                      Issued = Notification[SelectedNotif].NotifState,
                      Timestamp = Notification[SelectedNotif].Timestamp);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Could not update a notification record.';
        RESUME;
    ENDIF;


/*
**  Load Persons of the selected department into the SelectPerson list
*/
    SelectPerson.Clear();
    i = 1;
    SELECT
        SelectPerson[i].Object = O.Object,
        SelectPerson[i].Name = O.Name,
        SelectPerson[i].Description = O.Description
    FROM Udb_Object O,
         Udb_Grouping G
    WHERE O.Object = G.Member 
      AND G.MemberType = :Type$Person
      AND G.Grouping = :SelectDepartment[SelectRow].Object
      AND G.GroupingType = :Type$Department
      AND G.Relationship = :Interaction$Memberof
    BEGIN
        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
END;


On Childentry SelectPerson =
BEGIN
    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    
/*
**  Deselect eventual selected row
*/
    SelectedPerson = NULL;
/*
**  Update row selected
*/
    SelectRow = FIELD(SelectPerson).CurRow;
    SelectedPerson = SelectPerson[SelectRow].Duplicate();
/*
**  Update the notification record
*/
    Notification[SelectedNotif].Person = SelectPerson[SelectRow].Description;

/*
** Reevaluate the notification state and update the record
*/
    CALLPROC FMS_EvalNotifState 
          (Notification = byref(Notification[SelectedNotif]),
                                 InProgress = TRUE );

    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Card,
                      Job = JIP.Job,
                      Seq = Notification[SelectedNotif].Seq,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = Notification[SelectedNotif].Department,
                      Person = Notification[SelectedNotif].Person,
                      Notification = Notification[SelectedNotif].Notification,
                      Issued = Notification[SelectedNotif].NotifState,
                      Timestamp = Notification[SelectedNotif].Timestamp);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Could not update a notification record.';
        RESUME;
    ENDIF;

END;


ON CLICK Find_Btn = 
BEGIN
/*
**  Blank entries are not valid
*/
    IF SelectedPerson.Description = '' THEN
        RESUME;
    ENDIF;
    i = 1;
    Match = uppercase(SelectedPerson.Description) + '%';
    WHILE i <= SelectPerson.LastRow() DO
        IF uppercase(SelectPerson[i].Description) like Match THEN
            ENDLOOP;
        ENDIF;        
        i = i + 1;
    ENDWHILE;
    IF i <= SelectPerson.LastRow() THEN
        FIELD(SelectPerson).ActiveRow = i;
    ELSE
        MESSAGE 'Person not found in the selected Department.';
        SelectedPerson.Description = '';
        RESUME;
    ENDIF;
END;


On Click CreateNotification_Btn = 
BEGIN
/*
**  Create a new record and append it to the list of notifications for this move
**  The dbproc will return the new sequence number (seq).
*/
    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Card,
                      Job = JIP.Job,
                      Seq = 0,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = -1,
                      Person = '',
                      Notification  = SelectedMove;
                      Issued = Notif$Pending,
                      Timestamp = NULL);
    IF RetCode > 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Could not create a notification record.';
        RESUME;
    ENDIF;
/*
** Insert the new notification on top of the list
*/
    Notification.InsertRow (rownumber = 1);
    Notification[1].Card           = Card;
    Notification[1].Job            = JIP.Job;
    Notification[1].Seq            = RetCode;
    Notification[1].ToRs           = ToRs;
    Notification[1].PrePost        = PrePost;
    Notification[1].Department     = -1;
    Notification[1].DepartmentName = '';
    Notification[1].Person         = '';
    Notification[1].Notification   = SelectedMove;
    Notification[1].NotifState     = Notif$Pending;
    Notification[1].Compl          = 0;
    Notification[1].Timestamp      = NULL;
    IF PrePost = JobCheck$Precheck THEN
        Notification[1].PrePostText = 'Before';
    ELSE
        Notification[1].PrePostText = 'After';
    ENDIF;
/*
** reset selection
*/
    i = 1;
    WHILE i <= Notification.LastRow() DO
        FIELD(Notification[i].DepartmentName).IsReverse = FALSE;
        FIELD(Notification[i].PrePostText).IsReverse = FALSE;
        FIELD(Notification[i].TimeStamp).IsReverse = FALSE;
        i = i + 1;
    ENDWHILE;

/*
** highlight new notification
*/
    SelectedNotif = 1;
    FIELD(Notification[SelectedNotif].DepartmentName).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].PrePostText).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].TimeStamp).IsReverse = TRUE;


END;

/*
** Call frame to select a person to notify in the department
*/
ON ChildProperties Notification[*].Person =
BEGIN
    i = FIELD(Notification).WhichRow (cellfield = CurFrame.TriggerField);
    CALLFRAME SelectNotifiablePerson 
                (Department = Notification[i].Department,
                 Person = byref(Notification[i].Person));
/*
** Reevaluate the notification state and update the record
*/
    CALLPROC FMS_EvalNotifState (Notification = byref(Notification[i]),
                                 InProgress = TRUE );

    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Notification[i].Card,
                      Job = Notification[i].Job,
                      Seq = Notification[i].Seq,
                      PrePost = Notification[i].PrePost,
                      ToRs = Notification[i].ToRs,
                      Department = Notification[i].Department,
                      Person = Notification[i].Person,
                      Notification = Notification[i].Notification,
                      Issued = Notification[i].NotifState,
                      Timestamp = Notification[i].Timestamp);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Could not update a notification record.';
        RESUME;
    ENDIF;

END;

ON ChildEntry Notification =
BEGIN
    IF (CurFrame.ReasonCode <> RC_MOUSECLICK) THEN
        RESUME;
    ENDIF;
/*
** reset selection
*/
    i = 1;
    WHILE i <= Notification.LastRow() DO
        FIELD(Notification[i].DepartmentName).IsReverse = FALSE;
        FIELD(Notification[i].PrePostText).IsReverse = FALSE;
        FIELD(Notification[i].TimeStamp).IsReverse = FALSE;
        i = i + 1;
    ENDWHILE;

/*
** highlight selected notification
*/
    SelectedNotif = 
         FIELD(Notification).WhichRow (cellfield = CurFrame.TriggerField); 
    FIELD(Notification[SelectedNotif].DepartmentName).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].PrePostText).IsReverse = TRUE;
    FIELD(Notification[SelectedNotif].TimeStamp).IsReverse = TRUE;

END;


ON ChildSetValue Notification[*].Notification,
ON ChildSetValue Notification[*].Person,
ON ChildSetValue Notification[*].Compl =
BEGIN
/*
** Report update of Notification/Issued fields
*/
    i = FIELD(Notification).WhichRow (cellfield = CurFrame.TriggerField);
    IF Curframe.TriggerField.Name like '%compl%' THEN 
        IF Notification[i].Compl = 0 THEN
            Notification[i].TimeStamp = NULL;
        ELSE
            Notification[i].TimeStamp = 'now';
        ENDIF;
    ENDIF;
/*
** Reevaluate the notification state and update the record
*/
    CALLPROC FMS_EvalNotifState (Notification = byref(Notification[i]),
                                 InProgress = TRUE );

    RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Card,
                      Job = JIP.Job,
                      Seq = Notification[i].Seq,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = Notification[i].Department,
                      Person = Notification[i].Person,
                      Notification = Notification[i].Notification,
                      Issued = Notification[i].NotifState,
                      Timestamp = Notification[i].Timestamp);
    IF RetCode = 0 THEN
        CALLPROC DDB_COMMIT;
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Could not update a notification record.';
        RESUME;
    ENDIF;

/*
** If the last record was completed, force an exit
*/

    IF Curframe.TriggerField.Name like '%compl%' AND 
       Notification[i].Compl <> 0 THEN
       k = 1;
       WHILE k <= Notification.LastRow() DO
           IF Notification[k].Compl = 0 THEN
               RESUME;
           ENDIF;
           k = k + 1;
       ENDWHILE;

       CurFrame.SendUserEvent( eventname = 'ScreenExit' );

    ENDIF;
END;

ON Click NotRequired_Btn =
BEGIN

/*
** Update the Department field to -1 so that the following call to
** delete notification records pickup everything.
*/
    i = 1;
    WHILE i <= Notification.LastRow() DO

        RetCode = CALLPROC FMS_NotificationsUpd(
                      Card = Card,
                      Job = JIP.Job,
                      Seq = Notification[i].Seq,
                      PrePost = PrePost,
                      ToRs = ToRs,
                      Department = -1,
                      Person = Notification[i].Person,
                      Notification = Notification[i].Notification,
                      Issued = Notification[i].NotifState,
                      Timestamp = Notification[i].Timestamp);
        IF RetCode = 0 THEN
            CALLPROC DDB_COMMIT;
        ELSE
            CALLPROC DDB_ROLLBACK;
            Message 'Error: Could not update a notification record.';
            RESUME;
        ENDIF;
        i = i + 1;
    ENDWHILE;


/*
** Delete the notification records and exit the screen 
*/
    RetCode = CALLPROC FMS_NotificationsDel (Card = Card,
                                             Job = JIP.Job,
                                             ToRs = ToRs,
                                             PrePost = Prepost);
    IF RetCode >= 0 THEN
        CALLPROC DDB_COMMIT;   
    ELSE
        CALLPROC DDB_ROLLBACK;
        Message 'Error: Unable to delete notification records.';
    ENDIF;
    CurFrame.SendUserEvent( eventname = 'ScreenExit' );
END;

ON USEREVENT 'ScreenExit',
ON Click Exit_Btn =
BEGIN
/*
** Log that we were prompted for creating/updating a notification
*/
    OldActivity = 'Prompt for notification ';
    IF PrePost = JobCheck$Precheck THEN
        OldActivity  = OldActivity + 'before';
    ELSE
        OldActivity  = OldActivity + 'after';
    ENDIF;
    IF ToRs <> Job$Restore THEN
        OldActivity  = OldActivity + ' TO';
    ELSE
        OldActivity  = OldActivity + ' RS';
    ENDIF;

    RetCode = CALLPROC SOA_LogIns (
                    Card            = Card
                  , Job             = JIP.Job
                  , SwitchingItem   = JIP.SwitchingItem
                  , Time            = DATE('now')
                  , UserName        = UserName
                  , Item = 'Notification'
                  , Old  = OldActivity
                  , New  = '');
     
    IF RetCode < 0 Then
       CALLPROC DDB_ROLLBACK;
       Message 'Unable to Log confirmation.  Please contact technical support.' + 
            HC_NEWLINE +
            'Card: ' + HC_TAB + VARCHAR(Card) + HC_NEWLINE + 
            'Job: '  + HC_TAB + VARCHAR(JIP.Job) + HC_NEWLINE +
            'Item: ' + HC_TAB + 'Notification' + HC_NEWLINE + 
            'Old: '  + HC_TAB + OldActivity    + HC_NEWLINE + 
            'New: '  + HC_TAB + '';
    ENDIF;
    CALLPROC DDB_COMMIT;

    FCFrame.SendUserEvent( eventname = 'handlenotifications' );
    RETURN (PU_OK);
END;


ON WindowClose =
BEGIN
    RESUME;
END;


Application Component Report
============================

	Name:            OAPlusCheckWPIssue

/*
**
**	Copyright c 2003 Pateric Software.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software
**
*/
/*
**  Application:    CAC
**  Frame:          OAPlusWPIssue
**
**  05/14/03   em   Created; PU_CANCEL is returned if OTW+
**  05/16/03   em   Look for non-FCR permits, those are all scheduled work
**  06/26/03   em   If we can't determine OTW+ status based on RFP links,
**                  we prompt the DO since some non-FCR permits can still
**                  be considered as trouble and should not trigger OTW+.
**  06/30/03   em   Only consider pure FCR prompts, not FCR Local Ground
**  07/16/03   em   Log prompt and answer.
**  07/25/03   em   Correcting SOA_JobAction error.
**  08/12/03   em   Do not enter OA+ automatically. DO will always be prompted. 
**  02/12/04   em   Process Automation, cannot display this screen.  Default to OTW.
**  03/23/04   em   Adjusted frame visibility
**  04/06/04   ysp  Add RFP id to ir_worklocation table.
**  04/13/07   ysp  ITC210: Insert IR interface event in DB event queue
**  09/14/16   ysp  Add support for 33kv. RFP are linked to main feeder cards 
**  
*/
INITIALIZE (
   Card = INTEGER NOT NULL;       /*Parameter*/
   PermitJob = INTEGER NOT NULL;  /*Parameter*/

   i = INTEGER NOT NULL WITH DEFAULT;
   MainCard = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeeder = INTEGER NOT NULL WITH DEFAULT;
   OpenAutoPlus = DATE;
   OutageType = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   TypeOfCard = INTEGER NOT NULL WITH DEFAULT;
   AutoPlus = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
) =
BEGIN
   AutoPlus = FALSE;
/*
** We already know we are on a CIOA or Auto Card.  Make sure OpenAutoPlus 
** is not already set.
*/
   SELECT :OpenAutoPlus = OpenAutoPlus,
          :TypeOfCard = TypeOfCard,
          :NetworkFeeder = NetworkFeeder 
   FROM   FMS_Card 
   WHERE  Card = :Card;

   IF OpenAutoPlus IS NOT NULL AND OpenAutoPlus <> '' THEN
      RETURN(PU_CANCEL);
   ENDIF;  

   IF NetworkFeeder = NetworkFeeder$33KV AND TypeOfCard = TypeOfCard$Portion THEN
      SELECT :MainCard = Card
      FROM   FMS_PortionLink
      WHERE  PortionCard = :Card;
   ELSE
      MainCard = Card;	
   ENDIF;          
 
/*
** Are any outstanding permits (issued or not)
** on the card linked to trouble RFPS. If so, we stay OTW.
*/
   i = 0;
   REPEATED 
   SELECT  :OutageType = RFP.OutageType
   FROM    IR_WorkLocation WL,
           IR_RequestForPermit RFP,
           SOA_JobControl JC,
           SOA_Job J,
           FMS_JobAction JA
   WHERE   JC.Card = :Card AND
           JC.StepPair = :StepHeading$OTW AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.RSComplete IS NULL AND
           J.Job = WL.WorkPermit AND
           WL.RequestForPermit = RFP.RequestForPermit AND
           WL.RFP = RFP.RFP AND
           RFP.Card = :MainCard AND
           J.JobClass = JA.JobClass AND
           JC.MoveEquipClass = JA.EquipClass AND
           JC.StepPair = JA.StepPair AND
           JA.TypeOfCard = :TypeOfCard AND
           JA.Status = :Prompt$FromWorkFCR 
   BEGIN
      IF i = -1 OR OutageType = 'TROUBLE' THEN
         i = -1;
      ELSE
         i = i + 1; /* Count non-trouble RFPs */
      ENDIF;
   END;

   IF i = -1 THEN 
      RETURN (PU_OK);
   ELSEIF i > 0 THEN
/*
** No automatic OpenAutoPlus.  DO will be prompted every time.
**
      CurFrame.WindowVisibility = WV_INVISIBLE;
      AutoPlus = TRUE;
      CurFrame.SendUserEvent (EventName = 'RecordOpenAutoPlus');
*/
   ENDIF;
/*
** Process Automation Execution Exit
*/
   IF AutomaticExecution = TRUE THEN
      RETURN PU_OK;
   ENDIF;
/*
** If code sneaks through to here, then we give the prompt to go to OTW+.
*/
END;


ON CLICK ok_btn,
ON USEREVENT 'RecordOpenAutoPlus' =
BEGIN
/*
** We are in OTW+ Op Step
*/
   RetCode = CALLPROC FMS_OpenAutoPlus (
                 Card = Card, 
                 OpenAutoPlus = 'now');
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = 
              'ERROR: Card is entering OTW+, unable to update card OpenAutoPlus time. ' +
              'Contact tech support to diagnose from trace log',
                           TraceMessage =
               'Frame:OAPlusCheckWPIssue; ' +
              'Card is entering OTW+, error updating OpenAutoPlus time for ' +
              'card = ' + VARCHAR(Card) + '.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;

/*
** Insert db event queue
*/
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_OpenAutoPlus',
                     EventText = VARCHAR(Card));  

/*
** Also exclude card from auto reports
*/
   RetCode = CALLPROC FMS_CardTypeFilterIns(Card = Card);

   IF (RetCode <> 0) THEN 
      CALLPROC DDB_ROLLBACK;
      CALLPROC TraceError (UserMessage = '',
                           TraceMessage =
               'Frame:OAPlusCheckWPIssue; ' +
               'Was not able to insert Card ' + VARCHAR(Card) +
              ' in the Card Filter table to include it in ' +
              'the annual count of scheduled work on an Auto feeder.'
               );
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF AutoPlus = TRUE THEN

      CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'OTW+ started automatically',
                 New  = 'Based on non-Trouble RFP link');
   ELSE
      CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'Does permit meet criteria for OTW+ work',
                 New  = 'DO answered: YES');
   ENDIF;
   CALLPROC DDB_COMMIT;
   RETURN (PU_CANCEL);  /* OTW+ */
END;


ON CLICK cancel_btn =
BEGIN  
   CALLPROC SOA_LogIns (
                 Card = Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'Does permit meet criteria for OTW+ work',
                 New  = 'DO answered: NO');
   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);      /* Regular OTW */
END;


ON WindowClose =
BEGIN
   RESUME;
END;

Application Component Report
============================

	Name:            OAPlusCheckWPReturn

/*
**
**	Copyright c 2003 Pateric Software.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software
**
*/
/*
**  Application:    CAC
**  Frame:          OAPlusCheckWPReturn
**
**  05/15/03   em   Created; To be called at work permit return.
**                  PU_CANCEL is returned if still out to work; 
**                  PU_OK if okay to proceed into PFS processing 
**  05/16/03   em   Look for non-FCR permits; if they exist, can 
**                  automatically enter OTW+
**  06/26/03   em   Instead of automatically going to 
**  06/30/03   em   Only consider pure FCR prompts, not FCR Local Ground
**  07/16/03   em   Log prompt and answer.
**  07/25/03   em   Correcting SOA_JobAction and Log Insert error
**  08/12/03   em   No automatic OA+, DO will be prompted every time.
**  03/25/04   em   Removed Invisibility logic.
**  04/05/04   ysp  Add RFP to ir_worklocation table
**  04/13/07   ysp  ITC210: Insert IR interface event in DB event queue
**  09/14/16   ysp  Add support for 33kv. RFP are linked to main feeder cards 
*/
INITIALIZE (
   Card = FMS_Card;               /*Parameter*/
   PermitJob = INTEGER NOT NULL;  /*Parameter*/

   i = INTEGER NOT NULL WITH DEFAULT;
   MainCard = INTEGER NOT NULL WITH DEFAULT;
   OpenAutoPlus = DATE;
   OutageType = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   AutoPlus = INTEGER NOT NULL WITH DEFAULT; /*BOOLEAN*/
) =
BEGIN
   AutoPlus = FALSE;

   IF Card.NetworkFeeder = NetworkFeeder$33KV AND Card.TypeOfCard = TypeOfCard$Portion THEN
      SELECT :MainCard = Card
      FROM   FMS_PortionLink
      WHERE  PortionCard = :Card.Card;
   ELSE
      MainCard = Card.Card;	
   ENDIF;
/*
** Are there outstanding permits on the card for Trouble RFPS?  If so,
** we can exit with PU_CANCEL.  If other non-Trouble outstanding permits,
** then we go to OTW+.
*/
   OutageType = ''; 
   i = 0;
   REPEATED 
   SELECT  :OutageType = OutageType
   FROM    IR_WorkLocation WL,
           IR_RequestForPermit RFP,
           SOA_JobControl JC,
           SOA_Job J,
           FMS_JobAction JA
   WHERE   JC.Card = :Card.Card AND
           JC.StepPair = :StepHeading$OTW AND
           JC.Job <> :PermitJob AND
           JC.Job = J.Job AND
           J.Status = '' AND
           J.RSComplete IS NULL AND
           J.Job = WL.WorkPermit AND
           WL.RequestForPermit = RFP.RequestForPermit AND
           WL.RFP = RFP.RFP AND
           RFP.Card = :MainCard AND
           J.JobClass = JA.JobClass AND
           JC.MoveEquipClass = JA.EquipClass AND
           JC.StepPair = JA.StepPair AND
           JA.TypeOfCard = :Card.TypeOfCard AND
           JA.Status = :Prompt$FromWorkFCR 
   BEGIN
      IF i = -1 OR OutageType = 'TROUBLE' THEN
         i = -1;  /* i = -1 indicates more trouble on card*/
      ELSE
         i = i + 1;  /* Count non-trouble RFPs */
      ENDIF;
   END;

   IF i = -1 THEN
      RETURN (PU_CANCEL);
   ELSEIF i > 0 THEN
/*
** No Automatic entry of OA+, we exclude this lines and move next select into
** a new ELSE portion.
**
      CurFrame.WindowVisibility = WV_INVISIBLE;
      AutoPlus = TRUE;
      CurFrame.SendUserEvent (EventName = 'RecordOpenAutoPlus');
      RESUME;
   ENDIF;
*/
   ELSE
/*
** Look for outstanding non-FCR permits.  If they exist, present screen
*/
   i = 0;
   SELECT :i = COUNT(*) 
   FROM   SOA_Job J,
          SOA_JobControl JC,
          FMS_JobAction JA
   WHERE  JC.Card = :Card.Card AND
          JC.StepPair = :StepHeading$OTW AND
          JC.Job <> :PermitJob AND
          JC.Job = J.Job AND
          J.Status = '' AND
          J.RSComplete IS NULL AND
          J.JobClass = JA.JobClass AND
          JC.MoveEquipClass = JA.EquipClass AND
          JC.StepPair = JA.StepPair AND
          JA.TypeOfCard = :Card.TypeOfCard AND
         (JA.Status = :Prompt$FromWork OR 
          JA.Status = :Prompt$FromWorkFCRNoFGO); 

   IF i = 0 THEN
      RETURN(PU_OK);  /* No additional permits */
   ENDIF;

   ENDIF;
/*
** Make sure OpenAutoPlus is not already set, if it is then we 
** do not want to display the screen.
*/
   IF Card.OpenAutoPlus IS NOT NULL AND Card.OpenAutoPlus <> '' THEN
      RETURN(PU_OK);
   ENDIF;   
END;



ON CLICK ok_btn,
ON USEREVENT 'RecordOpenAutoPlus' =
BEGIN
/*
** We already know we are on a CIOA or Auto Card.  Make sure OpenAutoPlus 
** is not already set.
*/
   IF Card.OpenAutoPlus IS NOT NULL AND Card.OpenAutoPlus <> '' THEN
      RETURN(PU_CANCEL);
   ENDIF;   
/*
** We are in OTW+ Op Step
*/
   RetCode = CALLPROC FMS_OpenAutoPlus (
                 Card = Card.Card, OpenAutoPlus = 'now');
   IF RetCode <> 0 THEN
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Card is entering OTW+, error updating OpenAutoPlus time for ' +
              'card = ' + VARCHAR(Card.Card) + 
              '.  Contact tech support to update ' +
              'manually.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Insert db event queue
*/
   CALLPROC InsertDBEventQueue(
                     ToApp = 'FCR',
                     EventName = 'IR_OpenAutoPlus',
                     EventText = VARCHAR(Card.Card));  

/*
** Also exclude card from auto reports
*/
   RetCode = CALLPROC FMS_CardTypeFilterIns(Card = Card.Card);

   IF (RetCode <> 0) THEN 
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Was not able to insert Card ' + VARCHAR(Card.Card) +
              ' in the Card Filter table to include it in ' +
              'the annual count of scheduled work on an Auto feeder.';
   ENDIF;
   CALLPROC DDB_COMMIT;
/*
** Set OTW+ Operating Step
*/
   RetCode = CALLPROC FMS_OperatingStepIns(
                              Card = Card.Card,
                              CardClassName = Card.CardClassName,
                              Feeder = Card.Feeder,
                              FeederName = Card.FeederName,
                              OperatingStep = Type$OTWPlus,
                              StartTime = 'now');

   IF (RetCode <> 0) THEN 
      CALLPROC DDB_ROLLBACK;
      MESSAGE 'Was not able to set OTW+ Operating Step for Card ' +
               VARCHAR(Card.Card);
   ENDIF;
   CALLPROC DDB_COMMIT;

   IF AutoPlus = TRUE THEN

      CALLPROC SOA_LogIns (
                 Card = Card.Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'OTW+ started automatically',
                 New  = 'Based on non-Trouble RFP link');
   ELSE
      CALLPROC SOA_LogIns (
                 Card = Card.Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'Do outstanding permits meet criteria for OTW+ work',
                 New  = 'DO answered: YES');
   ENDIF;
   CALLPROC DDB_COMMIT;
   RETURN (PU_CANCEL);  
END;


ON CLICK cancel_btn =
BEGIN  
   CALLPROC SOA_LogIns (
                 Card = Card.Card,
                 Job  = PermitJob,
                 SwitchingItem = 0,
                 Time = DATE('Now'), 
                 UserName = UserName,
                 Item = 'OTW+',
                 Old  = 'Do outstanding permits meet criteria for OTW+ work',
                 New  = 'DO answered: NO');
   CALLPROC DDB_COMMIT;
   RETURN (PU_OK);     
END;


ON WindowClose =
BEGIN
   RESUME;
END;

