	Name:            HighpotComplete

/*
**
**      Copyright c 2000 ALSTOM ESCA Corporation.  All rights reserved.
**
**      ALSTOM ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          HighPotComplete
**
**  03/21/00  py    Frame created. 
**  05/25/00  py    Show the results that have been entered in each phase. 
**                  Ability to change and confirm before clicking RECORD to 
**                  complete and save in database.
**  05/26/00  py    Test should automatically fail if end mA > start mA.
**  07/10/00  em    High Pot results may have already been entered from an
**                  operating order.  We will attempt load the results when 
**                  the frame is loaded.  If results exist, update 
**                  capabilities will be disabled.
**  08/04/00  em    Corrected display of history results, added job index.
**  11/03/00  em    Default test type and duration using criteria.
**  03/30/01  em    Look for test results in the IR return table, then let DO
**                  modify to set test status.  Don't understand why the Phase
**                  field was designed as an integer in the database - thanks
**                  Paul.
**  04/04/01  my    Correct data type conversion errors.
**  01/06/03  em    Convert Job to JIP
**  03/10/04  em    This frame should not be called during process automation
**                  so we will immediately exit.  SOA prompts are not
**                  supported yet for RR interfaces.
**  07/17/05  em    Add Phase to test criteria
**  08/18/05  em    Control Completion phases phased on phase criteria. Save 
**                  test result with Response.
**  11/03/05  em    Added status = 0 to force selection of a test status.
**  11/08/07  ysp   FMS 373: Add FailedTestReason
*/
INITIALIZE
(     
   JIP			= JobInProgress; /* Job being processed */

   CurCardClassName 	= VARCHAR(20) NOT NULL;
   CurApplication 	= VARCHAR(20) NOT NULL;
   CurSubstation 	= VARCHAR(20) NOT NULL;
   i 			= INTEGER NOT NULL;
   j 			= INTEGER NOT NULL;
   HipotRow 		= SOA_HiPotHistory;
   HiPotType 		= INTEGER NOT NULL;
   NewPhase 		= INTEGER NOT NULL;
   RetCode 		= INTEGER NOT NULL WITH DEFAULT;
   PrimaryEquip 	= VARCHAR(20) NOT NULL;
   TempStatus 		= VARCHAR(20) NOT NULL;
   TextLabel 		= VARCHAR(500) NOT NULL WITH DEFAULT;
   TestResult           = VARCHAR(20) NOT NULL WITH DEFAULT;
) =

BEGIN
   IF AutomaticExecution = TRUE THEN
      RETURN(PU_OK);
   ENDIF;
/*
** Set up titles
*/
   CurSubstation = JIP.SubstationName;
   PrimaryEquip = JIP.Equipname;
   SELECT :CurApplication = Application,
          :CurCardClassname = CardClassName
   FROM SOA_Card
   WHERE Card = :JIP.card; 
/* 
** Load equipment list
*/
   AddEquip.Clear();
   i = 1;
   SELECT :AddEquip[i].Equip = Equip,
          :AddEquip[i].EquipName = EquipName,
          :AddEquip[i].EquipClassName = EquipType
   FROM SOA_HipotTestEquip
   WHERE Job = :JIP.Job
   ORDER BY EquipClassName, EquipName
   BEGIN
      i = i + 1;
   END;
/*
** Load test criteria
*/
   SELECT :Equipkv = Equipkv,
          :PhaseCriteria = Phase,
          :TestTypekv = TestTypekv,
          :Duration = Duration,
          :Maxma = Maxma
   FROM SOA_HipotTestCriteria
   WHERE Job = :JIP.Job;

   Phase = 'ALL';
   Status = 1;
   Failedtesttypekv = TestTypekV;
   FailedDuration = Duration;
   Startma = 0.0;
   Endma = 0.0;
   NewPhase = FALSE;

   i = 1;
   SELECT :HiPot[i].TempPhase = Phase,
          :HiPot[i].TempStatus = '',
          :Hipot[i].FailedTesttypekv = TestkV,
          :Hipot[i].FailedDuration = TestDuration,
          :HiPot[i].StartmA = StartmA,
          :HiPot[i].EndmA = EndmA,
          :HiPot[i].FailedTestReason = FailedTestReason 
   FROM   IR_HighPotTestResults
   WHERE  Job = :JIP.Job
   ORDER BY 1
   BEGIN
      IF HiPot[i].TempPhase = 'A' THEN
         HiPot[i].Phase = 1;
      ELSEIF HiPot[i].TempPhase = 'B' THEN
         HiPot[i].Phase = 2;
      ELSEIF HiPot[i].TempPhase = 'C' THEN
         HiPot[i].Phase = 3;
      ELSEIF HiPot[i].TempPhase = 'ALL' THEN
         HiPot[i].Phase = 4;
      ENDIF;
      i = i + 1;
   END;

   IF i > 1 THEN
      FIELD(cancel_btn).CurBias = FB_DIMMED;
      TextLabel = 'Review High Pot Test Results for ' +
                  'Primary Equipment ' +  
               JIP.EquipClassName + '  ' + JIP.EquipName + HC_NEWLINE + 
               ' at Substation ' +
               CurSubstation + '.' + HC_NEWLINE + 
               'Enter the test status for each test result';

      Phase = Hipot[1].TempPhase;
      TempStatus = Hipot[1].Tempstatus;
      Status = Hipot[1].Status;
      FailedTestTypeKv = Hipot[1].Failedtesttypekv;
      FailedDuration = Hipot[1].FailedDuration;
      Startma = Hipot[1].Startma;
      Endma = Hipot[1].Endma;
      FailedTestReason = Hipot[1].FailedTestReason;
      FIELD(Phase).CurBias = FB_VISIBLE;
      FIELD(Phase).BgColor = CC_PALE_BLUE;

   ELSE
      TextLabel = 'Enter High Pot Test Results for Primary Equipment ' +
                 JIP.EquipClassName + '  ' + JIP.EquipName + ' at Substation ' +
                 CurSubstation;
   ENDIF;


/*
** If PhaseCriteria entered, then force return for the entered phase.
*/
   IF PhaseCriteria <> '' AND PhaseCriteria <> 'ALL' THEN
      Phase = PhaseCriteria;
      FIELD(Phase).CurBias = FB_VISIBLE;
      FIELD(Phase).BgColor = CC_PALE_BLUE;
   ENDIF;
/*
** Determine High Pot Type
*/
   IF HiPotType = 1 THEN
      field(Title).TextLabel = TextLabel
   ELSEIF HiPotType = 2 THEN 
      field(Title).TextLabel = 'Modified ' + TextLabel;
   ELSE
      message 'Unknown High Pot Test Type ... Unable to continue';
      RETURN (PU_CANCEL);
   ENDIF;
END;


ON SETVALUE Phase =
BEGIN
   IF Hipot.LastRow > 0 THEN
      IF Phase <> 'ALL' AND Hipot[1].Phase = 4 THEN
         IF CurFrame.ConfirmPopup (messagetext = 'You have entered test ' +                 
               'results for All phases.  Do you want to change it to ' +
               'enter results for individual phases?') = PU_OK THEN
            HiPot.Clear();
            RESUME;
         ELSE 
            Phase = 'ALL';
            RESUME;
         ENDIF;
  
      ELSEIF Phase = 'ALL' AND Hipot[1].Phase <> 4 THEN
         IF CurFrame.ConfirmPopup (messagetext = 'You have entered test ' + 
               'results for individual phases.  Do you want to change it to ' +
               'enter results for All phases?') = PU_OK THEN
            HiPot.Clear();
            RESUME;
         ELSE 
            Phase = Hipot[1].TempPhase;
            RESUME;
         ENDIF;
      ENDIF;

      FOR i = 1 to Hipot.LastRow() DO
         IF Phase = Hipot[i].TempPhase THEN
            IF Hipot[i].Status <> 0 THEN 
               Status = Hipot[i].Status;
               TempStatus = Hipot[i].TempStatus;
            ELSE   /* This means returned with an op order (don't know status)*/
               Status = 0;
               TempStatus = '';
            ENDIF;             
            Failedtesttypekv = Hipot[i].Failedtesttypekv;
            FailedDuration = Hipot[i].FailedDuration;
            Startma = Hipot[i].Startma;
            Endma = Hipot[i].Endma; 
            FailedTestReason = Hipot[i].FailedTestReason;
         ENDIF; 
      ENDFOR;
   ENDIF;
END;

   
ON CLICK rec_btn =
BEGIN
   IF HiPot.LastRow() > 0 THEN
      IF Phase = 'ALL' AND Hipot[1].Phase <> 4 THEN
         IF CurFrame.ConfirmPopup (messagetext = 'You have entered test ' + 
             'results for individual phases.  Do you want to change it to ' +
             'enter results for All phases?') = PU_OK THEN
            HiPot.Clear();
         ELSE
            RESUME;
         ENDIF;
      ENDIF;
   ENDIF;

   IF Endma > Startma THEN

      IF CurFrame.ConfirmPopup (Messagetext = 'The End MA is greater than the Start MA.' + HC_NEWLINE + 
         'Click ''OK'' to confirm the failure of the test or ''Cancel'' to ignore it.') = PU_OK THEN
         Status = 3;            
      ELSE
         RESUME;
      ENDIF;

   ELSEIF Endma > Maxma THEN

      IF CurFrame.ConfirmPopup (Messagetext = 'The End MA is greater than Max MA that was entered in the original test criteria.' + HC_NEWLINE +
         'Click ''OK'' to confirm the failure of the test or ''Cancel'' to ignore it.') = PU_OK THEN
         Status = 3;            
      ELSE
         RESUME;
      ENDIF;

   ELSEIF Startma > Maxma THEN

      IF CurFrame.ConfirmPopup (Messagetext = 'The Start MA is greater than Max MA that was entered in the original test criteria.' + HC_NEWLINE +
         'Click ''OK'' to confirm the failure of the test or ''Cancel'' to ignore it.') = PU_OK THEN
         Status = 3;            
      ELSE
         RESUME;
      ENDIF;

   ENDIF;

   IF Status = 0 THEN
      RESUME;
   ELSEIF Status = 1 THEN
      Tempstatus = 'Pass';
   ELSEIF Status = 2 THEN
      Tempstatus = 'Pending Approval';
   ELSEIF Status = 3 THEN
      TempStatus = 'Fail';
   ENDIF;

   HipotRow.TempPhase = Phase;
   HipotRow.Tempstatus = TempStatus;
   HipotRow.Status = Status;
   HipotRow.Failedtesttypekv = Failedtesttypekv;
   HipotRow.FailedDuration = FailedDuration;
   HipotRow.Startma = Startma;
   HipotRow.Endma = Endma;
   HipotRow.FailedTestReason = FailedTestReason;

   IF Phase = 'A' THEN
         HiPotRow.Phase = 1;
   ELSEIF Phase = 'B' THEN
         HiPotRow.Phase = 2;
   ELSEIF Phase = 'C' THEN
         HiPotRow.Phase = 3;
   ELSEIF Phase = 'ALL' THEN
         HiPotRow.Phase = 4;
   ENDIF;

   IF Hipot.LastRow() = 0 THEN
      Hipot.InsertRow (RowNumber = 1,
                       RowObject = HipotRow.Duplicate());
   ELSE
      FOR i = 1 to Hipot.LastRow() DO
         IF Phase = Hipot[i].TempPhase THEN
            Hipot[i].Phase = HiPotRow.Phase;
            Hipot[i].TempStatus = TempStatus; 
            Hipot[i].Status = Status;  
            Hipot[i].Failedtesttypekv = Failedtesttypekv;
            Hipot[i].FailedDuration = FailedDuration;
            Hipot[i].Startma = Startma;
            Hipot[i].Endma = Endma; 
            Hipot[i].FailedTestReason = FailedTestReason;
         ENDIF; 
      ENDFOR;

      NewPhase = FALSE;
      i = 1;
      WHILE i <= Hipot.LastRow() DO
         IF HiPotRow.Phase <> Hipot[i].Phase THEN
            NewPhase = TRUE;
         ELSE
            NewPhase = FALSE;
            ENDLOOP;
         ENDIF;
         i = i + 1;
      ENDWHILE;
      
      IF NewPhase = TRUE THEN
         Hipot.InsertRow (RowNumber = Hipot.lastRow() + 1,
                          RowObject = HipotRow.Duplicate()); 
      ENDIF;

   ENDIF;
END;


ON CHILDENTRY Hipot = 
BEGIN
   i = FIELD(HiPot).CurRow;

   Phase = Hipot[i].TempPhase;
   TempStatus = Hipot[i].Tempstatus;
   Status = Hipot[i].Status;
   FailedTestTypeKv = Hipot[i].Failedtesttypekv;
   FailedDuration = Hipot[i].FailedDuration;
   Startma = Hipot[i].Startma;
   Endma = Hipot[i].Endma;
   FailedTestReason = Hipot[i].FailedTestReason;
END;
 

ON CLICK OK_btn =
BEGIN 
/*
** DO a couple validations:  Verify Status contains a value.
*/   
   IF HiPot.LastRow() = 0 THEN
      MESSAGE 'No Test Results are entered.';
      RESUME;
   ENDIF;

   FOR i = 1 TO HiPot.LastRow() DO
      IF HiPot[i].TempStatus = '' THEN
         MESSAGE 'Please edit the test results and enter a Test Status.';
         RESUME;
         ENDLOOP;
      ENDIF;
   ENDFOR;

   TestResult = ' Pass';
   FOR i = 1 TO Hipot.LastRow() DO 
/*
** Save test result for primary equipment
*/
      Retcode = CALLPROC SOA_HiPotHistoryIns(
                               Substation = JIP.Substation,
                               SubstationName = CurSubstation,
                               Job = JIP.Job,
                               EquipType  = JIP.EquipClassName,
                               Equip      = JIP.Equip,
                               EquipName  = PrimaryEquip,
                               Application= CurApplication,
                               Card       = JIP.Card,
                               CardType   = CurCardClassName,
                               HipotType  = Hipottype,
                               Testdate   = 'now',
                               Equipkv    = Equipkv,
                               TestTypekv = TestTypekv,
                               Duration   = Duration,
                               Phase      = Hipot[i].Phase,
                               Status     =  Hipot[i].Status,
                               FailedTestTypekv = Hipot[i].FailedTesttypekv,
                               FailedDuration =  Hipot[i].FailedDuration,
                               FailedTestReason = Hipot[i].FailedTestReason, 
                               Startma    =  Hipot[i].Startma,
                               Endma      =  Hipot[i].Endma);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message ('Error insert SOA Hi Pot test history. Please try again or contact your technical support');
         RESUME
      ENDIF;
      CALLPROC DDB_COMMIT;  

      IF Hipot[i].TempStatus <> 'Pass' THEN
         TestResult = ' ' + Hipot[i].TempStatus;
      ENDIF;
   ENDFOR;

   RetCode = CALLPROC SOA_HiPotTestCriteriaDel (Job = JIP.Job);

   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message ('Error delete SOA Hi Pot test criteria. Please try again or contact your technical support');
      RESUME;
   ENDIF;

   JIP.Response = TestResult;
   JIP.ResponseUpd();

   RETURN (PU_OK);
END;


ON CLICK cancel_btn =
BEGIN
   Return (PU_Cancel);
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
						 *Default Item

						 *Default Item


Name:      helptext

				Fieldobject Script
				------------------

ON CLICK =
BEGIN
    HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
    HelpTextObject.WindowTitle = CurFrame.WindowTitle;
    HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
