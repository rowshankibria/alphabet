	Name:            Check3GCamDiscClosed

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Check3GCamDiscClosed
**
**  Modification log:
**
**   02/07/11   em  Created
**   02/08/11   em  Extend to PendingStatus to look for pending Close
*/
PROCEDURE CHECK3GCamDiscClosed
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

    CamDisc = ARRAY OF ObjectSummaryClass;
    Operator         = INTEGER;  /*Operator to use for pending status check*/

    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL;              /* index */ 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
)= 
BEGIN 
/*
** Make sure Job Equip has VisibleBreakFor relationship, we are looking the
** other way, from the 3GSwitch to the CamDisc
*/
   RetCode = NULL;
   CamDisc.Clear();
   i = 1;
   REPEATED
   SELECT  :CamDisc[i].Object = G.Member,
           :CamDisc[i].Name = O.Name,
           :CamDisc[i].Terminal = S.CurrentlyOpen /* Hide status in Terminal field */
   FROM    Udb_Grouping G,
           Udb_Object O,
           Udb_Switch S
   WHERE   G.Grouping = :JIP.Equip AND
           G.Relationship = :Interaction$VisibleBreakFor AND
           G.Member = O.Object AND
           O.Object = S.Object
   BEGIN
      i = i + 1;
   END;
         
   IF CamDisc.LastRow() = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GCamDiscClosed called from equipment that is not related ' +
                          'to a Cam-Disc device');
      RETURN(RetCode);
   ENDIF;

   FOR i = 1 TO CamDisc.LastRow() DO
  
      IF CamDisc[i].Terminal = 1 THEN  

         IF JIP.Status = Job$Restore THEN
            Operator = JIP.RSOperator;
         ELSE
            Operator = JIP.TOOperator;
         ENDIF;

         j = 0;
         SELECT  :j = Object
         FROM    FMS_PendingStatus 
         WHERE   Object = :CamDisc[i].Object AND
		 PendingStatus = :Status$Closed AND
                 StatusCount > 0 AND
                 IssuedOperator = :Operator;

         IF j = 0 THEN
   
              WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'Cam-Disc ' + CamDisc[i].Name + 
                           ' is still open.'
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RetCode = Warning$Overridden;
              ENDIF;
         ENDIF;
      ENDIF;
   ENDFOR;

   RETURN (RetCode);
END;


