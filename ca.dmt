	Name:            PromptViewFeederRestrictions

/*
**	Copyright c 2014 Pateric Software LLC.  All rights reserved.
**
**	Pateric Software proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          PromptViewFeederRestrictions
**
**  04/21/15   em   Created
*/
INITIALIZE
(
   JIP = JobInProgress;          /* Passed Job */
) =
DECLARE
   FeederName = VARCHAR(40) NOT NULL WITH DEFAULT;
   FeederCard = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   SELECT :FeederName = AC.CardName,
          :FeederCard = AC.Card
   FROM   SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Application = :Application$FMS;

   CALLFRAME Restrictions(Card = FeederCard,
                          CurrentFeederName = FeederName,
                          ViewOnlyFLG = TRUE,
                          DisplayFeederOnly = TRUE);
   RETURN;
END;

