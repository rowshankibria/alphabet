============================

	Name:            RestrictionsWorkarea

/*
**
**	Copyright c 1993 Unified Information, Inc.  All rights reserved.
**
**	Unified Information, Inc. proprietary and trade secret information.
**	Do not copy or disclose to third parties without written permission
**	from an officer of Unified Information, Inc.
**
*/
/*
**  Application:    FeederCard
**  Frame:          RestrictionsWorkArea
**
**  Modifications:
**    10/03/94      pw        Frame Created.
**    03/11/96      wc        Variance id - FMS 214 Fixed time entries limitation.
**                            Added an entry field to provide the capability to enter anytime, rather than be
**                            limited to the popup list.
**    04/26/10      ysp       Prompt users if Time period(s) and feeders have not been entered 
**                            at the time the operator is closing the screen.
**    12/27/12      ysp       rearrange table layout to align headings with columns. Add Lifted By Region flag.
**    06/18/12      em        Only allow feeder on card to be lifted.
**    02/20/15      pkw       Add DO name and entry time when manually inserting restrictions.
**    05/06/15      pkw       Remove Lifted by Region flag.  This will be updated from the main screen.
*/
INITIALIZE (
   i = integer not null;
   j = integer not null;
   k = integer not null;
   L1 = VARCHAR(80) NOT NULL;
   L2 = VARCHAR(80) NOT NULL;
   L3 = VARCHAR(80) NOT NULL;
   L4 = VARCHAR(80) NOT NULL;
   Card = INTEGER NOT NULL;  /*PARM*/
   CardFeeders = ARRAY OF INTEGEROBJECT;
   LiftedFeeder = INTEGER NOT NULL WITH DEFAULT;
   RetCode = integer not null;
   NewFeeder = integer not null;
   StartDay = INTEGER NOT NULL WITH DEFAULT;
   EndDay = INTEGER NOT NULL WITH DEFAULT;
   StartTime = INTEGER NOT NULL WITH DEFAULT;
   EndTime = INTEGER NOT NULL WITH DEFAULT;
   TimeSequence = INTEGER NOT NULL WITH DEFAULT;
   OldFeeder = INTEGER NOT NULL WITH DEFAULT;
   OldRestriction = INTEGER NOT NULL WITH DEFAULT;
   NewRestrictedFeeder = FeederRestrictionClass;
   FeederList = ARRAY OF ObjectSummaryClass;  /* List of available feeders */
   ChosenFeeder = ObjectSummaryClass;  
   ChosenEquip = FMS_Equip; 
   InsertRestrictionFLG = INTEGER NOT NULL WITH DEFAULT;
   UpdateRestrictionFLG = INTEGER NOT NULL WITH DEFAULT;
   RestrictionKey = INTEGER NOT NULL;
   WARestriction = RestrictionClass;
   UpdateRestriction = RestrictionClass;
   EmailClass = EmailNotificationClass DEFAULT NULL;
   TimePeriod = VARCHAR(200) NOT NULL;
   RFeeder = VARCHAR(200) NOT NULL;
   Lifted = VARCHAR(40) NOT NULL;
   Function = VARCHAR(10) NOT NULL;
   Function2 = VARCHAR(10) NOT NULL;
   TempChar = VARCHAR(10) NOT NULL;
) =
BEGIN
   IF InsertRestrictionFLG = TRUE THEN
      RestrictionKey = CALLPROC Udb_NextKey(KeyName = 'Restriction');
                                              
      IF (RestrictionKey <= 0) THEN
         CALLPROC DDB_ROLLBACK;
         MESSAGE 'Could not generate a restriction key, try again.';
         RETURN;
      ENDIF;
      CALLPROC DDB_COMMIT;
      WorkArea.WA.RestrictionID = RestrictionKey;
      WorkArea.WA.RestrictionNumber = 'DO-';
   ELSEIF UpdateRestrictionFLG = TRUE THEN
      WorkArea.WA = UpdateRestriction;
      Field(WorkArea.Cancel_btn).TextLabel = 'Exit';
   ENDIF;
END;

ON ClickPoint WorkArea.WA.DefectiveFeederName =
BEGIN
   NewFeeder = CALLFRAME SelectFeeder(SelectFeeder = FeederList,
                          Selected = byref(ChosenFeeder)); 
   IF NewFeeder = 0 THEN
       RESUME;
   ENDIF;

   WorkArea.WA.DefectiveFeederName = ChosenFeeder.Name;
   WorkArea.WA.DefectiveFeeder   = ChosenFeeder.Object;

   /*  Clear defective equip and location  */
   WorkArea.WA.DefectiveEquip = 0;
   WorkArea.WA.DefectiveEquipName = '';
   WorkArea.WA.DefectiveEquipLocation = '';
   WorkArea.WA.DefectiveNetworkName = '';
END;

ON ClickPoint WorkArea.WA.DefectiveEquipName =
BEGIN
   IF WorkArea.WA.DefectiveFeeder = 0 THEN
      message 'You must first select a defective feeder.';
      RESUME;
   ENDIF;
      
   CALLFRAME ChangePrimarySource(Feeder = WorkArea.WA.DefectiveFeeder,
                          DefectiveEquipFLG = TRUE,
                          Selected = byref(ChosenEquip)); 
   IF ChosenEquip.Equip = 0 THEN
      RESUME;
   ELSE
      WorkArea.WA.DefectiveEquip = ChosenEquip.Equip;
      WorkArea.WA.DefectiveEquipName = ChosenEquip.PrintId + ' ' +  
                                ChosenEquip.EquipClassName + ' ' +  
                                ChosenEquip.EquipName;   

      SELECT :L1 = L.L1,
             :L2 = L.L2,
             :L3 = L.L3,
             :L4 = L.L4
      FROM   Udb_Location L,
             Udb_Grouping G
      WHERE  G.Member = :ChosenEquip.Equip AND
             G.RelationShip = :Interaction$LocatedWith AND
             G.Grouping = L.Object;

      WorkArea.WA.DefectiveEquipLocation = L1 + HC_NEWLINE + L2 
                                              + HC_NEWLINE + L3 
                                              + HC_NEWLINE + L4; 

      SELECT :WorkArea.WA.DefectiveNetworkName = O.Name 
      FROM   Udb_Object O,
             Udb_Grouping G
      WHERE  G.Member = :ChosenEquip.Equip and
             G.Relationship = :Interaction$MemberOf and
             G.GroupingType = :Type$Network and
             G.Grouping = O.Object;
   ENDIF;

END;

/*
**  Delete restriction time
*/
ON Click WorkArea.RemoveTime_Btn = 
BEGIN
   i = Field(WorkArea.WA.Time).CurRow;
   IF i = 0 THEN
      message 'You must select a time.';
      RESUME;
   ENDIF;

   RetCode = CALLPROC FMS_TimeRestrictionDel(RestrictionID = WorkArea.WA.RestrictionID,
                                         TimeSeq = WorkArea.WA.Time[i].TimeSeq);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to remove time,  please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   WorkArea.WA.Time.RemoveRow(rownumber = i);
END;

/*
**  Start of add time events
*/
ON Click WorkArea.AddTime_Btn = 
BEGIN
   Field(WorkArea).CurBias = FB_Visible;
   Field(TimeWA).SetToDefault();
   Field(TimeWA).CurBias = FB_Landable;
END;

ON ClickPoint TimeWA.SF.StartDay = 
BEGIN
   Field(Day).CurBias = FB_Changeable;
   StartDay = TRUE;
END;

ON ClickPoint TimeWA.SF.EndDay = 
BEGIN
   Field(Day).CurBias = FB_Changeable;
   EndDay = TRUE;
END;

ON Click Day =
BEGIN
   IF StartDay = TRUE THEN
      i = Day;
      TimeWA.SF.StartDay = Field(Day).CurEnumText;
      StartDay = FALSE;
   ELSEIF EndDay = TRUE THEN
      TimeWA.SF.EndDay = Field(Day).CurEnumText;
      EndDay = FALSE;
   ENDIF;   
   Field(Day).CurBias = FB_Invisible;
END;

ON ClickPoint TimeWA.SF.StartTime = 
BEGIN
   Field(startend).SetToDefault();
   Field(startend).CurBias = FB_Changeable;
   StartTime = TRUE;
END;

ON ClickPoint TimeWA.SF.EndTime = 
BEGIN
   Field(startend).SetToDefault();
   Field(startend).CurBias = FB_Changeable;
   EndTime = TRUE;
END;
/* wc 03/11/96 */
ON Exit StartEnd.Hour =
BEGIN
   Field(StartEnd).CurBias = FB_Invisible;
END

ON Click StartEnd.ok_btn =
BEGIN
   Field(StartEnd).CurBias = FB_Invisible;
END
/* wc */
ON SetValue StartEnd.Hour =
BEGIN
   IF StartTime = TRUE THEN
      TimeWA.SF.StartTime = StartEnd.Hour;
      StartTime = FALSE;
   ELSEIF EndTime = TRUE THEN
      TimeWA.SF.EndTime = StartEnd.Hour;
      EndTime = FALSE;
   ENDIF; 
END;

ON Click TimeWA.CancelTime_Btn = 
BEGIN
   Field(WorkArea).CurBias = FB_Changeable;
   Field(TimeWA).CurBias = FB_Invisible; 
/* wc /03/11/96*/ 
   Field(StartEnd).CurBias = FB_Invisible;
/* wc */
END;

ON Click TimeWA.SaveTime_Btn = 
BEGIN
   IF TimeWA.SF.StartDay = '' THEN
      message 'Please enter a start day.';
      RESUME;
   ELSEIF TimeWA.SF.EndDay = '' THEN
      message 'Please enter a end day.';
      RESUME;
   ELSEIF TimeWA.SF.StartTime = '' THEN
      message 'Please enter a start time.';
      RESUME;
   ELSEIF TimeWA.SF.EndTime = '' THEN
      message 'Please enter a end time.';
      RESUME;
/* wc 03/11/96 */
   ELSEIF (TimeWA.SF.StartTime > '2359')
   or (TimeWA.SF.StartTime like '__6_') 
   or (TimeWA.SF.StartTime like '__7_')
   or (TimeWA.SF.StartTime like '__8_')
   or (TimeWA.SF.StartTime like '__9_') THEN
      message 'Start time is invalid.';
      RESUME;
   ELSEIF (TimeWA.SF.EndTime > '2359')
   or (TimeWA.SF.EndTime like '__6_')
   or (TimeWA.SF.EndTime like '__7_')
   or (TimeWA.SF.EndTime like '__8_')
   or (TimeWA.SF.EndTime like '__9_') THEN
      message 'End time is invalid.';
      RESUME;
/* wc */
   ENDIF;

 

   RetCode = CALLPROC FMS_TimeRestrictionIns(RestrictionID = WorkArea.WA.RestrictionID,
                                         StartDay  = TimeWA.SF.StartDay,
                                         EndDay    = TimeWA.SF.EndDay,
                                         StartTime = TimeWA.SF.StartTime,
                                         EndTime   = TimeWA.SF.EndTime);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to save time,  please try again.';
      RESUME;
   ELSE
      /*
      ** Procedure returns TimeSeq
      */
      TimeWA.SF.TimeSeq = RetCode;
      CALLPROC DDB_COMMIT;
   ENDIF;

   Field(WorkArea).CurBias = FB_Changeable;
   Field(TimeWA).CurBias = FB_Invisible;
/* wc 03/11/96 */ 
   Field(StartEnd).CurBias = FB_Invisible;
/* wc */
   i = WorkArea.WA.Time.LastRow() + 1;
   WorkArea.WA.Time.InsertRow(rownumber = i,
                              rowobject = TimeWA.SF);

END;
/*
**  End of add time events
*/
/*
**  Add Restricted Feeders
*/
ON Click WorkArea.AddFeeder_Btn =
BEGIN
   NewFeeder = CALLFRAME SelectFeeder(SelectFeeder = FeederList,
                          Selected = byref(ChosenFeeder)); 
   IF NewFeeder = 0 THEN
       RESUME;
   ENDIF;

   i = 1;
   WHILE i <= WorkArea.WA.Feeder.LastRow() DO
      IF WorkArea.WA.Feeder[i].Feeder = ChosenFeeder.Object THEN
         message 'Feeder is already in list.';
         RESUME;
      ENDIF;
      i = i + 1;
   ENDWHILE;

   RetCode = CALLPROC FMS_FeederRestrictionIns(RestrictionID = WorkArea.WA.RestrictionID,
                                         Feeder  = ChosenFeeder.Object,
                                         FeederName = ChosenFeeder.Name,
                                         Lifted = 0);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to save Feeder,  please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   NewRestrictedFeeder = FeederRestrictionClass.Create();
   NewRestrictedFeeder.FeederName = ChosenFeeder.Name;
   NewRestrictedFeeder.Feeder = ChosenFeeder.Object;
   NewRestrictedFeeder.Lifted = 0;
   /*
   ** Procedure returns FeederSeq
   */
   NewRestrictedFeeder.FeederSeq = Retcode;

   i = WorkArea.WA.Feeder.LastRow() + 1;
   WorkArea.WA.Feeder.InsertRow(rownumber = i,
                              rowobject = NewRestrictedFeeder);
END;

ON Click WorkArea.RemoveFeeder_Btn = 
BEGIN
   i = Field(WorkArea.WA.Feeder).CurRow;
   IF i = 0 THEN
      message 'You must select a feeder.';
      RESUME;
   ENDIF;

   RetCode = CALLPROC FMS_FeederRestrictionDel(RestrictionID = WorkArea.WA.RestrictionID,
                                         FeederSeq = WorkArea.WA.Feeder[i].FeederSeq);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to remove feeder,  please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;

   WorkArea.WA.Feeder.RemoveRow(rownumber = i);
END;

ON Click WorkArea.OK_Btn = 
BEGIN
   IF WorkArea.WA.RestrictionNumber = '' THEN
      message 'Please enter a restriction number.';
      RESUME;
   ELSEIF WorkArea.WA.Time.LastRow() = 0 THEN
      message 'Please enter the time period for this restriction.';
      RESUME;
   ELSEIF WorkArea.WA.Feeder.LastRow() = 0 THEN
      message 'Please enter the feeder(s) that are affected by ' +
              'this restriction.';
      RESUME;
   ENDIF;
     
/*
**  Determine if insert or update for email 
*/
   k = 0;
   SELECT :k = COUNT(*) 
   FROM   FMS_Restriction
   WHERE  RestrictionId = :WorkArea.WA.RestrictionID;

   IF k = 0 THEN
      Function = 'enter';
      Function2 = 'entered';
   ELSE
      Function = 'update';
      Function2 = 'updated';
      IF CurFrame.ConfirmPopup (MessageText = 'Selecting ''OK'' will send changes ' +
                              'made to this restriction to Scheduling DO via email.') = PU_CANCEL  THEN
         RESUME;
      ENDIF;
   ENDIF;   
   
  
   TempChar = left(WorkArea.WA.RestrictionNumber,3);
   IF Lowercase(TempChar) = 'rs-' THEN
      TempChar = 'DO-' + Right(WorkArea.WA.RestrictionNumber, Length(WorkArea.WA.RestrictionNumber) - 3);
   ELSE
      TempChar = WorkArea.WA.RestrictionNumber;
   ENDIF;      

   RetCode = CALLPROC FMS_RestrictionIns(RestrictionID = WorkArea.WA.RestrictionID,
                                     RestrictionNumber = TempChar,
                                     DefectiveFeeder     = WorkArea.WA.DefectiveFeeder,
                                     DefectiveFeederName = WorkArea.WA.DefectiveFeederName,
                                     DefectiveEquip      = WorkArea.WA.DefectiveEquip,
                                     DefectiveEquipName  = WorkArea.WA.DefectiveEquipName,
                                     DefectiveNetworkName = WorkArea.WA.DefectiveNetworkName,
                                     DefectiveEquipLocation = WorkArea.WA.DefectiveEquipLocation,
                                     ExpirationDate = WorkArea.WA.ExpirationDate,
                                     Reason = WorkArea.WA.Reason,
                                     Division = 0,
                                     EnterTime = Date('now'),
                                     DOName = DOp.Description);
   IF RetCode < 0 THEN
      CALLPROC DDB_ROLLBACK;
      Message 'Unable to save restriction,  please try again.';
      RESUME;
   ENDIF;
   CALLPROC DDB_COMMIT;
   WARestriction = WorkArea.WA.Duplicate();
/*
** Send email to Scheduling DO
*/
   TimePeriod = '';
   FOR i = 1 TO WorkArea.WA.Time.LastRow DO
      TimePeriod = TimePeriod +  
              '(' + WorkArea.WA.Time[i].StartDay + '-' + WorkArea.WA.Time[i].EndDay +
              ':' + WorkArea.WA.Time[i].StartTime + '-' + WorkArea.WA.Time[i].EndTime + ') ';
   ENDFOR;

   RFeeder = '';
   FOR i = 1 TO WorkArea.WA.Feeder.LastRow DO
      IF WorkArea.WA.Feeder[i].Lifted <> 0 THEN
/*    Comment out for now.  No need to send this info to scheduling D.O.
         Lifted = '(Lifted by Region)'        
*/
         Lifted = ''        
      ELSE
         Lifted = ''
      ENDIF;
      
      IF i = 1 THEN
         RFeeder = WorkArea.WA.Feeder[i].Feedername + Lifted;
      ELSE
         RFeeder = RFeeder + ', ' + WorkArea.WA.Feeder[i].Feedername + Lifted;    
      ENDIF;
   ENDFOR;
   
   IF EmailClass IS NULL THEN
      EmailClass = EmailNotificationClass.Create();
   ENDIF;

   EmailClass.EmailType = 12;
   EmailClass.Sender = DOp.Description;
   EmailClass.Recipient = 'SchedulingDO';
   EmailClass.Subject = 'FMS Restriction ' + Function2 + ' by ' +  DOp.Description;
   EmailClass.Message1 = 'DOName=' + DOp.Description + ';;' + 
                         'ID=' + VARCHAR(WorkArea.WA.RestrictionID)  + ';;' +
                         'NO=' + WorkArea.WA.RestrictionNumber + ';;' +
                         'FUN=' + Function + ';;' +
                         'FUN2=' + Function2 + ';;' +
                         'DFeeder=' + WorkArea.WA.DefectiveFeederName  + ';;' + 
                         'DEquip=' + WorkArea.WA.DefectiveEquipName + ';;';
                         
   EmailClass.Message2 = 'TimePeriod=' + TimePeriod + ';;' + 
                         'Network=' + WorkArea.WA.DefectiveNetworkName + ';;' + 
                         'Location=' + WorkArea.WA.DefectiveEquipLocation + ';;' +
                         'RFeeder=' + RFeeder + ';;' +
                         'Remarks=' + WorkArea.WA.Reason + ';;' +
                         'EDate=' + VARCHAR(WorkArea.WA.ExpirationDate) + ';;';
   EmailClass.Template = 'DOSRestriction.html';
   EmailClass.InsertRequest();

   IF EmailClass.ReturnCode <> 0 THEN 
      Message 'Unable to notify Scheduling D.O. by email';
   ENDIF;
   RETURN;
END;


ON Click WorkArea.Cancel_Btn = 
BEGIN
   /*
      Just return if operator was updating a restriction
   */
   IF UpdateRestrictionFLG = TRUE THEN
      IF WorkArea.WA.Time.LastRow() = 0 THEN
          message 'Time period(s) must be entered for restrictions.';
          RESUME;
      ELSEIF WorkArea.WA.Feeder.LastRow() = 0 THEN
          message 'Restricted feeder(s) must be entered for restrictions.';
          RESUME;
      ELSE
         RETURN;
      ENDIF;
   ENDIF;

   /*
      If operator was inserting a restriction remove times and feeders for restriction
   */
   IF WorkArea.WA.Time.LastRow() > 0 THEN
      RetCode = CALLPROC FMS_TimeRestrictionDel(RestrictionID = WorkArea.WA.RestrictionID,
                                            TimeSeq = Delete$All);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove all restricted times for this restriction.';
         RESUME;
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   IF WorkArea.WA.Feeder.LastRow() > 0 THEN
      RetCode = CALLPROC FMS_FeederRestrictionDel(RestrictionID = WorkArea.WA.RestrictionID,
                                            FeederSeq = Delete$All);
      IF RetCode < 0 THEN
         CALLPROC DDB_ROLLBACK;
         Message 'Unable to remove all restricted feeder for this restriction.';
      ENDIF;
      CALLPROC DDB_COMMIT;
   ENDIF;

   Field(WorkArea.WA).SetToDefault();
   WARestriction = WorkArea.WA.Duplicate();
   RETURN;
END;

ON WINDOWCLOSE =
BEGIN
   RESUME;
END;
			 *Default Item


