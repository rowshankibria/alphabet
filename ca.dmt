	Name:            KPISOSectionPrompt

/*
**
**      Copyright c 2017 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
*/
/*
**  Application:    CAC
**  Frame:          KPISOSectionPrompt
**
**  Date:       Author   Description
** ----------------------------------
**  08/22/17	EM       Created
**
*/
INITIALIZE 
(
        Feeder          = INTEGER NOT NULL;
        FeederName      = VARCHAR(40) NOT NULL;
        Equip           = INTEGER NOT NULL;
        EquipName       = VARCHAR(40) NOT NULL;
        EquipTypeName   = VARCHAR(40) NOT NULL;
        EquipPrintID    = VARCHAR(3) NOT NULL;
        
        ParentFrame     = FRAMEEXEC;
        i		= INTEGER NOT NULL WITH DEFAULT; /*Index*/
        j		= INTEGER NOT NULL WITH DEFAULT; /*Index*/
        k		= INTEGER NOT NULL WITH DEFAULT; /*Index*/
        LastRow		= INTEGER NOT NULL;   /*LastRow of Array*/
	RetCode		= INTEGER NOT NULL;   /*Return Code from transaction*/
        SF6Obj 		= INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   FIELD(kp_title).TextValue = 'Picking up ' + EquipPrintID + ' ' + EquipTypeName + ' ' + EquipName + 
                                 ' on Feeder ' + FeederName;
END;


ON CHILDENTRY SF6 =
DECLARE
   ClickRow = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
      RESUME;
   ENDIF;

   ClickRow = 0;
   ClickRow = FIELD(SF6).WhichRow (cellfield = CurFrame.TriggerField);
   IF ClickRow <= 0 THEN
      RESUME;
   ENDIF;

   IF SF6Obj = SF6[ClickRow].Object THEN
      SF6Obj = 0;
      FIELD(SF6[ClickRow].PrimaryGroupingName).IsReverse = FALSE;
      FIELD(SF6[ClickRow].TypeName).IsReverse = FALSE;
      FIELD(SF6[ClickRow].Name).IsReverse = FALSE;
      FIELD(SF6[ClickRow].Description).IsReverse = FALSE;
   ELSE
      FOR i = 1 TO SF6.LastRow DO
         IF i = ClickRow THEN
            SF6Obj = SF6[i].Object;
            FIELD(SF6[i].PrimaryGroupingName).IsReverse = TRUE;
            FIELD(SF6[i].TypeName).IsReverse = TRUE;
            FIELD(SF6[i].Name).IsReverse = TRUE;
            FIELD(SF6[i].Description).IsReverse = TRUE;
         ELSE
            FIELD(SF6[i].PrimaryGroupingName).IsReverse = FALSE;
            FIELD(SF6[i].TypeName).IsReverse = FALSE;
            FIELD(SF6[i].Name).IsReverse = FALSE;
            FIELD(SF6[i].Description).IsReverse = FALSE;
         ENDIF;
      ENDFOR;
   ENDIF; 
END;


ON CLICK yes_btn =
BEGIN
/*
** Make sure equipment does not already have a downstream from relationship.
*/
   IF SF6Obj = 0 THEN
      MESSAGE 'Must Select a Known Point ISO Section.';
   ELSE
         j = 0;
         SELECT :j = Grouping
         FROM   Udb_Grouping
         WHERE  Member = :Equip AND
                Relationship = :Interaction$DownstreamFrom;

         IF j > 0 THEN
            MESSAGE 'This equipment already is defined with a Downstream From ' +
                    'relationship.  Will be necessary to correct it using Udb screens.';
            RESUME;
         ENDIF;
 
         RetCode = CALLPROC Udb_GroupingIns (
                      Grouping = SF6Obj, 
                      Relationship = Interaction$DownstreamFrom,
                      Member = Equip);

         IF RetCode <> 0 THEN
            CALLPROC DDB_ROLLBACK;
            MESSAGE 'DownstreamFrom Grouping Insert for Equipment ' + EquipTypeName +
                    '  ' + EquipName + 'failed.';
            RESUME;
         ENDIF;
         CALLPROC DDB_COMMIT;  
         RETURN;
    ENDIF;
END;




ON CLICK no_btn,
ON WINDOWCLOSE =
BEGIN
    IF SF6Obj <> 0 THEN
       MESSAGE 'You have an Known Point ISO section selected, you should click YES to create the ' +
               'Downstream From relationship, or click to remove the selection.';
    ELSE
       RETURN;
    ENDIF;
END;



Application Component Report
============================

	Name:            LinkProtectionMoves

/*
**
**      Copyright c 1998 Cegelec ESCA Corporation.  All rights reserved.
**
**      Cegelece ESCA Corporation proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Cegelec ESCA Corporation.
**
*/
/*
**  Application:    SOA
**  Frame:          LinkProtectionMoves
**
**  Date:       Author   Description
** ----------------------------------
**  10/07/98	EM       Rewrote to include all apps based on existing frames
**  09/03/99    em       When Loading from SLC, must delineate by switching
**                       item
**  01/31/03    yp       Merge:Query active FMS cards from soa_activecard table.
**                       Combine the load job sql for slc, tfms and fms apps.
**  02/20/03    em       Moving to CAC to use from all of SOA, FMS, and TLS.
**  03/05/03	em       Only allow links to Active switching item moves, not
**                       open.  If on an Open Sw Item permit, only show moves
**                       within that open item.  Added new OpenItem parm
**  11/11/03    yp       FMS307: add capability to link work permit to 
**                       protection moves in the New/Drop bank.
**  03/01/05    em       Include NIS moves and show switching item header in Green
**  03/30/05    em       Add access to Steam cards
**  09/23/05    ysp      Sort new/dropped equipment by equip type and equip name
**  12/14/05    ysp      Increase the size of tomove to 160 chars
**  09/01/09    em       Not showing available No Restore moves
**  07/07/14    em       Enable for DSO
**  10/20/15    em       Add equipment search capability
**  11/03/17    pkw      When calling from slc set current switching item to active row.
**  11/03/31    em       For DSO, look at TakeOut side only.
*/
INITIALIZE 
(
#  include StandardDeclarations
   Card    = INTEGER NOT NULL;     /*Passed Card*/
   OpenItem = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm*/
   JobBankFlag  = INTEGER NOT NULL WITH DEFAULT;  /*Optional Parm, Boolean */ 
   EffectiveDivisions = ARRAY OF ObjectSummaryClass;  /* Optional Available divisions*/

   AllEquip = ARRAY of FMS_Equip;		/* Array of all new or drop equipment */
   CardRow = INTEGER NOT NULL WITH DEFAULT;          /* current card row */
   j = INTEGER NOT NULL WITH DEFAULT;
   Match = VARCHAR(40) NOT NULL WITH DEFAULT;        /* temporary string */                     
   SearchApplication = VARCHAR(6) NOT NULL WITH DEFAULT;
   CardType = INTEGER NOT NULL;
   CardTypeName = VARCHAR(6) NOT NULL WITH DEFAULT;
   SelectedMove = Generic_Job;
   vequipname = VARCHAR(12) NOT NULL NOT DEFAULT;
   SLCTopRow = INTEGER NOT NULL WITH DEFAULT;
) =
BEGIN
   SLCTopRow = 0;
   Selected.Card = Card;
   SearchApplication = CurrentApplication;
   IF SearchApplication = Application$DSO OR 
      SearchApplication = Application$SDS THEN
        FIELD(Application).CurBias = FB_INVISIBLE;
        FIELD(EJ).Title = 'Candidate Protection Moves for Selection';
   ENDIF;

   IF JobBankFlag = TRUE THEN
      FIELD(JobBank).AbsXLeft = 0;
      FIELD(JobBank).AbsYTop = 0;
      FIELD(JobBank).CurBias = FB_CHANGEABLE;

      /*
      **   Load up the division optionfield.
      */
      FIELD(JobBank.division).ValueList.ChoiceItems[1].EnumValue = 0;	
      FIELD(JobBank.division).ValueList.ChoiceItems[1].EnumText = '';	
      j = 1;
      WHILE (j <= EffectiveDivisions.LastRow()) DO
         FIELD(JobBank.division).ValueList.ChoiceItems[j+1].EnumValue =
				EffectiveDivisions[j].Object;	
         FIELD(JobBank.division).ValueList.ChoiceItems[j+1].EnumText =	
				EffectiveDivisions[j].Name;	
         j = j + 1;
      ENDWHILE;
      CurFrame.StatusText = 'Select equipment from the New or Drop Bank...';
      Curframe.SendUserEvent (Eventname = 'InitJobBank');
   ELSE
      FIELD(JobBank).CurBias = FB_INVISIBLE;

      CurFrame.StatusText = 'Select Protection Moves from current card or ' +
                         'Select a System and find other card...';
      CurFrame.SendUserEvent(EventName = 'load_jobs');
   ENDIF;
END;


ON SETVALUE Application =
BEGIN
   SelectCard.Clear();
   Selected.Card = 0;
   Selected.CardName = '';
   Selected.CardClassName = '';
   Selected.FeederStatusName = '';
   CardFilter = '';
   IF Application = 1 THEN
      CurFrame.StatusText = 'Select a System and enter a Card Name filter to ' +
              'load a card list...';
   ELSE
      CurFrame.StatusText = 'Type Card Name Filter and hit enter to load ' +
              'card list';
   ENDIF;
   IF FIELD(Application).CurEnumText = 'Steam' THEN
      SearchApplication = Application$SDS;
   ELSE
      SearchApplication = FIELD(Application).CurEnumText;
   ENDIF;
END;


ON SETVALUE CardFilter =
BEGIN
/*
** Perform Search
** We are reusing some fields for the ActiveCardList user class to
** display essential card information in the tablefield, namely
** the Feederstatusname and Cardclassname fields.
*/
   EJ.Clear();
   SelectCard.Clear();
   Selected.Card = 0;
   Selected.CardName = '';
   Selected.CardClassName = '';
   Selected.FeederStatusName = '';
   CardFilter = '%' + CardFilter + '%';
   IF SearchApplication = Application$SLC THEN

      i = 1;
      SELECT DISTINCT    
             :SelectCard[i].Card = Card,
             :SelectCard[i].Application = Application,
             :SelectCard[i].CardName = CardName,
             :SelectCard[i].FeederStatusName = '',
             :SelectCard[i].CardClassName = ''           
      FROM   SOA_ActiveCard
      WHERE  Application = :SearchApplication AND
             UPPERCASE(CardName) LIKE :CardFilter
      BEGIN
         i = i + 1;
      END; 

 
   ELSEIF SearchApplication = Application$TFMS OR 
               SearchApplication = Application$DSO OR
               SearchApplication = Application$SDS THEN

      i = 1;
      SELECT DISTINCT
             :SelectCard[i].Card = Card,
             :SelectCard[i].Application = Application,
             :SelectCard[i].CardName = CardName,
             :SelectCard[i].FeederStatusName = FeederStatusName,
             :SelectCard[i].CardClassName = ''           
      FROM   SOA_ActiveCard
      WHERE  Application = :SearchApplication AND
             UPPERCASE(CardName) LIKE :CardFilter
      BEGIN
         i = i + 1;
      END; 

   ELSEIF SearchApplication = Application$FMS THEN

      i = 1;
      SELECT DISTINCT
             :SelectCard[i].Card = Card,
             :SelectCard[i].Application = :SearchApplication,      
             :SelectCard[i].CardName = CardName,
             :SelectCard[i].FeederStatusName = FeederStatusName,
             :SelectCard[i].CardClassName = ''           
      FROM   SOA_ActiveCard 
      WHERE  Application = :SearchApplication AND
             UPPERCASE(CardName) LIKE :CardFilter
      ORDER BY CardName
      BEGIN
         i = i + 1;
      END;

   ELSEIF SearchApplication = Application$TLS THEN

      i = 1;
      SELECT DISTINCT
             :SelectCard[i].Card = Card,
             :SelectCard[i].Application = :SearchApplication,      
             :SelectCard[i].CardName = LineNumber,
             :SelectCard[i].FeederStatusName = LineTypeName,
             :SelectCard[i].CardClassName = FeederNames           
      FROM   TC_Card
      WHERE  Status < 4 AND
             UPPERCASE(LineNumber) LIKE :CardFilter
      ORDER BY CardName
      BEGIN
         i = i + 1;
      END;

   ELSE
      Application = 1;
      CurFrame.StatusText = 'Select a System and enter a Card Name filter to ' +
              'load a card list...';
      CardFilter = '';
      RESUME;
   ENDIF;

   IF i = 1 THEN
      MESSAGE 'No Cards found that match this card name';
      CardFilter = '';
      RESUME;
   ENDIF;

   CurFrame.StatusText = 'Select ' + SearchApplication + ' Card to load ' +
            'protection move selection list.';
   CardFilter = '';
END;   


ON Click Find_Btn = 
BEGIN
    Match = '%' + UPPERCASE(Selected.CardName) + '%';
    i = 1;
    WHILE i <= SelectCard.LastRow() DO
       IF UpperCase(SelectCard[i].CardName) LIKE Match THEN
          Endloop;
       ENDIF;
       i = i + 1;
    ENDWHILE;

    IF i <= SelectCard.LastRow() THEN
       Field(SelectCard).ActiveRow = i;
       Selected = SelectCard[i].Duplicate(); 
    
       CurFrame.SendUserEvent(EventName = 'load_jobs');
    ELSE
       Message 'Unable to find match in card list.';
       RESUME;
    ENDIF;
END;

 
ON ChildEntry SelectCard =
BEGIN
    IF CurFrame.ReasonCode <> RC_MouseClick THEN
       RESUME;
    ENDIF;

    CardRow = FIELD(SelectCard).CurRow;
    Selected = SelectCard[CardRow].Duplicate(); 
    
    CurFrame.SendUserEvent(EventName = 'load_jobs');
END;



ON USEREVENT 'load_jobs' =
BEGIN
/*
**  Clear out the select list and load moves from appropriate application
**  table.
*/
    EJ.Clear();
    IF SearchApplication = Application$SLC OR 
       SearchApplication = Application$TFMS OR   
       SearchApplication = Application$FMS OR
       SearchApplication = Application$DSO OR
       SearchApplication = Application$SDS THEN

       IF SearchApplication = Application$SLC THEN
          CardType = Type$SLCApp;
          CardTypeName = 'SLC';
       ELSEIF SearchApplication = Application$TFMS THEN
          CardType = Type$TFMSApp;
          CardTypeName = 'TFMS';
       ELSEIF SearchApplication = Application$FMS THEN
          CardType = Type$FMSApp;
          CardTypeName = 'FMS';
       ELSEIF SearchApplication = Application$SDS THEN
           CardType = TypeOfCard$Steam;
           CardTypeName = 'Steam';
       ELSEIF SearchApplication = Application$DSO THEN
           CardType = TypeOfCard$DSO;
           CardTypeName = 'DSO';
       ENDIF;         
/*
**      Read in the jobs, different select if an open item on this SLC card.
*/
       IF Selected.Card = Card and OpenItem <> 0 THEN

        i = 1;
        SELECT  :EJ[i].CardType = :CardType, 
                :EJ[i].CardTypeName = :CardTypeName,
                :EJ[i].CardName = :Selected.CardName, 
                :EJ[i].CardStatus = '',
                :EJ[i].Card = :Selected.Card,
                :EJ[i].Application = :SearchApplication,
                :EJ[i].SwitchingItem = JC.SwitchingItem,
                :EJ[i].Job = J.Job, 
                :EJ[i].Status = J.Status,
                :EJ[i].JobClass = J.JobClass,
                :EJ[i].PrintID = JC.PrintID,
                :EJ[i].Equip = J.Equip,
                :EJ[i].EquipClass = J.EquipClass,
                :EJ[i].EquipName = J.EquipName,
                :EJ[i].EquipClassName = J.EquipClassName,
                :EJ[i].Seq = JC.Seq,
                :EJ[i].SubsOrDesk = O.Name,  
                :EJ[i].StepPair = JC.StepPair,
                :EJ[i].TOMove = J.TOMove,
                :EJ[i].TOIssued = J.TOIssued,
                :EJ[i].TOComplete = J.TOComplete,
                :EJ[i].RSMove = J.RSMove,
                :EJ[i].RSIssued = J.RSIssued,
                :EJ[i].RSComplete = J.RSComplete,
                :EJ[i].MoveCategory = J.MoveCategory,
                :EJ[i].DeskName = J.DeskName,
                :EJ[i].MoveFGColor = J.MoveFGColor,
                :EJ[i].Substation = J.Substation
         FROM    SOA_Job J,
                 SOA_JobControl JC,
                 Udb_Object O
         WHERE   JC.Card = :Selected.Card AND
                 JC.SwitchingItem = :OpenItem AND
                JC.StepPair <> :StepHeading$WorkPermit AND
                JC.StepPair <> :StepHeading$TestPermit AND
                JC.Job = J.Job AND 
                J.ControlCard = JC.Card AND
                J.Status IN ('',:JobStatus$NIS) AND
                ((J.MoveCategory = :MoveCategory$Normal AND
                  (J.TOComplete IS NULL OR J.RSIssued IS NULL))  OR
                  J.MoveCategory <> :MoveCategory$Normal) AND
                J.Substation = O.Object  
         ORDER BY SwitchingItem, Seq
         BEGIN
            IF EJ[i].MoveFgColor <> 0 THEN
              IF EJ[i].Job = EJ[i].SwitchingItem THEN
                 FIELD(EJ[i].EquipClassName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].EquipName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ELSEIF EJ[i].JobClass = 0 THEN
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ENDIF;
            ELSEIF EJ[i].MoveCategory = MoveCategory$SwitchingItem THEN
                FIELD(EJ[i].TOMove).BgColor = CC_PALE_GREEN;
            ELSEIF EJ[i].MoveCategory <> MoveCategory$Normal AND
                   EJ[i].MoveCategory <> MoveCategory$Fake THEN
                FIELD(EJ[i].TOMove).FgColor = CC_BLUE;
            ENDIF;
            IF EJ[i].Substation = 0 THEN
               EJ[i].SubsOrDesk = EJ[i].DeskName;
            ENDIF;      
            i = i + 1;
         END;

       ELSEIF SearchApplication = Application$DSO THEN

        i = 1;
        SELECT  :EJ[i].CardType = :CardType, 
                :EJ[i].CardTypeName = :CardTypeName,
                :EJ[i].CardName = :Selected.CardName, 
                :EJ[i].CardStatus = '',
                :EJ[i].Card = :Selected.Card,
                :EJ[i].Application = :SearchApplication,
                :EJ[i].SwitchingItem = JC.SwitchingItem,
                :EJ[i].Job = J.Job, 
                :EJ[i].Status = J.Status,
                :EJ[i].JobClass = J.JobClass,
                :EJ[i].PrintID = JC.PrintID,
                :EJ[i].Equip = J.Equip,
                :EJ[i].EquipClass = J.EquipClass,
                :EJ[i].EquipName = J.EquipName,
                :EJ[i].EquipClassName = J.EquipClassName,
                :EJ[i].Seq = JC.Seq,
                :EJ[i].SubsOrDesk = O.Name,  
                :EJ[i].StepPair = JC.StepPair,
                :EJ[i].TOMove = J.TOMove,
                :EJ[i].TOIssued = J.TOIssued,
                :EJ[i].TOComplete = J.TOComplete,
                :EJ[i].RSMove = J.RSMove,
                :EJ[i].RSIssued = J.RSIssued,
                :EJ[i].RSComplete = J.RSComplete,
                :EJ[i].MoveCategory = J.MoveCategory,
                :EJ[i].DeskName = J.DeskName,
                :EJ[i].MoveFGColor = J.MoveFGColor,
                :EJ[i].Substation = J.Substation
         FROM    SOA_Job J,
                 SOA_JobControl JC,
                 Udb_Object O
         WHERE  JC.Card = :Selected.Card AND
                JC.StepPair <> :StepHeading$WorkPermit AND
                JC.StepPair <> :StepHeading$TestPermit AND
                JC.Job = J.Job AND 
                J.ControlCard = JC.Card AND
                J.Status IN ('',:JobStatus$NIS) AND
                ((J.MoveCategory = :MoveCategory$Normal AND
                  J.TOComplete IS NULL)  OR
                  J.MoveCategory <> :MoveCategory$Normal) AND
                J.Substation = O.Object  
         ORDER BY SwitchingItem, Seq
         BEGIN
            IF EJ[i].MoveFgColor <> 0 THEN
              IF EJ[i].Job = EJ[i].SwitchingItem THEN
                 FIELD(EJ[i].EquipClassName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].EquipName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ELSEIF EJ[i].JobClass = 0 THEN
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ENDIF;
            ELSEIF EJ[i].MoveCategory = MoveCategory$SwitchingItem THEN
                FIELD(EJ[i].TOMove).BgColor = CC_PALE_GREEN;
                IF EJ[i].SwitchingItem = Control_SI AND
                   SLCTopRow = 0 THEN
                   SLCTopRow = i;
                ENDIF;
            ELSEIF EJ[i].MoveCategory <> MoveCategory$Normal AND
                   EJ[i].MoveCategory <> MoveCategory$Fake THEN
                FIELD(EJ[i].TOMove).FgColor = CC_BLUE;
            ENDIF;
            IF EJ[i].Substation = 0 THEN
               EJ[i].SubsOrDesk = EJ[i].DeskName;
            ENDIF;      
            i = i + 1;
         END;
       
       ELSE

        i = 1;
        SELECT  :EJ[i].CardType = :CardType, 
                :EJ[i].CardTypeName = :CardTypeName,
                :EJ[i].CardName = :Selected.CardName, 
                :EJ[i].CardStatus = '',
                :EJ[i].Card = :Selected.Card,
                :EJ[i].Application = :SearchApplication,
                :EJ[i].SwitchingItem = JC.SwitchingItem,
                :EJ[i].Job = J.Job, 
                :EJ[i].Status = J.Status,
                :EJ[i].JobClass = J.JobClass,
                :EJ[i].PrintID = JC.PrintID,
                :EJ[i].Equip = J.Equip,
                :EJ[i].EquipClass = J.EquipClass,
                :EJ[i].EquipName = J.EquipName,
                :EJ[i].EquipClassName = J.EquipClassName,
                :EJ[i].Seq = JC.Seq,
                :EJ[i].SubsOrDesk = O.Name,  
                :EJ[i].StepPair = JC.StepPair,
                :EJ[i].TOMove = J.TOMove,
                :EJ[i].TOIssued = J.TOIssued,
                :EJ[i].TOComplete = J.TOComplete,
                :EJ[i].RSMove = J.RSMove,
                :EJ[i].RSIssued = J.RSIssued,
                :EJ[i].RSComplete = J.RSComplete,
                :EJ[i].MoveCategory = J.MoveCategory,
                :EJ[i].DeskName = J.DeskName,
                :EJ[i].MoveFGColor = J.MoveFGColor,
                :EJ[i].Substation = J.Substation
         FROM    SOA_Job J,
                 SOA_JobControl JC,
                 Udb_Object O
         WHERE   JC.Card = :Selected.Card AND
                JC.StepPair <> :StepHeading$WorkPermit AND
                JC.StepPair <> :StepHeading$TestPermit AND
                JC.Job = J.Job AND 
                J.ControlCard = JC.Card AND
                J.Status IN ('',:JobStatus$NIS) AND
                ((J.MoveCategory = :MoveCategory$Normal AND
                  (J.TOComplete IS NULL OR J.RSIssued IS NULL))  OR
                  J.MoveCategory <> :MoveCategory$Normal) AND
                (J.SwItemStatus = 0 OR J.SwItemStatus = :Card$Active) AND
                J.Substation = O.Object  
         ORDER BY SwitchingItem, Seq
         BEGIN
            IF EJ[i].MoveFgColor <> 0 THEN
              IF EJ[i].Job = EJ[i].SwitchingItem THEN
                 FIELD(EJ[i].EquipClassName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].EquipName).FgColor = EJ[i].MoveFgColor;      
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ELSEIF EJ[i].JobClass = 0 THEN
                 FIELD(EJ[i].TOMove).FgColor = EJ[i].MoveFgColor;      
              ENDIF;
            ELSEIF EJ[i].MoveCategory = MoveCategory$SwitchingItem THEN
                FIELD(EJ[i].TOMove).BgColor = CC_PALE_GREEN;
                IF EJ[i].SwitchingItem = Control_SI AND
                   SLCTopRow = 0 THEN
                   SLCTopRow = i;
                ENDIF;
            ELSEIF EJ[i].MoveCategory <> MoveCategory$Normal AND
                   EJ[i].MoveCategory <> MoveCategory$Fake THEN
                FIELD(EJ[i].TOMove).FgColor = CC_BLUE;
            ENDIF;
            IF EJ[i].Substation = 0 THEN
               EJ[i].SubsOrDesk = EJ[i].DeskName;
            ENDIF;      
            i = i + 1;
         END;

        ENDIF;
        CALLPROC DDB_ROLLBACK;
        /*
        **  For SLC scroll to curent switching item
        */
        IF SLCTopRow <> 0 THEN
            FIELD(EJ).TopRow = SLCTopRow;
        ENDIF;


     ELSEIF SearchApplication = Application$TLS THEN

        i = 1;
        SELECT  :EJ[i].CardType = :Type$TLSApp, 
                :EJ[i].CardTypeName = 'TLS',
                :EJ[i].CardName = :Selected.CardName, 
                :EJ[i].CardStatus = '',
                :EJ[i].Card = :Selected.Card,
                :EJ[i].Application = :SearchApplication,
                :EJ[i].Job = J.Job, 
                :EJ[i].Status = J.Status,
                :EJ[i].JobClass = J.JobClass,
                :EJ[i].PrintID = '',
                :EJ[i].Equip = 0,
                :EJ[i].EquipClass = 0,
                :EJ[i].EquipName = '',
                :EJ[i].EquipClassName = '',
                :EJ[i].Seq = J.Seq,
                :EJ[i].SubsOrDesk = J.SubstationName,  
                :EJ[i].StepPair = J.StepPair,
                :EJ[i].TOMove = J.TOMove,
                :EJ[i].TOIssued = J.TOIssued,
                :EJ[i].TOComplete = J.TOComplete,
                :EJ[i].RSMove = J.RSMove,
                :EJ[i].RSIssued = J.RSIssued,
                :EJ[i].RSComplete = J.RSComplete,
                :EJ[i].MoveCategory = 0,
                :EJ[i].Substation = J.Substation
        FROM    TC_Job J
        WHERE   J.Card = :Selected.Card AND
                J.StepPair <> :StepHeading$WorkPermit AND
                J.Status = '' AND
                J.RSIssued IS NULL   
        ORDER BY Seq
        BEGIN
            IF EJ[i].JobClass = 0 THEN
                FIELD(EJ[i].TOMove).FgColor = CC_BLUE;
            ENDIF;      
            i = i + 1;
        END;
        CALLPROC DDB_ROLLBACK;

     ENDIF;

     IF i = 1 THEN
        MESSAGE 'No available protection moves for this card.';
     ENDIF;
END;

ON SetValue JobBank.EquipType =
BEGIN
    JobBank.Division = 0;
    Curframe.SendUserEvent (Eventname = 'InitJobBank');
END;

ON USEREVENT 'InitJobBank' = 
BEGIN
    JobBank.SelectEquip.Clear();
    JobBank.Moves.Clear();

    JobBank.Selected.G = NULL;
    JobBank.Selected.Equip = 0;
    JobBank.Selected.EquipClassName = '';
    JobBank.Selected.EquipName = '';
    JobBank.Selected.Description = '';
END;

ON SetValue JobBank.Division =
BEGIN
    IF (JobBank.division != 0) THEN
        Curframe.SendUserEvent (Eventname = 'InitJobBank');
        Curframe.SendUserEvent (Eventname = 'SelectEquipInBank');
    ELSE
        message 'You must select a division.';
    ENDIF;
END;

ON USEREVENT 'SelectEquipInBank' =
BEGIN
    i = 1;
    IF JobBank.EquipType = 1 THEN    /* new equipment */
       REPEATED SELECT
               :JobBank.SelectEquip[i].Equip = O.Object,
               :JobBank.SelectEquip[i].EquipName = O.Name,
               :JobBank.SelectEquip[i].EquipClass  = O.Type,
               :JobBank.SelectEquip[i].EquipClassName  = O.TypeName,
               :JobBank.SelectEquip[i].Description = O.Description
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  G.Grouping = :JobBank.Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType = :Type$Grouper))
       AND    O.OutService IS NULL
       AND    O.InService IS NULL
       AND    O.Object IN (SELECT DISTINCT Equip
                           FROM FMS_DroppedEquipJobs)
       ORDER BY EquipClassName, EquipName
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;

    ELSEIF JobBank.EquipType = 2 THEN  /* dropped equipment */
       REPEATED SELECT
               :JobBank.SelectEquip[i].Equip = O.Object,
               :JobBank.SelectEquip[i].EquipName = O.Name,
               :JobBank.SelectEquip[i].EquipClass  = O.Type,
               :JobBank.SelectEquip[i].EquipClassName  = O.TypeName,
               :JobBank.SelectEquip[i].Description = O.Description
       FROM   Udb_Object O,
              Udb_Grouping G
       WHERE  G.Grouping = :JobBank.Division
       AND    G.Relationship = :Interaction$Memberof
       AND    G.Member = O.Object
       AND    G.MemberType IN (SELECT Type
                               FROM   Udb_ExtendedType
                               WHERE  SuperType = :Type$Switch AND
                                      Type NOT IN (SELECT Type
                                                FROM   Udb_ExtendedType
                                                WHERE  SuperType = :Type$Grouper))
       AND    O.Outservice IS NOT NULL
       AND    O.Object IN (SELECT DISTINCT Equip
                           FROM FMS_DroppedEquipJobs)
       ORDER BY EquipClassName, EquipName
       BEGIN
          i = i + 1;
       END;
       CALLPROC DDB_ROLLBACK;
    ENDIF;

    IF i = 1 THEN
       MESSAGE 'No available protection moves in the job bank.';
       RESUME;
    ENDIF;    
/*
**  Get ground count for equipment,
*/
    i = 1;
    WHILE i <= JobBank.SelectEquip.LastRow() DO
       REPEATED
       SELECT  :JobBank.SelectEquip[i].G = O.StatusCount
       FROM    FMS_ObjectStatus O
       WHERE   O.Object = :JobBank.SelectEquip[i].Equip AND
               O.Status = :Status$Ground;
       IF JobBank.SelectEquip[i].G = 0 THEN
          JobBank.SelectEquip[i].G = NULL;
       ENDIF;

       i = i + 1;
    ENDWHILE;
    CALLPROC DDB_ROLLBACK;

    AllEquip.Clear();
    AllEquip = JobBank.SelectEquip.Duplicate();
    CurFrame.StatusText = 'Select equipment to load the moves...';    
END;

ON ChildEntry JobBank.SelectEquip =
BEGIN
    IF CurFrame.ReasonCode <> RC_MouseClick THEN
       RESUME;
    ENDIF;

    i = FIELD(JobBank.SelectEquip).CurRow;
    JobBank.Selected = JobBank.SelectEquip[i].Duplicate(); 
    
    JobBank.Moves.Clear();     /* Clear out storage */
/*
** because these jobs are not related to any card, we are not able to
** display the step headings (with card type).
*/
    i = 1;
    REPEATED
    SELECT     :JobBank.Moves[i].Job = J.Job,
               :JobBank.Moves[i].JobClass = J.JobClass,
               :JobBank.Moves[i].Card = 0,
               :JobBank.Moves[i].Equip = :JobBank.Selected.Equip,
               :JobBank.Moves[i].EquipName = J.EquipName,
               :JobBank.Moves[i].EquipClass = J.EquipClass,
               :JobBank.Moves[i].EquipClassName = J.EquipClassName,
               :JobBank.Moves[i].TOMove = J.TOMove,
               :JobBank.Moves[i].TOOperator = J.TOOperator,
               :JobBank.Moves[i].TOIssued = J.TOIssued,
               :JobBank.Moves[i].TOComplete = J.TOComplete,
               :JobBank.Moves[i].RSIssued = J.RSIssued,
               :JobBank.Moves[i].RSComplete = J.RSComplete,
               :JobBank.Moves[i].RSOperator = J.RSOperator,
               :JobBank.Moves[i].MoveType = J.MoveType,
               :JobBank.Moves[i].RSMove = J.RSMove,
               :JobBank.Moves[i].TOMoveRules = J.TOMoveRules ,
               :JobBank.Moves[i].RSMoveRules = J.RSMoveRules,
               :JobBank.Moves[i].Grounds = J.Grounds,
               :JobBank.Moves[i].GroundOn = J.GroundOn
    FROM    SOA_Job J,
            FMS_DroppedEquipJobs D
    WHERE   D.Equip = :JobBank.Selected.Equip
    AND     D.Job = J.Job
    ORDER BY JobClass
    BEGIN

        IF JobBank.Moves[i].JobClass = 0 THEN
           FIELD(JobBank.Moves[i].TOMove).FgColor = CC_BLUE;
        ENDIF;

        IF JobBank.Moves[i].TOIssued = '' THEN
           FIELD(JobBank.Moves[i].TOIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF JobBank.Moves[i].TOComplete = '' THEN
           FIELD(JobBank.Moves[i].TOComplete).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF JobBank.Moves[i].RSIssued = '' THEN
           FIELD(JobBank.Moves[i].RSIssued).BgColor = CC_PALE_GRAY;
        ENDIF;
        IF JobBank.Moves[i].RSComplete = '' THEN
           FIELD(JobBank.Moves[i].RSComplete).BgColor = CC_PALE_GRAY;
        ENDIF;

        i = i + 1;
    END;
    CALLPROC DDB_ROLLBACK;
    CurFrame.StatusText = 'Select protection moves to link to the work permit...';    
END;

ON ChildEntry EJ,
ON ChildEntry JobBank.Moves =
BEGIN
    IF (CurFrame.OriginatorField = FIELD(EJ)) THEN
    	i = FIELD(EJ).CurRow;
        SelectedMove = EJ[i].Duplicate();
    ELSE
    	i = FIELD(JobBank.Moves).CurRow;
        SelectedMove = JobBank.Moves[i].Duplicate();
    ENDIF;

    IF CurFrame.ReasonCode <> RC_MOUSECLICK THEN
        RESUME;
    ENDIF;    


    IF SelectedMove.JobClass = 0 THEN
        Message 'You cannot select a Step Heading.';
        RESUME;
    ENDIF;

/*
**   Add to NewJobs table if it wasn't selected.
*/
    j = 1;
    WHILE j <= NewJobs.LastRow() DO
       IF NewJobs[j].Job = SelectedMove.Job THEN
          ENDLOOP;
       ENDIF;
       j = j + 1;
    ENDWHILE;

    IF j > NewJobs.LastRow() THEN
       IF NewJobs.InsertRow (RowNumber = j, RowObject = SelectedMove) != ER_OK THEN
          IF (DDB_Global.InhibitMessages = FALSE) THEN
             MESSAGE 'Error adding a row to protection table';
          ENDIF;
          RESUME;
       ELSE
          IF NewJobs[j].TOIssued = '' THEN
             FIELD(NewJobs[j].TOIssued).BgColor = CC_PALE_GRAY;
          ENDIF;
          IF NewJobs[j].TOComplete = '' THEN
             FIELD(NewJobs[j].TOComplete).BgColor = CC_PALE_GRAY;
          ENDIF;
          IF NewJobs[j].RSIssued = '' THEN
             FIELD(NewJobs[j].RSIssued).BgColor = CC_PALE_GRAY;
          ENDIF;
          IF NewJobs[j].RSComplete = '' THEN
             FIELD(NewJobs[j].RSComplete).BgColor = CC_PALE_GRAY;
          ENDIF;
       ENDIF;
    ENDIF
END;

ON ChildEntry NewJobs =
BEGIN
    i = FIELD(NewJobs).CurRow;
    IF FIELD(NewJobs[i].TOMove).IsReverse = TRUE THEN
       FIELD(NewJobs[i].TOMove).IsReverse = FALSE;
    ELSE
       FIELD(NewJobs[i].TOMove).IsReverse = TRUE;
    ENDIF;
    CurFrame.InputFocusField = Field(Delete_Btn);
END;

/*
**  Remove row from New Move List
*/
ON CLICK Delete_Btn =
BEGIN
    i = NewJobs.LastRow();
    WHILE i >= 1 DO
       IF FIELD(NewJobs[i].TOMove).IsReverse = TRUE THEN
          NewJobs.RemoveRow(rownumber = i);
       ENDIF;
       i = i - 1;
    ENDWHILE;
END;
/*
**  Clear New Move List
*/
ON CLICK Clear_Btn =
BEGIN
    NewJobs.Clear();
END;

ON CLICK Jobbank.Search_btn =
BEGIN
/*
**	Set up the search filter for equipment.
*/
	IF (JobBank.equip_filter != '') THEN
		vequipname = '%' + JobBank.equip_filter + '%';
	ELSE
		vequipname = '%';
	ENDIF;
/*
**	Loop through the array to find all equipment that match the
**	search criteria.
*/
	i = 1;
	j = 1;
	JobBank.SelectEquip.Clear();
	WHILE i <= AllEquip.LastRow() DO 
		IF (AllEquip[i].EquipName LIKE vequipname) THEN
		  	JobBank.SelectEquip[j] = AllEquip[i].Duplicate();	
			j = j + 1;
		ENDIF;
		i = i + 1;
	ENDWHILE;
END;

ON DBEvent 'SOA_Card_Control_Taken' =
BEGIN
#  include Card_Control
/*
**  All frames except for SOA_Main will return.
**  SOA_Main will have an event to clear the screen.
*/
   Return;
END;


ON CLICK Menu.Help_Menu.Help_Text =
BEGIN
   HelpTextObject.FrameName = CurFrame.ObjectSource.Name;
   HelpTextObject.WindowTitle = CurFrame.WindowTitle;
   HelpTextFrame.SendUserEvent (EventName = 'DisplayText');
END;


ON CLICK OK_btn =
BEGIN
/*
** Save or Select/Return Operation.
*/
   RETURN;   /* NewJobs array gets returned */
END;


ON CLICK Cancel_btn =
BEGIN
/*
** Exit without performing an operation.
*/
   NewJobs.Clear();
   RETURN;
END;


ON WINDOWCLOSE =
BEGIN
/*
** Prevent use of Window System Close mechanism while using application.
*/
    RESUME;
END;
							 *Default Item

						 *Default Item

							 *Default Item


