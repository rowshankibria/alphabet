	Name:            Check3GStationGround

/*
**  Copyright c 2011 Pateric Software LLC.  All rights reserved.
**
**  Pateric Software proprietary and trade secret information.
**  Do not copy or disclose to third parties without written permission
**  from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          Check3GStationGround
**
**  Modification log:
**
**   05/17/11   em  Created
**   05/18/11   em  Add check for feeder ground does not exist if not connected to station.
*/
PROCEDURE CHECK3GStationGround 
(
    JIP = JobInProgress;			  /* parameter - Cutout Job being processed */

    CardList = ARRAY OF FMS_Card;
    FeederName = VARCHAR(80) NOT NULL WITH DEFAULT;                   

    i = INTEGER NOT NULL;              /* index */ 
    j = INTEGER NOT NULL;              /* index */ 
    k = INTEGER NOT NULL;              /* index */ 
    CurrentFeeder = INTEGER NOT NULL WITH DEFAULT;
    CurrentFeederGround = INTEGER NOT NULL WITH DEFAULT;
    FeederList = ARRAY OF INTEGEROBJECT;
    GroundList = ARRAY OF ObjectSummaryClass;
    LastFeeder = INTEGER NOT NULL WITH DEFAULT;
    TempJobs = ARRAY of JobInProgress; 
    WarningStatus = INTEGER;  /* return status of Warning Frame */ 
    RetCode = INTEGER;     /* Allows two warnings to be presented */
)= 
DECLARE
   CheckFeederInService   = PROCEDURE RETURNING INTEGER NOT NULL;
ENDDECLARE
BEGIN 
/*
** Make sure Job appears on active 3G Card
*/
   CardList.Clear();
   i = 1;
   SELECT :CardList[i].Card = C.Card,
          :CardList[i].FeederName = C.FeederName
   FROM   FMS_Card C,
          SOA_ActiveCard AC,
          SOA_JobControl JC
   WHERE  JC.Job = :JIP.Job AND
          JC.Card = AC.Card AND
          AC.Card = C.Card AND
          C.NetworkFeeder = 1
   BEGIN
      i = i + 1;
   END;

   IF CardList.LastRow() = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GStationGround called on a non 3G Network Feeder card from ' +
                          'Card=' + VARCHAR(JIP.Card) + '; Job=' + VARCHAR(JIP.Job) );
      RETURN(NULL);
   ENDIF;
/*
** Get feeder for current equipment.
*/
   CurrentFeeder = 0;
   SELECT :CurrentFeeder = Grouping
   FROM   Udb_Grouping
   WHERE  Member = :JIP.Equip AND
          Relationship = :Interaction$MemberOf AND
          GroupingType = :Type$Feeder;

   IF CurrentFeeder = 0 THEN
      CALLPROC TraceError (
           UserMessage  = '',
           TraceMessage = 'Warning: Check3GStationGround called on a 3G Network Feeder card job ' +
                          'for equipment that is not associated to a feeder. ' +
                          'Card=' + VARCHAR(JIP.Card) + '; Job=' + VARCHAR(JIP.Job) );
      RETURN(NULL);
   ENDIF;

   CurrentFeederGround = CALLPROC CheckFeederInService (Feeder = CurrentFeeder);

   IF CurrentFeederGround = FALSE THEN
      SELECT :FeederName = Name
      FROM   Udb_Object 
      WHERE  Object = :CurrentFeeder;

      WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'Feeder ' + FeederName + ' does not have Station Ground status. ' 
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RETURN(Warning$Overridden);
              ENDIF;

   ELSEIF CurrentFeederGround <> TRUE THEN
      SELECT :FeederName = Name
      FROM   Udb_Object 
      WHERE  Object = :CurrentFeederGround;

      WarningStatus = CALLFRAME Warning
                   (Card = JIP.Card, 
                    Job = JIP.Job, 
                    SwitchingItem = JIP.SwitchingItem,
                    Text = 'Feeder ' + FeederName + ' has a Ground. ' 
                   ); 
              IF (WarningStatus = PU_CANCEL) THEN
                  RETURN(PU_CANCEL);
              ELSE
                  RETURN(Warning$Overridden);
              ENDIF;
   ELSE
      RETURN(NULL);
   ENDIF;
END;


PROCEDURE CheckFeederInService (
   Feeder = INTEGER NOT NULL
) =
DECLARE
   FeederGround = INTEGER NOT NULL WITH DEFAULT;
   FeederSource = INTEGER NOT NULL WITH DEFAULT;
   InStation = INTEGER NOT NULL WITH DEFAULT;
   Operator = INTEGER;
   ReachedStation = INTEGER NOT NULL WITH DEFAULT;
   i = INTEGER NOT NULL WITH DEFAULT;
   k = INTEGER NOT NULL WITH DEFAULT;
   NetworkFeederList = ARRAY OF ConnectedEquipClass;	
ENDDECLARE
BEGIN
   NetWorkFeederList.Clear();
   CALLPROC NetworkFeederTrace (
                           StartFeeder = Feeder,  
                           NetworkFeederList = NetworkFeederList,
                           SwitchClosing = JIP.Equip);

   IF NetworkFeederList.LastRow() = 0 THEN
      NetworkFeederList[1].Object = Feeder;
   ENDIF;

   ReachedStation = FALSE;
   FOR i = 1 TO NetWorkFeederList.LastRow() DO
      Feeder = NetWorkFeederList[i].Object;
/*
**  Is this feeder a member of a substation
*/
      InStation = 0;
      SELECT :InStation = G.Grouping
      FROM   Udb_Grouping G,
             Udb_ExtendedType ET
      WHERE  G.Member = :Feeder AND
             G.Relationship = :Interaction$MemberOf AND
             G.GroupingType = ET.Type AND
             ET.SuperType = :Type$Substation;

      IF InStation > 0 THEN
         ReachedStation = TRUE;
/*
** Check StationGround Status of feeder 
*/
         FeederGround = 0;
         SELECT  :FeederGround = Object
         FROM    FMS_ObjectStatus
         WHERE   Object = :Feeder AND
                 StatusCount >= 0 AND
                 Status = :Status$StationGround;

         IF FeederGround = 0 THEN
            RETURN(FALSE);   /* We do not have a Station Ground */
         ENDIF; 
      ENDIF;
   ENDFOR;

   IF ReachedStation = FALSE THEN
      FOR i = 1 TO NetWorkFeederList.LastRow() DO
         FeederGround = 0;
         SELECT :FeederGround = Object
         FROM   FMS_ObjectStatus
         WHERE  Object = :NetWorkFeederList[i].Object AND
                StatusCount > 0 AND
                Status = :Status$FeederGround;

         IF FeederGround > 0 THEN
/*
** Look for Pending Ground Removal
*/  
            IF JIP.Status = Job$Restore THEN
               Operator = JIP.RSOperator;
            ELSE
               Operator = JIP.TOOperator;
            ENDIF;

            FeederGround = 0;
            SELECT    :FeederGround = PS.Object
            FROM      FMS_PendingStatus PS
            WHERE     PS.Object = :NetWorkFeederList[i].Object AND
                      PS.PendingStatus = :Status$PGRDinProg AND 
                      PS.StatusCount = 0 AND
                      PS.IssuedOperator = :Operator;

            IF FeederGround = 0 THEN
               RETURN(NetWorkFeederList[i].Object);
            ENDIF;
         ENDIF;
      ENDFOR;
   ENDIF;

   RETURN(TRUE);  /*We have a station ground or we are not connected to the station.*/
END;

