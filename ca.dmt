METHOD InsertOSWPRequest (
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** Procedure supports both insert and update
*/
   IF CurObject.PermitJobID = -1 THEN
      CurObject.PermitJobID = CALLPROC SOA_JobLastKey;

      IF CurObject.PermitJobID <= 0 THEN
          CALLPROC DDB_ROLLBACK;
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'OSWPRequestClass.InsertOSWPRequest; Error generating next SOA_Job key';
          CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.InsertOSWPRequest; ' + 
                'Error generating next SOA_Job key');
          RETURN;
       ENDIF;
       CALLPROC DDB_COMMIT;
   ENDIF;   

   IF CurObject.SWP <> '' THEN
      CurObject.SWP = 'SWP-' + CurObject.SWP;
   ENDIF;
   
   IF CurObject.OutageRequest <> '' THEN
      CurObject.OutageRequest = 'OR-' + CurObject.OutageRequest;
   ENDIF;

   RetCode = CALLPROC SOA_OSWPRequestIns (
           PermitJobID = CurObject.PermitJobID
         , EnterTime = 'now'
         , EnterByName = CurObject.EnterByName
         , Email = CurObject.Email
         , Status = CurObject.Status
         , Substation = CurObject.Substation
         , WorkGroup = CurObject.WorkGroup
         , Equip = CurObject.Equip
         , EquipName = CurObject.EquipName
         , Title = CurObject.Title
         , Description = CurObject.Description
         , PreIssue = CurObject.PreIssue
         , ShiftStartTime = CurObject.ShiftStartTime
         , WorkTestPermit = CurObject.WorkTestPermit
         , ClearFromEquip = CurObject.ClearFromEquip
         , AdditionalWork = CurObject.AdditionalWork
         , ReducedPressure = CurObject.ReducedPressure
         , EquipStatusChange = CurObject.EquipStatusChange
         , ExtendReturn = CurObject.ExtendReturn
         , ProtectionNote = CurObject.ProtectionNote   
         , WorkLocation = CurObject.WorkLocation     
         , RecallTime = CurObject.RecallTime          
         , RecallTerm = CurObject.RecallTerm          
         , ContinuousDaily = CurObject.ContinuousDaily      
         , HoursPerDay = CurObject.HoursPerDay         
         , DaysPerWeek = CurObject.DaysPerWeek
         , OutageType = CurObject.OutageType         
         , SWP = CurObject.SWP                 
         , WorkOrder = CurObject.WorkOrder            
         , OutageRequest = CurObject.OutageRequest        
         , BARequired = CurObject.BARequired
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPRequestClass.InsertOSWPRequest; Error saving OSWP Request';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.InsertOSWPRequest; ' + 
                'Error saving OSWP Request');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
/*
**  return current status back to the client
*/
    SELECT :CurObject.CurrentStatus = CurrentStatus
    FROM   SOA_OSWPRequest 
    WHERE  PermitJobID = :CurObject.PermitJobID;
    CALLPROC DDB_ROLLBACK;

    IF CurObject.Status = OSPStatus$Ready THEN
       CurObject.SendBAFiles();
    ENDIF;
END;


METHOD DeleteOSWPRequest (
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   RetCode = CALLPROC SOA_OSWPRequestDel (
           PermitJobID = CurObject.PermitJobID
         );

    IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPRequestClass.DeleteOSWPRequest; Error deleting OSWP Request';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.DeleteOSWPRequest; ' + 
                'Error deleting OSWP Request');
       RETURN;
    ENDIF;
    CALLPROC DDB_COMMIT;
END;

METHOD SubmitOSWPRequest(
) =
DECLARE
   RetCode = INTEGER NOT NULL WITH DEFAULT;
   OldStatus = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

/*
** make sure that the DO has not denied or acknowledged the request.
*/
   SELECT :OldStatus = Status,
          :CurObject.CurrentStatus = CurrentStatus,
          :CurObject.Equip = Equip,
          :CurObject.EquipName = EquipName,
          :CurObject.Title = Title
   FROM   SOA_OSWPRequest
   WHERE  PermitJobID = :CurObject.PermitJobID;

   IF OldStatus >= :OSPStatus$Denied THEN
      CurObject.ReturnCode = -2;
      CurObject.ErrorMessage = 'The request has been denied or acknowledged.';
      RETURN;   
   ENDIF;
/* 
** the client sends in the new status: either OSPStatus$Ready or OSPStatus$Request 
*/
   CurObject.UpdateOSWPRequestStatus();
/*
** Return status name backt to the user
*/
   SELECT :CurObject.Status = Status,
          :CurObject.CurrentStatus = CurrentStatus
   FROM   SOA_OSWPRequest
   WHERE  PermitJobID = :CurObject.PermitJobID;
   CALLPROC DDB_ROLLBACK;

   CurObject.SendBAFiles();
END;

METHOD WithdrawOSWPRequest(
) =
DECLARE
   DOName = VARCHAR(40) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/*
** make sure that the DO has not linked the request to a permit
*/
   SELECT :CurObject.Status = Status,
          :CurObject.CurrentStatus = CurrentStatus
   FROM   SOA_OSWPRequest
   WHERE  PermitJobID = :CurObject.PermitJobID;

   IF CurObject.Status >= :OSPStatus$Denied THEN

      SELECT :DOName = O.Description
      FROM   SOA_OSWPRequest R,
             UDB_Object O
      WHERE  R.PermitJobID = :CurObject.PermitJobID AND
             R.ReviewedByDO = O.Object;

      IF CurObject.Status = :OSPStatus$Denied THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'The request has been denied by DO ' + DOName;
         RETURN;   
      ELSEIF CurObject.Status >= :OSPStatus$Acknowledged THEN
         CurObject.ReturnCode = -2;
         CurObject.ErrorMessage = 'The request has been acknowledged or linked to a permit by DO ' + DOName +
                               '. Please contact the operator.';
         RETURN;   
      ENDIF;
   ENDIF;

   CurObject.Status = OSPStatus$Open;

   /* we get these two from the working group
      CurObject.WithdrawnBy 
      CurObject.WithdrawReason
   */
   CurObject.UpdateOSWPRequestStatus();

/*
** Return status backt to the user
*/
   SELECT :CurObject.Status = Status,
          :CurObject.CurrentStatus = CurrentStatus
   FROM   SOA_OSWPRequest
   WHERE  PermitJobID = :CurObject.PermitJobID;
   CALLPROC DDB_ROLLBACK;
END;


/*
** Update Request Status handles following special conditions:
**   - Submit to DO with Status = 3 (REQUEST), if certain conditions met insert incoming message for DO
**   - Withdraw Ready or Request status PR, delete any existing incoming message 
*/
METHOD UpdateOSWPRequestStatus (
) =
DECLARE
   EmailClass = EmailNotificationClass DEFAULT NULL;
   MessageCondition = INTEGER NOT NULL WITH DEFAULT;
   MessageID = INTEGER NOT NULL WITH DEFAULT;
   NormalState = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   MessageCondition = FALSE;
   IF CurObject.Equip <> 0 AND CurObject.Status = OSPStatus$Request THEN
/*
** Equipment not in normal state
*/
      NormalState = 0;
      SELECT :NormalState = 1
      FROM   Udb_Switch
      WHERE  Object = :CurObject.Equip AND
             NormalOpen <> CurrentlyOpen;

      IF NormalState = 1 THEN /* Look for equip on active sw item */

         REPEATED 
         SELECT :MessageCondition = J.Job 
         FROM   SOA_Job J,
                SOA_JobControl JC,
                SOA_Job J2
         WHERE  J.Equip = :CurObject.Equip AND
                J.Status IN ('', :JobStatus$NIS) AND
                J.Job = JC.Job AND
                JC.SwitchingItem <> 0 AND
                JC.SwitchingItem = J2.Job AND
                J2.SwItemStatus = :Card$Active AND
                J2.Shadowlink = 0;
      ENDIF;
                                         
      IF MessageCondition = FALSE THEN
/*
** Look for equipment on active cutout card for feeder
*/
         REPEATED
         SELECT :MessageCondition = AO.Object 
         FROM  Udb_Grouping G,
               TFMS_CardToObject CTO,
               FMS_Card C 
         WHERE G.Member = :CurObject.Equip AND
               G.Relationship = :Interaction$MemberOf AND
               G.Grouping = CTO.Object AND
               CTO.Card = C.Card AND
               C.CutOut IS NOT NULL AND
               C.CutIn IS NULL;
      ENDIF; 
      IF MessageCondition = FALSE THEN
/*
** Look for equipment to be the feeder on active cutout card for feeder
*/
         REPEATED
         SELECT :MessageCondition = AO.Object 
         FROM  FMS_Card C,
               TFMS_CardToObject CTO
         WHERE AO.Object = :CurObject.Equip AND
               AO.Card = C.Card AND
               C.CutOut IS NOT NULL AND
               C.CutIn IS NULL;
      ENDIF; 
      IF MessageCondition = FALSE THEN
/*
** Look for equipment on active cutout card for line
*/
         REPEATED
         SELECT :MessageCondition = AO.Card 
         FROM  Udb_Grouping G,
               SOA_ActiveObject AO,
               SOA_Card C 
         WHERE G.Member = :CurObject.Equip AND
               G.Relationship = :Interaction$MemberOf AND
               G.Grouping = AO.Object AND
               AO.ObjectToCardLink = 1 AND
               AO.Card = C.Card AND
               C.CutOut IS NOT NULL AND
               C.CutIn IS NULL;
      ENDIF; 
      IF MessageCondition = FALSE THEN
/*
** Look for equipment to be the line on active cutout card for line
*/
         REPEATED
         SELECT :MessageCondition = AO.Card 
         FROM  SOA_ActiveObject AO,
               SOA_Card C 
         WHERE AO.Object = :CurObject.Equip AND
               AO.Card = C.Card AND
               AO.ObjectToCardLink = 1 AND
               C.CutOut IS NOT NULL AND
               C.CutIn IS NULL;
      ENDIF; 

   ENDIF;
/*
** Don't commit until message is inserted.
** Notify DO with Incoming Messge if conditions exist.
** Update Request MessageID
*/
   IF MessageCondition <> FALSE OR CurObject.Status = OSPStatus$Open THEN

      SELECT  :CurObject.Substation = PR.Substation
            , :CurObject.SubstationName = O.Description
            , :CurObject.MessageID = PR.MessageID
            , :CurObject.Title = PR.Title
      FROM  SOA_OSWPRequest PR,
            Udb_Object O
      WHERE PR.PermitJobID = :CurObject.PermitJobID AND
            PR.Substation = O.Object;
   ENDIF;

   RetCode = CALLPROC SOA_OSWPRequestStatusUpd (
           PermitJobID = CurObject.PermitJobID
         , Status = CurObject.Status
         , StatusTime = Date('now')
         , ReviewedByDO = CurObject.ReviewedByDO
         , ReviewTime = CurObject.ReviewTime
         , ReviewRemarks = CurObject.ReviewRemarks
         );

   IF RetCode < 0 THEN
       CALLPROC DDB_ROLLBACK;
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPRequestClass.UpdateOSWPRequestStatus; Error updating OSWP Request Status';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdateOSWPRequestStatus; ' + 
                'Error updating OSWP Request status');
       RETURN;
   ENDIF;

   IF MessageCondition <> FALSE THEN      

      RetCode = CALLPROC MSG_SendMsg (Card = CurObject.PermitJobID,
                                  Action = 0,
                                  OrderNumber = 0,
                                  Substation = CurObject.Substation,
                                  SubstationName = 'Permit Request',
                                  Msg = 'OUT-OF-SERVICE PERMIT REQUEST' + HC_NEWLINE +
                                        'Out-Of-Service Permit Request "' + CurObject.Title + 
                                        '" has been received for Substation ' +
                                        CurObject.SubstationName +  ' for Equip ' + CurObject.EquipName +
                                        '.  Review Permit Request to see additional detail.',
                                  FromOpName = 'SSO',
                                  SendDate = IFNULL(DATE('now'),''),
                                  ToApp = 'DO',
                                  FromApp = 'OSWP Request',
                                  Priority = 0
                                  );
      IF RetCode <= 0 THEN
         CurObject.ReturnCode = -1;
         CurObject.ErrorMessage = 'OSWPRequestClass.SubmitOSWPRequest; Error submitting OSWP Request to DO.';
         CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.SubmitOSWPRequest; ' + 
                'Error submitting OSWP Request to DO.');
         RETURN;
      ELSE     /* RetCode contains MsgID */

         RetCode = CALLPROC SOA_OSWPRequestMsgUpd (
              PermitJobID = CurObject.PermitJobID
            , MessageID = RetCode
         );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'OSWPRequestClass.UpdateOSWPRequestStatus; Error updating OSWP Request MessageID';
            CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdateOSWPRequestStatus; ' + 
                         'Error updating OSWP Request MessageID.');
            RETURN;
         ENDIF;
      ENDIF;
   ENDIF;
/*
** If withdrawing or acknowledging a request, we need to clear any incoming message.
*/
   IF (CurObject.Status = OSPStatus$Open OR 
         CurObject.Status = OSPStatus$Acknowledged OR
         CurObject.Status = OSPStatus$Denied) AND 
            CurObject.MessageID <> 0 THEN

         RetCode = CALLPROC MSG_UpdateMsg (Card = CurObject.PermitJobID,
                                  Ack = Ack$Delete,
                                  MsgKey = CurObject.MessageID,
                                  AckByOpName = DOp.Description,
                                  AckDate = date('now'),
                                  DelByOpName = DOp.Description,
                                  DelDate = date('now'),
                                  Substation = CurObject.Substation
                                  );
         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'OSWPRequestClass.UpdateOSWPRequestStatus; Error deleting Incoming OSWP Request Message';
            CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdateOSWPRequestStatus; ' + 
                         'Error deleting Incoming OSWP Request Message.');
            RETURN;
         ENDIF;

         CurObject.MessageID = 0;
         RetCode = CALLPROC SOA_OSWPRequestMsgUpd (
              PermitJobID = CurObject.PermitJobID
            , MessageID = CurObject.MessageID
         );

         IF RetCode < 0 THEN
            CALLPROC DDB_ROLLBACK;
            CurObject.ReturnCode = -1;
            CurObject.ErrorMessage = 'OSWPRequestClass.UpdateOSWPRequestStatus; Error clearing OSWP Request MessageID';
            CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdateOSWPRequestStatus; ' + 
                         'Error clearing OSWP Request MessageID.');
            RETURN;
         ENDIF;
  
   ENDIF;
   CALLPROC DDB_COMMIT; 
/*
** when the request is denied/approved by DO, send notification email to the working group
*/
   IF CurObject.Status = OSPStatus$Denied OR 
      CurObject.Status = OSPStatus$Issued THEN

      SELECT  :CurObject.Substation = PR.Substation
            , :CurObject.SubstationName = O.Description
            , :CurObject.EquipName = PR.EquipName
            , :CurObject.Email = PR.Email
            , :CurObject.Title = PR.Title
      FROM  SOA_OSWPRequest PR,
            Udb_Object O
      WHERE PR.PermitJobID = :CurObject.PermitJobID AND
            PR.Substation = O.Object;
      CALLPROC DDB_ROLLBACK;

      IF SQUEEZE(CurObject.Email) <> '' THEN
         SELECT :CurObject.ReviewedByDOName = Description
         FROM   UDB_Object
         WHERE  Object = :CurObject.ReviewedByDO;

         IF EmailClass IS NULL THEN
            EmailClass = EmailNotificationClass.Create();
         ENDIF;

         EmailClass.EmailType = 7;                        // denied oswp request. See ECC_EmailService
         EmailClass.Sender = CurObject.ReviewedByDOName;
         EmailClass.Recipient = CurObject.Email;

         IF CurObject.Status = OSPStatus$Denied THEN
            EmailClass.Subject = 'Out-of-Service Work Permit request for ' + CurObject.SubstationName + ' substation is DENIED';
            EmailClass.Message1= 'TargetName=' + CurObject.SubstationName + ' substation;;' + 
                   'Operator=' + CurObject.ReviewedByDOName + ';;' + 
                   'Equip=' + CurObject.EquipName + ';;' +
                   'Status=DENIED;;';
            EmailClass.Message2 = 'Request=' + CurObject.Title + ';;' +  
                                  'Reason=' + CurObject.ReviewRemarks + ';;';
            EmailClass.Template = 'OSWPRequestDenied.html';
         ELSE
            EmailClass.Subject = 'Out-of-Service Work Permit request for ' + CurObject.SubstationName + ' is Approved'; 
            EmailClass.Message1= 'TargetName=' + CurObject.SubstationName + ' substation;;' + 
                   'Operator=' + CurObject.ReviewedByDOName + ';;' + 
                   'Equip=' + CurObject.EquipName + ';;' +
                   'Status=APPROVED;;'; 
            EmailClass.Message2 = 'Request=' + CurObject.Title + ';;';
            EmailClass.Template = 'OSWPRequestApproved.html';
         ENDIF;
     
         EmailClass.InsertRequest();

         IF EmailClass.ReturnCode <> 0 THEN 
            CurMethod.Trace(Text = varchar(date('now')) + ':OSWPRequestClass.UpdateOSWPRequestStatus. ERROR: ' + 
                   'Unable to notify work group of denied/approved OSWP request.');
         ENDIF;
      ENDIF;
   ENDIF;
END;


METHOD GetOSWPRequest (
)=
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   IF CurObject.PermitJobID <= 0 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPRequestClass.GetOSWPRequest; Bad PermitJobID parameter.';
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.GetOSWPRequest; ' + 
                'Bad PermitJobID Parameter.');
       RETURN;
   ENDIF;

   REPEATED  
   SELECT  :CurObject.EnterTime = PR.EnterTime
         , :CurObject.EnterByName = PR.EnterByName
         , :CurObject.Email = PR.Email
         , :CurObject.MessageID = PR.MessageID
         , :CurObject.Status = PR.Status
         , :CurObject.CurrentStatus = PR.CurrentStatus
         , :CurObject.Substation = PR.Substation
         , :CurObject.SubstationName = O.Description
         , :CurObject.WorkGroup = PR.WorkGroup
         , :CurObject.WorkGroupName = T.Name
         , :CurObject.HTOD = O.SpecNumber
         , :CurObject.Equip = PR.Equip
         , :CurObject.EquipName = PR.EquipName
         , :CurObject.Title = PR.Title
         , :CurObject.Description = PR.Description
         , :CurObject.PreIssue = PR.PreIssue
         , :CurObject.ShiftStartTime = PR.ShiftStartTime
         , :CurObject.WorkTestPermit = PR.WorkTestPermit
         , :CurObject.ClearFromEquip = PR.ClearFromEquip
         , :CurObject.AdditionalWork = PR.AdditionalWork
         , :CurObject.ReducedPressure = PR.ReducedPressure
         , :CurObject.EquipStatusChange = PR.EquipStatusChange
         , :CurObject.ExtendReturn = PR.ExtendReturn
         , :CurObject.ProtectionNote = PR.ProtectionNote
         , :CurObject.WorkLocation = PR.WorkLocation
         , :CurObject.RecallTime = PR.RecallTime
         , :CurObject.RecallTerm = PR.RecallTerm 
         , :CurObject.ContinuousDaily = PR.ContinuousDaily
         , :CurObject.HoursPerDay = PR.HoursPerDay 
         , :CurObject.DaysPerWeek = PR.DaysPerWeek 
         , :CurObject.SWP = PR.SWP
         , :CurObject.WorkOrder = PR.WorkOrder 
         , :CurObject.OutageRequest = PR.OutageRequest 
         , :CurObject.BARequired = PR.BARequired
         , :CurObject.ReviewedByDO = PR.ReviewedByDO 
         , :CurObject.ReviewTime = PR.ReviewTime
         , :CurObject.ReviewRemarks = PR.ReviewRemarks
   FROM  SOA_OSWPRequest PR,
         Udb_Object O,
         Udb_Type T
   WHERE PR.PermitJobID = :CurObject.PermitJobID AND
         PR.Substation = O.Object AND
         PR.WorkGroup = T.Type;

   IF iirowcount = 0 THEN
       CurObject.ReturnCode = -1;
       CurObject.ErrorMessage = 'OSWPRequestClass.GetOSWPRequest; No Permit Request for ID ' + 
                                VARCHAR(CurObject.PermitJobID);
/* 
** commented out to avoid trace errors when non-oswp permits are deleted by DO
       CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.GetOSWPRequest; ' + 
                              'No Permit Request for ID ' + 
                              VARCHAR(CurObject.PermitJobID));
*/
       RETURN;
   ENDIF;

   i = 1;
   SELECT :CurObject.Attachments[i].PermitJobID = PermitJobID,
          :CurObject.Attachments[i].FileID = FileID,
          :CurObject.Attachments[i].FileName = FileName,
          :CurObject.Attachments[i].DBServer = DBServer,
          :CurObject.Attachments[i].BAFlag = BAFlag
   FROM   SOA_OSWPAttachment 
   WHERE  PermitJobID = :CurObject.PermitJobID 
   BEGIN
      i = i + 1;
   END;

   IF CurObject.ReviewedByDO > 0 THEN
      SELECT :CurObject.ReviewedByDOName = Description
      FROM   Udb_Object
      WHERE  Object = :CurObject.ReviewedByDO;
   ENDIF; 

   IF CurObject.Status > OSPStatus$Permit THEN   
      CurObject.GetOrderStatus();
   ENDIF;
   
   RETURN; 
END;

METHOD InsertAttachments (
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   EventText = '';

   FOR i = 1 TO CurObject.Attachments.LastRow DO
      CurObject.Attachments[i].InsertAttachment();

      IF CurObject.Attachments[i].ReturnCode = 0 AND 
         CurObject.Attachments[i].DBServer >= 0 THEN 
 
         RetCode = CALLPROC SOA_OSWPAttachmentUpd(
                      PermitJobID = CurObject.PermitJobID,
                      FileID = CurObject.Attachments[i].FileID,
                      DBServer = CurObject.Attachments[i].DBServer);
         IF RetCode = 0 THEN
             CALLPROC DDB_COMMIT;
         ELSE
             CALLPROC DDB_ROLLBACK;
             CurMethod.Trace(Text=VARCHAR(DATE('NOW')) + ': Failed to set SOA_OSWPAttachment.DBServer to ' + 
                       VARCHAR(CurObject.Attachments[i].DBServer) + ' for request ' + 
                       VARCHAR(CurObject.Attachments[i].PermitJobID) + ', file ' + 
                       VARCHAR(CurObject.Attachments[i].FileID));
         ENDIF; 
         IF EventText <> '' THEN
            /*
            ** Use comma as the delimiter so that the monitor can take this straight in the
            ** dynamic whereclause. 
            */
            EventText = EventText + ',';
         ENDIF;
         EventText = EventText + VARCHAR(CurObject.Attachments[i].FileID);
      ENDIF; 
   ENDFOR;
 /*
   IF EventText <> '' THEN
      IF CurrentApplication = '' THEN
         CurrentApplication = 'FMS Online';
      ENDIF;
      EventText = VARCHAR(CurObject.PermitJobID) + ';' + EventText;
      CALLPROC InsertDBEventQueue(
                     ToApp = 'TASK',
                     EventName = 'FMS_NewOSWPFile',
                     EventText = EventText);
   ENDIF;
*/
   RETURN;   
END;

METHOD GetOrderStatus(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   OrderNumber = INTEGER NOT NULL WITH DEFAULT;
   TOIssued = DATE DEFAULT NULL;
   RSComplete = DATE DEFAULT NULL;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';

   CurObject.SSO_Status = 0;
   CurObject.SSO_Status_Name = '';

/* Operating order status 
*/
   OrderNumber = 0;
   REPEATED
   SELECT :OrderNumber = O.OrderNumber,
          :CurObject.SSO_Status = O.OrderStatus,
          :CurObject.SSO_Status_Name = W.ReturnStatus
   FROM   IR_OperatingOrder O,
          SOA_WorkPermit W
   WHERE  O.OrderNumber = (SELECT MAX(OJ.OrderNumber) 
                           FROM IR_OpOrderJobs OJ 
                           WHERE OJ.Job = :CurObject.PermitJobID) AND
          W.PermitJobID = :CurObject.PermitJobID;
   CALLPROC DDB_ROLLBACK;
       
   IF OrderNumber > 0 THEN
      IF CurObject.SSO_Status = Order$Opened THEN
         CurObject.SSO_Status_Name = 'OPENED';

      ELSEIF CurObject.SSO_Status = Order$Downloaded THEN
         CurObject.SSO_Status_Name = 'DOWNLOADED';

      ELSEIF CurObject.SSO_Status = Order$Acknowledged THEN
         CurObject.SSO_Status_Name = 'ACKNOWLEDGED';

      ELSEIF CurObject.SSO_Status = Order$Rejected THEN
         CurObject.SSO_Status_Name = 'REJECTED';

      ELSEIF CurObject.SSO_Status = Order$ConfirmRejected THEN
         CurObject.SSO_Status_Name = 'REJECTED';

      ELSEIF CurObject.SSO_Status = Order$Rescinded THEN
         CurObject.SSO_Status_Name = 'RESCINDED';

      ELSEIF CurObject.SSO_Status = Order$ConfirmRescinded THEN
         CurObject.SSO_Status_Name = 'RESCINDED';

      ELSEIF CurObject.SSO_Status = Order$Closed OR
             CurObject.SSO_Status = Order$ConfirmClosed THEN
         /* use ReturnStatus in SOA_WorkPermit */  

      ELSEIF CurObject.SSO_Status = Order$Cancelled THEN
         CurObject.SSO_Status_Name = 'CANCELLED';
      ENDIF; 
   ELSE
      CurObject.SSO_Status_Name = 'VERBAL';
      /* 
      ** check if the permit is issused verbally
      SELECT :TOIssued = J.TOIssued,
             :RSComplete = J.RSComplete
      FROM   SOA_Job J
      WHERE  J.Job = :CurObject.PermitJobID;
      CALLPROC DDB_ROLLBACK;

      IF RSComplete IS NOT NULL THEN
         CurObject.SSO_Status_Name = 'COMPLETE';
      ELSEIF TOIssued IS NOT NULL THEN
         CurObject.SSO_Status_Name = 'ISSUED';
      ELSE
         CurObject.SSO_Status_Name = '';
      ENDIF;
      */
   ENDIF; 

   RETURN;
END;

METHOD UpdatePermitJobID (
   NewPermitJobID 	=	INTEGER NOT NULL WITH DEFAULT
) =
DECLARE
   ModDescription	= VARCHAR(500) NOT NULL WITH DEFAULT;   
   PriorMod             = INTEGER NOT NULL WITH DEFAULT;
   RetCode 		= INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   CurObject.ReturnCode = 0;
   CurObject.ErrorMessage = '';
/* 
** Parse description to eliminate prior DO ACTION if it exists.
*/
   PriorMod = LOCATE(CurObject.Description, '; DO ACTION:');
   IF PriorMod = (SIZE(CurObject.Description)+1) THEN
      ModDescription = CurObject.Description;
   ELSE
      ModDescription = LEFT(CurObject.Description, (PriorMod + 1)); 
   ENDIF;		 
/*
** If permit unlinked from request, then new permit job id is not determined.
** If linked permit is copied, then we update using new permit id.
*/
   IF NewPermitJobID = 0 THEN
      NewPermitJobID = CALLPROC SOA_JobLastKey;

      IF NewPermitJobID <= 0 THEN
          CALLPROC DDB_ROLLBACK;
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'OSWPRequestClass.UpdatePermitJobID; Error generating next SOA_Job key';
          CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdatePermitJobID; ' + 
                'Error generating next SOA_Job key.');
          RETURN;
       ENDIF;
       CALLPROC DDB_COMMIT;
       
       CurObject.Description = ModDescription + '; D.O. ACTION: ' +
                               'Unlinked request from prior permit. ' +
                               VARCHAR(DATE('now'));
   ELSE
       CurObject.Description = ModDescription + '; D.O. ACTION: ' +
                               'Incomplete or Tabled prior permit. ' +
                               VARCHAR(DATE('now'));
   ENDIF;   

   RetCode = CALLPROC SOA_OSWPReqNewPermit (
                  NewPermitJobID = NewPermitJobID,
                  OldPermitJobID = CurObject.PermitJobID,
                  Description = CurObject.Description);

   IF RetCode < 0 THEN
          CALLPROC DDB_ROLLBACK;
          CurObject.ReturnCode = -1;
          CurObject.ErrorMessage = 'OSWPRequestClass.UpdatePermitJobID; Error updating PermitJobID.';
          CurMethod.Trace(Text = varchar(date('now')) + ' : OSWPRequestClass.UpdatePermitJobID; ' + 
                'Error updating Permit Job ID.');
          RETURN;
   ENDIF;
   CALLPROC DDB_COMMIT;
END;

METHOD SendBAFiles(
) =
DECLARE
   i = INTEGER NOT NULL WITH DEFAULT;
   EventText = VARCHAR(256) NOT NULL WITH DEFAULT;
   RetCode = INTEGER NOT NULL WITH DEFAULT;
ENDDECLARE
BEGIN
   i = 0;
   SELECT :i = COUNT(*)
   FROM   SOA_OSWPAttachment
   WHERE  PermitJobID = :CurObject.PermitJobID AND 
          BAFlag = 1;
   
   IF i > 0 THEN
      IF CurrentApplication = '' THEN
         CurrentApplication = 'FMS Online';
      ENDIF;

      EventText = VARCHAR(CurObject.PermitJobID);
      CALLPROC InsertDBEventQueue(
                     ToApp = 'CSD',
                     EventName = 'FMS_SendOSWPFile',
                     EventText = EventText);
   ENDIF;
END;

Application Component Report
============================

	Name:            OtherOrdersInSubstation

/*
**
**      Copyright c 2005 Pateric Software LLC.  All rights reserved.
**
**      Pateric Software LLC proprietary and trade secret information.
**      Do not copy or disclose to third parties without written permission
**      from an officer of Pateric Software LLC.
**
**  Application:    CAC
**  Frame:          OtherOrdersInSubstation
**
**  Date:       Version Description
** ----------------------------------
**  03/02/05  ysp  Created
**  04/07/05  ysp  Get TC card id
**  07/18/05  em   Remove Priority Logic; Exclude Process Auto SetUp Orders
*/ 
INITIALIZE
(
/*
**  Passed Parameters
*/
    OrderSubstation  = INTEGER NOT NULL;    
/*
**  Internal Variables
*/
    i               = Integer NOT NULL WITH DEFAULT;
    k               = Integer NOT NULL WITH DEFAULT;
    TempString      = VARCHAR(40) NOT NULL WITH DEFAULT;
    OrderNumber     = Integer NOT NULL WITH DEFAULT;
    RetCode 	    = INTEGER NOT NULL;
) =
BEGIN
/*
** Query all existing substation operating orders
*/
   i = 1;
   REPEATED
   SELECT  :Orders[i].Application = OO.Application,
           :Orders[i].Card = OO.Card,
           :Orders[i].OrderNumber = OO.OrderNumber,
           :Orders[i].IssueTime = OO.IssueTime,
           :Orders[i].IssuedByDO = OO.IssuedByDO,
           :Orders[i].AckRejectTime = OO.AckRejectTime,
           :Orders[i].AckRejectBySSO = OO.AckRejectBySSO,
           :Orders[i].IssueComment = ''
   FROM   IR_OperatingOrder OO
   WHERE  OO.Substation = :OrderSubstation AND
          OO.OrderStatus < :Order$Closed AND
          OO.OrderStatus > :Order$SetUp AND
          OO.OrderStatus <> :Order$Rejected
   UNION ALL
   SELECT  'TLS',
           OO.Card,
           OO.OrderNumber,
           OO.IssueTime,
           OO.IssuedByDO,
           OO.AckRejectTime,
           OO.AckRejectBySSO,
           OO.IssueComment
   FROM   IR_TelephoneOrder OO
   WHERE  OO.Substation = :OrderSubstation AND
          OO.OrderStatus <:Order$Closed AND
          OO.OrderStatus <> :Order$Rejected
   ORDER BY IssueTime ASC
   BEGIN
      i = i + 1;
   END;
   CALLPROC DDB_ROLLBACK;
/*
** Get detailed information about the orders.
*/
   FOR i = 1 to Orders.LastRow() DO
      IF Orders[i].Application = Application$TLS THEN
         REPEATED
         SELECT :Orders[i].CardName = LineNumber
         FROM   TC_Card
         WHERE  Card = :Orders[i].Card;
      ELSE
         IF Orders[i].Application = Application$FMS THEN
            REPEATED
            SELECT :Orders[i].CardName = FeederName
            FROM   FMS_Card
            WHERE  Card = :Orders[i].Card;

         ELSEIF Orders[i].Application = Application$SLC THEN
            REPEATED
            SELECT :Orders[i].CardName = SubstationName
            FROM   SLC_Card
            WHERE  Card = :Orders[i].Card;

         ELSEIF Orders[i].Application = Application$TFMS THEN
            REPEATED
            SELECT :Orders[i].CardName = FeederNames
            FROM   TFMS_Card
            WHERE  Card = :Orders[i].Card;
         ENDIF;
         /* 
         ** Get objectives
         */
         TempString = '';
         SELECT :TempString = Description
         FROM   IR_OpOrderObjectives
         WHERE  OrderNumber = :Orders[i].OrderNumber
         ORDER BY SEQ
         BEGIN
             IF TempString <> '' THEN
                IF Orders[i].IssueComment = '' THEN
                   Orders[i].IssueComment = TempString;
                ELSE
                   Orders[i].IssueComment = Orders[i].IssueComment + ';' + TempString;
                ENDIF; 
             ENDIF;
         END;
      ENDIF; 
   ENDFOR;
   CALLPROC DDB_ROLLBACK;
END;


ON CLICK OK_Btn = 
BEGIN
   RETURN;
END;
    

